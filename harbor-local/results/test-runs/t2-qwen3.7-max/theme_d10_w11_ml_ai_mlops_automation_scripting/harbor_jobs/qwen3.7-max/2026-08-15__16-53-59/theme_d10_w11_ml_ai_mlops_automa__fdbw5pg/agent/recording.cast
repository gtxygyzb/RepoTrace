[49.349921, "i", "cat /app/pipelines/broken_cycles.yaml\n"]
[49.350303, "o", "cat /app/pipelines/broken_cycles.yaml\r\n\u001b[?2004l\r"]
[49.3527, "o", "name: broken-circular-pipeline\r\nversion: \"1.0\"\r\n\r\nstages:\r\n  - name: stage-a\r\n    command: \"echo a\"\r\n    depends_on: [\"stage-c\"]\r\n    outputs:\r\n      - path: \"out/a.txt\"\r\n        type: file\r\n\r\n  - name: stage-b\r\n    command: \"echo b\"\r\n    depends_on: [\"stage-a\"]\r\n    outputs:\r\n      - path: \"out/b.txt\"\r\n        type: file\r\n\r\n  - name: stage-c\r\n    command: \"echo c\"\r\n    depends_on: [\"stage-b\"]\r\n    outputs:\r\n      - path: \"out/c.txt\"\r\n        type: file\r\n"]
[49.353097, "o", "\u001b[?2004hroot@n30009:/app# "]
[49.645684, "i", "cat /app/stages/validate_data.sh\n"]
[49.646005, "o", "cat /app/stages/validate_data.sh\r\n\u001b[?2004l\r"]
[49.648339, "o", "#!/bin/bash\r\n# Validates input data directory and produces validated copy\r\nmkdir -p data/validated\r\nif [ -d \"data/sample\" ]; then\r\n    cp -r data/sample/* data/validated/ 2>/dev/null || true\r\nfi\r\nCOUNT=$(find data/validated -type f 2>/dev/null | wc -l)\r\necho \"{\\\"metric\\\": \\\"num_samples\\\", \\\"value\\\": ${COUNT}}\"\r\necho \"{\\\"metric\\\": \\\"corruption_rate\\\", \\\"value\\\": 0.02}\"\r\n"]
[49.648754, "o", "\u001b[?2004h"]
[49.648857, "o", "root@n30009:/app# "]
[49.946864, "i", "cat /app/stages/train_model.sh\n"]
[49.947176, "o", "cat /app/stages/train_model.sh"]
[49.947313, "o", "\r\n\u001b[?2004l\r"]
[49.949723, "o", "#!/bin/bash\r\n# Trains a model with given hyperparameters\r\nLR=${LEARNING_RATE:-0.01}\r\nOPT=${OPTIMIZER:-adam}\r\nBS=${BATCH_SIZE:-32}\r\nDROP=${DROPOUT:-0}\r\nmkdir -p models\r\n\r\nif [ \"$OPT\" = \"adam\" ]; then OPT_VAL=1; else OPT_VAL=0; fi\r\n\r\nLOSS=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.5 - ($OPT_VAL * 0.05) + ($BS / 1000.0) + ($LR * 10) + ($DROP * 0.1)}\")\r\nACC=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.8 + ($OPT_VAL * 0.03) - ($BS / 2000.0) - ($LR * 5) - ($DROP * 0.05)}\")\r\n\r\necho \"model_${LR}_${OPT}_${BS}\" > models/checkpoint.bin\r\necho \"{\\\"metric\\\": \\\"train_loss\\\", \\\"value\\\": ${LOSS}}\"\r\necho \"{\\\"metric\\\": \\\"train_accuracy\\\", \\\"value\\\": ${ACC}}\"\r\n"]
[49.950179, "o", "\u001b[?2004hroot@n30009:/app# "]
[50.222191, "i", "cat /app/stages/evaluate_model.sh\n"]
[50.222383, "o", "cat /app/stages/evaluate_model.sh\r\n\u001b[?2004l\r"]
[50.224673, "o", "#!/bin/bash\r\n# Evaluates the trained model\r\nmkdir -p reports\r\nif [ ! -f \"models/checkpoint.bin\" ]; then\r\n    echo \"ERROR: No model checkpoint found\" >&2\r\n    exit 1\r\nfi\r\n\r\nMODEL_INFO=$(cat models/checkpoint.bin)\r\nLR=$(echo \"$MODEL_INFO\" | cut -d_ -f2)\r\nOPT=$(echo \"$MODEL_INFO\" | cut -d_ -f3)\r\nBS=$(echo \"$MODEL_INFO\" | cut -d_ -f4)\r\nif [ \"$OPT\" = \"adam\" ]; then OPT_VAL=1; else OPT_VAL=0; fi\r\n\r\nEVAL_ACC=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.82 + ($OPT_VAL * 0.06) - ($BS / 5000.0) - ($LR * 2)}\")\r\nEVAL_F1=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.78 + ($OPT_VAL * 0.05) - ($BS / 6000.0) - ($LR * 1.5)}\")\r\nEVAL_LOSS=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.3 - ($OPT_VAL * 0.04) + ($BS / 3000.0) + ($LR * 5)}\")\r\n\r\necho \"{\\\"eval_accuracy\\\": ${EVAL_ACC}, \\\"eval_f1\\\": ${EVAL_F1}}\" > reports/evaluation.json\r\necho \"{\\\"metric\\\": \\\"eval_accuracy\\\", \\\"value\\\": ${EVAL_ACC}}\"\r\necho \"{\\\"metric\\\": \\\"eval_f1\\\", \\\"value\\\": ${EVAL_F1}}\"\r\necho \"{\\\"metric\\\": \\\"eval_loss\\\", \\\"value\\\": ${EVAL_LOSS}}\"\r\n"]
[50.225032, "o", "\u001b[?2004hroot@n30009:/app# "]
[50.514815, "i", "cat /app/stages/extract_features.sh\n"]
[50.515184, "o", "cat /app/stages/extract_features.sh\r\n\u001b[?2004l\r"]
[50.517608, "o", "#!/bin/bash\r\n# Extracts features from validated data\r\nBS=${BATCH_SIZE:-32}\r\nmkdir -p data\r\necho \"features_batch${BS}\" > data/features.bin\r\necho \"{\\\"metric\\\": \\\"feature_dim\\\", \\\"value\\\": 512}\"\r\n"]
[50.518003, "o", "\u001b[?2004h"]
[50.518111, "o", "root@n30009:/app# "]
[50.808724, "i", "cat /app/stages/export_model.sh\n"]
[50.809033, "o", "cat /app/stages/export_model.sh\r\n\u001b[?2004l\r"]
[50.811545, "o", "#!/bin/bash\r\n# Exports model to deployment format\r\nmkdir -p models/exported\r\nif [ ! -f \"models/checkpoint.bin\" ]; then\r\n    echo \"ERROR: No model checkpoint found\" >&2\r\n    exit 1\r\nfi\r\ncp models/checkpoint.bin models/exported/model.onnx\r\necho \"{\\\"metric\\\": \\\"export_size_mb\\\", \\\"value\\\": 0.001}\"\r\n"]
[50.811952, "o", "\u001b[?2004hroot@n30009:/app# "]
