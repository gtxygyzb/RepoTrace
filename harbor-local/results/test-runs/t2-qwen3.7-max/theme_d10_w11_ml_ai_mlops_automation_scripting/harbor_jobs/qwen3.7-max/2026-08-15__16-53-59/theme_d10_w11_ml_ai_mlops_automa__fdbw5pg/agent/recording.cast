[48.452144, "o", "cat /app/main.go\r\n\u001b[?2004l\r"]
[48.454644, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe <command> [args...]\")\r\n\t\tfmt.Fprintln(os.Stderr, \"Commands: validate, plan, run, report, artifacts\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Fprintf(os.Stderr, \"error: command %q is not implemented\\n\", os.Args[1])\r\n\tos.Exit(1)\r\n}\r\n"]
[48.455101, "o", "\u001b[?2004h"]
[48.455191, "o", "root@n30009:/app# "]
[48.754435, "i", "cat /app/pipelines/image_classifier.yaml\n"]
[48.754771, "o", "cat /app/pipelines/image_classifier.yaml\r\n\u001b[?2004l\r"]
[48.757242, "o", "name: image-classifier-training\r\nversion: \"1.0\"\r\n\r\nparameters:\r\n  learning_rate:\r\n    type: grid\r\n    values: [0.001, 0.01, 0.1]\r\n  batch_size:\r\n    type: grid\r\n    values: [32, 64]\r\n  optimizer:\r\n    type: grid\r\n    values: [\"adam\", \"sgd\"]\r\n\r\nstages:\r\n  - name: data-validation\r\n    command: \"./stages/validate_data.sh\"\r\n    inputs:\r\n      - path: \"data/sample\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    metrics:\r\n      - name: num_samples\r\n        objective: report\r\n      - name: corruption_rate\r\n        objective: minimize\r\n\r\n  - name: feature-extraction\r\n    command: \"./stages/extract_features.sh\"\r\n    depends_on: [\"data-validation\"]"]
[48.757344, "o", "\r\n    inputs:\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"data/features.bin\"\r\n        type: file\r\n    env:\r\n      BATCH_SIZE: \"${batch_size}\"\r\n\r\n  - name: model-training\r\n    command: \"./stages/train_model.sh\"\r\n    depends_on: [\"feature-extraction\"]\r\n    inputs:\r\n      - path: \"data/features.bin\"\r\n        type: file\r\n    outputs:\r\n      - path: \"models/checkpoint.bin\"\r\n        type: file\r\n    env:\r\n      LEARNING_RATE: \"${learning_rate}\"\r\n      OPTIMIZER: \"${optimizer}\"\r\n      BATCH_SIZE: \"${batch_size}\"\r\n    metrics:\r\n      - name: train_loss\r\n        objective: minimize\r\n      - name: train_accuracy\r\n        objective: maximize\r\n    retry:\r\n      max_attempts: 2\r\n      backoff_seconds: 1\r\n\r\n  - name: model-evaluation\r\n    command: \"./stages/evaluate_model.sh\"\r\n    depends_on: [\"model-training\"]\r\n    inputs:\r\n      - path: \"models/checkpoint.bin\"\r\n        type: file\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"reports/evalua"]
[48.757422, "o", "tion.json\"\r\n        type: file\r\n    metrics:\r\n      - name: eval_accuracy\r\n        objective: maximize\r\n      - name: eval_f1\r\n        objective: maximize\r\n      - name: eval_loss\r\n        objective: minimize\r\n\r\n  - name: model-export\r\n    command: \"./stages/export_model.sh\"\r\n    depends_on: [\"model-evaluation\"]\r\n    condition:\r\n      metric: eval_accuracy\r\n      operator: \">=\"\r\n      threshold: 0.85\r\n    inputs:\r\n      - path: \"models/checkpoint.bin\"\r\n        type: file\r\n    outputs:\r\n      - path: \"models/exported/model.onnx\"\r\n        type: file\r\n"]
[48.757794, "o", "\u001b[?2004h"]
[48.757877, "o", "root@n30009:/app# "]
[49.054991, "i", "cat /app/pipelines/text_sentiment.yaml\n"]
[49.055356, "o", "cat /app/pipelines/text_sentiment.yaml\r\n\u001b[?2004l\r"]
[49.057942, "o", "name: text-sentiment-analysis\r\nversion: \"1.0\"\r\n\r\nparameters:\r\n  embedding_dim:\r\n    type: grid\r\n    values: [128, 256]\r\n  dropout:\r\n    type: grid\r\n    values: [0.1, 0.3]\r\n\r\nstages:\r\n  - name: preprocess\r\n    command: \"./stages/validate_data.sh\"\r\n    inputs:\r\n      - path: \"data/sample\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    metrics:\r\n      - name: num_samples\r\n        objective: report\r\n      - name: corruption_rate\r\n        objective: minimize\r\n\r\n  - name: train\r\n    command: \"./stages/train_model.sh\"\r\n    depends_on: [\"preprocess\"]\r\n    outputs:\r\n      - path: \"models/checkpoint.bin\"\r\n        type: file\r\n    env:\r\n      LEARNING_RATE: \"0.001\"\r\n      OPTIMIZER: \"adam\"\r\n      BATCH_SIZE: \"${embedding_dim}\"\r\n      DROPOUT: \"${dropout}\"\r\n    metrics:\r\n      - name: train_loss\r\n        objective: minimize\r\n      - name: train_accuracy\r\n        objective: maximize\r\n\r\n  - name: evaluate\r\n    command: \"./stages/evaluate_model.sh\"\r\n    depends_on: [\"trai"]
[49.058152, "o", "n\"]\r\n    outputs:\r\n      - path: \"reports/evaluation.json\"\r\n        type: file\r\n    metrics:\r\n      - name: eval_accuracy\r\n        objective: maximize\r\n      - name: eval_f1\r\n        objective: maximize\r\n      - name: eval_loss\r\n        objective: minimize\r\n"]
[49.0584, "o", "\u001b[?2004h"]
