type IORef struct {
	Path string `yaml:"path"`
	Type string `yaml:"type"`
}

type MetricDef struct {
	Name      string `yaml:"name"`
	Objective string `yaml:"objective"`
}

type RetryConfig struct {
	MaxAttempts    int     `yaml:"max_attempts"`
	BackoffSeconds float64 `yaml:"backoff_seconds"`
}

type Condition struct {
	Metric    string  `yaml:"metric"`
	Operator  string  `yaml:"operator"`
	Threshold float64 `yaml:"threshold"`
}

type StageState struct {
	Name      string       `json:"name"`
	Status    string       `json:"status"`
	ExitCode  int          `json:"exit_code"`
	Metrics   []MetricData `json:"metrics"`
	StartTime string       `json:"start_time"`
	EndTime   string       `json:"end_time"`
	Retries   int          `json:"retries"`
}

type MetricData struct {
	Metric string  `json:"metric"`
	Value  float64 `json:"value"`
}

type ArtifactIndex struct {
	Entries []ArtifactEntry `json:"entries"`
}

type ArtifactEntry struct {
	ExperimentID string `json:"experiment_id"`
	StageName    string `json:"stage_name"`
	Path         string `json:"path"`
	Hash         string `json:"hash"`
	Size         int64  `json:"size"`
}

// ====== Pipeline Loading ======

func loadPipeline(path string) (*Pipeline, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	var p Pipeline
	if err := yaml.Unmarshal(data, &p); err != nil {
		return nil, err
	}
	return &p, nil
}

// ====== Helpers ======

func formatValue(v interface{}) string {
	switch val := v.(type) {
	case float64:
		return strconv.FormatFloat(val, 'f', -1, 64)
	case int:
		return strconv.Itoa(val)
	case string:
		return val
	default:
		return fmt.Sprintf("%v", v)
	}
}

func sortedParamKeys(params map[string]Parameter) []string {
	keys := make([]string, 0, len(params))
	for k := range params {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

func expandParameters(params map[string]Parameter) []map[string]interface{} {
	keys := sortedParamKeys(params)
	if len(keys) == 0 {
		return []map[string]interface{}{{}}
	}
	combos := []map[string]interface{}{{}}
	for _, key := range keys {
		param := params[key]
		if len(param.Values) == 0 {
			return nil
		}
		var newCombos []map[string]interface{}
		for _, combo := range combos {
			for _, val := range param.Values {
				newCombo := make(map[string]interface{})
				for k, v := range combo {
					newCombo[k] = v
				}
				newCombo[key] = val
				newCombos = append(newCombos, newCombo)
			}
		}
		combos = newCombos
	}
	return combos
}

func experimentID(combo map[string]interface{}) string {
	if len(combo) == 0 {
		return "exp_default"
	}
	keys := make([]string, 0, len(combo))
	for k := range combo {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	parts := make([]string, len(keys))
	for i, k := range keys {
		parts[i] = k + "=" + formatValue(combo[k])
	}
	return "exp_" + strings.Join(parts, "_")
}

