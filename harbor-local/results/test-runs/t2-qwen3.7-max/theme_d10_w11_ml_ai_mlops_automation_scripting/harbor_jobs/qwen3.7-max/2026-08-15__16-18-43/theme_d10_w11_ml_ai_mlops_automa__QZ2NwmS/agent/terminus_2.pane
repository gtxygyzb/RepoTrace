    command: "./stages/train_model.sh"
    depends_on: ["preprocess"]
    outputs:
      - path: "models/checkpoint.bin"
        type: file
    env:
      LEARNING_RATE: "0.001"
      OPTIMIZER: "adam"
      BATCH_SIZE: "${embedding_dim}"
      DROPOUT: "${dropout}"
    metrics:
      - name: train_loss
        objective: minimize
      - name: train_accuracy
        objective: maximize

  - name: evaluate
    command: "./stages/evaluate_model.sh"
    depends_on: ["train"]
    outputs:
      - path: "reports/evaluation.json"
        type: file
    metrics:
      - name: eval_accuracy
        objective: maximize
      - name: eval_f1
        objective: maximize
      - name: eval_loss
        objective: minimize
