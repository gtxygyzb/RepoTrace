stages:
  - name: preprocess
    command: "./stages/validate_data.sh"
    inputs:
      - path: "data/sample"
        type: directory
    outputs:
      - path: "data/validated"
        type: directory
    metrics:
      - name: num_samples
        objective: report
      - name: corruption_rate
        objective: minimize

