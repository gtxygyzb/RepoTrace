[51.442765, "i", "cat /app/stages/validate_data.sh\n"]
[51.443074, "o", "cat /app/stages/validate_data.sh\r\n\u001b[?2004l\r"]
[51.445705, "o", "#!/bin/bash\r\n# Validates input data directory and produces validated copy\r\nmkdir -p data/validated\r\nif [ -d \"data/sample\" ]; then\r\n    cp -r data/sample/* data/validated/ 2>/dev/null || true\r\nfi\r\nCOUNT=$(find data/validated -type f 2>/dev/null | wc -l)\r\necho \"{\\\"metric\\\": \\\"num_samples\\\", \\\"value\\\": ${COUNT}}\"\r\necho \"{\\\"metric\\\": \\\"corruption_rate\\\", \\\"value\\\": 0.02}\"\r\n"]
[51.446124, "o", "\u001b[?2004h"]
[51.446148, "o", "root@n30009:/app# "]
[51.755445, "i", "cat /app/stages/extract_features.sh\n"]
[51.755761, "o", "cat /app/stages/extract_features.sh\r\n\u001b[?2004l\r"]
[51.758107, "o", "#!/bin/bash\r\n# Extracts features from validated data\r\nBS=${BATCH_SIZE:-32}\r\nmkdir -p data\r\necho \"features_batch${BS}\" > data/features.bin\r\necho \"{\\\"metric\\\": \\\"feature_dim\\\", \\\"value\\\": 512}\"\r\n"]
[51.758494, "o", "\u001b[?2004h"]
[51.758518, "o", "root@n30009:/app# "]
[52.052573, "i", "cat /app/stages/train_model.sh\n"]
[52.052865, "o", "cat /app/stages/train_model.sh\r\n"]
[52.052953, "o", "\u001b[?2004l\r"]
[52.055071, "o", "#!/bin/bash\r\n# Trains a model with given hyperparameters\r\nLR=${LEARNING_RATE:-0.01}\r\nOPT=${OPTIMIZER:-adam}\r\nBS=${BATCH_SIZE:-32}\r\nDROP=${DROPOUT:-0}\r\nmkdir -p models\r\n\r\nif [ \"$OPT\" = \"adam\" ]; then OPT_VAL=1; else OPT_VAL=0; fi\r\n\r\nLOSS=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.5 - ($OPT_VAL * 0.05) + ($BS / 1000.0) + ($LR * 10) + ($DROP * 0.1)}\")\r\nACC=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.8 + ($OPT_VAL * 0.03) - ($BS / 2000.0) - ($LR * 5) - ($DROP * 0.05)}\")\r\n\r\necho \"model_${LR}_${OPT}_${BS}\" > models/checkpoint.bin\r\necho \"{\\\"metric\\\": \\\"train_loss\\\", \\\"value\\\": ${LOSS}}\"\r\necho \"{\\\"metric\\\": \\\"train_accuracy\\\", \\\"value\\\": ${ACC}}\"\r\n"]
[52.055555, "o", "\u001b[?2004hroot@n30009:/app# "]
[52.341518, "i", "cat /app/stages/evaluate_model.sh\n"]
[52.341831, "o", "cat /app/stages/evaluate_model.sh\r\n\u001b[?2004l\r"]
[52.344144, "o", "#!/bin/bash\r\n# Evaluates the trained model\r\nmkdir -p reports\r\nif [ ! -f \"models/checkpoint.bin\" ]; then\r\n    echo \"ERROR: No model checkpoint found\" >&2\r\n    exit 1\r\nfi\r\n\r\nMODEL_INFO=$(cat models/checkpoint.bin)\r\nLR=$(echo \"$MODEL_INFO\" | cut -d_ -f2)\r\nOPT=$(echo \"$MODEL_INFO\" | cut -d_ -f3)\r\nBS=$(echo \"$MODEL_INFO\" | cut -d_ -f4)\r\nif [ \"$OPT\" = \"adam\" ]; then OPT_VAL=1; else OPT_VAL=0; fi\r\n\r\nEVAL_ACC=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.82 + ($OPT_VAL * 0.06) - ($BS / 5000.0) - ($LR * 2)}\")\r\nEVAL_F1=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.78 + ($OPT_VAL * 0.05) - ($BS / 6000.0) - ($LR * 1.5)}\")\r\nEVAL_LOSS=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.3 - ($OPT_VAL * 0.04) + ($BS / 3000.0) + ($LR * 5)}\")\r\n\r\necho \"{\\\"eval_accuracy\\\": ${EVAL_ACC}, \\\"eval_f1\\\": ${EVAL_F1}}\" > reports/evaluation.json\r\necho \"{\\\"metric\\\": \\\"eval_accuracy\\\", \\\"value\\\": ${EVAL_ACC}}\"\r\necho \"{\\\"metric\\\": \\\"eval_f1\\\", \\\"value\\\": ${EVAL_F1}}\"\r\necho \"{\\\"metric\\\": \\\"eval_loss\\\", \\\"value\\\": ${EVAL_LOSS}}\"\r\n"]
[52.34455, "o", "\u001b[?2004h"]
[52.344573, "o", "root@n30009:/app# "]
[52.652206, "i", "cat /app/stages/export_model.sh\n"]
[52.652532, "o", "cat /app/stages/export_model.sh\r\n\u001b[?2004l\r"]
[52.654727, "o", "#!/bin/bash\r\n# Exports model to deployment format\r\nmkdir -p models/exported\r\nif [ ! -f \"models/checkpoint.bin\" ]; then\r\n    echo \"ERROR: No model checkpoint found\" >&2\r\n    exit 1\r\nfi\r\ncp models/checkpoint.bin models/exported/model.onnx\r\necho \"{\\\"metric\\\": \\\"export_size_mb\\\", \\\"value\\\": 0.001}\"\r\n"]
[52.655114, "o", "\u001b[?2004h"]
[52.655136, "o", "root@n30009:/app# "]
[52.94044, "i", "cat /app/main.go\n"]
[52.940671, "o", "cat /app/main.go\r\n\u001b[?2004l\r"]
[52.942864, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe <command> [args...]\")\r\n\t\tfmt.Fprintln(os.Stderr, \"Commands: validate, plan, run, report, artifacts\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Fprintf(os.Stderr, \"error: command %q is not implemented\\n\", os.Args[1])\r\n\tos.Exit(1)\r\n}\r\n"]
