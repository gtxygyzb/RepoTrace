[1134.581555, "i", "cat > /app/main.go << 'GOEOF'\rpackage main\r\rimport (\r\t\"bufio\"\r\t\"crypto/sha256\"\r\t\"encoding/hex\"\r\t\"encoding/json\"\r\t\"fmt\"\r\t\"io\"\r\t\"math\"\r\t\"os\"\r\t\"os/exec\"\r\t\"path/filepath\"\r\t\"sort\"\r\t\"strconv\"\r\t\"strings\"\r\t\"time\"\r\r\t\"gopkg.in/yaml.v3\"\r)\r\r// ====== Type Definitions ======\r\rtype Pipeline struct {\r\tName       string               `yaml:\"name\"`\r\tVersion    string               `yaml:\"version\"`\r\tParameters map[string]Parameter `yaml:\"parameters\"`\r\tStages     []StageDef           `yaml:\"stages\"`\r}\r\rtype Parameter struct {\r\tType   string        `yaml:\"type\"`\r\tValues []interface{} `yaml:\"values\"`\r}\r\rtype StageDef struct {\r\tName      string            `yaml:\"name\"`\r\tCommand   string            `yaml:\"command\"`\r\tDependsOn []string          `yaml:\"depends_on\"`\r\tInputs    []IORef           `yaml:\"inputs\"`\r\tOutputs   []IORef           `yaml:\"outputs\"`\r\tEnv       map[string]string `yaml:\"env\"`\r\tMetrics   []MetricDef       `yaml:\"metrics\"`\r\tRetry     *RetryConfig      `yaml:\"retry\"`\r\tCondition *Condition        `yaml:\"condition\"`\r}\r"]
[1134.581878, "i", "\rtype IORef struct {\r\tPath string `yaml:\"path\"`\r\tType string `yaml:\"type\"`\r}\r\rtype MetricDef struct {\r\tName      string `yaml:\"name\"`\r\tObjective string `yaml:\"objective\"`\r}\r\rtype RetryConfig struct {\r\tMaxAttempts    int     `yaml:\"max_attempts\"`\r\tBackoffSeconds float64 `yaml:\"backoff_seconds\"`\r}\r\rtype Condition struct {\r\tMetric    string  `yaml:\"metric\"`\r\tOperator  string  `yaml:\"operator\"`\r\tThreshold float64 `yaml:\"threshold\"`\r}\r\rtype StageState struct {\r\tName      string       `json:\"name\"`\r\tStatus    string       `json:\"status\"`\r\tExitCode  int          `json:\"exit_code\"`\r\tMetrics   []MetricData `json:\"metrics\"`\r\tStartTime string       `json:\"start_time\"`\r\tEndTime   string       `json:\"end_time\"`\r\tRetries   int          `json:\"retries\"`\r}\r\rtype MetricData struct {\r\tMetric string  `json:\"metric\"`\r\tValue  float64 `json:\"value\"`\r}\r\rtype ArtifactIndex struct {\r\tEntries []ArtifactEntry `json:\"entries\"`\r}\r\rtype ArtifactEntry struct {\r\tExperimentID string `json:\"experiment_id\"`\r\tStageName    string `json:\"stage_na"]
