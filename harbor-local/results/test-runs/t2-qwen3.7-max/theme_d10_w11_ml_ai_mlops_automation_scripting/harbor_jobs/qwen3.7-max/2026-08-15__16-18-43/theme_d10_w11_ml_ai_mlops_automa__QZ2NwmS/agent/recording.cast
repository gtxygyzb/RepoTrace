[50.861672, "o", "name: image-classifier-training\r\nversion: \"1.0\"\r\n\r\nparameters:\r\n  learning_rate:\r\n    type: grid\r\n    values: [0.001, 0.01, 0.1]\r\n  batch_size:\r\n    type: grid\r\n    values: [32, 64]\r\n  optimizer:\r\n    type: grid\r\n    values: [\"adam\", \"sgd\"]\r\n\r\nstages:\r\n  - name: data-validation\r\n    command: \"./stages/validate_data.sh\"\r\n    inputs:\r\n      - path: \"data/sample\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    metrics:\r\n      - name: num_samples\r\n        objective: report\r\n      - name: corruption_rate\r\n        objective: minimize\r\n\r\n  - name: feature-extraction\r\n    command: \"./stages/extract_features.sh\"\r\n    depends_on: [\"data-validation\"]\r\n    inputs:\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"data/features.bin\"\r\n        type: file\r\n    env:\r\n      BATCH_SIZE: \"${batch_size}\"\r\n\r\n  - name: model-training\r\n    command: \"./stages/train_model.sh\"\r\n    depends_on: [\"feature-extraction\"]\r\n    inputs:\r\n      - path: \"da"]
[50.861829, "o", "ta/features.bin\"\r\n        type: file\r\n    outputs:\r\n      - path: \"models/checkpoint.bin\"\r\n        type: file\r\n    env:\r\n      LEARNING_RATE: \"${learning_rate}\"\r\n      OPTIMIZER: \"${optimizer}\"\r\n      BATCH_SIZE: \"${batch_size}\"\r\n    metrics:\r\n      - name: train_loss\r\n        objective: minimize\r\n      - name: train_accuracy\r\n        objective: maximize\r\n    retry:\r\n      max_attempts: 2\r\n      backoff_seconds: 1\r\n\r\n  - name: model-evaluation\r\n    command: \"./stages/evaluate_model.sh\"\r\n    depends_on: [\"model-training\"]\r\n    inputs:\r\n      - path: \"models/checkpoint.bin\"\r\n        type: file\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"reports/evaluation.json\"\r\n        type: file\r\n    metrics:\r\n      - name: eval_accuracy\r\n        objective: maximize\r\n      - name: eval_f1\r\n        objective: maximize\r\n      - name: eval_loss\r\n        objective: minimize\r\n\r\n  - name: model-export\r\n    command: \"./stages/export_model.sh\"\r\n    depends_on: [\"model-evaluation\"]\r\n    condi"]
[50.861943, "o", "tion:\r\n      metric: eval_accuracy\r\n      operator: \">=\"\r\n      threshold: 0.85\r\n    inputs:\r\n      - path: \"models/checkpoint.bin\"\r\n        type: file\r\n    outputs:\r\n      - path: \"models/exported/model.onnx\"\r\n        type: file\r\n"]
