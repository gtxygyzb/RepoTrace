[1134.58377, "i", "objectives from pipeline definition\r\tobjectives := make(map[string]string)\r\tfor _, s := range p.Stages {\r\t\tfor _, m := range s.Metrics {\r\t\t\tobjectives[m.Name] = m.Objective\r\t\t}\r\t}\r\r\t// Scan state directories for experiments\r\tstateBase := filepath.Join(\".mlpipe\", \"state\")\r\tentries, _ := os.ReadDir(stateBase)\r\r\ttype ExpResult struct {\r\t\tID      string             `json:\"id\"`\r\t\tMetrics map[string]float64 `json:\"metrics\"`\r\t}\r\r\tvar experiments []ExpResult\r\tfor _, entry := range entries {\r\t\tif !entry.IsDir() {\r\t\t\tcontinue\r\t\t}\r\t\texpID := entry.Name()\r\t\texpDir := filepath.Join(stateBase, expID)\r\t\tfiles, _ := os.ReadDir(expDir)\r\t\tmetrics := make(map[string]float64)\r\t\tfor _, f := range files {\r\t\t\tif !strings.HasSuffix(f.Name(), \".json\") {\r\t\t\t\tcontinue\r\t\t\t}\r\t\t\tdata, err := os.ReadFile(filepath.Join(expDir, f.Name()))\r\t\t\tif err != nil {\r\t\t\t\tcontinue\r\t\t\t}\r\t\t\tvar st StageState\r\t\t\tif err := json.Unmarshal(data, &st); err != nil {\r\t\t\t\tcontinue\r\t\t\t}\r\t\t\tfor _, m := range st.Metrics {\r\t\t\t\tmetrics[m.Metric] = m.Value\r\t\t\t}\r\t\t}\r\t\t"]
[1134.583805, "i", "experiments = append(experiments, ExpResult{ID: expID, Metrics: metrics})\r\t}\r\r\t// Sort experiments by ID\r\tsort.Slice(experiments, func(i, j int) bool {\r\t\treturn experiments[i].ID < experiments[j].ID\r\t})\r\r\t// Compute metric summary\r\ttype MetricSummary struct {\r\t\tMean float64 `json:\"mean\"`\r\t\tStd  float64 `json:\"std\"`\r\t\tMin  float64 `json:\"min\"`\r\t\tMax  float64 `json:\"max\"`\r\t}\r\r\tmetricValues := make(map[string][]float64)\r\tfor _, exp := range experiments {\r\t\tfor name, val := range exp.Metrics {\r\t\t\tmetricValues[name] = append(metricValues[name], val)\r\t\t}\r\t}\r\r\tmetricSummary := make(map[string]MetricSummary)\r\tfor name, vals := range metricValues {\r\t\tif len(vals) == 0 {\r\t\t\tcontinue\r\t\t}\r\t\tsum := 0.0\r\t\tminV := vals[0]\r\t\tmaxV := vals[0]\r\t\tfor _, v := range vals {\r\t\t\tsum += v\r\t\t\tif v < minV {\r\t\t\t\tminV = v\r\t\t\t}\r\t\t\tif v > maxV {\r\t\t\t\tmaxV = v\r\t\t\t}\r\t\t}\r\t\tmean := sum / float64(len(vals))\r\t\tvarSum := 0.0\r\t\tfor _, v := range vals {\r\t\t\td := v - mean\r\t\t\tvarSum += d * d\r\t\t}\r\t\tstd := math.Sqrt(varSum / float64(len(vals)))\r\t\tmetricSu"]
