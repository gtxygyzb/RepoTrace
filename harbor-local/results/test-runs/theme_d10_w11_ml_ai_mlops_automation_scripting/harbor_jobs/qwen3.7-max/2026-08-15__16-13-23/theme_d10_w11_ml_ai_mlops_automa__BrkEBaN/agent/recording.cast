[55.779023, "i", "cat /app/pipelines/broken_cycles.yaml\n"]
[55.779482, "o", "cat /app/pipelines/broken_cycles.yaml\r\n\u001b[?2004l\r"]
[55.781933, "o", "name: broken-circular-pipeline\r\nversion: \"1.0\"\r\n\r\nstages:\r\n  - name: stage-a\r\n    command: \"echo a\"\r\n    depends_on: [\"stage-c\"]\r\n    outputs:\r\n      - path: \"out/a.txt\"\r\n        type: file\r\n\r\n  - name: stage-b\r\n    command: \"echo b\"\r\n    depends_on: [\"stage-a\"]\r\n    outputs:\r\n      - path: \"out/b.txt\"\r\n        type: file\r\n\r\n  - name: stage-c\r\n    command: \"echo c\"\r\n    depends_on: [\"stage-b\"]\r\n    outputs:\r\n      - path: \"out/c.txt\"\r\n        type: file\r\n"]
[55.782396, "o", "\u001b[?2004h"]
[55.782471, "o", "root@n30009:/app# "]
[56.26617, "i", "cat /app/stages/validate_data.sh\n"]
[56.266517, "o", "cat /app/stages/validate_data.sh\r\n\u001b[?2004l\r"]
[56.268879, "o", "#!/bin/bash\r\n# Validates input data directory and produces validated copy\r\nmkdir -p data/validated\r\nif [ -d \"data/sample\" ]; then\r\n    cp -r data/sample/* data/validated/ 2>/dev/null || true\r\nfi\r\nCOUNT=$(find data/validated -type f 2>/dev/null | wc -l)\r\necho \"{\\\"metric\\\": \\\"num_samples\\\", \\\"value\\\": ${COUNT}}\"\r\necho \"{\\\"metric\\\": \\\"corruption_rate\\\", \\\"value\\\": 0.02}\"\r\n"]
[56.269351, "o", "\u001b[?2004h"]
[56.269447, "o", "root@n30009:/app# "]
[56.765806, "i", "cat /app/stages/extract_features.sh\n"]
[56.766238, "o", "cat /app/stages/extract_features.sh\r\n\u001b[?2004l\r"]
[56.769162, "o", "#!/bin/bash\r\n# Extracts features from validated data\r\nBS=${BATCH_SIZE:-32}\r\nmkdir -p data\r\necho \"features_batch${BS}\" > data/features.bin\r\necho \"{\\\"metric\\\": \\\"feature_dim\\\", \\\"value\\\": 512}\"\r\n"]
[56.769592, "o", "\u001b[?2004hroot@n30009:/app# "]
[57.261292, "i", "cat /app/stages/train_model.sh\n"]
[57.261605, "o", "cat /app/stages/train_model.sh\r\n\u001b[?2004l\r"]
[57.263993, "o", "#!/bin/bash\r\n# Trains a model with given hyperparameters\r\nLR=${LEARNING_RATE:-0.01}\r\nOPT=${OPTIMIZER:-adam}\r\nBS=${BATCH_SIZE:-32}\r\nDROP=${DROPOUT:-0}\r\nmkdir -p models\r\n\r\nif [ \"$OPT\" = \"adam\" ]; then OPT_VAL=1; else OPT_VAL=0; fi\r\n\r\nLOSS=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.5 - ($OPT_VAL * 0.05) + ($BS / 1000.0) + ($LR * 10) + ($DROP * 0.1)}\")\r\nACC=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.8 + ($OPT_VAL * 0.03) - ($BS / 2000.0) - ($LR * 5) - ($DROP * 0.05)}\")\r\n\r\necho \"model_${LR}_${OPT}_${BS}\" > models/checkpoint.bin\r\necho \"{\\\"metric\\\": \\\"train_loss\\\", \\\"value\\\": ${LOSS}}\"\r\necho \"{\\\"metric\\\": \\\"train_accuracy\\\", \\\"value\\\": ${ACC}}\"\r\n"]
[57.264408, "o", "\u001b[?2004hroot@n30009:/app# "]
[57.780951, "i", "cat /app/stages/evaluate_model.sh\n"]
[57.781264, "o", "cat /app/stages/evaluate_model.sh\r\n\u001b[?2004l\r"]
[57.783644, "o", "#!/bin/bash\r\n# Evaluates the trained model\r\nmkdir -p reports\r\nif [ ! -f \"models/checkpoint.bin\" ]; then\r\n    echo \"ERROR: No model checkpoint found\" >&2\r\n    exit 1\r\nfi\r\n\r\nMODEL_INFO=$(cat models/checkpoint.bin)\r\nLR=$(echo \"$MODEL_INFO\" | cut -d_ -f2)\r\nOPT=$(echo \"$MODEL_INFO\" | cut -d_ -f3)\r\nBS=$(echo \"$MODEL_INFO\" | cut -d_ -f4)\r\nif [ \"$OPT\" = \"adam\" ]; then OPT_VAL=1; else OPT_VAL=0; fi\r\n\r\nEVAL_ACC=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.82 + ($OPT_VAL * 0.06) - ($BS / 5000.0) - ($LR * 2)}\")\r\nEVAL_F1=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.78 + ($OPT_VAL * 0.05) - ($BS / 6000.0) - ($LR * 1.5)}\")\r\nEVAL_LOSS=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.3 - ($OPT_VAL * 0.04) + ($BS / 3000.0) + ($LR * 5)}\")\r\n\r\necho \"{\\\"eval_accuracy\\\": ${EVAL_ACC}, \\\"eval_f1\\\": ${EVAL_F1}}\" > reports/evaluation.json\r\necho \"{\\\"metric\\\": \\\"eval_accuracy\\\", \\\"value\\\": ${EVAL_ACC}}\"\r\necho \"{\\\"metric\\\": \\\"eval_f1\\\", \\\"value\\\": ${EVAL_F1}}\"\r\necho \"{\\\"metric\\\": \\\"eval_loss\\\", \\\"value\\\": ${EVAL_LOSS}}\"\r\n"]
[57.78405, "o", "\u001b[?2004h"]
[57.784132, "o", "root@n30009:/app# "]
[58.283552, "i", "cat /app/stages/export_model.sh\n"]
[58.283848, "o", "cat /app/stages/export_model.sh\r\n\u001b[?2004l\r"]
[58.286333, "o", "#!/bin/bash\r\n# Exports model to deployment format\r\nmkdir -p models/exported\r\nif [ ! -f \"models/checkpoint.bin\" ]; then\r\n    echo \"ERROR: No model checkpoint found\" >&2\r\n    exit 1\r\nfi\r\ncp models/checkpoint.bin models/exported/model.onnx\r\necho \"{\\\"metric\\\": \\\"export_size_mb\\\", \\\"value\\\": 0.001}\"\r\n"]
[58.286789, "o", "\u001b[?2004hroot@n30009:/app# "]
