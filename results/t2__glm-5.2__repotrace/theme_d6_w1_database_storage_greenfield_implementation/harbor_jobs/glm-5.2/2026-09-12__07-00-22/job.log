able\n\nimport (\n    "sort"\n    "strings"\n\n    "kvstore/internal/sstable"\n)\n\ntype MemTable struct {\n    entries []sstable.Entry\n    size    int\n    maxSeq  uint64\n}\n\nfunc New() *MemTable {\n    return &MemTable{}\n}\n\nfunc (m *MemTable) Add(key, value string, seq uint64, op uint8) {\n    e := sstable.Entry{Key: key, Value: value, Seq: seq, Op: op}\n    idx := sort.Search(len(m.entries), func(i int) bool {\n        if m.entries[i].Key != key {\n            return m.entries[i].Key > key\n        }\n        return m.entries[i].Seq < seq\n    })\n    m.entries = append(m.entries, sstable.Entry{})\n    copy(m.entries[idx+1:], m.entries[idx:])\n    m.entries[idx] = e\n    m.size += len(key) + len(value)\n    if seq > m.maxSeq {\n        m.maxSeq = seq\n    }\n}\n\nfunc (m *MemTable) Size() int      { return m.size }\nfunc (m *MemTable) Len() int       { return len(m.entries) }\nfunc (m *MemTable) MaxSeq() uint64 { return m.maxSeq }\n\nfunc (m *MemTable) PointEntry(key string, visibleSeq uint64) (sstable.Entry, bool) {\n    idx := sort.Search(len(m.entries), func(i int) bool {\n        return m.entries[i].Key >= key\n    })\n    var best sstable.Entry\n    found := false\n    for i := idx; i < len(m.entries); i++ {\n        if m.entries[i].Key != key {\n            break\n        }\n        if m.entries[i].Seq <= visibleSeq && m.entries[i].Op != sstable.OpDeleteRange {\n            if !found || m.entries[i].Seq > best.Seq {\n                best = m.entries[i]\n                found = true\n            }\n        }\n    }\n    return best, found\n}\n\nfunc (m *MemTable) AllEntries() []sstable.Entry {\n    out := make([]sstable.Entry, len(m.entries))\n    copy(out, m.entries)\n    return out\n}\n\nfunc (m *MemTable) EntriesInRange(start, end string) []sstable.Entry {\n    var out []sstable.Entry\n    for _, e := range m.entries {\n        if keyInRange(e.Key, start, end) {\n            out = append(out, e)\n        }\n    }\n    return out\n}\n\nfunc (m *MemTable) RangeTombstones() []sstable.RangeTombstone {\n    var out []sstable.RangeTombstone\n    for _, e := range m.entries {\n        if e.Op == sstable.OpDeleteRange {\n            out = append(out, sstable.RangeTombstone{Start: e.Key, End: e.Value, Seq: e.Seq})\n        }\n    }\n    return out\n}\n\nfunc (m *MemTable) Clear() {\n    m.entries = nil\n    m.size = 0\n    m.maxSeq = 0\n}\n\nfunc keyInRange(key, start, end string) bool {\n    if start != "" && key < start {\n        return false\n    }\n    if end != "" && key > end {\n        return false\n    }\n    return true\n}\n\nfunc KeyInRange(key, start, end string) bool {\n    return keyInRange(key, start, end)\n}\n\nfunc (m *MemTable) PrefixScan(prefix string) []sstable.Entry {\n    var out []sstable.Entry\n    for _, e := range m.entries {\n        if strings.HasPrefix(e.Key, prefix) {\n            out = append(out, e)\n        }\n    }\n    return out\n}\nEOF\n\ncat > /app/internal/sstable/sstable.go <<\'EOF\'\npackage sstable\n\nimport (\n    "bufio"\n    "encoding/binary"\n    "hash/crc32"\n    "io"\n    "os"\n    "path/filepath"\n    "sort"\n    "strconv"\n    "strings"\n)\n\nconst (\n    OpPut         = 1\n    OpDelete      = 2\n    OpDeleteRange = 3\n\n    magic      uint64 = 0x4C534D5453535400\n    targetBlock = 4096\n)\n\ntype Entry struct {\n    Key   string\n    Value string\n    Seq   uint64\n    Op    uint8\n}\n\ntype RangeTombstone struct {\n    Start string\n    End   string\n    Seq   uint64\n}\n\ntype IndexEntry struct {\n    FirstKey string\n    Offset   uint64\n    Size     uint32\n}\n\ntype Bloom struct {\n    bits uint32\n    k    int\n    data []byte\n}\n\nfunc NewBloom(n int) *Bloom {\n    if n <= 0 {\n        return &Bloom{k: 7}\n    }\n    bits := uint32(n * 10)\n    if bits == 0 {\n        bits = 1\n    }\n    return &Bloom{bits: bits, k: 7, data: make([]byte, (bits+7)/8)}\n}\n\nfunc bloomHash(i int, key string) uint32 {\n    b := append([]byte{byte(i)}, key...)\n    return crc32.ChecksumIEEE(b)\n}\n\nfunc (b *Bloom) Add(key string) {\n    if b.bits == 0 {\n        return\n    }\n    for i := 0; i < b.k; i++ {\n        h := bloomHash(i, key)\n        idx := h % b.bits\n        b.data[idx/8] |= 1 << (idx % 8)\n    }\n}\n\nfunc (b *Bloom) MayContain(key string) bool {\n    if b.bits == 0 {\n        return true\n    }\n    for i := 0; i < b.k; i++ {\n        h := bloomHash(i, key)\n        idx := h % b.bits\n        if b.data[idx/8]&(1<<(idx%8)) == 0 {\n            return false\n        }\n    }\n    return true\n}\n\nfunc (b *Bloom) Serialize() []byte {\n    var buf []byte\n    var u4 [4]byte\n    binary.LittleEndian.PutUint32(u4[:], b.bits)\n    buf = append(buf, u4[:]...)\n    buf = append(buf, b.data...)\n    return buf\n}\n\nfunc DeserializeBloom(buf []byte) *Bloom {\n    if len(buf) < 4 {\n        return &Bloom{k: 7}\n    }\n    bits := binary.LittleEndian.Uint32(buf[:4])\n    data := buf[4:]\n    return &Bloom{bits: bits, k: 7, data: data}\n}\n\ntype Writer struct {\n    path     string\n    tmpPath  string\n    f        *os.File\n    buf      *bufio.Writer\n    entries  []Entry\n    index    []IndexEntry\n    offset   uint64\n    dataSize uint64\n    keyCount uint64\n    minSeq   uint64\n    maxSeq   uint64\n}\n\nfunc NewWriter(path string) (*Writer, error) {\n    tmpPath := path + ".tmp"\n    f, err := os.Create(tmpPath)\n    if err != nil {\n        return nil, err\n    }\n    return &Writer{\n        path:    path,\n        tmpPath: tmpPath,\n        f:       f,\n        buf:     bufio.NewWriter(f),\n    }, nil\n}\n\nfunc (w *Writer) Add(e Entry) {\n    w.entries = append(w.entries, e)\n    w.keyCount++\n    if e.Op != OpDeleteRange {\n        w.dataSize += uint64(len(e.Key) + len(e.Value))\n    }\n    if w.keyCount == 1 || e.Seq < w.minSeq {\n        w.minSeq = e.Seq\n    }\n    if e.Seq > w.maxSeq {\n        w.maxSeq = e.Seq\n    }\n}\n\nfunc encodeEntry(e Entry) []byte {\n    var u4 [4]byte\n    var u8 [8]byte\n    var buf []byte\n\n    binary.LittleEndian.PutUint32(u4[:], uint32(len(e.Key)))\n    buf = append(buf, u4[:]...)\n    buf = append(buf, e.Key...)\n    binary.LittleEndian.PutUint32(u4[:], uint32(len(e.Value)))\n    buf = append(buf, u4[:]...)\n    buf = append(buf, e.Value...)\n    buf = append(buf, e.Op)\n    binary.LittleEndian.PutUint64(u8[:], e.Seq)\n    buf = append(buf, u8[:]...)\n    return buf\n}\n\nfunc (w *Writer) writeBlock(block []byte, firstKey string) error {\n    idx := IndexEntry{FirstKey: firstKey, Offset: w.offset, Size: uint32(len(block))}\n    w.index = append(w.index, idx)\n    if _, err := w.buf.Write(block); err != nil {\n        return err\n    }\n    w.offset += uint64(len(block))\n    return nil\n}\n\nfunc (w *Writer) Flush() error {\n    sort.SliceStable(w.entries, func(i, j int) bool {\n        if w.entries[i].Key != w.entries[j].Key {\n            return w.entries[i].Key < w.entries[j].Key\n        }\n        return w.entries[i].Seq < w.entries[j].Seq\n    })\n\n    bloom := NewBloom(int(w.keyCount))\n    var block []byte\n    var firstKey string\n\n    for _, e := range w.entries {\n        if e.Op == OpPut {\n            bloom.Add(e.Key)\n        }\n        enc := encodeEntry(e)\n        if len(block) > 0 && len(block)+len(enc) > targetBlock {\n            if err := w.writeBlock(block, firstKey); err != nil {\n                return err\n            }\n            block = nil\n        }\n        if len(block) == 0 {\n            firstKey = e.Key\n        }\n        block = append(block, enc...)\n    }\n    if len(block) > 0 {\n        if err := w.writeBlock(block, firstKey); err != nil {\n            return err\n        }\n    }\n\n    indexOffset := w.offset\n    var indexBuf []byte\n    var u4 [4]byte\n    var u8 [8]byte\n    for _, idx := range w.index {\n        binary.LittleEndian.PutUint32(u4[:], uint32(len(idx.FirstKey)))\n        indexBuf = append(indexBuf, u4[:]...)\n        indexBuf = append(indexBuf, idx.FirstKey...)\n        binary.LittleEndian.PutUint64(u8[:], idx.Offset)\n        indexBuf = append(indexBuf, u8[:]...)\n        binary.LittleEndian.PutUint32(u4[:], idx.Size)\n        indexBuf = append(indexBuf, u4[:]...)\n    }\n    if _, err := w.buf.Write(indexBuf); err != nil {\n        return err\n    }\n    w.offset += uint64(len(indexBuf))\n\n    bloomOffset := w.offset\n    bloomBytes := bloom.Serialize()\n    if _, err := w.buf.Write(bloomBytes); err != nil {\n        return err\n    }\n    w.offset += uint64(len(bloomBytes))\n\n    rangeOffset := w.offset\n    var rangeBuf []byte\n    var rts []RangeTombstone\n    for _, e := range w.entries {\n        if e.Op == OpDeleteRange {\n            rts = append(rts, RangeTombstone{Start: e.Key, End: e.Value, Seq: e.Seq})\n        }\n    }\n    sort.Slice(rts, func(i, j int) bool {\n        return rts[i].Start < rts[j].Start\n    })\n    binary.LittleEndian.PutUint32(u4[:], uint32(len(rts)))\n    rangeBuf = append(rangeBuf, u4[:]...)\n    for _, rt := range rts {\n        binary.LittleEndian.PutUint32(u4[:], uint32(len(rt.Start)))\n        rangeBuf = append(rangeBuf, u4[:]...)\n        rangeBuf = append(rangeBuf, rt.Start...)\n        binary.LittleEndian.PutUint32(u4[:], uint32(len(rt.End)))\n        rangeBuf = append(rangeBuf, u4[:]...)\n        rangeBuf = append(rangeBuf, rt.End...)\n        binary.LittleEndian.PutUint64(u8[:], rt.Seq)\n        rangeBuf = append(rangeBuf, u8[:]...)\n    }\n    if _, err := w.buf.Write(rangeBuf); err != nil {\n        return err\n    }\n    w.offset += uint64(len(rangeBuf))\n\n    var footer [76]byte\n    binary.LittleEndian.PutUint64(footer[0:8], indexOffset)\n    binary.LittleEndian.PutUint32(footer[8:12], uint32(len(indexBuf)))\n    binary.LittleEndian.PutUint64(footer[12:20], bloomOffset)\n    binary.LittleEndian.PutUint32(footer[20:24], uint32(len(bloomBytes)))\n    binary.LittleEndian.PutUint64(footer[24:32], rangeOffset)\n    binary.LittleEndian.PutUint32(footer[32:36], uint32(len(rangeBuf)))\n    binary.LittleEndian.PutUint64(footer[36:44], w.keyCount)\n    binary.LittleEndian.PutUint64(footer[44:52], w.dataSize)\n    binary.LittleEndian.PutUint64(footer[52:60], w.minSeq)\n    binary.LittleEndian.PutUint64(footer[60:68], w.maxSeq)\n    binary.LittleEndian.PutUint64(footer[68:76], magic)\n    if _, err := w.buf.Write(footer[:]); err != nil {\n        return err\n    }\n    if err := w.buf.Flush(); err != nil {\n        return err\n    }\n    if err := w.f.Close(); err != nil {\n        return err\n    }\n    return os.Rename(w.tmpPath, w.path)\n}\n\ntype Reader struct {\n    path        string\n    f           *os.File\n    index       []IndexEntry\n    rangeTombs  []RangeTombstone\n    bloom       *Bloom\n    KeyCount    uint64\n    DataSize    uint64\n    MinSeq      uint64\n    MaxSeq      uint64\n    FileSeq     uint64\n    Level       int\n}\n\nfunc Open(path string) (*Reader, error) {\n    f, err := os.Open(path)\n    if err != nil {\n        return nil, err\n    }\n    st, err := f.Stat()\n    if err != nil {\n        f.Close()\n        return nil, err\n    }\n    if st.Size() < 76 {\n        f.Close()\n        return nil, io.ErrUnexpectedEOF\n    }\n    var footer [76]byte\n    if _, err := f.ReadAt(footer[:], st.Size()-76); err != nil {\n        f.Close()\n        return nil, err\n    }\n    magicVal := binary.LittleEndian.Uint64(footer[68:76])\n    if magicVal != magic {\n        f.Close()\n        return nil, io.ErrUnexpectedEOF\n    }\n\n    r := &Reader{path: path, f: f}\n    r.KeyCount = binary.LittleEndian.Uint64(footer[36:44])\n    r.DataSize = binary.LittleEndian.Uint64(footer[44:52])\n    r.MinSeq = binary.LittleEndian.Uint64(footer[52:60])\n    r.MaxSeq = binary.LittleEndian.Uint64(footer[60:68])\n\n    indexOffset := binary.LittleEndian.Uint64(footer[0:8])\n    indexSize := binary.LittleEndian.Uint32(footer[8:12])\n    bloomOffset := binary.LittleEndian.Uint64(footer[12:20])\n    bloomSize := binary.LittleEndian.Uint32(footer[20:24])\n    rangeOffset := binary.LittleEndian.Uint64(footer[24:32])\n    rangeSize := binary.LittleEndian.Uint32(footer[32:36])\n\n    indexBuf := make([]byte, indexSize)\n    if _, err := f.ReadAt(indexBuf, int64(indexOffset)); err != nil {\n        f.Close()\n        return nil, err\n    }\n    r.index = parseIndex(indexBuf)\n\n    bloomBuf := make([]byte, bloomSize)\n    if _, err := f.ReadAt(bloomBuf, int64(bloomOffset)); err != nil {\n        f.Close()\n        return nil, err\n    }\n    r.bloom = DeserializeBloom(bloomBuf)\n\n    rangeBuf := make([]byte, rangeSize)\n    if _, err := f.ReadAt(rangeBuf, int64(rangeOffset)); err != nil {\n        f.Close()\n        return nil, err\n    }\n    r.rangeTombs = parseRangeTombstones(rangeBuf)\n\n    base := filepath.Base(path)\n    r.FileSeq, r.Level, _ = ParseFilename(base)\n    return r, nil\n}\n\nfunc parseIndex(buf []byte) []IndexEntry {\n    var out []IndexEntry\n    pos := 0\n    for pos+4 <= len(buf) {\n        kl := binary.LittleEndian.Uint32(buf[pos : pos+4])\n        pos += 4\n        if pos+int(kl) > len(buf) {\n            break\n        }\n        key := string(buf[pos : pos+int(kl)])\n        pos += int(kl)\n        if pos+12 > len(buf) {\n            break\n        }\n        off := binary.LittleEndian.Uint64(buf[pos : pos+8])\n        sz := binary.LittleEndian.Uint32(buf[pos+8 : pos+12])\n        pos += 12\n        out = append(out, IndexEntry{FirstKey: key, Offset: off, Size: sz})\n    }\n    return out\n}\n\nfunc parseRangeTombstones(buf []byte) []RangeTombstone {\n    if len(buf) < 4 {\n        return nil\n    }\n    count := binary.LittleEndian.Uint32(buf[:4])\n    pos := 4\n    var out []RangeTombstone\n    for i := uint32(0); i < count; i++ {\n        if pos+4 > len(buf) {\n            break\n        }\n        sl := binary.LittleEndian.Uint32(buf[pos : pos+4])\n        pos += 4\n        if pos+int(sl) > len(buf) {\n            break\n        }\n        start := string(buf[pos : pos+int(sl)])\n        pos += int(sl)\n 