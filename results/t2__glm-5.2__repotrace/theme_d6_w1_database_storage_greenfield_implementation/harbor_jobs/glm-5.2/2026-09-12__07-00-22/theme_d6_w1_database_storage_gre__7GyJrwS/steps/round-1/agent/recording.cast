[1374.942947, "i", "memtable/memtable.go <<'EOF'\npackage memtable\n\nimport (\n\t\"sort\"\n\t\"strings\"\n\n\t\"kvstore/internal/sstable\"\n)\n\ntype MemTable struct {\n\tentries []sstable.Entry\n\tsize    int\n\tmaxSeq  uint64\n}\n\nfunc New() *MemTable {\n\treturn &MemTable{}\n}\n\nfunc (m *MemTable) Add(key, value string, seq uint64, op uint8) {\n\te := sstable.Entry{Key: key, Value: value, Seq: seq, Op: op}\n\tidx := sort.Search(len(m.entries), func(i int) bool {\n\t\tif m.entries[i].Key != key {\n\t\t\treturn m.entries[i].Key > key\n\t\t}\n\t\treturn m.entries[i].Seq < seq\n\t})\n\tm.entries = append(m.entries, sstable.Entry{})\n\tcopy(m.entries[idx+1:], m.entries[idx:])\n\tm.entries[idx] = e\n\tm.size += len(key) + len(value)\n\tif seq > m.maxSeq {\n\t\tm.maxSeq = seq\n\t}\n}\n\nfunc (m *MemTable) Size() int    { return m.size }\nfunc (m *MemTable) Len() int     { return len(m.entries) }\nfunc (m *MemTable) MaxSeq() uint64 { return m.maxSeq }\n\nfunc (m *MemTable) Get(key string, visibleSeq uint64) (sstable.Entry, bool) {\n\tidx := sort.Search(len(m.entries), func(i int) bool {\n\t\treturn m.entries"]
