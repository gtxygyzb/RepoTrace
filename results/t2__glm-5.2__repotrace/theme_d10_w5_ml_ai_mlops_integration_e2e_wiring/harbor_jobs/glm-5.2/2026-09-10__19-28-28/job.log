    for _, r := range e.results {\n        if r.Status != "success" {\n            status = "failed"\n            break\n        }\n    }\n    for _, fr := range foldResults {\n        if fr.Status != "success" {\n            status = "failed"\n            break\n        }\n    }\n\n    run := &CVRunOutput{\n        Pipeline:    e.config.Pipeline.Name,\n        Status:      status,\n        CVFolds:     e.cvFolds,\n        Stages:      e.results,\n        FoldResults: foldResults,\n        CVResults:   CVResults{Metrics: cvMetrics},\n        Artifacts:   allArtifacts,\n        CacheStats:  e.cacheStats,\n    }\n\n    if err := saveArtifacts(e.meta); err != nil {\n        return nil, err\n    }\n    if err := saveRunAny(run); err != nil {\n        return nil, err\n    }\n    return run, nil\n}\n\nfunc (e *Executor) executeStageCached(name string, fold, k int, runArtifacts map[string]*ArtifactOutput) bool {\n    stage, _ := e.config.stageByName(name)\n    e.outputs[name] = map[string]string{}\n    e.values[name] = map[string]*ArtifactValue{}\n    e.results[name] = &StageResult{Status: "pending", Outputs: map[string]string{}}\n\n    skip := false\n    for _, dep := range stage.DependsOn {\n        if e.status[dep] != "success" {\n            skip = true\n            break\n        }\n    }\n    if skip {\n        e.status[name] = "skipped"\n        e.results[name].Status = "skipped"\n        return false\n    }\n\n    inputValues, inputIDs, err := e.resolveInputs(stage)\n    if err != nil {\n        e.status[name] = "failed"\n        e.results[name].Status = "failed"\n        e.results[name].Error = err.Error()\n        return false\n    }\n\n    params := e.config.stageParams(name, e.globals)\n    inputKeys := e.inputCacheKeys(stage)\n    cacheKey, keyErr := computeCacheKey(stage, params, inputKeys, fold)\n    if keyErr != nil {\n        e.status[name] = "failed"\n        e.results[name].Status = "failed"\n        e.results[name].Error = keyErr.Error()\n        return