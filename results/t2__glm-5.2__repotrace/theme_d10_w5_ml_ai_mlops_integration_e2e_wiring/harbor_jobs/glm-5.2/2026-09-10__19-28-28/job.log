    }\n            if !unknown {\n                key, err := computeCacheKey(stage, params, inputKeys, -1)\n                if err == nil {\n                    cacheKeys[name] = key\n                    if cacheEntryExists(key) {\n                        cacheStatus = "hit"\n                    } else {\n                        cacheStatus = "miss"\n                    }\n                }\n            }\n        }\n\n        stages[name] = PlanStage{\n            Type:        stage.Type,\n            DependsOn:   deps,\n            InputTypes:  inputTypes,\n            OutputTypes: outputTypes,\n            CacheStatus: cacheStatus,\n            CVPhase:     phase,\n        }\n    }\n\n    sort.Slice(edges, func(i, j int) bool {\n        if edges[i].From != edges[j].From {\n            return edges[i].From < edges[j].From\n        }\n        if edges[i].To != edges[j].To {\n            return edges[i].To < edges[j].To\n        }\n        return edges[i].Port < edges[j].Port\n    })\n\n    return &PlanOutput{\n        Pipeline:      config.Pipeline.Name,\n        Mode:          mode,\n        CVFolds:       cv,\n        ExecutionOrder: executionOrder,\n        Stages:        stages,\n        Edges:         edges,\n    }, nil\n}\n\nfunc outputPortType(stageType, port string) string {\n    switch stageType {\n    case "data-source", "transform":\n        if port == "data" {\n            return "dataset"\n        }\n    case "split":\n        if port == "train" || port == "test" {\n            return "dataset"\n        }\n    case "train":\n        if port == "model" {\n            return "model"\n        }\n        if port == "predictions" {\n            return "dataset"\n        }\n    case "evaluate":\n        if port == "report" {\n            return "report"\n        }\n    case "register":\n        if port == "entry" {\n            return "entry"\n        }\n    }\n    return "unknown"\n}\n\nfunc strPtr(s string) *string {\n    return &s\n}\nEOF\n'] min_timeout