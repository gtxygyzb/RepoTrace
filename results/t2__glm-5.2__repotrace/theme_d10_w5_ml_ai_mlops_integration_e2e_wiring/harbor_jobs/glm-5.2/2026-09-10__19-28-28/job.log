tage, targetStage, nil\n}\n\'\'\'\nnew = \'\'\'func promoteModel(name string, version int, targetStage string, force bool) (*RegistryEntry, string, string, []string, error) {\n\\tvalid := map[string]bool{"staging": true, "production": true, "archived": true}\n\\tif !valid[targetStage] {\n\\t\\treturn nil, "", "", nil, fmt.Errorf("invalid promotion: invalid target stage %q", targetStage)\n\\t}\n\\tentries, err := loadRegistry()\n\\tif err != nil {\n\\t\\treturn nil, "", "", nil, err\n\\t}\n\\tvar entry *RegistryEntry\n\tfor _, e := range entries {\n\t\tif e.Name == name && e.Version == version {\n\t\t\tentry = e\n\t\t\tbreak\n\t\t}\n\t}\n\tif entry == nil {\n\t\treturn nil, "", "", nil, fmt.Errorf("model not found: %s:%d", name, version)\n\t}\n\n\tprevStage := entry.Stage\n\tif !validPromotionTransition(prevStage, targetStage) {\n\t\treturn nil, "", "", nil, fmt.Errorf("invalid promotion: cannot promote from %s to %s", prevStage, targetStage)\n\t}\n\n\twarnings := []string{}\n\tif targetStage == "production" {\n\t\tif entry.PromotionRules != nil {\n\t\t\tif rules, ok := entry.PromotionRules[targetStage].(map[string]interface{}); ok {\n\t\t\t\tfor metricName, thresholdVal := range rules {\n\t\t\t\t\tmetricValue, ok := entry.Metrics[metricName]\n\t\t\t\t\tif !ok {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tmv, ok := toFloat64(metricValue)\n\t\t\t\t\tif !ok {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\ttv, ok := toFloat64(thresholdVal)\n\t\t\t\t\tif !ok {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tif mv < tv {\n\t\t\t\t\t\twarning := fmt.Sprintf("metric %s (%.4f) below threshold (%.4f)", metricName, mv, tv)\n\t\t\t\t\t\tif !force {\n\t\t\t\t\t\t\treturn nil, prevStage, targetStage, nil, fmt.Errorf("%s", warning)\n\t\t\t\t\t\t}\n\t\t\t\t\t\twarnings = append(warnings, warning)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tfor _, e := range entries {\n\t\t\tif e.Name == name && e.Stage == "production" && e.Version != version {\n\t\t\t\te.Stage = "archived"\n\t\t\t}\n\t\t}\n\t}\n\n\tentry.Stage = targetStage\n\tif err := saveRegistry(entries); err != nil {\n\t\treturn nil, "", "", nil, err\n\t}\n\treturn entry, prevStage, targetStage, warnings, nil\n}\n\'\'\'\nif old not in s:\n    raise SystemExit("register.go pattern not found")\np.write_text(s.replace(old, new))\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
