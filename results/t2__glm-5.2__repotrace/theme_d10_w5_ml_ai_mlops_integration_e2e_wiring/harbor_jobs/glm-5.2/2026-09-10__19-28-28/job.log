                testRows = append(testRows, idx)\n            } else {\n                trainRows = append(trainRows, idx)\n            }\n        }\n    } else {\n        idx, ok := ds.ColumnIndex(stratify)\n        if !ok {\n            return nil, fmt.Errorf("stratify column not found: %s", stratify)\n        }\n        classes := map[string][]int{}\n        for i, row := range ds.Rows {\n            val := ""\n            if idx < len(row) {\n                val = row[idx]\n            }\n            classes[val] = append(classes[val], i)\n        }\n        classNames := make([]string, 0, len(classes))\n        for c := range classes {\n            classNames = append(classNames, c)\n        }\n        sort.Strings(classNames)\n        rng := rand.New(rand.NewSource(int64(seed)))\n        for _, c := range classNames {\n            rows := classes[c]\n            perm := rng.Perm(len(rows))\n            for pos, p := range perm {\n                srcIdx := rows[p]\n                if pos%k == fold {\n                    testRows = append(testRows, srcIdx)\n                } else {\n                    trainRows = append(trainRows, srcIdx)\n                }\n            }\n        }\n    }\n\n    train := ds.Copy()\n    train.Rows = nil\n    test := ds.Copy()\n    test.Rows = nil\n\n    appendRow := func(dst *Dataset, src []string) {\n        dst.Rows = append(dst.Rows, append([]string{}, src...))\n    }\n    for _, idx := range trainRows {\n        appendRow(train, ds.Rows[idx])\n    }\n    for _, idx := range testRows {\n        appendRow(test, ds.Rows[idx])\n    }\n\n    return map[string]*ArtifactValue{"train": {Dataset: train}, "test": {Dataset: test}}, nil\n}\n\nfunc artifactIDFold(pipeline, stage, port string, ts int64, fold int) string {\n    if pipeline == "" {\n        pipeline = "pipeline"\n    }\n    return fmt.Sprintf("%s-%s-%s-%d-fold%d", pipeline, stage, port, ts, fold)\n}\n\nfunc copyParams(params map[string]interface{}) map[string]interface{} {\n    out := make(map[string]interface{}, len(params))\n    for k, v := range params {\n        out[k] = v\n    }\n    return out\n}\n\nfunc copyStringMap(m map[string]string) map[string]string {\n    out := make(map[string]string, len(m))\n    for k, v := range m {\n        out[k] = v\n    }\n    return out\n}\n\nfunc copyValueMap(m map[string]*ArtifactValue) map[string]*ArtifactValue {\n    out := make(map[string]*ArtifactValue, len(m))\n    for k, v := range m {\n        out[k] = v\n    }\n    return out\n}\n\nfunc (c *Config) validateCV() error {\n    splitNames := []string{}\n    for _, s := range c.Stages {\n        if s.Type == "split" {\n            splitNames = append(splitNames, s.Name)\n        }\n    }\n    if len(splitNames) != 1 {\n        return fmt.Errorf("cv mode requires exactly one split stage")\n    }\n    splitName := splitNames[0]\n    post := c.postSplitStages(splitName)\n\n    hasTrain := false\n    for name := range post {\n        stage, _ := c.stageByName(name)\n        if stage != nil && stage.Type == "train" {\n            hasTrain = true\n        }\n    }\n    hasEvaluate := false\n    for name := range post {\n        stage, _ := c.stageByName(name)\n        if stage == nil || stage.Type != "evaluate" {\n            continue\n        }\n        ancestors := c.ancestors(name)\n        for anc := range ancestors {\n            if anc == name {\n                continue\n            }\n            ancStage, ok := c.stageByName(anc)\n            if !ok || ancStage.Type != "train" || !post[anc] {\n                continue\n            }\n            hasEvaluate = true\n            break\n        }\n        if hasEvaluate {\n            break\n        }\n    }\n\n    if !hasTrain || !hasEvaluate {\n        return fmt.Errorf("cv mode requires train and evaluate stages downstream of the split stage")\n    }\n    return nil\n}\n\nfunc (c *Config) splitStageName() (string, bool) {\n    for _, s := range c.Stages {\n        if s.Type == "split" {\n            return s.Name, true\n        }\n    }\n    return "", false\n}\n\nfunc (c *Config) stageDeps(s *StageConfig) []string {\n    deps := map[string]bool{}\n    for _, dep := range s.DependsOn {\n        if dep != "" {\n            deps[dep] = true\n        }\n    }\n    for _, ref := range s.Inputs {\n        parts := strings.SplitN(ref, ".", 2)\n        if len(parts) == 2 && parts[0] != "" {\n            deps[parts[0]] = true\n        }\n    }\n    out := make([]string, 0, len(deps))\n    for dep := range deps {\n        out = append(out, dep)\n    }\n    sort.Strings(out)\n    return out\n}\n\nfunc (c *Config) descendants(name string) map[string]bool {\n    adj := map[string][]string{}\n    for _, s := range c.Stages {\n        for _, dep := range c.stageDeps(&s) {\n            adj[dep] = append(adj[dep], s.Name)\n        }\n    }\n    set := map[string]bool{}\n    var dfs func(n string)\n    dfs = func(n string) {\n        for _, next := range adj[n] {\n            if !set[next] {\n                set[next] = true\n                dfs(next)\n            }\n        }\n    }\n    dfs(name)\n    return set\n}\n\nfunc (c *Config) ancestors(name string) map[string]bool {\n    deps := map[string][]string{}\n    for _, s := range c.Stages {\n        deps[s.Name] = c.stageDeps(&s)\n    }\n    set := map[string]bool{}\n    var dfs func(n string)\n    dfs = func(n string) {\n        for _, dep := range deps[n] {\n            if !set[dep] {\n                set[dep] = true\n                dfs(dep)\n            }\n        }\n    }\n    dfs(name)\n    return set\n}\n\nfunc (c *Config) postSplitStages(splitName string) map[string]bool {\n    post := map[string]bool{splitName: true}\n    for name := range c.descendants(splitName) {\n        post[name] = true\n    }\n    return post\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
