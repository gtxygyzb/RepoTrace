      if len(m.Boost) == 0 {\n            return 0\n        }\n        current := m.Boost[0].InitPrediction\n        for _, b := range m.Boost {\n            current += b.LearningRate * predictTree(b.Tree, x)\n        }\n        if m.Classification {\n            return 1 / (1 + math.Exp(-current))\n        }\n        return current\n    case "knn":\n        return predictKNN(m.KNN, x)\n    }\n    return 0\n}\n\nfunc predictTree(node *TreeNode, x []float64) float64 {\n    if node == nil || node.IsLeaf {\n        if node == nil {\n            return 0\n        }\n        return node.Prediction\n    }\n    if node.Feature < len(x) && x[node.Feature] <= node.Threshold {\n        return predictTree(node.Left, x)\n    }\n    return predictTree(node.Right, x)\n}\n\nfunc predictTreeProb(node *TreeNode, x []float64) float64 {\n    if node == nil || node.IsLeaf {\n        if node == nil {\n            return 0\n        }\n        return node.Probability\n    }\n    if node.Feature < len(x) && x[node.Feature] <= node.Threshold {\n        return predictTreeProb(node.Left, x)\n    }\n    return predictTreeProb(node.Right, x)\n}\n\nfunc predictKNN(knn *KNNModel, x []float64) float64 {\n    if knn == nil || len(knn.Features) == 0 {\n        return 0\n    }\n    type pair struct {\n        dist float64\n        target float64\n    }\n    pairs := make([]pair, len(knn.Features))\n    for i := range knn.Features {\n        d := 0.0\n        for j := range x {\n            diff := x[j] - knn.Features[i][j]\n            d += diff * diff\n        }\n        pairs[i] = pair{dist: d, target: knn.Targets[i]}\n    }\n    sort.Slice(pairs, func(i, j int) bool {\n        return pairs[i].dist < pairs[j].dist\n    })\n    k := knn.K\n    if k > len(pairs) {\n        k = len(pairs)\n    }\n    if knn.Classification {\n        votes := map[float64]int{}\n        for i := 0; i < k; i++ {\n            votes[pairs[i].target]++\n        }\n        bestCount := -1\n        bestVal := 0.0\n        for