Folds *int\n\tif executor != nil && executor.cvFolds > 0 {\n\t\tmode = "cv"\n\t\tf := executor.cvFolds\n\t\tcvFolds = &f\n\t} else if executor != nil {\n\t\t// keep standard mode\n\t}\n\n\tskipped := []string{}\n\tif executor != nil {\n\t\tfor _, name := range executor.skipStages {\n\t\t\tskipped = append(skipped, name)\n\t\t}\n\t}\n\tif len(skipped) == 0 {\n\t\tskipped = []string{}\n\t}\n\n\tsummary := map[string]StageSummary{}\n\tif executor != nil {\n\t\tfor name, r := range executor.results {\n\t\t\tif r == nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tsummary[name] = StageSummary{\n\t\t\t\tStatus:     r.Status,\n\t\t\t\tCacheHit:   r.CacheHit,\n\t\t\t\tDurationMs: r.DurationMs,\n\t\t\t}\n\t\t}\n\t}\n\n\tvar cacheStats *CacheStats\n\tif executor != nil {\n\t\tif executor.noCache {\n\t\t\tcacheStats = nil\n\t\t} else {\n\t\t\tcacheStats = executor.cacheStats\n\t\t\tif cacheStats == nil {\n\t\t\t\tcacheStats = &CacheStats{}\n\t\t\t}\n\t\t}\n\t}\n\n\treturn &RunRecord{\n\t\tRunID:        strconv.FormatInt(finishedAt.UnixNano()/int64(time.Millisecond), 10),\n\t\tPipeline:     executor.config.Pipeline.Name,\n\t\tStartedAt:    startedAt.UTC().Format(time.RFC3339),\n\t\tFinishedAt:   finishedAt.UTC().Format(time.RFC3339),\n\t\tDurationMs:   finishedAt.Sub(startedAt).Milliseconds(),\n\t\tStatus:       status,\n\t\tMode:         mode,\n\t\tCvFolds:      cvFolds,\n\t\tNoCache:      executor.noCache,\n\t\tSkippedStages: skipped,\n\t\tStageSummary: summary,\n\t\tCacheStats:   cacheStats,\n\t}\n}\n\nfunc cmdHistory(args []string) {\n\tvar pipelineFilter string\n\tvar statusFilter string\n\tlimit := -1\n\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tswitch {\n\t\tcase arg == "--pipeline":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\tprintError("--pipeline requires a value")\n\t\t\t\treturn\n\t\t\t}\n\t\t\tpipelineFilter = args[i+1]\n\t\t\ti++\n\t\tcase strings.HasPrefix(arg, "--pipeline="):\n\t\t\tpipelineFilter = strings.TrimPrefix(arg, "--pipeline=")\n\t\tcase arg == "--status":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\tprintError("--status requires a value")\n\t\t\t\treturn\n\t\t\t}\n\t\t\tstatusFilter = args[i+1]\n\t\t\ti++\n\t\tcase strings.HasPrefix(arg, "--status="):\n\t\t\tstatusFilter = strings.TrimPrefix(arg, "--status=")\n\t\tcase arg == "--limit":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\tprintError("--limit requires a value")\n\t\t\t\treturn\n\t\t\t}\n\t\t\tn, err := strconv.Atoi(args[i+1])\n\t\t\tif err != nil {\n\t\t\t\tprintError("--limit requires an integer")\n\t\t\t\treturn\n\t\t\t}\n\t\t\tlimit = n\n\t\t\ti++\n\t\tcase strings.HasPrefix(arg, "--limit="):\n\t\t\tn, err := strconv.Atoi(strings.TrimPrefix(arg, "--limit="))\n\t\t\tif err != nil {\n\t\t\t\tprintError("--limit requires an integer")\n\t\t\t\treturn\n\t\t\t}\n\t\t\tlimit = n\n\t\tdefault:\n\t\t\tprintError(fmt.Sprintf("unknown flag: %s", arg))\n\t\t\treturn\n\t\t}\n\t}\n\n\tif statusFilter != "" && statusFilter != "success" && statusFilter != "failed" {\n\t\tprintError("--status must be success or failed")\n\t\treturn\n\t}\n\n\truns, err := loadHistory()\n\tif err != nil {\n\t\tprintError(err.Error())\n\t\treturn\n\t}\n\n\tfiltered := make([]HistoryRun, 0, len(runs))\n\tfor _, r := range runs {\n\t\tif pipelineFilter != "" && r.Pipeline != pipelineFilter {\n\t\t\tcontinue\n\t\t}\n\t\tif statusFilter != "" && r.Status != statusFilter {\n\t\t\tcontinue\n\t\t}\n\t\tfiltered = append(filtered, r)\n\t}\n\n\tsort.Slice(filtered, func(i, j int) bool {\n\t\treturn filtered[i].RunID > filtered[j].RunID\n\t})\n\n\tif limit >= 0 && len(filtered) > limit {\n\t\tfiltered = filtered[:limit]\n\t}\n\n\tprintJSON(HistoryOutput{Runs: filtered, Count: len(filtered)})\n}\n\nfunc loadHistory() ([]HistoryRun, error) {\n\tdir := filepath.Join(".mlpipe", "runs")\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn []HistoryRun{}, nil\n\t\t}\n\t\treturn nil, err\n\t}\n\truns := []HistoryRun{}\n\tfor _, entry := range entries {\n\t\tif entry.IsDir