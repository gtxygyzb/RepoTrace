= nil {\n        return v.Report.Summary()\n    }\n    if v.Entry != nil {\n        return map[string]interface{}{\n            "name":    v.Entry.Name,\n            "version": v.Entry.Version,\n            "stage":   v.Entry.Stage,\n        }\n    }\n    return map[string]interface{}{}\n}\n\nfunc inputDataset(inputs map[string]*ArtifactValue) *Dataset {\n    for _, in := range inputs {\n        if in != nil && in.Dataset != nil {\n            return in.Dataset\n        }\n    }\n    return nil\n}\n\nfunc appendUnique(s []string, v string) []string {\n    for _, x := range s {\n        if x == v {\n            return s\n        }\n    }\n    return append(s, v)\n}\n\nfunc artifactsPath() string {\n    return filepath.Join(".mlpipe", "artifacts.json")\n}\n\nfunc loadArtifacts() (map[string]*ArtifactMeta, error) {\n    data, err := os.ReadFile(artifactsPath())\n    if err != nil {\n        if os.IsNotExist(err) {\n            return map[string]*ArtifactMeta{}, nil\n        }\n        return nil, err\n    }\n    var m map[string]*ArtifactMeta\n    if err := json.Unmarshal(data, &m); err != nil {\n        return nil, err\n    }\n    if m == nil {\n        m = map[string]*ArtifactMeta{}\n    }\n    return m, nil\n}\n\nfunc saveArtifacts(newMeta map[string]*ArtifactMeta) error {\n    existing, err := loadArtifacts()\n    if err != nil {\n        return err\n    }\n    for k, v := range newMeta {\n        existing[k] = v\n    }\n    if err := os.MkdirAll(".mlpipe", 0755); err != nil {\n        return err\n    }\n    data, err := json.MarshalIndent(existing, "", "  ")\n    if err != nil {\n        return err\n    }\n    return os.WriteFile(artifactsPath(), data, 0644)\n}\n\nfunc saveRun(run *RunOutput) error {\n    dir := filepath.Join(".mlpipe", "runs")\n    if err := os.MkdirAll(dir, 0755); err != nil {\n        return err\n    }\n    name := safeFileName(run.Pipeline)\n    if name == "" {\n        name = "pipeline"\n    }\n    path := filepath.Join(dir, fmt.Sprintf("%s-%d.json", name, time.Now().UnixNano()))\n    data, err := json.MarshalIndent(run, "", "  ")\n    if err != nil {\n        return err\n    }\n    return os.WriteFile(path, data, 0644)\n}\n\nfunc safeFileName(s string) string {\n    if s == "" {\n        return "pipeline"\n    }\n    return strings.Map(func(r rune) rune {\n        if r == \'/\' || r == \'\\\\\' || r == \':\' || r == \' \' {\n            return \'_\'\n        }\n        return r\n    }, s)\n}\n\nfunc queryLineage(id string, direction string) (map[string]interface{}, error) {\n    artifacts, err := loadArtifacts()\n    if err != nil {\n        return nil, err\n    }\n    if _, ok := artifacts[id]; !ok {\n        return nil, fmt.Errorf("artifact not found: %s", id)\n    }\n\n    set := map[string]bool{}\n    switch direction {\n    case "up":\n        collectAncestors(id, artifacts, set)\n    case "down":\n        collectDescendants(id, artifacts, set)\n    case "both":\n        set[id] = true\n        collectBoth(id, artifacts, set)\n    default:\n        return nil, fmt.Errorf("invalid direction %q", direction)\n    }\n\n    ids := []string{}\n    for k := range set {\n        ids = append(ids, k)\n    }\n    sort.Slice(ids, func(i, j int) bool {\n        a := artifacts[ids[i]]\n        b := artifacts[ids[j]]\n        if a.Timestamp != b.Timestamp {\n            return a.Timestamp < b.Timestamp\n        }\n        return ids[i] < ids[j]\n    })\n\n    lineage := []map[string]interface{}{}\n    for _, aid := range ids {\n        m := artifacts[aid]\n        inputs := m.Inputs\n        outputs := m.Outputs\n        if inputs == nil {\n            inputs = []string{}\n        }\n        if outputs == nil {\n            outputs = []string{}\n        }\n        lineage = append(lineage, map[string]interface{}{\n            "id":      m.ID,\n            "stage":   m.Stage,\n            "port":    m.Port,\n            "type":    m.Type,\n            "inputs":  inputs,\n            "outputs": outputs,\n        })\n    }\n\n    return map[string]interface{}{\n        "artifact_id": id,\n        "lineage":    lineage,\n    }, nil\n}\n\nfunc collectAncestors(id string, artifacts map[string]*ArtifactMeta, set map[string]bool) {\n    m, ok := artifacts[id]\n    if !ok {\n        return\n    }\n    for _, in := range m.Inputs {\n        if !set[in] {\n            set[in] = true\n            collectAncestors(in, artifacts, set)\n        }\n    }\n}\n\nfunc collectDescendants(id string, artifacts map[string]*ArtifactMeta, set map[string]bool) {\n    m, ok := artifacts[id]\n    if !ok {\n        return\n    }\n    for _, out := range m.Outputs {\n        if !set[out] {\n            set[out] = true\n            collectDescendants(out, artifacts, set)\n        }\n    }\n}\n\nfunc collectBoth(id string, artifacts map[string]*ArtifactMeta, set map[string]bool) {\n    m, ok := artifacts[id]\n    if !ok {\n        return\n    }\n    for _, in := range m.Inputs {\n        if !set[in] {\n            set[in] = true\n            collectBoth(in, artifacts, set)\n        }\n    }\n    for _, out := range m.Outputs {\n        if !set[out] {\n            set[out] = true\n            collectBoth(out, artifacts, set)\n        }\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
