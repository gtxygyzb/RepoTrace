ames := map[string]bool{}\n\tfor name := range stages1 {\n\t\tallNames[name] = true\n\t}\n\tfor name := range stages2 {\n\t\tallNames[name] = true\n\t}\n\n\tnames := make([]string, 0, len(allNames))\n\tfor name := range allNames {\n\t\tnames = append(names, name)\n\t}\n\tsort.Strings(names)\n\n\tfor _, name := range names {\n\t\ts1, ok1 := stages1[name]\n\t\ts2, ok2 := stages2[name]\n\t\tif !ok1 {\n\t\t\tresult.StagesAdded = append(result.StagesAdded, name)\n\t\t\tcontinue\n\t\t}\n\t\tif !ok2 {\n\t\t\tresult.StagesRemoved = append(result.StagesRemoved, name)\n\t\t\tcontinue\n\t\t}\n\t\tdiff := diffStages(s1, s2)\n\t\tif diff == nil {\n\t\t\tresult.StagesUnchanged = append(result.StagesUnchanged, name)\n\t\t} else {\n\t\t\tresult.StagesModified[name] = *diff\n\t\t}\n\t}\n\n\treturn result\n}\n\nfunc diffStages(s1, s2 StageConfig) *StageDiff {\n\tdiff := StageDiff{\n\t\tParamsChanged: map[string]FieldDiff{},\n\t\tInputsChanged: map[string]FieldDiff{},\n\t}\n\tchanged := false\n\n\tif s1.Type != s2.Type {\n\t\tdiff.TypeChanged = &FieldDiff{Old: s1.Type, New: s2.Type}\n\t\tchanged = true\n\t}\n\n\tif !sameStringList(s1.DependsOn, s2.DependsOn) {\n\t\tdiff.DepsChanged = &ListDiff{Old: s1.DependsOn, New: s2.DependsOn}\n\t\tchanged = true\n\t}\n\n\tif !sameMap(s1.Params, s2.Params) {\n\t\tallKeys := map[string]bool{}\n\t\tfor k := range s1.Params {\n\t\t\tallKeys[k] = true\n\t\t}\n\t\tfor k := range s2.Params {\n\t\t\tallKeys[k] = true\n\t\t}\n\t\tkeys := make([]string, 0, len(allKeys))\n\t\tfor k := range allKeys {\n\t\t\tkeys = append(keys, k)\n\t\t}\n\t\tsort.Strings(keys)\n\t\tfor _, k := range keys {\n\t\t\tv1, ok1 := s1.Params[k]\n\t\t\tv2, ok2 := s2.Params[k]\n\t\t\tif ok1 && ok2 {\n\t\t\t\tif !reflect.DeepEqual(v1, v2) {\n\t\t\t\t\tdiff.ParamsChanged[k] = FieldDiff{Old: v1, New: v2}\n\t\t\t}\n\t\t\t} else if ok1 {\n\t\t\t\tdiff.ParamsChanged[k] = FieldDiff{Old: v1, New: nil}\n\t\t\t} else {\n\t\t\t\tdiff.ParamsChanged[k] = FieldDiff{Old: nil, New: v2}\n\t\t\t}\n\t\t}\n\t\tif len(diff.ParamsChanged) > 0 {\n\t\t\tchanged = true\n\t\t} else {\n\t\t\tdiff.ParamsChanged = nil\n\t\t}\n\t}\n\n\tif !sameMap(s1.Inputs, s2.Inputs) {\n\t\tallKeys := map[string]bool{}\n\t\tfor k := range s1.Inputs {\n\t\t\tallKeys[k] = true\n\t\t}\n\t\tfor k := range s2.Inputs {\n\t\t\tallKeys[k] = true\n\t\t}\n\t\tkeys := make([]string, 0, len(allKeys))\n\t\tfor k := range allKeys {\n\t\t\tkeys = append(keys, k)\n\t\t}\n\t\tsort.Strings(keys)\n\t\tfor _, k := range keys {\n\t\t\tv1, ok1 := s1.Inputs[k]\n\t\t\tv2, ok2 := s2.Inputs[k]\n\t\t\tif ok1 && ok2 {\n\t\t\t\tif !reflect.DeepEqual(v1, v2) {\n\t\t\t\t\tdiff.InputsChanged[k] = FieldDiff{Old: v1, New: v2}\n\t\t\t}\n\t\t\t} else if ok1 {\n\t\t\t\tdiff.InputsChanged[k] = FieldDiff{Old: v1, New: nil}\n\t\t\t} else {\n\t\t\t\tdiff.InputsChanged[k] = FieldDiff{Old: nil, New: v2}\n\t\t\t}\n\t\t}\n\t\tif len(diff.InputsChanged) > 0 {\n\t\t\tchanged = true\n\t\t} else {\n\t\t\tdiff.InputsChanged = nil\n\t\t}\n\t}\n\n\tif !changed {\n\t\treturn nil\n\t}\n\treturn &diff\n}\n\nfunc sameStringList(a, b []string) bool {\n\tif len(a) != len(b) {\n\t\treturn false\n\t}\n\tfor i := range a {\n\t\tif a[i] != b[i] {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc sameMap(a, b map[string]interface{}) bool {\n\tif len(a) != len(b) {\n\t\treturn false\n\t}\n\tfor k, v := range a {\n\t\tbv, ok := b[k]\n\t\tif !ok || !reflect.DeepEqual(v, bv) {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
