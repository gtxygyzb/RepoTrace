t)\n    default:\n        printError(fmt.Sprintf("unknown registry command: %s", sub))\n    }\n}\n\nfunc cmdRegistryList(args []string) {\n    name, stage, tag := "", "", ""\n    for i := 0; i < len(args); i++ {\n        switch {\n        case args[i] == "--name" && i+1 < len(args):\n            name = args[i+1]\n            i++\n        case strings.HasPrefix(args[i], "--name="):\n            name = strings.TrimPrefix(args[i], "--name=")\n        case args[i] == "--stage" && i+1 < len(args):\n            stage = args[i+1]\n            i++\n        case strings.HasPrefix(args[i], "--stage="):\n            stage = strings.TrimPrefix(args[i], "--stage=")\n        case args[i] == "--tag" && i+1 < len(args):\n            tag = args[i+1]\n            i++\n        case strings.HasPrefix(args[i], "--tag="):\n            tag = strings.TrimPrefix(args[i], "--tag=")\n        default:\n            printError(fmt.Sprintf("unknown flag: %s", args[i]))\n            return\n        }\n    }\n    entries, err := listRegistry(name, stage, tag)\n    if err != nil {\n        printError(err.Error())\n        return\n    }\n    printJSON(entries)\n}\n\nfunc cmdRegistryInfo(args []string) {\n    if len(args) < 1 {\n        printError("usage: mlpipe registry info <name>:<version>")\n        return\n    }\n    name, version, ok := splitNameVersion(args[0])\n    if !ok {\n        printError("invalid name:version format")\n        return\n    }\n    entry, err := registryInfo(name, version)\n    if err != nil {\n        printError(err.Error())\n        return\n    }\n    printJSON(entry)\n}\n\nfunc cmdRegistryPromote(args []string) {\n    if len(args) < 2 {\n        printError("usage: mlpipe registry promote <name>:<version> <target_stage>")\n        return\n    }\n    name, version, ok := splitNameVersion(args[0])\n    if !ok {\n        printError("invalid name:version format")\n        return\n    }\n    target := args[1]\n    entry, prev, new, err := promoteModel(name, version, target)\n 