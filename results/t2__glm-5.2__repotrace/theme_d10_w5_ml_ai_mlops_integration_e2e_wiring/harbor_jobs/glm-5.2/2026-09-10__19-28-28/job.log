th)\n    case "knn":\n        k := getIntDefault(hp, "k", 5)\n        if k <= 0 {\n            k = 1\n        }\n        model.KNN = &KNNModel{K: k, Features: X, Targets: y, Classification: classification}\n    default:\n        return nil, fmt.Errorf("unsupported algorithm: %s", algorithm)\n    }\n\n    preds := model.PredictBatch(X)\n    predRows := make([][]string, len(ds.Rows))\n    for i := range ds.Rows {\n        row := append([]string{}, ds.Rows[i]...)\n        row = append(row, formatFloat(preds[i]))\n        predRows[i] = row\n    }\n    predDS := &Dataset{\n        Columns: append(append([]string{}, ds.Columns...), "prediction"),\n        Types: append(append([]string{}, ds.Types...), "numeric"),\n        Rows: predRows,\n    }\n\n    return map[string]*ArtifactValue{"model": {Model: model}, "predictions": {Dataset: predDS}}, nil\n}\n\nfunc isBinary01(vals []float64) bool {\n    for _, v := range vals {\n        if v != 0 && v != 1 {\n            return false\n        }\n    }\n    return true\n}\n\nfunc getMapDefault(params map[string]interface{}, key string, def map[string]interface{}) map[string]interface{} {\n    if v, ok := getMap(params, key); ok {\n        return v\n    }\n    return def\n}\n\nfunc getStringDefault(params map[string]interface{}, key string, def string) string {\n    if v, ok := getString(params, key); ok {\n        return v\n    }\n    return def\n}\n\nfunc trainLinearRegression(X [][]float64, y []float64) ([]float64, error) {\n    n := len(X)\n    if n == 0 {\n        return nil, fmt.Errorf("no training data")\n    }\n    m := len(X[0])\n    // design matrix with bias\n    A := make([][]float64, n)\n    for i := range X {\n        A[i] = append([]float64{1}, X[i]...)\n    }\n    // normal equation: w = (A^T A)^-1 A^T y\n    AtA := make([][]float64, m+1)\n    for i := range AtA {\n        AtA[i] = make([]float64, m+1)\n    }\n    AtY := make([]float64, m+1)\n    for i := 0; i < n; i++ {\n        for a := 0; a <= m; a++ {\n            AtY[a] += A[i][a] * y[i]\n            for b := 0; b <= m; b++ {\n                AtA[a][b] += A[i][a] * A[i][b]\n            }\n        }\n    }\n    inv, err := invertMatrix(AtA)\n    if err != nil {\n        return nil, err\n    }\n    w := make([]float64, m+1)\n    for a := 0; a <= m; a++ {\n        for b := 0; b <= m; b++ {\n            w[a] += inv[a][b] * AtY[b]\n        }\n    }\n    return w, nil\n}\n\nfunc invertMatrix(m [][]float64) ([][]float64, error) {\n    n := len(m)\n    a := make([][]float64, n)\n    for i := range m {\n        a[i] = append([]float64{}, m[i]...)\n        a[i] = append(a[i], make([]float64, n)...)\n        a[i][n+i] = 1\n    }\n    for i := 0; i < n; i++ {\n        pivot := a[i][i]\n        if math.Abs(pivot) < 1e-12 {\n            // try pivot swap\n            swap := -1\n            for r := i + 1; r < n; r++ {\n                if math.Abs(a[r][i]) > 1e-12 {\n                    swap = r\n                    break\n                }\n            }\n            if swap == -1 {\n                return nil, fmt.Errorf("matrix not invertible")\n            }\n            a[i], a[swap] = a[swap], a[i]\n            pivot = a[i][i]\n        }\n        for j := 0; j < 2*n; j++ {\n            a[i][j] /= pivot\n        }\n        for r := 0; r < n; r++ {\n            if r == i {\n                continue\n            }\n            factor := a[r][i]\n            for j := 0; j < 2*n; j++ {\n                a[r][j] -= factor * a[i][j]\n            }\n        }\n    }\n    inv := make([][]float64, n)\n    for i := range inv {\n        inv[i] = make([]float64, n)\n        copy(inv[i], a[i][n:])\n    }\n    return inv, nil\n}\n\nfunc trainLogisticRegression(X [][]float64, y []float64, lr float64, epochs int) ([]float64, error) {\n    n := len(X)\n    if n == 0 {\n        return nil, fmt.Errorf("no training data")\n    }\n    m := len(X[0])\n    w := make([]float64, m+1)\n    for e := 0; e < epochs; e++ {\n        grad := make([]float64, m+1)\n        for i := 0; i < n; i++ {\n            z := w[0]\n            for j := 0; j < m; j++ {\n                z += w[j+1] * X[i][j]\n            }\n            p := 1 / (1 + math.Exp(-z))\n            err := p - y[i]\n            grad[0] += err\n            for j := 0; j < m; j++ {\n                grad[j+1] += err * X[i][j]\n            }\n        }\n        for j := range w {\n            w[j] -= lr * grad[j] / float64(n)\n        }\n    }\n    return w, nil\n}\n\nfunc trainDecisionTree(X [][]float64, y []float64, features []string, classification bool, depth, maxDepth, minSplit int) *TreeNode {\n    node := &TreeNode{}\n    if len(y) == 0 {\n        node.IsLeaf = true\n        return node\n    }\n    mean := 0.0\n    for _, v := range y {\n        mean += v\n    }\n    mean /= float64(len(y))\n\n    if depth >= maxDepth || len(y) < minSplit || len(features) == 0 {\n        node.IsLeaf = true\n        node.Prediction = mean\n        if classification {\n            node.Probability = mean\n        }\n        return node\n    }\n\n    bestGain := 0.0\n    bestFeature := -1\n    bestThreshold := 0.0\n    bestLeftIdx := []int(nil)\n    bestRightIdx := []int(nil)\n\n    impurity := giniOrVariance(y, classification)\n    for j := 0; j < len(features); j++ {\n        values := make([]float64, len(X))\n        for i := 0; i < len(X); i++ {\n            values[i] = X[i][j]\n        }\n        sorted := uniqueFloats(values)\n        sort.Float64s(sorted)\n        for s := 0; s < len(sorted)-1; s++ {\n            threshold := (sorted[s] + sorted[s+1]) / 2\n            leftIdx := []int{}\n            rightIdx := []int{}\n            for i := 0; i < len(X); i++ {\n                if X[i][j] <= threshold {\n                    leftIdx = append(leftIdx, i)\n                } else {\n                    rightIdx = append(rightIdx, i)\n                }\n            }\n            if len(leftIdx) == 0 || len(rightIdx) == 0 {\n                continue\n            }\n            leftY := subsetY(y, leftIdx)\n            rightY := subsetY(y, rightIdx)\n            leftImp := giniOrVariance(leftY, classification)\n            rightImp := giniOrVariance(rightY, classification)\n            gain := impurity - (float64(len(leftY))*leftImp+float64(len(rightY))*rightImp)/float64(len(y))\n            if gain > bestGain {\n                bestGain = gain\n                bestFeature = j\n                bestThreshold = threshold\n                bestLeftIdx = leftIdx\n                bestRightIdx = rightIdx\n            }\n        }\n    }\n\n    if bestFeature == -1 || bestGain <= 0 {\n        node.IsLeaf = true\n        node.Prediction = mean\n        if classification {\n            node.Probability = mean\n        }\n        return node\n    }\n\n    node.Feature = bestFeature\n    node.Threshold = bestThreshold\n    leftX := subsetRows(X, bestLeftIdx)\n    rightX := subsetRows(X, bestRightIdx)\n    node.Left = trainDecisionTree(leftX, subsetY(y, bestLeftIdx), features, classification, depth+1, maxDepth, minSplit)\n    node.Right = trainDecisionTree(rightX, subsetY(y, bestRightIdx), features, classification, depth+1, maxDepth, minSplit)\n    return node\n}\n\nfunc giniOrVariance(y []float64, classification bool) float64 {\n    if len(y) == 0 {\n        return 0\n    }\n    if classification {\n        counts := map[float64]int{}\n        for _, v := range y {\n            counts[v]++\n        }\n        g := 1.0\n        for _, c := range counts {\n            p := float64(c) / float64(len(y))\n            g -= p * p\n        }\n        return g\n    }\n    mean := 0.0\n    for _, v := range y {\n        mean += v\n    }\n    mean /= float64(len(y))\n    sum := 0.0\n    for _, v := range y {\n        d := v - mean\n        sum += d * d\n    }\n    return sum / float64(len(y))\n}\n\nfunc trainRandomForest(X [][]float64, y []float64, features []string, classification bool, nEst, maxDepth int, maxFeatures string, stageName string) []*TreeNode {\n    forest := []*TreeNode{}\n    rng := rand.New(rand.NewSource(int64(nEst * 12345)))\n    m := len(features)\n    mf := m\n    switch maxFeatures {\n    case "sqrt":\n        mf = int(math.Sqrt(float64(m)))\n    case "log2":\n        mf = int(math.Log2(float64(m)))\n    case "all":\n        mf = m\n    }\n    if mf < 1 {\n        mf = 1\n    }\n    for i := 0; i < nEst; i++ {\n        n := len(X)\n        idx := make([]int, n)\n        for j := 0; j < n; j++ {\n            idx[j] = rng.Intn(n)\n        }\n        bootX := subsetRows(X, idx)\n        bootY := subsetY(y, idx)\n        // feature subset: use all features but limit split search by selecting features\n        selected := rng.Perm(m)\n        selected = selected[:mf]\n        subFeatures := []string{}\n        subX := make([][]float64, len(bootX))\n        for r := range bootX {\n            subX[r] = []float64{}\n            for _, s := range selected {\n                subX[r] = append(subX[r], bootX[r][s])\n            }\n        }\n        for _, s := range selected {\n            subFeatures = append(subFeatures, features[s])\n        }\n        tree := trainDecisionTree(subX, bootY, subFeatures, classification, 0, maxDepth, 2)\n        forest = append(forest, tree)\n    }\n    return forest\n}\n\nfunc trainGradientBoost(X [][]float64, y []float64, classification bool, nEst int, lr float64, maxDepth int) []*BoostedTree {\n    trees := []*BoostedTree{}\n    init := 0.0\n    if classification {\n        p := 0.0\n        for _, v := range y {\n            p += v\n        }\n        p /= float64(len(y))\n        if p <= 0 {\n            p = 1e-15\n        }\n        if p >= 1 {\n            p = 1 - 1e-15\n        }\n        init = math.Log(p / (1 - p))\n    } else {\n        for _, v := range y {\n            init += v\n        }\n        init /= float64(len(y))\n    }\n\n    current := make([]float64, len(y))\n    for i := range y {\n        current[i] = init\n    }\n    features := []string{}\n    for