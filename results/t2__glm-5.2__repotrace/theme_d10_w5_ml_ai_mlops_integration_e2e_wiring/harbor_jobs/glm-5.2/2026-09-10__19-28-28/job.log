tage,\n\\t})\n}\n\'\'\'\nnew = \'\'\'func cmdRegistryPromote(args []string) {\n\\tvar positionals []string\n\\tforce := false\n\\tfor _, a := range args {\n\\t\\tif a == "--force" {\n\\t\\t\\tforce = true\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif strings.HasPrefix(a, "--") {\n\\t\\t\\tprintError(fmt.Sprintf("unknown flag: %s", a))\n\\t\\t\\treturn\n\\t\\t}\n\\t\\tpositionals = append(positionals, a)\n\\t}\n\\tif len(positionals) < 2 {\n\\t\\tprintError("usage: mlpipe registry promote <name>:<version> <target_stage> [--force]")\n\\t\\treturn\n\\t}\n\\tname, version, ok := splitNameVersion(positionals[0])\n\\tif !ok {\n\\t\\tprintError("invalid name:version format")\n\\t\\treturn\n\\t}\n\\ttarget := positionals[1]\n\\tentry, prev, new, warnings, err := promoteModel(name, version, target, force)\n\\tif err != nil {\n\\t\\tif strings.HasPrefix(err.Error(), "metric ") {\n\\t\\t\\tprintJSON(map[string]interface{}{"success": false, "message": err.Error()})\n\\t\\t\\treturn\n\\t\\t}\n\\t\\tprintError(err.Error())\n\\t\\treturn\n\\t}\n\\tmessage := fmt.Sprintf("promoted to %s", new)\n\\tif force {\n\\t\\tmessage = fmt.Sprintf("promoted to %s (forced)", new)\n\\t}\n\\tresult := map[string]interface{}{\n\\t\\t"success":        true,\n\\t\\t"message":        message,\n\\t\\t"previous_stage": prev,\n\\t\\t\\t"new_stage":      entry.Stage,\n\\t}\n\\tif force {\n\\t\\tresult["warnings"] = warnings\n\\t}\n\\tprintJSON(result)\n}\n\'\'\'\nif old not in s:\n    raise SystemExit("main.go promote pattern not found")\ns = s.replace(old, new)\n\n# Update validate command to never write to stderr\nimport re\npattern = r\'func cmdValidate\\(args \\[\\]string\\) \\{.*?\\n\\}\'\nnew_func = \'\'\'func cmdValidate(args []string) {\n\\tconfigPath := ""\n\\toverrides := map[string]string{}\n\\tfail := func(msg string) {\n\\t\\tprintJSON(map[string]interface{}{"valid": false, "errors": []string{msg}})\n\\t}\n\\tfor i := 0; i < len(args); i++ {\n\\t\\tswitch {\n\\t\\tcase args[i] == "--param":\n\\t\\t