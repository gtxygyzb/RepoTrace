ge %q input %q references unavailable output %s.%s", stage.Name, local, depStage, port)\n        }\n        val, ok := e.values[depStage][port]\n        if !ok || val == nil {\n            return nil, nil, fmt.Errorf("stage %q input %q references unavailable artifact %s.%s", stage.Name, local, depStage, port)\n        }\n        inputs[local] = val\n        ids = append(ids, id)\n    }\n    return inputs, ids, nil\n}\n\nfunc executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\n    switch stage.Type {\n    case "data-source":\n        return executeDataSource(stage, params, inputs)\n    case "transform":\n        return executeTransform(stage, params, inputs)\n    case "split":\n        return executeSplit(stage, params, inputs)\n    case "train":\n        return executeTrain(stage, params, inputs)\n    case "evaluate":\n        return executeEvaluate(stage, params, inputs)\n    case "register":\n        return executeRegister(stage, params, inputs)\n    }\n    return nil, fmt.Errorf("unknown stage type %q", stage.Type)\n}\n\nfunc executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\n    path, ok := getString(params, "path")\n    if !ok {\n        return nil, fmt.Errorf("data-source stage %q requires path", stage.Name)\n    }\n    schema, _ := getMap(params, "schema")\n    ds, err := loadDataset(path, schema)\n    if err != nil {\n        return nil, err\n    }\n    return map[string]*ArtifactValue{"data": {Dataset: ds}}, nil\n}\n\nfunc (c *Config) topologicalOrder() ([]string, error) {\n    indeg := map[string]int{}\n    adj := map[string][]string{}\n    for _, s := range c.Stages {\n        indeg[s.Name] = 0\n    }\n    for _, s := range c.Stages {\n        for _, dep := range s.DependsOn {\n            if _, ok := c.stageByName(dep); ok {\n                adj[dep] = append(adj[dep], s.Name)\n     