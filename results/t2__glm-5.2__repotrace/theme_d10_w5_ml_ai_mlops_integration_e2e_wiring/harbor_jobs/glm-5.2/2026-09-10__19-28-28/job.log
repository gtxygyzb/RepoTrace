Sending keys: ["python3 - <<'PY'\np='train.go'\ns=open(p).read()\nold='''func trainDecisionTree(X [][]float64, y []float64, features []string, classification bool, depth, maxDepth, minSplit int) *TreeNode {\n    node := &TreeNode{}\n    if len(y) == 0 {\n        node.IsLeaf = true\n        return node\n    }\n    mean := 0.0\n    for _, v := range y {\n        mean += v\n    }\n    mean /= float64(len(y))\n\n    if depth >= maxDepth || len(y) < minSplit || len(features) == 0 {\n        node.IsLeaf = true\n        node.Prediction = mean\n        if classification {\n            node.Probability = mean\n        }\n        return node\n    }\n\n    bestGain := 0.0\n    bestFeature := -1\n    bestThreshold := 0.0\n    bestLeftIdx := []int(nil)\n    bestRightIdx := []int(nil)\n\n    impurity := giniOrVariance(y, classification)\n    for j := 0; j < len(features); j++ {\n        values := make([]float64, len(X))\n        for i := 0; i < len(X); i++ {\n            values[i] = X[i][j]\n        }\n        sorted := uniqueFloats(values)\n        sort.Float64s(sorted)\n        for s := 0; s < len(sorted)-1; s++ {\n            threshold := (sorted[s] + sorted[s+1]) / 2\n            leftIdx := []int{}\n            rightIdx := []int{}\n            for i := 0; i < len(X); i++ {\n                if X[i][j] <= threshold {\n                    leftIdx = append(leftIdx, i)\n                } else {\n                    rightIdx = append(rightIdx, i)\n                }\n            }\n            if len(leftIdx) == 0 || len(rightIdx) == 0 {\n                continue\n            }\n            leftY := subsetY(y, leftIdx)\n            rightY := subsetY(y, rightIdx)\n            leftImp := giniOrVariance(leftY, classification)\n            rightImp := giniOrVariance(rightY, classification)\n            gain := impurity - (float64(len(leftY))*leftImp+float64(len(rightY))*rightImp)/float64(len(y))\n            if gain > bestGain {\n                bestGain = gain\n                bestFeature = j\n                bestThreshold = threshold\n                bestLeftIdx = leftIdx\n                bestRightIdx = rightIdx\n            }\n        }\n    }\n\n    if bestFeature == -1 || bestGain <= 0 {\n        node.IsLeaf = true\n        node.Prediction = mean\n        if classification {\n            node.Probability = mean\n        }\n        return node\n    }\n\n    node.Feature = bestFeature\n    node.Threshold = bestThreshold\n    leftX := subsetRows(X, bestLeftIdx)\n    rightX := subsetRows(X, bestRightIdx)\n    node.Left = trainDecisionTree(leftX, subsetY(y, bestLeftIdx), features, classification, depth+1, maxDepth, minSplit)\n    node.Right = trainDecisionTree(rightX, subsetY(y, bestRightIdx), features, classification, depth+1, maxDepth, minSplit)\n    return node\n}'''\nnew='''func trainDecisionTree(X [][]float64, y []float64, features []string, classification bool, depth, maxDepth, minSplit int) *TreeNode {\n    return trainDecisionTreeFeatures(X, y, features, classifyFeatures(features), classification, depth, maxDepth, minSplit)\n}\n\nfunc classifyFeatures(features []string) []int {\n    idx := make([]int, len(features))\n    for i := range features {\n        idx[i] = i\n    }\n    return idx\n}\n\nfunc trainDecisionTreeFeatures(X [][]float64, y []float64, features []string, featureIdx []int, classification bool, depth, maxDepth, minSplit int) *TreeNode {\n    node := &TreeNode{}\n    if len(y) == 0 {\n        node.IsLeaf = true\n        return node\n    }\n    mean := 0.0\n    for _, v := range y {\n        mean += v\n    }\n    mean /= float64(len(y))\n\n    if depth >= maxDepth || len(y) < minSplit || len(featureIdx) == 0 {\n        node.IsLeaf = true\n        node.Prediction = mean\n        if classification {\n            node.Probability = mean\n        }\n        return node\n    }\n\n    bestGain := 0.0\n    bestFeaturePos := -1\n    bestFeatureIdx := -1\n    bestThreshold := 0.0\n    bestLeftIdx := []int(nil)\n    bestRightIdx := []int(nil)\n\n    impurity := giniOrVariance(y, classification)\n    for pos, j := range featureIdx {\n        values := make([]float64, len(X))\n        for i := 0; i < len(X); i++ {\n            values[i] = X[i][j]\n        }\n        sorted := uniqueFloats(values)\n        sort.Float64s(sorted)\n        for s := 0; s < len(sorted)-1; s++ {\n            threshold := (sorted[s] + sorted[s+1]) / 2\n            leftIdx := []int{}\n            rightIdx := []int{}\n            for i := 0; i < len(X); i++ {\n                if X[i][j] <= threshold {\n                    leftIdx = append(leftIdx, i)\n                } else {\n                    rightIdx = append(rightIdx, i)\n                }\n            }\n            if len(leftIdx) == 0 || len(rightIdx) == 0 {\n                continue\n            }\n            leftY := subsetY(y, leftIdx)\n            rightY := subsetY(y, rightIdx)\n            leftImp := giniOrVariance(leftY, classification)\n            rightImp := giniOrVariance(rightY, classification)\n            gain := impurity - (float64(len(leftY))*leftImp+float64(len(rightY))*rightImp)/float64(len(y))\n            if gain > bestGain {\n                bestGain = gain\n                bestFeaturePos = pos\n                bestFeatureIdx = j\n                bestThreshold = threshold\n                bestLeftIdx = leftIdx\n                bestRightIdx = rightIdx\n            }\n        }\n    }\n\n    if bestFeaturePos == -1 || bestGain <= 0 {\n        node.IsLeaf = true\n        node.Prediction = mean\n        if classification {\n            node.Probability = mean\n        }\n        return node\n    }\n\n    node.Feature = bestFeatureIdx\n    node.Threshold = bestThreshold\n    nextIdx := append([]int{}, featureIdx...)\n    // remove selected feature from allowed features for children\n    nextIdx = append(nextIdx[:bestFeaturePos], nextIdx[bestFeaturePos+1:]...)\n    leftX := subsetRows(X, bestLeftIdx)\n    rightX := subsetRows(X, bestRightIdx)\n    node.Left = trainDecisionTreeFeatures(leftX, subsetY(y, bestLeftIdx), features, nextIdx, classification, depth+1, maxDepth, minSplit)\n    node.Right = trainDecisionTreeFeatures(rightX, subsetY(y, bestRightIdx), features, nextIdx, classification, depth+1, maxDepth, minSplit)\n    return node\n}'''\nif old not in s:\n    raise SystemExit('pattern not found train tree')\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
