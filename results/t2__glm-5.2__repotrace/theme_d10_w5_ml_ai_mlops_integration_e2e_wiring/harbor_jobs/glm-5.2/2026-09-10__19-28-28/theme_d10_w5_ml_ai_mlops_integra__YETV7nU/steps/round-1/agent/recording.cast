[12035.514854, "o", "     6\t)\r\n     7\t\r\n     8\ttype StageDiff struct {\r\n     9\t\tTypeChanged   *FieldDiff           `json:\"type_changed,omitempty\"`\r\n    10\t\tParamsChanged map[string]FieldDiff `json:\"params_changed,omitempty\"`\r\n    11\t\tDepsChanged   *ListDiff            `json:\"deps_changed,omitempty\"`\r\n    12\t\tInputsChanged map[string]FieldDiff `json:\"inputs_changed,omitempty\"`\r\n    13\t}\r\n    14\t\r\n    15\ttype FieldDiff struct {\r\n    16\t\tOld interface{} `json:\"old\"`\r\n    17\t\tNew interface{} `json:\"new\"`\r\n    18\t}\r\n"]
[12035.514944, "o", "    19\t\r\n    20\ttype ListDiff struct {\r\n    21\t\tOld []string `json:\"old\"`\r\n    22\t\tNew []string `json:\"new\"`\r\n    23\t}\r\n    24\t\r\n    25\ttype ConfigDiff struct {\r\n    26\t\tPipelineName    *FieldDiff           `json:\"pipeline_name,omitempty\"`\r\n    27\t\tStagesAdded     []string             `json:\"stages_added\"`\r\n    28\t\tStagesRemoved   []string             `json:\"stages_removed\"`\r\n    29\t\tStagesModified  map[string]StageDiff `json:\"stages_modified\"`\r\n"]
[12035.515014, "o", "    30\t\tStagesUnchanged []string             `json:\"stages_unchanged\"`\r\n    31\t}\r\n    32\t\r\n    33\tfunc cmdDiff(args []string) {\r\n    34\t\tif len(args) != 2 {\r\n    35\t\t\texitError(\"usage: mlpipe diff <config1.json> <config2.json>\")\r\n    36\t\t\treturn\r\n    37\t\t}\r\n    38\t\tconfig1, err := loadConfig(args[0])\r\n    39\t\tif err != nil {\r\n    40\t\t\t"]
[12035.515077, "o", "exitError(err.Error())\r\n    41\t\t\treturn\r\n    42\t\t}\r\n    43\t\tconfig2, err := loadConfig(args[1])\r\n    44\t\tif err != nil {\r\n    45\t\t\texitError(err.Error())\r\n    46\t\t\treturn\r\n    47\t\t}\r\n    48\t\tprintJSON(diffConfigs(config1, config2))\r\n"]
[12035.515141, "o", "    49\t}\r\n    50\t\r\n    51\tfunc diffConfigs(c1, c2 *Config) ConfigDiff {\r\n    52\t\tresult := ConfigDiff{\r\n    53\t\t\tStagesAdded:     []string{},\r\n    54\t\t\tStagesRemoved:   []string{},\r\n    55\t\t\tStagesModified:  map[string]StageDiff{},\r\n    56\t\t\tStagesUnchanged: []string{},\r\n    57\t\t}\r\n    58"]
[12035.515205, "o", "\t\r\n    59\t\tif c1.Pipeline.Name != c2.Pipeline.Name {\r\n    60\t\t\tresult.PipelineName = &FieldDiff{Old: c1.Pipeline.Name, New: c2.Pipeline.Name}\r\n    61\t\t}\r\n    62\t\r\n    63\t\tstages1 := map[string]StageConfig{}\r\n    64\t\tfor _, s := range c1.Stages {\r\n    65\t\t\tstages1[s.Name] = s\r\n    66\t\t}\r\n"]
[12035.515311, "o", "    67\t\tstages2 := map[string]StageConfig{}\r\n    68\t\tfor _, s := range c2.Stages {\r\n    69\t\t\tstages2[s.Name] = s\r\n    70\t\t}\r\n    71\t\r\n    72\t\tallNames := map[string]bool{}\r\n    73\t\tfor name := range stages1 {\r\n    74\t\t\tallNames[name] = true\r\n    75\t\t}\r\n    76\t\tfor name := range stages2 {\r\n    77\t\t\tallNames[name] = true\r\n    78\t\t}\r\n    79"]
[12035.515375, "o", "\t\r\n    80\t\tnames := make([]string, 0, len(allNames))\r\n    81\t\tfor name := range allNames {\r\n    82\t\t\tnames = append(names, name)\r\n    83\t\t}\r\n    84\t\tsort.Strings(names)\r\n    85\t\r\n    86\t\tfor _, name := range names {\r\n    87\t\t\ts1, ok1 := stages1[name]\r\n    88\t\t\ts2, ok2 := stages2[name]\r\n"]
[12035.515437, "o", "    89\t\t\tif !ok1 {\r\n    90\t\t\t\tresult.StagesAdded = append(result.StagesAdded, name)\r\n    91\t\t\t\tcontinue\r\n    92\t\t\t}\r\n    93\t\t\tif !ok2 {\r\n    94\t\t\t\tresult.StagesRemoved = append(result.StagesRemoved, name)\r\n    95\t\t\t\tcontinue\r\n    96\t\t\t}\r\n    97"]
[12035.515501, "o", "\t\t\tdiff := diffStages(s1, s2)\r\n    98\t\t\tif diff == nil {\r\n    99\t\t\t\tresult.StagesUnchanged = append(result.StagesUnchanged, name)\r\n   100\t\t\t} else {\r\n   101\t\t\t\tresult.StagesModified[name] = *diff\r\n"]
[12035.515564, "o", "   102\t\t\t}\r\n   103\t\t}\r\n   104\t\r\n   105\t\treturn result\r\n   106\t}\r\n   107\t\r\n   108\tfunc diffStages(s1, s2 StageConfig) *StageDiff {\r\n   109\t\tdiff := StageDiff{\r\n   110\t\t\tParamsChanged: map[string]FieldDiff{},\r\n   111\t\t\tInputsChanged: map[string]FieldDiff{},\r\n   112\t\t}\r\n   113\t\tchanged := false\r\n   114\t\r\n   115\t\t"]
[12035.515632, "o", "if s1.Type != s2.Type {\r\n   116\t\t\tdiff.TypeChanged = &FieldDiff{Old: s1.Type, New: s2.Type}\r\n   117\t\t\tchanged = true\r\n   118\t\t}\r\n   119\t\r\n   120\t\t"]
[12035.515694, "o", "if !sameStringList(s1.DependsOn, s2.DependsOn) {\r\n"]
