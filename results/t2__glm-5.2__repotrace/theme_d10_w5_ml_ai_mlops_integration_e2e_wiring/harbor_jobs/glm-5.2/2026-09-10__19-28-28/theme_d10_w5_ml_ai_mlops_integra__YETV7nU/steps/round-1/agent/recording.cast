[11921.475626, "o", "   167\tfunc (c *Config) Validate() (bool, []string) {\r\n   168\t\terrors := []string{}\r\n   169\t\tnames := map[string]bool{}\r\n   170\t\tfor i, s := range c.Stages {\r\n   171\t\t\tif s.Name == \"\" {\r\n"]
[11921.475696, "o", "   172\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage at index %d has empty name\", i))\r\n   173\t\t\t\tcontinue\r\n   174\t\t\t}\r\n   175\t\t\tif names[s.Name] {\r\n   176\t\t\t\terrors = append(errors, fmt.Sprintf(\"duplicate stage name: %s\", s.Name))\r\n   177\t\t\t}\r\n   178\t\t\tnames[s.Name] = true\r\n   179\t\t}\r\n   180\t\tfor _, s := range c.Stages {\r\n"]
[11921.475771, "o", "   181\t\t\tif !validStageType(s.Type) {\r\n   182\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q has unknown type %q\", s.Name, s.Type))\r\n   183\t\t\t}\r\n   184\t\t\tfor _, dep := range s.DependsOn {\r\n   185\t\t\t\tif !names[dep] {\r\n   186\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q references unknown dependency %q\", s.Name, dep))\r\n   187\t\t\t\t}\r\n   188\t\t\t}\r\n   189\t\t\tfor local, ref := range s.Inputs {\r\n   190\t\t"]
[11921.47583, "o", "\t\trefs, ok := inputRefs(ref)\r\n   191\t\t\t\tif !ok {\r\n   192\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %v\", s.Name, local, ref))\r\n   193\t\t\t\t\tcontinue\r\n   194\t\t\t\t}\r\n   195\t\t\t\tfor idx, r := range refs {\r\n   196\t\t\t\t"]
[11921.475893, "o", "\tif r == \"\" {\r\n   197\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q[%d] has invalid empty reference\", s.Name, local, idx))\r\n   198\t\t\t\t\t\tcontinue\r\n   199\t\t\t\t\t}\r\n   200\t\t\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n   201\t\t\t\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n   202\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %q\", s.Name, local, r))\r\n"]
[11921.475956, "o", "   203\t\t\t\t\t\tcontinue\r\n   204\t\t\t\t\t}\r\n   205\t\t\t\t\trefStage, ok := c.stageByName(parts[0])\r\n   206\t\t\t\t\tif !ok {\r\n"]
[11921.47602, "o", "   207\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown stage %q\", s.Name, local, parts[0]))\r\n   208\t\t\t\t\t\tcontinue\r\n   209\t\t\t\t\t}\r\n   210\t\t\t\t\tports := validOutputPorts(refStage.Type)\r\n   211\t\t\t\t\tvalid := false\r\n   212\t\t\t\t\tfor _, p := range ports {\r\n"]
[11921.476097, "o", "   213\t\t\t\t\t\tif p == parts[1] {\r\n   214\t\t\t\t\t\t\tvalid = true\r\n   215\t\t\t\t\t\t\tbreak\r\n   216\t\t\t\t\t\t}\r\n   217\t\t\t\t\t}\r\n   218\t\t\t\t\tif !valid {\r\n   219\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown output port %q on stage %q\", s.Name, local, parts[1], parts[0]))\r\n   220\t\t\t\t\t}\r\n   221\t\t\t\t}\r\n   222\t\t\t\tif s.Type == \"ensemble\" && local == \"models\" {\r\n   223\t\t\t\t\tif _, ok := ref.([]interface{}); !ok {\r\n   224\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q input %q must be an array\", s.Name, local))\r\n   225\t\t\t\t\t}\r\n   226\t\t\t\t}\r\n   227\t"]
[11921.476161, "o", "\t\t}\r\n   228\t\t\tif s.Type == \"ensemble\" {\r\n   229\t\t\t\tmodels, ok := s.Inputs[\"models\"]\r\n   230\t\t\t\tif !ok {\r\n   231\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires inputs.models\", s.Name))\r\n   232\t\t\t\t} else if refs, ok := inputRefs(models); !ok || len(refs) < 2 {\r\n   233\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires at least 2 model inputs\", s.Name))\r\n   234\t\t"]
[11921.476372, "o", "\t\t}\r\n   235\t\t\t\tif _, ok := s.Inputs[\"data\"]; !ok {\r\n   236\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires inputs.data\", s.Name))\r\n   237\t\t\t\t}\r\n   238\t\t\t\tstrategy, _ := getString(s.Params, \"strategy\")\r\n   239\t\t\t\tif strategy != \"vote\" && strategy != \"average\" {\r\n   240\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q has invalid strategy %q (must be vote or average)\", s.Name, strategy))\r\n   241\t\t\t\t}\r\n   242\t\t\t\tif _, ok := getString(s.Params, \"target\"); !ok {\r\n   243\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires target param\", s.Name))\r\n   244\t\t\t\t}\r\n   245\t\t\t}\r\n   246\t\t}\r\n   247\t\tif stages, cycle := c.detectCycle(); cycle {\r\n   248\t\t\terrors = append(errors, fmt.Sprintf(\"cycle detected involving stages: %s\", strings.Join(stages, \", \")))\r\n   249\t\t}\r\n   250\t\treturn len(errors) == 0, errors\r\n"]
