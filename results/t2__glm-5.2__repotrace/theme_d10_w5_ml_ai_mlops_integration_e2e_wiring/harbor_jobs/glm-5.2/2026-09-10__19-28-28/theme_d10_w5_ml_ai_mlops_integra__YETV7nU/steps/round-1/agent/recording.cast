[11906.828268, "o", "nl -ba cache.go | sed -n '101,156p'\r\n"]
[11906.828366, "o", "\u001b[?2004l\r"]
[11906.832434, "o", "   101\tfunc computeCacheKey(stage *StageConfig, params map[string]interface{}, inputKeys map[string]string, fold int) (string, error) {\r\n   102\t\tvar sb strings.Builder\r\n   103\t\tsb.WriteString(stage.Type)\r\n   104\t\tsb.WriteString(\"\\n\")\r\n   105\t\r\n   106\t\tparamsJSON, err := canonicalJSON(params)\r\n   107\t\t"]
[11906.832542, "o", "if err != nil {\r\n   108\t\t\treturn \"\", err\r\n   109\t\t}\r\n   110\t\tsb.WriteString(paramsJSON)\r\n   111\t\tsb.WriteString(\"\\n\")\r\n   112\t\r\n   113\t\tif stage.Type == \"data-source\" {\r\n   114\t\t\tpath, ok := getString(params, \"path\")\r\n   115\t\t\tif !ok {\r\n   116\t\t\t\treturn \"\", fmt.Errorf(\"data-source stage %q requires path for cache key\", stage.Name)\r\n   117\t\t\t}\r\n   118\t\t\tfileHash, err := fileSHA256(path)\r\n   119\t\t\tif err != nil {\r\n   120\t\t\t\treturn \"\", err\r\n"]
[11906.832607, "o", "   121\t\t\t}\r\n   122\t\t\tsb.WriteString(fileHash)\r\n   123\t\t} else {\r\n   124\t\t\tports := make([]string, 0, len(stage.Inputs))\r\n   125\t\t\tfor port := range stage.Inputs {\r\n   126\t\t\t\tports = append(ports, port)\r\n"]
[11906.832669, "o", "   127\t\t\t}\r\n   128\t\t\tsort.Strings(ports)\r\n   129\t\t\tfor i, port := range ports {\r\n   130\t\t\t\tif i > 0 {\r\n   131\t\t\t\t\tsb.WriteString(\"\\n\")\r\n   132\t\t\t\t}\r\n   133"]
[11906.832732, "o", "\t\t\t\tsb.WriteString(port)\r\n   134\t\t\t\tsb.WriteString(\"=\")\r\n   135\t\t\t\tif key, ok := inputKeys[port]; ok {\r\n   136\t\t\t\t\tsb.WriteString(key)\r\n   137\t\t\t\t}\r\n   138\t\t\t}\r\n   139\t\t}\r\n"]
[11906.832791, "o", "   140\t\r\n   141\t\tif fold >= 0 {\r\n   142\t\t\tsb.WriteString(\"\\nfold=\")\r\n   143\t\t\tsb.WriteString(strconv.Itoa(fold))\r\n   144\t\t}\r\n   145\t\r\n   146\t\t"]
[11906.832849, "o", "return sha256Hex([]byte(sb.String())), nil\r\n   147\t}\r\n   148\t\r\n   149\ttype cacheMeta struct {\r\n   150\t\tCacheKey    string   `json:\"cache_key\"`\r\n   151\t\tStageName   string   `json:\"stage_name\"`\r\n   152\t\tStageType   string   `json:\"stage_type\"`\r\n"]
[11906.832909, "o", "   153\t\tCreatedAt   string   `json:\"created_at\"`\r\n   154\t\tOutputPorts []string `json:\"output_ports\"`\r\n   155\t}\r\n   156\t\r\n"]
