[5812.397607, "i", "cat > data.csv << 'EOF'\nx1,x2,y\n1.0,2.0,5.0\n2.0,1.0,7.0\n3.0,4.0,11.0\n4.0,3.0,13.0\n5.0,6.0,17.0\n6.0,5.0,19.0\nEOF\ncat > pipe.json << 'EOF'\n{\"pipeline\":{\"name\":\"smoke\",\"params\":{\"path\":\"data.csv\"},\"stages\":[{\"name\":\"source\",\"type\":\"data-source\",\"params\":{\"path\":\"${path}\"}},{\"name\":\"transform\",\"type\":\"transform\",\"depends_on\":[\"source\"],\"inputs\":{\"data\":\"source.data\"},\"params\":{\"operations\":[{\"op\":\"zscore\",\"columns\":[\"x1\",\"x2\"]}]}},{\"name\":\"split\",\"type\":\"split\",\"depends_on\":[\"transform\"],\"inputs\":{\"data\":\"transform.data\"},\"params\":{\"ratio\":0.5,\"seed\":42}},{\"name\":\"train\",\"type\":\"train\",\"depends_on\":[\"split\"],\"inputs\":{\"data\":\"split.train\"},\"params\":{\"algorithm\":\"linear-regression\",\"target\":\"y\",\"features\":[\"x1\",\"x2\"]}},{\"name\":\"evaluate\",\"type\":\"evaluate\",\"depends_on\":[\"train\",\"split\"],\"inputs\":{\"model\":\"train.model\",\"data\":\"split.test\"},\"params\":{\"metrics\":[\"mse\",\"rmse\"]}},{\"name\":\"register\",\"type\":\"register\",\"depends_on\":[\"train\",\"evaluate\"],\"inputs\":{\"model\":\"train.model\",\"report\":\"evaluate.report\"},\"params\":{\""]
[5812.397914, "i", "model_name\":\"smoke-model\"}}]}\nEOF\n./mlpipe run pipe.json >/dev/null\n./mlpipe run pipe.json | python3 -c 'import json,sys; d=json.load(sys.stdin); print(json.dumps({\"status\":d[\"status\"],\"cache_stats\":d[\"cache_stats\"]}, indent=2))'\n./mlpipe run pipe.json --cv 2 | python3 -c 'import json,sys; d=json.load(sys.stdin); print(json.dumps({\"status\":d[\"status\"],\"cache_stats\":d[\"cache_stats\"],\"fold_statuses\":[f[\"status\"] for f in d[\"fold_results\"]]}, indent=2))'\n./mlpipe plan pipe.json --cv 2 | python3 -c 'import json,sys; d=json.load(sys.stdin); print(json.dumps({\"mode\":d[\"mode\"],\"cv_folds\":d.get(\"cv_folds\"),\"phases\":{k:v[\"cv_phase\"] for k,v in d[\"stages\"].items()}}, indent=2))'\nrm -f data.csv pipe.json\n"]
