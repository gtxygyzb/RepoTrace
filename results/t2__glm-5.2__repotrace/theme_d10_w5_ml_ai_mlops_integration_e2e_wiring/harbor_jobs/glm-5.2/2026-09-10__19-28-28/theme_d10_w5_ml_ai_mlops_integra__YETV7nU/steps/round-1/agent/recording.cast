[10430.041596, "o", "   108\t\t}\r\n   109\t\treturn os.WriteFile(registryPath(), data, 0644)\r\n   110\t}\r\n   111\t\r\n   112\tfunc listRegistry(name, stage, tag string) ([]*RegistryEntry, error) {\r\n   113\t\tentries, err := loadRegistry()\r\n   114\t\tif err != nil {\r\n   115\t\t\treturn nil, err\r\n   116\t\t}\r\n   117\t\tfiltered := []*RegistryEntry{}\r\n   118\t\tfor _, e := range entries {\r\n   119\t\t\tif name != \"\" && e.Name != name {\r\n   120\t\t\t\tcontinue\r\n"]
