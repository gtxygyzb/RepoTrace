[10639.952427, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[10639.952486, "o", "> "]
[10639.952664, "o", "# Update validate command to never write to stderr\r\n\u001b[?2004l\r"]
[10639.952719, "o", "\u001b[?2004h> "]
[10639.952779, "o", "import re\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10639.953031, "o", "pattern = r'func cmdValidate\\(args \\[\\]string\\) \\{.*?\\n\\}'\r\n\u001b[?2004l\r"]
[10639.953085, "o", "\u001b[?2004h> "]
[10639.953276, "o", "new_func = '''func cmdValidate(args []string) {\r\n\u001b[?2004l\r"]
[10639.953333, "o", "\u001b[?2004h> "]
[10639.95339, "o", "\\tconfigPath := \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10639.953496, "o", "\\toverrides := map[string]string{}\r\n\u001b[?2004l\r"]
[10639.953551, "o", "\u001b[?2004h> "]
[10639.953609, "o", "\\tfail := func(msg string) {\r\n\u001b[?2004l\r"]
[10639.953665, "o", "\u001b[?2004h> "]
[10639.953858, "o", "\\t\\tprintJSON(map[string]interface{}{\"valid\": false, \"errors\": []string{msg}})\r\n\u001b[?2004l\r"]
[10639.953935, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[10639.953995, "o", "\u001b[?2004h> "]
[10639.954049, "o", "\\tfor i := 0; i < len(args); i++ {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10639.954108, "o", "\\t\\tswitch {\r\n\u001b[?2004l\r\u001b[?2004h"]
[10639.954168, "o", "> "]
[10639.954239, "o", "\\t\\tcase args[i] == \"--param\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10639.954335, "o", "\\t\\t\\tif i+1 >= len(args) {\r\n\u001b[?2004l\r"]
[10639.95439, "o", "\u001b[?2004h> "]
[10639.954484, "o", "\\t\\t\\t\\tfail(\"--param requires key=value\")\r\n\u001b[?2004l\r"]
[10639.95454, "o", "\u001b[?2004h> "]
[10639.954595, "o", "\\t\\t\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r"]
[10639.95465, "o", "\u001b[?2004h> "]
[10639.954705, "o", "\\t\\t\\tkv := args[i+1]\r\n\u001b[?2004l\r"]
[10639.954759, "o", "\u001b[?2004h> \\t\\t\\ti++\r\n\u001b[?2004l\r"]
[10639.954813, "o", "\u001b[?2004h> "]
[10639.954904, "o", "\\t\\t\\tk, v, ok := strings.Cut(kv, \"=\")\r\n\u001b[?2004l\r"]
[10639.954976, "o", "\u001b[?2004h> \\t\\t\\tif !ok {\r\n\u001b[?2004l\r"]
[10639.955049, "o", "\u001b[?2004h> "]
[10639.955127, "o", "\\t\\t\\t\\tfail(\"--param requires key=value\")\r\n\u001b[?2004l\r"]
[10639.955182, "o", "\u001b[?2004h> "]
[10639.955249, "o", "\\t\\t\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10639.955304, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10639.955365, "o", "\\t\\t\\toverrides[k] = v\r\n\u001b[?2004l\r"]
[10639.95542, "o", "\u001b[?2004h> "]
[10639.955532, "o", "\\t\\tcase strings.HasPrefix(args[i], \"--param=\"):\r\n\u001b[?2004l\r"]
[10639.955587, "o", "\u001b[?2004h> "]
[10639.955708, "o", "\\t\\t\\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n\u001b[?2004l\r"]
[10639.955763, "o", "\u001b[?2004h> "]
[10640.002404, "o", "\\t\\t\\tk, v, ok := strings.Cut(kv, \"=\")\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tif !ok {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\tfail(\"--param requires key=value\")\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\toverrides[k] = v\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tdefault:\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tif configPath == \"\" && !strings.HasPrefix(args[i], \"--\") {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\tconfigPath = args[i]\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\tfail(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\tif configPath == \"\" {\r\n\u001b[?2004l\r"]
[10640.002515, "o", "\u001b[?2004h> "]
[10640.00288, "o", "\\t\\tfail(\"usage: mlpipe validate <config.json> [--param key=value ...]\")\r\n\u001b[?2004l\r"]
[10640.00294, "o", "\u001b[?2004h> "]
[10640.003004, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[10640.003062, "o", "\u001b[?2004h> "]
[10640.003119, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10640.003177, "o", "> "]
[10640.003391, "o", "\\tconfig, err := loadConfig(configPath)\r\n\u001b[?2004l\r"]
[10640.003488, "o", "\u001b[?2004h> "]
[10640.003581, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[10640.003649, "o", "> "]
[10640.003734, "o", "\\t\\tfail(err.Error())\r\n\u001b[?2004l\r"]
[10640.003791, "o", "\u001b[?2004h> "]
[10640.003855, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[10640.003904, "o", "\u001b[?2004h> "]
[10640.003964, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10640.004025, "o", "> "]
[10640.004144, "o", "\\tif len(overrides) > 0 {\r\n\u001b[?2004l\r"]
[10640.0042, "o", "\u001b[?2004h> "]
[10640.004466, "o", "\\t\\tglobals := config.globalParams(overrides)\r\n\u001b[?2004l\r"]
[10640.004522, "o", "\u001b[?2004h> "]
[10640.00473, "o", "\\t\\tconfig.Pipeline.Params = globals\r\n\u001b[?2004l\r"]
[10640.004787, "o", "\u001b[?2004h> "]
[10640.004986, "o", "\\t\\tfor i := range config.Stages {\r\n\u001b[?2004l\r"]
[10640.005041, "o", "\u001b[?2004h> "]
[10640.005509, "o", "\\t\\t\\tconfig.Stages[i].Params = config.stageParams(config.Stages[i].Name, globals)\r\n\u001b[?2004l\r"]
[10640.00557, "o", "\u001b[?2004h> "]
[10640.005628, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[10640.005685, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[10640.00575, "o", "\u001b[?2004h> "]
[10640.005954, "o", "\\tvalid, errors := config.Validate()\r\n\u001b[?2004l\r"]
[10640.006001, "o", "\u001b[?2004h> "]
[10640.006407, "o", "\\tprintJSON(map[string]interface{}{\"valid\": valid, \"errors\": errors})\r\n\u001b[?2004l\r"]
[10640.006465, "o", "\u001b[?2004h> "]
[10640.006528, "o", "}'''\r\n\u001b[?2004l\r\u001b[?2004h"]
[10640.006585, "o", "> "]
[10640.006869, "o", "s2, n = re.subn(pattern, new_func, s, flags=re.DOTALL)\r\n\u001b[?2004l\r"]
[10640.006918, "o", "\u001b[?2004h> "]
[10640.006998, "o", "if n != 1:\r\n\u001b[?2004l\r"]
[10640.007054, "o", "\u001b[?2004h> "]
[10640.007413, "o", "    raise SystemExit(\"main.go validate pattern not replaced\")\r\n\u001b[?2004l\r"]
[10640.00747, "o", "\u001b[?2004h> "]
[10640.00753, "o", "s = s2\r\n\u001b[?2004l\r"]
[10640.007591, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[10640.007646, "o", "\u001b[?2004h> "]
[10640.007726, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[10640.007772, "o", "\u001b[?2004h> "]
[10640.007832, "o", "PY\r\n\u001b[?2004l\r"]
[10640.052515, "o", "\u001b[?2004hroot@n30009:/app# "]
