[10343.341797, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[10343.341921, "o", "\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintError(\"usage: mlpipe <command> [args]\")\r\n\t\treturn\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"plan\":\r\n\t\tcmdPlan(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"registry\":\r\n\t\tcmdRegistry(args)\r\n"]
[10343.342033, "o", "\tcase \"lineage\":\r\n\t\tcmdLineage(args)\r\n\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n\t}\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n\tconfigPath, overrides, cv, noCache, skipStages, err := parseRunArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tfor _, name := range skipStages {\r\n\t\tif _, ok := config.stageByName(name); !ok {\r\n"]
[10343.342174, "o", "\t\t\tprintError(fmt.Sprintf(\"unknown stage: %s\", name))\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n\texecutor := NewExecutor(config, overrides)\r\n\texecutor.noCache = noCache\r\n\texecutor.skipStages = skipStages\r\n\tif noCache {\r\n\t\texecutor.cacheStats = nil\r\n\t}\r\n\texecutor.cvFolds = cv\r\n\tvar run interface{}\r\n\tif cv > 0 {\r\n\t\trun, err = executor.RunCV()\r\n\t} else {\r\n\t\trun, err = executor.Run()\r\n\t}\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n"]
[10343.342385, "o", "\t}\r\n\tprintJSON(run)\r\n}\r\n\r\nfunc cmdPlan(args []string) {\r\n\t"]
[10343.342487, "o", "configPath, overrides, cv, err := parsePlanArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tplan, err := buildPlan(config, overrides, cv)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(plan)\r\n}\r\n\r\nfunc cmdValidate(args []string) {\r\n\tconfigPath := \"\"\r\n\toverrides := map[string]string{}\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--param\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tprintError(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tkv := args[i+1]\r\n\t\t\ti++\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\tprintError(\"--param requires key=value\")\r\n\t\t\t"]
[10343.342588, "o", "\treturn\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tcase strings.HasPrefix(args[i], \"--param=\"):\r\n\t\t\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\tprintError(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tdefault:\r\n\t\t\tif configPath == \"\" && !strings.HasPrefix(args[i], \"--\") {\r\n\t\t\t\tconfigPath = args[i]\r\n\t\t\t} else {\r\n\t\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif configPath == \"\" {\r\n\t\tprintError(\"usage: mlpipe validate <config.json> [--param key=value ...]\")\r\n"]
[10343.342692, "o", "\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n"]
[10343.342784, "o", "\t\treturn\r\n\t}\r\n\tif len(overrides) > 0 {\r\n\t\tglobals := config.globalParams(overrides)\r\n\t\tconfig.Pipeline.Params = globals\r\n\t\tfor i := range config.Stages {\r\n\t\t\tconfig.Stages[i].Params = config.stageParams(config.Stages[i].Name, globals)\r\n\t\t}\r\n\t}\r\n\tvalid, errors := config.Validate()\r\n\tprintJSON(map[string]interface{}{\"valid\": valid, \"errors\": errors})\r\n}\r\n\r\nfunc cmdRegistry(args []string) {\r\n\tif len(args) < 1 {\r\n"]
[10343.342887, "o", "\t\tprintError(\"usage: mlpipe registry <list|info|promote|compare> [args]\")\r\n\t\treturn\r\n\t}\r\n\tsub := args[0]\r\n\trest := args[1:]\r\n\tswitch sub {\r\n\tcase \"list\":\r\n\t\tcmdRegistryList(rest)\r\n\tcase \"info\":\r\n\t\tcmdRegistryInfo(rest)\r\n\tcase \"promote\":\r\n\t\tcmdRegistryPromote(rest)\r\n\tcase \"compare\":\r\n\t\tcmdRegistryCompare(rest)\r\n\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown registry command: %s\", sub))\r\n\t}\r\n}\r\n\r\nfunc cmdRegistryList(args []string) {\r\n\tname, stage, tag := \"\", \"\", \"\"\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--name\" && i+1 < len(args):\r\n\t\t\tname = args[i+1]\r\n"]
[10343.342978, "o", "\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--name=\"):\r\n\t\t\tname = strings.TrimPrefix(args[i], \"--name=\")\r\n\t\tcase args[i] == \"--stage\" && i+1 < len(args):\r\n\t\t\tstage = args[i+1]\r\n\t"]
[10343.343084, "o", "\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--stage=\"):\r\n\t\t\tstage = strings.TrimPrefix(args[i], \"--stage=\")\r\n\t\tcase args[i] == \"--tag\" && i+1 < len(args):\r\n\t\t\ttag = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--tag=\"):\r\n\t\t\ttag = strings.TrimPrefix(args[i], \"--tag=\")\r\n\t\tdefault:\r\n\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n\tentries, err := listRegistry(name, stage, tag)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tout := make([]map[string]interface{}, len(entries))\r\n\tfor i, e := range entries {\r\n\t\tout[i] = map[string]interface{}{\r\n\t\t\t\"name\":          e.Name,\r\n\t\t\t\"version\":       e.Version,\r\n\t\t\t"]
[10343.343182, "o", "\"stage\":         e.Stage,\r\n\t\t\t\"tags\":          e.Tags,\r\n\t\t\t\"metrics\":       e.Metrics,\r\n\t\t\t\"registered_at\": e.RegisteredAt,\r\n\t\t}\r\n\t}\r\n\tprintJSON(out)\r\n}\r\n\r\nfunc cmdRegistryInfo(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe registry info <name>:<version>\")\r\n\t\treturn\r\n\t}\r\n\tname, version, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t"]
[10343.343304, "o", "\treturn\r\n\t}\r\n\tentry, err := registryInfo(name, version)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n"]
[10343.343394, "o", "\t\treturn\r\n\t}\r\n\tprintJSON(entry)\r\n}\r\n\r\nfunc cmdRegistryPromote(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tprintError(\"usage: mlpipe registry promote <name>:<version> <target_stage>\")\r\n\t\treturn\r\n\t}\r\n\tname, version, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\ttarget := args[1]\r\n\tentry, prev, new, err := promoteModel(name, version, target)\r\n\tif err != nil {\r\n\t\tif strings.HasPrefix(err.Error(), \"metric \") {\r\n\t\t\tprintJSON(map[string]interface{}{\"success\": false, \"message\": err.Error()})\r\n\t\t\treturn\r\n\t\t}\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(map[string]interface{}{\r\n\t\t\"success\":        true,\r\n\t\t\"message\":        fmt.Sprintf(\"promoted to %s\", new),\r\n"]
[10343.343493, "o", "\t\t\"previous_stage\": prev,\r\n\t\t\"new_stage\":      entry.Stage,\r\n\t})\r\n}\r\n\r\nfunc cmdRegistryCompare(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tprintError(\"usage: mlpipe registry compare <name>:<version1> <name>:<version2>\")\r\n\t\treturn\r\n\t}\r\n\tname1, v1, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tname2, v2, ok := splitNameVersion(args[1])\r\n\tif !ok {\r\n"]
[10343.34359, "o", "\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tif name1 != name2 {\r\n\t\tprintError(\"cannot compare different model names\")\r\n\t\treturn\r\n\t}\r\n\tresult, err := compareModels(name1, v1, v2)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(result)\r\n}\r\n\r\n"]
[10343.343695, "o", "func cmdLineage(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tprintError(\"usage: mlpipe lineage <artifact_id> <up|down|both>\")\r\n\t\treturn\r\n\t}\r\n\tid := args[0]\r\n"]
[10343.343794, "o", "\tdirection := args[1]\r\n\tresult, err := queryLineage(id, direction)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(result)\r\n}\r\n\r\nfunc parseRunArgs(args []string) (string, map[string]string, int, bool, []string, error) {\r\n\tconfigPath := \"\"\r\n\toverrides := map[string]string{}\r\n\tcv := 0\r\n\tnoCache := false\r\n\tvar skipStages []string\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--cv\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"--cv requires a value\")\r\n\t\t\t}\r\n\t\t\tk, err := strconv.Atoi(args[i+1])\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"invalid cv folds: %s\", args[i+1])\r\n\t\t\t}\r\n\t\t\tif k < 2 {\r\n"]
[10343.343828, "o", "\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"cv folds must be >= 2\")\r\n\t\t\t}\r\n\t\t\tcv = k\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--cv=\"):\r\n"]
[10343.343959, "o", "\t\t\tval := strings.TrimPrefix(args[i], \"--cv=\")\r\n\t\t\tk, err := strconv.Atoi(val)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"invalid cv folds: %s\", val)\r\n\t\t\t}\r\n\t\t\tif k < 2 {\r\n\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"cv folds must be >= 2\")\r\n\t\t\t}\r\n\t\t\tcv = k\r\n\t\tcase args[i] == \"--no-cache\":\r\n\t\t\tnoCache = true\r\n\t\tcase args[i] == \"--param\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"--param requires key=value\")\r\n\t\t\t}\r\n\t\t\tkv := args[i+1]\r\n\t\t\ti++\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n"]
[10343.344054, "o", "\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"--param requires key=value\")\r\n"]
