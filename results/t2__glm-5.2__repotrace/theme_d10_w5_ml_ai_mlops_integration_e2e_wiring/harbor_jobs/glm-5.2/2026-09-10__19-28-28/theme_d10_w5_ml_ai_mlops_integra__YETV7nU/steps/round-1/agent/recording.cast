[10480.599118, "o", "\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[10480.599183, "o", "\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc loadConfig\u001b[m\u001b[K(path string) (*Config, error) {\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdata, err := os.ReadFile(path)\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif os.IsNotExist(err) {\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn nil, fmt.Errorf(\"file not found: %s\", path)\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n"]
[10480.599282, "o", "\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn nil, err\r\n\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar c Config\r\n\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := json.Unmarshal(data, &c); err != nil {\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn nil, fmt.Errorf(\"invalid config: %s\", err.Error())\r\n\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn &c, nil\r\n\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (c *Config) globalParams(overrides map[string]string) map[string]interface{} {\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tparams := map[string]interface{}{}\r\n\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k, v := range c.Pipeline.Params {\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tparams[k] = v\r\n"]
[10480.599359, "o", "\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k, v := range overrides {\r\n\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tparams[k] = v\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn params\r\n\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc mergeParams(params map[string]interface{}, overrides map[string]string) map[string]interface{} {\r\n\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tres := map[string]interface{}{}\r\n\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k, v := range params {\r\n\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tres[k] = v\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[10480.599421, "o", "\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k, v := range overrides {\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tres[k] = v\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn res\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc substituteValue(v interface{}, globals map[string]interface{}) interface{} {\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tswitch x := v.(type) {\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase string:\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn paramRE.ReplaceAllStringFunc(x, func(m string) string {\r\n"]
[10480.599483, "o", "\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tkey := m[2 : len(m)-1]\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif val, ok := globals[key]; ok {\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\treturn fmt.Sprintf(\"%v\", val)\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn m\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t})\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase map[string]interface{}:\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tres := map[string]interface{}{}\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor k, val := range x {\r\n"]
