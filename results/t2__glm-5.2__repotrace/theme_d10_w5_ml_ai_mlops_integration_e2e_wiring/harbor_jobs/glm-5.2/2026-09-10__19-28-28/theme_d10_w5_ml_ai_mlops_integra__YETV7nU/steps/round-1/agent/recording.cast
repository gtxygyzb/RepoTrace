[11413.766679, "o", "func executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tvar ds *Dataset\r\n\tfor _, in := range inputs {\r\n\t\tif in != nil && in.Dataset != nil {\r\n\t\t\tds = in.Dataset\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif ds == nil {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires input data\", stage.Name)\r\n\t}\r\n"]
[11413.766741, "o", "\r\n\talgorithm, ok := getString(params, \"algorithm\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires algorithm\", stage.Name)\r\n\t}\r\n\ttarget, ok := getString(params, \"target\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires target\", stage.Name)\r\n\t"]
