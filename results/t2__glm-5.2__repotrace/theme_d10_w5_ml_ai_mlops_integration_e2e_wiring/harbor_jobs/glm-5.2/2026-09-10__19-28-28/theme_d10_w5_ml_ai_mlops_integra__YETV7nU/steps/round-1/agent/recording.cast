[11263.350723, "o", "func saveRunRecord(record *RunRecord) error {\r\n\u001b[?2004l\r"]
[11263.350787, "o", "\u001b[?2004h> "]
[11263.351077, "o", "    dir := filepath.Join(\".mlpipe\", \"runs\")\r\n\u001b[?2004l\r"]
[11263.351141, "o", "\u001b[?2004h> "]
[11263.351498, "o", "    if err := os.MkdirAll(dir, 0755); err != nil {\r\n\u001b[?2004l\r"]
[11263.351552, "o", "\u001b[?2004h> "]
[11263.351695, "o", "        return err\r\n"]
[11263.351749, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[11263.351807, "o", "    }\r\n\u001b[?2004l\r"]
[11263.351853, "o", "\u001b[?2004h> "]
