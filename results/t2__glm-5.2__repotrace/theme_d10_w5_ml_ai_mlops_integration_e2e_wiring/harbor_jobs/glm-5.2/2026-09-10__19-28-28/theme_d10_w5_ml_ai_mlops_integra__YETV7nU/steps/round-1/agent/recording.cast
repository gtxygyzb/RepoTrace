[8790.240494, "o", "   191\t\ttarget := args[1]\r\n   192\t\tentry, prev, new, err := promoteModel(name, version, target)\r\n   193\t\tif err != nil {\r\n   194\t\t\tif strings.HasPrefix(err.Error(), \"metric \") {\r\n   195\t\t\t\tprintJSON(map[string]interface{}{\"success\": false, \"message\": err.Error()})\r\n   196\t\t\t\treturn\r\n   197\t\t\t}\r\n   198\t\t\tprintError(err.Error())\r\n   199\t\t\treturn\r\n   200\t\t}\r\n   201\t\tprintJSON(map[string]interface{}{\r\n   202\t\t\t\"success\":        true,\r\n   203\t\t\t\"message\":        fmt.Sprintf(\"promoted to %s\", new),\r\n   204\t\t\t\"previous_stage\": prev,\r\n   205\t\t\t\"new_stage\":      entry.Stage,\r\n   206\t\t})\r\n   207\t}\r\n   208\t\r\n   209\tfunc cmdRegistryCompare(args []string) {\r\n   210\t\tif len(args) < 2 {\r\n   211\t\t\tprintError(\"usage: mlpipe registry compare <name>:<version1> <name>:<version2>\")\r\n   212\t\t\treturn\r\n   213\t\t}\r\n   214\t\tname1, v1, ok := splitNameVersion(args[0])\r\n   215\t\tif !ok {\r\n   216\t\t\tprintError(\"invalid name:version format\")\r\n   217\t\t\treturn\r\n"]
