[8852.86091, "o", "    87\tfunc (e *Executor) Run() (*RunOutput, error) {\r\n    88\t\tvalid, errs := e.config.Validate()\r\n    89\t\tif !valid {\r\n    90\t\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n    91\t\t}\r\n    92\t\torder, err := e.config.topologicalOrder()\r\n    93\t\tif err != nil {\r\n    94"]
[8852.860967, "o", "\t\t\treturn nil, err\r\n    95\t\t}\r\n    96\t\r\n    97\t\trunArtifacts := map[string]*ArtifactOutput{}\r\n    98\t\r\n    99\t\tfor _, name := range order {\r\n   100\t\t\tstage, _ := e.config.stageByName(name)\r\n   101\t\t\te.outputs[name] = map[string]string{}\r\n   102\t\t\te.values[name] = map[string]*ArtifactValue{}\r\n"]
[8852.861027, "o", "   103\t\t\te.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n   104\t\r\n   105\t\t\tskip := false\r\n   106\t\t\tfor _, dep := range stage.DependsOn {\r\n   107\t\t\t\tif e.status[dep] != \"success\" {\r\n   108\t\t\t\t\tskip = true\r\n   109\t\t\t\t\tbreak\r\n   110\t\t\t\t}\r\n   111"]
[8852.861085, "o", "\t\t\t}\r\n   112\t\t\tif skip {\r\n   113\t\t\t\te.status[name] = \"skipped\"\r\n   114\t\t\t\te.results[name].Status = \"skipped\"\r\n   115\t\t\t\tcontinue\r\n   116\t\t\t}\r\n   117\t\r\n   118\t\t\tinputValues, inputIDs, err := e.resolveInputs(stage)\r\n   119\t\t\t"]
[8852.861141, "o", "if err != nil {\r\n   120\t\t\t\te.status[name] = \"failed\"\r\n   121\t\t\t\te.results[name].Status = \"failed\"\r\n   122\t\t\t\te.results[name].Error = err.Error()\r\n   123\t\t\t\tcontinue\r\n   124\t\t\t}\r\n   125\t\r\n"]
