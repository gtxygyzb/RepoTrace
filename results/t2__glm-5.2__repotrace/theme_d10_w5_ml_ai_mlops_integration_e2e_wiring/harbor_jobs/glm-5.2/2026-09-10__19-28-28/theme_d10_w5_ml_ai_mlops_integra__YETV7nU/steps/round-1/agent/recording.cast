[10912.358196, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[10912.358272, "o", "\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintError(\"usage: mlpipe <command> [args]\")\r\n\t\treturn\r\n\t}\r\n"]
[10912.358374, "o", "\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"plan\":\r\n\t\tcmdPlan(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"registry\":\r\n\t\tcmdRegistry(args)\r\n\tcase \"lineage\":\r\n\t\tcmdLineage(args)\r\n\t"]
[10912.358445, "o", "default:\r\n\t\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n\t}\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n\tconfigPath, overrides, cv, noCache, skipStages, err := parseRunArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n"]
[10912.358514, "o", "\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tfor _, name := range skipStages {\r\n\t\tif _, ok := config.stageByName(name); !ok {\r\n\t\t\tprintError(fmt.Sprintf(\"unknown stage: %s\", name))\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n\texecutor := NewExecutor(config, overrides)\r\n\texecutor.noCache = noCache"]
[10912.358575, "o", "\r\n\texecutor.skipStages = skipStages\r\n\tif noCache {\r\n\t\texecutor.cacheStats = nil\r\n\t}\r\n\texecutor.cvFolds = cv\r\n\tvar run interface{}\r\n\tif cv > 0 {\r\n\t\trun, err = executor.RunCV()\r\n"]
[10912.358638, "o", "\t} else {\r\n\t\trun, err = executor.Run()\r\n\t}\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(run)\r\n}\r\n\r\nfunc cmdPlan(args []string) {\r\n\tconfigPath, overrides, cv, err := parsePlanArgs(args)\r\n\tif err != nil {\r\n\t\t"]
[10912.358695, "o", "printError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tplan, err := buildPlan(config, overrides, cv)\r\n"]
[10912.358759, "o", "\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(plan)\r\n}\r\n\r\nfunc cmdValidate(args []string) {\r\n\tconfigPath := \"\"\r\n\toverrides := map[string]string{}\r\n\tfail := func(msg string) {\r\n\t\t"]
[10912.358829, "o", "printJSON(map[string]interface{}{\"valid\": false, \"errors\": []string{msg}})\r\n\t}\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--param\":\r\n\t\t\tif i+1 >= len(args) {\r\n"]
[10912.358897, "o", "\t\t\t\tfail(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tkv := args[i+1]\r\n\t\t\ti++\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\tfail(\"--param requires key=value\")\r\n\t\t\t\t"]
[10912.358954, "o", "return\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tcase strings.HasPrefix(args[i], \"--param=\"):\r\n\t\t\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\tfail(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tdefault:\r\n\t\t\tif configPath == \"\" && !strings.HasPrefix(args[i], \"--\") {\r\n\t"]
[10912.359023, "o", "\t\t\tconfigPath = args[i]\r\n\t\t\t} else {\r\n\t\t\t\tfail(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif configPath == \"\" {\r\n\t\tfail(\"usage: mlpipe validate <config.json> [--param key=value ...]\")\r\n\t\treturn\r\n"]
[10912.35908, "o", "\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tfail(err.Error())\r\n\t\treturn\r\n\t}\r\n\tif len(overrides) > 0 {\r\n\t\tglobals := config.globalParams(overrides)\r\n\t\tconfig.Pipeline.Params = globals\r\n"]
[10912.359138, "o", "\t\tfor i := range config.Stages {\r\n\t\t\tconfig.Stages[i].Params = config.stageParams(config.Stages[i].Name, globals)\r\n\t\t}\r\n\t}\r\n\tvalid, errors := config.Validate()\r\n\tprintJSON(map[string]interface{}{\"valid\": valid, \"errors\": errors})\r\n}\r\n\r\nfunc cmdRegistry(args []string) {\r\n\tif len(args) < 1 {\r\n\t\t"]
[10912.359199, "o", "printError(\"usage: mlpipe registry <list|info|promote|compare> [args]\")\r\n\t\treturn\r\n\t}\r\n\tsub := args[0]\r\n\trest := args[1:]\r\n\tswitch sub {\r\n\tcase \"list\":\r\n\t\tcmdRegistryList(rest)\r\n\tcase \"info\":\r\n"]
