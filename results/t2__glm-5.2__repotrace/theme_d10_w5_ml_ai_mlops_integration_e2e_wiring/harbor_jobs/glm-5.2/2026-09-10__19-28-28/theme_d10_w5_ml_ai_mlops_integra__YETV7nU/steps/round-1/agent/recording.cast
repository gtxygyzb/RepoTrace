[8909.138185, "o", "     6\t\t\"math/rand\"\r\n     7\t\t\"sort\"\r\n     8\t)\r\n     9\t\r\n    10\ttype Model struct {\r\n    11\t\tAlgorithm       string\r\n    12\t\tTarget          string\r\n    13\t\tFeatures        []string\r\n    14\t\tHyperparams     map[string]interface{}\r\n    15\t\tClassification  bool\r\n    16\t\tLinearWeights   []float64\r\n    17\t\tLogisticWeights []float64\r\n    18\t\tTree            *TreeNode\r\n"]
[8909.138308, "o", "    19\t\tForest          []*TreeNode\r\n    20\t\tBoost           []*BoostedTree\r\n    21\t\tKNN             *KNNModel\r\n    22\t\tTrainFeatures   [][]float64\r\n    23\t\tTrainTarget     []float64\r\n    24\t}\r\n    25\t\r\n    26\ttype TreeNode struct {\r\n    27\t\tIsLeaf      bool\r\n    28\t\tPrediction  float64\r\n    29\t\tProbability float64\r\n    30\t\tFeature     int\r\n    31\t\tThreshold   float64\r\n    32\t\tLeft        *TreeNode\r\n    33\t\tRight       *TreeNode\r\n"]
[8909.138382, "o", "    34\t}\r\n    35\t\r\n    36\ttype BoostedTree struct {\r\n    37\t\tTree           *TreeNode\r\n    38\t\tLearningRate   float64\r\n    39\t\tInitPrediction float64\r\n    40\t}\r\n    41\t\r\n    42\ttype KNNModel struct {\r\n    43\t\tK              int\r\n"]
[8909.138451, "o", "    44\t\tFeatures       [][]float64\r\n    45\t\tTargets        []float64\r\n    46\t\tClassification bool\r\n    47\t}\r\n    48\t\r\n    49\tfunc executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n    50\t\tvar ds *Dataset\r\n    51\t\tfor _, in := range inputs {\r\n    52\t\t\tif in != nil && in.Dataset != nil {\r\n    53"]
[8909.13852, "o", "\t\t\t\tds = in.Dataset\r\n    54\t\t\t\tbreak\r\n    55\t\t\t}\r\n    56\t\t}\r\n    57\t\tif ds == nil {\r\n    58\t\t\treturn nil, fmt.Errorf(\"train stage %q requires input data\", stage.Name)\r\n    59\t\t}\r\n    60\t\r\n    61\t\talgorithm, ok := getString(params, \"algorithm\")"]
[8909.13859, "o", "\r\n    62\t\tif !ok {\r\n    63\t\t\treturn nil, fmt.Errorf(\"train stage %q requires algorithm\", stage.Name)\r\n    64\t\t}\r\n    65\t\ttarget, ok := getString(params, \"target\")\r\n    66\t\tif !ok {\r\n    67\t\t\treturn nil, fmt.Errorf(\"train stage %q requires target\", stage.Name)\r\n    68\t\t}\r\n    69\t\ttargetVals, err := ds.NumericColumn(target)\r\n    70\t\tif err != nil {\r\n"]
[8909.138658, "o", "    71\t\t\treturn nil, err\r\n    72\t\t}\r\n    73\t\tclassification := isBinary01(targetVals)\r\n    74\t\tif algorithm == \"linear-regression\" {\r\n    75\t\t\tclassification = false\r\n    76\t\t}\r\n    77\t\tif algorithm == \"logistic-regression\" {\r\n    78\t\t\tclassification = true\r\n    79\t\t}\r\n"]
[8909.138725, "o", "    80\t\r\n    81\t\tfeatures, ok := getStringSlice(params, \"features\")\r\n    82\t\tif !ok || len(features) == 0 {\r\n    83\t\t\tfeatures = []string{}\r\n    84\t\t\tfor i, col := range ds.Columns {\r\n    85\t\t\t\tif col == target {\r\n    86\t\t\t\t\tcontinue\r\n    87\t\t\t\t}\r\n    88\t\t\t\tif i < len(ds.Types) && ds.Types[i] == \"numeric\" {\r\n    89\t\t\t\t"]
[8909.13879, "o", "\tfeatures = append(features, col)\r\n    90\t\t\t\t}\r\n    91\t\t\t}\r\n    92\t\t}\r\n    93\t\tX, err := ds.featureMatrix(features)\r\n    94\t\tif err != nil {\r\n    95\t\t\treturn nil, err\r\n    96\t\t}\r\n"]
[8909.138858, "o", "    97\t\ty := targetVals\r\n    98\t\r\n    99\t\thp := getMapDefault(params, \"hyperparams\", map[string]interface{}{})\r\n   100\t\tmodel := &Model{Algorithm: algorithm, Target: target, Features: features, Hyperparams: hp, Classification: classification, TrainFeatures: X, TrainTarget: y}\r\n   101\t\r\n   102\t\tswitch algorithm {\r\n   103\t\tcase \"linear-regression\":\r\n   104\t\t\tw, err := trainLinearRegression(X, y)\r\n"]
[8909.13893, "o", "   105\t\t\tif err != nil {\r\n   106\t\t\t\treturn nil, err\r\n   107\t\t\t}\r\n   108\t\t\tmodel.LinearWeights = w\r\n   109\t\tcase \"logistic-regression\":\r\n   110\t\t\tlr := getFloatDefault(hp, \"learning_rate\", 0.01)\r\n   111\t\t\tepochs := getIntDefault(hp, \"epochs\", 1000)\r\n   112\t\t\tw, err := trainLogisticRegression(X, y, lr, epochs)\r\n   113\t\t\tif err != nil {\r\n   114\t\t\t\treturn nil, err\r\n"]
[8909.138998, "o", "   115\t\t\t}\r\n   116\t\t\tmodel.LogisticWeights = w\r\n   117\t\tcase \"decision-tree\":\r\n   118\t\t\tmaxDepth := getIntDefault(hp, \"max_depth\", 10)\r\n   119\t\t\tminSplit := getIntDefault(hp, \"min_samples_split\", 2)\r\n   120\t\t\tmodel.Tree = trainDecisionTree(X, y, features, classification, 0, maxDepth, minSplit)\r\n   121\t\tcase \"random-forest\":\r\n   122\t\t\tnEst := getIntDefault(hp, \"n_estimators\", 10)\r\n   123\t\t\tmaxDepth := getIntDefault(hp, \"max_depth\", 10)\r\n   124\t\t\tmaxFeatures := getStringDefault(hp, \"max_features\", \"sqrt\")\r\n"]
[8909.139065, "o", "   125\t\t\tmodel.Forest = trainRandomForest(X, y, features, classification, nEst, maxDepth, maxFeatures, stage.Name)\r\n   126\t\tcase \"gradient-boost\":\r\n   127\t\t\tnEst := getIntDefault(hp, \"n_estimators\", 100)\r\n   128\t\t\tlr := getFloatDefault(hp, \"learning_rate\", 0.1)\r\n   129\t\t\tmaxDepth := getIntDefault(hp, \"max_depth\", 3)\r\n   130\t\t\tmodel.Boost = trainGradientBoost(X, y, classification, nEst, lr, maxDepth)\r\n   131\t\tcase \"knn\":\r\n   132\t\t\tk := getIntDefault(hp, \"k\", 5)\r\n"]
[8909.139133, "o", "   133\t\t\tif k <= 0 {\r\n   134\t\t\t\tk = 1\r\n   135\t\t\t}\r\n   136\t\t\tmodel.KNN = &KNNModel{K: k, Features: X, Targets: y, Classification: classification}\r\n   137\t\tdefault:\r\n   138\t\t\treturn nil, fmt.Errorf(\"unsupported algorithm: %s\", algorithm)\r\n   139\t\t}\r\n   140\t\r\n   141\t\tpreds := model.PredictBatch(X)\r\n"]
[8909.139201, "o", "   142\t\tpredRows := make([][]string, len(ds.Rows))\r\n   143\t\tfor i := range ds.Rows {\r\n   144\t\t\trow := append([]string{}, ds.Rows[i]...)\r\n   145\t\t\trow = append(row, formatFloat(preds[i]))\r\n   146\t\t\tpredRows[i] = row\r\n   147\t\t}\r\n   148\t\tpredDS := &Dataset{\r\n   149\t\t\tColumns: append(append([]string{}, ds.Columns...), \"prediction\"),\r\n   150\t\t\tTypes:   append(append([]string{}, ds.Types...), \"numeric\"),\r\n   151\t\t\tRows:    predRows,\r\n   152\t\t}\r\n"]
[8909.139276, "o", "   153\t\r\n   154\t\treturn map[string]*ArtifactValue{\"model\": {Model: model}, \"predictions\": {Dataset: predDS}}, nil\r\n   155\t}\r\n   156\t\r\n"]
[8909.139351, "o", "   157\tfunc isBinary01(vals []float64) bool {\r\n   158\t\tfor _, v := range vals {\r\n   159\t\t\tif v != 0 && v != 1 {\r\n   160\t\t\t\treturn false\r\n   161\t\t\t}\r\n   162\t\t}\r\n   163\t\treturn true\r\n   164\t}\r\n   165\t\r\n   166\tfunc getMapDefault(params map[string]interface{}, key string, def map[string]interface{}) map[string]interface{} {\r\n   167\t\tif v, ok := getMap(params, key); ok {\r\n   168\t\t\treturn v\r\n   169\t\t}\r\n   170\t\treturn def\r\n"]
