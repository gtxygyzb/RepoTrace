[11379.275671, "o", "\t\treturn []string{\"report\"}\r\n\tcase \"register\":\r\n\t\treturn []string{\"entry\"}\r\n\tcase \"ensemble\":\r\n\t\treturn []string{\"predictions\", \"model\"}\r\n\t}\r\n"]
[11379.275753, "o", "\treturn nil\r\n}\r\n\r\nfunc validStageType(t string) bool {\r\n\tswitch t {\r\n\tcase \"data-source\", \"transform\", \"split\", \"train\", \"evaluate\", \"register\", \"ensemble\":\r\n\t\treturn true\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc (c *Config) Validate() (bool, []string) {\r\n\terrors := []string{}\r\n\t"]
[11379.275828, "o", "names := map[string]bool{}\r\n\tfor i, s := range c.Stages {\r\n\t\tif s.Name == \"\" {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"stage at index %d has empty name\", i))\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif names[s.Name] {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"duplicate stage name: %s\", s.Name))\r\n\t\t}\r\n\t\tnames[s.Name] = true\r\n\t}\r\n\tfor _, s := range c.Stages {\r\n"]
[11379.275899, "o", "\t\tif !validStageType(s.Type) {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q has unknown type %q\", s.Name, s.Type))\r\n\t\t}\r\n\t\tfor _, dep := range s.DependsOn {\r\n\t\t\tif !names[dep] {\r\n"]
[11379.275968, "o", "\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q references unknown dependency %q\", s.Name, dep))\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor local, ref := range s.Inputs {\r\n\t\t\trefs, ok := inputRefs(ref)\r\n\t\t\tif !ok {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %v\", s.Name, local, ref))\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tfor idx, r := range refs {\r\n\t\t\t\tif r == \"\" {\r\n\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q[%d] has invalid empty reference\", s.Name, local, idx))\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n"]
[11379.276009, "o", "\t\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n\t\t\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %q\", s.Name, local, r))\r\n\t\t\t\t\tcontinue\r\n"]
[11379.276099, "o", "\t\t\t\t}\r\n\t\t\t\trefStage, ok := c.stageByName(parts[0])\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown stage %q\", s.Name, local, parts[0]))\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tports := validOutputPorts(refStage.Type)\r\n\t\t\t\tvalid := false\r\n\t\t\t\tfor _, p := range ports {\r\n\t\t\t\t\tif p == parts[1] {\r\n\t\t\t\t\t\tvalid = true\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t}\r\n"]
[11379.276168, "o", "\t\t\t\t}\r\n\t\t\t\tif !valid {\r\n\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown output port %q on stage %q\", s.Name, local, parts[1], parts[0]))\r\n\t\t\t\t}\r\n\t"]
[11379.276244, "o", "\t\t}\r\n\t\t\tif s.Type == \"ensemble\" && local == \"models\" {\r\n\t\t\t\tif _, ok := ref.([]interface{}); !ok {\r\n\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q input %q must be an array\", s.Name, local))\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif s.Type == \"ensemble\" {\r\n\t\t\tmodels, ok := s.Inputs[\"models\"]\r\n\t\t\tif !ok {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires inputs.models\", s.Name))\r\n\t\t\t} else if refs, ok := inputRefs(models); !ok || len(refs) < 2 {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires at least 2 model inputs\", s.Name))\r\n\t\t\t}\r\n"]
[11379.27631, "o", "\t\t\tif _, ok := s.Inputs[\"data\"]; !ok {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires inputs.data\", s.Name))\r\n\t\t\t}\r\n\t\t\tstrategy, _ := getString(s.Params, \"strategy\")\r\n\t\t\tif strategy != \"vote\" && strategy != \"average\" {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q has invalid strategy %q (must be vote or average)\", s.Name, strategy))\r\n\t\t\t}\r\n\t\t\tif _, ok := getString(s.Params, \"target\"); !ok {\r\n"]
[11379.276374, "o", "\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires target param\", s.Name))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif stages, cycle := c.detectCycle(); cycle {\r\n\t\terrors = append(errors, fmt.Sprintf(\"cycle detected involving stages: %s\", strings.Join(stages, \", \")))\r\n\t}\r\n\treturn len(errors) == 0, errors\r\n}\r\n\r\n"]
[11379.276435, "o", "func (c *Config) detectCycle() ([]string, bool) {\r\n\tadj := map[string][]string{}\r\n\tfor _, s := range c.Stages {\r\n\t\tadj[s.Name] = append(adj[s.Name], s.DependsOn...)\r\n\t}\r\n\tcolor := map[string]int{}\r\n\tvar stack []string\r\n\tvar cycle []string\r\n"]
