[13009.584491, "o", "    34\t\t}\r\n    35\t\tX, err := ds.featureMatrix(model.Features)\r\n    36\t\tif err != nil {\r\n    37\t\t\treturn nil, err\r\n    38\t\t}\r\n    39\t\tpreds := model.PredictBatch(X)\r\n    40\t\tclassification := isBinary01(y)\r\n    41\t\r\n    42\t\treport := &Report{Metrics: map[string]interface{}{}, Pass: true}\r\n    43\t"]
[13009.584554, "o", "\r\n    44\t\tfor _, metric := range metrics {\r\n    45\t\t\tvar val interface{}\r\n    46\t\t\tvar err error\r\n    47\t\t\tswitch metric {\r\n    48\t\t\tcase \"accuracy\", \"precision\", \"recall\", \"f1\", \"auc\", \"logloss\", \"confusion_matrix\":\r\n    49\t\t\t\tif !classification {\r\n"]
[13009.584613, "o", "    50\t\t\t\t\terr = fmt.Errorf(\"metric %q requires binary 0/1 target\", metric)\r\n    51\t\t\t\t} else {\r\n    52\t\t\t\t\tval, err = classificationMetric(metric, y, preds)\r\n    53\t\t\t\t}\r\n    54\t\t\tcase \"mse\", \"rmse\", \"mae\", \"r2\", \"mape\":\r\n    55\t\t\t\tif classification {\r\n"]
[13009.584672, "o", "    56\t\t\t\t\terr = fmt.Errorf(\"metric %q requires regression target\", metric)\r\n    57\t\t\t\t} else {\r\n    58\t\t\t\t\tval, err = regressionMetric(metric, y, preds)\r\n    59\t\t\t\t}\r\n    60\t\t\tdefault:\r\n    61\t\t\t\terr = fmt.Errorf(\"unknown metric %q\", metric)\r\n    62\t\t\t}\r\n    63\t\t\tif err != nil {\r\n"]
[13009.584737, "o", "    64\t\t\t\treturn nil, err\r\n    65\t\t\t}\r\n    66\t\t\treport.Metrics[metric] = val\r\n    67\t\t}\r\n    68\t\r\n    69\t\tif threshold != nil {\r\n    70\t\t\tfor metricName, thresholdVal := range threshold {\r\n    71\t\t\t\tmetricValue, ok := report.Metrics[metricName]\r\n"]
[13009.584794, "o", "    72\t\t\t\tif !ok {\r\n    73\t\t\t\t\tcontinue\r\n    74\t\t\t\t}\r\n    75\t\t\t\tfv, ok := toFloat64(metricValue)\r\n    76\t\t\t\tif !ok {\r\n    77\t\t"]
[13009.584852, "o", "\t\t\tcontinue\r\n    78\t\t\t\t}\r\n    79\t\t\t\ttv, ok := toFloat64(thresholdVal)\r\n    80\t\t\t\tif !ok {\r\n    81\t\t\t\t\tcontinue\r\n    82\t\t\t\t}\r\n    83\t\t\t\tif fv < tv {\r\n"]
[13009.584926, "o", "    84\t\t\t\t\treport.Pass = false\r\n    85\t\t\t\t}\r\n    86\t\t\t}\r\n    87\t\t}\r\n    88\t\r\n    89\t\treturn map[string]*ArtifactValue{\"report\": {Report: report}}, nil\r\n    90\t}\r\n"]
