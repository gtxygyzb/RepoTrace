[8942.610179, "o", "    49\tfunc executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n    50\t\tvar ds *Dataset\r\n    51\t\tfor _, in := range inputs {\r\n    52\t\t\tif in != nil && in.Dataset != nil {\r\n    53\t\t\t\tds = in.Dataset\r\n    54\t\t\t\tbreak\r\n    55\t\t\t}\r\n    56\t\t"]
[8942.610261, "o", "}\r\n    57\t\tif ds == nil {\r\n    58\t\t\treturn nil, fmt.Errorf(\"train stage %q requires input data\", stage.Name)\r\n    59\t\t}\r\n    60\t\r\n"]
