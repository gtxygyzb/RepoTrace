[12838.38631, "o", "\r\n    32\t}\r\n    33\t\r\n    34\tfunc cmdDiff(args []string) {\r\n    35\t\tvar paths []string\r\n    36\t\toverrides := map[string]string{}\r\n    37\t\tfor i := 0; i < len(args); i++ {\r\n    38\t\t\tswitch {\r\n    39\t\t\tcase args[i] == \"--param\":\r\n"]
[12838.386365, "o", "    40\t\t\t\tif i+1 >= len(args) {\r\n    41\t\t\t\t\texitError(\"--param requires key=value\")\r\n"]
[12838.386416, "o", "    42\t\t\t\t\treturn\r\n    43\t\t\t\t}\r\n    44\t\t\t\tkv := args[i+1]\r\n    45\t\t\t\ti++\r\n    46\t\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n    47\t\t\t\tif !ok {\r\n    48\t\t\t\t\texitError(\"--param requires key=value\")\r\n    49\t\t\t\t\treturn\r\n    50\t\t\t\t}\r\n    51\t\t\t\toverrides[k] = v\r\n    52"]
[12838.386467, "o", "\t\t\tcase strings.HasPrefix(args[i], \"--param=\"):\r\n    53\t\t\t\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n    54\t\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n    55\t\t\t\tif !ok {\r\n    56\t\t\t\t\texitError(\"--param requires key=value\")\r\n    57\t\t\t\t\treturn\r\n"]
