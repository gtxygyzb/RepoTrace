[2870.328087, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[2870.328169, "o", "\t\"os\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintError(\"usage: mlpipe <command> [args]\")\r\n\t\treturn\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n"]
[2870.328257, "o", "\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"registry\":\r\n\t\tcmdRegistry(args)\r\n\tcase \"lineage\":\r\n\t\tcmdLineage(args)\r\n\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n\t}\r\n}\r\n\r\n"]
[2870.32833, "o", "func cmdRun(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe run <config.json> [--param key=value ...]\")\r\n\t\treturn\r\n\t}\r\n\tconfigPath := args[0]\r\n\toverrides, err := parseParams(args[1:])\r\n\tif err != nil {\r\n\t"]
[2870.328397, "o", "\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n"]
[2870.328463, "o", "\t\treturn\r\n\t}\r\n\texecutor := NewExecutor(config, overrides)\r\n"]
[2870.328518, "o", "\trun, err := executor.Run()\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(run)\r\n}\r\n\r\nfunc cmdValidate(args []string) {\r\n\tif len(args) < 1 {\r\n\t\t"]
[2870.328593, "o", "printError(\"usage: mlpipe validate <config.json>\")\r\n\t\treturn\r\n"]
[2870.328661, "o", "\t}\r\n\tconfig, err := loadConfig(args[0])\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tvalid, errors := config.Validate()\r\n\tprintJSON(map[string]interface{}{\"valid\": valid, \"errors\": errors})\r\n}\r\n\r\nfunc cmdRegistry(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe registry <list|info|promote|compare> [args]\")\r\n\t\treturn\r\n"]
[2870.328739, "o", "\t}\r\n\tsub := args[0]\r\n\trest := args[1:]\r\n\tswitch sub {\r\n\tcase \"list\":\r\n\t\tcmdRegistryList(rest)\r\n\tcase \"info\":\r\n\t\tcmdRegistryInfo(rest)\r\n\tcase \"promote\":\r\n\t\tcmdRegistryPromote(rest)\r\n\tcase \"compare\":\r\n"]
[2870.328811, "o", "\t\tcmdRegistryCompare(rest)\r\n\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown registry command: %s\", sub))\r\n\t}\r\n}\r\n\r\nfunc cmdRegistryList(args []string) {\r\n\tname, stage, tag := \"\", \"\", \"\"\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--name\" && i+1 < len(args):\r\n"]
[2870.32888, "o", "\t\t\tname = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--name=\"):\r\n\t\t\tname = strings.TrimPrefix(args[i], \"--name=\")\r\n\t\tcase args[i] == \"--stage\" && i+1 < len(args):\r\n\t\t\tstage = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--stage=\"):\r\n\t\t\tstage = strings.TrimPrefix(args[i], \"--stage=\")\r\n\t\tcase args[i] == \"--tag\" && i+1 < len(args):\r\n\t\t\ttag = args[i+1]\r\n"]
[2870.328948, "o", "\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--tag=\"):\r\n\t\t\ttag = strings.TrimPrefix(args[i], \"--tag=\")\r\n\t\tdefault:\r\n\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n"]
[2870.329015, "o", "\t\t\treturn\r\n\t\t}\r\n\t}\r\n\tentries, err := listRegistry(name, stage, tag)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tout := make([]map[string]interface{}, len(entries))\r\n\tfor i, e := range entries {\r\n\t\tout[i] = map[string]interface{}{\r\n\t\t\t\"name\":          e.Name,\r\n"]
[2870.329078, "o", "\t\t\t\"version\":       e.Version,\r\n\t\t\t\"stage\":         e.Stage,\r\n\t\t\t\"tags\":          e.Tags,\r\n\t\t\t\"metrics\":       e.Metrics,\r\n\t\t\t\"registered_at\": e.RegisteredAt,\r\n\t\t}\r\n\t}\r\n\tprintJSON(out)\r\n}\r\n\r\nfunc cmdRegistryInfo(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe registry info <name>:<version>\")\r\n\t\treturn\r\n"]
[2870.329157, "o", "\t}\r\n\tname, version, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tentry, err := registryInfo(name, version)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(entry)\r\n}\r\n\r\nfunc cmdRegistryPromote(args []string) {\r\n\tif len(args) < 2 {\r\n"]
[2870.329244, "o", "\t\tprintError(\"usage: mlpipe registry promote <name>:<version> <target_stage>\")\r\n\t\treturn\r\n\t}\r\n\tname, version, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\ttarget := args[1]\r\n\tentry, prev, new, err := promoteModel(name, version, target)\r\n"]
[2870.329333, "o", "\tif err != nil {\r\n\t\tif strings.HasPrefix(err.Error(), \"metric \") {\r\n\t\t\tprintJSON(map[string]interface{}{\"success\": false, \"message\": err.Error()})\r\n\t\t\treturn\r\n\t\t}\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(map[string]interface{}{\r\n\t\t\"success\":        true,\r\n"]
[2870.329391, "o", "\t\t\"message\":        fmt.Sprintf(\"promoted to %s\", new),\r\n\t\t\"previous_stage\": prev,\r\n\t\t\"new_stage\":      entry.Stage,\r\n\t})\r\n}\r\n\r\nfunc cmdRegistryCompare(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tprintError(\"usage: mlpipe registry compare <name>:<v1> <name>:<v2>\")\r\n\t\treturn\r\n"]
[2870.329454, "o", "\t}\r\n\tname1, v1, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n"]
[2870.32951, "o", "\t\treturn\r\n\t}\r\n\tname2, v2, ok := splitNameVersion(args[1])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tif name1 != name2 {\r\n\t\tprintError(\"model names must match\")\r\n\t\treturn\r\n\t}\r\n\tresult, err := compareModels(name1, v1, v2)\r\n\t"]
[2870.329541, "o", "if err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(result)\r\n"]
[2870.329623, "o", "}\r\n\r\nfunc cmdLineage(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe lineage <artifact_id> [--direction up|down|both]\")\r\n\t\treturn\r\n\t}\r\n"]
[2870.329692, "o", "\tid := args[0]\r\n\tdirection := \"both\"\r\n\tfor i := 1; i < len(args); i++ {\r\n\t\tif args[i] == \"--direction\" && i+1 < len(args) {\r\n"]
[2870.329756, "o", "\t\t\tdirection = args[i+1]\r\n\t\t\ti++\r\n\t\t} else if strings.HasPrefix(args[i], \"--direction=\") {\r\n\t\t\tdirection = strings.TrimPrefix(args[i], \"--direction=\")\r\n\t\t} else {\r\n\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n\tresult, err := queryLineage(id, direction)\r\n\tif err != nil {\r\n"]
[2870.329822, "o", "\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(result)\r\n}\r\n\r\nfunc parseParams(args []string) (map[string]string, error) {\r\n\toverrides := map[string]string{}\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tif args[i] == \"--param\" {\r\n"]
[2870.32988, "o", "\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn nil, fmt.Errorf(\"--param requires key=value\")\r\n\t\t\t}\r\n\t\t\tkv := args[i+1]\r\n"]
[2870.329933, "o", "\t\t\ti++\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\treturn nil, fmt.Errorf(\"--param requires key=value\")\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\t} else if strings.HasPrefix(args[i], \"--param=\") {\r\n\t\t\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n"]
[2870.329998, "o", "\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\treturn nil, fmt.Errorf(\"--param requires key=value\")\r\n\t\t\t}\r\n\t\t\t"]
[2870.33006, "o", "overrides[k] = v\r\n\t\t} else {\r\n\t\t\treturn nil, fmt.Errorf(\"unknown flag: %s\", args[i])\r\n\t\t}\r\n\t}\r\n\treturn overrides, nil\r\n"]
