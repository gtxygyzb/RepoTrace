[11973.366579, "o", "   121\tfunc cmdHistory(args []string) {\r\n   122\t\tvar pipelineFilter string\r\n   123\t\tvar statusFilter string\r\n   124\t\tlimit := -1\r\n   125\t\r\n   126\t\tfor i := 0; i < len(args); i++ {\r\n   127"]
[11973.366697, "o", "\t\t\targ := args[i]\r\n   128\t\t\tswitch {\r\n   129\t\t\tcase arg == \"--pipeline\":\r\n   130\t\t\t\tif i+1 >= len(args) {\r\n"]
[11973.366771, "o", "   131\t\t\t\t\tprintError(\"--pipeline requires a value\")\r\n   132\t\t\t\t\treturn\r\n   133\t\t\t\t}\r\n   134\t\t\t\tpipelineFilter = args[i+1]\r\n   135\t\t\t\ti++\r\n   136\t\t\tcase strings.HasPrefix(arg, \"--pipeline=\"):\r\n   137\t\t\t\tpipelineFilter = strings.TrimPrefix(arg, \"--pipeline=\")\r\n   138\t\t\tcase arg == \"--status\":\r\n   139\t\t\t\tif i+1 >= len(args) {\r\n   140\t\t\t\t\tprintError(\"--status requires a value\")\r\n   141\t\t\t\t\treturn\r\n   142\t\t\t\t}\r\n   143\t\t\t\tstatusFilter = args[i+1]\r\n   144\t\t\t\ti++\r\n   145\t\t\tcase strings.HasPrefix(arg, \"--status=\"):\r\n   146\t\t\t\tstatusFilter = strings.TrimPrefix(arg, \"--status=\")\r\n   147\t\t\tcase arg == \"--limit\":\r\n   148\t\t\t\tif i+1 >= len(args) {\r\n   149\t\t\t\t\tprintError(\"--limit requires a value\")\r\n"]
[11973.366848, "o", "   150\t\t\t\t\treturn\r\n   151\t\t\t\t}\r\n   152\t\t\t\tn, err := strconv.Atoi(args[i+1])\r\n   153\t\t\t\tif err != nil {\r\n   154\t\t\t\t\tprintError(\"--limit requires an integer\")\r\n   155\t\t\t\t\treturn\r\n   156\t\t\t\t}\r\n   157\t\t\t\tlimit = n\r\n   158\t\t\t\ti++\r\n"]
[11973.36691, "o", "   159\t\t\tcase strings.HasPrefix(arg, \"--limit=\"):\r\n   160\t\t\t\tn, err := strconv.Atoi(strings.TrimPrefix(arg, \"--limit=\"))\r\n   161\t\t\t\tif err != nil {\r\n   162\t\t\t\t\tprintError(\"--limit requires an integer\")\r\n   163\t\t\t\t\treturn\r\n   164\t\t\t\t}\r\n   165\t\t\t\tlimit = n\r\n   166\t\t\tdefault:\r\n"]
[11973.366969, "o", "   167\t\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", arg))\r\n   168\t\t\t\treturn\r\n   169\t\t\t}\r\n   170\t\t}\r\n   171\t\r\n   172\t\tif statusFilter != \"\" && statusFilter != \"success\" && statusFilter != \"failed\" {\r\n   173\t\t\tprintError(\"--status must be success or failed\")\r\n   174\t\t\treturn\r\n"]
