[2974.703601, "o", "\tdata, err := os.ReadFile(artifactsPath())\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn map[string]*ArtifactMeta{}, nil\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\tvar m map[string]*ArtifactMeta\r\n\tif err := json.Unmarshal(data, &m); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif m == nil {\r\n"]
[2974.703672, "o", "\t\tm = map[string]*ArtifactMeta{}\r\n\t}\r\n\treturn m, nil\r\n}\r\n\r\nfunc saveArtifacts(newMeta map[string]*ArtifactMeta) error {\r\n\texisting, err := loadArtifacts()\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tfor k, v := range newMeta {\r\n\t\texisting[k] = v\r\n\t}\r\n\t"]
[2974.703731, "o", "if err := os.MkdirAll(\".mlpipe\", 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdata, err := json.MarshalIndent(existing, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(artifactsPath(), data, 0644)\r\n}\r\n\r\nfunc saveRun(run *RunOutput) error {\r\n\tdir := filepath.Join(\".mlpipe\", \"runs\")\r\n"]
[2974.703803, "o", "\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tname := safeFileName(run.Pipeline)\r\n\tif name == \"\" {\r\n\t\tname = \"pipeline\"\r\n"]
[2974.703865, "o", "\t}\r\n\tpath := filepath.Join(dir, fmt.Sprintf(\"%s-%d.json\", name, time.Now().UnixNano()))\r\n\tdata, err := json.MarshalIndent(run, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(path, data, 0644)\r\n}\r\n\r\nfunc safeFileName(s string) string {\r\n\tif s == \"\" {\r\n\t\treturn \"pipeline\"\r\n\t}\r\n\treturn strings.Map(func(r rune) rune {\r\n\t\t"]
[2974.703929, "o", "if r == '/' || r == '\\\\' || r == ':' || r == ' ' {\r\n\t\t\treturn '_'\r\n\t\t}\r\n\t\treturn r\r\n\t}, s)\r\n}\r\n\r\nfunc queryLineage(id string, direction string) (map[string]interface{}, error) {\r\n\tartifacts, err := loadArtifacts()\r\n"]
