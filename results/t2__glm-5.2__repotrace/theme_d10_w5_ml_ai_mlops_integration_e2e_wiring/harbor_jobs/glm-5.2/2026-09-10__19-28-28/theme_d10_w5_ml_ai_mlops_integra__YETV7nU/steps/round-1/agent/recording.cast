[1943.163075, "o", "\u001b[?2004h> "]
[1943.16324, "o", "            for i := 0; i < len(X); i++ {\r\n\u001b[?2004l\r"]
[1943.163295, "o", "\u001b[?2004h> "]
[1943.16345, "o", "                if X[i][j] <= threshold {\r\n\u001b[?2004l\r"]
[1943.163504, "o", "\u001b[?2004h> "]
[1943.163691, "o", "                    leftIdx = append(leftIdx, i)\r\n\u001b[?2004l\r"]
