[12659.833151, "o", "\r\n   532\t\t\t\tcontinue\r\n   533\t\t\t}\r\n   534\t\t\tfor _, r := range refs {\r\n   535\t\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n   536\t\t\t\tif len(parts) == 2 && parts[0] != \"\" {\r\n   537\t\t\t\t\tdeps[parts[0]] = true\r\n   538\t\t\t\t}\r\n   539\t\t\t}\r\n   540\t\t}\r\n   541\t\tout := make([]string, 0, len(deps))\r\n   542\t\tfor dep := range deps {\r\n   543\t\t\tout = append(out, dep)\r\n   544\t\t}\r\n   545"]
