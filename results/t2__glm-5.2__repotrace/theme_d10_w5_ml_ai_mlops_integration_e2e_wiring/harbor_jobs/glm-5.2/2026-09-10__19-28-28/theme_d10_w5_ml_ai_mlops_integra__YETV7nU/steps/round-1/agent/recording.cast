[4931.378812, "o", "   CacheHit   bool              `json:\"cache_hit,omitempty\"`\r\n    DurationMs int64             `json:\"duration_ms\"`\r\n    Outputs    map[string]string `json:\"outputs\"`\r\n    Error      string            `json:\"error,omitempty\"`\r\n}\r\n\r\ntype RunOutput struct {\r\n    Pipeline   string                     `json:\"pipeline\"`\r\n    Status     string                     `json:\"status\"`\r\n    Stages     map[string]*StageResult    `json:\"stages\"`\r\n    Artifacts  map[string]*ArtifactOutput `json:\"artifacts\"`\r\n    CacheStats *CacheStats                `json:\"cache_stats\"`\r\n}\r\n\r\ntype CacheStats struct {\r\n    Hits   int `json:\"hits\"`\r\n   "]
[4931.378906, "i", "  e.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\r        skip := false\r        for _, dep := range stage.DependsOn {\r            if e.status[dep] != \"success\" {\r                skip = true\r                break\r            }\r        }\r        if skip {\r            e.status[name] = \"skipped\"\r            e.results[name].Status = \"skipped\"\r            continue\r        }\r\r        inputValues, inputIDs, err := e.resolveInputs(stage)\r        if err != nil {\r            e.status[name] = \"failed\"\r            e.results[name].Status = \"failed\"\r            e.results[name].Error = err.Error()\r            continue\r        }\r\r        params := e.config.stageParams(name, e.globals)\r        inputKeys := e.inputCacheKeys(stage)\r        cacheKey, keyErr := computeCacheKey(stage, params, inputKeys, -1)\r        if keyErr != nil {\r            e.status[name] = \"failed\"\r            e.results[name].Status = \"failed\"\r            e.results[name].Error = keyErr.Error()\r            continue\r        }\r  "]
