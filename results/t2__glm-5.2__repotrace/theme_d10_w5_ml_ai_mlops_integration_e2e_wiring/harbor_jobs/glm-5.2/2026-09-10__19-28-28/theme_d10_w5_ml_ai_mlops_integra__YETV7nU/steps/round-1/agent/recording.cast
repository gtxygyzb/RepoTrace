[4863.782869, "o", "\u001b[?2004h> "]
[4863.783284, "o", "    configPath, overrides, cv, err := parsePlanArgs(args)\r\n\u001b[?2004l\r"]
[4863.783341, "o", "\u001b[?2004h> "]
[4863.783479, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[4863.783544, "o", "\u001b[?2004h"]
[4863.783571, "o", "> "]
[4863.783771, "o", "        printError(err.Error())\r\n\u001b[?2004l\r"]
[4863.78382, "o", "\u001b[?2004h"]
[4863.783841, "o", "> "]
[4863.783946, "o", "        return\r\n\u001b[?2004l\r"]
[4863.783987, "o", "\u001b[?2004h> "]
[4863.8025, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     config, err := loadConfig(configPath)\r\n\u001b[?2004l\r\u001b[?2004h>     if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>         printError(err.Error())\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     plan, err := buildPlan(config, overrides, cv)\r\n\u001b[?2004l\r\u001b[?2004h>     if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>         printError(err.Error())\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     printJSON(plan)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func cmdValidate(args []string) {\r\n\u001b[?2004l\r\u001b[?2004h>     if len(args) < 1 {\r\n\u001b[?2004l\r\u001b[?2004h>         printError(\"usage: mlpipe validate <config.json>\")\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     config, err := loadConfig(args[0])\r\n\u001b[?2004l\r\u001b[?2004h>     if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>         printError(err.Error())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4863.802563, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h"]
[4863.802665, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4863.802723, "o", "> "]
[4863.802972, "o", "    valid, errors := config.Validate()\r\n\u001b[?2004l\r"]
[4863.80303, "o", "\u001b[?2004h> "]
[4863.803553, "o", "    printJSON(map[string]interface{}{\"valid\": valid, \"errors\": errors})\r\n\u001b[?2004l\r"]
[4863.80361, "o", "\u001b[?2004h> }"]
[4863.803664, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[4863.803719, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4863.803773, "o", "> "]
[4863.803995, "o", "func cmdRegistry(args []string) {\r\n\u001b[?2004l\r"]
[4863.80405, "o", "\u001b[?2004h> "]
[4863.804204, "o", "    if len(args) < 1 {\r\n\u001b[?2004l\r"]
[4863.80427, "o", "\u001b[?2004h> "]
[4863.804825, "o", "        printError(\"usage: mlpipe registry <list|info|promote|compare> [args]\")\r\n\u001b[?2004l\r"]
[4863.804879, "o", "\u001b[?2004h> "]
[4863.804993, "o", "        return\r\n\u001b[?2004l\r"]
[4863.805048, "o", "\u001b[?2004h> "]
[4863.805104, "o", "    }\r\n\u001b[?2004l\r"]
[4863.805157, "o", "\u001b[?2004h> "]
[4863.805317, "o", "    sub := args[0]\r\n\u001b[?2004l\r"]
[4863.805372, "o", "\u001b[?2004h> "]
[4863.80555, "o", "    rest := args[1:]\r\n\u001b[?2004l\r"]
[4863.805609, "o", "\u001b[?2004h"]
[4863.805663, "o", "> "]
[4863.805771, "o", "    switch sub {\r\n\u001b[?2004l\r"]
[4863.805836, "o", "\u001b[?2004h> "]
[4863.805987, "o", "    case \"list\":\r\n\u001b[?2004l\r"]
[4863.806039, "o", "\u001b[?2004h> "]
[4863.806401, "o", "        cmdRegistryList(rest)\r\n\u001b[?2004l\r"]
[4863.806466, "o", "\u001b[?2004h> "]
[4863.806588, "o", "    case \"info\":\r\n\u001b[?2004l\r"]
[4863.806643, "o", "\u001b[?2004h> "]
[4863.806852, "o", "        cmdRegistryInfo(rest)\r\n\u001b[?2004l\r"]
[4863.806907, "o", "\u001b[?2004h> "]
[4863.80705, "o", "    case \"promote\":\r\n\u001b[?2004l\r"]
[4863.807105, "o", "\u001b[?2004h> "]
[4863.807382, "o", "        cmdRegistryPromote(rest)\r\n\u001b[?2004l\r"]
[4863.807447, "o", "\u001b[?2004h> "]
[4863.807587, "o", "    case \"compare\":\r\n\u001b[?2004l\r"]
[4863.807641, "o", "\u001b[?2004h> "]
[4863.807866, "o", "        cmdRegistryCompare(rest)\r\n\u001b[?2004l\r"]
[4863.807926, "o", "\u001b[?2004h> "]
[4863.808017, "o", "    default:\r\n\u001b[?2004l\r"]
[4863.808076, "o", "\u001b[?2004h> "]
[4863.808558, "o", "        printError(fmt.Sprintf(\"unknown registry command: %s\", sub))\r\n\u001b[?2004l\r"]
[4863.808615, "o", "\u001b[?2004h> "]
[4863.808665, "o", "    }\r\n\u001b[?2004l\r"]
[4863.808718, "o", "\u001b[?2004h> }"]
[4863.808772, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[4863.808832, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4863.808887, "o", "> "]
[4863.809122, "o", "func cmdRegistryList(args []string) {\r\n\u001b[?2004l\r"]
[4863.809178, "o", "\u001b[?2004h> "]
[4863.809447, "o", "    name, stage, tag := \"\", \"\", \"\"\r\n\u001b[?2004l\r"]
[4863.809502, "o", "\u001b[?2004h> "]
[4863.809754, "o", "    for i := 0; i < len(args); i++ {\r\n\u001b[?2004l\r"]
[4863.809808, "o", "\u001b[?2004h> "]
[4863.809928, "o", "        switch {\r\n\u001b[?2004l\r"]
[4863.809982, "o", "\u001b[?2004h> "]
[4863.810361, "o", "        case args[i] == \"--name\" && i+1 < len(args):\r\n\u001b[?2004l\r"]
[4863.810416, "o", "\u001b[?2004h> "]
[4863.810619, "o", "            name = args[i+1]\r\n\u001b[?2004l\r"]
[4863.810674, "o", "\u001b[?2004h> "]
[4863.81079, "o", "            i++\r\n\u001b[?2004l\r"]
[4863.810844, "o", "\u001b[?2004h> "]
[4863.811199, "o", "        case strings.HasPrefix(args[i], \"--name=\"):\r\n\u001b[?2004l\r"]
[4863.81126, "o", "\u001b[?2004h> "]
[4863.811656, "o", "            name = strings.TrimPrefix(args[i], \"--name=\")\r\n\u001b[?2004l\r"]
[4863.811711, "o", "\u001b[?2004h> "]
[4863.812078, "o", "        case args[i] == \"--stage\" && i+1 < len(args):\r\n\u001b[?2004l\r"]
[4863.812132, "o", "\u001b[?2004h> "]
[4863.812355, "o", "            stage = args[i+1]\r\n\u001b[?2004l\r"]
[4863.812409, "o", "\u001b[?2004h> "]
[4863.812524, "o", "            i++\r\n\u001b[?2004l\r"]
[4863.812577, "o", "\u001b[?2004h> "]
[4863.812935, "o", "        case strings.HasPrefix(args[i], \"--stage=\"):\r\n\u001b[?2004l\r"]
[4863.812996, "o", "\u001b[?2004h> "]
[4863.81341, "o", "            stage = strings.TrimPrefix(args[i], \"--stage=\")\r\n\u001b[?2004l\r"]
[4863.813464, "o", "\u001b[?2004h> "]
[4863.813821, "o", "        case args[i] == \"--tag\" && i+1 < len(args):\r\n\u001b[?2004l\r"]
[4863.813877, "o", "\u001b[?2004h> "]
[4863.81407, "o", "            tag = args[i+1]\r\n\u001b[?2004l\r"]
[4863.814125, "o", "\u001b[?2004h> "]
[4863.814254, "o", "            i++\r\n\u001b[?2004l\r"]
[4863.814301, "o", "\u001b[?2004h> "]
[4863.814667, "o", "        case strings.HasPrefix(args[i], \"--tag=\"):\r\n\u001b[?2004l\r"]
[4863.814721, "o", "\u001b[?2004h> "]
[4863.815096, "o", "            tag = strings.TrimPrefix(args[i], \"--tag=\")\r\n\u001b[?2004l\r"]
[4863.815159, "o", "\u001b[?2004h"]
[4863.815213, "o", "> "]
[4863.815321, "o", "        default:\r\n\u001b[?2004l\r"]
[4863.815376, "o", "\u001b[?2004h"]
[4863.81543, "o", "> "]
[4863.815822, "o", "            printError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\u001b[?2004l\r"]
[4863.815884, "o", "\u001b[?2004h> "]
[4863.816013, "o", "            return\r\n\u001b[?2004l\r"]
[4863.816077, "o", "\u001b[?2004h> "]
[4863.816154, "o", "        }\r\n\u001b[?2004l\r"]
[4863.81621, "o", "\u001b[?2004h> "]
[4863.816277, "o", "    }\r\n\u001b[?2004l\r"]
[4863.816333, "o", "\u001b[?2004h"]
[4863.816388, "o", "> "]
[4863.816682, "o", "    entries, err := listRegistry(name, stage, tag)\r\n\u001b[?2004l\r"]
[4863.816743, "o", "\u001b[?2004h> "]
[4863.816874, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[4863.816937, "o", "\u001b[?2004h> "]
[4863.817155, "o", "        printError(err.Error())\r\n\u001b[?2004l\r"]
[4863.817225, "o", "\u001b[?2004h> "]
[4863.817331, "o", "        return\r\n\u001b[?2004l\r"]
[4863.817387, "o", "\u001b[?2004h> "]
[4863.817443, "o", "    }\r\n\u001b[?2004l\r"]
[4863.817505, "o", "\u001b[?2004h> "]
[4863.817895, "o", "    out := make([]map[string]interface{}, len(entries))\r\n\u001b[?2004l\r"]
[4863.817949, "o", "\u001b[?2004h> "]
[4863.818161, "o", "    for i, e := range entries {\r\n\u001b[?2004l\r"]
[4863.818234, "o", "\u001b[?2004h> "]
[4863.818448, "o", "        out[i] = map[string]interface{}{\r\n\u001b[?2004l\r"]
[4863.818501, "o", "\u001b[?2004h> "]
[4863.818675, "o", "            \"name\":          e.Name,\r\n\u001b[?2004l\r"]
[4863.818729, "o", "\u001b[?2004h> "]
[4863.818936, "o", "            \"version\":       e.Version,\r\n\u001b[?2004l\r"]
[4863.81899, "o", "\u001b[?2004h> "]
[4863.819179, "o", "            \"stage\":         e.Stage,\r\n\u001b[?2004l\r"]
[4863.819241, "o", "\u001b[?2004h> "]
[4863.81943, "o", "            \"tags\":          e.Tags,\r\n\u001b[?2004l\r"]
[4863.819484, "o", "\u001b[?2004h> "]
[4863.819679, "o", "            \"metrics\":       e.Metrics,\r\n\u001b[?2004l\r"]
[4863.819733, "o", "\u001b[?2004h> "]
[4863.819968, "o", "            \"registered_at\": e.RegisteredAt,\r\n\u001b[?2004l\r"]
[4863.820028, "o", "\u001b[?2004h> "]
[4863.820083, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4863.820138, "o", ">     }\r\n\u001b[?2004l\r"]
[4863.820194, "o", "\u001b[?2004h> "]
[4863.820292, "o", "    printJSON(out)\r\n\u001b[?2004l\r"]
[4863.820347, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4863.820394, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rf"]
[4863.82048, "o", "\u001b[?2004h> "]
[4863.820659, "o", "func cmdRegistryInfo(args []string) {\r\n\u001b[?2004l\r"]
[4863.820718, "o", "\u001b[?2004h> "]
[4863.820836, "o", "    if len(args) < 1 {\r\n\u001b[?2004l\r"]
[4863.820889, "o", "\u001b[?2004h> "]
[4863.821232, "o", "        printError(\"usage: mlpipe registry info <name>:<version>\")\r\n\u001b[?2004l\r"]
[4863.821289, "o", "\u001b[?2004h> "]
[4863.821363, "o", "        return\r\n\u001b[?2004l\r"]
[4863.821419, "o", "\u001b[?2004h>     }"]
[4863.821475, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4863.821761, "o", "    name, version, ok := splitNameVersion(args[0])\r\n\u001b[?2004l\r"]
