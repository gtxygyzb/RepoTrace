[12009.656037, "o", "    39\tfunc (e *Executor) RunCV() (*CVRunOutput, error) {\r\n    40\t\tif e.cvFolds < 2 {\r\n    41\t\t\treturn nil, fmt.Errorf(\"cv folds must be >= 2\")\r\n    42\t\t}\r\n    43\t\r\n    44\t\tvalid, errs := e.config.Validate()\r\n    45\t\t"]
[12009.65613, "o", "if !valid {\r\n    46\t\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n    47\t\t}\r\n    48\t\tif err := e.config.validateCV(); err != nil {\r\n    49\t\t\treturn nil, err\r\n    50\t\t}\r\n    51\t\r\n    52\t\torder, err := e.config.topologicalOrder()\r\n    53\t\tif err != nil {\r\n    54\t\t\treturn nil, err\r\n    55\t\t}\r\n    56\t\r\n    57\t\tsplitName, _ := e.config.splitStageName()\r\n"]
[12009.65621, "o", "    58\t\tpostSplit := e.config.postSplitStages(splitName)\r\n    59\t\tpreSplitOrder := []string{}\r\n    60\t\tpostSplitOrder := []string{}\r\n    61\t\tfor _, name := range order {\r\n    62\t\t\tif postSplit[name] {\r\n    63\t\t\t\tpostSplitOrder = append(postSplitOrder, name)\r\n    64\t\t\t} else {\r\n    65\t\t\t\tpreSplitOrder = append(preSplitOrder, name)\r\n    66"]
[12009.656284, "o", "\t\t\t}\r\n    67\t\t}\r\n    68\t\r\n    69\t\tallArtifacts := map[string]*ArtifactOutput{}\r\n    70\t\r\n    71\t\tfor _, name := range preSplitOrder {\r\n    72\t\t\te.executeStageCached(name, -1, 0, allArtifacts)\r\n    73\t\t}\r\n    74\t\r\n    75\t\tfoldResults := make([]CVFoldResult, e.cvFolds)\r\n    76\t\tfoldMetrics := make([]map[string]float64, e.cvFolds)\r\n"]
[12009.656348, "o", "    77\t\r\n    78\t\tfor i := 0; i < e.cvFolds; i++ {\r\n    79\t\t\tfoldExec := &Executor{\r\n    80\t\t\t\tconfig:     e.config,\r\n    81\t\t\t\tglobals:    e.globals,\r\n    82\t\t\t\tstatus:     map[string]string{},\r\n    83\t\t\t\tresults:    map[string]*StageResult{},\r\n    84\t\t\t\toutputs:    map[string]map[string]string{},\r\n    85\t\t\t\tvalues:     map[string]map[string]*ArtifactValue{},\r\n    86"]
[12009.656406, "o", "\t\t\t\tmeta:       e.meta,\r\n    87\t\t\t\tcacheKeys:  map[string]string{},\r\n    88\t\t\t\tnoCache:    e.noCache,\r\n    89\t\t\t\tcvFolds:    e.cvFolds,\r\n    90\t\t\t\tcacheStats: e.cacheStats,\r\n    91\t\t\t}\r\n    92"]
[12009.656463, "o", "\t\t\tfor name, st := range e.status {\r\n    93\t\t\t\tfoldExec.status[name] = st\r\n    94\t\t\t}\r\n    95\t\t\tfor name, outs := range e.outputs {\r\n    96\t\t\t\tfoldExec.outputs[name] = copyStringMap(outs)\r\n"]
[12009.656522, "o", "    97\t\t\t}\r\n    98\t\t\tfor name, vals := range e.values {\r\n    99\t\t\t\tfoldExec.values[name] = copyValueMap(vals)\r\n   100\t\t\t}\r\n   101\t\t\tfor name, key := range e.cacheKeys {\r\n   102\t\t\t\tfoldExec.cacheKeys[name] = key\r\n   103\t\t\t}\r\n   104\t\r\n"]
[12009.656581, "o", "   105\t\t\tfoldArtifacts := map[string]*ArtifactOutput{}\r\n   106\t\t\tfor _, name := range postSplitOrder {\r\n   107\t\t\t\tfoldExec.executeStageCached(name, i, e.cvFolds, foldArtifacts)\r\n   108\t\t\t}\r\n   109\t\r\n   110\t\t\tfoldStatus := \"success\"\r\n   111\t\t\tfor _, r := range foldExec.results {\r\n"]
