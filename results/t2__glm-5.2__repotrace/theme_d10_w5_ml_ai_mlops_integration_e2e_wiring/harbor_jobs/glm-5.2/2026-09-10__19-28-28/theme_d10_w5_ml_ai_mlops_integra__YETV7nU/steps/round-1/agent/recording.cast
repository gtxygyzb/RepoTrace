[6731.609711, "o", "\u001b[?2004l\r"]
[6731.612458, "o", "\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"r2\":\u001b[m\u001b[K\r\n\u001b[32m\u001b[K196\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tmean := 0.0\r\n\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor _, v := range y {\r\n\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tmean += v\r\n"]
[6731.612541, "o", "\u001b[32m\u001b[K199\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tmean /= n\r\n\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tssRes := 0.0\r\n\u001b[32m\u001b[K202\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tssTot := 0.0\r\n\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor i := range y {\r\n\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tssRes += (y[i] - preds[i]) * (y[i] - preds[i])\r\n\u001b[32m\u001b[K205\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tssTot += (y[i] - mean) * (y[i] - mean)\r\n\u001b[32m\u001b[K206\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif ssTot == 0 {\r\n\u001b[32m\u001b[K208\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn 0.0, nil\r\n\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K210\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn 1 - ssRes/ssTot, nil\r\n"]
[6731.612614, "o", "\u001b[32m\u001b[K211\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"mape\":\r\n\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsum := 0.0\r\n\u001b[32m\u001b[K213\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcount := 0.0\r\n\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor i := range y {\r\n\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif y[i] == 0 {\r\n\u001b[32m\u001b[K216\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tcontinue\r\n\u001b[32m\u001b[K217\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsum += math.Abs((y[i] - preds[i]) / y[i])\r\n\u001b[32m\u001b[K219\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tcount++\r\n\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n"]
[6731.612684, "o", "\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif count == 0 {\r\n\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn 0.0, nil\r\n\u001b[32m\u001b[K223\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn sum / count * 100, nil\r\n\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn nil, fmt.Errorf(\"unknown regression metric %q\", name)\r\n\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc aucROC(y []float64, scores []float64) float64 {\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ttype point struct {\r\n"]
