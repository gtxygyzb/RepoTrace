[9392.341923, "o", "func (e *Executor) Run() (*RunOutput, error) {\r\n\tvalid, errs := e.config.Validate()\r\n\tif !valid {\r\n\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n\t}\r\n\torder, err := e.config.topologicalOrder()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n"]
[9392.342047, "o", "\t}\r\n\r\n\trunArtifacts := map[string]*ArtifactOutput{}\r\n\r\n\tfor _, name := range order {\r\n\t\tstage, _ := e.config.stageByName(name)\r\n\t\te.outputs[name] = map[string]string{}\r\n\t\te.values[name] = map[string]*ArtifactValue{}\r\n\t\te.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n\r\n\t\tskip := false\r\n\t\tfor _, dep := range stage.DependsOn {\r\n\t\t\tif e.status[dep] != \"success\" {\r\n\t\t\t\tskip = true\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif skip {\r\n\t\t\te.status[name] = \"skipped\"\r\n"]
[9392.342136, "o", "\t\t\te.results[name].Status = \"skipped\"\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tinputValues, inputIDs, err := e.resolveInputs(stage)\r\n\t\tif err != nil {\r\n\t\t\te.status[name] = \"failed\"\r\n"]
[9392.342214, "o", "\t\t\te.results[name].Status = \"failed\"\r\n\t\t\te.results[name].Error = err.Error()\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tparams := e.config.stageParams(name, e.globals)\r\n\t\tinputKeys := e.inputCacheKeys(stage)\r\n\t\tcacheKey, keyErr := computeCacheKey(stage, params, inputKeys, -1)\r\n\t\tif keyErr != nil {\r\n\t\t\te.status[name] = \"failed\"\r\n\t\t\te.results[name].Status = \"failed\"\r\n\t\t\te.results[name].Error = keyErr.Error()\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\te.cacheKeys[name] = cacheKey\r\n\r\n\t\tvar out map[string]*ArtifactValue\r\n\t\tstart := time.Now()\r\n\t"]
[9392.342328, "o", "\tif !e.noCache && cacheEntryExists(cacheKey) {\r\n\t\t\tloaded, err := loadCacheEntry(cacheKey)\r\n\t\t\tduration := time.Since(start).Milliseconds()\r\n\t\t\te.results[name].DurationMs = duration\r\n\t\t\tif err == nil {\r\n\t\t\t\tout = loaded\r\n\t\t\t\te.results[name].CacheHit = true\r\n\t\t\t\te.cacheStats.Hits++\r\n\t\t\t} else {\r\n\t\t\t\tif !e.noCache {\r\n\t\t\t\t\te.cacheStats.Misses++\r\n\t\t\t\t}\r\n\t\t\t\tout, err = executeStage(stage, params, inputValues)\r\n"]
[9392.342415, "o", "\t\t\t\tduration = time.Since(start).Milliseconds()\r\n\t\t\t\te.results[name].DurationMs = duration\r\n\t\t\t\tif err != nil {\r\n\t\t\t\t\te.status[name] = \"failed\"\r\n\t\t\t\t\te.results[name].Status = \"failed\"\r\n\t\t\t\t\te.results[name].Error = err.Error()\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t"]
[9392.342484, "o", "\tvar err error\r\n\t\t\tout, err = executeStage(stage, params, inputValues)\r\n\t\t\tduration := time.Since(start).Milliseconds()\r\n\t\t\te.results[name].DurationMs = duration\r\n\t\t\tif err != nil {\r\n\t\t\t\te.status[name] = \"failed\"\r\n\t\t\t\te.results[name].Status = \"failed\"\r\n\t\t\t\te.results[name].Error = err.Error()\r\n"]
[9392.342553, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif !e.noCache {\r\n\t\t\t\t_ = saveCacheEntry(cacheKey, name, stage.Type, out)\r\n\t\t\t}\r\n\t\t\tif !e.noCache {\r\n\t\t\t\te.cacheStats.Misses++\r\n\t\t\t}\r\n\t"]
[9392.34262, "o", "\t}\r\n\r\n\t\te.status[name] = \"success\"\r\n\t\te.results[name].Status = \"success\"\r\n\t\tts := time.Now().UnixNano()\r\n\r\n\t\tfor port, val := range out {\r\n\t\t\tid := artifactID(e.config.Pipeline.Name, name, port, ts)\r\n\t\t\te.values[name][port] = val\r\n\t\t\te.outputs[name][port] = id\r\n"]
[9392.342693, "o", "\t\t\ttyp := val.Type()\r\n\t\t\tsummary := val.Summary()\r\n\t\t\tmeta := &ArtifactMeta{\r\n\t\t\t\tID:        id,\r\n\t\t\t\tStage:     name,\r\n\t\t\t\tPort:      port,\r\n\t\t\t\tType:      typ,\r\n\t\t\t\tSummary:   summary,\r\n\t\t\t\tInputs:    inputIDs,\r\n\t\t\t\tOutputs:   []string{},\r\n\t\t\t\tTimestamp: ts,\r\n"]
[9392.34276, "o", "\t\t\t}\r\n\t\t\te.meta[id] = meta\r\n\t\t\tfor _, inID := range inputIDs {\r\n\t\t\t\tif parent, ok := e.meta[inID]; ok {\r\n\t\t\t\t\tparent.Outputs = appendUnique(parent.Outputs, id)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\trunArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n\t\t}\r\n\t}\r\n"]
[9392.34283, "o", "\r\n\tstatus := \"success\"\r\n\tfor _, s := range e.results {\r\n\t\tif s.Status != \"success\" {\r\n\t\t\tstatus = \"failed\"\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n\trun := &RunOutput{\r\n\t\tPipeline:   e.config.Pipeline.Name,\r\n\t\tStatus:     status,\r\n"]
[9392.342908, "o", "\t\tStages:     e.results,\r\n\t\tArtifacts:  runArtifacts,\r\n\t\tCacheStats: e.cacheStats,\r\n\t}\r\n\r\n\tif err := saveArtifacts(e.meta); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif err := saveRunAny(e.config.Pipeline.Name, run); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\treturn run, nil\r\n}\r\n\r\n"]
