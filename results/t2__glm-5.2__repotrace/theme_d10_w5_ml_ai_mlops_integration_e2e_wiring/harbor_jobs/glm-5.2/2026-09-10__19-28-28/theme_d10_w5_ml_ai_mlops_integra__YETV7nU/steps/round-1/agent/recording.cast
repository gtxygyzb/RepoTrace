[5326.325395, "o", "func (c *Config) validateCV() error {\r\n\u001b[?2004l\r"]
[5326.32545, "o", "\u001b[?2004h> "]
[5326.325554, "o", "    splitNames := []string{}\r\n\u001b[?2004l\r"]
[5326.325588, "o", "\u001b[?2004h> "]
[5326.325736, "o", "    for _, s := range c.Stages {\r\n\u001b[?2004l\r"]
[5326.325795, "o", "\u001b[?2004h> "]
[5326.325891, "o", "        if s.Type == \"split\" {\r\n\u001b[?2004l\r"]
[5326.325947, "o", "\u001b[?2004h> "]
[5326.326091, "o", "            splitNames = append(splitNames, s.Name)\r\n\u001b[?2004l\r"]
[5326.326147, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[5326.326202, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5326.326269, "o", "\u001b[?2004h> "]
[5326.326352, "o", "    if len(splitNames) != 1 {\r\n\u001b[?2004l\r"]
[5326.326408, "o", "\u001b[?2004h> "]
[5326.326607, "o", "        return fmt.Errorf(\"cv mode requires exactly one split stage\")\r\n\u001b[?2004l\r"]
[5326.326662, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5326.326723, "o", "\u001b[?2004h> "]
[5326.326795, "o", "    splitName := splitNames[0]\r\n\u001b[?2004l\r"]
[5326.32685, "o", "\u001b[?2004h> "]
[5326.32696, "o", "    post := c.postSplitStages(splitName)\r\n\u001b[?2004l\r"]
[5326.327016, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.32707, "o", "> "]
[5326.327124, "o", "    hasTrain := false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.327241, "o", "    for name := range post {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.327297, "o", "> "]
[5326.327403, "o", "        stage, _ := c.stageByName(name)\r\n\u001b[?2004l\r"]
[5326.327457, "o", "\u001b[?2004h> "]
[5326.3276, "o", "        if stage != nil && stage.Type == \"train\" {\r\n\u001b[?2004l\r"]
[5326.327655, "o", "\u001b[?2004h> "]
[5326.327724, "o", "            hasTrain = true\r\n\u001b[?2004l\r"]
[5326.327778, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[5326.327833, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5326.327887, "o", "\u001b[?2004h> "]
[5326.32796, "o", "    hasEvaluate := false\r\n\u001b[?2004l\r"]
[5326.328014, "o", "\u001b[?2004h> "]
[5326.328088, "o", "    for name := range post {\r\n\u001b[?2004l\r"]
[5326.328142, "o", "\u001b[?2004h> "]
[5326.328255, "o", "        stage, _ := c.stageByName(name)\r\n\u001b[?2004l\r"]
[5326.32831, "o", "\u001b[?2004h> "]
[5326.328462, "o", "        if stage == nil || stage.Type != \"evaluate\" {\r\n\u001b[?2004l\r"]
[5326.328517, "o", "\u001b[?2004h> "]
[5326.328569, "o", "            continue\r\n\u001b[?2004l\r"]
[5326.328629, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[5326.328683, "o", "\u001b[?2004h> "]
[5326.328789, "o", "        ancestors := c.ancestors(name)\r\n\u001b[?2004l\r"]
[5326.328848, "o", "\u001b[?2004h> "]
[5326.328943, "o", "        for anc := range ancestors {\r\n\u001b[?2004l\r"]
[5326.328998, "o", "\u001b[?2004h> "]
[5326.32907, "o", "            if anc == name {\r\n\u001b[?2004l\r"]
[5326.329129, "o", "\u001b[?2004h> "]
[5326.329184, "o", "                continue\r\n\u001b[?2004l\r"]
[5326.329265, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[5326.32932, "o", "\u001b[?2004h> "]
[5326.329455, "o", "            ancStage, ok := c.stageByName(anc)\r\n\u001b[?2004l\r"]
[5326.329511, "o", "\u001b[?2004h> "]
[5326.32969, "o", "            if !ok || ancStage.Type != \"train\" || !post[anc] {\r\n\u001b[?2004l\r"]
[5326.329744, "o", "\u001b[?2004h> "]
[5326.329805, "o", "                continue\r\n\u001b[?2004l\r"]
[5326.329863, "o", "\u001b[?2004h> "]
[5326.329931, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.330017, "o", "            hasEvaluate = true\r\n\u001b[?2004l\r"]
[5326.330072, "o", "\u001b[?2004h> "]
[5326.330132, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.33019, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.330255, "o", "> "]
[5326.33032, "o", "        if hasEvaluate {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.33039, "o", "            break\r\n\u001b[?2004l\r"]
[5326.330445, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[5326.330505, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5326.330559, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.330613, "o", "> "]
[5326.330696, "o", "    if !hasTrain || !hasEvaluate {\r\n\u001b[?2004l\r"]
[5326.330753, "o", "\u001b[?2004h> "]
[5326.331049, "o", "        return fmt.Errorf(\"cv mode requires train and evaluate stages downstream of the split stage\")\r\n\u001b[?2004l\r"]
[5326.331104, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5326.331158, "o", "\u001b[?2004h> "]
[5326.331222, "o", "    return nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[5326.331284, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5326.331339, "o", "\u001b[?2004h> "]
[5326.331484, "o", "func (c *Config) splitStageName() (string, bool) {\r\n\u001b[?2004l\r"]
[5326.331539, "o", "\u001b[?2004h> "]
[5326.331625, "o", "    for _, s := range c.Stages {\r\n\u001b[?2004l\r"]
[5326.33168, "o", "\u001b[?2004h> "]
[5326.331759, "o", "        if s.Type == \"split\" {\r\n\u001b[?2004l\r"]
[5326.331819, "o", "\u001b[?2004h> "]
[5326.331896, "o", "            return s.Name, true\r\n\u001b[?2004l\r"]
[5326.331951, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[5326.332006, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5326.332061, "o", "\u001b[?2004h> "]
[5326.33212, "o", "    return \"\", false\r\n\u001b[?2004l\r"]
[5326.332174, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.332238, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.332408, "o", "func (c *Config) stageDeps(s *StageConfig) []string {\r\n\u001b[?2004l\r"]
[5326.332464, "o", "\u001b[?2004h> "]
[5326.33254, "o", "    deps := map[string]bool{}\r\n\u001b[?2004l\r"]
[5326.332595, "o", "\u001b[?2004h> "]
[5326.332695, "o", "    for _, dep := range s.DependsOn {\r\n\u001b[?2004l\r"]
[5326.332751, "o", "\u001b[?2004h> "]
[5326.332806, "o", "        if dep != \"\" {\r\n\u001b[?2004l\r"]
[5326.332861, "o", "\u001b[?2004h> "]
[5326.332948, "o", "            deps[dep] = true\r\n\u001b[?2004l\r"]
[5326.333003, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[5326.333056, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5326.333111, "o", "\u001b[?2004h> "]
[5326.333225, "o", "    for _, ref := range s.Inputs {\r\n\u001b[?2004l\r"]
