[4863.77645, "o", "        printError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n\u001b[?2004l\r"]
[4863.7765, "o", "\u001b[?2004h> "]
[4863.776559, "o", "    }\r\n\u001b[?2004l\r"]
