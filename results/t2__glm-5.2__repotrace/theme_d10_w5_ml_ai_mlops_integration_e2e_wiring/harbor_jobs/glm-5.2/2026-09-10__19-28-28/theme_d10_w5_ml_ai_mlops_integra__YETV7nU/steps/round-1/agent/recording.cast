[12659.556274, "o", "\t\t\t\tkeys[local] = strings.Join(parts, \"\\n\")\r\n   300\t\t\t}\r\n   301\t\t}\r\n   302\t\treturn keys\r\n   303\t}\r\n   304\t\r\n   305\tfunc (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {\r\n   306\t\tinputs := map[string]*ArtifactValue{}\r\n   307\t\tids := []string{}\r\n   308\t\tfor local, ref := range stage.Inputs {\r\n   309\t\t\trefs, ok := inputRefs(ref)\r\n   310\t\t"]
[12659.556322, "o", "\tif !ok {\r\n   311\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q has invalid reference %v\", stage.Name, local, ref)\r\n   312\t\t\t}\r\n   313\t\t\tvar firstVal *ArtifactValue\r\n   314\t\t\tfor _, r := range refs {\r\n   315\t\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n   316\t\t\t\tif len(parts) != 2 {\r\n"]
