[10912.908293, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[10912.908396, "o", "\t\"regexp\"\r\n\t\"strings\"\r\n)\r\n\r\ntype Config struct {\r\n"]
[10912.908496, "o", "\tPipeline PipelineConfig `json:\"pipeline\"`\r\n\tStages   []StageConfig  `json:\"stages\"`\r\n}\r\n\r\ntype PipelineConfig struct {\r\n\tName      string                 `json:\"name\"`\r\n\tParams    map[string]interface{} `json:\"params\"`\r\n\tOnFailure string                 `json:\"on_failure,omitempty\"`\r\n}\r\n\r\ntype StageConfig struct {\r\n\tName      string                 `json:\"name\"`\r\n\tType      string                 `json:\"type\"`\r\n\tDependsOn []string               `json:\"depends_on\"`\r\n\tInputs    map[string]interface{} `json:\"inputs\"`\r\n\tParams    map[string]interface{} `json:\"params\"`\r\n}\r\n\r\nvar paramRE = regexp.MustCompile(`\\$\\{([^}]+)\\}`)\r\n\r\nfunc loadConfig(path string) (*Config, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, fmt.Errorf(\"file not found: %s\", path)\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\tvar c Config\r\n\tif err := json.Unmarshal(data, &c); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"invalid config: %s\", err.Error())\r\n"]
[10912.908596, "o", "\t}\r\n\treturn &c, nil\r\n}\r\n\r\nfunc (c *Config) globalParams(overrides map[string]string) map[string]interface{} {\r\n\tparams := map[string]interface{}{}\r\n\tfor k, v := range c.Pipeline.Params {\r\n\t\tparams[k] = v\r\n\t}\r\n\tfor k, v := range overrides {\r\n\t\tparams[k] = v\r\n\t}\r\n\treturn params\r\n}\r\n\r\nfunc mergeParams(params map[string]interface{}, overrides map[string]string) map[string]interface{} {\r\n\tres := map[string]interface{}{}\r\n\tfor k, v := range params {\r\n\t"]
[10912.908656, "o", "\tres[k] = v\r\n\t}\r\n\tfor k, v := range overrides {\r\n\t\tres[k] = v\r\n\t}\r\n\treturn res\r\n}\r\n\r\nfunc substituteValue(v interface{}, globals map[string]interface{}) interface{} {\r\n\tswitch x := v.(type) {\r\n"]
[10912.908715, "o", "\tcase string:\r\n\t\treturn paramRE.ReplaceAllStringFunc(x, func(m string) string {\r\n\t\t\tkey := m[2 : len(m)-1]\r\n\t\t\tif val, ok := globals[key]; ok {\r\n\t\t\t\treturn fmt.Sprintf(\"%v\", val)\r\n\t\t\t}\r\n\t\t\treturn m\r\n"]
[10912.908774, "o", "\t\t})\r\n\tcase map[string]interface{}:\r\n\t\tres := map[string]interface{}{}\r\n\t\tfor k, val := range x {\r\n\t\t\tres[k] = substituteValue(val, globals)\r\n\t\t}\r\n\t\treturn res\r\n\tcase []interface{}:\r\n\t\tres := make([]interface{}, len(x))\r\n\t\tfor i, val := range x {\r\n\t\t"]
[10912.908833, "o", "\tres[i] = substituteValue(val, globals)\r\n\t\t}\r\n\t\treturn res\r\n\tdefault:\r\n\t\treturn v\r\n\t}\r\n}\r\n\r\nfunc (c *Config) stageParams(name string, globals map[string]interface{}) map[string]interface{} {\r\n"]
[10912.90889, "o", "\tfor _, s := range c.Stages {\r\n\t\tif s.Name == name {\r\n\t\t\tif s.Params == nil {\r\n\t\t\t\treturn map[string]interface{}{}\r\n\t\t\t}\r\n\t\t\tres := substituteValue(s.Params, globals)\r\n\t\t\tif m, ok := res.(map[string]interface{}); ok {\r\n\t\t\t\treturn m\r\n"]
[10912.90895, "o", "\t\t\t}\r\n\t\t\treturn map[string]interface{}{}\r\n\t\t}\r\n\t}\r\n\treturn map[string]interface{}{}\r\n}\r\n\r\nfunc (c *Config) stageByName(name string) (*StageConfig, bool) {\r\n\tfor i := range c.Stages {\r\n"]
[10912.909025, "o", "\t\tif c.Stages[i].Name == name {\r\n\t\t\treturn &c.Stages[i], true\r\n\t\t}\r\n\t}\r\n\treturn nil, false\r\n}\r\n\r\nfunc inputRefs(v interface{}) ([]string, bool) {\r\n\tswitch x := v.(type) {\r\n\tcase string:\r\n\t\treturn []string{x}, true\r\n\tcase []interface{}:\r\n\t\tres := make([]string, 0, len(x))\r\n"]
[10912.909091, "o", "\t\tfor _, item := range x {\r\n\t\t\ts, ok := item.(string)\r\n\t\t\tif !ok {\r\n\t\t\t\treturn nil, false\r\n\t\t\t}\r\n\t\t\tres = append(res, s)\r\n\t\t}\r\n\t\treturn res, true\r\n\t}\r\n\treturn nil, false\r\n}\r\n\r\n"]
[10912.909148, "o", "func validOutputPorts(t string) []string {\r\n\tswitch t {\r\n\tcase \"data-source\":\r\n\t\treturn []string{\"data\"}\r\n\tcase \"transform\":\r\n\t\treturn []string{\"data\"}\r\n\tcase \"split\":\r\n\t\treturn []string{\"train\", \"test\"}\r\n\tcase \"train\":\r\n"]
[10912.909203, "o", "\t\treturn []string{\"model\", \"predictions\"}\r\n\tcase \"evaluate\":\r\n\t\treturn []string{\"report\"}\r\n\tcase \"register\":\r\n\t\treturn []string{\"entry\"}\r\n\tcase \"ensemble\":\r\n\t\treturn []string{\"predictions\", \"model\"}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n"]
[10912.909315, "o", "func validStageType(t string) bool {\r\n\tswitch t {\r\n\tcase \"data-source\", \"transform\", \"split\", \"train\", \"evaluate\", \"register\", \"ensemble\":\r\n\t\treturn true\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc (c *Config) Validate() (bool, []string) {\r\n\terrors := []string{}\r\n\tnames := map[string]bool{}\r\n\tfor i, s := range c.Stages {\r\n\t\tif s.Name == \"\" {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"stage at index %d has empty name\", i))\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif names[s.Name] {\r\n\t"]
[10912.909405, "o", "\t\terrors = append(errors, fmt.Sprintf(\"duplicate stage name: %s\", s.Name))\r\n\t\t}\r\n\t\tnames[s.Name] = true\r\n\t}\r\n\tfor _, s := range c.Stages {\r\n"]
