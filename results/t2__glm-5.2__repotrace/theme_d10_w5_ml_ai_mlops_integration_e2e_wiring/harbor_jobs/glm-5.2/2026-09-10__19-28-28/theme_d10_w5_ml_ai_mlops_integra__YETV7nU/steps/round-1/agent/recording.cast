[11915.933078, "o", "nl -ba config.go | sed -n '1,260p'\r\n\u001b[?2004l\r"]
[11915.937067, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"regexp\"\r\n"]
[11915.937165, "o", "     8\t\t\"strings\"\r\n     9\t)\r\n    10\t\r\n    11\ttype Config struct {\r\n    12\t\tPipeline PipelineConfig `json:\"pipeline\"`\r\n    13\t\tStages   []StageConfig  `json:\"stages\"`\r\n    14\t}\r\n    15\t\r\n    16\ttype PipelineConfig struct {\r\n    17\t\tName      string                 `json:\"name\"`\r\n    18\t\tParams    map[string]interface{} `json:\"params\"`\r\n    19\t\tOnFailure string                 `json:\"on_failure,omitempty\"`\r\n    20\t}\r\n    21\t\r\n    22\ttype StageConfig struct {\r\n    23\t\t"]
[11915.937289, "o", "Name      string                 `json:\"name\"`\r\n    24\t\tType      string                 `json:\"type\"`\r\n    25\t\tDependsOn []string               `json:\"depends_on\"`\r\n    26\t\tInputs    map[string]interface{} `json:\"inputs\"`\r\n    27\t\tParams    map[string]interface{} `json:\"params\"`\r\n    28\t}\r\n    29\t\r\n    30\tvar paramRE = regexp.MustCompile(`\\$\\{([^}]+)\\}`)\r\n    31\t\r\n    32\tfunc loadConfig(path string) (*Config, error) {\r\n    33\t\tdata, err := os.ReadFile(path)\r\n    34\t\tif err != nil {\r\n    35\t\t\tif os.IsNotExist(err) {\r\n    36\t\t\t\treturn nil, fmt.Errorf(\"file not found: %s\", path)\r\n"]
[11915.937363, "o", "    37\t\t\t}\r\n    38\t\t\treturn nil, err\r\n    39\t\t}\r\n    40\t\tvar c Config\r\n    41\t\tif err := json.Unmarshal(data, &c); err != nil {\r\n    42\t\t\treturn nil, fmt.Errorf(\"invalid config: %s\", err.Error())\r\n    43\t\t}\r\n"]
[11915.937432, "o", "    44\t\treturn &c, nil\r\n    45\t}\r\n    46\t\r\n    47\tfunc (c *Config) globalParams(overrides map[string]string) map[string]interface{} {\r\n    48\t\tparams := map[string]interface{}{}\r\n    49\t\tfor k, v := range c.Pipeline.Params {\r\n"]
[11915.937492, "o", "    50\t\t\tparams[k] = v\r\n    51\t\t}\r\n    52\t\tfor k, v := range overrides {\r\n    53\t\t\tparams[k] = v\r\n    54\t\t}\r\n    55\t\treturn params\r\n    56\t}\r\n    57\t\r\n    58"]
[11915.937553, "o", "\tfunc mergeParams(params map[string]interface{}, overrides map[string]string) map[string]interface{} {\r\n    59\t\tres := map[string]interface{}{}\r\n    60\t\tfor k, v := range params {\r\n    61\t\t\tres[k] = v\r\n    62\t\t}\r\n    63\t\tfor k, v := range overrides {\r\n    64\t\t\tres[k] = v\r\n    65\t\t}\r\n"]
[11915.937615, "o", "    66\t\treturn res\r\n    67\t}\r\n    68\t\r\n    69\tfunc substituteValue(v interface{}, globals map[string]interface{}) interface{} {\r\n    70\t\tswitch x := v.(type) {\r\n    71\t\tcase string:\r\n    72\t\t\treturn paramRE.ReplaceAllStringFunc(x, func(m string) string {\r\n    73\t\t\t\tkey := m[2 : len(m)-1]\r\n    74\t\t\t\tif val, ok := globals[key]; ok {\r\n"]
[11915.937681, "o", "    75\t\t\t\t\treturn fmt.Sprintf(\"%v\", val)\r\n    76\t\t\t\t}\r\n    77\t\t\t\treturn m\r\n    78\t\t\t})\r\n    79\t\tcase map[string]interface{}:\r\n"]
[11915.93774, "o", "    80\t\t\tres := map[string]interface{}{}\r\n    81\t\t\tfor k, val := range x {\r\n    82\t\t\t\tres[k] = substituteValue(val, globals)\r\n    83\t\t\t}\r\n    84\t\t\treturn res\r\n    85\t\tcase []interface{}:\r\n    86\t\t\tres := make([]interface{}, len(x))\r\n    87\t\t\tfor i, val := range x {\r\n    88\t\t\t\tres[i] = substituteValue(val, globals)\r\n    89\t\t\t}\r\n    90\t\t\treturn res\r\n    91\t\tdefault:\r\n    92\t\t\treturn v\r\n    93\t\t}\r\n    94\t"]
[11915.937798, "o", "}\r\n    95\t\r\n    96\tfunc (c *Config) stageParams(name string, globals map[string]interface{}) map[string]interface{} {\r\n    97\t\tfor _, s := range c.Stages {\r\n    98\t\t\tif s.Name == name {\r\n    99\t\t\t\tif s.Params == nil {\r\n   100\t\t\t\t\treturn map[string]interface{}{}\r\n   101\t\t\t\t}\r\n"]
[11915.937855, "o", "   102\t\t\t\tres := substituteValue(s.Params, globals)\r\n   103\t\t\t\tif m, ok := res.(map[string]interface{}); ok {\r\n   104\t\t\t\t\treturn m\r\n   105\t\t\t\t}\r\n   106\t\t\t\treturn map[string]interface{}{}\r\n   107\t\t\t}\r\n   108\t\t}\r\n   109\t\t"]
[11915.937913, "o", "return map[string]interface{}{}\r\n   110\t}\r\n   111\t\r\n   112\tfunc (c *Config) stageByName(name string) (*StageConfig, bool) {\r\n   113\t\tfor i := range c.Stages {\r\n   114\t\t\tif c.Stages[i].Name == name {\r\n   115\t\t\t\treturn &c.Stages[i], true\r\n   116\t\t\t}\r\n   117\t\t}\r\n"]
[11915.93797, "o", "   118\t\treturn nil, false\r\n   119\t}\r\n   120\t\r\n   121\tfunc inputRefs(v interface{}) ([]string, bool) {\r\n   122\t\tswitch x := v.(type) {\r\n   123\t\tcase string:\r\n   124\t\t\treturn []string{x}, true\r\n"]
[11915.938027, "o", "   125\t\tcase []interface{}:\r\n   126\t\t\tres := make([]string, 0, len(x))\r\n   127\t\t\tfor _, item := range x {\r\n   128\t\t\t\ts, ok := item.(string)\r\n   129\t\t\t\tif !ok {\r\n   130\t\t\t\t\treturn nil, false\r\n   131\t\t\t\t}\r\n   132\t\t\t\tres = append(res, s)\r\n"]
[11915.938084, "o", "   133\t\t\t}\r\n   134\t\t\treturn res, true\r\n   135\t\t}\r\n   136\t\treturn nil, false\r\n   137\t}\r\n   138\t\r\n   139\tfunc validOutputPorts(t string) []string {\r\n   140\t\tswitch t {\r\n   141\t\tcase \"data-source\":\r\n"]
[11915.938143, "o", "   142\t\t\treturn []string{\"data\"}\r\n   143\t\tcase \"transform\":\r\n   144\t\t\treturn []string{\"data\"}\r\n   145\t\tcase \"split\":\r\n   146\t\t\treturn []string{\"train\", \"test\"}\r\n   147\t\tcase \"train\":\r\n   148\t\t\treturn []string{\"model\", \"predictions\"}\r\n   149\t\tcase \"evaluate\":\r\n   150\t\t\treturn []string{\"report\"}"]
[11915.938204, "o", "\r\n   151\t\tcase \"register\":\r\n   152\t\t\treturn []string{\"entry\"}\r\n   153\t\tcase \"ensemble\":\r\n   154\t\t\treturn []string{\"predictions\", \"model\"}\r\n   155\t\t}\r\n   156\t\treturn nil\r\n   157\t}\r\n   158\t\r\n"]
[11915.938278, "o", "   159\tfunc validStageType(t string) bool {\r\n   160\t\tswitch t {\r\n   161\t\tcase \"data-source\", \"transform\", \"split\", \"train\", \"evaluate\", \"register\", \"ensemble\":\r\n   162\t\t\treturn true\r\n   163\t\t}\r\n   164\t\treturn false\r\n   165\t}\r\n   166\t\r\n   167"]
[11915.938336, "o", "\tfunc (c *Config) Validate() (bool, []string) {\r\n   168\t\terrors := []string{}\r\n   169\t\tnames := map[string]bool{}\r\n   170\t\tfor i, s := range c.Stages {\r\n   171\t\t\tif s.Name == \"\" {\r\n   172\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage at index %d has empty name\", i))\r\n"]
[11915.938398, "o", "   173\t\t\t\tcontinue\r\n   174\t\t\t}\r\n   175\t\t\tif names[s.Name] {\r\n   176\t\t\t\terrors = append(errors, fmt.Sprintf(\"duplicate stage name: %s\", s.Name))\r\n   177\t\t\t}\r\n   178\t\t\tnames[s.Name] = true\r\n"]
[11915.938461, "o", "   179\t\t}\r\n   180\t\tfor _, s := range c.Stages {\r\n   181\t\t\tif !validStageType(s.Type) {\r\n   182\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q has unknown type %q\", s.Name, s.Type))\r\n   183\t\t\t}\r\n   184\t\t\tfor _, dep := range s.DependsOn {\r\n   185\t\t\t\tif !names[dep] {\r\n   186\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q references unknown dependency %q\", s.Name, dep))\r\n"]
[11915.938524, "o", "   187\t\t\t\t}\r\n   188\t\t\t}\r\n   189\t\t\tfor local, ref := range s.Inputs {\r\n   190\t\t\t\trefs, ok := inputRefs(ref)\r\n   191\t\t\t\tif !ok {\r\n   192\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %v\", s.Name, local, ref))\r\n   193\t\t\t\t\tcontinue\r\n   194\t\t\t\t}\r\n   195\t\t\t\tfor idx, r := range refs {\r\n   196\t\t\t\t\tif r == \"\" {\r\n"]
[11915.938586, "o", "   197\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q[%d] has invalid empty reference\", s.Name, local, idx))\r\n   198\t\t\t\t\t\tcontinue\r\n   199\t\t\t\t\t}\r\n   200\t\t\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n   201\t\t\t\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n   202\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %q\", s.Name, local, r))\r\n"]
[11915.938647, "o", "   203\t\t\t\t\t\tcontinue\r\n   204\t\t\t\t\t}\r\n   205\t\t\t\t\trefStage, ok := c.stageByName(parts[0])\r\n   206\t\t\t\t\tif !ok {\r\n   207\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown stage %q\", s.Name, local, parts[0]))\r\n   208\t\t\t\t\t\tcontinue\r\n   209\t\t\t\t\t}\r\n"]
[11915.938703, "o", "   210\t\t\t\t\tports := validOutputPorts(refStage.Type)\r\n   211\t\t\t\t\tvalid := false\r\n   212\t\t\t\t\tfor _, p := range ports {\r\n   213\t\t\t\t\t\tif p == parts[1] {\r\n   214\t\t\t\t\t\t\tvalid = true\r\n   215\t\t\t\t\t\t\tbreak\r\n"]
[11915.938768, "o", "   216\t\t\t\t\t\t}\r\n   217\t\t\t\t\t}\r\n   218\t\t\t\t\tif !valid {\r\n   219\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown output port %q on stage %q\", s.Name, local, parts[1], parts[0]))\r\n   220\t\t\t\t\t}\r\n"]
[11915.938829, "o", "   221\t\t\t\t}\r\n   222\t\t\t\tif s.Type == \"ensemble\" && local == \"models\" {\r\n   223\t\t\t\t\tif _, ok := ref.([]interface{}); !ok {\r\n   224\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q input %q must be an array\", s.Name, local))\r\n   225\t\t\t\t\t}\r\n   226\t\t\t\t}\r\n   227\t\t\t}\r\n   228\t\t\tif s.Type == \"ensemble\" {\r\n   229\t\t\t\tmodels, ok := s.Inputs[\"models\"]\r\n   230\t\t\t\tif !ok {\r\n   231\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires inputs.models\", s.Name))\r\n"]
[11915.93889, "o", "   232\t\t\t\t} else if refs, ok := inputRefs(models); !ok || len(refs) < 2 {\r\n   233\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires at least 2 model inputs\", s.Name))\r\n   234\t\t\t\t}\r\n   235\t\t\t\tif _, ok := s.Inputs[\"data\"]; !ok {\r\n   236\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires inputs.data\", s.Name))\r\n   237\t\t\t\t}\r\n   238\t\t\t\tstrategy, _ := getString(s.Params, \"strategy\")\r\n   239\t\t\t\tif strategy != \"vote\" && strategy != \"average\" {\r\n"]
[11915.938951, "o", "   240\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q has invalid strategy %q (must be vote or average)\", s.Name, strategy))\r\n   241\t\t\t\t}\r\n   242\t\t\t\tif _, ok := getString(s.Params, \"target\"); !ok {\r\n   243\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires target param\", s.Name))\r\n   244\t\t\t\t}\r\n   245\t\t\t}\r\n   246\t\t}\r\n   247\t\t"]
[11915.939019, "o", "if stages, cycle := c.detectCycle(); cycle {\r\n   248\t\t\terrors = append(errors, fmt.Sprintf(\"cycle detected involving stages: %s\", strings.Join(stages, \", \")))\r\n   249\t\t}\r\n   250\t\treturn len(errors) == 0, errors\r\n   251\t}\r\n   252\t"]
[11915.939081, "o", "\r\n   253\tfunc (c *Config) detectCycle() ([]string, bool) {\r\n   254\t\tadj := map[string][]string{}\r\n   255\t\tfor _, s := range c.Stages {\r\n   256\t\t\tadj[s.Name] = append(adj[s.Name], s.DependsOn...)\r\n   257\t\t}\r\n   258\t\tcolor := map[string]int{}\r\n   259\t\tvar stack []string\r\n   260\t\tvar cycle []string\r\n"]
[11915.939724, "o", "\u001b[?2004h"]
[11915.939785, "o", "root@n30009:/app# "]
