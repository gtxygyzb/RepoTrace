[12035.806746, "o", "   175\t\t\t\t\tif !reflect.DeepEqual(v1, v2) {\r\n   176\t\t\t\t\t\tdiff.InputsChanged[k] = FieldDiff{Old: v1, New: v2}\r\n   177\t\t"]
[12035.806798, "o", "\t\t\t}\r\n   178\t\t\t\t} else if ok1 {\r\n   179\t\t\t\t\tdiff.InputsChanged[k] = FieldDiff{Old: v1, New: nil}\r\n   180\t\t\t\t} else {\r\n   181\t\t\t\t\tdiff.InputsChanged[k] = FieldDiff{Old: nil, New: v2}\r\n   182\t\t\t\t}\r\n   183\t\t\t}\r\n   184\t\t\tif len(diff.InputsChanged) > 0 {\r\n   185\t\t\t\tchanged = true\r\n"]
[12035.806848, "o", "   186\t\t\t} else {\r\n   187\t\t\t\tdiff.InputsChanged = nil\r\n   188\t\t\t}\r\n   189\t\t}\r\n   190\t\r\n   191\t\tif !changed {\r\n"]
[12035.806895, "o", "   192\t\t\treturn nil\r\n   193\t\t}\r\n   194\t\treturn &diff\r\n   195\t}\r\n   196\t\r\n   197\tfunc sameStringList(a, b []string) bool {\r\n   198\t\tif len(a) != len(b) {\r\n   199\t\t"]
