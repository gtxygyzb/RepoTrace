[11387.392236, "o", "\u001b[35m\u001b[Kpipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"split\"\u001b[m\u001b[K:\r\n"]
[11387.392287, "o", "\u001b[35m\u001b[Kpipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"train\"\u001b[m\u001b[K:\r\n"]
