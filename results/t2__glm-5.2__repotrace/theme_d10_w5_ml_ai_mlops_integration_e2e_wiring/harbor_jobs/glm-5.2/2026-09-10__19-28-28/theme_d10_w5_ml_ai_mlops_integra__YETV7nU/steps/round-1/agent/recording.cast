[1942.877708, "o", "\u001b[?2004h> "]
[1942.878324, "o", "                errors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown output port %q on stage %q\", s.Name, local, parts[1], parts[0]))\r\n\u001b[?2004l\r"]
