[12076.621922, "o", "   301\tfunc (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {\r\n   302\t\tinputs := map[string]*ArtifactValue{}\r\n   303\t\tids := []string{}\r\n   304\t\tfor local, ref := range stage.Inputs {\r\n   305\t\t\trefs, ok := inputRefs(ref)\r\n   306\t\t\tif !ok {\r\n"]
[12076.62207, "o", "   307\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q has invalid reference %v\", stage.Name, local, ref)\r\n   308\t\t\t}\r\n   309\t\t\tvar firstVal *ArtifactValue\r\n   310\t\t\tfor _, r := range refs {\r\n   311\t\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n   312\t\t\t\tif len(parts) != 2 {\r\n   313\t\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q has invalid input reference %q\", stage.Name, r)\r\n   314\t\t\t\t}\r\n   315\t\t\t\tdepStage, port := parts[0], parts[1]\r\n   316\t\t\t\tid, ok := e.outputs[depStage][port]\r\n   317\t\t\t\tif !ok {\r\n   318\t\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable output %s.%s\", stage.Name, local, depStage, port)\r\n   319\t\t\t\t}\r\n   320\t\t\t\tval, ok := e.values[depStage][port]\r\n   321\t\t\t\tif !ok || val == nil {\r\n   322\t\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable artifact %s.%s\", stage.Name, local, depStage, port)\r\n   323\t\t\t\t}\r\n   324\t\t\t\tids = append(ids, id)\r\n   325\t\t\t\tif firstVal == nil {\r\n   326\t\t\t\t\tfirstVal = val\r\n   327\t\t\t\t}\r\n"]
[12076.622163, "o", "   328\t\t\t\tif stage.Type == \"ensemble\" && local == \"models\" {\r\n   329\t\t\t\t\tinputs[local+\"_\"+r] = val\r\n   330\t\t\t\t}\r\n   331\t\t\t}\r\n   332\t\t\tif _, exists := inputs[local]; !exists {\r\n   333\t\t\t\tinputs[local] = firstVal\r\n   334\t\t\t}\r\n   335\t\t}\r\n   336\t\treturn inputs, ids, nil\r\n   337\t}\r\n   338\t\r\n   339\t"]
[12076.622286, "o", "func executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n   340\t\tswitch stage.Type {\r\n   341\t\tcase \"data-source\":\r\n   342\t\t\treturn executeDataSource(stage, params, inputs)\r\n   343\t\tcase \"transform\":\r\n   344\t\t\treturn executeTransform(stage, params, inputs)\r\n   345\t\tcase \"split\":\r\n   346\t\t\treturn executeSplit(stage, params, inputs)\r\n   347\t\tcase \"train\":\r\n   348\t\t\treturn executeTrain(stage, params, inputs)\r\n   349\t\tcase \"evaluate\":\r\n   350\t\t\treturn executeEvaluate(stage, params, inputs)\r\n   351\t\tcase \"register\":\r\n"]
[12076.622355, "o", "   352\t\t\treturn executeRegister(stage, params, inputs)\r\n   353\t\tcase \"ensemble\":\r\n   354\t\t\treturn executeEnsemble(stage, params, inputs)\r\n   355\t\t}\r\n   356\t\treturn nil, fmt.Errorf(\"unknown stage type %q\", stage.Type)\r\n   357\t}\r\n   358\t\r\n   359\tfunc executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n"]
