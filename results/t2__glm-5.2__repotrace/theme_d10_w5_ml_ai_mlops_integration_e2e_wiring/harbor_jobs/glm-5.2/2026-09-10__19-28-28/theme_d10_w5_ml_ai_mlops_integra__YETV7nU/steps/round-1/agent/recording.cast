[1943.168002, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1943.168208, "o", "    if bestFeaturePos == -1 || bestGain <= 0 {\r\n\u001b[?2004l\r"]
[1943.168272, "o", "\u001b[?2004h> "]
[1943.168366, "o", "        node.IsLeaf = true\r\n\u001b[?2004l\r"]
[1943.16842, "o", "\u001b[?2004h> "]
[1943.168536, "o", "        node.Prediction = mean\r\n\u001b[?2004l\r"]
[1943.16859, "o", "\u001b[?2004h> "]
[1943.16869, "o", "        if classification {\r\n\u001b[?2004l\r"]
