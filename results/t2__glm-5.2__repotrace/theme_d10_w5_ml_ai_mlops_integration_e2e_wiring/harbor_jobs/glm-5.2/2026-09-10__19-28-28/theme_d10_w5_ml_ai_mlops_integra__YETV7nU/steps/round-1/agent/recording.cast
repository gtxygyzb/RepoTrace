[10944.701054, "o", "globals    map[string]interface{}\r\n    62\t\tstatus     map[string]string\r\n    63\t\tresults    map[string]*StageResult\r\n    64\t\toutputs    map[string]map[string]string\r\n    65\t\tvalues     map[string]map[string]*ArtifactValue\r\n    66\t\tmeta       map[string]*ArtifactMeta\r\n    67\t\tcacheKeys  map[string]string\r\n    68\t\tnoCache    bool\r\n    69\t\tcvFolds    int\r\n    70\t\tskipStages []string\r\n    71\t\tcacheStats *CacheStats\r\n    72\t}\r\n    73\t\r\n    74\tfunc NewExecutor(config *Config, overrides map[string]string) *Executor {\r\n    75\t\treturn &Executor{\r\n    76\t\t\tconfig:     config,\r\n    77\t\t\tglobals:    config.globalParams(overrides),\r\n    78\t\t\tstatus:     map[string]string{},\r\n    79\t\t\tresults:    map[string]*StageResult{},\r\n    80\t\t\toutputs:    map[string]map[string]string{},\r\n    81\t\t\tvalues:     map[string]map[string]*ArtifactValue{},\r\n    82\t\t\tmeta:       map[string]*ArtifactMeta{},\r\n    83\t\t\tcacheKeys:  map[string]string{},\r\n"]
