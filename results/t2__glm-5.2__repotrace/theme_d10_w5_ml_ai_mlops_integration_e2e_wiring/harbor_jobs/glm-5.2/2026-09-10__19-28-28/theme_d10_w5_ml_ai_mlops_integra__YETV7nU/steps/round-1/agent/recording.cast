[1827.637914, "o", "\t\t\t\tbestRightIdx = rightIdx\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif bestFeature == -1 || bestGain <= 0 {\r\n\t\tnode.IsLeaf = true\r\n\t\tnode.Prediction = mean\r\n\t\tif classification {\r\n\t\t\tnode.Probability = mean\r\n"]
