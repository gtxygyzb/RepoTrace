[8882.714111, "o", "}\r\n\r\nfunc (c *Config) detectCycle() ([]string, bool) {\r\n\tadj := map[string][]string{}\r\n\tfor _, s := range c.Stages {\r\n\t\tadj[s.Name] = append(adj[s.Name], s.DependsOn...)\r\n\t}\r\n\tcolor := map[string]int{}\r\n\tvar stack []string\r\n\tvar cycle []string\r\n"]
[8882.714261, "o", "\r\n\tvar dfs func(node string) bool\r\n\tdfs = func(node string) bool {\r\n\t\tif color[node] == 1 {\r\n\t\t\tidx := -1\r\n\t\t\tfor i, n := range stack {\r\n\t\t\t\tif n == node {\r\n\t\t\t\t\tidx = i\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif idx >= 0 {\r\n\t\t\t\tcycle = append([]string{}, stack[idx:]...)\r\n\t\t\t\tcycle = append(cycle, node)\r\n\t\t\t\tif len(cycle) > 1 && cycle[0] == cycle[len(cycle)-1] {\r\n\t\t\t\t\tcycle = cycle[:len(cycle)-1]\r\n\t\t\t\t}\r\n"]
[8882.714365, "o", "\t\t\t}\r\n\t\t\treturn true\r\n\t\t}\r\n\t\tif color[node] == 2 {\r\n\t\t\treturn false\r\n\t\t}\r\n\t\tcolor[node] = 1\r\n\t\tstack = append(stack, node)\r\n\t\tfor _, dep := range adj[node] {\r\n\t\t\tif _, ok := adj[dep]; ok {\r\n\t\t\t\tif dfs(dep) {\r\n\t\t\t\t\treturn true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tstack = stack[:len(stack)-1]\r\n"]
[8882.714459, "o", "\t\tcolor[node] = 2\r\n\t\treturn false\r\n\t}\r\n\r\n\tfor _, s := range c.Stages {\r\n\t\tif color[s.Name] == 0 {\r\n\t\t\tif dfs(s.Name) {\r\n\t\t\t\treturn cycle, true\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn nil, false\r\n}\r\n\r\nfunc getString(params map[string]interface{}, key string) (string, bool) {\r\n\tv, ok := params[key]\r\n\tif !ok {\r\n\t\treturn \"\", false\r\n"]
