[8887.67749, "o", "   127\tfunc validStageType(t string) bool {\r\n   128\t\tswitch t {\r\n   129\t\tcase \"data-source\", \"transform\", \"split\", \"train\", \"evaluate\", \"register\":\r\n   130\t\t\treturn true\r\n   131\t\t}\r\n   132\t\treturn false\r\n   133\t}\r\n   134\t\r\n   135\tfunc (c *Config) Validate() (bool, []string) {\r\n   136\t\terrors := []string{}\r\n   137\t\tnames := map[string]bool{}\r\n   138\t\tfor i, s := range c.Stages {\r\n"]
[8887.677575, "o", "   139\t\t\tif s.Name == \"\" {\r\n   140\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage at index %d has empty name\", i))\r\n   141\t\t\t\tcontinue\r\n   142\t\t\t}\r\n   143\t\t\tif names[s.Name] {\r\n   144\t\t\t\terrors = append(errors, fmt.Sprintf(\"duplicate stage name: %s\", s.Name))\r\n   145\t\t\t}\r\n   146\t\t\tnames[s.Name] = true\r\n   147\t\t}\r\n   148\t\tfor _, s := range c.Stages {\r\n"]
[8887.677654, "o", "   149\t\t\tif !validStageType(s.Type) {\r\n   150\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q has unknown type %q\", s.Name, s.Type))\r\n   151\t\t\t}\r\n   152\t\t\tfor _, dep := range s.DependsOn {\r\n   153\t\t\t\tif !names[dep] {\r\n   154\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q references unknown dependency %q\", s.Name, dep))\r\n   155\t\t\t\t}\r\n   156\t\t\t}\r\n   157\t\t\tfor local, ref := range s.Inputs {\r\n   158\t\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n   159\t\t\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n   160\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %q\", s.Name, local, ref))\r\n"]
[8887.677731, "o", "   161\t\t\t\t\tcontinue\r\n   162\t\t\t\t}\r\n   163\t\t\t\trefStage, ok := c.stageByName(parts[0])\r\n   164\t\t\t\tif !ok {\r\n   165\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown stage %q\", s.Name, local, parts[0]))\r\n   166\t\t\t\t\tcontinue\r\n   167\t\t\t\t}\r\n   168\t\t\t\tports := validOutputPorts(refStage.Type)\r\n   169\t\t\t\tvalid := false\r\n   170\t\t\t\tfor _, p := range ports {\r\n"]
[8887.677804, "o", "   171\t\t\t\t\tif p == parts[1] {\r\n   172\t\t\t\t\t\tvalid = true\r\n   173\t\t\t\t\t\tbreak\r\n   174\t\t\t\t\t}\r\n   175\t\t\t\t}\r\n   176\t\t\t\tif !valid {\r\n   177\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown output port %q on stage %q\", s.Name, local, parts[1], parts[0]))\r\n   178\t\t\t\t}\r\n   179\t\t\t}\r\n"]
[8887.677874, "o", "   180\t\t}\r\n   181\t\tif stages, cycle := c.detectCycle(); cycle {\r\n   182\t\t\terrors = append(errors, fmt.Sprintf(\"cycle detected involving stages: %s\", strings.Join(stages, \", \")))\r\n   183\t\t}\r\n   184\t\treturn len(errors) == 0, errors\r\n   185\t}\r\n"]
