[1784.2951, "o", "\t}\r\n\r\n\tif bestFeature == -1 || bestGain <= 0 {\r\n\t\tnode.IsLeaf = true\r\n\t\tnode.Prediction = mean\r\n\t\tif classification {\r\n\t\t\tnode.Probability = mean\r\n\t\t}\r\n\t\treturn node\r\n\t}\r\n\r\n\tnode.Feature = bestFeature\r\n\tnode.Threshold = bestThreshold\r\n\tleftX := subsetRows(X, bestLeftIdx)\r\n\trightX := subsetRows(X, bestRightIdx)\r\n\tnode.Left = trainDecisionTree(leftX, subsetY(y, bestLeftIdx), features, classification, depth+1, maxDepth, minSplit)\r\n\tnode.Right = trainDecisionTree(rightX, subsetY(y, bestRightIdx), features, classification, depth+1, maxDepth, minSplit)\r\n\t"]
