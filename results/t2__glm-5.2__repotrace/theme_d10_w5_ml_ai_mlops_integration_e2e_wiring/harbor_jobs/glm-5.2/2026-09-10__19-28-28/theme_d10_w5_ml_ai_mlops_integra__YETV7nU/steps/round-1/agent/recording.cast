[8908.861198, "o", "\r\n     8\t\t\"strconv\"\r\n     9\t\t\"strings\"\r\n    10\t)\r\n    11\t\r\n    12\ttype Dataset struct {\r\n    13\t\tColumns []string   `json:\"columns\"`\r\n    14\t\tTypes   []string   `json:\"types\"`\r\n    15\t\tRows    [][]string `json:\"rows\"`\r\n    16\t}\r\n    17\t\r\n    18\tfunc loadDataset(path string, schema map[string]interface{}) (*Dataset, error) {\r\n    19\t\tf, err := os.Open(path)\r\n    20\t\tif err != nil {\r\n"]
[8908.861291, "o", "    21\t\t\tif os.IsNotExist(err) {\r\n    22\t\t\t\treturn nil, fmt.Errorf(\"file not found: %s\", path)\r\n    23\t\t\t}\r\n    24\t\t\treturn nil, err\r\n    25\t"]
[8908.861366, "o", "\t}\r\n    26\t\tdefer f.Close()\r\n    27\t\r\n    28\t\tr := csv.NewReader(f)\r\n    29\t\trecords, err := r.ReadAll()\r\n    30\t\tif err != nil {\r\n    31\t\t\treturn nil, err\r\n    32\t\t}\r\n    33\t\tif len(records) == 0 {\r\n    34\t\t\treturn &Dataset{Columns: []string{}, Types: []string{}, Rows: [][]string{}}, nil\r\n    35\t\t}\r\n    36\t\r\n    37\t\theader := records[0]\r\n    38\t\trows := records[1:]\r\n    39\t\tcolumns := header\r\n    40\t\ttypes := make([]string, len(columns))\r\n"]
[8908.861448, "o", "    41\t\tfor i, col := range columns {\r\n    42\t\t\tif schemaType, ok := schema[col]; ok {\r\n    43\t\t\t\ttypes[i] = fmt.Sprintf(\"%v\", schemaType)\r\n    44\t\t\t} else {\r\n    45\t\t\t\ttypes[i] = inferColumnType(rows, i)\r\n    46\t\t\t}\r\n    47\t\t}\r\n    48\t\treturn &Dataset{Columns: columns, Types: types, Rows: rows}, nil\r\n    49\t}\r\n    50\t\r\n    51\tfunc inferColumnType(rows [][]string, idx int) string {\r\n    52\t\tfor _, row := range rows {\r\n"]
[8908.861518, "o", "    53\t\t\tif idx >= len(row) {\r\n    54\t\t\t\tcontinue\r\n    55\t\t\t}\r\n    56\t\t\tval := strings.TrimSpace(row[idx])\r\n    57\t\t\tif val == \"\" {\r\n    58\t\t\t\tcontinue\r\n    59\t\t\t}\r\n    60\t\t\tif _, ok := parseFloat64(val); !ok {\r\n    61\t\t\t\treturn \"categorical\"\r\n"]
[8908.861588, "o", "    62\t\t\t}\r\n    63\t\t}\r\n    64\t\treturn \"numeric\"\r\n    65\t}\r\n    66\t\r\n    67\tfunc parseFloat64(s string) (float64, bool) {\r\n    68\t\ts = strings.TrimSpace(s)\r\n    69\t\tif s == \"\" {\r\n    70\t\t\treturn 0, false\r\n    71\t\t}\r\n    72\t\tf, err := strconv.ParseFloat(s, 64)\r\n    73\t"]
[8908.861657, "o", "\tif err != nil {\r\n    74\t\t\treturn 0, false\r\n    75\t\t}\r\n    76\t\treturn f, true\r\n    77\t}\r\n    78\t\r\n    79\tfunc formatFloat(f float64) string {\r\n    80\t\tif math.IsNaN(f) {\r\n    81\t\t\treturn \"NaN\"\r\n"]
[8908.861727, "o", "    82\t\t}\r\n    83\t\tif math.IsInf(f, 1) {\r\n    84\t\t\treturn \"+Inf\"\r\n    85\t\t}\r\n    86\t\tif math.IsInf(f, -1) {\r\n    87\t\t\treturn \"-Inf\"\r\n    88\t\t}\r\n    89\t\treturn strconv.FormatFloat(f, 'g', -1, 64)\r\n"]
[8908.861793, "o", "    90\t}\r\n    91\t\r\n    92\tfunc (ds *Dataset) ColumnIndex(name string) (int, bool) {\r\n    93\t\tfor i, c := range ds.Columns {\r\n    94\t\t\tif c == name {\r\n    95\t\t\t\treturn i, true\r\n    96\t\t\t}\r\n    97\t\t}\r\n    98\t\treturn -1, false\r\n    99\t}\r\n   100\t\r\n"]
[8908.861859, "o", "   101\tfunc (ds *Dataset) Copy() *Dataset {\r\n   102\t\tcols := append([]string{}, ds.Columns...)\r\n   103\t\ttypes := append([]string{}, ds.Types...)\r\n   104\t\trows := make([][]string, len(ds.Rows))\r\n   105\t\tfor i, row := range ds.Rows {\r\n   106\t\t\trows[i] = append([]string{}, row...)\r\n   107\t\t}\r\n   108\t\treturn &Dataset{Columns: cols, Types: types, Rows: rows}\r\n"]
[8908.861938, "o", "   109\t}\r\n   110\t\r\n   111\tfunc (ds *Dataset) Summary() map[string]interface{} {\r\n   112\t\treturn map[string]interface{}{\r\n   113\t\t\t\"rows\":         len(ds.Rows),\r\n   114\t\t\t\"columns\":      len(ds.Columns),\r\n   115\t\t\t\"column_names\": ds.Columns,\r\n   116\t\t\t\"column_types\": ds.Types,\r\n   117\t\t}\r\n   118\t}\r\n   119\t\r\n   120\tfunc (ds *Dataset) NumericColumn(name string) ([]float64, error) {\r\n   121\t\tidx, ok := ds.ColumnIndex(name)\r\n   122\t\t"]
[8908.862005, "o", "if !ok {\r\n   123\t\t\treturn nil, fmt.Errorf(\"column not found: %s\", name)\r\n   124\t\t}\r\n   125\t\tif idx < len(ds.Types) && ds.Types[idx] != \"numeric\" {\r\n   126\t\t\treturn nil, fmt.Errorf(\"column is not numeric: %s\", name)\r\n   127\t\t}\r\n   128\t\tvals := make([]float64, len(ds.Rows))\r\n   129\t\tfor i, row := range ds.Rows {\r\n   130\t\t\tif idx >= len(row) {\r\n"]
