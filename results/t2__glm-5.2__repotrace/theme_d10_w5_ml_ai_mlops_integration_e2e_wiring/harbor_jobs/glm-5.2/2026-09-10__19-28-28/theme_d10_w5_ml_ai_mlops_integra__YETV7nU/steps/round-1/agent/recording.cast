[10639.947068, "o", "\u001b[?2004h> "]
[10639.947125, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h"]
[10639.94718, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10639.94724, "o", "> "]
[10639.947437, "o", "\\tname, version, ok := splitNameVersion(positionals[0])\r\n\u001b[?2004l\r"]
[10639.947493, "o", "\u001b[?2004h> "]
[10639.94756, "o", "\\tif !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10639.947754, "o", "\\t\\tprintError(\"invalid name:version format\")\r\n\u001b[?2004l\r"]
[10639.947809, "o", "\u001b[?2004h> "]
[10639.947868, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10639.947926, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10639.947981, "o", "> "]
