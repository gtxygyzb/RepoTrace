[4863.775644, "o", "\u001b[?2004h> "]
[4863.77582, "o", "        cmdLineage(args)\r\n\u001b[?2004l\r"]
[4863.775877, "o", "\u001b[?2004h> "]
[4863.775975, "o", "    default:\r\n\u001b[?2004l\r"]
