[8920.84568, "o", "\ttype ArtifactOutput struct {\r\n    32\t\tStage   string                 `json:\"stage\"`\r\n    33\t\tPort    string                 `json:\"port\"`\r\n    34\t\tType    string                 `json:\"type\"`\r\n    35\t\tSummary map[string]interface{} `json:\"summary\"`\r\n    36\t}\r\n    37\t\r\n    38\ttype StageResult struct {\r\n    39\t"]
[8920.845759, "o", "\tStatus     string            `json:\"status\"`\r\n    40\t\tCacheHit   bool              `json:\"cache_hit,omitempty\"`\r\n    41\t\tDurationMs int64             `json:\"duration_ms\"`\r\n    42\t\tOutputs    map[string]string `json:\"outputs\"`\r\n    43\t\tError      string            `json:\"error,omitempty\"`\r\n    44\t}\r\n    45\t\r\n    46\ttype RunOutput struct {\r\n    47\t\tPipeline   string                     `json:\"pipeline\"`\r\n    48\t\tStatus     string                     `json:\"status\"`\r\n    49\t\tStages     map[string]*StageResult    `json:\"stages\"`\r\n    50\t\tArtifacts  map[string]*ArtifactOutput `json:\"artifacts\"`\r\n    51\t\tCacheStats *CacheStats                `json:\"cache_stats,omitempty\"`\r\n    52\t}\r\n    53\t\r\n    54\ttype CacheStats struct {\r\n"]
