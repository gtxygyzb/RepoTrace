[10352.449506, "o", "\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KprintError\u001b[m\u001b[K(fmt.Sprintf(\"unknown registry command: %s\", sub))\r\n\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KprintError\u001b[m\u001b[K(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KprintError\u001b[m\u001b[K(err.Error())\r\n"]
[10352.449554, "o", "\u001b[32m\u001b[K213\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KprintError\u001b[m\u001b[K(\"usage: mlpipe registry info <name>:<version>\")\r\n\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KprintError\u001b[m\u001b[K(\"invalid name:version format\")\r\n\u001b[32m\u001b[K223\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KprintError\u001b[m\u001b[K(err.Error())\r\n"]
