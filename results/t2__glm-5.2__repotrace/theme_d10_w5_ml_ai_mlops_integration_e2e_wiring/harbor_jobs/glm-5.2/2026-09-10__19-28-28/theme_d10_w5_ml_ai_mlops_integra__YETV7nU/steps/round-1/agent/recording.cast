[8900.932626, "o", "   236\tfunc (e *Executor) inputCacheKeys(stage *StageConfig) map[string]string {\r\n   237\t\tkeys := map[string]string{}\r\n   238\t\tfor local, ref := range stage.Inputs {\r\n   239\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n   240\t\t\tif len(parts) != 2 {\r\n   241\t\t\t\tcontinue\r\n"]
[8900.932726, "o", "   242\t\t\t}\r\n   243\t\t\tdepStage := parts[0]\r\n   244\t\t\tif key, ok := e.cacheKeys[depStage]; ok {\r\n   245\t\t\t\tkeys[local] = key\r\n   246\t\t\t}\r\n   247\t\t}\r\n   248\t\treturn keys\r\n   249\t}\r\n   250\t\r\n   251\tfunc (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {\r\n   252\t\tinputs := map[string]*ArtifactValue{}\r\n   253\t\tids := []string{}\r\n   254\t\tfor local, ref := range stage.Inputs {\r\n   255\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n   256\t\t\tif len(parts) != 2 {\r\n"]
[8900.932803, "o", "   257\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q has invalid input reference %q\", stage.Name, ref)\r\n   258\t\t\t}\r\n   259\t\t\tdepStage, port := parts[0], parts[1]\r\n   260\t\t\tid, ok := e.outputs[depStage][port]\r\n   261\t\t\tif !ok {\r\n   262\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable output %s.%s\", stage.Name, local, depStage, port)\r\n   263\t\t\t}\r\n   264\t\t\tval, ok := e.values[depStage][port]\r\n   265\t\t\tif !ok || val == nil {\r\n   266\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable artifact %s.%s\", stage.Name, local, depStage, port)\r\n"]
[8900.932932, "o", "   267\t\t\t}\r\n   268\t\t\tinputs[local] = val\r\n   269\t\t\tids = append(ids, id)\r\n   270\t\t}\r\n   271\t\treturn inputs, ids, nil\r\n   272\t}\r\n   273\t\r\n   274\tfunc executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n   275\t\tswitch stage.Type {\r\n   276\t\tcase \"data-source\":\r\n   277\t\t\treturn executeDataSource(stage, params, inputs)\r\n   278\t\tcase \"transform\":\r\n   279\t\t\treturn executeTransform(stage, params, inputs)\r\n   280\t\tcase \"split\":\r\n   281\t\t\treturn executeSplit(stage, params, inputs)\r\n   282\t\tcase \"train\":\r\n   283\t\t\treturn executeTrain(stage, params, inputs)\r\n   284\t\tcase \"evaluate\":\r\n   285\t\t\treturn executeEvaluate(stage, params, inputs)\r\n   286\t\tcase \"register\":\r\n   287\t\t\treturn executeRegister(stage, params, inputs)\r\n   288\t\t}\r\n   289\t\treturn nil, fmt.Errorf(\"unknown stage type %q\", stage.Type)\r\n   290\t}\r\n"]
[8900.933038, "o", "   291\t\r\n   292\tfunc executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n   293\t\tpath, ok := getString(params, \"path\")\r\n   294\t\tif !ok {\r\n   295\t\t\treturn nil, fmt.Errorf(\"data-source stage %q requires path\", stage.Name)\r\n   296\t\t}\r\n   297\t\tschema, _ := getMap(params, \"schema\")\r\n   298\t\tds, err := loadDataset(path, schema)\r\n   299\t\tif err != nil {\r\n   300\t\t\treturn nil, err\r\n"]
