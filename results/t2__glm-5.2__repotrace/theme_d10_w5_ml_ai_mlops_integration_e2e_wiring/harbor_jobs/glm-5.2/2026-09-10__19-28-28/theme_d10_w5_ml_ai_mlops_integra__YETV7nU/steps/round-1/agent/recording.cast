[7656.900398, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('evaluate.go')\nlines = p.read_text().splitlines(True)\nout = []\ni = 0\nwhile i < len(lines):\n    # R2 block\n    if (i + 2 < len(lines)\n            and lines[i].strip() == 'if ssTot == 0 {'\n            and lines[i+1].strip() == 'return 0.0, nil'\n            and lines[i+2].strip() == '}'):\n        indent = '\\t\\t\\t'\n        out.append(indent + 'if ssTot == 0 {\\n')\n        out.append(indent + '\\tif ssRes == 0 {\\n')\n        out.append(indent + '\\t\\treturn 1.0, nil\\n')\n        out.append(indent + '\\t}\\n')\n        out.append(indent + '\\treturn nil, nil\\n')\n        out.append(indent + '}\\n')\n        i += 3\n        continue\n    # MAPE block\n    if (i + 2 < len(lines)\n            and lines[i].strip() == 'if count == 0 {'\n            and lines[i+1].strip() == 'return 0.0, nil'\n            and lines[i+2].strip() == '}'):\n        indent = '\\t\\t\\t'\n        out.append(indent + 'if count == 0 {\\n')\n        out.append(indent + '\\treturn nil, nil\\n')\n        out.append(indent +"]
[7656.900631, "i", " '}\\n')\n        i += 3\n        continue\n    out.append(lines[i])\n    i += 1\n\np.write_text(''.join(out))\nPY\n"]
[7656.900712, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r '}\\n')\r\n        i += 3\r\n        continue\r\n    out.append(lines[i])\r\n    i += 1\r\n\r\np.write_text(''.join(out))\r\nPY\r\n"]
