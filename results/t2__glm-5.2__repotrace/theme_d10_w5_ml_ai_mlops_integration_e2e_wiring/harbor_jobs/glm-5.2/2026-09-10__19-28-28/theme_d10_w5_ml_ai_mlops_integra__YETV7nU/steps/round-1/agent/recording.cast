[1943.1575, "o", "\u001b[?2004h> "]
[1943.157887, "o", "    if depth >= maxDepth || len(y) < minSplit || len(featureIdx) == 0 {\r\n\u001b[?2004l\r"]
[1943.157948, "o", "\u001b[?2004h> "]
[1943.158096, "o", "        node.IsLeaf = true\r\n\u001b[?2004l\r"]
[1943.158156, "o", "\u001b[?2004h> "]
[1943.158334, "o", "        node.Prediction = mean\r\n\u001b[?2004l\r"]
[1943.158405, "o", "\u001b[?2004h> "]
[1943.158546, "o", "        if classification {\r\n\u001b[?2004l\r"]
[1943.158606, "o", "\u001b[?2004h> "]
[1943.158802, "o", "            node.Probability = mean\r\n\u001b[?2004l\r"]
[1943.158856, "o", "\u001b[?2004h> "]
[1943.158911, "o", "        }\r\n\u001b[?2004l\r"]
[1943.15897, "o", "\u001b[?2004h> "]
[1943.159086, "o", "        return node\r\n\u001b[?2004l\r"]
[1943.15914, "o", "\u001b[?2004h> "]
[1943.159194, "o", "    }\r\n\u001b[?2004l\r"]
[1943.159262, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1943.159316, "o", "> "]
[1943.159411, "o", "    bestGain := 0.0\r\n\u001b[?2004l\r"]
[1943.159465, "o", "\u001b[?2004h> "]
[1943.159606, "o", "    bestFeaturePos := -1\r\n\u001b[?2004l\r"]
