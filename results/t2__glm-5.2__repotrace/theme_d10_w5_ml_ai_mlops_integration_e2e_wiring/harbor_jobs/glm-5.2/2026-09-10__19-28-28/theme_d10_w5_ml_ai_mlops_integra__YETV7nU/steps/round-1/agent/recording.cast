[5326.205259, "o", "\u001b[?2004h> "]
[5326.205316, "o", "    }\r\n\u001b[?2004l\r"]
[5326.205372, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5326.205431, "o", "\u001b[?2004h> "]
[5326.20571, "o", "    cvMetrics := map[string]CVMetricAgg{}\r\n\u001b[?2004l\r"]
[5326.205765, "o", "\u001b[?2004h> "]
