[1827.950133, "o", "\tif classification {\r\n\t\tp := 0.0\r\n\t\tfor _, v := range y {\r\n\t\t\tp += v\r\n\t\t}\r\n\t\tp /= float64(len(y))\r\n\t\tif p <= 0 {\r\n\t\t\tp = 1e-15\r\n\t\t}\r\n\t\tif p >= 1 {\r\n\t\t\tp = 1 - 1e-15\r\n"]
[1827.950203, "o", "\t\t}\r\n\t\tinit = math.Log(p / (1 - p))\r\n\t} else {\r\n\t\tfor _, v := range y {\r\n\t\t\tinit += v\r\n\t\t}\r\n\t\tinit /= float64(len(y))\r\n\t}\r\n\r\n\tcurrent := make([]float64, len(y))\r\n"]
