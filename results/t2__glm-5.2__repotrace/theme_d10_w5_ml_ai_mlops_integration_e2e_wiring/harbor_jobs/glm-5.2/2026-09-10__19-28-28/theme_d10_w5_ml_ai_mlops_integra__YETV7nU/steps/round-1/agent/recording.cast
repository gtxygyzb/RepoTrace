[11951.90178, "o", "\tfor name := range fm {\r\n   165\t\t\t\tmetricNames[name] = true\r\n   166\t\t\t}\r\n   167\t\t}\r\n   168\t\tfor name := range metricNames {\r\n   169\t\t\tperFold := make([]float64, e.cvFolds)\r\n   170\t\t\tsum := 0.0\r\n   171\t\t\tcount := 0\r\n   172\t\t\tfor i, fm := range foldMetrics {\r\n   173\t\t\t\tif v, ok := fm[name]; ok {\r\n   174\t\t\t\t\tperFold[i] = v\r\n   175\t\t\t\t\tsum += v\r\n"]
