[1142.867344, "o", "\u001b[?2004h> "]
[1142.867493, "o", "    Tree *TreeNode\r\n\u001b[?2004l\r"]
[1142.867556, "o", "\u001b[?2004h> "]
[1142.867716, "o", "    Forest []*TreeNode\r\n\u001b[?2004l\r"]
[1142.867769, "o", "\u001b[?2004h> "]
[1142.867955, "o", "    Boost []*BoostedTree\r\n\u001b[?2004l\r"]
[1142.868016, "o", "\u001b[?2004h> "]
[1142.868139, "o", "    KNN *KNNModel\r\n\u001b[?2004l\r"]
[1142.8682, "o", "\u001b[?2004h> "]
[1142.868419, "o", "    TrainFeatures [][]float64\r\n\u001b[?2004l\r"]
[1142.868476, "o", "\u001b[?2004h> "]
[1142.868665, "o", "    TrainTarget []float64\r\n\u001b[?2004l\r"]
[1142.868722, "o", "\u001b[?2004h> }"]
[1142.868778, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1142.868833, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1142.868888, "o", "> "]
[1142.869047, "o", "type TreeNode struct {\r\n\u001b[?2004l\r"]
[1142.869101, "o", "\u001b[?2004h"]
[1142.869162, "o", "> "]
[1142.869299, "o", "    IsLeaf bool\r\n\u001b[?2004l\r"]
[1142.869368, "o", "\u001b[?2004h> "]
[1142.869533, "o", "    Prediction float64\r\n\u001b[?2004l\r"]
[1142.869588, "o", "\u001b[?2004h> "]
[1142.869754, "o", "    Probability float64\r\n\u001b[?2004l\r"]
[1142.869818, "o", "\u001b[?2004h> "]
[1142.869928, "o", "    Feature int\r\n\u001b[?2004l\r"]
[1142.869988, "o", "\u001b[?2004h> "]
[1142.870146, "o", "    Threshold float64\r\n\u001b[?2004l\r"]
[1142.870201, "o", "\u001b[?2004h> "]
[1142.870349, "o", "    Left *TreeNode\r\n\u001b[?2004l\r"]
[1142.87038, "o", "\u001b[?2004h"]
[1142.870459, "o", "> "]
[1142.870542, "o", "    Right *TreeNode\r\n\u001b[?2004l\r"]
[1142.870589, "o", "\u001b[?2004h> "]
[1142.870644, "o", "}\r\n\u001b[?2004l\r"]
[1142.870699, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1142.870755, "o", "\u001b[?2004h> "]
[1142.870919, "o", "type BoostedTree struct {\r\n\u001b[?2004l\r"]
[1142.870967, "o", "\u001b[?2004h> "]
[1142.871111, "o", "    Tree *TreeNode\r\n\u001b[?2004l\r"]
[1142.871166, "o", "\u001b[?2004h> "]
[1142.871361, "o", "    LearningRate float64\r\n\u001b[?2004l\r"]
[1142.87142, "o", "\u001b[?2004h> "]
[1142.87161, "o", "    InitPrediction float64\r\n\u001b[?2004l\r"]
[1142.871665, "o", "\u001b[?2004h> "]
[1142.871722, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.871777, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.871832, "o", "> "]
[1142.871958, "o", "type KNNModel struct {\r\n\u001b[?2004l\r"]
[1142.872013, "o", "\u001b[?2004h> "]
[1142.872084, "o", "    K int\r\n\u001b[?2004l\r"]
[1142.872144, "o", "\u001b[?2004h> "]
[1142.872333, "o", "    Features [][]float64\r\n\u001b[?2004l\r"]
[1142.87239, "o", "\u001b[?2004h> "]
[1142.87255, "o", "    Targets []float64\r\n\u001b[?2004l\r"]
[1142.872605, "o", "\u001b[?2004h> "]
[1142.872766, "o", "    Classification bool\r\n\u001b[?2004l\r"]
[1142.872813, "o", "\u001b[?2004h> "]
[1142.872868, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.872923, "o", "> \r\n\u001b[?2004l\r"]
[1142.872979, "o", "\u001b[?2004h> "]
[1142.873904, "o", "func executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\u001b[?2004l\r"]
[1142.873968, "o", "\u001b[?2004h> "]
[1142.874105, "o", "    var ds *Dataset\r\n\u001b[?2004l\r"]
[1142.874161, "o", "\u001b[?2004h> "]
[1142.874401, "o", "    for _, in := range inputs {\r\n\u001b[?2004l\r"]
[1142.874458, "o", "\u001b[?2004h> "]
[1142.874756, "o", "        if in != nil && in.Dataset != nil {\r\n\u001b[?2004l\r"]
[1142.874821, "o", "\u001b[?2004h> "]
[1142.87501, "o", "            ds = in.Dataset\r\n\u001b[?2004l\r"]
[1142.875065, "o", "\u001b[?2004h> "]
[1142.875196, "o", "            break\r\n\u001b[?2004l\r"]
[1142.875258, "o", "\u001b[?2004h> "]
[1142.875337, "o", "        }\r\n\u001b[?2004l\r"]
[1142.875396, "o", "\u001b[?2004h> "]
[1142.875439, "o", "    }\r\n\u001b[?2004l\r"]
[1142.875497, "o", "\u001b[?2004h> "]
[1142.875624, "o", "    if ds == nil {\r\n\u001b[?2004l\r"]
[1142.875685, "o", "\u001b[?2004h> "]
[1142.876242, "o", "        return nil, fmt.Errorf(\"train stage %q requires input data\", stage.Name)\r\n\u001b[?2004l\r"]
[1142.876291, "o", "\u001b[?2004h"]
[1142.876346, "o", ">     }\r\n"]
[1142.876404, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1142.876457, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1142.876517, "o", "> "]
[1142.876833, "o", "    algorithm, ok := getString(params, \"algorithm\")\r\n\u001b[?2004l\r"]
[1142.876889, "o", "\u001b[?2004h> "]
[1142.876988, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[1142.877047, "o", "\u001b[?2004h> "]
[1142.877596, "o", "        return nil, fmt.Errorf(\"train stage %q requires algorithm\", stage.Name)\r\n\u001b[?2004l\r"]
[1142.877656, "o", "\u001b[?2004h> "]
[1142.877731, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.877815, "o", "> "]
[1142.902375, "o", "    target, ok := getString(params, \"target\")\r\n\u001b[?2004l\r\u001b[?2004h>     if !ok {\r\n\u001b[?2004l\r\u001b[?2004h>         return nil, fmt.Errorf(\"train stage %q requires target\", stage.Name)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     targetVals, err := ds.NumericColumn(target)\r\n\u001b[?2004l\r\u001b[?2004h>     if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>         return nil, err\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     classification := isBinary01(targetVals)\r\n\u001b[?2004l\r\u001b[?2004h>     if algorithm == \"linear-regression\" {\r\n\u001b[?2004l\r\u001b[?2004h>         classification = false\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if algorithm == \"logistic-regression\" {\r\n\u001b[?2004l\r\u001b[?2004h>         classification = true\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     features, ok := getStringSlice(params, \"features\")\r\n\u001b[?2004l\r\u001b[?2004h>     if !ok || len(features) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         features = []string{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.902577, "o", "        for i, col := range ds.Columns {\r\n\u001b[?2004l\r"]
[1142.902647, "o", "\u001b[?2004h> "]
[1142.902869, "o", "            if col == target {\r\n\u001b[?2004l\r"]
[1142.902926, "o", "\u001b[?2004h> "]
[1142.903108, "o", "                continue\r\n\u001b[?2004l\r"]
[1142.903163, "o", "\u001b[?2004h> "]
[1142.903273, "o", "            }\r\n\u001b[?2004l\r"]
[1142.903329, "o", "\u001b[?2004h> "]
[1142.90375, "o", "            if i < len(ds.Types) && ds.Types[i] == \"numeric\" {\r\n\u001b[?2004l\r"]
[1142.903805, "o", "\u001b[?2004h> "]
[1142.904137, "o", "                features = append(features, col)\r\n\u001b[?2004l\r"]
[1142.904193, "o", "\u001b[?2004h> "]
[1142.904305, "o", "            }\r\n\u001b[?2004l\r"]
[1142.904363, "o", "\u001b[?2004h> "]
[1142.904437, "o", "        }\r\n\u001b[?2004l\r"]
[1142.904493, "o", "\u001b[?2004h> "]
[1142.90456, "o", "    }\r\n\u001b[?2004l\r"]
[1142.904614, "o", "\u001b[?2004h> "]
[1142.904879, "o", "    X, err := ds.featureMatrix(features)\r\n\u001b[?2004l\r"]
[1142.904933, "o", "\u001b[?2004h> "]
[1142.905074, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1142.905128, "o", "\u001b[?2004h> "]
[1142.905304, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1142.905361, "o", "\u001b[?2004h> "]
[1142.905419, "o", "    }\r\n\u001b[?2004l\r"]
[1142.905474, "o", "\u001b[?2004h> "]
[1142.905592, "o", "    y := targetVals\r\n\u001b[?2004l\r"]
[1142.905657, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1142.905716, "o", "\u001b[?2004h> "]
[1142.906204, "o", "    hp := getMapDefault(params, \"hyperparams\", map[string]interface{}{})\r\n\u001b[?2004l\r"]
[1142.906269, "o", "\u001b[?2004h> "]
[1142.907342, "o", "    model := &Model{Algorithm: algorithm, Target: target, Features: features, Hyperparams: hp, Classification: classification, TrainFeatures: X, TrainTarget: y}\r\n\u001b[?2004l\r"]
[1142.907415, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1142.907471, "o", "\u001b[?2004h> "]
[1142.90763, "o", "    switch algorithm {\r\n\u001b[?2004l\r"]
[1142.907712, "o", "\u001b[?2004h> "]
[1142.90789, "o", "    case \"linear-regression\":\r\n\u001b[?2004l\r"]
[1142.907945, "o", "\u001b[?2004h> "]
[1142.908266, "o", "        w, err := trainLinearRegression(X, y)\r\n\u001b[?2004l\r"]
[1142.908322, "o", "\u001b[?2004h> "]
[1142.908508, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[1142.908566, "o", "\u001b[?2004h> "]
[1142.908759, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[1142.908808, "o", "\u001b[?2004h> "]
[1142.908895, "o", "        }\r\n\u001b[?2004l\r"]
[1142.90895, "o", "\u001b[?2004h> "]
[1142.909165, "o", "        model.LinearWeights = w\r\n\u001b[?2004l\r"]
[1142.90923, "o", "\u001b[?2004h> "]
[1142.909446, "o", "    case \"logistic-regression\":\r\n\u001b[?2004l\r"]
[1142.909493, "o", "\u001b[?2004h> "]
[1142.909889, "o", "        lr := getFloatDefault(hp, \"learning_rate\", 0.01)\r\n\u001b[?2004l\r"]
[1142.909946, "o", "\u001b[?2004h> "]
[1142.910309, "o", "        epochs := getIntDefault(hp, \"epochs\", 1000)\r\n\u001b[?2004l\r"]
[1142.910365, "o", "\u001b[?2004h> "]
[1142.910771, "o", "        w, err := trainLogisticRegression(X, y, lr, epochs)\r\n\u001b[?2004l\r"]
[1142.910828, "o", "\u001b[?2004h> "]
[1142.910993, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[1142.911048, "o", "\u001b[?2004h> "]
[1142.911247, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[1142.911303, "o", "\u001b[?2004h> "]
[1142.911383, "o", "        }\r\n\u001b[?2004l\r"]
[1142.91144, "o", "\u001b[?2004h> "]
[1142.911665, "o", "        model.LogisticWeights = w\r\n\u001b[?2004l\r"]
[1142.911722, "o", "\u001b[?2004h> "]
[1142.911897, "o", "    case \"decision-tree\":\r\n\u001b[?2004l\r"]
[1142.911956, "o", "\u001b[?2004h> "]
[1142.912347, "o", "        maxDepth := getIntDefault(hp, \"max_depth\", 10)\r\n\u001b[?2004l\r"]
[1142.912405, "o", "\u001b[?2004h"]
[1142.912466, "o", "> "]
[1142.912817, "o", "        minSplit := getIntDefault(hp, \"min_samples_split\", 2)\r\n\u001b[?2004l\r"]
[1142.912873, "o", "\u001b[?2004h> "]
[1142.913552, "o", "        model.Tree = trainDecisionTree(X, y, features, classification, 0, maxDepth, minSplit)\r\n\u001b[?2004l\r"]
[1142.913615, "o", "\u001b[?2004h> "]
[1142.913794, "o", "    case \"random-forest\":\r\n\u001b[?2004l\r"]
[1142.913851, "o", "\u001b[?2004h> "]
[1142.91421, "o", "        nEst := getIntDefault(hp, \"n_estimators\", 10)\r\n\u001b[?2004l\r"]
[1142.914276, "o", "\u001b[?2004h> "]
[1142.914642, "o", "        maxDepth := getIntDefault(hp, \"max_depth\", 10)\r\n\u001b[?2004l\r"]
[1142.914698, "o", "\u001b[?2004h> "]
[1142.915152, "o", "        maxFeatures := getStringDefault(hp, \"max_features\", \"sqrt\")\r\n\u001b[?2004l\r"]
[1142.915207, "o", "\u001b[?2004h> "]
[1142.915962, "o", "        model.Forest = trainRandomForest(X, y, features, classification, nEst, maxDepth, maxFeatures, stage.Name)\r\n\u001b[?2004l\r"]
[1142.916031, "o", "\u001b[?2004h> "]
[1142.916206, "o", "    case \"gradient-boost\":\r\n\u001b[?2004l\r"]
[1142.916272, "o", "\u001b[?2004h> "]
[1142.916651, "o", "        nEst := getIntDefault(hp, \"n_estimators\", 100)\r\n\u001b[?2004l\r"]
[1142.916708, "o", "\u001b[?2004h> "]
[1142.91709, "o", "        lr := getFloatDefault(hp, \"learning_rate\", 0.1)\r\n\u001b[?2004l\r"]
[1142.917147, "o", "\u001b[?2004h> "]
[1142.917515, "o", "        maxDepth := getIntDefault(hp, \"max_depth\", 3)\r\n\u001b[?2004l\r"]
[1142.917572, "o", "\u001b[?2004h> "]
[1142.918123, "o", "        model.Boost = trainGradientBoost(X, y, classification, nEst, lr, maxDepth)\r\n\u001b[?2004l\r"]
[1142.918181, "o", "\u001b[?2004h> "]
[1142.918309, "o", "    case \"knn\":\r\n\u001b[?2004l\r"]
[1142.918366, "o", "\u001b[?2004h> "]
[1142.91863, "o", "        k := getIntDefault(hp, \"k\", 5)\r\n\u001b[?2004l\r"]
[1142.918686, "o", "\u001b[?2004h> "]
[1142.918824, "o", "        if k <= 0 {\r\n\u001b[?2004l\r"]
[1142.918877, "o", "\u001b[?2004h> "]
[1142.919006, "o", "            k = 1\r\n\u001b[?2004l\r"]
[1142.919066, "o", "\u001b[?2004h> "]
[1142.919146, "o", "        }\r\n\u001b[?2004l\r"]
[1142.919202, "o", "\u001b[?2004h> "]
[1142.919827, "o", "        model.KNN = &KNNModel{K: k, Features: X, Targets: y, Classification: classification}\r\n\u001b[?2004l\r"]
[1142.919885, "o", "\u001b[?2004h> "]
[1142.919977, "o", "    default:\r\n\u001b[?2004l\r"]
[1142.920033, "o", "\u001b[?2004h> "]
[1142.920517, "o", "        return nil, fmt.Errorf(\"unsupported algorithm: %s\", algorithm)\r\n\u001b[?2004l\r"]
[1142.920573, "o", "\u001b[?2004h> "]
[1142.92063, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.920685, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.920884, "o", "    preds := model.PredictBatch(X)\r\n\u001b[?2004l\r"]
[1142.920938, "o", "\u001b[?2004h> "]
[1142.921186, "o", "    predRows := make([][]string, len(ds.Rows))\r\n\u001b[?2004l\r"]
[1142.921252, "o", "\u001b[?2004h> "]
[1142.921369, "o", "    for i := range ds.Rows {\r\n\u001b[?2004l\r"]
[1142.921426, "o", "\u001b[?2004h> "]
[1142.921656, "o", "        row := append([]string{}, ds.Rows[i]...)\r\n\u001b[?2004l\r"]
[1142.921712, "o", "\u001b[?2004h> "]
[1142.921956, "o", "        row = append(row, formatFloat(preds[i]))\r\n\u001b[?2004l\r"]
[1142.922012, "o", "\u001b[?2004h> "]
[1142.922141, "o", "        predRows[i] = row\r\n\u001b[?2004l\r"]
[1142.922196, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1142.92226, "o", "\u001b[?2004h> "]
[1142.922383, "o", "    predDS := &Dataset{\r\n\u001b[?2004l\r"]
[1142.92244, "o", "\u001b[?2004h> "]
[1142.922797, "o", "        Columns: append(append([]string{}, ds.Columns...), \"prediction\"),\r\n\u001b[?2004l\r"]
[1142.922854, "o", "\u001b[?2004h> "]
[1142.92319, "o", "        Types: append(append([]string{}, ds.Types...), \"numeric\"),\r\n\u001b[?2004l\r"]
[1142.923261, "o", "\u001b[?2004h> "]
[1142.923351, "o", "        Rows: predRows,\r\n\u001b[?2004l\r"]
[1142.923407, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1142.923476, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.923533, "o", "> "]
[1142.924025, "o", "    return map[string]*ArtifactValue{\"model\": {Model: model}, \"predictions\": {Dataset: predDS}}, nil\r\n\u001b[?2004l\r"]
[1142.924081, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1142.924136, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.92419, "o", "> "]
[1142.92437, "o", "func isBinary01(vals []float64) bool {\r\n\u001b[?2004l\r"]
[1142.924425, "o", "\u001b[?2004h> "]
[1142.924567, "o", "    for _, v := range vals {\r\n\u001b[?2004l\r"]
[1142.924626, "o", "\u001b[?2004h> "]
[1142.924749, "o", "        if v != 0 && v != 1 {\r\n\u001b[?2004l\r"]
[1142.924806, "o", "\u001b[?2004h> "]
[1142.924907, "o", "            return false\r\n\u001b[?2004l\r"]
[1142.924962, "o", "\u001b[?2004h> "]
[1142.925018, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.925073, "o", ">     }\r\n\u001b[?2004l\r"]
[1142.925128, "o", "\u001b[?2004h> "]
[1142.92519, "o", "    return true\r\n\u001b[?2004l\r"]
[1142.925256, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1142.925312, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.925968, "o", "func getMapDefault(params map[string]interface{}, key string, def map[string]interface{}) map[string]interface{} {\r\n\u001b[?2004l\r"]
[1142.926023, "o", "\u001b[?2004h> "]
[1142.92621, "o", "    if v, ok := getMap(params, key); ok {\r\n\u001b[?2004l\r"]
[1142.92627, "o", "\u001b[?2004h> "]
[1142.926337, "o", "        return v\r\n\u001b[?2004l\r"]
[1142.926391, "o", "\u001b[?2004h> "]
[1142.92645, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.92653, "o", "    return def\r\n\u001b[?2004l\r"]
[1142.926584, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1142.926644, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[1142.927114, "o", "func getStringDefault(params map[string]interface{}, key string, def string) string {\r\n\u001b[?2004l\r"]
[1142.927169, "o", "\u001b[?2004h> "]
[1142.927383, "o", "    if v, ok := getString(params, key); ok {\r\n\u001b[?2004l\r"]
[1142.927438, "o", "\u001b[?2004h> "]
[1142.927508, "o", "        return v\r\n\u001b[?2004l\r"]
[1142.927562, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1142.927636, "o", "\u001b[?2004h> "]
[1142.927712, "o", "    return def\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.927772, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1142.92783, "o", "\u001b[?2004h> "]
[1142.928236, "o", "func trainLinearRegression(X [][]float64, y []float64) ([]float64, error) {\r\n\u001b[?2004l\r"]
[1142.928291, "o", "\u001b[?2004h> "]
[1142.928345, "o", "    n := len(X)\r\n\u001b[?2004l\r"]
[1142.928399, "o", "\u001b[?2004h> "]
[1142.928471, "o", "    if n == 0 {\r\n\u001b[?2004l\r"]
[1142.928526, "o", "\u001b[?2004h> "]
[1142.928772, "o", "        return nil, fmt.Errorf(\"no training data\")\r\n\u001b[?2004l\r"]
[1142.928826, "o", "\u001b[?2004h>     }\r\n"]
[1142.928883, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1142.928972, "o", "    m := len(X[0])\r\n\u001b[?2004l\r"]
[1142.929027, "o", "\u001b[?2004h> "]
[1142.92919, "o", "    // design matrix with bias\r\n\u001b[?2004l\r"]
[1142.929251, "o", "\u001b[?2004h> "]
[1142.929393, "o", "    A := make([][]float64, n)\r\n\u001b[?2004l\r"]
[1142.929448, "o", "\u001b[?2004h> "]
[1142.929551, "o", "    for i := range X {\r\n\u001b[?2004l\r"]
[1142.929605, "o", "\u001b[?2004h> "]
[1142.929818, "o", "        A[i] = append([]float64{1}, X[i]...)\r\n\u001b[?2004l\r"]
[1142.929873, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1142.929929, "o", "\u001b[?2004h> "]
[1142.930154, "o", "    // normal equation: w = (A^T A)^-1 A^T y\r\n\u001b[?2004l\r"]
[1142.930207, "o", "\u001b[?2004h> "]
[1142.930371, "o", "    AtA := make([][]float64, m+1)\r\n\u001b[?2004l\r"]
[1142.930428, "o", "\u001b[?2004h> "]
[1142.930539, "o", "    for i := range AtA {\r\n\u001b[?2004l\r"]
[1142.930594, "o", "\u001b[?2004h> "]
[1142.930778, "o", "        AtA[i] = make([]float64, m+1)\r\n\u001b[?2004l\r"]
[1142.930835, "o", "\u001b[?2004h> "]
[1142.930894, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.931067, "o", "    AtY := make([]float64, m+1)\r\n\u001b[?2004l\r"]
[1142.931123, "o", "\u001b[?2004h> "]
[1142.931243, "o", "    for i := 0; i < n; i++ {\r\n\u001b[?2004l\r"]
[1142.931298, "o", "\u001b[?2004h> "]
[1142.931437, "o", "        for a := 0; a <= m; a++ {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.931494, "o", "> "]
[1142.931581, "o", "            AtY[a] += A[i][a] * y[i]\r\n\u001b[?2004l\r"]
[1142.931648, "o", "\u001b[?2004h> "]
[1142.931738, "o", "            for b := 0; b <= m; b++ {\r\n\u001b[?2004l\r"]
[1142.931793, "o", "\u001b[?2004h> "]
[1142.931921, "o", "                AtA[a][b] += A[i][a] * A[i][b]\r\n\u001b[?2004l\r"]
[1142.931975, "o", "\u001b[?2004h> "]
[1142.932029, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.932084, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.932133, "o", "    }\r\n\u001b[?2004l\r \u001b[?2004h"]
[1142.932188, "o", "> "]
[1142.932267, "o", "    inv, err := invertMatrix(AtA)\r\n\u001b[?2004l\r"]
[1142.932321, "o", "\u001b[?2004h> "]
[1142.932371, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1142.932424, "o", "\u001b[?2004h> "]
[1142.932486, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1142.93254, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\rL"]
[1142.932606, "o", "\u001b[?2004h> "]
[1142.932678, "o", "    w := make([]float64, m+1)\r\n\u001b[?2004l\r \u001b[?2004h"]
[1142.932732, "o", "> "]
[1142.932807, "o", "    for a := 0; a <= m; a++ {\r\n\u001b[?2004l\r"]
[1142.93286, "o", "\u001b[?2004h> "]
[1142.932956, "o", "        for b := 0; b <= m; b++ {\r\n\u001b[?2004l\r"]
[1142.933009, "o", "\u001b[?2004h> "]
[1142.93312, "o", "            w[a] += inv[a][b] * AtY[b]\r\n\u001b[?2004l\r"]
[1142.933179, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1142.933244, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1142.933303, "o", "\u001b[?2004h> "]
[1142.933362, "o", "    return w, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1142.933415, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h> "]
[1142.933607, "o", "func invertMatrix(m [][]float64) ([][]float64, error) {\r\n\u001b[?2004l\r"]
[1142.933661, "o", "\u001b[?2004h> "]
[1142.933715, "o", "    n := len(m)\r\n\u001b[?2004l\ri\u001b[?2004h> "]
[1142.933818, "o", "    a := make([][]float64, n)\r\n\u001b[?2004l\r"]
[1142.933872, "o", "\u001b[?2004h> "]
[1142.93393, "o", "    for i := range m {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.933984, "o", "> "]
[1142.93411, "o", "        a[i] = append([]float64{}, m[i]...)\r\n\u001b[?2004l\rl"]
[1142.934164, "o", "\u001b[?2004h> "]
[1142.934315, "o", "        a[i] = append(a[i], make([]float64, n)...)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.934371, "o", "> "]
[1142.934442, "o", "        a[i][n+i] = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.934498, "o", "    }\r\n\u001b[?2004l\rR\u001b[?2004h> "]
[1142.934595, "o", "    for i := 0; i < n; i++ {\r\n\u001b[?2004l\re\u001b[?2004h"]
[1142.934651, "o", "> "]
[1142.934717, "o", "        pivot := a[i][i]\r\n\u001b[?2004l\r"]
[1142.934771, "o", "\u001b[?2004h> "]
[1142.934868, "o", "        if math.Abs(pivot) < 1e-12 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.934922, "o", "> "]
[1142.934994, "o", "            // try pivot swap\r\n\u001b[?2004l\r,"]
[1142.935054, "o", "\u001b[?2004h> "]
[1142.935105, "o", "            swap := -1\r\n\u001b[?2004l\r"]
[1142.93516, "o", "\u001b[?2004h> "]
[1142.935287, "o", "            for r := i + 1; r < n; r++ {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.935344, "o", "> "]
[1142.935468, "o", "                if math.Abs(a[r][i]) > 1e-12 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.935523, "o", "> "]
[1142.935587, "o", "                    swap = r\r\n\u001b[?2004l\r"]
[1142.935643, "o", "\u001b[?2004h> "]
[1142.935708, "o", "                    break\r\n\u001b[?2004l\r"]
[1142.935764, "o", "\u001b[?2004h> "]
[1142.935819, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.935879, "o", "            }\r\n\u001b[?2004l\r"]
[1142.935933, "o", "\u001b[?2004h> "]
[1142.935999, "o", "            if swap == -1 {\r\n\u001b[?2004l\r"]
[1142.936053, "o", "\u001b[?2004h> "]
[1142.936249, "o", "                return nil, fmt.Errorf(\"matrix not invertible\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.936302, "o", "> "]
[1142.936357, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.936503, "o", "            a[i], a[swap] = a[swap], a[i]\r\n\u001b[?2004l\r"]
[1142.936557, "o", "\u001b[?2004h> "]
[1142.936621, "o", "            pivot = a[i][i]\r\n\u001b[?2004l\r"]
[1142.936676, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r]+"]
[1142.936734, "o", "\u001b[?2004h> "]
[1142.936826, "o", "        for j := 0; j < 2*n; j++ {\r\n\u001b[?2004l\r"]
[1142.93688, "o", "\u001b[?2004h> "]
[1142.936966, "o", "            a[i][j] /= pivot\r\n\u001b[?2004l\r"]
[1142.937021, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r "]
[1142.937079, "o", "\u001b[?2004h> "]
[1142.937166, "o", "        for r := 0; r < n; r++ {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.937229, "o", "> "]
[1142.937286, "o", "            if r == i {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.93734, "o", "> "]
[1142.937389, "o", "                continue\r\n\u001b[?2004l\r"]
[1142.937444, "o", "\u001b[?2004h> "]
[1142.937498, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.937595, "o", "            factor := a[r][i]\r\n\u001b[?2004l\r"]
[1142.937651, "o", "\u001b[?2004h> "]
[1142.937759, "o", "            for j := 0; j < 2*n; j++ {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.937815, "o", "> "]
[1142.937936, "o", "                a[r][j] -= factor * a[i][j]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.93799, "o", ">             }\r\n\u001b[?2004l\r"]
[1142.938049, "o", "\u001b[?2004h> "]
[1142.938102, "o", "        }\r\n\u001b[?2004l\r  \u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1142.938157, "o", "\u001b[?2004h> "]
[1142.938248, "o", "    inv := make([][]float64, n)\r\n\u001b[?2004l\r"]
[1142.938303, "o", "\u001b[?2004h> "]
[1142.938363, "o", "    for i := range inv {\r\n\u001b[?2004l\ro\u001b[?2004h"]
[1142.938417, "o", "> "]
[1142.938512, "o", "        inv[i] = make([]float64, n)\r\n\u001b[?2004l\re\u001b[?2004h"]
[1142.938565, "o", "> "]
[1142.938644, "o", "        copy(inv[i], a[i][n:])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.938698, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.938757, "o", "> "]
[1142.938816, "o", "    return inv, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1142.938876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.939222, "o", "func trainLogisticRegression(X [][]float64, y []float64, lr float64, epochs int) ([]float64, error) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.939282, "o", "> "]
[1142.939337, "o", "    n := len(X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.939404, "o", "    if n == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.939586, "o", "        return nil, fmt.Errorf(\"no training data\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.939641, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.939706, "o", "> "]
[1142.93976, "o", "    m := len(X[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.939857, "o", "    w := make([]float64, m+1)\r\n\u001b[?2004l\rq\u001b[?2004h"]
[1142.939911, "o", "> "]
[1142.940001, "o", "    for e := 0; e < epochs; e++ {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.940056, "o", "> "]
[1142.940157, "o", "        grad := make([]float64, m+1)\r\n\u001b[?2004l\r"]
[1142.940212, "o", "\u001b[?2004h> "]
[1142.940305, "o", "        for i := 0; i < n; i++ {\r\n\u001b[?2004l\r"]
[1142.940359, "o", "\u001b[?2004h> "]
[1142.940411, "o", "            z := w[0]\r\n\u001b[?2004l\r"]
[1142.940465, "o", "\u001b[?2004h> "]
[1142.940562, "o", "            for j := 0; j < m; j++ {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.940616, "o", "> "]
[1142.940713, "o", "                z += w[j+1] * X[i][j]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.940767, "o", "> "]
[1142.94082, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.002358, "o", "            p := 1 / (1 + math.Exp(-z))\r\n\u001b[?2004l\r\u001b[?2004h>             err := p - y[i]\r\n\u001b[?2004l\r\u001b[?2004h>             grad[0] += err\r\n\u001b[?2004l\r\u001b[?2004h>             for j := 0; j < m; j++ {\r\n\u001b[?2004l\r\u001b[?2004h>                 grad[j+1] += err * X[i][j]\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         for j := range w {\r\n\u001b[?2004l\r\u001b[?2004h>             w[j] -= lr * grad[j] / float64(n)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return w, nil\r\n\u001b[?2004l\rm(\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func trainDecisionTree(X [][]float64, y []float64, features []string, classification bool, depth, maxDepth, minSplit int) *TreeNode {\r\n\u001b[?2004l\r\u001b[?2004h>     node := &TreeNode{}\r\n\u001b[?2004l\r\u001b[?2004h>     if len(y) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         node.IsLeaf = true\r\n\u001b[?2004l\r\u001b[?2004h>         return node\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     mean := 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     for _, v := range y {\r\n\u001b[?2004l\r\u001b[?2004h>"]
[1143.002525, "o", "         mean += v\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     mean /= float64(len(y))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.00293, "o", "    if depth >= maxDepth || len(y) < minSplit || len(features) == 0 {\r\n\u001b[?2004l\r"]
[1143.003002, "o", "\u001b[?2004h> "]
[1143.003181, "o", "        node.IsLeaf = true\r\n\u001b[?2004l\r"]
[1143.003254, "o", "\u001b[?2004h> "]
[1143.003486, "o", "        node.Prediction = mean\r\n\u001b[?2004l\r"]
[1143.003545, "o", "\u001b[?2004h> "]
[1143.003733, "o", "        if classification {\r\n\u001b[?2004l\r"]
[1143.003789, "o", "\u001b[?2004h> "]
[1143.004041, "o", "            node.Probability = mean\r\n\u001b[?2004l\r"]
[1143.004101, "o", "\u001b[?2004h> "]
[1143.004175, "o", "        }\r\n\u001b[?2004l\r"]
[1143.00426, "o", "\u001b[?2004h> "]
[1143.004383, "o", "        return node\r\n\u001b[?2004l\r"]
[1143.004441, "o", "\u001b[?2004h> "]
[1143.004506, "o", "    }\r\n\u001b[?2004l\r"]
[1143.004562, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1143.004618, "o", "\u001b[?2004h> "]
[1143.004734, "o", "    bestGain := 0.0\r\n\u001b[?2004l\r"]
[1143.004794, "o", "\u001b[?2004h> "]
[1143.004953, "o", "    bestFeature := -1\r\n\u001b[?2004l\r"]
[1143.005008, "o", "\u001b[?2004h> "]
[1143.005177, "o", "    bestThreshold := 0.0\r\n\u001b[?2004l\r"]
[1143.005252, "o", "\u001b[?2004h> "]
[1143.005462, "o", "    bestLeftIdx := []int(nil)\r\n\u001b[?2004l\r"]
[1143.00552, "o", "\u001b[?2004h> "]
[1143.005732, "o", "    bestRightIdx := []int(nil)\r\n\u001b[?2004l\r"]
[1143.005788, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1143.005859, "o", "\u001b[?2004h> "]
[1143.006252, "o", "    impurity := giniOrVariance(y, classification)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.006535, "o", "    for j := 0; j < len(features); j++ {\r\n\u001b[?2004l\r"]
[1143.006605, "o", "\u001b[?2004h> "]
[1143.00687, "o", "        values := make([]float64, len(X))\r\n\u001b[?2004l\r"]
[1143.006927, "o", "\u001b[?2004h> "]
[1143.007179, "o", "        for i := 0; i < len(X); i++ {\r\n\u001b[?2004l\r"]
[1143.007245, "o", "\u001b[?2004h> "]
[1143.007467, "o", "            values[i] = X[i][j]\r\n\u001b[?2004l\r"]
[1143.007526, "o", "\u001b[?2004h> "]
[1143.007586, "o", "        }\r\n\u001b[?2004l\r"]
[1143.007656, "o", "\u001b[?2004h> "]
[1143.007908, "o", "        sorted := uniqueFloats(values)\r\n\u001b[?2004l\r"]
[1143.007967, "o", "\u001b[?2004h> "]
[1143.008163, "o", "        sort.Float64s(sorted)\r\n\u001b[?2004l\r"]
[1143.008232, "o", "\u001b[?2004h> "]
[1143.008536, "o", "        for s := 0; s < len(sorted)-1; s++ {\r\n\u001b[?2004l\r"]
[1143.008593, "o", "\u001b[?2004h> "]
[1143.008971, "o", "            threshold := (sorted[s] + sorted[s+1]) / 2\r\n\u001b[?2004l\r"]
[1143.009029, "o", "\u001b[?2004h> "]
[1143.00925, "o", "            leftIdx := []int{}\r\n\u001b[?2004l\r"]
[1143.009307, "o", "\u001b[?2004h> "]
[1143.009525, "o", "            rightIdx := []int{}\r\n\u001b[?2004l\r"]
[1143.009575, "o", "\u001b[?2004h"]
[1143.009633, "o", "> "]
[1143.009889, "o", "            for i := 0; i < len(X); i++ {\r\n\u001b[?2004l\r"]
[1143.009947, "o", "\u001b[?2004h> "]
[1143.010232, "o", "                if X[i][j] <= threshold {\r\n\u001b[?2004l\r"]
[1143.010292, "o", "\u001b[?2004h> "]
[1143.01063, "o", "                    leftIdx = append(leftIdx, i)\r\n\u001b[?2004l\r"]
[1143.010686, "o", "\u001b[?2004h> "]
[1143.010856, "o", "                } else {\r\n\u001b[?2004l\r"]
[1143.010922, "o", "\u001b[?2004h> "]
[1143.011272, "o", "                    rightIdx = append(rightIdx, i)\r\n\u001b[?2004l\r"]
[1143.011343, "o", "\u001b[?2004h> "]
[1143.011453, "o", "                }\r\n\u001b[?2004l\r"]
[1143.011514, "o", "\u001b[?2004h> "]
[1143.01162, "o", "            }\r\n\u001b[?2004l\r"]
[1143.011665, "o", "\u001b[?2004h> "]
[1143.012064, "o", "            if len(leftIdx) == 0 || len(rightIdx) == 0 {\r\n\u001b[?2004l\r"]
[1143.012119, "o", "\u001b[?2004h> "]
[1143.012293, "o", "                continue\r\n\u001b[?2004l\r"]
[1143.012359, "o", "\u001b[?2004h> "]
[1143.012457, "o", "            }\r\n\u001b[?2004l\r"]
[1143.012517, "o", "\u001b[?2004h> "]
[1143.012794, "o", "            leftY := subsetY(y, leftIdx)\r\n\u001b[?2004l\r"]
[1143.012852, "o", "\u001b[?2004h> "]
[1143.013142, "o", "            rightY := subsetY(y, rightIdx)\r\n\u001b[?2004l\r"]
[1143.013203, "o", "\u001b[?2004h"]
[1143.013269, "o", "> "]
[1143.013642, "o", "            leftImp := giniOrVariance(leftY, classification)\r\n\u001b[?2004l\r"]
[1143.013699, "o", "\u001b[?2004h> "]
[1143.014124, "o", "            rightImp := giniOrVariance(rightY, classification)\r\n\u001b[?2004l\r"]
[1143.014179, "o", "\u001b[?2004h> "]
[1143.014858, "o", "            gain := impurity - (float64(len(leftY))*leftImp+float64(len(rightY))*rightImp)/float64(len(y))\r\n\u001b[?2004l\r"]
[1143.014918, "o", "\u001b[?2004h> "]
[1143.015069, "o", "            if gain > bestGain {\r\n\u001b[?2004l\r"]
[1143.015125, "o", "\u001b[?2004h> "]
[1143.015288, "o", "                bestGain = gain\r\n\u001b[?2004l\r"]
[1143.015343, "o", "\u001b[?2004h> "]
[1143.015503, "o", "                bestFeature = j\r\n\u001b[?2004l\r"]
[1143.015558, "o", "\u001b[?2004h> "]
[1143.015778, "o", "                bestThreshold = threshold\r\n\u001b[?2004l\r"]
[1143.015833, "o", "\u001b[?2004h> "]
[1143.016016, "o", "                bestLeftIdx = leftIdx\r\n\u001b[?2004l\r"]
[1143.016072, "o", "\u001b[?2004h> "]
[1143.016269, "o", "                bestRightIdx = rightIdx\r\n\u001b[?2004l\r"]
[1143.016324, "o", "\u001b[?2004h"]
[1143.016379, "o", "> "]
[1143.016435, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.016507, "o", "        }\r\n\u001b[?2004l\r"]
[1143.016562, "o", "\u001b[?2004h> "]
[1143.016616, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1143.016675, "o", "\u001b[?2004h> "]
[1143.016895, "o", "    if bestFeature == -1 || bestGain <= 0 {\r\n\u001b[?2004l\r"]
[1143.016958, "o", "\u001b[?2004h> "]
[1143.0171, "o", "        node.IsLeaf = true\r\n\u001b[?2004l\r"]
[1143.017154, "o", "\u001b[?2004h> "]
[1143.017323, "o", "        node.Prediction = mean\r\n\u001b[?2004l\r"]
[1143.017381, "o", "\u001b[?2004h> "]
[1143.017522, "o", "        if classification {\r\n\u001b[?2004l\r"]
[1143.01759, "o", "\u001b[?2004h> "]
[1143.01777, "o", "            node.Probability = mean\r\n\u001b[?2004l\r"]
[1143.017826, "o", "\u001b[?2004h> "]
[1143.01789, "o", "        }\r\n\u001b[?2004l\r"]
[1143.017945, "o", "\u001b[?2004h> "]
[1143.018044, "o", "        return node\r\n\u001b[?2004l\r"]
[1143.0181, "o", "\u001b[?2004h> "]
[1143.018154, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rc"]
[1143.018208, "o", "\u001b[?2004h> "]
[1143.018371, "o", "    node.Feature = bestFeature\r\n\u001b[?2004l\r"]
[1143.018425, "o", "\u001b[?2004h> "]
[1143.018622, "o", "    node.Threshold = bestThreshold\r\n\u001b[?2004l\r"]
[1143.018676, "o", "\u001b[?2004h> "]
[1143.018903, "o", "    leftX := subsetRows(X, bestLeftIdx)\r\n\u001b[?2004l\r"]
[1143.01896, "o", "\u001b[?2004h> "]
[1143.019168, "o", "    rightX := subsetRows(X, bestRightIdx)\r\n\u001b[?2004l\r"]
[1143.019233, "o", "\u001b[?2004h> "]
[1143.019842, "o", "    node.Left = trainDecisionTree(leftX, subsetY(y, bestLeftIdx), features, classification, depth+1, maxDepth, minSplit)\r\n\u001b[?2004l\r"]
[1143.0199, "o", "\u001b[?2004h> "]
[1143.020593, "o", "    node.Right = trainDecisionTree(rightX, subsetY(y, bestRightIdx), features, classification, depth+1, maxDepth, minSplit)\r\n\u001b[?2004l\r"]
[1143.020658, "o", "\u001b[?2004h> "]
[1143.020713, "o", "    return node\r\n\u001b[?2004l\r"]
[1143.02077, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1143.020838, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r:\u001b[?2004h"]
[1143.020898, "o", "> "]
[1143.021252, "o", "func giniOrVariance(y []float64, classification bool) float64 {\r\n\u001b[?2004l\r"]
[1143.021309, "o", "\u001b[?2004h> "]
[1143.021409, "o", "    if len(y) == 0 {\r\n\u001b[?2004l\r"]
[1143.021463, "o", "\u001b[?2004h> "]
[1143.021546, "o", "        return 0\r\n\u001b[?2004l\r"]
[1143.0216, "o", "\u001b[?2004h> "]
[1143.021657, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.021811, "o", "    if classification {\r\n\u001b[?2004l\r"]
[1143.021865, "o", "\u001b[?2004h> "]
[1143.022043, "o", "        counts := map[float64]int{}\r\n\u001b[?2004l\r"]
[1143.022097, "o", "\u001b[?2004h> "]
[1143.022269, "o", "        for _, v := range y {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1143.022348, "o", "> "]
[1143.022433, "o", "            counts[v]++\r\n\u001b[?2004l\r"]
[1143.022489, "o", "\u001b[?2004h> "]
[1143.022545, "o", "        }\r\n\u001b[?2004l\r"]
[1143.0226, "o", "\u001b[?2004h> "]
[1143.022681, "o", "        g := 1.0\r\n\u001b[?2004l\r"]
[1143.022736, "o", "\u001b[?2004h> "]
[1143.022916, "o", "        for _, c := range counts {\r\n\u001b[?2004l\r"]
[1143.022971, "o", "\u001b[?2004h> "]
[1143.023209, "o", "            p := float64(c) / float64(len(y))\r\n\u001b[?2004l\r"]
[1143.023273, "o", "\u001b[?2004h> "]
[1143.023387, "o", "            g -= p * p\r\n\u001b[?2004l\r"]
[1143.023442, "o", "\u001b[?2004h> "]
[1143.023496, "o", "        }\r\n\u001b[?2004l\r"]
[1143.023551, "o", "\u001b[?2004h> "]
[1143.023634, "o", "        return g\r\n\u001b[?2004l\r"]
[1143.023691, "o", "\u001b[?2004h> "]
[1143.023751, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1143.023805, "o", "> "]
[1143.023864, "o", "    mean := 0.0\r\n\u001b[?2004l\r"]
[1143.023919, "o", "\u001b[?2004h> "]
[1143.024049, "o", "    for _, v := range y {\r\n\u001b[?2004l\r"]
[1143.024103, "o", "\u001b[?2004h> "]
[1143.024203, "o", "        mean += v\r\n\u001b[?2004l\r"]
[1143.024271, "o", "\u001b[?2004h>     }"]
[1143.024327, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.024491, "o", "    mean /= float64(len(y))\r\n\u001b[?2004l\r"]
[1143.024546, "o", "\u001b[?2004h> "]
[1143.02462, "o", "    sum := 0.0\r\n\u001b[?2004l\r"]
[1143.024674, "o", "\u001b[?2004h> "]
[1143.024823, "o", "    for _, v := range y {\r\n\u001b[?2004l\r"]
[1143.024877, "o", "\u001b[?2004h> "]
[1143.024935, "o", "        d := v - mean\r\n\u001b[?2004l\r"]
[1143.024989, "o", "\u001b[?2004h> "]
[1143.025051, "o", "        sum += d * d\r\n\u001b[?2004l\r"]
[1143.025105, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r "]
[1143.025159, "o", "\u001b[?2004h> "]
[1143.025277, "o", "    return sum / float64(len(y))\r\n\u001b[?2004l\r"]
[1143.025333, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1143.0254, "o", " \u001b[?2004h> "]
[1143.02601, "o", "func trainRandomForest(X [][]float64, y []float64, features []string, classification bool, nEst, maxDepth int, maxFeatures string, stageName string) []*TreeNode {\r\n\u001b[?2004l\r"]
[1143.026073, "o", "\u001b[?2004h> "]
[1143.026152, "o", "    forest := []*TreeNode{}\r\n\u001b[?2004l\r"]
[1143.026206, "o", "\u001b[?2004h> "]
[1143.026415, "o", "    rng := rand.New(rand.NewSource(int64(nEst * 12345)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1143.026446, "o", "> "]
[1143.026525, "o", "    m := len(features)\r\n\u001b[?2004l\r"]
[1143.026582, "o", "\u001b[?2004h> "]
[1143.026639, "o", "    mf := m\r\n\u001b[?2004l\re\u001b[?2004h> "]
[1143.026735, "o", "    switch maxFeatures {\r\n\u001b[?2004l\r"]
[1143.026791, "o", "\u001b[?2004h> "]
[1143.026855, "o", "    case \"sqrt\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[1143.026909, "o", "> "]
[1143.027025, "o", "        mf = int(math.Sqrt(float64(m)))\r\n\u001b[?2004l\r"]
[1143.027079, "o", "\u001b[?2004h> "]
[1143.027137, "o", "    case \"log2\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.027339, "o", "        mf = int(math.Log2(float64(m)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.027416, "o", "    case \"all\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.027495, "o", "        mf = m\r\n\u001b[?2004l\r "]
[1143.027549, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1143.027631, "o", "\u001b[?2004h> "]
[1143.0277, "o", "    if mf < 1 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.027753, "o", "        mf = 1\r\n\u001b[?2004l\r"]
[1143.027805, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.027935, "o", "    for i := 0; i < nEst; i++ {\r\n\u001b[?2004l\r"]
[1143.027987, "o", "\u001b[?2004h> "]
[1143.02805, "o", "        n := len(X)\r\n\u001b[?2004l\r"]
[1143.028075, "o", "\u001b[?2004h> "]
[1143.028187, "o", "        idx := make([]int, n)\r\n\u001b[?2004l\r"]
[1143.028246, "o", "\u001b[?2004h> "]
[1143.028345, "o", "        for j := 0; j < n; j++ {\r\n\u001b[?2004l\r"]
[1143.028394, "o", "\u001b[?2004h> "]
[1143.028522, "o", "            idx[j] = rng.Intn(n)\r\n\u001b[?2004l\r"]
[1143.028582, "o", "\u001b[?2004h>         }\r\n"]
[1143.028608, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1143.028759, "o", "        bootX := subsetRows(X, idx)\r\n\u001b[?2004l\r"]
[1143.028811, "o", "\u001b[?2004h> "]
[1143.028923, "o", "        bootY := subsetY(y, idx)\r\n\u001b[?2004l\r"]
[1143.028984, "o", "\u001b[?2004h> "]
[1143.029294, "o", "        // feature subset: use all features but limit split search by selecting features\r\n\u001b[?2004l\r"]
[1143.029359, "o", "\u001b[?2004h> "]
[1143.029437, "o", "        selected := rng.Perm(m)\r\n\u001b[?2004l\r"]
[1143.029462, "o", "\u001b[?2004h> "]
[1143.029598, "o", "        selected = selected[:mf]\r\n\u001b[?2004l\r"]
[1143.029657, "o", "\u001b[?2004h> "]
[1143.02976, "o", "        subFeatures := []string{}\r\n\u001b[?2004l\r"]
[1143.029813, "o", "\u001b[?2004h> "]
[1143.029983, "o", "        subX := make([][]float64, len(bootX))\r\n\u001b[?2004l\r"]
[1143.030035, "o", "\u001b[?2004h> "]
[1143.030126, "o", "        for r := range bootX {\r\n\u001b[?2004l\r"]
[1143.030178, "o", "\u001b[?2004h> "]
[1143.030305, "o", "            subX[r] = []float64{}\r\n\u001b[?2004l\r"]
[1143.030355, "o", "\u001b[?2004h> "]
[1143.030498, "o", "            for _, s := range selected {\r\n\u001b[?2004l\r"]
[1143.03055, "o", "\u001b[?2004h> "]
[1143.030733, "o", "                subX[r] = append(subX[r], bootX[r][s])\r\n\u001b[?2004l\r"]
[1143.030786, "o", "\u001b[?2004h"]
[1143.030844, "o", ">             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.030905, "o", "        }\r\n\u001b[?2004l\r"]
[1143.030958, "o", "\u001b[?2004h> "]
[1143.031071, "o", "        for _, s := range selected {\r\n\u001b[?2004l\r"]
[1143.031096, "o", "\u001b[?2004h> "]
[1143.031347, "o", "            subFeatures = append(subFeatures, features[s])\r\n\u001b[?2004l\r"]
[1143.031398, "o", "\u001b[?2004h> "]
[1143.031458, "o", "        }\r\n\u001b[?2004l\r"]
[1143.031518, "o", "\u001b[?2004h> "]
[1143.031808, "o", "        tree := trainDecisionTree(subX, bootY, subFeatures, classification, 0, maxDepth, 2)\r\n\u001b[?2004l\r"]
[1143.03186, "o", "\u001b[?2004h> "]
[1143.031983, "o", "        forest = append(forest, tree)\r\n\u001b[?2004l\r"]
[1143.032036, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\rs"]
[1143.032094, "o", "\u001b[?2004h> "]
[1143.032146, "o", "    return forest\r\n\u001b[?2004l\r "]
[1143.032198, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1143.032257, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.032717, "o", "func trainGradientBoost(X [][]float64, y []float64, classification bool, nEst int, lr float64, maxDepth int) []*BoostedTree {\r\n\u001b[?2004l\r"]
[1143.032769, "o", "\u001b[?2004h> "]
[1143.032854, "o", "    trees := []*BoostedTree{}\r\n\u001b[?2004l\r"]
[1143.032905, "o", "\u001b[?2004h> "]
[1143.03296, "o", "    init := 0.0\r\n\u001b[?2004l\r"]
[1143.033012, "o", "\u001b[?2004h> "]
[1143.03307, "o", "    if classification {\r\n\u001b[?2004l\r"]
[1143.033121, "o", "\u001b[?2004h> "]
[1143.033168, "o", "        p := 0.0\r\n\u001b[?2004l\r"]
[1143.033232, "o", "\u001b[?2004h> "]
[1143.033326, "o", "        for _, v := range y {\r\n\u001b[?2004l\r"]
[1143.033376, "o", "\u001b[?2004h"]
[1143.033428, "o", ">             p += v\r\n\u001b[?2004l\r"]
[1143.033479, "o", "\u001b[?2004h> "]
[1143.033531, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.033637, "o", "        p /= float64(len(y))\r\n\u001b[?2004l\r"]
[1143.033688, "o", "\u001b[?2004h> "]
[1143.033756, "o", "        if p <= 0 {\r\n\u001b[?2004l\r"]
[1143.033807, "o", "\u001b[?2004h> "]
[1143.033871, "o", "            p = 1e-15\r\n\u001b[?2004l\r"]
[1143.033922, "o", "\u001b[?2004h> "]
[1143.033975, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.034057, "o", "        if p >= 1 {\r\n\u001b[?2004l\r"]
[1143.03411, "o", "\u001b[?2004h> "]
[1143.034193, "o", "            p = 1 - 1e-15\r\n\u001b[?2004l\r"]
[1143.03426, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1143.034313, "o", "\u001b[?2004h> "]
[1143.034431, "o", "        init = math.Log(p / (1 - p))\r\n\u001b[?2004l\r"]
[1143.034488, "o", "\u001b[?2004h> "]
[1143.034539, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.034676, "o", "        for _, v := range y {\r\n\u001b[?2004l\r "]
[1143.034728, "o", "\u001b[?2004h> "]
[1143.034791, "o", "            init += v\r\n\u001b[?2004l\r"]
[1143.034847, "o", "\u001b[?2004h> "]
[1143.034899, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.035009, "o", "        init /= float64(len(y))\r\n\u001b[?2004l\r"]
[1143.035059, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1143.035111, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1143.035163, "o", "> "]
[1143.035291, "o", "    current := make([]float64, len(y))\r\n\u001b[?2004l\r"]
[1143.035342, "o", "\u001b[?2004h> "]
[1143.035417, "o", "    for i := range y {\r\n\u001b[?2004l\r"]
[1143.035471, "o", "\u001b[?2004h> "]
[1143.035543, "o", "        current[i] = init\r\n\u001b[?2004l\r"]
[1143.035593, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\ro"]
[1143.035651, "o", "\u001b[?2004h> "]
[1143.035745, "o", "    features := []string{}\r\n\u001b[?2004l\r"]
[1143.035796, "o", "\u001b[?2004h> "]
[1143.035885, "o", "    for j := 0; j < len(X[0]); j++ {\r\n\u001b[?2004l\r"]
[1143.035937, "o", "\u001b[?2004h> "]
[1143.036104, "o", "        features = append(features, fmt.Sprintf(\"f%d\", j))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1143.036155, "o", ">     }\r\n\u001b[?2004l\r \u001b[?2004h> \r\n"]
[1143.036179, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1143.036285, "o", "    for i := 0; i < nEst; i++ {\r\n\u001b[?2004l\r"]
[1143.036338, "o", "\u001b[?2004h> "]
[1143.036436, "o", "        residual := make([]float64, len(y))\r\n\u001b[?2004l\r"]
[1143.036499, "o", "\u001b[?2004h> "]
[1143.036563, "o", "        if classification {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.036662, "o", "            for j := range y {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1143.036713, "o", "> "]
[1143.036828, "o", "                p := 1 / (1 + math.Exp(-current[j]))\r\n\u001b[?2004l\r"]
[1143.036852, "o", "\u001b[?2004h> "]
[1143.036958, "o", "                residual[j] = y[j] - p\r\n\u001b[?2004l\r"]
[1143.037009, "o", "\u001b[?2004h> "]
[1143.037069, "o", "            }\r\n\u001b[?2004l\r  r\u001b[?2004h> "]
[1143.037123, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.037198, "o", "            for j := range y {\r\n\u001b[?2004l\r"]
[1143.037276, "o", "\u001b[?2004h> "]
[1143.03735, "o", "                residual[j] = y[j] - current[j]\r\n\u001b[?2004l\r"]
[1143.037408, "o", "\u001b[?2004h> "]
[1143.037458, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.03751, "o", "        }\r\n\u001b[?2004l\rre\u001b[?2004h> "]
[1143.037714, "o", "        tree := trainDecisionTree(X, residual, features, false, 0, maxDepth, 2)\r\n\u001b[?2004l\r"]
[1143.037785, "o", "\u001b[?2004h> "]
[1143.03801, "o", "        trees = append(trees, &BoostedTree{Tree: tree, LearningRate: lr, InitPrediction: init})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.0381, "o", "        for j := range y {\r\n\u001b[?2004l\r"]
[1143.038151, "o", "\u001b[?2004h> "]
[1143.038279, "o", "            current[j] += lr * predictTree(tree, X[j])\r\n\u001b[?2004l\r"]
[1143.038294, "o", "\u001b[?2004h> "]
[1143.038326, "o", "        }\r\n\u001b[?2004l\r"]
[1143.038343, "o", "\u001b[?2004h> "]
[1143.038374, "o", "    }\r\n\u001b[?2004l\r"]
[1143.038391, "o", "\u001b[?2004h> "]
[1143.038444, "o", "    return trees\r\n\u001b[?2004l\r"]
[1143.03846, "o", "\u001b[?2004h> "]
[1143.038475, "o", "}\r\n\u001b[?2004l\r"]
[1143.03849, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1143.038507, "o", "\u001b[?2004h> "]
[1143.038664, "o", "func (m *Model) PredictBatch(X [][]float64) []float64 {\r\n\u001b[?2004l\r"]
[1143.038679, "o", "\u001b[?2004h> "]
[1143.038792, "o", "    preds := make([]float64, len(X))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.102627, "o", "    for i := range X {\r\n\u001b[?2004l\r\u001b[?2004h>         preds[i] = m.Predict(X[i])\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return preds\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func (m *Model) Predict(x []float64) float64 {\r\n\u001b[?2004l\r\u001b[?2004h>     switch m.Algorithm {\r\n\u001b[?2004l\r\u001b[?2004h>     case \"linear-regression\":\r\n\u001b[?2004l\r\u001b[?2004h>         z := m.LinearWeights[0]\r\n\u001b[?2004l\r\u001b[?2004h>         for j := 0; j < len(x); j++ {\r\n\u001b[?2004l\r\u001b[?2004h>             z += m.LinearWeights[j+1] * x[j]\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         return z\r\n\u001b[?2004l\r\u001b[?2004h>     case \"logistic-regression\":\r\n\u001b[?2004l\r\u001b[?2004h>         z := m.LogisticWeights[0]\r\n\u001b[?2004l\r\u001b[?2004h>         for j := 0; j < len(x); j++ {\r\n\u001b[?2004l\r\u001b[?2004h>             z += m.LogisticWeights[j+1] * x[j]\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         return 1 / (1 + math.Exp(-z))\r\n\u001b[?2004l\r\u001b[?2004h>     case \"decision-tree\":\r\n\u001b[?2004l\r\u001b[?2004h>         if m.Classification {\r\n\u001b[?2004l\r\u001b[?2004h>  "]
[1143.102699, "o", "           return predictTreeProb(m.Tree, x)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         return predictTree(m.Tree, x)\r\n\u001b[?2004l\r\u001b[?2004h>     case \"random-forest\":\r\n\u001b[?2004l\r\u001b[?2004h>         if m.Classification {\r\n\u001b[?2004l\r\u001b[?2004h>             sum := 0.0\r\n\u001b[?2004l\r\u001b[?2004h>             for _, t := range m.Forest {\r\n\u001b[?2004l\r\u001b[?2004h>                 sum += predictTreeProb(t, x)\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             return sum / float64(len(m.Forest))\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         sum := 0.0\r\n\u001b[?2004l\r\u001b[?2004h>         for _, t := range m.Forest {\r\n\u001b[?2004l\r\u001b[?2004h>             sum += predictTree(t, x)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         return sum / float64(len(m.Forest))\r\n\u001b[?2004l\r\u001b[?2004h>     case \"gradient-boost\":\r\n\u001b[?2004l\r\u001b[?2004h>         if len(m.Boost) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h>             return 0\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         current := m.Boost[0].InitPrediction\r\n\u001b[?2004l\r\u001b[?"]
[1143.102763, "o", "2004h>         for _, b := range m.Boost {\r\n\u001b[?2004l\r\u001b[?2004h>             current += b.LearningRate * predictTree(b.Tree, x)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         if m.Classification {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1143.102821, "o", "            return 1 / (1 + math.Exp(-current))\r\n\u001b[?2004l\r"]
[1143.102877, "o", "\u001b[?2004h> "]
[1143.102942, "o", "        }\r\n\u001b[?2004l\r"]
[1143.102996, "o", "\u001b[?2004h> "]
[1143.10313, "o", "        return current\r\n\u001b[?2004l\r"]
[1143.103185, "o", "\u001b[?2004h> "]
[1143.10331, "o", "    case \"knn\":\r\n\u001b[?2004l\r"]
[1143.103368, "o", "\u001b[?2004h> "]
[1143.103574, "o", "        return predictKNN(m.KNN, x)\r\n\u001b[?2004l\r"]
[1143.103629, "o", "\u001b[?2004h> "]
[1143.103685, "o", "    }\r\n\u001b[?2004l\r"]
[1143.10374, "o", "\u001b[?2004h> "]
[1143.103801, "o", "    return 0\r\n\u001b[?2004l\r"]
[1143.103855, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1143.10391, "o", "\u001b[?2004h> \r\n"]
[1143.103968, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1143.104026, "o", "> "]
[1143.104315, "o", "func predictTree(node *TreeNode, x []float64) float64 {\r\n\u001b[?2004l\r"]
[1143.104373, "o", "\u001b[?2004h> "]
[1143.104577, "o", "    if node == nil || node.IsLeaf {\r\n\u001b[?2004l\r"]
[1143.104639, "o", "\u001b[?2004h> "]
[1143.104779, "o", "        if node == nil {\r\n\u001b[?2004l\r"]
[1143.104836, "o", "\u001b[?2004h> "]
[1143.104957, "o", "            return 0\r\n\u001b[?2004l\r"]
[1143.105013, "o", "\u001b[?2004h> "]
[1143.105072, "o", "        }\r\n\u001b[?2004l\r"]
[1143.105128, "o", "\u001b[?2004h> "]
[1143.105313, "o", "        return node.Prediction\r\n\u001b[?2004l\r"]
[1143.105369, "o", "\u001b[?2004h> "]
[1143.10543, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1143.105485, "o", "> "]
[1143.105841, "o", "    if node.Feature < len(x) && x[node.Feature] <= node.Threshold {\r\n\u001b[?2004l\r"]
[1143.105904, "o", "\u001b[?2004h> "]
[1143.10613, "o", "        return predictTree(node.Left, x)\r\n\u001b[?2004l\r"]
[1143.106185, "o", "\u001b[?2004h> "]
[1143.10624, "o", "    }\r\n\u001b[?2004l\r"]
[1143.106296, "o", "\u001b[?2004h> "]
[1143.106504, "o", "    return predictTree(node.Right, x)\r\n\u001b[?2004l\r"]
[1143.10656, "o", "\u001b[?2004h> "]
[1143.106617, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1143.106673, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1143.106729, "o", "> "]
[1143.107029, "o", "func predictTreeProb(node *TreeNode, x []float64) float64 {\r\n\u001b[?2004l\r"]
[1143.107085, "o", "\u001b[?2004h> "]
[1143.1073, "o", "    if node == nil || node.IsLeaf {\r\n\u001b[?2004l\r"]
[1143.107357, "o", "\u001b[?2004h> "]
[1143.107499, "o", "        if node == nil {\r\n\u001b[?2004l\r"]
[1143.107554, "o", "\u001b[?2004h> "]
[1143.107675, "o", "            return 0\r\n\u001b[?2004l\r"]
[1143.107735, "o", "\u001b[?2004h"]
[1143.10779, "o", ">         }\r\n\u001b[?2004l\r"]
[1143.107848, "o", "\u001b[?2004h> "]
[1143.108028, "o", "        return node.Probability\r\n\u001b[?2004l\r"]
[1143.108084, "o", "\u001b[?2004h> "]
[1143.108138, "o", "    }\r\n\u001b[?2004l\r"]
[1143.108192, "o", "\u001b[?2004h> "]
[1143.108565, "o", "    if node.Feature < len(x) && x[node.Feature] <= node.Threshold {\r\n\u001b[?2004l\r"]
[1143.108621, "o", "\u001b[?2004h> "]
[1143.108874, "o", "        return predictTreeProb(node.Left, x)\r\n\u001b[?2004l\r"]
[1143.108929, "o", "\u001b[?2004h> "]
[1143.108984, "o", "    }\r\n\u001b[?2004l\r"]
[1143.10904, "o", "\u001b[?2004h> "]
[1143.109272, "o", "    return predictTreeProb(node.Right, x)\r\n\u001b[?2004l\r"]
[1143.109329, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1143.109394, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1143.109456, "o", "\u001b[?2004h> "]
[1143.109763, "o", "func predictKNN(knn *KNNModel, x []float64) float64 {\r\n\u001b[?2004l\r"]
[1143.109817, "o", "\u001b[?2004h> "]
[1143.11008, "o", "    if knn == nil || len(knn.Features) == 0 {\r\n\u001b[?2004l\r"]
[1143.110135, "o", "\u001b[?2004h> "]
[1143.11024, "o", "        return 0\r\n\u001b[?2004l\r"]
[1143.110307, "o", "\u001b[?2004h> "]
[1143.110363, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1143.11042, "o", "> "]
[1143.110527, "o", "    type pair struct {\r\n\u001b[?2004l\r"]
[1143.110582, "o", "\u001b[?2004h> "]
[1143.110705, "o", "        dist float64\r\n\u001b[?2004l\r"]
[1143.11076, "o", "\u001b[?2004h> "]
[1143.11089, "o", "        target float64\r\n\u001b[?2004l\r"]
[1143.110945, "o", "\u001b[?2004h> "]
[1143.111003, "o", "    }\r\n\u001b[?2004l\r"]
[1143.111058, "o", "\u001b[?2004h> "]
[1143.111303, "o", "    pairs := make([]pair, len(knn.Features))\r\n\u001b[?2004l\r"]
[1143.11136, "o", "\u001b[?2004h> "]
[1143.111551, "o", "    for i := range knn.Features {\r\n\u001b[?2004l\r"]
[1143.111608, "o", "\u001b[?2004h> "]
[1143.111707, "o", "        d := 0.0\r\n\u001b[?2004l\r"]
[1143.111763, "o", "\u001b[?2004h> "]
[1143.111917, "o", "        for j := range x {\r\n\u001b[?2004l\r"]
[1143.111972, "o", "\u001b[?2004h> "]
[1143.112233, "o", "            diff := x[j] - knn.Features[i][j]\r\n\u001b[?2004l\r"]
[1143.112301, "o", "\u001b[?2004h> "]
[1143.112462, "o", "            d += diff * diff\r\n\u001b[?2004l\r"]
[1143.112519, "o", "\u001b[?2004h> "]
[1143.112576, "o", "        }\r\n\u001b[?2004l\r"]
[1143.112632, "o", "\u001b[?2004h> "]
[1143.112952, "o", "        pairs[i] = pair{dist: d, target: knn.Targets[i]}\r\n\u001b[?2004l\r"]
[1143.113008, "o", "\u001b[?2004h> "]
[1143.113063, "o", "    }\r\n\u001b[?2004l\r"]
[1143.11312, "o", "\u001b[?2004h> "]
[1143.113389, "o", "    sort.Slice(pairs, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[1143.113451, "o", "\u001b[?2004h> "]
[1143.113704, "o", "        return pairs[i].dist < pairs[j].dist\r\n\u001b[?2004l\r"]
[1143.113761, "o", "\u001b[?2004h> "]
[1143.113814, "o", "    })\r\n\u001b[?2004l\r"]
[1143.113869, "o", "\u001b[?2004h> "]
[1143.11395, "o", "    k := knn.K\r\n\u001b[?2004l\r"]
[1143.114006, "o", "\u001b[?2004h> "]
[1143.114144, "o", "    if k > len(pairs) {\r\n\u001b[?2004l\r"]
[1143.114207, "o", "\u001b[?2004h> "]
[1143.114349, "o", "        k = len(pairs)\r\n\u001b[?2004l\r"]
[1143.114398, "o", "\u001b[?2004h> "]
[1143.114451, "o", "    }\r\n\u001b[?2004l\r"]
[1143.114507, "o", "\u001b[?2004h> "]
[1143.114663, "o", "    if knn.Classification {\r\n\u001b[?2004l\r"]
[1143.11472, "o", "\u001b[?2004h> "]
[1143.114918, "o", "        votes := map[float64]int{}\r\n\u001b[?2004l\r"]
[1143.11498, "o", "\u001b[?2004h> "]
[1143.115164, "o", "        for i := 0; i < k; i++ {\r\n\u001b[?2004l\r"]
[1143.11523, "o", "\u001b[?2004h> "]
[1143.115438, "o", "            votes[pairs[i].target]++\r\n\u001b[?2004l\r"]
[1143.115495, "o", "\u001b[?2004h> "]
[1143.115554, "o", "        }\r\n\u001b[?2004l\r"]
[1143.115609, "o", "\u001b[?2004h> "]
[1143.115747, "o", "        bestCount := -1\r\n\u001b[?2004l\r"]
[1143.115801, "o", "\u001b[?2004h> "]
[1143.115934, "o", "        bestVal := 0.0\r\n\u001b[?2004l\r"]
[1143.115991, "o", "\u001b[?2004h> "]
[1143.116194, "o", "        for val, c := range votes {\r\n\u001b[?2004l\r"]
[1143.116267, "o", "\u001b[?2004h> "]
[1143.116637, "o", "            if c > bestCount || (c == bestCount && val < bestVal) {\r\n\u001b[?2004l\r"]
[1143.116693, "o", "\u001b[?2004h> "]
[1143.116864, "o", "                bestCount = c\r\n\u001b[?2004l\r"]
[1143.11692, "o", "\u001b[?2004h> "]
[1143.11709, "o", "                bestVal = val\r\n\u001b[?2004l\r"]
[1143.117147, "o", "\u001b[?2004h> "]
[1143.117236, "o", "            }\r\n\u001b[?2004l\r"]
[1143.117308, "o", "\u001b[?2004h> "]
[1143.11736, "o", "        }\r\n\u001b[?2004l\r"]
[1143.117415, "o", "\u001b[?2004h> "]
[1143.117641, "o", "        // probability of positive class\r\n\u001b[?2004l\r"]
[1143.117718, "o", "\u001b[?2004h> "]
[1143.117798, "o", "        pos := 0\r\n\u001b[?2004l\r"]
[1143.117852, "o", "\u001b[?2004h> "]
[1143.11804, "o", "        for i := 0; i < k; i++ {\r\n\u001b[?2004l\r"]
[1143.118086, "o", "\u001b[?2004h> "]
[1143.118359, "o", "            if pairs[i].target == 1 {\r\n\u001b[?2004l\r"]
[1143.118422, "o", "\u001b[?2004h> "]
[1143.118613, "o", "                pos++\r\n\u001b[?2004l\r"]
[1143.118675, "o", "\u001b[?2004h> "]
[1143.118794, "o", "            }\r\n\u001b[?2004l\r"]
[1143.11885, "o", "\u001b[?2004h> "]
[1143.118913, "o", "        }\r\n\u001b[?2004l\r"]
[1143.118969, "o", "\u001b[?2004h> "]
[1143.119202, "o", "        return float64(pos) / float64(k)\r\n\u001b[?2004l\r"]
[1143.119265, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1143.119332, "o", "\u001b[?2004h> "]
[1143.119384, "o", "    sum := 0.0\r\n\u001b[?2004l\r"]
[1143.119421, "o", "\u001b[?2004h> "]
