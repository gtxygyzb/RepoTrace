[1613.531809, "i", "cat > pipeline.json <<'EOF'\n{\n  \"pipeline\": {\n    \"name\": \"test-pipeline\",\n    \"params\": {\"data_dir\": \".\"}\n  },\n  \"stages\": [\n    {\n      \"name\": \"load\",\n      \"type\": \"data-source\",\n      \"depends_on\": [],\n      \"inputs\": {},\n      \"params\": {\"path\": \"${data_dir}/data.csv\"}\n    },\n    {\n      \"name\": \"features\",\n      \"type\": \"transform\",\n      \"depends_on\": [\"load\"],\n      \"inputs\": {\"data\": \"load.data\"},\n      \"params\": {\"operations\": [{\"op\": \"minmax\", \"columns\": [\"age\", \"income\"]}]}\n    },\n    {\n      \"name\": \"split\",\n      \"type\": \"split\",\n      \"depends_on\": [\"features\"],\n      \"inputs\": {\"data\": \"features.data\"},\n      \"params\": {\"ratio\": 0.8, \"seed\": 42, \"stratify\": \"label\"}\n    },\n    {\n      \"name\": \"train\",\n      \"type\": \"train\",\n      \"depends_on\": [\"split\"],\n      \"inputs\": {\"data\": \"split.train\"},\n      \"params\": {\"algorithm\": \"logistic-regression\", \"target\": \"label\", \"hyperparams\": {\"learning_rate\": 0.1, \"epochs\": 100}}\n    },\n    {\n      \"name\": \"eval\",\n      \"type\": \"evaluate\",\n      \"depends"]
[1613.53203, "i", "_on\": [\"train\", \"split\"],\n      \"inputs\": {\"model\": \"train.model\", \"data\": \"split.test\"},\n      \"params\": {\"metrics\": [\"accuracy\", \"auc\"], \"threshold\": {\"accuracy\": 0.0}}\n    },\n    {\n      \"name\": \"register\",\n      \"type\": \"register\",\n      \"depends_on\": [\"train\", \"eval\"],\n      \"inputs\": {\"model\": \"train.model\", \"report\": \"eval.report\"},\n      \"params\": {\"model_name\": \"test-model\", \"tags\": [\"test\"], \"stage\": \"staging\"}\n    }\n  ]\n}\nEOF\n"]
