[12991.864712, "o", "     5\t\t\"math/rand\"\r\n     6\t)\r\n     7\t\r\n     8\tfunc executeSplit(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n     9\t\tvar ds *Dataset\r\n    10\t\tfor _, in := range inputs {\r\n    11\t\t\tif in != nil && in.Dataset != nil {\r\n    12\t\t\t\tds = in.Dataset\r\n    13\t\t\t\tbreak\r\n    14\t\t\t}\r\n    15\t\t}\r\n    16\t\tif ds == nil {\r\n    17\t\t"]
[12991.864787, "o", "\treturn nil, fmt.Errorf(\"split stage %q requires input data\", stage.Name)\r\n    18\t\t}\r\n    19\t\r\n    20\t\tratio, ok := getFloat(params, \"ratio\")\r\n    21\t\tif !ok || ratio <= 0 || ratio >= 1 {\r\n    22\t\t\t"]
[12991.864854, "o", "return nil, fmt.Errorf(\"split stage %q requires ratio in (0,1)\", stage.Name)\r\n    23\t\t}\r\n    24\t\tseed, ok := getInt(params, \"seed\")\r\n    25\t\tif !ok {\r\n    26\t\t\tseed = 0\r\n    27\t\t}\r\n    28\t\tstratify, _ := getString(params, \"stratify\")\r\n    29\t\r\n    30\t\ttrain := ds.Copy()\r\n    31\t\ttrain.Rows = nil\r\n    32\t\ttest := ds.Copy()\r\n    33\t\ttest.Rows = nil\r\n    34\t\r\n    35\t\tappendRow := func(dst *Dataset, src []string) {\r\n"]
[12991.864914, "o", "    36\t\t\tdst.Rows = append(dst.Rows, append([]string{}, src...))\r\n    37\t\t}\r\n    38\t\r\n    39\t\tif stratify == \"\" {\r\n    40\t\t\tperm := rand.New(rand.NewSource(int64(seed))).Perm(len(ds.Rows))\r\n    41\t\t\ttrainCount := int(float64(len(ds.Rows)) * ratio)\r\n    42\t\t\tfor i, idx := range perm {\r\n    43\t\t\t\tif i < trainCount {\r\n    44\t\t\t\t\tappendRow(train, ds.Rows[idx])\r\n"]
[12991.864979, "o", "    45\t\t\t\t} else {\r\n    46\t\t\t\t\tappendRow(test, ds.Rows[idx])\r\n    47\t\t\t\t}\r\n    48\t\t\t}\r\n    49\t\t} else {\r\n    50\t\t\tidx, ok := ds.ColumnIndex(stratify)\r\n    51\t\t\tif !ok {\r\n    52\t\t\t\treturn nil, fmt.Errorf(\"stratify column not found: %s\", stratify)\r\n    53\t\t\t}\r\n    54\t\t\tclasses := map[string][]int{}\r\n"]
[12991.865041, "o", "    55\t\t\tfor i, row := range ds.Rows {\r\n    56\t\t\t\tval := \"\"\r\n    57\t\t\t\tif idx < len(row) {\r\n    58\t\t\t\t\tval = row[idx]\r\n    59\t\t\t\t}\r\n    60\t\t\t\tclasses[val] = append(classes[val], i)\r\n    61\t\t\t}\r\n    62\t\t\tclassNames := make([]string, 0, len(classes))\r\n    63\t\t\tfor c := range classes {\r\n"]
[12991.865101, "o", "    64\t\t\t\tclassNames = append(classNames, c)\r\n    65\t\t\t}\r\n    66\t\t\t// deterministic class order\r\n    67\t\t\tsortStrings(classNames)\r\n    68\t\t\trng := rand.New(rand.NewSource(int64(seed)))\r\n    69\t\t\tfor _, c := range classNames {\r\n    70\t\t\t\trows := classes[c]\r\n    71\t\t\t\tperm := rng.Perm(len(rows))\r\n    72\t\t\t\ttrainCount := int(float64(len(rows)) * ratio)\r\n"]
[12991.865164, "o", "    73\t\t\t\tfor i, p := range perm {\r\n    74\t\t\t\t\tsrcIdx := rows[p]\r\n    75\t\t\t\t\tif i < trainCount {\r\n    76\t\t\t\t\t\tappendRow(train, ds.Rows[srcIdx])\r\n    77\t\t\t\t\t} else {\r\n    78\t\t\t\t\t\tappendRow(test, ds.Rows[srcIdx])\r\n    79\t\t\t\t\t}"]
[12991.865247, "o", "\r\n    80\t\t\t\t}\r\n    81\t\t\t}\r\n    82\t\t}\r\n    83\t\r\n    84\t\treturn map[string]*ArtifactValue{\"train\": {Dataset: train}, \"test\": {Dataset: test}}, nil\r\n    85\t}\r\n    86\t\r\n    87\tfunc sortStrings(s []string) {\r\n    88\t"]
[12991.865305, "o", "\tfor i := 1; i < len(s); i++ {\r\n    89\t\t\tfor j := i; j > 0 && s[j-1] > s[j]; j-- {\r\n    90\t\t\t\ts[j-1], s[j] = s[j], s[j-1]\r\n    91\t\t\t}\r\n    92\t\t}\r\n    93\t}\r\n"]
