[7579.132293, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\np = Path('register.go')\ns = p.read_text()\n\nold = re.compile(\n    r'''\\tfor k := range metricNames \\{\\n.*?\\n\\t\\}\\n''',\n    re.DOTALL,\n)\n\nnew = '''\\tfor k := range metricNames {\n\\t\\tval1, ok1 := e1.Metrics[k]\n\\t\\tmv1, okNum1 := toFloat64(val1)\n\\t\\tval2, ok2 := e2.Metrics[k]\n\\t\\tmv2, okNum2 := toFloat64(val2)\n\n\\t\\tvar v1, v2 interface{}\n\\t\\tif ok1 && okNum1 {\n\\t\\t\\tv1 = mv1\n\\t\\t} else if ok1 {\n\\t\\t\\tv1 = val1\n\\t\\t} else {\n\\t\\t\\tv1 = nil\n\\t\\t}\n\\t\\tif ok2 && okNum2 {\n\\t\\t\\tv2 = mv2\n\\t\\t} else if ok2 {\n\\t\\t\\tv2 = val2\n\\t\\t} else {\n\\t\\t\\tv2 = nil\n\\t\\t}\n\n\\t\\tif !ok1 || !ok2 || !okNum1 || !okNum2 {\n\\t\\t\\tmetricsDiff[k] = map[string]interface{}{\"v1\": v1, \"v2\": v2, \"delta\": nil, \"pct_change\": nil}\n\\t\\t\\tcontinue\n\\t\\t}\n\n\\t\\tdelta := mv2 - mv1\n\\t\\tvar pct interface{}\n\\t\\tif mv1 == 0 {\n\\t\\t\\tpct = nil\n\\t\\t} else {\n\\t\\t\\tpct = delta / math.Abs(mv1) * 100\n\\t\\t}\n\\t\\tmetricsDiff[k] = map[string]interface{}{\"v1\": v1, \"v2\": v2, \"delta\": delta, \"pct_change\": pct}\n\\t}\n'''\n\ns2 = "]
[7579.132483, "i", "old.sub(new, s, count=1)\nif s2 == s:\n    raise SystemExit('compare block not replaced')\np.write_text(s2)\nPY\n"]
