[2877.158967, "o", "    73\t\r\n    74\tfunc (e *Executor) Run() (*RunOutput, error) {\r\n    75\t\tvalid, errs := e.config.Validate()\r\n    76\t\tif !valid {\r\n    77\t\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n    78\t\t}\r\n    79\t\torder, err := e.config.topologicalOrder()\r\n"]
[2877.159045, "o", "    80\t\tif err != nil {\r\n    81\t\t\treturn nil, err\r\n    82\t\t}\r\n    83\t\r\n    84\t\trunArtifacts := map[string]*ArtifactOutput{}\r\n    85\t\r\n    86\t\tfor _, name := range order {\r\n    87\t\t\tstage, _ := e.config.stageByName(name)\r\n    88\t\t\te.outputs[name] = map[string]string{}\r\n    89\t\t\te.values[name] = map[string]*ArtifactValue{}\r\n    90\t\t\te.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n"]
