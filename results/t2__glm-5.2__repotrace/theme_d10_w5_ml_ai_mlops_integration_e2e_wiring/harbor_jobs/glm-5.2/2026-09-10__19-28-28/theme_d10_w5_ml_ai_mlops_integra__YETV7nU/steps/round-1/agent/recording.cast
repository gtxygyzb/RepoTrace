[10639.952006, "o", "\u001b[?2004h> "]
[10639.952231, "o", "    raise SystemExit(\"main.go promote pattern not found\")\r\n\u001b[?2004l\r"]
[10639.952287, "o", "\u001b[?2004h> "]
