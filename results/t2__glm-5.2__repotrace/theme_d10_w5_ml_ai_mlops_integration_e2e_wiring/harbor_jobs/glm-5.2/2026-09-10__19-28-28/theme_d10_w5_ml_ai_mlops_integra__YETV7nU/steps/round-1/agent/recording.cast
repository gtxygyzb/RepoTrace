[11870.077677, "o", "package main\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[11870.07775, "o", "\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n"]
[11870.077804, "o", "\r\nfunc canonicalJSON(v interface{}) (string, error) {\r\n\tb, err := marshalCanonical(v)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\treturn string(b), nil\r\n}\r\n\r\nfunc marshalCanonical(v interface{}) ([]byte, error) {\r\n\tswitch x := v.(type) {\r\n\tcase map[string]interface{}:\r\n"]
[11870.077859, "o", "\t\tkeys := make([]string, 0, len(x))\r\n\t\tfor k := range x {\r\n\t\t\tkeys = append(keys, k)\r\n\t\t}\r\n\t\tsort.Strings(keys)\r\n\t\tvar b strings.Builder\r\n\t\tb.WriteString(\"{\")\r\n\t\tfor i, k := range keys {\r\n\t"]
[11870.077914, "o", "\t\tif i > 0 {\r\n\t\t\t\tb.WriteString(\",\")\r\n\t\t\t}\r\n\t\t\tkb, err := json.Marshal(k)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tb.Write(kb)\r\n\t\t\tb.WriteString(\":\")\r\n\t\t\tvb, err := marshalCanonical(x[k])\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t"]
[11870.077963, "o", "\t\t}\r\n\t\t\tb.Write(vb)\r\n\t"]
[11870.078018, "o", "\t}\r\n\t\tb.WriteString(\"}\")\r\n\t\treturn []byte(b.String()), nil\r\n\tcase []interface{}:\r\n\t\tvar b strings.Builder\r\n\t\tb.WriteString(\"[\")\r\n\t\tfor i, item := range x {\r\n\t\t\tif i > 0 {\r\n\t\t\t\tb.WriteString(\",\")\r\n\t\t\t}\r\n\t\t\tib, err := marshalCanonical(item)\r\n\t\t\tif err != nil {\r\n"]
[11870.078072, "o", "\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tb.Write(ib)\r\n\t\t}\r\n\t\tb.WriteString(\"]\")\r\n\t\treturn []byte(b.String()), nil\r\n\tdefault:\r\n"]
[11870.078124, "o", "\t\treturn json.Marshal(v)\r\n\t}\r\n}\r\n\r\nfunc sha256Hex(data []byte) string {\r\n\th := sha256.Sum256(data)\r\n\treturn hex.EncodeToString(h[:])\r\n}\r\n\r\nfunc fileSHA256(path string) (string, error) {\r\n"]
[11870.078152, "o", "\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\t"]
[11870.078242, "o", "return sha256Hex(data), nil\r\n}\r\n\r\nfunc cacheDir() string {\r\n\treturn filepath.Join(\".mlpipe\", \"cache\")\r\n}\r\n\r\nfunc cacheEntryPath(key string) string {\r\n\treturn filepath.Join(cacheDir(), key)\r\n}\r\n\r\nfunc cacheEntryExists(key string) bool {\r\n\tif key == \"\" {\r\n\t\treturn false\r\n\t}\r\n\tinfo, err := os.Stat(cacheEntryPath(key))\r\n"]
[11870.078303, "o", "\treturn err == nil && info.IsDir()\r\n}\r\n\r\nfunc computeCacheKey(stage *StageConfig, params map[string]interface{}, inputKeys map[string]string, fold int) (string, error) {\r\n"]
[11870.07836, "o", "\tvar sb strings.Builder\r\n"]
[11870.07841, "o", "\tsb.WriteString(stage.Type)\r\n\tsb.WriteString(\"\\n\")\r\n\r\n\tparamsJSON, err := canonicalJSON(params)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tsb.WriteString(paramsJSON)\r\n\tsb.WriteString(\"\\n\")\r\n\r\n\tif stage.Type == \"data-source\" {\r\n"]
[11870.078459, "o", "\t\tpath, ok := getString(params, \"path\")\r\n\t\tif !ok {\r\n\t\t\treturn \"\", fmt.Errorf(\"data-source stage %q requires path for cache key\", stage.Name)\r\n\t\t}\r\n\t\tfileHash, err := fileSHA256(path)\r\n\t\tif err != nil {\r\n\t\t\treturn \"\", err"]
[11870.078507, "o", "\r\n\t\t}\r\n\t\tsb.WriteString(fileHash)\r\n\t} else {\r\n\t\tports := make([]string, 0, len(stage.Inputs))\r\n\t\tfor port := range stage.Inputs {\r\n\t\t\tports = append(ports, port)\r\n\t"]
[11870.078555, "o", "\t}\r\n\t\tsort.Strings(ports)\r\n\t\tfor i, port := range ports {\r\n\t\t\tif i > 0 {\r\n\t\t\t\tsb.WriteString(\"\\n\")\r\n\t\t\t}\r\n\t\t\tsb.WriteString(port)\r\n"]
[11870.078605, "o", "\t\t\tsb.WriteString(\"=\")\r\n\t\t\tif key, ok := inputKeys[port]; ok {\r\n\t\t\t\tsb.WriteString(key)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[11870.078653, "o", "\tif fold >= 0 {\r\n\t\tsb.WriteString(\"\\nfold=\")\r\n\t\tsb.WriteString(strconv.Itoa(fold))\r\n\t}\r\n\r\n\treturn sha256Hex([]byte(sb.String())), nil\r\n}\r\n\r\ntype cacheMeta struct {\r\n"]
[11870.0787, "o", "\tCacheKey    string   `json:\"cache_key\"`\r\n\tStageName   string   `json:\"stage_name\"`\r\n\tStageType   string   `json:\"stage_type\"`\r\n\tCreatedAt   string   `json:\"created_at\"`\r\n\tOutputPorts []string `json:\"output_ports\"`\r\n}\r\n\r\nfunc serializeArtifactValue(val *ArtifactValue) ([]byte, error) {\r\n"]
[11870.078753, "o", "\tif val.Dataset != nil {\r\n\t\ttypesMap := make(map[string]string, len(val.Dataset.Columns))\r\n\t\tfor i, col := range val.Dataset.Columns {\r\n\t\t\tif i < len(val.Dataset.Types) {\r\n\t\t\t\ttypesMap[col] = val.Dataset.Types[i]\r\n\t\t\t}\r\n\t\t}\r\n\t\tobj := map[string]interface{}{\r\n\t\t\t\"type\":    \"dataset\",\r\n\t\t\t\"columns\": val.Dataset.Columns,\r\n\t\t\t\"types\":   typesMap,\r\n"]
[11870.078768, "o", "\t\t\t\"rows\":    val.Dataset.Rows,\r\n\t\t}\r\n\t"]
[11870.078839, "o", "\treturn json.MarshalIndent(obj, \"\", \"  \")\r\n\t}\r\n\tif val.Model != nil {\r\n"]
[11870.078887, "o", "\t\tobj := map[string]interface{}{\r\n\t\t\t\"type\":  \"model\",\r\n\t\t\t\"model\": val.Model,\r\n\t\t}\r\n\t\treturn json.MarshalIndent(obj, \"\", \"  \")\r\n\t}\r\n\tif val.Report != nil {\r\n\t\tobj := map[string]interface{}{\r\n\t\t\t\"type\":    \"report\",\r\n\t\t\t\"metrics\": val.Report.Metrics,\r\n\t\t\t\"pass\":    val.Report.Pass,\r\n\t\t}\r\n"]
[11870.078942, "o", "\t\treturn json.MarshalIndent(obj, \"\", \"  \")\r\n\t}\r\n\tif val.Entry != nil {\r\n\t\tobj := map[string]interface{}{\r\n\t\t\t\"type\":    \"entry\",\r\n\t\t\t\"name\":    val.Entry.Name,\r\n\t\t\t\"version\": val.Entry.Version,\r\n\t\t\t\"stage\":   val.Entry.Stage,\r\n\t\t}\r\n\t\treturn json.MarshalIndent(obj, \"\", \"  \")\r\n"]
[11870.07899, "o", "\t}\r\n\treturn nil, fmt.Errorf(\"cannot serialize unknown artifact type\")\r\n}\r\n\r\nfunc deserializeArtifactValue(data []byte) (*ArtifactValue, error) {\r\n\tvar obj map[string]interface{}\r\n"]
[11870.079039, "o", "\tif err := json.Unmarshal(data, &obj); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\ttyp, _ := obj[\"type\"].(string)\r\n\tswitch typ {\r\n\tcase \"dataset\":\r\n\t\treturn deserializeDatasetValue(obj)\r\n"]
[11870.079092, "o", "\tcase \"model\":\r\n\t\treturn deserializeModelValue(obj)\r\n\tcase \"report\":\r\n\t\tmetrics, _ := obj[\"metrics\"].(map[string]interface{})\r\n\t\tpass, _ := obj[\"pass\"].(bool)\r\n\t\treturn &ArtifactValue{Report: &Report{Metrics: metrics, Pass: pass}}, nil\r\n\tcase \"entry\":\r\n\t\tname, _ := obj[\"name\"].(string)\r\n\t\tversion, _ := obj[\"version\"].(float64)\r\n\t\tstage, _ := obj[\"stage\"].(string)\r\n\t\treturn &ArtifactValue{Entry: &RegistryEntry{Name: name, Version: int(version), Stage: stage}}, nil\r\n\t}\r\n"]
