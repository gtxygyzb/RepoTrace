[5326.158984, "o", "> "]
[5326.159039, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.159211, "o", "            r, ok := foldExec.results[name]\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.159277, "o", "> "]
[5326.159422, "o", "            if !ok || r.Status != \"success\" {\r\n\u001b[?2004l\r"]
[5326.159476, "o", "\u001b[?2004h> "]
[5326.159544, "o", "                continue\r\n\u001b[?2004l\r"]
[5326.159598, "o", "\u001b[?2004h> "]
[5326.159653, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.15989, "o", "            val, ok := foldExec.values[name][\"report\"]\r\n\u001b[?2004l\r"]
[5326.159945, "o", "\u001b[?2004h> "]
[5326.16013, "o", "            if !ok || val == nil || val.Report == nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.160157, "o", "> "]
[5326.160256, "o", "                continue\r\n\u001b[?2004l\r"]
[5326.160279, "o", "\u001b[?2004h> "]
[5326.160345, "o", "            }\r\n\u001b[?2004l\r"]
[5326.160365, "o", "\u001b[?2004h> "]
[5326.160656, "o", "            for metricName, metricValue := range val.Report.Metrics {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.160677, "o", "> "]
[5326.160859, "o", "                fv, ok := toFloat64(metricValue)\r\n\u001b[?2004l\r"]
[5326.160881, "o", "\u001b[?2004h> "]
[5326.16099, "o", "                if !ok {\r\n\u001b[?2004l\r"]
[5326.161012, "o", "\u001b[?2004h> "]
[5326.161147, "o", "                    continue\r\n\u001b[?2004l\r"]
[5326.161167, "o", "\u001b[?2004h> "]
[5326.202698, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.202775, "o", "                metricSums[metricName] += fv\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.202833, "o", "> "]
[5326.203095, "o", "                metricCounts[metricName]++\r\n\u001b[?2004l\r"]
[5326.203152, "o", "\u001b[?2004h> "]
[5326.203254, "o", "            }\r\n\u001b[?2004l\r"]
[5326.203312, "o", "\u001b[?2004h> "]
[5326.203389, "o", "        }\r\n\u001b[?2004l\r"]
[5326.203445, "o", "\u001b[?2004h> "]
[5326.20374, "o", "        for name, sum := range metricSums {\r\n\u001b[?2004l\r"]
[5326.203796, "o", "\u001b[?2004h> "]
[5326.204066, "o", "            if metricCounts[name] > 0 {\r\n\u001b[?2004l\r"]
[5326.204121, "o", "\u001b[?2004h> "]
[5326.204589, "o", "                foldMetric[name] = sum / float64(metricCounts[name])\r\n\u001b[?2004l\r"]
[5326.204649, "o", "\u001b[?2004h> "]
[5326.204745, "o", "            }\r\n\u001b[?2004l\r"]
[5326.204811, "o", "\u001b[?2004h> "]
[5326.204882, "o", "        }\r\n\u001b[?2004l\r"]
[5326.204946, "o", "\u001b[?2004h> "]
