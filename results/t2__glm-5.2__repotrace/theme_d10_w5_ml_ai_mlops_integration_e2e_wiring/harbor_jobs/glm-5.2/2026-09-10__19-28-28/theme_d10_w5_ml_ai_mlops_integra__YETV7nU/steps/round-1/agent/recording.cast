[10342.502481, "o", "\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tMetrics        map[string]interface{} `json:\"\u001b[01;31m\u001b[Kmetric\u001b[m\u001b[Ks\"`\r\n"]
[10342.502668, "o", "\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KlistRegistry\u001b[m\u001b[K(name, stage, tag string) ([]*RegistryEntry, error) {\r\n"]
[10342.502775, "o", "\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KpromoteModel\u001b[m\u001b[K(name string, version int, targetStage string) (*RegistryEntry, string, string, error) {\r\n\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tfor \u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KName, thresholdVal := range rules {\r\n"]
[10342.502857, "o", "\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KValue, ok := entry.Metrics[\u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KName]\r\n\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tmv, ok := toFloat64(\u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KValue)\r\n\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\treturn nil, prevStage, targetStage, fmt.Errorf(\"\u001b[01;31m\u001b[Kmetric\u001b[m\u001b[K %s (%v) below threshold (%v)\", \u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KName, mv, tv)\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KsDiff := map[string]interface{}{}\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KNames := map[string]bool{}\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KNames[k] = true\r\n"]
[10342.502937, "o", "\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KNames[k] = true\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor k := range \u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KNames {\r\n\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KsDiff[k] = map[string]interface{}{\"v1\": v1, \"v2\": v2, \"delta\": nil, \"pct_change\": nil}\r\n\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KsDiff[k] = map[string]interface{}{\"v1\": v1, \"v2\": v2, \"delta\": delta, \"pct_change\": pct}\r\n\u001b[32m\u001b[K306\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\"\u001b[01;31m\u001b[Kmetric\u001b[m\u001b[Ks_diff\":     \u001b[01;31m\u001b[Kmetric\u001b[m\u001b[KsDiff,\r\n"]
