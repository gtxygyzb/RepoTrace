[3079.07351, "o", "type Model struct {\r\n\tAlgorithm       string\r\n\tTarget          string\r\n\tFeatures        []string\r\n\tHyperparams     map[string]interface{}\r\n\tClassification  bool\r\n\tLinearWeights   []float64\r\n\tLogisticWeights []float64\r\n\tTree            *TreeNode\r\n\tForest          []*TreeNode\r\n\tBoost           []*BoostedTree\r\n\tKNN             *KNNModel\r\n\tTrainFeatures   [][]float64\r\n\tTrainTarget     []float64\r\n"]
[3079.073586, "o", "}\r\n\r\ntype TreeNode struct {\r\n\tIsLeaf      bool\r\n\tPrediction  float64\r\n\tProbability float64\r\n\tFeature     int\r\n\tThreshold   float64\r\n\tLeft        *TreeNode\r\n\tRight       *TreeNode\r\n}\r\n\r\ntype BoostedTree struct {\r\n\tTree           *TreeNode\r\n"]
[3079.07365, "o", "\tLearningRate   float64\r\n\tInitPrediction float64\r\n}\r\n\r\ntype KNNModel struct {\r\n\tK              int\r\n\tFeatures       [][]float64\r\n\tTargets        []float64\r\n\tClassification bool\r\n}\r\n\r\n"]
[3079.07371, "o", "func executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tvar ds *Dataset\r\n\tfor _, in := range inputs {\r\n\t\tif in != nil && in.Dataset != nil {\r\n\t\t\tds = in.Dataset\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif ds == nil {\r\n\t\t"]
[3079.073771, "o", "return nil, fmt.Errorf(\"train stage %q requires input data\", stage.Name)\r\n\t}\r\n\r\n"]
