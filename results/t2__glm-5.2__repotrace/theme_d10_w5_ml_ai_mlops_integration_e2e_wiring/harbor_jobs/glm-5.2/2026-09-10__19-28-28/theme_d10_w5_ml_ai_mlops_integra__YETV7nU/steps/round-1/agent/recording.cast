[5439.37551, "i", "ster\", \"depends_on\": [\"train\", \"evaluate\"], \"inputs\": {\"model\": \"train.model\", \"report\": \"evaluate.report\"}, \"params\": {\"model_name\": \"smoke-model\"}}\n  ]\n}\nEOF\n"]
