[10324.377426, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[10324.377505, "o", "\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintError(\"usage: mlpipe <command> [args]\")\r\n\t\treturn\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n"]
[10324.377572, "o", "\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"plan\":\r\n\t\tcmdPlan(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"registry\":\r\n\t\tcmdRegistry(args)\r\n\tcase \"lineage\":\r\n\t\tcmdLineage(args)\r\n"]
[10324.377636, "o", "\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n\t}\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n\tconfigPath, overrides, cv, noCache, skipStages, err := parseRunArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n"]
[10324.3777, "o", "\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tfor _, name := range skipStages {\r\n\t\tif _, ok := config.stageByName(name); !ok {\r\n\t\t\tprintError(fmt.Sprintf(\"unknown stage: %s\", name))\r\n"]
[10324.377776, "o", "\t\t\treturn\r\n\t\t}\r\n\t}\r\n\texecutor := NewExecutor(config, overrides)\r\n\texecutor.noCache = noCache\r\n\texecutor.skipStages = skipStages\r\n\tif noCache {\r\n\t\texecutor.cacheStats = nil\r\n\t}\r\n\texecutor.cvFolds = cv\r\n\t"]
[10324.377837, "o", "var run interface{}\r\n\tif cv > 0 {\r\n\t\trun, err = executor.RunCV()\r\n\t} else {\r\n\t\trun, err = executor.Run()\r\n\t}\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n"]
[10324.3779, "o", "\tprintJSON(run)\r\n}\r\n\r\nfunc cmdPlan(args []string) {\r\n\tconfigPath, overrides, cv, err := parsePlanArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n"]
[10324.377964, "o", "\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tplan, err := buildPlan(config, overrides, cv)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(plan)\r\n}\r\n\r\nfunc cmdValidate(args []string) {"]
[10324.378023, "o", "\r\n\tconfigPath := \"\"\r\n\toverrides := map[string]string{}\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--param\":\r\n\t\t\tif i+1 >= len(args) {\r\n"]
[10324.378084, "o", "\t\t\t\tprintError(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tkv := args[i+1]\r\n\t\t\ti++\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\tprintError(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n"]
[10324.378145, "o", "\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tcase strings.HasPrefix(args[i], \"--param=\"):\r\n\t\t\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\tprintError(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n"]
[10324.378207, "o", "\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tdefault:\r\n\t\t\tif configPath == \"\" && !strings.HasPrefix(args[i], \"--\") {\r\n\t\t\t\tconfigPath = args[i]\r\n\t\t\t} else {\r\n\t\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t"]
[10324.378282, "o", "\t}\r\n\t}\r\n\tif configPath == \"\" {\r\n\t\tprintError(\"usage: mlpipe validate <config.json> [--param key=value ...]\")\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n"]
[10324.378341, "o", "\t}\r\n\tif len(overrides) > 0 {\r\n\t\tglobals := config.globalParams(overrides)\r\n\t\tconfig.Pipeline.Params = globals\r\n\t\tfor i := range config.Stages {\r\n\t\t\tconfig.Stages[i].Params = config.stageParams(config.Stages[i].Name, globals)\r\n\t\t}\r\n\t}\r\n\tvalid, errors := config.Validate()\r\n\tprintJSON(map[string]interface{}{\"valid\": valid, \"errors\": errors})\r\n"]
[10324.378409, "o", "}\r\n\r\nfunc cmdRegistry(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe registry <list|info|promote|compare> [args]\")\r\n\t\treturn\r\n\t}\r\n\tsub := args[0]\r\n\trest := args[1:]\r\n\tswitch sub {\r\n"]
[10324.378467, "o", "\tcase \"list\":\r\n\t\tcmdRegistryList(rest)\r\n\tcase \"info\":\r\n\t\tcmdRegistryInfo(rest)\r\n\tcase \"promote\":\r\n\t\tcmdRegistryPromote(rest)\r\n\tcase \"compare\":\r\n\t\t"]
[10324.378528, "o", "cmdRegistryCompare(rest)\r\n\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown registry command: %s\", sub))\r\n\t}\r\n}\r\n\r\nfunc cmdRegistryList(args []string) {\r\n\tname, stage, tag := \"\", \"\", \"\"\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--name\" && i+1 < len(args):\r\n"]
[10324.378588, "o", "\t\t\tname = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--name=\"):\r\n\t\t\tname = strings.TrimPrefix(args[i], \"--name=\")\r\n\t\tcase args[i] == \"--stage\" && i+1 < len(args):\r\n\t\t\tstage = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--stage=\"):\r\n\t"]
[10324.378651, "o", "\t\tstage = strings.TrimPrefix(args[i], \"--stage=\")\r\n\t\tcase args[i] == \"--tag\" && i+1 < len(args):\r\n\t\t\ttag = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--tag=\"):\r\n\t\t\ttag = strings.TrimPrefix(args[i], \"--tag=\")\r\n\t\tdefault:\r\n\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\t\t\treturn\r\n\t\t}\r\n\t"]
[10324.378721, "o", "}\r\n\tentries, err := listRegistry(name, stage, tag)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tout := make([]map[string]interface{}, len(entries))\r\n\tfor i, e := range entries {\r\n\t\tout[i] = map[string]interface{}{\r\n\t\t\t\"name\":          e.Name,\r\n\t\t\t\"version\":       e.Version,\r\n"]
[10324.378779, "o", "\t\t\t\"stage\":         e.Stage,\r\n\t\t\t\"tags\":          e.Tags,\r\n\t\t\t\"metrics\":       e.Metrics,\r\n\t\t\t\"registered_at\": e.RegisteredAt,\r\n\t\t}\r\n\t}\r\n\tprintJSON(out)\r\n}\r\n\r\n"]
[10324.378841, "o", "func cmdRegistryInfo(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe registry info <name>:<version>\")\r\n\t\treturn\r\n\t}\r\n\tname, version, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n"]
[10324.378901, "o", "\t}\r\n\tentry, err := registryInfo(name, version)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(entry)\r\n}\r\n\r\n"]
[10324.37896, "o", "func cmdRegistryPromote(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tprintError(\"usage: mlpipe registry promote <name>:<version> <target_stage>\")\r\n\t\treturn\r\n\t}\r\n\tname, version, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n"]
[10324.379024, "o", "\t}\r\n\ttarget := args[1]\r\n\tentry, prev, new, err := promoteModel(name, version, target)\r\n\tif err != nil {\r\n\t\tif strings.HasPrefix(err.Error(), \"metric \") {\r\n\t\t\tprintJSON(map[string]interface{}{\"success\": false, \"message\": err.Error()})\r\n\t\t\treturn\r\n\t\t}\r\n\t\tprintError(err.Error())\r\n\t\treturn"]
[10324.379086, "o", "\r\n\t}\r\n\tprintJSON(map[string]interface{}{\r\n\t\t\"success\":        true,\r\n\t\t\"message\":        fmt.Sprintf(\"promoted to %s\", new),\r\n\t\t\"previous_stage\": prev,\r\n\t\t\"new_stage\":      entry.Stage,\r\n\t})\r\n}\r\n\r\nfunc cmdRegistryCompare(args []string) {\r\n"]
[10324.379145, "o", "\tif len(args) < 2 {\r\n\t\tprintError(\"usage: mlpipe registry compare <name>:<version1> <name>:<version2>\")\r\n\t\treturn\r\n"]
