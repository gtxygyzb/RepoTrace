[1943.164786, "o", "\u001b[?2004h> "]
[1943.164848, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1943.164903, "o", "> "]
[1943.165037, "o", "            leftY := subsetY(y, leftIdx)\r\n\u001b[?2004l\r"]
[1943.165091, "o", "\u001b[?2004h> "]
[1943.165258, "o", "            rightY := subsetY(y, rightIdx)\r\n\u001b[?2004l\r"]
[1943.165313, "o", "\u001b[?2004h> "]
[1943.165548, "o", "            leftImp := giniOrVariance(leftY, classification)\r\n\u001b[?2004l\r"]
[1943.165602, "o", "\u001b[?2004h> "]
[1943.165843, "o", "            rightImp := giniOrVariance(rightY, classification)\r\n\u001b[?2004l\r"]
[1943.165898, "o", "\u001b[?2004h> "]
[1943.166327, "o", "            gain := impurity - (float64(len(leftY))*leftImp+float64(len(rightY))*rightImp)/float64(len(y))\r\n\u001b[?2004l\r"]
[1943.166382, "o", "\u001b[?2004h> "]
[1943.166502, "o", "            if gain > bestGain {\r\n\u001b[?2004l\r"]
[1943.166556, "o", "\u001b[?2004h> "]
[1943.166678, "o", "                bestGain = gain\r\n\u001b[?2004l\r"]
[1943.166732, "o", "\u001b[?2004h> "]
[1943.16687, "o", "                bestFeaturePos = pos\r\n\u001b[?2004l\r"]
[1943.166924, "o", "\u001b[?2004h> "]
[1943.167055, "o", "                bestFeatureIdx = j\r\n\u001b[?2004l\r"]
[1943.167109, "o", "\u001b[?2004h> "]
[1943.167273, "o", "                bestThreshold = threshold\r\n\u001b[?2004l\r"]
[1943.167328, "o", "\u001b[?2004h> "]
[1943.167471, "o", "                bestLeftIdx = leftIdx\r\n\u001b[?2004l\r"]
[1943.167525, "o", "\u001b[?2004h> "]
[1943.167673, "o", "                bestRightIdx = rightIdx\r\n\u001b[?2004l\r"]
[1943.167727, "o", "\u001b[?2004h> "]
[1943.167777, "o", "            }\r\n\u001b[?2004l\r"]
[1943.16783, "o", "\u001b[?2004h> "]
[1943.167885, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
