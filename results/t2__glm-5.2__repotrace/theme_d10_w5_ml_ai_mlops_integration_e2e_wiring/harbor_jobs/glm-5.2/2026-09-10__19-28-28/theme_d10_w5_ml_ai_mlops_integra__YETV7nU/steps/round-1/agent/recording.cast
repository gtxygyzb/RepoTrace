[3129.410443, "o", "\tseed, ok := getInt(params, \"seed\")\r\n\tif !ok {\r\n\t\tseed = 0\r\n\t}\r\n\tstratify, _ := getString(params, \"stratify\")\r\n\r\n\ttrain := ds.Copy()\r\n\ttrain.Rows = nil\r\n\ttest := ds.Copy()\r\n\ttest.Rows = nil\r\n\r\n\tappendRow := func(dst *Dataset, src []string) {\r\n\t\tdst.Rows = append(dst.Rows, append([]string{}, src...))\r\n\t}\r\n\r\n"]
[3129.410509, "o", "\tif stratify == \"\" {\r\n\t\tperm := rand.New(rand.NewSource(int64(seed))).Perm(len(ds.Rows))\r\n\t\ttrainCount := int(float64(len(ds.Rows)) * ratio)\r\n\t\tfor i, idx := range perm {\r\n\t\t\tif i < trainCount {\r\n\t\t\t\tappendRow(train, ds.Rows[idx])\r\n\t\t\t} else {\r\n\t\t\t\tappendRow(test, ds.Rows[idx])\r\n"]
[3129.410568, "o", "\t\t\t}\r\n\t\t}\r\n\t} else {\r\n\t\tidx, ok := ds.ColumnIndex(stratify)\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"stratify column not found: %s\", stratify)\r\n\t\t}\r\n\t\tclasses := map[string][]int{}\r\n\t\tfor i, row := range ds.Rows {\r\n"]
[3129.410625, "o", "\t\t\tval := \"\"\r\n\t\t\tif idx < len(row) {\r\n\t\t\t\tval = row[idx]\r\n\t\t\t}\r\n\t\t\tclasses[val] = append(classes[val], i)\r\n\t\t}\r\n\t\tclassNames := make([]string, 0, len(classes))\r\n\t\tfor c := range classes {\r\n"]
[3129.410692, "o", "\t\t\tclassNames = append(classNames, c)\r\n\t\t}\r\n\t\t// deterministic class order\r\n\t\tsortStrings(classNames)\r\n\t\trng := rand.New(rand.NewSource(int64(seed)))\r\n\t\tfor _, c := range classNames {\r\n"]
[3129.41075, "o", "\t\t\trows := classes[c]\r\n\t\t\tperm := rng.Perm(len(rows))\r\n\t\t\ttrainCount := int(float64(len(rows)) * ratio)\r\n\t\t\tfor i, p := range perm {\r\n\t\t\t\tsrcIdx := rows[p]\r\n\t\t\t\tif i < trainCount {\r\n\t\t\t\t\tappendRow(train, ds.Rows[srcIdx])\r\n\t\t\t\t} else {\r\n\t\t\t\t\tappendRow(test, ds.Rows[srcIdx])\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n"]
[3129.410814, "o", "\t}\r\n\r\n\treturn map[string]*ArtifactValue{\"train\": {Dataset: train}, \"test\": {Dataset: test}}, nil\r\n}\r\n\r\nfunc sortStrings(s []string) {\r\n\tfor i := 1; i < len(s); i++ {\r\n\t\tfor j := i; j > 0 && s[j-1] > s[j]; j-- {\r\n\t\t\ts[j-1], s[j] = s[j], s[j-1]\r\n"]
