[12831.838691, "o", "    22\t\tOld []string `json:\"old\"`\r\n    23\t\tNew []string `json:\"new\"`\r\n    24\t}\r\n    25\t\r\n    26\ttype ConfigDiff struct {\r\n    27\t\tPipelineName    *FieldDiff           `json:\"pipeline_name,omitempty\"`\r\n    28\t\tStagesAdded     []string             `json:\"stages_added\"`\r\n    29\t\tStagesRemoved   []string             `json:\"stages_removed\"`\r\n    30\t\tStagesModified  map[string]StageDiff `json:\"stages_modified\"`\r\n    31\t\tStagesUnchanged []string             `json:\"stages_unchanged\"`\r\n    32\t}\r\n"]
[12831.838764, "o", "    33\t\r\n    34\tfunc cmdDiff(args []string) {\r\n    35\t\tvar paths []string\r\n    36\t\toverrides := map[string]string{}\r\n    37\t\tfor i := 0; i < len(args); i++ {\r\n    38\t\t\tswitch {\r\n    39\t\t\tcase args[i] == \"--param\":\r\n    40\t\t\t\tif i+1 >= len(args) {\r\n    41\t\t\t\t\t"]
[12831.838831, "o", "exitError(\"--param requires key=value\")\r\n    42\t\t\t\t\treturn\r\n    43\t\t\t\t}\r\n    44\t\t\t\tkv := args[i+1]\r\n    45\t\t\t\ti++\r\n    46\t\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n    47\t\t\t\tif !ok {\r\n    48\t\t\t\t\texitError(\"--param requires key=value\")\r\n    49\t\t\t\t\treturn\r\n    50\t\t\t\t}\r\n"]
[12831.838898, "o", "    51\t\t\t\toverrides[k] = v\r\n    52\t\t\tcase strings.HasPrefix(args[i], \"--param=\"):\r\n    53\t\t\t\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n    54\t\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n    55\t\t\t\tif !ok {\r\n    56\t\t\t\t\texitError(\"--param requires key=value\")\r\n    57\t\t\t\t\treturn\r\n    58\t\t\t\t}\r\n"]
[12831.838958, "o", "    59\t\t\t\toverrides[k] = v\r\n    60\t\t\tdefault:\r\n    61\t\t\t\tpaths = append(paths, args[i])\r\n    62\t\t\t}\r\n    63\t\t}\r\n    64\t\tif len(paths) != 2 {\r\n    65\t\t\texitError(\"usage: mlpipe diff config1.json config2.json [--param key=value ...]\")\r\n    66\t\t\treturn\r\n    67\t\t}\r\n    68\t\t"]
[12831.839023, "o", "config1, err := loadConfig(paths[0])\r\n    69\t\tif err != nil {\r\n    70\t\t\texitError(err.Error())\r\n    71\t\t\treturn\r\n    72\t\t}\r\n    73\t\tconfig2, err := loadConfig(paths[1])\r\n    74\t\tif err != nil {\r\n    75\t\t\texitError(err.Error())\r\n    76\t\t\treturn\r\n    77\t"]
[12831.839082, "o", "\t}\r\n    78\t\tapplyDiffParams(config1, overrides)\r\n    79\t\tapplyDiffParams(config2, overrides)\r\n    80\t\tprintJSON(diffConfigs(config1, config2))\r\n    81\t}\r\n    82\t\r\n    83\tfunc applyDiffParams(config *Config, overrides map[string]string) {\r\n    84\t\tglobals := config.globalParams(overrides)\r\n    85\t\tconfig.Pipeline.Params = substituteValue(config.Pipeline.Params, globals).(map[string]interface{})\r\n"]
