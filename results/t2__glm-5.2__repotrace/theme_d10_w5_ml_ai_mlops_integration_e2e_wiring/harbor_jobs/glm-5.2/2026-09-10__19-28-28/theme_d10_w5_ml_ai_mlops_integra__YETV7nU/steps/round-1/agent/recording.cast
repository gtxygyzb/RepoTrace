[1943.169141, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1943.169199, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1943.169264, "o", "\u001b[?2004h> "]
