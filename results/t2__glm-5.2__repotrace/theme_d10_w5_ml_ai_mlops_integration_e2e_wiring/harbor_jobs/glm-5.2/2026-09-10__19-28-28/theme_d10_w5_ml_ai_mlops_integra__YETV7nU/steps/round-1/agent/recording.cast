[11883.712773, "o", "func (e *Executor) RunCV() (*CVRunOutput, error) {\r\n\tif e.cvFolds < 2 {\r\n\t\treturn nil, fmt.Errorf(\"cv folds must be >= 2\")\r\n\t}\r\n\r\n\tvalid, errs := e.config.Validate()\r\n\tif !valid {\r\n\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n"]
[11883.712855, "o", "\t}\r\n\tif err := e.config.validateCV(); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\torder, err := e.config.topologicalOrder()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tsplitName, _ := e.config.splitStageName()\r\n\tpostSplit := e.config.postSplitStages(splitName)\r\n\tpreSplitOrder := []string{}\r\n\tpostSplitOrder := []string{}\r\n\tfor _, name := range order {\r\n"]
[11883.71291, "o", "\t\tif postSplit[name] {\r\n\t\t\tpostSplitOrder = append(postSplitOrder, name)\r\n\t\t} else {\r\n\t\t\tpreSplitOrder = append(preSplitOrder, name)\r\n\t\t}\r\n\t}\r\n\r\n\tallArtifacts := map[string]*ArtifactOutput{}\r\n\r\n"]
[11883.712963, "o", "\tfor _, name := range preSplitOrder {\r\n\t\te.executeStageCached(name, -1, 0, allArtifacts)\r\n\t}\r\n\r\n\tfoldResults := make([]CVFoldResult, e.cvFolds)\r\n\tfoldMetrics := make([]map[string]float64, e.cvFolds)\r\n\r\n\tfor i := 0; i < e.cvFolds; i++ {\r\n"]
[11883.713015, "o", "\t\tfoldExec := &Executor{\r\n\t\t\tconfig:     e.config,\r\n\t\t\tglobals:    e.globals,\r\n\t\t\tstatus:     map[string]string{},\r\n\t\t\tresults:    map[string]*StageResult{},\r\n\t\t\toutputs:    map[string]map[string]string{},\r\n"]
[11883.713065, "o", "\t\t\tvalues:     map[string]map[string]*ArtifactValue{},\r\n\t\t\tmeta:       e.meta,\r\n\t\t\tcacheKeys:  map[string]string{},\r\n\t\t\tnoCache:    e.noCache,\r\n\t\t\tcvFolds:    e.cvFolds,\r\n\t\t\tcacheStats: e.cacheStats,\r\n\t\t}\r\n\t"]
[11883.713114, "o", "\tfor name, st := range e.status {\r\n\t\t\tfoldExec.status[name] = st\r\n\t\t}\r\n\t\tfor name, outs := range e.outputs {\r\n\t\t\tfoldExec.outputs[name] = copyStringMap(outs)\r\n\t\t}\r\n\t\tfor name, vals := range e.values {\r\n\t\t"]
[11883.713164, "o", "\tfoldExec.values[name] = copyValueMap(vals)\r\n\t\t}\r\n\t\tfor name, key := range e.cacheKeys {\r\n\t\t\tfoldExec.cacheKeys[name] = key\r\n\t\t}\r\n\r\n\t\tfoldArtifacts := map[string]*ArtifactOutput{}\r\n\t\tfor _, name := range postSplitOrder {\r\n"]
[11883.713213, "o", "\t\t\tfoldExec.executeStageCached(name, i, e.cvFolds, foldArtifacts)\r\n\t\t}\r\n\r\n\t\tfoldStatus := \"success\"\r\n\t\tfor _, r := range foldExec.results {\r\n\t\t\tif r.Status != \"success\" {\r\n\t\t\t\tfoldStatus = \"failed\"\r\n\t\t\t\tbreak\r\n\t"]
[11883.713279, "o", "\t\t}\r\n\t\t}\r\n\r\n\t\tfor id, art := range foldArtifacts {\r\n\t\t\tallArtifacts[id] = art\r\n\t\t}\r\n\r\n\t\tfoldResults[i] = CVFoldResult{\r\n"]
[11883.713328, "o", "\t\t\tFold:   i,\r\n\t\t\tStatus: foldStatus,\r\n\t\t\tStages: foldExec.results,\r\n\t\t}\r\n\r\n\t\tfoldMetric := map[string]float64{}\r\n\t\tmetricSums := map[string]float64{}\r\n\t\tmetricCounts := map[string]int{}\r\n\t"]
[11883.71338, "o", "\tfor _, name := range postSplitOrder {\r\n\t\t\tstage, _ := e.config.stageByName(name)\r\n\t\t\tif stage.Type != \"evaluate\" {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tr, ok := foldExec.results[name]\r\n\t\t\tif !ok || r.Status != \"success\" {\r\n"]
[11883.713429, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tval, ok := foldExec.values[name][\"report\"]\r\n\t\t\tif !ok || val == nil || val.Report == nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tfor metricName, metricValue := range val.Report.Metrics {\r\n"]
[11883.71348, "o", "\t\t\t\tfv, ok := toFloat64(metricValue)\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tmetricSums[metricName] += fv\r\n\t\t\t\tmetricCounts[metricName]++\r\n\t\t\t}\r\n\t\t}\r\n"]
[11883.713533, "o", "\t\tfor name, sum := range metricSums {\r\n\t\t\tif metricCounts[name] > 0 {\r\n\t\t\t\tfoldMetric[name] = sum / float64(metricCounts[name])\r\n\t\t\t}\r\n\t\t}\r\n\t\tfoldMetrics[i] = foldMetric\r\n\t}\r\n\r\n\tcvMetrics := map[string]CVMetricAgg{}\r\n"]
[11883.713582, "o", "\tmetricNames := map[string]bool{}\r\n\tfor _, fm := range foldMetrics {\r\n\t\tfor name := range fm {\r\n\t\t\tmetricNames[name] = true\r\n\t\t}\r\n\t}\r\n\tfor name := range metricNames {\r\n\t"]
[11883.713636, "o", "\tperFold := make([]float64, e.cvFolds)\r\n\t\tsum := 0.0\r\n\t\tcount := 0\r\n\t\tfor i, fm := range foldMetrics {\r\n\t\t\tif v, ok := fm[name]; ok {\r\n\t\t\t\tperFold[i] = v\r\n\t\t\t\tsum += v\r\n\t"]
[11883.713686, "o", "\t\t\tcount++\r\n\t\t\t} else {\r\n\t\t\t\tperFold[i] = 0.0\r\n\t\t\t}\r\n\t\t}\r\n\t\tmean := 0.0\r\n\t\tif count > 0 {\r\n"]
[11883.713735, "o", "\t\t\tmean = sum / float64(count)\r\n\t\t}\r\n\t\tvariance := 0.0\r\n\t\tfor _, v := range perFold {\r\n\t\t\td := v - mean\r\n\t\t\tvariance += d * d\r\n\t\t}\r\n"]
[11883.713786, "o", "\t\tvariance /= float64(e.cvFolds)\r\n\t\tcvMetrics[name] = CVMetricAgg{\r\n\t\t\tMean:    mean,\r\n\t\t\tStd:     math.Sqrt(variance),\r\n\t\t\tPerFold: perFold,\r\n\t\t}\r\n\t}\r\n\r\n\tstatus := \"success\"\r\n\t"]
[11883.713834, "o", "for _, r := range e.results {\r\n\t\tif r.Status != \"success\" {\r\n\t\t\tstatus = \"failed\"\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tfor _, fr := range foldResults {\r\n"]
[11883.713884, "o", "\t\tif fr.Status != \"success\" {\r\n\t\t\tstatus = \"failed\"\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n\trun := &CVRunOutput{\r\n\t\tPipeline:    e.config.Pipeline.Name,\r\n\t\tStatus:      status,\r\n"]
[11883.713934, "o", "\t\tCVFolds:     e.cvFolds,\r\n\t\tStages:      e.results,\r\n\t\tFoldResults: foldResults,\r\n\t\tCVResults:   CVResults{Metrics: cvMetrics},\r\n\t\tArtifacts:   allArtifacts,\r\n\t\tCacheStats:  e.cacheStats,\r\n\t}\r\n"]
[11883.713988, "o", "\r\n\tif err := saveArtifacts(e.meta); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn run, nil\r\n}\r\n\r\nfunc (e *Executor) executeStageCached(name string, fold, k int, runArtifacts map[string]*ArtifactOutput) bool {\r\n\tstage, _ := e.config.stageByName(name)\r\n\te.outputs[name] = map[string]string{}\r\n\t"]
[11883.714037, "o", "e.values[name] = map[string]*ArtifactValue{}\r\n\te.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n\r\n\tskip := false\r\n\tfor _, dep := range stage.DependsOn {\r\n\t\tif e.status[dep] != \"success\" {\r\n\t\t\tskip = true\r\n\t\t\tbreak\r\n\t"]
[11883.714086, "o", "\t}\r\n\t}\r\n\tif skip {\r\n\t\te.status[name] = \"skipped\"\r\n\t\te.results[name].Status = \"skipped\"\r\n\t\treturn false\r\n"]
[11883.714134, "o", "\t}\r\n\r\n\tinputValues, inputIDs, err := e.resolveInputs(stage)\r\n\tif err != nil {\r\n\t\te.status[name] = \"failed\"\r\n\t\te.results[name].Status = \"failed\"\r\n\t\te.results[name].Error = err.Error()\r\n"]
[11883.714182, "o", "\t\treturn false\r\n\t}\r\n\r\n\tparams := e.config.stageParams(name, e.globals)\r\n\tinputKeys := e.inputCacheKeys(stage)\r\n\tcacheKey, keyErr := computeCacheKey(stage, params, inputKeys, fold)\r\n\tif keyErr != nil {\r\n\t\te.status[name] = \"failed\"\r\n\t\te.results[name].Status = \"failed\""]
[11883.714242, "o", "\r\n\t\te.results[name].Error = keyErr.Error()\r\n\t\treturn false\r\n\t}\r\n\te.cacheKeys[name] = cacheKey\r\n\r\n\tvar out map[string]*ArtifactValue\r\n\tstart := time.Now()\r\n"]
[11883.714301, "o", "\tif !e.noCache && cacheEntryExists(cacheKey) {\r\n\t\tloaded, loadErr := loadCacheEntry(cacheKey)\r\n\t\tif loadErr == nil {\r\n\t\t\tout = loaded\r\n\t\t\te.results[name].CacheHit = true\r\n\t\t\te.cacheStats.Hits++\r\n\t\t\te.results[name].DurationMs = time.Since(start).Milliseconds()\r\n\t\t} else {\r\n\t"]
[11883.714354, "o", "\t\tif !e.noCache {\r\n\t\t\t\te.cacheStats.Misses++\r\n\t\t\t}\r\n\t\t\tout, err = e.executeStageForFold(stage, params, inputValues, fold, k)\r\n\t\t\te.results[name].DurationMs = time.Since(start).Milliseconds()\r\n\t\t\tif err != nil {\r\n\t\t\t\te.status[name] = \"failed\"\r\n\t\t\t\te.results[name].Status = \"failed\"\r\n"]
[11883.714403, "o", "\t\t\t\te.results[name].Error = err.Error()\r\n\t\t\t\treturn false\r\n\t\t\t}\r\n\t\t\tif !e.noCache {\r\n\t\t\t\t_ = saveCacheEntry(cacheKey, name, stage.Type, out)\r\n\t\t\t}\r\n\t\t}\r\n"]
[11883.714453, "o", "\t} else {\r\n\t\tout, err = e.executeStageForFold(stage, params, inputValues, fold, k)\r\n\t\te.results[name].DurationMs = time.Since(start).Milliseconds()\r\n\t\tif err != nil {\r\n\t\t\te.status[name] = \"failed\"\r\n\t\t\te.results[name].Status = \"failed\"\r\n\t\t\te.results[name].Error = err.Error()\r\n"]
[11883.714503, "o", "\t\t\treturn false\r\n\t\t}\r\n\t\tif !e.noCache {\r\n\t\t\t_ = saveCacheEntry(cacheKey, name, stage.Type, out)\r\n\t\t\te.cacheStats.Misses++\r\n\t\t}\r\n\t}\r\n\r\n"]
[11883.714551, "o", "\te.status[name] = \"success\"\r\n\te.results[name].Status = \"success\"\r\n\tts := time.Now().UnixNano()\r\n\r\n\tfor port, val := range out {\r\n\t\tvar id string\r\n\t\tif fold >= 0 {\r\n\t\t\tid = artifactIDFold(e.config.Pipeline.Name, name, port, ts, fold)\r\n"]
[11883.7146, "o", "\t\t} else {\r\n\t\t\tid = artifactID(e.config.Pipeline.Name, name, port, ts)\r\n\t\t}\r\n\t\te.values[name][port] = val\r\n\t\te.outputs[name][port] = id\r\n\t\ttyp := val.Type()\r\n\t\tsummary := val.Summary()\r\n"]
[11883.714648, "o", "\t\tmeta := &ArtifactMeta{\r\n\t\t\tID:        id,\r\n\t\t\tStage:     name,\r\n\t\t\tPort:      port,\r\n\t\t\tType:      typ,\r\n\t\t\tSummary:   summary,\r\n\t\t\tInputs:    inputIDs,\r\n"]
[11883.714698, "o", "\t\t\tOutputs:   []string{},\r\n\t\t\tTimestamp: ts,\r\n\t\t}\r\n\t\te.meta[id] = meta\r\n\t\tfor _, inID := range inputIDs {\r\n\t\t\tif parent, ok := e.meta[inID]; ok {\r\n\t\t\t\tparent.Outputs = appendUnique(parent.Outputs, id)\r\n\t\t\t}"]
[11883.714745, "o", "\r\n\t\t}\r\n\t\trunArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n\t}\r\n\treturn true\r\n"]
[11883.715336, "o", "\u001b[?2004h"]
[11883.715403, "o", "root@n30009:/app# "]
[11883.994773, "i", "sed -n '73,160p' history.go\n"]
[11883.995035, "o", "sed -n '73,160p' history.go\r\n\u001b[?2004l\r"]
[11883.997755, "o", "func buildRunRecord(executor *Executor, startedAt time.Time, finishedAt time.Time, status string) *RunRecord {\r\n\tmode := \"standard\"\r\n\tvar cvFolds *int\r\n\tif executor.cvFolds > 0 {\r\n\t\tmode = \"cv\"\r\n\t\tf := executor.cvFolds\r\n\t\tcvFolds = &f\r\n\t"]
[11883.997905, "o", "}\r\n\r\n\tskipped := []string{}\r\n\tskipped = append(skipped, executor.skipStages...)\r\n\r\n\tsummary := map[string]StageSummary{}\r\n\tfor name, r := range executor.results {\r\n\t\tif r == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tsummary[name] = StageSummary{\r\n\t\t\tStatus:     r.Status,\r\n\t\t\tCacheHit:   r.CacheHit,\r\n\t\t\tDurationMs: r.DurationMs,\r\n\t\t}\r\n\t}\r\n\r\n\tvar cacheStats *CacheStats\r\n\tif !executor.noCache {\r\n\t\tcacheStats = executor.cacheStats\r\n\t\tif cacheStats == nil {\r\n\t\t\tcacheStats = &CacheStats{}\r\n\t\t}\r\n\t}\r\n\r\n"]
[11883.998003, "o", "\treturn &RunRecord{\r\n\t\tRunID:         strconv.FormatInt(finishedAt.UnixMilli(), 10),\r\n\t\tPipeline:      executor.config.Pipeline.Name,\r\n\t\tStartedAt:     startedAt.UTC().Format(time.RFC3339),\r\n\t\tFinishedAt:    finishedAt.UTC().Format(time.RFC3339),\r\n\t\tDurationMs:    finishedAt.Sub(startedAt).Milliseconds(),\r\n\t\tStatus:        status,\r\n"]
[11883.998072, "o", "\t\tMode:          mode,\r\n\t\tCvFolds:       cvFolds,\r\n\t\tNoCache:       executor.noCache,\r\n\t\tSkippedStages: skipped,\r\n\t\tStageSummary:  summary,\r\n\t\tCacheStats:    cacheStats,\r\n\t}\r\n}\r\n\r\nfunc cmdHistory(args []string) {\r\n\tvar pipelineFilter string\r\n\tvar statusFilter string\r\n\tlimit := -1\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tswitch {\r\n\t\tcase arg == \"--pipeline\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tprintError(\"--pipeline requires a value\")\r\n"]
[11883.998136, "o", "\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tpipelineFilter = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(arg, \"--pipeline=\"):\r\n\t\t\tpipelineFilter = strings.TrimPrefix(arg, \"--pipeline=\")\r\n\t\tcase arg == \"--status\":\r\n\t\t\tif i+1 >= len(args) {\r\n"]
[11883.998198, "o", "\t\t\t\tprintError(\"--status requires a value\")\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tstatusFilter = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(arg, \"--status=\"):\r\n\t\t\tstatusFilter = strings.TrimPrefix(arg, \"--status=\")\r\n\t\tcase arg == \"--limit\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tprintError(\"--limit requires a value\")\r\n\t"]
[11883.998281, "o", "\t\t\treturn\r\n\t\t\t}\r\n\t\t\tn, err := strconv.Atoi(args[i+1])\r\n\t\t\tif err != nil {\r\n\t\t\t\tprintError(\"--limit requires an integer\")\r\n\t\t\t\treturn\r\n"]
[11883.998339, "o", "\t\t\t}\r\n\t\t\tlimit = n\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(arg, \"--limit=\"):\r\n\t\t\tn, err := strconv.Atoi(strings.TrimPrefix(arg, \"--limit=\"))\r\n"]
[11883.998685, "o", "\u001b[?2004hroot@n30009:/app# "]
[11884.280087, "i", "sed -n '1,230p' diff.go\n"]
[11884.280377, "o", "sed -n '1,230p' diff.go\r\n\u001b[?2004l\r"]
[11884.283553, "o", "package main\r\n\r\nimport (\r\n\t\"reflect\"\r\n\t\"sort\"\r\n)\r\n\r\n"]
[11884.28364, "o", "type StageDiff struct {\r\n\tTypeChanged   *FieldDiff           `json:\"type_changed,omitempty\"`\r\n\tParamsChanged map[string]FieldDiff `json:\"params_changed,omitempty\"`\r\n\tDepsChanged   *ListDiff            `json:\"deps_changed,omitempty\"`\r\n\tInputsChanged map[string]FieldDiff `json:\"inputs_changed,omitempty\"`\r\n}\r\n\r\ntype FieldDiff struct {\r\n\tOld interface{} `json:\"old\"`\r\n\tNew interface{} `json:\"new\"`\r\n}\r\n\r\ntype ListDiff struct {\r\n\tOld []string `json:\"old\"`\r\n\tNew []string `json:\"new\"`\r\n}\r\n"]
[11884.283731, "o", "\r\ntype ConfigDiff struct {\r\n\tPipelineName    *FieldDiff           `json:\"pipeline_name,omitempty\"`\r\n\tStagesAdded     []string             `json:\"stages_added\"`\r\n\tStagesRemoved   []string             `json:\"stages_removed\"`\r\n\tStagesModified  map[string]StageDiff `json:\"stages_modified\"`\r\n\tStagesUnchanged []string             `json:\"stages_unchanged\"`\r\n}\r\n\r\nfunc cmdDiff(args []string) {\r\n\tif len(args) != 2 {\r\n\t\texitError(\"usage: mlpipe diff <config1.json> <config2.json>\")\r\n\t\treturn\r\n\t}\r\n"]
[11884.283857, "o", "\tconfig1, err := loadConfig(args[0])\r\n\tif err != nil {\r\n\t\texitError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig2, err := loadConfig(args[1])\r\n\tif err != nil {\r\n\t\texitError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(diffConfigs(config1, config2))\r\n}\r\n\r\nfunc diffConfigs(c1, c2 *Config) ConfigDiff {\r\n\tresult := ConfigDiff{\r\n\t\tStagesAdded:     []string{},\r\n\t\tStagesRemoved:   []string{},\r\n\t\tStagesModified:  map[string]StageDiff{},\r\n\t\tStagesUnchanged: []string{},\r\n\t}\r\n\r\n"]
[11884.28392, "o", "\tif c1.Pipeline.Name != c2.Pipeline.Name {\r\n\t\tresult.PipelineName = &FieldDiff{Old: c1.Pipeline.Name, New: c2.Pipeline.Name}\r\n\t}\r\n\r\n\tstages1 := map[string]StageConfig{}\r\n\tfor _, s := range c1.Stages {\r\n\t\tstages1[s.Name] = s\r\n\t}\r\n\tstages2 := map[string]StageConfig{}\r\n\tfor _, s := range c2.Stages {\r\n\t\t"]
[11884.283992, "o", "stages2[s.Name] = s\r\n\t}\r\n\r\n\tallNames := map[string]bool{}\r\n\tfor name := range stages1 {\r\n\t\tallNames[name] = true\r\n\t}\r\n\tfor name := range stages2 {\r\n\t\tallNames[name] = true\r\n\t}\r\n\r\n"]
[11884.284053, "o", "\tnames := make([]string, 0, len(allNames))\r\n\tfor name := range allNames {\r\n\t\tnames = append(names, name)\r\n\t}\r\n\tsort.Strings(names)\r\n\r\n\tfor _, name := range names {\r\n\t\ts1, ok1 := stages1[name]\r\n\t\ts2, ok2 := stages2[name]\r\n\t\tif !ok1 {\r\n"]
[11884.284109, "o", "\t\t\tresult.StagesAdded = append(result.StagesAdded, name)\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif !ok2 {\r\n\t\t\tresult.StagesRemoved = append(result.StagesRemoved, name)\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tdiff := diffStages(s1, s2)\r\n\t"]
[11884.284166, "o", "\tif diff == nil {\r\n\t\t\tresult.StagesUnchanged = append(result.StagesUnchanged, name)\r\n\t\t} else {\r\n\t\t\tresult.StagesModified[name] = *diff\r\n\t\t}\r\n\t}\r\n\r\n\treturn result\r\n}\r\n"]
[11884.284235, "o", "\r\nfunc diffStages(s1, s2 StageConfig) *StageDiff {\r\n\tdiff := StageDiff{\r\n\t\tParamsChanged: map[string]FieldDiff{},\r\n\t\tInputsChanged: map[string]FieldDiff{},\r\n\t}\r\n\tchanged := false\r\n\r\n\tif s1.Type != s2.Type {\r\n"]
[11884.284294, "o", "\t\tdiff.TypeChanged = &FieldDiff{Old: s1.Type, New: s2.Type}\r\n\t\tchanged = true\r\n\t}\r\n\r\n\tif !sameStringList(s1.DependsOn, s2.DependsOn) {\r\n\t\tdiff.DepsChanged = &ListDiff{Old: s1.DependsOn, New: s2.DependsOn}\r\n\t\tchanged = true\r\n\t}\r\n\r\n"]
[11884.284352, "o", "\tif !sameMap(s1.Params, s2.Params) {\r\n\t\tallKeys := map[string]bool{}\r\n\t\tfor k := range s1.Params {\r\n\t\t\tallKeys[k] = true\r\n\t\t}\r\n\t\tfor k := range s2.Params {\r\n\t\t\tallKeys[k] = true\r\n\t\t}\r\n"]
[11884.284414, "o", "\t\tkeys := make([]string, 0, len(allKeys))\r\n\t\tfor k := range allKeys {\r\n\t\t\tkeys = append(keys, k)\r\n\t\t}\r\n\t\tsort.Strings(keys)\r\n\t\tfor _, k := range keys {\r\n\t\t\tv1, ok1 := s1.Params[k]\r\n\t\t\tv2, ok2 := s2.Params[k]\r\n\t\t\tif ok1 && ok2 {\r\n"]
[11884.28447, "o", "\t\t\t\tif !reflect.DeepEqual(v1, v2) {\r\n\t\t\t\t\tdiff.ParamsChanged[k] = FieldDiff{Old: v1, New: v2}\r\n\t\t\t\t}\r\n\t\t\t} else if ok1 {\r\n\t\t\t\tdiff.ParamsChanged[k] = FieldDiff{Old: v1, New: nil}\r\n\t\t\t} else {\r\n\t\t\t\tdiff.ParamsChanged[k] = FieldDiff{Old: nil, New: v2}\r\n\t\t\t}\r\n\t\t}\r\n\t\t"]
[11884.284529, "o", "if len(diff.ParamsChanged) > 0 {\r\n\t\t\tchanged = true\r\n\t\t} else {\r\n\t\t\tdiff.ParamsChanged = nil\r\n\t\t}\r\n\t}\r\n\r\n\tif !sameMap(s1.Inputs, s2.Inputs) {\r\n\t\tallKeys := map[string]bool{}\r\n\t\tfor k := range s1.Inputs {\r\n\t\t"]
[11884.284589, "o", "\tallKeys[k] = true\r\n\t\t}\r\n\t\tfor k := range s2.Inputs {\r\n\t\t\tallKeys[k] = true\r\n\t\t}\r\n\t\tkeys := make([]string, 0, len(allKeys))\r\n\t\tfor k := range allKeys {\r\n\t\t\tkeys = append(keys, k)\r\n\t\t}\r\n"]
[11884.284645, "o", "\t\tsort.Strings(keys)\r\n\t\tfor _, k := range keys {\r\n\t\t\tv1, ok1 := s1.Inputs[k]\r\n\t\t\tv2, ok2 := s2.Inputs[k]\r\n\t\t\tif ok1 && ok2 {\r\n\t\t\t\tif !reflect.DeepEqual(v1, v2) {\r\n"]
[11884.284703, "o", "\t\t\t\t\tdiff.InputsChanged[k] = FieldDiff{Old: v1, New: v2}\r\n\t\t\t\t}\r\n\t\t\t} else if ok1 {\r\n\t\t\t\tdiff.InputsChanged[k] = FieldDiff{Old: v1, New: nil}\r\n\t\t\t} else {\r\n\t\t\t\tdiff.InputsChanged[k] = FieldDiff{Old: nil, New: v2}\r\n\t\t\t}\r\n\t\t}\r\n\t\t"]
[11884.28477, "o", "if len(diff.InputsChanged) > 0 {\r\n\t\t\tchanged = true\r\n\t\t} else {\r\n\t\t\tdiff.InputsChanged = nil\r\n\t\t}\r\n\t}\r\n\r\n\tif !changed {\r\n\t\treturn nil\r\n\t}\r\n\treturn &diff\r\n}\r\n"]
[11884.284834, "o", "\r\nfunc sameStringList(a, b []string) bool {\r\n\tif len(a) != len(b) {\r\n\t\treturn false\r\n\t}\r\n\tfor i := range a {\r\n\t\tif a[i] != b[i] {\r\n\t\t\treturn false\r\n\t\t}\r\n"]
[11884.284891, "o", "\t}\r\n\treturn true\r\n}\r\n\r\nfunc sameMap(a, b map[string]interface{}) bool {\r\n\tif len(a) != len(b) {\r\n\t\treturn false\r\n\t}\r\n\tfor k, v := range a {\r\n\t\tbv, ok := b[k]\r\n"]
[11884.284946, "o", "\t\tif !ok || !reflect.DeepEqual(v, bv) {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n"]
