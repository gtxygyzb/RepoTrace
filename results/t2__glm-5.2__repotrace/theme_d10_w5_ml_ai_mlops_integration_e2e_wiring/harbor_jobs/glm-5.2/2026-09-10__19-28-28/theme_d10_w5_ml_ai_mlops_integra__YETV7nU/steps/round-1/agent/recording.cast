[10932.441784, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n"]
[10932.441862, "o", "\t\"strings\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintError(\"usage: mlpipe <command> [args]\")\r\n\t\treturn\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"plan\":\r\n\t\tcmdPlan(args)\r\n\t"]
[10932.441929, "o", "case \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"registry\":\r\n\t\tcmdRegistry(args)\r\n\tcase \"lineage\":\r\n\t\tcmdLineage(args)\r\n\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n\t}\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n"]
[10932.441993, "o", "\tconfigPath, overrides, cv, noCache, skipStages, err := parseRunArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tfor _, name := range skipStages {\r\n"]
[10932.442078, "o", "\t\tif _, ok := config.stageByName(name); !ok {\r\n\t\t\tprintError(fmt.Sprintf(\"unknown stage: %s\", name))\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n\texecutor := NewExecutor(config, overrides)\r\n\texecutor.noCache = noCache\r\n\texecutor.skipStages = skipStages\r\n\tif noCache {\r\n\t\texecutor.cacheStats = nil\r\n"]
[10932.442145, "o", "\t}\r\n\texecutor.cvFolds = cv\r\n\tvar run interface{}\r\n\tif cv > 0 {\r\n\t\trun, err = executor.RunCV()\r\n\t} else {\r\n\t\trun, err = executor.Run()\r\n\t}\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(run)\r\n}\r\n\r\nfunc cmdPlan(args []string) {\r\n\tconfigPath, overrides, cv, err := parsePlanArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n"]
[10932.44221, "o", "\tplan, err := buildPlan(config, overrides, cv)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(plan)\r\n}\r\n\r\nfunc cmdValidate(args []string) {\r\n\tconfigPath := \"\"\r\n\toverrides := map[string]string{}\r\n\tfail := func(msg string) {\r\n\t\tprintJSON(map[string]interface{}{\"valid\": false, \"errors\": []string{msg}})\r\n\t}\r\n"]
[10932.442308, "o", "\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--param\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfail(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tkv := args[i+1]\r\n\t\t\ti++\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n"]
[10932.442388, "o", "\t\t\t\tfail(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tcase strings.HasPrefix(args[i], \"--param=\"):\r\n\t\t\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\tfail(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\t"]
[10932.442476, "o", "overrides[k] = v\r\n"]
