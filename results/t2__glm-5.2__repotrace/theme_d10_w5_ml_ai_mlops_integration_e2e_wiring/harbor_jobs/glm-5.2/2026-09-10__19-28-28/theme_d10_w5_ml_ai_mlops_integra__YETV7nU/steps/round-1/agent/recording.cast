[12486.943923, "o", "    80\t}\r\n    81\t\r\n    82\tfunc buildRunRecord(executor *Executor, startedAt time.Time, finishedAt time.Time, status string) *RunRecord {\r\n    83\t\tmode := \"standard\"\r\n    84\t\tvar cvFolds *int\r\n    85\t\tif executor.cvFolds > 0 {\r\n    86\t\t\tmode = \"cv\"\r\n    87\t\t\tf := executor.cvFolds\r\n    88\t\t\tcvFolds = &f\r\n    89\t\t}\r\n    90\t\r\n    91\t\tskipped := []string{}\r\n    92\t\tskipped = append(skipped, executor.skipStages...)\r\n    93\t\r\n    94\t\tsummary := map[string]interface{}{}\r\n    95\t\tfor name, r := range executor.results {\r\n    96\t\t\tif r == nil {\r\n    97\t\t\t\tcontinue\r\n    98\t\t\t}\r\n    99\t\t\tsummary[name] = StageSummary{\r\n   100\t\t\t\tStatus:     r.Status,\r\n   101\t\t\t\tCacheHit:   r.CacheHit,\r\n   102\t\t\t\tDurationMs: r.DurationMs,\r\n   103\t\t\t}\r\n"]
[12486.944028, "o", "   104\t\t}\r\n   105\t\tif len(executor.foldResults) > 0 {\r\n   106\t\t\tfolds := map[string]FoldSummary{}\r\n   107\t\t\tfor _, fr := range executor.foldResults {\r\n   108\t\t\t\tfoldStages := FoldSummary{}\r\n   109\t\t\t\tfor stageName, r := range fr.Stages {\r\n   110\t\t\t\t\tif r == nil {\r\n   111\t\t\t\t\t\tcontinue\r\n   112\t\t\t\t\t}\r\n   113\t\t\t\t\tfoldStages[stageName] = FoldStageSummary{Status: r.Status, CacheHit: r.CacheHit}\r\n   114\t\t\t\t}\r\n"]
[12486.944103, "o", "   115\t\t\t\tfolds[strconv.Itoa(fr.Fold)] = foldStages\r\n   116\t\t\t}\r\n   117\t\t\tsummary[\"folds\"] = folds\r\n   118\t\t}\r\n   119\t\r\n   120\t\tvar cacheStats *CacheStats\r\n"]
