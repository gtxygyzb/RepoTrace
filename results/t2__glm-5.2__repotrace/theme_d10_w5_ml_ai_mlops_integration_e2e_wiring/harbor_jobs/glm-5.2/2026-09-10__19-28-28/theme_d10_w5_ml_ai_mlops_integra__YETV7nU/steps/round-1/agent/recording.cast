[8811.311282, "o", "\t\tcase strings.HasPrefix(args[i], \"--cv=\"):\r\n\t\t\tval := strings.TrimPrefix(args[i], \"--cv=\")\r\n\t\t\tk, err := strconv.Atoi(val)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn \"\", nil, 0, fmt.Errorf(\"invalid cv folds: %s\", val)\r\n\t\t\t}\r\n\t\t\tif k < 2 {\r\n\t\t\t\treturn \"\", nil, 0, fmt.Errorf(\"cv folds must be >= 2\")\r\n\t\t\t}\r\n\t\t\tcv = k\r\n\t\tcase args[i] == \"--param\":\r\n\t\t\t"]
