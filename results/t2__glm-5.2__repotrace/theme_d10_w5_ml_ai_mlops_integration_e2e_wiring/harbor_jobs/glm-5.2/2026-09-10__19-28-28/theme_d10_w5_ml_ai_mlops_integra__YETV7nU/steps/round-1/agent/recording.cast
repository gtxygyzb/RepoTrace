[10913.178781, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n"]
[10913.178851, "o", "\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\ntype ArtifactValue struct {\r\n\tDataset *Dataset\r\n\tModel   *Model\r\n\tReport  *Report\r\n\tEntry   *RegistryEntry\r\n}\r\n\r\ntype ArtifactMeta struct {\r\n\tID        string                 `json:\"id\"`\r\n"]
[10913.178914, "o", "\tStage     string                 `json:\"stage\"`\r\n\tPort      string                 `json:\"port\"`\r\n\tType      string                 `json:\"type\"`\r\n\tSummary   map[string]interface{} `json:\"summary\"`\r\n\tInputs    []string               `json:\"inputs\"`\r\n\tOutputs   []string               `json:\"outputs\"`\r\n\tTimestamp int64                  `json:\"timestamp\"`\r\n}\r\n\r\ntype ArtifactOutput struct {\r\n"]
[10913.178984, "o", "\tStage   string                 `json:\"stage\"`\r\n\tPort    string                 `json:\"port\"`\r\n\tType    string                 `json:\"type\"`\r\n\tSummary map[string]interface{} `json:\"summary\"`\r\n}\r\n\r\ntype StageResult struct {\r\n\tStatus     string            `json:\"status\"`\r\n\tCacheHit   bool              `json:\"cache_hit,omitempty\"`\r\n\tDurationMs int64             `json:\"duration_ms\"`\r\n\tOutputs    map[string]string `json:\"outputs\"`\r\n\tError      string            `json:\"error,omitempty\"`\r\n}\r\n\r\n"]
[10913.179048, "o", "type RunOutput struct {\r\n\tPipeline   string                     `json:\"pipeline\"`\r\n\tStatus     string                     `json:\"status\"`\r\n\tStages     map[string]*StageResult    `json:\"stages\"`\r\n\tArtifacts  map[string]*ArtifactOutput `json:\"artifacts\"`\r\n\tCacheStats *CacheStats                `json:\"cache_stats,omitempty\"`\r\n}\r\n\r\ntype CacheStats struct {\r\n\tHits   int `json:\"hits\"`\r\n"]
[10913.179115, "o", "\tMisses int `json:\"misses\"`\r\n}\r\n\r\ntype Executor struct {\r\n\tconfig     *Config\r\n\tglobals    map[string]interface{}\r\n\tstatus     map[string]string\r\n\tresults    map[string]*StageResult\r\n\toutputs    map[string]map[string]string\r\n\tvalues     map[string]map[string]*ArtifactValue\r\n\tmeta       map[string]*ArtifactMeta\r\n\tcacheKeys  map[string]string\r\n\t"]
[10913.179175, "o", "noCache    bool\r\n\tcvFolds    int\r\n\tskipStages []string\r\n\tcacheStats *CacheStats\r\n}\r\n\r\nfunc NewExecutor(config *Config, overrides map[string]string) *Executor {\r\n\treturn &Executor{\r\n\t\tconfig:     config,\r\n\t\tglobals:    config.globalParams(overrides),\r\n"]
[10913.179244, "o", "\t\tstatus:     map[string]string{},\r\n\t\tresults:    map[string]*StageResult{},\r\n\t\toutputs:    map[string]map[string]string{},\r\n\t\tvalues:     map[string]map[string]*ArtifactValue{},\r\n\t\tmeta:       map[string]*ArtifactMeta{},\r\n\t\tcacheKeys:  map[string]string{},\r\n\t\tcacheStats: &CacheStats{},\r\n\t}\r\n}\r\n\r\nfunc (e *Executor) Run() (*RunOutput, error) {\r\n"]
[10913.179307, "o", "\tvalid, errs := e.config.Validate()\r\n\tif !valid {\r\n\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n\t}\r\n\torder, err := e.config.topologicalOrder()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\trunArtifacts := map[string]*ArtifactOutput{}\r\n"]
[10913.179366, "o", "\r\n\tskipSet := map[string]bool{}\r\n\tfor _, name := range e.skipStages {\r\n\t\tskipSet[name] = true\r\n\t}\r\n\r\n\tonFailure := e.config.Pipeline.OnFailure\r\n\tif onFailure != \"continue\" {\r\n"]
[10913.179431, "o", "\t\tonFailure = \"stop\"\r\n\t}\r\n\tstopped := false\r\n\r\n\tfor _, name := range order {\r\n\t\tstage, _ := e.config.stageByName(name)\r\n\t\te.outputs[name] = map[string]string{}\r\n\t\te.values[name] = map[string]*ArtifactValue{}\r\n\t\te.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n\r\n\t\tif stopped {\r\n\t\t\te.status[name] = \"skipped\"\r\n"]
[10913.179497, "o", "\t\t\te.results[name].Status = \"skipped\"\r\n\t\t\te.results[name].DurationMs = 0\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tif skipSet[name] {\r\n\t\t\te.status[name] = \"skipped\"\r\n\t"]
[10913.179557, "o", "\t\te.results[name].Status = \"skipped\"\r\n\t\t\te.results[name].DurationMs = 0\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tskip := false\r\n\t\tfor _, dep := range stage.DependsOn {\r\n\t\t\tdepStatus := e.status[dep]\r\n\t\t\tif depStatus != \"success\" {\r\n\t\t\t\tskip = true\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif skip {\r\n"]
[10913.179621, "o", "\t\t\te.status[name] = \"skipped\"\r\n\t\t\te.results[name].Status = \"skipped\"\r\n\t\t\te.results[name].DurationMs = 0\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tinputValues, inputIDs, err := e.resolveInputs(stage)\r\n\t\tif err != nil {\r\n\t\t\te.status[name] = \"failed\"\r\n\t\t\te.results[name].Status = \"failed\"\r\n"]
[10913.179682, "o", "\t\t\te.results[name].Error = err.Error()\r\n\t\t\tif onFailure == \"stop\" {\r\n\t\t\t\tstopped = true\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tparams := e.config.stageParams(name, e.globals)\r\n"]
[10913.179745, "o", "\t\tinputKeys := e.inputCacheKeys(stage)\r\n\t\tcacheKey, keyErr := computeCacheKey(stage, params, inputKeys, -1)\r\n\t\tif keyErr != nil {\r\n\t\t\te.status[name] = \"failed\"\r\n\t\t\te.results[name].Status = \"failed\"\r\n\t\t\te.results[name].Error = keyErr.Error()\r\n\t\t\tif onFailure == \"stop\" {\r\n\t\t\t\tstopped = true\r\n\t\t\t\tcontinue\r\n\t"]
[10913.17981, "o", "\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\te.cacheKeys[name] = cacheKey\r\n\r\n\t\tvar out map[string]*ArtifactValue\r\n"]
[10913.179873, "o", "\t\tstart := time.Now()\r\n\t\tif !e.noCache && cacheEntryExists(cacheKey) {\r\n\t\t\tloaded, err := loadCacheEntry(cacheKey)\r\n\t\t\tduration := time.Since(start).Milliseconds()\r\n\t\t\te.results[name].DurationMs = duration\r\n\t\t\tif err == nil {\r\n\t\t\t\tout = loaded\r\n"]
[10913.1804, "o", "\u001b[?2004h"]
[10913.180457, "o", "root@n30009:/app# "]
[10913.457866, "i", "sed -n '180,560p' pipeline.go\n"]
[10913.458144, "o", "sed -n '180,560p' pipeline.go\r\n\u001b[?2004l\r"]
[10913.461318, "o", "\t\t\t\tout = loaded\r\n\t\t\t\te.results[name].CacheHit = true\r\n\t\t\t\te.cacheStats.Hits++\r\n\t\t"]
[10913.461399, "o", "\t} else {\r\n\t\t\t\tif !e.noCache {\r\n\t\t\t\t\te.cacheStats.Misses++\r\n\t\t\t\t}\r\n\t\t\t\tout, err = executeStage(stage, params, inputValues)\r\n\t\t\t\tduration = time.Since(start).Milliseconds()\r\n\t\t\t\te.results[name].DurationMs = duration\r\n\t\t\t\tif err != nil {\r\n\t\t\t\t\te.status[name] = \"failed\"\r\n\t\t\t\t\te.results[name].Status = \"failed\"\r\n\t\t\t\t\te.results[name].Error = err.Error()\r\n"]
[10913.46148, "o", "\t\t\t\t\tif onFailure == \"stop\" {\r\n\t\t\t\t\t\tstopped = true\r\n\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n"]
[10913.461543, "o", "\t\t\t}\r\n\t\t} else {\r\n\t\t\tvar err error\r\n\t\t\tout, err = executeStage(stage, params, inputValues)\r\n\t\t\tduration := time.Since(start).Milliseconds()\r\n\t\t\te.results[name].DurationMs = duration\r\n\t\t\tif err != nil {\r\n\t\t\t\te.status[name] = \"failed\"\r\n\t\t\t\te.results[name].Status = \"failed\"\r\n\t\t\t\te.results[name].Error = err.Error()\r\n\t\t\t\tif onFailure == \"stop\" {\r\n\t\t\t\t\tstopped = true\r\n\t\t\t\t\tcontinue\r\n"]
[10913.461604, "o", "\t\t\t\t}\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif !e.noCache {\r\n\t\t\t\t_ = saveCacheEntry(cacheKey, name, stage.Type, out)\r\n\t\t\t}\r\n\t\t\tif !e.noCache {\r\n\t\t\t\te.cacheStats.Misses++\r\n\t\t\t}\r\n\t\t}\r\n"]
[10913.461667, "o", "\r\n\t\te.status[name] = \"success\"\r\n\t\te.results[name].Status = \"success\"\r\n\t\tts := time.Now().UnixNano()\r\n\r\n\t\tfor port, val := range out {\r\n\t\t\tid := artifactID(e.config.Pipeline.Name, name, port, ts)\r\n\t\t\te.values[name][port] = val\r\n\t\t\te.outputs[name][port] = id\r\n"]
[10913.461727, "o", "\t\t\ttyp := val.Type()\r\n\t\t\tsummary := val.Summary()\r\n\t\t\tmeta := &ArtifactMeta{\r\n\t\t\t\tID:        id,\r\n\t\t\t\tStage:     name,\r\n\t\t\t\tPort:      port,\r\n\t\t\t\tType:      typ,\r\n\t\t\t\tSummary:   summary,\r\n\t\t"]
[10913.461785, "o", "\t\tInputs:    inputIDs,\r\n\t\t\t\tOutputs:   []string{},\r\n\t\t\t\tTimestamp: ts,\r\n\t\t\t}\r\n\t\t\te.meta[id] = meta\r\n\t\t\tfor _, inID := range inputIDs {\r\n\t\t\t\tif parent, ok := e.meta[inID]; ok {\r\n"]
[10913.461847, "o", "\t\t\t\t\tparent.Outputs = appendUnique(parent.Outputs, id)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\trunArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n\t\t}\r\n\t}\r\n\r\n\tstatus := \"success\"\r\n\tfor _, s := range e.results {\r\n\t\tif s.Status == \"failed\" {\r\n\t\t\tstatus = \"failed\"\r\n\t\t\tbreak\r\n\t"]
[10913.461905, "o", "\t}\r\n\t}\r\n\r\n\trun := &RunOutput{\r\n\t\tPipeline:   e.config.Pipeline.Name,\r\n\t\tStatus:     status,\r\n\t\tStages:     e.results,\r\n\t\tArtifacts:  runArtifacts,\r\n"]
[10913.461968, "o", "\t\tCacheStats: e.cacheStats,\r\n\t}\r\n\r\n\tif err := saveArtifacts(e.meta); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif err := saveRunAny(e.config.Pipeline.Name, run); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\treturn run, nil\r\n}\r\n\r\nfunc (e *Executor) inputCacheKeys(stage *StageConfig) map[string]string {\r\n\tkeys := map[string]string{}\r\n"]
[10913.462028, "o", "\tfor local, ref := range stage.Inputs {\r\n\t\trefs, ok := inputRefs(ref)\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfor _, r := range refs {\r\n\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n\t\t\tif len(parts) != 2 {\r\n\t\t\t\tcontinue\r\n\t\t\t}"]
[10913.462091, "o", "\r\n\t\t\tdepStage := parts[0]\r\n\t\t\tif key, ok := e.cacheKeys[depStage]; ok {\r\n\t\t\t\tkeys[local] = keys[local] + key + \"\\n\"\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tfor k, v := range keys {\r\n\t\tkeys[k] = strings.TrimRight(v, \"\\n\")\r\n\t}\r\n\treturn keys\r\n"]
[10913.462149, "o", "}\r\n\r\nfunc (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {\r\n\tinputs := map[string]*ArtifactValue{}\r\n\tids := []string{}\r\n\tfor local, ref := range stage.Inputs {\r\n\t\trefs, ok := inputRefs(ref)\r\n\t\tif !ok {\r\n\t\t\t"]
[10913.462212, "o", "return nil, nil, fmt.Errorf(\"stage %q input %q has invalid reference %v\", stage.Name, local, ref)\r\n\t\t}\r\n\t\tvar firstVal *ArtifactValue\r\n\t\tfor _, r := range refs {\r\n\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n\t\t\tif len(parts) != 2 {\r\n\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q has invalid input reference %q\", stage.Name, r)\r\n\t\t\t}\r\n\t\t\tdepStage, port := parts[0], parts[1]\r\n"]
[10913.462358, "o", "\t\t\tid, ok := e.outputs[depStage][port]\r\n\t\t\tif !ok {\r\n\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable output %s.%s\", stage.Name, local, depStage, port)\r\n\t\t\t}\r\n\t\t\tval, ok := e.values[depStage][port]\r\n\t\t\tif !ok || val == nil {\r\n\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable artifact %s.%s\", stage.Name, local, depStage, port)\r\n\t\t\t}\r\n\t\t\tids = append(ids, id)\r\n\t\t\tif firstVal == nil {\r\n\t\t\t\tfirstVal = val\r\n\t\t\t}\r\n\t\t\tif stage.Type == \"ensemble\" && local == \"models\" {\r\n\t\t\t\tinputs[local+\"_\"+r] = val\r\n\t\t\t}\r\n\t\t}\r\n\t\tif _, exists := inputs[local]; !exists {\r\n\t\t\tinputs[local] = firstVal\r\n\t\t}\r\n\t}"]
[10913.462418, "o", "\r\n\treturn inputs, ids, nil\r\n}\r\n\r\nfunc executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tswitch stage.Type {\r\n\tcase \"data-source\":\r\n\t\treturn executeDataSource(stage, params, inputs)\r\n\tcase \"transform\":\r\n\t\treturn executeTransform(stage, params, inputs)\r\n"]
[10913.462488, "o", "\tcase \"split\":\r\n\t\treturn executeSplit(stage, params, inputs)\r\n\tcase \"train\":\r\n\t\treturn executeTrain(stage, params, inputs)\r\n\tcase \"evaluate\":\r\n\t\t"]
[10913.462564, "o", "return executeEvaluate(stage, params, inputs)\r\n\tcase \"register\":\r\n\t\treturn executeRegister(stage, params, inputs)\r\n\tcase \"ensemble\":\r\n\t\treturn executeEnsemble(stage, params, inputs)\r\n\t}\r\n\treturn nil, fmt.Errorf(\"unknown stage type %q\", stage.Type)\r\n}\r\n\r\nfunc executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tpath, ok := getString(params, \"path\")\r\n"]
[10913.462625, "o", "\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"data-source stage %q requires path\", stage.Name)\r\n\t}\r\n\tschema, _ := getMap(params, \"schema\")\r\n\tds, err := loadDataset(path, schema)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn map[string]*ArtifactValue{\"data\": {Dataset: ds}}, nil\r\n}\r\n\r\nfunc (c *Config) topologicalOrder() ([]string, error) {\r\n\tindeg := map[string]int{}\r\n\tadj := map[string][]string{}\r\n\tfor _, s := range c.Stages {\r\n\t\tindeg[s.Name] = 0\r\n\t}\r\n\tfor _, s := range c.Stages {"]
[10913.462692, "o", "\r\n\t\tfor _, dep := range s.DependsOn {\r\n\t\t\tif _, ok := c.stageByName(dep); ok {\r\n\t\t\t\tadj[dep] = append(adj[dep], s.Name)\r\n\t\t\t\tindeg[s.Name]++\r\n"]
[10913.462754, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\tqueue := []string{}\r\n\tfor _, s := range c.Stages {\r\n\t\tif indeg[s.Name] == 0 {\r\n\t\t\tqueue = append(queue, s.Name)\r\n\t\t}\r\n\t}\r\n\torder := []string{}\r\n\tfor len(queue) > 0 {\r\n\t\tnode := queue[0]\r\n\t\tqueue = queue[1:]\r\n\t\torder = append(order, node)\r\n"]
[10913.462812, "o", "\t\tfor _, next := range adj[node] {\r\n\t\t\tindeg[next]--\r\n\t\t\tif indeg[next] == 0 {\r\n\t\t\t\tqueue = append(queue, next)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif len(order) < len(c.Stages) {\r\n"]
[10913.462887, "o", "\t\tif cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {\r\n\t\t\treturn nil, fmt.Errorf(\"cycle detected involving stages: %s\", strings.Join(cycle, \", \"))\r\n\t\t}\r\n\t\treturn nil, fmt.Errorf(\"cycle detected involving stages: %s\", joinStageNames(c.Stages))\r\n\t}\r\n\treturn order, nil\r\n}\r\n\r\nfunc joinStageNames(stages []StageConfig) string {\r\n\tnames := []string{}\r\n\tfor _, s := range stages {\r\n\t\tnames = append(names, s.Name)\r\n\t}\r\n"]
[10913.462951, "o", "\treturn strings.Join(names, \", \")\r\n}\r\n\r\nfunc artifactID(pipeline, stage, port string, ts int64) string {\r\n\tif pipeline == \"\" {\r\n\t\tpipeline = \"pipeline\"\r\n\t}\r\n"]
[10913.463017, "o", "\treturn fmt.Sprintf(\"%s-%s-%s-%d\", pipeline, stage, port, ts)\r\n}\r\n\r\nfunc (v *ArtifactValue) Type() string {\r\n\tif v.Dataset != nil {\r\n\t\treturn \"dataset\"\r\n\t}\r\n\tif v.Model != nil {\r\n\t\treturn \"model\"\r\n\t}\r\n\tif v.Report != nil {\r\n\t\treturn \"report\"\r\n\t}\r\n\tif v.Entry != nil {\r\n\t\treturn \"entry\"\r\n\t}\r\n"]
[10913.463075, "o", "\treturn \"unknown\"\r\n}\r\n\r\nfunc (v *ArtifactValue) Summary() map[string]interface{} {\r\n\tif v.Dataset != nil {\r\n\t\treturn v.Dataset.Summary()\r\n\t}\r\n\tif v.Model != nil {\r\n\t\tsummary := map[string]interface{}{\r\n\t\t\t\"algorithm\":   v.Model.Algorithm,\r\n"]
[10913.463136, "o", "\t\t\t\"target\":      v.Model.Target,\r\n\t\t\t\"features\":    v.Model.Features,\r\n\t\t\t\"hyperparams\": v.Model.Hyperparams,\r\n\t\t}\r\n\t\tif len(v.Model.EnsembleModels) > 0 {\r\n\t\t\tsummary[\"ensemble_models\"] = v.Model.EnsembleModels\r\n\t\t}\r\n\t\tif v.Model.ModelData != nil {\r\n\t\t\tsummary[\"model_data\"] = v.Model.ModelData\r\n"]
[10913.463199, "o", "\t\t}\r\n\t\treturn summary\r\n\t}\r\n\tif v.Report != nil {\r\n\t\treturn v.Report.Summary()\r\n\t}\r\n\tif v.Entry != nil {\r\n\t\treturn map[string]interface{}{\r\n\t\t\t\"name\":    v.Entry.Name,\r\n\t\t\t\"version\": v.Entry.Version,\r\n"]
[10913.463277, "o", "\t\t\t\"stage\":   v.Entry.Stage,\r\n\t\t}\r\n\t}\r\n\treturn map[string]interface{}{}\r\n}\r\n\r\nfunc inputDataset(inputs map[string]*ArtifactValue) *Dataset {\r\n\tfor _, in := range inputs {\r\n\t\tif in != nil && in.Dataset != nil {\r\n\t\t\treturn in.Dataset\r\n\t\t}\r\n"]
[10913.463336, "o", "\t}\r\n\treturn nil\r\n}\r\n\r\nfunc appendUnique(s []string, v string) []string {\r\n\tfor _, x := range s {\r\n\t\tif x == v {\r\n\t\t\treturn s\r\n\t\t}\r\n\t}\r\n"]
[10913.463412, "o", "\treturn append(s, v)\r\n}\r\n\r\nfunc artifactsPath() string {\r\n\treturn filepath.Join(\".mlpipe\", \"artifacts.json\")\r\n}\r\n\r\nfunc loadArtifacts() (map[string]*ArtifactMeta, error) {\r\n\tdata, err := os.ReadFile(artifactsPath())\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn map[string]*ArtifactMeta{}, nil\r\n\t\t"]
[10913.463472, "o", "}\r\n\t\treturn nil, err\r\n\t}\r\n\tvar m map[string]*ArtifactMeta\r\n\tif err := json.Unmarshal(data, &m); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif m == nil {\r\n\t\tm = map[string]*ArtifactMeta{}\r\n\t}\r\n"]
[10913.463534, "o", "\treturn m, nil\r\n}\r\n\r\nfunc saveArtifacts(newMeta map[string]*ArtifactMeta) error {\r\n\texisting, err := loadArtifacts()\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tfor k, v := range newMeta {\r\n\t\texisting[k] = v\r\n"]
[10913.46359, "o", "\t}\r\n\tif err := os.MkdirAll(\".mlpipe\", 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdata, err := json.MarshalIndent(existing, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(artifactsPath(), data, 0644)\r\n"]
[10913.463648, "o", "}\r\n\r\nfunc saveRunAny(pipelineName string, run interface{}) error {\r\n\tdir := filepath.Join(\".mlpipe\", \"runs\")\r\n\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tname := safeFileName(pipelineName)\r\n\tif name == \"\" {\r\n\t\tname = \"pipeline\"\r\n\t}"]
[10913.46371, "o", "\r\n\tpath := filepath.Join(dir, fmt.Sprintf(\"%s-%d.json\", name, time.Now().UnixNano()))\r\n\tdata, err := json.MarshalIndent(run, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(path, data, 0644)\r\n}\r\n\r\nfunc safeFileName(s string) string {\r\n\tif s == \"\" {\r\n"]
[10913.463777, "o", "\t\treturn \"pipeline\"\r\n\t}\r\n\treturn strings.Map(func(r rune) rune {\r\n\t\tif r == '/' || r == '\\\\' || r == ':' || r == ' ' {\r\n\t\t\treturn '_'\r\n"]
