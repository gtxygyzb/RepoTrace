[11870.621577, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"math/rand\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n"]
[11870.62167, "o", ")\r\n\r\ntype CVFoldResult struct {\r\n\tFold   int                     `json:\"fold\"`\r\n\tStatus string                  `json:\"status\"`\r\n\tStages map[string]*StageResult `json:\"stages\"`\r\n}\r\n\r\ntype CVMetricAgg struct {\r\n\tMean    float64   `json:\"mean\"`\r\n\tStd     float64   `json:\"std\"`\r\n\tPerFold []float64 `json:\"per_fold\"`\r\n}\r\n\r\ntype CVResults struct {\r\n\tMetrics map[string]CVMetricAgg `json:\"metrics\"`\r\n}\r\n\r\n"]
[11870.621746, "o", "type CVRunOutput struct {\r\n\tPipeline    string                     `json:\"pipeline\"`\r\n\tStatus      string                     `json:\"status\"`\r\n\tCVFolds     int                        `json:\"cv_folds\"`\r\n\tStages      map[string]*StageResult    `json:\"stages\"`\r\n\tFoldResults []CVFoldResult             `json:\"fold_results\"`\r\n\tCVResults   CVResults                  `json:\"cv_results\"`\r\n"]
[11870.621813, "o", "\tArtifacts   map[string]*ArtifactOutput `json:\"artifacts\"`\r\n\tCacheStats  *CacheStats                `json:\"cache_stats,omitempty\"`\r\n}\r\n\r\nfunc (e *Executor) RunCV() (*CVRunOutput, error) {\r\n\tif e.cvFolds < 2 {\r\n\t\treturn nil, fmt.Errorf(\"cv folds must be >= 2\")\r\n\t}\r\n\r\n\tvalid, errs := e.config.Validate()\r\n\tif !valid {\r\n\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n\t}\r\n\tif err := e.config.validateCV(); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n"]
[11870.621886, "o", "\torder, err := e.config.topologicalOrder()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tsplitName, _ := e.config.splitStageName()\r\n\tpostSplit := e.config.postSplitStages(splitName)\r\n\tpreSplitOrder := []string{}\r\n\tpostSplitOrder := []string{}\r\n\tfor _, name := range order {\r\n\t"]
[11870.621945, "o", "\tif postSplit[name] {\r\n\t\t\tpostSplitOrder = append(postSplitOrder, name)\r\n\t\t} else {\r\n\t\t\tpreSplitOrder = append(preSplitOrder, name)\r\n\t\t}\r\n\t}\r\n\r\n\tallArtifacts := map[string]*ArtifactOutput{}\r\n\r\n"]
[11870.622004, "o", "\tfor _, name := range preSplitOrder {\r\n\t\te.executeStageCached(name, -1, 0, allArtifacts)\r\n\t}\r\n\r\n\tfoldResults := make([]CVFoldResult, e.cvFolds)\r\n\tfoldMetrics := make([]map[string]float64, e.cvFolds)\r\n\r\n\tfor i := 0; i < e.cvFolds; i++ {\r\n\t\tfoldExec := &Executor{\r\n\t\t\tconfig:     e.config,\r\n"]
[11870.622073, "o", "\t\t\tglobals:    e.globals,\r\n\t\t\tstatus:     map[string]string{},\r\n\t\t\tresults:    map[string]*StageResult{},\r\n\t\t\toutputs:    map[string]map[string]string{},\r\n\t\t\tvalues:     map[string]map[string]*ArtifactValue{},\r\n\t\t\tmeta:       e.meta,\r\n"]
[11870.622135, "o", "\t\t\tcacheKeys:  map[string]string{},\r\n\t\t\tnoCache:    e.noCache,\r\n\t\t\tcvFolds:    e.cvFolds,\r\n\t\t\tcacheStats: e.cacheStats,\r\n\t\t}\r\n\t\tfor name, st := range e.status {\r\n\t\t\tfoldExec.status[name] = st\r\n\t\t}\r\n\t\tfor name, outs := range e.outputs {\r\n\t\t\tfoldExec.outputs[name] = copyStringMap(outs)\r\n\t\t}\r\n\t\tfor name, vals := range e.values {\r\n\t\t\tfoldExec.values[name] = copyValueMap(vals)\r\n\t"]
[11870.622194, "o", "\t}\r\n\t\tfor name, key := range e.cacheKeys {\r\n\t\t\tfoldExec.cacheKeys[name] = key\r\n\t\t}\r\n\r\n\t\tfoldArtifacts := map[string]*ArtifactOutput{}\r\n\t\tfor _, name := range postSplitOrder {\r\n\t\t\tfoldExec.executeStageCached(name, i, e.cvFolds, foldArtifacts)\r\n\t\t}\r\n\r\n\t\tfoldStatus := \"success\"\r\n"]
[11870.622261, "o", "\t\tfor _, r := range foldExec.results {\r\n\t\t\tif r.Status != \"success\" {\r\n\t\t\t\tfoldStatus = \"failed\"\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tfor id, art := range foldArtifacts {\r\n\t"]
[11870.622321, "o", "\t\tallArtifacts[id] = art\r\n\t\t}\r\n\r\n\t\tfoldResults[i] = CVFoldResult{\r\n\t\t\tFold:   i,\r\n\t\t\tStatus: foldStatus,\r\n\t\t\tStages: foldExec.results,\r\n\t\t}\r\n\r\n\t\tfoldMetric := map[string]float64{}\r\n\t\tmetricSums := map[string]float64{}\r\n\t"]
[11870.62239, "o", "\tmetricCounts := map[string]int{}\r\n\t\tfor _, name := range postSplitOrder {\r\n\t\t\tstage, _ := e.config.stageByName(name)\r\n\t\t\tif stage.Type != \"evaluate\" {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tr, ok := foldExec.results[name]\r\n\t\t\tif !ok || r.Status != \"success\" {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tval, ok := foldExec.values[name][\"report\"]\r\n"]
[11870.622455, "o", "\t\t\tif !ok || val == nil || val.Report == nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tfor metricName, metricValue := range val.Report.Metrics {\r\n\t\t\t\tfv, ok := toFloat64(metricValue)\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tmetricSums[metricName] += fv\r\n"]
[11870.622516, "o", "\t\t\t\tmetricCounts[metricName]++\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor name, sum := range metricSums {\r\n\t\t\tif metricCounts[name] > 0 {\r\n\t\t\t\tfoldMetric[name] = sum / float64(metricCounts[name])\r\n\t\t\t}\r\n"]
[11870.622576, "o", "\t\t}\r\n\t\tfoldMetrics[i] = foldMetric\r\n\t}\r\n\r\n\tcvMetrics := map[string]CVMetricAgg{}\r\n\tmetricNames := map[string]bool{}\r\n\tfor _, fm := range foldMetrics {\r\n\t\tfor name := range fm {\r\n"]
[11870.622637, "o", "\t\t\tmetricNames[name] = true\r\n\t\t}\r\n\t}\r\n\tfor name := range metricNames {\r\n\t\tperFold := make([]float64, e.cvFolds)\r\n\t\tsum := 0.0\r\n\t\tcount := 0\r\n\t\tfor i, fm := range foldMetrics {\r\n\t\t\tif v, ok := fm[name]; ok {\r\n"]
[11870.622693, "o", "\t\t\t\tperFold[i] = v\r\n\t\t\t\tsum += v\r\n\t\t\t\tcount++\r\n\t\t\t} else {\r\n\t\t\t\tperFold[i] = 0.0\r\n\t\t\t}\r\n\t\t}\r\n\t\tmean := 0.0\r\n\t\t"]
[11870.622758, "o", "if count > 0 {\r\n\t\t\tmean = sum / float64(count)\r\n\t\t}\r\n\t\tvariance := 0.0\r\n\t\tfor _, v := range perFold {\r\n\t\t\td := v - mean\r\n\t\t\tvariance += d * d\r\n\t\t}\r\n\t\tvariance /= float64(e.cvFolds)\r\n\t"]
[11870.622818, "o", "\tcvMetrics[name] = CVMetricAgg{\r\n\t\t\tMean:    mean,\r\n\t\t\tStd:     math.Sqrt(variance),\r\n\t\t\tPerFold: perFold,\r\n\t\t}\r\n\t}\r\n\r\n\tstatus := \"success\"\r\n\tfor _, r := range e.results {\r\n"]
[11870.62289, "o", "\t\tif r.Status != \"success\" {\r\n\t\t\tstatus = \"failed\"\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tfor _, fr := range foldResults {\r\n\t\tif fr.Status != \"success\" {\r\n\t\t\tstatus = \"failed\"\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n"]
[11870.622952, "o", "\trun := &CVRunOutput{\r\n\t\tPipeline:    e.config.Pipeline.Name,\r\n\t\tStatus:      status,\r\n\t\tCVFolds:     e.cvFolds,\r\n\t\tStages:      e.results,\r\n\t\tFoldResults: foldResults,\r\n\t\tCVResults:   CVResults{Metrics: cvMetrics},\r\n\t\tArtifacts:   allArtifacts,\r\n\t\tCacheStats:  e.cacheStats,\r\n\t}\r\n\r\n"]
[11870.623015, "o", "\tif err := saveArtifacts(e.meta); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn run, nil\r\n}\r\n\r\nfunc (e *Executor) executeStageCached(name string, fold, k int, runArtifacts map[string]*ArtifactOutput) bool {\r\n\tstage, _ := e.config.stageByName(name)\r\n\te.outputs[name] = map[string]string{}\r\n\te.values[name] = map[string]*ArtifactValue{}\r\n\t"]
[11870.623075, "o", "e.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n\r\n\tskip := false\r\n\tfor _, dep := range stage.DependsOn {\r\n\t\tif e.status[dep] != \"success\" {\r\n\t\t\tskip = true\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n"]
[11870.623132, "o", "\tif skip {\r\n\t\te.status[name] = \"skipped\"\r\n\t\te.results[name].Status = \"skipped\"\r\n\t\treturn false\r\n\t}\r\n\r\n\tinputValues, inputIDs, err := e.resolveInputs(stage)\r\n\tif err != nil {\r\n"]
[11870.623194, "o", "\t\te.status[name] = \"failed\"\r\n\t\te.results[name].Status = \"failed\"\r\n\t\te.results[name].Error = err.Error()\r\n\t\treturn false\r\n\t}\r\n\r\n\tparams := e.config.stageParams(name, e.globals)\r\n\tinputKeys := e.inputCacheKeys(stage)\r\n\tcacheKey, keyErr := computeCacheKey(stage, params, inputKeys, fold)\r\n\tif keyErr != nil {\r\n"]
[11870.623262, "o", "\t\te.status[name] = \"failed\"\r\n\t\te.results[name].Status = \"failed\"\r\n\t\te.results[name].Error = keyErr.Error()\r\n\t\treturn false\r\n\t}\r\n\te.cacheKeys[name] = cacheKey\r\n\r\n\tvar out map[string]*ArtifactValue\r\n\tstart := time.Now()\r\n\t"]
[11870.62332, "o", "if !e.noCache && cacheEntryExists(cacheKey) {\r\n\t\tloaded, loadErr := loadCacheEntry(cacheKey)\r\n\t\tif loadErr == nil {\r\n\t\t\tout = loaded\r\n\t\t\te.results[name].CacheHit = true\r\n\t\t\te.cacheStats.Hits++\r\n\t\t\te.results[name].DurationMs = time.Since(start).Milliseconds()\r\n\t\t} else {\r\n\t\t"]
[11870.623378, "o", "\tif !e.noCache {\r\n\t\t\t\te.cacheStats.Misses++\r\n\t\t\t}\r\n\t\t\tout, err = e.executeStageForFold(stage, params, inputValues, fold, k)\r\n\t\t\te.results[name].DurationMs = time.Since(start).Milliseconds()\r\n\t\t\tif err != nil {\r\n\t\t\t\te.status[name] = \"failed\"\r\n\t\t\t\te.results[name].Status = \"failed\"\r\n"]
[11870.623444, "o", "\t\t\t\te.results[name].Error = err.Error()\r\n\t\t\t\treturn false\r\n\t\t\t}\r\n\t\t\tif !e.noCache {\r\n\t\t\t\t_ = saveCacheEntry(cacheKey, name, stage.Type, out)\r\n\t\t\t}\r\n\t\t"]
[11870.623507, "o", "}\r\n\t} else {\r\n\t\tout, err = e.executeStageForFold(stage, params, inputValues, fold, k)\r\n\t\te.results[name].DurationMs = time.Since(start).Milliseconds()\r\n\t\tif err != nil {\r\n\t\t\te.status[name] = \"failed\"\r\n\t\t\te.results[name].Status = \"failed\"\r\n\t\t\te.results[name].Error = err.Error()\r\n\t\t\treturn false\r\n\t\t}\r\n\t\tif !e.noCache {\r\n\t\t\t_ = saveCacheEntry(cacheKey, name, stage.Type, out)\r\n\t\t\te.cacheStats.Misses++\r\n"]
[11870.623569, "o", "\t\t}\r\n\t}\r\n\r\n\te.status[name] = \"success\"\r\n\te.results[name].Status = \"success\"\r\n\tts := time.Now().UnixNano()\r\n\r\n\tfor port, val := range out {\r\n\t\tvar id string\r\n\t\tif fold >= 0 {\r\n"]
[11870.623631, "o", "\t\t\tid = artifactIDFold(e.config.Pipeline.Name, name, port, ts, fold)\r\n\t\t} else {\r\n\t\t\tid = artifactID(e.config.Pipeline.Name, name, port, ts)\r\n\t\t}\r\n\t\te.values[name][port] = val\r\n\t\te.outputs[name][port] = id\r\n\t\ttyp := val.Type()\r\n"]
[11870.623691, "o", "\t\tsummary := val.Summary()\r\n\t\tmeta := &ArtifactMeta{\r\n\t\t\tID:        id,\r\n\t\t\tStage:     name,\r\n\t\t\tPort:      port,\r\n\t\t\tType:      typ,\r\n\t\t\tSummary:   summary,\r\n\t\t\tInputs:    inputIDs,\r\n\t\t\tOutputs:   []string{},\r\n"]
[11870.623761, "o", "\t\t\tTimestamp: ts,\r\n\t\t}\r\n\t\te.meta[id] = meta\r\n\t\tfor _, inID := range inputIDs {\r\n\t\t\tif parent, ok := e.meta[inID]; ok {\r\n\t\t\t\tparent.Outputs = appendUnique(parent.Outputs, id)\r\n\t\t\t}\r\n\t\t}\r\n"]
[11870.623819, "o", "\t\trunArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n\t}\r\n\treturn true\r\n"]
[11870.624406, "o", "\u001b[?2004h"]
