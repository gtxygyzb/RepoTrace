[12838.386576, "o", "exitError(\"usage: mlpipe diff config1.json config2.json [--param key=value ...]\")\r\n    66\t\t\treturn\r\n    67\t\t}\r\n    68\t\tconfig1, err := loadConfig(paths[0])\r\n    69\t\tif err != nil {\r\n    70\t\t\texitError(err.Error())\r\n    71\t\t\treturn\r\n    72\t\t}\r\n    73\t\tconfig2, err := loadConfig(paths[1])\r\n    74\t\tif err != nil {\r\n    75\t\t\texitError(err.Error())\r\n    76\t\t\treturn\r\n    77\t\t}\r\n    78\t\tapplyDiffParams(config1, overrides)\r\n    79\t\t"]
