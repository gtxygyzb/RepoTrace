[5326.209411, "o", "\u001b[?2004h> "]
[5326.209587, "o", "                count++\r\n\u001b[?2004l\r"]
[5326.209648, "o", "\u001b[?2004h> "]
[5326.209794, "o", "            } else {\r\n\u001b[?2004l\r"]
[5326.209853, "o", "\u001b[?2004h> "]
[5326.210083, "o", "                perFold[i] = 0.0\r\n\u001b[?2004l\r"]
[5326.210138, "o", "\u001b[?2004h> "]
[5326.210246, "o", "            }\r\n\u001b[?2004l\r"]
[5326.210303, "o", "\u001b[?2004h> "]
[5326.21038, "o", "        }\r\n\u001b[?2004l\r"]
[5326.210435, "o", "\u001b[?2004h> "]
[5326.21057, "o", "        mean := 0.0\r\n\u001b[?2004l\r"]
[5326.210633, "o", "\u001b[?2004h> "]
[5326.210799, "o", "        if count > 0 {\r\n\u001b[?2004l\r"]
[5326.210857, "o", "\u001b[?2004h> "]
[5326.211131, "o", "            mean = sum / float64(count)\r\n\u001b[?2004l\r"]
[5326.211186, "o", "\u001b[?2004h> "]
[5326.211271, "o", "        }\r\n\u001b[?2004l\r"]
[5326.211327, "o", "\u001b[?2004h> "]
[5326.211496, "o", "        variance := 0.0\r\n\u001b[?2004l\r"]
[5326.211542, "o", "\u001b[?2004h> "]
[5326.211803, "o", "        for _, v := range perFold {\r\n\u001b[?2004l\r"]
[5326.211859, "o", "\u001b[?2004h> "]
[5326.212044, "o", "            d := v - mean\r\n\u001b[?2004l\r"]
[5326.212099, "o", "\u001b[?2004h> "]
[5326.212311, "o", "            variance += d * d\r\n\u001b[?2004l\r"]
[5326.212378, "o", "\u001b[?2004h> "]
[5326.212448, "o", "        }\r\n\u001b[?2004l\r"]
[5326.212504, "o", "\u001b[?2004h> "]
[5326.212765, "o", "        variance /= float64(e.cvFolds)\r\n\u001b[?2004l\r"]
[5326.212823, "o", "\u001b[?2004h> "]
[5326.213091, "o", "        cvMetrics[name] = CVMetricAgg{\r\n\u001b[?2004l\r"]
[5326.213148, "o", "\u001b[?2004h> "]
[5326.213348, "o", "            Mean:    mean,\r\n\u001b[?2004l\r"]
[5326.213406, "o", "\u001b[?2004h> "]
[5326.213688, "o", "            Std:     math.Sqrt(variance),\r\n\u001b[?2004l\r"]
[5326.213743, "o", "\u001b[?2004h> "]
[5326.213951, "o", "            PerFold: perFold,\r\n\u001b[?2004l\r"]
[5326.214007, "o", "\u001b[?2004h> "]
[5326.214081, "o", "        }\r\n\u001b[?2004l\r"]
[5326.214135, "o", "\u001b[?2004h> "]
[5326.214192, "o", "    }\r\n\u001b[?2004l\r"]
[5326.21426, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5326.214316, "o", "\u001b[?2004h> "]
