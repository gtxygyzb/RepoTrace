[11883.163193, "o", "func computeCacheKey(stage *StageConfig, params map[string]interface{}, inputKeys map[string]string, fold int) (string, error) {\r\n\tvar sb strings.Builder\r\n\tsb.WriteString(stage.Type)\r\n\tsb.WriteString(\"\\n\")\r\n\r\n\tparamsJSON, err := canonicalJSON(params)\r\n\tif err != nil {\r\n"]
[11883.163303, "o", "\t\treturn \"\", err\r\n\t}\r\n\tsb.WriteString(paramsJSON)\r\n\tsb.WriteString(\"\\n\")\r\n\r\n\tif stage.Type == \"data-source\" {\r\n\t\tpath, ok := getString(params, \"path\")\r\n\t\tif !ok {\r\n"]
[11883.163375, "o", "\t\t\treturn \"\", fmt.Errorf(\"data-source stage %q requires path for cache key\", stage.Name)\r\n\t\t}\r\n\t\tfileHash, err := fileSHA256(path)\r\n\t\tif err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\tsb.WriteString(fileHash)\r\n\t} else {\r\n\t\tports := make([]string, 0, len(stage.Inputs))\r\n\t\tfor port := range stage.Inputs {\r\n\t\t\tports = append(ports, port)\r\n\t\t}\r\n\t\tsort.Strings(ports)\r\n\t\tfor i, port := range ports {\r\n\t\t\tif i > 0 {\r\n\t\t\t\tsb.WriteString(\"\\n\")\r\n\t\t\t}\r\n"]
[11883.163443, "o", "\t\t\tsb.WriteString(port)\r\n\t\t\tsb.WriteString(\"=\")\r\n\t\t\tif key, ok := inputKeys[port]; ok {\r\n\t\t\t\tsb.WriteString(key)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif fold >= 0 {\r\n\t\tsb.WriteString(\"\\nfold=\")\r\n\t"]
[11883.163503, "o", "\tsb.WriteString(strconv.Itoa(fold))\r\n\t}\r\n\r\n\treturn sha256Hex([]byte(sb.String())), nil\r\n}\r\n\r\ntype cacheMeta struct {\r\n\tCacheKey    string   `json:\"cache_key\"`\r\n\tStageName   string   `json:\"stage_name\"`\r\n\tStageType   string   `json:\"stage_type\"`\r\n"]
[11883.163562, "o", "\tCreatedAt   string   `json:\"created_at\"`\r\n\tOutputPorts []string `json:\"output_ports\"`\r\n}\r\n\r\n"]
