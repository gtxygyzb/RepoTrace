[7591.633658, "o", "\u001b[32m\u001b[K211\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"mape\":\u001b[m\u001b[K\r\n\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsum := 0.0\r\n\u001b[32m\u001b[K213\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcount := 0.0\r\n\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor i := range y {\r\n\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif y[i] == 0 {\r\n"]
[7591.63369, "o", "\u001b[32m\u001b[K216\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tcontinue\r\n\u001b[32m\u001b[K217\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsum += math.Abs((y[i] - preds[i]) / y[i])\r\n\u001b[32m\u001b[K219\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tcount++\r\n"]
[7591.633867, "o", "\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif count == 0 {\r\n\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn 0.0, nil\r\n\u001b[32m\u001b[K223\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn sum / count * 100, nil\r\n\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn nil, fmt.Errorf(\"unknown regression metric %q\", name)\r\n\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc aucROC(y []float64, scores []float64) float64 {\r\n"]
