[8949.270167, "o", "\r\n    17\t\tLogisticWeights []float64\r\n    18\t\tTree            *TreeNode\r\n    19\t\tForest          []*TreeNode\r\n    20\t\tBoost           []*BoostedTree\r\n    21\t\tKNN             *KNNModel\r\n    22\t\tTrainFeatures   [][]float64\r\n    23\t\tTrainTarget     []float64\r\n    24\t}\r\n    25\t\r\n    26\ttype TreeNode struct {\r\n    27\t\tIsLeaf      bool\r\n    28\t\tPrediction  float64\r\n    29\t\tProbability float64\r\n    30\t\tFeature     int\r\n    31\t"]
[8949.270285, "o", "\tThreshold   float64\r\n    32\t\tLeft        *TreeNode\r\n    33\t\tRight       *TreeNode\r\n    34\t}\r\n    35\t\r\n    36\ttype BoostedTree struct {\r\n    37\t\tTree           *TreeNode\r\n    38\t\tLearningRate   float64\r\n"]
[8949.270354, "o", "    39\t\tInitPrediction float64\r\n    40\t}\r\n    41\t\r\n    42\ttype KNNModel struct {\r\n    43\t\tK              int\r\n    44\t\tFeatures       [][]float64\r\n    45\t\tTargets        []float64\r\n    46\t\tClassification bool\r\n    47\t}\r\n    48\t\r\n    49\tfunc executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n    50\t\tvar ds *Dataset\r\n    51\t\tfor _, in := range inputs {\r\n    52\t\t\tif in != nil && in.Dataset != nil {\r\n    53\t\t\t\tds = in.Dataset\r\n    54\t\t\t\tbreak\r\n    55\t\t\t}\r\n    56\t\t}\r\n    57\t\tif ds == nil {\r\n"]
[8949.270423, "o", "    58\t\t\treturn nil, fmt.Errorf(\"train stage %q requires input data\", stage.Name)\r\n    59\t\t}\r\n    60\t\r\n"]
