[7491.744673, "o", "   128\t\t\t\t\tif !ok || key == \"\" {\r\n   129\t\t\t\t\t\tunknown = true\r\n   130\t\t\t\t\t\tbreak\r\n   131\t\t\t\t\t}\r\n   132\t\t\t\t\tinputKeys[local] = key\r\n   133\t\t\t\t}\r\n   134\t\t\t\tif !unknown {\r\n   135\t\t\t\t\tkey, err := computeCacheKey(stage, params, inputKeys, -1)\r\n   136\t\t\t\t\tif err == nil {\r\n   137\t\t\t\t\t\tcacheKeys[name] = key\r\n"]
[7491.744732, "o", "   138\t\t\t\t\t\tif cacheEntryExists(key) {\r\n   139\t\t\t\t\t\t\tcacheStatus = \"hit\"\r\n   140\t\t\t\t\t\t} else {\r\n   141\t\t\t\t\t\t\tcacheStatus = \"miss\"\r\n   142\t\t\t\t\t\t}\r\n   143\t\t\t\t\t}\r\n"]
[7491.744796, "o", "   144\t\t\t\t}\r\n   145\t\t\t}\r\n   146\t\r\n   147\t\t\tstages[name] = PlanStage{\r\n   148\t\t\t\tType:        stage.Type,\r\n   149\t\t\t\tDependsOn:   deps,\r\n   150\t\t\t\tInputTypes:  inputTypes,\r\n   151\t\t\t\tOutputTypes: outputTypes,\r\n   152\t\t\t\tCacheStatus: cacheStatus,\r\n   153\t\t\t\tCVPhase:     phase,\r\n   154\t\t\t}\r\n"]
[7491.744859, "o", "   155\t\t}\r\n"]
