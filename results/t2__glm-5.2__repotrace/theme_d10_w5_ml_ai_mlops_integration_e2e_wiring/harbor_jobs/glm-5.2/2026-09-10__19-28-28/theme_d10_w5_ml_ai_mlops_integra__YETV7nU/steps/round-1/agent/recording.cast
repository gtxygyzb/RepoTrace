[5326.222325, "o", "\u001b[?2004h> "]
[5326.222739, "o", "    e.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n\u001b[?2004l\r"]
[5326.222805, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.222861, "o", "> "]
[5326.222932, "o", "    skip := false\r\n\u001b[?2004l\r"]
[5326.222987, "o", "\u001b[?2004h> "]
[5326.223192, "o", "    for _, dep := range stage.DependsOn {\r\n\u001b[?2004l\r"]
[5326.22327, "o", "\u001b[?2004h> "]
[5326.223472, "o", "        if e.status[dep] != \"success\" {\r\n\u001b[?2004l\r"]
[5326.223527, "o", "\u001b[?2004h> "]
[5326.223648, "o", "            skip = true\r\n\u001b[?2004l\r"]
[5326.223754, "o", "\u001b[?2004h> "]
[5326.223818, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.223873, "o", ">         }\r\n\u001b[?2004l\r"]
[5326.223933, "o", "\u001b[?2004h> "]
[5326.223988, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.224046, "o", "> "]
[5326.224106, "o", "    if skip {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.224165, "o", "> "]
[5326.224319, "o", "        e.status[name] = \"skipped\"\r\n\u001b[?2004l\r"]
[5326.22438, "o", "\u001b[?2004h> "]
[5326.2246, "o", "        e.results[name].Status = \"skipped\"\r\n\u001b[?2004l\r"]
[5326.224655, "o", "\u001b[?2004h> "]
[5326.224759, "o", "        return false\r\n\u001b[?2004l\r"]
[5326.224815, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5326.224868, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rg"]
[5326.224927, "o", "\u001b[?2004h> "]
[5326.225262, "o", "    inputValues, inputIDs, err := e.resolveInputs(stage)\r\n\u001b[?2004l\r"]
[5326.225317, "o", "\u001b[?2004h> "]
