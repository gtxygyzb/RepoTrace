[6662.119384, "o", "\tfor k := range e2.Hyperparams {\r\n   273\t\t\thpNames[k] = true\r\n   274\t\t}\r\n   275\t\tfor k := range hpNames {\r\n   276\t\t\tv1v, ok1 := e1.Hyperparams[k]\r\n   277\t\t\tv2v, ok2 := e2.Hyperparams[k]\r\n   278\t\t\tif !ok1 || !ok2 || fmt.Sprintf(\"%v\", v1v) != fmt.Sprintf(\"%v\", v2v) {\r\n   279\t\t\t\thpDiff[k] = map[string]interface{}{\"v1\": v1v, \"v2\": v2v}\r\n   280\t\t\t}\r\n"]
[6662.119446, "o", "   281\t\t}\r\n   282\t\r\n   283\t\treturn map[string]interface{}{\r\n   284\t\t\t\"model_name\":       name,\r\n   285\t\t\t\"versions\":         []int{v1, v2},\r\n   286\t\t\t\"metrics_diff\":     metricsDiff,\r\n   287\t\t\t\"hyperparams_diff\": hpDiff,\r\n   288\t\t}, nil\r\n"]
