[1943.161354, "o", "        values := make([]float64, len(X))\r\n\u001b[?2004l\r"]
[1943.161409, "o", "\u001b[?2004h> "]
[1943.161554, "o", "        for i := 0; i < len(X); i++ {\r\n\u001b[?2004l\r"]
