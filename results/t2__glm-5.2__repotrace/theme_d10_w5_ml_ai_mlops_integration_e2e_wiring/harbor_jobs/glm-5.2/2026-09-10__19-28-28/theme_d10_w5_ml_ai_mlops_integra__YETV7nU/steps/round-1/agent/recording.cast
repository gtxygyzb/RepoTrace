[10912.631386, "o", "\tcase \"info\":\r\n\t\tcmdRegistryInfo(rest)\r\n\tcase \"promote\":\r\n\t\tcmdRegistryPromote(rest)\r\n"]
[10912.631454, "o", "\tcase \"compare\":\r\n\t\tcmdRegistryCompare(rest)\r\n\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown registry command: %s\", sub))\r\n\t}\r\n}\r\n\r\nfunc cmdRegistryList(args []string) {\r\n\tname, stage, tag := \"\", \"\", \"\"\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--name\" && i+1 < len(args):\r\n"]
[10912.63152, "o", "\t\t\tname = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--name=\"):\r\n\t\t\tname = strings.TrimPrefix(args[i], \"--name=\")\r\n\t\tcase args[i] == \"--stage\" && i+1 < len(args):\r\n\t\t\tstage = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--stage=\"):\r\n"]
[10912.631583, "o", "\t\t\tstage = strings.TrimPrefix(args[i], \"--stage=\")\r\n\t\tcase args[i] == \"--tag\" && i+1 < len(args):\r\n\t\t\ttag = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--tag=\"):\r\n\t\t\ttag = strings.TrimPrefix(args[i], \"--tag=\")\r\n\t\tdefault:\r\n\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\t\t\treturn\r\n\t\t}\r\n"]
[10912.631644, "o", "\t}\r\n\tentries, err := listRegistry(name, stage, tag)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tout := make([]map[string]interface{}, len(entries))\r\n\tfor i, e := range entries {\r\n\t\tout[i] = map[string]interface{}{\r\n\t\t\t\"name\":          e.Name,\r\n"]
[10912.631706, "o", "\t\t\t\"version\":       e.Version,\r\n\t\t\t\"stage\":         e.Stage,\r\n\t\t\t\"tags\":          e.Tags,\r\n\t\t\t\"metrics\":       e.Metrics,\r\n\t\t\t\"registered_at\": e.RegisteredAt,\r\n\t\t}\r\n\t}\r\n\tprintJSON(map[string]interface{}{\r\n\t\t\"models\": out,\r\n\t\t\"count\":  len(out),\r\n"]
[10912.631785, "o", "\t})\r\n}\r\n\r\nfunc cmdRegistryInfo(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe registry info <name>:<version>\")\r\n\t\treturn\r\n\t}\r\n"]
[10912.631843, "o", "\tname, version, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tentry, err := registryInfo(name, version)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(entry)\r\n}\r\n\r\nfunc cmdRegistryPromote(args []string) {\r\n"]
[10912.631905, "o", "\tvar positionals []string\r\n\tforce := false\r\n\tfor _, a := range args {\r\n\t\tif a == \"--force\" {\r\n\t\t\tforce = true\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[10912.631961, "o", "\t\tif strings.HasPrefix(a, \"--\") {\r\n\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", a))\r\n\t\t\treturn\r\n\t\t}\r\n\t\tpositionals = append(positionals, a)\r\n\t}\r\n\tif len(positionals) < 2 {\r\n\t\tprintError(\"usage: mlpipe registry promote <name>:<version> <target_stage> [--force]\")\r\n\t\treturn\r\n"]
[10912.632024, "o", "\t}\r\n\tname, version, ok := splitNameVersion(positionals[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\ttarget := positionals[1]\r\n\tentry, prev, new, warnings, err := promoteModel(name, version, target, force)\r\n\tif err != nil {\r\n\t\t"]
[10912.632082, "o", "if strings.HasPrefix(err.Error(), \"metric \") {\r\n\t\t\tprintJSON(map[string]interface{}{\"success\": false, \"message\": err.Error()})\r\n\t\t\treturn\r\n\t\t}\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tmessage := fmt.Sprintf(\"promoted to %s\", new)\r\n\tif force {\r\n\t\tmessage = fmt.Sprintf(\"promoted to %s (forced)\", new)\r\n"]
[10912.632145, "o", "\t}\r\n\tresult := map[string]interface{}{\r\n\t\t\"success\":        true,\r\n\t\t\"message\":        message,\r\n\t\t\"previous_stage\": prev,\r\n"]
[10912.632205, "o", "\t\t\"new_stage\":      entry.Stage,\r\n\t}\r\n\tif force {\r\n\t\tresult[\"warnings\"] = warnings\r\n\t}\r\n\tprintJSON(result)\r\n}\r\n\r\nfunc cmdRegistryCompare(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tprintError(\"usage: mlpipe registry compare <name>:<version1> <name>:<version2>\")\r\n\t\treturn\r\n\t}\r\n\tname1, v1, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n"]
[10912.632281, "o", "\t\treturn\r\n\t}\r\n\tname2, v2, ok := splitNameVersion(args[1])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tif name1 != name2 {\r\n\t\tprintError(\"cannot compare different model names\")\r\n\t"]
[10912.632342, "o", "\treturn\r\n\t}\r\n\tresult, err := compareModels(name1, v1, v2)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(result)\r\n}\r\n\r\nfunc cmdLineage(args []string) {\r\n\tif len(args) < 2 {\r\n"]
[10912.632404, "o", "\t\tprintError(\"usage: mlpipe lineage <artifact_id> <up|down|both>\")\r\n\t\treturn\r\n\t}\r\n\tid := args[0]\r\n\tdirection := args[1]\r\n\tresult, err := queryLineage(id, direction)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n"]
[10912.632467, "o", "\tprintJSON(result)\r\n}\r\n\r\nfunc parseRunArgs(args []string) (string, map[string]string, int, bool, []string, error) {\r\n\tconfigPath := \"\"\r\n\toverrides := map[string]string{}\r\n\tcv := 0\r\n\tnoCache := false\r\n\tvar skipStages []string\r\n\tfor i := 0; i < len(args); i++ {\r\n"]
[10912.632533, "o", "\t\tswitch {\r\n\t\tcase args[i] == \"--cv\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"--cv requires a value\")\r\n\t\t\t}\r\n\t\t\tk, err := strconv.Atoi(args[i+1])\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"invalid cv folds: %s\", args[i+1])\r\n"]
