[11552.16835, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path(\"history.go\")\ns = p.read_text()\nif 'if _, err := strconv.ParseInt(strings.TrimSuffix(name, \".json\"), 10, 64); err != nil {' not in s:\n    old = '''        if !strings.HasSuffix(name, \".json\") {\n            continue\n        }\n        path := filepath.Join(dir, name)'''\n    new = '''        if !strings.HasSuffix(name, \".json\") {\n            continue\n        }\n        if _, err := strconv.ParseInt(strings.TrimSuffix(name, \".json\"), 10, 64); err != nil {\n            continue\n        }\n        path := filepath.Join(dir, name)'''\n    if old not in s:\n        raise SystemExit(\"loadHistory insertion point not found\")\n    s = s.replace(old, new)\n    p.write_text(s)\nPY\n"]
