[1827.637778, "o", "\t\t\tthreshold := (sorted[s] + sorted[s+1]) / 2\r\n\t\t\tleftIdx := []int{}\r\n\t\t\trightIdx := []int{}\r\n\t\t\tfor i := 0; i < len(X); i++ {\r\n\t\t\t\tif X[i][j] <= threshold {\r\n\t\t\t\t\tleftIdx = append(leftIdx, i)\r\n\t\t\t\t} else {\r\n\t\t\t\t\trightIdx = append(rightIdx, i)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif len(leftIdx) == 0 || len(rightIdx) == 0 {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tleftY := subsetY(y, leftIdx)\r\n"]
