[5326.32399, "o", "    for k, v := range m {\r\n\u001b[?2004l\r"]
[5326.324046, "o", "\u001b[?2004h> "]
[5326.324104, "o", "        out[k] = v\r\n\u001b[?2004l\r"]
[5326.32416, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5326.324225, "o", "\u001b[?2004h> "]
