[8949.554252, "o", "    60\t\r\n    61\t\texecutionOrder := []string{}\r\n    62\t\tif cv > 0 {\r\n    63\t\t\tfor _, name := range order {\r\n    64\t\t\t\tif !postSplit[name] {\r\n    65\t\t"]
[8949.554346, "o", "\t\t\texecutionOrder = append(executionOrder, name)\r\n    66\t\t\t\t}\r\n    67\t\t\t}\r\n    68\t\t\tfor _, name := range order {\r\n    69\t\t\t\tif postSplit[name] {\r\n    70\t\t\t\t\texecutionOrder = append(executionOrder, name)\r\n    71\t\t\t\t}\r\n"]
[8949.554419, "o", "    72\t\t\t}\r\n    73\t\t} else {\r\n    74\t\t\texecutionOrder = append(executionOrder, order...)\r\n    75\t\t}\r\n    76\t\r\n    77\t\tcacheKeys := map[string]string{}\r\n    78\t\tstages := map[string]PlanStage{}\r\n    79\t\tedges := []PlanEdge{}\r\n    80\t\r\n    81\t\tfor _, name := range order {\r\n    82\t\t\tstage, _ := config.stageByName(name)\r\n    83\t\t\tdeps := stage.DependsOn\r\n    84\t\t\tif deps == nil {\r\n    85\t\t\t\tdeps = []string{}\r\n    86\t\t\t}\r\n"]
[8949.55449, "o", "    87\t\r\n    88\t\t\tinputTypes := map[string]string{}\r\n    89\t\t\tfor local, ref := range stage.Inputs {\r\n    90\t\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n    91\t\t\t\tif len(parts) != 2 {\r\n    92\t\t\t\t\tcontinue\r\n    93\t\t\t\t}\r\n    94\t\t\t\trefStage, ok := config.stageByName(parts[0])\r\n"]
[8949.554564, "o", "    95\t\t\t\tif !ok {\r\n    96\t\t\t\t\tcontinue\r\n    97\t\t\t\t}\r\n    98\t\t\t\tinputTypes[local] = outputPortType(refStage.Type, parts[1])\r\n    99\t\t\t\tedges = append(edges, PlanEdge{From: parts[0], To: name, Port: parts[1]})\r\n   100\t\t\t}\r\n   101\t\r\n   102\t\t\toutputTypes := map[string]string{}\r\n   103\t\t\tfor _, port := range validOutputPorts(stage.Type) {\r\n   104\t\t\t\toutputTypes[port] = outputPortType(stage.Type, port)\r\n   105"]
[8949.554634, "o", "\t\t\t}\r\n   106\t\r\n   107\t\t\tcacheStatus := \"unknown\"\r\n   108\t\t\tphase := (*string)(nil)\r\n   109\t\t\tif cv > 0 {\r\n   110\t\t\t\tif postSplit[name] {\r\n   111\t\t\t\t\tphase = strPtr(\"per-fold\")\r\n   112\t\t\t\t} else {\r\n   113\t\t\t\t\tphase = strPtr(\"pre-split\")\r\n   114\t\t\t\t}\r\n   115\t\t\t}\r\n   116\t\r\n"]
[8949.554702, "o", "   117\t\t\tif cv == 0 || !postSplit[name] {\r\n   118\t\t\t\tparams := config.stageParams(name, config.globalParams(overrides))\r\n   119\t\t\t\tinputKeys := map[string]string{}\r\n   120\t\t\t\tunknown := false\r\n   121\t\t\t\tfor local, ref := range stage.Inputs {\r\n   122\t\t\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n   123\t\t\t\t\tif len(parts) != 2 {\r\n   124\t\t\t\t\t\tunknown = true\r\n"]
[8949.554772, "o", "   125\t\t\t\t\t\tbreak\r\n   126\t\t\t\t\t}\r\n   127\t\t\t\t\tkey, ok := cacheKeys[parts[0]]\r\n   128\t\t\t\t\tif !ok || key == \"\" {\r\n   129\t\t\t\t\t\tunknown = true\r\n   130\t\t\t\t\t\tbreak\r\n   131\t\t\t\t\t}\r\n   132\t\t\t\t\tinputKeys[local] = key\r\n   133\t\t\t\t}\r\n"]
[8949.554838, "o", "   134\t\t\t\tif !unknown {\r\n   135\t\t\t\t\tkey, err := computeCacheKey(stage, params, inputKeys, -1)\r\n   136\t\t\t\t\tif err == nil {\r\n   137\t\t\t\t\t\tcacheKeys[name] = key\r\n   138\t\t\t\t\t\tif cacheEntryExists(key) {\r\n   139\t\t\t\t\t\t\tcacheStatus = \"hit\"\r\n   140\t"]
[8949.554905, "o", "\t\t\t\t\t} else {\r\n   141\t\t\t\t\t\t\tcacheStatus = \"miss\"\r\n   142\t\t\t\t\t\t}\r\n   143\t\t\t\t\t}\r\n   144\t\t\t\t}\r\n   145\t\t\t}\r\n   146\t\r\n   147\t\t\t"]
[8949.554973, "o", "if stage.Type == \"register\" {\r\n   148\t\t\t\tcacheStatus = \"uncacheable\"\r\n   149\t\t\t}\r\n   150\t\r\n   151\t\t\tstages[name] = PlanStage{\r\n   152\t\t\t\tType:        stage.Type,\r\n   153\t\t\t\tDependsOn:   deps,\r\n   154\t\t\t\tInputTypes:  inputTypes,\r\n   155\t\t\t\tOutputTypes: outputTypes,\r\n"]
[8949.55504, "o", "   156\t\t\t\tCacheStatus: cacheStatus,\r\n   157\t\t\t\tCVPhase:     phase,\r\n   158\t\t\t}\r\n   159\t\t}\r\n   160\t\r\n   161\t\tsort.Slice(edges, func(i, j int) bool {\r\n   162\t\t\tif edges[i].From != edges[j].From {\r\n   163\t\t\t\treturn edges[i].From < edges[j].From\r\n   164\t\t\t}\r\n   165\t\t\tif edges[i].To != edges[j].To {\r\n"]
[8949.55511, "o", "   166\t\t\t\treturn edges[i].To < edges[j].To\r\n   167\t\t\t}\r\n   168\t\t\treturn edges[i].Port < edges[j].Port\r\n   169\t\t})\r\n   170\t\r\n   171\t\treturn &PlanOutput{\r\n   172\t\t\tPipeline:       config.Pipeline.Name,\r\n   173\t\t\tMode:           mode,\r\n   174\t\t\tCVFolds:        cv,\r\n   175\t\t\tExecutionOrder: executionOrder,\r\n   176\t\t\tStages:         stages,\r\n   177\t"]
[8949.555174, "o", "\t\tEdges:          edges,\r\n   178\t\t}, nil\r\n   179\t}\r\n   180\t\r\n   181\tfunc outputPortType(stageType, port string) string {\r\n   182\t\tswitch stageType {\r\n   183\t\tcase \"data-source\", \"transform\":\r\n   184\t\t\tif port == \"data\" {\r\n   185\t\t\t\treturn \"dataset\"\r\n"]
[8949.555258, "o", "   186\t\t\t}\r\n   187\t\tcase \"split\":\r\n   188\t\t\tif port == \"train\" || port == \"test\" {\r\n   189\t\t\t\treturn \"dataset\"\r\n   190\t\t\t}\r\n   191\t\tcase \"train\":\r\n   192\t\t\tif port == \"model\" {\r\n   193\t\t\t\treturn \"model\"\r\n   194\t"]
[8949.555294, "o", "\t\t}\r\n   195\t\t\tif port == \"predictions\" {\r\n   196\t\t\t\treturn \"dataset\"\r\n   197\t\t\t}\r\n   198\t\t"]
[8949.555524, "o", "case \"evaluate\":\r\n   199\t\t\tif port == \"report\" {\r\n   200\t\t\t\treturn \"report\"\r\n   201\t\t\t}\r\n   202\t\tcase \"register\":\r\n   203\t\t\tif port == \"entry\" {\r\n   204\t\t\t\treturn \"entry\"\r\n   205\t\t\t}\r\n   206\t\t}\r\n   207\t\treturn \"unknown\"\r\n   208\t}\r\n   209\t\r\n   210\tfunc strPtr(s string) *string {\r\n   211\t\treturn &s\r\n   212\t}\r\n"]
