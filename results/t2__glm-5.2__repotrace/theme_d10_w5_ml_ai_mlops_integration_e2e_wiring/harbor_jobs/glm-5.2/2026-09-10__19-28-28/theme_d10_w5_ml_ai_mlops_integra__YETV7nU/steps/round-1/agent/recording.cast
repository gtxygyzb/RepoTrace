[1776.372743, "o", "\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KtrainDecisionTree(\u001b[m\u001b[KX [][]float64, y []float64, features []string, classification bool, depth, maxDepth, minSplit int) *TreeNode {\r\n\u001b[32m\u001b[K369\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tnode.Left = \u001b[01;31m\u001b[KtrainDecisionTree(\u001b[m\u001b[KleftX, subsetY(y, bestLeftIdx), features, classification, depth+1, maxDepth, minSplit)\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tnode.Right = \u001b[01;31m\u001b[KtrainDecisionTree(\u001b[m\u001b[KrightX, subsetY(y, bestRightIdx), features, classification, depth+1, maxDepth, minSplit)\r\n\u001b[32m\u001b[K441\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\ttree := \u001b[01;31m\u001b[KtrainDecisionTree(\u001b[m\u001b[KsubX, bootY, subFeatures, classification, 0, maxDepth, 2)\r\n\u001b[32m\u001b[K491\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\ttree := \u001b[01;31m\u001b[KtrainDecisionTree(\u001b[m\u001b[KX, residual, features, false, 0, maxDepth, 2)\r\n"]
[1776.375778, "o", "\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kfor j := 0; j < len(features); j++\u001b[m\u001b[K {\r\n"]
