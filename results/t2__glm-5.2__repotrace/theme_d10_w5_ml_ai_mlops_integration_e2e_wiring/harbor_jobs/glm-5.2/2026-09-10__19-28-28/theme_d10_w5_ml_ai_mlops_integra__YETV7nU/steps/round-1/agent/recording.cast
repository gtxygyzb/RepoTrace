[3078.791907, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/csv\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
[3078.791977, "o", "\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\ntype Dataset struct {\r\n\tColumns []string   `json:\"columns\"`\r\n\tTypes   []string   `json:\"types\"`\r\n\tRows    [][]string `json:\"rows\"`\r\n}\r\n\r\n"]
[3078.792045, "o", "func loadDataset(path string, schema map[string]interface{}) (*Dataset, error) {\r\n\tf, err := os.Open(path)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, fmt.Errorf(\"file not found: %s\", path)\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n"]
[3078.792114, "o", "\tr := csv.NewReader(f)\r\n\trecords, err := r.ReadAll()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif len(records) == 0 {\r\n\t\treturn &Dataset{Columns: []string{}, Types: []string{}, Rows: [][]string{}}, nil\r\n\t}\r\n\r\n\theader := records[0]\r\n"]
[3078.792175, "o", "\trows := records[1:]\r\n\tcolumns := header\r\n\ttypes := make([]string, len(columns))\r\n\tfor i, col := range columns {\r\n\t\tif schemaType, ok := schema[col]; ok {\r\n\t\t\ttypes[i] = fmt.Sprintf(\"%v\", schemaType)\r\n\t\t} else {\r\n\t\t\ttypes[i] = inferColumnType(rows, i)\r\n\t\t}\r\n\t}\r\n"]
[3078.792244, "o", "\treturn &Dataset{Columns: columns, Types: types, Rows: rows}, nil\r\n}\r\n\r\nfunc inferColumnType(rows [][]string, idx int) string {\r\n\tfor _, row := range rows {\r\n\t\tif idx >= len(row) {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tval := strings.TrimSpace(row[idx])\r\n\t\tif val == \"\" {\r\n"]
[3078.79231, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tif _, ok := parseFloat64(val); !ok {\r\n"]
