[11891.644984, "o", "\r\n   277\tfunc (e *Executor) inputCacheKeys(stage *StageConfig) map[string]string {\r\n   278\t\tkeys := map[string]string{}\r\n   279\t\tfor local, ref := range stage.Inputs {\r\n   280\t\t\trefs, ok := inputRefs(ref)\r\n   281\t\t\tif !ok {\r\n   282\t\t\t\tcontinue\r\n   283\t\t\t}\r\n"]
[11891.645046, "o", "   284\t\t\tfor _, r := range refs {\r\n   285\t\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n   286\t\t\t\tif len(parts) != 2 {\r\n   287\t\t\t\t\tcontinue\r\n   288\t\t\t\t}\r\n   289\t\t\t\tdepStage := parts[0]\r\n   290\t\t\t\tif key, ok := e.cacheKeys[depStage]; ok {\r\n   291\t\t\t\t\tkeys[local] = keys[local] + key + \"\\n\"\r\n"]
[11891.645107, "o", "   292\t\t\t\t}\r\n   293\t\t\t}\r\n   294\t\t}\r\n   295\t\tfor k, v := range keys {\r\n   296\t\t\tkeys[k] = strings.TrimRight(v, \"\\n\")\r\n   297\t\t}\r\n   298\t\treturn keys\r\n"]
[11891.64517, "o", "   299\t}\r\n   300\t\r\n   301\tfunc (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {\r\n   302\t\tinputs := map[string]*ArtifactValue{}\r\n   303\t\tids := []string{}\r\n   304\t\tfor local, ref := range stage.Inputs {\r\n   305\t\t\trefs, ok := inputRefs(ref)\r\n   306\t\t\tif !ok {\r\n   307\t\t"]
[11891.645248, "o", "\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q has invalid reference %v\", stage.Name, local, ref)\r\n   308\t\t\t}\r\n   309\t\t\tvar firstVal *ArtifactValue\r\n   310\t\t\tfor _, r := range refs {\r\n   311\t\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n   312\t\t\t\tif len(parts) != 2 {\r\n   313\t\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q has invalid input reference %q\", stage.Name, r)\r\n   314\t\t\t\t}\r\n   315\t\t\t\tdepStage, port := parts[0], parts[1]\r\n"]
[11891.645313, "o", "   316\t\t\t\tid, ok := e.outputs[depStage][port]\r\n   317\t\t\t\tif !ok {\r\n   318\t\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable output %s.%s\", stage.Name, local, depStage, port)\r\n   319\t\t\t\t}\r\n   320\t\t\t\tval, ok := e.values[depStage][port]\r\n   321\t\t\t\tif !ok || val == nil {\r\n   322\t\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable artifact %s.%s\", stage.Name, local, depStage, port)"]
[11891.645371, "o", "\r\n   323\t\t\t\t}\r\n   324\t\t\t\tids = append(ids, id)\r\n   325\t\t\t\tif firstVal == nil {\r\n   326\t\t\t\t\tfirstVal = val\r\n   327\t\t\t\t}\r\n   328\t\t\t\tif stage.Type == \"ensemble\" && local == \"models\" {\r\n   329\t\t\t\t\tinputs[local+\"_\"+r] = val\r\n"]
