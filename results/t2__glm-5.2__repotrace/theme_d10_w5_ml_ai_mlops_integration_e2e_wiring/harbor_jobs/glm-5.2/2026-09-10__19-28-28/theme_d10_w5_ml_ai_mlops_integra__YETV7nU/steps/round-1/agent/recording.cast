[5440.663395, "o", "      \"depends_on\": [\r\n        \"train\",\r\n        \"evaluate\"\r\n      ],\r\n      \"input_types\": {\r\n        \"model\": \"model\",\r\n        \"report\": \"report\"\r\n      },\r\n      \"output_types\": {\r\n        \"entry\": \"entry\"\r\n      },\r\n      \"cache_status\": \"miss\",\r\n      \"cv_phase\": null\r\n    },\r\n    \"source\": {\r\n      \"type\": \"data-source\",\r\n      \"depends_on\": [],\r\n      \"input_types\": {},\r\n      \"output_types\": {\r\n        \"data\": \"dataset\"\r\n      },\r\n      \"cache_status\": \"miss\",\r\n      \"cv_phase\": null\r\n    },\r\n    \"split\": {\r\n      \"type\": \"split\",\r\n      \"depends_on\": [\r\n        \"transform\"\r\n      ],\r\n      \"input_types\": {\r\n        \"data\": \"dataset\"\r\n      },\r\n      \"output_types\": {\r\n        \"test\": \"dataset\",\r\n        \"train\": \"dataset\"\r\n      },\r\n      \"cache_status\": \"miss\",\r\n      \"cv_phase\": null\r\n    },\r\n    \"train\": {\r\n      \"type\": \"train\",\r\n      \"depends_on\": [\r\n        \"split\"\r\n      ],\r\n      \"input_types\": {\r\n        \"data\": \"dataset\"\r\n      },\r\n      \"output_types\": {\r\n        \"model\": \"model\",\r\n     "]
[5440.663504, "o", "   \"predictions\": \"dataset\"\r\n      },\r\n      \"cache_status\": \"miss\",\r\n      \"cv_phase\": null\r\n    },\r\n    \"transform\": {\r\n      \"type\": \"transform\",\r\n      \"depends_on\": [\r\n        \"source\"\r\n      ],\r\n      \"input_types\": {\r\n        \"data\": \"dataset\"\r\n      },\r\n      \"output_types\": {\r\n        \"data\": \"dataset\"\r\n      },\r\n      \"cache_status\": \"miss\",\r\n      \"cv_phase\": null\r\n    }\r\n  },\r\n  \"edges\": [\r\n    {\r\n      \"from\": \"evaluate\",\r\n      \"to\": \"register\",\r\n      \"port\": \"report\"\r\n    },\r\n    {\r\n      \"from\": \"source\",\r\n      \"to\": \"transform\",\r\n      \"port\": \"data\"\r\n    },\r\n    {\r\n      \"from\": \"split\",\r\n      \"to\": \"evaluate\",\r\n      \"port\": \"test\"\r\n    },\r\n    {\r\n      \"from\": \"split\",\r\n      \"to\": \"train\",\r\n      \"port\": \"train\"\r\n    },\r\n    {\r\n      \"from\": \"train\",\r\n      \"to\": \"evaluate\",\r\n      \"port\": \"model\"\r\n    },\r\n    {\r\n      \"from\": \"train\",\r\n      \"to\": \"register\",\r\n      \"port\": \"model\"\r\n    },\r\n    {\r\n      \"from\": \"transform\",\r\n      \"to\": \"split\",\r\n      \"port\": \"data\"\r\n    }\r\n  ]\r\n}\r\n"]
