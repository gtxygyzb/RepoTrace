[1537.326108, "o", "> "]
[1537.326202, "o", "    for _, in := range m.Inputs {\r\n\u001b[?2004l\r"]
[1537.326295, "o", "\u001b[?2004h> "]
[1537.326364, "o", "        if !set[in] {\r\n\u001b[?2004l\r\u001b[?2004h"]
