[10158.222063, "o", "func (v *ArtifactValue) Summary() map[string]interface{} {$\r\n^Iif v.Dataset != nil {$\r\n^I^Ireturn v.Dataset.Summary()$\r\n^I}$\r\n^Iif v.Model != nil {$\r\n^I^Ireturn map[string]interface{}{$\r\n^I^I^I\"algorithm\":   v.Model.Algorithm,$\r\n^I^I^I\"target\":      v.Model.Target,$\r\n^I^I^I\"features\":    v.Model.Features,$\r\n^I^I^I\"hyperparams\": v.Model.Hyperparams,$\r\n^I^I}$\r\n^I^Iif len(v.Model.EnsembleModels) > 0 {$\r\n^I^I^Isummary := map[string]interface{}{\"algorithm\": v.Model.Algorithm, \"target\": v.Model.Target, \"features\": v.Model.Features, \"hyperparams\": v.Model.Hyperparams}$\r\n^I^I^Isummary[\"ensemble_models\"] = v.Model.EnsembleModels$\r\n^I^I^Iif v.Model.ModelData != nil {$\r\n^I^I^I^Isummary[\"model_data\"] = v.Model.ModelData$\r\n^I^I^I}$\r\n^I^I^Ireturn summary$\r\n^I^I}$\r\n^I}$\r\n^Iif v.Report != nil {$\r\n^I^Ireturn v.Report.Summary()$\r\n^I}$\r\n^Iif v.Entry != nil {$\r\n"]
[10158.222538, "o", "\u001b[?2004h"]
