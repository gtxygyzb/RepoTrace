[11973.367147, "o", "   189\t\t\t\tcontinue\r\n   190\t\t\t}\r\n   191\t\t\tfiltered = append(filtered, r)\r\n   192\t\t}\r\n   193\t\r\n   194\t\tsort.Slice(filtered, func(i, j int) bool {\r\n   195\t\t\ta, errA := strconv.ParseInt(filtered[i].RunID, 10, 64)\r\n"]
[11973.367209, "o", "   196\t\t\tb, errB := strconv.ParseInt(filtered[j].RunID, 10, 64)\r\n   197\t\t\tif errA == nil && errB == nil {\r\n   198\t\t\t\treturn a > b\r\n   199\t\t\t}\r\n   200\t\t\treturn filtered[i].RunID > filtered[j].RunID\r\n   201\t\t})\r\n   202\t\r\n   203\t\tif limit >= 0 && len(filtered) > limit {\r\n   204\t\t\tfiltered = filtered[:limit]\r\n   205\t\t}\r\n"]
[11973.36728, "o", "   206\t\r\n   207\t\tprintJSON(HistoryOutput{Runs: filtered, Count: len(filtered)})\r\n   208\t}\r\n   209\t\r\n   210\tfunc loadHistory() ([]HistoryRun, error) {\r\n   211\t\tdir := filepath.Join(\".mlpipe\", \"runs\")\r\n   212\t\tentries, err := os.ReadDir(dir)\r\n"]
[11973.36737, "o", "   213\t\tif err != nil {\r\n   214\t\t\tif os.IsNotExist(err) {\r\n   215\t\t\t\treturn []HistoryRun{}, nil\r\n   216\t\t\t}\r\n   217\t\t\treturn nil, err\r\n   218\t\t}\r\n   219\t\r\n   220\t\truns := []HistoryRun{}\r\n   221\t\tfor _, entry := range entries {\r\n   222\t\t\tif entry.IsDir() {\r\n   223\t\t\t\tcontinue\r\n   224\t\t\t}"]
