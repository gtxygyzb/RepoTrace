[12058.82187, "o", "    74\t\t\t\tif val, ok := globals[key]; ok {\r\n    75\t\t\t\t\treturn fmt.Sprintf(\"%v\", val)\r\n    76\t\t\t\t}\r\n    77\t\t\t\treturn m\r\n    78\t\t\t})\r\n    79\t\tcase map[string]interface{}:\r\n    80\t\t\tres := map[string]interface{}{}\r\n    81\t\t\tfor k, val := range x {\r\n    82\t\t\t\tres[k] = substituteValue(val, globals)\r\n    83\t\t\t}\r\n    84\t\t\treturn res\r\n    85"]
[12058.821982, "o", "\t\tcase []interface{}:\r\n    86\t\t\tres := make([]interface{}, len(x))\r\n    87\t\t\tfor i, val := range x {\r\n    88\t\t\t\tres[i] = substituteValue(val, globals)\r\n    89\t\t\t}\r\n    90\t\t\treturn res\r\n    91\t\tdefault:\r\n    92\t\t\treturn v\r\n    93\t\t}\r\n    94\t}\r\n    95\t\r\n    96\tfunc (c *Config) stageParams(name string, globals map[string]interface{}) map[string]interface{} {\r\n    97\t\tfor _, s := range c.Stages {\r\n    98\t\t\tif s.Name == name {\r\n    99\t\t\t\tif s.Params == nil {\r\n   100\t"]
[12058.822047, "o", "\t\t\t\treturn map[string]interface{}{}\r\n   101\t\t\t\t}\r\n   102\t\t\t\tres := substituteValue(s.Params, globals)\r\n   103\t\t\t\tif m, ok := res.(map[string]interface{}); ok {\r\n   104\t\t\t\t\treturn m\r\n   105\t\t\t\t}\r\n   106\t\t\t\treturn map[string]interface{}{}\r\n   107\t\t\t}\r\n   108\t\t}\r\n"]
[12058.822107, "o", "   109\t\treturn map[string]interface{}{}\r\n   110\t}\r\n   111\t\r\n"]
