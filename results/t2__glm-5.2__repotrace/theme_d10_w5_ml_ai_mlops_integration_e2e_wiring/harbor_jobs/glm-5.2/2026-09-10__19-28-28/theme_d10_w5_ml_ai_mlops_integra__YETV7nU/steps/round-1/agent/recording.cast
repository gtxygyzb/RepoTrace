[10352.703945, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[10352.704026, "o", "\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc main() {"]
[10352.704101, "o", "\r\n\tif len(os.Args) < 2 {\r\n\t\tprintError(\"usage: mlpipe <command> [args]\")\r\n\t\treturn\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"plan\":\r\n\t\tcmdPlan(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"registry\":\r\n\t\tcmdRegistry(args)\r\n\tcase \"lineage\":\r\n\t\tcmdLineage(args)\r\n\tdefault:\r\n\t"]
[10352.704173, "o", "\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n\t}\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n\tconfigPath, overrides, cv, noCache, skipStages, err := parseRunArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\t"]
[10352.704254, "o", "if err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tfor _, name := range skipStages {\r\n\t\tif _, ok := config.stageByName(name); !ok {\r\n\t\t\tprintError(fmt.Sprintf(\"unknown stage: %s\", name))\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n"]
[10352.704313, "o", "\texecutor := NewExecutor(config, overrides)\r\n\texecutor.noCache = noCache\r\n\texecutor.skipStages = skipStages\r\n\tif noCache {\r\n\t\texecutor.cacheStats = nil\r\n\t}\r\n\texecutor.cvFolds = cv\r\n\tvar run interface{}\r\n\tif cv > 0 {\r\n\t\trun, err = executor.RunCV()\r\n\t} else {"]
[10352.704364, "o", "\r\n\t\trun, err = executor.Run()\r\n\t}\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(run)\r\n}\r\n\r\n"]
[10352.704418, "o", "func cmdPlan(args []string) {\r\n\tconfigPath, overrides, cv, err := parsePlanArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\t"]
[10352.704468, "o", "printError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tplan, err := buildPlan(config, overrides, cv)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(plan)\r\n"]
[10352.704523, "o", "}\r\n\r\nfunc cmdValidate(args []string) {\r\n\tconfigPath := \"\"\r\n\toverrides := map[string]string{}\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--param\":\r\n\t\t\tif i+1 >= len(args) {\r\n"]
[10352.704575, "o", "\t\t\t\tprintError(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tkv := args[i+1]\r\n\t\t\ti++\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t"]
[10352.704628, "o", "\t\tif !ok {\r\n\t\t\t\tprintError(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tcase strings.HasPrefix(args[i], \"--param=\"):\r\n\t\t\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\t"]
[10352.704681, "o", "if !ok {\r\n\t\t\t\tprintError(\"--param requires key=value\")\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tdefault:\r\n\t\t\tif configPath == \"\" && !strings.HasPrefix(args[i], \"--\") {\r\n\t\t\t\tconfigPath = args[i]\r\n\t\t\t"]
[10352.704733, "o", "} else {\r\n\t\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif configPath == \"\" {\r\n\t\tprintError(\"usage: mlpipe validate <config.json> [--param key=value ...]\")\r\n"]
