[8928.295132, "o", "type KNNModel struct {\r\n    43\t\tK              int\r\n    44\t\tFeatures       [][]float64\r\n    45\t\tTargets        []float64\r\n    46\t\tClassification bool\r\n    47\t}\r\n    48\t\r\n"]
[8928.295201, "o", "    49\tfunc executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n    50\t\tvar ds *Dataset\r\n    51\t\tfor _, in := range inputs {\r\n    52\t\t\tif in != nil && in.Dataset != nil {\r\n    53\t\t\t\tds = in.Dataset\r\n    54\t\t\t\tbreak\r\n    55\t"]
[8928.295287, "o", "\t\t}\r\n    56\t\t}\r\n    57\t\tif ds == nil {\r\n    58\t\t\treturn nil, fmt.Errorf(\"train stage %q requires input data\", stage.Name)\r\n    59\t\t}\r\n    60\t\r\n"]
