[11439.910788, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"math/rand\"\r\n\t\"sort\"\r\n"]
[11439.910864, "o", "\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\ntype Model struct {\r\n\tAlgorithm       string `json:\"algorithm\"`\r\n\tTarget          string\r\n\tFeatures        []string\r\n\tHyperparams     map[string]interface{}\r\n\tClassification  bool\r\n\tLinearWeights   []float64\r\n\tLogisticWeights []float64\r\n\tTree            *TreeNode\r\n"]
[11439.910944, "o", "\tForest          []*TreeNode\r\n\tBoost           []*BoostedTree\r\n\tKNN             *KNNModel\r\n\tTrainFeatures   [][]float64\r\n\tTrainTarget     []float64\r\n\tEnsembleModels  []string               `json:\"ensemble_models,omitempty\"`\r\n\tModelData       map[string]interface{} `json:\"model_data,omitempty\"`\r\n}\r\n\r\ntype TreeNode struct {\r\n\tIsLeaf      bool\r\n\tPrediction  float64\r\n\tProbability float64\r\n\tFeature     int\r\n"]
[11439.911006, "o", "\tThreshold   float64\r\n\tLeft        *TreeNode\r\n\tRight       *TreeNode\r\n}\r\n\r\ntype BoostedTree struct {\r\n\tTree           *TreeNode\r\n\tLearningRate   float64\r\n\tInitPrediction float64\r\n}\r\n\r\n"]
[11439.911067, "o", "type KNNModel struct {\r\n\tK              int\r\n\tFeatures       [][]float64\r\n\tTargets        []float64\r\n\tClassification bool\r\n}\r\n\r\nfunc executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tvar ds *Dataset\r\n\t"]
[11439.911137, "o", "for _, in := range inputs {\r\n\t\tif in != nil && in.Dataset != nil {\r\n\t\t\tds = in.Dataset\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif ds == nil {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires input data\", stage.Name)\r\n\t}\r\n\r\n\talgorithm, ok := getString(params, \"algorithm\")\r\n"]
[11439.911202, "o", "\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires algorithm\", stage.Name)\r\n\t}\r\n\ttarget, ok := getString(params, \"target\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires target\", stage.Name)\r\n\t}\r\n\ttargetVals, err := ds.NumericColumn(target)\r\n\tif err != nil {\r\n\t\treturn nil, err"]
[11439.911269, "o", "\r\n\t}\r\n\tclassification := isBinary01(targetVals)\r\n\tif algorithm == \"linear-regression\" {\r\n\t\tclassification = false\r\n\t}\r\n"]
