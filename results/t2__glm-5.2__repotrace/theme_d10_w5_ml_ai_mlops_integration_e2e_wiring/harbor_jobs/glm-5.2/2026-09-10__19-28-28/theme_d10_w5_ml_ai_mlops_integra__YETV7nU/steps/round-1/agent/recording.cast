[1890.578047, "o", "\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tmodel.Tree = \u001b[01;31m\u001b[KtrainDecisionTree(\u001b[m\u001b[KX, y, features, classification, 0, maxDepth, minSplit)\r\n"]
[1890.57831, "o", "\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc trainDecisionTree\u001b[m\u001b[K(X [][]float64, y []float64, features []string, classification bool, depth, maxDepth, minSplit int) *TreeNode {\r\n"]
[1890.578383, "o", "\u001b[32m\u001b[K369\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tnode.Left = \u001b[01;31m\u001b[KtrainDecisionTree(\u001b[m\u001b[KleftX, subsetY(y, bestLeftIdx), features, classification, depth+1, maxDepth, minSplit)\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tnode.Right = \u001b[01;31m\u001b[KtrainDecisionTree(\u001b[m\u001b[KrightX, subsetY(y, bestRightIdx), features, classification, depth+1, maxDepth, minSplit)\r\n"]
[1890.578518, "o", "\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc trainRandomForest\u001b[m\u001b[K(X [][]float64, y []float64, features []string, classification bool, nEst, maxDepth int, maxFeatures string, stageName string) []*TreeNode {\r\n"]
[1890.578609, "o", "\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kselected\u001b[m\u001b[K := rng.Perm(m)\r\n\u001b[32m\u001b[K429\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kselected\u001b[m\u001b[K = \u001b[01;31m\u001b[Kselected\u001b[m\u001b[K[:mf]\r\n"]
[1890.578699, "o", "\u001b[32m\u001b[K430\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KsubFeatures\u001b[m\u001b[K := []string{}\r\n"]
[1890.578759, "o", "\u001b[32m\u001b[K431\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KsubX\u001b[m\u001b[K := make([][]float64, len(bootX))\r\n\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KsubX\u001b[m\u001b[K[r] = []float64{}\r\n\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor _, s := range \u001b[01;31m\u001b[Kselected\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K435\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[KsubX\u001b[m\u001b[K[r] = append(\u001b[01;31m\u001b[KsubX\u001b[m\u001b[K[r], bootX[r][s])\r\n\u001b[32m\u001b[K438\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, s := range \u001b[01;31m\u001b[Kselected\u001b[m\u001b[K {\r\n"]
[1890.57883, "o", "\u001b[32m\u001b[K439\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KsubFeatures\u001b[m\u001b[K = append(\u001b[01;31m\u001b[KsubFeatures\u001b[m\u001b[K, features[s])\r\n\u001b[32m\u001b[K441\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\ttree := \u001b[01;31m\u001b[KtrainDecisionTree(\u001b[m\u001b[K\u001b[01;31m\u001b[KsubX\u001b[m\u001b[K, bootY, \u001b[01;31m\u001b[KsubFeatures\u001b[m\u001b[K, classification, 0, maxDepth, 2)\r\n\u001b[32m\u001b[K491\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\ttree := \u001b[01;31m\u001b[KtrainDecisionTree(\u001b[m\u001b[KX, residual, features, false, 0, maxDepth, 2)\r\n"]
