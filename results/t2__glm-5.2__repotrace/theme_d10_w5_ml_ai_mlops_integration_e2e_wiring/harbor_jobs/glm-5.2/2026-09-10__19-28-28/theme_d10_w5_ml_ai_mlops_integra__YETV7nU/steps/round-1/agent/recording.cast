[2877.160213, "o", "   240\t\t}\r\n   241\t\tfor _, s := range c.Stages {\r\n   242\t\t\tfor _, dep := range s.DependsOn {\r\n   243\t\t\t\tif _, ok := c.stageByName(dep); ok {\r\n   244\t\t\t\t\tadj[dep] = append(adj[dep], s.Name)\r\n   245\t\t\t\t\tindeg[s.Name]++\r\n   246\t\t\t\t}\r\n"]
