[10351.611265, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
[10351.61134, "o", "\t\"sort\"\r\n)\r\n\r\ntype Report struct {\r\n\tMetrics map[string]interface{} `json:\"metrics\"`\r\n\tPass    bool                   `json:\"pass\"`\r\n}\r\n\r\nfunc executeEvaluate(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tmodelVal := inputs[\"model\"]\r\n\tif modelVal == nil || modelVal.Model == nil {\r\n\t\treturn nil, fmt.Errorf(\"evaluate stage %q requires model input\", stage.Name)\r\n"]
[10351.611444, "o", "\t}\r\n\tds := inputDataset(inputs)\r\n\tif ds == nil {\r\n\t\treturn nil, fmt.Errorf(\"evaluate stage %q requires data input\", stage.Name)\r\n\t}\r\n\tmodel := modelVal.Model\r\n\r\n\tmetrics, ok := getStringSlice(params, \"metrics\")\r\n"]
[10351.611518, "o", "\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"evaluate stage %q requires metrics\", stage.Name)\r\n\t}\r\n\tthreshold, _ := getMap(params, \"threshold\")\r\n\r\n\ty, err := ds.NumericColumn(model.Target)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tX, err := ds.featureMatrix(model.Features)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tpreds := model.PredictBatch(X)\r\n\tclassification := isBinary01(y)\r\n\r\n\treport := &Report{Metrics: map[string]interface{}{}, Pass: true}\r\n\r\n\tfor _, metric := range metrics {\r\n\t\tvar val interface{}\r\n\t\tvar err error\r\n\t"]
[10351.611598, "o", "\tswitch metric {\r\n\t\tcase \"accuracy\", \"precision\", \"recall\", \"f1\", \"auc\", \"logloss\", \"confusion_matrix\":\r\n\t\t\tif !classification {\r\n\t\t\t\terr = fmt.Errorf(\"metric %q requires binary 0/1 target\", metric)\r\n\t\t\t"]
[10351.611669, "o", "} else {\r\n\t\t\t\tval, err = classificationMetric(metric, y, preds)\r\n\t\t\t}\r\n\t\tcase \"mse\", \"rmse\", \"mae\", \"r2\", \"mape\":\r\n\t\t\tif classification {\r\n\t\t\t\terr = fmt.Errorf(\"metric %q requires regression target\", metric)\r\n\t\t\t} else {\r\n\t\t\t\tval, err = regressionMetric(metric, y, preds)\r\n\t\t\t}\r\n\t\tdefault:\r\n\t\t\terr = fmt.Errorf(\"unknown metric %q\", metric)\r\n\t\t}\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treport.Metrics[metric] = val\r\n\t}\r\n"]
[10351.61173, "o", "\r\n\tif threshold != nil {\r\n\t\tfor metricName, thresholdVal := range threshold {\r\n\t\t\tmetricValue, ok := report.Metrics[metricName]\r\n\t\t\tif !ok {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tfv, ok := toFloat64(metricValue)\r\n"]
[10351.61183, "o", "\t\t\tif !ok {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\ttv, ok := toFloat64(thresholdVal)\r\n\t\t\tif !ok {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif fv < tv {\r\n\t\t\t\treport.Pass = false\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\treturn map[string]*ArtifactValue{\"report\": {Report: report}}, nil\r\n}\r\n"]
[10351.611895, "o", "\r\nfunc classificationMetric(name string, y []float64, preds []float64) (interface{}, error) {\r\n\tlabels := make([]int, len(preds))\r\n\tfor i, p := range preds {\r\n\t\tif p >= 0.5 {\r\n"]
[10351.611962, "o", "\t\t\tlabels[i] = 1\r\n\t\t} else {\r\n\t\t\tlabels[i] = 0\r\n\t\t}\r\n\t}\r\n\tswitch name {\r\n\tcase \"accuracy\":\r\n\t\tcorrect := 0\r\n\t\tfor i := range y {\r\n\t\t\tif labels[i] == int(y[i]) {\r\n\t\t\t\tcorrect++\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn float64(correct) / float64(len(y)), nil\r\n\tcase \"precision\":\r\n"]
[10351.612041, "o", "\t\ttp, fp := 0, 0\r\n\t\tfor i := range y {\r\n\t\t\tif labels[i] == 1 {\r\n\t\t\t\tif y[i] == 1 {\r\n"]
[10351.612103, "o", "\t\t\t\t\ttp++\r\n\t\t\t\t} else {\r\n\t\t\t\t\tfp++\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif tp+fp == 0 {\r\n\t\t\treturn 0.0, nil\r\n\t\t}\r\n\t\treturn float64(tp) / float64(tp+fp), nil\r\n\tcase \"recall\":\r\n\t\ttp, fn := 0, 0\r\n\t\tfor i := range y {\r\n\t\t\tif y[i] == 1 {\r\n\t\t\t\tif labels[i] == 1 {\r\n"]
[10351.612171, "o", "\t\t\t\t\ttp++\r\n\t\t\t\t} else {\r\n\t\t\t\t\tfn++\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif tp+fn == 0 {\r\n\t\t\treturn 0.0, nil\r\n\t\t}\r\n\t\treturn float64(tp) / float64(tp+fn), nil\r\n\tcase \"f1\":\r\n\t"]
[10351.612242, "o", "\tp, _ := classificationMetric(\"precision\", y, preds)\r\n\t\tr, _ := classificationMetric(\"recall\", y, preds)\r\n\t\tpf := p.(float64)\r\n\t\trf := r.(float64)\r\n\t\tif pf+rf == 0 {\r\n\t\t\treturn 0.0, nil\r\n\t\t}\r\n\t\treturn 2 * pf * rf / (pf + rf), nil\r\n\tcase \"auc\":\r\n\t"]
[10351.612305, "o", "\treturn aucROC(y, preds), nil\r\n\tcase \"logloss\":\r\n\t\tsum := 0.0\r\n\t\tfor i := range y {\r\n\t\t\tp := clamp(preds[i], 1e-15, 1-1e-15)\r\n\t\t\tsum += y[i]*math.Log(p) + (1-y[i])*math.Log(1-p)\r\n\t\t}\r\n\t\treturn -sum / float64(len(y)), nil\r\n\tcase \"confusion_matrix\":\r\n\t\ttp, fp, tn, fn := 0, 0, 0, 0\r\n"]
[10351.612379, "o", "\t\tfor i := range y {\r\n\t\t\tif labels[i] == 1 && y[i] == 1 {\r\n\t\t\t\ttp++\r\n\t\t\t} else if labels[i] == 1 && y[i] == 0 {\r\n\t\t\t\tfp++\r\n\t\t\t} else if labels[i] == 0 && y[i] == 0 {\r\n\t\t\t\ttn++\r\n\t\t\t} else {\r\n\t\t\t\tfn++\r\n\t\t\t}\r\n"]
[10351.612444, "o", "\t\t}\r\n\t\treturn map[string]int{\"tp\": tp, \"fp\": fp, \"tn\": tn, \"fn\": fn}, nil\r\n\t}\r\n\treturn nil, fmt.Errorf(\"unknown classification metric %q\", name)\r\n}\r\n\r\nfunc regressionMetric(name string, y []float64, preds []float64) (interface{}, error) {\r\n\tn := float64(len(y))\r\n\tswitch name {\r\n\tcase \"mse\":\r\n\t\tsum := 0.0\r\n\t"]
[10351.612511, "o", "\tfor i := range y {\r\n\t\t\td := y[i] - preds[i]\r\n\t\t\tsum += d * d\r\n\t\t}\r\n\t\treturn sum / n, nil\r\n\tcase \"rmse\":\r\n\t\t"]
[10351.612577, "o", "mse, _ := regressionMetric(\"mse\", y, preds)\r\n\t\treturn math.Sqrt(mse.(float64)), nil\r\n\tcase \"mae\":\r\n\t\tsum := 0.0\r\n\t\tfor i := range y {\r\n\t\t\tsum += math.Abs(y[i] - preds[i])\r\n\t\t}\r\n\t\treturn sum / n, nil\r\n\tcase \"r2\":\r\n\t\tmean := 0.0\r\n\t\tfor _, v := range y {\r\n\t\t\tmean += v\r\n\t\t}\r\n\t"]
[10351.61264, "o", "\tmean /= n\r\n\t\tssRes := 0.0\r\n\t\tssTot := 0.0\r\n\t\tfor i := range y {\r\n\t\t\tssRes += (y[i] - preds[i]) * (y[i] - preds[i])\r\n"]
[10351.612706, "o", "\t\t\tssTot += (y[i] - mean) * (y[i] - mean)\r\n\t\t}\r\n\t\tif ssTot == 0 {\r\n\t\t\tif ssRes == 0 {\r\n\t\t\t\treturn 1.0, nil\r\n\t\t\t}\r\n\t\t\treturn nil, nil\r\n\t\t}\r\n\t\treturn 1 - ssRes/ssTot, nil\r\n"]
[10351.612766, "o", "\tcase \"mape\":\r\n\t\tsum := 0.0\r\n\t\tcount := 0.0\r\n\t\tfor i := range y {\r\n\t\t\tif y[i] == 0 {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
