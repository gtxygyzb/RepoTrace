[11883.437198, "o", "func (e *Executor) Run() (*RunOutput, error) {\r\n\tvalid, errs := e.config.Validate()\r\n\tif !valid {\r\n\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n\t}\r\n\torder, err := e.config.topologicalOrder()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n"]
[11883.437364, "o", "\t}\r\n\r\n\trunArtifacts := map[string]*ArtifactOutput{}\r\n\r\n\tskipSet := map[string]bool{}\r\n\tfor _, name := range e.skipStages {\r\n\t\tskipSet[name] = true\r\n\t}\r\n\r\n\tonFailure := e.config.Pipeline.OnFailure\r\n\tif onFailure != \"continue\" {\r\n\t\tonFailure = \"stop\"\r\n\t}\r\n\tstopped := false\r\n\r\n\tfor _, name := range order {\r\n\t\tstage, _ := e.config.stageByName(name)\r\n\t\te.outputs[name] = map[string]string{}\r\n"]
[11883.437435, "o", "\t\te.values[name] = map[string]*ArtifactValue{}\r\n\t\te.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n\r\n\t\tif stopped {\r\n\t\t\te.status[name] = \"skipped\"\r\n\t\t\te.results[name].Status = \"skipped\"\r\n\t\t\te.results[name].DurationMs = 0\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[11883.437495, "o", "\r\n\t\tif skipSet[name] {\r\n\t\t\te.status[name] = \"skipped\"\r\n\t\t\te.results[name].Status = \"skipped\"\r\n\t\t\te.results[name].DurationMs = 0\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n"]
[11883.437555, "o", "\t\tskip := false\r\n\t\tfor _, dep := range stage.DependsOn {\r\n\t\t\tdepStatus := e.status[dep]\r\n\t\t\tif depStatus != \"success\" {\r\n\t\t\t\tskip = true\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n"]
[11883.437613, "o", "\t\tif skip {\r\n\t\t\te.status[name] = \"skipped\"\r\n\t\t\te.results[name].Status = \"skipped\"\r\n\t\t\te.results[name].DurationMs = 0\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n"]
[11883.437675, "o", "\t\tinputValues, inputIDs, err := e.resolveInputs(stage)\r\n\t\tif err != nil {\r\n\t\t\te.status[name] = \"failed\"\r\n\t\t\te.results[name].Status = \"failed\"\r\n\t\t\te.results[name].Error = err.Error()\r\n\t\t\tif onFailure == \"stop\" {\r\n\t\t\t\tstopped = true\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
[11883.437734, "o", "\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tparams := e.config.stageParams(name, e.globals)\r\n\t\tinputKeys := e.inputCacheKeys(stage)\r\n\t\tcacheKey, keyErr := computeCacheKey(stage, params, inputKeys, -1)\r\n\t\tif keyErr != nil {\r\n\t\t\te.status[name] = \"failed\"\r\n\t\t\te.results[name].Status = \"failed\"\r\n"]
[11883.437801, "o", "\t\t\te.results[name].Error = keyErr.Error()\r\n\t\t\tif onFailure == \"stop\" {\r\n\t\t\t\tstopped = true\r\n\t\t\t\tcontinue\r\n\t\t\t"]
[11883.437866, "o", "}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\te.cacheKeys[name] = cacheKey\r\n\r\n\t\tvar out map[string]*ArtifactValue\r\n\t\tstart := time.Now()\r\n\t\tif !e.noCache && cacheEntryExists(cacheKey) {\r\n\t\t\tloaded, err := loadCacheEntry(cacheKey)\r\n\t\t\tduration := time.Since(start).Milliseconds()\r\n"]
[11883.437927, "o", "\t\t\te.results[name].DurationMs = duration\r\n\t\t\tif err == nil {\r\n\t\t\t\tout = loaded\r\n\t\t\t\te.results[name].CacheHit = true\r\n\t\t\t\te.cacheStats.Hits++\r\n\t\t\t} else {\r\n\t\t\t\tif !e.noCache {\r\n\t\t\t\t\te.cacheStats.Misses++\r\n\t\t\t\t}\r\n\t\t\t\tout, err = executeStage(stage, params, inputValues)\r\n\t\t\t\tduration = time.Since(start).Milliseconds()\r\n"]
[11883.437989, "o", "\t\t\t\te.results[name].DurationMs = duration\r\n\t\t\t\tif err != nil {\r\n\t\t\t\t\te.status[name] = \"failed\"\r\n\t\t\t\t\te.results[name].Status = \"failed\"\r\n\t\t\t\t\te.results[name].Error = err.Error()\r\n\t\t\t\t\tif onFailure == \"stop\" {\r\n\t\t\t\t\t\tstopped = true\r\n"]
