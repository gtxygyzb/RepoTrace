[1537.523305, "o", "\u001b[?2004h> "]
[1537.52336, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.523419, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
