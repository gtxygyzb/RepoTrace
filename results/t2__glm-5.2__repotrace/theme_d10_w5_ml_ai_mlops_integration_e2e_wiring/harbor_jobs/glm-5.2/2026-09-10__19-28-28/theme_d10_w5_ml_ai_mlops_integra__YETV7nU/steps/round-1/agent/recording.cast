[4205.937207, "o", "\u001b[?2004h> "]
[4205.93731, "o", "        ds.Rows[i] = make([]string, len(row))\r\n\u001b[?2004l\r\u001b[?2004h"]
[4205.937364, "o", "> "]
[4205.93742, "o", "        for j, v := range row {\r\n\u001b[?2004l\r"]
[4205.937474, "o", "\u001b[?2004h> "]
