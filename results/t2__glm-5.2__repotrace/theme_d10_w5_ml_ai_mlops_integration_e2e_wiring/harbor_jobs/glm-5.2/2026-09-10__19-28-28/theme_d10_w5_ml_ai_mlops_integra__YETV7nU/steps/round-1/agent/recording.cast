[8798.374122, "o", "\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\t"]
[8798.374248, "o", "out := make([]map[string]interface{}, len(entries))\r\n\tfor i, e := range entries {\r\n\t\tout[i] = map[string]interface{}{\r\n\t\t\t\"name\":          e.Name,\r\n\t\t\t\"version\":       e.Version,\r\n\t\t\t\"stage\":         e.Stage,\r\n\t\t\t\"tags\":          e.Tags,\r\n\t\t\t\"metrics\":       e.Metrics,\r\n\t\t\t\"registered_at\": e.RegisteredAt,\r\n\t\t}\r\n\t}\r\n\tprintJSON(out)\r\n}\r\n\r\nfunc cmdRegistryInfo(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe registry info <name>:<version>\")\r\n\t\treturn\r\n\t}\r\n\tname, version, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tentry, err := registryInfo(name, version)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(entry)\r\n}\r\n\r\nfunc cmdRegistryPromote(args []string) {\r\n\tif len(args) < 2 {\r\n\t\t"]
[8798.374351, "o", "printError(\"usage: mlpipe registry promote <name>:<version> <target_stage>\")\r\n\t\treturn\r\n\t}\r\n\tname, version, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\ttarget := args[1]\r\n\tentry, prev, new, err := promoteModel(name, version, target)\r\n\tif err != nil {\r\n\t\tif strings.HasPrefix(err.Error(), \"metric \") {\r\n\t\t\tprintJSON(map[string]interface{}{\"success\": false, \"message\": err.Error()})\r\n\t\t\treturn\r\n\t\t}\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n"]
[8798.374439, "o", "\tprintJSON(map[string]interface{}{\r\n\t\t\"success\":        true,\r\n\t\t\"message\":        fmt.Sprintf(\"promoted to %s\", new),\r\n\t\t\"previous_stage\": prev,\r\n"]
[8798.374521, "o", "\t\t\"new_stage\":      entry.Stage,\r\n\t})\r\n}\r\n\r\nfunc cmdRegistryCompare(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tprintError(\"usage: mlpipe registry compare <name>:<version1> <name>:<version2>\")\r\n\t\treturn\r\n\t}\r\n\tname1, v1, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tname2, v2, ok := splitNameVersion(args[1])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tif name1 != name2 {\r\n\t\tprintError(\"cannot compare different model names\")\r\n\t\treturn\r\n\t}\r\n\tresult, err := compareModels(name1, v1, v2)\r\n\tif err != nil {"]
[8798.374613, "o", "\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(result)\r\n}\r\n\r\nfunc cmdLineage(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tprintError(\"usage: mlpipe lineage <artifact_id> <up|down|both>\")\r\n\t\treturn\r\n\t}\r\n\tid := args[0]\r\n\tdirection := args[1]\r\n\tresult, err := queryLineage(id, direction)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\t"]
