[8827.66308, "o", "\u001b[?2004l\r"]
[8827.665807, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[8827.665879, "o", "\t\"os\"\r\n\t\"regexp\"\r\n\t\"strings\"\r\n)\r\n\r\ntype Config struct {\r\n\tPipeline PipelineConfig `json:\"pipeline\"`\r\n\tStages   []StageConfig  `json:\"stages\"`\r\n}\r\n\r\ntype PipelineConfig struct {\r\n\tName   string                 `json:\"name\"`\r\n\tParams map[string]interface{} `json:\"params\"`\r\n}\r\n\r\n"]
[8827.665953, "o", "type StageConfig struct {\r\n\tName      string                 `json:\"name\"`\r\n\tType      string                 `json:\"type\"`\r\n\tDependsOn []string               `json:\"depends_on\"`\r\n\tInputs    map[string]string      `json:\"inputs\"`\r\n\tParams    map[string]interface{} `json:\"params\"`\r\n}\r\n\r\nvar paramRE = regexp.MustCompile(`\\$\\{([^}]+)\\}`)\r\n\r\nfunc loadConfig(path string) (*Config, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n"]
[8827.666017, "o", "\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, fmt.Errorf(\"file not found: %s\", path)\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\tvar c Config\r\n\tif err := json.Unmarshal(data, &c); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"invalid config: %s\", err.Error())\r\n\t"]
[8827.666062, "o", "}\r\n\treturn &c, nil\r\n}\r\n\r\nfunc (c *Config) globalParams(overrides map[string]string) map[string]interface{} {\r\n\tparams := map[string]interface{}{}\r\n\tfor k, v := range c.Pipeline.Params {\r\n\t\tparams[k] = v\r\n"]
[8827.666148, "o", "\t}\r\n\tfor k, v := range overrides {\r\n\t\tparams[k] = v\r\n\t}\r\n\treturn params\r\n}\r\n\r\nfunc substituteValue(v interface{}, globals map[string]interface{}) interface{} {\r\n\tswitch x := v.(type) {\r\n\tcase string:\r\n\t\treturn paramRE.ReplaceAllStringFunc(x, func(m string) string {\r\n\t\t\tkey := m[2 : len(m)-1]\r\n\t\t\tif val, ok := globals[key]; ok {\r\n"]
[8827.666214, "o", "\t\t\t\treturn fmt.Sprintf(\"%v\", val)\r\n\t\t\t}\r\n\t\t\treturn m\r\n\t\t})\r\n\tcase map[string]interface{}:\r\n\t\tres := map[string]interface{}{}\r\n\t\tfor k, val := range x {\r\n"]
[8827.666315, "o", "\t\t\tres[k] = substituteValue(val, globals)\r\n\t\t}\r\n\t\treturn res\r\n\tcase []interface{}:\r\n\t\tres := make([]interface{}, len(x))\r\n\t\tfor i, val := range x {\r\n\t\t\tres[i] = substituteValue(val, globals)\r\n\t\t}\r\n\t\treturn res\r\n\tdefault:\r\n\t\treturn v\r\n\t}\r\n}\r\n\r\nfunc (c *Config) stageParams(name string, globals map[string]interface{}) map[string]interface{} {\r\n\tfor _, s := range c.Stages {\r\n\t\tif s.Name == name {\r\n\t\t\tif s.Params == nil {\r\n\t\t\t\treturn map[string]interface{}{}\r\n"]
[8827.666377, "o", "\t\t\t}\r\n\t\t\tres := substituteValue(s.Params, globals)\r\n\t\t\tif m, ok := res.(map[string]interface{}); ok {\r\n\t\t\t\treturn m\r\n\t\t\t}\r\n\t\t\treturn map[string]interface{}{}\r\n\t\t}\r\n\t}\r\n\treturn map[string]interface{}{}\r\n}\r\n"]
[8827.66644, "o", "\r\nfunc (c *Config) stageByName(name string) (*StageConfig, bool) {\r\n\tfor i := range c.Stages {\r\n\t\tif c.Stages[i].Name == name {\r\n\t\t\treturn &c.Stages[i], true\r\n\t\t}\r\n\t}\r\n\treturn nil, false\r\n}\r\n\r\nfunc validOutputPorts(t string) []string {\r\n"]
[8827.666496, "o", "\tswitch t {\r\n\tcase \"data-source\":\r\n\t\treturn []string{\"data\"}\r\n\tcase \"transform\":\r\n\t\treturn []string{\"data\"}\r\n\tcase \"split\":\r\n\t\treturn []string{\"train\", \"test\"}\r\n\tcase \"train\":\r\n\t\treturn []string{\"model\", \"predictions\"}\r\n"]
[8827.666557, "o", "\tcase \"evaluate\":\r\n\t\treturn []string{\"report\"}\r\n\tcase \"register\":\r\n\t\treturn []string{\"entry\"}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc validStageType(t string) bool {\r\n\tswitch t {\r\n"]
[8827.666617, "o", "\tcase \"data-source\", \"transform\", \"split\", \"train\", \"evaluate\", \"register\":\r\n\t\treturn true\r\n"]
