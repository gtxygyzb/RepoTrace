[2884.625386, "o", "\r\n    31\t}\r\n    32\t\r\n    33\tfunc cmdRun(args []string) {\r\n    34\t\tif len(args) < 1 {\r\n    35\t\t\tprintError(\"usage: mlpipe run <config.json> [--param key=value ...]\")\r\n    36\t\t\treturn\r\n    37\t\t}\r\n    38\t\tconfigPath := args[0]\r\n    39\t\toverrides, err := parseParams(args[1:])\r\n    40\t\tif err != nil {\r\n    41\t\t\tprintError(err.Error())\r\n"]
[2884.625451, "o", "    42\t\t\treturn\r\n    43\t\t}\r\n    44\t\tconfig, err := loadConfig(configPath)\r\n    45\t\tif err != nil {\r\n    46\t\t\tprintError(err.Error())\r\n    47\t\t\treturn\r\n    48\t\t}\r\n    49\t\texecutor := NewExecutor(config, overrides)\r\n    50\t\trun, err := executor.Run()\r\n    51\t\tif err != nil {\r\n    52\t\t\tprintError(err.Error())\r\n"]
