[7376.478664, "o", "\u001b[32m\u001b[K266\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\thpDiff := map[string]interface{}{}\r\n\u001b[32m\u001b[K268\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\thpNames := map[string]bool{}\r\n\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k := range e1.Hyperparams {\r\n\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\thpNames[k] = true\r\n\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k := range e2.Hyperparams {\r\n\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\thpNames[k] = true\r\n\u001b[32m\u001b[K274\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K275\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k := range hpNames {\r\n\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tv1v, ok1 := e1.Hyperparams[k]\r\n\u001b[32m\u001b[K277\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tv2v, ok2 := e2.Hyperparams[k]\r\n\u001b[32m\u001b[K278\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[7376.478729, "o", "\t\tif !ok1 || !ok2 || fmt.Sprintf(\"%v\", v1v) != fmt.Sprintf(\"%v\", v2v) {\r\n\u001b[32m\u001b[K279\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\thpDiff[k] = map[string]interface{}{\"v1\": v1v, \"v2\": v2v}\r\n\u001b[32m\u001b[K280\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K281\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K282\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K283\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn map[string]interface{}{\r\n\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\"model_name\":       name,\r\n\u001b[32m\u001b[K285\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\"versions\":         []int{v1, v2},\r\n\u001b[32m\u001b[K286\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t"]
