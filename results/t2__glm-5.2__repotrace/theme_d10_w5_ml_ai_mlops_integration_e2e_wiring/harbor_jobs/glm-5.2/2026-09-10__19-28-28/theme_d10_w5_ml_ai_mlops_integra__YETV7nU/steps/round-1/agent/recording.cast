[2651.777128, "o", "s=s.replace('rules, _ := getMap(params, \"promotion_rules\")', 'rules, _ := getMap(params, \"promotion_rules\")\\n    if rules == nil {\\n        rules = map[string]interface{}{}\\n    }')\r\n\u001b[?2004l\r"]
[2651.777205, "o", "\u001b[?2004h> "]
[2651.777618, "o", "# Generalize promotion rule checks and keep production archiving separate\r\n\u001b[?2004l\r"]
[2651.777682, "o", "\u001b[?2004h> "]
[2651.781819, "o", "pat=re.compile(r'if targetStage == \"production\" \\{\\s*if entry\\.PromotionRules != nil \\{\\s*if rules, ok := entry\\.PromotionRules\\[targetStage\\]\\.\\(map\\[string\\]interface\\{\\}\\); ok \\{\\s*for metricName, thresholdVal := range rules \\{\\s*metricValue, ok := entry\\.Metrics\\[metricName\\]\\s*if !ok \\{\\s*continue\\s*\\}\\s*mv, ok := toFloat64\\(metricValue\\)\\s*if !ok \\{\\s*continue\\s*\\}\\s*tv, ok := toFloat64\\(thresholdVal\\)\\s*if !ok \\{\\s*continue\\s*\\}\\s*if mv < tv \\{\\s*return nil, prevStage, targetStage, fmt\\.Errorf\\(\"metric %s \\(%v\\) below threshold \\(%v\\)\", metricName, mv, tv\\)\\s*\\}\\s*\\}\\s*\\}\\s*for _, e := range entries \\{\\s*if e\\.Name == name && e\\.Stage == \"production\" && e\\.Version != version \\{\\s*e\\.Stage = \"archived\"\\s*\\}\\s*\\}\\s*\\}', re.S)\r\n\u001b[?2004l\r"]
[2651.781885, "o", "\u001b[?2004h> "]
[2651.782116, "o", "new='''if entry.PromotionRules != nil {\r\n\u001b[?2004l\r"]
[2651.78218, "o", "\u001b[?2004h> "]
[2651.782692, "o", "        if rules, ok := entry.PromotionRules[targetStage].(map[string]interface{}); ok {\r\n\u001b[?2004l\r"]
[2651.782748, "o", "\u001b[?2004h> "]
[2651.783072, "o", "            for metricName, thresholdVal := range rules {\r\n\u001b[?2004l\r"]
[2651.78314, "o", "\u001b[?2004h> "]
[2651.783485, "o", "                metricValue, ok := entry.Metrics[metricName]\r\n\u001b[?2004l\r"]
[2651.783541, "o", "\u001b[?2004h> "]
[2651.78368, "o", "                if !ok {\r\n\u001b[?2004l\r"]
[2651.783741, "o", "\u001b[?2004h> "]
[2651.784307, "o", "                    return nil, prevStage, targetStage, fmt.Errorf(\"metric %s missing\", metricName)\r\n\u001b[?2004l\r"]
[2651.784365, "o", "\u001b[?2004h> "]
[2651.784467, "o", "                }\r\n\u001b[?2004l\r"]
[2651.784521, "o", "\u001b[?2004h> "]
[2651.784796, "o", "                mv, ok := toFloat64(metricValue)\r\n\u001b[?2004l\r"]
[2651.784847, "o", "\u001b[?2004h> "]
[2651.784997, "o", "                if !ok {\r\n\u001b[?2004l\r"]
[2651.785054, "o", "\u001b[?2004h> "]
[2651.785659, "o", "                    return nil, prevStage, targetStage, fmt.Errorf(\"metric %s is not numeric\", metricName)\r\n\u001b[?2004l\r"]
[2651.785716, "o", "\u001b[?2004h> "]
[2651.785821, "o", "                }\r\n\u001b[?2004l\r"]
[2651.785875, "o", "\u001b[?2004h> "]
[2651.786155, "o", "                tv, ok := toFloat64(thresholdVal)\r\n\u001b[?2004l\r"]
[2651.786209, "o", "\u001b[?2004h> "]
[2651.786365, "o", "                if !ok {\r\n\u001b[?2004l\r"]
[2651.786429, "o", "\u001b[?2004h> "]
[2651.786587, "o", "                    continue\r\n\u001b[?2004l\r"]
[2651.786643, "o", "\u001b[?2004h> "]
[2651.786745, "o", "                }\r\n\u001b[?2004l\r"]
[2651.786799, "o", "\u001b[?2004h> "]
[2651.786966, "o", "                if mv < tv {\r\n\u001b[?2004l\r"]
[2651.78702, "o", "\u001b[?2004h> "]
[2651.787737, "o", "                    return nil, prevStage, targetStage, fmt.Errorf(\"metric %s (%v) below threshold (%v)\", metricName, mv, tv)\r\n\u001b[?2004l\r"]
[2651.787798, "o", "\u001b[?2004h> "]
[2651.787893, "o", "                }\r\n\u001b[?2004l\r"]
[2651.787952, "o", "\u001b[?2004h> "]
[2651.788028, "o", "            }\r\n\u001b[?2004l\r"]
[2651.788094, "o", "\u001b[?2004h> "]
[2651.788155, "o", "        }\r\n\u001b[?2004l\r"]
[2651.788208, "o", "\u001b[?2004h> "]
[2651.788273, "o", "    }\r\n\u001b[?2004l\r"]
[2651.788327, "o", "\u001b[?2004h> "]
[2651.788522, "o", "    if targetStage == \"production\" {\r\n\u001b[?2004l\r"]
[2651.788575, "o", "\u001b[?2004h> "]
[2651.788782, "o", "        for _, e := range entries {\r\n\u001b[?2004l\r"]
[2651.788836, "o", "\u001b[?2004h> "]
[2651.789306, "o", "            if e.Name == name && e.Stage == \"production\" && e.Version != version {\r\n\u001b[?2004l\r"]
[2651.789371, "o", "\u001b[?2004h> "]
[2651.789571, "o", "                e.Stage = \"archived\"\r\n\u001b[?2004l\r"]
[2651.789619, "o", "\u001b[?2004h> "]
[2651.789711, "o", "            }\r\n\u001b[?2004l\r"]
[2651.789765, "o", "\u001b[?2004h> "]
[2651.789826, "o", "        }\r\n\u001b[?2004l\r"]
[2651.78988, "o", "\u001b[?2004h> "]
[2651.789934, "o", "    }'''\r\n\u001b[?2004l\r"]
[2651.78999, "o", "\u001b[?2004h> "]
[2651.790154, "o", "s2=pat.sub(new, s, count=1)\r\n\u001b[?2004l\r"]
[2651.790223, "o", "\u001b[?2004h> "]
[2651.790288, "o", "if s2==s:\r\n\u001b[?2004l\r"]
[2651.790343, "o", "\u001b[?2004h> "]
[2651.790692, "o", "    raise SystemExit('register promotion pattern not found')\r\n\u001b[?2004l\r"]
[2651.790746, "o", "\u001b[?2004h> "]
[2651.790876, "o", "open(p,'w').write(s2)\r\n\u001b[?2004l\r"]
[2651.79093, "o", "\u001b[?2004h> "]
[2651.790984, "o", "PY\r\n\u001b[?2004l\r"]
[2651.825624, "o", "register promotion pattern not found\r\n"]
[2651.82849, "o", "\u001b[?2004h"]
[2651.828557, "o", "root@n30009:/app# "]
