[2876.885376, "o", "    26\t\tcase \"lineage\":\r\n    27\t\t\tcmdLineage(args)\r\n    28\t\tdefault:\r\n    29\t\t\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n    30\t\t}\r\n    31\t}\r\n    32\t\r\n    33\tfunc cmdRun(args []string) {\r\n    34\t\tif len(args) < 1 {\r\n    35\t\t\tprintError(\"usage: mlpipe run <config.json> [--param key=value ...]\")\r\n    36\t\t\treturn\r\n    37\t"]
