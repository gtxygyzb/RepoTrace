[8908.586176, "o", "\tPipeline   string                     `json:\"pipeline\"`\r\n    48\t\tStatus     string                     `json:\"status\"`\r\n    49\t\tStages     map[string]*StageResult    `json:\"stages\"`\r\n    50\t\tArtifacts  map[string]*ArtifactOutput `json:\"artifacts\"`\r\n    51\t\tCacheStats *CacheStats                `json:\"cache_stats,omitempty\"`\r\n    52\t}\r\n    53\t\r\n    54\ttype CacheStats struct {\r\n    55\t\tHits   int `json:\"hits\"`\r\n    56\t\tMisses int `json:\"misses\"`\r\n    57\t}\r\n    58\t\r\n    59\ttype Executor struct {\r\n    60\t\tconfig     *Config\r\n    61\t\tglobals    map[string]interface{}\r\n    62\t\tstatus     map[string]string\r\n    63\t\tresults    map[string]*StageResult\r\n    64\t\toutputs    map[string]map[string]string\r\n"]
[8908.586313, "o", "    65\t\tvalues     map[string]map[string]*ArtifactValue\r\n    66\t\tmeta       map[string]*ArtifactMeta\r\n    67\t\tcacheKeys  map[string]string\r\n    68\t\tnoCache    bool\r\n    69\t\tcvFolds    int\r\n    70\t\tcacheStats *CacheStats\r\n    71\t}\r\n    72\t\r\n    73\tfunc NewExecutor(config *Config, overrides map[string]string) *Executor {\r\n    74\t\treturn &Executor{\r\n    75\t\t\tconfig:     config,\r\n    76\t\t\tglobals:    config.globalParams(overrides),\r\n    77\t\t\tstatus:     map[string]string{},\r\n    78\t\t\tresults:    map[string]*StageResult{},\r\n    79\t\t\toutputs:    map[string]map[string]string{},\r\n"]
[8908.586455, "o", "    80\t\t\tvalues:     map[string]map[string]*ArtifactValue{},\r\n    81\t\t\tmeta:       map[string]*ArtifactMeta{},\r\n    82\t\t\tcacheKeys:  map[string]string{},\r\n    83\t\t\tcacheStats: &CacheStats{},\r\n    84\t\t}\r\n    85\t}\r\n    86\t\r\n    87\tfunc (e *Executor) Run() (*RunOutput, error) {\r\n    88\t\tvalid, errs := e.config.Validate()\r\n    89\t\tif !valid {\r\n    90\t\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n"]
