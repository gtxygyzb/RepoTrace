[13009.833939, "o", "   463\t\r\n   464\tfunc (c *Config) validateCV() error {\r\n   465\t\tsplitNames := []string{}\r\n   466\t\tfor _, s := range c.Stages {\r\n   467\t\t"]
[13009.834062, "o", "\tif s.Type == \"split\" {\r\n   468\t\t\t\tsplitNames = append(splitNames, s.Name)\r\n   469\t\t\t}\r\n   470\t\t}\r\n"]
[13009.834143, "o", "   471\t\tif len(splitNames) != 1 {\r\n   472\t\t\treturn fmt.Errorf(\"cv mode requires exactly one split stage\")\r\n   473\t\t}\r\n   474\t\tsplitName := splitNames[0]\r\n   475\t\tpost := c.postSplitStages(splitName)\r\n   476\t\r\n   477\t\thasTrain := false\r\n   478\t\tfor name := range post {\r\n   479\t\t\tstage, _ := c.stageByName(name)\r\n   480\t\t\tif stage != nil && stage.Type == \"train\" {\r\n   481\t\t\t\thasTrain = true\r\n   482\t\t\t}\r\n   483\t\t}\r\n   484\t\thasEvaluate := false\r\n   485\t\tfor name := range post {\r\n   486\t\t\tstage, _ := c.stageByName(name)\r\n   487\t\t\tif stage == nil || stage.Type != \"evaluate\" {\r\n   488\t\t\t\tcontinue\r\n   489\t\t\t}\r\n   490\t\t\tancestors := c.ancestors(name)\r\n   491\t\t\tfor anc := range ancestors {\r\n   492\t\t\t\tif anc == name {\r\n   493\t\t\t\t\tcontinue\r\n"]
[13009.834256, "o", "   494\t\t\t\t}\r\n   495\t\t\t\tancStage, ok := c.stageByName(anc)\r\n   496\t\t\t\tif !ok || ancStage.Type != \"train\" || !post[anc] {\r\n   497\t\t\t\t\tcontinue\r\n   498\t\t\t\t}\r\n   499\t\t\t\thasEvaluate = true\r\n   500\t\t\t\tbreak\r\n   501\t\t\t}\r\n   502\t\t\tif hasEvaluate {\r\n   503\t\t\t\tbreak\r\n   504\t\t\t}\r\n   505\t\t}\r\n   506\t\r\n"]
[13009.834324, "o", "   507\t\tif !hasTrain || !hasEvaluate {\r\n   508\t\t\treturn fmt.Errorf(\"cv mode requires train and evaluate stages downstream of the split stage\")\r\n   509\t\t}\r\n   510\t\treturn nil\r\n   511\t}\r\n   512\t\r\n"]
