[12190.239242, "o", "\tfunc outputPortType(stageType, port string) string {\r\n   200\t\tswitch stageType {\r\n   201\t\tcase \"data-source\", \"transform\":\r\n   202\t\t\tif port == \"data\" {\r\n   203\t\t\t\treturn \"dataset\"\r\n   204\t\t\t}\r\n   205\t\tcase \"split\":\r\n   206\t\t\tif port == \"train\" || port == \"test\" {\r\n   207\t\t\t\treturn \"dataset\"\r\n   208\t\t\t}\r\n"]
[12190.239299, "o", "   209\t\tcase \"train\":\r\n   210\t\t\tif port == \"model\" {\r\n   211\t\t\t\treturn \"model\"\r\n   212\t\t\t}\r\n   213\t\t\tif port == \"predictions\" {\r\n   214\t\t\t\treturn \"dataset\"\r\n   215\t\t\t}\r\n   216\t\tcase \"evaluate\":\r\n"]
[12190.23936, "o", "   217\t\t\tif port == \"report\" {\r\n   218\t\t\t\treturn \"report\"\r\n   219\t\t\t}\r\n   220\t\tcase \"register\":\r\n   221\t\t\tif port == \"entry\" {\r\n   222\t\t\t\treturn \"entry\"\r\n   223\t\t\t}\r\n   224\t\tcase \"ensemble\":\r\n   225\t\t\tif port == \"predictions\" {\r\n"]
[12190.239416, "o", "   226\t\t\t\treturn \"dataset\"\r\n   227\t\t\t}\r\n   228\t\t\tif port == \"model\" {\r\n   229\t\t\t\treturn \"model\"\r\n   230\t\t\t}\r\n   231\t\t}\r\n   232\t\treturn \"unknown\"\r\n   233\t}\r\n"]
[12190.239471, "o", "   234\t\r\n   235\tfunc strPtr(s string) *string {\r\n   236\t\treturn &s\r\n   237\t}\r\n"]
