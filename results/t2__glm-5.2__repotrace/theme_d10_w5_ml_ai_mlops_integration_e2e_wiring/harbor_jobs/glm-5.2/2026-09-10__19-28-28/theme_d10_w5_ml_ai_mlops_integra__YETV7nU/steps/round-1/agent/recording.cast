[10382.654163, "o", "\r\nfunc saveRegistry(entries []*RegistryEntry) error {\r\n\tif err := os.MkdirAll(\".mlpipe\", 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdata, err := json.MarshalIndent(entries, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n"]
[10382.654298, "o", "\t}\r\n\treturn os.WriteFile(registryPath(), data, 0644)\r\n}\r\n\r\nfunc listRegistry(name, stage, tag string) ([]*RegistryEntry, error) {\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tfiltered := []*RegistryEntry{}\r\n\tfor _, e := range entries {\r\n\t\tif name != \"\" && e.Name != name {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif stage != \"\" && e.Stage != stage {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif tag != \"\" {\r\n\t\t\tfound := false\r\n"]
[10382.654444, "o", "\t\t\tfor _, t := range e.Tags {\r\n\t\t\t\tif t == tag {\r\n\t\t\t\t\tfound = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !found {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t}\r\n\t\tfiltered = append(filtered, e)\r\n\t}\r\n\tsort.Slice(filtered, func(i, j int) bool {\r\n\t\tif filtered[i].Name != filtered[j].Name {\r\n\t\t\treturn filtered[i].Name < filtered[j].Name\r\n\t\t}\r\n\t\treturn filtered[i].Version > filtered[j].Version\r\n\t})\r\n\treturn filtered, nil\r\n"]
[10382.654513, "o", "}\r\n\r\nfunc registryInfo(name string, version int) (*RegistryEntry, error) {\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tfor _, e := range entries {\r\n\t\tif e.Name == name && e.Version == version {\r\n\t\t\treturn e, nil\r\n\t\t}\r\n"]
[10382.654582, "o", "\t}\r\n\treturn nil, fmt.Errorf(\"model not found: %s:%d\", name, version)\r\n}\r\n\r\nfunc promoteModel(name string, version int, targetStage string) (*RegistryEntry, string, string, error) {\r\n\tvalid := map[string]bool{\"staging\": true, \"production\": true, \"archived\": true}\r\n\tif !valid[targetStage] {\r\n\t\treturn nil, \"\", \"\", fmt.Errorf(\"invalid promotion: invalid target stage %q\", targetStage)\r\n\t}\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n"]
[10382.654645, "o", "\t\treturn nil, \"\", \"\", err\r\n\t}\r\n\tvar entry *RegistryEntry\r\n\tfor _, e := range entries {\r\n\t\tif e.Name == name && e.Version == version {\r\n\t\t\tentry = e\r\n\t\t\tbreak\r\n\t\t}\r\n"]
[10382.654706, "o", "\t}\r\n\tif entry == nil {\r\n\t\treturn nil, \"\", \"\", fmt.Errorf(\"model not found: %s:%d\", name, version)\r\n\t}\r\n\r\n\tprevStage := entry.Stage\r\n\tif !validPromotionTransition(prevStage, targetStage) {\r\n\t\treturn nil, \"\", \"\", fmt.Errorf(\"invalid promotion: cannot promote from %s to %s\", prevStage, targetStage)\r\n\t}\r\n\r\n\tif targetStage == \"production\" {\r\n"]
[10382.654766, "o", "\t\tif entry.PromotionRules != nil {\r\n\t\t\tif rules, ok := entry.PromotionRules[targetStage].(map[string]interface{}); ok {\r\n\t\t\t\tfor metricName, thresholdVal := range rules {\r\n\t\t\t\t\tmetricValue, ok := entry.Metrics[metricName]\r\n\t\t\t\t\tif !ok {\r\n\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n\t\t\t\t\tmv, ok := toFloat64(metricValue)\r\n"]
[10382.654834, "o", "\t\t\t\t\tif !ok {\r\n\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n\t\t\t\t\ttv, ok := toFloat64(thresholdVal)\r\n\t\t\t\t\tif !ok {\r\n"]
[10382.654905, "o", "\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif mv < tv {\r\n\t\t\t\t\t\treturn nil, prevStage, targetStage, fmt.Errorf(\"metric %s (%v) below threshold (%v)\", metricName, mv, tv)\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor _, e := range entries {\r\n\t\t\tif e.Name == name && e.Stage == \"production\" && e.Version != version {\r\n"]
[10382.654964, "o", "\t\t\t\te.Stage = \"archived\"\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tentry.Stage = targetStage\r\n\tif err := saveRegistry(entries); err != nil {\r\n\t\treturn nil, \"\", \"\", err\r\n\t}\r\n\treturn entry, prevStage, targetStage, nil\r\n}\r\n"]
[10382.655027, "o", "\r\nfunc validPromotionTransition(from, to string) bool {\r\n\tif from == \"staging\" && to == \"production\" {\r\n\t\treturn true\r\n\t}\r\n\tif from == \"production\" && to == \"archived\" {\r\n\t\treturn true\r\n\t}\r\n\treturn false\r\n}\r\n"]
