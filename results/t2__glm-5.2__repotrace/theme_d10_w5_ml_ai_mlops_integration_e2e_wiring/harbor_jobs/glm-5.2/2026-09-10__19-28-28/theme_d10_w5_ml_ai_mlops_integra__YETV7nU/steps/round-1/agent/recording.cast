[6673.009811, "o", "    75\t\t\tconfig:     config,\r\n    76\t\t\tglobals:    config.globalParams(overrides),\r\n    77\t\t\tstatus:     map[string]string{},\r\n    78\t\t\tresults:    map[string]*StageResult{},\r\n    79\t\t\toutputs:    map[string]map[string]string{},\r\n    80\t\t\tvalues:     map[string]map[string]*ArtifactValue{},\r\n    81\t\t\tmeta:       map[string]*ArtifactMeta{},\r\n    82\t\t\tcacheKeys:  map[string]string{},\r\n    83\t\t\tcacheStats: &CacheStats{},\r\n    84\t\t}\r\n    85\t"]
[6673.009873, "o", "}\r\n    86\t\r\n    87\tfunc (e *Executor) Run() (*RunOutput, error) {\r\n    88\t\tvalid, errs := e.config.Validate()\r\n    89\t\tif !valid {\r\n    90\t\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n    91\t\t}\r\n    92\t\torder, err := e.config.topologicalOrder()\r\n    93\t\tif err != nil {\r\n"]
[6673.009935, "o", "    94\t\t\treturn nil, err\r\n    95\t\t}\r\n    96\t\r\n    97\t\trunArtifacts := map[string]*ArtifactOutput{}\r\n    98\t\r\n    99\t\tfor _, name := range order {\r\n   100\t\t\tstage, _ := e.config.stageByName(name)\r\n   101\t\t\te.outputs[name] = map[string]string{}\r\n   102\t\t\te.values[name] = map[string]*ArtifactValue{}\r\n   103\t\t\te.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n"]
[6673.009998, "o", "   104\t\r\n   105\t\t\tskip := false\r\n   106\t\t\tfor _, dep := range stage.DependsOn {\r\n   107\t\t\t\tif e.status[dep] != \"success\" {\r\n   108\t\t\t\t\tskip = true\r\n   109\t\t\t\t\tbreak\r\n   110\t\t\t\t}\r\n   111\t\t\t}\r\n   112\t\t\tif skip {\r\n"]
[6673.010054, "o", "   113\t\t\t\te.status[name] = \"skipped\"\r\n   114\t\t\t\te.results[name].Status = \"skipped\"\r\n   115\t\t\t\tcontinue\r\n   116\t\t\t}\r\n   117\t\r\n   118\t\t\tinputValues, inputIDs, err := e.resolveInputs(stage)\r\n   119\t\t\tif err != nil {\r\n"]
[6673.010111, "o", "   120\t\t\t\te.status[name] = \"failed\"\r\n   121\t\t\t\te.results[name].Status = \"failed\"\r\n   122\t\t\t\te.results[name].Error = err.Error()\r\n   123\t\t\t\tcontinue\r\n   124\t\t\t}\r\n   125\t\r\n   126\t\t\tparams := e.config.stageParams(name, e.globals)\r\n"]
[6673.010169, "o", "   127\t\t\tinputKeys := e.inputCacheKeys(stage)\r\n   128\t\t\tcacheKey, keyErr := computeCacheKey(stage, params, inputKeys, -1)\r\n   129\t\t\tif keyErr != nil {\r\n   130\t\t\t\te.status[name] = \"failed\"\r\n   131\t\t\t\te.results[name].Status = \"failed\"\r\n   132\t\t\t\te.results[name].Error = keyErr.Error()\r\n   133\t\t\t\tcontinue\r\n   134\t\t\t}\r\n   135\t\t\te.cacheKeys[name] = cacheKey"]
[6673.010258, "o", "\r\n   136\t\r\n   137\t\t\tvar out map[string]*ArtifactValue\r\n   138\t\t\tstart := time.Now()\r\n   139\t\t\tif !e.noCache && cacheEntryExists(cacheKey) {\r\n   140\t\t\t\tloaded, err := loadCacheEntry(cacheKey)\r\n   141\t\t\t\tduration := time.Since(start).Milliseconds()\r\n   142\t\t\t\te.results[name].DurationMs = duration\r\n   143\t\t\t\tif err == nil {\r\n   144\t\t\t\t\t"]
[6673.010318, "o", "out = loaded\r\n   145\t\t\t\t\te.results[name].CacheHit = true\r\n   146\t\t\t\t\te.cacheStats.Hits++\r\n   147\t\t\t\t} else {\r\n   148\t\t\t\t\tif !e.noCache {\r\n   149\t\t\t\t\t\te.cacheStats.Misses++\r\n   150\t\t\t\t\t}\r\n   151\t\t\t\t\tout, err = executeStage(stage, params, inputValues)\r\n"]
[6673.010375, "o", "   152\t\t\t\t\tduration = time.Since(start).Milliseconds()\r\n   153\t\t\t\t\te.results[name].DurationMs = duration\r\n   154\t\t\t\t\tif err != nil {\r\n   155\t\t\t\t\t\te.status[name] = \"failed\"\r\n   156\t\t\t\t\t\te.results[name].Status = \"failed\"\r\n   157\t\t\t\t\t\te.results[name].Error = err.Error()\r\n"]
[6673.010435, "o", "   158\t\t\t\t\t\tcontinue\r\n   159\t\t\t\t\t}\r\n   160\t\t\t\t}\r\n   161\t\t\t} else {\r\n   162\t\t\t\tvar err error\r\n   163\t\t\t\tout, err = executeStage(stage, params, inputValues)\r\n   164\t\t\t\tduration := time.Since(start).Milliseconds()\r\n   165\t\t\t\te.results[name].DurationMs = duration\r\n   166\t\t\t\tif err != nil {\r\n"]
[6673.010493, "o", "   167\t\t\t\t\te.status[name] = \"failed\"\r\n   168\t\t\t\t\te.results[name].Status = \"failed\"\r\n   169\t\t\t\t\te.results[name].Error = err.Error()\r\n   170\t\t\t\t\tcontinue\r\n   171\t\t\t\t}\r\n   172\t\t\t\tif !e.noCache {\r\n   173\t\t\t\t\t_ = saveCacheEntry(cacheKey, name, stage.Type, out)\r\n   174\t\t\t\t}\r\n   175\t"]
[6673.010549, "o", "\t\t\tif !e.noCache {\r\n   176\t\t\t\t\te.cacheStats.Misses++\r\n   177\t\t\t\t}\r\n   178\t\t\t}\r\n   179\t\r\n   180\t\t\te.status[name] = \"success\"\r\n   181\t\t\te.results[name].Status = \"success\"\r\n   182\t\t\tts := time.Now().UnixNano()\r\n   183\t"]
[6673.010607, "o", "\r\n   184\t\t\tfor port, val := range out {\r\n   185\t\t\t\tid := artifactID(e.config.Pipeline.Name, name, port, ts)\r\n   186\t\t\t\te.values[name][port] = val\r\n   187\t\t\t\te.outputs[name][port] = id\r\n   188\t\t\t\ttyp := val.Type()\r\n   189\t\t\t\tsummary := val.Summary()\r\n"]
[6673.010663, "o", "   190\t\t\t\tmeta := &ArtifactMeta{\r\n   191\t\t\t\t\tID:        id,\r\n   192\t\t\t\t\tStage:     name,\r\n   193\t\t\t\t\tPort:      port,\r\n   194\t\t\t\t\tType:      typ,\r\n   195\t\t\t\t\tSummary:   summary,\r\n   196\t\t\t\t\tInputs:    inputIDs,\r\n   197\t\t\t\t\tOutputs:   []string{},\r\n   198\t\t\t\t\tTimestamp: ts,\r\n   199\t\t\t\t}\r\n"]
[6673.010726, "o", "   200\t\t\t\te.meta[id] = meta\r\n   201\t\t\t\tfor _, inID := range inputIDs {\r\n   202\t\t\t\t\tif parent, ok := e.meta[inID]; ok {\r\n   203\t\t\t\t\t\tparent.Outputs = appendUnique(parent.Outputs, id)\r\n   204\t\t\t\t\t}\r\n   205\t\t\t\t}\r\n   206\t\t\t\trunArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n   207\t\t\t}\r\n   208\t\t}\r\n   209"]
[6673.010783, "o", "\t\r\n   210\t\tstatus := \"success\"\r\n   211\t\tfor _, s := range e.results {\r\n   212\t\t\tif s.Status != \"success\" {\r\n   213\t\t\t\tstatus = \"failed\"\r\n   214\t\t\t\tbreak\r\n   215\t\t\t}\r\n   216\t\t}\r\n"]
