[6662.119119, "o", "   237\t\te2, err := registryInfo(name, v2)\r\n   238\t\tif err != nil {\r\n   239\t\t\treturn nil, err\r\n   240\t\t}\r\n   241\t\r\n   242\t\tmetricsDiff := map[string]interface{}{}\r\n   243\t\tmetricNames := map[string]bool{}\r\n   244\t\tfor k := range e1.Metrics {\r\n"]
[6662.119178, "o", "   245\t\t\tmetricNames[k] = true\r\n   246\t\t}\r\n   247\t\tfor k := range e2.Metrics {\r\n   248\t\t\tmetricNames[k] = true\r\n   249\t\t}\r\n   250\t\tfor k := range metricNames {\r\n   251\t\t\tmv1, ok1 := toFloat64(e1.Metrics[k])\r\n   252\t\t\tmv2, ok2 := toFloat64(e2.Metrics[k])\r\n   253\t\t\tif !ok1 || !ok2 {"]
[6662.119265, "o", "\r\n   254\t\t\t\tmetricsDiff[k] = map[string]interface{}{\"v1\": e1.Metrics[k], \"v2\": e2.Metrics[k], \"delta\": nil, \"pct_change\": nil}\r\n   255\t\t\t\tcontinue\r\n   256\t\t\t}\r\n   257\t\t\tdelta := mv2 - mv1\r\n   258\t\t\tvar pct interface{}\r\n   259\t\t\tif mv1 == 0 {\r\n   260\t\t\t\tpct = nil\r\n   261\t\t\t} else {\r\n   262\t\t\t\tpct = delta / math.Abs(mv1) * 100\r\n"]
