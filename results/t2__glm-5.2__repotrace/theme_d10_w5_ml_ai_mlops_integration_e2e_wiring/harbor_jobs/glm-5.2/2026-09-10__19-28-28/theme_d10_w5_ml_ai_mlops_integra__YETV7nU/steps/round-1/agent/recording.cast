[2877.159975, "o", "\tfunc executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n   205\t\tswitch stage.Type {\r\n   206\t\tcase \"data-source\":\r\n   207\t\t\treturn executeDataSource(stage, params, inputs)\r\n   208\t\tcase \"transform\":\r\n   209\t\t\treturn executeTransform(stage, params, inputs)\r\n   210\t\tcase \"split\":\r\n   211\t\t\treturn executeSplit(stage, params, inputs)\r\n   212\t\tcase \"train\":\r\n   213\t"]
