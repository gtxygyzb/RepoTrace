[1967.456295, "i", "grep -n 'func trainDecisionTree\\|func trainDecisionTreeFeatures\\|sort.Ints(selected\\|trainDecisionTreeFeatures(bootX' train.go; sed -n '135,160p' config.go; sed -n '115,130p' main.go\n"]
[1967.457463, "o", "grep -n 'func trainDecisionTree\\|func trainDecisionTreeFeatures\\|sort.Ints(selected\\|trainDecisionTreeFeatures(bootX' train.go; sed -n '135,160p' config.go; sed -n '115,130p' main.go\r\n\u001b[?2004l\r"]
[1967.461183, "o", "\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc trainDecisionTree\u001b[m\u001b[K(X [][]float64, y []float64, features []string, classification bool, depth, maxDepth, minSplit int) *TreeNode {\r\n"]
[1967.461287, "o", "\u001b[32m\u001b[K300\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc trainDecisionTreeFeatures\u001b[m\u001b[K(X [][]float64, y []float64, features []string, featureIdx []int, classification bool, depth, maxDepth, minSplit int) *TreeNode {\r\n"]
[1967.46149, "o", "\u001b[32m\u001b[K441\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Ksort.Ints(selected\u001b[m\u001b[K[:mf])\r\n"]
[1967.461645, "o", "\u001b[32m\u001b[K447\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\ttree := \u001b[01;31m\u001b[KtrainDecisionTreeFeatures(bootX\u001b[m\u001b[K, bootY, subFeatures, selected, classification, 0, maxDepth, 2)\r\n"]
[1967.464847, "o", "func (c *Config) Validate() (bool, []string) {\r\n\terrors := []string{}\r\n\tnames := map[string]bool{}\r\n\tfor i, s := range c.Stages {\r\n\t\tif s.Name == \"\" {\r\n"]
[1967.46491, "o", "\t\t\terrors = append(errors, fmt.Sprintf(\"stage at index %d has empty name\", i))\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif names[s.Name] {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"duplicate stage name: %s\", s.Name))\r\n\t\t}\r\n\t\tnames[s.Name] = true\r\n\t}\r\n\tfor _, s := range c.Stages {\r\n"]
[1967.464986, "o", "\t\tif !validStageType(s.Type) {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q has unknown type %q\", s.Name, s.Type))\r\n\t\t}\r\n\t\tfor _, dep := range s.DependsOn {\r\n\t\t\tif !names[dep] {\r\n"]
[1967.465047, "o", "\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q references unknown dependency %q\", s.Name, dep))\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor local, ref := range s.Inputs {\r\n\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n\t\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %q\", s.Name, local, ref))\r\n"]
[1967.468083, "o", "\t\t}\r\n\t}\r\n\tentries, err := listRegistry(name, stage, tag)\r\n\tif err != nil {\r\n"]
[1967.468145, "o", "\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tout := make([]map[string]interface{}, len(entries))\r\n\tfor i, e := range entries {\r\n\t\tout[i] = map[string]interface{}{\r\n\t\t\t\"name\":          e.Name,\r\n\t\t\t\"version\":       e.Version,\r\n\t\t\t\"stage\":         e.Stage,\r\n\t\t\t\"tags\":          e.Tags,\r\n\t"]
[1967.468206, "o", "\t\t\"metrics\":       e.Metrics,\r\n\t\t\t\"registered_at\": e.RegisteredAt,\r\n"]
[1967.468701, "o", "\u001b[?2004h"]
[1967.468761, "o", "root@n30009:/app# "]
