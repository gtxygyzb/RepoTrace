[11263.352365, "o", "\u001b[?2004h> "]
[11263.352638, "o", "    data, err := json.MarshalIndent(record, \"\", \"  \")\r\n\u001b[?2004l\r"]
[11263.352694, "o", "\u001b[?2004h> "]
[11263.352782, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[11263.35284, "o", "\u001b[?2004h> "]
[11263.352932, "o", "        return err\r\n\u001b[?2004l\r"]
[11263.352988, "o", "\u001b[?2004h> "]
[11263.353043, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
