[10651.923156, "o", "\u001b[?2004l\r"]
[10654.142441, "o", "# mlpipe\r\n./main.go:259:37: assignment mismatch: 5 variables but promoteModel returns 4 values\r\n./main.go:259:73: too many arguments in call to promoteModel\r\n\thave (string, int, string, bool)\r\n\twant (string, int, string)\r\n"]
[10654.148453, "o", "\u001b[?2004h"]
