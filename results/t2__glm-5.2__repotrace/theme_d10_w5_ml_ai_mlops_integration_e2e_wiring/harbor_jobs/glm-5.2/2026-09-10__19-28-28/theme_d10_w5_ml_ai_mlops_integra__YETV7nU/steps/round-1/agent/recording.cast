[1943.2051, "o", "\u001b[?2004h> "]
[1943.20568, "o", "new2='''// feature subset: selected original feature indices, kept sorted for consistent prediction\r\n\u001b[?2004l\r"]
[1943.205739, "o", "\u001b[?2004h> "]
[1943.205919, "o", "        selected := rng.Perm(m)\r\n\u001b[?2004l\r"]
[1943.20596, "o", "\u001b[?2004h> "]
[1943.206162, "o", "        sort.Ints(selected[:mf])\r\n\u001b[?2004l\r"]
[1943.206214, "o", "\u001b[?2004h> "]
[1943.206413, "o", "        selected = selected[:mf]\r\n\u001b[?2004l\r"]
[1943.206445, "o", "\u001b[?2004h> "]
[1943.206656, "o", "        subFeatures := []string{}\r\n\u001b[?2004l\r"]
[1943.206696, "o", "\u001b[?2004h> "]
[1943.206926, "o", "        for _, s := range selected {\r\n\u001b[?2004l\r"]
[1943.206976, "o", "\u001b[?2004h> "]
[1943.207323, "o", "            subFeatures = append(subFeatures, features[s])\r\n\u001b[?2004l\r"]
[1943.207381, "o", "\u001b[?2004h"]
[1943.207436, "o", "> "]
[1943.20747, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1943.208102, "o", "        tree := trainDecisionTreeFeatures(bootX, bootY, subFeatures, selected, classification, 0, maxDepth, 2)\r\n\u001b[?2004l\r"]
[1943.208154, "o", "\u001b[?2004h> "]
[1943.208399, "o", "        forest = append(forest, tree)'''\r\n\u001b[?2004l\r"]
[1943.208454, "o", "\u001b[?2004h> "]
[1943.208637, "o", "s3=pat2.sub(new2, s2, count=1)\r\n\u001b[?2004l\r"]
[1943.208686, "o", "\u001b[?2004h> "]
[1943.208757, "o", "if s3==s2:\r\n\u001b[?2004l\r"]
[1943.208816, "o", "\u001b[?2004h"]
[1943.208847, "o", "> "]
[1943.209103, "o", "    raise SystemExit('random forest patch failed')\r\n\u001b[?2004l\r"]
