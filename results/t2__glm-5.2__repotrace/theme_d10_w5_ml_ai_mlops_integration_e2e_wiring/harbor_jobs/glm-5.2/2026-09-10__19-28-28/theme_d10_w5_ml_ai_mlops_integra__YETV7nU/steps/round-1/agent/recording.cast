[775.90305, "o", "            res := substituteValue(s.Params, globals)\r\n\u001b[?2004l\r"]
[775.903107, "o", "\u001b[?2004h> "]
[775.903359, "o", "            if m, ok := res.(map[string]interface{}); ok {\r\n\u001b[?2004l\r"]
[775.903417, "o", "\u001b[?2004h> "]
[775.903503, "o", "                return m\r\n\u001b[?2004l\ra\u001b[?2004h"]
[775.90356, "o", "> "]
[775.903615, "o", "            }\r\n\u001b[?2004l\re\u001b[?2004h> "]
[775.903814, "o", "            return map[string]interface{}{}\r\n\u001b[?2004l\r"]
[775.903869, "o", "\u001b[?2004h> "]
[775.903925, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.903979, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.904185, "o", "    return map[string]interface{}{}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[775.904254, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[775.904312, "o", "> "]
[775.904551, "o", "func (c *Config) stageByName(name string) (*StageConfig, bool) {\r\n\u001b[?2004l\r"]
[775.904607, "o", "\u001b[?2004h> "]
[775.904728, "o", "    for i := range c.Stages {\r\n\u001b[?2004l\r"]
[775.904782, "o", "\u001b[?2004h> "]
[775.904916, "o", "        if c.Stages[i].Name == name {\r\n\u001b[?2004l\r"]
[775.904971, "o", "\u001b[?2004h> "]
[775.905125, "o", "            return &c.Stages[i], true\r\n\u001b[?2004l\r"]
[775.90518, "o", "\u001b[?2004h> "]
[775.905254, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }"]
[775.905309, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.905401, "o", "    return nil, false\r\n\u001b[?2004l\r"]
[775.905456, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.905511, "o", "> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[775.905709, "o", "func validOutputPorts(t string) []string {\r\n\u001b[?2004l\r"]
[775.905763, "o", "\u001b[?2004h> "]
[775.905821, "o", "    switch t {\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.905875, "o", "> "]
[775.905953, "o", "    case \"data-source\":\r\n\u001b[?2004l\r"]
[775.906007, "o", "\u001b[?2004h> "]
[775.906124, "o", "        return []string{\"data\"}\r\n\u001b[?2004l\r \u001b[?2004h"]
[775.906179, "o", "> "]
[775.906254, "o", "    case \"transform\":\r\n\u001b[?2004l\r"]
[775.90631, "o", "\u001b[?2004h> "]
[775.906425, "o", "        return []string{\"data\"}\r\n\u001b[?2004l\r"]
[775.906479, "o", "\u001b[?2004h> "]
[775.90654, "o", "    case \"split\":\r\n\u001b[?2004l\r"]
[775.906595, "o", "\u001b[?2004h> "]
[775.906755, "o", "        return []string{\"train\", \"test\"}\r\n\u001b[?2004l\r"]
[775.90681, "o", "\u001b[?2004h> "]
[775.906878, "o", "    case \"train\":\r\n\u001b[?2004l\r "]
[775.906935, "o", "\u001b[?2004h> "]
[775.907121, "o", "        return []string{\"model\", \"predictions\"}\r\n\u001b[?2004l\r"]
[775.907175, "o", "\u001b[?2004h> "]
[775.907249, "o", "    case \"evaluate\":\r\n\u001b[?2004l\r"]
[775.907304, "o", "\u001b[?2004h> "]
[775.907433, "o", "        return []string{\"report\"}\r\n\u001b[?2004l\r"]
[775.907488, "o", "\u001b[?2004h> "]
[775.907554, "o", "    case \"register\":\r\n\u001b[?2004l\r"]
[775.907609, "o", "\u001b[?2004h> "]
[775.907731, "o", "        return []string{\"entry\"}\r\n\u001b[?2004l\r"]
[775.907785, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[775.907841, "o", "\u001b[?2004h> "]
[775.907902, "o", "    return nil\r\n\u001b[?2004l\r"]
[775.907957, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.908016, "o", "> \r\n\u001b[?2004l\r(\u001b[?2004h> "]
[775.908172, "o", "func validStageType(t string) bool {\r\n\u001b[?2004l\r"]
[775.908235, "o", "\u001b[?2004h> "]
[775.908295, "o", "    switch t {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.908648, "o", "    case \"data-source\", \"transform\", \"split\", \"train\", \"evaluate\", \"register\":\r\n\u001b[?2004l\r"]
[775.908703, "o", "\u001b[?2004h> "]
[775.908776, "o", "        return true\r\n\u001b[?2004l\r"]
[775.908834, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\re"]
[775.908892, "o", "\u001b[?2004h> "]
[775.908957, "o", "    return false\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.909012, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r "]
[775.909078, "o", "\u001b[?2004h> "]
[775.909259, "o", "func (c *Config) Validate() (bool, []string) {\r\n\u001b[?2004l\r"]
[775.909323, "o", "\u001b[?2004h> "]
[775.909408, "o", "    errors := []string{}\r\n\u001b[?2004l\r"]
[775.909463, "o", "\u001b[?2004h> "]
[775.90957, "o", "    names := map[string]bool{}\r\n\u001b[?2004l\r"]
[775.909624, "o", "\u001b[?2004h> "]
[775.90975, "o", "    for i, s := range c.Stages {\r\n\u001b[?2004l\r"]
[775.909805, "o", "\u001b[?2004h> "]
[775.909909, "o", "        if s.Name == \"\" {\r\n\u001b[?2004l\r"]
[775.909963, "o", "\u001b[?2004h> "]
[775.910324, "o", "            errors = append(errors, fmt.Sprintf(\"stage at index %d has empty name\", i))\r\n\u001b[?2004l\r"]
[775.910384, "o", "\u001b[?2004h> "]
[775.910446, "o", "            continue\r\n\u001b[?2004l\r"]
[775.910504, "o", "\u001b[?2004h> "]
[775.910558, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.910689, "o", "        if names[s.Name] {\r\n\u001b[?2004l\r"]
[775.910742, "o", "\u001b[?2004h> "]
[775.91108, "o", "            errors = append(errors, fmt.Sprintf(\"duplicate stage name: %s\", s.Name))\r\n\u001b[?2004l\r"]
[775.911135, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[775.911189, "o", "\u001b[?2004h> "]
[775.911299, "o", "        names[s.Name] = true\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.911353, "o", "> "]
[775.911469, "o", "        if !validStageType(s.Type) {\r\n\u001b[?2004l\r"]
[775.911523, "o", "\u001b[?2004h> "]
[775.911876, "o", "            errors = append(errors, fmt.Sprintf(\"stage %q has unknown type %q\", s.Name, s.Type))\r\n\u001b[?2004l\r"]
[775.911935, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[775.911994, "o", "\u001b[?2004h> "]
[775.912145, "o", "        for _, dep := range s.DependsOn {\r\n\u001b[?2004l\r"]
[775.912199, "o", "\u001b[?2004h> "]
[775.912286, "o", "            if !names[dep] {\r\n\u001b[?2004l\r"]
[775.91234, "o", "\u001b[?2004h> "]
[775.912733, "o", "                errors = append(errors, fmt.Sprintf(\"stage %q references unknown dependency %q\", s.Name, dep))\r\n\u001b[?2004l\r"]
[775.912788, "o", "\u001b[?2004h> "]
[775.912842, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.912907, "o", "        }\r\n\u001b[?2004l\r"]
[775.912961, "o", "\u001b[?2004h> "]
[775.913083, "o", "        for local, ref := range s.Inputs {\r\n\u001b[?2004l\r"]
[775.913137, "o", "\u001b[?2004h> "]
[775.913306, "o", "            parts := strings.SplitN(ref, \".\", 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.913361, "o", "> "]
[775.913594, "o", "            if len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.913649, "o", "> "]
[775.914072, "o", "                errors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %q\", s.Name, local, ref))\r\n\u001b[?2004l\r"]
[775.914128, "o", "\u001b[?2004h> "]
[775.914207, "o", "                continue\r\n\u001b[?2004l\r"]
[775.91427, "o", "\u001b[?2004h> "]
[775.914335, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.914537, "o", "            refStage, ok := c.stageByName(parts[0])\r\n\u001b[?2004l\r"]
[775.914594, "o", "\u001b[?2004h> "]
[775.914647, "o", "            if !ok {\r\n\u001b[?2004l\r"]
[775.914704, "o", "\u001b[?2004h> "]
[775.91513, "o", "                errors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown stage %q\", s.Name, local, parts[0]))\r\n\u001b[?2004l\r"]
[775.915185, "o", "\u001b[?2004h> "]
[775.915256, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.915312, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.915366, "o", "> "]
[775.915485, "o", "            ports := validOutputPorts(refStage.Type)\r\n\u001b[?2004l\r"]
[775.915539, "o", "\u001b[?2004h> "]
[775.915593, "o", "            valid := false\r\n\u001b[?2004l\r"]
[775.915648, "o", "\u001b[?2004h> "]
[775.915734, "o", "            for _, p := range ports {\r\n\u001b[?2004l\r"]
[775.915789, "o", "\u001b[?2004h> "]
[775.91586, "o", "                if p == parts[1] {\r\n\u001b[?2004l\r"]
[775.915914, "o", "\u001b[?2004h> "]
[775.915982, "o", "                    valid = true\r\n\u001b[?2004l\r"]
[775.916037, "o", "\u001b[?2004h> "]
[775.9161, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.916172, "o", "                }\r\n\u001b[?2004l\r"]
[775.916232, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[775.916287, "o", "\u001b[?2004h> "]
[775.916345, "o", "            if !valid {\r\n\u001b[?2004l\r"]
[775.916399, "o", "\u001b[?2004h> "]
[775.916802, "o", "                errors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown output port %q on stage %q\", s.Name, local, parts[1], parts[0]))\r\n\u001b[?2004l\r"]
[775.916863, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[775.916918, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[775.916977, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[775.917031, "o", "\u001b[?2004h> "]
[775.917147, "o", "    if cycle, stages := c.detectCycle(); cycle {\r\n\u001b[?2004l\r"]
[775.917202, "o", "\u001b[?2004h> "]
[775.917497, "o", "        errors = append(errors, fmt.Sprintf(\"cycle detected involving stages: %s\", strings.Join(stages, \", \")))\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.917553, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.917672, "o", "    return len(errors) == 0, errors\r\n\u001b[?2004l\r"]
[775.917727, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[775.917782, "o", "\u001b[?2004h> "]
[775.917915, "o", "func (c *Config) detectCycle() ([]string, bool) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.91797, "o", "> "]
[775.918038, "o", "    adj := map[string][]string{}\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.918092, "o", "> "]
[775.918158, "o", "    for _, s := range c.Stages {\r\n\u001b[?2004l\r"]
[775.918213, "o", "\u001b[?2004h> "]
[775.918357, "o", "        adj[s.Name] = append(adj[s.Name], s.DependsOn...)\r\n\u001b[?2004l\r"]
[775.918413, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.918468, "o", "> "]
[775.918525, "o", "    color := map[string]int{}\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.91858, "o", "> "]
[775.918634, "o", "    var stack []string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.91871, "o", "    var cycle []string\r\n\u001b[?2004l\r"]
[775.918766, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.918871, "o", "    var dfs func(node string) bool\r\n\u001b[?2004l\r"]
[775.918926, "o", "\u001b[?2004h> "]
[775.918998, "o", "    dfs = func(node string) bool {\r\n\u001b[?2004l\r"]
[775.919053, "o", "\u001b[?2004h> "]
[775.919113, "o", "        if color[node] == 1 {\r\n\u001b[?2004l\r"]
[775.919168, "o", "\u001b[?2004h> "]
[775.919231, "o", "            idx := -1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.919347, "o", "            for i, n := range stack {\r\n\u001b[?2004l\r"]
[775.919402, "o", "\u001b[?2004h> "]
[775.919463, "o", "                if n == node {\r\n\u001b[?2004l\r"]
[775.919517, "o", "\u001b[?2004h> "]
[775.919572, "o", "                    idx = i\r\n\u001b[?2004l\r"]
[775.919626, "o", "\u001b[?2004h> "]
[775.919691, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.919758, "o", "                }\r\n\u001b[?2004l\r"]
[775.919813, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[775.919867, "o", "\u001b[?2004h> "]
[775.919931, "o", "            if idx >= 0 {\r\n\u001b[?2004l\r"]
[775.919985, "o", "\u001b[?2004h> "]
[775.920125, "o", "                cycle = append([]string{}, stack[idx:]...)\r\n\u001b[?2004l\r"]
[775.920178, "o", "\u001b[?2004h> "]
[775.920282, "o", "                cycle = append(cycle, node)\r\n\u001b[?2004l\r"]
[775.920336, "o", "\u001b[?2004h> "]
[775.92051, "o", "                if len(cycle) > 1 && cycle[0] == cycle[len(cycle)-1] {\r\n\u001b[?2004l\r"]
[775.920564, "o", "\u001b[?2004h> "]
[775.920679, "o", "                    cycle = cycle[:len(cycle)-1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[775.920733, "o", "> "]
[775.920786, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.920848, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.920925, "o", "            return true\r\n\u001b[?2004l\r"]
[775.92098, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[775.921034, "o", "\u001b[?2004h> "]
[775.921099, "o", "        if color[node] == 2 {\r\n\u001b[?2004l\r"]
[775.921154, "o", "\u001b[?2004h> "]
[775.921225, "o", "            return false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.92128, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.921361, "o", "        color[node] = 1\r\n\u001b[?2004l\r"]
[775.921415, "o", "\u001b[?2004h> "]
[775.921491, "o", "        stack = append(stack, node)\r\n\u001b[?2004l\r"]
[775.921545, "o", "\u001b[?2004h> "]
[775.921611, "o", "        for _, dep := range adj[node] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.921709, "o", "            if _, ok := adj[dep]; ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.921792, "o", "                if dfs(dep) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.921875, "o", "                    return true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.921933, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.921997, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.922051, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.922118, "o", "        stack = stack[:len(stack)-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.922187, "o", "        color[node] = 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.922253, "o", "        return false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.922307, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[775.922361, "o", "\u001b[?2004h> "]
[775.922415, "o", "    for _, s := range c.Stages {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.922482, "o", "        if color[s.Name] == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.922561, "o", "            if dfs(s.Name) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.922649, "o", "                return cycle, true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.922713, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.922767, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[775.922822, "o", "\u001b[?2004h>     return nil, false\r\n\u001b[?2004l\r"]
[775.922875, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[775.922934, "o", "\u001b[?2004h> "]
[775.923049, "o", "func getString(params map[string]interface{}, key string) (string, bool) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.923121, "o", "    v, ok := params[key]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.923177, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.923247, "o", "        return \"\", false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.923302, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.923375, "o", "    return fmt.Sprintf(\"%v\", v), true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.923429, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.923599, "o", "func getStringSlice(params map[string]interface{}, key string) ([]string, bool) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[775.92367, "o", "    v, ok := params[key]\r\n\u001b[?2004l\r\u001b[?2004h> "]
