[10945.309545, "o", "\t\t\t}\r\n   297\t\t}\r\n   298\t\tfor k, v := range keys {\r\n   299\t\t\tkeys[k] = strings.TrimRight(v, \"\\n\")\r\n   300\t\t}\r\n   301\t\treturn keys\r\n   302\t}\r\n   303\t\r\n   304\tfunc (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {\r\n   305\t\tinputs := map[string]*ArtifactValue{}\r\n   306\t\tids := []string{}\r\n   307\t\tfor local, ref := range stage.Inputs {\r\n   308\t\t\trefs, ok := inputRefs(ref)\r\n   309\t\t\tif !ok {\r\n   310\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q has invalid reference %v\", stage.Name, local, ref)\r\n   311\t\t\t}\r\n   312\t\t\tvar firstVal *ArtifactValue\r\n   313\t\t\tfor _, r := range refs {\r\n   314\t\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n   315\t\t\t\tif len(parts) != 2 {\r\n"]
