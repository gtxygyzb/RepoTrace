[1890.857321, "o", "\t\tmean += v\r\n\t}\r\n\tmean /= float64(len(y))\r\n\r\n\tif depth >= maxDepth || len(y) < minSplit || len(features) == 0 {\r\n\t\tnode.IsLeaf = true\r\n"]
[1890.857428, "o", "\t\tnode.Prediction = mean\r\n\t\tif classification {\r\n\t\t\tnode.Probability = mean\r\n\t\t}\r\n\t\treturn node\r\n\t}\r\n\r\n\tbestGain := 0.0\r\n\tbestFeature := -1\r\n\tbestThreshold := 0.0\r\n\tbestLeftIdx := []int(nil)\r\n\tbestRightIdx := []int(nil)\r\n\r\n\timpurity := giniOrVariance(y, classification)\r\n\tfor j := 0; j < len(features); j++ {\r\n\t\tvalues := make([]float64, len(X))\r\n"]
[1890.857517, "o", "\t\tfor i := 0; i < len(X); i++ {\r\n\t\t\tvalues[i] = X[i][j]\r\n\t\t}\r\n\t\tsorted := uniqueFloats(values)\r\n\t\tsort.Float64s(sorted)\r\n\t\tfor s := 0; s < len(sorted)-1; s++ {\r\n"]
[1890.857582, "o", "\t\t\tthreshold := (sorted[s] + sorted[s+1]) / 2\r\n\t\t\tleftIdx := []int{}\r\n\t\t\trightIdx := []int{}\r\n\t\t\tfor i := 0; i < len(X); i++ {\r\n\t\t\t\tif X[i][j] <= threshold {\r\n\t\t\t\t\tleftIdx = append(leftIdx, i)\r\n\t\t\t\t} else {\r\n\t\t\t\t\trightIdx = append(rightIdx, i)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif len(leftIdx) == 0 || len(rightIdx) == 0 {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tleftY := subsetY(y, leftIdx)\r\n\t\t\trightY := subsetY(y, rightIdx)\r\n\t\t\tleftImp := giniOrVariance(leftY, classification)\r\n"]
[1890.857646, "o", "\t\t\trightImp := giniOrVariance(rightY, classification)\r\n\t\t\tgain := impurity - (float64(len(leftY))*leftImp+float64(len(rightY))*rightImp)/float64(len(y))\r\n\t\t\tif gain > bestGain {\r\n\t\t\t\tbestGain = gain\r\n\t\t\t\tbestFeature = j\r\n\t\t\t\tbestThreshold = threshold\r\n\t\t\t\tbestLeftIdx = leftIdx\r\n\t\t\t\tbestRightIdx = rightIdx\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[1890.85771, "o", "\tif bestFeature == -1 || bestGain <= 0 {\r\n\t\tnode.IsLeaf = true\r\n\t\tnode.Prediction = mean\r\n\t\tif classification {\r\n\t\t\tnode.Probability = mean\r\n\t\t}\r\n\t\treturn node\r\n\t}\r\n\r\n\tnode.Feature = bestFeature\r\n"]
[1890.857781, "o", "\tnode.Threshold = bestThreshold\r\n\tleftX := subsetRows(X, bestLeftIdx)\r\n\trightX := subsetRows(X, bestRightIdx)\r\n\tnode.Left = trainDecisionTree(leftX, subsetY(y, bestLeftIdx), features, classification, depth+1, maxDepth, minSplit)\r\n\tnode.Right = trainDecisionTree(rightX, subsetY(y, bestRightIdx), features, classification, depth+1, maxDepth, minSplit)\r\n\treturn node\r\n}\r\n\r\nfunc giniOrVariance(y []float64, classification bool) float64 {\r\n\tif len(y) == 0 {\r\n\t\treturn 0\r\n\t}\r\n"]
[1890.857846, "o", "\tif classification {\r\n\t\tcounts := map[float64]int{}\r\n\t\tfor _, v := range y {\r\n\t\t\tcounts[v]++\r\n\t\t}\r\n\t\tg := 1.0\r\n\t\tfor _, c := range counts {\r\n\t\t\tp := float64(c) / float64(len(y))\r\n\t\t\tg -= p * p\r\n\t\t}"]
[1890.857901, "o", "\r\n\t\treturn g\r\n\t}\r\n\tmean := 0.0\r\n"]
[1890.858423, "o", "\u001b[?2004h"]
