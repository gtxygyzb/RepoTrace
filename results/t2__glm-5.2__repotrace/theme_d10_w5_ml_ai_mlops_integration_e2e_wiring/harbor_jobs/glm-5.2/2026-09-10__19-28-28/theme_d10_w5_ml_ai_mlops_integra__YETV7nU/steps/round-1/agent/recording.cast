[9156.353513, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('config.go')\nlines = p.read_text().splitlines()\nfor i,l in enumerate(lines):\n    if 'models, ok := refs' in l:\n        start = i\n        # find the closing brace for this if block\n        depth = 0\n        for j in range(start, len(lines)):\n            depth += lines[j].count('{') - lines[j].count('}')\n            if depth == 0 and j > start:\n                end = j\n                break\n        indent = lines[start].split('if s.Type == \"ensemble\"')[0]\n        lines[start:end+1] = [\n            indent + 'if s.Type == \"ensemble\" && local == \"models\" {',\n            indent + '\\tif _, ok := ref.([]interface{}); !ok {',\n            indent + '\\t\\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q input %q must be an array\", s.Name, local))',\n            indent + '\\t}',\n            indent + '}',\n        ]\n        break\nelse:\n    raise SystemExit('line not found')\np.write_text('\\n'.join(lines) + '\\n')\nPY\n"]
