[2657.741, "o", "  \"stages\": [\r\n\u001b[?2004l\r"]
[2657.741056, "o", "\u001b[?2004h> "]
[2657.741755, "o", "    {\"name\": \"load\", \"type\": \"data-source\", \"depends_on\": [], \"inputs\": {}, \"params\": {\"path\": \"${data_dir}/data.csv\"}},\r\n\u001b[?2004l\r"]
[2657.741846, "o", "\u001b[?2004h> "]
[2657.742566, "o", "    {\"name\": \"split\", \"type\": \"split\", \"depends_on\": [\"load\"], \"inputs\": {\"data\": \"load.data\"}, \"params\": {\"ratio\": 0.8, \"seed\": 7}},\r\n\u001b[?2004l\r"]
[2657.742642, "o", "\u001b[?2004h> "]
[2657.743697, "o", "    {\"name\": \"train\", \"type\": \"train\", \"depends_on\": [\"split\"], \"inputs\": {\"data\": \"split.train\"}, \"params\": {\"algorithm\": \"decision-tree\", \"target\": \"label\", \"hyperparams\": {\"max_depth\": 3}}},\r\n\u001b[?2004l\r"]
[2657.74377, "o", "\u001b[?2004h> "]
