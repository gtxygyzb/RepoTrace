[8827.962681, "o", "\t\treturn true\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc (c *Config) Validate() (bool, []string) {\r\n\terrors := []string{}\r\n\tnames := map[string]bool{}\r\n\tfor i, s := range c.Stages {\r\n\t\tif s.Name == \"\" {\r\n\t"]
[8827.962779, "o", "\t\terrors = append(errors, fmt.Sprintf(\"stage at index %d has empty name\", i))\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif names[s.Name] {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"duplicate stage name: %s\", s.Name))\r\n\t\t}\r\n\t\tnames[s.Name] = true\r\n\t}\r\n\tfor _, s := range c.Stages {\r\n\t\tif !validStageType(s.Type) {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q has unknown type %q\", s.Name, s.Type))\r\n\t\t}\r\n\t\tfor _, dep := range s.DependsOn {\r\n\t\t\tif !names[dep] {\r\n"]
[8827.962857, "o", "\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q references unknown dependency %q\", s.Name, dep))\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor local, ref := range s.Inputs {\r\n"]
[8827.962926, "o", "\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n\t\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %q\", s.Name, local, ref))\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\trefStage, ok := c.stageByName(parts[0])\r\n\t\t\tif !ok {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown stage %q\", s.Name, local, parts[0]))\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tports := validOutputPorts(refStage.Type)\r\n\t\t\tvalid := false\r\n\t\t\tfor _, p := range ports {\r\n\t\t\t\tif p == parts[1] {\r\n\t"]
[8827.962995, "o", "\t\t\t\tvalid = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !valid {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown output port %q on stage %q\", s.Name, local, parts[1], parts[0]))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif stages, cycle := c.detectCycle(); cycle {\r\n\t\t"]
[8827.963062, "o", "errors = append(errors, fmt.Sprintf(\"cycle detected involving stages: %s\", strings.Join(stages, \", \")))\r\n\t}\r\n\treturn len(errors) == 0, errors\r\n}\r\n\r\nfunc (c *Config) detectCycle() ([]string, bool) {\r\n\tadj := map[string][]string{}\r\n\tfor _, s := range c.Stages {\r\n\t\tadj[s.Name] = append(adj[s.Name], s.DependsOn...)\r\n\t}\r\n\tcolor := map[string]int{}\r\n\tvar stack []string\r\n"]
[8827.963128, "o", "\tvar cycle []string\r\n\r\n\tvar dfs func(node string) bool\r\n\tdfs = func(node string) bool {\r\n\t\tif color[node] == 1 {\r\n\t\t\tidx := -1\r\n\t\t\tfor i, n := range stack {\r\n\t\t\t\tif n == node {\r\n\t\t\t"]
[8827.96319, "o", "\t\tidx = i\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif idx >= 0 {\r\n\t\t\t\tcycle = append([]string{}, stack[idx:]...)\r\n\t\t\t\tcycle = append(cycle, node)\r\n\t\t\t\tif len(cycle) > 1 && cycle[0] == cycle[len(cycle)-1] {\r\n\t\t\t\t\tcycle = cycle[:len(cycle)-1]\r\n\t\t\t\t}\r\n"]
[8827.963284, "o", "\t\t\t}\r\n\t\t\treturn true\r\n\t\t}\r\n\t\tif color[node] == 2 {\r\n\t\t\treturn false\r\n\t\t}\r\n\t\tcolor[node] = 1\r\n\t\tstack = append(stack, node)\r\n\t\tfor _, dep := range adj[node] {\r\n\t\t\tif _, ok := adj[dep]; ok {\r\n\t\t\t\tif dfs(dep) {\r\n\t"]
[8827.963348, "o", "\t\t\t\treturn true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tstack = stack[:len(stack)-1]\r\n\t\tcolor[node] = 2\r\n\t\treturn false\r\n\t}\r\n\r\n\t"]
[8827.96341, "o", "for _, s := range c.Stages {\r\n\t\tif color[s.Name] == 0 {\r\n\t\t\tif dfs(s.Name) {\r\n\t\t\t\treturn cycle, true\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn nil, false\r\n}\r\n\r\n"]
[8827.96347, "o", "func getString(params map[string]interface{}, key string) (string, bool) {\r\n\tv, ok := params[key]\r\n\tif !ok {\r\n\t\treturn \"\", false\r\n"]
