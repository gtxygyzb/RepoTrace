[12673.825092, "o", "    19\t\r\n    20\ttype ListDiff struct {\r\n    21\t\tOld []string `json:\"old\"`\r\n    22\t\tNew []string `json:\"new\"`\r\n    23\t}\r\n    24\t\r\n    25\ttype ConfigDiff struct {\r\n    26\t\tPipelineName    *FieldDiff           `json:\"pipeline_name,omitempty\"`\r\n    27\t\tStagesAdded     []string             `json:\"stages_added\"`\r\n    28\t\tStagesRemoved   []string             `json:\"stages_removed\"`\r\n    29\t"]
[12673.825161, "o", "\tStagesModified  map[string]StageDiff `json:\"stages_modified\"`\r\n    30\t\tStagesUnchanged []string             `json:\"stages_unchanged\"`\r\n    31\t}\r\n    32\t\r\n    33\tfunc cmdDiff(args []string) {\r\n"]
[12673.825275, "o", "    34\t\tif len(args) != 2 {\r\n    35\t\t\texitError(\"usage: mlpipe diff <config1.json> <config2.json>\")\r\n    36\t\t\treturn\r\n    37\t\t}\r\n    38\t\tconfig1, err := loadConfig(args[0])\r\n    39\t\tif err != nil {\r\n    40\t\t\texitError(err.Error())\r\n    41\t\t\treturn\r\n    42\t\t}\r\n    43\t\tconfig2, err := loadConfig(args[1])\r\n    44\t\tif err != nil {\r\n    45\t\t\texitError(err.Error())\r\n    46\t\t\treturn\r\n    47\t\t}\r\n    48\t\tprintJSON(diffConfigs(config1, config2))\r\n    49\t}\r\n    50\t\r\n    51\tfunc diffConfigs(c1, c2 *Config) ConfigDiff {\r\n    52\t\tresult := ConfigDiff{\r\n    53"]
[12673.825361, "o", "\t\t\tStagesAdded:     []string{},\r\n    54\t\t\tStagesRemoved:   []string{},\r\n    55\t\t\tStagesModified:  map[string]StageDiff{},\r\n    56\t\t\tStagesUnchanged: []string{},\r\n    57\t\t}\r\n    58\t\r\n    59\t\tif c1.Pipeline.Name != c2.Pipeline.Name {\r\n    60\t\t\tresult.PipelineName = &FieldDiff{Old: c1.Pipeline.Name, New: c2.Pipeline.Name}\r\n    61\t\t}\r\n    62\t\r\n    63\t\tstages1 := map[string]StageConfig{}\r\n    64\t\t"]
[12673.825431, "o", "for _, s := range c1.Stages {\r\n    65\t\t\tstages1[s.Name] = s\r\n    66\t\t}\r\n    67\t\tstages2 := map[string]StageConfig{}\r\n    68\t\tfor _, s := range c2.Stages {\r\n    69\t\t\tstages2[s.Name] = s\r\n    70\t\t}\r\n    71\t\r\n    72\t\tallNames := map[string]bool{}\r\n    73\t\tfor name := range stages1 {\r\n    74\t\t\tallNames[name] = true\r\n    75\t\t}\r\n"]
