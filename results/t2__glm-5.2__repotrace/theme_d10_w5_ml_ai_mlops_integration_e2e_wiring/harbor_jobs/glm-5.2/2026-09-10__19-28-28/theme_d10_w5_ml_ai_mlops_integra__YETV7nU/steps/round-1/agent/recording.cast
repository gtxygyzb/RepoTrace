[9321.416213, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('cv.go')\nlines = p.read_text().splitlines()\n# Find the line with 'for _, r := range refs {' in stageDeps\nfor i,l in enumerate(lines):\n    if 'for _, r := range refs {' in l and i > 520:\n        start = i+1\n        # find next 'out := make' line\n        for j in range(start, len(lines)):\n            if 'out := make' in lines[j]:\n                end = j\n                break\n        break\nelse:\n    raise SystemExit('loop not found')\n# Replace lines[start:end] with correctly indented block\nindent = '\\t\\t\\t'\nlines[start:end] = [\n    indent + 'parts := strings.SplitN(r, \".\", 2)',\n    indent + 'if len(parts) == 2 && parts[0] != \"\" {',\n    indent + '\\tdeps[parts[0]] = true',\n    indent + '}',\n    '\\t\\t}',\n    '\\t}',\n]\np.write_text('\\n'.join(lines) + '\\n')\nPY\n"]
