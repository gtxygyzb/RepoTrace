[8895.890859, "o", "   151\t\t\tstages[name] = PlanStage{\r\n   152\t\t\t\tType:        stage.Type,\r\n   153\t\t\t\tDependsOn:   deps,\r\n   154\t\t\t\tInputTypes:  inputTypes,\r\n   155\t\t\t\tOutputTypes: outputTypes,\r\n   156\t\t\t\tCacheStatus: cacheStatus,\r\n   157\t\t\t"]
[8895.890929, "o", "\tCVPhase:     phase,\r\n   158\t\t\t}\r\n   159\t\t}\r\n   160\t\r\n   161\t\tsort.Slice(edges, func(i, j int) bool {\r\n   162\t\t\tif edges[i].From != edges[j].From {\r\n   163\t\t\t\treturn edges[i].From < edges[j].From\r\n   164\t\t\t}"]
[8895.890998, "o", "\r\n   165\t\t\tif edges[i].To != edges[j].To {\r\n   166\t\t\t\treturn edges[i].To < edges[j].To\r\n   167\t\t\t}\r\n   168\t\t\treturn edges[i].Port < edges[j].Port\r\n   169\t\t})\r\n"]
[8895.891067, "o", "   170\t\r\n   171\t\treturn &PlanOutput{\r\n   172\t\t\tPipeline:       config.Pipeline.Name,\r\n   173\t\t\tMode:           mode,\r\n   174\t\t\tCVFolds:        cv,\r\n   175\t\t\tExecutionOrder: executionOrder,\r\n   176\t\t\tStages:         stages,\r\n   177\t\t\tEdges:          edges,\r\n   178\t\t}, nil\r\n   179\t}\r\n   180\t\r\n   181\tfunc outputPortType(stageType, port string) string {\r\n"]
[8895.891143, "o", "   182\t\tswitch stageType {\r\n   183\t\tcase \"data-source\", \"transform\":\r\n   184\t\t\tif port == \"data\" {\r\n   185\t\t\t\treturn \"dataset\"\r\n   186\t\t\t}\r\n   187\t\tcase \"split\":\r\n   188\t\t\tif port == \"train\" || port == \"test\" {\r\n   189\t\t\t\treturn \"dataset\"\r\n   190\t\t\t}\r\n"]
[8895.891212, "o", "   191\t\tcase \"train\":\r\n   192\t\t\tif port == \"model\" {\r\n   193\t\t\t\treturn \"model\"\r\n   194\t\t\t}\r\n   195\t\t\tif port == \"predictions\" {\r\n   196\t\t\t\treturn \"dataset\"\r\n   197\t\t\t}\r\n   198\t\tcase \"evaluate\":\r\n"]
[8895.891295, "o", "   199\t\t\tif port == \"report\" {\r\n   200\t\t\t\treturn \"report\"\r\n   201\t\t\t}\r\n   202\t\tcase \"register\":\r\n   203\t\t\tif port == \"entry\" {\r\n"]
[8895.89137, "o", "   204\t\t\t\treturn \"entry\"\r\n   205\t\t\t}\r\n   206\t\t}\r\n   207\t\treturn \"unknown\"\r\n   208\t}\r\n   209\t\r\n   210\tfunc strPtr(s string) *string {\r\n   211\t\treturn &s\r\n   212\t}\r\n"]
