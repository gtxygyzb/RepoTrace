[9657.205788, "o", "   368\t\t}\r\n   369\t\tfor _, s := range c.Stages {\r\n   370\t\t\tfor _, dep := range s.DependsOn {\r\n   371\t\t\t\tif _, ok := c.stageByName(dep); ok {\r\n   372\t\t\t\t\tadj[dep] = append(adj[dep], s.Name)\r\n   373\t\t\t\t\tindeg[s.Name]++\r\n   374\t\t\t\t}\r\n   375\t\t\t}\r\n   376\t\t}\r\n   377\t\tqueue := []string{}\r\n   378\t\tfor _, s := range c.Stages {\r\n   379\t\t\tif indeg[s.Name] == 0 {\r\n   380\t\t\t\tqueue = append(queue, s.Name)\r\n   381\t\t\t}\r\n   382\t\t}\r\n   383\t\torder := []string{}\r\n   384\t\tfor len(queue) > 0 {\r\n   385\t\t\tnode := queue[0]\r\n   386\t\t\tqueue = queue[1:]\r\n   387\t\t\torder = append(order, node)\r\n   388\t\t\tfor _, next := range adj[node] {\r\n   389\t\t\t\tindeg[next]--\r\n   390\t\t\t\tif indeg[next] == 0 {\r\n   391\t\t\t\t\tqueue = append(queue, next)\r\n   392\t\t\t\t}\r\n   393\t\t\t}\r\n   394\t\t}\r\n   395\t\tif len(order) < len(c.Stages) {\r\n   396\t\t\tif cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {\r\n"]
[9657.205936, "o", "   397\t\t\t\treturn nil, fmt.Errorf(\"cycle detected involving stages: %s\", strings.Join(cycle, \", \"))\r\n   398\t\t\t}\r\n   399\t\t\treturn nil, fmt.Errorf(\"cycle detected involving stages: %s\", joinStageNames(c.Stages))\r\n   400\t\t}\r\n   401\t\treturn order, nil\r\n   402\t}\r\n   403\t\r\n   404\tfunc joinStageNames(stages []StageConfig) string {\r\n   405\t\tnames := []string{}\r\n   406\t\tfor _, s := range stages {\r\n   407\t\t\tnames = append(names, s.Name)\r\n   408\t\t}\r\n   409\t\treturn strings.Join(names, \", \")\r\n   410\t}\r\n   411\t\r\n   412\tfunc artifactID(pipeline, stage, port string, ts int64) string {\r\n   413\t\tif pipeline == \"\" {\r\n   414\t\t\tpipeline = \"pipeline\"\r\n   415\t\t}\r\n   416\t\treturn fmt.Sprintf(\"%s-%s-%s-%d\", pipeline, stage, port, ts)\r\n   417\t}\r\n"]
