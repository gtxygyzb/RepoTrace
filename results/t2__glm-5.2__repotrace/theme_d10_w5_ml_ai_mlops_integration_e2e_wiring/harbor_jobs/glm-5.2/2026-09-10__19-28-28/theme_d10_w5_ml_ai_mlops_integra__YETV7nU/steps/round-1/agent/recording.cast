[12583.051351, "o", "\t\t\tfor _, fr := range executor.foldResults {\r\n   106\t\t\t\tfoldStages := FoldSummary{}\r\n   107\t\t\t\tfor stageName, r := range fr.Stages {\r\n   108\t\t\t\t\tif r == nil {\r\n   109\t\t\t\t\t\tcontinue\r\n   110\t\t\t\t\t}\r\n   111\t\t\t\t\tfoldStages[stageName] = FoldStageSummary{Status: r.Status, CacheHit: r.CacheHit}\r\n   112\t\t\t\t}\r\n   113\t\t\t\tfolds[strconv.Itoa(fr.Fold)] = foldStages\r\n"]
