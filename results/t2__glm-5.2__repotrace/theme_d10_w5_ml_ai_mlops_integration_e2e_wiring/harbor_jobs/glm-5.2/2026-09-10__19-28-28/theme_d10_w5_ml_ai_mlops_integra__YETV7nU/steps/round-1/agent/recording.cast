[12847.918133, "o", "   111\t\r\n   112\t\tfor _, name := range order {\r\n   113\t\t\tstage, _ := e.config.stageByName(name)\r\n   114\t\t\te.outputs[name] = map[string]string{}\r\n   115\t\t\te.values[name] = map[string]*ArtifactValue{}\r\n   116\t\t\te.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n   117\t\r\n   118\t\t\tif stopped {\r\n   119\t"]
[12847.918298, "o", "\t\t\te.status[name] = \"skipped\"\r\n   120\t\t\t\te.results[name].Status = \"skipped\"\r\n   121\t\t\t\te.results[name].DurationMs = 0\r\n"]
[12847.918369, "o", "   122\t\t\t\tcontinue\r\n   123\t\t\t}\r\n   124\t\r\n   125\t\t\tif skipSet[name] {\r\n   126\t\t\t\te.status[name] = \"skipped\"\r\n   127\t\t\t\te.results[name].Status = \"skipped\"\r\n   128\t\t\t\te.results[name].DurationMs = 0\r\n   129\t\t\t\tcontinue\r\n   130\t\t\t}\r\n   131\t\r\n   132\t\t\tskip := false\r\n   133\t\t\tfor _, dep := range stage.DependsOn {\r\n   134\t\t\t\tdepStatus := e.status[dep]\r\n   135\t\t\t\tif depStatus != \"success\" {\r\n   136\t\t\t\t\tskip = true\r\n   137\t\t\t\t\tbreak\r\n   138\t\t\t\t}\r\n   139\t\t\t}\r\n   140\t\t\tif skip {\r\n   141\t\t\t\te.status[name] = \"skipped\"\r\n   142\t\t\t\te.results[name].Status = \"skipped\"\r\n"]
[12847.918445, "o", "   143\t\t\t\te.results[name].DurationMs = 0\r\n   144\t\t\t\tcontinue\r\n"]
