[1537.444556, "i", "cat > main.go <<'EOF'\npackage main\n\nimport (\n    \"encoding/json\"\n    \"fmt\"\n    \"os\"\n    \"strings\"\n)\n\nfunc main() {\n    if len(os.Args) < 2 {\n        printError(\"usage: mlpipe <command> [args]\")\n        return\n    }\n\n    cmd := os.Args[1]\n    args := os.Args[2:]\n\n    switch cmd {\n    case \"run\":\n        cmdRun(args)\n    case \"validate\":\n        cmdValidate(args)\n    case \"registry\":\n        cmdRegistry(args)\n    case \"lineage\":\n        cmdLineage(args)\n    default:\n        printError(fmt.Sprintf(\"unknown command: %s\", cmd))\n    }\n}\n\nfunc cmdRun(args []string) {\n    if len(args) < 1 {\n        printError(\"usage: mlpipe run <config.json> [--param key=value ...]\")\n        return\n    }\n    configPath := args[0]\n    overrides, err := parseParams(args[1:])\n    if err != nil {\n        printError(err.Error())\n        return\n    }\n    config, err := loadConfig(configPath)\n    if err != nil {\n        printError(err.Error())\n        return\n    }\n    executor := NewExecutor(config, overrides)\n    run, err := executor.Run()"]
[1537.444741, "i", "\n    if err != nil {\n        printError(err.Error())\n        return\n    }\n    printJSON(run)\n}\n\nfunc cmdValidate(args []string) {\n    if len(args) < 1 {\n        printError(\"usage: mlpipe validate <config.json>\")\n        return\n    }\n    config, err := loadConfig(args[0])\n    if err != nil {\n        printError(err.Error())\n        return\n    }\n    valid, errors := config.Validate()\n    printJSON(map[string]interface{}{\"valid\": valid, \"errors\": errors})\n}\n\nfunc cmdRegistry(args []string) {\n    if len(args) < 1 {\n        printError(\"usage: mlpipe registry <list|info|promote|compare> [args]\")\n        return\n    }\n    sub := args[0]\n    rest := args[1:]\n    switch sub {\n    case \"list\":\n        cmdRegistryList(rest)\n    case \"info\":\n        cmdRegistryInfo(rest)\n    case \"promote\":\n        cmdRegistryPromote(rest)\n    case \"compare\":\n        cmdRegistryCompare(rest)\n    default:\n        printError(fmt.Sprintf(\"unknown registry command: %s\", sub))\n    }\n}\n\nfunc cmdRegistryList(args []string) {\n    name, stage, tag "]
[1537.444827, "o", "cat > main.go <<'EOF'\r\n\u001b[?2004l\r"]
[1537.444926, "i", ":= \"\", \"\", \"\"\n    for i := 0; i < len(args); i++ {\n        switch {\n        case args[i] == \"--name\" && i+1 < len(args):\n            name = args[i+1]\n            i++\n        case strings.HasPrefix(args[i], \"--name=\"):\n            name = strings.TrimPrefix(args[i], \"--name=\")\n        case args[i] == \"--stage\" && i+1 < len(args):\n            stage = args[i+1]\n            i++\n        case strings.HasPrefix(args[i], \"--stage=\"):\n            stage = strings.TrimPrefix(args[i], \"--stage=\")\n        case args[i] == \"--tag\" && i+1 < len(args):\n            tag = args[i+1]\n            i++\n        case strings.HasPrefix(args[i], \"--tag=\"):\n            tag = strings.TrimPrefix(args[i], \"--tag=\")\n        default:\n            printError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\n            return\n        }\n    }\n    entries, err := listRegistry(name, stage, tag)\n    if err != nil {\n        printError(err.Error())\n        return\n    }\n    printJSON(entries)\n}\n\nfunc cmdRegistryInfo(args []string) {\n    if len(args) < 1 {\n    "]
[1537.444999, "o", "\u001b[?2004h> package main\r\n\u001b[?2004l\r"]
