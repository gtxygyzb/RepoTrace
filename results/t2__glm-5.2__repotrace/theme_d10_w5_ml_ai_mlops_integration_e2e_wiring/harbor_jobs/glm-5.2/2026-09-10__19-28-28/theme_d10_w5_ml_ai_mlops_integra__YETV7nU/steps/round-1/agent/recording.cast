[12689.975617, "i", ".Inputs[\"data\"]; !ok {',\n'\\t\\t\\t\\t\\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires inputs.data\", s.Name))',\n'\\t\\t\\t\\t}',\n'\\t\\t}',\n]\nlines = lines[:start] + new_block + lines[end+1:]\np.write_text('\\n'.join(lines) + '\\n')\nPY\n"]
