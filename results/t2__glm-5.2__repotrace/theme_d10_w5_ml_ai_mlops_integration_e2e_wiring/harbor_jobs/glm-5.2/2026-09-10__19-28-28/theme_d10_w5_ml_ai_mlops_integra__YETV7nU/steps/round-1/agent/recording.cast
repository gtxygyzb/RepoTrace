[5326.206075, "o", "\u001b[?2004h> "]
[5326.206339, "o", "    for _, fm := range foldMetrics {\r\n\u001b[?2004l\r"]
[5326.206394, "o", "\u001b[?2004h> "]
[5326.206609, "o", "        for name := range fm {\r\n\u001b[?2004l\r"]
