[8784.253006, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n"]
[8784.253116, "o", "\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintError(\"usage: mlpipe <command> [args]\")\r\n\t\treturn\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"plan\":\r\n\t\tcmdPlan(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"registry\":\r\n\t\tcmdRegistry(args)\r\n"]
[8784.253194, "o", "\tcase \"lineage\":\r\n\t\tcmdLineage(args)\r\n\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n\t}\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n\tconfigPath, overrides, cv, noCache, err := parseRunArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}"]
[8784.253271, "o", "\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n"]
[8784.253331, "o", "\t}\r\n\texecutor := NewExecutor(config, overrides)\r\n\texecutor.noCache = noCache\r\n\tif noCache {\r\n\t\texecutor.cacheStats = nil\r\n\t}\r\n\texecutor.cvFolds = cv\r\n\tvar run interface{}\r\n\tif cv > 0 {\r\n\t\trun, err = executor.RunCV()\r\n\t} else {\r\n\t\trun, err = executor.Run()\r\n\t}\r\n"]
