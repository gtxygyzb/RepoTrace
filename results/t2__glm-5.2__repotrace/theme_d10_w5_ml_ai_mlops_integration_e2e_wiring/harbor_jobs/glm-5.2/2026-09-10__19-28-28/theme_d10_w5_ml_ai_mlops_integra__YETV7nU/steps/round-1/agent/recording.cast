[8768.356871, "o", "train.go:504:func (m *\u001b[01;31m\u001b[KModel\u001b[m\u001b[K) \u001b[01;31m\u001b[KPredict\u001b[m\u001b[KBatch(X [][]float64) []float64 {\r\ntrain.go:512:func (m *\u001b[01;31m\u001b[KModel\u001b[m\u001b[K) \u001b[01;31m\u001b[KPredict\u001b[m\u001b[K(x []float64) float64 {\r\ntrain.go:588:func predictKNN(knn *KNN\u001b[01;31m\u001b[KModel\u001b[m\u001b[K, x []float64) float64 {\r\n"]
