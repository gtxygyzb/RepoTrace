[9353.662186, "o", "\u001b[?2004h> "]
[9353.662266, "o", "\\t\\tcounts[p]++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9353.662331, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9353.662421, "o", "\\tbest := preds[0]\r\n\u001b[?2004l\r"]
[9353.662486, "o", "\u001b[?2004h> "]
[9353.662577, "o", "\\tbestCount := counts[best]\r\n\u001b[?2004l\r"]
[9353.662643, "o", "\u001b[?2004h> "]
[9353.662733, "o", "\\tfor _, p := range preds {\r\n\u001b[?2004l\r"]
[9353.662799, "o", "\u001b[?2004h> "]
[9353.663062, "o", "\\t\\tif counts[p] > bestCount || (counts[p] == bestCount && p < best) {\r\n\u001b[?2004l\r"]
[9353.663129, "o", "\u001b[?2004h> "]
[9353.663194, "o", "\\t\\t\\tbest = p\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9353.663329, "o", "\\t\\t\\tbestCount = counts[p]\r\n\u001b[?2004l\r"]
[9353.663395, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[9353.663459, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[9353.663522, "o", "\u001b[?2004h> "]
[9353.663588, "o", "\\treturn best\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9353.663654, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
