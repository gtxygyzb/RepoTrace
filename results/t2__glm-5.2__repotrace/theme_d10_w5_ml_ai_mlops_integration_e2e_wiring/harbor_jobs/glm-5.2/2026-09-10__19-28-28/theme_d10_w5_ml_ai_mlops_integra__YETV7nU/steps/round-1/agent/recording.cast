[10639.944387, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[10639.944445, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[10639.9445, "o", "\u001b[?2004h> "]
[10639.944695, "o", "new = '''func cmdRegistryPromote(args []string) {\r\n\u001b[?2004l\r"]
[10639.944748, "o", "\u001b[?2004h> "]
[10639.944848, "o", "\\tvar positionals []string\r\n\u001b[?2004l\r"]
[10639.944902, "o", "\u001b[?2004h> "]
[10639.944961, "o", "\\tforce := false\r\n\u001b[?2004l\r"]
[10639.94502, "o", "\u001b[?2004h> "]
[10639.945113, "o", "\\tfor _, a := range args {\r\n\u001b[?2004l\r"]
[10639.945167, "o", "\u001b[?2004h> "]
[10639.945262, "o", "\\t\\tif a == \"--force\" {\r\n\u001b[?2004l\r"]
[10639.945321, "o", "\u001b[?2004h> "]
[10639.945382, "o", "\\t\\t\\tforce = true\r\n\u001b[?2004l\r"]
[10639.945437, "o", "\u001b[?2004h> "]
[10639.9455, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r\u001b[?2004h"]
[10639.945554, "o", "> \\t\\t}\r\n\u001b[?2004l\r"]
[10639.945613, "o", "\u001b[?2004h> "]
[10639.945748, "o", "\\t\\tif strings.HasPrefix(a, \"--\") {\r\n\u001b[?2004l\r"]
[10639.945802, "o", "\u001b[?2004h> "]
