[6691.380067, "o", "n := float64(len(y))\r\n   178\t\tswitch name {\r\n   179\t\tcase \"mse\":\r\n   180\t\t\tsum := 0.0\r\n   181\t\t\tfor i := range y {\r\n   182\t\t\t\td := y[i] - preds[i]\r\n   183\t\t\t\tsum += d * d\r\n   184\t\t\t}\r\n   185\t\t\treturn sum / n, nil\r\n   186\t\tcase \"rmse\":\r\n   187\t\t\tmse, _ := regressionMetric(\"mse\", y, preds)\r\n   188\t\t\treturn math.Sqrt(mse.(float64)), nil\r\n   189\t\tcase \"mae\":\r\n   190\t\t\tsum := 0.0\r\n   191\t\t\tfor i := range y {\r\n   192\t\t\t\tsum += math.Abs(y[i] - preds[i])\r\n   193\t\t\t}\r\n   194\t"]
[6691.380144, "o", "\t\treturn sum / n, nil\r\n   195\t\tcase \"r2\":\r\n   196\t\t\tmean := 0.0\r\n   197\t\t\tfor _, v := range y {\r\n   198\t\t\t\tmean += v\r\n   199\t\t\t}\r\n   200\t\t\tmean /= n\r\n   201\t\t\tssRes := 0.0\r\n   202\t\t\tssTot := 0.0\r\n   203\t\t\t"]
[6691.380212, "o", "for i := range y {\r\n   204\t\t\t\tssRes += (y[i] - preds[i]) * (y[i] - preds[i])\r\n   205\t\t\t\tssTot += (y[i] - mean) * (y[i] - mean)\r\n   206\t\t\t}\r\n   207\t\t\tif ssTot == 0 {\r\n   208\t\t\t\treturn 0.0, nil\r\n   209\t\t\t}\r\n   210\t\t\treturn 1 - ssRes/ssTot, nil\r\n   211\t\tcase \"mape\":\r\n"]
[6691.38032, "o", "   212\t\t\tsum := 0.0\r\n   213\t\t\tcount := 0.0\r\n   214\t\t\tfor i := range y {\r\n   215\t\t\t\tif y[i] == 0 {\r\n   216\t\t\t\t\tcontinue\r\n   217\t\t\t\t}\r\n   218\t\t\t\tsum += math.Abs((y[i] - preds[i]) / y[i])\r\n   219\t\t\t\tcount++\r\n   220\t\t\t}\r\n"]
