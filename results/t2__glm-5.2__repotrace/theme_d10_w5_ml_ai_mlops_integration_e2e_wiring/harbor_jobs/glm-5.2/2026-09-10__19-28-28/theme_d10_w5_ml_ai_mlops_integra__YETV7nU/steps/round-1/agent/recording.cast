[11898.545018, "o", "    88\tfunc (e *Executor) Run() (*RunOutput, error) {\r\n    89\t\tvalid, errs := e.config.Validate()\r\n    90\t\tif !valid {\r\n    91\t\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n    92\t\t}\r\n    93\t\torder, err := e.config.topologicalOrder()\r\n    94\t\tif err != nil {\r\n    95\t\t"]
[11898.545131, "o", "\treturn nil, err\r\n    96\t\t}\r\n    97\t\r\n    98\t\trunArtifacts := map[string]*ArtifactOutput{}\r\n    99\t\r\n   100\t\tskipSet := map[string]bool{}\r\n   101\t\tfor _, name := range e.skipStages {\r\n   102\t\t\tskipSet[name] = true\r\n   103\t\t}\r\n   104\t\r\n   105\t\tonFailure := e.config.Pipeline.OnFailure\r\n   106\t\tif onFailure != \"continue\" {\r\n   107\t\t\tonFailure = \"stop\"\r\n   108\t\t}\r\n   109\t\tstopped := false\r\n"]
[11898.545259, "o", "   110\t\r\n   111\t\tfor _, name := range order {\r\n   112\t\t\tstage, _ := e.config.stageByName(name)\r\n   113\t\t\te.outputs[name] = map[string]string{}\r\n   114\t\t\te.values[name] = map[string]*ArtifactValue{}\r\n   115\t\t\te.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n   116\t\r\n   117\t\t\tif stopped {\r\n   118\t\t\t\te.status[name] = \"skipped\"\r\n   119\t\t\t\te.results[name].Status = \"skipped\"\r\n   120\t\t\t\te.results[name].DurationMs = 0\r\n   121\t\t\t\tcontinue\r\n   122\t\t\t}\r\n"]
[11898.545352, "o", "   123\t\r\n   124\t\t\tif skipSet[name] {\r\n   125\t\t\t\te.status[name] = \"skipped\"\r\n   126\t\t\t\te.results[name].Status = \"skipped\"\r\n   127\t\t\t\te.results[name].DurationMs = 0\r\n   128\t\t\t\tcontinue\r\n   129\t\t\t}\r\n   130\t\r\n   131\t\t\tskip := false\r\n   132\t\t\tfor _, dep := range stage.DependsOn {\r\n   133\t\t\t\tdepStatus := e.status[dep]\r\n   134\t\t\t\tif depStatus != \"success\" {\r\n   135\t\t\t\t\tskip = true\r\n   136\t\t\t\t\tbreak\r\n   137\t\t\t\t}\r\n   138\t\t\t}\r\n"]
[11898.545437, "o", "   139\t\t\tif skip {\r\n   140\t\t\t\te.status[name] = \"skipped\"\r\n   141\t\t\t\te.results[name].Status = \"skipped\"\r\n   142\t\t\t\te.results[name].DurationMs = 0\r\n   143\t\t\t\tcontinue\r\n   144\t\t\t}\r\n   145\t\r\n   146\t\t\tinputValues, inputIDs, err := e.resolveInputs(stage)\r\n   147\t\t\tif err != nil {\r\n   148\t\t\t\te.status[name] = \"failed\"\r\n   149\t\t\t\te.results[name].Status = \"failed\"\r\n   150"]
[11898.545521, "o", "\t\t\t\te.results[name].Error = err.Error()\r\n   151\t\t\t\tif onFailure == \"stop\" {\r\n   152\t\t\t\t\tstopped = true\r\n   153\t\t\t\t\tcontinue\r\n   154\t\t\t\t}\r\n   155\t\t\t\tcontinue\r\n   156\t\t\t}\r\n   157\t\r\n   158\t\t\tparams := e.config.stageParams(name, e.globals)\r\n   159\t\t\tinputKeys := e.inputCacheKeys(stage)\r\n   160\t\t\tcacheKey, keyErr := computeCacheKey(stage, params, inputKeys, -1)\r\n   161"]
[11898.545601, "o", "\t\t\tif keyErr != nil {\r\n   162\t\t\t\te.status[name] = \"failed\"\r\n   163\t\t\t\te.results[name].Status = \"failed\"\r\n   164\t\t\t\te.results[name].Error = keyErr.Error()\r\n   165\t\t\t\tif onFailure == \"stop\" {\r\n   166\t\t\t\t\tstopped = true\r\n   167\t\t\t\t\tcontinue\r\n   168\t\t\t\t}\r\n   169\t\t\t\tcontinue\r\n   170\t\t\t}\r\n"]
