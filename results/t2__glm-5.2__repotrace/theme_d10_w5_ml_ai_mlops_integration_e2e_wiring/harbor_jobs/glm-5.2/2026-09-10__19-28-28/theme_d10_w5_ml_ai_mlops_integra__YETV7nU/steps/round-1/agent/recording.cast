[11921.20002, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6"]
[11921.200099, "o", "\t\t\"os\"\r\n     7\t\t\"regexp\"\r\n     8\t\t\"strings\"\r\n     9\t)\r\n    10\t\r\n    11\ttype Config struct {\r\n    12\t\tPipeline PipelineConfig `json:\"pipeline\"`\r\n    13\t\tStages   []StageConfig  `json:\"stages\"`\r\n    14\t}\r\n    15\t\r\n    16\ttype PipelineConfig struct {\r\n"]
[11921.200167, "o", "    17\t\tName      string                 `json:\"name\"`\r\n    18\t\tParams    map[string]interface{} `json:\"params\"`\r\n    19\t\tOnFailure string                 `json:\"on_failure,omitempty\"`\r\n    20\t}\r\n    21\t\r\n    22\ttype StageConfig struct {\r\n    23\t\tName      string                 `json:\"name\"`\r\n    24\t\tType      string                 `json:\"type\"`\r\n    25\t\tDependsOn []string               `json:\"depends_on\"`\r\n    26\t\tInputs    map[string]interface{} `json:\"inputs\"`\r\n"]
[11921.200271, "o", "    27\t\tParams    map[string]interface{} `json:\"params\"`\r\n    28\t}\r\n    29\t\r\n    30\tvar paramRE = regexp.MustCompile(`\\$\\{([^}]+)\\}`)\r\n    31\t\r\n    32\tfunc loadConfig(path string) (*Config, error) {\r\n    33\t\tdata, err := os.ReadFile(path)\r\n    34\t\tif err != nil {\r\n    35\t\t\tif os.IsNotExist(err) {\r\n    36\t\t\t\treturn nil, fmt.Errorf(\"file not found: %s\", path)\r\n    37\t\t\t}\r\n    38\t\t\treturn nil, err\r\n    39\t\t}\r\n    40\t\tvar c Config\r\n    41\t\tif err := json.Unmarshal(data, &c); err != nil {\r\n"]
[11921.200345, "o", "    42\t\t\treturn nil, fmt.Errorf(\"invalid config: %s\", err.Error())\r\n    43\t\t}\r\n    44\t\treturn &c, nil\r\n    45\t}\r\n"]
[11921.200409, "o", "    46\t\r\n    47\tfunc (c *Config) globalParams(overrides map[string]string) map[string]interface{} {\r\n    48\t\tparams := map[string]interface{}{}\r\n    49\t\tfor k, v := range c.Pipeline.Params {\r\n    50\t\t\tparams[k] = v\r\n    51\t\t}\r\n    52\t\tfor k, v := range overrides {\r\n    53\t\t\tparams[k] = v\r\n    54\t\t}\r\n    55\t\treturn params\r\n    56\t}\r\n    57\t\r\n"]
[11921.200469, "o", "    58\tfunc mergeParams(params map[string]interface{}, overrides map[string]string) map[string]interface{} {\r\n    59\t\tres := map[string]interface{}{}\r\n    60\t\tfor k, v := range params {\r\n    61\t\t\tres[k] = v\r\n    62\t\t}\r\n    63\t\tfor k, v := range overrides {\r\n    64\t\t\tres[k] = v\r\n"]
[11921.200537, "o", "    65\t\t}\r\n    66\t\treturn res\r\n    67\t}\r\n    68\t\r\n    69\tfunc substituteValue(v interface{}, globals map[string]interface{}) interface{} {\r\n    70\t\tswitch x := v.(type) {\r\n    71\t\tcase string:\r\n    72\t\t\treturn paramRE.ReplaceAllStringFunc(x, func(m string) string {\r\n    73\t\t\t\tkey := m[2 : len(m)-1]\r\n    74\t\t\t\tif val, ok := globals[key]; ok {\r\n    75\t\t\t\t\treturn fmt.Sprintf(\"%v\", val)\r\n    76\t\t"]
[11921.2006, "o", "\t\t}\r\n    77\t\t\t\treturn m\r\n    78\t\t\t})\r\n    79\t\tcase map[string]interface{}:\r\n    80\t\t\tres := map[string]interface{}{}\r\n    81\t\t\tfor k, val := range x {\r\n    82\t\t\t\tres[k] = substituteValue(val, globals)\r\n    83\t\t\t}\r\n    84\t\t\treturn res\r\n    85\t\tcase []interface{}:\r\n"]
[11921.200663, "o", "    86\t\t\tres := make([]interface{}, len(x))\r\n    87\t\t\tfor i, val := range x {\r\n    88\t\t\t\tres[i] = substituteValue(val, globals)\r\n    89\t\t\t}\r\n    90\t\t\treturn res\r\n    91\t\tdefault:\r\n    92\t\t\treturn v\r\n    93\t\t}\r\n"]
[11921.200729, "o", "    94\t}\r\n    95\t\r\n    96\tfunc (c *Config) stageParams(name string, globals map[string]interface{}) map[string]interface{} {\r\n    97\t\tfor _, s := range c.Stages {\r\n    98\t\t\tif s.Name == name {\r\n    99\t\t\t\tif s.Params == nil {\r\n   100\t\t\t\t\treturn map[string]interface{}{}\r\n   101\t\t\t\t}\r\n   102\t\t\t\tres := substituteValue(s.Params, globals)\r\n"]
[11921.200791, "o", "   103\t\t\t\tif m, ok := res.(map[string]interface{}); ok {\r\n   104\t\t\t\t\treturn m\r\n   105\t\t\t\t}\r\n   106\t\t\t\treturn map[string]interface{}{}\r\n   107\t\t\t}\r\n   108\t\t}\r\n   109\t\treturn map[string]interface{}{}\r\n   110\t}\r\n   111\t\r\n"]
