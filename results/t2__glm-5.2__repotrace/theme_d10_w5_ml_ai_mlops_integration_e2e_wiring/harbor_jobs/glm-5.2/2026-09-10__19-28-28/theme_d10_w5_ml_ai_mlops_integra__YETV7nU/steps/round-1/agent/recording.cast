[1292.275329, "o", "    entry := &RegistryEntry{\r\n\u001b[?2004l\r"]
[1292.275384, "o", "\u001b[?2004h> "]
[1292.275532, "o", "        Name:           name,\r\n\u001b[?2004l\r"]
[1292.275586, "o", "\u001b[?2004h> "]
[1292.275767, "o", "        Version:        version,\r\n\u001b[?2004l\r"]
[1292.27582, "o", "\u001b[?2004h> "]
[1292.275989, "o", "        Stage:          stageName,\r\n\u001b[?2004l\r"]
[1292.276043, "o", "\u001b[?2004h> "]
[1292.276194, "o", "        Tags:           tags,\r\n\u001b[?2004l\r"]
[1292.276256, "o", "\u001b[?2004h> "]
[1292.276498, "o", "        Metrics:        reportVal.Report.Metrics,\r\n\u001b[?2004l\r"]
[1292.276553, "o", "\u001b[?2004h> "]
[1292.276834, "o", "        Hyperparams:    modelVal.Model.Hyperparams,\r\n\u001b[?2004l\r"]
[1292.276888, "o", "\u001b[?2004h> "]
[1292.277101, "o", "        ArtifactRefs:   map[string]string{},\r\n\u001b[?2004l\r"]
[1292.277156, "o", "\u001b[?2004h> "]
[1292.277328, "o", "        PromotionRules: rules,\r\n\u001b[?2004l\r"]
[1292.277382, "o", "\u001b[?2004h> "]
[1292.277704, "o", "        RegisteredAt:   time.Now().UTC().Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[1292.277758, "o", "\u001b[?2004h> "]
[1292.277812, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.27803, "o", "    registry = append(registry, entry)\r\n\u001b[?2004l\r"]
[1292.278084, "o", "\u001b[?2004h> "]
[1292.3025, "o", "    if err := saveRegistry(registry); err != nil {\r\n\u001b[?2004l\r"]
[1292.30261, "o", "\u001b[?2004h> "]
[1292.302728, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1292.302784, "o", "\u001b[?2004h> "]
[1292.302837, "o", "    }\r\n\u001b[?2004l\r"]
[1292.302893, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[1292.302959, "o", "\u001b[?2004h> "]
[1292.303412, "o", "    return map[string]*ArtifactValue{\"entry\": {Entry: entry}}, nil\r\n\u001b[?2004l\r"]
[1292.303475, "o", "\u001b[?2004h> }\r\n"]
[1292.30353, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1292.303584, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.303637, "o", "> "]
[1292.30381, "o", "func registryPath() string {\r\n\u001b[?2004l\r"]
[1292.303871, "o", "\u001b[?2004h> "]
[1292.304233, "o", "    return filepath.Join(\".mlpipe\", \"registry.json\")\r\n\u001b[?2004l\r"]
[1292.304302, "o", "\u001b[?2004h> "]
[1292.304357, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1292.30442, "o", "\u001b[?2004h> "]
[1292.304745, "o", "func loadRegistry() ([]*RegistryEntry, error) {\r\n\u001b[?2004l\r"]
[1292.304799, "o", "\u001b[?2004h> "]
[1292.305107, "o", "    data, err := os.ReadFile(registryPath())\r\n\u001b[?2004l\r"]
[1292.305161, "o", "\u001b[?2004h> "]
[1292.305307, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1292.305368, "o", "\u001b[?2004h> "]
[1292.305592, "o", "        if os.IsNotExist(err) {\r\n\u001b[?2004l\r"]
[1292.305647, "o", "\u001b[?2004h> "]
[1292.305948, "o", "            return []*RegistryEntry{}, nil\r\n\u001b[?2004l\r"]
[1292.306002, "o", "\u001b[?2004h> "]
[1292.306072, "o", "        }\r\n\u001b[?2004l\r"]
[1292.306126, "o", "\u001b[?2004h> "]
[1292.306296, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1292.306349, "o", "\u001b[?2004h> "]
[1292.306406, "o", "    }\r\n\u001b[?2004l\r"]
[1292.30646, "o", "\u001b[?2004h> "]
[1292.306688, "o", "    var entries []*RegistryEntry\r\n\u001b[?2004l\r"]
[1292.306744, "o", "\u001b[?2004h> "]
[1292.307137, "o", "    if err := json.Unmarshal(data, &entries); err != nil {\r\n\u001b[?2004l\r"]
[1292.307191, "o", "\u001b[?2004h> "]
[1292.307365, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1292.30742, "o", "\u001b[?2004h> "]
[1292.307466, "o", "    }\r\n\u001b[?2004l\r"]
[1292.307518, "o", "\u001b[?2004h> "]
[1292.30769, "o", "    return entries, nil\r\n\u001b[?2004l\r"]
[1292.307745, "o", "\u001b[?2004h> }\r\n"]
[1292.307799, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1292.307855, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.307909, "o", "> "]
[1292.308245, "o", "func saveRegistry(entries []*RegistryEntry) error {\r\n\u001b[?2004l\r"]
[1292.308307, "o", "\u001b[?2004h> "]
[1292.308685, "o", "    if err := os.MkdirAll(\".mlpipe\", 0755); err != nil {\r\n\u001b[?2004l\r"]
[1292.30874, "o", "\u001b[?2004h> "]
[1292.308883, "o", "        return err\r\n\u001b[?2004l\r"]
[1292.308938, "o", "\u001b[?2004h> "]
[1292.309002, "o", "    }\r\n\u001b[?2004l\r"]
[1292.309057, "o", "\u001b[?2004h> "]
[1292.309427, "o", "    data, err := json.MarshalIndent(entries, \"\", \"  \")\r\n\u001b[?2004l\r"]
[1292.309485, "o", "\u001b[?2004h> "]
[1292.309628, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1292.309683, "o", "\u001b[?2004h> "]
[1292.309829, "o", "        return err\r\n\u001b[?2004l\r"]
[1292.309885, "o", "\u001b[?2004h> "]
[1292.309937, "o", "    }\r\n\u001b[?2004l\r"]
[1292.309993, "o", "\u001b[?2004h> "]
[1292.310351, "o", "    return os.WriteFile(registryPath(), data, 0644)\r\n\u001b[?2004l\r"]
[1292.310382, "o", "\u001b[?2004h"]
[1292.310457, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.310514, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.310568, "o", "> "]
[1292.311024, "o", "func listRegistry(name, stage, tag string) ([]*RegistryEntry, error) {\r\n\u001b[?2004l\r"]
[1292.31108, "o", "\u001b[?2004h> "]
[1292.311327, "o", "    entries, err := loadRegistry()\r\n\u001b[?2004l\r"]
[1292.311392, "o", "\u001b[?2004h> "]
[1292.311533, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1292.311587, "o", "\u001b[?2004h> "]
[1292.311756, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1292.311784, "o", "\u001b[?2004h"]
[1292.312017, "o", "> "]
[1292.312175, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     filtered := []*RegistryEntry{}\r\n\u001b[?2004l\r"]
[1292.312306, "o", "\u001b[?2004h"]
[1292.312409, "o", "> "]
[1292.312507, "o", "    for _, e := range entries {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.312804, "o", "        if name != \"\" && e.Name != name {\r\n\u001b[?2004l\r"]
[1292.312901, "o", "\u001b[?2004h"]
[1292.312992, "o", "> "]
[1292.313081, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.313171, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.313276, "o", "> "]
[1292.313522, "o", "        if stage != \"\" && e.Stage != stage {\r\n\u001b[?2004l\r"]
[1292.313608, "o", "\u001b[?2004h"]
[1292.313694, "o", "> "]
[1292.313782, "o", "            continue\r\n\u001b[?2004l\r"]
[1292.313876, "o", "\u001b[?2004h> "]
[1292.313964, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.314069, "o", "        if tag != \"\" {\r\n\u001b[?2004l\r"]
[1292.31415, "o", "\u001b[?2004h> "]
[1292.314326, "o", "            found := false\r\n\u001b[?2004l\r"]
[1292.314416, "o", "\u001b[?2004h> "]
[1292.314629, "o", "            for _, t := range e.Tags {\r\n\u001b[?2004l\r"]
[1292.314709, "o", "\u001b[?2004h> "]
[1292.314844, "o", "                if t == tag {\r\n\u001b[?2004l\r"]
[1292.31494, "o", "\u001b[?2004h"]
[1292.315035, "o", "> "]
[1292.315125, "o", "                    found = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.315252, "o", "                    break\r\n\u001b[?2004l\r"]
[1292.315279, "o", "\u001b[?2004h> "]
[1292.315389, "o", "                }\r\n\u001b[?2004l\r"]
[1292.315476, "o", "\u001b[?2004h"]
[1292.31556, "o", ">             }\r\n\u001b[?2004l\r"]
[1292.315594, "o", "\u001b[?2004h> "]
[1292.315708, "o", "            if !found {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.315795, "o", "> "]
[1292.315881, "o", "                continue\r\n\u001b[?2004l\r"]
[1292.315968, "o", "\u001b[?2004h> "]
[1292.316055, "o", "            }\r\n\u001b[?2004l\r"]
[1292.316142, "o", "\u001b[?2004h> "]
[1292.316176, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.316367, "o", "        filtered = append(filtered, e)\r\n\u001b[?2004l\r"]
[1292.316453, "o", "\u001b[?2004h"]
[1292.316487, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.31678, "o", "    sort.Slice(filtered, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[1292.316878, "o", "\u001b[?2004h> "]
[1292.317081, "o", "        if filtered[i].Name != filtered[j].Name {\r\n\u001b[?2004l\r"]
[1292.31717, "o", "\u001b[?2004h"]
[1292.317273, "o", "> "]
[1292.317413, "o", "            return filtered[i].Name < filtered[j].Name\r\n\u001b[?2004l\r"]
[1292.317499, "o", "\u001b[?2004h"]
[1292.317533, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.317654, "o", "> "]
[1292.317866, "o", "        return filtered[i].Version > filtered[j].Version\r\n\u001b[?2004l\r"]
[1292.317952, "o", "\u001b[?2004h> "]
[1292.318038, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.318116, "o", "    return filtered, nil\r\n\u001b[?2004l\r"]
[1292.318206, "o", "\u001b[?2004h> "]
[1292.318309, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.318631, "o", "func registryInfo(name string, version int) (*RegistryEntry, error) {\r\n\u001b[?2004l\r"]
[1292.318724, "o", "\u001b[?2004h"]
[1292.31881, "o", "> "]
[1292.318904, "o", "    entries, err := loadRegistry()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.319014, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1292.319106, "o", "\u001b[?2004h> "]
[1292.319192, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1292.319307, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.319397, "o", "> "]
[1292.319519, "o", "    for _, e := range entries {\r\n\u001b[?2004l\r"]
[1292.319675, "o", "\u001b[?2004h> "]
[1292.319836, "o", "        if e.Name == name && e.Version == version {\r\n\u001b[?2004l\r"]
[1292.319935, "o", "\u001b[?2004h> "]
[1292.320032, "o", "            return e, nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.320131, "o", "> "]
[1292.320169, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }"]
[1292.320308, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.320606, "o", "    return nil, fmt.Errorf(\"model not found: %s:%d\", name, version)\r\n\u001b[?2004l\r"]
[1292.320704, "o", "\u001b[?2004h> "]
[1292.320805, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.32119, "o", "func promoteModel(name string, version int, targetStage string) (*RegistryEntry, string, string, error) {\r\n\u001b[?2004l\r"]
[1292.321307, "o", "\u001b[?2004h> "]
[1292.32158, "o", "    valid := map[string]bool{\"staging\": true, \"production\": true, \"archived\": true}\r\n\u001b[?2004l\r"]
[1292.321676, "o", "\u001b[?2004h> "]
[1292.321741, "o", "    if !valid[targetStage] {\r\n\u001b[?2004l\r"]
[1292.321805, "o", "\u001b[?2004h> "]
[1292.322178, "o", "        return nil, \"\", \"\", fmt.Errorf(\"invalid promotion: invalid target stage %q\", targetStage)\r\n\u001b[?2004l\r"]
[1292.322268, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.322338, "o", "> "]
[1292.322435, "o", "    entries, err := loadRegistry()\r\n\u001b[?2004l\r"]
[1292.322505, "o", "\u001b[?2004h> "]
[1292.322572, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.322637, "o", "> "]
[1292.322732, "o", "        return nil, \"\", \"\", err\r\n\u001b[?2004l\r"]
[1292.322795, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1292.322837, "o", "\u001b[?2004h> "]
[1292.322959, "o", "    var entry *RegistryEntry\r\n\u001b[?2004l\r"]
[1292.32302, "o", "\u001b[?2004h> "]
[1292.323134, "o", "    for _, e := range entries {\r\n\u001b[?2004l\r"]
[1292.3232, "o", "\u001b[?2004h> "]
[1292.323391, "o", "        if e.Name == name && e.Version == version {\r\n\u001b[?2004l\r"]
[1292.323452, "o", "\u001b[?2004h> "]
[1292.323525, "o", "            entry = e\r\n\u001b[?2004l\r"]
[1292.323586, "o", "\u001b[?2004h> "]
[1292.323643, "o", "            break\r\n\u001b[?2004l\r"]
[1292.323703, "o", "\u001b[?2004h> "]
[1292.323761, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.323817, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.323925, "o", "    if entry == nil {\r\n\u001b[?2004l\r"]
[1292.323987, "o", "\u001b[?2004h> "]
[1292.324296, "o", "        return nil, \"\", \"\", fmt.Errorf(\"model not found: %s:%d\", name, version)\r\n\u001b[?2004l\r"]
[1292.32436, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1292.32442, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1292.324478, "o", "\u001b[?2004h> "]
[1292.32457, "o", "    prevStage := entry.Stage\r\n\u001b[?2004l\r"]
[1292.324632, "o", "\u001b[?2004h> "]
[1292.32485, "o", "    if !validPromotionTransition(prevStage, targetStage) {\r\n\u001b[?2004l\r"]
[1292.324928, "o", "\u001b[?2004h> "]
[1292.325328, "o", "        return nil, \"\", \"\", fmt.Errorf(\"invalid promotion: cannot promote from %s to %s\", prevStage, targetStage)\r\n\u001b[?2004l\r"]
[1292.325408, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1292.325469, "o", "\u001b[?2004h> "]
[1292.325546, "o", "    if targetStage == \"production\" {\r\n\u001b[?2004l\r"]
[1292.325605, "o", "\u001b[?2004h> "]
[1292.325693, "o", "        if entry.PromotionRules != nil {\r\n\u001b[?2004l\r"]
[1292.325753, "o", "\u001b[?2004h> "]
[1292.325983, "o", "            if rules, ok := entry.PromotionRules[targetStage].(map[string]interface{}); ok {\r\n\u001b[?2004l\r"]
[1292.326047, "o", "\u001b[?2004h> "]
[1292.32619, "o", "                for metricName, thresholdVal := range rules {\r\n\u001b[?2004l\r"]
[1292.326262, "o", "\u001b[?2004h> "]
[1292.326414, "o", "                    metricValue, ok := entry.Metrics[metricName]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.326483, "o", "> "]
[1292.326553, "o", "                    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.326648, "o", "                        continue\r\n\u001b[?2004l\r"]
[1292.32672, "o", "\u001b[?2004h> "]
[1292.32678, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.326918, "o", "                    mv, ok := toFloat64(metricValue)\r\n\u001b[?2004l\r"]
[1292.326978, "o", "\u001b[?2004h> "]
[1292.32704, "o", "                    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.327153, "o", "                        continue\r\n\u001b[?2004l\r"]
[1292.327214, "o", "\u001b[?2004h> "]
[1292.327285, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.327443, "o", "                    tv, ok := toFloat64(thresholdVal)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.327513, "o", "> "]
[1292.327572, "o", "                    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.327667, "o", "                        continue\r\n\u001b[?2004l\r"]
[1292.327726, "o", "\u001b[?2004h> "]
[1292.327785, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.327883, "o", "                    if mv < tv {\r\n\u001b[?2004l\r"]
[1292.32794, "o", "\u001b[?2004h> "]
[1292.328279, "o", "                        return nil, prevStage, targetStage, fmt.Errorf(\"metric %s (%v) below threshold (%v)\", metricName, mv, tv)\r\n\u001b[?2004l\r"]
[1292.328341, "o", "\u001b[?2004h> "]
[1292.328398, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.328455, "o", "                }\r\n\u001b[?2004l\r"]
[1292.328514, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[1292.328571, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1292.328626, "o", "\u001b[?2004h> "]
[1292.328715, "o", "        for _, e := range entries {\r\n\u001b[?2004l\r"]
[1292.328772, "o", "\u001b[?2004h> "]
[1292.328977, "o", "            if e.Name == name && e.Stage == \"production\" && e.Version != version {\r\n\u001b[?2004l\r"]
[1292.329041, "o", "\u001b[?2004h> "]
[1292.329111, "o", "                e.Stage = \"archived\"\r\n\u001b[?2004l\r"]
