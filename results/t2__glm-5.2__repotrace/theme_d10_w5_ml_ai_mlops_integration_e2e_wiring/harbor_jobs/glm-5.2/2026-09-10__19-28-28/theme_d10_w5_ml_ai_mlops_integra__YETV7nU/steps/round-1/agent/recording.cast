[1902.34212, "o", "\t\t\tvalues[i] = X[i][j]\r\n\t\t}\r\n\t\tsorted := uniqueFloats(values)\r\n\t\tsort.Float64s(sorted)\r\n\t\tfor s := 0; s < len(sorted)-1; s++ {\r\n\t\t\tthreshold := (sorted[s] + sorted[s+1]) / 2\r\n\t\t\tleftIdx := []int{}\r\n"]
[1902.342191, "o", "\t\t\trightIdx := []int{}\r\n\t\t\tfor i := 0; i < len(X); i++ {\r\n\t\t\t\tif X[i][j] <= threshold {\r\n\t\t\t\t\tleftIdx = append(leftIdx, i)\r\n\t\t\t\t} else {\r\n\t\t\t\t\trightIdx = append(rightIdx, i)\r\n\t\t\t\t"]
