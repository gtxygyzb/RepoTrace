[10324.087502, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[10324.087573, "o", "\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\ntype RegistryEntry struct {\r\n\tName           string                 `json:\"name\"`\r\n\tVersion        int                    `json:\"version\"`\r\n\tStage          string                 `json:\"stage\"`\r\n\tTags           []string               `json:\"tags\"`\r\n"]
[10324.08766, "o", "\tMetrics        map[string]interface{} `json:\"metrics\"`\r\n\tHyperparams    map[string]interface{} `json:\"hyperparams\"`\r\n\tArtifactRefs   map[string]string      `json:\"artifact_refs\"`\r\n\tPromotionRules map[string]interface{} `json:\"promotion_rules\"`\r\n\tRegisteredAt   string                 `json:\"registered_at\"`\r\n}\r\n\r\nfunc executeRegister(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tmodelVal := inputs[\"model\"]\r\n\tif modelVal == nil || modelVal.Model == nil {\r\n\t\treturn nil, fmt.Errorf(\"register stage %q requires model input\", stage.Name)\r\n\t}\r\n\treportVal := inputs[\"report\"]\r\n\tif reportVal == nil || reportVal.Report == nil {\r\n"]
[10324.087729, "o", "\t\treturn nil, fmt.Errorf(\"register stage %q requires report input\", stage.Name)\r\n\t}\r\n\r\n\tname, ok := getString(params, \"model_name\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"register stage %q requires model_name\", stage.Name)\r\n\t}\r\n\ttags, _ := getStringSlice(params, \"tags\")\r\n\tif tags == nil {\r\n\t\ttags = []string{}\r\n\t}\r\n\t"]
[10324.087795, "o", "stageName, _ := getString(params, \"stage\")\r\n\tif stageName == \"\" {\r\n\t\tstageName = \"staging\"\r\n\t}\r\n\tif stageName != \"staging\" && stageName != \"production\" {\r\n\t\treturn nil, fmt.Errorf(\"register stage %q invalid stage %q\", stage.Name, stageName)\r\n\t}\r\n\trules, _ := getMap(params, \"promotion_rules\")\r\n\r\n\tregistry, err := loadRegistry()\r\n\tif err != nil {\r\n"]
[10324.087856, "o", "\t\treturn nil, err\r\n\t}\r\n\tversion := 1\r\n\tfor _, e := range registry {\r\n\t\tif e.Name == name && e.Version >= version {\r\n\t\t\tversion = e.Version + 1\r\n\t\t}\r\n\t}\r\n\r\n\tentry := &RegistryEntry{\r\n"]
[10324.087918, "o", "\t\tName:           name,\r\n\t\tVersion:        version,\r\n\t\tStage:          stageName,\r\n\t\tTags:           tags,\r\n\t\tMetrics:        reportVal.Report.Metrics,\r\n\t\tHyperparams:    modelVal.Model.Hyperparams,\r\n\t\tArtifactRefs:   map[string]string{},\r\n\t\tPromotionRules: rules,\r\n\t\tRegisteredAt:   time.Now().UTC().Format(time.RFC3339),\r\n\t}\r\n\tregistry = append(registry, entry)\r\n"]
[10324.087997, "o", "\tif err := saveRegistry(registry); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\treturn map[string]*ArtifactValue{\"entry\": {Entry: entry}}, nil\r\n}\r\n\r\n"]
[10324.088059, "o", "func registryPath() string {\r\n\treturn filepath.Join(\".mlpipe\", \"registry.json\")\r\n}\r\n\r\nfunc loadRegistry() ([]*RegistryEntry, error) {\r\n\tdata, err := os.ReadFile(registryPath())\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn []*RegistryEntry{}, nil\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\tvar entries []*RegistryEntry\r\n\tif err := json.Unmarshal(data, &entries); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n"]
[10324.088124, "o", "\treturn entries, nil\r\n}\r\n\r\nfunc saveRegistry(entries []*RegistryEntry) error {\r\n\tif err := os.MkdirAll(\".mlpipe\", 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdata, err := json.MarshalIndent(entries, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n"]
[10324.088187, "o", "\treturn os.WriteFile(registryPath(), data, 0644)\r\n}\r\n\r\nfunc listRegistry(name, stage, tag string) ([]*RegistryEntry, error) {\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tfiltered := []*RegistryEntry{}\r\n\tfor _, e := range entries {\r\n\t\t"]
[10324.088285, "o", "if name != \"\" && e.Name != name {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif stage != \"\" && e.Stage != stage {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif tag != \"\" {\r\n\t\t\tfound := false\r\n\t\t\tfor _, t := range e.Tags {\r\n\t\t\t\tif t == tag {\r\n\t\t\t\t\tfound = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n"]
[10324.088358, "o", "\t\t\t}\r\n\t\t\tif !found {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t}\r\n\t\tfiltered = append(filtered, e)\r\n\t}\r\n\tsort.Slice(filtered, func(i, j int) bool {\r\n\t\tif filtered[i].Name != filtered[j].Name {\r\n\t\t\treturn filtered[i].Name < filtered[j].Name\r\n"]
[10324.088424, "o", "\t\t}\r\n\t\treturn filtered[i].Version > filtered[j].Version\r\n\t})\r\n\treturn filtered, nil\r\n}\r\n\r\nfunc registryInfo(name string, version int) (*RegistryEntry, error) {\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tfor _, e := range entries {\r\n"]
[10324.088488, "o", "\t\tif e.Name == name && e.Version == version {\r\n\t\t\treturn e, nil\r\n\t\t}\r\n\t}\r\n\treturn nil, fmt.Errorf(\"model not found: %s:%d\", name, version)\r\n}\r\n\r\nfunc promoteModel(name string, version int, targetStage string) (*RegistryEntry, string, string, error) {\r\n\t"]
[10324.08855, "o", "valid := map[string]bool{\"staging\": true, \"production\": true, \"archived\": true}\r\n\tif !valid[targetStage] {\r\n\t\treturn nil, \"\", \"\", fmt.Errorf(\"invalid promotion: invalid target stage %q\", targetStage)\r\n\t}\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\treturn nil, \"\", \"\", err\r\n\t}\r\n\tvar entry *RegistryEntry\r\n\tfor _, e := range entries {\r\n"]
[10324.088607, "o", "\t\tif e.Name == name && e.Version == version {\r\n\t\t\tentry = e\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif entry == nil {\r\n\t\treturn nil, \"\", \"\", fmt.Errorf(\"model not found: %s:%d\", name, version)\r\n\t}\r\n\r\n"]
[10324.088668, "o", "\tprevStage := entry.Stage\r\n\tif !validPromotionTransition(prevStage, targetStage) {\r\n\t\treturn nil, \"\", \"\", fmt.Errorf(\"invalid promotion: cannot promote from %s to %s\", prevStage, targetStage)\r\n\t}\r\n\r\n\tif targetStage == \"production\" {\r\n\t\tif entry.PromotionRules != nil {\r\n\t\t\tif rules, ok := entry.PromotionRules[targetStage].(map[string]interface{}); ok {\r\n"]
[10324.088728, "o", "\t\t\t\tfor metricName, thresholdVal := range rules {\r\n\t\t\t\t\tmetricValue, ok := entry.Metrics[metricName]\r\n\t\t\t\t\tif !ok {\r\n\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n\t\t\t\t\tmv, ok := toFloat64(metricValue)\r\n\t\t\t\t\tif !ok {\r\n\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n"]
[10324.088789, "o", "\t\t\t\t\ttv, ok := toFloat64(thresholdVal)\r\n\t\t\t\t\tif !ok {\r\n\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif mv < tv {\r\n\t\t\t\t\t\treturn nil, prevStage, targetStage, fmt.Errorf(\"metric %s (%v) below threshold (%v)\", metricName, mv, tv)\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n"]
[10324.088846, "o", "\t\t\t}\r\n\t\t}\r\n\t\tfor _, e := range entries {\r\n\t\t\tif e.Name == name && e.Stage == \"production\" && e.Version != version {\r\n\t\t\t\te.Stage = \"archived\"\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[10324.088911, "o", "\tentry.Stage = targetStage\r\n\tif err := saveRegistry(entries); err != nil {\r\n\t\treturn nil, \"\", \"\", err\r\n\t}\r\n\treturn entry, prevStage, targetStage, nil\r\n}\r\n\r\nfunc validPromotionTransition(from, to string) bool {\r\n\tif from == \"staging\" && to == \"production\" {\r\n\t\treturn true\r\n\t}\r\n"]
[10324.088973, "o", "\tif from == \"production\" && to == \"archived\" {\r\n\t\treturn true\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc compareModels(name string, v1, v2 int) (map[string]interface{}, error) {\r\n\te1, err := registryInfo(name, v1)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\te2, err := registryInfo(name, v2)\r\n"]
[10324.089032, "o", "\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tmetricsDiff := map[string]interface{}{}\r\n\tmetricNames := map[string]bool{}\r\n\tfor k := range e1.Metrics {\r\n\t\tmetricNames[k] = true\r\n\t}\r\n"]
[10324.089089, "o", "\tfor k := range e2.Metrics {\r\n\t\tmetricNames[k] = true\r\n\t}\r\n\tfor k := range metricNames {\r\n\t\tval1, ok1 := e1.Metrics[k]\r\n\t\tmv1, okNum1 := toFloat64(val1)\r\n\t\tval2, ok2 := e2.Metrics[k]\r\n\t\tmv2, okNum2 := toFloat64(val2)\r\n\r\n\t\tvar v1, v2 interface{}\r\n"]
[10324.089148, "o", "\t\tif ok1 && okNum1 {\r\n\t\t\tv1 = mv1\r\n\t\t} else if ok1 {\r\n\t\t\tv1 = val1\r\n"]
