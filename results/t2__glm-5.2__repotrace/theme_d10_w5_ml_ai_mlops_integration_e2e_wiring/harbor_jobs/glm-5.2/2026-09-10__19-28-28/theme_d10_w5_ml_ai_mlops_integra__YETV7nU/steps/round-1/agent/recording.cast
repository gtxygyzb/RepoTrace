[11387.987497, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n"]
[11387.987579, "o", "\t\"math\"\r\n\t\"math/rand\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\ntype Model struct {\r\n\tAlgorithm       string `json:\"algorithm\"`\r\n\tTarget          string\r\n\tFeatures        []string\r\n\tHyperparams     map[string]interface{}\r\n\tClassification  bool\r\n\tLinearWeights   []float64\r\n\tLogisticWeights []float64\r\n\tTree            *TreeNode\r\n\t"]
[11387.987647, "o", "Forest          []*TreeNode\r\n\tBoost           []*BoostedTree\r\n\tKNN             *KNNModel\r\n\tTrainFeatures   [][]float64\r\n\tTrainTarget     []float64\r\n\tEnsembleModels  []string               `json:\"ensemble_models,omitempty\"`\r\n\tModelData       map[string]interface{} `json:\"model_data,omitempty\"`\r\n}\r\n\r\ntype TreeNode struct {\r\n\tIsLeaf      bool\r\n"]
[11387.987705, "o", "\tPrediction  float64\r\n\tProbability float64\r\n\tFeature     int\r\n\tThreshold   float64\r\n\tLeft        *TreeNode\r\n\tRight       *TreeNode\r\n}\r\n\r\ntype BoostedTree struct {\r\n\tTree           *TreeNode\r\n\tLearningRate   float64\r\n"]
[11387.987771, "o", "\tInitPrediction float64\r\n}\r\n\r\ntype KNNModel struct {\r\n\tK              int\r\n\tFeatures       [][]float64\r\n\tTargets        []float64\r\n\tClassification bool\r\n}\r\n\r\nfunc executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tvar ds *Dataset\r\n\tfor _, in := range inputs {\r\n"]
[11387.987832, "o", "\t\tif in != nil && in.Dataset != nil {\r\n\t\t\tds = in.Dataset\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif ds == nil {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires input data\", stage.Name)\r\n\t}\r\n\r\n\talgorithm, ok := getString(params, \"algorithm\")\r\n\tif !ok {\r\n\t\t"]
[11387.987866, "o", "return nil, fmt.Errorf(\"train stage %q requires algorithm\", stage.Name)\r\n\t}\r\n\ttarget, ok := getString(params, \"target\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires target\", stage.Name)\r\n\t}\r\n"]
[11387.987938, "o", "\ttargetVals, err := ds.NumericColumn(target)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tclassification := isBinary01(targetVals)\r\n\tif algorithm == \"linear-regression\" {\r\n\t\tclassification = false\r\n\t}\r\n\tif algorithm == \"logistic-regression\" {\r\n\t\tclassification = true\r\n\t}\r\n\r\n"]
[11387.987994, "o", "\tfeatures, ok := getStringSlice(params, \"features\")\r\n\tif !ok || len(features) == 0 {\r\n\t\tfeatures = []string{}\r\n\t\tfor i, col := range ds.Columns {\r\n\t\t\tif col == target {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif i < len(ds.Types) && ds.Types[i] == \"numeric\" {\r\n"]
[11387.988048, "o", "\t\t\t\tfeatures = append(features, col)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tX, err := ds.featureMatrix(features)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n"]
[11387.988105, "o", "\ty := targetVals\r\n\r\n\thp := getMapDefault(params, \"hyperparams\", map[string]interface{}{})\r\n\tmodel := &Model{Algorithm: algorithm, Target: target, Features: features, Hyperparams: hp, Classification: classification, TrainFeatures: X, TrainTarget: y}\r\n\r\n\tswitch algorithm {\r\n\tcase \"linear-regression\":\r\n\t\tw, err := trainLinearRegression(X, y)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n"]
[11387.988162, "o", "\t\tmodel.LinearWeights = w\r\n\tcase \"logistic-regression\":\r\n\t\tlr := getFloatDefault(hp, \"learning_rate\", 0.01)\r\n\t\tepochs := getIntDefault(hp, \"epochs\", 1000)\r\n\t\tw, err := trainLogisticRegression(X, y, lr, epochs)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tmodel.LogisticWeights = w\r\n"]
[11387.988814, "o", "\u001b[?2004h"]
