[6662.693262, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4"]
[6662.693341, "o", "\t\t\"fmt\"\r\n     5\t\t\"sort\"\r\n     6\t\t\"strings\"\r\n     7\t)\r\n     8\t\r\n     9\ttype PlanStage struct {\r\n    10\t\tType        string            `json:\"type\"`\r\n    11\t\tDependsOn   []string          `json:\"depends_on\"`\r\n    12\t\tInputTypes  map[string]string `json:\"input_types\"`\r\n    13\t\tOutputTypes map[string]string `json:\"output_types\"`\r\n    14\t\tCacheStatus string            `json:\"cache_status\"`\r\n    15\t\tCVPhase     *string           `json:\"cv_phase\"`\r\n    16\t}\r\n"]
[6662.693413, "o", "    17\t\r\n    18\ttype PlanEdge struct {\r\n    19\t\tFrom string `json:\"from\"`\r\n    20\t\tTo   string `json:\"to\"`\r\n    21\t\tPort string `json:\"port\"`\r\n    22\t}\r\n    23\t\r\n    24\ttype PlanOutput struct {\r\n    25\t\tPipeline       string               `json:\"pipeline\"`\r\n    26\t\tMode           string               `json:\"mode\"`"]
[6662.693486, "o", "\r\n    27\t\tCVFolds        int                  `json:\"cv_folds,omitempty\"`\r\n    28\t\tExecutionOrder []string             `json:\"execution_order\"`\r\n    29\t\tStages         map[string]PlanStage `json:\"stages\"`\r\n    30\t\tEdges          []PlanEdge           `json:\"edges\"`\r\n    31\t}\r\n"]
[6662.693546, "o", "    32\t\r\n    33\tfunc buildPlan(config *Config, overrides map[string]string, cv int) (*PlanOutput, error) {\r\n    34\t\tvalid, errs := config.Validate()\r\n    35\t\tif !valid {\r\n    36\t\t\treturn nil, fmt.Errorf(\"invalid pipeline: %s\", errs[0])\r\n    37\t\t}\r\n    38\t\tif cv > 0 {\r\n    39\t\t\tif err := config.validateCV(); err != nil {\r\n    40\t\t\t\treturn nil, err\r\n    41\t\t\t}\r\n    42\t\t}\r\n    43\t\r\n    44"]
[6662.693608, "o", "\t\torder, err := config.topologicalOrder()\r\n    45\t\tif err != nil {\r\n    46\t\t\treturn nil, err\r\n    47\t\t}\r\n    48\t\r\n    49\t\tmode := \"standard\"\r\n    50\t\tif cv > 0 {\r\n    51\t\t\tmode = \"cv\"\r\n    52"]
[6662.693665, "o", "\t\t}\r\n    53\t\r\n    54\t\tpostSplit := map[string]bool{}\r\n    55\t\tsplitName := \"\"\r\n    56\t\tif cv > 0 {\r\n    57\t\t\tsplitName, _ = config.splitStageName()\r\n    58\t\t\tpostSplit = config.postSplitStages(splitName)\r\n    59\t\t}\r\n    60\t\r\n"]
[6662.693726, "o", "    61\t\texecutionOrder := []string{}\r\n    62\t\tif cv > 0 {\r\n    63\t\t\tfor _, name := range order {\r\n    64\t\t\t\tif !postSplit[name] {\r\n    65\t\t\t\t\texecutionOrder = append(executionOrder, name)\r\n    66\t\t\t\t}\r\n    67\t\t\t}\r\n"]
[6662.693807, "o", "    68\t\t\tfor _, name := range order {\r\n    69\t\t\t\tif postSplit[name] {\r\n    70\t\t\t\t\texecutionOrder = append(executionOrder, name)\r\n    71\t\t\t\t}\r\n    72\t\t\t}\r\n    73\t\t} else {\r\n    74\t\t\texecutionOrder = append(executionOrder, order...)\r\n    75\t\t}\r\n    76\t\r\n    77\t\tcacheKeys := map[string]string{}\r\n    78\t\tstages := map[string]PlanStage{}\r\n    79\t"]
[6662.693864, "o", "\tedges := []PlanEdge{}\r\n    80\t\r\n    81\t\tfor _, name := range order {\r\n    82\t\t\tstage, _ := config.stageByName(name)\r\n    83\t\t\tdeps := stage.DependsOn\r\n    84\t\t\tif deps == nil {\r\n    85\t\t\t\tdeps = []string{}\r\n    86\t\t\t}\r\n"]
[6662.693925, "o", "    87\t\r\n    88\t\t\tinputTypes := map[string]string{}\r\n    89\t\t\tfor local, ref := range stage.Inputs {\r\n    90\t\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n    91\t\t\t\tif len(parts) != 2 {\r\n    92\t\t\t\t\tcontinue\r\n    93\t\t\t\t}\r\n    94\t\t\t\trefStage, ok := config.stageByName(parts[0])\r\n    95\t\t\t\tif !ok {\r\n"]
[6662.693983, "o", "    96\t\t\t\t\tcontinue\r\n    97\t\t\t\t}\r\n    98\t\t\t\tinputTypes[local] = outputPortType(refStage.Type, parts[1])\r\n    99\t\t\t\tedges = append(edges, PlanEdge{From: parts[0], To: name, Port: parts[1]})\r\n   100\t\t\t}\r\n   101\t\r\n   102\t\t\toutputTypes := map[string]string{}\r\n   103\t\t\tfor _, port := range validOutputPorts(stage.Type) {\r\n   104\t\t\t\toutputTypes[port] = outputPortType(stage.Type, port)\r\n"]
[6662.694043, "o", "   105\t\t\t}\r\n   106\t\r\n   107\t\t\tcacheStatus := \"unknown\"\r\n   108\t\t\tphase := (*string)(nil)\r\n   109\t\t\tif cv > 0 {\r\n   110\t\t\t\tif postSplit[name] {\r\n   111\t\t\t\t\tphase = strPtr(\"per-fold\")\r\n   112\t\t\t\t} else {\r\n"]
[6662.694101, "o", "   113\t\t\t\t\tphase = strPtr(\"pre-split\")\r\n   114\t\t\t\t}\r\n   115\t\t\t}\r\n   116\t\r\n   117\t\t\tif cv == 0 || !postSplit[name] {\r\n   118\t\t\t\tparams := config.stageParams(name, config.globalParams(overrides))\r\n   119\t\t\t\tinputKeys := map[string]string{}\r\n"]
[6662.694161, "o", "   120\t\t\t\tunknown := false\r\n   121\t\t\t\tfor local, ref := range stage.Inputs {\r\n   122\t\t\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n   123\t\t\t\t\tif len(parts) != 2 {\r\n   124\t\t\t\t\t\tunknown = true\r\n   125\t\t\t\t\t\tbreak\r\n   126\t\t\t\t\t}\r\n   127\t\t\t\t\tkey, ok := cacheKeys[parts[0]]\r\n   128\t\t\t\t\tif !ok || key == \"\" {"]
[6662.694248, "o", "\r\n   129\t\t\t\t\t\tunknown = true\r\n   130\t\t\t\t\t\tbreak\r\n   131\t\t\t\t\t}\r\n   132\t\t\t\t\tinputKeys[local] = key\r\n   133\t\t\t\t}\r\n   134\t\t\t\tif !unknown {\r\n"]
[6662.694316, "o", "   135\t\t\t\t\tkey, err := computeCacheKey(stage, params, inputKeys, -1)\r\n   136\t\t\t\t\tif err == nil {\r\n   137\t\t\t\t\t\tcacheKeys[name] = key\r\n   138\t\t\t\t\t\tif cacheEntryExists(key) {\r\n   139\t\t\t\t\t\t\tcacheStatus = \"hit\"\r\n   140\t\t\t\t\t\t} else {\r\n   141\t\t\t\t\t\t\tcacheStatus = \"miss\"\r\n   142\t\t\t\t\t\t}\r\n"]
[6662.694374, "o", "   143\t\t\t\t\t}\r\n   144\t\t\t\t}\r\n   145\t\t\t}\r\n   146\t\r\n   147\t\t\tstages[name] = PlanStage{\r\n   148\t\t\t\tType:        stage.Type,\r\n   149\t\t\t\tDependsOn:   deps,\r\n   150\t\t\t\tInputTypes:  inputTypes,\r\n   151\t\t\t\tOutputTypes: outputTypes,\r\n   152\t\t\t\tCacheStatus: cacheStatus,\r\n   153"]
[6662.694433, "o", "\t\t\t\tCVPhase:     phase,\r\n   154\t\t\t}\r\n   155\t\t}\r\n   156\t\r\n   157\t\tsort.Slice(edges, func(i, j int) bool {\r\n   158\t\t\tif edges[i].From != edges[j].From {\r\n   159\t\t\t\treturn edges[i].From < edges[j].From\r\n   160\t\t\t}\r\n   161\t\t\tif edges[i].To != edges[j].To {\r\n   162"]
[6662.69449, "o", "\t\t\t\treturn edges[i].To < edges[j].To\r\n   163\t\t\t}\r\n   164\t\t\treturn edges[i].Port < edges[j].Port\r\n   165\t\t})\r\n   166\t\r\n   167\t\treturn &PlanOutput{\r\n   168\t\t"]
[6662.694546, "o", "\tPipeline:       config.Pipeline.Name,\r\n   169\t\t\tMode:           mode,\r\n   170\t\t\tCVFolds:        cv,\r\n   171\t\t\tExecutionOrder: executionOrder,\r\n   172\t\t\tStages:         stages,\r\n   173\t\t\tEdges:          edges,\r\n   174\t\t}, nil\r\n   175\t}\r\n   176\t\r\n"]
[6662.694602, "o", "   177\tfunc outputPortType(stageType, port string) string {\r\n   178\t\tswitch stageType {\r\n   179\t\tcase \"data-source\", \"transform\":\r\n   180\t\t\tif port == \"data\" {\r\n   181\t\t\t\treturn \"dataset\"\r\n   182\t\t\t}\r\n   183\t\tcase \"split\":\r\n   184\t\t\tif port == \"train\" || port == \"test\" {\r\n   185\t"]
[6662.694664, "o", "\t\t\treturn \"dataset\"\r\n   186\t\t\t}\r\n   187\t\tcase \"train\":\r\n   188\t\t\tif port == \"model\" {\r\n   189\t\t\t\treturn \"model\"\r\n   190\t\t\t}\r\n   191\t\t\tif port == \"predictions\" {\r\n   192\t\t\t\treturn \"dataset\"\r\n   193\t\t\t}\r\n   194"]
[6662.694721, "o", "\t\tcase \"evaluate\":\r\n   195\t\t\tif port == \"report\" {\r\n   196\t\t\t\treturn \"report\"\r\n   197\t\t\t}\r\n   198\t\tcase \"register\":\r\n   199\t\t\tif port == \"entry\" {\r\n   200\t\t\t\treturn \"entry\"\r\n   201\t\t\t}\r\n   202"]
[6662.694786, "o", "\t\t}\r\n   203\t\treturn \"unknown\"\r\n   204\t}\r\n   205\t\r\n   206\tfunc strPtr(s string) *string {\r\n"]
[6662.694843, "o", "   207\t\treturn &s\r\n   208\t}\r\n"]
