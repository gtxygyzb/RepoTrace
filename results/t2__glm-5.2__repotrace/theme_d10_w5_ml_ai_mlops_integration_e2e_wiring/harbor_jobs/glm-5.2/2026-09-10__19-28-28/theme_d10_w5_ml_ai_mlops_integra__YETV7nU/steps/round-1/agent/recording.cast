[6692.456024, "o", "Pipeline       string               `json:\"pipeline\"`\r\n    26\t\tMode           string               `json:\"mode\"`\r\n    27\t\tCVFolds        int                  `json:\"cv_folds,omitempty\"`\r\n    28\t\tExecutionOrder []string             `json:\"execution_order\"`\r\n    29\t\tStages         map[string]PlanStage `json:\"stages\"`\r\n    30\t\tEdges          []PlanEdge           `json:\"edges\"`\r\n    31\t}\r\n    32\t\r\n    33\tfunc buildPlan(config *Config, overrides map[string]string, cv int) (*PlanOutput, error) {"]
[6692.456083, "o", "\r\n    34\t\tvalid, errs := config.Validate()\r\n    35\t\tif !valid {\r\n    36\t\t\treturn nil, fmt.Errorf(\"invalid pipeline: %s\", errs[0])\r\n    37\t\t}\r\n    38\t\tif cv > 0 {\r\n    39\t\t\tif err := config.validateCV(); err != nil {\r\n    40\t\t\t\treturn nil, err\r\n    41\t\t\t}\r\n    42\t\t}\r\n    43\t\r\n"]
[6692.456196, "o", "    44\t\torder, err := config.topologicalOrder()\r\n    45\t\tif err != nil {\r\n    46\t\t\treturn nil, err\r\n    47\t\t}\r\n    48\t\r\n    49\t\tmode := \"standard\"\r\n    50\t\tif cv > 0 {\r\n    51\t\t\tmode = \"cv\"\r\n    52\t\t}\r\n    53\t\r\n    54\t\tpostSplit := map[string]bool{}\r\n    55\t\tsplitName := \"\"\r\n    56\t\tif cv > 0 {\r\n    57\t\t\tsplitName, _ = config.splitStageName()\r\n    58\t\t\tpostSplit = config.postSplitStages(splitName)\r\n    59\t\t}\r\n    60"]
[6692.456244, "o", "\t\r\n    61\t\texecutionOrder := []string{}\r\n    62\t\tif cv > 0 {\r\n    63\t\t\tfor _, name := range order {\r\n    64\t\t\t\tif !postSplit[name] {\r\n"]
[6692.456328, "o", "    65\t\t\t\t\texecutionOrder = append(executionOrder, name)\r\n    66\t\t\t\t}\r\n    67\t\t\t}\r\n    68\t\t\tfor _, name := range order {\r\n    69\t\t\t\tif postSplit[name] {\r\n    70\t\t\t\t\texecutionOrder = append(executionOrder, name)\r\n    71\t\t\t\t}\r\n    72\t\t\t}\r\n    73\t\t} else {\r\n    74\t\t\texecutionOrder = append(executionOrder, order...)\r\n    75\t\t}\r\n    76\t\r\n"]
[6692.456386, "o", "    77\t\tcacheKeys := map[string]string{}\r\n    78\t\tstages := map[string]PlanStage{}\r\n    79\t\tedges := []PlanEdge{}\r\n    80\t\r\n    81\t\tfor _, name := range order {\r\n    82\t\t\tstage, _ := config.stageByName(name)\r\n    83\t\t\tdeps := stage.DependsOn\r\n    84\t\t\tif deps == nil {\r\n"]
[6692.456444, "o", "    85\t\t\t\tdeps = []string{}\r\n    86\t\t\t}\r\n    87\t\r\n    88\t\t\tinputTypes := map[string]string{}\r\n    89\t\t\tfor local, ref := range stage.Inputs {\r\n    90\t\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n    91\t\t\t\tif len(parts) != 2 {\r\n"]
[6692.456501, "o", "    92\t\t\t\t\tcontinue\r\n    93\t\t\t\t}\r\n    94\t\t\t\trefStage, ok := config.stageByName(parts[0])\r\n    95\t\t\t\tif !ok {\r\n    96\t\t\t\t\tcontinue\r\n    97\t\t\t\t}\r\n    98\t\t\t\tinputTypes[local] = outputPortType(refStage.Type, parts[1])\r\n    99\t\t\t\tedges = append(edges, PlanEdge{From: parts[0], To: name, Port: parts[1]})\r\n"]
[6692.456559, "o", "   100\t\t\t}\r\n   101\t\r\n   102\t\t\toutputTypes := map[string]string{}\r\n   103\t\t\tfor _, port := range validOutputPorts(stage.Type) {\r\n   104\t\t\t\toutputTypes[port] = outputPortType(stage.Type, port)\r\n   105\t\t\t}\r\n   106\t\r\n   107\t\t\t"]
[6692.456614, "o", "cacheStatus := \"unknown\"\r\n   108\t\t\tphase := (*string)(nil)\r\n   109\t\t\tif cv > 0 {\r\n   110\t\t\t\tif postSplit[name] {\r\n   111\t\t\t\t\tphase = strPtr(\"per-fold\")\r\n   112\t\t\t\t} else {\r\n   113\t\t\t\t\tphase = strPtr(\"pre-split\")\r\n   114\t\t\t\t}\r\n"]
[6692.45668, "o", "   115\t\t\t}\r\n   116\t\r\n   117\t\t\tif cv == 0 || !postSplit[name] {\r\n   118\t\t\t\tparams := config.stageParams(name, config.globalParams(overrides))\r\n"]
[6692.456738, "o", "   119\t\t\t\tinputKeys := map[string]string{}\r\n   120\t\t\t\tunknown := false\r\n   121\t\t\t\tfor local, ref := range stage.Inputs {\r\n   122\t\t\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n   123\t\t\t\t\tif len(parts) != 2 {\r\n   124\t\t\t\t\t\tunknown = true\r\n   125\t\t\t\t\t\tbreak\r\n   126\t\t\t\t\t}\r\n   127\t\t\t\t\tkey, ok := cacheKeys[parts[0]]\r\n   128\t\t\t\t\tif !ok || key == \"\" {\r\n   129\t\t\t\t\t\tunknown = true\r\n   130\t\t\t\t\t\tbreak\r\n"]
[6692.456797, "o", "   131\t\t\t\t\t}\r\n   132\t\t\t\t\tinputKeys[local] = key\r\n   133\t\t\t\t}\r\n   134\t\t\t\tif !unknown {\r\n   135\t\t\t\t\tkey, err := computeCacheKey(stage, params, inputKeys, -1)\r\n   136\t"]
[6692.456853, "o", "\t\t\t\tif err == nil {\r\n   137\t\t\t\t\t\tcacheKeys[name] = key\r\n   138\t\t\t\t\t\tif cacheEntryExists(key) {\r\n   139\t\t\t\t\t\t\tcacheStatus = \"hit\"\r\n   140\t\t\t\t\t\t} else {\r\n   141\t\t\t\t\t\t\tcacheStatus = \"miss\"\r\n"]
[6692.456909, "o", "   142\t\t\t\t\t\t}\r\n   143\t\t\t\t\t}\r\n   144\t\t\t\t}\r\n   145\t\t\t}\r\n   146\t\r\n   147\t\t\tstages[name] = PlanStage{\r\n   148\t\t\t\tType:        stage.Type,\r\n   149\t\t\t\tDependsOn:   deps,\r\n   150\t\t\t\tInputTypes:  inputTypes,\r\n"]
[6692.456963, "o", "   151\t\t\t\tOutputTypes: outputTypes,\r\n   152\t\t\t\tCacheStatus: cacheStatus,\r\n   153\t\t\t\tCVPhase:     phase,\r\n   154\t\t\t}\r\n   155\t\t}\r\n"]
