[11300.209954, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[11300.210037, "o", "\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintError(\"usage: mlpipe <command> [args]\")\r\n"]
[11300.210095, "o", "\t\treturn\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n"]
[11300.210151, "o", "\t\tcmdRun(args)\r\n\tcase \"plan\":\r\n\t\tcmdPlan(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"registry\":\r\n\t\tcmdRegistry(args)\r\n\t"]
[11300.210206, "o", "case \"lineage\":\r\n\t\tcmdLineage(args)\r\n\tcase \"history\":\r\n\t\tcmdHistory(args)\r\n\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n"]
[11300.210308, "o", "\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n\t}\r\n}\r\n"]
[11300.210362, "o", "\r\n"]
[11300.210896, "o", "\u001b[?2004h"]
