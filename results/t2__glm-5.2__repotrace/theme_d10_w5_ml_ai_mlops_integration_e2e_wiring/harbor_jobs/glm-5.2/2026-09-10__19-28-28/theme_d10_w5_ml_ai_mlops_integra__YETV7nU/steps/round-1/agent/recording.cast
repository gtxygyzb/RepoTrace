[10638.930601, "o", "new = '''func promoteModel(name string, version int, targetStage string, force bool) (*RegistryEntry, string, string, []string, error) {\r\n\u001b[?2004l\r"]
[10638.930652, "o", "\u001b[?2004h> "]
[10638.930861, "o", "\\tvalid := map[string]bool{\"staging\": true, \"production\": true, \"archived\": true}\r\n\u001b[?2004l\r"]
[10638.930911, "o", "\u001b[?2004h> "]
[10638.930969, "o", "\\tif !valid[targetStage] {\r\n\u001b[?2004l\r"]
[10638.93102, "o", "\u001b[?2004h> "]
[10638.931279, "o", "\\t\\treturn nil, \"\", \"\", nil, fmt.Errorf(\"invalid promotion: invalid target stage %q\", targetStage)\r\n\u001b[?2004l\r"]
[10638.93133, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
