[1537.324363, "o", ">     }\r\n\u001b[?2004l\r"]
[1537.324419, "o", "\u001b[?2004h> "]
[1537.324543, "o", "    for _, out := range m.Outputs {\r\n\u001b[?2004l\r"]
[1537.324607, "o", "\u001b[?2004h> "]
[1537.324669, "o", "        if !set[out] {\r\n\u001b[?2004l\r"]
[1537.324734, "o", "\u001b[?2004h> "]
[1537.324814, "o", "            set[out] = true\r\n\u001b[?2004l\r"]
[1537.324879, "o", "\u001b[?2004h> "]
[1537.325045, "o", "            collectDescendants(out, artifacts, set)\r\n\u001b[?2004l\r"]
[1537.325123, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1537.325191, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1537.325267, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1537.325314, "o", "\u001b[?2004l\r\u001b[?2004h> "]
