[11863.364844, "o", "\u001b[35m\u001b[Kcache.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc computeCacheKey\u001b[m\u001b[K(stage *StageConfig, params map[string]interface{}, inputKeys map[string]string, fold int) (string, error) {\r\n"]
