[10796.521585, "o", "\r\n    88\t\tif err != nil {\r\n    89\t\t\tif os.IsNotExist(err) {\r\n    90\t\t\t\treturn []*RegistryEntry{}, nil\r\n    91\t\t\t}\r\n    92\t\t\treturn nil, err\r\n    93\t\t}\r\n    94\t\tvar entries []*RegistryEntry\r\n    95\t\tif err := json.Unmarshal(data, &entries); err != nil {\r\n"]
