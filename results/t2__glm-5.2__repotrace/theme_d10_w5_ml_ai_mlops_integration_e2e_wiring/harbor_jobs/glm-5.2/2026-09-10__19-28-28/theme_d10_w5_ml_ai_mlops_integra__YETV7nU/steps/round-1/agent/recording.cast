[6741.351964, "o", "\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc compareModels\u001b[m\u001b[K(name string, v1, v2 int) (map[string]interface{}, error) {\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\te1, err := registryInfo(name, v1)\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn nil, err\r\n"]
[6741.352074, "o", "\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\te2, err := registryInfo(name, v2)\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn nil, err\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmetricsDiff := map[string]interface{}{}\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmetricNames := map[string]bool{}\r\n"]
[6741.352148, "o", "\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k := range e1.Metrics {\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tmetricNames[k] = true\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k := range e2.Metrics {\r\n\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tmetricNames[k] = true\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k := range metricNames {\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tmv1, ok1 := toFloat64(e1.Metrics[k])\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tmv2, ok2 := toFloat64(e2.Metrics[k])\r\n\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif !ok1 || !ok2 {\r\n\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tmetricsDiff[k] = map[string]interface{}{\"v1\": e1.Metrics[k], \"v2\": e2.Metrics[k], \"delta\": nil, \"pct_change\": nil}\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tcontinue\r\n\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K257\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tdelta := mv2 - mv1\r\n\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tvar pct interface{}\r\n\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif mv1 == 0 {\r\n\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tpct = nil\r\n"]
[6741.352236, "o", "\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t} else {\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tpct = delta / math.Abs(mv1) * 100\r\n\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tmetricsDiff[k] = map[string]interface{}{\"v1\": mv1, \"v2\": mv2, \"delta\": delta, \"pct_change\": pct}\r\n\u001b[32m\u001b[K265\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K266\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\thpDiff := map[string]interface{}{}\r\n\u001b[32m\u001b[K268\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\thpNames := map[string]bool{}\r\n\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k := range e1.Hyperparams {\r\n\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\thpNames[k] = true\r\n\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k := range e2.Hyperparams {\r\n"]
