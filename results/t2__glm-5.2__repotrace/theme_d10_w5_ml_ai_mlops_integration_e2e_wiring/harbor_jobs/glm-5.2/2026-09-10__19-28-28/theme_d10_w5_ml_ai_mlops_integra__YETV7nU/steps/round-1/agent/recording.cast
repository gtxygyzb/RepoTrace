[10932.745851, "o", "\t\t\toverrides[k] = v\r\n\t\tdefault:\r\n\t\t\tif configPath == \"\" && !strings.HasPrefix(args[i], \"--\") {\r\n\t\t\t\tconfigPath = args[i]\r\n"]
[10932.745934, "o", "\t\t\t} else {\r\n\t\t\t\tfail(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif configPath == \"\" {\r\n\t\tfail(\"usage: mlpipe validate <config.json> [--param key=value ...]\")\r\n\t\treturn\r\n\t}\r\n"]
[10932.745998, "o", "\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tfail(err.Error())\r\n\t\treturn\r\n\t}\r\n\tif len(overrides) > 0 {\r\n\t\tglobals := config.globalParams(overrides)\r\n\t\tconfig.Pipeline.Params = globals\r\n\t\tfor i := range config.Stages {\r\n\t\t\tconfig.Stages[i].Params = config.stageParams(config.Stages[i].Name, globals)\r\n\t\t}\r\n"]
[10932.746085, "o", "\t}\r\n\tvalid, errors := config.Validate()\r\n\tprintJSON(map[string]interface{}{\"valid\": valid, \"errors\": errors})\r\n}\r\n\r\nfunc cmdRegistry(args []string) {\r\n\tif len(args) < 1 {\r\n"]
[10932.746148, "o", "\t\tprintError(\"usage: mlpipe registry <list|info|promote|compare> [args]\")\r\n\t\treturn\r\n\t}\r\n\tsub := args[0]\r\n\trest := args[1:]\r\n\tswitch sub {\r\n\tcase \"list\":\r\n\t\tcmdRegistryList(rest)\r\n\tcase \"info\":\r\n\t\tcmdRegistryInfo(rest)\r\n\tcase \"promote\":\r\n\t\tcmdRegistryPromote(rest)\r\n\tcase \"compare\":\r\n\t\tcmdRegistryCompare(rest)\r\n\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown registry command: %s\", sub))\r\n"]
[10932.746209, "o", "\t}\r\n}\r\n\r\nfunc cmdRegistryList(args []string) {\r\n\tname, stage, tag := \"\", \"\", \"\"\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--name\" && i+1 < len(args):\r\n\t\t\tname = args[i+1]\r\n\t\t\ti++\r\n"]
[10932.746313, "o", "\t\tcase strings.HasPrefix(args[i], \"--name=\"):\r\n\t\t\tname = strings.TrimPrefix(args[i], \"--name=\")\r\n\t\tcase args[i] == \"--stage\" && i+1 < len(args):\r\n\t\t\tstage = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--stage=\"):\r\n\t\t\tstage = strings.TrimPrefix(args[i], \"--stage=\")\r\n\t\tcase args[i] == \"--tag\" && i+1 < len(args):\r\n\t\t\ttag = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--tag=\"):\r\n\t\t\ttag = strings.TrimPrefix(args[i], \"--tag=\")\r\n\t\tdefault:\r\n"]
[10932.746373, "o", "\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n\tentries, err := listRegistry(name, stage, tag)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n"]
[10932.746483, "o", "\t}\r\n\tout := make([]map[string]interface{}, len(entries))\r\n\tfor i, e := range entries {\r\n\t\tout[i] = map[string]interface{}{\r\n\t\t\t\"name\":          e.Name,\r\n\t\t\t\"version\":       e.Version,\r\n\t\t\t\"stage\":         e.Stage,\r\n\t\t\t\"tags\":          e.Tags,\r\n\t\t\t\"metrics\":       e.Metrics,\r\n\t\t\t\"registered_at\": e.RegisteredAt,\r\n\t\t}\r\n\t}\r\n\tprintJSON(map[string]interface{}{\r\n\t\t\"models\": out,\r\n\t\t\"count\":  len(out),\r\n"]
[10932.746544, "o", "\t})\r\n}\r\n\r\nfunc cmdRegistryInfo(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe registry info <name>:<version>\")\r\n\t\treturn\r\n\t}\r\n\tname, version, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n"]
[10932.746602, "o", "\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tentry, err := registryInfo(name, version)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(entry)\r\n"]
[10932.746664, "o", "}\r\n\r\nfunc cmdRegistryPromote(args []string) {\r\n\tvar positionals []string\r\n\tforce := false\r\n\tfor _, a := range args {\r\n\t\tif a == \"--force\" {\r\n\t\t\tforce = true\r\n\t\t\tcontinue\r\n\t\t}\r\n\t"]
[10932.746722, "o", "\tif strings.HasPrefix(a, \"--\") {\r\n\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", a))\r\n\t\t\treturn\r\n\t\t}\r\n\t\tpositionals = append(positionals, a)\r\n\t}\r\n\tif len(positionals) < 2 {\r\n\t\tprintError(\"usage: mlpipe registry promote <name>:<version> <target_stage> [--force]\")\r\n\t\treturn\r\n"]
[10932.746783, "o", "\t}\r\n\tname, version, ok := splitNameVersion(positionals[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\ttarget := positionals[1]\r\n\tentry, prev, new, warnings, err := promoteModel(name, version, target, force)\r\n\tif err != nil {\r\n"]
