[10933.528506, "o", "e.values[name][port] = val\r\n\t\t\te.outputs[name][port] = id\r\n\t\t\ttyp := val.Type()\r\n\t\t\tsummary := val.Summary()\r\n\t\t\tmeta := &ArtifactMeta{\r\n\t\t\t\tID:        id,\r\n\t\t\t\tStage:     name,\r\n\t\t\t\tPort:      port,\r\n\t\t\t\tType:      typ,\r\n\t\t\t\tSummary:   summary,\r\n\t\t\t\tInputs:    inputIDs,\r\n"]
