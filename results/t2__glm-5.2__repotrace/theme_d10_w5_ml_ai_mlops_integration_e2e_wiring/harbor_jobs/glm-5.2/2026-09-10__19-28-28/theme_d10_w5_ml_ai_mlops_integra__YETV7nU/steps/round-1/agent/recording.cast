[4863.773056, "o", "\u001b[?2004h> "]
[4863.773202, "o", "    cmd := os.Args[1]\r\n\u001b[?2004l\r"]
[4863.773284, "o", "\u001b[?2004h> "]
[4863.773436, "o", "    args := os.Args[2:]\r\n\u001b[?2004l\r"]
[4863.773483, "o", "\u001b[?2004h"]
[4863.773538, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4863.773594, "o", "> "]
[4863.773692, "o", "    switch cmd {\r\n\u001b[?2004l\r"]
[4863.77375, "o", "\u001b[?2004h> "]
[4863.773865, "o", "    case \"run\":\r\n\u001b[?2004l\r"]
[4863.773919, "o", "\u001b[?2004h> "]
[4863.774062, "o", "        cmdRun(args)\r\n\u001b[?2004l\r"]
[4863.774126, "o", "\u001b[?2004h"]
[4863.774182, "o", "> "]
