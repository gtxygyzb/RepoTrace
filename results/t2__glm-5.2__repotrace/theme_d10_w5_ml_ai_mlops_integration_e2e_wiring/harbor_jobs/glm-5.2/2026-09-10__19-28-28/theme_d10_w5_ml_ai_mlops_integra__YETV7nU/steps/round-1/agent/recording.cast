[12102.22253, "o", "   204\t\tfor i := range ds.Rows {\r\n   205\t\t\tmodelPreds := make([]float64, len(models))\r\n   206\t\t\tfor j, m := range models {\r\n   207\t\t\t\tx := X[i]\r\n   208\t\t\t\tmodelPreds[j] = m.PredictBatch([][]float64{x})[0]\r\n   209\t\t\t}\r\n   210\t\t\tif strategy == \"average\" {\r\n   211\t\t\t\tsum := 0.0\r\n   212\t\t\t\tfor _, p := range modelPreds {\r\n   213\t\t\t\t\tsum += p\r\n"]
