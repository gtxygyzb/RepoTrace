[12771.836974, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('train.go')\ns = p.read_text()\nold = '''\\tvar models []*Model\n\\tvar modelRefs []string\n\\tfor local, val := range inputs {\n\\t\\tif !strings.HasPrefix(local, \"models_\") || val == nil || val.Model == nil {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tmodels = append(models, val.Model)\n\\t\\tmodelRefs = append(modelRefs, strings.TrimPrefix(local, \"models_\"))\n\\t}\n'''\nnew = '''\\tvar models []*Model\n\\tvar modelRefs []string\n\\tfor local, val := range inputs {\n\\t\\tif val == nil || val.Model == nil {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif ref, ok := strings.TrimPrefix(local, \"models_\"); ok && local != \"models_\" {\n\\t\\t\\tmodels = append(models, val.Model)\n\\t\\t\\tmodelRefs = append(modelRefs, ref)\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif ref, ok := strings.TrimPrefix(local, \"model_\"); ok && local != \"model_\" {\n\\t\\t\\tmodels = append(models, val.Model)\n\\t\\t\\tmodelRefs = append(modelRefs, ref)\n\\t\\t}\n\\t}\n'''\nif old not in s:\n    raise SystemExit('ensemble runtime model key block not found')\np.write_text(s.replace(old, new))"]
