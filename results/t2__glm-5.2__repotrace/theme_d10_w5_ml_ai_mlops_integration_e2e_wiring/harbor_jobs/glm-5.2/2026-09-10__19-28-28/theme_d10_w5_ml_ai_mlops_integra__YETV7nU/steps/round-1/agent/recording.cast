[10716.130475, "o", "   161\tfunc promoteModel(name string, version int, targetStage string, force bool) (*RegistryEntry, string, string, []string, error) {\r\n   162\t\tvalid := map[string]bool{\"staging\": true, \"production\": true, \"archived\": true}\r\n   163\t\tif !valid[targetStage] {\r\n   164\t\t\treturn nil, \"\", \"\", nil, fmt.Errorf(\"invalid promotion: invalid target stage %q\", targetStage)\r\n"]
[10716.130554, "o", "   165\t\t}\r\n   166\t\tentries, err := loadRegistry()\r\n   167\t\tif err != nil {\r\n   168\t\t\treturn nil, \"\", \"\", nil, err\r\n   169\t\t}\r\n   170\t\tvar entry *RegistryEntry\r\n"]
[10716.130616, "o", "   171\t\tfor _, e := range entries {\r\n   172\t\t\tif e.Name == name && e.Version == version {\r\n   173\t\t\t\tentry = e\r\n   174\t\t\t\tbreak\r\n   175\t\t\t}\r\n   176\t\t}\r\n   177\t\tif entry == nil {\r\n   178\t\t\treturn nil, \"\", \"\", nil, fmt.Errorf(\"model not found: %s:%d\", name, version)\r\n   179\t\t}\r\n   180\t\r\n   181\t"]
[10716.13068, "o", "\tprevStage := entry.Stage\r\n   182\t\tif !validPromotionTransition(prevStage, targetStage) {\r\n   183\t\t\treturn nil, \"\", \"\", nil, fmt.Errorf(\"invalid promotion: cannot promote from %s to %s\", prevStage, targetStage)\r\n   184\t\t}\r\n   185\t\r\n   186\t\twarnings := []string{}\r\n   187\t\tif targetStage == \"production\" {\r\n   188\t\t\tif entry.PromotionRules != nil {\r\n"]
[10716.130742, "o", "   189\t\t\t\tif rules, ok := entry.PromotionRules[targetStage].(map[string]interface{}); ok {\r\n   190\t\t\t\t\tfor metricName, thresholdVal := range rules {\r\n   191\t\t\t\t\t\tmetricValue, ok := entry.Metrics[metricName]\r\n   192\t\t\t\t\t\tif !ok {\r\n   193\t\t\t\t\t\t\tcontinue\r\n   194\t\t\t\t\t\t}\r\n   195\t\t\t\t\t\tmv, ok := toFloat64(metricValue)\r\n   196\t\t\t\t\t\tif !ok {\r\n   197\t\t\t\t\t\t\tcontinue\r\n   198\t\t\t\t\t\t}\r\n"]
[10716.130799, "o", "   199\t\t\t\t\t\ttv, ok := toFloat64(thresholdVal)\r\n   200\t\t\t\t\t\tif !ok {\r\n   201\t\t\t\t\t\t\tcontinue\r\n   202\t\t\t\t\t\t}\r\n   203\t\t\t\t\t\tif mv < tv {\r\n   204\t\t\t\t\t\t\twarning := fmt.Sprintf(\"metric %s (%.4f) below threshold (%.4f)\", metricName, mv, tv)\r\n   205\t\t\t\t\t\t\tif !force {\r\n"]
[10716.130862, "o", "   206\t\t\t\t\t\t\t\treturn nil, prevStage, targetStage, nil, fmt.Errorf(\"%s\", warning)\r\n   207\t\t\t\t\t\t\t}\r\n   208\t\t\t\t\t\t\twarnings = append(warnings, warning)\r\n   209\t\t\t\t\t\t}\r\n   210\t\t\t\t\t}\r\n   211\t\t\t\t}\r\n   212\t\t\t}\r\n   213\t"]
[10716.130923, "o", "\t\tfor _, e := range entries {\r\n   214\t\t\t\tif e.Name == name && e.Stage == \"production\" && e.Version != version {\r\n   215\t\t\t\t\te.Stage = \"archived\"\r\n   216\t\t\t\t}\r\n"]
[10716.130982, "o", "   217\t\t\t}\r\n   218\t\t}\r\n   219\t\r\n   220\t\tentry.Stage = targetStage\r\n   221\t\tif err := saveRegistry(entries); err != nil {\r\n   222\t\t\treturn nil, \"\", \"\", nil, err\r\n   223\t\t}\r\n   224\t\treturn entry, prevStage, targetStage, warnings, nil\r\n   225\t}\r\n"]
