[9391.512882, "o", "func parseRunArgs(args []string) (string, map[string]string, int, bool, error) {\r\n\tconfigPath := \"\"\r\n\toverrides := map[string]string{}\r\n\tcv := 0\r\n\tnoCache := false\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n"]
[9391.51299, "o", "\t\tcase args[i] == \"--cv\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn \"\", nil, 0, false, fmt.Errorf(\"--cv requires a value\")\r\n\t\t\t}\r\n\t\t\tk, err := strconv.Atoi(args[i+1])\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn \"\", nil, 0, false, fmt.Errorf(\"invalid cv folds: %s\", args[i+1])\r\n\t\t\t}\r\n\t\t\tif k < 2 {\r\n\t\t\t\treturn \"\", nil, 0, false, fmt.Errorf(\"cv folds must be >= 2\")\r\n"]
[9391.513076, "o", "\t\t\t}\r\n\t\t\tcv = k\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--cv=\"):\r\n\t\t\tval := strings.TrimPrefix(args[i], \"--cv=\")\r\n"]
[9391.513153, "o", "\t\t\tk, err := strconv.Atoi(val)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn \"\", nil, 0, false, fmt.Errorf(\"invalid cv folds: %s\", val)\r\n\t\t\t}\r\n\t\t\tif k < 2 {\r\n\t\t\t\treturn \"\", nil, 0, false, fmt.Errorf(\"cv folds must be >= 2\")\r\n\t\t\t}\r\n\t\t\tcv = k\r\n\t\tcase args[i] == \"--no-cache\":\r\n\t\t\tnoCache = true\r\n\t\tcase args[i] == \"--param\":\r\n\t\t\tif i+1 >= len(args) {\r\n"]
[9391.513267, "o", "\t\t\t\treturn \"\", nil, 0, false, fmt.Errorf(\"--param requires key=value\")\r\n\t\t\t}\r\n\t\t\tkv := args[i+1]\r\n\t\t\ti++\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\treturn \"\", nil, 0, false, fmt.Errorf(\"--param requires key=value\")\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tcase strings.HasPrefix(args[i], \"--param=\"):\r\n\t\t\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n"]
[9391.513346, "o", "\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\treturn \"\", nil, 0, false, fmt.Errorf(\"--param requires key=value\")\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tdefault:\r\n\t\t\tif configPath == \"\" && !strings.HasPrefix(args[i], \"--\") {\r\n\t\t\t\tconfigPath = args[i]\r\n"]
[9391.513414, "o", "\t\t\t} else {\r\n\t\t\t\treturn \"\", nil, 0, false, fmt.Errorf(\"unknown flag: %s\", args[i])\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif configPath == \"\" {\r\n\t\treturn \"\", nil, 0, false, fmt.Errorf(\"usage: mlpipe run <config.json> [--param key=value ...] [--cv K] [--no-cache]\")\r\n"]
[9391.513481, "o", "\t}\r\n\treturn configPath, overrides, cv, noCache, nil\r\n}\r\n\r\nfunc parsePlanArgs(args []string) (string, map[string]string, int, error) {\r\n"]
