[10933.822862, "o", "\t}\r\n\treturn os.WriteFile(artifactsPath(), data, 0644)\r\n}\r\n\r\nfunc saveRunAny(pipelineName string, run interface{}) error {\r\n\tdir := filepath.Join(\".mlpipe\", \"runs\")\r\n\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tname := safeFileName(pipelineName)\r\n\tif name == \"\" {\r\n\t\tname = \"pipeline\"\r\n\t"]
