[10352.161689, "o", "sed -n '1,220p' register.go\r\n\u001b[?2004l\r"]
[10352.164593, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\""]
[10352.16468, "o", "\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\ntype RegistryEntry struct {\r\n"]
[10352.164743, "o", "\tName           string                 `json:\"name\"`\r\n\tVersion        int                    `json:\"version\"`\r\n\tStage          string                 `json:\"stage\"`\r\n\tTags           []string               `json:\"tags\"`\r\n\tMetrics        map[string]interface{} `json:\"metrics\"`\r\n\tHyperparams    map[string]interface{} `json:\"hyperparams\"`\r\n\tArtifactRefs   map[string]string      `json:\"artifact_refs\"`\r\n\tPromotionRules map[string]interface{} `json:\"promotion_rules\"`\r\n\tRegisteredAt   string                 `json:\"registered_at\"`\r\n}\r\n\r\nfunc executeRegister(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tmodelVal := inputs[\"model\"]\r\n\tif modelVal == nil || modelVal.Model == nil {\r\n\t\treturn nil, fmt.Errorf(\"register stage %q requires model input\", stage.Name)\r\n\t}\r\n\treportVal := inputs[\"report\"]\r\n"]
[10352.16481, "o", "\tif reportVal == nil || reportVal.Report == nil {\r\n\t\treturn nil, fmt.Errorf(\"register stage %q requires report input\", stage.Name)\r\n\t}\r\n\r\n\tname, ok := getString(params, \"model_name\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"register stage %q requires model_name\", stage.Name)\r\n\t}\r\n\ttags, _ := getStringSlice(params, \"tags\")\r\n\tif tags == nil {\r\n\t\t"]
[10352.164869, "o", "tags = []string{}\r\n\t}\r\n\tstageName, _ := getString(params, \"stage\")\r\n\tif stageName == \"\" {\r\n\t\tstageName = \"staging\"\r\n\t}\r\n\tif stageName != \"staging\" && stageName != \"production\" {\r\n\t\treturn nil, fmt.Errorf(\"register stage %q invalid stage %q\", stage.Name, stageName)\r\n\t}\r\n\t"]
[10352.164922, "o", "rules, _ := getMap(params, \"promotion_rules\")\r\n\r\n\tregistry, err := loadRegistry()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tversion := 1\r\n\tfor _, e := range registry {\r\n\t\tif e.Name == name && e.Version >= version {\r\n\t\t\tversion = e.Version + 1\r\n"]
[10352.164975, "o", "\t\t}\r\n\t}\r\n\r\n\tentry := &RegistryEntry{\r\n\t\tName:           name,\r\n\t\tVersion:        version,\r\n\t\tStage:          stageName,\r\n\t\tTags:           tags,\r\n\t\tMetrics:        reportVal.Report.Metrics,\r\n"]
[10352.165028, "o", "\t\tHyperparams:    modelVal.Model.Hyperparams,\r\n\t\tArtifactRefs:   map[string]string{},\r\n\t\tPromotionRules: rules,\r\n\t\tRegisteredAt:   time.Now().UTC().Format(time.RFC3339),\r\n\t}\r\n\tregistry = append(registry, entry)\r\n\tif err := saveRegistry(registry); err != nil {\r\n\t\t"]
[10352.165079, "o", "return nil, err\r\n\t}\r\n\r\n\treturn map[string]*ArtifactValue{\"entry\": {Entry: entry}}, nil\r\n}\r\n\r\nfunc registryPath() string {\r\n\treturn filepath.Join(\".mlpipe\", \"registry.json\")\r\n"]
[10352.165129, "o", "}\r\n\r\nfunc loadRegistry() ([]*RegistryEntry, error) {\r\n\tdata, err := os.ReadFile(registryPath())\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn []*RegistryEntry{}, nil\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}"]
[10352.165181, "o", "\r\n\tvar entries []*RegistryEntry\r\n\tif err := json.Unmarshal(data, &entries); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn entries, nil\r\n}\r\n\r\n"]
[10352.165265, "o", "func saveRegistry(entries []*RegistryEntry) error {\r\n\tif err := os.MkdirAll(\".mlpipe\", 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdata, err := json.MarshalIndent(entries, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(registryPath(), data, 0644)\r\n}\r\n\r\nfunc listRegistry(name, stage, tag string) ([]*RegistryEntry, error) {\r\n\tentries, err := loadRegistry()\r\n"]
[10352.165323, "o", "\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tfiltered := []*RegistryEntry{}\r\n\tfor _, e := range entries {\r\n\t\tif name != \"\" && e.Name != name {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[10352.165375, "o", "\t\tif stage != \"\" && e.Stage != stage {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif tag != \"\" {\r\n\t\t\tfound := false\r\n\t\t\tfor _, t := range e.Tags {\r\n"]
[10352.165426, "o", "\t\t\t\tif t == tag {\r\n\t\t\t\t\tfound = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !found {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
[10352.165481, "o", "\t\t}\r\n\t\tfiltered = append(filtered, e)\r\n\t}\r\n\tsort.Slice(filtered, func(i, j int) bool {\r\n\t\tif filtered[i].Name != filtered[j].Name {\r\n\t\t\treturn filtered[i].Name < filtered[j].Name\r\n\t\t}\r\n\t\treturn filtered[i].Version > filtered[j].Version\r\n\t})\r\n"]
[10352.165536, "o", "\treturn filtered, nil\r\n}\r\n\r\nfunc registryInfo(name string, version int) (*RegistryEntry, error) {\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tfor _, e := range entries {\r\n\t\tif e.Name == name && e.Version == version {\r\n"]
[10352.165603, "o", "\t\t\treturn e, nil\r\n\t\t}\r\n\t}\r\n\treturn nil, fmt.Errorf(\"model not found: %s:%d\", name, version)\r\n}\r\n\r\nfunc promoteModel(name string, version int, targetStage string) (*RegistryEntry, string, string, error) {\r\n\tvalid := map[string]bool{\"staging\": true, \"production\": true, \"archived\": true}\r\n\tif !valid[targetStage] {\r\n\t"]
[10352.165656, "o", "\treturn nil, \"\", \"\", fmt.Errorf(\"invalid promotion: invalid target stage %q\", targetStage)\r\n\t}\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\treturn nil, \"\", \"\", err\r\n\t}\r\n\tvar entry *RegistryEntry\r\n\tfor _, e := range entries {\r\n\t\tif e.Name == name && e.Version == version {\r\n"]
[10352.165709, "o", "\t\t\tentry = e\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif entry == nil {\r\n\t\treturn nil, \"\", \"\", fmt.Errorf(\"model not found: %s:%d\", name, version)\r\n\t}\r\n\r\n\tprevStage := entry.Stage\r\n"]
[10352.165764, "o", "\tif !validPromotionTransition(prevStage, targetStage) {\r\n\t\treturn nil, \"\", \"\", fmt.Errorf(\"invalid promotion: cannot promote from %s to %s\", prevStage, targetStage)\r\n\t}\r\n\r\n\tif targetStage == \"production\" {\r\n\t\tif entry.PromotionRules != nil {\r\n\t\t\tif rules, ok := entry.PromotionRules[targetStage].(map[string]interface{}); ok {\r\n\t\t\t\tfor metricName, thresholdVal := range rules {\r\n"]
[10352.165826, "o", "\t\t\t\t\tmetricValue, ok := entry.Metrics[metricName]\r\n\t\t\t\t\tif !ok {\r\n\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n\t\t\t\t\tmv, ok := toFloat64(metricValue)\r\n\t\t\t\t\tif !ok {\r\n"]
[10352.165876, "o", "\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n\t\t\t\t\ttv, ok := toFloat64(thresholdVal)\r\n\t\t\t\t\tif !ok {\r\n\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n"]
[10352.165929, "o", "\t\t\t\t\tif mv < tv {\r\n\t\t\t\t\t\treturn nil, prevStage, targetStage, fmt.Errorf(\"metric %s (%v) below threshold (%v)\", metricName, mv, tv)\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor _, e := range entries {\r\n\t\t\tif e.Name == name && e.Stage == \"production\" && e.Version != version {\r\n"]
[10352.16598, "o", "\t\t\t\te.Stage = \"archived\"\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tentry.Stage = targetStage\r\n\tif err := saveRegistry(entries); err != nil {\r\n\t\treturn nil, \"\", \"\", err\r\n\t}\r\n\treturn entry, prevStage, targetStage, nil\r\n"]
[10352.166028, "o", "}\r\n"]
