[10095.418385, "o", "}\r\n\r\nfunc joinStageNames(stages []StageConfig) string {\r\n\tnames := []string{}\r\n\tfor _, s := range stages {\r\n\t\tnames = append(names, s.Name)\r\n\t}\r\n\treturn strings.Join(names, \", \")\r\n}\r\n\r\nfunc artifactID(pipeline, stage, port string, ts int64) string {\r\n"]
[10095.41852, "o", "\tif pipeline == \"\" {\r\n\t\tpipeline = \"pipeline\"\r\n\t}\r\n\treturn fmt.Sprintf(\"%s-%s-%s-%d\", pipeline, stage, port, ts)\r\n}\r\n\r\nfunc (v *ArtifactValue) Type() string {\r\n\tif v.Dataset != nil {\r\n\t\treturn \"dataset\"\r\n\t}\r\n\tif v.Model != nil {\r\n\t\treturn \"model\"\r\n\t}\r\n\tif v.Report != nil {\r\n\t\treturn \"report\"\r\n\t}\r\n"]
[10095.419039, "o", "\u001b[?2004h"]
[10095.419104, "o", "root@n30009:/tmp/mltest# "]
[10106.654485, "i", "sed -n '447,475p' /app/pipeline.go\n"]
[10106.654799, "o", "sed -n '447,475p' /app/pipeline.go\r\n\u001b[?2004l\r"]
[10106.657967, "o", "func (v *ArtifactValue) Summary() map[string]interface{} {\r\n\tif v.Dataset != nil {\r\n\t\treturn v.Dataset.Summary()\r\n\t}\r\n\tif v.Model != nil {\r\n\t\treturn map[string]interface{}{\r\n\t\t\t\"algorithm\":   v.Model.Algorithm,\r\n\t\t\t\"target\":      v.Model.Target,\r\n\t"]
[10106.658067, "o", "\t\t\"features\":    v.Model.Features,\r\n\t\t\t\"hyperparams\": v.Model.Hyperparams,\r\n\t\t}\r\n\t}\r\n\tif v.Report != nil {\r\n\t\treturn v.Report.Summary()\r\n\t}\r\n\tif v.Entry != nil {\r\n\t\treturn map[string]interface{}{\r\n\t\t\t\"name\":    v.Entry.Name,\r\n\t\t\t\"version\": v.Entry.Version,\r\n\t\t\t\"stage\":   v.Entry.Stage,\r\n\t\t}\r\n\t}\r\n\treturn map[string]interface{}{}\r\n}\r\n\r\n"]
[10106.658132, "o", "func inputDataset(inputs map[string]*ArtifactValue) *Dataset {\r\n\tfor _, in := range inputs {\r\n\t\tif in != nil && in.Dataset != nil {\r\n\t\t\treturn in.Dataset\r\n"]
[10106.658662, "o", "\u001b[?2004h"]
[10106.658722, "o", "root@n30009:/tmp/mltest# "]
[10106.930608, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/app/pipeline.go')\nlines = p.read_text().splitlines()\n# Find the line with \"hyperparams\": m.Hyperparams,\nfor i,l in enumerate(lines):\n    if '\"hyperparams\": m.Hyperparams,' in l:\n        # find the next closing brace line\n        for j in range(i+1, len(lines)):\n            if lines[j].strip() == '}':\n                indent = lines[j].split('}')[0]\n                lines[j:j+1] = [\n                    indent + '}',\n                    indent + 'if len(m.EnsembleModels) > 0 {',\n                    indent + '\\tsummary[\"ensemble_models\"] = m.EnsembleModels',\n                    indent + '}',\n                    indent + 'if m.ModelData != nil {',\n                    indent + '\\tsummary[\"model_data\"] = m.ModelData',\n                    indent + '}',\n                ]\n                break\n        break\nelse:\n    raise SystemExit('hyperparams line not found')\np.write_text('\\n'.join(lines) + '\\n')\nPY\n"]
