[8852.576969, "o", "   197\t\tdfs = func(node string) bool {\r\n   198\t\t\tif color[node] == 1 {\r\n   199\t\t\t\tidx := -1\r\n   200\t\t\t\tfor i, n := range stack {\r\n   201\t\t\t\t\tif n == node {\r\n   202\t\t\t\t\t\tidx = i\r\n   203\t\t\t\t\t\tbreak\r\n   204\t\t\t\t\t}\r\n   205\t\t\t\t}\r\n"]
[8852.577027, "o", "   206\t\t\t\tif idx >= 0 {\r\n   207\t\t\t\t\tcycle = append([]string{}, stack[idx:]...)\r\n   208\t\t\t\t\tcycle = append(cycle, node)\r\n   209\t\t\t\t\tif len(cycle) > 1 && cycle[0] == cycle[len(cycle)-1] {\r\n   210\t\t\t\t\t\tcycle = cycle[:len(cycle)-1]\r\n   211\t\t\t\t\t}\r\n   212\t\t\t\t}\r\n   213\t\t\t\treturn true\r\n"]
