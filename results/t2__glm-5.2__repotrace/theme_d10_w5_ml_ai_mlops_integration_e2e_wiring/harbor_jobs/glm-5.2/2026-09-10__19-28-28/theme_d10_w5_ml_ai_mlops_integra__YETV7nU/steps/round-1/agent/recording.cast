[9501.513027, "o", "# add mergeParams after globalParams\r\n\u001b[?2004l\r"]
[9501.513083, "o", "\u001b[?2004h> "]
[9501.513629, "o", "insert_after = '''func (c *Config) globalParams(overrides map[string]string) map[string]interface{} {\r\n\u001b[?2004l\r"]
[9501.513688, "o", "\u001b[?2004h> "]
