[2910.139102, "o", "   138\t\t\t\t\tStage:     name,\r\n   139\t\t\t\t\tPort:      port,\r\n   140\t\t\t\t\tType:      typ,\r\n   141\t\t\t\t\tSummary:   summary,\r\n   142\t\t\t\t\tInputs:    inputIDs,\r\n   143\t\t\t\t\tOutputs:   []string{},\r\n   144\t\t\t\t\tTimestamp: ts,\r\n   145\t\t\t\t}\r\n"]
[2910.13916, "o", "   146\t\t\t\te.meta[id] = meta\r\n   147\t\t\t\tfor _, inID := range inputIDs {\r\n   148\t\t\t\t\tif parent, ok := e.meta[inID]; ok {\r\n   149\t\t\t\t\t\tparent.Outputs = appendUnique(parent.Outputs, id)\r\n   150\t\t\t\t\t}\r\n   151\t\t\t\t}\r\n   152\t\t\t\trunArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n   153\t\t\t}\r\n   154\t\t}\r\n   155\t"]
