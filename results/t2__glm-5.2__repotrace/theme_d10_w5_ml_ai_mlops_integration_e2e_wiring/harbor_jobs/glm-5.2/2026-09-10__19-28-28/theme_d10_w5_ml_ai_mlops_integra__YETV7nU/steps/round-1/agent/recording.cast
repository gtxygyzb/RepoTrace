[10933.00316, "o", "\tname1, v1, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tname2, v2, ok := splitNameVersion(args[1])\r\n"]
[10933.003252, "o", "\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tif name1 != name2 {\r\n\t\tprintError(\"cannot compare different model names\")\r\n\t\treturn\r\n\t}\r\n\tresult, err := compareModels(name1, v1, v2)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(result)\r\n}\r\n\r\nfunc cmdLineage(args []string) {\r\n\tif len(args) < 2 {\r\n\t"]
