[8828.509782, "o", "\t\t\te.status[name] = \"failed\"\r\n\t\t\te.results[name].Status = \"failed\"\r\n\t\t\te.results[name].Error = err.Error()\r\n\t\t\tcontinue\r\n"]
[8828.509858, "o", "\t\t}\r\n\r\n\t\tparams := e.config.stageParams(name, e.globals)\r\n\t\tinputKeys := e.inputCacheKeys(stage)\r\n\t\tcacheKey, keyErr := computeCacheKey(stage, params, inputKeys, -1)\r\n\t\tif keyErr != nil {\r\n\t\t\te.status[name] = \"failed\"\r\n\t\t\te.results[name].Status = \"failed\"\r\n\t\t\te.results[name].Error = keyErr.Error()\r\n\t\t\tcontinue\r\n"]
[8828.509935, "o", "\t\t}\r\n\t\te.cacheKeys[name] = cacheKey\r\n\r\n\t\tvar out map[string]*ArtifactValue\r\n\t\tstart := time.Now()\r\n\t\tif !e.noCache && cacheEntryExists(cacheKey) {\r\n\t\t\tloaded, err := loadCacheEntry(cacheKey)\r\n\t\t\tduration := time.Since(start).Milliseconds()\r\n\t\t\te.results[name].DurationMs = duration\r\n\t\t\tif err == nil {\r\n\t\t\t\tout = loaded\r\n\t\t\t\te.results[name].CacheHit = true\r\n"]
[8828.509999, "o", "\t\t\t\te.cacheStats.Hits++\r\n\t\t\t} else {\r\n\t\t\t\tif !e.noCache {\r\n\t\t\t\t\te.cacheStats.Misses++\r\n\t\t\t\t}\r\n\t\t\t\tout, err = executeStage(stage, params, inputValues)\r\n\t\t\t\tduration = time.Since(start).Milliseconds()\r\n\t\t\t\te.results[name].DurationMs = duration\r\n\t\t\t\tif err != nil {\r\n"]
[8828.510057, "o", "\t\t\t\t\te.status[name] = \"failed\"\r\n\t\t\t\t\te.results[name].Status = \"failed\"\r\n\t\t\t\t\te.results[name].Error = err.Error()\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t} else {\r\n\t"]
[8828.510116, "o", "\t\tvar err error\r\n\t\t\tout, err = executeStage(stage, params, inputValues)\r\n\t\t\tduration := time.Since(start).Milliseconds()\r\n\t\t\te.results[name].DurationMs = duration\r\n\t\t\tif err != nil {\r\n\t\t\t\te.status[name] = \"failed\"\r\n\t\t\t\te.results[name].Status = \"failed\"\r\n"]
[8828.510175, "o", "\t\t\t\te.results[name].Error = err.Error()\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif !e.noCache {\r\n\t\t\t\t_ = saveCacheEntry(cacheKey, name, stage.Type, out)\r\n\t\t\t}\r\n\t\t\tif !e.noCache {\r\n\t\t\t\te.cacheStats.Misses++\r\n\t\t\t}\r\n"]
[8828.510247, "o", "\t\t}\r\n\r\n\t\te.status[name] = \"success\"\r\n\t\te.results[name].Status = \"success\"\r\n\t\tts := time.Now().UnixNano()\r\n\r\n\t\tfor port, val := range out {\r\n\t\t\tid := artifactID(e.config.Pipeline.Name, name, port, ts)\r\n"]
[8828.51031, "o", "\t\t\te.values[name][port] = val\r\n\t\t\te.outputs[name][port] = id\r\n\t\t\ttyp := val.Type()\r\n"]
[8828.510369, "o", "\t\t\tsummary := val.Summary()\r\n\t\t\tmeta := &ArtifactMeta{\r\n\t\t\t\tID:        id,\r\n\t\t\t\tStage:     name,\r\n\t\t\t\tPort:      port,\r\n\t\t\t\tType:      typ,\r\n\t\t\t\tSummary:   summary,\r\n\t\t\t\tInputs:    inputIDs,\r\n\t\t\t\tOutputs:   []string{},\r\n\t\t\t\tTimestamp: ts,\r\n\t\t\t}\r\n\t\t\te.meta[id] = meta\r\n\t\t\tfor _, inID := range inputIDs {\r\n\t"]
[8828.510436, "o", "\t\t\tif parent, ok := e.meta[inID]; ok {\r\n\t\t\t\t\tparent.Outputs = appendUnique(parent.Outputs, id)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\trunArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n\t\t}\r\n\t}\r\n\r\n\tstatus := \"success\"\r\n\tfor _, s := range e.results {\r\n\t\tif s.Status != \"success\" {\r\n\t"]
[8828.510494, "o", "\t\tstatus = \"failed\"\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n\trun := &RunOutput{\r\n\t\tPipeline:   e.config.Pipeline.Name,\r\n\t\tStatus:     status,\r\n\t\tStages:     e.results,\r\n"]
[8828.510551, "o", "\t\tArtifacts:  runArtifacts,\r\n\t\tCacheStats: e.cacheStats,\r\n\t}\r\n\r\n\tif err := saveArtifacts(e.meta); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif err := saveRunAny(e.config.Pipeline.Name, run); err != nil {\r\n"]
[8828.510608, "o", "\t\treturn nil, err\r\n\t}\r\n\r\n\treturn run, nil\r\n}\r\n\r\nfunc (e *Executor) inputCacheKeys(stage *StageConfig) map[string]string {\r\n\tkeys := map[string]string{}\r\n\tfor local, ref := range stage.Inputs {\r\n\t\tparts := strings.SplitN(ref, \".\", 2)\r\n\t\tif len(parts) != 2 {\r\n"]
[8828.510671, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tdepStage := parts[0]\r\n\t\tif key, ok := e.cacheKeys[depStage]; ok {\r\n\t\t\tkeys[local] = key\r\n\t\t}\r\n\t}\r\n\treturn keys\r\n}\r\n\r\n"]
[8828.510735, "o", "func (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {\r\n\tinputs := map[string]*ArtifactValue{}\r\n\tids := []string{}\r\n\tfor local, ref := range stage.Inputs {\r\n\t\tparts := strings.SplitN(ref, \".\", 2)\r\n\t\tif len(parts) != 2 {\r\n\t\t\treturn nil, nil, fmt.Errorf(\"stage %q has invalid input reference %q\", stage.Name, ref)\r\n\t\t}\r\n\t\tdepStage, port := parts[0], parts[1]\r\n\t"]
[8828.510792, "o", "\tid, ok := e.outputs[depStage][port]\r\n\t\tif !ok {\r\n\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable output %s.%s\", stage.Name, local, depStage, port)\r\n\t\t}\r\n\t\tval, ok := e.values[depStage][port]\r\n\t\tif !ok || val == nil {\r\n\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable artifact %s.%s\", stage.Name, local, depStage, port)\r\n\t\t}\r\n"]
[8828.510852, "o", "\t\tinputs[local] = val\r\n\t\tids = append(ids, id)\r\n\t}\r\n\treturn inputs, ids, nil\r\n}\r\n\r\nfunc executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tswitch stage.Type {\r\n\tcase \"data-source\":\r\n\t\treturn executeDataSource(stage, params, inputs)\r\n\t"]
[8828.510909, "o", "case \"transform\":\r\n\t\treturn executeTransform(stage, params, inputs)\r\n\tcase \"split\":\r\n\t\treturn executeSplit(stage, params, inputs)\r\n\tcase \"train\":\r\n\t\treturn executeTrain(stage, params, inputs)\r\n\tcase \"evaluate\":\r\n\t\treturn executeEvaluate(stage, params, inputs)\r\n\tcase \"register\":\r\n"]
[8828.510967, "o", "\t\treturn executeRegister(stage, params, inputs)\r\n\t}\r\n\treturn nil, fmt.Errorf(\"unknown stage type %q\", stage.Type)\r\n}\r\n\r\nfunc executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tpath, ok := getString(params, \"path\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"data-source stage %q requires path\", stage.Name)\r\n\t}\r\n"]
[8828.511029, "o", "\tschema, _ := getMap(params, \"schema\")\r\n\tds, err := loadDataset(path, schema)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn map[string]*ArtifactValue{\"data\": {Dataset: ds}}, nil\r\n}\r\n\r\nfunc (c *Config) topologicalOrder() ([]string, error) {\r\n"]
[8828.511085, "o", "\tindeg := map[string]int{}\r\n\tadj := map[string][]string{}\r\n\tfor _, s := range c.Stages {\r\n\t\tindeg[s.Name] = 0\r\n\t}\r\n"]
