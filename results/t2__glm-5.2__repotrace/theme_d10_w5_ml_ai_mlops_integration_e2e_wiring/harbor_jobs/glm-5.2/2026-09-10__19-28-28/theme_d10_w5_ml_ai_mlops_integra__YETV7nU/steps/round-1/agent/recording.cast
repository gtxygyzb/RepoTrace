[1776.987626, "o", "\tif n == 0 {\r\n\t\treturn nil, fmt.Errorf(\"no training data\")\r\n\t}\r\n\tm := len(X[0])\r\n\tw := make([]float64, m+1)\r\n\tfor e := 0; e < epochs; e++ {\r\n\t\tgrad := make([]float64, m+1)\r\n\t\tfor i := 0; i < n; i++ {\r\n\t\t\tz := w[0]\r\n\t\t\tfor j := 0; j < m; j++ {\r\n\t\t\t\tz += w[j+1] * X[i][j]\r\n\t\t\t}\r\n"]
