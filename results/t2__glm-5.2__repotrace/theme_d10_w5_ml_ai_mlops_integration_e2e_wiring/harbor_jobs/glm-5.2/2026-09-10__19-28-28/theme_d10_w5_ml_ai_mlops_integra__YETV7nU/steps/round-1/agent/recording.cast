[10945.309757, "o", "   329\t\t\t\t\tfirstVal = val\r\n   330\t\t\t\t}\r\n   331\t\t\t\tif stage.Type == \"ensemble\" && local == \"models\" {\r\n   332\t\t\t\t\tinputs[local+\"_\"+r] = val\r\n   333\t\t\t\t}\r\n   334\t\t\t}\r\n   335\t\t\tif _, exists := inputs[local]; !exists {\r\n   336\t\t\t\tinputs[local] = firstVal\r\n   337\t\t\t}\r\n   338\t\t}\r\n   339\t\treturn inputs, ids, nil\r\n   340\t}\r\n   341\t\r\n"]
[10945.30982, "o", "   342\tfunc executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n   343\t\tswitch stage.Type {\r\n   344\t\tcase \"data-source\":\r\n   345\t\t\treturn executeDataSource(stage, params, inputs)\r\n   346\t\tcase \"transform\":\r\n   347\t\t\treturn executeTransform(stage, params, inputs)\r\n   348\t\tcase \"split\":\r\n   349\t\t\treturn executeSplit(stage, params, inputs)\r\n"]
[10945.309976, "o", "   350\t\tcase \"train\":\r\n   351\t\t\treturn executeTrain(stage, params, inputs)\r\n   352\t\tcase \"evaluate\":\r\n   353\t\t\treturn executeEvaluate(stage, params, inputs)\r\n   354\t\tcase \"register\":\r\n   355\t\t\treturn executeRegister(stage, params, inputs)\r\n   356\t\tcase \"ensemble\":\r\n   357\t\t\treturn executeEnsemble(stage, params, inputs)\r\n   358\t\t}\r\n   359\t\treturn nil, fmt.Errorf(\"unknown stage type %q\", stage.Type)\r\n   360\t}\r\n   361\t\r\n   362\tfunc executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n   363\t\tpath, ok := getString(params, \"path\")\r\n   364\t\tif !ok {\r\n   365\t\t\treturn nil, fmt.Errorf(\"data-source stage %q requires path\", stage.Name)\r\n   366\t\t}\r\n   367\t\tschema, _ := getMap(params, \"schema\")\r\n   368\t\tds, err := loadDataset(path, schema)\r\n   369\t\tif err != nil {\r\n   370\t\t\treturn nil, err\r\n   371\t\t}\r\n"]
[10945.310091, "o", "   372\t\treturn map[string]*ArtifactValue{\"data\": {Dataset: ds}}, nil\r\n   373\t}\r\n   374\t\r\n   375\tfunc (c *Config) topologicalOrder() ([]string, error) {\r\n   376\t\tindeg := map[string]int{}\r\n   377\t\tadj := map[string][]string{}\r\n   378\t\tfor _, s := range c.Stages {\r\n   379\t\t\tindeg[s.Name] = 0\r\n   380\t\t}\r\n   381\t\tfor _, s := range c.Stages {\r\n   382\t\t\tfor _, dep := range s.DependsOn {\r\n   383\t\t\t\tif _, ok := c.stageByName(dep); ok {\r\n   384\t\t\t\t\tadj[dep] = append(adj[dep], s.Name)\r\n   385\t\t\t\t\tindeg[s.Name]++\r\n   386\t\t\t\t}\r\n   387\t"]
[10945.310192, "o", "\t\t}\r\n   388\t\t}\r\n   389\t\tqueue := []string{}\r\n   390\t\tfor _, s := range c.Stages {\r\n   391\t\t\tif indeg[s.Name] == 0 {\r\n   392\t\t\t\tqueue = append(queue, s.Name)\r\n   393\t\t\t}\r\n   394\t\t}\r\n   395\t\torder := []string{}\r\n   396\t\tfor len(queue) > 0 {\r\n   397\t\t\tnode := queue[0]\r\n   398\t\t\tqueue = queue[1:]\r\n   399\t\t\torder = append(order, node)\r\n"]
[10945.31032, "o", "   400\t\t\tfor _, next := range adj[node] {\r\n   401\t\t\t\tindeg[next]--\r\n   402\t\t\t\tif indeg[next] == 0 {\r\n   403\t\t\t\t\tqueue = append(queue, next)\r\n   404\t\t\t\t}\r\n   405\t\t\t}\r\n   406\t\t}\r\n   407\t\tif len(order) < len(c.Stages) {\r\n   408\t\t\tif cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {\r\n   409\t\t\t\treturn nil, fmt.Errorf(\"cycle detected involving stages: %s\", strings.Join(cycle, \", \"))\r\n   410\t\t\t}\r\n"]
[10945.310426, "o", "   411\t\t\treturn nil, fmt.Errorf(\"cycle detected involving stages: %s\", joinStageNames(c.Stages))\r\n   412\t\t}\r\n   413\t\treturn order, nil\r\n   414\t}\r\n   415\t\r\n   416\tfunc joinStageNames(stages []StageConfig) string {\r\n   417\t\tnames := []string{}\r\n   418\t\tfor _, s := range stages {\r\n   419\t\t\tnames = append(names, s.Name)\r\n   420\t\t}\r\n   421\t\treturn strings.Join(names, \", \")\r\n   422\t}\r\n"]
[10945.310539, "o", "   423\t\r\n   424\tfunc artifactID(pipeline, stage, port string, ts int64) string {\r\n   425\t\tif pipeline == \"\" {\r\n   426\t\t\tpipeline = \"pipeline\"\r\n   427\t\t}\r\n   428\t\treturn fmt.Sprintf(\"%s-%s-%s-%d\", pipeline, stage, port, ts)\r\n   429\t}\r\n   430\t\r\n   431\tfunc (v *ArtifactValue) Type() string {\r\n   432\t\tif v.Dataset != nil {\r\n   433\t\t\treturn \"dataset\"\r\n   434\t\t}\r\n   435\t\tif v.Model != nil {\r\n   436\t\t\treturn \"model\"\r\n   437\t\t}\r\n"]
[10945.31065, "o", "   438\t\tif v.Report != nil {\r\n   439\t\t\treturn \"report\"\r\n   440\t\t}\r\n   441\t\tif v.Entry != nil {\r\n   442\t\t\treturn \"entry\"\r\n   443\t\t}\r\n   444\t\treturn \"unknown\"\r\n   445\t}\r\n   446\t\r\n   447\tfunc (v *ArtifactValue) Summary() map[string]interface{} {\r\n   448\t\tif v.Dataset != nil {\r\n   449\t\t\treturn v.Dataset.Summary()\r\n   450\t\t}\r\n   451\t\tif v.Model != nil {\r\n   452\t\t\tsummary := map[string]interface{}{\r\n   453\t\t\t\t\"algorithm\":   v.Model.Algorithm,\r\n   454\t\t\t\t\"target\":      v.Model.Target,\r\n   455\t\t\t\t\"features\":    v.Model.Features,\r\n   456\t\t\t\t\"hyperparams\": v.Model.Hyperparams,\r\n   457\t\t\t}\r\n   458\t"]
[10945.310747, "o", "\t\tif len(v.Model.EnsembleModels) > 0 {\r\n   459\t\t\t\tsummary[\"ensemble_models\"] = v.Model.EnsembleModels\r\n   460\t\t\t}\r\n   461\t\t\tif v.Model.ModelData != nil {\r\n   462\t\t\t\tsummary[\"model_data\"] = v.Model.ModelData\r\n   463\t\t\t}\r\n   464\t\t\treturn summary\r\n   465"]
[10945.310844, "o", "\t\t}\r\n   466\t\tif v.Report != nil {\r\n   467\t\t\treturn v.Report.Summary()\r\n   468\t\t}\r\n   469\t\tif v.Entry != nil {\r\n   470\t\t\treturn map[string]interface{}{\r\n   471\t\t\t\t\"name\":    v.Entry.Name,\r\n   472\t\t\t\t\"version\": v.Entry.Version,\r\n   473\t\t\t\t\"stage\":   v.Entry.Stage,\r\n   474\t\t\t}\r\n   475\t\t}\r\n   476\t\treturn map[string]interface{}{}\r\n   477\t}\r\n   478\t\r\n   479\tfunc inputDataset(inputs map[string]*ArtifactValue) *Dataset {\r\n   480\t\tfor _, in := range inputs {\r\n   481\t\t\tif in != nil && in.Dataset != nil {\r\n   482\t\t\t\treturn in.Dataset\r\n   483\t\t\t}\r\n   484"]
[10945.310939, "o", "\t\t}\r\n   485\t\treturn nil\r\n   486\t}\r\n   487\t\r\n   488\tfunc appendUnique(s []string, v string) []string {\r\n   489\t\tfor _, x := range s {\r\n   490\t\t\tif x == v {\r\n   491\t\t\t\treturn s\r\n   492\t\t\t}\r\n   493\t\t}\r\n   494\t\treturn append(s, v)\r\n   495\t}\r\n"]
[10945.311031, "o", "   496\t\r\n   497\tfunc artifactsPath() string {\r\n   498\t\treturn filepath.Join(\".mlpipe\", \"artifacts.json\")\r\n   499\t}\r\n   500\t\r\n   501\tfunc loadArtifacts() (map[string]*ArtifactMeta, error) {\r\n   502\t\tdata, err := os.ReadFile(artifactsPath())\r\n   503\t\tif err != nil {\r\n   504\t\t\tif os.IsNotExist(err) {\r\n   505\t\t\t\treturn map[string]*ArtifactMeta{}, nil\r\n   506\t\t\t}\r\n   507\t\t\treturn nil, err\r\n   508\t\t}\r\n"]
[10945.311123, "o", "   509\t\tvar m map[string]*ArtifactMeta\r\n   510\t\tif err := json.Unmarshal(data, &m); err != nil {\r\n   511\t\t\treturn nil, err\r\n   512\t\t}\r\n   513\t\tif m == nil {\r\n"]
[10945.311238, "o", "   514\t\t\tm = map[string]*ArtifactMeta{}\r\n   515\t\t}\r\n   516\t\treturn m, nil\r\n   517\t}\r\n   518\t\r\n   519\tfunc saveArtifacts(newMeta map[string]*ArtifactMeta) error {\r\n   520\t\texisting, err := loadArtifacts()\r\n   521\t\tif err != nil {\r\n   522\t\t\treturn err\r\n   523\t\t}\r\n   524\t\tfor k, v := range newMeta {\r\n   525\t\t\texisting[k] = v\r\n   526\t\t}\r\n   527\t\tif err := os.MkdirAll(\".mlpipe\", 0755); err != nil {\r\n   528\t\t\treturn err\r\n   529\t\t}\r\n   530\t\tdata, err := json.MarshalIndent(existing, \"\", \"  \")\r\n   531\t\tif err != nil {\r\n   532\t\t\treturn err\r\n   533\t\t}\r\n   534\t\treturn os.WriteFile(artifactsPath(), data, 0644)\r\n   535\t}\r\n   536\t\r\n"]
[10945.311354, "o", "   537\tfunc saveRunAny(pipelineName string, run interface{}) error {\r\n   538\t\tdir := filepath.Join(\".mlpipe\", \"runs\")\r\n   539\t\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n   540\t\t\treturn err\r\n   541\t\t}\r\n   542\t\tname := safeFileName(pipelineName)\r\n   543\t\tif name == \"\" {\r\n"]
[10945.311503, "o", "   544\t\t\tname = \"pipeline\"\r\n   545\t\t}\r\n   546\t\tpath := filepath.Join(dir, fmt.Sprintf(\"%s-%d.json\", name, time.Now().UnixNano()))\r\n   547\t\tdata, err := json.MarshalIndent(run, \"\", \"  \")\r\n   548\t\tif err != nil {\r\n   549\t\t\treturn err\r\n   550\t\t}\r\n   551\t\treturn os.WriteFile(path, data, 0644)\r\n   552\t}\r\n   553\t\r\n   554\tfunc safeFileName(s string) string {\r\n   555\t\tif s == \"\" {\r\n   556\t\t\treturn \"pipeline\"\r\n   557\t\t}\r\n   558\t\treturn strings.Map(func(r rune) rune {\r\n   559\t\t\tif r == '/' || r == '\\\\' || r == ':' || r == ' ' {\r\n   560\t\t\t\treturn '_'\r\n"]
