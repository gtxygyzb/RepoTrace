[12582.492805, "o", "   189\t\t\tfor local, ref := range s.Inputs {\r\n   190\t\t\t\trefs, ok := inputRefs(ref)\r\n   191\t\t\t\tif !ok {\r\n   192\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %v\", s.Name, local, ref))\r\n"]
[12582.492904, "o", "   193\t\t\t\t\tcontinue\r\n   194\t\t\t\t}\r\n   195\t\t\t\tfor idx, r := range refs {\r\n   196\t\t\t\t\tif r == \"\" {\r\n   197\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q[%d] has invalid empty reference\", s.Name, local, idx))\r\n   198\t\t\t\t\t\tcontinue\r\n   199\t\t\t\t\t}\r\n   200\t\t\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n   201\t\t\t\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n   202\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %q\", s.Name, local, r))\r\n"]
[12582.49298, "o", "   203\t\t\t\t\t\tcontinue\r\n   204\t\t\t\t\t}\r\n   205\t\t\t\t\trefStage, ok := c.stageByName(parts[0])\r\n   206\t\t\t\t\tif !ok {\r\n   207\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown stage %q\", s.Name, local, parts[0]))\r\n   208\t\t\t\t\t\tcontinue\r\n   209\t\t\t\t\t}\r\n   210\t\t\t\t\tports := validOutputPorts(refStage.Type)\r\n   211\t\t\t\t\tvalid := false\r\n"]
[12582.493045, "o", "   212\t\t\t\t\tfor _, p := range ports {\r\n   213\t\t\t\t\t\tif p == parts[1] {\r\n   214\t\t\t\t\t\t\tvalid = true\r\n   215\t\t\t\t\t\t\tbreak\r\n   216\t\t\t\t\t\t}\r\n   217\t\t\t\t\t}\r\n   218\t\t\t\t\tif !valid {\r\n"]
[12582.493108, "o", "   219\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown output port %q on stage %q\", s.Name, local, parts[1], parts[0]))\r\n   220\t\t\t\t\t}\r\n   221\t\t\t\t}\r\n   222\t\t\t\tif s.Type == \"ensemble\" && local == \"models\" {\r\n   223\t\t\t\t\tif _, ok := ref.([]interface{}); !ok {\r\n   224\t\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q input %q must be an array\", s.Name, local))\r\n   225\t\t"]
[12582.49317, "o", "\t\t\t}\r\n   226\t\t\t\t}\r\n   227\t\t\t}\r\n   228\t\t\tif s.Type == \"ensemble\" {\r\n   229\t\t\t\tmodels, ok := s.Inputs[\"models\"]\r\n   230\t\t\t\tif !ok {\r\n   231\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires inputs.models\", s.Name))\r\n   232\t\t\t"]
[12582.493273, "o", "\t} else if refs, ok := inputRefs(models); !ok || len(refs) < 2 {\r\n   233\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires at least 2 model inputs\", s.Name))\r\n   234\t\t\t\t}\r\n   235\t\t\t\tif _, ok := s.Inputs[\"data\"]; !ok {\r\n   236\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires inputs.data\", s.Name))\r\n   237\t\t\t\t}\r\n   238\t\t\t\tstrategy, _ := getString(s.Params, \"strategy\")\r\n   239\t\t\t\tif strategy != \"vote\" && strategy != \"average\" {\r\n   240\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q has invalid strategy %q (must be vote or average)\", s.Name, strategy))\r\n   241\t\t\t\t}\r\n"]
[12582.493332, "o", "   242\t\t\t\tif _, ok := getString(s.Params, \"target\"); !ok {\r\n   243\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires target param\", s.Name))\r\n   244\t\t\t\t}\r\n   245\t\t\t}\r\n"]
