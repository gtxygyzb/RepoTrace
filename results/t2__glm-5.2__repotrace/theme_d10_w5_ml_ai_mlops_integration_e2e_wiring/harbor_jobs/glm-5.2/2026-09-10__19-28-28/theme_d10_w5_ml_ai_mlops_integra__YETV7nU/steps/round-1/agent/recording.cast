[2876.88514, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7"]
[2876.885241, "o", "\t\t\"strings\"\r\n     8\t)\r\n     9\t\r\n    10\tfunc main() {\r\n    11\t\tif len(os.Args) < 2 {\r\n    12\t\t\tprintError(\"usage: mlpipe <command> [args]\")\r\n    13\t\t\treturn\r\n    14\t\t}\r\n    15\t\r\n    16\t\tcmd := os.Args[1]\r\n    17"]
