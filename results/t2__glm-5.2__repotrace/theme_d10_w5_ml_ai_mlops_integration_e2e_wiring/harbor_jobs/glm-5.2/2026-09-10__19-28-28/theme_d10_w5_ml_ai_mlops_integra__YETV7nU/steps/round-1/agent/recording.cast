[10158.499832, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/app/pipeline.go')\nlines = p.read_text().splitlines()\n# Find model summary start and end\nstart = None\nfor i,l in enumerate(lines):\n    if 'if v.Model != nil {' in l:\n        start = i\n        break\nif start is None:\n    raise SystemExit('model start not found')\n# find the closing brace of the if v.Model block after start\ndepth = 0\nend = None\nfor j in range(start, len(lines)):\n    depth += lines[j].count('{') - lines[j].count('}')\n    if depth == 0 and j > start:\n        end = j\n        break\n# Replace the model block with a variable-based summary\nindent = '\\t'\nlines[start:end+1] = [\n    indent + 'if v.Model != nil {',\n    indent + '\\tsummary := map[string]interface{}{',\n    indent + '\\t\\t\"algorithm\":   v.Model.Algorithm,',\n    indent + '\\t\\t\"target\":      v.Model.Target,',\n    indent + '\\t\\t\"features\":    v.Model.Features,',\n    indent + '\\t\\t\"hyperparams\": v.Model.Hyperparams,',\n    indent + '\\t}',\n    indent + '\\tif len(v.Model.EnsembleModels) > 0 {',\n    "]
[10158.500093, "i", "indent + '\\t\\tsummary[\"ensemble_models\"] = v.Model.EnsembleModels',\n    indent + '\\t}',\n    indent + '\\tif v.Model.ModelData != nil {',\n    indent + '\\t\\tsummary[\"model_data\"] = v.Model.ModelData',\n    indent + '\\t}',\n    indent + '\\treturn summary',\n    indent + '}',\n]\np.write_text('\\n'.join(lines) + '\\n')\nPY\n"]
[10158.500176, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[10158.500293, "o", "indent + '\\t\\tsummary[\"ensemble_models\"] = v.Model.EnsembleModels',\r\n    indent + '\\t}',\r\n    indent + '\\tif v.Model.ModelData != nil {',\r\n    indent + '\\t\\tsummary[\"model_data\"] = v.Model.ModelData',\r\n    indent + '\\t}',\r\n    indent + '\\treturn summary',\r\n    indent + '}',\r\n]\r\np.write_text('\\"]
[10158.500365, "o", "n'.join(lines) + '\\n')\r\nPY\r\n\u001b[?2004h> "]
