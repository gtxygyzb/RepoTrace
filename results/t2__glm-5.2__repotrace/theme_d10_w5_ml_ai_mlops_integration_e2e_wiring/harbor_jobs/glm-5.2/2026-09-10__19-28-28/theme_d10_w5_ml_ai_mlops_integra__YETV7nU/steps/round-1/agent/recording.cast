[5326.156912, "o", "\u001b[?2004h> "]
[5326.157038, "o", "        foldResults[i] = CVFoldResult{\r\n\u001b[?2004l\r"]
[5326.157092, "o", "\u001b[?2004h> "]
[5326.157154, "o", "            Fold:   i,\r\n\u001b[?2004l\r"]
[5326.157229, "o", "\u001b[?2004h> "]
[5326.157321, "o", "            Status: foldStatus,\r\n\u001b[?2004l\r "]
[5326.157376, "o", "\u001b[?2004h> "]
[5326.157488, "o", "            Stages: foldExec.results,\r\n\u001b[?2004l\r"]
[5326.157544, "o", "\u001b[?2004h>         }\r\n"]
[5326.157598, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5326.157657, "o", "\u001b[?2004h> "]
[5326.1578, "o", "        foldMetric := map[string]float64{}\r\n\u001b[?2004l\r"]
[5326.157854, "o", "\u001b[?2004h> "]
