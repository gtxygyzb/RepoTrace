[8758.335993, "i", "sed -n '1,260p' config.go\n"]
[8758.336284, "o", "sed -n '1,260p' config.go\r\n\u001b[?2004l\r"]
[8758.339067, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t"]
[8758.339154, "o", "\"os\"\r\n\t\"regexp\"\r\n\t\"strings\"\r\n)\r\n\r\ntype Config struct {\r\n\tPipeline PipelineConfig `json:\"pipeline\"`\r\n\tStages   []StageConfig  `json:\"stages\"`\r\n}\r\n\r\ntype PipelineConfig struct {\r\n\tName   string                 `json:\"name\"`\r\n\tParams map[string]interface{} `json:\"params\"`\r\n}\r\n\r\ntype StageConfig struct {\r\n\tName      string                 `json:\"name\"`\r\n\t"]
[8758.339258, "o", "Type      string                 `json:\"type\"`\r\n\tDependsOn []string               `json:\"depends_on\"`\r\n\tInputs    map[string]string      `json:\"inputs\"`\r\n\tParams    map[string]interface{} `json:\"params\"`\r\n}\r\n\r\n"]
[8758.339326, "o", "var paramRE = regexp.MustCompile(`\\$\\{([^}]+)\\}`)\r\n\r\nfunc loadConfig(path string) (*Config, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, fmt.Errorf(\"file not found: %s\", path)\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\tvar c Config\r\n\tif err := json.Unmarshal(data, &c); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"invalid config: %s\", err.Error())\r\n\t}\r\n\treturn &c, nil\r\n}\r\n\r\nfunc (c *Config) globalParams(overrides map[string]string) map[string]interface{} {\r\n\tparams := map[string]interface{}{}\r\n\tfor k, v := range c.Pipeline.Params {\r\n\t\tparams[k] = v\r\n"]
[8758.339398, "o", "\t}\r\n\tfor k, v := range overrides {\r\n\t\tparams[k] = v\r\n\t}\r\n\treturn params\r\n}\r\n\r\nfunc substituteValue(v interface{}, globals map[string]interface{}) interface{} {\r\n\tswitch x := v.(type) {\r\n\tcase string:\r\n\t\treturn paramRE.ReplaceAllStringFunc(x, func(m string) string {\r\n\t\t\tkey := m[2 : len(m)-1]\r\n"]
[8758.339461, "o", "\t\t\tif val, ok := globals[key]; ok {\r\n\t\t\t\treturn fmt.Sprintf(\"%v\", val)\r\n\t\t\t}\r\n\t\t\treturn m\r\n\t\t})\r\n\tcase map[string]interface{}:\r\n\t\tres := map[string]interface{}{}\r\n\t\tfor k, val := range x {\r\n\t\t\tres[k] = substituteValue(val, globals)\r\n\t\t}\r\n"]
[8758.339522, "o", "\t\treturn res\r\n\tcase []interface{}:\r\n\t\tres := make([]interface{}, len(x))\r\n\t\tfor i, val := range x {\r\n\t\t\tres[i] = substituteValue(val, globals)\r\n\t\t}\r\n\t\treturn res\r\n\tdefault:\r\n\t\treturn v\r\n"]
[8758.339578, "o", "\t}\r\n}\r\n\r\nfunc (c *Config) stageParams(name string, globals map[string]interface{}) map[string]interface{} {\r\n\tfor _, s := range c.Stages {\r\n\t\tif s.Name == name {\r\n\t\t\tif s.Params == nil {\r\n"]
[8758.339637, "o", "\t\t\t\treturn map[string]interface{}{}\r\n\t\t\t}\r\n\t\t\tres := substituteValue(s.Params, globals)\r\n\t\t\tif m, ok := res.(map[string]interface{}); ok {\r\n\t\t\t\treturn m\r\n\t\t\t}\r\n\t\t\treturn map[string]interface{}{}\r\n\t\t}\r\n\t}\r\n"]
[8758.339692, "o", "\treturn map[string]interface{}{}\r\n}\r\n\r\nfunc (c *Config) stageByName(name string) (*StageConfig, bool) {\r\n\tfor i := range c.Stages {\r\n\t\tif c.Stages[i].Name == name {\r\n\t\t\treturn &c.Stages[i], true\r\n\t\t}\r\n\t}\r\n"]
[8758.339749, "o", "\treturn nil, false\r\n}\r\n\r\nfunc validOutputPorts(t string) []string {\r\n\tswitch t {\r\n\tcase \"data-source\":\r\n\t\treturn []string{\"data\"}\r\n\tcase \"transform\":\r\n\t\treturn []string{\"data\"}\r\n\t"]
[8758.339806, "o", "case \"split\":\r\n\t\treturn []string{\"train\", \"test\"}\r\n\tcase \"train\":\r\n\t\treturn []string{\"model\", \"predictions\"}\r\n\tcase \"evaluate\":\r\n\t\treturn []string{\"report\"}\r\n\tcase \"register\":\r\n\t\treturn []string{\"entry\"}\r\n"]
[8758.339862, "o", "\t}\r\n\treturn nil\r\n}\r\n\r\nfunc validStageType(t string) bool {\r\n\tswitch t {\r\n\tcase \"data-source\", \"transform\", \"split\", \"train\", \"evaluate\", \"register\":\r\n\t\treturn true\r\n\t}\r\n\treturn false\r\n}\r\n"]
[8758.339922, "o", "\r\nfunc (c *Config) Validate() (bool, []string) {\r\n\terrors := []string{}\r\n\tnames := map[string]bool{}\r\n\tfor i, s := range c.Stages {\r\n\t\tif s.Name == \"\" {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"stage at index %d has empty name\", i))\r\n\t\t\tcontinue\r\n\t\t}\r\n\t"]
[8758.339979, "o", "\tif names[s.Name] {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"duplicate stage name: %s\", s.Name))\r\n\t\t}\r\n\t\tnames[s.Name] = true\r\n\t}\r\n\tfor _, s := range c.Stages {\r\n\t\tif !validStageType(s.Type) {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q has unknown type %q\", s.Name, s.Type))\r\n\t\t}\r\n\t\t"]
[8758.340039, "o", "for _, dep := range s.DependsOn {\r\n\t\t\tif !names[dep] {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q references unknown dependency %q\", s.Name, dep))\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor local, ref := range s.Inputs {\r\n\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n\t\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n"]
[8758.340098, "o", "\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %q\", s.Name, local, ref))\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\trefStage, ok := c.stageByName(parts[0])\r\n\t\t\tif !ok {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown stage %q\", s.Name, local, parts[0]))\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tports := validOutputPorts(refStage.Type)\r\n"]
[8758.340158, "o", "\t\t\tvalid := false\r\n\t\t\tfor _, p := range ports {\r\n\t\t\t\tif p == parts[1] {\r\n\t\t\t\t\tvalid = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !valid {\r\n"]
[8758.340231, "o", "\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown output port %q on stage %q\", s.Name, local, parts[1], parts[0]))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif stages, cycle := c.detectCycle(); cycle {\r\n\t\terrors = append(errors, fmt.Sprintf(\"cycle detected involving stages: %s\", strings.Join(stages, \", \")))\r\n\t}\r\n\treturn len(errors) == 0, errors\r\n}\r\n"]
[8758.340303, "o", "\r\nfunc (c *Config) detectCycle() ([]string, bool) {\r\n\tadj := map[string][]string{}\r\n\tfor _, s := range c.Stages {\r\n\t\tadj[s.Name] = append(adj[s.Name], s.DependsOn...)\r\n\t}\r\n\tcolor := map[string]int{}\r\n\tvar stack []string\r\n\tvar cycle []string\r\n\r\n\tvar dfs func(node string) bool\r\n\tdfs = func(node string) bool {\r\n\t\tif color[node] == 1 {\r\n"]
[8758.340362, "o", "\t\t\tidx := -1\r\n\t\t\tfor i, n := range stack {\r\n\t\t\t\tif n == node {\r\n\t\t\t\t\tidx = i\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif idx >= 0 {\r\n\t\t\t\t"]
[8758.340423, "o", "cycle = append([]string{}, stack[idx:]...)\r\n\t\t\t\tcycle = append(cycle, node)\r\n\t\t\t\tif len(cycle) > 1 && cycle[0] == cycle[len(cycle)-1] {\r\n\t\t\t\t\tcycle = cycle[:len(cycle)-1]\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\treturn true\r\n\t\t}\r\n\t\tif color[node] == 2 {\r\n\t\t\t"]
[8758.34048, "o", "return false\r\n\t\t}\r\n\t\tcolor[node] = 1\r\n\t\tstack = append(stack, node)\r\n\t\tfor _, dep := range adj[node] {\r\n\t\t\tif _, ok := adj[dep]; ok {\r\n\t\t\t\tif dfs(dep) {\r\n\t\t\t\t\treturn true\r\n"]
[8758.340536, "o", "\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tstack = stack[:len(stack)-1]\r\n\t\tcolor[node] = 2\r\n\t\treturn false\r\n\t}\r\n\r\n\tfor _, s := range c.Stages {\r\n\t\tif color[s.Name] == 0 {\r\n"]
[8758.340593, "o", "\t\t\tif dfs(s.Name) {\r\n\t\t\t\treturn cycle, true\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn nil, false\r\n}\r\n\r\nfunc getString(params map[string]interface{}, key string) (string, bool) {\r\n"]
