[10639.946059, "o", "\u001b[?2004h> "]
[10639.946119, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h"]
[10639.946178, "o", "> \\t\\t}\r\n\u001b[?2004l\r"]
[10639.94624, "o", "\u001b[?2004h> "]
[10639.946387, "o", "\\t\\tpositionals = append(positionals, a)\r\n\u001b[?2004l\r"]
[10639.946441, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[10639.946499, "o", "\u001b[?2004h> "]
[10639.946606, "o", "\\tif len(positionals) < 2 {\r\n\u001b[?2004l\r"]
[10639.94666, "o", "\u001b[?2004h> "]
