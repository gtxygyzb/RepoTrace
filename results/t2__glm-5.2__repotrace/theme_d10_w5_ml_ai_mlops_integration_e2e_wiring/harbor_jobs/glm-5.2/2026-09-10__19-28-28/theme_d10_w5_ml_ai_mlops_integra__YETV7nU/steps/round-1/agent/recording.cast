[4205.932194, "o", "> "]
[4205.932316, "o", "    if err := json.Unmarshal(data, &obj); err != nil {\r\n\u001b[?2004l\r"]
[4205.932371, "o", "\u001b[?2004h> "]
[4205.93243, "o", "        return nil, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4205.932485, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4205.932573, "o", "    typ, _ := obj[\"type\"].(string)\r\n\u001b[?2004l\r"]
[4205.932627, "o", "\u001b[?2004h> "]
[4205.932682, "o", "    switch typ {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4205.93274, "o", "    case \"dataset\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4205.932871, "o", "        return deserializeDatasetValue(obj)\r\n\u001b[?2004l\r"]
[4205.932925, "o", "\u001b[?2004h> "]
[4205.93298, "o", "    case \"model\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4205.933087, "o", "        return deserializeModelValue(obj)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4205.933142, "o", "> "]
[4205.933209, "o", "    case \"report\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4205.933359, "o", "        metrics, _ := obj[\"metrics\"].(map[string]interface{})\r\n\u001b[?2004l\r"]
