[8789.958083, "o", "   108\t\t\tcmdRegistryList(rest)\r\n   109\t\tcase \"info\":\r\n   110\t\t\tcmdRegistryInfo(rest)\r\n   111\t\tcase \"promote\":\r\n   112\t\t\tcmdRegistryPromote(rest)\r\n   113\t\tcase \"compare\":\r\n   114\t\t\tcmdRegistryCompare(rest)\r\n   115\t\tdefault:\r\n   116\t\t\tprintError(fmt.Sprintf(\"unknown registry command: %s\", sub))\r\n"]
[8789.958149, "o", "   117\t\t}\r\n   118\t}\r\n   119\t\r\n   120\tfunc cmdRegistryList(args []string) {\r\n   121\t\tname, stage, tag := \"\", \"\", \"\"\r\n   122\t\tfor i := 0; i < len(args); i++ {\r\n   123\t\t\tswitch {\r\n   124\t\t\tcase args[i] == \"--name\" && i+1 < len(args):\r\n   125\t"]
[8789.958252, "o", "\t\t\tname = args[i+1]\r\n   126\t\t\t\ti++\r\n   127\t\t\tcase strings.HasPrefix(args[i], \"--name=\"):\r\n   128\t\t\t\tname = strings.TrimPrefix(args[i], \"--name=\")\r\n   129\t\t\tcase args[i] == \"--stage\" && i+1 < len(args):\r\n   130\t\t\t\tstage = args[i+1]\r\n   131\t\t\t\ti++\r\n   132\t\t\tcase strings.HasPrefix(args[i], \"--stage=\"):\r\n   133\t\t\t\tstage = strings.TrimPrefix(args[i], \"--stage=\")\r\n   134"]
[8789.958328, "o", "\t\t\tcase args[i] == \"--tag\" && i+1 < len(args):\r\n   135\t\t\t\ttag = args[i+1]\r\n   136\t\t\t\ti++\r\n   137\t\t\tcase strings.HasPrefix(args[i], \"--tag=\"):\r\n   138\t\t\t\ttag = strings.TrimPrefix(args[i], \"--tag=\")\r\n   139\t\t\tdefault:\r\n   140\t\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n   141\t\t\t\treturn\r\n   142\t\t\t}\r\n   143\t\t}\r\n   144\t\tentries, err := listRegistry(name, stage, tag)\r\n   145\t\tif err != nil {\r\n   146\t\t\tprintError(err.Error())\r\n"]
