[1291.970825, "i", "cat > evaluate.go <<'EOF'\npackage main\n\nimport (\n    \"fmt\"\n    \"math\"\n    \"sort\"\n)\n\ntype Report struct {\n    Metrics map[string]interface{} `json:\"metrics\"`\n    Pass    bool                   `json:\"pass\"`\n}\n\nfunc executeEvaluate(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\n    modelVal := inputs[\"model\"]\n    if modelVal == nil || modelVal.Model == nil {\n        return nil, fmt.Errorf(\"evaluate stage %q requires model input\", stage.Name)\n    }\n    ds := inputDataset(inputs)\n    if ds == nil {\n        return nil, fmt.Errorf(\"evaluate stage %q requires data input\", stage.Name)\n    }\n    model := modelVal.Model\n\n    metrics, ok := getStringSlice(params, \"metrics\")\n    if !ok {\n        return nil, fmt.Errorf(\"evaluate stage %q requires metrics\", stage.Name)\n    }\n    threshold, _ := getMap(params, \"threshold\")\n\n    y, err := ds.NumericColumn(model.Target)\n    if err != nil {\n        return nil, err\n    }\n    X, err := ds.featureMatrix(mo"]
[1291.971104, "i", "del.Features)\n    if err != nil {\n        return nil, err\n    }\n    preds := model.PredictBatch(X)\n    classification := isBinary01(y)\n\n    report := &Report{Metrics: map[string]interface{}{}, Pass: true}\n\n    for _, metric := range metrics {\n        var val interface{}\n        var err error\n        switch metric {\n        case \"accuracy\", \"precision\", \"recall\", \"f1\", \"auc\", \"logloss\", \"confusion_matrix\":\n            if !classification {\n                err = fmt.Errorf(\"metric %q requires binary 0/1 target\", metric)\n            } else {\n                val, err = classificationMetric(metric, y, preds)\n            }\n        case \"mse\", \"rmse\", \"mae\", \"r2\", \"mape\":\n            if classification {\n                err = fmt.Errorf(\"metric %q requires regression target\", metric)\n            } else {\n                val, err = regressionMetric(metric, y, preds)\n            }\n        default:\n            err = fmt.Errorf(\"unknown metric %q\", metric)\n        }\n        if err != nil {\n            return nil, err\n    "]
[1291.971176, "o", "cat > evaluate.go <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> package main\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import (\r\n\u001b[?2004l\r\u001b[?2004h>     \"fmt\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1291.971346, "i", "    }\n        report.Metrics[metric] = val\n    }\n\n    if threshold != nil {\n        for metricName, thresholdVal := range threshold {\n            metricValue, ok := report.Metrics[metricName]\n            if !ok {\n                continue\n            }\n            fv, ok := toFloat64(metricValue)\n            if !ok {\n                continue\n            }\n            tv, ok := toFloat64(thresholdVal)\n            if !ok {\n                continue\n            }\n            if fv < tv {\n                report.Pass = false\n            }\n        }\n    }\n\n    return map[string]*ArtifactValue{\"report\": {Report: report}}, nil\n}\n\nfunc classificationMetric(name string, y []float64, preds []float64) (interface{}, error) {\n    labels := make([]int, len(preds))\n    for i, p := range preds {\n        if p >= 0.5 {\n            labels[i] = 1\n        } else {\n            labels[i] = 0\n        }\n    }\n    switch name {\n    case \"accuracy\":\n        correct := 0\n        for i := range y {\n            if labels[i] == int(y[i]) {\n  "]
[1291.971376, "o", "    \"math\"\r\n\u001b[?2004l\r\u001b[?2004h>     \"sort\"\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> type Report struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1291.97161, "i", "              correct++\n            }\n        }\n        return float64(correct) / float64(len(y)), nil\n    case \"precision\":\n        tp, fp := 0, 0\n        for i := range y {\n            if labels[i] == 1 {\n                if y[i] == 1 {\n                    tp++\n                } else {\n                    fp++\n                }\n            }\n        }\n        if tp+fp == 0 {\n            return 0.0, nil\n        }\n        return float64(tp) / float64(tp+fp), nil\n    case \"recall\":\n        tp, fn := 0, 0\n        for i := range y {\n            if y[i] == 1 {\n                if labels[i] == 1 {\n                    tp++\n                } else {\n                    fn++\n                }\n            }\n        }\n        if tp+fn == 0 {\n            return 0.0, nil\n        }\n        return float64(tp) / float64(tp+fn), nil\n    case \"f1\":\n        p, _ := classificationMetric(\"precision\", y, preds)\n        r, _ := classificationMetric(\"recall\", y, preds)\n        pf := p.(float64)\n        rf := r.(float64)\n        if pf+"]
[1291.971633, "o", "    Metrics map[string]interface{} `json:\"metrics\"`\r\n\u001b[?2004l\r\u001b[?2004h>     Pass    bool                   `json:\"pass\"`\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1291.971729, "i", "rf == 0 {\n            return 0.0, nil\n        }\n        return 2 * pf * rf / (pf + rf), nil\n    case \"auc\":\n        return aucROC(y, preds), nil\n    case \"logloss\":\n        sum := 0.0\n        for i := range y {\n            p := clamp(preds[i], 1e-15, 1-1e-15)\n            sum += y[i]*math.Log(p) + (1-y[i])*math.Log(1-p)\n        }\n        return -sum / float64(len(y)), nil\n    case \"confusion_matrix\":\n        tp, fp, tn, fn := 0, 0, 0, 0\n        for i := range y {\n            if labels[i] == 1 && y[i] == 1 {\n                tp++\n            } else if labels[i] == 1 && y[i] == 0 {\n                fp++\n            } else if labels[i] == 0 && y[i] == 0 {\n                tn++\n            } else {\n                fn++\n            }\n        }\n        return map[string]int{\"tp\": tp, \"fp\": fp, \"tn\": tn, \"fn\": fn}, nil\n    }\n    return nil, fmt.Errorf(\"unknown classification metric %q\", name)\n}\n\nfunc regressionMetric(name string, y []float64, preds []float64) (interface{}, error) {\n    n := float64(len(y))\n    switch na"]
[1291.97181, "i", "me {\n    case \"mse\":\n        sum := 0.0\n        for i := range y {\n            d := y[i] - preds[i]\n            sum += d * d\n        }\n        return sum / n, nil\n    case \"rmse\":\n        mse, _ := regressionMetric(\"mse\", y, preds)\n        return math.Sqrt(mse.(float64)), nil\n    case \"mae\":\n        sum := 0.0\n        for i := range y {\n            sum += math.Abs(y[i] - preds[i])\n        }\n        return sum / n, nil\n    case \"r2\":\n        mean := 0.0\n        for _, v := range y {\n            mean += v\n        }\n        mean /= n\n        ssRes := 0.0\n        ssTot := 0.0\n        for i := range y {\n            ssRes += (y[i] - preds[i]) * (y[i] - preds[i])\n            ssTot += (y[i] - mean) * (y[i] - mean)\n        }\n        if ssTot == 0 {\n            return 0.0, nil\n        }\n        return 1 - ssRes/ssTot, nil\n    case \"mape\":\n        sum := 0.0\n        count := 0.0\n        for i := range y {\n            if y[i] == 0 {\n                continue\n            }\n            sum += math.Abs((y[i] - preds[i]) / y["]
[1291.97187, "i", "i])\n            count++\n        }\n        if count == 0 {\n            return 0.0, nil\n        }\n        return sum / count * 100, nil\n    }\n    return nil, fmt.Errorf(\"unknown regression metric %q\", name)\n}\n\nfunc aucROC(y []float64, scores []float64) float64 {\n    type point struct {\n        score float64\n        y     float64\n    }\n    pts := make([]point, len(y))\n    pos := 0\n    neg := 0\n    for i := range y {\n        pts[i] = point{scores[i], y[i]}\n        if y[i] == 1 {\n            pos++\n        } else {\n            neg++\n        }\n    }\n    if pos == 0 || neg == 0 {\n        return 0.0\n    }\n    sort.Slice(pts, func(i, j int) bool {\n        if pts[i].score != pts[j].score {\n            return pts[i].score > pts[j].score\n        }\n        return pts[i].y > pts[j].y\n    })\n\n    area := 0.0\n    tp := 0.0\n    fp := 0.0\n    prevTP := 0.0\n    prevFP := 0.0\n    i := 0\n    for i < len(pts) {\n        j := i\n        for j < len(pts) && pts[j].score == pts[i].score {\n            j++\n        }\n        for k := i; k "]
[1291.971931, "i", "< j; k++ {\n            if pts[k].y == 1 {\n                tp++\n            } else {\n                fp++\n            }\n        }\n        area += (fp - prevFP) * (tp + prevTP) / 2.0\n        prevTP = tp\n        prevFP = fp\n        i = j\n    }\n    return area / (float64(pos) * float64(neg))\n}\n\nfunc clamp(v, lo, hi float64) float64 {\n    if v < lo {\n        return lo\n    }\n    if v > hi {\n        return hi\n    }\n    return v\n}\n\nfunc toFloat64(v interface{}) (float64, bool) {\n    switch x := v.(type) {\n    case float64:\n        return x, true\n    case int:\n        return float64(x), true\n    case int64:\n        return float64(x), true\n    }\n    return 0, false\n}\n\nfunc (r *Report) Summary() map[string]interface{} {\n    return map[string]interface{}{\n        \"metrics\": r.Metrics,\n        \"pass\":    r.Pass,\n    }\n}\nEOF\n"]
