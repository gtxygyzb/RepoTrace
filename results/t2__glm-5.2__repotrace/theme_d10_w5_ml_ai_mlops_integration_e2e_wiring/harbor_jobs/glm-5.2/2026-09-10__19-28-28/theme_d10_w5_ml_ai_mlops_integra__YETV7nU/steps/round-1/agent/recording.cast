[2877.15878, "o", "\tStatus    string                     `json:\"status\"`\r\n    48\t\tStages    map[string]*StageResult    `json:\"stages\"`\r\n    49\t\tArtifacts map[string]*ArtifactOutput `json:\"artifacts\"`\r\n    50\t}\r\n    51\t\r\n    52\ttype Executor struct {\r\n    53\t\tconfig  *Config\r\n"]
