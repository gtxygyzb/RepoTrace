[1891.135904, "o", "sed -n '390,440p' train.go\r\n\u001b[?2004l\r"]
[1891.138787, "o", "\tmean := 0.0\r\n\tfor _, v := range y {\r\n\t\tmean += v\r\n\t}\r\n\tmean /= float64(len(y))\r\n\tsum := 0.0\r\n"]
[1891.138894, "o", "\tfor _, v := range y {\r\n\t\td := v - mean\r\n\t\tsum += d * d\r\n\t}\r\n\treturn sum / float64(len(y))\r\n}\r\n\r\nfunc trainRandomForest(X [][]float64, y []float64, features []string, classification bool, nEst, maxDepth int, maxFeatures string, stageName string) []*TreeNode {\r\n\tforest := []*TreeNode{}\r\n\trng := rand.New(rand.NewSource(int64(nEst * 12345)))\r\n\tm := len(features)\r\n\tmf := m\r\n\tswitch maxFeatures {\r\n\tcase \"sqrt\":\r\n\t\tmf = int(math.Sqrt(float64(m)))\r\n"]
[1891.138966, "o", "\tcase \"log2\":\r\n\t\tmf = int(math.Log2(float64(m)))\r\n\tcase \"all\":\r\n\t\tmf = m\r\n\t}\r\n\tif mf < 1 {\r\n\t\tmf = 1\r\n\t}\r\n"]
[1891.13903, "o", "\tfor i := 0; i < nEst; i++ {\r\n\t\tn := len(X)\r\n\t\tidx := make([]int, n)\r\n\t\tfor j := 0; j < n; j++ {\r\n\t\t\tidx[j] = rng.Intn(n)\r\n\t\t}\r\n\t\tbootX := subsetRows(X, idx)\r\n\t\tbootY := subsetY(y, idx)\r\n\t"]
[1891.139118, "o", "\t// feature subset: use all features but limit split search by selecting features\r\n\t\tselected := rng.Perm(m)\r\n\t\tselected = selected[:mf]\r\n"]
[1891.139195, "o", "\t\tsubFeatures := []string{}\r\n\t\tsubX := make([][]float64, len(bootX))\r\n\t\tfor r := range bootX {\r\n\t\t\tsubX[r] = []float64{}\r\n\t\t\tfor _, s := range selected {\r\n"]
[1891.139281, "o", "\t\t\t\tsubX[r] = append(subX[r], bootX[r][s])\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor _, s := range selected {\r\n\t\t\tsubFeatures = append(subFeatures, features[s])\r\n\t\t}\r\n"]
[1891.139797, "o", "\u001b[?2004h"]
