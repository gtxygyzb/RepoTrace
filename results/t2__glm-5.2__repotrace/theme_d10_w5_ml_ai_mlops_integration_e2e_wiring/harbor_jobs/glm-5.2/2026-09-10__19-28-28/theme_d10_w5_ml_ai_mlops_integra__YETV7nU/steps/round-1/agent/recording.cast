[10422.33058, "o", "\t\t\t\tprintError(\"--param requires key=value\")\r\n   107\t\t\t\t\treturn\r\n   108\t\t\t\t}\r\n   109\t\t\t\toverrides[k] = v\r\n   110\t\t\tcase strings.HasPrefix(args[i], \"--param=\"):\r\n   111\t\t\t\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n   112\t\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n   113\t\t\t\tif !ok {\r\n   114\t\t\t\t\tprintError(\"--param requires key=value\")\r\n   115\t\t\t\t\treturn\r\n   116\t\t\t\t}\r\n   117\t\t\t\toverrides[k] = v\r\n   118\t\t\tdefault:\r\n"]
[10422.330656, "o", "   119\t\t\t\tif configPath == \"\" && !strings.HasPrefix(args[i], \"--\") {\r\n   120\t\t\t\t\tconfigPath = args[i]\r\n   121\t\t\t\t} else {\r\n   122\t\t\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n   123\t\t\t\t\treturn\r\n   124\t"]
[10422.330735, "o", "\t\t\t}\r\n   125\t\t\t}\r\n   126\t\t}\r\n   127\t\tif configPath == \"\" {\r\n   128\t\t\tprintError(\"usage: mlpipe validate <config.json> [--param key=value ...]\")\r\n   129\t\t\treturn\r\n   130\t\t}\r\n   131\t\tconfig, err := loadConfig(configPath)\r\n   132\t\tif err != nil {\r\n   133\t\t\tprintError(err.Error())\r\n   134\t\t\treturn\r\n"]
[10422.330781, "o", "   135\t\t}\r\n   136\t\tif len(overrides) > 0 {\r\n   137\t\t\tglobals := config.globalParams(overrides)\r\n   138\t\t\tconfig.Pipeline.Params = globals\r\n   139\t\t\tfor i := range config.Stages {\r\n   140\t\t\t\tconfig.Stages[i].Params = config.stageParams(config.Stages[i].Name, globals)\r\n   141\t\t\t}\r\n   142\t\t}\r\n   143\t\tvalid, errors := config.Validate()\r\n   144\t\tprintJSON(map[string]interface{}{\"valid\": valid, \"errors\": errors})\r\n   145\t}\r\n"]
