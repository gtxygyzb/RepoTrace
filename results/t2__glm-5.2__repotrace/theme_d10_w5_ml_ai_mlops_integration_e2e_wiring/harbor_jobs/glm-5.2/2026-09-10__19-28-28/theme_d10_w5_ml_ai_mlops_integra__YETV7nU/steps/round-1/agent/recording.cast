[10980.232148, "o", "func saveRunAny(pipelineName string, run interface{}) error {\r\n\tdir := filepath.Join(\".mlpipe\", \"runs\")\r\n\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n\t\treturn err\r\n"]
[10980.232276, "o", "\t}\r\n\tname := safeFileName(pipelineName)\r\n\tif name == \"\" {\r\n\t\tname = \"pipeline\"\r\n\t}\r\n\tpath := filepath.Join(dir, fmt.Sprintf(\"%s-%d.json\", name, time.Now().UnixNano()))\r\n\tdata, err := json.MarshalIndent(run, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(path, data, 0644)\r\n"]
[10980.232354, "o", "}\r\n\r\nfunc safeFileName(s string) string {\r\n\tif s == \"\" {\r\n\t\treturn \"pipeline\"\r\n\t}\r\n\treturn strings.Map(func(r rune) rune {\r\n\t\tif r == '/' || r == '\\\\' || r == ':' || r == ' ' {\r\n\t\t\treturn '_'\r\n\t\t}\r\n\t\treturn r\r\n\t}, s)\r\n}\r\n"]
[10980.232402, "o", "\r\n"]
