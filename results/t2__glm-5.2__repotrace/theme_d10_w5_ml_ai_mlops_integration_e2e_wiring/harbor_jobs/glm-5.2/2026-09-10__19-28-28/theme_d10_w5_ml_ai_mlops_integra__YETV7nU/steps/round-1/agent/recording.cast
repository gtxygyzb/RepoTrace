[1874.257668, "i", "python3 - <<'PY'\np='main.go'\ns=open(p).read()\nold='''    entries, err := listRegistry(name, stage, tag)\n    if err != nil {\n        printError(err.Error())\n        return\n    }\n    printJSON(entries)'''\nnew='''    entries, err := listRegistry(name, stage, tag)\n    if err != nil {\n        printError(err.Error())\n        return\n    }\n    out := make([]map[string]interface{}, len(entries))\n    for i, e := range entries {\n        out[i] = map[string]interface{}{\n            \"name\":          e.Name,\n            \"version\":       e.Version,\n            \"stage\":         e.Stage,\n            \"tags\":          e.Tags,\n            \"metrics\":       e.Metrics,\n            \"registered_at\": e.RegisteredAt,\n        }\n    }\n    printJSON(out)'''\nif old not in s:\n    raise SystemExit('pattern not found main list')\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\n"]
