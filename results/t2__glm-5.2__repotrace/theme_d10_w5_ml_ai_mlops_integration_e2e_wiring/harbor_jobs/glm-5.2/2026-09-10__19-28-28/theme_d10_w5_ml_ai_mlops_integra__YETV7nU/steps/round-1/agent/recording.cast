[10639.948109, "o", "\u001b[?2004h> "]
[10639.948455, "o", "\\tentry, prev, new, warnings, err := promoteModel(name, version, target, force)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10639.948541, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[10639.948596, "o", "\u001b[?2004h> "]
[10639.948788, "o", "\\t\\tif strings.HasPrefix(err.Error(), \"metric \") {\r\n\u001b[?2004l\r"]
[10639.948842, "o", "\u001b[?2004h> "]
[10639.949161, "o", "\\t\\t\\tprintJSON(map[string]interface{}{\"success\": false, \"message\": err.Error()})\r\n\u001b[?2004l\r"]
[10639.949226, "o", "\u001b[?2004h> "]
[10639.949282, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h"]
[10639.949339, "o", "> \\t\\t}\r\n\u001b[?2004l\r"]
[10639.949395, "o", "\u001b[?2004h> "]
[10639.949494, "o", "\\t\\tprintError(err.Error())\r\n\u001b[?2004l\r"]
[10639.949548, "o", "\u001b[?2004h> "]
[10639.949613, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[10639.949674, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10639.94988, "o", "\\tmessage := fmt.Sprintf(\"promoted to %s\", new)\r\n\u001b[?2004l\r"]
[10639.949934, "o", "\u001b[?2004h> "]
[10639.949993, "o", "\\tif force {\r\n\u001b[?2004l\r\u001b[?2004h"]
[10639.950047, "o", "> "]
