[1943.159856, "o", "\u001b[?2004h> "]
[1943.159995, "o", "    bestThreshold := 0.0\r\n\u001b[?2004l\r"]
[1943.16005, "o", "\u001b[?2004h> "]
[1943.160225, "o", "    bestLeftIdx := []int(nil)\r\n\u001b[?2004l\r"]
