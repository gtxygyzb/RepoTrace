[12190.239102, "o", "   180\t\t\tif edges[i].From != edges[j].From {\r\n   181\t\t\t\treturn edges[i].From < edges[j].From\r\n   182\t\t\t}\r\n   183\t\t\tif edges[i].To != edges[j].To {\r\n   184\t\t\t\treturn edges[i].To < edges[j].To\r\n   185\t\t\t}\r\n   186\t\t\treturn edges[i].Port < edges[j].Port\r\n   187\t\t})\r\n   188\t\r\n   189\t\treturn &PlanOutput{\r\n   190\t\t\tPipeline:       config.Pipeline.Name,\r\n   191\t\t\tMode:           mode,\r\n   192\t\t\tCVFolds:        cv,\r\n"]
