[12321.031007, "o", "    62\tfunc runStatus(run interface{}) string {\r\n    63\t\tswitch r := run.(type) {\r\n    64\t\tcase *RunOutput:\r\n    65\t\t\treturn r.Status\r\n"]
[12321.031055, "o", "    66\t\tcase *CVRunOutput:\r\n    67\t\t\treturn r.Status\r\n    68\t\tdefault:\r\n    69\t\t\treturn \"success\"\r\n    70\t\t}\r\n    71\t}\r\n    72\t\r\n"]
[12321.031195, "o", "    73\tfunc buildRunRecord(executor *Executor, startedAt time.Time, finishedAt time.Time, status string) *RunRecord {\r\n    74\t\tmode := \"standard\"\r\n    75\t\tvar cvFolds *int\r\n    76\t\tif executor.cvFolds > 0 {\r\n    77\t\t\tmode = \"cv\"\r\n    78\t\t\tf := executor.cvFolds\r\n    79\t\t\tcvFolds = &f\r\n    80\t\t}\r\n    81\t\r\n    82\t\tskipped := []string{}\r\n    83\t\tskipped = append(skipped, executor.skipStages...)\r\n    84\t\r\n    85\t\tsummary := map[string]StageSummary{}\r\n    86\t\tfor name, r := range executor.results {\r\n    87\t\t\tif r == nil {\r\n    88\t\t\t\tcontinue\r\n    89\t\t\t}\r\n    90\t\t\tsummary[name] = StageSummary{\r\n    91\t\t\t\tStatus:     r.Status,"]
[12321.031285, "o", "\r\n    92\t\t\t\tCacheHit:   r.CacheHit,\r\n    93\t\t\t\tDurationMs: r.DurationMs,\r\n    94\t\t\t}\r\n    95\t\t}\r\n    96\t\r\n    97\t\tvar cacheStats *CacheStats\r\n    98\t\tif !executor.noCache {\r\n    99\t\t\tcacheStats = executor.cacheStats\r\n   100\t\t\tif cacheStats == nil {\r\n   101\t\t\t\tcacheStats = &CacheStats{}\r\n"]
[12321.031356, "o", "   102\t\t\t}\r\n   103\t\t}\r\n   104\t\r\n   105\t\treturn &RunRecord{\r\n   106\t\t\tRunID:         strconv.FormatInt(finishedAt.UnixMilli(), 10),\r\n   107\t\t\tPipeline:      executor.config.Pipeline.Name,\r\n   108\t\t\tStartedAt:     startedAt.UTC().Format(time.RFC3339),\r\n   109\t\t\tFinishedAt:    finishedAt.UTC().Format(time.RFC3339),\r\n   110\t\t\tDurationMs:    finishedAt.Sub(startedAt).Milliseconds(),\r\n   111\t\t\tStatus:        status,\r\n   112\t\t\tMode:          mode,\r\n   113"]
[12321.031416, "o", "\t\t\tCvFolds:       cvFolds,\r\n   114\t\t\tNoCache:       executor.noCache,\r\n   115\t\t\tSkippedStages: skipped,\r\n   116\t\t\tStageSummary:  summary,\r\n   117\t\t\tCacheStats:    cacheStats,\r\n   118\t\t}\r\n   119\t}\r\n   120\t\r\n"]
