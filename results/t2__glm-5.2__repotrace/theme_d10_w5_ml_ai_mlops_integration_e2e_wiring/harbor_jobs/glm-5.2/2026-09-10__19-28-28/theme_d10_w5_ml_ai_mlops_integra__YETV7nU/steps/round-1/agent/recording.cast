[1943.42962, "i", "python3 - <<'PY'\nimport re\np='main.go'\ns=open(p).read()\nold='''entries, err := listRegistry(name, stage, tag)\n    if err != nil {\n        printError(err.Error())\n        return\n    }\n    printJSON(entries)'''\nnew='''entries, err := listRegistry(name, stage, tag)\n    if err != nil {\n        printError(err.Error())\n        return\n    }\n    out := make([]map[string]interface{}, len(entries))\n    for i, e := range entries {\n        out[i] = map[string]interface{}{\n            \"name\":          e.Name,\n            \"version\":       e.Version,\n            \"stage\":         e.Stage,\n            \"tags\":          e.Tags,\n            \"metrics\":       e.Metrics,\n            \"registered_at\": e.RegisteredAt,\n        }\n    }\n    printJSON(out)'''\n# normalize spaces to tabs? just use regex\npat=re.compile(r'entries, err := listRegistry\\(name, stage, tag\\)\\s+if err != nil \\{\\s+printError\\(err\\.Error\\(\\)\\)\\s+return\\s+\\}\\s+printJSON\\(entries\\)', re.S)\ns2=pat.sub(new, s, count=1)\nif s2==s:\n    raise SystemExit('main list patch fail"]
[1943.429821, "i", "ed')\nopen(p,'w').write(s2)\nPY\n"]
