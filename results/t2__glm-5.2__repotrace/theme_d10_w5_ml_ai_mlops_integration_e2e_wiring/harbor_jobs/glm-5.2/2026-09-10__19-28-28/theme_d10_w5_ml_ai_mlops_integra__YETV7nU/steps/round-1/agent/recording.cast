[11870.346661, "o", "\t\t\t\te.cacheStats.Misses++\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\te.status[name] = \"success\"\r\n"]
[11870.346726, "o", "\t\te.results[name].Status = \"success\"\r\n\t\tts := time.Now().UnixNano()\r\n\r\n\t\tfor port, val := range out {\r\n\t\t\tid := artifactID(e.config.Pipeline.Name, name, port, ts)\r\n\t\t\te.values[name][port] = val\r\n\t\t\te.outputs[name][port] = id\r\n\t\t\ttyp := val.Type()\r\n"]
[11870.346791, "o", "\t\t\tsummary := val.Summary()\r\n\t\t\tmeta := &ArtifactMeta{\r\n\t\t\t\tID:        id,\r\n\t\t\t\tStage:     name,\r\n\t\t\t\tPort:      port,\r\n\t\t\t\tType:      typ,\r\n\t\t\t\tSummary:   summary,\r\n"]
[11870.34685, "o", "\t\t\t\tInputs:    inputIDs,\r\n\t\t\t\tOutputs:   []string{},\r\n\t\t\t\tTimestamp: ts,\r\n\t\t\t}\r\n\t\t\te.meta[id] = meta\r\n\t\t\tfor _, inID := range inputIDs {\r\n\t\t\t\tif parent, ok := e.meta[inID]; ok {\r\n\t\t\t\t\tparent.Outputs = appendUnique(parent.Outputs, id)\r\n\t\t\t\t}\r\n"]
[11870.346914, "o", "\t\t\t}\r\n\t\t\trunArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n\t\t}\r\n\t}\r\n\r\n\tstatus := \"success\"\r\n\tfor _, s := range e.results {\r\n\t\tif s.Status == \"failed\" {\r\n\t\t\tstatus = \"failed\"\r\n\t\t\tbreak"]
[11870.346973, "o", "\r\n\t\t}\r\n\t}\r\n\r\n\trun := &RunOutput{\r\n\t\tPipeline:   e.config.Pipeline.Name,\r\n\t\tStatus:     status,\r\n"]
[11870.347031, "o", "\t\tStages:     e.results,\r\n\t\tArtifacts:  runArtifacts,\r\n\t\tCacheStats: e.cacheStats,\r\n\t}\r\n\r\n\tif err := saveArtifacts(e.meta); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\treturn run, nil\r\n}\r\n\r\nfunc (e *Executor) inputCacheKeys(stage *StageConfig) map[string]string {\r\n\tkeys := map[string]string{}\r\n\tfor local, ref := range stage.Inputs {\r\n"]
[11870.347089, "o", "\t\trefs, ok := inputRefs(ref)\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfor _, r := range refs {\r\n\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n\t\t\tif len(parts) != 2 {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tdepStage := parts[0]\r\n\t\t\tif key, ok := e.cacheKeys[depStage]; ok {\r\n\t\t\t"]
[11870.347146, "o", "\tkeys[local] = keys[local] + key + \"\\n\"\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tfor k, v := range keys {\r\n\t\tkeys[k] = strings.TrimRight(v, \"\\n\")\r\n\t}\r\n\treturn keys\r\n}\r\n\r\nfunc (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {\r\n"]
[11870.347208, "o", "\tinputs := map[string]*ArtifactValue{}\r\n\tids := []string{}\r\n\tfor local, ref := range stage.Inputs {\r\n\t\trefs, ok := inputRefs(ref)\r\n\t\tif !ok {\r\n\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q has invalid reference %v\", stage.Name, local, ref)\r\n\t\t}\r\n\t\tvar firstVal *ArtifactValue\r\n\t\tfor _, r := range refs {\r\n"]
[11870.347337, "o", "\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n\t\t\tif len(parts) != 2 {\r\n\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q has invalid input reference %q\", stage.Name, r)\r\n\t\t\t}\r\n\t\t\tdepStage, port := parts[0], parts[1]\r\n\t\t\tid, ok := e.outputs[depStage][port]\r\n\t\t\tif !ok {\r\n\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable output %s.%s\", stage.Name, local, depStage, port)\r\n\t\t\t}\r\n\t\t\tval, ok := e.values[depStage][port]\r\n\t\t\tif !ok || val == nil {\r\n"]
[11870.347454, "o", "\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable artifact %s.%s\", stage.Name, local, depStage, port)\r\n\t\t\t}\r\n\t\t\tids = append(ids, id)\r\n\t\t\tif firstVal == nil {\r\n\t\t\t\tfirstVal = val\r\n\t\t\t}\r\n\t\t\tif stage.Type == \"ensemble\" && local == \"models\" {\r\n\t\t\t\tinputs[local+\"_\"+r] = val\r\n\t\t\t}\r\n\t\t}\r\n\t\tif _, exists := inputs[local]; !exists {\r\n\t\t\tinputs[local] = firstVal\r\n\t\t}\r\n\t}\r\n\treturn inputs, ids, nil\r\n}\r\n\r\nfunc executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tswitch stage.Type {\r\n"]
