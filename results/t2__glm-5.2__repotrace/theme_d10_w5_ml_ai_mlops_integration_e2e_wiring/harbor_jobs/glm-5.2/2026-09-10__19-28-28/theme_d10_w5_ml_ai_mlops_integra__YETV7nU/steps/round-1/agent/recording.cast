[12583.050575, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n"]
[12583.050651, "o", "     6\t\t\"os\"\r\n     7\t\t\"path/filepath\"\r\n     8\t\t\"sort\"\r\n     9\t\t\"strconv\"\r\n    10\t\t\"strings\"\r\n    11\t\t\"time\"\r\n    12\t)\r\n    13\t\r\n    14\ttype StageSummary struct {\r\n    15\t\tStatus     string `json:\"status\"`\r\n    16\t\tCacheHit   bool   `json:\"cache_hit\"`\r\n    17\t\tDurationMs int64  `json:\"duration_ms\"`\r\n"]
[12583.050727, "o", "    18\t}\r\n    19\t\r\n    20\ttype FoldStageSummary struct {\r\n    21\t\tStatus   string `json:\"status\"`\r\n    22\t\tCacheHit bool   `json:\"cache_hit,omitempty\"`\r\n    23\t}\r\n    24\t\r\n    25\ttype FoldSummary map[string]FoldStageSummary\r\n    26\t\r\n    27\ttype RunRecord struct {\r\n    28\t\tRunID         string                  `json:\"run_id\"`\r\n    29\t\tPipeline      string                  `json:\"pipeline\"`\r\n"]
[12583.050793, "o", "    30\t\tStartedAt     string                  `json:\"started_at\"`\r\n    31\t\tFinishedAt    string                  `json:\"finished_at\"`\r\n    32\t\tDurationMs    int64                   `json:\"duration_ms\"`\r\n    33\t\tStatus        string                  `json:\"status\"`\r\n    34\t\tMode          string                  `json:\"mode\"`\r\n    35\t\tCvFolds       *int                    `json:\"cv_folds\"`\r\n    36\t\tNoCache       bool                    `json:\"no_cache\"`\r\n    37\t\tSkippedStages []string                `json:\"skipped_stages\"`\r\n    38\t\tStageSummary  map[string]interface{} `json:\"stage_summary\"`\r\n"]
[12583.050858, "o", "    39\t\tCacheStats    *CacheStats             `json:\"cache_stats\"`\r\n    40\t}\r\n    41\t\r\n    42\ttype HistoryRun struct {\r\n    43\t\tRunID      string `json:\"run_id\"`\r\n    44\t\tPipeline   string `json:\"pipeline\"`\r\n    45\t\tStatus     string `json:\"status\"`\r\n    46\t\tStartedAt  string `json:\"started_at\"`\r\n    47\t\tDurationMs int64  `json:\"duration_ms\"`\r\n    48\t\tMode       string `json:\"mode\"`\r\n"]
[12583.050924, "o", "    49\t}\r\n    50\t\r\n    51\ttype HistoryOutput struct {\r\n    52\t\tRuns  []HistoryRun `json:\"runs\"`\r\n    53\t\tCount int          `json:\"count\"`\r\n    54\t}\r\n    55\t\r\n    56\tfunc saveRunRecord(record *RunRecord) error {\r\n    57\t\tdir := filepath.Join(\".mlpipe\", \"runs\")\r\n    58\t\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n    59\t\t\t"]
[12583.050984, "o", "return err\r\n    60\t\t}\r\n    61\t\tpath := filepath.Join(dir, fmt.Sprintf(\"%s.json\", record.RunID))\r\n    62\t\tdata, err := json.MarshalIndent(record, \"\", \"  \")\r\n    63\t\tif err != nil {\r\n    64\t\t\treturn err\r\n    65\t\t}\r\n"]
[12583.051046, "o", "    66\t\treturn os.WriteFile(path, data, 0644)\r\n    67\t}\r\n    68\t\r\n    69\tfunc runStatus(run interface{}) string {\r\n    70\t\tswitch r := run.(type) {\r\n    71\t\tcase *RunOutput:\r\n    72\t\t\treturn r.Status\r\n    73\t\tcase *CVRunOutput:\r\n    74"]
[12583.051103, "o", "\t\t\treturn r.Status\r\n    75\t\tdefault:\r\n    76\t\t\treturn \"success\"\r\n    77\t\t}\r\n    78\t}\r\n    79\t\r\n    80\tfunc buildRunRecord(executor *Executor, startedAt time.Time, finishedAt time.Time, status string) *RunRecord {\r\n    81\t\tmode := \"standard\"\r\n"]
[12583.051168, "o", "    82\t\tvar cvFolds *int\r\n    83\t\tif executor.cvFolds > 0 {\r\n    84\t\t\tmode = \"cv\"\r\n    85\t\t\tf := executor.cvFolds\r\n    86\t\t\tcvFolds = &f\r\n    87\t\t}\r\n    88\t\r\n    89\t\tskipped := []string{}\r\n    90\t\tskipped = append(skipped, executor.skipStages...)\r\n    91\t\r\n"]
