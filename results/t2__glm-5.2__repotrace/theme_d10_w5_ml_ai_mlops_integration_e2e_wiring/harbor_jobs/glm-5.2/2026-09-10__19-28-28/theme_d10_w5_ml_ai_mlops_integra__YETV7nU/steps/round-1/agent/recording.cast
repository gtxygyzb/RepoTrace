[1776.987757, "o", "\t\tw[j] -= lr * grad[j] / float64(n)\r\n\t\t}\r\n\t}\r\n\treturn w, nil\r\n}\r\n\r\nfunc trainDecisionTree(X [][]float64, y []float64, features []string, classification bool, depth, maxDepth, minSplit int) *TreeNode {\r\n\tnode := &TreeNode{}\r\n\tif len(y) == 0 {\r\n"]
[1776.98783, "o", "\t\tnode.IsLeaf = true\r\n\t\treturn node\r\n\t}\r\n\tmean := 0.0\r\n\tfor _, v := range y {\r\n\t\tmean += v\r\n\t}\r\n\tmean /= float64(len(y))\r\n\r\n\tif depth >= maxDepth || len(y) < minSplit || len(features) == 0 {\r\n\t\tnode.IsLeaf = true\r\n\t\tnode.Prediction = mean\r\n"]
