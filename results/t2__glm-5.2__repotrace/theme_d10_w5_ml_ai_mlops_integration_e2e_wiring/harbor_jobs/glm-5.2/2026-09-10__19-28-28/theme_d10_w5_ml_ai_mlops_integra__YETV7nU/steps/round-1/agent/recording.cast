[8789.958551, "o", "   168\t\tname, version, ok := splitNameVersion(args[0])\r\n   169\t\tif !ok {\r\n   170\t\t\tprintError(\"invalid name:version format\")\r\n   171\t\t\treturn\r\n   172\t\t}\r\n   173\t\tentry, err := registryInfo(name, version)\r\n   174\t\tif err != nil {\r\n   175\t\t\tprintError(err.Error())\r\n"]
