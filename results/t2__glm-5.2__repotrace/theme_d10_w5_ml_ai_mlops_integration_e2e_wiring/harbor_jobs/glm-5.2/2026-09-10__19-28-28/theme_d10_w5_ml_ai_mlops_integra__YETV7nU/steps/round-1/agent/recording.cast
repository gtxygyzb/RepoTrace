[5326.158051, "o", "\u001b[?2004h> "]
[5326.158179, "o", "        metricCounts := map[string]int{}\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.15827, "o", "> "]
[5326.15838, "o", "        for _, name := range postSplitOrder {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.158435, "o", "> "]
[5326.158603, "o", "            stage, _ := e.config.stageByName(name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.158657, "o", "> "]
[5326.158797, "o", "            if stage.Type != \"evaluate\" {\r\n\u001b[?2004l\r"]
[5326.158851, "o", "\u001b[?2004h> "]
