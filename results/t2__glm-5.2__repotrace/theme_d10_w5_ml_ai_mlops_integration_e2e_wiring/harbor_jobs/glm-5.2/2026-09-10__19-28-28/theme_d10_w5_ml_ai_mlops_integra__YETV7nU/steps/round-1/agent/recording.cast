[7578.853469, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\np = Path('evaluate.go')\ns = p.read_text()\n\ns = re.sub(\n    r'''\\tif ssTot == 0 \\{\\n\\t\\t\\treturn 0\\.0, nil\\n\\t\\}\\n\\t\\treturn 1 - ssRes/ssTot, nil''',\n    '''\\tif ssTot == 0 {\n\\t\\t\\tif ssRes == 0 {\n\\t\\t\\t\\treturn 1.0, nil\n\\t\\t\\t}\n\\t\\t\\treturn nil, nil\n\\t\\t}\n\\t\\treturn 1 - ssRes/ssTot, nil''',\n    s,\n    count=1,\n)\n\ns = re.sub(\n    r'''\\t\\tif count == 0 \\{\\n\\t\\t\\treturn 0\\.0, nil\\n\\t\\}\\n\\t\\treturn sum / count \\* 100, nil''',\n    '''\\t\\tif count == 0 {\n\\t\\t\\treturn nil, nil\n\\t\\t}\n\\t\\treturn sum / count * 100, nil''',\n    s,\n    count=1,\n)\n\np.write_text(s)\nPY\n"]
