[10979.378438, "o", "if err := saveRunAny(e.config.Pipeline.Name, run); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\treturn run, nil\r\n}\r\n\r\nfunc (e *Executor) inputCacheKeys(stage *StageConfig) map[string]string {\r\n\tkeys := map[string]string{}\r\n\tfor local, ref := range stage.Inputs {\r\n\t\trefs, ok := inputRefs(ref)\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n"]
