[10944.144644, "o", "\t}\r\n   145\t\t}\r\n   146\t\tvalid, errors := config.Validate()\r\n   147\t\tprintJSON(map[string]interface{}{\"valid\": valid, \"errors\": errors})\r\n   148\t}\r\n   149\t\r\n   150\tfunc cmdRegistry(args []string) {\r\n   151\t\tif len(args) < 1 {\r\n   152\t\t\tprintError(\"usage: mlpipe registry <list|info|promote|compare> [args]\")\r\n   153\t\t\treturn\r\n   154\t\t}\r\n   155\t\tsub := args[0]\r\n   156\t\trest := args[1:]\r\n   157\t\tswitch sub {\r\n   158\t\tcase \"list\":\r\n   159\t\t\tcmdRegistryList(rest)\r\n   160\t\tcase \"info\":\r\n   161\t\t\tcmdRegistryInfo(rest)\r\n   162\t"]
[10944.144747, "o", "\tcase \"promote\":\r\n   163\t\t\tcmdRegistryPromote(rest)\r\n   164\t\tcase \"compare\":\r\n   165\t\t\tcmdRegistryCompare(rest)\r\n   166\t\tdefault:\r\n   167\t\t\tprintError(fmt.Sprintf(\"unknown registry command: %s\", sub))\r\n   168\t\t}\r\n   169\t}\r\n   170\t\r\n   171\tfunc cmdRegistryList(args []string) {\r\n   172\t\tname, stage, tag := \"\", \"\", \"\"\r\n   173\t\tfor i := 0; i < len(args); i++ {\r\n   174\t\t\tswitch {\r\n   175\t\t\tcase args[i] == \"--name\" && i+1 < len(args):\r\n"]
