[7658.186509, "o", "\tcase \"r2\":\r\n\t\tmean := 0.0\r\n\t\tfor _, v := range y {\r\n\t\t\tmean += v\r\n\t\t}\r\n"]
[7658.186538, "o", "\t\tmean /= n\r\n\t\tssRes := 0.0\r\n\t\tssTot := 0.0\r\n\t\tfor i := range y {\r\n"]
[7658.186687, "o", "\t\t\tssRes += (y[i] - preds[i]) * (y[i] - preds[i])\r\n\t\t\tssTot += (y[i] - mean) * (y[i] - mean)\r\n\t\t}\r\n\t\tif ssTot == 0 {\r\n\t\t\tif ssRes == 0 {\r\n\t\t\t\treturn 1.0, nil\r\n\t\t\t}\r\n\t\t\treturn nil, nil\r\n\t\t}\r\n\t\treturn 1 - ssRes/ssTot, nil\r\n\tcase \"mape\":\r\n\t\tsum := 0.0\r\n\t\tcount := 0.0\r\n\t\tfor i := range y {\r\n\t\t\tif y[i] == 0 {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tsum += math.Abs((y[i] - preds[i]) / y[i])\r\n\t\t\tcount++\r\n\t\t}\r\n\t\tif count == 0 {\r\n\t\t\treturn nil, nil\r\n\t\t}\r\n"]
[7658.186783, "o", "\t\treturn sum / count * 100, nil\r\n\t}\r\n\treturn nil, fmt.Errorf(\"unknown regression metric %q\", name)\r\n}\r\n"]
