[4931.394127, "o", "    Misses int `json:\"misses\"`\r\n\u001b[?2004l\r"]
[4931.394183, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4931.394247, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rv\u001b[?2004h"]
[4931.394314, "o", "> "]
[4931.394402, "o", "type Executor struct {\r\n\u001b[?2004l\r"]
[4931.394456, "o", "\u001b[?2004h> "]
[4931.394564, "o", "    config     *Config\r\n\u001b[?2004l\r"]
[4931.39462, "o", "\u001b[?2004h> "]
[4931.394825, "o", "    globals    map[string]interface{}\r\n\u001b[?2004l\r"]
[4931.394879, "o", "\u001b[?2004h> "]
[4931.395045, "o", "    status     map[string]string\r\n\u001b[?2004l\r"]
[4931.3951, "o", "\u001b[?2004h> "]
[4931.395304, "o", "    results    map[string]*StageResult\r\n\u001b[?2004l\r"]
[4931.395361, "o", "\u001b[?2004h> "]
[4931.395583, "o", "    outputs    map[string]map[string]string\r\n\u001b[?2004l\r"]
[4931.39564, "o", "\u001b[?2004h> "]
[4931.395905, "o", "    values     map[string]map[string]*ArtifactValue\r\n\u001b[?2004l\r"]
[4931.395961, "o", "\u001b[?2004h> "]
[4931.396166, "o", "    meta       map[string]*ArtifactMeta\r\n\u001b[?2004l\r"]
[4931.396232, "o", "\u001b[?2004h> "]
[4931.396389, "o", "    cacheKeys  map[string]string\r\n\u001b[?2004l\r"]
[4931.396446, "o", "\u001b[?2004h> "]
[4931.396551, "o", "    noCache    bool\r\n\u001b[?2004l\r"]
[4931.396607, "o", "\u001b[?2004h> "]
[4931.396701, "o", "    cvFolds     int\r\n\u001b[?2004l\r"]
[4931.396756, "o", "\u001b[?2004h> "]
[4931.39691, "o", "    cacheStats *CacheStats\r\n\u001b[?2004l\r"]
[4931.402327, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.402578, "o", "func NewExecutor(config *Config, overrides map[string]string) *Executor {\r\n\u001b[?2004l\r"]
[4931.402637, "o", "\u001b[?2004h> "]
[4931.402764, "o", "    return &Executor{\r\n\u001b[?2004l\r"]
[4931.402821, "o", "\u001b[?2004h> "]
[4931.402984, "o", "        config:     config,\r\n\u001b[?2004l\r"]
[4931.403041, "o", "\u001b[?2004h> "]
[4931.403366, "o", "        globals:    config.globalParams(overrides),\r\n\u001b[?2004l\r"]
[4931.403425, "o", "\u001b[?2004h> "]
[4931.403666, "o", "        status:     map[string]string{},\r\n\u001b[?2004l\r"]
[4931.403723, "o", "\u001b[?2004h> "]
[4931.404001, "o", "        results:    map[string]*StageResult{},\r\n\u001b[?2004l\r"]
[4931.404058, "o", "\u001b[?2004h> "]
[4931.404369, "o", "        outputs:    map[string]map[string]string{},\r\n\u001b[?2004l\r"]
[4931.404427, "o", "\u001b[?2004h> "]
[4931.404786, "o", "        values:     map[string]map[string]*ArtifactValue{},\r\n\u001b[?2004l\r"]
[4931.404841, "o", "\u001b[?2004h> "]
[4931.405139, "o", "        meta:       map[string]*ArtifactMeta{},\r\n\u001b[?2004l\r"]
[4931.405194, "o", "\u001b[?2004h> "]
[4931.405447, "o", "        cacheKeys:  map[string]string{},\r\n\u001b[?2004l\r"]
[4931.405503, "o", "\u001b[?2004h> "]
[4931.405707, "o", "        cacheStats: &CacheStats{},\r\n\u001b[?2004l\r"]
[4931.405754, "o", "\u001b[?2004h> "]
[4931.405799, "o", "    }\r\n\u001b[?2004l\r"]
[4931.405854, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4931.405902, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4931.405961, "o", "\u001b[?2004h> "]
[4931.406253, "o", "func (e *Executor) Run() (*RunOutput, error) {\r\n\u001b[?2004l\r"]
[4931.406323, "o", "\u001b[?2004h> "]
[4931.406549, "o", "    valid, errs := e.config.Validate()\r\n\u001b[?2004l\r"]
[4931.406603, "o", "\u001b[?2004h> "]
[4931.406688, "o", "    if !valid {\r\n\u001b[?2004l\r"]
[4931.406743, "o", "\u001b[?2004h> "]
[4931.407133, "o", "        return nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n\u001b[?2004l\r"]
[4931.407188, "o", "\u001b[?2004h> "]
[4931.40726, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.407562, "o", "    order, err := e.config.topologicalOrder()\r\n\u001b[?2004l\r"]
[4931.407617, "o", "\u001b[?2004h> "]
[4931.407732, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[4931.407787, "o", "\u001b[?2004h> "]
[4931.407937, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[4931.407993, "o", "\u001b[?2004h> "]
[4931.408046, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.408101, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.408434, "o", "    runArtifacts := map[string]*ArtifactOutput{}\r\n\u001b[?2004l\r"]
[4931.408492, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.408548, "o", "> "]
[4931.408728, "o", "    for _, name := range order {\r\n\u001b[?2004l\r"]
[4931.408785, "o", "\u001b[?2004h> "]
[4931.409082, "o", "        stage, _ := e.config.stageByName(name)\r\n\u001b[?2004l\r"]
[4931.409139, "o", "\u001b[?2004h> "]
[4931.409411, "o", "        e.outputs[name] = map[string]string{}\r\n\u001b[?2004l\r"]
[4931.409468, "o", "\u001b[?2004h> "]
[4931.409791, "o", "        e.values[name] = map[string]*ArtifactValue{}\r\n\u001b[?2004l\r"]
[4931.409847, "o", "\u001b[?2004h> "]
[4931.410396, "o", "        e.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n\u001b[?2004l\r"]
[4931.410453, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4931.410508, "o", "\u001b[?2004h> "]
[4931.410628, "o", "        skip := false\r\n\u001b[?2004l\r"]
[4931.410684, "o", "\u001b[?2004h> "]
[4931.410969, "o", "        for _, dep := range stage.DependsOn {\r\n\u001b[?2004l\r"]
[4931.411024, "o", "\u001b[?2004h> "]
[4931.411305, "o", "            if e.status[dep] != \"success\" {\r\n\u001b[?2004l\r"]
[4931.411363, "o", "\u001b[?2004h> "]
[4931.41151, "o", "                skip = true\r\n\u001b[?2004l\r"]
[4931.411567, "o", "\u001b[?2004h> "]
[4931.411699, "o", "                break\r\n\u001b[?2004l\r"]
[4931.411756, "o", "\u001b[?2004h> "]
[4931.41184, "o", "            }\r\n\u001b[?2004l\r"]
[4931.411896, "o", "\u001b[?2004h> "]
[4931.41195, "o", "        }\r\n\u001b[?2004l\r"]
[4931.412005, "o", "\u001b[?2004h> "]
[4931.412122, "o", "        if skip {\r\n\u001b[?2004l\r"]
[4931.412177, "o", "\u001b[?2004h> "]
[4931.412428, "o", "            e.status[name] = \"skipped\"\r\n\u001b[?2004l\r"]
[4931.412484, "o", "\u001b[?2004h> "]
[4931.412748, "o", "            e.results[name].Status = \"skipped\"\r\n\u001b[?2004l\r"]
[4931.412801, "o", "\u001b[?2004h> "]
[4931.412876, "o", "            continue\r\n\u001b[?2004l\r"]
[4931.412931, "o", "\u001b[?2004h> "]
[4931.412986, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4931.413041, "o", "\u001b[?2004h> "]
[4931.413271, "o", "        inputValues, inputIDs, err := e.resolveInputs(stage)\r\n\u001b[?2004l\r"]
[4931.413326, "o", "\u001b[?2004h> "]
[4931.413421, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[4931.413477, "o", "\u001b[?2004h> "]
[4931.413607, "o", "            e.status[name] = \"failed\"\r\n\u001b[?2004l\r"]
[4931.413665, "o", "\u001b[?2004h> "]
[4931.413844, "o", "            e.results[name].Status = \"failed\"\r\n\u001b[?2004l\r"]
[4931.413898, "o", "\u001b[?2004h> "]
[4931.414072, "o", "            e.results[name].Error = err.Error()\r\n\u001b[?2004l\r"]
[4931.414127, "o", "\u001b[?2004h> "]
[4931.4142, "o", "            continue\r\n\u001b[?2004l\r"]
[4931.414262, "o", "\u001b[?2004h> "]
[4931.414318, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rg"]
[4931.414375, "o", "\u001b[?2004h> "]
[4931.414603, "o", "        params := e.config.stageParams(name, e.globals)\r\n\u001b[?2004l\r"]
[4931.414657, "o", "\u001b[?2004h> "]
[4931.414825, "o", "        inputKeys := e.inputCacheKeys(stage)\r\n\u001b[?2004l\r"]
[4931.414884, "o", "\u001b[?2004h> "]
[4931.415185, "o", "        cacheKey, keyErr := computeCacheKey(stage, params, inputKeys, -1)\r\n\u001b[?2004l\r"]
[4931.415246, "o", "\u001b[?2004h> "]
[4931.41535, "o", "        if keyErr != nil {\r\n\u001b[?2004l\r"]
[4931.415406, "o", "\u001b[?2004h> "]
[4931.415553, "o", "            e.status[name] = \"failed\"\r\n\u001b[?2004l\r"]
[4931.415607, "o", "\u001b[?2004h> "]
[4931.41579, "o", "            e.results[name].Status = \"failed\"\r\n\u001b[?2004l\r"]
[4931.415845, "o", "\u001b[?2004h> "]
[4931.416036, "o", "            e.results[name].Error = keyErr.Error()\r\n\u001b[?2004l\r"]
[4931.416091, "o", "\u001b[?2004h> "]
[4931.416162, "o", "            continue\r\n\u001b[?2004l\r"]
[4931.416224, "o", "\u001b[?2004h> "]
[4931.41628, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.416438, "o", "        e.cacheKeys[name] = cacheKey\r\n\u001b[?2004l\r"]
[4931.416493, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[4931.41668, "o", "        var out map[string]*ArtifactValue\r\n\u001b[?2004l\r"]
[4931.416761, "o", "\u001b[?2004h> "]
[4931.416835, "o", "        start := time.Now()\r\n\u001b[?2004l\r"]
[4931.416892, "o", "\u001b[?2004h> "]
[4931.417102, "o", "        if !e.noCache && cacheEntryExists(cacheKey) {\r\n\u001b[?2004l\r"]
[4931.417156, "o", "\u001b[?2004h> "]
[4931.417365, "o", "            loaded, err := loadCacheEntry(cacheKey)\r\n\u001b[?2004l\r"]
[4931.417422, "o", "\u001b[?2004h> "]
[4931.417637, "o", "            duration := time.Since(start).Milliseconds()\r\n\u001b[?2004l\r"]
[4931.417693, "o", "\u001b[?2004h> "]
[4931.417886, "o", "            e.results[name].DurationMs = duration\r\n\u001b[?2004l\r"]
[4931.417941, "o", "\u001b[?2004h> "]
[4931.418036, "o", "            if err == nil {\r\n\u001b[?2004l\r"]
[4931.418096, "o", "\u001b[?2004h> "]
[4931.41821, "o", "                out = loaded\r\n\u001b[?2004l\r"]
[4931.418271, "o", "\u001b[?2004h> "]
[4931.418451, "o", "                e.results[name].CacheHit = true\r\n\u001b[?2004l\r"]
[4931.418479, "o", "\u001b[?2004h> "]
[4931.418649, "o", "                e.cacheStats.Hits++\r\n\u001b[?2004l\r"]
[4931.418706, "o", "\u001b[?2004h> "]
[4931.418777, "o", "            } else {\r\n\u001b[?2004l\r"]
[4931.418833, "o", "\u001b[?2004h> "]
[4931.41897, "o", "                e.cacheStats.Misses++\r\n\u001b[?2004l\r"]
[4931.419026, "o", "\u001b[?2004h> "]
[4931.419314, "o", "                out, err = executeStage(stage, params, inputValues)\r\n\u001b[?2004l\r"]
[4931.41938, "o", "\u001b[?2004h> "]
[4931.419628, "o", "                duration = time.Since(start).Milliseconds()\r\n\u001b[?2004l\r"]
[4931.419684, "o", "\u001b[?2004h> "]
[4931.4199, "o", "                e.results[name].DurationMs = duration\r\n\u001b[?2004l\r"]
[4931.419957, "o", "\u001b[?2004h> "]
[4931.420078, "o", "                if err != nil {\r\n\u001b[?2004l\r"]
[4931.420133, "o", "\u001b[?2004h> "]
[4931.420321, "o", "                    e.status[name] = \"failed\"\r\n\u001b[?2004l\r"]
[4931.420378, "o", "\u001b[?2004h> "]
[4931.420586, "o", "                    e.results[name].Status = \"failed\"\r\n\u001b[?2004l\r"]
[4931.420642, "o", "\u001b[?2004h> "]
[4931.420865, "o", "                    e.results[name].Error = err.Error()\r\n\u001b[?2004l\r"]
[4931.420921, "o", "\u001b[?2004h> "]
[4931.421024, "o", "                    continue\r\n\u001b[?2004l\r"]
[4931.42108, "o", "\u001b[?2004h> "]
[4931.421135, "o", "                }\r\n\u001b[?2004l\r"]
[4931.421191, "o", "\u001b[?2004h> "]
[4931.421251, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.421307, "o", "> "]
[4931.421357, "o", "        } else {\r\n\u001b[?2004l\r}"]
[4931.421412, "o", "\u001b[?2004h> "]
[4931.421504, "o", "            var err error\r\n\u001b[?2004l\r"]
[4931.421558, "o", "\u001b[?2004h> "]
[4931.42182, "o", "            out, err = executeStage(stage, params, inputValues)\r\n\u001b[?2004l\r"]
[4931.421875, "o", "\u001b[?2004h> "]
[4931.422095, "o", "            duration := time.Since(start).Milliseconds()\r\n\u001b[?2004l\r"]
[4931.42215, "o", "\u001b[?2004h> "]
[4931.422348, "o", "            e.results[name].DurationMs = duration\r\n\u001b[?2004l\r"]
[4931.422405, "o", "\u001b[?2004h> "]
[4931.422502, "o", "            if err != nil {\r\n\u001b[?2004l\r"]
[4931.422558, "o", "\u001b[?2004h> "]
[4931.422716, "o", "                e.status[name] = \"failed\"\r\n\u001b[?2004l\r"]
[4931.422771, "o", "\u001b[?2004h> "]
[4931.422966, "o", "                e.results[name].Status = \"failed\"\r\n\u001b[?2004l\r"]
[4931.423022, "o", "\u001b[?2004h> "]
[4931.423284, "o", "                e.results[name].Error = err.Error()\r\n\u001b[?2004l\r"]
[4931.423348, "o", "\u001b[?2004h> "]
[4931.423432, "o", "                continue\r\n\u001b[?2004l\r"]
[4931.423488, "o", "\u001b[?2004h> "]
[4931.423544, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.423661, "o", "            if !e.noCache {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.423716, "o", "> "]
[4931.423891, "o", "                _ = saveCacheEntry(cacheKey, name, stage.Type, out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.423955, "o", "            }\r\n\u001b[?2004l\r"]
[4931.42401, "o", "\u001b[?2004h> "]
[4931.424099, "o", "            e.cacheStats.Misses++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.424163, "o", "        }\r\n\u001b[?2004l\r(\u001b[?2004h> "]
[4931.424232, "o", "\r\n\u001b[?2004l\rc\u001b[?2004h> "]
[4931.424335, "o", "        e.status[name] = \"success\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.424498, "o", "        e.results[name].Status = \"success\"\r\n\u001b[?2004l\r"]
[4931.424553, "o", "\u001b[?2004h> "]
[4931.424641, "o", "        ts := time.Now().UnixNano()\r\n\u001b[?2004l\r"]
[4931.424696, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.424821, "o", "        for port, val := range out {\r\n\u001b[?2004l\r"]
[4931.424875, "o", "\u001b[?2004h> "]
[4931.425071, "o", "            id := artifactID(e.config.Pipeline.Name, name, port, ts)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.425128, "o", "> "]
[4931.425228, "o", "            e.values[name][port] = val\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.425285, "o", "> "]
[4931.425367, "o", "            e.outputs[name][port] = id\r\n\u001b[?2004l\r"]
[4931.425425, "o", "\u001b[?2004h> "]
[4931.42549, "o", "            typ := val.Type()\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.425546, "o", "> "]
[4931.425626, "o", "            summary := val.Summary()\r\n\u001b[?2004l\r"]
[4931.42568, "o", "\u001b[?2004h> "]
[4931.425767, "o", "            meta := &ArtifactMeta{\r\n\u001b[?2004l\r"]
[4931.425823, "o", "\u001b[?2004h> "]
[4931.425903, "o", "                ID:        id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.425957, "o", "> "]
[4931.426041, "o", "                Stage:     name,\r\n\u001b[?2004l\r"]
[4931.426095, "o", "\u001b[?2004h> "]
[4931.426182, "o", "                Port:      port,\r\n\u001b[?2004l\r"]
[4931.426246, "o", "\u001b[?2004h> "]
[4931.426313, "o", "                Type:      typ,\r\n\u001b[?2004l\r"]
[4931.426368, "o", "\u001b[?2004h> "]
[4931.426472, "o", "                Summary:   summary,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.426528, "o", "> "]
[4931.426619, "o", "                Inputs:    inputIDs,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.426683, "o", "> "]
[4931.426775, "o", "                Outputs:   []string{},\r\n\u001b[?2004l\r"]
[4931.426839, "o", "\u001b[?2004h> "]
[4931.426922, "o", "                Timestamp: ts,\r\n\u001b[?2004l\rd\u001b[?2004h> "]
[4931.426981, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.427063, "o", "> "]
[4931.427144, "o", "            e.meta[id] = meta\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.427281, "o", "            for _, inID := range inputIDs {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.427359, "o", "> "]
[4931.427474, "o", "                if parent, ok := e.meta[inID]; ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.427552, "o", "> "]
[4931.427718, "o", "                    parent.Outputs = appendUnique(parent.Outputs, id)\r\n\u001b[?2004l\r"]
[4931.427784, "o", "\u001b[?2004h> "]
[4931.427848, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.427917, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.428257, "o", "            runArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.428337, "o", "        }\r\n\u001b[?2004l\rn\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4931.428412, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.428499, "o", "    status := \"success\"\r\n\u001b[?2004l\rJo\u001b[?2004h> "]
[4931.428626, "o", "    for _, s := range e.results {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.428772, "o", "        if s.Status != \"success\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.428878, "o", "            status = \"failed\"\r\n\u001b[?2004l\r"]
[4931.428958, "o", "\u001b[?2004h> "]
[4931.429038, "o", "            break\r\n\u001b[?2004l\ra\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.429105, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4931.429161, "o", "\u001b[?2004h> "]
[4931.429239, "o", "    run := &RunOutput{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.429375, "o", "        Pipeline:   e.config.Pipeline.Name,\r\n\u001b[?2004l\r"]
[4931.429431, "o", "\u001b[?2004h> "]
[4931.429502, "o", "        Status:     status,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.429556, "o", "> "]
[4931.429633, "o", "        Stages:     e.results,\r\n\u001b[?2004l\r"]
[4931.429688, "o", "\u001b[?2004h> "]
[4931.429763, "o", "        Artifacts:  runArtifacts,\r\n\u001b[?2004l\r"]
[4931.429817, "o", "\u001b[?2004h> "]
[4931.429909, "o", "        CacheStats: e.cacheStats,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.429964, "o", ">     }\r\n\u001b[?2004l\rs,\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4931.430019, "o", "\u001b[?2004h> "]
[4931.430163, "o", "    if err := saveArtifacts(e.meta); err != nil {\r\n\u001b[?2004l\r"]
[4931.430227, "o", "\u001b[?2004h> "]
[4931.430287, "o", "        return nil, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.430342, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.430489, "o", "    if err := saveRun(run); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.430544, "o", "> "]
[4931.430603, "o", "        return nil, err\r\n\u001b[?2004l\r \u001b[?2004h> "]
[4931.43066, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.430751, "o", "    return run, nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.430807, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rp"]
[4931.430863, "o", "\u001b[?2004h> "]
[4931.431073, "o", "func (e *Executor) inputCacheKeys(stage *StageConfig) map[string]string {\r\n\u001b[?2004l\r"]
[4931.431134, "o", "\u001b[?2004h> "]
[4931.431214, "o", "    keys := map[string]string{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.431375, "o", "    for local, ref := range stage.Inputs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.431537, "o", "        parts := strings.SplitN(ref, \".\", 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.43166, "o", "        if len(parts) != 2 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.431764, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.431845, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.431945, "o", "        depStage := parts[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.432114, "o", "        if key, ok := e.cacheKeys[depStage]; ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.432182, "o", "> "]
[4931.432258, "o", "            keys[local] = key\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.432325, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.43239, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.432472, "o", "    return keys\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4931.432518, "o", "\u001b[?2004h> "]
[4931.432837, "o", "func (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.432917, "o", "> "]
[4931.433008, "o", "    inputs := map[string]*ArtifactValue{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.433095, "o", "    ids := []string{}\r\n\u001b[?2004l\r"]
[4931.433172, "o", "\u001b[?2004h> "]
[4931.433276, "o", "    for local, ref := range stage.Inputs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.433432, "o", "        parts := strings.SplitN(ref, \".\", 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.433509, "o", "> "]
[4931.433586, "o", "        if len(parts) != 2 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.43389, "o", "            return nil, nil, fmt.Errorf(\"stage %q has invalid input reference %q\", stage.Name, ref)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.433967, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.43406, "o", "        depStage, port := parts[0], parts[1]\r\n\u001b[?2004l\r \u001b[?2004h> "]
[4931.434183, "o", "        id, ok := e.outputs[depStage][port]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.434273, "o", "        if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.434599, "o", "            return nil, nil, fmt.Errorf(\"stage %q input %q references unavailable output %s.%s\", stage.Name, local, depStage, port)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.434679, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.434756, "o", "        val, ok := e.values[depStage][port]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.434871, "o", "        if !ok || val == nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.435251, "o", "            return nil, nil, fmt.Errorf(\"stage %q input %q references unavailable artifact %s.%s\", stage.Name, local, depStage, port)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4931.435368, "o", "\u001b[?2004h>         inputs[local] = val\r\n\u001b[?2004l\r  if\u001b[?2004h> "]
[4931.435434, "o", "        ids = append(ids, id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.435492, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.435549, "o", "    return inputs, ids, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4931.435603, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.435904, "o", "func executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.435966, "o", "    switch stage.Type {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.436037, "o", "    case \"data-source\":\r\n\u001b[?2004l\r"]
[4931.436091, "o", "\u001b[?2004h> "]
[4931.436188, "o", "        return executeDataSource(stage, params, inputs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.436263, "o", "    case \"transform\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.436404, "o", "        return executeTransform(stage, params, inputs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.436463, "o", "    case \"split\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.436585, "o", "        return executeSplit(stage, params, inputs)\r\n\u001b[?2004l\r"]
[4931.436641, "o", "\u001b[?2004h>     case \"train\":\r\n\u001b[?2004l\r"]
[4931.436695, "o", "\u001b[?2004h> "]
[4931.436797, "o", "        return executeTrain(stage, params, inputs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.436869, "o", "    case \"evaluate\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.437021, "o", "        return executeEvaluate(stage, params, inputs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.437084, "o", "    case \"register\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.43724, "o", "        return executeRegister(stage, params, inputs)\r\n\u001b[?2004l\rex\u001b[?2004h> "]
[4931.437296, "o", "    }\r\n\u001b[?2004l\rng\u001b[?2004h> "]
[4931.437428, "o", "    return nil, fmt.Errorf(\"unknown stage type %q\", stage.Type)\r\n\u001b[?2004l\r\r\n\u001b[?2004h> }\r\n"]
[4931.437485, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[4931.437801, "o", "func executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.437909, "o", "    path, ok := getString(params, \"path\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.437963, "o", "    if !ok {\r\n\u001b[?2004l\r \u001b[?2004h> "]
[4931.438156, "o", "        return nil, fmt.Errorf(\"data-source stage %q requires path\", stage.Name)\r\n\u001b[?2004l\r"]
[4931.438212, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.438318, "o", "    schema, _ := getMap(params, \"schema\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.438424, "o", "    ds, err := loadDataset(path, schema)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.4385, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.438583, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[4931.43864, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r5\u001b[?2004h> "]
[4931.438774, "o", "    return map[string]*ArtifactValue{\"data\": {Dataset: ds}}, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.438829, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.438965, "o", "func (c *Config) topologicalOrder() ([]string, error) {\r\n\u001b[?2004l\rine\u001b[?2004h> "]
[4931.439063, "o", "    indeg := map[string]int{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.439154, "o", "    adj := map[string][]string{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.439255, "o", "    for _, s := range c.Stages {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.439345, "o", "        indeg[s.Name] = 0\r\n\u001b[?2004l\rh\u001b[?2004h> "]
[4931.4394, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.43946, "o", "    for _, s := range c.Stages {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.43958, "o", "        for _, dep := range s.DependsOn {\r\n\u001b[?2004l\r"]
[4931.439633, "o", "\u001b[?2004h> "]
[4931.43971, "o", "            if _, ok := c.stageByName(dep); ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.439851, "o", "                adj[dep] = append(adj[dep], s.Name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.43995, "o", "                indeg[s.Name]++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.440003, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.440052, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.440076, "o", "    }\r\n\u001b[?2004l\r"]
[4931.440098, "o", "\u001b[?2004h> "]
[4931.502473, "o", "    queue := []string{}\r\n\u001b[?2004l\r\u001b[?2004h>     for _, s := range c.Stages {\r\n\u001b[?2004l\r\u001b[?2004h>         if indeg[s.Name] == 0 {\r\n\u001b[?2004l\r\u001b[?2004h>             queue = append(queue, s.Name)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\ri\u001b[?2004h>     order := []string{}\r\n\u001b[?2004l\r) (m\u001b[?2004h>     for len(queue) > 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         node := queue[0]\r\n\u001b[?2004l\r\u001b[?2004h>         queue = queue[1:]\r\n\u001b[?2004l\r\u001b[?2004h>         order = append(order, node)\r\n\u001b[?2004l\r\u001b[?2004h>         for _, next := range adj[node] {\r\n\u001b[?2004l\r\u001b[?2004h>             indeg[next]--\r\n\u001b[?2004l\r\u001b[?2004h>             if indeg[next] == 0 {\r\n\u001b[?2004l\r\u001b[?2004h>                 queue = append(queue, next)\r\n\u001b[?2004l\r \u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if len(order) < len(c.Stages) {\r\n\u001b[?2004l\r\u001b[?2004h>         if cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {\r\n\u001b[?2004l\r ar\u001b[?2004h>             return nil, fmt.Errorf(\"cycle detected involv"]
[4931.502566, "o", "ing stages: %s\", strings.Join(cycle, \", \"))\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         return nil, fmt.Errorf(\"cycle detected involving stages: %s\", joinStageNames(c.Stages))\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return order, nil\r\n\u001b[?2004l\r"]
[4931.502625, "o", "\u001b[?2004h> }\r\n"]
[4931.502692, "o", "\u001b[?2004l\r"]
[4931.502749, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.503107, "o", "func joinStageNames(stages []StageConfig) string {\r\n\u001b[?2004l\r"]
[4931.50317, "o", "\u001b[?2004h> "]
[4931.503357, "o", "    names := []string{}\r\n\u001b[?2004l\r"]
[4931.503424, "o", "\u001b[?2004h> "]
[4931.503637, "o", "    for _, s := range stages {\r\n\u001b[?2004l\r"]
[4931.503697, "o", "\u001b[?2004h> "]
[4931.503959, "o", "        names = append(names, s.Name)\r\n\u001b[?2004l\r"]
[4931.504015, "o", "\u001b[?2004h> "]
[4931.504081, "o", "    }\r\n\u001b[?2004l\r"]
[4931.504135, "o", "\u001b[?2004h> "]
[4931.504388, "o", "    return strings.Join(names, \", \")\r\n\u001b[?2004l\r"]
[4931.504445, "o", "\u001b[?2004h> }"]
[4931.504499, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.504554, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.504609, "o", "> "]
[4931.505016, "o", "func artifactID(pipeline, stage, port string, ts int64) string {\r\n\u001b[?2004l\r"]
[4931.505072, "o", "\u001b[?2004h> "]
[4931.505247, "o", "    if pipeline == \"\" {\r\n\u001b[?2004l\r"]
[4931.505308, "o", "\u001b[?2004h> "]
[4931.505523, "o", "        pipeline = \"pipeline\"\r\n\u001b[?2004l\r"]
[4931.505584, "o", "\u001b[?2004h> "]
[4931.505643, "o", "    }\r\n\u001b[?2004l\r"]
[4931.505699, "o", "\u001b[?2004h> "]
[4931.506118, "o", "    return fmt.Sprintf(\"%s-%s-%s-%d\", pipeline, stage, port, ts)\r\n\u001b[?2004l\r"]
[4931.506173, "o", "\u001b[?2004h> "]
[4931.506234, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.50629, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.506344, "o", "> "]
[4931.506593, "o", "func (v *ArtifactValue) Type() string {\r\n\u001b[?2004l\r"]
[4931.506647, "o", "\u001b[?2004h> "]
[4931.506831, "o", "    if v.Dataset != nil {\r\n\u001b[?2004l\r"]
[4931.506892, "o", "\u001b[?2004h> "]
[4931.507063, "o", "        return \"dataset\"\r\n\u001b[?2004l\r"]
[4931.507117, "o", "\u001b[?2004h> "]
[4931.507169, "o", "    }\r\n\u001b[?2004l\r"]
[4931.507241, "o", "\u001b[?2004h> "]
[4931.507405, "o", "    if v.Model != nil {\r\n\u001b[?2004l\r"]
[4931.50746, "o", "\u001b[?2004h> "]
[4931.507616, "o", "        return \"model\"\r\n\u001b[?2004l\r"]
[4931.507667, "o", "\u001b[?2004h> "]
[4931.507724, "o", "    }\r\n\u001b[?2004l\r"]
[4931.507785, "o", "\u001b[?2004h> "]
[4931.507961, "o", "    if v.Report != nil {\r\n\u001b[?2004l\r"]
[4931.508021, "o", "\u001b[?2004h> "]
[4931.508189, "o", "        return \"report\"\r\n\u001b[?2004l\r"]
[4931.508254, "o", "\u001b[?2004h> "]
[4931.508322, "o", "    }\r\n\u001b[?2004l\r"]
[4931.508376, "o", "\u001b[?2004h> "]
[4931.508523, "o", "    if v.Entry != nil {\r\n\u001b[?2004l\r"]
[4931.508587, "o", "\u001b[?2004h> "]
[4931.508745, "o", "        return \"entry\"\r\n\u001b[?2004l\r"]
[4931.508801, "o", "\u001b[?2004h> "]
[4931.508868, "o", "    }\r\n\u001b[?2004l\r"]
[4931.508922, "o", "\u001b[?2004h> "]
[4931.509055, "o", "    return \"unknown\"\r\n\u001b[?2004l\r"]
[4931.509112, "o", "\u001b[?2004h> }"]
[4931.509167, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.509235, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.509291, "o", "> "]
[4931.509662, "o", "func (v *ArtifactValue) Summary() map[string]interface{} {\r\n\u001b[?2004l\r"]
[4931.509725, "o", "\u001b[?2004h> "]
[4931.509896, "o", "    if v.Dataset != nil {\r\n\u001b[?2004l\r"]
[4931.509959, "o", "\u001b[?2004h> "]
[4931.510204, "o", "        return v.Dataset.Summary()\r\n\u001b[?2004l\r"]
[4931.510271, "o", "\u001b[?2004h> "]
[4931.510326, "o", "    }\r\n\u001b[?2004l\r"]
[4931.510381, "o", "\u001b[?2004h> "]
[4931.510538, "o", "    if v.Model != nil {\r\n\u001b[?2004l\r"]
[4931.5106, "o", "\u001b[?2004h> "]
[4931.510865, "o", "        return map[string]interface{}{\r\n\u001b[?2004l\r"]
[4931.510932, "o", "\u001b[?2004h> "]
[4931.511245, "o", "            \"algorithm\":   v.Model.Algorithm,\r\n\u001b[?2004l\r"]
[4931.511299, "o", "\u001b[?2004h> "]
[4931.511595, "o", "            \"target\":      v.Model.Target,\r\n\u001b[?2004l\r"]
[4931.51165, "o", "\u001b[?2004h> "]
[4931.511958, "o", "            \"features\":    v.Model.Features,\r\n\u001b[?2004l\r"]
[4931.512013, "o", "\u001b[?2004h> "]
[4931.512346, "o", "            \"hyperparams\": v.Model.Hyperparams,\r\n\u001b[?2004l\r"]
[4931.5124, "o", "\u001b[?2004h> "]
[4931.51248, "o", "        }\r\n\u001b[?2004l\r"]
[4931.512535, "o", "\u001b[?2004h> "]
[4931.51259, "o", "    }\r\n\u001b[?2004l\r"]
[4931.512644, "o", "\u001b[?2004h> "]
[4931.512819, "o", "    if v.Report != nil {\r\n\u001b[?2004l\r"]
[4931.512881, "o", "\u001b[?2004h> "]
[4931.513113, "o", "        return v.Report.Summary()\r\n\u001b[?2004l\r"]
[4931.513168, "o", "\u001b[?2004h> "]
[4931.513232, "o", "    }\r\n\u001b[?2004l\r"]
[4931.513288, "o", "\u001b[?2004h> "]
[4931.513444, "o", "    if v.Entry != nil {\r\n\u001b[?2004l\r"]
[4931.513507, "o", "\u001b[?2004h> "]
[4931.513776, "o", "        return map[string]interface{}{\r\n\u001b[?2004l\r"]
[4931.513839, "o", "\u001b[?2004h> "]
[4931.51409, "o", "            \"name\":    v.Entry.Name,\r\n\u001b[?2004l\r"]
[4931.514146, "o", "\u001b[?2004h> "]
[4931.514423, "o", "            \"version\": v.Entry.Version,\r\n\u001b[?2004l\r"]
[4931.514478, "o", "\u001b[?2004h> "]
[4931.514739, "o", "            \"stage\":   v.Entry.Stage,\r\n\u001b[?2004l\r"]
[4931.514793, "o", "\u001b[?2004h> "]
[4931.514867, "o", "        }\r\n\u001b[?2004l\r"]
[4931.514927, "o", "\u001b[?2004h> "]
[4931.514987, "o", "    }\r\n\u001b[?2004l\r"]
[4931.515043, "o", "\u001b[?2004h> "]
[4931.51528, "o", "    return map[string]interface{}{}\r\n\u001b[?2004l\r"]
[4931.515347, "o", "\u001b[?2004h> }\r\n"]
[4931.515402, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[4931.515456, "o", "\u001b[?2004l\r\u001b[?2004h"]
[4931.515511, "o", "> "]
[4931.515907, "o", "func inputDataset(inputs map[string]*ArtifactValue) *Dataset {\r\n\u001b[?2004l\r"]
[4931.515953, "o", "\u001b[?2004h> "]
[4931.516186, "o", "    for _, in := range inputs {\r\n\u001b[?2004l\r"]
[4931.516259, "o", "\u001b[?2004h> "]
[4931.516555, "o", "        if in != nil && in.Dataset != nil {\r\n\u001b[?2004l\r"]
[4931.516618, "o", "\u001b[?2004h> "]
[4931.516813, "o", "            return in.Dataset\r\n\u001b[?2004l\r"]
[4931.516869, "o", "\u001b[?2004h> "]
[4931.516927, "o", "        }\r\n\u001b[?2004l\r"]
[4931.516983, "o", "\u001b[?2004h>     }"]
[4931.517038, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.517128, "o", "    return nil\r\n\u001b[?2004l\r"]
[4931.517182, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4931.517247, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4931.517303, "o", "\u001b[?2004h> "]
[4931.517564, "o", "func appendUnique(s []string, v string) []string {\r\n\u001b[?2004l\r"]
[4931.517618, "o", "\u001b[?2004h> "]
[4931.517745, "o", "    for _, x := range s {\r\n\u001b[?2004l\r"]
[4931.517799, "o", "\u001b[?2004h> "]
[4931.517892, "o", "        if x == v {\r\n\u001b[?2004l\r"]
[4931.517947, "o", "\u001b[?2004h> "]
[4931.518056, "o", "            return s\r\n\u001b[?2004l\r"]
[4931.518111, "o", "\u001b[?2004h> "]
[4931.518173, "o", "        }\r\n\u001b[?2004l\ro\u001b[?2004h"]
[4931.518238, "o", ">     }\r\n\u001b[?2004l\r"]
[4931.518293, "o", "\u001b[?2004h> "]
[4931.518412, "o", "    return append(s, v)\r\n\u001b[?2004l\r"]
[4931.518466, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4931.518521, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4931.518575, "o", "\u001b[?2004h> "]
[4931.51872, "o", "func artifactsPath() string {\r\n\u001b[?2004l\r"]
[4931.518775, "o", "\u001b[?2004h> "]
[4931.519043, "o", "    return filepath.Join(\".mlpipe\", \"artifacts.json\")\r\n\u001b[?2004l\r"]
[4931.519097, "o", "\u001b[?2004h> "]
[4931.519152, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4931.519225, "o", "\u001b[?2004h> "]
[4931.519514, "o", "func loadArtifacts() (map[string]*ArtifactMeta, error) {\r\n\u001b[?2004l\r"]
[4931.519569, "o", "\u001b[?2004h> "]
[4931.519809, "o", "    data, err := os.ReadFile(artifactsPath())\r\n\u001b[?2004l\r"]
[4931.519863, "o", "\u001b[?2004h> "]
[4931.519962, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[4931.520016, "o", "\u001b[?2004h> "]
[4931.520199, "o", "        if os.IsNotExist(err) {\r\n\u001b[?2004l\r"]
[4931.520271, "o", "\u001b[?2004h> "]
[4931.52056, "o", "            return map[string]*ArtifactMeta{}, nil\r\n\u001b[?2004l\r"]
[4931.520616, "o", "\u001b[?2004h> "]
[4931.52067, "o", "        }\r\n\u001b[?2004l\r"]
[4931.520725, "o", "\u001b[?2004h> "]
[4931.520829, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[4931.520885, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4931.520947, "o", "\u001b[?2004h> "]
[4931.521085, "o", "    var m map[string]*ArtifactMeta\r\n\u001b[?2004l\r"]
[4931.521139, "o", "\u001b[?2004h> "]
[4931.521349, "o", "    if err := json.Unmarshal(data, &m); err != nil {\r\n\u001b[?2004l\r"]
[4931.521405, "o", "\u001b[?2004h> "]
[4931.521491, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[4931.521545, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4931.52161, "o", "\u001b[?2004h> "]
[4931.521675, "o", "    if m == nil {\r\n\u001b[?2004l\r"]
[4931.521732, "o", "\u001b[?2004h> "]
[4931.521877, "o", "        m = map[string]*ArtifactMeta{}\r\n\u001b[?2004l\r"]
[4931.521932, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4931.521995, "o", "\u001b[?2004h> "]
[4931.522071, "o", "    return m, nil\r\n\u001b[?2004l\r"]
[4931.522127, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4931.522181, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.522243, "o", "> "]
[4931.522458, "o", "func saveArtifacts(newMeta map[string]*ArtifactMeta) error {\r\n\u001b[?2004l\r"]
[4931.522512, "o", "\u001b[?2004h> "]
[4931.522652, "o", "    existing, err := loadArtifacts()\r\n\u001b[?2004l\r"]
[4931.522707, "o", "\u001b[?2004h> "]
[4931.522776, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[4931.52283, "o", "\u001b[?2004h> "]
[4931.522898, "o", "        return err\r\n\u001b[?2004l\r"]
[4931.522952, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4931.523008, "o", "\u001b[?2004h> "]
[4931.523138, "o", "    for k, v := range newMeta {\r\n\u001b[?2004l\r"]
[4931.523192, "o", "\u001b[?2004h> "]
[4931.523315, "o", "        existing[k] = v\r\n\u001b[?2004l\r"]
[4931.523378, "o", "\u001b[?2004h> "]
[4931.523441, "o", "    }\r\n\u001b[?2004l\r"]
[4931.523495, "o", "\u001b[?2004h> "]
[4931.523705, "o", "    if err := os.MkdirAll(\".mlpipe\", 0755); err != nil {\r\n\u001b[?2004l\r"]
[4931.52376, "o", "\u001b[?2004h> "]
[4931.523826, "o", "        return err\r\n\u001b[?2004l\r"]
[4931.52388, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4931.523943, "o", "\u001b[?2004h> "]
[4931.524163, "o", "    data, err := json.MarshalIndent(existing, \"\", \"  \")\r\n\u001b[?2004l\r"]
[4931.524225, "o", "\u001b[?2004h> "]
[4931.524298, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[4931.524355, "o", "\u001b[?2004h> "]
[4931.52442, "o", "        return err\r\n\u001b[?2004l\r"]
[4931.524475, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4931.524532, "o", "\u001b[?2004h> "]
[4931.524748, "o", "    return os.WriteFile(artifactsPath(), data, 0644)\r\n\u001b[?2004l\r"]
[4931.524804, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4931.524859, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.524912, "o", "> "]
[4931.525039, "o", "func saveRun(run *RunOutput) error {\r\n\u001b[?2004l\r"]
[4931.525094, "o", "\u001b[?2004h> "]
[4931.525267, "o", "    dir := filepath.Join(\".mlpipe\", \"runs\")\r\n\u001b[?2004l\r"]
[4931.525323, "o", "\u001b[?2004h> "]
[4931.525516, "o", "    if err := os.MkdirAll(dir, 0755); err != nil {\r\n\u001b[?2004l\r"]
[4931.525571, "o", "\u001b[?2004h> "]
[4931.525638, "o", "        return err\r\n\u001b[?2004l\r"]
[4931.525694, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4931.525749, "o", "\u001b[?2004h> "]
[4931.525908, "o", "    name := safeFileName(run.Pipeline)\r\n\u001b[?2004l\r"]
[4931.525963, "o", "\u001b[?2004h> "]
[4931.526034, "o", "    if name == \"\" {\r\n\u001b[?2004l\r"]
[4931.526088, "o", "\u001b[?2004h> "]
[4931.526182, "o", "        name = \"pipeline\"\r\n\u001b[?2004l\r"]
[4931.526254, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4931.526301, "o", "\u001b[?2004h> "]
[4931.526651, "o", "    path := filepath.Join(dir, fmt.Sprintf(\"%s-%d.json\", name, time.Now().UnixNano()))\r\n\u001b[?2004l\r"]
[4931.526707, "o", "\u001b[?2004h> "]
[4931.526901, "o", "    data, err := json.MarshalIndent(run, \"\", \"  \")\r\n\u001b[?2004l\r"]
[4931.526955, "o", "\u001b[?2004h> "]
[4931.527008, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[4931.527063, "o", "\u001b[?2004h> "]
[4931.527117, "o", "        return err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.527171, "o", "n    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.527298, "o", "    return os.WriteFile(path, data, 0644)\r\n\u001b[?2004l\r"]
[4931.527354, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4931.527408, "o", "\u001b[?2004h> "]
[4931.527502, "o", "func safeFileName(s string) string {\r\n\u001b[?2004l\r"]
[4931.527556, "o", "\u001b[?2004h> "]
[4931.527611, "o", "    if s == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.527688, "o", "        return \"pipeline\"\r\n\u001b[?2004l\r"]
[4931.527743, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.527797, "o", "> "]
[4931.527889, "o", "    return strings.Map(func(r rune) rune {\r\n\u001b[?2004l\r"]
[4931.527944, "o", "\u001b[?2004h> "]
[4931.528084, "o", "        if r == '/' || r == '\\\\' || r == ':' || r == ' ' {\r\n\u001b[?2004l\r"]
[4931.528139, "o", "\u001b[?2004h> "]
[4931.528195, "o", "            return '_'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.528259, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.528324, "o", "        return r\r\n\u001b[?2004l\r"]
[4931.528379, "o", "\u001b[?2004h>     }, s)\r\n\u001b[?2004l\r"]
[4931.528434, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[4931.528487, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4931.528709, "o", "func queryLineage(id string, direction string) (map[string]interface{}, error) {\r\n\u001b[?2004l\r"]
[4931.528764, "o", "\u001b[?2004h> "]
[4931.528846, "o", "    artifacts, err := loadArtifacts()\r\n\u001b[?2004l\r"]
[4931.528901, "o", "\u001b[?2004h> "]
[4931.528955, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.529033, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[4931.529088, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.529142, "o", "> "]
[4931.529227, "o", "    if _, ok := artifacts[id]; !ok {\r\n\u001b[?2004l\r"]
[4931.529282, "o", "\u001b[?2004h> "]
[4931.529425, "o", "        return nil, fmt.Errorf(\"artifact not found: %s\", id)\r\n\u001b[?2004l\r"]
[4931.529481, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.529535, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.529621, "o", "    set := map[string]bool{}\r\n\u001b[?2004l\r"]
[4931.529675, "o", "\u001b[?2004h> "]
[4931.529732, "o", "    switch direction {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.529791, "o", "    case \"up\":\r\n\u001b[?2004l\r"]
[4931.529845, "o", "\u001b[?2004h> "]
[4931.529947, "o", "        collectAncestors(id, artifacts, set)\r\n\u001b[?2004l\r"]
[4931.530005, "o", "\u001b[?2004h> "]
[4931.53006, "o", "    case \"down\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.530188, "o", "        collectDescendants(id, artifacts, set)\r\n\u001b[?2004l\r"]
[4931.530249, "o", "\u001b[?2004h> "]
[4931.530303, "o", "    case \"both\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.530367, "o", "        set[id] = true\r\n\u001b[?2004l\r"]
[4931.530421, "o", "\u001b[?2004h> "]
[4931.530511, "o", "        collectBoth(id, artifacts, set)\r\n\u001b[?2004l\r"]
[4931.530565, "o", "\u001b[?2004h>     default:\r\n\u001b[?2004l\r"]
[4931.530619, "o", "\u001b[?2004h> "]
[4931.530792, "o", "        return nil, fmt.Errorf(\"invalid direction %q\", direction)\r\n\u001b[?2004l\r"]
[4931.530848, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4931.530902, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.530972, "o", "    ids := []string{}\r\n\u001b[?2004l\r"]
[4931.531027, "o", "\u001b[?2004h> "]
[4931.53109, "o", "    for k := range set {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4931.531191, "o", "        ids = append(ids, k)\r\n\u001b[?2004l\r"]
[4931.531253, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.531307, "o", "> "]
[4931.531394, "o", "    sort.Slice(ids, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[4931.531448, "o", "\u001b[?2004h> "]
[4931.531512, "o", "        a := artifacts[ids[i]]\r\n\u001b[?2004l\r"]
[4931.531566, "o", "\u001b[?2004h> "]
[4931.53163, "o", "        b := artifacts[ids[j]]\r\n\u001b[?2004l\r"]
[4931.531684, "o", "\u001b[?2004h> "]
[4931.531773, "o", "        if a.Timestamp != b.Timestamp {\r\n\u001b[?2004l\r"]
[4931.531828, "o", "\u001b[?2004h> "]
[4931.53193, "o", "            return a.Timestamp < b.Timestamp\r\n\u001b[?2004l\r"]
[4931.531984, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4931.532038, "o", "\u001b[?2004h> "]
[4931.532109, "o", "        return ids[i] < ids[j]\r\n\u001b[?2004l\r"]
[4931.532162, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
[4931.532237, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4931.532292, "o", "> "]
[4931.532349, "o", "    lineage := []map[string]interface{}{}\r\n\u001b[?2004l\r"]
[4931.532404, "o", "\u001b[?2004h> "]
[4931.532465, "o", "    for _, aid := range ids {\r\n\u001b[?2004l\r"]
[4931.532519, "o", "\u001b[?2004h> "]
[4931.532574, "o", "        m := artifacts[aid]\r\n\u001b[?2004l\r"]
[4931.532628, "o", "\u001b[?2004h> "]
[4931.532681, "o", "        inputs := m.Inputs\r\n\u001b[?2004l\r"]
[4931.532735, "o", "\u001b[?2004h> "]
