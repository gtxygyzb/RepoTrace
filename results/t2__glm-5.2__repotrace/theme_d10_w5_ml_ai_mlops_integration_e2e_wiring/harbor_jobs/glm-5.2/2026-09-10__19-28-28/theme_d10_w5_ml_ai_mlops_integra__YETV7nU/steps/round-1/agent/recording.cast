[8908.862143, "o", "   140\t}\r\n   141\t\r\n   142\tfunc (ds *Dataset) ColumnValues(name string) ([]string, error) {\r\n   143\t\tidx, ok := ds.ColumnIndex(name)\r\n   144\t\tif !ok {\r\n   145\t\t\treturn nil, fmt.Errorf(\"column not found: %s\", name)\r\n   146\t\t}\r\n   147\t\tvals := make([]string, len(ds.Rows))\r\n   148\t\tfor i, row := range ds.Rows {\r\n"]
[8908.86221, "o", "   149\t\t\tif idx >= len(row) {\r\n   150\t\t\t\treturn nil, fmt.Errorf(\"row %d missing column %s\", i, name)\r\n   151\t\t\t}\r\n   152\t\t\tvals[i] = row[idx]\r\n   153\t\t}\r\n   154\t\treturn vals, nil\r\n   155\t}\r\n   156\t\r\n   157\tfunc (ds *Dataset) featureMatrix(features []string) ([][]float64, error) {\r\n   158\t\tcols := make([]int, len(features))\r\n"]
[8908.862295, "o", "   159\t\tfor i, f := range features {\r\n   160\t\t\tidx, ok := ds.ColumnIndex(f)\r\n   161\t\t\tif !ok {\r\n   162\t\t\t\treturn nil, fmt.Errorf(\"feature column not found: %s\", f)\r\n   163\t\t\t}\r\n   164\t\t\tif idx < len(ds.Types) && ds.Types[idx] != \"numeric\" {\r\n   165\t\t\t\treturn nil, fmt.Errorf(\"feature column is not numeric: %s\", f)\r\n   166\t\t\t}\r\n   167\t\t\tcols[i] = idx\r\n   168\t\t}\r\n   169\t\tX := make([][]float64, len(ds.Rows))\r\n"]
[8908.862363, "o", "   170\t\tfor i, row := range ds.Rows {\r\n   171\t\t\tX[i] = make([]float64, len(features))\r\n   172\t\t\tfor j, idx := range cols {\r\n   173\t\t\t\tif idx >= len(row) {\r\n   174\t\t\t\t\treturn nil, fmt.Errorf(\"row %d missing column %s\", i, features[j])\r\n   175\t\t\t\t}\r\n   176\t\t\t\tf, ok := parseFloat64(row[idx])\r\n"]
