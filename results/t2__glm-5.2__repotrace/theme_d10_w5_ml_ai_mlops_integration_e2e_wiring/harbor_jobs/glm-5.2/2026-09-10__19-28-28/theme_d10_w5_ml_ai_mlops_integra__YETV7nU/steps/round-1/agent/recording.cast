[11629.561651, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n"]
[11629.561772, "o", ")\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintError(\"usage: mlpipe <command> [args]\")\r\n\t\treturn\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n"]
[11629.561844, "o", "\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"plan\":\r\n\t\tcmdPlan(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"registry\":\r\n\t\tcmdRegistry(args)\r\n\tcase \"lineage\":\r\n\t\tcmdLineage(args)\r\n\tcase \"history\":\r\n\t\tcmdHistory(args)\r\n\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n"]
[11629.562447, "o", "\u001b[?2004h"]
[11629.562522, "o", "root@n30009:/app# "]
[11629.825776, "i", "sed -n '36,80p' main.go\n"]
[11629.826041, "o", "sed -n '36,80p' main.go\r\n\u001b[?2004l\r"]
[11629.829071, "o", "\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n\t}\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n\tconfigPath, overrides, cv, noCache, skipStages, err := parseRunArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n"]
[11629.829166, "o", "\t\treturn\r\n\t}\r\n\tstarted := time.Now()\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tfor _, name := range skipStages {\r\n\t\tif _, ok := config.stageByName(name); !ok {\r\n\t\t\tprintError(fmt.Sprintf(\"unknown stage: %s\", name))\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n\texecutor := NewExecutor(config, overrides)\r\n\texecutor.noCache = noCache\r\n\t"]
[11629.829274, "o", "executor.skipStages = skipStages\r\n\tif noCache {\r\n\t\texecutor.cacheStats = nil\r\n\t}\r\n\texecutor.cvFolds = cv\r\n\tvar run interface{}\r\n\tif cv > 0 {\r\n\t\trun, err = executor.RunCV()\r\n\t} else {\r\n\t\trun, err = executor.Run()\r\n\t}\r\n\tfinished := time.Now()\r\n\tstatus := \"failed\"\r\n\tif err == nil {\r\n\t\tstatus = runStatus(run)\r\n\t}\r\n\t"]
[11629.829358, "o", "record := buildRunRecord(executor, started, finished, status)\r\n\tif recErr := saveRunRecord(record); recErr != nil {\r\n\t\tprintError(recErr.Error())\r\n\t\treturn\r\n"]
[11629.829903, "o", "\u001b[?2004h"]
[11629.829973, "o", "root@n30009:/app# "]
