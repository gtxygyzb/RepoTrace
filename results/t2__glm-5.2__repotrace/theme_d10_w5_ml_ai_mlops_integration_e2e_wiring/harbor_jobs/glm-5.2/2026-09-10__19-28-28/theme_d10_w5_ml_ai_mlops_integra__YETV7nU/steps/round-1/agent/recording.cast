[10664.827474, "i", "nl -ba register.go | sed -n '161,220p'\n"]
[10664.827859, "o", "nl -ba register.go | sed -n '161,220p'\r\n\u001b[?2004l\r"]
[10664.832636, "o", "   161\tfunc promoteModel(name string, version int, targetStage string) (*RegistryEntry, string, string, error) {\r\n   162\t\tvalid := map[string]bool{\"staging\": true, \"production\": true, \"archived\": true}\r\n   163\t\tif !valid[targetStage] {\r\n   164\t\t\treturn nil, \"\", \"\", fmt.Errorf(\"invalid promotion: invalid target stage %q\", targetStage)\r\n   165"]
[10664.832727, "o", "\t\t}\r\n   166\t\tentries, err := loadRegistry()\r\n   167\t\tif err != nil {\r\n   168\t\t\treturn nil, \"\", \"\", err\r\n   169\t\t}\r\n   170\t\tvar entry *RegistryEntry\r\n   171\t\tfor _, e := range entries {\r\n   172\t\t\tif e.Name == name && e.Version == version {\r\n   173\t\t\t\tentry = e\r\n   174\t\t\t\tbreak\r\n   175\t\t\t}\r\n   176\t\t}\r\n   177"]
[10664.832795, "o", "\t\tif entry == nil {\r\n   178\t\t\treturn nil, \"\", \"\", fmt.Errorf(\"model not found: %s:%d\", name, version)\r\n   179\t\t}\r\n   180\t\r\n   181\t\tprevStage := entry.Stage\r\n   182\t\tif !validPromotionTransition(prevStage, targetStage) {\r\n   183\t\t\treturn nil, \"\", \"\", fmt.Errorf(\"invalid promotion: cannot promote from %s to %s\", prevStage, targetStage)\r\n   184\t\t}\r\n   185\t\r\n   186\t"]
