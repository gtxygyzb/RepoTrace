[10430.041742, "o", "   126\t\t\t\tfound := false\r\n   127\t\t\t\tfor _, t := range e.Tags {\r\n   128\t\t\t\t\tif t == tag {\r\n   129\t\t\t\t\t\tfound = true\r\n   130\t\t\t\t\t\tbreak\r\n   131\t\t\t\t\t}\r\n   132\t\t\t\t}\r\n   133\t\t\t\tif !found {\r\n   134\t\t\t\t\tcontinue\r\n   135\t\t\t\t}\r\n   136\t\t\t}\r\n   137\t\t\tfiltered = append(filtered, e)\r\n   138\t\t}\r\n"]
