[10933.821605, "o", "\t\t\tif !ok || val == nil {\r\n\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable artifact %s.%s\", stage.Name, local, depStage, port)\r\n\t\t\t}\r\n\t\t\tids = append(ids, id)\r\n\t\t\tif firstVal == nil {\r\n\t\t\t\tfirstVal = val\r\n\t\t\t}\r\n\t\t\tif stage.Type == \"ensemble\" && local == \"models\" {\r\n\t\t\t\tinputs[local+\"_\"+r] = val\r\n\t\t\t}\r\n\t\t}\r\n"]
[10933.821672, "o", "\t\tif _, exists := inputs[local]; !exists {\r\n\t\t\tinputs[local] = firstVal\r\n\t\t}\r\n\t}\r\n\treturn inputs, ids, nil\r\n}\r\n\r\nfunc executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tswitch stage.Type {\r\n\tcase \"data-source\":\r\n\t\treturn executeDataSource(stage, params, inputs)\r\n\tcase \"transform\":\r\n"]
[10933.821744, "o", "\t\treturn executeTransform(stage, params, inputs)\r\n\tcase \"split\":\r\n\t\treturn executeSplit(stage, params, inputs)\r\n\tcase \"train\":\r\n\t\treturn executeTrain(stage, params, inputs)\r\n\tcase \"evaluate\":\r\n\t\treturn executeEvaluate(stage, params, inputs)\r\n\tcase \"register\":\r\n\t\treturn executeRegister(stage, params, inputs)\r\n\tcase \"ensemble\":\r\n\t\treturn executeEnsemble(stage, params, inputs)\r\n\t}\r\n"]
[10933.821832, "o", "\treturn nil, fmt.Errorf(\"unknown stage type %q\", stage.Type)\r\n}\r\n\r\nfunc executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tpath, ok := getString(params, \"path\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"data-source stage %q requires path\", stage.Name)\r\n\t}\r\n\tschema, _ := getMap(params, \"schema\")\r\n\t"]
[10933.821903, "o", "ds, err := loadDataset(path, schema)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn map[string]*ArtifactValue{\"data\": {Dataset: ds}}, nil\r\n}\r\n\r\nfunc (c *Config) topologicalOrder() ([]string, error) {\r\n\tindeg := map[string]int{}\r\n\tadj := map[string][]string{}\r\n\tfor _, s := range c.Stages {\r\n\t\tindeg[s.Name] = 0\r\n\t}\r\n\tfor _, s := range c.Stages {\r\n\t\tfor _, dep := range s.DependsOn {\r\n\t\t\tif _, ok := c.stageByName(dep); ok {\r\n\t\t\t\tadj[dep] = append(adj[dep], s.Name)\r\n\t"]
[10933.821976, "o", "\t\t\tindeg[s.Name]++\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tqueue := []string{}\r\n\tfor _, s := range c.Stages {\r\n\t\tif indeg[s.Name] == 0 {\r\n\t\t\tqueue = append(queue, s.Name)\r\n\t\t}\r\n\t}\r\n\torder := []string{}\r\n"]
[10933.82204, "o", "\tfor len(queue) > 0 {\r\n\t\tnode := queue[0]\r\n\t\tqueue = queue[1:]\r\n\t\torder = append(order, node)\r\n\t\tfor _, next := range adj[node] {\r\n\t\t\tindeg[next]--\r\n\t\t\tif indeg[next] == 0 {\r\n\t\t\t\tqueue = append(queue, next)\r\n\t\t\t}\r\n\t\t}\r\n\t"]
[10933.822109, "o", "}\r\n\tif len(order) < len(c.Stages) {\r\n\t\tif cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {\r\n\t\t\treturn nil, fmt.Errorf(\"cycle detected involving stages: %s\", strings.Join(cycle, \", \"))\r\n\t\t}\r\n\t\treturn nil, fmt.Errorf(\"cycle detected involving stages: %s\", joinStageNames(c.Stages))\r\n\t}\r\n"]
[10933.822179, "o", "\treturn order, nil\r\n}\r\n\r\nfunc joinStageNames(stages []StageConfig) string {\r\n\tnames := []string{}\r\n\tfor _, s := range stages {\r\n\t\tnames = append(names, s.Name)\r\n\t}\r\n\treturn strings.Join(names, \", \")\r\n}\r\n\r\nfunc artifactID(pipeline, stage, port string, ts int64) string {\r\n\tif pipeline == \"\" {\r\n\t\tpipeline = \"pipeline\"\r\n\t}\r\n\treturn fmt.Sprintf(\"%s-%s-%s-%d\", pipeline, stage, port, ts)\r\n}\r\n\r\nfunc (v *ArtifactValue) Type() string {\r\n\tif v.Dataset != nil {\r\n\t\treturn \"dataset\"\r\n"]
[10933.822269, "o", "\t}\r\n\tif v.Model != nil {\r\n\t\treturn \"model\"\r\n\t}\r\n\tif v.Report != nil {\r\n\t\treturn \"report\"\r\n\t}\r\n\tif v.Entry != nil {\r\n\t\treturn \"entry\"\r\n\t}\r\n\treturn \"unknown\"\r\n}\r\n\r\n"]
[10933.822376, "o", "func (v *ArtifactValue) Summary() map[string]interface{} {\r\n\tif v.Dataset != nil {\r\n\t\treturn v.Dataset.Summary()\r\n\t}\r\n\tif v.Model != nil {\r\n\t\tsummary := map[string]interface{}{\r\n\t\t\t\"algorithm\":   v.Model.Algorithm,\r\n\t\t\t\"target\":      v.Model.Target,\r\n\t\t\t\"features\":    v.Model.Features,\r\n"]
[10933.822453, "o", "\t\t\t\"hyperparams\": v.Model.Hyperparams,\r\n\t\t}\r\n\t\tif len(v.Model.EnsembleModels) > 0 {\r\n\t\t\tsummary[\"ensemble_models\"] = v.Model.EnsembleModels\r\n\t\t}\r\n\t\tif v.Model.ModelData != nil {\r\n\t\t\tsummary[\"model_data\"] = v.Model.ModelData\r\n\t\t}\r\n\t\treturn summary\r\n\t}\r\n\tif v.Report != nil {\r\n\t\treturn v.Report.Summary()\r\n\t}\r\n\tif v.Entry != nil {\r\n\t\treturn map[string]interface{}{\r\n"]
[10933.822519, "o", "\t\t\t\"name\":    v.Entry.Name,\r\n\t\t\t\"version\": v.Entry.Version,\r\n\t\t\t\"stage\":   v.Entry.Stage,\r\n\t\t}\r\n\t}\r\n\treturn map[string]interface{}{}\r\n}\r\n\r\nfunc inputDataset(inputs map[string]*ArtifactValue) *Dataset {\r\n\tfor _, in := range inputs {\r\n\t\tif in != nil && in.Dataset != nil {\r\n\t\t\treturn in.Dataset\r\n\t\t}\r\n\t}\r\n"]
[10933.822591, "o", "\treturn nil\r\n}\r\n\r\nfunc appendUnique(s []string, v string) []string {\r\n\tfor _, x := range s {\r\n"]
