[1537.147728, "o", "> "]
[1537.147802, "o", "        skip := false\r\n\u001b[?2004l\r"]
[1537.147856, "o", "\u001b[?2004h> "]
[1537.148096, "o", "        for _, dep := range stage.DependsOn {\r\n\u001b[?2004l\r"]
[1537.148149, "o", "\u001b[?2004h> "]
[1537.148362, "o", "            if e.status[dep] != \"success\" {\r\n\u001b[?2004l\r"]
[1537.148417, "o", "\u001b[?2004h> "]
[1537.148554, "o", "                skip = true\r\n\u001b[?2004l\r"]
[1537.148608, "o", "\u001b[?2004h> "]
[1537.148708, "o", "                break\r\n\u001b[?2004l\r"]
[1537.148762, "o", "\u001b[?2004h> "]
[1537.14883, "o", "            }\r\n\u001b[?2004l\r"]
[1537.148884, "o", "\u001b[?2004h> "]
[1537.148937, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.148992, "o", "> "]
[1537.149045, "o", "        if skip {\r\n\u001b[?2004l\r"]
[1537.149099, "o", "\u001b[?2004h> "]
[1537.14932, "o", "            e.status[name] = \"skipped\"\r\n\u001b[?2004l\r"]
[1537.149377, "o", "\u001b[?2004h> "]
[1537.149602, "o", "            e.results[name].Status = \"skipped\"\r\n\u001b[?2004l\r"]
[1537.149656, "o", "\u001b[?2004h> "]
[1537.149739, "o", "            continue\r\n\u001b[?2004l\r"]
[1537.149793, "o", "\u001b[?2004h> "]
[1537.149848, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.149903, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.150238, "o", "        inputValues, inputIDs, err := e.resolveInputs(stage)\r\n\u001b[?2004l\r"]
[1537.150294, "o", "\u001b[?2004h> "]
[1537.150403, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[1537.150457, "o", "\u001b[?2004h> "]
[1537.150643, "o", "            e.status[name] = \"failed\"\r\n\u001b[?2004l\r"]
[1537.150698, "o", "\u001b[?2004h> "]
[1537.150932, "o", "            e.results[name].Status = \"failed\"\r\n\u001b[?2004l\r"]
[1537.150987, "o", "\u001b[?2004h> "]
[1537.151212, "o", "            e.results[name].Error = err.Error()\r\n\u001b[?2004l\r"]
[1537.151282, "o", "\u001b[?2004h> "]
[1537.151354, "o", "            continue\r\n\u001b[?2004l\r"]
[1537.151409, "o", "\u001b[?2004h> "]
[1537.151464, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.151517, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.151822, "o", "        params := e.config.stageParams(name, e.globals)\r\n\u001b[?2004l\r"]
[1537.15188, "o", "\u001b[?2004h> "]
[1537.152011, "o", "        start := time.Now()\r\n\u001b[?2004l\r"]
[1537.152065, "o", "\u001b[?2004h> "]
[1537.152381, "o", "        out, err := executeStage(stage, params, inputValues)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.152448, "o", "> "]
[1537.152679, "o", "        duration := time.Since(start).Milliseconds()\r\n\u001b[?2004l\r"]
[1537.152736, "o", "\u001b[?2004h> "]
[1537.152937, "o", "        e.results[name].DurationMs = duration\r\n\u001b[?2004l\rs\u001b[?2004h"]
[1537.152996, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.153091, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[1537.153147, "o", "\u001b[?2004h> "]
[1537.153285, "o", "            e.status[name] = \"failed\"\r\n\u001b[?2004l\r"]
[1537.153345, "o", "\u001b[?2004h> "]
[1537.153482, "o", "            e.results[name].Status = \"failed\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.153539, "o", "> "]
[1537.153675, "o", "            e.results[name].Error = err.Error()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.153729, "o", "> "]
[1537.153777, "o", "            continue\r\n\u001b[?2004l\r"]
[1537.153832, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1537.15389, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.154039, "o", "        e.status[name] = \"success\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.154094, "o", "> "]
[1537.154227, "o", "        e.results[name].Status = \"success\"\r\n\u001b[?2004l\r"]
[1537.154284, "o", "\u001b[?2004h> "]
[1537.15438, "o", "        ts := time.Now().UnixNano()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.154435, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[1537.154572, "o", "        for port, val := range out {\r\n\u001b[?2004l\r"]
[1537.154626, "o", "\u001b[?2004h> "]
[1537.15485, "o", "            id := artifactID(e.config.Pipeline.Name, name, port, ts)\r\n\u001b[?2004l\r"]
[1537.154905, "o", "\u001b[?2004h> "]
[1537.155022, "o", "            e.values[name][port] = val\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.155077, "o", "> "]
[1537.155186, "o", "            e.outputs[name][port] = id\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.155258, "o", "> "]
[1537.202336, "o", "            typ := val.Type()\r\n\u001b[?2004l\r\u001b[?2004h>             summary := val.Summary()\r\n\u001b[?2004l\r\u001b[?2004h>             meta := &ArtifactMeta{\r\n\u001b[?2004l\r\u001b[?2004h>                 ID:        id,\r\n\u001b[?2004l\r\u001b[?2004h>                 Stage:     name,\r\n\u001b[?2004l\r\u001b[?2004h>                 Port:      port,\r\n\u001b[?2004l\r\u001b[?2004h>                 Type:      typ,\r\n\u001b[?2004l\r"]
[1537.202494, "o", "\u001b[?2004h> "]
[1537.202666, "o", "                Summary:   summary,\r\n\u001b[?2004l\r"]
[1537.20274, "o", "\u001b[?2004h> "]
[1537.202969, "o", "                Inputs:    inputIDs,\r\n\u001b[?2004l\r"]
[1537.203033, "o", "\u001b[?2004h> "]
[1537.203319, "o", "                Outputs:   []string{},\r\n\u001b[?2004l\r"]
[1537.203362, "o", "\u001b[?2004h> "]
[1537.20359, "o", "                Timestamp: ts,\r\n\u001b[?2004l\r"]
[1537.203655, "o", "\u001b[?2004h> "]
[1537.203756, "o", "            }\r\n\u001b[?2004l\r"]
[1537.203828, "o", "\u001b[?2004h> "]
[1537.204017, "o", "            e.meta[id] = meta\r\n\u001b[?2004l\r"]
[1537.204073, "o", "\u001b[?2004h> "]
[1537.204403, "o", "            for _, inID := range inputIDs {\r\n\u001b[?2004l\r"]
[1537.204448, "o", "\u001b[?2004h> "]
[1537.204801, "o", "                if parent, ok := e.meta[inID]; ok {\r\n\u001b[?2004l\r"]
[1537.204861, "o", "\u001b[?2004h> "]
[1537.205343, "o", "                    parent.Outputs = appendUnique(parent.Outputs, id)\r\n\u001b[?2004l\r"]
[1537.205425, "o", "\u001b[?2004h> "]
[1537.205524, "o", "                }\r\n\u001b[?2004l\r"]
[1537.205585, "o", "\u001b[?2004h> "]
[1537.205685, "o", "            }\r\n\u001b[?2004l\r"]
[1537.205763, "o", "\u001b[?2004h> "]
[1537.206439, "o", "            runArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n\u001b[?2004l\r"]
[1537.206523, "o", "\u001b[?2004h> "]
[1537.206607, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.206649, "o", "    }\r\n\u001b[?2004l\r"]
[1537.206705, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.206784, "o", "\u001b[?2004h> "]
[1537.206949, "o", "    status := \"success\"\r\n\u001b[?2004l\r"]
[1537.207008, "o", "\u001b[?2004h> "]
[1537.207253, "o", "    for _, s := range e.results {\r\n\u001b[?2004l\r"]
[1537.207345, "o", "\u001b[?2004h> "]
[1537.207557, "o", "        if s.Status != \"success\" {\r\n\u001b[?2004l\r"]
[1537.20763, "o", "\u001b[?2004h> "]
[1537.207831, "o", "            status = \"failed\"\r\n\u001b[?2004l\r"]
[1537.207901, "o", "\u001b[?2004h> "]
[1537.208017, "o", "            break\r\n\u001b[?2004l\r"]
[1537.208079, "o", "\u001b[?2004h> "]
[1537.20815, "o", "        }\r\n\u001b[?2004l\r"]
[1537.208215, "o", "\u001b[?2004h> "]
[1537.208306, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.208373, "o", "\u001b[?2004h> "]
[1537.208537, "o", "    run := &RunOutput{\r\n\u001b[?2004l\r"]
[1537.208606, "o", "\u001b[?2004h> "]
[1537.208886, "o", "        Pipeline:  e.config.Pipeline.Name,\r\n\u001b[?2004l\r"]
[1537.208946, "o", "\u001b[?2004h> "]
[1537.209121, "o", "        Status:    status,\r\n\u001b[?2004l\r"]
[1537.209182, "o", "\u001b[?2004h> "]
[1537.209401, "o", "        Stages:    e.results,\r\n\u001b[?2004l\r"]
[1537.209463, "o", "\u001b[?2004h> "]
[1537.209687, "o", "        Artifacts: runArtifacts,\r\n\u001b[?2004l\r"]
[1537.209731, "o", "\u001b[?2004h> "]
[1537.209829, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1537.209908, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1537.210258, "o", "    if err := saveArtifacts(e.meta); err != nil {\r\n\u001b[?2004l\r"]
[1537.21032, "o", "\u001b[?2004h> "]
[1537.210492, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1537.210566, "o", "\u001b[?2004h> "]
[1537.210644, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.210926, "o", "    if err := saveRun(run); err != nil {\r\n\u001b[?2004l\r"]
[1537.210989, "o", "\u001b[?2004h> "]
[1537.21115, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1537.21124, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1537.211318, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.21139, "o", "\u001b[?2004h"]
[1537.211453, "o", "> "]
[1537.211525, "o", "    return run, nil\r\n\u001b[?2004l\r"]
[1537.211596, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r "]
[1537.211656, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.211724, "o", "\u001b[?2004h> "]
[1537.212381, "o", "func (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {\r\n\u001b[?2004l\r"]
[1537.212454, "o", "\u001b[?2004h> "]
[1537.212785, "o", "    inputs := map[string]*ArtifactValue{}\r\n\u001b[?2004l\r"]
[1537.212866, "o", "\u001b[?2004h"]
[1537.212939, "o", "> "]
[1537.213044, "o", "    ids := []string{}\r\n\u001b[?2004l\r"]
[1537.213115, "o", "\u001b[?2004h> "]
[1537.213423, "o", "    for local, ref := range stage.Inputs {\r\n\u001b[?2004l\r"]
[1537.213501, "o", "\u001b[?2004h> "]
[1537.213795, "o", "        parts := strings.SplitN(ref, \".\", 2)\r\n\u001b[?2004l\r"]
[1537.213871, "o", "\u001b[?2004h> "]
[1537.214058, "o", "        if len(parts) != 2 {\r\n\u001b[?2004l\r"]
[1537.214134, "o", "\u001b[?2004h> "]
[1537.214803, "o", "            return nil, nil, fmt.Errorf(\"stage %q has invalid input reference %q\", stage.Name, ref)\r\n\u001b[?2004l\r"]
[1537.214869, "o", "\u001b[?2004h> "]
[1537.214934, "o", "        }\r\n\u001b[?2004l\r"]
[1537.214998, "o", "\u001b[?2004h> "]
[1537.215319, "o", "        depStage, port := parts[0], parts[1]\r\n\u001b[?2004l\r"]
[1537.215398, "o", "\u001b[?2004h> "]
[1537.21565, "o", "        id, ok := e.outputs[depStage][port]\r\n\u001b[?2004l\r"]
[1537.215708, "o", "\u001b[?2004h> "]
[1537.215795, "o", "        if !ok {\r\n\u001b[?2004l\r"]
[1537.215873, "o", "\u001b[?2004h> "]
[1537.216582, "o", "            return nil, nil, fmt.Errorf(\"stage %q input %q references unavailable output %s.%s\", stage.Name, local, depStage, port)\r\n\u001b[?2004l\r"]
[1537.216652, "o", "\u001b[?2004h> "]
[1537.216732, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.216965, "o", "        val, ok := e.values[depStage][port]\r\n\u001b[?2004l\r"]
[1537.217033, "o", "\u001b[?2004h> "]
[1537.217184, "o", "        if !ok || val == nil {\r\n\u001b[?2004l\r"]
[1537.217263, "o", "\u001b[?2004h> "]
[1537.217921, "o", "            return nil, nil, fmt.Errorf(\"stage %q input %q references unavailable artifact %s.%s\", stage.Name, local, depStage, port)\r\n\u001b[?2004l\r"]
[1537.218005, "o", "\u001b[?2004h> "]
[1537.21808, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.218201, "o", "        inputs[local] = val\r\n\u001b[?2004l\r"]
[1537.218283, "o", "\u001b[?2004h> "]
[1537.218422, "o", "        ids = append(ids, id)\r\n\u001b[?2004l\r"]
[1537.218503, "o", "\u001b[?2004h> "]
[1537.21857, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.218688, "o", "    return inputs, ids, nil\r\n\u001b[?2004l\r"]
[1537.218768, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1537.218841, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1537.219567, "o", "func executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\u001b[?2004l\r"]
[1537.219654, "o", "\u001b[?2004h> "]
[1537.219741, "o", "    switch stage.Type {\r\n\u001b[?2004l\r"]
[1537.219809, "o", "\u001b[?2004h> "]
[1537.219911, "o", "    case \"data-source\":\r\n\u001b[?2004l\r"]
[1537.219976, "o", "\u001b[?2004h> "]
[1537.220251, "o", "        return executeDataSource(stage, params, inputs)\r\n\u001b[?2004l\r"]
[1537.220317, "o", "\u001b[?2004h> "]
[1537.220416, "o", "    case \"transform\":\r\n\u001b[?2004l\r"]
[1537.22048, "o", "\u001b[?2004h> "]
[1537.220788, "o", "        return executeTransform(stage, params, inputs)\r\n\u001b[?2004l\r"]
[1537.220851, "o", "\u001b[?2004h> "]
[1537.220921, "o", "    case \"split\":\r\n\u001b[?2004l\r"]
[1537.220997, "o", "\u001b[?2004h> "]
[1537.221262, "o", "        return executeSplit(stage, params, inputs)\r\n\u001b[?2004l\r"]
[1537.221327, "o", "\u001b[?2004h> "]
[1537.221411, "o", "    case \"train\":\r\n\u001b[?2004l\r"]
[1537.221476, "o", "\u001b[?2004h> "]
[1537.221726, "o", "        return executeTrain(stage, params, inputs)\r\n\u001b[?2004l\r"]
[1537.221796, "o", "\u001b[?2004h> "]
[1537.221891, "o", "    case \"evaluate\":\r\n\u001b[?2004l\r"]
[1537.221967, "o", "\u001b[?2004h> "]
[1537.222208, "o", "        return executeEvaluate(stage, params, inputs)\r\n\u001b[?2004l\r"]
[1537.222314, "o", "\u001b[?2004h> "]
[1537.222391, "o", "    case \"register\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.222469, "o", "> "]
[1537.222715, "o", "        return executeRegister(stage, params, inputs)\r\n\u001b[?2004l\r"]
[1537.22279, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1537.222854, "o", "\u001b[?2004h> "]
[1537.223181, "o", "    return nil, fmt.Errorf(\"unknown stage type %q\", stage.Type)\r\n\u001b[?2004l\r"]
[1537.223235, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1537.223289, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.223364, "o", "\u001b[?2004h> "]
[1537.224175, "o", "func executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\u001b[?2004l\r"]
[1537.224262, "o", "\u001b[?2004h> "]
[1537.224451, "o", "    path, ok := getString(params, \"path\")\r\n\u001b[?2004l\r"]
[1537.224507, "o", "\u001b[?2004h> "]
[1537.224574, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[1537.224628, "o", "\u001b[?2004h> "]
[1537.225031, "o", "        return nil, fmt.Errorf(\"data-source stage %q requires path\", stage.Name)\r\n\u001b[?2004l\r"]
[1537.225085, "o", "\u001b[?2004h>     }"]
[1537.22514, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.225379, "o", "    schema, _ := getMap(params, \"schema\")\r\n\u001b[?2004l\r"]
[1537.225437, "o", "\u001b[?2004h> "]
[1537.225652, "o", "    ds, err := loadDataset(path, schema)\r\n\u001b[?2004l\r"]
[1537.225709, "o", "\u001b[?2004h> "]
[1537.225804, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.22586, "o", "> "]
[1537.22592, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1537.225975, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1537.226035, "o", "\u001b[?2004h> "]
[1537.226288, "o", "    return map[string]*ArtifactValue{\"data\": {Dataset: ds}}, nil\r\n\u001b[?2004l\r"]
[1537.226344, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.226398, "o", "m\u001b[?2004h> "]
[1537.226597, "o", "func (c *Config) topologicalOrder() ([]string, error) {\r\n\u001b[?2004l\r"]
[1537.226651, "o", "\u001b[?2004h> "]
[1537.226735, "o", "    indeg := map[string]int{}\r\n\u001b[?2004l\r"]
[1537.226789, "o", "\u001b[?2004h> "]
[1537.22689, "o", "    adj := map[string][]string{}\r\n\u001b[?2004l\r"]
[1537.226943, "o", "\u001b[?2004h> "]
[1537.227051, "o", "    for _, s := range c.Stages {\r\n\u001b[?2004l\r"]
[1537.227107, "o", "\u001b[?2004h> "]
[1537.227181, "o", "        indeg[s.Name] = 0\r\n\u001b[?2004l\r"]
[1537.227256, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.227314, "o", "> "]
[1537.227392, "o", "    for _, s := range c.Stages {\r\n\u001b[?2004l\r"]
[1537.227447, "o", "\u001b[?2004h> "]
[1537.227576, "o", "        for _, dep := range s.DependsOn {\r\n\u001b[?2004l\r"]
[1537.22763, "o", "\u001b[?2004h> "]
[1537.227807, "o", "            if _, ok := c.stageByName(dep); ok {\r\n\u001b[?2004l\r"]
[1537.227862, "o", "\u001b[?2004h> "]
[1537.228036, "o", "                adj[dep] = append(adj[dep], s.Name)\r\n\u001b[?2004l\r"]
[1537.228091, "o", "\u001b[?2004h> "]
[1537.228207, "o", "                indeg[s.Name]++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.228307, "o", "            }\r\n\u001b[?2004l\rf\u001b[?2004h> "]
[1537.228388, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.228466, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.228544, "o", "    queue := []string{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.2287, "o", "    for _, s := range c.Stages {\r\n\u001b[?2004l\r'\u001b[?2004h"]
[1537.228776, "o", "> "]
[1537.22887, "o", "        if indeg[s.Name] == 0 {\r\n\u001b[?2004l\r"]
[1537.228947, "o", "\u001b[?2004h> "]
[1537.229061, "o", "            queue = append(queue, s.Name)\r\n\u001b[?2004l\r"]
[1537.22913, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.229185, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.229257, "o", "> "]
[1537.229313, "o", "    order := []string{}\r\n\u001b[?2004l\r"]
[1537.229367, "o", "\u001b[?2004h> "]
[1537.229453, "o", "    for len(queue) > 0 {\r\n\u001b[?2004l\r},"]
[1537.229508, "o", "\u001b[?2004h> "]
[1537.229575, "o", "        node := queue[0]\r\n\u001b[?2004l\r"]
[1537.229629, "o", "\u001b[?2004h> "]
[1537.229703, "o", "        queue = queue[1:]\r\n\u001b[?2004l\r"]
[1537.229758, "o", "\u001b[?2004h> "]
[1537.229892, "o", "        order = append(order, node)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.229947, "o", "> "]
[1537.23008, "o", "        for _, next := range adj[node] {\r\n\u001b[?2004l\r"]
[1537.230134, "o", "\u001b[?2004h> "]
[1537.230206, "o", "            indeg[next]--\r\n\u001b[?2004l\r"]
[1537.230285, "o", "\u001b[?2004h> "]
[1537.230389, "o", "            if indeg[next] == 0 {\r\n\u001b[?2004l\r"]
[1537.230443, "o", "\u001b[?2004h> "]
[1537.230584, "o", "                queue = append(queue, next)\r\n\u001b[?2004l\r"]
[1537.230639, "o", "\u001b[?2004h> "]
[1537.230705, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.230759, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.230813, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.230964, "o", "    if len(order) < len(c.Stages) {\r\n\u001b[?2004l\r"]
[1537.231019, "o", "\u001b[?2004h> "]
[1537.231247, "o", "        if cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.231324, "o", "> "]
[1537.231638, "o", "            return nil, fmt.Errorf(\"cycle detected involving stages: %s\", strings.Join(cycle, \", \"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.231717, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.232098, "o", "        return nil, fmt.Errorf(\"cycle detected involving stages: %s\", joinStageNames(c.Stages))\r\n\u001b[?2004l\r"]
[1537.232174, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.232278, "o", "    return order, nil\r\n\u001b[?2004l\r"]
[1537.232352, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.232418, "o", "\u001b[?2004h> "]
[1537.232588, "o", "func joinStageNames(stages []StageConfig) string {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.232713, "o", "    names := []string{}\r\n\u001b[?2004l\r"]
[1537.232788, "o", "\u001b[?2004h> "]
[1537.232863, "o", "    for _, s := range stages {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.233037, "o", "        names = append(names, s.Name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.233111, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.233266, "o", "    return strings.Join(names, \", \")\r\n\u001b[?2004l\rretu\u001b[?2004h"]
[1537.233339, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[1537.233599, "o", "func artifactID(pipeline, stage, port string, ts int64) string {\r\n\u001b[?2004l\r"]
[1537.233675, "o", "\u001b[?2004h> "]
[1537.233735, "o", "    if pipeline == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.233886, "o", "        pipeline = \"pipeline\"\r\n\u001b[?2004l\r"]
[1537.233956, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r \u001b[?2004h> "]
[1537.234212, "o", "    return fmt.Sprintf(\"%s-%s-%s-%d\", pipeline, stage, port, ts)\r\n\u001b[?2004l\r"]
[1537.234299, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[1537.234474, "o", "func (v *ArtifactValue) Type() string {\r\n\u001b[?2004l\r"]
[1537.234544, "o", "\u001b[?2004h> "]
[1537.234602, "o", "    if v.Dataset != nil {\r\n\u001b[?2004l\r"]
[1537.234678, "o", "\u001b[?2004h> "]
[1537.234755, "o", "        return \"dataset\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.234803, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.234906, "o", "    if v.Model != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.235029, "o", "        return \"model\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.235111, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.235213, "o", "    if v.Report != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.235331, "o", "        return \"report\"\r\n\u001b[?2004l\rp"]
[1537.235408, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.235513, "o", "    if v.Entry != nil {\r\n\u001b[?2004l\r"]
[1537.235564, "o", "\u001b[?2004h> "]
[1537.23566, "o", "        return \"entry\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.235737, "o", "    }\r\n\u001b[?2004l\r \u001b[?2004h> "]
[1537.235808, "o", "    return \"unknown\"\r\n\u001b[?2004l\r"]
[1537.235879, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.235945, "o", "> "]
[1537.236149, "o", "func (v *ArtifactValue) Summary() map[string]interface{} {\r\n\u001b[?2004l\r"]
[1537.236275, "o", "\u001b[?2004h>     if v.Dataset != nil {\r\n\u001b[?2004l\r"]
[1537.236361, "o", "\u001b[?2004h> "]
[1537.236467, "o", "        return v.Dataset.Summary()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.236543, "o", "    }\r\n\u001b[?2004l\ru\u001b[?2004h> "]
[1537.236613, "o", "    if v.Model != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.236743, "o", "        return map[string]interface{}{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.236889, "o", "            \"algorithm\":    v.Model.Algorithm,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.237045, "o", "            \"target\":       v.Model.Target,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.237195, "o", "            \"features\":     v.Model.Features,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.23735, "o", "            \"hyperparams\":  v.Model.Hyperparams,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.237404, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.237497, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.237549, "o", "    if v.Report != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.237664, "o", "        return v.Report.Summary()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.237723, "o", "    }\r\n\u001b[?2004l\r \u001b[?2004h> "]
[1537.237804, "o", "    if v.Entry != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.237933, "o", "        return map[string]interface{}{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.238055, "o", "            \"name\":    v.Entry.Name,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.238187, "o", "            \"version\": v.Entry.Version,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.238324, "o", "            \"stage\":   v.Entry.Stage,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.238384, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.238463, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.238544, "o", "    return map[string]interface{}{}\r\n\u001b[?2004l\r\u001b[?2004h> }"]
[1537.238612, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.238802, "o", "func inputDataset(inputs map[string]*ArtifactValue) *Dataset {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.238912, "o", "    for _, in := range inputs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.239054, "o", "        if in != nil && in.Dataset != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.239145, "o", "            return in.Dataset\r\n\u001b[?2004l\r"]
[1537.239268, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.239361, "o", "    return nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[1537.239524, "o", "func appendUnique(s []string, v string) []string {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.239615, "o", "    for _, x := range s {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.239693, "o", "        if x == v {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.239771, "o", "            return s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.239824, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.239908, "o", "    }\r\n\u001b[?2004l\r\r\n  \u001b[?2004h> "]
[1537.239997, "o", "    return append(s, v)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r "]
[1537.2401, "o", "\u001b[?2004h> func artifactsPath() string {\r\n\u001b[?2004l\r"]
[1537.240164, "o", "\u001b[?2004h> "]
[1537.240306, "o", "    return filepath.Join(\".mlpipe\", \"artifacts.json\")\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.240345, "o", "\r\n\u001b[?2004l\r,\u001b[?2004h> "]
[1537.24052, "o", "func loadArtifacts() (map[string]*ArtifactMeta, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.240684, "o", "    data, err := os.ReadFile(artifactsPath())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.240762, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.24087, "o", "        if os.IsNotExist(err) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.241018, "o", "            return map[string]*ArtifactMeta{}, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.24106, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.241127, "o", "        return nil, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.241153, "o", "    }\r\n\u001b[?2004l\r"]
[1537.24119, "o", "\u001b[?2004h> "]
[1537.241262, "o", "    var m map[string]*ArtifactMeta\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.24138, "o", "    if err := json.Unmarshal(data, &m); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.241437, "o", "        return nil, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.241464, "o", "    }\r\n\u001b[?2004l\r"]
[1537.241498, "o", "\u001b[?2004h> "]
[1537.241529, "o", "    if m == nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.241565, "o", "> "]
[1537.241642, "o", "        m = map[string]*ArtifactMeta{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.241676, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.241722, "o", "    return m, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.241757, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.241791, "o", "\u001b[?2004h> "]
[1537.302567, "o", "func saveArtifacts(newMeta map[string]*ArtifactMeta) error {\r\n\u001b[?2004l\r\u001b[?2004h>     existing, err := loadArtifacts()\r\n\u001b[?2004l\r\u001b[?2004h>     if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>         return err\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     for k, v := range newMeta {\r\n\u001b[?2004l\r\u001b[?2004h>         existing[k] = v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.302942, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.303022, "o", "    if err := os.MkdirAll(\".mlpipe\", 0755); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.303132, "o", "        return err\r\n\u001b[?2004l\r"]
[1537.303196, "o", "\u001b[?2004h> "]
[1537.303264, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.303321, "o", "> "]
[1537.303596, "o", "    data, err := json.MarshalIndent(existing, \"\", \"  \")\r\n\u001b[?2004l\r"]
[1537.303656, "o", "\u001b[?2004h> "]
[1537.303768, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1537.303827, "o", "\u001b[?2004h> "]
[1537.303931, "o", "        return err\r\n\u001b[?2004l\r"]
[1537.30399, "o", "\u001b[?2004h> "]
[1537.304056, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.304134, "o", "> "]
[1537.304391, "o", "    return os.WriteFile(artifactsPath(), data, 0644)\r\n\u001b[?2004l\r"]
[1537.304459, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1537.304517, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.304575, "o", "\u001b[?2004h> "]
[1537.304779, "o", "func saveRun(run *RunOutput) error {\r\n\u001b[?2004l\r"]
[1537.304837, "o", "\u001b[?2004h> "]
[1537.305091, "o", "    dir := filepath.Join(\".mlpipe\", \"runs\")\r\n\u001b[?2004l\r"]
[1537.305166, "o", "\u001b[?2004h> "]
[1537.305431, "o", "    if err := os.MkdirAll(dir, 0755); err != nil {\r\n\u001b[?2004l\r"]
[1537.305492, "o", "\u001b[?2004h> "]
[1537.305598, "o", "        return err\r\n\u001b[?2004l\r"]
[1537.305656, "o", "\u001b[?2004h> "]
[1537.305712, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.305766, "o", "> "]
[1537.305963, "o", "    name := safeFileName(run.Pipeline)\r\n\u001b[?2004l\r"]
[1537.306019, "o", "\u001b[?2004h> "]
[1537.306132, "o", "    if name == \"\" {\r\n\u001b[?2004l\r"]
[1537.306193, "o", "\u001b[?2004h> "]
[1537.306351, "o", "        name = \"pipeline\"\r\n\u001b[?2004l\r"]
[1537.306421, "o", "\u001b[?2004h> "]
[1537.306468, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.30654, "o", "> "]
[1537.306984, "o", "    path := filepath.Join(dir, fmt.Sprintf(\"%s-%d.json\", name, time.Now().UnixNano()))\r\n\u001b[?2004l\r"]
[1537.307049, "o", "\u001b[?2004h> "]
[1537.307333, "o", "    data, err := json.MarshalIndent(run, \"\", \"  \")\r\n\u001b[?2004l\r"]
[1537.307405, "o", "\u001b[?2004h> "]
[1537.307503, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1537.307567, "o", "\u001b[?2004h> "]
[1537.307662, "o", "        return err\r\n\u001b[?2004l\r"]
[1537.307722, "o", "\u001b[?2004h> "]
[1537.307783, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.307838, "o", "> "]
[1537.308046, "o", "    return os.WriteFile(path, data, 0644)\r\n\u001b[?2004l\r"]
[1537.30811, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1537.308173, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.308253, "o", "\u001b[?2004h> "]
[1537.308461, "o", "func safeFileName(s string) string {\r\n\u001b[?2004l\r"]
[1537.308526, "o", "\u001b[?2004h> "]
[1537.308608, "o", "    if s == \"\" {\r\n\u001b[?2004l\r"]
[1537.308666, "o", "\u001b[?2004h> "]
[1537.30882, "o", "        return \"pipeline\"\r\n\u001b[?2004l\r"]
[1537.308885, "o", "\u001b[?2004h> "]
[1537.308939, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.308993, "o", "> "]
[1537.309202, "o", "    return strings.Map(func(r rune) rune {\r\n\u001b[?2004l\r"]
[1537.309272, "o", "\u001b[?2004h> "]
[1537.309605, "o", "        if r == '/' || r == '\\\\' || r == ':' || r == ' ' {\r\n\u001b[?2004l\r"]
[1537.309672, "o", "\u001b[?2004h> "]
[1537.309788, "o", "            return '_'\r\n\u001b[?2004l\r"]
[1537.309855, "o", "\u001b[?2004h> "]
[1537.309918, "o", "        }\r\n\u001b[?2004l\r"]
[1537.309977, "o", "\u001b[?2004h> "]
[1537.310071, "o", "        return r\r\n\u001b[?2004l\r"]
[1537.310129, "o", "\u001b[?2004h> "]
[1537.310184, "o", "    }, s)\r\n\u001b[?2004l\r"]
[1537.310248, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1537.310298, "o", "\u001b[?2004h"]
[1537.310363, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.310417, "o", "> "]
[1537.310831, "o", "func queryLineage(id string, direction string) (map[string]interface{}, error) {\r\n\u001b[?2004l\r"]
[1537.310892, "o", "\u001b[?2004h> "]
[1537.311103, "o", "    artifacts, err := loadArtifacts()\r\n\u001b[?2004l\r"]
[1537.311166, "o", "\u001b[?2004h> "]
[1537.311291, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1537.311366, "o", "\u001b[?2004h> "]
[1537.311479, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1537.311538, "o", "\u001b[?2004h> "]
[1537.311594, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.31165, "o", "> "]
[1537.311834, "o", "    if _, ok := artifacts[id]; !ok {\r\n\u001b[?2004l\r"]
[1537.311893, "o", "\u001b[?2004h> "]
[1537.312234, "o", "        return nil, fmt.Errorf(\"artifact not found: %s\", id)\r\n\u001b[?2004l\r"]
[1537.312304, "o", "\u001b[?2004h> "]
[1537.312382, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1537.312457, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1537.312612, "o", "    set := map[string]bool{}\r\n\u001b[?2004l\r"]
[1537.31267, "o", "\u001b[?2004h> "]
[1537.312799, "o", "    switch direction {\r\n\u001b[?2004l\r"]
[1537.312857, "o", "\u001b[?2004h> "]
[1537.312951, "o", "    case \"up\":\r\n\u001b[?2004l\r"]
[1537.313028, "o", "\u001b[?2004h> "]
[1537.313337, "o", "        collectAncestors(id, artifacts, set)\r\n\u001b[?2004l\r"]
[1537.31338, "o", "\u001b[?2004h> "]
[1537.313499, "o", "    case \"down\":\r\n\u001b[?2004l\r"]
[1537.31357, "o", "\u001b[?2004h> "]
[1537.313823, "o", "        collectDescendants(id, artifacts, set)\r\n\u001b[?2004l\r"]
[1537.313887, "o", "\u001b[?2004h> "]
[1537.31397, "o", "    case \"both\":\r\n\u001b[?2004l\r"]
[1537.31403, "o", "\u001b[?2004h> "]
[1537.314163, "o", "        set[id] = true\r\n\u001b[?2004l\r"]
[1537.314243, "o", "\u001b[?2004h> "]
[1537.314454, "o", "        collectBoth(id, artifacts, set)\r\n\u001b[?2004l\r"]
[1537.314525, "o", "\u001b[?2004h> "]
[1537.314587, "o", "    default:\r\n\u001b[?2004l\r"]
[1537.314647, "o", "\u001b[?2004h> "]
[1537.315008, "o", "        return nil, fmt.Errorf(\"invalid direction %q\", direction)\r\n\u001b[?2004l\r"]
[1537.31506, "o", "\u001b[?2004h> "]
[1537.315124, "o", "    }\r\n\u001b[?2004l\r"]
[1537.315191, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.315253, "o", "> "]
[1537.315351, "o", "    ids := []string{}\r\n\u001b[?2004l\r"]
[1537.31541, "o", "\u001b[?2004h> "]
[1537.315549, "o", "    for k := range set {\r\n\u001b[?2004l\r"]
[1537.315608, "o", "\u001b[?2004h> "]
[1537.315769, "o", "        ids = append(ids, k)\r\n\u001b[?2004l\r"]
[1537.315822, "o", "\u001b[?2004h> "]
[1537.315884, "o", "    }\r\n\u001b[?2004l\r"]
[1537.315948, "o", "\u001b[?2004h> "]
[1537.316159, "o", "    sort.Slice(ids, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[1537.316238, "o", "\u001b[?2004h> "]
[1537.316396, "o", "        a := artifacts[ids[i]]\r\n\u001b[?2004l\r"]
[1537.316457, "o", "\u001b[?2004h> "]
[1537.316626, "o", "        b := artifacts[ids[j]]\r\n\u001b[?2004l\r"]
[1537.316686, "o", "\u001b[?2004h> "]
[1537.316906, "o", "        if a.Timestamp != b.Timestamp {\r\n\u001b[?2004l\r"]
[1537.316965, "o", "\u001b[?2004h> "]
[1537.317214, "o", "            return a.Timestamp < b.Timestamp\r\n\u001b[?2004l\r"]
[1537.317283, "o", "\u001b[?2004h> "]
[1537.317339, "o", "        }\r\n\u001b[?2004l\r"]
[1537.317399, "o", "\u001b[?2004h> "]
[1537.317569, "o", "        return ids[i] < ids[j]\r\n\u001b[?2004l\r"]
[1537.31763, "o", "\u001b[?2004h> "]
[1537.317683, "o", "    })\r\n\u001b[?2004l\r"]
[1537.317746, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.317804, "o", "\u001b[?2004h> "]
[1537.318024, "o", "    lineage := []map[string]interface{}{}\r\n\u001b[?2004l\r"]
[1537.318085, "o", "\u001b[?2004h> "]
[1537.318267, "o", "    for _, aid := range ids {\r\n\u001b[?2004l\r"]
[1537.318325, "o", "\u001b[?2004h> "]
[1537.318481, "o", "        m := artifacts[aid]\r\n\u001b[?2004l\r"]
[1537.318539, "o", "\u001b[?2004h> "]
[1537.318689, "o", "        inputs := m.Inputs\r\n\u001b[?2004l\r"]
[1537.318749, "o", "\u001b[?2004h> "]
[1537.318912, "o", "        outputs := m.Outputs\r\n\u001b[?2004l\r"]
[1537.318977, "o", "\u001b[?2004h> "]
[1537.319121, "o", "        if inputs == nil {\r\n\u001b[?2004l\r"]
[1537.319164, "o", "\u001b[?2004h> "]
[1537.319369, "o", "            inputs = []string{}\r\n\u001b[?2004l\r"]
[1537.319415, "o", "\u001b[?2004h> "]
[1537.319499, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.319557, "o", "> "]
[1537.319661, "o", "        if outputs == nil {\r\n\u001b[?2004l\r"]
[1537.319723, "o", "\u001b[?2004h> "]
[1537.319814, "o", "            outputs = []string{}\r\n\u001b[?2004l\r"]
[1537.319876, "o", "\u001b[?2004h> "]
[1537.319944, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.320147, "o", "        lineage = append(lineage, map[string]interface{}{\r\n\u001b[?2004l\r"]
[1537.320204, "o", "\u001b[?2004h> "]
[1537.32031, "o", "            \"id\":      m.ID,\r\n\u001b[?2004l\r"]
[1537.320376, "o", "\u001b[?2004h> "]
[1537.320468, "o", "            \"stage\":   m.Stage,\r\n\u001b[?2004l\r"]
[1537.320534, "o", "\u001b[?2004h> "]
[1537.320623, "o", "            \"port\":    m.Port,\r\n\u001b[?2004l\r"]
[1537.320688, "o", "\u001b[?2004h> "]
[1537.320778, "o", "            \"type\":    m.Type,\r\n\u001b[?2004l\r"]
[1537.320843, "o", "\u001b[?2004h> "]
[1537.320933, "o", "            \"inputs\":  inputs,\r\n\u001b[?2004l\r"]
[1537.320998, "o", "\u001b[?2004h> "]
[1537.321092, "o", "            \"outputs\": outputs,\r\n\u001b[?2004l\r"]
[1537.321165, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[1537.321246, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.321285, "o", "> \r\n\u001b[?2004l\r"]
[1537.32136, "o", "\u001b[?2004h> "]
[1537.321457, "o", "    return map[string]interface{}{\r\n\u001b[?2004l\r"]
[1537.321522, "o", "\u001b[?2004h> "]
[1537.321598, "o", "        \"artifact_id\": id,\r\n\u001b[?2004l\r"]
[1537.321662, "o", "\u001b[?2004h> "]
[1537.321753, "o", "        \"lineage\":    lineage,\r\n\u001b[?2004l\r"]
[1537.321826, "o", "\u001b[?2004h>     }, nil\r\n\u001b[?2004l\r"]
[1537.321892, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.321947, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.322303, "o", "func collectAncestors(id string, artifacts map[string]*ArtifactMeta, set map[string]bool) {\r\n\u001b[?2004l\r"]
[1537.322361, "o", "\u001b[?2004h> "]
[1537.322449, "o", "    m, ok := artifacts[id]\r\n\u001b[?2004l\r"]
[1537.32252, "o", "\u001b[?2004h> "]
[1537.322593, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.322661, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.322732, "o", "    }\r\n\u001b[?2004l\r"]
[1537.322798, "o", "\u001b[?2004h> "]
[1537.322869, "o", "    for _, in := range m.Inputs {\r\n\u001b[?2004l\r"]
[1537.322933, "o", "\u001b[?2004h> "]
[1537.323009, "o", "        if !set[in] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.323129, "o", "            set[in] = true\r\n\u001b[?2004l\r"]
[1537.323194, "o", "\u001b[?2004h> "]
[1537.323354, "o", "            collectAncestors(in, artifacts, set)\r\n\u001b[?2004l\r"]
[1537.323428, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1537.323506, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.323573, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.323631, "o", "\u001b[?2004h> "]
