[6661.836845, "o", "   238\t\t\tpts[i] = point{scores[i], y[i]}\r\n   239\t\t\tif y[i] == 1 {\r\n   240\t\t\t\tpos++\r\n   241\t\t\t} else {\r\n   242\t\t\t\tneg++\r\n   243\t\t\t}\r\n   244\t\t}\r\n"]
[6661.836909, "o", "   245\t\tif pos == 0 || neg == 0 {\r\n   246\t\t\treturn 0.0\r\n   247\t\t}\r\n   248\t\tsort.Slice(pts, func(i, j int) bool {\r\n   249\t\t\tif pts[i].score != pts[j].score {\r\n   250\t\t\t\treturn pts[i].score > pts[j].score\r\n   251\t\t\t}\r\n   252\t\t\treturn pts[i].y > pts[j].y\r\n   253\t\t})\r\n   254\t\r\n"]
