[8882.42947, "o", "errors = append(errors, fmt.Sprintf(\"duplicate stage name: %s\", s.Name))\r\n\t\t}\r\n\t\tnames[s.Name] = true\r\n\t}\r\n\tfor _, s := range c.Stages {\r\n\t\tif !validStageType(s.Type) {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q has unknown type %q\", s.Name, s.Type))\r\n\t\t}\r\n\t\tfor _, dep := range s.DependsOn {\r\n\t\t\tif !names[dep] {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q references unknown dependency %q\", s.Name, dep))\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor local, ref := range s.Inputs {\r\n\t\t\tparts := strings.SplitN(ref, \".\", 2)\r\n\t\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q has invalid reference %q\", s.Name, local, ref))\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
[8882.429507, "o", "\t\t\trefStage, ok := c.stageByName(parts[0])\r\n\t\t\tif !ok {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown stage %q\", s.Name, local, parts[0]))\r\n\t\t\t\tcontinue\r\n"]
[8882.429845, "o", "\t\t\t}\r\n\t\t\tports := validOutputPorts(refStage.Type)\r\n\t\t\tvalid := false\r\n\t\t\tfor _, p := range ports {\r\n\t\t\t\tif p == parts[1] {\r\n\t\t\t\t\tvalid = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !valid {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q input %q references unknown output port %q on stage %q\", s.Name, local, parts[1], parts[0]))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif stages, cycle := c.detectCycle(); cycle {\r\n\t\terrors = append(errors, fmt.Sprintf(\"cycle detected involving stages: %s\", strings.Join(stages, \", \")))\r\n\t}\r\n\treturn len(errors) == 0, errors\r\n}\r\n"]
