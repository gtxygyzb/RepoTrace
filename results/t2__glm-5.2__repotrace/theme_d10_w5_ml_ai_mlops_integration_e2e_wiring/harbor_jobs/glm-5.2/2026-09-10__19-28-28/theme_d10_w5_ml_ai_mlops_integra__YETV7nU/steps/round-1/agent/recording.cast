[10943.871188, "o", "    99\t\t\tswitch {\r\n   100\t\t\tcase args[i] == \"--param\":\r\n   101\t\t\t\tif i+1 >= len(args) {\r\n   102\t\t\t\t\tfail(\"--param requires key=value\")\r\n   103\t\t\t\t\treturn\r\n   104\t\t\t\t}\r\n   105\t\t\t\tkv := args[i+1]\r\n   106\t\t\t\ti++\r\n   107\t\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n   108\t\t\t\tif !ok {\r\n   109\t\t\t\t\tfail(\"--param requires key=value\")\r\n   110\t\t\t\t\treturn\r\n   111\t\t\t\t}\r\n   112\t\t\t\toverrides[k] = v\r\n"]
