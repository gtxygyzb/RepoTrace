[5326.154766, "o", "\u001b[?2004h> "]
[5326.154921, "o", "        for _, name := range postSplitOrder {\r\n\u001b[?2004l\r"]
[5326.154978, "o", "\u001b[?2004h> "]
[5326.155272, "o", "            foldExec.executeStageCached(name, i, e.cvFolds, foldArtifacts)\r\n\u001b[?2004l\r\u001b[?2004h"]
