[5326.227559, "o", "\u001b[?2004h> "]
[5326.227693, "o", "    if keyErr != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.227747, "o", "> "]
[5326.227852, "o", "        e.status[name] = \"failed\"\r\n\u001b[?2004l\r"]
[5326.227908, "o", "\u001b[?2004h> "]
[5326.228034, "o", "        e.results[name].Status = \"failed\"\r\n\u001b[?2004l\r"]
[5326.228089, "o", "\u001b[?2004h> "]
