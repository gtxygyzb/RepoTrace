[11921.200973, "o", "   127\t\t\tfor _, item := range x {\r\n   128\t\t\t\ts, ok := item.(string)\r\n   129\t\t\t\tif !ok {\r\n   130\t\t\t\t\treturn nil, false\r\n   131\t\t\t\t}\r\n   132\t\t\t\tres = append(res, s)\r\n   133\t\t\t}\r\n   134\t\t\treturn res, true\r\n   135\t\t}\r\n"]
