[935.534096, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.534265, "o", "        unique := uniqueStrings(vals)\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.534346, "o", "> "]
[935.5344, "o", "        sort.Strings(unique)\r\n\u001b[?2004l\r \u001b[?2004h"]
[935.534476, "o", "> "]
[935.534554, "o", "        mapping := map[string]int{}\r\n\u001b[?2004l\rs\u001b[?2004h"]
[935.534621, "o", "> "]
[935.534723, "o", "        for i, u := range unique {\r\n\u001b[?2004l\r"]
[935.534781, "o", "\u001b[?2004h> "]
[935.534853, "o", "            mapping[u] = i\r\n\u001b[?2004l\r"]
[935.534923, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[935.534994, "o", "\u001b[?2004h> "]
[935.535108, "o", "        out := make([]string, len(vals))\r\n\u001b[?2004l\r"]
[935.535168, "o", "\u001b[?2004h> "]
[935.535278, "o", "        for i, v := range vals {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.535454, "o", "            out[i] = strconv.Itoa(mapping[v])\r\n\u001b[?2004l\r"]
[935.535521, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[935.535591, "o", "\u001b[?2004h> "]
[935.535736, "o", "        ds.setColumnValues(col, out, \"numeric\")\r\n\u001b[?2004l\r"]
[935.535792, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[935.535862, "o", "\u001b[?2004h> "]
[935.535935, "o", "    return nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.536003, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.536196, "o", "func opLog(ds *Dataset, op map[string]interface{}) error {\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.536257, "o", "> "]
[935.5364, "o", "    cols, ok := getStringSlice(op, \"columns\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.536457, "o", ">     if !ok {\r\n\u001b[?2004l\r"]
[935.536526, "o", "\u001b[?2004h> "]
[935.536685, "o", "        return fmt.Errorf(\"log requires columns\")\r\n\u001b[?2004l\r"]
[935.536744, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\rV\u001b[?2004h"]
[935.536811, "o", "> "]
[935.536886, "o", "    for _, col := range cols {\r\n\u001b[?2004l\r"]
[935.536954, "o", "\u001b[?2004h> "]
[935.537081, "o", "        vals, err := ds.NumericColumn(col)\r\n\u001b[?2004l\r"]
[935.537152, "o", "\u001b[?2004h> "]
[935.537231, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.537334, "o", "            return err\r\n\u001b[?2004l\r \u001b[?2004h"]
[935.537391, "o", ">         }\r\n\u001b[?2004l\r"]
[935.537464, "o", "\u001b[?2004h> "]
[935.537563, "o", "        out := make([]string, len(vals))\r\n\u001b[?2004l\r \u001b[?2004h"]
[935.537621, "o", "> "]
[935.537719, "o", "        for i, v := range vals {\r\n\u001b[?2004l\r \u001b[?2004h"]
[935.537777, "o", "> "]
[935.537847, "o", "            if v <= 0 {\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[935.538079, "o", "                return fmt.Errorf(\"log requires positive values\")\r\n\u001b[?2004l\r"]
[935.538146, "o", "\u001b[?2004h> "]
[935.538214, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.538361, "o", "            out[i] = formatFloat(math.Log(v))\r\n\u001b[?2004l\r"]
[935.538421, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r "]
[935.538492, "o", "\u001b[?2004h> "]
[935.538615, "o", "        ds.setColumnValues(col, out, \"numeric\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.538675, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.538714, "o", "    return nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.538739, "o", "}\r\n\u001b[?2004l\r \u001b[?2004h"]
[935.53876, "o", "> \r\n\u001b[?2004l\r"]
[935.538781, "o", "\u001b[?2004h> "]
[935.538969, "o", "func opPolynomial(ds *Dataset, op map[string]interface{}) error {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.539111, "o", "    cols, ok := getStringSlice(op, \"columns\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.539131, "o", "> "]
[935.539151, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[935.539172, "o", "\u001b[?2004h> "]
[935.53935, "o", "        return fmt.Errorf(\"polynomial requires columns\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.539382, "o", "    }\r\n\u001b[?2004l\r \u001b[?2004h"]
[935.539402, "o", "> "]
[935.602562, "o", "    degree, ok := getInt(op, \"degree\")\r\n\u001b[?2004l\r\u001b[?2004h>     if !ok || degree < 2 {\r\n\u001b[?2004l\r\u001b[?2004h>         return fmt.Errorf(\"polynomial degree must be >= 2\")\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     for _, col := range cols {\r\n\u001b[?2004l\rs [\u001b[?2004h>         if _, ok := ds.ColumnIndex(col); !ok {\r\n\u001b[?2004l\rl\u001b[?2004h>             return fmt.Errorf(\"column not found: %s\", col)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\re\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\r\n\u001b[?2004h>     type term struct {\r\n\u001b[?2004l\r t\u001b[?2004h>         counts map[string]int\r\n\u001b[?2004l\r\u001b[?2004h>         tuple  []string\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     var terms []term\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     var generate func(start int, depth int, chosen []string)\r\n\u001b[?2004l\r\u001b[?2004h>     generate = func(start int, depth int, chosen []string) {\r\n\u001b[?2004l\r\u001b[?2004h>         if depth == 0 {\r\n\u001b[?2004l\r\u001b[?2004h>             counts := map[string]int{}\r\n\u001b[?2004l\r\u001b[?2004h>             tuple := append([]string{},"]
[935.602798, "o", " chosen...)\r\n\u001b[?2004l\r\u001b[?2004h>             sort.Strings(tuple)\r\n\u001b[?2004l\r\u001b[?2004h>             for _, c := range tuple {\r\n\u001b[?2004l\r\u001b[?2004h>                 counts[c]++\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             terms = append(terms, term{counts: counts, tuple: tuple})\r\n\u001b[?2004l\r\u001b[?2004h>             return\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         for i := start; i < len(cols); i++ {\r\n\u001b[?2004l\r\u001b[?2004h>             generate(i, depth-1, append(chosen, cols[i]))\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for d := 2; d <= degree; d++ {\r\n\u001b[?2004l\r\u001b[?2004h>         generate(0, d, []string{})\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     sort.Slice(terms, func(i, j int) bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.602955, "o", "        a := terms[i].tuple\r\n\u001b[?2004l\r"]
[935.603035, "o", "\u001b[?2004h> "]
[935.603169, "o", "        b := terms[j].tuple\r\n\u001b[?2004l\r"]
[935.603261, "o", "\u001b[?2004h> "]
[935.603553, "o", "        for k := 0; k < len(a) && k < len(b); k++ {\r\n\u001b[?2004l\r"]
[935.603615, "o", "\u001b[?2004h> "]
[935.603776, "o", "            if a[k] != b[k] {\r\n\u001b[?2004l\r"]
[935.603837, "o", "\u001b[?2004h> "]
[935.604029, "o", "                return a[k] < b[k]\r\n\u001b[?2004l\r"]
[935.604091, "o", "\u001b[?2004h> "]
[935.604162, "o", "            }\r\n\u001b[?2004l\r"]
[935.604245, "o", "\u001b[?2004h> "]
[935.604321, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.604393, "o", "> "]
[935.60452, "o", "        return len(a) < len(b)\r\n\u001b[?2004l\r"]
[935.604581, "o", "\u001b[?2004h> "]
[935.604651, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.604723, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.604943, "o", "    colVals := map[string][]float64{}\r\n\u001b[?2004l\r"]
[935.605003, "o", "\u001b[?2004h> "]
[935.605176, "o", "    for _, col := range cols {\r\n\u001b[?2004l\r"]
[935.605247, "o", "\u001b[?2004h> "]
[935.60548, "o", "        vals, err := ds.NumericColumn(col)\r\n\u001b[?2004l\r"]
[935.605531, "o", "\u001b[?2004h> "]
[935.605682, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[935.60575, "o", "\u001b[?2004h> "]
[935.605866, "o", "            return err\r\n\u001b[?2004l\r"]
[935.605929, "o", "\u001b[?2004h> "]
[935.606001, "o", "        }\r\n\u001b[?2004l\r"]
[935.606073, "o", "\u001b[?2004h> "]
[935.606212, "o", "        colVals[col] = vals\r\n\u001b[?2004l\r"]
[935.606289, "o", "\u001b[?2004h> "]
[935.606359, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[935.60643, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[935.606596, "o", "    for _, t := range terms {\r\n\u001b[?2004l\r"]
[935.606656, "o", "\u001b[?2004h> "]
[935.606848, "o", "        name := termName(t.counts)\r\n\u001b[?2004l\r"]
[935.606906, "o", "\u001b[?2004h> "]
[935.60715, "o", "        out := make([]string, len(ds.Rows))\r\n\u001b[?2004l\r"]
[935.607207, "o", "\u001b[?2004h> "]
[935.607403, "o", "        for i := range ds.Rows {\r\n\u001b[?2004l\r"]
[935.607468, "o", "\u001b[?2004h> "]
[935.607583, "o", "            val := 1.0\r\n\u001b[?2004l\r"]
[935.607631, "o", "\u001b[?2004h> "]
[935.607874, "o", "            for c, n := range t.counts {\r\n\u001b[?2004l\r"]
[935.607936, "o", "\u001b[?2004h> "]
[935.608265, "o", "                val *= math.Pow(colVals[c][i], float64(n))\r\n\u001b[?2004l\r"]
[935.608326, "o", "\u001b[?2004h> "]
[935.608398, "o", "            }\r\n\u001b[?2004l\r"]
[935.608474, "o", "\u001b[?2004h> "]
[935.608671, "o", "            out[i] = formatFloat(val)\r\n\u001b[?2004l\r"]
[935.608732, "o", "\u001b[?2004h> "]
[935.608803, "o", "        }\r\n\u001b[?2004l\r"]
[935.608872, "o", "\u001b[?2004h> "]
[935.609097, "o", "        ds.Columns = append(ds.Columns, name)\r\n\u001b[?2004l\r"]
[935.609157, "o", "\u001b[?2004h> "]
[935.609425, "o", "        ds.Types = append(ds.Types, \"numeric\")\r\n\u001b[?2004l\r"]
[935.609487, "o", "\u001b[?2004h> "]
[935.609692, "o", "        for i, row := range ds.Rows {\r\n\u001b[?2004l\r"]
[935.609753, "o", "\u001b[?2004h> "]
[935.609999, "o", "            ds.Rows[i] = append(row, out[i])\r\n\u001b[?2004l\r"]
[935.610059, "o", "\u001b[?2004h> "]
[935.610129, "o", "        }\r\n\u001b[?2004l\r"]
[935.610205, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[935.610286, "o", "\u001b[?2004h> "]
[935.610358, "o", "    return nil\r\n\u001b[?2004l\r"]
[935.610427, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[935.610497, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[935.610567, "o", "\u001b[?2004h> "]
[935.610798, "o", "func termName(counts map[string]int) string {\r\n\u001b[?2004l\r"]
[935.610855, "o", "\u001b[?2004h> "]
[935.611095, "o", "    keys := make([]string, 0, len(counts))\r\n\u001b[?2004l\r"]
[935.611152, "o", "\u001b[?2004h> "]
[935.611315, "o", "    for k := range counts {\r\n\u001b[?2004l\r"]
[935.611382, "o", "\u001b[?2004h> "]
[935.611515, "o", "        keys = append(keys, k)\r\n\u001b[?2004l\r"]
[935.611579, "o", "\u001b[?2004h> "]
[935.61165, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.611768, "o", "    sort.Strings(keys)\r\n\u001b[?2004l\r"]
[935.611836, "o", "\u001b[?2004h> "]
[935.611939, "o", "    parts := []string{}\r\n\u001b[?2004l\r"]
[935.612002, "o", "\u001b[?2004h> "]
[935.612129, "o", "    for _, k := range keys {\r\n\u001b[?2004l\r"]
[935.612191, "o", "\u001b[?2004h> "]
[935.612308, "o", "        n := counts[k]\r\n\u001b[?2004l\r"]
[935.612368, "o", "\u001b[?2004h> "]
[935.61246, "o", "        if n == 1 {\r\n\u001b[?2004l\r"]
[935.612519, "o", "\u001b[?2004h> "]
[935.612689, "o", "            parts = append(parts, k)\r\n\u001b[?2004l\r"]
[935.612751, "o", "\u001b[?2004h> "]
[935.612842, "o", "        } else {\r\n\u001b[?2004l\r"]
[935.612918, "o", "\u001b[?2004h> "]
[935.61316, "o", "            parts = append(parts, k+\"^\"+strconv.Itoa(n))\r\n\u001b[?2004l\r"]
[935.613229, "o", "\u001b[?2004h> "]
[935.613302, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.613373, "o", ">     }\r\n\u001b[?2004l\r"]
[935.613446, "o", "\u001b[?2004h> "]
[935.613585, "o", "    return strings.Join(parts, \"*\")\r\n\u001b[?2004l\r"]
[935.613646, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[935.613716, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[935.613788, "o", "\u001b[?2004h> "]
[935.614074, "o", "func opWindowAgg(ds *Dataset, op map[string]interface{}) error {\r\n\u001b[?2004l\r"]
[935.614137, "o", "\u001b[?2004h> "]
[935.614322, "o", "    col, ok := getString(op, \"column\")\r\n\u001b[?2004l\r"]
[935.614386, "o", "\u001b[?2004h> "]
[935.61446, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.614531, "o", "> "]
[935.614761, "o", "        return fmt.Errorf(\"window_agg requires column\")\r\n\u001b[?2004l\r"]
[935.614822, "o", "\u001b[?2004h> "]
[935.614895, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.6151, "o", "    window, ok := getInt(op, \"window\")\r\n\u001b[?2004l\r"]
[935.615163, "o", "\u001b[?2004h> "]
[935.615294, "o", "    if !ok || window <= 0 {\r\n\u001b[?2004l\r"]
[935.615358, "o", "\u001b[?2004h> "]
[935.615663, "o", "        return fmt.Errorf(\"window_agg requires positive window\")\r\n\u001b[?2004l\r"]
[935.615732, "o", "\u001b[?2004h"]
[935.615805, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.615979, "o", "    agg, ok := getString(op, \"agg\")\r\n\u001b[?2004l\r"]
[935.616044, "o", "\u001b[?2004h> "]
[935.616116, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[935.616185, "o", "\u001b[?2004h> "]
[935.616417, "o", "        return fmt.Errorf(\"window_agg requires agg\")\r\n\u001b[?2004l\r"]
[935.616468, "o", "\u001b[?2004h> "]
[935.61654, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.61661, "o", "> "]
[935.616754, "o", "    vals, err := ds.NumericColumn(col)\r\n\u001b[?2004l\r"]
[935.616823, "o", "\u001b[?2004h> "]
[935.616918, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[935.616983, "o", "\u001b[?2004h> "]
[935.617056, "o", "        return err\r\n\u001b[?2004l\r"]
[935.61713, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[935.617199, "o", "\u001b[?2004h> "]
[935.617378, "o", "    out := make([]string, len(vals))\r\n\u001b[?2004l\r"]
[935.617438, "o", "\u001b[?2004h> "]
[935.61756, "o", "    for i := range vals {\r\n\u001b[?2004l\r"]
[935.617623, "o", "\u001b[?2004h> "]
[935.617765, "o", "        start := i - window + 1\r\n\u001b[?2004l\r"]
[935.617827, "o", "\u001b[?2004h> "]
[935.617936, "o", "        if start < 0 {\r\n\u001b[?2004l\r"]
[935.618001, "o", "\u001b[?2004h> "]
[935.6181, "o", "            start = 0\r\n\u001b[?2004l\r"]
[935.618162, "o", "\u001b[?2004h> "]
[935.618247, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.618456, "o", "        windowVals := vals[start : i+1]\r\n\u001b[?2004l\r"]
[935.618523, "o", "\u001b[?2004h> "]
[935.618627, "o", "        var res float64\r\n\u001b[?2004l\r"]
[935.618686, "o", "\u001b[?2004h> "]
[935.618787, "o", "        switch agg {\r\n\u001b[?2004l\r"]
[935.618849, "o", "\u001b[?2004h> "]
[935.618946, "o", "        case \"mean\":\r\n\u001b[?2004l\r"]
[935.619008, "o", "\u001b[?2004h> "]
[935.61911, "o", "            sum := 0.0\r\n\u001b[?2004l\r"]
[935.619167, "o", "\u001b[?2004h> "]
[935.619376, "o", "            for _, v := range windowVals {\r\n\u001b[?2004l\r"]
[935.619437, "o", "\u001b[?2004h> "]
[935.619553, "o", "                sum += v\r\n\u001b[?2004l\r"]
[935.619615, "o", "\u001b[?2004h> "]
[935.619686, "o", "            }\r\n\u001b[?2004l\r"]
[935.619759, "o", "\u001b[?2004h> "]
[935.619965, "o", "            res = sum / float64(len(windowVals))\r\n\u001b[?2004l\r"]
[935.620024, "o", "\u001b[?2004h> "]
[935.620126, "o", "        case \"sum\":\r\n\u001b[?2004l\r"]
[935.62019, "o", "\u001b[?2004h> "]
[935.620394, "o", "            for _, v := range windowVals {\r\n\u001b[?2004l\r"]
[935.620457, "o", "\u001b[?2004h> "]
[935.620576, "o", "                res += v\r\n\u001b[?2004l\r"]
[935.620638, "o", "\u001b[?2004h> "]
[935.620706, "o", "            }\r\n\u001b[?2004l\r"]
[935.62078, "o", "\u001b[?2004h> "]
[935.620852, "o", "        case \"max\":\r\n\u001b[?2004l\r"]
[935.620922, "o", "\u001b[?2004h> "]
[935.62106, "o", "            res = windowVals[0]\r\n\u001b[?2004l\r"]
[935.621126, "o", "\u001b[?2004h> "]
[935.621327, "o", "            for _, v := range windowVals {\r\n\u001b[?2004l\r"]
[935.621384, "o", "\u001b[?2004h> "]
[935.621523, "o", "                if v > res {\r\n\u001b[?2004l\r"]
[935.621587, "o", "\u001b[?2004h> "]
[935.621717, "o", "                    res = v\r\n\u001b[?2004l\r"]
[935.621781, "o", "\u001b[?2004h> "]
[935.621855, "o", "                }\r\n\u001b[?2004l\r"]
[935.62193, "o", "\u001b[?2004h> "]
[935.622, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.622072, "o", "> "]
[935.622142, "o", "        case \"min\":\r\n\u001b[?2004l\r"]
[935.622211, "o", "\u001b[?2004h> "]
[935.62235, "o", "            res = windowVals[0]\r\n\u001b[?2004l\r"]
[935.62241, "o", "\u001b[?2004h> "]
[935.622613, "o", "            for _, v := range windowVals {\r\n\u001b[?2004l\r"]
[935.622682, "o", "\u001b[?2004h> "]
[935.622807, "o", "                if v < res {\r\n\u001b[?2004l\r"]
[935.622872, "o", "\u001b[?2004h> "]
[935.622969, "o", "                    res = v\r\n\u001b[?2004l\r"]
[935.623032, "o", "\u001b[?2004h> "]
[935.623106, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.623177, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.623256, "o", "> "]
[935.623329, "o", "        default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.623565, "o", "            return fmt.Errorf(\"unsupported aggregation: %s\", agg)\r\n\u001b[?2004l\r"]
[935.623624, "o", "\u001b[?2004h> "]
[935.623692, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.623825, "o", "        out[i] = formatFloat(res)\r\n\u001b[?2004l\r"]
[935.623883, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[935.623956, "o", "\u001b[?2004h> "]
[935.624201, "o", "    ds.Columns = append(ds.Columns, col+\"_\"+agg+\"_w\"+strconv.Itoa(window))\r\n\u001b[?2004l\r"]
[935.624282, "o", "\u001b[?2004h> "]
[935.624407, "o", "    ds.Types = append(ds.Types, \"numeric\")\r\n\u001b[?2004l\r"]
[935.624468, "o", "\u001b[?2004h> "]
[935.624577, "o", "    for i, row := range ds.Rows {\r\n\u001b[?2004l\r"]
[935.624637, "o", "\u001b[?2004h> "]
[935.624769, "o", "        ds.Rows[i] = append(row, out[i])\r\n\u001b[?2004l\r"]
[935.624826, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[935.624896, "o", "\u001b[?2004h> "]
[935.624968, "o", "    return nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[935.625036, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.625236, "o", "func uniqueStrings(vals []string) []string {\r\n\u001b[?2004l\r"]
[935.625302, "o", "\u001b[?2004h> "]
[935.625387, "o", "    seen := map[string]bool{}\r\n\u001b[?2004l\r"]
[935.625449, "o", "\u001b[?2004h> "]
[935.625519, "o", "    res := []string{}\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.625587, "o", "> "]
[935.625659, "o", "    for _, v := range vals {\r\n\u001b[?2004l\r"]
[935.625729, "o", "\u001b[?2004h> "]
[935.625798, "o", "        if !seen[v] {\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.625866, "o", "> "]
[935.625935, "o", "            seen[v] = true\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.626004, "o", "> "]
[935.62609, "o", "            res = append(res, v)\r\n\u001b[?2004l\r"]
[935.626163, "o", "\u001b[?2004h> "]
[935.62625, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.626313, "o", "> "]
[935.626383, "o", "    return res\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[935.626452, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[935.629446, "o", "\u001b[?2004hroot@n30009:/app# "]
[1058.890675, "i", "head -n 20 transform.go; echo '---'; tail -n 20 transform.go\n"]
[1058.891177, "o", "head -n 20 transform.go; echo '---'; tail -n 20 transform.go\r\n\u001b[?2004l\r"]
[1058.893657, "o", "package main\r\n\r\nimport (\r\n    \"fmt\"\r\n    \"math\"\r\n    \"sort\"\r\n    \"strconv\"\r\n"]
[1058.89374, "o", "    \"strings\"\r\n)\r\n\r\nfunc executeTransform(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n    if inputs[\"data\"] == nil || inputs[\"data\"].Dataset == nil {\r\n        return nil, fmt.Errorf(\"transform stage %q requires input data\", stage.Name)\r\n    }\r\n    ds := inputs[\"data\"].Dataset.Copy()\r\n\r\n    opsVal, ok := params[\"operations\"]\r\n    if !ok {\r\n        return nil, fmt.Errorf(\"transform stage %q missing operations\", stage.Name)\r\n    }\r\n"]
[1058.894062, "o", "---\r\n"]
[1058.896117, "o", "    }\r\n    ds.Columns = append(ds.Columns, col+\"_\"+agg+\"_w\"+strconv.Itoa(window))\r\n    ds.Types = append(ds.Types, \"numeric\")\r\n    for i, row := range ds.Rows {\r\n        ds.Rows[i] = append(row, out[i])\r\n"]
[1058.896185, "o", "    }\r\n    return nil\r\n}\r\n\r\nfunc uniqueStrings(vals []string) []string {\r\n    seen := map[string]bool{}\r\n    res := []string{}\r\n    for _, v := range vals {\r\n        if !seen[v] {\r\n            seen[v] = true\r\n            res = append(res, v)\r\n        }\r\n    }\r\n    return res\r\n}\r\n"]
[1058.896572, "o", "\u001b[?2004h"]
[1058.89663, "o", "root@n30009:/app# "]
[1059.168415, "i", "gofmt -e transform.go >/tmp/gofmt_check 2>&1; echo \"gofmt_status=$?\"; head -n 5 /tmp/gofmt_check\n"]
[1059.169074, "o", "gofmt -e transform.go >/tmp/gofmt_check 2>&1; echo \"gofmt_status=$?\"; head -n 5 /tmp/gofmt_check\r\n\u001b[?2004l\r"]
[1059.181043, "o", "gofmt_status=0\r\n"]
[1059.183036, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
