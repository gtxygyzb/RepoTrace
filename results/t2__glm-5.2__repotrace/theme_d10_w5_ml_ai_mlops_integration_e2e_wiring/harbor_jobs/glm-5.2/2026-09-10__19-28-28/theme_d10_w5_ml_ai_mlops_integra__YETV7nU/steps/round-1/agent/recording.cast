[11863.908128, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar \u001b[01;31m\u001b[Kskip\u001b[m\u001b[KStages []string\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K393\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase args[i] == \"--\u001b[01;31m\u001b[Kskip\u001b[m\u001b[K-stage\":\r\n"]
[11863.908189, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K395\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"--\u001b[01;31m\u001b[Kskip\u001b[m\u001b[K-stage requires a value\")\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K397\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kskip\u001b[m\u001b[KStages = append(\u001b[01;31m\u001b[Kskip\u001b[m\u001b[KStages, args[i+1])\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase strings.HasPrefix(args[i], \"--\u001b[01;31m\u001b[Kskip\u001b[m\u001b[K-stage=\"):\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kskip\u001b[m\u001b[KStages = append(\u001b[01;31m\u001b[Kskip\u001b[m\u001b[KStages, strings.TrimPrefix(args[i], \"--\u001b[01;31m\u001b[Kskip\u001b[m\u001b[K-stage=\"))\r\n"]
[11863.908261, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"usage: mlpipe run <config.json> [--param key=value ...] [--cv K] [--no-cache] [--\u001b[01;31m\u001b[Kskip\u001b[m\u001b[K-stage name ...]\")\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn configPath, overrides, cv, noCache, \u001b[01;31m\u001b[Kskip\u001b[m\u001b[KStages, nil\r\n"]
