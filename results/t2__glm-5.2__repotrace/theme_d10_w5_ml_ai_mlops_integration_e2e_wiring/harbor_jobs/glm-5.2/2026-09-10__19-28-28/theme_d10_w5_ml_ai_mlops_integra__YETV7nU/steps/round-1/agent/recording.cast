[10363.339083, "o", "\u001b[32m\u001b[K444\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K445\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc printJSON(v interface{}) {\r\n\u001b[32m\u001b[K446\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdata, err := json.MarshalIndent(v, \"\", \"  \")\r\n"]
[10363.33917, "o", "\u001b[32m\u001b[K447\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K448\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tprintError(err.Error())\r\n\u001b[32m\u001b[K449\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K450\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K451\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Println(string(data))\r\n\u001b[32m\u001b[K452\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K453\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[10363.339263, "o", "\u001b[32m\u001b[K454\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc printError\u001b[m\u001b[K(msg string) {\r\n\u001b[32m\u001b[K455\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdata, _ := json.Marshal(map[string]string{\"error\": msg})\r\n"]
[10363.339319, "o", "\u001b[32m\u001b[K456\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Fprintln(os.Stderr, string(data))\r\n\u001b[32m\u001b[K457\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tos.Exit(1)\r\n\u001b[32m\u001b[K458\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
