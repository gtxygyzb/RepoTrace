[8908.862505, "o", "   184\t}\r\n   185\t\r\n   186\tfunc (ds *Dataset) setColumnValues(name string, values []string, typ string) {\r\n   187\t\tidx, ok := ds.ColumnIndex(name)\r\n   188\t\tif !ok {\r\n   189\t\t\tds.Columns = append(ds.Columns, name)\r\n   190\t\t\tds.Types = append(ds.Types, typ)\r\n   191\t\t\tfor i, row := range ds.Rows {\r\n   192\t\t\t\tif i < len(values) {\r\n   193\t\t\t\t\tds.Rows[i] = append(row, values[i])\r\n   194\t\t\t\t} else {\r\n   195\t\t\t\t\tds.Rows[i] = append(row, \"\")\r\n   196\t\t\t\t}\r\n"]
