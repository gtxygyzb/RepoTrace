[8984.241642, "o", "   157\tfunc serializeArtifactValue(val *ArtifactValue) ([]byte, error) {\r\n   158\t\tif val.Dataset != nil {\r\n   159\t\t\ttypesMap := make(map[string]string, len(val.Dataset.Columns))\r\n   160\t\t\tfor i, col := range val.Dataset.Columns {\r\n   161\t\t\t\tif i < len(val.Dataset.Types) {\r\n"]
[8984.241733, "o", "   162\t\t\t\t\ttypesMap[col] = val.Dataset.Types[i]\r\n   163\t\t\t\t}\r\n   164\t\t\t}\r\n   165\t\t\tobj := map[string]interface{}{\r\n   166\t\t\t\t\"type\":    \"dataset\",\r\n   167\t\t\t\t\"columns\": val.Dataset.Columns,\r\n   168\t\t\t\t\"types\":   typesMap,\r\n   169\t\t\t\t\"rows\":    val.Dataset.Rows,\r\n   170\t\t\t}\r\n   171\t\t\treturn json.MarshalIndent(obj, \"\", \"  \")\r\n   172\t\t}\r\n   173\t\tif val.Model != nil {\r\n   174"]
[8984.241808, "o", "\t\t\tobj := map[string]interface{}{\r\n   175\t\t\t\t\"type\":  \"model\",\r\n   176\t\t\t\t\"model\": val.Model,\r\n   177\t\t\t}\r\n   178\t\t\treturn json.MarshalIndent(obj, \"\", \"  \")\r\n"]
[8984.24187, "o", "   179\t\t}\r\n   180\t\tif val.Report != nil {\r\n   181\t\t\tobj := map[string]interface{}{\r\n   182\t\t\t\t\"type\":    \"report\",\r\n   183\t\t\t\t\"metrics\": val.Report.Metrics,\r\n   184\t\t\t\t\"pass\":    val.Report.Pass,\r\n   185\t\t\t}\r\n   186\t\t\treturn json.MarshalIndent(obj, \"\", \"  \")\r\n   187\t\t}\r\n   188\t\tif val.Entry != nil {\r\n   189\t\t\tobj := map[string]interface{}{\r\n   190\t\t\t\t\"type\":    \"entry\",\r\n   191\t\t\t\t\"name\":    val.Entry.Name,\r\n   192\t\t\t\t\"version\": val.Entry.Version,\r\n"]
[8984.24193, "o", "   193\t\t\t\t\"stage\":   val.Entry.Stage,\r\n   194\t\t\t}\r\n   195\t\t\treturn json.MarshalIndent(obj, \"\", \"  \")\r\n   196\t\t}\r\n   197\t\treturn nil, fmt.Errorf(\"cannot serialize unknown artifact type\")\r\n   198\t}\r\n   199\t\r\n   200\tfunc deserializeArtifactValue(data []byte) (*ArtifactValue, error) {\r\n   201\t\tvar obj map[string]interface{}\r\n"]
[8984.242043, "o", "   202\t\tif err := json.Unmarshal(data, &obj); err != nil {\r\n   203\t\t\treturn nil, err\r\n   204\t\t}\r\n   205\t\ttyp, _ := obj[\"type\"].(string)\r\n   206\t\tswitch typ {\r\n   207\t\tcase \"dataset\":\r\n   208\t\t\treturn deserializeDatasetValue(obj)\r\n   209\t\tcase \"model\":\r\n   210\t\t\treturn deserializeModelValue(obj)\r\n   211\t\tcase \"report\":\r\n   212\t\t\tmetrics, _ := obj[\"metrics\"].(map[string]interface{})\r\n   213\t\t\tpass, _ := obj[\"pass\"].(bool)\r\n   214\t\t\treturn &ArtifactValue{Report: &Report{Metrics: metrics, Pass: pass}}, nil\r\n   215\t\tcase \"entry\":\r\n   216\t\t\tname, _ := obj[\"name\"].(string)\r\n   217\t\t\tversion, _ := obj[\"version\"].(float64)\r\n   218\t\t\tstage, _ := obj[\"stage\"].(string)\r\n"]
[8984.242105, "o", "   219\t\t\treturn &ArtifactValue{Entry: &RegistryEntry{Name: name, Version: int(version), Stage: stage}}, nil\r\n   220\t\t}\r\n   221\t\treturn nil, fmt.Errorf(\"unknown artifact type in cache: %s\", typ)\r\n   222\t}\r\n   223\t\r\n   224\tfunc deserializeDatasetValue(obj map[string]interface{}) (*ArtifactValue, error) {\r\n   225\t\tcols, _ := obj[\"columns\"].([]interface{})\r\n   226\t\ttypesMap, _ := obj[\"types\"].(map[string]interface{})\r\n   227\t\trows, _ := obj[\"rows\"].([]interface{})\r\n   228\t\tds := &Dataset{\r\n   229"]
[8984.242166, "o", "\t\t\tColumns: make([]string, len(cols)),\r\n   230\t\t\tTypes:   make([]string, len(cols)),\r\n   231\t\t\tRows:    make([][]string, len(rows)),\r\n   232\t\t}\r\n   233\t\tfor i, c := range cols {\r\n   234\t\t\tds.Columns[i], _ = c.(string)\r\n   235\t\t}\r\n   236\t\tfor i, col := range ds.Columns {\r\n   237\t\t\tif t, ok := typesMap[col]; ok {\r\n   238\t"]
[8984.242314, "o", "\t\t\tds.Types[i], _ = t.(string)\r\n   239\t\t\t}\r\n   240\t\t}\r\n   241\t\tfor i, r := range rows {\r\n   242\t\t\trow, _ := r.([]interface{})\r\n   243\t\t\tds.Rows[i] = make([]string, len(row))\r\n   244\t\t\tfor j, v := range row {\r\n   245\t\t\t\tds.Rows[i][j], _ = v.(string)\r\n   246\t\t\t}\r\n   247\t\t}\r\n   248\t\treturn &ArtifactValue{Dataset: ds}, nil\r\n   249\t}\r\n   250\t\r\n   251\tfunc deserializeModelValue(obj map[string]interface{}) (*ArtifactValue, error) {\r\n   252\t\tmodelData, err := json.Marshal(obj[\"model\"])\r\n   253\t\tif err != nil {\r\n   254\t\t"]
[8984.242378, "o", "\treturn nil, err\r\n   255\t\t}\r\n   256\t\tvar model Model\r\n   257\t\tif err := json.Unmarshal(modelData, &model); err != nil {\r\n   258\t\t\treturn nil, err\r\n   259\t\t}\r\n   260\t\treturn &ArtifactValue{Model: &model}, nil\r\n   261\t}\r\n"]
[8984.242438, "o", "   262\t\r\n   263\tfunc loadCacheEntry(key string) (map[string]*ArtifactValue, error) {\r\n   264\t\tdir := cacheEntryPath(key)\r\n   265\t\tmetaData, err := os.ReadFile(filepath.Join(dir, \"meta.json\"))\r\n   266\t\tif err != nil {\r\n   267\t\t\treturn nil, err\r\n   268\t\t}\r\n   269\t\tvar meta cacheMeta\r\n   270\t\tif err := json.Unmarshal(metaData, &meta); err != nil {\r\n   271\t\t\treturn nil, err\r\n"]
[8984.242495, "o", "   272\t\t}\r\n   273\t\toutputs := map[string]*ArtifactValue{}\r\n   274\t\tfor _, port := range meta.OutputPorts {\r\n   275\t\t\tportData, err := os.ReadFile(filepath.Join(dir, port+\".json\"))\r\n   276\t\t\tif err != nil {\r\n   277\t\t\t\treturn nil, err\r\n   278\t\t\t}\r\n"]
[8984.242552, "o", "   279\t\t\tval, err := deserializeArtifactValue(portData)\r\n   280\t\t\tif err != nil {\r\n   281\t\t\t\treturn nil, err\r\n   282\t\t\t}\r\n   283\t\t\toutputs[port] = val\r\n   284\t\t}\r\n   285\t\treturn outputs, nil\r\n   286\t}\r\n   287\t\r\n"]
[8984.242612, "o", "   288\tfunc saveCacheEntry(key, stageName, stageType string, outputs map[string]*ArtifactValue) error {\r\n   289\t\tdir := cacheEntryPath(key)\r\n   290\t\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n"]
