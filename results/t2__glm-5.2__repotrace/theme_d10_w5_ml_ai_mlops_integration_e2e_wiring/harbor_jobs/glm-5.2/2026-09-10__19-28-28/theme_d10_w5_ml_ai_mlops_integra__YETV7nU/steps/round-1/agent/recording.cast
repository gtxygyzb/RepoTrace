[10435.569607, "o", "   161\tfunc promoteModel(name string, version int, targetStage string) (*RegistryEntry, string, string, error) {\r\n   162\t\tvalid := map[string]bool{\"staging\": true, \"production\": true, \"archived\": true}\r\n   163\t\tif !valid[targetStage] {\r\n   164\t\t\treturn nil, \"\", \"\", fmt.Errorf(\"invalid promotion: invalid target stage %q\", targetStage)\r\n   165\t\t}\r\n   166\t\tentries, err := loadRegistry()\r\n   167\t\tif err != nil {\r\n"]
[10435.569729, "o", "   168\t\t\treturn nil, \"\", \"\", err\r\n   169\t\t}\r\n   170\t\tvar entry *RegistryEntry\r\n   171\t\tfor _, e := range entries {\r\n   172\t\t\tif e.Name == name && e.Version == version {\r\n   173\t\t\t\tentry = e\r\n   174\t\t\t\tbreak\r\n   175\t\t\t}\r\n   176\t\t}\r\n   177\t\tif entry == nil {\r\n   178\t\t\treturn nil, \"\", \"\", fmt.Errorf(\"model not found: %s:%d\", name, version)\r\n   179\t\t}\r\n   180\t\r\n   181\t\tprevStage := entry.Stage\r\n   182\t\tif !validPromotionTransition(prevStage, targetStage) {\r\n   183\t\t\treturn nil, \"\", \"\", fmt.Errorf(\"invalid promotion: cannot promote from %s to %s\", prevStage, targetStage)\r\n   184\t\t}\r\n   185"]
[10435.569803, "o", "\t\r\n   186\t\tif targetStage == \"production\" {\r\n   187\t\t\tif entry.PromotionRules != nil {\r\n   188\t\t\t\tif rules, ok := entry.PromotionRules[targetStage].(map[string]interface{}); ok {\r\n   189\t\t\t\t\tfor metricName, thresholdVal := range rules {\r\n   190\t\t\t\t\t\tmetricValue, ok := entry.Metrics[metricName]\r\n   191\t\t\t\t\t\tif !ok {\r\n   192\t\t\t\t\t\t\tcontinue\r\n   193\t\t\t\t\t\t}\r\n   194\t\t\t\t\t\tmv, ok := toFloat64(metricValue)\r\n"]
[10435.569869, "o", "   195\t\t\t\t\t\tif !ok {\r\n   196\t\t\t\t\t\t\tcontinue\r\n   197\t\t\t\t\t\t}\r\n   198\t\t\t\t\t\ttv, ok := toFloat64(thresholdVal)\r\n   199\t\t\t\t\t\tif !ok {\r\n   200\t\t\t\t\t\t\tcontinue\r\n   201\t\t\t\t\t\t}\r\n"]
[10435.569931, "o", "   202\t\t\t\t\t\tif mv < tv {\r\n   203\t\t\t\t\t\t\treturn nil, prevStage, targetStage, fmt.Errorf(\"metric %s (%v) below threshold (%v)\", metricName, mv, tv)\r\n   204\t\t\t\t\t\t}\r\n   205\t\t\t\t\t}\r\n   206\t\t\t\t}\r\n   207\t\t\t}\r\n   208\t\t\tfor _, e := range entries {\r\n   209"]
[10435.569991, "o", "\t\t\t\tif e.Name == name && e.Stage == \"production\" && e.Version != version {\r\n   210\t\t\t\t\te.Stage = \"archived\"\r\n   211\t\t\t\t}\r\n   212\t\t\t}\r\n   213\t\t}\r\n   214\t\r\n   215\t\t"]
[10435.570049, "o", "entry.Stage = targetStage\r\n   216\t\tif err := saveRegistry(entries); err != nil {\r\n   217\t\t\treturn nil, \"\", \"\", err\r\n   218\t\t}\r\n   219\t\treturn entry, prevStage, targetStage, nil\r\n   220\t}\r\n   221\t\r\n   222\tfunc validPromotionTransition(from, to string) bool {\r\n   223"]
[10435.570119, "o", "\t\tif from == \"staging\" && to == \"production\" {\r\n   224\t\t\treturn true\r\n   225\t\t}\r\n   226\t\tif from == \"production\" && to == \"archived\" {\r\n   227\t\t\treturn true\r\n   228\t\t}\r\n"]
[10435.570175, "o", "   229\t\treturn false\r\n   230\t}\r\n"]
