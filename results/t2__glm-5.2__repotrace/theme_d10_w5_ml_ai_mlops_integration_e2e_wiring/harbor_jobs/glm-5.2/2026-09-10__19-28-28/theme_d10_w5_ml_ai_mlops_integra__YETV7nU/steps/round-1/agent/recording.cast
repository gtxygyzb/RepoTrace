[12194.872287, "o", "    32\t\r\n    33\tfunc buildPlan(config *Config, overrides map[string]string, cv int) (*PlanOutput, error) {\r\n    34\t\tvalid, errs := config.Validate()\r\n    35\t\tif !valid {\r\n    36\t\t\treturn nil, fmt.Errorf(\"invalid pipeline: %s\", errs[0])\r\n    37\t\t}\r\n    38\t\tif cv > 0 {\r\n    39\t\t\tif err := config.validateCV(); err != nil {\r\n    40\t\t\t\treturn nil, err\r\n    41\t\t\t}\r\n    42\t\t}\r\n    43\t\r\n    44\t\torder, err := config.topologicalOrder()\r\n    45\t\tif err != nil {\r\n    46\t\t\treturn nil, err\r\n    47\t\t}\r\n    48\t\r\n    49\t\tmode := \"standard\"\r\n    50\t\tif cv > 0 {\r\n"]
[12194.872352, "o", "    51\t\t\tmode = \"cv\"\r\n    52\t\t}\r\n    53\t\r\n    54\t\tpostSplit := map[string]bool{}\r\n    55\t\tsplitName := \"\"\r\n    56\t\tif cv > 0 {\r\n    57\t\t\tsplitName, _ = config.splitStageName()\r\n    58\t\t\tpostSplit = config.postSplitStages(splitName)\r\n    59\t\t}\r\n    60\t\r\n    61\t\texecutionOrder := []string{}\r\n    62\t\tif cv > 0 {\r\n"]
[12194.872413, "o", "    63\t\t\tfor _, name := range order {\r\n    64\t\t\t\tif !postSplit[name] {\r\n    65\t\t\t\t\texecutionOrder = append(executionOrder, name)\r\n    66\t\t\t\t}\r\n    67\t\t\t}\r\n    68\t\t\tfor _, name := range order {\r\n    69\t\t\t\tif postSplit[name] {\r\n    70"]
[12194.872472, "o", "\t\t\t\t\texecutionOrder = append(executionOrder, name)\r\n    71\t\t\t\t}\r\n    72\t\t\t}\r\n    73\t\t} else {\r\n    74\t\t\texecutionOrder = append(executionOrder, order...)\r\n    75\t\t}\r\n    76\t\r\n    77\t\tcacheKeys := map[string]string{}\r\n    78\t\tstages := map[string]PlanStage{}\r\n    79\t\tedges := []PlanEdge{}\r\n    80\t\r\n"]
[12194.872537, "o", "    81\t\tfor _, name := range order {\r\n    82\t\t\tstage, _ := config.stageByName(name)\r\n    83\t\t\tdeps := stage.DependsOn\r\n    84\t\t\tif deps == nil {\r\n    85\t\t\t\tdeps = []string{}\r\n    86\t\t\t}\r\n    87\t\r\n    88\t\t\tinputTypes := map[string]string{}\r\n    89\t\t\tfor local, ref := range stage.Inputs {\r\n    90\t\t\t\trefs, ok := inputRefs(ref)\r\n"]
[12194.872601, "o", "    91\t\t\t\tif !ok {\r\n    92\t\t\t\t\tcontinue\r\n    93\t\t\t\t}\r\n    94\t\t\t\tfor _, r := range refs {\r\n    95\t\t\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n    96\t\t\t\t\tif len(parts) != 2 {\r\n    97\t\t\t\t\t\tcontinue\r\n    98\t\t\t\t\t}\r\n"]
[12194.872663, "o", "    99\t\t\t\t\trefStage, ok := config.stageByName(parts[0])\r\n   100\t\t\t\t\tif !ok {\r\n   101\t\t\t\t\t\tcontinue\r\n   102\t\t\t\t\t}\r\n   103\t\t\t\t\tinputTypes[local] = outputPortType(refStage.Type, parts[1])\r\n   104\t\t\t\t\tedges = append(edges, PlanEdge{From: parts[0], To: name, Port: parts[1]})\r\n   105\t\t\t\t}\r\n"]
[12194.872726, "o", "   106\t\t\t}\r\n   107\t\r\n   108\t\t\toutputTypes := map[string]string{}\r\n   109\t\t\tfor _, port := range validOutputPorts(stage.Type) {\r\n   110\t\t\t\toutputTypes[port] = outputPortType(stage.Type, port)\r\n   111\t\t\t}\r\n   112\t\r\n   113\t\t\tcacheStatus := \"unknown\"\r\n   114\t\t\tphase := (*string)(nil)\r\n   115\t\t\tif cv > 0 {\r\n   116\t\t\t\tif postSplit[name] {\r\n   117\t\t"]
