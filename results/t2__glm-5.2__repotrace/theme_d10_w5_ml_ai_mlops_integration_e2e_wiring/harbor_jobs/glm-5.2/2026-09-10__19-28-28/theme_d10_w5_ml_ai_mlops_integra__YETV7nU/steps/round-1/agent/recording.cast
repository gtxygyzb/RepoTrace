[2933.391589, "o", "\t\t\te.results[name].Status = \"failed\"\r\n\t\t\te.results[name].Error = err.Error()\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\te.status[name] = \"success\"\r\n\t\te.results[name].Status = \"success\"\r\n\t\tts := time.Now().UnixNano()\r\n"]
[2933.39168, "o", "\r\n\t\tfor port, val := range out {\r\n\t\t\tid := artifactID(e.config.Pipeline.Name, name, port, ts)\r\n\t\t\te.values[name][port] = val\r\n\t\t\te.outputs[name][port] = id\r\n\t\t\ttyp := val.Type()\r\n\t\t\tsummary := val.Summary()\r\n\t\t\tmeta := &ArtifactMeta{\r\n\t\t\t\tID:        id,\r\n\t\t\t\tStage:     name,\r\n\t\t\t\tPort:      port,\r\n\t\t\t\tType:      typ,\r\n"]
[2933.391764, "o", "\t\t\t\tSummary:   summary,\r\n\t\t\t\tInputs:    inputIDs,\r\n\t\t\t\tOutputs:   []string{},\r\n\t\t\t\tTimestamp: ts,\r\n\t\t\t}\r\n\t\t\te.meta[id] = meta\r\n\t\t\tfor _, inID := range inputIDs {\r\n\t\t\t\tif parent, ok := e.meta[inID]; ok {\r\n\t\t\t\t\tparent.Outputs = appendUnique(parent.Outputs, id)\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[2933.391846, "o", "\t\t\trunArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n\t\t}\r\n\t}\r\n\r\n\tstatus := \"success\"\r\n\tfor _, s := range e.results {\r\n\t\tif s.Status != \"success\" {\r\n\t\t\tstatus = \"failed\"\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n"]
[2933.391913, "o", "\r\n\trun := &RunOutput{\r\n\t\tPipeline:  e.config.Pipeline.Name,\r\n\t\tStatus:    status,\r\n\t\tStages:    e.results,\r\n\t\tArtifacts: runArtifacts,\r\n\t}\r\n\r\n\tif err := saveArtifacts(e.meta); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif err := saveRun(run); err != nil {\r\n"]
[2933.39196, "o", "\t\treturn nil, err\r\n\t}\r\n\r\n\treturn run, nil\r\n}\r\n\r\n"]
