[12991.581495, "o", "    53\tfunc executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n    54\t\tvar ds *Dataset\r\n    55\t\tfor _, in := range inputs {\r\n    56\t\t\tif in != nil && in.Dataset != nil {\r\n    57\t\t\t\tds = in.Dataset\r\n    58\t\t\t\tbreak\r\n    59\t\t\t}\r\n"]
[12991.581561, "o", "    60\t\t}\r\n    61\t\tif ds == nil {\r\n    62\t\t\treturn nil, fmt.Errorf(\"train stage %q requires input data\", stage.Name)\r\n    63\t\t}\r\n    64\t\r\n    65\t\talgorithm, ok := getString(params, \"algorithm\")\r\n    66\t\tif !ok {\r\n    67\t\t\t"]
[12991.581622, "o", "return nil, fmt.Errorf(\"train stage %q requires algorithm\", stage.Name)\r\n    68\t\t}\r\n    69\t\ttarget, ok := getString(params, \"target\")\r\n    70\t\tif !ok {\r\n    71\t\t\treturn nil, fmt.Errorf(\"train stage %q requires target\", stage.Name)\r\n    72\t\t}\r\n    73\t\ttargetVals, err := ds.NumericColumn(target)\r\n    74\t\tif err != nil {\r\n    75\t\t\treturn nil, err\r\n"]
[12991.581685, "o", "    76\t\t}\r\n    77\t\tclassification := isBinary01(targetVals)\r\n    78\t\tif algorithm == \"linear-regression\" {\r\n    79\t\t\tclassification = false\r\n    80\t\t}\r\n    81\t\tif algorithm == \"logistic-regression\" {\r\n"]
[12991.581746, "o", "    82\t\t\tclassification = true\r\n    83\t\t}\r\n    84\t\r\n    85\t\tfeatures, ok := getStringSlice(params, \"features\")\r\n    86\t\tif !ok || len(features) == 0 {\r\n    87\t\t\tfeatures = []string{}\r\n    88\t\t\tfor i, col := range ds.Columns {\r\n    89\t"]
[12991.581806, "o", "\t\t\tif col == target {\r\n    90\t\t\t\t\tcontinue\r\n    91\t\t\t\t}\r\n    92\t\t\t\tif i < len(ds.Types) && ds.Types[i] == \"numeric\" {\r\n    93\t\t\t\t\tfeatures = append(features, col)\r\n    94\t\t\t\t}\r\n"]
[12991.581866, "o", "    95\t\t\t}\r\n    96\t\t}\r\n    97\t\tX, err := ds.featureMatrix(features)\r\n    98\t\tif err != nil {\r\n    99\t\t\treturn nil, err\r\n"]
[12991.581926, "o", "   100\t\t}\r\n   101\t\ty := targetVals\r\n   102\t\r\n   103\t\thp := getMapDefault(params, \"hyperparams\", map[string]interface{}{})\r\n   104\t\tmodel := &Model{Algorithm: algorithm, Target: target, Features: features, Hyperparams: hp, Classification: classification, TrainFeatures: X, TrainTarget: y}\r\n"]
[12991.581986, "o", "   105\t\r\n   106\t\tswitch algorithm {\r\n   107\t\tcase \"linear-regression\":\r\n   108\t\t\tw, err := trainLinearRegression(X, y)\r\n   109\t\t\tif err != nil {\r\n   110\t\t\t\treturn nil, err\r\n   111\t\t\t}\r\n"]
[12991.582046, "o", "   112\t\t\tmodel.LinearWeights = w\r\n   113\t\tcase \"logistic-regression\":\r\n   114\t\t\tlr := getFloatDefault(hp, \"learning_rate\", 0.01)\r\n   115\t\t\tepochs := getIntDefault(hp, \"epochs\", 1000)\r\n   116\t\t\tw, err := trainLogisticRegression(X, y, lr, epochs)\r\n   117\t\t\tif err != nil {\r\n   118\t\t\t\treturn nil, err\r\n   119\t\t\t}\r\n"]
