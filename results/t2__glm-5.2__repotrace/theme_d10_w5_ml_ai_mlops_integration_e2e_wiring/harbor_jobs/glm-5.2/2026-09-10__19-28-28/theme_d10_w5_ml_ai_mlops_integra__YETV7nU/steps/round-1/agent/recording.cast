[5326.155954, "o", "\u001b[?2004h> "]
[5326.15607, "o", "                foldStatus = \"failed\"\r\n\u001b[?2004l\r"]
[5326.156124, "o", "\u001b[?2004h> "]
[5326.156193, "o", "                break\r\n\u001b[?2004l\r"]
[5326.15626, "o", "\u001b[?2004h> "]
[5326.156314, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.156369, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5326.156424, "o", "\u001b[?2004h> "]
[5326.156571, "o", "        for id, art := range foldArtifacts {\r\n\u001b[?2004l\r"]
[5326.156626, "o", "\u001b[?2004h> "]
[5326.156744, "o", "            allArtifacts[id] = art\r\n\u001b[?2004l\re"]
[5326.1568, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
