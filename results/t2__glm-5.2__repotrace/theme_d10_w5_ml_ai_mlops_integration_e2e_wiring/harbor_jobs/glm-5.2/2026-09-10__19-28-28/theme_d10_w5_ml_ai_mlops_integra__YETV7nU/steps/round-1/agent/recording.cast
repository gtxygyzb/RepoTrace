[1943.162063, "o", "\u001b[?2004h> "]
[1943.162174, "o", "        sort.Float64s(sorted)\r\n\u001b[?2004l\r"]
[1943.162236, "o", "\u001b[?2004h> "]
[1943.162411, "o", "        for s := 0; s < len(sorted)-1; s++ {\r\n\u001b[?2004l\r"]
[1943.162467, "o", "\u001b[?2004h> "]
[1943.162678, "o", "            threshold := (sorted[s] + sorted[s+1]) / 2\r\n\u001b[?2004l\r"]
[1943.162733, "o", "\u001b[?2004h> "]
[1943.162847, "o", "            leftIdx := []int{}\r\n\u001b[?2004l\r"]
