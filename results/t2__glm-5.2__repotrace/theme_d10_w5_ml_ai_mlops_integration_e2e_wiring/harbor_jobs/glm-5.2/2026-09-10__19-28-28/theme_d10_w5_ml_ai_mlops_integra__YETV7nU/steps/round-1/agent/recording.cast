[11263.353662, "o", "func runStatus(run interface{}) string {\r\n\u001b[?2004l\r"]
[11263.353732, "o", "\u001b[?2004h> "]
[11263.353868, "o", "    switch r := run.(type) {\r\n\u001b[?2004l\r"]
[11263.353943, "o", "\u001b[?2004h> "]
[11263.35402, "o", "    case *RunOutput:\r\n\u001b[?2004l\r"]
[11263.354079, "o", "\u001b[?2004h> "]
[11263.354208, "o", "        return r.Status\r\n\u001b[?2004l\r"]
[11263.354266, "o", "\u001b[?2004h> "]
[11263.354371, "o", "    case *CVRunOutput:\r\n\u001b[?2004l\r"]
[11263.354437, "o", "\u001b[?2004h> "]
[11263.354534, "o", "        return r.Status\r\n\u001b[?2004l\r"]
[11263.354613, "o", "\u001b[?2004h> "]
[11263.354679, "o", "    default:\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.354757, "o", "> "]
[11263.354848, "o", "        return \"success\"\r\n\u001b[?2004l\r"]
[11263.354912, "o", "\u001b[?2004h> "]
[11263.35499, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11263.355066, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[11263.355132, "o", "\u001b[?2004h> "]
[11263.355659, "o", "func buildRunRecord(executor *Executor, startedAt time.Time, finishedAt time.Time, status string) *RunRecord {\r\n\u001b[?2004l\r"]
[11263.355726, "o", "\u001b[?2004h> "]
[11263.355835, "o", "    mode := \"standard\"\r\n\u001b[?2004l\r"]
[11263.355912, "o", "\u001b[?2004h> "]
[11263.355988, "o", "    var cvFolds *int\r\n\u001b[?2004l\r"]
[11263.356052, "o", "\u001b[?2004h> "]
[11263.356202, "o", "    if executor.cvFolds > 0 {\r\n\u001b[?2004l\r"]
[11263.356274, "o", "\u001b[?2004h> "]
[11263.356365, "o", "        mode = \"cv\"\r\n\u001b[?2004l\r"]
[11263.356435, "o", "\u001b[?2004h> "]
[11263.356574, "o", "        f := executor.cvFolds\r\n\u001b[?2004l\r"]
[11263.356644, "o", "\u001b[?2004h> "]
[11263.35674, "o", "        cvFolds = &f\r\n\u001b[?2004l\r"]
[11263.356805, "o", "\u001b[?2004h>     }"]
[11263.356875, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.356939, "o", "\u001b[?2004h> "]
[11263.357054, "o", "    skipped := []string{}\r\n\u001b[?2004l\r"]
[11263.357122, "o", "\u001b[?2004h> "]
[11263.357403, "o", "    skipped = append(skipped, executor.skipStages...)\r\n\u001b[?2004l\r"]
[11263.35747, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r=\u001b[?2004h"]
[11263.357543, "o", "> "]
[11263.357721, "o", "    summary := map[string]StageSummary{}\r\n\u001b[?2004l\r"]
[11263.357788, "o", "\u001b[?2004h> "]
[11263.358005, "o", "    for name, r := range executor.results {\r\n\u001b[?2004l\r"]
[11263.358051, "o", "\u001b[?2004h> "]
[11263.358176, "o", "        if r == nil {\r\n\u001b[?2004l\r"]
[11263.35825, "o", "\u001b[?2004h> "]
[11263.358347, "o", "            continue\r\n\u001b[?2004l\r"]
[11263.358424, "o", "\u001b[?2004h>         }\r\n"]
[11263.358469, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[11263.358689, "o", "        summary[name] = StageSummary{\r\n\u001b[?2004l\r"]
[11263.358759, "o", "\u001b[?2004h> "]
[11263.358919, "o", "            Status:     r.Status,\r\n\u001b[?2004l\r"]
[11263.358985, "o", "\u001b[?2004h> "]
[11263.359159, "o", "            CacheHit:   r.CacheHit,\r\n\u001b[?2004l\r"]
[11263.359243, "o", "\u001b[?2004h> "]
[11263.359415, "o", "            DurationMs: r.DurationMs,\r\n\u001b[?2004l\r"]
[11263.359479, "o", "\u001b[?2004h> "]
[11263.359555, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.359627, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.359692, "o", "\u001b[?2004h> "]
[11263.359855, "o", "    var cacheStats *CacheStats\r\n\u001b[?2004l\r"]
[11263.35992, "o", "\u001b[?2004h> "]
[11263.360049, "o", "    if !executor.noCache {\r\n\u001b[?2004l\r"]
[11263.360126, "o", "\u001b[?2004h> "]
[11263.360307, "o", "        cacheStats = executor.cacheStats\r\n\u001b[?2004l\r"]
[11263.36037, "o", "\u001b[?2004h> "]
[11263.360529, "o", "        if cacheStats == nil {\r\n\u001b[?2004l\r"]
[11263.360612, "o", "\u001b[?2004h> "]
[11263.360785, "o", "            cacheStats = &CacheStats{}\r\n\u001b[?2004l\r"]
[11263.360851, "o", "\u001b[?2004h> "]
[11263.360928, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.36098, "o", "    }\r\n\u001b[?2004l\r"]
[11263.361073, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.361185, "o", "    return &RunRecord{\r\n\u001b[?2004l\r"]
[11263.361253, "o", "\u001b[?2004h> "]
[11263.361617, "o", "        RunID:         strconv.FormatInt(finishedAt.UnixMilli(), 10),\r\n\u001b[?2004l\r"]
[11263.361667, "o", "\u001b[?2004h> "]
[11263.361935, "o", "        Pipeline:      executor.config.Pipeline.Name,\r\n\u001b[?2004l\r"]
[11263.362012, "o", "\u001b[?2004h> "]
[11263.362265, "o", "        StartedAt:     startedAt.UTC().Format(time.RFC3339),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.362497, "o", "        FinishedAt:    finishedAt.UTC().Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[11263.362546, "o", "\u001b[?2004h> "]
[11263.362766, "o", "        DurationMs:    finishedAt.Sub(startedAt).Milliseconds(),\r\n\u001b[?2004l\r"]
[11263.362831, "o", "\u001b[?2004h> "]
[11263.36291, "o", "        Status:        status,\r\n\u001b[?2004l\r"]
[11263.362982, "o", "\u001b[?2004h> "]
[11263.363055, "o", "        Mode:          mode,\r\n\u001b[?2004l\r"]
[11263.363132, "o", "\u001b[?2004h> "]
[11263.363213, "o", "        CvFolds:       cvFolds,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.363413, "o", "        NoCache:       executor.noCache,\r\n\u001b[?2004l\r"]
[11263.363483, "o", "\u001b[?2004h> "]
[11263.363568, "o", "        SkippedStages: skipped,\r\n\u001b[?2004l\r"]
[11263.363622, "o", "\u001b[?2004h> "]
[11263.363712, "o", "        StageSummary:  summary,\r\n\u001b[?2004l\r"]
[11263.363767, "o", "\u001b[?2004h> "]
[11263.363872, "o", "        CacheStats:    cacheStats,\r\n\u001b[?2004l\r"]
[11263.363926, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\rD"]
[11263.363982, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.364037, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.364163, "o", "func cmdHistory(args []string) {\r\n\u001b[?2004l\r"]
[11263.364242, "o", "\u001b[?2004h> "]
[11263.364315, "o", "    var pipelineFilter string\r\n\u001b[?2004l\r"]
[11263.364397, "o", "\u001b[?2004h> "]
[11263.364467, "o", "    var statusFilter string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.364555, "o", "    limit := -1\r\n\u001b[?2004l\r"]
[11263.364632, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rl\u001b[?2004h> "]
[11263.364761, "o", "    for i := 0; i < len(args); i++ {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.364877, "o", "        arg := args[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.40237, "o", "        switch {\r\n\u001b[?2004l\r\u001b[?2004h>         case arg == \"--pipeline\":\r\n\u001b[?2004l\r\u001b[?2004h>             if i+1 >= len(args) {\r\n\u001b[?2004l\ro\u001b[?2004h>                 printError(\"--pipeline requires a value\")\r\n\u001b[?2004l\r\u001b[?2004h>                 return\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             pipelineFilter = args[i+1]\r\n\u001b[?2004l\r\u001b[?2004h>             i++\r\n\u001b[?2004l\r\u001b[?2004h>         case strings.HasPrefix(arg, \"--pipeline=\"):\r\n\u001b[?2004l\re\u001b[?2004h>             pipelineFilter = strings.TrimPrefix(arg, \"--pipeline=\")\r\n\u001b[?2004l\r\u001b[?2004h>         case arg == \"--status\":\r\n\u001b[?2004l\r\u001b[?2004h>             if i+1 >= len(args) {\r\n\u001b[?2004l\r\u001b[?2004h>                 printError(\"--status requires a value\")\r\n\u001b[?2004l\r\u001b[?2004h>                 return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.402496, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.402754, "o", "            statusFilter = args[i+1]\r\n\u001b[?2004l\r"]
[11263.402793, "o", "\u001b[?2004h> "]
[11263.402931, "o", "            i++\r\n\u001b[?2004l\r"]
[11263.403002, "o", "\u001b[?2004h> "]
[11263.403341, "o", "        case strings.HasPrefix(arg, \"--status=\"):\r\n\u001b[?2004l\r"]
[11263.40342, "o", "\u001b[?2004h> "]
[11263.403833, "o", "            statusFilter = strings.TrimPrefix(arg, \"--status=\")\r\n\u001b[?2004l\r"]
[11263.403901, "o", "\u001b[?2004h> "]
[11263.404108, "o", "        case arg == \"--limit\":\r\n\u001b[?2004l\r"]
[11263.404146, "o", "\u001b[?2004h> "]
[11263.404407, "o", "            if i+1 >= len(args) {\r\n\u001b[?2004l\r"]
[11263.404478, "o", "\u001b[?2004h> "]
[11263.404848, "o", "                printError(\"--limit requires a value\")\r\n\u001b[?2004l\r"]
[11263.404922, "o", "\u001b[?2004h> "]
[11263.405062, "o", "                return\r\n\u001b[?2004l\r"]
[11263.405129, "o", "\u001b[?2004h> "]
[11263.405234, "o", "            }\r\n\u001b[?2004l\r"]
[11263.405311, "o", "\u001b[?2004h> "]
[11263.405594, "o", "            n, err := strconv.Atoi(args[i+1])\r\n\u001b[?2004l\r"]
[11263.405655, "o", "\u001b[?2004h> "]
[11263.405843, "o", "            if err != nil {\r\n\u001b[?2004l\r"]
[11263.405904, "o", "\u001b[?2004h> "]
[11263.406296, "o", "                printError(\"--limit requires an integer\")\r\n\u001b[?2004l\r"]
[11263.406369, "o", "\u001b[?2004h> "]
[11263.406517, "o", "                return\r\n\u001b[?2004l\r"]
[11263.406584, "o", "\u001b[?2004h> "]
[11263.406677, "o", "            }\r\n\u001b[?2004l\r"]
[11263.406725, "o", "\u001b[?2004h> "]
[11263.406884, "o", "            limit = n\r\n\u001b[?2004l\r"]
[11263.406946, "o", "\u001b[?2004h> "]
[11263.407064, "o", "            i++\r\n\u001b[?2004l\r"]
[11263.40713, "o", "\u001b[?2004h> "]
[11263.407467, "o", "        case strings.HasPrefix(arg, \"--limit=\"):\r\n\u001b[?2004l\r"]
[11263.40754, "o", "\u001b[?2004h> "]
[11263.408001, "o", "            n, err := strconv.Atoi(strings.TrimPrefix(arg, \"--limit=\"))\r\n\u001b[?2004l\r"]
[11263.408063, "o", "\u001b[?2004h> "]
[11263.408307, "o", "            if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.408434, "o", "> "]
[11263.408726, "o", "                printError(\"--limit requires an integer\")\r\n\u001b[?2004l\r"]
[11263.408779, "o", "\u001b[?2004h> "]
[11263.408943, "o", "                return\r\n\u001b[?2004l\r"]
[11263.408994, "o", "\u001b[?2004h> "]
[11263.409098, "o", "            }\r\n\u001b[?2004l\r"]
[11263.409148, "o", "\u001b[?2004h> "]
[11263.409317, "o", "            limit = n\r\n\u001b[?2004l\r"]
[11263.409369, "o", "\u001b[?2004h> "]
[11263.409495, "o", "        default:\r\n\u001b[?2004l\r"]
[11263.409547, "o", "\u001b[?2004h> "]
[11263.409965, "o", "            printError(fmt.Sprintf(\"unknown flag: %s\", arg))\r\n\u001b[?2004l\r"]
[11263.410017, "o", "\u001b[?2004h> "]
[11263.410152, "o", "            return\r\n\u001b[?2004l\r"]
[11263.410201, "o", "\u001b[?2004h"]
[11263.410255, "o", "> "]
[11263.410304, "o", "        }\r\n\u001b[?2004l\r"]
[11263.410352, "o", "\u001b[?2004h> "]
[11263.410402, "o", "    }\r\n\u001b[?2004l\r"]
[11263.41045, "o", "\u001b[?2004h> \r\n"]
[11263.410498, "o", "\u001b[?2004l\r\u001b[?2004h"]
[11263.410547, "o", "> "]
[11263.411083, "o", "    if statusFilter != \"\" && statusFilter != \"success\" && statusFilter != \"failed\" {\r\n\u001b[?2004l\r"]
[11263.411135, "o", "\u001b[?2004h> "]
[11263.411524, "o", "        printError(\"--status must be success or failed\")\r\n\u001b[?2004l\r"]
[11263.411576, "o", "\u001b[?2004h> "]
[11263.411693, "o", "        return\r\n\u001b[?2004l\r"]
[11263.411743, "o", "\u001b[?2004h> "]
[11263.411792, "o", "    }\r\n"]
[11263.411839, "o", "\u001b[?2004l\r\u001b[?2004h"]
[11263.41189, "o", "> \r\n\u001b[?2004l\r"]
[11263.411938, "o", "\u001b[?2004h> "]
[11263.412132, "o", "    runs, err := loadHistory()\r\n\u001b[?2004l\r"]
[11263.412181, "o", "\u001b[?2004h> "]
[11263.412332, "o", "    if err != nil {\r\n"]
[11263.412381, "o", "\u001b[?2004l\r\u001b[?2004h"]
[11263.412431, "o", "> "]
[11263.412624, "o", "        printError(err.Error())\r\n\u001b[?2004l\r"]
[11263.412672, "o", "\u001b[?2004h> "]
[11263.412786, "o", "        return\r\n\u001b[?2004l\r"]
[11263.412835, "o", "\u001b[?2004h> "]
[11263.412885, "o", "    }\r\n"]
[11263.412933, "o", "\u001b[?2004l\r\u001b[?2004h"]
[11263.412981, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.413027, "o", "> "]
[11263.413329, "o", "    filtered := make([]HistoryRun, 0, len(runs))\r\n\u001b[?2004l\r"]
[11263.413379, "o", "\u001b[?2004h> "]
[11263.413559, "o", "    for _, r := range runs {\r\n\u001b[?2004l\r"]
[11263.413605, "o", "\u001b[?2004h> "]
[11263.414011, "o", "        if pipelineFilter != \"\" && r.Pipeline != pipelineFilter {\r\n\u001b[?2004l\r"]
[11263.41406, "o", "\u001b[?2004h> "]
[11263.414193, "o", "            continue\r\n\u001b[?2004l\r"]
[11263.414228, "o", "\u001b[?2004h"]
[11263.41429, "o", "> "]
[11263.414324, "o", "        }\r\n\u001b[?2004l\r"]
[11263.414352, "o", "\u001b[?2004h> "]
[11263.414712, "o", "        if statusFilter != \"\" && r.Status != statusFilter {\r\n\u001b[?2004l\r"]
[11263.414756, "o", "\u001b[?2004h> "]
[11263.414887, "o", "            continue\r\n\u001b[?2004l\r"]
[11263.414926, "o", "\u001b[?2004h"]
[11263.414963, "o", "> "]
[11263.415002, "o", "        }\r\n"]
[11263.415047, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[11263.415309, "o", "        filtered = append(filtered, r)\r\n\u001b[?2004l\r"]
[11263.415348, "o", "\u001b[?2004h> "]
[11263.415398, "o", "    }\r\n\u001b[?2004l\r"]
[11263.415436, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.415474, "o", "\u001b[?2004h"]
[11263.415512, "o", "> "]
[11263.415776, "o", "    sort.Slice(filtered, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[11263.415813, "o", "\u001b[?2004h> "]
[11263.416227, "o", "        a, errA := strconv.ParseInt(filtered[i].RunID, 10, 64)\r\n\u001b[?2004l\r"]
[11263.416282, "o", "\u001b[?2004h> "]
[11263.416665, "o", "        b, errB := strconv.ParseInt(filtered[j].RunID, 10, 64)\r\n\u001b[?2004l\r"]
[11263.41671, "o", "\u001b[?2004h> "]
[11263.416965, "o", "        if errA == nil && errB == nil {\r\n\u001b[?2004l\r"]
[11263.417003, "o", "\u001b[?2004h> "]
[11263.417164, "o", "            return a > b\r\n\u001b[?2004l\r"]
[11263.417212, "o", "\u001b[?2004h> "]
[11263.41727, "o", "        }\r\n"]
[11263.417317, "o", "\u001b[?2004l\r\u001b[?2004h"]
[11263.417364, "o", "> "]
[11263.41767, "o", "        return filtered[i].RunID > filtered[j].RunID\r\n\u001b[?2004l\r"]
[11263.417727, "o", "\u001b[?2004h> "]
[11263.417774, "o", "    })\r\n\u001b[?2004l\r"]
[11263.417821, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.417869, "o", "\u001b[?2004h> "]
[11263.41816, "o", "    if limit >= 0 && len(filtered) > limit {\r\n\u001b[?2004l\r"]
[11263.418205, "o", "\u001b[?2004h> "]
[11263.418424, "o", "        filtered = filtered[:limit]\r\n\u001b[?2004l\r"]
[11263.418463, "o", "\u001b[?2004h> "]
[11263.4185, "o", "    }"]
[11263.418538, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.418575, "o", "> \r\n\u001b[?2004l\r"]
[11263.418613, "o", "\u001b[?2004h> "]
[11263.419035, "o", "    printJSON(HistoryOutput{Runs: filtered, Count: len(filtered)})\r\n\u001b[?2004l\r"]
[11263.419073, "o", "\u001b[?2004h> "]
[11263.419111, "o", "}\r\n\u001b[?2004l\r"]
[11263.419149, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.419187, "o", " \u001b[?2004h> "]
[11263.41948, "o", "func loadHistory() ([]HistoryRun, error) {\r\n\u001b[?2004l\r"]
[11263.419522, "o", "\u001b[?2004h> "]
[11263.419809, "o", "    dir := filepath.Join(\".mlpipe\", \"runs\")\r\n\u001b[?2004l\r"]
[11263.419865, "o", "\u001b[?2004h> "]
[11263.420087, "o", "    entries, err := os.ReadDir(dir)\r\n\u001b[?2004l\r"]
[11263.420141, "o", "\u001b[?2004h> "]
[11263.420266, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[11263.420312, "o", "\u001b[?2004h> "]
[11263.420496, "o", "        if os.IsNotExist(err) {\r\n\u001b[?2004l\r"]
[11263.420534, "o", "\u001b[?2004h"]
[11263.42057, "o", "> "]
[11263.420794, "o", "            return []HistoryRun{}, nil\r\n\u001b[?2004l\r"]
[11263.420842, "o", "\u001b[?2004h> "]
[11263.420907, "o", "        }\r\n\u001b[?2004l\r"]
[11263.420955, "o", "\u001b[?2004h> "]
[11263.421105, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[11263.421152, "o", "\u001b[?2004h> "]
[11263.421198, "o", "    }\r\n\u001b[?2004l\r"]
[11263.421252, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.421298, "o", "\u001b[?2004h> "]
[11263.421468, "o", "    runs := []HistoryRun{}\r\n\u001b[?2004l\r"]
[11263.421514, "o", "\u001b[?2004h> "]
[11263.421733, "o", "    for _, entry := range entries {\r\n\u001b[?2004l\r"]
[11263.42178, "o", "\u001b[?2004h> "]
[11263.42195, "o", "        if entry.IsDir() {\r\n\u001b[?2004l\r"]
[11263.421998, "o", "\u001b[?2004h> "]
[11263.422117, "o", "            continue\r\n\u001b[?2004l\r"]
[11263.422164, "o", "\u001b[?2004h> "]
[11263.42224, "o", "        }\r\n\u001b[?2004l\r"]
[11263.422282, "o", "\u001b[?2004h"]
[11263.422327, "o", "> "]
[11263.422473, "o", "        name := entry.Name()\r\n\u001b[?2004l\r"]
[11263.422504, "o", "\u001b[?2004h"]
[11263.422557, "o", "> "]
[11263.42281, "o", "        if !strings.HasSuffix(name, \".json\") {\r\n\u001b[?2004l\r"]
[11263.422857, "o", "\u001b[?2004h> "]
[11263.422989, "o", "            continue\r\n\u001b[?2004l\r"]
[11263.423035, "o", "\u001b[?2004h> "]
[11263.423106, "o", "        }\r\n\u001b[?2004l\r"]
[11263.423153, "o", "\u001b[?2004h> "]
[11263.423411, "o", "        path := filepath.Join(dir, name)\r\n\u001b[?2004l\r"]
[11263.423461, "o", "\u001b[?2004h> "]
[11263.423606, "o", "        data, err := os.ReadFile(path)\r\n\u001b[?2004l\r"]
[11263.423653, "o", "\u001b[?2004h> "]
[11263.423744, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11263.423791, "o", "\u001b[?2004h> "]
[11263.423893, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[11263.42392, "o", "\u001b[?2004h> "]
[11263.423992, "o", "        }\r\n\u001b[?2004l\r"]
[11263.424039, "o", "\u001b[?2004h> "]
[11263.424118, "o", "        var r RunRecord\r\n\u001b[?2004l\r"]
[11263.424164, "o", "\u001b[?2004h> "]
[11263.424412, "o", "        if err := json.Unmarshal(data, &r); err != nil {\r\n\u001b[?2004l\r"]
[11263.424461, "o", "\u001b[?2004h> "]
[11263.424556, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[11263.424605, "o", "\u001b[?2004h> "]
[11263.424651, "o", "        }\r\n\u001b[?2004l\r"]
[11263.424677, "o", "\u001b[?2004h> "]
[11263.424853, "o", "        runs = append(runs, HistoryRun{\r\n\u001b[?2004l\r"]
[11263.424902, "o", "\u001b[?2004h> "]
[11263.425039, "o", "            RunID:      r.RunID,\r\n\u001b[?2004l\r"]
[11263.425068, "o", "\u001b[?2004h> "]
[11263.425232, "o", "            Pipeline:   r.Pipeline,\r\n\u001b[?2004l\r"]
[11263.425256, "o", "\u001b[?2004h> "]
[11263.425414, "o", "            Status:     r.Status,\r\n\u001b[?2004l\r"]
[11263.425453, "o", "\u001b[?2004h> "]
[11263.425607, "o", "            StartedAt:  r.StartedAt,\r\n\u001b[?2004l\r"]
[11263.425644, "o", "\u001b[?2004h> "]
[11263.425814, "o", "            DurationMs: r.DurationMs,\r\n\u001b[?2004l\r"]
[11263.425851, "o", "\u001b[?2004h> "]
[11263.425983, "o", "            Mode:       r.Mode,\r\n\u001b[?2004l\r"]
[11263.426023, "o", "\u001b[?2004h> "]
[11263.42608, "o", "        })\r\n\u001b[?2004l\r"]
[11263.426118, "o", "\u001b[?2004h> "]
[11263.426155, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.426193, "o", "> "]
[11263.426274, "o", "    return runs, nil\r\n\u001b[?2004l\r"]
[11263.426311, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11263.42635, "o", "\u001b[?2004h> "]
[11263.426388, "o", "''')\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.426427, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h"]
[11263.426464, "o", "> "]
[11263.426625, "o", "Path(\"diff.go\").write_text('''package main\r\n\u001b[?2004l\r"]
[11263.426665, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rf\u001b[?2004h"]
[11263.426704, "o", "> "]
[11263.426741, "o", "import (\r\n\u001b[?2004l\r"]
[11263.426779, "o", "\u001b[?2004h> "]
[11263.426831, "o", "    \"reflect\"\r\n\u001b[?2004l\r"]
[11263.426869, "o", "\u001b[?2004h> "]
[11263.426908, "o", "    \"sort\"\r\n\u001b[?2004l\r"]
[11263.426945, "o", "\u001b[?2004h> "]
[11263.426983, "o", ")\r\n\u001b[?2004l\r \u001b[?2004h"]
[11263.42702, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h"]
[11263.427056, "o", "> "]
[11263.42715, "o", "type StageDiff struct {\r\n\u001b[?2004l\r"]
[11263.427188, "o", "\u001b[?2004h> "]
[11263.427484, "o", "    TypeChanged    *FieldDiff           `json:\"type_changed,omitempty\"`\r\n\u001b[?2004l\r"]
[11263.427522, "o", "\u001b[?2004h> "]
[11263.427829, "o", "    ParamsChanged  map[string]FieldDiff `json:\"params_changed,omitempty\"`\r\n\u001b[?2004l\r"]
[11263.427867, "o", "\u001b[?2004h> "]
[11263.428171, "o", "    DepsChanged    *ListDiff            `json:\"deps_changed,omitempty\"`\r\n\u001b[?2004l\r"]
[11263.428209, "o", "\u001b[?2004h> "]
[11263.428534, "o", "    InputsChanged  map[string]FieldDiff `json:\"inputs_changed,omitempty\"`\r\n\u001b[?2004l\r"]
[11263.428572, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11263.42861, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.428649, "o", "\u001b[?2004h> "]
[11263.428755, "o", "type FieldDiff struct {\r\n\u001b[?2004l\r"]
[11263.428791, "o", "\u001b[?2004h> "]
[11263.428929, "o", "    Old interface{} `json:\"old\"`\r\n\u001b[?2004l\r"]
[11263.428967, "o", "\u001b[?2004h> "]
[11263.429119, "o", "    New interface{} `json:\"new\"`\r\n\u001b[?2004l\r"]
[11263.429156, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11263.429195, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.429238, "o", "\u001b[?2004h> "]
[11263.429352, "o", "type ListDiff struct {\r\n\u001b[?2004l\r"]
[11263.429392, "o", "\u001b[?2004h> "]
[11263.429518, "o", "    Old []string `json:\"old\"`\r\n\u001b[?2004l\r"]
[11263.429555, "o", "\u001b[?2004h> "]
[11263.429674, "o", "    New []string `json:\"new\"`\r\n\u001b[?2004l\r"]
[11263.42971, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11263.429748, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.429785, "o", "\u001b[?2004h> "]
[11263.429896, "o", "type ConfigDiff struct {\r\n\u001b[?2004l\r"]
[11263.429934, "o", "\u001b[?2004h> "]
[11263.430266, "o", "    PipelineName     *FieldDiff          `json:\"pipeline_name,omitempty\"`\r\n\u001b[?2004l\r"]
[11263.43031, "o", "\u001b[?2004h> "]
[11263.430575, "o", "    StagesAdded      []string            `json:\"stages_added\"`\r\n\u001b[?2004l\r"]
[11263.430613, "o", "\u001b[?2004h> "]
[11263.430893, "o", "    StagesRemoved    []string            `json:\"stages_removed\"`\r\n\u001b[?2004l\r"]
[11263.430931, "o", "\u001b[?2004h> "]
[11263.431196, "o", "    StagesModified   map[string]StageDiff `json:\"stages_modified\"`\r\n\u001b[?2004l\r"]
[11263.431241, "o", "\u001b[?2004h> "]
[11263.431533, "o", "    StagesUnchanged  []string            `json:\"stages_unchanged\"`\r\n\u001b[?2004l\r"]
[11263.431571, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11263.43161, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rk"]
[11263.431647, "o", "\u001b[?2004h> "]
[11263.431771, "o", "func cmdDiff(args []string) {\r\n\u001b[?2004l\r"]
[11263.431808, "o", "\u001b[?2004h> "]
[11263.431911, "o", "    if len(args) != 2 {\r\n\u001b[?2004l\r"]
[11263.431947, "o", "\u001b[?2004h> "]
[11263.432259, "o", "        printError(\"usage: mlpipe diff <config1.json> <config2.json>\")\r\n\u001b[?2004l\r"]
[11263.432298, "o", "\u001b[?2004h> "]
[11263.432359, "o", "        return\r\n\u001b[?2004l\r"]
[11263.432395, "o", "\u001b[?2004h> "]
[11263.432433, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.432471, "o", "> "]
[11263.432625, "o", "    config1, err := loadConfig(args[0])\r\n\u001b[?2004l\r"]
[11263.432663, "o", "\u001b[?2004h> "]
[11263.432748, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[11263.432785, "o", "\u001b[?2004h> "]
[11263.43292, "o", "        printError(err.Error())\r\n\u001b[?2004l\r"]
[11263.432958, "o", "\u001b[?2004h> "]
[11263.433017, "o", "        return\r\n\u001b[?2004l\r"]
[11263.433056, "o", "\u001b[?2004h> "]
[11263.433092, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.433129, "o", "> "]
[11263.433289, "o", "    config2, err := loadConfig(args[1])\r\n\u001b[?2004l\r"]
[11263.433327, "o", "\u001b[?2004h> "]
[11263.433413, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[11263.433452, "o", "\u001b[?2004h> "]
[11263.433604, "o", "        printError(err.Error())\r\n\u001b[?2004l\r"]
[11263.433642, "o", "\u001b[?2004h> "]
[11263.433701, "o", "        return\r\n\u001b[?2004l\r"]
[11263.43374, "o", "\u001b[?2004h> "]
[11263.433778, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.433988, "o", "    printJSON(diffConfigs(config1, config2))\r\n\u001b[?2004l\r"]
[11263.434025, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11263.434063, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.434102, "o", "\u001b[?2004h> "]
[11263.43431, "o", "func diffConfigs(c1, c2 *Config) ConfigDiff {\r\n\u001b[?2004l\r"]
[11263.434348, "o", "\u001b[?2004h> "]
[11263.434463, "o", "    result := ConfigDiff{\r\n\u001b[?2004l\r"]
[11263.434502, "o", "\u001b[?2004h> "]
[11263.434611, "o", "        StagesAdded:     []string{},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.434734, "o", "        StagesRemoved:   []string{},\r\n\u001b[?2004l\r"]
[11263.434778, "o", "\u001b[?2004h> "]
[11263.434891, "o", "        StagesModified:  map[string]StageDiff{},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.435019, "o", "        StagesUnchanged: []string{},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.435058, "o", "    }\r\n\u001b[?2004l\r "]
[11263.435097, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.435232, "o", "    if c1.Pipeline.Name != c2.Pipeline.Name {\r\n\u001b[?2004l\r"]
[11263.435278, "o", "\u001b[?2004h> "]
[11263.435484, "o", "        result.PipelineName = &FieldDiff{Old: c1.Pipeline.Name, New: c2.Pipeline.Name}\r\n\u001b[?2004l\r"]
[11263.435529, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[11263.435574, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ru\u001b[?2004h> "]
[11263.435678, "o", "    stages1 := map[string]StageConfig{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.435771, "o", "    for _, s := range c1.Stages {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.435852, "o", "        stages1[s.Name] = s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.435897, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.435993, "o", "    stages2 := map[string]StageConfig{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.436085, "o", "    for _, s := range c2.Stages {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.436165, "o", "        stages2[s.Name] = s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.43621, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.436257, "o", "\u001b[?2004h> "]
[11263.436318, "o", "    allNames := map[string]bool{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.436408, "o", "    for name := range stages1 {\r\n\u001b[?2004l\r"]
[11263.436454, "o", "\u001b[?2004h> "]
[11263.436498, "o", "        allNames[name] = true\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.436537, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.436618, "o", "    for name := range stages2 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.436703, "o", "        allNames[name] = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.436748, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.436792, "o", "\u001b[?2004h> "]
[11263.43688, "o", "    names := make([]string, 0, len(allNames))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.436969, "o", "    for name := range allNames {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.437066, "o", "        names = append(names, name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.43711, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.437175, "o", "    sort.Strings(names)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.437213, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.437306, "o", "    for _, name := range names {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.437394, "o", "        s1, ok1 := stages1[name]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.437485, "o", "        s2, ok2 := stages2[name]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.437546, "o", "        if !ok1 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.437703, "o", "            result.StagesAdded = append(result.StagesAdded, name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.437768, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.437806, "o", "        }\r\n\u001b[?2004l\r"]
[11263.437852, "o", "\u001b[?2004h> "]
[11263.437896, "o", "        if !ok2 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.438036, "o", "            result.StagesRemoved = append(result.StagesRemoved, name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.438102, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.438147, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.438246, "o", "        diff := diffStages(s1, s2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.43832, "o", "        if diff == nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.438492, "o", "            result.StagesUnchanged = append(result.StagesUnchanged, name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.438552, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.43867, "o", "            result.StagesModified[name] = *diff\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.438715, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.43876, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.438804, "o", "\u001b[?2004h> "]
[11263.438846, "o", "    return result\r\n\u001b[?2004l\r\u001b[?2004h> }"]
[11263.438892, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.439009, "o", "func diffStages(s1, s2 StageConfig) *StageDiff {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.43908, "o", "    diff := StageDiff{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.439199, "o", "        ParamsChanged: map[string]FieldDiff{},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.439321, "o", "        InputsChanged: map[string]FieldDiff{},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.439365, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.439424, "o", "    changed := false\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.439468, "o", "\u001b[?2004h> "]
[11263.439514, "o", "    if s1.Type != s2.Type {\r\n\u001b[?2004l\r"]
[11263.439553, "o", "\u001b[?2004h> "]
[11263.439681, "o", "        diff.TypeChanged = &FieldDiff{Old: s1.Type, New: s2.Type}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.439751, "o", "        changed = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.439795, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.43984, "o", "\u001b[?2004h> "]
[11263.439942, "o", "    if !sameStringList(s1.DependsOn, s2.DependsOn) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.440118, "o", "        diff.DepsChanged = &ListDiff{Old: s1.DependsOn, New: s2.DependsOn}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.440187, "o", "        changed = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.440237, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.440282, "o", "\u001b[?2004h> "]
[11263.440355, "o", "    if !sameMap(s1.Params, s2.Params) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.440399, "o", "> "]
[11263.440443, "o", "        allKeys := map[string]bool{}\r\n\u001b[?2004l\r"]
[11263.440488, "o", "\u001b[?2004h> "]
[11263.440549, "o", "        for k := range s1.Params {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.440633, "o", "            allKeys[k] = true\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.440671, "o", ">         }\r\n\u001b[?2004l\r"]
[11263.440716, "o", "\u001b[?2004h> "]
[11263.440761, "o", "        for k := range s2.Params {\r\n\u001b[?2004l\r"]
[11263.440806, "o", "\u001b[?2004h> "]
[11263.44085, "o", "            allKeys[k] = true\r\n\u001b[?2004l\r"]
[11263.440895, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[11263.440939, "o", "\u001b[?2004h> "]
[11263.441023, "o", "        keys := make([]string, 0, len(allKeys))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.441113, "o", "        for k := range allKeys {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.441207, "o", "            keys = append(keys, k)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.441261, "o", ">         }\r\n\u001b[?2004l\r"]
[11263.4413, "o", "\u001b[?2004h> "]
[11263.441345, "o", "        sort.Strings(keys)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.441424, "o", "        for _, k := range keys {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.441521, "o", "            v1, ok1 := s1.Params[k]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.441617, "o", "            v2, ok2 := s2.Params[k]\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.441655, "o", "> "]
[11263.441694, "o", "            if ok1 && ok2 {\r\n\u001b[?2004l\r"]
[11263.441732, "o", "\u001b[?2004h> "]
[11263.44182, "o", "                if !reflect.DeepEqual(v1, v2) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.441987, "o", "                    diff.ParamsChanged[k] = FieldDiff{Old: v1, New: v2}\r\n\u001b[?2004l\r"]
[11263.442032, "o", "\u001b[?2004h> "]
[11263.442073, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.442144, "o", "            } else if ok1 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.442313, "o", "                diff.ParamsChanged[k] = FieldDiff{Old: v1, New: nil}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.442379, "o", "            } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.442541, "o", "                diff.ParamsChanged[k] = FieldDiff{Old: nil, New: v2}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.442579, "o", "            }\r\n\u001b[?2004l\r"]
[11263.442618, "o", "\u001b[?2004h> "]
[11263.442656, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.442744, "o", "        if len(diff.ParamsChanged) > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.442821, "o", "            changed = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.44288, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.442978, "o", "            diff.ParamsChanged = nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.443023, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.443068, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11263.443107, "o", "\u001b[?2004h> "]
[11263.443187, "o", "    if !sameMap(s1.Inputs, s2.Inputs) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.44323, "o", "> "]
[11263.443291, "o", "        allKeys := map[string]bool{}\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.44333, "o", "> "]
[11263.443387, "o", "        for k := range s1.Inputs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.443472, "o", "            allKeys[k] = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.44351, "o", "        }\r\n\u001b[?2004l\r"]
[11263.443548, "o", "\u001b[?2004h> "]
[11263.443611, "o", "        for k := range s2.Inputs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.443695, "o", "            allKeys[k] = true\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.443735, "o", ">         }\r\n\u001b[?2004l\r"]
[11263.443773, "o", "\u001b[?2004h> "]
[11263.443864, "o", "        keys := make([]string, 0, len(allKeys))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.443954, "o", "        for k := range allKeys {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11263.443998, "o", "> "]
[11263.444036, "o", "            keys = append(keys, k)\r\n\u001b[?2004l\r"]
[11263.444077, "o", "\u001b[?2004h> "]
[11263.444115, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11263.444172, "o", "        sort.Strings(keys)\r\n\u001b[?2004l\r"]
[11263.444211, "o", "\u001b[?2004h> "]
[11263.444257, "o", "        for _, k := range keys {\r\n\u001b[?2004l\r"]
[11263.444296, "o", "\u001b[?2004h> "]
[11263.444365, "o", "            v1, ok1 := s1.Inputs[k]\r\n\u001b[?2004l\r\u001b[?2004h> "]
