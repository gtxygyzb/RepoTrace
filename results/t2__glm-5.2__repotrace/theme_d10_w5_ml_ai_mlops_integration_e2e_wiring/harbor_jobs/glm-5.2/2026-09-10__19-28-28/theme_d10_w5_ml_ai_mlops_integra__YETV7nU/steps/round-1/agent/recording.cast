[4863.776958, "o", "func cmdRun(args []string) {\r\n\u001b[?2004l\r"]
[4863.777016, "o", "\u001b[?2004h> "]
[4863.77747, "o", "    configPath, overrides, cv, noCache, err := parseRunArgs(args)\r\n\u001b[?2004l\r"]
[4863.777541, "o", "\u001b[?2004h> "]
[4863.777666, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[4863.777737, "o", "\u001b[?2004h> "]
[4863.777953, "o", "        printError(err.Error())\r\n\u001b[?2004l\r"]
[4863.77801, "o", "\u001b[?2004h> "]
[4863.778117, "o", "        return\r\n\u001b[?2004l\r"]
[4863.778173, "o", "\u001b[?2004h> "]
[4863.778233, "o", "    }\r\n\u001b[?2004l\r"]
[4863.778294, "o", "\u001b[?2004h> "]
[4863.778569, "o", "    config, err := loadConfig(configPath)\r\n\u001b[?2004l\r"]
[4863.778621, "o", "\u001b[?2004h> "]
[4863.778768, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[4863.778821, "o", "\u001b[?2004h> "]
[4863.779046, "o", "        printError(err.Error())\r\n\u001b[?2004l\r"]
[4863.7791, "o", "\u001b[?2004h> "]
[4863.77921, "o", "        return\r\n\u001b[?2004l\r"]
[4863.779269, "o", "\u001b[?2004h> "]
[4863.779325, "o", "    }\r\n\u001b[?2004l\r"]
[4863.779378, "o", "\u001b[?2004h> "]
[4863.779696, "o", "    executor := NewExecutor(config, overrides)\r\n\u001b[?2004l\r"]
[4863.779743, "o", "\u001b[?2004h> "]
[4863.779969, "o", "    executor.noCache = noCache\r\n\u001b[?2004l\r"]
[4863.780026, "o", "\u001b[?2004h> "]
[4863.780206, "o", "    executor.cvFolds = cv\r\n\u001b[?2004l\r"]
[4863.780274, "o", "\u001b[?2004h> "]
[4863.780433, "o", "    var run interface{}\r\n\u001b[?2004l\r"]
[4863.780493, "o", "\u001b[?2004h> "]
[4863.780612, "o", "    if cv > 0 {\r\n\u001b[?2004l\r"]
[4863.780676, "o", "\u001b[?2004h> "]
[4863.780922, "o", "        run, err = executor.RunCV()\r\n\u001b[?2004l\r"]
[4863.780979, "o", "\u001b[?2004h> "]
[4863.781071, "o", "    } else {\r\n\u001b[?2004l\r"]
[4863.781127, "o", "\u001b[?2004h> "]
[4863.78137, "o", "        run, err = executor.Run()\r\n\u001b[?2004l\r"]
[4863.781438, "o", "\u001b[?2004h> "]
[4863.781494, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4863.78155, "o", "> "]
[4863.78166, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[4863.781723, "o", "\u001b[?2004h> "]
[4863.781943, "o", "        printError(err.Error())\r\n\u001b[?2004l\r"]
[4863.78199, "o", "\u001b[?2004h> "]
[4863.782108, "o", "        return\r\n\u001b[?2004l\r"]
[4863.782172, "o", "\u001b[?2004h> "]
[4863.782248, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4863.782303, "o", "> "]
[4863.782411, "o", "    printJSON(run)\r\n\u001b[?2004l\r"]
[4863.782499, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4863.782579, "o", "\u001b[?2004h"]
[4863.782662, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
