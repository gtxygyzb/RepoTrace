[483.661083, "o", "ds.Rows[i] = append(row, \"\")\r\n}\r\n}\r\nreturn\r\n}\r\nif idx < len(ds.Types) {\r\nds.Types[idx] = typ\r\n"]
[483.661191, "o", "}\r\nfor i, row := range ds.Rows {\r\nif i < len(values) && idx < len(row) {\r\nrow[idx] = values[i]\r\n} else if i < len(values) {\r\nfor len(row) <= idx {\r\nrow = append(row, \"\")\r\n}\r\nrow[idx] = values[i]\r\n"]
