[5326.228828, "o", "\u001b[?2004h> "]
[5326.228895, "o", "    start := time.Now()\r\n\u001b[?2004l\r"]
[5326.228951, "o", "\u001b[?2004h> "]
[5326.229113, "o", "    if !e.noCache && cacheEntryExists(cacheKey) {\r\n\u001b[?2004l\r"]
[5326.229172, "o", "\u001b[?2004h> "]
[5326.229342, "o", "        loaded, loadErr := loadCacheEntry(cacheKey)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.229369, "o", "> "]
[5326.229481, "o", "        if loadErr == nil {\r\n\u001b[?2004l\r"]
[5326.229536, "o", "\u001b[?2004h> "]
[5326.229612, "o", "            out = loaded\r\n\u001b[?2004l\r"]
[5326.229667, "o", "\u001b[?2004h> "]
[5326.229806, "o", "            e.results[name].CacheHit = true\r\n\u001b[?2004l\r"]
[5326.229861, "o", "\u001b[?2004h> "]
[5326.229968, "o", "            e.cacheStats.Hits++\r\n\u001b[?2004l\r"]
[5326.230023, "o", "\u001b[?2004h> "]
[5326.230279, "o", "            e.results[name].DurationMs = time.Since(start).Milliseconds()\r\n\u001b[?2004l\r"]
[5326.230334, "o", "\u001b[?2004h> "]
[5326.230389, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.230455, "o", "> "]
[5326.23053, "o", "            if !e.noCache {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.230584, "o", "> "]
[5326.230706, "o", "                e.cacheStats.Misses++\r\n\u001b[?2004l\r"]
[5326.230761, "o", "\u001b[?2004h> "]
[5326.230815, "o", "            }\r\n\u001b[?2004l\r)\u001b[?2004h> "]
[5326.231164, "o", "            out, err = e.executeStageForFold(stage, params, inputValues, fold, k)\r\n\u001b[?2004l\r"]
[5326.231225, "o", "\u001b[?2004h> "]
[5326.231495, "o", "            e.results[name].DurationMs = time.Since(start).Milliseconds()\r\n\u001b[?2004l\r"]
[5326.23155, "o", "\u001b[?2004h> "]
[5326.231629, "o", "            if err != nil {\r\n\u001b[?2004l\r"]
[5326.231687, "o", "\u001b[?2004h> "]
[5326.231838, "o", "                e.status[name] = \"failed\"\r\n\u001b[?2004l\r"]
[5326.231893, "o", "\u001b[?2004h> "]
[5326.232066, "o", "                e.results[name].Status = \"failed\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.232156, "o", "> "]
[5326.232299, "o", "                e.results[name].Error = err.Error()\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.232362, "o", "> "]
[5326.232431, "o", "                return false\r\n\u001b[?2004l\r"]
[5326.232485, "o", "\u001b[?2004h> "]
[5326.232546, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.232655, "o", "            if !e.noCache {\r\n\u001b[?2004l\r"]
[5326.23271, "o", "\u001b[?2004h> "]
[5326.232955, "o", "                _ = saveCacheEntry(cacheKey, name, stage.Type, out)\r\n\u001b[?2004l\r"]
[5326.233009, "o", "\u001b[?2004h> "]
[5326.233068, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.233126, "o", ">         }\r\n\u001b[?2004l\r"]
[5326.233192, "o", "\u001b[?2004h> "]
[5326.233234, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.23354, "o", "        out, err = e.executeStageForFold(stage, params, inputValues, fold, k)\r\n\u001b[?2004l\r"]
[5326.233604, "o", "\u001b[?2004h> "]
[5326.23383, "o", "        e.results[name].DurationMs = time.Since(start).Milliseconds()\r\n\u001b[?2004l\r"]
[5326.233885, "o", "\u001b[?2004h> "]
[5326.233952, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.234007, "o", "> "]
[5326.23413, "o", "            e.status[name] = \"failed\"\r\n\u001b[?2004l\r"]
[5326.234185, "o", "\u001b[?2004h> "]
[5326.234351, "o", "            e.results[name].Status = \"failed\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.234407, "o", "> "]
[5326.234556, "o", "            e.results[name].Error = err.Error()\r\n\u001b[?2004l\r"]
[5326.234611, "o", "\u001b[?2004h> "]
[5326.234686, "o", "            return false\r\n\u001b[?2004l\r"]
[5326.234741, "o", "\u001b[?2004h>         }"]
[5326.234797, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.234874, "o", "        if !e.noCache {\r\n\u001b[?2004l\r"]
[5326.234928, "o", "\u001b[?2004h> "]
[5326.235142, "o", "            _ = saveCacheEntry(cacheKey, name, stage.Type, out)\r\n\u001b[?2004l\r"]
[5326.235197, "o", "\u001b[?2004h> "]
[5326.235319, "o", "            e.cacheStats.Misses++\r\n\u001b[?2004l\r"]
[5326.235374, "o", "\u001b[?2004h> "]
[5326.235428, "o", "        }\r\n\u001b[?2004l\rg\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5326.235485, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.23554, "o", "> "]
[5326.235653, "o", "    e.status[name] = \"success\"\r\n\u001b[?2004l\r"]
[5326.235707, "o", "\u001b[?2004h> "]
[5326.235837, "o", "    e.results[name].Status = \"success\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.235891, "o", "> "]
[5326.235978, "o", "    ts := time.Now().UnixNano()\r\n\u001b[?2004l\r"]
[5326.236033, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.236088, "o", "> "]
[5326.236183, "o", "    for port, val := range out {\r\n\u001b[?2004l\r"]
[5326.236269, "o", "\u001b[?2004h> "]
[5326.236339, "o", "        var id string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.23642, "o", "        if fold >= 0 {\r\n\u001b[?2004l\r"]
[5326.236475, "o", "\u001b[?2004h> "]
[5326.236749, "o", "            id = artifactIDFold(e.config.Pipeline.Name, name, port, ts, fold)\r\n\u001b[?2004l\r"]
[5326.236803, "o", "\u001b[?2004h> "]
[5326.236861, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.236921, "o", "> "]
[5326.237139, "o", "            id = artifactID(e.config.Pipeline.Name, name, port, ts)\r\n\u001b[?2004l\r"]
[5326.237193, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[5326.237257, "o", "\u001b[?2004h> "]
[5326.237368, "o", "        e.values[name][port] = val\r\n\u001b[?2004l\r"]
[5326.237423, "o", "\u001b[?2004h> "]
[5326.23754, "o", "        e.outputs[name][port] = id\r\n\u001b[?2004l\r"]
[5326.237594, "o", "\u001b[?2004h> "]
[5326.237674, "o", "        typ := val.Type()\r\n\u001b[?2004l\r"]
[5326.237729, "o", "\u001b[?2004h> "]
[5326.237845, "o", "        summary := val.Summary()\r\n\u001b[?2004l\r"]
[5326.237899, "o", "\u001b[?2004h> "]
[5326.237996, "o", "        meta := &ArtifactMeta{\r\n\u001b[?2004l\r"]
[5326.23805, "o", "\u001b[?2004h> "]
[5326.238128, "o", "            ID:        id,\r\n\u001b[?2004l\r"]
[5326.238183, "o", "\u001b[?2004h> "]
[5326.23828, "o", "            Stage:     name,\r\n\u001b[?2004l\r"]
[5326.238337, "o", "\u001b[?2004h> "]
[5326.23841, "o", "            Port:      port,\r\n\u001b[?2004l\r"]
[5326.238465, "o", "\u001b[?2004h> "]
[5326.238551, "o", "            Type:      typ,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.238653, "o", "            Summary:   summary,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.238763, "o", "            Inputs:    inputIDs,\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.238789, "o", "> "]
[5326.238877, "o", "            Outputs:   []string{},\r\n\u001b[?2004l\r"]
[5326.238897, "o", "\u001b[?2004h> "]
[5326.238972, "o", "            Timestamp: ts,\r\n\u001b[?2004l\rda\u001b[?2004h> "]
[5326.23902, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.30235, "o", "        e.meta[id] = meta\r\n\u001b[?2004l\r\u001b[?2004h>         for _, inID := range inputIDs {\r\n\u001b[?2004l\r\u001b[?2004h>             if parent, ok := e.meta[inID]; ok {\r\n\u001b[?2004l\r\u001b[?2004h>                 parent.Outputs = appendUnique(parent.Outputs, id)\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         runArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return true\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func (e *Executor) executeStageForFold(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue, fold, k int) (map[string]*ArtifactValue, error) {\r\n\u001b[?2004l\r\u001b[?2004h>     if stage.Type == \"split\" && fold >= 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         return executeSplitFold(stage, params, inputs, fold, k)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if stage.Type == \"register\" && fold >= 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         execParams := copyParams(params)\r\n\u001b"]
[5326.302619, "o", "[?2004l\r\u001b[?2004h>         if modelName, ok := getString(execParams, \"model_name\"); ok {\r\n\u001b[?2004l\r\u001b[?2004h>             execParams[\"model_name\"] = fmt.Sprintf(\"%s-fold%d\", modelName, fold)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         return executeRegister(stage, execParams, inputs)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return executeStage(stage, params, inputs)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[5326.303198, "o", "func executeSplitFold(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue, fold, k int) (map[string]*ArtifactValue, error) {\r\n\u001b[?2004l\r"]
[5326.303282, "o", "\u001b[?2004h> "]
[5326.303504, "o", "    ds := inputDataset(inputs)\r\n\u001b[?2004l\r"]
[5326.303551, "o", "\u001b[?2004h> "]
[5326.303698, "o", "    if ds == nil {\r\n\u001b[?2004l\r"]
[5326.303756, "o", "\u001b[?2004h> "]
[5326.304297, "o", "        return nil, fmt.Errorf(\"split stage %q requires input data\", stage.Name)\r\n\u001b[?2004l\r"]
[5326.304357, "o", "\u001b[?2004h> "]
[5326.304408, "o", "    }\r\n\u001b[?2004l\r"]
[5326.304455, "o", "\u001b[?2004h> "]
[5326.30473, "o", "    seed, ok := getInt(params, \"seed\")\r\n\u001b[?2004l\r"]
[5326.304787, "o", "\u001b[?2004h> "]
[5326.304878, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[5326.304938, "o", "\u001b[?2004h> "]
[5326.305058, "o", "        seed = 0\r\n\u001b[?2004l\r"]
[5326.305104, "o", "\u001b[?2004h"]
[5326.305161, "o", ">     }\r\n\u001b[?2004l\r"]
[5326.305234, "o", "\u001b[?2004h> "]
[5326.305563, "o", "    stratify, _ := getString(params, \"stratify\")\r\n\u001b[?2004l\r"]
[5326.30562, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5326.305683, "o", "\u001b[?2004h> "]
[5326.305851, "o", "    trainRows := []int{}\r\n\u001b[?2004l\r"]
[5326.305914, "o", "\u001b[?2004h> "]
[5326.306076, "o", "    testRows := []int{}\r\n\u001b[?2004l\r"]
[5326.306136, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5326.306204, "o", "\u001b[?2004h> "]
[5326.306379, "o", "    if stratify == \"\" {\r\n\u001b[?2004l\r"]
[5326.306446, "o", "\u001b[?2004h> "]
[5326.306795, "o", "        rng := rand.New(rand.NewSource(int64(seed)))\r\n\u001b[?2004l\r"]
[5326.306851, "o", "\u001b[?2004h> "]
[5326.307118, "o", "        perm := rng.Perm(len(ds.Rows))\r\n\u001b[?2004l\r"]
[5326.307175, "o", "\u001b[?2004h> "]
[5326.307434, "o", "        for pos, idx := range perm {\r\n\u001b[?2004l\r"]
[5326.307494, "o", "\u001b[?2004h> "]
[5326.30771, "o", "            if pos%k == fold {\r\n\u001b[?2004l\r"]
[5326.307764, "o", "\u001b[?2004h> "]
[5326.308092, "o", "                testRows = append(testRows, idx)\r\n\u001b[?2004l\r"]
[5326.308147, "o", "\u001b[?2004h> "]
[5326.308303, "o", "            } else {\r\n\u001b[?2004l\r"]
[5326.308375, "o", "\u001b[?2004h> "]
[5326.308715, "o", "                trainRows = append(trainRows, idx)\r\n\u001b[?2004l\r"]
[5326.308773, "o", "\u001b[?2004h> "]
[5326.308877, "o", "            }\r\n\u001b[?2004l\r"]
[5326.308933, "o", "\u001b[?2004h> "]
[5326.309014, "o", "        }\r\n\u001b[?2004l\r"]
[5326.309069, "o", "\u001b[?2004h> "]
[5326.309165, "o", "    } else {\r\n\u001b[?2004l\r"]
[5326.309233, "o", "\u001b[?2004h> "]
[5326.309525, "o", "        idx, ok := ds.ColumnIndex(stratify)\r\n\u001b[?2004l\r"]
[5326.309592, "o", "\u001b[?2004h> "]
[5326.309708, "o", "        if !ok {\r\n\u001b[?2004l\r"]
[5326.309762, "o", "\u001b[?2004h> "]
[5326.310292, "o", "            return nil, fmt.Errorf(\"stratify column not found: %s\", stratify)\r\n\u001b[?2004l\r"]
[5326.310349, "o", "\u001b[?2004h> "]
[5326.310421, "o", "        }\r\n\u001b[?2004l\r"]
[5326.310477, "o", "\u001b[?2004h> "]
[5326.310731, "o", "        classes := map[string][]int{}\r\n\u001b[?2004l\r"]
[5326.310786, "o", "\u001b[?2004h> "]
[5326.311045, "o", "        for i, row := range ds.Rows {\r\n\u001b[?2004l\r"]
[5326.3111, "o", "\u001b[?2004h> "]
[5326.311259, "o", "            val := \"\"\r\n\u001b[?2004l\r"]
[5326.311329, "o", "\u001b[?2004h> "]
[5326.311542, "o", "            if idx < len(row) {\r\n\u001b[?2004l\r"]
[5326.311599, "o", "\u001b[?2004h> "]
[5326.311809, "o", "                val = row[idx]\r\n\u001b[?2004l\r"]
[5326.311869, "o", "\u001b[?2004h> "]
[5326.311966, "o", "            }\r\n\u001b[?2004l\r"]
[5326.31203, "o", "\u001b[?2004h> "]
[5326.312379, "o", "            classes[val] = append(classes[val], i)\r\n\u001b[?2004l\r"]
[5326.312442, "o", "\u001b[?2004h> "]
[5326.312507, "o", "        }\r\n\u001b[?2004l\r"]
[5326.31257, "o", "\u001b[?2004h> "]
[5326.312929, "o", "        classNames := make([]string, 0, len(classes))\r\n\u001b[?2004l\r"]
[5326.312984, "o", "\u001b[?2004h> "]
[5326.313222, "o", "        for c := range classes {\r\n\u001b[?2004l\r"]
[5326.313278, "o", "\u001b[?2004h> "]
[5326.313565, "o", "            classNames = append(classNames, c)\r\n\u001b[?2004l\r"]
[5326.31362, "o", "\u001b[?2004h> "]
[5326.313676, "o", "        }\r\n\u001b[?2004l\r"]
[5326.313731, "o", "\u001b[?2004h> "]
[5326.31392, "o", "        sort.Strings(classNames)\r\n\u001b[?2004l\r"]
[5326.313976, "o", "\u001b[?2004h> "]
[5326.314307, "o", "        rng := rand.New(rand.NewSource(int64(seed)))\r\n\u001b[?2004l\r"]
[5326.314363, "o", "\u001b[?2004h> "]
[5326.314586, "o", "        for _, c := range classNames {\r\n\u001b[?2004l\r"]
[5326.314641, "o", "\u001b[?2004h> "]
[5326.314817, "o", "            rows := classes[c]\r\n\u001b[?2004l\r"]
[5326.314871, "o", "\u001b[?2004h> "]
[5326.315107, "o", "            perm := rng.Perm(len(rows))\r\n\u001b[?2004l\r"]
[5326.315162, "o", "\u001b[?2004h> "]
[5326.3154, "o", "            for pos, p := range perm {\r\n\u001b[?2004l\r"]
[5326.315456, "o", "\u001b[?2004h> "]
[5326.31566, "o", "                srcIdx := rows[p]\r\n\u001b[?2004l\r"]
[5326.315715, "o", "\u001b[?2004h> "]
[5326.315927, "o", "                if pos%k == fold {\r\n\u001b[?2004l\r"]
[5326.315985, "o", "\u001b[?2004h> "]
[5326.316326, "o", "                    testRows = append(testRows, srcIdx)\r\n\u001b[?2004l\r"]
[5326.316381, "o", "\u001b[?2004h> "]
[5326.316521, "o", "                } else {\r\n\u001b[?2004l\r"]
[5326.316575, "o", "\u001b[?2004h> "]
[5326.316941, "o", "                    trainRows = append(trainRows, srcIdx)\r\n\u001b[?2004l\r"]
[5326.316996, "o", "\u001b[?2004h> "]
[5326.317091, "o", "                }\r\n\u001b[?2004l\r"]
[5326.317137, "o", "\u001b[?2004h> "]
[5326.317243, "o", "            }\r\n\u001b[?2004l\r"]
[5326.317298, "o", "\u001b[?2004h> "]
[5326.317354, "o", "        }\r\n\u001b[?2004l\r"]
[5326.317412, "o", "\u001b[?2004h> "]
[5326.317466, "o", "    }\r\n\u001b[?2004l\r"]
[5326.317521, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.317578, "o", "> "]
[5326.317681, "o", "    train := ds.Copy()\r\n\u001b[?2004l\r"]
[5326.317739, "o", "\u001b[?2004h> "]
[5326.317867, "o", "    train.Rows = nil\r\n\u001b[?2004l\r"]
[5326.317923, "o", "\u001b[?2004h> "]
[5326.318052, "o", "    test := ds.Copy()\r\n\u001b[?2004l\r"]
[5326.318133, "o", "\u001b[?2004h"]
[5326.318174, "o", "> "]
[5326.3183, "o", "    test.Rows = nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.318326, "o", "> \r\n\u001b[?2004l\r"]
[5326.318413, "o", "\u001b[?2004h> "]
[5326.318761, "o", "    appendRow := func(dst *Dataset, src []string) {\r\n\u001b[?2004l\r"]
[5326.318824, "o", "\u001b[?2004h> "]
[5326.319224, "o", "        dst.Rows = append(dst.Rows, append([]string{}, src...))\r\n\u001b[?2004l\r"]
[5326.319281, "o", "\u001b[?2004h>     }"]
[5326.319337, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.319578, "o", "    for _, idx := range trainRows {\r\n\u001b[?2004l\r"]
[5326.319634, "o", "\u001b[?2004h> "]
[5326.31985, "o", "        appendRow(train, ds.Rows[idx])\r\n\u001b[?2004l\r"]
[5326.319906, "o", "\u001b[?2004h> "]
[5326.31996, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5326.320014, "o", "> "]
[5326.320187, "o", "    for _, idx := range testRows {\r\n\u001b[?2004l\r"]
[5326.320258, "o", "\u001b[?2004h> "]
[5326.320433, "o", "        appendRow(test, ds.Rows[idx])\r\n\u001b[?2004l\r"]
[5326.320464, "o", "\u001b[?2004h"]
[5326.320616, "o", ">     }"]
[5326.320787, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.321023, "o", "    return map[string]*ArtifactValue{\"train\": {Dataset: train}, \"test\": {Dataset: test}}, nil\r\n\u001b[?2004l\r"]
[5326.32105, "o", "\u001b[?2004h> "]
[5326.321202, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.321532, "o", "func artifactIDFold(pipeline, stage, port string, ts int64, fold int) string {\r\n\u001b[?2004l\r"]
[5326.321619, "o", "\u001b[?2004h"]
[5326.321683, "o", ">     if pipeline == \"\" {\r\n\u001b[?2004l\r"]
[5326.321746, "o", "\u001b[?2004h> "]
[5326.321867, "o", "        pipeline = \"pipeline\"\r\n\u001b[?2004l\r"]
[5326.321923, "o", "\u001b[?2004h> "]
[5326.321978, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.322344, "o", "    return fmt.Sprintf(\"%s-%s-%s-%d-fold%d\", pipeline, stage, port, ts, fold)\r\n\u001b[?2004l\r"]
[5326.322405, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
