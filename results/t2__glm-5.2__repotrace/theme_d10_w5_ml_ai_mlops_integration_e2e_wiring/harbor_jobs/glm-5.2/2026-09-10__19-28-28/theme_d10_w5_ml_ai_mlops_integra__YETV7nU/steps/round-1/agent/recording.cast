[4137.386903, "i", "cat > cache.go << 'EOF'\npackage main\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n)\n\nfunc canonicalJSON(v interface{}) (string, error) {\n\tdata, err := json.Marshal(v)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn string(data), nil\n}\n\nfunc sha256Hex(data []byte) string {\n\th := sha256.Sum256(data)\n\treturn hex.EncodeToString(h[:])\n}\n\nfunc fileSHA256(path string) (string, error) {\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn sha256Hex(data), nil\n}\n\nfunc cacheDir() string {\n\treturn filepath.Join(\".mlpipe\", \"cache\")\n}\n\nfunc cacheEntryPath(key string) string {\n\treturn filepath.Join(cacheDir(), key)\n}\n\nfunc cacheEntryExists(key string) bool {\n\tif key == \"\" {\n\t\treturn false\n\t}\n\tinfo, err := os.Stat(cacheEntryPath(key))\n\treturn err == nil && info.IsDir()\n}\n\nfunc computeCacheKey(stage *StageConfig, params map[string]interface{}, inputKeys map[string]string, fold int) (string, error) {\n\tvar sb strings.Builder"]
[4137.38718, "i", "\n\tsb.WriteString(stage.Type)\n\tsb.WriteString(\"\\n\")\n\n\tparamsJSON, err := canonicalJSON(params)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tsb.WriteString(paramsJSON)\n\tsb.WriteString(\"\\n\")\n\n\tif stage.Type == \"data-source\" {\n\t\tpath, ok := getString(params, \"path\")\n\t\tif !ok {\n\t\t\treturn \"\", fmt.Errorf(\"data-source stage %q requires path for cache key\", stage.Name)\n\t\t}\n\t\tfileHash, err := fileSHA256(path)\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tsb.WriteString(fileHash)\n\t} else {\n\t\tports := make([]string, 0, len(stage.Inputs))\n\t\tfor port := range stage.Inputs {\n\t\t\tports = append(ports, port)\n\t\t}\n\t\tsort.Strings(ports)\n\t\tfor i, port := range ports {\n\t\t\tif i > 0 {\n\t\t\t\tsb.WriteString(\"\\n\")\n\t\t\t}\n\t\t\tsb.WriteString(port)\n\t\t\tsb.WriteString(\"=\")\n\t\t\tif key, ok := inputKeys[port]; ok {\n\t\t\t\tsb.WriteString(key)\n\t\t\t}\n\t\t}\n\t}\n\n\tif fold >= 0 {\n\t\tsb.WriteString(\"\\nfold=\")\n\t\tsb.WriteString(strconv.Itoa(fold))\n\t}\n\n\treturn sha256Hex([]byte(sb.String())), nil\n}\n\ntype cacheMeta struct {\n\tCacheKey    string   `json:\"cache_key\"`\n\tStageName   str"]
[4137.387309, "o", "cat > cache.go << 'EOF'\r\n\u001b[?2004l\r"]
[4137.387443, "i", "ing   `json:\"stage_name\"`\n\tStageType   string   `json:\"stage_type\"`\n\tCreatedAt   string   `json:\"created_at\"`\n\tOutputPorts []string `json:\"output_ports\"`\n}\n\nfunc serializeArtifactValue(val *ArtifactValue) ([]byte, error) {\n\tif val.Dataset != nil {\n\t\ttypesMap := make(map[string]string, len(val.Dataset.Columns))\n\t\tfor i, col := range val.Dataset.Columns {\n\t\t\tif i < len(val.Dataset.Types) {\n\t\t\t\ttypesMap[col] = val.Dataset.Types[i]\n\t\t\t}\n\t\t}\n\t\tobj := map[string]interface{}{\n\t\t\t\"type\":     \"dataset\",\n\t\t\t\"columns\":  val.Dataset.Columns,\n\t\t\t\"types\":    typesMap,\n\t\t\t\"rows\":     val.Dataset.Rows,\n\t\t}\n\t\treturn json.MarshalIndent(obj, \"\", \"  \")\n\t}\n\tif val.Model != nil {\n\t\tobj := map[string]interface{}{\n\t\t\t\"type\":  \"model\",\n\t\t\t\"model\": val.Model,\n\t\t}\n\t\treturn json.MarshalIndent(obj, \"\", \"  \")\n\t}\n\tif val.Report != nil {\n\t\tobj := map[string]interface{}{\n\t\t\t\"type\":    \"report\",\n\t\t\t\"metrics\": val.Report.Metrics,\n\t\t\t\"pass\":    val.Report.Pass,\n\t\t}\n\t\treturn json.MarshalIndent(obj, \"\", \"  \")\n\t}\n\tif val.Entry != nil {\n\t\tobj := ma"]
[4137.387511, "o", "\r\n\tsb.WriteString(stage.Type)\r\n\tsb.WriteString(\"\\n\")\r\n\r\n\tparamsJSON, err := canonicalJSON(params)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tsb.WriteString(paramsJSON)\r\n\tsb.WriteString(\"\\n\")\r\n\r\n\tif stage.Type == \"data-source\" {\r\n\t\tpath, ok := getStr"]
