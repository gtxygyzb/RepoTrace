[11263.612163, "i", "\\texecutor.cacheStats = nil\n\\t}\n\\texecutor.cvFolds = cv\n\\tvar run interface{}\n\\tif cv > 0 {\n\\t\\trun, err = executor.RunCV()\n\\t} else {\n\\t\\trun, err = executor.Run()\n\\t}\n\\tif err != nil {\n\\t\\tprintError(err.Error())\n\\t\\treturn\n\\t}\n\\tprintJSON(run)\n}'''\nnew = '''func cmdRun(args []string) {\n\\tconfigPath, overrides, cv, noCache, skipStages, err := parseRunArgs(args)\n\\tif err != nil {\n\\t\\tprintError(err.Error())\n\\t\\treturn\n\\t}\n\\tstarted := time.Now()\n\\tconfig, err := loadConfig(configPath)\n\\tif err != nil {\n\\t\\tprintError(err.Error())\n\\t\\treturn\n\\t}\n\\tfor _, name := range skipStages {\n\\t\\tif _, ok := config.stageByName(name); !ok {\n\\t\\t\\tprintError(fmt.Sprintf(\"unknown stage: %s\", name))\n\\t\\t\\treturn\n\\t\\t}\n\\t}\n\\texecutor := NewExecutor(config, overrides)\n\\texecutor.noCache = noCache\n\\texecutor.skipStages = skipStages\n\\tif noCache {\n\\t\\texecutor.cacheStats = nil\n\\t}\n\\texecutor.cvFolds = cv\n\\tvar run interface{}\n\\tif cv > 0 {\n\\t\\trun, err = executor.RunCV()\n\\t} else {\n\\t\\trun, err = executor.Run()\n\\t}\n\\tfinished :="]
[11263.612275, "o", "python3 - <<'PY'\r\n"]
[11263.612368, "i", " time.Now()\n\\tstatus := \"failed\"\n\\tif err == nil {\n\\t\\tstatus = runStatus(run)\n\\t}\n\\trecord := buildRunRecord(executor, started, finished, status)\n\\tif recErr := saveRunRecord(record); recErr != nil {\n\\t\\tprintError(recErr.Error())\n\\t\\treturn\n\\t}\n\\tif err != nil {\n\\t\\tprintError(err.Error())\n\\t\\treturn\n\\t}\n\\tprintJSON(run)\n}'''\nif old not in s:\n    raise SystemExit(\"cmdRun block not found\")\ns = s.replace(old, new)\np.write_text(s)\n\nfor fn in [\"pipeline.go\", \"cv.go\"]:\n    p = Path(fn)\n    s = p.read_text()\n    s = s.replace('\\tif err := saveRunAny(e.config.Pipeline.Name, run); err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\treturn run, nil', '\\treturn run, nil')\n    s = s.replace('\\tif err := saveRunAny(e.config.Pipeline.Name, run); err != nil {\\n\\t\\treturn nil, err\\n\\t}', '')\n    p.write_text(s)\nPY\n"]
