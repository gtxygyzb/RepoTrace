[2910.138679, "o", "\t}\r\n    83\t\r\n    84\t\trunArtifacts := map[string]*ArtifactOutput{}\r\n    85\t\r\n    86\t\tfor _, name := range order {\r\n    87\t\t\tstage, _ := e.config.stageByName(name)\r\n    88\t\t\te.outputs[name] = map[string]string{}\r\n    89\t\t\te.values[name] = map[string]*ArtifactValue{}\r\n    90"]
[2910.138741, "o", "\t\t\te.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n    91\t\r\n    92\t\t\tskip := false\r\n    93\t\t\tfor _, dep := range stage.DependsOn {\r\n    94\t\t\t\tif e.status[dep] != \"success\" {\r\n    95\t\t\t\t\tskip = true\r\n    96\t\t\t\t\tbreak\r\n    97\t\t\t\t}\r\n"]
