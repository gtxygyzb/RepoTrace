[5326.215401, "o", "\u001b[?2004h> "]
[5326.215526, "o", "            break\r\n\u001b[?2004l\r"]
[5326.215591, "o", "\u001b[?2004h> "]
[5326.215666, "o", "        }\r\n\u001b[?2004l\r"]
[5326.21573, "o", "\u001b[?2004h> "]
[5326.215791, "o", "    }\r\n\u001b[?2004l\r"]
[5326.215848, "o", "\u001b[?2004h> "]
[5326.216078, "o", "    for _, fr := range foldResults {\r\n\u001b[?2004l\r"]
[5326.216133, "o", "\u001b[?2004h> "]
[5326.216388, "o", "        if fr.Status != \"success\" {\r\n\u001b[?2004l\r"]
[5326.216445, "o", "\u001b[?2004h> "]
[5326.216658, "o", "            status = \"failed\"\r\n\u001b[?2004l\r"]
[5326.216714, "o", "\u001b[?2004h> "]
[5326.216837, "o", "            break\r\n\u001b[?2004l\r"]
[5326.216892, "o", "\u001b[?2004h> "]
[5326.216954, "o", "        }\r\n\u001b[?2004l\r"]
[5326.217011, "o", "\u001b[?2004h> "]
[5326.217067, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5326.217122, "o", "\u001b[?2004h> "]
[5326.217265, "o", "    run := &CVRunOutput{\r\n\u001b[?2004l\r"]
[5326.217319, "o", "\u001b[?2004h> "]
[5326.217547, "o", "        Pipeline:    e.config.Pipeline.Name,\r\n\u001b[?2004l\r"]
[5326.217602, "o", "\u001b[?2004h> "]
[5326.217755, "o", "        Status:      status,\r\n\u001b[?2004l\r"]
[5326.21781, "o", "\u001b[?2004h> "]
[5326.217998, "o", "        CVFolds:     e.cvFolds,\r\n\u001b[?2004l\r"]
[5326.218052, "o", "\u001b[?2004h> "]
