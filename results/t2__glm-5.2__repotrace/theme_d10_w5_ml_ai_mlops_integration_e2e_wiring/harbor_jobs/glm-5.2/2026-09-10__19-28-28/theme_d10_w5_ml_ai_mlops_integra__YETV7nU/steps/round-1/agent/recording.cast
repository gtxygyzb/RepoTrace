[8758.076251, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n"]
[8758.076327, "o", "\t\"fmt\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintError(\"usage: mlpipe <command> [args]\")\r\n\t\treturn\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n"]
[8758.076394, "o", "\tcase \"plan\":\r\n\t\tcmdPlan(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"registry\":\r\n\t\tcmdRegistry(args)\r\n\tcase \"lineage\":\r\n\t\tcmdLineage(args)\r\n\tdefault:\r\n"]
[8758.07646, "o", "\t\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n\t}\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n\tconfigPath, overrides, cv, noCache, err := parseRunArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\t"]
[8758.076543, "o", "if err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\texecutor := NewExecutor(config, overrides)\r\n\texecutor.noCache = noCache\r\n\tif noCache {\r\n\t\texecutor.cacheStats = nil\r\n\t}\r\n\texecutor.cvFolds = cv\r\n\tvar run interface{}\r\n\tif cv > 0 {\r\n\t\t"]
[8758.076603, "o", "run, err = executor.RunCV()\r\n\t} else {\r\n\t\trun, err = executor.Run()\r\n\t}\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(run)\r\n}\r\n"]
[8758.076663, "o", "\r\nfunc cmdPlan(args []string) {\r\n\tconfigPath, overrides, cv, err := parsePlanArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n"]
[8758.076723, "o", "\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tplan, err := buildPlan(config, overrides, cv)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(plan)\r\n}\r\n\r\nfunc cmdValidate(args []string) {\r\n\tif len(args) < 1 {\r\n"]
[8758.076786, "o", "\t\tprintError(\"usage: mlpipe validate <config.json>\")\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(args[0])\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tvalid, errors := config.Validate()\r\n\tprintJSON(map[string]interface{}{\"valid\": valid, \"errors\": errors})\r\n}\r\n\r\n"]
[8758.076846, "o", "func cmdRegistry(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe registry <list|info|promote|compare> [args]\")\r\n\t\treturn\r\n\t}\r\n\tsub := args[0]\r\n\trest := args[1:]\r\n\tswitch sub {\r\n\tcase \"list\":\r\n\t\tcmdRegistryList(rest)\r\n\tcase \"info\":\r\n"]
[8758.076908, "o", "\t\tcmdRegistryInfo(rest)\r\n\tcase \"promote\":\r\n\t\tcmdRegistryPromote(rest)\r\n\tcase \"compare\":\r\n\t\tcmdRegistryCompare(rest)\r\n\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown registry command: %s\", sub))\r\n\t}\r\n}\r\n"]
[8758.076967, "o", "\r\nfunc cmdRegistryList(args []string) {\r\n\tname, stage, tag := \"\", \"\", \"\"\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--name\" && i+1 < len(args):\r\n\t\t\tname = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--name=\"):\r\n\t\t\tname = strings.TrimPrefix(args[i], \"--name=\")\r\n"]
[8758.077041, "o", "\t\tcase args[i] == \"--stage\" && i+1 < len(args):\r\n\t\t\tstage = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--stage=\"):\r\n\t\t\tstage = strings.TrimPrefix(args[i], \"--stage=\")\r\n\t\tcase args[i] == \"--tag\" && i+1 < len(args):\r\n\t\t\ttag = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--tag=\"):\r\n"]
[8758.077098, "o", "\t\t\ttag = strings.TrimPrefix(args[i], \"--tag=\")\r\n\t\tdefault:\r\n\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n\tentries, err := listRegistry(name, stage, tag)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t"]
[8758.077154, "o", "\treturn\r\n\t}\r\n\tout := make([]map[string]interface{}, len(entries))\r\n\tfor i, e := range entries {\r\n\t\tout[i] = map[string]interface{}{\r\n\t\t\t\"name\":          e.Name,\r\n\t\t\t\"version\":       e.Version,\r\n\t\t\t\"stage\":         e.Stage,\r\n\t\t\t\"tags\":          e.Tags,\r\n"]
[8758.07724, "o", "\t\t\t\"metrics\":       e.Metrics,\r\n\t\t\t\"registered_at\": e.RegisteredAt,\r\n\t\t}\r\n\t}\r\n\tprintJSON(out)\r\n}\r\n\r\nfunc cmdRegistryInfo(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe registry info <name>:<version>\")\r\n\t\treturn\r\n\t}\r\n"]
[8758.077304, "o", "\tname, version, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tentry, err := registryInfo(name, version)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n"]
[8758.077366, "o", "\t}\r\n\tprintJSON(entry)\r\n}\r\n\r\nfunc cmdRegistryPromote(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tprintError(\"usage: mlpipe registry promote <name>:<version> <target_stage>\")\r\n\t\treturn\r\n\t}\r\n\tname, version, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n"]
[8758.077422, "o", "\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\ttarget := args[1]\r\n\tentry, prev, new, err := promoteModel(name, version, target)\r\n\tif err != nil {\r\n\t\tif strings.HasPrefix(err.Error(), \"metric \") {\r\n\t\t\tprintJSON(map[string]interface{}{\"success\": false, \"message\": err.Error()})\r\n\t\t\treturn\r\n"]
[8758.077483, "o", "\t\t}\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(map[string]interface{}{\r\n\t\t\"success\":        true,\r\n\t\t\"message\":        fmt.Sprintf(\"promoted to %s\", new),\r\n\t\t\"previous_stage\": prev,\r\n\t\t\"new_stage\":      entry.Stage,\r\n\t"]
[8758.077544, "o", "})\r\n}\r\n\r\nfunc cmdRegistryCompare(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tprintError(\"usage: mlpipe registry compare <name>:<version1> <name>:<version2>\")\r\n\t\treturn\r\n\t}\r\n\tname1, v1, ok := splitNameVersion(args[0])\r\n\tif !ok {\r\n"]
[8758.077605, "o", "\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tname2, v2, ok := splitNameVersion(args[1])\r\n\tif !ok {\r\n\t\tprintError(\"invalid name:version format\")\r\n\t\treturn\r\n\t}\r\n\tif name1 != name2 {\r\n\t\tprintError(\"cannot compare different model names\")\r\n\t\treturn\r\n\t}\r\n\t"]
[8758.07767, "o", "result, err := compareModels(name1, v1, v2)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(result)\r\n}\r\n\r\nfunc cmdLineage(args []string) {\r\n\tif len(args) < 2 {\r\n"]
[8758.077737, "o", "\t\tprintError(\"usage: mlpipe lineage <artifact_id> <up|down|both>\")\r\n\t\treturn\r\n\t}\r\n\tid := args[0]\r\n\tdirection := args[1]\r\n\tresult, err := queryLineage(id, direction)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(result)\r\n"]
[8758.077793, "o", "}\r\n\r\nfunc parseRunArgs(args []string) (string, map[string]string, int, bool, error) {\r\n\tconfigPath := \"\"\r\n\toverrides := map[string]string{}\r\n\tcv := 0\r\n\tnoCache := false\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n"]
[8758.077854, "o", "\t\tcase args[i] == \"--cv\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn \"\", nil, 0, false, fmt.Errorf(\"--cv requires a value\")\r\n"]
[8758.078371, "o", "\u001b[?2004h"]
