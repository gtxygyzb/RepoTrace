[9501.517238, "o", "\u001b[?2004h> "]
[9501.517323, "o", "if helper not in s:\r\n\u001b[?2004l\r"]
[9501.517383, "o", "\u001b[?2004h> "]
[9501.517663, "o", "    s = s.replace(insert_after, insert_after + helper)\r\n\u001b[?2004l\r"]
[9501.517719, "o", "\u001b[?2004h> "]
