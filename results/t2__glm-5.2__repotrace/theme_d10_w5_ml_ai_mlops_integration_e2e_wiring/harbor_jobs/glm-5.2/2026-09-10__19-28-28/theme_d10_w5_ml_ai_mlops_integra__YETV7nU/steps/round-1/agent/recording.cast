[11863.635696, "o", "package main\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[11863.635766, "o", "\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nfunc canonicalJSON(v interface{}) (string, error) {\r\n\tb, err := marshalCanonical(v)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n"]
[11863.635831, "o", "\treturn string(b), nil\r\n}\r\n\r\nfunc marshalCanonical(v interface{}) ([]byte, error) {\r\n\tswitch x := v.(type) {\r\n\tcase map[string]interface{}:\r\n\t\tkeys := make([]string, 0, len(x))\r\n\t\tfor k := range x {\r\n\t\t\tkeys = append(keys, k)\r\n\t\t}\r\n"]
[11863.635894, "o", "\t\tsort.Strings(keys)\r\n\t\tvar b strings.Builder\r\n\t\tb.WriteString(\"{\")\r\n\t\tfor i, k := range keys {\r\n\t\t\tif i > 0 {\r\n\t\t\t\tb.WriteString(\",\")\r\n\t\t\t}\r\n\t\t\tkb, err := json.Marshal(k)\r\n\t\t\tif err != nil {\r\n\t"]
[11863.635954, "o", "\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tb.Write(kb)\r\n\t\t\tb.WriteString(\":\")\r\n\t\t\tvb, err := marshalCanonical(x[k])\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n"]
[11863.636013, "o", "\t\t\tb.Write(vb)\r\n\t\t}\r\n\t\tb.WriteString(\"}\")\r\n\t\treturn []byte(b.String()), nil\r\n\tcase []interface{}:\r\n\t\tvar b strings.Builder\r\n\t\tb.WriteString(\"[\")\r\n\t\tfor i, item := range x {\r\n"]
[11863.636071, "o", "\t\t\tif i > 0 {\r\n\t\t\t\tb.WriteString(\",\")\r\n\t\t\t}\r\n\t\t\tib, err := marshalCanonical(item)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tb.Write(ib)\r\n"]
[11863.636127, "o", "\t\t}\r\n\t\tb.WriteString(\"]\")\r\n\t\treturn []byte(b.String()), nil\r\n\tdefault:\r\n\t\treturn json.Marshal(v)\r\n\t}\r\n}\r\n\r\nfunc sha256Hex(data []byte) string {\r\n\th := sha256.Sum256(data)\r\n"]
[11863.636183, "o", "\treturn hex.EncodeToString(h[:])\r\n}\r\n\r\nfunc fileSHA256(path string) (string, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\treturn sha256Hex(data), nil\r\n}\r\n"]
[11863.636282, "o", "\r\nfunc cacheDir() string {\r\n\treturn filepath.Join(\".mlpipe\", \"cache\")\r\n}\r\n\r\nfunc cacheEntryPath(key string) string {\r\n\treturn filepath.Join(cacheDir(), key)\r\n}\r\n\r\nfunc cacheEntryExists(key string) bool {\r\n\tif key == \"\" {\r\n\t\treturn false\r\n\t}\r\n\tinfo, err := os.Stat(cacheEntryPath(key))\r\n\t"]
[11863.636342, "o", "return err == nil && info.IsDir()\r\n}\r\n\r\nfunc computeCacheKey(stage *StageConfig, params map[string]interface{}, inputKeys map[string]string, fold int) (string, error) {\r\n\tvar sb strings.Builder\r\n\tsb.WriteString(stage.Type)\r\n\tsb.WriteString(\"\\n\")\r\n\r\n\tparamsJSON, err := canonicalJSON(params)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n"]
[11863.636408, "o", "\tsb.WriteString(paramsJSON)\r\n\tsb.WriteString(\"\\n\")\r\n\r\n\tif stage.Type == \"data-source\" {\r\n\t\tpath, ok := getString(params, \"path\")\r\n\t\tif !ok {\r\n\t\t\treturn \"\", fmt.Errorf(\"data-source stage %q requires path for cache key\", stage.Name)\r\n\t\t}\r\n\t\tfileHash, err := fileSHA256(path)\r\n\t\tif err != nil {\r\n\t"]
[11863.636469, "o", "\t\treturn \"\", err\r\n\t\t}\r\n\t\tsb.WriteString(fileHash)\r\n\t} else {\r\n\t\tports := make([]string, 0, len(stage.Inputs))\r\n\t\tfor port := range stage.Inputs {\r\n\t\t\tports = append(ports, port)\r\n\t\t}\r\n\t"]
[11863.63653, "o", "\tsort.Strings(ports)\r\n\t\tfor i, port := range ports {\r\n\t\t\tif i > 0 {\r\n\t\t\t\tsb.WriteString(\"\\n\")\r\n\t\t\t}\r\n\t\t\tsb.WriteString(port)\r\n\t\t\tsb.WriteString(\"=\")\r\n\t\t\tif key, ok := inputKeys[port]; ok {\r\n"]
[11863.636586, "o", "\t\t\t\tsb.WriteString(key)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif fold >= 0 {\r\n\t\tsb.WriteString(\"\\nfold=\")\r\n\t\tsb.WriteString(strconv.Itoa(fold))\r\n\t}\r\n\r\n\treturn sha256Hex([]byte(sb.String())), nil\r\n"]
[11863.636644, "o", "}\r\n\r\ntype cacheMeta struct {\r\n\tCacheKey    string   `json:\"cache_key\"`\r\n\tStageName   string   `json:\"stage_name\"`\r\n\tStageType   string   `json:\"stage_type\"`\r\n\tCreatedAt   string   `json:\"created_at\"`\r\n\tOutputPorts []string `json:\"output_ports\"`\r\n}\r\n\r\nfunc serializeArtifactValue(val *ArtifactValue) ([]byte, error) {\r\n\tif val.Dataset != nil {\r\n\t\t"]
[11863.636707, "o", "typesMap := make(map[string]string, len(val.Dataset.Columns))\r\n\t\tfor i, col := range val.Dataset.Columns {\r\n\t\t\tif i < len(val.Dataset.Types) {\r\n\t\t\t\ttypesMap[col] = val.Dataset.Types[i]\r\n\t\t\t}\r\n\t\t}\r\n\t\tobj := map[string]interface{}{\r\n\t\t\t\"type\":    \"dataset\",\r\n"]
[11863.636765, "o", "\t\t\t\"columns\": val.Dataset.Columns,\r\n\t\t\t\"types\":   typesMap,\r\n\t\t\t\"rows\":    val.Dataset.Rows,\r\n\t\t}\r\n\t\treturn json.MarshalIndent(obj, \"\", \"  \")\r\n\t}\r\n\tif val.Model != nil {\r\n\t\tobj := map[string]interface{}{\r\n\t\t\t"]
[11863.636822, "o", "\"type\":  \"model\",\r\n\t\t\t\"model\": val.Model,\r\n\t\t}\r\n\t\treturn json.MarshalIndent(obj, \"\", \"  \")\r\n\t}\r\n\tif val.Report != nil {\r\n\t\tobj := map[string]interface{}{\r\n\t\t\t\"type\":    \"report\",\r\n\t\t\t\"metrics\": val.Report.Metrics,\r\n"]
[11863.636879, "o", "\t\t\t\"pass\":    val.Report.Pass,\r\n\t\t}\r\n\t\treturn json.MarshalIndent(obj, \"\", \"  \")\r\n\t}\r\n\tif val.Entry != nil {\r\n\t\tobj := map[string]interface{}{\r\n\t\t\t\"type\":    \"entry\",\r\n\t\t\t\"name\":    val.Entry.Name,\r\n\t\t\t\"version\": val.Entry.Version,\r\n"]
[11863.636937, "o", "\t\t\t\"stage\":   val.Entry.Stage,\r\n\t\t}\r\n\t\treturn json.MarshalIndent(obj, \"\", \"  \")\r\n\t}\r\n\treturn nil, fmt.Errorf(\"cannot serialize unknown artifact type\")\r\n}\r\n\r\nfunc deserializeArtifactValue(data []byte) (*ArtifactValue, error) {\r\n\tvar obj map[string]interface{}\r\n\t"]
[11863.636994, "o", "if err := json.Unmarshal(data, &obj); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\ttyp, _ := obj[\"type\"].(string)\r\n\tswitch typ {\r\n\tcase \"dataset\":\r\n\t\treturn deserializeDatasetValue(obj)\r\n\tcase \"model\":\r\n\t"]
[11863.637069, "o", "\treturn deserializeModelValue(obj)\r\n\tcase \"report\":\r\n\t\tmetrics, _ := obj[\"metrics\"].(map[string]interface{})\r\n\t\tpass, _ := obj[\"pass\"].(bool)\r\n\t\treturn &ArtifactValue{Report: &Report{Metrics: metrics, Pass: pass}}, nil\r\n\tcase \"entry\":\r\n\t\tname, _ := obj[\"name\"].(string)\r\n\t\tversion, _ := obj[\"version\"].(float64)\r\n\t\tstage, _ := obj[\"stage\"].(string)\r\n\t\treturn &ArtifactValue{Entry: &RegistryEntry{Name: name, Version: int(version), Stage: stage}}, nil\r\n\t}\r\n\t"]
[11863.637133, "o", "return nil, fmt.Errorf(\"unknown artifact type in cache: %s\", typ)\r\n}\r\n\r\nfunc deserializeDatasetValue(obj map[string]interface{}) (*ArtifactValue, error) {\r\n\tcols, _ := obj[\"columns\"].([]interface{})\r\n\ttypesMap, _ := obj[\"types\"].(map[string]interface{})\r\n\trows, _ := obj[\"rows\"].([]interface{})\r\n\tds := &Dataset{\r\n\t\tColumns: make([]string, len(cols)),\r\n\t\tTypes:   make([]string, len(cols)),\r\n"]
[11863.637197, "o", "\t\tRows:    make([][]string, len(rows)),\r\n\t}\r\n\tfor i, c := range cols {\r\n\t\tds.Columns[i], _ = c.(string)\r\n\t}\r\n\tfor i, col := range ds.Columns {\r\n\t\tif t, ok := typesMap[col]; ok {\r\n\t\t\tds.Types[i], _ = t.(string)\r\n\t\t}\r\n\t}\r\n"]
[11863.637277, "o", "\tfor i, r := range rows {\r\n\t\trow, _ := r.([]interface{})\r\n\t\tds.Rows[i] = make([]string, len(row))\r\n\t\tfor j, v := range row {\r\n\t\t\tds.Rows[i][j], _ = v.(string)\r\n\t\t}\r\n\t}\r\n\treturn &ArtifactValue{Dataset: ds}, nil\r\n}\r\n\r\nfunc deserializeModelValue(obj map[string]interface{}) (*ArtifactValue, error) {\r\n\tmodelData, err := json.Marshal(obj[\"model\"])\r\n\tif err != nil {\r\n"]
[11863.637335, "o", "\t\treturn nil, err\r\n\t}\r\n\tvar model Model\r\n\tif err := json.Unmarshal(modelData, &model); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn &ArtifactValue{Model: &model}, nil\r\n"]
