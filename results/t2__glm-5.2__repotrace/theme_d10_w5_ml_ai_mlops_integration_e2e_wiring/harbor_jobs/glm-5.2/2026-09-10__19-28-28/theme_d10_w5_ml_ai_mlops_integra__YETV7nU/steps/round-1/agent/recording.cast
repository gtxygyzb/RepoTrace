[10943.870629, "o", "    22\t\t\tcmdRun(args)\r\n    23\t\tcase \"plan\":\r\n    24\t\t\tcmdPlan(args)\r\n    25\t\tcase \"validate\":\r\n    26\t\t\tcmdValidate(args)\r\n    27\t\tcase \"registry\":\r\n    28\t\t\tcmdRegistry(args)\r\n    29\t\tcase \"lineage\":\r\n    30\t\t\tcmdLineage(args)\r\n"]
[10943.870745, "o", "    31\t\tdefault:\r\n    32\t\t\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n    33\t\t}\r\n    34\t}\r\n    35\t\r\n    36\tfunc cmdRun(args []string) {\r\n    37\t\tconfigPath, overrides, cv, noCache, skipStages, err := parseRunArgs(args)\r\n    38\t\tif err != nil {\r\n    39\t\t\tprintError(err.Error())\r\n    40\t\t\treturn\r\n    41\t\t}\r\n    42\t\tconfig, err := loadConfig(configPath)\r\n    43\t\tif err != nil {\r\n    44\t\t\tprintError(err.Error())\r\n    45\t\t\treturn\r\n    46\t\t}\r\n    47\t\tfor _, name := range skipStages {\r\n    48\t\t\tif _, ok := config.stageByName(name); !ok {\r\n"]
[10943.870857, "o", "    49\t\t\t\tprintError(fmt.Sprintf(\"unknown stage: %s\", name))\r\n    50\t\t\t\treturn\r\n    51\t\t\t}\r\n    52\t\t}\r\n    53\t\texecutor := NewExecutor(config, overrides)\r\n    54\t\texecutor.noCache = noCache\r\n    55\t\texecutor.skipStages = skipStages\r\n    56\t\tif noCache {\r\n    57\t\t\texecutor.cacheStats = nil\r\n    58\t\t}\r\n    59\t\texecutor.cvFolds = cv\r\n    60\t\tvar run interface{}\r\n    61\t\tif cv > 0 {\r\n    62\t\t\trun, err = executor.RunCV()\r\n    63\t\t} else {\r\n    64\t\t\trun, err = executor.Run()\r\n    65\t\t}\r\n    66\t\tif err != nil {\r\n    67\t\t\tprintError(err.Error())\r\n    68\t\t\treturn\r\n    69\t\t}\r\n    70\t\tprintJSON(run)\r\n    71\t}\r\n    72\t\r\n    73\tfunc cmdPlan(args []string) {\r\n"]
