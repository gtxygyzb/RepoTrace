[5326.225683, "o", "\u001b[?2004h> "]
[5326.225928, "o", "        e.results[name].Status = \"failed\"\r\n\u001b[?2004l\r"]
[5326.225983, "o", "\u001b[?2004h> "]
[5326.226207, "o", "        e.results[name].Error = err.Error()\r\n\u001b[?2004l\r"]
[5326.226269, "o", "\u001b[?2004h> "]
[5326.226364, "o", "        return false\r\n\u001b[?2004l\r"]
[5326.226422, "o", "\u001b[?2004h>     }"]
[5326.226476, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5326.226536, "o", "\u001b[?2004h> "]
