[12847.637202, "o", "   277\t\r\n   278\tfunc (e *Executor) inputCacheKeys(stage *StageConfig) map[string]string {\r\n   279\t\tkeys := map[string]string{}\r\n   280\t\tfor local, ref := range stage.Inputs {\r\n   281\t\t\t"]
[12847.637343, "o", "refs, ok := inputRefs(ref)\r\n   282\t\t\tif !ok {\r\n   283\t\t\t\tcontinue\r\n   284\t\t\t}\r\n   285\t\t\tsortedRefs := append([]string(nil), refs...)\r\n   286\t\t\tsort.Strings(sortedRefs)\r\n   287\t\t\tvar parts []string\r\n   288\t\t\tfor _, r := range sortedRefs {\r\n   289\t\t\t\tp := strings.SplitN(r, \".\", 2)\r\n   290\t\t\t\tif len(p) != 2 {\r\n   291\t\t\t\t\tcontinue\r\n   292\t\t\t\t}\r\n   293\t\t\t\tdepStage := p[0]\r\n   294\t\t\t\tif key, ok := e.cacheKeys[depStage]; ok {\r\n   295\t\t\t\t\tparts = append(parts, key)\r\n   296\t\t\t\t}\r\n   297\t\t\t}\r\n"]
[12847.637432, "o", "   298\t\t\tif len(parts) > 0 {\r\n   299\t\t\t\tkeys[local] = strings.Join(parts, \"\\n\")\r\n   300\t\t\t}\r\n   301\t\t}\r\n   302\t\treturn keys\r\n   303\t}\r\n"]
[12847.63811, "o", "\u001b[?2004h"]
