[5326.20787, "o", "\u001b[?2004h> "]
[5326.208001, "o", "        sum := 0.0\r\n\u001b[?2004l\r"]
[5326.208046, "o", "\u001b[?2004h"]
[5326.208107, "o", "> "]
[5326.208201, "o", "        count := 0\r\n\u001b[?2004l\r"]
[5326.208269, "o", "\u001b[?2004h> "]
[5326.208541, "o", "        for i, fm := range foldMetrics {\r\n\u001b[?2004l\r"]
[5326.208595, "o", "\u001b[?2004h> "]
[5326.208858, "o", "            if v, ok := fm[name]; ok {\r\n\u001b[?2004l\r"]
[5326.208913, "o", "\u001b[?2004h> "]
[5326.20913, "o", "                perFold[i] = v\r\n\u001b[?2004l\r"]
[5326.209185, "o", "\u001b[?2004h> "]
