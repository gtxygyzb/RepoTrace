[456.339694, "i", "cat > data.go <<'EOF'\npackage main\n\nimport (\n\t\"encoding/csv\"\n\t\"fmt\"\n\t\"math\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n)\n\ntype Dataset struct {\n\tColumns []string     `json:\"columns\"`\n\tTypes   []string     `json:\"types\"`\n\tRows    [][]string   `json:\"rows\"`\n}\n\nfunc loadDataset(path string, schema map[string]interface{}) (*Dataset, error) {\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn nil, fmt.Errorf(\"file not found: %s\", path)\n\t\t}\n\t\treturn nil, err\n\t}\n\tdefer f.Close()\n\n\tr := csv.NewReader(f)\n\trecords, err := r.ReadAll()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif len(records) == 0 {\n\t\treturn &Dataset{Columns: []string{}, Types: []string{}, Rows: [][]string{}}, nil\n\t}\n\n\theader := records[0]\n\trows := records[1:]\n\tcolumns := header\n\ttypes := make([]string, len(columns))\n\tfor i, col := range columns {\n\t\tif schemaType, ok := schema[col]; ok {\n\t\t\ttypes[i] = fmt.Sprintf(\"%v\", schemaType)\n\t\t} else {\n\t\t\ttypes[i] = inferColumnType(rows, i)\n\t\t}\n\t}\n\treturn &Dataset{Columns: columns, Types: types, Rows: rows"]
[456.339866, "i", "}, nil\n}\n\nfunc inferColumnType(rows [][]string, idx int) string {\n\tfor _, row := range rows {\n\t\tif idx >= len(row) {\n\t\t\tcontinue\n\t\t}\n\t\tval := strings.TrimSpace(row[idx])\n\t\tif val == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif _, ok := parseFloat64(val); !ok {\n\t\t\treturn \"categorical\"\n\t\t}\n\t}\n\treturn \"numeric\"\n}\n\nfunc parseFloat64(s string) (float64, bool) {\n\ts = strings.TrimSpace(s)\n\tif s == \"\" {\n\t\treturn 0, false\n\t}\n\tf, err := strconv.ParseFloat(s, 64)\n\tif err != nil {\n\t\treturn 0, false\n\t}\n\treturn f, true\n}\n\nfunc formatFloat(f float64) string {\n\tif math.IsNaN(f) {\n\t\treturn \"NaN\"\n\t}\n\tif math.IsInf(f, 1) {\n\t\treturn \"+Inf\"\n\t}\n\tif math.IsInf(f, -1) {\n\t\treturn \"-Inf\"\n\t}\n\treturn strconv.FormatFloat(f, 'g', -1, 64)\n}\n\nfunc (ds *Dataset) ColumnIndex(name string) (int, bool) {\n\tfor i, c := range ds.Columns {\n\t\tif c == name {\n\t\t\treturn i, true\n\t\t}\n\t}\n\treturn -1, false\n}\n\nfunc (ds *Dataset) Copy() *Dataset {\n\tcols := append([]string{}, ds.Columns...)\n\ttypes := append([]string{}, ds.Types...)\n\trows := make([][]string, len(ds.Rows))\n\tfor i,"]
[456.339946, "i", " row := range ds.Rows {\n\t\trows[i] = append([]string{}, row...)\n\t}\n\treturn &Dataset{Columns: cols, Types: types, Rows: rows}\n}\n\nfunc (ds *Dataset) Summary() map[string]interface{} {\n\treturn map[string]interface{}{\n\t\t\"rows\":          len(ds.Rows),\n\t\t\"columns\":       len(ds.Columns),\n\t\t\"column_names\":  ds.Columns,\n\t\t\"column_types\":  ds.Types,\n\t}\n}\n\nfunc (ds *Dataset) NumericColumn(name string) ([]float64, error) {\n\tidx, ok := ds.ColumnIndex(name)\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"column not found: %s\", name)\n\t}\n\tif idx < len(ds.Types) && ds.Types[idx] != \"numeric\" {\n\t\treturn nil, fmt.Errorf(\"column is not numeric: %s\", name)\n\t}\n\tvals := make([]float64, len(ds.Rows))\n\tfor i, row := range ds.Rows {\n\t\tif idx >= len(row) {\n\t\t\treturn nil, fmt.Errorf(\"row %d missing column %s\", i, name)\n\t\t}\n\t\tf, ok := parseFloat64(row[idx])\n\t\tif !ok {\n\t\t\treturn nil, fmt.Errorf(\"non-numeric value in column %s: %s\", name, row[idx])\n\t\t}\n\t\tvals[i] = f\n\t}\n\treturn vals, nil\n}\n\nfunc (ds *Dataset) ColumnValues(name string) ([]string, error)"]
