[8798.101212, "o", "\t\tprintError(\"usage: mlpipe <command> [args]\")\r\n\t\treturn\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"plan\":\r\n\t\tcmdPlan(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"registry\":\r\n\t\tcmdRegistry(args)\r\n\tcase \"lineage\":\r\n\t\tcmdLineage(args)\r\n\tdefault:\r\n"]
[8798.101346, "o", "\t\tprintError(fmt.Sprintf(\"unknown command: %s\", cmd))\r\n\t}\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n\tconfigPath, overrides, cv, noCache, err := parseRunArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\texecutor := NewExecutor(config, overrides)\r\n\texecutor.noCache = noCache\r\n\tif noCache {\r\n\t\t"]
[8798.10144, "o", "executor.cacheStats = nil\r\n\t}\r\n\texecutor.cvFolds = cv\r\n\tvar run interface{}\r\n\tif cv > 0 {\r\n\t\trun, err = executor.RunCV()\r\n\t} else {\r\n\t\trun, err = executor.Run()\r\n\t}\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tprintJSON(run)\r\n}\r\n\r\nfunc cmdPlan(args []string) {\r\n\tconfigPath, overrides, cv, err := parsePlanArgs(args)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n"]
[8798.101528, "o", "\t}\r\n\tplan, err := buildPlan(config, overrides, cv)\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n"]
[8798.101623, "o", "\tprintJSON(plan)\r\n}\r\n\r\nfunc cmdValidate(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe validate <config.json>\")\r\n\t\treturn\r\n\t}\r\n\tconfig, err := loadConfig(args[0])\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tvalid, errors := config.Validate()\r\n"]
[8798.10171, "o", "\tprintJSON(map[string]interface{}{\"valid\": valid, \"errors\": errors})\r\n}\r\n\r\nfunc cmdRegistry(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tprintError(\"usage: mlpipe registry <list|info|promote|compare> [args]\")\r\n\t\treturn\r\n\t}\r\n\tsub := args[0]\r\n\trest := args[1:]\r\n\tswitch sub {\r\n\tcase \"list\":\r\n\t\tcmdRegistryList(rest)\r\n\tcase \"info\":\r\n\t\tcmdRegistryInfo(rest)\r\n\tcase \"promote\":\r\n"]
[8798.101806, "o", "\t\tcmdRegistryPromote(rest)\r\n\tcase \"compare\":\r\n\t\tcmdRegistryCompare(rest)\r\n\tdefault:\r\n\t\tprintError(fmt.Sprintf(\"unknown registry command: %s\", sub))\r\n\t}\r\n}\r\n\r\nfunc cmdRegistryList(args []string) {\r\n\tname, stage, tag := \"\", \"\", \"\"\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch {\r\n\t\tcase args[i] == \"--name\" && i+1 < len(args):\r\n\t\t\tname = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--name=\"):\r\n\t\t\tname = strings.TrimPrefix(args[i], \"--name=\")\r\n\t\tcase args[i] == \"--stage\" && i+1 < len(args):\r\n\t\t\tstage = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--stage=\"):\r\n\t\t\tstage = strings.TrimPrefix(args[i], \"--stage=\")\r\n\t\tcase args[i] == \"--tag\" && i+1 < len(args):\r\n\t\t\ttag = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--tag=\"):\r\n"]
[8798.101867, "o", "\t\t\ttag = strings.TrimPrefix(args[i], \"--tag=\")\r\n\t\tdefault:\r\n\t\t\tprintError(fmt.Sprintf(\"unknown flag: %s\", args[i]))\r\n"]
