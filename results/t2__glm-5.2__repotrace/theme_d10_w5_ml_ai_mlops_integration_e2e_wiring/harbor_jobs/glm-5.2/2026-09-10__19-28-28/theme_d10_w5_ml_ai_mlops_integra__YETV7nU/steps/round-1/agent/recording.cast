[5326.220369, "o", "\u001b[?2004h> "]
[5326.220468, "o", "        return nil, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.220556, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.220658, "o", "    return run, nil\r\n\u001b[?2004l\r"]
[5326.220744, "o", "\u001b[?2004h> }"]
[5326.220836, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5326.221426, "o", "func (e *Executor) executeStageCached(name string, fold, k int, runArtifacts map[string]*ArtifactOutput) bool {\r\n\u001b[?2004l\r"]
[5326.221493, "o", "\u001b[?2004h> "]
