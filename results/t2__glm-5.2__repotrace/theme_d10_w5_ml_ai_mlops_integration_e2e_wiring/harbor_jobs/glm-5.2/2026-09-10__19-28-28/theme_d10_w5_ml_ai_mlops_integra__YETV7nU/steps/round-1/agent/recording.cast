[3776.279264, "o", "func executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tvar ds *Dataset\r\n\tfor _, in := range inputs {\r\n\t\tif in != nil && in.Dataset != nil {\r\n\t\t\tds = in.Dataset\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif ds == nil {\r\n"]
[3776.279392, "o", "\t\treturn nil, fmt.Errorf(\"train stage %q requires input data\", stage.Name)\r\n\t}\r\n\r\n\talgorithm, ok := getString(params, \"algorithm\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires algorithm\", stage.Name)\r\n\t}\r\n\ttarget, ok := getString(params, \"target\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires target\", stage.Name)\r\n\t}\r\n\ttargetVals, err := ds.NumericColumn(target)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tclassification := isBinary01(targetVals)\r\n\tif algorithm == \"linear-regression\" {\r\n\t\tclassification = false\r\n\t}\r\n\tif algorithm == \"logistic-regression\" {\r\n\t\tclassification = true"]
[3776.279469, "o", "\r\n\t}\r\n\r\n\tfeatures, ok := getStringSlice(params, \"features\")\r\n\tif !ok || len(features) == 0 {\r\n\t\tfeatures = []string{}\r\n\t\tfor i, col := range ds.Columns {\r\n\t\t\tif col == target {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif i < len(ds.Types) && ds.Types[i] == \"numeric\" {\r\n\t\t\t\tfeatures = append(features, col)\r\n"]
[3776.279529, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\tX, err := ds.featureMatrix(features)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\ty := targetVals\r\n\r\n\thp := getMapDefault(params, \"hyperparams\", map[string]interface{}{})\r\n\t"]
[3776.279591, "o", "model := &Model{Algorithm: algorithm, Target: target, Features: features, Hyperparams: hp, Classification: classification, TrainFeatures: X, TrainTarget: y}\r\n\r\n\tswitch algorithm {\r\n\tcase \"linear-regression\":\r\n\t\tw, err := trainLinearRegression(X, y)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tmodel.LinearWeights = w\r\n\tcase \"logistic-regression\":\r\n\t\t"]
[3776.27965, "o", "lr := getFloatDefault(hp, \"learning_rate\", 0.01)\r\n\t\tepochs := getIntDefault(hp, \"epochs\", 1000)\r\n\t\tw, err := trainLogisticRegression(X, y, lr, epochs)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tmodel.LogisticWeights = w\r\n\tcase \"decision-tree\":\r\n"]
[3776.279717, "o", "\t\tmaxDepth := getIntDefault(hp, \"max_depth\", 10)\r\n\t\tminSplit := getIntDefault(hp, \"min_samples_split\", 2)\r\n\t\tmodel.Tree = trainDecisionTree(X, y, features, classification, 0, maxDepth, minSplit)\r\n\tcase \"random-forest\":\r\n\t\tnEst := getIntDefault(hp, \"n_estimators\", 10)\r\n\t\tmaxDepth := getIntDefault(hp, \"max_depth\", 10)\r\n\t\tmaxFeatures := getStringDefault(hp, \"max_features\", \"sqrt\")\r\n\t\tmodel.Forest = trainRandomForest(X, y, features, classification, nEst, maxDepth, maxFeatures, stage.Name)\r\n\tcase \"gradient-boost\":\r\n\t\tnEst := getIntDefault(hp, \"n_estimators\", 100)\r\n"]
[3776.279776, "o", "\t\tlr := getFloatDefault(hp, \"learning_rate\", 0.1)\r\n\t\tmaxDepth := getIntDefault(hp, \"max_depth\", 3)\r\n\t\tmodel.Boost = trainGradientBoost(X, y, classification, nEst, lr, maxDepth)\r\n\tcase \"knn\":\r\n\t\tk := getIntDefault(hp, \"k\", 5)\r\n\t\tif k <= 0 {\r\n\t\t\tk = 1\r\n\t\t}\r\n"]
[3776.279883, "o", "\t\tmodel.KNN = &KNNModel{K: k, Features: X, Targets: y, Classification: classification}\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"unsupported algorithm: %s\", algorithm)\r\n\t}\r\n\r\n\tpreds := model.PredictBatch(X)\r\n\tpredRows := make([][]string, len(ds.Rows))\r\n\tfor i := range ds.Rows {\r\n\t\trow := append([]string{}, ds.Rows[i]...)\r\n\t\trow = append(row, formatFloat(preds[i]))\r\n\t\tpredRows[i] = row\r\n\t}\r\n\tpredDS := &Dataset{\r\n\t\tColumns: append(append([]string{}, ds.Columns...), \"prediction\"),\r\n\t\tTypes:   append(append([]string{}, ds.Types...), \"numeric\"),\r\n\t\tRows:    predRows,\r\n\t}\r\n"]
[3776.279941, "o", "\r\n\treturn map[string]*ArtifactValue{\"model\": {Model: model}, \"predictions\": {Dataset: predDS}}, nil\r\n}\r\n\r\nfunc isBinary01(vals []float64) bool {\r\n\tfor _, v := range vals {\r\n\t\tif v != 0 && v != 1 {\r\n\t\t\treturn false\r\n"]
