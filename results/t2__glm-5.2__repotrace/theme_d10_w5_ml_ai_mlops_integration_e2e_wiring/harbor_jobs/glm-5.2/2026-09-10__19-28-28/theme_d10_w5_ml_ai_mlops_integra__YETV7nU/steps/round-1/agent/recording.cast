[12565.624818, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('config.go')\ns = p.read_text()\nold = '''\t\tif s.Type == \"ensemble\" {\n\t\t\tmodels, ok := s.Inputs[\"models\"]\n\t\t\tif !ok {\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires inputs.models\", s.Name))\n\t\t\t} else if refs, ok := inputRefs(models); !ok || len(refs) < 2 {\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires at least 2 model inputs\", s.Name))\n\t\t\t}\n\t\t\tif _, ok := s.Inputs[\"data\"]; !ok {\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires inputs.data\", s.Name))\n\t\t\t}\n'''\nnew = '''\t\tif s.Type == \"ensemble\" {\n\t\t\tmodelInputCount := 0\n\t\t\tfor local := range s.Inputs {\n\t\t\t\tif strings.HasPrefix(local, \"model_\") {\n\t\t\t\t\tmodelInputCount++\n\t\t\t\t}\n\t\t\t}\n\t\t\tif models, ok := s.Inputs[\"models\"]; ok {\n\t\t\t\tif refs, ok := inputRefs(models); ok {\n\t\t\t\t\tmodelInputCount += len(refs)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif modelInputCount < 2 {\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"stage '%s' ensemble requires at least 2 model inputs\", s.Name))\n\t\t\t}\n\t\t\tif _"]
[12565.625081, "i", ", ok := s.Inputs[\"data\"]; !ok {\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"ensemble stage %q requires inputs.data\", s.Name))\n\t\t\t}\n'''\nif old not in s:\n    raise SystemExit('ensemble validation count block not found')\np.write_text(s.replace(old, new))\nPY\n"]
[12565.625133, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r, ok := s.Inputs[\"data\"]; !ok {\r\n\t\t\t\terrors = append(err"]
