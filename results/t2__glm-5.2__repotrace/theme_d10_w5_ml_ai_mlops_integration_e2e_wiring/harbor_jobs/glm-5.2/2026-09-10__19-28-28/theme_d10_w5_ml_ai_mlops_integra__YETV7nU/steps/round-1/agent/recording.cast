[10912.632765, "o", "\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"--param requires key=value\")\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tcase strings.HasPrefix(args[i], \"--param=\"):\r\n\t\t\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n"]
[10912.632828, "o", "\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"--param requires key=value\")\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tcase args[i] == \"--skip-stage\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"--skip-stage requires a value\")\r\n\t\t\t}\r\n\t\t\tskipStages = append(skipStages, args[i+1])\r\n"]
[10912.632892, "o", "\t\t\ti++\r\n\t\tcase strings.HasPrefix(args[i], \"--skip-stage=\"):\r\n\t\t\tskipStages = append(skipStages, strings.TrimPrefix(args[i], \"--skip-stage=\"))\r\n\t\tdefault:\r\n\t\t\tif configPath == \"\" && !strings.HasPrefix(args[i], \"--\") {\r\n\t\t\t\tconfigPath = args[i]\r\n"]
[10912.632951, "o", "\t\t\t} else {\r\n\t\t\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"unknown flag: %s\", args[i])\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif configPath == \"\" {\r\n\t\treturn \"\", nil, 0, false, nil, fmt.Errorf(\"usage: mlpipe run <config.json> [--param key=value ...] [--cv K] [--no-cache] [--skip-stage name ...]\")\r\n\t}\r\n\treturn configPath, overrides, cv, noCache, skipStages, nil\r\n}\r\n\r\nfunc parsePlanArgs(args []string) (string, map[string]string, int, error) {\r\n\tconfigPath := \"\"\r\n\toverrides := map[string]string{}\r\n\tcv := 0\r\n\tfor i := 0; i < len(args); i++ {\r\n"]
[10912.633016, "o", "\t\tswitch {\r\n\t\tcase args[i] == \"--cv\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn \"\", nil, 0, fmt.Errorf(\"--cv requires a value\")\r\n\t\t\t}\r\n\t\t\tk, err := strconv.Atoi(args[i+1])\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn \"\", nil, 0, fmt.Errorf(\"invalid cv folds: %s\", args[i+1])\r\n"]
