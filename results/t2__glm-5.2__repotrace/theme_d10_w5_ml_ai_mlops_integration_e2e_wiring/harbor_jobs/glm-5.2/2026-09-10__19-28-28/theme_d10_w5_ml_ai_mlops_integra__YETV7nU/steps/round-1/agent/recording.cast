[12707.092329, "o", "return map[string]*ArtifactValue{\"data\": {Dataset: ds}}, nil\r\n   374\t}\r\n   375\t\r\n   376\tfunc (c *Config) topologicalOrder() ([]string, error) {\r\n   377\t\tindeg := map[string]int{}\r\n   378\t\tadj := map[string][]string{}\r\n   379\t\tfor _, s := range c.Stages {\r\n   380\t\t\tindeg[s.Name] = 0\r\n   381\t\t}\r\n"]
[12707.092396, "o", "   382\t\tfor _, s := range c.Stages {\r\n   383\t\t\tfor _, dep := range s.DependsOn {\r\n   384\t\t\t\tif _, ok := c.stageByName(dep); ok {\r\n   385\t\t\t\t\tadj[dep] = append(adj[dep], s.Name)\r\n   386\t\t\t\t\tindeg[s.Name]++\r\n   387\t\t\t\t}\r\n   388\t\t\t}\r\n   389\t"]
[12707.092458, "o", "\t}\r\n   390\t\tqueue := []string{}\r\n   391\t\tfor _, s := range c.Stages {\r\n   392\t\t\tif indeg[s.Name] == 0 {\r\n   393\t\t\t\tqueue = append(queue, s.Name)\r\n   394\t\t\t}\r\n   395\t\t}\r\n   396\t\torder := []string{}"]
[12707.092519, "o", "\r\n   397\t\tfor len(queue) > 0 {\r\n   398\t\t\tnode := queue[0]\r\n   399\t\t\tqueue = queue[1:]\r\n   400\t\t\torder = append(order, node)\r\n   401\t\t\tfor _, next := range adj[node] {\r\n   402\t\t\t\tindeg[next]--\r\n   403\t\t\t\tif indeg[next] == 0 {\r\n   404\t\t\t\t\tqueue = append(queue, next)\r\n"]
[12707.092578, "o", "   405\t\t\t\t}\r\n   406\t\t\t}\r\n   407\t\t}\r\n   408\t\tif len(order) < len(c.Stages) {\r\n   409\t\t\tif cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {\r\n   410\t\t\t\treturn nil, fmt.Errorf(\"cycle detected involving stages: %s\", strings.Join(cycle, \", \"))\r\n   411\t\t\t}\r\n   412\t\t\treturn nil, fmt.Errorf(\"cycle detected involving stages: %s\", joinStageNames(c.Stages))\r\n"]
[12707.092637, "o", "   413\t\t}\r\n"]
