[10351.335826, "o", "\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tX, err := ds.feature\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K(model.Features)\r\n"]
[10351.336015, "o", "\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"accuracy\", \"precision\", \"recall\", \"f1\", \"auc\", \"logloss\", \"\u001b[01;31m\u001b[Kconfusion\u001b[m\u001b[K_\u001b[01;31m\u001b[Kmatrix\u001b[m\u001b[K\":\r\n"]
[10351.336106, "o", "\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tval, err = \u001b[01;31m\u001b[KclassificationMetric\u001b[m\u001b[K(metric, y, preds)\r\n"]
[10351.336201, "o", "\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KclassificationMetric\u001b[m\u001b[K(name string, y []float64, preds []float64) (interface{}, error) {\r\n"]
[10351.336316, "o", "\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tp, _ := \u001b[01;31m\u001b[KclassificationMetric\u001b[m\u001b[K(\"precision\", y, preds)\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tr, _ := \u001b[01;31m\u001b[KclassificationMetric\u001b[m\u001b[K(\"recall\", y, preds)\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kconfusion\u001b[m\u001b[K_\u001b[01;31m\u001b[Kmatrix\u001b[m\u001b[K\":\r\n\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tprev\u001b[01;31m\u001b[KTP\u001b[m\u001b[K := 0.0\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tprev\u001b[01;31m\u001b[KFP\u001b[m\u001b[K := 0.0\r\n\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tarea += (fp - prev\u001b[01;31m\u001b[KFP\u001b[m\u001b[K) * (tp + prev\u001b[01;31m\u001b[KTP\u001b[m\u001b[K) / 2.0\r\n\u001b[32m\u001b[K277\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tprev\u001b[01;31m\u001b[KTP\u001b[m\u001b[K = tp\r\n\u001b[32m\u001b[K278\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tprev\u001b[01;31m\u001b[KFP\u001b[m\u001b[K = fp\r\n"]
