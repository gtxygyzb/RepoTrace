[7656.634309, "o", "^Icase \"r2\":$\r\n^I^Imean := 0.0$\r\n^I^Ifor _, v := range y {$\r\n^I^I^Imean += v$\r\n^I^I}$\r\n^I^Imean /= n$\r\n^I^IssRes := 0.0$\r\n^I^IssTot := 0.0$\r\n^I^Ifor i := range y {$\r\n^I^I^IssRes += (y[i] - preds[i]) * (y[i] - preds[i])$\r\n^I^I^IssTot += (y[i] - mean) * (y[i] - mean)$\r\n^I^I}$\r\n^I^Iif ssTot == 0 {$\r\n^I^I^Ireturn 0.0, nil$\r\n^I^I}$\r\n^I^Ireturn 1 - ssRes/ssTot, nil$\r\n^Icase \"mape\":$\r\n^I^Isum := 0.0$\r\n^I^Icount := 0.0$\r\n^I^Ifor i := range y {$\r\n^I^I^Iif y[i] == 0 {$\r\n^I^I^I^Icontinue$\r\n^I^I^I}$\r\n^I^I^Isum += math.Abs((y[i] - preds[i]) / y[i])$\r\n^I^I^Icount++$\r\n^I^I}$\r\n^I^Iif count == 0 {$\r\n^I^I^Ireturn 0.0, nil$\r\n^I^I}$\r\n^I^Ireturn sum / count * 100, nil$\r\n^I}$\r\n^Ireturn nil, fmt.Errorf(\"unknown regression metric %q\", name)$\r\n}$\r\n$\r\nfunc aucROC(y []float64, scores []float64) float64 {$\r\n^Itype point struct {$\r\n"]
