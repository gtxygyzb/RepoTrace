[11404.436416, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"math/rand\"\r\n"]
[11404.436447, "o", "\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n"]
[11404.436598, "o", ")\r\n\r\ntype Model struct {\r\n\tAlgorithm       string `json:\"algorithm\"`\r\n\tTarget          string\r\n\tFeatures        []string\r\n\tHyperparams     map[string]interface{}\r\n\tClassification  bool\r\n\tLinearWeights   []float64\r\n\tLogisticWeights []float64\r\n\tTree            *TreeNode\r\n\tForest          []*TreeNode\r\n\tBoost           []*BoostedTree\r\n\tKNN             *KNNModel\r\n\tTrainFeatures   [][]float64\r\n\tTrainTarget     []float64\r\n\tEnsembleModels  []string               `json:\"ensemble_models,omitempty\"`\r\n\tModelData       map[string]interface{} `json:\"model_data,omitempty\"`\r\n}\r\n\r\ntype TreeNode struct {\r\n\tIsLeaf      bool\r\n\tPrediction  float64\r\n\tProbability float64\r\n\tFeature     int\r\n\tThreshold   float64\r\n\tLeft        *TreeNode\r\n\tRight       *TreeNode\r\n"]
[11404.436675, "o", "}\r\n\r\ntype BoostedTree struct {\r\n\tTree           *TreeNode\r\n\tLearningRate   float64\r\n\tInitPrediction float64\r\n}\r\n\r\ntype KNNModel struct {\r\n\tK              int\r\n\tFeatures       [][]float64\r\n\tTargets        []float64\r\n\tClassification bool\r\n}\r\n\r\n"]
[11404.436743, "o", "func executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tvar ds *Dataset\r\n\tfor _, in := range inputs {\r\n\t\tif in != nil && in.Dataset != nil {\r\n\t\t\tds = in.Dataset\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif ds == nil {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires input data\", stage.Name)\r\n\t}\r\n\r\n"]
[11404.436806, "o", "\talgorithm, ok := getString(params, \"algorithm\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires algorithm\", stage.Name)\r\n\t}\r\n\ttarget, ok := getString(params, \"target\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"train stage %q requires target\", stage.Name)\r\n\t}\r\n\ttargetVals, err := ds.NumericColumn(target)\r\n\tif err != nil {\r\n\t\t"]
[11404.436865, "o", "return nil, err\r\n\t}\r\n\tclassification := isBinary01(targetVals)\r\n\tif algorithm == \"linear-regression\" {\r\n\t\tclassification = false\r\n\t}\r\n\tif algorithm == \"logistic-regression\" {\r\n\t\tclassification = true\r\n\t}\r\n\r\n"]
[11404.436924, "o", "\tfeatures, ok := getStringSlice(params, \"features\")\r\n\tif !ok || len(features) == 0 {\r\n\t\tfeatures = []string{}\r\n\t\tfor i, col := range ds.Columns {\r\n\t\t\tif col == target {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\t"]
[11404.436981, "o", "if i < len(ds.Types) && ds.Types[i] == \"numeric\" {\r\n\t\t\t\tfeatures = append(features, col)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tX, err := ds.featureMatrix(features)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n"]
[11404.437041, "o", "\ty := targetVals\r\n\r\n\thp := getMapDefault(params, \"hyperparams\", map[string]interface{}{})\r\n\tmodel := &Model{Algorithm: algorithm, Target: target, Features: features, Hyperparams: hp, Classification: classification, TrainFeatures: X, TrainTarget: y}\r\n\r\n\tswitch algorithm {\r\n\tcase \"linear-regression\":\r\n\t\tw, err := trainLinearRegression(X, y)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n"]
[11404.437109, "o", "\t\t}\r\n\t\tmodel.LinearWeights = w\r\n\tcase \"logistic-regression\":\r\n\t\tlr := getFloatDefault(hp, \"learning_rate\", 0.01)\r\n\t\tepochs := getIntDefault(hp, \"epochs\", 1000)\r\n\t\t"]
[11404.437171, "o", "w, err := trainLogisticRegression(X, y, lr, epochs)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tmodel.LogisticWeights = w\r\n"]
[11404.437734, "o", "\u001b[?2004h"]
[11404.437792, "o", "root@n30009:/app# "]
[11404.709038, "i", "sed -n '1,120p' evaluate.go\n"]
[11404.709341, "o", "sed -n '1,120p' evaluate.go\r\n\u001b[?2004l\r"]
[11404.71226, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"sort\"\r\n"]
[11404.712322, "o", ")\r\n\r\ntype Report struct {\r\n\tMetrics map[string]interface{} `json:\"metrics\"`\r\n\tPass    bool                   `json:\"pass\"`\r\n}\r\n\r\nfunc executeEvaluate(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tmodelVal := inputs[\"model\"]\r\n"]
[11404.712383, "o", "\tif modelVal == nil || modelVal.Model == nil {\r\n\t\treturn nil, fmt.Errorf(\"evaluate stage %q requires model input\", stage.Name)\r\n\t}\r\n\tds := inputDataset(inputs)\r\n\tif ds == nil {\r\n\t\treturn nil, fmt.Errorf(\"evaluate stage %q requires data input\", stage.Name)\r\n\t}\r\n"]
[11404.712436, "o", "\tmodel := modelVal.Model\r\n\r\n\tmetrics, ok := getStringSlice(params, \"metrics\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"evaluate stage %q requires metrics\", stage.Name)\r\n\t}\r\n\tthreshold, _ := getMap(params, \"threshold\")\r\n\r\n\ty, err := ds.NumericColumn(model.Target)\r\n\tif err != nil {\r\n"]
[11404.712487, "o", "\t\treturn nil, err\r\n\t}\r\n\tX, err := ds.featureMatrix(model.Features)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tpreds := model.PredictBatch(X)\r\n\tclassification := isBinary01(y)\r\n\r\n"]
[11404.712537, "o", "\treport := &Report{Metrics: map[string]interface{}{}, Pass: true}\r\n\r\n\tfor _, metric := range metrics {\r\n\t\tvar val interface{}\r\n\t\tvar err error\r\n\t\tswitch metric {\r\n\t\tcase \"accuracy\", \"precision\", \"recall\", \"f1\", \"auc\", \"logloss\", \"confusion_matrix\":\r\n\t\t\tif !classification {\r\n\t"]
[11404.712592, "o", "\t\t\terr = fmt.Errorf(\"metric %q requires binary 0/1 target\", metric)\r\n\t\t\t} else {\r\n\t\t\t\tval, err = classificationMetric(metric, y, preds)\r\n\t\t\t}\r\n\t\tcase \"mse\", \"rmse\", \"mae\", \"r2\", \"mape\":\r\n\t\t\tif classification {\r\n\t\t\t\terr = fmt.Errorf(\"metric %q requires regression target\", metric)\r\n"]
[11404.712642, "o", "\t\t\t} else {\r\n\t\t\t\tval, err = regressionMetric(metric, y, preds)\r\n\t\t\t}\r\n\t\tdefault:\r\n\t\t\terr = fmt.Errorf(\"unknown metric %q\", metric)\r\n\t\t}\r\n\t"]
[11404.712693, "o", "\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treport.Metrics[metric] = val\r\n\t}\r\n\r\n\tif threshold != nil {\r\n"]
[11404.712742, "o", "\t\tfor metricName, thresholdVal := range threshold {\r\n\t\t\tmetricValue, ok := report.Metrics[metricName]\r\n\t\t\tif !ok {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tfv, ok := toFloat64(metricValue)\r\n\t\t\tif !ok {\r\n\t"]
[11404.712794, "o", "\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\ttv, ok := toFloat64(thresholdVal)\r\n\t\t\tif !ok {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
[11404.712842, "o", "\t\t\tif fv < tv {\r\n\t\t\t\treport.Pass = false\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\treturn map[string]*ArtifactValue{\"report\": {Report: report}}, nil\r\n}\r\n\r\n"]
[11404.712888, "o", "func classificationMetric(name string, y []float64, preds []float64) (interface{}, error) {\r\n\tlabels := make([]int, len(preds))\r\n\tfor i, p := range preds {\r\n\t\tif p >= 0.5 {\r\n\t\t\tlabels[i] = 1\r\n\t\t} else {\r\n\t\t\tlabels[i] = 0\r\n"]
[11404.712939, "o", "\t\t}\r\n\t}\r\n\tswitch name {\r\n\tcase \"accuracy\":\r\n\t\tcorrect := 0\r\n\t\tfor i := range y {\r\n\t\t\tif labels[i] == int(y[i]) {\r\n"]
[11404.712988, "o", "\t\t\t\tcorrect++\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn float64(correct) / float64(len(y)), nil\r\n\tcase \"precision\":\r\n\t\ttp, fp := 0, 0\r\n\t\tfor i := range y {\r\n\t"]
[11404.713037, "o", "\t\tif labels[i] == 1 {\r\n\t\t\t\tif y[i] == 1 {\r\n\t\t\t\t\ttp++\r\n\t\t\t\t} else {\r\n\t\t\t\t\tfp++\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n"]
[11404.713568, "o", "\u001b[?2004h"]
[11404.713616, "o", "root@n30009:/app# "]
