[1059.448181, "i", "cat > split.go <<'EOF'\npackage main\n\nimport (\n    \"fmt\"\n    \"math/rand\"\n)\n\nfunc executeSplit(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\n    var ds *Dataset\n    for _, in := range inputs {\n        if in != nil && in.Dataset != nil {\n            ds = in.Dataset\n            break\n        }\n    }\n    if ds == nil {\n        return nil, fmt.Errorf(\"split stage %q requires input data\", stage.Name)\n    }\n\n    ratio, ok := getFloat(params, \"ratio\")\n    if !ok || ratio <= 0 || ratio >= 1 {\n        return nil, fmt.Errorf(\"split stage %q requires ratio in (0,1)\", stage.Name)\n    }\n    seed, ok := getInt(params, \"seed\")\n    if !ok {\n        seed = 0\n    }\n    stratify, _ := getString(params, \"stratify\")\n\n    train := ds.Copy()\n    train.Rows = nil\n    test := ds.Copy()\n    test.Rows = nil\n\n    appendRow := func(dst *Dataset, src []string) {\n        dst.Rows = append(dst.Rows, append([]string{}, src...))\n    }\n\n    if stratify == \"\" {\n        pe"]
[1059.448449, "i", "rm := rand.New(rand.NewSource(int64(seed))).Perm(len(ds.Rows))\n        trainCount := int(float64(len(ds.Rows)) * ratio)\n        for i, idx := range perm {\n            if i < trainCount {\n                appendRow(train, ds.Rows[idx])\n            } else {\n                appendRow(test, ds.Rows[idx])\n            }\n        }\n    } else {\n        idx, ok := ds.ColumnIndex(stratify)\n        if !ok {\n            return nil, fmt.Errorf(\"stratify column not found: %s\", stratify)\n        }\n        classes := map[string][]int{}\n        for i, row := range ds.Rows {\n            val := \"\"\n            if idx < len(row) {\n                val = row[idx]\n            }\n            classes[val] = append(classes[val], i)\n        }\n        classNames := make([]string, 0, len(classes))\n        for c := range classes {\n            classNames = append(classNames, c)\n        }\n        // deterministic class order\n        sortStrings(classNames)\n        rng := rand.New(rand.NewSource(int64(seed)))\n        for _, c := range className"]
[1059.448529, "o", "cat > split.go <<'EOF'\r\n\u001b[?2004l\r"]
[1059.448605, "i", "s {\n            rows := classes[c]\n            perm := rng.Perm(len(rows))\n            trainCount := int(float64(len(rows)) * ratio)\n            for i, p := range perm {\n                srcIdx := rows[p]\n                if i < trainCount {\n                    appendRow(train, ds.Rows[srcIdx])\n                } else {\n                    appendRow(test, ds.Rows[srcIdx])\n                }\n            }\n        }\n    }\n\n    return map[string]*ArtifactValue{\"train\": {Dataset: train}, \"test\": {Dataset: test}}, nil\n}\n\nfunc sortStrings(s []string) {\n    for i := 1; i < len(s); i++ {\n        for j := i; j > 0 && s[j-1] > s[j]; j-- {\n            s[j-1], s[j] = s[j], s[j-1]\n        }\n    }\n}\nEOF\n"]
