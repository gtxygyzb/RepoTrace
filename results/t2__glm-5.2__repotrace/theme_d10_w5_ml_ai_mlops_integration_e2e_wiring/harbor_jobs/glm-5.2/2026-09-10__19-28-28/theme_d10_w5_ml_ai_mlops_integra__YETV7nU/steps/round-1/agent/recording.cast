[10738.243328, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6"]
[10738.24341, "o", "\t\t\"math\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"time\"\r\n    11\t)\r\n    12\t\r\n    13\ttype RegistryEntry struct {\r\n    14\t\tName           string                 `json:\"name\"`\r\n    15\t\tVersion        int                    `json:\"version\"`\r\n    16\t\tStage          string                 `json:\"stage\"`\r\n    17\t\t"]
[10738.243485, "o", "Tags           []string               `json:\"tags\"`\r\n    18\t\tMetrics        map[string]interface{} `json:\"metrics\"`\r\n    19\t\tHyperparams    map[string]interface{} `json:\"hyperparams\"`\r\n    20\t\tArtifactRefs   map[string]string      `json:\"artifact_refs\"`\r\n"]
[10738.243553, "o", "    21\t\tPromotionRules map[string]interface{} `json:\"promotion_rules\"`\r\n    22\t\tRegisteredAt   string                 `json:\"registered_at\"`\r\n    23\t}\r\n    24\t\r\n    25\tfunc executeRegister(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n    26\t\tmodelVal := inputs[\"model\"]\r\n    27\t\tif modelVal == nil || modelVal.Model == nil {\r\n    28\t\t\treturn nil, fmt.Errorf(\"register stage %q requires model input\", stage.Name)\r\n    29\t\t}\r\n    30\t\treportVal := inputs[\"report\"]\r\n    31\t\tif reportVal == nil || reportVal.Report == nil {\r\n    32\t\t\treturn nil, fmt.Errorf(\"register stage %q requires report input\", stage.Name)\r\n    33\t\t}\r\n    34\t\r\n    35\t\tname, ok := getString(params, \"model_name\")"]
[10738.243619, "o", "\r\n    36\t\tif !ok {\r\n    37\t\t\treturn nil, fmt.Errorf(\"register stage %q requires model_name\", stage.Name)\r\n    38\t\t}\r\n    39\t\ttags, _ := getStringSlice(params, \"tags\")\r\n"]
[10738.243686, "o", "    40\t\tif tags == nil {\r\n    41\t\t\ttags = []string{}\r\n    42\t\t}\r\n    43\t\tstageName, _ := getString(params, \"stage\")\r\n    44\t\tif stageName == \"\" {\r\n    45\t\t\tstageName = \"staging\"\r\n    46\t\t}\r\n    47\t\tif stageName != \"staging\" && stageName != \"production\" {\r\n    48\t\t\treturn nil, fmt.Errorf(\"register stage %q invalid stage %q\", stage.Name, stageName)\r\n    49\t\t}\r\n    50\t\trules, _ := getMap(params, \"promotion_rules\")\r\n    51\t\r\n    52\t\tregistry, err := loadRegistry()\r\n    53\t\tif err != nil {\r\n    54\t\t"]
[10738.243752, "o", "\treturn nil, err\r\n    55\t\t}\r\n    56\t\tversion := 1\r\n    57\t\tfor _, e := range registry {\r\n    58\t\t\tif e.Name == name && e.Version >= version {\r\n    59\t\t\t\tversion = e.Version + 1\r\n    60\t\t\t}\r\n    61\t\t}\r\n    62\t\r\n    63\t\tentry := &RegistryEntry{\r\n"]
