[10923.406521, "o", "\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Config) global\u001b[01;31m\u001b[KParams\u001b[m\u001b[K(overrides map[string]string) map[string]interface{} {\r\n\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor k, v := range c.\u001b[01;31m\u001b[KPipeline\u001b[m\u001b[K.\u001b[01;31m\u001b[KParams\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc merge\u001b[01;31m\u001b[KParams\u001b[m\u001b[K(params map[string]interface{}, overrides map[string]string) map[string]interface{} {\r\n"]
[10923.406593, "o", "\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Config) stage\u001b[01;31m\u001b[KParams\u001b[m\u001b[K(name string, globals map[string]interface{}) map[string]interface{} {\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, s := range c.\u001b[01;31m\u001b[KStages\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif s.\u001b[01;31m\u001b[KParams\u001b[m\u001b[K == nil {\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tres := substituteValue(s.\u001b[01;31m\u001b[KParams\u001b[m\u001b[K, globals)\r\n"]
[10923.406659, "o", "\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor i := range c.\u001b[01;31m\u001b[KStages\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif c.\u001b[01;31m\u001b[KStages\u001b[m\u001b[K[i].Name == name {\r\n\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn &c.\u001b[01;31m\u001b[KStages\u001b[m\u001b[K[i], true\r\n\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc validStage\u001b[01;31m\u001b[KType\u001b[m\u001b[K(t string) bool {\r\n"]
[10923.406724, "o", "\u001b[32m\u001b[K170\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor i, s := range c.\u001b[01;31m\u001b[KStages\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, s := range c.\u001b[01;31m\u001b[KStages\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K181\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif !validStage\u001b[01;31m\u001b[KType\u001b[m\u001b[K(s.\u001b[01;31m\u001b[KType\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\terrors = append(errors, fmt.Sprintf(\"stage %q has unknown type %q\", s.Name, s.\u001b[01;31m\u001b[KType\u001b[m\u001b[K))\r\n\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, dep := range s.\u001b[01;31m\u001b[KDependsOn\u001b[m\u001b[K {\r\n"]
[10923.406789, "o", "\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor local, ref := range s.\u001b[01;31m\u001b[KInputs\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K210\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tports := validOutputPorts(refStage.\u001b[01;31m\u001b[KType\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif s.\u001b[01;31m\u001b[KType\u001b[m\u001b[K == \"ensemble\" && local == \"models\" {\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif s.\u001b[01;31m\u001b[KType\u001b[m\u001b[K == \"ensemble\" {\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tmodels, ok := s.\u001b[01;31m\u001b[KInputs\u001b[m\u001b[K[\"models\"]\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif _, ok := s.\u001b[01;31m\u001b[KInputs\u001b[m\u001b[K[\"data\"]; !ok {\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tstrategy, _ := getString(s.\u001b[01;31m\u001b[KParams\u001b[m\u001b[K, \"strategy\")\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif _, ok := getString(s.\u001b[01;31m\u001b[KParams\u001b[m\u001b[K, \"target\"); !ok {"]
[10923.406872, "o", "\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, s := range c.\u001b[01;31m\u001b[KStages\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tadj[s.Name] = append(adj[s.Name], s.\u001b[01;31m\u001b[KDependsOn\u001b[m\u001b[K...)\r\n"]
