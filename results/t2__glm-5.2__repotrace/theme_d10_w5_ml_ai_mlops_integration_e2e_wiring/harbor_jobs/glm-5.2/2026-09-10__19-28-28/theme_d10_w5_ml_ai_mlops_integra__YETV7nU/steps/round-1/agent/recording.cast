[11395.347097, "o", "   300\t\r\n   301\tfunc (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {\r\n   302\t\tinputs := map[string]*ArtifactValue{}\r\n   303\t\tids := []string{}\r\n   304\t\tfor local, ref := range stage.Inputs {\r\n   305\t\t\trefs, ok := inputRefs(ref)\r\n   306\t\t\tif !ok {\r\n   307\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q has invalid reference %v\", stage.Name, local, ref)\r\n"]
[11395.347198, "o", "   308\t\t\t}\r\n   309\t\t\tvar firstVal *ArtifactValue\r\n   310\t\t\tfor _, r := range refs {\r\n   311\t\t\t\tparts := strings.SplitN(r, \".\", 2)\r\n   312\t\t\t\tif len(parts) != 2 {\r\n   313\t\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q has invalid input reference %q\", stage.Name, r)\r\n   314\t\t\t\t}\r\n   315\t\t\t\tdepStage, port := parts[0], parts[1]\r\n   316\t\t\t\tid, ok := e.outputs[depStage][port]\r\n   317\t\t\t\tif !ok {\r\n   318\t\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable output %s.%s\", stage.Name, local, depStage, port)\r\n   319\t\t\t\t}\r\n"]
[11395.347283, "o", "   320\t\t\t\tval, ok := e.values[depStage][port]\r\n   321\t\t\t\tif !ok || val == nil {\r\n   322\t\t\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable artifact %s.%s\", stage.Name, local, depStage, port)\r\n   323\t\t\t\t}\r\n   324\t\t\t\tids = append(ids, id)\r\n   325\t\t\t\tif firstVal == nil {\r\n   326\t\t\t\t\tfirstVal = val\r\n   327\t\t\t\t}\r\n   328\t\t\t\tif stage.Type == \"ensemble\" && local == \"models\" {\r\n"]
[11395.347348, "o", "   329\t\t\t\t\tinputs[local+\"_\"+r] = val\r\n   330\t\t\t\t}\r\n   331\t\t\t}\r\n   332\t\t\tif _, exists := inputs[local]; !exists {\r\n   333\t\t\t\tinputs[local] = firstVal\r\n   334\t\t\t}\r\n   335\t\t}\r\n   336\t\treturn inputs, ids, nil\r\n   337\t}\r\n   338\t\r\n"]
[11395.347409, "o", "   339\tfunc executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n   340\t\tswitch stage.Type {\r\n   341\t\tcase \"data-source\":\r\n   342\t\t\treturn executeDataSource(stage, params, inputs)\r\n   343\t\tcase \"transform\":\r\n   344\t\t\treturn executeTransform(stage, params, inputs)\r\n   345\t\tcase \"split\":\r\n"]
[11395.347471, "o", "   346\t\t\treturn executeSplit(stage, params, inputs)\r\n   347\t\tcase \"train\":\r\n   348\t\t\treturn executeTrain(stage, params, inputs)\r\n   349\t\tcase \"evaluate\":\r\n   350\t\t\treturn executeEvaluate(stage, params, inputs)\r\n   351\t\tcase \"register\":\r\n   352\t\t\treturn executeRegister(stage, params, inputs)\r\n   353\t\tcase \"ensemble\":\r\n   354\t\t\treturn executeEnsemble(stage, params, inputs)\r\n   355\t\t}"]
[11395.34753, "o", "\r\n   356\t\treturn nil, fmt.Errorf(\"unknown stage type %q\", stage.Type)\r\n   357\t}\r\n   358\t\r\n   359\tfunc executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n   360\t\tpath, ok := getString(params, \"path\")\r\n   361\t\tif !ok {\r\n   362\t\t\treturn nil, fmt.Errorf(\"data-source stage %q requires path\", stage.Name)\r\n   363"]
[11395.347588, "o", "\t\t}\r\n   364\t\tschema, _ := getMap(params, \"schema\")\r\n   365\t\tds, err := loadDataset(path, schema)\r\n   366\t\tif err != nil {\r\n   367\t\t\treturn nil, err\r\n   368\t\t}\r\n   369\t\treturn map[string]*ArtifactValue{\"data\": {Dataset: ds}}, nil\r\n   370\t}\r\n"]
[11395.347678, "o", "   371\t\r\n   372\tfunc (c *Config) topologicalOrder() ([]string, error) {\r\n   373\t\tindeg := map[string]int{}\r\n   374\t\tadj := map[string][]string{}\r\n   375\t\tfor _, s := range c.Stages {"]
[11395.347749, "o", "\r\n   376\t\t\tindeg[s.Name] = 0\r\n   377\t\t}\r\n   378\t\tfor _, s := range c.Stages {\r\n   379\t\t\tfor _, dep := range s.DependsOn {\r\n   380\t\t\t\tif _, ok := c.stageByName(dep); ok {\r\n"]
