[935.517823, "o", "\u001b[?2004h> "]
[935.518288, "o", "                scaled := (v-minCol)/(maxCol-minCol)*(maxVal-minVal) + minVal\r\n\u001b[?2004l\r"]
[935.518346, "o", "\u001b[?2004h> "]
[935.518551, "o", "                out[i] = formatFloat(scaled)\r\n\u001b[?2004l\r"]
[935.518606, "o", "\u001b[?2004h> "]
[935.518665, "o", "            }\r\n\u001b[?2004l\r"]
[935.518719, "o", "\u001b[?2004h> "]
[935.518774, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.518829, "o", "> "]
[935.519059, "o", "        ds.setColumnValues(col, out, \"numeric\")\r\n\u001b[?2004l\r"]
[935.519114, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[935.519175, "o", "\u001b[?2004h> "]
[935.519249, "o", "    return nil\r\n\u001b[?2004l\r \u001b[?2004h"]
[935.519303, "o", "> }\r\n\u001b[?2004l\r  \u001b[?2004h"]
[935.519357, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.519671, "o", "func opOneHot(ds *Dataset, op map[string]interface{}) error {\r\n\u001b[?2004l\r"]
[935.519725, "o", "\u001b[?2004h> "]
[935.51994, "o", "    cols, ok := getStringSlice(op, \"columns\")\r\n\u001b[?2004l\r"]
[935.519993, "o", "\u001b[?2004h> "]
[935.520047, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[935.520101, "o", "\u001b[?2004h> "]
[935.52034, "o", "        return fmt.Errorf(\"onehot requires columns\")\r\n\u001b[?2004l\r"]
[935.520395, "o", "\u001b[?2004h> "]
[935.520448, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.520619, "o", "    for _, col := range cols {\r\n\u001b[?2004l\r"]
[935.520674, "o", "\u001b[?2004h> "]
[935.520862, "o", "        idx, ok := ds.ColumnIndex(col)\r\n\u001b[?2004l\r"]
[935.520916, "o", "\u001b[?2004h> "]
[935.520994, "o", "        if !ok {\r\n\u001b[?2004l\r"]
[935.521047, "o", "\u001b[?2004h> "]
[935.52135, "o", "            return fmt.Errorf(\"column not found: %s\", col)\r\n\u001b[?2004l\r"]
[935.521406, "o", "\u001b[?2004h> "]
[935.521462, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.521718, "o", "        values := make([]string, len(ds.Rows))\r\n\u001b[?2004l\r"]
[935.521773, "o", "\u001b[?2004h> "]
[935.521974, "o", "        for i, row := range ds.Rows {\r\n\u001b[?2004l\r"]
[935.522029, "o", "\u001b[?2004h> "]
[935.522176, "o", "            if idx < len(row) {\r\n\u001b[?2004l\r"]
[935.52224, "o", "\u001b[?2004h> "]
[935.5224, "o", "                values[i] = row[idx]\r\n\u001b[?2004l\r"]
[935.522457, "o", "\u001b[?2004h> "]
[935.522516, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.522572, "o", "> "]
[935.522627, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.522838, "o", "        unique := uniqueStrings(values)\r\n\u001b[?2004l\r"]
[935.522892, "o", "\u001b[?2004h> "]
[935.523021, "o", "        sort.Strings(unique)\r\n\u001b[?2004l\r"]
[935.523074, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[935.523128, "o", "\u001b[?2004h> "]
[935.523458, "o", "        newCols := make([]string, 0, len(ds.Columns)-1+len(unique))\r\n\u001b[?2004l\r"]
[935.523513, "o", "\u001b[?2004h> "]
[935.523845, "o", "        newTypes := make([]string, 0, len(ds.Columns)-1+len(unique))\r\n\u001b[?2004l\r"]
[935.523899, "o", "\u001b[?2004h> "]
[935.524141, "o", "        newRows := make([][]string, len(ds.Rows))\r\n\u001b[?2004l\r"]
[935.524195, "o", "\u001b[?2004h> "]
[935.524348, "o", "        for i := range ds.Rows {\r\n\u001b[?2004l\r"]
[935.524402, "o", "\u001b[?2004h> "]
[935.524695, "o", "            newRows[i] = make([]string, 0, len(newCols))\r\n\u001b[?2004l\r"]
[935.52475, "o", "\u001b[?2004h> "]
[935.524814, "o", "        }\r\n\u001b[?2004l\r"]
[935.524868, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.525072, "o", "        for j, c := range ds.Columns {\r\n\u001b[?2004l\r"]
[935.525126, "o", "\u001b[?2004h> "]
[935.525243, "o", "            if j == idx {\r\n\u001b[?2004l\r"]
[935.525308, "o", "\u001b[?2004h> "]
[935.525495, "o", "                for _, u := range unique {\r\n\u001b[?2004l\r"]
[935.525561, "o", "\u001b[?2004h> "]
[935.52583, "o", "                    newCols = append(newCols, col+\"_\"+u)\r\n\u001b[?2004l\r"]
[935.525898, "o", "\u001b[?2004h> "]
[935.526179, "o", "                    newTypes = append(newTypes, \"numeric\")\r\n\u001b[?2004l\r"]
[935.526254, "o", "\u001b[?2004h> "]
[935.52649, "o", "                    for i, row := range ds.Rows {\r\n\u001b[?2004l\r"]
[935.526557, "o", "\u001b[?2004h> "]
[935.526708, "o", "                        val := \"\"\r\n\u001b[?2004l\r"]
[935.526774, "o", "\u001b[?2004h> "]
[935.526967, "o", "                        if idx < len(row) {\r\n\u001b[?2004l\r"]
[935.527031, "o", "\u001b[?2004h> "]
[935.527243, "o", "                            val = row[idx]\r\n\u001b[?2004l\r"]
[935.527308, "o", "\u001b[?2004h> "]
[935.527404, "o", "                        }\r\n\u001b[?2004l\r"]
[935.52747, "o", "\u001b[?2004h> "]
[935.527647, "o", "                        if val == u {\r\n\u001b[?2004l\r"]
[935.527711, "o", "\u001b[?2004h> "]
[935.528039, "o", "                            newRows[i] = append(newRows[i], \"1\")\r\n\u001b[?2004l\r"]
[935.528103, "o", "\u001b[?2004h> "]
[935.528245, "o", "                        } else {\r\n\u001b[?2004l\r"]
[935.52831, "o", "\u001b[?2004h> "]
[935.528587, "o", "                            newRows[i] = append(newRows[i], \"0\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.528653, "o", "> "]
[935.528732, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.528841, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.528927, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.529027, "o", "            } else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.52909, "o", "> "]
[935.52924, "o", "                newCols = append(newCols, c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.529449, "o", "                newTypes = append(newTypes, ds.Types[j])\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.529517, "o", "> "]
[935.529633, "o", "                for i, row := range ds.Rows {\r\n\u001b[?2004l\r="]
[935.529697, "o", "\u001b[?2004h> "]
[935.529776, "o", "                    v := \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.529854, "o", "> "]
[935.529988, "o", "                    if j < len(row) {\r\n\u001b[?2004l\r"]
[935.530053, "o", "\u001b[?2004h> "]
[935.530267, "o", "                        v = row[j]\r\n\u001b[?2004l\r"]
[935.530338, "o", "\u001b[?2004h> "]
[935.530445, "o", "                    }\r\n\u001b[?2004l\r"]
[935.53051, "o", "\u001b[?2004h> "]
[935.530854, "o", "                    newRows[i] = append(newRows[i], v)\r\n\u001b[?2004l\r"]
[935.530921, "o", "\u001b[?2004h> "]
[935.531018, "o", "                }\r\n\u001b[?2004l\r"]
[935.531083, "o", "\u001b[?2004h> "]
[935.53116, "o", "            }\r\n\u001b[?2004l\r"]
[935.531251, "o", "\u001b[?2004h> "]
[935.531325, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.531507, "o", "        ds.Columns = newCols\r\n\u001b[?2004l\r"]
[935.531578, "o", "\u001b[?2004h> "]
[935.531741, "o", "        ds.Types = newTypes\r\n\u001b[?2004l\r"]
[935.531807, "o", "\u001b[?2004h> "]
[935.531949, "o", "        ds.Rows = newRows\r\n\u001b[?2004l\r"]
[935.532015, "o", "\u001b[?2004h> "]
[935.532093, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.532202, "o", "    return nil\r\n\u001b[?2004l\r"]
[935.532282, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[935.532362, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.532806, "o", "func opLabelEncode(ds *Dataset, op map[string]interface{}) error {\r\n\u001b[?2004l\r"]
[935.53287, "o", "\u001b[?2004h> "]
[935.533089, "o", "    cols, ok := getStringSlice(op, \"columns\")\r\n\u001b[?2004l\r"]
[935.533154, "o", "\u001b[?2004h> "]
[935.533243, "o", "    if !ok {\r\n\u001b[?2004l\r|\u001b[?2004h> "]
[935.533406, "o", "        return fmt.Errorf(\"label_encode requires columns\")\r\n\u001b[?2004l\r"]
[935.533473, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[935.533592, "o", "    for _, col := range cols {\r\n\u001b[?2004l\r"]
[935.533657, "o", "\u001b[?2004h> "]
[935.533776, "o", "        vals, err := ds.ColumnValues(col)\r\n\u001b[?2004l\r"]
[935.533841, "o", "\u001b[?2004h> "]
