[6661.835028, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"math\"\r\n     6\t\t\"sort\"\r\n"]
[6661.835106, "o", "     7\t)\r\n     8\t\r\n     9\ttype Report struct {\r\n    10\t\tMetrics map[string]interface{} `json:\"metrics\"`\r\n    11\t\tPass    bool                   `json:\"pass\"`\r\n    12\t}\r\n    13\t\r\n    14\tfunc executeEvaluate(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n    15\t\tmodelVal := inputs[\"model\"]\r\n    16\t\tif modelVal == nil || modelVal.Model == nil {\r\n    17\t"]
[6661.83518, "o", "\t\treturn nil, fmt.Errorf(\"evaluate stage %q requires model input\", stage.Name)\r\n    18\t\t}\r\n    19\t\tds := inputDataset(inputs)\r\n    20\t\tif ds == nil {\r\n    21\t\t\treturn nil, fmt.Errorf(\"evaluate stage %q requires data input\", stage.Name)\r\n    22\t\t}\r\n    23\t\tmodel := modelVal.Model\r\n    24\t\r\n    25\t\tmetrics, ok := getStringSlice(params, \"metrics\")\r\n    26\t\tif !ok {\r\n"]
[6661.835281, "o", "    27\t\t\treturn nil, fmt.Errorf(\"evaluate stage %q requires metrics\", stage.Name)\r\n    28\t\t}\r\n    29\t\tthreshold, _ := getMap(params, \"threshold\")\r\n    30\t\r\n    31\t\ty, err := ds.NumericColumn(model.Target)\r\n    32\t\tif err != nil {\r\n    33\t\t\treturn nil, err\r\n    34\t\t}\r\n    35\t\tX, err := ds.featureMatrix(model.Features)\r\n    36\t\tif err != nil {\r\n    37\t\t\treturn nil, err\r\n    38\t\t}\r\n    39\t\t"]
[6661.835343, "o", "preds := model.PredictBatch(X)\r\n    40\t\tclassification := isBinary01(y)\r\n    41\t\r\n    42\t\treport := &Report{Metrics: map[string]interface{}{}, Pass: true}\r\n    43\t\r\n    44\t\tfor _, metric := range metrics {\r\n    45\t\t\tvar val interface{}\r\n    46\t\t\tvar err error\r\n"]
[6661.835406, "o", "    47\t\t\tswitch metric {\r\n    48\t\t\tcase \"accuracy\", \"precision\", \"recall\", \"f1\", \"auc\", \"logloss\", \"confusion_matrix\":\r\n    49\t\t\t\tif !classification {\r\n    50\t\t\t\t\terr = fmt.Errorf(\"metric %q requires binary 0/1 target\", metric)\r\n    51\t\t\t\t} else {\r\n    52\t\t\t\t\tval, err = classificationMetric(metric, y, preds)\r\n    53\t\t\t\t}\r\n    54\t\t\tcase \"mse\", \"rmse\", \"mae\", \"r2\", \"mape\":\r\n    55\t\t\t\tif classification {\r\n"]
[6661.835466, "o", "    56\t\t\t\t\terr = fmt.Errorf(\"metric %q requires regression target\", metric)\r\n    57\t\t\t\t} else {\r\n    58\t\t\t\t\tval, err = regressionMetric(metric, y, preds)\r\n    59\t\t\t\t}\r\n    60\t\t\tdefault:\r\n    61\t\t\t\terr = fmt.Errorf(\"unknown metric %q\", metric)\r\n    62\t\t\t}\r\n"]
[6661.835529, "o", "    63\t\t\tif err != nil {\r\n    64\t\t\t\treturn nil, err\r\n    65\t\t\t}\r\n    66\t\t\treport.Metrics[metric] = val\r\n    67\t\t}\r\n    68\t\r\n    69\t\tif threshold != nil {\r\n    70\t\t\tfor metricName, thresholdVal := range threshold {\r\n    71\t\t\t\tmetricValue, ok := report.Metrics[metricName]\r\n    72\t\t"]
[6661.835586, "o", "\t\tif !ok {\r\n    73\t\t\t\t\tcontinue\r\n    74\t\t\t\t}\r\n    75\t\t\t\tfv, ok := toFloat64(metricValue)\r\n    76\t\t\t\tif !ok {\r\n    77\t\t\t\t\tcontinue\r\n    78\t\t\t\t}\r\n    79\t\t\t\ttv, ok := toFloat64(thresholdVal)\r\n    80\t\t\t\tif !ok {\r\n"]
[6661.835644, "o", "    81\t\t\t\t\tcontinue\r\n    82\t\t\t\t}\r\n    83\t\t\t\tif fv < tv {\r\n    84\t\t\t\t\treport.Pass = false\r\n    85\t\t\t\t}\r\n    86\t\t\t}\r\n    87\t\t}\r\n    88\t\r\n"]
[6661.835701, "o", "    89\t\treturn map[string]*ArtifactValue{\"report\": {Report: report}}, nil\r\n    90\t}\r\n    91\t\r\n    92\tfunc classificationMetric(name string, y []float64, preds []float64) (interface{}, error) {\r\n    93\t\tlabels := make([]int, len(preds))\r\n    94\t\tfor i, p := range preds {\r\n"]
[6661.835763, "o", "    95\t\t\tif p >= 0.5 {\r\n    96\t\t\t\tlabels[i] = 1\r\n    97\t\t\t} else {\r\n    98\t\t\t\tlabels[i] = 0\r\n    99\t\t\t}\r\n   100\t\t}\r\n   101\t\tswitch name {\r\n   102\t\tcase \"accuracy\":\r\n   103\t\t\tcorrect := 0\r\n   104\t\t\t"]
[6661.83582, "o", "for i := range y {\r\n   105\t\t\t\tif labels[i] == int(y[i]) {\r\n   106\t\t\t\t\tcorrect++\r\n   107\t\t\t\t}\r\n   108\t\t\t}\r\n   109\t\t\treturn float64(correct) / float64(len(y)), nil\r\n   110\t\tcase \"precision\":\r\n   111\t\t\ttp, fp := 0, 0\r\n"]
[6661.83589, "o", "   112\t\t\tfor i := range y {\r\n   113\t\t\t\tif labels[i] == 1 {\r\n   114\t\t\t\t\tif y[i] == 1 {\r\n   115\t\t\t\t\t\ttp++\r\n   116\t\t\t\t\t} else {\r\n"]
[6661.835951, "o", "   117\t\t\t\t\t\tfp++\r\n   118\t\t\t\t\t}\r\n   119\t\t\t\t}\r\n   120\t\t\t}\r\n   121\t\t\tif tp+fp == 0 {\r\n   122\t\t\t\treturn 0.0, nil\r\n   123\t\t\t}\r\n   124\t\t\treturn float64(tp) / float64(tp+fp), nil\r\n   125\t\tcase \"recall\":\r\n   126\t\t\ttp, fn := 0, 0\r\n   127\t\t\tfor i := range y {\r\n   128\t\t\t\tif y[i] == 1 {\r\n"]
[6661.836013, "o", "   129\t\t\t\t\tif labels[i] == 1 {\r\n   130\t\t\t\t\t\ttp++\r\n   131\t\t\t\t\t} else {\r\n   132\t\t\t\t\t\tfn++\r\n   133\t\t\t\t\t}\r\n   134\t\t\t\t}\r\n   135\t\t\t}\r\n   136\t\t\tif tp+fn == 0 {\r\n"]
[6661.83607, "o", "   137\t\t\t\treturn 0.0, nil\r\n   138\t\t\t}\r\n   139\t\t\treturn float64(tp) / float64(tp+fn), nil\r\n   140\t\tcase \"f1\":\r\n   141\t\t\tp, _ := classificationMetric(\"precision\", y, preds)\r\n   142\t\t\tr, _ := classificationMetric(\"recall\", y, preds)\r\n   143\t\t\tpf := p.(float64)\r\n"]
[6661.836126, "o", "   144\t\t\trf := r.(float64)\r\n   145\t\t\tif pf+rf == 0 {\r\n   146\t\t\t\treturn 0.0, nil\r\n   147\t\t\t}\r\n   148\t\t\treturn 2 * pf * rf / (pf + rf), nil\r\n   149\t\tcase \"auc\":\r\n   150\t\t\treturn aucROC(y, preds), nil\r\n   151\t\tcase \"logloss\":\r\n   152"]
[6661.836188, "o", "\t\t\tsum := 0.0\r\n   153\t\t\tfor i := range y {\r\n   154\t\t\t\tp := clamp(preds[i], 1e-15, 1-1e-15)\r\n   155\t\t\t\tsum += y[i]*math.Log(p) + (1-y[i])*math.Log(1-p)\r\n   156\t\t\t}\r\n   157\t\t\treturn -sum / float64(len(y)), nil\r\n   158\t\tcase \"confusion_matrix\":\r\n   159\t"]
[6661.836259, "o", "\t\ttp, fp, tn, fn := 0, 0, 0, 0\r\n   160\t\t\tfor i := range y {\r\n   161\t\t\t\tif labels[i] == 1 && y[i] == 1 {\r\n   162\t\t\t\t\ttp++\r\n   163\t\t\t\t} else if labels[i] == 1 && y[i] == 0 {\r\n   164\t\t\t\t\tfp++\r\n   165\t\t\t\t} else if labels[i] == 0 && y[i] == 0 {\r\n   166\t\t\t\t\ttn++\r\n   167\t\t\t\t} else {\r\n   168"]
[6661.836317, "o", "\t\t\t\t\tfn++\r\n   169\t\t\t\t}\r\n   170\t\t\t}\r\n   171\t\t\treturn map[string]int{\"tp\": tp, \"fp\": fp, \"tn\": tn, \"fn\": fn}, nil\r\n   172\t\t}\r\n   173\t\treturn nil, fmt.Errorf(\"unknown classification metric %q\", name)\r\n   174\t}\r\n   175\t\r\n   176\t"]
[6661.836384, "o", "func regressionMetric(name string, y []float64, preds []float64) (interface{}, error) {\r\n   177\t\tn := float64(len(y))\r\n   178\t\tswitch name {\r\n   179\t\tcase \"mse\":\r\n   180\t\t\tsum := 0.0\r\n   181\t\t\tfor i := range y {\r\n   182\t\t\t\td := y[i] - preds[i]\r\n   183\t\t\t\tsum += d * d\r\n   184\t\t\t}\r\n"]
[6661.836441, "o", "   185\t\t\treturn sum / n, nil\r\n   186\t\tcase \"rmse\":\r\n   187\t\t\tmse, _ := regressionMetric(\"mse\", y, preds)\r\n   188\t\t\treturn math.Sqrt(mse.(float64)), nil\r\n   189\t\tcase \"mae\":\r\n   190\t\t\tsum := 0.0\r\n   191\t\t\tfor i := range y {\r\n"]
[6661.836497, "o", "   192\t\t\t\tsum += math.Abs(y[i] - preds[i])\r\n   193\t\t\t}\r\n   194\t\t\treturn sum / n, nil\r\n   195\t\tcase \"r2\":\r\n   196\t\t\tmean := 0.0\r\n   197\t\t\tfor _, v := range y {\r\n   198\t\t\t\tmean += v\r\n   199\t\t\t}\r\n   200\t"]
[6661.836556, "o", "\t\tmean /= n\r\n   201\t\t\tssRes := 0.0\r\n   202\t\t\tssTot := 0.0\r\n   203\t\t\tfor i := range y {\r\n   204\t\t\t\tssRes += (y[i] - preds[i]) * (y[i] - preds[i])\r\n   205\t\t\t\tssTot += (y[i] - mean) * (y[i] - mean)\r\n   206\t\t\t}\r\n   207\t\t\tif ssTot == 0 {\r\n"]
[6661.836616, "o", "   208\t\t\t\treturn 0.0, nil\r\n   209\t\t\t}\r\n   210\t\t\treturn 1 - ssRes/ssTot, nil\r\n   211\t\tcase \"mape\":\r\n   212\t\t\tsum := 0.0\r\n   213\t\t\tcount := 0.0\r\n   214\t\t\tfor i := range y {\r\n"]
[6661.836673, "o", "   215\t\t\t\tif y[i] == 0 {\r\n   216\t\t\t\t\tcontinue\r\n   217\t\t\t\t}\r\n   218\t\t\t\tsum += math.Abs((y[i] - preds[i]) / y[i])\r\n   219\t\t\t\tcount++\r\n   220\t\t\t}\r\n   221\t\t\tif count == 0 {\r\n   222\t\t\t\t"]
[6661.836729, "o", "return 0.0, nil\r\n   223\t\t\t}\r\n   224\t\t\treturn sum / count * 100, nil\r\n   225\t\t}\r\n   226\t\treturn nil, fmt.Errorf(\"unknown regression metric %q\", name)\r\n   227\t}\r\n   228\t\r\n   229\tfunc aucROC(y []float64, scores []float64) float64 {\r\n   230\t\t"]
