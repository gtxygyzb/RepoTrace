[10391.025343, "o", "   141\t\t\tp, _ := classificationMetric(\"precision\", y, preds)\r\n   142\t\t\tr, _ := classificationMetric(\"recall\", y, preds)\r\n   143\t\t\tpf := p.(float64)\r\n   144\t\t\trf := r.(float64)\r\n   145\t\t\tif pf+rf == 0 {\r\n   146\t\t\t\treturn 0.0, nil\r\n   147\t\t\t}\r\n"]
