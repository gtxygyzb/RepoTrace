[2657.739992, "i", "cat > pipeline.json <<'EOF'\n{\n  \"pipeline\": {\"name\": \"prom-smoke\", \"params\": {\"data_dir\": \".\"}},\n  \"stages\": [\n    {\"name\": \"load\", \"type\": \"data-source\", \"depends_on\": [], \"inputs\": {}, \"params\": {\"path\": \"${data_dir}/data.csv\"}},\n    {\"name\": \"split\", \"type\": \"split\", \"depends_on\": [\"load\"], \"inputs\": {\"data\": \"load.data\"}, \"params\": {\"ratio\": 0.8, \"seed\": 7}},\n    {\"name\": \"train\", \"type\": \"train\", \"depends_on\": [\"split\"], \"inputs\": {\"data\": \"split.train\"}, \"params\": {\"algorithm\": \"decision-tree\", \"target\": \"label\", \"hyperparams\": {\"max_depth\": 3}}},\n    {\"name\": \"eval\", \"type\": \"evaluate\", \"depends_on\": [\"train\", \"split\"], \"inputs\": {\"model\": \"train.model\", \"data\": \"split.test\"}, \"params\": {\"metrics\": [\"accuracy\"]}},\n    {\"name\": \"register\", \"type\": \"register\", \"depends_on\": [\"train\", \"eval\"], \"inputs\": {\"model\": \"train.model\", \"report\": \"eval.report\"}, \"params\": {\"model_name\": \"prom-model\", \"promotion_rules\": {\"production\": {\"accuracy\": 0.5}}}}\n  ]\n}\nEOF\n"]
