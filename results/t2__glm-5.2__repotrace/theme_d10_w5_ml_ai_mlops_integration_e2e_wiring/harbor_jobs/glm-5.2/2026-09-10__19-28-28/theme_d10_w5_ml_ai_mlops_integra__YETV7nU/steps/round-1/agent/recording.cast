[10651.649429, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tentry, prev, new, warnings, err := \u001b[01;31m\u001b[KpromoteModel(\u001b[m\u001b[Kname, version, target, force)\r\n"]
[10651.649938, "o", "\u001b[35m\u001b[K./register.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KpromoteModel(\u001b[m\u001b[Kname string, version int, targetStage string) (*RegistryEntry, string, string, error) {\r\n"]
[10651.674095, "o", "\u001b[?2004h"]
