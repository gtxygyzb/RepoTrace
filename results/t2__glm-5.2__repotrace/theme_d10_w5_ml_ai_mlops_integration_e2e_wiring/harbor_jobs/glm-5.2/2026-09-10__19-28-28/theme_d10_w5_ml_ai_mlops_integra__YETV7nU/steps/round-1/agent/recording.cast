[2870.603997, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t"]
[2870.604193, "o", "\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\ntype ArtifactValue struct {\r\n\tDataset *Dataset\r\n\tModel   *Model\r\n"]
[2870.604306, "o", "\tReport  *Report\r\n\tEntry   *RegistryEntry\r\n}\r\n\r\ntype ArtifactMeta struct {\r\n\tID        string                 `json:\"id\"`\r\n\tStage     string                 `json:\"stage\"`\r\n\tPort      string                 `json:\"port\"`\r\n\tType      string                 `json:\"type\"`\r\n\tSummary   map[string]interface{} `json:\"summary\"`\r\n\tInputs    []string               `json:\"inputs\"`\r\n\tOutputs   []string               `json:\"outputs\"`\r\n\tTimestamp int64                  `json:\"timestamp\"`\r\n}\r\n\r\ntype ArtifactOutput struct {\r\n\tStage   string                 `json:\"stage\"`\r\n\tPort    string                 `json:\"port\"`\r\n\tType    string                 `json:\"type\"`\r\n\tSummary map[string]interface{} `json:\"summary\"`\r\n}\r\n\r\ntype StageResult struct {\r\n\tStatus     string            `json:\"status\"`\r\n\tDurationMs int64             `json:\"duration_ms\"`\r\n\tOutputs    map[string]string `json:\"outputs\"`\r\n\tError      string            `json:\"error,omitempty\"`\r\n}\r\n\r\ntype RunOutput struct {\r\n\tPipeline  string                     `json:\"pipelin"]
[2870.604412, "o", "e\"`\r\n\tStatus    string                     `json:\"status\"`\r\n\tStages    map[string]*StageResult    `json:\"stages\"`\r\n\tArtifacts map[string]*ArtifactOutput `json:\"artifacts\"`\r\n}\r\n\r\ntype Executor struct {\r\n\tconfig  *Config\r\n\tglobals map[string]interface{}\r\n\tstatus  map[string]string\r\n\tresults map[string]*StageResult\r\n\toutputs map[string]map[string]string\r\n\tvalues  map[string]map[string]*ArtifactValue\r\n\tmeta    map[string]*ArtifactMeta\r\n}\r\n\r\nfunc NewExecutor(config *Config, overrides map[string]string) *Executor {\r\n\treturn &Executor{\r\n\t\tconfig:  config,\r\n\t\tglobals: config.globalParams(overrides),\r\n\t"]
[2870.604481, "o", "\tstatus:  map[string]string{},\r\n\t\tresults: map[string]*StageResult{},\r\n\t\toutputs: map[string]map[string]string{},\r\n\t\tvalues:  map[string]map[string]*ArtifactValue{},\r\n\t\tmeta:    map[string]*ArtifactMeta{},\r\n\t}\r\n}\r\n\r\nfunc (e *Executor) Run() (*RunOutput, error) {\r\n\tvalid, errs := e.config.Validate()\r\n\tif !valid {\r\n\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n\t}\r\n\torder, err := e.config.topologicalOrder()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\trunArtifacts := map[string]*ArtifactOutput{}\r\n\r\n"]
[2870.604545, "o", "\tfor _, name := range order {\r\n\t\tstage, _ := e.config.stageByName(name)\r\n\t\te.outputs[name] = map[string]string{}\r\n\t\te.values[name] = map[string]*ArtifactValue{}\r\n\t\te.results[name] = &StageResult{Status: \"pending\", Outputs: map[string]string{}}\r\n\r\n\t\tskip := false\r\n\t\tfor _, dep := range stage.DependsOn {\r\n\t\t\tif e.status[dep] != \"success\" {\r\n"]
[2870.604602, "o", "\t\t\t\tskip = true\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif skip {\r\n\t\t\te.status[name] = \"skipped\"\r\n\t\t\te.results[name].Status = \"skipped\"\r\n\t\t\tcontinue\r\n\t"]
[2870.604659, "o", "\t}\r\n\r\n\t\tinputValues, inputIDs, err := e.resolveInputs(stage)\r\n\t\tif err != nil {\r\n\t\t\te.status[name] = \"failed\"\r\n\t\t\te.results[name].Status = \"failed\"\r\n\t\t\te.results[name].Error = err.Error()\r\n\t\t\tcontinue\r\n"]
[2870.604717, "o", "\t\t}\r\n\r\n\t\tparams := e.config.stageParams(name, e.globals)\r\n\t\tstart := time.Now()\r\n\t\tout, err := executeStage(stage, params, inputValues)\r\n\t\tduration := time.Since(start).Milliseconds()\r\n\t\te.results[name].DurationMs = duration\r\n\r\n\t\tif err != nil {\r\n\t\t\te.status[name] = \"failed\"\r\n"]
[2870.604779, "o", "\t\t\te.results[name].Status = \"failed\"\r\n\t\t\te.results[name].Error = err.Error()\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\te.status[name] = \"success\"\r\n\t\te.results[name].Status = \"success\"\r\n\t\tts := time.Now().UnixNano()\r\n\r\n\t\tfor port, val := range out {\r\n\t\t\tid := artifactID(e.config.Pipeline.Name, name, port, ts)\r\n"]
[2870.604844, "o", "\t\t\te.values[name][port] = val\r\n\t\t\te.outputs[name][port] = id\r\n\t\t\ttyp := val.Type()\r\n\t\t\tsummary := val.Summary()\r\n\t\t\tmeta := &ArtifactMeta{\r\n\t\t\t\tID:        id,\r\n\t\t\t\tStage:     name,\r\n"]
[2870.6049, "o", "\t\t\t\tPort:      port,\r\n\t\t\t\tType:      typ,\r\n\t\t\t\tSummary:   summary,\r\n\t\t\t\tInputs:    inputIDs,\r\n\t\t\t\tOutputs:   []string{},\r\n\t\t\t\tTimestamp: ts,\r\n\t\t\t}\r\n\t\t\t"]
[2870.604962, "o", "e.meta[id] = meta\r\n\t\t\tfor _, inID := range inputIDs {\r\n\t\t\t\tif parent, ok := e.meta[inID]; ok {\r\n\t\t\t\t\tparent.Outputs = appendUnique(parent.Outputs, id)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\trunArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}\r\n\t\t}\r\n\t}\r\n\r\n\tstatus := \"success\"\r\n"]
[2870.605018, "o", "\tfor _, s := range e.results {\r\n\t\tif s.Status != \"success\" {\r\n\t\t\tstatus = \"failed\"\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n\trun := &RunOutput{\r\n\t\tPipeline:  e.config.Pipeline.Name,\r\n\t"]
[2870.605075, "o", "\tStatus:    status,\r\n\t\tStages:    e.results,\r\n\t\tArtifacts: runArtifacts,\r\n\t}\r\n\r\n\tif err := saveArtifacts(e.meta); err != nil {\r\n\t\treturn nil, err\r\n"]
[2870.60513, "o", "\t}\r\n\tif err := saveRun(run); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\treturn run, nil\r\n}\r\n\r\nfunc (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {\r\n\tinputs := map[string]*ArtifactValue{}\r\n"]
[2870.605192, "o", "\tids := []string{}\r\n\tfor local, ref := range stage.Inputs {\r\n\t\tparts := strings.SplitN(ref, \".\", 2)\r\n\t\tif len(parts) != 2 {\r\n\t\t\treturn nil, nil, fmt.Errorf(\"stage %q has invalid input reference %q\", stage.Name, ref)\r\n\t\t}\r\n\t\tdepStage, port := parts[0], parts[1]\r\n\t\tid, ok := e.outputs[depStage][port]\r\n\t\tif !ok {\r\n"]
[2870.605283, "o", "\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable output %s.%s\", stage.Name, local, depStage, port)\r\n\t\t}\r\n\t\tval, ok := e.values[depStage][port]\r\n\t\tif !ok || val == nil {\r\n\t\t\treturn nil, nil, fmt.Errorf(\"stage %q input %q references unavailable artifact %s.%s\", stage.Name, local, depStage, port)\r\n\t\t}\r\n\t\tinputs[local] = val\r\n\t\tids = append(ids, id)\r\n\t}\r\n\treturn inputs, ids, nil\r\n}\r\n"]
[2870.605342, "o", "\r\nfunc executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tswitch stage.Type {\r\n\tcase \"data-source\":\r\n\t\treturn executeDataSource(stage, params, inputs)\r\n\tcase \"transform\":\r\n\t\treturn executeTransform(stage, params, inputs)\r\n\tcase \"split\":\r\n\t\treturn executeSplit(stage, params, inputs)\r\n"]
[2870.605399, "o", "\tcase \"train\":\r\n\t\treturn executeTrain(stage, params, inputs)\r\n\tcase \"evaluate\":\r\n\t\treturn executeEvaluate(stage, params, inputs)\r\n\tcase \"register\":\r\n\t\treturn executeRegister(stage, params, inputs)\r\n\t}\r\n\treturn nil, fmt.Errorf(\"unknown stage type %q\", stage.Type)\r\n}\r\n"]
[2870.605477, "o", "\r\nfunc executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {\r\n\tpath, ok := getString(params, \"path\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"data-source stage %q requires path\", stage.Name)\r\n\t}\r\n\tschema, _ := getMap(params, \"schema\")\r\n\tds, err := loadDataset(path, schema)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn map[string]*ArtifactValue{\"data\": {Dataset: ds}}, nil\r\n}\r\n"]
[2870.605536, "o", "\r\nfunc (c *Config) topologicalOrder() ([]string, error) {\r\n\tindeg := map[string]int{}\r\n\tadj := map[string][]string{}\r\n\tfor _, s := range c.Stages {\r\n\t\tindeg[s.Name] = 0\r\n\t}\r\n\tfor _, s := range c.Stages {\r\n\t\tfor _, dep := range s.DependsOn {\r\n\t\t\tif _, ok := c.stageByName(dep); ok {\r\n\t"]
[2870.605596, "o", "\t\t\tadj[dep] = append(adj[dep], s.Name)\r\n\t\t\t\tindeg[s.Name]++\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tqueue := []string{}\r\n\tfor _, s := range c.Stages {\r\n\t\tif indeg[s.Name] == 0 {\r\n\t\t\tqueue = append(queue, s.Name)\r\n"]
[2870.605654, "o", "\t\t}\r\n\t}\r\n\torder := []string{}\r\n\tfor len(queue) > 0 {\r\n\t\tnode := queue[0]\r\n\t\tqueue = queue[1:]\r\n\t\torder = append(order, node)\r\n\t\tfor _, next := range adj[node] {\r\n\t\t\tindeg[next]--\r\n\t"]
[2870.60571, "o", "\t\tif indeg[next] == 0 {\r\n\t\t\t\tqueue = append(queue, next)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif len(order) < len(c.Stages) {\r\n\t\tif cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {\r\n\t\t\treturn nil, fmt.Errorf(\"cycle detected involving stages: %s\", strings.Join(cycle, \", \"))\r\n\t\t}\r\n\t\t"]
[2870.605766, "o", "return nil, fmt.Errorf(\"cycle detected involving stages: %s\", joinStageNames(c.Stages))\r\n\t}\r\n\treturn order, nil\r\n}\r\n\r\nfunc joinStageNames(stages []StageConfig) string {\r\n\tnames := []string{}\r\n\tfor _, s := range stages {\r\n\t\tnames = append(names, s.Name)\r\n"]
[2870.605821, "o", "\t}\r\n\treturn strings.Join(names, \", \")\r\n}\r\n\r\nfunc artifactID(pipeline, stage, port string, ts int64) string {\r\n\tif pipeline == \"\" {\r\n\t\tpipeline = \"pipeline\"\r\n\t}\r\n\treturn fmt.Sprintf(\"%s-%s-%s-%d\", pipeline, stage, port, ts)\r\n}\r\n"]
[2870.605877, "o", "\r\nfunc (v *ArtifactValue) Type() string {\r\n\tif v.Dataset != nil {\r\n\t\treturn \"dataset\"\r\n\t}\r\n\tif v.Model != nil {\r\n\t\treturn \"model\"\r\n\t}\r\n\tif v.Report != nil {\r\n"]
[2870.605932, "o", "\t\treturn \"report\"\r\n\t}\r\n\tif v.Entry != nil {\r\n\t\treturn \"entry\"\r\n\t}\r\n\treturn \"unknown\"\r\n}\r\n\r\nfunc (v *ArtifactValue) Summary() map[string]interface{} {\r\n\tif v.Dataset != nil {\r\n\t\treturn v.Dataset.Summary()\r\n\t}\r\n"]
[2870.605988, "o", "\tif v.Model != nil {\r\n\t\treturn map[string]interface{}{\r\n\t\t\t\"algorithm\":   v.Model.Algorithm,\r\n\t\t\t\"target\":      v.Model.Target,\r\n\t\t\t\"features\":    v.Model.Features,\r\n\t\t\t\"hyperparams\": v.Model.Hyperparams,\r\n\t\t}\r\n\t}\r\n\tif v.Report != nil {\r\n\t\treturn v.Report.Summary()"]
[2870.606053, "o", "\r\n"]
