[1537.324036, "o", "\u001b[?2004h> "]
[1537.32411, "o", "    m, ok := artifacts[id]\r\n\u001b[?2004l\r"]
[1537.324179, "o", "\u001b[?2004h> "]
[1537.324235, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
