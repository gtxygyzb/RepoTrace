[8913.623182, "o", "     8\t\t\"sort\"\r\n     9\t\t\"strings\"\r\n    10\t\t\"time\"\r\n    11\t)\r\n    12\t\r\n    13\ttype ArtifactValue struct {\r\n    14\t\tDataset *Dataset\r\n    15\t\tModel   *Model\r\n    16\t\tReport  *Report\r\n    17\t\tEntry   *RegistryEntry\r\n    18\t}\r\n    19\t\r\n    20\ttype ArtifactMeta struct {\r\n    21\t\tID        string                 `json:\"id\"`\r\n    22\t\tStage     string                 `json:\"stage\"`\r\n    23\t\tPort      string                 `json:\"port\"`\r\n    24\t\tType      string                 `json:\"type\"`\r\n    25\t\tSummary   map[string]interface{} `json:\"summary\"`\r\n    26\t\tInputs    []string               `json:\"inputs\"`\r\n    27\t"]
[8913.623305, "o", "\tOutputs   []string               `json:\"outputs\"`\r\n    28\t\tTimestamp int64                  `json:\"timestamp\"`\r\n    29\t}\r\n    30\t\r\n    31\ttype ArtifactOutput struct {\r\n    32\t\tStage   string                 `json:\"stage\"`\r\n    33\t\tPort    string                 `json:\"port\"`\r\n    34\t\tType    string                 `json:\"type\"`\r\n    35\t\tSummary map[string]interface{} `json:\"summary\"`\r\n    36\t}\r\n    37\t\r\n    38\ttype StageResult struct {\r\n    39\t\tStatus     string            `json:\"status\"`\r\n    40\t\tCacheHit   bool              `json:\"cache_hit,omitempty\"`\r\n    41\t\tDurationMs int64             `json:\"duration_ms\"`\r\n    42\t\tOutputs    map[string]string `json:\"outputs\"`\r\n"]
[8913.623382, "o", "    43\t\tError      string            `json:\"error,omitempty\"`\r\n    44\t}\r\n    45\t\r\n    46\ttype RunOutput struct {\r\n    47\t\tPipeline   string                     `json:\"pipeline\"`\r\n    48\t\tStatus     string                     `json:\"status\"`\r\n    49\t\tStages     map[string]*StageResult    `json:\"stages\"`\r\n    50\t\tArtifacts  map[string]*ArtifactOutput `json:\"artifacts\"`\r\n    51\t\tCacheStats *CacheStats                `json:\"cache_stats,omitempty\"`\r\n    52\t}\r\n    53\t\r\n    54\ttype CacheStats struct {\r\n"]
[8913.623507, "o", "    55\t\tHits   int `json:\"hits\"`\r\n    56\t\tMisses int `json:\"misses\"`\r\n    57\t}\r\n    58\t\r\n    59\ttype Executor struct {\r\n    60\t\tconfig     *Config\r\n    61\t\tglobals    map[string]interface{}\r\n    62\t\tstatus     map[string]string\r\n    63\t\tresults    map[string]*StageResult\r\n    64\t\toutputs    map[string]map[string]string\r\n    65\t\tvalues     map[string]map[string]*ArtifactValue\r\n    66\t\tmeta       map[string]*ArtifactMeta\r\n    67\t\tcacheKeys  map[string]string\r\n    68\t\tnoCache    bool\r\n    69\t\tcvFolds    int\r\n    70\t\tcacheStats *CacheStats\r\n    71\t}\r\n    72\t\r\n"]
[8913.623579, "o", "    73\tfunc NewExecutor(config *Config, overrides map[string]string) *Executor {\r\n    74\t\treturn &Executor{\r\n    75\t\t\tconfig:     config,\r\n    76\t\t\tglobals:    config.globalParams(overrides),\r\n    77\t\t\tstatus:     map[string]string{},\r\n    78\t\t\tresults:    map[string]*StageResult{},\r\n    79\t\t\toutputs:    map[string]map[string]string{},\r\n    80\t\t\tvalues:     map[string]map[string]*ArtifactValue{},\r\n    81\t\t\tmeta:       map[string]*ArtifactMeta{},\r\n"]
[8913.623646, "o", "    82\t\t\tcacheKeys:  map[string]string{},\r\n    83\t\t\tcacheStats: &CacheStats{},\r\n    84\t\t}\r\n    85\t}\r\n    86\t\r\n    87\tfunc (e *Executor) Run() (*RunOutput, error) {\r\n    88\t\tvalid, errs := e.config.Validate()\r\n    89\t\tif !valid {\r\n    90\t\t\treturn nil, fmt.Errorf(\"%s\", strings.Join(errs, \"; \"))\r\n"]
