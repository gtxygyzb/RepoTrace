[11413.766554, "o", "\tEnsembleModels  []string               `json:\"ensemble_models,omitempty\"`\r\n\tModelData       map[string]interface{} `json:\"model_data,omitempty\"`\r\n}\r\n\r\ntype TreeNode struct {\r\n\tIsLeaf      bool\r\n\tPrediction  float64\r\n\tProbability float64\r\n\tFeature     int\r\n\tThreshold   float64\r\n\tLeft        *TreeNode\r\n\tRight       *TreeNode\r\n}\r\n\r\ntype BoostedTree struct {\r\n\tTree           *TreeNode\r\n\tLearningRate   float64\r\n"]
