[12486.667498, "o", "\"path/filepath\"\r\n     8\t\t\"sort\"\r\n     9\t\t\"strconv\"\r\n    10\t\t\"strings\"\r\n    11\t\t\"time\"\r\n    12\t\r\n    13\t\t\"encoding/json\"\r\n    14\t)\r\n    15\t\r\n    16\ttype StageSummary struct {\r\n    17\t\tStatus     string `json:\"status\"`\r\n    18\t\tCacheHit   bool   `json:\"cache_hit\"`\r\n    19\t\tDurationMs int64  `json:\"duration_ms\"`\r\n    20\t}\r\n    21\t\r\n    22\ttype FoldStageSummary struct {\r\n    23\t\tStatus   string `json:\"status\"`\r\n    24\t\tCacheHit bool   `json:\"cache_hit,omitempty\"`\r\n    25\t}\r\n    26\t\r\n    27\ttype FoldSummary map[string]FoldStageSummary\r\n"]
[12486.667589, "o", "    28\t\r\n    29\ttype RunRecord struct {\r\n    30\t\tRunID         string                  `json:\"run_id\"`\r\n    31\t\tPipeline      string                  `json:\"pipeline\"`\r\n    32\t\tStartedAt     string                  `json:\"started_at\"`\r\n    33\t\tFinishedAt    string                  `json:\"finished_at\"`\r\n    34\t\tDurationMs    int64                   `json:\"duration_ms\"`\r\n    35\t\tStatus        string                  `json:\"status\"`\r\n    36\t\tMode          string                  `json:\"mode\"`\r\n    37\t\tCvFolds       *int                    `json:\"cv_folds\"`\r\n    38\t\tNoCache       bool                    `json:\"no_cache\"`\r\n    39\t\tSkippedStages []string                `json:\"skipped_stages\"`\r\n    40\t\t"]
