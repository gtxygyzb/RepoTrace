[1776.709009, "o", "\t}\r\n\tAtY := make([]float64, m+1)\r\n\tfor i := 0; i < n; i++ {\r\n\t\tfor a := 0; a <= m; a++ {\r\n"]
[1776.709041, "o", "\t\t\tAtY[a] += A[i][a] * y[i]\r\n\t\t\tfor b := 0; b <= m; b++ {\r\n\t\t\t\tAtA[a][b] += A[i][a] * A[i][b]\r\n\t\t\t}\r\n"]
[1776.709244, "o", "\t\t}\r\n\t}\r\n\tinv, err := invertMatrix(AtA)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tw := make([]float64, m+1)\r\n\tfor a := 0; a <= m; a++ {\r\n\t\tfor b := 0; b <= m; b++ {\r\n\t\t\tw[a] += inv[a][b] * AtY[b]\r\n\t\t}\r\n\t}\r\n\treturn w, nil\r\n}\r\n\r\nfunc invertMatrix(m [][]float64) ([][]float64, error) {\r\n\tn := len(m)\r\n\ta := make([][]float64, n)\r\n\tfor i := range m {\r\n\t\ta[i] = append([]float64{}, m[i]...)\r\n\t\ta[i] = append(a[i], make([]float64, n)...)\r\n\t\ta[i][n+i] = 1\r\n\t}\r\n\tfor i := 0; i < n; i++ {\r\n\t\tpivot := a[i][i]\r\n\t\tif math.Abs(pivot) < 1e-12 {\r\n\t\t\t// try pivot swap\r\n\t\t\tswap := -1\r\n\t\t\tfor r := i + 1; r < n; r++ {\r\n\t\t\t\tif math.Abs(a[r][i]) > 1e-12 {"]
[1776.709336, "o", "\r\n\t\t\t\t\tswap = r\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif swap == -1 {\r\n\t\t\t\treturn nil, fmt.Errorf(\"matrix not invertible\")\r\n\t\t\t}\r\n\t\t\ta[i], a[swap] = a[swap], a[i]\r\n\t\t\tpivot = a[i][i]\r\n\t\t}\r\n\t\tfor j := 0; j < 2*n; j++ {\r\n\t\t\t"]
[1776.709423, "o", "a[i][j] /= pivot\r\n\t\t}\r\n"]
