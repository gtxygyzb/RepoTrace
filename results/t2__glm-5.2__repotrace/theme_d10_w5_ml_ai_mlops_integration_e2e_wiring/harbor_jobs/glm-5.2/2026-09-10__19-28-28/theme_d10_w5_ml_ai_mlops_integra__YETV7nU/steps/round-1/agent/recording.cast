[9353.661798, "o", "func votePredict(preds []float64) float64 {\r\n\u001b[?2004l\r"]
[9353.661863, "o", "\u001b[?2004h> "]
[9353.661963, "o", "\\tcounts := map[float64]int{}\r\n\u001b[?2004l\r"]
[9353.662031, "o", "\u001b[?2004h> "]
