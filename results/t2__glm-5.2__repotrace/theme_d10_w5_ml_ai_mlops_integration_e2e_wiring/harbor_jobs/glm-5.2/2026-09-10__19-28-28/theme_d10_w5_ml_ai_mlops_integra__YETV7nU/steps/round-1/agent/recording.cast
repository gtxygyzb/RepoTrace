[8837.400821, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n"]
[8837.40084, "o", "     6\t\t\"os\"\r\n     7\t\t\"regexp\"\r\n"]
[8837.400927, "o", "     8\t\t\"strings\"\r\n     9\t)\r\n    10\t\r\n    11\ttype Config struct {\r\n    12\t\tPipeline PipelineConfig `json:\"pipeline\"`\r\n    13\t\tStages   []StageConfig  `json:\"stages\"`\r\n    14\t}\r\n    15\t\r\n    16\ttype PipelineConfig struct {\r\n    17\t\tName   string                 `json:\"name\"`\r\n    18\t\tParams map[string]interface{} `json:\"params\"`\r\n    19\t}\r\n    20\t"]
[8837.400984, "o", "\r\n    21\ttype StageConfig struct {\r\n    22\t\tName      string                 `json:\"name\"`\r\n"]
[8837.40104, "o", "    23\t\tType      string                 `json:\"type\"`\r\n    24\t\tDependsOn []string               `json:\"depends_on\"`\r\n    25\t\tInputs    map[string]string      `json:\"inputs\"`\r\n    26\t\tParams    map[string]interface{} `json:\"params\"`\r\n    27\t}\r\n    28\t\r\n    29\tvar paramRE = regexp.MustCompile(`\\$\\{([^}]+)\\}`)\r\n"]
[8837.401094, "o", "    30\t\r\n    31\tfunc loadConfig(path string) (*Config, error) {\r\n    32\t\tdata, err := os.ReadFile(path)\r\n    33\t\tif err != nil {\r\n    34\t\t\tif os.IsNotExist(err) {\r\n    35\t\t\t\treturn nil, fmt.Errorf(\"file not found: %s\", path)\r\n    36\t\t\t}\r\n"]
[8837.401109, "o", "    37\t\t\treturn nil, err\r\n    38\t\t}\r\n    39\t\tvar c Config\r\n    40\t\tif err := json.Unmarshal(data, &c); err != nil {\r\n    41\t\t\treturn nil, fmt.Errorf(\"invalid config: %s\", err.Error())\r\n    42\t\t}\r\n    43\t\treturn &c, nil\r\n"]
[8837.401182, "o", "    44\t}\r\n    45\t\r\n    46\t"]
[8837.401242, "o", "func (c *Config) globalParams(overrides map[string]string) map[string]interface{} {\r\n    47\t\tparams := map[string]interface{}{}\r\n    48\t\tfor k, v := range c.Pipeline.Params {\r\n    49\t\t\tparams[k] = v\r\n    50\t\t}\r\n    51\t\tfor k, v := range overrides {\r\n    52\t\t\tparams[k] = v\r\n    53\t\t}\r\n    54\t\treturn params\r\n    55\t}\r\n    56\t\r\n"]
[8837.401299, "o", "    57\tfunc substituteValue(v interface{}, globals map[string]interface{}) interface{} {\r\n    58\t\tswitch x := v.(type) {\r\n    59\t\tcase string:\r\n    60\t\t\treturn paramRE.ReplaceAllStringFunc(x, func(m string) string {\r\n    61\t\t\t\tkey := m[2 : len(m)-1]\r\n    62\t\t\t\tif val, ok := globals[key]; ok {\r\n    63\t\t\t\t\treturn fmt.Sprintf(\"%v\", val)\r\n    64\t\t\t\t}\r\n    65\t\t\t\treturn m\r\n    66\t\t\t})\r\n"]
[8837.401349, "o", "    67\t\tcase map[string]interface{}:\r\n    68\t\t\tres := map[string]interface{}{}\r\n"]
[8837.401397, "o", "    69\t\t\tfor k, val := range x {\r\n    70\t\t\t\tres[k] = substituteValue(val, globals)\r\n    71\t\t\t}\r\n    72\t\t\treturn res\r\n    73\t\tcase []interface{}:\r\n    74\t\t\tres := make([]interface{}, len(x))\r\n"]
[8837.401446, "o", "    75\t\t\tfor i, val := range x {\r\n    76\t\t\t\tres[i] = substituteValue(val, globals)\r\n    77\t\t\t}\r\n    78\t\t\treturn res\r\n    79\t\tdefault:\r\n    80\t\t\treturn v\r\n    81\t\t}\r\n"]
[8837.401495, "o", "    82\t}\r\n    83\t\r\n    84\tfunc (c *Config) stageParams(name string, globals map[string]interface{}) map[string]interface{} {\r\n    85\t\tfor _, s := range c.Stages {\r\n    86\t\t\tif s.Name == name {\r\n    87\t\t\t\tif s.Params == nil {\r\n    88\t\t\t\t\treturn map[string]interface{}{}\r\n"]
[8837.401544, "o", "    89\t\t\t\t}\r\n    90\t\t\t\tres := substituteValue(s.Params, globals)\r\n    91\t\t\t\tif m, ok := res.(map[string]interface{}); ok {\r\n    92\t\t\t\t\treturn m\r\n    93\t\t\t\t}\r\n    94\t\t\t\treturn map[string]interface{}{}\r\n    95\t\t\t}\r\n    96\t\t}\r\n    97"]
[8837.401597, "o", "\t\treturn map[string]interface{}{}\r\n    98\t}\r\n    99\t\r\n   100\tfunc (c *Config) stageByName(name string) (*StageConfig, bool) {\r\n   101\t\tfor i := range c.Stages {\r\n   102\t\t\tif c.Stages[i].Name == name {\r\n   103\t\t\t\treturn &c.Stages[i], true\r\n   104\t\t\t}\r\n   105\t\t}\r\n   106\t\treturn nil, false\r\n   107\t}\r\n   108\t\r\n"]
[8837.401649, "o", "   109\tfunc validOutputPorts(t string) []string {\r\n   110\t\tswitch t {\r\n   111\t\tcase \"data-source\":\r\n   112\t\t\treturn []string{\"data\"}\r\n   113\t\tcase \"transform\":\r\n   114\t\t\treturn []string{\"data\"}\r\n   115\t\tcase \"split\":\r\n   116\t\t\treturn []string{\"train\", \"test\"}\r\n   117"]
[8837.401701, "o", "\t\tcase \"train\":\r\n   118\t\t\treturn []string{\"model\", \"predictions\"}\r\n   119\t\tcase \"evaluate\":\r\n   120\t\t\treturn []string{\"report\"}\r\n"]
