[5326.732074, "i", "config.Validate()\n    if !valid {\n        return nil, fmt.Errorf(\"invalid pipeline: %s\", errs[0])\n    }\n    if cv > 0 {\n        if err := config.validateCV(); err != nil {\n            return nil, err\n        }\n    }\n\n    order, err := config.topologicalOrder()\n    if err != nil {\n        return nil, err\n    }\n\n    mode := \"standard\"\n    if cv > 0 {\n        mode = \"cv\"\n    }\n\n    postSplit := map[string]bool{}\n    splitName := \"\"\n    if cv > 0 {\n        splitName, _ = config.splitStageName()\n        postSplit = config.postSplitStages(splitName)\n    }\n\n    executionOrder := []string{}\n    if cv > 0 {\n        for _, name := range order {\n            if !postSplit[name] {\n                executionOrder = append(executionOrder, name)\n            }\n        }\n        for _, name := range order {\n            if postSplit[name] {\n                executionOrder = append(executionOrder, name)\n            }\n        }\n    } else {\n        executionOrder = append(executionOrder, order...)\n    }\n\n    cacheKeys := map[string"]
[5326.732301, "i", "]string{}\n    stages := map[string]PlanStage{}\n    edges := []PlanEdge{}\n\n    for _, name := range order {\n        stage, _ := config.stageByName(name)\n        deps := stage.DependsOn\n        if deps == nil {\n            deps = []string{}\n        }\n\n        inputTypes := map[string]string{}\n        for local, ref := range stage.Inputs {\n            parts := strings.SplitN(ref, \".\", 2)\n            if len(parts) != 2 {\n                continue\n            }\n            refStage, ok := config.stageByName(parts[0])\n            if !ok {\n                continue\n            }\n            inputTypes[local] = outputPortType(refStage.Type, parts[1])\n            edges = append(edges, PlanEdge{From: parts[0], To: name, Port: parts[1]})\n        }\n\n        outputTypes := map[string]string{}\n        for _, port := range validOutputPorts(stage.Type) {\n            outputTypes[port] = outputPortType(stage.Type, port)\n        }\n\n        cacheStatus := \"unknown\"\n        phase := (*string)(nil)\n        if cv > 0 {\n            if"]
[5326.732314, "i", " postSplit[name] {\n                phase = strPtr(\"per-fold\")\n            } else {\n                phase = strPtr(\"pre-split\")\n            }\n        }\n\n        if cv == 0 || !postSplit[name] {\n            params := config.stageParams(name, config.globalParams(overrides))\n            inputKeys := map[string]string{}\n            unknown := false\n            for local, ref := range stage.Inputs {\n                parts := strings.SplitN(ref, \".\", 2)\n                if len(parts) != 2 {\n                    unknown = true\n                    break\n                }\n                key, ok := cacheKeys[parts[0]]\n                if !ok || key == \"\" {\n                    unknown = true\n                    break\n                }\n                inputKeys[local] = key\n            }\n            if !unknown {\n                key, err := computeCacheKey(stage, params, inputKeys, -1)\n                if err == nil {\n                    cacheKeys[name] = key\n                    if cacheEntryExists(key) {\n                    "]
[5326.732387, "o", "cat > plan.go << 'EOF'\r\n\u001b[?2004l\r"]
[5326.732444, "i", "    cacheStatus = \"hit\"\n                    } else {\n                        cacheStatus = \"miss\"\n                    }\n                }\n            }\n        }\n\n        stages[name] = PlanStage{\n            Type:        stage.Type,\n            DependsOn:   deps,\n            InputTypes:  inputTypes,\n            OutputTypes: outputTypes,\n            CacheStatus: cacheStatus,\n            CVPhase:     phase,\n        }\n    }\n\n    sort.Slice(edges, func(i, j int) bool {\n        if edges[i].From != edges[j].From {\n            return edges[i].From < edges[j].From\n        }\n        if edges[i].To != edges[j].To {\n            return edges[i].To < edges[j].To\n        }\n        return edges[i].Port < edges[j].Port\n    })\n\n    return &PlanOutput{\n        Pipeline:      config.Pipeline.Name,\n        Mode:          mode,\n        CVFolds:       cv,\n        ExecutionOrder: executionOrder,\n        Stages:        stages,\n        Edges:         edges,\n    }, nil\n}\n\nfunc outputPortType(stageType, port string) string {\n    switc"]
[5326.732454, "o", "    cacheStatus = \"hit"]
[5326.732521, "i", "h stageType {\n    case \"data-source\", \"transform\":\n        if port == \"data\" {\n            return \"dataset\"\n        }\n    case \"split\":\n        if port == \"train\" || port == \"test\" {\n            return \"dataset\"\n        }\n    case \"train\":\n        if port == \"model\" {\n            return \"model\"\n        }\n        if port == \"predictions\" {\n            return \"dataset\"\n        }\n    case \"evaluate\":\n        if port == \"report\" {\n            return \"report\"\n        }\n    case \"register\":\n        if port == \"entry\" {\n            return \"entry\"\n        }\n    }\n    return \"unknown\"\n}\n\nfunc strPtr(s string) *string {\n    return &s\n}\nEOF\n"]
