[5326.21933, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5326.21939, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5326.219445, "o", "\u001b[?2004h> "]
[5326.219701, "o", "    if err := saveArtifacts(e.meta); err != nil {\r\n\u001b[?2004l\r"]
[5326.219732, "o", "\u001b[?2004h"]
[5326.219771, "o", "> "]
[5326.220098, "o", "        return nil, err\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
