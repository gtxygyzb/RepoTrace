[9321.126574, "o", "func (c *Config) stageDeps(s *StageConfig) []string {$\r\n^Ideps := map[string]bool{}$\r\n^Ifor _, dep := range s.DependsOn {$\r\n^I^Iif dep != \"\" {$\r\n^I^I^Ideps[dep] = true$\r\n^I^I}$\r\n^I}$\r\n^Ifor _, ref := range s.Inputs {$\r\n^I^Irefs, ok := inputRefs(ref)$\r\n^I^Iif !ok {$\r\n^I^I^Icontinue$\r\n^I^I}$\r\n^I^Ifor _, r := range refs {$\r\n^I^I^Iparts := strings.SplitN(r, \".\", 2)$\r\n^I^Iif len(parts) == 2 && parts[0] != \"\" {$\r\n^I^I^Ideps[parts[0]] = true$\r\n^I^I}$\r\n^I}$\r\n^Iout := make([]string, 0, len(deps))$\r\n^Ifor dep := range deps {$\r\n^I^Iout = append(out, dep)$\r\n^I}$\r\n^Isort.Strings(out)$\r\n^Ireturn out$\r\n}$\r\n"]
