[483.388459, "o", "package main\r\n\r\nimport (\r\ngo.mod \"encoding/json\"\r\ngo.mod \"fmt\"\r\ngo.mod \"os\"\r\ngo.mod \"regexp\"\r\ngo.mod \"strings\"\r\n)\r\n\r\ntype Config struct {\r\ngo.mod Pipeline PipelineConfig `json:\"pipeline\"`\r\ngo.mod Stages   []StageConfig  `json:\"stages\"`\r\n}\r\n\r\ntype PipelineConfig struct {\r\ngo.mod Name   string                 `json:\"name\"`\r\ngo.mod Params map[string]interface{} `json:\"params\"`\r\n}\r\n\r\ntype StageConfig struct {\r\ngo.mod Name      string            `json:\"name\"`\r\n"]
[483.388578, "o", "go.mod Type      string            `json:\"type\"`\r\ngo.mod DependsOn []string          `json:\"depends_on\"`\r\ngo.mod Inputs    map[string]string `json:\"inputs\"`\r\ngo.mod Params    map[string]interface{} `json:\"params\"`\r\n}\r\n\r\nvar paramRE = regexp.MustCompile(`\\$\\{([^}]+)\\}`)\r\n\r\nfunc loadConfig(path string) (*Config, error) {\r\ngo.mod data, err := os.ReadFile(path)\r\ngo.mod if err != nil {\r\ngo.mod go.mod if os.IsNotExist(err) {\r\ngo.mod go.mod go.mod return nil, fmt.Errorf(\"file not found: %s\", path)\r\ngo.mod go.mod }\r\ngo.mod go.mod return nil, err\r\ngo.mod }\r\ngo.mod var c Config\r\ngo.mod if err := json.Unmarshal(data, &c); err != nil {\r\n"]
[483.388789, "o", "---\r\n"]
[483.390766, "o", "package main\r\n\r\nimport (\r\n\"encoding/csv\"\r\n\"fmt\"\r\n\"math\"\r\n"]
[483.390872, "o", "\"os\"\r\n\"strconv\"\r\n\"strings\"\r\n)\r\n\r\ntype Dataset struct {\r\nColumns []string     `json:\"columns\"`\r\nTypes   []string     `json:\"types\"`\r\nRows    [][]string   `json:\"rows\"`\r\n}\r\n\r\nfunc loadDataset(path string, schema map[string]interface{}) (*Dataset, error) {\r\nf, err := os.Open(path)\r\nif err != nil {\r\nif os.IsNotExist(err) {\r\nreturn nil, fmt.Errorf(\"file not found: %s\", path)\r\n}\r\nreturn nil, err\r\n}\r\ndefer f.Close()\r\n\r\nr := csv.NewReader(f)\r\nrecords, err := r.ReadAll()\r\nif err != nil {\r\nreturn nil, err\r\n"]
[483.390974, "o", "}\r\nif len(records) == 0 {\r\nreturn &Dataset{Columns: []string{}, Types: []string{}, Rows: [][]string{}}, nil\r\n}\r\n\r\nheader := records[0]\r\nrows := records[1:]\r\n"]
[483.39101, "o", "columns := header\r\ntypes := make([]string, len(columns))\r\n"]
[483.3913, "o", "\u001b[?2004h"]
