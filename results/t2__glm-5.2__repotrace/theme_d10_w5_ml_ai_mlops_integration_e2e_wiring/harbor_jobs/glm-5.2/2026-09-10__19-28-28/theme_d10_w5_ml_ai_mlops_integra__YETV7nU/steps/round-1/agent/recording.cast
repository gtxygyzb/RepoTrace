[1537.524619, "o", "func parseParams(args []string) (map[string]string, error) {\r\n\u001b[?2004l\r"]
[1537.524674, "o", "\u001b[?2004h> "]
[1537.524812, "o", "    overrides := map[string]string{}\r\n\u001b[?2004l\r"]
[1537.524876, "o", "\u001b[?2004h> "]
[1537.525011, "o", "    for i := 0; i < len(args); i++ {\r\n\u001b[?2004l\r"]
[1537.525071, "o", "\u001b[?2004h> "]
[1537.525188, "o", "        if args[i] == \"--param\" {\r\n\u001b[?2004l\r"]
[1537.525262, "o", "\u001b[?2004h> "]
[1537.525379, "o", "            if i+1 >= len(args) {\r\n\u001b[?2004l\r"]
[1537.525407, "o", "\u001b[?2004h> "]
[1537.525697, "o", "                return nil, fmt.Errorf(\"--param requires key=value\")\r\n\u001b[?2004l\r"]
[1537.525755, "o", "\u001b[?2004h> "]
[1537.525814, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.525869, "o", "> "]
[1537.525954, "o", "            kv := args[i+1]\r\n\u001b[?2004l\r"]
[1537.526011, "o", "\u001b[?2004h> "]
[1537.526063, "o", "            i++\r\n\u001b[?2004l\r"]
[1537.526117, "o", "\u001b[?2004h> "]
[1537.526296, "o", "            k, v, ok := strings.Cut(kv, \"=\")\r\n\u001b[?2004l\r"]
[1537.526351, "o", "\u001b[?2004h> "]
[1537.526422, "o", "            if !ok {\r\n\u001b[?2004l\r"]
[1537.526477, "o", "\u001b[?2004h> "]
[1537.526741, "o", "                return nil, fmt.Errorf(\"--param requires key=value\")\r\n\u001b[?2004l\r"]
[1537.526796, "o", "\u001b[?2004h> "]
[1537.526855, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.526911, "o", "> "]
[1537.527001, "o", "            overrides[k] = v\r\n\u001b[?2004l\r"]
[1537.527056, "o", "\u001b[?2004h> "]
[1537.527233, "o", "        } else if strings.HasPrefix(args[i], \"--param=\") {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.527289, "o", "> "]
[1537.527418, "o", "            kv := strings.TrimPrefix(args[i], \"--param=\")\r\n\u001b[?2004l\r"]
[1537.527472, "o", "\u001b[?2004h> "]
[1537.527573, "o", "            k, v, ok := strings.Cut(kv, \"=\")\r\n\u001b[?2004l\r"]
[1537.527628, "o", "\u001b[?2004h> "]
[1537.527685, "o", "            if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.527882, "o", "                return nil, fmt.Errorf(\"--param requires key=value\")\r\n\u001b[?2004l\r"]
[1537.527937, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[1537.527997, "o", "\u001b[?2004h> "]
[1537.528063, "o", "            overrides[k] = v\r\n\u001b[?2004l\r"]
[1537.528118, "o", "\u001b[?2004h> "]
[1537.528176, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.528357, "o", "            return nil, fmt.Errorf(\"unknown flag: %s\", args[i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.528414, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.528469, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.528564, "o", "    return overrides, nil\r\n\u001b[?2004l\r"]
[1537.528619, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1537.528673, "o", "\u001b[?2004h> "]
[1537.528811, "o", "func splitNameVersion(s string) (string, int, bool) {\r\n\u001b[?2004l\r"]
[1537.528866, "o", "\u001b[?2004h> "]
[1537.528952, "o", "    parts := strings.SplitN(s, \":\", 2)\r\n\u001b[?2004l\r"]
[1537.529007, "o", "\u001b[?2004h> "]
[1537.529155, "o", "    if len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1537.52921, "o", "> "]
[1537.529285, "o", "        return \"\", 0, false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.529341, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1537.529399, "o", "    var version int\r\n\u001b[?2004l\r"]
[1537.529455, "o", "\u001b[?2004h> "]
[1537.529619, "o", "    if _, err := fmt.Sscanf(parts[1], \"%d\", &version); err != nil {\r\n\u001b[?2004l\r"]
[1537.529673, "o", "\u001b[?2004h> "]
[1537.529728, "o", "        return \"\", 0, false\r\n\u001b[?2004l\r"]
