[10912.633134, "o", "\t\t\tif err != nil {\r\n\t\t\t\treturn \"\", nil, 0, fmt.Errorf(\"invalid cv folds: %s\", val)\r\n\t\t\t}\r\n\t\t\tif k < 2 {\r\n\t\t\t\treturn \"\", nil, 0, fmt.Errorf(\"cv folds must be >= 2\")\r\n\t\t\t}\r\n\t\t\tcv = k\r\n\t\tcase args[i] == \"--param\":\r\n"]
[10912.633189, "o", "\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn \"\", nil, 0, fmt.Errorf(\"--param requires key=value\")\r\n\t\t\t}\r\n\t\t\tkv := args[i+1]\r\n\t\t\ti++\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\treturn \"\", nil, 0, fmt.Errorf(\"--param requires key=value\")\r\n\t\t\t}\r\n"]
[10912.633258, "o", "\t\t\toverrides[k] = v\r\n\t\tcase strings.HasPrefix(args[i], \"--param=\"):\r\n\t\t\tkv := strings.TrimPrefix(args[i], \"--param=\")\r\n\t\t\tk, v, ok := strings.Cut(kv, \"=\")\r\n\t\t\tif !ok {\r\n\t\t\t\treturn \"\", nil, 0, fmt.Errorf(\"--param requires key=value\")\r\n\t\t\t}\r\n\t\t\toverrides[k] = v\r\n\t\tdefault:\r\n"]
[10912.633322, "o", "\t\t\tif configPath == \"\" && !strings.HasPrefix(args[i], \"--\") {\r\n\t\t\t\tconfigPath = args[i]\r\n\t\t\t} else {\r\n\t\t\t\treturn \"\", nil, 0, fmt.Errorf(\"unknown flag: %s\", args[i])\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif configPath == \"\" {\r\n\t\treturn \"\", nil, 0, fmt.Errorf(\"usage: mlpipe plan <config.json> [--param key=value ...] [--cv K]\")\r\n\t}\r\n\treturn configPath, overrides, cv, nil\r\n}\r\n"]
[10912.633383, "o", "\r\nfunc splitNameVersion(s string) (string, int, bool) {\r\n\tparts := strings.SplitN(s, \":\", 2)\r\n\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n\t\treturn \"\", 0, false\r\n\t}\r\n\tvar version int\r\n\tif _, err := fmt.Sscanf(parts[1], \"%d\", &version); err != nil {\r\n\t\treturn \"\", 0, false\r\n\t}\r\n\treturn parts[0], version, true\r\n"]
[10912.633456, "o", "}\r\n\r\nfunc printJSON(v interface{}) {\r\n\tdata, err := json.MarshalIndent(v, \"\", \"  \")\r\n\tif err != nil {\r\n\t\tprintError(err.Error())\r\n\t\treturn\r\n\t}\r\n\tfmt.Println(string(data))\r\n}\r\n\r\n"]
