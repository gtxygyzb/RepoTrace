[1943.148178, "i", "python3 - <<'PY'\nimport re\np='train.go'\ns=open(p).read()\n# Patch trainDecisionTree to track feature indices\npat=re.compile(r'func trainDecisionTree\\(X \\[\\]\\[\\]float64, y \\[\\]float64, features \\[\\]string, classification bool, depth, maxDepth, minSplit int\\) \\*TreeNode \\{.*?\\n\\}', re.S)\nnew='''func trainDecisionTree(X [][]float64, y []float64, features []string, classification bool, depth, maxDepth, minSplit int) *TreeNode {\n    idx := make([]int, len(features))\n    for i := range features {\n        idx[i] = i\n    }\n    return trainDecisionTreeFeatures(X, y, features, idx, classification, depth, maxDepth, minSplit)\n}\n\nfunc trainDecisionTreeFeatures(X [][]float64, y []float64, features []string, featureIdx []int, classification bool, depth, maxDepth, minSplit int) *TreeNode {\n    node := &TreeNode{}\n    if len(y) == 0 {\n        node.IsLeaf = true\n        return node\n    }\n    mean := 0.0\n    for _, v := range y {\n        mean += v\n    }\n    mean /= float64(len(y))\n\n    if depth >= maxDepth || len(y) < minSplit |"]
[1943.148401, "i", "| len(featureIdx) == 0 {\n        node.IsLeaf = true\n        node.Prediction = mean\n        if classification {\n            node.Probability = mean\n        }\n        return node\n    }\n\n    bestGain := 0.0\n    bestFeaturePos := -1\n    bestFeatureIdx := -1\n    bestThreshold := 0.0\n    bestLeftIdx := []int(nil)\n    bestRightIdx := []int(nil)\n\n    impurity := giniOrVariance(y, classification)\n    for pos, j := range featureIdx {\n        values := make([]float64, len(X))\n        for i := 0; i < len(X); i++ {\n            values[i] = X[i][j]\n        }\n        sorted := uniqueFloats(values)\n        sort.Float64s(sorted)\n        for s := 0; s < len(sorted)-1; s++ {\n            threshold := (sorted[s] + sorted[s+1]) / 2\n            leftIdx := []int{}\n            rightIdx := []int{}\n            for i := 0; i < len(X); i++ {\n                if X[i][j] <= threshold {\n                    leftIdx = append(leftIdx, i)\n                } else {\n                    rightIdx = append(rightIdx, i)\n                }\n            }\n "]
[1943.148425, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[1943.148535, "i", "           if len(leftIdx) == 0 || len(rightIdx) == 0 {\n                continue\n            }\n            leftY := subsetY(y, leftIdx)\n            rightY := subsetY(y, rightIdx)\n            leftImp := giniOrVariance(leftY, classification)\n            rightImp := giniOrVariance(rightY, classification)\n            gain := impurity - (float64(len(leftY))*leftImp+float64(len(rightY))*rightImp)/float64(len(y))\n            if gain > bestGain {\n                bestGain = gain\n                bestFeaturePos = pos\n                bestFeatureIdx = j\n                bestThreshold = threshold\n                bestLeftIdx = leftIdx\n                bestRightIdx = rightIdx\n            }\n        }\n    }\n\n    if bestFeaturePos == -1 || bestGain <= 0 {\n        node.IsLeaf = true\n        node.Prediction = mean\n        if classification {\n            node.Probability = mean\n        }\n        return node\n    }\n\n    node.Feature = bestFeatureIdx\n    node.Threshold = bestThreshold\n    nextIdx := append([]int{}, featureIdx...)\n    n"]
[1943.148558, "o", "| len(featureIdx) == 0 {\r\n        node.IsLeaf = true\r\n        node.Prediction = mean\r\n        if classification {\r\n"]
