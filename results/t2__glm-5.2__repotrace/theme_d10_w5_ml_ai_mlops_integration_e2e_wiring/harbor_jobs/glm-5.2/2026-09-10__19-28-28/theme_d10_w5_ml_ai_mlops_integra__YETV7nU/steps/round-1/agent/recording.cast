[2094.337851, "i", "python3 - <<'PY'\np='train.go'\ns=open(p).read()\nold='''    nextIdx := append([]int{}, featureIdx...)\n    nextIdx = append(nextIdx[:bestFeaturePos], nextIdx[bestFeaturePos+1:]...)\n    leftX := subsetRows(X, bestLeftIdx)\n    rightX := subsetRows(X, bestRightIdx)\n    node.Left = trainDecisionTreeFeatures(leftX, subsetY(y, bestLeftIdx), features, nextIdx, classification, depth+1, maxDepth, minSplit)\n    node.Right = trainDecisionTreeFeatures(rightX, subsetY(y, bestRightIdx), features, nextIdx, classification, depth+1, maxDepth, minSplit)\n'''\nnew='''    leftX := subsetRows(X, bestLeftIdx)\n    rightX := subsetRows(X, bestRightIdx)\n    node.Left = trainDecisionTreeFeatures(leftX, subsetY(y, bestLeftIdx), features, featureIdx, classification, depth+1, maxDepth, minSplit)\n    node.Right = trainDecisionTreeFeatures(rightX, subsetY(y, bestRightIdx), features, featureIdx, classification, depth+1, maxDepth, minSplit)\n'''\nif old not in s:\n    raise SystemExit('pattern not found')\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY"]
[2094.338148, "i", "\n"]
[2094.338281, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
