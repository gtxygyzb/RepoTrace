   326	func parseRunArgs(args []string) (string, map[string]string, int, bool, []string, error) {
   327		configPath := ""
   328		overrides := map[string]string{}
   329		cv := 0
   330		noCache := false
   331		var skipStages []string
   332		for i := 0; i < len(args); i++ {
   333			switch {
   334			case args[i] == "--cv":
   335				if i+1 >= len(args) {
   336					return "", nil, 0, false, nil, fmt.Errorf("--cv requires a value")
   337				}
   338				k, err := strconv.Atoi(args[i+1])
   339				if err != nil {
   340					return "", nil, 0, false, nil, fmt.Errorf("invalid cv folds: %s", args[i+1])
   341				}
   342				if k < 2 {
   343					return "", nil, 0, false, nil, fmt.Errorf("cv folds must be >= 2")
   344				}
   345				cv = k
   346				i++
   347			case strings.HasPrefix(args[i], "--cv="):
   348				val := strings.TrimPrefix(args[i], "--cv=")
   349				k, err := strconv.Atoi(val)
   350				if err != nil {
   351					return "", nil, 0, false, nil, fmt.Errorf("invalid cv folds: %s", val)
   352				}
   353				if k < 2 {
   354					return "", nil, 0, false, nil, fmt.Errorf("cv folds must be >= 2")
   355				}
   356				cv = k
   357			case args[i] == "--no-cache":
   358				noCache = true
   359			case args[i] == "--param":
   360				if i+1 >= len(args) {
   361					return "", nil, 0, false, nil, fmt.Errorf("--param requires key=value")
   362				}
   363				kv := args[i+1]
   364				i++
   365				k, v, ok := strings.Cut(kv, "=")
   366				if !ok {
   367					return "", nil, 0, false, nil, fmt.Errorf("--param requires key=value")
   368				}
   369				overrides[k] = v
   370			case strings.HasPrefix(args[i], "--param="):
   371				kv := strings.TrimPrefix(args[i], "--param=")
   372				k, v, ok := strings.Cut(kv, "=")
   373				if !ok {
   374					return "", nil, 0, false, nil, fmt.Errorf("--param requires key=value")
   375				}
   376				overrides[k] = v
   377			case args[i] == "--skip-stage":
   378				if i+1 >= len(args) {
   379					return "", nil, 0, false, nil, fmt.Errorf("--skip-stage requires a value")
   380				}
   381				skipStages = append(skipStages, args[i+1])
   382				i++
   383			case strings.HasPrefix(args[i], "--skip-stage="):
   384				skipStages = append(skipStages, strings.TrimPrefix(args[i], "--skip-stage="))
   385			default:
   386				if configPath == "" && !strings.HasPrefix(args[i], "--") {
   387					configPath = args[i]
   388				} else {
   389					return "", nil, 0, false, nil, fmt.Errorf("unknown flag: %s", args[i])
   390				}
   391			}
   392		}
   393		if configPath == "" {
   394			return "", nil, 0, false, nil, fmt.Errorf("usage: mlpipe run <config.json> [--param key=value ...] [--cv K] [--no-cache] [--skip-stage name ...]")
   395		}
   396		return configPath, overrides, cv, noCache, skipStages, nil
   397	}
