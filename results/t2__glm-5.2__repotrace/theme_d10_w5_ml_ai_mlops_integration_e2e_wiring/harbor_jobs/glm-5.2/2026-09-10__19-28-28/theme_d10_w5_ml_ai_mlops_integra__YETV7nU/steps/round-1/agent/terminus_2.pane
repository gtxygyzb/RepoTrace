func (e *Executor) RunCV() (*CVRunOutput, error) {
    if e.cvFolds < 2 {
        return nil, fmt.Errorf("cv folds must be >= 2")
    }

    valid, errs := e.config.Validate()
    if !valid {
        return nil, fmt.Errorf("%s", strings.Join(errs, "; "))
    }
    if err := e.config.validateCV(); err != nil {
        return nil, err
    }

    order, err := e.config.topologicalOrder()
    if err != nil {
        return nil, err
    }

    splitName, _ := e.config.splitStageName()
    postSplit := e.config.postSplitStages(splitName)
    preSplitOrder := []string{}
    postSplitOrder := []string{}
    for _, name := range order {
        if postSplit[name] {
            postSplitOrder = append(postSplitOrder, name)
        } else {
            preSplitOrder = append(preSplitOrder, name)
        }
    }

    allArtifacts := map[string]*ArtifactOutput{}

    for _, name := range preSplitOrder {
        e.executeStageCached(name, -1, 0, allArtifacts)
    }

    foldResults := make([]CVFoldResult, e.cvFolds)
    foldMetrics := make([]map[string]float64, e.cvFolds)

    for i := 0; i < e.cvFolds; i++ {
        foldExec := &Executor{
            config:    e.config,
            globals:   e.globals,
            status:    map[string]string{},
            results:   map[string]*StageResult{},
            outputs:   map[string]map[string]string{},
            values:    map[string]map[string]*ArtifactValue{},
            meta:      e.meta,
            cacheKeys: map[string]string{},
            noCache:   e.noCache,
            cvFolds:    e.cvFolds,
            cacheStats: e.cacheStats,
        }
        for name, st := range e.status {
            foldExec.status[name] = st
        }
        for name, outs := range e.outputs {
            foldExec.outputs[name] = copyStringMap(outs)
        }
        for name, vals := range e.values {
            foldExec.values[name] = copyValueMap(vals)
        }
        for name, key := range e.cacheKeys {
            foldExec.cacheKeys[name] = key
        }

        foldArtifacts := map[string]*ArtifactOutput{}
        for _, name := range postSplitOrder {
            foldExec.executeStageCached(name, i, e.cvFolds, foldArtifacts)
        }

        foldStatus := "success"
        for _, r := range foldExec.results {
            if r.Status != "success" {
                foldStatus = "failed"
                break
            }
        }

        for id, art := range foldArtifacts {
            allArtifacts[id] = art
        }

        foldResults[i] = CVFoldResult{
            Fold:   i,
            Status: foldStatus,
            Stages: foldExec.results,
        }

        foldMetric := map[string]float64{}
        metricSums := map[string]float64{}
        metricCounts := map[string]int{}
        for _, name := range postSplitOrder {
            stage, _ := e.config.stageByName(name)
            if stage.Type != "evaluate" {
                continue
            }
            r, ok := foldExec.results[name]
            if !ok || r.Status != "success" {
                continue
            }
