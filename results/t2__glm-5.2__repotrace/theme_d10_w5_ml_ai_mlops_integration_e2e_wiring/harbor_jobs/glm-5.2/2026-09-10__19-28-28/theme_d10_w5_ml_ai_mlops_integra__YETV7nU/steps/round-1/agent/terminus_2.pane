    13	type RegistryEntry struct {
    14		Name           string                 `json:"name"`
    15		Version        int                    `json:"version"`
    16		Stage          string                 `json:"stage"`
    17		Tags           []string               `json:"tags"`
    18		Metrics        map[string]interface{} `json:"metrics"`
    19		Hyperparams    map[string]interface{} `json:"hyperparams"`
    20		ArtifactRefs   map[string]string      `json:"artifact_refs"`
    21		PromotionRules map[string]interface{} `json:"promotion_rules"`
    22		RegisteredAt   string                 `json:"registered_at"`
