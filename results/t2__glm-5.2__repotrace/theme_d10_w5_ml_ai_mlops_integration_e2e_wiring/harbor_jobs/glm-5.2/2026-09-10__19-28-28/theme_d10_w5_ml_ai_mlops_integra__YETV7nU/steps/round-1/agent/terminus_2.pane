    73	func buildRunRecord(executor *Executor, startedAt time.Time, finishedAt time.Time, status string) *RunRecord {
    74		mode := "standard"
    75		var cvFolds *int
    76		if executor.cvFolds > 0 {
    77			mode = "cv"
    78			f := executor.cvFolds
    79			cvFolds = &f
    80		}
    81	
    82		skipped := []string{}
    83		skipped = append(skipped, executor.skipStages...)
    84	
    85		summary := map[string]StageSummary{}
    86		for name, r := range executor.results {
    87			if r == nil {
    88				continue
    89			}
    90			summary[name] = StageSummary{
    91				Status:     r.Status,
    92				CacheHit:   r.CacheHit,
    93				DurationMs: r.DurationMs,
    94			}
    95		}
    96	
    97		var cacheStats *CacheStats
    98		if !executor.noCache {
    99			cacheStats = executor.cacheStats
   100			if cacheStats == nil {
   101				cacheStats = &CacheStats{}
   102			}
   103		}
   104	
   105		return &RunRecord{
   106			RunID:         strconv.FormatInt(finishedAt.UnixMilli(), 10),
   107			Pipeline:      executor.config.Pipeline.Name,
   108			StartedAt:     startedAt.UTC().Format(time.RFC3339),
   109			FinishedAt:    finishedAt.UTC().Format(time.RFC3339),
   110			DurationMs:    finishedAt.Sub(startedAt).Milliseconds(),
   111			Status:        status,
   112			Mode:          mode,
   113			CvFolds:       cvFolds,
   114			NoCache:       executor.noCache,
   115			SkippedStages: skipped,
   116			StageSummary:  summary,
   117			CacheStats:    cacheStats,
   118		}
   119	}
