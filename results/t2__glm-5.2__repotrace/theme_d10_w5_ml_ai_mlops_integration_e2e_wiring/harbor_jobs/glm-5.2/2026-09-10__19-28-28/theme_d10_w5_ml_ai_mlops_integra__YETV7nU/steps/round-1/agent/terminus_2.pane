[?2004lfunc parseRunArgs(args []string) (string, map[string]string, int, bool, error) {
	configPath := ""
	overrides := map[string]string{}
	cv := 0
	noCache := false
	for i := 0; i < len(args); i++ {
		switch {
		case args[i] == "--cv":
			if i+1 >= len(args) {
				return "", nil, 0, false, fmt.Errorf("--cv requires a value")
			}
			k, err := strconv.Atoi(args[i+1])
			if err != nil {
				return "", nil, 0, false, fmt.Errorf("invalid cv folds: %s", args[i+1])
			}
			if k < 2 {
				return "", nil, 0, false, fmt.Errorf("cv folds must be >= 2")
			}
			cv = k
			i++
		case strings.HasPrefix(args[i], "--cv="):
			val := strings.TrimPrefix(args[i], "--cv=")
			k, err := strconv.Atoi(val)
			if err != nil {
				return "", nil, 0, false, fmt.Errorf("invalid cv folds: %s", val)
			}
			if k < 2 {
				return "", nil, 0, false, fmt.Errorf("cv folds must be >= 2")
			}
			cv = k
		case args[i] == "--no-cache":
			noCache = true
		case args[i] == "--param":
			if i+1 >= len(args) {
				return "", nil, 0, false, fmt.Errorf("--param requires key=value")
			}
			kv := args[i+1]
			i++
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				return "", nil, 0, false, fmt.Errorf("--param requires key=value")
			}
			overrides[k] = v
		case strings.HasPrefix(args[i], "--param="):
			kv := strings.TrimPrefix(args[i], "--param=")
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				return "", nil, 0, false, fmt.Errorf("--param requires key=value")
			}
			overrides[k] = v
		default:
			if configPath == "" && !strings.HasPrefix(args[i], "--") {
				configPath = args[i]
			} else {
				return "", nil, 0, false, fmt.Errorf("unknown flag: %s", args[i])
			}
		}
	}
	if configPath == "" {
		return "", nil, 0, false, fmt.Errorf("usage: mlpipe run <config.json> [--param key=value ...] [--cv K] [--no-cache]")
	}
	return configPath, overrides, cv, noCache, nil
}

