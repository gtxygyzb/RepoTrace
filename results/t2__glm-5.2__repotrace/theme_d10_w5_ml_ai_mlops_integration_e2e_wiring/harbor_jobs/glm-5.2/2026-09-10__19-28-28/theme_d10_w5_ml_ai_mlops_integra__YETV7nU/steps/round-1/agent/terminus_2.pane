    92	func cmdValidate(args []string) {
    93		configPath := ""
    94		overrides := map[string]string{}
    95		fail := func(msg string) {
    96			printJSON(map[string]interface{}{"valid": false, "errors": []string{msg}})
    97		}
    98		for i := 0; i < len(args); i++ {
    99			switch {
   100			case args[i] == "--param":
   101				if i+1 >= len(args) {
   102					fail("--param requires key=value")
   103					return
   104				}
   105				kv := args[i+1]
   106				i++
   107				k, v, ok := strings.Cut(kv, "=")
   108				if !ok {
   109					fail("--param requires key=value")
   110					return
   111				}
   112				overrides[k] = v
   113			case strings.HasPrefix(args[i], "--param="):
   114				kv := strings.TrimPrefix(args[i], "--param=")
   115				k, v, ok := strings.Cut(kv, "=")
   116				if !ok {
   117					fail("--param requires key=value")
   118					return
   119				}
   120				overrides[k] = v
   121			default:
   122				if configPath == "" && !strings.HasPrefix(args[i], "--") {
   123					configPath = args[i]
   124				} else {
   125					fail(fmt.Sprintf("unknown flag: %s", args[i]))
   126					return
   127				}
   128			}
   129		}
   130		if configPath == "" {
   131			fail("usage: mlpipe validate <config.json> [--param key=value ...]")
   132			return
   133		}
   134		config, err := loadConfig(configPath)
   135		if err != nil {
   136			fail(err.Error())
   137			return
   138		}
   139		if len(overrides) > 0 {
   140			globals := config.globalParams(overrides)
   141			config.Pipeline.Params = globals
   142			for i := range config.Stages {
   143				config.Stages[i].Params = config.stageParams(config.Stages[i].Name, globals)
   144			}
   145		}
