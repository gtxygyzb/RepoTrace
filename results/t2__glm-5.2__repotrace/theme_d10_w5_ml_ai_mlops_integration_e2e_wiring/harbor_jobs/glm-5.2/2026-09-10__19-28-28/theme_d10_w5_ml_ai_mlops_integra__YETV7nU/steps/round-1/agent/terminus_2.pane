    54			StagesRemoved:   []string{},
    55			StagesModified:  map[string]StageDiff{},
    56			StagesUnchanged: []string{},
    57		}
    58	
    59		if c1.Pipeline.Name != c2.Pipeline.Name {
    60			result.PipelineName = &FieldDiff{Old: c1.Pipeline.Name, New: c2.Pipeline.Name}
