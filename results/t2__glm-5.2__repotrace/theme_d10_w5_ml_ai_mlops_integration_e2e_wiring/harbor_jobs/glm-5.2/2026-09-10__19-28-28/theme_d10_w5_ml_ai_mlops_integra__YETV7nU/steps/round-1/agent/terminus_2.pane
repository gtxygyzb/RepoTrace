    56	func saveRunRecord(record *RunRecord) error {
    57		dir := filepath.Join(".mlpipe", "runs")
    58		if err := os.MkdirAll(dir, 0755); err != nil {
    59			return err
    60		}
    61		path := filepath.Join(dir, fmt.Sprintf("%s.json", record.RunID))
    62		data, err := json.MarshalIndent(record, "", "  ")
    63		if err != nil {
    64			return err
    65		}
    66		return os.WriteFile(path, data, 0644)
    67	}
    68	
    69	func runStatus(run interface{}) string {
    70		switch r := run.(type) {
    71		case *RunOutput:
    72			return r.Status
    73		case *CVRunOutput:
    74			return r.Status
    75		default:
    76			return "success"
    77		}
    78	}
