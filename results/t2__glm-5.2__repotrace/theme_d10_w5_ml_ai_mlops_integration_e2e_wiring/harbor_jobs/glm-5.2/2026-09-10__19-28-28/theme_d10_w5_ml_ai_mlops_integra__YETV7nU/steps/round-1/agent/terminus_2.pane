    39	func (e *Executor) RunCV() (*CVRunOutput, error) {
    40		if e.cvFolds < 2 {
    41			return nil, fmt.Errorf("cv folds must be >= 2")
    42		}
    43	
    44		valid, errs := e.config.Validate()
    45		if !valid {
    46			return nil, fmt.Errorf("%s", strings.Join(errs, "; "))
    47		}
    48		if err := e.config.validateCV(); err != nil {
    49			return nil, err
    50		}
    51	
    52		order, err := e.config.topologicalOrder()
    53		if err != nil {
    54			return nil, err
    55		}
    56	
    57		splitName, _ := e.config.splitStageName()
    58		postSplit := e.config.postSplitStages(splitName)
    59		preSplitOrder := []string{}
    60		postSplitOrder := []string{}
    61		for _, name := range order {
    62			if postSplit[name] {
    63				postSplitOrder = append(postSplitOrder, name)
    64			} else {
    65				preSplitOrder = append(preSplitOrder, name)
    66			}
    67		}
    68	
    69		allArtifacts := map[string]*ArtifactOutput{}
    70	
    71		for _, name := range preSplitOrder {
    72			e.executeStageCached(name, -1, 0, allArtifacts)
    73		}
    74	
    75		foldResults := make([]CVFoldResult, e.cvFolds)
    76		foldMetrics := make([]map[string]float64, e.cvFolds)
    77	
    78		for i := 0; i < e.cvFolds; i++ {
    79			foldExec := &Executor{
    80				config:     e.config,
    81				globals:    e.globals,
    82				status:     map[string]string{},
    83				results:    map[string]*StageResult{},
    84				outputs:    map[string]map[string]string{},
    85				values:     map[string]map[string]*ArtifactValue{},
    86				meta:       e.meta,
    87				cacheKeys:  map[string]string{},
    88				noCache:    e.noCache,
    89				cvFolds:    e.cvFolds,
    90				cacheStats: e.cacheStats,
    91			}
    92			for name, st := range e.status {
    93				foldExec.status[name] = st
    94			}
    95			for name, outs := range e.outputs {
    96				foldExec.outputs[name] = copyStringMap(outs)
    97			}
    98			for name, vals := range e.values {
    99				foldExec.values[name] = copyValueMap(vals)
   100			}
   210		}
   211	
   212		run := &CVRunOutput{
   213			Pipeline:    e.config.Pipeline.Name,
   214			Status:      status,
   215			CVFolds:     e.cvFolds,
   216			Stages:      e.results,
   217			FoldResults: foldResults,
