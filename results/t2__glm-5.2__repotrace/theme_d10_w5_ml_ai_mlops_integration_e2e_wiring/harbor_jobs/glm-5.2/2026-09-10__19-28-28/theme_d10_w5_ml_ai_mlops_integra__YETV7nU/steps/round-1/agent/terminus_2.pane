[?2004l	case "r2":
		mean := 0.0
		for _, v := range y {
			mean += v
		}
		mean /= n
		ssRes := 0.0
		ssTot := 0.0
		for i := range y {
			ssRes += (y[i] - preds[i]) * (y[i] - preds[i])
			ssTot += (y[i] - mean) * (y[i] - mean)
		}
		if ssTot == 0 {
			if ssRes == 0 {
				return 1.0, nil
			}
			return nil, nil
		}
		return 1 - ssRes/ssTot, nil
	case "mape":
		sum := 0.0
		count := 0.0
		for i := range y {
			if y[i] == 0 {
				continue
			}
			sum += math.Abs((y[i] - preds[i]) / y[i])
			count++
		}
		if count == 0 {
			return nil, nil
		}
		return sum / count * 100, nil
	}
	return nil, fmt.Errorf("unknown regression metric %q", name)
}
