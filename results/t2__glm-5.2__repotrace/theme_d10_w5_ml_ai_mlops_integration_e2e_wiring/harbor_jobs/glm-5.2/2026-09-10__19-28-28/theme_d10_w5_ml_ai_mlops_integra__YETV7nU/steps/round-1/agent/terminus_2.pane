    92	func cmdValidate(args []string) {
    93		configPath := ""
    94		overrides := map[string]string{}
    95		for i := 0; i < len(args); i++ {
    96			switch {
    97			case args[i] == "--param":
    98				if i+1 >= len(args) {
    99					printError("--param requires key=value")
   100					return
   101				}
   102				kv := args[i+1]
   103				i++
   104				k, v, ok := strings.Cut(kv, "=")
   105				if !ok {
   106					printError("--param requires key=value")
   107					return
   108				}
   109				overrides[k] = v
   110			case strings.HasPrefix(args[i], "--param="):
   111				kv := strings.TrimPrefix(args[i], "--param=")
   112				k, v, ok := strings.Cut(kv, "=")
   113				if !ok {
   114					printError("--param requires key=value")
   115					return
   116				}
   117				overrides[k] = v
   118			default:
   119				if configPath == "" && !strings.HasPrefix(args[i], "--") {
   120					configPath = args[i]
   121				} else {
   122					printError(fmt.Sprintf("unknown flag: %s", args[i]))
   123					return
   124				}
   125			}
   126		}
   127		if configPath == "" {
   128			printError("usage: mlpipe validate <config.json> [--param key=value ...]")
   129			return
   130		}
   131		config, err := loadConfig(configPath)
   132		if err != nil {
   133			printError(err.Error())
   134			return
   135		}
   136		if len(overrides) > 0 {
   137			globals := config.globalParams(overrides)
   138			config.Pipeline.Params = globals
   139			for i := range config.Stages {
   140				config.Stages[i].Params = config.stageParams(config.Stages[i].Name, globals)
   141			}
   142		}
   143		valid, errors := config.Validate()
   144		printJSON(map[string]interface{}{"valid": valid, "errors": errors})
   145	}
