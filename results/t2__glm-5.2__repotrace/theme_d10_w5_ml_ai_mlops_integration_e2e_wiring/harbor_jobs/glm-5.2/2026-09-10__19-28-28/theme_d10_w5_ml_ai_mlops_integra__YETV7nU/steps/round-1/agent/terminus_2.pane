   199	func outputPortType(stageType, port string) string {
   200		switch stageType {
   201		case "data-source", "transform":
   202			if port == "data" {
   203				return "dataset"
   204			}
   205		case "split":
   206			if port == "train" || port == "test" {
   207				return "dataset"
   208			}
   209		case "train":
   210			if port == "model" {
   211				return "model"
   212			}
   213			if port == "predictions" {
   214				return "dataset"
   215			}
   216		case "evaluate":
   217			if port == "report" {
   218				return "report"
   219			}
   220		case "register":
   221			if port == "entry" {
   222				return "entry"
   223			}
   224		case "ensemble":
   225			if port == "predictions" {
   226				return "dataset"
   227			}
   228			if port == "model" {
   229				return "model"
   230			}
   231		}
   232		return "unknown"
   233	}
