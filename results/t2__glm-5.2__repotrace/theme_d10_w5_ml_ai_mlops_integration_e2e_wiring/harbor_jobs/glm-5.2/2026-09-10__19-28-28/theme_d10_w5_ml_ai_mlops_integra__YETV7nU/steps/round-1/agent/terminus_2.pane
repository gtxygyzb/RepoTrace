    12	type Dataset struct {
    13		Columns []string   `json:"columns"`
    14		Types   []string   `json:"types"`
    15		Rows    [][]string `json:"rows"`
    16	}
    17	
    18	func loadDataset(path string, schema map[string]interface{}) (*Dataset, error) {
    19		f, err := os.Open(path)
    20		if err != nil {
    21			if os.IsNotExist(err) {
    22				return nil, fmt.Errorf("file not found: %s", path)
    23			}
    24			return nil, err
    25		}
    26		defer f.Close()
    27	
    28		r := csv.NewReader(f)
    29		records, err := r.ReadAll()
    30		if err != nil {
    31			return nil, err
    32		}
    33		if len(records) == 0 {
    34			return &Dataset{Columns: []string{}, Types: []string{}, Rows: [][]string{}}, nil
    35		}
    36	
    37		header := records[0]
    38		rows := records[1:]
    39		columns := header
    40		types := make([]string, len(columns))
    41		for i, col := range columns {
    42			if schemaType, ok := schema[col]; ok {
    43				types[i] = fmt.Sprintf("%v", schemaType)
    44			} else {
    45				types[i] = inferColumnType(rows, i)
    46			}
    47		}
    48		return &Dataset{Columns: columns, Types: types, Rows: rows}, nil
    49	}
    50	
    51	func inferColumnType(rows [][]string, idx int) string {
    52		for _, row := range rows {
    53			if idx >= len(row) {
    54				continue
    55			}
    56			val := strings.TrimSpace(row[idx])
    57			if val == "" {
    58				continue
    59			}
    60			if _, ok := parseFloat64(val); !ok {
    61				return "categorical"
    62			}
    63		}
    64		return "numeric"
    65	}
    66	
    67	func parseFloat64(s string) (float64, bool) {
    68		s = strings.TrimSpace(s)
    69		if s == "" {
    70			return 0, false
    71		}
    72		f, err := strconv.ParseFloat(s, 64)
    73		if err != nil {
    74			return 0, false
    75		}
    76		return f, true
    77	}
    78	
    79	func formatFloat(f float64) string {
    80		if math.IsNaN(f) {
    81			return "NaN"
    82		}
    83		if math.IsInf(f, 1) {
    84			return "+Inf"
    85		}
    86		if math.IsInf(f, -1) {
    87			return "-Inf"
    88		}
    89		return strconv.FormatFloat(f, 'g', -1, 64)
    90	}
    91	
    92	func (ds *Dataset) ColumnIndex(name string) (int, bool) {
    93		for i, c := range ds.Columns {
    94			if c == name {
    95				return i, true
    96			}
    97		}
    98		return -1, false
    99	}
   100	
   101	func (ds *Dataset) Copy() *Dataset {
   102		cols := append([]string{}, ds.Columns...)
   103		types := append([]string{}, ds.Types...)
   104		rows := make([][]string, len(ds.Rows))
   105		for i, row := range ds.Rows {
   106			rows[i] = append([]string{}, row...)
   107		}
   108		return &Dataset{Columns: cols, Types: types, Rows: rows}
   109	}
   110	
   111	func (ds *Dataset) Summary() map[string]interface{} {
   112		return map[string]interface{}{
   113			"rows":         len(ds.Rows),
   114			"columns":      len(ds.Columns),
   115			"column_names": ds.Columns,
   116			"column_types": ds.Types,
   117		}
   118	}
   119	
   120	func (ds *Dataset) NumericColumn(name string) ([]float64, error) {
   121		idx, ok := ds.ColumnIndex(name)
   122		if !ok {
   123			return nil, fmt.Errorf("column not found: %s", name)
   124		}
   125		if idx < len(ds.Types) && ds.Types[idx] != "numeric" {
   126			return nil, fmt.Errorf("column is not numeric: %s", name)
   127		}
   128		vals := make([]float64, len(ds.Rows))
   129		for i, row := range ds.Rows {
   130			if idx >= len(row) {
   131				return nil, fmt.Errorf("row %d missing column %s", i, name)
   132			}
   133			f, ok := parseFloat64(row[idx])
   134			if !ok {
   135				return nil, fmt.Errorf("non-numeric value in column %s: %s", name, row[idx])
   136			}
   137			vals[i] = f
   138		}
   139		return vals, nil
   140	}
   141	
   142	func (ds *Dataset) ColumnValues(name string) ([]string, error) {
   143		idx, ok := ds.ColumnIndex(name)
   144		if !ok {
   145			return nil, fmt.Errorf("column not found: %s", name)
   146		}
   147		vals := make([]string, len(ds.Rows))
   148		for i, row := range ds.Rows {
   149			if idx >= len(row) {
   150				return nil, fmt.Errorf("row %d missing column %s", i, name)
   151			}
   152			vals[i] = row[idx]
   153		}
   154		return vals, nil
   155	}
   156	
   157	func (ds *Dataset) featureMatrix(features []string) ([][]float64, error) {
   158		cols := make([]int, len(features))
   159		for i, f := range features {
   160			idx, ok := ds.ColumnIndex(f)
   161			if !ok {
   162				return nil, fmt.Errorf("feature column not found: %s", f)
   163			}
   164			if idx < len(ds.Types) && ds.Types[idx] != "numeric" {
   165				return nil, fmt.Errorf("feature column is not numeric: %s", f)
   166			}
   167			cols[i] = idx
   168		}
   169		X := make([][]float64, len(ds.Rows))
   170		for i, row := range ds.Rows {
   171			X[i] = make([]float64, len(features))
   172			for j, idx := range cols {
   173				if idx >= len(row) {
   174					return nil, fmt.Errorf("row %d missing column %s", i, features[j])
   175				}
   176				f, ok := parseFloat64(row[idx])
   177				if !ok {
   178					return nil, fmt.Errorf("non-numeric value in feature column %s: %s", features[j], row[idx])
   179				}
   180				X[i][j] = f
   181			}
   182		}
   183		return X, nil
   184	}
   185	
   186	func (ds *Dataset) setColumnValues(name string, values []string, typ string) {
   187		idx, ok := ds.ColumnIndex(name)
   188		if !ok {
   189			ds.Columns = append(ds.Columns, name)
   190			ds.Types = append(ds.Types, typ)
   191			for i, row := range ds.Rows {
   192				if i < len(values) {
   193					ds.Rows[i] = append(row, values[i])
   194				} else {
   195					ds.Rows[i] = append(row, "")
   196				}
   197			}
   198			return
   199		}
   200		if idx < len(ds.Types) {
   201			ds.Types[idx] = typ
   202		}
   203		for i, row := range ds.Rows {
   204			if i < len(values) && idx < len(row) {
   205				row[idx] = values[i]
   206			} else if i < len(values) {
   207				for len(row) <= idx {
   208					row = append(row, "")
   209				}
   210				row[idx] = values[i]
   211				ds.Rows[i] = row
   212			}
   213		}
   214	}
