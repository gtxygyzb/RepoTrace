    49	func executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
    50		var ds *Dataset
    51		for _, in := range inputs {
    52			if in != nil && in.Dataset != nil {
    53				ds = in.Dataset
    54				break
    55			}
    56		}
    57		if ds == nil {
    58			return nil, fmt.Errorf("train stage %q requires input data", stage.Name)
    59		}
    60	
    61		algorithm, ok := getString(params, "algorithm")
    62		if !ok {
    63			return nil, fmt.Errorf("train stage %q requires algorithm", stage.Name)
    64		}
    65		target, ok := getString(params, "target")
    66		if !ok {
    67			return nil, fmt.Errorf("train stage %q requires target", stage.Name)
    68		}
    69		targetVals, err := ds.NumericColumn(target)
    70		if err != nil {
    71			return nil, err
    72		}
    73		classification := isBinary01(targetVals)
    74		if algorithm == "linear-regression" {
    75			classification = false
    76		}
    77		if algorithm == "logistic-regression" {
    78			classification = true
    79		}
    80	
    81		features, ok := getStringSlice(params, "features")
    82		if !ok || len(features) == 0 {
    83			features = []string{}
    84			for i, col := range ds.Columns {
    85				if col == target {
    86					continue
    87				}
    88				if i < len(ds.Types) && ds.Types[i] == "numeric" {
    89					features = append(features, col)
    90				}
    91			}
    92		}
    93		X, err := ds.featureMatrix(features)
    94		if err != nil {
    95			return nil, err
    96		}
    97		y := targetVals
    98	
    99		hp := getMapDefault(params, "hyperparams", map[string]interface{}{})
   100		model := &Model{Algorithm: algorithm, Target: target, Features: features, Hyperparams: hp, Classification: classification, TrainFeatures: X, TrainTarget: y}
   101	
   102		switch algorithm {
   103		case "linear-regression":
   104			w, err := trainLinearRegression(X, y)
   105			if err != nil {
   106				return nil, err
   107			}
   108			model.LinearWeights = w
   109		case "logistic-regression":
   110			lr := getFloatDefault(hp, "learning_rate", 0.01)
   111			epochs := getIntDefault(hp, "epochs", 1000)
   112			w, err := trainLogisticRegression(X, y, lr, epochs)
   113			if err != nil {
   114				return nil, err
   115			}
   116			model.LogisticWeights = w
   117		case "decision-tree":
   118			maxDepth := getIntDefault(hp, "max_depth", 10)
   119			minSplit := getIntDefault(hp, "min_samples_split", 2)
   120			model.Tree = trainDecisionTree(X, y, features, classification, 0, maxDepth, minSplit)
   121		case "random-forest":
   122			nEst := getIntDefault(hp, "n_estimators", 10)
   123			maxDepth := getIntDefault(hp, "max_depth", 10)
   124			maxFeatures := getStringDefault(hp, "max_features", "sqrt")
   125			model.Forest = trainRandomForest(X, y, features, classification, nEst, maxDepth, maxFeatures, stage.Name)
   126		case "gradient-boost":
   127			nEst := getIntDefault(hp, "n_estimators", 100)
   128			lr := getFloatDefault(hp, "learning_rate", 0.1)
   129			maxDepth := getIntDefault(hp, "max_depth", 3)
   130			model.Boost = trainGradientBoost(X, y, classification, nEst, lr, maxDepth)
   131		case "knn":
   132			k := getIntDefault(hp, "k", 5)
   133			if k <= 0 {
   134				k = 1
   135			}
   136			model.KNN = &KNNModel{K: k, Features: X, Targets: y, Classification: classification}
   137		default:
   138			return nil, fmt.Errorf("unsupported algorithm: %s", algorithm)
   139		}
   140	
   141		preds := model.PredictBatch(X)
   142		predRows := make([][]string, len(ds.Rows))
   143		for i := range ds.Rows {
   144			row := append([]string{}, ds.Rows[i]...)
   145			row = append(row, formatFloat(preds[i]))
   146			predRows[i] = row
   147		}
   148		predDS := &Dataset{
   149			Columns: append(append([]string{}, ds.Columns...), "prediction"),
   150			Types:   append(append([]string{}, ds.Types...), "numeric"),
   151			Rows:    predRows,
   152		}
   153	
   154		return map[string]*ArtifactValue{"model": {Model: model}, "predictions": {Dataset: predDS}}, nil
   155	}
   156	
   157	func isBinary01(vals []float64) bool {
   158		for _, v := range vals {
   159			if v != 0 && v != 1 {
   160				return false
   161			}
   162		}
   163		return true
   164	}
