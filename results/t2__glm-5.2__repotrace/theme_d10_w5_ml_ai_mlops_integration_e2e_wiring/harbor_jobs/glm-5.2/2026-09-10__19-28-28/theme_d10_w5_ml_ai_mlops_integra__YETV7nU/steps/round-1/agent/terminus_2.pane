    if ds == nil {
        return nil, fmt.Errorf("train stage %q requires input data", stage.Name)
    }

    algorithm, ok := getString(params, "algorithm")
    if !ok {
        return nil, fmt.Errorf("train stage %q requires algorithm", stage.Name)
    }
    target, ok := getString(params, "target")
    if !ok {
        return nil, fmt.Errorf("train stage %q requires target", stage.Name)
    }
    targetVals, err := ds.NumericColumn(target)
    if err != nil {
        return nil, err
    }
    classification := isBinary01(targetVals)
    if algorithm == "linear-regression" {
        classification = false
    }
    if algorithm == "logistic-regression" {
        classification = true
    }

    features, ok := getStringSlice(params, "features")
    if !ok || len(features) == 0 {
        features = []string{}
        for i, col := range ds.Columns {
            if col == target {
                continue
            }
            if i < len(ds.Types) && ds.Types[i] == "numeric" {
                features = append(features, col)
            }
        }
    }
    X, err := ds.featureMatrix(features)
    if err != nil {
        return nil, err
    }
    y := targetVals

    hp := getMapDefault(params, "hyperparams", map[string]interface{}{})
    model := &Model{Algorithm: algorithm, Target: target, Features: features, Hyperparams: hp, Classification: classification, TrainFeatures: X, TrainTarget: y}

    switch algorithm {
    case "linear-regression":
        w, err := trainLinearRegression(X, y)
        if err != nil {
            return nil, err
        }
        model.LinearWeights = w
    case "logistic-regression":
        lr := getFloatDefault(hp, "learning_rate", 0.01)
        epochs := getIntDefault(hp, "epochs", 1000)
        w, err := trainLogisticRegression(X, y, lr, epochs)
        if err != nil {
            return nil, err
        }
        model.LogisticWeights = w
    case "decision-tree":
        maxDepth := getIntDefault(hp, "max_depth", 10)
        minSplit := getIntDefault(hp, "min_samples_split", 2)
        model.Tree = trainDecisionTree(X, y, features, classification, 0, maxDepth, minSplit)
    case "random-forest":
        nEst := getIntDefault(hp, "n_estimators", 10)
        maxDepth := getIntDefault(hp, "max_depth", 10)
        maxFeatures := getStringDefault(hp, "max_features", "sqrt")
        model.Forest = trainRandomForest(X, y, features, classification, nEst, maxDepth, maxFeatures, stage.Name)
    case "gradient-boost":
        nEst := getIntDefault(hp, "n_estimators", 100)
        lr := getFloatDefault(hp, "learning_rate", 0.1)
        maxDepth := getIntDefault(hp, "max_depth", 3)
        model.Boost = trainGradientBoost(X, y, classification, nEst, lr, maxDepth)
    case "knn":
        k := getIntDefault(hp, "k", 5)
        if k <= 0 {
            k = 1
        }
        model.KNN = &KNNModel{K: k, Features: X, Targets: y, Classification: classification}
