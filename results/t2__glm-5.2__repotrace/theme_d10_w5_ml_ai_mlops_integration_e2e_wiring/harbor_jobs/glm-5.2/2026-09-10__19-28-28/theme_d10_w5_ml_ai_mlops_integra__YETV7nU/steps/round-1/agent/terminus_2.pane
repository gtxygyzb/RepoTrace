     8	func executeSplit(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
     9		var ds *Dataset
    10		for _, in := range inputs {
    11			if in != nil && in.Dataset != nil {
    12				ds = in.Dataset
    13				break
    14			}
    15		}
    16		if ds == nil {
    17			return nil, fmt.Errorf("split stage %q requires input data", stage.Name)
    18		}
    19	
    20		ratio, ok := getFloat(params, "ratio")
    21		if !ok || ratio <= 0 || ratio >= 1 {
    22			return nil, fmt.Errorf("split stage %q requires ratio in (0,1)", stage.Name)
    23		}
    24		seed, ok := getInt(params, "seed")
    25		if !ok {
    26			seed = 0
    27		}
    28		stratify, _ := getString(params, "stratify")
    29	
    30		train := ds.Copy()
    31		train.Rows = nil
    32		test := ds.Copy()
    33		test.Rows = nil
    34	
    35		appendRow := func(dst *Dataset, src []string) {
    36			dst.Rows = append(dst.Rows, append([]string{}, src...))
    37		}
    38	
    39		if stratify == "" {
    40			perm := rand.New(rand.NewSource(int64(seed))).Perm(len(ds.Rows))
    41			trainCount := int(float64(len(ds.Rows)) * ratio)
    42			for i, idx := range perm {
    43				if i < trainCount {
    44					appendRow(train, ds.Rows[idx])
    45				} else {
    46					appendRow(test, ds.Rows[idx])
    47				}
    48			}
    49		} else {
    50			idx, ok := ds.ColumnIndex(stratify)
    51			if !ok {
    52				return nil, fmt.Errorf("stratify column not found: %s", stratify)
    53			}
    54			classes := map[string][]int{}
    55			for i, row := range ds.Rows {
    56				val := ""
    57				if idx < len(row) {
    58					val = row[idx]
    59				}
    60				classes[val] = append(classes[val], i)
    61			}
    62			classNames := make([]string, 0, len(classes))
    63			for c := range classes {
    64				classNames = append(classNames, c)
    65			}
    66			// deterministic class order
    67			sortStrings(classNames)
    68			rng := rand.New(rand.NewSource(int64(seed)))
    69			for _, c := range classNames {
    70				rows := classes[c]
    71				perm := rng.Perm(len(rows))
    72				trainCount := int(float64(len(rows)) * ratio)
    73				for i, p := range perm {
    74					srcIdx := rows[p]
    75					if i < trainCount {
    76						appendRow(train, ds.Rows[srcIdx])
    77					} else {
    78						appendRow(test, ds.Rows[srcIdx])
    79					}
    80				}
    81			}
    82		}
    83	
    84		return map[string]*ArtifactValue{"train": {Dataset: train}, "test": {Dataset: test}}, nil
    85	}
    86	
    87	func sortStrings(s []string) {
    88		for i := 1; i < len(s); i++ {
    89			for j := i; j > 0 && s[j-1] > s[j]; j-- {
    90				s[j-1], s[j] = s[j], s[j-1]
    91			}
    92		}
    93	}
