   278	func (e *Executor) inputCacheKeys(stage *StageConfig) map[string]string {
   279		keys := map[string]string{}
   280		for local, ref := range stage.Inputs {
   281			refs, ok := inputRefs(ref)
   282			if !ok {
   283				continue
   284			}
   285			sortedRefs := append([]string(nil), refs...)
   286			sort.Strings(sortedRefs)
   287			var parts []string
   288			for _, r := range sortedRefs {
   289				p := strings.SplitN(r, ".", 2)
   290				if len(p) != 2 {
   291					continue
   292				}
   293				depStage := p[0]
   294				if key, ok := e.cacheKeys[depStage]; ok {
   295					parts = append(parts, key)
   296				}
   297			}
   298			if len(parts) > 0 {
   299				keys[local] = strings.Join(parts, "\n")
   300			}
   301		}
   302		return keys
   303	}
   304	
   305	func (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {
   306		inputs := map[string]*ArtifactValue{}
   307		ids := []string{}
   308		for local, ref := range stage.Inputs {
   309			refs, ok := inputRefs(ref)
   310			if !ok {
   311				return nil, nil, fmt.Errorf("stage %q input %q has invalid reference %v", stage.Name, local, ref)
   312			}
   313			var firstVal *ArtifactValue
   314			for _, r := range refs {
   315				parts := strings.SplitN(r, ".", 2)
   316				if len(parts) != 2 {
   317					return nil, nil, fmt.Errorf("stage %q has invalid input reference %q", stage.Name, r)
   318				}
   319				depStage, port := parts[0], parts[1]
   320				id, ok := e.outputs[depStage][port]
   321				if !ok {
   322					return nil, nil, fmt.Errorf("stage %q input %q references unavailable output %s.%s", stage.Name, local, depStage, port)
   323				}
   324				val, ok := e.values[depStage][port]
   325				if !ok || val == nil {
   326					return nil, nil, fmt.Errorf("stage %q input %q references unavailable artifact %s.%s", stage.Name, local, depStage, port)
   327				}
   328				ids = append(ids, id)
   329				if firstVal == nil {
   330					firstVal = val
   331				}
   332				if stage.Type == "ensemble" && local == "models" {
   333					inputs[local+"_"+r] = val
   334				}
   335			}
   336			if _, exists := inputs[local]; !exists {
   337				inputs[local] = firstVal
   338			}
