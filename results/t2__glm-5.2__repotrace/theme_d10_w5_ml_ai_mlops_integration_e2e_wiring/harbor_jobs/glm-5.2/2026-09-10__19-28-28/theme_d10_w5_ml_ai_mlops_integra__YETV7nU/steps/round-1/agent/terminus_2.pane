   235	func cmdRegistryPromote(args []string) {
   236		var positionals []string
   237		force := false
   238		for _, a := range args {
   239			if a == "--force" {
   240				force = true
   241				continue
   242			}
   243			if strings.HasPrefix(a, "--") {
   244				printError(fmt.Sprintf("unknown flag: %s", a))
   245				return
   246			}
   247			positionals = append(positionals, a)
   248		}
   249		if len(positionals) < 2 {
   250			printError("usage: mlpipe registry promote <name>:<version> <target_stage> [--force]")
   251			return
   252		}
   253		name, version, ok := splitNameVersion(positionals[0])
   254		if !ok {
   255			printError("invalid name:version format")
   256			return
   257		}
   258		target := positionals[1]
   259		entry, prev, new, warnings, err := promoteModel(name, version, target, force)
   260		if err != nil {
   261			if strings.HasPrefix(err.Error(), "metric ") {
   262				printJSON(map[string]interface{}{"success": false, "message": err.Error()})
   263				return
   264			}
   265			printError(err.Error())
   266			return
   267		}
   268		message := fmt.Sprintf("promoted to %s", new)
   269		if force {
   270			message = fmt.Sprintf("promoted to %s (forced)", new)
   271		}
   272		result := map[string]interface{}{
   273			"success":        true,
   274			"message":        message,
   275			"previous_stage": prev,
   276			"new_stage":      entry.Stage,
   277		}
   278		if force {
   279			result["warnings"] = warnings
   280		}
