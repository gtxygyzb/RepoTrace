   497	func artifactsPath() string {
   498		return filepath.Join(".mlpipe", "artifacts.json")
   499	}
   500	
   501	func loadArtifacts() (map[string]*ArtifactMeta, error) {
   502		data, err := os.ReadFile(artifactsPath())
   503		if err != nil {
   504			if os.IsNotExist(err) {
   505				return map[string]*ArtifactMeta{}, nil
   506			}
   507			return nil, err
   508		}
   509		var m map[string]*ArtifactMeta
   510		if err := json.Unmarshal(data, &m); err != nil {
   511			return nil, err
   512		}
   513		if m == nil {
   514			m = map[string]*ArtifactMeta{}
   515		}
   516		return m, nil
   517	}
   518	
   519	func saveArtifacts(newMeta map[string]*ArtifactMeta) error {
   520		existing, err := loadArtifacts()
   521		if err != nil {
   522			return err
   523		}
   524		for k, v := range newMeta {
   525			existing[k] = v
   526		}
   527		if err := os.MkdirAll(".mlpipe", 0755); err != nil {
   528			return err
   529		}
   530		data, err := json.MarshalIndent(existing, "", "  ")
   531		if err != nil {
   532			return err
   533		}
   534		return os.WriteFile(artifactsPath(), data, 0644)
   535	}
