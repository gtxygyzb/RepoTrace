   346			return executeSplit(stage, params, inputs)
   347		case "train":
   348			return executeTrain(stage, params, inputs)
   349		case "evaluate":
   350			return executeEvaluate(stage, params, inputs)
   351		case "register":
   352			return executeRegister(stage, params, inputs)
   353		case "ensemble":
   354			return executeEnsemble(stage, params, inputs)
   355		}
   356		return nil, fmt.Errorf("unknown stage type %q", stage.Type)
   357	}
