func main() {
	if len(os.Args) < 2 {
		printError("usage: mlpipe <command> [args]")
		return
	}

	cmd := os.Args[1]
	args := os.Args[2:]

	switch cmd {
	case "run":
		cmdRun(args)
	case "plan":
		cmdPlan(args)
	case "validate":
		cmdValidate(args)
	case "registry":
		cmdRegistry(args)
	case "lineage":
		cmdLineage(args)
	default:
		printError(fmt.Sprintf("unknown command: %s", cmd))
	}
}

func cmdRun(args []string) {
	configPath, overrides, cv, noCache, err := parseRunArgs(args)
	if err != nil {
		printError(err.Error())
		return
	}
	config, err := loadConfig(configPath)
	if err != nil {
		printError(err.Error())
		return
	}
	executor := NewExecutor(config, overrides)
	executor.noCache = noCache
	if noCache {
		executor.cacheStats = nil
	}
	executor.cvFolds = cv
	var run interface{}
	if cv > 0 {
		run, err = executor.RunCV()
	} else {
		run, err = executor.Run()
	}
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(run)
}

func cmdPlan(args []string) {
	configPath, overrides, cv, err := parsePlanArgs(args)
	if err != nil {
		printError(err.Error())
		return
	}
	config, err := loadConfig(configPath)
	if err != nil {
		printError(err.Error())
		return
	}
	plan, err := buildPlan(config, overrides, cv)
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(plan)
}

func cmdValidate(args []string) {
	if len(args) < 1 {
		printError("usage: mlpipe validate <config.json>")
		return
	}
	config, err := loadConfig(args[0])
	if err != nil {
		printError(err.Error())
		return
	}
	valid, errors := config.Validate()
	printJSON(map[string]interface{}{"valid": valid, "errors": errors})
}

func cmdRegistry(args []string) {
	if len(args) < 1 {
		printError("usage: mlpipe registry <list|info|promote|compare> [args]")
		return
	}
	sub := args[0]
	rest := args[1:]
	switch sub {
	case "list":
		cmdRegistryList(rest)
	case "info":
		cmdRegistryInfo(rest)
	case "promote":
		cmdRegistryPromote(rest)
	case "compare":
		cmdRegistryCompare(rest)
	default:
		printError(fmt.Sprintf("unknown registry command: %s", sub))
	}
}

func cmdRegistryList(args []string) {
	name, stage, tag := "", "", ""
	for i := 0; i < len(args); i++ {
		switch {
		case args[i] == "--name" && i+1 < len(args):
			name = args[i+1]
			i++
		case strings.HasPrefix(args[i], "--name="):
			name = strings.TrimPrefix(args[i], "--name=")
		case args[i] == "--stage" && i+1 < len(args):
			stage = args[i+1]
			i++
		case strings.HasPrefix(args[i], "--stage="):
			stage = strings.TrimPrefix(args[i], "--stage=")
		case args[i] == "--tag" && i+1 < len(args):
			tag = args[i+1]
			i++
		case strings.HasPrefix(args[i], "--tag="):
			tag = strings.TrimPrefix(args[i], "--tag=")
		default:
			printError(fmt.Sprintf("unknown flag: %s", args[i]))
			return
		}
	}
	entries, err := listRegistry(name, stage, tag)
	if err != nil {
		printError(err.Error())
		return
	}
	out := make([]map[string]interface{}, len(entries))
	for i, e := range entries {
		out[i] = map[string]interface{}{
			"name":          e.Name,
			"version":       e.Version,
			"stage":         e.Stage,
			"tags":          e.Tags,
			"metrics":       e.Metrics,
			"registered_at": e.RegisteredAt,
		}
	}
	printJSON(out)
}

func cmdRegistryInfo(args []string) {
	if len(args) < 1 {
		printError("usage: mlpipe registry info <name>:<version>")
		return
	}
	name, version, ok := splitNameVersion(args[0])
	if !ok {
		printError("invalid name:version format")
		return
	}
	entry, err := registryInfo(name, version)
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(entry)
}

func cmdRegistryPromote(args []string) {
	if len(args) < 2 {
		printError("usage: mlpipe registry promote <name>:<version> <target_stage>")
		return
	}
	name, version, ok := splitNameVersion(args[0])
	if !ok {
		printError("invalid name:version format")
		return
	}
	target := args[1]
	entry, prev, new, err := promoteModel(name, version, target)
	if err != nil {
		if strings.HasPrefix(err.Error(), "metric ") {
			printJSON(map[string]interface{}{"success": false, "message": err.Error()})
			return
		}
		printError(err.Error())
		return
	}
	printJSON(map[string]interface{}{
		"success":        true,
		"message":        fmt.Sprintf("promoted to %s", new),
		"previous_stage": prev,
		"new_stage":      entry.Stage,
	})
}

func cmdRegistryCompare(args []string) {
	if len(args) < 2 {
		printError("usage: mlpipe registry compare <name>:<version1> <name>:<version2>")
		return
	}
	name1, v1, ok := splitNameVersion(args[0])
	if !ok {
		printError("invalid name:version format")
		return
	}
	name2, v2, ok := splitNameVersion(args[1])
	if !ok {
		printError("invalid name:version format")
		return
	}
	if name1 != name2 {
		printError("cannot compare different model names")
		return
	}
	result, err := compareModels(name1, v1, v2)
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(result)
}

func cmdLineage(args []string) {
	if len(args) < 2 {
		printError("usage: mlpipe lineage <artifact_id> <up|down|both>")
		return
	}
	id := args[0]
	direction := args[1]
	result, err := queryLineage(id, direction)
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(result)
}

