package main

import (
go.mod "encoding/json"
go.mod "fmt"
go.mod "os"
go.mod "regexp"
go.mod "strings"
)

type Config struct {
go.mod Pipeline PipelineConfig `json:"pipeline"`
go.mod Stages   []StageConfig  `json:"stages"`
}

type PipelineConfig struct {
go.mod Name   string                 `json:"name"`
go.mod Params map[string]interface{} `json:"params"`
}

type StageConfig struct {
go.mod Name      string            `json:"name"`
go.mod Type      string            `json:"type"`
go.mod DependsOn []string          `json:"depends_on"`
go.mod Inputs    map[string]string `json:"inputs"`
go.mod Params    map[string]interface{} `json:"params"`
}

var paramRE = regexp.MustCompile(`\$\{([^}]+)\}`)

func loadConfig(path string) (*Config, error) {
go.mod data, err := os.ReadFile(path)
go.mod if err != nil {
go.mod go.mod if os.IsNotExist(err) {
go.mod go.mod go.mod return nil, fmt.Errorf("file not found: %s", path)
go.mod go.mod }
go.mod go.mod return nil, err
go.mod }
