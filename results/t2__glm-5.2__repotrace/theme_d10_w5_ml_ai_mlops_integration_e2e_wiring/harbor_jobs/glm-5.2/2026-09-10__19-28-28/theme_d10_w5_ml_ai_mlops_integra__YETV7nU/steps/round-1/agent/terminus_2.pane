   280	func (e *Executor) inputCacheKeys(stage *StageConfig) map[string]string {
   281		keys := map[string]string{}
   282		for local, ref := range stage.Inputs {
   283			refs, ok := inputRefs(ref)
   284			if !ok {
   285				continue
   286			}
   287			for _, r := range refs {
   288				parts := strings.SplitN(r, ".", 2)
   289				if len(parts) != 2 {
   290					continue
[?2004hroot@n30009:/app# nl -ba pipeline.go | sed -n '290,560p'
[?2004l   290					continue
   291				}
   292				depStage := parts[0]
   293				if key, ok := e.cacheKeys[depStage]; ok {
   294					keys[local] = keys[local] + key + "\n"
   295				}
   296			}
   297		}
   298		for k, v := range keys {
   299			keys[k] = strings.TrimRight(v, "\n")
   300		}
   301		return keys
   302	}
   303	
   304	func (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {
   305		inputs := map[string]*ArtifactValue{}
   306		ids := []string{}
   307		for local, ref := range stage.Inputs {
   308			refs, ok := inputRefs(ref)
   309			if !ok {
   310				return nil, nil, fmt.Errorf("stage %q input %q has invalid reference %v", stage.Name, local, ref)
   311			}
   312			var firstVal *ArtifactValue
   313			for _, r := range refs {
   314				parts := strings.SplitN(r, ".", 2)
   315				if len(parts) != 2 {
   316					return nil, nil, fmt.Errorf("stage %q has invalid input reference %q", stage.Name, r)
   317				}
   318				depStage, port := parts[0], parts[1]
   319				id, ok := e.outputs[depStage][port]
   320				if !ok {
   321					return nil, nil, fmt.Errorf("stage %q input %q references unavailable output %s.%s", stage.Name, local, depStage, port)
   322				}
   323				val, ok := e.values[depStage][port]
   324				if !ok || val == nil {
   325					return nil, nil, fmt.Errorf("stage %q input %q references unavailable artifact %s.%s", stage.Name, local, depStage, port)
   326				}
   327				ids = append(ids, id)
   328				if firstVal == nil {
   329					firstVal = val
   330				}
   331				if stage.Type == "ensemble" && local == "models" {
   332					inputs[local+"_"+r] = val
   333				}
   334			}
   335			if _, exists := inputs[local]; !exists {
   336				inputs[local] = firstVal
   337			}
   338		}
   339		return inputs, ids, nil
   340	}
   341	
   342	func executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
   343		switch stage.Type {
   344		case "data-source":
   345			return executeDataSource(stage, params, inputs)
   346		case "transform":
   347			return executeTransform(stage, params, inputs)
   348		case "split":
   349			return executeSplit(stage, params, inputs)
   350		case "train":
   351			return executeTrain(stage, params, inputs)
   352		case "evaluate":
   353			return executeEvaluate(stage, params, inputs)
   354		case "register":
   355			return executeRegister(stage, params, inputs)
   356		case "ensemble":
   357			return executeEnsemble(stage, params, inputs)
   358		}
   359		return nil, fmt.Errorf("unknown stage type %q", stage.Type)
   360	}
   361	
   362	func executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
   363		path, ok := getString(params, "path")
   364		if !ok {
   365			return nil, fmt.Errorf("data-source stage %q requires path", stage.Name)
   366		}
   367		schema, _ := getMap(params, "schema")
   368		ds, err := loadDataset(path, schema)
   369		if err != nil {
   370			return nil, err
   371		}
   372		return map[string]*ArtifactValue{"data": {Dataset: ds}}, nil
   373	}
   374	
   375	func (c *Config) topologicalOrder() ([]string, error) {
   376		indeg := map[string]int{}
   377		adj := map[string][]string{}
   378		for _, s := range c.Stages {
   379			indeg[s.Name] = 0
   380		}
   381		for _, s := range c.Stages {
   382			for _, dep := range s.DependsOn {
   383				if _, ok := c.stageByName(dep); ok {
   384					adj[dep] = append(adj[dep], s.Name)
   385					indeg[s.Name]++
   386				}
   387			}
   388		}
   389		queue := []string{}
   390		for _, s := range c.Stages {
   391			if indeg[s.Name] == 0 {
   392				queue = append(queue, s.Name)
   393			}
   394		}
   395		order := []string{}
   396		for len(queue) > 0 {
   397			node := queue[0]
   398			queue = queue[1:]
   399			order = append(order, node)
   400			for _, next := range adj[node] {
   401				indeg[next]--
   402				if indeg[next] == 0 {
   403					queue = append(queue, next)
   404				}
   405			}
   406		}
   407		if len(order) < len(c.Stages) {
   408			if cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {
   409				return nil, fmt.Errorf("cycle detected involving stages: %s", strings.Join(cycle, ", "))
   410			}
   411			return nil, fmt.Errorf("cycle detected involving stages: %s", joinStageNames(c.Stages))
   412		}
   413		return order, nil
   414	}
   415	
   416	func joinStageNames(stages []StageConfig) string {
   417		names := []string{}
   418		for _, s := range stages {
   419			names = append(names, s.Name)
   420		}
   421		return strings.Join(names, ", ")
   422	}
   423	
   424	func artifactID(pipeline, stage, port string, ts int64) string {
   425		if pipeline == "" {
   426			pipeline = "pipeline"
   427		}
   428		return fmt.Sprintf("%s-%s-%s-%d", pipeline, stage, port, ts)
   429	}
   430	
   431	func (v *ArtifactValue) Type() string {
   432		if v.Dataset != nil {
   433			return "dataset"
   434		}
   435		if v.Model != nil {
   436			return "model"
   437		}
   438		if v.Report != nil {
   439			return "report"
   440		}
   441		if v.Entry != nil {
   442			return "entry"
   443		}
   444		return "unknown"
   445	}
   446	
   447	func (v *ArtifactValue) Summary() map[string]interface{} {
   448		if v.Dataset != nil {
   449			return v.Dataset.Summary()
   450		}
   451		if v.Model != nil {
   452			summary := map[string]interface{}{
   453				"algorithm":   v.Model.Algorithm,
   454				"target":      v.Model.Target,
   455				"features":    v.Model.Features,
   456				"hyperparams": v.Model.Hyperparams,
   457			}
   458			if len(v.Model.EnsembleModels) > 0 {
   459				summary["ensemble_models"] = v.Model.EnsembleModels
   460			}
   461			if v.Model.ModelData != nil {
   462				summary["model_data"] = v.Model.ModelData
   463			}
   464			return summary
   465		}
   466		if v.Report != nil {
   467			return v.Report.Summary()
   468		}
   469		if v.Entry != nil {
   470			return map[string]interface{}{
   471				"name":    v.Entry.Name,
   472				"version": v.Entry.Version,
   473				"stage":   v.Entry.Stage,
   474			}
   475		}
   476		return map[string]interface{}{}
   477	}
