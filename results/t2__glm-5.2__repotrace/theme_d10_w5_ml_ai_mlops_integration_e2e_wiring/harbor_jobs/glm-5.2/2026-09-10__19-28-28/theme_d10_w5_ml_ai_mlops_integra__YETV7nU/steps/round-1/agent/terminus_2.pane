   326	
   327	func cmdLineage(args []string) {
   328		if len(args) < 2 {
   329			printError("usage: mlpipe lineage <artifact_id> <up|down|both>")
   330			return
   331		}
   332		id := args[0]
   333		direction := args[1]
   334		result, err := queryLineage(id, direction)
   335		if err != nil {
   336			printError(err.Error())
   337			return
   338		}
   339		printJSON(result)
   340	}
