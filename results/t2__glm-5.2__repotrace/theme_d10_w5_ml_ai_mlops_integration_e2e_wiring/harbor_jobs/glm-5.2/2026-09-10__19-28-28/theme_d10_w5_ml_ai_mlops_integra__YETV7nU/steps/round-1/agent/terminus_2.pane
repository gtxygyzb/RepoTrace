   479	func inputDataset(inputs map[string]*ArtifactValue) *Dataset {
   480		for _, in := range inputs {
   481			if in != nil && in.Dataset != nil {
   482				return in.Dataset
   483			}
   484		}
   485		return nil
   486	}
