   376	func (c *Config) topologicalOrder() ([]string, error) {
   377		indeg := map[string]int{}
   378		adj := map[string][]string{}
   379		for _, s := range c.Stages {
   380			indeg[s.Name] = 0
   381		}
   382		for _, s := range c.Stages {
   383			for _, dep := range s.DependsOn {
   384				if _, ok := c.stageByName(dep); ok {
   385					adj[dep] = append(adj[dep], s.Name)
   386					indeg[s.Name]++
   387				}
   388			}
   389		}
   390		queue := []string{}
   391		for _, s := range c.Stages {
   392			if indeg[s.Name] == 0 {
   393				queue = append(queue, s.Name)
   394			}
   395		}
   396		order := []string{}
   397		for len(queue) > 0 {
   398			node := queue[0]
   399			queue = queue[1:]
   400			order = append(order, node)
   401			for _, next := range adj[node] {
   402				indeg[next]--
   403				if indeg[next] == 0 {
   404					queue = append(queue, next)
   405				}
   406			}
   407		}
   408		if len(order) < len(c.Stages) {
   409			if cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {
   410				return nil, fmt.Errorf("cycle detected involving stages: %s", strings.Join(cycle, ", "))
   411			}
   412			return nil, fmt.Errorf("cycle detected involving stages: %s", joinStageNames(c.Stages))
   413		}
