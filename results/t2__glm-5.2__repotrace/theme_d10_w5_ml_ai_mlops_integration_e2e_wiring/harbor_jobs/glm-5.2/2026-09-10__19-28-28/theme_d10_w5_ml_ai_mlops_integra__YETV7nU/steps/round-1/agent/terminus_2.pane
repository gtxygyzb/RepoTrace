   524	func (c *Config) stageDeps(s *StageConfig) []string {
   525		deps := map[string]bool{}
   526		for _, dep := range s.DependsOn {
   527			if dep != "" {
   528				deps[dep] = true
   529			}
   530		}
   531		for _, ref := range s.Inputs {
   532			refs, ok := inputRefs(ref)
   533			if !ok {
   534				continue
   535			}
   536			for _, r := range refs {
   537				parts := strings.SplitN(r, ".", 2)
   538			if len(parts) == 2 && parts[0] != "" {
   539				deps[parts[0]] = true
   540			}
   541		}
   542		out := make([]string, 0, len(deps))
