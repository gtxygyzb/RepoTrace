   302		inputs := map[string]*ArtifactValue{}
   303		ids := []string{}
   304		for local, ref := range stage.Inputs {
   305			refs, ok := inputRefs(ref)
   306			if !ok {
   307				return nil, nil, fmt.Errorf("stage %q input %q has invalid reference %v", stage.Name, local, ref)
   308			}
   309			var firstVal *ArtifactValue
   310			for _, r := range refs {
   311				parts := strings.SplitN(r, ".", 2)
   312				if len(parts) != 2 {
   313					return nil, nil, fmt.Errorf("stage %q has invalid input reference %q", stage.Name, r)
   314				}
   315				depStage, port := parts[0], parts[1]
   316				id, ok := e.outputs[depStage][port]
   317				if !ok {
   318					return nil, nil, fmt.Errorf("stage %q input %q references unavailable output %s.%s", stage.Name, local, depStage, port)
   319				}
   320				val, ok := e.values[depStage][port]
   321				if !ok || val == nil {
   322					return nil, nil, fmt.Errorf("stage %q input %q references unavailable artifact %s.%s", stage.Name, local, depStage, port)
   323				}
   324				ids = append(ids, id)
   325				if firstVal == nil {
   326					firstVal = val
   327				}
   328				if stage.Type == "ensemble" && local == "models" {
   329					inputs[local+"_"+r] = val
   330				}
   331			}
   332			if _, exists := inputs[local]; !exists {
   333				inputs[local] = firstVal
   334			}
   335		}
   336		return inputs, ids, nil
   337	}
