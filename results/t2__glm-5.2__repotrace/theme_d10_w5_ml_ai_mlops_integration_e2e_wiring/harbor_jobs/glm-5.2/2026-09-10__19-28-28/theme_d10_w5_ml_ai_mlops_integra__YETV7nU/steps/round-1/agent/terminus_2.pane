   464	func (c *Config) validateCV() error {
   465		splitNames := []string{}
   466		for _, s := range c.Stages {
   467			if s.Type == "split" {
   468				splitNames = append(splitNames, s.Name)
   469			}
   470		}
   471		if len(splitNames) != 1 {
   472			return fmt.Errorf("cv mode requires exactly one split stage")
   473		}
   474		splitName := splitNames[0]
   475		post := c.postSplitStages(splitName)
   476	
   477		hasTrain := false
   478		for name := range post {
   479			stage, _ := c.stageByName(name)
   480			if stage != nil && stage.Type == "train" {
   481				hasTrain = true
   482			}
   483		}
   484		hasEvaluate := false
   485		for name := range post {
   486			stage, _ := c.stageByName(name)
   487			if stage == nil || stage.Type != "evaluate" {
   488				continue
   489			}
   490			ancestors := c.ancestors(name)
   491			for anc := range ancestors {
   492				if anc == name {
   493					continue
   494				}
   495				ancStage, ok := c.stageByName(anc)
   496				if !ok || ancStage.Type != "train" || !post[anc] {
   497					continue
   498				}
   499				hasEvaluate = true
   500				break
   501			}
   502			if hasEvaluate {
   503				break
   504			}
   505		}
   506	
   507		if !hasTrain || !hasEvaluate {
   508			return fmt.Errorf("cv mode requires train and evaluate stages downstream of the split stage")
   509		}
   510		return nil
   511	}
