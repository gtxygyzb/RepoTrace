   349	
   350	func artifactsPath() string {
   351		return filepath.Join(".mlpipe", "artifacts.json")
   352	}
   353	
   354	func loadArtifacts() (map[string]*ArtifactMeta, error) {
   355		data, err := os.ReadFile(artifactsPath())
   356		if err != nil {
   357			if os.IsNotExist(err) {
   358				return map[string]*ArtifactMeta{}, nil
   359			}
   360			return nil, err
   361		}
   362		var m map[string]*ArtifactMeta
   363		if err := json.Unmarshal(data, &m); err != nil {
   364			return nil, err
   365		}
   366		if m == nil {
   367			m = map[string]*ArtifactMeta{}
   368		}
   369		return m, nil
   370	}
   371	
   372	func saveArtifacts(newMeta map[string]*ArtifactMeta) error {
   373		existing, err := loadArtifacts()
   374		if err != nil {
   375			return err
   376		}
   377		for k, v := range newMeta {
   378			existing[k] = v
   379		}
   380		if err := os.MkdirAll(".mlpipe", 0755); err != nil {
   381			return err
   382		}
   383		data, err := json.MarshalIndent(existing, "", "  ")
   384		if err != nil {
   385			return err
   386		}
   387		return os.WriteFile(artifactsPath(), data, 0644)
   388	}
   389	
   390	func saveRun(run *RunOutput) error {
   391		dir := filepath.Join(".mlpipe", "runs")
   392		if err := os.MkdirAll(dir, 0755); err != nil {
   393			return err
   394		}
   395		name := safeFileName(run.Pipeline)
   396		if name == "" {
   397			name = "pipeline"
   398		}
   399		path := filepath.Join(dir, fmt.Sprintf("%s-%d.json", name, time.Now().UnixNano()))
   400		data, err := json.MarshalIndent(run, "", "  ")
   401		if err != nil {
   402			return err
   403		}
   404		return os.WriteFile(path, data, 0644)
   405	}
   406	
   407	func safeFileName(s string) string {
   408		if s == "" {
   409			return "pipeline"
   410		}
   411		return strings.Map(func(r rune) rune {
   412			if r == '/' || r == '\\' || r == ':' || r == ' ' {
   413				return '_'
   414			}
   415			return r
   416		}, s)
   417	}
   418	
   419	func queryLineage(id string, direction string) (map[string]interface{}, error) {
   420		artifacts, err := loadArtifacts()
   421		if err != nil {
   422			return nil, err
   423		}
   424		if _, ok := artifacts[id]; !ok {
   425			return nil, fmt.Errorf("artifact not found: %s", id)
   426		}
   427	
   428		set := map[string]bool{}
   429		switch direction {
   430		case "up":
   431			collectAncestors(id, artifacts, set)
   432		case "down":
   433			collectDescendants(id, artifacts, set)
   434		case "both":
   435			set[id] = true
   436			collectBoth(id, artifacts, set)
   437		default:
   438			return nil, fmt.Errorf("invalid direction %q", direction)
   439		}
   440	
   441		ids := []string{}
   442		for k := range set {
   443			ids = append(ids, k)
   444		}
   445		sort.Slice(ids, func(i, j int) bool {
   446			a := artifacts[ids[i]]
   447			b := artifacts[ids[j]]
   448			if a.Timestamp != b.Timestamp {
   449				return a.Timestamp < b.Timestamp
   450			}
   451			return ids[i] < ids[j]
   452		})
   453	
   454		lineage := []map[string]interface{}{}
   455		for _, aid := range ids {
   456			m := artifacts[aid]
   457			inputs := m.Inputs
   458			outputs := m.Outputs
   459			if inputs == nil {
   460				inputs = []string{}
   461			}
   462			if outputs == nil {
   463				outputs = []string{}
   464			}
   465			lineage = append(lineage, map[string]interface{}{
   466				"id":      m.ID,
   467				"stage":   m.Stage,
   468				"port":    m.Port,
   469				"type":    m.Type,
   470				"inputs":  inputs,
   471				"outputs": outputs,
   472			})
   473		}
   474	
   475		return map[string]interface{}{
   476			"artifact_id": id,
   477			"lineage":     lineage,
   478		}, nil
   479	}
   480	
   481	func collectAncestors(id string, artifacts map[string]*ArtifactMeta, set map[string]bool) {
   482		m, ok := artifacts[id]
   483		if !ok {
   484			return
   485		}
   486		for _, in := range m.Inputs {
   487			if !set[in] {
   488				set[in] = true
   489				collectAncestors(in, artifacts, set)
   490			}
   491		}
   492	}
   493	
   494	func collectDescendants(id string, artifacts map[string]*ArtifactMeta, set map[string]bool) {
   495		m, ok := artifacts[id]
   496		if !ok {
   497			return
   498		}
   499		for _, out := range m.Outputs {
   500			if !set[out] {
   501				set[out] = true
   502				collectDescendants(out, artifacts, set)
   503			}
   504		}
   505	}
   506	
   507	func collectBoth(id string, artifacts map[string]*ArtifactMeta, set map[string]bool) {
   508		m, ok := artifacts[id]
   509		if !ok {
   510			return
   511		}
   512		for _, in := range m.Inputs {
   513			if !set[in] {
   514				set[in] = true
   515				collectBoth(in, artifacts, set)
   516			}
   517		}
   518		for _, out := range m.Outputs {
   519			if !set[out] {
   520				set[out] = true
   521				collectBoth(out, artifacts, set)
   522			}
   523		}
   524	}
