    93	func cmdRegistryList(args []string) {
    94		name, stage, tag := "", "", ""
    95		for i := 0; i < len(args); i++ {
    96			switch {
    97			case args[i] == "--name" && i+1 < len(args):
    98				name = args[i+1]
    99				i++
   100			case strings.HasPrefix(args[i], "--name="):
   101				name = strings.TrimPrefix(args[i], "--name=")
   102			case args[i] == "--stage" && i+1 < len(args):
   103				stage = args[i+1]
   104				i++
   105			case strings.HasPrefix(args[i], "--stage="):
   106				stage = strings.TrimPrefix(args[i], "--stage=")
   107			case args[i] == "--tag" && i+1 < len(args):
   108				tag = args[i+1]
   109				i++
   110			case strings.HasPrefix(args[i], "--tag="):
   111				tag = strings.TrimPrefix(args[i], "--tag=")
   112			default:
   113				printError(fmt.Sprintf("unknown flag: %s", args[i]))
   114				return
   115			}
   116		}
   117		entries, err := listRegistry(name, stage, tag)
   118		if err != nil {
   119			printError(err.Error())
   120			return
   121		}
   122		out := make([]map[string]interface{}, len(entries))
   123		for i, e := range entries {
   124			out[i] = map[string]interface{}{
   125				"name":          e.Name,
   126				"version":       e.Version,
   127				"stage":         e.Stage,
   128				"tags":          e.Tags,
   129				"metrics":       e.Metrics,
   130				"registered_at": e.RegisteredAt,
   131			}
   132		}
   133		printJSON(out)
   134	}
