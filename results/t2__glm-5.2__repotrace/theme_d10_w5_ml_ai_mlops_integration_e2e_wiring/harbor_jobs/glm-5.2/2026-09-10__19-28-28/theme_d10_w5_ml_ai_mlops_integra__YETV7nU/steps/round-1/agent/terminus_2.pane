[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"strings"
)

func main() {
	if len(os.Args) < 2 {
		printError("usage: mlpipe <command> [args]")
		return
	}

	cmd := os.Args[1]
	args := os.Args[2:]

	switch cmd {
	case "run":
		cmdRun(args)
	case "validate":
		cmdValidate(args)
	case "registry":
		cmdRegistry(args)
	case "lineage":
		cmdLineage(args)
	default:
		printError(fmt.Sprintf("unknown command: %s", cmd))
	}
}

func cmdRun(args []string) {
	if len(args) < 1 {
		printError("usage: mlpipe run <config.json> [--param key=value ...]")
		return
	}
	configPath := args[0]
	overrides, err := parseParams(args[1:])
	if err != nil {
		printError(err.Error())
		return
	}
	config, err := loadConfig(configPath)
	if err != nil {
		printError(err.Error())
		return
	}
	executor := NewExecutor(config, overrides)
	run, err := executor.Run()
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(run)
}

func cmdValidate(args []string) {
	if len(args) < 1 {
		printError("usage: mlpipe validate <config.json>")
		return
	}
	config, err := loadConfig(args[0])
	if err != nil {
		printError(err.Error())
		return
	}
	valid, errors := config.Validate()
	printJSON(map[string]interface{}{"valid": valid, "errors": errors})
}

func cmdRegistry(args []string) {
	if len(args) < 1 {
		printError("usage: mlpipe registry <list|info|promote|compare> [args]")
		return
	}
	sub := args[0]
	rest := args[1:]
	switch sub {
	case "list":
		cmdRegistryList(rest)
	case "info":
		cmdRegistryInfo(rest)
	case "promote":
		cmdRegistryPromote(rest)
	case "compare":
		cmdRegistryCompare(rest)
	default:
		printError(fmt.Sprintf("unknown registry command: %s", sub))
	}
}

func cmdRegistryList(args []string) {
	name, stage, tag := "", "", ""
	for i := 0; i < len(args); i++ {
		switch {
		case args[i] == "--name" && i+1 < len(args):
			name = args[i+1]
			i++
		case strings.HasPrefix(args[i], "--name="):
			name = strings.TrimPrefix(args[i], "--name=")
		case args[i] == "--stage" && i+1 < len(args):
			stage = args[i+1]
			i++
		case strings.HasPrefix(args[i], "--stage="):
			stage = strings.TrimPrefix(args[i], "--stage=")
		case args[i] == "--tag" && i+1 < len(args):
			tag = args[i+1]
			i++
		case strings.HasPrefix(args[i], "--tag="):
			tag = strings.TrimPrefix(args[i], "--tag=")
		default:
			printError(fmt.Sprintf("unknown flag: %s", args[i]))
			return
		}
	}
	entries, err := listRegistry(name, stage, tag)
	if err != nil {
		printError(err.Error())
		return
	}
	out := make([]map[string]interface{}, len(entries))
	for i, e := range entries {
		out[i] = map[string]interface{}{
			"name":          e.Name,
			"version":       e.Version,
			"stage":         e.Stage,
			"tags":          e.Tags,
			"metrics":       e.Metrics,
			"registered_at": e.RegisteredAt,
		}
	}
	printJSON(out)
}

func cmdRegistryInfo(args []string) {
	if len(args) < 1 {
		printError("usage: mlpipe registry info <name>:<version>")
		return
	}
	name, version, ok := splitNameVersion(args[0])
	if !ok {
		printError("invalid name:version format")
		return
	}
	entry, err := registryInfo(name, version)
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(entry)
}

func cmdRegistryPromote(args []string) {
	if len(args) < 2 {
		printError("usage: mlpipe registry promote <name>:<version> <target_stage>")
		return
	}
	name, version, ok := splitNameVersion(args[0])
	if !ok {
		printError("invalid name:version format")
		return
	}
	target := args[1]
	entry, prev, new, err := promoteModel(name, version, target)
	if err != nil {
		if strings.HasPrefix(err.Error(), "metric ") {
			printJSON(map[string]interface{}{"success": false, "message": err.Error()})
			return
		}
		printError(err.Error())
		return
	}
	printJSON(map[string]interface{}{
		"success":        true,
		"message":        fmt.Sprintf("promoted to %s", new),
		"previous_stage": prev,
		"new_stage":      entry.Stage,
	})
}

func cmdRegistryCompare(args []string) {
	if len(args) < 2 {
		printError("usage: mlpipe registry compare <name>:<v1> <name>:<v2>")
		return
	}
	name1, v1, ok := splitNameVersion(args[0])
	if !ok {
		printError("invalid name:version format")
		return
	}
	name2, v2, ok := splitNameVersion(args[1])
	if !ok {
		printError("invalid name:version format")
		return
	}
	if name1 != name2 {
		printError("model names must match")
		return
	}
	result, err := compareModels(name1, v1, v2)
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(result)
}

func cmdLineage(args []string) {
	if len(args) < 1 {
		printError("usage: mlpipe lineage <artifact_id> [--direction up|down|both]")
		return
	}
	id := args[0]
	direction := "both"
	for i := 1; i < len(args); i++ {
		if args[i] == "--direction" && i+1 < len(args) {
			direction = args[i+1]
			i++
		} else if strings.HasPrefix(args[i], "--direction=") {
			direction = strings.TrimPrefix(args[i], "--direction=")
		} else {
			printError(fmt.Sprintf("unknown flag: %s", args[i]))
			return
		}
	}
	result, err := queryLineage(id, direction)
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(result)
}

func parseParams(args []string) (map[string]string, error) {
	overrides := map[string]string{}
	for i := 0; i < len(args); i++ {
		if args[i] == "--param" {
			if i+1 >= len(args) {
				return nil, fmt.Errorf("--param requires key=value")
			}
			kv := args[i+1]
			i++
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				return nil, fmt.Errorf("--param requires key=value")
			}
			overrides[k] = v
		} else if strings.HasPrefix(args[i], "--param=") {
			kv := strings.TrimPrefix(args[i], "--param=")
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				return nil, fmt.Errorf("--param requires key=value")
			}
			overrides[k] = v
		} else {
			return nil, fmt.Errorf("unknown flag: %s", args[i])
		}
	}
	return overrides, nil
[?2004hroot@n30009:/app# sed -n '1,320p' pipeline.go
[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"strings"
	"time"
)

type ArtifactValue struct {
	Dataset *Dataset
	Model   *Model
	Report  *Report
	Entry   *RegistryEntry
}

type ArtifactMeta struct {
	ID        string                 `json:"id"`
	Stage     string                 `json:"stage"`
	Port      string                 `json:"port"`
	Type      string                 `json:"type"`
	Summary   map[string]interface{} `json:"summary"`
	Inputs    []string               `json:"inputs"`
	Outputs   []string               `json:"outputs"`
	Timestamp int64                  `json:"timestamp"`
}

type ArtifactOutput struct {
	Stage   string                 `json:"stage"`
	Port    string                 `json:"port"`
	Type    string                 `json:"type"`
	Summary map[string]interface{} `json:"summary"`
}

type StageResult struct {
	Status     string            `json:"status"`
	DurationMs int64             `json:"duration_ms"`
	Outputs    map[string]string `json:"outputs"`
	Error      string            `json:"error,omitempty"`
}

type RunOutput struct {
	Pipeline  string                     `json:"pipeline"`
	Status    string                     `json:"status"`
	Stages    map[string]*StageResult    `json:"stages"`
	Artifacts map[string]*ArtifactOutput `json:"artifacts"`
}

type Executor struct {
	config  *Config
	globals map[string]interface{}
	status  map[string]string
	results map[string]*StageResult
	outputs map[string]map[string]string
	values  map[string]map[string]*ArtifactValue
	meta    map[string]*ArtifactMeta
}

func NewExecutor(config *Config, overrides map[string]string) *Executor {
	return &Executor{
		config:  config,
		globals: config.globalParams(overrides),
		status:  map[string]string{},
		results: map[string]*StageResult{},
		outputs: map[string]map[string]string{},
		values:  map[string]map[string]*ArtifactValue{},
		meta:    map[string]*ArtifactMeta{},
	}
}

func (e *Executor) Run() (*RunOutput, error) {
	valid, errs := e.config.Validate()
	if !valid {
		return nil, fmt.Errorf("%s", strings.Join(errs, "; "))
	}
	order, err := e.config.topologicalOrder()
	if err != nil {
		return nil, err
	}

	runArtifacts := map[string]*ArtifactOutput{}

	for _, name := range order {
		stage, _ := e.config.stageByName(name)
		e.outputs[name] = map[string]string{}
		e.values[name] = map[string]*ArtifactValue{}
		e.results[name] = &StageResult{Status: "pending", Outputs: map[string]string{}}

		skip := false
		for _, dep := range stage.DependsOn {
			if e.status[dep] != "success" {
				skip = true
				break
			}
		}
		if skip {
			e.status[name] = "skipped"
			e.results[name].Status = "skipped"
			continue
		}

		inputValues, inputIDs, err := e.resolveInputs(stage)
		if err != nil {
			e.status[name] = "failed"
			e.results[name].Status = "failed"
			e.results[name].Error = err.Error()
			continue
		}

		params := e.config.stageParams(name, e.globals)
		start := time.Now()
		out, err := executeStage(stage, params, inputValues)
		duration := time.Since(start).Milliseconds()
		e.results[name].DurationMs = duration

		if err != nil {
			e.status[name] = "failed"
			e.results[name].Status = "failed"
			e.results[name].Error = err.Error()
			continue
		}

		e.status[name] = "success"
		e.results[name].Status = "success"
		ts := time.Now().UnixNano()

		for port, val := range out {
			id := artifactID(e.config.Pipeline.Name, name, port, ts)
			e.values[name][port] = val
			e.outputs[name][port] = id
			typ := val.Type()
			summary := val.Summary()
			meta := &ArtifactMeta{
				ID:        id,
				Stage:     name,
				Port:      port,
				Type:      typ,
				Summary:   summary,
				Inputs:    inputIDs,
				Outputs:   []string{},
				Timestamp: ts,
			}
			e.meta[id] = meta
			for _, inID := range inputIDs {
				if parent, ok := e.meta[inID]; ok {
					parent.Outputs = appendUnique(parent.Outputs, id)
				}
			}
			runArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}
		}
	}

	status := "success"
	for _, s := range e.results {
		if s.Status != "success" {
			status = "failed"
			break
		}
	}

	run := &RunOutput{
		Pipeline:  e.config.Pipeline.Name,
		Status:    status,
		Stages:    e.results,
		Artifacts: runArtifacts,
	}

	if err := saveArtifacts(e.meta); err != nil {
		return nil, err
	}
	if err := saveRun(run); err != nil {
		return nil, err
	}

	return run, nil
}

func (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {
	inputs := map[string]*ArtifactValue{}
	ids := []string{}
	for local, ref := range stage.Inputs {
		parts := strings.SplitN(ref, ".", 2)
		if len(parts) != 2 {
			return nil, nil, fmt.Errorf("stage %q has invalid input reference %q", stage.Name, ref)
		}
		depStage, port := parts[0], parts[1]
		id, ok := e.outputs[depStage][port]
		if !ok {
			return nil, nil, fmt.Errorf("stage %q input %q references unavailable output %s.%s", stage.Name, local, depStage, port)
		}
		val, ok := e.values[depStage][port]
		if !ok || val == nil {
			return nil, nil, fmt.Errorf("stage %q input %q references unavailable artifact %s.%s", stage.Name, local, depStage, port)
		}
		inputs[local] = val
		ids = append(ids, id)
	}
	return inputs, ids, nil
}

func executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
	switch stage.Type {
	case "data-source":
		return executeDataSource(stage, params, inputs)
	case "transform":
		return executeTransform(stage, params, inputs)
	case "split":
		return executeSplit(stage, params, inputs)
	case "train":
		return executeTrain(stage, params, inputs)
	case "evaluate":
		return executeEvaluate(stage, params, inputs)
	case "register":
		return executeRegister(stage, params, inputs)
	}
	return nil, fmt.Errorf("unknown stage type %q", stage.Type)
}

func executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
	path, ok := getString(params, "path")
	if !ok {
		return nil, fmt.Errorf("data-source stage %q requires path", stage.Name)
	}
	schema, _ := getMap(params, "schema")
	ds, err := loadDataset(path, schema)
	if err != nil {
		return nil, err
	}
	return map[string]*ArtifactValue{"data": {Dataset: ds}}, nil
}

func (c *Config) topologicalOrder() ([]string, error) {
	indeg := map[string]int{}
	adj := map[string][]string{}
	for _, s := range c.Stages {
		indeg[s.Name] = 0
	}
	for _, s := range c.Stages {
		for _, dep := range s.DependsOn {
			if _, ok := c.stageByName(dep); ok {
				adj[dep] = append(adj[dep], s.Name)
				indeg[s.Name]++
			}
		}
	}
	queue := []string{}
	for _, s := range c.Stages {
		if indeg[s.Name] == 0 {
			queue = append(queue, s.Name)
		}
	}
	order := []string{}
	for len(queue) > 0 {
		node := queue[0]
		queue = queue[1:]
		order = append(order, node)
		for _, next := range adj[node] {
			indeg[next]--
			if indeg[next] == 0 {
				queue = append(queue, next)
			}
		}
	}
	if len(order) < len(c.Stages) {
		if cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {
			return nil, fmt.Errorf("cycle detected involving stages: %s", strings.Join(cycle, ", "))
		}
		return nil, fmt.Errorf("cycle detected involving stages: %s", joinStageNames(c.Stages))
	}
	return order, nil
}

func joinStageNames(stages []StageConfig) string {
	names := []string{}
	for _, s := range stages {
		names = append(names, s.Name)
	}
	return strings.Join(names, ", ")
}

func artifactID(pipeline, stage, port string, ts int64) string {
	if pipeline == "" {
		pipeline = "pipeline"
	}
	return fmt.Sprintf("%s-%s-%s-%d", pipeline, stage, port, ts)
}

func (v *ArtifactValue) Type() string {
	if v.Dataset != nil {
		return "dataset"
	}
	if v.Model != nil {
		return "model"
	}
	if v.Report != nil {
		return "report"
	}
	if v.Entry != nil {
		return "entry"
	}
	return "unknown"
}

func (v *ArtifactValue) Summary() map[string]interface{} {
	if v.Dataset != nil {
		return v.Dataset.Summary()
	}
	if v.Model != nil {
		return map[string]interface{}{
			"algorithm":   v.Model.Algorithm,
			"target":      v.Model.Target,
			"features":    v.Model.Features,
			"hyperparams": v.Model.Hyperparams,
		}
	}
	if v.Report != nil {
		return v.Report.Summary()
