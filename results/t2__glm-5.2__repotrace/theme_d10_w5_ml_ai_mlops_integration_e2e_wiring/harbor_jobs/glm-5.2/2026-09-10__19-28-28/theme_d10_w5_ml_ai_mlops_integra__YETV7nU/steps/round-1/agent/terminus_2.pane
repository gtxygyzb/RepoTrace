   158			foldMetrics[i] = foldMetric
   159		}
   160	
   161		cvMetrics := map[string]CVMetricAgg{}
   162		metricNames := map[string]bool{}
   163		for _, fm := range foldMetrics {
   164			for name := range fm {
   165				metricNames[name] = true
   166			}
   167		}
   168		for name := range metricNames {
   169			perFold := make([]float64, e.cvFolds)
   170			sum := 0.0
   171			count := 0
   172			for i, fm := range foldMetrics {
   173				if v, ok := fm[name]; ok {
   174					perFold[i] = v
   175					sum += v
   176					count++
   177				} else {
   178					perFold[i] = 0.0
   179				}
   180			}
   181			mean := 0.0
   182			if count > 0 {
   183				mean = sum / float64(count)
   184			}
   185			variance := 0.0
   186			for _, v := range perFold {
   187				d := v - mean
   188				variance += d * d
   189			}
   190			variance /= float64(e.cvFolds)
   191			cvMetrics[name] = CVMetricAgg{
   192				Mean:    mean,
   193				Std:     math.Sqrt(variance),
   194				PerFold: perFold,
   195			}
   196		}
   197	
   198		status := "success"
   199		for _, r := range e.results {
   200			if r.Status != "success" {
   201				status = "failed"
   202				break
   203			}
   204		}
   205		for _, fr := range foldResults {
   206			if fr.Status != "success" {
   207				status = "failed"
   208				break
   209			}
   210		}
   211	
   212		run := &CVRunOutput{
   213			Pipeline:    e.config.Pipeline.Name,
   214			Status:      status,
   215			CVFolds:     e.cvFolds,
   216			Stages:      e.results,
   217			FoldResults: foldResults,
   218			CVResults:   CVResults{Metrics: cvMetrics},
   219			Artifacts:   allArtifacts,
   220			CacheStats:  e.cacheStats,
   221		}
   222	
   223		if err := saveArtifacts(e.meta); err != nil {
   224			return nil, err
   225		}
   226		if err := saveRunAny(e.config.Pipeline.Name, run); err != nil {
   227			return nil, err
   228		}
   229		return run, nil
   230	}
