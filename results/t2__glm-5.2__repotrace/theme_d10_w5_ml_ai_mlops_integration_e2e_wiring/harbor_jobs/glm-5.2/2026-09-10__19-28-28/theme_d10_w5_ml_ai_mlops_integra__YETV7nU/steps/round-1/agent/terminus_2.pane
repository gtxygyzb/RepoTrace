   199	
   200	func deserializeArtifactValue(data []byte) (*ArtifactValue, error) {
   201		var obj map[string]interface{}
   202		if err := json.Unmarshal(data, &obj); err != nil {
   203			return nil, err
   204		}
   205		typ, _ := obj["type"].(string)
   206		switch typ {
   207		case "dataset":
   208			return deserializeDatasetValue(obj)
   209		case "model":
   210			return deserializeModelValue(obj)
   211		case "report":
   212			metrics, _ := obj["metrics"].(map[string]interface{})
   213			pass, _ := obj["pass"].(bool)
   214			return &ArtifactValue{Report: &Report{Metrics: metrics, Pass: pass}}, nil
   215		case "entry":
   216			name, _ := obj["name"].(string)
   217			version, _ := obj["version"].(float64)
   218			stage, _ := obj["stage"].(string)
   219			return &ArtifactValue{Entry: &RegistryEntry{Name: name, Version: int(version), Stage: stage}}, nil
   220		}
   221		return nil, fmt.Errorf("unknown artifact type in cache: %s", typ)
   222	}
   223	
   224	func deserializeDatasetValue(obj map[string]interface{}) (*ArtifactValue, error) {
   225		cols, _ := obj["columns"].([]interface{})
   226		typesMap, _ := obj["types"].(map[string]interface{})
   227		rows, _ := obj["rows"].([]interface{})
   228		ds := &Dataset{
   229			Columns: make([]string, len(cols)),
   230			Types:   make([]string, len(cols)),
   231			Rows:    make([][]string, len(rows)),
   232		}
   233		for i, c := range cols {
   234			ds.Columns[i], _ = c.(string)
   235		}
   236		for i, col := range ds.Columns {
   237			if t, ok := typesMap[col]; ok {
   238				ds.Types[i], _ = t.(string)
   239			}
   240		}
   241		for i, r := range rows {
   242			row, _ := r.([]interface{})
   243			ds.Rows[i] = make([]string, len(row))
   244			for j, v := range row {
   245				ds.Rows[i][j], _ = v.(string)
   246			}
   247		}
   248		return &ArtifactValue{Dataset: ds}, nil
   249	}
   250	
   251	func deserializeModelValue(obj map[string]interface{}) (*ArtifactValue, error) {
   252		modelData, err := json.Marshal(obj["model"])
   253		if err != nil {
   254			return nil, err
   255		}
   256		var model Model
   257		if err := json.Unmarshal(modelData, &model); err != nil {
   258			return nil, err
   259		}
   260		return &ArtifactValue{Model: &model}, nil
   261	}
