    13	
    14	func executeEvaluate(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
    15		modelVal := inputs["model"]
    16		if modelVal == nil || modelVal.Model == nil {
    17			return nil, fmt.Errorf("evaluate stage %q requires model input", stage.Name)
    18		}
    19		ds := inputDataset(inputs)
    20		if ds == nil {
    21			return nil, fmt.Errorf("evaluate stage %q requires data input", stage.Name)
    22		}
    23		model := modelVal.Model
    24	
    25		metrics, ok := getStringSlice(params, "metrics")
    26		if !ok {
    27			return nil, fmt.Errorf("evaluate stage %q requires metrics", stage.Name)
    28		}
    29		threshold, _ := getMap(params, "threshold")
    30	
    31		y, err := ds.NumericColumn(model.Target)
    32		if err != nil {
    33			return nil, err
    34		}
    35		X, err := ds.featureMatrix(model.Features)
    36		if err != nil {
    37			return nil, err
    38		}
    39		preds := model.PredictBatch(X)
    40		classification := isBinary01(y)
    41	
    42		report := &Report{Metrics: map[string]interface{}{}, Pass: true}
    43	
    44		for _, metric := range metrics {
    45			var val interface{}
    46			var err error
    47			switch metric {
    48			case "accuracy", "precision", "recall", "f1", "auc", "logloss", "confusion_matrix":
    49				if !classification {
    50					err = fmt.Errorf("metric %q requires binary 0/1 target", metric)
    51				} else {
    52					val, err = classificationMetric(metric, y, preds)
    53				}
    54			case "mse", "rmse", "mae", "r2", "mape":
    55				if classification {
    56					err = fmt.Errorf("metric %q requires regression target", metric)
    57				} else {
    58					val, err = regressionMetric(metric, y, preds)
    59				}
    60			default:
    61				err = fmt.Errorf("unknown metric %q", metric)
    62			}
    63			if err != nil {
    64				return nil, err
    65			}
    66			report.Metrics[metric] = val
    67		}
    68	
    69		if threshold != nil {
    70			for metricName, thresholdVal := range threshold {
    71				metricValue, ok := report.Metrics[metricName]
    72				if !ok {
    73					continue
    74				}
    75				fv, ok := toFloat64(metricValue)
    76				if !ok {
    77					continue
    78				}
    79				tv, ok := toFloat64(thresholdVal)
    80				if !ok {
    81					continue
    82				}
    83				if fv < tv {
    84					report.Pass = false
    85				}
    86			}
    87		}
    88	
    89		return map[string]*ArtifactValue{"report": {Report: report}}, nil
    90	}
    91	
    92	func classificationMetric(name string, y []float64, preds []float64) (interface{}, error) {
    93		labels := make([]int, len(preds))
    94		for i, p := range preds {
    95			if p >= 0.5 {
    96				labels[i] = 1
    97			} else {
    98				labels[i] = 0
    99			}
   100		}
   101		switch name {
   102		case "accuracy":
   103			correct := 0
   104			for i := range y {
   105				if labels[i] == int(y[i]) {
   106					correct++
   107				}
   108			}
   109			return float64(correct) / float64(len(y)), nil
   110		case "precision":
   111			tp, fp := 0, 0
   112			for i := range y {
   113				if labels[i] == 1 {
   114					if y[i] == 1 {
   115						tp++
   116					} else {
   117						fp++
   118					}
   119				}
   120			}
   121			if tp+fp == 0 {
   122				return 0.0, nil
   123			}
   124			return float64(tp) / float64(tp+fp), nil
   125		case "recall":
   126			tp, fn := 0, 0
   127			for i := range y {
   128				if y[i] == 1 {
   129					if labels[i] == 1 {
   130						tp++
   131					} else {
   132						fn++
   133					}
   134				}
   135			}
   136			if tp+fn == 0 {
   137				return 0.0, nil
   138			}
   139			return float64(tp) / float64(tp+fn), nil
   140		case "f1":
   141			p, _ := classificationMetric("precision", y, preds)
   142			r, _ := classificationMetric("recall", y, preds)
   143			pf := p.(float64)
   144			rf := r.(float64)
   145			if pf+rf == 0 {
   146				return 0.0, nil
   147			}
   148			return 2 * pf * rf / (pf + rf), nil
   149		case "auc":
   150			return aucROC(y, preds), nil
   151		case "logloss":
   152			sum := 0.0
   153			for i := range y {
   154				p := clamp(preds[i], 1e-15, 1-1e-15)
   155				sum += y[i]*math.Log(p) + (1-y[i])*math.Log(1-p)
   156			}
   157			return -sum / float64(len(y)), nil
   158		case "confusion_matrix":
   159			tp, fp, tn, fn := 0, 0, 0, 0
   160			for i := range y {
   161				if labels[i] == 1 && y[i] == 1 {
   162					tp++
   163				} else if labels[i] == 1 && y[i] == 0 {
   164					fp++
   165				} else if labels[i] == 0 && y[i] == 0 {
   166					tn++
   167				} else {
   168					fn++
   169				}
   170			}
   171			return map[string]int{"tp": tp, "fp": fp, "tn": tn, "fn": fn}, nil
   172		}
   173		return nil, fmt.Errorf("unknown classification metric %q", name)
   174	}
   175	
   176	func regressionMetric(name string, y []float64, preds []float64) (interface{}, error) {
   177		n := float64(len(y))
   178		switch name {
   179		case "mse":
   180			sum := 0.0
   181			for i := range y {
   182				d := y[i] - preds[i]
   183				sum += d * d
   184			}
   185			return sum / n, nil
   186		case "rmse":
   187			mse, _ := regressionMetric("mse", y, preds)
   188			return math.Sqrt(mse.(float64)), nil
   189		case "mae":
   190			sum := 0.0
   191			for i := range y {
   192				sum += math.Abs(y[i] - preds[i])
   193			}
   194			return sum / n, nil
   195		case "r2":
   196			mean := 0.0
   197			for _, v := range y {
   198				mean += v
   199			}
   200			mean /= n
   201			ssRes := 0.0
   202			ssTot := 0.0
   203			for i := range y {
   204				ssRes += (y[i] - preds[i]) * (y[i] - preds[i])
   205				ssTot += (y[i] - mean) * (y[i] - mean)
   206			}
   207			if ssTot == 0 {
   208				return 0.0, nil
   209			}
   210			return 1 - ssRes/ssTot, nil
   211		case "mape":
   212			sum := 0.0
   213			count := 0.0
   214			for i := range y {
   215				if y[i] == 0 {
   216					continue
   217				}
   218				sum += math.Abs((y[i] - preds[i]) / y[i])
   219				count++
   220			}
[?2004hroot@n30009:/app# nl -ba register.go | sed -n '220,300p'
[?2004l   220	}
   221	
   222	func validPromotionTransition(from, to string) bool {
   223		if from == "staging" && to == "production" {
   224			return true
   225		}
   226		if from == "production" && to == "archived" {
   227			return true
   228		}
   229		return false
   230	}
   231	
   232	func compareModels(name string, v1, v2 int) (map[string]interface{}, error) {
   233		e1, err := registryInfo(name, v1)
   234		if err != nil {
   235			return nil, err
   236		}
   237		e2, err := registryInfo(name, v2)
   238		if err != nil {
   239			return nil, err
   240		}
   241	
   242		metricsDiff := map[string]interface{}{}
   243		metricNames := map[string]bool{}
   244		for k := range e1.Metrics {
   245			metricNames[k] = true
   246		}
   247		for k := range e2.Metrics {
   248			metricNames[k] = true
   249		}
   250		for k := range metricNames {
   251			mv1, ok1 := toFloat64(e1.Metrics[k])
   252			mv2, ok2 := toFloat64(e2.Metrics[k])
   253			if !ok1 || !ok2 {
   254				metricsDiff[k] = map[string]interface{}{"v1": e1.Metrics[k], "v2": e2.Metrics[k], "delta": nil, "pct_change": nil}
   255				continue
   256			}
   257			delta := mv2 - mv1
   258			var pct interface{}
   259			if mv1 == 0 {
   260				pct = nil
   261			} else {
   262				pct = delta / math.Abs(mv1) * 100
   263			}
   264			metricsDiff[k] = map[string]interface{}{"v1": mv1, "v2": mv2, "delta": delta, "pct_change": pct}
   265		}
   266	
   267		hpDiff := map[string]interface{}{}
   268		hpNames := map[string]bool{}
   269		for k := range e1.Hyperparams {
   270			hpNames[k] = true
   271		}
   272		for k := range e2.Hyperparams {
   273			hpNames[k] = true
   274		}
   275		for k := range hpNames {
   276			v1v, ok1 := e1.Hyperparams[k]
   277			v2v, ok2 := e2.Hyperparams[k]
   278			if !ok1 || !ok2 || fmt.Sprintf("%v", v1v) != fmt.Sprintf("%v", v2v) {
   279				hpDiff[k] = map[string]interface{}{"v1": v1v, "v2": v2v}
   280			}
   281		}
   282	
   283		return map[string]interface{}{
   284			"model_name":       name,
   285			"versions":         []int{v1, v2},
