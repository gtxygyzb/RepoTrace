   165				} else if labels[i] == 0 && y[i] == 0 {
   166					tn++
   167				} else {
   168					fn++
   169				}
   170			}
   171			return map[string]int{"tp": tp, "fp": fp, "tn": tn, "fn": fn}, nil
   172		}
   173		return nil, fmt.Errorf("unknown classification metric %q", name)
   174	}
