[?2004l[?2004h> func opMinMax(ds *Dataset, op map[string]interface{}) error {
[?2004l[?2004h>     cols, ok := getStringSlice(op, "columns")
[?2004l[?2004h>     if !ok {
[?2004l[?2004h>         return fmt.Errorf("minmax requires columns")
[?2004l[?2004h>     }
[?2004l[?2004h>     minVal := getFloatDefault(op, "min", 0)
[?2004l[?2004h>     maxVal := getFloatDefault(op, "max", 1)
[?2004l[?2004h>     if maxVal < minVal {
[?2004l[?2004h>         return fmt.Errorf("minmax max must be >= min")
[?2004l[?2004h>     }
[?2004l[?2004h>     for _, col := range cols {
[?2004l[?2004h>         vals, err := ds.NumericColumn(col)
[?2004l[?2004h>         if err != nil {
[?2004l[?2004h>             return err
[?2004l[?2004h>         }
[?2004l[?2004h>         minCol := math.Inf(1)
[?2004l[?2004h>         maxCol := math.Inf(-1)
[?2004l[?2004h>         for _, v := range vals {
[?2004l[?2004h>             if v < minCol {
[?2004l[?2004h>                 minCol = v
[?2004l[?2004h>             }
[?2004l[?2004h>             if v > maxCol {
[?2004l[?2004h>                 maxCol = v
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         out := make([]string, len(vals))
[?2004l[?2004h>         for i, v := range vals {
[?2004l[?2004h>             if maxCol == minCol {
[?2004l[?2004h>                 out[i] = formatFloat(minVal)
[?2004l[?2004h>             } else {
[?2004l[?2004h>                 scaled := (v-minCol)/(maxCol-minCol)*(maxVal-minVal) + minVal
[?2004l[?2004h>                 out[i] = formatFloat(scaled)
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         ds.setColumnValues(col, out, "numeric")
[?2004l[?2004h>     }
[?2004l[?2004h>     return nil
[?2004l [?2004h> }
