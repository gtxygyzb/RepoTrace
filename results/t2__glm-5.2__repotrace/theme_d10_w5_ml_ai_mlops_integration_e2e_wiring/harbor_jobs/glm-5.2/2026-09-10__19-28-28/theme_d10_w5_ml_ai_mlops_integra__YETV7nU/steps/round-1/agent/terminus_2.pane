	Forest          []*TreeNode
	Boost           []*BoostedTree
	KNN             *KNNModel
	TrainFeatures   [][]float64
	TrainTarget     []float64
	EnsembleModels  []string               `json:"ensemble_models,omitempty"`
	ModelData       map[string]interface{} `json:"model_data,omitempty"`
}

type TreeNode struct {
	IsLeaf      bool
	Prediction  float64
	Probability float64
	Feature     int
	Threshold   float64
	Left        *TreeNode
	Right       *TreeNode
}

type BoostedTree struct {
	Tree           *TreeNode
	LearningRate   float64
	InitPrediction float64
}

type KNNModel struct {
	K              int
	Features       [][]float64
	Targets        []float64
	Classification bool
}

func executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
	var ds *Dataset
	for _, in := range inputs {
		if in != nil && in.Dataset != nil {
			ds = in.Dataset
			break
		}
	}
	if ds == nil {
		return nil, fmt.Errorf("train stage %q requires input data", stage.Name)
	}

	algorithm, ok := getString(params, "algorithm")
	if !ok {
		return nil, fmt.Errorf("train stage %q requires algorithm", stage.Name)
	}
	target, ok := getString(params, "target")
	if !ok {
		return nil, fmt.Errorf("train stage %q requires target", stage.Name)
	}
	targetVals, err := ds.NumericColumn(target)
	if err != nil {
		return nil, err
	}
	classification := isBinary01(targetVals)
	if algorithm == "linear-regression" {
		classification = false
	}
