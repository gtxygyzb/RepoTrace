   168	func cmdRegistryList(args []string) {
   169		name, stage, tag := "", "", ""
   170		for i := 0; i < len(args); i++ {
   171			switch {
   172			case args[i] == "--name" && i+1 < len(args):
   173				name = args[i+1]
   174				i++
   175			case strings.HasPrefix(args[i], "--name="):
   176				name = strings.TrimPrefix(args[i], "--name=")
   177			case args[i] == "--stage" && i+1 < len(args):
   178				stage = args[i+1]
   179				i++
   180			case strings.HasPrefix(args[i], "--stage="):
   181				stage = strings.TrimPrefix(args[i], "--stage=")
   182			case args[i] == "--tag" && i+1 < len(args):
   183				tag = args[i+1]
   184				i++
   185			case strings.HasPrefix(args[i], "--tag="):
   186				tag = strings.TrimPrefix(args[i], "--tag=")
   187			default:
   188				printError(fmt.Sprintf("unknown flag: %s", args[i]))
   189				return
   190			}
   191		}
   192		entries, err := listRegistry(name, stage, tag)
   193		if err != nil {
   194			printError(err.Error())
   195			return
   196		}
   197		out := make([]map[string]interface{}, len(entries))
   198		for i, e := range entries {
   199			out[i] = map[string]interface{}{
   200				"name":          e.Name,
   201				"version":       e.Version,
   202				"stage":         e.Stage,
   203				"tags":          e.Tags,
   204				"metrics":       e.Metrics,
   205				"registered_at": e.RegisteredAt,
   206			}
   207		}
   208		printJSON(out)
   209	}
