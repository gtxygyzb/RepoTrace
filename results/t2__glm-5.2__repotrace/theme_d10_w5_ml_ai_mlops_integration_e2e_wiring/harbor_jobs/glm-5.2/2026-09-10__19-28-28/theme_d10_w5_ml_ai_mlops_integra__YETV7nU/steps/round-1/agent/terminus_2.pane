   342	func parseRunArgs(args []string) (string, map[string]string, int, bool, []string, error) {
   343		configPath := ""
   344		overrides := map[string]string{}
   345		cv := 0
   346		noCache := false
   347		var skipStages []string
   348		for i := 0; i < len(args); i++ {
   349			switch {
   350			case args[i] == "--cv":
   351				if i+1 >= len(args) {
   352					return "", nil, 0, false, nil, fmt.Errorf("--cv requires a value")
   353				}
   354				k, err := strconv.Atoi(args[i+1])
   355				if err != nil {
   356					return "", nil, 0, false, nil, fmt.Errorf("invalid cv folds: %s", args[i+1])
   357				}
   358				if k < 2 {
   359					return "", nil, 0, false, nil, fmt.Errorf("cv folds must be >= 2")
   360				}
   361				cv = k
   362				i++
   363			case strings.HasPrefix(args[i], "--cv="):
   364				val := strings.TrimPrefix(args[i], "--cv=")
   365				k, err := strconv.Atoi(val)
   366				if err != nil {
   367					return "", nil, 0, false, nil, fmt.Errorf("invalid cv folds: %s", val)
   368				}
   369				if k < 2 {
   370					return "", nil, 0, false, nil, fmt.Errorf("cv folds must be >= 2")
   371				}
   372				cv = k
   373			case args[i] == "--no-cache":
   374				noCache = true
   375			case args[i] == "--param":
   376				if i+1 >= len(args) {
   377					return "", nil, 0, false, nil, fmt.Errorf("--param requires key=value")
   378				}
   379				kv := args[i+1]
   380				i++
   381				k, v, ok := strings.Cut(kv, "=")
   382				if !ok {
   383					return "", nil, 0, false, nil, fmt.Errorf("--param requires key=value")
   384				}
   385				overrides[k] = v
   386			case strings.HasPrefix(args[i], "--param="):
   387				kv := strings.TrimPrefix(args[i], "--param=")
   388				k, v, ok := strings.Cut(kv, "=")
   389				if !ok {
   390					return "", nil, 0, false, nil, fmt.Errorf("--param requires key=value")
   391				}
   392				overrides[k] = v
   393			case args[i] == "--skip-stage":
   394				if i+1 >= len(args) {
   395					return "", nil, 0, false, nil, fmt.Errorf("--skip-stage requires a value")
   396				}
   397				skipStages = append(skipStages, args[i+1])
   398				i++
   399			case strings.HasPrefix(args[i], "--skip-stage="):
   400				skipStages = append(skipStages, strings.TrimPrefix(args[i], "--skip-stage="))
   401			default:
   402				if configPath == "" && !strings.HasPrefix(args[i], "--") {
   403					configPath = args[i]
   404				} else {
   405					return "", nil, 0, false, nil, fmt.Errorf("unknown flag: %s", args[i])
   406				}
   407			}
   408		}
   409		if configPath == "" {
   410			return "", nil, 0, false, nil, fmt.Errorf("usage: mlpipe run <config.json> [--param key=value ...] [--cv K] [--no-cache] [--skip-stage name ...]")
   411		}
   412		return configPath, overrides, cv, noCache, skipStages, nil
   413	}
