    51		for k, v := range overrides {
    52			params[k] = v
    53		}
    54		return params
    55	}
    56	
    57	func substituteValue(v interface{}, globals map[string]interface{}) interface{} {
    58		switch x := v.(type) {
    59		case string:
    60			return paramRE.ReplaceAllStringFunc(x, func(m string) string {
    61				key := m[2 : len(m)-1]
    62				if val, ok := globals[key]; ok {
    63					return fmt.Sprintf("%v", val)
    64				}
    65				return m
    66			})
    67		case map[string]interface{}:
    68			res := map[string]interface{}{}
    69			for k, val := range x {
    70				res[k] = substituteValue(val, globals)
    71			}
    72			return res
    73		case []interface{}:
    74			res := make([]interface{}, len(x))
    75			for i, val := range x {
    76				res[i] = substituteValue(val, globals)
    77			}
    78			return res
    79		default:
    80			return v
    81		}
    82	}
    83	
    84	func (c *Config) stageParams(name string, globals map[string]interface{}) map[string]interface{} {
    85		for _, s := range c.Stages {
    86			if s.Name == name {
    87				if s.Params == nil {
    88					return map[string]interface{}{}
    89				}
    90				res := substituteValue(s.Params, globals)
    91				if m, ok := res.(map[string]interface{}); ok {
    92					return m
    93				}
    94				return map[string]interface{}{}
    95			}
    96		}
    97		return map[string]interface{}{}
    98	}
    99	
   100	func (c *Config) stageByName(name string) (*StageConfig, bool) {
   101		for i := range c.Stages {
   102			if c.Stages[i].Name == name {
   103				return &c.Stages[i], true
   104			}
   105		}
   106		return nil, false
   107	}
