func main() {
	if len(os.Args) < 2 {
		printError("usage: mlpipe <command> [args]")
		return
	}

	cmd := os.Args[1]
	args := os.Args[2:]

	switch cmd {
	case "run":
		cmdRun(args)
	case "plan":
		cmdPlan(args)
	case "validate":
		cmdValidate(args)
	case "registry":
		cmdRegistry(args)
	case "lineage":
		cmdLineage(args)
	case "history":
		cmdHistory(args)
	case "diff":
		cmdDiff(args)
	default:
		printError(fmt.Sprintf("unknown command: %s", cmd))
	}
}

