    73		for name := range stages1 {
    74			allNames[name] = true
    75		}
    76		for name := range stages2 {
    77			allNames[name] = true
    78		}
    79	
    80		names := make([]string, 0, len(allNames))
    81		for name := range allNames {
    82			names = append(names, name)
    83		}
    84		sort.Strings(names)
    85	
    86		for _, name := range names {
    87			s1, ok1 := stages1[name]
    88			s2, ok2 := stages2[name]
    89			if !ok1 {
    90				result.StagesAdded = append(result.StagesAdded, name)
