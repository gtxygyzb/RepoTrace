    24	
    25	func executeRegister(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
    26		modelVal := inputs["model"]
    27		if modelVal == nil || modelVal.Model == nil {
    28			return nil, fmt.Errorf("register stage %q requires model input", stage.Name)
    29		}
    30		reportVal := inputs["report"]
    31		if reportVal == nil || reportVal.Report == nil {
    32			return nil, fmt.Errorf("register stage %q requires report input", stage.Name)
    33		}
    34	
    35		name, ok := getString(params, "model_name")
    36		if !ok {
    37			return nil, fmt.Errorf("register stage %q requires model_name", stage.Name)
    38		}
    39		tags, _ := getStringSlice(params, "tags")
    40		if tags == nil {
    41			tags = []string{}
    42		}
    43		stageName, _ := getString(params, "stage")
    44		if stageName == "" {
    45			stageName = "staging"
    46		}
    47		if stageName != "staging" && stageName != "production" {
    48			return nil, fmt.Errorf("register stage %q invalid stage %q", stage.Name, stageName)
    49		}
    50		rules, _ := getMap(params, "promotion_rules")
    51	
    52		registry, err := loadRegistry()
    53		if err != nil {
    54			return nil, err
    55		}
    56		version := 1
    57		for _, e := range registry {
    58			if e.Name == name && e.Version >= version {
    59				version = e.Version + 1
    60			}
    61		}
    62	
    63		entry := &RegistryEntry{
    64			Name:           name,
    65			Version:        version,
    66			Stage:          stageName,
    67			Tags:           tags,
    68			Metrics:        reportVal.Report.Metrics,
    69			Hyperparams:    modelVal.Model.Hyperparams,
    70			ArtifactRefs:   map[string]string{},
    71			PromotionRules: rules,
    72			RegisteredAt:   time.Now().UTC().Format(time.RFC3339),
    73		}
    74		registry = append(registry, entry)
    75		if err := saveRegistry(registry); err != nil {
    76			return nil, err
    77		}
    78	
    79		return map[string]*ArtifactValue{"entry": {Entry: entry}}, nil
    80	}
    81	
    82	func registryPath() string {
    83		return filepath.Join(".mlpipe", "registry.json")
    84	}
    85	
    86	func loadRegistry() ([]*RegistryEntry, error) {
    87		data, err := os.ReadFile(registryPath())
    88		if err != nil {
    89			if os.IsNotExist(err) {
    90				return []*RegistryEntry{}, nil
    91			}
    92			return nil, err
    93		}
    94		var entries []*RegistryEntry
    95		if err := json.Unmarshal(data, &entries); err != nil {
    96			return nil, err
    97		}
    98		return entries, nil
    99	}
