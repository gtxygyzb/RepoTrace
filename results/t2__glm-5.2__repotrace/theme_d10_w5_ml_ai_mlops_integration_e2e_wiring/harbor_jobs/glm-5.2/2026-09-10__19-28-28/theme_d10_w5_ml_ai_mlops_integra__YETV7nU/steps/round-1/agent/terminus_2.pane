   162		valid := map[string]bool{"staging": true, "production": true, "archived": true}
   163		if !valid[targetStage] {
   164			return nil, "", "", nil, fmt.Errorf("invalid promotion: invalid target stage %q", targetStage)
   165		}
   166		entries, err := loadRegistry()
   167		if err != nil {
   168			return nil, "", "", nil, err
   169		}
   170		var entry *RegistryEntry
   171		for _, e := range entries {
   172			if e.Name == name && e.Version == version {
   173				entry = e
   174				break
   175			}
   176		}
   177		if entry == nil {
   178			return nil, "", "", nil, fmt.Errorf("model not found: %s:%d", name, version)
   179		}
   180	
   181		prevStage := entry.Stage
   182		if !validPromotionTransition(prevStage, targetStage) {
   183			return nil, "", "", nil, fmt.Errorf("invalid promotion: cannot promote from %s to %s", prevStage, targetStage)
   184		}
   185	
   186		warnings := []string{}
   187		if targetStage == "production" {
   188			if entry.PromotionRules != nil {
   189				if rules, ok := entry.PromotionRules[targetStage].(map[string]interface{}); ok {
   190					for metricName, thresholdVal := range rules {
   191						metricValue, ok := entry.Metrics[metricName]
   192						if !ok {
   193							continue
   194						}
   195						mv, ok := toFloat64(metricValue)
   196						if !ok {
   197							continue
   198						}
   199						tv, ok := toFloat64(thresholdVal)
   200						if !ok {
   201							continue
   202						}
   203						if mv < tv {
   204							warning := fmt.Sprintf("metric %s (%.4f) below threshold (%.4f)", metricName, mv, tv)
   205							if !force {
   206								return nil, prevStage, targetStage, nil, fmt.Errorf("%s", warning)
   207							}
   208							warnings = append(warnings, warning)
   209						}
   210					}
   211				}
   212			}
   213			for _, e := range entries {
   214				if e.Name == name && e.Stage == "production" && e.Version != version {
   215					e.Stage = "archived"
   216				}
   217			}
   218		}
   219	
   220		entry.Stage = targetStage
   221		if err := saveRegistry(entries); err != nil {
   222			return nil, "", "", nil, err
   223		}
   224		return entry, prevStage, targetStage, warnings, nil
   225	}
