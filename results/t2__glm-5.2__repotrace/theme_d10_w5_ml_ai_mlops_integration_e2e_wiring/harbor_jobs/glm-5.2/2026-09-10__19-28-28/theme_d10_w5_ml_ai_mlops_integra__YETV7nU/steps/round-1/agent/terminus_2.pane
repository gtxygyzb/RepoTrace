    33	func buildPlan(config *Config, overrides map[string]string, cv int) (*PlanOutput, error) {
    34		valid, errs := config.Validate()
    35		if !valid {
    36			return nil, fmt.Errorf("invalid pipeline: %s", errs[0])
    37		}
    38		if cv > 0 {
    39			if err := config.validateCV(); err != nil {
    40				return nil, err
    41			}
    42		}
    43	
    44		order, err := config.topologicalOrder()
    45		if err != nil {
    46			return nil, err
    47		}
    48	
    49		mode := "standard"
    50		if cv > 0 {
    51			mode = "cv"
    52		}
    53	
    54		postSplit := map[string]bool{}
    55		splitName := ""
    56		if cv > 0 {
    57			splitName, _ = config.splitStageName()
    58			postSplit = config.postSplitStages(splitName)
    59		}
    60	
    61		executionOrder := []string{}
    62		if cv > 0 {
    63			for _, name := range order {
    64				if !postSplit[name] {
    65					executionOrder = append(executionOrder, name)
    66				}
    67			}
    68			for _, name := range order {
    69				if postSplit[name] {
    70					executionOrder = append(executionOrder, name)
    71				}
    72			}
    73		} else {
    74			executionOrder = append(executionOrder, order...)
    75		}
    76	
    77		cacheKeys := map[string]string{}
    78		stages := map[string]PlanStage{}
    79		edges := []PlanEdge{}
    80	
    81		for _, name := range order {
    82			stage, _ := config.stageByName(name)
    83			deps := stage.DependsOn
    84			if deps == nil {
    85				deps = []string{}
    86			}
    87	
    88			inputTypes := map[string]string{}
    89			for local, ref := range stage.Inputs {
    90				refs, ok := inputRefs(ref)
    91				if !ok {
    92					continue
    93				}
    94				for _, r := range refs {
    95					parts := strings.SplitN(r, ".", 2)
    96					if len(parts) != 2 {
    97						continue
    98					}
    99					refStage, ok := config.stageByName(parts[0])
   100					if !ok {
   101						continue
   102					}
   103					inputTypes[local] = outputPortType(refStage.Type, parts[1])
   104					edges = append(edges, PlanEdge{From: parts[0], To: name, Port: parts[1]})
   105				}
   106			}
   107	
   108			outputTypes := map[string]string{}
   109			for _, port := range validOutputPorts(stage.Type) {
   110				outputTypes[port] = outputPortType(stage.Type, port)
   111			}
   112	
   113			cacheStatus := "unknown"
   114			phase := (*string)(nil)
   115			if cv > 0 {
   116				if postSplit[name] {
   117					phase = strPtr("per-fold")
   118				} else {
   119					phase = strPtr("pre-split")
   120				}
   121			}
   122	
   123			if cv == 0 || !postSplit[name] {
   124				params := config.stageParams(name, config.globalParams(overrides))
   125				inputKeys := map[string]string{}
   126				unknown := false
   127				for local, ref := range stage.Inputs {
   128					refs, ok := inputRefs(ref)
   129					if !ok {
   130						unknown = true
   131						break
   132					}
   133					var keys []string
   134					for _, r := range refs {
   135						parts := strings.SplitN(r, ".", 2)
   136						if len(parts) != 2 {
   137							unknown = true
   138							break
   139						}
   140						key, ok := cacheKeys[parts[0]]
   141						if !ok || key == "" {
   142							unknown = true
   143							break
   144						}
   145						keys = append(keys, key)
   146					}
   147					if unknown {
   148						break
   149					}
   150					inputKeys[local] = strings.Join(keys, "\n")
