   190			}
   191		case "train":
   192			if port == "model" {
   193				return "model"
   194			}
   195			if port == "predictions" {
   196				return "dataset"
   197			}
   198		case "evaluate":
   199			if port == "report" {
   200				return "report"
   201			}
   202		case "register":
   203			if port == "entry" {
   204				return "entry"
   205			}
   206		}
   207		return "unknown"
   208	}
