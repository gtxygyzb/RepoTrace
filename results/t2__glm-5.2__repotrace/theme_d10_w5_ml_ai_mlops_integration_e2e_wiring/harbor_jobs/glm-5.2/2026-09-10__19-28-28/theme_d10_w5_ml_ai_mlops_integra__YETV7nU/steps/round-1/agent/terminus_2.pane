   122		var pipelineFilter string
   123		var statusFilter string
   124		limit := -1
   125	
   126		for i := 0; i < len(args); i++ {
   127			arg := args[i]
   128			switch {
   129			case arg == "--pipeline":
   130				if i+1 >= len(args) {
   131					printError("--pipeline requires a value")
   132					return
   133				}
   134				pipelineFilter = args[i+1]
   135				i++
   136			case strings.HasPrefix(arg, "--pipeline="):
   137				pipelineFilter = strings.TrimPrefix(arg, "--pipeline=")
   138			case arg == "--status":
   139				if i+1 >= len(args) {
   140					printError("--status requires a value")
   141					return
   142				}
   143				statusFilter = args[i+1]
   144				i++
   145			case strings.HasPrefix(arg, "--status="):
   146				statusFilter = strings.TrimPrefix(arg, "--status=")
   147			case arg == "--limit":
   148				if i+1 >= len(args) {
   149					printError("--limit requires a value")
   150					return
   151				}
   152				n, err := strconv.Atoi(args[i+1])
   153				if err != nil {
   154					printError("--limit requires an integer")
   155					return
   156				}
   157				limit = n
   158				i++
   159			case strings.HasPrefix(arg, "--limit="):
   160				n, err := strconv.Atoi(strings.TrimPrefix(arg, "--limit="))
   161				if err != nil {
   162					printError("--limit requires an integer")
   163					return
   164				}
   165				limit = n
   166			default:
   167				printError(fmt.Sprintf("unknown flag: %s", arg))
   168				return
   169			}
   170		}
   171	
   172		if statusFilter != "" && statusFilter != "success" && statusFilter != "failed" {
   173			printError("--status must be success or failed")
   174			return
   175		}
   176	
   177		runs, err := loadHistory()
   178		if err != nil {
   179			printError(err.Error())
   180			return
   181		}
   182	
   183		filtered := make([]HistoryRun, 0, len(runs))
   184		for _, r := range runs {
   185			if pipelineFilter != "" && r.Pipeline != pipelineFilter {
   186				continue
   187			}
   188			if statusFilter != "" && r.Status != statusFilter {
   189				continue
   190			}
   191			filtered = append(filtered, r)
   192		}
   193	
   194		sort.Slice(filtered, func(i, j int) bool {
   195			a, errA := strconv.ParseInt(filtered[i].RunID, 10, 64)
   196			b, errB := strconv.ParseInt(filtered[j].RunID, 10, 64)
   197			if errA == nil && errB == nil {
   198				return a > b
   199			}
   200			return filtered[i].RunID > filtered[j].RunID
   201		})
   202	
   203		if limit >= 0 && len(filtered) > limit {
   204			filtered = filtered[:limit]
   205		}
   206	
   207		printJSON(HistoryOutput{Runs: filtered, Count: len(filtered)})
   208	}
