   181	func outputPortType(stageType, port string) string {
   182		switch stageType {
   183		case "data-source", "transform":
   184			if port == "data" {
   185				return "dataset"
   186			}
   187		case "split":
   188			if port == "train" || port == "test" {
   189				return "dataset"
   190			}
   191		case "train":
   192			if port == "model" {
   193				return "model"
   194			}
   195			if port == "predictions" {
   196				return "dataset"
   197			}
   198		case "evaluate":
   199			if port == "report" {
   200				return "report"
   201			}
   202		case "register":
   203			if port == "entry" {
   204				return "entry"
   205			}
   206		}
   207		return "unknown"
   208	}
