   236	func (e *Executor) inputCacheKeys(stage *StageConfig) map[string]string {
   237		keys := map[string]string{}
   238		for local, ref := range stage.Inputs {
   239			parts := strings.SplitN(ref, ".", 2)
   240			if len(parts) != 2 {
   241				continue
