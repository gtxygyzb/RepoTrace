    31	}
    32	
    33	func buildPlan(config *Config, overrides map[string]string, cv int) (*PlanOutput, error) {
    34		valid, errs := config.Validate()
    35		if !valid {
    36			return nil, fmt.Errorf("invalid pipeline: %s", errs[0])
    37		}
    38		if cv > 0 {
    39			if err := config.validateCV(); err != nil {
    40				return nil, err
    41			}
    42		}
    43	
    44		order, err := config.topologicalOrder()
    45		if err != nil {
    46			return nil, err
    47		}
    48	
    49		mode := "standard"
    50		if cv > 0 {
    51			mode = "cv"
    52		}
    53	
    54		postSplit := map[string]bool{}
    55		splitName := ""
    56		if cv > 0 {
    57			splitName, _ = config.splitStageName()
    58			postSplit = config.postSplitStages(splitName)
    59		}
    60	
    61		executionOrder := []string{}
    62		if cv > 0 {
    63			for _, name := range order {
    64				if !postSplit[name] {
    65					executionOrder = append(executionOrder, name)
    66				}
    67			}
    68			for _, name := range order {
    69				if postSplit[name] {
    70					executionOrder = append(executionOrder, name)
    71				}
    72			}
    73		} else {
    74			executionOrder = append(executionOrder, order...)
    75		}
    76	
    77		cacheKeys := map[string]string{}
    78		stages := map[string]PlanStage{}
    79		edges := []PlanEdge{}
    80	
    81		for _, name := range order {
    82			stage, _ := config.stageByName(name)
    83			deps := stage.DependsOn
    84			if deps == nil {
    85				deps = []string{}
    86			}
    87	
    88			inputTypes := map[string]string{}
    89			for local, ref := range stage.Inputs {
    90				parts := strings.SplitN(ref, ".", 2)
    91				if len(parts) != 2 {
    92					continue
    93				}
    94				refStage, ok := config.stageByName(parts[0])
    95				if !ok {
    96					continue
    97				}
    98				inputTypes[local] = outputPortType(refStage.Type, parts[1])
    99				edges = append(edges, PlanEdge{From: parts[0], To: name, Port: parts[1]})
   100			}
   101	
   102			outputTypes := map[string]string{}
   103			for _, port := range validOutputPorts(stage.Type) {
   104				outputTypes[port] = outputPortType(stage.Type, port)
   105			}
   106	
   107			cacheStatus := "unknown"
   108			phase := (*string)(nil)
   109			if cv > 0 {
   110				if postSplit[name] {
   111					phase = strPtr("per-fold")
   112				} else {
   113					phase = strPtr("pre-split")
   114				}
   115			}
   116	
   117			if cv == 0 || !postSplit[name] {
   118				params := config.stageParams(name, config.globalParams(overrides))
   119				inputKeys := map[string]string{}
   120				unknown := false
   121				for local, ref := range stage.Inputs {
   122					parts := strings.SplitN(ref, ".", 2)
   123					if len(parts) != 2 {
   124						unknown = true
   125						break
   126					}
   127					key, ok := cacheKeys[parts[0]]
   128					if !ok || key == "" {
   129						unknown = true
   130						break
   131					}
   132					inputKeys[local] = key
   133				}
   134				if !unknown {
   135					key, err := computeCacheKey(stage, params, inputKeys, -1)
   136					if err == nil {
   137						cacheKeys[name] = key
   138						if cacheEntryExists(key) {
   139							cacheStatus = "hit"
   140						} else {
   141							cacheStatus = "miss"
   142						}
   143					}
   144				}
   145			}
   146	
   147			stages[name] = PlanStage{
   148				Type:        stage.Type,
   149				DependsOn:   deps,
   150				InputTypes:  inputTypes,
   151				OutputTypes: outputTypes,
   152				CacheStatus: cacheStatus,
   153				CVPhase:     phase,
   154			}
   155		}
   156	
   157		sort.Slice(edges, func(i, j int) bool {
   158			if edges[i].From != edges[j].From {
   159				return edges[i].From < edges[j].From
   160			}
   161			if edges[i].To != edges[j].To {
   162				return edges[i].To < edges[j].To
   163			}
   164			return edges[i].Port < edges[j].Port
   165		})
   166	
   167		return &PlanOutput{
   168			Pipeline:       config.Pipeline.Name,
   169			Mode:           mode,
   170			CVFolds:        cv,
   171			ExecutionOrder: executionOrder,
   172			Stages:         stages,
   173			Edges:          edges,
   174		}, nil
   175	}
