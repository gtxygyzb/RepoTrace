   135	func (c *Config) Validate() (bool, []string) {
   136		errors := []string{}
   137		names := map[string]bool{}
   138		for i, s := range c.Stages {
   139			if s.Name == "" {
   140				errors = append(errors, fmt.Sprintf("stage at index %d has empty name", i))
   141				continue
   142			}
   143			if names[s.Name] {
   144				errors = append(errors, fmt.Sprintf("duplicate stage name: %s", s.Name))
   145			}
   146			names[s.Name] = true
   147		}
   148		for _, s := range c.Stages {
   149			if !validStageType(s.Type) {
   150				errors = append(errors, fmt.Sprintf("stage %q has unknown type %q", s.Name, s.Type))
   151			}
   152			for _, dep := range s.DependsOn {
   153				if !names[dep] {
   154					errors = append(errors, fmt.Sprintf("stage %q references unknown dependency %q", s.Name, dep))
   155				}
   156			}
   157			for local, ref := range s.Inputs {
   158				parts := strings.SplitN(ref, ".", 2)
   159				if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
   160					errors = append(errors, fmt.Sprintf("stage %q input %q has invalid reference %q", s.Name, local, ref))
   161					continue
   162				}
   163				refStage, ok := c.stageByName(parts[0])
   164				if !ok {
   165					errors = append(errors, fmt.Sprintf("stage %q input %q references unknown stage %q", s.Name, local, parts[0]))
   166					continue
   167				}
   168				ports := validOutputPorts(refStage.Type)
   169				valid := false
   170				for _, p := range ports {
   171					if p == parts[1] {
   172						valid = true
   173						break
   174					}
   175				}
   176				if !valid {
   177					errors = append(errors, fmt.Sprintf("stage %q input %q references unknown output port %q on stage %q", s.Name, local, parts[1], parts[0]))
   178				}
   179			}
   180		}
   181		if stages, cycle := c.detectCycle(); cycle {
   182			errors = append(errors, fmt.Sprintf("cycle detected involving stages: %s", strings.Join(stages, ", ")))
   183		}
   184		return len(errors) == 0, errors
   185	}
   186	
   187	func (c *Config) detectCycle() ([]string, bool) {
   188		adj := map[string][]string{}
   189		for _, s := range c.Stages {
   190			adj[s.Name] = append(adj[s.Name], s.DependsOn...)
   191		}
   192		color := map[string]int{}
   193		var stack []string
   194		var cycle []string
   195	
   196		var dfs func(node string) bool
   197		dfs = func(node string) bool {
   198			if color[node] == 1 {
   199				idx := -1
   200				for i, n := range stack {
   201					if n == node {
   202						idx = i
   203						break
   204					}
   205				}
   206				if idx >= 0 {
   207					cycle = append([]string{}, stack[idx:]...)
   208					cycle = append(cycle, node)
   209					if len(cycle) > 1 && cycle[0] == cycle[len(cycle)-1] {
   210						cycle = cycle[:len(cycle)-1]
   211					}
   212				}
   213				return true
   214			}
   215			if color[node] == 2 {
   216				return false
   217			}
   218			color[node] = 1
   219			stack = append(stack, node)
   220			for _, dep := range adj[node] {
   221				if _, ok := adj[dep]; ok {
   222					if dfs(dep) {
   223						return true
   224					}
   225				}
   226			}
   227			stack = stack[:len(stack)-1]
   228			color[node] = 2
   229			return false
   230		}
   231	
   232		for _, s := range c.Stages {
   233			if color[s.Name] == 0 {
   234				if dfs(s.Name) {
   235					return cycle, true
   236				}
   237			}
   238		}
   239		return nil, false
   240	}
