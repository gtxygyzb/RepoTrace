   547		return out
   548	}
   549	
   550	func (c *Config) descendants(name string) map[string]bool {
   551		adj := map[string][]string{}
   552		for _, s := range c.Stages {
   553			for _, dep := range c.stageDeps(&s) {
   554				adj[dep] = append(adj[dep], s.Name)
   555			}
   556		}
   557		set := map[string]bool{}
   558		var dfs func(n string)
   559		dfs = func(n string) {
   560			for _, next := range adj[n] {
   561				if !set[next] {
   562					set[next] = true
   563					dfs(next)
   564				}
   565			}
   566		}
   567		dfs(name)
   568		return set
   569	}
   570	
   571	func (c *Config) ancestors(name string) map[string]bool {
