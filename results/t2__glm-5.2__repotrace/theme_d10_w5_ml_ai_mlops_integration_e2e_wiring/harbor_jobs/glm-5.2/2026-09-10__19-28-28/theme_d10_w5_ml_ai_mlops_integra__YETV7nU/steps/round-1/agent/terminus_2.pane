   262				return nil, nil, fmt.Errorf("stage %q input %q references unavailable output %s.%s", stage.Name, local, depStage, port)
   263			}
   264			val, ok := e.values[depStage][port]
   265			if !ok || val == nil {
   266				return nil, nil, fmt.Errorf("stage %q input %q references unavailable artifact %s.%s", stage.Name, local, depStage, port)
   267			}
   268			inputs[local] = val
   269			ids = append(ids, id)
   270		}
   271		return inputs, ids, nil
   272	}
