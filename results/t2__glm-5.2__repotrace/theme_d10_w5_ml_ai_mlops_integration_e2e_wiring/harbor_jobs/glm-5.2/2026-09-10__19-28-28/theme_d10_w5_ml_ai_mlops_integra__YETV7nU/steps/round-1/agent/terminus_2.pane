    41	func cmdRun(args []string) {
    42		configPath, overrides, cv, noCache, skipStages, err := parseRunArgs(args)
    43		if err != nil {
    44			printError(err.Error())
    45			return
    46		}
    47		started := time.Now()
    48		config, err := loadConfig(configPath)
    49		if err != nil {
    50			printError(err.Error())
    51			return
    52		}
    53		for _, name := range skipStages {
    54			if _, ok := config.stageByName(name); !ok {
    55				printError(fmt.Sprintf("unknown stage: %s", name))
    56				return
    57			}
    58		}
    59		executor := NewExecutor(config, overrides)
    60		executor.noCache = noCache
    61		executor.skipStages = skipStages
    62		if noCache {
    63			executor.cacheStats = nil
    64		}
    65		executor.cvFolds = cv
    66		var run interface{}
    67		if cv > 0 {
    68			run, err = executor.RunCV()
    69		} else {
    70			run, err = executor.Run()
    71		}
    72		finished := time.Now()
    73		status := "failed"
    74		if err == nil {
    75			status = runStatus(run)
    76		}
    77		record := buildRunRecord(executor, started, finished, status)
