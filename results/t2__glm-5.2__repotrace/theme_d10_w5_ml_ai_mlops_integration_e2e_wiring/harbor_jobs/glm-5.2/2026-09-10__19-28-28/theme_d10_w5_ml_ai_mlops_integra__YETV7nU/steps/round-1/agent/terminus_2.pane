    74	func (e *Executor) Run() (*RunOutput, error) {
    75		valid, errs := e.config.Validate()
    76		if !valid {
    77			return nil, fmt.Errorf("%s", strings.Join(errs, "; "))
    78		}
    79		order, err := e.config.topologicalOrder()
    80		if err != nil {
    81			return nil, err
    82		}
    83	
    84		runArtifacts := map[string]*ArtifactOutput{}
    85	
    86		for _, name := range order {
    87			stage, _ := e.config.stageByName(name)
    88			e.outputs[name] = map[string]string{}
    89			e.values[name] = map[string]*ArtifactValue{}
    90			e.results[name] = &StageResult{Status: "pending", Outputs: map[string]string{}}
    91	
    92			skip := false
    93			for _, dep := range stage.DependsOn {
    94				if e.status[dep] != "success" {
    95					skip = true
    96					break
    97				}
    98			}
    99			if skip {
   100				e.status[name] = "skipped"
   101				e.results[name].Status = "skipped"
   102				continue
   103			}
   104	
   105			inputValues, inputIDs, err := e.resolveInputs(stage)
   106			if err != nil {
   107				e.status[name] = "failed"
   108				e.results[name].Status = "failed"
   109				e.results[name].Error = err.Error()
   110				continue
   111			}
   112	
   113			params := e.config.stageParams(name, e.globals)
   114			start := time.Now()
   115			out, err := executeStage(stage, params, inputValues)
   116			duration := time.Since(start).Milliseconds()
   117			e.results[name].DurationMs = duration
   118	
   119			if err != nil {
   120				e.status[name] = "failed"
   121				e.results[name].Status = "failed"
   122				e.results[name].Error = err.Error()
   123				continue
   124			}
   125	
   126			e.status[name] = "success"
   127			e.results[name].Status = "success"
   128			ts := time.Now().UnixNano()
   129	
   130			for port, val := range out {
   131				id := artifactID(e.config.Pipeline.Name, name, port, ts)
   132				e.values[name][port] = val
   133				e.outputs[name][port] = id
   134				typ := val.Type()
   135				summary := val.Summary()
   136				meta := &ArtifactMeta{
   137					ID:        id,
   138					Stage:     name,
   139					Port:      port,
   140					Type:      typ,
   141					Summary:   summary,
   142					Inputs:    inputIDs,
   143					Outputs:   []string{},
   144					Timestamp: ts,
   145				}
   146				e.meta[id] = meta
   147				for _, inID := range inputIDs {
   148					if parent, ok := e.meta[inID]; ok {
   149						parent.Outputs = appendUnique(parent.Outputs, id)
   150					}
   151				}
   152				runArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}
   153			}
   154		}
   155	
   156		status := "success"
   157		for _, s := range e.results {
   158			if s.Status != "success" {
   159				status = "failed"
   160				break
   161			}
   162		}
   163	
   164		run := &RunOutput{
   165			Pipeline:  e.config.Pipeline.Name,
   166			Status:    status,
   167			Stages:    e.results,
   168			Artifacts: runArtifacts,
   169		}
   170	
   171		if err := saveArtifacts(e.meta); err != nil {
   172			return nil, err
   173		}
   174		if err := saveRun(run); err != nil {
   175			return nil, err
   176		}
   177	
   178		return run, nil
   179	}
   180	
   181	func (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {
   182		inputs := map[string]*ArtifactValue{}
   183		ids := []string{}
   184		for local, ref := range stage.Inputs {
   185			parts := strings.SplitN(ref, ".", 2)
   186			if len(parts) != 2 {
   187				return nil, nil, fmt.Errorf("stage %q has invalid input reference %q", stage.Name, ref)
   188			}
   189			depStage, port := parts[0], parts[1]
   190			id, ok := e.outputs[depStage][port]
   191			if !ok {
   192				return nil, nil, fmt.Errorf("stage %q input %q references unavailable output %s.%s", stage.Name, local, depStage, port)
   193			}
   194			val, ok := e.values[depStage][port]
   195			if !ok || val == nil {
   196				return nil, nil, fmt.Errorf("stage %q input %q references unavailable artifact %s.%s", stage.Name, local, depStage, port)
   197			}
   198			inputs[local] = val
   199			ids = append(ids, id)
   200		}
   201		return inputs, ids, nil
   202	}
   203	
   204	func executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
   205		switch stage.Type {
   206		case "data-source":
   207			return executeDataSource(stage, params, inputs)
   208		case "transform":
   209			return executeTransform(stage, params, inputs)
   210		case "split":
   211			return executeSplit(stage, params, inputs)
   212		case "train":
   213			return executeTrain(stage, params, inputs)
   214		case "evaluate":
   215			return executeEvaluate(stage, params, inputs)
   216		case "register":
   217			return executeRegister(stage, params, inputs)
   218		}
   219		return nil, fmt.Errorf("unknown stage type %q", stage.Type)
   220	}
   221	
   222	func executeDataSource(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
   223		path, ok := getString(params, "path")
   224		if !ok {
   225			return nil, fmt.Errorf("data-source stage %q requires path", stage.Name)
   226		}
   227		schema, _ := getMap(params, "schema")
   228		ds, err := loadDataset(path, schema)
   229		if err != nil {
   230			return nil, err
   231		}
   232		return map[string]*ArtifactValue{"data": {Dataset: ds}}, nil
   233	}
   234	
   235	func (c *Config) topologicalOrder() ([]string, error) {
   236		indeg := map[string]int{}
   237		adj := map[string][]string{}
   238		for _, s := range c.Stages {
   239			indeg[s.Name] = 0
   240		}
   241		for _, s := range c.Stages {
   242			for _, dep := range s.DependsOn {
   243				if _, ok := c.stageByName(dep); ok {
   244					adj[dep] = append(adj[dep], s.Name)
   245					indeg[s.Name]++
   246				}
   247			}
   248		}
   249		queue := []string{}
   250		for _, s := range c.Stages {
   251			if indeg[s.Name] == 0 {
   252				queue = append(queue, s.Name)
   253			}
   254		}
   255		order := []string{}
   256		for len(queue) > 0 {
   257			node := queue[0]
   258			queue = queue[1:]
   259			order = append(order, node)
   260			for _, next := range adj[node] {
[?2004hroot@n30009:/app# nl -ba pipeline.go | sed -n '261,560p'
[?2004l   261				indeg[next]--
   262				if indeg[next] == 0 {
   263					queue = append(queue, next)
   264				}
   265			}
   266		}
   267		if len(order) < len(c.Stages) {
   268			if cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {
   269				return nil, fmt.Errorf("cycle detected involving stages: %s", strings.Join(cycle, ", "))
   270			}
   271			return nil, fmt.Errorf("cycle detected involving stages: %s", joinStageNames(c.Stages))
   272		}
   273		return order, nil
   274	}
   275	
   276	func joinStageNames(stages []StageConfig) string {
   277		names := []string{}
   278		for _, s := range stages {
   279			names = append(names, s.Name)
   280		}
   281		return strings.Join(names, ", ")
   282	}
