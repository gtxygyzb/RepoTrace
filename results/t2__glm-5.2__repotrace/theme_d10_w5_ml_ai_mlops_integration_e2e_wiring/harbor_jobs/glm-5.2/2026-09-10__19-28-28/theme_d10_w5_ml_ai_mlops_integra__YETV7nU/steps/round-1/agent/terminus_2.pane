[?2004l[?2004h>         case "sum":
[?2004l[?2004h>             for _, v := range windowVals {
[?2004l[?2004h>                 res += v
[?2004l[?2004h>             }
[?2004l[?2004h>         case "max":
[?2004l[?2004h>             res = windowVals[0]
[?2004l[?2004h>             for _, v := range windowVals {
[?2004l[?2004h>                 if v > res {
[?2004l[?2004h>                     res = v
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h>         case "min":
[?2004l[?2004h>             res = windowVals[0]
[?2004l[?2004h>             for _, v := range windowVals {
[?2004l[?2004h>                 if v < res {
[?2004l[?2004h>                     res = v
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h>         default:
