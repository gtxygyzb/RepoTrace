[?2004l[?2004h> func opZScore(ds *Dataset, op map[string]interface{}) error {
[?2004l[?2004h>     cols, ok := getStringSlice(op, "columns")
[?2004l[?2004h>     if !ok {
[?2004l[?2004h>         return fmt.Errorf("zscore requires columns")
[?2004l[?2004h>     }
[?2004l[?2004h>     for _, col := range cols {
[?2004l[?2004h>         vals, err := ds.NumericColumn(col)
[?2004l[?2004h>         if err != nil {
[?2004l[?2004h>             return err
[?2004l[?2004h>         }
[?2004l[?2004h>         mean := 0.0
[?2004l[?2004h>         for _, v := range vals {
[?2004l[?2004h>             mean += v
[?2004l[?2004h>         }
[?2004l[?2004h>         mean /= float64(len(vals))
[?2004l[?2004h>         sumSq := 0.0
[?2004l[?2004h>         for _, v := range vals {
[?2004l[?2004h>             d := v - mean
[?2004l[?2004h>             sumSq += d * d
[?2004l[?2004h>         }
[?2004l[?2004h>         std := math.Sqrt(sumSq / float64(len(vals)))
[?2004l[?2004h>         out := make([]string, len(vals))
[?2004l[?2004h>         for i, v := range vals {
[?2004l[?2004h>             if std == 0 {
[?2004l[?2004h>                 out[i] = "0"
[?2004l[?2004h>             } else {
[?2004l[?2004h>                 out[i] = formatFloat((v - mean) / std)
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         ds.setColumnValues(col, out, "numeric")
[?2004l[?2004h>     }
[?2004l[?2004h>     return nil
[?2004l[?2004h> }
