   281			if !ok {
   282				continue
   283			}
   284			for _, r := range refs {
   285				parts := strings.SplitN(r, ".", 2)
   286				if len(parts) != 2 {
   287					continue
   288				}
   289				depStage := parts[0]
   290				if key, ok := e.cacheKeys[depStage]; ok {
   291					keys[local] = keys[local] + key + "\n"
   292				}
   293			}
   294		}
   295		for k, v := range keys {
   296			keys[k] = strings.TrimRight(v, "\n")
   297		}
   298		return keys
   299	}
