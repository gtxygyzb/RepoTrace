     9	type Report struct {
    10		Metrics map[string]interface{} `json:"metrics"`
    11		Pass    bool                   `json:"pass"`
    12	}
    13	
    14	func executeEvaluate(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
    15		modelVal := inputs["model"]
    16		if modelVal == nil || modelVal.Model == nil {
    17			return nil, fmt.Errorf("evaluate stage %q requires model input", stage.Name)
    18		}
    19		ds := inputDataset(inputs)
    20		if ds == nil {
    21			return nil, fmt.Errorf("evaluate stage %q requires data input", stage.Name)
    22		}
    23		model := modelVal.Model
    24	
    25		metrics, ok := getStringSlice(params, "metrics")
    26		if !ok {
    27			return nil, fmt.Errorf("evaluate stage %q requires metrics", stage.Name)
    28		}
    29		threshold, _ := getMap(params, "threshold")
    30	
    31		y, err := ds.NumericColumn(model.Target)
    32		if err != nil {
    33			return nil, err
    34		}
    35		X, err := ds.featureMatrix(model.Features)
    36		if err != nil {
    37			return nil, err
    38		}
    39		preds := model.PredictBatch(X)
    40		classification := isBinary01(y)
    41	
    42		report := &Report{Metrics: map[string]interface{}{}, Pass: true}
    43	
    44		for _, metric := range metrics {
    45			var val interface{}
    46			var err error
    47			switch metric {
    48			case "accuracy", "precision", "recall", "f1", "auc", "logloss", "confusion_matrix":
    49				if !classification {
    50					err = fmt.Errorf("metric %q requires binary 0/1 target", metric)
    51				} else {
    52					val, err = classificationMetric(metric, y, preds)
    53				}
    54			case "mse", "rmse", "mae", "r2", "mape":
    55				if classification {
    56					err = fmt.Errorf("metric %q requires regression target", metric)
    57				} else {
    58					val, err = regressionMetric(metric, y, preds)
    59				}
    60			default:
    61				err = fmt.Errorf("unknown metric %q", metric)
    62			}
    63			if err != nil {
    64				return nil, err
    65			}
    66			report.Metrics[metric] = val
    67		}
    68	
    69		if threshold != nil {
    70			for metricName, thresholdVal := range threshold {
    71				metricValue, ok := report.Metrics[metricName]
    72				if !ok {
    73					continue
    74				}
    75				fv, ok := toFloat64(metricValue)
    76				if !ok {
    77					continue
    78				}
    79				tv, ok := toFloat64(thresholdVal)
    80				if !ok {
    81					continue
    82				}
    83				if fv < tv {
    84					report.Pass = false
    85				}
    86			}
    87		}
    88	
    89		return map[string]*ArtifactValue{"report": {Report: report}}, nil
    90	}
    91	
    92	func classificationMetric(name string, y []float64, preds []float64) (interface{}, error) {
    93		labels := make([]int, len(preds))
    94		for i, p := range preds {
    95			if p >= 0.5 {
    96				labels[i] = 1
    97			} else {
    98				labels[i] = 0
    99			}
   100		}
   101		switch name {
   102		case "accuracy":
   103			correct := 0
   104			for i := range y {
   105				if labels[i] == int(y[i]) {
   106					correct++
   107				}
   108			}
   109			return float64(correct) / float64(len(y)), nil
   110		case "precision":
   111			tp, fp := 0, 0
   112			for i := range y {
   113				if labels[i] == 1 {
   114					if y[i] == 1 {
   115						tp++
   116					} else {
   117						fp++
   118					}
   119				}
   120			}
