			kv := strings.TrimPrefix(args[i], "--param=")
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				return "", nil, 0, false, fmt.Errorf("--param requires key=value")
			}
			overrides[k] = v
		default:
			if configPath == "" && !strings.HasPrefix(args[i], "--") {
				configPath = args[i]
			} else {
				return "", nil, 0, false, fmt.Errorf("unknown flag: %s", args[i])
			}
		}
	}
	if configPath == "" {
		return "", nil, 0, false, fmt.Errorf("usage: mlpipe run <config.json> [--param key=value ...] [--cv K] [--no-cache]")
	}
	return configPath, overrides, cv, noCache, nil
}

