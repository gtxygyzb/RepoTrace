'''
new = '''func promoteModel(name string, version int, targetStage string, force bool) (*RegistryEntry, string, string, []string, error) {
\tvalid := map[string]bool{"staging": true, "production": true, "archived": true}
\tif !valid[targetStage] {
\t\treturn nil, "", "", nil, fmt.Errorf("invalid promotion: invalid target stage %q", targetStage)
\t}
\tentries, err := loadRegistry()
\tif err != nil {
\t\treturn nil, "", "", nil, err
\t}
\tvar entry *RegistryEntry
	for _, e := range entries {
		if e.Name == name && e.Version == version {
			entry = e
			break
		}
	}
	if entry == nil {
		return nil, "", "", nil, fmt.Errorf("model not found: %s:%d", name, version)
	}

	prevStage := entry.Stage
	if !validPromotionTransition(prevStage, targetStage) {
		return nil, "", "", nil, fmt.Errorf("invalid promotion: cannot promote from %s to %s", prevStage, targetStage)
	}

	warnings := []string{}
	if targetStage == "production" {
		if entry.PromotionRules != nil {
			if rules, ok := entry.PromotionRules[targetStage].(map[string]interface{}); ok {
				for metricName, thresholdVal := range rules {
					metricValue, ok := entry.Metrics[metricName]
					if !ok {
						continue
					}
					mv, ok := toFloat64(metricValue)
					if !ok {
						continue
					}
					tv, ok := toFloat64(thresholdVal)
					if !ok {
						continue
					}
					if mv < tv {
						warning := fmt.Sprintf("metric %s (%.4f) below threshold (%.4f)", metricName, mv, tv)
						if !force {
							return nil, prevStage, targetStage, nil, fmt.Errorf("%s", warning)
						}
						warnings = append(warnings, warning)
					}
				}
			}
		}
		for _, e := range entries {
			if e.Name == name && e.Stage == "production" && e.Version != version {
				e.Stage = "archived"
			}
		}
	}

	entry.Stage = targetStage
	if err := saveRegistry(entries); err != nil {
		return nil, "", "", nil, err
	}
	return entry, prevStage, targetStage, warnings, nil
}
'''
if old not in s:
    raise SystemExit("register.go pattern not found")
p.write_text(s.replace(old, new))
