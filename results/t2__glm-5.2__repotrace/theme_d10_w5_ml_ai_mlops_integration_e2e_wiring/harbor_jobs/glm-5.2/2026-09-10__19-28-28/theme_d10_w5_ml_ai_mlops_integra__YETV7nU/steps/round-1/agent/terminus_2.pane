    33	func cmdDiff(args []string) {
    34		if len(args) != 2 {
    35			exitError("usage: mlpipe diff <config1.json> <config2.json>")
    36			return
    37		}
    38		config1, err := loadConfig(args[0])
    39		if err != nil {
    40			exitError(err.Error())
    41			return
    42		}
    43		config2, err := loadConfig(args[1])
    44		if err != nil {
    45			exitError(err.Error())
    46			return
    47		}
    48		printJSON(diffConfigs(config1, config2))
    49	}
    50	
    51	func diffConfigs(c1, c2 *Config) ConfigDiff {
    52		result := ConfigDiff{
    53			StagesAdded:     []string{},
    54			StagesRemoved:   []string{},
    55			StagesModified:  map[string]StageDiff{},
    56			StagesUnchanged: []string{},
    57		}
    58	
    59		if c1.Pipeline.Name != c2.Pipeline.Name {
    60			result.PipelineName = &FieldDiff{Old: c1.Pipeline.Name, New: c2.Pipeline.Name}
    61		}
    62	
    63		stages1 := map[string]StageConfig{}
    64		for _, s := range c1.Stages {
    65			stages1[s.Name] = s
    66		}
    67		stages2 := map[string]StageConfig{}
    68		for _, s := range c2.Stages {
    69			stages2[s.Name] = s
    70		}
    71	
