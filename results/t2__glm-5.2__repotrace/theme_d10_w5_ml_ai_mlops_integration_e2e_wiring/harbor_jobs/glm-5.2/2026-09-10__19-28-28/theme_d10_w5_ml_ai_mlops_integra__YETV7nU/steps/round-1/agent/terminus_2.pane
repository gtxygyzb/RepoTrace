			ds = in.Dataset
			break
		}
	}
	if ds == nil {
		return nil, fmt.Errorf("train stage %q requires input data", stage.Name)
	}

	algorithm, ok := getString(params, "algorithm")
	if !ok {
		return nil, fmt.Errorf("train stage %q requires algorithm", stage.Name)
	}
	target, ok := getString(params, "target")
	if !ok {
		return nil, fmt.Errorf("train stage %q requires target", stage.Name)
	}
