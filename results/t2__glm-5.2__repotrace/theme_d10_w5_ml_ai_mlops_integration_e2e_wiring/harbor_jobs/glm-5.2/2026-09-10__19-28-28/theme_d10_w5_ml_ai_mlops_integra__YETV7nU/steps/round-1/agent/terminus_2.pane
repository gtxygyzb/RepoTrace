   161	func promoteModel(name string, version int, targetStage string) (*RegistryEntry, string, string, error) {
   162		valid := map[string]bool{"staging": true, "production": true, "archived": true}
   163		if !valid[targetStage] {
   164			return nil, "", "", fmt.Errorf("invalid promotion: invalid target stage %q", targetStage)
   165		}
   166		entries, err := loadRegistry()
   167		if err != nil {
   168			return nil, "", "", err
   169		}
   170		var entry *RegistryEntry
   171		for _, e := range entries {
   172			if e.Name == name && e.Version == version {
   173				entry = e
   174				break
   175			}
   176		}
   177		if entry == nil {
   178			return nil, "", "", fmt.Errorf("model not found: %s:%d", name, version)
   179		}
   180	
   181		prevStage := entry.Stage
   182		if !validPromotionTransition(prevStage, targetStage) {
   183			return nil, "", "", fmt.Errorf("invalid promotion: cannot promote from %s to %s", prevStage, targetStage)
   184		}
   185	
   186		if targetStage == "production" {
   187			if entry.PromotionRules != nil {
   188				if rules, ok := entry.PromotionRules[targetStage].(map[string]interface{}); ok {
   189					for metricName, thresholdVal := range rules {
   190						metricValue, ok := entry.Metrics[metricName]
   191						if !ok {
   192							continue
   193						}
   194						mv, ok := toFloat64(metricValue)
   195						if !ok {
   196							continue
   197						}
   198						tv, ok := toFloat64(thresholdVal)
   199						if !ok {
   200							continue
   201						}
   202						if mv < tv {
   203							return nil, prevStage, targetStage, fmt.Errorf("metric %s (%v) below threshold (%v)", metricName, mv, tv)
   204						}
   205					}
   206				}
   207			}
   208			for _, e := range entries {
   209				if e.Name == name && e.Stage == "production" && e.Version != version {
   210					e.Stage = "archived"
   211				}
   212			}
   213		}
   214	
   215		entry.Stage = targetStage
   216		if err := saveRegistry(entries); err != nil {
   217			return nil, "", "", err
   218		}
   219		return entry, prevStage, targetStage, nil
   220	}
   221	
   222	func validPromotionTransition(from, to string) bool {
   223		if from == "staging" && to == "production" {
   224			return true
   225		}
   226		if from == "production" && to == "archived" {
   227			return true
   228		}
   229		return false
   230	}
