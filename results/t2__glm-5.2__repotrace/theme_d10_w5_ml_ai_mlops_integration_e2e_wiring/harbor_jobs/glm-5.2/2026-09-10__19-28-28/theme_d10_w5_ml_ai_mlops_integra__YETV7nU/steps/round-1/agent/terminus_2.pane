			for idx, r := range refs {
				if r == "" {
					errors = append(errors, fmt.Sprintf("stage %q input %q[%d] has invalid empty reference", s.Name, local, idx))
					continue
				}
				parts := strings.SplitN(r, ".", 2)
				if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
					errors = append(errors, fmt.Sprintf("stage %q input %q has invalid reference %q", s.Name, local, r))
					continue
				}
				refStage, ok := c.stageByName(parts[0])
				if !ok {
					errors = append(errors, fmt.Sprintf("stage %q input %q references unknown stage %q", s.Name, local, parts[0]))
					continue
				}
				ports := validOutputPorts(refStage.Type)
				valid := false
				for _, p := range ports {
					if p == parts[1] {
						valid = true
						break
					}
				}
				if !valid {
					errors = append(errors, fmt.Sprintf("stage %q input %q references unknown output port %q on stage %q", s.Name, local, parts[1], parts[0]))
				}
			}
			if s.Type == "ensemble" && local == "models" {
				if _, ok := ref.([]interface{}); !ok {
					errors = append(errors, fmt.Sprintf("ensemble stage %q input %q must be an array", s.Name, local))
				}
			}
		}
		if s.Type == "ensemble" {
			models, ok := s.Inputs["models"]
			if !ok {
				errors = append(errors, fmt.Sprintf("ensemble stage %q requires inputs.models", s.Name))
			} else if refs, ok := inputRefs(models); !ok || len(refs) < 2 {
				errors = append(errors, fmt.Sprintf("ensemble stage %q requires at least 2 model inputs", s.Name))
			}
			if _, ok := s.Inputs["data"]; !ok {
				errors = append(errors, fmt.Sprintf("ensemble stage %q requires inputs.data", s.Name))
			}
			strategy, _ := getString(s.Params, "strategy")
			if strategy != "vote" && strategy != "average" {
				errors = append(errors, fmt.Sprintf("ensemble stage %q has invalid strategy %q (must be vote or average)", s.Name, strategy))
			}
			if _, ok := getString(s.Params, "target"); !ok {
				errors = append(errors, fmt.Sprintf("ensemble stage %q requires target param", s.Name))
			}
		}
	}
	if stages, cycle := c.detectCycle(); cycle {
		errors = append(errors, fmt.Sprintf("cycle detected involving stages: %s", strings.Join(stages, ", ")))
	}
	return len(errors) == 0, errors
}

