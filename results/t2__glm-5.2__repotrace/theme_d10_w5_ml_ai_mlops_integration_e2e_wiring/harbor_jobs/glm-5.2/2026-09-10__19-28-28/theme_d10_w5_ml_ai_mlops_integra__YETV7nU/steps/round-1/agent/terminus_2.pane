func invertMatrix(m [][]float64) ([][]float64, error) {
	n := len(m)
	a := make([][]float64, n)
	for i := range m {
		a[i] = append([]float64{}, m[i]...)
		a[i] = append(a[i], make([]float64, n)...)
		a[i][n+i] = 1
	}
	for i := 0; i < n; i++ {
		pivot := a[i][i]
		if math.Abs(pivot) < 1e-12 {
			// try pivot swap
			swap := -1
			for r := i + 1; r < n; r++ {
				if math.Abs(a[r][i]) > 1e-12 {
					swap = r
					break
				}
			}
			if swap == -1 {
				return nil, fmt.Errorf("matrix not invertible")
			}
			a[i], a[swap] = a[swap], a[i]
			pivot = a[i][i]
		}
		for j := 0; j < 2*n; j++ {
			a[i][j] /= pivot
		}
[?2004hroot@n30009:/app# sed -n '260,310p' train.go
[?2004l	}
	return inv, nil
}

func trainLogisticRegression(X [][]float64, y []float64, lr float64, epochs int) ([]float64, error) {
	n := len(X)
	if n == 0 {
		return nil, fmt.Errorf("no training data")
	}
	m := len(X[0])
	w := make([]float64, m+1)
	for e := 0; e < epochs; e++ {
		grad := make([]float64, m+1)
		for i := 0; i < n; i++ {
			z := w[0]
			for j := 0; j < m; j++ {
				z += w[j+1] * X[i][j]
			}
			p := 1 / (1 + math.Exp(-z))
			err := p - y[i]
			grad[0] += err
			for j := 0; j < m; j++ {
				grad[j+1] += err * X[i][j]
			}
		}
		for j := range w {
			w[j] -= lr * grad[j] / float64(n)
		}
	}
	return w, nil
}

