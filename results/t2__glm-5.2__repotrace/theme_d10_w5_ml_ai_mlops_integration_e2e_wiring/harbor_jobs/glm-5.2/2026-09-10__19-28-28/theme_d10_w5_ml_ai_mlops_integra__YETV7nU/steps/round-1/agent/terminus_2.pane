   102		var sb strings.Builder
   103		sb.WriteString(stage.Type)
   104		sb.WriteString("\n")
   105	
   106		paramsJSON, err := canonicalJSON(params)
   107		if err != nil {
   108			return "", err
   109		}
   110		sb.WriteString(paramsJSON)
   111		sb.WriteString("\n")
   112	
   113		if stage.Type == "data-source" {
   114			path, ok := getString(params, "path")
   115			if !ok {
   116				return "", fmt.Errorf("data-source stage %q requires path for cache key", stage.Name)
   117			}
   118			fileHash, err := fileSHA256(path)
   119			if err != nil {
   120				return "", err
   121			}
   122			sb.WriteString(fileHash)
   123		} else {
   124			ports := make([]string, 0, len(stage.Inputs))
   125			for port := range stage.Inputs {
   126				ports = append(ports, port)
   127			}
   128			sort.Strings(ports)
   129			for i, port := range ports {
   130				if i > 0 {
   131					sb.WriteString("\n")
   132				}
   133				sb.WriteString(port)
   134				sb.WriteString("=")
   135				if key, ok := inputKeys[port]; ok {
   136					sb.WriteString(key)
   137				}
   138			}
   139		}
   140	
   141		if fold >= 0 {
   142			sb.WriteString("\nfold=")
   143			sb.WriteString(strconv.Itoa(fold))
   144		}
   145	
   146		return sha256Hex([]byte(sb.String())), nil
   147	}
