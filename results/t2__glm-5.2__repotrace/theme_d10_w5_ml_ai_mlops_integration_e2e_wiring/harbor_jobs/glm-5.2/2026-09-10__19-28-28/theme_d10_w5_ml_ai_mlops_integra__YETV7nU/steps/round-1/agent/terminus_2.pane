   524	func (c *Config) stageDeps(s *StageConfig) []string {
   525		deps := map[string]bool{}
   526		for _, dep := range s.DependsOn {
   527			if dep != "" {
   528				deps[dep] = true
   529			}
   530		}
   531		for _, ref := range s.Inputs {
   532			parts := strings.SplitN(ref, ".", 2)
   533			if len(parts) == 2 && parts[0] != "" {
   534				deps[parts[0]] = true
   535			}
   536		}
   537		out := make([]string, 0, len(deps))
   538		for dep := range deps {
   539			out = append(out, dep)
   540		}
   541		sort.Strings(out)
   542		return out
   543	}
