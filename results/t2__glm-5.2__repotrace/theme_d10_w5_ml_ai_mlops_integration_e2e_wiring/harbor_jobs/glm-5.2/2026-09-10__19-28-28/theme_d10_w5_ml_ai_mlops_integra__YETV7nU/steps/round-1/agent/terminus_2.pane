func cmdPlan(args []string) {
	configPath, overrides, cv, err := parsePlanArgs(args)
	if err != nil {
		printError(err.Error())
		return
	}
	config, err := loadConfig(configPath)
	if err != nil {
		printError(err.Error())
		return
	}
	plan, err := buildPlan(config, overrides, cv)
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(plan)
}

func cmdValidate(args []string) {
	configPath := ""
	overrides := map[string]string{}
	for i := 0; i < len(args); i++ {
		switch {
		case args[i] == "--param":
			if i+1 >= len(args) {
				printError("--param requires key=value")
				return
			}
			kv := args[i+1]
			i++
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				printError("--param requires key=value")
				return
			}
			overrides[k] = v
		case strings.HasPrefix(args[i], "--param="):
			kv := strings.TrimPrefix(args[i], "--param=")
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				printError("--param requires key=value")
				return
			}
			overrides[k] = v
		default:
			if configPath == "" && !strings.HasPrefix(args[i], "--") {
				configPath = args[i]
			} else {
				printError(fmt.Sprintf("unknown flag: %s", args[i]))
				return
			}
		}
	}
	if configPath == "" {
		printError("usage: mlpipe validate <config.json> [--param key=value ...]")
		return
	}
	config, err := loadConfig(configPath)
	if err != nil {
		printError(err.Error())
		return
	}
	if len(overrides) > 0 {
		globals := config.globalParams(overrides)
		config.Pipeline.Params = globals
		for i := range config.Stages {
			config.Stages[i].Params = config.stageParams(config.Stages[i].Name, globals)
		}
	}
	valid, errors := config.Validate()
	printJSON(map[string]interface{}{"valid": valid, "errors": errors})
}
