[?2004l!ok {
\t\treturn nil, fmt.Errorf("ensemble stage %q requires strategy", stage.Name)
\t}
\tif strategy != "vote" && strategy != "average" {
\t\treturn nil, fmt.Errorf("ensemble stage %q has invalid strategy %q", stage.Name, strategy)
\t}

\tvar models []*Model
\tvar modelRefs []string
\tfor local, val := range inputs {
\t\tif !strings.HasPrefix(local, "models_") || val == nil || val.Model == nil {
\t\t\tcontinue
\t\t}
\t\tmodels = append(models, val.Model)
\t\tmodelRefs = append(modelRefs, strings.TrimPrefix(local, "models_"))
\t}
\tif len(models) < 2 {
\t\treturn nil, fmt.Errorf("ensemble stage %q requires at least 2 model inputs", stage.Name)
\t}

\tfeatureNames := ds.Columns
\tvar X [][]float64
\tif len(ds.Rows) > 0 {
\t\tfeatureNames = ds.Columns
\t\tfor _, row := range ds.Rows {
\t\t\tx, err := extractFeatures(row, ds.Columns, target)
\t\t\tif err != nil {
\t\t\t\treturn nil, err
\t\t\t}
\t\t\tX = append(X, x)
\t\t}
\t}

\tpreds := make([]float64, len(ds.Rows))
\tfor i := range ds.Rows {
\t\tmodelPreds := make([]float64, len(models))
\t\tfor j, m := range models {
\t\t\tx := X[i]
\t\t\tmodelPreds[j] = m.PredictBatch([][]float64{x})[0]
\t\t}
\t\tif strategy == "average" {
\t\t\tsum := 0.0
\t\t\tfor _, p := range modelPreds {
\t\t\t\tsum += p
\t\t\t}
\t\t\tpreds[i] = sum / float64(len(modelPreds))
\t\t} else {
\t\t\tpreds[i] = votePredict(modelPreds)
\t\t}
\t}

\tpredRows := make([][]string, len(ds.Rows))
\tfor i := range ds.Rows {
\t\trow := append([]string{}, ds.Rows[i]...)
\t\trow = append(row, formatFloat(preds[i]))
\t\tpredRows[i] = row
\t}
\tpredDS := &Dataset{
\t\tColumns: append(append([]string{}, ds.Columns...), "prediction"),
\t\tTypes:   append(append([]string{}, ds.Types...), "numeric"),
\t\tRows:    predRows,
\t}

\tensModel := &Model{
\t\tAlgorithm:      "ensemble",
\t\tTarget:         target,
\t\tEnsembleModels: modelRefs,
\t\tModelData:      map[string]interface{}{"models": modelRefs, "strategy": strategy},
\t}
\treturn map[string]*ArtifactValue{"predictions": {Dataset: predDS}, "model": {Model: ensModel}}, nil
}

func votePredict(preds []float64) float64 {
\tcounts := map[float64]int{}
\tfor _, p := range preds {
\t\tcounts[p]++
\t}
\tbest := preds[0]
\tbestCount := counts[best]
\tfor _, p := range preds {
\t\tif counts[p] > bestCount || (counts[p] == bestCount && p < best) {
\t\t\tbest = p
\t\t\tbestCount = counts[p]
\t\t}
\t}
\treturn best
}

func extractFeatures(row []string, columns []string, target string) ([]float64, error) {
\tx := make([]float64, 0, len(columns)-1)
\tfor i, col := range columns {
\t\tif col == target {
\t\t\tcontinue
\t\t}
\t\tval, err := strconv.ParseFloat(row[i], 64)
\t\tif err != nil {
\t\t\treturn nil, fmt.Errorf("invalid numeric value in column %q: %s", col, row[i])
\t\t}
\t\tx = append(x, val)
\t}
\treturn x, nil
}

