    49	func saveRunRecord(record *RunRecord) error {
    50		dir := filepath.Join(".mlpipe", "runs")
    51		if err := os.MkdirAll(dir, 0755); err != nil {
    52			return err
    53		}
    54		path := filepath.Join(dir, fmt.Sprintf("%s.json", record.RunID))
    55		data, err := json.MarshalIndent(record, "", "  ")
    56		if err != nil {
    57			return err
    58		}
    59		return os.WriteFile(path, data, 0644)
    60	}
    61	
    62	func runStatus(run interface{}) string {
    63		switch r := run.(type) {
    64		case *RunOutput:
    65			return r.Status
    66		case *CVRunOutput:
    67			return r.Status
    68		default:
    69			return "success"
    70		}
    71	}
