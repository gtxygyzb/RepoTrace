   176	func regressionMetric(name string, y []float64, preds []float64) (interface{}, error) {
   177		n := float64(len(y))
   178		switch name {
   179		case "mse":
   180			sum := 0.0
   181			for i := range y {
   182				d := y[i] - preds[i]
   183				sum += d * d
   184			}
   185			return sum / n, nil
   186		case "rmse":
   187			mse, _ := regressionMetric("mse", y, preds)
   188			return math.Sqrt(mse.(float64)), nil
   189		case "mae":
   190			sum := 0.0
   191			for i := range y {
   192				sum += math.Abs(y[i] - preds[i])
   193			}
   194			return sum / n, nil
   195		case "r2":
   196			mean := 0.0
   197			for _, v := range y {
   198				mean += v
   199			}
   200			mean /= n
   201			ssRes := 0.0
   202			ssTot := 0.0
   203			for i := range y {
   204				ssRes += (y[i] - preds[i]) * (y[i] - preds[i])
   205				ssTot += (y[i] - mean) * (y[i] - mean)
   206			}
   207			if ssTot == 0 {
   208				return 0.0, nil
   209			}
   210			return 1 - ssRes/ssTot, nil
   211		case "mape":
   212			sum := 0.0
   213			count := 0.0
   214			for i := range y {
   215				if y[i] == 0 {
   216					continue
   217				}
   218				sum += math.Abs((y[i] - preds[i]) / y[i])
   219				count++
   220			}
   221			if count == 0 {
   222				return 0.0, nil
   223			}
   224			return sum / count * 100, nil
   225		}
   226		return nil, fmt.Errorf("unknown regression metric %q", name)
   227	}
