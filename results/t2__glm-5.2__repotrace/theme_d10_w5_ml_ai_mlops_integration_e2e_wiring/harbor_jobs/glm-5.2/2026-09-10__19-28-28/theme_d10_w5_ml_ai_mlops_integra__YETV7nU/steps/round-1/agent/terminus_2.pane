[?2004l[?2004h>         if start < 0 {
[?2004l[?2004h>             start = 0
[?2004l[?2004h>         }
[?2004l[?2004h>         windowVals := vals[start : i+1]
[?2004l[?2004h>         var res float64
[?2004l[?2004h>         switch agg {
[?2004l[?2004h>         case "mean":
[?2004l[?2004h>             sum := 0.0
[?2004l[?2004h>             for _, v := range windowVals {
[?2004l[?2004h>                 sum += v
[?2004l[?2004h>             }
