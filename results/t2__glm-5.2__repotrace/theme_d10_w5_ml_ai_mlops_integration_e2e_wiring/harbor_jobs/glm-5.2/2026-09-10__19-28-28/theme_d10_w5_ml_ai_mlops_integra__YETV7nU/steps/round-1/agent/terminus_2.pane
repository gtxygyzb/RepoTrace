   363	func (c *Config) topologicalOrder() ([]string, error) {
   364		indeg := map[string]int{}
   365		adj := map[string][]string{}
   366		for _, s := range c.Stages {
   367			indeg[s.Name] = 0
   368		}
   369		for _, s := range c.Stages {
   370			for _, dep := range s.DependsOn {
   371				if _, ok := c.stageByName(dep); ok {
   372					adj[dep] = append(adj[dep], s.Name)
   373					indeg[s.Name]++
   374				}
   375			}
   376		}
   377		queue := []string{}
   378		for _, s := range c.Stages {
   379			if indeg[s.Name] == 0 {
   380				queue = append(queue, s.Name)
   381			}
   382		}
   383		order := []string{}
   384		for len(queue) > 0 {
   385			node := queue[0]
   386			queue = queue[1:]
   387			order = append(order, node)
   388			for _, next := range adj[node] {
   389				indeg[next]--
   390				if indeg[next] == 0 {
   391					queue = append(queue, next)
   392				}
   393			}
   394		}
   395		if len(order) < len(c.Stages) {
   396			if cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {
   397				return nil, fmt.Errorf("cycle detected involving stages: %s", strings.Join(cycle, ", "))
   398			}
   399			return nil, fmt.Errorf("cycle detected involving stages: %s", joinStageNames(c.Stages))
   400		}
   401		return order, nil
   402	}
   403	
   404	func joinStageNames(stages []StageConfig) string {
   405		names := []string{}
   406		for _, s := range stages {
   407			names = append(names, s.Name)
   408		}
   409		return strings.Join(names, ", ")
   410	}
   411	
   412	func artifactID(pipeline, stage, port string, ts int64) string {
   413		if pipeline == "" {
   414			pipeline = "pipeline"
   415		}
   416		return fmt.Sprintf("%s-%s-%s-%d", pipeline, stage, port, ts)
   417	}
