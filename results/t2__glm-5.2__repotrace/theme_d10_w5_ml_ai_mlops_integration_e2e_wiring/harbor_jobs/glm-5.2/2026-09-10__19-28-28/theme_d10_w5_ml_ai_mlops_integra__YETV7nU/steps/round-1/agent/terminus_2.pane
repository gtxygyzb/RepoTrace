old = '''func (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {
\tinputs := map[string]*ArtifactValue{}
\tids := []string{}
\tfor local, ref := range stage.Inputs {
\t\tparts := strings.SplitN(ref, ".", 2)
\t\tif len(parts) != 2 {
\t\t\treturn nil, nil, fmt.Errorf("stage %q has invalid input reference %q", stage.Name, ref)
\t\t}
\t\tdepStage, port := parts[0], parts[1]
\t\tid, ok := e.outputs[depStage][port]
\t\tif !ok {
\t\t\treturn nil, nil, fmt.Errorf("stage %q input %q references unavailable output %s.%s", stage.Name, local, depStage, port)
\t\t}
\t\tval, ok := e.values[depStage][port]
\t\tif !ok || val == nil {
\t\t\treturn nil, nil, fmt.Errorf("stage %q input %q references unavailable artifact %s.%s", stage.Name, local, depStage, port)
\t\t}
\t\tinputs[local] = val
\t\tids = append(ids, id)
\t}
\treturn inputs, ids, nil
}'''
new = '''func (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {
\tinputs := map[string]*ArtifactValue{}
\tids := []string{}
\tfor local, ref := range stage.Inputs {
\t\trefs, ok := inputRefs(ref)
\t\tif !ok {
\t\t\treturn nil, nil, fmt.Errorf("stage %q input %q has invalid reference %v", stage.Name, local, ref)
\t\t}
\t\tvar firstVal *ArtifactValue
\t\tfor _, r := range refs {
\t\t\tparts := strings.SplitN(r, ".", 2)
\t\t\tif len(parts) != 2 {
\t\t\t\treturn nil, nil, fmt.Errorf("stage %q has invalid input reference %q", stage.Name, r)
\t\t\t}
\t\t\tdepStage, port := parts[0], parts[1]
\t\t\tid, ok := e.outputs[depStage][port]
\t\t\tif !ok {
\t\t\t\treturn nil, nil, fmt.Errorf("stage %q input %q references unavailable output %s.%s", stage.Name, local, depStage, port)
\t\t\t}
\t\t\tval, ok := e.values[depStage][port]
\t\t\tif !ok || val == nil {
\t\t\t\treturn nil, nil, fmt.Errorf("stage %q input %q references unavailable artifact %s.%s", stage.Name, local, depStage, port)
\t\t\t}
\t\t\tids = append(ids, id)
\t\t\tif firstVal == nil {
\t\t\t\tfirstVal = val
\t\t\t}
\t\t\tif stage.Type == "ensemble" && local == "models" {
\t\t\t\tinputs[local+"_"+r] = val
\t\t\t}
\t\t}
\t\tif _, exists := inputs[local]; !exists {
\t\t\tinputs[local] = firstVal
\t\t}
\t}
\treturn inputs, ids, nil
}'''
if old not in s:
    raise SystemExit('resolveInputs old not found')
s = s.replace(old, new)
