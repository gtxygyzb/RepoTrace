[?2004lfunc buildRunRecord(executor *Executor, startedAt time.Time, finishedAt time.Time, status string) *RunRecord {
	mode := "standard"
	var cvFolds *int
	if executor.cvFolds > 0 {
		mode = "cv"
		f := executor.cvFolds
		cvFolds = &f
	}

	skipped := []string{}
	skipped = append(skipped, executor.skipStages...)

	summary := map[string]StageSummary{}
	for name, r := range executor.results {
		if r == nil {
			continue
		}
		summary[name] = StageSummary{
			Status:     r.Status,
			CacheHit:   r.CacheHit,
			DurationMs: r.DurationMs,
		}
	}

	var cacheStats *CacheStats
	if !executor.noCache {
		cacheStats = executor.cacheStats
		if cacheStats == nil {
			cacheStats = &CacheStats{}
		}
	}

	return &RunRecord{
		RunID:         strconv.FormatInt(finishedAt.UnixMilli(), 10),
		Pipeline:      executor.config.Pipeline.Name,
		StartedAt:     startedAt.UTC().Format(time.RFC3339),
		FinishedAt:    finishedAt.UTC().Format(time.RFC3339),
		DurationMs:    finishedAt.Sub(startedAt).Milliseconds(),
		Status:        status,
		Mode:          mode,
		CvFolds:       cvFolds,
		NoCache:       executor.noCache,
		SkippedStages: skipped,
		StageSummary:  summary,
		CacheStats:    cacheStats,
	}
}

