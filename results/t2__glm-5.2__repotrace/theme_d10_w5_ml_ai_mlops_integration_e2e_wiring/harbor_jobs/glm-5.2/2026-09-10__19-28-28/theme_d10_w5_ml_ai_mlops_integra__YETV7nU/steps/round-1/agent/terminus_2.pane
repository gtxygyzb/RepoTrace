func trainGradientBoost(X [][]float64, y []float64, classification bool, nEst int, lr float64, maxDepth int) []*BoostedTree {
	trees := []*BoostedTree{}
	init := 0.0
	if classification {
		p := 0.0
		for _, v := range y {
			p += v
		}
		p /= float64(len(y))
		if p <= 0 {
			p = 1e-15
		}
		if p >= 1 {
			p = 1 - 1e-15
		}
		init = math.Log(p / (1 - p))
	} else {
