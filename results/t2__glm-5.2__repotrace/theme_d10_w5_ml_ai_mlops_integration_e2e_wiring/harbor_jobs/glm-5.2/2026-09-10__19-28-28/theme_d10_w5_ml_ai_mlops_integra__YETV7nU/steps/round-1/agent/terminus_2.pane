    61		executionOrder := []string{}
    62		if cv > 0 {
    63			for _, name := range order {
    64				if !postSplit[name] {
    65					executionOrder = append(executionOrder, name)
    66				}
    67			}
    68			for _, name := range order {
    69				if postSplit[name] {
    70					executionOrder = append(executionOrder, name)
    71				}
    72			}
    73		} else {
    74			executionOrder = append(executionOrder, order...)
    75		}
    76	
    77		cacheKeys := map[string]string{}
    78		stages := map[string]PlanStage{}
    79		edges := []PlanEdge{}
    80	
    81		for _, name := range order {
    82			stage, _ := config.stageByName(name)
    83			deps := stage.DependsOn
    84			if deps == nil {
    85				deps = []string{}
    86			}
    87	
    88			inputTypes := map[string]string{}
    89			for local, ref := range stage.Inputs {
    90				parts := strings.SplitN(ref, ".", 2)
    91				if len(parts) != 2 {
    92					continue
    93				}
    94				refStage, ok := config.stageByName(parts[0])
    95				if !ok {
    96					continue
    97				}
    98				inputTypes[local] = outputPortType(refStage.Type, parts[1])
    99				edges = append(edges, PlanEdge{From: parts[0], To: name, Port: parts[1]})
   100			}
   101	
   102			outputTypes := map[string]string{}
   103			for _, port := range validOutputPorts(stage.Type) {
   104				outputTypes[port] = outputPortType(stage.Type, port)
   105			}
   106	
   107			cacheStatus := "unknown"
   108			phase := (*string)(nil)
   109			if cv > 0 {
   110				if postSplit[name] {
   111					phase = strPtr("per-fold")
   112				} else {
   113					phase = strPtr("pre-split")
   114				}
   115			}
   116	
   117			if cv == 0 || !postSplit[name] {
   118				params := config.stageParams(name, config.globalParams(overrides))
   119				inputKeys := map[string]string{}
   120				unknown := false
   121				for local, ref := range stage.Inputs {
   122					parts := strings.SplitN(ref, ".", 2)
   123					if len(parts) != 2 {
   124						unknown = true
   125						break
   126					}
   127					key, ok := cacheKeys[parts[0]]
   128					if !ok || key == "" {
   129						unknown = true
   130						break
   131					}
   132					inputKeys[local] = key
   133				}
   134				if !unknown {
   135					key, err := computeCacheKey(stage, params, inputKeys, -1)
   136					if err == nil {
   137						cacheKeys[name] = key
   138						if cacheEntryExists(key) {
   139							cacheStatus = "hit"
   140						} else {
   141							cacheStatus = "miss"
   142						}
   143					}
   144				}
   145			}
   146	
   147			if stage.Type == "register" {
   148				cacheStatus = "uncacheable"
   149			}
   150	
   151			stages[name] = PlanStage{
   152				Type:        stage.Type,
   153				DependsOn:   deps,
   154				InputTypes:  inputTypes,
   155				OutputTypes: outputTypes,
   156				CacheStatus: cacheStatus,
   157				CVPhase:     phase,
   158			}
   159		}
   160	
   161		sort.Slice(edges, func(i, j int) bool {
   162			if edges[i].From != edges[j].From {
   163				return edges[i].From < edges[j].From
   164			}
   165			if edges[i].To != edges[j].To {
   166				return edges[i].To < edges[j].To
   167			}
   168			return edges[i].Port < edges[j].Port
   169		})
   170	
   171		return &PlanOutput{
   172			Pipeline:       config.Pipeline.Name,
   173			Mode:           mode,
   174			CVFolds:        cv,
   175			ExecutionOrder: executionOrder,
   176			Stages:         stages,
   177			Edges:          edges,
   178		}, nil
   179	}
   180	
   181	func outputPortType(stageType, port string) string {
   182		switch stageType {
   183		case "data-source", "transform":
   184			if port == "data" {
   185				return "dataset"
   186			}
   187		case "split":
   188			if port == "train" || port == "test" {
   189				return "dataset"
   190			}
   191		case "train":
   192			if port == "model" {
   193				return "model"
   194			}
   195			if port == "predictions" {
   196				return "dataset"
   197			}
   198		case "evaluate":
   199			if port == "report" {
   200				return "report"
   201			}
   202		case "register":
   203			if port == "entry" {
   204				return "entry"
   205			}
   206		}
   207		return "unknown"
   208	}
