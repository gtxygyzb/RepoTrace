   147	func cmdRegistry(args []string) {
   148		if len(args) < 1 {
   149			printError("usage: mlpipe registry <list|info|promote|compare> [args]")
   150			return
   151		}
   152		sub := args[0]
   153		rest := args[1:]
   154		switch sub {
   155		case "list":
   156			cmdRegistryList(rest)
   157		case "info":
   158			cmdRegistryInfo(rest)
   159		case "promote":
   160			cmdRegistryPromote(rest)
   161		case "compare":
   162			cmdRegistryCompare(rest)
   163		default:
   164			printError(fmt.Sprintf("unknown registry command: %s", sub))
   165		}
   166	}
