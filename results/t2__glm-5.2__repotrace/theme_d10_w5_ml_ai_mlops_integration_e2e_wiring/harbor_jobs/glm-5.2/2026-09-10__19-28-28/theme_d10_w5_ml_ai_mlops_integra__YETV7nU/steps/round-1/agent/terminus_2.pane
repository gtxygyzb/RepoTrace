[?2004lpackage main

import (
	"fmt"
	"math"
	"math/rand"
	"sort"
	"strings"
	"time"
)

type CVFoldResult struct {
	Fold   int                     `json:"fold"`
	Status string                  `json:"status"`
	Stages map[string]*StageResult `json:"stages"`
}

type CVMetricAgg struct {
	Mean    float64   `json:"mean"`
	Std     float64   `json:"std"`
	PerFold []float64 `json:"per_fold"`
}

type CVResults struct {
	Metrics map[string]CVMetricAgg `json:"metrics"`
}

type CVRunOutput struct {
	Pipeline    string                     `json:"pipeline"`
	Status      string                     `json:"status"`
	CVFolds     int                        `json:"cv_folds"`
	Stages      map[string]*StageResult    `json:"stages"`
	FoldResults []CVFoldResult             `json:"fold_results"`
	CVResults   CVResults                  `json:"cv_results"`
	Artifacts   map[string]*ArtifactOutput `json:"artifacts"`
	CacheStats  *CacheStats                `json:"cache_stats,omitempty"`
}

func (e *Executor) RunCV() (*CVRunOutput, error) {
	if e.cvFolds < 2 {
		return nil, fmt.Errorf("cv folds must be >= 2")
	}

	valid, errs := e.config.Validate()
	if !valid {
		return nil, fmt.Errorf("%s", strings.Join(errs, "; "))
	}
	if err := e.config.validateCV(); err != nil {
		return nil, err
	}

	order, err := e.config.topologicalOrder()
	if err != nil {
		return nil, err
	}

	splitName, _ := e.config.splitStageName()
	postSplit := e.config.postSplitStages(splitName)
	preSplitOrder := []string{}
	postSplitOrder := []string{}
	for _, name := range order {
		if postSplit[name] {
			postSplitOrder = append(postSplitOrder, name)
		} else {
			preSplitOrder = append(preSplitOrder, name)
		}
	}

	allArtifacts := map[string]*ArtifactOutput{}

	for _, name := range preSplitOrder {
		e.executeStageCached(name, -1, 0, allArtifacts)
	}

	foldResults := make([]CVFoldResult, e.cvFolds)
	foldMetrics := make([]map[string]float64, e.cvFolds)

	for i := 0; i < e.cvFolds; i++ {
		foldExec := &Executor{
			config:     e.config,
			globals:    e.globals,
			status:     map[string]string{},
			results:    map[string]*StageResult{},
			outputs:    map[string]map[string]string{},
			values:     map[string]map[string]*ArtifactValue{},
			meta:       e.meta,
			cacheKeys:  map[string]string{},
			noCache:    e.noCache,
			cvFolds:    e.cvFolds,
			cacheStats: e.cacheStats,
		}
		for name, st := range e.status {
			foldExec.status[name] = st
		}
		for name, outs := range e.outputs {
			foldExec.outputs[name] = copyStringMap(outs)
		}
		for name, vals := range e.values {
			foldExec.values[name] = copyValueMap(vals)
		}
		for name, key := range e.cacheKeys {
			foldExec.cacheKeys[name] = key
		}

		foldArtifacts := map[string]*ArtifactOutput{}
		for _, name := range postSplitOrder {
			foldExec.executeStageCached(name, i, e.cvFolds, foldArtifacts)
		}

		foldStatus := "success"
		for _, r := range foldExec.results {
			if r.Status != "success" {
				foldStatus = "failed"
				break
			}
		}

		for id, art := range foldArtifacts {
			allArtifacts[id] = art
		}

		foldResults[i] = CVFoldResult{
			Fold:   i,
			Status: foldStatus,
			Stages: foldExec.results,
		}

		foldMetric := map[string]float64{}
		metricSums := map[string]float64{}
		metricCounts := map[string]int{}
		for _, name := range postSplitOrder {
			stage, _ := e.config.stageByName(name)
			if stage.Type != "evaluate" {
				continue
			}
			r, ok := foldExec.results[name]
			if !ok || r.Status != "success" {
				continue
			}
			val, ok := foldExec.values[name]["report"]
			if !ok || val == nil || val.Report == nil {
				continue
			}
			for metricName, metricValue := range val.Report.Metrics {
				fv, ok := toFloat64(metricValue)
				if !ok {
					continue
				}
				metricSums[metricName] += fv
				metricCounts[metricName]++
			}
		}
		for name, sum := range metricSums {
			if metricCounts[name] > 0 {
				foldMetric[name] = sum / float64(metricCounts[name])
			}
		}
		foldMetrics[i] = foldMetric
	}

	cvMetrics := map[string]CVMetricAgg{}
	metricNames := map[string]bool{}
	for _, fm := range foldMetrics {
		for name := range fm {
			metricNames[name] = true
		}
	}
	for name := range metricNames {
		perFold := make([]float64, e.cvFolds)
		sum := 0.0
		count := 0
		for i, fm := range foldMetrics {
			if v, ok := fm[name]; ok {
				perFold[i] = v
				sum += v
				count++
			} else {
				perFold[i] = 0.0
			}
		}
		mean := 0.0
		if count > 0 {
			mean = sum / float64(count)
		}
		variance := 0.0
		for _, v := range perFold {
			d := v - mean
			variance += d * d
		}
		variance /= float64(e.cvFolds)
		cvMetrics[name] = CVMetricAgg{
			Mean:    mean,
			Std:     math.Sqrt(variance),
			PerFold: perFold,
		}
	}

	status := "success"
	for _, r := range e.results {
		if r.Status != "success" {
			status = "failed"
			break
		}
	}
	for _, fr := range foldResults {
		if fr.Status != "success" {
			status = "failed"
			break
		}
	}

	run := &CVRunOutput{
		Pipeline:    e.config.Pipeline.Name,
		Status:      status,
		CVFolds:     e.cvFolds,
		Stages:      e.results,
		FoldResults: foldResults,
		CVResults:   CVResults{Metrics: cvMetrics},
		Artifacts:   allArtifacts,
		CacheStats:  e.cacheStats,
	}

	if err := saveArtifacts(e.meta); err != nil {
		return nil, err
	}
	return run, nil
}

func (e *Executor) executeStageCached(name string, fold, k int, runArtifacts map[string]*ArtifactOutput) bool {
	stage, _ := e.config.stageByName(name)
	e.outputs[name] = map[string]string{}
	e.values[name] = map[string]*ArtifactValue{}
	e.results[name] = &StageResult{Status: "pending", Outputs: map[string]string{}}

	skip := false
	for _, dep := range stage.DependsOn {
		if e.status[dep] != "success" {
			skip = true
			break
		}
	}
	if skip {
		e.status[name] = "skipped"
		e.results[name].Status = "skipped"
		return false
	}

	inputValues, inputIDs, err := e.resolveInputs(stage)
	if err != nil {
		e.status[name] = "failed"
		e.results[name].Status = "failed"
		e.results[name].Error = err.Error()
		return false
	}

	params := e.config.stageParams(name, e.globals)
	inputKeys := e.inputCacheKeys(stage)
	cacheKey, keyErr := computeCacheKey(stage, params, inputKeys, fold)
	if keyErr != nil {
		e.status[name] = "failed"
		e.results[name].Status = "failed"
		e.results[name].Error = keyErr.Error()
		return false
	}
	e.cacheKeys[name] = cacheKey

	var out map[string]*ArtifactValue
	start := time.Now()
	if !e.noCache && cacheEntryExists(cacheKey) {
		loaded, loadErr := loadCacheEntry(cacheKey)
		if loadErr == nil {
			out = loaded
			e.results[name].CacheHit = true
			e.cacheStats.Hits++
			e.results[name].DurationMs = time.Since(start).Milliseconds()
		} else {
			if !e.noCache {
				e.cacheStats.Misses++
			}
			out, err = e.executeStageForFold(stage, params, inputValues, fold, k)
			e.results[name].DurationMs = time.Since(start).Milliseconds()
			if err != nil {
				e.status[name] = "failed"
				e.results[name].Status = "failed"
				e.results[name].Error = err.Error()
				return false
			}
			if !e.noCache {
				_ = saveCacheEntry(cacheKey, name, stage.Type, out)
			}
		}
	} else {
		out, err = e.executeStageForFold(stage, params, inputValues, fold, k)
		e.results[name].DurationMs = time.Since(start).Milliseconds()
		if err != nil {
			e.status[name] = "failed"
			e.results[name].Status = "failed"
			e.results[name].Error = err.Error()
			return false
		}
		if !e.noCache {
			_ = saveCacheEntry(cacheKey, name, stage.Type, out)
			e.cacheStats.Misses++
		}
	}

	e.status[name] = "success"
	e.results[name].Status = "success"
	ts := time.Now().UnixNano()

	for port, val := range out {
		var id string
		if fold >= 0 {
			id = artifactIDFold(e.config.Pipeline.Name, name, port, ts, fold)
		} else {
			id = artifactID(e.config.Pipeline.Name, name, port, ts)
		}
		e.values[name][port] = val
		e.outputs[name][port] = id
		typ := val.Type()
		summary := val.Summary()
		meta := &ArtifactMeta{
			ID:        id,
			Stage:     name,
			Port:      port,
			Type:      typ,
			Summary:   summary,
			Inputs:    inputIDs,
			Outputs:   []string{},
			Timestamp: ts,
		}
		e.meta[id] = meta
		for _, inID := range inputIDs {
			if parent, ok := e.meta[inID]; ok {
				parent.Outputs = appendUnique(parent.Outputs, id)
			}
		}
		runArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}
	}
	return true
