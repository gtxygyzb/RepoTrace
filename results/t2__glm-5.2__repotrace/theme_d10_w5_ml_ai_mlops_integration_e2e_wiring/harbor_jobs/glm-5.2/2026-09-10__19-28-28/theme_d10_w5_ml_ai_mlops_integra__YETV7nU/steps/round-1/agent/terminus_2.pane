   112	func listRegistry(name, stage, tag string) ([]*RegistryEntry, error) {
   113		entries, err := loadRegistry()
   114		if err != nil {
   115			return nil, err
   116		}
   117		filtered := []*RegistryEntry{}
   118		for _, e := range entries {
   119			if name != "" && e.Name != name {
   120				continue
   121			}
   122			if stage != "" && e.Stage != stage {
   123				continue
   124			}
   125			if tag != "" {
   126				found := false
   127				for _, t := range e.Tags {
   128					if t == tag {
   129						found = true
   130						break
   131					}
   132				}
   133				if !found {
   134					continue
   135				}
   136			}
   137			filtered = append(filtered, e)
   138		}
   139		sort.Slice(filtered, func(i, j int) bool {
   140			if filtered[i].Name != filtered[j].Name {
   141				return filtered[i].Name < filtered[j].Name
   142			}
   143			return filtered[i].Version > filtered[j].Version
   144		})
   145		return filtered, nil
   146	}
