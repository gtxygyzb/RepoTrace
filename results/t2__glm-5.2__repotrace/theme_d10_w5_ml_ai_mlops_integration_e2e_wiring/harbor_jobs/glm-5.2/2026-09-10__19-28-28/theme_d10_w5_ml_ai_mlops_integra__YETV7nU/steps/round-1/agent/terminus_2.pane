[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"strconv"
	"strings"
)

func main() {
	if len(os.Args) < 2 {
		printError("usage: mlpipe <command> [args]")
		return
	}

	cmd := os.Args[1]
	args := os.Args[2:]

	switch cmd {
	case "run":
		cmdRun(args)
	case "plan":
		cmdPlan(args)
	case "validate":
		cmdValidate(args)
	case "registry":
		cmdRegistry(args)
	case "lineage":
		cmdLineage(args)
	default:
		printError(fmt.Sprintf("unknown command: %s", cmd))
	}
}

func cmdRun(args []string) {
	configPath, overrides, cv, noCache, skipStages, err := parseRunArgs(args)
	if err != nil {
		printError(err.Error())
		return
	}
	config, err := loadConfig(configPath)
	if err != nil {
		printError(err.Error())
		return
	}
	for _, name := range skipStages {
		if _, ok := config.stageByName(name); !ok {
			printError(fmt.Sprintf("unknown stage: %s", name))
			return
		}
	}
	executor := NewExecutor(config, overrides)
	executor.noCache = noCache
	executor.skipStages = skipStages
	if noCache {
		executor.cacheStats = nil
	}
	executor.cvFolds = cv
	var run interface{}
	if cv > 0 {
		run, err = executor.RunCV()
	} else {
		run, err = executor.Run()
	}
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(run)
}

func cmdPlan(args []string) {
	configPath, overrides, cv, err := parsePlanArgs(args)
	if err != nil {
		printError(err.Error())
		return
	}
	config, err := loadConfig(configPath)
	if err != nil {
		printError(err.Error())
		return
	}
	plan, err := buildPlan(config, overrides, cv)
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(plan)
}

func cmdValidate(args []string) {
	configPath := ""
	overrides := map[string]string{}
	fail := func(msg string) {
		printJSON(map[string]interface{}{"valid": false, "errors": []string{msg}})
	}
	for i := 0; i < len(args); i++ {
		switch {
		case args[i] == "--param":
			if i+1 >= len(args) {
				fail("--param requires key=value")
				return
			}
			kv := args[i+1]
			i++
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				fail("--param requires key=value")
				return
			}
			overrides[k] = v
		case strings.HasPrefix(args[i], "--param="):
			kv := strings.TrimPrefix(args[i], "--param=")
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				fail("--param requires key=value")
				return
			}
			overrides[k] = v
[?2004hroot@n30009:/app# sed -n '120,260p' main.go
[?2004l			overrides[k] = v
		default:
			if configPath == "" && !strings.HasPrefix(args[i], "--") {
				configPath = args[i]
			} else {
				fail(fmt.Sprintf("unknown flag: %s", args[i]))
				return
			}
		}
	}
	if configPath == "" {
		fail("usage: mlpipe validate <config.json> [--param key=value ...]")
		return
	}
	config, err := loadConfig(configPath)
	if err != nil {
		fail(err.Error())
		return
	}
	if len(overrides) > 0 {
		globals := config.globalParams(overrides)
		config.Pipeline.Params = globals
		for i := range config.Stages {
			config.Stages[i].Params = config.stageParams(config.Stages[i].Name, globals)
		}
	}
	valid, errors := config.Validate()
	printJSON(map[string]interface{}{"valid": valid, "errors": errors})
}

func cmdRegistry(args []string) {
	if len(args) < 1 {
		printError("usage: mlpipe registry <list|info|promote|compare> [args]")
		return
	}
	sub := args[0]
	rest := args[1:]
	switch sub {
	case "list":
		cmdRegistryList(rest)
	case "info":
		cmdRegistryInfo(rest)
	case "promote":
		cmdRegistryPromote(rest)
	case "compare":
		cmdRegistryCompare(rest)
	default:
		printError(fmt.Sprintf("unknown registry command: %s", sub))
	}
}

func cmdRegistryList(args []string) {
	name, stage, tag := "", "", ""
	for i := 0; i < len(args); i++ {
		switch {
		case args[i] == "--name" && i+1 < len(args):
			name = args[i+1]
			i++
		case strings.HasPrefix(args[i], "--name="):
			name = strings.TrimPrefix(args[i], "--name=")
		case args[i] == "--stage" && i+1 < len(args):
			stage = args[i+1]
			i++
		case strings.HasPrefix(args[i], "--stage="):
			stage = strings.TrimPrefix(args[i], "--stage=")
		case args[i] == "--tag" && i+1 < len(args):
			tag = args[i+1]
			i++
		case strings.HasPrefix(args[i], "--tag="):
			tag = strings.TrimPrefix(args[i], "--tag=")
		default:
			printError(fmt.Sprintf("unknown flag: %s", args[i]))
			return
		}
	}
	entries, err := listRegistry(name, stage, tag)
	if err != nil {
		printError(err.Error())
		return
	}
	out := make([]map[string]interface{}, len(entries))
	for i, e := range entries {
		out[i] = map[string]interface{}{
			"name":          e.Name,
			"version":       e.Version,
			"stage":         e.Stage,
			"tags":          e.Tags,
			"metrics":       e.Metrics,
			"registered_at": e.RegisteredAt,
		}
	}
	printJSON(map[string]interface{}{
		"models": out,
		"count":  len(out),
	})
}

func cmdRegistryInfo(args []string) {
	if len(args) < 1 {
		printError("usage: mlpipe registry info <name>:<version>")
		return
	}
	name, version, ok := splitNameVersion(args[0])
	if !ok {
		printError("invalid name:version format")
		return
	}
	entry, err := registryInfo(name, version)
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(entry)
}

func cmdRegistryPromote(args []string) {
	var positionals []string
	force := false
	for _, a := range args {
		if a == "--force" {
			force = true
			continue
		}
		if strings.HasPrefix(a, "--") {
			printError(fmt.Sprintf("unknown flag: %s", a))
			return
		}
		positionals = append(positionals, a)
	}
	if len(positionals) < 2 {
		printError("usage: mlpipe registry promote <name>:<version> <target_stage> [--force]")
		return
	}
	name, version, ok := splitNameVersion(positionals[0])
	if !ok {
		printError("invalid name:version format")
		return
	}
	target := positionals[1]
	entry, prev, new, warnings, err := promoteModel(name, version, target, force)
	if err != nil {
[?2004hroot@n30009:/app# sed -n '260,470p' main.go
[?2004l	if err != nil {
		if strings.HasPrefix(err.Error(), "metric ") {
			printJSON(map[string]interface{}{"success": false, "message": err.Error()})
			return
		}
		printError(err.Error())
		return
	}
	message := fmt.Sprintf("promoted to %s", new)
	if force {
		message = fmt.Sprintf("promoted to %s (forced)", new)
	}
	result := map[string]interface{}{
		"success":        true,
		"message":        message,
		"previous_stage": prev,
		"new_stage":      entry.Stage,
	}
	if force {
		result["warnings"] = warnings
	}
	printJSON(result)
}

func cmdRegistryCompare(args []string) {
	if len(args) < 2 {
		printError("usage: mlpipe registry compare <name>:<version1> <name>:<version2>")
		return
	}
	name1, v1, ok := splitNameVersion(args[0])
	if !ok {
		printError("invalid name:version format")
		return
	}
	name2, v2, ok := splitNameVersion(args[1])
	if !ok {
		printError("invalid name:version format")
		return
	}
	if name1 != name2 {
		printError("cannot compare different model names")
		return
	}
	result, err := compareModels(name1, v1, v2)
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(result)
}

func cmdLineage(args []string) {
	if len(args) < 2 {
		printError("usage: mlpipe lineage <artifact_id> <up|down|both>")
		return
	}
	id := args[0]
	direction := args[1]
	result, err := queryLineage(id, direction)
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(result)
}

func parseRunArgs(args []string) (string, map[string]string, int, bool, []string, error) {
	configPath := ""
	overrides := map[string]string{}
	cv := 0
	noCache := false
	var skipStages []string
	for i := 0; i < len(args); i++ {
		switch {
		case args[i] == "--cv":
			if i+1 >= len(args) {
				return "", nil, 0, false, nil, fmt.Errorf("--cv requires a value")
			}
			k, err := strconv.Atoi(args[i+1])
			if err != nil {
				return "", nil, 0, false, nil, fmt.Errorf("invalid cv folds: %s", args[i+1])
			}
			if k < 2 {
				return "", nil, 0, false, nil, fmt.Errorf("cv folds must be >= 2")
			}
			cv = k
			i++
		case strings.HasPrefix(args[i], "--cv="):
			val := strings.TrimPrefix(args[i], "--cv=")
			k, err := strconv.Atoi(val)
			if err != nil {
				return "", nil, 0, false, nil, fmt.Errorf("invalid cv folds: %s", val)
			}
			if k < 2 {
				return "", nil, 0, false, nil, fmt.Errorf("cv folds must be >= 2")
			}
			cv = k
		case args[i] == "--no-cache":
			noCache = true
		case args[i] == "--param":
			if i+1 >= len(args) {
				return "", nil, 0, false, nil, fmt.Errorf("--param requires key=value")
			}
			kv := args[i+1]
			i++
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				return "", nil, 0, false, nil, fmt.Errorf("--param requires key=value")
			}
			overrides[k] = v
		case strings.HasPrefix(args[i], "--param="):
			kv := strings.TrimPrefix(args[i], "--param=")
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				return "", nil, 0, false, nil, fmt.Errorf("--param requires key=value")
			}
			overrides[k] = v
		case args[i] == "--skip-stage":
			if i+1 >= len(args) {
				return "", nil, 0, false, nil, fmt.Errorf("--skip-stage requires a value")
			}
			skipStages = append(skipStages, args[i+1])
			i++
		case strings.HasPrefix(args[i], "--skip-stage="):
			skipStages = append(skipStages, strings.TrimPrefix(args[i], "--skip-stage="))
		default:
			if configPath == "" && !strings.HasPrefix(args[i], "--") {
				configPath = args[i]
			} else {
				return "", nil, 0, false, nil, fmt.Errorf("unknown flag: %s", args[i])
			}
		}
	}
	if configPath == "" {
		return "", nil, 0, false, nil, fmt.Errorf("usage: mlpipe run <config.json> [--param key=value ...] [--cv K] [--no-cache] [--skip-stage name ...]")
	}
	return configPath, overrides, cv, noCache, skipStages, nil
}

func parsePlanArgs(args []string) (string, map[string]string, int, error) {
	configPath := ""
	overrides := map[string]string{}
	cv := 0
	for i := 0; i < len(args); i++ {
		switch {
		case args[i] == "--cv":
			if i+1 >= len(args) {
				return "", nil, 0, fmt.Errorf("--cv requires a value")
			}
			k, err := strconv.Atoi(args[i+1])
			if err != nil {
				return "", nil, 0, fmt.Errorf("invalid cv folds: %s", args[i+1])
			}
			if k < 2 {
				return "", nil, 0, fmt.Errorf("cv folds must be >= 2")
			}
			cv = k
			i++
		case strings.HasPrefix(args[i], "--cv="):
			val := strings.TrimPrefix(args[i], "--cv=")
			k, err := strconv.Atoi(val)
			if err != nil {
				return "", nil, 0, fmt.Errorf("invalid cv folds: %s", val)
			}
			if k < 2 {
				return "", nil, 0, fmt.Errorf("cv folds must be >= 2")
			}
			cv = k
		case args[i] == "--param":
			if i+1 >= len(args) {
				return "", nil, 0, fmt.Errorf("--param requires key=value")
			}
			kv := args[i+1]
			i++
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				return "", nil, 0, fmt.Errorf("--param requires key=value")
			}
			overrides[k] = v
		case strings.HasPrefix(args[i], "--param="):
			kv := strings.TrimPrefix(args[i], "--param=")
			k, v, ok := strings.Cut(kv, "=")
			if !ok {
				return "", nil, 0, fmt.Errorf("--param requires key=value")
			}
			overrides[k] = v
		default:
			if configPath == "" && !strings.HasPrefix(args[i], "--") {
				configPath = args[i]
			} else {
				return "", nil, 0, fmt.Errorf("unknown flag: %s", args[i])
			}
		}
	}
	if configPath == "" {
		return "", nil, 0, fmt.Errorf("usage: mlpipe plan <config.json> [--param key=value ...] [--cv K]")
	}
	return configPath, overrides, cv, nil
}

func splitNameVersion(s string) (string, int, bool) {
	parts := strings.SplitN(s, ":", 2)
	if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
		return "", 0, false
	}
	var version int
	if _, err := fmt.Sscanf(parts[1], "%d", &version); err != nil {
		return "", 0, false
	}
	return parts[0], version, true
}
