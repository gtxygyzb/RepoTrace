   398			node := queue[0]
   399			queue = queue[1:]
   400			order = append(order, node)
   401			for _, next := range adj[node] {
   402				indeg[next]--
   403				if indeg[next] == 0 {
   404					queue = append(queue, next)
   405				}
   406			}
   407		}
   408		if len(order) < len(c.Stages) {
   409			if cycle, ok := c.detectCycle(); ok && len(cycle) > 0 {
   410				return nil, fmt.Errorf("cycle detected involving stages: %s", strings.Join(cycle, ", "))
   411			}
   412			return nil, fmt.Errorf("cycle detected involving stages: %s", joinStageNames(c.Stages))
   413		}
