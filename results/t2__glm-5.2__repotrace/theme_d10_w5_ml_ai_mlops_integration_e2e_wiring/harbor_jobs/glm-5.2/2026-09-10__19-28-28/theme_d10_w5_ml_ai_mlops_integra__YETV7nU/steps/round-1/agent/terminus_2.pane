[?2004lfunc saveRunAny(pipelineName string, run interface{}) error {
	dir := filepath.Join(".mlpipe", "runs")
	if err := os.MkdirAll(dir, 0755); err != nil {
		return err
	}
	name := safeFileName(pipelineName)
	if name == "" {
		name = "pipeline"
	}
	path := filepath.Join(dir, fmt.Sprintf("%s-%d.json", name, time.Now().UnixNano()))
	data, err := json.MarshalIndent(run, "", "  ")
	if err != nil {
		return err
	}
	return os.WriteFile(path, data, 0644)
}

func safeFileName(s string) string {
	if s == "" {
		return "pipeline"
	}
	return strings.Map(func(r rune) rune {
		if r == '/' || r == '\\' || r == ':' || r == ' ' {
			return '_'
		}
		return r
	}, s)
}

[?2004hroot@n30009:/app# sed -n '36,71p' main.go
[?2004lfunc cmdRun(args []string) {
	configPath, overrides, cv, noCache, skipStages, err := parseRunArgs(args)
	if err != nil {
		printError(err.Error())
		return
	}
	config, err := loadConfig(configPath)
	if err != nil {
		printError(err.Error())
		return
	}
	for _, name := range skipStages {
		if _, ok := config.stageByName(name); !ok {
			printError(fmt.Sprintf("unknown stage: %s", name))
			return
		}
	}
	executor := NewExecutor(config, overrides)
	executor.noCache = noCache
	executor.skipStages = skipStages
	if noCache {
		executor.cacheStats = nil
	}
	executor.cvFolds = cv
	var run interface{}
	if cv > 0 {
		run, err = executor.RunCV()
	} else {
		run, err = executor.Run()
	}
	if err != nil {
		printError(err.Error())
		return
	}
	printJSON(run)
}
