    12	type Dataset struct {
    13		Columns []string   `json:"columns"`
    14		Types   []string   `json:"types"`
    15		Rows    [][]string `json:"rows"`
    16	}
    17	
    18	func loadDataset(path string, schema map[string]interface{}) (*Dataset, error) {
    19		f, err := os.Open(path)
    20		if err != nil {
    21			if os.IsNotExist(err) {
    22				return nil, fmt.Errorf("file not found: %s", path)
    23			}
    24			return nil, err
    25		}
    26		defer f.Close()
    27	
    28		r := csv.NewReader(f)
    29		records, err := r.ReadAll()
    30		if err != nil {
    31			return nil, err
    32		}
    33		if len(records) == 0 {
    34			return &Dataset{Columns: []string{}, Types: []string{}, Rows: [][]string{}}, nil
    35		}
    36	
    37		header := records[0]
    38		rows := records[1:]
    39		columns := header
    40		types := make([]string, len(columns))
    41		for i, col := range columns {
    42			if schemaType, ok := schema[col]; ok {
    43				types[i] = fmt.Sprintf("%v", schemaType)
    44			} else {
    45				types[i] = inferColumnType(rows, i)
    46			}
    47		}
    48		return &Dataset{Columns: columns, Types: types, Rows: rows}, nil
    49	}
    50	
    51	func inferColumnType(rows [][]string, idx int) string {
    52		for _, row := range rows {
    53			if idx >= len(row) {
    54				continue
    55			}
    56			val := strings.TrimSpace(row[idx])
    57			if val == "" {
    58				continue
    59			}
    60			if _, ok := parseFloat64(val); !ok {
    61				return "categorical"
    62			}
    63		}
    64		return "numeric"
    65	}
    66	
    67	func parseFloat64(s string) (float64, bool) {
    68		s = strings.TrimSpace(s)
    69		if s == "" {
    70			return 0, false
    71		}
    72		f, err := strconv.ParseFloat(s, 64)
    73		if err != nil {
    74			return 0, false
    75		}
    76		return f, true
    77	}
    78	
    79	func formatFloat(f float64) string {
    80		if math.IsNaN(f) {
    81			return "NaN"
    82		}
    83		if math.IsInf(f, 1) {
    84			return "+Inf"
    85		}
    86		if math.IsInf(f, -1) {
    87			return "-Inf"
    88		}
    89		return strconv.FormatFloat(f, 'g', -1, 64)
    90	}
    91	
    92	func (ds *Dataset) ColumnIndex(name string) (int, bool) {
    93		for i, c := range ds.Columns {
    94			if c == name {
    95				return i, true
    96			}
    97		}
    98		return -1, false
    99	}
   100	
   101	func (ds *Dataset) Copy() *Dataset {
   102		cols := append([]string{}, ds.Columns...)
   103		types := append([]string{}, ds.Types...)
   104		rows := make([][]string, len(ds.Rows))
   105		for i, row := range ds.Rows {
   106			rows[i] = append([]string{}, row...)
   107		}
   108		return &Dataset{Columns: cols, Types: types, Rows: rows}
   109	}
   110	
   111	func (ds *Dataset) Summary() map[string]interface{} {
   112		return map[string]interface{}{
   113			"rows":         len(ds.Rows),
   114			"columns":      len(ds.Columns),
   115			"column_names": ds.Columns,
   116			"column_types": ds.Types,
   117		}
   118	}
