	switch t {
	case "data-source":
		return []string{"data"}
	case "transform":
		return []string{"data"}
	case "split":
		return []string{"train", "test"}
	case "train":
		return []string{"model", "predictions"}
	case "evaluate":
		return []string{"report"}
