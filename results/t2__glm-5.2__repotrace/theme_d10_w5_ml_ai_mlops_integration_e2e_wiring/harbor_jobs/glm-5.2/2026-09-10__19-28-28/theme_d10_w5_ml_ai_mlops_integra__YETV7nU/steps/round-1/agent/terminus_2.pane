package main

import (
	"encoding/json"
	"math"
	"reflect"
)

func assert(name string, cond bool) {
	if !cond {
		panic("assert failed: " + name)
	}
}

func TestSmokeFixes(t *testing.T) {
	mapeAllZero, err := regressionMetric("mape", []float64{0, 0}, []float64{0, 0})
	if err != nil {
		t.Fatal(err)
	}
	assert("mape all zero is nil", mapeAllZero == nil)

	mapeSomeZero, err := regressionMetric("mape", []float64{0, 10}, []float64{1, 9})
	if err != nil {
		t.Fatal(err)
	}
	if m, ok := mapeSomeZero.(float64); !ok || math.Abs(m-10) > 1e-9 {
		t.Fatalf("mape some zero expected 10, got %v", mapeSomeZero)
	}

	r2Perfect, err := regressionMetric("r2", []float64{5, 5}, []float64{5, 5})
	if err != nil {
		t.Fatal(err)
	}
	if m, ok := r2Perfect.(float64); !ok || m != 1.0 {
		t.Fatalf("r2 perfect constant expected 1.0, got %v", r2Perfect)
	}

	r2Bad, err := regressionMetric("r2", []float64{5, 5}, []float64{4, 6})
	if err != nil {
		t.Fatal(err)
	}
	assert("r2 undefined constant is nil", r2Bad == nil)
}

func TestCompareMissingMetric(t *testing.T) {
	e1 := &RegistryEntry{Metrics: map[string]interface{}{"accuracy": 0.9}}
	e2 := &RegistryEntry{Metrics: map[string]interface{}{"f1": 0.8}}
	if _, err := compareModels(e1.Name, e1.Version, e2.Version); err == nil {
		t.Skip("compareModels requires registry files; test logic via manual map")
	}
	diff := map[string]interface{}{}
	for k := range e1.Metrics {
		metricsDiff(diff, k, e1.Metrics[k], nil)
	}
	for k := range e2.Metrics {
		if _, ok := diff[k]; !ok {
			metricsDiff(diff, k, nil, e2.Metrics[k])
		}
	}
	if d, ok := diff["accuracy"].(map[string]interface{}); !ok || d["v1"] != 0.9 || d["v2"] != nil || d["delta"] != nil || d["pct_change"] != nil {
		t.Fatalf("missing metric diff wrong: %#v", diff)
	}
	if d, ok := diff["f1"].(map[string]interface{}); !ok || d["v1"] != nil || d["v2"] != 0.8 || d["delta"] != nil || d["pct_change"] != nil {
		t.Fatalf("missing metric diff wrong: %#v", diff)
	}
}

func metricsDiff(metricsDiff map[string]interface{}, k string, val1, val2 interface{}) {
	mv1, okNum1 := toFloat64(val1)
	mv2, okNum2 := toFloat64(val2)
	var v1, v2 interface{}
	if okNum1 {
		v1 = mv1
	} else if val1 != nil {
		v1 = val1
	} else {
		v1 = nil
	}
	if okNum2 {
		v2 = mv2
	} else if val2 != nil {
		v2 = val2
	} else {
		v2 = nil
	}
	if !okNum1 || !okNum2 {
		metricsDiff[k] = map[string]interface{}{"v1": v1, "v2": v2, "delta": nil, "pct_change": nil}
		return
	}
	delta := mv2 - mv1
	var pct interface{}
	if mv1 == 0 {
		pct = nil
	} else {
		pct = delta / math.Abs(mv1) * 100
	}
	metricsDiff[k] = map[string]interface{}{"v1": v1, "v2": v2, "delta": delta, "pct_change": pct}
}

func TestNoCacheOmitsCacheStats(t *testing.T) {
	out := &RunOutput{Pipeline: "p", Status: "success", Stages: map[string]*StageResult{}, Artifacts: map[string]*ArtifactOutput{}, CacheStats: nil}
	b, err := json.Marshal(out)
	if err != nil {
		t.Fatal(err)
	}
	var m map[string]interface{}
	if err := json.Unmarshal(b, &m); err != nil {
		t.Fatal(err)
	}
	if _, ok := m["cache_stats"]; ok {
		t.Fatalf("cache_stats should be omitted, got %s", b)
	}
}
