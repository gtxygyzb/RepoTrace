[?2004l[?2004h>         g := 1.0
[?2004l[?2004h>         for _, c := range counts {
[?2004l[?2004h>             p := float64(c) / float64(len(y))
[?2004l[?2004h>             g -= p * p
[?2004l[?2004h>         }
[?2004l[?2004h>         return g
[?2004l[?2004h>     }
[?2004l[?2004h>     mean := 0.0
[?2004l[?2004h>     for _, v := range y {
[?2004l[?2004h>         mean += v
[?2004l[?2004h>     }
[?2004l[?2004h>     mean /= float64(len(y))
[?2004l[?2004h>     sum := 0.0
[?2004l[?2004h>     for _, v := range y {
[?2004l[?2004h>         d := v - mean
[?2004l[?2004h>         sum += d * d
[?2004l[?2004h>     }
[?2004l [?2004h>     return sum / float64(len(y))
[?2004l[?2004h> }
