   131					} else {
   132						fn++
   133					}
   134				}
   135			}
   136			if tp+fn == 0 {
   137				return 0.0, nil
   138			}
   139			return float64(tp) / float64(tp+fn), nil
   140		case "f1":
   141			p, _ := classificationMetric("precision", y, preds)
   142			r, _ := classificationMetric("recall", y, preds)
   143			pf := p.(float64)
   144			rf := r.(float64)
   145			if pf+rf == 0 {
   146				return 0.0, nil
   147			}
