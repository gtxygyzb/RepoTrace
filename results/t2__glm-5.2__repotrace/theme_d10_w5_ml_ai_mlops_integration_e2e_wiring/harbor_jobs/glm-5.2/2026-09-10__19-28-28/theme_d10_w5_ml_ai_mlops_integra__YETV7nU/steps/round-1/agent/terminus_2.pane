   188		if !ok {
   189			printError("invalid name:version format")
   190			return
   191		}
   192		name2, v2, ok := splitNameVersion(args[1])
   193		if !ok {
   194			printError("invalid name:version format")
   195			return
   196		}
   197		if name1 != name2 {
   198			printError("model names must match")
   199			return
   200		}
   201		result, err := compareModels(name1, v1, v2)
