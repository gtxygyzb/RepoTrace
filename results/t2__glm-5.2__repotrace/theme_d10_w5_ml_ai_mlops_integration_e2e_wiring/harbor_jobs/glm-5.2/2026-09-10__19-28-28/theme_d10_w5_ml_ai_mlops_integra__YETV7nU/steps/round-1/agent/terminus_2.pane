   182	func cmdRegistryCompare(args []string) {
   183		if len(args) < 2 {
   184			printError("usage: mlpipe registry compare <name>:<v1> <name>:<v2>")
   185			return
   186		}
   187		name1, v1, ok := splitNameVersion(args[0])
   188		if !ok {
   189			printError("invalid name:version format")
   190			return
   191		}
   192		name2, v2, ok := splitNameVersion(args[1])
   193		if !ok {
   194			printError("invalid name:version format")
   195			return
   196		}
   197		if name1 != name2 {
   198			printError("model names must match")
   199			return
   200		}
   201		result, err := compareModels(name1, v1, v2)
   202		if err != nil {
   203			printError(err.Error())
   204			return
   205		}
   206		printJSON(result)
   207	}
