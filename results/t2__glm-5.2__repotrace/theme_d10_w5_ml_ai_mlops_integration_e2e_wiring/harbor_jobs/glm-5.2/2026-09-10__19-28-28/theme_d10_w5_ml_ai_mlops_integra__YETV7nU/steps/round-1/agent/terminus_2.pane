    62	func NewExecutor(config *Config, overrides map[string]string) *Executor {
    63		return &Executor{
    64			config:  config,
    65			globals: config.globalParams(overrides),
    66			status:  map[string]string{},
    67			results: map[string]*StageResult{},
    68			outputs: map[string]map[string]string{},
    69			values:  map[string]map[string]*ArtifactValue{},
    70			meta:    map[string]*ArtifactMeta{},
    71		}
    72	}
