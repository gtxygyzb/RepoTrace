    88		valid, errs := e.config.Validate()
    89		if !valid {
    90			return nil, fmt.Errorf("%s", strings.Join(errs, "; "))
    91		}
    92		order, err := e.config.topologicalOrder()
    93		if err != nil {
    94			return nil, err
    95		}
    96	
    97		runArtifacts := map[string]*ArtifactOutput{}
    98	
    99		for _, name := range order {
   100			stage, _ := e.config.stageByName(name)
   101			e.outputs[name] = map[string]string{}
   102			e.values[name] = map[string]*ArtifactValue{}
   103			e.results[name] = &StageResult{Status: "pending", Outputs: map[string]string{}}
   104	
   105			skip := false
   106			for _, dep := range stage.DependsOn {
   107				if e.status[dep] != "success" {
   108					skip = true
   109					break
   110				}
   111			}
   112			if skip {
   113				e.status[name] = "skipped"
   114				e.results[name].Status = "skipped"
   115				continue
   116			}
   117	
   118			inputValues, inputIDs, err := e.resolveInputs(stage)
   119			if err != nil {
   120				e.status[name] = "failed"
   121				e.results[name].Status = "failed"
   122				e.results[name].Error = err.Error()
   123				continue
   124			}
   125	
   126			params := e.config.stageParams(name, e.globals)
   127			inputKeys := e.inputCacheKeys(stage)
   128			cacheKey, keyErr := computeCacheKey(stage, params, inputKeys, -1)
   129			if keyErr != nil {
   130				e.status[name] = "failed"
   131				e.results[name].Status = "failed"
   132				e.results[name].Error = keyErr.Error()
   133				continue
   134			}
   135			e.cacheKeys[name] = cacheKey
   136	
   137			var out map[string]*ArtifactValue
   138			start := time.Now()
   139			if !e.noCache && cacheEntryExists(cacheKey) {
   140				loaded, err := loadCacheEntry(cacheKey)
   141				duration := time.Since(start).Milliseconds()
   142				e.results[name].DurationMs = duration
   143				if err == nil {
   144					out = loaded
   145					e.results[name].CacheHit = true
   146					e.cacheStats.Hits++
   147				} else {
   148					if !e.noCache {
   149						e.cacheStats.Misses++
   150					}
   151					out, err = executeStage(stage, params, inputValues)
   152					duration = time.Since(start).Milliseconds()
   153					e.results[name].DurationMs = duration
   154					if err != nil {
   155						e.status[name] = "failed"
   156						e.results[name].Status = "failed"
   157						e.results[name].Error = err.Error()
   158						continue
   159					}
   160				}
   161			} else {
   162				var err error
   163				out, err = executeStage(stage, params, inputValues)
   164				duration := time.Since(start).Milliseconds()
   165				e.results[name].DurationMs = duration
   166				if err != nil {
   167					e.status[name] = "failed"
   168					e.results[name].Status = "failed"
   169					e.results[name].Error = err.Error()
   170					continue
   171				}
   172				if !e.noCache {
   173					_ = saveCacheEntry(cacheKey, name, stage.Type, out)
   174				}
   175				if !e.noCache {
   176					e.cacheStats.Misses++
   177				}
   178			}
   179	
   180			e.status[name] = "success"
   181			e.results[name].Status = "success"
   182			ts := time.Now().UnixNano()
   183	
   184			for port, val := range out {
   185				id := artifactID(e.config.Pipeline.Name, name, port, ts)
   186				e.values[name][port] = val
   187				e.outputs[name][port] = id
   188				typ := val.Type()
   189				summary := val.Summary()
