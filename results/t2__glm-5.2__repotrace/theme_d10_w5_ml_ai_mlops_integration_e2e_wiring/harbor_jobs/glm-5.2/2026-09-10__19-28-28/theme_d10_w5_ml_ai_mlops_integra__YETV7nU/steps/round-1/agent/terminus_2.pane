    11	type Config struct {
    12		Pipeline PipelineConfig `json:"pipeline"`
    13		Stages   []StageConfig  `json:"stages"`
    14	}
    15	
    16	type PipelineConfig struct {
    17		Name      string                 `json:"name"`
    18		Params    map[string]interface{} `json:"params"`
    19		OnFailure string                 `json:"on_failure,omitempty"`
    20	}
    21	
    22	type StageConfig struct {
    23		Name      string                 `json:"name"`
    24		Type      string                 `json:"type"`
    25		DependsOn []string               `json:"depends_on"`
    26		Inputs    map[string]interface{} `json:"inputs"`
    27		Params    map[string]interface{} `json:"params"`
    28	}
    29	
    30	var paramRE = regexp.MustCompile(`\$\{([^}]+)\}`)
    31	
    32	func loadConfig(path string) (*Config, error) {
    33		data, err := os.ReadFile(path)
    34		if err != nil {
    35			if os.IsNotExist(err) {
    36				return nil, fmt.Errorf("file not found: %s", path)
    37			}
    38			return nil, err
    39		}
    40		var c Config
    41		if err := json.Unmarshal(data, &c); err != nil {
    42			return nil, fmt.Errorf("invalid config: %s", err.Error())
    43		}
    44		return &c, nil
    45	}
    46	
    47	func (c *Config) globalParams(overrides map[string]string) map[string]interface{} {
    48		params := map[string]interface{}{}
    49		for k, v := range c.Pipeline.Params {
    50			params[k] = v
    51		}
    52		for k, v := range overrides {
    53			params[k] = v
    54		}
    55		return params
    56	}
    57	
    58	func mergeParams(params map[string]interface{}, overrides map[string]string) map[string]interface{} {
    59		res := map[string]interface{}{}
    60		for k, v := range params {
    61			res[k] = v
    62		}
    63		for k, v := range overrides {
    64			res[k] = v
    65		}
    66		return res
    67	}
    68	
    69	func substituteValue(v interface{}, globals map[string]interface{}) interface{} {
    70		switch x := v.(type) {
    71		case string:
    72			return paramRE.ReplaceAllStringFunc(x, func(m string) string {
    73				key := m[2 : len(m)-1]
    74				if val, ok := globals[key]; ok {
    75					return fmt.Sprintf("%v", val)
    76				}
    77				return m
    78			})
    79		case map[string]interface{}:
    80			res := map[string]interface{}{}
    81			for k, val := range x {
    82				res[k] = substituteValue(val, globals)
    83			}
    84			return res
    85		case []interface{}:
    86			res := make([]interface{}, len(x))
    87			for i, val := range x {
    88				res[i] = substituteValue(val, globals)
    89			}
    90			return res
    91		default:
    92			return v
    93		}
    94	}
    95	
    96	func (c *Config) stageParams(name string, globals map[string]interface{}) map[string]interface{} {
    97		for _, s := range c.Stages {
    98			if s.Name == name {
    99				if s.Params == nil {
   100					return map[string]interface{}{}
   101				}
   102				res := substituteValue(s.Params, globals)
   103				if m, ok := res.(map[string]interface{}); ok {
   104					return m
   105				}
   106				return map[string]interface{}{}
   107			}
   108		}
   109		return map[string]interface{}{}
   110	}
   111	
   112	func (c *Config) stageByName(name string) (*StageConfig, bool) {
   113		for i := range c.Stages {
   114			if c.Stages[i].Name == name {
   115				return &c.Stages[i], true
   116			}
   117		}
   118		return nil, false
   119	}
   120	
   121	func inputRefs(v interface{}) ([]string, bool) {
   122		switch x := v.(type) {
   123		case string:
   124			return []string{x}, true
   125		case []interface{}:
   126			res := make([]string, 0, len(x))
   127			for _, item := range x {
   128				s, ok := item.(string)
   129				if !ok {
   130					return nil, false
   131				}
   132				res = append(res, s)
   133			}
   134			return res, true
   135		}
   136		return nil, false
   137	}
   138	
   139	func validOutputPorts(t string) []string {
   140		switch t {
   141		case "data-source":
   142			return []string{"data"}
   143		case "transform":
   144			return []string{"data"}
   145		case "split":
   146			return []string{"train", "test"}
   147		case "train":
   148			return []string{"model", "predictions"}
   149		case "evaluate":
   150			return []string{"report"}
   151		case "register":
   152			return []string{"entry"}
   153		case "ensemble":
   154			return []string{"predictions", "model"}
   155		}
   156		return nil
   157	}
   158	
   159	func validStageType(t string) bool {
   160		switch t {
   161		case "data-source", "transform", "split", "train", "evaluate", "register", "ensemble":
   162			return true
   163		}
   164		return false
   165	}
   166	
   167	func (c *Config) Validate() (bool, []string) {
   168		errors := []string{}
   169		names := map[string]bool{}
   170		for i, s := range c.Stages {
   171			if s.Name == "" {
   172				errors = append(errors, fmt.Sprintf("stage at index %d has empty name", i))
   173				continue
   174			}
   175			if names[s.Name] {
   176				errors = append(errors, fmt.Sprintf("duplicate stage name: %s", s.Name))
   177			}
   178			names[s.Name] = true
   179		}
   180		for _, s := range c.Stages {
   181			if !validStageType(s.Type) {
   182				errors = append(errors, fmt.Sprintf("stage %q has unknown type %q", s.Name, s.Type))
   183			}
   184			for _, dep := range s.DependsOn {
   185				if !names[dep] {
   186					errors = append(errors, fmt.Sprintf("stage %q references unknown dependency %q", s.Name, dep))
   187				}
   188			}
   189			for local, ref := range s.Inputs {
   190				refs, ok := inputRefs(ref)
   191				if !ok {
   192					errors = append(errors, fmt.Sprintf("stage %q input %q has invalid reference %v", s.Name, local, ref))
   193					continue
   194				}
   195				for idx, r := range refs {
   196					if r == "" {
   197						errors = append(errors, fmt.Sprintf("stage %q input %q[%d] has invalid empty reference", s.Name, local, idx))
   198						continue
   199					}
   200					parts := strings.SplitN(r, ".", 2)
   201					if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
   202						errors = append(errors, fmt.Sprintf("stage %q input %q has invalid reference %q", s.Name, local, r))
   203						continue
   204					}
   205					refStage, ok := c.stageByName(parts[0])
   206					if !ok {
   207						errors = append(errors, fmt.Sprintf("stage %q input %q references unknown stage %q", s.Name, local, parts[0]))
   208						continue
   209					}
   210					ports := validOutputPorts(refStage.Type)
   211					valid := false
   212					for _, p := range ports {
   213						if p == parts[1] {
   214							valid = true
   215							break
   216						}
   217					}
   218					if !valid {
   219						errors = append(errors, fmt.Sprintf("stage %q input %q references unknown output port %q on stage %q", s.Name, local, parts[1], parts[0]))
   220					}
   221				}
   222				if s.Type == "ensemble" && local == "models" {
   223					if _, ok := ref.([]interface{}); !ok {
   224						errors = append(errors, fmt.Sprintf("ensemble stage %q input %q must be an array", s.Name, local))
   225					}
   226				}
   227			}
   228			if s.Type == "ensemble" {
   229				models, ok := s.Inputs["models"]
   230				if !ok {
   231					errors = append(errors, fmt.Sprintf("ensemble stage %q requires inputs.models", s.Name))
   232				} else if refs, ok := inputRefs(models); !ok || len(refs) < 2 {
   233					errors = append(errors, fmt.Sprintf("ensemble stage %q requires at least 2 model inputs", s.Name))
   234				}
   235				if _, ok := s.Inputs["data"]; !ok {
   236					errors = append(errors, fmt.Sprintf("ensemble stage %q requires inputs.data", s.Name))
   237				}
   238				strategy, _ := getString(s.Params, "strategy")
   239				if strategy != "vote" && strategy != "average" {
   240					errors = append(errors, fmt.Sprintf("ensemble stage %q has invalid strategy %q (must be vote or average)", s.Name, strategy))
   241				}
   242				if _, ok := getString(s.Params, "target"); !ok {
   243					errors = append(errors, fmt.Sprintf("ensemble stage %q requires target param", s.Name))
   244				}
   245			}
   246		}
   247		if stages, cycle := c.detectCycle(); cycle {
   248			errors = append(errors, fmt.Sprintf("cycle detected involving stages: %s", strings.Join(stages, ", ")))
   249		}
   250		return len(errors) == 0, errors
   251	}
