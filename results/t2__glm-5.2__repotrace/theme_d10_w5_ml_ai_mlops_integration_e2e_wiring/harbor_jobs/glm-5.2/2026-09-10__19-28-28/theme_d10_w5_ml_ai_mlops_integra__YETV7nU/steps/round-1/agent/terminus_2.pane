[?2004lpackage main

import (
	"fmt"
	"math"
	"sort"
)

type Report struct {
	Metrics map[string]interface{} `json:"metrics"`
	Pass    bool                   `json:"pass"`
}

func executeEvaluate(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
	modelVal := inputs["model"]
	if modelVal == nil || modelVal.Model == nil {
		return nil, fmt.Errorf("evaluate stage %q requires model input", stage.Name)
	}
	ds := inputDataset(inputs)
	if ds == nil {
		return nil, fmt.Errorf("evaluate stage %q requires data input", stage.Name)
	}
	model := modelVal.Model

	metrics, ok := getStringSlice(params, "metrics")
	if !ok {
		return nil, fmt.Errorf("evaluate stage %q requires metrics", stage.Name)
	}
	threshold, _ := getMap(params, "threshold")

	y, err := ds.NumericColumn(model.Target)
	if err != nil {
		return nil, err
	}
	X, err := ds.featureMatrix(model.Features)
	if err != nil {
		return nil, err
	}
	preds := model.PredictBatch(X)
	classification := isBinary01(y)

	report := &Report{Metrics: map[string]interface{}{}, Pass: true}

	for _, metric := range metrics {
		var val interface{}
		var err error
		switch metric {
		case "accuracy", "precision", "recall", "f1", "auc", "logloss", "confusion_matrix":
			if !classification {
				err = fmt.Errorf("metric %q requires binary 0/1 target", metric)
			} else {
				val, err = classificationMetric(metric, y, preds)
			}
		case "mse", "rmse", "mae", "r2", "mape":
			if classification {
				err = fmt.Errorf("metric %q requires regression target", metric)
			} else {
				val, err = regressionMetric(metric, y, preds)
			}
		default:
			err = fmt.Errorf("unknown metric %q", metric)
		}
		if err != nil {
			return nil, err
		}
		report.Metrics[metric] = val
	}

	if threshold != nil {
		for metricName, thresholdVal := range threshold {
			metricValue, ok := report.Metrics[metricName]
			if !ok {
				continue
			}
			fv, ok := toFloat64(metricValue)
			if !ok {
				continue
			}
			tv, ok := toFloat64(thresholdVal)
			if !ok {
				continue
			}
			if fv < tv {
				report.Pass = false
			}
		}
	}

	return map[string]*ArtifactValue{"report": {Report: report}}, nil
}

func classificationMetric(name string, y []float64, preds []float64) (interface{}, error) {
	labels := make([]int, len(preds))
	for i, p := range preds {
		if p >= 0.5 {
			labels[i] = 1
		} else {
			labels[i] = 0
		}
	}
	switch name {
	case "accuracy":
		correct := 0
		for i := range y {
			if labels[i] == int(y[i]) {
				correct++
			}
		}
		return float64(correct) / float64(len(y)), nil
	case "precision":
		tp, fp := 0, 0
		for i := range y {
			if labels[i] == 1 {
				if y[i] == 1 {
					tp++
				} else {
					fp++
				}
			}
		}
		if tp+fp == 0 {
			return 0.0, nil
		}
		return float64(tp) / float64(tp+fp), nil
	case "recall":
		tp, fn := 0, 0
		for i := range y {
			if y[i] == 1 {
				if labels[i] == 1 {
					tp++
				} else {
					fn++
				}
			}
		}
		if tp+fn == 0 {
			return 0.0, nil
		}
		return float64(tp) / float64(tp+fn), nil
	case "f1":
		p, _ := classificationMetric("precision", y, preds)
		r, _ := classificationMetric("recall", y, preds)
		pf := p.(float64)
		rf := r.(float64)
		if pf+rf == 0 {
			return 0.0, nil
		}
		return 2 * pf * rf / (pf + rf), nil
	case "auc":
		return aucROC(y, preds), nil
	case "logloss":
		sum := 0.0
		for i := range y {
			p := clamp(preds[i], 1e-15, 1-1e-15)
			sum += y[i]*math.Log(p) + (1-y[i])*math.Log(1-p)
		}
		return -sum / float64(len(y)), nil
	case "confusion_matrix":
		tp, fp, tn, fn := 0, 0, 0, 0
		for i := range y {
			if labels[i] == 1 && y[i] == 1 {
				tp++
			} else if labels[i] == 1 && y[i] == 0 {
				fp++
			} else if labels[i] == 0 && y[i] == 0 {
				tn++
			} else {
				fn++
			}
		}
		return map[string]int{"tp": tp, "fp": fp, "tn": tn, "fn": fn}, nil
	}
	return nil, fmt.Errorf("unknown classification metric %q", name)
}

func regressionMetric(name string, y []float64, preds []float64) (interface{}, error) {
	n := float64(len(y))
	switch name {
	case "mse":
		sum := 0.0
		for i := range y {
			d := y[i] - preds[i]
			sum += d * d
		}
		return sum / n, nil
	case "rmse":
		mse, _ := regressionMetric("mse", y, preds)
		return math.Sqrt(mse.(float64)), nil
	case "mae":
		sum := 0.0
		for i := range y {
			sum += math.Abs(y[i] - preds[i])
		}
		return sum / n, nil
	case "r2":
		mean := 0.0
		for _, v := range y {
			mean += v
		}
		mean /= n
		ssRes := 0.0
		ssTot := 0.0
		for i := range y {
			ssRes += (y[i] - preds[i]) * (y[i] - preds[i])
			ssTot += (y[i] - mean) * (y[i] - mean)
		}
		if ssTot == 0 {
			if ssRes == 0 {
				return 1.0, nil
			}
			return nil, nil
		}
		return 1 - ssRes/ssTot, nil
	case "mape":
		sum := 0.0
		count := 0.0
		for i := range y {
			if y[i] == 0 {
				continue
			}
			sum += math.Abs((y[i] - preds[i]) / y[i])
			count++
		}
		if count == 0 {
			return nil, nil
		}
		return sum / count * 100, nil
	}
	return nil, fmt.Errorf("unknown regression metric %q", name)
}

func aucROC(y []float64, scores []float64) float64 {
	type point struct {
		score float64
		y     float64
	}
	pts := make([]point, len(y))
	pos := 0
	neg := 0
	for i := range y {
[?2004hroot@n30009:/app# sed -n '1,260p' register.go
[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"math"
	"os"
	"path/filepath"
	"sort"
	"time"
)

type RegistryEntry struct {
	Name           string                 `json:"name"`
	Version        int                    `json:"version"`
	Stage          string                 `json:"stage"`
	Tags           []string               `json:"tags"`
	Metrics        map[string]interface{} `json:"metrics"`
	Hyperparams    map[string]interface{} `json:"hyperparams"`
	ArtifactRefs   map[string]string      `json:"artifact_refs"`
	PromotionRules map[string]interface{} `json:"promotion_rules"`
	RegisteredAt   string                 `json:"registered_at"`
}

func executeRegister(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
	modelVal := inputs["model"]
	if modelVal == nil || modelVal.Model == nil {
		return nil, fmt.Errorf("register stage %q requires model input", stage.Name)
	}
	reportVal := inputs["report"]
	if reportVal == nil || reportVal.Report == nil {
		return nil, fmt.Errorf("register stage %q requires report input", stage.Name)
	}

	name, ok := getString(params, "model_name")
	if !ok {
		return nil, fmt.Errorf("register stage %q requires model_name", stage.Name)
	}
	tags, _ := getStringSlice(params, "tags")
	if tags == nil {
		tags = []string{}
	}
	stageName, _ := getString(params, "stage")
	if stageName == "" {
		stageName = "staging"
	}
	if stageName != "staging" && stageName != "production" {
		return nil, fmt.Errorf("register stage %q invalid stage %q", stage.Name, stageName)
	}
	rules, _ := getMap(params, "promotion_rules")

	registry, err := loadRegistry()
	if err != nil {
		return nil, err
	}
	version := 1
	for _, e := range registry {
		if e.Name == name && e.Version >= version {
			version = e.Version + 1
		}
	}

	entry := &RegistryEntry{
		Name:           name,
		Version:        version,
		Stage:          stageName,
		Tags:           tags,
		Metrics:        reportVal.Report.Metrics,
		Hyperparams:    modelVal.Model.Hyperparams,
		ArtifactRefs:   map[string]string{},
		PromotionRules: rules,
		RegisteredAt:   time.Now().UTC().Format(time.RFC3339),
	}
	registry = append(registry, entry)
	if err := saveRegistry(registry); err != nil {
		return nil, err
	}

	return map[string]*ArtifactValue{"entry": {Entry: entry}}, nil
}

func registryPath() string {
	return filepath.Join(".mlpipe", "registry.json")
}

func loadRegistry() ([]*RegistryEntry, error) {
	data, err := os.ReadFile(registryPath())
	if err != nil {
		if os.IsNotExist(err) {
			return []*RegistryEntry{}, nil
		}
		return nil, err
	}
	var entries []*RegistryEntry
	if err := json.Unmarshal(data, &entries); err != nil {
		return nil, err
	}
	return entries, nil
}

func saveRegistry(entries []*RegistryEntry) error {
	if err := os.MkdirAll(".mlpipe", 0755); err != nil {
		return err
	}
	data, err := json.MarshalIndent(entries, "", "  ")
	if err != nil {
		return err
	}
	return os.WriteFile(registryPath(), data, 0644)
}

func listRegistry(name, stage, tag string) ([]*RegistryEntry, error) {
	entries, err := loadRegistry()
	if err != nil {
		return nil, err
	}
	filtered := []*RegistryEntry{}
	for _, e := range entries {
		if name != "" && e.Name != name {
			continue
		}
		if stage != "" && e.Stage != stage {
			continue
		}
		if tag != "" {
			found := false
			for _, t := range e.Tags {
				if t == tag {
					found = true
					break
				}
			}
			if !found {
				continue
			}
		}
		filtered = append(filtered, e)
	}
	sort.Slice(filtered, func(i, j int) bool {
		if filtered[i].Name != filtered[j].Name {
			return filtered[i].Name < filtered[j].Name
		}
		return filtered[i].Version > filtered[j].Version
	})
	return filtered, nil
}

func registryInfo(name string, version int) (*RegistryEntry, error) {
	entries, err := loadRegistry()
	if err != nil {
		return nil, err
	}
	for _, e := range entries {
		if e.Name == name && e.Version == version {
			return e, nil
		}
	}
	return nil, fmt.Errorf("model not found: %s:%d", name, version)
}

func promoteModel(name string, version int, targetStage string) (*RegistryEntry, string, string, error) {
	valid := map[string]bool{"staging": true, "production": true, "archived": true}
	if !valid[targetStage] {
		return nil, "", "", fmt.Errorf("invalid promotion: invalid target stage %q", targetStage)
	}
	entries, err := loadRegistry()
	if err != nil {
		return nil, "", "", err
	}
	var entry *RegistryEntry
	for _, e := range entries {
		if e.Name == name && e.Version == version {
			entry = e
			break
		}
	}
	if entry == nil {
		return nil, "", "", fmt.Errorf("model not found: %s:%d", name, version)
	}

	prevStage := entry.Stage
	if !validPromotionTransition(prevStage, targetStage) {
		return nil, "", "", fmt.Errorf("invalid promotion: cannot promote from %s to %s", prevStage, targetStage)
	}

	if targetStage == "production" {
		if entry.PromotionRules != nil {
			if rules, ok := entry.PromotionRules[targetStage].(map[string]interface{}); ok {
				for metricName, thresholdVal := range rules {
					metricValue, ok := entry.Metrics[metricName]
					if !ok {
						continue
					}
					mv, ok := toFloat64(metricValue)
					if !ok {
						continue
					}
					tv, ok := toFloat64(thresholdVal)
					if !ok {
						continue
					}
					if mv < tv {
						return nil, prevStage, targetStage, fmt.Errorf("metric %s (%v) below threshold (%v)", metricName, mv, tv)
					}
				}
			}
		}
		for _, e := range entries {
			if e.Name == name && e.Stage == "production" && e.Version != version {
				e.Stage = "archived"
			}
		}
	}

	entry.Stage = targetStage
	if err := saveRegistry(entries); err != nil {
		return nil, "", "", err
	}
	return entry, prevStage, targetStage, nil
}

func validPromotionTransition(from, to string) bool {
	if from == "staging" && to == "production" {
		return true
	}
	if from == "production" && to == "archived" {
		return true
	}
	return false
}

