    30		StagesUnchanged []string             `json:"stages_unchanged"`
    31	}
    32	
    33	func cmdDiff(args []string) {
    34		if len(args) != 2 {
    35			exitError("usage: mlpipe diff <config1.json> <config2.json>")
    36			return
    37		}
    38		config1, err := loadConfig(args[0])
    39		if err != nil {
    40			exitError(err.Error())
    41			return
    42		}
    43		config2, err := loadConfig(args[1])
    44		if err != nil {
    45			exitError(err.Error())
    46			return
    47		}
    48		printJSON(diffConfigs(config1, config2))
    49	}
    50	
    51	func diffConfigs(c1, c2 *Config) ConfigDiff {
