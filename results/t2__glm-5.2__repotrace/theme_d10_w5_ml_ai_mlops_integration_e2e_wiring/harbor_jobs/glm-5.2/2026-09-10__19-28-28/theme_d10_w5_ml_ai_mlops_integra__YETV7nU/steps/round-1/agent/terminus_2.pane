    39	func (e *Executor) RunCV() (*CVRunOutput, error) {
    40		if e.cvFolds < 2 {
    41			return nil, fmt.Errorf("cv folds must be >= 2")
    42		}
    43	
    44		valid, errs := e.config.Validate()
    45		if !valid {
    46			return nil, fmt.Errorf("%s", strings.Join(errs, "; "))
    47		}
    48		if err := e.config.validateCV(); err != nil {
    49			return nil, err
    50		}
    51	
    52		order, err := e.config.topologicalOrder()
    53		if err != nil {
    54			return nil, err
    55		}
    56	
    57		splitName, _ := e.config.splitStageName()
    58		postSplit := e.config.postSplitStages(splitName)
    59		preSplitOrder := []string{}
    60		postSplitOrder := []string{}
    61		for _, name := range order {
    62			if postSplit[name] {
    63				postSplitOrder = append(postSplitOrder, name)
    64			} else {
    65				preSplitOrder = append(preSplitOrder, name)
    66			}
    67		}
    68	
    69		allArtifacts := map[string]*ArtifactOutput{}
    70	
    71		for _, name := range preSplitOrder {
    72			e.executeStageCached(name, -1, 0, allArtifacts)
    73		}
    74	
    75		foldResults := make([]CVFoldResult, e.cvFolds)
    76		foldMetrics := make([]map[string]float64, e.cvFolds)
    77	
    78		for i := 0; i < e.cvFolds; i++ {
    79			foldExec := &Executor{
    80				config:     e.config,
    81				globals:    e.globals,
    82				status:     map[string]string{},
    83				results:    map[string]*StageResult{},
    84				outputs:    map[string]map[string]string{},
    85				values:     map[string]map[string]*ArtifactValue{},
    86				meta:       e.meta,
    87				cacheKeys:  map[string]string{},
    88				noCache:    e.noCache,
    89				cvFolds:    e.cvFolds,
    90				cacheStats: e.cacheStats,
    91			}
    92			for name, st := range e.status {
    93				foldExec.status[name] = st
    94			}
    95			for name, outs := range e.outputs {
    96				foldExec.outputs[name] = copyStringMap(outs)
    97			}
    98			for name, vals := range e.values {
    99				foldExec.values[name] = copyValueMap(vals)
   100			}
   101			for name, key := range e.cacheKeys {
   102				foldExec.cacheKeys[name] = key
   103			}
   104	
   105			foldArtifacts := map[string]*ArtifactOutput{}
   106			for _, name := range postSplitOrder {
   107				foldExec.executeStageCached(name, i, e.cvFolds, foldArtifacts)
   108			}
   109	
   110			foldStatus := "success"
   111			for _, r := range foldExec.results {
   112				if r.Status != "success" {
   113					foldStatus = "failed"
   114					break
   115				}
   116			}
   117	
   118			for id, art := range foldArtifacts {
   119				allArtifacts[id] = art
   120			}
[?2004hroot@n30009:/app# nl -ba cv.go | sed -n '120,240p'
[?2004l   120			}
   121	
   122			foldResults[i] = CVFoldResult{
   123				Fold:   i,
   124				Status: foldStatus,
   125				Stages: foldExec.results,
   126			}
   127	
   128			foldMetric := map[string]float64{}
   129			metricSums := map[string]float64{}
   130			metricCounts := map[string]int{}
   131			for _, name := range postSplitOrder {
   132				stage, _ := e.config.stageByName(name)
   133				if stage.Type != "evaluate" {
   134					continue
   135				}
   136				r, ok := foldExec.results[name]
   137				if !ok || r.Status != "success" {
   138					continue
   139				}
   140				val, ok := foldExec.values[name]["report"]
   141				if !ok || val == nil || val.Report == nil {
   142					continue
   143				}
   144				for metricName, metricValue := range val.Report.Metrics {
   145					fv, ok := toFloat64(metricValue)
   146					if !ok {
   147						continue
   148					}
   149					metricSums[metricName] += fv
   150					metricCounts[metricName]++
   151				}
   152			}
   153			for name, sum := range metricSums {
   154				if metricCounts[name] > 0 {
   155					foldMetric[name] = sum / float64(metricCounts[name])
   156				}
   157			}
   158			foldMetrics[i] = foldMetric
   159		}
   160	
   161		cvMetrics := map[string]CVMetricAgg{}
   162		metricNames := map[string]bool{}
   163		for _, fm := range foldMetrics {
   164			for name := range fm {
   165				metricNames[name] = true
   166			}
   167		}
   168		for name := range metricNames {
   169			perFold := make([]float64, e.cvFolds)
   170			sum := 0.0
   171			count := 0
   172			for i, fm := range foldMetrics {
   173				if v, ok := fm[name]; ok {
   174					perFold[i] = v
   175					sum += v
   176					count++
   177				} else {
   178					perFold[i] = 0.0
   179				}
   180			}
   181			mean := 0.0
   182			if count > 0 {
   183				mean = sum / float64(count)
   184			}
   185			variance := 0.0
   186			for _, v := range perFold {
   187				d := v - mean
   188				variance += d * d
   189			}
   190			variance /= float64(e.cvFolds)
   191			cvMetrics[name] = CVMetricAgg{
   192				Mean:    mean,
   193				Std:     math.Sqrt(variance),
   194				PerFold: perFold,
   195			}
   196		}
   197	
   198		status := "success"
   199		for _, r := range e.results {
   200			if r.Status != "success" {
   201				status = "failed"
   202				break
   203			}
   204		}
   205		for _, fr := range foldResults {
   206			if fr.Status != "success" {
   207				status = "failed"
   208				break
   209			}
   210		}
   211	
   212		run := &CVRunOutput{
   213			Pipeline:    e.config.Pipeline.Name,
   214			Status:      status,
   215			CVFolds:     e.cvFolds,
   216			Stages:      e.results,
   217			FoldResults: foldResults,
   218			CVResults:   CVResults{Metrics: cvMetrics},
   219			Artifacts:   allArtifacts,
   220			CacheStats:  e.cacheStats,
   221		}
   222	
   223		if err := saveArtifacts(e.meta); err != nil {
   224			return nil, err
   225		}
   226		if err := saveRunAny(e.config.Pipeline.Name, run); err != nil {
   227			return nil, err
   228		}
   229		return run, nil
   230	}
