   460	func splitNameVersion(s string) (string, int, bool) {
   461		parts := strings.SplitN(s, ":", 2)
   462		if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
   463			return "", 0, false
   464		}
   465		var version int
   466		if _, err := fmt.Sscanf(parts[1], "%d", &version); err != nil {
   467			return "", 0, false
   468		}
   469		return parts[0], version, true
   470	}
