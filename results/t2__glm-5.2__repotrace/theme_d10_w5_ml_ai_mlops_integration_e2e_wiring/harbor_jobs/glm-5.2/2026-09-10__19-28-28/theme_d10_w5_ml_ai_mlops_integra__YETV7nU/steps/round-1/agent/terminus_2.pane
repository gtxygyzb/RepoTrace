   154	func cmdRegistryPromote(args []string) {
   155		if len(args) < 2 {
   156			printError("usage: mlpipe registry promote <name>:<version> <target_stage>")
   157			return
   158		}
   159		name, version, ok := splitNameVersion(args[0])
   160		if !ok {
   161			printError("invalid name:version format")
   162			return
   163		}
   164		target := args[1]
   165		entry, prev, new, err := promoteModel(name, version, target)
   166		if err != nil {
   167			if strings.HasPrefix(err.Error(), "metric ") {
   168				printJSON(map[string]interface{}{"success": false, "message": err.Error()})
   169				return
   170			}
   171			printError(err.Error())
   172			return
   173		}
   174		printJSON(map[string]interface{}{
   175			"success":        true,
   176			"message":        fmt.Sprintf("promoted to %s", new),
   177			"previous_stage": prev,
   178			"new_stage":      entry.Stage,
   179		})
   180	}
