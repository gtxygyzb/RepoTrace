   235	func parseParams(args []string) (map[string]string, error) {
   236		overrides := map[string]string{}
   237		for i := 0; i < len(args); i++ {
   238			if args[i] == "--param" {
   239				if i+1 >= len(args) {
   240					return nil, fmt.Errorf("--param requires key=value")
   241				}
   242				kv := args[i+1]
   243				i++
   244				k, v, ok := strings.Cut(kv, "=")
   245				if !ok {
   246					return nil, fmt.Errorf("--param requires key=value")
   247				}
   248				overrides[k] = v
   249			} else if strings.HasPrefix(args[i], "--param=") {
   250				kv := strings.TrimPrefix(args[i], "--param=")
   251				k, v, ok := strings.Cut(kv, "=")
   252				if !ok {
   253					return nil, fmt.Errorf("--param requires key=value")
   254				}
   255				overrides[k] = v
   256			} else {
   257				return nil, fmt.Errorf("unknown flag: %s", args[i])
   258			}
   259		}
   260		return overrides, nil
