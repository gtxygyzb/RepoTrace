    13	type ArtifactValue struct {
    14		Dataset *Dataset
    15		Model   *Model
    16		Report  *Report
    17		Entry   *RegistryEntry
    18	}
    19	
    20	type ArtifactMeta struct {
    21		ID        string                 `json:"id"`
    22		Stage     string                 `json:"stage"`
    23		Port      string                 `json:"port"`
    24		Type      string                 `json:"type"`
    25		Summary   map[string]interface{} `json:"summary"`
    26		Inputs    []string               `json:"inputs"`
    27		Outputs   []string               `json:"outputs"`
    28		Timestamp int64                  `json:"timestamp"`
    29	}
    30	
    31	type ArtifactOutput struct {
    32		Stage   string                 `json:"stage"`
    33		Port    string                 `json:"port"`
    34		Type    string                 `json:"type"`
    35		Summary map[string]interface{} `json:"summary"`
    36	}
    37	
    38	type StageResult struct {
    39		Status     string            `json:"status"`
    40		DurationMs int64             `json:"duration_ms"`
    41		Outputs    map[string]string `json:"outputs"`
    42		Error      string            `json:"error,omitempty"`
    43	}
    44	
    45	type RunOutput struct {
    46		Pipeline  string                     `json:"pipeline"`
    47		Status    string                     `json:"status"`
    48		Stages    map[string]*StageResult    `json:"stages"`
    49		Artifacts map[string]*ArtifactOutput `json:"artifacts"`
    50	}
    51	
    52	type Executor struct {
    53		config  *Config
    54		globals map[string]interface{}
    55		status  map[string]string
    56		results map[string]*StageResult
    57		outputs map[string]map[string]string
    58		values  map[string]map[string]*ArtifactValue
    59		meta    map[string]*ArtifactMeta
    60	}
    61	
    62	func NewExecutor(config *Config, overrides map[string]string) *Executor {
    63		return &Executor{
    64			config:  config,
    65			globals: config.globalParams(overrides),
    66			status:  map[string]string{},
    67			results: map[string]*StageResult{},
    68			outputs: map[string]map[string]string{},
    69			values:  map[string]map[string]*ArtifactValue{},
    70			meta:    map[string]*ArtifactMeta{},
    71		}
    72	}
    73	
    74	func (e *Executor) Run() (*RunOutput, error) {
    75		valid, errs := e.config.Validate()
    76		if !valid {
    77			return nil, fmt.Errorf("%s", strings.Join(errs, "; "))
    78		}
    79		order, err := e.config.topologicalOrder()
    80		if err != nil {
    81			return nil, err
    82		}
    83	
    84		runArtifacts := map[string]*ArtifactOutput{}
    85	
    86		for _, name := range order {
    87			stage, _ := e.config.stageByName(name)
    88			e.outputs[name] = map[string]string{}
    89			e.values[name] = map[string]*ArtifactValue{}
    90			e.results[name] = &StageResult{Status: "pending", Outputs: map[string]string{}}
    91	
    92			skip := false
    93			for _, dep := range stage.DependsOn {
    94				if e.status[dep] != "success" {
    95					skip = true
    96					break
    97				}
    98			}
    99			if skip {
   100				e.status[name] = "skipped"
   101				e.results[name].Status = "skipped"
   102				continue
   103			}
   104	
   105			inputValues, inputIDs, err := e.resolveInputs(stage)
   106			if err != nil {
   107				e.status[name] = "failed"
   108				e.results[name].Status = "failed"
   109				e.results[name].Error = err.Error()
   110				continue
   111			}
   112	
   113			params := e.config.stageParams(name, e.globals)
   114			start := time.Now()
   115			out, err := executeStage(stage, params, inputValues)
   116			duration := time.Since(start).Milliseconds()
   117			e.results[name].DurationMs = duration
   118	
   119			if err != nil {
   120				e.status[name] = "failed"
   121				e.results[name].Status = "failed"
   122				e.results[name].Error = err.Error()
   123				continue
   124			}
   125	
   126			e.status[name] = "success"
   127			e.results[name].Status = "success"
   128			ts := time.Now().UnixNano()
   129	
   130			for port, val := range out {
   131				id := artifactID(e.config.Pipeline.Name, name, port, ts)
   132				e.values[name][port] = val
   133				e.outputs[name][port] = id
   134				typ := val.Type()
   135				summary := val.Summary()
   136				meta := &ArtifactMeta{
   137					ID:        id,
   138					Stage:     name,
   139					Port:      port,
   140					Type:      typ,
   141					Summary:   summary,
   142					Inputs:    inputIDs,
   143					Outputs:   []string{},
   144					Timestamp: ts,
   145				}
   146				e.meta[id] = meta
   147				for _, inID := range inputIDs {
   148					if parent, ok := e.meta[inID]; ok {
   149						parent.Outputs = appendUnique(parent.Outputs, id)
   150					}
   151				}
   152				runArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}
   153			}
   154		}
   155	
   156		status := "success"
   157		for _, s := range e.results {
   158			if s.Status != "success" {
   159				status = "failed"
   160				break
   161			}
   162		}
   163	
   164		run := &RunOutput{
   165			Pipeline:  e.config.Pipeline.Name,
   166			Status:    status,
   167			Stages:    e.results,
   168			Artifacts: runArtifacts,
   169		}
   170	
   171		if err := saveArtifacts(e.meta); err != nil {
   172			return nil, err
   173		}
   174		if err := saveRun(run); err != nil {
   175			return nil, err
   176		}
   177	
   178		return run, nil
   179	}
   180	
