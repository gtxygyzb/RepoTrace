   206	func cmdRegistryCompare(args []string) {
   207		if len(args) < 2 {
   208			printError("usage: mlpipe registry compare <name>:<version1> <name>:<version2>")
   209			return
   210		}
   211		name1, v1, ok := splitNameVersion(args[0])
   212		if !ok {
   213			printError("invalid name:version format")
   214			return
   215		}
   216		name2, v2, ok := splitNameVersion(args[1])
   217		if !ok {
   218			printError("invalid name:version format")
   219			return
   220		}
   221		if name1 != name2 {
   222			printError("cannot compare different model names")
   223			return
   224		}
   225		result, err := compareModels(name1, v1, v2)
   226		if err != nil {
   227			printError(err.Error())
   228			return
   229		}
   230		printJSON(result)
   231	}
