    69	func runStatus(run interface{}) string {
    70		switch r := run.(type) {
    71		case *RunOutput:
    72			return r.Status
    73		case *CVRunOutput:
    74			return r.Status
    75		default:
    76			return "success"
    77		}
    78	}
