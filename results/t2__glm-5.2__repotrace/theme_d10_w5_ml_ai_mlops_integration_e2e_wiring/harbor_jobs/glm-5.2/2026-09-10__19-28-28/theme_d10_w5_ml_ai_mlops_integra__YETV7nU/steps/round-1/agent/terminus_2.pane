   177	func outputPortType(stageType, port string) string {
   178		switch stageType {
   179		case "data-source", "transform":
   180			if port == "data" {
   181				return "dataset"
   182			}
   183		case "split":
   184			if port == "train" || port == "test" {
   185				return "dataset"
   186			}
   187		case "train":
   188			if port == "model" {
   189				return "model"
   190			}
   191			if port == "predictions" {
   192				return "dataset"
   193			}
   194		case "evaluate":
   195			if port == "report" {
   196				return "report"
   197			}
   198		case "register":
   199			if port == "entry" {
   200				return "entry"
   201			}
   202		}
   203		return "unknown"
   204	}
