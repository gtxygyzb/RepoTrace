    53	func executeTrain(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
    54		var ds *Dataset
    55		for _, in := range inputs {
    56			if in != nil && in.Dataset != nil {
    57				ds = in.Dataset
    58				break
    59			}
    60		}
    61		if ds == nil {
    62			return nil, fmt.Errorf("train stage %q requires input data", stage.Name)
    63		}
    64	
    65		algorithm, ok := getString(params, "algorithm")
    66		if !ok {
    67			return nil, fmt.Errorf("train stage %q requires algorithm", stage.Name)
    68		}
    69		target, ok := getString(params, "target")
    70		if !ok {
    71			return nil, fmt.Errorf("train stage %q requires target", stage.Name)
    72		}
    73		targetVals, err := ds.NumericColumn(target)
    74		if err != nil {
    75			return nil, err
    76		}
    77		classification := isBinary01(targetVals)
    78		if algorithm == "linear-regression" {
    79			classification = false
    80		}
    81		if algorithm == "logistic-regression" {
    82			classification = true
    83		}
    84	
    85		features, ok := getStringSlice(params, "features")
    86		if !ok || len(features) == 0 {
    87			features = []string{}
    88			for i, col := range ds.Columns {
    89				if col == target {
    90					continue
    91				}
    92				if i < len(ds.Types) && ds.Types[i] == "numeric" {
    93					features = append(features, col)
    94				}
    95			}
    96		}
    97		X, err := ds.featureMatrix(features)
    98		if err != nil {
    99			return nil, err
   100		}
   101		y := targetVals
   102	
   103		hp := getMapDefault(params, "hyperparams", map[string]interface{}{})
   104		model := &Model{Algorithm: algorithm, Target: target, Features: features, Hyperparams: hp, Classification: classification, TrainFeatures: X, TrainTarget: y}
   105	
   106		switch algorithm {
   107		case "linear-regression":
   108			w, err := trainLinearRegression(X, y)
   109			if err != nil {
   110				return nil, err
   111			}
   112			model.LinearWeights = w
   113		case "logistic-regression":
   114			lr := getFloatDefault(hp, "learning_rate", 0.01)
   115			epochs := getIntDefault(hp, "epochs", 1000)
   116			w, err := trainLogisticRegression(X, y, lr, epochs)
   117			if err != nil {
   118				return nil, err
   119			}
   120			model.LogisticWeights = w
