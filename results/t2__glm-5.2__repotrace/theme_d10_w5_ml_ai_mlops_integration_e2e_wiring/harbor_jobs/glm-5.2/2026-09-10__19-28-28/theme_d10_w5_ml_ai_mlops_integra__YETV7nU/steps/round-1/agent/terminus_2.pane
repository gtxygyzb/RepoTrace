   251	func (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {
   252		inputs := map[string]*ArtifactValue{}
   253		ids := []string{}
   254		for local, ref := range stage.Inputs {
   255			parts := strings.SplitN(ref, ".", 2)
   256			if len(parts) != 2 {
   257				return nil, nil, fmt.Errorf("stage %q has invalid input reference %q", stage.Name, ref)
   258			}
