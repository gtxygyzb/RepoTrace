   284	func artifactID(pipeline, stage, port string, ts int64) string {
   285		if pipeline == "" {
   286			pipeline = "pipeline"
   287		}
   288		return fmt.Sprintf("%s-%s-%s-%d", pipeline, stage, port, ts)
   289	}
   290	
   291	func (v *ArtifactValue) Type() string {
   292		if v.Dataset != nil {
   293			return "dataset"
   294		}
   295		if v.Model != nil {
   296			return "model"
   297		}
   298		if v.Report != nil {
   299			return "report"
   300		}
   301		if v.Entry != nil {
   302			return "entry"
   303		}
   304		return "unknown"
   305	}
   306	
   307	func (v *ArtifactValue) Summary() map[string]interface{} {
   308		if v.Dataset != nil {
   309			return v.Dataset.Summary()
   310		}
   311		if v.Model != nil {
   312			return map[string]interface{}{
   313				"algorithm":   v.Model.Algorithm,
   314				"target":      v.Model.Target,
   315				"features":    v.Model.Features,
   316				"hyperparams": v.Model.Hyperparams,
   317			}
   318		}
   319		if v.Report != nil {
   320			return v.Report.Summary()
   321		}
   322		if v.Entry != nil {
   323			return map[string]interface{}{
   324				"name":    v.Entry.Name,
   325				"version": v.Entry.Version,
   326				"stage":   v.Entry.Stage,
   327			}
   328		}
   329		return map[string]interface{}{}
