[?2004l[?2004h> func termName(counts map[string]int) string {
[?2004l[?2004h>     keys := make([]string, 0, len(counts))
[?2004l[?2004h>     for k := range counts {
[?2004l[?2004h>         keys = append(keys, k)
[?2004l[?2004h>     }
[?2004l[?2004h>     sort.Strings(keys)
[?2004l[?2004h>     parts := []string{}
[?2004l[?2004h>     for _, k := range keys {
[?2004l[?2004h>         n := counts[k]
[?2004l[?2004h>         if n == 1 {
[?2004l[?2004h>             parts = append(parts, k)
[?2004l[?2004h>         } else {
[?2004l[?2004h>             parts = append(parts, k+"^"+strconv.Itoa(n))
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     return strings.Join(parts, "*")
