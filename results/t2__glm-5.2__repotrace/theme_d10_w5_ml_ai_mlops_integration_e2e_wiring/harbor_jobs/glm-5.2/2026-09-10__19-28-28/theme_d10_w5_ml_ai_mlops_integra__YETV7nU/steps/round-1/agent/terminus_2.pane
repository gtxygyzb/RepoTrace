   209	func cmdLineage(args []string) {
   210		if len(args) < 1 {
   211			printError("usage: mlpipe lineage <artifact_id> [--direction up|down|both]")
   212			return
   213		}
   214		id := args[0]
   215		direction := "both"
   216		for i := 1; i < len(args); i++ {
   217			if args[i] == "--direction" && i+1 < len(args) {
   218				direction = args[i+1]
   219				i++
   220			} else if strings.HasPrefix(args[i], "--direction=") {
   221				direction = strings.TrimPrefix(args[i], "--direction=")
   222			} else {
   223				printError(fmt.Sprintf("unknown flag: %s", args[i]))
   224				return
   225			}
   226		}
   227		result, err := queryLineage(id, direction)
   228		if err != nil {
   229			printError(err.Error())
   230			return
   231		}
   232		printJSON(result)
   233	}
   234	
   235	func parseParams(args []string) (map[string]string, error) {
   236		overrides := map[string]string{}
   237		for i := 0; i < len(args); i++ {
   238			if args[i] == "--param" {
   239				if i+1 >= len(args) {
   240					return nil, fmt.Errorf("--param requires key=value")
   241				}
   242				kv := args[i+1]
   243				i++
   244				k, v, ok := strings.Cut(kv, "=")
   245				if !ok {
   246					return nil, fmt.Errorf("--param requires key=value")
   247				}
   248				overrides[k] = v
   249			} else if strings.HasPrefix(args[i], "--param=") {
   250				kv := strings.TrimPrefix(args[i], "--param=")
   251				k, v, ok := strings.Cut(kv, "=")
   252				if !ok {
   253					return nil, fmt.Errorf("--param requires key=value")
   254				}
   255				overrides[k] = v
   256			} else {
   257				return nil, fmt.Errorf("unknown flag: %s", args[i])
   258			}
   259		}
   260		return overrides, nil
   261	}
   262	
   263	func splitNameVersion(s string) (string, int, bool) {
   264		parts := strings.SplitN(s, ":", 2)
   265		if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
   266			return "", 0, false
   267		}
   268		var version int
   269		if _, err := fmt.Sscanf(parts[1], "%d", &version); err != nil {
   270			return "", 0, false
   271		}
   272		return parts[0], version, true
   273	}
   274	
   275	func printJSON(v interface{}) {
   276		data, err := json.MarshalIndent(v, "", "  ")
   277		if err != nil {
   278			printError(err.Error())
   279			return
   280		}
   281		fmt.Println(string(data))
   282	}
   283	
   284	func printError(msg string) {
   285		data, _ := json.Marshal(map[string]string{"error": msg})
   286		fmt.Fprintln(os.Stderr, string(data))
   287		os.Exit(1)
   288	}
