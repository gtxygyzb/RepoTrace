[?2004lpackage main

import (
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"strconv"
	"strings"
	"time"
)

func canonicalJSON(v interface{}) (string, error) {
	b, err := marshalCanonical(v)
	if err != nil {
		return "", err
	}
	return string(b), nil
}

func marshalCanonical(v interface{}) ([]byte, error) {
	switch x := v.(type) {
	case map[string]interface{}:
		keys := make([]string, 0, len(x))
		for k := range x {
			keys = append(keys, k)
		}
		sort.Strings(keys)
		var b strings.Builder
		b.WriteString("{")
		for i, k := range keys {
			if i > 0 {
				b.WriteString(",")
			}
			kb, err := json.Marshal(k)
			if err != nil {
				return nil, err
			}
			b.Write(kb)
			b.WriteString(":")
			vb, err := marshalCanonical(x[k])
			if err != nil {
				return nil, err
			}
			b.Write(vb)
		}
		b.WriteString("}")
		return []byte(b.String()), nil
	case []interface{}:
		var b strings.Builder
		b.WriteString("[")
		for i, item := range x {
			if i > 0 {
				b.WriteString(",")
			}
			ib, err := marshalCanonical(item)
			if err != nil {
				return nil, err
			}
			b.Write(ib)
		}
		b.WriteString("]")
		return []byte(b.String()), nil
	default:
		return json.Marshal(v)
	}
}

func sha256Hex(data []byte) string {
	h := sha256.Sum256(data)
	return hex.EncodeToString(h[:])
}

func fileSHA256(path string) (string, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return "", err
	}
	return sha256Hex(data), nil
}

func cacheDir() string {
	return filepath.Join(".mlpipe", "cache")
}

func cacheEntryPath(key string) string {
	return filepath.Join(cacheDir(), key)
}

func cacheEntryExists(key string) bool {
	if key == "" {
		return false
	}
	info, err := os.Stat(cacheEntryPath(key))
	return err == nil && info.IsDir()
}

func computeCacheKey(stage *StageConfig, params map[string]interface{}, inputKeys map[string]string, fold int) (string, error) {
	var sb strings.Builder
	sb.WriteString(stage.Type)
	sb.WriteString("\n")

	paramsJSON, err := canonicalJSON(params)
	if err != nil {
		return "", err
	}
	sb.WriteString(paramsJSON)
	sb.WriteString("\n")

	if stage.Type == "data-source" {
		path, ok := getString(params, "path")
		if !ok {
			return "", fmt.Errorf("data-source stage %q requires path for cache key", stage.Name)
		}
		fileHash, err := fileSHA256(path)
		if err != nil {
			return "", err
		}
		sb.WriteString(fileHash)
	} else {
		ports := make([]string, 0, len(stage.Inputs))
		for port := range stage.Inputs {
			ports = append(ports, port)
		}
		sort.Strings(ports)
		for i, port := range ports {
			if i > 0 {
				sb.WriteString("\n")
			}
			sb.WriteString(port)
			sb.WriteString("=")
			if key, ok := inputKeys[port]; ok {
				sb.WriteString(key)
			}
		}
	}

	if fold >= 0 {
		sb.WriteString("\nfold=")
		sb.WriteString(strconv.Itoa(fold))
	}

	return sha256Hex([]byte(sb.String())), nil
}

type cacheMeta struct {
	CacheKey    string   `json:"cache_key"`
	StageName   string   `json:"stage_name"`
	StageType   string   `json:"stage_type"`
	CreatedAt   string   `json:"created_at"`
	OutputPorts []string `json:"output_ports"`
}

func serializeArtifactValue(val *ArtifactValue) ([]byte, error) {
	if val.Dataset != nil {
		typesMap := make(map[string]string, len(val.Dataset.Columns))
		for i, col := range val.Dataset.Columns {
			if i < len(val.Dataset.Types) {
				typesMap[col] = val.Dataset.Types[i]
			}
		}
		obj := map[string]interface{}{
			"type":    "dataset",
			"columns": val.Dataset.Columns,
			"types":   typesMap,
			"rows":    val.Dataset.Rows,
		}
		return json.MarshalIndent(obj, "", "  ")
	}
	if val.Model != nil {
		obj := map[string]interface{}{
			"type":  "model",
			"model": val.Model,
		}
		return json.MarshalIndent(obj, "", "  ")
	}
	if val.Report != nil {
		obj := map[string]interface{}{
			"type":    "report",
			"metrics": val.Report.Metrics,
			"pass":    val.Report.Pass,
		}
		return json.MarshalIndent(obj, "", "  ")
	}
	if val.Entry != nil {
		obj := map[string]interface{}{
			"type":    "entry",
			"name":    val.Entry.Name,
			"version": val.Entry.Version,
			"stage":   val.Entry.Stage,
		}
		return json.MarshalIndent(obj, "", "  ")
	}
	return nil, fmt.Errorf("cannot serialize unknown artifact type")
}

func deserializeArtifactValue(data []byte) (*ArtifactValue, error) {
	var obj map[string]interface{}
	if err := json.Unmarshal(data, &obj); err != nil {
		return nil, err
	}
	typ, _ := obj["type"].(string)
	switch typ {
	case "dataset":
		return deserializeDatasetValue(obj)
	case "model":
		return deserializeModelValue(obj)
	case "report":
		metrics, _ := obj["metrics"].(map[string]interface{})
		pass, _ := obj["pass"].(bool)
		return &ArtifactValue{Report: &Report{Metrics: metrics, Pass: pass}}, nil
	case "entry":
		name, _ := obj["name"].(string)
		version, _ := obj["version"].(float64)
		stage, _ := obj["stage"].(string)
		return &ArtifactValue{Entry: &RegistryEntry{Name: name, Version: int(version), Stage: stage}}, nil
	}
[?2004hroot@n30009:/app# sed -n '220,340p' pipeline.go
[?2004l				e.cacheStats.Misses++
			}
		}

		e.status[name] = "success"
		e.results[name].Status = "success"
		ts := time.Now().UnixNano()

		for port, val := range out {
			id := artifactID(e.config.Pipeline.Name, name, port, ts)
			e.values[name][port] = val
			e.outputs[name][port] = id
			typ := val.Type()
			summary := val.Summary()
			meta := &ArtifactMeta{
				ID:        id,
				Stage:     name,
				Port:      port,
				Type:      typ,
				Summary:   summary,
				Inputs:    inputIDs,
				Outputs:   []string{},
				Timestamp: ts,
			}
			e.meta[id] = meta
			for _, inID := range inputIDs {
				if parent, ok := e.meta[inID]; ok {
					parent.Outputs = appendUnique(parent.Outputs, id)
				}
			}
			runArtifacts[id] = &ArtifactOutput{Stage: name, Port: port, Type: typ, Summary: summary}
		}
	}

	status := "success"
	for _, s := range e.results {
		if s.Status == "failed" {
			status = "failed"
			break
		}
	}

	run := &RunOutput{
		Pipeline:   e.config.Pipeline.Name,
		Status:     status,
		Stages:     e.results,
		Artifacts:  runArtifacts,
		CacheStats: e.cacheStats,
	}

	if err := saveArtifacts(e.meta); err != nil {
		return nil, err
	}

	return run, nil
}

func (e *Executor) inputCacheKeys(stage *StageConfig) map[string]string {
	keys := map[string]string{}
	for local, ref := range stage.Inputs {
		refs, ok := inputRefs(ref)
		if !ok {
			continue
		}
		for _, r := range refs {
			parts := strings.SplitN(r, ".", 2)
			if len(parts) != 2 {
				continue
			}
			depStage := parts[0]
			if key, ok := e.cacheKeys[depStage]; ok {
				keys[local] = keys[local] + key + "\n"
			}
		}
	}
	for k, v := range keys {
		keys[k] = strings.TrimRight(v, "\n")
	}
	return keys
}

func (e *Executor) resolveInputs(stage *StageConfig) (map[string]*ArtifactValue, []string, error) {
	inputs := map[string]*ArtifactValue{}
	ids := []string{}
	for local, ref := range stage.Inputs {
		refs, ok := inputRefs(ref)
		if !ok {
			return nil, nil, fmt.Errorf("stage %q input %q has invalid reference %v", stage.Name, local, ref)
		}
		var firstVal *ArtifactValue
		for _, r := range refs {
			parts := strings.SplitN(r, ".", 2)
			if len(parts) != 2 {
				return nil, nil, fmt.Errorf("stage %q has invalid input reference %q", stage.Name, r)
			}
			depStage, port := parts[0], parts[1]
			id, ok := e.outputs[depStage][port]
			if !ok {
				return nil, nil, fmt.Errorf("stage %q input %q references unavailable output %s.%s", stage.Name, local, depStage, port)
			}
			val, ok := e.values[depStage][port]
			if !ok || val == nil {
				return nil, nil, fmt.Errorf("stage %q input %q references unavailable artifact %s.%s", stage.Name, local, depStage, port)
			}
			ids = append(ids, id)
			if firstVal == nil {
				firstVal = val
			}
			if stage.Type == "ensemble" && local == "models" {
				inputs[local+"_"+r] = val
			}
		}
		if _, exists := inputs[local]; !exists {
			inputs[local] = firstVal
		}
	}
	return inputs, ids, nil
}

func executeStage(stage *StageConfig, params map[string]interface{}, inputs map[string]*ArtifactValue) (map[string]*ArtifactValue, error) {
	switch stage.Type {
