func parseWorkflowBytes(data []byte) (*Workflow, error) {
	var doc map[string]any
	dec := yaml.NewDecoder(bytes.NewReader(data))
	if err := dec.Decode(&doc); err != nil {
		return nil, err
	}
	wf := &Workflow{}
	if envAny, ok := doc["env"]; ok {
		env, err := toStringMap("env", envAny)
		if err != nil {
			return nil, err
		}
		wf.Env = env
	}
	if hooksAny, ok := doc["hooks"]; ok {
		hooks, err := parseHooks(hooksAny)
		if err != nil {
			return nil, err
		}
		wf.Hooks = hooks
	}
	if stepsAny, ok := doc["steps"]; ok {
		steps, err := parseSteps(stepsAny)
		if err != nil {
			return nil, err
		}
		wf.Steps = steps
	}
	return wf, nil
}

func parseHooks(v any) (map[string]string, error) {
	m, ok := v.(map[string]any)
	if !ok {
		return nil, fmt.Errorf("hooks must be a mapping")
	}
	allowed := map[string]bool{"on_start": true, "on_success": true, "on_failure": true}
	out := map[string]string{}
	for k, vv := range m {
		if !allowed[k] {
			return nil, fmt.Errorf("unknown hook: %s", k)
		}
		s, err := toNonEmptyString(fmt.Sprintf("hooks.%s", k), vv)
		if err != nil {
			return nil, err
		}
		if strings.ContainsRune(s, 0) {
			return nil, fmt.Errorf("hook %s must not contain NUL bytes", k)
		}
		out[k] = s
	}
	return out, nil
}

func parseSteps(v any) ([]Step, error) {
	arr, ok := v.([]any)
	if !ok {
		return nil, fmt.Errorf("steps must be a sequence")
	}
	var out []Step
	for i, item := range arr {
		s, err := parseStep(item, i)
		if err != nil {
			return nil, err
		}
		out = append(out, s)
	}
	return out, nil
}

func parseStep(v any, idx int) (Step, error) {
	m, ok := v.(map[string]any)
	if !ok {
		return Step{}, fmt.Errorf("step %d must be a mapping", idx)
	}
	allowed := map[string]bool{
		"name": true, "cmd": true, "pipe": true, "env": true, "needs": true,
		"matrix": true, "retries": true, "retry": true, "when": true,
		"foreach": true, "inputs": true, "outputs": true, "on_failure": true,
		"resources": true, "timeout_ms": true,
	}
	for k := range m {
		if !allowed[k] {
			return Step{}, fmt.Errorf("unknown step field: %s", k)
		}
	}
	var s Step
	ns, ok := m["name"]
	if !ok {
		return Step{}, fmt.Errorf("step %d missing name", idx)
	}
	name, err := toNonEmptyString("name", ns)
	if err != nil {
		return Step{}, err
	}
	if strings.ContainsRune(name, 0) {
		return Step{}, fmt.Errorf("step name must not contain NUL bytes")
	}
	s.Name = name
	if v, ok := m["cmd"]; ok {
		s.Cmd, err = toString("cmd", v)
		if err != nil {
			return Step{}, err
		}
	}
	if v, ok := m["pipe"]; ok {
		s.Pipe, err = toStringList("pipe", v)
		if err != nil {
			return Step{}, err
		}
	}
	if v, ok := m["env"]; ok {
		s.Env, err = toStringMap("env", v)
		if err != nil {
			return Step{}, err
		}
	}
	if v, ok := m["needs"]; ok {
		s.Needs, err = toStringList("needs", v)
		if err != nil {
			return Step{}, err
		}
	}
	if v, ok := m["matrix"]; ok {
		s.Matrix, err = parseMatrix(v)
		if err != nil {
			return Step{}, err
		}
	}
	if v, ok := m["retries"]; ok {
		r, err := toInt("retries", v)
		if err != nil {
			return Step{}, err
		}
		if r < 0 {
			re[?2004h> package main
