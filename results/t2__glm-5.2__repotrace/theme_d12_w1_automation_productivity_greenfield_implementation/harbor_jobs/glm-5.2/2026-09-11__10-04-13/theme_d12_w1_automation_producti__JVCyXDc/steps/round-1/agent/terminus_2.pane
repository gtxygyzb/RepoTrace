const exitValidation = 4
const exitMissing = 5

var nowFunc = time.Now

type Workflow struct {
Env   map[string]string
Hooks map[string]string
Steps []Step
}

type Step struct {
Name      string
Cmd       string
Pipe      []string
Env       map[string]string
Needs     []string
Matrix    map[string][]string
Retries   *int
Retry     *RetryPolicy
When      string
Foreach   *ForeachSpec
Inputs    []string
Outputs   []string
OnFailure string
Resources map[string]int
TimeoutMs *int
}

type RetryPolicy struct {
Count     int
Backoff   string
InitialMs int
MaxMs     int
Jitter    bool
}

type ForeachSpec struct {
Items any
}

type stepRef struct {
Name string
Key  string
}

func parseWorkflowBytes(data []byte) (*Workflow, error) {
var doc map[string]any
dec := yaml.NewDecoder(bytes.NewReader(data))
if err := dec.Decode(&doc); err != nil {
[?2004hroot@n30009:/app# tail -n 40 cmd/flowr/main.go
[?2004lout = append(out, s)
}
return out, nil
}

func toStringMap(field string, v any) (map[string]string, error) {
m, ok := v.(map[string]any)
if !ok {
return nil, fmt.Errorf("%s must be a mapping", field)
}
out := map[string]string{}
for k, vv := range m {
s, err := toString(fmt.Sprintf("%s.%s", field, k), vv)
if err != nil {
return nil, err
}
out[k] = s
}
return out, nil
}

func toIntMap(field string, v any) (map[string]int, error) {
m, ok := v.(map[string]any)
if !ok {
return nil, fmt.Errorf("%s must be a mapping", field)
}
out := map[string]int{}
for k, vv := range m {
i, err := toInt(fmt.Sprintf("%s.%s", field, k), vv)
if err != nil {
return nil, err
}
if i < 0 {
return nil, fmt.Errorf("%s.%s must be >= 0", field, k)
}
out[k] = i
}
return out, nil
}

