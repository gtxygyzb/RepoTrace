func resolveForeachItems(rt *Runtime, step *Step) ([]string, error) {
    switch x := step.Foreach.Items.(type) {
    case string:
        if isStepOutputRef(x) {
            ref, err := parseStepOutputRef(x)
            if err != nil {
                return nil, err
            }
            prod, ok := rt.outputs[ref.Name]
            if !ok {
                return nil, fmt.Errorf("missing_step_output")
            }
            val, ok := prod[ref.Key]
            if !ok {
                return nil, fmt.Errorf("missing_step_output")
            }
            arr, ok := val.([]any)
            if !ok {
                return nil, fmt.Errorf("step output %s.%s must be an array of strings", ref.Name, ref.Key)
            }
            out := make([]string, 0, len(arr))
            for _, e := range arr {
                s, ok := e.(string)
                if !ok {
                    return nil, fmt.Errorf("step output %s.%s must be an array of strings", ref.Name, ref.Key)
                }
                out = append(out, s)
            }
            return out, nil
        }
        interpolated, err := interpolateFirstPass(x, []map[string]string{step.Env, rt.wf.Env, rt.parentEnv}, nil)
        if err != nil {
            return nil, err
        }
        if interpolated == "" {
            return nil, nil
        }
        parts := strings.Split(interpolated, ",")
        out := make([]string, 0, len(parts))
        for _, p := range parts {
            p = strings.TrimSpace(p)
            if p == "" {
                return nil, fmt.Errorf("empty foreach item")
            }
