func runResume(priorID, newID, maxParallel, onlyStep, skipStep, slots string, noCache bool) int {
    priorDir := filepath.Join(".flowr", "runs", priorID)
    snapPath := filepath.Join(priorDir, "workflow.yaml.snapshot")
    reportPath := filepath.Join(priorDir, "report.json")
    if !fileExists(priorDir) {
        fatalErr("cannot resume: %s", priorDir)
        return exitMissing
    }
    if !fileExists(snapPath) || !fileExists(reportPath) {
        fatalErr("cannot resume: %s", missingPath(snapPath, reportPath))
        return exitMissing
    }
    data, err := os.ReadFile(snapPath)
    if err != nil {
        fatalErr("cannot resume: %v", err)
        return exitMissing
    }
    wf, err := parseWorkflowBytes(data)
    if err != nil {
        fatalErr("%v", err)
        return exitValidation
    }
    parentEnv := envMapFromOS()
    if err := validateWorkflow(wf, parentEnv); err != nil {
        fatalErr("%v", err)
        return exitValidation
    }
    var priorReport Report
    if err := readJSONFile(reportPath, &priorReport); err != nil {
        fatalErr("cannot resume: %v", err)
        return exitMissing
    }
    absSnap, _ := filepath.Abs(snapPath)
    if err := validateHookInterpolation(wf, parentEnv, newID, absSnap); err != nil {
        fatalErr("%v", err)
        return exitValidation
    }
    rt := newRuntime(wf, newID, absSnap, maxParallel, onlyStep, skipStep, slots, noCache, priorID)
    if err := initRunDir(rt, data, false); err != nil {
        fatalErr("%v", err)
        return exitFailed
    }
    applyResume(rt, &priorReport)
    return runWorkflow(rt)[?2004h> package main
