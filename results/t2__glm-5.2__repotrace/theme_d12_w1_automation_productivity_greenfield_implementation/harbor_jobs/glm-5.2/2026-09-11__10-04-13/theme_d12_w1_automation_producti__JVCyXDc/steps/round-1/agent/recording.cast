[5037.633579, "o", "            s, err := toString(fmt.Sprintf(\"foreach.items[%d]\", i), item)\r\n\u001b[?2004l\r"]
[5037.633637, "o", "\u001b[?2004h> "]
[5037.633711, "o", "            if err != nil {\r\n\u001b[?2004l\r"]
[5037.633766, "o", "\u001b[?2004h> "]
[5037.633868, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[5037.633923, "o", "\u001b[?2004h> "]
[5037.633979, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.634447, "o", "            interpolated, err := interpolateFirstPass(s, []map[string]string{step.Env, rt.wf.Env, rt.parentEnv}, nil)\r\n\u001b[?2004l\r"]
[5037.634504, "o", "\u001b[?2004h> "]
[5037.634587, "o", "            if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.63464, "o", "> "]
[5037.634727, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[5037.634781, "o", "\u001b[?2004h> "]
[5037.634837, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.634989, "o", "            if interpolated == \"\" {\r\n\u001b[?2004l\r"]
[5037.635043, "o", "\u001b[?2004h> "]
[5037.635244, "o", "                return nil, fmt.Errorf(\"empty foreach item\")\r\n\u001b[?2004l\r"]
[5037.635299, "o", "\u001b[?2004h> "]
[5037.635361, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.635538, "o", "            out = append(out, interpolated)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.635592, "o", ">         }\r\n\u001b[?2004l\r"]
[5037.635645, "o", "\u001b[?2004h> "]
[5037.635723, "o", "        return out, nil\r\n\u001b[?2004l\rp"]
[5037.635777, "o", "\u001b[?2004h> "]
[5037.63583, "o", "    default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.636037, "o", "        return nil, fmt.Errorf(\"foreach.items must be a string or sequence\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.636096, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[5037.63615, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rp\u001b[?2004h> "]
[5037.636317, "o", "func outputJSONPath(rt *Runtime, expandedName string) string {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.636549, "o", "    return filepath.Join(rt.runDir, \"steps\", expandedName, \"output.json\")\r\n\u001b[?2004l\r"]
[5037.636604, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.636659, "o", "> "]
[5037.636833, "o", "func loadStepOutput(rt *Runtime, expandedName string) (map[string]any, error) {\r\n\u001b[?2004l\r"]
[5037.636889, "o", "\u001b[?2004h> "]
[5037.636981, "o", "    path := outputJSONPath(rt, expandedName)\r\n\u001b[?2004l\r"]
[5037.637036, "o", "\u001b[?2004h> "]
[5037.637096, "o", "    data, err := os.ReadFile(path)\r\n\u001b[?2004l\r"]
[5037.637151, "o", "\u001b[?2004h> "]
[5037.637198, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.637276, "o", "        return nil, err\r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.637338, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.637399, "o", "    var v any\r\n\u001b[?2004l\r \u001b[?2004h> "]
[5037.637558, "o", "    dec := json.NewDecoder(strings.NewReader(string(data)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.637627, "o", "    dec.UseNumber()\r\n\u001b[?2004l\r"]
[5037.637681, "o", "\u001b[?2004h> "]
[5037.63777, "o", "    if err := dec.Decode(&v); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.637837, "o", "> "]
[5037.637892, "o", "        return nil, err\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.637947, "o", "> "]
[5037.638016, "o", "    obj, ok := v.(map[string]any)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.638073, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[5037.638126, "o", "\u001b[?2004h> "]
[5037.638227, "o", "        return nil, fmt.Errorf(\"bad_output_json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.638282, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.638345, "o", "    for k, vv := range obj {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.638445, "o", "        if !outputKeyRe.MatchString(k) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.638558, "o", "            return nil, fmt.Errorf(\"bad_output_json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.638623, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.638678, "o", "        if !validOutputValue(vv) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.638733, "o", "> "]
[5037.638798, "o", "            return nil, fmt.Errorf(\"bad_output_json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.638853, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.638907, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.638961, "o", "    return obj, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[5037.63902, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639078, "o", "func validOutputValue(v any) bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639153, "o", "    switch x := v.(type) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639238, "o", "    case string, bool, json.Number:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639296, "o", "        return true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639373, "o", "    case float64, int, int64:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639434, "o", "        return true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639486, "o", "    case []any:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.63956, "o", "        for _, e := range x {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639642, "o", "            s, ok := e.(string)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639724, "o", "            if !ok || s == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639812, "o", "                return false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639868, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639922, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.639977, "o", "        return true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.640008, "o", "    default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.640089, "o", "        return false\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5037.640143, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.640275, "o", "func allNeedsTerminal(rt *Runtime, es *ExpandedStep) bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.640369, "o", "    for _, n := range es.Base.Needs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.640462, "o", "        if !needsStepTerminal(rt, n) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.640528, "o", "            return false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.640584, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5037.640639, "o", "\u001b[?2004h>     return true\r\n\u001b[?2004l\r"]
[5037.640694, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.640752, "o", "> "]
[5037.640835, "o", "func needsStepTerminal(rt *Runtime, baseName string) bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.640889, "o", "> "]
[5037.640944, "o", "    cells := rt.expandedCellsForBase(baseName)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.641006, "o", "    if cells == nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.641101, "o", "        st, ok := rt.statuses[baseName]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.6412, "o", "        return ok && isTerminal(st)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.641258, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.641328, "o", "    for _, c := range cells {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.641388, "o", "        st, ok := rt.statuses[c]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.641478, "o", "        if !ok || !isTerminal(st) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.641543, "o", "            return false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.641603, "o", "        }\r\n\u001b[?2004l\r"]
[5037.641657, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.641712, "o", ">     return true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.641767, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.641847, "o", "func isTerminal(status string) bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.641906, "o", "    switch status {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.642107, "o", "    case \"ok\", \"cached\", \"failed\", \"cancelled\", \"skipped\", \"conditionally_skipped\", \"inherited\":\r\n\u001b[?2004l\r"]
[5037.642164, "o", "\u001b[?2004h>         return true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.642224, "o", "    default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.642287, "o", "        return false\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5037.642357, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.642453, "o", "func isFailureStatus(status string) bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.642507, "o", "> "]
[5037.642576, "o", "    return status == \"failed\" || status == \"cancelled\"\r\n\u001b[?2004l\r"]
[5037.642631, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.642663, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.6428, "o", "func expandedCellsForBase(rt *Runtime, baseName string) []string {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.642916, "o", "    if cells, ok := rt.foreachCells[baseName]; ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.642976, "o", "        return cells\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.643029, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.64312, "o", "    if cells, ok := rt.matrixCells[baseName]; ok {\r\n\u001b[?2004l\r"]
[5037.643174, "o", "\u001b[?2004h>         return cells\r\n\u001b[?2004l\r"]
[5037.643233, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.643295, "o", "    return nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5037.643358, "o", "\u001b[?2004h> "]
[5037.643473, "o", "func expandBaseIfNeeded(rt *Runtime, step *Step) ([]string, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.643543, "o", "    if step.Foreach != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.643636, "o", "        if rt.foreachDone[step.Name] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.643752, "o", "            return rt.foreachCells[step.Name], nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.643806, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.643896, "o", "        cells, err := expandForeach(rt, step)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.64396, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.644034, "o", "            return nil, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.644081, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.644182, "o", "        names := make([]string, 0, len(cells))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.644268, "o", "        for _, es := range cells {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.644422, "o", "            rt.expandedSteps[es.Name] = es\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.644515, "o", "            rt.statuses[es.Name] = \"pending\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.644592, "o", "            names = append(names, es.Name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.644647, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.644713, "o", "        if len(names) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.644815, "o", "            rt.statuses[step.Name] = \"skipped\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.645045, "o", "            sr := StepReport{Name: step.Name, Status: \"skipped\", Reason: \"empty_foreach\", RetryAttempts: []int{}}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.645139, "o", "            rt.reports[step.Name] = sr\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.645373, "o", "            emitEvent(rt, map[string]any{\"event\": \"step_skipped\", \"step\": step.Name, \"reason\": \"empty_foreach\"})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.645477, "o", "            rt.foreachCells[step.Name] = nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.645579, "o", "            rt.foreachDone[step.Name] = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.645654, "o", "            return nil, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.645699, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.645796, "o", "        rt.foreachCells[step.Name] = names\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.645869, "o", "        rt.foreachDone[step.Name] = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.646059, "o", "        emitEvent(rt, map[string]any{\"event\": \"step_foreach_expanded\", \"step\": step.Name, \"count\": len(names), \"cells\": names})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.646112, "o", "        return names, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.646167, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.646222, "o", "    cells := expandMatrix(step)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.64628, "o", "    names := make([]string, 0, len(cells))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.646344, "o", "    for _, es := range cells {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.646399, "o", "        rt.expandedSteps[es.Name] = es\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.646481, "o", "        if _, ok := rt.statuses[es.Name]; !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.646557, "o", "            rt.statuses[es.Name] = \"pending\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.64661, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.646673, "o", "        names = append(names, es.Name)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.646728, "o", ">     if step.Matrix != nil {\r\n\u001b[?2004l\r"]
[5037.646781, "o", "\u001b[?2004h> "]
[5037.646837, "o", "        rt.matrixCells[step.Name] = names\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.646892, "o", "    return names, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.646945, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.647044, "o", "func computeClosure(rt *Runtime, names []string, skip bool) map[string]bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.647107, "o", "    out := map[string]bool{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.647159, "o", "    var visit func(string)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.647216, "o", "    visit = func(name string) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.647264, "o", "        if out[name] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.647326, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h"]
[5037.647382, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h>         out[name] = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.647455, "o", "        for _, s := range rt.wf.Steps {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.647528, "o", "            for _, n := range s.Needs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.647587, "o", "                if n == name {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.647649, "o", "                    visit(s.Name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5037.647711, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
