[4731.033784, "o", "            if err != nil {\r\n\u001b[?2004l\r"]
[4731.033832, "o", "\u001b[?2004h> "]
[4731.033954, "o", "                return err\r\n\u001b[?2004l\r"]
[4731.034, "o", "\u001b[?2004h> "]
[4731.034077, "o", "            }\r\n\u001b[?2004l\r"]
[4731.034123, "o", "\u001b[?2004h> "]
