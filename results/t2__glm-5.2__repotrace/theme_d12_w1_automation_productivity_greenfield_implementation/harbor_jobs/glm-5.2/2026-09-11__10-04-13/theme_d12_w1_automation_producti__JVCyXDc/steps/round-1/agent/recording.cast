[4457.480555, "i", "Idx *int\n    ForeachItem *string\n    Env        map[string]string\n    Cmd        string\n    Pipe       []string\n    When       string\n}\n\ntype StepReport struct {\n    Name           string `json:\"name\"`\n    Status         string `json:\"status\"`\n    Attempts       int    `json:\"attempts\"`\n    ExitCode       *int   `json:\"exit_code\"`\n    DurationMs     int64  `json:\"duration_ms\"`\n    StartedAt      *string `json:\"started_at\"`\n    EndedAt        *string `json:\"ended_at\"`\n    CacheKey       *string `json:\"cache_key\"`\n    Error          string  `json:\"error,omitempty\"`\n    Reason         string  `json:\"reason,omitempty\"`\n    RetryAttempts  []int  `json:\"retry_attempts\"`\n    OriginalStatus string `json:\"original_status,omitempty\"`\n}\n\ntype HookReport struct {\n    Executed   bool  `json:\"executed\"`\n    ExitCode   *int  `json:\"exit_code\"`\n    DurationMs int64 `json:\"duration_ms\"`\n}\n\ntype Report struct {\n    RunID           string                `json:\"run_id\"`\n    WorkflowFile    string                `json:\"workflow_f"]
[4457.480666, "i", "ile\"`\n    StartedAt       string                `json:\"started_at\"`\n    EndedAt         string                `json:\"ended_at\"`\n    TotalDurationMs int64                 `json:\"total_duration_ms\"`\n    MaxParallel     int                   `json:\"max_parallel\"`\n    Status          string                `json:\"status\"`\n    Steps           map[string]StepReport `json:\"steps\"`\n    OrderAttempted  []string              `json:\"order_attempted\"`\n    CacheHits       []string              `json:\"cache_hits\"`\n    CacheMisses     []string              `json:\"cache_misses\"`\n    ResourceStats   map[string]int        `json:\"resource_stats\"`\n    Hooks           map[string]HookReport `json:\"hooks\"`\n    StepOutputs     map[string]any        `json:\"step_outputs\"`\n    ResumedFrom     *string               `json:\"resumed_from\"`\n}\n\ntype Runtime struct {\n    wf            *Workflow\n    runID         string\n    runDir        string\n    workflowFile  string\n    snapshotPath  string\n    eventsFile    string\n    reportPath    string\n "]
