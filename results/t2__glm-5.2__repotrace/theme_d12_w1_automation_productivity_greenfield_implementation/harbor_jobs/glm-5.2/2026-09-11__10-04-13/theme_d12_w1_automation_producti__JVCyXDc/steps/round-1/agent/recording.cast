[4893.268464, "i", "cat > cmd/flowr/interpolate.go <<'EOF'\npackage main\n\nimport (\n    \"encoding/json\"\n    \"fmt\"\n    \"regexp\"\n    \"sort\"\n    \"strconv\"\n    \"strings\"\n)\n\nvar varRefRe = regexp.MustCompile(`\\$\\{([^}]*)\\}`)\n\nfunc interpolateFirstPass(s string, envs []map[string]string, builtins map[string]string) (string, error) {\n    var missing []string\n    result := varRefRe.ReplaceAllStringFunc(s, func(m string) string {\n        inner := m[2 : len(m)-1]\n        if strings.HasPrefix(inner, \"step.\") && strings.Contains(inner, \".output.\") {\n            return m\n        }\n        for _, e := range envs {\n            if e != nil {\n                if v, ok := e[inner]; ok {\n                    return v\n                }\n            }\n        }\n        if builtins != nil {\n            if v, ok := builtins[inner]; ok {\n                return v\n            }\n        }\n        missing = append(missing, inner)\n        return m\n    })\n    if len(missing) > 0 {\n        return \"\", fmt.Errorf(\"undefined variable: %s\", missing[0])\n    }\n    retur"]
[4893.268698, "i", "n result, nil\n}\n\nfunc interpolateStepEnv(s string, stepEnv, wfEnv, parentEnv map[string]string, builtins map[string]string) (string, error) {\n    return interpolateFirstPass(s, []map[string]string{stepEnv, wfEnv, parentEnv}, builtins)\n}\n\nfunc resolveStepOutputs(s string, outputs map[string]map[string]any) (string, error) {\n    var missing []string\n    result := varRefRe.ReplaceAllStringFunc(s, func(m string) string {\n        inner := m[2 : len(m)-1]\n        if !strings.HasPrefix(inner, \"step.\") || !strings.Contains(inner, \".output.\") {\n            return m\n        }\n        ref, err := parseStepOutputRef(m)\n        if err != nil {\n            missing = append(missing, err.Error())\n            return m\n        }\n        prod, ok := outputs[ref.Name]\n        if !ok {\n            missing = append(missing, fmt.Sprintf(\"missing_step_output:%s.%s\", ref.Name, ref.Key))\n            return m\n        }\n        val, ok := prod[ref.Key]\n        if !ok {\n            missing = append(missing, fmt.Sprintf(\"missing_step_outp"]
[4893.268784, "i", "ut:%s.%s\", ref.Name, ref.Key))\n            return m\n        }\n        str, err := outputValueToString(val)\n        if err != nil {\n            missing = append(missing, err.Error())\n            return m\n        }\n        return str\n    })\n    if len(missing) > 0 {\n        return \"\", fmt.Errorf(\"%s\", missing[0])\n    }\n    return result, nil\n}\n\nfunc outputValueToString(v any) (string, error) {\n    switch x := v.(type) {\n    case string:\n        return x, nil\n    case bool:\n        if x {\n            return \"true\", nil\n        }\n        return \"false\", nil\n    case float64:\n        return strconv.FormatFloat(x, 'f', -1, 64), nil\n    case int:\n        return strconv.Itoa(x), nil\n    case int64:\n        return strconv.FormatInt(x, 10), nil\n    case json.Number:\n        return x.String(), nil\n    case []any:\n        parts := make([]string, 0, len(x))\n        for _, e := range x {\n            switch et := e.(type) {\n            case string:\n                parts = append(parts, et)\n            default:\n             "]
[4893.268845, "o", "cat > cmd/flowr/interpolate.go <<'EOF'\r\n\u001b[?2004l\r"]
[4893.268916, "i", "   b, err := json.Marshal(et)\n                if err != nil {\n                    return \"\", err\n                }\n                parts = append(parts, string(b))\n            }\n        }\n        return strings.Join(parts, \",\"), nil\n    default:\n        b, err := json.Marshal(v)\n        if err != nil {\n            return \"\", err\n        }\n        return string(b), nil\n    }\n}\n\nfunc hookBuiltins(rt *Runtime) map[string]string {\n    return map[string]string{\n        \"FLOWR_RUN_ID\":    rt.runID,\n        \"FLOWR_WORKFLOW\":  rt.workflowFile,\n    }\n}\n\nfunc stepBuiltins(es *ExpandedStep) map[string]string {\n    b := map[string]string{}\n    if es.MatrixAxes != nil {\n        for k, v := range es.MatrixAxes {\n            b[\"FLOWR_MATRIX_\"+k] = v\n        }\n    }\n    if es.ForeachIdx != nil {\n        b[\"FLOWR_FOREACH_IDX\"] = strconv.Itoa(*es.ForeachIdx)\n    }\n    if es.ForeachItem != nil {\n        b[\"FLOWR_FOREACH_ITEM\"] = *es.ForeachItem\n    }\n    return b\n}\n\nfunc envToSlice(m map[string]string) []string {\n    keys := so"]
