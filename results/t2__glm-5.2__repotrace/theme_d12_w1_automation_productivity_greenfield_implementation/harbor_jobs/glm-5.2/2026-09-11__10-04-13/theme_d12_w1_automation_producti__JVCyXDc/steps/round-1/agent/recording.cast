[4670.419893, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4670.419945, "o", "\u001b[?2004h> "]
[4670.420149, "o", "    rp := RetryPolicy{Backoff: \"fixed\", InitialMs: 100, MaxMs: 0, Jitter: false}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.420274, "o", "    if v, ok := m[\"count\"]; !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.420476, "o", "        return RetryPolicy{}, fmt.Errorf(\"retry.count is required\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.420532, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.420666, "o", "        c, err := toInt(\"retry.count\", v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.420757, "o", "        if err != nil {\r\n\u001b[?2004l\r s, \u001b[?2004h"]
[4670.420812, "o", "> "]
[4670.420865, "o", "            return RetryPolicy{}, err\r\n\u001b[?2004l\r"]
[4670.420918, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.420993, "o", "        if c < 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.421213, "o", "            return RetryPolicy{}, fmt.Errorf(\"retry.count must be >= 0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.421291, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.421355, "o", "        rp.Count = c\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4670.421406, "o", "\u001b[?2004h> "]
[4670.421488, "o", "    if v, ok := m[\"backoff\"]; ok {\r\n\u001b[?2004l\ry)\u001b[?2004h> "]
[4670.42162, "o", "        b, err := toString(\"retry.backoff\", v)\r\n\u001b[?2004l\r"]
[4670.421682, "o", "\u001b[?2004h> "]
[4670.421734, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.421835, "o", "            return RetryPolicy{}, err\r\n\u001b[?2004l\r"]
[4670.421888, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.42208, "o", "        if b != \"fixed\" && b != \"linear\" && b != \"exponential\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.422344, "o", "            return RetryPolicy{}, fmt.Errorf(\"retry.backoff must be fixed, linear, or exponential\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.422414, "o", "        }\r\n\u001b[?2004l\r \u001b[?2004h> "]
[4670.422478, "o", "        rp.Backoff = b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.422533, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.422621, "o", "    if v, ok := m[\"initial_ms\"]; ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.422765, "o", "        i, err := toInt(\"retry.initial_ms\", v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.422858, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.422984, "o", "            return RetryPolicy{}, err\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[4670.423043, "o", "        }\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[4670.423093, "o", "        if i < 0 {\r\n\u001b[?2004l\r"]
[4670.423144, "o", "\u001b[?2004h> "]
[4670.42331, "o", "            return RetryPolicy{}, fmt.Errorf(\"retry.initial_ms must be >= 0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.42338, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.423431, "o", "        rp.InitialMs = i\r\n\u001b[?2004l\r"]
[4670.423484, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.423608, "o", "    if v, ok := m[\"max_ms\"]; ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.423732, "o", "        i, err := toInt(\"retry.max_ms\", v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.42382, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.423958, "o", "            return RetryPolicy{}, err\r\n\u001b[?2004l\rr\u001b[?2004h> "]
[4670.424016, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.424071, "o", "        if i < 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.424276, "o", "            return RetryPolicy{}, fmt.Errorf(\"retry.max_ms must be >= 0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.424353, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.424409, "o", "        rp.MaxMs = i\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4670.424461, "o", "\u001b[?2004h> "]
[4670.424511, "o", "    if v, ok := m[\"jitter\"]; ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.42459, "o", "        b, err := toBool(\"retry.jitter\", v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.424641, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[4670.424692, "o", "\u001b[?2004h> "]
[4670.424743, "o", "            return RetryPolicy{}, err\r\n\u001b[?2004l\r"]
[4670.424794, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.424843, "o", "        rp.Jitter = b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.424893, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.424945, "o", "    return rp, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.424995, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.425079, "o", "func parseMatrix(v any) (map[string][]string, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.425153, "o", "    m, ok := v.(map[string]any)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.425206, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.425314, "o", "        return nil, fmt.Errorf(\"matrix must be a mapping\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.425379, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.425431, "o", "    out := map[string][]string{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.425483, "o", "    for k, vv := range m {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.425618, "o", "        vals, err := toStringList(fmt.Sprintf(\"matrix.%s\", k), vv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.425674, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.425745, "o", "            return nil, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.425798, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.425848, "o", "        if len(vals) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.426018, "o", "            return nil, fmt.Errorf(\"matrix axis %s must have at least one value\", k)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.42608, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.426133, "o", "        out[k] = vals\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4670.426183, "o", "\u001b[?2004h>     return out, nil\r\n\u001b[?2004l\r"]
[4670.426233, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4670.426283, "o", "\u001b[?2004h> "]
[4670.426344, "o", "func parseForeach(v any) (ForeachSpec, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.426423, "o", "    m, ok := v.(map[string]any)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.426475, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.426602, "o", "        return ForeachSpec{}, fmt.Errorf(\"foreach must be a mapping\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.426664, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.426716, "o", "    for k := range m {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.426768, "o", "        if k != \"items\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.4269, "o", "            return ForeachSpec{}, fmt.Errorf(\"unknown foreach field: %s\", k)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.42696, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427012, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427063, "o", "    if _, ok := m[\"items\"]; !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427179, "o", "        return ForeachSpec{}, fmt.Errorf(\"foreach.items is required\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427235, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427308, "o", "    return ForeachSpec{Items: m[\"items\"]}, nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[4670.427369, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427463, "o", "func toString(field string, v any) (string, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427525, "o", "    switch x := v.(type) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427588, "o", "    case string:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427651, "o", "        return x, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427702, "o", "    case int:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427753, "o", "        return strconv.Itoa(x), nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427803, "o", "    case int64:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427895, "o", "        return strconv.FormatInt(x, 10), nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.427951, "o", "    case bool:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.428, "o", "        if x {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.428051, "o", "            return \"true\", nil\r\n\u001b[?2004l\r"]
[4670.428101, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.428149, "o", "        return \"false\", nil\r\n\u001b[?2004l\r"]
[4670.428199, "o", "\u001b[?2004h>     case float64:\r\n\u001b[?2004l\r"]
[4670.42825, "o", "\u001b[?2004h> "]
[4670.428346, "o", "        return strconv.FormatFloat(x, 'f', -1, 64), nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.428413, "o", "    default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.428478, "o", "        return \"\", fmt.Errorf(\"%s must be a string\", field)\r\n\u001b[?2004l\r"]
[4670.42853, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4670.428581, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.428687, "o", "func toNonEmptyString(field string, v any) (string, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.428762, "o", "    s, err := toString(field, v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.428815, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.428868, "o", "        return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.428917, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.428967, "o", "    if s == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.429041, "o", "        return \"\", fmt.Errorf(\"%s must be non-empty\", field)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.429094, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     return s, nil\r\n\u001b[?2004l\r"]
[4670.429144, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.429226, "o", "func toInt(field string, v any) (int, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.429279, "o", "    switch x := v.(type) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.42934, "o", "    case int:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.429391, "o", "        return x, nil\r\n\u001b[?2004l\r\u001b[?2004h>     case int64:\r\n\u001b[?2004l\r"]
[4670.429443, "o", "\u001b[?2004h> "]
[4670.429496, "o", "        return int(x), nil\r\n\u001b[?2004l\r\u001b[?2004h>     case string:\r\n\u001b[?2004l\r"]
[4670.429546, "o", "\u001b[?2004h> "]
[4670.429596, "o", "        i, err := strconv.Atoi(strings.TrimSpace(x))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.429645, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.42975, "o", "            return 0, fmt.Errorf(\"%s must be an integer\", field)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.429804, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.429856, "o", "        return i, nil\r\n\u001b[?2004l\r\u001b[?2004h>     default:\r\n\u001b[?2004l\r"]
[4670.429908, "o", "\u001b[?2004h> "]
[4670.429959, "o", "        return 0, fmt.Errorf(\"%s must be an integer\", field)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4670.430007, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4670.430058, "o", "\u001b[?2004h> "]
[4670.430109, "o", "func toBool(field string, v any) (bool, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.43016, "o", "    switch x := v.(type) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.430212, "o", "    case bool:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.430263, "o", "        return x, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.430314, "o", "    case string:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.430393, "o", "        b, err := strconv.ParseBool(strings.TrimSpace(x))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.430446, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.430567, "o", "            return false, fmt.Errorf(\"%s must be a boolean\", field)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4670.430621, "o", "\u001b[?2004h>         return b, nil\r\n\u001b[?2004l\r"]
[4670.430674, "o", "\u001b[?2004h>     default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.430773, "o", "        return false, fmt.Errorf(\"%s must be a boolean\", field)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.430831, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.430933, "o", "func toStringList(field string, v any) ([]string, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.430987, "o", "    arr, ok := v.([]any)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.431037, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.431141, "o", "        return nil, fmt.Errorf(\"%s must be a sequence\", field)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.431195, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     var out []string\r\n\u001b[?2004l\r"]
[4670.431242, "o", "\u001b[?2004h> "]
[4670.43129, "o", "    for i, item := range arr {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.43139, "o", "        s, err := toString(fmt.Sprintf(\"%s[%d]\", field, i), item)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.431442, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.431491, "o", "            return nil, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.431539, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.431587, "o", "        out = append(out, s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.431635, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.431684, "o", "    return out, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.431802, "o", "func toStringMap(field string, v any) (map[string]string, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.431855, "o", "    m, ok := v.(map[string]any)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4670.431903, "o", ">     if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.432001, "o", "        return nil, fmt.Errorf(\"%s must be a mapping\", field)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.432052, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.432099, "o", "    out := map[string]string{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.432147, "o", "    for k, vv := range m {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.432244, "o", "        s, err := toString(fmt.Sprintf(\"%s.%s\", field, k), vv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4670.432308, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
