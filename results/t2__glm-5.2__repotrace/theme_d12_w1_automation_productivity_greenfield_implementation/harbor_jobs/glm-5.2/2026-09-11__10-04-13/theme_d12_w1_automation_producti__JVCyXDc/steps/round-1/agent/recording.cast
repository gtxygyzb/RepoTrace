[4731.059186, "o", "> "]
[4731.059196, "o", "    if s[0] == '-' || s[0] == '+' {\r\n\u001b[?2004l\r"]
[4731.059245, "o", "\u001b[?2004h>         s = s[1:]\r\n\u001b[?2004l\r"]
[4731.059255, "o", "\u001b[?2004h> "]
[4731.059304, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     if s == \"\" {\r\n\u001b[?2004l\r"]
