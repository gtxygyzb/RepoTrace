[4731.0415, "o", "func validateStepOutputRefs(wf *Workflow, s Step) error {\r\n\u001b[?2004l\r"]
[4731.041553, "o", "\u001b[?2004h> "]
[4731.041627, "o", "    refs := []string{}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.041677, "o", "> "]
[4731.041833, "o", "    refs = append(refs, extractStepRefs(s.Cmd)...)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.041883, "o", "> "]
[4731.041976, "o", "    for _, p := range s.Pipe {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.042025, "o", "> "]
