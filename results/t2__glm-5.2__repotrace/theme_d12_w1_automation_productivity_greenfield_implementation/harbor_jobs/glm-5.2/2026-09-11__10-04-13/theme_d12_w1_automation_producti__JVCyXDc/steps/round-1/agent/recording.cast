[4731.010438, "i", "ngs.TrimSpace(s)\n    if !strings.HasPrefix(s, \"${step.\") || !strings.HasSuffix(s, \"}\") {\n        return stepRef{}, fmt.Errorf(\"invalid step output reference\")\n    }\n    inner := s[2 : len(s)-1]\n    parts := strings.SplitN(inner, \".\", 4)\n    if len(parts) != 4 || parts[0] != \"step\" || parts[2] != \"output\" {\n        return stepRef{}, fmt.Errorf(\"invalid step output reference\")\n    }\n    return stepRef{Name: parts[1], Key: parts[3]}, nil\n}\n\nfunc extractStepRefs(s string) []string {\n    var refs []string\n    for _, m := range varRefRe.FindAllString(s, -1) {\n        inner := m[2 : len(m)-1]\n        if strings.HasPrefix(inner, \"step.\") && strings.Contains(inner, \".output.\") {\n            refs = append(refs, m)\n        }\n    }\n    return refs\n}\n\nfunc validateWhenSyntax(expr string) error {\n    e := strings.TrimSpace(expr)\n    if strings.ContainsRune(e, 0) {\n        return fmt.Errorf(\"invalid when expression: %s\", expr)\n    }\n    if e == \"true\" || e == \"false\" {\n        return nil\n    }\n    for _, op := range []strin"]
