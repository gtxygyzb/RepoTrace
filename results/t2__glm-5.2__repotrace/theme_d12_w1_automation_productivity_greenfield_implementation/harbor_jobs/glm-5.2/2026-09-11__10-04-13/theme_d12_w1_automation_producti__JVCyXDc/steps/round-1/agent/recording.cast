[4034.481764, "i", "t {\n\tName string\n\tKey  string\n}\n\nfunc parseWorkflowBytes(data []byte) (*Workflow, error) {\n\tvar doc map[string]any\n\tdec := yaml.NewDecoder(bytes.NewReader(data))\n\tif err := dec.Decode(&doc); err != nil {\n\t\treturn nil, err\n\t}\n\twf := &Workflow{}\n\tif envAny, ok := doc[\"env\"]; ok {\n\t\tenv, err := toStringMap(\"env\", envAny)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\twf.Env = env\n\t}\n\tif hooksAny, ok := doc[\"hooks\"]; ok {\n\t\thooks, err := parseHooks(hooksAny)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\twf.Hooks = hooks\n\t}\n\tif stepsAny, ok := doc[\"steps\"]; ok {\n\t\tsteps, err := parseSteps(stepsAny)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\twf.Steps = steps\n\t}\n\treturn wf, nil\n}\n\nfunc parseHooks(v any) (map[string]string, error) {\n\tm, ok := v.(map[string]any)\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"hooks must be a mapping\")\n\t}\n\tallowed := map[string]bool{\"on_start\": true, \"on_success\": true, \"on_failure\": true}\n\tout := map[string]string{}\n\tfor k, vv := range m {\n\t\tif !allowed[k] {\n\t\t\treturn nil, fmt.Errorf(\"unknown hook: %s\","]
