[4731.044143, "o", "> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[4731.044376, "o", "func checkStepRef(wf *Workflow, s *Step, ref stepRef) error {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.044425, "o", "> "]
[4731.044551, "o", "    if _, ok := findStep(wf, ref.Name); !ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.0446, "o", "> "]
[4731.044818, "o", "        return fmt.Errorf(\"unknown step reference: %s\", ref.Name)\r\n\u001b[?2004l\r"]
[4731.044867, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\re"]
[4731.044916, "o", "\u001b[?2004h> "]
[4731.045052, "o", "    if !outputKeyRe.MatchString(ref.Key) {\r\n\u001b[?2004l\r"]
[4731.045103, "o", "\u001b[?2004h> "]
[4731.045333, "o", "        return fmt.Errorf(\"invalid step output key: %s\", ref.Key)\r\n\u001b[?2004l\r"]
[4731.045384, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\rop\u001b[?2004h"]
[4731.045433, "o", "> "]
[4731.045557, "o", "    prod := findStepByName(wf, ref.Name)\r\n\u001b[?2004l\r"]
[4731.045606, "o", "\u001b[?2004h> "]
[4731.045671, "o", "    if prod == nil {\r\n\u001b[?2004l\r"]
[4731.045721, "o", "\u001b[?2004h> "]
[4731.045957, "o", "        return fmt.Errorf(\"unknown step reference: %s\", ref.Name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.046006, "o", ">     }\r\n\u001b[?2004l\r"]
[4731.046056, "o", "\u001b[?2004h> "]
[4731.046142, "o", "    if prod.Foreach != nil {\r\n\u001b[?2004l\r"]
[4731.046192, "o", "\u001b[?2004h> "]
[4731.046462, "o", "        return fmt.Errorf(\"step output reference to foreach step is invalid\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.046514, "o", ">     }\r\n\u001b[?2004l\r  "]
[4731.046563, "o", "\u001b[?2004h> "]
[4731.046712, "o", "    if prod.Matrix != nil && s.Matrix != nil {\r\n\u001b[?2004l\r"]
[4731.046761, "o", "\u001b[?2004h> "]
[4731.046905, "o", "        if !sameAxes(prod.Matrix, s.Matrix) {\r\n\u001b[?2004l\r"]
[4731.046956, "o", "\u001b[?2004h> "]
[4731.047175, "o", "            return fmt.Errorf(\"step output reference requires same matrix axes\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.047224, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.047404, "o", "    } else if prod.Matrix != nil || s.Matrix != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.047643, "o", "        return fmt.Errorf(\"step output reference requires same matrix axes\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.047697, "o", "    }\r\n\u001b[?2004l\ru\u001b[?2004h> "]
[4731.047812, "o", "    if !transitivelyNeeds(s, ref.Name, wf) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.048056, "o", "        return fmt.Errorf(\"step output reference requires needs: %s\", ref.Name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.048112, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.04817, "o", "    return nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\ret\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4731.048242, "o", "u\u001b[?2004h> "]
[4731.048398, "o", "func transitivelyNeeds(s *Step, target string, wf *Workflow) bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.048505, "o", "    visited := map[string]bool{}\r\n\u001b[?2004l\r"]
[4731.048554, "o", "\u001b[?2004h> "]
[4731.04862, "o", "    var rec func(step *Step) bool\r\n\u001b[?2004l\r"]
[4731.048665, "o", "\u001b[?2004h> "]
[4731.048721, "o", "    rec = func(step *Step) bool {\r\n\u001b[?2004l\r"]
[4731.048751, "o", "\u001b[?2004h> "]
[4731.048841, "o", "        for _, n := range step.Needs {\r\n\u001b[?2004l\r"]
[4731.048868, "o", "\u001b[?2004h> "]
[4731.048936, "o", "            if n == target {\r\n\u001b[?2004l\r"]
[4731.048966, "o", "\u001b[?2004h> "]
[4731.049034, "o", "                return true\r\n\u001b[?2004l\r"]
[4731.049062, "o", "\u001b[?2004h> "]
[4731.049093, "o", "            }\r\n\u001b[?2004l\r"]
[4731.04912, "o", "\u001b[?2004h> "]
[4731.04919, "o", "            if visited[n] {\r\n\u001b[?2004l\r"]
[4731.049224, "o", "\u001b[?2004h> "]
[4731.049278, "o", "                continue\r\n\u001b[?2004l\r"]
[4731.04931, "o", "\u001b[?2004h> "]
[4731.049352, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.049434, "o", "            visited[n] = true\r\n\u001b[?2004l\r"]
[4731.049466, "o", "\u001b[?2004h> "]
[4731.049602, "o", "            if ns, ok := findStep(wf, n); ok && rec(ns) {\r\n\u001b[?2004l\r"]
[4731.049629, "o", "\u001b[?2004h> "]
[4731.049673, "o", "                return true\r\n\u001b[?2004l\r"]
[4731.049703, "o", "\u001b[?2004h> "]
[4731.049733, "o", "            }\r\n\u001b[?2004l\r"]
[4731.049762, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4731.049794, "o", "\u001b[?2004h> "]
[4731.049821, "o", "        return false\r\n\u001b[?2004l\r"]
[4731.049851, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4731.049883, "o", "\u001b[?2004h>     return rec(s)\r\n\u001b[?2004l\r"]
[4731.049914, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4731.049945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.050063, "o", "func sameAxes(a, b map[string][]string) bool {\r\n\u001b[?2004l\r"]
[4731.050074, "o", "\u001b[?2004h> "]
[4731.050139, "o", "    if len(a) != len(b) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.05015, "o", "> "]
[4731.050199, "o", "        return false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.05024, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.050295, "o", "    for k, av := range a {\r\n\u001b[?2004l\r"]
[4731.050305, "o", "\u001b[?2004h> "]
[4731.050363, "o", "        bv, ok := b[k]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.050444, "o", "        if !ok || len(av) != len(bv) {\r\n\u001b[?2004l\r"]
[4731.050455, "o", "\u001b[?2004h> "]
[4731.050504, "o", "            return false\r\n\u001b[?2004l\r"]
[4731.050514, "o", "\u001b[?2004h> "]
[4731.050561, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.050612, "o", "        for i := range av {\r\n\u001b[?2004l\r"]
[4731.050654, "o", "\u001b[?2004h> "]
[4731.050696, "o", "            if av[i] != bv[i] {\r\n\u001b[?2004l\r"]
[4731.050707, "o", "\u001b[?2004h> "]
[4731.05077, "o", "                return false\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.05078, "o", "> "]
[4731.050831, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.050842, "o", "        }\r\n\u001b[?2004l\r"]
[4731.050892, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.05093, "o", "    return true\r\n\u001b[?2004l\r"]
[4731.05094, "o", "\u001b[?2004h> }\r\n"]
[4731.050989, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.051071, "o", "func detectCycles(wf *Workflow) error {\r\n\u001b[?2004l\r"]
[4731.051081, "o", "\u001b[?2004h> "]
[4731.051146, "o", "    visited := map[string]int{}\r\n\u001b[?2004l\r"]
[4731.051156, "o", "\u001b[?2004h> "]
[4731.051222, "o", "    var visit func(*Step) error\r\n\u001b[?2004l\r"]
[4731.051232, "o", "\u001b[?2004h> "]
[4731.051301, "o", "    visit = func(s *Step) error {\r\n\u001b[?2004l\r"]
[4731.051312, "o", "\u001b[?2004h> "]
[4731.051383, "o", "        if visited[s.Name] == 1 {\r\n\u001b[?2004l\r"]
[4731.051394, "o", "\u001b[?2004h> "]
[4731.051488, "o", "            return fmt.Errorf(\"cycle detected\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.05153, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.051541, "o", "> "]
[4731.051606, "o", "        if visited[s.Name] == 2 {\r\n\u001b[?2004l\r"]
[4731.051617, "o", "\u001b[?2004h> "]
[4731.05167, "o", "            return nil\r\n\u001b[?2004l\r"]
[4731.05168, "o", "\u001b[?2004h> "]
[4731.051729, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.051775, "o", "        visited[s.Name] = 1\r\n\u001b[?2004l\r"]
[4731.051786, "o", "\u001b[?2004h> "]
[4731.051856, "o", "        for _, n := range s.Needs {\r\n\u001b[?2004l\r"]
[4731.051867, "o", "\u001b[?2004h> "]
[4731.051945, "o", "            ns, ok := findStep(wf, n)\r\n\u001b[?2004l\r"]
[4731.051955, "o", "\u001b[?2004h> "]
[4731.052004, "o", "            if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.052063, "o", "                continue\r\n\u001b[?2004l\r"]
[4731.052073, "o", "\u001b[?2004h> "]
[4731.052123, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.052208, "o", "            if err := visit(ns); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.052219, "o", "> "]
[4731.052267, "o", "                return err\r\n\u001b[?2004l\r"]
[4731.052306, "o", "\u001b[?2004h> "]
[4731.052317, "o", "            }\r\n\u001b[?2004l\r"]
[4731.052375, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.05243, "o", "        visited[s.Name] = 2\r\n\u001b[?2004l\r"]
[4731.05244, "o", "\u001b[?2004h> "]
[4731.052489, "o", "        return nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.052533, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.052586, "o", "    for i := range wf.Steps {\r\n\u001b[?2004l\r"]
[4731.052597, "o", "\u001b[?2004h> "]
[4731.052698, "o", "        if err := visit(&wf.Steps[i]); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.052709, "o", "> "]
[4731.052755, "o", "            return err\r\n\u001b[?2004l\r"]
[4731.052766, "o", "\u001b[?2004h> "]
[4731.052817, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.052827, "o", "    }\r\n\u001b[?2004l\r"]
[4731.052874, "o", "\u001b[?2004h>     return nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.052918, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.053033, "o", "func findStep(wf *Workflow, name string) (*Step, bool) {\r\n\u001b[?2004l\r"]
[4731.053043, "o", "\u001b[?2004h> "]
[4731.053106, "o", "    for i := range wf.Steps {\r\n\u001b[?2004l\r"]
[4731.053116, "o", "\u001b[?2004h> "]
[4731.053191, "o", "        if wf.Steps[i].Name == name {\r\n\u001b[?2004l\r"]
[4731.053201, "o", "\u001b[?2004h> "]
[4731.053279, "o", "            return &wf.Steps[i], true\r\n\u001b[?2004l\r"]
[4731.053289, "o", "\u001b[?2004h> "]
[4731.053348, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4731.053358, "o", "\u001b[?2004h> "]
[4731.05341, "o", "    return nil, false\r\n\u001b[?2004l\r"]
[4731.05342, "o", "\u001b[?2004h> "]
[4731.05347, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.05357, "o", "func findStepByName(wf *Workflow, name string) *Step {\r\n\u001b[?2004l\r"]
[4731.053581, "o", "\u001b[?2004h> "]
[4731.053674, "o", "    s, ok := findStep(wf, name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.053704, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[4731.053733, "o", "\u001b[?2004h>         return nil\r\n\u001b[?2004l\r"]
[4731.053764, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4731.053793, "o", "\u001b[?2004h> "]
[4731.053823, "o", "    return s\r\n\u001b[?2004l\r"]
[4731.05385, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4731.053862, "o", "\u001b[?2004h"]
[4731.053917, "o", "> "]
[4731.053958, "o", "func isStepOutputRef(s string) bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.054098, "o", "    return strings.HasPrefix(s, \"step.\") && strings.Contains(s, \".output.\")\r\n\u001b[?2004l\r"]
[4731.054108, "o", "\u001b[?2004h> "]
[4731.054157, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.054255, "o", "func parseStepOutputRef(s string) (stepRef, error) {\r\n\u001b[?2004l\r"]
[4731.054265, "o", "\u001b[?2004h> "]
[4731.054331, "o", "    s = strings.TrimSpace(s)\r\n\u001b[?2004l\r"]
[4731.054342, "o", "\u001b[?2004h> "]
[4731.054473, "o", "    if !strings.HasPrefix(s, \"${step.\") || !strings.HasSuffix(s, \"}\") {\r\n\u001b[?2004l\r"]
[4731.054484, "o", "\u001b[?2004h> "]
[4731.054612, "o", "        return stepRef{}, fmt.Errorf(\"invalid step output reference\")\r\n\u001b[?2004l\r"]
[4731.054622, "o", "\u001b[?2004h> "]
[4731.054672, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.054727, "o", "    inner := s[2 : len(s)-1]\r\n\u001b[?2004l\r"]
[4731.054738, "o", "\u001b[?2004h> "]
[4731.054822, "o", "    parts := strings.SplitN(inner, \".\", 4)\r\n\u001b[?2004l\r"]
[4731.054833, "o", "\u001b[?2004h> "]
[4731.054965, "o", "    if len(parts) != 4 || parts[0] != \"step\" || parts[2] != \"output\" {\r\n\u001b[?2004l\r"]
[4731.054976, "o", "\u001b[?2004h> "]
[4731.055102, "o", "        return stepRef{}, fmt.Errorf(\"invalid step output reference\")\r\n\u001b[?2004l\r"]
[4731.055113, "o", "\u001b[?2004h> "]
[4731.055159, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.05525, "o", "    return stepRef{Name: parts[1], Key: parts[3]}, nil\r\n\u001b[?2004l\r"]
[4731.05526, "o", "\u001b[?2004h> "]
[4731.055308, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.05539, "o", "func extractStepRefs(s string) []string {\r\n\u001b[?2004l\r"]
[4731.055401, "o", "\u001b[?2004h> "]
[4731.055451, "o", "    var refs []string\r\n\u001b[?2004l\r"]
[4731.055461, "o", "\u001b[?2004h> "]
[4731.055561, "o", "    for _, m := range varRefRe.FindAllString(s, -1) {\r\n\u001b[?2004l\r"]
[4731.055572, "o", "\u001b[?2004h> "]
[4731.05564, "o", "        inner := m[2 : len(m)-1]\r\n\u001b[?2004l\r"]
[4731.05565, "o", "\u001b[?2004h> "]
[4731.055807, "o", "        if strings.HasPrefix(inner, \"step.\") && strings.Contains(inner, \".output.\") {\r\n\u001b[?2004l\r"]
[4731.055818, "o", "\u001b[?2004h> "]
[4731.055887, "o", "            refs = append(refs, m)\r\n\u001b[?2004l\r"]
[4731.055898, "o", "\u001b[?2004h> "]
[4731.055946, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4731.05599, "o", "\u001b[?2004h> "]
[4731.056, "o", "    return refs\r\n\u001b[?2004l\r"]
[4731.056051, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4731.05606, "o", "\u001b[?2004h> "]
[4731.056145, "o", "func validateWhenSyntax(expr string) error {\r\n\u001b[?2004l\r"]
[4731.056156, "o", "\u001b[?2004h> "]
[4731.056222, "o", "    e := strings.TrimSpace(expr)\r\n\u001b[?2004l\r"]
[4731.056232, "o", "\u001b[?2004h> "]
[4731.056304, "o", "    if strings.ContainsRune(e, 0) {\r\n\u001b[?2004l\r"]
[4731.056315, "o", "\u001b[?2004h> "]
[4731.056443, "o", "        return fmt.Errorf(\"invalid when expression: %s\", expr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.056485, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.056554, "o", "    if e == \"true\" || e == \"false\" {\r\n\u001b[?2004l\r"]
[4731.056565, "o", "\u001b[?2004h> "]
[4731.056614, "o", "        return nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.056657, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.056775, "o", "    for _, op := range []string{\"==\", \"!=\", \"<=\", \">=\", \"<\", \">\"} {\r\n\u001b[?2004l\r"]
[4731.056786, "o", "\u001b[?2004h> "]
[4731.05688, "o", "        if idx := strings.Index(e, op); idx > 0 {\r\n\u001b[?2004l\r"]
[4731.056891, "o", "\u001b[?2004h> "]
[4731.056979, "o", "            lhs := strings.TrimSpace(e[:idx])\r\n\u001b[?2004l\r"]
[4731.056989, "o", "\u001b[?2004h> "]
[4731.057093, "o", "            rhs := strings.TrimSpace(e[idx+len(op):])\r\n\u001b[?2004l\r"]
[4731.057103, "o", "\u001b[?2004h> "]
[4731.057183, "o", "            if lhs == \"\" || rhs == \"\" {\r\n\u001b[?2004l\r"]
[4731.057193, "o", "\u001b[?2004h> "]
[4731.057243, "o", "                break\r\n\u001b[?2004l\r"]
[4731.057253, "o", "\u001b[?2004h> "]
[4731.057303, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.057381, "o", "            if op == \"==\" || op == \"!=\" {\r\n\u001b[?2004l\r"]
[4731.057392, "o", "\u001b[?2004h> "]
[4731.057518, "o", "                if validWhenOperand(lhs) && validWhenOperand(rhs) {\r\n\u001b[?2004l\r"]
[4731.057529, "o", "\u001b[?2004h> "]
[4731.057593, "o", "                    return nil\r\n\u001b[?2004l\r"]
[4731.057603, "o", "\u001b[?2004h> "]
[4731.057652, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.057702, "o", "            } else {\r\n\u001b[?2004l\r"]
[4731.057713, "o", "\u001b[?2004h> "]
[4731.057826, "o", "                if isIntLiteral(lhs) && isIntLiteral(rhs) {\r\n\u001b[?2004l\r"]
[4731.057837, "o", "\u001b[?2004h> "]
[4731.057903, "o", "                    return nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.05795, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.057961, "o", "> "]
[4731.058009, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.058049, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.058059, "o", "        }\r\n\u001b[?2004l\r"]
[4731.058109, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.058184, "o", "    return fmt.Errorf(\"invalid when expression: %s\", expr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.058195, "o", "}\r\n\u001b[?2004l\r"]
[4731.058243, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.058292, "o", "func validWhenOperand(s string) bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.058368, "o", "    if s == \"true\" || s == \"false\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.058411, "o", "        return false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.05845, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.058537, "o", "    if len(s) >= 2 && s[0] == '\\'' && s[len(s)-1] == '\\'' {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.0586, "o", "        inner := s[1 : len(s)-1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.058612, "o", "> "]
[4731.058663, "o", "        if inner == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.058707, "o", "            return false\r\n\u001b[?2004l\r"]
[4731.058717, "o", "\u001b[?2004h> "]
[4731.058767, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.058828, "o", "        return !strings.ContainsRune(inner, '\\'')\r\n\u001b[?2004l\r\u001b[?2004h> "]
