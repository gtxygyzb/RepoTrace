[41.604236, "o", "\r\n\t\"gopkg.in/yaml.v3\"\r\n)\r\n\r\n// flowr is a workflow orchestrator. This is only the starter skeleton: it\r\n// compiles and runs, but no subcommands are implemented yet. Implementing the\r\n// CLI described in the round instructions (parsing the YAML workflow, running\r\n// the step DAG, the run report, the append-only event log, etc.) is the task.\r\n//\r\n// The flowr module already depends on gopkg.in/yaml.v3; the helper below keeps\r\n// that dependency referenced so the module graph and the pre-warmed offline\r\n// build cache stay consistent for the agent's own build.\r\nfunc parseWorkflow(data []byte) (map[string]any, error) {\r\n\tvar doc map[string]any\r\n\tif err := yaml.Unmarshal(data, &doc); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn doc, nil\r\n}\r\n"]
[41.604311, "o", "\r\nfunc main() {\r\n\t_ = parseWorkflow\r\n\tif len(os.Args) > 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"flowr: subcommand %q is not implemented yet\\n\", os.Args[1])\r\n\t} else {\r\n\t\tfmt.Fprintln(os.Stderr, \"flowr: not implemented yet\")\r\n\t}\r\n\tos.Exit(1)\r\n}\r\n"]
[41.604789, "o", "\u001b[?2004h"]
[41.604849, "o", "root@n30009:/app# "]
