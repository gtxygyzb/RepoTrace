[4731.042708, "o", "\u001b[?2004h> "]
[4731.04286, "o", "    refs = append(refs, extractStepRefs(s.When)...)\r\n\u001b[?2004l\r"]
[4731.042909, "o", "\u001b[?2004h> "]
