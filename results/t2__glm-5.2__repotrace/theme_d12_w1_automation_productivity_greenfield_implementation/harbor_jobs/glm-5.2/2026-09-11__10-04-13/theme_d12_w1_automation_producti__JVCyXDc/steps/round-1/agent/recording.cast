[4670.37664, "i", "cat > cmd/flowr/parse.go <<'EOF'\npackage main\n\nimport (\n    \"bytes\"\n    \"fmt\"\n    \"strconv\"\n    \"strings\"\n\n    \"gopkg.in/yaml.v3\"\n)\n\nfunc parseWorkflowBytes(data []byte) (*Workflow, error) {\n    var doc map[string]any\n    dec := yaml.NewDecoder(bytes.NewReader(data))\n    if err := dec.Decode(&doc); err != nil {\n        return nil, err\n    }\n    wf := &Workflow{}\n    if envAny, ok := doc[\"env\"]; ok {\n        env, err := toStringMap(\"env\", envAny)\n        if err != nil {\n            return nil, err\n        }\n        wf.Env = env\n    }\n    if hooksAny, ok := doc[\"hooks\"]; ok {\n        hooks, err := parseHooks(hooksAny)\n        if err != nil {\n            return nil, err\n        }\n        wf.Hooks = hooks\n    }\n    if stepsAny, ok := doc[\"steps\"]; ok {\n        steps, err := parseSteps(stepsAny)\n        if err != nil {\n            return nil, err\n        }\n        wf.Steps = steps\n    }\n    return wf, nil\n}\n\nfunc parseHooks(v any) (map[string]string, error) {\n    m, ok := v.(map[string]any)\n    if !ok {\n        re"]
[4670.376934, "i", "turn nil, fmt.Errorf(\"hooks must be a mapping\")\n    }\n    allowed := map[string]bool{\"on_start\": true, \"on_success\": true, \"on_failure\": true}\n    out := map[string]string{}\n    for k, vv := range m {\n        if !allowed[k] {\n            return nil, fmt.Errorf(\"unknown hook: %s\", k)\n        }\n        s, err := toNonEmptyString(fmt.Sprintf(\"hooks.%s\", k), vv)\n        if err != nil {\n            return nil, err\n        }\n        if strings.ContainsRune(s, 0) {\n            return nil, fmt.Errorf(\"hook %s must not contain NUL bytes\", k)\n        }\n        out[k] = s\n    }\n    return out, nil\n}\n\nfunc parseSteps(v any) ([]Step, error) {\n    arr, ok := v.([]any)\n    if !ok {\n        return nil, fmt.Errorf(\"steps must be a sequence\")\n    }\n    var out []Step\n    for i, item := range arr {\n        s, err := parseStep(item, i)\n        if err != nil {\n            return nil, err\n        }\n        out = append(out, s)\n    }\n    return out, nil\n}\n\nfunc parseStep(v any, idx int) (Step, error) {\n    m, ok := v.(map[string]an"]
