[4731.038771, "o", "> "]
[4731.038893, "o", "    prod := findStepByName(wf, ref.Name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.038944, "o", "> "]
[4731.038993, "o", "    if prod == nil {\r\n\u001b[?2004l\rO"]
[4731.039043, "o", "\u001b[?2004h> "]
[4731.03926, "o", "        return fmt.Errorf(\"unknown step reference: %s\", ref.Name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.039314, "o", ">     }\r\n\u001b[?2004l\rt\u001b[?2004h"]
[4731.039374, "o", "> "]
[4731.039523, "o", "    if prod.Matrix != nil || prod.Foreach != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.039573, "o", "> "]
[4731.039874, "o", "        return fmt.Errorf(\"foreach items step reference must be a non-matrix non-foreach step\")\r\n\u001b[?2004l\r"]
[4731.039924, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4731.039973, "o", "\u001b[?2004h> "]
[4731.040023, "o", "    found := false\r\n\u001b[?2004l\r"]
[4731.040072, "o", "\u001b[?2004h> "]
[4731.04018, "o", "    for _, n := range s.Needs {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.04023, "o", "> "]
[4731.040309, "o", "        if n == ref.Name {\r\n\u001b[?2004l\ri\u001b[?2004h"]
[4731.040364, "o", "> "]
[4731.040435, "o", "            found = true\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.040485, "o", "> "]
[4731.040534, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.040584, "o", ">         }\r\n\u001b[?2004l\r"]
[4731.040634, "o", "\u001b[?2004h> "]
[4731.040683, "o", "    }\r\n\u001b[?2004l\r-1\u001b[?2004h> "]
[4731.040732, "o", "    if !found {\r\n\u001b[?2004l\r"]
[4731.040781, "o", "\u001b[?2004h> "]
[4731.041046, "o", "        return fmt.Errorf(\"step output reference requires needs: %s\", ref.Name)\r\n\u001b[?2004l\r"]
[4731.041096, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4731.041146, "o", "\u001b[?2004h> "]
[4731.041197, "o", "    return nil\r\n\u001b[?2004l\r"]
[4731.041248, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
