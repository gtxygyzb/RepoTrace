[4731.038201, "o", "func checkForeachOutputRef(wf *Workflow, s *Step, ref stepRef) error {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.03825, "o", "> "]
[4731.038393, "o", "    if _, ok := findStep(wf, ref.Name); !ok {\r\n\u001b[?2004l\r"]
[4731.038444, "o", "\u001b[?2004h> "]
[4731.038672, "o", "        return fmt.Errorf(\"unknown step reference: %s\", ref.Name)\r\n\u001b[?2004l\r\u001b[?2004h"]
