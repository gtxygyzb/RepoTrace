[4670.075587, "i", "cat > cmd/flowr/main.go <<'EOF'\npackage main\n\nimport (\n    \"fmt\"\n    \"os\"\n)\n\nfunc main() {\n    if len(os.Args) < 2 {\n        fmt.Fprintln(os.Stderr, \"usage: flowr <command> [args]\")\n        os.Exit(exitValidation)\n    }\n    switch os.Args[1] {\n    case \"run\":\n        os.Exit(cmdRun(os.Args[2:]))\n    case \"inspect\":\n        os.Exit(cmdInspect(os.Args[2:]))\n    case \"replay\":\n        os.Exit(cmdReplay(os.Args[2:]))\n    case \"cache\":\n        os.Exit(cmdCache(os.Args[2:]))\n    default:\n        fmt.Fprintf(os.Stderr, \"flowr: unknown command %q\\n\", os.Args[1])\n        os.Exit(exitValidation)\n    }\n}\nEOF\n"]
