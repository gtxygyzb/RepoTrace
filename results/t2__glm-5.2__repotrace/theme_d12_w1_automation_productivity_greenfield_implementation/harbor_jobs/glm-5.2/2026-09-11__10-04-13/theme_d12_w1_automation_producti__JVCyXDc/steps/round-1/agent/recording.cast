[4731.031072, "o", "func validateForeachSpec(wf *Workflow, s *Step) error {\r\n\u001b[?2004l\r"]
[4731.03112, "o", "\u001b[?2004h> "]
[4731.031432, "o", "    switch x := s.Foreach.Items.(type) {\r\n\u001b[?2004l\r"]
[4731.031492, "o", "\u001b[?2004h> "]
[4731.031654, "o", "    case string:\r\n\u001b[?2004l\r"]
[4731.031709, "o", "\u001b[?2004h> "]
[4731.031829, "o", "        if x == \"\" {\r\n\u001b[?2004l\r"]
[4731.031881, "o", "\u001b[?2004h> "]
[4731.032186, "o", "            return fmt.Errorf(\"foreach.items must be non-empty\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[4731.032238, "o", "> "]
[4731.03229, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4731.032546, "o", "        if strings.ContainsRune(x, 0) {\r\n\u001b[?2004l\r"]
[4731.032593, "o", "\u001b[?2004h> "]
[4731.032975, "o", "            return fmt.Errorf(\"foreach.items must not contain NUL bytes\")\r\n\u001b[?2004l\r"]
