[4892.99323, "i", "cat > cmd/flowr/util.go <<'EOF'\npackage main\n\nimport (\n    \"encoding/json\"\n    \"fmt\"\n    \"io\"\n    \"os\"\n    \"path/filepath\"\n    \"sort\"\n    \"strings\"\n    \"time\"\n)\n\nfunc timestampNow() string {\n    return nowFunc().UTC().Format(\"2006-01-02T15:04:05.000Z07:00\")\n}\n\nfunc rfc3339(t time.Time) string {\n    return t.UTC().Format(\"2006-01-02T15:04:05.000Z07:00\")\n}\n\nfunc emitEvent(rt *Runtime, ev map[string]any) {\n    if ev[\"ts\"] == nil {\n        ev[\"ts\"] = timestampNow()\n    }\n    rt.eventMu.Lock()\n    defer rt.eventMu.Unlock()\n    b, err := json.Marshal(ev)\n    if err != nil {\n        return\n    }\n    f, err := os.OpenFile(rt.eventsFile, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)\n    if err != nil {\n        return\n    }\n    defer f.Close()\n    f.Write(b)\n    f.WriteString(\"\\n\")\n}\n\nfunc ensureDir(path string) error {\n    return os.MkdirAll(path, 0755)\n}\n\nfunc writeBytes(path string, data []byte) error {\n    if err := ensureDir(filepath.Dir(path)); err != nil {\n        return err\n    }\n    return os.WriteFile(path, data"]
[4892.993318, "i", ", 0644)\n}\n\nfunc copyFile(src, dst string) error {\n    in, err := os.Open(src)\n    if err != nil {\n        return err\n    }\n    defer in.Close()\n    if err := ensureDir(filepath.Dir(dst)); err != nil {\n        return err\n    }\n    out, err := os.Create(dst)\n    if err != nil {\n        return err\n    }\n    defer out.Close()\n    _, err = io.Copy(out, in)\n    return err\n}\n\nfunc fileExists(path string) bool {\n    _, err := os.Stat(path)\n    return err == nil\n}\n\nfunc readJSONFile(path string, v any) error {\n    data, err := os.ReadFile(path)\n    if err != nil {\n        return err\n    }\n    return json.Unmarshal(data, v)\n}\n\nfunc writeJSONFile(path string, v any) error {\n    b, err := json.MarshalIndent(v, \"\", \"  \")\n    if err != nil {\n        return err\n    }\n    b = append(b, '\\n')\n    return writeBytes(path, b)\n}\n\nfunc envMapFromOS() map[string]string {\n    out := map[string]string{}\n    for _, kv := range os.Environ() {\n        if i := strings.IndexByte(kv, '='); i >= 0 {\n            out[kv[:i]] = kv[i+1:]\n      "]
[4892.993595, "i", "  }\n    }\n    return out\n}\n\nfunc sortedKeys(m map[string]bool) []string {\n    out := make([]string, 0, len(m))\n    for k := range m {\n        out = append(out, k)\n    }\n    sort.Strings(out)\n    return out\n}\n\nfunc sortedStringKeys(m map[string]string) []string {\n    out := make([]string, 0, len(m))\n    for k := range m {\n        out = append(out, k)\n    }\n    sort.Strings(out)\n    return out\n}\n\nfunc intPtr(i int) *int {\n    return &i\n}\n\nfunc stringPtr(s string) *string {\n    return &s\n}\n\nfunc nilIfEmpty(s string) string {\n    if s == \"\" {\n        return \"\"\n    }\n    return s\n}\n\nfunc fatalErr(format string, args ...any) {\n    fmt.Fprintf(os.Stderr, \"flowr: \"+format+\"\\n\", args...)\n}\nEOF\n"]
