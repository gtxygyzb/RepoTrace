tfor i := range weights {\n\\t\\tif err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {\n\\t\\t\\treturn nil, fmt.Errorf("failed to read weight[%d]: %v", i, err)\n\\t\\t}\n\\t}\n\n\\tbias := make([]float64, no)\n\\tfor i := range bias {\n\\t\\tif err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {\n\\t\\t\\treturn nil, fmt.Errorf("failed to read bias[%d]: %v", i, err)\n\\t\\t}\n\\t}\n\n\\treturn &WeightsData{\n\\t\\tVersion:     ver,\n\\t\\tNumFeatures: nf,\n\\t\\tNumOutputs:  no,\n\\t\\tActivation:  act,\n\\t\\tWeights:     weights,\n\\t\\tBias:        bias,\n\\t}, nil\n}\'\'\'\ns = re.sub(\n    r\'func loadWeights\\(modelDir string\\) \\(\\*WeightsData, error\\) \\{.*?\\n\\}\\n\\nfunc writeWeights\',\n    new_load + \'\\n\\nfunc writeWeights\',\n    s,\n    flags=re.S,\n)\n\n# Replace writeWeights and add helpers\nnew_write = \'\'\'func writeWeights(path string, w *WeightsData) error {\n\\tf, err := os.Create(path)\n\\tif err != nil {\n\\t\\treturn err\n\\t}\n\\tdefer f.Close()\n\n\\tif _, err := f.Write(modelMagic); err != nil {\n\\t\\treturn err\n\\t}\n\\tif err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {\n\\t\\treturn err\n\\t}\n\\tif err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {\n\\t\\treturn err\n\\t}\n\\tif err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {\n\\t\\treturn err\n\\t}\n\\tif w.Version >= 2 {\n\\t\\tif err := binary.Write(f, binary.LittleEndian, w.Activation); err != nil {\n\\t\\t\\treturn err\n\\t\\t}\n\\t}\n\\tfor _, v := range w.Weights {\n\\t\\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\n\\t\\t\\treturn err\n\\t\\t}\n\\t}\n\\tfor _, v := range w.Bias {\n\\t\\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\n\\t\\t\\treturn err\n\\t\\t}\n\\t}\n\\treturn nil\n}\n\nconst (\n\\tactivationNone    = 0\n\\tactivationSigmoid = 1\n\\tactivationReLU    = 2\n\\tactivationTanh    = 3\n)\n\nfunc activationNameToID(name