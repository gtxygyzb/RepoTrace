(modelDir, ".checkpoints")\n}\n\nfunc countCheckpoints(modelDir string) int {\n\tentries, err := os.ReadDir(checkpointsDir(modelDir))\n\tif err != nil {\n\t\treturn 0\n\t}\n\tcount := 0\n\tfor _, entry := range entries {\n\t\tif entry.IsDir() {\n\t\t\tcount++\n\t\t}\n\t}\n\treturn count\n}\n\nfunc cmdCheckpoint(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, "usage: mlpipe checkpoint <model> [--name <name>]\\n")\n\t\tos.Exit(1)\n\t}\n\tmodel := args[0]\n\tflags := parseFlags(args[1:])\n\n\tname := flags["name"]\n\tif name == "" {\n\t\tname = "cp-" + time.Now().Format("20060102-150405")\n\t}\n\n\tentry, err := resolveModel(model)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "not found\\n")\n\t\tos.Exit(1)\n\t}\n\n\tcpDir := filepath.Join(checkpointsDir(entry.Path), name)\n\tif _, err := os.Stat(cpDir); err == nil {\n\t\tfmt.Fprintf(os.Stderr, "checkpoint already exists\\n")\n\t\tos.Exit(1)\n\t}\n\n\tif err := os.MkdirAll(cpDir, 0755); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tfor _, file := range []string{"weights.bin", "model.meta", "pipeline.cfg"} {\n\t\tsrc := filepath.Join(entry.Path, file)\n\t\tdata, err := os.ReadFile(src)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(cpDir, file), data, 0644); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\n\tfmt.Printf("checkpoint \'%s\' created for \'%s\'\\n", name, model)\n}\n\nfunc cmdCheckpoints(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, "usage: mlpipe checkpoints <model>\\n")\n\t\tos.Exit(1)\n\t}\n\tmodel := args[0]\n\n\tentry, err := resolveModel(model)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "not found\\n")\n\t\tos.Exit(1)\n\t}\n\n\tentries, err := os.ReadDir(checkpointsDir(entry.Path))\n\tif err != nil || len(entries) == 0 {\n\t\tfmt.Println("no checkpoints")\n\t\treturn\n\t}\n\n\ttype checkpointInfo struct {\n\t\tname string\n\t\tmod  time.Time\n\t}\n\tvar cps []checkpointInfo\n\tfor _, entry := range entries {\n\t\tif !entry.IsDir() {\n\t\t\tcontinue\n\t\t}\n\t\tinfo, err := entry.Info()\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tcps = append(cps, checkpointInfo{name: entry.Name(), mod: info.ModTime()})\n\t}\n\n\tif len(cps) == 0 {\n\t\tfmt.Println("no checkpoints")\n\t\treturn\n\t}\n\n\tsort.Slice(cps, func(i, j int) bool {\n\t\treturn cps[i].mod.Before(cps[j].mod)\n\t})\n\n\tfor _, cp := range cps {\n\t\tfmt.Printf("%s  %s\\n", cp.name, cp.mod.Format("2006-01-02 15:04:05"))\n\t}\n}\n\nfunc cmdRollback(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, "usage: mlpipe rollback <model> --to <checkpoint>\\n")\n\t\tos.Exit(1)\n\t}\n\tmodel := args[0]\n\tflags := parseFlags(args[1:])\n\n\tname := flags["to"]\n\tif name == "" {\n\t\tfmt.Fprintf(os.Stderr, "error: --to is required\\n")\n\t\tos.Exit(1)\n\t}\n\n\tentry, err := resolveModel(model)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "not found\\n")\n\t\tos.Exit(1)\n\t}\n\n\tcpDir := filepath.Join(checkpointsDir(entry.Path), name)\n\tif _, err := os.Stat(cpDir); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "checkpoint not found\\n")\n\t\tos.Exit(1)\n\t}\n\n\tentries, err := os.ReadDir(cpDir)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tfor _, entry := range entries {\n\t\tif entry.IsDir() {\n\t\t\tcontinue\n\t\t}\n\t\tdata, err := os.ReadFile(filepath.Join(cpDir, entry.Name()))\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(entry.Path, entry.Name()), data, 0644); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\n\tfmt.Printf("rolled back \'%s\' to checkpoint \'%s\'\\n", model, name)\n}\nEOF\ngofmt -w main.go registry.go export_import.go checkpoints.go\ngo build ./...\n'] min_timeout_sec: 