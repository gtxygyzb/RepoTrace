ry run - no changes made)")\n\t\treturn\n\t}\n\n\tcpDir := filepath.Join(checkpointsDir(entry.Path), "pre-prune")\n\tif err := os.MkdirAll(cpDir, 0755); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\tfor _, file := range []string{"weights.bin", "model.meta", "pipeline.cfg"} {\n\t\tdata, err := os.ReadFile(filepath.Join(entry.Path, file))\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(cpDir, file), data, 0644); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\n\tif err := writeWeights(filepath.Join(entry.Path, "weights.bin"), weights); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error writing weights: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n}\n\'\'\'\nif \'func cmdBenchmark(\' not in s:\n    s = s.rstrip() + "\\n" + new_funcs\nce.write_text(s)\n\nmg = Path(\'main.go\')\ns = mg.read_text()\nold = \'\\tcase "profile":\\n\\t\\tcmdProfile(args)\\n\'\nnew = \'\\tcase "benchmark":\\n\\t\\tcmdBenchmark(args)\\n\\tcase "prune":\\n\\t\\tcmdPrune(args)\\n\\tcase "profile":\\n\\t\\tcmdProfile(args)\\n\'\nif \'case "benchmark":\' not in s:\n    s = s.replace(old, new, 1)\n\nold_usage = \'  profile <model>               Report model weight analysis\\n\'\nnew_usage = \'  benchmark <model> --input <file> [--runs <N>]\\n                                Benchmark inference performance\\n  prune <model> --threshold <value> [--dry-run]\\n                                Prune near-zero weights\\n  profile <model>               Report model weight analysis\\n\'\nif \'benchmark <model> --input\' not in s:\n    s = s.replace(old_usage, new_usage, 1)\nmg.write_text(s)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
