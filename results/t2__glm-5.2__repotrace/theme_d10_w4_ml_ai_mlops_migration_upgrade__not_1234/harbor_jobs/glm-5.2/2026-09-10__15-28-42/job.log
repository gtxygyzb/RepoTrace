ig\np = Path(\'ensemble.go\')\ns = p.read_text()\nold = \'\'\'\\tvar allOutputs [][][]float64\n\\tvar featureCount int\n\\tfor i, modelName := range cfg.Models {\n\\t\\tentry := findEntry(entries, modelName)\n\\t\\tif entry == nil {\n\\t\\t\\tfmt.Printf("model not found: %s\\\\n", modelName)\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\n\\t\\tweights, err := loadWeights(entry.Path)\n\\t\\tif err != nil {\n\\t\\t\\tfmt.Fprintf(os.Stderr, "error loading weights for model \'%s\': %v\\\\n", modelName, err)\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\n\\t\\tif i == 0 {\n\\t\\t\\tfeatureCount = int(weights.NumFeatures)\n\\t\\t} else if int(weights.NumFeatures) != featureCount {\n\\t\\t\\tfmt.Println("feature mismatch")\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\n\\t\\tif err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {\n\\t\\t\\tfmt.Println("feature mismatch")\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\n\\t\\tpipelineCfg, err := loadPipelineConfig(entry.Path)\n\\t\\tif err != nil {\n\\t\\t\\tfmt.Fprintf(os.Stderr, "error loading pipeline config for model \'%s\': %v\\\\n", modelName, err)\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\n\\t\\tresults := runInference(inputs, weights, pipelineCfg)\n\\t\\tallOutputs = append(allOutputs, results)\n\\t}\n\n\\tif len(allOutputs) == 0 {\n\\t\\tfmt.Fprintf(os.Stderr, "error: ensemble \'%s\' has no models\\\\n", name)\n\\t\\tos.Exit(1)\n\\t}\n\n\\tcombined := combineEnsembleOutputs(allOutputs, cfg.Strategy, cfg.Weights)\n\'\'\'\nnew = \'\'\'\\tvar allOutputs [][][]float64\n\\tvar featureCount int\n\\tvar firstPipelineCfg *PipelineConfig\n\\tfor i, modelName := range cfg.Models {\n\\t\\tentry := findEntry(entries, modelName)\n\\t\\tif entry == nil {\n\\t\\t\\tfmt.Printf("model not found: %s\\\\n", modelName)\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\n\\t\\tweights, err := loadWeights(entry.Path)\n\\t\\tif err != nil {\n\\t\\t\\tfmt.Fprintf(os.Stderr, "error loading weights for model \'%s\': %v\\\\n", modelName, err)\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\n\\t\\tif i == 0 {\n\\t\\t\\tfeatureCount = int(weights.NumFeatures)\n\\t\\t} else if int(weights.NumFeatures) != featureCount {\n\\t\\t\\tfmt.Println("feature mismatch")\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\n\\t\\tif err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {\n\\t\\t\\tfmt.Println("feature mismatch")\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\n\\t\\tpipelineCfg, err := loadPipelineConfig(entry.Path)\n\\t\\tif err != nil {\n\\t\\t\\tfmt.Fprintf(os.Stderr, "error loading pipeline config for model \'%s\': %v\\\\n", modelName, err)\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\n\\t\\tif i == 0 {\n\\t\\t\\tfirstPipelineCfg = pipelineCfg\n\\t\\t}\n\n\\t\\tresults := runInferenceRaw(inputs, weights, pipelineCfg)\n\\t\\tallOutputs = append(allOutputs, results)\n\\t}\n\n\\tif len(allOutputs) == 0 || firstPipelineCfg == nil {\n\\t\\tfmt.Fprintf(os.Stderr, "error: ensemble \'%s\' has no models\\\\n", name)\n\\t\\tos.Exit(1)\n\\t}\n\n\\tcombined := combineEnsembleOutputs(allOutputs, cfg.Strategy, cfg.Weights)\n\\tcombined = postprocess(combined, firstPipelineCfg)\n\'\'\'\nif old not in s:\n    raise SystemExit(\'ensemble.go pattern not found\')\np.write_text(s.replace(old, new))\n\n# Patch main.go: add explain dispatch and usage\np = Path(\'main.go\')\ns = p.read_text()\ns = s.replace(\'\'\'\\tcase "profile":\n\\t\\tcmdProfile(args)\n\'\'\', \'\'\'\\tcase "profile":\n\\t\\tcmdProfile(args)\n\\tcase "explain":\n\\t\\tcmdExplain(args)\n\'\'\')\ns = s.replace(\'\'\'  profile <model>               Report model weight analysis\n\'\'\', \'\'\'  profile <model>               Report model weight analysis\n  explain <model> --input <file> [--row <N>]\n                                  Explain prediction for a row\n\'\'\')\np.write_text(s)\n\n# Add cmdExplain to commands_extra.go\np = Path(\'commands_extra.go\')\ns = p.read_text()\ninsert = r\'\'\'\nfunc formatFloat(val float64) string {\n\treturn strconv.FormatFloat(val, \'f\', -1, 64)\n}\n\nfunc formatFloatList(vals []float64) string {\n\tparts := make([]string, len(vals))\n\tfor i, v := range vals {\n\t\tparts[i] = formatFloat(v)\n\t}\n\treturn "[" + strings.Join(parts, " ") + "]"\n}\n\nfunc cmdExplain(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, "usage: mlpipe explain <model> --input <file> [--row <N>]\\n")\n\t\tos.Exit(1)\n\t}\n\n\tmodel := args[0]\n\tflags := parseFlags(args[1:])\n\n\tinputFile := flags["input"]\n\tif inputFile == "" || inputFile == "true" {\n\t\tfmt.Fprintf(os.Stderr, "error: --input is required\\n")\n\t\tos.Exit(1)\n\t}\n\n\trowNum := 1\n\tif flags["row"] != "" && flags["row"] != "true" {\n\t\tn, err := strconv.Atoi(flags["row"])\n\t\tif err != nil || n < 1 {\n\t\t\tfmt.Fprintln(os.Stderr, "row out of range")\n\t\t\tos.Exit(1)\n\t\t}\n\t\trowNum = n\n\t}\n\n\tentry, err := resolveModel(model)\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, "not found")\n\t\tos.Exit(1)\n\t}\n\n\tweights, cfg, err := loadModelArtifacts(entry.Path)\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, "not found")\n\t\tos.Exit(1)\n\t}\n\n\tinputs, err := readInputCSV(inputFile)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error reading input: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tif rowNum < 1 || rowNum > len(inputs) {\n\t\tfmt.Fprintln(os.Stderr, "row out of range")\n\t\tos.Exit(1)\n\t}\n\n\tprocessed := preprocess(inputs, cfg)\n\tidx := rowNum - 1\n\trow := processed[idx]\n\n\tfmt.Printf("Explaining prediction for row %d:\\n", rowNum)\n\tfmt.Printf("Input:  %s\\n", formatFloatList(inputs[idx]))\n\tfmt.Printf("Preprocessed: %s\\n", formatFloatList(row))\n\tfmt.Println()\n\tfmt.Println("Computation:")\n\n\toutputs := make([]float64, weights.NumOutputs)\n\tfor o := uint32(0); o < weights.NumOutputs; o++ {\n\t\tsum := weights.Bias[o]\n\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\n\t\t\tif int(f) >= len(row) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tw := weights.Weights[o*weights.NumFeatures+f]\n\t\t\tx := row[f]\n\t\t\tproduct := w * x\n\t\t\tsum += product\n\t\t\tfmt.Printf("  w[%d] * x[%d] = %s * %s = %s\\n", f, f, formatFloat(w), formatFloat(x), formatFloat(product))\n\t\t}\n\t\tfmt.Printf("  bias = %s\\n", formatFloat(weights.Bias[o]))\n\t\tfmt.Printf("  raw output = %s\\n", formatFloat(sum))\n\t\tactivated := applyActivation(sum, weights.Activation)\n\t\toutputs[o] = activated\n\t\tfmt.Printf("  activation(%s) = %s\\n", activationIDToName(weights.Activation), formatFloat(activated))\n\t\tif o+1 < weights.NumOutputs {\n\t\t\tfmt.Println()\n\t\t}\n\t}\n\n\tfmt.Println()\n\tfinal := postprocess([][]float64{outputs}, cfg)\n\tfmt.Printf("Final output: %s\\n", formatFloatList(final[0]))\n}\n\'\'\'\n# Insert before minInt helper\nmarker = \'\\nfunc minInt(a, b int) int {\\n\'\nif marker not in s:\n    raise SystemExit(\'commands_extra.go marker not found\')\np.write_text(s.replace(marker, \'\\n\' + insert + marker, 1))\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
