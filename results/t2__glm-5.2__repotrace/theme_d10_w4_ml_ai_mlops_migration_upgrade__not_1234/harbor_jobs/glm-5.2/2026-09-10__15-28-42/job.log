umns, got %d", expected, len(record)))\n\t\t} else {\n\t\t\tfor j, val := range record {\n\t\t\t\tif isMissingValue(val) {\n\t\t\t\t\tsummary.MissingCells++\n\t\t\t\t\tissues = append(issues, fmt.Sprintf("missing value in column %d", j+1))\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif _, err := strconv.ParseFloat(strings.TrimSpace(val), 64); err != nil {\n\t\t\t\t\tissues = append(issues, fmt.Sprintf("non-numeric value in column %d: %s", j+1, strings.TrimSpace(val)))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tif len(issues) > 0 {\n\t\t\tsummary.InvalidRows++\n\t\t\tsummary.Issues = append(summary.Issues, validationIssue{\n\t\t\t\tRow:         rowNum,\n\t\t\t\tDescription: strings.Join(issues, "; "),\n\t\t\t})\n\t\t} else {\n\t\t\tsummary.ValidRows++\n\t\t}\n\t}\n\n\treturn summary\n}\n\nfunc printValidationSummary(summary *validationSummary) {\n\tfmt.Printf("Validating input for model \'%s\' (%d features expected)\\n", summary.ModelName, summary.ExpectedFeatures)\n\tfmt.Printf("Total rows:    %d\\n", summary.TotalRows)\n\tfmt.Printf("Valid rows:    %d\\n", summary.ValidRows)\n\tfmt.Printf("Invalid rows:  %d\\n", summary.InvalidRows)\n\tfmt.Printf("Missing values: %d cells\\n", summary.MissingCells)\n\n\tif len(summary.Issues) > 0 {\n\t\tfmt.Println("Issues:")\n\t\tlimit := len(summary.Issues)\n\t\tif limit > 5 {\n\t\t\tlimit = 5\n\t\t}\n\t\tfor _, issue := range summary.Issues[:limit] {\n\t\t\tfmt.Printf("  Row %d: %s\\n", issue.Row, issue.Description)\n\t\t}\n\t}\n}\n\nfunc cmdSchema(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, "usage: mlpipe schema <model>\\n")\n\t\tos.Exit(1)\n\t}\n\n\tmodelName := args[0]\n\tentry := resolveModel(modelName)\n\n\tmeta, err := loadModelMeta(entry.Path)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error loading metadata: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tweights, err := loadWeights(entry.Path)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error loading weights: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tfeatureNames := schemaFeatureNames(meta, int(weights.NumFeatures))\n\n\tfmt.Printf("Model: %s\\n", entry.Name)\n\tfmt.Printf("Input features: %d\\n", int(weights.NumFeatures))\n\tfor _, name := range featureNames {\n\t\tfmt.Printf("  %s: float64\\n", name)\n\t}\n\tfmt.Printf("Output: %d values\\n", int(weights.NumOutputs))\n\tfmt.Printf("Activation: %s\\n", activationIDToName(weights.Activation))\n}\n\nfunc schemaFeatureNames(meta map[string]string, count int) []string {\n\tnames := make([]string, count)\n\tfor i := 0; i < count; i++ {\n\t\tnames[i] = fmt.Sprintf("f%d", i+1)\n\t}\n\n\tif meta != nil {\n\t\tif raw, ok := meta["feature_names"]; ok && strings.TrimSpace(raw) != "" {\n\t\t\tparts := strings.Split(raw, ",")\n\t\t\tfor i := 0; i < count; i++ {\n\t\t\t\tif i < len(parts) {\n\t\t\t\t\tname := strings.TrimSpace(parts[i])\n\t\t\t\t\tif name != "" {\n\t\t\t\t\t\tnames[i] = name\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\treturn names\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
