err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tfor _, m := range models {\n\t\tif findEntry(entries, m) == nil {\n\t\t\tfmt.Printf("model not found: %s\\n", m)\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\n\tvar outputDim int\n\tfor i, m := range models {\n\t\tentry := findEntry(entries, m)\n\t\tweights, err := loadWeights(entry.Path)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error loading weights for model \'%s\': %v\\n", m, err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tif i == 0 {\n\t\t\toutputDim = int(weights.NumOutputs)\n\t\t} else if int(weights.NumOutputs) != outputDim {\n\t\t\tfmt.Println("output dimension mismatch")\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\n\tpath := filepath.Join(ensemblesDir, name+".json")\n\tif _, err := os.Stat(path); err == nil {\n\t\tfmt.Println("ensemble already exists")\n\t\tos.Exit(1)\n\t}\n\n\tcfg := ensembleConfig{\n\t\tName:     name,\n\t\tModels:   models,\n\t\tStrategy: strategy,\n\t}\n\tif err := saveEnsembleConfig(&cfg); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tfmt.Printf("ensemble \'%s\' created with %d models (strategy=%s)\\n", name, len(models), strategy)\n}\n\nfunc cmdEnsembleList(args []string) {\n\tconfigs, err := listEnsembleConfigs()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\tif len(configs) == 0 {\n\t\tfmt.Println("no ensembles")\n\t\treturn\n\t}\n\tsort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })\n\tfor _, cfg := range configs {\n\t\tfmt.Printf("%s  %s  %d models\\n", cfg.Name, cfg.Strategy, len(cfg.Models))\n\t}\n}\n\nfunc cmdEnsembleRun(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, "usage: mlpipe ensemble run <name> --input <file> [--format csv|json]\\n")\n\t\tos.Exit(1)\n\t}\n\tname := args[0]\n\tflags := parseFlags(args[1:])\n\n\tinputFile := flags["input"]\n\tif inputFile == "" || inputFile == "true" {\n\t\tfmt.Fprintf(os.Stderr, "error: --input is required\\n")\n\t\tos.Exit(1)\n\t}\n\n\toutputFormat := flags["format"]\n\tif outputFormat == "" || outputFormat == "true" {\n\t\toutputFormat = "csv"\n\t}\n\tif outputFormat != "csv" && outputFormat != "json" {\n\t\tfmt.Fprintf(os.Stderr, "error: unsupported format \'%s\', use \'csv\' or \'json\'\\n", outputFormat)\n\t\tos.Exit(1)\n\t}\n\n\tcfg, err := loadEnsembleConfig(name)\n\tif err != nil {\n\t\tfmt.Println("ensemble not found")\n\t\tos.Exit(1)\n\t}\n\n\tinputs, err := readInputCSV(inputFile)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error reading input: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tentries, err := loadRegistry()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tvar allOutputs [][][]float64\n\tvar featureCount int\n\tfor i, modelName := range cfg.Models {\n\t\tentry := findEntry(entries, modelName)\n\t\tif entry == nil {\n\t\t\tfmt.Printf("model not found: %s\\n", modelName)\n\t\t\tos.Exit(1)\n\t\t}\n\n\t\tweights, err := loadWeights(entry.Path)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error loading weights for model \'%s\': %v\\n", modelName, err)\n\t\t\tos.Exit(1)\n\t\t}\n\n\t\tif i == 0 {\n\t\t\tfeatureCount = int(weights.NumFeatures)\n\t\t} else if int(weights.NumFeatures) != featureCount {\n\t\t\tfmt.Println("feature mismatch")\n\t\t\tos.Exit(1)\n\t\t}\n\n\t\tif err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {\n\t\t\tfmt.Println("feature mismatch")\n\t\t\tos.Exit(1)\n\t\t}\n\n\t\tpipelineCfg, err := loadPipelineConfig(entry.Path)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error loading pipeline config for model \'%s\': %v\\n", modelName, err)\n\t\t\tos.Exit(1)\n\t\t}\n\n\t\tresults := runInference(inputs, weights, pipelineCfg)\n\t\tallOutputs = append(allOutputs, results)\n\t}\n\n\tif len(allOutputs) == 0 {\n\t\tfmt.Fprintf(os.Stderr, "error: ensemble \'%s\' has no models\\n", name)\n\t\tos.Exit(1)\n\t}\n\n\tcombined := combineEnsembleOutputs