[7499.971749, "i", "sed -n '140,280p' inference.go\n"]
[7499.972036, "o", "sed -n '140,280p' inference.go\r\n"]
[7499.972096, "o", "\u001b[?2004l\r"]
[7499.975049, "o", "\t\t\toutput[o] = applyActivation(sum, weights.Activation)\r\n\t\t}\r\n\t\tresults[i] = output\r\n\t}\r\n\r\n"]
[7499.975114, "o", "\treturn postprocess(results, cfg)\r\n}\r\n\r\nfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n\tresult := make([][]float64, len(inputs))\r\n\tfor i, row := range inputs {\r\n\t\tresult[i] = make([]float64, len(row))\r\n\t\tcopy(result[i], row)\r\n\t}\r\n"]
[7499.975171, "o", "\r\n\tif len(result) == 0 {\r\n\t\treturn result\r\n\t}\r\n\r\n\tfor i, row := range result {\r\n\t\tfor j, val := range row {\r\n\t\t\tif math.IsNaN(val) {\r\n\t\t\t\tswitch cfg.MissingStrategy {\r\n"]
[7499.975225, "o", "\t\t\t\tcase \"zero\":\r\n\t\t\t\t\tresult[i][j] = 0.0\r\n\t\t\t\tcase \"mean\":\r\n\t\t\t\t\tresult[i][j] = computeColumnMean(inputs, j)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[7499.975279, "o", "\tif cfg.Normalize {\r\n\t\tfor j := 0; j < len(result[0]); j++ {\r\n\t\t\tminVal, maxVal := columnMinMax(result, j)\r\n\t\t\trangeVal := maxVal - minVal\r\n\t\t\tif rangeVal == 0 {\r\n\t\t\t\trangeVal = 1.0\r\n\t\t\t}\r\n\t\t\tfor i := range result {\r\n\t"]
[7499.975334, "o", "\t\t\tnormalized := (result[i][j] - minVal) / rangeVal\r\n\t\t\t\tresult[i][j] = cfg.ScaleMin + normalized*(cfg.ScaleMax-cfg.ScaleMin)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\treturn result\r\n"]
[7499.975385, "o", "}\r\n\r\nfunc postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {\r\n\tfor i, row := range results {\r\n\t\tfor j, val := range row {\r\n\t\t\tval = math.Max(val, cfg.ClipMin)\r\n\t\t\tval = math.Min(val, cfg.ClipMax)\r\n\t\t\tresults[i][j] = roundToDigits(val, cfg.RoundDigits)\r\n"]
[7499.975438, "o", "\t\t}\r\n\t}\r\n\treturn results\r\n}\r\n\r\nfunc computeColumnMean(data [][]float64, col int) float64 {\r\n\tsum := 0.0\r\n\tcount := 0\r\n\tfor _, row := range data {\r\n\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n"]
[7499.97549, "o", "\t\t\tsum += row[col]\r\n\t\t\tcount++\r\n\t\t}\r\n\t}\r\n\tif count == 0 {\r\n\t\treturn 0.0\r\n\t}\r\n\treturn sum / float64(count)\r\n}\r\n"]
[7499.975543, "o", "\r\nfunc columnMinMax(data [][]float64, col int) (float64, float64) {\r\n\tminVal := math.Inf(1)\r\n\tmaxVal := math.Inf(-1)\r\n\tfor _, row := range data {\r\n\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n\t\t\tif row[col] < minVal {\r\n\t\t\t\tminVal = row[col]\r\n\t\t\t}\r\n"]
[7499.975596, "o", "\t\t\tif row[col] > maxVal {\r\n\t\t\t\tmaxVal = row[col]\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn minVal, maxVal\r\n}\r\n\r\n"]
[7499.975649, "o", "func writeOutput(f *os.File, results [][]float64, format string) {\r\n\tswitch format {\r\n\tcase \"csv\":\r\n\t\twriter := csv.NewWriter(f)\r\n\t\theader := make([]string, len(results[0]))\r\n\t\tfor i := range header {\r\n\t\t\theader[i] = fmt.Sprintf(\"output_%d\", i)\r\n\t\t}\r\n\t"]
[7499.975702, "o", "\twriter.Write(header)\r\n\t\tfor _, row := range results {\r\n\t\t\trecord := make([]string, len(row))\r\n\t\t\tfor j, val := range row {\r\n\t\t\t\trecord[j] = strconv.FormatFloat(val, 'f', -1, 64)\r\n\t\t\t}\r\n\t"]
[7499.975758, "o", "\t\twriter.Write(record)\r\n\t\t}\r\n\t\twriter.Flush()\r\n\tcase \"json\":\r\n\t\ttype Prediction struct {\r\n\t\t\tOutputs []float64 `json:\"outputs\"`\r\n\t\t}\r\n\t\ttype Result struct {\r\n"]
[7499.975816, "o", "\t\t\tPredictions []Prediction `json:\"predictions\"`\r\n\t\t}\r\n\t\tr := Result{}\r\n\t\tfor _, row := range results {\r\n\t\t\tr.Predictions = append(r.Predictions, Prediction{Outputs: row})\r\n\t\t}\r\n"]
[7499.975867, "o", "\t\tenc := json.NewEncoder(f)\r\n\t\tenc.SetIndent(\"\", \"  \")\r\n\t\tenc.Encode(r)\r\n\t}\r\n}\r\n"]
