[9618.659035, "o", "    68\t\t\treturn true\r\n    69\t\t}\r\n    70\t\tlower := strings.ToLower(val)\r\n    71\t\treturn lower == \"na\" || lower == \"nan\"\r\n    72\t}\r\n    73\t\r\n    74\tfunc cmdStats(args []string) {\r\n    75\t\tflags := parseFlags(args)\r\n    76\t\tinput := flags[\"input\"]\r\n"]
[9618.659103, "o", "    77\t\tif input == \"\" {\r\n    78\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe stats --input <file>\\n\")\r\n    79\t\t\tos.Exit(1)\r\n    80\t\t}\r\n    81\t\r\n    82\t\trecords, err := readCSVRaw(input)\r\n    83\t\tif err != nil {\r\n    84\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    85\t\t\tos.Exit(1)\r\n    86\t\t}\r\n"]
[9618.659172, "o", "    87\t\tif len(records) == 0 {\r\n    88\t\t\tfmt.Println(\"No data found.\")\r\n    89\t\t\treturn\r\n    90\t\t}\r\n    91\t\r\n    92\t\thasHeader := isHeader(records[0])\r\n    93\t\tstart := 0\r\n    94\t\tif hasHeader {\r\n    95\t\t\tstart = 1\r\n    96\t\t"]
[9618.659242, "o", "}\r\n    97\t\r\n    98\t\tnumCols := 0\r\n    99\t\tfor _, rec := range records {\r\n   100\t\t\tif len(rec) > numCols {\r\n   101\t\t\t\tnumCols = len(rec)\r\n   102\t\t\t}\r\n   103\t\t}\r\n   104\t\r\n   105\t\theaders := make([]string, numCols)\r\n   106\t\t"]
[9618.659317, "o", "for i := 0; i < numCols; i++ {\r\n   107\t\t\tif hasHeader && i < len(records[0]) {\r\n   108\t\t\t\theaders[i] = strings.TrimSpace(records[0][i])\r\n   109\t\t\t} else {\r\n   110\t\t\t\theaders[i] = fmt.Sprintf(\"col_%d\", i)\r\n   111\t\t\t}\r\n   112\t\t}\r\n   113\t\r\n   114\t\ttype colStat struct {\r\n   115\t\t\tidx     int\r\n"]
[9618.659389, "o", "   116\t\t\tname    string\r\n   117\t\t\tcount   int\r\n   118\t\t\tmissing int\r\n   119\t\t\tmin     float64\r\n   120\t\t\tmax     float64\r\n   121\t\t\tmean    float64\r\n   122\t\t\tstddev  float64\r\n   123\t\t\tvalues  []float64\r\n   124\t\t}\r\n   125\t\r\n   126\t"]
[9618.659461, "o", "\tvar stats []colStat\r\n   127\t\tnumericCols := make([]int, 0)\r\n   128\t\tvaluesByCol := make(map[int][]float64)\r\n   129\t\tvar skippedCols []string\r\n   130\t\r\n   131\t\tfor j := 0; j < numCols; j++ {\r\n   132\t\t\tvalues := make([]float64, 0, len(records)-start)\r\n   133\t\t\tmissing := 0\r\n   134\t"]
[9618.659537, "o", "\t\tnumeric := true\r\n   135\t\r\n   136\t\t\tfor i := start; i < len(records); i++ {\r\n   137\t\t\t\traw := \"\"\r\n   138\t\t\t\tif j < len(records[i]) {\r\n   139\t\t\t\t\traw = strings.TrimSpace(records[i][j])\r\n   140\t\t\t\t}\r\n   141\t\t\t\tif isMissingValue(raw) {\r\n   142\t\t\t\t\tmissing++\r\n   143\t\t\t\t\tvalues = append(values, math.NaN())\r\n   144\t\t\t\t\tcontinue\r\n"]
[9618.659608, "o", "   145\t\t\t\t}\r\n   146\t\t\t\tv, err := strconv.ParseFloat(raw, 64)\r\n   147\t\t\t\tif err != nil {\r\n   148\t\t\t\t\tnumeric = false\r\n   149\t\t\t\t\tbreak\r\n   150\t\t\t\t}\r\n   151\t\t\t\tvalues = append(values, v)\r\n"]
