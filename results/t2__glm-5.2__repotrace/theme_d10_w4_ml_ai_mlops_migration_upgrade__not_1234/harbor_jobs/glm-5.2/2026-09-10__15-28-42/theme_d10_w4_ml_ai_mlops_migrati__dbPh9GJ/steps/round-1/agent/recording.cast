[4586.631174, "o", "   387\tfunc savePipelineConfig(modelDir string, cfg *PipelineConfig) error {\r\n   388\t\tpath := filepath.Join(modelDir, \"pipeline.cfg\")\r\n   389\t\tf, err := os.Create(path)\r\n   390\t\tif err != nil {\r\n   391\t\t\treturn err\r\n   392\t\t}\r\n   393\t\tdefer f.Close()\r\n   394\t\r\n   395\t\tfmt.Fprintln(f, \"[preprocess]\")\r\n   396\t\tfmt.Fprintf(f, \"normalize=%t\\n\", cfg.Normalize)\r\n   397\t\tfmt.Fprintf(f, \"scale_range=%s,%s\\n\", formatFloat(cfg.ScaleMin), formatFloat(cfg.ScaleMax))\r\n"]
[4586.631235, "o", "   398\t\tfmt.Fprintf(f, \"missing_strategy=%s\\n\", cfg.MissingStrategy)\r\n   399\t\tfmt.Fprintln(f)\r\n   400\t\tfmt.Fprintln(f, \"[postprocess]\")\r\n   401\t\tfmt.Fprintf(f, \"round_digits=%d\\n\", cfg.RoundDigits)\r\n   402\t\tfmt.Fprintf(f, \"clip_min=%s\\n\", formatFloat(cfg.ClipMin))\r\n   403\t\tfmt.Fprintf(f, \"clip_max=%s\\n\", formatFloat(cfg.ClipMax))\r\n   404\t\treturn nil\r\n   405\t}\r\n   406\t\r\n   407\tfunc formatFloat(v float64) string {\r\n"]
