[3355.918914, "o", "\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kactivation\u001b[m\u001b[KNone    = 0\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kactivation\u001b[m\u001b[KSigmoid = 1\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kactivation\u001b[m\u001b[KReLU    = 2\r\n"]
