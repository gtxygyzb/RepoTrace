[288.831374, "o", "if err != nil {\r\n    19\t\t\treturn nil, err\r\n    20\t\t}\r\n    21\t\tdefer f.Close()\r\n    22\t\r\n    23\t\tmeta := make(map[string]string)\r\n    24\t\tscanner := bufio.NewScanner(f)\r\n    25\t\tfor scanner.Scan() {\r\n    26\t\t\tline := strings.TrimSpace(scanner.Text())\r\n    27\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    28\t\t\t\tcontinue\r\n    29\t"]
