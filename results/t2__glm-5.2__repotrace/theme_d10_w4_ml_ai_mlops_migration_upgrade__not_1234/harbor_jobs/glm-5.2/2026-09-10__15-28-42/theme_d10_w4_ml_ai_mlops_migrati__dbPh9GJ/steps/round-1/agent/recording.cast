[13235.693933, "o", "\u001b[35m\u001b[K./commands_extra.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K915\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcmdPrune\u001b[m\u001b[K(args []string) {\r\n"]
[13235.693998, "o", "\u001b[35m\u001b[K./export_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcmdExport\u001b[m\u001b[K(args []string) {\r\n"]
[13235.694462, "o", "\u001b[35m\u001b[K./format.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc loadModelMeta\u001b[m\u001b[K(modelDir string) (map[string]string, error) {\r\n"]
[13235.694538, "o", "\u001b[35m\u001b[K./format.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc loadWeights\u001b[m\u001b[K(modelDir string) (*WeightsData, error) {\r\n"]
[13235.694664, "o", "\u001b[35m\u001b[K./format.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc writeWeights\u001b[m\u001b[K(path string, w *WeightsData) error {\r\n"]
[13235.69479, "o", "\u001b[35m\u001b[K./format.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc saveModelMeta\u001b[m\u001b[K(modelDir string, meta map[string]string) error {\r\n"]
[13235.714377, "o", "grep: ./mlpipe: binary file matches\r\n"]
