[4791.712524, "o", "eckpoint\u001b[m\u001b[KsDir(entry.Path))\r\n\u001b[35m\u001b[Kcheckpoints.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Println(\"no \u001b[01;31m\u001b[Kcheckpoint\u001b[m\u001b[Ks\")\r\n\u001b[35m\u001b[Kcheckpoints.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\ttype \u001b[01;31m\u001b[Kcheckpoint\u001b[m\u001b[KInfo struct {\r\n\u001b[35m\u001b[Kcheckpoints.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar cps []\u001b[01;31m\u001b[Kcheckpoint\u001b[m\u001b[KInfo\r\n\u001b[35m\u001b[Kcheckpoints.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcps = append(cps, \u001b[01;31m\u001b[Kcheckpoint\u001b[m\u001b[KInfo{name: entry.Name(), mod: info.ModTime()})\r\n"]
