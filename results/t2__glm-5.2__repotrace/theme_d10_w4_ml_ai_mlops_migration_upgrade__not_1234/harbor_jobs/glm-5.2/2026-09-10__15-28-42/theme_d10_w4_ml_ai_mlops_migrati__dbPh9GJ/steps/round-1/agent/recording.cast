[12634.6751, "o", "sed -n '1,220p' main.go\r\n"]
[12634.675186, "o", "\u001b[?2004l\r"]
[12634.678242, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n)\r\n"]
[12634.678316, "o", "\r\nconst version = \"0.1.0\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcommand := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch command {\r\n"]
[12634.678378, "o", "\tcase \"ensemble\":\r\n\t\tcmdEnsemble(args)\r\n\tcase \"list\":\r\n\t\tcmdList(args)\r\n\tcase \"info\":\r\n\t\tcmdInfo(args)\r\n\tcase \"register\":\r\n\t\tcmdRegister(args)\r\n\tcase \"remove\":\r\n"]
[12634.678436, "o", "\t\tcmdRemove(args)\r\n\tcase \"tag\":\r\n\t\tcmdTag(args)\r\n\tcase \"untag\":\r\n\t\tcmdUntag(args)\r\n\tcase \"search\":\r\n\t\tcmdSearch(args)\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"stats\":\r\n"]
[12634.678493, "o", "\t\tcmdStats(args)\r\n\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n\tcase \"batch\":\r\n\t\tcmdBatch(args)\r\n\tcase \"benchmark\":\r\n\t\tcmdBenchmark(args)\r\n\tcase \"prune\":\r\n\t\tcmdPrune(args)\r\n\tcase \"profile\":\r\n"]
[12634.67855, "o", "\t\tcmdProfile(args)\r\n\tcase \"explain\":\r\n\t\tcmdExplain(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"validate-input\":\r\n\t\tcmdValidateInput(args)\r\n\tcase \"schema\":\r\n"]
[12634.67862, "o", "\t\tcmdSchema(args)\r\n\tcase \"export\":\r\n\t\tcmdExport(args)\r\n\tcase \"import\":\r\n\t\tcmdImport(args)\r\n"]
[12634.678683, "o", "\tcase \"clone\":\r\n\t\tcmdClone(args)\r\n\tcase \"checkpoint\":\r\n\t\tcmdCheckpoint(args)\r\n\tcase \"checkpoints\":\r\n\t\tcmdCheckpoints(args)\r\n\tcase \"rollback\":\r\n\t\tcmdRollback(args)\r\n\tcase \"migrate\":\r\n\t\tcmdMigrate(args)\r\n\tcase \"compat\":\r\n\t\tcmdCompat(args)\r\n\tcase \"version\":\r\n\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n\tcase \"help\":\r\n"]
[12634.678761, "o", "\t\tprintUsage()\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc printUsage() {\r\n\tusage := `mlpipe - ML Inference Pipeline Manager\r\n\r\n"]
[12634.678836, "o", "Usage: mlpipe <command> [arguments]\r\n\r\nCommands:\r\n  list                          List all registered models\r\n  info <model>                  Show model details\r\n  register <name> <path>        Register a model from directory\r\n  remove <name>                 Remove a model from registry\r\n  run <model> [options]         Run inference\r\n  stats --input <file>          Input statistics profiling\r\n  diff <model1> <model2> --input <file>\r\n                                Compare two models on same input\r\n  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n"]
[12634.678906, "o", "                                Batch inference over CSV files\r\n  validate <model>              Validate model integrity\r\n  validate-input <model> --input <file>\r\n                                Validate input data for a model\r\n  schema <model>                Display expected input schema for a model\r\n  export <model> --output <file> Export model to JSON file\r\n"]
[12634.678974, "o", "  import <path> [--name <name>] Import model from JSON file\r\n  clone <model> <new_name>      Clone model to new name\r\n  benchmark <model> --input <file> [--runs <N>]\r\n                                Benchmark inference performance\r\n  prune <model> --threshold <value> [--dry-run]\r\n                                Prune near-zero weights\r\n  profile <model>               Report model weight analysis\r\n  explain <model> --input <file> [--row <N>]\r\n                                  Explain prediction for a row\r\n  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n  compat [--all]                 Check migration compatibility\r\n  version                       Show version\r\n  help                          Show this help\r\n\r\nRun/Diff Options:\r\n  --input <file>    Input CSV file (required)\r\n  --output <file>   Output file (default: stdout)\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n  --strict          Validate input before inference and abort on invalid rows\r\n\r\n"]
[12634.679049, "o", "Batch Options:\r\n  --dir <dir>       Input directory of CSV files\r\n  --output-dir <dir> Output directory for predictions\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n`\r\n\tfmt.Print(usage)\r\n}\r\n\r\nfunc parseFlags(args []string) map[string]string {\r\n\tflags := make(map[string]string)\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tif strings.HasPrefix(args[i], \"--\") {\r\n\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n\t\t\t\tflags[key] = args[i+1]"]
[12634.679106, "o", "\r\n\t\t\t\ti++\r\n\t\t\t} else {\r\n\t\t\t\tflags[key] = \"true\"\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn flags\r\n}\r\n"]
[12634.679621, "o", "\u001b[?2004h"]
[12634.679677, "o", "root@n30009:/app# "]
[12634.949602, "i", "sed -n '1,260p' format.go\n"]
[12634.94992, "o", "sed -n '1,260p' format.go\r\n"]
[12634.95, "o", "\u001b[?2004l\r"]
[12634.953042, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/binary\"\r\n\t\"fmt\""]
[12634.953105, "o", "\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nvar modelMagic = []byte(\"MLPW\")\r\n\r\n"]
[12634.953169, "o", "func loadModelMeta(modelDir string) (map[string]string, error) {\r\n\tf, err := os.Open(filepath.Join(modelDir, \"model.meta\"))\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tmeta := make(map[string]string)\r\n\tscanner := bufio.NewScanner(f)\r\n\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n"]
[12634.953239, "o", "\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.SplitN(line, \"=\", 2)\r\n\t\tif len(parts) == 2 {\r\n\t\t\tmeta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])\r\n"]
[12634.953303, "o", "\t\t}\r\n\t}\r\n\treturn meta, scanner.Err()\r\n}\r\n\r\ntype WeightsData struct {\r\n\tVersion     uint32\r\n\tNumFeatures uint32\r\n\tNumOutputs  uint32\r\n\tActivation  uint32\r\n\tWeights     []float64\r\n\tBias        []float64\r\n}\r\n\r\nfunc loadWeights(modelDir string) (*WeightsData, error) {\r\n\tf, err := os.Open(filepath.Join(modelDir, \"weights.bin\"))\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n"]
[12634.953363, "o", "\t}\r\n\tdefer f.Close()\r\n\r\n\tmagic := make([]byte, 4)\r\n\tif _, err := f.Read(magic); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to read magic: %v\", err)\r\n\t}\r\n\tif string(magic) != string(modelMagic) {\r\n"]
[12634.953424, "o", "\t\treturn nil, fmt.Errorf(\"invalid model file: bad magic\")\r\n\t}\r\n\r\n\tvar ver, nf, no uint32\r\n\tif err := binary.Read(f, binary.LittleEndian, &ver); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to read version: %v\", err)\r\n\t}\r\n\tif err := binary.Read(f, binary.LittleEndian, &nf); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to read num_features: %v\", err)\r\n\t}"]
[12634.953486, "o", "\r\n\tif err := binary.Read(f, binary.LittleEndian, &no); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to read num_outputs: %v\", err)\r\n\t}\r\n"]
[12634.95355, "o", "\r\n\tvar act uint32\r\n\tswitch ver {\r\n\tcase 1:\r\n\t\tact = 0\r\n\tcase 2:\r\n\t\tif err := binary.Read(f, binary.LittleEndian, &act); err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"failed to read activation: %v\", err)\r\n\t\t}\r\n\tdefault:\r\n\t\t"]
[12634.953617, "o", "return nil, fmt.Errorf(\"unsupported model format version: %d\", ver)\r\n\t}\r\n\r\n\tweights := make([]float64, nf*no)\r\n\tfor i := range weights {\r\n\t\tif err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"failed to read weight[%d]: %v\", i, err)\r\n\t\t}\r\n\t}\r\n\r\n\tbias := make([]float64, no)\r\n\tfor i := range bias {\r\n"]
[12634.95368, "o", "\t\tif err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"failed to read bias[%d]: %v\", i, err)\r\n\t\t}\r\n\t}\r\n\r\n\treturn &WeightsData{\r\n\t\tVersion:     ver,\r\n\t\tNumFeatures: nf,\r\n\t\tNumOutputs:  no,\r\n\t\tActivation:  act,\r\n\t\tWeights:     weights,\r\n"]
[12634.953738, "o", "\t\tBias:        bias,\r\n\t}, nil\r\n}\r\n\r\nfunc writeWeights(path string, w *WeightsData) error {\r\n\tf, err := os.Create(path)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tif _, err := f.Write(modelMagic); err != nil {\r\n\t\treturn err\r\n\t}\r\n"]
[12634.953826, "o", "\tif err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif w.Version >= 2 {\r\n\t\t"]
[12634.95389, "o", "if err := binary.Write(f, binary.LittleEndian, w.Activation); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\tfor _, v := range w.Weights {\r\n\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\tfor _, v := range w.Bias {\r\n\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n\t\t\treturn err\r\n"]
[12634.953953, "o", "\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nconst (\r\n\tactivationNone    = 0\r\n\tactivationSigmoid = 1\r\n\tactivationReLU    = 2\r\n\tactivationTanh    = 3\r\n)\r\n\r\nfunc activationNameToID(name string) (uint32, error) {\r\n"]
[12634.954012, "o", "\tswitch strings.ToLower(name) {\r\n\tcase \"\", \"none\":\r\n\t\treturn activationNone, nil\r\n\tcase \"sigmoid\":\r\n\t\treturn activationSigmoid, nil\r\n\tcase \"relu\":\r\n\t\treturn activationReLU, nil\r\n\tcase \"tanh\":\r\n\t\treturn activationTanh, nil\r\n\tdefault:\r\n"]
[12634.954074, "o", "\t\treturn 0, fmt.Errorf(\"invalid activation\")\r\n\t}\r\n}\r\n\r\nfunc activationIDToName(id uint32) string {\r\n\tswitch id {\r\n\tcase activationNone:\r\n"]
[12634.954152, "o", "\t\treturn \"none\"\r\n\tcase activationSigmoid:\r\n\t\treturn \"sigmoid\"\r\n\tcase activationReLU:\r\n\t\treturn \"relu\"\r\n\tcase activationTanh:\r\n\t\treturn \"tanh\"\r\n\tdefault:\r\n\t\treturn \"unknown\"\r\n\t}\r\n}\r\n\r\nfunc applyActivation(x float64, activation uint32) float64 {\r\n\tswitch activation {\r\n\tcase activationSigmoid:\r\n\t\treturn 1.0 / (1.0 + math.Exp(-x))\r\n\tcase activationReLU:\r\n\t\tif x < 0 {\r\n"]
[12634.954214, "o", "\t\t\treturn 0\r\n\t\t}\r\n\t\treturn x\r\n\tcase activationTanh:\r\n"]
[12634.954276, "o", "\t\treturn math.Tanh(x)\r\n\tdefault:\r\n\t\treturn x\r\n\t}\r\n}\r\n\r\nfunc saveModelMeta(modelDir string, meta map[string]string) error {\r\n\tf, err := os.Create(filepath.Join(modelDir, \"model.meta\"))\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tkeys := make([]string, 0, len(meta))\r\n\tfor k := range meta {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n\tsort.Strings(keys)\r\n"]
[12634.954346, "o", "\tfor _, k := range keys {\r\n\t\tfmt.Fprintf(f, \"%s=%s\\n\", k, meta[k])\r\n\t}\r\n\treturn nil\r\n}\r\n\r\ntype PipelineConfig struct {\r\n\tNormalize       bool\r\n\tScaleMin        float64\r\n\tScaleMax        float64\r\n\tMissingStrategy string\r\n\tRoundDigits     int\r\n\tClipMin         float64\r\n"]
[12634.954407, "o", "\tClipMax         float64\r\n\tFeatureNames    []string\r\n}\r\n\r\nfunc loadPipelineConfig(modelDir string) (*PipelineConfig, error) {\r\n\tf, err := os.Open(filepath.Join(modelDir, \"pipeline.cfg\"))\r\n"]
[12634.954472, "o", "\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tcfg := &PipelineConfig{\r\n\t\tScaleMin:        0.0,\r\n\t\tScaleMax:        1.0,\r\n\t\tMissingStrategy: \"zero\",\r\n\t\tRoundDigits:     4,\r\n\t\tClipMin:         -1000.0,\r\n\t\tClipMax:         1000.0,\r\n\t}\r\n\r\n\tscanner := bufio.NewScanner(f)\r\n\tsection := \"\"\r\n\tfor scanner.Scan() {\r\n"]
[12634.954529, "o", "\t\tline := strings.TrimSpace(scanner.Text())\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\r\n\t\t\tsection = line[1 : len(line)-1]\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.SplitN(line, \"=\", 2)\r\n"]
[12634.954592, "o", "\t\tif len(parts) != 2 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tkey := strings.TrimSpace(parts[0])\r\n"]
