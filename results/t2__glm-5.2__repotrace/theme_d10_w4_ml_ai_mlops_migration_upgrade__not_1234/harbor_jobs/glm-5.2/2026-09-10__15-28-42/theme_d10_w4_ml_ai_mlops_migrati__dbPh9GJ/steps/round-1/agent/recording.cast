[3995.628765, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[3995.628908, "o", "\t\"path/filepath\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nconst registryFile = \"/app/models/registry.idx\"\r\n\r\ntype RegistryEntry struct {\r\n\tName    string\r\n\tPath    string\r\n\tType    string\r\n\tVersion int\r\n\tCreated string\r\n}\r\n\r\nfunc loadRegistry() ([]RegistryEntry, error) {\r\n\tf, err := os.Open(registryFile)\r\n\tif err != nil {\r\n"]
[3995.629025, "o", "\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, nil\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tvar entries []RegistryEntry\r\n\tscanner := bufio.NewScanner(f)\r\n\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.Split(line, \"|\")\r\n\t\tif len(parts) != 5 {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[3995.629106, "o", "\t\tver := 1\r\n\t\tfmt.Sscanf(parts[3], \"%d\", &ver)\r\n\t\tentries = append(entries, RegistryEntry{\r\n\t\t\tName:    parts[0],\r\n\t\t\tPath:    parts[1],\r\n\t\t\tType:    parts[2],\r\n\t\t\tVersion: ver,\r\n\t\t\tCreated: parts[4],\r\n\t\t})\r\n\t}\r\n\treturn entries, scanner.Err()\r\n"]
[3995.629175, "o", "}\r\n\r\nfunc saveRegistry(entries []RegistryEntry) error {\r\n\tdir := filepath.Dir(registryFile)\r\n\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n"]
[3995.629241, "o", "\r\n\tf, err := os.Create(registryFile)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tfmt.Fprintln(f, \"# mlpipe registry v1\")\r\n\tfor _, e := range entries {\r\n\t\tfmt.Fprintf(f, \"%s|%s|%s|%d|%s\\n\", e.Name, e.Path, e.Type, e.Version, e.Created)\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc findEntry(entries []RegistryEntry, name string) *RegistryEntry {\r\n"]
[3995.629313, "o", "\tfor i := range entries {\r\n\t\tif entries[i].Name == name {\r\n\t\t\treturn &entries[i]\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc cmdList(args []string) {\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t"]
[3995.629377, "o", "}\r\n\tif len(entries) == 0 {\r\n\t\tfmt.Println(\"No models registered.\")\r\n\t\treturn\r\n\t}\r\n\tfmt.Printf(\"%-20s %-10s %-8s %s\\n\", \"NAME\", \"TYPE\", \"VERSION\", \"CREATED\")\r\n\tfor _, e := range entries {\r\n\t\tfmt.Printf(\"%-20s %-10s %-8d %s\\n\", e.Name, e.Type, e.Version, e.Created)\r\n\t}\r\n}\r\n"]
[3995.629439, "o", "\r\nfunc cmdInfo(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe info <model>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[3995.629501, "o", "\t\tos.Exit(1)\r\n\t}\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif !modelDirExists(entry.Path) {\r\n\t\t"]
[3995.629568, "o", "fmt.Fprintf(os.Stderr, \"error: model directory not found\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmeta, err := loadModelMeta(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n\t\t"]
[3995.629635, "o", "os.Exit(1)\r\n\t}\r\n\r\n\tweights, err := loadWeights(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfmt.Printf(\"Name:        %s\\n\", meta[\"name\"])\r\n\tfmt.Printf(\"Type:        %s\\n\", meta[\"type\"])\r\n\tfmt.Printf(\"Version:     %s\\n\", meta[\"version\"])\r\n\t"]
[3995.629699, "o", "fmt.Printf(\"Created:     %s\\n\", meta[\"created\"])\r\n\tfmt.Printf(\"Description: %s\\n\", meta[\"description\"])\r\n\tfmt.Printf(\"Features:    %s\\n\", meta[\"features\"])\r\n\tfmt.Printf(\"Outputs:     %s\\n\", meta[\"outputs\"])\r\n\tfmt.Printf(\"Format:     v%d\\n\", weights.Version)\r\n\tfmt.Printf(\"Activation: %s\\n\", activationIDToName(weights.Activation))\r\n\tfmt.Printf(\"Path:        %s\\n\", entry.Path)\r\n}\r\n\r\nfunc cmdRegister(args []string) {\r\n\tif len(args) < 2 {\r\n"]
[3995.629765, "o", "\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe register <name> <path>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\tmodelPath := args[1]\r\n\r\n\tabsPath, err := filepath.Abs(modelPath)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[3995.629834, "o", "\tif _, err := os.Stat(filepath.Join(absPath, \"model.meta\")); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: no model.meta found at %s\\n\", absPath)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmeta, err := loadModelMeta(absPath)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := loadRegistry()\r\n"]
[3995.629896, "o", "\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif findEntry(entries, name) != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' already registered\\n\", name)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[3995.629959, "o", "\tmodelType := meta[\"type\"]\r\n\tif modelType == \"\" {\r\n\t\tmodelType = \"unknown\"\r\n\t}\r\n\r\n\tentries = append(entries, RegistryEntry{\r\n\t\tName:    name,\r\n\t\tPath:    absPath,\r\n\t\tType:    modelType,\r\n\t\tVersion: 1,\r\n\t\tCreated: time.Now().Format(\"2006-01-02\"),\r\n\t})\r\n\r\n\tif err := saveRegistry(entries); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n"]
[3995.63002, "o", "\t}\r\n\tfmt.Printf(\"Model '%s' registered successfully.\\n\", name)\r\n}\r\n\r\nfunc cmdRemove(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe remove <name>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[3995.63008, "o", "\tname := args[0]\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfound := false\r\n\tvar newEntries []RegistryEntry\r\n\tfor _, e := range entries {\r\n"]
[3995.630141, "o", "\t\tif e.Name == name {\r\n\t\t\tfound = true\r\n\t\t} else {\r\n\t\t\tnewEntries = append(newEntries, e)\r\n\t\t}\r\n\t}\r\n\r\n\tif !found {\r\n"]
[3995.630207, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif err := saveRegistry(newEntries); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\t"]
[3995.630267, "o", "fmt.Printf(\"Model '%s' removed.\\n\", name)\r\n}\r\n"]
[3995.630696, "o", "\u001b[?2004h"]
[3995.630751, "o", "root@n30009:/app# "]
[3995.892671, "i", "sed -n '1,240p' main.go\n"]
[3995.892953, "o", "sed -n '1,240p' main.go\r\n\u001b[?2004l\r"]
[3995.896009, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[3995.896086, "o", "\t\"strings\"\r\n)\r\n\r\nconst version = \"0.1.0\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcommand := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n"]
[3995.896153, "o", "\tswitch command {\r\n\tcase \"list\":\r\n\t\tcmdList(args)\r\n\tcase \"info\":\r\n\t\tcmdInfo(args)\r\n\tcase \"register\":\r\n\t\tcmdRegister(args)\r\n\tcase \"remove\":\r\n\t\tcmdRemove(args)\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"stats\":\r\n\t\tcmdStats(args)\r\n\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n\tcase \"batch\":\r\n\t\tcmdBatch(args)\r\n\t"]
[3995.896218, "o", "case \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"export\":\r\n\t\tcmdExport(args)\r\n\tcase \"import\":\r\n\t\tcmdImport(args)\r\n\tcase \"clone\":\r\n\t\tcmdClone(args)\r\n\tcase \"migrate\":\r\n\t\tcmdMigrate(args)\r\n\tcase \"compat\":\r\n\t\tcmdCompat(args)\r\n\tcase \"version\":\r\n\t\t"]
[3995.89628, "o", "fmt.Printf(\"mlpipe version %s\\n\", version)\r\n\tcase \"help\":\r\n\t\tprintUsage()\r\n\tdefault:\r\n"]
[3995.896342, "o", "\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc printUsage() {\r\n\tusage := `mlpipe - ML Inference Pipeline Manager\r\n\r\nUsage: mlpipe <command> [arguments]\r\n\r\nCommands:\r\n  list                          List all registered models\r\n"]
[3995.896411, "o", "  info <model>                  Show model details\r\n  register <name> <path>        Register a model from directory\r\n  remove <name>                 Remove a model from registry\r\n  run <model> [options]         Run inference\r\n  stats --input <file>          Input statistics profiling\r\n  diff <model1> <model2> --input <file>\r\n                                Compare two models on same input\r\n  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n                                Batch inference over CSV files\r\n  validate <model>              Validate model integrity\r\n  export <model> --output <file> Export model to JSON file\r\n  import <path> [--name <name>] Import model from JSON file\r\n  clone <model> <new_name>      Clone model to new name\r\n  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n  compat [--all]                 Check migration compatibility\r\n  version                       Show version\r\n  help                          Show this help\r\n\r\nRun/Diff Options:\r\n"]
[3995.896475, "o", "  --input <file>    Input CSV file (required)\r\n  --output <file>   Output file (default: stdout)\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n\r\nBatch Options:\r\n  --dir <dir>       Input directory of CSV files\r\n  --output-dir <dir> Output directory for predictions\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n`\r\n\tfmt.Print(usage)\r\n}\r\n\r\nfunc parseFlags(args []string) map[string]string {\r\n"]
[3995.896536, "o", "\tflags := make(map[string]string)\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tif strings.HasPrefix(args[i], \"--\") {\r\n\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n\t\t\t"]
[3995.896566, "o", "\tflags[key] = args[i+1]\r\n\t\t\t\ti++\r\n\t\t\t} else {\r\n\t\t\t\tflags[key] = \"true\"\r\n\t"]
[3995.896669, "o", "\t\t}\r\n\t\t}\r\n\t}\r\n\treturn flags\r\n}\r\n"]
[3995.897102, "o", "\u001b[?2004h"]
[3995.897165, "o", "root@n30009:/app# "]
[3996.168373, "i", "sed -n '1,240p' commands.go\n"]
[3996.168626, "o", "sed -n '1,240p' commands.go\r\n"]
[3996.168715, "o", "\u001b[?2004l\r"]
[3996.171594, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[3996.171667, "o", "\t\"path/filepath\"\r\n)\r\n\r\nfunc cmdValidate(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe validate <model>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[3996.171749, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif !modelDirExists(entry.Path) {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model directory not found\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\terrors := validateModel(entry.Path)\r\n"]
[3996.171832, "o", "\tif len(errors) == 0 {\r\n\t\tfmt.Printf(\"Model '%s' is valid.\\n\", name)\r\n\t} else {\r\n\t\tfmt.Printf(\"Model '%s' has %d validation error(s):\\n\", name, len(errors))\r\n\t\tfor i, e := range errors {\r\n\t\t\tfmt.Printf(\"  %d. %s\\n\", i+1, e)\r\n\t\t}\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc validateModel(modelDir string) []string {\r\n\t"]
[3996.171894, "o", "var errors []string\r\n\r\n\tmetaPath := filepath.Join(modelDir, \"model.meta\")\r\n\tif _, err := os.Stat(metaPath); err != nil {\r\n\t\terrors = append(errors, \"missing model.meta\")\r\n\t} else {\r\n\t\tmeta, err := loadModelMeta(modelDir)\r\n\t\tif err != nil {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse model.meta: %v\", err))\r\n"]
[3996.171957, "o", "\t\t} else {\r\n\t\t\tif meta[\"name\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'name' field\")\r\n\t\t\t}\r\n\t\t\tif meta[\"type\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'type' field\")\r\n\t\t\t}\r\n\t\t\tif meta[\"features\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'features' field\")\r\n"]
[3996.172017, "o", "\t\t\t}\r\n\t\t\tif meta[\"outputs\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'outputs' field\")\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tweightsPath := filepath.Join(modelDir, \"weights.bin\")\r\n\tif _, err := os.Stat(weightsPath); err != nil {\r\n\t\terrors = append(errors, \"missing weights.bin\")\r\n"]
[3996.17208, "o", "\t} else {\r\n\t\t_, err := loadWeights(modelDir)\r\n\t\tif err != nil {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse weights.bin: %v\", err))\r\n\t\t}\r\n\t}\r\n\r\n\tcfgPath := filepath.Join(modelDir, \"pipeline.cfg\")\r\n\tif _, err := os.Stat(cfgPath); err != nil {\r\n\t\terrors = append(errors, \"missing pipeline.cfg\")\r\n\t} else {\r\n"]
