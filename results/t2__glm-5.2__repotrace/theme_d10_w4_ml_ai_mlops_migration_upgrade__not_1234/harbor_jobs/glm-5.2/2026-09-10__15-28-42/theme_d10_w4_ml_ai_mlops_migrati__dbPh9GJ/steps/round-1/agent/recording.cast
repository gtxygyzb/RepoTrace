[7544.754778, "o", "fmt.Printf(\"Type:       %s\\n\", entry.Type)\r\n   431\t\tfmt.Printf(\"Format:     v%d\\n\", weights.Version)\r\n   432\t\tif weights.Version >= 2 {\r\n   433\t\t\tfmt.Printf(\"Activation: %s\\n\", activationIDToName(weights.Activation))\r\n   434\t\t}\r\n   435\t\tfmt.Printf(\"Dimensions: %d x %d\\n\", features, outputs)\r\n   436\t\tfmt.Printf(\"Parameters: %d\\n\", totalParams)\r\n   437\t\tfmt.Printf(\"File size:  %d bytes\\n\", info.Size())\r\n   438\t\tfmt.Printf(\"Weight min: %v\\n\", wmin)\r\n   439\t\tfmt.Printf(\"Weight max: %v\\n\", wmax)\r\n"]
[7544.75487, "o", "   440\t\tfmt.Printf(\"Weight avg: %v\\n\", wavg)\r\n   441\t\tbiasStrs := make([]string, len(weights.Bias))\r\n   442\t\tfor i, b := range weights.Bias {\r\n   443\t\t\tbiasStrs[i] = fmt.Sprintf(\"%v\", b)\r\n   444\t\t}\r\n   445\t\tfmt.Printf(\"Bias:       [%s]\\n\", strings.Join(biasStrs, \", \"))\r\n   446\t\tfmt.Printf(\"Sparsity:   %.1f%%\\n\", sparsity)\r\n   447\t}\r\n   448\t\r\n   449\tfunc cmdBatch(args []string) {\r\n   450\t\tif len(args) < 1 {\r\n   451\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe batch <model> --dir <input_dir> --output-dir <output_dir> [--format csv|json]\\n\")\r\n"]
