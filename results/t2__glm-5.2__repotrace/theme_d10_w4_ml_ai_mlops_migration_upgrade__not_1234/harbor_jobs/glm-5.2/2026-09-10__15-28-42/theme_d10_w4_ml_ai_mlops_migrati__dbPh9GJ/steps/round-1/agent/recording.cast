[11363.887103, "o", "func countCheckpoints(modelDir string) int {\r\n\tentries, err := os.ReadDir(checkpointsDir(modelDir))\r\n\tif err != nil {\r\n\t\treturn 0\r\n\t}\r\n\tcount := 0\r\n\tfor _, entry := range entries {\r\n\t\tif entry.IsDir() {\r\n\t\t\tcount++\r\n\t\t}\r\n\t}\r\n\treturn count\r\n"]
