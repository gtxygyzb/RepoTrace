[12338.115044, "o", "   139\tfunc runInferenceRaw(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n   140\t\tprocessed := preprocess(inputs, cfg)\r\n   141\t\r\n   142\t\tresults := make([][]float64, len(processed))\r\n"]
[12338.115119, "o", "   143\t\tfor i, row := range processed {\r\n   144\t\t\toutput := make([]float64, weights.NumOutputs)\r\n   145\t\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n   146\t\t\t\tsum := weights.Bias[o]\r\n   147\t\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n   148\t\t\t\t\tif int(f) < len(row) {\r\n   149\t\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n   150\t\t\t\t\t}\r\n   151\t\t\t\t}\r\n   152\t\t\t\toutput[o] = applyActivation(sum, weights.Activation)\r\n   153\t\t\t}\r\n   154\t\t\tresults[i] = output\r\n   155\t\t}\r\n   156\t\r\n   157\t\treturn results\r\n   158\t}\r\n   159\t\r\n   160\tfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   161\t\tresult := make([][]float64, len(inputs))\r\n   162\t\tfor i, row := range inputs {\r\n   163\t\t\tresult[i] = make([]float64, len(row))\r\n   164\t\t\tcopy(result[i], row)\r\n   165\t\t}\r\n"]
