[5921.783359, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   412\t\t\tos.Exit(1)\r\n   413\t\t}\r\n   414\t\r\n   415\t\tvar files []string\r\n   416\t\tfor _, de := range dirEntries {\r\n   417\t\t\tif de.IsDir() {\r\n   418\t\t\t\tcontinue\r\n   419\t\t\t}\r\n"]
[5921.783423, "o", "   420\t\t\tname := de.Name()\r\n   421\t\t\tif strings.HasSuffix(strings.ToLower(name), \".csv\") {\r\n   422\t\t\t\tfiles = append(files, filepath.Join(inputDir, name))\r\n   423\t\t\t}\r\n   424\t\t}\r\n"]
[5921.783487, "o", "   425\t\tsort.Strings(files)\r\n   426\t\r\n   427\t\ttotalFiles := len(files)\r\n   428\t\ttotalRows := 0\r\n   429\t\tprocessed := 0\r\n   430\t\tvar failures []string\r\n   431\t\r\n   432\t\tfor _, file := range files {\r\n   433\t\t\tinputs, err := readInputCSV(file)\r\n   434\t\t\tif err != nil {\r\n   435\t\t\t\tfailures = append(failures, fmt.Sprintf(\"%s: %v\", filepath.Base(file), err))\r\n   436\t\t\t\tcontinue\r\n   437\t"]
[5921.783553, "o", "\t\t}\r\n   438\t\r\n   439\t\t\tif err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {\r\n   440\t\t\t\tfailures = append(failures, fmt.Sprintf(\"%s: %v\", filepath.Base(file), err))\r\n   441\t\t\t\tcontinue\r\n"]
[5921.783614, "o", "   442\t\t\t}\r\n   443\t\r\n   444\t\t\tresults := runInference(inputs, weights, cfg)\r\n   445\t\r\n   446\t\t\tbase := strings.TrimSuffix(filepath.Base(file), filepath.Ext(file))\r\n   447\t\t\toutPath := filepath.Join(outputDir, base+\".\"+format)\r\n   448\t\t\tf, err := os.Create(outPath)\r\n   449\t\t\tif err != nil {\r\n   450\t\t\t\tfailures = append(failures, fmt.Sprintf(\"%s: %v\", filepath.Base(file), err))\r\n"]
