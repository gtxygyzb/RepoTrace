[11363.603645, "o", "\t\toutput := make([]float64, weights.NumOutputs)\r\n\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n\t\t\tsum := weights.Bias[o]\r\n\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n\t\t\t\tif int(f) < len(row) {\r\n\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n"]
