[251.708233, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"fmt\"\r\n"]
[251.70843, "o", "     6\t\t\"os\"\r\n     7\t\t\"path/filepath\"\r\n     8\t\t\"strings\"\r\n"]
[251.708525, "o", "     9\t\t\"time\"\r\n    10\t)\r\n    11\t\r\n    12\tconst registryFile = \"/app/models/registry.idx\"\r\n    13\t\r\n    14\ttype RegistryEntry struct {\r\n    15\t\tName    string\r\n    16\t\tPath    string\r\n    17\t\tType    string\r\n    18\t\tVersion int\r\n    19\t\tCreated string\r\n    20\t}\r\n    21\t\r\n    22\tfunc loadRegistry() ([]RegistryEntry, error) {\r\n    23\t\tf, err := os.Open(registryFile)\r\n    24\t\tif err != nil {\r\n    25\t\t\tif os.IsNotExist(err) {\r\n    26\t\t\t\treturn nil, nil\r\n    27\t\t\t}\r\n    28\t\t\treturn nil, err\r\n    29\t\t}\r\n    30\t\tdefer f.Close()\r\n    31\t\r\n    32\t\tvar entries []RegistryEntry\r\n    33\t\tscanner := bufio.NewScanner(f)\r\n    34\t\tfor scanner.Scan() {\r\n    35\t\t\tline := strings.TrimSpace(scanner.Text())\r\n    36\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    37\t\t\t\tcontinue\r\n    38\t\t\t}\r\n"]
[251.708624, "o", "    39\t\t\tparts := strings.Split(line, \"|\")\r\n    40\t\t\tif len(parts) != 5 {\r\n    41\t\t\t\tcontinue\r\n    42\t\t\t}\r\n    43\t\t\tver := 1\r\n    44\t\t\tfmt.Sscanf(parts[3], \"%d\", &ver)\r\n    45\t\t\tentries = append(entries, RegistryEntry{\r\n    46\t\t\t\tName:    parts[0],\r\n    47\t\t\t\tPath:    parts[1],\r\n"]
[251.708708, "o", "    48\t\t\t\tType:    parts[2],\r\n    49\t\t\t\tVersion: ver,\r\n    50\t\t\t\tCreated: parts[4],\r\n    51\t\t\t})\r\n    52\t\t}\r\n    53\t\treturn entries, scanner.Err()\r\n    54\t}\r\n    55\t\r\n    56\t"]
[251.708775, "o", "func saveRegistry(entries []RegistryEntry) error {\r\n    57\t\tdir := filepath.Dir(registryFile)\r\n    58\t\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n    59\t\t\treturn err\r\n    60\t\t}\r\n    61\t\r\n    62\t\tf, err := os.Create(registryFile)\r\n"]
[251.70886, "o", "    63\t\tif err != nil {\r\n    64\t\t\treturn err\r\n    65\t\t}\r\n"]
[251.708934, "o", "    66\t\tdefer f.Close()\r\n    67\t\r\n    68\t\tfmt.Fprintln(f, \"# mlpipe registry v1\")\r\n    69\t\tfor _, e := range entries {\r\n    70\t\t\tfmt.Fprintf(f, \"%s|%s|%s|%d|%s\\n\", e.Name, e.Path, e.Type, e.Version, e.Created)\r\n    71\t\t}\r\n    72\t\treturn nil\r\n    73\t}\r\n"]
[251.709007, "o", "    74\t\r\n    75\tfunc findEntry(entries []RegistryEntry, name string) *RegistryEntry {\r\n    76\t\tfor i := range entries {\r\n    77\t\t\tif entries[i].Name == name {\r\n    78\t\t\t\treturn &entries[i]\r\n    79\t\t\t}\r\n    80\t\t}\r\n    81\t\treturn nil\r\n    82\t}\r\n    83\t\r\n    84\tfunc cmdList(args []string) {\r\n    85\t\tentries, err := loadRegistry()\r\n"]
