[11416.470596, "o", "\tdirEntries, err := os.ReadDir(inputDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar files []string\r\n\tfor _, de := range dirEntries {\r\n\t\tif de.IsDir() {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tname := de.Name()\r\n\t\tif strings.HasSuffix(strings.ToLower(name), \".csv\") {\r\n\t\t\t"]
[11416.470698, "o", "files = append(files, filepath.Join(inputDir, name))\r\n\t\t}\r\n\t}\r\n\tsort.Strings(files)\r\n\r\n\ttotalFiles := len(files)\r\n\ttotalRows := 0\r\n\tprocessed := 0\r\n\tvar failures []string\r\n\r\n\tfor _, file := range files {\r\n\t\tinputs, err := readInputCSV(file)\r\n\t\tif err != nil {\r\n\t\t\tfailures = append(failures, fmt.Sprintf(\"%s: %v\", filepath.Base(file), err))\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tif err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {\r\n\t\t\tfailures = append(failures, fmt.Sprintf(\"%s: %v\", filepath.Base(file), err))\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tresults := runInference(inputs, weights, cfg)\r\n\r\n\t\tbase := strings.TrimSuffix(filepath.Base(file), filepath.Ext(file))\r\n\t\toutPath := filepath.Join(outputDir, base+\".\"+format)\r\n\t\tf, err := os.Create(outPath)\r\n\t\tif err != nil {\r\n\t\t\tfailures = append(failures, fmt.Sprintf(\"%s: %v\", filepath.Base(file), err))\r\n"]
[11416.470773, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\twriteOutput(f, results, format)\r\n\t\tf.Close()\r\n\r\n\t\tprocessed++\r\n\t\ttotalRows += len(results)"]
[11416.47087, "o", "\r\n\t}\r\n\r\n\tfmt.Printf(\"Batch summary:\\n\")\r\n\tfmt.Printf(\"  total files processed: %d\\n\", totalFiles)\r\n\tfmt.Printf(\"  successful: %d\\n\", processed)\r\n\tfmt.Printf(\"  total rows: %d\\n\", totalRows)\r\n\tfmt.Printf(\"  failed files: %d\\n\", len(failures))\r\n\tfor _, fail := range failures {\r\n\t\tfmt.Printf(\"  - %s\\n\", fail)\r\n\t}\r\n}\r\n"]
