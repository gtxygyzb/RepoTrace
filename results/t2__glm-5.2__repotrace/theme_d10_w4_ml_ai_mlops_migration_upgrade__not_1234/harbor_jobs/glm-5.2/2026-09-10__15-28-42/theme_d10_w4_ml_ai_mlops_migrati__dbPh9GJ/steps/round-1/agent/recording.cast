[5909.582001, "o", "    60\t\t\tcmdCompat(args)\r\n    61\t\tcase \"version\":\r\n    62\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    63\t\tcase \"help\":\r\n    64\t\t\tprintUsage()\r\n    65\t\tdefault:\r\n    66\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    67\t\t\tprintUsage()\r\n    68\t\t\tos.Exit(1)\r\n"]
[5909.58206, "o", "    69\t\t}\r\n    70\t}\r\n    71\t\r\n    72\tfunc printUsage() {\r\n    73\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    74\t\r\n    75\tUsage: mlpipe <command> [arguments]\r\n    76\t\r\n"]
[5909.582127, "o", "    77\tCommands:\r\n    78\t  list                          List all registered models\r\n    79\t  info <model>                  Show model details\r\n    80\t  register <name> <path>        Register a model from directory\r\n    81\t  remove <name>                 Remove a model from registry\r\n    82\t  run <model> [options]         Run inference\r\n    83\t  stats --input <file>          Input statistics profiling\r\n    84\t  diff <model1> <model2> --input <file>\r\n    85\t                                Compare two models on same input\r\n    86\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n"]
[5909.582215, "o", "    87\t                                Batch inference over CSV files\r\n    88\t  validate <model>              Validate model integrity\r\n    89\t  export <model> --output <file> Export model to JSON file\r\n    90\t  import <path> [--name <name>] Import model from JSON file\r\n    91\t  clone <model> <new_name>      Clone model to new name\r\n    92\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n    93\t  compat [--all]                 Check migration compatibility\r\n    94\t  version                       Show version\r\n    95\t  help                          Show this help\r\n    96\t\r\n    97\tRun/Diff Options:\r\n    98\t  --input <file>    Input CSV file (required)\r\n"]
[5909.58228, "o", "    99\t  --output <file>   Output file (default: stdout)\r\n   100\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   101\t\r\n   102\tBatch Options:\r\n   103\t  --dir <dir>       Input directory of CSV files\r\n   104\t  --output-dir <dir> Output directory for predictions\r\n   105\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   106\t`\r\n   107\t\tfmt.Print(usage)\r\n"]
