[9125.799011, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path(\"ensemble.go\")\ns = p.read_text()\n\ns = s.replace(\n'''import (\n\"encoding/json\"\n\"fmt\"\n\"os\"\n\"path/filepath\"\n\"sort\"\n\"strings\"\n)''',\n'''import (\n\"encoding/json\"\n\"fmt\"\n\"os\"\n\"path/filepath\"\n\"sort\"\n\"strconv\"\n\"strings\"\n\"time\"\n)'''\n)\n\ns = s.replace(\n'''type ensembleConfig struct {\nName     string   `json:\"name\"`\nModels   []string `json:\"models\"`\nStrategy string   `json:\"strategy\"`\n}''',\n'''type ensembleConfig struct {\nName     string    `json:\"name\"`\nModels   []string  `json:\"models\"`\nStrategy string    `json:\"strategy\"`\nWeights  []float64 `json:\"weights\"`\nCreated  string    `json:\"created\"`\n}'''\n)\n\ns = s.replace(\n'''fmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble <create|list|run|remove> [arguments]\\\\n\")''',\n'''fmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble <create|list|run|info|remove> [arguments]\\\\n\")'''\n)\n\ns = s.replace(\n'''case \"run\":\ncmdEnsembleRun(rest)\ncase \"remove\":''',\n'''case \"run\":\ncmdEnsembleRun(rest)\ncase \"info\":\ncmdEnsembleInfo(rest)\ncase \"remove\":'''\n)\n\ns"]
[9125.799117, "i", " = s.replace(\n'''usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]\\\\n\"'',\n'''usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>] [--weights <w1,w2,...>]\\\\n\"'''\n)\n\ns = s.replace(\n'''if len(models) == 0 {\nfmt.Fprintf(os.Stderr, \"error: at least one model is required\\\\n\")\nos.Exit(1)\n}''',\n'''if len(models) == 0 {\nfmt.Fprintf(os.Stderr, \"error: at least one model is required\\\\n\")\nos.Exit(1)\n}\n\nvar weights []float64\nif weightsStr := flags[\"weights\"]; weightsStr != \"\" && weightsStr != \"true\" {\nfor _, w := range strings.Split(weightsStr, \",\") {\nw = strings.TrimSpace(w)\nif w == \"\" {\ncontinue\n}\nval, err := strconv.ParseFloat(w, 64)\nif err != nil {\nfmt.Println(\"weights must be positive\")\nos.Exit(1)\n}\nif val <= 0 {\nfmt.Println(\"weights must be positive\")\nos.Exit(1)\n}\nweights = append(weights, val)\n}\nif len(weights) != len(models) {\nfmt.Println(\"weight count mismatch\")\nos.Exit(1)\n}\n} else {\nweights = make([]float64, len(models))\nfor i := range weights {\nweight"]
[9125.799443, "i", "s[i] = 1.0\n}\n}'''\n)\n\ns = s.replace(\n'''cfg := ensembleConfig{\nName:     name,\nModels:   models,\nStrategy: strategy,\n}''',\n'''cfg := ensembleConfig{\nName:     name,\nModels:   models,\nStrategy: strategy,\nWeights:  weights,\nCreated:  time.Now().Format(\"2006-01-02\"),\n}'''\n)\n\ns = s.replace(\n'''func cmdEnsembleRun(args []string) {''',\n'''func cmdEnsembleInfo(args []string) {\nif len(args) < 1 {\nfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble info <name>\\\\n\")\nos.Exit(1)\n}\nname := args[0]\ncfg, err := loadEnsembleConfig(name)\nif err != nil {\nfmt.Println(\"ensemble not found\")\nos.Exit(1)\n}\nfmt.Printf(\"Name:     %s\\\\n\", cfg.Name)\nfmt.Printf(\"Strategy: %s\\\\n\", cfg.Strategy)\nfmt.Println(\"Models:\")\nfor i, model := range cfg.Models {\nweight := 1.0\nif i < len(cfg.Weights) {\nweight = cfg.Weights[i]\n}\nfmt.Printf(\"  %s (weight: %g)\\\\n\", model, weight)\n}\nif cfg.Created != \"\" {\nfmt.Printf(\"Created:  %s\\\\n\", cfg.Created)\n}\n}\n\nfunc cmdEnsembleRun(args []string) {'''\n)\n\ns = s.replace(\n'''combined := combineEnsembleOutputs(allOutputs, c"]
