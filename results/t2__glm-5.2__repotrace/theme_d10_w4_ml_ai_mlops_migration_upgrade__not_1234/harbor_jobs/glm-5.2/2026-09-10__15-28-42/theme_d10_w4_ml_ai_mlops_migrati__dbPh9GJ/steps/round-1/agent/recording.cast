[6432.177894, "o", "grep -n \"func cmdProfile\" -A75 commands_extra.go\r\n\u001b[?2004l\r"]
[6432.181003, "o", "\u001b[32m\u001b[K369\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmdProfile\u001b[m\u001b[K(args []string) {\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(args) < 1 {\r\n\u001b[32m\u001b[K371\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t"]
[6432.181098, "o", "fmt.Fprintf(os.Stderr, \"usage: mlpipe profile <model>\\n\")\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tos.Exit(1)\r\n\u001b[32m\u001b[K373\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K374\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmodel := args[0]\r\n\u001b[32m\u001b[K375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tentry, err := resolveModel(model)\r\n\u001b[32m\u001b[K377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tos.Exit(1)\r\n\u001b[32m\u001b[K380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K382\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tweightsPath := filepath.Join(entry.Path, \"weights.bin\")\r\n\u001b[32m\u001b[K383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tinfo, err := os.Stat(weightsPath)\r\n"]
[6432.181178, "o", "\u001b[32m\u001b[K384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K385\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n\u001b[32m\u001b[K386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tos.Exit(1)\r\n\u001b[32m\u001b[K387\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K388\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K389\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tweights, _, err := loadModelArtifacts(entry.Path)\r\n\u001b[32m\u001b[K390\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K391\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"error loading model: %v\\n\", err)\r\n\u001b[32m\u001b[K392\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tos.Exit(1)\r\n\u001b[32m\u001b[K393\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K394\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfeatures := int(weights.NumFeatures)\r\n"]
[6432.181239, "o", "\u001b[32m\u001b[K396\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\toutputs := int(weights.NumOutputs)\r\n\u001b[32m\u001b[K397\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ttotalParams := features*outputs + outputs\r\n\u001b[32m\u001b[K398\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar wmin, wmax, wsum float64\r\n\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tzeroCount := 0\r\n\u001b[32m\u001b[K401\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(weights.Weights) > 0 {\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twmin = weights.Weights[0]\r\n\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twmax = weights.Weights[0]\r\n"]
[6432.181306, "o", "\u001b[32m\u001b[K404\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor _, v := range weights.Weights {\r\n\u001b[32m\u001b[K405\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif v < wmin {\r\n\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\twmin = v\r\n\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif v > wmax {\r\n"]
[6432.181372, "o", "\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\twmax = v\r\n\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\twsum += v\r\n\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif v == 0 {\r\n\u001b[32m\u001b[K413\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tzeroCount++\r\n\u001b[32m\u001b[K414\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K415\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K416\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t} else {\r\n\u001b[32m\u001b[K417\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twmin = 0\r\n\u001b[32m\u001b[K418\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twmax = 0\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\twavg := 0.0\r\n\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(weights.Weights) > 0 {\r\n"]
[6432.181437, "o", "\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twavg = wsum / float64(len(weights.Weights))\r\n\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K424\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tsparsity := 0.0\r\n\u001b[32m\u001b[K425\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(weights.Weights) > 0 {\r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsparsity = float64(zeroCount) / float64(len(weights.Weights)) * 100\r\n\u001b[32m\u001b[K427\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[6432.181503, "o", "\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K429\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Printf(\"Name:       %s\\n\", entry.Name)\r\n\u001b[32m\u001b[K430\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Printf(\"Type:       %s\\n\", entry.Type)\r\n\u001b[32m\u001b[K431\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Printf(\"Format:     v%d\\n\", weights.Version)\r\n\u001b[32m\u001b[K432\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif weights.Version >= 2 {\r\n\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Printf(\"Activation: %s\\n\", activationIDToName(weights.Activation))\r\n\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K435\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Printf(\"Dimensions: %d x %d\\n\", features, outputs)\r\n\u001b[32m\u001b[K436\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Printf(\"Parameters: %d\\n\", totalParams)\r\n\u001b[32m\u001b[K437\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Printf(\"File size:  %d bytes\\n\", info.Size())\r\n\u001b[32m\u001b[K438\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Printf(\"Weight min: %v\\n\", wmin)\r\n\u001b[32m\u001b[K439\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Printf(\"Weight max: %v\\n\", wmax)\r\n\u001b[32m\u001b[K440\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Printf(\"Weight avg: %v\\n\", wavg)\r\n"]
[6432.181566, "o", "\u001b[32m\u001b[K441\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tbiasStrs := make([]string, len(weights.Bias))\r\n\u001b[32m\u001b[K442\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor i, b := range weights.Bias {\r\n\u001b[32m\u001b[K443\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tbiasStrs[i] = fmt.Sprintf(\"%v\", b)\r\n\u001b[32m\u001b[K444\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
