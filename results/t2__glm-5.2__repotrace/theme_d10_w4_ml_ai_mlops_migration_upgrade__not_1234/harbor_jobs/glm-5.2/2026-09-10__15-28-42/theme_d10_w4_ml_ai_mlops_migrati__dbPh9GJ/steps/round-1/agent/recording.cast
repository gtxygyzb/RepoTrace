[7543.885193, "o", "\t\t}\r\n    87\t\tdefer f.Close()\r\n    88\t\r\n    89\t\treader := csv.NewReader(f)\r\n    90\t\trecords, err := reader.ReadAll()\r\n    91\t\tif err != nil {\r\n    92\t\t\treturn nil, err\r\n    93\t\t}\r\n    94\t\r\n    95\t\tvar data [][]float64\r\n    96\t\tfor i, record := range records {\r\n    97\t\t\tif i == 0 && isHeader(record) {\r\n    98\t\t\t\tcontinue\r\n    99\t\t\t}\r\n   100\t\t\trow := make([]float64, len(record))\r\n   101\t\t\tfor j, val := range record {\r\n"]
