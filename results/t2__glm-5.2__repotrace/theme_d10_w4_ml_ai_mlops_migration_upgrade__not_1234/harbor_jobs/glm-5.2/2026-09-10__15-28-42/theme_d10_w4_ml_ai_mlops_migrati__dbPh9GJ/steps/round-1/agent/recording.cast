[4594.007422, "o", "   108\tdata, err := json.MarshalIndent(out, \"\", \"  \")\r\n   109\tif err != nil {\r\n   110\treturn err\r\n   111\t}\r\n   112\treturn os.WriteFile(registryJSONFile, data, 0644)\r\n   113\t}\r\n   114\t\r\n   115\tfunc ensureTags(tags []string) []string {\r\n   116\tif tags == nil {\r\n   117\treturn []string{}\r\n   118\t}\r\n   119\treturn tags\r\n   120\t}\r\n   121\t\r\n   122\tfunc findEntry(entries []RegistryEntry, name string) *RegistryEntry {\r\n   123\tfor i := range entries {\r\n"]
[4594.007486, "o", "   124\tif entries[i].Name == name {\r\n   125\treturn &entries[i]\r\n   126\t}\r\n   127\t}\r\n   128\treturn nil\r\n   129\t}\r\n   130\t\r\n   131\tfunc cmdList(args []string) {\r\n   132\tentries, err := loadRegistry()\r\n   133\tif err != nil {\r\n   134\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   135\tos.Exit(1)\r\n   136\t}\r\n   137\tif len(entries) == 0 {\r\n   138\tfmt.Println(\"No models registered.\")\r\n"]
