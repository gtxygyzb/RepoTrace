[289.664049, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe remove <name>\\n\")\r\n   192\t\t\tos.Exit(1)\r\n   193\t\t}\r\n   194\t\tname := args[0]\r\n   195\t\r\n   196\t\tentries, err := loadRegistry()\r\n   197\t\tif err != nil {\r\n   198\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
