[9831.140691, "i", "cat > validate_input.go <<'EOF'\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n)\n\ntype validationIssue struct {\n\tRow         int\n\tDescription string\n}\n\ntype validationSummary struct {\n\tModelName        string\n\tExpectedFeatures int\n\tTotalRows        int\n\tValidRows        int\n\tInvalidRows      int\n\tMissingCells     int\n\tIssues           []validationIssue\n}\n\nfunc cmdValidateInput(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe validate-input <model> --input <file>\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tmodelName := args[0]\n\tflags := parseFlags(args[1:])\n\tinputFile := flags[\"input\"]\n\tif inputFile == \"\" {\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe validate-input <model> --input <file>\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tentry := resolveModel(modelName)\n\n\tweights, err := loadWeights(entry.Path)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tsummary := validateInputFile(entry.Name, inputFile, weights)\n\tprintValidationSummary(summary)\n\tif summary.InvalidRows > 0 "]
[9831.140936, "i", "{\n\t\tos.Exit(1)\n\t}\n}\n\nfunc validateInputFile(modelName, inputFile string, weights *WeightsData) *validationSummary {\n\trecords, err := readCSVRaw(inputFile)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\tfmt.Fprintln(os.Stderr, \"file not found\")\n\t\t} else {\n\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\n\t\t}\n\t\tos.Exit(1)\n\t}\n\n\texpected := int(weights.NumFeatures)\n\tstart := 0\n\tif len(records) > 0 && isHeader(records[0]) {\n\t\tstart = 1\n\t}\n\n\tsummary := &validationSummary{\n\t\tModelName:        modelName,\n\t\tExpectedFeatures: expected,\n\t\tTotalRows:        len(records) - start,\n\t}\n\n\tfor i := start; i < len(records); i++ {\n\t\trecord := records[i]\n\t\trowNum := i - start + 1\n\n\t\tvar issues []string\n\t\tif len(record) != expected {\n\t\t\tissues = append(issues, fmt.Sprintf(\"expected %d columns, got %d\", expected, len(record)))\n\t\t} else {\n\t\t\tfor j, val := range record {\n\t\t\t\tif isMissingValue(val) {\n\t\t\t\t\tsummary.MissingCells++\n\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"missing value in column %d\", j+1))\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t"]
[9831.141011, "i", "\t\tif _, err := strconv.ParseFloat(strings.TrimSpace(val), 64); err != nil {\n\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"non-numeric value in column %d: %s\", j+1, strings.TrimSpace(val)))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tif len(issues) > 0 {\n\t\t\tsummary.InvalidRows++\n\t\t\tsummary.Issues = append(summary.Issues, validationIssue{\n\t\t\t\tRow:         rowNum,\n\t\t\t\tDescription: strings.Join(issues, \"; \"),\n\t\t\t})\n\t\t} else {\n\t\t\tsummary.ValidRows++\n\t\t}\n\t}\n\n\treturn summary\n}\n\nfunc printValidationSummary(summary *validationSummary) {\n\tfmt.Printf(\"Validating input for model '%s' (%d features expected)\\n\", summary.ModelName, summary.ExpectedFeatures)\n\tfmt.Printf(\"Total rows:    %d\\n\", summary.TotalRows)\n\tfmt.Printf(\"Valid rows:    %d\\n\", summary.ValidRows)\n\tfmt.Printf(\"Invalid rows:  %d\\n\", summary.InvalidRows)\n\tfmt.Printf(\"Missing values: %d cells\\n\", summary.MissingCells)\n\n\tif len(summary.Issues) > 0 {\n\t\tfmt.Println(\"Issues:\")\n\t\tlimit := len(summary.Issues)\n\t\tif limit > 5 {\n\t\t\tlimit = 5\n\t\t}\n\t\tfor _, issue := range summary.Issues[:limit] {\n\t\t\tfm"]
