[9177.860078, "o", "\tos.Exit(1)\r\n    62\t}\r\n    63\t\r\n    64\tstrategy := flags[\"strategy\"]\r\n    65\tif strategy == \"\" || strategy == \"true\" {\r\n    66\tstrategy = \"average\"\r\n    67\t}\r\n    68\tif strategy != \"average\" && strategy != \"max\" && strategy != \"min\" {\r\n    69\tfmt.Fprintf(os.Stderr, \"error: invalid strategy '%s', use average, max, or min\\n\", strategy)\r\n    70\tos.Exit(1)\r\n    71\t}\r\n    72\t\r\n    73\tvar models []string\r\n    74\tfor _, m := range strings.Split(modelsStr, \",\") {\r\n    75\tm = strings.TrimSpace(m)\r\n"]
