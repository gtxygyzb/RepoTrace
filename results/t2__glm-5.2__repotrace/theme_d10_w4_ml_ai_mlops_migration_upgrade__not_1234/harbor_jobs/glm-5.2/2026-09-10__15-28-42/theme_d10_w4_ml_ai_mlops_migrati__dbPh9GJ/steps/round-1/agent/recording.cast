[9177.860432, "o", "   121\tif findEntry(entries, m) == nil {\r\n   122\tfmt.Printf(\"model not found: %s\\n\", m)\r\n   123\tos.Exit(1)\r\n   124\t}\r\n   125\t}\r\n   126\t\r\n   127\tvar outputDim int\r\n   128\tfor i, m := range models {\r\n   129\tentry := findEntry(entries, m)"]
