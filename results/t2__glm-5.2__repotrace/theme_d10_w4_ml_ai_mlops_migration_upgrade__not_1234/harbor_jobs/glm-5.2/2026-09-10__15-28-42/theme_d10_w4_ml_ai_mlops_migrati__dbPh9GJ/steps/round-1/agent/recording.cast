[7572.336139, "o", "\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn os.WriteFile(registryJSONFile, data, 0644)\r\n\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc ensureTags(tags []string) []string {\r\n\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif tags == nil {\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn []string{}\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn tags\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
