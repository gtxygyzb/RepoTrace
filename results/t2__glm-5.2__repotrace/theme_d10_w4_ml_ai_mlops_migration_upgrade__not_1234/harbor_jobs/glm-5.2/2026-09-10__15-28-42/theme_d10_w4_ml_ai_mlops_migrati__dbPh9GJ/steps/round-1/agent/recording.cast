[11325.305967, "o", "    50\t\tif err != nil {\r\n    51\t\t\tfmt.Fprintf(os.Stderr, \"error loading pipeline config: %v\\n\", err)\r\n    52\t\t\tos.Exit(1)\r\n    53\t\t}\r\n    54\t\r\n    55\t\tif flags[\"strict\"] == \"true\" {\r\n    56\t\t\tsummary := validateInputFile(modelName, inputFile, weights)\r\n    57\t\t\tif summary.InvalidRows > 0 {\r\n    58\t\t\t\tprintValidationSummary(summary)\r\n"]
[11325.306026, "o", "    59\t\t\t\tos.Exit(1)\r\n    60\t\t\t}\r\n    61\t\t}\r\n    62\t\r\n    63\t\tinputs, err := readInputCSV(inputFile)\r\n    64\t\tif err != nil {\r\n    65\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    66\t\t\tos.Exit(1)\r\n    67\t\t}\r\n    68\t\r\n"]
[11325.306088, "o", "    69\t\tif err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {\r\n    70\t\t\tfmt.Fprintf(os.Stderr, \"error: input feature count mismatch: %v\\n\", err)\r\n    71\t\t\tos.Exit(1)\r\n    72\t\t}\r\n    73\t\r\n    74\t\tresults := runInference(inputs, weights, pipelineCfg)\r\n    75\t\r\n    76\t\toutputFile := flags[\"output\"]\r\n"]
[11325.306153, "o", "    77\t\tif outputFile != \"\" {\r\n    78\t\t\tf, err := os.Create(outputFile)\r\n    79\t\t\tif err != nil {\r\n    80\t\t\t\tfmt.Fprintf(os.Stderr, \"error creating output file: %v\\n\", err)\r\n    81\t\t\t\tos.Exit(1)\r\n    82\t\t\t}\r\n    83\t\t\tdefer f.Close()\r\n    84\t\t\twriteOutput(f, results, outputFormat)\r\n    85\t\t} else {\r\n    86\t\t\twriteOutput(os.Stdout, results, outputFormat)\r\n"]
