[11341.21799, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"os\"\r\n     6\t\t\"path/filepath\"\r\n     7\t\t\"sort\"\r\n     8\t\t\"time\"\r\n     9\t)\r\n    10\t\r\n"]
[11341.218106, "o", "    11\tfunc checkpointsDir(modelDir string) string {\r\n    12\t\treturn filepath.Join(modelDir, \".checkpoints\")\r\n    13\t}\r\n    14\t\r\n    15\tfunc countCheckpoints(modelDir string) int {\r\n    16\t\tentries, err := os.ReadDir(checkpointsDir(modelDir))\r\n    17\t\tif err != nil {\r\n    18\t\t\treturn 0\r\n    19\t\t}\r\n    20\t\tcount := 0\r\n    21\t\tfor _, entry := range entries {\r\n    22\t\t\tif entry.IsDir() {\r\n    23\t\t\t\tcount++\r\n    24\t\t\t}\r\n    25\t\t}\r\n    26\t\treturn count\r\n    27\t}\r\n"]
[11341.218196, "o", "    28\t\r\n    29\tfunc cmdCheckpoint(args []string) {\r\n    30\t\tif len(args) < 1 {\r\n    31\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe checkpoint <model> [--name <name>]\\n\")\r\n    32\t\t\tos.Exit(1)\r\n    33\t\t}\r\n    34\t\tmodel := args[0]\r\n    35\t\tflags := parseFlags(args[1:])\r\n    36\t\r\n    37\t\tname := flags[\"name\"]\r\n    38\t\tif name == \"\" {\r\n    39\t\t\tname = \"cp-\" + time.Now().Format(\"20060102-150405\")\r\n"]
[11341.218302, "o", "    40\t\t}\r\n    41\t\r\n    42\t\tentry, err := resolveModel(model)\r\n    43\t\tif err != nil {\r\n    44\t\t\tfmt.Fprintf(os.Stderr, \"not found\\n\")\r\n    45\t\t\tos.Exit(1)\r\n    46\t\t}\r\n    47\t\r\n    48\t\tcpDir := filepath.Join(checkpointsDir(entry.Path), name)\r\n    49\t\tif _, err := os.Stat(cpDir); err == nil {\r\n    50\t\t\tfmt.Fprintf(os.Stderr, \"checkpoint already exists\\n\")\r\n    51\t\t\tos.Exit(1)\r\n    52\t\t}\r\n"]
[11341.218387, "o", "    53\t\r\n    54\t\tif err := os.MkdirAll(cpDir, 0755); err != nil {\r\n    55\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    56\t\t\tos.Exit(1)\r\n    57\t\t}\r\n    58\t\r\n    59\t\tfor _, file := range []string{\"weights.bin\", \"model.meta\", \"pipeline.cfg\"} {\r\n    60\t\t\tsrc := filepath.Join(entry.Path, file)\r\n    61\t\t\tdata, err := os.ReadFile(src)\r\n    62\t\t\tif err != nil {\r\n    63\t\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[11341.218472, "o", "    64\t\t\t\tos.Exit(1)\r\n    65\t\t\t}\r\n    66\t\t\tif err := os.WriteFile(filepath.Join(cpDir, file), data, 0644); err != nil {\r\n    67\t\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    68\t\t\t\tos.Exit(1)\r\n    69\t\t\t}\r\n    70\t\t}\r\n    71\t\r\n    72\t\tfmt.Printf(\"checkpoint '%s' created for '%s'\\n\", name, model)\r\n    73\t}\r\n    74\t\r\n    75\tfunc cmdCheckpoints(args []string) {\r\n    76\t\tif len(args) < 1 {\r\n    77\t\t\t"]
[11341.218549, "o", "fmt.Fprintf(os.Stderr, \"usage: mlpipe checkpoints <model>\\n\")\r\n    78\t\t\tos.Exit(1)\r\n    79\t\t}\r\n    80\t\tmodel := args[0]\r\n"]
