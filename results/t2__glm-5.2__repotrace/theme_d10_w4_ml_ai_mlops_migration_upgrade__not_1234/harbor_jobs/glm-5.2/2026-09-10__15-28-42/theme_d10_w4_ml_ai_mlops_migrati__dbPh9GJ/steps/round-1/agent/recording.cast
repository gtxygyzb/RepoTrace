[7803.668183, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('main.go')\ns = p.read_text()\nif 'case \"ensemble\":' not in s:\n    s = s.replace('case \"list\":\\n\\t\\tcmdList(args)\\n', 'case \"ensemble\":\\n\\t\\tcmdEnsemble(args)\\n\\tcase \"list\":\\n\\t\\tcmdList(args)\\n')\nif '  ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]' not in s:\n    s = s.replace('  checkpoint <model>           Manage model checkpoints\\n', '  checkpoint <model>           Manage model checkpoints\\n  ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]\\n  ensemble list                 List all ensembles\\n  ensemble run <name> --input <file> [--format csv|json]\\n  ensemble remove <name>        Remove an ensemble\\n')\np.write_text(s)\nPY\n"]
