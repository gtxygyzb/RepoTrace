[13350.825582, "o", "    88\tfunc printUsage() {\r\n    89\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    90\t\r\n    91\tUsage: mlpipe <command> [arguments]\r\n    92\t\r\n    93\tCommands:\r\n"]
[13350.825686, "o", "    94\t  list                          List all registered models\r\n    95\t  info <model>                  Show model details\r\n    96\t  register <name> <path>        Register a model from directory\r\n    97\t  remove <name>                 Remove a model from registry\r\n    98\t  run <model> [options]         Run inference\r\n    99\t  stats --input <file>          Input statistics profiling\r\n   100\t  diff <model1> <model2> --input <file>\r\n   101\t                                Compare two models on same input\r\n   102\t  compare <model1> <model2> [--input <file>]\r\n   103\t                                Generate detailed comparison report between two models\r\n   104\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n   105\t                                Batch inference over CSV files\r\n   106\t  validate <model>              Validate model integrity\r\n   107\t  validate-input <model> --input <file>\r\n"]
[13350.825767, "o", "   108\t                                Validate input data for a model\r\n   109\t  schema <model>                Display expected input schema for a model\r\n   110\t  export <model> --output <file> Export model to JSON file\r\n   111\t  import <path> [--name <name>] Import model from JSON file\r\n   112\t  clone <model> <new_name>      Clone model to new name\r\n   113\t  benchmark <model> --input <file> [--runs <N>]\r\n   114\t                                Benchmark inference performance\r\n   115\t  prune <model> --threshold <value> [--dry-run]\r\n   116\t                                Prune near-zero weights\r\n   117\t  profile <model>               Report model weight analysis\r\n   118\t  explain <model> --input <file> [--row <N>]\r\n   119\t                                  Explain prediction for a row\r\n"]
[13350.82586, "o", "   120\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n   121\t  compat [--all]                 Check migration compatibility\r\n   122\t  version                       Show version\r\n   123\t  help                          Show this help\r\n   124\t\r\n   125\tRun/Diff Options:\r\n   126\t  --input <file>    Input CSV file (required)\r\n   127\t  --output <file>   Output file (default: stdout)\r\n   128\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   129\t"]
[13350.825927, "o", "  --strict          Validate input before inference and abort on invalid rows\r\n   130\t\r\n   131\tBatch Options:\r\n   132\t  --dir <dir>       Input directory of CSV files\r\n   133\t  --output-dir <dir> Output directory for predictions\r\n   134\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   135\t`\r\n   136\t\tfmt.Print(usage)\r\n   137\t}\r\n   138\t\r\n"]
