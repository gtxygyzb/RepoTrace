[8987.486316, "o", "\r\nvar outputDim int\r\nfor i, m := range models {\r\nentry := findEntry(entries, m)\r\nweights, err := loadWeights(entry.Path)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error loading weights for model '%s': %v\\n\", m, err)\r\nos.Exit(1)\r\n}\r\nif i == 0 {\r\noutputDim = int(weights.NumOutputs)\r\n} else if int(weights.NumOutputs) != outputDim {\r\nfmt.Println(\"output dimension mismatch\")\r\nos.Exit(1)\r\n}\r\n}\r\n\r\n"]
[8987.486395, "o", "path := filepath.Join(ensemblesDir, name+\".json\")\r\nif _, err := os.Stat(path); err == nil {\r\nfmt.Println(\"ensemble already exists\")\r\nos.Exit(1)\r\n}\r\n\r\ncfg := ensembleConfig{\r\nName:     name,\r\nModels:   models,\r\nStrategy: strategy,\r\n}\r\nif err := saveEnsembleConfig(&cfg); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n"]
[8987.486457, "o", "\r\nfmt.Printf(\"ensemble '%s' created with %d models (strategy=%s)\\n\", name, len(models), strategy)\r\n}\r\n\r\nfunc cmdEnsembleList(args []string) {\r\nconfigs, err := listEnsembleConfigs()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\nif len(configs) == 0 {\r\nfmt.Println(\"no ensembles\")\r\nreturn\r\n}\r\nsort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })\r\nfor _, cfg := range configs {\r\nfmt.Printf(\"%s  %s  %d models\\n\", cfg.Name, cfg.Strategy, len(cfg.Models))\r\n}\r\n"]
[8987.486536, "o", "}\r\n\r\nfunc cmdEnsembleRun(args []string) {\r\nif len(args) < 1 {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble run <name> --input <file> [--format csv|json]\\n\")\r\nos.Exit(1)\r\n}\r\nname := args[0]\r\nflags := parseFlags(args[1:])\r\n\r\n"]
[8987.486596, "o", "inputFile := flags[\"input\"]\r\nif inputFile == \"\" || inputFile == \"true\" {\r\nfmt.Fprintf(os.Stderr, \"error: --input is required\\n\")\r\nos.Exit(1)\r\n}\r\n\r\noutputFormat := flags[\"format\"]\r\nif outputFormat == \"\" || outputFormat == \"true\" {\r\noutputFormat = \"csv\"\r\n}\r\n"]
