[4624.361346, "o", "   324\tfunc cmdClone(args []string) {\r\n   325\t\tif len(args) < 2 {\r\n   326\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe clone <model> <new_name>\\n\")\r\n   327\t\t\tos.Exit(1)\r\n"]
[4624.361435, "o", "   328\t\t}\r\n   329\t\tsourceName := args[0]\r\n   330\t\tnewName := args[1]\r\n   331\t\r\n   332\t\tentry, err := resolveModel(sourceName)\r\n   333\t\tif err != nil {\r\n"]
[4624.361504, "o", "   334\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   335\t\t\tos.Exit(1)\r\n   336\t\t}\r\n   337\t\r\n   338\t\tentries, err := loadRegistry()\r\n   339\t\tif err != nil {\r\n   340\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   341\t\t\tos.Exit(1)\r\n   342\t\t}\r\n   343\t\tif findEntry(entries, newName) != nil {\r\n   344\t\t\tfmt.Fprintf(os.Stderr, \"error: model already exists\\n\")\r\n   345\t\t\tos.Exit(1)\r\n   346\t\t}\r\n   347\t\r\n   348\t\tnewDir := filepath.Join(\"/app/models\", newName)\r\n"]
[4624.361571, "o", "   349\t\tif err := os.MkdirAll(newDir, 0755); err != nil {\r\n   350\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   351\t\t\tos.Exit(1)\r\n   352\t\t}\r\n   353\t\tif err := copyDir(entry.Path, newDir); err != nil {\r\n   354\t\t\tfmt.Fprintf(os.Stderr, \"error cloning model files: %v\\n\", err)\r\n   355\t\t\tos.Exit(1)\r\n"]
[4624.361635, "o", "   356\t\t}\r\n   357\t\r\n   358\t\tmeta, err := loadModelMeta(newDir)\r\n   359\t\tif err != nil {\r\n   360\t\t\tfmt.Fprintf(os.Stderr, \"error updating metadata: %v\\n\", err)\r\n   361\t\t\tos.Exit(1)\r\n   362\t\t}\r\n   363\t\tmeta[\"name\"] = newName\r\n   364\t"]
[4624.361697, "o", "\tif err := saveModelMeta(newDir, meta); err != nil {\r\n   365\t\t\tfmt.Fprintf(os.Stderr, \"error updating metadata: %v\\n\", err)\r\n   366\t\t\tos.Exit(1)\r\n   367\t\t}\r\n   368\t\r\n   369\t\tregistryVersion := entry.Version\r\n   370\t\tif registryVersion == 0 {\r\n   371\t\t\tregistryVersion = 1\r\n   372\t"]
[4624.361758, "o", "\t}\r\n   373\t\tentries = append(entries, RegistryEntry{\r\n   374\t\t\tName:    newName,\r\n   375\t\t\tPath:    newDir,\r\n   376\t\t\tType:    entry.Type,\r\n   377\t\t\tVersion: registryVersion,\r\n   378\t\t\tCreated: time.Now().Format(\"2006-01-02\"),\r\n   379\t\t})\r\n   380\t\tif err := saveRegistry(entries); err != nil {\r\n"]
[4624.361838, "o", "   381\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   382\t\t\tos.Exit(1)\r\n   383\t\t}\r\n   384\t\tfmt.Printf(\"Model '%s' cloned to '%s'.\\n\", sourceName, newName)\r\n   385\t}\r\n"]
