[11313.038968, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n"]
[11313.039048, "o", ")\r\n\r\nconst version = \"0.1.0\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcommand := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch command {\r\n\tcase \"ensemble\":\r\n\t\tcmdEnsemble(args)\r\n"]
[11313.039111, "o", "\tcase \"list\":\r\n\t\tcmdList(args)\r\n\tcase \"info\":\r\n\t\tcmdInfo(args)\r\n\tcase \"register\":\r\n\t\tcmdRegister(args)\r\n\tcase \"remove\":\r\n\t\tcmdRemove(args)\r\n\tcase \"tag\":\r\n\t\tcmdTag(args)\r\n\tcase \"untag\":"]
[11313.03917, "o", "\r\n\t\tcmdUntag(args)\r\n\tcase \"search\":\r\n\t\tcmdSearch(args)\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"stats\":\r\n\t\tcmdStats(args)\r\n\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n\tcase \"batch\":"]
[11313.039228, "o", "\r\n\t\tcmdBatch(args)\r\n\tcase \"profile\":\r\n\t\tcmdProfile(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"validate-input\":\r\n\t\tcmdValidateInput(args)\r\n\tcase \"schema\":\r\n\t\tcmdSchema(args)\r\n"]
[11313.039288, "o", "\tcase \"export\":\r\n\t\tcmdExport(args)\r\n\tcase \"import\":\r\n\t\tcmdImport(args)\r\n\tcase \"clone\":\r\n\t\tcmdClone(args)\r\n\tcase \"checkpoint\":\r\n\t\tcmdCheckpoint(args)\r\n\tcase \"checkpoints\":\r\n\t\tcmdCheckpoints(args)\r\n"]
[11313.039353, "o", "\tcase \"rollback\":\r\n\t\tcmdRollback(args)\r\n\tcase \"migrate\":\r\n\t\tcmdMigrate(args)\r\n\tcase \"compat\":\r\n\t\tcmdCompat(args)\r\n\tcase \"version\":\r\n\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n\tcase \"help\":\r\n\t\tprintUsage()\r\n"]
[11313.039415, "o", "\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc printUsage() {\r\n\tusage := `mlpipe - ML Inference Pipeline Manager\r\n\r\n"]
[11313.039473, "o", "Usage: mlpipe <command> [arguments]\r\n\r\nCommands:\r\n  list                          List all registered models\r\n  info <model>                  Show model details\r\n  register <name> <path>        Register a model from directory\r\n  remove <name>                 Remove a model from registry\r\n  run <model> [options]         Run inference\r\n  stats --input <file>          Input statistics profiling\r\n  diff <model1> <model2> --input <file>\r\n                                Compare two models on same input\r\n  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n                                Batch inference over CSV files\r\n  validate <model>              Validate model integrity\r\n"]
[11313.039543, "o", "  validate-input <model> --input <file>\r\n                                Validate input data for a model\r\n  schema <model>                Display expected input schema for a model\r\n"]
[11313.039647, "o", "  export <model> --output <file> Export model to JSON file\r\n  import <path> [--name <name>] Import model from JSON file\r\n  clone <model> <new_name>      Clone model to new name\r\n    profile <model>               Report model weight analysis\r\n  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n  compat [--all]                 Check migration compatibility\r\n  version                       Show version\r\n  help                          Show this help\r\n\r\nRun/Diff Options:\r\n  --input <file>    Input CSV file (required)\r\n  --output <file>   Output file (default: stdout)\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n  --strict          Validate input before inference and abort on invalid rows\r\n\r\nBatch Options:\r\n  --dir <dir>       Input directory of CSV files\r\n  --output-dir <dir> Output directory for predictions\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n`\r\n\tfmt.Print(usage)\r\n}\r\n\r\nfunc parseFlags(args []string) map[string]string {\r\n\tflags := make(map[s"]
[11313.039721, "o", "tring]string)\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tif strings.HasPrefix(args[i], \"--\") {\r\n\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n\t\t\t\tflags[key] = args[i+1]\r\n\t\t\t\ti++\r\n\t\t\t} else {\r\n\t\t\t\tflags[key] = \"true\"\r\n\t\t\t"]
[11313.039788, "o", "}\r\n\t\t}\r\n\t}\r\n\treturn flags\r\n}\r\n"]
