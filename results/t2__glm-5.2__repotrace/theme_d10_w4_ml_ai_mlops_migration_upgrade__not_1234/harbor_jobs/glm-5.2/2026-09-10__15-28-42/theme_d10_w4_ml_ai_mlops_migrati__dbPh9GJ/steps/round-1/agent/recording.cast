[9831.690058, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('inference.go')\ns = p.read_text()\nold = \"\\tpipelineCfg, err := loadPipelineConfig(entry.Path)\\n\\tif err != nil {\\n\\t\\tfmt.Fprintf(os.Stderr, \\\"error loading pipeline config: %v\\\\n\\\", err)\\n\\t\\tos.Exit(1)\\n\\t}\\n\\n\\tinputs, err := readInputCSV(inputFile)\\n\"\nnew = \"\\tpipelineCfg, err := loadPipelineConfig(entry.Path)\\n\\tif err != nil {\\n\\t\\tfmt.Fprintf(os.Stderr, \\\"error loading pipeline config: %v\\\\n\\\", err)\\n\\t\\tos.Exit(1)\\n\\t}\\n\\n\\tif flags[\\\"strict\\\"] == \\\"true\\\" {\\n\\t\\tsummary := validateInputFile(modelName, inputFile, weights)\\n\\t\\tif summary.InvalidRows > 0 {\\n\\t\\t\\tprintValidationSummary(summary)\\n\\t\\t\\tos.Exit(1)\\n\\t\\t}\\n\\t}\\n\\n\\tinputs, err := readInputCSV(inputFile)\\n\"\nif old not in s:\n    raise SystemExit('target block not found')\ns = s.replace(old, new, 1)\np.write_text(s)\nPY\n"]
