[9667.337712, "o", "\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor o := uint32(0); o < weights.\u001b[01;31m\u001b[KNumOutputs\u001b[m\u001b[K; o++ {\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tstart := o * weights.\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tend := start + weights.\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\trow := make([]float64, weights.\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K)\r\n"]
