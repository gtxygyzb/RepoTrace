[903.34175, "o", "     6\t\t\"strings\"\r\n     7\t)\r\n     8\t\r\n     9\tconst version = \"0.1.0\"\r\n    10\t\r\n    11\tfunc main() {\r\n    12\t\tif len(os.Args) < 2 {\r\n    13\t\t\tprintUsage()\r\n    14\t\t\tos.Exit(1)\r\n    15\t\t}\r\n    16\t\r\n    17\t\tcommand := os.Args[1]\r\n    18\t\targs := os.Args[2:]\r\n"]
[903.341846, "o", "    19\t\r\n    20\t\tswitch command {\r\n    21\t\tcase \"list\":\r\n    22\t\t\tcmdList(args)\r\n    23\t\tcase \"info\":\r\n    24\t\t\tcmdInfo(args)\r\n    25\t\tcase \"register\":\r\n    26\t\t\tcmdRegister(args)\r\n    27\t"]
[903.341912, "o", "\tcase \"remove\":\r\n    28\t\t\tcmdRemove(args)\r\n    29\t\tcase \"run\":\r\n    30\t\t\tcmdRun(args)\r\n    31\t\tcase \"validate\":\r\n    32\t\t\tcmdValidate(args)\r\n    33\t\tcase \"export\":\r\n    34\t\t\tcmdExport(args)\r\n    35\t\tcase \"version\":\r\n    36\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    37\t\tcase \"help\":\r\n    38\t\t\tprintUsage()\r\n    39\t\tdefault:\r\n    40\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n"]
[903.341977, "o", "    41\t\t\tprintUsage()\r\n    42\t\t\tos.Exit(1)\r\n    43\t\t}\r\n    44\t}\r\n    45\t\r\n    46\tfunc printUsage() {"]
[903.342041, "o", "\r\n    47\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    48\t\r\n    49\tUsage: mlpipe <command> [arguments]\r\n    50\t\r\n    51\tCommands:\r\n    52\t  list                          List all registered models\r\n    53\t  info <model>                  Show model details\r\n    54\t  register <name> <path>        Register a model from directory\r\n    55\t  remove <name>                 Remove a model from registry\r\n    56\t  run <model> [options]         Run inference\r\n    57\t  validate <model>              Validate model integrity\r\n    58\t  export <model> --output <dir> Export model to directory\r\n"]
[903.342112, "o", "    59\t  version                       Show version\r\n    60\t  help                          Show this help\r\n    61\t\r\n    62\tRun Options:\r\n    63\t  --input <file>    Input CSV file (required)\r\n    64\t  --output <file>   Output file (default: stdout)\r\n    65\t  --format <fmt>    Output format: csv or json (default: csv)\r\n    66\t`\r\n    67\t\tfmt.Print(usage)\r\n"]
[903.342176, "o", "    68\t}\r\n    69\t\r\n    70\tfunc parseFlags(args []string) map[string]string {\r\n    71\t\tflags := make(map[string]string)\r\n    72\t\tfor i := 0; i < len(args); i++ {\r\n    73\t\t\tif strings.HasPrefix(args[i], \"--\") {\r\n    74\t\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n    75\t\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n    76\t\t\t\t\tflags[key] = args[i+1]\r\n    77\t\t\t\t\ti++\r\n"]
[903.342239, "o", "    78\t\t\t\t} else {\r\n    79\t\t\t\t\tflags[key] = \"true\"\r\n    80\t\t\t\t}\r\n    81\t\t\t}\r\n    82\t\t}\r\n    83\t\treturn flags\r\n    84\t}\r\n"]
