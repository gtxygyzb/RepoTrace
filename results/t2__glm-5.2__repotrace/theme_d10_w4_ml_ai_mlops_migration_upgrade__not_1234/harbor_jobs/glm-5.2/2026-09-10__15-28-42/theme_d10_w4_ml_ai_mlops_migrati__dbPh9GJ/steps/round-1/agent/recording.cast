[8961.913264, "o", "\tName     string   `json:\"name\"`\r\n    16\tModels   []string `json:\"models\"`\r\n    17\tStrategy string   `json:\"strategy\"`\r\n    18\t}\r\n    19\t\r\n    20\tfunc cmdEnsemble(args []string) {\r\n    21\tif len(args) < 1 {\r\n    22\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble <create|list|run|remove> [arguments]\\n\")\r\n    23\tos.Exit(1)\r\n    24\t}\r\n    25\t\r\n    26\tsub := args[0]\r\n    27\trest := args[1:]\r\n    28\tswitch sub {\r\n    29\tcase \"create\":\r\n    30\tcmdEnsembleCreate(rest)\r\n    31\tcase \"list\":\r\n    32\tcmdEnsembleList(rest)\r\n    33\tcase \"run\":\r\n    34\tcmdEnsembleRun(rest)\r\n    35\tcase \"remove\":\r\n    36\tcmdEnsembleRemove(rest)\r\n    37\tdefault:\r\n    38\tfmt.Fprintf(os.Stderr, \"unknown ensemble command: %s\\n\", sub)\r\n    39\tos.Exit(1)\r\n    40\t}\r\n    41\t}\r\n    42\t\r\n    43\tfunc cmdEnsembleCreate(args []string) {\r\n    44\tflags := parseFlags(args)\r\n    45\t\r\n    46\tif len(args) < 1 || strings.HasPrefix(args[0], \"--\") {\r\n    47\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]\\n"]
[8961.913381, "o", "\")\r\n    48\tos.Exit(1)\r\n    49\t}\r\n    50\tname := args[0]\r\n    51\t\r\n    52\tmodelsStr := flags[\"models\"]\r\n    53\tif modelsStr == \"\" || modelsStr == \"true\" {\r\n    54\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]\\n\")\r\n    55\tos.Exit(1)\r\n    56\t}\r\n    57\t\r\n    58\tstrategy := flags[\"strategy\"]\r\n    59\tif strategy == \"\" || strategy == \"true\" {\r\n    60\tstrategy = \"average\"\r\n    61\t}\r\n    62\tif strategy != \"average\" && strategy != \"max\" && strategy != \"min\" {\r\n    63\tfmt.Fprintf(os.Stderr, \"error: invalid strategy '%s', use average, max, or min\\n\", strategy)\r\n    64\tos.Exit(1)\r\n    65\t}\r\n    66\t\r\n    67\tvar models []string\r\n    68\tfor _, m := range strings.Split(modelsStr, \",\") {\r\n    69\tm = strings.TrimSpace(m)\r\n    70\tif m != \"\" {\r\n    71\tmodels = append(models, m)\r\n    72\t}\r\n    73\t}\r\n    74\tif len(models) == 0 {\r\n    75\tfmt.Fprintf(os.Stderr, \"error: at least one model is required\\n\")\r\n    76\tos.Exit(1)\r\n    77\t}\r\n    78\t\r\n    79\tentries, err := loadRegist"]
