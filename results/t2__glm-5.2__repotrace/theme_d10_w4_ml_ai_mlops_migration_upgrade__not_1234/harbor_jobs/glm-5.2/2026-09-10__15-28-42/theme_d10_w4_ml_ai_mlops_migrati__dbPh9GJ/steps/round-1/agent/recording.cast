[251.445364, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/csv\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n"]
[251.445492, "o", "     7\t\t\"math\"\r\n     8\t\t\"os\"\r\n     9\t\t\"strconv\"\r\n    10\t\t\"strings\"\r\n    11\t)\r\n    12\t\r\n    13\tfunc cmdRun(args []string) {\r\n    14\t\tif len(args) < 1 {\r\n    15\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe run <model> [--input <file>] [--output <file>] [--format csv|json]\\n\")\r\n    16\t\t\tos.Exit(1)\r\n    17\t\t}\r\n    18\t\r\n    19\t\tmodelName := args[0]\r\n    20\t\tflags := parseFlags(args[1:])\r\n    21\t\r\n    22\t\tinputFile := flags[\"input\"]\r\n    23\t\tif inputFile == \"\" {\r\n    24\t\t\tfmt.Fprintf(os.Stderr, \"error: --input is required\\n\")\r\n"]
[251.44565, "o", "    25\t\t\tos.Exit(1)\r\n    26\t\t}\r\n    27\t\r\n    28\t\toutputFormat := flags[\"format\"]\r\n    29\t\tif outputFormat == \"\" {\r\n    30\t\t\toutputFormat = \"csv\"\r\n    31\t\t}\r\n    32\t\tif outputFormat != \"csv\" && outputFormat != \"json\" {\r\n    33\t\t\tfmt.Fprintf(os.Stderr, \"error: unsupported format '%s', use 'csv' or 'json'\\n\", outputFormat)\r\n    34\t\t\tos.Exit(1)\r\n    35\t\t}\r\n    36\t\r\n    37\t\tentries, err := loadRegistry()\r\n    38\t\tif err != nil {\r\n    39\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    40\t\t\tos.Exit(1)\r\n    41\t\t}\r\n    42\t\r\n    43\t\tentry := findEntry(entries, modelName)\r\n    44\t\tif entry == nil {\r\n    45\t\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", modelName)\r\n"]
[251.445781, "o", "    46\t\t\tos.Exit(1)\r\n    47\t\t}\r\n    48\t\r\n    49\t\tweights, err := loadWeights(entry.Path)\r\n    50\t\tif err != nil {\r\n    51\t\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n    52\t\t\tos.Exit(1)\r\n    53\t\t}\r\n    54\t\r\n    55\t\tpipelineCfg, err := loadPipelineConfig(entry.Path)\r\n    56\t\tif err != nil {\r\n    57\t\t\tfmt.Fprintf(os.Stderr, \"error loading pipeline config: %v\\n\", err)\r\n    58\t\t\tos.Exit(1)\r\n    59\t\t}\r\n    60\t\r\n    61\t\tinputs, err := readInputCSV(inputFile)\r\n    62\t\tif err != nil {\r\n    63"]
[251.44594, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    64\t\t\tos.Exit(1)\r\n    65\t\t}\r\n    66\t\r\n    67\t\tresults := runInference(inputs, weights, pipelineCfg)\r\n    68\t\r\n    69\t\toutputFile := flags[\"output\"]\r\n    70\t\tif outputFile != \"\" {\r\n    71\t\t\tf, err := os.Create(outputFile)\r\n    72\t\t\tif err != nil {\r\n    73\t\t\t\tfmt.Fprintf(os.Stderr, \"error creating output file: %v\\n\", err)\r\n    74\t\t\t\tos.Exit(1)\r\n    75\t\t\t}\r\n    76\t\t\tdefer f.Close()\r\n    77\t\t\twriteOutput(f, results, outputFormat)\r\n    78\t\t} else {\r\n    79\t\t\twriteOutput(os.Stdout, results, outputFormat)\r\n    80\t\t}\r\n    81\t}\r\n"]
[251.446032, "o", "    82\t\r\n    83\tfunc readInputCSV(path string) ([][]float64, error) {\r\n    84\t\tf, err := os.Open(path)\r\n    85\t\tif err != nil {\r\n    86\t\t\treturn nil, err\r\n    87\t\t}\r\n    88\t\tdefer f.Close()\r\n    89\t\r\n    90\t\treader := csv.NewReader(f)\r\n    91\t\trecords, err := reader.ReadAll()\r\n    92\t\tif err != nil {\r\n    93\t\t\treturn nil, err\r\n"]
[251.446101, "o", "    94\t\t}\r\n    95\t\r\n    96\t\tvar data [][]float64\r\n    97\t\tfor i, record := range records {\r\n    98\t\t\tif i == 0 && isHeader(record) {\r\n    99\t\t\t\tcontinue\r\n   100\t\t\t}\r\n   101\t\t\trow := make([]float64, len(record))\r\n   102\t\t\tfor j, val := range record {\r\n"]
[251.446179, "o", "   103\t\t\t\tval = strings.TrimSpace(val)\r\n   104\t\t\t\tif val == \"\" || val == \"NA\" || val == \"nan\" {\r\n   105\t\t\t\t\trow[j] = math.NaN()\r\n   106\t\t\t\t} else {\r\n   107\t\t\t\t\trow[j], err = strconv.ParseFloat(val, 64)\r\n   108\t\t\t\t\tif err != nil {\r\n   109\t\t\t\t\t\treturn nil, fmt.Errorf(\"row %d col %d: %v\", i, j, err)\r\n   110\t\t\t\t\t}\r\n"]
[251.446271, "o", "   111\t\t\t\t}\r\n   112\t\t\t}\r\n   113\t\t\tdata = append(data, row)\r\n   114\t\t}\r\n   115\t\treturn data, nil\r\n   116\t}\r\n   117\t\r\n   118\tfunc isHeader(record []string) bool {\r\n   119\t\tfor _, val := range record {\r\n   120\t\t\t_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)\r\n   121\t\t\tif err == nil {\r\n   122\t\t\t\treturn false\r\n   123\t\t\t}\r\n   124\t\t}\r\n"]
[251.446353, "o", "   125\t\treturn true\r\n   126\t}\r\n   127\t\r\n   128\tfunc runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n   129\t\tprocessed := preprocess(inputs, cfg)\r\n"]
[251.446459, "o", "   130\t\r\n   131\t\tresults := make([][]float64, len(processed))\r\n   132\t\tfor i, row := range processed {\r\n   133\t\t\toutput := make([]float64, weights.NumOutputs)\r\n   134\t\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n   135\t\t\t\tsum := weights.Bias[o]\r\n   136\t\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n   137\t\t\t\t\tif int(f) < len(row) {\r\n   138\t\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n   139\t\t\t\t\t}\r\n   140\t\t\t\t}\r\n   141\t\t\t\toutput[o] = sum\r\n   142\t\t\t}\r\n   143\t\t\tresults[i] = output\r\n   144\t\t}\r\n   145\t\r\n   146\t\treturn postprocess(results, cfg)\r\n   147\t}\r\n   148\t\r\n"]
[251.446554, "o", "   149\tfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   150\t\tresult := make([][]float64, len(inputs))\r\n   151\t\tfor i, row := range inputs {\r\n   152\t\t\tresult[i] = make([]float64, len(row))\r\n   153\t\t\tcopy(result[i], row)\r\n   154\t\t}\r\n   155\t\r\n   156\t\tfor i, row := range result {\r\n   157\t\t\tfor j, val := range row {\r\n   158\t\t\t\tif math.IsNaN(val) {\r\n   159\t\t\t\t\tswitch cfg.MissingStrategy {\r\n   160\t\t\t\t\tcase \"zero\":\r\n"]
[251.446645, "o", "   161\t\t\t\t\t\tresult[i][j] = 0.0\r\n   162\t\t\t\t\tcase \"mean\":\r\n   163\t\t\t\t\t\tresult[i][j] = computeColumnMean(inputs, j)\r\n   164\t\t\t\t\t}\r\n   165\t\t\t\t}\r\n   166\t\t\t}\r\n   167\t\t}\r\n   168\t\r\n   169\t\tif cfg.Normalize {\r\n   170\t\t\tfor j := 0; j < len(result[0]); j++ {\r\n"]
[251.446737, "o", "   171\t\t\t\tminVal, maxVal := columnMinMax(result, j)\r\n   172\t\t\t\trangeVal := maxVal - minVal\r\n   173\t\t\t\tif rangeVal == 0 {\r\n   174\t\t\t\t\trangeVal = 1.0\r\n   175\t\t\t\t}\r\n   176\t\t\t\tfor i := range result {\r\n   177\t\t\t\t\t// BUG: normalization formula incorrect - should map to [ScaleMin, ScaleMax]\r\n   178\t\t\t\t\t// but uses wrong formula that doesn't properly apply the target range\r\n"]
[251.446831, "o", "   179\t\t\t\t\tnormalized := (result[i][j] - minVal) / rangeVal\r\n   180\t\t\t\t\tresult[i][j] = normalized * cfg.ScaleMax\r\n   181\t\t\t\t}\r\n   182\t\t\t}\r\n   183\t\t}\r\n   184\t\r\n   185\t\treturn result\r\n   186\t}\r\n   187\t\r\n   188\tfunc postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   189\t\tfor i, row := range results {\r\n   190\t\t\tfor j, val := range row {\r\n   191\t\t\t\tval = math.Max(val, cfg.ClipMin)\r\n   192\t\t\t\tval = math.Min(val, cfg.ClipMax)\r\n   193\t\t\t\tresults[i][j] = roundToDigits(val, cfg.RoundDigits)\r\n   194\t\t\t}\r\n"]
[251.446909, "o", "   195\t\t}\r\n   196\t\treturn results\r\n   197\t}\r\n   198\t\r\n   199\tfunc computeColumnMean(data [][]float64, col int) float64 {\r\n   200\t\tsum := 0.0\r\n   201\t\tcount := 0\r\n   202\t\tfor _, row := range data {\r\n   203\t\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n   204\t\t\t\tsum += row[col]\r\n   205\t\t\t\tcount++\r\n   206"]
[251.446995, "o", "\t\t\t}\r\n   207\t\t}\r\n   208\t\tif count == 0 {\r\n   209\t\t\treturn 0.0\r\n   210\t\t}\r\n   211\t\treturn sum / float64(count)\r\n   212\t}\r\n   213\t\r\n   214\tfunc columnMinMax(data [][]float64, col int) (float64, float64) {\r\n   215\t\tminVal := math.Inf(1)\r\n   216\t\tmaxVal := math.Inf(-1)\r\n"]
[251.447074, "o", "   217\t\tfor _, row := range data {\r\n   218\t\t\tif col < len(row) {\r\n   219\t\t\t\tif row[col] < minVal {\r\n   220\t\t\t\t\tminVal = row[col]\r\n   221\t\t\t\t}\r\n   222\t\t\t\tif row[col] > maxVal {\r\n   223\t\t\t\t\tmaxVal = row[col]\r\n   224\t\t\t\t}\r\n   225\t\t\t}\r\n   226\t\t}\r\n   227\t\treturn minVal, maxVal\r\n   228\t}\r\n"]
[251.447132, "o", "   229\t\r\n   230\tfunc writeOutput(f *os.File, results [][]float64, format string) {\r\n   231\t\tswitch format {\r\n   232\t\tcase \"csv\":\r\n   233\t\t\twriter := csv.NewWriter(f)\r\n   234\t\t\theader := make([]string, len(results[0]))\r\n   235\t\t\tfor i := range header {\r\n   236\t\t\t\theader[i] = fmt.Sprintf(\"output_%d\", i)\r\n"]
[251.447241, "o", "   237\t\t\t}\r\n   238\t\t\twriter.Write(header)\r\n   239\t\t\tfor _, row := range results {\r\n   240\t\t\t\trecord := make([]string, len(row))\r\n   241\t\t\t\tfor j, val := range row {\r\n   242\t\t\t\t\trecord[j] = strconv.FormatFloat(val, 'f', -1, 64)\r\n   243\t\t\t\t}\r\n   244\t\t\t\twriter.Write(record)\r\n   245\t\t\t}\r\n   246\t\t\twriter.Flush()\r\n   247\t\tcase \"json\":\r\n   248\t\t\ttype Prediction struct {\r\n   249\t\t\t\tOutputs []float64 `json:\"outputs\"`\r\n   250\t\t\t}\r\n"]
[251.447323, "o", "   251\t\t\ttype Result struct {\r\n   252\t\t\t\tPredictions []Prediction `json:\"predictions\"`\r\n   253\t\t\t}\r\n   254\t\t\tr := Result{}\r\n   255\t\t\tfor _, row := range results {\r\n   256\t\t\t\tr.Predictions = append(r.Predictions, Prediction{Outputs: row})\r\n   257\t\t\t}\r\n   258\t\t\tenc := json.NewEncoder(f)\r\n   259\t\t\tenc.SetIndent(\"\", \"  \")\r\n   260\t\t\tenc.Encode(r)\r\n   261\t\t}\r\n   262\t}\r\n"]
