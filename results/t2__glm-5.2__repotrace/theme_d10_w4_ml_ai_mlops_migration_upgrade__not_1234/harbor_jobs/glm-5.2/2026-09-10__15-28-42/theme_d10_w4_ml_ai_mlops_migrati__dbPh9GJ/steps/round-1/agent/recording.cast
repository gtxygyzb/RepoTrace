[9603.649149, "o", "    88\t\t\t\tVersion: ver,\r\n    89\t\t\t\tCreated: parts[4],\r\n    90\t\t\t\tTags:    []string{},\r\n    91\t\t\t})\r\n    92\t\t}\r\n    93\t\treturn entries, scanner.Err()\r\n    94\t}\r\n    95\t\r\n"]
[9603.649208, "o", "    96\tfunc saveRegistry(entries []RegistryEntry) error {\r\n    97\t\tdir := filepath.Dir(registryJSONFile)\r\n    98\t\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n    99\t\t\treturn err\r\n   100\t\t}\r\n   101\t\r\n   102\t\tout := make([]RegistryEntry, len(entries))\r\n   103\t\tfor i, e := range entries {\r\n   104\t\t\te.Tags = ensureTags(e.Tags)\r\n"]
