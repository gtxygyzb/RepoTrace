[12050.187377, "o", "\t\tif len(args) < 1 {\r\n   208\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble run <name> --input <file> [--format csv|json]\\n\")\r\n   209\t\t\tos.Exit(1)\r\n   210\t\t}\r\n   211\t\tname := args[0]\r\n   212\t\tflags := parseFlags(args[1:])\r\n   213\t\r\n   214\t\tinputFile := flags[\"input\"]\r\n   215\t\tif inputFile == \"\" || inputFile == \"true\" {\r\n   216\t\t\tfmt.Fprintf(os.Stderr, \"error: --input is required\\n\")\r\n   217\t\t\tos.Exit(1)\r\n   218\t\t}\r\n   219\t\r\n   220\t\toutputFormat := flags[\"format\"]\r\n"]
