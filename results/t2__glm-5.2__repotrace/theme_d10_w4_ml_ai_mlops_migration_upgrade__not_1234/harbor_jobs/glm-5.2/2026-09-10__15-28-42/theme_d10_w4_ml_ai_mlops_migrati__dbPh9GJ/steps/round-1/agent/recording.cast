[7572.335975, "o", "\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor i, e := range entries {\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\te.Tags = ensureTags(e.Tags)\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tout[i] = e\r\n\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
