[7639.08494, "i", "python3 - <<'PY'\nfrom pathlib import Path\nfor fn, ranges in [('inference.go', [(13,90),(127,155),(231,290)]), ('format.go', [(1,60)])]:\n    lines=Path(fn).read_text().splitlines()\n    print(f'--- {fn} ---')\n    for a,b in ranges:\n        print(f'--- lines {a}-{b} ---')\n        for i in range(a-1, min(b, len(lines))):\n            print(f'{i+1:4d}: {lines[i]}')\nPY\n"]
