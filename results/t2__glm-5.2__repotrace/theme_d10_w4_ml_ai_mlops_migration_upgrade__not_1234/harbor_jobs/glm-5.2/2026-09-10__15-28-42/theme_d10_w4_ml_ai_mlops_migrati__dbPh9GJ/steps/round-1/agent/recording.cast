[1928.543707, "o", "    82\t\t}\r\n    83\t\r\n    84\t\trecords, err := readCSVRaw(input)\r\n    85\t\tif err != nil {\r\n    86\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    87\t\t\tos.Exit(1)\r\n    88\t\t}\r\n    89\t\tif len(records) == 0 {\r\n    90\t\t\tfmt.Println(\"No data found.\")\r\n    91\t\t\treturn\r\n    92\t\t}\r\n    93\t\r\n"]
