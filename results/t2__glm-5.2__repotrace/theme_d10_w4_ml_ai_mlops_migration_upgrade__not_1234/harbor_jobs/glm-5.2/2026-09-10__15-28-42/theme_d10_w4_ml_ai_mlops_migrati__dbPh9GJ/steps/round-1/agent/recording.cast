[1915.676191, "o", "\r\n     8\t\r\n     9\tconst version = \"0.1.0\"\r\n    10\t\r\n    11\tfunc main() {\r\n"]
[1915.676283, "o", "    12\t\tif len(os.Args) < 2 {\r\n"]
[1915.67631, "o", "    13\t\t\tprintUsage()\r\n    14\t\t\tos.Exit(1)\r\n    15\t\t}\r\n    16\t\r\n    17\t\tcommand := os.Args[1]\r\n    18\t\targs := os.Args[2:]\r\n    19\t\r\n    20\t\tswitch command {\r\n    21\t\tcase \"list\":\r\n    22\t\t\tcmdList(args)\r\n    23\t\tcase \"info\":\r\n    24\t\t\tcmdInfo(args)\r\n    25\t\tcase \"register\":\r\n    26\t\t\tcmdRegister(args)\r\n    27\t\tcase \"remove\":\r\n"]
[1915.676387, "o", "    28\t\t\tcmdRemove(args)\r\n    29\t\tcase \"run\":\r\n    30\t\t\tcmdRun(args)\r\n    31\t\tcase \"stats\":\r\n    32\t\t\tcmdStats(args)\r\n    33\t\tcase \"diff\":\r\n    34\t\t\tcmdDiff(args)\r\n    35\t\tcase \"batch\":\r\n    36\t\t\tcmdBatch(args)\r\n    37\t\tcase \"validate\":\r\n    38\t"]
[1915.67644, "o", "\t\tcmdValidate(args)\r\n"]
[1915.676493, "o", "    39\t\tcase \"export\":\r\n    40\t\t\tcmdExport(args)\r\n    41\t\tcase \"version\":\r\n    42\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    43\t\tcase \"help\":\r\n    44\t\t\tprintUsage()\r\n    45\t\tdefault:\r\n    46\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    47\t\t\tprintUsage()\r\n    48\t\t\tos.Exit(1)\r\n"]
[1915.67655, "o", "    49\t\t}\r\n    50\t}\r\n    51\t\r\n    52\tfunc printUsage() {\r\n    53\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    54\t\r\n    55\tUsage: mlpipe <command> [arguments]\r\n"]
[1915.676606, "o", "    56\t\r\n    57\tCommands:\r\n    58\t  list                          List all registered models\r\n    59\t  info <model>                  Show model details\r\n    60\t  register <name> <path>        Register a model from directory\r\n    61\t  remove <name>                 Remove a model from registry\r\n    62\t  run <model> [options]         Run inference\r\n    63\t  stats --input <file>          Input statistics profiling\r\n"]
[1915.676659, "o", "    64\t  diff <model1> <model2> --input <file>\r\n    65\t                                Compare two models on same input\r\n    66\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n    67\t                                Batch inference over CSV files\r\n    68\t  validate <model>              Validate model integrity\r\n    69\t  export <model> --output <dir> Export model to directory\r\n    70\t  version                       Show version\r\n    71\t  help                          Show this help\r\n    72\t\r\n"]
[1915.676714, "o", "    73\tRun/Diff Options:\r\n    74\t  --input <file>    Input CSV file (required)\r\n    75\t  --output <file>   Output file (default: stdout)\r\n    76\t  --format <fmt>    Output format: csv or json (default: csv)\r\n    77\t\r\n    78\tBatch Options:\r\n    79\t  --dir <dir>       Input directory of CSV files\r\n    80\t  --output-dir <dir> Output directory for predictions\r\n    81\t"]
[1915.676738, "o", "  --format <fmt>    Output format: csv or json (default: csv)\r\n    82\t`\r\n    83\t\tfmt.Print(usage)\r\n    84\t}\r\n    85\t\r\n    86\tfunc parseFlags(args []string) map[string]string {\r\n    87\t\tflags := make(map[string]string)\r\n    88\t\tfor i := 0; i < len(args); i++ {\r\n"]
[1915.67682, "o", "    89\t\t\tif strings.HasPrefix(args[i], \"--\") {\r\n    90\t\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n    91\t\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n    92\t\t\t\t\tflags[key] = args[i+1]\r\n    93\t\t\t\t\ti++\r\n    94\t\t\t\t} else {\r\n    95\t\t\t\t\tflags[key] = \"true\"\r\n    96\t\t\t\t}\r\n    97\t\t\t}\r\n    98\t\t}\r\n    99\t\treturn flags\r\n   100\t}\r\n"]
