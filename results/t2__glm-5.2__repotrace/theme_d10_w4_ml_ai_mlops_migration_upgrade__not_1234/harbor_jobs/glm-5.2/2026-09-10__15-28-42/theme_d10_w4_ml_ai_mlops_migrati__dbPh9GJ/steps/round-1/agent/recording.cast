[9603.377244, "o", "   189\t\t\t\t}\r\n   190\t\t\t\tmean := sum / float64(count)\r\n   191\t\t\t\tvariance := sumSq/float64(count) - mean*mean\r\n   192\t\t\t\tif variance < 0 {\r\n   193\t\t\t\t\tvariance = 0\r\n   194\t\t\t\t}\r\n   195\t\t\t\tst.min = minVal\r\n"]
[9603.377304, "o", "   196\t\t\t\tst.max = maxVal\r\n   197\t\t\t\tst.mean = mean\r\n   198\t\t\t\tst.stddev = math.Sqrt(variance)\r\n   199\t\t\t}\r\n"]
