[8961.914165, "o", "\tos.Exit(1)\r\n   215\t}\r\n   216\t\r\n   217\tresults := runInference(inputs, weights, pipelineCfg)\r\n   218\tallOutputs = append(allOutputs, results)\r\n   219\t}\r\n   220\t\r\n   221\tif len(allOutputs) == 0 {\r\n   222\tfmt.Fprintf(os.Stderr, \"error: ensemble '%s' has no models\\n\", name)\r\n   223\tos.Exit(1)\r\n   224\t}\r\n   225\t\r\n   226\tcombined := combineEnsembleOutputs(allOutputs, cfg.Strategy)\r\n   227\t\r\n   228\toutputFile := flags[\"output\"]\r\n   229\tif outputFile != \"\" && outputFile != \"true\" {\r\n   230\tf, err := os.Create(outputFile)\r\n   231\tif err != nil {\r\n   232\tfmt.Fprintf(os.Stderr, \"error creating output file: %v\\n\", err)\r\n   233\tos.Exit(1)\r\n   234\t}\r\n   235\tdefer f.Close()\r\n   236\twriteOutput(f, combined, outputFormat)\r\n   237\t} else {\r\n   238\twriteOutput(os.Stdout, combined, outputFormat)\r\n   239\t}\r\n   240\t}\r\n   241\t\r\n   242\tfunc cmdEnsembleRemove(args []string) {\r\n   243\tif len(args) < 1 {\r\n   244\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble remove <name>\\n\")\r\n   245\tos.Exit(1)\r\n   246\t}\r\n   247\tname := args[0]\r\n   24"]
[8961.914255, "o", "8\t\r\n   249\tpath := filepath.Join(ensemblesDir, name+\".json\")\r\n   250\tif _, err := os.Stat(path); err != nil {\r\n   251\tfmt.Println(\"ensemble not found\")\r\n   252\tos.Exit(1)\r\n   253\t}\r\n   254\tif err := os.Remove(path); err != nil {\r\n   255\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   256\tos.Exit(1)\r\n   257\t}\r\n   258\tfmt.Printf(\"ensemble '%s' removed\\n\", name)\r\n   259\t}\r\n   260\t\r\n   261\tfunc saveEnsembleConfig(cfg *ensembleConfig) error {\r\n   262\tif err := os.MkdirAll(ensemblesDir, 0755); err != nil {\r\n   263\treturn err\r\n   264\t}\r\n   265\tdata, err := json.MarshalIndent(cfg, \"\", \"  \")\r\n   266\tif err != nil {\r\n   267\treturn err\r\n   268\t}\r\n   269\treturn os.WriteFile(filepath.Join(ensemblesDir, cfg.Name+\".json\"), data, 0644)\r\n   270\t}\r\n   271\t\r\n   272\tfunc loadEnsembleConfig(name string) (*ensembleConfig, error) {\r\n   273\tdata, err := os.ReadFile(filepath.Join(ensemblesDir, name+\".json\"))\r\n   274\tif err != nil {\r\n   275\treturn nil, err\r\n   276\t}\r\n   277\tvar cfg ensembleConfig\r\n   278\t"]
[8961.914346, "o", "if err := json.Unmarshal(data, &cfg); err != nil {\r\n   279\treturn nil, err\r\n   280\t}\r\n   281\treturn &cfg, nil\r\n   282\t}\r\n   283\t\r\n   284\tfunc listEnsembleConfigs() ([]*ensembleConfig, error) {\r\n   285\tfiles, err := os.ReadDir(ensemblesDir)\r\n   286\tif err != nil {\r\n   287\tif os.IsNotExist(err) {\r\n   288\treturn nil, nil\r\n   289\t}\r\n   290\treturn nil, err\r\n   291\t}\r\n   292\tvar configs []*ensembleConfig\r\n   293\tfor _, file := range files {\r\n   294\tif file.IsDir() || !strings.HasSuffix(file.Name(), \".json\") {\r\n   295\tcontinue\r\n   296\t}\r\n   297"]
[8961.914438, "o", "\tdata, err := os.ReadFile(filepath.Join(ensemblesDir, file.Name()))\r\n   298\tif err != nil {\r\n   299\treturn nil, err\r\n   300\t}\r\n   301\tvar cfg ensembleConfig\r\n   302\tif err := json.Unmarshal(data, &cfg); err != nil {\r\n   303\treturn nil, err\r\n   304\t}\r\n   305\tconfigs = append(configs, &cfg)\r\n   306\t}\r\n   307\tsort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })\r\n   308\treturn configs, nil\r\n   309\t}\r\n   310\t\r\n   311\tfunc combineEnsembleOutputs(allOutputs [][][]float64, strategy string) [][]float64 {\r\n   312\tnumRows := len(allOutputs[0])\r\n   313\tnumOutputs := len(allOutputs[0][0])\r\n   314\tcombined := make([][]float64, numRows)"]
[8961.914525, "o", "\r\n   315\tfor i := 0; i < numRows; i++ {\r\n   316\tcombined[i] = make([]float64, numOutputs)\r\n   317\tfor j := 0; j < numOutputs; j++ {\r\n   318\tvals := make([]float64, len(allOutputs))\r\n   319\tfor k := range allOutputs {\r\n   320\tvals[k] = allOutputs[k][i][j]\r\n   321\t}\r\n   322\t"]
[8961.914611, "o", "switch strategy {\r\n   323\tcase \"max\":\r\n   324\tcombined[i][j] = maxFloat64(vals)\r\n   325\tcase \"min\":\r\n   326\tcombined[i][j] = minFloat64(vals)\r\n   327\tdefault:\r\n   328\tcombined[i][j] = meanFloat64(vals)\r\n   329\t}\r\n   330\t}\r\n   331\t}\r\n   332\treturn combined\r\n   333\t}\r\n   334\t\r\n   335\tfunc meanFloat64(vals []float64) float64 {\r\n   336\tif len(vals) == 0 {\r\n   337\treturn 0\r\n   338\t}\r\n   339\tsum := 0.0\r\n   340\tfor _, v := range vals {\r\n   341\tsum += v\r\n   342\t}\r\n   343\treturn sum / float64(len(vals))\r\n   344\t}\r\n   345\t\r\n   346\tfunc maxFloat64(vals []float64) float64 {\r\n   347\tif len(vals) == 0 {\r\n   348\treturn 0\r\n   349\t}\r\n   350\tm := vals[0]\r\n   351\tfor _, v := range vals[1:] {\r\n   352\tif v > m {\r\n   353\tm = v\r\n   354\t}\r\n   355\t}\r\n"]
[8961.914693, "o", "   356\treturn m\r\n   357\t}\r\n   358\t\r\n   359\tfunc minFloat64(vals []float64) float64 {\r\n   360\tif len(vals) == 0 {\r\n   361\treturn 0\r\n   362\t}\r\n   363\tm := vals[0]\r\n   364\tfor _, v := range vals[1:] {\r\n   365\tif v < m {\r\n   366\tm = v\r\n   367\t}\r\n   368\t}\r\n   369\treturn m\r\n   370\t}\r\n"]
