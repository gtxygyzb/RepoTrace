[5133.458064, "o", "\r\nfunc cmdRemove(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe remove <name>\\n\")\r\n\t\tos.Exit(1)\r\n"]
[5133.458142, "o", "\t}\r\n\tname := args[0]\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfound := false\r\n\tvar newEntries []RegistryEntry\r\n\tfor _, e := range entries {\r\n"]
[5133.458205, "o", "\t\tif e.Name == name {\r\n\t\t\tfound = true\r\n\t\t} else {\r\n\t\t\tnewEntries = append(newEntries, e)\r\n\t\t}\r\n\t}\r\n\r\n\tif !found {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[5133.458272, "o", "\r\n\tif err := saveRegistry(newEntries); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Printf(\"Model '%s' removed.\\n\", name)\r\n}\r\n\r\nfunc isValidTag(tag string) bool {\r\n\tif tag == \"\" {\r\n\t\treturn false\r\n\t}\r\n"]
[5133.458334, "o", "\tfor _, c := range tag {\r\n\t\tisLower := c >= 'a' && c <= 'z'\r\n\t\tisDigit := c >= '0' && c <= '9'\r\n\t\tisHyphen := c == '-'\r\n\t\tif !(isLower || isDigit || isHyphen) {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\n"]
[5133.458392, "o", "func hasTag(entry *RegistryEntry, tag string) bool {\r\n\tfor _, t := range entry.Tags {\r\n\t\tif t == tag {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\n"]
