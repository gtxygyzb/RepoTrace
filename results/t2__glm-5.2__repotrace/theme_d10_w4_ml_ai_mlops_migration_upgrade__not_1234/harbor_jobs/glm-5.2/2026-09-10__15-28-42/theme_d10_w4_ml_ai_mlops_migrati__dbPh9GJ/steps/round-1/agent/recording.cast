[7607.001887, "o", "func runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n\tprocessed := preprocess(inputs, cfg)\r\n\r\n\tresults := make([][]float64, len(processed))\r\n\tfor i, row := range processed {\r\n\t\toutput := make([]float64, weights.NumOutputs)\r\n"]
[7607.001987, "o", "\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n\t\t\tsum := weights.Bias[o]\r\n\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n\t\t\t\tif int(f) < len(row) {\r\n\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\toutput[o] = applyActivation(sum, weights.Activation)\r\n\t\t}\r\n\t\tresults[i] = output\r\n\t}\r\n\r\n\treturn postprocess(results, cfg)\r\n}\r\n\r\n"]
[7607.002049, "o", "func preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n\tresult := make([][]float64, len(inputs))\r\n\tfor i, row := range inputs {\r\n\t\tresult[i] = make([]float64, len(row))\r\n\t\tcopy(result[i], row)\r\n\t}\r\n\r\n\tif len(result) == 0 {\r\n\t\treturn result\r\n\t}\r\n\r\n"]
[7607.002105, "o", "\tfor i, row := range result {\r\n\t\tfor j, val := range row {\r\n"]
[7607.002599, "o", "\u001b[?2004h"]
