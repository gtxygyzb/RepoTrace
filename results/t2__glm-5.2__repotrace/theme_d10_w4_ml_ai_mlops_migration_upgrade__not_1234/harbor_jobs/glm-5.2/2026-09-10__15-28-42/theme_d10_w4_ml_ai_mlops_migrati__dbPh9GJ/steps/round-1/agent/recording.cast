[9603.102585, "o", "command := os.Args[1]\r\n    18\t\targs := os.Args[2:]\r\n    19\t\r\n    20\t\tswitch command {\r\n    21\t\tcase \"ensemble\":\r\n    22\t\t\tcmdEnsemble(args)\r\n    23\t\tcase \"list\":\r\n"]
[9603.102643, "o", "    24\t\t\tcmdList(args)\r\n    25\t\tcase \"info\":\r\n    26\t\t\tcmdInfo(args)\r\n    27\t\tcase \"register\":\r\n    28\t\t\tcmdRegister(args)\r\n    29\t\tcase \"remove\":\r\n    30\t\t\tcmdRemove(args)\r\n    31\t\tcase \"tag\":\r\n    32\t\t\tcmdTag(args)\r\n    33"]
[9603.102705, "o", "\t\tcase \"untag\":\r\n    34\t\t\tcmdUntag(args)\r\n    35\t\tcase \"search\":\r\n    36\t\t\tcmdSearch(args)\r\n    37\t\tcase \"run\":\r\n    38\t\t\tcmdRun(args)\r\n    39\t\tcase \"stats\":\r\n    40\t\t\tcmdStats(args)\r\n"]
[9603.102762, "o", "    41\t\tcase \"diff\":\r\n    42\t\t\tcmdDiff(args)\r\n    43\t\tcase \"batch\":\r\n    44\t\t\tcmdBatch(args)\r\n    45\t\tcase \"profile\":\r\n    46\t\t\tcmdProfile(args)\r\n    47\t\tcase \"validate\":\r\n    48\t\t\tcmdValidate(args)\r\n    49\t\tcase \"export\":\r\n    50\t"]
[9603.102854, "o", "\t\tcmdExport(args)\r\n    51\t\tcase \"import\":\r\n    52\t\t\tcmdImport(args)\r\n    53\t\tcase \"clone\":\r\n    54\t\t\tcmdClone(args)\r\n    55\t\tcase \"checkpoint\":\r\n    56\t\t\tcmdCheckpoint(args)\r\n    57\t\tcase \"checkpoints\":\r\n    58\t\t\tcmdCheckpoints(args)\r\n    59\t\tcase \"rollback\":\r\n"]
[9603.10292, "o", "    60\t\t\tcmdRollback(args)\r\n    61\t\tcase \"migrate\":\r\n    62\t\t\tcmdMigrate(args)\r\n    63\t\tcase \"compat\":\r\n    64\t\t\tcmdCompat(args)\r\n    65\t\tcase \"version\":\r\n    66\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    67\t\tcase \"help\":\r\n    68\t\t\tprintUsage()\r\n    69"]
[9603.102981, "o", "\t\tdefault:\r\n    70\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    71\t\t\tprintUsage()\r\n    72\t\t\tos.Exit(1)\r\n"]
[9603.103039, "o", "    73\t\t}\r\n    74\t}\r\n    75\t\r\n    76\tfunc printUsage() {\r\n    77\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    78\t\r\n    79\tUsage: mlpipe <command> [arguments]\r\n    80\t\r\n    81\tCommands:\r\n    82\t  list                          List all registered models\r\n    83\t  info <model>                  Show model details\r\n    84\t  register <name> <path>        Register a model from directory\r\n"]
[9603.1031, "o", "    85\t  remove <name>                 Remove a model from registry\r\n    86\t  run <model> [options]         Run inference\r\n    87\t  stats --input <file>          Input statistics profiling\r\n    88\t  diff <model1> <model2> --input <file>\r\n    89\t                                Compare two models on same input\r\n    90\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n    91\t                                Batch inference over CSV files\r\n    92\t  validate <model>              Validate model integrity\r\n    93\t  export <model> --output <file> Export model to JSON file\r\n    94\t  import <path> [--name <name>] Import model from JSON file\r\n"]
[9603.103159, "o", "    95\t  clone <model> <new_name>      Clone model to new name\r\n    96\t    profile <model>               Report model weight analysis\r\n    97\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n    98\t  compat [--all]                 Check migration compatibility\r\n    99\t  version                       Show version\r\n   100\t  help                          Show this help\r\n   101\t\r\n   102\tRun/Diff Options:\r\n   103\t"]
[9603.103221, "o", "  --input <file>    Input CSV file (required)\r\n   104\t  --output <file>   Output file (default: stdout)\r\n   105\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   106\t\r\n   107\tBatch Options:\r\n   108\t  --dir <dir>       Input directory of CSV files\r\n   109\t  --output-dir <dir> Output directory for predictions\r\n   110\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   111\t`\r\n   112\t\t"]
[9603.103277, "o", "fmt.Print(usage)\r\n   113\t}\r\n   114\t\r\n   115\tfunc parseFlags(args []string) map[string]string {\r\n   116\t\tflags := make(map[string]string)\r\n   117\t\tfor i := 0; i < len(args); i++ {\r\n   118\t\t\tif strings.HasPrefix(args[i], \"--\") {\r\n   119\t\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n"]
[9603.103341, "o", "   120\t\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n   121\t\t\t\t\tflags[key] = args[i+1]\r\n   122\t\t\t\t\ti++\r\n   123\t\t\t\t} else {\r\n   124\t\t\t\t\tflags[key] = \"true\"\r\n   125\t\t\t\t}\r\n   126\t\t\t}\r\n   127\t\t}\r\n   128\t"]
[9603.103401, "o", "\treturn flags\r\n   129\t}\r\n"]
