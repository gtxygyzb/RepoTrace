[3259.502598, "o", "\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t)\r\n    13\t\r\n    14\tfunc modelDirExists(path string) bool {\r\n    15\t\tinfo, err := os.Stat(path)\r\n    16\t\treturn err == nil && info.IsDir()\r\n"]
[3259.502688, "o", "    17\t}\r\n    18\t\r\n    19\tfunc resolveModel(name string) (*RegistryEntry, error) {\r\n    20\t\tentries, err := loadRegistry()\r\n    21\t\tif err != nil {\r\n    22\t\t\treturn nil, err\r\n    23\t\t}\r\n    24\t\tentry := findEntry(entries, name)\r\n    25\t\tif entry == nil {\r\n    26\t\t\treturn nil, fmt.Errorf(\"model '%s' not found\", name)\r\n    27\t\t}\r\n    28\t\tif !modelDirExists(entry.Path) {\r\n    29\t\t\treturn nil, fmt.Errorf(\"model directory not found\")\r\n    30\t\t}\r\n    31\t\treturn entry, nil\r\n    32\t}\r\n    33\t\r\n    34\tfunc loadModelArtifacts(modelDir string) (*WeightsData, *PipelineConfig, error) {\r\n    35\t\tweights, err := loadWeights(modelDir)\r\n    36\t\tif err != nil {\r\n    37\t\t\treturn nil, nil, err\r\n    38\t\t}\r\n    39\t\tcfg, err := loadPipelineConfig(modelDir)\r\n    40\t\tif err != nil {\r\n    41\t\t\treturn nil, nil, err\r\n"]
