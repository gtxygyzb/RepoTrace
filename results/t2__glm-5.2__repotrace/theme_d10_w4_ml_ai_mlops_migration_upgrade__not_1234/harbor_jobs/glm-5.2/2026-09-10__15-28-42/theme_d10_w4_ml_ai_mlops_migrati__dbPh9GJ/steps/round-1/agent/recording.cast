[413.928682, "o", "func runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n\tprocessed := preprocess(inputs, cfg)\r\n\r\n\tresults := make([][]float64, len(processed))\r\n\tfor i, row := range processed {\r\n"]
[413.928768, "o", "\t\toutput := make([]float64, weights.NumOutputs)\r\n\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n\t\t\tsum := weights.Bias[o]\r\n\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n\t\t\t\tif int(f) < len(row) {\r\n\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[413.928875, "o", "\t\t\toutput[o] = sum\r\n\t\t}\r\n\t\tresults[i] = output\r\n\t}\r\n\r\n\treturn postprocess(results, cfg)\r\n}\r\n\r\nfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n\tresult := make([][]float64, len(inputs))\r\n\tfor i, row := range inputs {\r\n\t\tresult[i] = make([]float64, len(row))\r\n"]
[413.928939, "o", "\t\tcopy(result[i], row)\r\n\t}\r\n\r\n\tfor i, row := range result {\r\n\t\tfor j, val := range row {\r\n\t\t\tif math.IsNaN(val) {\r\n\t\t\t\tswitch cfg.MissingStrategy {\r\n\t\t\t\tcase \"zero\":\r\n\t\t\t\t\tresult[i][j] = 0.0\r\n\t\t\t\tcase \"mean\":\r\n"]
[413.928998, "o", "\t\t\t\t\tresult[i][j] = computeColumnMean(inputs, j)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif cfg.Normalize {\r\n\t\tfor j := 0; j < len(result[0]); j++ {\r\n"]
[413.929055, "o", "\t\t\tminVal, maxVal := columnMinMax(result, j)\r\n\t\t\trangeVal := maxVal - minVal\r\n\t\t\tif rangeVal == 0 {\r\n\t\t\t\trangeVal = 1.0\r\n\t\t\t}\r\n\t\t\tfor i := range result {\r\n"]
[413.929122, "o", "\t\t\t\t// BUG: normalization formula incorrect - should map to [ScaleMin, ScaleMax]\r\n\t\t\t\t// but uses wrong formula that doesn't properly apply the target range\r\n\t\t\t\tnormalized := (result[i][j] - minVal) / rangeVal\r\n\t\t\t\tresult[i][j] = normalized * cfg.ScaleMax\r\n"]
[413.929188, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\treturn result\r\n}\r\n\r\nfunc postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {\r\n\tfor i, row := range results {\r\n\t\tfor j, val := range row {\r\n\t\t\tval = math.Max(val, cfg.ClipMin)\r\n"]
[413.929244, "o", "\t\t\tval = math.Min(val, cfg.ClipMax)\r\n\t\t\tresults[i][j] = roundToDigits(val, cfg.RoundDigits)\r\n\t\t}\r\n\t}\r\n\treturn results\r\n}\r\n\r\nfunc computeColumnMean(data [][]float64, col int) float64 {\r\n\tsum := 0.0\r\n"]
[413.929307, "o", "\tcount := 0\r\n\tfor _, row := range data {\r\n\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n\t\t\tsum += row[col]\r\n\t\t\tcount++\r\n\t\t}\r\n\t}\r\n\tif count == 0 {\r\n"]
[413.929364, "o", "\t\treturn 0.0\r\n\t}\r\n\treturn sum / float64(count)\r\n}\r\n\r\nfunc columnMinMax(data [][]float64, col int) (float64, float64) {\r\n\tminVal := math.Inf(1)\r\n"]
[413.929422, "o", "\tmaxVal := math.Inf(-1)\r\n\tfor _, row := range data {\r\n\t\tif col < len(row) {\r\n\t\t\tif row[col] < minVal {\r\n\t\t\t\tminVal = row[col]\r\n\t\t\t}\r\n\t\t\tif row[col] > maxVal {\r\n"]
[413.929511, "o", "\t\t\t\tmaxVal = row[col]\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn minVal, maxVal\r\n}\r\n\r\nfunc writeOutput(f *os.File, results [][]float64, format string) {\r\n"]
