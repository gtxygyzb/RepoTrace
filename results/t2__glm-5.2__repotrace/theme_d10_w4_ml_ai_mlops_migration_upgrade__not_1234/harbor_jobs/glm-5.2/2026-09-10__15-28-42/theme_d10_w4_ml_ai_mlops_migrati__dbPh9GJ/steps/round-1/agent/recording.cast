[8943.955391, "o", "./checkpoints.go\r\n./commands.go\r\n./commands_extra.go\r\n./ensemble.go\r\n./export_import.go\r\n./format.go\r\n./inference.go\r\n./main.go\r\n./migration.go\r\n"]
[8943.955516, "o", "./registry.go\r\n"]
[8943.955997, "o", "\u001b[?2004h"]
[8943.956041, "o", "root@n30009:/app# "]
[8944.2244, "i", "sed -n '1,240p' ensemble.go\n"]
[8944.224673, "o", "sed -n '1,240p' ensemble.go\r\n\u001b[?2004l\r"]
[8944.227839, "o", "package main\r\n\r\nimport (\r\n\"encoding/json\"\r\n\"fmt\"\r\n\"os\"\r\n\"path/filepath\"\r\n\"sort\"\r\n\"strings\"\r\n)\r\n\r\nconst ensemblesDir = \"/app/models/ensembles\"\r\n\r\n"]
[8944.227902, "o", "type ensembleConfig struct {\r\nName     string   `json:\"name\"`\r\nModels   []string `json:\"models\"`\r\nStrategy string   `json:\"strategy\"`\r\n}\r\n\r\nfunc cmdEnsemble(args []string) {\r\nif len(args) < 1 {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble <create|list|run|remove> [arguments]\\n\")\r\nos.Exit(1)\r\n}\r\n\r\nsub := args[0]\r\nrest := args[1:]\r\nswitch sub {\r\ncase \"create\":\r\n"]
[8944.228071, "o", "cmdEnsembleCreate(rest)\r\ncase \"list\":\r\ncmdEnsembleList(rest)\r\ncase \"run\":\r\ncmdEnsembleRun(rest)\r\ncase \"remove\":\r\ncmdEnsembleRemove(rest)\r\ndefault:\r\nfmt.Fprintf(os.Stderr, \"unknown ensemble command: %s\\n\", sub)\r\nos.Exit(1)\r\n}\r\n}\r\n\r\nfunc cmdEnsembleCreate(args []string) {\r\nflags := parseFlags(args)\r\n\r\nif len(args) < 1 || strings.HasPrefix(args[0], \"--\") {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]\\n\")\r\nos.Exit(1)\r\n}\r\nname := args[0]\r\n\r\nmodelsStr := flags[\"models\"]\r\nif modelsStr == \"\" || modelsStr == \"true\" {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]\\n\")\r\nos.Exit(1)\r\n}\r\n\r\nstrategy := flags[\"strategy\"]\r\nif strategy == \"\" || strategy == \"true\" {\r\nstrategy = \"average\"\r\n}\r\nif strategy != \"average\" && strategy != \"max\" && strategy != \"min\" {\r\nfmt.Fprintf(os.Stderr, \"error: invalid strategy '%s', use average, max, or min\\n\", strategy)\r\nos.Exit(1)\r\n}"]
[8944.228283, "o", "\r\n\r\nvar models []string\r\nfor _, m := range strings.Split(modelsStr, \",\") {\r\nm = strings.TrimSpace(m)\r\nif m != \"\" {\r\nmodels = append(models, m)\r\n}\r\n}\r\nif len(models) == 0 {\r\nfmt.Fprintf(os.Stderr, \"error: at least one model is required\\n\")\r\nos.Exit(1)\r\n}\r\n\r\nentries, err := loadRegistry()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\nfor _, m := range models {\r\nif findEntry(entries, m) == nil {\r\nfmt.Printf(\"model not found: %s\\n\", m)\r\nos.Exit(1)\r\n}\r\n}\r\n\r\nvar outputDim int\r\nfor i, m := range models {\r\nentry := findEntry(entries, m)\r\nweights, err := loadWeights(entry.Path)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error loading weights for model '%s': %v\\n\", m, err)\r\nos.Exit(1)\r\n}\r\nif i == 0 {\r\noutputDim = int(weights.NumOutputs)\r\n} else if int(weights.NumOutputs) != outputDim {\r\nfmt.Println(\"output dimension mismatch\")\r\nos.Exit(1)\r\n}\r\n}\r\n\r\npath := filepath.Join(ensemblesDir, name+\".json\")\r\nif _, err := os.Stat(path); err == nil {\r\nfmt.Println(\"ensemble already exists\")\r\nos.Exit(1"]
[8944.22842, "o", ")\r\n}\r\n\r\ncfg := ensembleConfig{\r\nName:     name,\r\nModels:   models,\r\nStrategy: strategy,\r\n}\r\nif err := saveEnsembleConfig(&cfg); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\n"]
[8944.228531, "o", "fmt.Printf(\"ensemble '%s' created with %d models (strategy=%s)\\n\", name, len(models), strategy)\r\n}\r\n\r\nfunc cmdEnsembleList(args []string) {\r\nconfigs, err := listEnsembleConfigs()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\nif len(configs) == 0 {\r\nfmt.Println(\"no ensembles\")\r\nreturn\r\n}\r\nsort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })\r\nfor _, cfg := range configs {\r\nfmt.Printf(\"%s  %s  %d models\\n\", cfg.Name, cfg.Strategy, len(cfg.Models))\r\n}\r\n}\r\n\r\nfunc cmdEnsembleRun(args []string) {\r\nif len(args) < 1 {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble run <name> --input <file> [--format csv|json]\\n\")\r\nos.Exit(1)\r\n}\r\nname := args[0]\r\nflags := parseFlags(args[1:])\r\n\r\ninputFile := flags[\"input\"]\r\nif inputFile == \"\" || inputFile == \"true\" {\r\nfmt.Fprintf(os.Stderr, \"error: --input is required\\n\")\r\nos.Exit(1)\r\n}\r\n\r\noutputFormat := flags[\"format\"]"]
[8944.228673, "o", "\r\nif outputFormat == \"\" || outputFormat == \"true\" {\r\noutputFormat = \"csv\"\r\n}\r\nif outputFormat != \"csv\" && outputFormat != \"json\" {\r\nfmt.Fprintf(os.Stderr, \"error: unsupported format '%s', use 'csv' or 'json'\\n\", outputFormat)\r\nos.Exit(1)\r\n}\r\n\r\ncfg, err := loadEnsembleConfig(name)\r\nif err != nil {\r\nfmt.Println(\"ensemble not found\")\r\nos.Exit(1)\r\n}\r\n\r\ninputs, err := readInputCSV(inputFile)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\nentries, err := loadRegistry()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n"]
[8944.228709, "o", "}\r\n\r\nvar allOutputs [][][]float64\r\nvar featureCount int\r\nfor i, modelName := range cfg.Models {\r\nentry := findEntry(entries, modelName)\r\nif entry == nil {\r\nfmt.Printf(\"model not found: %s\\n\", modelName)\r\nos.Exit(1)\r\n}\r\n\r\nweights, err := loadWeights(entry.Path)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error loading weights for model '%s': %v\\n\", modelName, err)\r\nos.Exit(1)\r\n}\r\n\r\nif i == 0 {\r\nfeatureCount = int(weights.NumFeatures)\r\n} else if int(weights.NumFeatures) != featureCount {\r\nfmt.Println(\"feature mismatch\")\r\nos.Exit(1)\r\n}\r\n\r\nif err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {\r\nfmt.Println(\"feature mismatch\")\r\nos.Exit(1)\r\n"]
[8944.228923, "o", "}\r\n\r\npipelineCfg, err := loadPipelineConfig(entry.Path)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error loading pipeline config for model '%s': %v\\n\", modelName, err)\r\nos.Exit(1)\r\n}\r\n\r\nresults := runInference(inputs, weights, pipelineCfg)\r\nallOutputs = append(allOutputs, results)\r\n}\r\n\r\nif len(allOutputs) == 0 {\r\nfmt.Fprintf(os.Stderr, \"error: ensemble '%s' has no models\\n\", name)\r\nos.Exit(1)\r\n}\r\n\r\ncombined := combineEnsembleOutputs(allOutputs, cfg.Strategy)\r\n\r\noutputFile := flags[\"output\"]\r\nif outputFile != \"\" && outputFile != \"true\" {\r\nf, err := os.Create(outputFile)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error creating output file: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\ndefer f.Close()\r\nwriteOutput(f, combined, outputFormat)\r\n} else {\r\nwriteOutput(os.Stdout, combined, outputFormat)\r\n}\r\n}\r\n"]
[8944.229436, "o", "\u001b[?2004h"]
[8944.229535, "o", "root@n30009:/app# "]
[8944.49768, "i", "sed -n '1,260p' main.go\n"]
[8944.497966, "o", "sed -n '1,260p' main.go\r\n\u001b[?2004l\r"]
[8944.501031, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n)\r\n\r\n"]
[8944.501156, "o", "const version = \"0.1.0\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcommand := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch command {\r\n\tcase \"ensemble\":\r\n\t\tcmdEnsemble(args)\r\n\tcase \"list\":\r\n\t\tcmdList(args)\r\n\tcase \"info\":\r\n\t\tcmdInfo(args)\r\n\tcase \"register\":\r\n"]
[8944.501267, "o", "\t\tcmdRegister(args)\r\n\tcase \"remove\":\r\n\t\tcmdRemove(args)\r\n\tcase \"tag\":\r\n\t\tcmdTag(args)\r\n\tcase \"untag\":\r\n\t\tcmdUntag(args)\r\n\tcase \"search\":\r\n\t\tcmdSearch(args)\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"stats\":\r\n\t\tcmdStats(args)\r\n\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n\tcase \"batch\":\r\n\t\tcmdBatch(args)\r\n\tcase \"profile\":\r\n\t\tcmdProfile(args)\r\n\tcase \"validate\":"]
[8944.501378, "o", "\r\n\t\tcmdValidate(args)\r\n\tcase \"export\":\r\n\t\tcmdExport(args)\r\n\tcase \"import\":\r\n\t\tcmdImport(args)\r\n\tcase \"clone\":\r\n\t\tcmdClone(args)\r\n\tcase \"checkpoint\":\r\n\t\tcmdCheckpoint(args)\r\n\tcase \"checkpoints\":\r\n\t\tcmdCheckpoints(args)\r\n\tcase \"rollback\":\r\n\t\tcmdRollback(args)\r\n\tcase \"migrate\":\r\n\t\tcmdMigrate(args)\r\n\tcase \"compat\":\r\n\t\tcmdCompat(args)\r\n"]
[8944.501483, "o", "\tcase \"version\":\r\n\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n\tcase \"help\":\r\n\t\tprintUsage()\r\n\tdefault:\r\n"]
[8944.501595, "o", "\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc printUsage() {\r\n\tusage := `mlpipe - ML Inference Pipeline Manager\r\n\r\nUsage: mlpipe <command> [arguments]\r\n\r\nCommands:\r\n  list                          List all registered models\r\n  info <model>                  Show model details\r\n  register <name> <path>        Register a model from directory\r\n  remove <name>                 Remove a model from registry\r\n  run <model> [options]         Run inference\r\n  stats --input <file>          Input statistics profiling\r\n  diff <model1> <model2> --input <file>\r\n                                Compare two models on same input\r\n  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n                                Batch inference over CSV files\r\n  validate <model>              Validate model integrity\r\n  export <model> --output <file> Export model to JSON file\r\n  import <path> [--name <name>] Import model from JSON file\r\n  clone <model> <new_name>      Clone"]
[8944.501727, "o", " model to new name\r\n    profile <model>               Report model weight analysis\r\n  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n  compat [--all]                 Check migration compatibility\r\n  version                       Show version\r\n  help                          Show this help\r\n\r\nRun/Diff Options:\r\n  --input <file>    Input CSV file (required)\r\n  --output <file>   Output file (default: stdout)\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n\r\nBatch Options:\r\n  --dir <dir>       Input directory of CSV files\r\n  --output-dir <dir> Output directory for predictions\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n`\r\n\tfmt.Print(usage)\r\n}\r\n\r\nfunc parseFlags(args []string) map[string]string {\r\n\tflags := make(map[string]string)\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tif strings.HasPrefix(args[i], \"--\") {\r\n\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n\t\t\t\tflags[key] = args[i+1]\r\n\t\t\t\ti++\r\n"]
[8944.501837, "o", "\t\t\t} else {\r\n\t\t\t\tflags[key] = \"true\"\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn flags\r\n}\r\n"]
