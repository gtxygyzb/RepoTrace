[13268.48817, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t"]
[13268.488252, "o", "\t\"os\"\r\n     6\t\t\"strings\"\r\n     7\t)\r\n     8\t\r\n     9\tconst version = \"0.1.0\"\r\n    10\t\r\n    11\tfunc main() {\r\n    12\t\tif len(os.Args) < 2 {\r\n    13\t\t\tprintUsage()\r\n    14\t\t\tos.Exit(1)\r\n    15\t\t}\r\n    16\t\r\n    17\t\tcommand := os.Args[1]\r\n    18\t\targs := os.Args[2:]\r\n    19\t\r\n    20\t\t"]
[13268.488319, "o", "switch command {\r\n    21\t\tcase \"ensemble\":\r\n    22\t\t\tcmdEnsemble(args)\r\n    23\t\tcase \"list\":\r\n    24\t\t\tcmdList(args)\r\n    25\t\tcase \"info\":\r\n    26\t\t\tcmdInfo(args)\r\n    27\t\tcase \"register\":\r\n"]
[13268.488383, "o", "    28\t\t\tcmdRegister(args)\r\n    29\t\tcase \"remove\":\r\n    30\t\t\tcmdRemove(args)\r\n    31\t\tcase \"tag\":\r\n    32\t\t\tcmdTag(args)\r\n    33\t\tcase \"untag\":\r\n    34\t\t\tcmdUntag(args)\r\n    35\t\tcase \"search\":\r\n    36\t\t\tcmdSearch(args)\r\n    37\t\tcase \"run\":\r\n"]
[13268.48845, "o", "    38\t\t\tcmdRun(args)\r\n    39\t\tcase \"stats\":\r\n    40\t\t\tcmdStats(args)\r\n    41\t\tcase \"diff\":\r\n    42\t\t\tcmdDiff(args)\r\n    43"]
[13268.488509, "o", "\t\tcase \"compare\":\r\n    44\t\t\tcmdCompare(args)\r\n    45\t\tcase \"batch\":\r\n    46\t\t\tcmdBatch(args)\r\n    47\t\tcase \"benchmark\":\r\n    48\t\t\tcmdBenchmark(args)\r\n    49\t\tcase \"prune\":\r\n    50\t\t\tcmdPrune(args)\r\n    51\t\tcase \"profile\":\r\n    52\t\t\tcmdProfile(args)\r\n    53\t\tcase \"explain\":\r\n    54\t\t\tcmdExplain(args)\r\n    55\t"]
[13268.488578, "o", "\tcase \"validate\":\r\n    56\t\t\tcmdValidate(args)\r\n    57\t\tcase \"validate-input\":\r\n    58\t\t\tcmdValidateInput(args)\r\n    59\t\tcase \"schema\":\r\n    60\t\t\tcmdSchema(args)\r\n"]
[13268.488637, "o", "    61\t\tcase \"export\":\r\n    62\t\t\tcmdExport(args)\r\n    63\t\tcase \"import\":\r\n    64\t\t\tcmdImport(args)\r\n    65\t\tcase \"clone\":\r\n    66\t\t\tcmdClone(args)\r\n    67\t\tcase \"checkpoint\":\r\n    68\t\t\tcmdCheckpoint(args)\r\n    69\t\tcase \"checkpoints\":\r\n    70\t\t\tcmdCheckpoints(args)\r\n    71\t\tcase \"rollback\":\r\n    72\t\t\tcmdRollback(args)\r\n    73\t\tcase \"migrate\":\r\n    74\t\t"]
[13268.488701, "o", "\tcmdMigrate(args)\r\n    75\t\tcase \"compat\":\r\n    76\t\t\tcmdCompat(args)\r\n    77\t\tcase \"version\":\r\n"]
[13268.488764, "o", "    78\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    79\t\tcase \"help\":\r\n    80\t\t\tprintUsage()\r\n    81\t\tdefault:\r\n    82\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    83\t\t\tprintUsage()\r\n    84\t\t\tos.Exit(1)\r\n    85\t\t}\r\n    86\t}\r\n    87\t\r\n    88\t"]
[13268.48884, "o", "func printUsage() {\r\n    89\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    90\t\r\n    91\tUsage: mlpipe <command> [arguments]\r\n    92\t\r\n    93\tCommands:\r\n    94\t  list                          List all registered models\r\n    95\t  info <model>                  Show model details\r\n    96\t  register <name> <path>        Register a model from directory\r\n    97\t  remove <name>                 Remove a model from registry\r\n    98\t"]
[13268.488899, "o", "  run <model> [options]         Run inference\r\n    99\t  stats --input <file>          Input statistics profiling\r\n   100\t  diff <model1> <model2> --input <file>\r\n"]
[13268.488934, "o", "   101\t                                Compare two models on same input\r\n   102\t  compare <model1> <model2> [--input <file>]\r\n   103\t                                Generate detailed comparison report between two models\r\n   104\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n   105\t                                Batch inference over CSV files\r\n   106\t  validate <model>              Validate model integrity\r\n   107\t  validate-input <model> --input <file>\r\n   108\t                                Validate input data for a model\r\n   109\t  schema <model>                Display expected input schema for a model\r\n   110\t  export <model> --output <file> Export model to JSON file\r\n   111\t  import <path> [--name <name>] Import model from JSON file\r\n   112\t  clone <model> <new_name>      Clone model to new name\r\n   113\t"]
[13268.489025, "o", "  benchmark <model> --input <file> [--runs <N>]\r\n   114\t                                Benchmark inference performance\r\n   115\t  prune <model> --threshold <value> [--dry-run]\r\n   116\t                                Prune near-zero weights\r\n   117\t  profile <model>               Report model weight analysis\r\n   118"]
[13268.489323, "o", "\t  explain <model> --input <file> [--row <N>]\r\n   119\t                                  Explain prediction for a row\r\n   120\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n   121\t  compat [--all]                 Check migration compatibility\r\n   122\t  version                       Show version\r\n   123\t  help                          Show this help\r\n   124\t\r\n   125\tRun/Diff Options:\r\n   126\t  --input <file>    Input CSV file (required)\r\n   127\t  --output <file>   Output file (default: stdout)\r\n   128\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   129\t  --strict          Validate input before inference and abort on invalid rows\r\n   130\t\r\n   131\tBatch Options:\r\n   132\t  --dir <dir>       Input directory of CSV files\r\n   133\t  --output-dir <dir> Output directory for predictions\r\n   134\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   135\t`\r\n   136\t\tfmt.Print(usage)\r\n   137\t}\r\n   138\t\r\n   139\tfunc parseFlags(args []string) map[string]string {\r\n   1"]
[13268.489419, "o", "40\t\tflags := make(map[string]string)\r\n"]
