[12654.924788, "o", "const version = \"0.1.0\"\r\n    10\t\r\n    11\tfunc main() {\r\n    12\t\tif len(os.Args) < 2 {\r\n    13\t\t\tprintUsage()\r\n    14\t\t\tos.Exit(1)\r\n    15\t\t}\r\n    16\t\r\n    17\t\tcommand := os.Args[1]\r\n    18\t\targs := os.Args[2:]\r\n    19\t\r\n    20\t\tswitch command {\r\n    21\t\tcase \"ensemble\":\r\n    22\t\t\tcmdEnsemble(args)\r\n    23\t\tcase \"list\":\r\n    24\t\t\tcmdList(args)\r\n    25\t"]
[12654.924917, "o", "\tcase \"info\":\r\n    26\t\t\tcmdInfo(args)\r\n    27\t\tcase \"register\":\r\n    28\t\t\tcmdRegister(args)\r\n    29\t\tcase \"remove\":\r\n    30\t\t\tcmdRemove(args)\r\n    31\t\tcase \"tag\":\r\n    32\t\t\tcmdTag(args)\r\n    33\t\tcase \"untag\":\r\n    34\t\t\tcmdUntag(args)\r\n    35\t\tcase \"search\":\r\n"]
[12654.924996, "o", "    36\t\t\tcmdSearch(args)\r\n    37\t\tcase \"run\":\r\n    38\t\t\tcmdRun(args)\r\n    39\t\tcase \"stats\":\r\n    40\t\t\tcmdStats(args)\r\n    41\t\tcase \"diff\":\r\n    42\t\t\tcmdDiff(args)\r\n    43\t\tcase \"batch\":\r\n    44\t\t\tcmdBatch(args)\r\n    45\t\tcase \"benchmark\":\r\n    46\t\t\tcmdBenchmark(args)\r\n    47\t\tcase \"prune\":\r\n    48\t\t\tcmdPrune(args)\r\n    49\t\tcase \"profile\":\r\n    50\t\t\tcmdProfile(args)\r\n    51\t\tcase \"explain\":\r\n    52\t\t\tcmdExplain(args)\r\n    53"]
[12654.925071, "o", "\t\tcase \"validate\":\r\n    54\t\t\tcmdValidate(args)\r\n    55\t\tcase \"validate-input\":\r\n    56\t\t\tcmdValidateInput(args)\r\n    57\t\tcase \"schema\":\r\n    58\t\t\tcmdSchema(args)\r\n    59\t\tcase \"export\":\r\n    60\t\t\tcmdExport(args)\r\n    61\t\tcase \"import\":\r\n    62\t\t\tcmdImport(args)\r\n    63\t\tcase \"clone\":\r\n    64\t\t\t"]
[12654.925141, "o", "cmdClone(args)\r\n    65\t\tcase \"checkpoint\":\r\n    66\t\t\tcmdCheckpoint(args)\r\n    67\t\tcase \"checkpoints\":\r\n    68\t\t\tcmdCheckpoints(args)\r\n    69\t\tcase \"rollback\":\r\n    70\t\t\tcmdRollback(args)\r\n    71\t\tcase \"migrate\":\r\n    72\t\t\tcmdMigrate(args)\r\n"]
[12654.925209, "o", "    73\t\tcase \"compat\":\r\n    74\t\t\tcmdCompat(args)\r\n    75\t\tcase \"version\":\r\n    76\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    77\t\tcase \"help\":\r\n    78\t\t\tprintUsage()\r\n    79\t\tdefault:\r\n    80\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    81\t\t\tprintUsage()\r\n    82\t\t\tos.Exit(1)\r\n"]
[12654.925277, "o", "    83\t\t}\r\n    84\t}\r\n    85\t\r\n    86\tfunc printUsage() {\r\n    87\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    88\t\r\n    89\tUsage: mlpipe <command> [arguments]\r\n    90\t\r\n    91\tCommands:\r\n    92\t  list                          List all registered models\r\n    93\t  info <model>                  Show model details\r\n"]
[12654.925351, "o", "    94\t  register <name> <path>        Register a model from directory\r\n    95\t  remove <name>                 Remove a model from registry\r\n    96\t  run <model> [options]         Run inference\r\n    97\t  stats --input <file>          Input statistics profiling\r\n    98\t  diff <model1> <model2> --input <file>\r\n    99\t                                Compare two models on same input\r\n"]
[12654.925428, "o", "   100\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n   101\t                                Batch inference over CSV files\r\n   102\t  validate <model>              Validate model integrity\r\n   103\t  validate-input <model> --input <file>\r\n   104\t                                Validate input data for a model\r\n   105\t  schema <model>                Display expected input schema for a model\r\n   106\t  export <model> --output <file> Export model to JSON file\r\n   107\t  import <path> [--name <name>] Import model from JSON file\r\n   108\t  clone <model> <new_name>      Clone model to new name\r\n   109\t  benchmark <model> --input <file> [--runs <N>]\r\n   110\t                                Benchmark inference performance\r\n   111\t  prune <model> --threshold <value> [--dry-run]\r\n   112\t                                Prune near-zero weights\r\n   113\t  profile <model>               Report model weight analysis\r\n   114\t  explain <model> --input <file> [--row <N>]\r\n   115\t                                  E"]
[12654.925517, "o", "xplain prediction for a row\r\n   116\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n   117\t  compat [--all]                 Check migration compatibility\r\n   118\t  version                       Show version\r\n   119\t  help                          Show this help\r\n   120\t\r\n   121\tRun/Diff Options:\r\n   122\t  --input <file>    Input CSV file (required)\r\n   123\t  --output <file>   Output file (default: stdout)\r\n   124\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   125\t  --strict          Validate input before inference and abort on invalid rows\r\n   126\t\r\n   127\tBatch Options:\r\n"]
[12654.925589, "o", "   128\t  --dir <dir>       Input directory of CSV files\r\n   129\t  --output-dir <dir> Output directory for predictions\r\n   130\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   131\t`\r\n   132\t\tfmt.Print(usage)\r\n   133\t}\r\n   134\t\r\n   135\tfunc parseFlags(args []string) map[string]string {\r\n   136\t\tflags := make(map[string]string)\r\n   137\t\tfor i := 0; i < len(args); i++ {\r\n   138\t\t\tif strings.HasPrefix(args[i], \"--\") {\r\n   139\t\t\t\t"]
[12654.925666, "o", "key := strings.TrimPrefix(args[i], \"--\")\r\n   140\t\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n   141\t\t\t\t\tflags[key] = args[i+1]\r\n   142\t\t\t\t\ti++\r\n   143\t\t\t\t} else {\r\n"]
[12654.925742, "o", "   144\t\t\t\t\tflags[key] = \"true\"\r\n   145\t\t\t\t}\r\n   146\t\t\t}\r\n   147\t\t}\r\n   148\t\treturn flags\r\n   149\t}\r\n"]
