[12674.274046, "o", "\tif w1.NumFeatures != w2.NumFeatures {\r\n   312\t\t\tfmt.Fprintf(os.Stderr, \"error: models have different input feature counts: %s=%d, %s=%d\\n\", model1, w1.NumFeatures, model2, w2.NumFeatures)\r\n   313\t\t\tos.Exit(1)\r\n   314\t\t}\r\n   315\t\r\n   316\t\tinputs, err := readInputCSV(input)\r\n   317\t\tif err != nil {\r\n   318\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n   319\t\t\tos.Exit(1)\r\n   320\t\t}\r\n   321\t\r\n   322\t\tif err := validateFeatureCount(inputs, int(w1.NumFeatures)); err != nil {\r\n"]
[12674.274108, "o", "   323\t\t\tfmt.Fprintf(os.Stderr, \"error: input feature count mismatch: %v\\n\", err)\r\n   324\t\t\tos.Exit(1)\r\n   325\t\t}\r\n   326\t\r\n   327\t\tr1 := runInference(inputs, w1, cfg1)\r\n   328\t\tr2 := runInference(inputs, w2, cfg2)\r\n   329\t\r\n   330\t\tmaxOut := minInt(int(w1.NumOutputs), int(w2.NumOutputs))\r\n   331\t\tif int(w1.NumOutputs) != int(w2.NumOutputs) {\r\n"]
[12674.274175, "o", "   332\t\t\tfmt.Printf(\"note: model output dimension mismatch: %s=%d, %s=%d; comparing %d output(s)\\n\", model1, w1.NumOutputs, model2, w2.NumOutputs, maxOut)\r\n   333\t\t}\r\n   334\t\r\n   335\t\tvar sumAbs, sumSq, maxAbs float64\r\n   336\t\tcount := 0\r\n   337\t\tfor i := 0; i < len(r1) && i < len(r2); i++ {\r\n   338\t\t\tdiffs := make([]float64, maxOut)\r\n   339\t\t\tfor o := 0; o < maxOut; o++ {\r\n   340\t\t\t\td := math.Abs(r1[i][o] - r2[i][o])\r\n"]
[12674.274237, "o", "   341\t\t\t\tdiffs[o] = d\r\n   342\t\t\t\tsumAbs += d\r\n   343\t\t\t\tsumSq += d * d\r\n   344\t\t\t\tif d > maxAbs {\r\n   345\t\t\t\t\tmaxAbs = d\r\n   346\t\t\t\t}\r\n   347\t\t\t\tcount++\r\n   348\t\t\t}\r\n   349\t\t\tfmt.Printf(\"row %d: %v\\n\", i, diffs)\r\n"]
[12674.274296, "o", "   350\t\t}\r\n   351\t\r\n   352\t\tvar mae, rmse float64\r\n   353\t\tif count > 0 {\r\n   354\t\t\tmae = sumAbs / float64(count)\r\n   355\t\t\trmse = math.Sqrt(sumSq / float64(count))\r\n   356\t\t}\r\n   357\t\r\n   358\t\t"]
[12674.274355, "o", "fmt.Printf(\"MAE: %.4f\\n\", mae)\r\n   359\t\tfmt.Printf(\"RMSE: %.4f\\n\", rmse)\r\n   360\t\tfmt.Printf(\"Max Abs Error: %.4f\\n\", maxAbs)\r\n   361\t}\r\n   362\t\r\n   363\tfunc formatFloatList(vals []float64) string {\r\n   364\t\tparts := make([]string, len(vals))\r\n   365\t\tfor i, v := range vals {\r\n   366\t\t\tparts[i] = formatFloat(v)\r\n   367\t\t}\r\n"]
[12674.274426, "o", "   368\t\treturn \"[\" + strings.Join(parts, \" \") + \"]\"\r\n   369\t}\r\n   370\t\r\n   371\tfunc cmdExplain(args []string) {\r\n   372\t\tif len(args) < 1 {\r\n   373\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe explain <model> --input <file> [--row <N>]\\n\")\r\n   374\t\t\tos.Exit(1)\r\n   375\t\t}\r\n   376\t\r\n   377\t\tmodel := args[0]\r\n   378\t\t"]
