[4605.408607, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\"bufio\"\r\n     5\t\"encoding/json\"\r\n     6\t\"fmt\"\r\n     7\t\"os\"\r\n     8\t\"path/filepath\"\r\n"]
[4605.408715, "o", "     9\t\"sort\"\r\n    10\t\"strings\"\r\n    11\t\"time\"\r\n    12\t)\r\n    13\t\r\n    14\tconst (\r\n    15\tregistryFile     = \"/app/models/registry.idx\"\r\n    16\tregistryJSONFile = \"/app/models/registry.json\"\r\n    17\t)\r\n    18\t\r\n    19\ttype RegistryEntry struct {\r\n    20\tName    string   `json:\"name\"`\r\n    21\tPath    string   `json:\"path\"`\r\n    22\tType    string   `json:\"type\"`\r\n    23\tVersion int      `json:\"version\"`\r\n    24\tCreated string   `json:\"created\"`\r\n    25\tTags    []string `json:\"tags\"`\r\n    26\t}\r\n"]
[4605.408819, "o", "    27\t\r\n    28\tfunc loadRegistry() ([]RegistryEntry, error) {\r\n    29\tdata, err := os.ReadFile(registryJSONFile)\r\n    30\tif err == nil {\r\n    31\tif len(strings.TrimSpace(string(data))) == 0 {\r\n    32\treturn nil, nil\r\n    33\t}\r\n    34\tvar entries []RegistryEntry\r\n    35\tif err := json.Unmarshal(data, &entries); err != nil {\r\n    36\treturn nil, fmt.Errorf(\"parse registry.json: %w\", err)\r\n    37\t}\r\n    38\tfor i := range entries {\r\n    39\tentries[i].Tags = ensureTags(entries[i].Tags)\r\n    40\t}\r\n    41\treturn entries, nil\r\n    42\t}"]
[4605.408943, "o", "\r\n    43\tif !os.IsNotExist(err) {\r\n    44\treturn nil, err\r\n    45\t}\r\n    46\t\r\n    47\tif _, err := os.Stat(registryFile); err == nil {\r\n    48\tentries, err := loadOldRegistry()\r\n    49\tif err != nil {\r\n    50\treturn nil, err\r\n    51\t}\r\n    52\tif err := saveRegistry(entries); err != nil {\r\n    53\treturn nil, err\r\n    54\t}\r\n    55\treturn entries, nil\r\n    56\t}\r\n    57\t\r\n    58\treturn nil, nil\r\n    59\t}\r\n    60\t\r\n    61\tfunc loadOldRegistry() ([]RegistryEntry, error) {\r\n"]
[4605.409004, "o", "    62\tf, err := os.Open(registryFile)\r\n    63\tif err != nil {\r\n    64\tif os.IsNotExist(err) {\r\n    65\treturn nil, nil\r\n    66\t}\r\n    67\treturn nil, err\r\n    68\t}\r\n    69\tdefer f.Close()\r\n    70\t\r\n    71\tvar entries []RegistryEntry\r\n    72\tscanner := bufio.NewScanner(f)\r\n"]
[4605.409073, "o", "    73\tfor scanner.Scan() {\r\n    74\tline := strings.TrimSpace(scanner.Text())\r\n    75\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    76\tcontinue\r\n    77\t}\r\n    78\tparts := strings.Split(line, \"|\")\r\n    79\tif len(parts) != 5 {\r\n    80\tcontinue\r\n    81\t}\r\n    82\tver := 1\r\n    83\tfmt.Sscanf(parts[3], \"%d\", &ver)\r\n"]
[4605.409155, "o", "    84\tentries = append(entries, RegistryEntry{\r\n    85\tName:    parts[0],\r\n    86\tPath:    parts[1],\r\n    87\tType:    parts[2],\r\n    88\tVersion: ver,\r\n    89\tCreated: parts[4],\r\n    90\tTags:    []string{},\r\n    91\t})\r\n    92\t}\r\n    93\treturn entries, scanner.Err()\r\n    94\t}\r\n    95\t\r\n    96\tfunc saveRegistry(entries []RegistryEntry) error {\r\n    97\tdir := filepath.Dir(registryJSONFile)\r\n"]
[4605.409229, "o", "    98\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n    99\treturn err\r\n   100\t}\r\n   101\t\r\n   102\tout := make([]RegistryEntry, len(entries))\r\n   103\tfor i, e := range entries {\r\n   104\te.Tags = ensureTags(e.Tags)\r\n   105\tout[i] = e\r\n   106\t}\r\n   107\t\r\n   108\tdata, err := json.MarshalIndent(out, \"\", \"  \")\r\n   109\tif err != nil {\r\n   110\t"]
[4605.409294, "o", "return err\r\n   111\t}\r\n   112\treturn os.WriteFile(registryJSONFile, data, 0644)\r\n   113\t}\r\n   114\t\r\n   115\tfunc ensureTags(tags []string) []string {\r\n   116\tif tags == nil {\r\n   117\treturn []string{}\r\n   118\t}\r\n   119\treturn tags\r\n   120\t}\r\n   121\t\r\n"]
[4605.409358, "o", "   122\tfunc findEntry(entries []RegistryEntry, name string) *RegistryEntry {\r\n   123\tfor i := range entries {\r\n   124\tif entries[i].Name == name {\r\n   125\treturn &entries[i]\r\n   126\t}\r\n   127\t}\r\n   128\treturn nil\r\n   129\t}\r\n   130\t\r\n   131\tfunc cmdList(args []string) {\r\n"]
[4605.409419, "o", "   132\tentries, err := loadRegistry()\r\n   133\tif err != nil {\r\n   134\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   135\tos.Exit(1)\r\n   136\t}\r\n   137\tif len(entries) == 0 {\r\n   138\tfmt.Println(\"No models registered.\")\r\n   139\treturn\r\n   140\t}"]
[4605.409479, "o", "\r\n   141\t\r\n   142\tsort.Slice(entries, func(i, j int) bool {\r\n   143\treturn entries[i].Name < entries[j].Name\r\n   144\t})\r\n   145\t\r\n   146\tfor _, e := range entries {\r\n   147\ttags := append([]string(nil), e.Tags...)\r\n   148\tsort.Strings(tags)\r\n"]
[4605.409556, "o", "   149\tif len(tags) > 0 {\r\n   150\tfmt.Printf(\"%s (%s)\\n\", e.Name, strings.Join(tags, \", \"))\r\n   151\t} else {\r\n   152\tfmt.Println(e.Name)\r\n   153\t}\r\n   154\t}\r\n   155\t}\r\n   156\t"]
[4605.409632, "o", "\r\n   157\tfunc cmdInfo(args []string) {\r\n   158\tif len(args) < 1 {\r\n   159\tfmt.Fprintf(os.Stderr, \"usage: mlpipe info <model>\\n\")\r\n   160\tos.Exit(1)\r\n   161\t}\r\n   162\tname := args[0]\r\n   163\tentries, err := loadRegistry()\r\n   164\tif err != nil {\r\n   165\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   166\tos.Exit(1)\r\n   167\t}"]
[4605.409716, "o", "\r\n   168\tentry := findEntry(entries, name)\r\n   169\tif entry == nil {\r\n   170\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n   171\tos.Exit(1)\r\n   172\t}\r\n   173\tif !modelDirExists(entry.Path) {\r\n   174\tfmt.Fprintf(os.Stderr, \"error: model directory not found\\n\")\r\n   175\tos.Exit(1)\r\n   176\t}\r\n   177\t\r\n   178\tmeta, err := loadModelMeta(entry.Path)\r\n   179\tif err != nil {\r\n   180\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n   181\tos.Exit(1)\r\n   182\t}\r\n   183\t\r\n   184\tweights, err := loadWeights(entry.Path)\r\n   185\tif err != nil {\r\n   186\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n"]
[4605.409813, "o", "   187\tos.Exit(1)\r\n   188\t}\r\n   189\t\r\n   190\tfmt.Printf(\"Name:        %s\\n\", meta[\"name\"])\r\n   191\tfmt.Printf(\"Type:        %s\\n\", meta[\"type\"])\r\n   192\tfmt.Printf(\"Version:     %s\\n\", meta[\"version\"])\r\n   193\tfmt.Printf(\"Created:     %s\\n\", meta[\"created\"])\r\n   194\tfmt.Printf(\"Description: %s\\n\", meta[\"description\"])\r\n   195\tfmt.Printf(\"Features:    %s\\n\", meta[\"features\"])\r\n   196\tfmt.Printf(\"Outputs:     %s\\n\", meta[\"outputs\"])\r\n   197\tfmt.Printf(\"Format:     v%d\\n\", weights.Version)\r\n   198\tfmt.Printf(\"Activation: %s\\n\", activationIDToName(weights.Activation))\r\n   199\tfmt.Printf(\"Path:        %s\\n\", entry.Path)\r\n   200\t}\r\n   201\t\r\n   202\tfunc cmdRegister(args []string) {\r\n"]
[4605.409882, "o", "   203\tif len(args) < 2 {\r\n   204\tfmt.Fprintf(os.Stderr, \"usage: mlpipe register <name> <path>\\n\")\r\n   205\tos.Exit(1)\r\n   206\t}\r\n   207\tname := args[0]\r\n   208\tmodelPath := args[1]\r\n   209\t\r\n   210\tabsPath, err := filepath.Abs(modelPath)\r\n   211\tif err != nil {\r\n   212\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   213\tos.Exit(1)\r\n   214\t}\r\n"]
