[13665.930983, "i", "cat > upgrade_verify.go <<'EOF'\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n)\n\nfunc cmdUpgrade(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe upgrade <model>\\n\")\n\t\tos.Exit(1)\n\t}\n\tname := args[0]\n\tentry := resolveModel(name)\n\n\tweightsPath := filepath.Join(entry.Path, \"weights.bin\")\n\n\tweights, err := loadWeights(entry.Path)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tif weights.Version >= 3 {\n\t\tfmt.Println(\"already at latest version\")\n\t\treturn\n\t}\n\n\tbackupPath := weightsPath + \".v2bak\"\n\tif weights.Version == 1 {\n\t\tbackupPath = weightsPath + \".v1bak\"\n\t}\n\n\tdata, err := os.ReadFile(weightsPath)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error reading weights: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\tif err := os.WriteFile(backupPath, data, 0644); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error writing backup: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tif weights.Version == 1 {\n\t\tweights.Activation = activationNone\n\t}\n\tweights.Version = 3\n\n\tif err := wri"]
[13665.931216, "i", "teWeights(weightsPath, weights); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error writing weights: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tmeta, err := loadModelMeta(entry.Path)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\tmeta[\"format_version\"] = \"3\"\n\tmeta[\"activation\"] = activationIDToName(weights.Activation)\n\tif err := saveModelMeta(entry.Path, meta); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error updating metadata: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tfmt.Printf(\"model '%s' upgraded to format v3\\n\", name)\n}\n\nfunc cmdVerify(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe verify <model>\\n\")\n\t\tos.Exit(1)\n\t}\n\tname := args[0]\n\tentry := resolveModel(name)\n\n\tif _, err := loadWeights(entry.Path); err != nil {\n\t\tfmt.Printf(\"model '%s' integrity: FAILED (%v)\\n\", name, err)\n\t\tos.Exit(1)\n\t}\n\tfmt.Printf(\"model '%s' integrity: OK\\n\", name)\n}\nEOF\n"]
