[8943.685444, "o", "-rw-r--r-- 1 root root    3651 Sep 10 08:50 checkpoints.go\r\ndrwxrwxr-x 1 root root    4096 Aug 11 12:38 \u001b[01;34mcmd\u001b[0m\r\n-rw-rw-r-- 1 root root    2187 Sep 10 09:03 commands.go\r\n-rw-r--r-- 1 root root   12632 Sep 10 09:16 commands_extra.go\r\n-rw-r--r-- 1 root root    8107 Sep 10 09:40 ensemble.go\r\n-rw-r--r-- 1 root root   11999 Sep 10 08:56 export_import.go\r\n-rw-rw-r-- 1 root root    6519 Sep 10 08:15 format.go\r\n"]
