[9674.467537, "o", "\u001b[?2004l\r"]
[9674.471181, "o", "    30\t\t\t}\r\n    31\t\t\tparts := strings.SplitN(line, \"=\", 2)\r\n    32\t\t\tif len(parts) == 2 {\r\n    33\t\t\t\tmeta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])\r\n    34\t\t\t}\r\n    35\t\t}\r\n    36\t\treturn meta, scanner.Err()\r\n"]
[9674.471262, "o", "    37\t}\r\n    38\t\r\n    39\ttype WeightsData struct {\r\n    40\t\tVersion     uint32\r\n    41\t\tNumFeatures uint32\r\n    42\t\tNumOutputs  uint32\r\n    43\t\tActivation  uint32\r\n    44\t\tWeights     []float64\r\n    45\t\tBias        []float64\r\n    46\t}\r\n    47"]
[9674.471332, "o", "\t\r\n    48\tfunc loadWeights(modelDir string) (*WeightsData, error) {\r\n    49\t\tf, err := os.Open(filepath.Join(modelDir, \"weights.bin\"))\r\n    50\t\tif err != nil {\r\n    51\t\t\treturn nil, err\r\n    52\t\t}\r\n    53\t\tdefer f.Close()\r\n    54\t\r\n    55\t\t"]
[9674.471395, "o", "magic := make([]byte, 4)\r\n    56\t\tif _, err := f.Read(magic); err != nil {\r\n    57\t\t\treturn nil, fmt.Errorf(\"failed to read magic: %v\", err)\r\n    58\t\t}\r\n    59\t\tif string(magic) != string(modelMagic) {\r\n    60\t\t\treturn nil, fmt.Errorf(\"invalid model file: bad magic\")\r\n    61\t\t}\r\n    62\t\r\n    63\t\tvar ver, nf, no uint32\r\n    64\t\tif err := binary.Read(f, binary.LittleEndian, &ver); err != nil {\r\n"]
[9674.471437, "o", "    65\t\t\treturn nil, fmt.Errorf(\"failed to read version: %v\", err)\r\n    66\t\t}\r\n    67\t\tif err := binary.Read(f, binary.LittleEndian, &nf); err != nil {\r\n    68\t\t\treturn nil, fmt.Errorf(\"failed to read num_features: %v\", err)\r\n    69\t\t}\r\n"]
[9674.471523, "o", "    70\t\tif err := binary.Read(f, binary.LittleEndian, &no); err != nil {\r\n    71\t\t\treturn nil, fmt.Errorf(\"failed to read num_outputs: %v\", err)\r\n    72\t\t}\r\n    73\t\r\n    74\t\tvar act uint32\r\n    75\t\tswitch ver {\r\n    76\t\tcase 1:\r\n    77\t\t\tact = 0\r\n    78\t\tcase 2:\r\n    79\t\t\tif err := binary.Read(f, binary.LittleEndian, &act); err != nil {\r\n    80\t\t\t\treturn nil, fmt.Errorf(\"failed to read activation: %v\", err)\r\n    81\t\t\t}\r\n    82\t"]
[9674.47159, "o", "\tdefault:\r\n    83\t\t\treturn nil, fmt.Errorf(\"unsupported model format version: %d\", ver)\r\n    84\t\t}\r\n    85\t\r\n    86\t\tweights := make([]float64, nf*no)\r\n    87\t\tfor i := range weights {\r\n    88\t\t\tif err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {\r\n    89\t\t\t\treturn nil, fmt.Errorf(\"failed to read weight[%d]: %v\", i, err)\r\n"]
[9674.471651, "o", "    90\t\t\t}\r\n    91\t\t}\r\n    92\t\r\n    93\t\tbias := make([]float64, no)\r\n    94\t\tfor i := range bias {\r\n    95\t\t\tif err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {\r\n    96\t\t\t\treturn nil, fmt.Errorf(\"failed to read bias[%d]: %v\", i, err)\r\n    97\t\t\t}\r\n    98\t\t}\r\n"]
[9674.471712, "o", "    99\t\r\n   100\t\treturn &WeightsData{\r\n   101\t\t\tVersion:     ver,\r\n   102\t\t\tNumFeatures: nf,\r\n   103\t\t\tNumOutputs:  no,\r\n   104\t\t\tActivation:  act,\r\n   105\t\t\tWeights:     weights,\r\n   106\t\t\tBias:        bias,\r\n   107\t\t}, nil\r\n   108\t}\r\n   109\t\r\n"]
[9674.47177, "o", "   110\tfunc writeWeights(path string, w *WeightsData) error {\r\n   111\t\tf, err := os.Create(path)\r\n   112\t\tif err != nil {\r\n   113\t\t\treturn err\r\n   114\t\t}\r\n   115\t\tdefer f.Close()\r\n   116\t\r\n   117\t"]
