[9711.035225, "o", "   157\tfunc cmdInfo(args []string) {\r\n   158\t\tif len(args) < 1 {\r\n   159\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe info <model>\\n\")\r\n   160\t\t\tos.Exit(1)\r\n   161\t\t}\r\n"]
