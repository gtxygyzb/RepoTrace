[13893.731096, "o", "    20\tfunc loadModelMeta(modelDir string) (map[string]string, error) {\r\n    21\t\tf, err := os.Open(filepath.Join(modelDir, \"model.meta\"))\r\n    22\t\tif err != nil {\r\n    23\t\t\treturn nil, err\r\n    24\t\t}\r\n    25\t\tdefer f.Close()\r\n    26\t\r\n    27\t\tmeta := make(map[string]string)\r\n    28\t\tscanner := bufio.NewScanner(f)\r\n    29\t\tfor scanner.Scan() {\r\n    30\t\t\tline := strings.TrimSpace(scanner.Text())\r\n"]
[13893.731177, "o", "    31\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    32\t\t\t\tcontinue\r\n    33\t\t\t}\r\n    34\t\t\tparts := strings.SplitN(line, \"=\", 2)\r\n    35\t\t\tif len(parts) == 2 {\r\n    36\t\t\t\tmeta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])\r\n    37\t\t\t}\r\n    38\t\t}\r\n    39\t\treturn meta, scanner.Err()\r\n    40\t}\r\n    41\t\r\n    42\ttype WeightsData struct {\r\n"]
