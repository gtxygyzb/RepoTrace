[6031.42422, "o", "\tparts := strings.SplitN(line, \"=\", 2)\r\n   256\t\t\tif len(parts) != 2 {\r\n   257\t\t\t\tcontinue\r\n   258\t\t\t}\r\n   259\t\t\tkey := strings.TrimSpace(parts[0])\r\n   260\t\t\tval := strings.TrimSpace(parts[1])\r\n   261\t\r\n   262\t\t\tswitch section {\r\n   263\t\t\tcase \"preprocess\":\r\n   264\t\t\t\tswitch key {\r\n   265\t\t\t\tcase \"normalize\":\r\n"]
[6031.424283, "o", "   266\t\t\t\t\tcfg.Normalize = val == \"true\"\r\n   267\t\t\t\tcase \"scale_range\":\r\n   268\t\t\t\t\trangeParts := strings.Split(val, \",\")\r\n   269\t\t\t\t\tif len(rangeParts) == 2 {\r\n   270\t\t\t\t\t\tcfg.ScaleMin, _ = strconv.ParseFloat(rangeParts[0], 64)\r\n   271\t\t\t\t\t\tcfg.ScaleMax, _ = strconv.ParseFloat(rangeParts[1], 64)\r\n   272\t\t\t\t\t}\r\n"]
[6031.42434, "o", "   273\t\t\t\tcase \"missing_strategy\":\r\n   274\t\t\t\t\tcfg.MissingStrategy = val\r\n   275\t\t\t\t}\r\n   276\t\t\tcase \"postprocess\":\r\n   277\t\t\t\tswitch key {\r\n   278\t\t\t\tcase \"round_digits\":\r\n"]
[6031.424398, "o", "   279\t\t\t\t\tcfg.RoundDigits, _ = strconv.Atoi(val)\r\n   280\t\t\t\tcase \"clip_min\":\r\n   281\t\t\t\t\tcfg.ClipMin, _ = strconv.ParseFloat(val, 64)\r\n   282\t\t\t\tcase \"clip_max\":\r\n   283\t\t\t\t\tcfg.ClipMax, _ = strconv.ParseFloat(val, 64)\r\n   284\t\t\t\t}\r\n   285\t\t\t}\r\n"]
