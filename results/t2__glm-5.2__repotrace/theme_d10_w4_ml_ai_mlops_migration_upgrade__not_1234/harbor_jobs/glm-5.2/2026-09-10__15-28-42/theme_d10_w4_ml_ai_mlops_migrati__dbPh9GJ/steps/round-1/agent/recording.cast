[11647.486032, "o", "\t\tfmt.Printf(\"  - %s\\n\", fail)\r\n\t}\r\n}\r\n\r\nfunc cmdBenchmark(args []string) {\r\n\tif len(args) < 1 {\r\n\t\t"]
[11647.486152, "o", "fmt.Fprintf(os.Stderr, \"usage: mlpipe benchmark <model> --input <file> [--runs <N>]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmodel := args[0]\r\n\tflags := parseFlags(args[1:])\r\n\r\n\tinput := flags[\"input\"]\r\n\tif input == \"\" || input == \"true\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: --input is required\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\truns := 10\r\n\tif r, ok := flags[\"runs\"]; ok && r != \"true\" {\r\n\t\tn, err := strconv.Atoi(r)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid --runs value\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}"]
[11647.486241, "o", "\r\n\t\tif n < 1 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: runs must be positive\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\truns = n\r\n\t}\r\n\r\n\tentry, err := resolveModel(model)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"not found\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif _, err := os.Stat(input); err != nil {\r\n"]
[11647.486315, "o", "\t\tfmt.Fprintf(os.Stderr, \"file not found\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tweights, cfg, err := loadModelArtifacts(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading model: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tinputs, err := readInputCSV(input)\r\n"]
[11647.486404, "o", "\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\trows := len(inputs)\r\n\r\n\tstart := time.Now()\r\n\tfor i := 0; i < runs; i++ {\r\n\t\t_ = runInference(inputs, weights, cfg)\r\n"]
[11647.486479, "o", "\t}\r\n\telapsed := time.Since(start)\r\n\r\n\ttotalMs := float64(elapsed.Nanoseconds()) / 1e6\r\n\tavgRunMs := 0.0\r\n\tavgRowUs := 0.0\r\n\tthroughput := 0.0\r\n\tif runs > 0 {\r\n\t\tavgRunMs = totalMs / float64(runs)\r\n\t\tif rows > 0 {\r\n\t\t\tavgRowUs = avgRunMs * 1000.0 / float64(rows)\r\n\t\t}\r\n\t\tif elapsed > 0 {\r\n\t\t\tthroughput = float64(rows*runs) / elapsed.Seconds()\r\n\t\t}\r\n\t}\r\n\r\n\tfmt.Printf(\"Benchmark: %s (%d runs, %d rows per run)\\n\", model, runs, rows)\r\n\tfmt.Printf(\"Total time:    %.3fms\\n\", totalMs)\r\n"]
[11647.486552, "o", "\tfmt.Printf(\"Avg per run:   %.3fms\\n\", avgRunMs)\r\n\tfmt.Printf(\"Avg per row:   %.3fus\\n\", avgRowUs)\r\n\tfmt.Printf(\"Throughput:    %.3f rows/sec\\n\", throughput)\r\n}\r\n\r\nfunc cmdPrune(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe prune <model> --threshold <value> [--dry-run]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[11647.486632, "o", "\r\n\tmodel := args[0]\r\n\tflags := parseFlags(args[1:])\r\n\r\n\tthresholdStr := flags[\"threshold\"]\r\n\tif thresholdStr == \"\" || thresholdStr == \"true\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: --threshold is required\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tthreshold, err := strconv.ParseFloat(thresholdStr, 64)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid threshold\\n\")\r\n\t\tos.Exit(1)\r\n"]
[11647.486721, "o", "\t}\r\n\tif threshold <= 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"threshold must be positive\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tdryRun := flags[\"dry-run\"] == \"true\"\r\n\r\n\tentry, err := resolveModel(model)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"not found\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tweights, err := loadWeights(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n"]
[11647.486807, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\ttotal := len(weights.Weights)\r\n\tpruned := 0\r\n\tfor i, v := range weights.Weights {\r\n\t\tif math.Abs(v) < threshold {\r\n\t\t\tpruned++\r\n\t\t\tweights.Weights[i] = 0.0\r\n\t\t}\r\n\t}\r\n\r\n\t"]
[11647.48688, "o", "zeroCount := 0\r\n\tfor _, v := range weights.Weights {\r\n\t\tif v == 0.0 {\r\n\t\t\tzeroCount++\r\n\t\t}\r\n\t}\r\n\r\n\tprunedPct := 0.0\r\n\tsparsity := 0.0\r\n"]
[11647.486952, "o", "\tif total > 0 {\r\n\t\tprunedPct = float64(pruned) / float64(total) * 100.0\r\n\t\tsparsity = float64(zeroCount) / float64(total) * 100.0\r\n\t}\r\n\r\n\tfmt.Printf(\"Pruning '%s' (threshold=%s)\\n\", model, thresholdStr)\r\n\tfmt.Printf(\"Total weights:  %d\\n\", total)\r\n\tfmt.Printf(\"Pruned:         %d (%.1f%%)\\n\", pruned, prunedPct)\r\n\tfmt.Printf(\"New sparsity:   %.1f%%\\n\", sparsity)\r\n\r\n\tif dryRun {\r\n\t\tfmt.Println(\"(dry run - no changes made)\")\r\n\t"]
[11647.487025, "o", "\treturn\r\n\t}\r\n\r\n\tcpDir := filepath.Join(checkpointsDir(entry.Path), \"pre-prune\")\r\n\tif err := os.MkdirAll(cpDir, 0755); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[11647.487093, "o", "\t\tos.Exit(1)\r\n"]
