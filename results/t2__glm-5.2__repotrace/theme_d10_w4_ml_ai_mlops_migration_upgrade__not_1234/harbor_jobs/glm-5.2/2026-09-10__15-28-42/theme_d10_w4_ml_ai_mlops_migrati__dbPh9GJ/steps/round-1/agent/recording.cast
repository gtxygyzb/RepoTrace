[7055.786984, "o", "   360\t}\r\n   361\t\r\n   362\tfunc minInt(a, b int) int {\r\n   363\t\tif a < b {\r\n   364\t\t\treturn a\r\n   365\t\t}\r\n   366\t\treturn b\r\n   367\t}\r\n"]
[7055.787083, "o", "   368\t\r\n   369\tfunc cmdProfile(args []string) {\r\n   370\t\tif len(args) < 1 {\r\n   371\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe profile <model>\\n\")\r\n   372\t\t\tos.Exit(1)\r\n   373\t\t}\r\n   374\t\tmodel := args[0]\r\n   375\t\r\n   376\t\tentry, err := resolveModel(model)\r\n   377\t\tif err != nil {\r\n   378\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   379\t\t\tos.Exit(1)\r\n   380\t\t}\r\n   381\t\r\n"]
[7055.787159, "o", "   382\t\tweightsPath := filepath.Join(entry.Path, \"weights.bin\")\r\n   383\t\tinfo, err := os.Stat(weightsPath)\r\n   384\t\tif err != nil {\r\n   385\t\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n   386\t\t\tos.Exit(1)\r\n   387\t\t}\r\n   388\t\r\n   389\t\tweights, _, err := loadModelArtifacts(entry.Path)\r\n   390\t\tif err != nil {\r\n   391\t\t\tfmt.Fprintf(os.Stderr, \"error loading model: %v\\n\", err)\r\n   392\t\t\tos.Exit(1)\r\n"]
[7055.787227, "o", "   393\t\t}\r\n   394\t\r\n   395\t\tfeatures := int(weights.NumFeatures)\r\n   396\t\toutputs := int(weights.NumOutputs)\r\n   397\t\ttotalParams := features*outputs + outputs\r\n   398\t\r\n   399\t\tvar wmin, wmax, wsum float64\r\n   400\t\tzeroCount := 0\r\n   401\t\tif len(weights.Weights) > 0 {\r\n   402\t\t"]
[7055.787283, "o", "\twmin = weights.Weights[0]\r\n   403\t\t\twmax = weights.Weights[0]\r\n   404\t\t\tfor _, v := range weights.Weights {\r\n   405\t\t\t\tif v < wmin {\r\n   406\t\t\t\t\twmin = v\r\n   407\t\t\t\t}\r\n   408\t\t\t\tif v > wmax {\r\n"]
[7055.78734, "o", "   409\t\t\t\t\twmax = v\r\n   410\t\t\t\t}\r\n   411\t\t\t\twsum += v\r\n   412\t\t\t\tif v == 0 {\r\n   413\t\t\t\t\tzeroCount++\r\n   414\t\t\t\t}\r\n   415\t\t\t}\r\n   416\t\t} else {\r\n"]
[7055.787403, "o", "   417\t\t\twmin = 0\r\n   418\t\t\twmax = 0\r\n   419\t\t}\r\n   420\t\twavg := 0.0\r\n   421\t\tif len(weights.Weights) > 0 {\r\n   422\t\t\twavg = wsum / float64(len(weights.Weights))\r\n   423\t\t}\r\n"]
[7055.787472, "o", "   424\t\tsparsity := 0.0\r\n   425\t\tif len(weights.Weights) > 0 {\r\n   426\t\t\tsparsity = float64(zeroCount) / float64(len(weights.Weights)) * 100\r\n   427\t\t}\r\n   428\t\r\n   429\t\tfmt.Printf(\"Name:       %s\\n\", entry.Name)\r\n"]
[7055.787537, "o", "   430\t\tfmt.Printf(\"Type:       %s\\n\", entry.Type)\r\n"]
