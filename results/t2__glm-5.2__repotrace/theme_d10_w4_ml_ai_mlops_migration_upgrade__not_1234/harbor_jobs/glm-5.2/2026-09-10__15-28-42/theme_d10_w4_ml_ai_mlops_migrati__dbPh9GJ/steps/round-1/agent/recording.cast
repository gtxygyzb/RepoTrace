[12203.907982, "o", "    80\t\t\t\tfmt.Fprintf(os.Stderr, \"error creating output file: %v\\n\", err)\r\n    81\t\t\t\tos.Exit(1)\r\n    82\t\t\t}\r\n    83\t\t\tdefer f.Close()\r\n    84\t\t\twriteOutput(f, results, outputFormat)\r\n    85\t\t} else {\r\n"]
[12203.908299, "o", "    86\t\t\twriteOutput(os.Stdout, results, outputFormat)\r\n    87\t\t}\r\n    88\t}\r\n    89\t\r\n    90\tfunc readInputCSV(path string) ([][]float64, error) {\r\n    91\t\tf, err := os.Open(path)\r\n    92\t\tif err != nil {\r\n    93\t\t\treturn nil, err\r\n    94\t\t}\r\n    95\t\tdefer f.Close()\r\n    96\t\r\n    97\t\treader := csv.NewReader(f)\r\n    98\t\trecords, err := reader.ReadAll()\r\n    99\t\tif err != nil {\r\n   100\t\t\treturn nil, err\r\n   101\t\t}\r\n   102\t\r\n   103\t\tvar data [][]float64\r\n   104\t\tfor i, record := range records {\r\n   105\t\t\tif i == 0 && isHeader(record) {\r\n   106\t\t\t\tcontinue\r\n   107\t\t\t}\r\n   108\t\t\trow := make([]float64, len(record))\r\n   109\t\t\tfor j, val := range record {\r\n   110\t\t\t\tval = strings.TrimSpace(val)\r\n   111\t\t\t\tif val == \"\" || val == \"NA\" || val == \"nan\" {\r\n   112\t\t\t\t\trow[j] = math.NaN()\r\n   113\t\t\t\t} else {\r\n   114\t\t\t\t\trow[j], err = strconv.ParseFloat(val, 64)\r\n   115\t\t\t\t\tif err != nil {\r\n   116\t\t\t\t\t\treturn nil, fmt.Errorf(\"row %d col %d: %v\", i, j, err)\r\n"]
[12203.908431, "o", "   117\t\t\t\t\t}\r\n   118\t\t\t\t}\r\n   119\t\t\t}\r\n   120\t\t\tdata = append(data, row)\r\n   121\t\t}\r\n   122\t\treturn data, nil\r\n   123\t}\r\n   124\t\r\n   125\tfunc isHeader(record []string) bool {\r\n   126\t\tfor _, val := range record {\r\n   127\t\t\t_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)\r\n   128\t\t\tif err == nil {\r\n   129\t\t\t\treturn false\r\n"]
[12203.908509, "o", "   130\t\t\t}\r\n   131\t\t}\r\n   132\t\treturn true\r\n   133\t}\r\n   134\t\r\n   135\tfunc runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n"]
