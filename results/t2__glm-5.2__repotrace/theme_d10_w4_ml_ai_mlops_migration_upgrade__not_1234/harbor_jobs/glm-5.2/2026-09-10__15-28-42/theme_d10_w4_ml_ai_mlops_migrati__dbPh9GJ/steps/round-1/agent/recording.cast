[11324.754083, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/csv\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"math\"\r\n"]
[11324.754166, "o", "     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t)\r\n    13\t\r\n    14\tfunc modelDirExists(path string) bool {\r\n    15\t\tinfo, err := os.Stat(path)\r\n    16\t\treturn err == nil && info.IsDir()\r\n    17\t}\r\n    18\t\r\n    19\tfunc resolveModel(name string) (*RegistryEntry, error) {\r\n    20\t\tentries, err := loadRegistry()\r\n"]
[11324.754242, "o", "    21\t\tif err != nil {\r\n    22\t\t\treturn nil, err\r\n    23\t\t}\r\n    24\t\tentry := findEntry(entries, name)\r\n    25\t\tif entry == nil || !modelDirExists(entry.Path) {\r\n"]
[11324.754306, "o", "    26\t\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n    27\t\t\tos.Exit(1)\r\n    28\t\t}\r\n    29\t\treturn entry, nil\r\n    30\t}\r\n    31\t\r\n    32\tfunc loadModelArtifacts(modelDir string) (*WeightsData, *PipelineConfig, error) {\r\n    33\t\tweights, err := loadWeights(modelDir)\r\n    34\t\tif err != nil {\r\n    35\t\t\treturn nil, nil, err\r\n    36\t\t}\r\n    37\t\tcfg, err := loadPipelineConfig(modelDir)\r\n    38\t\tif err != nil {\r\n    39\t\t\treturn nil, nil, err\r\n    40\t\t}\r\n    41\t"]
[11324.75437, "o", "\treturn weights, cfg, nil\r\n    42\t}\r\n    43\t\r\n    44\tfunc validateFeatureCount(inputs [][]float64, expected int) error {\r\n    45\t\tfor i, row := range inputs {\r\n    46\t\t\tif len(row) != expected {\r\n    47\t\t\t\treturn fmt.Errorf(\"expected %d features, got %d in row %d\", expected, len(row), i)\r\n    48\t\t\t}\r\n    49\t\t}\r\n    50\t\treturn nil\r\n    51\t"]
[11324.754437, "o", "}\r\n    52\t\r\n    53\tfunc readCSVRaw(path string) ([][]string, error) {\r\n    54\t\tf, err := os.Open(path)\r\n    55\t\tif err != nil {\r\n    56\t\t\treturn nil, err\r\n    57\t\t}\r\n    58\t\tdefer f.Close()\r\n"]
[11324.754497, "o", "    59\t\r\n    60\t\treader := csv.NewReader(f)\r\n    61\t\treader.FieldsPerRecord = -1\r\n    62\t\treturn reader.ReadAll()\r\n    63\t}\r\n    64\t\r\n    65\tfunc isMissingValue(val string) bool {\r\n    66\t\tval = strings.TrimSpace(val)\r\n    67\t\tif val == \"\" {\r\n    68\t\t\treturn true\r\n"]
[11324.75456, "o", "    69\t\t}\r\n    70\t\tlower := strings.ToLower(val)\r\n    71\t\treturn lower == \"na\" || lower == \"nan\"\r\n    72\t}\r\n    73\t\r\n    74\tfunc cmdStats(args []string) {\r\n    75\t\tflags := parseFlags(args)\r\n    76\t\tinput := flags[\"input\"]\r\n    77\t\tif input == \"\" {\r\n"]
[11324.754641, "o", "    78\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe stats --input <file>\\n\")\r\n    79\t\t\tos.Exit(1)\r\n    80\t\t}\r\n    81\t\r\n    82\t\trecords, err := readCSVRaw(input)\r\n    83\t\tif err != nil {\r\n    84\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    85\t\t\tos.Exit(1)\r\n    86\t\t}\r\n    87\t\tif len(records) == 0 {\r\n    88\t\t\tfmt.Println(\"No data found.\")\r\n    89\t"]
[11324.754703, "o", "\t\treturn\r\n    90\t\t}\r\n    91\t\r\n    92\t\thasHeader := isHeader(records[0])\r\n    93\t\tstart := 0\r\n    94\t\tif hasHeader {\r\n    95\t\t\tstart = 1\r\n    96\t\t}\r\n    97\t\r\n    98"]
[11324.75476, "o", "\t\tnumCols := 0\r\n    99\t\tfor _, rec := range records {\r\n   100\t\t\tif len(rec) > numCols {\r\n   101\t\t\t\tnumCols = len(rec)\r\n   102\t\t\t}\r\n   103\t\t}\r\n   104\t\r\n   105\t\theaders := make([]string, numCols)\r\n"]
[11324.754847, "o", "   106\t\tfor i := 0; i < numCols; i++ {\r\n   107\t\t\tif hasHeader && i < len(records[0]) {\r\n   108\t\t\t\theaders[i] = strings.TrimSpace(records[0][i])\r\n   109\t\t\t} else {\r\n   110\t\t\t\theaders[i] = fmt.Sprintf(\"col_%d\", i)\r\n   111\t\t\t}\r\n   112\t\t}\r\n   113\t\r\n   114\t\ttype colStat struct {\r\n   115\t\t\tidx     int\r\n   116\t\t\tname    string\r\n   117\t\t\tcount   int\r\n"]
[11324.75491, "o", "   118\t\t\tmissing int\r\n   119\t\t\tmin     float64\r\n   120\t\t\tmax     float64\r\n   121\t\t\tmean    float64\r\n   122\t\t\tstddev  float64\r\n"]
[11324.754976, "o", "   123\t\t\tvalues  []float64\r\n   124\t\t}\r\n   125\t\r\n   126\t\tvar stats []colStat\r\n   127\t\tnumericCols := make([]int, 0)\r\n   128\t\tvaluesByCol := make(map[int][]float64)\r\n   129\t\tvar skippedCols []string\r\n   130\t\r\n   131\t\tfor j := 0; j < numCols; j++ {\r\n   132\t\t\tvalues := make([]float64, 0, len(records)-start)\r\n   133\t\t\tmissing := 0\r\n   134\t\t\tnumeric := true\r\n   135\t\r\n   136\t\t\tfor i := start; i < len(records); i++ {\r\n"]
[11324.755036, "o", "   137\t\t\t\traw := \"\"\r\n   138\t\t\t\tif j < len(records[i]) {\r\n   139\t\t\t\t\traw = strings.TrimSpace(records[i][j])\r\n   140\t\t\t\t}\r\n   141\t\t\t\tif isMissingValue(raw) {\r\n   142\t\t\t\t\tmissing++\r\n   143\t\t\t\t\tvalues = append(values, math.NaN())\r\n   144\t\t\t\t\tcontinue\r\n   145\t\t\t\t}\r\n"]
[11324.755098, "o", "   146\t\t\t\tv, err := strconv.ParseFloat(raw, 64)\r\n   147\t\t\t\tif err != nil {\r\n   148\t\t\t\t\tnumeric = false\r\n   149\t\t\t\t\tbreak\r\n   150\t\t\t\t}\r\n   151\t\t\t\tvalues = append(values, v)\r\n   152\t\t\t}\r\n   153\t\r\n   154\t\t\tif !numeric {\r\n"]
[11324.755161, "o", "   155\t\t\t\tskippedCols = append(skippedCols, headers[j])\r\n   156\t\t\t\tcontinue\r\n   157\t\t\t}\r\n   158\t\r\n   159\t\t\tcount := len(values) - missing\r\n   160\t\t\tst := colStat{\r\n   161\t\t\t\tidx:     j,\r\n"]
[11324.75522, "o", "   162\t\t\t\tname:    headers[j],\r\n   163\t\t\t\tcount:   count,\r\n   164\t\t\t\tmissing: missing,\r\n   165\t\t\t\tmin:     math.NaN(),\r\n   166\t\t\t\tmax:     math.NaN(),\r\n   167\t\t\t\tmean:    math.NaN(),\r\n   168\t\t\t\tstddev:  math.NaN(),\r\n   169\t\t\t\tvalues:  values,\r\n"]
[11324.755278, "o", "   170\t\t\t}\r\n   171\t\r\n   172\t\t\tif count > 0 {\r\n   173\t\t\t\tsum := 0.0\r\n   174\t\t\t\tsumSq := 0.0\r\n   175\t\t\t\tminVal := math.Inf(1)\r\n   176\t\t\t\tmaxVal := math.Inf(-1)\r\n   177\t\t\t\tfor _, v := range values {\r\n   178"]
[11324.755341, "o", "\t\t\t\t\tif math.IsNaN(v) {\r\n   179\t\t\t\t\t\tcontinue\r\n   180\t\t\t\t\t}\r\n   181\t\t\t\t\tif v < minVal {\r\n   182\t\t\t\t\t\tminVal = v\r\n   183\t\t\t\t\t}\r\n   184\t\t\t\t\tif v > maxVal {\r\n   185\t\t\t\t\t\tmaxVal = v\r\n"]
[11324.755401, "o", "   186\t\t\t\t\t}\r\n   187\t\t\t\t\tsum += v\r\n   188\t\t\t\t\tsumSq += v * v\r\n   189\t\t\t\t}\r\n   190\t\t\t\tmean := sum / float64(count)\r\n   191\t\t\t\tvariance := sumSq/float64(count) - mean*mean\r\n   192\t\t\t\tif variance < 0 {\r\n   193\t\t\t\t\tvariance = 0\r\n   194\t\t\t\t}\r\n   195\t\t\t\tst.min = minVal"]
[11324.755462, "o", "\r\n   196\t\t\t\tst.max = maxVal\r\n   197\t\t\t\tst.mean = mean\r\n   198\t\t\t\tst.stddev = math.Sqrt(variance)\r\n   199\t\t\t}\r\n   200\t\r\n   201\t\t\tstats = append(stats, st)\r\n   202\t\t\tnumericCols = append(numericCols, j)\r\n   203\t\t\tvaluesByCol[j] = values\r\n   204\t\t}\r\n   205"]
[11324.75552, "o", "\t\r\n   206\t\tif len(skippedCols) > 0 {\r\n   207\t\t\tfmt.Printf(\"warning: skipping non-numeric columns: %s\\n\", strings.Join(skippedCols, \", \"))\r\n   208\t\t}\r\n   209\t\tif len(numericCols) == 0 {\r\n   210\t\t\tfmt.Println(\"error: no numeric columns found\")\r\n   211\t\t\tos.Exit(1)\r\n"]
[11324.755578, "o", "   212\t\t}\r\n   213\t\r\n   214\t\tfmt.Println(\"Per-column statistics:\")\r\n   215\t\tfmt.Printf(\"%-20s %6s %7s %12s %12s %12s %12s\\n\", \"column\", \"count\", \"missing\", \"min\", \"max\", \"mean\", \"stddev\")\r\n   216\t\tfor _, st := range stats {\r\n   217\t\t\tfmt.Printf(\"%-20s %6d %7d %12.4f %12.4f %12.4f %12.4f\\n\", st.name, st.count, st.missing, st.min, st.max, st.mean, st.stddev)\r\n   218\t\t}\r\n   219\t\r\n   220\t"]
[11324.755637, "o", "\tfmt.Println(\"\\nPearson correlation matrix:\")\r\n"]
