[13962.285053, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('format.go')\ns = p.read_text()\nold = '''\tif ver == 3 {\n\t\tvar checksum uint32\n\t\tif err := binary.Read(f, binary.LittleEndian, &checksum); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to read checksum: %v\", err)\n\t\t}\n\t\tif hasher.Sum32() != checksum {\n\t\t\treturn nil, fmt.Errorf(\"checksum mismatch\")\n\t\t}\n\t}\n\n\treturn &WeightsData{'''\nnew = '''\tif ver == 3 {\n\t\tvar checksum uint32\n\t\tif err := binary.Read(f, binary.LittleEndian, &checksum); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to read checksum: %v\", err)\n\t\t}\n\t\tif hasher.Sum32() != checksum {\n\t\t\treturn nil, fmt.Errorf(\"checksum mismatch\")\n\t\t}\n\t}\n\n\tif _, err := f.Read(make([]byte, 1)); err != io.EOF {\n\t\treturn nil, fmt.Errorf(\"extra data after weights\")\n\t}\n\n\treturn &WeightsData{'''\nif old not in s:\n    raise SystemExit('loadWeights checksum block not found')\ns = s.replace(old, new, 1)\np.write_text(s)\nPY\n"]
