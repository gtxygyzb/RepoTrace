[4703.870439, "o", "registryFile     = \"/app/models/registry.idx\"\r\nregistryJSONFile = \"/app/models/registry.json\"\r\n)\r\n\r\ntype RegistryEntry struct {\r\nName    string   `json:\"name\"`\r\nPath    string   `json:\"path\"`\r\nType    string   `json:\"type\"`\r\nVersion int      `json:\"version\"`\r\nCreated string   `json:\"created\"`\r\nTags    []string `json:\"tags\"`\r\n}\r\n\r\nfunc loadRegistry() ([]RegistryEntry, error) {\r\ndata, err := os.ReadFile(registryJSONFile)\r\nif err == nil {\r\nif len(strings.TrimSpace(string(data))) == 0 {\r\nreturn nil, nil\r\n}\r\nvar entries []RegistryEntry\r\nif err := json.Unmarshal(data, &entries); err != nil {\r\nreturn nil, fmt.Errorf(\"parse registry.json: %w\", err)\r\n}\r\nfor i := range entries {\r\nentries[i].Tags = ensureTags(entries[i].Tags)\r\n}\r\n"]
[4703.870526, "o", "return entries, nil\r\n}\r\nif !os.IsNotExist(err) {\r\nreturn nil, err\r\n}\r\n\r\nif _, err := os.Stat(registryFile); err == nil {\r\nentries, err := loadOldRegistry()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nif err := saveRegistry(entries); err != nil {\r\n"]
[4703.870588, "o", "return nil, err\r\n}\r\nreturn entries, nil\r\n}\r\n\r\nreturn nil, nil\r\n}\r\n\r\nfunc loadOldRegistry() ([]RegistryEntry, error) {\r\nf, err := os.Open(registryFile)\r\nif err != nil {\r\nif os.IsNotExist(err) {\r\nreturn nil, nil\r\n"]
