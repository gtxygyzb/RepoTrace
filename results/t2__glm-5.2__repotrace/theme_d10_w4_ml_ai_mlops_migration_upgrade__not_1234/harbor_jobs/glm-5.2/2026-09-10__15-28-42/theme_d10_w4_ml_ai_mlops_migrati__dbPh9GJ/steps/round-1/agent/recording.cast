[9661.792462, "o", "\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tFeatures      int            `json:\"\u001b[01;31m\u001b[Kfeatures\u001b[m\u001b[K\"`\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K    string         `json:\"activation\"`\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tactivation = activationIDToName(weights.\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K)\r\n"]
[9661.792525, "o", "\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif int(weights.\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K) <= 0 || int(weights.\u001b[01;31m\u001b[KNumOutputs\u001b[m\u001b[K) <= 0 {\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif len(weights.Weights) != int(weights.\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K)*int(weights.\u001b[01;31m\u001b[KNumOutputs\u001b[m\u001b[K) {\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif len(weights.Bias) != int(weights.\u001b[01;31m\u001b[KNumOutputs\u001b[m\u001b[K) {\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tweightMatrix := make([][]float64, weights.\u001b[01;31m\u001b[KNumOutputs\u001b[m\u001b[K)\r\n"]
[9661.792596, "o", "\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor o := uint32(0); o < weights.\u001b[01;31m\u001b[KNumOutputs\u001b[m\u001b[K; o++ {\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tstart := o * weights.\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tend := start + weights.\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\trow := make([]float64, weights.\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K)\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tFeatures:      int(weights.\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K),\r\n"]
[9661.79266, "o", "\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tOutputs:       int(weights.\u001b[01;31m\u001b[KNumOutputs\u001b[m\u001b[K),\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K:    activation,\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: \u001b[01;31m\u001b[Kfeatures\u001b[m\u001b[K and outputs must be positive\\n\")\r\n"]
[9661.792729, "o", "\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: weights[%d] has %d \u001b[01;31m\u001b[Kfeatures\u001b[m\u001b[K, expected %d\\n\", i, len(row), model.Features)\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tactivationName := model.\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif model.FormatVersion == 1 && model.\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K != \"none\" {\r\n"]
[9661.792787, "o", "\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K: uint32(model.Features),\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K257\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KNumOutputs\u001b[m\u001b[K:  uint32(model.Outputs),\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K:  activationID,\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\"\u001b[01;31m\u001b[Kfeatures\u001b[m\u001b[K\":       strconv.Itoa(model.Features),\r\n"]
