[6031.423962, "o", "for _, k := range keys {\r\n   213\t\t\tfmt.Fprintf(f, \"%s=%s\\n\", k, meta[k])\r\n   214\t\t}\r\n   215\t\treturn nil\r\n   216\t}\r\n   217\t\r\n   218\ttype PipelineConfig struct {\r\n   219\t\tNormalize       bool\r\n   220\t\tScaleMin        float64\r\n   221\t\tScaleMax        float64\r\n   222\t\tMissingStrategy string\r\n   223\t\tRoundDigits     int\r\n   224\t\tClipMin         float64\r\n"]
