[7561.53616, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/csv\"\r\n"]
[7561.536295, "o", "     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"math\"\r\n"]
[7561.536363, "o", "     8\t\t\"os\"\r\n     9\t\t\"strconv\"\r\n    10\t\t\"strings\"\r\n    11\t)\r\n    12\t\r\n    13\tfunc cmdRun(args []string) {\r\n    14\t\tif len(args) < 1 {\r\n    15\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe run <model> [--input <file>] [--output <file>] [--format csv|json]\\n\")\r\n    16\t\t\tos.Exit(1)\r\n    17\t\t}\r\n    18\t\r\n    19\t\tmodelName := args[0]\r\n    20\t\tflags := parseFlags(args[1:])\r\n    21\t\r\n    22\t\tinputFile := flags[\"input\"]\r\n    23\t\tif inputFile == \"\" {\r\n"]
[7561.536446, "o", "    24\t\t\tfmt.Fprintf(os.Stderr, \"error: --input is required\\n\")\r\n    25\t\t\tos.Exit(1)\r\n    26\t\t}\r\n    27\t\r\n    28\t\toutputFormat := flags[\"format\"]\r\n    29\t\tif outputFormat == \"\" {\r\n    30\t\t\toutputFormat = \"csv\"\r\n    31\t\t}\r\n    32"]
[7561.536535, "o", "\t\tif outputFormat != \"csv\" && outputFormat != \"json\" {\r\n    33\t\t\tfmt.Fprintf(os.Stderr, \"error: unsupported format '%s', use 'csv' or 'json'\\n\", outputFormat)\r\n    34\t\t\tos.Exit(1)\r\n    35\t\t}\r\n"]
[7561.5366, "o", "    36\t\r\n    37\t\tentry, err := resolveModel(modelName)\r\n    38\t\tif err != nil {\r\n    39\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    40\t\t\tos.Exit(1)\r\n    41\t\t}\r\n    42\t\r\n    43\t\tweights, err := loadWeights(entry.Path)\r\n    44\t\tif err != nil {\r\n    45\t\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n    46\t\t\tos.Exit(1)\r\n    47\t\t}\r\n    48\t\r\n"]
[7561.536662, "o", "    49\t\tpipelineCfg, err := loadPipelineConfig(entry.Path)\r\n    50\t\tif err != nil {\r\n    51\t\t\tfmt.Fprintf(os.Stderr, \"error loading pipeline config: %v\\n\", err)\r\n    52\t\t\tos.Exit(1)\r\n    53"]
[7561.536723, "o", "\t\t}\r\n    54\t\r\n    55\t\tinputs, err := readInputCSV(inputFile)\r\n    56\t\tif err != nil {\r\n    57\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    58\t\t\tos.Exit(1)\r\n    59\t\t}\r\n    60\t\r\n    61\t\tif err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {\r\n    62\t\t\tfmt.Fprintf(os.Stderr, \"error: input feature count mismatch: %v\\n\", err)\r\n    63\t\t\tos.Exit(1)\r\n    64\t\t}\r\n    65\t\r\n"]
[7561.536783, "o", "    66\t\tresults := runInference(inputs, weights, pipelineCfg)\r\n    67\t\r\n    68\t\toutputFile := flags[\"output\"]\r\n    69\t\tif outputFile != \"\" {\r\n    70\t\t\tf, err := os.Create(outputFile)\r\n    71\t\t\tif err != nil {\r\n    72\t\t\t\tfmt.Fprintf(os.Stderr, \"error creating output file: %v\\n\", err)\r\n    73\t\t\t\tos.Exit(1)\r\n    74\t\t\t}\r\n    75"]
[7561.536881, "o", "\t\t\tdefer f.Close()\r\n    76\t\t\twriteOutput(f, results, outputFormat)\r\n    77\t\t} else {\r\n    78\t\t\twriteOutput(os.Stdout, results, outputFormat)\r\n    79\t\t}\r\n    80\t}\r\n    81\t\r\n    82\tfunc readInputCSV(path string) ([][]float64, error) {\r\n    83\t\tf, err := os.Open(path)\r\n    84\t\tif err != nil {\r\n    85\t"]
[7561.536942, "o", "\t\treturn nil, err\r\n    86\t\t}\r\n    87\t\tdefer f.Close()\r\n    88\t\r\n    89\t\treader := csv.NewReader(f)\r\n    90\t\trecords, err := reader.ReadAll()\r\n    91\t\tif err != nil {\r\n    92\t\t\treturn nil, err\r\n    93\t\t}\r\n    94\t"]
[7561.537003, "o", "\r\n    95\t\tvar data [][]float64\r\n    96\t\tfor i, record := range records {\r\n    97\t\t\tif i == 0 && isHeader(record) {\r\n    98\t\t\t\tcontinue\r\n    99\t\t\t}\r\n   100\t\t\trow := make([]float64, len(record))\r\n   101\t\t\tfor j, val := range record {\r\n   102\t\t\t\tval = strings.TrimSpace(val)\r\n   103"]
[7561.537065, "o", "\t\t\t\tif val == \"\" || val == \"NA\" || val == \"nan\" {\r\n   104\t\t\t\t\trow[j] = math.NaN()\r\n   105\t\t\t\t} else {\r\n   106\t\t\t\t\trow[j], err = strconv.ParseFloat(val, 64)\r\n   107\t\t\t\t\tif err != nil {\r\n   108\t\t\t\t\t\treturn nil, fmt.Errorf(\"row %d col %d: %v\", i, j, err)\r\n   109\t\t\t\t\t}\r\n"]
[7561.537126, "o", "   110\t\t\t\t}\r\n   111\t\t\t}\r\n   112\t\t\tdata = append(data, row)\r\n   113\t\t}\r\n   114\t\treturn data, nil\r\n   115\t}\r\n   116\t\r\n   117\t"]
[7561.537186, "o", "func isHeader(record []string) bool {\r\n   118\t\tfor _, val := range record {\r\n   119\t\t\t_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)\r\n   120\t\t\tif err == nil {\r\n   121\t\t\t\treturn false\r\n   122\t\t\t}\r\n   123\t\t}\r\n   124\t\treturn true\r\n   125\t}\r\n"]
[7561.537244, "o", "   126\t\r\n   127\tfunc runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n   128\t\tprocessed := preprocess(inputs, cfg)\r\n   129\t\r\n   130\t\tresults := make([][]float64, len(processed))\r\n   131\t\tfor i, row := range processed {\r\n   132\t\t\toutput := make([]float64, weights.NumOutputs)\r\n   133\t\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n"]
[7561.537306, "o", "   134\t\t\t\tsum := weights.Bias[o]\r\n   135\t\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n   136\t\t\t\t\tif int(f) < len(row) {\r\n   137\t\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n   138\t\t\t\t\t}\r\n   139\t\t\t\t}\r\n"]
[7561.537362, "o", "   140\t\t\t\toutput[o] = applyActivation(sum, weights.Activation)\r\n   141\t\t\t}\r\n   142\t\t\tresults[i] = output\r\n   143\t\t}\r\n   144\t\r\n   145\t\treturn postprocess(results, cfg)\r\n   146\t}\r\n"]
[7561.537425, "o", "   147\t\r\n   148\tfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   149\t\tresult := make([][]float64, len(inputs))\r\n   150\t\tfor i, row := range inputs {\r\n   151\t\t\tresult[i] = make([]float64, len(row))\r\n   152\t\t\tcopy(result[i], row)\r\n   153\t\t}\r\n   154\t\r\n"]
[7561.537487, "o", "   155\t\tif len(result) == 0 {\r\n   156\t\t\treturn result\r\n   157\t\t}\r\n   158\t\r\n   159\t\tfor i, row := range result {\r\n   160\t\t\tfor j, val := range row {\r\n   161\t\t\t\tif math.IsNaN(val) {\r\n   162\t\t\t\t\tswitch cfg.MissingStrategy {"]
[7561.537544, "o", "\r\n   163\t\t\t\t\tcase \"zero\":\r\n   164\t\t\t\t\t\tresult[i][j] = 0.0\r\n   165\t\t\t\t\tcase \"mean\":\r\n   166\t\t\t\t\t\tresult[i][j] = computeColumnMean(inputs, j)\r\n   167\t\t\t\t\t}\r\n   168\t\t\t\t}\r\n   169\t\t\t}\r\n"]
[7561.5376, "o", "   170\t\t}\r\n   171\t\r\n   172\t\tif cfg.Normalize {\r\n   173\t\t\tfor j := 0; j < len(result[0]); j++ {\r\n   174\t\t\t\tminVal, maxVal := columnMinMax(result, j)\r\n   175\t\t\t\trangeVal := maxVal - minVal\r\n   176\t\t\t\tif rangeVal == 0 {\r\n"]
[7561.537654, "o", "   177\t\t\t\t\trangeVal = 1.0\r\n   178\t\t\t\t}\r\n   179\t\t\t\tfor i := range result {\r\n   180\t\t\t\t\tnormalized := (result[i][j] - minVal) / rangeVal\r\n"]
[7561.538273, "o", "\u001b[?2004h"]
