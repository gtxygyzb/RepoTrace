[9603.648599, "o", "    15\t\tregistryFile     = \"/app/models/registry.idx\"\r\n    16\t\tregistryJSONFile = \"/app/models/registry.json\"\r\n    17\t)\r\n    18\t\r\n    19\ttype RegistryEntry struct {\r\n    20\t\tName    string   `json:\"name\"`\r\n    21\t\tPath    string   `json:\"path\"`\r\n    22\t\tType    string   `json:\"type\"`\r\n    23\t\tVersion int      `json:\"version\"`\r\n    24"]
[9603.648667, "o", "\t\tCreated string   `json:\"created\"`\r\n    25\t\tTags    []string `json:\"tags\"`\r\n    26\t}\r\n    27\t\r\n    28\tfunc loadRegistry() ([]RegistryEntry, error) {\r\n    29\t\tdata, err := os.ReadFile(registryJSONFile)\r\n    30\t\tif err == nil {\r\n    31\t\t\tif len(strings.TrimSpace(string(data))) == 0 {\r\n    32\t\t\t\treturn nil, nil\r\n    33\t\t\t}\r\n"]
[9603.648727, "o", "    34\t\t\tvar entries []RegistryEntry\r\n    35\t\t\tif err := json.Unmarshal(data, &entries); err != nil {\r\n    36\t\t\t\treturn nil, fmt.Errorf(\"parse registry.json: %w\", err)\r\n    37\t\t\t}\r\n    38\t\t\tfor i := range entries {\r\n    39\t\t\t\tentries[i].Tags = ensureTags(entries[i].Tags)\r\n    40\t\t\t}\r\n    41\t\t\treturn entries, nil\r\n    42"]
[9603.648788, "o", "\t\t}\r\n    43\t\tif !os.IsNotExist(err) {\r\n    44\t\t\treturn nil, err\r\n    45\t\t}\r\n    46\t\r\n    47\t\tif _, err := os.Stat(registryFile); err == nil {\r\n    48\t\t\tentries, err := loadOldRegistry()\r\n"]
[9603.648856, "o", "    49\t\t\tif err != nil {\r\n    50\t\t\t\treturn nil, err\r\n    51\t\t\t}\r\n    52\t\t\tif err := saveRegistry(entries); err != nil {\r\n    53\t\t\t\treturn nil, err\r\n    54\t\t\t}\r\n"]
[9603.648917, "o", "    55\t\t\treturn entries, nil\r\n    56\t\t}\r\n    57\t\r\n    58\t\treturn nil, nil\r\n    59\t}\r\n    60\t\r\n    61\tfunc loadOldRegistry() ([]RegistryEntry, error) {\r\n    62\t\tf, err := os.Open(registryFile)\r\n    63\t\t"]
[9603.648973, "o", "if err != nil {\r\n    64\t\t\tif os.IsNotExist(err) {\r\n    65\t\t\t\treturn nil, nil\r\n    66\t\t\t}\r\n    67\t\t\treturn nil, err\r\n    68\t\t}\r\n    69\t\tdefer f.Close()\r\n    70\t\r\n    71\t\tvar entries []RegistryEntry\r\n    72"]
[9603.649028, "o", "\t\tscanner := bufio.NewScanner(f)\r\n    73\t\tfor scanner.Scan() {\r\n    74\t\t\tline := strings.TrimSpace(scanner.Text())\r\n    75\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    76\t\t\t\tcontinue\r\n    77\t\t\t}\r\n    78\t\t\tparts := strings.Split(line, \"|\")\r\n"]
