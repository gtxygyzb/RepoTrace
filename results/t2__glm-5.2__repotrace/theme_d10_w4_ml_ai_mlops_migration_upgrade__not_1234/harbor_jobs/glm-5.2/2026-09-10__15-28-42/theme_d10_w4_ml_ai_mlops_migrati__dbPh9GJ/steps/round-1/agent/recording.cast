[4024.521949, "o", "   116\t\tif !modelDirExists(entry.Path) {\r\n   117\t\t\tfmt.Fprintf(os.Stderr, \"error: model directory not found\\n\")\r\n   118\t\t\tos.Exit(1)\r\n   119\t\t}\r\n   120\t\r\n   121\t\tmeta, err := loadModelMeta(entry.Path)\r\n   122\t\tif err != nil {\r\n   123\t\t\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n   124\t\t\tos.Exit(1)\r\n   125\t\t}\r\n   126\t\r\n   127\t\tweights, err := loadWeights(entry.Path)\r\n   128\t\tif err != nil {\r\n   129\t\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n   130\t\t\tos.Exit(1)\r\n   131\t\t}\r\n   132\t\r\n   133\t\tfmt.Printf(\"Name:        %s\\n\", meta[\"name\"])\r\n   134\t\tfmt.Printf(\"Type:        %s\\n\", meta[\"type\"])\r\n   135\t\tfmt.Printf(\"Version:     %s\\n\", meta[\"version\"])\r\n   136\t\tfmt.Printf(\"Created:     %s\\n\", meta[\"created\"])\r\n   137\t\tfmt.Printf(\"Description: %s\\n\", meta[\"description\"])\r\n   138\t"]
[4024.522051, "o", "\tfmt.Printf(\"Features:    %s\\n\", meta[\"features\"])\r\n   139\t\tfmt.Printf(\"Outputs:     %s\\n\", meta[\"outputs\"])\r\n   140\t\tfmt.Printf(\"Format:     v%d\\n\", weights.Version)\r\n   141\t\tfmt.Printf(\"Activation: %s\\n\", activationIDToName(weights.Activation))\r\n   142\t\tfmt.Printf(\"Path:        %s\\n\", entry.Path)\r\n   143\t}\r\n   144\t\r\n   145\tfunc cmdRegister(args []string) {\r\n   146\t\tif len(args) < 2 {\r\n   147\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe register <name> <path>\\n\")\r\n   148\t\t\tos.Exit(1)\r\n   149\t\t}\r\n   150\t\tname := args[0]\r\n   151\t\tmodelPath := args[1]\r\n   152\t\r\n   153\t\tabsPath, err := filepath.Abs(modelPath)\r\n   154\t\tif err != nil {\r\n"]
