[11352.432725, "o", "   136\t\tprocessed := preprocess(inputs, cfg)\r\n   137\t\r\n   138\t\tresults := make([][]float64, len(processed))\r\n   139\t\tfor i, row := range processed {\r\n   140\t\t\toutput := make([]float64, weights.NumOutputs)\r\n   141\t\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n   142\t\t\t\tsum := weights.Bias[o]\r\n   143\t\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n   144\t\t\t\t\tif int(f) < len(row) {\r\n   145\t\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n"]
