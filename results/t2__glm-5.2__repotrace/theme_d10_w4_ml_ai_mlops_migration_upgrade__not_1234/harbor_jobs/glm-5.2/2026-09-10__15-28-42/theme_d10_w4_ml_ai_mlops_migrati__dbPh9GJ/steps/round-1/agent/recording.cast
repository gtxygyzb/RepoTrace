[1858.816449, "o", "\t\tfor _, val := range record {\r\n   119\t\t\t_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)\r\n   120\t\t\tif err == nil {\r\n   121\t\t\t\treturn false\r\n   122\t\t\t}\r\n   123\t\t}\r\n   124\t\treturn true\r\n"]
[1858.816508, "o", "   125\t}\r\n   126\t\r\n   127\tfunc runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n   128\t\tprocessed := preprocess(inputs, cfg)\r\n   129\t\r\n   130\t\tresults := make([][]float64, len(processed))\r\n   131\t\tfor i, row := range processed {\r\n   132\t\t\toutput := make([]float64, weights.NumOutputs)\r\n"]
[1858.816587, "o", "   133\t\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n   134\t\t\t\tsum := weights.Bias[o]\r\n   135\t\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n   136\t\t\t\t\tif int(f) < len(row) {\r\n   137\t\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n   138\t\t\t\t\t}\r\n   139\t\t\t\t}\r\n   140\t\t\t\toutput[o] = sum\r\n   141\t\t\t}\r\n   142\t\t"]
[1858.816646, "o", "\tresults[i] = output\r\n   143\t\t}\r\n   144\t\r\n   145\t\treturn postprocess(results, cfg)\r\n   146\t}\r\n   147\t\r\n   148\tfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   149\t\tresult := make([][]float64, len(inputs))\r\n"]
[1858.816705, "o", "   150\t\tfor i, row := range inputs {\r\n   151\t\t\tresult[i] = make([]float64, len(row))\r\n   152\t\t\tcopy(result[i], row)\r\n   153\t\t}\r\n   154\t\r\n   155\t\tif len(result) == 0 {\r\n   156\t\t\treturn result\r\n   157\t\t}\r\n   158\t\r\n   159\t"]
[1858.816767, "o", "\tfor i, row := range result {\r\n   160\t\t\tfor j, val := range row {\r\n   161\t\t\t\tif math.IsNaN(val) {\r\n   162\t\t\t\t\tswitch cfg.MissingStrategy {\r\n   163\t\t"]
[1858.816842, "o", "\t\t\tcase \"zero\":\r\n   164\t\t\t\t\t\tresult[i][j] = 0.0\r\n   165\t\t\t\t\tcase \"mean\":\r\n   166\t\t\t\t\t\tresult[i][j] = computeColumnMean(inputs, j)\r\n   167\t\t\t\t\t}\r\n   168\t\t\t\t}\r\n   169\t\t\t}\r\n   170\t\t}\r\n   171\t\r\n   172\t\tif cfg.Normalize {\r\n"]
[1858.8169, "o", "   173\t\t\tfor j := 0; j < len(result[0]); j++ {\r\n   174\t\t\t\tminVal, maxVal := columnMinMax(result, j)\r\n   175\t\t\t\trangeVal := maxVal - minVal\r\n   176\t\t\t\tif rangeVal == 0 {\r\n   177\t\t\t\t\trangeVal = 1.0\r\n   178\t\t\t\t}\r\n   179\t\t\t\tfor i := range result {\r\n   180\t\t\t\t\tnormalized := (result[i][j] - minVal) / rangeVal\r\n"]
[1858.816957, "o", "   181\t\t\t\t\tresult[i][j] = cfg.ScaleMin + normalized*(cfg.ScaleMax-cfg.ScaleMin)\r\n   182\t\t\t\t}\r\n   183\t\t\t}\r\n   184\t\t}\r\n   185\t\r\n   186\t\treturn result\r\n   187\t}\r\n   188\t\r\n   189\tfunc postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   190\t\tfor i, row := range results {\r\n   191\t"]
[1858.816999, "o", "\t\tfor j, val := range row {\r\n   192\t\t\t\tval = math.Max(val, cfg.ClipMin)\r\n   193\t\t\t\tval = math.Min(val, cfg.ClipMax)\r\n   194\t\t\t\tresults[i][j] = roundToDigits(val, cfg.RoundDigits)\r\n   195\t\t\t}\r\n   196"]
[1858.817079, "o", "\t\t}\r\n   197\t\treturn results\r\n   198\t}\r\n   199\t\r\n   200\tfunc computeColumnMean(data [][]float64, col int) float64 {\r\n   201\t\tsum := 0.0\r\n   202\t\tcount := 0\r\n   203\t\tfor _, row := range data {\r\n   204\t\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n   205\t\t\t\tsum += row[col]\r\n   206\t\t\t\tcount++\r\n   207\t\t\t}\r\n"]
[1858.817141, "o", "   208\t\t}\r\n   209\t\tif count == 0 {\r\n   210\t\t\treturn 0.0\r\n   211\t\t}\r\n   212\t\treturn sum / float64(count)\r\n   213\t}\r\n   214\t\r\n   215\tfunc columnMinMax(data [][]float64, col int) (float64, float64) {\r\n   216\t\tminVal := math.Inf(1)\r\n   217\t"]
[1858.817198, "o", "\tmaxVal := math.Inf(-1)\r\n   218\t\tfor _, row := range data {\r\n   219\t\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n   220\t\t\t\tif row[col] < minVal {\r\n   221\t\t\t\t\tminVal = row[col]\r\n   222\t\t\t\t}\r\n   223\t\t\t\tif row[col] > maxVal {\r\n   224\t\t\t\t\tmaxVal = row[col]\r\n   225\t\t\t\t}\r\n"]
[1858.817254, "o", "   226\t\t\t}\r\n   227\t\t}\r\n   228\t\treturn minVal, maxVal\r\n   229\t}\r\n   230\t\r\n   231\tfunc writeOutput(f *os.File, results [][]float64, format string) {\r\n   232\t\tswitch format {\r\n   233\t\tcase \"csv\":\r\n   234\t\t\twriter := csv.NewWriter(f)\r\n   235\t\t\t"]
[1858.81731, "o", "header := make([]string, len(results[0]))\r\n   236\t\t\tfor i := range header {\r\n   237\t\t\t\theader[i] = fmt.Sprintf(\"output_%d\", i)\r\n   238\t\t\t}\r\n   239\t\t\twriter.Write(header)\r\n   240\t\t\tfor _, row := range results {\r\n   241\t\t\t\trecord := make([]string, len(row))\r\n   242\t\t\t\tfor j, val := range row {\r\n"]
[1858.817365, "o", "   243\t\t\t\t\trecord[j] = strconv.FormatFloat(val, 'f', -1, 64)\r\n   244\t\t\t\t}\r\n   245\t\t\t\twriter.Write(record)\r\n   246\t\t\t}\r\n   247\t\t\twriter.Flush()\r\n   248\t\tcase \"json\":\r\n   249\t\t\ttype Prediction struct {\r\n   250\t\t\t\tOutputs []float64 `json:\"outputs\"`\r\n"]
[1858.817427, "o", "   251\t\t\t}\r\n   252\t\t\ttype Result struct {\r\n   253\t\t\t\tPredictions []Prediction `json:\"predictions\"`\r\n   254\t\t\t}\r\n   255\t\t\tr := Result{}\r\n   256\t\t\tfor _, row := range results {\r\n   257\t\t\t\tr.Predictions = append(r.Predictions, Prediction{Outputs: row})\r\n   258\t\t\t}\r\n"]
[1858.817482, "o", "   259\t\t\tenc := json.NewEncoder(f)\r\n   260\t\t\tenc.SetIndent(\"\", \"  \")\r\n   261\t\t\tenc.Encode(r)\r\n   262\t\t}\r\n   263\t}\r\n"]
