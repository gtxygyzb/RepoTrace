[11541.274596, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\nce = Path('commands_extra.go')\ns = ce.read_text()\n\ns = s.replace('\"strings\"\\n)', '\"strings\"\\n\\t\"time\"\\n)', 1)\n\nnew_funcs = r'''\nfunc cmdBenchmark(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe benchmark <model> --input <file> [--runs <N>]\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tmodel := args[0]\n\tflags := parseFlags(args[1:])\n\n\tinput := flags[\"input\"]\n\tif input == \"\" || input == \"true\" {\n\t\tfmt.Fprintf(os.Stderr, \"error: --input is required\\n\")\n\t\tos.Exit(1)\n\t}\n\n\truns := 10\n\tif r, ok := flags[\"runs\"]; ok && r != \"true\" {\n\t\tn, err := strconv.Atoi(r)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid --runs value\\n\")\n\t\t\tos.Exit(1)\n\t\t}\n\t\tif n < 1 {\n\t\t\tfmt.Fprintf(os.Stderr, \"error: runs must be positive\\n\")\n\t\t\tos.Exit(1)\n\t\t}\n\t\truns = n\n\t}\n\n\tentry, err := resolveModel(model)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"not found\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tif _, err := os.Stat(input); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"file not found\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tw"]
[11541.274928, "i", "eights, cfg, err := loadModelArtifacts(entry.Path)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error loading model: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tinputs, err := readInputCSV(input)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\trows := len(inputs)\n\n\tstart := time.Now()\n\tfor i := 0; i < runs; i++ {\n\t\t_ = runInference(inputs, weights, cfg)\n\t}\n\telapsed := time.Since(start)\n\n\ttotalMs := float64(elapsed.Nanoseconds()) / 1e6\n\tavgRunMs := 0.0\n\tavgRowUs := 0.0\n\tthroughput := 0.0\n\tif runs > 0 {\n\t\tavgRunMs = totalMs / float64(runs)\n\t\tif rows > 0 {\n\t\t\tavgRowUs = avgRunMs * 1000.0 / float64(rows)\n\t\t}\n\t\tif elapsed > 0 {\n\t\t\tthroughput = float64(rows*runs) / elapsed.Seconds()\n\t\t}\n\t}\n\n\tfmt.Printf(\"Benchmark: %s (%d runs, %d rows per run)\\n\", model, runs, rows)\n\tfmt.Printf(\"Total time:    %.3fms\\n\", totalMs)\n\tfmt.Printf(\"Avg per run:   %.3fms\\n\", avgRunMs)\n\tfmt.Printf(\"Avg per row:   %.3fus\\n\", avgRowUs)\n\tfmt.Printf(\"Throughput:    %.3f rows/sec\\n\", throughput)\n}\n\nfunc cmdPrune(ar"]
