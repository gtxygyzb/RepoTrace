[276.45429, "o", "_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)\r\n   121\t\t\tif err == nil {\r\n   122\t\t\t\treturn false\r\n   123\t\t\t}\r\n   124\t\t}\r\n   125\t\treturn true\r\n   126\t}\r\n   127\t\r\n   128\tfunc runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n   129\t\tprocessed := preprocess(inputs, cfg)\r\n"]
[276.454348, "o", "   130\t\r\n   131\t\tresults := make([][]float64, len(processed))\r\n   132\t\tfor i, row := range processed {\r\n   133\t\t\toutput := make([]float64, weights.NumOutputs)\r\n   134\t\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n   135\t\t\t\tsum := weights.Bias[o]\r\n   136\t\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n   137\t\t\t\t\tif int(f) < len(row) {\r\n"]
[276.454409, "o", "   138\t\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n   139\t\t\t\t\t}\r\n   140\t\t\t\t}\r\n   141\t\t\t\toutput[o] = sum\r\n   142\t\t\t}\r\n   143\t\t\tresults[i] = output\r\n   144\t\t}\r\n"]
