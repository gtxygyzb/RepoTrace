[9125.799631, "i", "fg.Strategy)''',\n'''combined := combineEnsembleOutputs(allOutputs, cfg.Strategy, cfg.Weights)'''\n)\n\ns = s.replace(\n'''func combineEnsembleOutputs(allOutputs [][][]float64, strategy string) [][]float64 {''',\n'''func combineEnsembleOutputs(allOutputs [][][]float64, strategy string, weights []float64) [][]float64 {'''\n)\n\ns = s.replace(\n'''default:\ncombined[i][j] = meanFloat64(vals)''',\n'''default:\ncombined[i][j] = weightedMeanFloat64(vals, weights)'''\n)\n\ns = s.replace(\n'''func meanFloat64(vals []float64) float64 {''',\n'''func weightedMeanFloat64(vals []float64, weights []float64) float64 {\nif len(vals) == 0 {\nreturn 0\n}\nsum := 0.0\nweightSum := 0.0\nfor i, v := range vals {\nw := 1.0\nif i < len(weights) {\nw = weights[i]\n}\nsum += w * v\nweightSum += w\n}\nif weightSum == 0 {\nreturn meanFloat64(vals)\n}\nreturn sum / weightSum\n}\n\nfunc meanFloat64(vals []float64) float64 {'''\n)\n\np.write_text(s)\nPY\n"]
