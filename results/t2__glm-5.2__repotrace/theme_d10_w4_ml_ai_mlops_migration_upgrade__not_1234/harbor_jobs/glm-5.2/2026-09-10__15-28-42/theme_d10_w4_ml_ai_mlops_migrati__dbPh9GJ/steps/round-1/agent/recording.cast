[14105.34631, "o", "     5\t\t\"os\"\r\n     6\t\t\"path/filepath\"\r\n     7\t)\r\n     8\t\r\n     9\tfunc cmdUpgrade(args []string) {\r\n    10\t\tif len(args) < 1 {\r\n    11\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe upgrade <model>\\n\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n"]
[14105.346367, "o", "    14\t\tname := args[0]\r\n    15\t\tentry, err := resolveModel(name)\r\n    16\t\tif err != nil {\r\n    17\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    18\t\t\tos.Exit(1)\r\n    19\t\t}\r\n    20\t\r\n    21\t"]
[14105.346426, "o", "\tweightsPath := filepath.Join(entry.Path, \"weights.bin\")\r\n    22\t\r\n    23\t\tweights, err := loadWeights(entry.Path)\r\n    24\t\tif err != nil {\r\n    25\t\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n    26\t\t\tos.Exit(1)\r\n    27\t\t}\r\n    28\t\r\n    29\t"]
[14105.346487, "o", "\tif weights.Version >= 3 {\r\n    30\t\t\tfmt.Println(\"already at latest version\")\r\n    31\t\t\treturn\r\n    32\t\t}\r\n    33\t\r\n    34\t\tbackupPath := weightsPath + \".v2bak\"\r\n    35\t\tif weights.Version == 1 {\r\n    36\t\t\tbackupPath = weightsPath + \".v1bak\"\r\n    37"]
[14105.346547, "o", "\t\t}\r\n    38\t\r\n    39\t\tdata, err := os.ReadFile(weightsPath)\r\n    40\t\tif err != nil {\r\n    41\t\t\tfmt.Fprintf(os.Stderr, \"error reading weights: %v\\n\", err)\r\n    42\t\t\tos.Exit(1)\r\n    43\t\t}\r\n    44"]
[14105.346603, "o", "\t\tif err := os.WriteFile(backupPath, data, 0644); err != nil {\r\n    45\t\t\tfmt.Fprintf(os.Stderr, \"error writing backup: %v\\n\", err)\r\n    46\t\t\tos.Exit(1)\r\n    47\t\t}\r\n    48\t\r\n    49\t\tif weights.Version == 1 {\r\n    50\t\t\tweights.Activation = activationNone\r\n"]
[14105.346666, "o", "    51\t\t}\r\n    52\t\tweights.Version = 3\r\n    53\t\r\n    54\t\tif err := writeWeights(weightsPath, weights); err != nil {\r\n"]
[14105.346704, "o", "    55\t\t\tfmt.Fprintf(os.Stderr, \"error writing weights: %v\\n\", err)\r\n    56\t\t\tos.Exit(1)\r\n    57\t\t}\r\n    58\t\r\n    59\t\tmeta, err := loadModelMeta(entry.Path)\r\n    60\t\tif err != nil {\r\n    61\t\t\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n    62\t\t\tos.Exit(1)\r\n    63\t\t}\r\n"]
[14105.346789, "o", "    64\t\tmeta[\"format_version\"] = \"3\"\r\n    65\t\tmeta[\"activation\"] = activationIDToName(weights.Activation)\r\n    66\t\tif err := saveModelMeta(entry.Path, meta); err != nil {\r\n    67\t\t\tfmt.Fprintf(os.Stderr, \"error updating metadata: %v\\n\", err)\r\n    68\t\t\tos.Exit(1)\r\n    69\t\t}\r\n    70\t\r\n    71\t\tfmt.Printf(\"model '%s' upgraded to format v3\\n\", name)\r\n    72\t}\r\n    73\t\r\n    74\tfunc cmdVerify(args []string) {\r\n    75\t\tif len(args) < 1 {\r\n"]
[14105.346829, "o", "    76\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe verify <model>\\n\")\r\n    77\t\t\tos.Exit(1)\r\n    78\t\t}\r\n    79\t\tname := args[0]\r\n    80\t\tentry, err := resolveModel(name)\r\n    81\t\tif err != nil {"]
[14105.34691, "o", "\r\n    82\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    83\t\t\tos.Exit(1)\r\n    84\t\t}\r\n    85\t\r\n    86\t\tif _, err := loadWeights(entry.Path); err != nil {\r\n    87\t\t\tfmt.Printf(\"model '%s' integrity: FAILED (%v)\\n\", name, err)\r\n    88\t\t\tos.Exit(1)\r\n    89\t\t}\r\n"]
[14105.346965, "o", "    90\t\tfmt.Printf(\"model '%s' integrity: OK\\n\", name)\r\n    91\t}\r\n"]
