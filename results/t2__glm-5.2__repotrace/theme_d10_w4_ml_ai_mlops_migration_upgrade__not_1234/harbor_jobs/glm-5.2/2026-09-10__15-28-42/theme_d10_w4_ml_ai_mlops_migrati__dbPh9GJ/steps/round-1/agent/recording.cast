[12079.559445, "o", "\r\n   125\tfunc isHeader(record []string) bool {\r\n   126\t\tfor _, val := range record {\r\n   127\t\t\t_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)\r\n   128\t\t\tif err == nil {\r\n   129\t\t\t\treturn false\r\n   130\t\t\t}\r\n   131\t\t}\r\n   132\t\treturn true\r\n   133\t}\r\n   134\t\r\n   135\tfunc runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n   136\t\tprocessed := preprocess(inputs, cfg)\r\n   137\t\r\n"]
[12079.559509, "o", "   138\t\tresults := make([][]float64, len(processed))\r\n   139\t\tfor i, row := range processed {\r\n   140\t\t\toutput := make([]float64, weights.NumOutputs)\r\n   141\t\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n   142\t\t\t\tsum := weights.Bias[o]\r\n   143\t\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n   144\t\t\t\t\tif int(f) < len(row) {\r\n"]
[12079.559569, "o", "   145\t\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n   146\t\t\t\t\t}\r\n   147\t\t\t\t}\r\n   148\t\t\t\toutput[o] = applyActivation(sum, weights.Activation)\r\n   149\t\t\t}\r\n   150\t\t\tresults[i] = output\r\n   151\t\t}\r\n   152\t\r\n"]
[12079.559632, "o", "   153\t\treturn postprocess(results, cfg)\r\n   154\t}\r\n   155\t\r\n   156\tfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   157\t\tresult := make([][]float64, len(inputs))\r\n   158\t\tfor i, row := range inputs {\r\n   159\t\t\tresult[i] = make([]float64, len(row))\r\n   160\t\t\tcopy(result[i], row)\r\n   161\t\t}\r\n"]
[12079.55969, "o", "   162\t\r\n   163\t\tif len(result) == 0 {\r\n   164\t\t\treturn result\r\n   165\t\t}\r\n   166\t\r\n   167\t\tfor i, row := range result {\r\n   168\t\t\tfor j, val := range row {\r\n   169\t\t\t\tif math.IsNaN(val) {\r\n"]
[12079.559753, "o", "   170\t\t\t\t\tswitch cfg.MissingStrategy {\r\n   171\t\t\t\t\tcase \"zero\":\r\n   172\t\t\t\t\t\tresult[i][j] = 0.0\r\n   173\t\t\t\t\tcase \"mean\":\r\n   174\t\t\t\t\t\tresult[i][j] = computeColumnMean(inputs, j)\r\n   175\t\t\t\t\t}\r\n   176\t\t\t\t}\r\n   177\t\t\t}\r\n"]
[12079.559842, "o", "   178\t\t}\r\n   179\t\r\n   180\t\tif cfg.Normalize {\r\n   181\t\t\tfor j := 0; j < len(result[0]); j++ {\r\n   182\t\t\t\tminVal, maxVal := columnMinMax(result, j)\r\n   183\t\t\t\trangeVal := maxVal - minVal\r\n   184\t\t\t\tif rangeVal == 0 {\r\n   185\t\t\t\t\trangeVal = 1.0\r\n   186\t\t\t\t}\r\n   187\t\t\t\tfor i := range result {\r\n   188\t\t\t\t\tnormalized := (result[i][j] - minVal) / rangeVal\r\n"]
[12079.559907, "o", "   189\t\t\t\t\tresult[i][j] = cfg.ScaleMin + normalized*(cfg.ScaleMax-cfg.ScaleMin)\r\n   190\t\t\t\t}\r\n   191\t\t\t}\r\n   192\t\t}\r\n   193\t\r\n   194\t\treturn result\r\n   195\t}\r\n   196\t\r\n   197\tfunc postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   198\t"]
[12079.559966, "o", "\tfor i, row := range results {\r\n   199\t\t\tfor j, val := range row {\r\n   200\t\t\t\tval = math.Max(val, cfg.ClipMin)\r\n   201\t\t\t\tval = math.Min(val, cfg.ClipMax)\r\n   202\t\t\t\tresults[i][j] = roundToDigits(val, cfg.RoundDigits)\r\n   203\t\t\t}\r\n   204\t\t}\r\n   205\t\treturn results\r\n   206\t}"]
[12079.560027, "o", "\r\n   207\t\r\n   208\tfunc computeColumnMean(data [][]float64, col int) float64 {\r\n   209\t\tsum := 0.0\r\n   210\t\tcount := 0\r\n   211\t\tfor _, row := range data {\r\n   212\t\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n   213\t\t\t\tsum += row[col]\r\n   214\t\t\t\tcount++\r\n"]
[12079.560089, "o", "   215\t\t\t}\r\n   216\t\t}\r\n   217\t\tif count == 0 {\r\n   218\t\t\treturn 0.0\r\n   219\t\t}\r\n   220\t\treturn sum / float64(count)\r\n   221\t}\r\n   222\t\r\n   223\tfunc columnMinMax(data [][]float64, col int) (float64, float64) {\r\n   224\t\tminVal := math.Inf(1)"]
[12079.560164, "o", "\r\n   225\t\tmaxVal := math.Inf(-1)\r\n   226\t\tfor _, row := range data {\r\n   227\t\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n   228\t\t\t\tif row[col] < minVal {\r\n   229\t\t\t\t\tminVal = row[col]\r\n   230\t\t\t\t}\r\n"]
