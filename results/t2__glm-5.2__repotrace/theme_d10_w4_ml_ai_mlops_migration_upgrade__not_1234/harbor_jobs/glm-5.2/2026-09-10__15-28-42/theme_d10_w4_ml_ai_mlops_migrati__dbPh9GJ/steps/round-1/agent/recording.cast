[8953.920836, "o", "package main\r\n\r\nimport (\r\n\"encoding/json\"\r\n\"fmt\"\r\n\"os\"\r\n\"path/filepath\"\r\n"]
[8953.920891, "o", "\"sort\"\r\n\"strings\"\r\n)\r\n\r\nconst ensemblesDir = \"/app/models/ensembles\"\r\n\r\ntype ensembleConfig struct {\r\nName     string   `json:\"name\"`\r\nModels   []string `json:\"models\"`\r\nStrategy string   `json:\"strategy\"`\r\n}\r\n\r\nfunc cmdEnsemble(args []string) {\r\n"]
[8953.921075, "o", "if len(args) < 1 {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble <create|list|run|remove> [arguments]\\n\")\r\nos.Exit(1)\r\n}\r\n\r\nsub := args[0]\r\nrest := args[1:]\r\nswitch sub {\r\ncase \"create\":\r\ncmdEnsembleCreate(rest)\r\ncase \"list\":\r\ncmdEnsembleList(rest)\r\ncase \"run\":\r\ncmdEnsembleRun(rest)\r\ncase \"remove\":\r\ncmdEnsembleRemove(rest)\r\ndefault:\r\nfmt.Fprintf(os.Stderr, \"unknown ensemble command: %s\\n\", sub)\r\nos.Exit(1)\r\n}\r\n}\r\n\r\nfunc cmdEnsembleCreate(args []string) {\r\nflags := parseFlags(args)\r\n\r\nif len(args) < 1 || strings.HasPrefix(args[0], \"--\") {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]\\n\")\r\nos.Exit(1)\r\n}\r\nname := args[0]\r\n\r\nmodelsStr := flags[\"models\"]\r\nif modelsStr == \"\" || modelsStr == \"true\" {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]\\n\")\r\nos.Exit(1)\r\n}\r\n\r\nstrategy := flags[\"strategy\"]\r\n"]
[8953.921192, "o", "if strategy == \"\" || strategy == \"true\" {\r\nstrategy = \"average\"\r\n}\r\nif strategy != \"average\" && strategy != \"max\" && strategy != \"min\" {\r\nfmt.Fprintf(os.Stderr, \"error: invalid strategy '%s', use average, max, or min\\n\", strategy)\r\nos.Exit(1)\r\n}\r\n\r\nvar models []string"]
[8953.921347, "o", "\r\nfor _, m := range strings.Split(modelsStr, \",\") {\r\nm = strings.TrimSpace(m)\r\nif m != \"\" {\r\nmodels = append(models, m)\r\n}\r\n}\r\nif len(models) == 0 {\r\nfmt.Fprintf(os.Stderr, \"error: at least one model is required\\n\")\r\nos.Exit(1)\r\n}\r\n\r\nentries, err := loadRegistry()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\nfor _, m := range models {\r\nif findEntry(entries, m) == nil {\r\nfmt.Printf(\"model not found: %s\\n\", m)\r\nos.Exit(1)\r\n}\r\n}\r\n"]
[8953.921422, "o", "\r\nvar outputDim int\r\nfor i, m := range models {\r\nentry := findEntry(entries, m)\r\nweights, err := loadWeights(entry.Path)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error loading weights for model '%s': %v\\n\", m, err)\r\nos.Exit(1)\r\n}\r\nif i == 0 {\r\noutputDim = int(weights.NumOutputs)\r\n} else if int(weights.NumOutputs) != outputDim {\r\nfmt.Println(\"output dimension mismatch\")\r\nos.Exit(1)\r\n}\r\n}\r\n\r\npath := filepath.Join(ensemblesDir, name+\".json\")\r\nif _, err := os.Stat(path); err == nil {\r\nfmt.Println(\"ensemble already exists\")\r\nos.Exit(1)\r\n}\r\n\r\ncfg := ensembleConfig{\r\nName:     name,\r\nModels:   models,\r\nStrategy: strategy,\r\n}\r\nif err := saveEnsembleConfig(&cfg); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\nfmt.Printf(\"ensemble '%s' created with %d models (strategy=%s)\\n\", name, len(models), strategy)\r\n}\r\n\r\nfunc cmdEnsembleList(args []string) {\r\nconfigs, err := listEnsembleConfigs()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n"]
[8953.921577, "o", "}\r\nif len(configs) == 0 {\r\nfmt.Println(\"no ensembles\")\r\nreturn\r\n}\r\nsort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })\r\nfor _, cfg := range configs {\r\nfmt.Printf(\"%s  %s  %d models\\n\", cfg.Name, cfg.Strategy, len(cfg.Models))\r\n}\r\n}\r\n\r\nfunc cmdEnsembleRun(args []string) {\r\nif len(args) < 1 {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble run <name> --input <file> [--format csv|json]\\n\")\r\nos.Exit(1)\r\n}\r\nname := args[0]\r\nflags := parseFlags(args[1:])\r\n\r\ninputFile := flags[\"input\"]\r\nif inputFile == \"\" || inputFile == \"true\" {\r\nfmt.Fprintf(os.Stderr, \"error: --input is required\\n\")\r\nos.Exit(1)\r\n}\r\n\r\noutputFormat := flags[\"format\"]\r\nif outputFormat == \"\" || outputFormat == \"true\" {\r\noutputFormat = \"csv\"\r\n}\r\nif outputFormat != \"csv\" && outputFormat != \"json\" {\r\nfmt.Fprintf(os.Stderr, \"error: unsupported format '%s', use 'csv' or 'json'\\n\", outputFormat)\r\nos.Exit(1)\r\n}\r\n"]
[8953.921704, "o", "\r\ncfg, err := loadEnsembleConfig(name)\r\nif err != nil {\r\nfmt.Println(\"ensemble not found\")\r\nos.Exit(1)\r\n}\r\n\r\ninputs, err := readInputCSV(inputFile)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\nentries, err := loadRegistry()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\nvar allOutputs [][][]float64\r\nvar featureCount int\r\nfor i, modelName := range cfg.Models {\r\nentry := findEntry(entries, modelName)\r\nif entry == nil {\r\nfmt.Printf(\"model not found: %s\\n\", modelName)\r\nos.Exit(1)\r\n}\r\n\r\n"]
[8953.921843, "o", "weights, err := loadWeights(entry.Path)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error loading weights for model '%s': %v\\n\", modelName, err)\r\nos.Exit(1)\r\n}\r\n\r\nif i == 0 {\r\nfeatureCount = int(weights.NumFeatures)\r\n} else if int(weights.NumFeatures) != featureCount {\r\nfmt.Println(\"feature mismatch\")\r\nos.Exit(1)\r\n}\r\n\r\nif err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {\r\nfmt.Println(\"feature mismatch\")\r\nos.Exit(1)\r\n}\r\n\r\npipelineCfg, err := loadPipelineConfig(entry.Path)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error loading pipeline config for model '%s': %v\\n\", modelName, err)\r\nos.Exit(1)\r\n}\r\n\r\nresults := runInference(inputs, weights, pipelineCfg)\r\nallOutputs = append(allOutputs, results)\r\n}\r\n\r\nif len(allOutputs) == 0 {\r\n"]
[8953.922039, "o", "fmt.Fprintf(os.Stderr, \"error: ensemble '%s' has no models\\n\", name)\r\nos.Exit(1)\r\n}\r\n\r\ncombined := combineEnsembleOutputs(allOutputs, cfg.Strategy)\r\n\r\noutputFile := flags[\"output\"]\r\n"]
[8953.922141, "o", "if outputFile != \"\" && outputFile != \"true\" {\r\nf, err := os.Create(outputFile)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error creating output file: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\ndefer f.Close()\r\nwriteOutput(f, combined, outputFormat)\r\n} else {\r\nwriteOutput(os.Stdout, combined, outputFormat)\r\n}\r\n}\r\n\r\nfunc cmdEnsembleRemove(args []string) {\r\nif len(args) < 1 {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble remove <name>\\n\")\r\nos.Exit(1)\r\n}\r\nname := args[0]\r\n\r\npath := filepath.Join(ensemblesDir, name+\".json\")\r\nif _, err := os.Stat(path); err != nil {\r\nfmt.Println(\"ensemble not found\")\r\nos.Exit(1)\r\n}\r\nif err := os.Remove(path); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\nfmt.Printf(\"ensemble '%s' removed\\n\", name)\r\n}\r\n\r\n"]
