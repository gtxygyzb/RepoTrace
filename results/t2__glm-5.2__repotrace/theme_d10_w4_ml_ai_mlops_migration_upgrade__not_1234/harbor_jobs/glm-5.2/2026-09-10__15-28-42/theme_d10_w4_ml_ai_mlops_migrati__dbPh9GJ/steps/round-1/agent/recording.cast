[11387.022927, "o", "\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmdCheckpoint\u001b[m\u001b[K(args []string) {\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(args) < 1 {\r\n\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe checkpoint <model> [--name <name>]\\n\")\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tos.Exit(1)\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmodel := args[0]\r\n"]
[11387.023035, "o", "\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tflags := parseFlags(args[1:])\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tname := flags[\"name\"]\r\n\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif name == \"\" {\r\n\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tname = \"cp-\" + time.Now().Format(\"20060102-150405\")\r\n\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tentry, err := resolveModel(model)\r\n\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"not found\\n\")\r\n\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tos.Exit(1)\r\n\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcpDir := filepath.Join(checkpointsDir(entry.Path), name)\r\n\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif _, err := os.Stat(cpDir); err == nil {\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"checkpoint already exists\\n\")\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tos.Exit(1)\r\n"]
[11387.023107, "o", "\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := os.MkdirAll(cpDir, 0755); err != nil {\r\n\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tos.Exit(1)\r\n\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, file := range []string{\"weights.bin\", \"model.meta\", \"pipeline.cfg\"} {\r\n\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsrc := filepath.Join(entry.Path, file)\r\n\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tdata, err := os.ReadFile(src)\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err != nil {\r\n"]
[11387.023205, "o", "\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tos.Exit(1)\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err := os.WriteFile(filepath.Join(cpDir, file), data, 0644); err != nil {\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[11387.023273, "o", "\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tos.Exit(1)\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Printf(\"checkpoint '%s' created for '%s'\\n\", name, model)\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmdCheckpoint\u001b[m\u001b[Ks(args []string) {\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(args) < 1 {\r\n\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe checkpoints <model>\\n\")\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tos.Exit(1)\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[11387.023338, "o", "\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmodel := args[0]\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tentry, err := resolveModel(model)\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"not found\\n\")\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tos.Exit(1)\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tentries, err := os.ReadDir(checkpointsDir(entry.Path))\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil || len(entries) == 0 {\r\n\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Println(\"no checkpoints\")\r\n\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n"]
[11387.023399, "o", "\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ttype checkpointInfo struct {\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tname string\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tmod  time.Time\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[11387.023504, "o", "\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar cps []checkpointInfo\r\n\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, entry := range entries {\r\n\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif !entry.IsDir() {\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tcontinue\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tinfo, err := entry.Info()\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err != nil {\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tcontinue\r\n\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcps = append(cps, checkpointInfo{name: entry.Name(), mod: info.ModTime()})\r\n\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(cps) == 0 {\r\n\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[11387.023647, "o", "\t\tfmt.Println(\"no checkpoints\")\r\n\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tsort.Slice(cps, func(i, j int) bool {\r\n\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn cps[i].mod.Before(cps[j].mod)\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t})\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, cp := range cps {\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Printf(\"%s  %s\\n\", cp.name, cp.mod.Format(\"2006-01-02 15:04:05\"))\r\n"]
