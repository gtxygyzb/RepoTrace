[11325.56949, "o", "    53\t\r\n    54\t\tif err := os.MkdirAll(cpDir, 0755); err != nil {\r\n    55\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    56\t\t\tos.Exit(1)\r\n    57\t\t}\r\n    58\t\r\n    59\t\tfor _, file := range []string{\"weights.bin\", \"model.meta\", \"pipeline.cfg\"} {\r\n    60\t\t\tsrc := filepath.Join(entry.Path, file)\r\n    61\t\t\tdata, err := os.ReadFile(src)\r\n    62\t\t\tif err != nil {\r\n"]
