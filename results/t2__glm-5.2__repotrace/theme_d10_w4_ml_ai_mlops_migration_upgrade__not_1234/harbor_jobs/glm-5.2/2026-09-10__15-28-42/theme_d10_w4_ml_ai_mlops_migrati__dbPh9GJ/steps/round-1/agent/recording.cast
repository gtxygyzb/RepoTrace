[5264.359164, "o", "func resolveModel(name string) (*RegistryEntry, error) {\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {"]
