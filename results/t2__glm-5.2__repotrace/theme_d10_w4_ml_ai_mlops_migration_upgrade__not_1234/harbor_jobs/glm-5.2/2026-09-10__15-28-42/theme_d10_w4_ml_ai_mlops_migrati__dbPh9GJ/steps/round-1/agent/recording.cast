[9633.885881, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/binary\"\r\n     6\t\t\"fmt\"\r\n"]
[9633.885962, "o", "     7\t\t\"math\"\r\n     8\t\t\"os\"\r\n     9\t\t\"path/filepath\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t)\r\n    14\t\r\n    15\tvar modelMagic = []byte(\"MLPW\")\r\n    16\t\r\n    17\tfunc loadModelMeta(modelDir string) (map[string]string, error) {\r\n    18\t\tf, err := os.Open(filepath.Join(modelDir, \"model.meta\"))\r\n"]
[9633.886029, "o", "    19\t\tif err != nil {\r\n    20\t\t\treturn nil, err\r\n    21\t\t}\r\n    22\t\tdefer f.Close()\r\n    23\t\r\n    24\t\tmeta := make(map[string]string)\r\n    25\t\tscanner := bufio.NewScanner(f)\r\n    26\t\tfor scanner.Scan() {\r\n"]
[9633.886098, "o", "    27\t\t\tline := strings.TrimSpace(scanner.Text())\r\n    28\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    29\t\t\t\tcontinue\r\n    30\t\t\t}\r\n    31\t\t\tparts := strings.SplitN(line, \"=\", 2)\r\n    32\t\t\tif len(parts) == 2 {\r\n    33\t\t\t\tmeta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])\r\n    34\t\t\t}\r\n    35\t\t}\r\n    36\t\treturn meta, scanner.Err()\r\n    37"]
[9633.886162, "o", "\t}\r\n    38\t\r\n    39\ttype WeightsData struct {\r\n    40\t\tVersion     uint32\r\n    41\t\tNumFeatures uint32\r\n    42\t\tNumOutputs  uint32\r\n    43\t\tActivation  uint32\r\n    44\t\tWeights     []float64\r\n    45\t\tBias        []float64\r\n    46\t}\r\n"]
[9633.88622, "o", "    47\t\r\n    48\tfunc loadWeights(modelDir string) (*WeightsData, error) {\r\n    49\t\tf, err := os.Open(filepath.Join(modelDir, \"weights.bin\"))\r\n    50\t\tif err != nil {\r\n    51\t\t\treturn nil, err\r\n    52\t\t}\r\n    53\t\tdefer f.Close()\r\n    54\t\r\n"]
[9633.886278, "o", "    55\t\tmagic := make([]byte, 4)\r\n    56\t\tif _, err := f.Read(magic); err != nil {\r\n    57\t\t\treturn nil, fmt.Errorf(\"failed to read magic: %v\", err)\r\n    58\t\t}\r\n    59\t\tif string(magic) != string(modelMagic) {\r\n    60\t\t\treturn nil, fmt.Errorf(\"invalid model file: bad magic\")\r\n    61\t\t}\r\n    62"]
[9633.886339, "o", "\t\r\n    63\t\tvar ver, nf, no uint32\r\n    64\t\tif err := binary.Read(f, binary.LittleEndian, &ver); err != nil {\r\n    65\t\t\treturn nil, fmt.Errorf(\"failed to read version: %v\", err)\r\n    66\t\t}\r\n    67\t\tif err := binary.Read(f, binary.LittleEndian, &nf); err != nil {\r\n    68\t\t\treturn nil, fmt.Errorf(\"failed to read num_features: %v\", err)\r\n    69\t\t}\r\n    70\t\t"]
[9633.886401, "o", "if err := binary.Read(f, binary.LittleEndian, &no); err != nil {\r\n    71\t\t\treturn nil, fmt.Errorf(\"failed to read num_outputs: %v\", err)\r\n    72\t\t}\r\n    73\t\r\n    74\t\tvar act uint32\r\n    75\t\tswitch ver {\r\n    76\t\tcase 1:\r\n    77\t\t\tact = 0\r\n    78\t"]
[9633.88646, "o", "\tcase 2:\r\n    79\t\t\tif err := binary.Read(f, binary.LittleEndian, &act); err != nil {\r\n    80\t\t\t\treturn nil, fmt.Errorf(\"failed to read activation: %v\", err)\r\n    81\t\t\t}\r\n    82\t\tdefault:\r\n    83\t\t\treturn nil, fmt.Errorf(\"unsupported model format version: %d\", ver)\r\n    84\t\t}\r\n    85\t\r\n    86\t"]
[9633.886526, "o", "\tweights := make([]float64, nf*no)\r\n    87\t\tfor i := range weights {\r\n    88\t\t\tif err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {\r\n    89\t\t\t\treturn nil, fmt.Errorf(\"failed to read weight[%d]: %v\", i, err)\r\n    90\t\t\t}\r\n    91\t\t}\r\n    92\t\r\n    93\t\tbias := make([]float64, no)\r\n"]
[9633.886586, "o", "    94\t\tfor i := range bias {\r\n    95\t\t\tif err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {\r\n    96\t\t\t\treturn nil, fmt.Errorf(\"failed to read bias[%d]: %v\", i, err)\r\n    97\t\t\t}\r\n    98\t\t}\r\n    99\t\r\n   100\t\treturn &WeightsData{\r\n   101\t\t\tVersion:     ver,\r\n   102\t\t\tNumFeatures: nf,\r\n   103\t\t\tNumOutputs:  no,\r\n   104\t\t\tActivation:  act,\r\n"]
[9633.886645, "o", "   105\t\t\tWeights:     weights,\r\n   106\t\t\tBias:        bias,\r\n   107\t\t}, nil\r\n   108\t}\r\n   109\t\r\n   110\tfunc writeWeights(path string, w *WeightsData) error {\r\n   111\t\tf, err := os.Create(path)\r\n   112\t\tif err != nil {\r\n   113\t\t\treturn err\r\n"]
[9633.886707, "o", "   114\t\t}\r\n   115\t\tdefer f.Close()\r\n   116\t\r\n   117\t\tif _, err := f.Write(modelMagic); err != nil {\r\n   118\t\t\treturn err\r\n   119\t\t}\r\n   120\t\tif err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {\r\n   121\t\t\treturn err\r\n   122\t\t}\r\n"]
[9633.886769, "o", "   123\t\tif err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {\r\n   124\t\t\treturn err\r\n   125\t\t}\r\n   126\t\tif err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {\r\n   127\t\t\treturn err\r\n   128\t\t}\r\n   129\t\tif w.Version >= 2 {\r\n   130\t\t\tif err := binary.Write(f, binary.LittleEndian, w.Activation); err != nil {\r\n   131\t\t\t\treturn err\r\n"]
[9633.886867, "o", "   132\t\t\t}\r\n   133\t\t}\r\n   134\t\tfor _, v := range w.Weights {\r\n   135\t\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n   136\t\t\t\treturn err\r\n   137\t\t\t}\r\n   138\t\t}\r\n   139\t\tfor _, v := range w.Bias {\r\n   140\t\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n   141\t\t\t\treturn err\r\n   142\t\t\t}\r\n   143\t\t}\r\n"]
[9633.886923, "o", "   144\t\treturn nil\r\n   145\t}\r\n   146\t\r\n   147\tconst (\r\n   148\t\tactivationNone    = 0\r\n   149\t\tactivationSigmoid = 1\r\n   150\t\tactivationReLU    = 2\r\n   151\t\tactivationTanh    = 3\r\n"]
[9633.886983, "o", "   152\t)\r\n   153\t\r\n   154\tfunc activationNameToID(name string) (uint32, error) {\r\n   155\t\tswitch strings.ToLower(name) {\r\n   156\t\tcase \"\", \"none\":\r\n   157\t\t\treturn activationNone, nil\r\n   158\t\tcase \"sigmoid\":\r\n"]
[9633.887052, "o", "   159\t\t\treturn activationSigmoid, nil\r\n   160\t\tcase \"relu\":\r\n   161\t\t\treturn activationReLU, nil\r\n   162\t\tcase \"tanh\":\r\n   163\t\t\treturn activationTanh, nil\r\n   164\t\tdefault:\r\n   165\t\t\treturn 0, fmt.Errorf(\"invalid activation\")\r\n   166\t\t}\r\n   167\t}\r\n   168\t\r\n"]
[9633.887113, "o", "   169\tfunc activationIDToName(id uint32) string {\r\n   170\t\tswitch id {\r\n   171\t\tcase activationNone:\r\n   172\t\t\treturn \"none\"\r\n   173\t\tcase activationSigmoid:\r\n   174\t\t\treturn \"sigmoid\"\r\n   175\t\tcase activationReLU:\r\n"]
[9633.887172, "o", "   176\t\t\treturn \"relu\"\r\n   177\t\tcase activationTanh:\r\n   178\t\t\treturn \"tanh\"\r\n   179\t\tdefault:\r\n   180\t\t\treturn \"unknown\"\r\n   181\t\t}\r\n   182\t}\r\n   183\t\r\n"]
[9633.887234, "o", "   184\tfunc applyActivation(x float64, activation uint32) float64 {\r\n   185\t\tswitch activation {\r\n   186\t\tcase activationSigmoid:\r\n   187\t\t\treturn 1.0 / (1.0 + math.Exp(-x))\r\n   188\t\tcase activationReLU:\r\n   189\t\t\tif x < 0 {\r\n   190\t\t\t\treturn 0\r\n   191\t\t\t}\r\n   192\t\t\treturn x\r\n   193\t\tcase activationTanh:\r\n"]
[9633.887303, "o", "   194\t\t\treturn math.Tanh(x)\r\n   195\t\tdefault:\r\n   196\t\t\treturn x\r\n   197\t\t}\r\n   198\t}\r\n   199\t\r\n   200\tfunc saveModelMeta(modelDir string, meta map[string]string) error {\r\n   201\t\tf, err := os.Create(filepath.Join(modelDir, \"model.meta\"))\r\n   202\t\tif err != nil {\r\n"]
[9633.887366, "o", "   203\t\t\treturn err\r\n   204\t\t}\r\n   205\t\tdefer f.Close()\r\n   206\t\r\n   207\t\tkeys := make([]string, 0, len(meta))\r\n   208\t\tfor k := range meta {\r\n   209\t\t\tkeys = append(keys, k)\r\n   210\t\t}\r\n   211\t\tsort.Strings(keys)\r\n   212\t\tfor _, k := range keys {\r\n"]
[9633.887422, "o", "   213\t\t\tfmt.Fprintf(f, \"%s=%s\\n\", k, meta[k])\r\n   214\t\t}\r\n   215\t\treturn nil\r\n   216\t}\r\n   217\t\r\n   218\ttype PipelineConfig struct {\r\n   219\t\tNormalize       bool\r\n   220\t\tScaleMin        float64\r\n"]
[9633.887483, "o", "   221\t\tScaleMax        float64\r\n   222\t\tMissingStrategy string\r\n   223\t\tRoundDigits     int\r\n   224\t\tClipMin         float64\r\n   225\t\tClipMax         float64\r\n   226\t}\r\n   227\t\r\n   228\tfunc loadPipelineConfig(modelDir string) (*PipelineConfig, error) {\r\n   229\t\t"]
[9633.887552, "o", "f, err := os.Open(filepath.Join(modelDir, \"pipeline.cfg\"))\r\n   230\t\tif err != nil {\r\n   231\t\t\treturn nil, err\r\n   232\t\t}\r\n   233\t\tdefer f.Close()\r\n   234\t\r\n   235\t\tcfg := &PipelineConfig{\r\n   236\t\t\tScaleMin:        0.0,\r\n   237\t\t\tScaleMax:        1.0,\r\n"]
[9633.887609, "o", "   238\t\t\tMissingStrategy: \"zero\",\r\n   239\t\t\tRoundDigits:     4,\r\n   240\t\t\tClipMin:         -1000.0,\r\n   241\t\t\tClipMax:         1000.0,\r\n   242\t\t}\r\n   243\t\r\n   244\t\tscanner := bufio.NewScanner(f)\r\n   245\t\t"]
[9633.887671, "o", "section := \"\"\r\n   246\t\tfor scanner.Scan() {\r\n   247\t\t\tline := strings.TrimSpace(scanner.Text())\r\n   248\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n   249\t\t\t\tcontinue\r\n   250\t\t\t}\r\n   251\t\t\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\r\n   252\t\t\t\tsection = line[1 : len(line)-1]\r\n   253\t\t\t\tcontinue\r\n"]
[9633.887731, "o", "   254\t\t\t}\r\n   255\t\t\tparts := strings.SplitN(line, \"=\", 2)\r\n   256\t\t\tif len(parts) != 2 {\r\n   257\t\t\t\tcontinue\r\n   258\t\t\t}\r\n   259\t\t\tkey := strings.TrimSpace(parts[0])\r\n   260\t\t\tval := strings.TrimSpace(parts[1])\r\n   261\t\r\n"]
