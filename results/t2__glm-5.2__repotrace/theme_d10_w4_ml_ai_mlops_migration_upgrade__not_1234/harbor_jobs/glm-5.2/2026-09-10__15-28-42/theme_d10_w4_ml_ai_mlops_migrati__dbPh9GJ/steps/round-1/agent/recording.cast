[12131.62206, "o", "\t\t\tcmdClone(args)\r\n    63\t\tcase \"checkpoint\":\r\n    64\t\t\tcmdCheckpoint(args)\r\n    65\t\tcase \"checkpoints\":\r\n    66\t\t\tcmdCheckpoints(args)\r\n    67\t\tcase \"rollback\":\r\n    68\t\t\tcmdRollback(args)\r\n    69\t\tcase \"migrate\":\r\n    70\t\t\tcmdMigrate(args)\r\n    71\t\tcase \"compat\":\r\n    72\t\t\tcmdCompat(args)\r\n    73\t\tcase \"version\":\r\n    74\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    75\t\tcase \"help\":\r\n    76\t\t\tprintUsage()\r\n    77\t\t"]
[12131.622122, "o", "default:\r\n    78\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    79\t\t\tprintUsage()\r\n    80\t\t\tos.Exit(1)\r\n    81\t\t}\r\n    82\t}\r\n    83\t\r\n    84\tfunc printUsage() {\r\n    85\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    86\t\r\n    87\tUsage: mlpipe <command> [arguments]\r\n    88\t\r\n    89\tCommands:\r\n    90\t  list                          List all registered models\r\n    91\t  info <model>                  Show model details\r\n    92\t  register <name> <path>        Register a model from directory\r\n"]
[12131.62218, "o", "    93\t  remove <name>                 Remove a model from registry\r\n    94\t  run <model> [options]         Run inference\r\n    95\t  stats --input <file>          Input statistics profiling\r\n    96\t  diff <model1> <model2> --input <file>\r\n    97\t                                Compare two models on same input\r\n    98\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n    99\t                                Batch inference over CSV files\r\n   100\t  validate <model>              Validate model integrity\r\n   101\t  validate-input <model> --input <file>\r\n   102\t                                Validate input data for a model\r\n   103\t  schema <model>                Display expected input schema for a model\r\n"]
[12131.622249, "o", "   104\t  export <model> --output <file> Export model to JSON file\r\n   105\t  import <path> [--name <name>] Import model from JSON file\r\n   106\t  clone <model> <new_name>      Clone model to new name\r\n   107\t  benchmark <model> --input <file> [--runs <N>]\r\n   108\t                                Benchmark inference performance\r\n   109\t  prune <model> --threshold <value> [--dry-run]\r\n   110\t                                Prune near-zero weights\r\n   111\t  profile <model>               Report model weight analysis\r\n   112\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n   113\t  compat [--all]                 Check migration compatibility\r\n   114\t  version                       Show version\r\n   115\t  help                          Show this help\r\n   116\t\r\n   117\tRun/Diff Options:\r\n   118\t  --input <file>    Input CSV file (required)\r\n   119\t  --output <file>   Output file (default: stdout)\r\n   120\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   121\t  --strict          "]
[12131.622314, "o", "Validate input before inference and abort on invalid rows\r\n   122\t\r\n   123\tBatch Options:\r\n   124\t  --dir <dir>       Input directory of CSV files\r\n   125\t  --output-dir <dir> Output directory for predictions\r\n   126\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   127\t`\r\n   128\t\tfmt.Print(usage)\r\n   129\t}\r\n   130\t\r\n   131\tfunc parseFlags(args []string) map[string]string {\r\n   132\t\tflags := make(map[string]string)\r\n   133\t\tfor i := 0; i < len(args); i++ {\r\n   134\t\t\tif strings.HasPrefix(args[i], \"--\") {\r\n   135\t\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n   136\t\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n   137\t\t\t\t\tflags[key] = args[i+1]\r\n   138\t\t\t\t\ti++\r\n   139\t\t\t\t} else {\r\n   140\t\t"]
[12131.622369, "o", "\t\t\tflags[key] = \"true\"\r\n   141\t\t\t\t}\r\n   142\t\t\t}\r\n   143\t\t}\r\n   144\t\treturn flags\r\n   145\t}\r\n"]
