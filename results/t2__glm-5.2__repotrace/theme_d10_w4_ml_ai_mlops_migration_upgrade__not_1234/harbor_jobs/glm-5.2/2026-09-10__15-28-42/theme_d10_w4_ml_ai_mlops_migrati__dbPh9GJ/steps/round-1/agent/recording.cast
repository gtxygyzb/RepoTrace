[10173.772217, "o", "    s2 = re.sub(r'(  --format <fmt>    Output format: csv or json \\(default: csv\\)\\n)(\\nBatch Options:)', r'\\1  --strict          Validate input before inference and abort on invalid rows\\n\\2', s, count=1)\r\n\u001b[?2004l\r"]
[10173.772314, "o", "\u001b[?2004h> "]
[10173.772395, "o", "    if s2 == s:\r\n\u001b[?2004l\r"]
[10173.772465, "o", "\u001b[?2004h> "]
[10173.772714, "o", "        raise SystemExit('regex did not match')\r\n\u001b[?2004l\r"]
[10173.772766, "o", "\u001b[?2004h> "]
[10173.772913, "o", "    p.write_text(s2)\r\n\u001b[?2004l\r"]
[10173.772971, "o", "\u001b[?2004h> "]
[10173.773028, "o", "PY\r\n\u001b[?2004l\r"]
