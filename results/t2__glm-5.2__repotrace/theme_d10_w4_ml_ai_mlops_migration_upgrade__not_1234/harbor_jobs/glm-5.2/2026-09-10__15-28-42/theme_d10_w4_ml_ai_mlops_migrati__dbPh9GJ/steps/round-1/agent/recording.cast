[5921.50344, "o", "\tfor _, rec := range records {\r\n   100\t\t\tif len(rec) > numCols {\r\n   101\t\t\t\tnumCols = len(rec)\r\n   102\t\t\t}\r\n   103\t\t}\r\n   104\t\r\n   105\t\theaders := make([]string, numCols)\r\n   106\t\tfor i := 0; i < numCols; i++ {\r\n   107\t\t\tif hasHeader && i < len(records[0]) {\r\n"]
