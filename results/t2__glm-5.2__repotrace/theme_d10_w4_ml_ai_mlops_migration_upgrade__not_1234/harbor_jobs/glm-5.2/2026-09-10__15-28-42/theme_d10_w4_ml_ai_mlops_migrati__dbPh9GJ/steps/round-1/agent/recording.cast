[1199.317024, "i", "unts: %s=%d, %s=%d\\n\", model1, w1.NumFeatures, model2, w2.NumFeatures)\n\t\tos.Exit(1)\n\t}\n\n\tinputs, err := readInputCSV(input)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tif err := validateFeatureCount(inputs, int(w1.NumFeatures)); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error: input feature count mismatch: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tr1 := runInference(inputs, w1, cfg1)\n\tr2 := runInference(inputs, w2, cfg2)\n\n\tmaxOut := minInt(int(w1.NumOutputs), int(w2.NumOutputs))\n\tif int(w1.NumOutputs) != int(w2.NumOutputs) {\n\t\tfmt.Printf(\"note: model output dimension mismatch: %s=%d, %s=%d; comparing %d output(s)\\n\", model1, w1.NumOutputs, model2, w2.NumOutputs, maxOut)\n\t}\n\n\tvar sumAbs, sumSq, maxAbs float64\n\tcount := 0\n\tfor i := 0; i < len(r1) && i < len(r2); i++ {\n\t\tdiffs := make([]float64, maxOut)\n\t\tfor o := 0; o < maxOut; o++ {\n\t\t\td := math.Abs(r1[i][o] - r2[i][o])\n\t\t\tdiffs[o] = d\n\t\t\tsumAbs += d\n\t\t\tsumSq += d * d\n\t\t\tif d > maxAbs {\n\t\t\t\tmaxAbs = d\n\t\t\t}\n\t\t\tcount++\n\t\t}\n\t\tfm"]
[1199.317284, "i", "t.Printf(\"row %d: %v\\n\", i, diffs)\n\t}\n\n\tvar mae, rmse float64\n\tif count > 0 {\n\t\tmae = sumAbs / float64(count)\n\t\trmse = math.Sqrt(sumSq / float64(count))\n\t}\n\n\tfmt.Printf(\"MAE: %.4f\\n\", mae)\n\tfmt.Printf(\"RMSE: %.4f\\n\", rmse)\n\tfmt.Printf(\"Max Abs Error: %.4f\\n\", maxAbs)\n}\n\nfunc minInt(a, b int) int {\n\tif a < b {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc cmdBatch(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe batch <model> --dir <input_dir> --output-dir <output_dir> [--format csv|json]\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tmodel := args[0]\n\tflags := parseFlags(args[1:])\n\n\tinputDir := flags[\"dir\"]\n\toutputDir := flags[\"output-dir\"]\n\tformat := flags[\"format\"]\n\tif format == \"\" {\n\t\tformat = \"csv\"\n\t}\n\tif format != \"csv\" && format != \"json\" {\n\t\tfmt.Fprintf(os.Stderr, \"error: unsupported format '%s', use 'csv' or 'json'\\n\", format)\n\t\tos.Exit(1)\n\t}\n\tif inputDir == \"\" {\n\t\tfmt.Fprintf(os.Stderr, \"error: --dir is required\\n\")\n\t\tos.Exit(1)\n\t}\n\tif outputDir == \"\" {\n\t\tfmt.Fprintf(os.Stderr, \"error: --output-dir is required\\"]
