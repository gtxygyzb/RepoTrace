[11340.383759, "o", "    57\t\t}\r\n    58\t\tdefer f.Close()\r\n    59\t\r\n    60\t\treader := csv.NewReader(f)\r\n    61\t\treader.FieldsPerRecord = -1\r\n    62\t\treturn reader.ReadAll()\r\n    63\t}\r\n    64\t\r\n    65\tfunc isMissingValue(val string) bool {\r\n    66\t\tval = strings.TrimSpace(val)\r\n"]
[11340.383852, "o", "    67\t\tif val == \"\" {\r\n    68\t\t\treturn true\r\n    69\t\t}\r\n    70\t\tlower := strings.ToLower(val)\r\n    71\t\treturn lower == \"na\" || lower == \"nan\"\r\n    72\t}\r\n    73\t\r\n    74\tfunc cmdStats(args []string) {\r\n    75\t\tflags := parseFlags(args)\r\n    76\t\tinput := flags[\"input\"]\r\n    77\t\tif input == \"\" {\r\n    78"]
[11340.383911, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe stats --input <file>\\n\")\r\n    79\t\t\tos.Exit(1)\r\n    80\t\t}\r\n    81\t\r\n    82\t\trecords, err := readCSVRaw(input)\r\n    83\t\tif err != nil {\r\n    84\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    85\t\t\tos.Exit(1)\r\n    86\t\t}\r\n"]
[11340.383971, "o", "    87\t\tif len(records) == 0 {\r\n    88\t\t\tfmt.Println(\"No data found.\")\r\n    89\t\t\treturn\r\n    90\t\t}\r\n    91\t\r\n    92\t\thasHeader := isHeader(records[0])\r\n    93\t\tstart := 0\r\n    94\t\tif hasHeader {\r\n"]
