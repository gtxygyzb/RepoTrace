[5981.543141, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/csv\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"math\""]
[5981.54324, "o", "\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t)\r\n    13\t\r\n    14\tfunc modelDirExists(path string) bool {\r\n    15\t\tinfo, err := os.Stat(path)\r\n    16\t\treturn err == nil && info.IsDir()\r\n    17\t}\r\n    18\t\r\n    19\tfunc resolveModel(name string) (*RegistryEntry, error) {\r\n"]
[5981.543325, "o", "    20\t\tentries, err := loadRegistry()\r\n    21\t\tif err != nil {\r\n    22\t\t\treturn nil, err\r\n    23\t\t}\r\n    24\t\tentry := findEntry(entries, name)\r\n    25\t\tif entry == nil || !modelDirExists(entry.Path) {\r\n    26\t\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n    27\t\t\tos.Exit(1)\r\n    28\t\t}\r\n    29\t\treturn entry, nil\r\n    30\t}\r\n    31\t\r\n"]
[5981.543395, "o", "    32\tfunc loadModelArtifacts(modelDir string) (*WeightsData, *PipelineConfig, error) {\r\n    33\t\tweights, err := loadWeights(modelDir)\r\n    34\t\tif err != nil {\r\n    35\t\t\treturn nil, nil, err\r\n    36\t\t}\r\n    37\t\tcfg, err := loadPipelineConfig(modelDir)\r\n    38\t\tif err != nil {\r\n    39\t\t\treturn nil, nil, err\r\n    40\t\t}\r\n"]
[5981.543465, "o", "    41\t\treturn weights, cfg, nil\r\n    42\t}\r\n    43\t\r\n    44\tfunc validateFeatureCount(inputs [][]float64, expected int) error {\r\n    45\t\tfor i, row := range inputs {\r\n    46\t\t\tif len(row) != expected {\r\n    47\t\t\t\treturn fmt.Errorf(\"expected %d features, got %d in row %d\", expected, len(row), i)\r\n    48\t\t\t}\r\n    49\t\t}\r\n    50\t\treturn nil\r\n    51\t"]
[5981.54354, "o", "}\r\n    52\t\r\n    53\tfunc readCSVRaw(path string) ([][]string, error) {\r\n    54\t\tf, err := os.Open(path)\r\n    55\t\tif err != nil {\r\n    56\t\t\treturn nil, err\r\n    57\t\t}\r\n    58\t\tdefer f.Close()\r\n    59\t\r\n    60\t\treader := csv.NewReader(f)\r\n"]
[5981.543607, "o", "    61\t\treader.FieldsPerRecord = -1\r\n    62\t\treturn reader.ReadAll()\r\n    63\t}\r\n    64\t\r\n    65\tfunc isMissingValue(val string) bool {\r\n    66\t\tval = strings.TrimSpace(val)\r\n    67\t\tif val == \"\" {\r\n    68\t\t\treturn true\r\n    69\t\t}\r\n    70\t\tlower := strings.ToLower(val)\r\n"]
