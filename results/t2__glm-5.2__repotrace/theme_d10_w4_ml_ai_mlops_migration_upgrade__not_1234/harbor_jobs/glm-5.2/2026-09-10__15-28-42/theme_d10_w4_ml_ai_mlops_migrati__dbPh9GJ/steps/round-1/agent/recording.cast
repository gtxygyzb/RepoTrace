[13881.947413, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/binary\"\r\n"]
[13881.94749, "o", "     6\t\t\"fmt\"\r\n     7\t\t\"hash\"\r\n     8\t\t\"hash/crc32\"\r\n     9\t\t\"io\"\r\n    10\t\t\"math\"\r\n    11\t\t\"os\"\r\n    12\t\t\"path/filepath\"\r\n    13\t\t\"sort\"\r\n    14\t\t\"strconv\"\r\n    15\t\t\"strings\"\r\n    16\t)\r\n    17"]
[13881.947565, "o", "\t\r\n    18\tvar modelMagic = []byte(\"MLPW\")\r\n    19\t\r\n    20\tfunc loadModelMeta(modelDir string) (map[string]string, error) {\r\n    21\t\tf, err := os.Open(filepath.Join(modelDir, \"model.meta\"))\r\n    22\t\tif err != nil {\r\n    23\t\t\treturn nil, err\r\n    24\t\t}\r\n    25\t\tdefer f.Close()\r\n    26\t\r\n"]
[13881.947637, "o", "    27\t\tmeta := make(map[string]string)\r\n    28\t\tscanner := bufio.NewScanner(f)\r\n    29\t\tfor scanner.Scan() {\r\n    30\t\t\tline := strings.TrimSpace(scanner.Text())\r\n    31\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    32\t\t\t\tcontinue\r\n    33\t\t\t}\r\n    34\t\t\tparts := strings.SplitN(line, \"=\", 2)\r\n    35\t\t\tif len(parts) == 2 {\r\n    36\t\t\t\tmeta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])"]
[13881.947703, "o", "\r\n    37\t\t\t}\r\n    38\t\t}\r\n    39\t\treturn meta, scanner.Err()\r\n    40\t}\r\n    41\t"]
[13881.947772, "o", "\r\n    42\ttype WeightsData struct {\r\n    43\t\tVersion     uint32\r\n    44\t\tNumFeatures uint32\r\n    45\t\tNumOutputs  uint32\r\n    46\t\tActivation  uint32\r\n    47\t\tWeights     []float64\r\n    48\t\tBias        []float64\r\n    49"]
[13881.947867, "o", "\t}\r\n    50\t\r\n    51\tfunc loadWeights(modelDir string) (*WeightsData, error) {\r\n    52\t\tf, err := os.Open(filepath.Join(modelDir, \"weights.bin\"))\r\n    53\t\tif err != nil {\r\n    54\t\t\treturn nil, err\r\n    55\t\t}\r\n    56\t\tdefer f.Close()\r\n    57\t\r\n    58\t\tmagic := make([]byte, 4)\r\n    59\t\tif _, err := f.Read(magic); err != nil {\r\n    60\t\t\treturn nil, fmt.Errorf(\"failed to read magic: %v\", err)\r\n    61\t\t}\r\n    62\t\tif string(magic) != string(modelMagic) {\r\n    63\t\t\treturn nil, fmt.Errorf(\"invalid model file: bad magic\")\r\n    64\t\t}\r\n    65\t\r\n    66\t\tvar ver, nf, no uint32\r\n"]
[13881.947958, "o", "    67\t\tif err := binary.Read(f, binary.LittleEndian, &ver); err != nil {\r\n    68\t\t\treturn nil, fmt.Errorf(\"failed to read version: %v\", err)\r\n    69\t\t}\r\n    70\t\r\n    71\t\tvar hasher hash.Hash32\r\n    72\t\tr := io.Reader(f)\r\n    73\t\tif ver == 3 {\r\n    74\t\t\thasher = crc32.NewIEEE()\r\n    75\t\t\tif _, err := hasher.Write(magic); err != nil {\r\n    76\t\t\t\treturn nil, fmt.Errorf(\"failed to compute checksum: %v\", err)\r\n    77\t\t"]
[13881.948027, "o", "\t}\r\n    78\t\t\tif err := binary.Write(hasher, binary.LittleEndian, ver); err != nil {\r\n    79\t\t\t\treturn nil, fmt.Errorf(\"failed to compute checksum: %v\", err)\r\n    80\t\t\t}\r\n    81\t\t\tr = io.TeeReader(f, hasher)\r\n    82\t\t}\r\n    83\t\r\n    84\t\tif err := binary.Read(r, binary.LittleEndian, &nf); err != nil {\r\n    85\t\t\treturn nil, fmt.Errorf(\"failed to read num_features: %v\", err)\r\n"]
[13881.9481, "o", "    86\t\t}\r\n    87\t\tif err := binary.Read(r, binary.LittleEndian, &no); err != nil {\r\n    88\t\t\treturn nil, fmt.Errorf(\"failed to read num_outputs: %v\", err)\r\n    89\t\t}\r\n    90\t\r\n    91\t\tvar act uint32\r\n    92\t\tswitch ver {\r\n    93\t\tcase 1:\r\n    94\t\t\tact = 0\r\n    95\t\tcase 2, 3:\r\n    96\t\t\tif err := binary.Read(r, binary.LittleEndian, &act); err != nil {\r\n"]
[13881.948181, "o", "    97\t\t\t\treturn nil, fmt.Errorf(\"failed to read activation: %v\", err)\r\n    98\t\t\t}\r\n    99\t\tdefault:\r\n   100\t\t\treturn nil, fmt.Errorf(\"unsupported model format version: %d\", ver)\r\n   101\t\t}\r\n   102\t\r\n   103\t\tweights := make([]float64, nf*no)\r\n   104\t\tfor i := range weights {\r\n   105\t\t\tif err := binary.Read(r, binary.LittleEndian, &weights[i]); err != nil {\r\n   106\t\t\t\treturn nil, fmt.Errorf(\"failed to read weight[%d]: %v\", i, err)\r\n   107\t\t\t}\r\n   108\t\t}\r\n   109\t\r\n"]
[13881.948239, "o", "   110\t\tbias := make([]float64, no)\r\n   111\t\tfor i := range bias {\r\n   112\t\t\tif err := binary.Read(r, binary.LittleEndian, &bias[i]); err != nil {\r\n   113\t\t\t\treturn nil, fmt.Errorf(\"failed to read bias[%d]: %v\", i, err)\r\n   114\t\t\t}\r\n   115\t\t}\r\n   116\t\r\n   117\t\tif ver == 3 {\r\n"]
[13881.948308, "o", "   118\t\t\tvar checksum uint32\r\n   119\t\t\tif err := binary.Read(f, binary.LittleEndian, &checksum); err != nil {\r\n   120\t\t\t\treturn nil, fmt.Errorf(\"failed to read checksum: %v\", err)\r\n   121\t\t\t}\r\n   122\t\t\tif hasher.Sum32() != checksum {\r\n   123\t\t\t\treturn nil, fmt.Errorf(\"checksum mismatch\")\r\n   124\t\t\t}\r\n   125\t\t}\r\n   126\t\r\n   127\t\treturn &WeightsData{\r\n"]
[13881.94837, "o", "   128\t\t\tVersion:     ver,\r\n   129\t\t\tNumFeatures: nf,\r\n   130\t\t\tNumOutputs:  no,\r\n   131\t\t\tActivation:  act,\r\n   132\t\t\tWeights:     weights,\r\n   133\t\t\tBias:        bias,\r\n   134\t\t}, nil\r\n"]
[13881.948429, "o", "   135\t}\r\n   136\t\r\n   137\tfunc writeWeights(path string, w *WeightsData) error {\r\n   138\t\tf, err := os.Create(path)\r\n   139\t\tif err != nil {\r\n   140\t\t\treturn err\r\n   141\t\t}\r\n   142\t\tdefer f.Close()\r\n   143\t\r\n   144\t\thasher := crc32.NewIEEE()\r\n"]
[13881.94849, "o", "   145\t\tmw := io.MultiWriter(f, hasher)\r\n   146\t\r\n   147\t\tif _, err := mw.Write(modelMagic); err != nil {\r\n   148\t\t\treturn err\r\n   149\t\t}\r\n   150\t\tif err := binary.Write(mw, binary.LittleEndian, w.Version); err != nil {\r\n   151\t\t\treturn err\r\n   152\t\t}\r\n   153\t\tif err := binary.Write(mw, binary.LittleEndian, w.NumFeatures); err != nil {\r\n"]
[13881.948565, "o", "   154\t\t\treturn err\r\n   155\t\t}\r\n   156\t\tif err := binary.Write(mw, binary.LittleEndian, w.NumOutputs); err != nil {\r\n   157\t\t\treturn err\r\n   158\t\t}\r\n   159\t\t"]
[13881.948627, "o", "if w.Version >= 2 {\r\n   160\t\t\tif err := binary.Write(mw, binary.LittleEndian, w.Activation); err != nil {\r\n"]
