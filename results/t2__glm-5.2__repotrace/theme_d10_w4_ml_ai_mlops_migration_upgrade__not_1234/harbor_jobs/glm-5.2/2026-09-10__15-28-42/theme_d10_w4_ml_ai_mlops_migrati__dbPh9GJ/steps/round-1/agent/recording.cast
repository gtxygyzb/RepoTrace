[12618.646075, "o", "./checkpoints.go\r\n./commands.go\r\n./commands_extra.go\r\n./ensemble.go\r\n./export_import.go\r\n./format.go\r\n./inference.go\r\n./main.go\r\n./migration.go\r\n./registry.go\r\n./validate_input.go\r\n"]
[12618.646547, "o", "\u001b[?2004h"]
[12618.646618, "o", "root@n30009:/app# "]
[12624.490768, "i", "sed -n '1,220p' main.go\n"]
[12624.491094, "o", "sed -n '1,220p' main.go\r\n\u001b[?2004l\r"]
[12624.494107, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n"]
[12624.49419, "o", ")\r\n\r\nconst version = \"0.1.0\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcommand := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch command {\r\n\tcase \"ensemble\":\r\n\t\tcmdEnsemble(args)\r\n"]
[12624.494268, "o", "\tcase \"list\":\r\n\t\tcmdList(args)\r\n\tcase \"info\":\r\n\t\tcmdInfo(args)\r\n\tcase \"register\":\r\n\t\tcmdRegister(args)\r\n\tcase \"remove\":\r\n\t\tcmdRemove(args)\r\n\tcase \"tag\":\r\n\t\tcmdTag(args)\r\n\tcase \"untag\":\r\n\t\tcmdUntag(args)\r\n\tcase \"search\":\r\n"]
[12624.494339, "o", "\t\tcmdSearch(args)\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"stats\":\r\n\t\tcmdStats(args)\r\n\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n\tcase \"batch\":\r\n\t\tcmdBatch(args)\r\n\tcase \"benchmark\":"]
[12624.494415, "o", "\r\n\t\tcmdBenchmark(args)\r\n\tcase \"prune\":\r\n\t\tcmdPrune(args)\r\n\tcase \"profile\":\r\n\t\tcmdProfile(args)\r\n\tcase \"explain\":\r\n\t\tcmdExplain(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"validate-input\":\r\n\t\tcmdValidateInput(args)\r\n"]
[12624.494486, "o", "\tcase \"schema\":\r\n\t\tcmdSchema(args)\r\n\tcase \"export\":\r\n\t\tcmdExport(args)\r\n\tcase \"import\":\r\n\t\tcmdImport(args)\r\n\tcase \"clone\":\r\n\t\tcmdClone(args)\r\n\tcase \"checkpoint\":\r\n\t\tcmdCheckpoint(args)\r\n\tcase \"checkpoints\":\r\n\t\tcmdCheckpoints(args)\r\n\tcase \"rollback\":"]
[12624.49456, "o", "\r\n\t\tcmdRollback(args)\r\n\tcase \"migrate\":\r\n\t\tcmdMigrate(args)\r\n\tcase \"compat\":\r\n\t\tcmdCompat(args)\r\n\tcase \"version\":\r\n\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n\tcase \"help\":\r\n\t\tprintUsage()\r\n\tdefault:\r\n\t"]
[12624.494627, "o", "\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc printUsage() {\r\n\tusage := `mlpipe - ML Inference Pipeline Manager\r\n\r\nUsage: mlpipe <command> [arguments]\r\n\r\nCommands:\r\n  list                          List all registered models\r\n"]
[12624.494704, "o", "  info <model>                  Show model details\r\n  register <name> <path>        Register a model from directory\r\n  remove <name>                 Remove a model from registry\r\n  run <model> [options]         Run inference\r\n  stats --input <file>          Input statistics profiling\r\n  diff <model1> <model2> --input <file>\r\n                                Compare two models on same input\r\n  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n                                Batch inference over CSV files\r\n"]
[12624.494777, "o", "  validate <model>              Validate model integrity\r\n  validate-input <model> --input <file>\r\n                                Validate input data for a model\r\n  schema <model>                Display expected input schema for a model\r\n  export <model> --output <file> Export model to JSON file\r\n  import <path> [--name <name>] Import model from JSON file\r\n  clone <model> <new_name>      Clone model to new name\r\n  benchmark <model> --input <file> [--runs <N>]\r\n                                Benchmark inference performance\r\n  prune <model> --threshold <value> [--dry-run]\r\n                                Prune near-zero weights\r\n  profile <model>               Report model weight analysis\r\n  explain <model> --input <file> [--row <N>]\r\n                                  Explain prediction for a row\r\n  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n  compat [--all]                 Check migration compatibility\r\n"]
[12624.494869, "o", "  version                       Show version\r\n  help                          Show this help\r\n\r\nRun/Diff Options:\r\n  --input <file>    Input CSV file (required)\r\n  --output <file>   Output file (default: stdout)\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n  --strict          Validate input before inference and abort on invalid rows\r\n\r\nBatch Options:\r\n  --dir <dir>       Input directory of CSV files\r\n  --output-dir <dir> Output directory for predictions\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n`\r\n\tfmt.Print(usage)\r\n}\r\n\r\nfunc parseFlags(args []string) map[string]string {\r\n\tflags := make(map[string]string)\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tif strings.HasPrefix(args[i], \"--\") {\r\n"]
[12624.494937, "o", "\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n\t\t\t\tflags[key] = args[i+1]\r\n\t\t\t\ti++\r\n\t\t\t} else {\r\n\t\t\t\tflags[key] = \"true\"\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn flags\r\n}\r\n"]
[12624.495467, "o", "\u001b[?2004h"]
[12624.495533, "o", "root@n30009:/app# "]
[12624.765367, "i", "sed -n '1,220p' commands.go\n"]
[12624.76567, "o", "sed -n '1,220p' commands.go\r\n\u001b[?2004l\r"]
[12624.768658, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n"]
[12624.76875, "o", ")\r\n\r\nfunc cmdValidate(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe validate <model>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {\r\n"]
[12624.768867, "o", "\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif !modelDirExists(entry.Path) {\r\n\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\terrors := validateModel(entry.Path)\r\n\tif len(errors) == 0 {\r\n\t\tfmt.Printf(\"Model '%s' is valid.\\n\", name)\r\n\t} else {\r\n\t\tfmt.Printf(\"Model '%s' has %d validation error(s):\\n\", name, len(errors))\r\n\t\tfor i, e := range errors {\r\n\t\t\tfmt.Printf(\"  %d. %s\\n\", i+1, e)\r\n"]
[12624.768948, "o", "\t\t}\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc validateModel(modelDir string) []string {\r\n\tvar errors []string\r\n\r\n\tmetaPath := filepath.Join(modelDir, \"model.meta\")\r\n\tif _, err := os.Stat(metaPath); err != nil {\r\n\t\terrors = append(errors, \"missing model.meta\")\r\n\t} else {\r\n\t\tmeta, err := loadModelMeta(modelDir)\r\n"]
[12624.769017, "o", "\t\tif err != nil {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse model.meta: %v\", err))\r\n\t\t} else {\r\n\t\t\tif meta[\"name\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'name' field\")\r\n\t\t\t}\r\n\t\t\tif meta[\"type\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'type' field\")\r\n\t\t\t}\r\n\t\t\tif meta[\"features\"] == \"\" {\r\n"]
[12624.769089, "o", "\t\t\t\terrors = append(errors, \"model.meta: missing 'features' field\")\r\n\t\t\t}\r\n\t\t\tif meta[\"outputs\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'outputs' field\")\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tweightsPath := filepath.Join(modelDir, \"weights.bin\")\r\n\tif _, err := os.Stat(weightsPath); err != nil {\r\n\t\terrors = append(errors, \"missing weights.bin\")\r\n"]
[12624.769158, "o", "\t} else {\r\n\t\t_, err := loadWeights(modelDir)\r\n\t\tif err != nil {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse weights.bin: %v\", err))\r\n\t\t}\r\n\t}\r\n\r\n\tcfgPath := filepath.Join(modelDir, \"pipeline.cfg\")\r\n\tif _, err := os.Stat(cfgPath); err != nil {\r\n\t\terrors = append(errors, \"missing pipeline.cfg\")\r\n\t"]
[12624.769231, "o", "} else {\r\n\t\t_, err := loadPipelineConfig(modelDir)\r\n\t\tif err != nil {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse pipeline.cfg: %v\", err))\r\n\t\t}\r\n"]
[12624.769302, "o", "\t}\r\n\r\n\treturn errors\r\n}\r\n"]
