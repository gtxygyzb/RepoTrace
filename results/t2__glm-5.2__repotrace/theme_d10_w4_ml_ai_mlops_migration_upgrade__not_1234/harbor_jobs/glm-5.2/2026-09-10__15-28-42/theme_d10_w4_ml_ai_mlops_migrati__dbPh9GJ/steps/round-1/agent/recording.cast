[6199.026609, "i", "nl -ba commands_extra.go | sed -n '126,235p'\n"]
[6199.027024, "o", "nl -ba commands_extra.go | sed -n '126,235p'\r\n\u001b[?2004l\r"]
[6199.030722, "o", "   126\t\tvar stats []colStat\r\n   127\t\tnumericCols := make([]int, 0)\r\n   128\t\tvaluesByCol := make(map[int][]float64)\r\n   129\t\tvar skippedCols []string\r\n"]
[6199.03081, "o", "   130\t\r\n   131\t\tfor j := 0; j < numCols; j++ {\r\n   132\t\t\tvalues := make([]float64, 0, len(records)-start)\r\n   133\t\t\tmissing := 0\r\n   134\t\t\tnumeric := true\r\n   135\t\r\n   136\t\t\tfor i := start; i < len(records); i++ {\r\n   137\t\t\t\traw := \"\"\r\n   138\t\t\t\tif j < len(records[i]) {\r\n   139\t\t\t\t\traw = strings.TrimSpace(records[i][j])\r\n   140\t\t\t\t}\r\n   141\t\t\t\tif isMissingValue(raw) {\r\n"]
[6199.030889, "o", "   142\t\t\t\t\tmissing++\r\n   143\t\t\t\t\tvalues = append(values, math.NaN())\r\n   144\t\t\t\t\tcontinue\r\n   145\t\t\t\t}\r\n   146\t\t\t\tv, err := strconv.ParseFloat(raw, 64)\r\n   147\t\t\t\tif err != nil {\r\n   148\t\t\t\t\tnumeric = false\r\n   149\t\t\t\t\tbreak\r\n"]
[6199.030958, "o", "   150\t\t\t\t}\r\n   151\t\t\t\tvalues = append(values, v)\r\n   152\t\t\t}\r\n   153\t\r\n   154\t\t\tif !numeric {\r\n   155\t\t\t\tcontinue\r\n"]
[6199.031025, "o", "   156\t\t\t}\r\n   157\t\r\n   158\t\t\tcount := len(values) - missing\r\n   159\t\t\tst := colStat{\r\n   160\t\t\t\tidx:     j,\r\n   161\t\t\t\tname:    headers[j],\r\n   162\t\t\t\tcount:   count,\r\n   163\t\t\t\tmissing: missing,\r\n   164\t\t\t\tmin:     math.NaN(),\r\n   165\t\t\t\tmax:     math.NaN(),\r\n   166\t\t\t\tmean:    math.NaN(),\r\n   167\t"]
[6199.031085, "o", "\t\t\tstddev:  math.NaN(),\r\n   168\t\t\t\tvalues:  values,\r\n   169\t\t\t}\r\n   170\t\r\n   171\t\t\tif count > 0 {\r\n   172\t\t\t\tsum := 0.0\r\n   173\t\t\t\tsumSq := 0.0\r\n   174\t\t\t\tminVal := math.Inf(1)\r\n   175\t\t\t\tmaxVal := math.Inf(-1)\r\n"]
[6199.031144, "o", "   176\t\t\t\tfor _, v := range values {\r\n   177\t\t\t\t\tif math.IsNaN(v) {\r\n   178\t\t\t\t\t\tcontinue\r\n   179\t\t\t\t\t}\r\n   180\t\t\t\t\tif v < minVal {\r\n   181\t\t\t\t\t\tminVal = v\r\n   182\t\t\t\t\t}\r\n   183\t\t\t\t\tif v > maxVal {\r\n   184\t\t\t\t\t\tmaxVal = v\r\n"]
[6199.031202, "o", "   185\t\t\t\t\t}\r\n   186\t\t\t\t\tsum += v\r\n   187\t\t\t\t\tsumSq += v * v\r\n   188\t\t\t\t}\r\n   189\t\t\t\tmean := sum / float64(count)\r\n   190\t\t\t\tvariance := sumSq/float64(count) - mean*mean\r\n   191\t\t\t\tif variance < 0 {\r\n   192\t\t\t\t\tvariance = 0\r\n   193\t\t\t\t}\r\n"]
[6199.031265, "o", "   194\t\t\t\tst.min = minVal\r\n   195\t\t\t\tst.max = maxVal\r\n   196\t\t\t\tst.mean = mean\r\n   197\t\t\t\tst.stddev = math.Sqrt(variance)\r\n   198\t\t\t}\r\n   199\t\r\n   200\t\t\tstats = append(stats, st)\r\n   201\t\t\tnumericCols = append(numericCols, j)\r\n   202\t\t\tvaluesByCol[j] = values\r\n   203\t\t}\r\n   204"]
[6199.031329, "o", "\t\r\n   205\t\tif len(skippedCols) > 0 {\r\n   206\t\t\tfmt.Printf(\"warning: skipping non-numeric columns: %s\\n\", strings.Join(skippedCols, \", \"))\r\n   207\t\t}\r\n   208\t\tif len(numericCols) == 0 {\r\n   209\t\t\tfmt.Println(\"error: no numeric columns found\")\r\n   210\t\t\tos.Exit(1)\r\n   211\t\t}\r\n   212\t\r\n   213\t\t"]
