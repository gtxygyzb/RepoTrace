[12050.186215, "o", "    52\t\tif len(args) < 1 || strings.HasPrefix(args[0], \"--\") {\r\n    53\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>] [--weights <w1,w2,...>]\\n\")\r\n    54\t\t\tos.Exit(1)\r\n    55\t\t}\r\n    56\t\tname := args[0]\r\n    57\t\r\n    58\t\tmodelsStr := flags[\"models\"]\r\n    59\t\tif modelsStr == \"\" || modelsStr == \"true\" {\r\n    60\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>] [--weights <w1,w2,...>]\\n\")\r\n    61\t\t\tos.Exit(1)\r\n    62\t\t}\r\n    63\t\r\n    64\t\tstrategy := flags[\"strategy\"]\r\n"]
