[2015.555204, "o", "    14\ttype RegistryEntry struct {\r\n    15\t\tName    string\r\n    16\t\tPath    string\r\n    17\t\tType    string\r\n    18\t\tVersion int\r\n    19\t\tCreated string\r\n    20\t}\r\n    21\t\r\n    22\tfunc loadRegistry() ([]RegistryEntry, error) {\r\n    23\t\tf, err := os.Open(registryFile)\r\n    24\t\tif err != nil {\r\n    25\t\t\tif os.IsNotExist(err) {\r\n    26\t\t\t\treturn nil, nil\r\n    27\t\t\t}\r\n    28\t\t\treturn nil, err\r\n    29\t\t}\r\n    30"]
[2015.555268, "o", "\t\tdefer f.Close()\r\n    31\t\r\n    32\t\tvar entries []RegistryEntry\r\n    33\t\tscanner := bufio.NewScanner(f)\r\n    34\t\tfor scanner.Scan() {\r\n    35\t\t\tline := strings.TrimSpace(scanner.Text())\r\n    36\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    37\t\t\t\tcontinue\r\n"]
[2015.555321, "o", "    38\t\t\t}\r\n    39\t\t\tparts := strings.Split(line, \"|\")\r\n    40\t\t\tif len(parts) != 5 {\r\n"]
[2015.555373, "o", "    41\t\t\t\tcontinue\r\n    42\t\t\t}\r\n    43\t\t\tver := 1\r\n    44\t\t\tfmt.Sscanf(parts[3], \"%d\", &ver)\r\n    45\t\t\tentries = append(entries, RegistryEntry{\r\n    46\t\t\t\tName:    parts[0],\r\n    47\t\t\t\tPath:    parts[1],\r\n    48\t\t\t\tType:    parts[2],\r\n    49\t\t\t\tVersion: ver,\r\n    50\t\t\t\tCreated: parts[4],\r\n"]
[2015.555427, "o", "    51\t\t\t})\r\n    52\t\t}\r\n    53\t\treturn entries, scanner.Err()\r\n    54\t}\r\n    55\t\r\n    56\tfunc saveRegistry(entries []RegistryEntry) error {\r\n    57\t\tdir := filepath.Dir(registryFile)\r\n    58\t\t"]
