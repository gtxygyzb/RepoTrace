[2416.663324, "o", "\u001b[?2004h"]
[2416.663342, "o", "> "]
[2416.663788, "o", "\\t\\treturn nil, fmt.Errorf(\"failed to read num_features: %v\", err)\r\n\u001b[?2004l\r"]
[2416.663857, "o", "\u001b[?2004h> "]
