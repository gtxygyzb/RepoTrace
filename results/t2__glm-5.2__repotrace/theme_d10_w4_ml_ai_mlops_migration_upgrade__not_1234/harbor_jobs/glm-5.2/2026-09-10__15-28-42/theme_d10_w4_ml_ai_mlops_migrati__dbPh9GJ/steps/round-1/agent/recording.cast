[3218.343903, "o", "echo '===== main.go ====='; sed -n '1,260p' main.go\r\n\u001b[?2004l\r"]
[3218.344021, "o", "===== main.go =====\r\n"]
[3218.346964, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n)\r\n"]
[3218.347042, "o", "\r\nconst version = \"0.1.0\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcommand := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch command {\r\n\tcase \"list\":\r\n\t\tcmdList(args)\r\n\tcase \"info\":\r\n\t\tcmdInfo(args)"]
[3218.347111, "o", "\r\n\tcase \"register\":\r\n\t\tcmdRegister(args)\r\n\tcase \"remove\":\r\n\t\tcmdRemove(args)\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"stats\":\r\n\t\tcmdStats(args)\r\n\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n\tcase \"batch\":\r\n"]
[3218.347172, "o", "\t\tcmdBatch(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"export\":\r\n\t\tcmdExport(args)\r\n\tcase \"migrate\":\r\n\t\tcmdMigrate(args)\r\n\tcase \"compat\":\r\n\t\tcmdCompat(args)"]
[3218.347229, "o", "\r\n\tcase \"version\":\r\n\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n\tcase \"help\":\r\n\t\tprintUsage()\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n\t\tprintUsage()\r\n\t"]
[3218.347292, "o", "\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc printUsage() {\r\n\tusage := `mlpipe - ML Inference Pipeline Manager\r\n\r\nUsage: mlpipe <command> [arguments]\r\n\r\nCommands:\r\n  list                          List all registered models\r\n  info <model>                  Show model details\r\n  register <name> <path>        Register a model from directory\r\n"]
[3218.34736, "o", "  remove <name>                 Remove a model from registry\r\n  run <model> [options]         Run inference\r\n  stats --input <file>          Input statistics profiling\r\n  diff <model1> <model2> --input <file>\r\n                                Compare two models on same input\r\n  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n                                Batch inference over CSV files\r\n"]
[3218.347435, "o", "  validate <model>              Validate model integrity\r\n  export <model> --output <dir> Export model to directory\r\n  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n  compat [--all]                 Check migration compatibility\r\n  version                       Show version\r\n  help                          Show this help\r\n\r\nRun/Diff Options:\r\n  --input <file>    Input CSV file (required)\r\n  --output <file>   Output file (default: stdout)\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n\r\nBatch Options:\r\n  --dir <dir>       Input directory of CSV files\r\n  --output-dir <dir> Output directory for predictions\r\n"]
[3218.3475, "o", "  --format <fmt>    Output format: csv or json (default: csv)\r\n`\r\n\tfmt.Print(usage)\r\n}\r\n\r\nfunc parseFlags(args []string) map[string]string {\r\n\tflags := make(map[string]string)\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tif strings.HasPrefix(args[i], \"--\") {\r\n\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n"]
[3218.347612, "o", "\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n\t\t\t\tflags[key] = args[i+1]\r\n\t\t\t\ti++\r\n\t\t\t} else {\r\n\t\t\t\tflags[key] = \"true\"\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn flags\r\n}\r\n"]
[3218.348058, "o", "\u001b[?2004h"]
