[11351.646222, "o", "\t\t\tcmdRegister(args)\r\n    29\t\tcase \"remove\":\r\n    30\t\t\tcmdRemove(args)\r\n    31\t\tcase \"tag\":\r\n    32\t\t\tcmdTag(args)\r\n"]
[11351.646286, "o", "    33\t\tcase \"untag\":\r\n    34\t\t\tcmdUntag(args)\r\n    35\t\tcase \"search\":\r\n    36\t\t\tcmdSearch(args)\r\n    37\t\tcase \"run\":\r\n    38\t\t\tcmdRun(args)\r\n    39\t\tcase \"stats\":\r\n    40\t\t\tcmdStats(args)\r\n    41\t\tcase \"diff\":\r\n    42\t\t\tcmdDiff(args)\r\n"]
