[4007.57637, "o", "    27\t\tif !modelDirExists(entry.Path) {\r\n    28\t\t\tfmt.Fprintf(os.Stderr, \"error: model directory not found\\n\")\r\n    29\t\t\tos.Exit(1)\r\n    30\t\t}\r\n    31\t\r\n    32\t\terrors := validateModel(entry.Path)\r\n    33\t\tif len(errors) == 0 {\r\n    34\t\t\tfmt.Printf(\"Model '%s' is valid.\\n\", name)\r\n    35\t\t} else {\r\n    36\t\t\tfmt.Printf(\"Model '%s' has %d validation error(s):\\n\", name, len(errors))\r\n    37\t\t\tfor i, e := range errors {\r\n    38\t\t\t\tfmt.Printf(\"  %d. %s\\n\", i+1, e)\r\n    39\t\t\t}\r\n    40\t\t\tos.Exit(1)\r\n    41\t\t}\r\n    42\t}\r\n    43\t\r\n    44\tfunc validateModel(modelDir string) []string {\r\n    45\t\tvar errors []string\r\n    46\t\r\n    47\t\tmetaPath := filepath.Join(modelDir, \"model.meta\")\r\n    48"]
[4007.576447, "o", "\t\tif _, err := os.Stat(metaPath); err != nil {\r\n    49\t\t\terrors = append(errors, \"missing model.meta\")\r\n    50\t\t} else {\r\n    51\t\t\tmeta, err := loadModelMeta(modelDir)\r\n    52\t\t\tif err != nil {\r\n    53\t\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse model.meta: %v\", err))\r\n    54\t\t\t} else {\r\n    55\t\t\t\tif meta[\"name\"] == \"\" {\r\n    56\t\t\t\t\terrors = append(errors, \"model.meta: missing 'name' field\")\r\n    57\t\t\t\t}\r\n"]
[4007.576518, "o", "    58\t\t\t\tif meta[\"type\"] == \"\" {\r\n    59\t\t\t\t\terrors = append(errors, \"model.meta: missing 'type' field\")\r\n    60\t\t\t\t}\r\n    61\t\t\t\tif meta[\"features\"] == \"\" {\r\n    62\t\t\t\t\terrors = append(errors, \"model.meta: missing 'features' field\")\r\n    63\t\t\t\t}\r\n    64\t\t\t\tif meta[\"outputs\"] == \"\" {\r\n    65\t\t\t\t\terrors = append(errors, \"model.meta: missing 'outputs' field\")\r\n    66\t\t\t\t}\r\n    67\t\t\t}\r\n"]
