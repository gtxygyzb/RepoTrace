[4704.14132, "o", "modelType = \"unknown\"\r\n}\r\n\r\nentries = append(entries, RegistryEntry{\r\nName:    name,\r\nPath:    absPath,\r\nType:    modelType,\r\nVersion: 1,\r\nCreated: time.Now().Format(\"2006-01-02\"),\r\nTags:    []string{},"]
[4704.141419, "o", "\r\n})\r\n\r\nif err := saveRegistry(entries); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\nfmt.Printf(\"Model '%s' registered successfully.\\n\", name)\r\n}\r\n\r\nfunc cmdRemove(args []string) {\r\nif len(args) < 1 {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe remove <name>\\n\")\r\nos.Exit(1)\r\n}\r\nname := args[0]\r\n\r\nentries, err := loadRegistry()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\n"]
[4704.141505, "o", "found := false\r\nvar newEntries []RegistryEntry\r\nfor _, e := range entries {\r\nif e.Name == name {\r\nfound = true\r\n} else {\r\nnewEntries = append(newEntries, e)\r\n}\r\n}\r\n\r\nif !found {\r\nfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\nos.Exit(1)\r\n}\r\n\r\nif err := saveRegistry(newEntries); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n"]
[4704.141587, "o", "fmt.Printf(\"Model '%s' removed.\\n\", name)\r\n}\r\n\r\nfunc isValidTag(tag string) bool {\r\nif tag == \"\" {\r\nreturn false\r\n}\r\nfor _, c := range tag {\r\nisLower := c >= 'a' && c <= 'z'\r\nisDigit := c >= '0' && c <= '9'\r\nisHyphen := c == '-'\r\nif !(isLower || isDigit || isHyphen) {\r\nreturn false\r\n}\r\n}\r\nreturn true\r\n}\r\n"]
[4704.141665, "o", "\r\nfunc hasTag(entry *RegistryEntry, tag string) bool {\r\nfor _, t := range entry.Tags {\r\nif t == tag {\r\nreturn true\r\n}\r\n}\r\nreturn false\r\n}\r\n\r\nfunc cmdTag(args []string) {\r\nif len(args) < 2 {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe tag <model> <tag>\\n\")\r\nos.Exit(1)\r\n}\r\nname := args[0]\r\ntag := args[1]\r\n\r\nif !isValidTag(tag) {\r\nfmt.Fprintf(os.Stderr, \"error: invalid tag '%s'\\n\", tag)\r\nos.Exit(1)\r\n"]
[4704.141742, "o", "}\r\n\r\nentries, err := loadRegistry()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\nentry := findEntry(entries, name)\r\nif entry == nil {\r\nfmt.Fprintln(os.Stderr, \"not found\")\r\nos.Exit(1)\r\n}\r\n\r\nif hasTag(entry, tag) {\r\nreturn\r\n}\r\n\r\n"]
[4704.141865, "o", "entry.Tags = append(entry.Tags, tag)\r\nsort.Strings(entry.Tags)\r\n\r\nif err := saveRegistry(entries); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\nfmt.Printf(\"tagged '%s' with '%s'\\n\", name, tag)\r\n}\r\n\r\nfunc cmdUntag(args []string) {\r\nif len(args) < 2 {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe untag <model> <tag>\\n\")\r\nos.Exit(1)\r\n}\r\nname := args[0]\r\ntag := args[1]\r\n\r\nentries, err := loadRegistry()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n"]
[4704.141945, "o", "\r\nentry := findEntry(entries, name)\r\nif entry == nil {\r\nfmt.Fprintln(os.Stderr, \"not found\")\r\nos.Exit(1)\r\n}\r\n\r\nidx := -1\r\nfor i, t := range entry.Tags {\r\nif t == tag {\r\nidx = i\r\nbreak\r\n}\r\n}\r\nif idx < 0 {\r\nfmt.Fprintln(os.Stderr, \"tag not found\")\r\nos.Exit(1)\r\n"]
[4704.142023, "o", "}\r\n\r\nentry.Tags = append(entry.Tags[:idx], entry.Tags[idx+1:]...)\r\nif entry.Tags == nil {\r\nentry.Tags = []string{}\r\n}\r\n\r\nif err := saveRegistry(entries); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\nfmt.Printf(\"removed tag '%s' from '%s'\\n\", tag, name)\r\n}\r\n\r\n"]
[4704.142101, "o", "func cmdSearch(args []string) {\r\nflags := parseFlags(args)\r\n\r\nvar tagFilter, nameFilter string\r\nhasTagFilter, hasNameFilter := false, false\r\n\r\nif v, ok := flags[\"tag\"]; ok {\r\nif v == \"true\" {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe search [--tag <tag>] [--name <pattern>]\\n\")\r\nos.Exit(1)\r\n}\r\ntagFilter = v\r\nhasTagFilter = true\r\n}\r\nif v, ok := flags[\"name\"]; ok {\r\nif v == \"true\" {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe search [--tag <tag>] [--name <pattern>]\\n\")\r\nos.Exit(1)\r\n}"]
[4704.142179, "o", "\r\nnameFilter = v\r\nhasNameFilter = true\r\n}\r\n\r\nentries, err := loadRegistry()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\nvar names []string\r\nfor _, e := range entries {\r\nif hasNameFilter && !strings.Contains(strings.ToLower(e.Name), strings.ToLower(nameFilter)) {\r\ncontinue\r\n}\r\nif hasTagFilter {\r\nfound := false\r\n"]
[4704.142302, "o", "for _, t := range e.Tags {\r\nif t == tagFilter {\r\nfound = true\r\nbreak\r\n}\r\n}\r\nif !found {\r\ncontinue\r\n}\r\n}\r\nnames = append(names, e.Name)\r\n}\r\n\r\nsort.Strings(names)\r\nfor _, name := range names {\r\nfmt.Println(name)\r\n}\r\n}\r\n"]
