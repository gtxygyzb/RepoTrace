[289.386222, "o", "   226\t\t}\r\n   227\t\treturn minVal, maxVal\r\n   228\t}\r\n   229\t\r\n   230\tfunc writeOutput(f *os.File, results [][]float64, format string) {\r\n   231\t\tswitch format {\r\n   232\t\tcase \"csv\":\r\n   233\t\t\twriter := csv.NewWriter(f)\r\n   234\t\t\theader := make([]string, len(results[0]))\r\n   235\t\t\tfor i := range header {\r\n"]
[289.38629, "o", "   236\t\t\t\theader[i] = fmt.Sprintf(\"output_%d\", i)\r\n   237\t\t\t}\r\n   238\t\t\twriter.Write(header)\r\n   239\t\t\tfor _, row := range results {\r\n   240\t\t\t\trecord := make([]string, len(row))\r\n   241"]
[289.386353, "o", "\t\t\t\tfor j, val := range row {\r\n   242\t\t\t\t\trecord[j] = strconv.FormatFloat(val, 'f', -1, 64)\r\n   243\t\t\t\t}\r\n   244\t\t\t\twriter.Write(record)\r\n   245\t\t\t}\r\n   246\t\t\twriter.Flush()\r\n   247\t\tcase \"json\":\r\n   248\t\t\ttype Prediction struct {\r\n   249\t\t\t\tOutputs []float64 `json:\"outputs\"`\r\n   250\t\t\t}\r\n   251\t\t\ttype Result struct {\r\n   252\t\t\t\tPredictions []Prediction `json:\"predictions\"`\r\n   253"]
[289.386417, "o", "\t\t\t}\r\n   254\t\t\tr := Result{}\r\n   255\t\t\tfor _, row := range results {\r\n   256\t\t\t\tr.Predictions = append(r.Predictions, Prediction{Outputs: row})\r\n   257\t\t\t}\r\n   258\t\t\tenc := json.NewEncoder(f)\r\n   259\t\t\tenc.SetIndent(\"\", \"  \")\r\n   260\t\t\tenc.Encode(r)\r\n   261\t\t}\r\n   262\t}\r\n"]
