[5283.410236, "o", "# Patch callers that print resolveModel errors as \"error: %v\"\r\n\u001b[?2004l\r"]
[5283.410306, "o", "\u001b[?2004h> "]
[5283.410673, "o", "for fn in ['export_import.go', 'inference.go', 'commands_extra.go']:\r\n\u001b[?2004l\r"]
[5283.410727, "o", "\u001b[?2004h> "]
[5283.410845, "o", "    p = Path(fn)\r\n\u001b[?2004l\r"]
[5283.410904, "o", "\u001b[?2004h> "]
[5283.411047, "o", "    s = p.read_text()\r\n\u001b[?2004l\r"]
[5283.411122, "o", "\u001b[?2004h> "]
[5283.411702, "o", "    s = s.replace('fmt.Fprintf(os.Stderr, \"error: %v\\\\n\", err)', 'fmt.Fprintf(os.Stderr, \"not found\\\\n\")')\r\n\u001b[?2004l\r"]
[5283.411781, "o", "\u001b[?2004h> "]
[5283.411872, "o", "    p.write_text(s)\r\n\u001b[?2004l\r"]
[5283.41195, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[5283.437592, "o", "  File \"<stdin>\", line 6\r\n    s = s.replace('return nil, fmt.Errorf(\"model \\\\'%s\\\\' not found\", name)', 'return nil, fmt.Errorf(\"not found\")')\r\n                                                       ^\r\nSyntaxError: unexpected character after line continuation character\r\n"]
