[4656.298241, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n"]
[4656.298348, "o", ")\r\n\r\nconst version = \"0.1.0\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcommand := os.Args[1]\r\n\targs := os.Args[2:]\r\n"]
[4656.298417, "o", "\r\n\tswitch command {\r\n\tcase \"list\":\r\n\t\tcmdList(args)\r\n\tcase \"info\":\r\n\t\tcmdInfo(args)\r\n\tcase \"register\":\r\n\t\tcmdRegister(args)\r\n\tcase \"remove\":\r\n\t\tcmdRemove(args)\r\n\tcase \"tag\":\r\n\t\tcmdTag(args)\r\n\tcase \"untag\":\r\n\t\tcmdUntag(args)\r\n\tcase \"search\":\r\n\t\tcmdSearch(args)\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"stats\":\r\n"]
[4656.298494, "o", "\t\tcmdStats(args)\r\n\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n\tcase \"batch\":\r\n\t\tcmdBatch(args)\r\n"]
[4656.298556, "o", "\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"export\":\r\n\t\tcmdExport(args)\r\n\tcase \"import\":\r\n\t\tcmdImport(args)\r\n\tcase \"clone\":\r\n\t\tcmdClone(args)\r\n\tcase \"migrate\":\r\n\t\tcmdMigrate(args)\r\n\tcase \"compat\":\r\n\t\tcmdCompat(args)\r\n\tcase \"version\":\r\n\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n\tcase \"help\":\r\n\t\tprintUsage()\r\n"]
[4656.298619, "o", "\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n"]
[4656.298678, "o", "\r\nfunc printUsage() {\r\n\tusage := `mlpipe - ML Inference Pipeline Manager\r\n\r\nUsage: mlpipe <command> [arguments]\r\n\r\n"]
[4656.299155, "o", "\u001b[?2004h"]
