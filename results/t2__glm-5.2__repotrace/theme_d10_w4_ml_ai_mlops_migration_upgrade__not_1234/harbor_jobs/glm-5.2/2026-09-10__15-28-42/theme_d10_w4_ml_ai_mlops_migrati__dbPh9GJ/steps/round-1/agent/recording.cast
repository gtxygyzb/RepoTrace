[13292.009877, "o", "}\r\n\r\nconst (\r\n\tactivationNone    = 0\r\n\tactivationSigmoid = 1\r\n\tactivationReLU    = 2\r\n\tactivationTanh    = 3\r\n)\r\n\r\nfunc activationNameToID(name string) (uint32, error) {\r\n\tswitch strings.ToLower(name) {\r\n\tcase \"\", \"none\":\r\n\t\treturn activationNone, nil\r\n\tcase \"sigmoid\":\r\n\t\treturn activationSigmoid, nil\r\n\tcase \"relu\":\r\n\t\treturn activationReLU, nil\r\n"]
[13292.010061, "o", "\tcase \"tanh\":\r\n\t\treturn activationTanh, nil\r\n\tdefault:\r\n\t\treturn 0, fmt.Errorf(\"invalid activation\")\r\n\t}\r\n}\r\n\r\nfunc activationIDToName(id uint32) string {\r\n\tswitch id {\r\n\tcase activationNone:\r\n\t\treturn \"none\"\r\n\tcase activationSigmoid:\r\n\t\treturn \"sigmoid\"\r\n\tcase activationReLU:\r\n\t\treturn \"relu\"\r\n\tcase activationTanh:\r\n\t\treturn \"tanh\"\r\n\tdefault:\r\n\t\treturn \"unknown\"\r\n\t}\r\n}\r\n\r\nfunc applyActivation(x float64, activation uint32) float64 {\r\n\tswitch activation {\r\n\tcase activationSigmoid:\r\n\t\treturn 1.0 / (1.0 + math.Exp(-x))\r\n\tcase activationReLU:\r\n\t\tif x < 0 {\r\n"]
[13292.01016, "o", "\t\t\treturn 0\r\n\t\t}\r\n\t\treturn x\r\n\tcase activationTanh:\r\n\t\treturn math.Tanh(x)\r\n\tdefault:\r\n\t\treturn x\r\n\t}\r\n}\r\n\r\nfunc saveModelMeta(modelDir string, meta map[string]string) error {\r\n\tf, err := os.Create(filepath.Join(modelDir, \"model.meta\"))\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n"]
[13292.010255, "o", "\tdefer f.Close()\r\n\r\n\tkeys := make([]string, 0, len(meta))\r\n\tfor k := range meta {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n\tsort.Strings(keys)\r\n\tfor _, k := range keys {\r\n\t\tfmt.Fprintf(f, \"%s=%s\\n\", k, meta[k])\r\n\t}\r\n\treturn nil\r\n}\r\n\r\ntype PipelineConfig struct {\r\n\tNormalize       bool\r\n\tScaleMin        float64\r\n\tScaleMax        float64\r\n\tMissingStrategy string\r\n\tRoundDigits     int\r\n"]
[13292.010314, "o", "\tClipMin         float64\r\n\tClipMax         float64\r\n\tFeatureNames    []string\r\n}\r\n\r\nfunc loadPipelineConfig(modelDir string) (*PipelineConfig, error) {\r\n\tf, err := os.Open(filepath.Join(modelDir, \"pipeline.cfg\"))\r\n"]
