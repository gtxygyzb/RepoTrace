[1877.060402, "o", "    99\t\t\t}\r\n   100\t\t\trow := make([]float64, len(record))\r\n   101\t\t\tfor j, val := range record {\r\n   102\t\t\t\tval = strings.TrimSpace(val)\r\n   103\t\t\t\tif val == \"\" || val == \"NA\" || val == \"nan\" {\r\n   104\t\t\t\t\trow[j] = math.NaN()\r\n   105\t\t\t\t} else {\r\n   106\t\t\t\t\trow[j], err = strconv.ParseFloat(val, 64)\r\n"]
[1877.060455, "o", "   107\t\t\t\t\tif err != nil {\r\n   108\t\t\t\t\t\treturn nil, fmt.Errorf(\"row %d col %d: %v\", i, j, err)\r\n   109\t\t\t\t\t}\r\n   110\t\t\t\t}\r\n   111\t\t\t}\r\n   112\t\t\tdata = append(data, row)\r\n   113\t\t}\r\n   114"]
[1877.060507, "o", "\t\treturn data, nil\r\n   115\t}\r\n   116\t\r\n"]
[1877.06056, "o", "   117\tfunc isHeader(record []string) bool {\r\n   118\t\tfor _, val := range record {\r\n   119\t\t\t_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)\r\n   120\t\t\tif err == nil {\r\n   121\t\t\t\treturn false\r\n   122\t\t\t}\r\n   123\t\t}\r\n"]
[1877.060586, "o", "   124\t\treturn true\r\n   125\t}\r\n   126\t\r\n   127\tfunc runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n   128\t\tprocessed := preprocess(inputs, cfg)\r\n   129\t\r\n   130\t\tresults := make([][]float64, len(processed))\r\n   131\t\tfor i, row := range processed {\r\n   132\t\t\toutput := make([]float64, weights.NumOutputs)\r\n"]
[1877.060655, "o", "   133\t\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n   134\t\t\t\tsum := weights.Bias[o]\r\n   135\t\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n   136\t\t\t\t\tif int(f) < len(row) {\r\n   137\t\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n   138\t\t\t\t\t}\r\n   139\t\t\t\t}\r\n   140\t\t\t\toutput[o] = sum\r\n"]
[1877.060704, "o", "   141\t\t\t}\r\n   142\t\t\tresults[i] = output\r\n   143\t\t}\r\n"]
[1877.06076, "o", "   144\t\r\n   145\t\treturn postprocess(results, cfg)\r\n   146\t}\r\n   147\t\r\n   148\tfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   149\t\tresult := make([][]float64, len(inputs))\r\n   150\t\tfor i, row := range inputs {\r\n   151\t\t\tresult[i] = make([]float64, len(row))\r\n   152\t\t\tcopy(result[i], row)\r\n   153\t\t}\r\n   154\t\r\n   155\t\tif len(result) == 0 {\r\n   156\t\t\treturn result\r\n   157\t\t}\r\n"]
[1877.060822, "o", "   158\t\r\n   159\t\tfor i, row := range result {\r\n"]
[1877.060843, "o", "   160\t\t\tfor j, val := range row {\r\n   161\t\t\t\tif math.IsNaN(val) {\r\n   162\t\t\t\t\tswitch cfg.MissingStrategy {\r\n   163\t\t\t\t\tcase \"zero\":\r\n   164\t\t\t\t\t\tresult[i][j] = 0.0\r\n   165\t\t\t\t\tcase \"mean\":\r\n"]
[1877.06091, "o", "   166\t\t\t\t\t\tresult[i][j] = computeColumnMean(inputs, j)\r\n   167\t\t\t\t\t}\r\n   168\t\t\t\t}\r\n   169\t\t\t}\r\n   170\t\t}\r\n   171\t\r\n   172\t\tif cfg.Normalize {\r\n   173\t\t\tfor j := 0; j < len(result[0]); j++ {\r\n   174\t\t\t\t"]
[1877.06096, "o", "minVal, maxVal := columnMinMax(result, j)\r\n   175\t\t\t\trangeVal := maxVal - minVal\r\n"]
[1877.061009, "o", "   176\t\t\t\tif rangeVal == 0 {\r\n   177\t\t\t\t\trangeVal = 1.0\r\n   178\t\t\t\t}\r\n   179\t\t\t\tfor i := range result {\r\n   180\t\t\t\t\tnormalized := (result[i][j] - minVal) / rangeVal\r\n   181\t\t\t\t\tresult[i][j] = cfg.ScaleMin + normalized*(cfg.ScaleMax-cfg.ScaleMin)\r\n   182\t\t\t\t}\r\n   183"]
[1877.061063, "o", "\t\t\t}\r\n   184\t\t}\r\n   185\t\r\n   186\t\treturn result\r\n   187\t}\r\n   188\t\r\n   189\tfunc postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   190\t\tfor i, row := range results {\r\n   191\t\t\tfor j, val := range row {\r\n"]
[1877.061116, "o", "   192\t\t\t\tval = math.Max(val, cfg.ClipMin)\r\n   193\t\t\t\tval = math.Min(val, cfg.ClipMax)\r\n   194\t\t\t\tresults[i][j] = roundToDigits(val, cfg.RoundDigits)\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197\t\treturn results\r\n   198\t}\r\n"]
[1877.061169, "o", "   199\t\r\n   200\tfunc computeColumnMean(data [][]float64, col int) float64 {\r\n   201\t\tsum := 0.0\r\n   202\t\tcount := 0\r\n   203\t\tfor _, row := range data {\r\n   204\t\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n   205\t\t\t\tsum += row[col]\r\n   206\t\t\t\tcount++\r\n"]
[1877.061218, "o", "   207\t\t\t}\r\n   208\t\t}\r\n   209\t\tif count == 0 {\r\n   210\t\t\treturn 0.0\r\n   211\t\t}\r\n   212\t"]
[1877.061243, "o", "\treturn sum / float64(count)\r\n   213\t}\r\n   214\t\r\n   215\tfunc columnMinMax(data [][]float64, col int) (float64, float64) {\r\n   216\t\tminVal := math.Inf(1)\r\n   217\t\tmaxVal := math.Inf(-1)\r\n   218\t\tfor _, row := range data {\r\n   219\t\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n   220\t\t"]
