[5921.233835, "o", "\t)\r\n     8\t\r\n     9\tconst version = \"0.1.0\"\r\n    10\t\r\n"]
[5921.233979, "o", "    11\tfunc main() {\r\n    12\t\tif len(os.Args) < 2 {\r\n    13\t\t\tprintUsage()\r\n    14\t\t\tos.Exit(1)\r\n    15\t\t}\r\n    16\t\r\n    17\t\tcommand := os.Args[1]\r\n    18\t\targs := os.Args[2:]\r\n    19\t\r\n    20\t\tswitch command {\r\n    21\t\tcase \"list\":\r\n    22\t\t\tcmdList(args)\r\n    23\t\tcase \"info\":\r\n    24\t\t\tcmdInfo(args)\r\n    25\t\tcase \"register\":\r\n    26\t\t\tcmdRegister(args)\r\n    27\t\tcase \"remove\":\r\n    28\t\t\tcmdRemove(args)\r\n"]
[5921.234046, "o", "    29\t\tcase \"tag\":\r\n    30\t\t\tcmdTag(args)\r\n    31\t\tcase \"untag\":\r\n    32\t\t\tcmdUntag(args)\r\n    33\t\tcase \"search\":\r\n    34\t\t\tcmdSearch(args)\r\n    35\t\tcase \"run\":\r\n    36\t\t\tcmdRun(args)\r\n    37\t\tcase \"stats\":\r\n    38\t\t\tcmdStats(args)\r\n"]
[5921.234114, "o", "    39\t\tcase \"diff\":\r\n    40\t\t\tcmdDiff(args)\r\n    41\t\tcase \"batch\":\r\n    42\t\t\tcmdBatch(args)\r\n    43\t\tcase \"validate\":\r\n    44\t\t\tcmdValidate(args)\r\n    45\t\tcase \"export\":\r\n    46\t\t\tcmdExport(args)\r\n    47\t\tcase \"import\":\r\n    48\t\t\tcmdImport(args)\r\n    49"]
[5921.234179, "o", "\t\tcase \"clone\":\r\n    50\t\t\tcmdClone(args)\r\n    51\t\tcase \"checkpoint\":\r\n    52\t\t\tcmdCheckpoint(args)\r\n    53\t\tcase \"checkpoints\":\r\n    54\t\t\tcmdCheckpoints(args)\r\n    55\t\tcase \"rollback\":\r\n    56\t\t\tcmdRollback(args)\r\n    57\t\tcase \"migrate\":\r\n"]
[5921.234237, "o", "    58\t\t\tcmdMigrate(args)\r\n    59\t\tcase \"compat\":\r\n    60\t\t\tcmdCompat(args)\r\n    61\t\tcase \"version\":\r\n    62\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    63\t\tcase \"help\":\r\n    64\t\t\tprintUsage()\r\n    65\t\tdefault:\r\n"]
[5921.2343, "o", "    66\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    67\t\t\tprintUsage()\r\n    68\t\t\tos.Exit(1)\r\n    69\t\t}\r\n    70\t}\r\n    71\t\r\n    72\tfunc printUsage() {\r\n    73\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    74\t\r\n    75\tUsage: mlpipe <command> [arguments]\r\n    76\t\r\n    77\tCommands:"]
[5921.234364, "o", "\r\n    78\t  list                          List all registered models\r\n    79\t  info <model>                  Show model details\r\n    80\t  register <name> <path>        Register a model from directory\r\n    81\t  remove <name>                 Remove a model from registry"]
[5921.234433, "o", "\r\n    82\t  run <model> [options]         Run inference\r\n    83\t  stats --input <file>          Input statistics profiling\r\n    84\t  diff <model1> <model2> --input <file>\r\n    85\t                                Compare two models on same input\r\n    86\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n    87\t                                Batch inference over CSV files\r\n    88\t  validate <model>              Validate model integrity\r\n    89\t  export <model> --output <file> Export model to JSON file\r\n    90\t  import <path> [--name <name>] Import model from JSON file\r\n    91\t  clone <model> <new_name>      Clone model to new name\r\n    92\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n    93\t  compat [--all]                 Check migration compatibility\r\n    94\t  version                       Show version\r\n    95\t  help                          Show this help\r\n    96\t\r\n"]
[5921.234495, "o", "    97\tRun/Diff Options:\r\n    98\t  --input <file>    Input CSV file (required)\r\n    99\t  --output <file>   Output file (default: stdout)\r\n   100\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   101\t\r\n   102"]
[5921.234559, "o", "\tBatch Options:\r\n   103\t  --dir <dir>       Input directory of CSV files\r\n   104\t  --output-dir <dir> Output directory for predictions\r\n   105\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   106\t`\r\n   107\t\tfmt.Print(usage)\r\n   108\t}\r\n   109\t\r\n   110\t"]
[5921.234617, "o", "func parseFlags(args []string) map[string]string {\r\n   111\t\tflags := make(map[string]string)\r\n   112\t\tfor i := 0; i < len(args); i++ {\r\n   113\t\t\tif strings.HasPrefix(args[i], \"--\") {\r\n   114\t\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n   115\t\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n   116\t\t\t\t\tflags[key] = args[i+1]\r\n   117\t\t\t\t\ti++\r\n   118\t\t\t\t} else {\r\n   119\t\t\t\t\tflags[key] = \"true\"\r\n   120\t\t\t\t}\r\n"]
