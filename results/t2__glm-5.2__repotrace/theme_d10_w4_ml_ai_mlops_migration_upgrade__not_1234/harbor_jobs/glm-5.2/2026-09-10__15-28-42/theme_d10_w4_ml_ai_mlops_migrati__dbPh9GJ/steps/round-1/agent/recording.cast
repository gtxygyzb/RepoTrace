[13357.154725, "o", "name := args[0]\r\n    16\t\tflags := parseFlags(args[1:])\r\n    17\t\r\n    18\t\tentries, err := loadRegistry()\r\n    19\t\tif err != nil {\r\n    20\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    21\t\t\tos.Exit(1)\r\n    22\t\t}\r\n    23\t\r\n    24\t\t"]
[13357.154785, "o", "entry := findEntry(entries, name)\r\n    25\t\tif entry == nil {\r\n    26\t\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n    27\t\t\tos.Exit(1)\r\n    28\t\t}\r\n    29\t\r\n    30\t\tif !modelDirExists(entry.Path) {\r\n"]
[13357.154919, "o", "    31\t\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n    32\t\t\tos.Exit(1)\r\n    33\t\t}\r\n    34\t\r\n    35\t\tactivationName := flags[\"activation\"]\r\n    36\t\tif activationName == \"\" {\r\n    37\t\t\tactivationName = \"none\"\r\n    38\t\t}\r\n    39\t\r\n    40\t\tactivationType, err := activationNameToID(activationName)\r\n    41\t\tif err != nil {\r\n    42\t\t\tfmt.Fprintln(os.Stderr, \"invalid activation\")\r\n    43\t\t\tos.Exit(1)\r\n    44\t\t}\r\n    45\t\r\n    46\t\tweights, err := loadWeights(entry.Path)\r\n    47\t\tif err != nil {\r\n"]
