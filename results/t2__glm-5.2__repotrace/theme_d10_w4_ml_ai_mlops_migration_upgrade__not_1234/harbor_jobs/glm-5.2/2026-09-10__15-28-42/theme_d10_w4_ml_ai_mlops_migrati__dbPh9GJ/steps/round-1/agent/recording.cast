[9177.860204, "o", "    85\tvar weights []float64\r\n    86\tif weightsStr := flags[\"weights\"]; weightsStr != \"\" && weightsStr != \"true\" {\r\n    87\tfor _, w := range strings.Split(weightsStr, \",\") {\r\n    88\tw = strings.TrimSpace(w)\r\n    89\tif w == \"\" {\r\n    90\tcontinue\r\n    91\t}\r\n    92\tval, err := strconv.ParseFloat(w, 64)\r\n    93\tif err != nil {\r\n"]
[9177.860261, "o", "    94\tfmt.Println(\"weights must be positive\")\r\n    95\tos.Exit(1)\r\n    96\t}\r\n    97\tif val <= 0 {\r\n    98\tfmt.Println(\"weights must be positive\")\r\n    99\tos.Exit(1)\r\n   100\t}\r\n   101\tweights = append(weights, val)\r\n   102\t}\r\n"]
[9177.860319, "o", "   103\tif len(weights) != len(models) {\r\n   104\tfmt.Println(\"weight count mismatch\")\r\n   105\tos.Exit(1)\r\n   106\t}\r\n   107\t} else {\r\n   108\tweights = make([]float64, len(models))\r\n   109\tfor i := range weights {\r\n   110\tweights[i] = 1.0\r\n   111\t}\r\n   112"]
