[9603.376896, "o", "   146\t\t\t\tv, err := strconv.ParseFloat(raw, 64)\r\n   147\t\t\t\tif err != nil {\r\n   148\t\t\t\t\tnumeric = false\r\n   149\t\t\t\t\tbreak\r\n   150\t\t\t\t}\r\n   151\t\t\t\t"]
