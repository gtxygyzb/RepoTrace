[7543.581455, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n"]
[7543.58154, "o", "     5\t\t\"os\"\r\n     6\t\t\"strings\"\r\n     7\t)\r\n     8\t\r\n     9\tconst version = \"0.1.0\"\r\n    10\t\r\n    11\tfunc main() {\r\n    12\t\tif len(os.Args) < 2 {\r\n    13\t\t\tprintUsage()\r\n    14\t\t\tos.Exit(1)\r\n    15\t\t}\r\n    16\t\r\n    17\t\tcommand := os.Args[1]\r\n"]
[7543.581635, "o", "    18\t\targs := os.Args[2:]\r\n    19\t\r\n    20\t\tswitch command {\r\n    21\t\tcase \"list\":\r\n    22\t\t\tcmdList(args)\r\n    23\t\tcase \"info\":\r\n    24\t\t\tcmdInfo(args)\r\n    25\t\tcase \"register\":\r\n"]
[7543.581696, "o", "    26\t\t\tcmdRegister(args)\r\n    27\t\tcase \"remove\":\r\n    28\t\t\tcmdRemove(args)\r\n    29\t\tcase \"tag\":\r\n    30\t\t\tcmdTag(args)\r\n    31\t\tcase \"untag\":\r\n    32\t\t\tcmdUntag(args)\r\n    33\t\tcase \"search\":\r\n    34\t\t\tcmdSearch(args)\r\n    35\t\tcase \"run\":\r\n    36\t\t\tcmdRun(args)\r\n    37\t\tcase \"stats\":\r\n    38\t\t\tcmdStats(args)\r\n    39\t\tcase \"diff\":\r\n    40\t\t\tcmdDiff(args)\r\n    41\t\tcase \"batch\":\r\n    42\t\t\tcmdBatch(args)\r\n    43\t\tcase \"profile\":"]
[7543.581761, "o", "\r\n    44\t\t\tcmdProfile(args)\r\n    45\t\tcase \"validate\":\r\n    46\t\t\tcmdValidate(args)\r\n    47\t\tcase \"export\":\r\n    48\t\t\tcmdExport(args)\r\n    49\t\tcase \"import\":\r\n    50\t\t\tcmdImport(args)\r\n    51\t\tcase \"clone\":\r\n    52\t\t\tcmdClone(args)\r\n    53\t\tcase \"checkpoint\":\r\n    54\t\t\tcmdCheckpoint(args)\r\n"]
[7543.581849, "o", "    55\t\tcase \"checkpoints\":\r\n    56\t\t\tcmdCheckpoints(args)\r\n    57\t\tcase \"rollback\":\r\n    58\t\t\tcmdRollback(args)\r\n    59\t\tcase \"migrate\":\r\n    60\t\t\tcmdMigrate(args)\r\n    61\t\tcase \"compat\":\r\n    62\t\t\tcmdCompat(args)\r\n    63\t\tcase \"version\":\r\n    64\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    65\t\tcase \"help\":\r\n    66\t\t\tprintUsage()\r\n"]
[7543.581906, "o", "    67\t\tdefault:\r\n    68\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    69\t\t\tprintUsage()\r\n    70\t\t\tos.Exit(1)\r\n    71\t\t}\r\n    72\t}\r\n    73\t\r\n    74\tfunc printUsage() {\r\n    75\t"]
[7543.581964, "o", "\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    76\t\r\n    77\tUsage: mlpipe <command> [arguments]\r\n    78\t\r\n    79\tCommands:\r\n    80\t  list                          List all registered models\r\n"]
