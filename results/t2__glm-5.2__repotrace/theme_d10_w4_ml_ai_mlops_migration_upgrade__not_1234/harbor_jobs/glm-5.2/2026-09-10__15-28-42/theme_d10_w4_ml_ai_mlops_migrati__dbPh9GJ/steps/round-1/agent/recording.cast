[4623.870915, "o", "   159\tfmt.Fprintf(os.Stderr, \"usage: mlpipe info <model>\\n\")\r\n   160\tos.Exit(1)\r\n   161\t}\r\n   162\tname := args[0]\r\n   163\tentries, err := loadRegistry()\r\n   164\tif err != nil {\r\n   165\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   166\tos.Exit(1)\r\n   167\t"]
