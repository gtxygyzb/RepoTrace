[6212.719618, "o", "   165\t\t\t\tmax:     math.NaN(),\r\n   166\t\t\t\tmean:    math.NaN(),\r\n   167\t\t\t\tstddev:  math.NaN(),\r\n   168\t\t\t\tvalues:  values,\r\n   169\t\t\t}\r\n   170\t\r\n   171\t\t\tif count > 0 {\r\n   172\t\t\t\tsum := 0.0\r\n   173\t\t\t\tsumSq := 0.0\r\n   174\t\t\t\tminVal := math.Inf(1)\r\n   175"]
[6212.719682, "o", "\t\t\t\tmaxVal := math.Inf(-1)\r\n   176\t\t\t\tfor _, v := range values {\r\n   177\t\t\t\t\tif math.IsNaN(v) {\r\n   178\t\t\t\t\t\tcontinue\r\n   179\t\t\t\t\t}\r\n   180\t\t\t\t\tif v < minVal {\r\n   181\t\t\t\t\t\tminVal = v\r\n"]
