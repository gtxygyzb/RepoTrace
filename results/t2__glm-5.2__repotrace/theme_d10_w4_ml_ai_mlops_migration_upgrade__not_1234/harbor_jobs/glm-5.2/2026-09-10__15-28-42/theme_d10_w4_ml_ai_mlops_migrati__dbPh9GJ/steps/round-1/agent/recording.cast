[5909.851435, "o", "\tvaluesByCol := make(map[int][]float64)\r\n   129\t\r\n   130\t\tfor j := 0; j < numCols; j++ {\r\n   131\t\t\tvalues := make([]float64, 0, len(records)-start)\r\n   132\t\t\tmissing := 0\r\n   133\t\t\tnumeric := true\r\n   134\t\r\n   135\t\t\tfor i := start; i < len(records); i++ {\r\n   136\t\t\t\traw := \"\"\r\n   137\t\t\t\tif j < len(records[i]) {\r\n   138\t\t\t\t\traw = strings.TrimSpace(records[i][j])\r\n   139\t\t\t\t}\r\n   140\t\t\t\tif isMissingValue(raw) {\r\n   141\t\t\t\t\tmissing++\r\n   142\t\t\t\t\tvalues = append(values, math.NaN())\r\n   143\t\t\t\t\tcontinue"]
