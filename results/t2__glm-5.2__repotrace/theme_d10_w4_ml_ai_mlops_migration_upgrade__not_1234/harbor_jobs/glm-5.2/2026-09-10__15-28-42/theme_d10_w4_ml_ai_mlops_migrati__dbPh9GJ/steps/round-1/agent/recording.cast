[9603.377133, "o", "   173\t\t\t\tsum := 0.0\r\n   174\t\t\t\tsumSq := 0.0\r\n   175\t\t\t\tminVal := math.Inf(1)\r\n   176\t\t\t\tmaxVal := math.Inf(-1)\r\n   177\t\t\t\tfor _, v := range values {\r\n   178\t\t\t\t\tif math.IsNaN(v) {\r\n   179\t\t\t\t\t\tcontinue\r\n   180\t\t\t\t\t}\r\n   181\t\t\t\t\tif v < minVal {\r\n"]
