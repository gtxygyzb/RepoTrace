[6174.117606, "o", "    20\t\tswitch command {\r\n    21\t\tcase \"list\":\r\n    22\t\t\tcmdList(args)\r\n    23\t\tcase \"info\":\r\n    24"]
[6174.117677, "o", "\t\t\tcmdInfo(args)\r\n    25\t\tcase \"register\":\r\n    26\t\t\tcmdRegister(args)\r\n    27\t\tcase \"remove\":\r\n    28\t\t\tcmdRemove(args)\r\n    29\t\tcase \"tag\":\r\n    30\t\t\tcmdTag(args)\r\n    31\t\tcase \"untag\":\r\n    32\t\t\tcmdUntag(args)\r\n    33\t"]
[6174.117746, "o", "\tcase \"search\":\r\n    34\t\t\tcmdSearch(args)\r\n    35\t\tcase \"run\":\r\n    36\t\t\tcmdRun(args)\r\n    37\t\tcase \"stats\":\r\n    38\t\t\tcmdStats(args)\r\n    39\t\tcase \"diff\":\r\n    40\t\t\tcmdDiff(args)\r\n    41\t\t"]
[6174.117851, "o", "case \"batch\":\r\n    42\t\t\tcmdBatch(args)\r\n    43\t\tcase \"profile\":\r\n    44\t\t\tcmdProfile(args)\r\n    45\t\tcase \"validate\":\r\n    46\t\t\tcmdValidate(args)\r\n    47\t\tcase \"export\":\r\n    48\t\t\tcmdExport(args)\r\n    49\t\tcase \"import\":\r\n    50\t\t\tcmdImport(args)\r\n    51\t\tcase \"clone\":\r\n    52\t\t\tcmdClone(args)\r\n    53\t\tcase \"checkpoint\":\r\n    54\t\t\t"]
[6174.11792, "o", "cmdCheckpoint(args)\r\n    55\t\tcase \"checkpoints\":\r\n    56\t\t\tcmdCheckpoints(args)\r\n    57\t\tcase \"rollback\":\r\n    58\t\t\tcmdRollback(args)\r\n    59\t\tcase \"migrate\":\r\n    60\t\t\tcmdMigrate(args)\r\n    61\t\tcase \"compat\":\r\n    62\t\t\tcmdCompat(args)\r\n    63"]
[6174.117981, "o", "\t\tcase \"version\":\r\n    64\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    65\t\tcase \"help\":\r\n    66\t\t\tprintUsage()\r\n    67\t\tdefault:\r\n    68\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    69\t\t\tprintUsage()\r\n    70\t\t\tos.Exit(1)\r\n    72\t}\r\n    73"]
[6174.118039, "o", "\t\r\n    74\tfunc printUsage() {\r\n    75\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    76\t\r\n    77\tUsage: mlpipe <command> [arguments]\r\n    78\t\r\n    79\tCommands:\r\n    80\t  list                          List all registered models\r\n    81"]
[6174.118104, "o", "\t  info <model>                  Show model details\r\n    82\t  register <name> <path>        Register a model from directory\r\n    83\t  remove <name>                 Remove a model from registry\r\n    84\t  run <model> [options]         Run inference\r\n    85\t  stats --input <file>          Input statistics profiling\r\n    86\t  diff <model1> <model2> --input <file>\r\n    87\t                                Compare two models on same input\r\n    88\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n    89\t                                Batch inference over CSV files\r\n    90"]
[6174.118167, "o", "\t  validate <model>              Validate model integrity\r\n    91\t  export <model> --output <file> Export model to JSON file\r\n    92\t  import <path> [--name <name>] Import model from JSON file\r\n    93\t  clone <model> <new_name>      Clone model to new name\r\n    94\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n    95\t  compat [--all]                 Check migration compatibility\r\n    96\t  version                       Show version\r\n    97\t  help                          Show this help\r\n    98\t\r\n    99\t"]
[6174.118236, "o", "Run/Diff Options:\r\n   100\t  --input <file>    Input CSV file (required)\r\n   101\t  --output <file>   Output file (default: stdout)\r\n   102\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   103\t\r\n   104\tBatch Options:\r\n   105\t  --dir <dir>       Input directory of CSV files\r\n   106\t  --output-dir <dir> Output directory for predictions\r\n   107\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   108\t`\r\n   109\t\tfmt.Print(usage)\r\n"]
[6174.118297, "o", "   110\t}\r\n"]
