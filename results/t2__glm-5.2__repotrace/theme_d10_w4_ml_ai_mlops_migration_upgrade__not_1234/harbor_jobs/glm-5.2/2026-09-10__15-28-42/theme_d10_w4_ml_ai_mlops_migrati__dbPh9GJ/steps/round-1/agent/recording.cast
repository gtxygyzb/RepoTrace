[3210.636024, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[3210.636121, "o", "\t\"path/filepath\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nconst registryFile = \"/app/models/registry.idx\"\r\n\r\ntype RegistryEntry struct {\r\n\tName    string\r\n\tPath    string\r\n\tType    string\r\n\tVersion int\r\n\tCreated string\r\n}\r\n\r\nfunc loadRegistry() ([]RegistryEntry, error) {\r\n\tf, err := os.Open(registryFile)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t"]
[3210.636192, "o", "\t\treturn nil, nil\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tvar entries []RegistryEntry\r\n\tscanner := bufio.NewScanner(f)\r\n\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n"]
[3210.636257, "o", "\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.Split(line, \"|\")\r\n\t\tif len(parts) != 5 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tver := 1\r\n\t\tfmt.Sscanf(parts[3], \"%d\", &ver)\r\n"]
[3210.636313, "o", "\t\tentries = append(entries, RegistryEntry{\r\n\t\t\tName:    parts[0],\r\n\t\t\tPath:    parts[1],\r\n\t\t\tType:    parts[2],\r\n\t\t\tVersion: ver,\r\n\t\t\tCreated: parts[4],\r\n\t\t})\r\n\t}\r\n\treturn entries, scanner.Err()"]
[3210.63638, "o", "\r\n}\r\n\r\nfunc saveRegistry(entries []RegistryEntry) error {\r\n\tdir := filepath.Dir(registryFile)\r\n\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n"]
[3210.636438, "o", "\r\n\tf, err := os.Create(registryFile)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tfmt.Fprintln(f, \"# mlpipe registry v1\")\r\n\tfor _, e := range entries {\r\n\t\tfmt.Fprintf(f, \"%s|%s|%s|%d|%s\\n\", e.Name, e.Path, e.Type, e.Version, e.Created)\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc findEntry(entries []RegistryEntry, name string) *RegistryEntry {\r\n\tfor i := range entries {"]
[3210.636501, "o", "\r\n\t\tif entries[i].Name == name {\r\n\t\t\treturn &entries[i]\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc cmdList(args []string) {\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n"]
[3210.636562, "o", "\t}\r\n\tif len(entries) == 0 {\r\n\t\tfmt.Println(\"No models registered.\")\r\n\t\treturn\r\n\t}\r\n\tfmt.Printf(\"%-20s %-10s %-8s %s\\n\", \"NAME\", \"TYPE\", \"VERSION\", \"CREATED\")\r\n\tfor _, e := range entries {\r\n\t\tfmt.Printf(\"%-20s %-10s %-8d %s\\n\", e.Name, e.Type, e.Version, e.Created)\r\n\t}\r\n"]
[3210.636626, "o", "}\r\n\r\nfunc cmdInfo(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe info <model>\\n\")\r\n\t\tos.Exit(1)\r\n"]
[3210.636682, "o", "\t}\r\n\tname := args[0]\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif !modelDirExists(entry.Path) {\r\n"]
[3210.636745, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: model directory not found\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmeta, err := loadModelMeta(entry.Path)\r\n\tif err != nil {"]
[3210.636815, "o", "\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tweights, err := loadWeights(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfmt.Printf(\"Name:        %s\\n\", meta[\"name\"])\r\n\tfmt.Printf(\"Type:        %s\\n\", meta[\"type\"])\r\n\tfmt.Printf(\"Version:     %s\\n\", meta[\"version\"])\r\n"]
[3210.636873, "o", "\tfmt.Printf(\"Created:     %s\\n\", meta[\"created\"])\r\n\tfmt.Printf(\"Description: %s\\n\", meta[\"description\"])\r\n\tfmt.Printf(\"Features:    %s\\n\", meta[\"features\"])\r\n\tfmt.Printf(\"Outputs:     %s\\n\", meta[\"outputs\"])\r\n\tfmt.Printf(\"Format:     v%d\\n\", weights.Version)\r\n\tfmt.Printf(\"Activation: %s\\n\", activationIDToName(weights.Activation))\r\n\tfmt.Printf(\"Path:        %s\\n\", entry.Path)\r\n}\r\n"]
[3210.636939, "o", "\r\nfunc cmdRegister(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe register <name> <path>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\tmodelPath := args[1]\r\n"]
[3210.636999, "o", "\r\n\tabsPath, err := filepath.Abs(modelPath)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif _, err := os.Stat(filepath.Join(absPath, \"model.meta\")); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: no model.meta found at %s\\n\", absPath)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmeta, err := loadModelMeta(absPath)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)"]
[3210.637063, "o", "\r\n\t}\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n"]
[3210.637118, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif findEntry(entries, name) != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' already registered\\n\", name)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmodelType := meta[\"type\"]\r\n\tif modelType == \"\" {\r\n\t\tmodelType = \"unknown\"\r\n\t}\r\n\r\n\tentries = append(entries, RegistryEntry{\r\n\t"]
[3210.637178, "o", "\tName:    name,\r\n\t\tPath:    absPath,\r\n\t\tType:    modelType,\r\n\t\tVersion: 1,\r\n\t\tCreated: time.Now().Format(\"2006-01-02\"),\r\n\t})\r\n\r\n\tif err := saveRegistry(entries); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[3210.637233, "o", "\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Printf(\"Model '%s' registered successfully.\\n\", name)\r\n}\r\n\r\nfunc cmdRemove(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe remove <name>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[3210.637292, "o", "\tname := args[0]\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfound := false\r\n\tvar newEntries []RegistryEntry\r\n\tfor _, e := range entries {\r\n\t\t"]
[3210.637351, "o", "if e.Name == name {\r\n\t\t\tfound = true\r\n\t\t} else {\r\n\t\t\tnewEntries = append(newEntries, e)\r\n\t\t}\r\n\t}\r\n\r\n\tif !found {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n\t"]
[3210.637405, "o", "\tos.Exit(1)\r\n\t}\r\n\r\n\tif err := saveRegistry(newEntries); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Printf(\"Model '%s' removed.\\n\", name)\r\n"]
[3210.637465, "o", "}\r\n"]
