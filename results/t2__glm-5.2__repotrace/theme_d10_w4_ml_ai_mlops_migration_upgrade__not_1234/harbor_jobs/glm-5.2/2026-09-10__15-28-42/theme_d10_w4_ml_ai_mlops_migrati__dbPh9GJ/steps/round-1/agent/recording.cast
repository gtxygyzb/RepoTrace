[12648.617225, "o", "    10\t\r\n    11\tfunc main() {\r\n    12\t\tif len(os.Args) < 2 {\r\n    13\t\t\tprintUsage()\r\n    14\t\t\tos.Exit(1)\r\n    15\t\t}\r\n    16\t\r\n    17\t\tcommand := os.Args[1]\r\n    18\t\targs := os.Args[2:]\r\n    19\t\r\n    20\t\tswitch command {\r\n    21\t\tcase \"ensemble\":\r\n    22\t\t\tcmdEnsemble(args)\r\n    23\t\tcase \"list\":\r\n    24\t\t\tcmdList(args)\r\n    25\t\tcase \"info\":\r\n    26\t\t\tcmdInfo(args)\r\n    27\t\tcase \"register\":\r\n    28\t\t\tcmdRegister(args)\r\n    29\t\tcase \"remove\":\r\n"]
