[14105.341079, "o", "    48\t\tBias        []float64\r\n    49\t}\r\n    50\t\r\n    51\tfunc loadWeights(modelDir string) (*WeightsData, error) {\r\n"]
[14105.341153, "o", "    52\t\tf, err := os.Open(filepath.Join(modelDir, \"weights.bin\"))\r\n    53\t\tif err != nil {\r\n    54\t\t\treturn nil, err\r\n    55\t\t}\r\n    56\t\tdefer f.Close()\r\n    57\t\r\n    58\t\tmagic := make([]byte, 4)\r\n    59\t\tif _, err := f.Read(magic); err != nil {\r\n    60\t\t\treturn nil, fmt.Errorf(\"failed to read magic: %v\", err)\r\n    61\t\t}\r\n    62\t\t"]
[14105.341223, "o", "if string(magic) != string(modelMagic) {\r\n    63\t\t\treturn nil, fmt.Errorf(\"invalid model file: bad magic\")\r\n    64\t\t}\r\n    65\t\r\n    66\t\tvar ver, nf, no uint32\r\n    67\t\tif err := binary.Read(f, binary.LittleEndian, &ver); err != nil {\r\n    68\t\t\treturn nil, fmt.Errorf(\"failed to read version: %v\", err)\r\n    69\t\t}\r\n    70\t\r\n"]
[14105.341285, "o", "    71\t\tvar hasher hash.Hash32\r\n    72\t\tr := io.Reader(f)\r\n    73\t\tif ver == 3 {\r\n    74\t\t\thasher = crc32.NewIEEE()\r\n    75\t\t\tif _, err := hasher.Write(magic); err != nil {\r\n    76\t\t\t\treturn nil, fmt.Errorf(\"failed to compute checksum: %v\", err)\r\n    77\t\t\t}\r\n    78\t\t\tif err := binary.Write(hasher, binary.LittleEndian, ver); err != nil {\r\n"]
[14105.341345, "o", "    79\t\t\t\treturn nil, fmt.Errorf(\"failed to compute checksum: %v\", err)\r\n    80\t\t\t}\r\n    81\t\t\tr = io.TeeReader(f, hasher)\r\n    82\t\t}\r\n    83\t\r\n    84\t\tif err := binary.Read(r, binary.LittleEndian, &nf); err != nil {\r\n    85\t\t\treturn nil, fmt.Errorf(\"failed to read num_features: %v\", err)\r\n    86\t\t}\r\n    87\t\tif err := binary.Read(r, binary.LittleEndian, &no); err != nil {\r\n    88\t"]
[14105.341411, "o", "\t\treturn nil, fmt.Errorf(\"failed to read num_outputs: %v\", err)\r\n    89\t\t}\r\n    90\t\r\n    91\t\tvar act uint32\r\n    92\t\tswitch ver {\r\n    93\t\tcase 1:\r\n    94\t\t\tact = 0\r\n    95\t\tcase 2, 3:\r\n    96\t\t\tif err := binary.Read(r, binary.LittleEndian, &act); err != nil {\r\n"]
[14105.341471, "o", "    97\t\t\t\treturn nil, fmt.Errorf(\"failed to read activation: %v\", err)\r\n    98\t\t\t}\r\n    99\t\tdefault:\r\n   100\t\t\treturn nil, fmt.Errorf(\"unsupported model format version: %d\", ver)\r\n   101\t\t}\r\n   102\t\r\n   103\t\tweights := make([]float64, nf*no)\r\n   104\t\tfor i := range weights {\r\n"]
[14105.341545, "o", "   105\t\t\tif err := binary.Read(r, binary.LittleEndian, &weights[i]); err != nil {\r\n   106\t\t\t\treturn nil, fmt.Errorf(\"failed to read weight[%d]: %v\", i, err)\r\n   107\t\t\t}\r\n   108\t\t}\r\n   109\t\r\n   110\t\tbias := make([]float64, no)\r\n   111\t\tfor i := range bias {\r\n   112\t\t\tif err := binary.Read(r, binary.LittleEndian, &bias[i]); err != nil {\r\n   113\t\t\t\treturn nil, fmt.Errorf(\"failed to read bias[%d]: %v\", i, err)\r\n   114\t\t\t}\r\n   115\t\t}\r\n   116\t\r\n"]
[14105.341607, "o", "   117\t\tif ver == 3 {\r\n   118\t\t\tvar checksum uint32\r\n   119\t\t\tif err := binary.Read(f, binary.LittleEndian, &checksum); err != nil {\r\n   120\t\t\t\treturn nil, fmt.Errorf(\"failed to read checksum: %v\", err)\r\n   121\t\t\t}\r\n   122\t\t\tif hasher.Sum32() != checksum {\r\n   123\t\t\t\treturn nil, fmt.Errorf(\"checksum mismatch\")\r\n"]
[14105.341664, "o", "   124\t\t\t}\r\n   125\t\t}\r\n   126\t\r\n   127\t\tif _, err := f.Read(make([]byte, 1)); err != io.EOF {\r\n   128\t\t\treturn nil, fmt.Errorf(\"extra data after weights\")\r\n   129\t\t}\r\n"]
[14105.341729, "o", "   130\t\r\n   131\t\treturn &WeightsData{\r\n   132\t\t\tVersion:     ver,\r\n   133\t\t\tNumFeatures: nf,\r\n   134\t\t\tNumOutputs:  no,\r\n"]
[14105.341813, "o", "   135\t\t\tActivation:  act,\r\n   136\t\t\tWeights:     weights,\r\n   137\t\t\tBias:        bias,\r\n   138\t\t}, nil\r\n   139\t}\r\n   140\t\r\n"]
