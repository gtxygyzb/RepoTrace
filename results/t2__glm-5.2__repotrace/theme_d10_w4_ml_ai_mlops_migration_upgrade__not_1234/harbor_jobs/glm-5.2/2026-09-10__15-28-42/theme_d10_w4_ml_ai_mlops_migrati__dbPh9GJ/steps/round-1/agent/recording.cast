[9004.463371, "o", "\r\nfunc loadEnsembleConfig(name string) (*ensembleConfig, error) {\r\ndata, err := os.ReadFile(filepath.Join(ensemblesDir, name+\".json\"))\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nvar cfg ensembleConfig\r\nif err := json.Unmarshal(data, &cfg); err != nil {\r\nreturn nil, err\r\n}\r\nreturn &cfg, nil\r\n}\r\n\r\nfunc listEnsembleConfigs() ([]*ensembleConfig, error) {\r\nfiles, err := os.ReadDir(ensemblesDir)\r\nif err != nil {\r\nif os.IsNotExist(err) {\r\nreturn nil, nil\r\n}\r\nreturn nil, err\r\n}\r\nvar configs []*ensembleConfig\r\nfor _, file := range files {\r\nif file.IsDir() || !strings.HasSuffix(file.Name(), \".json\") {\r\ncontinue\r\n}\r\n"]
