[11325.56983, "o", "    96\t\t\tmod  time.Time\r\n    97\t\t}\r\n    98\t\tvar cps []checkpointInfo\r\n    99\t\tfor _, entry := range entries {\r\n   100\t\t\tif !entry.IsDir() {\r\n   101\t\t\t\tcontinue\r\n   102\t\t\t}\r\n   103\t\t\tinfo, err := entry.Info()\r\n   104\t\t\tif err != nil {\r\n   105\t\t\t\tcontinue\r\n   106\t"]
[11325.569897, "o", "\t\t}\r\n   107\t\t\tcps = append(cps, checkpointInfo{name: entry.Name(), mod: info.ModTime()})\r\n   108\t\t}\r\n   109\t\r\n   110\t\tif len(cps) == 0 {\r\n   111\t\t\tfmt.Println(\"no checkpoints\")\r\n"]
