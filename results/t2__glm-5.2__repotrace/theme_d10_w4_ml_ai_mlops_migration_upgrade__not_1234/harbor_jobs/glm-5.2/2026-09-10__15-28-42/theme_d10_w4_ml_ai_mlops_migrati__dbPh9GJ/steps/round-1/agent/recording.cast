[5932.864096, "o", "\t\t\t\tif isMissingValue(raw) {\r\n   141\t\t\t\t\tmissing++\r\n   142\t\t\t\t\tvalues = append(values, math.NaN())\r\n   143\t\t\t\t\tcontinue\r\n   144\t\t\t\t}\r\n   145\t\t\t\tv, err := strconv.ParseFloat(raw, 64)\r\n   146\t\t\t\tif err != nil {\r\n   147\t\t\t\t\tnumeric = false\r\n   148\t\t\t\t\tbreak\r\n"]
