[9618.658899, "o", "\tif err != nil {\r\n    39\t\t\treturn nil, nil, err\r\n    40\t\t}\r\n    41\t\treturn weights, cfg, nil\r\n    42\t}\r\n    43\t\r\n    44\tfunc validateFeatureCount(inputs [][]float64, expected int) error {\r\n    45\t\tfor i, row := range inputs {\r\n    46\t\t\tif len(row) != expected {\r\n    47\t\t\t\treturn fmt.Errorf(\"expected %d features, got %d in row %d\", expected, len(row), i)\r\n    48\t\t\t}\r\n    49\t\t}\r\n    50\t\treturn nil\r\n    51\t}\r\n    52\t\r\n    53\tfunc readCSVRaw(path string) ([][]string, error) {\r\n    54\t\tf, err := os.Open(path)\r\n    55\t\tif err != nil {\r\n    56\t\t\treturn nil, err\r\n    57\t\t}\r\n    58\t"]
