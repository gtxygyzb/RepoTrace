[12196.916301, "o", "   645\tfunc cmdPrune(args []string) {\r\n   646\t\tif len(args) < 1 {\r\n   647\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe prune <model> --threshold <value> [--dry-run]\\n\")\r\n   648\t\t\tos.Exit(1)\r\n   649\t\t}\r\n   650\t\r\n   651\t\tmodel := args[0]\r\n"]
[12196.916456, "o", "   652\t\tflags := parseFlags(args[1:])\r\n   653\t\r\n   654\t\tthresholdStr := flags[\"threshold\"]\r\n   655\t\tif thresholdStr == \"\" || thresholdStr == \"true\" {\r\n   656\t\t\tfmt.Fprintf(os.Stderr, \"error: --threshold is required\\n\")\r\n   657\t\t\tos.Exit(1)\r\n   658\t\t}\r\n   659\t\r\n   660\t\tthreshold, err := strconv.ParseFloat(thresholdStr, 64)\r\n   661\t\tif err != nil {\r\n   662\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid threshold\\n\")\r\n   663\t\t\tos.Exit(1)\r\n   664\t\t}\r\n   665\t\tif threshold <= 0 {\r\n   666\t\t\tfmt.Fprintf(os.Stderr, \"threshold must be positive\\n\")\r\n   667\t\t\tos.Exit(1)\r\n   668\t\t}\r\n   669\t\r\n   670\t\tdryRun := flags[\"dry-run\"] == \"true\"\r\n   671\t\r\n   672\t\tentry, err := resolveModel(model)\r\n   673\t\tif err != nil {\r\n   674\t\t\tfmt.Fprintf(os.Stderr, \"not found\\n\")\r\n   675"]
[12196.91654, "o", "\t\t\tos.Exit(1)\r\n   676\t\t}\r\n   677\t\r\n   678\t\tweights, err := loadWeights(entry.Path)\r\n   679\t\tif err != nil {\r\n   680\t\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n   681\t\t\tos.Exit(1)\r\n   682\t\t}\r\n   683\t\r\n   684\t\ttotal := len(weights.Weights)\r\n   685\t\tpruned := 0\r\n   686\t"]
[12196.916606, "o", "\tfor i, v := range weights.Weights {\r\n   687\t\t\tif math.Abs(v) < threshold {\r\n   688\t\t\t\tpruned++\r\n   689\t\t\t\tweights.Weights[i] = 0.0\r\n   690\t\t\t}\r\n   691\t\t}\r\n   692\t\r\n   693\t\tzeroCount := 0\r\n   694\t\tfor _, v := range weights.Weights {\r\n"]
[12196.91668, "o", "   695\t\t\tif v == 0.0 {\r\n   696\t\t\t\tzeroCount++\r\n   697\t\t\t}\r\n   698\t\t}\r\n   699\t\r\n   700\t\tprunedPct := 0.0\r\n   701\t\tsparsity := 0.0\r\n   702\t\tif total > 0 {\r\n   703\t\t\tprunedPct = float64(pruned) / float64(total) * 100.0\r\n   704\t\t\t"]
[12196.91675, "o", "sparsity = float64(zeroCount) / float64(total) * 100.0\r\n   705\t\t}\r\n   706\t\r\n   707\t\tfmt.Printf(\"Pruning '%s' (threshold=%s)\\n\", model, thresholdStr)\r\n   708\t\tfmt.Printf(\"Total weights:  %d\\n\", total)\r\n   709\t\tfmt.Printf(\"Pruned:         %d (%.1f%%)\\n\", pruned, prunedPct)\r\n   710\t\tfmt.Printf(\"New sparsity:   %.1f%%\\n\", sparsity)\r\n   711\t\r\n   712\t\tif dryRun {\r\n   713\t\t\tfmt.Println(\"(dry run - no changes made)\")\r\n"]
[12196.916824, "o", "   714\t\t\treturn\r\n   715\t\t}\r\n   716\t\r\n   717\t\tcpDir := filepath.Join(checkpointsDir(entry.Path), \"pre-prune\")\r\n   718\t\tif err := os.MkdirAll(cpDir, 0755); err != nil {\r\n   719\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   720\t\t\tos.Exit(1)\r\n   721\t\t}\r\n"]
[12196.916887, "o", "   722\t\tfor _, file := range []string{\"weights.bin\", \"model.meta\", \"pipeline.cfg\"} {\r\n   723\t\t\tdata, err := os.ReadFile(filepath.Join(entry.Path, file))\r\n   724\t\t\tif err != nil {\r\n   725\t\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   726\t\t\t\tos.Exit(1)\r\n   727\t\t\t}\r\n   728\t\t\tif err := os.WriteFile(filepath.Join(cpDir, file), data, 0644); err != nil {\r\n   729\t\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[12196.916949, "o", "   730\t\t\t\tos.Exit(1)\r\n   731\t\t\t}\r\n   732\t\t}\r\n   733\t\r\n   734\t\tif err := writeWeights(filepath.Join(entry.Path, \"weights.bin\"), weights); err != nil {\r\n   735\t\t\tfmt.Fprintf(os.Stderr, \"error writing weights: %v\\n\", err)\r\n   736\t\t\tos.Exit(1)\r\n   737\t\t}\r\n   738\t}\r\n"]
