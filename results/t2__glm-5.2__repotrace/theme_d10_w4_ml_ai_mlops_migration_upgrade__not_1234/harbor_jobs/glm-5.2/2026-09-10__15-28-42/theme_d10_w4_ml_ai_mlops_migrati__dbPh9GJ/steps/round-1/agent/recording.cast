[12203.635604, "o", "\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n"]
[12203.635787, "o", "    12\t\t\"time\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc modelDirExists(path string) bool {\r\n    16\t\tinfo, err := os.Stat(path)\r\n    17\t\treturn err == nil && info.IsDir()\r\n    18\t}\r\n    19\t\r\n    20\tfunc resolveModel(name string) (*RegistryEntry, error) {\r\n    21\t\tentries, err := loadRegistry()\r\n    22\t\tif err != nil {\r\n    23\t\t\treturn nil, err\r\n    24\t\t}\r\n    25\t\tentry := findEntry(entries, name)\r\n    26\t\tif entry == nil || !modelDirExists(entry.Path) {\r\n    27\t\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n    28\t\t\tos.Exit(1)\r\n    29\t\t}\r\n    30\t\treturn entry, nil\r\n    31\t}\r\n    32\t\r\n    33\tfunc loadModelArtifacts(modelDir string) (*WeightsData, *PipelineConfig, error) {\r\n    34\t\tweights, err := loadWeights(modelDir)\r\n    35\t\tif err != nil {\r\n    36\t\t\treturn nil, nil, err\r\n    37\t\t}\r\n    38\t\tcfg, err := loadPipelineConfig(modelDir)\r\n    39\t\tif err != nil {\r\n    40\t\t\treturn nil, nil, err\r\n    41\t\t}\r\n    42\t\treturn weights, cfg, nil\r\n"]
[12203.635922, "o", "    43\t}\r\n    44\t\r\n    45\tfunc validateFeatureCount(inputs [][]float64, expected int) error {\r\n    46\t\tfor i, row := range inputs {\r\n    47\t\t\tif len(row) != expected {\r\n    48\t\t\t\treturn fmt.Errorf(\"expected %d features, got %d in row %d\", expected, len(row), i)\r\n    49\t\t\t}\r\n    50\t\t}\r\n    51\t\treturn nil\r\n    52\t}\r\n    53\t\r\n    54\tfunc readCSVRaw(path string) ([][]string, error) {\r\n    55\t\tf, err := os.Open(path)\r\n    56\t\tif err != nil {\r\n    57\t\t\treturn nil, err\r\n    58\t\t}\r\n    59\t\tdefer f.Close()\r\n    60\t\r\n"]
