[7500.249353, "o", "\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc loadRegistry\u001b[m\u001b[K() ([]RegistryEntry, error) {\r\n"]
[7500.249528, "o", "\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc findEntry\u001b[m\u001b[K(entries []RegistryEntry, name string) *RegistryEntry {\r\n"]
