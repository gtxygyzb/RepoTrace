[11377.546331, "o", "\t}\r\n\tmodel := args[0]\r\n\r\n\tentry, err := resolveModel(model)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n"]
[11377.546398, "o", "\t}\r\n\r\n\tweightsPath := filepath.Join(entry.Path, \"weights.bin\")\r\n\tinfo, err := os.Stat(weightsPath)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tweights, _, err := loadModelArtifacts(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading model: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfeatures := int(weights.NumFeatures)\r\n\toutputs := int(weights.NumOutputs)\r\n\ttotalParams := features*outputs + outputs\r\n\r\n\tvar wmin, wmax, wsum float64\r\n\tzeroCount := 0\r\n\tif len(weights.Weights) > 0 {\r\n\t\twmin = weights.Weights[0]\r\n\t\twmax = weights.Weights[0]\r\n\t\tfor _, v := range weights.Weights {\r\n\t\t\tif v < wmin {\r\n\t\t\t\twmin = v\r\n\t\t\t}\r\n\t\t\tif v > wmax {\r\n\t\t\t\twmax = v"]
[11377.546489, "o", "\r\n"]
