[1859.147207, "o", "     9\tfunc cmdValidate(args []string) {\r\n    10\t\tif len(args) < 1 {\r\n    11\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe validate <model>\\n\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\tname := args[0]\r\n    15\t\r\n    16\t\tentries, err := loadRegistry()\r\n    17\t\tif err != nil {\r\n    18\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    19\t\t\tos.Exit(1)\r\n    20\t\t}\r\n    21\t\r\n    22\t\tentry := findEntry(entries, name)\r\n    23\t\tif entry == nil {\r\n    24\t\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n"]
[1859.147287, "o", "    25\t\t\tos.Exit(1)\r\n    26\t\t}\r\n    27\t\tif !modelDirExists(entry.Path) {\r\n    28\t\t\tfmt.Fprintf(os.Stderr, \"error: model directory not found\\n\")\r\n    29\t\t\tos.Exit(1)\r\n    30\t\t}\r\n    31\t\r\n    32\t\terrors := validateModel(entry.Path)\r\n    33\t\tif len(errors) == 0 {\r\n    34\t\t\tfmt.Printf(\"Model '%s' is valid.\\n\", name)\r\n"]
[1859.147351, "o", "    35\t\t} else {\r\n    36\t\t\tfmt.Printf(\"Model '%s' has %d validation error(s):\\n\", name, len(errors))\r\n    37\t\t\tfor i, e := range errors {\r\n    38\t\t\t\tfmt.Printf(\"  %d. %s\\n\", i+1, e)\r\n    39\t\t\t}\r\n    40\t\t\tos.Exit(1)\r\n    41\t\t}\r\n    42\t}\r\n"]
[1859.147411, "o", "    43\t\r\n    44\tfunc validateModel(modelDir string) []string {\r\n    45\t\tvar errors []string\r\n    46\t\r\n    47\t\tmetaPath := filepath.Join(modelDir, \"model.meta\")\r\n    48\t\tif _, err := os.Stat(metaPath); err != nil {\r\n    49\t\t\terrors = append(errors, \"missing model.meta\")\r\n    50\t\t} else {\r\n    51\t\t\tmeta, err := loadModelMeta(modelDir)\r\n    52\t\t\tif err != nil {\r\n"]
[1859.14747, "o", "    53\t\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse model.meta: %v\", err))\r\n    54\t\t\t} else {\r\n    55\t\t\t\tif meta[\"name\"] == \"\" {\r\n    56\t\t\t\t\terrors = append(errors, \"model.meta: missing 'name' field\")\r\n    57\t\t\t\t}\r\n    58\t\t\t\tif meta[\"type\"] == \"\" {\r\n    59\t\t\t\t\terrors = append(errors, \"model.meta: missing 'type' field\")\r\n    60\t\t\t\t}\r\n    61"]
[1859.147529, "o", "\t\t\t\tif meta[\"features\"] == \"\" {\r\n    62\t\t\t\t\terrors = append(errors, \"model.meta: missing 'features' field\")\r\n    63\t\t\t\t}\r\n    64\t\t\t\tif meta[\"outputs\"] == \"\" {\r\n    65\t\t\t\t\terrors = append(errors, \"model.meta: missing 'outputs' field\")\r\n    66\t\t\t\t}\r\n    67\t\t\t}\r\n    68\t\t}\r\n    69\t\r\n"]
[1859.147588, "o", "    70\t\tweightsPath := filepath.Join(modelDir, \"weights.bin\")\r\n    71\t\tif _, err := os.Stat(weightsPath); err != nil {\r\n    72\t\t\terrors = append(errors, \"missing weights.bin\")\r\n    73\t\t} else {\r\n    74\t\t\t_, err := loadWeights(modelDir)\r\n    75\t\t\tif err != nil {\r\n    76\t\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse weights.bin: %v\", err))\r\n"]
[1859.14765, "o", "    77\t\t\t}\r\n    78\t\t}\r\n    79\t\r\n    80\t\tcfgPath := filepath.Join(modelDir, \"pipeline.cfg\")\r\n    81\t\tif _, err := os.Stat(cfgPath); err != nil {\r\n    82\t\t\terrors = append(errors, \"missing pipeline.cfg\")\r\n    83\t\t} else {\r\n    84\t\t\t"]
[1859.147706, "o", "_, err := loadPipelineConfig(modelDir)\r\n    85\t\t\tif err != nil {\r\n    86\t\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse pipeline.cfg: %v\", err))\r\n    87\t\t\t}\r\n    88\t\t}\r\n    89\t\r\n    90\t\treturn errors\r\n    91\t}\r\n"]
[1859.147768, "o", "    92\t\r\n    93\tfunc cmdExport(args []string) {\r\n    94\t\tif len(args) < 1 {\r\n    95\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe export <model> --output <dir>\\n\")\r\n    96\t\t\tos.Exit(1)\r\n    97\t\t}\r\n    98\t\tname := args[0]\r\n"]
[1859.14787, "o", "    99\t\tflags := parseFlags(args[1:])\r\n   100\t\r\n   101\t\toutputDir := flags[\"output\"]\r\n   102\t\tif outputDir == \"\" {\r\n   103\t\t\tfmt.Fprintf(os.Stderr, \"error: --output is required\\n\")\r\n   104\t\t\tos.Exit(1)\r\n   105\t\t}\r\n   106\t\r\n   107\t\tentries, err := loadRegistry()\r\n   108\t\tif err != nil {\r\n   109\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   110\t\t\tos.Exit(1)\r\n   111\t\t}\r\n   112\t\r\n   113\t\tentry := findEntry(entries, name)\r\n   114\t\tif entry == nil {\r\n   115\t\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n"]
[1859.147933, "o", "   116\t\t\tos.Exit(1)\r\n   117\t\t}\r\n   118\t\r\n   119\t\tif err := os.MkdirAll(outputDir, 0755); err != nil {\r\n   120\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   121\t\t\tos.Exit(1)\r\n   122\t\t}\r\n   123\t\r\n   124\t\tfiles := []string{\"model.meta\", \"weights.bin\", \"pipeline.cfg\"}\r\n   125\t\tfor _, file := range files {\r\n"]
[1859.147991, "o", "   126\t\t\tsrc := filepath.Join(entry.Path, file)\r\n   127\t\t\tdst := filepath.Join(outputDir, file)\r\n   128\t\t\tdata, err := os.ReadFile(src)\r\n   129\t\t\tif err != nil {\r\n   130\t\t\t\tfmt.Fprintf(os.Stderr, \"error reading %s: %v\\n\", file, err)\r\n   131\t\t\t\tos.Exit(1)\r\n   132\t"]
[1859.148051, "o", "\t\t}\r\n   133\t\t\tif err := os.WriteFile(dst, data, 0644); err != nil {\r\n   134\t\t\t\tfmt.Fprintf(os.Stderr, \"error writing %s: %v\\n\", file, err)\r\n   135\t\t\t\tos.Exit(1)\r\n   136\t\t\t}\r\n   137\t\t}\r\n   138\t\tfmt.Printf(\"Model '%s' exported to %s\\n\", name, outputDir)\r\n   139\t}\r\n"]
