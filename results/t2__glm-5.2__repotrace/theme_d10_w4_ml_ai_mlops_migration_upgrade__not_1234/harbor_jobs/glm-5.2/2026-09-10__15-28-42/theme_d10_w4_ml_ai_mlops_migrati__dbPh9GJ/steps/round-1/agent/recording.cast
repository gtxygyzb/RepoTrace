[9667.338619, "o", "\u001b[35m\u001b[Kregistry.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype RegistryEntry struct\u001b[m\u001b[K {\r\n"]
[9667.338682, "o", "\u001b[35m\u001b[Kregistry.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Printf(\"Features:    %s\\n\", meta[\"\u001b[01;31m\u001b[Kfeatures\u001b[m\u001b[K\"])\r\n\u001b[35m\u001b[Kregistry.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Printf(\"\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K: %s\\n\", activationIDToName(weights.\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K))\r\n"]
