[7607.837737, "o", "func loadPipelineConfig(modelDir string) (*PipelineConfig, error) {\r\n\tf, err := os.Open(filepath.Join(modelDir, \"pipeline.cfg\"))\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n"]
[7607.837827, "o", "\tdefer f.Close()\r\n\r\n\tcfg := &PipelineConfig{\r\n\t\tScaleMin:        0.0,\r\n\t\tScaleMax:        1.0,\r\n\t\tMissingStrategy: \"zero\",\r\n\t\tRoundDigits:     4,\r\n\t\tClipMin:         -1000.0,\r\n\t\tClipMax:         1000.0,\r\n\t}\r\n"]
[7607.837896, "o", "\r\n\tscanner := bufio.NewScanner(f)\r\n\tsection := \"\"\r\n\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\r\n\t\t\tsection = line[1 : len(line)-1]\r\n\t\t\tcontinue\r\n\t"]
