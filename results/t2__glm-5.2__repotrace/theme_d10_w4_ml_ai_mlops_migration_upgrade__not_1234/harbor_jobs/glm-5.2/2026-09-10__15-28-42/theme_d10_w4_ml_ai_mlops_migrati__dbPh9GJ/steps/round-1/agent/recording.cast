[7523.4025, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n"]
[7523.402615, "o", "\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nconst (\r\n\tregistryFile     = \"/app/models/registry.idx\"\r\n\tregistryJSONFile = \"/app/models/registry.json\"\r\n)\r\n\r\ntype RegistryEntry struct {\r\n\tName    string   `json:\"name\"`\r\n\tPath    string   `json:\"path\"`\r\n\tType    string   `json:\"type\"`\r\n\tVersion int      `json:\"version\"`\r\n\tCreated string   `json:\"created\"`\r\n\tTags    []string `json:\"tags\"`\r\n}\r\n\r\nfunc loadRegistry() ([]RegistryEntry, error) {\r\n\tdata, err := os.ReadFile(registryJSONFile)\r\n\tif err == nil {\r\n"]
[7523.402708, "o", "\t\tif len(strings.TrimSpace(string(data))) == 0 {\r\n\t\t\treturn nil, nil\r\n\t\t}\r\n\t\tvar entries []RegistryEntry\r\n\t\tif err := json.Unmarshal(data, &entries); err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"parse registry.json: %w\", err)\r\n\t\t}\r\n\t\tfor i := range entries {\r\n\t\t\tentries[i].Tags = ensureTags(entries[i].Tags)\r\n\t\t}\r\n\t\treturn entries, nil\r\n\t}\r\n\tif !os.IsNotExist(err) {\r\n\t\t"]
[7523.402836, "o", "return nil, err\r\n\t}\r\n\r\n\tif _, err := os.Stat(registryFile); err == nil {\r\n\t\tentries, err := loadOldRegistry()\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tif err := saveRegistry(entries); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn entries, nil\r\n\t}"]
[7523.402926, "o", "\r\n\r\n\treturn nil, nil\r\n}\r\n\r\nfunc loadOldRegistry() ([]RegistryEntry, error) {\r\n\tf, err := os.Open(registryFile)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, nil\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tvar entries []RegistryEntry\r\n\tscanner := bufio.NewScanner(f)\r\n\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n"]
[7523.403009, "o", "\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.Split(line, \"|\")\r\n\t\tif len(parts) != 5 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tver := 1\r\n\t\tfmt.Sscanf(parts[3], \"%d\", &ver)\r\n\t\tentries = append(entries, RegistryEntry{\r\n\t\t\tName:    parts[0],\r\n\t\t\tPath:    parts[1],\r\n"]
[7523.403098, "o", "\t\t\tType:    parts[2],\r\n\t\t\tVersion: ver,\r\n\t\t\tCreated: parts[4],\r\n\t\t\tTags:    []string{},\r\n\t\t})\r\n\t}\r\n\treturn entries, scanner.Err()\r\n}\r\n\r\nfunc saveRegistry(entries []RegistryEntry) error {\r\n\tdir := filepath.Dir(registryJSONFile)\r\n\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n"]
[7523.403177, "o", "\r\n\tout := make([]RegistryEntry, len(entries))\r\n\tfor i, e := range entries {\r\n\t\te.Tags = ensureTags(e.Tags)\r\n\t\tout[i] = e\r\n\t}\r\n\r\n\tdata, err := json.MarshalIndent(out, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(registryJSONFile, data, 0644)\r\n}\r\n"]
[7523.403253, "o", "\r\nfunc ensureTags(tags []string) []string {\r\n\tif tags == nil {\r\n\t\treturn []string{}\r\n\t}\r\n\treturn tags\r\n}\r\n"]
