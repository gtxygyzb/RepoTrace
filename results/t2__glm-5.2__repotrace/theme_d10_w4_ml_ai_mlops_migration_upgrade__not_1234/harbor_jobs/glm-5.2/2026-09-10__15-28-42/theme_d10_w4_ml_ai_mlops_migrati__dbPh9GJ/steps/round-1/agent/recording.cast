[1984.397362, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"path/filepath\"\r\n     8\t\t\"strings\"\r\n     9\t\t\"time\"\r\n    10\t)\r\n    11\t\r\n"]
[1984.397495, "o", "    12\tconst registryFile = \"/app/models/registry.idx\"\r\n    13\t\r\n    14\ttype RegistryEntry struct {\r\n    15\t\tName    string\r\n    16\t\tPath    string\r\n    17\t\tType    string\r\n    18\t\tVersion int\r\n    19\t\tCreated string\r\n    20\t}\r\n    21\t\r\n    22\tfunc loadRegistry() ([]RegistryEntry, error) {\r\n    23\t\tf, err := os.Open(registryFile)\r\n    24\t\tif err != nil {\r\n    25\t\t\tif os.IsNotExist(err) {\r\n    26\t\t\t\treturn nil, nil\r\n    27\t\t\t}\r\n    28\t\t\treturn nil, err\r\n    29\t\t}\r\n"]
[1984.397564, "o", "    30\t\tdefer f.Close()\r\n    31\t\r\n    32\t\tvar entries []RegistryEntry\r\n    33\t\tscanner := bufio.NewScanner(f)\r\n    34\t\tfor scanner.Scan() {\r\n    35\t\t\tline := strings.TrimSpace(scanner.Text())\r\n    36\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    37\t\t\t\tcontinue\r\n    38\t\t\t}\r\n    39\t\t\tparts := strings.Split(line, \"|\")\r\n    40\t\t\tif len(parts) != 5 {\r\n"]
[1984.397623, "o", "    41\t\t\t\tcontinue\r\n    42\t\t\t}\r\n    43\t\t\tver := 1\r\n    44\t\t\tfmt.Sscanf(parts[3], \"%d\", &ver)\r\n    45\t\t\tentries = append(entries, RegistryEntry{\r\n    46\t\t\t\tName:    parts[0],\r\n    47\t\t\t\tPath:    parts[1],\r\n    48\t\t\t\tType:    parts[2],\r\n    49\t\t"]
[1984.397675, "o", "\t\tVersion: ver,\r\n    50\t\t\t\tCreated: parts[4],\r\n    51\t\t\t})\r\n    52\t\t}\r\n    53\t\treturn entries, scanner.Err()\r\n    54\t}\r\n    55\t\r\n    56\t"]
[1984.397728, "o", "func saveRegistry(entries []RegistryEntry) error {\r\n    57\t\tdir := filepath.Dir(registryFile)\r\n    58\t\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n    59\t\t\treturn err\r\n    60\t\t}\r\n    61\t\r\n    62\t\t"]
[1984.397783, "o", "f, err := os.Create(registryFile)\r\n    63\t\tif err != nil {\r\n    64\t\t\treturn err\r\n    65\t\t}\r\n    66\t\tdefer f.Close()\r\n    67\t\r\n    68\t\tfmt.Fprintln(f, \"# mlpipe registry v1\")\r\n    69\t\tfor _, e := range entries {\r\n"]
[1984.397855, "o", "    70\t\t\tfmt.Fprintf(f, \"%s|%s|%s|%d|%s\\n\", e.Name, e.Path, e.Type, e.Version, e.Created)\r\n    71\t\t}\r\n    72\t\treturn nil\r\n    73\t}\r\n    74\t\r\n    75\tfunc findEntry(entries []RegistryEntry, name string) *RegistryEntry {\r\n    76\t\tfor i := range entries {\r\n    77\t\t\tif entries[i].Name == name {\r\n    78\t\t\t\treturn &entries[i]\r\n"]
[1984.397909, "o", "    79\t\t\t}\r\n    80\t\t}\r\n    81\t\treturn nil\r\n    82\t}\r\n    83\t\r\n    84\tfunc cmdList(args []string) {\r\n    85\t\tentries, err := loadRegistry()\r\n    86\t\tif err != nil {\r\n    87\t"]
[1984.397959, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    88\t\t\tos.Exit(1)\r\n    89\t\t}\r\n    90\t\tif len(entries) == 0 {\r\n    91\t\t\tfmt.Println(\"No models registered.\")\r\n    92\t\t\treturn\r\n    93\t\t}\r\n"]
[1984.398012, "o", "    94\t\tfmt.Printf(\"%-20s %-10s %-8s %s\\n\", \"NAME\", \"TYPE\", \"VERSION\", \"CREATED\")\r\n    95\t\tfor _, e := range entries {\r\n    96\t\t\tfmt.Printf(\"%-20s %-10s %-8d %s\\n\", e.Name, e.Type, e.Version, e.Created)\r\n    97\t\t}\r\n    98\t}\r\n    99\t\r\n   100\tfunc cmdInfo(args []string) {\r\n   101\t\t"]
[1984.398062, "o", "if len(args) < 1 {\r\n   102\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe info <model>\\n\")\r\n   103\t\t\tos.Exit(1)\r\n   104\t\t}\r\n   105\t\tname := args[0]\r\n   106\t\tentries, err := loadRegistry()\r\n"]
[1984.398114, "o", "   107\t\tif err != nil {\r\n   108\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   109\t\t\tos.Exit(1)\r\n   110\t\t}\r\n   111\t\tentry := findEntry(entries, name)\r\n   112\t\tif entry == nil {\r\n   113\t\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n"]
[1984.398168, "o", "   114\t\t\tos.Exit(1)\r\n   115\t\t}\r\n   116\t\tif !modelDirExists(entry.Path) {\r\n   117\t\t\tfmt.Fprintf(os.Stderr, \"error: model directory not found\\n\")\r\n   118\t\t\tos.Exit(1)\r\n   119\t\t}\r\n   120\t\r\n"]
[1984.398218, "o", "   121\t\tmeta, err := loadModelMeta(entry.Path)\r\n   122\t\tif err != nil {\r\n   123\t\t\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n   124\t\t\tos.Exit(1)\r\n   125\t\t}\r\n   126\t\r\n   127\t\tfmt.Printf(\"Name:        %s\\n\", meta[\"name\"])\r\n   128\t\tfmt.Printf(\"Type:        %s\\n\", meta[\"type\"])\r\n"]
[1984.398269, "o", "   129\t\tfmt.Printf(\"Version:     %s\\n\", meta[\"version\"])\r\n   130\t\tfmt.Printf(\"Created:     %s\\n\", meta[\"created\"])\r\n   131\t\tfmt.Printf(\"Description: %s\\n\", meta[\"description\"])\r\n   132\t\tfmt.Printf(\"Features:    %s\\n\", meta[\"features\"])\r\n   133\t\tfmt.Printf(\"Outputs:     %s\\n\", meta[\"outputs\"])\r\n   134\t\tfmt.Printf(\"Path:        %s\\n\", entry.Path)\r\n"]
[1984.398319, "o", "   135\t}\r\n   136\t\r\n   137\tfunc cmdRegister(args []string) {\r\n   138\t\tif len(args) < 2 {\r\n   139\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe register <name> <path>\\n\")\r\n   140\t\t\tos.Exit(1)\r\n   141\t\t}\r\n   142\t\tname := args[0]\r\n"]
[1984.398367, "o", "   143\t\tmodelPath := args[1]\r\n   144\t\r\n   145\t\tabsPath, err := filepath.Abs(modelPath)\r\n   146\t\tif err != nil {\r\n   147\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   148\t\t\tos.Exit(1)\r\n"]
[1984.398425, "o", "   149\t\t}\r\n   150\t\r\n   151\t\tif _, err := os.Stat(filepath.Join(absPath, \"model.meta\")); err != nil {\r\n   152\t\t\tfmt.Fprintf(os.Stderr, \"error: no model.meta found at %s\\n\", absPath)\r\n   153\t\t\tos.Exit(1)\r\n   154\t\t}\r\n   155\t\r\n   156\t\tmeta, err := loadModelMeta(absPath)\r\n   157\t\tif err != nil {\r\n   158\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   159\t\t\tos.Exit(1)\r\n   160\t\t}\r\n"]
