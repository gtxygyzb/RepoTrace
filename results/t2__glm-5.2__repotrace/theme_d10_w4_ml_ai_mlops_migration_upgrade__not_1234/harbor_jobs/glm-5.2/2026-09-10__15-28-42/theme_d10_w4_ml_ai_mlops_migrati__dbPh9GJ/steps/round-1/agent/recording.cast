[11304.541941, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/binary\"\r\n\t\"fmt\"\r\n\t\"math\""]
[11304.54203, "o", "\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nvar modelMagic = []byte(\"MLPW\")\r\n\r\nfunc loadModelMeta(modelDir string) (map[string]string, error) {\r\n\tf, err := os.Open(filepath.Join(modelDir, \"model.meta\"))\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tmeta := make(map[string]string)\r\n\tscanner := bufio.NewScanner(f)\r\n"]
[11304.542094, "o", "\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.SplitN(line, \"=\", 2)\r\n\t\tif len(parts) == 2 {\r\n"]
[11304.542155, "o", "\t\t\tmeta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])\r\n\t\t}\r\n\t}\r\n\treturn meta, scanner.Err()\r\n}\r\n\r\ntype WeightsData struct {\r\n\tVersion     uint32\r\n\tNumFeatures uint32\r\n\tNumOutputs  uint32\r\n\tActivation  uint32\r\n"]
[11304.542213, "o", "\tWeights     []float64\r\n\tBias        []float64\r\n}\r\n\r\nfunc loadWeights(modelDir string) (*WeightsData, error) {\r\n\tf, err := os.Open(filepath.Join(modelDir, \"weights.bin\"))\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tmagic := make([]byte, 4)\r\n"]
[11304.542291, "o", "\tif _, err := f.Read(magic); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to read magic: %v\", err)\r\n\t}\r\n\tif string(magic) != string(modelMagic) {\r\n\t\treturn nil, fmt.Errorf(\"invalid model file: bad magic\")\r\n\t}\r\n\r\n\tvar ver, nf, no uint32\r\n\tif err := binary.Read(f, binary.LittleEndian, &ver); err != nil {\r\n"]
[11304.542351, "o", "\t\treturn nil, fmt.Errorf(\"failed to read version: %v\", err)\r\n\t}\r\n\tif err := binary.Read(f, binary.LittleEndian, &nf); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to read num_features: %v\", err)\r\n\t}\r\n\tif err := binary.Read(f, binary.LittleEndian, &no); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to read num_outputs: %v\", err)\r\n\t}\r\n\r\n\tvar act uint32\r\n\tswitch ver {\r\n\tcase 1:\r\n\t\tact = 0\r\n\tcase 2:\r\n\t\tif err := binary.Read(f, binary.LittleEndian, &act); err != nil {\r\n"]
[11304.542413, "o", "\t\t\treturn nil, fmt.Errorf(\"failed to read activation: %v\", err)\r\n\t\t}\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"unsupported model format version: %d\", ver)\r\n\t}\r\n\r\n\tweights := make([]float64, nf*no)\r\n\tfor i := range weights {\r\n\t\tif err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"failed to read weight[%d]: %v\", i, err)\r\n\t\t}\r\n"]
[11304.542477, "o", "\t}\r\n\r\n\tbias := make([]float64, no)\r\n\tfor i := range bias {\r\n\t\tif err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"failed to read bias[%d]: %v\", i, err)\r\n\t\t}\r\n\t}\r\n\r\n\treturn &WeightsData{\r\n\t\tVersion:     ver,\r\n\t\tNumFeatures: nf,\r\n"]
[11304.542533, "o", "\t\tNumOutputs:  no,\r\n\t\tActivation:  act,\r\n\t\tWeights:     weights,\r\n\t\tBias:        bias,\r\n\t}, nil\r\n}\r\n\r\nfunc writeWeights(path string, w *WeightsData) error {\r\n\tf, err := os.Create(path)\r\n\tif err != nil {\r\n"]
[11304.542588, "o", "\t\treturn err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tif _, err := f.Write(modelMagic); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {\r\n"]
[11304.542646, "o", "\t\treturn err\r\n\t}\r\n\tif err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif w.Version >= 2 {\r\n\t\tif err := binary.Write(f, binary.LittleEndian, w.Activation); err != nil {\r\n\t"]
[11304.542704, "o", "\t\treturn err\r\n\t\t}\r\n\t}\r\n\tfor _, v := range w.Weights {\r\n\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\tfor _, v := range w.Bias {\r\n\t"]
[11304.54276, "o", "\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nconst (\r\n\tactivationNone    = 0\r\n\tactivationSigmoid = 1\r\n"]
[11304.542838, "o", "\tactivationReLU    = 2\r\n\tactivationTanh    = 3\r\n)\r\n\r\nfunc activationNameToID(name string) (uint32, error) {\r\n\tswitch strings.ToLower(name) {\r\n\tcase \"\", \"none\":\r\n\t\treturn activationNone, nil\r\n\tcase \"sigmoid\":\r\n\t\treturn activationSigmoid, nil\r\n\tcase \"relu\":\r\n\t\treturn activationReLU, nil\r\n\tcase \"tanh\":\r\n\t\treturn activationTanh, nil\r\n"]
[11304.542917, "o", "\tdefault:\r\n\t\treturn 0, fmt.Errorf(\"invalid activation\")\r\n\t}\r\n}\r\n\r\nfunc activationIDToName(id uint32) string {\r\n\tswitch id {\r\n\tcase activationNone:\r\n\t\treturn \"none\"\r\n\tcase activationSigmoid:\r\n\t\treturn \"sigmoid\"\r\n\tcase activationReLU:\r\n\t\treturn \"relu\"\r\n\t"]
[11304.542974, "o", "case activationTanh:\r\n\t\treturn \"tanh\"\r\n\tdefault:\r\n\t\treturn \"unknown\"\r\n\t}\r\n}\r\n\r\nfunc applyActivation(x float64, activation uint32) float64 {\r\n\tswitch activation {\r\n\tcase activationSigmoid:\r\n"]
[11304.543035, "o", "\t\treturn 1.0 / (1.0 + math.Exp(-x))\r\n\tcase activationReLU:\r\n\t\tif x < 0 {\r\n\t\t\treturn 0\r\n\t\t}\r\n\t\treturn x\r\n\tcase activationTanh:\r\n\t\treturn math.Tanh(x)\r\n\tdefault:\r\n\t\treturn x\r\n\t}\r\n"]
[11304.54309, "o", "}\r\n\r\nfunc saveModelMeta(modelDir string, meta map[string]string) error {\r\n\tf, err := os.Create(filepath.Join(modelDir, \"model.meta\"))\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n"]
[11304.54315, "o", "\tkeys := make([]string, 0, len(meta))\r\n\tfor k := range meta {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n\tsort.Strings(keys)\r\n\tfor _, k := range keys {\r\n\t\tfmt.Fprintf(f, \"%s=%s\\n\", k, meta[k])\r\n\t}\r\n\treturn nil\r\n}\r\n"]
[11304.543206, "o", "\r\ntype PipelineConfig struct {\r\n\tNormalize       bool\r\n\tScaleMin        float64\r\n\tScaleMax        float64\r\n\tMissingStrategy string\r\n\tRoundDigits     int\r\n\tClipMin         float64\r\n\tClipMax         float64\r\n\tFeatureNames    []string\r\n}\r\n\r\nfunc loadPipelineConfig(modelDir string) (*PipelineConfig, error) {\r\n"]
[11304.543263, "o", "\tf, err := os.Open(filepath.Join(modelDir, \"pipeline.cfg\"))\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tcfg := &PipelineConfig{\r\n\t\tScaleMin:        0.0,\r\n\t\tScaleMax:        1.0,\r\n\t\tMissingStrategy: \"zero\",\r\n\t\tRoundDigits:     4,"]
[11304.543321, "o", "\r\n\t\tClipMin:         -1000.0,\r\n\t\tClipMax:         1000.0,\r\n\t}\r\n\r\n\tscanner := bufio.NewScanner(f)\r\n\tsection := \"\"\r\n\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n"]
[11304.543382, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\r\n\t\t\tsection = line[1 : len(line)-1]\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.SplitN(line, \"=\", 2)\r\n\t\tif len(parts) != 2 {\r\n\t\t\tcontinue\r\n"]
[11304.543441, "o", "\t\t}\r\n\t\tkey := strings.TrimSpace(parts[0])\r\n"]
[11304.543936, "o", "\u001b[?2004h"]
