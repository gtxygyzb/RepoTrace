[9667.337842, "o", "\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: \u001b[01;31m\u001b[Kfeatures\u001b[m\u001b[K and outputs must be positive\\n\")\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: weights[%d] has %d \u001b[01;31m\u001b[Kfeatures\u001b[m\u001b[K, expected %d\\n\", i, len(row), model.Features)\r\n\u001b[35m\u001b[Kexport_import.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tactivationName := model.\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K\r\n"]
