[7607.281082, "o", "func writeOutput(f *os.File, results [][]float64, format string) {\r\n\tswitch format {\r\n\tcase \"csv\":\r\n\t\twriter := csv.NewWriter(f)\r\n\t\theader := make([]string, len(results[0]))\r\n\t\tfor i := range header {\r\n\t"]
[7607.281178, "o", "\t\theader[i] = fmt.Sprintf(\"output_%d\", i)\r\n\t\t}\r\n\t\twriter.Write(header)\r\n\t\tfor _, row := range results {\r\n\t\t\trecord := make([]string, len(row))\r\n\t\t\tfor j, val := range row {\r\n\t\t\t\trecord[j] = strconv.FormatFloat(val, 'f', -1, 64)\r\n\t\t\t}\r\n\t\t\twriter.Write(record)\r\n\t\t}\r\n\t\twriter.Flush()\r\n\tcase \"json\":\r\n\t\ttype Prediction struct {\r\n"]
[7607.28126, "o", "\t\t\tOutputs []float64 `json:\"outputs\"`\r\n\t\t}\r\n\t\ttype Result struct {\r\n\t\t\tPredictions []Prediction `json:\"predictions\"`\r\n\t\t}\r\n\t\tr := Result{}\r\n\t\tfor _, row := range results {\r\n\t\t\tr.Predictions = append(r.Predictions, Prediction{Outputs: row})\r\n\t\t}\r\n\t\tenc := json.NewEncoder(f)\r\n\t\tenc.SetIndent(\"\", \"  \")\r\n\t\tenc.Encode(r)\r\n\t}\r\n"]
[7607.281322, "o", "}\r\n"]
[7607.281767, "o", "\u001b[?2004h"]
