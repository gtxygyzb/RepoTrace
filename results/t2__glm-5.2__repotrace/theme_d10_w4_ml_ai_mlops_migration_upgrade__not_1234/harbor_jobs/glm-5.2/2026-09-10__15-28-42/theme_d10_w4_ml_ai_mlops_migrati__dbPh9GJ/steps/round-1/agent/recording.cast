[11352.432865, "o", "   156\tfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   157\t\tresult := make([][]float64, len(inputs))\r\n   158\t\tfor i, row := range inputs {\r\n   159\t\t\tresult[i] = make([]float64, len(row))\r\n   160\t\t\tcopy(result[i], row)\r\n   161\t\t}\r\n   162\t\r\n   163\t\tif len(result) == 0 {\r\n   164\t\t\treturn result\r\n   165\t\t}\r\n   166\t\r\n   167\t\t"]
[11352.43293, "o", "for i, row := range result {\r\n   168\t\t\tfor j, val := range row {\r\n   169\t\t\t\tif math.IsNaN(val) {\r\n   170\t\t\t\t\tswitch cfg.MissingStrategy {\r\n   171\t\t\t\t\tcase \"zero\":\r\n   172\t\t\t\t\t\tresult[i][j] = 0.0\r\n   173\t\t\t\t\tcase \"mean\":\r\n   174\t\t\t\t\t"]
