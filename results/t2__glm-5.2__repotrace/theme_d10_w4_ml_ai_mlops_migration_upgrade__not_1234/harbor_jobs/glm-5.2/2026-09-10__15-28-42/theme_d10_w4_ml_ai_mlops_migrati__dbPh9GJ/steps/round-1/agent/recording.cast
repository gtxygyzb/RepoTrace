[6157.317301, "o", "# Add cmdProfile before cmdBatch or after cmdStats? Insert before cmdBatch.\r\n\u001b[?2004l\r"]
[6157.317356, "o", "\u001b[?2004h> "]
[6157.317552, "o", "marker='func cmdBatch(args []string) {'\r\n\u001b[?2004l\r"]
[6157.317612, "o", "\u001b[?2004h> "]
[6157.317837, "o", "profile='''func cmdProfile(args []string) {\r\n\u001b[?2004l\r"]
[6157.317894, "o", "\u001b[?2004h> "]
[6157.317992, "o", "\\tif len(args) < 1 {\r\n\u001b[?2004l\r"]
[6157.318047, "o", "\u001b[?2004h> "]
[6157.318294, "o", "\\t\\tfmt.Fprintf(os.Stderr, \"usage: mlpipe profile <model>\\\\n\")\r\n\u001b[?2004l\r"]
[6157.318349, "o", "\u001b[?2004h> "]
[6157.318405, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[6157.318459, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6157.318518, "o", "> "]
[6157.318573, "o", "\\tmodel := args[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[6157.318632, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6157.318767, "o", "\\tentry, err := resolveModel(model)\r\n\u001b[?2004l\r"]
[6157.318826, "o", "\u001b[?2004h> "]
[6157.318884, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[6157.318939, "o", "\u001b[?2004h> "]
[6157.319096, "o", "\\t\\tfmt.Fprintf(os.Stderr, \"error: %v\\\\n\", err)\r\n\u001b[?2004l\r"]
[6157.31915, "o", "\u001b[?2004h> "]
[6157.319197, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[6157.319255, "o", "\u001b[?2004h> "]
[6157.319314, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6157.319542, "o", "\\tweightsPath := filepath.Join(entry.Path, \"weights.bin\")\r\n\u001b[?2004l\r"]
[6157.319597, "o", "\u001b[?2004h> "]
[6157.319715, "o", "\\tinfo, err := os.Stat(weightsPath)\r\n\u001b[?2004l\r"]
[6157.319769, "o", "\u001b[?2004h> "]
[6157.319826, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[6157.319884, "o", "\u001b[?2004h"]
[6157.319941, "o", "> "]
[6157.320021, "o", "\\t\\tfmt.Fprintln(os.Stderr, \"not found\")\r\n\u001b[?2004l\r"]
[6157.320076, "o", "\u001b[?2004h> "]
[6157.320142, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6157.320199, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6157.320258, "o", "\u001b[?2004h> "]
[6157.320441, "o", "\\tweights, _, err := loadModelArtifacts(entry.Path)\r\n\u001b[?2004l\r"]
[6157.320495, "o", "\u001b[?2004h> "]
[6157.320558, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[6157.320615, "o", "> "]
[6157.320823, "o", "\\t\\tfmt.Fprintf(os.Stderr, \"error loading model: %v\\\\n\", err)\r\n\u001b[?2004l\r"]
[6157.320878, "o", "\u001b[?2004h> "]
[6157.320937, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[6157.320991, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6157.32105, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6157.321202, "o", "\\tfeatures := int(weights.NumFeatures)\r\n\u001b[?2004l\r"]
[6157.321257, "o", "\u001b[?2004h> "]
[6157.321378, "o", "\\toutputs := int(weights.NumOutputs)\r\n\u001b[?2004l\r"]
[6157.321434, "o", "\u001b[?2004h> "]
[6157.32158, "o", "\\ttotalParams := features*outputs + outputs\r\n\u001b[?2004l\r"]
[6157.321636, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[6157.321692, "o", "> "]
[6157.321777, "o", "\\tvar wmin, wmax, wsum float64\r\n\u001b[?2004l\r"]
[6157.32181, "o", "\u001b[?2004h> "]
[6157.321885, "o", "\\tzeroCount := 0\r\n\u001b[?2004l\r"]
[6157.321941, "o", "\u001b[?2004h> "]
[6157.322042, "o", "\\tif len(weights.Weights) > 0 {\r\n\u001b[?2004l\r"]
[6157.322097, "o", "\u001b[?2004h> "]
[6157.322194, "o", "\\t\\twmin = weights.Weights[0]\r\n\u001b[?2004l\r"]
[6157.322247, "o", "\u001b[?2004h> "]
[6157.322345, "o", "\\t\\twmax = weights.Weights[0]\r\n\u001b[?2004l\r"]
[6157.3224, "o", "\u001b[?2004h> "]
[6157.322533, "o", "\\t\\tfor _, v := range weights.Weights {\r\n\u001b[?2004l\r"]
[6157.322588, "o", "\u001b[?2004h> "]
[6157.322649, "o", "\\t\\t\\tif v < wmin {\r\n\u001b[?2004l\r"]
[6157.322704, "o", "\u001b[?2004h> "]
[6157.322772, "o", "\\t\\t\\t\\twmin = v\r\n\u001b[?2004l\r\u001b[?2004h"]
[6157.322839, "o", "> \\t\\t\\t}\r\n\u001b[?2004l\r"]
[6157.3229, "o", "\u001b[?2004h> "]
[6157.322958, "o", "\\t\\t\\tif v > wmax {\r\n\u001b[?2004l\r"]
[6157.323016, "o", "\u001b[?2004h> "]
[6157.323069, "o", "\\t\\t\\t\\twmax = v\r\n\u001b[?2004l\r\u001b[?2004h"]
[6157.323129, "o", "> \\t\\t\\t}\r\n\u001b[?2004l\r"]
[6157.323186, "o", "\u001b[?2004h> "]
[6157.323239, "o", "\\t\\t\\twsum += v\r\n\u001b[?2004l\r\u001b[?2004h"]
[6157.323298, "o", "> "]
[6157.323357, "o", "\\t\\t\\tif v == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6157.323445, "o", "\\t\\t\\t\\tzeroCount++\r\n\u001b[?2004l\r"]
[6157.3235, "o", "\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r"]
[6157.323554, "o", "\u001b[?2004h> "]
[6157.323611, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6157.323677, "o", "\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6157.323744, "o", "\\t\\twmin = 0\r\n\u001b[?2004l\r"]
[6157.323804, "o", "\u001b[?2004h> "]
[6157.323865, "o", "\\t\\twmax = 0\r\n\u001b[?2004l\r"]
[6157.323922, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6157.323985, "o", "\\twavg := 0.0\r\n\u001b[?2004l\r"]
[6157.324038, "o", "\u001b[?2004h> "]
[6157.324144, "o", "\\tif len(weights.Weights) > 0 {\r\n\u001b[?2004l\r"]
[6157.324198, "o", "\u001b[?2004h> "]
[6157.32436, "o", "\\t\\twavg = wsum / float64(len(weights.Weights))\r\n\u001b[?2004l\r"]
[6157.324416, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6157.324471, "o", "\u001b[?2004h> "]
[6157.324535, "o", "\\tsparsity := 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[6157.324593, "o", "> "]
[6157.324684, "o", "\\tif len(weights.Weights) > 0 {\r\n\u001b[?2004l\r"]
[6157.324738, "o", "\u001b[?2004h> "]
[6157.324995, "o", "\\t\\tsparsity = float64(zeroCount) / float64(len(weights.Weights)) * 100\r\n\u001b[?2004l\r"]
[6157.32505, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6157.325105, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[6157.325163, "o", "> "]
[6157.3253, "o", "\\tfmt.Printf(\"Name:       %s\\\\n\", entry.Name)\r\n\u001b[?2004l\r"]
[6157.325355, "o", "\u001b[?2004h> "]
[6157.325515, "o", "\\tfmt.Printf(\"Type:       %s\\\\n\", entry.Type)\r\n\u001b[?2004l\r"]
[6157.32557, "o", "\u001b[?2004h> "]
[6157.325745, "o", "\\tfmt.Printf(\"Format:     v%d\\\\n\", weights.Version)\r\n\u001b[?2004l\r"]
[6157.325807, "o", "\u001b[?2004h> "]
[6157.325895, "o", "\\tif weights.Version >= 2 {\r\n\u001b[?2004l\r"]
[6157.32595, "o", "\u001b[?2004h> "]
[6157.326212, "o", "\\t\\tfmt.Printf(\"Activation: %s\\\\n\", activationIDToName(weights.Activation))\r\n\u001b[?2004l\r"]
[6157.32627, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6157.326324, "o", "\u001b[?2004h> "]
[6157.326519, "o", "\\tfmt.Printf(\"Dimensions: %d x %d\\\\n\", features, outputs)\r\n\u001b[?2004l\r"]
[6157.326573, "o", "\u001b[?2004h> "]
