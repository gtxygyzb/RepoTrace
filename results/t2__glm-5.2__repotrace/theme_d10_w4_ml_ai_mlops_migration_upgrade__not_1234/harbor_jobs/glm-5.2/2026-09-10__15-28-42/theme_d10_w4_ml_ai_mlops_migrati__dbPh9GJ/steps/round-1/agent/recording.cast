[3289.484168, "o", "\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kswitch command\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"list\":\r\n\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcmdList(args)\r\n\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"info\":\r\n\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcmdInfo(args)\r\n"]
[3289.484326, "o", "\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"register\":\r\n\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcmdRegister(args)\r\n\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"remove\":\r\n\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcmdRemove(args)\r\n\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"run\":\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcmdRun(args)\r\n\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"stats\":\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcmdStats(args)\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"diff\":\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcmdDiff(args)\r\n\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"batch\":\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcmdBatch(args)\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"validate\":\r\n\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcmdValidate(args)\r\n\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"export\":\r\n\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcmdExport(args)\r\n\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"migrate\":\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcmdMigrate(args)\r\n\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"compat\":\r\n\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcmdCompat(args)\r\n\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"version\":\r"]
[3289.484415, "o", "\n\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"help\":\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tprintUsage()\r\n\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefault:\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tprintUsage()\r\n\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tos.Exit(1)\r\n\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
