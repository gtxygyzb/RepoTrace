[12079.313102, "o", "   406\t\t\tif i < len(weights) {\r\n"]
[12079.313166, "o", "   407\t\t\t\tw = weights[i]\r\n   408\t\t\t}\r\n   409\t\t\tsum += w * v\r\n   410\t\t\tweightSum += w\r\n   411\t\t}\r\n   412\t\tif weightSum == 0 {\r\n"]
[12079.313217, "o", "   413\t\t\treturn meanFloat64(vals)\r\n   414\t\t}\r\n   415\t\treturn sum / weightSum\r\n   416\t}\r\n   417\t\r\n"]
