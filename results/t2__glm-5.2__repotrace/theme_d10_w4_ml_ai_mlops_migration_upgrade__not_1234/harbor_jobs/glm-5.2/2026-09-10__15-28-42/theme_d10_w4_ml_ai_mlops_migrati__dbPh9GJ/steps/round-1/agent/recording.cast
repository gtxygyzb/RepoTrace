[242.881346, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/csv\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
[242.881523, "o", "\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc cmdRun(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe run <model> [--input <file>] [--output <file>] [--format csv|json]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmodelName := args[0]\r\n\tflags := parseFlags(args[1:])\r\n\r\n\tinputFile := flags[\"input\"]\r\n\tif inputFile == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: --input is required\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\toutputFormat := flags[\"format\"]\r\n\tif outputFormat == \"\" {\r\n\t\toutputFormat = \"csv\"\r\n\t}\r\n\tif outputFormat != \"csv\" && outputFormat != \"json\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unsupported format '%s', use 'csv' or 'json'\\n\", outputFormat)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[242.881654, "o", "\r\n\tentry := findEntry(entries, modelName)\r\n\tif entry == nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", modelName)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tweights, err := loadWeights(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tpipelineCfg, err := loadPipelineConfig(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading pipeline config: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tinputs, err := readInputCSV(inputFile)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[242.881737, "o", "\r\n\tresults := runInference(inputs, weights, pipelineCfg)\r\n\r\n\toutputFile := flags[\"output\"]\r\n\tif outputFile != \"\" {\r\n\t\tf, err := os.Create(outputFile)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error creating output file: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tdefer f.Close()\r\n\t\twriteOutput(f, results, outputFormat)\r\n"]
[242.881862, "o", "\t} else {\r\n\t\twriteOutput(os.Stdout, results, outputFormat)\r\n\t}\r\n}\r\n\r\nfunc readInputCSV(path string) ([][]float64, error) {\r\n\tf, err := os.Open(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\treader := csv.NewReader(f)\r\n\trecords, err := reader.ReadAll()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tvar data [][]float64\r\n\tfor i, record := range records {\r\n\t\tif i == 0 && isHeader(record) {\r\n\t\t\tcontinue\r\n\t"]
[242.881956, "o", "\t}\r\n\t\trow := make([]float64, len(record))\r\n\t\tfor j, val := range record {\r\n\t\t\tval = strings.TrimSpace(val)\r\n\t\t\tif val == \"\" || val == \"NA\" || val == \"nan\" {\r\n\t\t\t\trow[j] = math.NaN()\r\n\t\t\t} else {\r\n\t\t\t\trow[j], err = strconv.ParseFloat(val, 64)\r\n\t\t\t\tif err != nil {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"row %d col %d: %v\", i, j, err)\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[242.88203, "o", "\t\t}\r\n\t\tdata = append(data, row)\r\n\t}\r\n\treturn data, nil\r\n}\r\n\r\nfunc isHeader(record []string) bool {\r\n\tfor _, val := range record {\r\n\t\t_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)\r\n\t\tif err == nil {\r\n\t\t\treturn false\r\n"]
[242.882098, "o", "\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n\tprocessed := preprocess(inputs, cfg)\r\n\r\n\tresults := make([][]float64, len(processed))\r\n\tfor i, row := range processed {\r\n\t\toutput := make([]float64, weights.NumOutputs)\r\n\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n\t\t\tsum := weights.Bias[o]\r\n"]
[242.882165, "o", "\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n\t\t\t\tif int(f) < len(row) {\r\n\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\toutput[o] = sum\r\n\t\t}\r\n\t\tresults[i] = output\r\n\t}\r\n\r\n\treturn postprocess(results, cfg)\r\n}\r\n\r\n"]
[242.882264, "o", "func preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n\tresult := make([][]float64, len(inputs))\r\n\tfor i, row := range inputs {\r\n\t\tresult[i] = make([]float64, len(row))\r\n\t\tcopy(result[i], row)\r\n\t}\r\n\r\n\tfor i, row := range result {\r\n\t\tfor j, val := range row {\r\n\t\t\tif math.IsNaN(val) {\r\n\t\t\t\tswitch cfg.MissingStrategy {\r\n\t\t\t\tcase \"zero\":\r\n\t\t\t\t\tresult[i][j] = 0.0\r\n\t\t\t\tcase \"mean\":\r\n\t\t\t\t\tresult[i][j] = computeColumnMean(inputs, j)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t"]
[242.882344, "o", "\t}\r\n\t}\r\n\r\n\tif cfg.Normalize {\r\n\t\tfor j := 0; j < len(result[0]); j++ {\r\n\t\t\tminVal, maxVal := columnMinMax(result, j)\r\n\t\t\trangeVal := maxVal - minVal\r\n\t\t\tif rangeVal == 0 {\r\n"]
[242.882421, "o", "\t\t\t\trangeVal = 1.0\r\n\t\t\t}\r\n\t\t\tfor i := range result {\r\n\t\t\t\t// BUG: normalization formula incorrect - should map to [ScaleMin, ScaleMax]\r\n\t\t\t\t// but uses wrong formula that doesn't properly apply the target range\r\n\t\t\t\tnormalized := (result[i][j] - minVal) / rangeVal\r\n\t\t\t\tresult[i][j] = normalized * cfg.ScaleMax\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\treturn result\r\n}\r\n\r\nfunc postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {\r\n\tfor i, row := range results {\r\n\t\tfor j, val := range row {\r\n\t\t\tval = math.Max(val, cfg.ClipMin)\r\n"]
[242.882495, "o", "\t\t\tval = math.Min(val, cfg.ClipMax)\r\n\t\t\tresults[i][j] = roundToDigits(val, cfg.RoundDigits)\r\n\t\t}\r\n\t}\r\n\treturn results\r\n}\r\n\r\nfunc computeColumnMean(data [][]float64, col int) float64 {\r\n\tsum := 0.0\r\n\tcount := 0\r\n\tfor _, row := range data {\r\n\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n"]
[242.882584, "o", "\t\t\tsum += row[col]\r\n\t\t\tcount++\r\n\t\t}\r\n\t}\r\n\tif count == 0 {\r\n\t\treturn 0.0\r\n\t}\r\n\treturn sum / float64(count)\r\n}\r\n\r\nfunc columnMinMax(data [][]float64, col int) (float64, float64) {\r\n\tminVal := math.Inf(1)\r\n\tmaxVal := math.Inf(-1)\r\n\tfor _, row := range data {\r\n\t\tif col < len(row) {\r\n\t\t\tif row[col] < minVal {\r\n"]
[242.882664, "o", "\t\t\t\tminVal = row[col]\r\n\t\t\t}\r\n\t\t\tif row[col] > maxVal {\r\n\t\t\t\tmaxVal = row[col]\r\n\t"]
[242.88274, "o", "\t\t}\r\n\t\t}\r\n\t}\r\n\treturn minVal, maxVal\r\n}\r\n\r\nfunc writeOutput(f *os.File, results [][]float64, format string) {\r\n\tswitch format {\r\n\tcase \"csv\":\r\n\t\twriter := csv.NewWriter(f)\r\n\t\theader := make([]string, len(results[0]))\r\n\t\tfor i := range header {\r\n\t\t\theader[i] = fmt.Sprintf(\"output_%d\", i)\r\n\t\t}\r\n\t\twriter.Write(header)\r\n\t\tfor _, row := range results {\r\n\t\t\trecord := make([]string, len(row))\r\n\t\t\tfor j, val := range row {\r\n\t\t\t\trecord[j] = strconv.FormatFloat(val, 'f', -1, 64)\r\n\t\t\t}\r\n\t\t\twriter.Write(record)\r\n\t\t"]
[242.882849, "o", "}\r\n\t\twriter.Flush()\r\n\tcase \"json\":\r\n\t\ttype Prediction struct {\r\n\t\t\tOutputs []float64 `json:\"outputs\"`\r\n\t\t}\r\n\t\ttype Result struct {\r\n\t\t\tPredictions []Prediction `json:\"predictions\"`\r\n\t\t}\r\n\t\tr := Result{}\r\n\t\tfor _, row := range results {\r\n\t\t\tr.Predictions = append(r.Predictions, Prediction{Outputs: row})\r\n\t\t}\r\n\t\tenc := json.NewEncoder(f)\r\n\t\tenc.SetIndent(\"\", \"  \")\r\n"]
[242.88292, "o", "\t\tenc.Encode(r)\r\n\t}\r\n}\r\n"]
