[12105.103821, "o", "   374\tfunc combineEnsembleOutputs(allOutputs [][][]float64, strategy string, weights []float64) [][]float64 {\r\n   375\t\tnumRows := len(allOutputs[0])\r\n"]
[12105.10394, "o", "   376\t\tnumOutputs := len(allOutputs[0][0])\r\n   377\t\tcombined := make([][]float64, numRows)\r\n   378\t\tfor i := 0; i < numRows; i++ {\r\n   379\t\t\tcombined[i] = make([]float64, numOutputs)\r\n   380\t\t"]
[12105.104009, "o", "\tfor j := 0; j < numOutputs; j++ {\r\n   381\t\t\t\tvals := make([]float64, len(allOutputs))\r\n   382\t\t\t\tfor k := range allOutputs {\r\n   383\t\t\t\t\tvals[k] = allOutputs[k][i][j]\r\n   384\t\t\t\t}\r\n   385\t\t\t\tswitch strategy {\r\n   386\t\t\t\tcase \"max\":\r\n   387\t\t\t\t\tcombined[i][j] = maxFloat64(vals)\r\n   388\t\t\t\tcase \"min\":\r\n   389\t\t\t\t\tcombined[i][j] = minFloat64(vals)\r\n   390\t\t\t\tdefault:\r\n   391\t\t\t\t\tcombined[i][j] = weightedMeanFloat64(vals, weights)\r\n   392\t\t\t\t}\r\n   393\t\t\t}\r\n   394\t\t}\r\n   395\t\treturn combined\r\n   396\t}\r\n"]
