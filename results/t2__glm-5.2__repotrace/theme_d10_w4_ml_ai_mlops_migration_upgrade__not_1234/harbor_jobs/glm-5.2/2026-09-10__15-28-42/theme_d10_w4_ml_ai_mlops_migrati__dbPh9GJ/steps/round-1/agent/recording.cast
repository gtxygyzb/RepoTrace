[4677.312578, "o", "\t}\r\n\tif !strings.HasSuffix(outputPath, \".json\") {\r\n\t\toutputPath += \".json\"\r\n\t}\r\n\r\n\tentry, err := resolveModel(name)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmeta, err := loadModelMeta(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tweights, err := loadWeights(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcfg, err := loadPipelineConfig(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading pipeline config: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmodelName := meta[\"name\"]\r\n"]
[4677.312648, "o", "\tif modelName == \"\" {\r\n\t\tmodelName = entry.Name\r\n\t}\r\n\tmodelType := meta[\"type\"]\r\n\tif modelType == \"\" {\r\n\t\tmodelType = \"unknown\"\r\n\t}\r\n\tmodelVersion := 1\r\n\tif v, err := strconv.Atoi(meta[\"version\"]); err == nil {\r\n\t\tmodelVersion = v\r\n\t}\r\n\r\n\tactivation := \"none\"\r\n\tif weights.Version == 2 {\r\n\t\tactivation = activationIDToName(weights.Activation)\r\n"]
[4677.312716, "o", "\t}\r\n\r\n\tif int(weights.NumFeatures) <= 0 || int(weights.NumOutputs) <= 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid model dimensions\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif len(weights.Weights) != int(weights.NumFeatures)*int(weights.NumOutputs) {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: corrupt weights matrix\\n\")\r\n\t\tos.Exit(1)"]
[4677.312779, "o", "\r\n\t}\r\n\tif len(weights.Bias) != int(weights.NumOutputs) {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: corrupt bias vector\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[4677.312899, "o", "\tweightMatrix := make([][]float64, weights.NumOutputs)\r\n\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n\t\tstart := o * weights.NumFeatures\r\n\t\tend := start + weights.NumFeatures\r\n\t\trow := make([]float64, weights.NumFeatures)\r\n\t\tcopy(row, weights.Weights[start:end])\r\n\t\tweightMatrix[o] = row\r\n\t}\r\n\r\n\texport := exportModel{\r\n\t\tName:          modelName,\r\n\t\tType:          modelType,\r\n\t\tVersion:       modelVersion,\r\n\t\tFormatVersion: int(weights.Version),\r\n\t\tFeatures:      int(weights.NumFeatures),\r\n"]
