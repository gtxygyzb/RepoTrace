[9603.919652, "o", "    17\t\t}\r\n    18\t\r\n    19\t\tmodelName := args[0]\r\n    20\t\tflags := parseFlags(args[1:])\r\n    21\t\r\n    22\t\tinputFile := flags[\"input\"]\r\n    23\t\tif inputFile == \"\" {\r\n    24\t\t\tfmt.Fprintf(os.Stderr, \"error: --input is required\\n\")\r\n    25\t\t\tos.Exit(1)\r\n"]
[9603.919718, "o", "    26\t\t}\r\n    27\t\r\n    28\t\toutputFormat := flags[\"format\"]\r\n    29\t\tif outputFormat == \"\" {\r\n    30\t\t\toutputFormat = \"csv\"\r\n    31\t\t}\r\n    32\t\tif outputFormat != \"csv\" && outputFormat != \"json\" {\r\n    33\t\t\tfmt.Fprintf(os.Stderr, \"error: unsupported format '%s', use 'csv' or 'json'\\n\", outputFormat)\r\n"]
[9603.919783, "o", "    34\t\t\tos.Exit(1)\r\n    35\t\t}\r\n    36\t\r\n"]
[9603.919857, "o", "    37\t\tentry, err := resolveModel(modelName)\r\n    38\t\tif err != nil {\r\n    39\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    40\t\t\tos.Exit(1)\r\n    41\t\t}\r\n    42\t\r\n    43\t\tweights, err := loadWeights(entry.Path)\r\n    44\t\tif err != nil {\r\n    45\t\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n    46\t\t\tos.Exit(1)\r\n    47\t\t}\r\n    48\t\r\n    49\t\tpipelineCfg, err := loadPipelineConfig(entry.Path)\r\n    50\t\tif err != nil {\r\n    51\t\t\tfmt.Fprintf(os.Stderr, \"error loading pipeline config: %v\\n\", err)\r\n    52\t\t\tos.Exit(1)\r\n    53\t\t}\r\n"]
[9603.919918, "o", "    54\t\r\n    55\t\tinputs, err := readInputCSV(inputFile)\r\n    56\t\tif err != nil {\r\n    57\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    58\t\t\tos.Exit(1)\r\n    59\t\t}\r\n    60\t\r\n    61\t\tif err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {\r\n"]
[9603.919982, "o", "    62\t\t\tfmt.Fprintf(os.Stderr, \"error: input feature count mismatch: %v\\n\", err)\r\n    63\t\t\tos.Exit(1)\r\n    64\t\t}\r\n    65\t\r\n    66\t\tresults := runInference(inputs, weights, pipelineCfg)\r\n"]
[9603.920044, "o", "    67\t\r\n    68\t\toutputFile := flags[\"output\"]\r\n    69\t\tif outputFile != \"\" {\r\n    70\t\t\tf, err := os.Create(outputFile)\r\n    71\t\t\tif err != nil {\r\n    72\t\t\t\tfmt.Fprintf(os.Stderr, \"error creating output file: %v\\n\", err)\r\n    73\t\t\t\tos.Exit(1)\r\n    74\t\t\t}\r\n    75\t\t\tdefer f.Close()\r\n    76\t\t\twriteOutput(f, results, outputFormat)\r\n    77\t\t} else {\r\n    78\t\t\twriteOutput(os.Stdout, results, outputFormat)\r\n    79\t\t}\r\n    80\t}\r\n    81\t"]
[9603.920109, "o", "\r\n    82\tfunc readInputCSV(path string) ([][]float64, error) {\r\n    83\t\tf, err := os.Open(path)\r\n    84\t\tif err != nil {\r\n    85\t\t\treturn nil, err\r\n    86\t\t}\r\n    87\t\tdefer f.Close()\r\n    88\t\r\n    89\t\treader := csv.NewReader(f)\r\n    90\t\trecords, err := reader.ReadAll()\r\n    91"]
[9603.920168, "o", "\t\tif err != nil {\r\n    92\t\t\treturn nil, err\r\n    93\t\t}\r\n    94\t\r\n    95\t\tvar data [][]float64\r\n    96\t\tfor i, record := range records {\r\n    97\t\t\tif i == 0 && isHeader(record) {\r\n    98\t\t\t\tcontinue\r\n    99\t\t\t}\r\n"]
[9603.920228, "o", "   100\t\t\trow := make([]float64, len(record))\r\n   101\t\t\tfor j, val := range record {\r\n   102\t\t\t\tval = strings.TrimSpace(val)\r\n   103\t\t\t\tif val == \"\" || val == \"NA\" || val == \"nan\" {\r\n   104\t\t\t\t\trow[j] = math.NaN()\r\n   105\t\t\t\t} else {\r\n   106\t\t\t\t\trow[j], err = strconv.ParseFloat(val, 64)\r\n   107\t\t\t\t\tif err != nil {\r\n   108\t\t\t\t\t\treturn nil, fmt.Errorf(\"row %d col %d: %v\", i, j, err)\r\n"]
[9603.920286, "o", "   109\t\t\t\t\t}\r\n   110\t\t\t\t}\r\n   111\t\t\t}\r\n   112\t\t\tdata = append(data, row)\r\n   113\t\t}\r\n   114\t\treturn data, nil\r\n   115\t}\r\n   116\t\r\n   117\tfunc isHeader(record []string) bool {"]
[9603.920348, "o", "\r\n   118\t\tfor _, val := range record {\r\n   119\t\t\t_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)\r\n   120\t\t\tif err == nil {\r\n   121\t\t\t\treturn false\r\n   122\t\t\t}\r\n   123\t\t}\r\n   124\t\treturn true\r\n   125\t}\r\n"]
[9603.920408, "o", "   126\t\r\n   127\tfunc runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n   128\t\tprocessed := preprocess(inputs, cfg)\r\n   129\t\r\n   130\t\tresults := make([][]float64, len(processed))\r\n   131\t\tfor i, row := range processed {\r\n   132\t\t\toutput := make([]float64, weights.NumOutputs)\r\n   133\t\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n"]
[9603.920471, "o", "   134\t\t\t\tsum := weights.Bias[o]\r\n   135\t\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n   136\t\t\t\t\tif int(f) < len(row) {\r\n   137\t\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n   138\t\t\t\t\t}\r\n   139\t\t\t\t}\r\n   140\t\t\t\toutput[o] = applyActivation(sum, weights.Activation)\r\n   141\t\t\t}\r\n   142\t\t"]
[9603.920526, "o", "\tresults[i] = output\r\n   143\t\t}\r\n   144\t\r\n   145\t\treturn postprocess(results, cfg)\r\n   146\t}\r\n   147\t\r\n   148\tfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   149\t\tresult := make([][]float64, len(inputs))\r\n"]
[9603.920583, "o", "   150\t\tfor i, row := range inputs {\r\n   151\t\t\tresult[i] = make([]float64, len(row))\r\n   152\t\t\tcopy(result[i], row)\r\n   153\t\t}\r\n   154\t\r\n   155\t\tif len(result) == 0 {\r\n   156\t\t\treturn result\r\n   157\t\t}\r\n   158\t\r\n   159\t\tfor i, row := range result {\r\n   160"]
[9603.920647, "o", "\t\t\tfor j, val := range row {\r\n   161\t\t\t\tif math.IsNaN(val) {\r\n   162\t\t\t\t\tswitch cfg.MissingStrategy {\r\n   163\t\t\t\t\tcase \"zero\":\r\n"]
[9603.920707, "o", "   164\t\t\t\t\t\tresult[i][j] = 0.0\r\n   165\t\t\t\t\tcase \"mean\":\r\n   166\t\t\t\t\t\tresult[i][j] = computeColumnMean(inputs, j)\r\n   167\t\t\t\t\t}\r\n   168\t\t\t\t}\r\n   169\t\t\t}\r\n   170\t\t}\r\n   171\t\r\n   172\t\tif cfg.Normalize {\r\n"]
[9603.920767, "o", "   173\t\t\tfor j := 0; j < len(result[0]); j++ {\r\n   174\t\t\t\tminVal, maxVal := columnMinMax(result, j)\r\n   175\t\t\t\trangeVal := maxVal - minVal\r\n   176\t\t\t\tif rangeVal == 0 {\r\n   177\t\t\t\t\trangeVal = 1.0\r\n   178\t\t\t\t}\r\n   179\t\t\t\tfor i := range result {\r\n   180\t\t\t\t\tnormalized := (result[i][j] - minVal) / rangeVal\r\n"]
[9603.920834, "o", "   181\t\t\t\t\tresult[i][j] = cfg.ScaleMin + normalized*(cfg.ScaleMax-cfg.ScaleMin)\r\n   182\t\t\t\t}\r\n   183\t\t\t}\r\n   184\t\t}\r\n   185\t\r\n   186\t\treturn result\r\n   187\t}\r\n   188\t\r\n   189\tfunc postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   190\t\tfor i, row := range results {\r\n   191"]
[9603.920893, "o", "\t\t\tfor j, val := range row {\r\n   192\t\t\t\tval = math.Max(val, cfg.ClipMin)\r\n   193\t\t\t\tval = math.Min(val, cfg.ClipMax)\r\n   194\t\t\t\tresults[i][j] = roundToDigits(val, cfg.RoundDigits)\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197\t\treturn results\r\n   198\t}\r\n   199\t"]
[9603.920955, "o", "\r\n   200\tfunc computeColumnMean(data [][]float64, col int) float64 {\r\n   201\t\tsum := 0.0\r\n   202\t\tcount := 0\r\n   203\t\tfor _, row := range data {\r\n   204\t\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n   205\t\t\t\tsum += row[col]\r\n   206\t\t\t\tcount++\r\n"]
[9603.921011, "o", "   207\t\t\t}\r\n   208\t\t}\r\n   209\t\tif count == 0 {\r\n   210\t\t\treturn 0.0\r\n   211\t\t}\r\n   212\t\treturn sum / float64(count)\r\n   213\t}\r\n   214\t\r\n   215\t"]
[9603.921077, "o", "func columnMinMax(data [][]float64, col int) (float64, float64) {\r\n   216\t\tminVal := math.Inf(1)\r\n   217\t\tmaxVal := math.Inf(-1)\r\n   218\t\tfor _, row := range data {\r\n"]
[9603.921137, "o", "   219\t\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n   220\t\t\t\tif row[col] < minVal {\r\n   221\t\t\t\t\tminVal = row[col]\r\n   222\t\t\t\t}\r\n   223\t\t\t\tif row[col] > maxVal {\r\n   224\t\t\t\t\tmaxVal = row[col]\r\n   225\t\t\t\t}\r\n   226\t\t\t}\r\n   227\t\t}\r\n   228\t\treturn minVal, maxVal\r\n   229\t}\r\n   230\t\r\n   231\tfunc writeOutput(f *os.File, results [][]float64, format string) {\r\n   232\t\tswitch format {\r\n   233\t\tcase \"csv\":\r\n"]
[9603.921202, "o", "   234\t\t\twriter := csv.NewWriter(f)\r\n   235\t\t\theader := make([]string, len(results[0]))\r\n   236\t\t\tfor i := range header {\r\n   237\t\t\t\theader[i] = fmt.Sprintf(\"output_%d\", i)\r\n   238\t\t\t}\r\n   239\t\t\twriter.Write(header)\r\n   240\t\t\tfor _, row := range results {\r\n   241\t\t\t\trecord := make([]string, len(row))\r\n   242\t\t\t\tfor j, val := range row {\r\n"]
[9603.921261, "o", "   243\t\t\t\t\trecord[j] = strconv.FormatFloat(val, 'f', -1, 64)\r\n   244\t\t\t\t}\r\n   245\t\t\t\twriter.Write(record)\r\n   246\t\t\t}\r\n   247\t\t\twriter.Flush()\r\n   248\t\tcase \"json\":\r\n   249\t\t\ttype Prediction struct {\r\n   250\t\t\t\tOutputs []float64 `json:\"outputs\"`\r\n"]
[9603.921321, "o", "   251\t\t\t}\r\n   252\t\t\ttype Result struct {\r\n   253\t\t\t\tPredictions []Prediction `json:\"predictions\"`\r\n   254\t\t\t}\r\n   255\t\t\tr := Result{}\r\n   256\t\t\tfor _, row := range results {\r\n   257\t\t\t\tr.Predictions = append(r.Predictions, Prediction{Outputs: row})\r\n   258\t\t\t}\r\n   259\t\t\tenc := json.NewEncoder(f)\r\n   260\t\t\tenc.SetIndent(\"\", \"  \")\r\n"]
