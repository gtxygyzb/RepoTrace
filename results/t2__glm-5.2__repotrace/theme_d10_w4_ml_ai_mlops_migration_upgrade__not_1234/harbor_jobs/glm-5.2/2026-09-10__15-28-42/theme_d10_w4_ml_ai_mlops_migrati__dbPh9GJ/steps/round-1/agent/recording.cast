[1889.363527, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"os\"\r\n     6\t\t\"strings\"\r\n     7\t"]
[1889.3636, "o", ")\r\n     8\t\r\n     9\tconst version = \"0.1.0\"\r\n    10\t\r\n    11\tfunc main() {\r\n    12\t\tif len(os.Args) < 2 {\r\n    13\t\t\tprintUsage()\r\n    14\t\t\tos.Exit(1)\r\n    15\t\t}\r\n    16\t\r\n    17\t\t"]
[1889.363659, "o", "command := os.Args[1]\r\n    18\t\targs := os.Args[2:]\r\n    19\t\r\n    20\t\tswitch command {\r\n    21\t\tcase \"list\":\r\n    22\t\t\tcmdList(args)\r\n    23\t\tcase \"info\":\r\n    24\t\t\tcmdInfo(args)\r\n"]
[1889.363715, "o", "    25\t\tcase \"register\":\r\n    26\t\t\tcmdRegister(args)\r\n    27\t\tcase \"remove\":\r\n    28\t"]
[1889.363771, "o", "\t\tcmdRemove(args)\r\n    29\t\tcase \"run\":\r\n    30\t\t\tcmdRun(args)\r\n    31\t\tcase \"stats\":\r\n    32\t\t\tcmdStats(args)\r\n    33\t\tcase \"diff\":\r\n    34\t\t\tcmdDiff(args)\r\n"]
[1889.363867, "o", "    35\t\tcase \"batch\":\r\n    36\t\t\tcmdBatch(args)\r\n    37\t\tcase \"validate\":\r\n    38\t\t\tcmdValidate(args)\r\n    39\t\tcase \"export\":\r\n    40\t\t\tcmdExport(args)\r\n    41\t\tcase \"version\":\r\n    42\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n"]
[1889.363927, "o", "    43\t\tcase \"help\":\r\n    44\t\t\tprintUsage()\r\n    45\t\tdefault:\r\n    46\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    47\t\t\tprintUsage()\r\n    48\t\t\tos.Exit(1)\r\n    49\t\t}\r\n    50\t}\r\n    51\t\r\n    52\tfunc printUsage() {\r\n"]
[1889.363982, "o", "    53\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    54\t\r\n    55\tUsage: mlpipe <command> [arguments]\r\n    56\t\r\n    57\tCommands:\r\n    58\t  list                          List all registered models\r\n    59\t  info <model>                  Show model details\r\n    60\t  register <name> <path>        Register a model from directory\r\n    61\t  remove <name>                 Remove a model from registry\r\n    62\t  run <model> [options]         Run inference\r\n    63\t  stats --input <file>          Input statistics profiling\r\n"]
[1889.36404, "o", "    64\t  diff <model1> <model2> --input <file>\r\n    65\t                                Compare two models on same input\r\n    66\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n    67\t                                Batch inference over CSV files\r\n    68\t  validate <model>              Validate model integrity\r\n    69\t  export <model> --output <dir> Export model to directory\r\n    70\t  version                       Show version\r\n    71\t"]
[1889.364151, "o", "  help                          Show this help\r\n    72\t\r\n    73\tRun/Diff Options:\r\n    74\t"]
