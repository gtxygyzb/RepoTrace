[8961.913909, "o", "inputs, err := readInputCSV(inputFile)\r\n   173\tif err != nil {\r\n   174\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n   175\tos.Exit(1)\r\n   176\t}\r\n   177\t\r\n   178\tentries, err := loadRegistry()\r\n   179\tif err != nil {\r\n   180\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   181\tos.Exit(1)\r\n   182\t}\r\n   183\t\r\n   184\tvar allOutputs [][][]float64\r\n   185\tvar featureCount int\r\n   186\tfor i, modelName := range cfg.Models {\r\n   187\tentry := findEntry(entries, modelName)\r\n   188\tif entry == nil {\r\n   189\tfmt.Printf(\"model not found: %s\\n\", modelName)\r\n   190\tos.Exit(1)\r\n   191\t}\r\n   192\t\r\n   193\tweights, err := loadWeights(entry.Path)\r\n   194\tif err != nil {\r\n   195\tfmt.Fprintf(os.Stderr, \"error loading weights for model '%s': %v\\n\", modelName, err)\r\n   196\tos.Exit(1)\r\n   197\t}\r\n   198\t\r\n   199\tif i == 0 {\r\n   200\tfeatureCount = int(weights.NumFeatures)\r\n   201\t} else if int(weights.NumFeatures) != featureCount {\r\n   202\tfmt.Println(\"feature mismatch\")\r\n   203"]
