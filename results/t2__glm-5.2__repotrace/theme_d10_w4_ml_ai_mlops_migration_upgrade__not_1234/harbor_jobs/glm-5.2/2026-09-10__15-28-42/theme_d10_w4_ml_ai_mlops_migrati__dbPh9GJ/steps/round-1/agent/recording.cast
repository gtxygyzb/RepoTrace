[12683.74756, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tw1, cfg1, err := loadModelArtifacts(entry1.Path)\r\n\tif err != nil {\r\n"]
[12683.747722, "o", "\t\tfmt.Fprintf(os.Stderr, \"error loading model '%s': %v\\n\", model1, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tw2, cfg2, err := loadModelArtifacts(entry2.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading model '%s': %v\\n\", model2, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif w1.NumFeatures != w2.NumFeatures {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: models have different input feature counts: %s=%d, %s=%d\\n\", model1, w1.NumFeatures, model2, w2.NumFeatures)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tinputs, err := readInputCSV(input)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif err := validateFeatureCount(inputs, int(w1.NumFeatures)); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: input feature count mismatch: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tr1 := runInference(inputs, w1, cfg1)\r\n\tr2 := runInference(inputs, w2, cfg2)\r\n\r\n"]
[12683.747859, "o", "\tmaxOut := minInt(int(w1.NumOutputs), int(w2.NumOutputs))\r\n\tif int(w1.NumOutputs) != int(w2.NumOutputs) {\r\n\t\tfmt.Printf(\"note: model output dimension mismatch: %s=%d, %s=%d; comparing %d output(s)\\n\", model1, w1.NumOutputs, model2, w2.NumOutputs, maxOut)\r\n\t}\r\n\r\n\tvar sumAbs, sumSq, maxAbs float64\r\n\tcount := 0\r\n\tfor i := 0; i < len(r1) && i < len(r2); i++ {\r\n\t\tdiffs := make([]float64, maxOut)\r\n\t\tfor o := 0; o < maxOut; o++ {\r\n\t\t\td := math.Abs(r1[i][o] - r2[i][o])\r\n\t\t\tdiffs[o] = d\r\n\t\t\tsumAbs += d\r\n\t\t\tsumSq += d * d\r\n\t\t\tif d > maxAbs {\r\n\t\t\t\tmaxAbs = d\r\n\t\t\t}\r\n\t\t\tcount++\r\n"]
[12683.747956, "o", "\t\t}\r\n\t\tfmt.Printf(\"row %d: %v\\n\", i, diffs)\r\n\t}\r\n\r\n\t"]
[12683.748049, "o", "var mae, rmse float64\r\n\tif count > 0 {\r\n\t\tmae = sumAbs / float64(count)\r\n\t\trmse = math.Sqrt(sumSq / float64(count))\r\n\t}\r\n\r\n\tfmt.Printf(\"MAE: %.4f\\n\", mae)\r\n\tfmt.Printf(\"RMSE: %.4f\\n\", rmse)\r\n\tfmt.Printf(\"Max Abs Error: %.4f\\n\", maxAbs)\r\n}\r\n\r\nfunc formatFloatList(vals []float64) string {\r\n\tparts := make([]string, len(vals))\r\n\tfor i, v := range vals {\r\n\t\tparts[i] = formatFloat(v)\r\n\t}\r\n\treturn \"[\" + strings.Join(parts, \" \") + \"]\"\r\n}\r\n\r\n"]
