[1915.976304, "o", "\t\"math\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t)\r\n    13\t\r\n    14\tfunc modelDirExists(path string) bool {\r\n    15\t\tinfo, err := os.Stat(path)\r\n    16"]
[1915.976362, "o", "\t\treturn err == nil && info.IsDir()\r\n    17\t}\r\n    18\t\r\n    19\tfunc resolveModel(name string) (*RegistryEntry, error) {\r\n    20\t\tentries, err := loadRegistry()\r\n    21\t\tif err != nil {\r\n    22\t\t\treturn nil, err\r\n    23\t\t}\r\n    24\t\tentry := findEntry(entries, name)\r\n    25\t"]
[1915.976422, "o", "\tif entry == nil {\r\n    26\t\t\treturn nil, fmt.Errorf(\"model '%s' not found\", name)\r\n    27\t\t}\r\n    28\t\tif !modelDirExists(entry.Path) {\r\n    29\t\t\treturn nil, fmt.Errorf(\"model directory not found\")\r\n    30\t\t}\r\n    31\t\treturn entry, nil\r\n    32\t}\r\n"]
[1915.976478, "o", "    33\t\r\n    34\tfunc loadModelArtifacts(modelDir string) (*WeightsData, *PipelineConfig, error) {\r\n    35\t\tweights, err := loadWeights(modelDir)\r\n    36\t\tif err != nil {\r\n    37\t\t\treturn nil, nil, err\r\n    38\t\t}\r\n    39\t\tcfg, err := loadPipelineConfig(modelDir)\r\n    40\t\tif err != nil {\r\n    41\t\t\treturn nil, nil, err\r\n"]
[1915.976528, "o", "    42\t\t}\r\n    43\t\treturn weights, cfg, nil\r\n    44\t}\r\n"]
[1915.976583, "o", "    45\t\r\n    46\tfunc validateFeatureCount(inputs [][]float64, expected int) error {\r\n    47\t\tfor i, row := range inputs {\r\n    48\t\t\tif len(row) != expected {\r\n    49\t\t\t\treturn fmt.Errorf(\"expected %d features, got %d in row %d\", expected, len(row), i)\r\n    50\t\t\t}\r\n    51\t\t}\r\n    52\t\treturn nil\r\n    53\t}\r\n    54\t\r\n    55\tfunc readCSVRaw(path string) ([][]string, error) {\r\n    56\t\tf, err := os.Open(path)\r\n"]
[1915.976637, "o", "    57\t\tif err != nil {\r\n    58\t\t\treturn nil, err\r\n    59\t\t}\r\n    60\t\tdefer f.Close()\r\n    61\t\r\n    62\t\treader := csv.NewReader(f)\r\n    63\t\treader.FieldsPerRecord = -1\r\n"]
[1915.976689, "o", "    64\t\treturn reader.ReadAll()\r\n    65\t}\r\n    66\t\r\n"]
[1915.97672, "o", "    67\tfunc isMissingValue(val string) bool {\r\n    68\t\tval = strings.TrimSpace(val)\r\n    69\t\tif val == \"\" {\r\n    70\t\t\treturn true\r\n    71\t\t}\r\n    72\t\tlower := strings.ToLower(val)\r\n    73\t\treturn lower == \"na\" || lower == \"nan\"\r\n    74\t}\r\n    75\t\r\n    76\tfunc cmdStats(args []string) {"]
[1915.976821, "o", "\r\n    77\t\tflags := parseFlags(args)\r\n    78\t\tinput := flags[\"input\"]\r\n    79\t\tif input == \"\" {\r\n    80\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe stats --input <file>\\n\")\r\n    81\t\t\tos.Exit(1)\r\n    82\t\t}\r\n    83\t\r\n    84\t\trecords, err := readCSVRaw(input)\r\n    85\t\tif err != nil {\r\n"]
[1915.976878, "o", "    86\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    87\t\t\tos.Exit(1)\r\n    88\t\t}\r\n    89\t\tif len(records) == 0 {\r\n    90\t\t\tfmt.Println(\"No data found.\")\r\n    91\t\t\treturn\r\n    92\t\t}\r\n    93\t\r\n    94\t\thasHeader := isHeader(records[0])\r\n    95\t\tstart := 0\r\n"]
[1915.976931, "o", "    96\t\tif hasHeader {\r\n    97\t\t\tstart = 1\r\n    98\t\t}\r\n"]
[1915.976984, "o", "    99\t\r\n   100\t\tnumCols := 0\r\n   101\t\tfor _, rec := range records {\r\n   102\t\t\tif len(rec) > numCols {\r\n   103\t\t\t\tnumCols = len(rec)\r\n   104\t\t\t}\r\n   105\t\t}\r\n   106\t\r\n"]
[1915.977039, "o", "   107\t\theaders := make([]string, numCols)\r\n   108\t\tfor i := 0; i < numCols; i++ {\r\n   109\t\t\tif hasHeader && i < len(records[0]) {\r\n   110\t\t\t\theaders[i] = strings.TrimSpace(records[0][i])\r\n   111\t\t\t} else {\r\n   112\t\t\t\theaders[i] = fmt.Sprintf(\"col_%d\", i)\r\n   113\t\t\t}\r\n   114\t\t}\r\n   115\t\r\n   116\t\ttype colStat struct {\r\n   117\t\t\tidx     int\r\n   118\t\t\tname    string\r\n   119\t"]
[1915.977092, "o", "\t\tcount   int\r\n   120\t\t\tmissing int\r\n"]
[1915.977144, "o", "   121\t\t\tmin     float64\r\n   122\t\t\tmax     float64\r\n   123\t\t\tmean    float64\r\n   124\t\t\tstddev  float64\r\n   125\t\t\tvalues  []float64\r\n   126\t\t}\r\n   127\t\r\n   128\t\tvar stats []colStat\r\n"]
[1915.977199, "o", "   129\t\tnumericCols := make([]int, 0)\r\n   130\t\tvaluesByCol := make(map[int][]float64)\r\n   131\t\r\n   132\t\tfor j := 0; j < numCols; j++ {\r\n   133\t\t\tvalues := make([]float64, 0, len(records)-start)\r\n   134\t\t\tmissing := 0\r\n   135\t\t\tnumeric := true\r\n   136\t\r\n   137\t\t\tfor i := start; i < len(records); i++ {\r\n   138\t\t\t\traw := \"\"\r\n   139\t\t\t\tif j < len(records[i]) {\r\n"]
[1915.977259, "o", "   140\t\t\t\t\traw = strings.TrimSpace(records[i][j])\r\n   141\t\t\t\t}\r\n   142\t\t\t\tif isMissingValue(raw) {\r\n   143\t\t\t\t\tmissing++\r\n   144\t\t\t\t\tvalues = append(values, math.NaN())\r\n"]
[1915.977311, "o", "   145\t\t\t\t\tcontinue\r\n   146\t\t\t\t}\r\n   147\t\t\t\tv, err := strconv.ParseFloat(raw, 64)\r\n   148\t\t\t\tif err != nil {\r\n   149\t"]
[1915.977337, "o", "\t\t\t\tnumeric = false\r\n   150\t\t\t\t\tbreak\r\n   151\t\t\t\t}\r\n   152\t\t\t\tvalues = append(values, v)\r\n   153\t\t\t}\r\n   154\t\r\n   155\t\t\tif !numeric {\r\n   156\t\t\t\tcontinue\r\n   157"]
[1915.977405, "o", "\t\t\t}\r\n   158\t\r\n   159\t\t\tcount := len(values) - missing\r\n   160\t\t\tst := colStat{\r\n   161\t\t\t\tidx:     j,\r\n   162\t\t\t\tname:    headers[j],\r\n   163\t\t\t\tcount:   count,\r\n   164\t\t\t\tmissing: missing,\r\n"]
[1915.977455, "o", "   165\t\t\t\tmin:     math.NaN(),\r\n   166\t\t\t\tmax:     math.NaN(),\r\n   167\t\t\t\tmean:    math.NaN(),\r\n"]
[1915.977508, "o", "   168\t\t\t\tstddev:  math.NaN(),\r\n   169\t\t\t\tvalues:  values,\r\n   170\t\t\t}\r\n   171\t\r\n   172\t\t\tif count > 0 {\r\n   173\t\t\t\tsum := 0.0\r\n   174\t\t\t\tsumSq := 0.0\r\n"]
[1915.977561, "o", "   175\t\t\t\tminVal := math.Inf(1)\r\n   176\t\t\t\tmaxVal := math.Inf(-1)\r\n   177\t\t\t\tfor _, v := range values {\r\n   178\t\t\t\t\tif math.IsNaN(v) {\r\n   179\t\t\t\t\t\tcontinue\r\n   180\t\t\t\t\t}\r\n"]
