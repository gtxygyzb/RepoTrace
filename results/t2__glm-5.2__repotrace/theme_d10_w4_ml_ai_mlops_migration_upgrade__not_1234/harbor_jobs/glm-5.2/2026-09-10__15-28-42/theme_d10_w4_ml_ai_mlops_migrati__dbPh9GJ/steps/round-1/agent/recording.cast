[4664.559498, "o", "func cmdClone(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe clone <model> <new_name>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tsourceName := args[0]\r\n\tnewName := args[1]\r\n\r\n\t"]
[4664.559594, "o", "entry, err := resolveModel(sourceName)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif findEntry(entries, newName) != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model already exists\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tnewDir := filepath.Join(\"/app/models\", newName)\r\n"]
[4664.559673, "o", "\tif err := os.MkdirAll(newDir, 0755); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif err := copyDir(entry.Path, newDir); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error cloning model files: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmeta, err := loadModelMeta(newDir)\r\n\tif err != nil {\r\n\t"]
[4664.559736, "o", "\tfmt.Fprintf(os.Stderr, \"error updating metadata: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tmeta[\"name\"] = newName\r\n\tif err := saveModelMeta(newDir, meta); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error updating metadata: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[4664.55983, "o", "\tregistryVersion := entry.Version\r\n\tif registryVersion == 0 {\r\n\t\tregistryVersion = 1\r\n\t}\r\n\tentries = append(entries, RegistryEntry{\r\n\t\tName:    newName,\r\n\t\tPath:    newDir,\r\n\t\tType:    entry.Type,\r\n\t\tVersion: registryVersion,\r\n\t\tCreated: time.Now().Format(\"2006-01-02\"),\r\n\t})\r\n\tif err := saveRegistry(entries); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t"]
[4664.559892, "o", "\tos.Exit(1)\r\n\t}\r\n\tfmt.Printf(\"Model '%s' cloned to '%s'.\\n\", sourceName, newName)\r\n}\r\n"]
