[4623.596598, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"os\"\r\n"]
[4623.596651, "o", "     6\t\t\"strings\"\r\n     7\t)\r\n     8\t\r\n     9\tconst version = \"0.1.0\"\r\n    10\t\r\n    11\tfunc main() {\r\n    12\t\tif len(os.Args) < 2 {\r\n    13\t\t\tprintUsage()\r\n"]
[4623.596751, "o", "    14\t\t\tos.Exit(1)\r\n    15\t\t}\r\n    16\t\r\n    17\t\tcommand := os.Args[1]\r\n    18\t\targs := os.Args[2:]\r\n    19\t\r\n    20\t\tswitch command {\r\n    21\t\tcase \"list\":\r\n    22\t\t\tcmdList(args)\r\n    23\t\tcase \"info\":\r\n    24\t\t\tcmdInfo(args)\r\n    25\t\tcase \"register\":\r\n    26\t\t\tcmdRegister(args)\r\n    27\t\tcase \"remove\":\r\n    28\t\t\tcmdRemove(args)\r\n    29\t\t"]
[4623.596839, "o", "case \"tag\":\r\n    30\t\t\tcmdTag(args)\r\n    31\t\tcase \"untag\":\r\n    32\t\t\tcmdUntag(args)\r\n    33\t\tcase \"search\":\r\n    34\t\t\tcmdSearch(args)\r\n    35\t\tcase \"run\":\r\n    36\t\t\tcmdRun(args)\r\n    37\t\tcase \"stats\":\r\n    38\t\t\tcmdStats(args)\r\n    39\t"]
[4623.596901, "o", "\tcase \"diff\":\r\n    40\t\t\tcmdDiff(args)\r\n    41\t\tcase \"batch\":\r\n    42\t\t\tcmdBatch(args)\r\n    43\t\tcase \"validate\":\r\n    44\t\t\tcmdValidate(args)\r\n    45\t\tcase \"export\":\r\n    46\t"]
[4623.596959, "o", "\t\tcmdExport(args)\r\n    47\t\tcase \"import\":\r\n    48\t\t\tcmdImport(args)\r\n    49\t\tcase \"clone\":\r\n    50\t\t\tcmdClone(args)\r\n    51\t\tcase \"migrate\":\r\n    52\t\t\tcmdMigrate(args)\r\n    53\t\tcase \"compat\":\r\n"]
[4623.597019, "o", "    54\t\t\tcmdCompat(args)\r\n    55\t\tcase \"version\":\r\n    56\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    57\t\tcase \"help\":\r\n    58\t\t\tprintUsage()\r\n    59\t\tdefault:\r\n    60\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    61\t\t\tprintUsage()\r\n    62\t\t\tos.Exit(1)\r\n"]
[4623.597082, "o", "    63\t\t}\r\n    64\t}\r\n    65\t\r\n    66\tfunc printUsage() {\r\n    67\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    68\t\r\n    69\tUsage: mlpipe <command> [arguments]\r\n    70\t\r\n    71\tCommands:\r\n    72\t  list                          List all registered models"]
[4623.597147, "o", "\r\n    73\t  info <model>                  Show model details\r\n    74\t  register <name> <path>        Register a model from directory\r\n    75\t  remove <name>                 Remove a model from registry\r\n    76\t  run <model> [options]         Run inference\r\n    77\t  stats --input <file>          Input statistics profiling\r\n    78\t  diff <model1> <model2> --input <file>\r\n    79\t                                Compare two models on same input\r\n    80\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n    81"]
[4623.597214, "o", "\t                                Batch inference over CSV files\r\n    82\t  validate <model>              Validate model integrity\r\n    83\t  export <model> --output <file> Export model to JSON file\r\n    84\t  import <path> [--name <name>] Import model from JSON file\r\n    85\t  clone <model> <new_name>      Clone model to new name\r\n    86\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n    87\t"]
[4623.597275, "o", "  compat [--all]                 Check migration compatibility\r\n    88\t  version                       Show version\r\n    89\t  help                          Show this help\r\n    90\t\r\n"]
