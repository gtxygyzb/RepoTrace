[13664.969076, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\np = Path('format.go')\ns = p.read_text()\n\nold_imports = '''import (\n\t\"bufio\"\n\t\"encoding/binary\"\n\t\"fmt\"\n\t\"math\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n)'''\nnew_imports = '''import (\n\t\"bufio\"\n\t\"encoding/binary\"\n\t\"fmt\"\n\t\"hash\"\n\t\"hash/crc32\"\n\t\"io\"\n\t\"math\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n)'''\nif old_imports not in s:\n    raise SystemExit('import block not found')\ns = s.replace(old_imports, new_imports, 1)\n\nnew_load = '''func loadWeights(modelDir string) (*WeightsData, error) {\n\tf, err := os.Open(filepath.Join(modelDir, \"weights.bin\"))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer f.Close()\n\n\tmagic := make([]byte, 4)\n\tif _, err := f.Read(magic); err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to read magic: %v\", err)\n\t}\n\tif string(magic) != string(modelMagic) {\n\t\treturn nil, fmt.Errorf(\"invalid model file: bad magic\")\n\t}\n\n\tvar ver, nf, no uint32\n\tif err := binary.Read(f, binary.LittleEndian, &ver); err != nil {\n\t\treturn nil, fmt.Err"]
[13664.969368, "i", "orf(\"failed to read version: %v\", err)\n\t}\n\n\tvar hasher hash.Hash32\n\tr := f\n\tif ver == 3 {\n\t\thasher = crc32.NewIEEE()\n\t\tif _, err := hasher.Write(magic); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to compute checksum: %v\", err)\n\t\t}\n\t\tif err := binary.Write(hasher, binary.LittleEndian, ver); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to compute checksum: %v\", err)\n\t\t}\n\t\tr = io.TeeReader(f, hasher)\n\t}\n\n\tif err := binary.Read(r, binary.LittleEndian, &nf); err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to read num_features: %v\", err)\n\t}\n\tif err := binary.Read(r, binary.LittleEndian, &no); err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to read num_outputs: %v\", err)\n\t}\n\n\tvar act uint32\n\tswitch ver {\n\tcase 1:\n\t\tact = 0\n\tcase 2, 3:\n\t\tif err := binary.Read(r, binary.LittleEndian, &act); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to read activation: %v\", err)\n\t\t}\n\tdefault:\n\t\treturn nil, fmt.Errorf(\"unsupported model format version: %d\", ver)\n\t}\n\n\tweights := make([]float64, nf*no)\n\tfor i := range weights {\n\t\ti"]
[13664.969414, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[13664.969544, "i", "f err := binary.Read(r, binary.LittleEndian, &weights[i]); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to read weight[%d]: %v\", i, err)\n\t\t}\n\t}\n\n\tbias := make([]float64, no)\n\tfor i := range bias {\n\t\tif err := binary.Read(r, binary.LittleEndian, &bias[i]); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to read bias[%d]: %v\", i, err)\n\t\t}\n\t}\n\n\tif ver == 3 {\n\t\tvar checksum uint32\n\t\tif err := binary.Read(f, binary.LittleEndian, &checksum); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to read checksum: %v\", err)\n\t\t}\n\t\tif hasher.Sum32() != checksum {\n\t\t\treturn nil, fmt.Errorf(\"checksum mismatch\")\n\t\t}\n\t}\n\n\treturn &WeightsData{\n\t\tVersion:     ver,\n\t\tNumFeatures: nf,\n\t\tNumOutputs:  no,\n\t\tActivation:  act,\n\t\tWeights:     weights,\n\t\tBias:        bias,\n\t}, nil\n}'''\n\ns = re.sub(r'func loadWeights\\(modelDir string\\) \\(\\*WeightsData, error\\) \\{.*?\\n\\}\\n\\nfunc writeWeights', new_load + '\\n\\nfunc writeWeights', s, count=1, flags=re.S)\n\nnew_write = '''func writeWeights(path string, w *WeightsData) error {\n\tf, err := os.Crea"]
