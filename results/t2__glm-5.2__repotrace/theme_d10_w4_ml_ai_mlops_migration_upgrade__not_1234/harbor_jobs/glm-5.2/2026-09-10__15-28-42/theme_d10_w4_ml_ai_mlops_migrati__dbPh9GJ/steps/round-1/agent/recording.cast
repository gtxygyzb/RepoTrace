[6174.597461, "o", "   360\t\r\n   361\tfunc minInt(a, b int) int {\r\n   362\t\tif a < b {\r\n   363\t\t\treturn a\r\n   364\t\t}\r\n   365\t\t"]
[6174.597532, "o", "return b\r\n   366\t}\r\n   367\t\r\n   368\tfunc cmdProfile(args []string) {\r\n   369\t\tif len(args) < 1 {\r\n   370\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe profile <model>\\n\")\r\n   371\t\t\tos.Exit(1)\r\n   372\t\t}\r\n   373\t\tmodel := args[0]\r\n   374\t\r\n"]
[6174.597602, "o", "   375\t\tentry, err := resolveModel(model)\r\n   376\t\tif err != nil {\r\n   377\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   378\t\t\tos.Exit(1)\r\n   379\t\t}\r\n   380\t\r\n   381\t\tweightsPath := filepath.Join(entry.Path, \"weights.bin\")\r\n   382\t\tinfo, err := os.Stat(weightsPath)\r\n   383\t\tif err != nil {\r\n"]
[6174.597669, "o", "   384\t\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n   385\t\t\tos.Exit(1)\r\n   386\t\t}\r\n   387\t\r\n   388\t\tweights, _, err := loadModelArtifacts(entry.Path)\r\n   389\t\tif err != nil {\r\n   390\t\t\tfmt.Fprintf(os.Stderr, \"error loading model: %v\\n\", err)\r\n   391\t\t\tos.Exit(1)\r\n   392\t\t}\r\n"]
[6174.597728, "o", "   393\t\r\n   394\t\tfeatures := int(weights.NumFeatures)\r\n   395\t\toutputs := int(weights.NumOutputs)\r\n   396\t\ttotalParams := features*outputs + outputs\r\n   397\t\r\n   398\t\tvar wmin, wmax, wsum float64\r\n   399\t\tzeroCount := 0\r\n   400\t\tif len(weights.Weights) > 0 {\r\n"]
[6174.597791, "o", "   401\t\t\twmin = weights.Weights[0]\r\n   402\t\t\twmax = weights.Weights[0]\r\n   403\t\t\tfor _, v := range weights.Weights {\r\n   404\t\t\t\tif v < wmin {\r\n   405\t\t\t\t\twmin = v\r\n   406\t\t\t\t}\r\n   407\t\t\t\tif v > wmax {\r\n   408\t\t\t\t\twmax = v\r\n"]
[6174.597888, "o", "   409\t\t\t\t}\r\n   410\t\t\t\twsum += v\r\n   411\t\t\t\tif v == 0 {\r\n   412\t\t\t\t\tzeroCount++\r\n   413\t\t\t\t}\r\n   414\t\t\t}\r\n"]
[6174.597955, "o", "   415\t\t} else {\r\n   416\t\t\twmin = 0\r\n   417\t\t\twmax = 0\r\n   418\t\t}\r\n   419\t\twavg := 0.0\r\n   420\t\tif len(weights.Weights) > 0 {\r\n   421\t\t\twavg = wsum / float64(len(weights.Weights))\r\n   422\t\t}\r\n   423\t\tsparsity := 0.0\r\n   424\t\tif len(weights.Weights) > 0 {\r\n"]
[6174.598028, "o", "   425\t\t\tsparsity = float64(zeroCount) / float64(len(weights.Weights)) * 100\r\n   426\t\t}\r\n   427\t\r\n   428\t\tfmt.Printf(\"Name:       %s\\n\", entry.Name)\r\n   429\t\tfmt.Printf(\"Type:       %s\\n\", entry.Type)\r\n   430\t\tfmt.Printf(\"Format:     v%d\\n\", weights.Version)\r\n   431\t\tif weights.Version >= 2 {\r\n   432\t\t\tfmt.Printf(\"Activation: %s\\n\", activationIDToName(weights.Activation))\r\n   433\t\t}\r\n   434\t\tfmt.Printf(\"Dimensions: %d x %d\\n\", features, outputs)\r\n   435\t\tfmt.Printf(\"Parameters: %d\\n\", totalParams)\r\n   436\t\tfmt.Printf(\"File size:  %d bytes\\n\", info.Size())\r\n"]
[6174.598095, "o", "   437\t\tfmt.Printf(\"Weight min: %v\\n\", wmin)\r\n   438\t\tfmt.Printf(\"Weight max: %v\\n\", wmax)\r\n   439\t\tfmt.Printf(\"Weight avg: %v\\n\", wavg)\r\n   440\t\tfmt.Printf(\"Bias:       %v\\n\", weights.Bias)\r\n"]
[6174.598166, "o", "   441\t\tfmt.Printf(\"Sparsity:   %.1f%%\\n\", sparsity)\r\n   442\t}\r\n   443\t\r\n   444\tfunc cmdBatch(args []string) {\r\n   445\t\tif len(args) < 1 {\r\n   446\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe batch <model> --dir <input_dir> --output-dir <output_dir> [--format csv|json]\\n\")\r\n   447\t\t\tos.Exit(1)\r\n   448\t\t}\r\n   449\t\r\n   450\t\tmodel := args[0]\r\n   451\t\tflags := parseFlags(args[1:])\r\n   452\t\r\n   453\t\tinputDir := flags[\"dir\"]\r\n   454\t\t"]
[6174.59823, "o", "outputDir := flags[\"output-dir\"]\r\n   455\t\tformat := flags[\"format\"]\r\n   456\t\tif format == \"\" {\r\n   457\t\t\tformat = \"csv\"\r\n   458\t\t}\r\n   459\t\tif format != \"csv\" && format != \"json\" {\r\n   460\t\t\tfmt.Fprintf(os.Stderr, \"error: unsupported format '%s', use 'csv' or 'json'\\n\", format)\r\n   461\t\t\tos.Exit(1)\r\n   462\t\t}\r\n"]
[6174.59829, "o", "   463\t\tif inputDir == \"\" {\r\n   464\t\t\tfmt.Fprintf(os.Stderr, \"error: --dir is required\\n\")\r\n   465\t\t\tos.Exit(1)\r\n   466\t\t}\r\n   467\t\tif outputDir == \"\" {\r\n   468\t\t\tfmt.Fprintf(os.Stderr, \"error: --output-dir is required\\n\")\r\n   469\t\t\tos.Exit(1)\r\n   470\t\t}\r\n"]
