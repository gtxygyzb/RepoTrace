[5144.560707, "o", "\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcopyDir\u001b[m\u001b[K(src, dst string) error {\r\n\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif err := \u001b[01;31m\u001b[KcopyDir\u001b[m\u001b[K(srcPath, dstPath); err != nil {\r\n"]
