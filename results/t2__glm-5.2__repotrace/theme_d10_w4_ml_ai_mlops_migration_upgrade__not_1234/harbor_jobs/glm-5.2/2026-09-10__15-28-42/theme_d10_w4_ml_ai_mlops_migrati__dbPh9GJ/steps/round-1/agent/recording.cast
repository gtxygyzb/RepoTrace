[4032.504417, "o", "\t\"path/filepath\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nconst registryFile = \"/app/models/registry.idx\"\r\n\r\ntype RegistryEntry struct {\r\n\tName    string\r\n\tPath    string\r\n\tType    string\r\n\tVersion int\r\n\tCreated string\r\n}\r\n\r\nfunc loadRegistry() ([]RegistryEntry, error) {\r\n\tf, err := os.Open(registryFile)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, nil\r\n\t\t}\r\n"]
[4032.504497, "o", "\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tvar entries []RegistryEntry\r\n\tscanner := bufio.NewScanner(f)\r\n\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.Split(line, \"|\")\r\n\t\tif len(parts) != 5 {\r\n"]
[4032.504593, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tver := 1\r\n\t\tfmt.Sscanf(parts[3], \"%d\", &ver)\r\n\t\tentries = append(entries, RegistryEntry{\r\n\t\t\tName:    parts[0],\r\n\t\t\tPath:    parts[1],\r\n\t\t\tType:    parts[2],\r\n\t\t\tVersion: ver,\r\n"]
[4032.50467, "o", "\t\t\tCreated: parts[4],\r\n\t\t})\r\n\t}\r\n\treturn entries, scanner.Err()\r\n}\r\n\r\nfunc saveRegistry(entries []RegistryEntry) error {\r\n\tdir := filepath.Dir(registryFile)\r\n\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n\tf, err := os.Create(registryFile)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tfmt.Fprintln(f, \"# mlpipe registry v1\")\r\n"]
[4032.504739, "o", "\tfor _, e := range entries {\r\n\t\tfmt.Fprintf(f, \"%s|%s|%s|%d|%s\\n\", e.Name, e.Path, e.Type, e.Version, e.Created)\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc findEntry(entries []RegistryEntry, name string) *RegistryEntry {\r\n\tfor i := range entries {\r\n\t\tif entries[i].Name == name {\r\n\t\t\treturn &entries[i]\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n"]
[4032.504858, "o", "}\r\n\r\nfunc cmdList(args []string) {\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n"]
