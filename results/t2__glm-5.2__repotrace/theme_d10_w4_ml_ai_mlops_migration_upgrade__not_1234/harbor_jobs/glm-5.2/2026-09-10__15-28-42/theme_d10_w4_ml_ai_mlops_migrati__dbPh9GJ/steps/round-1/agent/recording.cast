[250.508651, "o", "    11\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe validate <model>\\n\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\tname := args[0]\r\n    15\t\r\n    16\t\tentries, err := loadRegistry()\r\n    17\t\tif err != nil {\r\n    18\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    19\t\t\tos.Exit(1)\r\n    20\t\t}\r\n    21\t\r\n    22\t\tentry := findEntry(entries, name)\r\n    23\t\tif entry == nil {\r\n    24\t\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n    25\t\t\tos.Exit(1)\r\n    26\t\t}\r\n    27\t\r\n    28\t\terrors := validateModel(entry.Path)\r\n"]
[250.508773, "o", "    29\t\tif len(errors) == 0 {\r\n    30\t\t\tfmt.Printf(\"Model '%s' is valid.\\n\", name)\r\n    31\t\t} else {\r\n    32\t\t\tfmt.Printf(\"Model '%s' has %d validation error(s):\\n\", name, len(errors))\r\n    33\t\t\tfor i, e := range errors {\r\n    34\t\t\t\tfmt.Printf(\"  %d. %s\\n\", i+1, e)\r\n    35"]
[250.508909, "o", "\t\t\t}\r\n    36\t\t\tos.Exit(1)\r\n    37\t\t}\r\n    38\t}\r\n    39\t\r\n    40\tfunc validateModel(modelDir string) []string {\r\n    41\t\tvar errors []string\r\n    42\t\r\n    43\t\tmetaPath := filepath.Join(modelDir, \"model.meta\")\r\n    44\t\tif _, err := os.Stat(metaPath); err != nil {\r\n    45\t\t\terrors = append(errors, \"missing model.meta\")\r\n    46\t\t} else {\r\n    47\t\t\tmeta, err := loadModelMeta(modelDir)\r\n    48\t\t\tif err != nil {\r\n    49\t\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse model.meta: %v\", err))\r\n    50\t\t\t} else {\r\n    51\t\t\t\tif meta[\"name\"] == \"\" {\r\n    52\t\t\t\t\terrors = append(errors, \"model.meta: missing 'name' field\")\r\n    53\t\t\t\t}\r\n    54\t\t\t\tif meta[\"type\"] == \"\" {\r\n    55\t\t\t\t\terrors = append(errors, \"model.meta: missing 'type' field\")\r\n    56\t\t\t\t}\r\n    57\t\t\t\tif meta[\"features\"] == \"\" {\r\n"]
[250.508992, "o", "    58\t\t\t\t\terrors = append(errors, \"model.meta: missing 'features' field\")\r\n    59\t\t\t\t}\r\n    60\t\t\t\tif meta[\"outputs\"] == \"\" {\r\n    61\t\t\t\t\terrors = append(errors, \"model.meta: missing 'outputs' field\")\r\n    62\t\t\t\t}\r\n    63\t\t\t}\r\n    64\t\t}\r\n    65\t\r\n    66\t\tweightsPath := filepath.Join(modelDir, \"weights.bin\")\r\n    67\t\tif _, err := os.Stat(weightsPath); err != nil {\r\n"]
[250.509067, "o", "    68\t\t\terrors = append(errors, \"missing weights.bin\")\r\n    69\t\t} else {\r\n    70\t\t\t_, err := loadWeights(modelDir)\r\n    71\t\t\tif err != nil {\r\n    72\t\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse weights.bin: %v\", err))\r\n    73\t\t\t}\r\n    74\t\t}\r\n    75\t\r\n    76\t\tcfgPath := filepath.Join(modelDir, \"pipeline.cfg\")\r\n"]
[250.509136, "o", "    77\t\tif _, err := os.Stat(cfgPath); err != nil {\r\n    78\t\t\terrors = append(errors, \"missing pipeline.cfg\")\r\n    79\t\t} else {\r\n    80\t\t\t_, err := loadPipelineConfig(modelDir)\r\n    81\t\t\tif err != nil {\r\n    82\t\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse pipeline.cfg: %v\", err))\r\n    83\t\t\t}\r\n    84\t\t}\r\n    85\t\r\n    86\t\treturn errors\r\n    87\t}\r\n"]
