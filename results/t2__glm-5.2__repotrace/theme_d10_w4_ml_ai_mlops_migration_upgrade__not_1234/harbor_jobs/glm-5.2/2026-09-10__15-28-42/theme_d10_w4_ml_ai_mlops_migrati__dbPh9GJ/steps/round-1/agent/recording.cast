[4045.746257, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"os\"\r\n     6\t\t\"strings\"\r\n     7\t)\r\n     8\t\r\n     9\tconst version = \"0.1.0\"\r\n    10\t\r\n    11\tfunc main() {\r\n    12\t\tif len(os.Args) < 2 {\r\n    13\t\t\tprintUsage()\r\n    14\t\t\tos.Exit(1)\r\n    15\t\t}\r\n    16\t\r\n    17\t\tcommand := os.Args[1]\r\n    18\t\targs := os.Args[2:]\r\n    19\t\r\n    20\t\tswitch command {\r\n    21\t\tcase \"list\":\r\n"]
[4045.746409, "o", "    22\t\t\tcmdList(args)\r\n    23\t\tcase \"info\":\r\n    24\t\t\tcmdInfo(args)\r\n    25\t\tcase \"register\":\r\n    26\t\t\tcmdRegister(args)\r\n    27\t\tcase \"remove\":\r\n    28\t\t\tcmdRemove(args)\r\n    29\t\tcase \"run\":\r\n    30\t\t\tcmdRun(args)\r\n    31\t\tcase \"stats\":\r\n    32\t\t\tcmdStats(args)\r\n    33\t\tcase \"diff\":\r\n    34\t\t\tcmdDiff(args)\r\n    35\t\tcase \"batch\":\r\n    36\t\t\tcmdBatch(args)\r\n    37\t\tcase \"validate\":\r\n    38\t\t\tcmdValidate(args)\r\n    39\t\tcase \"export\":\r\n    40\t\t\tcmdExport(args)\r\n    41\t\tcase \"import\":\r\n    42\t\t\tcmdImport(args)\r\n    43\t\tcase \"clone\":\r\n    44\t\t\tcmdClone(args)\r\n    45\t\tcase \"migrate\":\r\n    46\t\t\tcmdMigrate(args)\r\n    47\t\tcase \"compat\":\r\n    48\t\t"]
[4045.746506, "o", "\tcmdCompat(args)\r\n    49\t\tcase \"version\":\r\n    50\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    51\t\tcase \"help\":\r\n    52\t\t\tprintUsage()\r\n    53\t\tdefault:\r\n    54\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    55\t\t\tprintUsage()\r\n    56\t\t\tos.Exit(1)\r\n    57\t\t}\r\n    58\t}\r\n    59\t\r\n    60\tfunc printUsage() {\r\n    61\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    62\t\r\n    63\tUsage: mlpipe <command> [arguments]\r\n    64\t\r\n    65\tCommands:\r\n    66\t  list                          List all registered models\r\n    67\t  info <model>                  Show model details\r\n    68\t  register <name> <path>        Register a model from directory\r\n"]
[4045.746649, "o", "    69\t  remove <name>                 Remove a model from registry\r\n    70\t  run <model> [options]         Run inference\r\n    71\t  stats --input <file>          Input statistics profiling\r\n    72\t  diff <model1> <model2> --input <file>\r\n    73\t                                Compare two models on same input\r\n    74\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n    75\t                                Batch inference over CSV files\r\n    76\t  validate <model>              Validate model integrity\r\n    77\t  export <model> --output <file> Export model to JSON file\r\n    78\t  import <path> [--name <name>] Import model from JSON file\r\n    79\t  clone <model> <new_name>      Clone model to new name\r\n    80\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n    81\t  compat [--all]                 Check migration compatibility\r\n    82\t  version                       Show version\r\n    83\t  help                          Show this help\r\n    84\t\r\n    85\tRun/Diff Options:\r\n    "]
[4045.746729, "o", "86\t  --input <file>    Input CSV file (required)\r\n    87\t  --output <file>   Output file (default: stdout)\r\n    88\t  --format <fmt>    Output format: csv or json (default: csv)\r\n    89\t\r\n    90\tBatch Options:\r\n    91\t  --dir <dir>       Input directory of CSV files\r\n    92\t  --output-dir <dir> Output directory for predictions\r\n    93\t  --format <fmt>    Output format: csv or json (default: csv)\r\n    94\t`\r\n    95\t\tfmt.Print(usage)\r\n    96\t}\r\n    97\t\r\n    98\tfunc parseFlags(args []string) map[string]string {\r\n    99\t\tflags := make(map[string]string)\r\n   100\t\tfor i := 0; i < len(args); i++ {\r\n   101\t\t\tif strings.HasPrefix(args[i], \"--\") {\r\n   102\t\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n   103\t\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n   104\t\t\t\t\tflags[key] = args[i+1]\r\n   105\t\t\t\t\ti++\r\n   106\t\t\t\t} else {\r\n   107\t\t\t\t\tflags[key] = \"true\"\r\n   108\t\t\t\t}\r\n   109\t\t\t}\r\n   110\t\t}\r\n   111\t\treturn flags\r\n   112\t}\r\n"]
[4045.747064, "o", "\u001b[?2004h"]
