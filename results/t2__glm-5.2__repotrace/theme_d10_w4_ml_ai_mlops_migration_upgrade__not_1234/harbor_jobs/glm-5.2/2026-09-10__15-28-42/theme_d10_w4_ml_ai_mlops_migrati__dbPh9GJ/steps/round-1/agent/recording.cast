[4569.689617, "o", "\u001b[35m\u001b[K./registry.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KTag(args []string) {\r\n\u001b[35m\u001b[K./registry.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KUntag(args []string) {\r\n\u001b[35m\u001b[K./registry.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K401\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KSearch(args []string) {\r\n"]
[4569.689683, "o", "\u001b[35m\u001b[K./inference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KRun(args []string) {\r\n"]
[4569.710585, "o", "\u001b[35m\u001b[K./migration.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K9\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KMigrate(args []string) {\r\n\u001b[35m\u001b[K./migration.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KCompat(args []string) {\r\n"]
[4569.711207, "o", "\u001b[?2004h"]
[4569.711267, "o", "root@n30009:/app# "]
[4575.83519, "i", "sed -n '1,220p' main.go\n"]
[4575.835484, "o", "sed -n '1,220p' main.go\r\n\u001b[?2004l\r"]
[4575.838656, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n)\r\n\r\n"]
[4575.838723, "o", "const version = \"0.1.0\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcommand := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch command {\r\n\t"]
[4575.838774, "o", "case \"list\":\r\n\t\tcmdList(args)\r\n\tcase \"info\":\r\n\t\tcmdInfo(args)\r\n\tcase \"register\":\r\n\t\tcmdRegister(args)\r\n\tcase \"remove\":\r\n"]
[4575.838834, "o", "\t\tcmdRemove(args)\r\n\tcase \"tag\":\r\n\t\tcmdTag(args)\r\n\tcase \"untag\":\r\n\t\tcmdUntag(args)\r\n\tcase \"search\":\r\n\t\tcmdSearch(args)\r\n"]
[4575.838877, "o", "\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"stats\":\r\n\t\tcmdStats(args)\r\n\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n\tcase \"batch\":\r\n\t\t"]
[4575.838917, "o", "cmdBatch(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"export\":\r\n\t\tcmdExport(args)\r\n\tcase \"import\":\r\n\t"]
[4575.838958, "o", "\tcmdImport(args)\r\n\tcase \"clone\":\r\n\t\tcmdClone(args)\r\n\tcase \"migrate\":\r\n\t\tcmdMigrate(args)\r\n\tcase \"compat\":\r\n\t\t"]
[4575.838998, "o", "cmdCompat(args)\r\n\tcase \"version\":\r\n\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n\tcase \"help\":\r\n\t\tprintUsage()\r\n"]
[4575.83904, "o", "\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc printUsage() {\r\n\t"]
[4575.839081, "o", "usage := `mlpipe - ML Inference Pipeline Manager\r\n\r\nUsage: mlpipe <command> [arguments]\r\n\r\nCommands:\r\n  list                          List all registered models\r\n  info <model>                  Show model details\r\n"]
[4575.839123, "o", "  register <name> <path>        Register a model from directory\r\n  remove <name>                 Remove a model from registry\r\n  run <model> [options]         Run inference\r\n  stats --input <file>          Input statistics profiling\r\n  diff <model1> <model2> --input <file>\r\n                                Compare two models on same input\r\n  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n                                Batch inference over CSV files\r\n  validate <model>              Validate model integrity\r\n  export <model> --output <file> Export model to JSON file\r\n"]
[4575.839169, "o", "  import <path> [--name <name>] Import model from JSON file\r\n  clone <model> <new_name>      Clone model to new name\r\n  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n  compat [--all]                 Check migration compatibility\r\n  version                       Show version\r\n  help                          Show this help\r\n\r\nRun/Diff Options:\r\n  --input <file>    Input CSV file (required)\r\n"]
[4575.839218, "o", "  --output <file>   Output file (default: stdout)\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n\r\nBatch Options:\r\n  --dir <dir>       Input directory of CSV files\r\n  --output-dir <dir> Output directory for predictions\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n`\r\n\tfmt.Print(usage)\r\n"]
[4575.839262, "o", "}\r\n\r\nfunc parseFlags(args []string) map[string]string {\r\n\tflags := make(map[string]string)\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tif strings.HasPrefix(args[i], \"--\") {\r\n\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n"]
[4575.839307, "o", "\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n\t\t\t\tflags[key] = args[i+1]\r\n\t\t\t\ti++\r\n\t\t\t} else {\r\n\t\t\t\tflags[key] = \"true\"\r\n\t\t\t}\r\n\t\t}\r\n"]
[4575.839347, "o", "\t}\r\n\treturn flags\r\n}\r\n"]
[4575.839873, "o", "\u001b[?2004h"]
[4575.839919, "o", "root@n30009:/app# "]
[4576.182459, "i", "sed -n '1,260p' registry.go\n"]
[4576.182706, "o", "sed -n '1,260p' registry.go\r\n\u001b[?2004l\r"]
[4576.18559, "o", "package main\r\n\r\nimport (\r\n\"bufio\"\r\n\"encoding/json\"\r\n\"fmt\"\r\n\"os\"\r\n\"path/filepath\"\r\n"]
[4576.185673, "o", "\"sort\"\r\n\"strings\"\r\n\"time\"\r\n)\r\n\r\nconst (\r\nregistryFile     = \"/app/models/registry.idx\"\r\nregistryJSONFile = \"/app/models/registry.json\"\r\n)\r\n\r\ntype RegistryEntry struct {\r\nName    string   `json:\"name\"`\r\nPath    string   `json:\"path\"`\r\nType    string   `json:\"type\"`\r\nVersion int      `json:\"version\"`\r\nCreated string   `json:\"created\"`\r\nTags    []string `json:\"tags\"`\r\n}\r\n\r\n"]
[4576.18575, "o", "func loadRegistry() ([]RegistryEntry, error) {\r\ndata, err := os.ReadFile(registryJSONFile)\r\nif err == nil {\r\nif len(strings.TrimSpace(string(data))) == 0 {\r\nreturn nil, nil\r\n}\r\nvar entries []RegistryEntry\r\n"]
[4576.185853, "o", "if err := json.Unmarshal(data, &entries); err != nil {\r\nreturn nil, fmt.Errorf(\"parse registry.json: %w\", err)\r\n}\r\nfor i := range entries {\r\nentries[i].Tags = ensureTags(entries[i].Tags)\r\n}\r\nreturn entries, nil\r\n}\r\nif !os.IsNotExist(err) {\r\nreturn nil, err\r\n}\r\n\r\n"]
[4576.185919, "o", "if _, err := os.Stat(registryFile); err == nil {\r\nentries, err := loadOldRegistry()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nif err := saveRegistry(entries); err != nil {\r\nreturn nil, err\r\n}\r\nreturn entries, nil\r\n}\r\n\r\nreturn nil, nil\r\n}\r\n\r\nfunc loadOldRegistry() ([]RegistryEntry, error) {\r\nf, err := os.Open(registryFile)\r\nif err != nil {\r\nif os.IsNotExist(err) {\r\nreturn nil, nil\r\n}\r\nreturn nil, err\r\n}\r\ndefer f.Close()\r\n\r\nvar entries []RegistryEntry\r\nscanner := bufio.NewScanner(f)\r\n"]
[4576.185984, "o", "for scanner.Scan() {\r\nline := strings.TrimSpace(scanner.Text())\r\nif line == \"\" || strings.HasPrefix(line, \"#\") {\r\ncontinue\r\n}\r\nparts := strings.Split(line, \"|\")\r\nif len(parts) != 5 {\r\ncontinue\r\n}\r\nver := 1\r\nfmt.Sscanf(parts[3], \"%d\", &ver)\r\n"]
[4576.186042, "o", "entries = append(entries, RegistryEntry{\r\nName:    parts[0],\r\nPath:    parts[1],\r\nType:    parts[2],\r\nVersion: ver,\r\nCreated: parts[4],\r\nTags:    []string{},\r\n})\r\n}\r\nreturn entries, scanner.Err()\r\n}\r\n\r\nfunc saveRegistry(entries []RegistryEntry) error {\r\ndir := filepath.Dir(registryJSONFile)\r\nif err := os.MkdirAll(dir, 0755); err != nil {\r\n"]
[4576.186105, "o", "return err\r\n}\r\n\r\nout := make([]RegistryEntry, len(entries))\r\nfor i, e := range entries {\r\ne.Tags = ensureTags(e.Tags)\r\nout[i] = e\r\n}\r\n\r\ndata, err := json.MarshalIndent(out, \"\", \"  \")"]
[4576.186167, "o", "\r\nif err != nil {\r\nreturn err\r\n}\r\nreturn os.WriteFile(registryJSONFile, data, 0644)\r\n}\r\n\r\nfunc ensureTags(tags []string) []string {\r\nif tags == nil {\r\nreturn []string{}\r\n}\r\nreturn tags\r\n}\r\n\r\n"]
[4576.186223, "o", "func findEntry(entries []RegistryEntry, name string) *RegistryEntry {\r\nfor i := range entries {\r\nif entries[i].Name == name {\r\nreturn &entries[i]\r\n}\r\n}\r\nreturn nil\r\n}\r\n\r\nfunc cmdList(args []string) {\r\nentries, err := loadRegistry()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\nif len(entries) == 0 {\r\nfmt.Println(\"No models registered.\")\r\nreturn\r\n}\r\n"]
[4576.18628, "o", "\r\nsort.Slice(entries, func(i, j int) bool {\r\nreturn entries[i].Name < entries[j].Name\r\n})\r\n\r\nfor _, e := range entries {\r\ntags := append([]string(nil), e.Tags...)\r\nsort.Strings(tags)\r\nif len(tags) > 0 {\r\nfmt.Printf(\"%s (%s)\\n\", e.Name, strings.Join(tags, \", \"))\r\n} else {\r\nfmt.Println(e.Name)\r\n"]
[4576.186336, "o", "}\r\n}\r\n}\r\n\r\nfunc cmdInfo(args []string) {\r\nif len(args) < 1 {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe info <model>\\n\")\r\nos.Exit(1)\r\n}\r\nname := args[0]\r\nentries, err := loadRegistry()\r\n"]
[4576.186421, "o", "if err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\nentry := findEntry(entries, name)\r\nif entry == nil {\r\nfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\nos.Exit(1)\r\n}\r\n"]
[4576.186483, "o", "if !modelDirExists(entry.Path) {\r\nfmt.Fprintf(os.Stderr, \"error: model directory not found\\n\")\r\nos.Exit(1)\r\n}\r\n\r\nmeta, err := loadModelMeta(entry.Path)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\nweights, err := loadWeights(entry.Path)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\n"]
[4576.186545, "o", "fmt.Printf(\"Name:        %s\\n\", meta[\"name\"])\r\nfmt.Printf(\"Type:        %s\\n\", meta[\"type\"])\r\nfmt.Printf(\"Version:     %s\\n\", meta[\"version\"])\r\nfmt.Printf(\"Created:     %s\\n\", meta[\"created\"])\r\nfmt.Printf(\"Description: %s\\n\", meta[\"description\"])\r\nfmt.Printf(\"Features:    %s\\n\", meta[\"features\"])\r\nfmt.Printf(\"Outputs:     %s\\n\", meta[\"outputs\"])\r\nfmt.Printf(\"Format:     v%d\\n\", weights.Version)\r\nfmt.Printf(\"Activation: %s\\n\", activationIDToName(weights.Activation))\r\nfmt.Printf(\"Path:        %s\\n\", entry.Path)\r\n}\r\n\r\nfunc cmdRegister(args []string) {\r\nif len(args) < 2 {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe register <name> <path>\\n\")\r\nos.Exit(1)\r\n}\r\nname := args[0]\r\n"]
[4576.186611, "o", "modelPath := args[1]\r\n\r\nabsPath, err := filepath.Abs(modelPath)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\nif _, err := os.Stat(filepath.Join(absPath, \"model.meta\")); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: no model.meta found at %s\\n\", absPath)\r\nos.Exit(1)\r\n}\r\n\r\nmeta, err := loadModelMeta(absPath)\r\nif err != nil {\r\n"]
[4576.186673, "o", "fmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\nentries, err := loadRegistry()\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n\r\nif findEntry(entries, name) != nil {\r\nfmt.Fprintf(os.Stderr, \"error: model '%s' already registered\\n\", name)\r\nos.Exit(1)\r\n}\r\n\r\n"]
[4576.186735, "o", "modelType := meta[\"type\"]\r\nif modelType == \"\" {\r\nmodelType = \"unknown\"\r\n}\r\n\r\nentries = append(entries, RegistryEntry{\r\nName:    name,\r\nPath:    absPath,\r\nType:    modelType,\r\nVersion: 1,\r\nCreated: time.Now().Format(\"2006-01-02\"),\r\nTags:    []string{},\r\n})\r\n"]
[4576.186791, "o", "\r\nif err := saveRegistry(entries); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\nfmt.Printf(\"Model '%s' registered successfully.\\n\", name)\r\n}\r\n\r\nfunc cmdRemove(args []string) {\r\nif len(args) < 1 {\r\n"]
[4576.187304, "o", "\u001b[?2004h"]
[4576.187359, "o", "root@n30009:/app# "]
[4576.490646, "i", "sed -n '1,420p' export_import.go\n"]
[4576.490972, "o", "sed -n '1,420p' export_import.go\r\n\u001b[?2004l\r"]
[4576.493969, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n"]
[4576.494045, "o", "\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\ntype exportPipeline struct {\r\n\tNormalize       bool      `json:\"normalize\"`\r\n\tScaleRange      []float64 `json:\"scale_range\"`\r\n\tMissingStrategy string    `json:\"missing_strategy\"`\r\n\tRoundDigits     int       `json:\"round_digits\"`\r\n\tClipRange       []float64 `json:\"clip_range\"`\r\n}\r\n\r\n"]
[4576.49412, "o", "type exportModel struct {\r\n\tName          string         `json:\"name\"`\r\n\tType          string         `json:\"type\"`\r\n\tVersion       int            `json:\"version\"`\r\n\tFormatVersion int            `json:\"format_version\"`\r\n\tFeatures      int            `json:\"features\"`\r\n\tOutputs       int            `json:\"outputs\"`\r\n\t"]
[4576.49419, "o", "Activation    string         `json:\"activation\"`\r\n\tWeights       [][]float64    `json:\"weights\"`\r\n\tBias          []float64      `json:\"bias\"`\r\n\tPipeline      exportPipeline `json:\"pipeline\"`\r\n}\r\n\r\nfunc cmdExport(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe export <model> --output <file>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\tflags := parseFlags(args[1:])\r\n\r\n\toutputPath := flags[\"output\"]\r\n\tif outputPath == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: --output is required\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[4576.494251, "o", "\tif !strings.HasSuffix(outputPath, \".json\") {\r\n\t\toutputPath += \".json\"\r\n\t}\r\n\r\n\tentry, err := resolveModel(name)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[4576.49436, "o", "\r\n\tmeta, err := loadModelMeta(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tweights, err := loadWeights(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcfg, err := loadPipelineConfig(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading pipeline config: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmodelName := meta[\"name\"]\r\n"]
[4576.494423, "o", "\tif modelName == \"\" {\r\n\t\tmodelName = entry.Name\r\n\t}\r\n\tmodelType := meta[\"type\"]\r\n\tif modelType == \"\" {\r\n\t\tmodelType = \"unknown\"\r\n\t}\r\n\tmodelVersion := 1\r\n\tif v, err := strconv.Atoi(meta[\"version\"]); err == nil {\r\n"]
[4576.494484, "o", "\t\tmodelVersion = v\r\n\t}\r\n\r\n\tactivation := \"none\"\r\n\tif weights.Version == 2 {\r\n\t\tactivation = activationIDToName(weights.Activation)\r\n\t}\r\n\r\n\tif int(weights.NumFeatures) <= 0 || int(weights.NumOutputs) <= 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid model dimensions\\n\")\r\n\t\tos.Exit(1)\r\n"]
[4576.494547, "o", "\t}\r\n\tif len(weights.Weights) != int(weights.NumFeatures)*int(weights.NumOutputs) {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: corrupt weights matrix\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif len(weights.Bias) != int(weights.NumOutputs) {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: corrupt bias vector\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[4576.494621, "o", "\tweightMatrix := make([][]float64, weights.NumOutputs)\r\n\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n\t\tstart := o * weights.NumFeatures\r\n\t\tend := start + weights.NumFeatures\r\n\t\trow := make([]float64, weights.NumFeatures)\r\n\t\tcopy(row, weights.Weights[start:end])\r\n\t\tweightMatrix[o] = row\r\n\t}\r\n\r\n\texport := exportModel{\r\n\t\tName:          modelName,\r\n\t\tType:          modelType,\r\n"]
[4576.494684, "o", "\t\tVersion:       modelVersion,\r\n\t\tFormatVersion: int(weights.Version),\r\n\t\tFeatures:      int(weights.NumFeatures),\r\n\t\tOutputs:       int(weights.NumOutputs),\r\n\t\tActivation:    activation,\r\n\t\tWeights:       weightMatrix,\r\n\t\tBias:          weights.Bias,\r\n\t\tPipeline: exportPipeline{\r\n"]
[4576.494741, "o", "\t\t\tNormalize:       cfg.Normalize,\r\n\t\t\tScaleRange:      []float64{cfg.ScaleMin, cfg.ScaleMax},\r\n\t\t\tMissingStrategy: cfg.MissingStrategy,\r\n\t\t\tRoundDigits:     cfg.RoundDigits,\r\n\t\t\tClipRange:       []float64{cfg.ClipMin, cfg.ClipMax},\r\n\t\t},\r\n\t}\r\n\r\n"]
[4576.494824, "o", "\tdata, err := json.MarshalIndent(export, \"\", \"  \")\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error encoding JSON: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tdata = append(data, '\\n')\r\n\r\n\tif dir := filepath.Dir(outputPath); dir != \"\" && dir != \".\" {\r\n"]
[4576.494897, "o", "\t\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error creating output directory: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\tif err := os.WriteFile(outputPath, data, 0644); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error writing export file: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Printf(\"Model '%s' exported to %s\\n\", name, outputPath)\r\n}\r\n\r\n"]
[4576.494959, "o", "func cmdImport(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe import <path> [--name <name>]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\timportPath := args[0]\r\n\tflags := parseFlags(args[1:])\r\n\tname := flags[\"name\"]\r\n\tif name == \"\" || name == \"true\" {\r\n\t\tname = \"\"\r\n"]
[4576.49502, "o", "\t}\r\n\r\n\tdata, err := os.ReadFile(importPath)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: file not found: %s\\n\", importPath)\r\n\t\t} else {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\t}\r\n"]
[4576.495077, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar model exportModel\r\n\tif err := json.Unmarshal(data, &model); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid JSON: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif name == \"\" {\r\n"]
[4576.495134, "o", "\t\tname = model.Name\r\n\t}\r\n\tif name == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: missing name\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif model.FormatVersion != 1 && model.FormatVersion != 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: format_version must be 1 or 2\\n\")\r\n\t\tos.Exit(1)\r\n\t}"]
[4576.495193, "o", "\r\n\tif model.Features <= 0 || model.Outputs <= 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: features and outputs must be positive\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif len(model.Weights) != model.Outputs {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: weights outer dimension must equal outputs\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\t"]
[4576.495268, "o", "for i, row := range model.Weights {\r\n\t\tif len(row) != model.Features {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: weights[%d] has %d features, expected %d\\n\", i, len(row), model.Features)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n"]
[4576.495334, "o", "\tif len(model.Bias) != model.Outputs {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: bias length must equal outputs\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif len(model.Pipeline.ScaleRange) != 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: scale_range must have two values\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif len(model.Pipeline.ClipRange) != 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: clip_range must have two values\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tactivationName := model.Activation\r\n\tif model.FormatVersion == 1 {\r\n\t\tactivationName = \"none\"\r\n"]
[4576.495404, "o", "\t}\r\n\tactivationID, err := activationNameToID(activationName)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif model.FormatVersion == 1 && model.Activation != \"none\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid model JSON: v1 models must use activation none\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[4576.49546, "o", "\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif findEntry(entries, name) != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model already exists\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[4576.495517, "o", "\tmodelDir := filepath.Join(\"/app/models\", name)\r\n\tif err := os.MkdirAll(modelDir, 0755); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tflatWeights := make([]float64, 0, model.Features*model.Outputs)\r\n\tfor o := 0; o < model.Outputs; o++ {\r\n\t\tflatWeights = append(flatWeights, model.Weights[o]...)\r\n\t}\r\n\tweightsData := &WeightsData{"]
[4576.495573, "o", "\r\n\t\tVersion:     uint32(model.FormatVersion),\r\n\t\tNumFeatures: uint32(model.Features),\r\n\t\tNumOutputs:  uint32(model.Outputs),\r\n\t\tActivation:  activationID,\r\n\t\tWeights:     flatWeights,\r\n\t\tBias:        model.Bias,\r\n\t"]
[4576.495633, "o", "}\r\n\tif err := writeWeights(filepath.Join(modelDir, \"weights.bin\"), weightsData); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error writing weights: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmeta := map[string]string{\r\n\t\t\"name\":           name,\r\n"]
[4576.495695, "o", "\t\t\"type\":           model.Type,\r\n\t\t\"version\":        strconv.Itoa(model.Version),\r\n\t\t\"created\":        time.Now().Format(\"2006-01-02\"),\r\n\t\t\"description\":    \"Imported from JSON export\",\r\n\t\t\"features\":       strconv.Itoa(model.Features),\r\n\t\t\"outputs\":        strconv.Itoa(model.Outputs),\r\n\t\t\"format_version\": strconv.Itoa(model.FormatVersion),\r\n\t\t\"activation\":     activationName,\r\n\t}\r\n"]
[4576.495756, "o", "\tif meta[\"type\"] == \"\" {\r\n\t\tmeta[\"type\"] = \"unknown\"\r\n\t}\r\n\tif meta[\"version\"] == \"0\" {\r\n\t\tmeta[\"version\"] = \"1\"\r\n\t}\r\n\tif err := saveModelMeta(modelDir, meta); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error writing metadata: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n"]
[4576.495839, "o", "\t}\r\n\r\n\tcfg := &PipelineConfig{\r\n\t\tNormalize:       model.Pipeline.Normalize,\r\n\t\tScaleMin:        model.Pipeline.ScaleRange[0],\r\n\t\tScaleMax:        model.Pipeline.ScaleRange[1],\r\n\t\tMissingStrategy: model.Pipeline.MissingStrategy,\r\n\t\tRoundDigits:     model.Pipeline.RoundDigits,\r\n\t\tClipMin:         model.Pipeline.ClipRange[0],\r\n\t\tClipMax:         model.Pipeline.ClipRange[1],\r\n\t}\r\n\tif cfg.MissingStrategy == \"\" {\r\n"]
[4576.495904, "o", "\t\tcfg.MissingStrategy = \"zero\"\r\n\t}\r\n\tif err := savePipelineConfig(modelDir, cfg); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error writing pipeline config: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tregistryVersion := model.Version\r\n\tif registryVersion == 0 {\r\n\t\tregistryVersion = 1\r\n\t}\r\n"]
[4576.495968, "o", "\tentries = append(entries, RegistryEntry{\r\n\t\tName:    name,\r\n\t\tPath:    modelDir,\r\n\t\tType:    model.Type,\r\n\t\tVersion: registryVersion,\r\n\t\tCreated: time.Now().Format(\"2006-01-02\"),\r\n\t})\r\n\tif err := saveRegistry(entries); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t"]
[4576.49603, "o", "\tos.Exit(1)\r\n\t}\r\n\tfmt.Printf(\"Model '%s' imported successfully.\\n\", name)\r\n}\r\n\r\nfunc cmdClone(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe clone <model> <new_name>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tsourceName := args[0]\r\n\tnewName := args[1]\r\n\r\n"]
[4576.496091, "o", "\tentry, err := resolveModel(sourceName)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t"]
[4576.496149, "o", "}\r\n\tif findEntry(entries, newName) != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model already exists\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tnewDir := filepath.Join(\"/app/models\", newName)\r\n\tif err := os.MkdirAll(newDir, 0755); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[4576.496207, "o", "\t\tos.Exit(1)\r\n\t}\r\n\tif err := copyDir(entry.Path, newDir); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error cloning model files: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmeta, err := loadModelMeta(newDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error updating metadata: %v\\n\", err)\r\n\t"]
[4576.496269, "o", "\tos.Exit(1)\r\n\t}\r\n\tmeta[\"name\"] = newName\r\n\tif err := saveModelMeta(newDir, meta); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error updating metadata: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tregistryVersion := entry.Version\r\n\tif registryVersion == 0 {\r\n"]
[4576.496326, "o", "\t\tregistryVersion = 1\r\n\t}\r\n\tentries = append(entries, RegistryEntry{\r\n\t\tName:    newName,\r\n\t\tPath:    newDir,\r\n\t\tType:    entry.Type,\r\n\t\tVersion: registryVersion,\r\n\t\tCreated: time.Now().Format(\"2006-01-02\"),\r\n\t"]
[4576.496381, "o", "})\r\n\tif err := saveRegistry(entries); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Printf(\"Model '%s' cloned to '%s'.\\n\", sourceName, newName)\r\n}\r\n\r\n"]
[4576.496443, "o", "func savePipelineConfig(modelDir string, cfg *PipelineConfig) error {\r\n\tpath := filepath.Join(modelDir, \"pipeline.cfg\")\r\n\tf, err := os.Create(path)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tfmt.Fprintln(f, \"[preprocess]\")\r\n\tfmt.Fprintf(f, \"normalize=%t\\n\", cfg.Normalize)\r\n\tfmt.Fprintf(f, \"scale_range=%s,%s\\n\", formatFloat(cfg.ScaleMin), formatFloat(cfg.ScaleMax))\r\n"]
[4576.49651, "o", "\tfmt.Fprintf(f, \"missing_strategy=%s\\n\", cfg.MissingStrategy)\r\n\tfmt.Fprintln(f)\r\n\tfmt.Fprintln(f, \"[postprocess]\")\r\n\tfmt.Fprintf(f, \"round_digits=%d\\n\", cfg.RoundDigits)\r\n\tfmt.Fprintf(f, \"clip_min=%s\\n\", formatFloat(cfg.ClipMin))\r\n\tfmt.Fprintf(f, \"clip_max=%s\\n\", formatFloat(cfg.ClipMax))\r\n\treturn nil\r\n}\r\n\r\nfunc formatFloat(v float64) string {\r\n\treturn strconv.FormatFloat(v, 'f', -1, 64)\r\n}\r\n"]
[4576.496568, "o", "\r\nfunc copyDir(src, dst string) error {\r\n\tentries, err := os.ReadDir(src)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tfor _, entry := range entries {\r\n\t\tsrcPath := filepath.Join(src, entry.Name())\r\n\t\tdstPath := filepath.Join(dst, entry.Name())\r\n\t\tif entry.IsDir() {\r\n"]
[4576.496627, "o", "\t\t\tif err := os.MkdirAll(dstPath, 0755); err != nil {\r\n"]
