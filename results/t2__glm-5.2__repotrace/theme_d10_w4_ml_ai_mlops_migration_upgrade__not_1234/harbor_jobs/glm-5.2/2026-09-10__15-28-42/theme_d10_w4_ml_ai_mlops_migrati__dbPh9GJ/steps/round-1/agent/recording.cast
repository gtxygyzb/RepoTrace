[4792.078133, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"time\"\r\n"]
[4792.07823, "o", ")\r\n\r\nfunc checkpointsDir(modelDir string) string {\r\n\treturn filepath.Join(modelDir, \".checkpoints\")\r\n}\r\n\r\nfunc countCheckpoints(modelDir string) int {\r\n\tentries, err := os.ReadDir(checkpointsDir(modelDir))\r\n\tif err != nil {\r\n\t\treturn 0\r\n\t}\r\n\tcount := 0\r\n\tfor _, entry := range entries {\r\n\t\tif entry.IsDir() {\r\n\t\t\tcount++\r\n\t\t}\r\n\t}\r\n\treturn count\r\n"]
[4792.078333, "o", "}\r\n\r\nfunc cmdCheckpoint(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe checkpoint <model> [--name <name>]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tmodel := args[0]\r\n"]
[4792.07841, "o", "\tflags := parseFlags(args[1:])\r\n\r\n\tname := flags[\"name\"]\r\n\tif name == \"\" {\r\n\t\tname = \"cp-\" + time.Now().Format(\"20060102-150405\")\r\n\t}\r\n\r\n\tentry, err := resolveModel(model)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"not found\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcpDir := filepath.Join(checkpointsDir(entry.Path), name)\r\n\tif _, err := os.Stat(cpDir); err == nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"checkpoint already exists\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif err := os.MkdirAll(cpDir, 0755); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[4792.078485, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfor _, file := range []string{\"weights.bin\", \"model.meta\", \"pipeline.cfg\"} {\r\n\t\tsrc := filepath.Join(entry.Path, file)\r\n\t\tdata, err := os.ReadFile(src)\r\n"]
[4792.078562, "o", "\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tif err := os.WriteFile(filepath.Join(cpDir, file), data, 0644); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\r\n\tfmt.Printf(\"checkpoint '%s' created for '%s'\\n\", name, model)\r\n}\r\n\r\nfunc cmdCheckpoints(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe checkpoints <model>\\n\")\r\n"]
[4792.078631, "o", "\t\tos.Exit(1)\r\n\t}\r\n\tmodel := args[0]\r\n\r\n\tentry, err := resolveModel(model)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"not found\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := os.ReadDir(checkpointsDir(entry.Path))\r\n\tif err != nil || len(entries) == 0 {\r\n\t"]
[4792.078698, "o", "\tfmt.Println(\"no checkpoints\")\r\n\t\treturn\r\n\t}\r\n\r\n\ttype checkpointInfo struct {\r\n\t\tname string\r\n\t\tmod  time.Time\r\n\t}\r\n\tvar cps []checkpointInfo\r\n\tfor _, entry := range entries {\r\n\t\tif !entry.IsDir() {\r\n"]
[4792.078768, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tinfo, err := entry.Info()\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tcps = append(cps, checkpointInfo{name: entry.Name(), mod: info.ModTime()})\r\n\t}\r\n\r\n\tif len(cps) == 0 {\r\n\t\tfmt.Println(\"no checkpoints\")\r\n"]
[4792.078869, "o", "\t\treturn\r\n\t}\r\n\r\n\tsort.Slice(cps, func(i, j int) bool {\r\n\t\treturn cps[i].mod.Before(cps[j].mod)\r\n\t})\r\n\r\n\tfor _, cp := range cps {\r\n\t\tfmt.Printf(\"%s  %s\\n\", cp.name, cp.mod.Format(\"2006-01-02 15:04:05\"))\r\n\t}\r\n}\r\n\r\nfunc cmdRollback(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe rollback <model> --to <checkpoint>\\n\")\r\n\t"]
