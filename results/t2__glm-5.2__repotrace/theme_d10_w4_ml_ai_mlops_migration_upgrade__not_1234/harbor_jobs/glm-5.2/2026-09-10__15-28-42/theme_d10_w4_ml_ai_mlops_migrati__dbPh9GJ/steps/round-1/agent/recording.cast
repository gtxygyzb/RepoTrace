[12043.989275, "i", "sed -n '1,240p' main.go\n"]
[12043.989489, "o", "sed -n '1,240p' main.go\r\n\u001b[?2004l\r"]
[12043.992163, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\""]
[12043.992303, "o", "\r\n)\r\n\r\nconst version = \"0.1.0\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcommand := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch command {\r\n\tcase \"ensemble\":\r\n\t\tcmdEnsemble(args)\r\n\tcase \"list\":\r\n\t\tcmdList(args)\r\n\tcase \"info\":\r\n\t\tcmdInfo(args)\r\n\tcase \"register\":\r\n\t\tcmdRegister(args)\r\n"]
[12043.992374, "o", "\tcase \"remove\":\r\n\t\tcmdRemove(args)\r\n\tcase \"tag\":\r\n\t\tcmdTag(args)\r\n\tcase \"untag\":\r\n\t\tcmdUntag(args)\r\n\tcase \"search\":\r\n\t\tcmdSearch(args)\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"stats\":\r\n\t\tcmdStats(args)\r\n"]
[12043.992433, "o", "\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n\tcase \"batch\":\r\n\t\tcmdBatch(args)\r\n\tcase \"benchmark\":\r\n\t\tcmdBenchmark(args)\r\n\tcase \"prune\":\r\n\t\tcmdPrune(args)\r\n\tcase \"profile\":\r\n"]
[12043.992489, "o", "\t\tcmdProfile(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"validate-input\":\r\n\t\tcmdValidateInput(args)\r\n\tcase \"schema\":\r\n\t\tcmdSchema(args)\r\n\tcase \"export\":\r\n\t\tcmdExport(args)\r\n"]
[12043.992543, "o", "\tcase \"import\":\r\n\t\tcmdImport(args)\r\n\tcase \"clone\":\r\n\t\tcmdClone(args)\r\n\tcase \"checkpoint\":\r\n\t\tcmdCheckpoint(args)\r\n\tcase \"checkpoints\":\r\n\t\tcmdCheckpoints(args)\r\n\tcase \"rollback\":\r\n\t\tcmdRollback(args)\r\n\tcase \"migrate\":\r\n"]
[12043.992596, "o", "\t\tcmdMigrate(args)\r\n\tcase \"compat\":\r\n\t\tcmdCompat(args)\r\n\tcase \"version\":\r\n\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n\tcase \"help\":\r\n\t\tprintUsage()\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n\t"]
[12043.992648, "o", "\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc printUsage() {\r\n\tusage := `mlpipe - ML Inference Pipeline Manager\r\n\r\nUsage: mlpipe <command> [arguments]\r\n\r\nCommands:\r\n"]
[12043.992701, "o", "  list                          List all registered models\r\n  info <model>                  Show model details\r\n  register <name> <path>        Register a model from directory\r\n  remove <name>                 Remove a model from registry\r\n  run <model> [options]         Run inference\r\n  stats --input <file>          Input statistics profiling\r\n  diff <model1> <model2> --input <file>\r\n                                Compare two models on same input\r\n  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n                                Batch inference over CSV files\r\n  validate <model>              Validate model integrity\r\n"]
[12043.992759, "o", "  validate-input <model> --input <file>\r\n                                Validate input data for a model\r\n  schema <model>                Display expected input schema for a model\r\n  export <model> --output <file> Export model to JSON file\r\n  import <path> [--name <name>] Import model from JSON file\r\n  clone <model> <new_name>      Clone model to new name\r\n  benchmark <model> --input <file> [--runs <N>]\r\n                                Benchmark inference performance\r\n  prune <model> --threshold <value> [--dry-run]\r\n                                Prune near-zero weights\r\n  profile <model>               Report model weight analysis\r\n  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n"]
[12043.992853, "o", "  compat [--all]                 Check migration compatibility\r\n  version                       Show version\r\n  help                          Show this help\r\n\r\nRun/Diff Options:\r\n  --input <file>    Input CSV file (required)\r\n  --output <file>   Output file (default: stdout)\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n  --strict          Validate input before inference and abort on invalid rows\r\n\r\nBatch Options:\r\n  --dir <dir>       Input directory of CSV files\r\n  --output-dir <dir> Output directory for predictions\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n`\r\n\tfmt.Print(usage)\r\n}\r\n\r\n"]
[12043.992914, "o", "func parseFlags(args []string) map[string]string {\r\n\tflags := make(map[string]string)\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tif strings.HasPrefix(args[i], \"--\") {\r\n\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n\t\t\t\tflags[key] = args[i+1]\r\n\t\t\t\ti++\r\n\t\t\t} else {\r\n"]
[12043.992964, "o", "\t\t\t\tflags[key] = \"true\"\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn flags\r\n}\r\n"]
[12043.993376, "o", "\u001b[?2004h"]
[12043.993427, "o", "root@n30009:/app# "]
[12044.2375, "i", "sed -n '1,260p' ensemble.go\n"]
[12044.237775, "o", "sed -n '1,260p' ensemble.go\r\n\u001b[?2004l\r"]
[12044.240809, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[12044.240858, "o", "\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n"]
[12044.241001, "o", "\r\nconst ensemblesDir = \"/app/models/ensembles\"\r\n\r\ntype ensembleConfig struct {\r\n\tName     string    `json:\"name\"`\r\n\tModels   []string  `json:\"models\"`\r\n\tStrategy string    `json:\"strategy\"`\r\n\tWeights  []float64 `json:\"weights\"`\r\n\tCreated  string    `json:\"created\"`\r\n}\r\n\r\nfunc cmdEnsemble(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble <create|list|run|info|remove> [arguments]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tsub := args[0]\r\n\trest := args[1:]\r\n\tswitch sub {\r\n\tcase \"create\":\r\n\t\tcmdEnsembleCreate(rest)\r\n\tcase \"list\":\r\n\t\tcmdEnsembleList(rest)\r\n"]
[12044.24108, "o", "\tcase \"run\":\r\n\t\tcmdEnsembleRun(rest)\r\n\tcase \"info\":\r\n\t\tcmdEnsembleInfo(rest)\r\n\tcase \"remove\":\r\n\t\tcmdEnsembleRemove(rest)\r\n"]
[12044.241146, "o", "\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown ensemble command: %s\\n\", sub)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc cmdEnsembleCreate(args []string) {\r\n\tflags := parseFlags(args)\r\n\r\n\tif len(args) < 1 || strings.HasPrefix(args[0], \"--\") {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>] [--weights <w1,w2,...>]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\r\n\tmodelsStr := flags[\"models\"]\r\n"]
[12044.241211, "o", "\tif modelsStr == \"\" || modelsStr == \"true\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>] [--weights <w1,w2,...>]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tstrategy := flags[\"strategy\"]\r\n\tif strategy == \"\" || strategy == \"true\" {\r\n\t\tstrategy = \"average\"\r\n\t}\r\n\tif strategy != \"average\" && strategy != \"max\" && strategy != \"min\" {\r\n"]
[12044.241272, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: invalid strategy '%s', use average, max, or min\\n\", strategy)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar models []string\r\n\tfor _, m := range strings.Split(modelsStr, \",\") {\r\n\t\tm = strings.TrimSpace(m)\r\n\t\tif m != \"\" {\r\n\t\t\tmodels = append(models, m)\r\n\t\t}\r\n\t}\r\n"]
[12044.241335, "o", "\tif len(models) == 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: at least one model is required\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar weights []float64\r\n\tif weightsStr := flags[\"weights\"]; weightsStr != \"\" && weightsStr != \"true\" {\r\n\t\tfor _, w := range strings.Split(weightsStr, \",\") {\r\n\t\t\tw = strings.TrimSpace(w)\r\n\t\t\tif w == \"\" {\r\n"]
[12044.241399, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tval, err := strconv.ParseFloat(w, 64)\r\n\t\t\tif err != nil {\r\n\t\t\t\tfmt.Println(\"weights must be positive\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tif val <= 0 {\r\n"]
[12044.241458, "o", "\t\t\t\tfmt.Println(\"weights must be positive\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tweights = append(weights, val)\r\n\t\t}\r\n\t\tif len(weights) != len(models) {\r\n\t\t\tfmt.Println(\"weight count mismatch\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
[12044.241523, "o", "\t} else {\r\n\t\tweights = make([]float64, len(models))\r\n\t\tfor i := range weights {\r\n\t\t\tweights[i] = 1.0\r\n\t\t}\r\n\t}\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n"]
[12044.241584, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfor _, m := range models {\r\n\t\tif findEntry(entries, m) == nil {\r\n\t\t\tfmt.Printf(\"model not found: %s\\n\", m)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n"]
[12044.241646, "o", "\r\n\tvar outputDim int\r\n\tfor i, m := range models {\r\n\t\tentry := findEntry(entries, m)\r\n\t\tweights, err := loadWeights(entry.Path)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error loading weights for model '%s': %v\\n\", m, err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
[12044.241712, "o", "\t\tif i == 0 {\r\n\t\t\toutputDim = int(weights.NumOutputs)\r\n\t\t} else if int(weights.NumOutputs) != outputDim {\r\n\t\t\tfmt.Println(\"output dimension mismatch\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\r\n\tpath := filepath.Join(ensemblesDir, name+\".json\")\r\n\tif _, err := os.Stat(path); err == nil {\r\n\t"]
[12044.241773, "o", "\tfmt.Println(\"ensemble already exists\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcfg := ensembleConfig{\r\n\t\tName:     name,\r\n\t\tModels:   models,\r\n"]
[12044.241878, "o", "\t\tStrategy: strategy,\r\n\t\tWeights:  weights,\r\n\t\tCreated:  time.Now().Format(\"2006-01-02\"),\r\n\t}\r\n\tif err := saveEnsembleConfig(&cfg); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t"]
[12044.241973, "o", "fmt.Printf(\"ensemble '%s' created with %d models (strategy=%s)\\n\", name, len(models), strategy)\r\n}\r\n\r\nfunc cmdEnsembleList(args []string) {\r\n\tconfigs, err := listEnsembleConfigs()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif len(configs) == 0 {\r\n\t\tfmt.Println(\"no ensembles\")\r\n\t\treturn\r\n\t}\r\n\tsort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })\r\n\tfor _, cfg := range configs {\r\n\t\tfmt.Printf(\"%s  %s  %d models\\n\", cfg.Name, cfg.Strategy, len(cfg.Models))\r\n\t}\r\n}\r\n\r\nfunc cmdEnsembleInfo(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble info <name>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\tcfg, err := loadEnsembleConfig(name)\r\n"]
[12044.24204, "o", "\tif err != nil {\r\n\t\tfmt.Println(\"ensemble not found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Printf(\"Name:     %s\\n\", cfg.Name)\r\n"]
[12044.242346, "o", "\tfmt.Printf(\"Strategy: %s\\n\", cfg.Strategy)\r\n\tfmt.Println(\"Models:\")\r\n\tfor i, model := range cfg.Models {\r\n\t\tweight := 1.0\r\n\t\tif i < len(cfg.Weights) {\r\n\t\t\tweight = cfg.Weights[i]\r\n\t\t}\r\n\t\tfmt.Printf(\"  %s (weight: %g)\\n\", model, weight)\r\n\t}\r\n\tif cfg.Created != \"\" {\r\n\t\tfmt.Printf(\"Created:  %s\\n\", cfg.Created)\r\n\t}\r\n}\r\n\r\nfunc cmdEnsembleRun(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble run <name> --input <file> [--format csv|json]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\tflags := parseFlags(args[1:])\r\n\r\n\tinputFile := flags[\"input\"]\r\n\tif inputFile == \"\" || inputFile == \"true\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: --input is required\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\toutputFormat := flags[\"format\"]\r\n\tif outputFormat == \"\" || outputFormat == \"true\" {\r\n\t\toutputFormat = \"csv\"\r\n\t}\r\n\tif outputFormat != \"csv\" && outputFormat != \"json\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unsupported format '%s', use 'csv' or 'json'\\n\", outputFormat)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcfg, err := loadEnsembleConfig(na"]
[12044.2425, "o", "me)\r\n\tif err != nil {\r\n\t\tfmt.Println(\"ensemble not found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tinputs, err := readInputCSV(inputFile)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar allOutputs [][][]float64\r\n\tvar featureCount int\r\n\tfor i, modelName := range cfg.Models {\r\n\t\tentry := findEntry(entries, modelName)\r\n\t\tif entry == nil {\r\n\t\t\tfmt.Printf(\"model not found: %s\\n\", modelName)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\r\n\t\tweights, err := loadWeights(entry.Path)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error loading weights for model '%s': %v\\n\", modelName, err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
