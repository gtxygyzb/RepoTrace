[13065.280199, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('commands_extra.go')\ns = p.read_text()\n\nold = '''\\tinput := flags[\"input\"]\n\n\\tif input != \"\" {\n\\t\\tif _, err := os.Stat(input); err != nil {\n\\t\\t\\tfmt.Fprintln(os.Stderr, \"file not found\")\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\\t}\n\n\\tentry1, err := resolveModel(model1)\n'''\nnew = '''\\tinput := flags[\"input\"]\n\n\\tentry1, err := resolveModel(model1)\n'''\nif old in s:\n    s = s.replace(old, new)\n\ninsert_after = '''\\tentry2, err := resolveModel(model2)\n\\tif err != nil {\n\\t\\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\n\\t\\tos.Exit(1)\n\\t}\n'''\nreplacement = insert_after + '''\n\\tif input != \"\" {\n\\t\\tif _, err := os.Stat(input); err != nil {\n\\t\\t\\tfmt.Fprintln(os.Stderr, \"file not found\")\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\\t}\n'''\nif insert_after in s and 'if input != \"\" {\n\\t\\tif _, err := os.Stat(input); err != nil {\n\\t\\t\\tfmt.Fprintln(os.Stderr, \"file not found\")\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\\t}\n\n\\tw1, cfg1' not in s:\n    s = s.replace(insert_after, replacement, 1)\n\np.write_text(s)\nPY\ngofmt -w commands"]
[13065.280486, "i", "_extra.go main.go && go build ./...\n"]
