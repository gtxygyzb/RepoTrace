[12171.339073, "o", "   156\t\tcase \"\", \"none\":\r\n   157\t\t\treturn activationNone, nil\r\n   158\t\tcase \"sigmoid\":\r\n   159\t\t\treturn activationSigmoid, nil\r\n   160\t\tcase \"relu\":\r\n"]
[12171.339143, "o", "   161\t\t\treturn activationReLU, nil\r\n   162\t\tcase \"tanh\":\r\n   163\t\t\treturn activationTanh, nil\r\n   164\t\tdefault:\r\n   165\t\t\treturn 0, fmt.Errorf(\"invalid activation\")\r\n   166\t\t}\r\n   167\t}\r\n   168\t\r\n   169\tfunc activationIDToName(id uint32) string {\r\n   170\t\tswitch id {\r\n   171\t\tcase activationNone:\r\n   172\t\t\treturn \"none\"\r\n   173\t\tcase activationSigmoid:\r\n   174\t\t\treturn \"sigmoid\"\r\n   175\t\tcase activationReLU:\r\n"]
[12171.339217, "o", "   176\t\t\treturn \"relu\"\r\n   177\t\tcase activationTanh:\r\n   178\t\t\treturn \"tanh\"\r\n   179\t\tdefault:\r\n   180\t\t\treturn \"unknown\"\r\n"]
[12171.339299, "o", "   181\t\t}\r\n   182\t}\r\n   183\t\r\n   184\tfunc applyActivation(x float64, activation uint32) float64 {\r\n   185\t\tswitch activation {\r\n   186\t\tcase activationSigmoid:\r\n   187\t\t\treturn 1.0 / (1.0 + math.Exp(-x))\r\n   188\t\tcase activationReLU:\r\n   189\t\t\tif x < 0 {\r\n   190\t\t\t\treturn 0\r\n"]
[12171.339369, "o", "   191\t\t\t}\r\n   192\t\t\treturn x\r\n   193\t\tcase activationTanh:\r\n   194\t\t\treturn math.Tanh(x)\r\n   195\t\tdefault:\r\n   196\t\t\treturn x\r\n   197\t\t}\r\n   198\t}\r\n   199\t\r\n   200\tfunc saveModelMeta(modelDir string, meta map[string]string) error {\r\n   201\t\tf, err := os.Create(filepath.Join(modelDir, \"model.meta\"))\r\n   202\t\tif err != nil {\r\n   203\t\t\treturn err\r\n   204\t\t}\r\n   205\t\tdefer f.Close()\r\n   206\t\r\n   207\t\tkeys := make([]string, 0, len(meta))\r\n"]
[12171.339443, "o", "   208\t\tfor k := range meta {\r\n   209\t\t\tkeys = append(keys, k)\r\n   210\t\t}\r\n   211\t\tsort.Strings(keys)\r\n   212\t\tfor _, k := range keys {\r\n"]
[12171.339511, "o", "   213\t\t\tfmt.Fprintf(f, \"%s=%s\\n\", k, meta[k])\r\n   214\t\t}\r\n   215\t\treturn nil\r\n   216\t}\r\n   217\t\r\n   218\ttype PipelineConfig struct {\r\n   219\t\tNormalize       bool\r\n   220\t\tScaleMin        float64\r\n   221\t\tScaleMax        float64\r\n   222\t\tMissingStrategy string\r\n   223\t\tRoundDigits     int\r\n   224\t\tClipMin         float64\r\n   225\t\tClipMax         float64\r\n   226\t\tFeatureNames    []string\r\n   227\t}\r\n   228\t\r\n"]
[12171.339581, "o", "   229\tfunc loadPipelineConfig(modelDir string) (*PipelineConfig, error) {\r\n   230\t\tf, err := os.Open(filepath.Join(modelDir, \"pipeline.cfg\"))\r\n   231\t\tif err != nil {\r\n   232\t\t\treturn nil, err\r\n   233\t\t}\r\n   234\t\tdefer f.Close()\r\n   235\t\r\n   236\t\tcfg := &PipelineConfig{\r\n   237\t\t\tScaleMin:        0.0,\r\n   238\t\t\tScaleMax:        1.0,\r\n"]
