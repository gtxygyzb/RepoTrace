[7544.754584, "o", "\t\tif v < wmin {\r\n   406\t\t\t\t\twmin = v\r\n   407\t\t\t\t}\r\n   408\t\t\t\tif v > wmax {\r\n   409\t\t\t\t\twmax = v\r\n   410\t\t\t\t}\r\n   411\t\t\t\twsum += v\r\n   412\t\t\t\tif v == 0 {\r\n   413\t\t\t\t\tzeroCount++\r\n"]
