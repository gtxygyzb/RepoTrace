[276.453742, "o", "func cmdRun(args []string) {\r\n    14\t\tif len(args) < 1 {\r\n    15\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe run <model> [--input <file>] [--output <file>] [--format csv|json]\\n\")\r\n    16\t\t\tos.Exit(1)\r\n    17\t\t}\r\n    18\t\r\n    19\t\tmodelName := args[0]\r\n    20\t\tflags := parseFlags(args[1:])\r\n    21\t\r\n    22\t\tinputFile := flags[\"input\"]\r\n    23\t\tif inputFile == \"\" {\r\n    24\t\t\tfmt.Fprintf(os.Stderr, \"error: --input is required\\n\")\r\n    25\t\t\tos.Exit(1)\r\n    26\t\t}\r\n    27\t\r\n    28\t\toutputFormat := flags[\"format\"]\r\n    29\t\tif outputFormat == \"\" {\r\n    30\t\t\toutputFormat = \"csv\"\r\n    31\t\t}\r\n    32\t\tif outputFormat != \"csv\" && outputFormat != \"json\" {\r\n    33\t\t\tfmt.Fprintf(os.Stderr, \"error: unsupported format '%s', use 'csv' or 'json'\\n\", outputFormat)\r\n    34\t\t\tos.Exit(1)\r\n    35\t\t}\r\n    36\t\r\n    37\t\tentries, err := loadRegistry()\r\n    38\t\tif err != nil {\r\n    39\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    40\t\t\tos.Exit(1)\r\n    41\t\t}\r\n    42\t\r\n    43\t\tentry := findEntry(entries, modelName)\r\n    44\t\tif entry == nil {"]
[276.453888, "o", "\r\n    45\t\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", modelName)\r\n    46\t\t\tos.Exit(1)\r\n    47\t\t}\r\n    48\t\r\n    49\t\tweights, err := loadWeights(entry.Path)\r\n    50\t\tif err != nil {\r\n    51\t\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n    52\t\t\tos.Exit(1)\r\n    53\t\t}\r\n    54\t\r\n    55\t\tpipelineCfg, err := loadPipelineConfig(entry.Path)\r\n    56\t\tif err != nil {\r\n    57\t\t\tfmt.Fprintf(os.Stderr, \"error loading pipeline config: %v\\n\", err)\r\n    58\t\t\tos.Exit(1)\r\n    59\t\t}\r\n    60\t\r\n    61\t\tinputs, err := readInputCSV(inputFile)\r\n    62\t\tif err != nil {\r\n    63\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    64\t\t\tos.Exit(1)\r\n    65\t\t}\r\n    66\t\r\n    67\t\tresults := runInference(inputs, weights, pipelineCfg)\r\n    68\t\r\n    69\t\toutputFile := flags[\"output\"]\r\n    70\t\tif outputFile != \"\" {\r\n"]
[276.453962, "o", "    71\t\t\tf, err := os.Create(outputFile)\r\n    72\t\t\tif err != nil {\r\n    73\t\t\t\tfmt.Fprintf(os.Stderr, \"error creating output file: %v\\n\", err)\r\n    74\t\t\t\tos.Exit(1)\r\n    75\t\t\t}\r\n    76\t\t\tdefer f.Close()\r\n    77\t\t\twriteOutput(f, results, outputFormat)\r\n    78\t\t} else {\r\n    79\t\t\twriteOutput(os.Stdout, results, outputFormat)\r\n    80\t\t}\r\n    81"]
[276.454043, "o", "\t}\r\n    82\t\r\n    83\tfunc readInputCSV(path string) ([][]float64, error) {\r\n    84\t\tf, err := os.Open(path)\r\n    85\t\tif err != nil {\r\n    86\t\t\treturn nil, err\r\n    87\t\t}\r\n    88\t\tdefer f.Close()\r\n    89\t\r\n    90\t\treader := csv.NewReader(f)\r\n    91\t\trecords, err := reader.ReadAll()\r\n    92\t\tif err != nil {\r\n    93\t\t\treturn nil, err\r\n"]
[276.454102, "o", "    94\t\t}\r\n    95\t\r\n    96\t\tvar data [][]float64\r\n    97\t\tfor i, record := range records {\r\n    98\t\t\tif i == 0 && isHeader(record) {\r\n    99\t\t\t\tcontinue\r\n   100\t\t\t}\r\n"]
[276.454161, "o", "   101\t\t\trow := make([]float64, len(record))\r\n   102\t\t\tfor j, val := range record {\r\n   103\t\t\t\tval = strings.TrimSpace(val)\r\n   104\t\t\t\tif val == \"\" || val == \"NA\" || val == \"nan\" {\r\n   105\t\t\t\t\trow[j] = math.NaN()\r\n   106\t\t\t\t} else {\r\n   107\t\t\t\t\trow[j], err = strconv.ParseFloat(val, 64)\r\n   108\t\t\t\t\tif err != nil {\r\n   109\t\t\t\t\t\treturn nil, fmt.Errorf(\"row %d col %d: %v\", i, j, err)\r\n"]
