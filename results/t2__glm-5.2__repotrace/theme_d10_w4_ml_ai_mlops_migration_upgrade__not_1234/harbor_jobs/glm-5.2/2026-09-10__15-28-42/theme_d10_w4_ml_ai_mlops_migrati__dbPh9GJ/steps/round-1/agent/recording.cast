[7471.069525, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t"]
[7471.069702, "o", "\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nconst (\r\n\tregistryFile     = \"/app/models/registry.idx\"\r\n"]
[7471.069825, "o", "\tregistryJSONFile = \"/app/models/registry.json\"\r\n)\r\n\r\ntype RegistryEntry struct {\r\n\tName    string   `json:\"name\"`\r\n\tPath    string   `json:\"path\"`\r\n\tType    string   `json:\"type\"`\r\n\tVersion int      `json:\"version\"`\r\n\tCreated string   `json:\"created\"`\r\n\tTags    []string `json:\"tags\"`\r\n}\r\n\r\nfunc loadRegistry() ([]RegistryEntry, error) {\r\n\tdata, err := os.ReadFile(registryJSONFile)\r\n\tif err == nil {\r\n\t\tif len(strings.TrimSpace(string(data))) == 0 {\r\n\t\t\treturn nil, nil\r\n\t\t}\r\n\t\tvar entries []RegistryEntry\r\n\t\tif err := json.Unmarshal(data, &entries); err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"parse registry.json: %w\", err)\r\n\t\t}\r\n\t\tfor i := range entries {\r\n\t\t\tentries[i].Tags = ensureTags(entries[i].Tags)\r\n\t\t}\r\n\t\treturn entries, nil\r\n\t}\r\n\tif !os.IsNotExist(err) {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tif _, err := os.Stat(registryFile); err == nil {\r\n\t\tentries, err := loadOldRegistry()\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tif err := saveRegistry(entries); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n"]
[7471.069956, "o", "\t\treturn entries, nil\r\n\t}\r\n\r\n\treturn nil, nil\r\n}\r\n\r\nfunc loadOldRegistry() ([]RegistryEntry, error) {\r\n\tf, err := os.Open(registryFile)\r\n\tif err != nil {\r\n"]
[7471.070024, "o", "\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, nil\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tvar entries []RegistryEntry\r\n\tscanner := bufio.NewScanner(f)\r\n\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.Split(line, \"|\")\r\n\t\tif len(parts) != 5 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tver := 1\r\n"]
[7471.070085, "o", "\t\tfmt.Sscanf(parts[3], \"%d\", &ver)\r\n\t\tentries = append(entries, RegistryEntry{\r\n\t\t\tName:    parts[0],\r\n\t\t\tPath:    parts[1],\r\n\t\t\tType:    parts[2],\r\n\t\t\tVersion: ver,\r\n\t\t\tCreated: parts[4],\r\n\t\t\tTags:    []string{},\r\n\t\t})\r\n"]
[7471.070144, "o", "\t}\r\n\treturn entries, scanner.Err()\r\n}\r\n\r\nfunc saveRegistry(entries []RegistryEntry) error {\r\n\tdir := filepath.Dir(registryJSONFile)\r\n\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n\tout := make([]RegistryEntry, len(entries))\r\n\tfor i, e := range entries {\r\n"]
[7471.070202, "o", "\t\te.Tags = ensureTags(e.Tags)\r\n\t\tout[i] = e\r\n\t}\r\n\r\n\tdata, err := json.MarshalIndent(out, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(registryJSONFile, data, 0644)\r\n}\r\n\r\n"]
[7471.070266, "o", "func ensureTags(tags []string) []string {\r\n\tif tags == nil {\r\n\t\treturn []string{}\r\n\t}\r\n\treturn tags\r\n}\r\n\r\nfunc findEntry(entries []RegistryEntry, name string) *RegistryEntry {\r\n\tfor i := range entries {\r\n\t\tif entries[i].Name == name {\r\n\t\t\treturn &entries[i]\r\n\t\t}\r\n\t}"]
[7471.070328, "o", "\r\n\treturn nil\r\n}\r\n\r\nfunc cmdList(args []string) {\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t"]
[7471.07039, "o", "}\r\n\tif len(entries) == 0 {\r\n\t\tfmt.Println(\"No models registered.\")\r\n\t\treturn\r\n\t}\r\n\r\n\tsort.Slice(entries, func(i, j int) bool {\r\n\t\treturn entries[i].Name < entries[j].Name\r\n\t})\r\n\r\n\tfor _, e := range entries {\r\n\t"]
[7471.07046, "o", "\ttags := append([]string(nil), e.Tags...)\r\n\t\tsort.Strings(tags)\r\n\t\tif len(tags) > 0 {\r\n\t\t\tfmt.Printf(\"%s (%s)\\n\", e.Name, strings.Join(tags, \", \"))\r\n\t\t} else {\r\n\t\t\tfmt.Println(e.Name)\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc cmdInfo(args []string) {\r\n"]
[7471.070522, "o", "\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe info <model>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {"]
[7471.070586, "o", "\r\n\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif !modelDirExists(entry.Path) {\r\n"]
[7471.070647, "o", "\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmeta, err := loadModelMeta(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tweights, err := loadWeights(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[7471.070727, "o", "\tfmt.Printf(\"Name:        %s\\n\", meta[\"name\"])\r\n\tfmt.Printf(\"Type:        %s\\n\", meta[\"type\"])\r\n\tfmt.Printf(\"Version:     %s\\n\", meta[\"version\"])\r\n\tfmt.Printf(\"Created:     %s\\n\", meta[\"created\"])\r\n\tfmt.Printf(\"Description: %s\\n\", meta[\"description\"])\r\n\tfmt.Printf(\"Features:    %s\\n\", meta[\"features\"])\r\n\tfmt.Printf(\"Outputs:     %s\\n\", meta[\"outputs\"])\r\n\tfmt.Printf(\"Format:     v%d\\n\", weights.Version)\r\n\tfmt.Printf(\"Activation: %s\\n\", activationIDToName(weights.Activation))\r\n\tfmt.Printf(\"Path:        %s\\n\", entry.Path)\r\n\tfmt.Printf(\"Checkpoints: %d\\n\", countCheckpoints(entry.Path))\r\n}\r\n\r\n"]
[7471.070821, "o", "func cmdRegister(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe register <name> <path>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[7471.070889, "o", "\tname := args[0]\r\n\tmodelPath := args[1]\r\n\r\n\tabsPath, err := filepath.Abs(modelPath)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif _, err := os.Stat(filepath.Join(absPath, \"model.meta\")); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: no model.meta found at %s\\n\", absPath)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmeta, err := loadModelMeta(absPath)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := loadRegistry()\r\n"]
[7471.070951, "o", "\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif findEntry(entries, name) != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' already registered\\n\", name)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmodelType := meta[\"type\"]\r\n"]
[7471.071014, "o", "\tif modelType == \"\" {\r\n\t\tmodelType = \"unknown\"\r\n\t}\r\n\r\n\tentries = append(entries, RegistryEntry{\r\n\t\tName:    name,\r\n\t\tPath:    absPath,\r\n\t\tType:    modelType,\r\n\t\tVersion: 1,\r\n"]
[7471.071077, "o", "\t\tCreated: time.Now().Format(\"2006-01-02\"),\r\n\t\tTags:    []string{},\r\n\t})\r\n\r\n\tif err := saveRegistry(entries); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Printf(\"Model '%s' registered successfully.\\n\", name)\r\n}\r\n\r\n"]
