[251.08054, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/binary\"\r\n     6\t\t\"fmt\"\r\n     7\t\t"]
[251.080692, "o", "\"math\"\r\n     8\t\t\"os\"\r\n     9\t\t\"path/filepath\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t)\r\n    13\t\r\n"]
[251.080858, "o", "    14\tvar modelMagic = []byte(\"MLPW\")\r\n    15\t\r\n    16\tfunc loadModelMeta(modelDir string) (map[string]string, error) {\r\n    17\t\tf, err := os.Open(filepath.Join(modelDir, \"model.meta\"))\r\n    18\t\tif err != nil {\r\n    19\t\t\treturn nil, err\r\n    20\t\t}\r\n    21\t\tdefer f.Close()\r\n    22\t\r\n    23\t\tmeta := make(map[string]string)\r\n    24\t\tscanner := bufio.NewScanner(f)\r\n    25\t\tfor scanner.Scan() {\r\n    26\t\t\tline := strings.TrimSpace(scanner.Text())\r\n    27\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    28\t\t\t\tcontinue\r\n    29\t\t\t}\r\n    30\t\t\tparts := strings.SplitN(line, \"=\", 2)\r\n    31\t\t\tif len(parts) == 2 {\r\n    32\t\t\t\tmeta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])\r\n    33\t\t\t}\r\n    34\t\t}\r\n    35\t\treturn meta, scanner.Err()\r\n    36\t}\r\n"]
[251.080974, "o", "    37\t\r\n    38\ttype WeightsData struct {\r\n    39\t\tVersion     uint32\r\n    40\t\tNumFeatures uint32\r\n    41\t\tNumOutputs  uint32\r\n    42\t\tWeights     []float64\r\n    43\t\tBias        []float64\r\n    44\t}\r\n    45\t\r\n    46\tfunc loadWeights(modelDir string) (*WeightsData, error) {\r\n    47\t\tf, err := os.Open(filepath.Join(modelDir, \"weights.bin\"))\r\n    48\t\tif err != nil {\r\n    49\t\t\treturn nil, err\r\n    50\t\t}\r\n    51\t\tdefer f.Close()\r\n    52\t\r\n    53\t\tmagic := make([]byte, 4)\r\n    54\t\tif _, err := f.Read(magic); err != nil {\r\n    55\t\t\treturn nil, fmt.Errorf(\"failed to read magic: %v\", err)\r\n    56\t\t}\r\n    57\t\tif string(magic) != string(modelMagic) {\r\n    58\t\t\treturn nil, fmt.Errorf(\"invalid model file: bad magic\")\r\n    59\t\t}\r\n    60\t\r\n    61\t\tvar ver, nf, no uint32\r\n    62\t\tif err := binary.Read(f, binary.LittleEndian, &ver); err != nil {\r\n    63\t\t\treturn nil, fmt.Errorf(\"failed to read version: %v\", err)\r\n    64\t\t}\r\n    65\t\tif err := binary.Read(f, binary.LittleEndian, &nf); err != nil {\r\n    66\t\t\treturn nil, fmt.Error"]
[251.081054, "o", "f(\"failed to read num_features: %v\", err)\r\n    67\t\t}\r\n    68\t\t// BUG: reads num_outputs as BigEndian instead of LittleEndian\r\n    69\t\tif err := binary.Read(f, binary.BigEndian, &no); err != nil {\r\n    70\t\t\treturn nil, fmt.Errorf(\"failed to read num_outputs: %v\", err)\r\n    71\t\t}\r\n    72\t\r\n    73\t\tweights := make([]float64, nf*no)\r\n    74\t\tfor i := range weights {\r\n    75\t\t\tif err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {\r\n    76\t\t\t\treturn nil, fmt.Errorf(\"failed to read weight[%d]: %v\", i, err)\r\n    77\t\t\t}\r\n    78\t\t}\r\n    79\t\r\n    80\t\tbias := make([]float64, no)\r\n"]
[251.081127, "o", "    81\t\tfor i := range bias {\r\n    82\t\t\tif err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {\r\n    83\t\t\t\treturn nil, fmt.Errorf(\"failed to read bias[%d]: %v\", i, err)\r\n    84\t\t\t}\r\n    85\t\t}\r\n    86\t\r\n    87\t\treturn &WeightsData{\r\n    88\t\t\tVersion:     ver,\r\n    89\t\t\tNumFeatures: nf,\r\n    90\t\t\tNumOutputs:  no,\r\n    91"]
[251.081198, "o", "\t\t\tWeights:     weights,\r\n    92\t\t\tBias:        bias,\r\n    93\t\t}, nil\r\n    94\t}\r\n    95\t\r\n    96\tfunc writeWeights(path string, w *WeightsData) error {\r\n    97\t\tf, err := os.Create(path)\r\n    98\t\tif err != nil {\r\n    99\t\t\treturn err\r\n   100\t\t}\r\n   101\t\tdefer f.Close()\r\n"]
[251.081266, "o", "   102\t\r\n   103\t\tif _, err := f.Write(modelMagic); err != nil {\r\n   104\t\t\treturn err\r\n   105\t\t}\r\n   106\t\tif err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {\r\n   107\t\t\treturn err\r\n   108\t\t}\r\n   109\t\tif err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {\r\n"]
[251.081331, "o", "   110\t\t\treturn err\r\n   111\t\t}\r\n   112\t\tif err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {\r\n   113\t\t\treturn err\r\n   114\t\t}\r\n   115\t\tfor _, v := range w.Weights {\r\n   116\t\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n   117\t\t\t\treturn err\r\n   118\t\t\t}\r\n   119\t\t}\r\n   120\t"]
[251.081416, "o", "\tfor _, v := range w.Bias {\r\n   121\t\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n   122\t\t\t\treturn err\r\n   123\t\t\t}\r\n   124\t\t}\r\n   125\t\treturn nil\r\n   126\t}\r\n   127\t\r\n   128\ttype PipelineConfig struct {\r\n   129\t\tNormalize       bool\r\n   130\t\tScaleMin        float64\r\n   131\t\tScaleMax        float64\r\n"]
[251.081495, "o", "   132\t\tMissingStrategy string\r\n   133\t\tRoundDigits     int\r\n   134\t\tClipMin         float64\r\n   135\t\tClipMax         float64\r\n   136\t}\r\n   137\t\r\n   138\tfunc loadPipelineConfig(modelDir string) (*PipelineConfig, error) {\r\n   139\t\tf, err := os.Open(filepath.Join(modelDir, \"pipeline.cfg\"))\r\n   140\t\tif err != nil {\r\n   141\t\t\treturn nil, err\r\n   142"]
[251.081561, "o", "\t\t}\r\n   143\t\tdefer f.Close()\r\n   144\t\r\n   145\t\tcfg := &PipelineConfig{\r\n   146\t\t\tScaleMin:        0.0,\r\n   147\t\t\tScaleMax:        1.0,\r\n   148\t\t\tMissingStrategy: \"zero\",\r\n   149\t\t\tRoundDigits:     4,\r\n   150\t\t\tClipMin:         -1000.0,"]
[251.081674, "o", "\r\n   151\t\t\tClipMax:         1000.0,\r\n   152\t\t}\r\n   153\t\r\n   154\t\tscanner := bufio.NewScanner(f)\r\n   155\t\tsection := \"\"\r\n   156\t\tfor scanner.Scan() {\r\n   157\t\t\tline := strings.TrimSpace(scanner.Text())\r\n   158\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n   159\t\t\t\tcontinue\r\n   160\t\t\t}\r\n   161\t\t\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\r\n   162\t\t\t\tsection = line[1 : len(line)-1]\r\n   163\t\t\t\tcontinue\r\n   164\t\t\t}\r\n   165"]
[251.081748, "o", "\t\t\tparts := strings.SplitN(line, \"=\", 2)\r\n   166\t\t\tif len(parts) != 2 {\r\n   167\t\t\t\tcontinue\r\n   168\t\t\t}\r\n"]
[251.081843, "o", "   169\t\t\tkey := strings.TrimSpace(parts[0])\r\n   170\t\t\tval := strings.TrimSpace(parts[1])\r\n   171\t\r\n   172\t\t\tswitch section {\r\n   173\t\t\tcase \"preprocess\":\r\n   174\t\t\t\tswitch key {\r\n   175\t\t\t\tcase \"normalize\":\r\n   176\t\t\t\t\tcfg.Normalize = val == \"true\"\r\n   177\t\t\t\tcase \"scale_range\":\r\n   178\t\t\t\t\trangeParts := strings.Split(val, \",\")\r\n   179\t\t\t\t\tif len(rangeParts) == 2 {\r\n   180\t\t\t\t\t\tcfg.ScaleMin, _ = strconv.ParseFloat(rangeParts[0], 64)\r\n   181\t\t\t\t\t\tcfg.ScaleMax, _ = strconv.ParseFloat(rangeParts[1], 64)\r\n   182\t\t\t\t\t}\r\n   183\t\t\t\tcase \"missing_strategy\":\r\n   184\t\t\t\t\tcfg.MissingStrategy = val\r\n"]
[251.081917, "o", "   185\t\t\t\t}\r\n   186\t\t\tcase \"postprocess\":\r\n   187\t\t\t\tswitch key {\r\n   188\t\t\t\tcase \"round_digits\":\r\n   189\t\t\t\t\tcfg.RoundDigits, _ = strconv.Atoi(val)\r\n   190\t\t\t\tcase \"clip_min\":\r\n   191\t\t\t\t\tcfg.ClipMin, _ = strconv.ParseFloat(val, 64)\r\n   192\t\t\t\tcase \"clip_max\":\r\n   193\t\t\t\t\tcfg.ClipMax, _ = strconv.ParseFloat(val, 64)\r\n   194\t\t\t\t}\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197"]
[251.081982, "o", "\t\treturn cfg, scanner.Err()\r\n   198\t}\r\n   199\t\r\n   200\tfunc roundToDigits(val float64, digits int) float64 {\r\n   201\t\tpow := math.Pow(10, float64(digits))\r\n   202\t\treturn math.Round(val*pow) / pow\r\n   203\t}\r\n"]
