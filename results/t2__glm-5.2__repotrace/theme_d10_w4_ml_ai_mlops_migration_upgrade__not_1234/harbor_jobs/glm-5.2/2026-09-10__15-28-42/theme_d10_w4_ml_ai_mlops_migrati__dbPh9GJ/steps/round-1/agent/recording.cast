[5910.653857, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n"]
[5910.653966, "o", "     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n"]
[5910.654044, "o", "     9\t\t\"sort\"\r\n    10\t\t\"strings\"\r\n    11\t\t\"time\"\r\n    12\t)\r\n    13\t\r\n    14\tconst (\r\n    15\t\tregistryFile     = \"/app/models/registry.idx\"\r\n    16\t\tregistryJSONFile = \"/app/models/registry.json\"\r\n    17\t)\r\n    18\t\r\n    19\ttype RegistryEntry struct {\r\n    20\t\tName    string   `json:\"name\"`\r\n    21\t\tPath    string   `json:\"path\"`\r\n    22\t\tType    string   `json:\"type\"`\r\n    23\t\tVersion int      `json:\"version\"`\r\n    24\t\tCreated string   `json:\"created\"`\r\n    25\t\tTags    []string `json:\"tags\"`\r\n    26\t}\r\n    27\t\r\n    28\tfunc loadRegistry() ([]RegistryEntry, error) {\r\n    29\t\tdata, err := os.ReadFile(registryJSONFile)\r\n    30"]
[5910.654144, "o", "\t\tif err == nil {\r\n    31\t\t\tif len(strings.TrimSpace(string(data))) == 0 {\r\n    32\t\t\t\treturn nil, nil\r\n    33\t\t\t}\r\n    34\t\t\tvar entries []RegistryEntry\r\n"]
[5910.654207, "o", "    35\t\t\tif err := json.Unmarshal(data, &entries); err != nil {\r\n    36\t\t\t\treturn nil, fmt.Errorf(\"parse registry.json: %w\", err)\r\n    37\t\t\t}\r\n    38\t\t\tfor i := range entries {\r\n    39\t\t\t\tentries[i].Tags = ensureTags(entries[i].Tags)\r\n    40\t\t\t}\r\n    41\t\t\treturn entries, nil\r\n    42\t\t}\r\n    43\t\tif !os.IsNotExist(err) {\r\n    44\t\t\treturn nil, err\r\n    45\t\t}\r\n    46\t\r\n    47\t\tif _, err := os.Stat(registryFile); err == nil {\r\n    48\t\t\tentries, err := loadOldRegistry()\r\n    49\t\t\tif err != nil {\r\n    50\t\t\t\treturn nil, err\r\n    51\t\t\t}\r\n"]
[5910.654266, "o", "    52\t\t\tif err := saveRegistry(entries); err != nil {\r\n    53\t\t\t\treturn nil, err\r\n    54\t\t\t}\r\n    55\t\t\treturn entries, nil\r\n    56\t\t}\r\n    57\t\r\n    58\t\treturn nil, nil\r\n    59\t}\r\n    60\t\r\n"]
[5910.65438, "o", "    61\tfunc loadOldRegistry() ([]RegistryEntry, error) {\r\n    62\t\tf, err := os.Open(registryFile)\r\n    63\t\tif err != nil {\r\n    64\t\t\tif os.IsNotExist(err) {\r\n    65\t\t\t\treturn nil, nil\r\n    66\t\t\t}\r\n    67\t\t\treturn nil, err\r\n    68\t\t}\r\n    69\t\tdefer f.Close()\r\n    70\t\r\n    71\t\tvar entries []RegistryEntry\r\n    72\t\tscanner := bufio.NewScanner(f)\r\n    73\t\tfor scanner.Scan() {\r\n    74\t\t\tline := strings.TrimSpace(scanner.Text())\r\n    75\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    76\t\t\t\tcontinue\r\n    77\t\t\t}\r\n    78\t\t\tparts := strings.Split(line, \"|\")"]
[5910.654446, "o", "\r\n    79\t\t\tif len(parts) != 5 {\r\n    80\t\t\t\tcontinue\r\n    81\t\t\t}\r\n    82\t\t\tver := 1\r\n    83\t\t\tfmt.Sscanf(parts[3], \"%d\", &ver)\r\n    84\t\t\tentries = append(entries, RegistryEntry{\r\n    85\t\t\t\tName:    parts[0],\r\n    86\t\t\t\tPath:    parts[1],\r\n    87\t\t\t\tType:    parts[2],\r\n"]
[5910.654505, "o", "    88\t\t\t\tVersion: ver,\r\n    89\t\t\t\tCreated: parts[4],\r\n    90\t\t\t\tTags:    []string{},\r\n    91\t\t\t})\r\n    92\t\t}\r\n    93\t\treturn entries, scanner.Err()\r\n    94\t}\r\n    95\t\r\n    96\tfunc saveRegistry(entries []RegistryEntry) error {\r\n"]
[5910.654565, "o", "    97\t\tdir := filepath.Dir(registryJSONFile)\r\n    98\t\tif err := os.MkdirAll(dir, 0755); err != nil {\r\n    99\t\t\treturn err\r\n   100\t\t}\r\n   101\t\r\n   102\t\tout := make([]RegistryEntry, len(entries))\r\n   103\t\tfor i, e := range entries {\r\n   104\t\t\te.Tags = ensureTags(e.Tags)\r\n   105"]
[5910.654629, "o", "\t\t\tout[i] = e\r\n   106\t\t}\r\n   107\t\r\n   108\t\tdata, err := json.MarshalIndent(out, \"\", \"  \")\r\n   109\t\tif err != nil {\r\n   110\t\t\treturn err\r\n   111\t\t}\r\n   112\t\treturn os.WriteFile(registryJSONFile, data, 0644)\r\n   113\t}\r\n   114\t\r\n   115\tfunc ensureTags(tags []string) []string {"]
[5910.654688, "o", "\r\n   116\t\tif tags == nil {\r\n   117\t\t\treturn []string{}\r\n   118\t\t}\r\n   119\t\treturn tags\r\n   120\t}\r\n"]
