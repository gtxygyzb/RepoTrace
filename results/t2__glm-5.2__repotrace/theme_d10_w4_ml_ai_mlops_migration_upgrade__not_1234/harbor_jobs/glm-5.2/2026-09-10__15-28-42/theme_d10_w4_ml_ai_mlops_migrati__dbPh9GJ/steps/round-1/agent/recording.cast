[12988.906893, "o", "func cmdCompare(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe compare <model1> <model2> [--input <file>]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmodel1 := args[0]"]
[12988.906943, "o", "\r\n\tmodel2 := args[1]\r\n\tflags := parseFlags(args[2:])\r\n\tinput := flags[\"input\"]\r\n\r\n\tif input != \"\" {\r\n\t\tif _, err := os.Stat(input); err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"file not found\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
[12988.907042, "o", "\t}\r\n\r\n\tentry1, err := resolveModel(model1)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentry2, err := resolveModel(model2)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tw1, cfg1, err := loadModelArtifacts(entry1.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading model '%s': %v\\n\", model1, err)\r\n\t"]
[12988.907113, "o", "\tos.Exit(1)\r\n\t}\r\n\r\n\tw2, cfg2, err := loadModelArtifacts(entry2.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading model '%s': %v\\n\", model2, err)\r\n\t\tos.Exit(1)\r\n"]
[12988.907179, "o", "\t}\r\n\r\n\tfmt.Printf(\"Comparing '%s' vs '%s'\\n\\n\", model1, model2)\r\n\r\n\tfeaturesMatch := w1.NumFeatures == w2.NumFeatures\r\n\toutputsMatch := w1.NumOutputs == w2.NumOutputs\r\n\tformatMatch := w1.Version == w2.Version\r\n\tactivationMatch := w1.Activation == w2.Activation\r\n\r\n\tfmt.Println(\"Structure:\")\r\n\tfmt.Printf(\"  Features:   %d vs %d [%s]\\n\", w1.NumFeatures, w2.NumFeatures, matchLabel(featuresMatch))\r\n\tfmt.Printf(\"  Outputs:    %d vs %d [%s]\\n\", w1.NumOutputs, w2.NumOutputs, matchLabel(outputsMatch))\r\n\tfmt.Printf(\"  Format:     v%d vs v%d [%s]\\n\", w1.Version, w2.Version, matchLabel(formatMatch))\r\n\tfmt.Printf(\"  Activation: %s vs %s [%s]\\n\", activationIDToName(w1.Activation), activationIDToName(w2.Activation), matchLabel(activationMatch))\r\n\tfmt.Println()\r\n\r\n\tif !featuresMatch || !outputsMatch {\r\n\t\tfmt.Println(\"skipping weight comparison: dimension mismatch\")\r\n\t\t"]
[12988.907247, "o", "return\r\n\t}\r\n\r\n\tfmt.Println(\"Weight differences:\")\r\n\tmaxWeightDiff, meanWeightDiff, changedWeights, totalWeights := compareFloatSlices(w1.Weights, w2.Weights)\r\n\tfmt.Printf(\"  Max absolute diff:  %s\\n\", formatFloat(maxWeightDiff))\r\n"]
[12988.907317, "o", "\tfmt.Printf(\"  Mean absolute diff: %s\\n\", formatFloat(meanWeightDiff))\r\n\tpctChanged := 0.0\r\n\tif totalWeights > 0 {\r\n\t\tpctChanged = float64(changedWeights) / float64(totalWeights) * 100.0\r\n\t}\r\n\tfmt.Printf(\"  Weights changed:    %d/%d (%.1f%%)\\n\", changedWeights, totalWeights, pctChanged)\r\n\tfmt.Println()\r\n\r\n\tfmt.Println(\"Bias differences:\")\r\n\tmaxBiasDiff, _, _, _ := compareFloatSlices(w1.Bias, w2.Bias)\r\n\tfmt.Printf(\"  Max absolute diff:  %s\\n\", formatFloat(maxBiasDiff))\r\n\r\n\tif input != \"\" {\r\n\t\tinputs, err := readInputCSV(input)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n"]
[12988.907377, "o", "\t\t}\r\n\r\n\t\tif err := validateFeatureCount(inputs, int(w1.NumFeatures)); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: input feature count mismatch: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\r\n\t\tr1 := runInference(inputs, w1, cfg1)\r\n\t\tr2 := runInference(inputs, w2, cfg2)\r\n\r\n\t\tvar sumAbs, sumSq, maxDiff float64\r\n"]
[12988.907436, "o", "\t\tcount := 0\r\n\t\tagreedRows := 0\r\n\t\tfor i := 0; i < len(r1) && i < len(r2); i++ {\r\n\t\t\trowAgree := true\r\n\t\t\tfor o := 0; o < int(w1.NumOutputs) && o < len(r1[i]) && o < len(r2[i]); o++ {\r\n\t\t\t\td := math.Abs(r1[i][o] - r2[i][o])\r\n\t\t\t\tsumAbs += d\r\n\t\t\t\tsumSq += d * d\r\n\t\t\t\tif d > maxDiff {\r\n"]
[12988.907494, "o", "\t\t\t\t\tmaxDiff = d\r\n\t\t\t\t}\r\n\t\t\t\tcount++\r\n\t\t\t\tif d >= 0.001 {\r\n\t\t\t\t\trowAgree = false\r\n\t\t\t\t}\r\n\t\t\t}"]
[12988.907549, "o", "\r\n"]
[12988.908075, "o", "\u001b[?2004h"]
