[4640.432587, "o", "    34\tfunc cmdExport(args []string) {\r\n    35\t\tif len(args) < 1 {\r\n    36\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe export <model> --output <file>\\n\")\r\n    37\t\t\tos.Exit(1)\r\n    38\t\t}\r\n    39\t\tname := args[0]\r\n    40\t\tflags := parseFlags(args[1:])\r\n    41\t\r\n"]
[4640.432767, "o", "    42\t\toutputPath := flags[\"output\"]\r\n    43\t\tif outputPath == \"\" {\r\n    44\t\t\tfmt.Fprintf(os.Stderr, \"error: --output is required\\n\")\r\n    45\t\t\tos.Exit(1)\r\n    46\t\t}\r\n    47\t\tif !strings.HasSuffix(outputPath, \".json\") {\r\n    48\t\t\toutputPath += \".json\"\r\n    49\t\t}\r\n    50\t\r\n    51\t\tentry, err := resolveModel(name)\r\n    52\t\tif err != nil {\r\n    53\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    54\t\t\tos.Exit(1)\r\n    55\t\t}\r\n    56\t\r\n    57\t\tmeta, err := loadModelMeta(entry.Path)\r\n    58\t\tif err != nil {\r\n    59\t\t\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n    60\t\t\tos.Exit(1)\r\n    61\t\t}\r\n    62\t\r\n    63\t\tweights, err := loadWeights(entry.Path)\r\n    64\t\tif err != nil {\r\n    65\t\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n    66\t\t\tos.Exit(1)\r\n    67\t\t}\r\n    68\t\r\n    69\t\tcfg, err := loadPipelineConfig(entry.Path)\r\n"]
[4640.432841, "o", "    70\t\tif err != nil {\r\n    71\t\t\tfmt.Fprintf(os.Stderr, \"error loading pipeline config: %v\\n\", err)\r\n    72\t\t\tos.Exit(1)\r\n    73\t\t}\r\n    74\t\r\n    75\t\tmodelName := meta[\"name\"]\r\n    76\t\tif modelName == \"\" {\r\n    77\t\t\tmodelName = entry.Name\r\n"]
[4640.432979, "o", "    78\t\t}\r\n    79\t\tmodelType := meta[\"type\"]\r\n    80\t\tif modelType == \"\" {\r\n    81\t\t\tmodelType = \"unknown\"\r\n    82\t\t}\r\n"]
[4640.433069, "o", "    83\t\tmodelVersion := 1\r\n    84\t\tif v, err := strconv.Atoi(meta[\"version\"]); err == nil {\r\n    85\t\t\tmodelVersion = v\r\n    86\t\t}\r\n    87\t\r\n    88\t\tactivation := \"none\"\r\n    89\t\tif weights.Version == 2 {\r\n    90\t\t\tactivation = activationIDToName(weights.Activation)\r\n    91\t\t}\r\n    92\t\r\n    93\t\tif int(weights.NumFeatures) <= 0 || int(weights.NumOutputs) <= 0 {\r\n    94\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid model dimensions\\n\")\r\n    95\t\t\tos.Exit(1)\r\n    96\t\t}\r\n    97\t\tif len(weights.Weights) != int(weights.NumFeatures)*int(weights.NumOutputs) {\r\n    98\t\t\tfmt.Fprintf(os.Stderr, \"error: corrupt weights matrix\\n\")\r\n    99\t\t\tos.Exit(1)\r\n   100\t\t}\r\n"]
[4640.433162, "o", "   101\t\tif len(weights.Bias) != int(weights.NumOutputs) {\r\n   102\t\t\tfmt.Fprintf(os.Stderr, \"error: corrupt bias vector\\n\")\r\n   103\t\t\tos.Exit(1)\r\n   104\t\t}\r\n   105\t\r\n   106\t\tweightMatrix := make([][]float64, weights.NumOutputs)\r\n   107\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n   108\t\t\tstart := o * weights.NumFeatures\r\n   109\t\t\tend := start + weights.NumFeatures\r\n   110\t\t\trow := make([]float64, weights.NumFeatures)\r\n   111\t\t\tcopy(row, weights.Weights[start:end])\r\n   112\t\t\tweightMatrix[o] = row\r\n   113\t\t}\r\n   114\t\r\n   115\t\texport := exportModel{\r\n   116\t\t\tName:          modelName,\r\n   117\t\t\tType:          modelType,\r\n   118\t\t\tVersion:       modelVersion,\r\n   119\t\t\tFormatVersion: int(weights.Version),\r\n"]
