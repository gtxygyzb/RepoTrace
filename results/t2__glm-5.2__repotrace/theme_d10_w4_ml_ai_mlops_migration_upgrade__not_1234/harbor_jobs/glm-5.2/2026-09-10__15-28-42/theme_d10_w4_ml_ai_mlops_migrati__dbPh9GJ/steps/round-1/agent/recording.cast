[289.114457, "o", "\t\r\n    90\t\treader := csv.NewReader(f)\r\n    91\t\trecords, err := reader.ReadAll()\r\n    92\t\tif err != nil {\r\n    93\t\t\treturn nil, err\r\n    94\t\t}\r\n    95\t\r\n    96\t\tvar data [][]float64\r\n    97\t\tfor i, record := range records {\r\n    98\t\t\tif i == 0 && isHeader(record) {\r\n    99\t\t\t\tcontinue\r\n   100\t\t\t}\r\n   101\t\t\trow := make([]float64, len(record))\r\n   102"]
[289.114526, "o", "\t\t\tfor j, val := range record {\r\n   103\t\t\t\tval = strings.TrimSpace(val)\r\n   104\t\t\t\tif val == \"\" || val == \"NA\" || val == \"nan\" {\r\n   105\t\t\t\t\trow[j] = math.NaN()\r\n   106\t\t\t\t} else {\r\n   107\t\t\t\t\t"]
[289.114588, "o", "row[j], err = strconv.ParseFloat(val, 64)\r\n   108\t\t\t\t\tif err != nil {\r\n   109\t\t\t\t\t\treturn nil, fmt.Errorf(\"row %d col %d: %v\", i, j, err)\r\n   110\t\t\t\t\t}\r\n   111\t\t\t\t}\r\n"]
