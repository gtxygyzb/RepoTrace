[7555.222148, "o", "    54\t\t\tcmdCheckpoint(args)\r\n    55\t\tcase \"checkpoints\":\r\n    56\t\t\tcmdCheckpoints(args)\r\n    57\t\tcase \"rollback\":\r\n    58\t\t\tcmdRollback(args)\r\n    59\t\tcase \"migrate\":\r\n    60\t\t\tcmdMigrate(args)\r\n    61\t\tcase \"compat\":\r\n    62\t\t\tcmdCompat(args)\r\n    63\t\tcase \"version\":\r\n    64\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    65\t\tcase \"help\":\r\n    66\t\t\tprintUsage()\r\n    67\t\tdefault:\r\n"]
