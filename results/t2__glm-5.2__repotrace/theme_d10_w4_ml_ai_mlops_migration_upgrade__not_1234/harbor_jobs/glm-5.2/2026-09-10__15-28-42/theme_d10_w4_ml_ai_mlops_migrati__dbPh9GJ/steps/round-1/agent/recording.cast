[12648.617747, "o", "    92\t  list                          List all registered models\r\n    93\t  info <model>                  Show model details\r\n    94\t  register <name> <path>        Register a model from directory\r\n    95\t  remove <name>                 Remove a model from registry\r\n    96\t  run <model> [options]         Run inference\r\n    97\t  stats --input <file>          Input statistics profiling\r\n    98\t  diff <model1> <model2> --input <file>\r\n    99\t                                Compare two models on same input\r\n"]
[12648.617866, "o", "   100\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n   101\t                                Batch inference over CSV files\r\n   102\t  validate <model>              Validate model integrity\r\n   103\t  validate-input <model> --input <file>\r\n   104\t                                Validate input data for a model\r\n   105\t  schema <model>                Display expected input schema for a model\r\n   106\t  export <model> --output <file> Export model to JSON file\r\n   107\t  import <path> [--name <name>] Import model from JSON file\r\n   108\t  clone <model> <new_name>      Clone model to new name\r\n   109\t  benchmark <model> --input <file> [--runs <N>]\r\n   110\t                                Benchmark inference performance\r\n   111\t  prune <model> --threshold <value> [--dry-run]\r\n   112\t                                Prune near-zero weights\r\n   113\t  profile <model>               Report model weight analysis\r\n   114\t  explain <model> --input <file> [--row <N>]\r\n   115\t                                  E"]
[12648.617941, "o", "xplain prediction for a row\r\n   116\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n   117\t  compat [--all]                 Check migration compatibility\r\n   118\t  version                       Show version\r\n   119\t  help                          Show this help\r\n   120\t\r\n   121\tRun/Diff Options:\r\n   122"]
[12648.618006, "o", "\t  --input <file>    Input CSV file (required)\r\n   123\t  --output <file>   Output file (default: stdout)\r\n   124\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   125\t  --strict          Validate input before inference and abort on invalid rows\r\n   126\t\r\n   127\tBatch Options:\r\n   128\t  --dir <dir>       Input directory of CSV files\r\n   129\t  --output-dir <dir> Output directory for predictions\r\n   130\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   131\t`\r\n   132\t\tfmt.Print(usage)\r\n"]
[12648.618063, "o", "   133\t}\r\n   134\t\r\n   135\tfunc parseFlags(args []string) map[string]string {\r\n   136\t\tflags := make(map[string]string)\r\n   137\t\tfor i := 0; i < len(args); i++ {\r\n   138\t\t\tif strings.HasPrefix(args[i], \"--\") {\r\n   139\t\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n   140\t\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n   141\t\t\t\t\tflags[key] = args[i+1]\r\n   142\t\t\t\t\ti++\r\n   143\t\t\t\t} else {\r\n"]
[12648.618125, "o", "   144\t\t\t\t\tflags[key] = \"true\"\r\n   145\t\t\t\t}\r\n   146\t\t\t}\r\n   147\t\t}\r\n   148\t\treturn flags\r\n   149\t}\r\n"]
