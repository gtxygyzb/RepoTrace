[4065.038601, "o", "    64\t\r\n    65\tCommands:\r\n    66\t  list                          List all registered models\r\n    67\t  info <model>                  Show model details\r\n    68\t  register <name> <path>        Register a model from directory\r\n    69\t  remove <name>                 Remove a model from registry\r\n    70\t  run <model> [options]         Run inference\r\n    71\t  stats --input <file>          Input statistics profiling\r\n    72\t  diff <model1> <model2> --input <file>\r\n    73\t                                Compare two models on same input\r\n    74\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n"]
