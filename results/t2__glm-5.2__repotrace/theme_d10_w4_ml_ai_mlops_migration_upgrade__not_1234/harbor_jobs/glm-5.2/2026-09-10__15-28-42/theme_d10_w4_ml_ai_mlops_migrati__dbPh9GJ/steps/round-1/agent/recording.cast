[260.089272, "o", "    40\tfunc validateModel(modelDir string) []string {\r\n    41\t\tvar errors []string\r\n    42\t\r\n    43\t\tmetaPath := filepath.Join(modelDir, \"model.meta\")\r\n    44\t\tif _, err := os.Stat(metaPath); err != nil {\r\n    45\t\t\terrors = append(errors, \"missing model.meta\")\r\n    46\t\t} else {\r\n    47\t\t\tmeta, err := loadModelMeta(modelDir)\r\n    48\t\t\tif err != nil {\r\n"]
