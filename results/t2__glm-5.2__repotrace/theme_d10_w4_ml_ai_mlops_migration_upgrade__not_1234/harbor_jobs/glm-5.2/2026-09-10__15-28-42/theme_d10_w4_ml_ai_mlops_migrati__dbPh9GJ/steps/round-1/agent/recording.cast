[6174.302602, "o", "   130\t\r\n   131\t\tfor j := 0; j < numCols; j++ {\r\n   132\t\t\tvalues := make([]float64, 0, len(records)-start)\r\n   133\t\t\tmissing := 0\r\n   134\t\t\tnumeric := true\r\n   135\t\r\n   136\t\t\tfor i := start; i < len(records); i++ {\r\n   137\t\t\t\traw := \"\"\r\n   138\t\t\t\tif j < len(records[i]) {\r\n   139\t\t\t\t\traw = strings.TrimSpace(records[i][j])\r\n   140\t\t\t\t}\r\n"]
[6174.302669, "o", "   141\t\t\t\tif isMissingValue(raw) {\r\n   142\t\t\t\t\tmissing++\r\n   143\t\t\t\t\tvalues = append(values, math.NaN())\r\n   144\t\t\t\t\tcontinue\r\n   145\t\t\t\t}\r\n   146\t\t\t\tv, err := strconv.ParseFloat(raw, 64)\r\n   147\t\t\t\tif err != nil {\r\n   148\t\t\t\t\tnumeric = false\r\n   149\t\t\t\t\tbreak\r\n"]
[6174.302727, "o", "   150\t\t\t\t}\r\n   151\t\t\t\tvalues = append(values, v)\r\n   152\t\t\t}\r\n   153\t\r\n   154\t\t\tif !numeric {\r\n   155\t\t\t\tcontinue\r\n   156\t\t\t}\r\n   157\t\r\n"]
[6174.302785, "o", "   158\t\t\tcount := len(values) - missing\r\n   159\t\t\tst := colStat{\r\n   160\t\t\t\tidx:     j,\r\n   161\t\t\t\tname:    headers[j],\r\n   162\t\t\t\tcount:   count,\r\n   163\t\t\t\tmissing: missing,\r\n   164\t\t\t\tmin:     math.NaN(),\r\n"]
[6174.302877, "o", "   165\t\t\t\tmax:     math.NaN(),\r\n   166\t\t\t\tmean:    math.NaN(),\r\n   167\t\t\t\tstddev:  math.NaN(),\r\n   168\t\t\t\tvalues:  values,\r\n   169\t\t\t}\r\n   170\t\r\n   171\t\t\tif count > 0 {\r\n   172\t\t\t\tsum := 0.0\r\n   173\t\t\t\tsumSq := 0.0\r\n   174\t\t\t\tminVal := math.Inf(1)\r\n   175\t\t\t\tmaxVal := math.Inf(-1)\r\n"]
[6174.302945, "o", "   176\t\t\t\tfor _, v := range values {\r\n   177\t\t\t\t\tif math.IsNaN(v) {\r\n   178\t\t\t\t\t\tcontinue\r\n   179\t\t\t\t\t}\r\n   180\t\t\t\t\tif v < minVal {\r\n"]
[6174.303002, "o", "   181\t\t\t\t\t\tminVal = v\r\n   182\t\t\t\t\t}\r\n   183\t\t\t\t\tif v > maxVal {\r\n   184\t\t\t\t\t\tmaxVal = v\r\n   185\t\t\t\t\t}\r\n   186\t\t\t\t\tsum += v\r\n   187\t\t\t\t\tsumSq += v * v\r\n   188\t\t\t\t}\r\n   189\t\t\t\tmean := sum / float64(count)\r\n   190\t\t\t\tvariance := sumSq/float64(count) - mean*mean\r\n   191\t\t\t\tif variance < 0 {\r\n   192\t\t\t\t\tvariance = 0\r\n"]
[6174.303064, "o", "   193\t\t\t\t}\r\n   194\t\t\t\tst.min = minVal\r\n   195\t\t\t\tst.max = maxVal\r\n   196\t\t\t\tst.mean = mean\r\n   197\t\t\t\tst.stddev = math.Sqrt(variance)\r\n   198\t\t\t}\r\n   199\t\r\n   200\t\t\tstats = append(stats, st)\r\n   201\t\t\t"]
[6174.303123, "o", "numericCols = append(numericCols, j)\r\n   202\t\t\tvaluesByCol[j] = values\r\n   203\t\t}\r\n   204\t\r\n   205\t\tif len(skippedCols) > 0 {\r\n   206\t\t\tfmt.Printf(\"warning: skipping non-numeric columns: %s\\n\", strings.Join(skippedCols, \", \"))\r\n   207\t\t}\r\n"]
[6174.303184, "o", "   208\t\tif len(numericCols) == 0 {\r\n   209\t\t\tfmt.Println(\"error: no numeric columns found\")\r\n   210\t\t\tos.Exit(1)\r\n   211\t\t}\r\n   212\t"]
[6174.303242, "o", "\r\n   213\t\tfmt.Println(\"Per-column statistics:\")\r\n   214\t\tfmt.Printf(\"%-20s %6s %7s %12s %12s %12s %12s\\n\", \"column\", \"count\", \"missing\", \"min\", \"max\", \"mean\", \"stddev\")\r\n   215\t\tfor _, st := range stats {\r\n   216\t\t\tfmt.Printf(\"%-20s %6d %7d %12.4f %12.4f %12.4f %12.4f\\n\", st.name, st.count, st.missing, st.min, st.max, st.mean, st.stddev)\r\n   217\t\t}\r\n   218\t\r\n   219\t\tfmt.Println(\"\\nPearson correlation matrix:\")\r\n   220\t\tfmt.Printf(\"%-20s\", \"\")\r\n   221\t\tfor _, idx := range numericCols {\r\n   222\t\t\tfmt.Printf(\" %12s\", headers[idx])\r\n   223\t\t}\r\n   224\t\tfmt.Println()\r\n   225\t\r\n"]
[6174.303304, "o", "   226\t\tfor _, idx1 := range numericCols {\r\n   227\t\t\tfmt.Printf(\"%-20s\", headers[idx1])\r\n   228\t\t\tfor _, idx2 := range numericCols {\r\n   229\t\t\t\tc := pearson(valuesByCol[idx1], valuesByCol[idx2])\r\n   230"]
[6174.303363, "o", "\t\t\t\tfmt.Printf(\" %12.4f\", c)\r\n   231\t\t\t}\r\n   232\t\t\tfmt.Println()\r\n   233\t\t}\r\n   234\t}\r\n   235\t\r\n"]
