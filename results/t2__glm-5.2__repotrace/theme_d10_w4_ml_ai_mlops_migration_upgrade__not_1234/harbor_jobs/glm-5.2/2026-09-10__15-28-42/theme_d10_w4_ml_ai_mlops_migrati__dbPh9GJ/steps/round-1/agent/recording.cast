[13343.792746, "o", "return nil, fmt.Errorf(\"unsupported model format version: %d\", ver)\r\n    84\t\t}\r\n    85\t\r\n    86\t\tweights := make([]float64, nf*no)\r\n    87\t\tfor i := range weights {\r\n    88\t\t\tif err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {\r\n"]
[13343.792855, "o", "    89\t\t\t\treturn nil, fmt.Errorf(\"failed to read weight[%d]: %v\", i, err)\r\n    90\t\t\t}\r\n    91\t\t}\r\n    92\t\r\n    93\t\tbias := make([]float64, no)\r\n    94\t\tfor i := range bias {\r\n    95\t\t\tif err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {\r\n    96\t\t\t\treturn nil, fmt.Errorf(\"failed to read bias[%d]: %v\", i, err)\r\n    97\t\t\t}\r\n    98\t\t}\r\n    99\t\r\n   100\t\treturn &WeightsData{\r\n   101\t\t\tVersion:     ver,\r\n   102\t\t\tNumFeatures: nf,\r\n   103\t\t\tNumOutputs:  no,\r\n   104\t\t\tActivation:  act,\r\n   105\t\t\tWeights:     weights,\r\n"]
[13343.792919, "o", "   106\t\t\tBias:        bias,\r\n   107\t\t}, nil\r\n   108\t}\r\n   109\t\r\n   110\tfunc writeWeights(path string, w *WeightsData) error {\r\n   111\t\tf, err := os.Create(path)\r\n   112\t\tif err != nil {\r\n   113\t\t\treturn err\r\n   114\t\t}\r\n   115\t\tdefer f.Close()\r\n   116\t\r\n   117\t\tif _, err := f.Write(modelMagic); err != nil {\r\n"]
[13343.792984, "o", "   118\t\t\treturn err\r\n   119\t\t}\r\n   120\t\tif err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {\r\n   121\t\t\treturn err\r\n   122\t\t}\r\n   123\t\tif err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {\r\n   124\t\t\treturn err\r\n   125\t\t}\r\n   126\t\tif err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {\r\n   127\t\t\treturn err\r\n   128"]
[13343.793047, "o", "\t\t}\r\n   129\t\tif w.Version >= 2 {\r\n   130\t\t\tif err := binary.Write(f, binary.LittleEndian, w.Activation); err != nil {\r\n   131\t\t\t\treturn err\r\n   132\t\t\t}"]
[13343.793106, "o", "\r\n   133\t\t}\r\n   134\t\tfor _, v := range w.Weights {\r\n   135\t\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n   136\t\t\t\treturn err\r\n   137\t\t\t}\r\n   138\t\t}\r\n   139\t\tfor _, v := range w.Bias {\r\n   140\t\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n   141\t\t\t\treturn err\r\n"]
[13343.793165, "o", "   142\t\t\t}\r\n   143\t\t}\r\n   144\t\treturn nil\r\n   145\t}\r\n   146\t\r\n   147\tconst (\r\n   148\t\tactivationNone    = 0\r\n   149\t\tactivationSigmoid = 1\r\n   150\t\tactivationReLU    = 2\r\n"]
