[3268.295574, "o", "   187\t\t\treturn 1.0 / (1.0 + math.Exp(-x))\r\n   188\t\tcase activationReLU:\r\n   189\t\t\tif x < 0 {\r\n   190\t\t\t\treturn 0\r\n   191\t\t\t}\r\n   192\t\t\treturn x\r\n   193\t\tcase activationTanh:\r\n   194\t"]
[3268.295648, "o", "\t\treturn math.Tanh(x)\r\n   195\t\tdefault:\r\n   196\t\t\treturn x\r\n   197\t\t}\r\n   198\t}\r\n   199\t\r\n   200\tfunc saveModelMeta(modelDir string, meta map[string]string) error {\r\n   201\t\tf, err := os.Create(filepath.Join(modelDir, \"model.meta\"))\r\n   202\t\tif err != nil {\r\n   203\t\t\treturn err\r\n   204\t\t}\r\n   205\t\tdefer f.Close()\r\n   206\t\r\n   207\t\tkeys := make([]string, 0, len(meta))\r\n   208\t\tfor k := range meta {\r\n   209\t\t\tkeys = append(keys, k)\r\n   210\t\t}\r\n   211\t\tsort.Strings(keys)\r\n   212\t\t"]
[3268.295722, "o", "for _, k := range keys {\r\n   213\t\t\tfmt.Fprintf(f, \"%s=%s\\n\", k, meta[k])\r\n   214\t\t}\r\n   215\t\treturn nil\r\n   216\t}\r\n   217\t\r\n   218\ttype PipelineConfig struct {\r\n   219\t\tNormalize       bool\r\n   220\t\tScaleMin        float64\r\n   221\t\tScaleMax        float64\r\n   222\t"]
[3268.295812, "o", "\tMissingStrategy string\r\n   223\t\tRoundDigits     int\r\n   224\t\tClipMin         float64\r\n   225\t\tClipMax         float64\r\n   226\t}\r\n   227\t\r\n   228\tfunc loadPipelineConfig(modelDir string) (*PipelineConfig, error) {\r\n   229\t\tf, err := os.Open(filepath.Join(modelDir, \"pipeline.cfg\"))\r\n   230\t\tif err != nil {\r\n   231\t\t"]
[3268.295881, "o", "\treturn nil, err\r\n   232\t\t}\r\n   233\t\tdefer f.Close()\r\n   234\t\r\n   235\t\tcfg := &PipelineConfig{\r\n   236\t\t\tScaleMin:        0.0,\r\n   237\t\t\tScaleMax:        1.0,\r\n   238\t\t\tMissingStrategy: \"zero\",\r\n   239\t\t\tRoundDigits:     4,\r\n   240\t\t\tClipMin:         -1000.0,\r\n   241\t\t\tClipMax:         1000.0,\r\n   242\t\t}\r\n"]
[3268.295949, "o", "   243\t\r\n   244\t\tscanner := bufio.NewScanner(f)\r\n   245\t\tsection := \"\"\r\n   246\t\tfor scanner.Scan() {\r\n   247\t\t\tline := strings.TrimSpace(scanner.Text())\r\n   248\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n   249\t\t\t\tcontinue\r\n   250\t\t\t}\r\n   251\t\t\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\r\n"]
[3268.296019, "o", "   252\t\t\t\tsection = line[1 : len(line)-1]\r\n   253\t\t\t\tcontinue\r\n   254\t\t\t}\r\n   255\t\t\tparts := strings.SplitN(line, \"=\", 2)\r\n   256\t\t\tif len(parts) != 2 {\r\n   257\t\t\t\tcontinue\r\n   258\t\t\t}\r\n   259\t\t\tkey := strings.TrimSpace(parts[0])\r\n   260\t\t\tval := strings.TrimSpace(parts[1])\r\n   261\t\r\n   262\t\t\t"]
[3268.296091, "o", "switch section {\r\n   263\t\t\tcase \"preprocess\":\r\n   264\t\t\t\tswitch key {\r\n   265\t\t\t\tcase \"normalize\":\r\n   266\t\t\t\t\tcfg.Normalize = val == \"true\"\r\n   267\t\t\t\tcase \"scale_range\":\r\n   268\t\t\t\t\trangeParts := strings.Split(val, \",\")\r\n   269\t\t\t\t\tif len(rangeParts) == 2 {\r\n   270\t\t\t\t\t\tcfg.ScaleMin, _ = strconv.ParseFloat(rangeParts[0], 64)\r\n   271\t\t\t\t\t"]
[3268.296158, "o", "\tcfg.ScaleMax, _ = strconv.ParseFloat(rangeParts[1], 64)\r\n   272\t\t\t\t\t}\r\n   273\t\t\t\tcase \"missing_strategy\":\r\n   274\t\t\t\t\tcfg.MissingStrategy = val\r\n   275\t\t\t\t}\r\n   276\t\t\tcase \"postprocess\":\r\n   277\t\t\t\tswitch key {\r\n   278\t\t\t\tcase \"round_digits\":\r\n   279\t\t\t\t\tcfg.RoundDigits, _ = strconv.Atoi(val)\r\n   280\t\t\t\tcase \"clip_min\":\r\n"]
[3268.296222, "o", "   281\t\t\t\t\tcfg.ClipMin, _ = strconv.ParseFloat(val, 64)\r\n   282\t\t\t\tcase \"clip_max\":\r\n   283\t\t\t\t\tcfg.ClipMax, _ = strconv.ParseFloat(val, 64)\r\n   284\t\t\t\t}\r\n   285\t\t\t}\r\n   286\t\t}\r\n   287\t\treturn cfg, scanner.Err()\r\n   288\t}\r\n"]
[3268.296292, "o", "   289\t\r\n   290\tfunc roundToDigits(val float64, digits int) float64 {\r\n   291\t\tpow := math.Pow(10, float64(digits))\r\n   292\t\treturn math.Round(val*pow) / pow\r\n   293\t}\r\n"]
