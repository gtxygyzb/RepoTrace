[289.114747, "o", "   128\tfunc runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n   129\t\tprocessed := preprocess(inputs, cfg)\r\n   130\t\r\n   131\t\tresults := make([][]float64, len(processed))\r\n"]
[289.114832, "o", "   132\t\tfor i, row := range processed {\r\n   133\t\t\toutput := make([]float64, weights.NumOutputs)\r\n   134\t\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n   135\t\t\t\tsum := weights.Bias[o]\r\n   136\t\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n   137\t\t\t\t\tif int(f) < len(row) {\r\n"]
[289.114896, "o", "   138\t\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n   139\t\t\t\t\t}\r\n   140\t\t\t\t}\r\n   141\t\t\t\toutput[o] = sum\r\n   142\t\t\t}\r\n   143\t\t\tresults[i] = output\r\n"]
[289.114952, "o", "   144\t\t}\r\n   145\t\r\n   146\t\treturn postprocess(results, cfg)\r\n   147\t}\r\n   148\t\r\n   149\tfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   150\t\tresult := make([][]float64, len(inputs))\r\n"]
[289.115012, "o", "   151\t\tfor i, row := range inputs {\r\n   152\t\t\tresult[i] = make([]float64, len(row))\r\n   153\t\t\tcopy(result[i], row)\r\n   154\t\t}\r\n   155\t\r\n   156\t\tfor i, row := range result {\r\n"]
[289.115068, "o", "   157\t\t\tfor j, val := range row {\r\n   158\t\t\t\tif math.IsNaN(val) {\r\n   159\t\t\t\t\tswitch cfg.MissingStrategy {\r\n   160\t\t\t\t\tcase \"zero\":\r\n   161\t\t\t\t\t\tresult[i][j] = 0.0\r\n"]
[289.115123, "o", "   162\t\t\t\t\tcase \"mean\":\r\n   163\t\t\t\t\t\tresult[i][j] = computeColumnMean(inputs, j)\r\n   164\t\t\t\t\t}\r\n   165\t\t\t\t}\r\n   166\t\t\t}\r\n"]
[289.115178, "o", "   167\t\t}\r\n   168\t\r\n   169\t\tif cfg.Normalize {\r\n   170\t\t\tfor j := 0; j < len(result[0]); j++ {\r\n   171\t\t\t\tminVal, maxVal := columnMinMax(result, j)\r\n   172\t\t\t\trangeVal := maxVal - minVal\r\n"]
[289.115245, "o", "   173\t\t\t\tif rangeVal == 0 {\r\n   174\t\t\t\t\trangeVal = 1.0\r\n   175\t\t\t\t}\r\n   176\t\t\t\tfor i := range result {\r\n   177\t\t\t\t\t// BUG: normalization formula incorrect - should map to [ScaleMin, ScaleMax]\r\n   178\t\t\t\t\t// but uses wrong formula that doesn't properly apply the target range\r\n"]
[289.115314, "o", "   179\t\t\t\t\tnormalized := (result[i][j] - minVal) / rangeVal\r\n   180\t\t\t\t\tresult[i][j] = normalized * cfg.ScaleMax\r\n   181\t\t\t\t}\r\n   182\t\t\t}\r\n   183\t\t}\r\n   184\t\r\n   185\t\treturn result\r\n   186\t}\r\n   187\t\r\n   188\tfunc postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   189\t"]
[289.115375, "o", "\tfor i, row := range results {\r\n   190\t\t\tfor j, val := range row {\r\n   191\t\t\t\tval = math.Max(val, cfg.ClipMin)\r\n   192\t\t\t\tval = math.Min(val, cfg.ClipMax)\r\n   193\t\t\t\tresults[i][j] = roundToDigits(val, cfg.RoundDigits)\r\n   194\t\t\t}\r\n   195\t\t}\r\n   196\t\treturn results\r\n   197\t}\r\n"]
[289.115436, "o", "   198\t\r\n   199\tfunc computeColumnMean(data [][]float64, col int) float64 {\r\n   200\t\tsum := 0.0\r\n   201\t\tcount := 0\r\n   202\t\tfor _, row := range data {\r\n   203\t\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n   204\t\t\t\tsum += row[col]\r\n"]
[289.115497, "o", "   205\t\t\t\tcount++\r\n   206\t\t\t}\r\n   207\t\t}\r\n   208\t\tif count == 0 {\r\n   209\t\t\treturn 0.0\r\n   210\t\t}\r\n   211\t\treturn sum / float64(count)\r\n   212\t}\r\n   213\t\r\n   214\tfunc columnMinMax(data [][]float64, col int) (float64, float64) {\r\n"]
[289.115556, "o", "   215\t\tminVal := math.Inf(1)\r\n   216\t\tmaxVal := math.Inf(-1)\r\n   217\t\tfor _, row := range data {\r\n   218\t\t\tif col < len(row) {\r\n   219\t\t\t\tif row[col] < minVal {\r\n   220\t\t\t\t\tminVal = row[col]\r\n"]
