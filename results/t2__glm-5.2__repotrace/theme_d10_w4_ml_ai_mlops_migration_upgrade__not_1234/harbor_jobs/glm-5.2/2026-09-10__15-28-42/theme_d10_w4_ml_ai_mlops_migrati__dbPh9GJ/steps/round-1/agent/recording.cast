[3209.539772, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n"]
[3209.539855, "o", ")\r\n\r\nconst version = \"0.1.0\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcommand := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\t"]
[3209.53991, "o", "switch command {\r\n\tcase \"list\":\r\n\t\tcmdList(args)\r\n\tcase \"info\":\r\n\t\tcmdInfo(args)\r\n\tcase \"register\":\r\n\t\tcmdRegister(args)\r\n\tcase \"remove\":\r\n\t\tcmdRemove(args)\r\n\tcase \"run\":\r\n"]
[3209.540002, "o", "\t\tcmdRun(args)\r\n\tcase \"stats\":\r\n\t\tcmdStats(args)\r\n\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n\tcase \"batch\":\r\n\t\tcmdBatch(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"export\":\r\n\t\tcmdExport(args)\r\n\tcase \"migrate\":\r\n\t\tcmdMigrate(args)\r\n\tcase \"compat\":\r\n"]
[3209.54007, "o", "\t\tcmdCompat(args)\r\n\tcase \"version\":\r\n\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n\tcase \"help\":\r\n\t\tprintUsage()\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[3209.540135, "o", "}\r\n\r\nfunc printUsage() {\r\n\tusage := `mlpipe - ML Inference Pipeline Manager\r\n\r\nUsage: mlpipe <command> [arguments]\r\n\r\nCommands:\r\n  list                          List all registered models\r\n  info <model>                  Show model details\r\n  register <name> <path>        Register a model from directory\r\n  remove <name>                 Remove a model from registry\r\n  run <model> [options]         Run inference\r\n  stats --input <file>          Input statistics profiling\r\n  diff <model1> <model2> --input <file>\r\n"]
[3209.540199, "o", "                                Compare two models on same input\r\n  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n                                Batch inference over CSV files\r\n  validate <model>              Validate model integrity\r\n  export <model> --output <dir> Export model to directory\r\n"]
[3209.540267, "o", "  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n  compat [--all]                 Check migration compatibility\r\n  version                       Show version\r\n  help                          Show this help\r\n\r\nRun/Diff Options:\r\n  --input <file>    Input CSV file (required)\r\n  --output <file>   Output file (default: stdout)\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n\r\nBatch Options:\r\n  --dir <dir>       Input directory of CSV files\r\n  --output-dir <dir> Output directory for predictions\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n`\r\n\tfmt.Print(usage)\r\n}\r\n\r\nfunc parseFlags(args []string) map[string]string {\r\n\tflags := make(map[string]string)\r\n"]
[3209.540329, "o", "\tfor i := 0; i < len(args); i++ {\r\n\t\tif strings.HasPrefix(args[i], \"--\") {\r\n\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n\t\t\t\tflags[key] = args[i+1]\r\n\t\t\t\ti++\r\n\t\t\t} else {\r\n\t\t\t\tflags[key] = \"true\"\r\n"]
[3209.540388, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn flags\r\n}\r\n"]
[3209.540871, "o", "\u001b[?2004h"]
[3209.540932, "o", "root@n30009:/app# "]
[3209.805105, "i", "sed -n '1,260p' commands.go\n"]
[3209.80535, "o", "sed -n '1,260p' commands.go\r\n\u001b[?2004l\r"]
[3209.808446, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t"]
[3209.808526, "o", "\"path/filepath\"\r\n)\r\n\r\nfunc cmdValidate(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe validate <model>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentry := findEntry(entries, name)\r\n"]
[3209.808598, "o", "\tif entry == nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif !modelDirExists(entry.Path) {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model directory not found\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\terrors := validateModel(entry.Path)\r\n\tif len(errors) == 0 {\r\n"]
[3209.808637, "o", "\t\tfmt.Printf(\"Model '%s' is valid.\\n\", name)\r\n\t} else {\r\n\t\tfmt.Printf(\"Model '%s' has %d validation error(s):\\n\", name, len(errors))\r\n\t\tfor i, e := range errors {\r\n\t\t\tfmt.Printf(\"  %d. %s\\n\", i+1, e)\r\n"]
[3209.808722, "o", "\t\t}\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\n"]
[3209.808789, "o", "func validateModel(modelDir string) []string {\r\n\tvar errors []string\r\n\r\n\tmetaPath := filepath.Join(modelDir, \"model.meta\")\r\n\tif _, err := os.Stat(metaPath); err != nil {\r\n\t\terrors = append(errors, \"missing model.meta\")\r\n\t} else {\r\n\t\tmeta, err := loadModelMeta(modelDir)\r\n\t\tif err != nil {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse model.meta: %v\", err))\r\n\t\t} else {\r\n\t\t\tif meta[\"name\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'name' field\")\r\n\t\t\t}\r\n\t\t\tif meta[\"type\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'type' field\")\r\n\t\t\t}\r\n\t"]
[3209.808898, "o", "\t\tif meta[\"features\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'features' field\")\r\n\t\t\t}\r\n\t\t\tif meta[\"outputs\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'outputs' field\")\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tweightsPath := filepath.Join(modelDir, \"weights.bin\")\r\n"]
[3209.808965, "o", "\tif _, err := os.Stat(weightsPath); err != nil {\r\n\t\terrors = append(errors, \"missing weights.bin\")\r\n\t} else {\r\n\t\t_, err := loadWeights(modelDir)\r\n\t\tif err != nil {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse weights.bin: %v\", err))\r\n\t\t}\r\n\t}\r\n\r\n\tcfgPath := filepath.Join(modelDir, \"pipeline.cfg\")\r\n\tif _, err := os.Stat(cfgPath); err != nil {\r\n\t\terrors = append(errors, \"missing pipeline.cfg\")\r\n\t} else {\r\n\t\t_, err := loadPipelineConfig(modelDir)\r\n\t\tif err != nil {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse pipeline.cfg: %v\", err))\r\n\t\t}\r\n"]
[3209.809026, "o", "\t}\r\n\r\n\treturn errors\r\n}\r\n\r\nfunc cmdExport(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe export <model> --output <dir>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[3209.809091, "o", "\tname := args[0]\r\n\tflags := parseFlags(args[1:])\r\n\r\n\toutputDir := flags[\"output\"]\r\n\tif outputDir == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: --output is required\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)"]
[3209.809152, "o", "\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif err := os.MkdirAll(outputDir, 0755); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t"]
[3209.809216, "o", "\tos.Exit(1)\r\n\t}\r\n\r\n\tfiles := []string{\"model.meta\", \"weights.bin\", \"pipeline.cfg\"}\r\n\tfor _, file := range files {\r\n\t\t"]
[3209.809278, "o", "src := filepath.Join(entry.Path, file)\r\n\t\tdst := filepath.Join(outputDir, file)\r\n\t\tdata, err := os.ReadFile(src)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error reading %s: %v\\n\", file, err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tif err := os.WriteFile(dst, data, 0644); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error writing %s: %v\\n\", file, err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\tfmt.Printf(\"Model '%s' exported to %s\\n\", name, outputDir)\r\n}"]
[3209.809334, "o", "\r\n"]
[3209.809782, "o", "\u001b[?2004h"]
