[1848.229239, "o", "\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\treader := csv.NewReader(f)\r\n\trecords, err := reader.ReadAll()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tvar data [][]float64\r\n\tfor i, record := range records {"]
