[11325.569289, "o", "    17\t\tif err != nil {\r\n    18\t\t\treturn 0\r\n    19\t\t}\r\n    20\t\tcount := 0\r\n    21\t\tfor _, entry := range entries {\r\n    22\t\t\tif entry.IsDir() {\r\n    23\t\t\t\tcount++\r\n    24\t\t\t}\r\n    25\t\t}\r\n    26\t\treturn count\r\n    27\t}\r\n    28\t\r\n    29\tfunc cmdCheckpoint(args []string) {\r\n    30\t\tif len(args) < 1 {\r\n    31\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe checkpoint <model> [--name <name>]\\n\")\r\n    32\t\t\tos.Exit(1)\r\n    33\t\t}\r\n    34\t\tmodel := args[0]\r\n    35\t"]
