[3451.601669, "o", "func modelDirExists(path string) bool {\r\n\tinfo, err := os.Stat(path)\r\n\treturn err == nil && info.IsDir()\r\n}\r\n\r\n"]
[3451.601752, "o", "func resolveModel(name string) (*RegistryEntry, error) {\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {\r\n\t\treturn nil, fmt.Errorf(\"model '%s' not found\", name)\r\n\t}\r\n\tif !modelDirExists(entry.Path) {\r\n\t\treturn nil, fmt.Errorf(\"model directory not found\")\r\n\t}\r\n\treturn entry, nil\r\n}"]
[3451.601877, "o", "\r\n\r\nfunc loadModelArtifacts(modelDir string) (*WeightsData, *PipelineConfig, error) {\r\n\tweights, err := loadWeights(modelDir)\r\n\tif err != nil {\r\n\t\treturn nil, nil, err\r\n\t}\r\n\tcfg, err := loadPipelineConfig(modelDir)\r\n\tif err != nil {\r\n\t\treturn nil, nil, err\r\n\t}\r\n\treturn weights, cfg, nil\r\n}\r\n\r\n"]
