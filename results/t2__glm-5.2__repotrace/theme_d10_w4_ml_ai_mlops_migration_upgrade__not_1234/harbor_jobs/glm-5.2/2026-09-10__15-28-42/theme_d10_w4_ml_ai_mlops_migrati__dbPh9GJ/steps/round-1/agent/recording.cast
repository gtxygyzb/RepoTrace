[1928.543841, "o", "\tfor _, rec := range records {\r\n   102\t\t\tif len(rec) > numCols {\r\n   103\t\t\t\tnumCols = len(rec)\r\n   104\t\t\t}\r\n   105\t\t}\r\n   106\t\r\n   107\t\theaders := make([]string, numCols)\r\n"]
