[2674.303355, "o", "   200\tfunc saveModelMeta(modelDir string, meta map[string]string) error {\r\n   201\t\tf, err := os.Create(filepath.Join(modelDir, \"model.meta\"))\r\n   202\t\tif err != nil {\r\n   203\t\t\treturn err\r\n   204\t\t}\r\n   205\t\tdefer f.Close()\r\n   206\t\r\n"]
[2674.30347, "o", "   207\t\tkeys := make([]string, 0, len(meta))\r\n   208\t\tfor k := range meta {\r\n   209\t\t\tkeys = append(keys, k)\r\n   210\t\t}\r\n   211\t\tsort.Strings(keys)\r\n   212\t\tfor _, k := range keys {\r\n   213\t\t\tfmt.Fprintf(f, \"%s=%s\\\\n\", k, meta[k])\r\n   214\t\t}\r\n   215\t\treturn nil\r\n   216\t}\r\n   217\t\r\n   218\ttype PipelineConfig struct {\r\n   219\t\tNormalize       bool\r\n   220\t\tScaleMin        float64\r\n"]
[2674.304027, "o", "\u001b[?2004h"]
[2674.304108, "o", "root@n30009:/app# "]
