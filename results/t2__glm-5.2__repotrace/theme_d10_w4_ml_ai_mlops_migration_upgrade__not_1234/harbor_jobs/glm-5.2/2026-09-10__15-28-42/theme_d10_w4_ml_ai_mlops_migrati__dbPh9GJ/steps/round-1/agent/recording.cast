[380.27679, "i", "sed -n '211,280p' inference.go\n"]
[380.277111, "o", "sed -n '211,280p' inference.go\r\n\u001b[?2004l\r"]
[380.280065, "o", "\treturn sum / float64(count)\r\n}\r\n\r\nfunc columnMinMax(data [][]float64, col int) (float64, float64) {\r\n\tminVal := math.Inf(1)\r\n\tmaxVal := math.Inf(-1)\r\n"]
[380.280181, "o", "\tfor _, row := range data {\r\n\t\tif col < len(row) {\r\n\t\t\tif row[col] < minVal {\r\n\t\t\t\tminVal = row[col]\r\n\t\t\t}\r\n\t\t\tif row[col] > maxVal {\r\n"]
[380.280289, "o", "\t\t\t\tmaxVal = row[col]\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn minVal, maxVal\r\n}\r\n\r\nfunc writeOutput(f *os.File, results [][]float64, format string) {\r\n\tswitch format {\r\n\tcase \"csv\":\r\n\t\twriter := csv.NewWriter(f)\r\n\t\theader := make([]string, len(results[0]))\r\n\t\tfor i := range header {\r\n\t\t\theader[i] = fmt.Sprintf(\"output_%d\", i)\r\n\t\t}\r\n\t\twriter.Write(header)\r\n\t\tfor _, row := range results {\r\n\t\t\trecord := make([]string, len(row))\r\n\t\t\tfor j, val := range row {\r\n\t\t\t\trecord[j] = strconv.FormatFloat(val, 'f', -1, 64)\r\n\t\t\t}\r\n\t\t\twriter.Write(record)\r\n\t\t}\r\n\t\twriter.Flush()\r\n\tcase \"json\":\r\n\t\ttype Prediction struct {\r\n\t\t\tOutputs []float64 `json:\"outputs\"`\r\n"]
[380.280395, "o", "\t\t}\r\n\t\ttype Result struct {\r\n\t\t\tPredictions []Prediction `json:\"predictions\"`\r\n\t\t}\r\n\t\tr := Result{}\r\n"]
[380.280511, "o", "\t\tfor _, row := range results {\r\n\t\t\tr.Predictions = append(r.Predictions, Prediction{Outputs: row})\r\n\t\t}\r\n\t\tenc := json.NewEncoder(f)\r\n\t\tenc.SetIndent(\"\", \"  \")\r\n\t\tenc.Encode(r)\r\n\t}\r\n}\r\n"]
[380.28088, "o", "\u001b[?2004h"]
