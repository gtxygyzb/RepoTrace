[3299.28709, "o", "\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype PipelineConfig\u001b[m\u001b[K struct {\r\n\u001b[32m\u001b[K219\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tNormalize       bool\r\n\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tScaleMin        float64\r\n\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tScaleMax        float64\r\n"]
[3299.28719, "o", "\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tMissingStrategy string\r\n\u001b[32m\u001b[K223\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRoundDigits     int\r\n\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tClipMin         float64\r\n\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tClipMax         float64\r\n\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc loadPipelineConfig(modelDir string) (*PipelineConfig, error) {\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tf, err := os.Open(filepath.Join(modelDir, \"pipeline.cfg\"))\r\n"]
[3299.287267, "o", "\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn nil, err\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer f.Close()\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcfg := &PipelineConfig{\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tScaleMin:        0.0,\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tScaleMax:        1.0,\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tMissingStrategy: \"zero\",\r\n\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tRoundDigits:     4,\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tClipMin:         -1000.0,\r\n\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[3299.287346, "o", "\t\tClipMax:         1000.0,\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tscanner := bufio.NewScanner(f)\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tsection := \"\"\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor scanner.Scan() {\r\n\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tline := strings.TrimSpace(scanner.Text())\r\n\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tcontinue\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsection = line[1 : len(line)-1]\r\n"]
[3299.28738, "o", "\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tcontinue\r\n"]
