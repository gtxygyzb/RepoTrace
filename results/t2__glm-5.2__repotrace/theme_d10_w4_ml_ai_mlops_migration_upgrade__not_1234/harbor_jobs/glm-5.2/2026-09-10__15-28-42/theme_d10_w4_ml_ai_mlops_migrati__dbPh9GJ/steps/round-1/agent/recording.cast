[7482.115095, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/csv\"\r\n\t\"fmt\"\r\n"]
[7482.115196, "o", "\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc modelDirExists(path string) bool {\r\n\t"]
[7482.115267, "o", "info, err := os.Stat(path)\r\n\treturn err == nil && info.IsDir()\r\n}\r\n\r\nfunc resolveModel(name string) (*RegistryEntry, error) {\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil || !modelDirExists(entry.Path) {\r\n\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\treturn entry, nil\r\n}\r\n\r\nfunc loadModelArtifacts(modelDir string) (*WeightsData, *PipelineConfig, error) {\r\n\tweights, err := loadWeights(modelDir)\r\n"]
[7482.115342, "o", "\tif err != nil {\r\n\t\treturn nil, nil, err\r\n\t}\r\n\tcfg, err := loadPipelineConfig(modelDir)\r\n\tif err != nil {\r\n\t\treturn nil, nil, err\r\n"]
[7482.115407, "o", "\t}\r\n\treturn weights, cfg, nil\r\n}\r\n\r\nfunc validateFeatureCount(inputs [][]float64, expected int) error {\r\n\tfor i, row := range inputs {\r\n\t\tif len(row) != expected {\r\n\t\t\treturn fmt.Errorf(\"expected %d features, got %d in row %d\", expected, len(row), i)\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc readCSVRaw(path string) ([][]string, error) {\r\n\tf, err := os.Open(path)\r\n\tif err != nil {\r\n"]
[7482.115469, "o", "\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\treader := csv.NewReader(f)\r\n\treader.FieldsPerRecord = -1\r\n\treturn reader.ReadAll()\r\n}\r\n\r\nfunc isMissingValue(val string) bool {\r\n\tval = strings.TrimSpace(val)\r\n\tif val == \"\" {\r\n\t\treturn true\r\n"]
[7482.115531, "o", "\t}\r\n\tlower := strings.ToLower(val)\r\n\treturn lower == \"na\" || lower == \"nan\"\r\n}\r\n\r\nfunc cmdStats(args []string) {\r\n\tflags := parseFlags(args)\r\n\tinput := flags[\"input\"]\r\n\tif input == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe stats --input <file>\\n\")\r\n\t\tos.Exit(1)\r\n"]
[7482.115592, "o", "\t}\r\n\r\n\trecords, err := readCSVRaw(input)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif len(records) == 0 {\r\n\t\tfmt.Println(\"No data found.\")\r\n\t\treturn\r\n\t"]
[7482.115657, "o", "}\r\n\r\n\thasHeader := isHeader(records[0])\r\n\tstart := 0\r\n\tif hasHeader {\r\n\t\tstart = 1\r\n"]
[7482.115719, "o", "\t}\r\n\r\n\tnumCols := 0\r\n\tfor _, rec := range records {\r\n\t\tif len(rec) > numCols {\r\n\t\t\tnumCols = len(rec)\r\n\t\t}\r\n\t}\r\n\r\n\theaders := make([]string, numCols)\r\n\tfor i := 0; i < numCols; i++ {\r\n\t\tif hasHeader && i < len(records[0]) {\r\n\t\t\theaders[i] = strings.TrimSpace(records[0][i])\r\n\t\t} else {\r\n\t\t\theaders[i] = fmt.Sprintf(\"col_%d\", i)\r\n\t\t}\r\n\t}\r\n"]
[7482.115784, "o", "\r\n\ttype colStat struct {\r\n\t\tidx     int\r\n\t\tname    string\r\n\t\tcount   int\r\n\t\tmissing int\r\n\t\tmin     float64\r\n"]
[7482.115866, "o", "\t\tmax     float64\r\n\t\tmean    float64\r\n\t\tstddev  float64\r\n\t\tvalues  []float64\r\n\t}\r\n\r\n\tvar stats []colStat\r\n\tnumericCols := make([]int, 0)\r\n\tvaluesByCol := make(map[int][]float64)\r\n\tvar skippedCols []string\r\n\r\n\tfor j := 0; j < numCols; j++ {\r\n\t\tvalues := make([]float64, 0, len(records)-start)\r\n\t\tmissing := 0\r\n\t\tnumeric := true\r\n\r\n\t\tfor i := start; i < len(records); i++ {\r\n\t\t\traw := \"\"\r\n\t\t\t"]
[7482.115926, "o", "if j < len(records[i]) {\r\n\t\t\t\traw = strings.TrimSpace(records[i][j])\r\n\t\t\t}\r\n\t\t\tif isMissingValue(raw) {\r\n\t\t\t\tmissing++\r\n\t\t\t\tvalues = append(values, math.NaN())\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
[7482.115987, "o", "\t\t\tv, err := strconv.ParseFloat(raw, 64)\r\n\t\t\tif err != nil {\r\n\t\t\t\tnumeric = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\t"]
[7482.11606, "o", "values = append(values, v)\r\n\t\t}\r\n\r\n\t\tif !numeric {\r\n\t\t\tskippedCols = append(skippedCols, headers[j])\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tcount := len(values) - missing\r\n\t\tst := colStat{\r\n\t\t\tidx:     j,\r\n\t\t\tname:    headers[j],\r\n\t\t\tcount:   count,\r\n\t\t\tmissing: missing,\r\n\t\t\tmin:     math.NaN(),\r\n\t\t\tmax:     math.NaN(),\r\n\t\t\tmean:    math.NaN(),\r\n\t"]
[7482.116121, "o", "\t\tstddev:  math.NaN(),\r\n\t\t\tvalues:  values,\r\n\t\t}\r\n\r\n\t\tif count > 0 {\r\n\t\t\tsum := 0.0\r\n\t\t\tsumSq := 0.0\r\n\t\t\tminVal := math.Inf(1)\r\n\t\t\tmaxVal := math.Inf(-1)\r\n\t\t\tfor _, v := range values {\r\n"]
[7482.116176, "o", "\t\t\t\tif math.IsNaN(v) {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tif v < minVal {\r\n\t\t\t\t\tminVal = v\r\n\t\t\t\t}\r\n\t\t\t\tif v > maxVal {\r\n\t\t\t\t\tmaxVal = v\r\n"]
[7482.116237, "o", "\t\t\t\t}\r\n\t\t\t\tsum += v\r\n\t\t\t\tsumSq += v * v\r\n\t\t\t}\r\n\t\t\tmean := sum / float64(count)\r\n\t\t\tvariance := sumSq/float64(count) - mean*mean\r\n\t\t\tif variance < 0 {\r\n\t\t\t\tvariance = 0\r\n\t\t\t}\r\n\t"]
[7482.116304, "o", "\t\tst.min = minVal\r\n\t\t\tst.max = maxVal\r\n\t\t\tst.mean = mean\r\n\t\t\tst.stddev = math.Sqrt(variance)\r\n\t\t}\r\n\r\n\t\tstats = append(stats, st)\r\n\t\tnumericCols = append(numericCols, j)\r\n\t\tvaluesByCol[j] = values\r\n\t}\r\n\r\n"]
[7482.116361, "o", "\tif len(skippedCols) > 0 {\r\n\t\tfmt.Printf(\"warning: skipping non-numeric columns: %s\\n\", strings.Join(skippedCols, \", \"))\r\n\t}\r\n\tif len(numericCols) == 0 {\r\n\t\tfmt.Println(\"error: no numeric columns found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfmt.Println(\"Per-column statistics:\")\r\n\tfmt.Printf(\"%-20s %6s %7s %12s %12s %12s %12s\\n\", \"column\", \"count\", \"missing\", \"min\", \"max\", \"mean\", \"stddev\")\r\n"]
[7482.116424, "o", "\tfor _, st := range stats {\r\n\t\tfmt.Printf(\"%-20s %6d %7d %12.4f %12.4f %12.4f %12.4f\\n\", st.name, st.count, st.missing, st.min, st.max, st.mean, st.stddev)\r\n\t}\r\n\r\n\tfmt.Println(\"\\nPearson correlation matrix:\")\r\n"]
