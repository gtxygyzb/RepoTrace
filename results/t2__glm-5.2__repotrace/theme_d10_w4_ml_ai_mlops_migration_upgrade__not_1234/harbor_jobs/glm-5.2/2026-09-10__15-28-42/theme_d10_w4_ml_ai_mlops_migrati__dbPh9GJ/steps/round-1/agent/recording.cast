[7555.221872, "o", "     9\tconst version = \"0.1.0\"\r\n    10\t\r\n    11\tfunc main() {\r\n    12\t\tif len(os.Args) < 2 {\r\n    13\t\t\tprintUsage()\r\n    14\t\t\tos.Exit(1)\r\n    15\t\t}\r\n    16\t\r\n    17\t\tcommand := os.Args[1]\r\n    18\t\targs := os.Args[2:]\r\n    19\t\r\n    20\t\tswitch command {\r\n    21\t\tcase \"list\":\r\n    22\t\t\tcmdList(args)\r\n    23\t\tcase \"info\":\r\n    24\t\t\tcmdInfo(args)\r\n    25\t\tcase \"register\":\r\n    26\t\t\tcmdRegister(args)\r\n    27\t\tcase \"remove\":\r\n    28\t\t\tcmdRemove(args)\r\n    29\t\tcase \"tag\":\r\n    30\t\t\tcmdTag(args)\r\n    31\t\tcase \"untag\":\r\n    32\t\t\tcmdUntag(args)\r\n"]
[7555.221984, "o", "    33\t\tcase \"search\":\r\n    34\t\t\tcmdSearch(args)\r\n    35\t\tcase \"run\":\r\n    36\t\t\tcmdRun(args)\r\n    37\t\tcase \"stats\":\r\n    38\t\t\tcmdStats(args)\r\n    39\t\tcase \"diff\":\r\n    40\t\t\tcmdDiff(args)\r\n    41\t\tcase \"batch\":\r\n    42\t\t\tcmdBatch(args)\r\n    43\t\tcase \"profile\":\r\n    44\t\t\tcmdProfile(args)\r\n    45\t\tcase \"validate\":\r\n    46\t\t\tcmdValidate(args)\r\n"]
