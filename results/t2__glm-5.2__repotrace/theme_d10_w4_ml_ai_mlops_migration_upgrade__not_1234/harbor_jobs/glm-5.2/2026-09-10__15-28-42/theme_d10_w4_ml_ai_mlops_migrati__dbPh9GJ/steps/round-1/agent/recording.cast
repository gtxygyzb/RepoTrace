[9603.375787, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/csv\"\r\n"]
[9603.375885, "o", "     5\t\t\"fmt\"\r\n     6\t\t\"math\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t)\r\n    13\t\r\n    14\tfunc modelDirExists(path string) bool {\r\n    15\t\tinfo, err := os.Stat(path)\r\n    16\t\treturn err == nil && info.IsDir()\r\n"]
