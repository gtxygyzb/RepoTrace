[12642.196686, "o", "\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc runInference(inputs [][]float64, weights *\u001b[01;31m\u001b[KWeights\u001b[m\u001b[KData, cfg *PipelineConfig) [][]float64 {\r\n\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K139\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc runInferenceRaw(inputs [][]float64, weights *\u001b[01;31m\u001b[KWeights\u001b[m\u001b[KData, cfg *PipelineConfig) [][]float64 {\r\n\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\toutput := make([]float64, weights.Num\u001b[01;31m\u001b[KOutputs\u001b[m\u001b[K)\r\n\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor o := uint32(0); o < weights.Num\u001b[01;31m\u001b[KOutputs\u001b[m\u001b[K; o++ {\r\n\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tsum := weights.\u001b[01;31m\u001b[KBias\u001b[m\u001b[K[o]\r\n\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor f := uint32(0); f < weights.Num\u001b[01;31m\u001b[KFeatures\u001b[m\u001b[K; f++ {\r\n"]
[12642.196753, "o", "\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tsum += row[f] * weights.\u001b[01;31m\u001b[KWeights\u001b[m\u001b[K[o*weights.Num\u001b[01;31m\u001b[KFeatures\u001b[m\u001b[K+f]\r\n\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\toutput[o] = apply\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K(sum, weights.\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K)\r\n\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\trecord[j] = strconv.\u001b[01;31m\u001b[KFormat\u001b[m\u001b[KFloat(val, 'f', -1, 64)\r\n"]
[12642.197025, "o", "\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KOutputs\u001b[m\u001b[K []float64 `json:\"outputs\"`\r\n\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tr.Predictions = append(r.Predictions, Prediction{\u001b[01;31m\u001b[KOutputs\u001b[m\u001b[K: row})\r\n\u001b[35m\u001b[Kcommands_extra.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc loadModel\u001b[m\u001b[KArtifacts(modelDir string) (*\u001b[01;31m\u001b[KWeights\u001b[m\u001b[KData, *PipelineConfig, error) {\r\n\u001b[35m\u001b[Kcommands_extra.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tweights, err := load\u001b[01;31m\u001b[KWeights\u001b[m\u001b[K(modelDir)\r\n\u001b[35m\u001b[Kcommands_extra.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif w1.Num\u001b[01;31m\u001b[KFeatures\u001b[m\u001b[K != w2.Num\u001b[01;31m\u001b[KFeatures\u001b[m\u001b[K {\r\n\u001b[35m\u001b[Kcommands_extra.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"error: models have different input feature counts: %s=%d, %s=%d\\n\", model1, w1.Num\u001b[01;31m\u001b[KFeatures\u001b[m\u001b[K, model2, w2.Num\u001b[01;31m\u001b[KFeatures\u001b[m\u001b[K)\r\n\u001b["]
