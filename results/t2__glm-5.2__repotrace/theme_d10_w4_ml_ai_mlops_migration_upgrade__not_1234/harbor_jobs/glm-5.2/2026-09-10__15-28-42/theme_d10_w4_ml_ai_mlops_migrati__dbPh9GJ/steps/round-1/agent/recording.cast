[269.192765, "o", "   187\t\r\n   188\tfunc postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   189\t\tfor i, row := range results {\r\n   190\t\t\tfor j, val := range row {\r\n   191\t\t\t\tval = math.Max(val, cfg.ClipMin)\r\n   192\t\t\t\tval = math.Min(val, cfg.ClipMax)\r\n   193\t\t\t\tresults[i][j] = roundToDigits(val, cfg.RoundDigits)\r\n   194\t\t\t}\r\n   195\t\t}\r\n   196\t\treturn results\r\n   197\t}\r\n"]
[269.193058, "o", "   198\t\r\n   199\tfunc computeColumnMean(data [][]float64, col int) float64 {\r\n   200\t\tsum := 0.0\r\n   201\t\tcount := 0\r\n   202\t\tfor _, row := range data {\r\n   203\t\t\tif col < len(row) && !math.IsNaN(row[col]) {\r\n   204\t\t\t\tsum += row[col]\r\n   205\t\t\t\tcount++\r\n   206\t\t\t}\r\n   207\t\t}\r\n   208\t\tif count == 0 {\r\n   209\t\t\treturn 0.0\r\n   210\t\t}\r\n   211\t\treturn sum / float64(count)\r\n   212\t}\r\n   213\t\r\n   214\tfunc columnMinMax(data [][]float64, col int) (float64, float64) {\r\n   215\t\tminVal := math.Inf(1)\r\n   216\t\tmaxVal := math.Inf(-1)\r\n   217\t\tfor _, row := range data {\r\n   218\t\t\tif col < len(row) {\r\n   219\t\t\t\tif row[col] < minVal {\r\n   220\t\t\t\t\tminVal = row[col]\r\n   221\t\t\t\t}\r\n   222\t\t\t\tif row[col] > maxVal {\r\n   223\t\t\t\t\tmaxVal = row[col]\r\n   224\t\t\t\t}\r\n"]
[269.193148, "o", "   225\t\t\t}\r\n   226\t\t}\r\n   227\t\treturn minVal, maxVal\r\n   228\t}\r\n   229\t\r\n   230\tfunc writeOutput(f *os.File, results [][]float64, format string) {\r\n   231\t\tswitch format {\r\n   232\t\tcase \"csv\":\r\n   233\t\t\twriter := csv.NewWriter(f)\r\n   234\t\t\theader := make([]string, len(results[0]))\r\n   235\t\t\tfor i := range header {\r\n   236\t\t\t\theader[i] = fmt.Sprintf(\"output_%d\", i)\r\n   237\t\t\t}\r\n   238\t\t\twriter.Write(header)\r\n   239\t\t\tfor _, row := range results {\r\n   240\t\t\t\trecord := make([]string, len(row))\r\n   241\t\t\t\tfor j, val := range row {\r\n   242\t\t\t\t"]
[269.19322, "o", "\trecord[j] = strconv.FormatFloat(val, 'f', -1, 64)\r\n   243\t\t\t\t}\r\n   244\t\t\t\twriter.Write(record)\r\n   245\t\t\t}\r\n   246\t\t\twriter.Flush()\r\n   247\t\tcase \"json\":\r\n   248\t\t\ttype Prediction struct {\r\n   249\t\t\t\tOutputs []float64 `json:\"outputs\"`\r\n   250\t\t\t}\r\n   251\t\t\ttype Result struct {\r\n   252\t\t\t\tPredictions []Prediction `json:\"predictions\"`\r\n   253\t\t\t}\r\n   254\t\t\tr := Result{}\r\n   255\t\t\tfor _, row := range results {\r\n   256\t\t\t\tr.Predictions = append(r.Predictions, Prediction{Outputs: row})\r\n   257\t\t\t}\r\n   258\t\t\tenc := json.NewEncoder(f)\r\n"]
[269.193283, "o", "   259\t\t\tenc.SetIndent(\"\", \"  \")\r\n   260\t\t\tenc.Encode(r)\r\n   261\t\t}\r\n   262\t}\r\n"]
