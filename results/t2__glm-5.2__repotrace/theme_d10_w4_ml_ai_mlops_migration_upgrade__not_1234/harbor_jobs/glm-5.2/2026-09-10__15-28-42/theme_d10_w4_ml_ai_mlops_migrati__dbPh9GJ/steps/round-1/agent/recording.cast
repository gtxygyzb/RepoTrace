[7483.470896, "o", "\ttag := args[1]\r\n\r\n\tif !isValidTag(tag) {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid tag '%s'\\n\", tag)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[7483.470953, "o", "\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif hasTag(entry, tag) {\r\n\t\treturn\r\n\t}\r\n\r\n"]
