[5898.729555, "o", "\r\n\tif err := saveRegistry(entries); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Printf(\"Model '%s' registered successfully.\\n\", name)\r\n}\r\n\r\nfunc cmdRemove(args []string) {\r\n\tif len(args) < 1 {\r\n"]
