[7483.471079, "o", "func cmdUntag(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe untag <model> <tag>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[7483.47112, "o", "\tname := args[0]\r\n\ttag := args[1]\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n"]
[7483.4712, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tidx := -1\r\n\tfor i, t := range entry.Tags {\r\n\t\tif t == tag {\r\n\t\t\tidx = i\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif idx < 0 {\r\n\t\tfmt.Fprintln(os.Stderr, \"tag not found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentry.Tags = append(entry.Tags[:idx], entry.Tags[idx+1:]...)\r\n"]
[7483.471259, "o", "\tif entry.Tags == nil {\r\n\t\tentry.Tags = []string{}\r\n\t}\r\n\r\n\tif err := saveRegistry(entries); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\t"]
