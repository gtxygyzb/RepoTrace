[7544.16343, "o", "func loadOldRegistry() ([]RegistryEntry, error) {\r\n    62\t\tf, err := os.Open(registryFile)\r\n    63\t\tif err != nil {\r\n    64\t\t\tif os.IsNotExist(err) {\r\n    65\t\t\t\treturn nil, nil\r\n    66\t\t\t}\r\n    67\t\t\treturn nil, err\r\n    68\t\t}\r\n    69\t\tdefer f.Close()\r\n    70\t\r\n"]
