[9667.338374, "o", "\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor o := uint32(0); o < weights.\u001b[01;31m\u001b[KNumOutputs\u001b[m\u001b[K; o++ {\r\n\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor f := uint32(0); f < weights.\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K; f++ {\r\n\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K+f]\r\n"]
