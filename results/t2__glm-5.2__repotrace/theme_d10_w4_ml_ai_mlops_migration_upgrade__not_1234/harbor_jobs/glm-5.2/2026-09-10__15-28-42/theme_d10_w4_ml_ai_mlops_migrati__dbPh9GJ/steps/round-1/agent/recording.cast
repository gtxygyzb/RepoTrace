[251.709169, "o", "    94\t\tfmt.Printf(\"%-20s %-10s %-8s %s\\n\", \"NAME\", \"TYPE\", \"VERSION\", \"CREATED\")\r\n    95\t\tfor _, e := range entries {\r\n    96\t\t\tfmt.Printf(\"%-20s %-10s %-8d %s\\n\", e.Name, e.Type, e.Version, e.Created)\r\n    97\t\t}\r\n    98\t}\r\n    99\t\r\n   100\tfunc cmdInfo(args []string) {\r\n   101\t\tif len(args) < 1 {\r\n   102\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe info <model>\\n\")\r\n   103\t\t\tos.Exit(1)\r\n"]
[251.709245, "o", "   104\t\t}\r\n   105\t\tname := args[0]\r\n   106\t\tentries, err := loadRegistry()\r\n   107\t\tif err != nil {\r\n   108\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   109\t\t\tos.Exit(1)\r\n   110\t\t}\r\n   111\t\tentry := findEntry(entries, name)\r\n"]
[251.709316, "o", "   112\t\tif entry == nil {\r\n   113\t\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n   114\t\t\tos.Exit(1)\r\n   115\t\t}\r\n   116\t\r\n   117\t\tmeta, err := loadModelMeta(entry.Path)\r\n   118\t\tif err != nil {\r\n   119\t\t\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n"]
[251.709387, "o", "   120\t\t\tos.Exit(1)\r\n   121\t\t}\r\n   122\t\r\n   123\t\tfmt.Printf(\"Name:        %s\\n\", meta[\"name\"])\r\n   124\t\tfmt.Printf(\"Type:        %s\\n\", meta[\"type\"])\r\n   125\t\tfmt.Printf(\"Version:     %s\\n\", meta[\"version\"])\r\n   126\t\tfmt.Printf(\"Created:     %s\\n\", meta[\"created\"])\r\n"]
