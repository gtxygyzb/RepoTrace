[1866.423734, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/binary\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"math\"\r\n     8\t\t\"os\"\r\n"]
[1866.42387, "o", "     9\t\t\"path/filepath\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t)\r\n    13\t\r\n    14\tvar modelMagic = []byte(\"MLPW\")\r\n    15\t\r\n    16\tfunc loadModelMeta(modelDir string) (map[string]string, error) {\r\n    17\t\tf, err := os.Open(filepath.Join(modelDir, \"model.meta\"))\r\n    18\t\tif err != nil {\r\n    19\t\t\treturn nil, err\r\n    20\t\t}\r\n    21\t\tdefer f.Close()\r\n    22\t\r\n    23\t\tmeta := make(map[string]string)\r\n    24\t\tscanner := bufio.NewScanner(f)\r\n    25\t\tfor scanner.Scan() {\r\n    26\t\t\tline := strings.TrimSpace(scanner.Text())\r\n"]
[1866.423957, "o", "    27\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    28\t\t\t\tcontinue\r\n    29\t\t\t}\r\n    30\t\t\tparts := strings.SplitN(line, \"=\", 2)\r\n    31\t\t\tif len(parts) == 2 {\r\n    32\t\t\t\tmeta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])\r\n    33\t\t\t}\r\n    34\t\t}\r\n    35\t\treturn meta, scanner.Err()\r\n    36\t}\r\n"]
[1866.424068, "o", "    37\t\r\n    38\ttype WeightsData struct {\r\n    39\t\tVersion     uint32\r\n    40\t\tNumFeatures uint32\r\n    41\t\tNumOutputs  uint32\r\n    42\t\tWeights     []float64\r\n    43\t\tBias        []float64\r\n    44\t}\r\n    45\t\r\n    46\tfunc loadWeights(modelDir string) (*WeightsData, error) {\r\n    47\t\tf, err := os.Open(filepath.Join(modelDir, \"weights.bin\"))\r\n    48\t\tif err != nil {\r\n    49\t\t\treturn nil, err\r\n    50\t\t}\r\n    51\t\tdefer f.Close()\r\n"]
[1866.42413, "o", "    52\t\r\n    53\t\tmagic := make([]byte, 4)\r\n    54\t\tif _, err := f.Read(magic); err != nil {\r\n    55\t\t\treturn nil, fmt.Errorf(\"failed to read magic: %v\", err)\r\n    56\t\t}\r\n    57\t\tif string(magic) != string(modelMagic) {\r\n    58\t\t\treturn nil, fmt.Errorf(\"invalid model file: bad magic\")\r\n    59\t\t}\r\n    60\t\r\n"]
[1866.424191, "o", "    61\t\tvar ver, nf, no uint32\r\n    62\t\tif err := binary.Read(f, binary.LittleEndian, &ver); err != nil {\r\n    63\t\t\treturn nil, fmt.Errorf(\"failed to read version: %v\", err)\r\n    64\t\t}\r\n    65\t\tif err := binary.Read(f, binary.LittleEndian, &nf); err != nil {\r\n    66\t\t\treturn nil, fmt.Errorf(\"failed to read num_features: %v\", err)\r\n    67\t\t}\r\n"]
[1866.424254, "o", "    68\t\t// num_outputs is LittleEndian\r\n    69\t\tif err := binary.Read(f, binary.LittleEndian, &no); err != nil {\r\n    70\t\t\treturn nil, fmt.Errorf(\"failed to read num_outputs: %v\", err)\r\n    71\t\t}\r\n    72\t\r\n    73\t\tweights := make([]float64, nf*no)\r\n    74\t\tfor i := range weights {\r\n    75\t\t\tif err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {\r\n    76\t\t\t\t"]
[1866.424321, "o", "return nil, fmt.Errorf(\"failed to read weight[%d]: %v\", i, err)\r\n    77\t\t\t}\r\n    78\t\t}\r\n    79\t\r\n    80\t\tbias := make([]float64, no)\r\n    81\t\tfor i := range bias {\r\n    82\t\t\tif err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {\r\n    83\t\t\t\treturn nil, fmt.Errorf(\"failed to read bias[%d]: %v\", i, err)\r\n    84\t\t\t}\r\n    85\t\t}\r\n"]
[1866.424377, "o", "    86\t\r\n    87\t\treturn &WeightsData{\r\n    88\t\t\tVersion:     ver,\r\n    89\t\t\tNumFeatures: nf,\r\n    90\t\t\tNumOutputs:  no,\r\n    91\t\t\tWeights:     weights,\r\n    92\t\t\tBias:        bias,\r\n"]
[1866.424439, "o", "    93\t\t}, nil\r\n    94\t}\r\n    95\t\r\n    96\tfunc writeWeights(path string, w *WeightsData) error {\r\n    97\t\tf, err := os.Create(path)\r\n    98\t\tif err != nil {\r\n    99\t\t\treturn err\r\n   100\t\t}\r\n   101\t\tdefer f.Close()\r\n   102\t\r\n"]
[1866.424505, "o", "   103\t\tif _, err := f.Write(modelMagic); err != nil {\r\n   104\t\t\treturn err\r\n   105\t\t}\r\n   106\t\tif err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {\r\n   107\t\t\treturn err\r\n"]
[1866.424562, "o", "   108\t\t}\r\n   109\t\tif err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {\r\n   110\t\t\treturn err\r\n   111\t\t}\r\n   112\t\tif err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {\r\n   113\t\t\treturn err\r\n   114\t\t}\r\n   115\t\tfor _, v := range w.Weights {\r\n   116\t\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n   117\t\t\t\treturn err\r\n   118\t\t\t}\r\n   119\t\t}\r\n"]
