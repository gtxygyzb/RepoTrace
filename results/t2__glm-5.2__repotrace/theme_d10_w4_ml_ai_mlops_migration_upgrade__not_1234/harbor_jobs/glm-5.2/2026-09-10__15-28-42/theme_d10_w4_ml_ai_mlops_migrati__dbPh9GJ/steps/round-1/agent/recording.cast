[241.952995, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n)\r\n\r\nfunc cmdValidate(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe validate <model>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\terrors := validateModel(entry.Path)\r\n\tif len(errors) == 0 {\r\n\t\tfmt.Printf(\"Model '%s' is valid.\\n\", name)\r\n\t} else {\r\n\t\tfmt.Printf(\"Model '%s' has %d validation error(s):\\n\", name, len(errors))\r\n\t\tfor i, e := range errors {\r\n\t\t\tfmt.Printf(\"  %d. %s\\n\", i+1, e)\r\n\t\t}\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc validateModel(modelDir string) []string {\r\n\tvar errors []string\r\n\r\n\tmetaPath := filepath.Join(modelDir, \"model.meta\")\r\n\tif _, err := os.Stat(metaPath); err != nil {\r\n\t\terrors = append(errors, \"missing model.meta\")\r\n\t} else {\r\n\t\tmeta, err := loadModel"]
[241.953202, "o", "Meta(modelDir)\r\n\t\tif err != nil {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse model.meta: %v\", err))\r\n\t\t} else {\r\n\t\t\tif meta[\"name\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'name' field\")\r\n\t\t\t}\r\n\t\t\tif meta[\"type\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'type' field\")\r\n\t\t\t}\r\n\t\t\tif meta[\"features\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'features' field\")\r\n\t\t\t}\r\n\t\t\tif meta[\"outputs\"] == \"\" {\r\n\t\t\t\terrors = append(errors, \"model.meta: missing 'outputs' field\")\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tweightsPath := filepath.Join(modelDir, \"weights.bin\")\r\n\tif _, err := os.Stat(weightsPath); err != nil {\r\n\t\terrors = append(errors, \"missing weights.bin\")\r\n\t} else {\r\n\t\t_, err := loadWeights(modelDir)\r\n\t\tif err != nil {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse weights.bin: %v\", err))\r\n\t\t}\r\n\t}\r\n\r\n\tcfgPath := filepath.Join(modelDir, \"pipeline.cfg\")\r\n\tif _, err := os.Stat(cfgPath); err != nil {\r\n\t\terrors = append(errors, \"missing pipeline.cfg\")\r\n\t} else {\r\n\t\t_, err"]
[241.953336, "o", " := loadPipelineConfig(modelDir)\r\n\t\tif err != nil {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"cannot parse pipeline.cfg: %v\", err))\r\n\t\t}\r\n\t}\r\n\r\n\treturn errors\r\n}\r\n\r\nfunc cmdExport(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe export <model> --output <dir>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tname := args[0]\r\n\tflags := parseFlags(args[1:])\r\n\r\n\toutputDir := flags[\"output\"]\r\n\tif outputDir == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: --output is required\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: model '%s' not found\\n\", name)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif err := os.MkdirAll(outputDir, 0755); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfiles := []string{\"model.meta\", \"weights.bin\", \"pipeline.cfg\"}\r\n\tfor _, file := range files {\r\n\t\tsrc := filepath.Join(entry.Path, file)\r\n\t\tdst := fi"]
[241.953456, "o", "lepath.Join(outputDir, file)\r\n\t\tdata, err := os.ReadFile(src)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error reading %s: %v\\n\", file, err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tif err := os.WriteFile(dst, data, 0644); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error writing %s: %v\\n\", file, err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\tfmt.Printf(\"Model '%s' exported to %s\\n\", name, outputDir)\r\n}\r\n\u001b[?2004h"]
