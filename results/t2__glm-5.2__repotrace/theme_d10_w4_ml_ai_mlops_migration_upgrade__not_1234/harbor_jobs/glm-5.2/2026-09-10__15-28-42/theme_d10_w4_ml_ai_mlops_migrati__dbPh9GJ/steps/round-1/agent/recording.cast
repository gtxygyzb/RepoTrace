[9220.554372, "o", "   374\tfunc combineEnsembleOutputs(allOutputs [][][]float64, strategy string, weights []float64) [][]float64 {\r\n   375\tnumRows := len(allOutputs[0])\r\n   376\tnumOutputs := len(allOutputs[0][0])\r\n   377\tcombined := make([][]float64, numRows)\r\n   378\tfor i := 0; i < numRows; i++ {\r\n   379\t"]
[9220.554491, "o", "combined[i] = make([]float64, numOutputs)\r\n   380\tfor j := 0; j < numOutputs; j++ {\r\n   381\tvals := make([]float64, len(allOutputs))\r\n   382\tfor k := range allOutputs {\r\n   383\tvals[k] = allOutputs[k][i][j]\r\n   384\t}\r\n   385\tswitch strategy {\r\n   386\tcase \"max\":\r\n   387\tcombined[i][j] = maxFloat64(vals)\r\n   388\tcase \"min\":\r\n   389\tcombined[i][j] = minFloat64(vals)\r\n   390\tdefault:\r\n   391\tcombined[i][j] = weightedMeanFloat64(vals, weights)\r\n   392\t}\r\n   393\t}\r\n   394\t}\r\n   395\treturn combined\r\n   396\t}\r\n   397\t\r\n   398\tfunc weightedMeanFloat64(vals []float64, weights []float64) float64 {\r\n"]
[9220.554644, "o", "   399\tif len(vals) == 0 {\r\n   400\treturn 0\r\n   401\t}\r\n   402\tsum := 0.0\r\n   403\tweightSum := 0.0\r\n   404\tfor i, v := range vals {\r\n   405\tw := 1.0\r\n   406\tif i < len(weights) {\r\n   407\tw = weights[i]\r\n   408\t}\r\n   409\tsum += w * v\r\n   410\tweightSum += w\r\n   411\t}\r\n   412\tif weightSum == 0 {\r\n   413\treturn meanFloat64(vals)\r\n   414\t}\r\n   415\treturn sum / weightSum\r\n   416\t}\r\n   417\t\r\n   418\tfunc meanFloat64(vals []float64) float64 {\r\n   419\tif len(vals) == 0 {\r\n   420\treturn 0\r\n"]
