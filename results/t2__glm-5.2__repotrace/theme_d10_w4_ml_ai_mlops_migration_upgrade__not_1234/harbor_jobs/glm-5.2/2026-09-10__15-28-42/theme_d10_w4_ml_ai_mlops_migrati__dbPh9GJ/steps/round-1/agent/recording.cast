[1866.424792, "o", "   147\t\t\tScaleMax:        1.0,\r\n   148\t\t\tMissingStrategy: \"zero\",\r\n   149\t\t\tRoundDigits:     4,\r\n   150\t\t\tClipMin:         -1000.0,\r\n   151\t\t\tClipMax:         1000.0,\r\n   152\t\t}\r\n   153\t\r\n"]
[1866.424884, "o", "   154\t\tscanner := bufio.NewScanner(f)\r\n   155\t\tsection := \"\"\r\n   156\t\tfor scanner.Scan() {\r\n   157\t\t\tline := strings.TrimSpace(scanner.Text())\r\n   158\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n   159\t\t\t\tcontinue\r\n   160\t\t\t}\r\n   161\t\t\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\r\n   162\t\t\t\tsection = line[1 : len(line)-1]\r\n   163\t\t\t\tcontinue\r\n   164"]
[1866.424944, "o", "\t\t\t}\r\n   165\t\t\tparts := strings.SplitN(line, \"=\", 2)\r\n   166\t\t\tif len(parts) != 2 {\r\n   167\t\t\t\tcontinue\r\n   168\t\t\t}\r\n   169\t\t\tkey := strings.TrimSpace(parts[0])\r\n   170\t\t\tval := strings.TrimSpace(parts[1])\r\n   171\t\r\n   172\t\t\t"]
[1866.425008, "o", "switch section {\r\n   173\t\t\tcase \"preprocess\":\r\n   174\t\t\t\tswitch key {\r\n   175\t\t\t\tcase \"normalize\":\r\n   176\t\t\t\t\tcfg.Normalize = val == \"true\"\r\n   177\t\t\t\tcase \"scale_range\":\r\n   178\t\t\t\t\trangeParts := strings.Split(val, \",\")\r\n"]
[1866.425066, "o", "   179\t\t\t\t\tif len(rangeParts) == 2 {\r\n   180\t\t\t\t\t\tcfg.ScaleMin, _ = strconv.ParseFloat(rangeParts[0], 64)\r\n   181\t\t\t\t\t\tcfg.ScaleMax, _ = strconv.ParseFloat(rangeParts[1], 64)\r\n   182\t\t\t\t\t}\r\n   183\t\t\t\tcase \"missing_strategy\":\r\n   184\t\t\t\t\tcfg.MissingStrategy = val\r\n   185\t\t\t\t}\r\n"]
[1866.425131, "o", "   186\t\t\tcase \"postprocess\":\r\n   187\t\t\t\tswitch key {\r\n   188\t\t\t\tcase \"round_digits\":\r\n   189\t\t\t\t\t"]
[1866.425177, "o", "cfg.RoundDigits, _ = strconv.Atoi(val)\r\n   190\t\t\t\tcase \"clip_min\":\r\n   191\t\t\t\t\tcfg.ClipMin, _ = strconv.ParseFloat(val, 64)\r\n   192\t\t\t\tcase \"clip_max\":\r\n   193\t\t\t\t\tcfg.ClipMax, _ = strconv.ParseFloat(val, 64)\r\n"]
[1866.425272, "o", "   194\t\t\t\t}\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197\t\treturn cfg, scanner.Err()\r\n   198\t}\r\n   199\t\r\n   200\tfunc roundToDigits(val float64, digits int) float64 {\r\n   201\t\tpow := math.Pow(10, float64(digits))\r\n   202\t\treturn math.Round(val*pow) / pow\r\n   203\t}\r\n"]
