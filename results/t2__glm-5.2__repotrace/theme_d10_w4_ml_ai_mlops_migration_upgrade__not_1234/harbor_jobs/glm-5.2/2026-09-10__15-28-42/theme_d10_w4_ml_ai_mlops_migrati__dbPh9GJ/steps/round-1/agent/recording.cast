[9633.345621, "o", "\tfunc validateFeatureCount(inputs [][]float64, expected int) error {\r\n    45\t\tfor i, row := range inputs {\r\n    46\t\t\tif len(row) != expected {\r\n    47\t\t\t\treturn fmt.Errorf(\"expected %d features, got %d in row %d\", expected, len(row), i)\r\n    48\t\t\t}\r\n    49\t\t}\r\n"]
[9633.345692, "o", "    50\t\treturn nil\r\n    51\t}\r\n    52\t\r\n    53\tfunc readCSVRaw(path string) ([][]string, error) {\r\n    54\t\tf, err := os.Open(path)\r\n    55\t\tif err != nil {\r\n    56\t\t\treturn nil, err\r\n    57\t\t}\r\n    58\t\tdefer f.Close()\r\n    59\t\r\n    60\t\treader := csv.NewReader(f)\r\n    61\t\treader.FieldsPerRecord = -1\r\n    62\t\treturn reader.ReadAll()\r\n    63\t}\r\n    64\t\r\n"]
[9633.345729, "o", "    65\tfunc isMissingValue(val string) bool {\r\n    66\t\tval = strings.TrimSpace(val)\r\n    67\t\tif val == \"\" {\r\n    68\t\t\treturn true\r\n    69\t\t}\r\n    70\t\tlower := strings.ToLower(val)\r\n    71\t\treturn lower == \"na\" || lower == \"nan\"\r\n"]
[9633.345866, "o", "    72\t}\r\n    73\t\r\n    74\tfunc cmdStats(args []string) {\r\n    75\t\tflags := parseFlags(args)\r\n    76\t\tinput := flags[\"input\"]\r\n    77\t\tif input == \"\" {\r\n    78\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe stats --input <file>\\n\")\r\n    79\t\t\tos.Exit(1)\r\n    80\t\t}\r\n    81\t\r\n    82\t\trecords, err := readCSVRaw(input)\r\n    83\t\tif err != nil {\r\n"]
[9633.345938, "o", "    84\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    85\t\t\tos.Exit(1)\r\n    86\t\t}\r\n    87\t\tif len(records) == 0 {\r\n    88\t\t\tfmt.Println(\"No data found.\")\r\n    89\t\t\treturn\r\n    90\t\t}\r\n    91\t\r\n    92\t\thasHeader := isHeader(records[0])\r\n    93\t\tstart := 0\r\n"]
[9633.346006, "o", "    94\t\tif hasHeader {\r\n    95\t\t\tstart = 1\r\n    96\t\t}\r\n    97\t\r\n    98\t\tnumCols := 0\r\n    99\t\tfor _, rec := range records {\r\n   100\t\t\tif len(rec) > numCols {\r\n   101\t\t\t\tnumCols = len(rec)\r\n   102\t\t\t}\r\n   103\t\t}\r\n   104\t\r\n"]
[9633.346077, "o", "   105\t\theaders := make([]string, numCols)\r\n   106\t\tfor i := 0; i < numCols; i++ {\r\n   107\t\t\tif hasHeader && i < len(records[0]) {\r\n   108\t\t\t\theaders[i] = strings.TrimSpace(records[0][i])\r\n   109\t\t\t} else {\r\n   110\t\t\t\theaders[i] = fmt.Sprintf(\"col_%d\", i)\r\n   111\t\t\t}\r\n   112\t\t}\r\n   113\t\r\n"]
[9633.346144, "o", "   114\t\ttype colStat struct {\r\n   115\t\t\tidx     int\r\n   116\t\t\tname    string\r\n   117\t\t\tcount   int\r\n   118\t\t\tmissing int\r\n   119\t\t\tmin     float64\r\n   120\t\t\tmax     float64\r\n"]
