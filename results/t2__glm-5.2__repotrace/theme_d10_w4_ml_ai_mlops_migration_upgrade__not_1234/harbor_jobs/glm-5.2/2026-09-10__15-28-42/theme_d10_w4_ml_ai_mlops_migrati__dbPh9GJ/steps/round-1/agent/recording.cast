[4623.871, "o", "   173\tif !modelDirExists(entry.Path) {\r\n   174\tfmt.Fprintf(os.Stderr, \"error: model directory not found\\n\")\r\n   175\tos.Exit(1)\r\n   176\t}\r\n   177\t\r\n   178\tmeta, err := loadModelMeta(entry.Path)\r\n   179\tif err != nil {\r\n   180\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n"]
[4623.871038, "o", "   181\tos.Exit(1)\r\n   182\t}\r\n   183\t\r\n   184\tweights, err := loadWeights(entry.Path)\r\n   185\tif err != nil {\r\n   186\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n   187\tos.Exit(1)\r\n   188\t}\r\n"]
[4623.871078, "o", "   189\t\r\n   190\tfmt.Printf(\"Name:        %s\\n\", meta[\"name\"])\r\n   191\tfmt.Printf(\"Type:        %s\\n\", meta[\"type\"])\r\n   192\tfmt.Printf(\"Version:     %s\\n\", meta[\"version\"])\r\n   193\tfmt.Printf(\"Created:     %s\\n\", meta[\"created\"])\r\n"]
[4623.871119, "o", "   194\tfmt.Printf(\"Description: %s\\n\", meta[\"description\"])\r\n   195\tfmt.Printf(\"Features:    %s\\n\", meta[\"features\"])\r\n   196\tfmt.Printf(\"Outputs:     %s\\n\", meta[\"outputs\"])\r\n   197\tfmt.Printf(\"Format:     v%d\\n\", weights.Version)\r\n   198\tfmt.Printf(\"Activation: %s\\n\", activationIDToName(weights.Activation))\r\n   199\tfmt.Printf(\"Path:        %s\\n\", entry.Path)\r\n   200\t}\r\n   201\t"]
