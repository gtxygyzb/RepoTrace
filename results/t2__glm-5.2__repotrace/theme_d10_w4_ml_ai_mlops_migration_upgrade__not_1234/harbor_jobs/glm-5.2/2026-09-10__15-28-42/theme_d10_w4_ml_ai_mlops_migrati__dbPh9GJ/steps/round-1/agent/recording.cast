[2799.243214, "i", "./mlpipe help\n"]
[2799.243385, "o", "./mlpipe help\r\n\u001b[?2004l\r"]
[2799.248361, "o", "mlpipe - ML Inference Pipeline Manager\r\n\r\nUsage: mlpipe <command> [arguments]\r\n\r\nCommands:\r\n  list                          List all registered models\r\n  info <model>                  Show model details\r\n  register <name> <path>        Register a model from directory\r\n  remove <name>                 Remove a model from registry\r\n  run <model> [options]         Run inference\r\n  stats --input <file>          Input statistics profiling\r\n  diff <model1> <model2> --input <file>\r\n                                Compare two models on same input\r\n  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n                                Batch inference over CSV files\r\n  validate <model>              Validate model integrity\r\n  export <model> --output <dir> Export model to directory\r\n  version                       Show version\r\n  help                          Show this help\r\n\r\nRun/Diff Options:\r\n  --input <file>    Input CSV file (required)\r\n  --output <file>   Output file (default: stdout)\r\n  --format <fmt> "]
[2799.248575, "o", "   Output format: csv or json (default: csv)\r\n\r\nBatch Options:\r\n  --dir <dir>       Input directory of CSV files\r\n  --output-dir <dir> Output directory for predictions\r\n  --format <fmt>    Output format: csv or json (default: csv)\r\n"]
[2799.249123, "o", "\u001b[?2004h"]
[2799.249196, "o", "root@n30009:/app# "]
[2820.20552, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('main.go')\ns = p.read_text()\nold = '  export <model> --output <dir> Export model to directory\\n  version                       Show version'\nnew = '  export <model> --output <dir> Export model to directory\\n  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\\n  compat [--all]                 Check migration compatibility\\n  version                       Show version'\nif old not in s:\n    print('usage block not found')\nelse:\n    s = s.replace(old, new)\n    p.write_text(s)\nPY\n"]
