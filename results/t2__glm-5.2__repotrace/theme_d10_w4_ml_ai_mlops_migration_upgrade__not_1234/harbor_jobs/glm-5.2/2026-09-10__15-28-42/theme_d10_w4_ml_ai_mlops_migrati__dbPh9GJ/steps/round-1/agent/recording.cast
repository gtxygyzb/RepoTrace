[8971.043337, "o", "os.Exit(1)\r\n}\r\n\r\nvar allOutputs [][][]float64\r\nvar featureCount int\r\nfor i, modelName := range cfg.Models {\r\nentry := findEntry(entries, modelName)\r\nif entry == nil {\r\nfmt.Printf(\"model not found: %s\\n\", modelName)\r\n"]
[8971.043448, "o", "os.Exit(1)\r\n}\r\n\r\nweights, err := loadWeights(entry.Path)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error loading weights for model '%s': %v\\n\", modelName, err)\r\nos.Exit(1)\r\n}\r\n\r\nif i == 0 {\r\nfeatureCount = int(weights.NumFeatures)\r\n} else if int(weights.NumFeatures) != featureCount {\r\nfmt.Println(\"feature mismatch\")\r\nos.Exit(1)\r\n}\r\n\r\nif err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {\r\nfmt.Println(\"feature mismatch\")\r\nos.Exit(1)\r\n}\r\n\r\npipelineCfg, err := loadPipelineConfig(entry.Path)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error loading pipeline config for model '%s': %v\\n\", modelName, err)\r\nos.Exit(1)\r\n}\r\n\r\n"]
[8971.043529, "o", "results := runInference(inputs, weights, pipelineCfg)\r\nallOutputs = append(allOutputs, results)\r\n}\r\n\r\nif len(allOutputs) == 0 {\r\nfmt.Fprintf(os.Stderr, \"error: ensemble '%s' has no models\\n\", name)\r\nos.Exit(1)\r\n}\r\n\r\ncombined := combineEnsembleOutputs(allOutputs, cfg.Strategy)\r\n\r\noutputFile := flags[\"output\"]\r\nif outputFile != \"\" && outputFile != \"true\" {\r\nf, err := os.Create(outputFile)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error creating output file: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\n"]
[8971.043606, "o", "defer f.Close()\r\nwriteOutput(f, combined, outputFormat)\r\n} else {\r\nwriteOutput(os.Stdout, combined, outputFormat)\r\n}\r\n}\r\n\r\n"]
[8971.04372, "o", "func cmdEnsembleRemove(args []string) {\r\nif len(args) < 1 {\r\nfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble remove <name>\\n\")\r\nos.Exit(1)\r\n}\r\nname := args[0]\r\n\r\npath := filepath.Join(ensemblesDir, name+\".json\")\r\nif _, err := os.Stat(path); err != nil {\r\nfmt.Println(\"ensemble not found\")\r\nos.Exit(1)\r\n}\r\nif err := os.Remove(path); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\nos.Exit(1)\r\n}\r\nfmt.Printf(\"ensemble '%s' removed\\n\", name)\r\n"]
[8971.043789, "o", "}\r\n\r\nfunc saveEnsembleConfig(cfg *ensembleConfig) error {\r\nif err := os.MkdirAll(ensemblesDir, 0755); err != nil {\r\nreturn err\r\n}\r\ndata, err := json.MarshalIndent(cfg, \"\", \"  \")\r\nif err != nil {\r\nreturn err\r\n}\r\nreturn os.WriteFile(filepath.Join(ensemblesDir, cfg.Name+\".json\"), data, 0644)\r\n}\r\n\r\nfunc loadEnsembleConfig(name string) (*ensembleConfig, error) {\r\ndata, err := os.ReadFile(filepath.Join(ensemblesDir, name+\".json\"))\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nvar cfg ensembleConfig\r\nif err := json.Unmarshal(data, &cfg); err != nil {\r\nreturn nil, err\r\n}\r\nreturn &cfg, nil\r\n}\r\n\r\nfunc listEnsembleConfigs() ([]*ensembleConfig, error) {\r\nfiles, err := os.ReadDir(ensemblesDir)\r\nif err != nil {\r\nif os.IsNotExist(err) {\r\nreturn nil, nil\r\n}\r\nreturn nil, err\r\n}"]
[8971.04391, "o", "\r\nvar configs []*ensembleConfig\r\nfor _, file := range files {\r\nif file.IsDir() || !strings.HasSuffix(file.Name(), \".json\") {\r\ncontinue\r\n}\r\ndata, err := os.ReadFile(filepath.Join(ensemblesDir, file.Name()))\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nvar cfg ensembleConfig\r\nif err := json.Unmarshal(data, &cfg); err != nil {\r\nreturn nil, err\r\n}\r\nconfigs = append(configs, &cfg)\r\n}\r\nsort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })\r\nreturn configs, nil\r\n}\r\n\r\nfunc combineEnsembleOutputs(allOutputs [][][]float64, strategy string) [][]float64 {\r\nnumRows := len(allOutputs[0])\r\n"]
[8971.043971, "o", "numOutputs := len(allOutputs[0][0])\r\ncombined := make([][]float64, numRows)\r\nfor i := 0; i < numRows; i++ {\r\ncombined[i] = make([]float64, numOutputs)\r\nfor j := 0; j < numOutputs; j++ {\r\nvals := make([]float64, len(allOutputs))\r\nfor k := range allOutputs {\r\nvals[k] = allOutputs[k][i][j]\r\n}\r\nswitch strategy {\r\ncase \"max\":\r\ncombined[i][j] = maxFloat64(vals)\r\ncase \"min\":\r\ncombined[i][j] = minFloat64(vals)\r\n"]
[8971.044042, "o", "default:\r\ncombined[i][j] = meanFloat64(vals)\r\n}\r\n}\r\n}\r\nreturn combined\r\n}\r\n\r\nfunc meanFloat64(vals []float64) float64 {\r\nif len(vals) == 0 {\r\nreturn 0\r\n}\r\nsum := 0.0\r\nfor _, v := range vals {\r\n"]
[8971.044102, "o", "sum += v\r\n}\r\nreturn sum / float64(len(vals))\r\n}\r\n\r\nfunc maxFloat64(vals []float64) float64 {\r\nif len(vals) == 0 {\r\nreturn 0\r\n}\r\nm := vals[0]\r\nfor _, v := range vals[1:] {\r\nif v > m {\r\nm = v\r\n}\r\n"]
[8971.044158, "o", "}\r\nreturn m\r\n}\r\n\r\nfunc minFloat64(vals []float64) float64 {\r\nif len(vals) == 0 {\r\n"]
