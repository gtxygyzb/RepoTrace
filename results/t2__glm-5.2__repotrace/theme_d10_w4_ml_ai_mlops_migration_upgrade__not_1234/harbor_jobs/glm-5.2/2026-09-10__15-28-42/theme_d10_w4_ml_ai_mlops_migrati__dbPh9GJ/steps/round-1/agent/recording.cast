[478.50059, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\n# Patch format.go: fix weight reader BigEndian -> LittleEndian\np = Path('format.go')\ns = p.read_text()\ns = s.replace(\n'''if err := binary.Read(f, binary.BigEndian, &no); err != nil {''',\n'''if err := binary.Read(f, binary.LittleEndian, &no); err != nil {'''\n)\ns = s.replace(\n'''// BUG: reads num_outputs as BigEndian instead of LittleEndian''',\n'''// num_outputs is LittleEndian'''\n)\np.write_text(s)\n\n# Patch inference.go: fix normalization formula and guard empty results in writeOutput\np = Path('inference.go')\ns = p.read_text()\nold = '''for i := range result {\n                                // BUG: normalization formula incorrect - should map to [ScaleMin, ScaleMax]\n                                // but uses wrong formula that doesn't properly apply the target range\n                                normalized := (result[i][j] - minVal) / rangeVal\n                                result[i][j] = normalized * cfg.ScaleMax\n                        }'''\nnew = '''for i := rang"]
[478.500882, "i", "e result {\n                                normalized := (result[i][j] - minVal) / rangeVal\n                                result[i][j] = cfg.ScaleMin + normalized*(cfg.ScaleMax-cfg.ScaleMin)\n                        }'''\nif old not in s:\n    raise SystemExit('normalization block not found')\ns = s.replace(old, new)\nold = '''func writeOutput(f *os.File, results [][]float64, format string) {\n        switch format {'''\nnew = '''func writeOutput(f *os.File, results [][]float64, format string) {\n        if len(results) == 0 {\n                return\n        }\n        switch format {'''\nif old not in s:\n    raise SystemExit('writeOutput signature not found')\ns = s.replace(old, new)\np.write_text(s)\nPY\ngo build ./...\n"]
