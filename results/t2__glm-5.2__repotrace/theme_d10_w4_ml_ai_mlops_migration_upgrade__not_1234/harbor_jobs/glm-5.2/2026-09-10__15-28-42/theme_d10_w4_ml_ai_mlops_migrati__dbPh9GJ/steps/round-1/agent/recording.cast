[7572.33631, "o", "\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor i := range entries {\r\n\u001b[32m\u001b[K124\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif entries[i].Name == name {\r\n\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn &entries[i]\r\n\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn nil\r\n\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc cmdList(args []string) {\r\n\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tentries, err := loadRegistry()\r\n\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tos.Exit(1)\r\n\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(entries) == 0 {\r\n\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t"]
