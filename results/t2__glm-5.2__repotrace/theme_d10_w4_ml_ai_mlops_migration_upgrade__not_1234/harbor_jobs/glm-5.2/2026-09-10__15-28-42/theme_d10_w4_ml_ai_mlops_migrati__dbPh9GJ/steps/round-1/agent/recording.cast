[13313.139503, "o", "\u001b[?2004l\r"]
[13313.142557, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n"]
[13313.142632, "o", "\t\"encoding/binary\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nvar modelMagic = []byte(\"MLPW\")\r\n\r\nfunc loadModelMeta(modelDir string) (map[string]string, error) {\r\n\t"]
[13313.142698, "o", "f, err := os.Open(filepath.Join(modelDir, \"model.meta\"))\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tmeta := make(map[string]string)\r\n\tscanner := bufio.NewScanner(f)\r\n\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n"]
[13313.14274, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.SplitN(line, \"=\", 2)\r\n\t\tif len(parts) == 2 {\r\n\t\t\tmeta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])\r\n\t\t}\r\n\t}"]
[13313.142836, "o", "\r\n\treturn meta, scanner.Err()\r\n}\r\n\r\ntype WeightsData struct {\r\n\tVersion     uint32\r\n\tNumFeatures uint32\r\n\tNumOutputs  uint32\r\n\tActivation  uint32\r\n\tWeights     []float64\r\n\tBias        []float64\r\n}\r\n\r\nfunc loadWeights(modelDir string) (*WeightsData, error) {\r\n\tf, err := os.Open(filepath.Join(modelDir, \"weights.bin\"))\r\n\t"]
[13313.142903, "o", "if err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tmagic := make([]byte, 4)\r\n"]
[13313.142966, "o", "\tif _, err := f.Read(magic); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to read magic: %v\", err)\r\n\t}\r\n\tif string(magic) != string(modelMagic) {\r\n\t\treturn nil, fmt.Errorf(\"invalid model file: bad magic\")\r\n\t}\r\n\r\n\tvar ver, nf, no uint32\r\n\tif err := binary.Read(f, binary.LittleEndian, &ver); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to read version: %v\", err)\r\n\t}\r\n\tif err := binary.Read(f, binary.LittleEndian, &nf); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to read num_features: %v\", err)\r\n\t}\r\n\tif err := binary.Read(f, binary.LittleEndian, &no); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to read num_outputs: %v\", err)\r\n"]
[13313.143028, "o", "\t}\r\n\r\n\tvar act uint32\r\n\tswitch ver {\r\n\tcase 1:\r\n\t\tact = 0\r\n\tcase 2:\r\n\t\tif err := binary.Read(f, binary.LittleEndian, &act); err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"failed to read activation: %v\", err)\r\n\t\t}"]
[13313.143092, "o", "\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"unsupported model format version: %d\", ver)\r\n\t}\r\n\r\n\tweights := make([]float64, nf*no)\r\n\tfor i := range weights {\r\n\t\tif err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"failed to read weight[%d]: %v\", i, err)\r\n\t\t}\r\n\t}\r\n\r\n"]
[13313.143152, "o", "\tbias := make([]float64, no)\r\n\tfor i := range bias {\r\n\t\tif err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"failed to read bias[%d]: %v\", i, err)\r\n\t\t}\r\n\t}\r\n\r\n\treturn &WeightsData{\r\n\t\tVersion:     ver,\r\n\t\tNumFeatures: nf,\r\n\t\tNumOutputs:  no,\r\n"]
[13313.143217, "o", "\t\tActivation:  act,\r\n\t\tWeights:     weights,\r\n\t\tBias:        bias,\r\n\t}, nil\r\n}\r\n"]
[13313.143274, "o", "\r\nfunc writeWeights(path string, w *WeightsData) error {\r\n\tf, err := os.Create(path)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tif _, err := f.Write(modelMagic); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {\r\n\t\treturn err\r\n\t}\r\n"]
[13313.143337, "o", "\tif err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif w.Version >= 2 {\r\n\t\tif err := binary.Write(f, binary.LittleEndian, w.Activation); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n"]
[13313.143399, "o", "\tfor _, v := range w.Weights {\r\n\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\tfor _, v := range w.Bias {\r\n\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n\t\t\treturn err\r\n\t"]
[13313.143461, "o", "\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nconst (\r\n"]
[13313.143525, "o", "\tactivationNone    = 0\r\n\tactivationSigmoid = 1\r\n\tactivationReLU    = 2\r\n"]
[13313.144077, "o", "\u001b[?2004h"]
[13313.144156, "o", "root@n30009:/app# "]
[13313.419597, "i", "sed -n '1,90p' main.go\n"]
[13313.419896, "o", "sed -n '1,90p' main.go\r\n"]
[13313.41996, "o", "\u001b[?2004l\r"]
[13313.422967, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n"]
[13313.423037, "o", ")\r\n\r\nconst version = \"0.1.0\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcommand := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch command {\r\n"]
[13313.4231, "o", "\tcase \"ensemble\":\r\n\t\tcmdEnsemble(args)\r\n\tcase \"list\":\r\n\t\tcmdList(args)\r\n\tcase \"info\":\r\n\t\tcmdInfo(args)\r\n\tcase \"register\":\r\n\t\tcmdRegister(args)\r\n\tcase \"remove\":\r\n\t\tcmdRemove(args)"]
[13313.42316, "o", "\r\n\tcase \"tag\":\r\n\t\tcmdTag(args)\r\n\tcase \"untag\":\r\n\t\tcmdUntag(args)\r\n\tcase \"search\":\r\n\t\tcmdSearch(args)\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"stats\":\r\n\t\tcmdStats(args)\r\n"]
[13313.423219, "o", "\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n\tcase \"compare\":\r\n\t\tcmdCompare(args)\r\n\tcase \"batch\":\r\n\t\tcmdBatch(args)\r\n\tcase \"benchmark\":\r\n\t\tcmdBenchmark(args)\r\n\tcase \"prune\":\r\n\t"]
