[268.781544, "o", "    86\t\t\treturn nil, err\r\n    87\t\t}\r\n    88\t\tdefer f.Close()\r\n    89\t\r\n    90\t\treader := csv.NewReader(f)\r\n    91\t\trecords, err := reader.ReadAll()\r\n    92\t\tif err != nil {\r\n    93\t\t\treturn nil, err\r\n    94\t\t}\r\n    95\t\r\n    96\t\tvar data [][]float64\r\n    97\t\tfor i, record := range records {\r\n    98\t\t\tif i == 0 && isHeader(record) {\r\n    99\t\t\t\tcontinue\r\n   100"]
[268.781613, "o", "\t\t\t}\r\n   101\t\t\trow := make([]float64, len(record))\r\n   102\t\t\tfor j, val := range record {\r\n   103\t\t\t\tval = strings.TrimSpace(val)\r\n   104\t\t\t\tif val == \"\" || val == \"NA\" || val == \"nan\" {\r\n   105\t\t\t\t\trow[j] = math.NaN()\r\n   106\t\t\t\t} else {\r\n   107\t\t\t\t\trow[j], err = strconv.ParseFloat(val, 64)\r\n   108\t\t\t\t\tif err != nil {\r\n"]
[268.781684, "o", "   109\t\t\t\t\t\treturn nil, fmt.Errorf(\"row %d col %d: %v\", i, j, err)\r\n   110\t\t\t\t\t}\r\n   111\t\t\t\t}\r\n   112\t\t\t}\r\n   113\t\t\tdata = append(data, row)\r\n   114\t\t}\r\n   115\t\treturn data, nil\r\n   116\t}\r\n   117\t\r\n"]
[268.78175, "o", "   118\tfunc isHeader(record []string) bool {\r\n   119\t\tfor _, val := range record {\r\n   120\t\t\t_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)\r\n   121\t\t\tif err == nil {\r\n   122\t\t\t\treturn false\r\n   123\t\t\t}\r\n   124\t\t}\r\n   125\t\treturn true\r\n   126\t}\r\n   127\t\r\n   128\t"]
[268.781835, "o", "func runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n   129\t\tprocessed := preprocess(inputs, cfg)\r\n   130\t\r\n   131\t\tresults := make([][]float64, len(processed))\r\n   132\t\tfor i, row := range processed {\r\n   133\t\t\toutput := make([]float64, weights.NumOutputs)\r\n   134\t\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n   135\t\t\t\tsum := weights.Bias[o]\r\n   136\t\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n   137\t\t\t\t\tif int(f) < len(row) {\r\n"]
[268.781923, "o", "   138\t\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n   139\t\t\t\t\t}\r\n   140\t\t\t\t}\r\n   141\t\t\t\toutput[o] = sum\r\n   142\t\t\t}\r\n   143\t\t\tresults[i] = output\r\n   144\t\t}\r\n   145\t\r\n   146\t\treturn postprocess(results, cfg)\r\n   147\t}\r\n   148\t\r\n   149\tfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   150\t\t"]
[268.782003, "o", "result := make([][]float64, len(inputs))\r\n   151\t\tfor i, row := range inputs {\r\n   152\t\t\tresult[i] = make([]float64, len(row))\r\n   153\t\t\tcopy(result[i], row)\r\n   154\t\t}\r\n   155\t\r\n   156\t\tfor i, row := range result {\r\n   157\t\t\tfor j, val := range row {\r\n   158\t\t\t\tif math.IsNaN(val) {\r\n   159\t\t\t\t\tswitch cfg.MissingStrategy {\r\n"]
[268.782091, "o", "   160\t\t\t\t\tcase \"zero\":\r\n   161\t\t\t\t\t\tresult[i][j] = 0.0\r\n   162\t\t\t\t\tcase \"mean\":\r\n   163\t\t\t\t\t\tresult[i][j] = computeColumnMean(inputs, j)\r\n   164\t\t\t\t\t}\r\n   165\t\t\t\t}\r\n   166\t\t\t}\r\n   167\t\t}\r\n   168\t\r\n   169\t\tif cfg.Normalize {\r\n   170\t\t\tfor j := 0; j < len(result[0]); j++ {\r\n   171\t\t\t\tminVal, maxVal := columnMinMax(result, j)"]
[268.782162, "o", "\r\n   172\t\t\t\trangeVal := maxVal - minVal\r\n   173\t\t\t\tif rangeVal == 0 {\r\n   174\t\t\t\t\trangeVal = 1.0\r\n   175\t\t\t\t}\r\n   176\t\t\t\tfor i := range result {\r\n   177\t\t\t\t\t// BUG: normalization formula incorrect - should map to [ScaleMin, ScaleMax]\r\n   178\t\t\t\t\t// but uses wrong formula that doesn't properly apply the target range\r\n   179\t\t\t\t\tnormalized := (result[i][j] - minVal) / rangeVal\r\n   180\t\t\t\t\tresult[i][j] = normalized * cfg.ScaleMax\r\n"]
