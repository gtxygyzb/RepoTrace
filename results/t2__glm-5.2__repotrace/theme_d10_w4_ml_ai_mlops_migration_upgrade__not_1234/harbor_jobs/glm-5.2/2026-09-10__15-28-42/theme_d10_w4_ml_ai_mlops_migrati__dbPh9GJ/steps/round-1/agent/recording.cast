[12655.509988, "o", "\t\t\tos.Exit(1)\r\n   161\t\t}\r\n   162\t\tname := args[0]\r\n   163\t\tentries, err := loadRegistry()\r\n   164\t\tif err != nil {\r\n   165\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   166\t\t\tos.Exit(1)\r\n   167\t\t}\r\n   168\t\tentry := findEntry(entries, name)\r\n   169\t\tif entry == nil {\r\n   170\t\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n   171\t\t\tos.Exit(1)\r\n"]
