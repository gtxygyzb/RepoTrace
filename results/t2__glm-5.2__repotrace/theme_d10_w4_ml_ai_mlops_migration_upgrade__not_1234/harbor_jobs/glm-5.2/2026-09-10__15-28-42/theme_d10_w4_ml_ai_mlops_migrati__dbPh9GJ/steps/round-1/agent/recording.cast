[3305.631691, "o", "\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif _, err := f.Write(modelMagic); err != nil {\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn err\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {\r\n\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn err\r\n\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {\r\n\u001b[32m\u001b[K124\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn err\r\n\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {\r\n\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn err\r\n\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif w.Version >= 2 {\r\n\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err := binary.Write(f, binary.LittleEndian, w.Activation); err != nil {\r\n\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn err\r\n\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b"]
[3305.631777, "o", "[K134\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, v := range w.Weights {\r\n\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn err\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K139\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, v := range w.Bias {\r\n\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err := binary.Write(f, binary.LittleEndian, v); err != nil {\r\n\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn err\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn nil\r\n\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kconst (\r\n\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tactivationNone    = 0\r\n"]
[3305.631882, "o", "\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tactivationSigmoid = 1\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tactivationReLU    = 2\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tactivationTanh    = 3\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc activationNameToID(name string) (uint32, error) {\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tswitch strings.ToLower(name) {\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"\", \"none\":\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn activationNone, nil\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"sigmoid\":\r\n\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn activationSigmoid, nil\r\n\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"relu\":\r\n"]
