[9220.284727, "o", "   166\tif err != nil {\r\n   167\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   168\tos.Exit(1)\r\n   169\t}\r\n   170\tif len(configs) == 0 {\r\n   171\tfmt.Println(\"no ensembles\")\r\n   172\treturn\r\n   173\t}\r\n   174\tsort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })\r\n   175\tfor _, cfg := range configs {\r\n   176\tfmt.Printf(\"%s  %s  %d models\\n\", cfg.Name, cfg.Strategy, len(cfg.Models))\r\n   177\t}\r\n   178\t}\r\n   179\t\r\n   180\tfunc cmdEnsembleInfo(args []string) {\r\n   181\tif len(args) < 1 {\r\n   182\tfmt.Fprintf(os.Stderr, \"usage: mlpipe ensemble info <name>\\n\")\r\n   183\tos.Exit(1)\r\n   184\t}\r\n   185\tname := args[0]\r\n"]
