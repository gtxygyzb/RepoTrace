[9685.486866, "o", "ScaleMax        float64\r\n   222\t\tMissingStrategy string\r\n   223\t\tRoundDigits     int\r\n   224\t\tClipMin         float64\r\n   225\t\tClipMax         float64\r\n   226\t}\r\n   227\t\r\n   228\tfunc loadPipelineConfig(modelDir string) (*PipelineConfig, error) {\r\n   229\t\tf, err := os.Open(filepath.Join(modelDir, \"pipeline.cfg\"))\r\n   230\t\tif err != nil {\r\n   231\t\t\treturn nil, err\r\n   232\t\t}\r\n   233\t\tdefer f.Close()\r\n   234\t\r\n   235\t\tcfg := &PipelineConfig{\r\n   236\t\t\tScaleMin:        0.0,\r\n   237\t\t\tScaleMax:        1.0,\r\n   238\t\t\tMissingStrategy: \"zero\",\r\n   239\t\t\tRoundDigits:     4,\r\n   240\t\t\tClipMin:         -1000.0,\r\n   241\t\t\tClipMax:         1000.0,\r\n   242\t\t}\r\n   243\t\r\n   244\t\tscanner := bufio.NewScanner(f)\r\n   245\t\tsection := \"\"\r\n   246\t\tfor scanner.Scan() {\r\n   247\t\t\tline := strings.TrimSpace(scanner.Text())\r\n   248\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n   249\t\t\t\tcontinue\r\n   250\t\t\t}\r\n   251\t\t\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\r\n   252\t\t\t\tsection = line[1 : len(line)-1]\r\n   253"]
[9685.487112, "o", "\t\t\t\tcontinue\r\n   254\t\t\t}\r\n   255\t\t\tparts := strings.SplitN(line, \"=\", 2)\r\n   256\t\t\tif len(parts) != 2 {\r\n   257\t\t\t\tcontinue\r\n   258\t\t\t}\r\n   259\t\t\tkey := strings.TrimSpace(parts[0])\r\n   260\t\t\tval := strings.TrimSpace(parts[1])\r\n   261\t\r\n   262\t\t\tswitch section {\r\n   263\t\t\tcase \"preprocess\":\r\n   264\t\t\t\tswitch key {\r\n   265\t\t\t\tcase \"normalize\":\r\n   266\t\t\t\t\tcfg.Normalize = val == \"true\"\r\n   267\t\t\t\tcase \"scale_range\":\r\n   268\t\t\t\t\trangeParts := strings.Split(val, \",\")\r\n   269\t\t\t\t\tif len(rangeParts) == 2 {\r\n   270\t\t\t\t\t\tcfg.ScaleMin, _ = strconv.ParseFloat(rangeParts[0], 64)\r\n   271\t\t\t\t\t\tcfg.ScaleMax, _ = strconv.ParseFloat(rangeParts[1], 64)\r\n   272\t\t\t\t\t}\r\n   273\t\t\t\tcase \"missing_strategy\":\r\n   274\t\t\t\t\tcfg.MissingStrategy = val\r\n   275\t\t\t\t}\r\n   276\t\t\tcase \"postprocess\":\r\n   277\t\t\t\tswitch key {\r\n   278\t\t\t\tcase \"round_digits\":\r\n   279\t\t\t\t\tcfg.RoundDigits, _ = strconv.Atoi(val)\r\n   280\t\t\t\tcase \"clip_min\":\r\n   281\t\t\t\t\tcfg.ClipMin, _ = strconv.ParseFloat(val, 64)\r\n   282\t\t\t\tcase \"clip_max\":\r\n   283\t\t\t\t\tcfg.ClipMax, _ = s"]
[9685.4872, "o", "trconv.ParseFloat(val, 64)\r\n   284\t\t\t\t}\r\n   285\t\t\t}\r\n   286\t\t}\r\n   287\t\treturn cfg, scanner.Err()\r\n   288\t}\r\n   289\t\r\n   290\tfunc roundToDigits(val float64, digits int) float64 {\r\n"]
