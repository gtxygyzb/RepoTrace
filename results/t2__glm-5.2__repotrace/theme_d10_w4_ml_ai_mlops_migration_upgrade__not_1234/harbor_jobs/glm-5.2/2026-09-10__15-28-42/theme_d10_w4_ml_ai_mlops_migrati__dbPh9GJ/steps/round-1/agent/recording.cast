[388.903426, "o", "\u001b[35m\u001b[Kinference.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tresult[i][j] = normalized * cfg.\u001b[01;31m\u001b[KScaleMax\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// \u001b[01;31m\u001b[KBUG\u001b[m\u001b[K: reads num_outputs as BigEndian instead of LittleEndian\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KNormalize\u001b[m\u001b[K       bool\r\n"]
[388.903505, "o", "\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KScaleMin\u001b[m\u001b[K        float64\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KScaleMax\u001b[m\u001b[K        float64\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KScaleMin\u001b[m\u001b[K:        0.0,\r\n"]
[388.903572, "o", "\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KScaleMax\u001b[m\u001b[K:        1.0,\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K176\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tcfg.\u001b[01;31m\u001b[KNormalize\u001b[m\u001b[K = val == \"true\"\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K177\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcase \"\u001b[01;31m\u001b[Kscale\u001b[m\u001b[K_range\":\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t"]
[388.903636, "o", "\tcfg.\u001b[01;31m\u001b[KScaleMin\u001b[m\u001b[K, _ = strconv.ParseFloat(rangeParts[0], 64)\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K181\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tcfg.\u001b[01;31m\u001b[KScaleMax\u001b[m\u001b[K, _ = strconv.ParseFloat(rangeParts[1], 64)\r\n"]
