[3340.713731, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n"]
[3340.713838, "o", ")\r\n\r\nfunc cmdMigrate(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe migrate <model> [--activation <type>]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tname := args[0]\r\n\tflags := parseFlags(args[1:])\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t"]
[3340.713927, "o", "\tos.Exit(1)\r\n\t}\r\n\r\n\tentry := findEntry(entries, name)\r\n\tif entry == nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"model not found\")\r\n"]
[3340.713994, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif !modelDirExists(entry.Path) {\r\n\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tactivationName := flags[\"activation\"]\r\n\tif activationName == \"\" {\r\n\t\tactivationName = \"none\"\r\n\t}\r\n\r\n\tactivationType, err := activationNameToID(activationName)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"invalid activation\")\r\n\t\tos.Exit(1)\r\n\t}"]
[3340.714063, "o", "\r\n\r\n\tweights, err := loadWeights(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading weights: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif weights.Version >= 2 {\r\n\t\tfmt.Printf(\"Model '%s' is already migrated to format v2.\\n\", name)\r\n\t\tos.Exit(0)\r\n\t}\r\n\r\n\tweightsPath := filepath.Join(entry.Path, \"weights.bin\")\r\n\tbackupPath := filepath.Join(entry.Path, \"weights.bin.v1bak\")\r\n\r\n\tdata, err := os.ReadFile(weightsPath)\r\n"]
[3340.714148, "o", "\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error reading weights: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif err := os.WriteFile(backupPath, data, 0644); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error writing backup: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tweights.Version = 2\r\n\tweights.Activation = activationType\r\n\tif err := writeWeights(weightsPath, weights); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error writing weights: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n"]
[3340.71423, "o", "\t}\r\n\r\n\tmeta, err := loadModelMeta(entry.Path)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error loading metadata: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tmeta[\"format_version\"] = \"2\"\r\n\tmeta[\"activation\"] = activationIDToName(activationType)\r\n\tif err := saveModelMeta(entry.Path, meta); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error updating metadata: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[3340.714317, "o", "\tfmt.Printf(\"Model '%s' migrated to format v2 (activation=%s).\\n\", name, activationIDToName(activationType))\r\n}\r\n\r\nfunc cmdCompat(args []string) {\r\n\tflags := parseFlags(args)\r\n\tall := flags[\"all\"] == \"true\" || flags[\"all\"] == \"1\"\r\n\r\n\tentries, err := loadRegistry()\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfor _, e := range entries {\r\n\t\tvar version uint32\r\n\t\tstatus := \"current\"\r\n\r\n\t\tif !modelDirExists(e.Path) {"]
[3340.714397, "o", "\r\n\t\t\tversion = 0\r\n\t\t\tstatus = \"not_found\"\r\n\t\t} else {\r\n\t\t\tw, err := loadWeights(e.Path)\r\n\t\t\tif err != nil {\r\n\t\t\t\tversion = 0\r\n\t\t\t\tstatus = \"error\"\r\n\t\t\t} else {\r\n\t\t\t\tversion = w.Version\r\n\t\t\t\tswitch version {\r\n\t\t\t\tcase 1:\r\n"]
[3340.71446, "o", "\t\t\t\t\tstatus = \"needs_migration\"\r\n\t\t\t\tcase 2:\r\n\t\t\t\t\tstatus = \"current\"\r\n"]
