[7523.685377, "o", "\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc printUsage\u001b[m\u001b[K() {\r\n"]
[7523.685461, "o", "\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tusage := `mlpipe - ML Inference Pipeline Manager\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KUsage: mlpipe <command> [arguments]\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KCommands:\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  list                          List all registered models\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  info <model>                  Show model details\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  register <name> <path>        Register a model from directory\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  remove <name>                 Remove a model from registry\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  run <model> [options]         Run inference\r\n"]
[7523.685539, "o", "\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  stats --input <file>          Input statistics profiling\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  diff <model1> <model2> --input <file>\r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                Compare two models on same input\r\n\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                Batch inference over CSV files\r\n\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  validate <model>              Validate model integrity\r\n\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  export <model> --output <file> Export model to JSON file\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  import <path> [--name <name>] Import model from JSON file\r\n\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  clone <model> <new_name>      Clone model to new name\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    profile <model>               Report model weight analysis\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n"]
[7523.685628, "o", "\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  compat [--all]                 Check migration compatibility\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  version                       Show version\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  help                          Show this help\r\n\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KRun/Diff Options:\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  --input <file>    Input CSV file (required)\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  --output <file>   Output file (default: stdout)\r\n\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  --format <fmt>    Output format: csv or json (default: csv)\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[7523.685698, "o", "\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KBatch Options:\r\n\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  --dir <dir>       Input directory of CSV files\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  --output-dir <dir> Output directory for predictions\r\n\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  --format <fmt>    Output format: csv or json (default: csv)\r\n\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K`\r\n\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfmt.Print(usage)\r\n\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc parseFlags\u001b[m\u001b[K(args []string) map[string]string {\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tflags := make(map[string]string)\r\n"]
[7523.685763, "o", "\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor i := 0; i < len(args); i++ {\r\n\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif strings.HasPrefix(args[i], \"--\") {\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tflags[key] = args[i+1]\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\ti++\r\n\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t} else {\r\n"]
[7523.685882, "o", "\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tflags[key] = \"true\"\r\n\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K124\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn flags\r\n\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
