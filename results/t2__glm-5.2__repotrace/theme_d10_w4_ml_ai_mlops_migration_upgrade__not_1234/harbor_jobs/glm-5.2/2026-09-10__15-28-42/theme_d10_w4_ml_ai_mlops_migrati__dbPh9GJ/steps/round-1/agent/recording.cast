[9667.338079, "o", "\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KNumOutputs\u001b[m\u001b[K  uint32\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K  uint32\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn nil, fmt.Errorf(\"failed to read num_\u001b[01;31m\u001b[Kfeatures\u001b[m\u001b[K: %v\", err)\r\n"]
[9667.338135, "o", "\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K: nf,\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KNumOutputs\u001b[m\u001b[K:  no,\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K:  act,\r\n\u001b[35m\u001b[Kformat.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif err := binary.Write(f, binary.LittleEndian, w.\u001b[01;31m\u001b[KNumFeatures\u001b[m\u001b[K); err != nil {\r\n"]
