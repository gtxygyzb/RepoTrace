[5933.13871, "o", "   364\tfunc cmdBatch(args []string) {\r\n   365\t\tif len(args) < 1 {\r\n   366\t\t\tfmt.Fprintf(os.Stderr, \"usage: mlpipe batch <model> --dir <input_dir> --output-dir <output_dir> [--format csv|json]\\n\")\r\n   367\t\t\tos.Exit(1)\r\n   368\t\t}\r\n   369\t\r\n   370\t\tmodel := args[0]\r\n   371\t\tflags := parseFlags(args[1:])\r\n   372\t\r\n   373\t\tinputDir := flags[\"dir\"]\r\n   374\t\toutputDir := flags[\"output-dir\"]\r\n"]
[5933.138782, "o", "   375\t\tformat := flags[\"format\"]\r\n   376\t\tif format == \"\" {\r\n   377\t\t\tformat = \"csv\"\r\n   378\t\t}\r\n   379\t\tif format != \"csv\" && format != \"json\" {\r\n   380\t\t\tfmt.Fprintf(os.Stderr, \"error: unsupported format '%s', use 'csv' or 'json'\\n\", format)\r\n   381\t\t\tos.Exit(1)\r\n   382\t\t}\r\n   383\t\tif inputDir == \"\" {\r\n   384\t\t\tfmt.Fprintf(os.Stderr, \"error: --dir is required\\n\")\r\n"]
[5933.138896, "o", "   385\t\t\tos.Exit(1)\r\n   386\t\t}\r\n   387\t\tif outputDir == \"\" {\r\n   388\t\t\tfmt.Fprintf(os.Stderr, \"error: --output-dir is required\\n\")\r\n   389\t\t\tos.Exit(1)\r\n   390\t\t}\r\n   391\t\r\n   392\t\tentry, err := resolveModel(model)\r\n   393\t\tif err != nil {\r\n   394\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   395\t\t\tos.Exit(1)\r\n   396\t\t}\r\n"]
[5933.138956, "o", "   397\t\r\n   398\t\tweights, cfg, err := loadModelArtifacts(entry.Path)\r\n   399\t\tif err != nil {\r\n   400\t\t\tfmt.Fprintf(os.Stderr, \"error loading model: %v\\n\", err)\r\n   401\t\t\tos.Exit(1)\r\n   402\t\t}\r\n   403\t\r\n"]
[5933.139014, "o", "   404\t\tif err := os.MkdirAll(outputDir, 0755); err != nil {\r\n   405\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   406\t\t\tos.Exit(1)\r\n   407\t\t}\r\n   408\t\r\n   409\t\tdirEntries, err := os.ReadDir(inputDir)\r\n   410\t\tif err != nil {\r\n   411\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   412"]
[5933.13907, "o", "\t\t\tos.Exit(1)\r\n   413\t\t}\r\n   414\t\r\n   415\t\tvar files []string\r\n   416\t\tfor _, de := range dirEntries {\r\n   417\t\t\tif de.IsDir() {\r\n   418\t\t\t\tcontinue\r\n"]
[5933.139131, "o", "   419\t\t\t}\r\n   420\t\t\tname := de.Name()\r\n   421\t\t\tif strings.HasSuffix(strings.ToLower(name), \".csv\") {\r\n   422\t\t\t\tfiles = append(files, filepath.Join(inputDir, name))\r\n   423\t\t\t}\r\n   424\t\t}\r\n   425\t\tsort.Strings(files)\r\n   426\t\r\n   427\t\ttotalFiles := len(files)\r\n   428\t\ttotalRows := 0"]
[5933.139191, "o", "\r\n   429\t\tprocessed := 0\r\n   430\t\tvar failures []string\r\n   431\t\r\n   432\t\tfor _, file := range files {\r\n   433\t\t\tinputs, err := readInputCSV(file)\r\n   434\t\t\tif err != nil {\r\n"]
[5933.139265, "o", "   435\t\t\t\tfailures = append(failures, fmt.Sprintf(\"%s: %v\", filepath.Base(file), err))\r\n   436\t\t\t\tcontinue\r\n   437\t\t\t}\r\n   438\t\r\n"]
[5933.13933, "o", "   439\t\t\tif err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {\r\n   440\t\t\t\tfailures = append(failures, fmt.Sprintf(\"%s: %v\", filepath.Base(file), err))\r\n   441\t\t\t\tcontinue\r\n   442\t\t\t}\r\n   443\t\r\n   444\t\t\tresults := runInference(inputs, weights, cfg)\r\n   445\t\r\n   446\t\t\tbase := strings.TrimSuffix(filepath.Base(file), filepath.Ext(file))\r\n   447\t\t\toutPath := filepath.Join(outputDir, base+\".\"+format)\r\n   448\t\t\tf, err := os.Create(outPath)\r\n   449\t\t\tif err != nil {\r\n"]
[5933.139399, "o", "   450\t\t\t\tfailures = append(failures, fmt.Sprintf(\"%s: %v\", filepath.Base(file), err))\r\n   451\t\t\t\tcontinue\r\n   452\t\t\t}\r\n   453\t\t\twriteOutput(f, results, format)\r\n   454\t\t\tf.Close()\r\n   455\t\r\n   456\t\t\tprocessed++\r\n   457\t\t\ttotalRows += len(results)\r\n   458\t\t}\r\n   459\t\r\n   460\t\tfmt.Printf(\"Batch summary:\\n\")"]
[5933.139461, "o", "\r\n   461\t\tfmt.Printf(\"  total files processed: %d\\n\", totalFiles)\r\n   462\t\tfmt.Printf(\"  successful: %d\\n\", processed)\r\n   463\t\tfmt.Printf(\"  total rows: %d\\n\", totalRows)\r\n   464\t\tfmt.Printf(\"  failed files: %d\\n\", len(failures))\r\n   465\t\tfor _, fail := range failures {\r\n   466\t\t\tfmt.Printf(\"  - %s\\n\", fail)\r\n   467\t\t}\r\n   468\t}\r\n"]
