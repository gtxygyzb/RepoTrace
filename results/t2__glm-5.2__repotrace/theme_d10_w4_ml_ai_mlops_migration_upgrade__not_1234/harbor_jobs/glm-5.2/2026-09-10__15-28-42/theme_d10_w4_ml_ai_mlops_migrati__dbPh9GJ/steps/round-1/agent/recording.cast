[12975.377361, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('commands_extra.go')\ns = p.read_text()\n\nold = '''\\tmodel1 := args[0]\n\\tmodel2 := args[1]\n\\tflags := parseFlags(args[2:])\n\\tinput := flags[\"input\"]\n\n\\tentry1, err := resolveModel(model1)\n'''\nnew = '''\\tmodel1 := args[0]\n\\tmodel2 := args[1]\n\\tflags := parseFlags(args[2:])\n\\tinput := flags[\"input\"]\n\n\\tif input != \"\" {\n\\t\\tif _, err := os.Stat(input); err != nil {\n\\t\\t\\tfmt.Fprintln(os.Stderr, \"file not found\")\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\\t}\n\n\\tentry1, err := resolveModel(model1)\n'''\n\nif old in s:\n    s = s.replace(old, new)\n\n# Remove the later duplicate existence check.\nold2 = '''\\tif input != \"\" {\n\\t\\tif _, err := os.Stat(input); err != nil {\n\\t\\t\\tfmt.Fprintln(os.Stderr, \"file not found\")\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\n\\t\\tinputs, err := readInputCSV(input)\n'''\nnew2 = '''\\tif input != \"\" {\n\\t\\tinputs, err := readInputCSV(input)\n'''\nif old2 in s:\n    s = s.replace(old2, new2)\n\np.write_text(s)\nPY\ngofmt -w commands_extra.go main.go && go build ./...\n"]
