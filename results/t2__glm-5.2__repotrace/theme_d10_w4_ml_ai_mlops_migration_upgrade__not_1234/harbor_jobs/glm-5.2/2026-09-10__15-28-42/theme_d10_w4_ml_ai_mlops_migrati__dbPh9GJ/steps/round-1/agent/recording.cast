[13292.284853, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n)\r\n\r\nconst version = \"0.1.0\"\r\n\r\nfunc main() {\r\n"]
[13292.285007, "o", "\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcommand := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch command {\r\n\tcase \"ensemble\":\r\n\t\tcmdEnsemble(args)\r\n\tcase \"list\":\r\n\t\tcmdList(args)\r\n\tcase \"info\":\r\n\t\tcmdInfo(args)\r\n\tcase \"register\":\r\n\t\tcmdRegister(args)\r\n\tcase \"remove\":\r\n\t\tcmdRemove(args)\r\n\tcase \"tag\":\r\n\t\tcmdTag(args)\r\n\tcase \"untag\":\r\n\t\tcmdUntag(args)\r\n\tcase \"search\":\r\n\t\tcmdSearch(args)\r\n\tcase \"run\":\r\n\t\tcmdRun(args)\r\n\tcase \"stats\":\r\n\t\tcmdStats(args)\r\n"]
[13292.285116, "o", "\tcase \"diff\":\r\n\t\tcmdDiff(args)\r\n\tcase \"compare\":\r\n\t\tcmdCompare(args)\r\n\tcase \"batch\":\r\n\t\tcmdBatch(args)\r\n\tcase \"benchmark\":\r\n\t\tcmdBenchmark(args)\r\n\tcase \"prune\":\r\n"]
[13292.285184, "o", "\t\tcmdPrune(args)\r\n\tcase \"profile\":\r\n\t\tcmdProfile(args)\r\n\tcase \"explain\":\r\n\t\tcmdExplain(args)\r\n\tcase \"validate\":\r\n\t\tcmdValidate(args)\r\n\tcase \"validate-input\":\r\n\t\tcmdValidateInput(args)\r\n\tcase \"schema\":\r\n\t\tcmdSchema(args)\r\n\tcase \"export\":\r\n\t\tcmdExport(args)\r\n\tcase \"import\":\r\n\t\tcmdImport(args)\r\n\tcase \"clone\":\r\n\t\tcmdClone(args)\r\n\tcase \"checkpoint\":\r\n\t\tcmdCheckpoint(args)\r\n\tcase \"checkpoints\":\r\n\t\tcmdCheckpoints(args)\r\n"]
[13292.285249, "o", "\tcase \"rollback\":\r\n\t\tcmdRollback(args)\r\n\tcase \"migrate\":\r\n\t\tcmdMigrate(args)\r\n\tcase \"compat\":\r\n\t\tcmdCompat(args)\r\n\tcase \"version\":\r\n\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n\tcase \"help\":\r\n\t\tprintUsage()\r\n\tdefault:\r\n\t"]
[13292.285311, "o", "\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc printUsage() {\r\n\tusage := `mlpipe - ML Inference Pipeline Manager\r\n\r\n"]
