[288.831609, "o", "    46\tfunc loadWeights(modelDir string) (*WeightsData, error) {\r\n    47\t\tf, err := os.Open(filepath.Join(modelDir, \"weights.bin\"))\r\n    48\t\tif err != nil {\r\n    49\t\t\treturn nil, err\r\n    50\t\t}\r\n    51\t\tdefer f.Close()\r\n    52\t\r\n    53\t\tmagic := make([]byte, 4)\r\n    54\t\tif _, err := f.Read(magic); err != nil {\r\n    55\t\t\treturn nil, fmt.Errorf(\"failed to read magic: %v\", err)\r\n    56\t\t}\r\n    57\t\tif string(magic) != string(modelMagic) {\r\n    58\t\t\treturn nil, fmt.Errorf(\"invalid model file: bad magic\")\r\n    59\t\t}\r\n    60\t\r\n    61\t\t"]
[288.831678, "o", "var ver, nf, no uint32\r\n    62\t\tif err := binary.Read(f, binary.LittleEndian, &ver); err != nil {\r\n    63\t\t\treturn nil, fmt.Errorf(\"failed to read version: %v\", err)\r\n    64\t\t}\r\n    65\t\tif err := binary.Read(f, binary.LittleEndian, &nf); err != nil {\r\n    66\t\t\t"]
[288.831743, "o", "return nil, fmt.Errorf(\"failed to read num_features: %v\", err)\r\n    67\t\t}\r\n    68\t\t// BUG: reads num_outputs as BigEndian instead of LittleEndian\r\n    69\t\tif err := binary.Read(f, binary.BigEndian, &no); err != nil {\r\n    70\t\t\treturn nil, fmt.Errorf(\"failed to read num_outputs: %v\", err)\r\n    71\t\t}\r\n    72\t\r\n    73\t\tweights := make([]float64, nf*no)\r\n    74\t\tfor i := range weights {\r\n    75\t\t\tif err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {\r\n    76\t\t\t\treturn nil, fmt.Errorf(\"failed to read weight[%d]: %v\", i, err)\r\n    77\t\t\t}\r\n    78\t"]
