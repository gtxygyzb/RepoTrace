[7483.470593, "o", "\t\t\tnewEntries = append(newEntries, e)\r\n\t\t}\r\n\t}\r\n\r\n\tif !found {\r\n\t\tfmt.Fprintln(os.Stderr, \"not found\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif err := saveRegistry(newEntries); err != nil {\r\n"]
[7483.47065, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Printf(\"Model '%s' removed.\\n\", name)\r\n}\r\n\r\nfunc isValidTag(tag string) bool {\r\n\tif tag == \"\" {\r\n\t\treturn false\r\n\t}\r\n\tfor _, c := range tag {\r\n"]
[7483.470711, "o", "\t\tisLower := c >= 'a' && c <= 'z'\r\n\t\tisDigit := c >= '0' && c <= '9'\r\n\t\tisHyphen := c == '-'\r\n\t\tif !(isLower || isDigit || isHyphen) {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n"]
[7483.470773, "o", "\r\nfunc hasTag(entry *RegistryEntry, tag string) bool {\r\n\tfor _, t := range entry.Tags {\r\n\t\tif t == tag {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc cmdTag(args []string) {\r\n\tif len(args) < 2 {\r\n"]
