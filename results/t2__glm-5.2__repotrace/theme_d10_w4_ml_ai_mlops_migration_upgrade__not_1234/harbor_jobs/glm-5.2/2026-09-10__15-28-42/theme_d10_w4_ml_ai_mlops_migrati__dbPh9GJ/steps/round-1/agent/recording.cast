[4594.007238, "o", "fmt.Sscanf(parts[3], \"%d\", &ver)\r\n    84\tentries = append(entries, RegistryEntry{\r\n    85\tName:    parts[0],\r\n    86\tPath:    parts[1],\r\n    87\tType:    parts[2],\r\n    88\tVersion: ver,\r\n    89\tCreated: parts[4],\r\n    90\tTags:    []string{},"]
