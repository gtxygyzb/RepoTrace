[9177.860569, "o", "   135\tif i == 0 {\r\n   136\toutputDim = int(weights.NumOutputs)\r\n   137\t} else if int(weights.NumOutputs) != outputDim {\r\n   138\tfmt.Println(\"output dimension mismatch\")\r\n   139\tos.Exit(1)\r\n   140\t}\r\n   141\t}\r\n   142\t\r\n   143\tpath := filepath.Join(ensemblesDir, name+\".json\")\r\n   144\tif _, err := os.Stat(path); err == nil {\r\n   145\tfmt.Println(\"ensemble already exists\")\r\n   146\tos.Exit(1)\r\n   147\t}\r\n   148\t\r\n   149\tcfg := ensembleConfig{\r\n   150\tName:     name,\r\n"]
