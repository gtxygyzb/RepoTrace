[12648.891814, "o", "\u001b[35m\u001b[Kvalidate_input.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc validateInputFile(modelName, inputFile string, weights *\u001b[01;31m\u001b[KWeights\u001b[m\u001b[KData) *validationSummary {\r\n\u001b[35m\u001b[Kvalidate_input.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\texpected := int(weights.Num\u001b[01;31m\u001b[KFeatures\u001b[m\u001b[K)\r\n\u001b[35m\u001b[Kvalidate_input.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tExpected\u001b[01;31m\u001b[KFeatures\u001b[m\u001b[K: expected,\r\n\u001b[35m\u001b[Kvalidate_input.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Printf(\"Validating input for model '%s' (%d features expected)\\n\", summary.ModelName, summary.Expected\u001b[01;31m\u001b[KFeatures\u001b[m\u001b[K)\r\n\u001b[35m\u001b[Kvalidate_input.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tweights, err := load\u001b[01;31m\u001b[KWeights\u001b[m\u001b[K(entry.Path)\r\n"]
[12648.891883, "o", "\u001b[35m\u001b[Kvalidate_input.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfeatureNames := schemaFeatureNames(meta, cfg, int(weights.Num\u001b[01;31m\u001b[KFeatures\u001b[m\u001b[K))\r\n\u001b[35m\u001b[Kvalidate_input.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K167\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Printf(\"Input features: %d\\n\", int(weights.Num\u001b[01;31m\u001b[KFeatures\u001b[m\u001b[K))\r\n\u001b[35m\u001b[Kvalidate_input.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K171\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Printf(\"Output: %d values\\n\", int(weights.Num\u001b[01;31m\u001b[KOutputs\u001b[m\u001b[K))\r\n\u001b[35m\u001b[Kvalidate_input.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Printf(\"\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K: %s\\n\", activationIDToName(weights.\u001b[01;31m\u001b[KActivation\u001b[m\u001b[K))\r\n"]
