[5932.864213, "o", "   159\t\t\t\tidx:     j,\r\n   160\t\t\t\tname:    headers[j],\r\n   161\t\t\t\tcount:   count,\r\n   162\t\t\t\tmissing: missing,\r\n   163\t\t\t\tmin:     math.NaN(),\r\n   164\t\t\t\tmax:     math.NaN(),\r\n   165\t\t\t\tmean:    math.NaN(),\r\n   166\t\t\t\tstddev:  math.NaN(),\r\n   167\t\t\t\tvalues:  values,\r\n   168"]
