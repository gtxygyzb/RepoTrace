[11340.112631, "o", "    63\t\tcase \"rollback\":\r\n    64\t\t\tcmdRollback(args)\r\n    65\t\tcase \"migrate\":\r\n    66\t\t\tcmdMigrate(args)\r\n    67\t\tcase \"compat\":\r\n    68\t\t\tcmdCompat(args)\r\n    69\t\tcase \"version\":\r\n    70\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n"]
[11340.112688, "o", "    71\t\tcase \"help\":\r\n    72\t\t\tprintUsage()\r\n    73\t\tdefault:\r\n    74\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    75\t\t\tprintUsage()\r\n    76\t\t\tos.Exit(1)\r\n    77\t\t}\r\n    78\t}\r\n    79\t\r\n"]
[11340.112751, "o", "    80\tfunc printUsage() {\r\n    81\t\tusage := `mlpipe - ML Inference Pipeline Manager\r\n    82\t\r\n    83\tUsage: mlpipe <command> [arguments]\r\n    84\t\r\n    85\tCommands:\r\n    86\t  list                          List all registered models\r\n    87\t  info <model>                  Show model details\r\n    88\t  register <name> <path>        Register a model from directory\r\n    89\t"]
[11340.11282, "o", "  remove <name>                 Remove a model from registry\r\n    90\t  run <model> [options]         Run inference\r\n    91\t  stats --input <file>          Input statistics profiling\r\n    92\t  diff <model1> <model2> --input <file>\r\n    93\t                                Compare two models on same input\r\n    94\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n    95\t                                Batch inference over CSV files\r\n    96\t  validate <model>              Validate model integrity\r\n    97\t  validate-input <model> --input <file>\r\n    98"]
[11340.112887, "o", "\t                                Validate input data for a model\r\n    99\t  schema <model>                Display expected input schema for a model\r\n   100\t  export <model> --output <file> Export model to JSON file\r\n   101\t  import <path> [--name <name>] Import model from JSON file\r\n   102\t  clone <model> <new_name>      Clone model to new name\r\n   103\t    profile <model>               Report model weight analysis\r\n   104\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n   105\t  compat [--all]                 Check migration compatibility\r\n   106\t  version                       Show version\r\n   107\t  help                          Show this help\r\n   108"]
[11340.112948, "o", "\t\r\n   109\tRun/Diff Options:\r\n   110\t  --input <file>    Input CSV file (required)\r\n   111\t  --output <file>   Output file (default: stdout)\r\n   112\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   113\t  --strict          Validate input before inference and abort on invalid rows\r\n   114\t\r\n   115\tBatch Options:\r\n   116\t  --dir <dir>       Input directory of CSV files\r\n   117\t  --output-dir <dir> Output directory for predictions\r\n"]
[11340.113017, "o", "   118\t  --format <fmt>    Output format: csv or json (default: csv)\r\n   119\t`\r\n   120\t\tfmt.Print(usage)\r\n"]
