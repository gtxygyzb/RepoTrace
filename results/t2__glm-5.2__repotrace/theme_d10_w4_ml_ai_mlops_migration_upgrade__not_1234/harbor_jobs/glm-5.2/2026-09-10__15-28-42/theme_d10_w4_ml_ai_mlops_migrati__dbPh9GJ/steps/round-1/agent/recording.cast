[3258.625159, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"os\"\r\n     6\t\t\"strings\"\r\n     7\t)\r\n     8\t\r\n     9\tconst version = \"0.1.0\"\r\n    10\t\r\n    11\t"]
[3258.62521, "o", "func main() {\r\n    12\t\tif len(os.Args) < 2 {\r\n    13\t\t\tprintUsage()\r\n    14\t\t\tos.Exit(1)\r\n    15\t\t}\r\n    16\t\r\n    17\t\tcommand := os.Args[1]\r\n    18\t\targs := os.Args[2:]"]
[3258.625308, "o", "\r\n    19\t\r\n    20\t\tswitch command {\r\n    21\t\tcase \"list\":\r\n    22\t\t\tcmdList(args)\r\n    23\t\tcase \"info\":\r\n    24\t\t\tcmdInfo(args)\r\n    25\t\tcase \"register\":\r\n    26\t\t\tcmdRegister(args)\r\n    27\t\tcase \"remove\":\r\n    28\t\t\tcmdRemove(args)\r\n    29\t\tcase \"run\":\r\n    30\t\t\tcmdRun(args)\r\n    31\t\tcase \"stats\":\r\n"]
[3258.625324, "o", "    32\t\t\tcmdStats(args)\r\n    33\t\tcase \"diff\":\r\n    34\t\t"]
[3258.625408, "o", "\tcmdDiff(args)\r\n    35\t\tcase \"batch\":\r\n    36\t\t\tcmdBatch(args)\r\n    37\t\tcase \"validate\":\r\n    38\t\t\tcmdValidate(args)\r\n    39\t\tcase \"export\":\r\n    40\t\t\tcmdExport(args)\r\n    41\t\tcase \"migrate\":\r\n    42\t\t\tcmdMigrate(args)\r\n    43\t\tcase \"compat\":\r\n    44\t\t\tcmdCompat(args)\r\n"]
[3258.625422, "o", "    45\t\tcase \"version\":\r\n"]
[3258.625495, "o", "    46\t\t\tfmt.Printf(\"mlpipe version %s\\n\", version)\r\n    47\t\tcase \"help\":\r\n    48\t\t\tprintUsage()\r\n    49\t\tdefault:\r\n    50\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", command)\r\n    51\t\t\tprintUsage()\r\n    52\t\t\tos.Exit(1)\r\n    53\t\t}\r\n    54\t}\r\n    55\t\r\n    56\tfunc printUsage() {\r\n    57\t\t"]
[3258.625512, "o", "usage := `mlpipe - ML Inference Pipeline Manager\r\n    58\t\r\n    59\tUsage: mlpipe <command> [arguments]\r\n"]
[3258.625585, "o", "    60\t\r\n    61\tCommands:\r\n    62\t  list                          List all registered models\r\n    63\t  info <model>                  Show model details\r\n    64\t  register <name> <path>        Register a model from directory\r\n    65\t  remove <name>                 Remove a model from registry\r\n    66\t  run <model> [options]         Run inference\r\n    67\t  stats --input <file>          Input statistics profiling\r\n    68\t  diff <model1> <model2> --input <file>\r\n    69\t                                Compare two models on same input\r\n    70\t  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]\r\n    71\t                                Batch inference over CSV files\r\n"]
[3258.625601, "o", "    72\t  validate <model>              Validate model integrity\r\n    73\t  export <model> --output <dir> Export model to directory\r\n"]
[3258.625678, "o", "    74\t  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format\r\n    75\t  compat [--all]                 Check migration compatibility\r\n    76\t  version                       Show version\r\n    77\t  help                          Show this help\r\n    78\t\r\n    79\tRun/Diff Options:\r\n    80\t  --input <file>    Input CSV file (required)\r\n    81\t  --output <file>   Output file (default: stdout)\r\n    82\t  --format <fmt>    Output format: csv or json (default: csv)\r\n    83\t\r\n"]
[3258.625693, "o", "    84\tBatch Options:\r\n    85\t  --dir <dir>       Input directory of CSV files\r\n"]
[3258.625768, "o", "    86\t  --output-dir <dir> Output directory for predictions\r\n    87\t  --format <fmt>    Output format: csv or json (default: csv)\r\n    88\t`\r\n    89\t\tfmt.Print(usage)\r\n    90\t}\r\n    91\t\r\n    92\tfunc parseFlags(args []string) map[string]string {\r\n    93\t\tflags := make(map[string]string)\r\n    94\t\tfor i := 0; i < len(args); i++ {\r\n    95\t\t\tif strings.HasPrefix(args[i], \"--\") {\r\n    96\t\t\t\tkey := strings.TrimPrefix(args[i], \"--\")\r\n"]
[3258.625784, "o", "    97\t\t\t\tif i+1 < len(args) && !strings.HasPrefix(args[i+1], \"--\") {\r\n    98\t\t\t\t\tflags[key] = args[i+1]\r\n"]
[3258.625867, "o", "    99\t\t\t\t\ti++\r\n   100\t\t\t\t} else {\r\n   101\t\t\t\t\tflags[key] = \"true\"\r\n   102\t\t\t\t}\r\n   103\t\t\t}\r\n   104\t\t}\r\n   105\t\treturn flags\r\n   106\t}\r\n"]
