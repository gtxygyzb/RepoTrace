[11541.41598, "o", "\u001b[?2004h> "]
[11541.416234, "o", "old = '\\tcase \"profile\":\\n\\t\\tcmdProfile(args)\\n'\r\n\u001b[?2004l\r"]
[11541.416306, "o", "\u001b[?2004h"]
[11541.416389, "o", "> "]
