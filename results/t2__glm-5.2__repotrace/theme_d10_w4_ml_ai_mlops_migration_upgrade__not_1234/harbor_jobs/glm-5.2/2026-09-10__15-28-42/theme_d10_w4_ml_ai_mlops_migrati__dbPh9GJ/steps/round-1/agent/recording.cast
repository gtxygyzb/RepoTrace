[12674.559071, "o", "    83\t\t\tdefer f.Close()\r\n    84\t\t\twriteOutput(f, results, outputFormat)\r\n    85\t\t} else {\r\n    86\t\t\twriteOutput(os.Stdout, results, outputFormat)\r\n    87\t\t}\r\n"]
[12674.559128, "o", "    88\t}\r\n    89\t\r\n    90\tfunc readInputCSV(path string) ([][]float64, error) {\r\n    91\t\tf, err := os.Open(path)\r\n    92\t\tif err != nil {\r\n    93\t\t\treturn nil, err\r\n    94\t\t}\r\n    95\t\tdefer f.Close()\r\n    96\t\r\n    97\t\treader := csv.NewReader(f)\r\n    98\t\trecords, err := reader.ReadAll()\r\n    99\t\tif err != nil {\r\n   100\t\t\treturn nil, err\r\n   101\t\t"]
[12674.559191, "o", "}\r\n   102\t\r\n   103\t\tvar data [][]float64\r\n   104\t\tfor i, record := range records {\r\n   105\t\t\tif i == 0 && isHeader(record) {\r\n   106\t\t\t\tcontinue\r\n   107\t\t\t}\r\n   108\t\t\trow := make([]float64, len(record))\r\n   109\t\t\tfor j, val := range record {\r\n"]
[12674.559251, "o", "   110\t\t\t\tval = strings.TrimSpace(val)\r\n   111\t\t\t\tif val == \"\" || val == \"NA\" || val == \"nan\" {\r\n   112\t\t\t\t\trow[j] = math.NaN()\r\n   113\t\t\t\t} else {\r\n   114\t\t\t\t\trow[j], err = strconv.ParseFloat(val, 64)\r\n   115\t\t\t\t\tif err != nil {\r\n   116"]
[12674.559314, "o", "\t\t\t\t\t\treturn nil, fmt.Errorf(\"row %d col %d: %v\", i, j, err)\r\n   117\t\t\t\t\t}\r\n   118\t\t\t\t}\r\n   119\t\t\t}\r\n   120\t\t\tdata = append(data, row)\r\n   121\t\t}\r\n   122\t\treturn data, nil\r\n   123\t}\r\n"]
[12674.559371, "o", "   124\t\r\n   125\tfunc isHeader(record []string) bool {\r\n   126\t\tfor _, val := range record {\r\n   127\t\t\t_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)\r\n   128\t\t\tif err == nil {\r\n   129\t\t\t\treturn false\r\n   130\t\t\t}\r\n   131\t\t}\r\n"]
[12674.55944, "o", "   132\t\treturn true\r\n   133\t}\r\n   134\t\r\n   135\tfunc runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n   136\t\treturn postprocess(runInferenceRaw(inputs, weights, cfg), cfg)\r\n   137\t}\r\n"]
[12674.559503, "o", "   138\t\r\n   139\tfunc runInferenceRaw(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {\r\n   140\t\tprocessed := preprocess(inputs, cfg)\r\n   141\t\r\n   142\t\tresults := make([][]float64, len(processed))\r\n   143\t\tfor i, row := range processed {\r\n   144\t\t\toutput := make([]float64, weights.NumOutputs)\r\n   145\t\t\tfor o := uint32(0); o < weights.NumOutputs; o++ {\r\n   146\t\t\t\tsum := weights.Bias[o]\r\n   147\t\t\t\tfor f := uint32(0); f < weights.NumFeatures; f++ {\r\n   148\t\t\t\t\tif int(f) < len(row) {\r\n   149\t\t\t\t\t\tsum += row[f] * weights.Weights[o*weights.NumFeatures+f]\r\n"]
[12674.559565, "o", "   150\t\t\t\t\t}\r\n   151\t\t\t\t}\r\n   152\t\t\t\toutput[o] = applyActivation(sum, weights.Activation)\r\n   153\t\t\t}\r\n   154\t\t\tresults[i] = output\r\n   155\t\t}\r\n   156\t\r\n   157\t\treturn results\r\n   158\t}\r\n   159\t\r\n"]
[12674.559632, "o", "   160\tfunc preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {\r\n   161\t\tresult := make([][]float64, len(inputs))\r\n   162\t\tfor i, row := range inputs {\r\n   163\t\t\tresult[i] = make([]float64, len(row))\r\n   164\t\t\tcopy(result[i], row)\r\n   165\t\t}\r\n"]
[12674.559691, "o", "   166\t\r\n   167\t\tif len(result) == 0 {\r\n   168\t\t\treturn result\r\n   169\t\t}\r\n   170\t\r\n   171\t\tfor i, row := range result {\r\n   172\t\t\tfor j, val := range row {\r\n   173\t\t\t\tif math.IsNaN(val) {\r\n   174\t\t\t\t\tswitch cfg.MissingStrategy {\r\n   175\t\t\t\t\tcase \"zero\":\r\n   176\t\t\t\t\t\tresult[i][j] = 0.0\r\n   177\t\t\t\t\tcase \"mean\":\r\n"]
[12674.559747, "o", "   178\t\t\t\t\t\tresult[i][j] = computeColumnMean(inputs, j)\r\n   179\t\t\t\t\t}\r\n   180\t\t\t\t}\r\n"]
