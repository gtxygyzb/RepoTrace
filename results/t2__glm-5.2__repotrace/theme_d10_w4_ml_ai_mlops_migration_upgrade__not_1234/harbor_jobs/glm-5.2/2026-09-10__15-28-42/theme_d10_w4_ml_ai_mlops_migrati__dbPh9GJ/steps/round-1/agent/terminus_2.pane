func cmdEnsemble(args []string) {
if len(args) < 1 {
fmt.Fprintf(os.Stderr, "usage: mlpipe ensemble <create|list|run|remove> [arguments]\n")
os.Exit(1)
}

sub := args[0]
rest := args[1:]
switch sub {
case "create":
cmdEnsembleCreate(rest)
case "list":
cmdEnsembleList(rest)
case "run":
cmdEnsembleRun(rest)
case "remove":
cmdEnsembleRemove(rest)
default:
fmt.Fprintf(os.Stderr, "unknown ensemble command: %s\n", sub)
os.Exit(1)
}
}

func cmdEnsembleCreate(args []string) {
flags := parseFlags(args)

if len(args) < 1 || strings.HasPrefix(args[0], "--") {
fmt.Fprintf(os.Stderr, "usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]\n")
os.Exit(1)
}
name := args[0]

modelsStr := flags["models"]
if modelsStr == "" || modelsStr == "true" {
fmt.Fprintf(os.Stderr, "usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]\n")
os.Exit(1)
}

strategy := flags["strategy"]
if strategy == "" || strategy == "true" {
strategy = "average"
}
if strategy != "average" && strategy != "max" && strategy != "min" {
fmt.Fprintf(os.Stderr, "error: invalid strategy '%s', use average, max, or min\n", strategy)
os.Exit(1)
}

var models []string
for _, m := range strings.Split(modelsStr, ",") {
m = strings.TrimSpace(m)
if m != "" {
models = append(models, m)
}
}
if len(models) == 0 {
fmt.Fprintf(os.Stderr, "error: at least one model is required\n")
os.Exit(1)
}

entries, err := loadRegistry()
if err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}

for _, m := range models {
if findEntry(entries, m) == nil {
fmt.Printf("model not found: %s\n", m)
os.Exit(1)
}
}

var outputDim int
for i, m := range models {
entry := findEntry(entries, m)
weights, err := loadWeights(entry.Path)
if err != nil {
fmt.Fprintf(os.Stderr, "error loading weights for model '%s': %v\n", m, err)
os.Exit(1)
}
if i == 0 {
outputDim = int(weights.NumOutputs)
} else if int(weights.NumOutputs) != outputDim {
fmt.Println("output dimension mismatch")
os.Exit(1)
}
}

path := filepath.Join(ensemblesDir, name+".json")
if _, err := os.Stat(path); err == nil {
fmt.Println("ensemble already exists")
os.Exit(1)
}

cfg := ensembleConfig{
Name:     name,
Models:   models,
Strategy: strategy,
}
if err := saveEnsembleConfig(&cfg); err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}

fmt.Printf("ensemble '%s' created with %d models (strategy=%s)\n", name, len(models), strategy)
}

func cmdEnsembleList(args []string) {
configs, err := listEnsembleConfigs()
if err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
