    10	
    11	func main() {
    12		if len(os.Args) < 2 {
    13			printUsage()
    14			os.Exit(1)
    15		}
    16	
    17		command := os.Args[1]
    18		args := os.Args[2:]
    19	
    20		switch command {
    21		case "list":
    22			cmdList(args)
    23		case "info":
    24			cmdInfo(args)
    25		case "register":
    26			cmdRegister(args)
    27		case "remove":
    28			cmdRemove(args)
    29		case "run":
    30			cmdRun(args)
    31		case "validate":
    32			cmdValidate(args)
    33		case "export":
    34			cmdExport(args)
    35		case "version":
    36			fmt.Printf("mlpipe version %s\n", version)
    37		case "help":
    38			printUsage()
    39		default:
    40			fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
    41			printUsage()
    42			os.Exit(1)
    43		}
    44	}
    45	
    46	func printUsage() {
    47		usage := `mlpipe - ML Inference Pipeline Manager
    48	
    49	Usage: mlpipe <command> [arguments]
    50	
    51	Commands:
    52	  list                          List all registered models
    53	  info <model>                  Show model details
    54	  register <name> <path>        Register a model from directory
    55	  remove <name>                 Remove a model from registry
    56	  run <model> [options]         Run inference
    57	  validate <model>              Validate model integrity
    58	  export <model> --output <dir> Export model to directory
    59	  version                       Show version
    60	  help                          Show this help
    61	
    62	Run Options:
    63	  --input <file>    Input CSV file (required)
    64	  --output <file>   Output file (default: stdout)
    65	  --format <fmt>    Output format: csv or json (default: csv)
    66	`
    67		fmt.Print(usage)
    68	}
    69	
    70	func parseFlags(args []string) map[string]string {
    71		flags := make(map[string]string)
    72		for i := 0; i < len(args); i++ {
    73			if strings.HasPrefix(args[i], "--") {
    74				key := strings.TrimPrefix(args[i], "--")
    75				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
    76					flags[key] = args[i+1]
    77					i++
    78				} else {
    79					flags[key] = "true"
    80				}
    81			}
    82		}
    83		return flags
    84	}
