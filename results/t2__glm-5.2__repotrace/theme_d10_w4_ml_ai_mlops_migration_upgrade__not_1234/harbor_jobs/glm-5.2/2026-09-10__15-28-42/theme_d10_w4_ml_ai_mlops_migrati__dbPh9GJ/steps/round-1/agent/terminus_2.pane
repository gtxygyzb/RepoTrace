[?2004lpackage main

import (
	"fmt"
	"os"
	"strings"
)

const version = "0.1.0"

func main() {
	if len(os.Args) < 2 {
		printUsage()
		os.Exit(1)
	}

	command := os.Args[1]
	args := os.Args[2:]

	switch command {
	case "list":
		cmdList(args)
	case "info":
		cmdInfo(args)
	case "register":
		cmdRegister(args)
	case "remove":
		cmdRemove(args)
	case "tag":
		cmdTag(args)
	case "untag":
		cmdUntag(args)
	case "search":
		cmdSearch(args)
	case "run":
		cmdRun(args)
	case "stats":
		cmdStats(args)
	case "diff":
		cmdDiff(args)
	case "batch":
		cmdBatch(args)
	case "validate":
		cmdValidate(args)
	case "export":
		cmdExport(args)
	case "import":
		cmdImport(args)
	case "clone":
		cmdClone(args)
	case "migrate":
		cmdMigrate(args)
	case "compat":
		cmdCompat(args)
	case "version":
		fmt.Printf("mlpipe version %s\n", version)
	case "help":
		printUsage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
		printUsage()
		os.Exit(1)
	}
}

func printUsage() {
	usage := `mlpipe - ML Inference Pipeline Manager

Usage: mlpipe <command> [arguments]

Commands:
  list                          List all registered models
  info <model>                  Show model details
  register <name> <path>        Register a model from directory
  remove <name>                 Remove a model from registry
  run <model> [options]         Run inference
  stats --input <file>          Input statistics profiling
  diff <model1> <model2> --input <file>
                                Compare two models on same input
  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
                                Batch inference over CSV files
  validate <model>              Validate model integrity
  export <model> --output <file> Export model to JSON file
  import <path> [--name <name>] Import model from JSON file
  clone <model> <new_name>      Clone model to new name
  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
  compat [--all]                 Check migration compatibility
  version                       Show version
  help                          Show this help

Run/Diff Options:
  --input <file>    Input CSV file (required)
  --output <file>   Output file (default: stdout)
  --format <fmt>    Output format: csv or json (default: csv)

Batch Options:
  --dir <dir>       Input directory of CSV files
  --output-dir <dir> Output directory for predictions
  --format <fmt>    Output format: csv or json (default: csv)
`
	fmt.Print(usage)
}

func parseFlags(args []string) map[string]string {
	flags := make(map[string]string)
	for i := 0; i < len(args); i++ {
		if strings.HasPrefix(args[i], "--") {
			key := strings.TrimPrefix(args[i], "--")
			if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
				flags[key] = args[i+1]
				i++
			} else {
				flags[key] = "true"
			}
		}
	}
	return flags
}
[?2004hroot@n30009:/app# sed -n '1,260p' registry.go
[?2004lpackage main

import (
"bufio"
"encoding/json"
"fmt"
"os"
"path/filepath"
"sort"
"strings"
"time"
)

const (
registryFile     = "/app/models/registry.idx"
registryJSONFile = "/app/models/registry.json"
)

type RegistryEntry struct {
Name    string   `json:"name"`
Path    string   `json:"path"`
Type    string   `json:"type"`
Version int      `json:"version"`
Created string   `json:"created"`
Tags    []string `json:"tags"`
}

func loadRegistry() ([]RegistryEntry, error) {
data, err := os.ReadFile(registryJSONFile)
if err == nil {
if len(strings.TrimSpace(string(data))) == 0 {
return nil, nil
}
var entries []RegistryEntry
if err := json.Unmarshal(data, &entries); err != nil {
return nil, fmt.Errorf("parse registry.json: %w", err)
}
for i := range entries {
entries[i].Tags = ensureTags(entries[i].Tags)
}
return entries, nil
}
if !os.IsNotExist(err) {
return nil, err
}

if _, err := os.Stat(registryFile); err == nil {
entries, err := loadOldRegistry()
if err != nil {
return nil, err
}
if err := saveRegistry(entries); err != nil {
return nil, err
}
return entries, nil
}

return nil, nil
}

func loadOldRegistry() ([]RegistryEntry, error) {
f, err := os.Open(registryFile)
if err != nil {
if os.IsNotExist(err) {
return nil, nil
}
return nil, err
}
defer f.Close()

var entries []RegistryEntry
scanner := bufio.NewScanner(f)
for scanner.Scan() {
line := strings.TrimSpace(scanner.Text())
if line == "" || strings.HasPrefix(line, "#") {
continue
}
parts := strings.Split(line, "|")
if len(parts) != 5 {
continue
}
ver := 1
fmt.Sscanf(parts[3], "%d", &ver)
entries = append(entries, RegistryEntry{
Name:    parts[0],
Path:    parts[1],
Type:    parts[2],
Version: ver,
Created: parts[4],
Tags:    []string{},
})
}
return entries, scanner.Err()
}

func saveRegistry(entries []RegistryEntry) error {
dir := filepath.Dir(registryJSONFile)
if err := os.MkdirAll(dir, 0755); err != nil {
return err
}

out := make([]RegistryEntry, len(entries))
for i, e := range entries {
e.Tags = ensureTags(e.Tags)
out[i] = e
}

data, err := json.MarshalIndent(out, "", "  ")
if err != nil {
return err
}
return os.WriteFile(registryJSONFile, data, 0644)
}

func ensureTags(tags []string) []string {
if tags == nil {
return []string{}
}
return tags
}

func findEntry(entries []RegistryEntry, name string) *RegistryEntry {
for i := range entries {
if entries[i].Name == name {
return &entries[i]
}
}
return nil
}

func cmdList(args []string) {
entries, err := loadRegistry()
if err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}
if len(entries) == 0 {
fmt.Println("No models registered.")
return
}

sort.Slice(entries, func(i, j int) bool {
return entries[i].Name < entries[j].Name
})

for _, e := range entries {
tags := append([]string(nil), e.Tags...)
sort.Strings(tags)
if len(tags) > 0 {
fmt.Printf("%s (%s)\n", e.Name, strings.Join(tags, ", "))
} else {
fmt.Println(e.Name)
}
}
}

func cmdInfo(args []string) {
if len(args) < 1 {
fmt.Fprintf(os.Stderr, "usage: mlpipe info <model>\n")
os.Exit(1)
}
name := args[0]
entries, err := loadRegistry()
if err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}
entry := findEntry(entries, name)
if entry == nil {
fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
os.Exit(1)
}
if !modelDirExists(entry.Path) {
fmt.Fprintf(os.Stderr, "error: model directory not found\n")
os.Exit(1)
}

meta, err := loadModelMeta(entry.Path)
if err != nil {
fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
os.Exit(1)
}

weights, err := loadWeights(entry.Path)
if err != nil {
fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
os.Exit(1)
}

fmt.Printf("Name:        %s\n", meta["name"])
fmt.Printf("Type:        %s\n", meta["type"])
fmt.Printf("Version:     %s\n", meta["version"])
fmt.Printf("Created:     %s\n", meta["created"])
fmt.Printf("Description: %s\n", meta["description"])
fmt.Printf("Features:    %s\n", meta["features"])
fmt.Printf("Outputs:     %s\n", meta["outputs"])
fmt.Printf("Format:     v%d\n", weights.Version)
fmt.Printf("Activation: %s\n", activationIDToName(weights.Activation))
fmt.Printf("Path:        %s\n", entry.Path)
}

func cmdRegister(args []string) {
if len(args) < 2 {
fmt.Fprintf(os.Stderr, "usage: mlpipe register <name> <path>\n")
os.Exit(1)
}
name := args[0]
modelPath := args[1]

absPath, err := filepath.Abs(modelPath)
if err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}

if _, err := os.Stat(filepath.Join(absPath, "model.meta")); err != nil {
fmt.Fprintf(os.Stderr, "error: no model.meta found at %s\n", absPath)
os.Exit(1)
}

meta, err := loadModelMeta(absPath)
if err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}

entries, err := loadRegistry()
if err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}

if findEntry(entries, name) != nil {
fmt.Fprintf(os.Stderr, "error: model '%s' already registered\n", name)
os.Exit(1)
}

modelType := meta["type"]
if modelType == "" {
modelType = "unknown"
}

entries = append(entries, RegistryEntry{
Name:    name,
Path:    absPath,
Type:    modelType,
Version: 1,
Created: time.Now().Format("2006-01-02"),
Tags:    []string{},
})

if err := saveRegistry(entries); err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}
fmt.Printf("Model '%s' registered successfully.\n", name)
}

func cmdRemove(args []string) {
if len(args) < 1 {
