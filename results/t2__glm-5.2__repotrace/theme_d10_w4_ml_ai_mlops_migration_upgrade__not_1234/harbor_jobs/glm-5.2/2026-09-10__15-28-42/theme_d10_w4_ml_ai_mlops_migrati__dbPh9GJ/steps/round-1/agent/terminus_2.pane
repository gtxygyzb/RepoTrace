[?2004l     1	package main
     2	
     3	import (
     4		"bufio"
     5		"encoding/binary"
     6		"fmt"
     7		"math"
     8		"os"
     9		"path/filepath"
    10		"sort"
    11		"strconv"
    12		"strings"
