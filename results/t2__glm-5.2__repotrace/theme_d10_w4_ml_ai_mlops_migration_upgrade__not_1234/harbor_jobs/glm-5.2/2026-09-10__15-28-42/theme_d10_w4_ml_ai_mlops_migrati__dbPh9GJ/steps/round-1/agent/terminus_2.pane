   347	func listEnsembleConfigs() ([]*ensembleConfig, error) {
   348		files, err := os.ReadDir(ensemblesDir)
   349		if err != nil {
   350			if os.IsNotExist(err) {
   351				return nil, nil
   352			}
   353			return nil, err
   354		}
   355		var configs []*ensembleConfig
   356		for _, file := range files {
   357			if file.IsDir() || !strings.HasSuffix(file.Name(), ".json") {
   358				continue
   359			}
   360			data, err := os.ReadFile(filepath.Join(ensemblesDir, file.Name()))
   361			if err != nil {
   362				return nil, err
   363			}
   364			var cfg ensembleConfig
   365			if err := json.Unmarshal(data, &cfg); err != nil {
   366				return nil, err
   367			}
   368			configs = append(configs, &cfg)
   369		}
   370		sort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })
   371		return configs, nil
   372	}
