[?2004l     1	package main
     2	
     3	import (
     4		"bufio"
     5		"fmt"
     6		"os"
     7		"path/filepath"
     8		"strings"
     9		"time"
    10	)
    11	
    12	const registryFile = "/app/models/registry.idx"
    13	
    14	type RegistryEntry struct {
    15		Name    string
    16		Path    string
    17		Type    string
    18		Version int
    19		Created string
    20	}
    21	
    22	func loadRegistry() ([]RegistryEntry, error) {
    23		f, err := os.Open(registryFile)
    24		if err != nil {
    25			if os.IsNotExist(err) {
    26				return nil, nil
    27			}
    28			return nil, err
    29		}
    30		defer f.Close()
    31	
    32		var entries []RegistryEntry
    33		scanner := bufio.NewScanner(f)
    34		for scanner.Scan() {
    35			line := strings.TrimSpace(scanner.Text())
    36			if line == "" || strings.HasPrefix(line, "#") {
    37				continue
    38			}
    39			parts := strings.Split(line, "|")
    40			if len(parts) != 5 {
    41				continue
    42			}
    43			ver := 1
    44			fmt.Sscanf(parts[3], "%d", &ver)
    45			entries = append(entries, RegistryEntry{
    46				Name:    parts[0],
    47				Path:    parts[1],
    48				Type:    parts[2],
    49				Version: ver,
    50				Created: parts[4],
    51			})
    52		}
    53		return entries, scanner.Err()
    54	}
    55	
    56	func saveRegistry(entries []RegistryEntry) error {
    57		dir := filepath.Dir(registryFile)
    58		if err := os.MkdirAll(dir, 0755); err != nil {
    59			return err
    60		}
    61	
    62		f, err := os.Create(registryFile)
    63		if err != nil {
    64			return err
    65		}
    66		defer f.Close()
    67	
    68		fmt.Fprintln(f, "# mlpipe registry v1")
    69		for _, e := range entries {
    70			fmt.Fprintf(f, "%s|%s|%s|%d|%s\n", e.Name, e.Path, e.Type, e.Version, e.Created)
    71		}
    72		return nil
    73	}
    74	
    75	func findEntry(entries []RegistryEntry, name string) *RegistryEntry {
    76		for i := range entries {
    77			if entries[i].Name == name {
    78				return &entries[i]
    79			}
    80		}
    81		return nil
    82	}
    83	
    84	func cmdList(args []string) {
    85		entries, err := loadRegistry()
    86		if err != nil {
    87			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    88			os.Exit(1)
    89		}
    90		if len(entries) == 0 {
    91			fmt.Println("No models registered.")
    92			return
    93		}
    94		fmt.Printf("%-20s %-10s %-8s %s\n", "NAME", "TYPE", "VERSION", "CREATED")
    95		for _, e := range entries {
    96			fmt.Printf("%-20s %-10s %-8d %s\n", e.Name, e.Type, e.Version, e.Created)
    97		}
    98	}
    99	
   100	func cmdInfo(args []string) {
   101		if len(args) < 1 {
   102			fmt.Fprintf(os.Stderr, "usage: mlpipe info <model>\n")
   103			os.Exit(1)
   104		}
   105		name := args[0]
   106		entries, err := loadRegistry()
   107		if err != nil {
   108			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   109			os.Exit(1)
   110		}
   111		entry := findEntry(entries, name)
   112		if entry == nil {
   113			fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
   114			os.Exit(1)
   115		}
   116		if !modelDirExists(entry.Path) {
   117			fmt.Fprintf(os.Stderr, "error: model directory not found\n")
   118			os.Exit(1)
   119		}
   120	
   121		meta, err := loadModelMeta(entry.Path)
   122		if err != nil {
   123			fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
   124			os.Exit(1)
   125		}
   126	
   127		fmt.Printf("Name:        %s\n", meta["name"])
   128		fmt.Printf("Type:        %s\n", meta["type"])
   129		fmt.Printf("Version:     %s\n", meta["version"])
   130		fmt.Printf("Created:     %s\n", meta["created"])
   131		fmt.Printf("Description: %s\n", meta["description"])
   132		fmt.Printf("Features:    %s\n", meta["features"])
   133		fmt.Printf("Outputs:     %s\n", meta["outputs"])
   134		fmt.Printf("Path:        %s\n", entry.Path)
   135	}
   136	
   137	func cmdRegister(args []string) {
   138		if len(args) < 2 {
   139			fmt.Fprintf(os.Stderr, "usage: mlpipe register <name> <path>\n")
   140			os.Exit(1)
   141		}
   142		name := args[0]
   143		modelPath := args[1]
   144	
   145		absPath, err := filepath.Abs(modelPath)
   146		if err != nil {
   147			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   148			os.Exit(1)
   149		}
   150	
   151		if _, err := os.Stat(filepath.Join(absPath, "model.meta")); err != nil {
   152			fmt.Fprintf(os.Stderr, "error: no model.meta found at %s\n", absPath)
   153			os.Exit(1)
   154		}
   155	
   156		meta, err := loadModelMeta(absPath)
   157		if err != nil {
   158			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   159			os.Exit(1)
   160		}
   161	
   162		entries, err := loadRegistry()
   163		if err != nil {
   164			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   165			os.Exit(1)
   166		}
   167	
   168		if findEntry(entries, name) != nil {
   169			fmt.Fprintf(os.Stderr, "error: model '%s' already registered\n", name)
   170			os.Exit(1)
   171		}
   172	
   173		modelType := meta["type"]
   174		if modelType == "" {
   175			modelType = "unknown"
   176		}
   177	
   178		entries = append(entries, RegistryEntry{
   179			Name:    name,
   180			Path:    absPath,
   181			Type:    modelType,
   182			Version: 1,
   183			Created: time.Now().Format("2006-01-02"),
   184		})
   185	
   186		if err := saveRegistry(entries); err != nil {
   187			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   188			os.Exit(1)
   189		}
   190		fmt.Printf("Model '%s' registered successfully.\n", name)
   191	}
   192	
   193	func cmdRemove(args []string) {
   194		if len(args) < 1 {
   195			fmt.Fprintf(os.Stderr, "usage: mlpipe remove <name>\n")
   196			os.Exit(1)
   197		}
   198		name := args[0]
   199	
   200		entries, err := loadRegistry()
   201		if err != nil {
   202			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   203			os.Exit(1)
   204		}
   205	
   206		found := false
   207		var newEntries []RegistryEntry
   208		for _, e := range entries {
   209			if e.Name == name {
   210				found = true
   211			} else {
   212				newEntries = append(newEntries, e)
   213			}
   214		}
   215	
   216		if !found {
   217			fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
   218			os.Exit(1)
   219		}
   220	
   221		if err := saveRegistry(newEntries); err != nil {
   222			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   223			os.Exit(1)
   224		}
   225		fmt.Printf("Model '%s' removed.\n", name)
   226	}
