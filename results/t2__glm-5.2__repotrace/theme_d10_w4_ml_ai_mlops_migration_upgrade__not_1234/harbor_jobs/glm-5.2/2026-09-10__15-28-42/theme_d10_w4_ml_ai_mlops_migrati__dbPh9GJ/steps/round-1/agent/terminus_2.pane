   164	func cmdEnsembleList(args []string) {
   165	configs, err := listEnsembleConfigs()
   166	if err != nil {
   167	fmt.Fprintf(os.Stderr, "error: %v\n", err)
   168	os.Exit(1)
   169	}
   170	if len(configs) == 0 {
   171	fmt.Println("no ensembles")
   172	return
   173	}
   174	sort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })
   175	for _, cfg := range configs {
   176	fmt.Printf("%s  %s  %d models\n", cfg.Name, cfg.Strategy, len(cfg.Models))
   177	}
   178	}
