   311	func combineEnsembleOutputs(allOutputs [][][]float64, strategy string) [][]float64 {
   312	numRows := len(allOutputs[0])
   313	numOutputs := len(allOutputs[0][0])
   314	combined := make([][]float64, numRows)
   315	for i := 0; i < numRows; i++ {
   316	combined[i] = make([]float64, numOutputs)
   317	for j := 0; j < numOutputs; j++ {
   318	vals := make([]float64, len(allOutputs))
   319	for k := range allOutputs {
   320	vals[k] = allOutputs[k][i][j]
   321	}
   322	switch strategy {
   323	case "max":
   324	combined[i][j] = maxFloat64(vals)
   325	case "min":
   326	combined[i][j] = minFloat64(vals)
   327	default:
   328	combined[i][j] = meanFloat64(vals)
   329	}
   330	}
   331	}
   332	return combined
   333	}
   334	
   335	func meanFloat64(vals []float64) float64 {
   336	if len(vals) == 0 {
   337	return 0
   338	}
   339	sum := 0.0
   340	for _, v := range vals {
   341	sum += v
   342	}
   343	return sum / float64(len(vals))
   344	}
   345	
   346	func maxFloat64(vals []float64) float64 {
   347	if len(vals) == 0 {
   348	return 0
   349	}
   350	m := vals[0]
   351	for _, v := range vals[1:] {
   352	if v > m {
   353	m = v
   354	}
   355	}
   356	return m
   357	}
   358	
   359	func minFloat64(vals []float64) float64 {
   360	if len(vals) == 0 {
   361	return 0
   362	}
   363	m := vals[0]
   364	for _, v := range vals[1:] {
   365	if v < m {
   366	m = v
   367	}
   368	}
   369	return m
   370	}
