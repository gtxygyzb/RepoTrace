   411	func copyDir(src, dst string) error {
   412		entries, err := os.ReadDir(src)
   413		if err != nil {
   414			return err
   415		}
   416		for _, entry := range entries {
   417			srcPath := filepath.Join(src, entry.Name())
   418			dstPath := filepath.Join(dst, entry.Name())
   419			if entry.IsDir() {
   420				if err := os.MkdirAll(dstPath, 0755); err != nil {
   421					return err
   422				}
   423				if err := copyDir(srcPath, dstPath); err != nil {
   424					return err
   425				}
   426			} else {
   427				data, err := os.ReadFile(srcPath)
   428				if err != nil {
   429					return err
   430				}
