    62			cmdCompat(args)
    63		case "version":
    64			fmt.Printf("mlpipe version %s\n", version)
    65		case "help":
    66			printUsage()
    67		default:
    68			fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
    69			printUsage()
    70			os.Exit(1)
    72	}
    73	
    74	func printUsage() {
    75		usage := `mlpipe - ML Inference Pipeline Manager
    76	
    77	Usage: mlpipe <command> [arguments]
    78	
    79	Commands:
    80	  list                          List all registered models
    81	  info <model>                  Show model details
    82	  register <name> <path>        Register a model from directory
    83	  remove <name>                 Remove a model from registry
    84	  run <model> [options]         Run inference
    85	  stats --input <file>          Input statistics profiling
    86	  diff <model1> <model2> --input <file>
    87	                                Compare two models on same input
    88	  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
    89	                                Batch inference over CSV files
    90	  validate <model>              Validate model integrity
    91	  export <model> --output <file> Export model to JSON file
    92	  import <path> [--name <name>] Import model from JSON file
    93	  clone <model> <new_name>      Clone model to new name
    94	  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
    95	  compat [--all]                 Check migration compatibility
    96	  version                       Show version
    97	  help                          Show this help
    98	
    99	Run/Diff Options:
   100	  --input <file>    Input CSV file (required)
   101	  --output <file>   Output file (default: stdout)
   102	  --format <fmt>    Output format: csv or json (default: csv)
   103	
   104	Batch Options:
   105	  --dir <dir>       Input directory of CSV files
   106	  --output-dir <dir> Output directory for predictions
   107	  --format <fmt>    Output format: csv or json (default: csv)
   108	`
   109		fmt.Print(usage)
   110	}
