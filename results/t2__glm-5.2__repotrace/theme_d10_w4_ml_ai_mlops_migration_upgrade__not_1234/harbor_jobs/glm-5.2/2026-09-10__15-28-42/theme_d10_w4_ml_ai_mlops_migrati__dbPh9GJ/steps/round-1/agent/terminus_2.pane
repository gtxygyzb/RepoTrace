   100	func cmdInfo(args []string) {
   101		if len(args) < 1 {
   102			fmt.Fprintf(os.Stderr, "usage: mlpipe info <model>\n")
   103			os.Exit(1)
   104		}
   105		name := args[0]
   106		entries, err := loadRegistry()
   107		if err != nil {
   108			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   109			os.Exit(1)
   110		}
   111		entry := findEntry(entries, name)
   112		if entry == nil {
   113			fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
   114			os.Exit(1)
   115		}
   116		if !modelDirExists(entry.Path) {
   117			fmt.Fprintf(os.Stderr, "error: model directory not found\n")
   118			os.Exit(1)
   119		}
   120	
   121		meta, err := loadModelMeta(entry.Path)
   122		if err != nil {
   123			fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
   124			os.Exit(1)
   125		}
   126	
   127		weights, err := loadWeights(entry.Path)
   128		if err != nil {
   129			fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
   130			os.Exit(1)
   131		}
   132	
   133		fmt.Printf("Name:        %s\n", meta["name"])
   134		fmt.Printf("Type:        %s\n", meta["type"])
   135		fmt.Printf("Version:     %s\n", meta["version"])
   136		fmt.Printf("Created:     %s\n", meta["created"])
   137		fmt.Printf("Description: %s\n", meta["description"])
   138		fmt.Printf("Features:    %s\n", meta["features"])
   139		fmt.Printf("Outputs:     %s\n", meta["outputs"])
   140		fmt.Printf("Format:     v%d\n", weights.Version)
   141		fmt.Printf("Activation: %s\n", activationIDToName(weights.Activation))
   142		fmt.Printf("Path:        %s\n", entry.Path)
   143	}
   144	
   145	func cmdRegister(args []string) {
   146		if len(args) < 2 {
   147			fmt.Fprintf(os.Stderr, "usage: mlpipe register <name> <path>\n")
   148			os.Exit(1)
   149		}
   150		name := args[0]
   151		modelPath := args[1]
   152	
   153		absPath, err := filepath.Abs(modelPath)
   154		if err != nil {
   155			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   156			os.Exit(1)
   157		}
   158	
   159		if _, err := os.Stat(filepath.Join(absPath, "model.meta")); err != nil {
   160			fmt.Fprintf(os.Stderr, "error: no model.meta found at %s\n", absPath)
   161			os.Exit(1)
   162		}
   163	
   164		meta, err := loadModelMeta(absPath)
   165		if err != nil {
   166			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   167			os.Exit(1)
   168		}
   169	
   170		entries, err := loadRegistry()
   171		if err != nil {
   172			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   173			os.Exit(1)
   174		}
   175	
   176		if findEntry(entries, name) != nil {
   177			fmt.Fprintf(os.Stderr, "error: model '%s' already registered\n", name)
   178			os.Exit(1)
   179		}
   180	
   181		modelType := meta["type"]
   182		if modelType == "" {
   183			modelType = "unknown"
   184		}
   185	
   186		entries = append(entries, RegistryEntry{
   187			Name:    name,
   188			Path:    absPath,
   189			Type:    modelType,
   190			Version: 1,
   191			Created: time.Now().Format("2006-01-02"),
   192		})
   193	
   194		if err := saveRegistry(entries); err != nil {
   195			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   196			os.Exit(1)
   197		}
   198		fmt.Printf("Model '%s' registered successfully.\n", name)
   199	}
   200	
   201	func cmdRemove(args []string) {
   202		if len(args) < 1 {
   203			fmt.Fprintf(os.Stderr, "usage: mlpipe remove <name>\n")
   204			os.Exit(1)
   205		}
   206		name := args[0]
   207	
   208		entries, err := loadRegistry()
   209		if err != nil {
   210			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   211			os.Exit(1)
   212		}
   213	
   214		found := false
   215		var newEntries []RegistryEntry
   216		for _, e := range entries {
   217			if e.Name == name {
   218				found = true
   219			} else {
   220				newEntries = append(newEntries, e)
   221			}
   222		}
   223	
   224		if !found {
   225			fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
   226			os.Exit(1)
   227		}
   228	
   229		if err := saveRegistry(newEntries); err != nil {
   230			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   231			os.Exit(1)
   232		}
   233		fmt.Printf("Model '%s' removed.\n", name)
   234	}
