import (
	"fmt"
	"os"
	"strings"
)

const version = "0.1.0"

func main() {
	if len(os.Args) < 2 {
		printUsage()
		os.Exit(1)
	}

	command := os.Args[1]
	args := os.Args[2:]

	switch command {
	case "ensemble":
		cmdEnsemble(args)
	case "list":
		cmdList(args)
	case "info":
		cmdInfo(args)
	case "register":
		cmdRegister(args)
	case "remove":
		cmdRemove(args)
	case "tag":
		cmdTag(args)
	case "untag":
		cmdUntag(args)
	case "search":
		cmdSearch(args)
	case "run":
		cmdRun(args)
	case "stats":
		cmdStats(args)
	case "diff":
		cmdDiff(args)
	case "batch":
		cmdBatch(args)
	case "profile":
		cmdProfile(args)
	case "validate":
		cmdValidate(args)
	case "validate-input":
		cmdValidateInput(args)
	case "schema":
		cmdSchema(args)
	case "export":
		cmdExport(args)
	case "import":
		cmdImport(args)
	case "clone":
		cmdClone(args)
	case "checkpoint":
		cmdCheckpoint(args)
	case "checkpoints":
		cmdCheckpoints(args)
	case "rollback":
		cmdRollback(args)
	case "migrate":
		cmdMigrate(args)
	case "compat":
		cmdCompat(args)
	case "version":
		fmt.Printf("mlpipe version %s\n", version)
	case "help":
		printUsage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
		printUsage()
		os.Exit(1)
	}
}

