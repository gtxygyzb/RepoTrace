[?2004lpackage main

import (
"encoding/csv"
"fmt"
"math"
"os"
"path/filepath"
"sort"
"strconv"
"strings"
)

func modelDirExists(path string) bool {
info, err := os.Stat(path)
return err == nil && info.IsDir()
}

func resolveModel(name string) (*RegistryEntry, error) {
entries, err := loadRegistry()
if err != nil {
return nil, err
}
entry := findEntry(entries, name)
if entry == nil {
return nil, fmt.Errorf("model '%s' not found", name)
}
if !modelDirExists(entry.Path) {
return nil, fmt.Errorf("model directory not found")
}
return entry, nil
}

func loadModelArtifacts(modelDir string) (*WeightsData, *PipelineConfig, error) {
weights, err := loadWeights(modelDir)
if err != nil {
return nil, nil, err
}
cfg, err := loadPipelineConfig(modelDir)
if err != nil {
