   396	}
   397	
   398	func weightedMeanFloat64(vals []float64, weights []float64) float64 {
   399		if len(vals) == 0 {
   400			return 0
   401		}
   402		sum := 0.0
   403		weightSum := 0.0
   404		for i, v := range vals {
   405			w := 1.0
   406			if i < len(weights) {
   407				w = weights[i]
   408			}
   409			sum += w * v
   410			weightSum += w
   411		}
   412		if weightSum == 0 {
   413			return meanFloat64(vals)
   414		}
   415		return sum / weightSum
   416	}
   417	
   418	func meanFloat64(vals []float64) float64 {
   419		if len(vals) == 0 {
   420			return 0
   421		}
   422		sum := 0.0
   423		for _, v := range vals {
   424			sum += v
   425		}
   426		return sum / float64(len(vals))
   427	}
   428	
   429	func maxFloat64(vals []float64) float64 {
   430		if len(vals) == 0 {
   431			return 0
   432		}
   433		m := vals[0]
   434		for _, v := range vals[1:] {
   435			if v > m {
   436				m = v
   437			}
   438		}
   439		return m
   440	}
