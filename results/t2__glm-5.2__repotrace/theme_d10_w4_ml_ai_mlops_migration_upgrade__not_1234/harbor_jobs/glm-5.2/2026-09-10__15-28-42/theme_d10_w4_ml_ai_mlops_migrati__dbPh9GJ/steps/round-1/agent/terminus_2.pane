func cmdExport(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe export <model> --output <file>\n")
		os.Exit(1)
	}
	name := args[0]
	flags := parseFlags(args[1:])

	outputPath := flags["output"]
	if outputPath == "" {
		fmt.Fprintf(os.Stderr, "error: --output is required\n")
		os.Exit(1)
	}
	if !strings.HasSuffix(outputPath, ".json") {
		outputPath += ".json"
	}

	entry, err := resolveModel(name)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	meta, err := loadModelMeta(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
		os.Exit(1)
	}

	weights, err := loadWeights(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
		os.Exit(1)
	}

	cfg, err := loadPipelineConfig(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading pipeline config: %v\n", err)
		os.Exit(1)
	}

	modelName := meta["name"]
	if modelName == "" {
		modelName = entry.Name
	}
	modelType := meta["type"]
	if modelType == "" {
		modelType = "unknown"
	}
	modelVersion := 1
	if v, err := strconv.Atoi(meta["version"]); err == nil {
		modelVersion = v
	}

	activation := "none"
	if weights.Version == 2 {
		activation = activationIDToName(weights.Activation)
	}

	if int(weights.NumFeatures) <= 0 || int(weights.NumOutputs) <= 0 {
		fmt.Fprintf(os.Stderr, "error: invalid model dimensions\n")
		os.Exit(1)
	}
	if len(weights.Weights) != int(weights.NumFeatures)*int(weights.NumOutputs) {
		fmt.Fprintf(os.Stderr, "error: corrupt weights matrix\n")
		os.Exit(1)
	}
	if len(weights.Bias) != int(weights.NumOutputs) {
		fmt.Fprintf(os.Stderr, "error: corrupt bias vector\n")
		os.Exit(1)
	}

	weightMatrix := make([][]float64, weights.NumOutputs)
	for o := uint32(0); o < weights.NumOutputs; o++ {
		start := o * weights.NumFeatures
		end := start + weights.NumFeatures
		row := make([]float64, weights.NumFeatures)
		copy(row, weights.Weights[start:end])
		weightMatrix[o] = row
	}

	export := exportModel{
		Name:          modelName,
		Type:          modelType,
		Version:       modelVersion,
		FormatVersion: int(weights.Version),
		Features:      int(weights.NumFeatures),
		Outputs:       int(weights.NumOutputs),
		Activation:    activation,
		Weights:       weightMatrix,
		Bias:          weights.Bias,
		Pipeline: exportPipeline{
			Normalize:       cfg.Normalize,
			ScaleRange:      []float64{cfg.ScaleMin, cfg.ScaleMax},
			MissingStrategy: cfg.MissingStrategy,
			RoundDigits:     cfg.RoundDigits,
			ClipRange:       []float64{cfg.ClipMin, cfg.ClipMax},
		},
	}

	data, err := json.MarshalIndent(export, "", "  ")
	if err != nil {
		fmt.Fprintf(os.Stderr, "error encoding JSON: %v\n", err)
		os.Exit(1)
	}
	data = append(data, '\n')

	if dir := filepath.Dir(outputPath); dir != "" && dir != "." {
		if err := os.MkdirAll(dir, 0755); err != nil {
			fmt.Fprintf(os.Stderr, "error creating output directory: %v\n", err)
			os.Exit(1)
		}
	}
	if err := os.WriteFile(outputPath, data, 0644); err != nil {
		fmt.Fprintf(os.Stderr, "error writing export file: %v\n", err)
		os.Exit(1)
	}
	fmt.Printf("Model '%s' exported to %s\n", name, outputPath)
}

func cmdImport(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe import <path> [--name <name>]\n")
		os.Exit(1)
	}
	importPath := args[0]
	flags := parseFlags(args[1:])
	name := flags["name"]
	if name == "" || name == "true" {
		name = ""
	}

	data, err := os.ReadFile(importPath)
	if err != nil {
		if os.IsNotExist(err) {
			fmt.Fprintf(os.Stderr, "error: file not found: %s\n", importPath)
		} else {
			fmt.Fprintf(os.Stderr, "error: %v\n", err)
		}
		os.Exit(1)
	}

	var model exportModel
	if err := json.Unmarshal(data, &model); err != nil {
		fmt.Fprintf(os.Stderr, "error: invalid JSON: %v\n", err)
		os.Exit(1)
	}

	if name == "" {
		name = model.Name
	}
	if name == "" {
		fmt.Fprintf(os.Stderr, "error: invalid model JSON: missing name\n")
		os.Exit(1)
	}
	if model.FormatVersion != 1 && model.FormatVersion != 2 {
		fmt.Fprintf(os.Stderr, "error: invalid model JSON: format_version must be 1 or 2\n")
		os.Exit(1)
	}
	if model.Features <= 0 || model.Outputs <= 0 {
		fmt.Fprintf(os.Stderr, "error: invalid model JSON: features and outputs must be positive\n")
		os.Exit(1)
	}
	if len(model.Weights) != model.Outputs {
		fmt.Fprintf(os.Stderr, "error: invalid model JSON: weights outer dimension must equal outputs\n")
		os.Exit(1)
	}
	for i, row := range model.Weights {
		if len(row) != model.Features {
			fmt.Fprintf(os.Stderr, "error: invalid model JSON: weights[%d] has %d features, expected %d\n", i, len(row), model.Features)
			os.Exit(1)
		}
	}
	if len(model.Bias) != model.Outputs {
		fmt.Fprintf(os.Stderr, "error: invalid model JSON: bias length must equal outputs\n")
		os.Exit(1)
	}
	if len(model.Pipeline.ScaleRange) != 2 {
		fmt.Fprintf(os.Stderr, "error: invalid model JSON: scale_range must have two values\n")
		os.Exit(1)
	}
	if len(model.Pipeline.ClipRange) != 2 {
		fmt.Fprintf(os.Stderr, "error: invalid model JSON: clip_range must have two values\n")
		os.Exit(1)
	}

	activationName := model.Activation
	if model.FormatVersion == 1 {
		activationName = "none"
	}
	activationID, err := activationNameToID(activationName)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: invalid model JSON: %v\n", err)
		os.Exit(1)
	}
	if model.FormatVersion == 1 && model.Activation != "none" {
		fmt.Fprintf(os.Stderr, "error: invalid model JSON: v1 models must use activation none\n")
		os.Exit(1)
	}

	entries, err := loadRegistry()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	if findEntry(entries, name) != nil {
		fmt.Fprintf(os.Stderr, "error: model already exists\n")
		os.Exit(1)
	}

	modelDir := filepath.Join("/app/models", name)
	if err := os.MkdirAll(modelDir, 0755); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	flatWeights := make([]float64, 0, model.Features*model.Outputs)
	for o := 0; o < model.Outputs; o++ {
		flatWeights = append(flatWeights, model.Weights[o]...)
	}
	weightsData := &WeightsData{
		Version:     uint32(model.FormatVersion),
		NumFeatures: uint32(model.Features),
		NumOutputs:  uint32(model.Outputs),
		Activation:  activationID,
		Weights:     flatWeights,
		Bias:        model.Bias,
	}
	if err := writeWeights(filepath.Join(modelDir, "weights.bin"), weightsData); err != nil {
		fmt.Fprintf(os.Stderr, "error writing weights: %v\n", err)
		os.Exit(1)
	}

	meta := map[string]string{
		"name":           name,
		"type":           model.Type,
		"version":        strconv.Itoa(model.Version),
		"created":        time.Now().Format("2006-01-02"),
		"description":    "Imported from JSON export",
		"features":       strconv.Itoa(model.Features),
		"outputs":        strconv.Itoa(model.Outputs),
		"format_version": strconv.Itoa(model.FormatVersion),
		"activation":     activationName,
	}
	if meta["type"] == "" {
		meta["type"] = "unknown"
	}
	if meta["version"] == "0" {
		meta["version"] = "1"
	}
	if err := saveModelMeta(modelDir, meta); err != nil {
		fmt.Fprintf(os.Stderr, "error writing metadata: %v\n", err)
		os.Exit(1)
	}

	cfg := &PipelineConfig{
		Normalize:       model.Pipeline.Normalize,
		ScaleMin:        model.Pipeline.ScaleRange[0],
		ScaleMax:        model.Pipeline.ScaleRange[1],
		MissingStrategy: model.Pipeline.MissingStrategy,
		RoundDigits:     model.Pipeline.RoundDigits,
		ClipMin:         model.Pipeline.ClipRange[0],
		ClipMax:         model.Pipeline.ClipRange[1],
	}
	if cfg.MissingStrategy == "" {
		cfg.MissingStrategy = "zero"
	}
	if err := savePipelineConfig(modelDir, cfg); err != nil {
		fmt.Fprintf(os.Stderr, "error writing pipeline config: %v\n", err)
		os.Exit(1)
	}

	registryVersion := model.Version
	if registryVersion == 0 {
		registryVersion = 1
	}
	entries = append(entries, RegistryEntry{
		Name:    name,
		Path:    modelDir,
		Type:    model.Type,
		Version: registryVersion,
		Created: time.Now().Format("2006-01-02"),
	})
	if err := saveRegistry(entries); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	fmt.Printf("Model '%s' imported successfully.\n", name)
}

func cmdClone(args []string) {
	if len(args) < 2 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe clone <model> <new_name>\n")
		os.Exit(1)
	}
	sourceName := args[0]
	newName := args[1]

	entry, err := resolveModel(sourceName)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	entries, err := loadRegistry()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	if findEntry(entries, newName) != nil {
		fmt.Fprintf(os.Stderr, "error: model already exists\n")
		os.Exit(1)
	}

	newDir := filepath.Join("/app/models", newName)
	if err := os.MkdirAll(newDir, 0755); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	if err := copyDir(entry.Path, newDir); err != nil {
		fmt.Fprintf(os.Stderr, "error cloning model files: %v\n", err)
		os.Exit(1)
	}

	meta, err := loadModelMeta(newDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error updating metadata: %v\n", err)
		os.Exit(1)
	}
	meta["name"] = newName
	if err := saveModelMeta(newDir, meta); err != nil {
		fmt.Fprintf(os.Stderr, "error updating metadata: %v\n", err)
		os.Exit(1)
	}

	registryVersion := entry.Version
	if registryVersion == 0 {
		registryVersion = 1
	}
	entries = append(entries, RegistryEntry{
		Name:    newName,
		Path:    newDir,
		Type:    entry.Type,
		Version: registryVersion,
		Created: time.Now().Format("2006-01-02"),
	})
	if err := saveRegistry(entries); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	fmt.Printf("Model '%s' cloned to '%s'.\n", sourceName, newName)
}

func savePipelineConfig(modelDir string, cfg *PipelineConfig) error {
	path := filepath.Join(modelDir, "pipeline.cfg")
	f, err := os.Create(path)
	if err != nil {
		return err
	}
	defer f.Close()

	fmt.Fprintln(f, "[preprocess]")
	fmt.Fprintf(f, "normalize=%t\n", cfg.Normalize)
	fmt.Fprintf(f, "scale_range=%s,%s\n", formatFloat(cfg.ScaleMin), formatFloat(cfg.ScaleMax))
	fmt.Fprintf(f, "missing_strategy=%s\n", cfg.MissingStrategy)
	fmt.Fprintln(f)
	fmt.Fprintln(f, "[postprocess]")
	fmt.Fprintf(f, "round_digits=%d\n", cfg.RoundDigits)
	fmt.Fprintf(f, "clip_min=%s\n", formatFloat(cfg.ClipMin))
	fmt.Fprintf(f, "clip_max=%s\n", formatFloat(cfg.ClipMax))
	return nil
}

func formatFloat(v float64) string {
	return strconv.FormatFloat(v, 'f', -1, 64)
}

