   370	func cmdProfile(args []string) {
   371		if len(args) < 1 {
   372			fmt.Fprintf(os.Stderr, "usage: mlpipe profile <model>\n")
   373			os.Exit(1)
   374		}
   375		model := args[0]
   376	
   377		entry, err := resolveModel(model)
   378		if err != nil {
   379			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   380			os.Exit(1)
   381		}
   382	
   383		weightsPath := filepath.Join(entry.Path, "weights.bin")
   384		info, err := os.Stat(weightsPath)
   385		if err != nil {
   386			fmt.Fprintln(os.Stderr, "not found")
   387			os.Exit(1)
   388		}
   389	
   390		weights, _, err := loadModelArtifacts(entry.Path)
   391		if err != nil {
   392			fmt.Fprintf(os.Stderr, "error loading model: %v\n", err)
   393			os.Exit(1)
   394		}
   395	
   396		features := int(weights.NumFeatures)
   397		outputs := int(weights.NumOutputs)
   398		totalParams := features*outputs + outputs
   399	
   400		var wmin, wmax, wsum float64
   401		zeroCount := 0
   402		if len(weights.Weights) > 0 {
   403			wmin = weights.Weights[0]
   404			wmax = weights.Weights[0]
   405			for _, v := range weights.Weights {
   406				if v < wmin {
   407					wmin = v
   408				}
   409				if v > wmax {
   410					wmax = v
   411				}
   412				wsum += v
   413				if v == 0 {
   414					zeroCount++
   415				}
   416			}
   417		} else {
   418			wmin = 0
   419			wmax = 0
   420		}
   421		wavg := 0.0
   422		if len(weights.Weights) > 0 {
   423			wavg = wsum / float64(len(weights.Weights))
   424		}
   425		sparsity := 0.0
   426		if len(weights.Weights) > 0 {
   427			sparsity = float64(zeroCount) / float64(len(weights.Weights)) * 100
   428		}
   429	
   430		fmt.Printf("Name:       %s\n", entry.Name)
   431		fmt.Printf("Type:       %s\n", entry.Type)
   432		fmt.Printf("Format:     v%d\n", weights.Version)
   433		if weights.Version >= 2 {
   434			fmt.Printf("Activation: %s\n", activationIDToName(weights.Activation))
   435		}
   436		fmt.Printf("Dimensions: %d x %d\n", features, outputs)
   437		fmt.Printf("Parameters: %d\n", totalParams)
   438		fmt.Printf("File size:  %d bytes\n", info.Size())
   439		fmt.Printf("Weight min: %v\n", wmin)
   440		fmt.Printf("Weight max: %v\n", wmax)
   441		fmt.Printf("Weight avg: %v\n", wavg)
   442		biasStrs := make([]string, len(weights.Bias))
   443		for i, b := range weights.Bias {
   444			biasStrs[i] = fmt.Sprintf("%v", b)
   445		}
   446		fmt.Printf("Bias:       [%s]\n", strings.Join(biasStrs, ", "))
   447		fmt.Printf("Sparsity:   %.1f%%\n", sparsity)
   448	}
