[?2004lfunc cmdCompare(args []string) {
	if len(args) < 2 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe compare <model1> <model2> [--input <file>]\n")
		os.Exit(1)
	}

	model1 := args[0]
	model2 := args[1]
	flags := parseFlags(args[2:])
	input := flags["input"]

	if input != "" {
		if _, err := os.Stat(input); err != nil {
			fmt.Fprintln(os.Stderr, "file not found")
			os.Exit(1)
		}
	}

	entry1, err := resolveModel(model1)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	entry2, err := resolveModel(model2)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	w1, cfg1, err := loadModelArtifacts(entry1.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading model '%s': %v\n", model1, err)
		os.Exit(1)
	}

	w2, cfg2, err := loadModelArtifacts(entry2.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading model '%s': %v\n", model2, err)
		os.Exit(1)
	}

	fmt.Printf("Comparing '%s' vs '%s'\n\n", model1, model2)

	featuresMatch := w1.NumFeatures == w2.NumFeatures
	outputsMatch := w1.NumOutputs == w2.NumOutputs
	formatMatch := w1.Version == w2.Version
	activationMatch := w1.Activation == w2.Activation

	fmt.Println("Structure:")
	fmt.Printf("  Features:   %d vs %d [%s]\n", w1.NumFeatures, w2.NumFeatures, matchLabel(featuresMatch))
	fmt.Printf("  Outputs:    %d vs %d [%s]\n", w1.NumOutputs, w2.NumOutputs, matchLabel(outputsMatch))
	fmt.Printf("  Format:     v%d vs v%d [%s]\n", w1.Version, w2.Version, matchLabel(formatMatch))
	fmt.Printf("  Activation: %s vs %s [%s]\n", activationIDToName(w1.Activation), activationIDToName(w2.Activation), matchLabel(activationMatch))
	fmt.Println()

	if !featuresMatch || !outputsMatch {
		fmt.Println("skipping weight comparison: dimension mismatch")
		return
	}

	fmt.Println("Weight differences:")
	maxWeightDiff, meanWeightDiff, changedWeights, totalWeights := compareFloatSlices(w1.Weights, w2.Weights)
	fmt.Printf("  Max absolute diff:  %s\n", formatFloat(maxWeightDiff))
	fmt.Printf("  Mean absolute diff: %s\n", formatFloat(meanWeightDiff))
	pctChanged := 0.0
	if totalWeights > 0 {
		pctChanged = float64(changedWeights) / float64(totalWeights) * 100.0
	}
	fmt.Printf("  Weights changed:    %d/%d (%.1f%%)\n", changedWeights, totalWeights, pctChanged)
	fmt.Println()

	fmt.Println("Bias differences:")
	maxBiasDiff, _, _, _ := compareFloatSlices(w1.Bias, w2.Bias)
	fmt.Printf("  Max absolute diff:  %s\n", formatFloat(maxBiasDiff))

	if input != "" {
