[?2004lpackage main

import (
	"fmt"
	"os"
	"strings"
)

const version = "0.1.0"

func main() {
	if len(os.Args) < 2 {
		printUsage()
		os.Exit(1)
	}

	command := os.Args[1]
	args := os.Args[2:]

	switch command {
	case "list":
		cmdList(args)
	case "info":
		cmdInfo(args)
	case "register":
		cmdRegister(args)
	case "remove":
		cmdRemove(args)
	case "tag":
		cmdTag(args)
	case "untag":
		cmdUntag(args)
	case "search":
		cmdSearch(args)
	case "run":
		cmdRun(args)
	case "stats":
		cmdStats(args)
	case "diff":
		cmdDiff(args)
	case "batch":
		cmdBatch(args)
	case "profile":
		cmdProfile(args)
	case "validate":
		cmdValidate(args)
	case "export":
		cmdExport(args)
	case "import":
		cmdImport(args)
	case "clone":
		cmdClone(args)
	case "checkpoint":
		cmdCheckpoint(args)
	case "checkpoints":
		cmdCheckpoints(args)
	case "rollback":
		cmdRollback(args)
	case "migrate":
		cmdMigrate(args)
	case "compat":
		cmdCompat(args)
	case "version":
		fmt.Printf("mlpipe version %s\n", version)
	case "help":
		printUsage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
		printUsage()
		os.Exit(1)
	}
}

func printUsage() {
	usage := `mlpipe - ML Inference Pipeline Manager

Usage: mlpipe <command> [arguments]

Commands:
  list                          List all registered models
  info <model>                  Show model details
  register <name> <path>        Register a model from directory
  remove <name>                 Remove a model from registry
  run <model> [options]         Run inference
  stats --input <file>          Input statistics profiling
  diff <model1> <model2> --input <file>
                                Compare two models on same input
  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
                                Batch inference over CSV files
  validate <model>              Validate model integrity
  export <model> --output <file> Export model to JSON file
  import <path> [--name <name>] Import model from JSON file
  clone <model> <new_name>      Clone model to new name
    profile <model>               Report model weight analysis
  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
  compat [--all]                 Check migration compatibility
  version                       Show version
  help                          Show this help

Run/Diff Options:
  --input <file>    Input CSV file (required)
  --output <file>   Output file (default: stdout)
  --format <fmt>    Output format: csv or json (default: csv)

Batch Options:
  --dir <dir>       Input directory of CSV files
  --output-dir <dir> Output directory for predictions
  --format <fmt>    Output format: csv or json (default: csv)
`
	fmt.Print(usage)
}

func parseFlags(args []string) map[string]string {
	flags := make(map[string]string)
	for i := 0; i < len(args); i++ {
		if strings.HasPrefix(args[i], "--") {
			key := strings.TrimPrefix(args[i], "--")
			if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
				flags[key] = args[i+1]
				i++
			} else {
				flags[key] = "true"
			}
		}
	}
	return flags
}
[?2004hroot@n30009:/app# sed -n '1,160p' inference.go
[?2004lpackage main

import (
	"encoding/csv"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

func cmdRun(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe run <model> [--input <file>] [--output <file>] [--format csv|json]\n")
		os.Exit(1)
	}

	modelName := args[0]
	flags := parseFlags(args[1:])

	inputFile := flags["input"]
	if inputFile == "" {
		fmt.Fprintf(os.Stderr, "error: --input is required\n")
		os.Exit(1)
	}

	outputFormat := flags["format"]
	if outputFormat == "" {
		outputFormat = "csv"
	}
	if outputFormat != "csv" && outputFormat != "json" {
		fmt.Fprintf(os.Stderr, "error: unsupported format '%s', use 'csv' or 'json'\n", outputFormat)
		os.Exit(1)
	}

	entry, err := resolveModel(modelName)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	weights, err := loadWeights(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
		os.Exit(1)
	}

	pipelineCfg, err := loadPipelineConfig(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading pipeline config: %v\n", err)
		os.Exit(1)
	}

	inputs, err := readInputCSV(inputFile)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
		os.Exit(1)
	}

	if err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {
		fmt.Fprintf(os.Stderr, "error: input feature count mismatch: %v\n", err)
		os.Exit(1)
	}

	results := runInference(inputs, weights, pipelineCfg)

	outputFile := flags["output"]
	if outputFile != "" {
		f, err := os.Create(outputFile)
		if err != nil {
			fmt.Fprintf(os.Stderr, "error creating output file: %v\n", err)
			os.Exit(1)
		}
		defer f.Close()
		writeOutput(f, results, outputFormat)
	} else {
		writeOutput(os.Stdout, results, outputFormat)
	}
}

func readInputCSV(path string) ([][]float64, error) {
	f, err := os.Open(path)
	if err != nil {
		return nil, err
	}
	defer f.Close()

	reader := csv.NewReader(f)
	records, err := reader.ReadAll()
	if err != nil {
		return nil, err
	}

	var data [][]float64
	for i, record := range records {
		if i == 0 && isHeader(record) {
			continue
		}
		row := make([]float64, len(record))
		for j, val := range record {
			val = strings.TrimSpace(val)
			if val == "" || val == "NA" || val == "nan" {
				row[j] = math.NaN()
			} else {
				row[j], err = strconv.ParseFloat(val, 64)
				if err != nil {
					return nil, fmt.Errorf("row %d col %d: %v", i, j, err)
				}
			}
		}
		data = append(data, row)
	}
	return data, nil
}

func isHeader(record []string) bool {
	for _, val := range record {
		_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)
		if err == nil {
			return false
		}
	}
	return true
}

func runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {
	processed := preprocess(inputs, cfg)

	results := make([][]float64, len(processed))
	for i, row := range processed {
		output := make([]float64, weights.NumOutputs)
		for o := uint32(0); o < weights.NumOutputs; o++ {
			sum := weights.Bias[o]
			for f := uint32(0); f < weights.NumFeatures; f++ {
				if int(f) < len(row) {
					sum += row[f] * weights.Weights[o*weights.NumFeatures+f]
				}
			}
			output[o] = applyActivation(sum, weights.Activation)
		}
		results[i] = output
	}

	return postprocess(results, cfg)
}

func preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {
	result := make([][]float64, len(inputs))
	for i, row := range inputs {
		result[i] = make([]float64, len(row))
		copy(result[i], row)
	}

	if len(result) == 0 {
		return result
	}

	for i, row := range result {
		for j, val := range row {
[?2004hroot@n30009:/app# sed -n '1,120p' registry.go
[?2004lpackage main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"strings"
	"time"
)

const (
	registryFile     = "/app/models/registry.idx"
	registryJSONFile = "/app/models/registry.json"
)

type RegistryEntry struct {
	Name    string   `json:"name"`
	Path    string   `json:"path"`
	Type    string   `json:"type"`
	Version int      `json:"version"`
	Created string   `json:"created"`
	Tags    []string `json:"tags"`
}

func loadRegistry() ([]RegistryEntry, error) {
	data, err := os.ReadFile(registryJSONFile)
	if err == nil {
		if len(strings.TrimSpace(string(data))) == 0 {
			return nil, nil
		}
		var entries []RegistryEntry
		if err := json.Unmarshal(data, &entries); err != nil {
			return nil, fmt.Errorf("parse registry.json: %w", err)
		}
		for i := range entries {
			entries[i].Tags = ensureTags(entries[i].Tags)
		}
		return entries, nil
	}
	if !os.IsNotExist(err) {
		return nil, err
	}

	if _, err := os.Stat(registryFile); err == nil {
		entries, err := loadOldRegistry()
		if err != nil {
			return nil, err
		}
		if err := saveRegistry(entries); err != nil {
			return nil, err
		}
		return entries, nil
	}

	return nil, nil
}

func loadOldRegistry() ([]RegistryEntry, error) {
	f, err := os.Open(registryFile)
	if err != nil {
		if os.IsNotExist(err) {
			return nil, nil
		}
		return nil, err
	}
	defer f.Close()

	var entries []RegistryEntry
	scanner := bufio.NewScanner(f)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		parts := strings.Split(line, "|")
		if len(parts) != 5 {
			continue
		}
		ver := 1
		fmt.Sscanf(parts[3], "%d", &ver)
		entries = append(entries, RegistryEntry{
			Name:    parts[0],
			Path:    parts[1],
			Type:    parts[2],
			Version: ver,
			Created: parts[4],
			Tags:    []string{},
		})
	}
	return entries, scanner.Err()
}

func saveRegistry(entries []RegistryEntry) error {
	dir := filepath.Dir(registryJSONFile)
	if err := os.MkdirAll(dir, 0755); err != nil {
		return err
	}

	out := make([]RegistryEntry, len(entries))
	for i, e := range entries {
		e.Tags = ensureTags(e.Tags)
		out[i] = e
	}

	data, err := json.MarshalIndent(out, "", "  ")
	if err != nil {
		return err
	}
	return os.WriteFile(registryJSONFile, data, 0644)
}

func ensureTags(tags []string) []string {
	if tags == nil {
		return []string{}
	}
	return tags
}
