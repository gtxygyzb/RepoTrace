    14	func modelDirExists(path string) bool {
    15		info, err := os.Stat(path)
    16		return err == nil && info.IsDir()
    17	}
    18	
    19	func resolveModel(name string) (*RegistryEntry, error) {
    20		entries, err := loadRegistry()
    21		if err != nil {
    22			return nil, err
    23		}
    24		entry := findEntry(entries, name)
    25		if entry == nil {
    26			return nil, fmt.Errorf("model '%s' not found", name)
    27		}
    28		if !modelDirExists(entry.Path) {
    29			return nil, fmt.Errorf("model directory not found")
    30		}
    31		return entry, nil
    32	}
