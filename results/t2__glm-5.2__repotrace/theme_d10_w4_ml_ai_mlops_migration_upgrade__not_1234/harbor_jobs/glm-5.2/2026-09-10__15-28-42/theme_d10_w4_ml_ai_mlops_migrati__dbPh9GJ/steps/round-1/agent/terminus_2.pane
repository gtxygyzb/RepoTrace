    29	func cmdCheckpoint(args []string) {
    30		if len(args) < 1 {
    31			fmt.Fprintf(os.Stderr, "usage: mlpipe checkpoint <model> [--name <name>]\n")
    32			os.Exit(1)
    33		}
    34		model := args[0]
    35		flags := parseFlags(args[1:])
    36	
    37		name := flags["name"]
    38		if name == "" {
    39			name = "cp-" + time.Now().Format("20060102-150405")
    40		}
    41	
    42		entry, err := resolveModel(model)
    43		if err != nil {
    44			fmt.Fprintf(os.Stderr, "not found\n")
    45			os.Exit(1)
    46		}
    47	
    48		cpDir := filepath.Join(checkpointsDir(entry.Path), name)
    49		if _, err := os.Stat(cpDir); err == nil {
    50			fmt.Fprintf(os.Stderr, "checkpoint already exists\n")
    51			os.Exit(1)
    52		}
    53	
    54		if err := os.MkdirAll(cpDir, 0755); err != nil {
    55			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    56			os.Exit(1)
    57		}
    58	
    59		for _, file := range []string{"weights.bin", "model.meta", "pipeline.cfg"} {
    60			src := filepath.Join(entry.Path, file)
    61			data, err := os.ReadFile(src)
    62			if err != nil {
    63				fmt.Fprintf(os.Stderr, "error: %v\n", err)
    64				os.Exit(1)
    65			}
    66			if err := os.WriteFile(filepath.Join(cpDir, file), data, 0644); err != nil {
    67				fmt.Fprintf(os.Stderr, "error: %v\n", err)
    68				os.Exit(1)
    69			}
    70		}
    71	
    72		fmt.Printf("checkpoint '%s' created for '%s'\n", name, model)
    73	}
    74	
    75	func cmdCheckpoints(args []string) {
    76		if len(args) < 1 {
    77			fmt.Fprintf(os.Stderr, "usage: mlpipe checkpoints <model>\n")
    78			os.Exit(1)
    79		}
    80		model := args[0]
    81	
    82		entry, err := resolveModel(model)
    83		if err != nil {
    84			fmt.Fprintf(os.Stderr, "not found\n")
    85			os.Exit(1)
    86		}
    87	
    88		entries, err := os.ReadDir(checkpointsDir(entry.Path))
    89		if err != nil || len(entries) == 0 {
    90			fmt.Println("no checkpoints")
    91			return
    92		}
    93	
    94		type checkpointInfo struct {
    95			name string
    96			mod  time.Time
    97		}
    98		var cps []checkpointInfo
    99		for _, entry := range entries {
   100			if !entry.IsDir() {
   101				continue
   102			}
   103			info, err := entry.Info()
   104			if err != nil {
   105				continue
   106			}
   107			cps = append(cps, checkpointInfo{name: entry.Name(), mod: info.ModTime()})
   108		}
   109	
   110		if len(cps) == 0 {
   111			fmt.Println("no checkpoints")
   112			return
   113		}
   114	
   115		sort.Slice(cps, func(i, j int) bool {
   116			return cps[i].mod.Before(cps[j].mod)
   117		})
   118	
   119		for _, cp := range cps {
   120			fmt.Printf("%s  %s\n", cp.name, cp.mod.Format("2006-01-02 15:04:05"))
   121		}
   122	}
   123	
   124	func cmdRollback(args []string) {
   125		if len(args) < 1 {
   126			fmt.Fprintf(os.Stderr, "usage: mlpipe rollback <model> --to <checkpoint>\n")
   127			os.Exit(1)
   128		}
   129		model := args[0]
