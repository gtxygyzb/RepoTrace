func cmdRun(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe run <model> [--input <file>] [--output <file>] [--format csv|json]\n")
		os.Exit(1)
	}

	modelName := args[0]
	flags := parseFlags(args[1:])

	inputFile := flags["input"]
	if inputFile == "" {
		fmt.Fprintf(os.Stderr, "error: --input is required\n")
		os.Exit(1)
	}

	outputFormat := flags["format"]
	if outputFormat == "" {
		outputFormat = "csv"
	}
	if outputFormat != "csv" && outputFormat != "json" {
		fmt.Fprintf(os.Stderr, "error: unsupported format '%s', use 'csv' or 'json'\n", outputFormat)
		os.Exit(1)
	}

	entry, err := resolveModel(modelName)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	weights, err := loadWeights(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
		os.Exit(1)
	}

	pipelineCfg, err := loadPipelineConfig(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading pipeline config: %v\n", err)
		os.Exit(1)
	}

	inputs, err := readInputCSV(inputFile)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
		os.Exit(1)
	}

	if err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {
		fmt.Fprintf(os.Stderr, "error: input feature count mismatch: %v\n", err)
		os.Exit(1)
	}

	results := runInference(inputs, weights, pipelineCfg)

	outputFile := flags["output"]
	if outputFile != "" {
		f, err := os.Create(outputFile)
		if err != nil {
			fmt.Fprintf(os.Stderr, "error creating output file: %v\n", err)
			os.Exit(1)
		}
		defer f.Close()
		writeOutput(f, results, outputFormat)
	} else {
		writeOutput(os.Stdout, results, outputFormat)
	}
}

func readInputCSV(path string) ([][]float64, error) {
	f, err := os.Open(path)
	if err != nil {
		return nil, err
	}
	defer f.Close()

	reader := csv.NewReader(f)
	records, err := reader.ReadAll()
	if err != nil {
		return nil, err
	}

	var data [][]float64
	for i, record := range records {
		if i == 0 && isHeader(record) {
			continue
		}
		row := make([]float64, len(record))
		for j, val := range record {
			val = strings.TrimSpace(val)
			if val == "" || val == "NA" || val == "nan" {
				row[j] = math.NaN()
			} else {
				row[j], err = strconv.ParseFloat(val, 64)
				if err != nil {
					return nil, fmt.Errorf("row %d col %d: %v", i, j, err)
				}
			}
		}
		data = append(data, row)
	}
	return data, nil
}

func isHeader(record []string) bool {
	for _, val := range record {
		_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)
		if err == nil {
			return false
		}
	}
	return true
}

func runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {
	processed := preprocess(inputs, cfg)

	results := make([][]float64, len(processed))
	for i, row := range processed {
		output := make([]float64, weights.NumOutputs)
		for o := uint32(0); o < weights.NumOutputs; o++ {
			sum := weights.Bias[o]
			for f := uint32(0); f < weights.NumFeatures; f++ {
				if int(f) < len(row) {
					sum += row[f] * weights.Weights[o*weights.NumFeatures+f]
				}
			}
			output[o] = applyActivation(sum, weights.Activation)
		}
		results[i] = output
	}

	return postprocess(results, cfg)
}

func preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {
	result := make([][]float64, len(inputs))
	for i, row := range inputs {
		result[i] = make([]float64, len(row))
		copy(result[i], row)
	}

	if len(result) == 0 {
		return result
	}

	for i, row := range result {
		for j, val := range row {
			if math.IsNaN(val) {
				switch cfg.MissingStrategy {
				case "zero":
					result[i][j] = 0.0
				case "mean":
					result[i][j] = computeColumnMean(inputs, j)
				}
			}
		}
	}

	if cfg.Normalize {
		for j := 0; j < len(result[0]); j++ {
			minVal, maxVal := columnMinMax(result, j)
			rangeVal := maxVal - minVal
			if rangeVal == 0 {
				rangeVal = 1.0
			}
			for i := range result {
				normalized := (result[i][j] - minVal) / rangeVal
				result[i][j] = cfg.ScaleMin + normalized*(cfg.ScaleMax-cfg.ScaleMin)
			}
		}
	}

	return result
}

func postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {
	for i, row := range results {
		for j, val := range row {
			val = math.Max(val, cfg.ClipMin)
			val = math.Min(val, cfg.ClipMax)
			results[i][j] = roundToDigits(val, cfg.RoundDigits)
		}
	}
	return results
}

func computeColumnMean(data [][]float64, col int) float64 {
	sum := 0.0
	count := 0
	for _, row := range data {
		if col < len(row) && !math.IsNaN(row[col]) {
			sum += row[col]
			count++
		}
	}
	if count == 0 {
		return 0.0
	}
	return sum / float64(count)
}

func columnMinMax(data [][]float64, col int) (float64, float64) {
	minVal := math.Inf(1)
	maxVal := math.Inf(-1)
	for _, row := range data {
		if col < len(row) && !math.IsNaN(row[col]) {
			if row[col] < minVal {
				minVal = row[col]
			}
			if row[col] > maxVal {
				maxVal = row[col]
			}
		}
	}
	return minVal, maxVal
}

func writeOutput(f *os.File, results [][]float64, format string) {
	switch format {
	case "csv":
		writer := csv.NewWriter(f)
		header := make([]string, len(results[0]))
		for i := range header {
			header[i] = fmt.Sprintf("output_%d", i)
		}
		writer.Write(header)
		for _, row := range results {
			record := make([]string, len(row))
			for j, val := range row {
				record[j] = strconv.FormatFloat(val, 'f', -1, 64)
			}
			writer.Write(record)
		}
		writer.Flush()
	case "json":
		type Prediction struct {
			Outputs []float64 `json:"outputs"`
		}
		type Result struct {
			Predictions []Prediction `json:"predictions"`
		}
		r := Result{}
		for _, row := range results {
			r.Predictions = append(r.Predictions, Prediction{Outputs: row})
		}
		enc := json.NewEncoder(f)
		enc.SetIndent("", "  ")
[?2004hroot@n30009:/app# sed -n '1,260p' registry.go
[?2004lpackage main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"strings"
	"time"
)

const (
	registryFile     = "/app/models/registry.idx"
	registryJSONFile = "/app/models/registry.json"
)

type RegistryEntry struct {
	Name    string   `json:"name"`
	Path    string   `json:"path"`
	Type    string   `json:"type"`
	Version int      `json:"version"`
	Created string   `json:"created"`
	Tags    []string `json:"tags"`
}

func loadRegistry() ([]RegistryEntry, error) {
	data, err := os.ReadFile(registryJSONFile)
	if err == nil {
		if len(strings.TrimSpace(string(data))) == 0 {
			return nil, nil
		}
		var entries []RegistryEntry
		if err := json.Unmarshal(data, &entries); err != nil {
			return nil, fmt.Errorf("parse registry.json: %w", err)
		}
		for i := range entries {
			entries[i].Tags = ensureTags(entries[i].Tags)
		}
		return entries, nil
	}
	if !os.IsNotExist(err) {
		return nil, err
	}

	if _, err := os.Stat(registryFile); err == nil {
		entries, err := loadOldRegistry()
		if err != nil {
			return nil, err
		}
		if err := saveRegistry(entries); err != nil {
			return nil, err
		}
		return entries, nil
	}

	return nil, nil
}

func loadOldRegistry() ([]RegistryEntry, error) {
	f, err := os.Open(registryFile)
	if err != nil {
		if os.IsNotExist(err) {
			return nil, nil
		}
		return nil, err
	}
	defer f.Close()

	var entries []RegistryEntry
	scanner := bufio.NewScanner(f)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		parts := strings.Split(line, "|")
		if len(parts) != 5 {
			continue
		}
		ver := 1
		fmt.Sscanf(parts[3], "%d", &ver)
		entries = append(entries, RegistryEntry{
			Name:    parts[0],
			Path:    parts[1],
			Type:    parts[2],
			Version: ver,
			Created: parts[4],
			Tags:    []string{},
		})
	}
	return entries, scanner.Err()
}

func saveRegistry(entries []RegistryEntry) error {
	dir := filepath.Dir(registryJSONFile)
	if err := os.MkdirAll(dir, 0755); err != nil {
		return err
	}

	out := make([]RegistryEntry, len(entries))
	for i, e := range entries {
		e.Tags = ensureTags(e.Tags)
		out[i] = e
	}

	data, err := json.MarshalIndent(out, "", "  ")
	if err != nil {
		return err
	}
	return os.WriteFile(registryJSONFile, data, 0644)
}

func ensureTags(tags []string) []string {
	if tags == nil {
		return []string{}
	}
	return tags
}

func findEntry(entries []RegistryEntry, name string) *RegistryEntry {
	for i := range entries {
		if entries[i].Name == name {
			return &entries[i]
		}
	}
	return nil
}

func cmdList(args []string) {
	entries, err := loadRegistry()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	if len(entries) == 0 {
		fmt.Println("No models registered.")
		return
	}

	sort.Slice(entries, func(i, j int) bool {
		return entries[i].Name < entries[j].Name
	})

	for _, e := range entries {
		tags := append([]string(nil), e.Tags...)
		sort.Strings(tags)
		if len(tags) > 0 {
			fmt.Printf("%s (%s)\n", e.Name, strings.Join(tags, ", "))
		} else {
			fmt.Println(e.Name)
		}
	}
}

func cmdInfo(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe info <model>\n")
		os.Exit(1)
	}
	name := args[0]
	entries, err := loadRegistry()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	entry := findEntry(entries, name)
	if entry == nil {
		fmt.Fprintln(os.Stderr, "not found")
		os.Exit(1)
	}
	if !modelDirExists(entry.Path) {
		fmt.Fprintln(os.Stderr, "not found")
		os.Exit(1)
	}

	meta, err := loadModelMeta(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
		os.Exit(1)
	}

	weights, err := loadWeights(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
		os.Exit(1)
	}

	fmt.Printf("Name:        %s\n", meta["name"])
	fmt.Printf("Type:        %s\n", meta["type"])
	fmt.Printf("Version:     %s\n", meta["version"])
	fmt.Printf("Created:     %s\n", meta["created"])
	fmt.Printf("Description: %s\n", meta["description"])
	fmt.Printf("Features:    %s\n", meta["features"])
	fmt.Printf("Outputs:     %s\n", meta["outputs"])
	fmt.Printf("Format:     v%d\n", weights.Version)
	fmt.Printf("Activation: %s\n", activationIDToName(weights.Activation))
	fmt.Printf("Path:        %s\n", entry.Path)
	fmt.Printf("Checkpoints: %d\n", countCheckpoints(entry.Path))
}

func cmdRegister(args []string) {
	if len(args) < 2 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe register <name> <path>\n")
		os.Exit(1)
	}
	name := args[0]
	modelPath := args[1]

	absPath, err := filepath.Abs(modelPath)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	if _, err := os.Stat(filepath.Join(absPath, "model.meta")); err != nil {
		fmt.Fprintf(os.Stderr, "error: no model.meta found at %s\n", absPath)
		os.Exit(1)
	}

	meta, err := loadModelMeta(absPath)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	entries, err := loadRegistry()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	if findEntry(entries, name) != nil {
		fmt.Fprintf(os.Stderr, "error: model '%s' already registered\n", name)
		os.Exit(1)
	}

	modelType := meta["type"]
	if modelType == "" {
		modelType = "unknown"
	}

	entries = append(entries, RegistryEntry{
		Name:    name,
		Path:    absPath,
		Type:    modelType,
		Version: 1,
		Created: time.Now().Format("2006-01-02"),
		Tags:    []string{},
	})

	if err := saveRegistry(entries); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	fmt.Printf("Model '%s' registered successfully.\n", name)
}

