   202	func cmdRegister(args []string) {
   203	if len(args) < 2 {
   204	fmt.Fprintf(os.Stderr, "usage: mlpipe register <name> <path>\n")
   205	os.Exit(1)
   206	}
   207	name := args[0]
   208	modelPath := args[1]
   209	
   210	absPath, err := filepath.Abs(modelPath)
   211	if err != nil {
   212	fmt.Fprintf(os.Stderr, "error: %v\n", err)
   213	os.Exit(1)
   214	}
   215	
   216	if _, err := os.Stat(filepath.Join(absPath, "model.meta")); err != nil {
   217	fmt.Fprintf(os.Stderr, "error: no model.meta found at %s\n", absPath)
   218	os.Exit(1)
   219	}
   220	
   221	meta, err := loadModelMeta(absPath)
   222	if err != nil {
   223	fmt.Fprintf(os.Stderr, "error: %v\n", err)
   224	os.Exit(1)
   225	}
   226	
   227	entries, err := loadRegistry()
   228	if err != nil {
   229	fmt.Fprintf(os.Stderr, "error: %v\n", err)
   230	os.Exit(1)
   231	}
   232	
   233	if findEntry(entries, name) != nil {
   234	fmt.Fprintf(os.Stderr, "error: model '%s' already registered\n", name)
   235	os.Exit(1)
   236	}
   237	
   238	modelType := meta["type"]
   239	if modelType == "" {
   240	modelType = "unknown"
   241	}
   242	
   243	entries = append(entries, RegistryEntry{
   244	Name:    name,
   245	Path:    absPath,
   246	Type:    modelType,
   247	Version: 1,
   248	Created: time.Now().Format("2006-01-02"),
   249	Tags:    []string{},
   250	})
   251	
   252	if err := saveRegistry(entries); err != nil {
   253	fmt.Fprintf(os.Stderr, "error: %v\n", err)
   254	os.Exit(1)
   255	}
   256	fmt.Printf("Model '%s' registered successfully.\n", name)
   257	}
