   650	
   651		model := args[0]
   652		flags := parseFlags(args[1:])
   653	
   654		thresholdStr := flags["threshold"]
   655		if thresholdStr == "" || thresholdStr == "true" {
   656			fmt.Fprintf(os.Stderr, "error: --threshold is required\n")
   657			os.Exit(1)
   658		}
   659	
   660		threshold, err := strconv.ParseFloat(thresholdStr, 64)
   661		if err != nil {
   662			fmt.Fprintf(os.Stderr, "error: invalid threshold\n")
   663			os.Exit(1)
   664		}
   665		if threshold <= 0 {
   666			fmt.Fprintf(os.Stderr, "threshold must be positive\n")
   667			os.Exit(1)
   668		}
   669	
   670		dryRun := flags["dry-run"] == "true"
   671	
   672		entry, err := resolveModel(model)
   673		if err != nil {
   674			fmt.Fprintf(os.Stderr, "not found\n")
   675			os.Exit(1)
   676		}
   677	
   678		weights, err := loadWeights(entry.Path)
   679		if err != nil {
   680			fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
   681			os.Exit(1)
   682		}
   683	
   684		total := len(weights.Weights)
   685		pruned := 0
   686		for i, v := range weights.Weights {
   687			if math.Abs(v) < threshold {
   688				pruned++
   689				weights.Weights[i] = 0.0
   690			}
   691		}
   692	
   693		zeroCount := 0
   694		for _, v := range weights.Weights {
   695			if v == 0.0 {
   696				zeroCount++
   697			}
   698		}
   699	
   700		prunedPct := 0.0
   701		sparsity := 0.0
   702		if total > 0 {
   703			prunedPct = float64(pruned) / float64(total) * 100.0
   704			sparsity = float64(zeroCount) / float64(total) * 100.0
   705		}
   706	
   707		fmt.Printf("Pruning '%s' (threshold=%s)\n", model, thresholdStr)
   708		fmt.Printf("Total weights:  %d\n", total)
   709		fmt.Printf("Pruned:         %d (%.1f%%)\n", pruned, prunedPct)
   710		fmt.Printf("New sparsity:   %.1f%%\n", sparsity)
   711	
   712		if dryRun {
   713			fmt.Println("(dry run - no changes made)")
   714			return
   715		}
   716	
   717		cpDir := filepath.Join(checkpointsDir(entry.Path), "pre-prune")
   718		if err := os.MkdirAll(cpDir, 0755); err != nil {
   719			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   720			os.Exit(1)
   721		}
