   371	func cmdExplain(args []string) {
   372		if len(args) < 1 {
   373			fmt.Fprintf(os.Stderr, "usage: mlpipe explain <model> --input <file> [--row <N>]\n")
   374			os.Exit(1)
   375		}
   376	
   377		model := args[0]
   378		flags := parseFlags(args[1:])
   379	
   380		inputFile := flags["input"]
   381		if inputFile == "" || inputFile == "true" {
   382			fmt.Fprintf(os.Stderr, "error: --input is required\n")
   383			os.Exit(1)
   384		}
   385	
   386		rowNum := 1
   387		if flags["row"] != "" && flags["row"] != "true" {
   388			n, err := strconv.Atoi(flags["row"])
   389			if err != nil || n < 1 {
   390				fmt.Fprintln(os.Stderr, "row out of range")
   391				os.Exit(1)
   392			}
   393			rowNum = n
   394		}
   395	
   396		entry, err := resolveModel(model)
   397		if err != nil {
   398			fmt.Fprintln(os.Stderr, "not found")
   399			os.Exit(1)
   400		}
   401	
   402		weights, cfg, err := loadModelArtifacts(entry.Path)
   403		if err != nil {
   404			fmt.Fprintln(os.Stderr, "not found")
   405			os.Exit(1)
   406		}
   407	
   408		inputs, err := readInputCSV(inputFile)
   409		if err != nil {
   410			fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
   411			os.Exit(1)
   412		}
   413	
   414		if rowNum < 1 || rowNum > len(inputs) {
   415			fmt.Fprintln(os.Stderr, "row out of range")
   416			os.Exit(1)
   417		}
   418	
   419		processed := preprocess(inputs, cfg)
   420		idx := rowNum - 1
   421		row := processed[idx]
   422	
   423		fmt.Printf("Explaining prediction for row %d:\n", rowNum)
   424		fmt.Printf("Input:  %s\n", formatFloatList(inputs[idx]))
   425		fmt.Printf("Preprocessed: %s\n", formatFloatList(row))
   426		fmt.Println()
   427		fmt.Println("Computation:")
   428	
   429		outputs := make([]float64, weights.NumOutputs)
