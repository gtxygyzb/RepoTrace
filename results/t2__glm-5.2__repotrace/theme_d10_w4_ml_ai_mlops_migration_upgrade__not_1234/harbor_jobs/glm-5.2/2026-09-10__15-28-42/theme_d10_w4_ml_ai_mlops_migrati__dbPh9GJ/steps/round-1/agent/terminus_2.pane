   443			fmt.Printf("  raw output = %s\n", formatFloat(sum))
   444			activated := applyActivation(sum, weights.Activation)
   445			outputs[o] = activated
   446			fmt.Printf("  activation(%s) = %s\n", activationIDToName(weights.Activation), formatFloat(activated))
   447			if o+1 < weights.NumOutputs {
   448				fmt.Println()
   449			}
   450		}
   451	
   452		fmt.Println()
   453		final := postprocess([][]float64{outputs}, cfg)
   454		fmt.Printf("Final output: %s\n", formatFloatList(final[0]))
   455	}
