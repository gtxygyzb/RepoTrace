   131	
   132		name := flags["to"]
   133		if name == "" {
   134			fmt.Fprintf(os.Stderr, "error: --to is required\n")
   135			os.Exit(1)
   136		}
   137	
   138		entry, err := resolveModel(model)
   139		if err != nil {
   140			fmt.Fprintf(os.Stderr, "not found\n")
   141			os.Exit(1)
   142		}
   143	
   144		cpDir := filepath.Join(checkpointsDir(entry.Path), name)
   145		if _, err := os.Stat(cpDir); err != nil {
   146			fmt.Fprintf(os.Stderr, "checkpoint not found\n")
