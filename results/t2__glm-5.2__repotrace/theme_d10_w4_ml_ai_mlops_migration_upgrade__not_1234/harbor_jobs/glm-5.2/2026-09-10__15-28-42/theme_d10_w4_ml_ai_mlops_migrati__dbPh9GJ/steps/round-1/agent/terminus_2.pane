   152			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   153			os.Exit(1)
   154		}
   155	
   156		for _, cpEntry := range entries {
   157			if cpEntry.IsDir() {
   158				continue
   159			}
   160			data, err := os.ReadFile(filepath.Join(cpDir, cpEntry.Name()))
   161			if err != nil {
   162				fmt.Fprintf(os.Stderr, "error: %v\n", err)
