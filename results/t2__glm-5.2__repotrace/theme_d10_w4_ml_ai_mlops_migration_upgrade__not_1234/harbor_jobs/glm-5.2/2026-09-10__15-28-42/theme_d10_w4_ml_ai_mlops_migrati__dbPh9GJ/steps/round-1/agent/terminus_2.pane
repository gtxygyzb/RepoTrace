    53	func readCSVRaw(path string) ([][]string, error) {
    54		f, err := os.Open(path)
    55		if err != nil {
    56			return nil, err
    57		}
    58		defer f.Close()
    59	
    60		reader := csv.NewReader(f)
    61		reader.FieldsPerRecord = -1
    62		return reader.ReadAll()
    63	}
    64	
    65	func isMissingValue(val string) bool {
    66		val = strings.TrimSpace(val)
    67		if val == "" {
    68			return true
    69		}
    70		lower := strings.ToLower(val)
    71		return lower == "na" || lower == "nan"
    72	}
    73	
    74	func cmdStats(args []string) {
    75		flags := parseFlags(args)
    76		input := flags["input"]
    77		if input == "" {
    78			fmt.Fprintf(os.Stderr, "usage: mlpipe stats --input <file>\n")
    79			os.Exit(1)
    80		}
    81	
    82		records, err := readCSVRaw(input)
    83		if err != nil {
    84			fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
    85			os.Exit(1)
    86		}
    87		if len(records) == 0 {
    88			fmt.Println("No data found.")
    89			return
    90		}
    91	
    92		hasHeader := isHeader(records[0])
    93		start := 0
    94		if hasHeader {
    95			start = 1
    96		}
    97	
    98		numCols := 0
    99		for _, rec := range records {
   100			if len(rec) > numCols {
   101				numCols = len(rec)
   102			}
   103		}
   104	
   105		headers := make([]string, numCols)
   106		for i := 0; i < numCols; i++ {
   107			if hasHeader && i < len(records[0]) {
   108				headers[i] = strings.TrimSpace(records[0][i])
   109			} else {
   110				headers[i] = fmt.Sprintf("col_%d", i)
   111			}
   112		}
   113	
   114		type colStat struct {
   115			idx     int
   116			name    string
   117			count   int
   118			missing int
   119			min     float64
   120			max     float64
   121			mean    float64
   122			stddev  float64
   123			values  []float64
   124		}
   125	
   126		var stats []colStat
   127		numericCols := make([]int, 0)
   128		valuesByCol := make(map[int][]float64)
   129		var skippedCols []string
   130	
   131		for j := 0; j < numCols; j++ {
   132			values := make([]float64, 0, len(records)-start)
   133			missing := 0
   134			numeric := true
   135	
   136			for i := start; i < len(records); i++ {
   137				raw := ""
   138				if j < len(records[i]) {
   139					raw = strings.TrimSpace(records[i][j])
   140				}
   141				if isMissingValue(raw) {
   142					missing++
   143					values = append(values, math.NaN())
   144					continue
   145				}
   146				v, err := strconv.ParseFloat(raw, 64)
   147				if err != nil {
   148					numeric = false
   149					break
   150				}
   151				values = append(values, v)
   152			}
   153	
   154			if !numeric {
   155				skippedCols = append(skippedCols, headers[j])
   156				continue
   157			}
   158	
   159			count := len(values) - missing
   160			st := colStat{
   161				idx:     j,
   162				name:    headers[j],
   163				count:   count,
   164				missing: missing,
   165				min:     math.NaN(),
   166				max:     math.NaN(),
   167				mean:    math.NaN(),
   168				stddev:  math.NaN(),
   169				values:  values,
   170			}
   171	
   172			if count > 0 {
   173				sum := 0.0
   174				sumSq := 0.0
   175				minVal := math.Inf(1)
   176				maxVal := math.Inf(-1)
   177				for _, v := range values {
   178					if math.IsNaN(v) {
   179						continue
   180					}
   181					if v < minVal {
   182						minVal = v
   183					}
   184					if v > maxVal {
   185						maxVal = v
   186					}
   187					sum += v
   188					sumSq += v * v
   189				}
   190				mean := sum / float64(count)
   191				variance := sumSq/float64(count) - mean*mean
   192				if variance < 0 {
   193					variance = 0
   194				}
   195				st.min = minVal
   196				st.max = maxVal
   197				st.mean = mean
   198				st.stddev = math.Sqrt(variance)
   199			}
   200	
   201			stats = append(stats, st)
   202			numericCols = append(numericCols, j)
   203			valuesByCol[j] = values
   204		}
   205	
   206		if len(skippedCols) > 0 {
   207			fmt.Printf("warning: skipping non-numeric columns: %s\n", strings.Join(skippedCols, ", "))
   208		}
   209		if len(numericCols) == 0 {
   210			fmt.Println("error: no numeric columns found")
   211			os.Exit(1)
   212		}
   213	
   214		fmt.Println("Per-column statistics:")
   215		fmt.Printf("%-20s %6s %7s %12s %12s %12s %12s\n", "column", "count", "missing", "min", "max", "mean", "stddev")
   216		for _, st := range stats {
   217			fmt.Printf("%-20s %6d %7d %12.4f %12.4f %12.4f %12.4f\n", st.name, st.count, st.missing, st.min, st.max, st.mean, st.stddev)
   218		}
   219	
   220		fmt.Println("\nPearson correlation matrix:")
