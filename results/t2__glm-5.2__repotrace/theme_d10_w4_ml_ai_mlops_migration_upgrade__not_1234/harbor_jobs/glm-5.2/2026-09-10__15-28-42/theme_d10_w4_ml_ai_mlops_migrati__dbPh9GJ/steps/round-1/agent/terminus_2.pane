    13	
    14	func modelDirExists(path string) bool {
    15		info, err := os.Stat(path)
    16		return err == nil && info.IsDir()
    17	}
    18	
    19	func resolveModel(name string) (*RegistryEntry, error) {
    20		entries, err := loadRegistry()
    21		if err != nil {
    22			return nil, err
    23		}
    24		entry := findEntry(entries, name)
    25		if entry == nil || !modelDirExists(entry.Path) {
    26			fmt.Fprintln(os.Stderr, "not found")
    27			os.Exit(1)
    28		}
    29		return entry, nil
    30	}
    31	
    32	func loadModelArtifacts(modelDir string) (*WeightsData, *PipelineConfig, error) {
    33		weights, err := loadWeights(modelDir)
    34		if err != nil {
    35			return nil, nil, err
    36		}
    37		cfg, err := loadPipelineConfig(modelDir)
    38		if err != nil {
    39			return nil, nil, err
    40		}
    41		return weights, cfg, nil
    42	}
    43	
    44	func validateFeatureCount(inputs [][]float64, expected int) error {
    45		for i, row := range inputs {
    46			if len(row) != expected {
    47				return fmt.Errorf("expected %d features, got %d in row %d", expected, len(row), i)
    48			}
    49		}
    50		return nil
    51	}
    52	
    53	func readCSVRaw(path string) ([][]string, error) {
    54		f, err := os.Open(path)
    55		if err != nil {
    56			return nil, err
    57		}
    58		defer f.Close()
    59	
    60		reader := csv.NewReader(f)
    61		reader.FieldsPerRecord = -1
    62		return reader.ReadAll()
    63	}
    64	
    65	func isMissingValue(val string) bool {
    66		val = strings.TrimSpace(val)
    67		if val == "" {
    68			return true
    69		}
    70		lower := strings.ToLower(val)
    71		return lower == "na" || lower == "nan"
    72	}
    73	
    74	func cmdStats(args []string) {
    75		flags := parseFlags(args)
    76		input := flags["input"]
    77		if input == "" {
    78			fmt.Fprintf(os.Stderr, "usage: mlpipe stats --input <file>\n")
    79			os.Exit(1)
    80		}
    81	
    82		records, err := readCSVRaw(input)
    83		if err != nil {
    84			fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
    85			os.Exit(1)
    86		}
    87		if len(records) == 0 {
    88			fmt.Println("No data found.")
    89			return
    90		}
    91	
    92		hasHeader := isHeader(records[0])
    93		start := 0
    94		if hasHeader {
    95			start = 1
    96		}
    97	
    98		numCols := 0
    99		for _, rec := range records {
   100			if len(rec) > numCols {
   101				numCols = len(rec)
   102			}
   103		}
   104	
   105		headers := make([]string, numCols)
   106		for i := 0; i < numCols; i++ {
   107			if hasHeader && i < len(records[0]) {
   108				headers[i] = strings.TrimSpace(records[0][i])
   109			} else {
   110				headers[i] = fmt.Sprintf("col_%d", i)
   111			}
   112		}
   113	
   114		type colStat struct {
   115			idx     int
   116			name    string
   117			count   int
   118			missing int
   119			min     float64
   120			max     float64
   121			mean    float64
   122			stddev  float64
   123			values  []float64
   124		}
   125	
   126		var stats []colStat
   127		numericCols := make([]int, 0)
   128		valuesByCol := make(map[int][]float64)
   129		var skippedCols []string
   130	
   131		for j := 0; j < numCols; j++ {
   132			values := make([]float64, 0, len(records)-start)
   133			missing := 0
   134			numeric := true
   135	
   136			for i := start; i < len(records); i++ {
