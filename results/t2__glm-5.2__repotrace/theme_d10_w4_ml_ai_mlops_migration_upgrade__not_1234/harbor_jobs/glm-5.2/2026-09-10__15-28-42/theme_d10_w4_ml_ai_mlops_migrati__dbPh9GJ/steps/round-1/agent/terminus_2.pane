    13	
    14	var modelMagic = []byte("MLPW")
    15	
    16	func loadModelMeta(modelDir string) (map[string]string, error) {
    17		f, err := os.Open(filepath.Join(modelDir, "model.meta"))
    18		if err != nil {
    19			return nil, err
    20		}
    21		defer f.Close()
    22	
    23		meta := make(map[string]string)
    24		scanner := bufio.NewScanner(f)
    25		for scanner.Scan() {
    26			line := strings.TrimSpace(scanner.Text())
    27			if line == "" || strings.HasPrefix(line, "#") {
    28				continue
    29			}
    30			parts := strings.SplitN(line, "=", 2)
    31			if len(parts) == 2 {
    32				meta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])
    33			}
    34		}
    35		return meta, scanner.Err()
    36	}
    37	
    38	type WeightsData struct {
    39		Version     uint32
    40		NumFeatures uint32
    41		NumOutputs  uint32
    42		Weights     []float64
    43		Bias        []float64
    44	}
    45	
    46	func loadWeights(modelDir string) (*WeightsData, error) {
    47		f, err := os.Open(filepath.Join(modelDir, "weights.bin"))
    48		if err != nil {
    49			return nil, err
    50		}
    51		defer f.Close()
    52	
    53		magic := make([]byte, 4)
    54		if _, err := f.Read(magic); err != nil {
    55			return nil, fmt.Errorf("failed to read magic: %v", err)
    56		}
    57		if string(magic) != string(modelMagic) {
    58			return nil, fmt.Errorf("invalid model file: bad magic")
    59		}
    60	
    61		var ver, nf, no uint32
    62		if err := binary.Read(f, binary.LittleEndian, &ver); err != nil {
    63			return nil, fmt.Errorf("failed to read version: %v", err)
    64		}
    65		if err := binary.Read(f, binary.LittleEndian, &nf); err != nil {
    66			return nil, fmt.Errorf("failed to read num_features: %v", err)
    67		}
    68		// BUG: reads num_outputs as BigEndian instead of LittleEndian
    69		if err := binary.Read(f, binary.BigEndian, &no); err != nil {
    70			return nil, fmt.Errorf("failed to read num_outputs: %v", err)
    71		}
    72	
    73		weights := make([]float64, nf*no)
    74		for i := range weights {
    75			if err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {
    76				return nil, fmt.Errorf("failed to read weight[%d]: %v", i, err)
    77			}
    78		}
    79	
    80		bias := make([]float64, no)
    81		for i := range bias {
    82			if err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {
    83				return nil, fmt.Errorf("failed to read bias[%d]: %v", i, err)
    84			}
    85		}
    86	
    87		return &WeightsData{
    88			Version:     ver,
    89			NumFeatures: nf,
    90			NumOutputs:  no,
    91			Weights:     weights,
    92			Bias:        bias,
    93		}, nil
    94	}
    95	
    96	func writeWeights(path string, w *WeightsData) error {
    97		f, err := os.Create(path)
    98		if err != nil {
    99			return err
   100		}
   101		defer f.Close()
   102	
   103		if _, err := f.Write(modelMagic); err != nil {
   104			return err
   105		}
   106		if err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {
   107			return err
   108		}
   109		if err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {
   110			return err
   111		}
   112		if err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {
   113			return err
   114		}
   115		for _, v := range w.Weights {
   116			if err := binary.Write(f, binary.LittleEndian, v); err != nil {
   117				return err
   118			}
   119		}
   120		for _, v := range w.Bias {
   121			if err := binary.Write(f, binary.LittleEndian, v); err != nil {
   122				return err
   123			}
   124		}
   125		return nil
   126	}
   127	
   128	type PipelineConfig struct {
   129		Normalize       bool
   130		ScaleMin        float64
   131		ScaleMax        float64
   132		MissingStrategy string
   133		RoundDigits     int
   134		ClipMin         float64
   135		ClipMax         float64
   136	}
   137	
   138	func loadPipelineConfig(modelDir string) (*PipelineConfig, error) {
   139		f, err := os.Open(filepath.Join(modelDir, "pipeline.cfg"))
   140		if err != nil {
   141			return nil, err
   142		}
   143		defer f.Close()
   144	
   145		cfg := &PipelineConfig{
   146			ScaleMin:        0.0,
   147			ScaleMax:        1.0,
   148			MissingStrategy: "zero",
   149			RoundDigits:     4,
   150			ClipMin:         -1000.0,
   151			ClipMax:         1000.0,
   152		}
   153	
   154		scanner := bufio.NewScanner(f)
   155		section := ""
   156		for scanner.Scan() {
   157			line := strings.TrimSpace(scanner.Text())
   158			if line == "" || strings.HasPrefix(line, "#") {
   159				continue
   160			}
   161			if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
   162				section = line[1 : len(line)-1]
   163				continue
   164			}
   165			parts := strings.SplitN(line, "=", 2)
   166			if len(parts) != 2 {
   167				continue
   168			}
   169			key := strings.TrimSpace(parts[0])
   170			val := strings.TrimSpace(parts[1])
   171	
   172			switch section {
   173			case "preprocess":
   174				switch key {
   175				case "normalize":
   176					cfg.Normalize = val == "true"
   177				case "scale_range":
   178					rangeParts := strings.Split(val, ",")
   179					if len(rangeParts) == 2 {
   180						cfg.ScaleMin, _ = strconv.ParseFloat(rangeParts[0], 64)
   181						cfg.ScaleMax, _ = strconv.ParseFloat(rangeParts[1], 64)
   182					}
   183				case "missing_strategy":
   184					cfg.MissingStrategy = val
   185				}
   186			case "postprocess":
   187				switch key {
   188				case "round_digits":
   189					cfg.RoundDigits, _ = strconv.Atoi(val)
   190				case "clip_min":
   191					cfg.ClipMin, _ = strconv.ParseFloat(val, 64)
   192				case "clip_max":
   193					cfg.ClipMax, _ = strconv.ParseFloat(val, 64)
   194				}
   195			}
   196		}
   197		return cfg, scanner.Err()
   198	}
   199	
   200	func roundToDigits(val float64, digits int) float64 {
   201		pow := math.Pow(10, float64(digits))
   202		return math.Round(val*pow) / pow
   203	}
