    11	func main() {
    12		if len(os.Args) < 2 {
    13			printUsage()
    14			os.Exit(1)
    15		}
    16	
    17		command := os.Args[1]
    18		args := os.Args[2:]
    19	
    20		switch command {
    21		case "list":
    22			cmdList(args)
    23		case "info":
    24			cmdInfo(args)
    25		case "register":
    26			cmdRegister(args)
    27		case "remove":
    28			cmdRemove(args)
    29		case "run":
    30			cmdRun(args)
    31		case "stats":
    32			cmdStats(args)
    33		case "diff":
    34			cmdDiff(args)
    35		case "batch":
    36			cmdBatch(args)
    37		case "validate":
    38			cmdValidate(args)
    39		case "export":
    40			cmdExport(args)
    41		case "version":
    42			fmt.Printf("mlpipe version %s\n", version)
    43		case "help":
    44			printUsage()
    45		default:
    46			fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
    47			printUsage()
    48			os.Exit(1)
    49		}
    50	}
    51	
    52	func printUsage() {
    53		usage := `mlpipe - ML Inference Pipeline Manager
    54	
    55	Usage: mlpipe <command> [arguments]
    56	
    57	Commands:
    58	  list                          List all registered models
    59	  info <model>                  Show model details
    60	  register <name> <path>        Register a model from directory
    61	  remove <name>                 Remove a model from registry
    62	  run <model> [options]         Run inference
    63	  stats --input <file>          Input statistics profiling
    64	  diff <model1> <model2> --input <file>
    65	                                Compare two models on same input
    66	  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
    67	                                Batch inference over CSV files
    68	  validate <model>              Validate model integrity
    69	  export <model> --output <dir> Export model to directory
    70	  version                       Show version
    71	  help                          Show this help
    72	
    73	Run/Diff Options:
    74	  --input <file>    Input CSV file (required)
    75	  --output <file>   Output file (default: stdout)
    76	  --format <fmt>    Output format: csv or json (default: csv)
    77	
    78	Batch Options:
    79	  --dir <dir>       Input directory of CSV files
    80	  --output-dir <dir> Output directory for predictions
    81	  --format <fmt>    Output format: csv or json (default: csv)
    82	`
    83		fmt.Print(usage)
    84	}
    85	
    86	func parseFlags(args []string) map[string]string {
    87		flags := make(map[string]string)
    88		for i := 0; i < len(args); i++ {
    89			if strings.HasPrefix(args[i], "--") {
    90				key := strings.TrimPrefix(args[i], "--")
    91				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
    92					flags[key] = args[i+1]
    93					i++
    94				} else {
    95					flags[key] = "true"
    96				}
    97			}
    98		}
    99		return flags
   100	}
