   218	type PipelineConfig struct {
   219		Normalize       bool
   220		ScaleMin        float64
[?2004hroot@n30009:/app# nl -ba registry.go
[?2004l     1	package main
     2	
     3	import (
     4		"bufio"
     5		"fmt"
     6		"os"
     7		"path/filepath"
     8		"strings"
     9		"time"
    10	)
    11	
    12	const registryFile = "/app/models/registry.idx"
    13	
    14	type RegistryEntry struct {
    15		Name    string
    16		Path    string
    17		Type    string
    18		Version int
    19		Created string
    20	}
    21	
    22	func loadRegistry() ([]RegistryEntry, error) {
    23		f, err := os.Open(registryFile)
    24		if err != nil {
    25			if os.IsNotExist(err) {
    26				return nil, nil
    27			}
    28			return nil, err
    29		}
    30		defer f.Close()
    31	
    32		var entries []RegistryEntry
    33		scanner := bufio.NewScanner(f)
    34		for scanner.Scan() {
    35			line := strings.TrimSpace(scanner.Text())
    36			if line == "" || strings.HasPrefix(line, "#") {
    37				continue
    38			}
    39			parts := strings.Split(line, "|")
    40			if len(parts) != 5 {
    41				continue
    42			}
    43			ver := 1
    44			fmt.Sscanf(parts[3], "%d", &ver)
    45			entries = append(entries, RegistryEntry{
    46				Name:    parts[0],
    47				Path:    parts[1],
    48				Type:    parts[2],
    49				Version: ver,
    50				Created: parts[4],
    51			})
    52		}
    53		return entries, scanner.Err()
    54	}
    55	
    56	func saveRegistry(entries []RegistryEntry) error {
    57		dir := filepath.Dir(registryFile)
    58		if err := os.MkdirAll(dir, 0755); err != nil {
    59			return err
    60		}
    61	
    62		f, err := os.Create(registryFile)
    63		if err != nil {
    64			return err
    65		}
    66		defer f.Close()
    67	
    68		fmt.Fprintln(f, "# mlpipe registry v1")
    69		for _, e := range entries {
    70			fmt.Fprintf(f, "%s|%s|%s|%d|%s\n", e.Name, e.Path, e.Type, e.Version, e.Created)
    71		}
    72		return nil
    73	}
    74	
    75	func findEntry(entries []RegistryEntry, name string) *RegistryEntry {
    76		for i := range entries {
    77			if entries[i].Name == name {
    78				return &entries[i]
    79			}
    80		}
    81		return nil
    82	}
    83	
    84	func cmdList(args []string) {
    85		entries, err := loadRegistry()
    86		if err != nil {
    87			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    88			os.Exit(1)
    89		}
    90		if len(entries) == 0 {
    91			fmt.Println("No models registered.")
    92			return
    93		}
    94		fmt.Printf("%-20s %-10s %-8s %s\n", "NAME", "TYPE", "VERSION", "CREATED")
    95		for _, e := range entries {
    96			fmt.Printf("%-20s %-10s %-8d %s\n", e.Name, e.Type, e.Version, e.Created)
    97		}
    98	}
