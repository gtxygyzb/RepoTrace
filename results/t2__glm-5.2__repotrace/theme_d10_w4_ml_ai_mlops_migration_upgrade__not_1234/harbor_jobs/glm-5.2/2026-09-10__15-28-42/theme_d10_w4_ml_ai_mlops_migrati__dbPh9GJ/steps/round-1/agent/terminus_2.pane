   135	func runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {
   136		processed := preprocess(inputs, cfg)
   137	
   138		results := make([][]float64, len(processed))
   139		for i, row := range processed {
   140			output := make([]float64, weights.NumOutputs)
   141			for o := uint32(0); o < weights.NumOutputs; o++ {
   142				sum := weights.Bias[o]
   143				for f := uint32(0); f < weights.NumFeatures; f++ {
   144					if int(f) < len(row) {
   145						sum += row[f] * weights.Weights[o*weights.NumFeatures+f]
   146					}
   147				}
   148				output[o] = applyActivation(sum, weights.Activation)
   149			}
   150			results[i] = output
   151		}
   152	
   153		return postprocess(results, cfg)
   154	}
