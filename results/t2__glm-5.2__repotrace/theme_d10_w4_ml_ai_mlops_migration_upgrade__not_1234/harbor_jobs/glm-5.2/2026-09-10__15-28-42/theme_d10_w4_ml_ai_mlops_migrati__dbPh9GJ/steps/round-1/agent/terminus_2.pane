   339			for o := 0; o < maxOut; o++ {
   340				d := math.Abs(r1[i][o] - r2[i][o])
   341				diffs[o] = d
   342				sumAbs += d
   343				sumSq += d * d
   344				if d > maxAbs {
   345					maxAbs = d
   346				}
   347				count++
   348			}
   349			fmt.Printf("row %d: %v\n", i, diffs)
   350		}
   351	
   352		var mae, rmse float64
   353		if count > 0 {
