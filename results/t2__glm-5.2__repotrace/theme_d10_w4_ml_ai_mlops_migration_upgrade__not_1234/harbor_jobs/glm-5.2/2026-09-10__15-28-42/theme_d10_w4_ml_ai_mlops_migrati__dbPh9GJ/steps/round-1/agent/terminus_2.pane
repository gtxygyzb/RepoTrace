    13	func cmdRun(args []string) {
    14		if len(args) < 1 {
    15			fmt.Fprintf(os.Stderr, "usage: mlpipe run <model> [--input <file>] [--output <file>] [--format csv|json]\n")
    16			os.Exit(1)
    17		}
    18	
    19		modelName := args[0]
    20		flags := parseFlags(args[1:])
    21	
    22		inputFile := flags["input"]
    23		if inputFile == "" {
    24			fmt.Fprintf(os.Stderr, "error: --input is required\n")
    25			os.Exit(1)
    26		}
    27	
    28		outputFormat := flags["format"]
    29		if outputFormat == "" {
    30			outputFormat = "csv"
    31		}
    32		if outputFormat != "csv" && outputFormat != "json" {
    33			fmt.Fprintf(os.Stderr, "error: unsupported format '%s', use 'csv' or 'json'\n", outputFormat)
    34			os.Exit(1)
    35		}
    36	
    37		entries, err := loadRegistry()
    38		if err != nil {
    39			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    40			os.Exit(1)
    41		}
    42	
    43		entry := findEntry(entries, modelName)
    44		if entry == nil {
    45			fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", modelName)
    46			os.Exit(1)
    47		}
    48	
    49		weights, err := loadWeights(entry.Path)
    50		if err != nil {
    51			fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
    52			os.Exit(1)
    53		}
    54	
    55		pipelineCfg, err := loadPipelineConfig(entry.Path)
    56		if err != nil {
    57			fmt.Fprintf(os.Stderr, "error loading pipeline config: %v\n", err)
    58			os.Exit(1)
    59		}
    60	
    61		inputs, err := readInputCSV(inputFile)
    62		if err != nil {
    63			fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
    64			os.Exit(1)
    65		}
    66	
    67		results := runInference(inputs, weights, pipelineCfg)
    68	
    69		outputFile := flags["output"]
    70		if outputFile != "" {
    71			f, err := os.Create(outputFile)
    72			if err != nil {
    73				fmt.Fprintf(os.Stderr, "error creating output file: %v\n", err)
    74				os.Exit(1)
    75			}
    76			defer f.Close()
    77			writeOutput(f, results, outputFormat)
    78		} else {
    79			writeOutput(os.Stdout, results, outputFormat)
    80		}
    81	}
    82	
    83	func readInputCSV(path string) ([][]float64, error) {
    84		f, err := os.Open(path)
    85		if err != nil {
    86			return nil, err
    87		}
    88		defer f.Close()
    89	
    90		reader := csv.NewReader(f)
    91		records, err := reader.ReadAll()
    92		if err != nil {
    93			return nil, err
    94		}
    95	
    96		var data [][]float64
    97		for i, record := range records {
    98			if i == 0 && isHeader(record) {
    99				continue
   100			}
   101			row := make([]float64, len(record))
   102			for j, val := range record {
   103				val = strings.TrimSpace(val)
   104				if val == "" || val == "NA" || val == "nan" {
   105					row[j] = math.NaN()
   106				} else {
   107					row[j], err = strconv.ParseFloat(val, 64)
   108					if err != nil {
   109						return nil, fmt.Errorf("row %d col %d: %v", i, j, err)
   110					}
   111				}
   112			}
   113			data = append(data, row)
   114		}
   115		return data, nil
   116	}
   117	
   118	func isHeader(record []string) bool {
   119		for _, val := range record {
   120			_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)
   121			if err == nil {
   122				return false
   123			}
   124		}
   125		return true
   126	}
   127	
   128	func runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {
   129		processed := preprocess(inputs, cfg)
   130	
   131		results := make([][]float64, len(processed))
   132		for i, row := range processed {
   133			output := make([]float64, weights.NumOutputs)
   134			for o := uint32(0); o < weights.NumOutputs; o++ {
   135				sum := weights.Bias[o]
   136				for f := uint32(0); f < weights.NumFeatures; f++ {
   137					if int(f) < len(row) {
   138						sum += row[f] * weights.Weights[o*weights.NumFeatures+f]
   139					}
   140				}
   141				output[o] = sum
   142			}
   143			results[i] = output
   144		}
   145	
   146		return postprocess(results, cfg)
   147	}
   148	
   149	func preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {
   150		result := make([][]float64, len(inputs))
   151		for i, row := range inputs {
   152			result[i] = make([]float64, len(row))
   153			copy(result[i], row)
   154		}
   155	
   156		for i, row := range result {
   157			for j, val := range row {
   158				if math.IsNaN(val) {
   159					switch cfg.MissingStrategy {
   160					case "zero":
   161						result[i][j] = 0.0
   162					case "mean":
   163						result[i][j] = computeColumnMean(inputs, j)
   164					}
   165				}
   166			}
   167		}
   168	
   169		if cfg.Normalize {
   170			for j := 0; j < len(result[0]); j++ {
   171				minVal, maxVal := columnMinMax(result, j)
   172				rangeVal := maxVal - minVal
   173				if rangeVal == 0 {
   174					rangeVal = 1.0
   175				}
   176				for i := range result {
   177					// BUG: normalization formula incorrect - should map to [ScaleMin, ScaleMax]
   178					// but uses wrong formula that doesn't properly apply the target range
   179					normalized := (result[i][j] - minVal) / rangeVal
   180					result[i][j] = normalized * cfg.ScaleMax
   181				}
   182			}
   183		}
   184	
   185		return result
   186	}
   187	
   188	func postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {
   189		for i, row := range results {
   190			for j, val := range row {
   191				val = math.Max(val, cfg.ClipMin)
   192				val = math.Min(val, cfg.ClipMax)
   193				results[i][j] = roundToDigits(val, cfg.RoundDigits)
   194			}
   195		}
   196		return results
   197	}
   198	
   199	func computeColumnMean(data [][]float64, col int) float64 {
   200		sum := 0.0
   201		count := 0
   202		for _, row := range data {
   203			if col < len(row) && !math.IsNaN(row[col]) {
   204				sum += row[col]
   205				count++
   206			}
   207		}
   208		if count == 0 {
   209			return 0.0
   210		}
   211		return sum / float64(count)
   212	}
   213	
   214	func columnMinMax(data [][]float64, col int) (float64, float64) {
   215		minVal := math.Inf(1)
   216		maxVal := math.Inf(-1)
   217		for _, row := range data {
   218			if col < len(row) {
   219				if row[col] < minVal {
   220					minVal = row[col]
[?2004hroot@n30009:/app# nl -ba inference.go | sed -n '221,440p'
[?2004l   221				}
   222				if row[col] > maxVal {
   223					maxVal = row[col]
   224				}
   225			}
   226		}
   227		return minVal, maxVal
   228	}
   229	
   230	func writeOutput(f *os.File, results [][]float64, format string) {
   231		switch format {
   232		case "csv":
   233			writer := csv.NewWriter(f)
   234			header := make([]string, len(results[0]))
   235			for i := range header {
   236				header[i] = fmt.Sprintf("output_%d", i)
   237			}
   238			writer.Write(header)
   239			for _, row := range results {
   240				record := make([]string, len(row))
   241				for j, val := range row {
   242					record[j] = strconv.FormatFloat(val, 'f', -1, 64)
   243				}
   244				writer.Write(record)
   245			}
   246			writer.Flush()
   247		case "json":
   248			type Prediction struct {
   249				Outputs []float64 `json:"outputs"`
   250			}
   251			type Result struct {
   252				Predictions []Prediction `json:"predictions"`
   253			}
   254			r := Result{}
   255			for _, row := range results {
   256				r.Predictions = append(r.Predictions, Prediction{Outputs: row})
   257			}
   258			enc := json.NewEncoder(f)
   259			enc.SetIndent("", "  ")
   260			enc.Encode(r)
   261		}
   262	}
