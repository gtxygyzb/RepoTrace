    98	func parseFlags(args []string) map[string]string {
    99		flags := make(map[string]string)
   100		for i := 0; i < len(args); i++ {
   101			if strings.HasPrefix(args[i], "--") {
   102				key := strings.TrimPrefix(args[i], "--")
   103				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
   104					flags[key] = args[i+1]
   105					i++
   106				} else {
   107					flags[key] = "true"
   108				}
   109			}
   110		}
   111		return flags
   112	}
