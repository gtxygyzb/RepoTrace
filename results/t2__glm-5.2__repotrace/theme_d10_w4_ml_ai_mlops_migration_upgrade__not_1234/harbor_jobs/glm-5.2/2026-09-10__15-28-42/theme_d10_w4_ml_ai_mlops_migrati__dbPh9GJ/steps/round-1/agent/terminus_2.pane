   104	func parseFlags(args []string) map[string]string {
   105		flags := make(map[string]string)
   106		for i := 0; i < len(args); i++ {
   107			if strings.HasPrefix(args[i], "--") {
   108				key := strings.TrimPrefix(args[i], "--")
   109				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
   110					flags[key] = args[i+1]
   111					i++
   112				} else {
   113					flags[key] = "true"
   114				}
   115			}
   116		}
   117		return flags
   118	}
