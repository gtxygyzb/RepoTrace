[?2004l===== main dispatch =====
package main

import (
	"fmt"
	"os"
	"strings"
)

const version = "0.1.0"

func main() {
	if len(os.Args) < 2 {
		printUsage()
		os.Exit(1)
	}

	command := os.Args[1]
	args := os.Args[2:]

	switch command {
	case "list":
		cmdList(args)
	case "info":
		cmdInfo(args)
	case "register":
		cmdRegister(args)
	case "remove":
		cmdRemove(args)
	case "run":
		cmdRun(args)
	case "stats":
		cmdStats(args)
	case "diff":
		cmdDiff(args)
	case "batch":
		cmdBatch(args)
	case "validate":
		cmdValidate(args)
	case "export":
		cmdExport(args)
	case "migrate":
		cmdMigrate(args)
	case "compat":
		cmdCompat(args)
	case "version":
		fmt.Printf("mlpipe version %s\n", version)
	case "help":
		printUsage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
		printUsage()
		os.Exit(1)
	}
}

func printUsage() {
	usage := `mlpipe - ML Inference Pipeline Manager

Usage: mlpipe <command> [arguments]

Commands:
  list                          List all registered models
  info <model>                  Show model details
  register <name> <path>        Register a model from directory
  remove <name>                 Remove a model from registry
  run <model> [options]         Run inference
  stats --input <file>          Input statistics profiling
  diff <model1> <model2> --input <file>
                                Compare two models on same input
  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
                                Batch inference over CSV files
  validate <model>              Validate model integrity
  export <model> --output <dir> Export model to directory
  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
  compat [--all]                 Check migration compatibility
  version                       Show version
  help                          Show this help

Run/Diff Options:
  --input <file>    Input CSV file (required)
  --output <file>   Output file (default: stdout)
  --format <fmt>    Output format: csv or json (default: csv)

Batch Options:
  --dir <dir>       Input directory of CSV files
  --output-dir <dir> Output directory for predictions
  --format <fmt>    Output format: csv or json (default: csv)
`
	fmt.Print(usage)
}

func parseFlags(args []string) map[string]string {
	flags := make(map[string]string)
	for i := 0; i < len(args); i++ {
		if strings.HasPrefix(args[i], "--") {
			key := strings.TrimPrefix(args[i], "--")
			if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
				flags[key] = args[i+1]
				i++
			} else {
				flags[key] = "true"
			}
		}
	}
	return flags
}
[?2004hroot@n30009:/app# echo '===== commands ====='; sed -n '1,220p' commands.go
[?2004l===== commands =====
package main

import (
	"fmt"
	"os"
	"path/filepath"
)

func cmdValidate(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe validate <model>\n")
		os.Exit(1)
	}
	name := args[0]

	entries, err := loadRegistry()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	entry := findEntry(entries, name)
	if entry == nil {
		fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
		os.Exit(1)
	}
	if !modelDirExists(entry.Path) {
		fmt.Fprintf(os.Stderr, "error: model directory not found\n")
		os.Exit(1)
	}

	errors := validateModel(entry.Path)
	if len(errors) == 0 {
		fmt.Printf("Model '%s' is valid.\n", name)
	} else {
		fmt.Printf("Model '%s' has %d validation error(s):\n", name, len(errors))
		for i, e := range errors {
			fmt.Printf("  %d. %s\n", i+1, e)
		}
		os.Exit(1)
	}
}

func validateModel(modelDir string) []string {
	var errors []string

	metaPath := filepath.Join(modelDir, "model.meta")
	if _, err := os.Stat(metaPath); err != nil {
		errors = append(errors, "missing model.meta")
	} else {
		meta, err := loadModelMeta(modelDir)
		if err != nil {
			errors = append(errors, fmt.Sprintf("cannot parse model.meta: %v", err))
		} else {
			if meta["name"] == "" {
				errors = append(errors, "model.meta: missing 'name' field")
			}
			if meta["type"] == "" {
				errors = append(errors, "model.meta: missing 'type' field")
			}
			if meta["features"] == "" {
				errors = append(errors, "model.meta: missing 'features' field")
			}
			if meta["outputs"] == "" {
				errors = append(errors, "model.meta: missing 'outputs' field")
			}
		}
	}

	weightsPath := filepath.Join(modelDir, "weights.bin")
	if _, err := os.Stat(weightsPath); err != nil {
		errors = append(errors, "missing weights.bin")
	} else {
		_, err := loadWeights(modelDir)
		if err != nil {
			errors = append(errors, fmt.Sprintf("cannot parse weights.bin: %v", err))
		}
	}

	cfgPath := filepath.Join(modelDir, "pipeline.cfg")
	if _, err := os.Stat(cfgPath); err != nil {
		errors = append(errors, "missing pipeline.cfg")
	} else {
		_, err := loadPipelineConfig(modelDir)
		if err != nil {
			errors = append(errors, fmt.Sprintf("cannot parse pipeline.cfg: %v", err))
		}
	}

	return errors
}

func cmdExport(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe export <model> --output <dir>\n")
		os.Exit(1)
	}
	name := args[0]
	flags := parseFlags(args[1:])

	outputDir := flags["output"]
	if outputDir == "" {
		fmt.Fprintf(os.Stderr, "error: --output is required\n")
		os.Exit(1)
	}

	entries, err := loadRegistry()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	entry := findEntry(entries, name)
	if entry == nil {
		fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
		os.Exit(1)
	}

	if err := os.MkdirAll(outputDir, 0755); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	files := []string{"model.meta", "weights.bin", "pipeline.cfg"}
	for _, file := range files {
		src := filepath.Join(entry.Path, file)
		dst := filepath.Join(outputDir, file)
		data, err := os.ReadFile(src)
		if err != nil {
			fmt.Fprintf(os.Stderr, "error reading %s: %v\n", file, err)
			os.Exit(1)
		}
		if err := os.WriteFile(dst, data, 0644); err != nil {
			fmt.Fprintf(os.Stderr, "error writing %s: %v\n", file, err)
			os.Exit(1)
		}
	}
	fmt.Printf("Model '%s' exported to %s\n", name, outputDir)
}
