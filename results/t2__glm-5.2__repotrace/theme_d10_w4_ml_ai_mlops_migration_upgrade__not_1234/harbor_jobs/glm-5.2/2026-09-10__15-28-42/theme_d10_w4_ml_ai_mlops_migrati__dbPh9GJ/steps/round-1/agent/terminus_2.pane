[?2004lpackage main

import (
	"fmt"
	"os"
	"strings"
)

const version = "0.1.0"

func main() {
	if len(os.Args) < 2 {
		printUsage()
		os.Exit(1)
	}

	command := os.Args[1]
	args := os.Args[2:]

	switch command {
	case "ensemble":
		cmdEnsemble(args)
	case "list":
		cmdList(args)
	case "info":
		cmdInfo(args)
	case "register":
		cmdRegister(args)
	case "remove":
		cmdRemove(args)
	case "tag":
		cmdTag(args)
	case "untag":
		cmdUntag(args)
	case "search":
		cmdSearch(args)
	case "run":
		cmdRun(args)
	case "stats":
		cmdStats(args)
	case "diff":
		cmdDiff(args)
	case "batch":
		cmdBatch(args)
	case "benchmark":
		cmdBenchmark(args)
	case "prune":
		cmdPrune(args)
	case "profile":
		cmdProfile(args)
	case "explain":
		cmdExplain(args)
	case "validate":
		cmdValidate(args)
	case "validate-input":
		cmdValidateInput(args)
	case "schema":
		cmdSchema(args)
	case "export":
		cmdExport(args)
	case "import":
		cmdImport(args)
	case "clone":
		cmdClone(args)
	case "checkpoint":
		cmdCheckpoint(args)
	case "checkpoints":
		cmdCheckpoints(args)
	case "rollback":
		cmdRollback(args)
	case "migrate":
		cmdMigrate(args)
	case "compat":
		cmdCompat(args)
	case "version":
		fmt.Printf("mlpipe version %s\n", version)
	case "help":
		printUsage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
		printUsage()
		os.Exit(1)
	}
}

func printUsage() {
	usage := `mlpipe - ML Inference Pipeline Manager

Usage: mlpipe <command> [arguments]

Commands:
  list                          List all registered models
  info <model>                  Show model details
  register <name> <path>        Register a model from directory
  remove <name>                 Remove a model from registry
  run <model> [options]         Run inference
  stats --input <file>          Input statistics profiling
  diff <model1> <model2> --input <file>
                                Compare two models on same input
  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
                                Batch inference over CSV files
  validate <model>              Validate model integrity
  validate-input <model> --input <file>
                                Validate input data for a model
  schema <model>                Display expected input schema for a model
  export <model> --output <file> Export model to JSON file
  import <path> [--name <name>] Import model from JSON file
  clone <model> <new_name>      Clone model to new name
  benchmark <model> --input <file> [--runs <N>]
                                Benchmark inference performance
  prune <model> --threshold <value> [--dry-run]
                                Prune near-zero weights
  profile <model>               Report model weight analysis
  explain <model> --input <file> [--row <N>]
                                  Explain prediction for a row
  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
  compat [--all]                 Check migration compatibility
  version                       Show version
  help                          Show this help

Run/Diff Options:
  --input <file>    Input CSV file (required)
  --output <file>   Output file (default: stdout)
  --format <fmt>    Output format: csv or json (default: csv)
  --strict          Validate input before inference and abort on invalid rows

Batch Options:
  --dir <dir>       Input directory of CSV files
  --output-dir <dir> Output directory for predictions
  --format <fmt>    Output format: csv or json (default: csv)
`
	fmt.Print(usage)
}

func parseFlags(args []string) map[string]string {
	flags := make(map[string]string)
	for i := 0; i < len(args); i++ {
		if strings.HasPrefix(args[i], "--") {
			key := strings.TrimPrefix(args[i], "--")
			if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
				flags[key] = args[i+1]
				i++
			} else {
				flags[key] = "true"
			}
		}
	}
	return flags
}
