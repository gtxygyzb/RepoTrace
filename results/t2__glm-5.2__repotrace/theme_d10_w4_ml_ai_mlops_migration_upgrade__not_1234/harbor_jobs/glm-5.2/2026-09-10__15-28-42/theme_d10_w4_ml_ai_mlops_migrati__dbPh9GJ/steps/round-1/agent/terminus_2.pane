const version = "0.1.0"

func main() {
	if len(os.Args) < 2 {
		printUsage()
		os.Exit(1)
	}

	command := os.Args[1]
	args := os.Args[2:]

	switch command {
	case "ensemble":
		cmdEnsemble(args)
	case "list":
		cmdList(args)
	case "info":
		cmdInfo(args)
	case "register":
		cmdRegister(args)
	case "remove":
		cmdRemove(args)
	case "tag":
		cmdTag(args)
	case "untag":
		cmdUntag(args)
