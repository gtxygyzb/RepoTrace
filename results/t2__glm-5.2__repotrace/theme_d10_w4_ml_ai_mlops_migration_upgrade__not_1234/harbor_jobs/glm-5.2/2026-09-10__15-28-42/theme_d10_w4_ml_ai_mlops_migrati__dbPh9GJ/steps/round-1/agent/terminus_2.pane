   218	type PipelineConfig struct {
   219		Normalize       bool
   220		ScaleMin        float64
   221		ScaleMax        float64
   222		MissingStrategy string
   223		RoundDigits     int
   224		ClipMin         float64
   225		ClipMax         float64
   226	}
   227	
   228	func loadPipelineConfig(modelDir string) (*PipelineConfig, error) {
   229		f, err := os.Open(filepath.Join(modelDir, "pipeline.cfg"))
   230		if err != nil {
   231			return nil, err
   232		}
   233		defer f.Close()
   234	
   235		cfg := &PipelineConfig{
   236			ScaleMin:        0.0,
   237			ScaleMax:        1.0,
   238			MissingStrategy: "zero",
   239			RoundDigits:     4,
   240			ClipMin:         -1000.0,
   241			ClipMax:         1000.0,
   242		}
   243	
   244		scanner := bufio.NewScanner(f)
   245		section := ""
   246		for scanner.Scan() {
   247			line := strings.TrimSpace(scanner.Text())
   248			if line == "" || strings.HasPrefix(line, "#") {
   249				continue
   250			}
   251			if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
   252				section = line[1 : len(line)-1]
   253				continue
   254			}
   255			parts := strings.SplitN(line, "=", 2)
   256			if len(parts) != 2 {
   257				continue
   258			}
   259			key := strings.TrimSpace(parts[0])
   260			val := strings.TrimSpace(parts[1])
   261	
   262			switch section {
   263			case "preprocess":
   264				switch key {
   265				case "normalize":
   266					cfg.Normalize = val == "true"
   267				case "scale_range":
   268					rangeParts := strings.Split(val, ",")
   269					if len(rangeParts) == 2 {
   270						cfg.ScaleMin, _ = strconv.ParseFloat(rangeParts[0], 64)
   271						cfg.ScaleMax, _ = strconv.ParseFloat(rangeParts[1], 64)
   272					}
   273				case "missing_strategy":
   274					cfg.MissingStrategy = val
   275				}
   276			case "postprocess":
   277				switch key {
   278				case "round_digits":
   279					cfg.RoundDigits, _ = strconv.Atoi(val)
   280				case "clip_min":
   281					cfg.ClipMin, _ = strconv.ParseFloat(val, 64)
   282				case "clip_max":
   283					cfg.ClipMax, _ = strconv.ParseFloat(val, 64)
   284				}
   285			}
   286		}
   287		return cfg, scanner.Err()
   288	}
