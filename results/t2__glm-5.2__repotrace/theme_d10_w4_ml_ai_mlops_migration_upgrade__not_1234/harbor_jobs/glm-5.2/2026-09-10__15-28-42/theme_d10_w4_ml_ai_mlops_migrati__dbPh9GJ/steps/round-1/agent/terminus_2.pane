    34		weights, err := loadWeights(modelDir)
    35		if err != nil {
    36			return nil, nil, err
    37		}
    38		cfg, err := loadPipelineConfig(modelDir)
    39		if err != nil {
    40			return nil, nil, err
    41		}
    42		return weights, cfg, nil
    43	}
    44	
    45	func validateFeatureCount(inputs [][]float64, expected int) error {
    46		for i, row := range inputs {
    47			if len(row) != expected {
    48				return fmt.Errorf("expected %d features, got %d in row %d", expected, len(row), i)
    49			}
    50		}
    51		return nil
    52	}
