[?2004lpackage main

import (
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"time"
)

func checkpointsDir(modelDir string) string {
	return filepath.Join(modelDir, ".checkpoints")
}

func countCheckpoints(modelDir string) int {
	entries, err := os.ReadDir(checkpointsDir(modelDir))
	if err != nil {
		return 0
	}
	count := 0
	for _, entry := range entries {
		if entry.IsDir() {
			count++
		}
	}
	return count
}

func cmdCheckpoint(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe checkpoint <model> [--name <name>]\n")
		os.Exit(1)
	}
	model := args[0]
	flags := parseFlags(args[1:])

	name := flags["name"]
	if name == "" {
		name = "cp-" + time.Now().Format("20060102-150405")
	}

	entry, err := resolveModel(model)
	if err != nil {
		fmt.Fprintf(os.Stderr, "not found\n")
		os.Exit(1)
	}

	cpDir := filepath.Join(checkpointsDir(entry.Path), name)
	if _, err := os.Stat(cpDir); err == nil {
		fmt.Fprintf(os.Stderr, "checkpoint already exists\n")
		os.Exit(1)
	}

	if err := os.MkdirAll(cpDir, 0755); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	for _, file := range []string{"weights.bin", "model.meta", "pipeline.cfg"} {
		src := filepath.Join(entry.Path, file)
		data, err := os.ReadFile(src)
		if err != nil {
			fmt.Fprintf(os.Stderr, "error: %v\n", err)
			os.Exit(1)
		}
		if err := os.WriteFile(filepath.Join(cpDir, file), data, 0644); err != nil {
			fmt.Fprintf(os.Stderr, "error: %v\n", err)
			os.Exit(1)
		}
	}

	fmt.Printf("checkpoint '%s' created for '%s'\n", name, model)
}

func cmdCheckpoints(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe checkpoints <model>\n")
		os.Exit(1)
	}
	model := args[0]

	entry, err := resolveModel(model)
	if err != nil {
		fmt.Fprintf(os.Stderr, "not found\n")
		os.Exit(1)
	}

	entries, err := os.ReadDir(checkpointsDir(entry.Path))
	if err != nil || len(entries) == 0 {
		fmt.Println("no checkpoints")
		return
	}

	type checkpointInfo struct {
		name string
		mod  time.Time
	}
	var cps []checkpointInfo
	for _, entry := range entries {
		if !entry.IsDir() {
			continue
		}
		info, err := entry.Info()
		if err != nil {
			continue
		}
		cps = append(cps, checkpointInfo{name: entry.Name(), mod: info.ModTime()})
	}

	if len(cps) == 0 {
		fmt.Println("no checkpoints")
		return
	}

	sort.Slice(cps, func(i, j int) bool {
		return cps[i].mod.Before(cps[j].mod)
	})

	for _, cp := range cps {
		fmt.Printf("%s  %s\n", cp.name, cp.mod.Format("2006-01-02 15:04:05"))
	}
}

func cmdRollback(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe rollback <model> --to <checkpoint>\n")
		os.Exit(1)
	}
	model := args[0]
	flags := parseFlags(args[1:])

	name := flags["to"]
	if name == "" {
		fmt.Fprintf(os.Stderr, "error: --to is required\n")
		os.Exit(1)
	}

	entry, err := resolveModel(model)
	if err != nil {
		fmt.Fprintf(os.Stderr, "not found\n")
		os.Exit(1)
	}

	cpDir := filepath.Join(checkpointsDir(entry.Path), name)
	if _, err := os.Stat(cpDir); err != nil {
		fmt.Fprintf(os.Stderr, "checkpoint not found\n")
		os.Exit(1)
	}

	entries, err := os.ReadDir(cpDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	for _, entry := range entries {
		if entry.IsDir() {
			continue
		}
		data, err := os.ReadFile(filepath.Join(cpDir, entry.Name()))
		if err != nil {
			fmt.Fprintf(os.Stderr, "error: %v\n", err)
			os.Exit(1)
		}
		if err := os.WriteFile(filepath.Join(entry.Path, entry.Name()), data, 0644); err != nil {
			fmt.Fprintf(os.Stderr, "error: %v\n", err)
			os.Exit(1)
		}
	}

	fmt.Printf("rolled back '%s' to checkpoint '%s'\n", model, name)
}
