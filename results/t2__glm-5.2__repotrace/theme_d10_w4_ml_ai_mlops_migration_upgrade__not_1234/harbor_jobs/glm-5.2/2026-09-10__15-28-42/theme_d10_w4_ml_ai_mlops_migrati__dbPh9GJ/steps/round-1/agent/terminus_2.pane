    90	
[?2004hroot@n30009:/app# nl -ba migration.go | sed -n '1,140p'
[?2004l     1	package main
     2	
     3	import (
     4		"fmt"
     5		"os"
     6		"path/filepath"
     7	)
     8	
     9	func cmdMigrate(args []string) {
    10		if len(args) < 1 {
    11			fmt.Fprintf(os.Stderr, "usage: mlpipe migrate <model> [--activation <type>]\n")
    12			os.Exit(1)
    13		}
    14	
    15		name := args[0]
    16		flags := parseFlags(args[1:])
    17	
    18		entries, err := loadRegistry()
    19		if err != nil {
    20			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    21			os.Exit(1)
    22		}
    23	
    24		entry := findEntry(entries, name)
    25		if entry == nil {
    26			fmt.Fprintln(os.Stderr, "not found")
    27			os.Exit(1)
    28		}
    29	
    30		if !modelDirExists(entry.Path) {
    31			fmt.Fprintln(os.Stderr, "not found")
    32			os.Exit(1)
    33		}
    34	
    35		activationName := flags["activation"]
    36		if activationName == "" {
    37			activationName = "none"
    38		}
    39	
    40		activationType, err := activationNameToID(activationName)
    41		if err != nil {
    42			fmt.Fprintln(os.Stderr, "invalid activation")
    43			os.Exit(1)
    44		}
    45	
    46		weights, err := loadWeights(entry.Path)
    47		if err != nil {
    48			fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
    49			os.Exit(1)
    50		}
    51	
    52		if weights.Version >= 2 {
    53			fmt.Printf("Model '%s' is already migrated to format v2.\n", name)
    54			os.Exit(0)
    55		}
    56	
    57		weightsPath := filepath.Join(entry.Path, "weights.bin")
    58		backupPath := filepath.Join(entry.Path, "weights.bin.v1bak")
    59	
    60		data, err := os.ReadFile(weightsPath)
    61		if err != nil {
    62			fmt.Fprintf(os.Stderr, "error reading weights: %v\n", err)
    63			os.Exit(1)
    64		}
    65		if err := os.WriteFile(backupPath, data, 0644); err != nil {
    66			fmt.Fprintf(os.Stderr, "error writing backup: %v\n", err)
    67			os.Exit(1)
    68		}
    69	
    70		weights.Version = 2
    71		weights.Activation = activationType
    72		if err := writeWeights(weightsPath, weights); err != nil {
    73			fmt.Fprintf(os.Stderr, "error writing weights: %v\n", err)
    74			os.Exit(1)
    75		}
    76	
    77		meta, err := loadModelMeta(entry.Path)
    78		if err != nil {
    79			fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
    80			os.Exit(1)
    81		}
    82		meta["format_version"] = "2"
    83		meta["activation"] = activationIDToName(activationType)
    84		if err := saveModelMeta(entry.Path, meta); err != nil {
    85			fmt.Fprintf(os.Stderr, "error updating metadata: %v\n", err)
    86			os.Exit(1)
    87		}
    88	
    89		fmt.Printf("Model '%s' migrated to format v2 (activation=%s).\n", name, activationIDToName(activationType))
    90	}
    91	
    92	func cmdCompat(args []string) {
    93		flags := parseFlags(args)
    94		all := flags["all"] == "true" || flags["all"] == "1"
    95	
