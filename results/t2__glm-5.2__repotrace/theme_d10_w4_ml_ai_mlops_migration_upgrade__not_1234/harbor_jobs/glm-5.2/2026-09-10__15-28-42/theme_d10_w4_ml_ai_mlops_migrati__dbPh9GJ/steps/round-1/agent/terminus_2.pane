type PipelineConfig struct {
	Normalize       bool
	ScaleMin        float64
	ScaleMax        float64
	MissingStrategy string
	RoundDigits     int
	ClipMin         float64
	ClipMax         float64
}

func loadPipelineConfig(modelDir string) (*PipelineConfig, error) {
	f, err := os.Open(filepath.Join(modelDir, "pipeline.cfg"))
	if err != nil {
		return nil, err
	}
	defer f.Close()

	cfg := &PipelineConfig{
		ScaleMin:        0.0,
		ScaleMax:        1.0,
		MissingStrategy: "zero",
		RoundDigits:     4,
		ClipMin:         -1000.0,
[?2004hroot@n30009:/app# sed -n '230,280p' inference.go
[?2004lfunc writeOutput(f *os.File, results [][]float64, format string) {
	switch format {
	case "csv":
		writer := csv.NewWriter(f)
		header := make([]string, len(results[0]))
		for i := range header {
			header[i] = fmt.Sprintf("output_%d", i)
		}
		writer.Write(header)
		for _, row := range results {
			record := make([]string, len(row))
			for j, val := range row {
				record[j] = strconv.FormatFloat(val, 'f', -1, 64)
			}
			writer.Write(record)
		}
		writer.Flush()
	case "json":
		type Prediction struct {
			Outputs []float64 `json:"outputs"`
		}
		type Result struct {
			Predictions []Prediction `json:"predictions"`
		}
		r := Result{}
		for _, row := range results {
			r.Predictions = append(r.Predictions, Prediction{Outputs: row})
		}
		enc := json.NewEncoder(f)
		enc.SetIndent("", "  ")
		enc.Encode(r)
	}
}
