   375		numRows := len(allOutputs[0])
   376		numOutputs := len(allOutputs[0][0])
   377		combined := make([][]float64, numRows)
   378		for i := 0; i < numRows; i++ {
   379			combined[i] = make([]float64, numOutputs)
   380			for j := 0; j < numOutputs; j++ {
   381				vals := make([]float64, len(allOutputs))
   382				for k := range allOutputs {
   383					vals[k] = allOutputs[k][i][j]
   384				}
   385				switch strategy {
   386				case "max":
   387					combined[i][j] = maxFloat64(vals)
   388				case "min":
   389					combined[i][j] = minFloat64(vals)
   390				default:
   391					combined[i][j] = weightedMeanFloat64(vals, weights)
   392				}
   393			}
   394		}
   395		return combined
   396	}
