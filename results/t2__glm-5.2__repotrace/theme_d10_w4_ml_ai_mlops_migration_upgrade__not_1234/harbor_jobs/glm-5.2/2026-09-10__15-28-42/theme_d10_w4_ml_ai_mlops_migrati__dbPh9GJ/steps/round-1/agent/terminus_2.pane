   267	func cmdDiff(args []string) {
   268		if len(args) < 2 {
   269			fmt.Fprintf(os.Stderr, "usage: mlpipe diff <model1> <model2> --input <file>\n")
   270			os.Exit(1)
   271		}
   272	
   273		model1 := args[0]
   274		model2 := args[1]
   275		flags := parseFlags(args[2:])
   276	
   277		input := flags["input"]
   278		if input == "" {
   279			fmt.Fprintf(os.Stderr, "error: --input is required\n")
   280			os.Exit(1)
   281		}
   282	
   283		entry1, err := resolveModel(model1)
   284		if err != nil {
   285			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   286			os.Exit(1)
   287		}
   288	
