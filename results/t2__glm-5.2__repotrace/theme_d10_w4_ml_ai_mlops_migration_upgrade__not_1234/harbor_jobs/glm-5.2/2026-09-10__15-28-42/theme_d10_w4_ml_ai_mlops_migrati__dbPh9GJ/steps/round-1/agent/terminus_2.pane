    46	func validateFeatureCount(inputs [][]float64, expected int) error {
    47		for i, row := range inputs {
    48			if len(row) != expected {
    49				return fmt.Errorf("expected %d features, got %d in row %d", expected, len(row), i)
    50			}
    51		}
    52		return nil
    53	}
