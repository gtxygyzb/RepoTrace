[?2004lpackage main

import (
	"fmt"
	"os"
	"strings"
)

const version = "0.1.0"

func main() {
	if len(os.Args) < 2 {
		printUsage()
		os.Exit(1)
	}

	command := os.Args[1]
	args := os.Args[2:]

	switch command {
	case "ensemble":
		cmdEnsemble(args)
	case "list":
		cmdList(args)
	case "info":
		cmdInfo(args)
	case "register":
		cmdRegister(args)
	case "remove":
		cmdRemove(args)
	case "tag":
		cmdTag(args)
	case "untag":
		cmdUntag(args)
	case "search":
		cmdSearch(args)
	case "run":
		cmdRun(args)
	case "stats":
		cmdStats(args)
	case "diff":
		cmdDiff(args)
	case "batch":
		cmdBatch(args)
	case "benchmark":
		cmdBenchmark(args)
	case "prune":
		cmdPrune(args)
	case "profile":
		cmdProfile(args)
	case "explain":
		cmdExplain(args)
	case "validate":
		cmdValidate(args)
	case "validate-input":
		cmdValidateInput(args)
	case "schema":
		cmdSchema(args)
	case "export":
		cmdExport(args)
	case "import":
		cmdImport(args)
	case "clone":
		cmdClone(args)
	case "checkpoint":
		cmdCheckpoint(args)
	case "checkpoints":
		cmdCheckpoints(args)
	case "rollback":
		cmdRollback(args)
	case "migrate":
		cmdMigrate(args)
	case "compat":
		cmdCompat(args)
	case "version":
		fmt.Printf("mlpipe version %s\n", version)
	case "help":
		printUsage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
		printUsage()
		os.Exit(1)
	}
}

func printUsage() {
	usage := `mlpipe - ML Inference Pipeline Manager

Usage: mlpipe <command> [arguments]

Commands:
  list                          List all registered models
  info <model>                  Show model details
  register <name> <path>        Register a model from directory
  remove <name>                 Remove a model from registry
  run <model> [options]         Run inference
  stats --input <file>          Input statistics profiling
  diff <model1> <model2> --input <file>
                                Compare two models on same input
  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
                                Batch inference over CSV files
  validate <model>              Validate model integrity
  validate-input <model> --input <file>
                                Validate input data for a model
  schema <model>                Display expected input schema for a model
  export <model> --output <file> Export model to JSON file
  import <path> [--name <name>] Import model from JSON file
  clone <model> <new_name>      Clone model to new name
  benchmark <model> --input <file> [--runs <N>]
                                Benchmark inference performance
  prune <model> --threshold <value> [--dry-run]
                                Prune near-zero weights
  profile <model>               Report model weight analysis
  explain <model> --input <file> [--row <N>]
                                  Explain prediction for a row
  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
  compat [--all]                 Check migration compatibility
  version                       Show version
  help                          Show this help

Run/Diff Options:
  --input <file>    Input CSV file (required)
  --output <file>   Output file (default: stdout)
  --format <fmt>    Output format: csv or json (default: csv)
  --strict          Validate input before inference and abort on invalid rows

Batch Options:
  --dir <dir>       Input directory of CSV files
  --output-dir <dir> Output directory for predictions
  --format <fmt>    Output format: csv or json (default: csv)
`
	fmt.Print(usage)
}

func parseFlags(args []string) map[string]string {
	flags := make(map[string]string)
	for i := 0; i < len(args); i++ {
		if strings.HasPrefix(args[i], "--") {
			key := strings.TrimPrefix(args[i], "--")
			if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
				flags[key] = args[i+1]
				i++
			} else {
				flags[key] = "true"
			}
		}
	}
	return flags
}
[?2004hroot@n30009:/app# sed -n '1,260p' format.go
[?2004lpackage main

import (
	"bufio"
	"encoding/binary"
	"fmt"
	"math"
	"os"
	"path/filepath"
	"sort"
	"strconv"
	"strings"
)

var modelMagic = []byte("MLPW")

func loadModelMeta(modelDir string) (map[string]string, error) {
	f, err := os.Open(filepath.Join(modelDir, "model.meta"))
	if err != nil {
		return nil, err
	}
	defer f.Close()

	meta := make(map[string]string)
	scanner := bufio.NewScanner(f)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		parts := strings.SplitN(line, "=", 2)
		if len(parts) == 2 {
			meta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])
		}
	}
	return meta, scanner.Err()
}

type WeightsData struct {
	Version     uint32
	NumFeatures uint32
	NumOutputs  uint32
	Activation  uint32
	Weights     []float64
	Bias        []float64
}

func loadWeights(modelDir string) (*WeightsData, error) {
	f, err := os.Open(filepath.Join(modelDir, "weights.bin"))
	if err != nil {
		return nil, err
	}
	defer f.Close()

	magic := make([]byte, 4)
	if _, err := f.Read(magic); err != nil {
		return nil, fmt.Errorf("failed to read magic: %v", err)
	}
	if string(magic) != string(modelMagic) {
		return nil, fmt.Errorf("invalid model file: bad magic")
	}

	var ver, nf, no uint32
	if err := binary.Read(f, binary.LittleEndian, &ver); err != nil {
		return nil, fmt.Errorf("failed to read version: %v", err)
	}
	if err := binary.Read(f, binary.LittleEndian, &nf); err != nil {
		return nil, fmt.Errorf("failed to read num_features: %v", err)
	}
	if err := binary.Read(f, binary.LittleEndian, &no); err != nil {
		return nil, fmt.Errorf("failed to read num_outputs: %v", err)
	}

	var act uint32
	switch ver {
	case 1:
		act = 0
	case 2:
		if err := binary.Read(f, binary.LittleEndian, &act); err != nil {
			return nil, fmt.Errorf("failed to read activation: %v", err)
		}
	default:
		return nil, fmt.Errorf("unsupported model format version: %d", ver)
	}

	weights := make([]float64, nf*no)
	for i := range weights {
		if err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {
			return nil, fmt.Errorf("failed to read weight[%d]: %v", i, err)
		}
	}

	bias := make([]float64, no)
	for i := range bias {
		if err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {
			return nil, fmt.Errorf("failed to read bias[%d]: %v", i, err)
		}
	}

	return &WeightsData{
		Version:     ver,
		NumFeatures: nf,
		NumOutputs:  no,
		Activation:  act,
		Weights:     weights,
		Bias:        bias,
	}, nil
}

func writeWeights(path string, w *WeightsData) error {
	f, err := os.Create(path)
	if err != nil {
		return err
	}
	defer f.Close()

	if _, err := f.Write(modelMagic); err != nil {
		return err
	}
	if err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {
		return err
	}
	if err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {
		return err
	}
	if err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {
		return err
	}
	if w.Version >= 2 {
		if err := binary.Write(f, binary.LittleEndian, w.Activation); err != nil {
			return err
		}
	}
	for _, v := range w.Weights {
		if err := binary.Write(f, binary.LittleEndian, v); err != nil {
			return err
		}
	}
	for _, v := range w.Bias {
		if err := binary.Write(f, binary.LittleEndian, v); err != nil {
			return err
		}
	}
	return nil
}

const (
	activationNone    = 0
	activationSigmoid = 1
	activationReLU    = 2
	activationTanh    = 3
)

func activationNameToID(name string) (uint32, error) {
	switch strings.ToLower(name) {
	case "", "none":
		return activationNone, nil
	case "sigmoid":
		return activationSigmoid, nil
	case "relu":
		return activationReLU, nil
	case "tanh":
		return activationTanh, nil
	default:
		return 0, fmt.Errorf("invalid activation")
	}
}

func activationIDToName(id uint32) string {
	switch id {
	case activationNone:
		return "none"
	case activationSigmoid:
		return "sigmoid"
	case activationReLU:
		return "relu"
	case activationTanh:
		return "tanh"
	default:
		return "unknown"
	}
}

func applyActivation(x float64, activation uint32) float64 {
	switch activation {
	case activationSigmoid:
		return 1.0 / (1.0 + math.Exp(-x))
	case activationReLU:
		if x < 0 {
			return 0
		}
		return x
	case activationTanh:
		return math.Tanh(x)
	default:
		return x
	}
}

func saveModelMeta(modelDir string, meta map[string]string) error {
	f, err := os.Create(filepath.Join(modelDir, "model.meta"))
	if err != nil {
		return err
	}
	defer f.Close()

	keys := make([]string, 0, len(meta))
	for k := range meta {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	for _, k := range keys {
		fmt.Fprintf(f, "%s=%s\n", k, meta[k])
	}
	return nil
}

type PipelineConfig struct {
	Normalize       bool
	ScaleMin        float64
	ScaleMax        float64
	MissingStrategy string
	RoundDigits     int
	ClipMin         float64
	ClipMax         float64
	FeatureNames    []string
}

func loadPipelineConfig(modelDir string) (*PipelineConfig, error) {
	f, err := os.Open(filepath.Join(modelDir, "pipeline.cfg"))
	if err != nil {
		return nil, err
	}
	defer f.Close()

	cfg := &PipelineConfig{
		ScaleMin:        0.0,
