var modelMagic = []byte("MLPW")

func loadModelMeta(modelDir string) (map[string]string, error) {
	f, err := os.Open(filepath.Join(modelDir, "model.meta"))
	if err != nil {
		return nil, err
	}
	defer f.Close()

	meta := make(map[string]string)
	scanner := bufio.NewScanner(f)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		parts := strings.SplitN(line, "=", 2)
		if len(parts) == 2 {
			meta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])
		}
	}
	return meta, scanner.Err()
}

type WeightsData struct {
	Version     uint32
	NumFeatures uint32
	NumOutputs  uint32
	Activation  uint32
	Weights     []float64
	Bias        []float64
}

func loadWeights(modelDir string) (*WeightsData, error) {
	f, err := os.Open(filepath.Join(modelDir, "weights.bin"))
	if err != nil {
		return nil, err
	}
	defer f.Close()

	magic := make([]byte, 4)
	if _, err := f.Read(magic); err != nil {
		return nil, fmt.Errorf("failed to read magic: %v", err)
	}
	if string(magic) != string(modelMagic) {
		return nil, fmt.Errorf("invalid model file: bad magic")
	}

	var ver, nf, no uint32
	if err := binary.Read(f, binary.LittleEndian, &ver); err != nil {
		return nil, fmt.Errorf("failed to read version: %v", err)
	}
	if err := binary.Read(f, binary.LittleEndian, &nf); err != nil {
		return nil, fmt.Errorf("failed to read num_features: %v", err)
	}
	if err := binary.Read(f, binary.LittleEndian, &no); err != nil {
		return nil, fmt.Errorf("failed to read num_outputs: %v", err)
	}

	var act uint32
	switch ver {
	case 1:
		act = 0
	case 2:
		if err := binary.Read(f, binary.LittleEndian, &act); err != nil {
			return nil, fmt.Errorf("failed to read activation: %v", err)
		}
	default:
		return nil, fmt.Errorf("unsupported model format version: %d", ver)
	}

	weights := make([]float64, nf*no)
	for i := range weights {
		if err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {
			return nil, fmt.Errorf("failed to read weight[%d]: %v", i, err)
		}
	}

	bias := make([]float64, no)
	for i := range bias {
		if err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {
			return nil, fmt.Errorf("failed to read bias[%d]: %v", i, err)
		}
	}

	return &WeightsData{
		Version:     ver,
		NumFeatures: nf,
		NumOutputs:  no,
		Activation:  act,
		Weights:     weights,
		Bias:        bias,
	}, nil
}

func writeWeights(path string, w *WeightsData) error {
	f, err := os.Create(path)
	if err != nil {
		return err
	}
	defer f.Close()

	if _, err := f.Write(modelMagic); err != nil {
		return err
	}
	if err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {
		return err
	}
	if err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {
		return err
	}
	if err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {
		return err
	}
	if w.Version >= 2 {
		if err := binary.Write(f, binary.LittleEndian, w.Activation); err != nil {
			return err
		}
	}
	for _, v := range w.Weights {
		if err := binary.Write(f, binary.LittleEndian, v); err != nil {
			return err
		}
	}
	for _, v := range w.Bias {
		if err := binary.Write(f, binary.LittleEndian, v); err != nil {
			return err
		}
	}
	return nil
}

const (
	activationNone    = 0
	activationSigmoid = 1
	activationReLU    = 2
	activationTanh    = 3
)

func activationNameToID(name string) (uint32, error) {
	switch strings.ToLower(name) {
	case "", "none":
		return activationNone, nil
	case "sigmoid":
		return activationSigmoid, nil
	case "relu":
		return activationReLU, nil
	case "tanh":
		return activationTanh, nil
	default:
		return 0, fmt.Errorf("invalid activation")
	}
}

func activationIDToName(id uint32) string {
	switch id {
	case activationNone:
		return "none"
	case activationSigmoid:
		return "sigmoid"
	case activationReLU:
		return "relu"
	case activationTanh:
		return "tanh"
	default:
		return "unknown"
	}
}

func applyActivation(x float64, activation uint32) float64 {
	switch activation {
	case activationSigmoid:
		return 1.0 / (1.0 + math.Exp(-x))
	case activationReLU:
		if x < 0 {
			return 0
		}
		return x
	case activationTanh:
		return math.Tanh(x)
	default:
		return x
	}
}

func saveModelMeta(modelDir string, meta map[string]string) error {
	f, err := os.Create(filepath.Join(modelDir, "model.meta"))
	if err != nil {
		return err
	}
	defer f.Close()

	keys := make([]string, 0, len(meta))
	for k := range meta {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	for _, k := range keys {
		fmt.Fprintf(f, "%s=%s\n", k, meta[k])
	}
	return nil
}

type PipelineConfig struct {
	Normalize       bool
	ScaleMin        float64
	ScaleMax        float64
	MissingStrategy string
	RoundDigits     int
	ClipMin         float64
	ClipMax         float64
	FeatureNames    []string
}

func loadPipelineConfig(modelDir string) (*PipelineConfig, error) {
