   123	func parseFlags(args []string) map[string]string {
   124		flags := make(map[string]string)
   125		for i := 0; i < len(args); i++ {
   126			if strings.HasPrefix(args[i], "--") {
   127				key := strings.TrimPrefix(args[i], "--")
   128				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
   129					flags[key] = args[i+1]
   130					i++
   131				} else {
   132					flags[key] = "true"
   133				}
   134			}
   135		}
   136		return flags
   137	}
