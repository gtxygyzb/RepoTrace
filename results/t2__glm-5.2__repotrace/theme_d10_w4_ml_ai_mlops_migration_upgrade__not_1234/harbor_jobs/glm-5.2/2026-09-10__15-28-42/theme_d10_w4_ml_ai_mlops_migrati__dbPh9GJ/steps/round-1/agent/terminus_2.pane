   125	func isHeader(record []string) bool {
   126		for _, val := range record {
   127			_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)
   128			if err == nil {
   129				return false
   130			}
   131		}
   132		return true
   133	}
   134	
   135	func runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {
   136		processed := preprocess(inputs, cfg)
   137	
   138		results := make([][]float64, len(processed))
   139		for i, row := range processed {
   140			output := make([]float64, weights.NumOutputs)
   141			for o := uint32(0); o < weights.NumOutputs; o++ {
   142				sum := weights.Bias[o]
   143				for f := uint32(0); f < weights.NumFeatures; f++ {
   144					if int(f) < len(row) {
   145						sum += row[f] * weights.Weights[o*weights.NumFeatures+f]
   146					}
   147				}
   148				output[o] = applyActivation(sum, weights.Activation)
   149			}
   150			results[i] = output
   151		}
   152	
   153		return postprocess(results, cfg)
   154	}
   155	
   156	func preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {
   157		result := make([][]float64, len(inputs))
   158		for i, row := range inputs {
   159			result[i] = make([]float64, len(row))
   160			copy(result[i], row)
   161		}
   162	
   163		if len(result) == 0 {
   164			return result
   165		}
   166	
   167		for i, row := range result {
   168			for j, val := range row {
   169				if math.IsNaN(val) {
   170					switch cfg.MissingStrategy {
   171					case "zero":
   172						result[i][j] = 0.0
   173					case "mean":
   174						result[i][j] = computeColumnMean(inputs, j)
   175					}
   176				}
   177			}
   178		}
   179	
   180		if cfg.Normalize {
   181			for j := 0; j < len(result[0]); j++ {
   182				minVal, maxVal := columnMinMax(result, j)
   183				rangeVal := maxVal - minVal
   184				if rangeVal == 0 {
   185					rangeVal = 1.0
   186				}
   187				for i := range result {
   188					normalized := (result[i][j] - minVal) / rangeVal
   189					result[i][j] = cfg.ScaleMin + normalized*(cfg.ScaleMax-cfg.ScaleMin)
   190				}
   191			}
   192		}
   193	
   194		return result
   195	}
   196	
   197	func postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {
   198		for i, row := range results {
   199			for j, val := range row {
   200				val = math.Max(val, cfg.ClipMin)
   201				val = math.Min(val, cfg.ClipMax)
   202				results[i][j] = roundToDigits(val, cfg.RoundDigits)
   203			}
   204		}
   205		return results
   206	}
   207	
   208	func computeColumnMean(data [][]float64, col int) float64 {
   209		sum := 0.0
   210		count := 0
   211		for _, row := range data {
   212			if col < len(row) && !math.IsNaN(row[col]) {
   213				sum += row[col]
   214				count++
   215			}
   216		}
   217		if count == 0 {
   218			return 0.0
   219		}
   220		return sum / float64(count)
   221	}
   222	
   223	func columnMinMax(data [][]float64, col int) (float64, float64) {
   224		minVal := math.Inf(1)
   225		maxVal := math.Inf(-1)
   226		for _, row := range data {
   227			if col < len(row) && !math.IsNaN(row[col]) {
   228				if row[col] < minVal {
   229					minVal = row[col]
   230				}
[?2004hroot@n30009:/app# nl -ba ensemble.go | sed -n '374,396p'
