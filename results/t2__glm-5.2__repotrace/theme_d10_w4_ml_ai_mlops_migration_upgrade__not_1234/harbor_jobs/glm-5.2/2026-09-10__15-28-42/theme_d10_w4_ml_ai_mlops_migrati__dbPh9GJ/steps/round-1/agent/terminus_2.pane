   367	
   368	func cmdProfile(args []string) {
   369		if len(args) < 1 {
   370			fmt.Fprintf(os.Stderr, "usage: mlpipe profile <model>\n")
   371			os.Exit(1)
   372		}
   373		model := args[0]
   374	
   375		entry, err := resolveModel(model)
   376		if err != nil {
   377			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   378			os.Exit(1)
   379		}
   380	
   381		weightsPath := filepath.Join(entry.Path, "weights.bin")
   382		info, err := os.Stat(weightsPath)
   383		if err != nil {
   384			fmt.Fprintln(os.Stderr, "not found")
   385			os.Exit(1)
   386		}
   387	
   388		weights, _, err := loadModelArtifacts(entry.Path)
   389		if err != nil {
   390			fmt.Fprintf(os.Stderr, "error loading model: %v\n", err)
   391			os.Exit(1)
   392		}
   393	
   394		features := int(weights.NumFeatures)
   395		outputs := int(weights.NumOutputs)
   396		totalParams := features*outputs + outputs
   397	
   398		var wmin, wmax, wsum float64
   399		zeroCount := 0
   400		if len(weights.Weights) > 0 {
   401			wmin = weights.Weights[0]
   402			wmax = weights.Weights[0]
   403			for _, v := range weights.Weights {
   404				if v < wmin {
   405					wmin = v
   406				}
   407				if v > wmax {
   408					wmax = v
   409				}
   410				wsum += v
   411				if v == 0 {
   412					zeroCount++
   413				}
   414			}
   415		} else {
   416			wmin = 0
   417			wmax = 0
   418		}
   419		wavg := 0.0
   420		if len(weights.Weights) > 0 {
   421			wavg = wsum / float64(len(weights.Weights))
   422		}
   423		sparsity := 0.0
   424		if len(weights.Weights) > 0 {
   425			sparsity = float64(zeroCount) / float64(len(weights.Weights)) * 100
   426		}
   427	
   428		fmt.Printf("Name:       %s\n", entry.Name)
   429		fmt.Printf("Type:       %s\n", entry.Type)
   430		fmt.Printf("Format:     v%d\n", weights.Version)
   431		if weights.Version >= 2 {
   432			fmt.Printf("Activation: %s\n", activationIDToName(weights.Activation))
   433		}
   434		fmt.Printf("Dimensions: %d x %d\n", features, outputs)
   435		fmt.Printf("Parameters: %d\n", totalParams)
   436		fmt.Printf("File size:  %d bytes\n", info.Size())
   437		fmt.Printf("Weight min: %v\n", wmin)
   438		fmt.Printf("Weight max: %v\n", wmax)
   439		fmt.Printf("Weight avg: %v\n", wavg)
   440		fmt.Printf("Bias:       %v\n", weights.Bias)
   441		fmt.Printf("Sparsity:   %.1f%%\n", sparsity)
   442	}
   443	
   444	func cmdBatch(args []string) {
   445		if len(args) < 1 {
   446			fmt.Fprintf(os.Stderr, "usage: mlpipe batch <model> --dir <input_dir> --output-dir <output_dir> [--format csv|json]\n")
   447			os.Exit(1)
   448		}
   449	
   450		model := args[0]
   451		flags := parseFlags(args[1:])
   452	
   453		inputDir := flags["dir"]
   454		outputDir := flags["output-dir"]
   455		format := flags["format"]
   456		if format == "" {
   457			format = "csv"
   458		}
   459		if format != "csv" && format != "json" {
   460			fmt.Fprintf(os.Stderr, "error: unsupported format '%s', use 'csv' or 'json'\n", format)
   461			os.Exit(1)
   462		}
   463		if inputDir == "" {
   464			fmt.Fprintf(os.Stderr, "error: --dir is required\n")
   465			os.Exit(1)
   466		}
   467		if outputDir == "" {
   468			fmt.Fprintf(os.Stderr, "error: --output-dir is required\n")
   469			os.Exit(1)
   470		}
