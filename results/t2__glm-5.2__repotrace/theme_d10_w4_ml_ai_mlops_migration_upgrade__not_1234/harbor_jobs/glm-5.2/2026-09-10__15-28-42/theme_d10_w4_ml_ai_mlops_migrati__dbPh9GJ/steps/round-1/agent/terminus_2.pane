    20	func resolveModel(name string) (*RegistryEntry, error) {
    21		entries, err := loadRegistry()
    22		if err != nil {
    23			return nil, err
    24		}
    25		entry := findEntry(entries, name)
    26		if entry == nil || !modelDirExists(entry.Path) {
    27			fmt.Fprintln(os.Stderr, "not found")
    28			os.Exit(1)
    29		}
    30		return entry, nil
    31	}
