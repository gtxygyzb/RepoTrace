    39	type WeightsData struct {
    40		Version     uint32
    41		NumFeatures uint32
    42		NumOutputs  uint32
    43		Activation  uint32
    44		Weights     []float64
    45		Bias        []float64
    46	}
    47	
    48	func loadWeights(modelDir string) (*WeightsData, error) {
    49		f, err := os.Open(filepath.Join(modelDir, "weights.bin"))
    50		if err != nil {
    51			return nil, err
    52		}
    53		defer f.Close()
    54	
    55		magic := make([]byte, 4)
    56		if _, err := f.Read(magic); err != nil {
    57			return nil, fmt.Errorf("failed to read magic: %v", err)
    58		}
    59		if string(magic) != string(modelMagic) {
    60			return nil, fmt.Errorf("invalid model file: bad magic")
    61		}
    62	
    63		var ver, nf, no uint32
    64		if err := binary.Read(f, binary.LittleEndian, &ver); err != nil {
    65			return nil, fmt.Errorf("failed to read version: %v", err)
    66		}
    67		if err := binary.Read(f, binary.LittleEndian, &nf); err != nil {
    68			return nil, fmt.Errorf("failed to read num_features: %v", err)
    69		}
    70		if err := binary.Read(f, binary.LittleEndian, &no); err != nil {
    71			return nil, fmt.Errorf("failed to read num_outputs: %v", err)
    72		}
    73	
    74		var act uint32
    75		switch ver {
    76		case 1:
    77			act = 0
    78		case 2:
    79			if err := binary.Read(f, binary.LittleEndian, &act); err != nil {
    80				return nil, fmt.Errorf("failed to read activation: %v", err)
    81			}
    82		default:
    83			return nil, fmt.Errorf("unsupported model format version: %d", ver)
    84		}
    85	
    86		weights := make([]float64, nf*no)
    87		for i := range weights {
    88			if err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {
    89				return nil, fmt.Errorf("failed to read weight[%d]: %v", i, err)
    90			}
    91		}
    92	
    93		bias := make([]float64, no)
    94		for i := range bias {
    95			if err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {
    96				return nil, fmt.Errorf("failed to read bias[%d]: %v", i, err)
    97			}
    98		}
    99	
   100		return &WeightsData{
   101			Version:     ver,
   102			NumFeatures: nf,
   103			NumOutputs:  no,
   104			Activation:  act,
   105			Weights:     weights,
   106			Bias:        bias,
   107		}, nil
   108	}
   109	
   110	func writeWeights(path string, w *WeightsData) error {
   111		f, err := os.Create(path)
   112		if err != nil {
   113			return err
   114		}
   115		defer f.Close()
   116	
   117		if _, err := f.Write(modelMagic); err != nil {
   118			return err
   119		}
   120		if err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {
   121			return err
   122		}
   123		if err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {
   124			return err
   125		}
   126		if err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {
   127			return err
   128		}
   129		if w.Version >= 2 {
   130			if err := binary.Write(f, binary.LittleEndian, w.Activation); err != nil {
   131				return err
   132			}
   133		}
   134		for _, v := range w.Weights {
   135			if err := binary.Write(f, binary.LittleEndian, v); err != nil {
   136				return err
   137			}
   138		}
   139		for _, v := range w.Bias {
   140			if err := binary.Write(f, binary.LittleEndian, v); err != nil {
   141				return err
   142			}
   143		}
   144		return nil
   145	}
   146	
   147	const (
   148		activationNone    = 0
   149		activationSigmoid = 1
   150		activationReLU    = 2
   151		activationTanh    = 3
   152	)
   153	
   154	func activationNameToID(name string) (uint32, error) {
   155		switch strings.ToLower(name) {
   156		case "", "none":
   157			return activationNone, nil
   158		case "sigmoid":
   159			return activationSigmoid, nil
   160		case "relu":
   161			return activationReLU, nil
   162		case "tanh":
   163			return activationTanh, nil
   164		default:
   165			return 0, fmt.Errorf("invalid activation")
   166		}
   167	}
   168	
   169	func activationIDToName(id uint32) string {
   170		switch id {
   171		case activationNone:
   172			return "none"
   173		case activationSigmoid:
   174			return "sigmoid"
   175		case activationReLU:
   176			return "relu"
   177		case activationTanh:
   178			return "tanh"
   179		default:
   180			return "unknown"
   181		}
   182	}
   183	
   184	func applyActivation(x float64, activation uint32) float64 {
   185		switch activation {
   186		case activationSigmoid:
   187			return 1.0 / (1.0 + math.Exp(-x))
   188		case activationReLU:
   189			if x < 0 {
   190				return 0
   191			}
   192			return x
   193		case activationTanh:
   194			return math.Tanh(x)
   195		default:
   196			return x
   197		}
   198	}
   199	
   200	func saveModelMeta(modelDir string, meta map[string]string) error {
   201		f, err := os.Create(filepath.Join(modelDir, "model.meta"))
   202		if err != nil {
   203			return err
   204		}
   205		defer f.Close()
   206	
   207		keys := make([]string, 0, len(meta))
   208		for k := range meta {
   209			keys = append(keys, k)
   210		}
   211		sort.Strings(keys)
   212		for _, k := range keys {
   213			fmt.Fprintf(f, "%s=%s\n", k, meta[k])
   214		}
   215		return nil
   216	}
