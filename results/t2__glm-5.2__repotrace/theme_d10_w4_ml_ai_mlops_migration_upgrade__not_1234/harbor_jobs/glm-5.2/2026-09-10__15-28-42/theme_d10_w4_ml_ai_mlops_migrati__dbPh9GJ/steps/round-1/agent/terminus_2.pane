func readCSVRaw(path string) ([][]string, error) {
	f, err := os.Open(path)
	if err != nil {
		return nil, err
	}
	defer f.Close()

	reader := csv.NewReader(f)
	reader.FieldsPerRecord = -1
	return reader.ReadAll()
}

func isMissingValue(val string) bool {
	val = strings.TrimSpace(val)
	if val == "" {
		return true
	}
	lower := strings.ToLower(val)
	return lower == "na" || lower == "nan"
}

func cmdStats(args []string) {
	flags := parseFlags(args)
	input := flags["input"]
	if input == "" {
		fmt.Fprintf(os.Stderr, "usage: mlpipe stats --input <file>\n")
		os.Exit(1)
	}

	records, err := readCSVRaw(input)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
		os.Exit(1)
	}
	if len(records) == 0 {
		fmt.Println("No data found.")
		return
	}

	hasHeader := isHeader(records[0])
	start := 0
	if hasHeader {
		start = 1
	}

	numCols := 0
	for _, rec := range records {
		if len(rec) > numCols {
			numCols = len(rec)
		}
	}

	headers := make([]string, numCols)
	for i := 0; i < numCols; i++ {
		if hasHeader && i < len(records[0]) {
			headers[i] = strings.TrimSpace(records[0][i])
		} else {
			headers[i] = fmt.Sprintf("col_%d", i)
		}
	}

	type colStat struct {
		idx     int
		name    string
		count   int
		missing int
		min     float64
		max     float64
		mean    float64
		stddev  float64
		values  []float64
	}

	var stats []colStat
	numericCols := make([]int, 0)
	valuesByCol := make(map[int][]float64)

	for j := 0; j < numCols; j++ {
		values := make([]float64, 0, len(records)-start)
		missing := 0
		numeric := true

		for i := start; i < len(records); i++ {
			raw := ""
			if j < len(records[i]) {
				raw = strings.TrimSpace(records[i][j])
			}
			if isMissingValue(raw) {
				missing++
				values = append(values, math.NaN())
				continue
			}
			v, err := strconv.ParseFloat(raw, 64)
			if err != nil {
				numeric = false
				break
			}
			values = append(values, v)
		}

		if !numeric {
			continue
		}

		count := len(values) - missing
		st := colStat{
			idx:     j,
			name:    headers[j],
			count:   count,
			missing: missing,
			min:     math.NaN(),
			max:     math.NaN(),
			mean:    math.NaN(),
			stddev:  math.NaN(),
			values:  values,
		}

		if count > 0 {
			sum := 0.0
			sumSq := 0.0
			minVal := math.Inf(1)
			maxVal := math.Inf(-1)
			for _, v := range values {
				if math.IsNaN(v) {
					continue
				}
				if v < minVal {
					minVal = v
				}
				if v > maxVal {
					maxVal = v
				}
				sum += v
				sumSq += v * v
			}
			mean := sum / float64(count)
			variance := sumSq/float64(count) - mean*mean
			if variance < 0 {
				variance = 0
			}
			st.min = minVal
			st.max = maxVal
			st.mean = mean
			st.stddev = math.Sqrt(variance)
		}

		stats = append(stats, st)
		numericCols = append(numericCols, j)
		valuesByCol[j] = values
	}

	fmt.Println("Per-column statistics:")
	fmt.Printf("%-20s %6s %7s %12s %12s %12s %12s\n", "column", "count", "missing", "min", "max", "mean", "stddev")
	for _, st := range stats {
		fmt.Printf("%-20s %6d %7[?2004h> package main
