   143	func cmdEnsembleRun(args []string) {
   144	if len(args) < 1 {
   145	fmt.Fprintf(os.Stderr, "usage: mlpipe ensemble run <name> --input <file> [--format csv|json]\n")
   146	os.Exit(1)
   147	}
   148	name := args[0]
   149	flags := parseFlags(args[1:])
