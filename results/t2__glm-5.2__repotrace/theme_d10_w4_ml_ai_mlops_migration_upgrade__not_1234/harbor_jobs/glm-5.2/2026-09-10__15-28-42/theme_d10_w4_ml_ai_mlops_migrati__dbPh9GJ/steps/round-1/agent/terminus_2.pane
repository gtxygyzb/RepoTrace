    13	func cmdRun(args []string) {
    14		if len(args) < 1 {
    15			fmt.Fprintf(os.Stderr, "usage: mlpipe run <model> [--input <file>] [--output <file>] [--format csv|json]\n")
    16			os.Exit(1)
    17		}
    18	
    19		modelName := args[0]
    20		flags := parseFlags(args[1:])
    21	
    22		inputFile := flags["input"]
    23		if inputFile == "" {
    24			fmt.Fprintf(os.Stderr, "error: --input is required\n")
    25			os.Exit(1)
    26		}
    27	
    28		outputFormat := flags["format"]
    29		if outputFormat == "" {
    30			outputFormat = "csv"
    31		}
    32		if outputFormat != "csv" && outputFormat != "json" {
    33			fmt.Fprintf(os.Stderr, "error: unsupported format '%s', use 'csv' or 'json'\n", outputFormat)
    34			os.Exit(1)
    35		}
    36	
    37		entry, err := resolveModel(modelName)
    38		if err != nil {
    39			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    40			os.Exit(1)
    41		}
    42	
    43		weights, err := loadWeights(entry.Path)
    44		if err != nil {
    45			fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
    46			os.Exit(1)
    47		}
    48	
    49		pipelineCfg, err := loadPipelineConfig(entry.Path)
    50		if err != nil {
    51			fmt.Fprintf(os.Stderr, "error loading pipeline config: %v\n", err)
    52			os.Exit(1)
    53		}
    54	
    55		inputs, err := readInputCSV(inputFile)
    56		if err != nil {
    57			fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
    58			os.Exit(1)
    59		}
    60	
    61		if err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {
    62			fmt.Fprintf(os.Stderr, "error: input feature count mismatch: %v\n", err)
    63			os.Exit(1)
    64		}
    65	
    66		results := runInference(inputs, weights, pipelineCfg)
    67	
    68		outputFile := flags["output"]
    69		if outputFile != "" {
    70			f, err := os.Create(outputFile)
    71			if err != nil {
    72				fmt.Fprintf(os.Stderr, "error creating output file: %v\n", err)
    73				os.Exit(1)
    74			}
    75			defer f.Close()
    76			writeOutput(f, results, outputFormat)
    77		} else {
    78			writeOutput(os.Stdout, results, outputFormat)
    79		}
    80	}
    81	
    82	func readInputCSV(path string) ([][]float64, error) {
    83		f, err := os.Open(path)
    84		if err != nil {
    85			return nil, err
    86		}
    87		defer f.Close()
    88	
    89		reader := csv.NewReader(f)
    90		records, err := reader.ReadAll()
    91		if err != nil {
    92			return nil, err
    93		}
    94	
    95		var data [][]float64
    96		for i, record := range records {
    97			if i == 0 && isHeader(record) {
    98				continue
    99			}
   100			row := make([]float64, len(record))
   101			for j, val := range record {
   102				val = strings.TrimSpace(val)
   103				if val == "" || val == "NA" || val == "nan" {
   104					row[j] = math.NaN()
   105				} else {
   106					row[j], err = strconv.ParseFloat(val, 64)
   107					if err != nil {
   108						return nil, fmt.Errorf("row %d col %d: %v", i, j, err)
   109					}
   110				}
   111			}
   112			data = append(data, row)
   113		}
   114		return data, nil
   115	}
   116	
   117	func isHeader(record []string) bool {
   118		for _, val := range record {
   119			_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)
   120			if err == nil {
   121				return false
   122			}
   123		}
   124		return true
   125	}
   126	
   127	func runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {
   128		processed := preprocess(inputs, cfg)
   129	
   130		results := make([][]float64, len(processed))
   131		for i, row := range processed {
   132			output := make([]float64, weights.NumOutputs)
   133			for o := uint32(0); o < weights.NumOutputs; o++ {
   134				sum := weights.Bias[o]
   135				for f := uint32(0); f < weights.NumFeatures; f++ {
   136					if int(f) < len(row) {
   137						sum += row[f] * weights.Weights[o*weights.NumFeatures+f]
   138					}
   139				}
   140				output[o] = applyActivation(sum, weights.Activation)
   141			}
   142			results[i] = output
   143		}
   144	
   145		return postprocess(results, cfg)
   146	}
   147	
   148	func preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {
   149		result := make([][]float64, len(inputs))
   150		for i, row := range inputs {
   151			result[i] = make([]float64, len(row))
   152			copy(result[i], row)
   153		}
   154	
   155		if len(result) == 0 {
   156			return result
   157		}
   158	
   159		for i, row := range result {
   160			for j, val := range row {
   161				if math.IsNaN(val) {
   162					switch cfg.MissingStrategy {
   163					case "zero":
   164						result[i][j] = 0.0
   165					case "mean":
   166						result[i][j] = computeColumnMean(inputs, j)
   167					}
   168				}
   169			}
   170		}
   171	
   172		if cfg.Normalize {
   173			for j := 0; j < len(result[0]); j++ {
   174				minVal, maxVal := columnMinMax(result, j)
   175				rangeVal := maxVal - minVal
   176				if rangeVal == 0 {
   177					rangeVal = 1.0
   178				}
   179				for i := range result {
   180					normalized := (result[i][j] - minVal) / rangeVal
[?2004hroot@n30009:/app# nl -ba inference.go | sed -n '180,320p'
[?2004l   180					normalized := (result[i][j] - minVal) / rangeVal
   181					result[i][j] = cfg.ScaleMin + normalized*(cfg.ScaleMax-cfg.ScaleMin)
   182				}
   183			}
   184		}
   185	
   186		return result
   187	}
   188	
   189	func postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {
   190		for i, row := range results {
   191			for j, val := range row {
   192				val = math.Max(val, cfg.ClipMin)
   193				val = math.Min(val, cfg.ClipMax)
   194				results[i][j] = roundToDigits(val, cfg.RoundDigits)
   195			}
   196		}
   197		return results
   198	}
   199	
   200	func computeColumnMean(data [][]float64, col int) float64 {
   201		sum := 0.0
   202		count := 0
   203		for _, row := range data {
   204			if col < len(row) && !math.IsNaN(row[col]) {
   205				sum += row[col]
   206				count++
   207			}
   208		}
   209		if count == 0 {
   210			return 0.0
   211		}
   212		return sum / float64(count)
   213	}
   214	
   215	func columnMinMax(data [][]float64, col int) (float64, float64) {
   216		minVal := math.Inf(1)
   217		maxVal := math.Inf(-1)
   218		for _, row := range data {
   219			if col < len(row) && !math.IsNaN(row[col]) {
   220				if row[col] < minVal {
   221					minVal = row[col]
   222				}
   223				if row[col] > maxVal {
   224					maxVal = row[col]
   225				}
   226			}
   227		}
   228		return minVal, maxVal
   229	}
   230	
   231	func writeOutput(f *os.File, results [][]float64, format string) {
   232		switch format {
   233		case "csv":
   234			writer := csv.NewWriter(f)
   235			header := make([]string, len(results[0]))
   236			for i := range header {
   237				header[i] = fmt.Sprintf("output_%d", i)
   238			}
   239			writer.Write(header)
   240			for _, row := range results {
   241				record := make([]string, len(row))
   242				for j, val := range row {
   243					record[j] = strconv.FormatFloat(val, 'f', -1, 64)
   244				}
   245				writer.Write(record)
   246			}
   247			writer.Flush()
   248		case "json":
   249			type Prediction struct {
   250				Outputs []float64 `json:"outputs"`
   251			}
   252			type Result struct {
   253				Predictions []Prediction `json:"predictions"`
   254			}
   255			r := Result{}
   256			for _, row := range results {
   257				r.Predictions = append(r.Predictions, Prediction{Outputs: row})
   258			}
   259			enc := json.NewEncoder(f)
   260			enc.SetIndent("", "  ")
   261			enc.Encode(r)
   262		}
   263	}
