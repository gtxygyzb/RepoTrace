    15	func countCheckpoints(modelDir string) int {
    16		entries, err := os.ReadDir(checkpointsDir(modelDir))
    17		if err != nil {
    18			return 0
    19		}
    20		count := 0
    21		for _, entry := range entries {
    22			if entry.IsDir() {
    23				count++
    24			}
    25		}
    26		return count
    27	}
