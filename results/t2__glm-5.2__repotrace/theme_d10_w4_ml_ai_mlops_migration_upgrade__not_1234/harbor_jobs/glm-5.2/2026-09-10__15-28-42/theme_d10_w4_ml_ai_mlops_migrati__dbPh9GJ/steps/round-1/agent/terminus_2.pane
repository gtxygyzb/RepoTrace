    14	const (
    15		registryFile     = "/app/models/registry.idx"
    16		registryJSONFile = "/app/models/registry.json"
    17	)
    18	
    19	type RegistryEntry struct {
    20		Name    string   `json:"name"`
    21		Path    string   `json:"path"`
    22		Type    string   `json:"type"`
    23		Version int      `json:"version"`
    24		Created string   `json:"created"`
    25		Tags    []string `json:"tags"`
    26	}
    27	
    28	func loadRegistry() ([]RegistryEntry, error) {
    29		data, err := os.ReadFile(registryJSONFile)
    30		if err == nil {
    31			if len(strings.TrimSpace(string(data))) == 0 {
    32				return nil, nil
    33			}
    34			var entries []RegistryEntry
    35			if err := json.Unmarshal(data, &entries); err != nil {
    36				return nil, fmt.Errorf("parse registry.json: %w", err)
    37			}
    38			for i := range entries {
    39				entries[i].Tags = ensureTags(entries[i].Tags)
    40			}
    41			return entries, nil
    42		}
    43		if !os.IsNotExist(err) {
    44			return nil, err
    45		}
    46	
    47		if _, err := os.Stat(registryFile); err == nil {
    48			entries, err := loadOldRegistry()
    49			if err != nil {
    50				return nil, err
    51			}
    52			if err := saveRegistry(entries); err != nil {
    53				return nil, err
    54			}
    55			return entries, nil
    56		}
    57	
    58		return nil, nil
    59	}
    60	
    61	func loadOldRegistry() ([]RegistryEntry, error) {
    62		f, err := os.Open(registryFile)
    63		if err != nil {
    64			if os.IsNotExist(err) {
    65				return nil, nil
    66			}
    67			return nil, err
    68		}
    69		defer f.Close()
    70	
    71		var entries []RegistryEntry
    72		scanner := bufio.NewScanner(f)
    73		for scanner.Scan() {
    74			line := strings.TrimSpace(scanner.Text())
    75			if line == "" || strings.HasPrefix(line, "#") {
    76				continue
    77			}
    78			parts := strings.Split(line, "|")
    79			if len(parts) != 5 {
    80				continue
    81			}
    82			ver := 1
    83			fmt.Sscanf(parts[3], "%d", &ver)
    84			entries = append(entries, RegistryEntry{
    85				Name:    parts[0],
    86				Path:    parts[1],
    87				Type:    parts[2],
    88				Version: ver,
    89				Created: parts[4],
    90				Tags:    []string{},
    91			})
    92		}
    93		return entries, scanner.Err()
    94	}
    95	
    96	func saveRegistry(entries []RegistryEntry) error {
    97		dir := filepath.Dir(registryJSONFile)
    98		if err := os.MkdirAll(dir, 0755); err != nil {
    99			return err
   100		}
   101	
   102		out := make([]RegistryEntry, len(entries))
   103		for i, e := range entries {
   104			e.Tags = ensureTags(e.Tags)
   105			out[i] = e
   106		}
   107	
   108		data, err := json.MarshalIndent(out, "", "  ")
   109		if err != nil {
   110			return err
   111		}
   112		return os.WriteFile(registryJSONFile, data, 0644)
   113	}
   114	
   115	func ensureTags(tags []string) []string {
   116		if tags == nil {
   117			return []string{}
   118		}
   119		return tags
   120	}
   121	
   122	func findEntry(entries []RegistryEntry, name string) *RegistryEntry {
   123		for i := range entries {
   124			if entries[i].Name == name {
   125				return &entries[i]
   126			}
   127		}
   128		return nil
   129	}
