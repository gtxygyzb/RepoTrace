[?2004lfunc runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {
	processed := preprocess(inputs, cfg)

	results := make([][]float64, len(processed))
	for i, row := range processed {
		output := make([]float64, weights.NumOutputs)
		for o := uint32(0); o < weights.NumOutputs; o++ {
			sum := weights.Bias[o]
			for f := uint32(0); f < weights.NumFeatures; f++ {
				if int(f) < len(row) {
					sum += row[f] * weights.Weights[o*weights.NumFeatures+f]
				}
			}
			output[o] = applyActivation(sum, weights.Activation)
		}
		results[i] = output
	}

	return postprocess(results, cfg)
}

func preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {
	result := make([][]float64, len(inputs))
	for i, row := range inputs {
		result[i] = make([]float64, len(row))
		copy(result[i], row)
	}

	if len(result) == 0 {
		return result
	}

	for i, row := range result {
		for j, val := range row {
			if math.IsNaN(val) {
				switch cfg.MissingStrategy {
				case "zero":
					result[i][j] = 0.0
				case "mean":
					result[i][j] = computeColumnMean(inputs, j)
				}
			}
		}
	}

	if cfg.Normalize {
		for j := 0; j < len(result[0]); j++ {
			minVal, maxVal := columnMinMax(result, j)
			rangeVal := maxVal - minVal
			if rangeVal == 0 {
				rangeVal = 1.0
			}
			for i := range result {
				normalized := (result[i][j] - minVal) / rangeVal
				result[i][j] = cfg.ScaleMin + normalized*(cfg.ScaleMax-cfg.ScaleMin)
			}
		}
	}

	return result
}

