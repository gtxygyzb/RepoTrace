   363	func formatFloatList(vals []float64) string {
   364		parts := make([]string, len(vals))
   365		for i, v := range vals {
   366			parts[i] = formatFloat(v)
   367		}
   368		return "[" + strings.Join(parts, " ") + "]"
   369	}
