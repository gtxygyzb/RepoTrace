   364	func cmdBatch(args []string) {
   365		if len(args) < 1 {
   366			fmt.Fprintf(os.Stderr, "usage: mlpipe batch <model> --dir <input_dir> --output-dir <output_dir> [--format csv|json]\n")
   367			os.Exit(1)
   368		}
   369	
   370		model := args[0]
   371		flags := parseFlags(args[1:])
   372	
   373		inputDir := flags["dir"]
   374		outputDir := flags["output-dir"]
   375		format := flags["format"]
   376		if format == "" {
   377			format = "csv"
   378		}
   379		if format != "csv" && format != "json" {
   380			fmt.Fprintf(os.Stderr, "error: unsupported format '%s', use 'csv' or 'json'\n", format)
   381			os.Exit(1)
   382		}
   383		if inputDir == "" {
   384			fmt.Fprintf(os.Stderr, "error: --dir is required\n")
   385			os.Exit(1)
   386		}
   387		if outputDir == "" {
   388			fmt.Fprintf(os.Stderr, "error: --output-dir is required\n")
   389			os.Exit(1)
   390		}
   391	
   392		entry, err := resolveModel(model)
   393		if err != nil {
   394			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   395			os.Exit(1)
   396		}
   397	
   398		weights, cfg, err := loadModelArtifacts(entry.Path)
   399		if err != nil {
   400			fmt.Fprintf(os.Stderr, "error loading model: %v\n", err)
   401			os.Exit(1)
   402		}
   403	
   404		if err := os.MkdirAll(outputDir, 0755); err != nil {
   405			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   406			os.Exit(1)
   407		}
   408	
   409		dirEntries, err := os.ReadDir(inputDir)
   410		if err != nil {
   411			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   412			os.Exit(1)
   413		}
   414	
   415		var files []string
   416		for _, de := range dirEntries {
   417			if de.IsDir() {
   418				continue
   419			}
   420			name := de.Name()
   421			if strings.HasSuffix(strings.ToLower(name), ".csv") {
   422				files = append(files, filepath.Join(inputDir, name))
   423			}
   424		}
   425		sort.Strings(files)
   426	
   427		totalFiles := len(files)
   428		totalRows := 0
   429		processed := 0
   430		var failures []string
   431	
   432		for _, file := range files {
   433			inputs, err := readInputCSV(file)
   434			if err != nil {
   435				failures = append(failures, fmt.Sprintf("%s: %v", filepath.Base(file), err))
   436				continue
   437			}
   438	
   439			if err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {
   440				failures = append(failures, fmt.Sprintf("%s: %v", filepath.Base(file), err))
   441				continue
   442			}
   443	
   444			results := runInference(inputs, weights, cfg)
   445	
   446			base := strings.TrimSuffix(filepath.Base(file), filepath.Ext(file))
   447			outPath := filepath.Join(outputDir, base+"."+format)
   448			f, err := os.Create(outPath)
   449			if err != nil {
   450				failures = append(failures, fmt.Sprintf("%s: %v", filepath.Base(file), err))
   451				continue
   452			}
   453			writeOutput(f, results, format)
   454			f.Close()
   455	
   456			processed++
   457			totalRows += len(results)
   458		}
   459	
   460		fmt.Printf("Batch summary:\n")
   461		fmt.Printf("  total files processed: %d\n", totalFiles)
   462		fmt.Printf("  successful: %d\n", processed)
   463		fmt.Printf("  total rows: %d\n", totalRows)
   464		fmt.Printf("  failed files: %d\n", len(failures))
   465		for _, fail := range failures {
   466			fmt.Printf("  - %s\n", fail)
   467		}
   468	}
