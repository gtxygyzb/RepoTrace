    13	func cmdRun(args []string) {
    14		if len(args) < 1 {
    15			fmt.Fprintf(os.Stderr, "usage: mlpipe run <model> [--input <file>] [--output <file>] [--format csv|json]\n")
    16			os.Exit(1)
    17		}
    18	
    19		modelName := args[0]
    20		flags := parseFlags(args[1:])
    21	
    22		inputFile := flags["input"]
    23		if inputFile == "" {
    24			fmt.Fprintf(os.Stderr, "error: --input is required\n")
    25			os.Exit(1)
    26		}
    27	
    28		outputFormat := flags["format"]
    29		if outputFormat == "" {
    30			outputFormat = "csv"
    31		}
    32		if outputFormat != "csv" && outputFormat != "json" {
    33			fmt.Fprintf(os.Stderr, "error: unsupported format '%s', use 'csv' or 'json'\n", outputFormat)
    34			os.Exit(1)
    35		}
    36	
    37		entry, err := resolveModel(modelName)
    38		if err != nil {
    39			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    40			os.Exit(1)
    41		}
    42	
    43		weights, err := loadWeights(entry.Path)
    44		if err != nil {
    45			fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
    46			os.Exit(1)
    47		}
    48	
    49		pipelineCfg, err := loadPipelineConfig(entry.Path)
    50		if err != nil {
    51			fmt.Fprintf(os.Stderr, "error loading pipeline config: %v\n", err)
    52			os.Exit(1)
    53		}
    54	
    55		inputs, err := readInputCSV(inputFile)
    56		if err != nil {
    57			fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
    58			os.Exit(1)
    59		}
    60	
    61		if err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {
    62			fmt.Fprintf(os.Stderr, "error: input feature count mismatch: %v\n", err)
    63			os.Exit(1)
    64		}
    65	
    66		results := runInference(inputs, weights, pipelineCfg)
    67	
    68		outputFile := flags["output"]
    69		if outputFile != "" {
    70			f, err := os.Create(outputFile)
    71			if err != nil {
    72				fmt.Fprintf(os.Stderr, "error creating output file: %v\n", err)
    73				os.Exit(1)
    74			}
    75			defer f.Close()
    76			writeOutput(f, results, outputFormat)
    77		} else {
    78			writeOutput(os.Stdout, results, outputFormat)
    79		}
    80	}
