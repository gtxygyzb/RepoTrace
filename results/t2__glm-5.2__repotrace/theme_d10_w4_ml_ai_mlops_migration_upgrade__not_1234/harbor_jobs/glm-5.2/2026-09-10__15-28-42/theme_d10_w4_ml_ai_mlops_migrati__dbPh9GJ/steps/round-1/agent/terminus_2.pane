    55	func readCSVRaw(path string) ([][]string, error) {
    56		f, err := os.Open(path)
    57		if err != nil {
    58			return nil, err
    59		}
    60		defer f.Close()
    61	
    62		reader := csv.NewReader(f)
    63		reader.FieldsPerRecord = -1
    64		return reader.ReadAll()
    65	}
    66	
    67	func isMissingValue(val string) bool {
    68		val = strings.TrimSpace(val)
    69		if val == "" {
    70			return true
    71		}
    72		lower := strings.ToLower(val)
    73		return lower == "na" || lower == "nan"
    74	}
