[?2004lpackage main

import (
	"fmt"
	"os"
	"path/filepath"
)

func cmdMigrate(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe migrate <model> [--activation <type>]\n")
		os.Exit(1)
	}

	name := args[0]
	flags := parseFlags(args[1:])

	entries, err := loadRegistry()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	entry := findEntry(entries, name)
	if entry == nil {
		fmt.Fprintln(os.Stderr, "model not found")
		os.Exit(1)
	}

	if !modelDirExists(entry.Path) {
		fmt.Fprintln(os.Stderr, "not found")
		os.Exit(1)
	}

	activationName := flags["activation"]
	if activationName == "" {
		activationName = "none"
	}

	activationType, err := activationNameToID(activationName)
	if err != nil {
		fmt.Fprintln(os.Stderr, "invalid activation")
		os.Exit(1)
	}

	weights, err := loadWeights(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
		os.Exit(1)
	}

	if weights.Version >= 2 {
		fmt.Printf("Model '%s' is already migrated to format v2.\n", name)
		os.Exit(0)
	}

	weightsPath := filepath.Join(entry.Path, "weights.bin")
	backupPath := filepath.Join(entry.Path, "weights.bin.v1bak")

	data, err := os.ReadFile(weightsPath)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error reading weights: %v\n", err)
		os.Exit(1)
	}
	if err := os.WriteFile(backupPath, data, 0644); err != nil {
		fmt.Fprintf(os.Stderr, "error writing backup: %v\n", err)
		os.Exit(1)
	}

	weights.Version = 2
	weights.Activation = activationType
	if err := writeWeights(weightsPath, weights); err != nil {
		fmt.Fprintf(os.Stderr, "error writing weights: %v\n", err)
		os.Exit(1)
	}

	meta, err := loadModelMeta(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
		os.Exit(1)
	}
	meta["format_version"] = "2"
	meta["activation"] = activationIDToName(activationType)
	if err := saveModelMeta(entry.Path, meta); err != nil {
		fmt.Fprintf(os.Stderr, "error updating metadata: %v\n", err)
		os.Exit(1)
	}

	fmt.Printf("Model '%s' migrated to format v2 (activation=%s).\n", name, activationIDToName(activationType))
}

