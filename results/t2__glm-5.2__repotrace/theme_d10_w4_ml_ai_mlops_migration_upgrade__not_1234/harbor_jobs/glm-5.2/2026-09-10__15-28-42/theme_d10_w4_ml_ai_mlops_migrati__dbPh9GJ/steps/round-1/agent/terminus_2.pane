    13	func cmdRun(args []string) {
    14		if len(args) < 1 {
    15			fmt.Fprintf(os.Stderr, "usage: mlpipe run <model> [--input <file>] [--output <file>] [--format csv|json]\n")
    16			os.Exit(1)
    17		}
    18	
    19		modelName := args[0]
    20		flags := parseFlags(args[1:])
    21	
    22		inputFile := flags["input"]
    23		if inputFile == "" {
    24			fmt.Fprintf(os.Stderr, "error: --input is required\n")
    25			os.Exit(1)
    26		}
    27	
    28		outputFormat := flags["format"]
    29		if outputFormat == "" {
    30			outputFormat = "csv"
    31		}
    32		if outputFormat != "csv" && outputFormat != "json" {
    33			fmt.Fprintf(os.Stderr, "error: unsupported format '%s', use 'csv' or 'json'\n", outputFormat)
    34			os.Exit(1)
    35		}
    36	
    37		entry, err := resolveModel(modelName)
    38		if err != nil {
    39			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    40			os.Exit(1)
    41		}
    42	
    43		weights, err := loadWeights(entry.Path)
    44		if err != nil {
    45			fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
    46			os.Exit(1)
    47		}
    48	
    49		pipelineCfg, err := loadPipelineConfig(entry.Path)
    50		if err != nil {
    51			fmt.Fprintf(os.Stderr, "error loading pipeline config: %v\n", err)
    52			os.Exit(1)
    53		}
    54	
    55		if flags["strict"] == "true" {
    56			summary := validateInputFile(modelName, inputFile, weights)
    57			if summary.InvalidRows > 0 {
    58				printValidationSummary(summary)
    59				os.Exit(1)
    60			}
    61		}
    62	
    63		inputs, err := readInputCSV(inputFile)
    64		if err != nil {
    65			fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
    66			os.Exit(1)
    67		}
    68	
    69		if err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {
    70			fmt.Fprintf(os.Stderr, "error: input feature count mismatch: %v\n", err)
    71			os.Exit(1)
    72		}
    73	
    74		results := runInference(inputs, weights, pipelineCfg)
    75	
    76		outputFile := flags["output"]
    77		if outputFile != "" {
    78			f, err := os.Create(outputFile)
    79			if err != nil {
    80				fmt.Fprintf(os.Stderr, "error creating output file: %v\n", err)
    81				os.Exit(1)
    82			}
    83			defer f.Close()
    84			writeOutput(f, results, outputFormat)
    85		} else {
    86			writeOutput(os.Stdout, results, outputFormat)
    87		}
    88	}
    89	
    90	func readInputCSV(path string) ([][]float64, error) {
    91		f, err := os.Open(path)
    92		if err != nil {
    93			return nil, err
    94		}
    95		defer f.Close()
    96	
    97		reader := csv.NewReader(f)
    98		records, err := reader.ReadAll()
    99		if err != nil {
   100			return nil, err
   101		}
   102	
   103		var data [][]float64
   104		for i, record := range records {
   105			if i == 0 && isHeader(record) {
   106				continue
   107			}
   108			row := make([]float64, len(record))
   109			for j, val := range record {
   110				val = strings.TrimSpace(val)
   111				if val == "" || val == "NA" || val == "nan" {
   112					row[j] = math.NaN()
   113				} else {
   114					row[j], err = strconv.ParseFloat(val, 64)
   115					if err != nil {
   116						return nil, fmt.Errorf("row %d col %d: %v", i, j, err)
   117					}
   118				}
   119			}
   120			data = append(data, row)
   121		}
   122		return data, nil
   123	}
   124	
   125	func isHeader(record []string) bool {
   126		for _, val := range record {
   127			_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)
   128			if err == nil {
   129				return false
   130			}
   131		}
   132		return true
   133	}
   134	
   135	func runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {
   136		processed := preprocess(inputs, cfg)
   137	
   138		results := make([][]float64, len(processed))
   139		for i, row := range processed {
   140			output := make([]float64, weights.NumOutputs)
   141			for o := uint32(0); o < weights.NumOutputs; o++ {
   142				sum := weights.Bias[o]
   143				for f := uint32(0); f < weights.NumFeatures; f++ {
   144					if int(f) < len(row) {
   145						sum += row[f] * weights.Weights[o*weights.NumFeatures+f]
   146					}
   147				}
   148				output[o] = applyActivation(sum, weights.Activation)
   149			}
   150			results[i] = output
   151		}
   152	
   153		return postprocess(results, cfg)
   154	}
   155	
   156	func preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {
   157		result := make([][]float64, len(inputs))
   158		for i, row := range inputs {
   159			result[i] = make([]float64, len(row))
   160			copy(result[i], row)
   161		}
   162	
   163		if len(result) == 0 {
   164			return result
   165		}
   166	
   167		for i, row := range result {
   168			for j, val := range row {
   169				if math.IsNaN(val) {
   170					switch cfg.MissingStrategy {
   171					case "zero":
   172						result[i][j] = 0.0
   173					case "mean":
   174						result[i][j] = computeColumnMean(inputs, j)
   175					}
   176				}
   177			}
   178		}
   179	
   180		if cfg.Normalize {
   181			for j := 0; j < len(result[0]); j++ {
   182				minVal, maxVal := columnMinMax(result, j)
   183				rangeVal := maxVal - minVal
   184				if rangeVal == 0 {
   185					rangeVal = 1.0
   186				}
   187				for i := range result {
   188					normalized := (result[i][j] - minVal) / rangeVal
   189					result[i][j] = cfg.ScaleMin + normalized*(cfg.ScaleMax-cfg.ScaleMin)
   190				}
   191			}
   192		}
   193	
   194		return result
   195	}
   196	
   197	func postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {
   198		for i, row := range results {
   199			for j, val := range row {
   200				val = math.Max(val, cfg.ClipMin)
   201				val = math.Min(val, cfg.ClipMax)
   202				results[i][j] = roundToDigits(val, cfg.RoundDigits)
   203			}
   204		}
   205		return results
   206	}
   207	
   208	func computeColumnMean(data [][]float64, col int) float64 {
   209		sum := 0.0
   210		count := 0
   211		for _, row := range data {
   212			if col < len(row) && !math.IsNaN(row[col]) {
   213				sum += row[col]
   214				count++
   215			}
   216		}
   217		if count == 0 {
   218			return 0.0
   219		}
   220		return sum / float64(count)
   221	}
   222	
   223	func columnMinMax(data [][]float64, col int) (float64, float64) {
   224		minVal := math.Inf(1)
   225		maxVal := math.Inf(-1)
   226		for _, row := range data {
   227			if col < len(row) && !math.IsNaN(row[col]) {
   228				if row[col] < minVal {
   229					minVal = row[col]
   230				}
   231				if row[col] > maxVal {
   232					maxVal = row[col]
   233				}
   234			}
   235		}
   236		return minVal, maxVal
   237	}
   238	
   239	func writeOutput(f *os.File, results [][]float64, format string) {
   240		switch format {
   241		case "csv":
   242			writer := csv.NewWriter(f)
   243			header := make([]string, len(results[0]))
   244			for i := range header {
   245				header[i] = fmt.Sprintf("output_%d", i)
   246			}
   247			writer.Write(header)
   248			for _, row := range results {
   249				record := make([]string, len(row))
   250				for j, val := range row {
   251					record[j] = strconv.FormatFloat(val, 'f', -1, 64)
   252				}
   253				writer.Write(record)
   254			}
   255			writer.Flush()
   256		case "json":
   257			type Prediction struct {
   258				Outputs []float64 `json:"outputs"`
   259			}
   260			type Result struct {
