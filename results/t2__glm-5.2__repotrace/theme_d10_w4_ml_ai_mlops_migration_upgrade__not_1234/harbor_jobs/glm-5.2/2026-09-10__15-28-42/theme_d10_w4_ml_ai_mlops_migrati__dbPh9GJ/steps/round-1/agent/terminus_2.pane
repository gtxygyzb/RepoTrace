    11	func main() {
    12		if len(os.Args) < 2 {
    13			printUsage()
    14			os.Exit(1)
    15		}
    16	
    17		command := os.Args[1]
    18		args := os.Args[2:]
    19	
    20		switch command {
    21		case "list":
    22			cmdList(args)
    23		case "info":
    24			cmdInfo(args)
    25		case "register":
    26			cmdRegister(args)
    27		case "remove":
    28			cmdRemove(args)
    29		case "tag":
    30			cmdTag(args)
    31		case "untag":
    32			cmdUntag(args)
    33		case "search":
    34			cmdSearch(args)
    35		case "run":
    36			cmdRun(args)
    37		case "stats":
    38			cmdStats(args)
    39		case "diff":
    40			cmdDiff(args)
    41		case "batch":
    42			cmdBatch(args)
    43		case "validate":
    44			cmdValidate(args)
    45		case "export":
    46			cmdExport(args)
    47		case "import":
    48			cmdImport(args)
    49		case "clone":
    50			cmdClone(args)
    51		case "checkpoint":
    52			cmdCheckpoint(args)
    53		case "checkpoints":
    54			cmdCheckpoints(args)
    55		case "rollback":
    56			cmdRollback(args)
    57		case "migrate":
    58			cmdMigrate(args)
    59		case "compat":
    60			cmdCompat(args)
    61		case "version":
    62			fmt.Printf("mlpipe version %s\n", version)
    63		case "help":
    64			printUsage()
    65		default:
    66			fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
    67			printUsage()
    68			os.Exit(1)
    69		}
    70	}
    71	
    72	func printUsage() {
    73		usage := `mlpipe - ML Inference Pipeline Manager
    74	
    75	Usage: mlpipe <command> [arguments]
    76	
    77	Commands:
    78	  list                          List all registered models
    79	  info <model>                  Show model details
    80	  register <name> <path>        Register a model from directory
    81	  remove <name>                 Remove a model from registry
    82	  run <model> [options]         Run inference
    83	  stats --input <file>          Input statistics profiling
    84	  diff <model1> <model2> --input <file>
    85	                                Compare two models on same input
    86	  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
    87	                                Batch inference over CSV files
    88	  validate <model>              Validate model integrity
    89	  export <model> --output <file> Export model to JSON file
    90	  import <path> [--name <name>] Import model from JSON file
    91	  clone <model> <new_name>      Clone model to new name
