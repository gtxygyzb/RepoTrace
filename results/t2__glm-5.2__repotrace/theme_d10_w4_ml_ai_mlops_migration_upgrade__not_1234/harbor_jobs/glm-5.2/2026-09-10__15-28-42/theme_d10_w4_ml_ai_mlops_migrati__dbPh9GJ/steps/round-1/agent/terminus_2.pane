	case "prune":
		cmdPrune(args)
	case "profile":
		cmdProfile(args)
	case "explain":
		cmdExplain(args)
	case "validate":
		cmdValidate(args)
	case "validate-input":
		cmdValidateInput(args)
	case "schema":
		cmdSchema(args)
	case "export":
		cmdExport(args)
	case "import":
		cmdImport(args)
	case "clone":
		cmdClone(args)
	case "checkpoint":
		cmdCheckpoint(args)
	case "checkpoints":
		cmdCheckpoints(args)
	case "rollback":
		cmdRollback(args)
	case "migrate":
		cmdMigrate(args)
	case "compat":
		cmdCompat(args)
	case "version":
		fmt.Printf("mlpipe version %s\n", version)
	case "help":
		printUsage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
		printUsage()
		os.Exit(1)
	}
}

