    11	
    12	const registryFile = "/app/models/registry.idx"
    13	
    14	type RegistryEntry struct {
    15		Name    string
    16		Path    string
    17		Type    string
    18		Version int
    19		Created string
    20	}
    21	
    22	func loadRegistry() ([]RegistryEntry, error) {
    23		f, err := os.Open(registryFile)
    24		if err != nil {
    25			if os.IsNotExist(err) {
    26				return nil, nil
    27			}
    28			return nil, err
    29		}
    30		defer f.Close()
    31	
    32		var entries []RegistryEntry
    33		scanner := bufio.NewScanner(f)
    34		for scanner.Scan() {
    35			line := strings.TrimSpace(scanner.Text())
    36			if line == "" || strings.HasPrefix(line, "#") {
    37				continue
    38			}
    39			parts := strings.Split(line, "|")
    40			if len(parts) != 5 {
    41				continue
    42			}
    43			ver := 1
    44			fmt.Sscanf(parts[3], "%d", &ver)
    45			entries = append(entries, RegistryEntry{
    46				Name:    parts[0],
    47				Path:    parts[1],
    48				Type:    parts[2],
    49				Version: ver,
    50				Created: parts[4],
    51			})
    52		}
    53		return entries, scanner.Err()
    54	}
    55	
    56	func saveRegistry(entries []RegistryEntry) error {
    57		dir := filepath.Dir(registryFile)
    58		if err := os.MkdirAll(dir, 0755); err != nil {
    59			return err
    60		}
    61	
    62		f, err := os.Create(registryFile)
    63		if err != nil {
    64			return err
    65		}
    66		defer f.Close()
    67	
    68		fmt.Fprintln(f, "# mlpipe registry v1")
    69		for _, e := range entries {
    70			fmt.Fprintf(f, "%s|%s|%s|%d|%s\n", e.Name, e.Path, e.Type, e.Version, e.Created)
    71		}
    72		return nil
    73	}
    74	
    75	func findEntry(entries []RegistryEntry, name string) *RegistryEntry {
    76		for i := range entries {
    77			if entries[i].Name == name {
    78				return &entries[i]
    79			}
    80		}
    81		return nil
    82	}
    83	
    84	func cmdList(args []string) {
    85		entries, err := loadRegistry()
    86		if err != nil {
    87			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    88			os.Exit(1)
    89		}
    90		if len(entries) == 0 {
    91			fmt.Println("No models registered.")
    92			return
    93		}
    94		fmt.Printf("%-20s %-10s %-8s %s\n", "NAME", "TYPE", "VERSION", "CREATED")
    95		for _, e := range entries {
    96			fmt.Printf("%-20s %-10s %-8d %s\n", e.Name, e.Type, e.Version, e.Created)
    97		}
    98	}
    99	
   100	func cmdInfo(args []string) {
   101		if len(args) < 1 {
   102			fmt.Fprintf(os.Stderr, "usage: mlpipe info <model>\n")
   103			os.Exit(1)
   104		}
   105		name := args[0]
   106		entries, err := loadRegistry()
   107		if err != nil {
   108			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   109			os.Exit(1)
   110		}
   111		entry := findEntry(entries, name)
   112		if entry == nil {
   113			fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
   114			os.Exit(1)
   115		}
   116		if !modelDirExists(entry.Path) {
   117			fmt.Fprintf(os.Stderr, "error: model directory not found\n")
   118			os.Exit(1)
   119		}
   120	
   121		meta, err := loadModelMeta(entry.Path)
   122		if err != nil {
   123			fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
   124			os.Exit(1)
   125		}
   126	
   127		weights, err := loadWeights(entry.Path)
   128		if err != nil {
   129			fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
   130			os.Exit(1)
   131		}
   132	
   133		fmt.Printf("Name:        %s\n", meta["name"])
   134		fmt.Printf("Type:        %s\n", meta["type"])
   135		fmt.Printf("Version:     %s\n", meta["version"])
   136		fmt.Printf("Created:     %s\n", meta["created"])
   137		fmt.Printf("Description: %s\n", meta["description"])
   138		fmt.Printf("Features:    %s\n", meta["features"])
   139		fmt.Printf("Outputs:     %s\n", meta["outputs"])
   140		fmt.Printf("Format:     v%d\n", weights.Version)
   141		fmt.Printf("Activation: %s\n", activationIDToName(weights.Activation))
   142		fmt.Printf("Path:        %s\n", entry.Path)
   143	}
   144	
   145	func cmdRegister(args []string) {
   146		if len(args) < 2 {
   147			fmt.Fprintf(os.Stderr, "usage: mlpipe register <name> <path>\n")
   148			os.Exit(1)
   149		}
   150		name := args[0]
   151		modelPath := args[1]
   152	
   153		absPath, err := filepath.Abs(modelPath)
   154		if err != nil {
   155			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   156			os.Exit(1)
   157		}
   158	
   159		if _, err := os.Stat(filepath.Join(absPath, "model.meta")); err != nil {
   160			fmt.Fprintf(os.Stderr, "error: no model.meta found at %s\n", absPath)
   161			os.Exit(1)
   162		}
   163	
   164		meta, err := loadModelMeta(absPath)
   165		if err != nil {
   166			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   167			os.Exit(1)
   168		}
   169	
   170		entries, err := loadRegistry()
   171		if err != nil {
   172			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   173			os.Exit(1)
   174		}
   175	
   176		if findEntry(entries, name) != nil {
   177			fmt.Fprintf(os.Stderr, "error: model '%s' already registered\n", name)
   178			os.Exit(1)
   179		}
   180	
   181		modelType := meta["type"]
   182		if modelType == "" {
   183			modelType = "unknown"
   184		}
   185	
   186		entries = append(entries, RegistryEntry{
   187			Name:    name,
   188			Path:    absPath,
   189			Type:    modelType,
   190			Version: 1,
   191			Created: time.Now().Format("2006-01-02"),
   192		})
   193	
   194		if err := saveRegistry(entries); err != nil {
   195			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   196			os.Exit(1)
   197		}
   198		fmt.Printf("Model '%s' registered successfully.\n", name)
   199	}
   200	
   201	func cmdRemove(args []string) {
   202		if len(args) < 1 {
   203			fmt.Fprintf(os.Stderr, "usage: mlpipe remove <name>\n")
   204			os.Exit(1)
   205		}
   206		name := args[0]
   207	
   208		entries, err := loadRegistry()
   209		if err != nil {
   210			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   211			os.Exit(1)
   212		}
   213	
   214		found := false
   215		var newEntries []RegistryEntry
   216		for _, e := range entries {
   217			if e.Name == name {
   218				found = true
   219			} else {
   220				newEntries = append(newEntries, e)
   221			}
   222		}
   223	
   224		if !found {
   225			fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
   226			os.Exit(1)
   227		}
   228	
   229		if err := saveRegistry(newEntries); err != nil {
   230			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   231			os.Exit(1)
   232		}
   233		fmt.Printf("Model '%s' removed.\n", name)
   234	}
