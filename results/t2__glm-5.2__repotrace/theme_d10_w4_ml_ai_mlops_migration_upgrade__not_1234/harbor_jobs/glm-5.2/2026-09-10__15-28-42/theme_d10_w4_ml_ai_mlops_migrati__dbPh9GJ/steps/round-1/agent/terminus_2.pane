   157	func cmdInfo(args []string) {
   158	if len(args) < 1 {
   159	fmt.Fprintf(os.Stderr, "usage: mlpipe info <model>\n")
   160	os.Exit(1)
   161	}
   162	name := args[0]
   163	entries, err := loadRegistry()
   164	if err != nil {
   165	fmt.Fprintf(os.Stderr, "error: %v\n", err)
   166	os.Exit(1)
