   110	func parseFlags(args []string) map[string]string {
   111		flags := make(map[string]string)
   112		for i := 0; i < len(args); i++ {
   113			if strings.HasPrefix(args[i], "--") {
   114				key := strings.TrimPrefix(args[i], "--")
   115				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
   116					flags[key] = args[i+1]
   117					i++
   118				} else {
   119					flags[key] = "true"
   120				}
   121			}
   122		}
   123		return flags
   124	}
