    39	
    40	func validateModel(modelDir string) []string {
    41		var errors []string
    42	
    43		metaPath := filepath.Join(modelDir, "model.meta")
    44		if _, err := os.Stat(metaPath); err != nil {
    45			errors = append(errors, "missing model.meta")
    46		} else {
    47			meta, err := loadModelMeta(modelDir)
    48			if err != nil {
    49				errors = append(errors, fmt.Sprintf("cannot parse model.meta: %v", err))
    50			} else {
    51				if meta["name"] == "" {
    52					errors = append(errors, "model.meta: missing 'name' field")
    53				}
    54				if meta["type"] == "" {
    55					errors = append(errors, "model.meta: missing 'type' field")
    56				}
    57				if meta["features"] == "" {
    58					errors = append(errors, "model.meta: missing 'features' field")
    59				}
    60				if meta["outputs"] == "" {
    61					errors = append(errors, "model.meta: missing 'outputs' field")
    62				}
    63			}
    64		}
    65	
    66		weightsPath := filepath.Join(modelDir, "weights.bin")
    67		if _, err := os.Stat(weightsPath); err != nil {
    68			errors = append(errors, "missing weights.bin")
    69		} else {
    70			_, err := loadWeights(modelDir)
    71			if err != nil {
    72				errors = append(errors, fmt.Sprintf("cannot parse weights.bin: %v", err))
    73			}
    74		}
    75	
    76		cfgPath := filepath.Join(modelDir, "pipeline.cfg")
    77		if _, err := os.Stat(cfgPath); err != nil {
    78			errors = append(errors, "missing pipeline.cfg")
    79		} else {
    80			_, err := loadPipelineConfig(modelDir)
    81			if err != nil {
    82				errors = append(errors, fmt.Sprintf("cannot parse pipeline.cfg: %v", err))
    83			}
    84		}
    85	
    86		return errors
    87	}
