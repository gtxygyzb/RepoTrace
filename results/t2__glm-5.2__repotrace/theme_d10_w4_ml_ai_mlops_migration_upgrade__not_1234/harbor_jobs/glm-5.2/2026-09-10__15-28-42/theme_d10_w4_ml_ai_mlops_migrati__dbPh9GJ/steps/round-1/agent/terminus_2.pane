    50	
    51	func loadWeights(modelDir string) (*WeightsData, error) {
    52		f, err := os.Open(filepath.Join(modelDir, "weights.bin"))
    53		if err != nil {
    54			return nil, err
    55		}
    56		defer f.Close()
    57	
    58		magic := make([]byte, 4)
    59		if _, err := f.Read(magic); err != nil {
    60			return nil, fmt.Errorf("failed to read magic: %v", err)
    61		}
    62		if string(magic) != string(modelMagic) {
    63			return nil, fmt.Errorf("invalid model file: bad magic")
    64		}
    65	
    66		var ver, nf, no uint32
    67		if err := binary.Read(f, binary.LittleEndian, &ver); err != nil {
    68			return nil, fmt.Errorf("failed to read version: %v", err)
    69		}
    70	
    71		var hasher hash.Hash32
    72		r := io.Reader(f)
    73		if ver == 3 {
    74			hasher = crc32.NewIEEE()
    75			if _, err := hasher.Write(magic); err != nil {
    76				return nil, fmt.Errorf("failed to compute checksum: %v", err)
    77			}
    78			if err := binary.Write(hasher, binary.LittleEndian, ver); err != nil {
    79				return nil, fmt.Errorf("failed to compute checksum: %v", err)
    80			}
    81			r = io.TeeReader(f, hasher)
    82		}
    83	
    84		if err := binary.Read(r, binary.LittleEndian, &nf); err != nil {
    85			return nil, fmt.Errorf("failed to read num_features: %v", err)
    86		}
    87		if err := binary.Read(r, binary.LittleEndian, &no); err != nil {
    88			return nil, fmt.Errorf("failed to read num_outputs: %v", err)
    89		}
    90	
    91		var act uint32
    92		switch ver {
    93		case 1:
    94			act = 0
    95		case 2, 3:
    96			if err := binary.Read(r, binary.LittleEndian, &act); err != nil {
    97				return nil, fmt.Errorf("failed to read activation: %v", err)
    98			}
    99		default:
   100			return nil, fmt.Errorf("unsupported model format version: %d", ver)
   101		}
   102	
   103		weights := make([]float64, nf*no)
   104		for i := range weights {
   105			if err := binary.Read(r, binary.LittleEndian, &weights[i]); err != nil {
   106				return nil, fmt.Errorf("failed to read weight[%d]: %v", i, err)
   107			}
   108		}
   109	
   110		bias := make([]float64, no)
   111		for i := range bias {
   112			if err := binary.Read(r, binary.LittleEndian, &bias[i]); err != nil {
   113				return nil, fmt.Errorf("failed to read bias[%d]: %v", i, err)
   114			}
   115		}
   116	
   117		if ver == 3 {
   118			var checksum uint32
   119			if err := binary.Read(f, binary.LittleEndian, &checksum); err != nil {
   120				return nil, fmt.Errorf("failed to read checksum: %v", err)
   121			}
   122			if hasher.Sum32() != checksum {
   123				return nil, fmt.Errorf("checksum mismatch")
   124			}
   125		}
   126	
   127		if _, err := f.Read(make([]byte, 1)); err != io.EOF {
   128			return nil, fmt.Errorf("extra data after weights")
   129		}
   130	
   131		return &WeightsData{
   132			Version:     ver,
   133			NumFeatures: nf,
   134			NumOutputs:  no,
   135			Activation:  act,
   136			Weights:     weights,
   137			Bias:        bias,
   138		}, nil
   139	}
   140	
