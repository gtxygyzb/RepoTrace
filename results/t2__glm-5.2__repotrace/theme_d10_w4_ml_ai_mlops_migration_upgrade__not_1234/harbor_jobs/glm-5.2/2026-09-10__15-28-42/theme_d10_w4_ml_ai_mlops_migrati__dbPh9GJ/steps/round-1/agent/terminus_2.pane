   131	func parseFlags(args []string) map[string]string {
   132		flags := make(map[string]string)
   133		for i := 0; i < len(args); i++ {
   134			if strings.HasPrefix(args[i], "--") {
   135				key := strings.TrimPrefix(args[i], "--")
   136				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
   137					flags[key] = args[i+1]
   138					i++
   139				} else {
   140					flags[key] = "true"
   141				}
   142			}
   143		}
   144		return flags
   145	}
