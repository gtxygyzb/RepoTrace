   100	func cmdInfo(args []string) {
   101		if len(args) < 1 {
   102			fmt.Fprintf(os.Stderr, "usage: mlpipe info <model>\n")
   103			os.Exit(1)
   104		}
   105		name := args[0]
   106		entries, err := loadRegistry()
   107		if err != nil {
   108			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   109			os.Exit(1)
   110		}
   111		entry := findEntry(entries, name)
   112		if entry == nil {
   113			fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
   114			os.Exit(1)
   115		}
   116	
   117		meta, err := loadModelMeta(entry.Path)
   118		if err != nil {
   119			fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
   120			os.Exit(1)
   121		}
   122	
   123		fmt.Printf("Name:        %s\n", meta["name"])
   124		fmt.Printf("Type:        %s\n", meta["type"])
   125		fmt.Printf("Version:     %s\n", meta["version"])
   126		fmt.Printf("Created:     %s\n", meta["created"])
   127		fmt.Printf("Description: %s\n", meta["description"])
   128		fmt.Printf("Features:    %s\n", meta["features"])
   129		fmt.Printf("Outputs:     %s\n", meta["outputs"])
   130		fmt.Printf("Path:        %s\n", entry.Path)
   131	}
   132	
   133	func cmdRegister(args []string) {
   134		if len(args) < 2 {
   135			fmt.Fprintf(os.Stderr, "usage: mlpipe register <name> <path>\n")
   136			os.Exit(1)
   137		}
   138		name := args[0]
   139		modelPath := args[1]
   140	
   141		absPath, err := filepath.Abs(modelPath)
   142		if err != nil {
   143			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   144			os.Exit(1)
   145		}
   146	
   147		if _, err := os.Stat(filepath.Join(absPath, "model.meta")); err != nil {
   148			fmt.Fprintf(os.Stderr, "error: no model.meta found at %s\n", absPath)
   149			os.Exit(1)
   150		}
   151	
   152		meta, err := loadModelMeta(absPath)
   153		if err != nil {
   154			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   155			os.Exit(1)
   156		}
   157	
   158		entries, err := loadRegistry()
   159		if err != nil {
   160			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   161			os.Exit(1)
   162		}
   163	
   164		if findEntry(entries, name) != nil {
   165			fmt.Fprintf(os.Stderr, "error: model '%s' already registered\n", name)
   166			os.Exit(1)
   167		}
   168	
   169		modelType := meta["type"]
   170		if modelType == "" {
   171			modelType = "unknown"
   172		}
   173	
   174		entries = append(entries, RegistryEntry{
   175			Name:    name,
   176			Path:    absPath,
   177			Type:    modelType,
   178			Version: 1,
   179			Created: time.Now().Format("2006-01-02"),
   180		})
   181	
   182		if err := saveRegistry(entries); err != nil {
   183			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   184			os.Exit(1)
   185		}
   186		fmt.Printf("Model '%s' registered successfully.\n", name)
   187	}
   188	
   189	func cmdRemove(args []string) {
   190		if len(args) < 1 {
   191			fmt.Fprintf(os.Stderr, "usage: mlpipe remove <name>\n")
   192			os.Exit(1)
   193		}
   194		name := args[0]
   195	
   196		entries, err := loadRegistry()
   197		if err != nil {
   198			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   199			os.Exit(1)
   200		}
   201	
   202		found := false
   203		var newEntries []RegistryEntry
   204		for _, e := range entries {
   205			if e.Name == name {
   206				found = true
   207			} else {
   208				newEntries = append(newEntries, e)
   209			}
   210		}
   211	
   212		if !found {
   213			fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
   214			os.Exit(1)
   215		}
   216	
   217		if err := saveRegistry(newEntries); err != nil {
   218			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   219			os.Exit(1)
   220		}
   221		fmt.Printf("Model '%s' removed.\n", name)
   222	}
