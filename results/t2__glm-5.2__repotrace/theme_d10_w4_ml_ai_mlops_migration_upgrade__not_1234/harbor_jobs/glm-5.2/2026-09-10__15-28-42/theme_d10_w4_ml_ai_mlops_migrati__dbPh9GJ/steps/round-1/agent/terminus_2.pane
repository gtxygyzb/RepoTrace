   168			if os.IsNotExist(err) {
   169				fmt.Fprintf(os.Stderr, "error: file not found: %s\n", importPath)
   170			} else {
   171				fmt.Fprintf(os.Stderr, "error: %v\n", err)
   172			}
   173			os.Exit(1)
   174		}
   175	
   176		var model exportModel
   177		if err := json.Unmarshal(data, &model); err != nil {
   178			fmt.Fprintf(os.Stderr, "error: invalid JSON: %v\n", err)
   179			os.Exit(1)
   180		}
