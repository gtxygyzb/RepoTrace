    39			name = "cp-" + time.Now().Format("20060102-150405")
    40		}
    41	
    42		entry, err := resolveModel(model)
    43		if err != nil {
    44			fmt.Fprintf(os.Stderr, "not found\n")
    45			os.Exit(1)
    46		}
    47	
    48		cpDir := filepath.Join(checkpointsDir(entry.Path), name)
    49		if _, err := os.Stat(cpDir); err == nil {
    50			fmt.Fprintf(os.Stderr, "checkpoint already exists\n")
    51			os.Exit(1)
    52		}
    53	
    54		if err := os.MkdirAll(cpDir, 0755); err != nil {
    55			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    56			os.Exit(1)
    57		}
    58	
    59		for _, file := range []string{"weights.bin", "model.meta", "pipeline.cfg"} {
    60			src := filepath.Join(entry.Path, file)
    61			data, err := os.ReadFile(src)
    62			if err != nil {
    63				fmt.Fprintf(os.Stderr, "error: %v\n", err)
    64				os.Exit(1)
    65			}
    66			if err := os.WriteFile(filepath.Join(cpDir, file), data, 0644); err != nil {
