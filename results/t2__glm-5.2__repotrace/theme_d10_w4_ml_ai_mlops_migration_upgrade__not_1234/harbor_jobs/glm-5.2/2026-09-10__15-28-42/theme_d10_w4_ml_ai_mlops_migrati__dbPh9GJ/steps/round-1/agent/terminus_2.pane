   212	func columnMinMax(data [][]float64, col int) (float64, float64) {
   213		minVal := math.Inf(1)
   214		maxVal := math.Inf(-1)
   215		for _, row := range data {
   216			if col < len(row) && !math.IsNaN(row[col]) {
   217				if row[col] < minVal {
   218					minVal = row[col]
   219				}
   220				if row[col] > maxVal {
   221					maxVal = row[col]
   222				}
   223			}
   224		}
   225		return minVal, maxVal
   226	}
