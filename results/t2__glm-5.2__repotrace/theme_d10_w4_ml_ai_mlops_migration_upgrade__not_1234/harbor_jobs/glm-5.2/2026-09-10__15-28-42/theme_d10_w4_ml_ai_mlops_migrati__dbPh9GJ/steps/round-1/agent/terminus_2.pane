    92	func parseFlags(args []string) map[string]string {
    93		flags := make(map[string]string)
    94		for i := 0; i < len(args); i++ {
    95			if strings.HasPrefix(args[i], "--") {
    96				key := strings.TrimPrefix(args[i], "--")
    97				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
    98					flags[key] = args[i+1]
    99					i++
   100				} else {
   101					flags[key] = "true"
   102				}
   103			}
   104		}
   105		return flags
   106	}
