    84	func printUsage() {
    85		usage := `mlpipe - ML Inference Pipeline Manager
    86	
    87	Usage: mlpipe <command> [arguments]
    88	
    89	Commands:
    90	  list                          List all registered models
    91	  info <model>                  Show model details
    92	  register <name> <path>        Register a model from directory
    93	  remove <name>                 Remove a model from registry
    94	  run <model> [options]         Run inference
    95	  stats --input <file>          Input statistics profiling
    96	  diff <model1> <model2> --input <file>
    97	                                Compare two models on same input
    98	  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
    99	                                Batch inference over CSV files
   100	  validate <model>              Validate model integrity
   101	  validate-input <model> --input <file>
   102	                                Validate input data for a model
   103	  schema <model>                Display expected input schema for a model
   104	  export <model> --output <file> Export model to JSON file
   105	  import <path> [--name <name>] Import model from JSON file
   106	  clone <model> <new_name>      Clone model to new name
   107	  benchmark <model> --input <file> [--runs <N>]
   108	                                Benchmark inference performance
   109	  prune <model> --threshold <value> [--dry-run]
   110	                                Prune near-zero weights
   111	  profile <model>               Report model weight analysis
   112	  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
   113	  compat [--all]                 Check migration compatibility
   114	  version                       Show version
   115	  help                          Show this help
   116	
   117	Run/Diff Options:
   118	  --input <file>    Input CSV file (required)
   119	  --output <file>   Output file (default: stdout)
   120	  --format <fmt>    Output format: csv or json (default: csv)
   121	  --strict          Validate input before inference and abort on invalid rows
   122	
   123	Batch Options:
   124	  --dir <dir>       Input directory of CSV files
   125	  --output-dir <dir> Output directory for predictions
   126	  --format <fmt>    Output format: csv or json (default: csv)
   127	`
   128		fmt.Print(usage)
   129	}
   130	
   131	func parseFlags(args []string) map[string]string {
   132		flags := make(map[string]string)
   133		for i := 0; i < len(args); i++ {
   134			if strings.HasPrefix(args[i], "--") {
   135				key := strings.TrimPrefix(args[i], "--")
   136				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
   137					flags[key] = args[i+1]
   138					i++
   139				} else {
   140					flags[key] = "true"
   141				}
   142			}
   143		}
   144		return flags
   145	}
