    88	
    89	func cmdExport(args []string) {
    90		if len(args) < 1 {
    91			fmt.Fprintf(os.Stderr, "usage: mlpipe export <model> --output <dir>\n")
    92			os.Exit(1)
    93		}
    94		name := args[0]
    95		flags := parseFlags(args[1:])
    96	
    97		outputDir := flags["output"]
    98		if outputDir == "" {
    99			fmt.Fprintf(os.Stderr, "error: --output is required\n")
   100			os.Exit(1)
   101		}
   102	
   103		entries, err := loadRegistry()
   104		if err != nil {
   105			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   106			os.Exit(1)
   107		}
   108	
   109		entry := findEntry(entries, name)
   110		if entry == nil {
   111			fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
   112			os.Exit(1)
   113		}
   114	
   115		if err := os.MkdirAll(outputDir, 0755); err != nil {
   116			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   117			os.Exit(1)
   118		}
   119	
   120		files := []string{"model.meta", "weights.bin", "pipeline.cfg"}
   121		for _, file := range files {
   122			src := filepath.Join(entry.Path, file)
   123			dst := filepath.Join(outputDir, file)
   124			data, err := os.ReadFile(src)
   125			if err != nil {
