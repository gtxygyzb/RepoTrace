   153	fmt.Fprintf(os.Stderr, "error: --input is required\n")
   154	os.Exit(1)
   155	}
   156	
   157	outputFormat := flags["format"]
   158	if outputFormat == "" || outputFormat == "true" {
   159	outputFormat = "csv"
   160	}
   161	if outputFormat != "csv" && outputFormat != "json" {
   162	fmt.Fprintf(os.Stderr, "error: unsupported format '%s', use 'csv' or 'json'\n", outputFormat)
   163	os.Exit(1)
   164	}
   165	
   166	cfg, err := loadEnsembleConfig(name)
   167	if err != nil {
   168	fmt.Println("ensemble not found")
   169	os.Exit(1)
   170	}
   171	
   172	inputs, err := readInputCSV(inputFile)
   173	if err != nil {
   174	fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
   175	os.Exit(1)
   176	}
   177	
   178	entries, err := loadRegistry()
   179	if err != nil {
   180	fmt.Fprintf(os.Stderr, "error: %v\n", err)
   181	os.Exit(1)
   182	}
   183	
   184	var allOutputs [][][]float64
   185	var featureCount int
   186	for i, modelName := range cfg.Models {
   187	entry := findEntry(entries, modelName)
   188	if entry == nil {
   189	fmt.Printf("model not found: %s\n", modelName)
   190	os.Exit(1)
   191	}
   192	
   193	weights, err := loadWeights(entry.Path)
   194	if err != nil {
   195	fmt.Fprintf(os.Stderr, "error loading weights for model '%s': %v\n", modelName, err)
   196	os.Exit(1)
   197	}
   198	
   199	if i == 0 {
   200	featureCount = int(weights.NumFeatures)
   201	} else if int(weights.NumFeatures) != featureCount {
   202	fmt.Println("feature mismatch")
   203	os.Exit(1)
   204	}
   205	
   206	if err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {
   207	fmt.Println("feature mismatch")
   208	os.Exit(1)
   209	}
   210	
   211	pipelineCfg, err := loadPipelineConfig(entry.Path)
   212	if err != nil {
   213	fmt.Fprintf(os.Stderr, "error loading pipeline config for model '%s': %v\n", modelName, err)
   214	os.Exit(1)
   215	}
   216	
   217	results := runInference(inputs, weights, pipelineCfg)
   218	allOutputs = append(allOutputs, results)
   219	}
   220	
   221	if len(allOutputs) == 0 {
   222	fmt.Fprintf(os.Stderr, "error: ensemble '%s' has no models\n", name)
   223	os.Exit(1)
   224	}
   225	
   226	combined := combineEnsembleOutputs(allOutputs, cfg.Strategy)
   227	
   228	outputFile := flags["output"]
   229	if outputFile != "" && outputFile != "true" {
   230	f, err := os.Create(outputFile)
   231	if err != nil {
   232	fmt.Fprintf(os.Stderr, "error creating output file: %v\n", err)
   233	os.Exit(1)
   234	}
   235	defer f.Close()
   236	writeOutput(f, combined, outputFormat)
   237	} else {
   238	writeOutput(os.Stdout, combined, outputFormat)
   239	}
   240	}
