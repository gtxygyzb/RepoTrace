    49	func cmdEnsembleCreate(args []string) {
    50	flags := parseFlags(args)
    51	
    52	if len(args) < 1 || strings.HasPrefix(args[0], "--") {
    53	fmt.Fprintf(os.Stderr, "usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>] [--weights <w1,w2,...>]\n")
    54	os.Exit(1)
    55	}
    56	name := args[0]
    57	
    58	modelsStr := flags["models"]
    59	if modelsStr == "" || modelsStr == "true" {
    60	fmt.Fprintf(os.Stderr, "usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>] [--weights <w1,w2,...>]\n")
    61	os.Exit(1)
    62	}
    63	
    64	strategy := flags["strategy"]
    65	if strategy == "" || strategy == "true" {
    66	strategy = "average"
    67	}
    68	if strategy != "average" && strategy != "max" && strategy != "min" {
    69	fmt.Fprintf(os.Stderr, "error: invalid strategy '%s', use average, max, or min\n", strategy)
    70	os.Exit(1)
    71	}
    72	
    73	var models []string
    74	for _, m := range strings.Split(modelsStr, ",") {
    75	m = strings.TrimSpace(m)
