		cmdExport(args)
	case "import":
		cmdImport(args)
	case "clone":
		cmdClone(args)
	case "checkpoint":
		cmdCheckpoint(args)
	case "checkpoints":
		cmdCheckpoints(args)
	case "rollback":
		cmdRollback(args)
	case "migrate":
		cmdMigrate(args)
	case "compat":
		cmdCompat(args)
	case "version":
		fmt.Printf("mlpipe version %s\n", version)
	case "help":
		printUsage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
		printUsage()
		os.Exit(1)
	}
}

func printUsage() {
	usage := `mlpipe - ML Inference Pipeline Manager

Usage: mlpipe <command> [arguments]

Commands:
  list                          List all registered models
  info <model>                  Show model details
  register <name> <path>        Register a model from directory
  remove <name>                 Remove a model from registry
  run <model> [options]         Run inference
  stats --input <file>          Input statistics profiling
  diff <model1> <model2> --input <file>
                                Compare two models on same input
  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
                                Batch inference over CSV files
  validate <model>              Validate model integrity
  export <model> --output <file> Export model to JSON file
  import <path> [--name <name>] Import model from JSON file
  clone <model> <new_name>      Clone model to new name
    profile <model>               Report model weight analysis
  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
  compat [--all]                 Check migration compatibility
  version                       Show version
  help                          Show this help

Run/Diff Options:
  --input <file>    Input CSV file (required)
  --output <file>   Output file (default: stdout)
  --format <fmt>    Output format: csv or json (default: csv)

Batch Options:
  --dir <dir>       Input directory of CSV files
  --output-dir <dir> Output directory for predictions
  --format <fmt>    Output format: csv or json (default: csv)
`
	fmt.Print(usage)
}

func parseFlags(args []string) map[string]string {
	flags := make(map[string]string)
	for i := 0; i < len(args); i++ {
		if strings.HasPrefix(args[i], "--") {
			key := strings.TrimPrefix(args[i], "--")
			if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
				flags[key] = args[i+1]
				i++
			} else {
				flags[key] = "true"
			}
		}
	}
	return flags
}
[?2004hroot@n30009:/app# sed -n '1,260p' ensemble.go
[?2004lpackage main

import (
"encoding/json"
"fmt"
"os"
"path/filepath"
"sort"
"strings"
)

const ensemblesDir = "/app/models/ensembles"

type ensembleConfig struct {
Name     string   `json:"name"`
Models   []string `json:"models"`
Strategy string   `json:"strategy"`
}

func cmdEnsemble(args []string) {
if len(args) < 1 {
fmt.Fprintf(os.Stderr, "usage: mlpipe ensemble <create|list|run|remove> [arguments]\n")
os.Exit(1)
}

sub := args[0]
rest := args[1:]
switch sub {
case "create":
cmdEnsembleCreate(rest)
case "list":
cmdEnsembleList(rest)
case "run":
cmdEnsembleRun(rest)
case "remove":
cmdEnsembleRemove(rest)
default:
fmt.Fprintf(os.Stderr, "unknown ensemble command: %s\n", sub)
os.Exit(1)
}
}

func cmdEnsembleCreate(args []string) {
flags := parseFlags(args)

if len(args) < 1 || strings.HasPrefix(args[0], "--") {
fmt.Fprintf(os.Stderr, "usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]\n")
os.Exit(1)
}
name := args[0]

modelsStr := flags["models"]
if modelsStr == "" || modelsStr == "true" {
fmt.Fprintf(os.Stderr, "usage: mlpipe ensemble create <name> --models <m1,m2,...> [--strategy <strategy>]\n")
os.Exit(1)
}

strategy := flags["strategy"]
if strategy == "" || strategy == "true" {
strategy = "average"
}
if strategy != "average" && strategy != "max" && strategy != "min" {
fmt.Fprintf(os.Stderr, "error: invalid strategy '%s', use average, max, or min\n", strategy)
os.Exit(1)
}

var models []string
for _, m := range strings.Split(modelsStr, ",") {
m = strings.TrimSpace(m)
if m != "" {
models = append(models, m)
}
}
if len(models) == 0 {
fmt.Fprintf(os.Stderr, "error: at least one model is required\n")
os.Exit(1)
}

entries, err := loadRegistry()
if err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}

for _, m := range models {
if findEntry(entries, m) == nil {
fmt.Printf("model not found: %s\n", m)
os.Exit(1)
}
}

var outputDim int
for i, m := range models {
entry := findEntry(entries, m)
weights, err := loadWeights(entry.Path)
if err != nil {
fmt.Fprintf(os.Stderr, "error loading weights for model '%s': %v\n", m, err)
os.Exit(1)
}
if i == 0 {
outputDim = int(weights.NumOutputs)
} else if int(weights.NumOutputs) != outputDim {
fmt.Println("output dimension mismatch")
os.Exit(1)
}
}

path := filepath.Join(ensemblesDir, name+".json")
if _, err := os.Stat(path); err == nil {
fmt.Println("ensemble already exists")
os.Exit(1)
}

cfg := ensembleConfig{
Name:     name,
Models:   models,
Strategy: strategy,
}
if err := saveEnsembleConfig(&cfg); err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}

fmt.Printf("ensemble '%s' created with %d models (strategy=%s)\n", name, len(models), strategy)
}

func cmdEnsembleList(args []string) {
configs, err := listEnsembleConfigs()
if err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}
if len(configs) == 0 {
fmt.Println("no ensembles")
return
}
sort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })
for _, cfg := range configs {
fmt.Printf("%s  %s  %d models\n", cfg.Name, cfg.Strategy, len(cfg.Models))
}
}

func cmdEnsembleRun(args []string) {
if len(args) < 1 {
fmt.Fprintf(os.Stderr, "usage: mlpipe ensemble run <name> --input <file> [--format csv|json]\n")
os.Exit(1)
}
name := args[0]
flags := parseFlags(args[1:])

inputFile := flags["input"]
if inputFile == "" || inputFile == "true" {
fmt.Fprintf(os.Stderr, "error: --input is required\n")
os.Exit(1)
}

outputFormat := flags["format"]
if outputFormat == "" || outputFormat == "true" {
outputFormat = "csv"
}
if outputFormat != "csv" && outputFormat != "json" {
fmt.Fprintf(os.Stderr, "error: unsupported format '%s', use 'csv' or 'json'\n", outputFormat)
os.Exit(1)
}

cfg, err := loadEnsembleConfig(name)
if err != nil {
fmt.Println("ensemble not found")
os.Exit(1)
}

inputs, err := readInputCSV(inputFile)
if err != nil {
fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
os.Exit(1)
}

entries, err := loadRegistry()
if err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}

var allOutputs [][][]float64
var featureCount int
for i, modelName := range cfg.Models {
entry := findEntry(entries, modelName)
if entry == nil {
fmt.Printf("model not found: %s\n", modelName)
os.Exit(1)
}

weights, err := loadWeights(entry.Path)
if err != nil {
fmt.Fprintf(os.Stderr, "error loading weights for model '%s': %v\n", modelName, err)
os.Exit(1)
}

if i == 0 {
featureCount = int(weights.NumFeatures)
} else if int(weights.NumFeatures) != featureCount {
fmt.Println("feature mismatch")
os.Exit(1)
}

if err := validateFeatureCount(inputs, int(weights.NumFeatures)); err != nil {
fmt.Println("feature mismatch")
os.Exit(1)
}

pipelineCfg, err := loadPipelineConfig(entry.Path)
if err != nil {
fmt.Fprintf(os.Stderr, "error loading pipeline config for model '%s': %v\n", modelName, err)
os.Exit(1)
}

results := runInference(inputs, weights, pipelineCfg)
allOutputs = append(allOutputs, results)
}

if len(allOutputs) == 0 {
fmt.Fprintf(os.Stderr, "error: ensemble '%s' has no models\n", name)
os.Exit(1)
}

combined := combineEnsembleOutputs(allOutputs, cfg.Strategy)

outputFile := flags["output"]
if outputFile != "" && outputFile != "true" {
f, err := os.Create(outputFile)
if err != nil {
fmt.Fprintf(os.Stderr, "error creating output file: %v\n", err)
os.Exit(1)
}
defer f.Close()
writeOutput(f, combined, outputFormat)
} else {
writeOutput(os.Stdout, combined, outputFormat)
}
}

func cmdEnsembleRemove(args []string) {
if len(args) < 1 {
fmt.Fprintf(os.Stderr, "usage: mlpipe ensemble remove <name>\n")
os.Exit(1)
}
name := args[0]

path := filepath.Join(ensemblesDir, name+".json")
if _, err := os.Stat(path); err != nil {
fmt.Println("ensemble not found")
os.Exit(1)
}
if err := os.Remove(path); err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}
fmt.Printf("ensemble '%s' removed\n", name)
}

