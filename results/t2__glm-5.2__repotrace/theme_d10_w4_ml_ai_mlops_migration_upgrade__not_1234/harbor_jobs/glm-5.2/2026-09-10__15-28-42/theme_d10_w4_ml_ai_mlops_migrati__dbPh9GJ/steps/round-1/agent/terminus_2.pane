    34	func cmdExport(args []string) {
    35		if len(args) < 1 {
    36			fmt.Fprintf(os.Stderr, "usage: mlpipe export <model> --output <file>\n")
    37			os.Exit(1)
    38		}
    39		name := args[0]
    40		flags := parseFlags(args[1:])
    41	
    42		outputPath := flags["output"]
    43		if outputPath == "" {
    44			fmt.Fprintf(os.Stderr, "error: --output is required\n")
    45			os.Exit(1)
    46		}
    47		if !strings.HasSuffix(outputPath, ".json") {
    48			outputPath += ".json"
    49		}
    50	
    51		entry, err := resolveModel(name)
    52		if err != nil {
    53			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    54			os.Exit(1)
    55		}
    56	
    57		meta, err := loadModelMeta(entry.Path)
    58		if err != nil {
    59			fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
    60			os.Exit(1)
    61		}
    62	
    63		weights, err := loadWeights(entry.Path)
    64		if err != nil {
    65			fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
    66			os.Exit(1)
    67		}
    68	
    69		cfg, err := loadPipelineConfig(entry.Path)
    70		if err != nil {
    71			fmt.Fprintf(os.Stderr, "error loading pipeline config: %v\n", err)
    72			os.Exit(1)
    73		}
    74	
    75		modelName := meta["name"]
    76		if modelName == "" {
    77			modelName = entry.Name
    78		}
    79		modelType := meta["type"]
    80		if modelType == "" {
    81			modelType = "unknown"
    82		}
    83		modelVersion := 1
    84		if v, err := strconv.Atoi(meta["version"]); err == nil {
    85			modelVersion = v
    86		}
    87	
    88		activation := "none"
    89		if weights.Version == 2 {
    90			activation = activationIDToName(weights.Activation)
    91		}
    92	
    93		if int(weights.NumFeatures) <= 0 || int(weights.NumOutputs) <= 0 {
    94			fmt.Fprintf(os.Stderr, "error: invalid model dimensions\n")
    95			os.Exit(1)
    96		}
    97		if len(weights.Weights) != int(weights.NumFeatures)*int(weights.NumOutputs) {
    98			fmt.Fprintf(os.Stderr, "error: corrupt weights matrix\n")
    99			os.Exit(1)
   100		}
   101		if len(weights.Bias) != int(weights.NumOutputs) {
   102			fmt.Fprintf(os.Stderr, "error: corrupt bias vector\n")
   103			os.Exit(1)
   104		}
   105	
   106		weightMatrix := make([][]float64, weights.NumOutputs)
   107		for o := uint32(0); o < weights.NumOutputs; o++ {
   108			start := o * weights.NumFeatures
   109			end := start + weights.NumFeatures
   110			row := make([]float64, weights.NumFeatures)
   111			copy(row, weights.Weights[start:end])
   112			weightMatrix[o] = row
   113		}
   114	
   115		export := exportModel{
   116			Name:          modelName,
   117			Type:          modelType,
   118			Version:       modelVersion,
   119			FormatVersion: int(weights.Version),
   120			Features:      int(weights.NumFeatures),
   121			Outputs:       int(weights.NumOutputs),
   122			Activation:    activation,
   123			Weights:       weightMatrix,
   124			Bias:          weights.Bias,
   125			Pipeline: exportPipeline{
   126				Normalize:       cfg.Normalize,
   127				ScaleRange:      []float64{cfg.ScaleMin, cfg.ScaleMax},
   128				MissingStrategy: cfg.MissingStrategy,
   129				RoundDigits:     cfg.RoundDigits,
   130				ClipRange:       []float64{cfg.ClipMin, cfg.ClipMax},
   131			},
   132		}
   133	
   134		data, err := json.MarshalIndent(export, "", "  ")
   135		if err != nil {
   136			fmt.Fprintf(os.Stderr, "error encoding JSON: %v\n", err)
   137			os.Exit(1)
   138		}
   139		data = append(data, '\n')
   140	
   141		if dir := filepath.Dir(outputPath); dir != "" && dir != "." {
   142			if err := os.MkdirAll(dir, 0755); err != nil {
   143				fmt.Fprintf(os.Stderr, "error creating output directory: %v\n", err)
   144				os.Exit(1)
   145			}
   146		}
   147		if err := os.WriteFile(outputPath, data, 0644); err != nil {
   148			fmt.Fprintf(os.Stderr, "error writing export file: %v\n", err)
   149			os.Exit(1)
   150		}
   151		fmt.Printf("Model '%s' exported to %s\n", name, outputPath)
   152	}
