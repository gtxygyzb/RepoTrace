    35		case "batch":
    36			cmdBatch(args)
    37		case "validate":
    38			cmdValidate(args)
    39		case "export":
    40			cmdExport(args)
    41		case "import":
    42			cmdImport(args)
    43		case "clone":
    44			cmdClone(args)
    45		case "migrate":
    46			cmdMigrate(args)
    47		case "compat":
    48			cmdCompat(args)
    49		case "version":
    50			fmt.Printf("mlpipe version %s\n", version)
    51		case "help":
    52			printUsage()
    53		default:
    54			fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
    55			printUsage()
    56			os.Exit(1)
    57		}
    58	}
    59	
    60	func printUsage() {
    61		usage := `mlpipe - ML Inference Pipeline Manager
    62	
    63	Usage: mlpipe <command> [arguments]
    64	
    65	Commands:
    66	  list                          List all registered models
    67	  info <model>                  Show model details
    68	  register <name> <path>        Register a model from directory
    69	  remove <name>                 Remove a model from registry
    70	  run <model> [options]         Run inference
    71	  stats --input <file>          Input statistics profiling
    72	  diff <model1> <model2> --input <file>
    73	                                Compare two models on same input
    74	  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
    75	                                Batch inference over CSV files
    76	  validate <model>              Validate model integrity
    77	  export <model> --output <file> Export model to JSON file
    78	  import <path> [--name <name>] Import model from JSON file
    79	  clone <model> <new_name>      Clone model to new name
    80	  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
    81	  compat [--all]                 Check migration compatibility
    82	  version                       Show version
    83	  help                          Show this help
    84	
    85	Run/Diff Options:
    86	  --input <file>    Input CSV file (required)
    87	  --output <file>   Output file (default: stdout)
    88	  --format <fmt>    Output format: csv or json (default: csv)
    89	
    90	Batch Options:
    91	  --dir <dir>       Input directory of CSV files
    92	  --output-dir <dir> Output directory for predictions
    93	  --format <fmt>    Output format: csv or json (default: csv)
    94	`
    95		fmt.Print(usage)
    96	}
    97	
    98	func parseFlags(args []string) map[string]string {
    99		flags := make(map[string]string)
   100		for i := 0; i < len(args); i++ {
   101			if strings.HasPrefix(args[i], "--") {
   102				key := strings.TrimPrefix(args[i], "--")
   103				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
   104					flags[key] = args[i+1]
   105					i++
   106				} else {
   107					flags[key] = "true"
   108				}
   109			}
   110		}
   111		return flags
   112	}
