		if elapsed > 0 {
			throughput = float64(rows*runs) / elapsed.Seconds()
		}
	}

	fmt.Printf("Benchmark: %s (%d runs, %d rows per run)\n", model, runs, rows)
	fmt.Printf("Total time:    %.3fms\n", totalMs)
	fmt.Printf("Avg per run:   %.3fms\n", avgRunMs)
	fmt.Printf("Avg per row:   %.3fus\n", avgRowUs)
	fmt.Printf("Throughput:    %.3f rows/sec\n", throughput)
}

func cmdPrune(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe prune <model> --threshold <value> [--dry-run]\n")
		os.Exit(1)
	}

	model := args[0]
	flags := parseFlags(args[1:])

	thresholdStr := flags["threshold"]
	if thresholdStr == "" || thresholdStr == "true" {
		fmt.Fprintf(os.Stderr, "error: --threshold is required\n")
		os.Exit(1)
	}

	threshold, err := strconv.ParseFloat(thresholdStr, 64)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: invalid threshold\n")
		os.Exit(1)
	}
	if threshold <= 0 {
		fmt.Fprintf(os.Stderr, "threshold must be positive\n")
		os.Exit(1)
	}

	dryRun := flags["dry-run"] == "true"

	entry, err := resolveModel(model)
	if err != nil {
		fmt.Fprintf(os.Stderr, "not found\n")
		os.Exit(1)
	}

	weights, err := loadWeights(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
		os.Exit(1)
	}

	total := len(weights.Weights)
	pruned := 0
	for i, v := range weights.Weights {
		if math.Abs(v) < threshold {
			pruned++
			weights.Weights[i] = 0.0
		}
	}

	zeroCount := 0
	for _, v := range weights.Weights {
		if v == 0.0 {
			zeroCount++
		}
	}

	prunedPct := 0.0
	sparsity := 0.0
	if total > 0 {
		prunedPct = float64(pruned) / float64(total) * 100.0
		sparsity = float64(zeroCount) / float64(total) * 100.0
	}

	fmt.Printf("Pruning '%s' (threshold=%s)\n", model, thresholdStr)
	fmt.Printf("Total weights:  %d\n", total)
	fmt.Printf("Pruned:         %d (%.1f%%)\n", pruned, prunedPct)
	fmt.Printf("New sparsity:   %.1f%%\n", sparsity)

	if dryRun {
		fmt.Println("(dry run - no changes made)")
		return
	}

	cpDir := filepath.Join(checkpointsDir(entry.Path), "pre-prune")
	if err := os.MkdirAll(cpDir, 0755); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	for _, file := range []string{"weights.bin", "model.meta", "pipeline.cfg"} {
		data, err := os.ReadFile(filepath.Join(entry.Path, file))
		if err != nil {
			fmt.Fprintf(os.Stderr, "error: %v\n", err)
			os.Exit(1)
		}
		if err := os.WriteFile(filepath.Join(cpDir, file), data, 0644); err != nil {
			fmt.Fprintf(os.Stderr, "error: %v\n", err)
			os.Exit(1)
