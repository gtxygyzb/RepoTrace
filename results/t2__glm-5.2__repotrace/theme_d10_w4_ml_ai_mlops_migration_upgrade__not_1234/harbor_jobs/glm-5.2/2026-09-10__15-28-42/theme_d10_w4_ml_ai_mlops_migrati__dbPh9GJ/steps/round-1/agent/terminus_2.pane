    12	const registryFile = "/app/models/registry.idx"
    13	
    14	type RegistryEntry struct {
    15		Name    string
    16		Path    string
    17		Type    string
    18		Version int
    19		Created string
    20	}
    21	
    22	func loadRegistry() ([]RegistryEntry, error) {
    23		f, err := os.Open(registryFile)
    24		if err != nil {
    25			if os.IsNotExist(err) {
    26				return nil, nil
    27			}
    28			return nil, err
    29		}
    30		defer f.Close()
    31	
    32		var entries []RegistryEntry
    33		scanner := bufio.NewScanner(f)
    34		for scanner.Scan() {
    35			line := strings.TrimSpace(scanner.Text())
    36			if line == "" || strings.HasPrefix(line, "#") {
    37				continue
    38			}
    39			parts := strings.Split(line, "|")
    40			if len(parts) != 5 {
    41				continue
    42			}
    43			ver := 1
    44			fmt.Sscanf(parts[3], "%d", &ver)
    45			entries = append(entries, RegistryEntry{
    46				Name:    parts[0],
    47				Path:    parts[1],
    48				Type:    parts[2],
    49				Version: ver,
    50				Created: parts[4],
    51			})
    52		}
    53		return entries, scanner.Err()
    54	}
    55	
    56	func saveRegistry(entries []RegistryEntry) error {
    57		dir := filepath.Dir(registryFile)
    58		if err := os.MkdirAll(dir, 0755); err != nil {
    59			return err
    60		}
    61	
    62		f, err := os.Create(registryFile)
    63		if err != nil {
    64			return err
    65		}
    66		defer f.Close()
    67	
    68		fmt.Fprintln(f, "# mlpipe registry v1")
    69		for _, e := range entries {
    70			fmt.Fprintf(f, "%s|%s|%s|%d|%s\n", e.Name, e.Path, e.Type, e.Version, e.Created)
    71		}
    72		return nil
    73	}
    74	
    75	func findEntry(entries []RegistryEntry, name string) *RegistryEntry {
    76		for i := range entries {
    77			if entries[i].Name == name {
    78				return &entries[i]
    79			}
    80		}
    81		return nil
    82	}
    83	
    84	func cmdList(args []string) {
    85		entries, err := loadRegistry()
    86		if err != nil {
    87			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    88			os.Exit(1)
    89		}
    90		if len(entries) == 0 {
    91			fmt.Println("No models registered.")
    92			return
    93		}
    94		fmt.Printf("%-20s %-10s %-8s %s\n", "NAME", "TYPE", "VERSION", "CREATED")
    95		for _, e := range entries {
    96			fmt.Printf("%-20s %-10s %-8d %s\n", e.Name, e.Type, e.Version, e.Created)
    97		}
    98	}
    99	
   100	func cmdInfo(args []string) {
   101		if len(args) < 1 {
   102			fmt.Fprintf(os.Stderr, "usage: mlpipe info <model>\n")
   103			os.Exit(1)
   104		}
   105		name := args[0]
   106		entries, err := loadRegistry()
   107		if err != nil {
   108			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   109			os.Exit(1)
   110		}
   111		entry := findEntry(entries, name)
   112		if entry == nil {
   113			fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
   114			os.Exit(1)
   115		}
   116	
   117		meta, err := loadModelMeta(entry.Path)
   118		if err != nil {
   119			fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
   120			os.Exit(1)
   121		}
   122	
   123		fmt.Printf("Name:        %s\n", meta["name"])
   124		fmt.Printf("Type:        %s\n", meta["type"])
   125		fmt.Printf("Version:     %s\n", meta["version"])
   126		fmt.Printf("Created:     %s\n", meta["created"])
   127		fmt.Printf("Description: %s\n", meta["description"])
   128		fmt.Printf("Features:    %s\n", meta["features"])
   129		fmt.Printf("Outputs:     %s\n", meta["outputs"])
   130		fmt.Printf("Path:        %s\n", entry.Path)
   131	}
   132	
   133	func cmdRegister(args []string) {
   134		if len(args) < 2 {
   135			fmt.Fprintf(os.Stderr, "usage: mlpipe register <name> <path>\n")
   136			os.Exit(1)
   137		}
   138		name := args[0]
   139		modelPath := args[1]
   140	
   141		absPath, err := filepath.Abs(modelPath)
   142		if err != nil {
   143			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   144			os.Exit(1)
   145		}
   146	
   147		if _, err := os.Stat(filepath.Join(absPath, "model.meta")); err != nil {
   148			fmt.Fprintf(os.Stderr, "error: no model.meta found at %s\n", absPath)
   149			os.Exit(1)
   150		}
   151	
   152		meta, err := loadModelMeta(absPath)
   153		if err != nil {
   154			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   155			os.Exit(1)
   156		}
   157	
   158		entries, err := loadRegistry()
   159		if err != nil {
   160			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   161			os.Exit(1)
   162		}
   163	
   164		if findEntry(entries, name) != nil {
   165			fmt.Fprintf(os.Stderr, "error: model '%s' already registered\n", name)
   166			os.Exit(1)
   167		}
   168	
   169		modelType := meta["type"]
   170		if modelType == "" {
   171			modelType = "unknown"
   172		}
   173	
   174		entries = append(entries, RegistryEntry{
   175			Name:    name,
   176			Path:    absPath,
   177			Type:    modelType,
   178			Version: 1,
   179			Created: time.Now().Format("2006-01-02"),
   180		})
   181	
   182		if err := saveRegistry(entries); err != nil {
   183			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   184			os.Exit(1)
   185		}
   186		fmt.Printf("Model '%s' registered successfully.\n", name)
   187	}
   188	
   189	func cmdRemove(args []string) {
   190		if len(args) < 1 {
   191			fmt.Fprintf(os.Stderr, "usage: mlpipe remove <name>\n")
   192			os.Exit(1)
   193		}
   194		name := args[0]
   195	
   196		entries, err := loadRegistry()
   197		if err != nil {
   198			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   199			os.Exit(1)
   200		}
   201	
   202		found := false
   203		var newEntries []RegistryEntry
   204		for _, e := range entries {
   205			if e.Name == name {
   206				found = true
   207			} else {
   208				newEntries = append(newEntries, e)
   209			}
   210		}
   211	
   212		if !found {
   213			fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
   214			os.Exit(1)
   215		}
   216	
   217		if err := saveRegistry(newEntries); err != nil {
   218			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   219			os.Exit(1)
   220		}
   221		fmt.Printf("Model '%s' removed.\n", name)
   222	}
