   165			if err := os.WriteFile(filepath.Join(entry.Path, cpEntry.Name()), data, 0644); err != nil {
   166				fmt.Fprintf(os.Stderr, "error: %v\n", err)
   167				os.Exit(1)
   168			}
   169		}
   170	
   171		fmt.Printf("rolled back '%s' to checkpoint '%s'\n", model, name)
   172	}
