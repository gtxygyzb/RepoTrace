	}

	var hasher hash.Hash32
	r := f
	if ver == 3 {
		hasher = crc32.NewIEEE()
		if _, err := hasher.Write(magic); err != nil {
			return nil, fmt.Errorf("failed to compute checksum: %v", err)
		}
		if err := binary.Write(hasher, binary.LittleEndian, ver); err != nil {
			return nil, fmt.Errorf("failed to compute checksum: %v", err)
		}
		r = io.TeeReader(f, hasher)
	}

	if err := binary.Read(r, binary.LittleEndian, &nf); err != nil {
		return nil, fmt.Errorf("failed to read num_features: %v", err)
	}
	if err := binary.Read(r, binary.LittleEndian, &no); err != nil {
		return nil, fmt.Errorf("failed to read num_outputs: %v", err)
	}

	var act uint32
	switch ver {
	case 1:
		act = 0
	case 2, 3:
		if err := binary.Read(r, binary.LittleEndian, &act); err != nil {
			return nil, fmt.Errorf("failed to read activation: %v", err)
		}
	default:
		return nil, fmt.Errorf("unsupported model format version: %d", ver)
	}

	weights := make([]float64, nf*no)
	for i := range weights {
		if err := binary.Read(r, binary.LittleEndian, &weights[i]); err != nil {
			return nil, fmt.Errorf("failed to read weight[%d]: %v", i, err)
		}
	}

	bias := make([]float64, no)
	for i := range bias {
		if err := binary.Read(r, binary.LittleEndian, &bias[i]); err != nil {
			return nil, fmt.Errorf("failed to read bias[%d]: %v", i, err)
		}
	}

	if ver == 3 {
		var checksum uint32
		if err := binary.Read(f, binary.LittleEndian, &checksum); err != nil {
			return nil, fmt.Errorf("failed to read checksum: %v", err)
		}
		if hasher.Sum32() != checksum {
			return nil, fmt.Errorf("checksum mismatch")
		}
	}

	return &WeightsData{
		Version:     ver,
		NumFeatures: nf,
		NumOutputs:  no,
		Activation:  act,
		Weights:     weights,
		Bias:        bias,
	}, nil
}'''

s = re.sub(r'func loadWeights\(modelDir string\) \(\*WeightsData, error\) \{.*?\n\}\n\nfunc writeWeights', new_load + '\n\nfunc writeWeights', s, count=1, flags=re.S)

new_write = '''func writeWeights(path string, w *WeightsData) error {
	f, err := os.Create(path)
	if err != nil {
		return err
	}
	defer f.Close()

	hasher := crc32.NewIEEE()
	mw := io.MultiWriter(f, hasher)

	if _, err := mw.Write(modelMagic); err != nil {
		return err
	}
	if err := binary.Write(mw, binary.LittleEndian, w.Version); err != nil {
		return err
	}
	if err := binary.Write(mw, binary.LittleEndian, w.NumFeatures); err != nil {
		return err
	}
	if err := binary.Write(mw, binary.LittleEndian, w.NumOutputs); err != nil {
		return err
	}
	if w.Version >= 2 {
		if err := binary.Write(mw, binary.LittleEndian, w.Activation); err != nil {
			return err
		}
	}
	for _, v := range w.Weights {
		if err := binary.Write(mw, binary.LittleEndian, v); err != nil {
			return err
		}
	}
	for _, v := range w.Bias {
		if err := binary.Write(mw, binary.LittleEndian, v); err != nil {
			return err
		}
	}
	if w.Version >= 3 {
		if err := binary.Write(f, binary.LittleEndian, hasher.Sum32()); err != nil {
			return err
		}
	}
	return nil
}'''

