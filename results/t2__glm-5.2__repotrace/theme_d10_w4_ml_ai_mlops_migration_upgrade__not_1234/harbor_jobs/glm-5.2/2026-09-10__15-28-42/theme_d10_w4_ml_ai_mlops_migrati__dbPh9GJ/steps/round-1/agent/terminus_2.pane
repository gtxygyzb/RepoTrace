    28			cmdRemove(args)
    29		case "tag":
    30			cmdTag(args)
    31		case "untag":
    32			cmdUntag(args)
    33		case "search":
    34			cmdSearch(args)
    35		case "run":
    36			cmdRun(args)
    37		case "stats":
    38			cmdStats(args)
    39		case "diff":
    40			cmdDiff(args)
    41		case "batch":
    42			cmdBatch(args)
    43		case "validate":
    44			cmdValidate(args)
    45		case "export":
    46			cmdExport(args)
    47		case "import":
    48			cmdImport(args)
    49		case "clone":
    50			cmdClone(args)
    51		case "migrate":
    52			cmdMigrate(args)
    53		case "compat":
    54			cmdCompat(args)
    55		case "version":
    56			fmt.Printf("mlpipe version %s\n", version)
    57		case "help":
    58			printUsage()
    59		default:
    60			fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
    61			printUsage()
    62			os.Exit(1)
    63		}
    64	}
    65	
    66	func printUsage() {
    67		usage := `mlpipe - ML Inference Pipeline Manager
    68	
    69	Usage: mlpipe <command> [arguments]
    70	
    71	Commands:
    72	  list                          List all registered models
    73	  info <model>                  Show model details
    74	  register <name> <path>        Register a model from directory
    75	  remove <name>                 Remove a model from registry
    76	  run <model> [options]         Run inference
    77	  stats --input <file>          Input statistics profiling
    78	  diff <model1> <model2> --input <file>
    79	                                Compare two models on same input
    80	  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
    81	                                Batch inference over CSV files
    82	  validate <model>              Validate model integrity
    83	  export <model> --output <file> Export model to JSON file
    84	  import <path> [--name <name>] Import model from JSON file
    85	  clone <model> <new_name>      Clone model to new name
    86	  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
    87	  compat [--all]                 Check migration compatibility
    88	  version                       Show version
    89	  help                          Show this help
    90	
    91	Run/Diff Options:
    92	  --input <file>    Input CSV file (required)
    93	  --output <file>   Output file (default: stdout)
    94	  --format <fmt>    Output format: csv or json (default: csv)
    95	
    96	Batch Options:
    97	  --dir <dir>       Input directory of CSV files
    98	  --output-dir <dir> Output directory for predictions
    99	  --format <fmt>    Output format: csv or json (default: csv)
   100	`
   101		fmt.Print(usage)
   102	}
   103	
   104	func parseFlags(args []string) map[string]string {
   105		flags := make(map[string]string)
   106		for i := 0; i < len(args); i++ {
   107			if strings.HasPrefix(args[i], "--") {
   108				key := strings.TrimPrefix(args[i], "--")
   109				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
   110					flags[key] = args[i+1]
   111					i++
   112				} else {
   113					flags[key] = "true"
   114				}
   115			}
   116		}
   117		return flags
   118	}
