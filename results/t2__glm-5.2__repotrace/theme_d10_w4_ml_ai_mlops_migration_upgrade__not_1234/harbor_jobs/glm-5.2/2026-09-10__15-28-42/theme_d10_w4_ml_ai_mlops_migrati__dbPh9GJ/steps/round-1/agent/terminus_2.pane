func modelDirExists(path string) bool {
	info, err := os.Stat(path)
	return err == nil && info.IsDir()
}

func resolveModel(name string) (*RegistryEntry, error) {
	entries, err := loadRegistry()
	if err != nil {
		return nil, err
	}
	entry := findEntry(entries, name)
	if entry == nil || !modelDirExists(entry.Path) {
		fmt.Fprintln(os.Stderr, "not found")
		os.Exit(1)
	}
	return entry, nil
}

func loadModelArtifacts(modelDir string) (*WeightsData, *PipelineConfig, error) {
	weights, err := loadWeights(modelDir)
	if err != nil {
		return nil, nil, err
	}
	cfg, err := loadPipelineConfig(modelDir)
	if err != nil {
		return nil, nil, err
	}
	return weights, cfg, nil
}

func validateFeatureCount(inputs [][]float64, expected int) error {
	for i, row := range inputs {
		if len(row) != expected {
			return fmt.Errorf("expected %d features, got %d in row %d", expected, len(row), i)
		}
	}
	return nil
}

func readCSVRaw(path string) ([][]string, error) {
	f, err := os.Open(path)
	if err != nil {
		return nil, err
	}
	defer f.Close()

	reader := csv.NewReader(f)
	reader.FieldsPerRecord = -1
	return reader.ReadAll()
}

func isMissingValue(val string) bool {
	val = strings.TrimSpace(val)
	if val == "" {
		return true
	}
	lower := strings.ToLower(val)
	return lower == "na" || lower == "nan"
}

func cmdStats(args []string) {
	flags := parseFlags(args)
	input := flags["input"]
	if input == "" {
		fmt.Fprintf(os.Stderr, "usage: mlpipe stats --input <file>\n")
		os.Exit(1)
	}

	records, err := readCSVRaw(input)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
		os.Exit(1)
	}
	if len(records) == 0 {
		fmt.Println("No data found.")
		return
	}

	hasHeader := isHeader(records[0])
	start := 0
	if hasHeader {
		start = 1
	}

	numCols := 0
	for _, rec := range records {
		if len(rec) > numCols {
			numCols = len(rec)
		}
	}

	headers := make([]string, numCols)
	for i := 0; i < numCols; i++ {
		if hasHeader && i < len(records[0]) {
			headers[i] = strings.TrimSpace(records[0][i])
		} else {
			headers[i] = fmt.Sprintf("col_%d", i)
		}
	}

	type colStat struct {
		idx     int
		name    string
		count   int
		missing int
		min     float64
