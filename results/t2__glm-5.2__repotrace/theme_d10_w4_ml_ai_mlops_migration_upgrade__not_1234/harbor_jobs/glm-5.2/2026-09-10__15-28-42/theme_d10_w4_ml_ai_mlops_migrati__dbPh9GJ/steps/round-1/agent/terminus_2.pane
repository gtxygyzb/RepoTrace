    10	
    11	func main() {
    12		if len(os.Args) < 2 {
    13			printUsage()
    14			os.Exit(1)
    15		}
    16	
    17		command := os.Args[1]
    18		args := os.Args[2:]
    19	
    20		switch command {
    21		case "ensemble":
    22			cmdEnsemble(args)
    23		case "list":
    24			cmdList(args)
    25		case "info":
    26			cmdInfo(args)
    27		case "register":
    28			cmdRegister(args)
    29		case "remove":
    30			cmdRemove(args)
    31		case "tag":
    32			cmdTag(args)
    33		case "untag":
    34			cmdUntag(args)
    35		case "search":
    36			cmdSearch(args)
    37		case "run":
    38			cmdRun(args)
    39		case "stats":
    40			cmdStats(args)
    41		case "diff":
    42			cmdDiff(args)
    43		case "batch":
    44			cmdBatch(args)
    45		case "benchmark":
    46			cmdBenchmark(args)
    47		case "prune":
    48			cmdPrune(args)
    49		case "profile":
    50			cmdProfile(args)
    51		case "explain":
    52			cmdExplain(args)
    53		case "validate":
    54			cmdValidate(args)
    55		case "validate-input":
    56			cmdValidateInput(args)
    57		case "schema":
    58			cmdSchema(args)
    59		case "export":
    60			cmdExport(args)
    61		case "import":
    62			cmdImport(args)
    63		case "clone":
    64			cmdClone(args)
    65		case "checkpoint":
    66			cmdCheckpoint(args)
    67		case "checkpoints":
    68			cmdCheckpoints(args)
    69		case "rollback":
    70			cmdRollback(args)
    71		case "migrate":
    72			cmdMigrate(args)
    73		case "compat":
    74			cmdCompat(args)
    75		case "version":
    76			fmt.Printf("mlpipe version %s\n", version)
    77		case "help":
    78			printUsage()
    79		default:
    80			fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
    81			printUsage()
    82			os.Exit(1)
    83		}
    84	}
    85	
    86	func printUsage() {
    87		usage := `mlpipe - ML Inference Pipeline Manager
    88	
    89	Usage: mlpipe <command> [arguments]
    90	
    91	Commands:
    92	  list                          List all registered models
    93	  info <model>                  Show model details
    94	  register <name> <path>        Register a model from directory
    95	  remove <name>                 Remove a model from registry
    96	  run <model> [options]         Run inference
    97	  stats --input <file>          Input statistics profiling
    98	  diff <model1> <model2> --input <file>
    99	                                Compare two models on same input
   100	  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
   101	                                Batch inference over CSV files
   102	  validate <model>              Validate model integrity
   103	  validate-input <model> --input <file>
   104	                                Validate input data for a model
   105	  schema <model>                Display expected input schema for a model
   106	  export <model> --output <file> Export model to JSON file
   107	  import <path> [--name <name>] Import model from JSON file
   108	  clone <model> <new_name>      Clone model to new name
   109	  benchmark <model> --input <file> [--runs <N>]
   110	                                Benchmark inference performance
   111	  prune <model> --threshold <value> [--dry-run]
   112	                                Prune near-zero weights
   113	  profile <model>               Report model weight analysis
   114	  explain <model> --input <file> [--row <N>]
   115	                                  Explain prediction for a row
   116	  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
   117	  compat [--all]                 Check migration compatibility
   118	  version                       Show version
   119	  help                          Show this help
   120	
   121	Run/Diff Options:
   122	  --input <file>    Input CSV file (required)
   123	  --output <file>   Output file (default: stdout)
   124	  --format <fmt>    Output format: csv or json (default: csv)
   125	  --strict          Validate input before inference and abort on invalid rows
   126	
   127	Batch Options:
   128	  --dir <dir>       Input directory of CSV files
   129	  --output-dir <dir> Output directory for predictions
   130	  --format <fmt>    Output format: csv or json (default: csv)
   131	`
   132		fmt.Print(usage)
   133	}
   134	
   135	func parseFlags(args []string) map[string]string {
   136		flags := make(map[string]string)
   137		for i := 0; i < len(args); i++ {
   138			if strings.HasPrefix(args[i], "--") {
   139				key := strings.TrimPrefix(args[i], "--")
   140				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
   141					flags[key] = args[i+1]
   142					i++
   143				} else {
   144					flags[key] = "true"
   145				}
   146			}
   147		}
   148		return flags
   149	}
