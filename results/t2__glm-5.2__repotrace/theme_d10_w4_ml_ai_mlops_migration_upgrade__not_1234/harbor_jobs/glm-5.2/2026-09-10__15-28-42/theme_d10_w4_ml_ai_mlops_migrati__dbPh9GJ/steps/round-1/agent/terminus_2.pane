    82	func readInputCSV(path string) ([][]float64, error) {
    83		f, err := os.Open(path)
    84		if err != nil {
    85			return nil, err
    86		}
    87		defer f.Close()
    88	
    89		reader := csv.NewReader(f)
    90		records, err := reader.ReadAll()
    91		if err != nil {
    92			return nil, err
    93		}
    94	
    95		var data [][]float64
    96		for i, record := range records {
    97			if i == 0 && isHeader(record) {
    98				continue
    99			}
   100			row := make([]float64, len(record))
   101			for j, val := range record {
   102				val = strings.TrimSpace(val)
   103				if val == "" || val == "NA" || val == "nan" {
   104					row[j] = math.NaN()
   105				} else {
   106					row[j], err = strconv.ParseFloat(val, 64)
   107					if err != nil {
   108						return nil, fmt.Errorf("row %d col %d: %v", i, j, err)
   109					}
   110				}
   111			}
   112			data = append(data, row)
   113		}
   114		return data, nil
   115	}
