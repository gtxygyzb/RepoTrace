     8	
     9	func cmdUpgrade(args []string) {
    10		if len(args) < 1 {
    11			fmt.Fprintf(os.Stderr, "usage: mlpipe upgrade <model>\n")
    12			os.Exit(1)
    13		}
    14		name := args[0]
    15		entry, err := resolveModel(name)
    16		if err != nil {
    17			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    18			os.Exit(1)
    19		}
    20	
    21		weightsPath := filepath.Join(entry.Path, "weights.bin")
    22	
    23		weights, err := loadWeights(entry.Path)
    24		if err != nil {
    25			fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
    26			os.Exit(1)
    27		}
    28	
    29		if weights.Version >= 3 {
    30			fmt.Println("already at latest version")
    31			return
    32		}
    33	
    34		backupPath := weightsPath + ".v2bak"
    35		if weights.Version == 1 {
    36			backupPath = weightsPath + ".v1bak"
    37		}
    38	
    39		data, err := os.ReadFile(weightsPath)
    40		if err != nil {
    41			fmt.Fprintf(os.Stderr, "error reading weights: %v\n", err)
    42			os.Exit(1)
    43		}
    44		if err := os.WriteFile(backupPath, data, 0644); err != nil {
    45			fmt.Fprintf(os.Stderr, "error writing backup: %v\n", err)
    46			os.Exit(1)
    47		}
    48	
    49		if weights.Version == 1 {
    50			weights.Activation = activationNone
    51		}
    52		weights.Version = 3
    53	
    54		if err := writeWeights(weightsPath, weights); err != nil {
    55			fmt.Fprintf(os.Stderr, "error writing weights: %v\n", err)
    56			os.Exit(1)
    57		}
    58	
    59		meta, err := loadModelMeta(entry.Path)
    60		if err != nil {
    61			fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
    62			os.Exit(1)
    63		}
    64		meta["format_version"] = "3"
    65		meta["activation"] = activationIDToName(weights.Activation)
    66		if err := saveModelMeta(entry.Path, meta); err != nil {
    67			fmt.Fprintf(os.Stderr, "error updating metadata: %v\n", err)
    68			os.Exit(1)
    69		}
    70	
    71		fmt.Printf("model '%s' upgraded to format v3\n", name)
    72	}
    73	
    74	func cmdVerify(args []string) {
    75		if len(args) < 1 {
    76			fmt.Fprintf(os.Stderr, "usage: mlpipe verify <model>\n")
    77			os.Exit(1)
    78		}
    79		name := args[0]
    80		entry, err := resolveModel(name)
    81		if err != nil {
    82			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    83			os.Exit(1)
    84		}
    85	
    86		if _, err := loadWeights(entry.Path); err != nil {
    87			fmt.Printf("model '%s' integrity: FAILED (%v)\n", name, err)
    88			os.Exit(1)
    89		}
    90		fmt.Printf("model '%s' integrity: OK\n", name)
    91	}
