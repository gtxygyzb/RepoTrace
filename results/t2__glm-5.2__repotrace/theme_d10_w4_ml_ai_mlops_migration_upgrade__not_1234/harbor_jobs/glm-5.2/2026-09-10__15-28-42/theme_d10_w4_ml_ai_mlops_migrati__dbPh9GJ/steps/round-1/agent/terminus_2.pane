    77	models = append(models, m)
    78	}
    79	}
    80	if len(models) == 0 {
    81	fmt.Fprintf(os.Stderr, "error: at least one model is required\n")
    82	os.Exit(1)
    83	}
    84	
    85	var weights []float64
    86	if weightsStr := flags["weights"]; weightsStr != "" && weightsStr != "true" {
    87	for _, w := range strings.Split(weightsStr, ",") {
    88	w = strings.TrimSpace(w)
    89	if w == "" {
    90	continue
    91	}
    92	val, err := strconv.ParseFloat(w, 64)
    93	if err != nil {
    94	fmt.Println("weights must be positive")
    95	os.Exit(1)
    96	}
    97	if val <= 0 {
    98	fmt.Println("weights must be positive")
    99	os.Exit(1)
   100	}
   101	weights = append(weights, val)
   102	}
   103	if len(weights) != len(models) {
   104	fmt.Println("weight count mismatch")
