   199	
   200	func saveModelMeta(modelDir string, meta map[string]string) error {
   201		f, err := os.Create(filepath.Join(modelDir, "model.meta"))
   202		if err != nil {
   203			return err
   204		}
   205		defer f.Close()
   206	
   207		keys := make([]string, 0, len(meta))
   208		for k := range meta {
   209			keys = append(keys, k)
   210		}
   211		sort.Strings(keys)
   212		for _, k := range keys {
   213			fmt.Fprintf(f, "%s=%s
   214	", k, meta[k])
   215		}
   216		return nil
   217	}
   218	
   219	
   220	type PipelineConfig struct {
   221		Normalize       bool
   222		ScaleMin        float64
   223		ScaleMax        float64
   224		MissingStrategy string
   225		RoundDigits     int
   226		ClipMin         float64
   227		ClipMax         float64
   228	}
   229	
   230	func loadPipelineConfig(modelDir string) (*PipelineConfig, error) {
   231		f, err := os.Open(filepath.Join(modelDir, "pipeline.cfg"))
   232		if err != nil {
   233			return nil, err
   234		}
   235		defer f.Close()
   236	
   237		cfg := &PipelineConfig{
   238			ScaleMin:        0.0,
   239			ScaleMax:        1.0,
   240			MissingStrategy: "zero",
   241			RoundDigits:     4,
   242			ClipMin:         -1000.0,
   243			ClipMax:         1000.0,
   244		}
   245	
