    22			cmdList(args)
    23		case "info":
    24			cmdInfo(args)
    25		case "register":
    26			cmdRegister(args)
    27		case "remove":
    28			cmdRemove(args)
    29		case "run":
    30			cmdRun(args)
    31		case "stats":
