    18	var modelMagic = []byte("MLPW")
    19	
    20	func loadModelMeta(modelDir string) (map[string]string, error) {
    21		f, err := os.Open(filepath.Join(modelDir, "model.meta"))
    22		if err != nil {
    23			return nil, err
    24		}
    25		defer f.Close()
    26	
    27		meta := make(map[string]string)
    28		scanner := bufio.NewScanner(f)
    29		for scanner.Scan() {
    30			line := strings.TrimSpace(scanner.Text())
    31			if line == "" || strings.HasPrefix(line, "#") {
    32				continue
    33			}
    34			parts := strings.SplitN(line, "=", 2)
    35			if len(parts) == 2 {
    36				meta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])
    37			}
    38		}
    39		return meta, scanner.Err()
    40	}
