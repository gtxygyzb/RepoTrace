    37	case "run":
    38	cmdEnsembleRun(rest)
    39	case "info":
    40	cmdEnsembleInfo(rest)
    41	case "remove":
    42	cmdEnsembleRemove(rest)
    43	default:
    44	fmt.Fprintf(os.Stderr, "unknown ensemble command: %s\n", sub)
    45	os.Exit(1)
    46	}
    47	}
