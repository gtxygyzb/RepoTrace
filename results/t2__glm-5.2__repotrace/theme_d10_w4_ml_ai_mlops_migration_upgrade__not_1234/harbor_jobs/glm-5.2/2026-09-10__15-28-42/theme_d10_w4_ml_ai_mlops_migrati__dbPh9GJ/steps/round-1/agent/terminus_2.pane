}

func cmdEnsembleRemove(args []string) {
if len(args) < 1 {
fmt.Fprintf(os.Stderr, "usage: mlpipe ensemble remove <name>\n")
os.Exit(1)
}
name := args[0]

path := filepath.Join(ensemblesDir, name+".json")
if _, err := os.Stat(path); err != nil {
fmt.Println("ensemble not found")
os.Exit(1)
}
if err := os.Remove(path); err != nil {
fmt.Fprintf(os.Stderr, "error: %v\n", err)
os.Exit(1)
}
fmt.Printf("ensemble '%s' removed\n", name)
}

func saveEnsembleConfig(cfg *ensembleConfig) error {
if err := os.MkdirAll(ensemblesDir, 0755); err != nil {
return err
}
data, err := json.MarshalIndent(cfg, "", "  ")
if err != nil {
return err
}
return os.WriteFile(filepath.Join(ensemblesDir, cfg.Name+".json"), data, 0644)
}

func loadEnsembleConfig(name string) (*ensembleConfig, error) {
data, err := os.ReadFile(filepath.Join(ensemblesDir, name+".json"))
if err != nil {
return nil, err
}
var cfg ensembleConfig
if err := json.Unmarshal(data, &cfg); err != nil {
return nil, err
}
return &cfg, nil
}

func listEnsembleConfigs() ([]*ensembleConfig, error) {
files, err := os.ReadDir(ensemblesDir)
if err != nil {
if os.IsNotExist(err) {
return nil, nil
}
return nil, err
}
var configs []*ensembleConfig
for _, file := range files {
if file.IsDir() || !strings.HasSuffix(file.Name(), ".json") {
continue
}
data, err := os.ReadFile(filepath.Join(ensemblesDir, file.Name()))
if err != nil {
return nil, err
}
var cfg ensembleConfig
if err := json.Unmarshal(data, &cfg); err != nil {
return nil, err
}
configs = append(configs, &cfg)
}
sort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })
return configs, nil
}

func combineEnsembleOutputs(allOutputs [][][]float64, strategy string) [][]float64 {
numRows := len(allOutputs[0])
numOutputs := len(allOutputs[0][0])
combined := make([][]float64, numRows)
for i := 0; i < numRows; i++ {
combined[i] = make([]float64, numOutputs)
for j := 0; j < numOutputs; j++ {
vals := make([]float64, len(allOutputs))
for k := range allOutputs {
vals[k] = allOutputs[k][i][j]
}
switch strategy {
case "max":
combined[i][j] = maxFloat64(vals)
case "min":
combined[i][j] = minFloat64(vals)
default:
combined[i][j] = meanFloat64(vals)
}
}
}
return combined
}

