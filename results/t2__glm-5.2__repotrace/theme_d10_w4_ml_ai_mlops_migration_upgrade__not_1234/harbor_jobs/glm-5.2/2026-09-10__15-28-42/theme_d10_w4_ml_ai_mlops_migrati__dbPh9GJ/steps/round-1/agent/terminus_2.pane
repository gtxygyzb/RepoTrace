   405			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   406			os.Exit(1)
   407		}
   408	
   409		dirEntries, err := os.ReadDir(inputDir)
   410		if err != nil {
   411			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   412			os.Exit(1)
   413		}
   414	
   415		var files []string
   416		for _, de := range dirEntries {
   417			if de.IsDir() {
   418				continue
   419			}
