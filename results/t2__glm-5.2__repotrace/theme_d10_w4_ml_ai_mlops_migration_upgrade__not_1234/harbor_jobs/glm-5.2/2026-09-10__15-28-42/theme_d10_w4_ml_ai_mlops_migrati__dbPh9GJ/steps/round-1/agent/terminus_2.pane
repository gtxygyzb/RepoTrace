   127	func runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {
   128		processed := preprocess(inputs, cfg)
   129	
   130		results := make([][]float64, len(processed))
   131		for i, row := range processed {
   132			output := make([]float64, weights.NumOutputs)
   133			for o := uint32(0); o < weights.NumOutputs; o++ {
