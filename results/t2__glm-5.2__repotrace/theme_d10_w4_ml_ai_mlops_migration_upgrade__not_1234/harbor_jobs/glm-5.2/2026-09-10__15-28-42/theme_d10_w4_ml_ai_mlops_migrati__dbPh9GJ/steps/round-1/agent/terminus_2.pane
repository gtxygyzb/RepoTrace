    82	func readInputCSV(path string) ([][]float64, error) {
    83		f, err := os.Open(path)
    84		if err != nil {
    85			return nil, err
    86		}
    87		defer f.Close()
    88	
    89		reader := csv.NewReader(f)
    90		records, err := reader.ReadAll()
    91		if err != nil {
    92			return nil, err
    93		}
    94	
    95		var data [][]float64
    96		for i, record := range records {
    97			if i == 0 && isHeader(record) {
    98				continue
    99			}
   100			row := make([]float64, len(record))
   101			for j, val := range record {
   102				val = strings.TrimSpace(val)
   103				if val == "" || val == "NA" || val == "nan" {
   104					row[j] = math.NaN()
   105				} else {
   106					row[j], err = strconv.ParseFloat(val, 64)
   107					if err != nil {
   108						return nil, fmt.Errorf("row %d col %d: %v", i, j, err)
   109					}
   110				}
   111			}
   112			data = append(data, row)
   113		}
   114		return data, nil
   115	}
   116	
   117	func isHeader(record []string) bool {
   118		for _, val := range record {
   119			_, err := strconv.ParseFloat(strings.TrimSpace(val), 64)
   120			if err == nil {
   121				return false
   122			}
   123		}
   124		return true
   125	}
   126	
   127	func runInference(inputs [][]float64, weights *WeightsData, cfg *PipelineConfig) [][]float64 {
   128		processed := preprocess(inputs, cfg)
   129	
   130		results := make([][]float64, len(processed))
   131		for i, row := range processed {
   132			output := make([]float64, weights.NumOutputs)
   133			for o := uint32(0); o < weights.NumOutputs; o++ {
   134				sum := weights.Bias[o]
   135				for f := uint32(0); f < weights.NumFeatures; f++ {
   136					if int(f) < len(row) {
   137						sum += row[f] * weights.Weights[o*weights.NumFeatures+f]
   138					}
   139				}
   140				output[o] = sum
   141			}
   142			results[i] = output
   143		}
   144	
   145		return postprocess(results, cfg)
   146	}
   147	
   148	func preprocess(inputs [][]float64, cfg *PipelineConfig) [][]float64 {
   149		result := make([][]float64, len(inputs))
   150		for i, row := range inputs {
   151			result[i] = make([]float64, len(row))
   152			copy(result[i], row)
   153		}
   154	
   155		if len(result) == 0 {
   156			return result
   157		}
   158	
   159		for i, row := range result {
   160			for j, val := range row {
   161				if math.IsNaN(val) {
   162					switch cfg.MissingStrategy {
   163					case "zero":
   164						result[i][j] = 0.0
   165					case "mean":
   166						result[i][j] = computeColumnMean(inputs, j)
   167					}
   168				}
   169			}
   170		}
   171	
   172		if cfg.Normalize {
   173			for j := 0; j < len(result[0]); j++ {
   174				minVal, maxVal := columnMinMax(result, j)
   175				rangeVal := maxVal - minVal
   176				if rangeVal == 0 {
   177					rangeVal = 1.0
   178				}
   179				for i := range result {
   180					normalized := (result[i][j] - minVal) / rangeVal
   181					result[i][j] = cfg.ScaleMin + normalized*(cfg.ScaleMax-cfg.ScaleMin)
   182				}
   183			}
   184		}
   185	
   186		return result
   187	}
   188	
   189	func postprocess(results [][]float64, cfg *PipelineConfig) [][]float64 {
   190		for i, row := range results {
   191			for j, val := range row {
   192				val = math.Max(val, cfg.ClipMin)
   193				val = math.Min(val, cfg.ClipMax)
   194				results[i][j] = roundToDigits(val, cfg.RoundDigits)
   195			}
   196		}
   197		return results
   198	}
   199	
   200	func computeColumnMean(data [][]float64, col int) float64 {
   201		sum := 0.0
   202		count := 0
   203		for _, row := range data {
   204			if col < len(row) && !math.IsNaN(row[col]) {
   205				sum += row[col]
   206				count++
   207			}
   208		}
   209		if count == 0 {
   210			return 0.0
   211		}
   212		return sum / float64(count)
   213	}
   214	
