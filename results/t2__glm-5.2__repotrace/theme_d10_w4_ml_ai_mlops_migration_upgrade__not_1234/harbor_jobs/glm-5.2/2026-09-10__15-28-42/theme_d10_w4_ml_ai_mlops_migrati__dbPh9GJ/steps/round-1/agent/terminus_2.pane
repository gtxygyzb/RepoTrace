    34	func loadModelArtifacts(modelDir string) (*WeightsData, *PipelineConfig, error) {
    35		weights, err := loadWeights(modelDir)
    36		if err != nil {
    37			return nil, nil, err
    38		}
    39		cfg, err := loadPipelineConfig(modelDir)
    40		if err != nil {
    41			return nil, nil, err
    42		}
    43		return weights, cfg, nil
    44	}
