    76	func printUsage() {
    77		usage := `mlpipe - ML Inference Pipeline Manager
    78	
    79	Usage: mlpipe <command> [arguments]
    80	
    81	Commands:
    82	  list                          List all registered models
    83	  info <model>                  Show model details
    84	  register <name> <path>        Register a model from directory
    85	  remove <name>                 Remove a model from registry
    86	  run <model> [options]         Run inference
    87	  stats --input <file>          Input statistics profiling
    88	  diff <model1> <model2> --input <file>
    89	                                Compare two models on same input
    90	  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
    91	                                Batch inference over CSV files
    92	  validate <model>              Validate model integrity
    93	  export <model> --output <file> Export model to JSON file
    94	  import <path> [--name <name>] Import model from JSON file
    95	  clone <model> <new_name>      Clone model to new name
    96	    profile <model>               Report model weight analysis
    97	  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
    98	  compat [--all]                 Check migration compatibility
    99	  version                       Show version
   100	  help                          Show this help
   101	
   102	Run/Diff Options:
   103	  --input <file>    Input CSV file (required)
   104	  --output <file>   Output file (default: stdout)
   105	  --format <fmt>    Output format: csv or json (default: csv)
   106	
   107	Batch Options:
   108	  --dir <dir>       Input directory of CSV files
   109	  --output-dir <dir> Output directory for predictions
   110	  --format <fmt>    Output format: csv or json (default: csv)
   111	`
   112		fmt.Print(usage)
   113	}
   114	
   115	func parseFlags(args []string) map[string]string {
   116		flags := make(map[string]string)
   117		for i := 0; i < len(args); i++ {
   118			if strings.HasPrefix(args[i], "--") {
   119				key := strings.TrimPrefix(args[i], "--")
   120				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
   121					flags[key] = args[i+1]
   122					i++
   123				} else {
   124					flags[key] = "true"
   125				}
   126			}
   127		}
   128		return flags
