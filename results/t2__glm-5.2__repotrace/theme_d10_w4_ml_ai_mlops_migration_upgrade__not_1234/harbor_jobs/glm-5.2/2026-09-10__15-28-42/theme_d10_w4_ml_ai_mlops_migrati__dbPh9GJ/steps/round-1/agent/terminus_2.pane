    27		case "remove":
    28			cmdRemove(args)
    29		case "run":
    30			cmdRun(args)
    31		case "stats":
    32			cmdStats(args)
    33		case "diff":
    34			cmdDiff(args)
    35		case "batch":
    36			cmdBatch(args)
    37		case "validate":
    38			cmdValidate(args)
    39		case "export":
    40			cmdExport(args)
    41		case "migrate":
    42			cmdMigrate(args)
    43		case "compat":
    44			cmdCompat(args)
    45		case "version":
    46			fmt.Printf("mlpipe version %s\n", version)
    47		case "help":
    48			printUsage()
    49		default:
    50			fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
    51			printUsage()
    52			os.Exit(1)
    53		}
    54	}
    55	
    56	func printUsage() {
    57		usage := `mlpipe - ML Inference Pipeline Manager
    58	
    59	Usage: mlpipe <command> [arguments]
    60	
    61	Commands:
    62	  list                          List all registered models
    63	  info <model>                  Show model details
    64	  register <name> <path>        Register a model from directory
    65	  remove <name>                 Remove a model from registry
    66	  run <model> [options]         Run inference
    67	  stats --input <file>          Input statistics profiling
    68	  diff <model1> <model2> --input <file>
    69	                                Compare two models on same input
    70	  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
    71	                                Batch inference over CSV files
    72	  validate <model>              Validate model integrity
    73	  export <model> --output <dir> Export model to directory
    74	  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
    75	  compat [--all]                 Check migration compatibility
    76	  version                       Show version
    77	  help                          Show this help
    78	
    79	Run/Diff Options:
    80	  --input <file>    Input CSV file (required)
    81	  --output <file>   Output file (default: stdout)
    82	  --format <fmt>    Output format: csv or json (default: csv)
    83	
    84	Batch Options:
    85	  --dir <dir>       Input directory of CSV files
    86	  --output-dir <dir> Output directory for predictions
    87	  --format <fmt>    Output format: csv or json (default: csv)
    88	`
    89		fmt.Print(usage)
    90	}
    91	
    92	func parseFlags(args []string) map[string]string {
    93		flags := make(map[string]string)
    94		for i := 0; i < len(args); i++ {
    95			if strings.HasPrefix(args[i], "--") {
    96				key := strings.TrimPrefix(args[i], "--")
    97				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
    98					flags[key] = args[i+1]
    99					i++
   100				} else {
   101					flags[key] = "true"
   102				}
   103			}
   104		}
   105		return flags
   106	}
