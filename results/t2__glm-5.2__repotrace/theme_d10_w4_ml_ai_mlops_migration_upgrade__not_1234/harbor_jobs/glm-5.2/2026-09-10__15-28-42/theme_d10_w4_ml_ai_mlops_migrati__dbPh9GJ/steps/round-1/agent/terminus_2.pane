    45		case "validate":
    46			cmdValidate(args)
    47		case "export":
    48			cmdExport(args)
    49		case "import":
    50			cmdImport(args)
    51		case "clone":
    52			cmdClone(args)
    53		case "checkpoint":
    54			cmdCheckpoint(args)
    55		case "checkpoints":
    56			cmdCheckpoints(args)
    57		case "rollback":
    58			cmdRollback(args)
    59		case "migrate":
    60			cmdMigrate(args)
    61		case "compat":
    62			cmdCompat(args)
    63		case "version":
    64			fmt.Printf("mlpipe version %s\n", version)
    65		case "help":
    66			printUsage()
    67		default:
    68			fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
    69			printUsage()
    70			os.Exit(1)
    71		}
    72	}
