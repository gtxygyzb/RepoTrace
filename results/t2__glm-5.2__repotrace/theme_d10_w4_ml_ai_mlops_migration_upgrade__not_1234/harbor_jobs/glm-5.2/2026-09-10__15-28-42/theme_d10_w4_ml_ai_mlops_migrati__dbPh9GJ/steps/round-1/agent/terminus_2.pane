    80	func printUsage() {
    81		usage := `mlpipe - ML Inference Pipeline Manager
    82	
    83	Usage: mlpipe <command> [arguments]
    84	
    85	Commands:
    86	  list                          List all registered models
    87	  info <model>                  Show model details
    88	  register <name> <path>        Register a model from directory
    89	  remove <name>                 Remove a model from registry
    90	  run <model> [options]         Run inference
    91	  stats --input <file>          Input statistics profiling
    92	  diff <model1> <model2> --input <file>
    93	                                Compare two models on same input
    94	  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
    95	                                Batch inference over CSV files
    96	  validate <model>              Validate model integrity
    97	  validate-input <model> --input <file>
    98	                                Validate input data for a model
    99	  schema <model>                Display expected input schema for a model
   100	  export <model> --output <file> Export model to JSON file
   101	  import <path> [--name <name>] Import model from JSON file
   102	  clone <model> <new_name>      Clone model to new name
   103	    profile <model>               Report model weight analysis
   104	  migrate <model> [--activation <type>] Migrate weights from v1 to v2 format
   105	  compat [--all]                 Check migration compatibility
   106	  version                       Show version
