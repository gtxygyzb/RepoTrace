   154	func cmdImport(args []string) {
   155		if len(args) < 1 {
   156			fmt.Fprintf(os.Stderr, "usage: mlpipe import <path> [--name <name>]\n")
   157			os.Exit(1)
   158		}
   159		importPath := args[0]
   160		flags := parseFlags(args[1:])
   161		name := flags["name"]
   162		if name == "" || name == "true" {
   163			name = ""
   164		}
   165	
   166		data, err := os.ReadFile(importPath)
   167		if err != nil {
   168			if os.IsNotExist(err) {
   169				fmt.Fprintf(os.Stderr, "error: file not found: %s\n", importPath)
   170			} else {
   171				fmt.Fprintf(os.Stderr, "error: %v\n", err)
   172			}
   173			os.Exit(1)
   174		}
   175	
   176		var model exportModel
   177		if err := json.Unmarshal(data, &model); err != nil {
   178			fmt.Fprintf(os.Stderr, "error: invalid JSON: %v\n", err)
   179			os.Exit(1)
   180		}
   181	
   182		if name == "" {
   183			name = model.Name
   184		}
   185		if name == "" {
   186			fmt.Fprintf(os.Stderr, "error: invalid model JSON: missing name\n")
   187			os.Exit(1)
   188		}
   189		if model.FormatVersion != 1 && model.FormatVersion != 2 {
   190			fmt.Fprintf(os.Stderr, "error: invalid model JSON: format_version must be 1 or 2\n")
   191			os.Exit(1)
   192		}
   193		if model.Features <= 0 || model.Outputs <= 0 {
   194			fmt.Fprintf(os.Stderr, "error: invalid model JSON: features and outputs must be positive\n")
   195			os.Exit(1)
   196		}
   197		if len(model.Weights) != model.Outputs {
   198			fmt.Fprintf(os.Stderr, "error: invalid model JSON: weights outer dimension must equal outputs\n")
   199			os.Exit(1)
   200		}
   201		for i, row := range model.Weights {
   202			if len(row) != model.Features {
   203				fmt.Fprintf(os.Stderr, "error: invalid model JSON: weights[%d] has %d features, expected %d\n", i, len(row), model.Features)
   204				os.Exit(1)
   205			}
   206		}
   207		if len(model.Bias) != model.Outputs {
   208			fmt.Fprintf(os.Stderr, "error: invalid model JSON: bias length must equal outputs\n")
   209			os.Exit(1)
   210		}
   211		if len(model.Pipeline.ScaleRange) != 2 {
   212			fmt.Fprintf(os.Stderr, "error: invalid model JSON: scale_range must have two values\n")
   213			os.Exit(1)
   214		}
   215		if len(model.Pipeline.ClipRange) != 2 {
   216			fmt.Fprintf(os.Stderr, "error: invalid model JSON: clip_range must have two values\n")
   217			os.Exit(1)
   218		}
   219	
   220		activationName := model.Activation
   221		if model.FormatVersion == 1 {
   222			activationName = "none"
   223		}
   224		activationID, err := activationNameToID(activationName)
   225		if err != nil {
   226			fmt.Fprintf(os.Stderr, "error: invalid model JSON: %v\n", err)
   227			os.Exit(1)
   228		}
   229		if model.FormatVersion == 1 && model.Activation != "none" {
   230			fmt.Fprintf(os.Stderr, "error: invalid model JSON: v1 models must use activation none\n")
   231			os.Exit(1)
   232		}
   233	
   234		entries, err := loadRegistry()
   235		if err != nil {
   236			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   237			os.Exit(1)
   238		}
   239		if findEntry(entries, name) != nil {
   240			fmt.Fprintf(os.Stderr, "error: model already exists\n")
   241			os.Exit(1)
   242		}
   243	
   244		modelDir := filepath.Join("/app/models", name)
   245		if err := os.MkdirAll(modelDir, 0755); err != nil {
   246			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   247			os.Exit(1)
   248		}
   249	
   250		flatWeights := make([]float64, 0, model.Features*model.Outputs)
   251		for o := 0; o < model.Outputs; o++ {
   252			flatWeights = append(flatWeights, model.Weights[o]...)
   253		}
   254		weightsData := &WeightsData{
   255			Version:     uint32(model.FormatVersion),
   256			NumFeatures: uint32(model.Features),
   257			NumOutputs:  uint32(model.Outputs),
   258			Activation:  activationID,
   259			Weights:     flatWeights,
   260			Bias:        model.Bias,
   261		}
   262		if err := writeWeights(filepath.Join(modelDir, "weights.bin"), weightsData); err != nil {
   263			fmt.Fprintf(os.Stderr, "error writing weights: %v\n", err)
   264			os.Exit(1)
   265		}
   266	
   267		meta := map[string]string{
   268			"name":           name,
   269			"type":           model.Type,
   270			"version":        strconv.Itoa(model.Version),
   271			"created":        time.Now().Format("2006-01-02"),
   272			"description":    "Imported from JSON export",
   273			"features":       strconv.Itoa(model.Features),
   274			"outputs":        strconv.Itoa(model.Outputs),
   275			"format_version": strconv.Itoa(model.FormatVersion),
   276			"activation":     activationName,
   277		}
   278		if meta["type"] == "" {
   279			meta["type"] = "unknown"
   280		}
   281		if meta["version"] == "0" {
   282			meta["version"] = "1"
   283		}
   284		if err := saveModelMeta(modelDir, meta); err != nil {
   285			fmt.Fprintf(os.Stderr, "error writing metadata: %v\n", err)
   286			os.Exit(1)
   287		}
   288	
   289		cfg := &PipelineConfig{
   290			Normalize:       model.Pipeline.Normalize,
   291			ScaleMin:        model.Pipeline.ScaleRange[0],
   292			ScaleMax:        model.Pipeline.ScaleRange[1],
   293			MissingStrategy: model.Pipeline.MissingStrategy,
   294			RoundDigits:     model.Pipeline.RoundDigits,
   295			ClipMin:         model.Pipeline.ClipRange[0],
   296			ClipMax:         model.Pipeline.ClipRange[1],
   297		}
   298		if cfg.MissingStrategy == "" {
   299			cfg.MissingStrategy = "zero"
   300		}
   301		if err := savePipelineConfig(modelDir, cfg); err != nil {
   302			fmt.Fprintf(os.Stderr, "error writing pipeline config: %v\n", err)
   303			os.Exit(1)
   304		}
   305	
   306		registryVersion := model.Version
   307		if registryVersion == 0 {
   308			registryVersion = 1
   309		}
   310		entries = append(entries, RegistryEntry{
   311			Name:    name,
   312			Path:    modelDir,
   313			Type:    model.Type,
   314			Version: registryVersion,
   315			Created: time.Now().Format("2006-01-02"),
   316		})
   317		if err := saveRegistry(entries); err != nil {
   318			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   319			os.Exit(1)
   320		}
   321		fmt.Printf("Model '%s' imported successfully.\n", name)
   322	}
   323	
   324	func cmdClone(args []string) {
   325		if len(args) < 2 {
   326			fmt.Fprintf(os.Stderr, "usage: mlpipe clone <model> <new_name>\n")
   327			os.Exit(1)
   328		}
   329		sourceName := args[0]
   330		newName := args[1]
   331	
   332		entry, err := resolveModel(sourceName)
   333		if err != nil {
   334			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   335			os.Exit(1)
   336		}
   337	
   338		entries, err := loadRegistry()
   339		if err != nil {
   340			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   341			os.Exit(1)
   342		}
   343		if findEntry(entries, newName) != nil {
   344			fmt.Fprintf(os.Stderr, "error: model already exists\n")
   345			os.Exit(1)
   346		}
   347	
   348		newDir := filepath.Join("/app/models", newName)
   349		if err := os.MkdirAll(newDir, 0755); err != nil {
   350			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   351			os.Exit(1)
   352		}
   353		if err := copyDir(entry.Path, newDir); err != nil {
   354			fmt.Fprintf(os.Stderr, "error cloning model files: %v\n", err)
   355			os.Exit(1)
   356		}
   357	
   358		meta, err := loadModelMeta(newDir)
   359		if err != nil {
   360			fmt.Fprintf(os.Stderr, "error updating metadata: %v\n", err)
   361			os.Exit(1)
   362		}
   363		meta["name"] = newName
   364		if err := saveModelMeta(newDir, meta); err != nil {
   365			fmt.Fprintf(os.Stderr, "error updating metadata: %v\n", err)
   366			os.Exit(1)
   367		}
   368	
   369		registryVersion := entry.Version
   370		if registryVersion == 0 {
   371			registryVersion = 1
   372		}
   373		entries = append(entries, RegistryEntry{
   374			Name:    newName,
   375			Path:    newDir,
   376			Type:    entry.Type,
   377			Version: registryVersion,
   378			Created: time.Now().Format("2006-01-02"),
   379		})
   380		if err := saveRegistry(entries); err != nil {
   381			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   382			os.Exit(1)
   383		}
   384		fmt.Printf("Model '%s' cloned to '%s'.\n", sourceName, newName)
   385	}
   386	
   387	func savePipelineConfig(modelDir string, cfg *PipelineConfig) error {
   388		path := filepath.Join(modelDir, "pipeline.cfg")
   389		f, err := os.Create(path)
   390		if err != nil {
   391			return err
   392		}
   393		defer f.Close()
   394	
   395		fmt.Fprintln(f, "[preprocess]")
   396		fmt.Fprintf(f, "normalize=%t\n", cfg.Normalize)
   397		fmt.Fprintf(f, "scale_range=%s,%s\n", formatFloat(cfg.ScaleMin), formatFloat(cfg.ScaleMax))
   398		fmt.Fprintf(f, "missing_strategy=%s\n", cfg.MissingStrategy)
   399		fmt.Fprintln(f)
   400		fmt.Fprintln(f, "[postprocess]")
   401		fmt.Fprintf(f, "round_digits=%d\n", cfg.RoundDigits)
   402		fmt.Fprintf(f, "clip_min=%s\n", formatFloat(cfg.ClipMin))
   403		fmt.Fprintf(f, "clip_max=%s\n", formatFloat(cfg.ClipMax))
   404		return nil
   405	}
   406	
   407	func formatFloat(v float64) string {
   408		return strconv.FormatFloat(v, 'f', -1, 64)
   409	}
