    76	func cmdStats(args []string) {
    77		flags := parseFlags(args)
    78		input := flags["input"]
    79		if input == "" {
    80			fmt.Fprintf(os.Stderr, "usage: mlpipe stats --input <file>\n")
    81			os.Exit(1)
    82		}
    83	
    84		records, err := readCSVRaw(input)
    85		if err != nil {
    86			fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
    87			os.Exit(1)
    88		}
    89		if len(records) == 0 {
    90			fmt.Println("No data found.")
    91			return
    92		}
    93	
    94		hasHeader := isHeader(records[0])
    95		start := 0
    96		if hasHeader {
    97			start = 1
    98		}
    99	
   100		numCols := 0
   101		for _, rec := range records {
   102			if len(rec) > numCols {
   103				numCols = len(rec)
   104			}
   105		}
   106	
   107		headers := make([]string, numCols)
   108		for i := 0; i < numCols; i++ {
   109			if hasHeader && i < len(records[0]) {
   110				headers[i] = strings.TrimSpace(records[0][i])
   111			} else {
   112				headers[i] = fmt.Sprintf("col_%d", i)
   113			}
   114		}
   115	
   116		type colStat struct {
   117			idx     int
   118			name    string
   119			count   int
   120			missing int
   121			min     float64
   122			max     float64
   123			mean    float64
   124			stddev  float64
   125			values  []float64
   126		}
   127	
   128		var stats []colStat
   129		numericCols := make([]int, 0)
   130		valuesByCol := make(map[int][]float64)
   131	
   132		for j := 0; j < numCols; j++ {
   133			values := make([]float64, 0, len(records)-start)
   134			missing := 0
   135			numeric := true
   136	
   137			for i := start; i < len(records); i++ {
   138				raw := ""
   139				if j < len(records[i]) {
   140					raw = strings.TrimSpace(records[i][j])
   141				}
   142				if isMissingValue(raw) {
   143					missing++
   144					values = append(values, math.NaN())
   145					continue
   146				}
   147				v, err := strconv.ParseFloat(raw, 64)
   148				if err != nil {
   149					numeric = false
   150					break
   151				}
   152				values = append(values, v)
   153			}
   154	
   155			if !numeric {
   156				continue
   157			}
   158	
   159			count := len(values) - missing
   160			st := colStat{
   161				idx:     j,
   162				name:    headers[j],
   163				count:   count,
   164				missing: missing,
   165				min:     math.NaN(),
   166				max:     math.NaN(),
   167				mean:    math.NaN(),
   168				stddev:  math.NaN(),
   169				values:  values,
   170			}
   171	
   172			if count > 0 {
   173				sum := 0.0
   174				sumSq := 0.0
   175				minVal := math.Inf(1)
   176				maxVal := math.Inf(-1)
   177				for _, v := range values {
   178					if math.IsNaN(v) {
   179						continue
   180					}
