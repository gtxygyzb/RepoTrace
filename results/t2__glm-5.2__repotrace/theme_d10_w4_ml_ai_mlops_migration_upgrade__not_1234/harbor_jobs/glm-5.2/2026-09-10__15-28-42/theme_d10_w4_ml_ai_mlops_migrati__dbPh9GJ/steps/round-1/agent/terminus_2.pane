    15	var modelMagic = []byte("MLPW")
    16	
    17	func loadModelMeta(modelDir string) (map[string]string, error) {
    18		f, err := os.Open(filepath.Join(modelDir, "model.meta"))
    19		if err != nil {
    20			return nil, err
    21		}
    22		defer f.Close()
    23	
    24		meta := make(map[string]string)
    25		scanner := bufio.NewScanner(f)
    26		for scanner.Scan() {
    27			line := strings.TrimSpace(scanner.Text())
    28			if line == "" || strings.HasPrefix(line, "#") {
    29				continue
    30			}
    31			parts := strings.SplitN(line, "=", 2)
    32			if len(parts) == 2 {
    33				meta[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])
    34			}
    35		}
    36		return meta, scanner.Err()
    37	}
    38	
    39	type WeightsData struct {
    40		Version     uint32
    41		NumFeatures uint32
    42		NumOutputs  uint32
    43		Activation  uint32
    44		Weights     []float64
    45		Bias        []float64
    46	}
    47	
    48	func loadWeights(modelDir string) (*WeightsData, error) {
    49		f, err := os.Open(filepath.Join(modelDir, "weights.bin"))
    50		if err != nil {
    51			return nil, err
    52		}
    53		defer f.Close()
    54	
    55		magic := make([]byte, 4)
    56		if _, err := f.Read(magic); err != nil {
    57			return nil, fmt.Errorf("failed to read magic: %v", err)
    58		}
    59		if string(magic) != string(modelMagic) {
    60			return nil, fmt.Errorf("invalid model file: bad magic")
    61		}
    62	
    63		var ver, nf, no uint32
    64		if err := binary.Read(f, binary.LittleEndian, &ver); err != nil {
    65			return nil, fmt.Errorf("failed to read version: %v", err)
    66		}
    67		if err := binary.Read(f, binary.LittleEndian, &nf); err != nil {
    68			return nil, fmt.Errorf("failed to read num_features: %v", err)
    69		}
    70		if err := binary.Read(f, binary.LittleEndian, &no); err != nil {
    71			return nil, fmt.Errorf("failed to read num_outputs: %v", err)
    72		}
    73	
    74		var act uint32
    75		switch ver {
    76		case 1:
    77			act = 0
    78		case 2:
    79			if err := binary.Read(f, binary.LittleEndian, &act); err != nil {
    80				return nil, fmt.Errorf("failed to read activation: %v", err)
    81			}
    82		default:
    83			return nil, fmt.Errorf("unsupported model format version: %d", ver)
    84		}
    85	
    86		weights := make([]float64, nf*no)
    87		for i := range weights {
    88			if err := binary.Read(f, binary.LittleEndian, &weights[i]); err != nil {
    89				return nil, fmt.Errorf("failed to read weight[%d]: %v", i, err)
    90			}
    91		}
    92	
    93		bias := make([]float64, no)
    94		for i := range bias {
    95			if err := binary.Read(f, binary.LittleEndian, &bias[i]); err != nil {
    96				return nil, fmt.Errorf("failed to read bias[%d]: %v", i, err)
    97			}
    98		}
    99	
   100		return &WeightsData{
   101			Version:     ver,
   102			NumFeatures: nf,
   103			NumOutputs:  no,
   104			Activation:  act,
   105			Weights:     weights,
   106			Bias:        bias,
   107		}, nil
   108	}
   109	
   110	func writeWeights(path string, w *WeightsData) error {
   111		f, err := os.Create(path)
   112		if err != nil {
   113			return err
   114		}
   115		defer f.Close()
   116	
   117		if _, err := f.Write(modelMagic); err != nil {
   118			return err
   119		}
   120		if err := binary.Write(f, binary.LittleEndian, w.Version); err != nil {
   121			return err
   122		}
   123		if err := binary.Write(f, binary.LittleEndian, w.NumFeatures); err != nil {
   124			return err
   125		}
   126		if err := binary.Write(f, binary.LittleEndian, w.NumOutputs); err != nil {
   127			return err
   128		}
   129		if w.Version >= 2 {
   130			if err := binary.Write(f, binary.LittleEndian, w.Activation); err != nil {
   131				return err
   132			}
   133		}
   134		for _, v := range w.Weights {
   135			if err := binary.Write(f, binary.LittleEndian, v); err != nil {
   136				return err
   137			}
   138		}
   139		for _, v := range w.Bias {
   140			if err := binary.Write(f, binary.LittleEndian, v); err != nil {
   141				return err
   142			}
   143		}
   144		return nil
   145	}
   146	
   147	const (
   148		activationNone    = 0
   149		activationSigmoid = 1
   150		activationReLU    = 2
   151		activationTanh    = 3
   152	)
   153	
   154	func activationNameToID(name string) (uint32, error) {
   155		switch strings.ToLower(name) {
   156		case "", "none":
   157			return activationNone, nil
   158		case "sigmoid":
   159			return activationSigmoid, nil
   160		case "relu":
   161			return activationReLU, nil
   162		case "tanh":
   163			return activationTanh, nil
   164		default:
   165			return 0, fmt.Errorf("invalid activation")
   166		}
   167	}
   168	
   169	func activationIDToName(id uint32) string {
   170		switch id {
[?2004hroot@n30009:/app# nl -ba upgrade_verify.go | sed -n '1,110p'
[?2004l     1	package main
     2	
     3	import (
     4		"fmt"
     5		"os"
     6		"path/filepath"
     7	)
     8	
     9	func cmdUpgrade(args []string) {
    10		if len(args) < 1 {
    11			fmt.Fprintf(os.Stderr, "usage: mlpipe upgrade <model>\n")
    12			os.Exit(1)
    13		}
    14		name := args[0]
    15		entry, err := resolveModel(name)
    16		if err != nil {
    17			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    18			os.Exit(1)
    19		}
    20	
    21		weightsPath := filepath.Join(entry.Path, "weights.bin")
    22	
    23		weights, err := loadWeights(entry.Path)
    24		if err != nil {
    25			fmt.Fprintf(os.Stderr, "error loading weights: %v\n", err)
    26			os.Exit(1)
    27		}
    28	
    29		if weights.Version >= 3 {
    30			fmt.Println("already at latest version")
    31			return
    32		}
    33	
    34		backupPath := weightsPath + ".v2bak"
    35		if weights.Version == 1 {
    36			backupPath = weightsPath + ".v1bak"
    37		}
    38	
    39		data, err := os.ReadFile(weightsPath)
    40		if err != nil {
    41			fmt.Fprintf(os.Stderr, "error reading weights: %v\n", err)
    42			os.Exit(1)
    43		}
    44		if err := os.WriteFile(backupPath, data, 0644); err != nil {
    45			fmt.Fprintf(os.Stderr, "error writing backup: %v\n", err)
    46			os.Exit(1)
    47		}
    48	
    49		if weights.Version == 1 {
    50			weights.Activation = activationNone
    51		}
    52		weights.Version = 3
    53	
    54		if err := writeWeights(weightsPath, weights); err != nil {
    55			fmt.Fprintf(os.Stderr, "error writing weights: %v\n", err)
    56			os.Exit(1)
    57		}
    58	
    59		meta, err := loadModelMeta(entry.Path)
    60		if err != nil {
    61			fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
    62			os.Exit(1)
    63		}
    64		meta["format_version"] = "3"
    65		meta["activation"] = activationIDToName(weights.Activation)
    66		if err := saveModelMeta(entry.Path, meta); err != nil {
    67			fmt.Fprintf(os.Stderr, "error updating metadata: %v\n", err)
    68			os.Exit(1)
    69		}
    70	
    71		fmt.Printf("model '%s' upgraded to format v3\n", name)
    72	}
    73	
    74	func cmdVerify(args []string) {
    75		if len(args) < 1 {
    76			fmt.Fprintf(os.Stderr, "usage: mlpipe verify <model>\n")
    77			os.Exit(1)
    78		}
    79		name := args[0]
    80		entry, err := resolveModel(name)
    81		if err != nil {
    82			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    83			os.Exit(1)
    84		}
    85	
    86		if _, err := loadWeights(entry.Path); err != nil {
    87			fmt.Printf("model '%s' integrity: FAILED (%v)\n", name, err)
    88			os.Exit(1)
    89		}
    90		fmt.Printf("model '%s' integrity: OK\n", name)
    91	}
