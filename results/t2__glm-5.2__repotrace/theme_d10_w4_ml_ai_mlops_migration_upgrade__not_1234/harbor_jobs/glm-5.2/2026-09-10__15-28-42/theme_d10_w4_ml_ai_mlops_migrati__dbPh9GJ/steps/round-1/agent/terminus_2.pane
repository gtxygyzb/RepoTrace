	case "diff":
		cmdDiff(args)
	case "batch":
		cmdBatch(args)
	case "validate":
		cmdValidate(args)
	case "export":
		cmdExport(args)
	case "version":
		fmt.Printf("mlpipe version %s\n", version)
	case "help":
		printUsage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", command)
		printUsage()
		os.Exit(1)
	}
}

func printUsage() {
	usage := `mlpipe - ML Inference Pipeline Manager

Usage: mlpipe <command> [arguments]

Commands:
  list                          List all registered models
  info <model>                  Show model details
  register <name> <path>        Register a model from directory
  remove <name>                 Remove a model from registry
  run <model> [options]         Run inference
  stats --input <file>          Input statistics profiling
  diff <model1> <model2> --input <file>
                                Compare two models on same input
  batch <model> --dir <dir> --output-dir <dir> [--format csv|json]
                                Batch inference over CSV files
  validate <model>              Validate model integrity
  export <model> --output <dir> Export model to directory
  version                       Show version
  help                          Show this help

Run/Diff Options:
  --input <file>    Input CSV file (required)
  --output <file>   Output file (default: stdout)
  --format <fmt>    Output format: csv or json (default: csv)

Batch Options:
  --dir <dir>       Input directory of CSV files
  --output-dir <dir> Output directory for predictions
  --format <fmt>    Output format: csv or json (default: csv)
`
	fmt.Print(usage)
}

func parseFlags(args []string) map[string]string {
	flags := make(map[string]string)
	for i := 0; i < len(args); i++ {
		if strings.HasPrefix(args[i], "--") {
			key := strings.TrimPrefix(args[i], "--")
			if i+1 < len(args) && !strings.HasPrefix(args[i+1], "--") {
				flags[key] = args[i+1]
				i++
			} else {
				flags[key] = "true"
			}
		}
	}
	return flags
}
[?2004hroot@n30009:/app# sed -n '1,260p' registry.go
[?2004lpackage main

import (
	"bufio"
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"time"
)

const registryFile = "/app/models/registry.idx"

type RegistryEntry struct {
	Name    string
	Path    string
	Type    string
	Version int
	Created string
}

func loadRegistry() ([]RegistryEntry, error) {
	f, err := os.Open(registryFile)
	if err != nil {
		if os.IsNotExist(err) {
			return nil, nil
		}
		return nil, err
	}
	defer f.Close()

	var entries []RegistryEntry
	scanner := bufio.NewScanner(f)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		parts := strings.Split(line, "|")
		if len(parts) != 5 {
			continue
		}
		ver := 1
		fmt.Sscanf(parts[3], "%d", &ver)
		entries = append(entries, RegistryEntry{
			Name:    parts[0],
			Path:    parts[1],
			Type:    parts[2],
			Version: ver,
			Created: parts[4],
		})
	}
	return entries, scanner.Err()
}

func saveRegistry(entries []RegistryEntry) error {
	dir := filepath.Dir(registryFile)
	if err := os.MkdirAll(dir, 0755); err != nil {
		return err
	}

	f, err := os.Create(registryFile)
	if err != nil {
		return err
	}
	defer f.Close()

	fmt.Fprintln(f, "# mlpipe registry v1")
	for _, e := range entries {
		fmt.Fprintf(f, "%s|%s|%s|%d|%s\n", e.Name, e.Path, e.Type, e.Version, e.Created)
	}
	return nil
}

func findEntry(entries []RegistryEntry, name string) *RegistryEntry {
	for i := range entries {
		if entries[i].Name == name {
			return &entries[i]
		}
	}
	return nil
}

func cmdList(args []string) {
	entries, err := loadRegistry()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	if len(entries) == 0 {
		fmt.Println("No models registered.")
		return
	}
	fmt.Printf("%-20s %-10s %-8s %s\n", "NAME", "TYPE", "VERSION", "CREATED")
	for _, e := range entries {
		fmt.Printf("%-20s %-10s %-8d %s\n", e.Name, e.Type, e.Version, e.Created)
	}
}

func cmdInfo(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe info <model>\n")
		os.Exit(1)
	}
	name := args[0]
	entries, err := loadRegistry()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	entry := findEntry(entries, name)
	if entry == nil {
		fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
		os.Exit(1)
	}
	if !modelDirExists(entry.Path) {
		fmt.Fprintf(os.Stderr, "error: model directory not found\n")
		os.Exit(1)
	}

	meta, err := loadModelMeta(entry.Path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error loading metadata: %v\n", err)
		os.Exit(1)
	}

	fmt.Printf("Name:        %s\n", meta["name"])
	fmt.Printf("Type:        %s\n", meta["type"])
	fmt.Printf("Version:     %s\n", meta["version"])
	fmt.Printf("Created:     %s\n", meta["created"])
	fmt.Printf("Description: %s\n", meta["description"])
	fmt.Printf("Features:    %s\n", meta["features"])
	fmt.Printf("Outputs:     %s\n", meta["outputs"])
	fmt.Printf("Path:        %s\n", entry.Path)
}

func cmdRegister(args []string) {
	if len(args) < 2 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe register <name> <path>\n")
		os.Exit(1)
	}
	name := args[0]
	modelPath := args[1]

	absPath, err := filepath.Abs(modelPath)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	if _, err := os.Stat(filepath.Join(absPath, "model.meta")); err != nil {
		fmt.Fprintf(os.Stderr, "error: no model.meta found at %s\n", absPath)
		os.Exit(1)
	}

	meta, err := loadModelMeta(absPath)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	entries, err := loadRegistry()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	if findEntry(entries, name) != nil {
		fmt.Fprintf(os.Stderr, "error: model '%s' already registered\n", name)
		os.Exit(1)
	}

	modelType := meta["type"]
	if modelType == "" {
		modelType = "unknown"
	}

	entries = append(entries, RegistryEntry{
		Name:    name,
		Path:    absPath,
		Type:    modelType,
		Version: 1,
		Created: time.Now().Format("2006-01-02"),
	})

	if err := saveRegistry(entries); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	fmt.Printf("Model '%s' registered successfully.\n", name)
}

func cmdRemove(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: mlpipe remove <name>\n")
		os.Exit(1)
	}
	name := args[0]

	entries, err := loadRegistry()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	found := false
	var newEntries []RegistryEntry
	for _, e := range entries {
		if e.Name == name {
			found = true
		} else {
			newEntries = append(newEntries, e)
		}
	}

	if !found {
		fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
		os.Exit(1)
	}

	if err := saveRegistry(newEntries); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	fmt.Printf("Model '%s' removed.\n", name)
}
