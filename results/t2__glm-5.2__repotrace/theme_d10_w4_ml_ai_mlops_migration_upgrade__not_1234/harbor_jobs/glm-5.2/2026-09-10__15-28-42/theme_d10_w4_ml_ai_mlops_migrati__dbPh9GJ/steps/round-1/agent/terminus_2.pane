   323	
   324	func saveEnsembleConfig(cfg *ensembleConfig) error {
   325	if err := os.MkdirAll(ensemblesDir, 0755); err != nil {
   326	return err
   327	}
   328	data, err := json.MarshalIndent(cfg, "", "  ")
   329	if err != nil {
   330	return err
   331	}
   332	return os.WriteFile(filepath.Join(ensemblesDir, cfg.Name+".json"), data, 0644)
   333	}
   334	
   335	func loadEnsembleConfig(name string) (*ensembleConfig, error) {
   336	data, err := os.ReadFile(filepath.Join(ensemblesDir, name+".json"))
   337	if err != nil {
   338	return nil, err
   339	}
   340	var cfg ensembleConfig
   341	if err := json.Unmarshal(data, &cfg); err != nil {
   342	return nil, err
   343	}
   344	return &cfg, nil
   345	}
   346	
   347	func listEnsembleConfigs() ([]*ensembleConfig, error) {
   348	files, err := os.ReadDir(ensemblesDir)
   349	if err != nil {
   350	if os.IsNotExist(err) {
   351	return nil, nil
   352	}
   353	return nil, err
   354	}
   355	var configs []*ensembleConfig
   356	for _, file := range files {
   357	if file.IsDir() || !strings.HasSuffix(file.Name(), ".json") {
   358	continue
   359	}
   360	data, err := os.ReadFile(filepath.Join(ensemblesDir, file.Name()))
   361	if err != nil {
   362	return nil, err
   363	}
   364	var cfg ensembleConfig
   365	if err := json.Unmarshal(data, &cfg); err != nil {
   366	return nil, err
   367	}
   368	configs = append(configs, &cfg)
   369	}
   370	sort.Slice(configs, func(i, j int) bool { return configs[i].Name < configs[j].Name })
   371	return configs, nil
   372	}
