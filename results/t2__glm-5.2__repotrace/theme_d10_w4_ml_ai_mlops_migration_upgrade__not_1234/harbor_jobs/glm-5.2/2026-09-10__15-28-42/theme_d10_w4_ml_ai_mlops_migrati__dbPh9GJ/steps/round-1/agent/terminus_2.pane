   168	entry := findEntry(entries, name)
   169	if entry == nil {
   170	fmt.Fprintf(os.Stderr, "error: model '%s' not found\n", name)
   171	os.Exit(1)
   172	}
   173	if !modelDirExists(entry.Path) {
   174	fmt.Fprintf(os.Stderr, "error: model directory not found\n")
   175	os.Exit(1)
   176	}
   177	
