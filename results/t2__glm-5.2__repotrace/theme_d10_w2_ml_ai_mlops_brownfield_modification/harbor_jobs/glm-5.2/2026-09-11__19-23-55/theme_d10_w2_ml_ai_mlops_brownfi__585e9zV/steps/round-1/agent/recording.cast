[3057.836127, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"math\"\r\n     7\t\t\"os\"\r\n     8\t\t\"os/exec\"\r\n     9\t\t\"path/filepath\"\r\n"]
[3057.83622, "o", "    10\t\t\"regexp\"\r\n    11\t\t\"sort\"\r\n    12\t\t\"strconv\"\r\n    13\t\t\"strings\"\r\n    14\t\t\"sync\"\r\n    15\t\t\"time\"\r\n    16\t)\r\n    17\t\r\n    18\tconst pipelineRunsDir = \"/tmp/nexus/runs\"\r\n    19\t\r\n    20\ttype PipelineResourceLimit struct {\r\n    21\t\tCPU      int `json:\"cpu,omitempty\"`\r\n    22\t\tMemoryMB int `json:\"memory_mb,omitempty\"`\r\n"]
[3057.836294, "o", "    23\t}\r\n    24\t\r\n    25\ttype PipelineStepResources struct {\r\n    26\t\tCPU      int `json:\"cpu,omitempty\"`\r\n    27\t\tMemoryMB int `json:\"memory_mb,omitempty\"`\r\n    28\t}\r\n    29\t\r\n    30\ttype PipelineStepRetry struct {\r\n    31\t\tMaxRetries         int `json:\"max_retries,omitempty\"`\r\n    32\t"]
[3057.836355, "o", "\tBackoffBaseSeconds int `json:\"backoff_base_seconds,omitempty\"`\r\n    33\t}\r\n    34\t\r\n    35\ttype CaptureOutputConfig struct {\r\n    36\t\tName  string `json:\"name\"`\r\n    37\t\tRegex string `json:\"regex,omitempty\"`\r\n    38\t}\r\n    39\t\r\n    40\tfunc (c *CaptureOutputConfig) UnmarshalJSON(data []byte) error {\r\n"]
[3057.836421, "o", "    41\t\tvar str string\r\n    42\t\tif err := json.Unmarshal(data, &str); err == nil {\r\n    43\t\t\tc.Name = str\r\n    44\t\t\tc.Regex = \"\"\r\n    45\t\t\treturn nil\r\n    46\t\t}\r\n    47\t\tvar raw struct {\r\n    48\t\t\tName  string `json:\"name\"`\r\n    49\t\t\tRegex string `json:\"regex\"`\r\n    50\t"]
[3057.836483, "o", "\t}\r\n    51\t\tif err := json.Unmarshal(data, &raw); err != nil {\r\n    52\t\t\treturn fmt.Errorf(\"capture_output must be a string or an object with name and optional regex\")\r\n    53\t\t}\r\n    54\t\tc.Name = raw.Name\r\n    55\t\tc.Regex = raw.Regex\r\n    56\t\treturn nil\r\n    57\t}\r\n    58\t\r\n"]
[3057.836543, "o", "    59\ttype PipelineExperimentConfig struct {\r\n    60\t\tName    string            `json:\"name,omitempty\"`\r\n    61\t\tParams  map[string]string `json:\"params,omitempty\"`\r\n    62\t\tMetrics []string          `json:\"metrics,omitempty\"`\r\n    63\t}\r\n    64\t\r\n    65\ttype PipelineStep struct {\r\n"]
[3057.836609, "o", "    66\t\tName             string                    `json:\"name\"`\r\n    67\t\tType             string                    `json:\"type\"`\r\n    68\t\tCommand          string                    `json:\"command\"`\r\n    69\t\tDependsOn        []string                  `json:\"depends_on,omitempty\"`\r\n    70\t\tInputs           []string                  `json:\"inputs,omitempty\"`\r\n    71\t\tOutputs          []string                  `json:\"outputs,omitempty\"`\r\n    72\t\tResources        *PipelineStepResources    `json:\"resources,omitempty\"`\r\n    73\t\tTimeoutSeconds   int                       `json:\"timeout_seconds,omitempty\"`\r\n    74\t\tRetry            *PipelineStepRetry        `json:\"retry,omitempty\"`\r\n    75\t\tCondition        string                    `json:\"condition,omitempty\"`\r\n"]
[3057.836676, "o", "    76\t\tExperimentConfig *PipelineExperimentConfig `json:\"experiment_config,omitempty\"`\r\n    77\t\tDatasetRef       string                    `json:\"dataset_ref,omitempty\"`\r\n    78\t\tCaptureOutput    *CaptureOutputConfig      `json:\"capture_output,omitempty\"`\r\n    79\t\tEnv              map[string]string         `json:\"env,omitempty\"`\r\n    80\t}\r\n    81\t\r\n"]
[3057.836796, "o", "    82\ttype PipelineConfig struct {\r\n    83\t\tName          string                 `json:\"name\"`\r\n    84\t\tParameters    map[string]string      `json:\"parameters,omitempty\"`\r\n    85\t\tMaxParallel   int                    `json:\"max_parallel,omitempty\"`\r\n    86\t\tResourceLimit *PipelineResourceLimit `json:\"resource_limit,omitempty\"`\r\n    87\t\tSteps         []*PipelineStep        `json:\"steps\"`\r\n    88\t}\r\n    89\t\r\n    90\ttype Artifact struct {\r\n    91\t\tName     string `json:\"name\"`\r\n    92\t\tType     string `json:\"type\"`\r\n    93\t\tProducer string `json:\"producer\"`\r\n    94\t\tPath     string `json:\"path\"`\r\n    95\t\tSize     int64  `json:\"size\"`\r\n    96\t}\r\n    97\t\r\n    98\ttype StepRun struct {\r\n    99\t\tName         string     `json:\"name\"`\r\n   100\t\tType         string     `json:\"type\"`\r\n   101\t\tStatus       string     `json:\"status\"`\r\n"]
[3057.836874, "o", "   102\t\tStartTime    *time.Time `json:\"start_time,omitempty\"`\r\n   103\t\tEndTime      *time.Time `json:\"end_time,omitempty\"`\r\n   104\t\tExitCode     int        `json:\"exit_code,omitempty\"`\r\n   105\t\tOutput       string     `json:\"output,omitempty\"`\r\n   106\t\tError        string     `json:\"error,omitempty\"`\r\n   107\t\tArtifacts    []Artifact `json:\"artifacts,omitempty\"`\r\n   108\t\tExperimentID string     `json:\"experiment_id,omitempty\"`\r\n   109\t\tRetryCount   int        `json:\"retry_count\"`\r\n   110\t}\r\n   111\t\r\n   112\ttype PipelineRun struct {\r\n"]
[3057.836941, "o", "   113\t\tID         string            `json:\"id\"`\r\n   114\t\tPipeline   string            `json:\"pipeline\"`\r\n   115\t\tStatus     string            `json:\"status\"`\r\n   116\t\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n   117\t\tStartTime  *time.Time        `json:\"start_time,omitempty\"`\r\n   118\t\tEndTime    *time.Time        `json:\"end_time,omitempty\"`\r\n   119\t\tSteps      []*StepRun        `json:\"steps\"`\r\n   120\t\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n   121\t\tRunDir     string            `json:\"run_dir,omitempty\"`\r\n   122\t\tVariables  map[string]string `json:\"variables,omitempty\"`\r\n   123\t}\r\n"]
[3057.837007, "o", "   124\t\r\n   125\ttype Checkpoint struct {\r\n   126\t\tRunID      string            `json:\"run_id\"`\r\n   127\t\tStatus     string            `json:\"status\"`\r\n   128\t\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n   129\t\tSteps      []*StepRun        `json:\"steps\"`\r\n   130\t\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n   131\t\tVariables  map[string]string `json:\"variables,omitempty\"`\r\n   132\t}\r\n"]
[3057.837132, "o", "   133\t\r\n   134\tfunc loadPipelineConfig(path string) (*PipelineConfig, error) {\r\n   135\t\tdata, err := os.ReadFile(path)\r\n   136\t\tif err != nil {\r\n   137\t\t\treturn nil, fmt.Errorf(\"read pipeline config: %w\", err)\r\n   138\t\t}\r\n   139\t\tvar cfg PipelineConfig\r\n   140\t\tif err := json.Unmarshal(data, &cfg); err != nil {\r\n   141\t\t\treturn nil, fmt.Errorf(\"parse pipeline config: %w\", err)\r\n   142\t\t}\r\n   143\t\tif cfg.MaxParallel <= 0 {\r\n   144\t\t\tcfg.MaxParallel = 4\r\n   145\t\t}\r\n"]
[3057.837196, "o", "   146\t\treturn &cfg, nil\r\n   147\t}\r\n   148\t\r\n   149\tfunc validatePipelineConfig(cfg *PipelineConfig) error {\r\n   150\t\tif cfg.Name == \"\" {\r\n   151\t\t\treturn fmt.Errorf(\"pipeline name is required\")\r\n   152\t\t}\r\n   153\t\tif len(cfg.Steps) == 0 {\r\n   154\t\t\treturn fmt.Errorf(\"pipeline must have at least one step\")\r\n   155\t\t}\r\n"]
[3057.837261, "o", "   156\t\r\n   157\t\tnames := make(map[string]bool)\r\n   158\t\tfor _, step := range cfg.Steps {\r\n   159\t\t\tif step.Name == \"\" {\r\n   160\t\t\t\treturn fmt.Errorf(\"step name is required\")\r\n   161\t\t\t}\r\n   162\t\t\tif names[step.Name] {\r\n   163\t\t\t\treturn fmt.Errorf(\"duplicate step name: %s\", step.Name)\r\n"]
[3057.837323, "o", "   164\t\t\t}\r\n   165\t\t\tnames[step.Name] = true\r\n   166\t\t\tswitch step.Type {\r\n   167\t\t\tcase \"shell\", \"train\", \"evaluate\":\r\n   168\t\t\tdefault:\r\n   169\t\t\t\treturn fmt.Errorf(\"step %s has invalid type: %s\", step.Name, step.Type)\r\n   170\t\t\t}\r\n   171\t\t\tif step.Command == \"\" {\r\n   172\t"]
[3057.837406, "o", "\t\t\treturn fmt.Errorf(\"step %s command is required\", step.Name)\r\n   173\t\t\t}\r\n   174\t\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n   175\t\t\t\tif step.Resources.CPU > cfg.ResourceLimit.CPU {\r\n   176\t\t\t\t\treturn fmt.Errorf(\"step %s cpu requirement %d exceeds pipeline limit %d\", step.Name, step.Resources.CPU, cfg.ResourceLimit.CPU)\r\n   177\t\t\t\t}\r\n   178\t\t\t\tif step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n   179\t\t\t\t\treturn fmt.Errorf(\"step %s memory requirement %d MB exceeds pipeline limit %d MB\", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)\r\n   180\t\t\t\t}\r\n"]
[3057.837474, "o", "   181\t\t\t}\r\n   182\t\t\tif step.Type == \"train\" && step.ExperimentConfig == nil {\r\n   183\t\t\t\treturn fmt.Errorf(\"train step %s requires experiment_config\", step.Name)\r\n   184\t\t\t}\r\n   185\t\t}\r\n"]
[3057.837566, "o", "   186\t\r\n   187\t\tfor _, step := range cfg.Steps {\r\n   188\t\t\tfor _, dep := range step.DependsOn {\r\n   189\t\t\t\tif !names[dep] {\r\n   190\t\t\t\t\treturn fmt.Errorf(\"step %s depends on unknown step %s\", step.Name, dep)\r\n   191\t\t\t\t}\r\n   192\t\t\t}\r\n   193\t\t}\r\n   194\t\r\n   195\t\t"]
[3057.837629, "o", "if cycle := findCycle(cfg.Steps); cycle != nil {\r\n   196\t\t\treturn fmt.Errorf(\"cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n   197\t\t}\r\n   198\t\r\n   199\t\tproducers := make(map[string]string)\r\n   200\t\tfor _, step := range cfg.Steps {\r\n   201\t\t\tfor _, out := range step.Outputs {\r\n   202\t\t\t\tif _, ok := producers[out]; ok {\r\n   203\t\t\t\t\treturn fmt.Errorf(\"duplicate output artifact: %s\", out)\r\n   204\t\t\t\t}\r\n   205\t\t\t\tproducers[out] = step.Name\r\n   206\t\t\t}\r\n   207\t\t}\r\n   208\t\r\n   209\t\tfor _, step := range cfg.Steps {\r\n"]
[3057.837693, "o", "   210\t\t\tfor _, in := range step.Inputs {\r\n   211\t\t\t\tprod, ok := producers[in]\r\n   212\t\t\t\tif !ok {\r\n   213\t\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s is not produced by any step\", step.Name, in)\r\n   214\t\t\t\t}\r\n   215\t\t\t\tif prod == step.Name {\r\n   216\t\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s must come from a dependency\", step.Name, in)"]
[3057.837751, "o", "\r\n   217\t\t\t\t}\r\n   218\t\t\t\tif !isTransitiveDependency(cfg.Steps, step.Name, prod) {\r\n   219\t\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s producer %s is not a transitive dependency\", step.Name, in, prod)\r\n   220\t\t\t\t}\r\n"]
[3057.838462, "o", "\u001b[?2004h"]
