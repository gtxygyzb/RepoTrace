[6245.907792, "o", "   600\t\t\t\tsr.Error = err.Error()\r\n   601\t\t\t\treturn\r\n   602\t\t\t}\r\n   603\t\t\tsr.ExperimentID = exp.ID\r\n   604\t\t}\r\n   605\t\r\n   606\t\tfor attempt := 0; attempt <= maxRetries; attempt++ {\r\n   607\t\t\tstart := time.Now()\r\n   608\t\t\tsr.StartTime = &start\r\n   609\t\t\tsr.RetryCount = attempt\r\n   610\t\t\tstdout, stderr, exitCode, err := runShellCommand(cmdStr, step.TimeoutSeconds, envVars)\r\n   611\t\t\tsr.Stdout = stdout\r\n   612\t\t\tsr.Output = stdout\r\n   613\t\t\tif stderr != \"\" {\r\n   614\t\t\t\tif sr.Output != \"\" {\r\n   615\t\t\t\t\tsr.Output += \"\\n\"\r\n   616\t\t\t\t}\r\n   617\t\t\t\tsr.Output += stderr\r\n   618\t\t\t}\r\n   619\t\t\tsr.ExitCode = exitCode\r\n   620\t\t\tif err == nil {\r\n   621\t\t\t\tsr.EndTime = nowPtr()\r\n"]
