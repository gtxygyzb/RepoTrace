[3500.765374, "o", "   319\t\t\tRunDir:     runDir,\r\n   320\t\t\tVariables:  copyMap(merged),\r\n   321\t\t\tWarnings:   []string{},\r\n   322\t\t\tSteps:      make([]*StepRun, 0, len(cfg.Steps)),\r\n   323\t\t}\r\n   324\t\tfor _, step := range cfg.Steps {\r\n   325\t\t\trun.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: \"pending\"})\r\n   326\t\t}\r\n   327\t\tsaveRun(run)\r\n"]
[3500.765463, "o", "   328\t\r\n   329\t\terr := executeSteps(cfg, run, tracker, merged, maxParallel)\r\n   330\t\tendTime := time.Now()\r\n   331\t\trun.EndTime = &endTime\r\n   332\t\tif err != nil {\r\n   333\t\t\trun.Status = \"failed\"\r\n   334\t\t} else if run.Status != \"succeeded_with_warnings\" {\r\n   335\t\t\trun.Status = \"succeeded\"\r\n"]
