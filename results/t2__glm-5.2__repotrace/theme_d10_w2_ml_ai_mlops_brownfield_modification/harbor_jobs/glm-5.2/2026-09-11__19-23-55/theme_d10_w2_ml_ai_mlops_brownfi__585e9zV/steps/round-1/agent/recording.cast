[227.858037, "i", "\"end_time,omitempty\"`\r\tSteps       []*StepRun        `json:\"steps\"`\r\tArtifacts   []Artifact        `json:\"artifacts,omitempty\"`\r\tRunDir      string            `json:\"run_dir,omitempty\"`\r}\r\rtype Checkpoint struct {\r\tRunID      string            `json:\"run_id\"`\r\tStatus     string            `json:\"status\"`\r\tParameters map[string]string `json:\"parameters,omitempty\"`\r\tSteps      []*StepRun        `json:\"steps\"`\r\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"\r}\r\rfunc loadPipelineConfig(path string) (*PipelineConfig, error) {\r\tdata, err := os.ReadFile(path)\r\tif err != nil {\r\t\treturn nil, fmt.Errorf(\"read pipeline config: %w\", err)\r\t}\r\tvar cfg PipelineConfig\r\tif err := json.Unmarshal(data, &cfg); err != nil {\r\t\treturn nil, fmt.Errorf(\"parse pipeline config: %w\", err)\r\t}\r\tif cfg.MaxParallel <= 0 {\r\t\tcfg.MaxParallel = 4\r\t}\r\treturn &cfg, nil\r}\r\rfunc validatePipelineConfig(cfg *PipelineConfig) error {\r\tif cfg.Name == \"\" {\r\t\treturn fmt.Errorf(\"pipeline name is required\")\r\t}\r\tif len(cfg.Steps) == 0 {\r\t\treturn fm"]
