[3500.494182, "o", "   112\t\r\n   113\ttype PipelineRun struct {\r\n   114\t\tID         string            `json:\"id\"`\r\n   115\t\tPipeline   string            `json:\"pipeline\"`\r\n   116\t\tStatus     string            `json:\"status\"`\r\n"]
[3500.494278, "o", "   117\t\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n   118\t\tStartTime  *time.Time        `json:\"start_time,omitempty\"`\r\n   119\t\tEndTime    *time.Time        `json:\"end_time,omitempty\"`\r\n   120\t\tSteps      []*StepRun        `json:\"steps\"`\r\n   121\t\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n   122\t\tRunDir     string            `json:\"run_dir,omitempty\"`\r\n   123\t\tVariables  map[string]string `json:\"variables,omitempty\"`\r\n   124\t\tWarnings   []string          `json:\"warnings\"`\r\n   125\t}\r\n   126\t\r\n   127\ttype Checkpoint struct {\r\n   128\t\tRunID      string            `json:\"run_id\"`\r\n   129\t\tStatus     string            `json:\"status\"`\r\n"]
[3500.494369, "o", "   130\t\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n   131\t\tSteps      []*StepRun        `json:\"steps\"`\r\n   132\t\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n   133\t\tVariables  map[string]string `json:\"variables,omitempty\"`\r\n   134\t\tWarnings   []string          `json:\"warnings\"`\r\n   135\t}\r\n   136\t\r\n   137\tfunc loadPipelineConfig(path string) (*PipelineConfig, error) {\r\n   138\t\tdata, err := os.ReadFile(path)\r\n   139\t\tif err != nil {\r\n   140\t\t\treturn nil, fmt.Errorf(\"read pipeline config: %w\", err)\r\n"]
