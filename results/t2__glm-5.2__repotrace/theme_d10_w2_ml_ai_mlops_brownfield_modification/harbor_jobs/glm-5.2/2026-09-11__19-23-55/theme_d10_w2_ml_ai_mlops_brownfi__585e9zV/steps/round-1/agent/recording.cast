[3058.106669, "o", "   487\tfunc executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {\r\n   488\t\tfor _, dep := range step.DependsOn {\r\n   489\t\t\tdepStatus := getRunStep(run, dep).Status\r\n   490\t\t\tif depStatus != \"succeeded\" && depStatus != \"skipped\" {\r\n   491\t\t\t\tsr.Status = \"failed\"\r\n   492\t\t\t\tsr.Error = \"dependency failed\"\r\n   493\t\t\t\treturn\r\n   494\t\t\t}\r\n"]
