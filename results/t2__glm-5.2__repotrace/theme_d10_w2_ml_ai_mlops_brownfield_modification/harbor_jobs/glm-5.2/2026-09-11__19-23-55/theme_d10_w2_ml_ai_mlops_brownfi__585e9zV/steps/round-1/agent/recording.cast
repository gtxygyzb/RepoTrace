[2183.925724, "o", "\\t\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[2183.92578, "o", "\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\rp["]
[2183.925836, "o", "\u001b[?2004h> "]
[2183.925892, "o", "\\t\\t\\tdepsKnown := true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.926026, "o", "\\t\\t\\tfor _, dep := range step.DependsOn {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.926132, "o", "\\t\\t\\t\\tif !assigned[dep] {\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[2183.926238, "o", "\\t\\t\\t\\t\\tdepsKnown = false\r\n\u001b[?2004l\r"]
[2183.92626, "o", "\u001b[?2004h> "]
[2183.926324, "o", "\\t\\t\\t\\t\\tbreak\r\n\u001b[?2004l\r\u001b[?2004h"]
[2183.926345, "o", "> "]
[2183.926366, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r"]
[2183.926388, "o", "\u001b[?2004h> "]
[2183.92643, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.926509, "o", "\\t\\t\\tif !depsKnown {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.926569, "o", "\\t\\t\\t\\tcontinue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.926614, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.926635, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
