[6334.363535, "o", "   348\tfunc executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n   349\t\tstepByName := make(map[string]*PipelineStep)\r\n   350\t\tfor _, s := range cfg.Steps {\r\n   351\t\t\tstepByName[s.Name] = s\r\n   352\t\t}\r\n   353\t\trunStepByName := make(map[string]*StepRun)\r\n   354\t\tfor _, sr := range run.Steps {\r\n"]
[6334.363629, "o", "   355\t\t\trunStepByName[sr.Name] = sr\r\n   356\t\t}\r\n   357\t\r\n   358\t\tvariables := make(map[string]string)\r\n   359\t\tif run.Variables != nil {\r\n   360\t\t\tfor k, v := range run.Variables {\r\n   361\t\t\t\tvariables[k] = v\r\n   362\t\t\t}\r\n   363\t\t} else {\r\n   364\t\t\tfor k, v := range params {\r\n   365\t\t\t\tvariables[k] = v\r\n   366\t\t\t}\r\n   367\t\t}\r\n   368\t\t"]
[6334.363702, "o", "if run.Warnings == nil {\r\n   369\t\t\trun.Warnings = []string{}\r\n   370\t\t}\r\n   371\t\r\n   372\t\tvar varMu sync.Mutex\r\n   373\t\r\n   374\t\tfor _, step := range cfg.Steps {\r\n   375\t\t\tsr := runStepByName[step.Name]\r\n   376\t\t\tif sr != nil && (sr.Status == \"succeeded\" || sr.Status == \"skipped\") {\r\n   377\t\t\t\tvariables[\"steps.\"+step.Name+\".status\"] = sr.Status\r\n   378\t\t\t\tvariables[\"steps.\"+step.Name+\".output\"] = stepRunOutputValue(sr)\r\n"]
[6334.363766, "o", "   379\t\t\t\tvariables[\"steps.\"+step.Name+\".duration\"] = stepRunDurationValue(sr)\r\n   380\t\t\t}\r\n   381\t\t}\r\n   382\t\r\n   383\t\tvar mu sync.Mutex\r\n   384\t\tvar running []*PipelineStep\r\n   385\t\tavailable := make(chan struct{}, maxParallel)\r\n   386\t\r\n   387\t\tpending := make(map[string]bool)\r\n   388\t\tfor _, step := range cfg.Steps {\r\n"]
[6334.363836, "o", "   389\t\t\tsr := runStepByName[step.Name]\r\n   390\t\t\tif sr.Status == \"succeeded\" || sr.Status == \"skipped\" {\r\n   391\t\t\t\tcontinue\r\n   392\t\t\t}\r\n   393\t\t\tif sr.Status == \"failed\" {\r\n   394\t\t\t\tsr.Status = \"pending\"\r\n"]
[6334.3639, "o", "   395\t\t\t\tsr.Error = \"\"\r\n   396\t\t\t\tsr.Output = \"\"\r\n   397\t\t\t\tsr.StartTime = nil\r\n   398\t\t\t\tsr.EndTime = nil\r\n   399\t\t\t}\r\n   400\t\t\tpending[step.Name] = true\r\n   401\t\t}\r\n   402\t\r\n   403\t\tvar wg sync.WaitGroup\r\n   404\t\tdone := false\r\n"]
[6334.363961, "o", "   405\t\r\n   406\t\tcanStart := func(step *PipelineStep) bool {\r\n   407\t\t\tfor _, dep := range step.DependsOn {\r\n   408\t\t\t\tstatus := runStepByName[dep].Status\r\n   409\t\t\t\tif status == \"succeeded\" || status == \"skipped\" {\r\n   410\t\t\t\t\tcontinue\r\n   411\t\t\t\t}\r\n   412\t\t\t\tif status == \"failed\" {\r\n   413\t\t\t\t\tif depStep := stepByName[dep]; depStep != nil && depStep.AllowFailure {\r\n   414\t\t\t\t\t\tcontinue\r\n   415\t\t\t\t\t}\r\n   416\t\t\t\t}\r\n   417\t\t\t\treturn false\r\n"]
[6334.364022, "o", "   418\t\t\t}\r\n   419\t\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n   420\t\t\t\tvar cpu, mem int\r\n   421\t\t\t\tfor _, r := range running {\r\n   422\t\t\t\t\tif r.Resources != nil {\r\n   423\t\t\t\t\t\tcpu += r.Resources.CPU\r\n   424\t\t\t\t\t\tmem += r.Resources.MemoryMB\r\n   425\t\t\t\t\t}\r\n   426\t"]
[6334.364124, "o", "\t\t\t}\r\n   427\t\t\t\tif cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n   428\t\t\t\t\treturn false\r\n   429\t\t\t\t}\r\n   430\t\t\t}\r\n   431\t\t\treturn true\r\n   432\t\t}\r\n   433\t\r\n"]
[6334.364187, "o", "   434\t\tstartStep := func(step *PipelineStep) {\r\n   435\t\t\tpending[step.Name] = false\r\n   436\t\t\trunning = append(running, step)\r\n   437\t\t\twg.Add(1)\r\n   438\t\t\tgo func(s *PipelineStep) {\r\n   439\t\t\t\tdefer wg.Done()\r\n   440\t\t\t\texecuteStep(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])\r\n   441\t\t\t\tmu.Lock()\r\n   442\t\t\t\trunning = removeStep(running, s)\r\n   443\t\t\t\tstatus := runStepByName[s.Name].Status\r\n   444\t\t\t\tif status == \"failed\" {\r\n   445\t\t\t\t\tif s.AllowFailure {\r\n   446\t\t\t\t\t\t"]
[6334.364253, "o", "if !containsString(run.Warnings, s.Name) {\r\n   447\t\t\t\t\t\t\trun.Warnings = append(run.Warnings, s.Name)\r\n   448\t\t\t\t\t\t}\r\n   449\t\t\t\t\t} else {\r\n   450\t\t\t\t\t\trun.Status = \"failed\"\r\n   451\t\t\t\t\t\tdone = true\r\n   452\t\t\t\t\t}\r\n   453\t\t\t\t}\r\n   454\t\t\t\tvarMu.Lock()\r\n"]
[6334.364315, "o", "   455\t\t\t\tvariables[\"steps.\"+s.Name+\".status\"] = status\r\n"]
