[4538.722137, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K395\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif a == \"--param\" \u001b[01;31m\u001b[K&&\u001b[m\u001b[K i+1 < len(args) {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif a == \"--max-parallel\" \u001b[01;31m\u001b[K&&\u001b[m\u001b[K i+1 < len(args) {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif strings.HasPrefix(a, \"--param=\") \u001b[01;31m\u001b[K||\u001b[m\u001b[K strings.HasPrefix(a, \"--max-parallel=\") {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif configPath == \"\" \u001b[01;31m\u001b[K&&\u001b[m\u001b[K !strings.HasPrefix(a, \"--\") {\r\n"]
