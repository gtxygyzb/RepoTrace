[1424.247888, "o", "\t\tstatus := ExperimentStatus(getFlag(args, \"--status\", \"completed\"))\r\n\t\tif err := tracker.Complete(args[1], status); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(\"Experiment completed\")\r\n\r\n\tcase \"compare\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"experiment IDs required (comma-separated)\")\r\n\t\t\tos.Exit(1)\r\n"]
[1424.247944, "o", "\t\t}\r\n\t\tids := strings.Split(args[1], \",\")\r\n\t\tresult, err := tracker.CompareExperiments(ids)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(result)\r\n\r\n\tcase \"export\":\r\n"]
[1424.248002, "o", "\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"output path required\")\r\n\t\t\tos.Exit(1)\r\n"]
