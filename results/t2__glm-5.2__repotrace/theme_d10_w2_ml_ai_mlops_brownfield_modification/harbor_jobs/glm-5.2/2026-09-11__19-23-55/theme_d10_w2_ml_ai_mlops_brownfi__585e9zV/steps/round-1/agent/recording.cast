[6744.502975, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[6744.503086, "o", "\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nconst dataDir = \"/tmp/nexus\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tstore, err := NewStore(dataDir)\r\n"]
[6744.503164, "o", "\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tregistry := NewRegistry(store)\r\n\ttracker := NewTracker(store)\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"model\":\r\n\t\thandleModel(registry, os.Args[2:])\r\n\tcase \"experiment\":\r\n\t\thandleExperiment(tracker, os.Args[2:])\r\n\tcase \"pipeline\":\r\n"]
[6744.503237, "o", "\t\thandlePipeline(store, tracker, os.Args[2:])\r\n\tcase \"dataset\":\r\n\t\thandleDataset(store, os.Args[2:])\r\n\tcase \"search\":\r\n\t\thandleSearch(store, os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"Unknown command: %s\\n\", os.Args[1])\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc printUsage() {\r\n"]
[6744.503303, "o", "\tfmt.Println(\"nexus - ML Model & Experiment Management\")\r\n\tfmt.Println()\r\n\tfmt.Println(\"Commands:\")\r\n\tfmt.Println(\"  model register <name> [--version V] [--framework F] [--description D] [--tags t1,t2]\")\r\n\tfmt.Println(\"  model list [--filter F]\")\r\n\tfmt.Println(\"  model get <name> <version>\")\r\n\tfmt.Println(\"  model promote <name> <version> <status>\")\r\n\tfmt.Println(\"  model delete <name> <version>\")\r\n\tfmt.Println(\"  model compare <name>\")\r\n\tfmt.Println(\"  experiment create <name> [--params k1=v1,k2=v2] [--tags t1,t2]\")\r\n\tfmt.Println(\"  experiment list [--filter F]\")\r\n"]
[6744.503368, "o", "\tfmt.Println(\"  experiment get <id>\")\r\n\tfmt.Println(\"  experiment log-metric <id> <key> <value>\")\r\n\tfmt.Println(\"  experiment complete <id> [--status completed|failed]\")\r\n\tfmt.Println(\"  experiment compare <id1,id2,...>\")\r\n\tfmt.Println(\"  experiment export <output-path> [--format json|csv]\")\r\n\tfmt.Println(\"  dataset register <name> <version> <format> <path> [--rows N]\")\r\n\tfmt.Println(\"  dataset list\")\r\n\tfmt.Println(\"  dataset get <name> <version>\")\r\n\tfmt.Println(\"  search --tag <tag>\")\r\n\tfmt.Println(\"  pipeline validate <config.json>\")\r\n"]
[6744.503429, "o", "\tfmt.Println(\"  pipeline run [--dry-run] <config.json> [--param key=value ...] [--max-parallel N]\")\r\n\tfmt.Println(\"  pipeline graph <config.json>\")\r\n\tfmt.Println(\"  pipeline history <pipeline-name> [--status <status>] [--tag <tag>]\")\r\n\tfmt.Println(\"  pipeline status <run-id>\")\r\n\tfmt.Println(\"  pipeline list\")\r\n\tfmt.Println(\"  pipeline artifacts <run-id>\")\r\n\tfmt.Println(\"  pipeline resume <run-id>\")\r\n}\r\n\r\nfunc handleModel(reg *Registry, args []string) {\r\n\tif len(args) < 1 {\r\n"]
[6744.503535, "o", "\t\tfmt.Fprintln(os.Stderr, \"model subcommand required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch args[0] {\r\n\tcase \"register\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tname := args[1]\r\n\t\tversion := getFlag(args, \"--version\", \"\")\r\n\t\tframework := getFlag(args, \"--framework\", \"unknown\")\r\n\t\tdescription := getFlag(args, \"--description\", \"\")\r\n\t\ttagsStr := getFlag(args, \"--tags\", \"\")\r\n\t\tvar tags []string\r\n\t"]
[6744.503594, "o", "\tif tagsStr != \"\" {\r\n\t\t\ttags = strings.Split(tagsStr, \",\")\r\n\t\t}\r\n\r\n\t\tm, err := reg.Register(name, version, framework, description, tags)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n"]
[6744.503673, "o", "\t\t}\r\n\t\tprintJSON(m)\r\n\r\n\tcase \"list\":\r\n\t\tfilter := getFlag(args, \"--filter\", \"\")\r\n\t\tmodels := reg.store.ListModels(filter)\r\n\t\tprintJSON(models)\r\n\r\n\tcase \"get\":\r\n\t\tif len(args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name and version required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tm, err := reg.store.GetModel(args[1], args[2])\r\n\t\t"]
[6744.50373, "o", "if err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(m)\r\n\r\n\tcase \"promote\":\r\n\t\tif len(args) < 4 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name, version, and target status required\")\r\n"]
[6744.503786, "o", "\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\terr := reg.Promote(args[1], args[2], ModelStatus(args[3]))\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(\"Model promoted successfully\")\r\n"]
[6744.503844, "o", "\r\n\tcase \"delete\":\r\n\t\tif len(args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name and version required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tif err := reg.store.DeleteModel(args[1], args[2]); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\t"]
[6744.503901, "o", "fmt.Println(\"Model deleted successfully\")\r\n\r\n\tcase \"compare\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tmodels, err := reg.Compare(args[1])\r\n\t"]
[6744.503958, "o", "\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(models)\r\n\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"Unknown model subcommand: %s\\n\", args[0])\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n"]
[6744.504013, "o", "\r\nfunc handleExperiment(tracker *Tracker, args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"experiment subcommand required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch args[0] {\r\n\tcase \"create\":\r\n\t\tif len(args) < 2 {\r\n"]
[6744.5041, "o", "\t\t\tfmt.Fprintln(os.Stderr, \"experiment name required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tname := args[1]\r\n\t\tparamsStr := getFlag(args, \"--params\", \"\")\r\n\t\ttagsStr := getFlag(args, \"--tags\", \"\")\r\n\r\n\t\tparams := make(map[string]string)\r\n\t\tif paramsStr != \"\" {\r\n\t\t\tfor _, p := range strings.Split(paramsStr, \",\") {\r\n\t\t\t\tkv := strings.SplitN(p, \"=\", 2)\r\n\t\t\t\tif len(kv) == 2 {\r\n\t\t\t\t\tparams[kv[0]] = kv[1]\r\n\t\t\t\t}\r\n\t"]
[6744.504164, "o", "\t\t}\r\n\t\t}\r\n\r\n\t\tvar tags []string\r\n\t\tif tagsStr != \"\" {\r\n\t\t\ttags = strings.Split(tagsStr, \",\")\r\n\t\t}\r\n\r\n\t\texp, err := tracker.Create(name, params, tags)\r\n"]
[6744.504221, "o", "\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(exp)\r\n\r\n\tcase \"list\":\r\n\t\tfilter := getFlag(args, \"--filter\", \"\")\r\n\t\texps := tracker.store.ListExperiments(filter)\r\n\t\tprintJSON(exps)\r\n"]
[6744.504283, "o", "\r\n\tcase \"get\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"experiment ID required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\texp, err := tracker.store.GetExperiment(args[1])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(exp)\r\n"]
[6744.504342, "o", "\r\n"]
[6744.504888, "o", "\u001b[?2004h"]
[6744.504965, "o", "root@n30009:/app# "]
[6744.782896, "i", "sed -n '1,260p' pipeline.go\n"]
[6744.7832, "o", "sed -n '1,260p' pipeline.go\r\n"]
[6744.783286, "o", "\u001b[?2004l\r"]
[6744.786153, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[6744.786239, "o", "\t\"math\"\r\n\t\"os\"\r\n\t\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\nconst pipelineRunsDir = \"/tmp/nexus/runs\"\r\n\r\ntype PipelineResourceLimit struct {\r\n\tCPU      int `json:\"cpu,omitempty\"`\r\n"]
[6744.786312, "o", "\tMemoryMB int `json:\"memory_mb,omitempty\"`\r\n}\r\n\r\ntype PipelineStepResources struct {\r\n\tCPU      int `json:\"cpu,omitempty\"`\r\n\tMemoryMB int `json:\"memory_mb,omitempty\"`\r\n}\r\n\r\ntype PipelineStepRetry struct {\r\n\tMaxRetries         int `json:\"max_retries,omitempty\"`\r\n\tBackoffBaseSeconds int `json:\"backoff_base_seconds,omitempty\"`\r\n}\r\n\r\n"]
[6744.786376, "o", "type CaptureOutputConfig struct {\r\n\tName  string `json:\"name\"`\r\n\tRegex string `json:\"regex,omitempty\"`\r\n}\r\n\r\nfunc (c *CaptureOutputConfig) UnmarshalJSON(data []byte) error {\r\n\tvar str string\r\n\tif err := json.Unmarshal(data, &str); err == nil {\r\n\t\tc.Name = str\r\n\t\tc.Regex = \"\"\r\n\t\treturn nil\r\n\t}\r\n"]
[6744.786443, "o", "\tvar raw struct {\r\n\t\tName  string `json:\"name\"`\r\n\t\tRegex string `json:\"regex\"`\r\n\t}\r\n\tif err := json.Unmarshal(data, &raw); err != nil {\r\n\t\treturn fmt.Errorf(\"capture_output must be a string or an object with name and optional regex\")\r\n\t}\r\n\tc.Name = raw.Name\r\n\tc.Regex = raw.Regex\r\n"]
[6744.786503, "o", "\treturn nil\r\n}\r\n\r\ntype PipelineExperimentConfig struct {\r\n\tName    string            `json:\"name,omitempty\"`\r\n\tParams  map[string]string `json:\"params,omitempty\"`\r\n\tMetrics []string          `json:\"metrics,omitempty\"`\r\n}\r\n\r\ntype PipelineStep struct {\r\n\tName             string                    `json:\"name\"`\r\n"]
[6744.786563, "o", "\tType             string                    `json:\"type\"`\r\n\tCommand          string                    `json:\"command\"`\r\n\tDependsOn        []string                  `json:\"depends_on,omitempty\"`\r\n\tInputs           []string                  `json:\"inputs,omitempty\"`\r\n\tOutputs          []string                  `json:\"outputs,omitempty\"`\r\n\tResources        *PipelineStepResources    `json:\"resources,omitempty\"`\r\n\tTimeoutSeconds   int                       `json:\"timeout_seconds,omitempty\"`\r\n\tRetry            *PipelineStepRetry        `json:\"retry,omitempty\"`\r\n"]
[6744.786626, "o", "\tCondition        string                    `json:\"condition,omitempty\"`\r\n\tExperimentConfig *PipelineExperimentConfig `json:\"experiment_config,omitempty\"`\r\n\tDatasetRef       string                    `json:\"dataset_ref,omitempty\"`\r\n\tCaptureOutput    *CaptureOutputConfig      `json:\"capture_output,omitempty\"`\r\n\tEnv              map[string]string         `json:\"env,omitempty\"`\r\n\tAllowFailure     bool                      `json:\"allow_failure,omitempty\"`\r\n}\r\n\r\ntype PipelineConfig struct {\r\n\tName          string                 `json:\"name\"`\r\n"]
[6744.786689, "o", "\tDescription   string                 `json:\"description,omitempty\"`\r\n\tTags          []string               `json:\"tags,omitempty\"`\r\n\tParameters    map[string]string      `json:\"parameters,omitempty\"`\r\n\tMaxParallel   int                    `json:\"max_parallel,omitempty\"`\r\n\tResourceLimit *PipelineResourceLimit `json:\"resource_limit,omitempty\"`\r\n\tSteps         []*PipelineStep        `json:\"steps\"`\r\n}\r\n\r\ntype Artifact struct {\r\n\tName     string `json:\"name\"`\r\n"]
[6744.786752, "o", "\tType     string `json:\"type\"`\r\n\tProducer string `json:\"producer\"`\r\n\tPath     string `json:\"path\"`\r\n\tSize     int64  `json:\"size\"`\r\n}\r\n\r\ntype RetryHistoryEntry struct {\r\n\tAttempt int    `json:\"attempt\"`\r\n\tError   string `json:\"error\"`\r\n}\r\n\r\ntype StepRun struct {\r\n"]
[6744.786812, "o", "\tName         string              `json:\"name\"`\r\n\tType         string              `json:\"type\"`\r\n\tStatus       string              `json:\"status\"`\r\n\tStartTime    *time.Time          `json:\"start_time,omitempty\"`\r\n\tEndTime      *time.Time          `json:\"end_time,omitempty\"`\r\n\tExitCode     int                 `json:\"exit_code,omitempty\"`\r\n\tStdout       string              `json:\"stdout,omitempty\"`\r\n\tOutput       string              `json:\"output,omitempty\"`\r\n\tError        string              `json:\"error,omitempty\"`\r\n"]
[6744.786875, "o", "\tArtifacts    []Artifact          `json:\"artifacts,omitempty\"`\r\n\tExperimentID string              `json:\"experiment_id,omitempty\"`\r\n\tRetryCount   int                 `json:\"retry_count\"`\r\n\tRetryHistory []RetryHistoryEntry `json:\"retry_history\"`\r\n}\r\n\r\ntype PipelineRun struct {\r\n\tID          string            `json:\"id\"`\r\n\tPipeline    string            `json:\"pipeline\"`\r\n\tStatus      string            `json:\"status\"`\r\n\tDescription string            `json:\"description\"`\r\n\t"]
[6744.786933, "o", "Tags        []string          `json:\"tags\"`\r\n\tParameters  map[string]string `json:\"parameters,omitempty\"`\r\n\tStartTime   *time.Time        `json:\"start_time,omitempty\"`\r\n\tEndTime     *time.Time        `json:\"end_time,omitempty\"`\r\n\tSteps       []*StepRun        `json:\"steps\"`\r\n\tArtifacts   []Artifact        `json:\"artifacts,omitempty\"`\r\n\tRunDir      string            `json:\"run_dir,omitempty\"`\r\n\tVariables   map[string]string `json:\"variables,omitempty\"`\r\n\tWarnings    []string          `json:\"warnings\"`\r\n}\r\n"]
[6744.786997, "o", "\r\ntype Checkpoint struct {\r\n\tRunID      string            `json:\"run_id\"`\r\n\tStatus     string            `json:\"status\"`\r\n\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n\tSteps      []*StepRun        `json:\"steps\"`\r\n\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n\tVariables  map[string]string `json:\"variables,omitempty\"`\r\n\tWarnings   []string          `json:\"warnings\"`\r\n}\r\n\r\nfunc loadPipelineConfig(path string) (*PipelineConfig, error) {\r\n\tdata, err := os.ReadFile(path)"]
[6744.787126, "o", "\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"read pipeline config: %w\", err)\r\n\t}\r\n\tvar cfg PipelineConfig\r\n\tif err := json.Unmarshal(data, &cfg); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"parse pipeline config: %w\", err)\r\n\t}\r\n\tif cfg.MaxParallel <= 0 {\r\n\t\tcfg.MaxParallel = 4\r\n\t}\r\n\treturn &cfg, nil\r\n}\r\n\r\nfunc validatePipelineConfig(cfg *PipelineConfig) error {\r\n\tif cfg.Name == \"\" {\r\n\t\treturn fmt.Errorf(\"pipeline name is required\")\r\n\t}\r\n\tif len(cfg.Steps) == 0 {\r\n\t\treturn fmt.Errorf(\"pipeline must have at least one step\")\r\n"]
[6744.787188, "o", "\t}\r\n\r\n\tnames := make(map[string]bool)\r\n\tfor _, step := range cfg.Steps {\r\n\t\tif step.Name == \"\" {\r\n\t\t\treturn fmt.Errorf(\"step name is required\")\r\n\t\t}\r\n\t\tif names[step.Name] {\r\n\t\t\treturn fmt.Errorf(\"duplicate step name: %s\", step.Name)\r\n\t\t}\r\n\t\t"]
[6744.787246, "o", "names[step.Name] = true\r\n\t\tswitch step.Type {\r\n\t\tcase \"shell\", \"train\", \"evaluate\":\r\n\t\tdefault:\r\n\t\t\treturn fmt.Errorf(\"step %s has invalid type: %s\", step.Name, step.Type)\r\n\t\t}\r\n\t\tif step.Command == \"\" {\r\n\t\t\treturn fmt.Errorf(\"step %s command is required\", step.Name)\r\n"]
[6744.787305, "o", "\t\t}\r\n\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n\t\t\tif step.Resources.CPU > cfg.ResourceLimit.CPU {\r\n\t\t\t\treturn fmt.Errorf(\"step %s cpu requirement %d exceeds pipeline limit %d\", step.Name, step.Resources.CPU, cfg.ResourceLimit.CPU)\r\n\t\t\t}\r\n\t\t\tif step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n\t\t\t\treturn fmt.Errorf(\"step %s memory requirement %d MB exceeds pipeline limit %d MB\", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)\r\n\t\t\t}\r\n"]
[6744.787359, "o", "\t\t}\r\n\t\tif step.Type == \"train\" && step.ExperimentConfig == nil {\r\n\t\t\treturn fmt.Errorf(\"train step %s requires experiment_config\", step.Name)\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, step := range cfg.Steps {\r\n\t\tfor _, dep := range step.DependsOn {\r\n\t"]
[6744.787418, "o", "\t\tif !names[dep] {\r\n\t\t\t\treturn fmt.Errorf(\"step %s depends on unknown step %s\", step.Name, dep)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif cycle := findCycle(cfg.Steps); cycle != nil {\r\n\t\treturn fmt.Errorf(\"cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n\t}\r\n"]
[6744.787474, "o", "\r\n\tproducers := make(map[string]string)\r\n\tfor _, step := range cfg.Steps {\r\n\t\tfor _, out := range step.Outputs {\r\n\t\t\tif _, ok := producers[out]; ok {\r\n\t\t\t\treturn fmt.Errorf(\"duplicate output artifact: %s\", out)\r\n\t\t\t}\r\n\t\t"]
[6744.787537, "o", "\tproducers[out] = step.Name\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, step := range cfg.Steps {\r\n\t\tfor _, in := range step.Inputs {\r\n\t\t\tprod, ok := producers[in]\r\n\t\t\tif !ok {\r\n\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s is not produced by any step\", step.Name, in)\r\n\t\t\t}\r\n\t\t"]
[6744.787598, "o", "\tif prod == step.Name {\r\n\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s must come from a dependency\", step.Name, in)\r\n\t\t\t}\r\n\t\t\tif !isTransitiveDependency(cfg.Steps, step.Name, prod) {\r\n\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s producer %s is not a transitive dependency\", step.Name, in, prod)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[6744.787658, "o", "\treturn nil\r\n}\r\n\r\nfunc findCycle(steps []*PipelineStep) []string {\r\n\tgraph := make(map[string][]string)\r\n\tfor _, s := range steps {\r\n\t\tgraph[s.Name] = append(graph[s.Name], s.DependsOn...)\r\n\t}\r\n\tvisited := make(map[string]int)\r\n\tvar stack []string\r\n\tvar dfs func(node string) []string\r\n"]
[6744.787718, "o", "\tdfs = func(node string) []string {\r\n\t\tvisited[node] = 1\r\n\t\tstack = append(stack, node)\r\n\t\tfor _, dep := range graph[node] {\r\n\t\t\tif visited[dep] == 1 {\r\n\t\t\t\tfor i, n := range stack {\r\n\t\t\t\t\tif n == dep {\r\n\t\t\t\t\t\treturn append(append([]string{}, stack[i:]...), dep)\r\n\t"]
[6744.787773, "o", "\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\treturn []string{node, dep}\r\n\t\t\t}\r\n\t\t\tif visited[dep] == 0 {\r\n"]
[6744.788481, "o", "\u001b[?2004h"]
