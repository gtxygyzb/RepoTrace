[6800.644077, "o", "\r\nfunc handlePipeline(store *Store, tracker *Tracker, args []string) {\r\n"]
[6800.644163, "o", "\tif len(args) < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"pipeline subcommand required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch args[0] {\r\n\tcase \"validate\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"pipeline config path required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tcfg, err := loadPipelineConfig(args[1])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t"]
[6800.644228, "o", "\tos.Exit(1)\r\n\t\t}\r\n\t\tif err := validatePipelineConfig(cfg); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(\"Pipeline is valid\")\r\n\r\n\tcase \"run\":\r\n"]
[6800.64429, "o", "\t\tdryRun := false\r\n\t\tvar configPath string\r\n\t\tfor i := 1; i < len(args); i++ {\r\n\t\t\ta := args[i]\r\n\t\t\tif a == \"--dry-run\" {\r\n\t\t\t\tdryRun = true\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif a == \"--param\" && i+1 < len(args) {\r\n"]
[6800.644351, "o", "\t\t\t\ti++\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif a == \"--max-parallel\" && i+1 < len(args) {\r\n\t\t\t\ti++\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif strings.HasPrefix(a, \"--param=\") || strings.HasPrefix(a, \"--max-parallel=\") {\r\n"]
[6800.644412, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif configPath == \"\" && !strings.HasPrefix(a, \"--\") {\r\n\t\t\t\tconfigPath = a\r\n\t\t\t}\r\n\t\t}\r\n\t\tif configPath == \"\" {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"pipeline config path required\")\r\n\t\t\tos.Exit(1)\r\n"]
[6800.644475, "o", "\t\t}\r\n\t\tcfg, err := loadPipelineConfig(configPath)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tparams := parsePipelineParams(args[1:])\r\n\t\tif dryRun {\r\n\t\t\tplan, err := dryRunPipeline(cfg, params)\r\n\t\t\tif err != nil {\r\n\t"]
[6800.644545, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tprintJSON(plan)\r\n\t\t\treturn\r\n\t\t}\r\n\t\tmaxParallel := 0\r\n\t\tif v := getFlag(args[1:], \"--max-parallel\", \"\"); v != \"\" {\r\n"]
[6800.644617, "o", "\t\t\tif n, err := strconv.Atoi(v); err == nil {\r\n\t\t\t\tmaxParallel = n\r\n\t\t\t}\r\n\t\t}\r\n\t\trun, err := runPipeline(cfg, tracker, params, maxParallel)\r\n\t\tif run != nil {\r\n\t\t\tprintJSON(run)\r\n\t\t}\r\n\t\tif err != nil {\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\r\n"]
[6800.644678, "o", "\tcase \"graph\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"pipeline config path required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tcfg, err := loadPipelineConfig(args[1])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n"]
[6800.644737, "o", "\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tif err := validatePipelineConfig(cfg); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(buildPipelineGraph(cfg))\r\n\r\n\tcase \"history\":\r\n\t\tif len(args) < 2 {\r\n"]
[6800.6448, "o", "\t\t\tfmt.Fprintln(os.Stderr, \"pipeline name required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tstatus := getFlag(args[2:], \"--status\", \"\")\r\n\t\ttag := getFlag(args[2:], \"--tag\", \"\")\r\n\t\tprintJSON(pipelineHistory(args[1], status, tag))\r\n\r\n\tcase \"status\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"run-id required\")\r\n"]
[6800.644867, "o", "\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\trun, err := loadRun(args[1])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t"]
[6800.64493, "o", "\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(run)\r\n\r\n\tcase \"list\":\r\n"]
