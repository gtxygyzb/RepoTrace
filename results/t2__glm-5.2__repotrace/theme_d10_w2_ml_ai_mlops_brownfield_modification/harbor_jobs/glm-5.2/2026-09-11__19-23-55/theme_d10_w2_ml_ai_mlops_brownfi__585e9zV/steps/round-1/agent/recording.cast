[3546.268513, "o", "\t}\r\n   948\t\tcpPath := filepath.Join(run.RunDir, \"checkpoint.json\")\r\n   949\t\tcpData, err := os.ReadFile(cpPath)\r\n   950\t\tif err == nil {\r\n   951\t\t\tvar cp Checkpoint\r\n   952\t\t\tif json.Unmarshal(cpData, &cp) == nil {\r\n   953\t\t\t\trun.Status = cp.Status\r\n   954\t\t\t\trun.Parameters = cp.Parameters\r\n   955\t\t\t\trun.Steps = cp.Steps\r\n   956\t\t\t\trun.Artifacts = cp.Artifacts\r\n   957\t\t\t}\r\n   958\t\t}\r\n   959\t\r\n   960\t\tcfgPath := filepath.Join(run.RunDir, \"pipeline_config.json\")\r\n   961\t\tvar cfg *PipelineConfig\r\n   962\t\tif cfgData, err := os.ReadFile(cfgPath); err == nil {\r\n   963\t\t\tvar c PipelineConfig\r\n   964\t\t"]
