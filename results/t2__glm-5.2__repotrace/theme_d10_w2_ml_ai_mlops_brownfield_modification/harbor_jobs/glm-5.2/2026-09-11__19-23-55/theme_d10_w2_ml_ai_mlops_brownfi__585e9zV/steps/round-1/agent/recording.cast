[5837.993574, "o", "func containsString(list []string, s string) bool {\r\n\tfor _, x := range list {\r\n\t\tif x == s {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n"]
[5837.993672, "o", "}\r\n\r\nfunc saveRun(run *PipelineRun) {\r\n\tif err := os.MkdirAll(run.RunDir, 0755); err != nil {\r\n\t\treturn\r\n\t}\r\n\tdata, err := json.MarshalIndent(run, \"\", \"  \")\r\n\tif err == nil {\r\n\t\tos.WriteFile(filepath.Join(run.RunDir, \"run.json\"), data, 0644)\r\n\t}\r\n}\r\n\r\nfunc saveCheckpoint(run *PipelineRun) {\r\n\tif err := os.MkdirAll(run.RunDir, 0755); err != nil {\r\n\t\treturn\r\n\t"]
[5837.993769, "o", "}\r\n\tcp := &Checkpoint{\r\n\t\tRunID:      run.ID,\r\n\t\tStatus:     run.Status,\r\n\t\tParameters: run.Parameters,\r\n\t\tSteps:      run.Steps,\r\n\t\tArtifacts:  run.Artifacts,\r\n\t\tVariables:  run.Variables,\r\n\t\tWarnings:   run.Warnings,\r\n\t}\r\n\tdata, err := json.MarshalIndent(cp, \"\", \"  \")\r\n\tif err == nil {\r\n\t\tos.WriteFile(filepath.Join(run.RunDir, \"checkpoint.json\"), data, 0644)\r\n\t}\r\n"]
[5837.993848, "o", "}\r\n\r\nfunc loadRun(runID string) (*PipelineRun, error) {\r\n\tpath := filepath.Join(pipelineRunsDir, runID, \"run.json\")\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"load run: %w\", err)\r\n\t}\r\n\tvar run PipelineRun\r\n\tif err := json.Unmarshal(data, &run); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"parse run: %w\", err)\r\n\t}\r\n\treturn &run, nil\r\n}\r\n\r\n"]
[5837.993931, "o", "func listRuns() []*PipelineRun {\r\n\tentries, err := os.ReadDir(pipelineRunsDir)\r\n\tif err != nil {\r\n\t\treturn nil\r\n\t}\r\n\tvar runs []*PipelineRun\r\n\tfor _, entry := range entries {\r\n\t\tif !entry.IsDir() {\r\n\t\t\tcontinue\r\n\t\t"]
[5837.994014, "o", "}\r\n\t\trun, err := loadRun(entry.Name())\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\truns = append(runs, run)\r\n\t}\r\n\tsort.Slice(runs, func(i, j int) bool {\r\n\t\tif runs[i].StartTime == nil || runs[j].StartTime == nil {\r\n\t\t\treturn runs[i].ID < runs[j].ID\r\n\t\t}\r\n\t\treturn runs[i].StartTime.Before(*runs[j].StartTime)\r\n\t})\r\n\treturn runs\r\n}\r\n\r\nfunc resumePipeline(runID string, tracker *Tracker) (*PipelineRun, error) {\r\n"]
[5837.994103, "o", "\trun, err := loadRun(runID)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n"]
