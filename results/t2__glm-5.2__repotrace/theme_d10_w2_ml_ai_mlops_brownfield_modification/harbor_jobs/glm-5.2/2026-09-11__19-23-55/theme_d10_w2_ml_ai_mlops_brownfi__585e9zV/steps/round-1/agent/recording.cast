[1510.129559, "o", "   667\tfunc mergeParams(defaults, overrides map[string]string) map[string]string {\r\n   668\t\tmerged := make(map[string]string)\r\n   669\t\tfor k, v := range defaults {\r\n   670\t\t\tmerged[k] = v\r\n   671\t\t}\r\n   672\t\tfor k, v := range overrides {\r\n   673\t\t\tmerged[k] = v\r\n"]
[1510.129684, "o", "   674\t\t}\r\n   675\t\treturn merged\r\n   676\t}\r\n   677\t\r\n   678\tfunc substituteParams(command string, params map[string]string) string {\r\n   679\t\tresult := command\r\n   680\t\tfor k, v := range params {\r\n   681\t\t\tresult = strings.ReplaceAll(result, \"${\"+k+\"}\", v)\r\n   682\t\t}\r\n   683\t\treturn result\r\n   684\t}\r\n   685\t\r\n   686\tfunc evaluateCondition(cond string, params map[string]string) (bool, error) {\r\n   687\t\tcond = strings.TrimSpace(cond)\r\n   688\t\tif cond == \"\" {\r\n   689\t\t\treturn true, nil\r\n   690\t\t}\r\n   691\t\tif strings.Contains(cond, \"==\") {\r\n   692\t\t\tparts := strings.SplitN(cond, \"==\", 2)\r\n   693\t\t\tleft := resolveParam(strings.TrimSpace(parts[0]), params)\r\n   694\t\t"]
[1510.129767, "o", "\tright := resolveParam(strings.TrimSpace(parts[1]), params)\r\n   695\t\t\treturn left == right, nil\r\n   696\t\t}\r\n   697\t\tif strings.Contains(cond, \"!=\") {\r\n   698\t\t\tparts := strings.SplitN(cond, \"!=\", 2)\r\n   699\t\t\tleft := resolveParam(strings.TrimSpace(parts[0]), params)\r\n   700\t\t\t"]
[1510.129849, "o", "right := resolveParam(strings.TrimSpace(parts[1]), params)\r\n   701\t\t\treturn left != right, nil\r\n   702\t\t}\r\n   703\t\treturn false, fmt.Errorf(\"invalid condition: %s\", cond)\r\n   704\t}\r\n   705\t\r\n   706\tfunc resolveParam(token string, params map[string]string) string {\r\n   707\t\tre := regexp.MustCompile(`^\\$\\{(.+)\\}$`)\r\n   708\t\tm := re.FindStringSubmatch(token)\r\n   709\t\tif m != nil {\r\n   710\t\t\treturn params[m[1]]\r\n   711\t\t}\r\n   712\t\treturn token\r\n   713\t}\r\n   714\t\r\n   715\tfunc generateRunID() string {\r\n   716\t\treturn fmt.Sprintf(\"run-%d\", time.Now().UnixNano())\r\n   717\t}\r\n   718\t\r\n   719\tfunc nowPtr() *time.Time {\r\n   720\t"]
[1510.129924, "o", "\tt := time.Now()\r\n   721\t\treturn &t\r\n   722\t}\r\n   723\t\r\n   724\tfunc containsString(list []string, s string) bool {\r\n   725\t\tfor _, x := range list {\r\n   726\t\t\tif x == s {\r\n   727\t\t\t\treturn true\r\n   728\t\t\t}\r\n   729\t\t}\r\n   730\t\treturn false\r\n"]
