[2184.002943, "o", "\u001b[?2004h> "]
[2184.003201, "o", "\\tStatus          string     `json:\"status\"`\r\n\u001b[?2004l\r"]
[2184.003257, "o", "\u001b[?2004h> "]
[2184.003592, "o", "\\tStartTime       *time.Time `json:\"start_time,omitempty\"`\r\n\u001b[?2004l\r"]
[2184.003648, "o", "\u001b[?2004h> "]
[2184.003972, "o", "\\tEndTime         *time.Time `json:\"end_time,omitempty\"`\r\n\u001b[?2004l\r"]
[2184.004028, "o", "\u001b[?2004h> "]
[2184.004347, "o", "\\tDurationSeconds float64    `json:\"duration_seconds\"`\r\n\u001b[?2004l\r"]
[2184.004402, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
