[227.858429, "i", "if !isTransitiveDependency(cfg.Steps, step.Name, prod) {\r\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s producer %s is not a transitive dependency\", step.Name, in, prod)\r\t\t\t}\r\t\t}\r\t}\r\treturn nil\r}\r\rfunc findCycle(steps []*PipelineStep) []string {\r\tgraph := make(map[string][]string)\r\tfor _, s := range steps {\r\t\tgraph[s.Name] = append(graph[s.Name], s.DependsOn...)\r\t}\r\tvisited := make(map[string]int)\r\tvar stack []string\r\tvar dfs func(node string) []string\r\tdfs = func(node string) []string {\r\t\tvisited[node] = 1\r\t\tstack = append(stack, node)\r\t\tfor _, dep := range graph[node] {\r\t\t\tif visited[dep] == 1 {\r\t\t\t\tfor i, n := range stack {\r\t\t\t\t\tif n == dep {\r\t\t\t\t\t\treturn append(append([]string{}, stack[i:]...), dep)\r\t\t\t\t\t}\r\t\t\t\t}\r\t\t\t\treturn []string{node, dep}\r\t\t\t}\r\t\t\tif visited[dep] == 0 {\r\t\t\t\tif c := dfs(dep); c != nil {\r\t\t\t\t\treturn c\r\t\t\t\t}\r\t\t\t}\r\t\t}\r\t\tstack = stack[:len(stack)-1]\r\t\tvisited[node] = 2\r\t\treturn nil\r\t}\r\tfor _, s := range steps {\r\t\tif visited[s.Name] == 0 {\r\t\t\tif c := dfs(s.Name); c != nil {\r\t\t\t\treturn c\r\t\t"]
