[1076.812148, "o", "func finishTrainExperiment(tracker *Tracker, exp *Experiment, step *PipelineStep, output string) error {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1076.812286, "o", "\\tfor _, line := range strings.Split(output, \"\\n\") {\r\n\u001b[?2004l\r\u001b[?2004h"]
