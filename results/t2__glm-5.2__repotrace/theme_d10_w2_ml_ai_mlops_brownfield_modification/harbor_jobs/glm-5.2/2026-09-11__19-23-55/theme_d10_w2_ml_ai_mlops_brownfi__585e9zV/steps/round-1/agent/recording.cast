[5943.547815, "o", "\r\ntype PipelineHistoryEntry struct {\r\n\tID              string     `json:\"id\"`\r\n\tStatus          string     `json:\"status\"`\r\n\tDescription     string     `json:\"description\"`\r\n\tTags            []string   `json:\"tags\"`\r\n\tStartTime       *time.Time `json:\"start_time,omitempty\"`\r\n"]
[5943.547911, "o", "\tEndTime         *time.Time `json:\"end_time,omitempty\"`\r\n\tDurationSeconds float64    `json:\"duration_seconds\"`\r\n}\r\n\r\nfunc pipelineHistory(name, status, tag string) []PipelineHistoryEntry {\r\n\truns := listRuns()\r\n\tout := make([]PipelineHistoryEntry, 0)\r\n\tfor _, run := range runs {\r\n\t\tif run.Pipeline != name {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif status != \"\" && run.Status != status {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif tag != \"\" && !containsString(run.Tags, tag) {\r\n\t\t\tcontinue\r\n"]
[5943.54799, "o", "\t\t}\r\n\t\tduration := 0.0\r\n\t\tif run.StartTime != nil && run.EndTime != nil {\r\n\t\t\tduration = run.EndTime.Sub(*run.StartTime).Seconds()\r\n\t\t}\r\n\t\tout = append(out, PipelineHistoryEntry{\r\n\t\t\tID:              run.ID,\r\n\t\t\tStatus:          run.Status,\r\n"]
