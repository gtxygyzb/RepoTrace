[6292.231288, "o", "     6\t\t\"os\"\r\n     7\t\t\"path/filepath\"\r\n     8\t\t\"sync\"\r\n     9\t)\r\n    10\t\r\n    11\t// Store manages persistence for all entities\r\n    12\ttype Store struct {\r\n    13\t\tdataDir  string\r\n    14\t\tdataFile string\r\n    15\t\tmu       sync.RWMutex\r\n    16\t\tdata     *StoreData\r\n    17\t}\r\n"]
[6292.231363, "o", "    18\t\r\n    19\tfunc NewStore(dataDir string) (*Store, error) {\r\n    20\t\tif dataDir == \"\" {\r\n    21\t\t\tdataDir = filepath.Join(os.TempDir(), \"nexus\")\r\n    22\t\t}\r\n    23\t\tif err := os.MkdirAll(dataDir, 0755); err != nil {\r\n    24\t\t\treturn nil, fmt.Errorf(\"create data directory: %w\", err)\r\n    25\t\t}\r\n    26\t\r\n    27\t\ts := &Store{\r\n    28\t\t\t"]
[6292.231431, "o", "dataDir:  dataDir,\r\n    29\t\t\tdataFile: filepath.Join(dataDir, \"nexus_data.json\"),\r\n    30\t\t\tdata: &StoreData{\r\n    31\t\t\t\tModels:      make(map[string]*Model),\r\n    32\t\t\t\tExperiments: make(map[string]*Experiment),\r\n    33\t\t\t\tDatasets:    make(map[string]*Dataset),\r\n    34\t\t\t\tTagIndex:    make(map[string][]string),\r\n    35\t\t\t},\r\n    36\t"]
[6292.231513, "o", "\t}\r\n    37\t\r\n    38\t\tif err := s.load(); err != nil && !os.IsNotExist(err) {\r\n    39\t\t\treturn nil, fmt.Errorf(\"load store: %w\", err)\r\n    40\t\t}\r\n    41\t\r\n    42\t\treturn s, nil\r\n    43\t}\r\n    44\t\r\n    45\tfunc (s *Store) load() error {\r\n    46\t\tdata, err := os.ReadFile(s.dataFile)\r\n"]
[6292.231586, "o", "    47\t\tif err != nil {\r\n    48\t\t\treturn err\r\n    49\t\t}\r\n    50\t\treturn json.Unmarshal(data, s.data)\r\n    51\t}\r\n    52\t\r\n    53\tfunc (s *Store) save() error {\r\n    54\t\tdata, err := json.MarshalIndent(s.data, \"\", \"  \")\r\n    55\t\tif err != nil {\r\n    56\t\t\treturn fmt.Errorf(\"marshal data: %w\", err)\r\n    57\t\t}\r\n    58\t\ttmpFile := s.dataFile + \".tmp\"\r\n"]
[6292.231657, "o", "    59\t\tif err := os.WriteFile(tmpFile, data, 0644); err != nil {\r\n    60\t\t\treturn fmt.Errorf(\"write temp file: %w\", err)\r\n    61\t\t}\r\n    62\t\treturn os.Rename(tmpFile, s.dataFile)\r\n    63\t}\r\n    64\t\r\n    65\t// UpdateTagIndex maintains a shared tag index across all entity types.\r\n    66\t// This index is global: a tag search returns both model and experiment keys.\r\n    67\tfunc (s *Store) UpdateTagIndex(entityKey string, tags []string) {\r\n    68\t\tfor tag, keys := range s.data.TagIndex {\r\n"]
[6292.231734, "o", "    69\t\t\tfiltered := make([]string, 0)\r\n    70\t\t\tfor _, k := range keys {\r\n    71\t\t\t\tif k != entityKey {\r\n    72\t\t\t\t\tfiltered = append(filtered, k)\r\n    73\t\t\t\t}\r\n    74\t\t\t}\r\n    75\t\t"]
[6292.231806, "o", "\tif len(filtered) == 0 {\r\n    76\t\t\t\tdelete(s.data.TagIndex, tag)\r\n    77\t\t\t} else {\r\n    78\t\t\t\ts.data.TagIndex[tag] = filtered\r\n    79\t\t\t}\r\n    80\t\t}\r\n    81\t\tfor _, tag := range tags {\r\n    82\t\t\ts.data.TagIndex[tag] = append(s.data.TagIndex[tag], entityKey)\r\n    83\t\t}\r\n    84\t}\r\n    85\t\r\n    86\t// FindByTag returns all entity keys with the given tag\r\n    87\tfunc (s *Store) FindByTag(tag string) []string {\r\n    88\t\ts.mu.RLock()\r\n    89\t\tdefer s.mu.RUnlock()\r\n    90\t\treturn s.data.TagIndex[tag]"]
[6292.231877, "o", "\r\n    91\t}\r\n    92\t\r\n    93\t// === Model operations ===\r\n    94\t\r\n    95\tfunc (s *Store) SaveModel(m *Model) error {\r\n    96\t\ts.mu.Lock()\r\n    97\t\tdefer s.mu.Unlock()\r\n    98\t\r\n    99\t\tkey := m.Key()\r\n"]
[6292.231939, "o", "   100\t\ts.data.Models[key] = m\r\n   101\t\ts.UpdateTagIndex(\"model:\"+key, m.Tags)\r\n   102\t\treturn s.save()\r\n   103\t}\r\n   104\t\r\n   105\tfunc (s *Store) GetModel(name, version string) (*Model, error) {\r\n   106\t\ts.mu.RLock()\r\n   107\t\tdefer s.mu.RUnlock()\r\n   108\t\r\n"]
[6292.232021, "o", "   109\t\tkey := fmt.Sprintf(\"%s:%s\", name, version)\r\n   110\t\tm, ok := s.data.Models[key]\r\n   111\t\tif !ok {\r\n   112\t\t\treturn nil, fmt.Errorf(\"model not found: %s\", key)\r\n   113\t\t}\r\n   114\t\treturn m, nil\r\n   115\t}\r\n   116\t\r\n   117\tfunc (s *Store) ListModels(filter string) []*Model {\r\n   118\t\ts.mu.RLock()\r\n   119\t\tdefer s.mu.RUnlock()\r\n   120\t\r\n   121\t\tvar result []*Model\r\n   122\t"]
[6292.232141, "o", "\tfor _, m := range s.data.Models {\r\n   123\t\t\tif filter == \"\" || m.Name == filter || string(m.Status) == filter {\r\n   124\t\t\t\tresult = append(result, m)\r\n   125\t\t\t}\r\n   126\t\t}\r\n   127\t\treturn result\r\n   128\t}\r\n   129\t\r\n   130\tfunc (s *Store) DeleteModel(name, version string) error {\r\n   131\t\ts.mu.Lock()\r\n   132\t\tdefer s.mu.Unlock()\r\n   133\t\r\n   134"]
[6292.232213, "o", "\t\tkey := fmt.Sprintf(\"%s:%s\", name, version)\r\n   135\t\tif _, ok := s.data.Models[key]; !ok {\r\n   136\t\t\treturn fmt.Errorf(\"model not found: %s\", key)\r\n   137\t\t}\r\n   138\t\r\n   139\t\t// Referential integrity: cannot delete models referenced by experiments\r\n   140\t\tfor _, exp := range s.data.Experiments {\r\n   141\t\t\tif exp.ModelRef == key {\r\n   142\t\t\t\treturn fmt.Errorf(\"model %s is referenced by experiment %s\", key, exp.ID)\r\n   143\t\t\t}\r\n   144\t\t}\r\n   145\t\r\n"]
[6292.232275, "o", "   146\t\tdelete(s.data.Models, key)\r\n   147\t\ts.UpdateTagIndex(\"model:\"+key, nil)\r\n   148\t\treturn s.save()\r\n   149\t}\r\n   150\t\r\n"]
[6292.232348, "o", "   151\t// === Experiment operations ===\r\n   152\t\r\n   153\tfunc (s *Store) SaveExperiment(exp *Experiment) error {\r\n   154\t\ts.mu.Lock()\r\n   155\t\tdefer s.mu.Unlock()\r\n   156\t\r\n   157\t\t// Validate model reference if set\r\n   158\t\tif exp.ModelRef != \"\" {\r\n   159\t\t\tif _, ok := s.data.Models[exp.ModelRef]; !ok {\r\n   160\t\t\t\treturn fmt.Errorf(\"referenced model not found: %s\", exp.ModelRef)\r\n   161\t\t\t}\r\n   162\t\t}\r\n   163\t\r\n   164\t\t// Validate dataset reference if set\r\n   165\t\tif exp.DatasetRef != \"\" {\r\n   166\t\t\tif _, ok := s.data.Datasets[exp.DatasetRef]; !ok {\r\n"]
[6292.232419, "o", "   167\t\t\t\treturn fmt.Errorf(\"referenced dataset not found: %s\", exp.DatasetRef)\r\n   168\t\t\t}\r\n   169\t\t}\r\n   170\t\r\n   171\t\ts.data.Experiments[exp.ID] = exp\r\n   172\t\ts.UpdateTagIndex(\"experiment:\"+exp.ID, exp.Tags)\r\n   173\t\treturn s.save()\r\n   174\t}\r\n   175\t\r\n   176\tfunc (s *Store) GetExperiment(id string) (*Experiment, error) {\r\n"]
[6292.232487, "o", "   177\t\ts.mu.RLock()\r\n   178\t\tdefer s.mu.RUnlock()\r\n   179\t\r\n   180\t\texp, ok := s.data.Experiments[id]\r\n   181\t\tif !ok {\r\n   182\t\t\treturn nil, fmt.Errorf(\"experiment not found: %s\", id)\r\n   183\t\t}\r\n   184\t\treturn exp, nil\r\n   185\t}\r\n   186\t\r\n"]
[6292.232564, "o", "   187\tfunc (s *Store) ListExperiments(filter string) []*Experiment {\r\n   188\t\ts.mu.RLock()\r\n   189\t\tdefer s.mu.RUnlock()\r\n   190\t\r\n   191\t\tvar result []*Experiment\r\n   192\t\tfor _, exp := range s.data.Experiments {\r\n   193\t\t\tif filter == \"\" || exp.Name == filter || string(exp.Status) == filter {\r\n   194\t\t\t\tresult = append(result, exp)\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197\t\treturn result\r\n   198\t}\r\n   199\t"]
[6292.232634, "o", "\r\n   200\t// === Dataset operations ===\r\n   201\t\r\n   202\tfunc (s *Store) SaveDataset(ds *Dataset) error {\r\n   203\t\ts.mu.Lock()\r\n   204\t\tdefer s.mu.Unlock()\r\n   205\t\r\n   206\t\ts.data.Datasets[ds.Key()] = ds\r\n   207\t\treturn s.save()\r\n   208\t}\r\n"]
[6292.232703, "o", "   209\t\r\n   210\tfunc (s *Store) GetDataset(name, version string) (*Dataset, error) {\r\n   211\t\ts.mu.RLock()\r\n   212\t\tdefer s.mu.RUnlock()\r\n   213\t\r\n   214\t\tkey := fmt.Sprintf(\"%s:%s\", name, version)\r\n   215\t\tds, ok := s.data.Datasets[key]\r\n   216\t\tif !ok {\r\n   217\t\t\treturn nil, fmt.Errorf(\"dataset not found: %s\", key)\r\n   218"]
[6292.232769, "o", "\t\t}\r\n   219\t\treturn ds, nil\r\n   220\t}\r\n"]
