[4031.521391, "o", "   330\t\tendTime := time.Now()\r\n   331\t\trun.EndTime = &endTime\r\n   332\t\tif err != nil {\r\n   333\t\t\trun.Status = \"failed\"\r\n   334\t\t} else if run.Status != \"succeeded_with_warnings\" {\r\n   335\t\t\trun.Status = \"succeeded\"\r\n"]
[4031.521483, "o", "   336\t\t}\r\n   337\t\tsaveRun(run)\r\n   338\t\treturn run, err\r\n   339\t}\r\n   340\t\r\n   341\tfunc executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n   342\t\tstepByName := make(map[string]*PipelineStep)\r\n   343\t\tfor _, s := range cfg.Steps {\r\n   344\t\t\tstepByName[s.Name] = s\r\n   345\t\t}\r\n   346\t\trunStepByName := make(map[string]*StepRun)\r\n   347\t\tfor _, sr := range run.Steps {\r\n   348\t\t\trunStepByName[sr.Name] = sr\r\n"]
[4031.521579, "o", "   349\t\t}\r\n   350\t\r\n   351\t\tvariables := make(map[string]string)\r\n   352\t\tif run.Variables != nil {\r\n   353\t\t\tfor k, v := range run.Variables {\r\n   354\t\t\t\tvariables[k] = v\r\n   355\t\t\t}\r\n   356\t\t} else {\r\n   357\t\t\tfor k, v := range params {\r\n   358\t\t\t\tvariables[k] = v\r\n   359\t\t\t}\r\n   360\t\t}\r\n   361\t\tif run.Warnings == nil {\r\n   362\t\t\trun.Warnings = []string{}\r\n"]
[4031.521642, "o", "   363\t\t}\r\n   364\t\r\n   365\t\tvar varMu sync.Mutex\r\n   366\t\r\n   367\t\tfor _, step := range cfg.Steps {\r\n   368\t\t\tsr := runStepByName[step.Name]\r\n   369\t\t\tif sr != nil && (sr.Status == \"succeeded\" || sr.Status == \"skipped\") {\r\n   370\t\t\t\tvariables[\"steps.\"+step.Name+\".status\"] = sr.Status\r\n   371\t\t\t}\r\n   372\t\t}\r\n   373"]
[4031.521712, "o", "\t\r\n   374\t\tvar mu sync.Mutex\r\n   375\t\tvar running []*PipelineStep\r\n   376\t\tavailable := make(chan struct{}, maxParallel)\r\n   377\t\r\n   378\t\tpending := make(map[string]bool)\r\n   379\t\tfor _, step := range cfg.Steps {\r\n   380\t\t\tsr := runStepByName[step.Name]\r\n   381\t\t\tif sr.Status == \"succeeded\" || sr.Status == \"skipped\" {\r\n   382\t\t\t\tcontinue\r\n"]
[4031.521772, "o", "   383\t\t\t}\r\n   384\t\t\tif sr.Status == \"failed\" {\r\n   385\t\t\t\tsr.Status = \"pending\"\r\n   386\t\t\t\tsr.Error = \"\"\r\n   387\t\t\t\tsr.Output = \"\"\r\n   388\t\t\t\tsr.StartTime = nil\r\n   389\t\t\t\tsr.EndTime = nil\r\n   390\t\t\t}\r\n   391\t\t\tpending[step.Name] = true\r\n   392"]
[4031.521831, "o", "\t\t}\r\n   393\t\r\n   394\t\tvar wg sync.WaitGroup\r\n   395\t\tdone := false\r\n   396\t\r\n   397\t\tcanStart := func(step *PipelineStep) bool {\r\n   398\t\t\tfor _, dep := range step.DependsOn {\r\n   399\t\t\t\tstatus := runStepByName[dep].Status\r\n   400"]
[4031.521892, "o", "\t\t\t\tif status == \"succeeded\" || status == \"skipped\" {\r\n   401\t\t\t\t\tcontinue\r\n   402\t\t\t\t}\r\n   403\t\t\t\tif status == \"failed\" {\r\n   404\t\t\t\t\tif depStep := stepByName[dep]; depStep != nil && depStep.AllowFailure {\r\n   405\t\t\t\t\t\tcontinue\r\n   406\t\t\t\t\t}\r\n"]
[4031.521949, "o", "   407\t\t\t\t}\r\n   408\t\t\t\treturn false\r\n   409\t\t\t}\r\n   410\t\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n   411\t\t\t\tvar cpu, mem int\r\n   412\t\t\t\tfor _, r := range running {\r\n   413\t\t\t\t\tif r.Resources != nil {\r\n   414\t\t\t\t\t\tcpu += r.Resources.CPU\r\n"]
[4031.522018, "o", "   415\t\t\t\t\t\tmem += r.Resources.MemoryMB\r\n   416\t\t\t\t\t}\r\n   417\t\t\t\t}\r\n"]
[4031.522118, "o", "   418\t\t\t\tif cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n   419\t\t\t\t\treturn false\r\n   420\t\t\t\t}\r\n   421\t\t\t}\r\n   422\t\t\treturn true\r\n   423\t\t}\r\n   424\t\r\n   425\t\tstartStep := func(step *PipelineStep) {\r\n   426\t\t\tpending[step.Name] = false\r\n   427\t\t\trunning = append(running, step)\r\n   428\t\t\twg.Add(1)\r\n   429\t\t\tgo func(s *PipelineStep) {\r\n   430\t\t\t\tdefer wg.Done()\r\n   431\t\t\t\texecuteStep(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])\r\n   432\t\t\t\tmu.Lock()\r\n"]
[4031.522182, "o", "   433\t\t\t\trunning = removeStep(running, s)\r\n   434\t\t\t\tstatus := runStepByName[s.Name].Status\r\n   435\t\t\t\tif status == \"failed\" {\r\n   436\t\t\t\t\tif s.AllowFailure {\r\n   437\t\t\t\t\t\tif !containsString(run.Warnings, s.Name) {\r\n   438\t\t\t\t\t\t\trun.Warnings = append(run.Warnings, s.Name)\r\n   439\t\t\t\t\t\t}\r\n   440\t\t\t\t\t} else {\r\n"]
[4031.522244, "o", "   441\t\t\t\t\t\trun.Status = \"failed\"\r\n   442\t\t\t\t\t\tdone = true\r\n   443\t\t\t\t\t}\r\n   444\t\t\t\t}\r\n   445\t\t\t\tvarMu.Lock()\r\n   446\t\t\t\tvariables[\"steps.\"+s.Name+\".status\"] = status\r\n   447\t\t\t\trun.Variables = copyMap(variables)\r\n   448\t\t\t\tvarMu.Unlock()\r\n   449\t\t\t\tsaveCheckpoint(run)\r\n   450\t\t\t\tsaveRun(run)\r\n"]
[4031.522308, "o", "   451\t\t\t\tmu.Unlock()\r\n   452\t\t\t\t<-available\r\n   453\t\t\t}(step)\r\n   454\t\t}\r\n   455\t\r\n   456\t\tfor !done && (len(pending) > 0 || len(running) > 0) {\r\n   457\t\t\tstartedAny := false\r\n   458\t\t\tvar starts []*PipelineStep\r\n   459\t\t\tmu.Lock()\r\n   460\t\t"]
[4031.522368, "o", "\tfor _, step := range cfg.Steps {\r\n   461\t\t\t\tif pending[step.Name] && canStart(step) {\r\n   462\t\t\t\t\tstarts = append(starts, step)\r\n   463\t\t\t\t}\r\n   464\t\t\t}\r\n   465\t\t\tmu.Unlock()\r\n   466\t\t\tsort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })\r\n   467\t\t\tfor _, step := range starts {\r\n   468\t\t\t\tavailable <- struct{}{}\r\n"]
[4031.522434, "o", "   469\t\t\t\tmu.Lock()\r\n   470\t\t\t\tif done || !pending[step.Name] || !canStart(step) {\r\n"]
