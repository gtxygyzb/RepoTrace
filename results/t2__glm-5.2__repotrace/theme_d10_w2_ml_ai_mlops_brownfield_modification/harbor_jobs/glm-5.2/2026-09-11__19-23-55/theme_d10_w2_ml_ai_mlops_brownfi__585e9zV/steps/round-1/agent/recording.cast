[1986.421687, "o", "# Replace runShellCommand to accept env\r\n\u001b[?2004l\r"]
[1986.421742, "o", "\u001b[?2004h> "]
[1986.422086, "o", "old = '''func runShellCommand(command string, timeoutSeconds int) (string, int, error) {\r\n\u001b[?2004l\r"]
[1986.422146, "o", "\u001b[?2004h> "]
[1986.422289, "o", "\\tcmd := exec.Command(\"sh\", \"-c\", command)\r\n\u001b[?2004l\r"]
[1986.422345, "o", "\u001b[?2004h> "]
[1986.422435, "o", "\\tvar out strings.Builder\r\n\u001b[?2004l\r"]
[1986.422491, "o", "\u001b[?2004h> "]
[1986.422542, "o", "\\tcmd.Stdout = &out\r\n\u001b[?2004l\r\\t\u001b[?2004h> "]
[1986.422618, "o", "\\tcmd.Stderr = &out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.422673, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.422965, "o", "new = '''func runShellCommand(command string, timeoutSeconds int, env []string) (string, int, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.423111, "o", "\\tcmd := exec.Command(\"sh\", \"-c\", command)\r\n\u001b[?2004l\r"]
[1986.423166, "o", "\u001b[?2004h> \\tif env != nil {\r\n\u001b[?2004l\r"]
[1986.423221, "o", "\u001b[?2004h> "]
[1986.423277, "o", "\\t\\tcmd.Env = env\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.423331, "o", "\\t}\r\n\u001b[?2004l\r\\\u001b[?2004h> "]
