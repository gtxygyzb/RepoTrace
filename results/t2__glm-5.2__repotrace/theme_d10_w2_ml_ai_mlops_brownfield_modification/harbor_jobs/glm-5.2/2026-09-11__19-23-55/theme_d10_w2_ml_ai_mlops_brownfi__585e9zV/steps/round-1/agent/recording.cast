[4544.650641, "o", "func evaluateCondition(cond string, vars map[string]string) (bool, error) {\r\n\tcond = strings.TrimSpace(cond)\r\n\tif cond == \"\" {\r\n\t\treturn true, nil\r\n\t}\r\n\tif strings.Contains(cond, \"==\") {\r\n\t\tparts := strings.SplitN(cond, \"==\", 2)\r\n\t\tleft, err := substituteVariables(strings.TrimSpace(parts[0]), vars)\r\n\t\tif err != nil {\r\n\t\t\treturn false, err\r\n\t\t}\r\n\t\tright, err := substituteVariables(strings.TrimSpace(parts[1]), vars)\r\n\t\tif err != nil {\r\n\t\t\treturn false, err\r\n\t\t}\r\n\t\treturn left == right, nil\r\n\t}\r\n\tif strings.Contains(cond, \"!=\") {\r\n\t\tparts := strings.SplitN(cond, \"!=\", 2)\r\n\t\tleft, err := substituteVariables(strings.TrimSpace(parts[0]), vars)\r\n\t\tif err != nil {\r\n\t\t\treturn false, err\r\n\t\t}\r\n\t\tright, err := substituteVariables(strings.TrimSpace(parts[1]), vars)\r\n\t"]
[4544.650685, "o", "\tif err != nil {\r\n\t\t\treturn false, err\r\n\t\t}\r\n\t\treturn left != right, nil\r\n\t}\r\n\treturn false, fmt.Errorf(\"invalid condition: %s\", cond)\r\n}\r\n\r\n"]
[4544.650734, "o", "func resolveParam(token string, params map[string]string) string {\r\n\tres, _ := substituteVariables(token, params)\r\n\treturn res\r\n}\r\n\r\nfunc generateRunID() string {\r\n\treturn fmt.Sprintf(\"run-%d\", time.Now().UnixNano())\r\n}\r\n\r\n"]
