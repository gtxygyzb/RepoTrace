[1484.30152, "o", "\r\n   430\tfunc removeStep(steps []*PipelineStep, target *PipelineStep) []*PipelineStep {\r\n   431\t\tout := make([]*PipelineStep, 0, len(steps))\r\n   432\t\tfor _, s := range steps {\r\n   433\t\t\tif s != target {\r\n   434\t\t\t\tout = append(out, s)\r\n   435\t\t\t}\r\n   436\t\t}\r\n   437\t\treturn out\r\n   438\t}\r\n   439\t\r\n   440\tfunc executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, params map[string]string, sr *StepRun) {\r\n"]
