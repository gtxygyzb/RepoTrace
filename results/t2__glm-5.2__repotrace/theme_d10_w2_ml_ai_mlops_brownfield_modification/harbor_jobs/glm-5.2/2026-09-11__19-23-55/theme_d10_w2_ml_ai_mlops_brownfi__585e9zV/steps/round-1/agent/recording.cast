[1424.246571, "o", "func main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tstore, err := NewStore(dataDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tregistry := NewRegistry(store)\r\n\ttracker := NewTracker(store)\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"model\":\r\n\t\thandleModel(registry, os.Args[2:])\r\n\tcase \"experiment\":\r\n\t\thandleExperiment(tracker, os.Args[2:])\r\n\tcase \"pipeline\":\r\n\t\thandlePipeline(store, tracker, os.Args[2:])\r\n"]
[1424.246641, "o", "\tcase \"dataset\":\r\n\t\thandleDataset(store, os.Args[2:])\r\n\tcase \"search\":\r\n\t\thandleSearch(store, os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"Unknown command: %s\\n\", os.Args[1])\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc printUsage() {\r\n"]
[1424.246707, "o", "\tfmt.Println(\"nexus - ML Model & Experiment Management\")\r\n\tfmt.Println()\r\n\tfmt.Println(\"Commands:\")\r\n\tfmt.Println(\"  model register <name> [--version V] [--framework F] [--description D] [--tags t1,t2]\")\r\n\tfmt.Println(\"  model list [--filter F]\")\r\n\tfmt.Println(\"  model get <name> <version>\")\r\n\tfmt.Println(\"  model promote <name> <version> <status>\")\r\n\tfmt.Println(\"  model delete <name> <version>\")\r\n\tfmt.Println(\"  model compare <name>\")\r\n\tfmt.Println(\"  experiment create <name> [--params k1=v1,k2=v2] [--tags t1,t2]\")\r\n\tfmt.Println(\"  experiment list [--filter F]\")\r\n"]
[1424.246781, "o", "\tfmt.Println(\"  experiment get <id>\")\r\n\tfmt.Println(\"  experiment log-metric <id> <key> <value>\")\r\n\tfmt.Println(\"  experiment complete <id> [--status completed|failed]\")\r\n\tfmt.Println(\"  experiment compare <id1,id2,...>\")\r\n\tfmt.Println(\"  experiment export <output-path> [--format json|csv]\")\r\n\tfmt.Println(\"  dataset register <name> <version> <format> <path> [--rows N]\")\r\n\tfmt.Println(\"  dataset list\")\r\n\tfmt.Println(\"  dataset get <name> <version>\")\r\n\tfmt.Println(\"  search --tag <tag>\")\r\n\tfmt.Println(\"  pipeline validate <config.json>\")\r\n\tfmt.Println(\"  pipeline run <config.json> [--param key=value ...] [--max-parallel N]\")\r\n\tfmt.Println(\"  pipeline status <run-id>\")\r\n"]
[1424.246842, "o", "\tfmt.Println(\"  pipeline list\")\r\n\tfmt.Println(\"  pipeline artifacts <run-id>\")\r\n\tfmt.Println(\"  pipeline resume <run-id>\")\r\n}\r\n\r\nfunc handleModel(reg *Registry, args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"model subcommand required\")\r\n\t\tos.Exit(1)\r\n"]
[1424.246899, "o", "\t}\r\n\r\n\tswitch args[0] {\r\n\tcase \"register\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tname := args[1]\r\n\t\tversion := getFlag(args, \"--version\", \"\")\r\n"]
