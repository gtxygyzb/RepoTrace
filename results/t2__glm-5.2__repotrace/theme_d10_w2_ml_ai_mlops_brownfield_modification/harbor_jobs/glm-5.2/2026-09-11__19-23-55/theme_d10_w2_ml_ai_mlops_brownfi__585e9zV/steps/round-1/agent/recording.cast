[7174.808638, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('main.go')\nlines = p.read_text().splitlines()\n\ndelete_indices = [i for i, line in enumerate(lines) if line.strip() == 'case \"delete\":']\nif len(delete_indices) < 2:\n    raise SystemExit(f'expected 2 delete cases, found {len(delete_indices)}')\nstart = delete_indices[1]\n\ndefault = None\nfor i in range(start + 1, len(lines)):\n    if lines[i].strip() == 'default:':\n        default = i\n        break\nif default is None:\n    raise SystemExit('could not locate default after pipeline delete')\n\nreplacement = [\n    '\\tcase \"delete\":',\n    '\\t\\tif len(args) < 2 {',\n    '\\t\\t\\tfmt.Fprintln(os.Stderr, \"run-id required\")',\n    '\\t\\t\\tos.Exit(1)',\n    '\\t\\t}',\n    '\\t\\tif err := deleteRun(args[1]); err != nil {',\n    '\\t\\t\\tfmt.Fprintf(os.Stderr, \"Error: %v\\\\n\", err)',\n    '\\t\\t\\tos.Exit(1)',\n    '\\t\\t}',\n    '\\t\\tprintJSON(map[string]string{\"deleted\": args[1]})',\n    '',\n]\n\nlines = lines[:start] + replacement + lines[default:]\np.write_text('\\n'.join(lines) + '\\n')\nPY\n"]
