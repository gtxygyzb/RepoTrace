[4019.523228, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n"]
[4019.523303, "o", "\t\"time\"\r\n)\r\n\r\n// ModelStatus represents the lifecycle stage of a model\r\ntype ModelStatus string\r\n\r\nconst (\r\n\tModelStatusRegistered ModelStatus = \"registered\"\r\n\tModelStatusStaging    ModelStatus = \"staging\"\r\n\tModelStatusProduction ModelStatus = \"production\"\r\n"]
[4019.523382, "o", "\tModelStatusArchived   ModelStatus = \"archived\"\r\n)\r\n\r\n// Model represents an ML model in the registry\r\ntype Model struct {\r\n\tName        string             `json:\"name\"`\r\n\tVersion     string             `json:\"version\"`\r\n\tFramework   string             `json:\"framework\"`\r\n\tDescription string             `json:\"description,omitempty\"`\r\n\tTags        []string           `json:\"tags,omitempty\"`\r\n\tStatus      ModelStatus        `json:\"status\"`\r\n"]
[4019.523453, "o", "\tMetrics     map[string]float64 `json:\"metrics,omitempty\"`\r\n\tCreatedAt   time.Time          `json:\"created_at\"`\r\n\tUpdatedAt   time.Time          `json:\"updated_at\"`\r\n\tParentRef   string             `json:\"parent_ref,omitempty\"`\r\n}\r\n"]
[4019.523513, "o", "\r\nfunc (m *Model) Key() string {\r\n\treturn fmt.Sprintf(\"%s:%s\", m.Name, m.Version)\r\n}\r\n\r\n"]
[4019.523573, "o", "// ValidTransitions defines valid model lifecycle transitions\r\nvar ValidTransitions = map[ModelStatus][]ModelStatus{\r\n\tModelStatusRegistered: {ModelStatusStaging, ModelStatusArchived},\r\n\tModelStatusStaging:    {ModelStatusProduction, ModelStatusRegistered, ModelStatusArchived},\r\n\tModelStatusProduction: {ModelStatusStaging, ModelStatusArchived},\r\n\tModelStatusArchived:   {ModelStatusRegistered},\r\n}\r\n"]
[4019.52365, "o", "\r\nfunc (m *Model) CanTransitionTo(target ModelStatus) bool {\r\n\tallowed, ok := ValidTransitions[m.Status]\r\n\tif !ok {\r\n\t\treturn false\r\n\t}\r\n\tfor _, s := range allowed {\r\n\t\tif s == target {\r\n"]
[4019.523721, "o", "\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\n// ExperimentStatus represents the state of an experiment run\r\ntype ExperimentStatus string\r\n\r\nconst (\r\n\tExperimentStatusRunning   ExperimentStatus = \"running\"\r\n\tExperimentStatusCompleted ExperimentStatus = \"completed\"\r\n\tExperimentStatusFailed    ExperimentStatus = \"failed\"\r\n)\r\n\r\n// Experiment represents an ML experiment run\r\ntype Experiment struct {\r\n"]
[4019.523795, "o", "\tID         string             `json:\"id\"`\r\n\tName       string             `json:\"name\"`\r\n\tStatus     ExperimentStatus   `json:\"status\"`\r\n\tParameters map[string]string  `json:\"parameters,omitempty\"`\r\n\tMetrics    map[string]float64 `json:\"metrics,omitempty\"`\r\n\tTags       []string           `json:\"tags,omitempty\"`\r\n\tModelRef   string             `json:\"model_ref,omitempty\"`\r\n\tDatasetRef string             `json:\"dataset_ref,omitempty\"`\r\n\tStartTime  time.Time          `json:\"start_time\"`\r\n\tEndTime    time.Time          `json:\"end_time,omitempty\"`\r\n\tNotes      string             `json:\"notes,omitempty\"`\r\n"]
[4019.523896, "o", "}\r\n\r\n// Dataset represents a dataset version\r\ntype Dataset struct {\r\n\tName      string    `json:\"name\"`\r\n\tVersion   string    `json:\"version\"`\r\n\tFormat    string    `json:\"format\"`\r\n\tPath      string    `json:\"path\"`\r\n\tRowCount  int64     `json:\"row_count\"`\r\n\tSchema    []Column  `json:\"schema,omitempty\"`\r\n\tCreatedAt time.Time `json:\"created_at\"`\r\n"]
[4019.52396, "o", "\tChecksum  string    `json:\"checksum,omitempty\"`\r\n}\r\n\r\nfunc (d *Dataset) Key() string {\r\n\treturn fmt.Sprintf(\"%s:%s\", d.Name, d.Version)\r\n}\r\n\r\n"]
[4019.524024, "o", "// Column represents a dataset column\r\ntype Column struct {\r\n\tName     string `json:\"name\"`\r\n\tType     string `json:\"type\"`\r\n\tNullable bool   `json:\"nullable\"`\r\n}\r\n\r\n// StoreData holds all persisted data\r\ntype StoreData struct {\r\n\tModels      map[string]*Model      `json:\"models\"`\r\n\tExperiments map[string]*Experiment `json:\"experiments\"`\r\n\tDatasets    map[string]*Dataset    `json:\"datasets\"`\r\n\tTagIndex    map[string][]string    `json:\"tag_index\"`\r\n}\r\n"]
[4019.524591, "o", "\u001b[?2004h"]
[4019.524696, "o", "root@n30009:/app# "]
[4019.776994, "i", "sed -n '1,160p' tracker.go\n"]
[4019.77729, "o", "sed -n '1,160p' tracker.go\r\n\u001b[?2004l\r"]
[4019.780051, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[4019.780148, "o", "\t\"os\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\n// Tracker manages experiment lifecycle\r\ntype Tracker struct {"]
[4019.780218, "o", "\r\n\tstore   *Store\r\n\tcounter int\r\n}\r\n\r\nfunc NewTracker(store *Store) *Tracker {\r\n\tt := &Tracker{store: store}\r\n\texps := store.ListExperiments(\"\")\r\n\tfor _, exp := range exps {\r\n\t\tif id := extractCounter(exp.ID); id > t.counter {\r\n\t\t\tt.counter = id\r\n\t\t}\r\n\t}\r\n\treturn t\r\n}\r\n\r\nfunc extractCounter(id string) int {\r\n\tvar n int\r\n\tfmt.Sscanf(id, \"exp-%d\", &n)\r\n\treturn n\r\n}\r\n\r\nfunc (t *Tracker) Create(name string, params map[string]string, tags []string) (*Experiment, error) {\r\n\tif name == \"\" {\r\n"]
[4019.780291, "o", "\t\treturn nil, fmt.Errorf(\"experiment name is required\")\r\n\t}\r\n\r\n\tt.counter++\r\n\texp := &Experiment{\r\n\t\tID:         fmt.Sprintf(\"exp-%04d\", t.counter),\r\n"]
[4019.78036, "o", "\t\tName:       name,\r\n\t\tStatus:     ExperimentStatusRunning,\r\n\t\tParameters: params,\r\n\t\tMetrics:    make(map[string]float64),\r\n\t\tTags:       tags,\r\n\t\tStartTime:  time.Now(),\r\n\t}\r\n\r\n\tif err := t.store.SaveExperiment(exp); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn exp, nil\r\n}\r\n\r\nfunc (t *Tracker) LogMetric(id, key string, value float64) error {\r\n\texp, err := t.store.GetExperiment(id)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}"]
[4019.780422, "o", "\r\n\tif exp.Status != ExperimentStatusRunning {\r\n\t\treturn fmt.Errorf(\"cannot log metrics to %s experiment\", exp.Status)\r\n\t}\r\n\r\n\texp.Metrics[key] = value\r\n\treturn t.store.SaveExperiment(exp)\r\n}\r\n\r\n"]
[4019.780486, "o", "func (t *Tracker) Complete(id string, status ExperimentStatus) error {\r\n\texp, err := t.store.GetExperiment(id)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif exp.Status != ExperimentStatusRunning {\r\n\t\treturn fmt.Errorf(\"experiment %s is already %s\", id, exp.Status)\r\n\t}\r\n\r\n\texp.Status = status\r\n\texp.EndTime = time.Now()\r\n"]
[4019.780549, "o", "\treturn t.store.SaveExperiment(exp)\r\n}\r\n\r\nfunc (t *Tracker) CompareExperiments(ids []string) (string, error) {\r\n\tvar exps []*Experiment\r\n\tfor _, id := range ids {\r\n\t\texp, err := t.store.GetExperiment(id)\r\n\t\tif err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n"]
[4019.78062, "o", "\t\texps = append(exps, exp)\r\n\t}\r\n\r\n\tmetricKeys := make(map[string]bool)\r\n\tfor _, exp := range exps {\r\n\t\tfor k := range exp.Metrics {\r\n"]
[4019.780684, "o", "\t\t\tmetricKeys[k] = true\r\n\t\t}\r\n\t}\r\n\r\n\tvar keys []string\r\n\tfor k := range metricKeys {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n\tsort.Strings(keys)\r\n\r\n\tresult := map[string]interface{}{\r\n\t\t\"experiments\": exps,\r\n\t\t\"metric_keys\": keys,\r\n\t}\r\n\r\n\tdata, _ := json.MarshalIndent(result, \"\", \"  \")\r\n\treturn string(data), nil\r\n}\r\n"]
[4019.780725, "o", "\r\nfunc (t *Tracker) LinkModel(experimentID, modelRef string) error {\r\n\texp, err := t.store.GetExperiment(experimentID)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\texp.ModelRef = modelRef\r\n"]
[4019.78081, "o", "\treturn t.store.SaveExperiment(exp)\r\n}\r\n\r\nfunc (t *Tracker) Export(outputPath string, format string) error {\r\n\texps := t.store.ListExperiments(\"\")\r\n\r\n\tswitch format {\r\n\tcase \"json\":\r\n\t\tdata, err := json.MarshalIndent(exps, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t\treturn os.WriteFile(outputPath, data, 0644)\r\n"]
[4019.780872, "o", "\tcase \"csv\":\r\n\t\tf, err := os.Create(outputPath)\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t\tdefer f.Close()\r\n\r\n\t\tfmt.Fprintln(f, \"id,name,status,start_time\")\r\n\t\tfor _, exp := range exps {\r\n"]
[4019.780931, "o", "\t\t\tfmt.Fprintf(f, \"%s,%s,%s,%s\\n\", exp.ID, exp.Name, exp.Status, exp.StartTime.Format(time.RFC3339))\r\n\t\t}\r\n\t\treturn nil\r\n\tdefault:\r\n\t\treturn fmt.Errorf(\"unsupported export format: %s\", format)\r\n\t}\r\n}\r\n"]
