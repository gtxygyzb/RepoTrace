[3501.330067, "o", "\t\tsaveCheckpoint(run)\r\n   500\t\tsaveRun(run)\r\n   501\t\r\n   502\t\tif run.Status == \"failed\" {\r\n   503\t\t\treturn fmt.Errorf(\"pipeline execution failed\")\r\n   504\t\t}\r\n   505\t\treturn nil\r\n   506\t}\r\n   507\tfunc removeStep(steps []*PipelineStep, target *PipelineStep) []*PipelineStep {\r\n   508"]
[3501.330158, "o", "\t\tout := make([]*PipelineStep, 0, len(steps))\r\n   509\t\tfor _, s := range steps {\r\n   510\t\t\tif s != target {\r\n   511\t\t\t\tout = append(out, s)\r\n   512\t\t\t}\r\n   513\t\t}\r\n   514\t\treturn out\r\n   515\t}\r\n   516\t"]
[3501.330222, "o", "\r\n   517\tfunc executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {\r\n   518\t\tfor _, dep := range step.DependsOn {\r\n   519\t\t\tdepStatus := getRunStep(run, dep).Status\r\n   520\t\t\tif depStatus == \"succeeded\" || depStatus == \"skipped\" {\r\n   521\t\t\t\tcontinue\r\n   522\t\t\t}\r\n   523\t\t\tif depStatus == \"failed\" {\r\n   524\t\t\t\tdepStep := getStepConfig(cfg, dep)\r\n   525\t\t\t\tif depStep != nil && depStep.AllowFailure {\r\n   526\t\t\t\t\tcontinue\r\n   527\t\t\t\t}\r\n   528\t\t\t}\r\n"]
[3501.330286, "o", "   529\t\t\tsr.Status = \"failed\"\r\n   530\t\t\tsr.Error = \"dependency failed\"\r\n"]
