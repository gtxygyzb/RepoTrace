[6737.061979, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
[6737.062109, "o", "\t\"os\"\r\n\t\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\""]
[6737.062217, "o", "\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\nconst pipelineRunsDir = \"/tmp/nexus/runs\"\r\n\r\ntype PipelineResourceLimit struct {\r\n\tCPU      int `json:\"cpu,omitempty\"`\r\n\tMemoryMB int `json:\"memory_mb,omitempty\"`\r\n}\r\n\r\ntype PipelineStepResources struct {\r\n\tCPU      int `json:\"cpu,omitempty\"`\r\n\tMemoryMB int `json:\"memory_mb,omitempty\"`\r\n}\r\n\r\ntype PipelineStepRetry struct {\r\n\tMaxRetries         int `json:\"max_retries,omitempty\"`\r\n\tBackoffBaseSeconds int `json:\"backoff_base_seconds,omitempty\"`\r\n}\r\n\r\ntype CaptureOutputConfig struct {\r\n\tName  string `json:\"name\"`\r\n\tRegex string `json:\"regex,omitempty\"`\r\n}\r\n\r\nfunc (c *CaptureOutputConfig) UnmarshalJSON(data []byte) error {\r\n\tvar str string\r\n\tif err := json.Unmarshal(data, &str); err == nil {\r\n\t\tc.Name = str\r\n\t\tc.Regex = \"\"\r\n\t\treturn nil\r\n\t}\r\n"]
[6737.062276, "o", "\tvar raw struct {\r\n\t\tName  string `json:\"name\"`\r\n\t\tRegex string `json:\"regex\"`\r\n\t}\r\n\tif err := json.Unmarshal(data, &raw); err != nil {\r\n\t\treturn fmt.Errorf(\"capture_output must be a string or an object with name and optional regex\")\r\n\t}\r\n\tc.Name = raw.Name\r\n\tc.Regex = raw.Regex"]
[6737.062422, "o", "\r\n\treturn nil\r\n}\r\n\r\ntype PipelineExperimentConfig struct {\r\n"]
[6737.062529, "o", "\tName    string            `json:\"name,omitempty\"`\r\n\tParams  map[string]string `json:\"params,omitempty\"`\r\n\tMetrics []string          `json:\"metrics,omitempty\"`\r\n}\r\n\r\ntype PipelineStep struct {\r\n\tName             string                    `json:\"name\"`\r\n\tType             string                    `json:\"type\"`\r\n\tCommand          string                    `json:\"command\"`\r\n\tDependsOn        []string                  `json:\"depends_on,omitempty\"`\r\n\tInputs           []string                  `json:\"inputs,omitempty\"`\r\n\tOutputs          []string                  `json:\"outputs,omitempty\"`\r\n\tResources        *PipelineStepResources    `json:\"resources,omitempty\"`\r\n\tTimeoutSeconds   int                       `json:\"timeout_seconds,omitempty\"`\r\n\tRetry            *PipelineStepRetry        `json:\"retry,omitempty\"`\r\n\tCondition        string                    `json:\"condition,omitempty\"`\r\n\tExperimentConfig *PipelineExperimentConfig `json:\"experiment_config,omitempty\"`\r\n\tDatasetRef       string                    `json:\"d"]
[6737.062639, "o", "ataset_ref,omitempty\"`\r\n\tCaptureOutput    *CaptureOutputConfig      `json:\"capture_output,omitempty\"`\r\n\tEnv              map[string]string         `json:\"env,omitempty\"`\r\n\tAllowFailure     bool                      `json:\"allow_failure,omitempty\"`\r\n}\r\n\r\ntype PipelineConfig struct {\r\n\tName          string                 `json:\"name\"`\r\n\tDescription   string                 `json:\"description,omitempty\"`\r\n\tTags          []string               `json:\"tags,omitempty\"`\r\n\tParameters    map[string]string      `json:\"parameters,omitempty\"`\r\n\tMaxParallel   int                    `json:\"max_parallel,omitempty\"`\r\n\tResourceLimit *PipelineResourceLimit `json:\"resource_limit,omitempty\"`\r\n\tSteps         []*PipelineStep        `json:\"steps\"`\r\n}\r\n\r\ntype Artifact struct {\r\n\tName     string `json:\"name\"`\r\n\tType     string `json:\"type\"`\r\n\tProducer string `json:\"producer\"`\r\n\tPath     string `json:\"path\"`\r\n\tSize     int64  `json:\"size\"`\r\n}\r\n\r\ntype RetryHistoryEntry struct {\r\n\tAttempt int    `json:\"attempt\"`\r\n\tError   string `json:"]
[6737.062743, "o", "\"error\"`\r\n}\r\n\r\ntype StepRun struct {\r\n\tName         string              `json:\"name\"`\r\n\tType         string              `json:\"type\"`\r\n\tStatus       string              `json:\"status\"`\r\n\tStartTime    *time.Time          `json:\"start_time,omitempty\"`\r\n\tEndTime      *time.Time          `json:\"end_time,omitempty\"`\r\n\tExitCode     int                 `json:\"exit_code,omitempty\"`\r\n\tStdout       string              `json:\"stdout,omitempty\"`\r\n\tOutput       string              `json:\"output,omitempty\"`\r\n\tError        string              `json:\"error,omitempty\"`\r\n\tArtifacts    []Artifact          `json:\"artifacts,omitempty\"`\r\n\tExperimentID string              `json:\"experiment_id,omitempty\"`\r\n\tRetryCount   int                 `json:\"retry_count\"`\r\n\tRetryHistory []RetryHistoryEntry `json:\"retry_history\"`\r\n}\r\n\r\ntype PipelineRun struct {\r\n\tID          string            `json:\"id\"`\r\n\tPipeline    string            `json:\"pipeline\"`\r\n\tStatus      string            `json:\"status\"`\r\n\tDescription string            `json:\"descr"]
[6737.062848, "o", "iption\"`\r\n\tTags        []string          `json:\"tags\"`\r\n\tParameters  map[string]string `json:\"parameters,omitempty\"`\r\n\tStartTime   *time.Time        `json:\"start_time,omitempty\"`\r\n\tEndTime     *time.Time        `json:\"end_time,omitempty\"`\r\n\tSteps       []*StepRun        `json:\"steps\"`\r\n\tArtifacts   []Artifact        `json:\"artifacts,omitempty\"`\r\n\tRunDir      string            `json:\"run_dir,omitempty\"`\r\n\tVariables   map[string]string `json:\"variables,omitempty\"`\r\n\tWarnings    []string          `json:\"warnings\"`\r\n}\r\n\r\ntype Checkpoint struct {\r\n\tRunID      string            `json:\"run_id\"`\r\n\tStatus     string            `json:\"status\"`\r\n\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n\tSteps      []*StepRun        `json:\"steps\"`\r\n\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n\tVariables  map[string]string `json:\"variables,omitempty\"`\r\n\tWarnings   []string          `json:\"warnings\"`\r\n}\r\n\r\nfunc loadPipelineConfig(path string) (*PipelineConfig, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\ti"]
[6737.062942, "o", "f err != nil {\r\n\t\treturn nil, fmt.Errorf(\"read pipeline config: %w\", err)\r\n\t}\r\n\tvar cfg PipelineConfig\r\n\tif err := json.Unmarshal(data, &cfg); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"parse pipeline config: %w\", err)\r\n\t}\r\n\tif cfg.MaxParallel <= 0 {\r\n\t\tcfg.MaxParallel = 4\r\n\t}\r\n\treturn &cfg, nil\r\n}\r\n\r\nfunc validatePipelineConfig(cfg *PipelineConfig) error {\r\n\tif cfg.Name == \"\" {\r\n\t\treturn fmt.Errorf(\"pipeline name is required\")\r\n"]
[6737.062982, "o", "\t}\r\n\tif len(cfg.Steps) == 0 {\r\n\t\treturn fmt.Errorf(\"pipeline must have at least one step\")\r\n\t}\r\n\r\n\tnames := make(map[string]bool)\r\n\tfor _, step := range cfg.Steps {\r\n\t\tif step.Name == \"\" {\r\n\t\t\treturn fmt.Errorf(\"step name is required\")\r\n\t\t}\r\n\t\tif names[step.Name] {\r\n\t\t\treturn fmt.Errorf(\"duplicate step name: %s\", step.Name)\r\n\t\t}\r\n"]
[6737.063009, "o", "\t\tnames[step.Name] = true\r\n\t\tswitch step.Type {\r\n\t\tcase \"shell\", \"train\", \"evaluate\":\r\n"]
[6737.06318, "o", "\t\tdefault:\r\n\t\t\treturn fmt.Errorf(\"step %s has invalid type: %s\", step.Name, step.Type)\r\n\t\t}\r\n\t\tif step.Command == \"\" {\r\n\t\t\treturn fmt.Errorf(\"step %s command is required\", step.Name)\r\n\t\t}\r\n\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n\t\t\tif step.Resources.CPU > cfg.ResourceLimit.CPU {\r\n\t\t\t\treturn fmt.Errorf(\"step %s cpu requirement %d exceeds pipeline limit %d\", step.Name, step.Resources.CPU, cfg.ResourceLimit.CPU)\r\n\t\t\t}\r\n\t\t\tif step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n\t\t\t\treturn fmt.Errorf(\"step %s memory requirement %d MB exceeds pipeline limit %d MB\", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)\r\n\t\t\t}\r\n\t\t}\r\n\t\tif step.Type == \"train\" && step.ExperimentConfig == nil {\r\n\t\t\treturn fmt.Errorf(\"train step %s requires experiment_config\", step.Name)\r\n\t\t}\r\n\t}\r\n\r\n"]
[6737.063216, "o", "\tfor _, step := range cfg.Steps {\r\n\t\tfor _, dep := range step.DependsOn {\r\n\t\t\tif !names[dep] {\r\n\t\t\t\treturn fmt.Errorf(\"step %s depends on unknown step %s\", step.Name, dep)\r\n\t\t\t}\r\n"]
[6737.063364, "o", "\t\t}\r\n\t}\r\n\r\n\tif cycle := findCycle(cfg.Steps); cycle != nil {\r\n\t\treturn fmt.Errorf(\"cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n"]
[6737.063468, "o", "\t}\r\n\r\n\tproducers := make(map[string]string)\r\n\tfor _, step := range cfg.Steps {\r\n\t\tfor _, out := range step.Outputs {\r\n\t\t\tif _, ok := producers[out]; ok {\r\n\t\t\t\treturn fmt.Errorf(\"duplicate output artifact: %s\", out)\r\n\t\t\t}\r\n\t\t\tproducers[out] = step.Name\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, step := range cfg.Steps {\r\n\t\tfor _, in := range step.Inputs {\r\n\t\t\tprod, ok := producers[in]\r\n\t\t\tif !ok {\r\n\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s is not produced by any step\", step.Name, in)\r\n\t\t\t}\r\n\t\t\tif prod == step.Name {\r\n\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s must come from a dependency\", step.Name, in)\r\n\t\t\t}\r\n\t\t\tif !isTransitiveDependency(cfg.Steps, step.Name, prod) {\r\n\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s producer %s is not a transitive dependency\", step.Name, in, prod)\r\n\t\t\t}\r\n"]
[6737.063507, "o", "\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc findCycle(steps []*PipelineStep) []string {\r\n\tgraph := make(map[string][]string)\r\n\tfor _, s := range steps {\r\n\t\tgraph[s.Name] = append(graph[s.Name], s.DependsOn...)\r\n\t}\r\n\tvisited := make(map[string]int)\r\n\tvar stack []string\r\n\tvar dfs func(node string) []string\r\n\tdfs = func(node string) []string {\r\n\t\tvisited[node] = 1\r\n\t\tstack = append(stack, node)\r\n\t\tfor _, dep := range graph[node] {\r\n\t\t\tif visited[dep] == 1 {\r\n"]
[6737.063649, "o", "\t\t\t\tfor i, n := range stack {\r\n\t\t\t\t\tif n == dep {\r\n\t\t\t\t\t\treturn append(append([]string{}, stack[i:]...), dep)\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\treturn []string{node, dep}\r\n\t\t\t}\r\n\t\t\tif visited[dep] == 0 {\r\n"]
[6737.064329, "o", "\u001b[?2004h"]
[6737.064425, "o", "root@n30009:/app# "]
[6737.580333, "i", "sed -n '1,260p' store.go\n"]
[6737.580593, "o", "sed -n '1,260p' store.go\r\n"]
[6737.580645, "o", "\u001b[?2004l\r"]
[6737.58381, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[6737.583903, "o", "\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sync\"\r\n)\r\n\r\n// Store manages persistence for all entities\r\ntype Store struct {\r\n\tdataDir  string\r\n\tdataFile string\r\n\tmu       sync.RWMutex\r\n\tdata     *StoreData\r\n}\r\n\r\nfunc NewStore(dataDir string) (*Store, error) {\r\n\tif dataDir == \"\" {\r\n\t\tdataDir = filepath.Join(os.TempDir(), \"nexus\")\r\n\t}\r\n\tif err := os.MkdirAll(dataDir, 0755); err != nil {\r\n"]
[6737.583988, "o", "\t\treturn nil, fmt.Errorf(\"create data directory: %w\", err)\r\n\t}\r\n\r\n\ts := &Store{\r\n\t\tdataDir:  dataDir,\r\n\t\tdataFile: filepath.Join(dataDir, \"nexus_data.json\"),\r\n\t\tdata: &StoreData{\r\n\t\t\tModels:      make(map[string]*Model),\r\n\t\t\tExperiments: make(map[string]*Experiment),\r\n\t\t\tDatasets:    make(map[string]*Dataset),\r\n\t\t\tTagIndex:    make(map[string][]string),\r\n\t\t},\r\n\t}\r\n\r\n"]
[6737.584084, "o", "\tif err := s.load(); err != nil && !os.IsNotExist(err) {\r\n\t\treturn nil, fmt.Errorf(\"load store: %w\", err)\r\n\t}\r\n\r\n\treturn s, nil\r\n}\r\n\r\nfunc (s *Store) load() error {\r\n\tdata, err := os.ReadFile(s.dataFile)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn json.Unmarshal(data, s.data)\r\n}\r\n\r\n"]
[6737.584148, "o", "func (s *Store) save() error {\r\n\tdata, err := json.MarshalIndent(s.data, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn fmt.Errorf(\"marshal data: %w\", err)\r\n\t}\r\n\ttmpFile := s.dataFile + \".tmp\"\r\n\tif err := os.WriteFile(tmpFile, data, 0644); err != nil {\r\n\t\treturn fmt.Errorf(\"write temp file: %w\", err)\r\n\t}\r\n"]
[6737.584214, "o", "\treturn os.Rename(tmpFile, s.dataFile)\r\n}\r\n\r\n// UpdateTagIndex maintains a shared tag index across all entity types.\r\n// This index is global: a tag search returns both model and experiment keys.\r\nfunc (s *Store) UpdateTagIndex(entityKey string, tags []string) {\r\n\tfor tag, keys := range s.data.TagIndex {\r\n\t\tfiltered := make([]string, 0)\r\n\t\tfor _, k := range keys {\r\n\t\t\tif k != entityKey {\r\n\t\t\t\tfiltered = append(filtered, k)\r\n\t\t\t}\r\n"]
[6737.584274, "o", "\t\t}\r\n\t\tif len(filtered) == 0 {\r\n\t\t\tdelete(s.data.TagIndex, tag)\r\n\t\t} else {\r\n\t\t\ts.data.TagIndex[tag] = filtered\r\n\t\t}\r\n\t}\r\n\tfor _, tag := range tags {\r\n"]
[6737.584337, "o", "\t\ts.data.TagIndex[tag] = append(s.data.TagIndex[tag], entityKey)\r\n\t}\r\n}\r\n\r\n// FindByTag returns all entity keys with the given tag\r\nfunc (s *Store) FindByTag(tag string) []string {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.data.TagIndex[tag]\r\n}\r\n\r\n"]
[6737.584404, "o", "// === Model operations ===\r\n\r\nfunc (s *Store) SaveModel(m *Model) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\tkey := m.Key()\r\n"]
[6737.584468, "o", "\ts.data.Models[key] = m\r\n\ts.UpdateTagIndex(\"model:\"+key, m.Tags)\r\n\treturn s.save()\r\n}\r\n\r\nfunc (s *Store) GetModel(name, version string) (*Model, error) {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\r\n\tkey := fmt.Sprintf(\"%s:%s\", name, version)\r\n\tm, ok := s.data.Models[key]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"model not found: %s\", key)\r\n\t}\r\n\treturn m, nil\r\n}\r\n\r\n"]
[6737.584533, "o", "func (s *Store) ListModels(filter string) []*Model {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\r\n\tvar result []*Model\r\n\tfor _, m := range s.data.Models {\r\n"]
[6737.584594, "o", "\t\tif filter == \"\" || m.Name == filter || string(m.Status) == filter {\r\n\t\t\tresult = append(result, m)\r\n\t\t}\r\n\t}\r\n\treturn result\r\n}\r\n\r\nfunc (s *Store) DeleteModel(name, version string) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\tkey := fmt.Sprintf(\"%s:%s\", name, version)\r\n\tif _, ok := s.data.Models[key]; !ok {\r\n\t\treturn fmt.Errorf(\"model not found: %s\", key)\r\n\t}\r\n\r\n\t// Referential integrity: cannot delete models referenced by experiments\r\n\tfor _, exp := range s.data.Experiments {\r\n"]
[6737.584659, "o", "\t\tif exp.ModelRef == key {\r\n\t\t\treturn fmt.Errorf(\"model %s is referenced by experiment %s\", key, exp.ID)\r\n\t\t}\r\n\t}\r\n\r\n\tdelete(s.data.Models, key)\r\n"]
[6737.584776, "o", "\ts.UpdateTagIndex(\"model:\"+key, nil)\r\n\treturn s.save()\r\n}\r\n\r\n// === Experiment operations ===\r\n\r\nfunc (s *Store) SaveExperiment(exp *Experiment) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\t// Validate model reference if set\r\n\tif exp.ModelRef != \"\" {\r\n\t\tif _, ok := s.data.Models[exp.ModelRef]; !ok {\r\n\t\t\treturn fmt.Errorf(\"referenced model not found: %s\", exp.ModelRef)\r\n\t\t}\r\n\t}\r\n\r\n\t// Validate dataset reference if set\r\n\tif exp.DatasetRef != \"\" {\r\n\t\tif _, ok := s.data.Datasets[exp.DatasetRef]; !ok {\r\n\t\t\treturn fmt.Errorf(\"referenced dataset not found: %s\", exp.DatasetRef)\r\n\t\t}\r\n\t}\r\n\r\n\ts.data.Experiments[exp.ID] = exp\r\n"]
[6737.584852, "o", "\ts.UpdateTagIndex(\"experiment:\"+exp.ID, exp.Tags)\r\n\treturn s.save()\r\n}\r\n\r\nfunc (s *Store) GetExperiment(id string) (*Experiment, error) {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\r\n\texp, ok := s.data.Experiments[id]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"experiment not found: %s\", id)\r\n\t}\r\n\treturn exp, nil\r\n}\r\n"]
[6737.584916, "o", "\r\nfunc (s *Store) ListExperiments(filter string) []*Experiment {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\r\n\tvar result []*Experiment\r\n\tfor _, exp := range s.data.Experiments {\r\n\t\tif filter == \"\" || exp.Name == filter || string(exp.Status) == filter {\r\n\t\t\tresult = append(result, exp)\r\n\t\t}\r\n\t}\r\n"]
[6737.584985, "o", "\treturn result\r\n}\r\n\r\n// === Dataset operations ===\r\n\r\nfunc (s *Store) SaveDataset(ds *Dataset) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\ts.data.Datasets[ds.Key()] = ds\r\n\treturn s.save()\r\n}\r\n\r\nfunc (s *Store) GetDataset(name, version string) (*Dataset, error) {\r\n\ts.mu.RLock()\r\n"]
[6737.585053, "o", "\tdefer s.mu.RUnlock()\r\n\r\n\tkey := fmt.Sprintf(\"%s:%s\", name, version)\r\n\tds, ok := s.data.Datasets[key]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"dataset not found: %s\", key)\r\n\t}\r\n\treturn ds, nil\r\n}\r\n"]
[6737.585114, "o", "\r\nfunc (s *Store) ListDatasets() []*Dataset {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\r\n\tvar result []*Dataset\r\n\tfor _, ds := range s.data.Datasets {\r\n\t\tresult = append(result, ds)\r\n\t}\r\n\treturn result\r\n"]
[6737.585172, "o", "}\r\n"]
[6737.585624, "o", "\u001b[?2004h"]
[6737.585683, "o", "root@n30009:/app# "]
[6744.23841, "i", "grep -R \"func .*Pipeline\\|pipeline \\|handlePipeline\\|printUsage\\|listRuns\\|loadRun\\|pipelineHistory\" -n *.go\n"]
[6744.239264, "o", "grep -R \"func .*Pipeline\\|pipeline \\|handlePipeline\\|printUsage\\|listRuns\\|loadRun\\|pipelineHistory\" -n *.go\r\n"]
