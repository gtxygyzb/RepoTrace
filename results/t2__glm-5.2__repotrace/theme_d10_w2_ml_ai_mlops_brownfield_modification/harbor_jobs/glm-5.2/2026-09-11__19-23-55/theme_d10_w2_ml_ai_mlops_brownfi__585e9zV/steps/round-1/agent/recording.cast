[4085.213448, "o", "   569\t\t\t}\r\n   570\t\t\tenvVars = append(envVars, k+\"=\"+ev)\r\n   571\t\t}\r\n   572\t\r\n   573\t\tmaxRetries := 0\r\n   574\t\tbackoffBase := 1\r\n   575\t\tif step.Retry != nil {\r\n   576\t\t\tmaxRetries = step.Retry.MaxRetries\r\n"]
[4085.213508, "o", "   577\t\t\tif step.Retry.BackoffBaseSeconds > 0 {\r\n   578\t\t\t\tbackoffBase = step.Retry.BackoffBaseSeconds\r\n   579\t\t\t}\r\n   580\t\t}\r\n   581\t\r\n   582\t\tvar exp *Experiment\r\n   583\t\tif step.Type == \"train\" {\r\n   584\t\t\tvar err error\r\n"]
