[2527.757859, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path(\"main.go\")\ns = p.read_text()\nold = '''func getFlag(args []string, flag, defaultVal string) string {\n\\tfor i, a := range args {\n\\t\\tif a == flag && i+1 < len(args) {\n\\t\\t\\treturn args[i+1]\n\\t\\t}\n\\t}\n\\treturn defaultVal\n}\n'''\nnew = '''func getFlag(args []string, flag, defaultVal string) string {\n\\tprefix := flag + \"=\"\n\\tfor i, a := range args {\n\\t\\tif a == flag && i+1 < len(args) {\n\\t\\t\\treturn args[i+1]\n\\t\\t}\n\\t\\tif strings.HasPrefix(a, prefix) {\n\\t\\t\\treturn a[len(prefix):]\n\\t\\t}\n\\t}\n\\treturn defaultVal\n}\n'''\nassert old in s\ns = s.replace(old, new, 1)\np.write_text(s)\nPY\ngofmt -w *.go\ngo build ./...\n"]
