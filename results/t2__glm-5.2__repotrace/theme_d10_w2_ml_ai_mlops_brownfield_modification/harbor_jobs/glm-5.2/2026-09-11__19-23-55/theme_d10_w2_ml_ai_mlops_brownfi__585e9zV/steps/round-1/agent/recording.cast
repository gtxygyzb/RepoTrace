[67.048117, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"time\"\r\n     6\t)\r\n"]
[67.048204, "o", "     7\t\r\n     8\t// ModelStatus represents the lifecycle stage of a model\r\n     9\ttype ModelStatus string\r\n    10\t\r\n    11\tconst (\r\n    12\t\tModelStatusRegistered ModelStatus = \"registered\"\r\n    13\t\tModelStatusStaging    ModelStatus = \"staging\"\r\n    14\t\tModelStatusProduction ModelStatus = \"production\"\r\n    15\t\tModelStatusArchived   ModelStatus = \"archived\"\r\n    16\t)\r\n    17\t\r\n    18\t// Model represents an ML model in the registry\r\n    19\ttype Model struct {\r\n    20\t\t"]
[67.048283, "o", "Name        string             `json:\"name\"`\r\n    21\t\tVersion     string             `json:\"version\"`\r\n    22\t\tFramework   string             `json:\"framework\"`\r\n    23\t\tDescription string             `json:\"description,omitempty\"`\r\n    24\t\tTags        []string           `json:\"tags,omitempty\"`\r\n    25\t\tStatus      ModelStatus        `json:\"status\"`\r\n    26\t\tMetrics     map[string]float64 `json:\"metrics,omitempty\"`\r\n    27\t\tCreatedAt   time.Time          `json:\"created_at\"`\r\n    28\t\tUpdatedAt   time.Time          `json:\"updated_at\"`\r\n    29\t\tParentRef   string             `json:\"parent_ref,omitempty\"`\r\n    30\t}\r\n"]
[67.04836, "o", "    31\t\r\n    32\tfunc (m *Model) Key() string {\r\n    33\t\treturn fmt.Sprintf(\"%s:%s\", m.Name, m.Version)\r\n    34\t}\r\n    35\t\r\n    36\t// ValidTransitions defines valid model lifecycle transitions\r\n    37\tvar ValidTransitions = map[ModelStatus][]ModelStatus{\r\n"]
[67.048421, "o", "    38\t\tModelStatusRegistered: {ModelStatusStaging, ModelStatusArchived},\r\n    39\t\tModelStatusStaging:    {ModelStatusProduction, ModelStatusRegistered, ModelStatusArchived},\r\n    40\t\tModelStatusProduction: {ModelStatusStaging, ModelStatusArchived},\r\n    41\t\tModelStatusArchived:   {ModelStatusRegistered},\r\n    42\t}\r\n    43\t\r\n    44\tfunc (m *Model) CanTransitionTo(target ModelStatus) bool {\r\n    45\t\tallowed, ok := ValidTransitions[m.Status]\r\n    46\t\tif !ok {\r\n    47\t\t\treturn false\r\n    48\t\t}\r\n    49\t\tfor _, s := range allowed {\r\n"]
[67.048478, "o", "    50\t\t\tif s == target {\r\n    51\t\t\t\treturn true\r\n    52\t\t\t}\r\n    53\t\t}\r\n    54\t\treturn false\r\n    55\t}\r\n    56\t\r\n    57\t// ExperimentStatus represents the state of an experiment run\r\n"]
[67.048538, "o", "    58\ttype ExperimentStatus string\r\n    59\t\r\n    60\tconst (\r\n    61\t\tExperimentStatusRunning   ExperimentStatus = \"running\"\r\n    62\t\tExperimentStatusCompleted ExperimentStatus = \"completed\"\r\n    63\t\tExperimentStatusFailed    ExperimentStatus = \"failed\"\r\n    64\t)\r\n    65\t\r\n    66\t// Experiment represents an ML experiment run\r\n    67"]
[67.048598, "o", "\ttype Experiment struct {\r\n    68\t\tID         string             `json:\"id\"`\r\n    69\t\tName       string             `json:\"name\"`\r\n    70\t\tStatus     ExperimentStatus   `json:\"status\"`\r\n    71\t\tParameters map[string]string  `json:\"parameters,omitempty\"`\r\n    72\t\tMetrics    map[string]float64 `json:\"metrics,omitempty\"`\r\n    73\t\tTags       []string           `json:\"tags,omitempty\"`\r\n    74\t\tModelRef   string             `json:\"model_ref,omitempty\"`\r\n    75\t\tDatasetRef string             `json:\"dataset_ref,omitempty\"`\r\n    76\t\tStartTime  time.Time          `json:\"start_time\"`"]
[67.048656, "o", "\r\n    77\t\tEndTime    time.Time          `json:\"end_time,omitempty\"`\r\n    78\t\tNotes      string             `json:\"notes,omitempty\"`\r\n    79\t}\r\n    80\t\r\n    81\t// Dataset represents a dataset version\r\n    82\ttype Dataset struct {\r\n    83\t\tName      string    `json:\"name\"`\r\n"]
[67.048714, "o", "    84\t\tVersion   string    `json:\"version\"`\r\n    85\t\tFormat    string    `json:\"format\"`\r\n    86\t\tPath      string    `json:\"path\"`\r\n    87\t\tRowCount  int64     `json:\"row_count\"`\r\n    88\t\tSchema    []Column  `json:\"schema,omitempty\"`\r\n    89\t\tCreatedAt time.Time `json:\"created_at\"`\r\n    90\t\tChecksum  string    `json:\"checksum,omitempty\"`\r\n    91\t}\r\n    92\t\r\n"]
[67.04877, "o", "    93\tfunc (d *Dataset) Key() string {\r\n    94\t\treturn fmt.Sprintf(\"%s:%s\", d.Name, d.Version)\r\n    95\t}\r\n    96\t\r\n    97\t// Column represents a dataset column\r\n    98\ttype Column struct {\r\n    99\t\tName     string `json:\"name\"`\r\n   100\t\tType     string `json:\"type\"`\r\n   101\t\tNullable bool   `json:\"nullable\"`\r\n   102\t"]
[67.048827, "o", "}\r\n   103\t\r\n   104\t// StoreData holds all persisted data\r\n   105\ttype StoreData struct {\r\n   106\t\tModels      map[string]*Model      `json:\"models\"`\r\n   107\t\tExperiments map[string]*Experiment `json:\"experiments\"`\r\n   108\t\tDatasets    map[string]*Dataset    `json:\"datasets\"`\r\n   109"]
[67.048904, "o", "\t\tTagIndex    map[string][]string    `json:\"tag_index\"`\r\n   110\t}\r\n"]
