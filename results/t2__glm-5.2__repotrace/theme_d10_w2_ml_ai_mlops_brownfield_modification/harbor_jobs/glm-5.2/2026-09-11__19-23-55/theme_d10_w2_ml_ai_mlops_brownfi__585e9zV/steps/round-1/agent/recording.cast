[6198.364388, "o", "\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tSteps:       make([]*\u001b[01;31m\u001b[KStepRun\u001b[m\u001b[K, 0, len(cfg.Steps)),\r\n\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\trun.Steps = append(run.Steps, &\u001b[01;31m\u001b[KStepRun\u001b[m\u001b[K{Name: step.Name, Type: step.Type, Status: \"pending\"})\r\n"]
