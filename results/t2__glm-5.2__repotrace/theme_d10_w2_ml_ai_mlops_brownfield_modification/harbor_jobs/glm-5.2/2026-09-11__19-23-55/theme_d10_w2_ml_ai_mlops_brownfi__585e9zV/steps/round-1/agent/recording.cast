[4390.023094, "o", "\u001b[32m\u001b[K888\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K889\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc containsString(list []string, s string) bool {\r\n\u001b[32m\u001b[K890\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, x := range list {\r\n\u001b[32m\u001b[K891\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif x == s {\r\n\u001b[32m\u001b[K892\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn true\r\n\u001b[32m\u001b[K893\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K894\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K895\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn false\r\n"]
