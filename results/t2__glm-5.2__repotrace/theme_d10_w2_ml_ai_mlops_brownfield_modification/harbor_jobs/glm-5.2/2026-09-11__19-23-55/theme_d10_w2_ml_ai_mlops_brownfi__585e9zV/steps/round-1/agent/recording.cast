[6231.820269, "o", "   320\t\t\tPipeline:    cfg.Name,\r\n   321\t\t\tStatus:      \"running\",\r\n   322\t\t\tParameters:  merged,\r\n   323\t\t\tStartTime:   &now,\r\n"]
[6231.820404, "o", "   324\t\t\tRunDir:      runDir,\r\n   325\t\t\tVariables:   copyMap(merged),\r\n   326\t\t\tWarnings:    []string{},\r\n   327\t\t\tTags:        copyTags(cfg.Tags),\r\n   328\t\t\tDescription: cfg.Description,\r\n   329\t\t\tSteps:       make([]*StepRun, 0, len(cfg.Steps)),\r\n   330\t"]
[6231.820549, "o", "\t}\r\n   331\t\tfor _, step := range cfg.Steps {\r\n   332\t\t\trun.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: \"pending\"})\r\n   333\t\t}\r\n   334\t\tsaveRun(run)\r\n   335\t\r\n   336\t\terr := executeSteps(cfg, run, tracker, merged, maxParallel)\r\n   337\t\tendTime := time.Now()\r\n   338\t\trun.EndTime = &endTime\r\n   339\t\tif err != nil {\r\n   340\t\t\trun.Status = \"failed\"\r\n   341\t\t} else if run.Status != \"succeeded_with_warnings\" {\r\n   342\t\t\trun.Status = \"succeeded\"\r\n   343\t\t}\r\n   344\t\tsaveRun(run)\r\n   345\t\treturn run, err\r\n"]
