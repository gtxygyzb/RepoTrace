[4782.601532, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\np = Path('pipeline.go')\ns = p.read_text()\n\nnew_func = '''func evaluateCondition(cond string, vars map[string]string) (bool, error) {\n\\tcond = strings.TrimSpace(cond)\n\\tif cond == \"\" {\n\\t\\treturn true, nil\n\\t}\n\n\\tunresolved := false\n\n\\tsubstitute := func(s string) (string, bool) {\n\\t\\tres, err := substituteVariables(strings.TrimSpace(s), vars)\n\\t\\tif err != nil {\n\\t\\t\\tunresolved = true\n\\t\\t\\treturn \"\", false\n\\t\\t}\n\\t\\treturn res, true\n\\t}\n\n\\tevalPrimitive := func(expr string) (bool, error) {\n\\t\\texpr = strings.TrimSpace(expr)\n\\t\\tif expr == \"\" {\n\\t\\t\\treturn false, fmt.Errorf(\"invalid condition: empty expression\")\n\\t\\t}\n\n\\t\\tif parts := strings.SplitN(expr, \" contains \", 2); len(parts) == 2 {\n\\t\\t\\tleft, ok := substitute(parts[0])\n\\t\\t\\tif !ok {\n\\t\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\tright, ok := substitute(parts[1])\n\\t\\t\\tif !ok {\n\\t\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\treturn strings.Contains(left, right), nil\n\\t\\t}\n\n\\t\\tif parts := strings.SplitN(expr, "]
[4782.601835, "i", "\"==\", 2); len(parts) == 2 {\n\\t\\t\\tleft, ok := substitute(parts[0])\n\\t\\t\\tif !ok {\n\\t\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\tright, ok := substitute(parts[1])\n\\t\\t\\tif !ok {\n\\t\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\treturn left == right, nil\n\\t\\t}\n\n\\t\\tif parts := strings.SplitN(expr, \"!=\", 2); len(parts) == 2 {\n\\t\\t\\tleft, ok := substitute(parts[0])\n\\t\\t\\tif !ok {\n\\t\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\tright, ok := substitute(parts[1])\n\\t\\t\\tif !ok {\n\\t\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\treturn left != right, nil\n\\t\\t}\n\n\\t\\t// A bare token may be a forward reference. Treat unresolved variables as\n\\t\\t// false rather than a runtime error, while still rejecting invalid syntax.\n\\t\\tif _, ok := substitute(expr); !ok {\n\\t\\t\\treturn false, nil\n\\t\\t}\n\\t\\treturn false, fmt.Errorf(\"invalid condition: %s\", expr)\n\\t}\n\n\\t// Evaluate every primitive so unresolved references in short-circuited\n\\t// branches still force the whole condition to false. && binds tighter than\n\\t// ||, so split OR first and AND second.\n\\torGroups "]
