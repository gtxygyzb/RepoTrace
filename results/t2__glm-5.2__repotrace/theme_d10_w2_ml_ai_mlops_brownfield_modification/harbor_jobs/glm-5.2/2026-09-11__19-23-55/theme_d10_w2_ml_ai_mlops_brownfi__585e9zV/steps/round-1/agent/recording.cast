[1986.317001, "o", "\\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n\u001b[?2004l\r"]
[1986.317067, "o", "\u001b[?2004h> "]
[1986.31737, "o", "\\tSteps      []*StepRun        `json:\"steps\"`\r\n\u001b[?2004l\r"]
[1986.317425, "o", "\u001b[?2004h> "]
