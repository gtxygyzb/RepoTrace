[4018.712198, "o", "\tendTime := time.Now()\r\n\trun.EndTime = &endTime\r\n\tif err != nil {\r\n\t\trun.Status = \"failed\"\r\n\t} else if run.Status != \"succeeded_with_warnings\" {\r\n\t\trun.Status = \"succeeded\"\r\n\t}\r\n\tsaveRun(run)\r\n\treturn run, err\r\n}\r\n\r\nfunc executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n\tstepByName := make(map[string]*PipelineStep)\r\n\tfor _, s := range cfg.Steps {\r\n\t\tstepByName[s.Name] = s\r\n\t}\r\n\trunStepByName := make(map[string]*StepRun)\r\n\tfor _, sr := range run.Steps {\r\n\t\trunStepByName[sr.Name] = sr\r\n\t}\r\n\r\n\tvariables := make(map[string]string)\r\n\tif run.Variables != nil {\r\n\t\tfor k, v := range run.Variables {\r\n\t\t\tvariables[k] = v\r\n\t\t}\r\n\t} else {\r\n\t\tfor k, v := range params {\r\n\t\t\tvariables[k] = v\r\n\t\t}\r\n"]
[4018.712276, "o", "\t}\r\n\tif run.Warnings == nil {\r\n\t\trun.Warnings = []string{}\r\n\t}\r\n\r\n\tvar varMu sync.Mutex\r\n\r\n\tfor _, step := range cfg.Steps {\r\n\t\tsr := runStepByName[step.Name]\r\n\t\tif sr != nil && (sr.Status == \"succeeded\" || sr.Status == \"skipped\") {\r\n\t\t\tvariables[\"steps.\"+step.Name+\".status\"] = sr.Status\r\n\t\t}\r\n"]
[4018.712345, "o", "\t}\r\n\r\n\tvar mu sync.Mutex\r\n\tvar running []*PipelineStep\r\n\tavailable := make(chan struct{}, maxParallel)\r\n\r\n\tpending := make(map[string]bool)\r\n\tfor _, step := range cfg.Steps {\r\n\t\tsr := runStepByName[step.Name]\r\n\t\tif sr.Status == \"succeeded\" || sr.Status == \"skipped\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\t"]
[4018.712405, "o", "if sr.Status == \"failed\" {\r\n\t\t\tsr.Status = \"pending\"\r\n\t\t\tsr.Error = \"\"\r\n\t\t\tsr.Output = \"\"\r\n\t\t\tsr.StartTime = nil\r\n\t\t\tsr.EndTime = nil\r\n\t\t}\r\n\t\tpending[step.Name] = true\r\n\t}\r\n\r\n"]
[4018.712527, "o", "\tvar wg sync.WaitGroup\r\n\tdone := false\r\n\r\n\tcanStart := func(step *PipelineStep) bool {\r\n\t\tfor _, dep := range step.DependsOn {\r\n\t\t\tstatus := runStepByName[dep].Status\r\n\t\t\tif status == \"succeeded\" || status == \"skipped\" {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif status == \"failed\" {\r\n\t\t\t\tif depStep := stepByName[dep]; depStep != nil && depStep.AllowFailure {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\treturn false\r\n\t\t}\r\n"]
[4018.712651, "o", "\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n\t\t\tvar cpu, mem int\r\n\t\t\tfor _, r := range running {\r\n\t\t\t\tif r.Resources != nil {\r\n\t\t\t\t\tcpu += r.Resources.CPU\r\n\t\t\t\t\tmem += r.Resources.MemoryMB\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n\t\t\t\treturn false\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn true\r\n\t}\r\n\r\n\tstartStep := func(step *PipelineStep) {\r\n\t\tpending[step.Name] = false\r\n\t\trunning = append(running, step)\r\n\t\twg.Add(1)\r\n"]
[4018.712723, "o", "\t\tgo func(s *PipelineStep) {\r\n\t\t\tdefer wg.Done()\r\n\t\t\texecuteStep(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])\r\n\t\t\tmu.Lock()\r\n\t\t\trunning = removeStep(running, s)\r\n\t\t\tstatus := runStepByName[s.Name].Status\r\n\t\t\tif status == \"failed\" {\r\n\t\t\t\tif s.AllowFailure {\r\n"]
[4018.712787, "o", "\t\t\t\t\tif !containsString(run.Warnings, s.Name) {\r\n\t\t\t\t\t\trun.Warnings = append(run.Warnings, s.Name)\r\n\t\t\t\t\t}\r\n\t\t\t\t} else {\r\n\t\t\t\t\trun.Status = \"failed\"\r\n\t\t\t\t\tdone = true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tvarMu.Lock()\r\n\t\t\t"]
[4018.712847, "o", "variables[\"steps.\"+s.Name+\".status\"] = status\r\n\t\t\trun.Variables = copyMap(variables)\r\n\t\t\tvarMu.Unlock()\r\n\t\t\tsaveCheckpoint(run)\r\n\t\t\tsaveRun(run)\r\n\t\t\tmu.Unlock()\r\n\t\t\t<-available\r\n\t\t}(step)\r\n\t}\r\n\r\n"]
[4018.712905, "o", "\tfor !done && (len(pending) > 0 || len(running) > 0) {\r\n\t\tstartedAny := false\r\n\t\tvar starts []*PipelineStep\r\n\t\tmu.Lock()\r\n\t\tfor _, step := range cfg.Steps {\r\n\t\t\tif pending[step.Name] && canStart(step) {\r\n\t\t\t\tstarts = append(starts, step)\r\n"]
[4018.712963, "o", "\t\t\t}\r\n\t\t}\r\n\t\tmu.Unlock()\r\n\t\tsort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })\r\n\t\tfor _, step := range starts {\r\n\t\t\tavailable <- struct{}{}\r\n\t\t\tmu.Lock()\r\n\t\t\tif done || !pending[step.Name] || !canStart(step) {\r\n"]
