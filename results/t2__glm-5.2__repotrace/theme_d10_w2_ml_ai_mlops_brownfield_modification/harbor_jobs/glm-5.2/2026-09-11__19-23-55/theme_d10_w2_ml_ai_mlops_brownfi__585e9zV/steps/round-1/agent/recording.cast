[2183.992667, "o", "func buildPipelineGraph(cfg *PipelineConfig) map[string]interface{} {\r\n\u001b[?2004l\r"]
[2183.992716, "o", "\u001b[?2004h> "]
[2183.993049, "o", "\\tnodes := make([]map[string]string, 0, len(cfg.Steps))\r\n\u001b[?2004l\r"]
[2183.993109, "o", "\u001b[?2004h> "]
[2183.993294, "o", "\\tfor _, s := range cfg.Steps {\r\n\u001b[?2004l\r"]
[2183.993349, "o", "\u001b[?2004h> "]
[2183.993782, "o", "\\t\\tnodes = append(nodes, map[string]string{\"name\": s.Name, \"type\": s.Type})\r\n\u001b[?2004l\r"]
[2183.993848, "o", "\u001b[?2004h> "]
[2183.993903, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2183.993958, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[2183.994014, "o", "> "]
[2183.994227, "o", "\\tedges := make([]map[string]string, 0)\r\n\u001b[?2004l\r"]
[2183.994282, "o", "\u001b[?2004h> "]
[2183.994467, "o", "\\tfor _, s := range cfg.Steps {\r\n\u001b[?2004l\r"]
[2183.994527, "o", "\u001b[?2004h> "]
[2183.994743, "o", "\\t\\tfor _, dep := range s.DependsOn {\r\n\u001b[?2004l\r"]
[2183.994797, "o", "\u001b[?2004h> "]
[2183.995222, "o", "\\t\\t\\tedges = append(edges, map[string]string{\"from\": dep, \"to\": s.Name})\r\n\u001b[?2004l\r"]
[2183.995278, "o", "\u001b[?2004h> "]
[2183.995332, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[2183.995388, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2183.995443, "o", "\u001b[?2004h> \r\n"]
[2183.995497, "o", "\u001b[?2004l\r\u001b[?2004h"]
[2183.995553, "o", "> "]
[2183.99571, "o", "\\treturn map[string]interface{}{\r\n\u001b[?2004l\r"]
[2183.995777, "o", "\u001b[?2004h> "]
[2183.995891, "o", "\\t\\t\"nodes\":  nodes,\r\n\u001b[?2004l\r"]
[2183.995952, "o", "\u001b[?2004h> "]
[2183.996085, "o", "\\t\\t\"edges\":  edges,\r\n\u001b[?2004l\r"]
[2183.996143, "o", "\u001b[?2004h> "]
[2183.996374, "o", "\\t\\t\"levels\": computeLevels(cfg.Steps),\r\n\u001b[?2004l\r"]
[2183.996429, "o", "\u001b[?2004h> "]
[2183.996486, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
