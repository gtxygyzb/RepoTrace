[2184.005925, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[2184.005971, "o", "\u001b[?2004h> "]
[2184.006179, "o", "\\t\\tif status != \"\" && run.Status != status {\r\n\u001b[?2004l\r"]
[2184.006235, "o", "\u001b[?2004h> "]
[2184.006288, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[2184.006343, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[2184.006388, "o", "\u001b[?2004h> "]
[2184.006485, "o", "\\t\\tduration := 0.0\r\n\u001b[?2004l\r"]
[2184.006541, "o", "\u001b[?2004h> "]
[2184.006752, "o", "\\t\\tif run.StartTime != nil && run.EndTime != nil {\r\n\u001b[?2004l\r"]
[2184.006808, "o", "\u001b[?2004h> "]
[2184.007035, "o", "\\t\\t\\tduration = run.EndTime.Sub(*run.StartTime).Seconds()\r\n\u001b[?2004l\r"]
[2184.007097, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[2184.007146, "o", "\u001b[?2004h> "]
[2184.007336, "o", "\\t\\tout = append(out, PipelineHistoryEntry{\r\n\u001b[?2004l\r"]
[2184.007391, "o", "\u001b[?2004h> "]
[2184.007512, "o", "\\t\\t\\tID:              run.ID,\r\n\u001b[?2004l\r"]
[2184.007568, "o", "\u001b[?2004h> "]
[2184.007701, "o", "\\t\\t\\tStatus:          run.Status,\r\n\u001b[?2004l\r"]
[2184.007757, "o", "\u001b[?2004h> "]
[2184.007902, "o", "\\t\\t\\tStartTime:       run.StartTime,\r\n\u001b[?2004l\r"]
[2184.00796, "o", "\u001b[?2004h> "]
[2184.008099, "o", "\\t\\t\\tEndTime:         run.EndTime,\r\n\u001b[?2004l\r"]
[2184.008155, "o", "\u001b[?2004h> "]
[2184.008279, "o", "\\t\\t\\tDurationSeconds: duration,\r\n\u001b[?2004l\r"]
[2184.008335, "o", "\u001b[?2004h> \\t\\t})\r\n\u001b[?2004l\r"]
[2184.00839, "o", "\u001b[?2004h> "]
[2184.008445, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2184.008625, "o", "\\tsort.Slice(out, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[2184.008682, "o", "\u001b[?2004h> "]
[2184.008914, "o", "\\t\\tif out[i].StartTime == nil || out[j].StartTime == nil {\r\n\u001b[?2004l\r"]
[2184.00897, "o", "\u001b[?2004h> "]
[2184.009108, "o", "\\t\\t\\treturn out[i].ID > out[j].ID\r\n\u001b[?2004l\r"]
[2184.009165, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[2184.009192, "o", "\u001b[?2004h"]
[2184.009268, "o", "> "]
[2184.00944, "o", "\\t\\treturn out[i].StartTime.After(*out[j].StartTime)\r\n\u001b[?2004l\r"]
[2184.009467, "o", "\u001b[?2004h> "]
[2184.009571, "o", "\\t})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2184.009633, "o", "\\treturn out\r\n\u001b[?2004l\r"]
[2184.009694, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
