[6204.239029, "o", "func executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {\r\n\tfor _, dep := range step.DependsOn {\r\n\t\tdepStatus := getRunStep(run, dep).Status\r\n\t\tif depStatus == \"succeeded\" || depStatus == \"skipped\" {\r\n\t\t\t"]
[6204.239204, "o", "continue\r\n\t\t}\r\n\t\tif depStatus == \"failed\" {\r\n\t\t\tdepStep := getStepConfig(cfg, dep)\r\n\t\t\tif depStep != nil && depStep.AllowFailure {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t}\r\n\t\tsr.Status = \"failed\"\r\n\t\tsr.Error = \"dependency failed\"\r\n\t\treturn\r\n\t}\r\n\r\n\tvarMu.Lock()\r\n\tvars := copyMap(variables)\r\n\tvarMu.Unlock()\r\n\r\n\tif step.Condition != \"\" {\r\n\t\tcond, err := evaluateCondition(step.Condition, vars)\r\n\t\tif err != nil {\r\n\t\t\tsr.Status = \"failed\"\r\n\t\t\tsr.Error = err.Error()\r\n\t\t\treturn\r\n\t\t}\r\n\t\tif !cond {\r\n\t\t\tsr.Status = \"skipped\"\r\n"]
[6204.239287, "o", "\t\t\tsr.Output = \"condition false\"\r\n\t\t\tsr.Stdout = \"\"\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n\r\n\tcmdStr, err := substituteVariables(step.Command, vars)\r\n\tif err != nil {\r\n\t\tsr.Status = \"failed\"\r\n\t\tsr.Error = err.Error()\r\n\t\treturn\r\n\t}\r\n\r\n"]
[6204.239367, "o", "\tenvVars := os.Environ()\r\n\tfor k, v := range vars {\r\n\t\tenvVars = append(envVars, \"NEXUS_PARAM_\"+k+\"=\"+v)\r\n\t}\r\n\tfor k, v := range step.Env {\r\n\t\tev, err := substituteVariables(v, vars)\r\n\t\tif err != nil {\r\n\t\t\tsr.Status = \"failed\"\r\n\t\t\tsr.Error = fmt.Sprintf(\"env %s: %v\", k, err)\r\n\t\t\treturn\r\n\t\t}\r\n\t\tenvVars = append(envVars, k+\"=\"+ev)\r\n\t"]
[6204.239438, "o", "}\r\n\r\n\tmaxRetries := 0\r\n\tbackoffBase := 1\r\n\tif step.Retry != nil {\r\n\t\tmaxRetries = step.Retry.MaxRetries\r\n\t\tif step.Retry.BackoffBaseSeconds > 0 {\r\n\t\t\tbackoffBase = step.Retry.BackoffBaseSeconds\r\n\t\t}\r\n\t}\r\n\r\n"]
[6204.23951, "o", "\tvar exp *Experiment\r\n\tif step.Type == \"train\" {\r\n\t\tvar err error\r\n\t\texp, err = createTrainExperiment(tracker, step, sr.ExperimentID)\r\n\t\tif err != nil {\r\n\t\t\tsr.Status = \"failed\"\r\n\t\t\tsr.Error = err.Error()\r\n\t\t\treturn\r\n\t\t}\r\n\t\tsr.ExperimentID = exp.ID\r\n\t}\r\n\r\n\tfor attempt := 0; attempt <= maxRetries; attempt++ {\r\n"]
[6204.239582, "o", "\t\tstart := time.Now()\r\n\t\tsr.StartTime = &start\r\n\t\tsr.RetryCount = attempt\r\n\t\tstdout, stderr, exitCode, err := runShellCommand(cmdStr, step.TimeoutSeconds, envVars)\r\n\t\tsr.Stdout = stdout\r\n\t"]
[6204.239661, "o", "\tsr.Output = stdout\r\n\t\tif stderr != \"\" {\r\n\t\t\tif sr.Output != \"\" {\r\n\t\t\t\tsr.Output += \"\\n\"\r\n\t\t\t}\r\n\t\t\tsr.Output += stderr\r\n\t\t}\r\n\t\tsr.ExitCode = exitCode\r\n\t\tif err == nil {\r\n\t\t\tsr.EndTime = nowPtr()\r\n\t\t\tsr.Status = \"succeeded\"\r\n\t\t\tsr.Error = \"\"\r\n"]
[6204.239738, "o", "\t\t\tproduceArtifacts(run, step, sr, stdout)\r\n\t\t\tif step.Type == \"train\" && exp != nil {\r\n\t\t\t\tif terr := finishTrainExperiment(tracker, exp, step, stdout); terr != nil {\r\n\t\t\t\t\tsr.Status = \"failed\"\r\n\t\t\t\t\tsr.Error = terr.Error()\r\n\t\t\t\t\treturn\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif step.Type == \"evaluate\" {\r\n\t\t\t\tregisterEvaluateArtifacts(run, step, sr)\r\n\t\t\t}\r\n\t\t\tif step.CaptureOutput != nil {\r\n\t\t\t\tval, ok, cerr := captureOutputValue(step, stdout)\r\n\t\t\t\tif cerr != nil {\r\n\t\t\t\t\tsr.Status = \"failed\"\r\n\t"]
[6204.239805, "o", "\t\t\t\tsr.Error = cerr.Error()\r\n\t\t\t\t\treturn\r\n\t\t\t\t}\r\n\t\t\t\tif ok {\r\n\t\t\t\t\tvarMu.Lock()\r\n\t\t\t\t\tvariables[step.CaptureOutput.Name] = val\r\n\t\t\t\t\tvarMu.Unlock()\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\treturn\r\n"]
[6204.239876, "o", "\t\t}\r\n\t\tsr.Error = err.Error()\r\n\t\tif step.Type == \"train\" && exp != nil {\r\n\t\t\ttracker.Complete(exp.ID, ExperimentStatusFailed)\r\n\t\t}\r\n\t\tif attempt < maxRetries {\r\n\t\t\tdelay := time.Duration(math.Pow(float64(backoffBase), float64(attempt+1))) * time.Second\r\n\t\t\ttime.Sleep(delay)\r\n\t\t}\r\n\t}\r\n"]
[6204.239943, "o", "\tsr.EndTime = nowPtr()\r\n\tsr.Status = \"failed\"\r\n}\r\nfunc getRunStep(run *PipelineRun, name string) *StepRun {\r\n\tfor _, sr := range run.Steps {\r\n\t\tif sr.Name == name {\r\n\t\t\treturn sr\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc stepRunOutputValue(sr *StepRun) string {\r\n"]
[6204.240012, "o", "\tif sr == nil || sr.Status != \"succeeded\" {\r\n\t\treturn \"\"\r\n\t}\r\n\treturn strings.TrimSpace(sr.Stdout)\r\n}\r\n\r\nfunc stepRunDurationValue(sr *StepRun) string {\r\n\tif sr == nil || sr.StartTime == nil || sr.EndTime == nil {\r\n\t\treturn \"0.00\"\r\n\t}\r\n\t"]
[6204.240101, "o", "return fmt.Sprintf(\"%.2f\", sr.EndTime.Sub(*sr.StartTime).Seconds())\r\n}\r\n\r\nfunc getStepConfig(cfg *PipelineConfig, name string) *PipelineStep {\r\n\tfor _, step := range cfg.Steps {\r\n\t\tif step.Name == name {\r\n\t\t\treturn step\r\n\t\t}\r\n\t}\r\n"]
