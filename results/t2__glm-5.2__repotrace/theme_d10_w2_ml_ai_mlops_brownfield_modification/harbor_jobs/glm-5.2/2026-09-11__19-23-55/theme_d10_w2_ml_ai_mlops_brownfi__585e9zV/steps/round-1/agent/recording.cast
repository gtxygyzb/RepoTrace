[7054.476301, "o", "\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nconst dataDir = \"/tmp/nexus\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n"]
