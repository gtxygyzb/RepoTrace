[1229.747398, "o", "\u001b[?2004h> "]
[1229.747564, "o", "for i,l in enumerate(lines):\r\n\u001b[?2004l\r"]
[1229.747627, "o", "\u001b[?2004h> "]
[1229.748012, "o", "    if 'strings.Split(output,' in l and 'parseMetricLine' not in l:\r\n\u001b[?2004l\r"]
[1229.748096, "o", "\u001b[?2004h> "]
[1229.748512, "o", "        lines[i]='\\tfor _, line := range strings.Split(output, \"\\\\n\") {'\r\n\u001b[?2004l\r"]
[1229.748585, "o", "\u001b[?2004h> "]
[1229.748781, "o", "p.write_text('\\n'.join(lines)+'\\n')\r\n\u001b[?2004l\r"]
