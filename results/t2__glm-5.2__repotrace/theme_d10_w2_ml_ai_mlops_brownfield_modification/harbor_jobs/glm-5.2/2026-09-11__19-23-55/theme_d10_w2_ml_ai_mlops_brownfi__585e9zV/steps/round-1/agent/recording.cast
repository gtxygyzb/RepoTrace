[6779.435717, "o", "  1028\t\tif err != nil {\r\n  1029\t\t\treturn nil, fmt.Errorf(\"load run: %w\", err)\r\n  1030\t\t}\r\n  1031\t\tvar run PipelineRun\r\n  1032\t\tif err := json.Unmarshal(data, &run); err != nil {\r\n  1033\t\t\treturn nil, fmt.Errorf(\"parse run: %w\", err)\r\n  1034\t\t}\r\n  1035\t\tfor _, sr := range run.Steps {\r\n  1036\t\t\tif sr.RetryHistory == nil {\r\n  1037\t\t\t\tsr.RetryHistory = []RetryHistoryEntry{}\r\n  1038\t\t\t}\r\n  1039\t\t}\r\n  1040\t\treturn &run, nil\r\n  1041\t}\r\n  1042\t\r\n  1043\tfunc listRuns() []*PipelineRun {\r\n  1044\t\tentries, err := os.ReadDir(pipelineRunsDir)\r\n"]
[6779.435795, "o", "  1045\t\tif err != nil {\r\n  1046\t\t\treturn nil\r\n  1047\t\t}\r\n  1048\t\tvar runs []*PipelineRun\r\n  1049\t\tfor _, entry := range entries {\r\n  1050\t"]
[6779.435863, "o", "\t\tif !entry.IsDir() {\r\n  1051\t\t\t\tcontinue\r\n  1052\t\t\t}\r\n  1053\t\t\trun, err := loadRun(entry.Name())\r\n  1054\t\t\tif err != nil {\r\n  1055\t\t\t\tcontinue\r\n  1056\t\t\t}\r\n  1057\t\t\truns = append(runs, run)\r\n  1058\t\t}\r\n  1059\t\tsort.Slice(runs, func(i, j int) bool {\r\n  1060\t\t\tif runs[i].StartTime == nil || runs[j].StartTime == nil {\r\n  1061\t\t\t\treturn runs[i].ID < runs[j].ID\r\n  1062\t\t\t}\r\n  1063\t\t"]
[6779.435922, "o", "\treturn runs[i].StartTime.Before(*runs[j].StartTime)\r\n  1064\t\t})\r\n  1065\t\treturn runs\r\n"]
