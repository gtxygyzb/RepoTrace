[1510.400223, "o", "   357\tfunc handlePipeline(store *Store, tracker *Tracker, args []string) {\r\n   358\t\tif len(args) < 1 {\r\n   359\t\t\tfmt.Fprintln(os.Stderr, \"pipeline subcommand required\")\r\n   360\t\t\tos.Exit(1)\r\n"]
