[36.676093, "o", "\"os\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nconst dataDir = \"/tmp/nexus\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tstore, err := NewStore(dataDir)\r\n"]
[36.676254, "o", "\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tregistry := NewRegistry(store)\r\n\ttracker := NewTracker(store)\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"model\":\r\n\t\thandleModel(registry, os.Args[2:])\r\n\tcase \"experiment\":\r\n\t\thandleExperiment(tracker, os.Args[2:])\r\n\tcase \"dataset\":\r\n\t\thandleDataset(store, os.Args[2:])\r\n\tcase \"search\":\r\n\t\thandleSearch(store, os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"Unknown command: %s\\n\", os.Args[1])\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc printUsage() {\r\n\tfmt.Println(\"nexus - ML Model & Experiment Management\")\r\n\tfmt.Println()\r\n\tfmt.Println(\"Commands:\")\r\n\tfmt.Println(\"  model register <name> [--version V] [--framework F] [--description D] [--tags t1,t2]\")\r\n\tfmt.Println(\"  model list [--filter F]\")\r\n\tfmt.Println(\"  model get <name> <version>\")\r\n\t"]
[36.676334, "o", "fmt.Println(\"  model promote <name> <version> <status>\")\r\n\tfmt.Println(\"  model delete <name> <version>\")\r\n\tfmt.Println(\"  model compare <name>\")\r\n\tfmt.Println(\"  experiment create <name> [--params k1=v1,k2=v2] [--tags t1,t2]\")\r\n\tfmt.Println(\"  experiment list [--filter F]\")\r\n\t"]
[36.676442, "o", "fmt.Println(\"  experiment get <id>\")\r\n\tfmt.Println(\"  experiment log-metric <id> <key> <value>\")\r\n\tfmt.Println(\"  experiment complete <id> [--status completed|failed]\")\r\n\tfmt.Println(\"  experiment compare <id1,id2,...>\")\r\n\tfmt.Println(\"  experiment export <output-path> [--format json|csv]\")\r\n\tfmt.Println(\"  dataset register <name> <version> <format> <path> [--rows N]\")\r\n\tfmt.Println(\"  dataset list\")\r\n\tfmt.Println(\"  dataset get <name> <version>\")\r\n\tfmt.Println(\"  search --tag <tag>\")\r\n}\r\n\r\nfunc handleModel(reg *Registry, args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"model subcommand required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch args[0] {\r\n\tcase \"register\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tname := args[1]\r\n\t\tversion := getFlag(args, \"--version\", \"\")\r\n\t\tframework := getFlag(args, \"--framework\", \"unknown\")\r\n"]
[36.676512, "o", "\t\tdescription := getFlag(args, \"--description\", \"\")\r\n\t\ttagsStr := getFlag(args, \"--tags\", \"\")\r\n\t\tvar tags []string\r\n\t\tif tagsStr != \"\" {\r\n\t\t\ttags = strings.Split(tagsStr, \",\")\r\n\t\t}\r\n\r\n\t\tm, err := reg.Register(name, version, framework, description, tags)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n"]
[36.676592, "o", "\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(m)\r\n\r\n\tcase \"list\":\r\n\t\tfilter := getFlag(args, \"--filter\", \"\")\r\n\t\tmodels := reg.store.ListModels(filter)\r\n\t\tprintJSON(models)\r\n\r\n\tcase \"get\":\r\n\t\tif len(args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name and version required\")\r\n\t\t\tos.Exit(1)\r\n"]
[36.676656, "o", "\t\t}\r\n\t\tm, err := reg.store.GetModel(args[1], args[2])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(m)\r\n\r\n\tcase \"promote\":\r\n\t\tif len(args) < 4 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name, version, and target status required\")\r\n"]
[36.676718, "o", "\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\terr := reg.Promote(args[1], args[2], ModelStatus(args[3]))\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(\"Model promoted successfully\")\r\n"]
[36.676805, "o", "\r\n\tcase \"delete\":\r\n\t\tif len(args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name and version required\")\r\n\t"]
[36.676875, "o", "\t\tos.Exit(1)\r\n\t\t}\r\n\t\tif err := reg.store.DeleteModel(args[1], args[2]); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(\"Model deleted successfully\")\r\n\r\n\tcase \"compare\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tmodels, err := reg.Compare(args[1])\r\n\t\tif err != nil {\r\n"]
[36.676916, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(models)\r\n\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"Unknown model subcommand: %s\\n\", args[0])\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc handleExperiment(tracker *Tracker, args []string) {\r\n\tif len(args) < 1 {\r\n"]
[36.676994, "o", "\t\tfmt.Fprintln(os.Stderr, \"experiment subcommand required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch args[0] {\r\n\tcase \"create\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"experiment name required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tname := args[1]\r\n"]
[36.677065, "o", "\t\tparamsStr := getFlag(args, \"--params\", \"\")\r\n\t\ttagsStr := getFlag(args, \"--tags\", \"\")\r\n\r\n\t\tparams := make(map[string]string)\r\n\t\tif paramsStr != \"\" {\r\n\t\t\tfor _, p := range strings.Split(paramsStr, \",\") {\r\n\t\t\t\tkv := strings.SplitN(p, \"=\", 2)\r\n\t\t\t\tif len(kv) == 2 {\r\n\t\t\t\t\tparams[kv[0]] = kv[1]\r\n"]
[36.677144, "o", "\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tvar tags []string\r\n\t\tif tagsStr != \"\" {\r\n\t\t\ttags = strings.Split(tagsStr, \",\")\r\n\t\t}\r\n\r\n\t\texp, err := tracker.Create(name, params, tags)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t"]
[36.677233, "o", "}\r\n\t\tprintJSON(exp)\r\n\r\n\tcase \"list\":\r\n\t\tfilter := getFlag(args, \"--filter\", \"\")\r\n\t\texps := tracker.store.ListExperiments(filter)\r\n\t\tprintJSON(exps)\r\n\r\n\tcase \"get\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"experiment ID required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\texp, err := tracker.store.GetExperiment(args[1])\r\n\t\tif err != nil {\r\n"]
[36.677296, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(exp)\r\n\r\n\tcase \"log-metric\":\r\n\t\tif len(args) < 4 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"experiment ID, metric key, and value required\")\r\n"]
[36.677367, "o", "\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tvar value float64\r\n\t\tfmt.Sscanf(args[3], \"%f\", &value)\r\n\t\tif err := tracker.LogMetric(args[1], args[2], value); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(\"Metric logged successfully\")\r\n\r\n\tcase \"complete\":"]
[36.67743, "o", "\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"experiment ID required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tstatus := ExperimentStatus(getFlag(args, \"--status\", \"completed\"))\r\n\t\tif err := tracker.Complete(args[1], status); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t"]
[36.6775, "o", "\tfmt.Println(\"Experiment completed\")\r\n\r\n\tcase \"compare\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"experiment IDs required (comma-separated)\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tids := strings.Split(args[1], \",\")\r\n\t\tresult, err := tracker.CompareExperiments(ids)\r\n"]
