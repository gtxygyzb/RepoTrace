[227.860294, "i", "turn run, err\r}\r\rfunc buildArtifactManifest(run *PipelineRun) map[string]interface{} {\r\tmanifest := map[string]interface{}{\r\t\t\"artifacts\": run.Artifacts,\r\t}\r\tlineage := make(map[string][]string)\r\tcfgStepsByName := make(map[string]*StepRun)\r\tfor _, sr := range run.Steps {\r\t\tcfgStepsByName[sr.Name] = sr\r\t}\r\tfor _, art := range run.Artifacts {\r\t\tvar consumers []string\r\t\t// We do not have the original config here; derive from run outputs is not possible.\r\t\t_ = cfgStepsByName\r\t\tlineage[art.Name] = consumers\r\t}\r\tmanifest[\"lineage\"] = lineage\r\treturn manifest\r}\rEOF\r"]
