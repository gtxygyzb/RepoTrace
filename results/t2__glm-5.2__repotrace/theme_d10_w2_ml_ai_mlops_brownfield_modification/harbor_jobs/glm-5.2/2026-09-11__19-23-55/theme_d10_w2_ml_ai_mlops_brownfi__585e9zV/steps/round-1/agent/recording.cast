[6232.09865, "o", "   579\t\t\t\tsr.Error = fmt.Sprintf(\"env %s: %v\", k, err)\r\n   580\t\t\t\treturn\r\n   581\t\t\t}\r\n   582\t\t\tenvVars = append(envVars, k+\"=\"+ev)\r\n   583\t\t}\r\n   584\t\r\n   585\t\tmaxRetries := 0\r\n   586\t\tbackoffBase := 1\r\n   587\t\tif step.Retry != nil {\r\n   588\t\t\tmaxRetries = step.Retry.MaxRetries\r\n   589\t\t\tif step.Retry.BackoffBaseSeconds > 0 {\r\n"]
[6232.09872, "o", "   590\t\t\t\tbackoffBase = step.Retry.BackoffBaseSeconds\r\n"]
