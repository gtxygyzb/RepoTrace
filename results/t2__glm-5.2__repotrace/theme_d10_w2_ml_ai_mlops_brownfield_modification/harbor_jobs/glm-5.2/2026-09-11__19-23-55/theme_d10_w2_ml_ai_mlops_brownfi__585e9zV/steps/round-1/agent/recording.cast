[227.860179, "i", "urn runs\r}\r\rfunc resumePipeline(runID string, tracker *Tracker) (*PipelineRun, error) {\r\trun, err := loadRun(runID)\r\tif err != nil {\r\t\treturn nil, err\r\t}\r\tcpPath := filepath.Join(run.RunDir, \"checkpoint.json\")\r\tcpData, err := os.ReadFile(cpPath)\r\tif err == nil {\r\t\tvar cp Checkpoint\r\t\tif json.Unmarshal(cpData, &cp) == nil {\r\t\t\trun.Status = cp.Status\r\t\t\trun.Parameters = cp.Parameters\r\t\t\trun.Steps = cp.Steps\r\t\t\trun.Artifacts = cp.Artifacts\r\t\t}\r\t}\r\r\tcfgPath := filepath.Join(run.RunDir, \"pipeline_config.json\")\r\tvar cfg *PipelineConfig\r\tif cfgData, err := os.ReadFile(cfgPath); err == nil {\r\t\tvar c PipelineConfig\r\t\tif json.Unmarshal(cfgData, &c) == nil {\r\t\t\tcfg = &c\r\t\t}\r\t}\r\tif cfg == nil {\r\t\treturn nil, fmt.Errorf(\"pipeline config not found for run %s\", runID)\r\t}\r\r\trun.Status = \"running\"\r\tsaveRun(run)\r\r\terr = executeSteps(cfg, run, tracker, run.Parameters, cfg.MaxParallel)\r\tendTime := time.Now()\r\trun.EndTime = &endTime\r\tif err != nil {\r\t\trun.Status = \"failed\"\r\t} else {\r\t\trun.Status = \"succeeded\"\r\t}\r\tsaveRun(run)\r\tre"]
