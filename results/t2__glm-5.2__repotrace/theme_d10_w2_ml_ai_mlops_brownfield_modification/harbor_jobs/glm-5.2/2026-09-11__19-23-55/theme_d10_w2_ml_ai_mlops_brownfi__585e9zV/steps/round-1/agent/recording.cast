[1986.306062, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.306118, "o", "> "]
[1986.30623, "o", "\\tvar raw struct {\r\n\u001b[?2004l\r"]
[1986.306285, "o", "\u001b[?2004h> "]
[1986.306498, "o", "\\t\\tName  string `json:\"name\"`\r\n\u001b[?2004l\r"]
