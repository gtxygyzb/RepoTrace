[3125.783983, "o", "   286\t\r\n   287\tfunc runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {\r\n   288\t\tif err := validatePipelineConfig(cfg); err != nil {\r\n   289\t\t\treturn nil, err\r\n   290\t\t}\r\n   291\t\tmerged := mergeParams(cfg.Parameters, params)\r\n   292\t\tif maxParallel <= 0 {\r\n   293\t\t\tmaxParallel = cfg.MaxParallel\r\n   294\t\t}\r\n   295\t\tif maxParallel <= 0 {\r\n   296\t\t\tmaxParallel = 4\r\n   297\t\t}\r\n"]
[3125.784091, "o", "   298\t\r\n   299\t\trunID := generateRunID()\r\n   300\t\trunDir := filepath.Join(pipelineRunsDir, runID)\r\n   301\t\tartifactsDir := filepath.Join(runDir, \"artifacts\")\r\n   302\t\tif err := os.MkdirAll(artifactsDir, 0755); err != nil {\r\n   303\t\t\treturn nil, fmt.Errorf(\"create run dir: %w\", err)\r\n   304\t\t}\r\n   305\t\tif cfgData, err := json.MarshalIndent(cfg, \"\", \"  \"); err == nil {\r\n   306\t\t\tos.WriteFile(filepath.Join(runDir, \"pipeline_config.json\"), cfgData, 0644)\r\n   307\t\t}\r\n   308"]
[3125.784172, "o", "\t\r\n   309\t\tnow := time.Now()\r\n   310\t\trun := &PipelineRun{\r\n   311\t\t\tID:         runID,\r\n   312\t\t\tPipeline:   cfg.Name,\r\n   313\t\t\tStatus:     \"running\",\r\n   314\t\t\tParameters: merged,\r\n   315\t\t\tStartTime:  &now,\r\n   316\t\t\tRunDir:     runDir,\r\n   317\t\t\tVariables:  copyMap(merged),\r\n   318\t\t\tSteps:      make([]*StepRun, 0, len(cfg.Steps)),\r\n   319\t\t}\r\n"]
[3125.784243, "o", "   320\t\tfor _, step := range cfg.Steps {\r\n   321\t\t\trun.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: \"pending\"})\r\n   322\t\t}\r\n   323\t\tsaveRun(run)\r\n   324\t\r\n   325\t\terr := executeSteps(cfg, run, tracker, merged, maxParallel)\r\n   326\t\tendTime := time.Now()\r\n   327\t\trun.EndTime = &endTime\r\n   328\t\tif err != nil {\r\n"]
[3125.784317, "o", "   329\t\t\trun.Status = \"failed\"\r\n   330\t\t} else {\r\n   331\t\t\trun.Status = \"succeeded\"\r\n   332\t\t}\r\n   333\t\tsaveRun(run)\r\n   334\t\treturn run, err\r\n   335\t}\r\n   336\t\r\n   337\tfunc executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n   338\t\tstepByName := make(map[string]*PipelineStep)\r\n"]
[3125.784386, "o", "   339\t\tfor _, s := range cfg.Steps {\r\n   340\t\t\tstepByName[s.Name] = s\r\n   341\t\t}\r\n   342\t\trunStepByName := make(map[string]*StepRun)\r\n   343\t\tfor _, sr := range run.Steps {\r\n   344\t\t\trunStepByName[sr.Name] = sr\r\n   345\t\t}\r\n   346\t\r\n   347\t\tvariables := make(map[string]string)\r\n   348"]
[3125.784455, "o", "\t\tif run.Variables != nil {\r\n   349\t\t\tfor k, v := range run.Variables {\r\n   350\t\t\t\tvariables[k] = v\r\n   351\t\t\t}\r\n   352\t\t} else {\r\n   353\t\t\tfor k, v := range params {\r\n   354\t\t\t\tvariables[k] = v\r\n   355\t\t\t}\r\n   356\t\t}\r\n"]
