[4782.602118, "i", ":= strings.Split(cond, \"||\")\n\\tgroupResults := make([][]bool, len(orGroups))\n\n\\tfor i, orPart := range orGroups {\n\\t\\tfor _, andPart := range strings.Split(orPart, \"&&\") {\n\\t\\t\\tres, err := evalPrimitive(andPart)\n\\t\\t\\tif err != nil {\n\\t\\t\\t\\treturn false, err\n\\t\\t\\t}\n\\t\\t\\tgroupResults[i] = append(groupResults[i], res)\n\\t\\t}\n\\t}\n\n\\tif unresolved {\n\\t\\treturn false, nil\n\\t}\n\n\\tfor _, group := range groupResults {\n\\t\\tallTrue := true\n\\t\\tfor _, res := range group {\n\\t\\t\\tif !res {\n\\t\\t\\t\\tallTrue = false\n\\t\\t\\t\\tbreak\n\\t\\t\\t}\n\\t\\t}\n\\t\\tif allTrue {\n\\t\\t\\treturn true, nil\n\\t\\t}\n\\t}\n\n\\treturn false, nil\n}\n'''\n\ns2 = re.sub(r'func evaluateCondition\\(cond string, vars map\\[string\\]string\\) \\(bool, error\\) \\{.*?\\n\\}\\n\\nfunc resolveParam', new_func + '\\nfunc resolveParam', s, flags=re.S)\nif s2 == s:\n    raise SystemExit('evaluateCondition block not replaced')\np.write_text(s2)\nPY\n"]
