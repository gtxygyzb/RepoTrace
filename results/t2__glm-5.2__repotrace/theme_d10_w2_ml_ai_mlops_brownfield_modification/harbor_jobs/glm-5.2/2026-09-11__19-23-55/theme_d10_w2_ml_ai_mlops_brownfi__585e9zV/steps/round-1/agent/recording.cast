[1451.579431, "o", "   660\tfunc appendError(existing, addition string) string {\r\n   661\t\tif existing == \"\" {\r\n   662\t\t\treturn addition\r\n   663\t\t}\r\n   664\t\treturn existing + \"; \" + addition\r\n   665\t}\r\n   666\t\r\n"]
[1451.579471, "o", "   667\tfunc mergeParams(defaults, overrides map[string]string) map[string]string {\r\n   668\t\tmerged := make(map[string]string)\r\n   669\t\tfor k, v := range defaults {\r\n   670\t\t\tmerged[k] = v\r\n   671\t\t}\r\n"]
[1451.579577, "o", "   672\t\tfor k, v := range overrides {\r\n   673\t\t\tmerged[k] = v\r\n   674\t\t}\r\n   675\t\treturn merged\r\n   676\t}\r\n   677\t\r\n   678\tfunc substituteParams(command string, params map[string]string) string {\r\n   679\t\tresult := command\r\n   680\t\tfor k, v := range params {\r\n   681\t\t\tresult = strings.ReplaceAll(result, \"${\"+k+\"}\", v)\r\n   682\t\t}\r\n   683\t\treturn result\r\n   684\t}\r\n   685\t\r\n   686\tfunc evaluateCondition(cond string, params map[string]string) (bool, error) {\r\n"]
[1451.579651, "o", "   687\t\tcond = strings.TrimSpace(cond)\r\n   688\t\tif cond == \"\" {\r\n   689\t\t\treturn true, nil\r\n   690\t\t}\r\n   691\t\tif strings.Contains(cond, \"==\") {\r\n   692\t\t\tparts := strings.SplitN(cond, \"==\", 2)\r\n   693\t\t\tleft := resolveParam(strings.TrimSpace(parts[0]), params)\r\n   694\t\t\tright := resolveParam(strings.TrimSpace(parts[1]), params)\r\n   695\t\t\treturn left == right, nil\r\n   696\t\t}\r\n   697\t\t"]
[1451.579713, "o", "if strings.Contains(cond, \"!=\") {\r\n   698\t\t\tparts := strings.SplitN(cond, \"!=\", 2)\r\n   699\t\t\tleft := resolveParam(strings.TrimSpace(parts[0]), params)\r\n   700\t\t\tright := resolveParam(strings.TrimSpace(parts[1]), params)\r\n   701\t\t\treturn left != right, nil\r\n   702\t\t}\r\n   703\t\treturn false, fmt.Errorf(\"invalid condition: %s\", cond)\r\n   704\t}\r\n   705\t\r\n"]
[1451.579777, "o", "   706\tfunc resolveParam(token string, params map[string]string) string {\r\n   707\t\tre := regexp.MustCompile(`^\\$\\{(.+)\\}$`)\r\n   708\t\tm := re.FindStringSubmatch(token)\r\n   709\t\tif m != nil {\r\n   710\t\t\treturn params[m[1]]\r\n   711\t\t}\r\n   712\t\treturn token\r\n   713\t}\r\n   714\t\r\n   715\tfunc generateRunID() string {\r\n   716\t\treturn fmt.Sprintf(\"run-%d\", time.Now().UnixNano())"]
[1451.579836, "o", "\r\n   717\t}\r\n   718\t\r\n   719\tfunc nowPtr() *time.Time {\r\n   720\t\tt := time.Now()\r\n   721\t\treturn &t\r\n   722\t}\r\n   723\t\r\n   724\tfunc containsString(list []string, s string) bool {\r\n   725\t\tfor _, x := range list {\r\n"]
[1451.579894, "o", "   726\t\t\tif x == s {\r\n   727\t\t\t\treturn true\r\n   728\t\t\t}\r\n   729\t\t}\r\n   730\t\treturn false\r\n   731\t}\r\n   732\t\r\n   733\tfunc saveRun(run *PipelineRun) {\r\n   734\t\t"]
[1451.579953, "o", "if err := os.MkdirAll(run.RunDir, 0755); err != nil {\r\n   735\t\t\treturn\r\n   736\t\t}\r\n   737\t\tdata, err := json.MarshalIndent(run, \"\", \"  \")\r\n   738\t\tif err == nil {\r\n   739\t\t\tos.WriteFile(filepath.Join(run.RunDir, \"run.json\"), data, 0644)\r\n   740\t\t}\r\n   741\t}\r\n   742\t\r\n   743\tfunc saveCheckpoint(run *PipelineRun) {\r\n"]
[1451.580015, "o", "   744\t\tif err := os.MkdirAll(run.RunDir, 0755); err != nil {\r\n   745\t\t\treturn\r\n   746\t\t}\r\n   747\t\tcp := &Checkpoint{\r\n   748\t\t\tRunID:      run.ID,\r\n   749\t\t\tStatus:     run.Status,\r\n   750\t\t\tParameters: run.Parameters,\r\n   751\t\t\tSteps:      run.Steps,"]
[1451.580123, "o", "\r\n   752\t\t\tArtifacts:  run.Artifacts,\r\n   753\t\t}\r\n   754\t\tdata, err := json.MarshalIndent(cp, \"\", \"  \")\r\n   755\t\tif err == nil {\r\n   756\t\t\tos.WriteFile(filepath.Join(run.RunDir, \"checkpoint.json\"), data, 0644)\r\n   757\t\t}\r\n   758\t}\r\n   759\t\r\n   760\tfunc loadRun(runID string) (*PipelineRun, error) {\r\n   761\t\tpath := filepath.Join(pipelineRunsDir, runID, \"run.json\")\r\n   762\t\tdata, err := os.ReadFile(path)\r\n   763\t\tif err != nil {\r\n   764\t\t\treturn nil, fmt.Errorf(\"load run: %w\", err)\r\n   765\t\t}\r\n   766\t\tvar run PipelineRun\r\n"]
[1451.580182, "o", "   767\t\tif err := json.Unmarshal(data, &run); err != nil {\r\n   768\t\t\treturn nil, fmt.Errorf(\"parse run: %w\", err)\r\n   769\t\t}\r\n   770\t\treturn &run, nil\r\n   771\t}\r\n   772\t\r\n   773\tfunc listRuns() []*PipelineRun {\r\n   774\t\tentries, err := os.ReadDir(pipelineRunsDir)\r\n   775\t\tif err != nil {\r\n"]
[1451.580253, "o", "   776\t\t\treturn nil\r\n   777\t\t}\r\n   778\t\tvar runs []*PipelineRun\r\n   779\t\tfor _, entry := range entries {\r\n   780\t\t\tif !entry.IsDir() {\r\n"]
[1451.580313, "o", "   781\t\t\t\tcontinue\r\n   782\t\t\t}\r\n   783\t\t\trun, err := loadRun(entry.Name())\r\n   784\t\t\tif err != nil {\r\n   785\t\t\t\tcontinue\r\n   786\t\t\t}\r\n   787\t\t\truns = append(runs, run)\r\n   788\t\t}\r\n   789\t\tsort.Slice(runs, func(i, j int) bool {\r\n   790\t\t\tif runs[i].StartTime == nil || runs[j].StartTime == nil {\r\n   791\t\t\t\treturn runs[i].ID < runs[j].ID\r\n   792\t\t\t"]
[1451.580369, "o", "}\r\n   793\t\t\treturn runs[i].StartTime.Before(*runs[j].StartTime)\r\n   794\t\t})\r\n   795\t\treturn runs\r\n   796\t}\r\n   797\t\r\n   798\tfunc resumePipeline(runID string, tracker *Tracker) (*PipelineRun, error) {\r\n   799\t\trun, err := loadRun(runID)\r\n"]
[1451.580426, "o", "   800\t\tif err != nil {\r\n   801\t\t\treturn nil, err\r\n   802\t\t}\r\n   803\t\tcpPath := filepath.Join(run.RunDir, \"checkpoint.json\")\r\n   804\t\tcpData, err := os.ReadFile(cpPath)\r\n   805\t\tif err == nil {\r\n"]
[1451.580482, "o", "   806\t\t\tvar cp Checkpoint\r\n   807\t\t\tif json.Unmarshal(cpData, &cp) == nil {\r\n   808\t\t\t\trun.Status = cp.Status\r\n   809\t\t\t\trun.Parameters = cp.Parameters\r\n   810\t\t\t\trun.Steps = cp.Steps\r\n   811\t\t\t\trun.Artifacts = cp.Artifacts\r\n"]
[1451.580538, "o", "   812\t\t\t}\r\n   813\t\t}\r\n   814\t\r\n   815\t\tcfgPath := filepath.Join(run.RunDir, \"pipeline_config.json\")\r\n   816\t\tvar cfg *PipelineConfig\r\n   817\t\tif cfgData, err := os.ReadFile(cfgPath); err == nil {\r\n   818\t\t\tvar c PipelineConfig\r\n   819\t\t\tif json.Unmarshal(cfgData, &c) == nil {\r\n   820\t\t\t\tcfg = &c\r\n   821\t\t\t}\r\n   822\t\t}\r\n"]
[1451.580602, "o", "   823\t\tif cfg == nil {\r\n   824\t\t\treturn nil, fmt.Errorf(\"pipeline config not found for run %s\", runID)\r\n   825\t\t}\r\n   826\t\r\n   827\t\tcompleted := true\r\n   828\t\tfor _, sr := range run.Steps {\r\n"]
[1451.580657, "o", "   829\t\t\tif sr.Status != \"succeeded\" && sr.Status != \"skipped\" {\r\n   830\t\t\t\tcompleted = false\r\n   831\t\t\t\tbreak\r\n   832\t\t\t}\r\n   833\t\t}\r\n   834\t\tif completed {\r\n   835\t\t\trun.Status = \"succeeded\"\r\n   836\t\t\tsaveRun(run)\r\n   837\t\t\treturn run, nil\r\n   838\t\t}\r\n"]
[1451.580721, "o", "   839\t\r\n   840\t\trun.Status = \"running\"\r\n   841\t\tsaveRun(run)\r\n   842\t\r\n   843\t\terr = executeSteps(cfg, run, tracker, run.Parameters, cfg.MaxParallel)\r\n   844\t\t"]
[1451.580803, "o", "endTime := time.Now()\r\n   845\t\trun.EndTime = &endTime\r\n   846\t\tif err != nil {\r\n   847\t\t\trun.Status = \"failed\"\r\n   848\t\t} else {\r\n   849\t\t\trun.Status = \"succeeded\"\r\n   850\t\t}\r\n   851\t\tsaveRun(run)\r\n   852\t\treturn run, err\r\n   853\t}\r\n   854\t\r\n   855\tfunc buildArtifactManifest(run *PipelineRun, cfg *PipelineConfig) map[string]interface{} {\r\n   856\t\tmanifest := map[string]interface{}{\r\n   857\t\t\t\"artifacts\": run.Artifacts,\r\n   858\t\t}\r\n   859\t\tlineage := make(map[string][]string)\r\n   860\t\tif cfg != nil {\r\n"]
[1451.580843, "o", "   861\t\t\tfor _, step := range cfg.Steps {\r\n   862\t\t\t\tfor _, in := range step.Inputs {\r\n   863\t\t\t\t\tlineage[in] = append(lineage[in], step.Name)\r\n   864\t\t\t\t}\r\n   865\t\t\t}\r\n"]
[1451.580962, "o", "   866\t\t}\r\n   867\t\tmanifest[\"lineage\"] = lineage\r\n   868\t\treturn manifest\r\n   869\t}\r\n"]
