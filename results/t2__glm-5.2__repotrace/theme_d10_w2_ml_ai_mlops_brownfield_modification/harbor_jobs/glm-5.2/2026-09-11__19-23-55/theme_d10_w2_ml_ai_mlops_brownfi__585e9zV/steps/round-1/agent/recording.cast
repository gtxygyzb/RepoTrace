[4449.665791, "o", "\u001b[32m\u001b[K1065\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc splitVariableDefault\u001b[m\u001b[K(content string) (string, string, bool) {\r\n\u001b[32m\u001b[K1066\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif idx := strings.Index(content, \":-\"); idx >= 0 {\r\n\u001b[32m\u001b[K1067\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn content[:idx], content[idx+2:], true\r\n"]
[4449.66588, "o", "\u001b[32m\u001b[K1068\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K1069\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn content, \"\", false\r\n\u001b[32m\u001b[K1070\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1071\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1072\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc substituteVariables(command string, vars map[string]string) (string, error) {\r\n\u001b[32m\u001b[K1073\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar firstErr error\r\n\u001b[32m\u001b[K1074\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tresult := variableTokenRe.ReplaceAllStringFunc(command, func(token string) string {\r\n\u001b[32m\u001b[K1075\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcontent := token[2 : len(token)-1]\r\n\u001b[32m\u001b[K1076\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tname, defaultVal, hasDefault := splitVariableDefault(content)\r\n\u001b[32m\u001b[K1077\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif hasDefault && strings.Contains(defaultVal, \"${\") {\r\n\u001b[32m\u001b[K1078\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif firstErr == nil {\r\n\u001b[32m\u001b[K1079\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tfirstErr = fmt.Errorf(\"default value for variable %s cannot contain nested ${...} references\", name)\r\n"]
[4449.665957, "o", "\u001b[32m\u001b[K1080\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K1081\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn token\r\n\u001b[32m\u001b[K1082\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K1083\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif val, ok := vars[name]; ok {\r\n\u001b[32m\u001b[K1084\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn val\r\n\u001b[32m\u001b[K1085\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K1086\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif hasDefault {\r\n\u001b[32m\u001b[K1087\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn defaultVal\r\n\u001b[32m\u001b[K1088\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K1089\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif firstErr == nil {\r\n"]
[4449.666025, "o", "\u001b[32m\u001b[K1090\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tfirstErr = fmt.Errorf(\"unresolved variable: %s\", token)\r\n\u001b[32m\u001b[K1091\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K1092\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn token\r\n\u001b[32m\u001b[K1093\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t})\r\n\u001b[32m\u001b[K1094\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif firstErr != nil {\r\n\u001b[32m\u001b[K1095\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn result, firstErr\r\n"]
