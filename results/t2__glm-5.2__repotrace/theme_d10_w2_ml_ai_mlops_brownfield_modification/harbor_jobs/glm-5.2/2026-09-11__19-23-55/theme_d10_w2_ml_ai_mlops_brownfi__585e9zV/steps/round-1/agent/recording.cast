[1986.317936, "o", "}\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.317991, "o", "> "]
[1986.318181, "o", "new = \"\"\"type Checkpoint struct {\r\n\u001b[?2004l\r"]
[1986.318237, "o", "\u001b[?2004h> "]
[1986.318539, "o", "\\tRunID      string            `json:\"run_id\"`\r\n\u001b[?2004l\r"]
[1986.318596, "o", "\u001b[?2004h> "]
[1986.318901, "o", "\\tStatus     string            `json:\"status\"`\r\n\u001b[?2004l\r"]
[1986.318955, "o", "\u001b[?2004h> "]
[1986.319264, "o", "\\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n\u001b[?2004l\r"]
[1986.319319, "o", "\u001b[?2004h> "]
[1986.319516, "o", "\\tSteps      []*StepRun        `json:\"steps\"`\r\n\u001b[?2004l\r"]
[1986.319571, "o", "\u001b[?2004h> "]
[1986.319846, "o", "\\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n\u001b[?2004l\r"]
