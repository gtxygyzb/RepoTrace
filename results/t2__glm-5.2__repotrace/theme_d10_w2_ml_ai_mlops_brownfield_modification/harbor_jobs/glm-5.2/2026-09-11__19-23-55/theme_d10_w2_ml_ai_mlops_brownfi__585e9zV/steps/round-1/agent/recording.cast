[6745.056975, "o", "\u001b[35m\u001b[Kstore.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K UpdateTagIndex(entityKey string, tags []string) {\r\n\u001b[35m\u001b[Kstore.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K FindByTag(tag string) []string {\r\n\u001b[35m\u001b[Kstore.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K SaveModel(m *Model) error {\r\n\u001b[35m\u001b[Kstore.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K GetModel(name, version string) (*Model, error) {\r\n\u001b[35m\u001b[Kstore.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K ListModels(filter string) []*Model {\r\n"]
[6745.057056, "o", "\u001b[35m\u001b[Kstore.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K DeleteModel(name, version string) error {\r\n\u001b[35m\u001b[Kstore.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K SaveExperiment(exp *Experiment) error {\r\n\u001b[35m\u001b[Kstore.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K176\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K GetExperiment(id string) (*Experiment, error) {\r\n\u001b[35m\u001b[Kstore.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K ListExperiments(filter string) []*Experiment {\r\n\u001b[35m\u001b[Kstore.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K202\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K SaveDataset(ds *Dataset) error {\r\n"]
[6745.057121, "o", "\u001b[35m\u001b[Kstore.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K210\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K GetDataset(name, version string) (*Dataset, error) {\r\n\u001b[35m\u001b[Kstore.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K ListDatasets() []*Dataset {\r\n"]
[6745.057206, "o", "\u001b[35m\u001b[Kmodels.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tExperimentStatus\u001b[01;31m\u001b[KRun\u001b[m\u001b[Kning   ExperimentStatus = \"running\"\r\n"]
