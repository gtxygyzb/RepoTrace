[6598.196748, "o", "   378\t\tvar varMu sync.Mutex\r\n   379\t\r\n   380\t\tfor _, step := range cfg.Steps {\r\n   381\t\t\tsr := runStepByName[step.Name]\r\n   382\t\t\tif sr != nil && (sr.Status == \"succeeded\" || sr.Status == \"skipped\") {\r\n   383\t\t\t\tvariables[\"steps.\"+step.Name+\".status\"] = sr.Status\r\n   384\t\t\t\tvariables[\"steps.\"+step.Name+\".output\"] = stepRunOutputValue(sr)\r\n   385\t\t\t\tvariables[\"steps.\"+step.Name+\".duration\"] = stepRunDurationValue(sr)\r\n   386\t\t\t}\r\n   387\t\t}\r\n"]
[6598.19682, "o", "   388\t\r\n   389\t\tvar mu sync.Mutex\r\n   390\t\tvar running []*PipelineStep\r\n   391\t\tavailable := make(chan struct{}, maxParallel)\r\n   392\t\r\n   393\t\tpending := make(map[string]bool)\r\n   394\t\tfor _, step := range cfg.Steps {\r\n   395\t\t\tsr := runStepByName[step.Name]\r\n   396\t\t\tif sr.Status == \"succeeded\" || sr.Status == \"skipped\" {\r\n   397\t\t\t\tcontinue\r\n"]
[6598.19689, "o", "   398\t\t\t}\r\n   399\t\t\tif sr.Status == \"failed\" {\r\n   400\t\t\t\tsr.Status = \"pending\"\r\n   401\t\t\t\tsr.Error = \"\"\r\n   402\t\t\t\tsr.Output = \"\"\r\n   403\t\t\t\tsr.StartTime = nil\r\n   404\t\t\t\tsr.EndTime = nil\r\n   405\t\t\t}\r\n   406\t\t\tpending[step.Name] = true\r\n   407\t\t"]
[6598.196966, "o", "}\r\n   408\t\r\n   409\t\tvar wg sync.WaitGroup\r\n   410\t\tdone := false\r\n   411\t\r\n   412\t\tcanStart := func(step *PipelineStep) bool {\r\n   413\t\t\tfor _, dep := range step.DependsOn {\r\n   414\t\t\t\tstatus := runStepByName[dep].Status\r\n   415\t\t\t\tif status == \"succeeded\" || status == \"skipped\" {\r\n   416\t\t\t\t\tcontinue\r\n   417\t\t\t\t}\r\n"]
[6598.197039, "o", "   418\t\t\t\tif status == \"failed\" {\r\n   419\t\t\t\t\tif depStep := stepByName[dep]; depStep != nil && depStep.AllowFailure {\r\n   420\t\t\t\t\t\tcontinue\r\n   421\t\t\t\t\t}\r\n   422\t\t\t\t}\r\n"]
[6598.197153, "o", "   423\t\t\t\treturn false\r\n   424\t\t\t}\r\n   425\t\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n   426\t\t\t\tvar cpu, mem int\r\n   427\t\t\t\tfor _, r := range running {\r\n   428\t\t\t\t\tif r.Resources != nil {\r\n   429\t\t\t\t\t\tcpu += r.Resources.CPU\r\n   430\t\t\t\t\t\tmem += r.Resources.MemoryMB\r\n   431\t\t\t\t\t}\r\n   432\t\t\t\t}\r\n   433\t\t\t\tif cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n   434\t\t\t\t\treturn false\r\n   435\t\t\t\t}\r\n   436\t\t\t}\r\n"]
