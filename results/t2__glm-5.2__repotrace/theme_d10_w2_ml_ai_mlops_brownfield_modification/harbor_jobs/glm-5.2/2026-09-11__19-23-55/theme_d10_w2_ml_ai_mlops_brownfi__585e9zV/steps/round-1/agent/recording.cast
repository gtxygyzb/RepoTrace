[1484.593729, "o", "   440\tfunc executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, params map[string]string, sr *StepRun) {\r\n   441\t\tfor _, dep := range step.DependsOn {\r\n   442\t\t\tdepStatus := getRunStep(run, dep).Status\r\n   443\t\t\tif depStatus != \"succeeded\" && depStatus != \"skipped\" {\r\n   444\t\t\t\tsr.Status = \"failed\"\r\n"]
