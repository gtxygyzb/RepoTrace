[4019.24899, "o", "}\r\n\r\nvar variableTokenRe = regexp.MustCompile(`\\$\\{([^}]*)\\}`)\r\n\r\nfunc splitVariableDefault(content string) (string, string, bool) {\r\n\tif idx := strings.Index(content, \":-\"); idx >= 0 {\r\n\t\treturn content[:idx], content[idx+2:], true\r\n\t}\r\n\treturn content, \"\", false\r\n"]
[4019.249113, "o", "}\r\n\r\nfunc substituteVariables(command string, vars map[string]string) (string, error) {\r\n\tvar firstErr error\r\n\tresult := variableTokenRe.ReplaceAllStringFunc(command, func(token string) string {\r\n\t\tcontent := token[2 : len(token)-1]\r\n\t\tname, defaultVal, hasDefault := splitVariableDefault(content)\r\n\t\tif hasDefault && strings.Contains(defaultVal, \"${\") {\r\n\t\t\tif firstErr == nil {\r\n\t\t\t\tfirstErr = fmt.Errorf(\"default value for variable %s cannot contain nested ${...} references\", name)\r\n\t\t\t}\r\n\t\t\treturn token\r\n\t\t}\r\n\t\t"]
[4019.249175, "o", "if val, ok := vars[name]; ok {\r\n\t\t\treturn val\r\n\t\t}\r\n\t\tif hasDefault {\r\n\t\t\treturn defaultVal\r\n\t\t}\r\n\t\tif firstErr == nil {\r\n\t\t\tfirstErr = fmt.Errorf(\"unresolved variable: %s\", token)\r\n"]
[4019.249237, "o", "\t\t}\r\n\t\treturn token\r\n\t})\r\n\tif firstErr != nil {\r\n\t\treturn result, firstErr\r\n\t}\r\n\treturn result, nil\r\n}\r\n\r\nfunc substituteStaticForDryRun(command string, params map[string]string, captureNames map[string]bool) (string, error) {\r\n\tvar firstErr error\r\n\tresult := variableTokenRe.ReplaceAllStringFunc(command, func(token string) string {\r\n"]
[4019.249297, "o", "\t\tcontent := token[2 : len(token)-1]\r\n\t\tname, defaultVal, hasDefault := splitVariableDefault(content)\r\n\t\tif hasDefault && strings.Contains(defaultVal, \"${\") {\r\n\t\t\tif firstErr == nil {\r\n\t\t\t\tfirstErr = fmt.Errorf(\"default value for variable %s cannot contain nested ${...} references\", name)\r\n\t\t\t}\r\n\t\t\treturn token\r\n"]
[4019.249358, "o", "\t\t}\r\n\t\tif captureNames[name] {\r\n\t\t\treturn token\r\n\t\t}\r\n\t\tif val, ok := params[name]; ok {\r\n\t\t\treturn val\r\n\t\t}\r\n\t\tif hasDefault {\r\n\t\t\treturn defaultVal\r\n\t\t}\r\n"]
[4019.249418, "o", "\t\tif firstErr == nil {\r\n\t\t\tfirstErr = fmt.Errorf(\"unresolved variable: %s\", token)\r\n\t\t}\r\n\t\treturn token\r\n\t})\r\n\tif firstErr != nil {\r\n\t\treturn result, firstErr\r\n\t}\r\n\treturn result, nil\r\n"]
[4019.249486, "o", "}\r\n\r\nfunc captureOutputValue(step *PipelineStep, stdout string) (string, bool, error) {\r\n\tif step.CaptureOutput == nil {\r\n\t\treturn \"\", false, nil\r\n\t}\r\n\tif step.CaptureOutput.Regex == \"\" {\r\n\t\treturn strings.TrimSpace(stdout), true, nil\r\n\t}\r\n\tre, err := regexp.Compile(step.CaptureOutput.Regex)\r\n\tif err != nil {\r\n\t\treturn \"\", false, fmt.Errorf(\"step %s capture_output regex: %w\", step.Name, err)\r\n"]
[4019.24955, "o", "\t}\r\n\tm := re.FindStringSubmatch(stdout)\r\n\tif m == nil || len(m) < 2 {\r\n\t\treturn \"\", false, nil\r\n\t}\r\n\treturn m[1], true, nil\r\n}\r\n\r\ntype DryRunStep struct {\r\n\tName            string   `json:\"name\"`\r\n\tType            string   `json:\"type\"`\r\n"]
[4019.249606, "o", "\tResolvedCommand string   `json:\"resolved_command\"`\r\n\tStatus          string   `json:\"status\"`\r\n\tDependsOn       []string `json:\"depends_on\"`\r\n}\r\n\r\n"]
