[733.885154, "o", "}\r\nvalue, err := strconv.ParseFloat(val, 64)\r\nif err != nil {\r\nreturn \"\", 0, false\r\n}\r\nreturn key, value, true\r\n}\r\n\r\nfunc runShellCommand(command string, timeoutSeconds int) (string, int, error) {\r\ncmd := exec.Command(\"sh\", \"-c\", command)\r\nvar out strings.Builder\r\ncmd.Stdout = &out\r\ncmd.Stderr = &out\r\n\r\nif timeoutSeconds > 0 {\r\ntimer := time.AfterFunc(time.Duration(timeoutSeconds)*time.Second, func() {\r\nif cmd.Process != nil {\r\ncmd.Process.Kill()\r\n"]
[733.885232, "o", "}\r\n})\r\ndefer timer.Stop()\r\n}\r\n\r\nerr := cmd.Run()\r\nexitCode := 0\r\nif err != nil {\r\nif exitErr, ok := err.(*exec.ExitError); ok {\r\nexitCode = exitErr.ExitCode()"]
[733.885297, "o", "\r\n} else {\r\nexitCode = 1\r\n}\r\nreturn out.String(), exitCode, fmt.Errorf(\"command failed: %s\", err.Error())\r\n}\r\nreturn out.String(), exitCode, nil\r\n}\r\n\r\nfunc produceArtifacts(run *PipelineRun, step *PipelineStep, sr *StepRun, content string) {\r\nstepArtDir := filepath.Join(run.RunDir, \"artifacts\", step.Name)\r\nos.MkdirAll(stepArtDir, 0755)\r\nfor _, name := range step.Outputs {\r\npath := filepath.Join(stepArtDir, name)\r\nif err := os.WriteFile(path, []byte(content), 0644); err != nil {\r\nsr.Error = appendError(sr.Error, fmt.Sprintf(\"write artifact %s: %v\", name, err))\r\ncontinue\r\n}\r\ninfo, _ := os.Stat(path)\r\nvar size int64\r\nif info != nil {\r\n"]
[733.885358, "o", "size = info.Size()\r\n}\r\nartType := \"data\"\r\nif step.Type == \"train\" {\r\nartType = \"model\"\r\n} else if step.Type == \"evaluate\" {\r\nartType = \"metrics\"\r\n}\r\nartifact := Artifact{Name: name, Type: artType, Producer: step.Name, Path: path, Size: size}\r\nsr.Artifacts = appendArtifact(sr.Artifacts, artifact)\r\nrun.Artifacts = appendArtifact(run.Artifacts, artifact)\r\n}\r\n"]
[733.885418, "o", "}\r\n\r\nfunc registerEvaluateArtifacts(run *PipelineRun, step *PipelineStep, sr *StepRun) {\r\nfor i, art := range sr.Artifacts {\r\nif art.Producer == step.Name && (art.Type == \"data\" || art.Type == \"\") {\r\nsr.Artifacts[i].Type = \"metrics\"\r\n}\r\n}\r\nfor i, art := range run.Artifacts {\r\nif art.Producer == step.Name && (art.Type == \"data\" || art.Type == \"\") {\r\nrun.Artifacts[i].Type = \"metrics\"\r\n}\r\n}\r\n}\r\n\r\n"]
[733.885479, "o", "func appendArtifact(arts []Artifact, art Artifact) []Artifact {\r\nfor i, a := range arts {\r\nif a.Name == art.Name && a.Producer == art.Producer {\r\narts[i] = art\r\nreturn arts\r\n}\r\n}\r\nreturn append(arts, art)\r\n}\r\n\r\n"]
