[5874.516279, "i", "c pipelineHistory(name, status, tag string) []PipelineHistoryEntry {\n\\truns := listRuns()\n\\tout := make([]PipelineHistoryEntry, 0)\n\\tfor _, run := range runs {\n\\t\\tif run.Pipeline != name {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif status != \"\" && run.Status != status {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif tag != \"\" && !containsString(run.Tags, tag) {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tduration := 0.0\n\\t\\tif run.StartTime != nil && run.EndTime != nil {\n\\t\\t\\tduration = run.EndTime.Sub(*run.StartTime).Seconds()\n\\t\\t}\n\\t\\tout = append(out, PipelineHistoryEntry{\n\\t\\t\\tID:              run.ID,\n\\t\\t\\tStatus:          run.Status,\n\\t\\t\\tDescription:      run.Description,\n\\t\\t\\tTags:             copyTags(run.Tags),\n\\t\\t\\tStartTime:       run.StartTime,\n\\t\\t\\tEndTime:         run.EndTime,\n\\t\\t\\tDurationSeconds: duration,\n\\t\\t})\n\\t}'''\n)\n\ninsert = '''\nfunc copyTags(tags []string) []string {\n\\tif len(tags) == 0 {\n\\t\\treturn []string{}\n\\t}\n\\tout := make([]string, len(tags))\n\\tcopy(out, tags)\n\\treturn out\n}\n'''\nif 'func copyTags(' not in s:\n    s = s.rep"]
