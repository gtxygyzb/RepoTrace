[67.600972, "o", "   296\t\tcase \"list\":\r\n   297\t\t\tdatasets := store.ListDatasets()\r\n   298\t\t\tprintJSON(datasets)\r\n   299\t\r\n   300\t\tcase \"get\":\r\n   301\t\t\tif len(args) < 3 {\r\n"]
[67.601028, "o", "   302\t\t\t\tfmt.Fprintln(os.Stderr, \"dataset name and version required\")\r\n   303\t\t\t\tos.Exit(1)\r\n   304\t\t\t}\r\n   305\t\t\tds, err := store.GetDataset(args[1], args[2])\r\n   306\t\t\tif err != nil {\r\n   307\t\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n   308\t\t\t\tos.Exit(1)\r\n   309\t\t\t}\r\n   310\t\t\tprintJSON(ds)\r\n   311\t"]
