[1503.974959, "o", "   440\tfunc executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, params map[string]string, sr *StepRun) {\r\n   441\t\tfor _, dep := range step.DependsOn {\r\n   442\t\t\tdepStatus := getRunStep(run, dep).Status\r\n   443\t\t\tif depStatus != \"succeeded\" && depStatus != \"skipped\" {\r\n   444\t\t\t\tsr.Status = \"failed\"\r\n   445\t\t\t"]
[1503.975197, "o", "\tsr.Error = \"dependency failed\"\r\n   446\t\t\t\treturn\r\n   447\t\t\t}\r\n   448\t\t}\r\n   449\t\r\n   450\t\tif step.Condition != \"\" {\r\n   451\t\t\tcond, err := evaluateCondition(step.Condition, params)\r\n   452\t\t\tif err != nil {\r\n   453\t\t\t\tsr.Status = \"failed\"\r\n   454\t\t\t\tsr.Error = err.Error()\r\n   455\t\t\t\treturn\r\n   456\t\t\t}\r\n   457\t\t\tif !cond {\r\n   458\t\t\t\tsr.Status = \"skipped\"\r\n   459\t\t\t\tsr.Output = \"condition false\"\r\n   460\t\t\t\treturn\r\n   461\t\t\t}\r\n   462\t\t}\r\n   463\t\r\n   464\t\tmaxRetries := 0\r\n   465\t\tbackoffBase := 1\r\n   466\t\tif step.Retry != nil {\r\n   467\t\t\tmaxRetries = step.Retry.MaxRetries\r\n   468\t\t\tif step.Retry.BackoffBaseSeconds > 0 {\r\n   469\t\t\t\tbackoffBase = step.Retry.BackoffBaseSeconds\r\n   470\t\t\t}\r\n   471\t\t}\r\n   472\t\r\n   473\t\tcmdStr := substituteParams(step.Command, params)\r\n   474\t\r\n   475\t\tvar exp *Experiment\r\n   476\t\tif step.Type == \"train\" {\r\n   477\t\t\tvar err error\r\n"]
[1503.975321, "o", "   478\t\t\texp, err = createTrainExperiment(tracker, step, sr.ExperimentID)\r\n   479\t\t\tif err != nil {\r\n   480\t\t\t\tsr.Status = \"failed\"\r\n   481\t\t\t\tsr.Error = err.Error()\r\n   482\t\t\t\treturn\r\n   483\t\t\t}\r\n   484\t\t"]
[1503.975404, "o", "\tsr.ExperimentID = exp.ID\r\n   485\t\t}\r\n   486\t\r\n   487\t\tfor attempt := 0; attempt <= maxRetries; attempt++ {\r\n   488\t\t\tstart := time.Now()\r\n   489\t\t\tsr.StartTime = &start\r\n   490\t\t\tsr.RetryCount = attempt\r\n"]
