[3058.106793, "o", "   502\t\t\tcond, err := evaluateCondition(step.Condition, vars)\r\n   503\t\t\tif err != nil {\r\n   504\t\t\t\tsr.Status = \"failed\"\r\n   505\t\t\t\tsr.Error = err.Error()\r\n   506\t\t\t\treturn\r\n   507\t\t\t}\r\n   508\t\t\tif !cond {\r\n   509\t\t\t\tsr.Status = \"skipped\"\r\n   510\t\t\t\tsr.Output = \"condition false\"\r\n   511\t\t\t\treturn\r\n   512\t\t\t}\r\n   513\t\t}\r\n"]
