[4538.735839, "o", "\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif sr != nil \u001b[01;31m\u001b[K&&\u001b[m\u001b[K (sr.Status == \"succeeded\" \u001b[01;31m\u001b[K||\u001b[m\u001b[K sr.Status == \"skipped\") {\r\n\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K384\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif sr.Status == \"succeeded\" \u001b[01;31m\u001b[K||\u001b[m\u001b[K sr.Status == \"skipped\" {\r\n"]
[4538.735916, "o", "\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif status == \"succeeded\" \u001b[01;31m\u001b[K||\u001b[m\u001b[K status == \"skipped\" {\r\n\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif depStep := stepByName[dep]; depStep != nil \u001b[01;31m\u001b[K&&\u001b[m\u001b[K depStep.AllowFailure {\r\n\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K413\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif step.Resources != nil \u001b[01;31m\u001b[K&&\u001b[m\u001b[K cfg.ResourceLimit != nil {\r\n\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif cpu+step.Resources.CPU > cfg.ResourceLimit.CPU \u001b[01;31m\u001b[K||\u001b[m\u001b[K mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n"]
[4538.735998, "o", "\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K440\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tif !\u001b[01;31m\u001b[Kcontains\u001b[m\u001b[KString(run.Warnings, s.Name) {\r\n\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K461\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor !done \u001b[01;31m\u001b[K&&\u001b[m\u001b[K (len(pending) > 0 \u001b[01;31m\u001b[K||\u001b[m\u001b[K len(running) > 0) {\r\n\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K466\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif pending[step.Name] \u001b[01;31m\u001b[K&&\u001b[m\u001b[K canStart(step) {\r\n\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K475\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif done \u001b[01;31m\u001b[K||\u001b[m\u001b[K !pending[step.Name] \u001b[01;31m\u001b[K||\u001b[m\u001b[K !canStart(step) {\r\n\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K525\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif depStatus == \"succeeded\" \u001b[01;31m\u001b[K||\u001b[m\u001b[K depStatus == \"skipped\" {\r\n\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K530\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif depStep != nil \u001b[01;31m\u001b[K&&\u001b[m\u001b[K depStep.AllowFailure {\r\n"]
[4538.736133, "o", "\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K544\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcond, err := \u001b[01;31m\u001b[KevaluateCondition\u001b[m\u001b[K(step.Condition, vars)\r\n"]
