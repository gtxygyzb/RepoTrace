[1484.028804, "o", "   259\tfunc runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {\r\n   260\t\tif err := validatePipelineConfig(cfg); err != nil {\r\n   261\t\t\treturn nil, err\r\n   262\t\t}\r\n   263\t\tmerged := mergeParams(cfg.Parameters, params)\r\n   264\t\tif maxParallel <= 0 {\r\n   265\t\t\tmaxParallel = cfg.MaxParallel\r\n   266\t\t}\r\n   267\t\tif maxParallel <= 0 {\r\n   268\t\t\tmaxParallel = 4\r\n   269\t\t}\r\n   270\t\r\n   271\t\trunID := generateRunID()\r\n"]
[1484.028974, "o", "   272\t\trunDir := filepath.Join(pipelineRunsDir, runID)\r\n   273\t\tartifactsDir := filepath.Join(runDir, \"artifacts\")\r\n   274\t\tif err := os.MkdirAll(artifactsDir, 0755); err != nil {\r\n   275\t\t\treturn nil, fmt.Errorf(\"create run dir: %w\", err)\r\n   276\t\t}\r\n   277\t\tif cfgData, err := json.MarshalIndent(cfg, \"\", \"  \"); err == nil {\r\n   278\t\t\tos.WriteFile(filepath.Join(runDir, \"pipeline_config.json\"), cfgData, 0644)\r\n   279\t\t}\r\n   280\t\r\n   281\t\tnow := time.Now()\r\n   282\t\trun := &PipelineRun{\r\n   283\t\t\tID:         runID,\r\n   284\t\t\tPipeline:   cfg.Name,\r\n   285\t\t\tStatus:     \"running\",\r\n   286\t\t\tParameters: merged,\r\n   287\t\t\tStartTime:  &now,\r\n   288\t\t\tRunDir:     runDir,\r\n   289\t\t\tSteps:      make([]*StepRun, 0, len(cfg.Steps)),\r\n   290\t\t}\r\n   291\t\tfor _, step := range cfg.Steps {\r\n   292\t\t\trun.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: \"pending\"})\r\n   293"]
[1484.029102, "o", "\t\t}\r\n   294\t\tsaveRun(run)\r\n   295\t\r\n   296\t\terr := executeSteps(cfg, run, tracker, merged, maxParallel)\r\n   297\t\tendTime := time.Now()\r\n   298\t\trun.EndTime = &endTime\r\n"]
[1484.029186, "o", "   299\t\tif err != nil {\r\n   300\t\t\trun.Status = \"failed\"\r\n   301\t\t} else {\r\n   302\t\t\trun.Status = \"succeeded\"\r\n   303\t\t}\r\n   304\t\tsaveRun(run)\r\n   305\t\treturn run, err\r\n   306\t}\r\n   307\t\r\n   308\tfunc executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n   309\t\tstepByName := make(map[string]*PipelineStep)\r\n   310\t\tfor _, s := range cfg.Steps {\r\n   311\t\t\tstepByName[s.Name] = s\r\n   312\t\t}\r\n   313\t\trunStepByName := make(map[string]*StepRun)\r\n   314\t\tfor _, sr := range run.Steps {\r\n   315\t\t\trunStepByName[sr.Name] = sr\r\n   316\t\t}\r\n   317\t\r\n   318\t\tvar mu sync.Mutex\r\n   319\t\tvar running []*PipelineStep\r\n"]
[1484.029256, "o", "   320\t\tavailable := make(chan struct{}, maxParallel)\r\n   321\t\r\n   322\t\tpending := make(map[string]bool)\r\n   323\t\tfor _, step := range cfg.Steps {\r\n   324\t\t\tsr := runStepByName[step.Name]\r\n   325\t\t\tif sr.Status == \"succeeded\" || sr.Status == \"skipped\" {\r\n   326\t\t\t\tcontinue\r\n   327\t\t\t}\r\n   328\t\t\tif sr.Status == \"failed\" {\r\n   329"]
[1484.029325, "o", "\t\t\t\tsr.Status = \"pending\"\r\n   330\t\t\t\tsr.Error = \"\"\r\n   331\t\t\t\tsr.Output = \"\"\r\n   332\t\t\t\tsr.StartTime = nil\r\n   333\t\t\t\tsr.EndTime = nil\r\n   334\t\t\t}\r\n   335\t\t\tpending[step.Name] = true\r\n   336\t\t}\r\n   337\t\r\n   338\t\t"]
[1484.029393, "o", "var wg sync.WaitGroup\r\n   339\t\tdone := false\r\n   340\t\r\n   341\t\tcanStart := func(step *PipelineStep) bool {\r\n   342\t\t\tfor _, dep := range step.DependsOn {\r\n   343\t\t\t\tstatus := runStepByName[dep].Status\r\n   344\t\t\t\tif status != \"succeeded\" && status != \"skipped\" {\r\n   345\t\t\t\t\treturn false\r\n   346\t\t\t\t}\r\n"]
[1484.029466, "o", "   347\t\t\t}\r\n   348\t\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n   349\t\t\t\tvar cpu, mem int\r\n   350\t\t\t\tfor _, r := range running {\r\n   351\t\t\t\t\tif r.Resources != nil {\r\n"]
[1484.029538, "o", "   352\t\t\t\t\t\tcpu += r.Resources.CPU\r\n   353\t\t\t\t\t\tmem += r.Resources.MemoryMB\r\n   354\t\t\t\t\t}\r\n   355\t\t\t\t}\r\n   356\t\t\t\tif cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n   357\t\t\t\t\treturn false\r\n   358\t\t\t\t}\r\n   359\t\t\t}\r\n   360\t\t\treturn true\r\n"]
