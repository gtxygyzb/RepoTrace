[1432.697025, "o", "\tif err != nil {\r\n   601\t\t\tif exitErr, ok := err.(*exec.ExitError); ok {\r\n   602\t\t\t\texitCode = exitErr.ExitCode()\r\n   603\t\t\t} else {\r\n   604\t\t\t\texitCode = 1\r\n   605\t\t\t}\r\n   606\t\t\treturn out.String(), exitCode, fmt.Errorf(\"command failed: %s\", err.Error())\r\n   607\t\t}\r\n   608\t\treturn out.String(), exitCode, nil\r\n   609"]
[1432.697117, "o", "\t}\r\n   610\t\r\n   611\tfunc produceArtifacts(run *PipelineRun, step *PipelineStep, sr *StepRun, content string) {\r\n   612\t\tstepArtDir := filepath.Join(run.RunDir, \"artifacts\", step.Name)\r\n   613\t\tos.MkdirAll(stepArtDir, 0755)\r\n   614\t\tfor _, name := range step.Outputs {\r\n   615\t\t\tpath := filepath.Join(stepArtDir, name)\r\n   616\t\t\tif err := os.WriteFile(path, []byte(content), 0644); err != nil {\r\n   617\t\t\t\tsr.Error = appendError(sr.Error, fmt.Sprintf(\"write artifact %s: %v\", name, err))\r\n   618\t\t\t\tcontinue\r\n"]
