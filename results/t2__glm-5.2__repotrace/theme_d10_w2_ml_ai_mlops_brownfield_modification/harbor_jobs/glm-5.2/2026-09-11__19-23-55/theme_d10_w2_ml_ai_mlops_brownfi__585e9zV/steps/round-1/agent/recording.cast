[1450.739412, "o", "func loadPipelineConfig(path string) (*PipelineConfig, error) {\r\n   107\t\tdata, err := os.ReadFile(path)\r\n   108\t\tif err != nil {\r\n   109\t\t\treturn nil, fmt.Errorf(\"read pipeline config: %w\", err)\r\n   110\t\t}\r\n   111\t\tvar cfg PipelineConfig\r\n   112\t\tif err := json.Unmarshal(data, &cfg); err != nil {\r\n   113\t\t\treturn nil, fmt.Errorf(\"parse pipeline config: %w\", err)\r\n"]
[1450.739476, "o", "   114\t\t}\r\n   115\t\tif cfg.MaxParallel <= 0 {\r\n   116\t\t\tcfg.MaxParallel = 4\r\n   117\t\t}\r\n   118\t\treturn &cfg, nil\r\n   119\t}\r\n   120\t\r\n"]
