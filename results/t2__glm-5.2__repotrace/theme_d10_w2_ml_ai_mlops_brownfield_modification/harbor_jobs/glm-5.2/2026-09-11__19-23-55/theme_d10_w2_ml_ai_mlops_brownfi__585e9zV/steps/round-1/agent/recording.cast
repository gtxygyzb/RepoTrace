[1432.001784, "o", "    18\tconst pipelineRunsDir = \"/tmp/nexus/runs\"\r\n    19\t\r\n    20\ttype PipelineResourceLimit struct {\r\n    21\t\tCPU      int `json:\"cpu,omitempty\"`\r\n    22\t\tMemoryMB int `json:\"memory_mb,omitempty\"`\r\n    23\t}\r\n    24\t\r\n    25\ttype PipelineStepResources struct {\r\n    26\t\tCPU      int `json:\"cpu,omitempty\"`\r\n    27\t\t"]
[1432.001857, "o", "MemoryMB int `json:\"memory_mb,omitempty\"`\r\n    28\t}\r\n    29\t\r\n    30\ttype PipelineStepRetry struct {\r\n    31\t\tMaxRetries         int `json:\"max_retries,omitempty\"`\r\n    32"]
[1432.001926, "o", "\t\tBackoffBaseSeconds int `json:\"backoff_base_seconds,omitempty\"`\r\n    33\t}\r\n    34\t\r\n    35\ttype PipelineExperimentConfig struct {\r\n    36\t\tName    string            `json:\"name,omitempty\"`\r\n    37\t\tParams  map[string]string `json:\"params,omitempty\"`\r\n    38\t\tMetrics []string          `json:\"metrics,omitempty\"`\r\n    39\t}\r\n    40\t\r\n    41\ttype PipelineStep struct {\r\n    42\t\tName             string                    `json:\"name\"`\r\n    43\t\tType             string                    `json:\"type\"`\r\n    44\t\tCommand          string                    `json:\"command\"`\r\n"]
[1432.001994, "o", "    45\t\tDependsOn        []string                  `json:\"depends_on,omitempty\"`\r\n    46\t\tInputs           []string                  `json:\"inputs,omitempty\"`\r\n    47\t\tOutputs          []string                  `json:\"outputs,omitempty\"`\r\n    48\t\tResources        *PipelineStepResources    `json:\"resources,omitempty\"`\r\n    49\t\tTimeoutSeconds   int                       `json:\"timeout_seconds,omitempty\"`\r\n    50\t\tRetry            *PipelineStepRetry        `json:\"retry,omitempty\"`\r\n    51\t\tCondition        string                    `json:\"condition,omitempty\"`\r\n    52\t\tExperimentConfig *PipelineExperimentConfig `json:\"experiment_config,omitempty\"`\r\n    53\t\tDatasetRef       string                    `json:\"dataset_ref,omitempty\"`\r\n    54\t}\r\n    55\t\r\n    56\ttype PipelineConfig struct {\r\n"]
[1432.002141, "o", "    57\t\tName          string                 `json:\"name\"`\r\n    58\t\tParameters    map[string]string      `json:\"parameters,omitempty\"`\r\n    59\t\tMaxParallel   int                    `json:\"max_parallel,omitempty\"`\r\n    60\t\tResourceLimit *PipelineResourceLimit `json:\"resource_limit,omitempty\"`\r\n    61\t\tSteps         []*PipelineStep        `json:\"steps\"`\r\n    62\t}\r\n    63\t\r\n    64\ttype Artifact struct {\r\n    65\t\tName     string `json:\"name\"`\r\n    66\t\tType     string `json:\"type\"`\r\n    67\t\tProducer string `json:\"producer\"`\r\n    68\t\tPath     string `json:\"path\"`\r\n    69\t\tSize     int64  `json:\"size\"`\r\n    70\t}\r\n    71\t\r\n    72\ttype StepRun struct {\r\n    73\t\tName         string     `json:\"name\"`\r\n    74\t\tType         string     `json:\"type\"`\r\n    75\t\tStatus       string     `json:\"status\"`\r\n    76\t\tStartTime    *time.Time `json:\"start_time,omitempty\"`\r\n    77\t\tEndTime      *time.Time `json:\"end_time,omitempty\"`\r\n    78\t\tExitCode     int        `json:\"exit_code,omitempty\"`\r\n    79\t\tOutput       string     `json:\"out"]
[1432.002211, "o", "put,omitempty\"`\r\n    80\t\tError        string     `json:\"error,omitempty\"`\r\n    81\t\tArtifacts    []Artifact `json:\"artifacts,omitempty\"`\r\n    82\t\tExperimentID string     `json:\"experiment_id,omitempty\"`\r\n    83\t\tRetryCount   int        `json:\"retry_count\"`\r\n    84\t}\r\n    85\t\r\n    86\ttype PipelineRun struct {\r\n    87\t\tID         string            `json:\"id\"`"]
[1432.002274, "o", "\r\n    88\t\tPipeline   string            `json:\"pipeline\"`\r\n    89\t\tStatus     string            `json:\"status\"`\r\n    90\t\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n    91\t\tStartTime  *time.Time        `json:\"start_time,omitempty\"`\r\n    92\t\tEndTime    *time.Time        `json:\"end_time,omitempty\"`\r\n    93\t\tSteps      []*StepRun        `json:\"steps\"`\r\n    94\t\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n    95\t\tRunDir     string            `json:\"run_dir,omitempty\"`\r\n    96\t}\r\n    97\t\r\n    98\ttype Checkpoint struct {\r\n    99\t\tRunID      string            `json:\"run_id\"`\r\n   100\t\tStatus     string            `json:\"status\"`\r\n"]
[1432.002338, "o", "   101\t\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n   102\t\tSteps      []*StepRun        `json:\"steps\"`\r\n   103\t\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n   104\t}\r\n   105\t\r\n   106\tfunc loadPipelineConfig(path string) (*PipelineConfig, error) {\r\n   107\t\tdata, err := os.ReadFile(path)\r\n   108\t\tif err != nil {\r\n   109\t\t\treturn nil, fmt.Errorf(\"read pipeline config: %w\", err)\r\n"]
[1432.002401, "o", "   110\t\t}\r\n   111\t\tvar cfg PipelineConfig\r\n   112\t\tif err := json.Unmarshal(data, &cfg); err != nil {\r\n   113\t\t\treturn nil, fmt.Errorf(\"parse pipeline config: %w\", err)\r\n   114\t\t}\r\n"]
[1432.002462, "o", "   115\t\tif cfg.MaxParallel <= 0 {\r\n   116\t\t\tcfg.MaxParallel = 4\r\n   117\t\t}\r\n   118\t\treturn &cfg, nil\r\n   119\t}\r\n   120\t\r\n   121\tfunc validatePipelineConfig(cfg *PipelineConfig) error {\r\n   122\t\tif cfg.Name == \"\" {\r\n   123\t\t\treturn fmt.Errorf(\"pipeline name is required\")\r\n   124\t\t}\r\n   125\t\tif len(cfg.Steps) == 0 {\r\n   126\t\t\treturn fmt.Errorf(\"pipeline must have at least one step\")\r\n   127\t\t}\r\n   128"]
[1432.002524, "o", "\t\r\n   129\t\tnames := make(map[string]bool)\r\n   130\t\tfor _, step := range cfg.Steps {\r\n   131\t\t\tif step.Name == \"\" {\r\n   132\t\t\t\treturn fmt.Errorf(\"step name is required\")\r\n"]
[1432.002588, "o", "   133\t\t\t}\r\n   134\t\t\tif names[step.Name] {\r\n   135\t\t\t\treturn fmt.Errorf(\"duplicate step name: %s\", step.Name)\r\n   136\t\t\t}\r\n   137\t\t\tnames[step.Name] = true\r\n   138\t\t\tswitch step.Type {\r\n   139\t\t\tcase \"shell\", \"train\", \"evaluate\":\r\n   140\t\t\tdefault:\r\n   141\t\t\t\treturn fmt.Errorf(\"step %s has invalid type: %s\", step.Name, step.Type)\r\n   142\t\t\t}\r\n   143\t\t\tif step.Command == \"\" {\r\n   144\t\t\t\treturn fmt.Errorf(\"step %s command is required\", step.Name)\r\n   145"]
[1432.002648, "o", "\t\t\t}\r\n   146\t\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n   147\t\t\t\tif step.Resources.CPU > cfg.ResourceLimit.CPU {\r\n   148\t\t\t\t\treturn fmt.Errorf(\"step %s cpu requirement %d exceeds pipeline limit %d\", step.Name, step.Resources.CPU, cfg.ResourceLimit.CPU)\r\n   149\t\t\t\t}\r\n   150\t\t\t\tif step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n   151\t"]
[1432.002708, "o", "\t\t\t\treturn fmt.Errorf(\"step %s memory requirement %d MB exceeds pipeline limit %d MB\", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)\r\n   152\t\t\t\t}\r\n   153\t\t\t}\r\n   154\t\t\tif step.Type == \"train\" && step.ExperimentConfig == nil {\r\n   155\t\t\t\treturn fmt.Errorf(\"train step %s requires experiment_config\", step.Name)\r\n   156\t\t\t}\r\n   157\t\t}\r\n   158\t\r\n"]
[1432.002769, "o", "   159\t\tfor _, step := range cfg.Steps {\r\n   160\t\t\tfor _, dep := range step.DependsOn {\r\n   161\t\t\t\tif !names[dep] {\r\n"]
[1432.002832, "o", "   162\t\t\t\t\treturn fmt.Errorf(\"step %s depends on unknown step %s\", step.Name, dep)\r\n   163\t\t\t\t}\r\n   164\t\t\t}\r\n   165\t\t}\r\n   166\t\r\n   167\t\tif cycle := findCycle(cfg.Steps); cycle != nil {\r\n   168\t\t\treturn fmt.Errorf(\"cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n   169\t\t}\r\n   170\t\r\n   171\t\tproducers := make(map[string]string)\r\n   172\t\tfor _, step := range cfg.Steps {\r\n   173\t\t\tfor _, out := range step.Outputs {\r\n   174\t\t\t\tif _, ok := producers[out]; ok {\r\n"]
[1432.002887, "o", "   175\t\t\t\t\treturn fmt.Errorf(\"duplicate output artifact: %s\", out)\r\n   176\t\t\t\t}\r\n   177\t\t\t\tproducers[out] = step.Name\r\n   178\t\t\t}\r\n   179\t\t}\r\n   180\t\r\n"]
