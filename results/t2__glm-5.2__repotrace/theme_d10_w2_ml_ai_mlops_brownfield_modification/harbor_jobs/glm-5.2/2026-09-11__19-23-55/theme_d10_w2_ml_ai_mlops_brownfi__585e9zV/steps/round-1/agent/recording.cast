[1039.037363, "o", "func executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n\tstepByName := make(map[string]*PipelineStep)\r\n\tfor _, s := range cfg.Steps {\r\n\t\tstepByName[s.Name] = s\r\n\t}\r\n\trunStepByName := make(map[string]*StepRun)\r\n\t"]
[1039.037459, "o", "for _, sr := range run.Steps {\r\n\t\trunStepByName[sr.Name] = sr\r\n\t}\r\n\r\n\tartifactProducer := make(map[string]string)\r\n\tfor _, step := range cfg.Steps {\r\n\t\tfor _, out := range step.Outputs {\r\n\t\t\tartifactProducer[out] = step.Name\r\n\t\t}\r\n\t}\r\n\r\n\tvar mu sync.Mutex\r\n\tvar running []*PipelineStep\r\n\tavailable := make(chan struct{}, maxParallel)\r\n\r\n"]
[1039.037521, "o", "\tpending := make(map[string]bool)\r\n\tfor _, step := range cfg.Steps {\r\n\t\tpending[step.Name] = true\r\n\t}\r\n\r\n\tvar wg sync.WaitGroup\r\n\tdone := false\r\n\r\n\tcanStart := func(step *PipelineStep) bool {\r\n\t\tfor _, dep := range step.DependsOn {\r\n\t\t\tstatus := runStepByName[dep].Status\r\n"]
[1039.037584, "o", "\t\t\tif status != \"succeeded\" && status != \"skipped\" {\r\n\t\t\t\treturn false\r\n\t\t\t}\r\n\t\t}\r\n\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n\t\t\tvar cpu, mem int\r\n\t\t\tfor _, r := range running {\r\n\t\t\t\tif r.Resources != nil {\r\n\t\t\t\t\tcpu += r.Resources.CPU\r\n"]
[1039.037643, "o", "\t\t\t\t\tmem += r.Resources.MemoryMB\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n\t\t\t\treturn false\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn true\r\n\t}\r\n\r\n"]
[1039.037706, "o", "\tstartStep := func(step *PipelineStep) {\r\n\t\tpending[step.Name] = false\r\n\t\trunning = append(running, step)\r\n\t\twg.Add(1)\r\n\t\tgo func(s *PipelineStep) {\r\n\t\t\tdefer wg.Done()\r\n\t\t\texecuteStep(cfg, run, tracker, s, params, runStepByName[s.Name])\r\n\t\t\tmu.Lock()\r\n\t\t\trunning = removeStep(running, s)\r\n\t\t\tif run.Status == \"failed\" {\r\n\t\t\t"]
[1039.037763, "o", "\tdone = true\r\n\t\t\t}\r\n\t\t\tsaveCheckpoint(run)\r\n\t\t\tsaveRun(run)\r\n\t\t\tmu.Unlock()\r\n\t\t\t<-available\r\n\t\t}(step)\r\n"]
[1039.037827, "o", "\t}\r\n\r\n\tfor !done && (len(pending) > 0 || len(running) > 0) {\r\n\t\tstartedAny := false\r\n\t\tvar starts []*PipelineStep\r\n\t\tmu.Lock()\r\n\t\tfor _, step := range cfg.Steps {\r\n\t\t\tif pending[step.Name] && canStart(step) {\r\n\t\t\t\tstarts = append(starts, step)\r\n\t\t\t}\r\n"]
[1039.037883, "o", "\t\t}\r\n\t\tmu.Unlock()\r\n\t\tsort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })\r\n\t\tfor _, step := range starts {\r\n\t\t\tavailable <- struct{}{}\r\n\t\t\tmu.Lock()\r\n\t\t\tif done || !pending[step.Name] || !canStart(step) {\r\n\t\t\t\tmu.Unlock()\r\n"]
[1039.037943, "o", "\t\t\t\t<-available\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tstartStep(step)\r\n\t\t\tmu.Unlock()\r\n\t\t\tstartedAny = true\r\n\t\t}\r\n\r\n"]
[1039.03801, "o", "\t\tif !startedAny {\r\n\t\t\tif len(running) == 0 {\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\ttime.Sleep(10 * time.Millisecond)\r\n\t\t}\r\n"]
[1039.03808, "o", "\t}\r\n\twg.Wait()\r\n\r\n\tfor _, sr := range run.Steps {\r\n\t\tif sr.Status == \"pending\" {\r\n\t\t\tsr.Status = \"skipped\"\r\n\t\t\tsr.Error = \"dependency failed\"\r\n\t\t}\r\n\t}\r\n\tsaveCheckpoint(run)\r\n\tsaveRun(run)\r\n\r\n\tif run.Status == \"failed\" {\r\n\t\treturn fmt.Errorf(\"pipeline execution failed\")\r\n"]
[1039.03814, "o", "\t}\r\n\treturn nil\r\n}\r\n\r\nfunc removeStep(steps []*PipelineStep, target *PipelineStep) []*PipelineStep {\r\n\tout := make([]*PipelineStep, 0, len(steps))\r\n\tfor _, s := range steps {\r\n\t\tif s != target {\r\n\t\t\tout = append(out, s)\r\n\t\t}\r\n\t}\r\n\treturn out\r\n}\r\n\r\n"]
