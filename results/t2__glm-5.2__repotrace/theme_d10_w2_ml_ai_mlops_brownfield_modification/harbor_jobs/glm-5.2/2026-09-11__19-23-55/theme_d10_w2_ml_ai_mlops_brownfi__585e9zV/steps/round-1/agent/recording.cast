[3052.01914, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc isTransitiveDependency(steps []*PipelineStep, step, target string) bool {\r\n\tbyName := make(map[string]*PipelineStep)\r\n"]
[3052.019229, "o", "\tfor _, s := range steps {\r\n\t\tbyName[s.Name] = s\r\n\t}\r\n\tvar visit func(current string) bool\r\n\tvisit = func(current string) bool {\r\n\t\ts := byName[current]\r\n\t\tfor _, dep := range s.DependsOn {\r\n\t\t\tif dep == target {\r\n\t\t\t\treturn true\r\n\t\t\t}\r\n\t\t\tif visit(dep) {\r\n\t\t\t\treturn true\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn false\r\n"]
[3052.019298, "o", "\t}\r\n\treturn visit(step)\r\n}\r\n\r\nfunc runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {\r\n\tif err := validatePipelineConfig(cfg); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tmerged := mergeParams(cfg.Parameters, params)\r\n\tif maxParallel <= 0 {\r\n\t\tmaxParallel = cfg.MaxParallel\r\n"]
[3052.019361, "o", "\t}\r\n\tif maxParallel <= 0 {\r\n\t\tmaxParallel = 4\r\n\t}\r\n\r\n\trunID := generateRunID()\r\n\trunDir := filepath.Join(pipelineRunsDir, runID)\r\n\tartifactsDir := filepath.Join(runDir, \"artifacts\")\r\n\tif err := os.MkdirAll(artifactsDir, 0755); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"create run dir: %w\", err)\r\n\t}\r\n\tif cfgData, err := json.MarshalIndent(cfg, \"\", \"  \"); err == nil {\r\n"]
[3052.019421, "o", "\t\tos.WriteFile(filepath.Join(runDir, \"pipeline_config.json\"), cfgData, 0644)\r\n\t}\r\n\r\n\tnow := time.Now()\r\n\trun := &PipelineRun{\r\n\t\tID:         runID,\r\n\t\tPipeline:   cfg.Name,\r\n\t\tStatus:     \"running\",\r\n\t\tParameters: merged,\r\n"]
[3052.019494, "o", "\t\tStartTime:  &now,\r\n\t\tRunDir:     runDir,\r\n\t\tVariables:  copyMap(merged),\r\n\t\tSteps:      make([]*StepRun, 0, len(cfg.Steps)),\r\n\t}\r\n\tfor _, step := range cfg.Steps {\r\n\t\trun.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: \"pending\"})\r\n\t}\r\n\tsaveRun(run)\r\n\r\n"]
[3052.019585, "o", "\terr := executeSteps(cfg, run, tracker, merged, maxParallel)\r\n\tendTime := time.Now()\r\n\trun.EndTime = &endTime\r\n\tif err != nil {\r\n\t\trun.Status = \"failed\"\r\n\t} else {\r\n\t\trun.Status = \"succeeded\"\r\n\t}\r\n\tsaveRun(run)\r\n\treturn run, err\r\n}\r\n\r\nfunc executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n\tstepByName := make(map[string]*PipelineStep)\r\n\tfor _, s := range cfg.Steps {\r\n\t\t"]
[3052.01967, "o", "stepByName[s.Name] = s\r\n\t}\r\n\trunStepByName := make(map[string]*StepRun)\r\n\tfor _, sr := range run.Steps {\r\n\t\trunStepByName[sr.Name] = sr\r\n\t}\r\n\r\n\tvariables := make(map[string]string)\r\n\tif run.Variables != nil {\r\n\t\tfor k, v := range run.Variables {\r\n\t\t\tvariables[k] = v\r\n\t\t}\r\n\t} else {\r\n\t\tfor k, v := range params {\r\n\t\t"]
[3052.019739, "o", "\tvariables[k] = v\r\n\t\t}\r\n\t}\r\n\tvar varMu sync.Mutex\r\n\r\n\tvar mu sync.Mutex\r\n\tvar running []*PipelineStep\r\n\t"]
[3052.019804, "o", "available := make(chan struct{}, maxParallel)\r\n\r\n\tpending := make(map[string]bool)\r\n\tfor _, step := range cfg.Steps {\r\n\t\tsr := runStepByName[step.Name]\r\n\t\tif sr.Status == \"succeeded\" || sr.Status == \"skipped\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif sr.Status == \"failed\" {\r\n\t\t\tsr.Status = \"pending\"\r\n\t\t\tsr.Error = \"\"\r\n\t\t\tsr.Output = \"\"\r\n"]
[3052.019871, "o", "\t\t\tsr.StartTime = nil\r\n\t\t\tsr.EndTime = nil\r\n\t\t}\r\n\t\tpending[step.Name] = true\r\n\t}\r\n\r\n\tvar wg sync.WaitGroup\r\n\tdone := false\r\n\r\n\tcanStart := func(step *PipelineStep) bool {\r\n\t\t"]
[3052.019931, "o", "for _, dep := range step.DependsOn {\r\n\t\t\tstatus := runStepByName[dep].Status\r\n\t\t\tif status != \"succeeded\" && status != \"skipped\" {\r\n\t\t\t\treturn false\r\n\t\t\t}\r\n\t\t}\r\n\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n\t\t\tvar cpu, mem int\r\n\t\t\tfor _, r := range running {\r\n\t\t\t\tif r.Resources != nil {\r\n\t\t\t\t\tcpu += r.Resources.CPU\r\n\t\t\t\t\tmem += r.Resources.MemoryMB\r\n\t\t\t\t}\r\n"]
[3052.019997, "o", "\t\t\t}\r\n\t\t\tif cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n\t\t\t\treturn false\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn true\r\n\t}\r\n\r\n\tstartStep := func(step *PipelineStep) {\r\n\t\tpending[step.Name] = false\r\n\t\trunning = append(running, step)\r\n"]
[3052.020076, "o", "\t\twg.Add(1)\r\n\t\tgo func(s *PipelineStep) {\r\n\t\t\tdefer wg.Done()\r\n\t\t\texecuteStep(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])\r\n\t\t\tmu.Lock()\r\n\t\t\trunning = removeStep(running, s)\r\n\t\t\tif runStepByName[s.Name].Status == \"failed\" {\r\n\t\t\t\trun.Status = \"failed\"\r\n\t\t\t\tdone = true\r\n\t\t\t}\r\n\t\t\tvarMu.Lock()\r\n"]
[3052.020138, "o", "\t\t\trun.Variables = copyMap(variables)\r\n\t\t\tvarMu.Unlock()\r\n\t\t\tsaveCheckpoint(run)\r\n\t\t\tsaveRun(run)\r\n\t\t\tmu.Unlock()\r\n\t\t\t<-available\r\n\t\t}(step)\r\n\t}\r\n\r\n\tfor !done && (len(pending) > 0 || len(running) > 0) {\r\n"]
[3052.020201, "o", "\t\tstartedAny := false\r\n\t\tvar starts []*PipelineStep\r\n\t\tmu.Lock()\r\n\t\tfor _, step := range cfg.Steps {\r\n\t\t\tif pending[step.Name] && canStart(step) {\r\n\t\t\t\tstarts = append(starts, step)\r\n\t\t\t}\r\n\t\t}\r\n\t\tmu.Unlock()\r\n"]
[3052.020267, "o", "\t\tsort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })\r\n\t\tfor _, step := range starts {\r\n\t\t\tavailable <- struct{}{}\r\n\t\t\tmu.Lock()\r\n\t\t\tif done || !pending[step.Name] || !canStart(step) {\r\n\t\t\t\tmu.Unlock()\r\n\t\t\t\t<-available\r\n\t\t\t\tcontinue\r\n\t"]
[3052.020333, "o", "\t\t}\r\n\t\t\tstartStep(step)\r\n\t\t\tmu.Unlock()\r\n\t\t\tstartedAny = true\r\n\t\t}\r\n\r\n"]
[3052.020394, "o", "\t\tif !startedAny {\r\n\t\t\tif len(running) == 0 {\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\ttime.Sleep(10 * time.Millisecond)\r\n\t\t}\r\n\t}\r\n\twg.Wait()\r\n\r\n\tfor _, sr := range run.Steps {\r\n\t\tif sr.Status == \"pending\" {\r\n\t\t\tsr.Status = \"failed\"\r\n\t\t\tsr.Error = \"dependency failed\"\r\n\t\t}\r\n\t"]
[3052.020456, "o", "}\r\n\tvarMu.Lock()\r\n\trun.Variables = copyMap(variables)\r\n\tvarMu.Unlock()\r\n\tsaveCheckpoint(run)\r\n\tsaveRun(run)\r\n\r\n\tif run.Status == \"failed\" {\r\n\t\treturn fmt.Errorf(\"pipeline execution failed\")\r\n\t}\r\n\treturn nil\r\n}\r\n"]
[3052.020515, "o", "func removeStep(steps []*PipelineStep, target *PipelineStep) []*PipelineStep {\r\n\tout := make([]*PipelineStep, 0, len(steps))\r\n\tfor _, s := range steps {\r\n\t\tif s != target {\r\n\t\t\tout = append(out, s)\r\n\t\t}\r\n\t}\r\n\treturn out\r\n}\r\n"]
[3052.020579, "o", "\r\nfunc executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {\r\n\tfor _, dep := range step.DependsOn {\r\n\t\tdepStatus := getRunStep(run, dep).Status\r\n\t\tif depStatus != \"succeeded\" && depStatus != \"skipped\" {\r\n\t"]
[3052.02064, "o", "\t\tsr.Status = \"failed\"\r\n\t\t\tsr.Error = \"dependency failed\"\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n\r\n\tvarMu.Lock()\r\n\tvars := copyMap(variables)\r\n\tvarMu.Unlock()\r\n\r\n"]
[3052.020702, "o", "\tif step.Condition != \"\" {\r\n\t\tcond, err := evaluateCondition(step.Condition, vars)\r\n\t\tif err != nil {\r\n\t\t\tsr.Status = \"failed\"\r\n\t\t\tsr.Error = err.Error()\r\n\t\t\treturn\r\n\t\t}\r\n\t\tif !cond {\r\n\t\t\tsr.Status = \"skipped\"\r\n\t\t\tsr.Output = \"condition false\"\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n"]
[3052.020764, "o", "\r\n\tcmdStr, err := substituteVariables(step.Command, vars)\r\n\tif err != nil {\r\n\t\tsr.Status = \"failed\"\r\n\t\tsr.Error = err.Error()\r\n\t\treturn\r\n\t}\r\n\r\n\tenvVars := os.Environ()\r\n\tfor k, v := range vars {\r\n\t\tenvVars = append(envVars, \"NEXUS_PARAM_\"+k+\"=\"+v)\r\n"]
[3052.020821, "o", "\t}\r\n\tfor k, v := range step.Env {\r\n\t\tev, err := substituteVariables(v, vars)\r\n\t\tif err != nil {\r\n\t\t\tsr.Status = \"failed\"\r\n\t\t\tsr.Error = fmt.Sprintf(\"env %s: %v\", k, err)\r\n\t\t\treturn\r\n"]
[3052.020892, "o", "\t\t}\r\n\t\tenvVars = append(envVars, k+\"=\"+ev)\r\n\t}\r\n\r\n\tmaxRetries := 0\r\n\tbackoffBase := 1\r\n\tif step.Retry != nil {\r\n\t\tmaxRetries = step.Retry.MaxRetries\r\n\t\tif step.Retry.BackoffBaseSeconds > 0 {\r\n\t\t\tbackoffBase = step.Retry.BackoffBaseSeconds\r\n\t\t}\r\n\t}\r\n\r\n"]
[3052.020952, "o", "\tvar exp *Experiment\r\n\tif step.Type == \"train\" {\r\n\t\tvar err error\r\n\t\texp, err = createTrainExperiment(tracker, step, sr.ExperimentID)\r\n\t\tif err != nil {\r\n\t\t\tsr.Status = \"failed\"\r\n\t\t\tsr.Error = err.Error()\r\n\t\t\treturn\r\n"]
[3052.02101, "o", "\t\t}\r\n\t\tsr.ExperimentID = exp.ID\r\n\t}\r\n\r\n\tfor attempt := 0; attempt <= maxRetries; attempt++ {\r\n\t\tstart := time.Now()\r\n\t\tsr.StartTime = &start\r\n\t\tsr.RetryCount = attempt\r\n"]
[3052.021602, "o", "\u001b[?2004h"]
