[4018.987454, "o", "func executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {\r\n\tfor _, dep := range step.DependsOn {\r\n\t\tdepStatus := getRunStep(run, dep).Status\r\n\t\tif depStatus == \"succeeded\" || depStatus == \"skipped\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif depStatus == \"failed\" {\r\n\t\t\tdepStep := getStepConfig(cfg, dep)\r\n\t\t\tif depStep != nil && depStep.AllowFailure {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t}\r\n\t\tsr.Status = \"failed\"\r\n"]
[4018.987514, "o", "\t\tsr.Error = \"dependency failed\"\r\n\t\treturn\r\n\t}\r\n\r\n\tvarMu.Lock()\r\n\tvars := copyMap(variables)\r\n\tvarMu.Unlock()\r\n\r\n\tif step.Condition != \"\" {\r\n"]
[4018.987571, "o", "\t\tcond, err := evaluateCondition(step.Condition, vars)\r\n\t\tif err != nil {\r\n\t\t\tsr.Status = \"failed\"\r\n\t\t\tsr.Error = err.Error()\r\n\t\t\treturn\r\n\t\t}\r\n\t\tif !cond {\r\n\t\t\tsr.Status = \"skipped\"\r\n"]
[4018.987627, "o", "\t\t\tsr.Output = \"condition false\"\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n\r\n\tcmdStr, err := substituteVariables(step.Command, vars)\r\n\tif err != nil {\r\n\t\tsr.Status = \"failed\"\r\n\t\tsr.Error = err.Error()\r\n"]
[4018.987686, "o", "\t\treturn\r\n\t}\r\n\r\n\tenvVars := os.Environ()\r\n\tfor k, v := range vars {\r\n\t\tenvVars = append(envVars, \"NEXUS_PARAM_\"+k+\"=\"+v)\r\n\t}\r\n\tfor k, v := range step.Env {\r\n\t\tev, err := substituteVariables(v, vars)\r\n"]
[4018.987746, "o", "\t\tif err != nil {\r\n\t\t\tsr.Status = \"failed\"\r\n\t\t\tsr.Error = fmt.Sprintf(\"env %s: %v\", k, err)\r\n\t\t\treturn\r\n\t\t}\r\n\t\tenvVars = append(envVars, k+\"=\"+ev)\r\n\t}\r\n\r\n\tmaxRetries := 0\r\n\tbackoffBase := 1\r\n"]
