[4856.417401, "o", "func evaluateCondition(cond string, vars map[string]string) (bool, error) {\r\n\tcond = strings.TrimSpace(cond)\r\n\tif cond == \"\" {\r\n\t\treturn true, nil\r\n\t}"]
[4856.417465, "o", "\r\n\r\n\tunresolved := false\r\n\r\n\tsubstitute := func(s string) (string, bool) {\r\n\t\tres, err := substituteVariables(strings.TrimSpace(s), vars)\r\n\t\tif err != nil {\r\n\t\t\tunresolved = true\r\n\t\t\treturn \"\", false\r\n\t\t}\r\n\t"]
[4856.417524, "o", "\treturn res, true\r\n\t}\r\n\r\n\tevalPrimitive := func(expr string) (bool, error) {\r\n\t\texpr = strings.TrimSpace(expr)\r\n\t\tif expr == \"\" {\r\n\t\t\treturn false, fmt.Errorf(\"invalid condition: empty expression\")\r\n\t\t}\r\n\r\n"]
[4856.417557, "o", "\t\tif parts := strings.SplitN(expr, \" contains \", 2); len(parts) == 2 {\r\n\t\t\tleft, ok := substitute(parts[0])\r\n\t\t\tif !ok {\r\n\t\t\t\treturn false, nil\r\n\t\t\t}\r\n"]
[4856.417614, "o", "\t\t\tright, ok := substitute(parts[1])\r\n\t\t\tif !ok {\r\n\t\t\t\treturn false, nil\r\n\t\t\t}\r\n\t\t\treturn strings.Contains(left, right), nil\r\n\t\t}\r\n\r\n\t\tif parts := strings.SplitN(expr, \"==\", 2); len(parts) == 2 {\r\n"]
[4856.417666, "o", "\t\t\tleft, ok := substitute(parts[0])\r\n\t\t\tif !ok {\r\n\t\t\t\treturn false, nil\r\n\t\t\t}\r\n\t\t\tright, ok := substitute(parts[1])\r\n\t\t\tif !ok {\r\n\t\t\t\treturn false, nil\r\n"]
[4856.417718, "o", "\t\t\t}\r\n\t\t\treturn left == right, nil\r\n\t\t}\r\n\r\n\t\tif parts := strings.SplitN(expr, \"!=\", 2); len(parts) == 2 {\r\n\t\t\tleft, ok := substitute(parts[0])\r\n\t\t\tif !ok {\r\n"]
[4856.41775, "o", "\t\t\t\treturn false, nil\r\n\t\t\t}\r\n\t\t\tright, ok := substitute(parts[1])\r\n\t\t\tif !ok {\r\n"]
[4856.417806, "o", "\t\t\t\treturn false, nil\r\n\t\t\t}\r\n\t\t\treturn left != right, nil\r\n\t\t}\r\n\r\n\t\t// A bare token may be a forward reference. Treat unresolved variables as\r\n\t\t// false rather than a runtime error, while still rejecting invalid syntax.\r\n\t\tif _, ok := substitute(expr); !ok {\r\n\t\t\treturn false, nil\r\n"]
[4856.417862, "o", "\t\t}\r\n\t\treturn false, fmt.Errorf(\"invalid condition: %s\", expr)\r\n\t}\r\n\r\n\t// Evaluate every primitive so unresolved references in short-circuited\r\n\t// branches still force the whole condition to false. && binds tighter than\r\n\t// ||, so split OR first and AND second.\r\n"]
[4856.417895, "o", "\torGroups := strings.Split(cond, \"||\")\r\n\tgroupResults := make([][]bool, len(orGroups))\r\n\r\n\tfor i, orPart := range orGroups {\r\n\t\tfor _, andPart := range strings.Split(orPart, \"&&\") {\r\n\t\t\tres, err := evalPrimitive(andPart)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn false, err\r\n\t\t\t}\r\n\t\t\tgroupResults[i] = append(groupResults[i], res)"]
[4856.417915, "o", "\r\n\t\t}\r\n\t}\r\n\r\n\tif unresolved {\r\n"]
[4856.417934, "o", "\t\treturn false, nil\r\n\t}\r\n\r\n"]
[4856.417955, "o", "\tfor _, group := range groupResults {\r\n\t\tallTrue := true\r\n\t\tfor _, res := range group {\r\n"]
[4856.417974, "o", "\t\t\tif !res {\r\n\t\t\t\tallTrue = false\r\n"]
[4856.417994, "o", "\t\t\t\tbreak\r\n"]
