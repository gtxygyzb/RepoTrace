[6528.972376, "o", "    16\t)\r\n    17\t\r\n    18\tconst pipelineRunsDir = \"/tmp/nexus/runs\"\r\n    19\t\r\n    20\ttype PipelineResourceLimit struct {\r\n    21\t\tCPU      int `json:\"cpu,omitempty\"`\r\n    22\t\tMemoryMB int `json:\"memory_mb,omitempty\"`\r\n    23\t}\r\n    24\t\r\n    25\ttype PipelineStepResources struct {\r\n    26\t\tCPU      int `json:\"cpu,omitempty\"`\r\n    27\t\tMemoryMB int `json:\"memory_mb,omitempty\"`\r\n    28\t}\r\n"]
[6528.972466, "o", "    29\t\r\n    30\ttype PipelineStepRetry struct {\r\n    31\t\tMaxRetries         int `json:\"max_retries,omitempty\"`\r\n    32\t\tBackoffBaseSeconds int `json:\"backoff_base_seconds,omitempty\"`\r\n    33\t}\r\n    34\t\r\n    35\ttype CaptureOutputConfig struct {\r\n    36\t\tName  string `json:\"name\"`\r\n    37\t\tRegex string `json:\"regex,omitempty\"`\r\n    38\t}\r\n    39\t\r\n    40\tfunc (c *CaptureOutputConfig) UnmarshalJSON(data []byte) error {\r\n    41\t\tvar str string\r\n"]
[6528.972539, "o", "    42\t\tif err := json.Unmarshal(data, &str); err == nil {\r\n    43\t\t\tc.Name = str\r\n    44\t\t\tc.Regex = \"\"\r\n    45\t\t\treturn nil\r\n    46\t\t}\r\n    47\t\tvar raw struct {\r\n    48\t\t\tName  string `json:\"name\"`\r\n    49\t\t\tRegex string `json:\"regex\"`\r\n    50\t\t}\r\n"]
[6528.972618, "o", "    51\t\tif err := json.Unmarshal(data, &raw); err != nil {\r\n    52\t\t\treturn fmt.Errorf(\"capture_output must be a string or an object with name and optional regex\")\r\n    53\t\t}\r\n    54\t\tc.Name = raw.Name\r\n    55\t\tc.Regex = raw.Regex\r\n    56\t\treturn nil\r\n    57\t}\r\n    58\t\r\n"]
[6528.972689, "o", "    59\ttype PipelineExperimentConfig struct {\r\n    60\t\tName    string            `json:\"name,omitempty\"`\r\n    61\t\tParams  map[string]string `json:\"params,omitempty\"`\r\n    62\t\tMetrics []string          `json:\"metrics,omitempty\"`\r\n    63\t}\r\n    64\t\r\n    65\ttype PipelineStep struct {\r\n    66\t\tName             string                    `json:\"name\"`\r\n    67\t\tType             string                    `json:\"type\"`\r\n    68\t\tCommand          string                    `json:\"command\"`\r\n    69\t\tDependsOn        []string                  `json:\"depends_on,omitempty\"`\r\n    70\t\tInputs           []string                  `json:\"inputs,omitempty\"`\r\n    71\t\tOutputs          []string                  `json:\"outputs,omitempty\"`\r\n    72\t\tResources        *PipelineStepResources    `json:\"resources,omitempty\"`\r\n    73\t\tTimeoutSeconds   int                       `json:\"timeout_seconds,omitempty\"`\r\n    74\t\tRetry            *PipelineStepRetry        `json:\"retry,omitempty\"`\r\n"]
