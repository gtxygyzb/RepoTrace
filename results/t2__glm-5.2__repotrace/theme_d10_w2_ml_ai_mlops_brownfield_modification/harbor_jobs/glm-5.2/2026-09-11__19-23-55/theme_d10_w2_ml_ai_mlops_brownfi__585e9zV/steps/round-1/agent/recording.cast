[1451.008937, "o", "   120\t\r\n   121\tfunc validatePipelineConfig(cfg *PipelineConfig) error {\r\n   122\t\tif cfg.Name == \"\" {\r\n   123\t\t\treturn fmt.Errorf(\"pipeline name is required\")\r\n   124\t\t}\r\n   125\t"]
[1451.00907, "o", "\tif len(cfg.Steps) == 0 {\r\n   126\t\t\treturn fmt.Errorf(\"pipeline must have at least one step\")\r\n   127\t\t}\r\n   128\t\r\n   129\t\tnames := make(map[string]bool)\r\n   130\t\tfor _, step := range cfg.Steps {\r\n   131\t\t\tif step.Name == \"\" {\r\n   132\t\t\t\treturn fmt.Errorf(\"step name is required\")\r\n   133\t\t\t}\r\n   134\t\t\tif names[step.Name] {\r\n   135\t\t\t\treturn fmt.Errorf(\"duplicate step name: %s\", step.Name)\r\n   136\t\t\t}\r\n   137\t\t\tnames[step.Name] = true\r\n   138\t\t\tswitch step.Type {\r\n   139\t\t\tcase \"shell\", \"train\", \"evaluate\":\r\n   140\t\t\t"]
[1451.009157, "o", "default:\r\n   141\t\t\t\treturn fmt.Errorf(\"step %s has invalid type: %s\", step.Name, step.Type)\r\n   142\t\t\t}\r\n   143\t\t\tif step.Command == \"\" {\r\n   144\t\t\t\treturn fmt.Errorf(\"step %s command is required\", step.Name)\r\n   145\t\t\t}\r\n   146\t\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n   147\t\t\t\tif step.Resources.CPU > cfg.ResourceLimit.CPU {\r\n   148\t\t\t\t\treturn fmt.Errorf(\"step %s cpu requirement %d exceeds pipeline limit %d\", step.Name, step.Resources.CPU, cfg.ResourceLimit.CPU)\r\n   149\t\t\t\t}\r\n   150\t\t\t\tif step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n"]
[1451.00922, "o", "   151\t\t\t\t\treturn fmt.Errorf(\"step %s memory requirement %d MB exceeds pipeline limit %d MB\", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)\r\n   152\t\t\t\t}\r\n   153\t\t\t}\r\n   154\t\t\tif step.Type == \"train\" && step.ExperimentConfig == nil {\r\n   155\t\t\t\treturn fmt.Errorf(\"train step %s requires experiment_config\", step.Name)\r\n   156\t\t\t}\r\n   157\t\t}\r\n   158\t\r\n"]
[1451.009331, "o", "   159\t\tfor _, step := range cfg.Steps {\r\n   160\t\t\tfor _, dep := range step.DependsOn {\r\n   161\t\t\t\tif !names[dep] {\r\n   162\t\t\t\t\treturn fmt.Errorf(\"step %s depends on unknown step %s\", step.Name, dep)\r\n   163\t\t\t\t}\r\n   164\t\t\t}\r\n   165\t\t}\r\n   166\t\r\n   167\t\tif cycle := findCycle(cfg.Steps); cycle != nil {\r\n   168\t\t\treturn fmt.Errorf(\"cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n   169\t\t}\r\n   170\t\r\n   171\t\tproducers := make(map[string]string)\r\n   172\t"]
[1451.009395, "o", "\tfor _, step := range cfg.Steps {\r\n   173\t\t\tfor _, out := range step.Outputs {\r\n   174\t\t\t\tif _, ok := producers[out]; ok {\r\n   175\t\t\t\t\treturn fmt.Errorf(\"duplicate output artifact: %s\", out)\r\n   176\t\t\t\t}\r\n   177\t\t\t\tproducers[out] = step.Name\r\n   178\t\t\t}\r\n   179\t\t}\r\n   180"]
[1451.009456, "o", "\t\r\n   181\t\tfor _, step := range cfg.Steps {\r\n   182\t\t\tfor _, in := range step.Inputs {\r\n   183\t\t\t\tprod, ok := producers[in]\r\n   184\t\t\t\tif !ok {\r\n   185\t\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s is not produced by any step\", step.Name, in)\r\n   186\t\t\t\t}\r\n   187\t\t\t\t"]
[1451.009514, "o", "if prod == step.Name {\r\n   188\t\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s must come from a dependency\", step.Name, in)\r\n   189\t\t\t\t}\r\n   190\t\t\t\tif !isTransitiveDependency(cfg.Steps, step.Name, prod) {\r\n   191\t\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s producer %s is not a transitive dependency\", step.Name, in, prod)\r\n   192\t\t\t\t}\r\n   193\t\t\t}\r\n"]
[1451.009575, "o", "   194\t\t}\r\n   195\t\treturn nil\r\n   196\t}\r\n   197\t\r\n   198\tfunc findCycle(steps []*PipelineStep) []string {\r\n   199\t\tgraph := make(map[string][]string)\r\n   200\t\tfor _, s := range steps {\r\n   201\t\t\tgraph[s.Name] = append(graph[s.Name], s.DependsOn...)\r\n   202\t\t}\r\n"]
[1451.009638, "o", "   203\t\tvisited := make(map[string]int)\r\n   204\t\tvar stack []string\r\n   205\t\tvar dfs func(node string) []string\r\n   206\t\tdfs = func(node string) []string {\r\n   207\t\t\tvisited[node] = 1\r\n   208\t\t\tstack = append(stack, node)\r\n   209\t\t\tfor _, dep := range graph[node] {\r\n   210\t\t\t\tif visited[dep] == 1 {\r\n   211\t\t\t\t\tfor i, n := range stack {\r\n"]
[1451.009701, "o", "   212\t\t\t\t\t\tif n == dep {\r\n   213\t\t\t\t\t\t\treturn append(append([]string{}, stack[i:]...), dep)\r\n   214\t\t\t\t\t\t}\r\n   215\t\t\t\t\t}\r\n   216\t\t\t\t\treturn []string{node, dep}\r\n   217\t\t\t\t}\r\n   218\t\t\t\tif visited[dep] == 0 {\r\n   219\t\t"]
[1451.009763, "o", "\t\t\tif c := dfs(dep); c != nil {\r\n   220\t\t\t\t\t\treturn c\r\n   221\t\t\t\t\t}\r\n   222\t\t\t\t}\r\n   223\t\t\t}\r\n   224\t\t\tstack = stack[:len(stack)-1]\r\n   225\t\t\tvisited[node] = 2\r\n"]
[1451.009824, "o", "   226\t\t\treturn nil\r\n   227\t\t}\r\n   228\t\tfor _, s := range steps {\r\n   229\t\t\tif visited[s.Name] == 0 {\r\n   230\t\t\t\tif c := dfs(s.Name); c != nil {\r\n   231\t\t\t\t\treturn c\r\n   232\t\t\t\t}\r\n   233\t\t\t}\r\n   234\t\t"]
[1451.009885, "o", "}\r\n   235\t\treturn nil\r\n   236\t}\r\n   237\t\r\n   238\tfunc isTransitiveDependency(steps []*PipelineStep, step, target string) bool {\r\n   239\t\tbyName := make(map[string]*PipelineStep)\r\n   240\t\tfor _, s := range steps {\r\n   241\t\t\tbyName[s.Name] = s\r\n   242\t\t}\r\n"]
[1451.009946, "o", "   243\t\tvar visit func(current string) bool\r\n   244\t\tvisit = func(current string) bool {\r\n   245\t\t\ts := byName[current]\r\n   246\t\t\tfor _, dep := range s.DependsOn {\r\n   247\t\t\t\tif dep == target {\r\n   248\t\t\t\t\treturn true\r\n   249\t\t\t\t}\r\n   250\t\t\t\tif visit(dep) {\r\n"]
[1451.010003, "o", "   251\t\t\t\t\treturn true\r\n   252\t\t\t\t}\r\n   253\t\t\t}\r\n   254\t\t\treturn false\r\n   255\t\t}\r\n   256\t\treturn visit(step)\r\n   257\t}\r\n   258\t\r\n   259\tfunc runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {\r\n"]
[1451.010102, "o", "   260\t\tif err := validatePipelineConfig(cfg); err != nil {\r\n"]
