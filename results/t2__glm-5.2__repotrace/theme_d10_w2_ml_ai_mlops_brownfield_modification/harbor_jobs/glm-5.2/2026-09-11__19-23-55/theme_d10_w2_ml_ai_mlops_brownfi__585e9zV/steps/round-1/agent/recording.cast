[6203.96657, "o", "\tif maxParallel <= 0 {\r\n\t\tmaxParallel = cfg.MaxParallel\r\n\t}\r\n\tif maxParallel <= 0 {\r\n\t\tmaxParallel = 4\r\n\t}\r\n\r\n\trunID := generateRunID()\r\n"]
[6203.966717, "o", "\trunDir := filepath.Join(pipelineRunsDir, runID)\r\n\tartifactsDir := filepath.Join(runDir, \"artifacts\")\r\n\tif err := os.MkdirAll(artifactsDir, 0755); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"create run dir: %w\", err)\r\n\t}\r\n\tif cfgData, err := json.MarshalIndent(cfg, \"\", \"  \"); err == nil {\r\n"]
[6203.966806, "o", "\t\tos.WriteFile(filepath.Join(runDir, \"pipeline_config.json\"), cfgData, 0644)\r\n\t}\r\n\r\n\tnow := time.Now()\r\n\trun := &PipelineRun{\r\n\t\tID:          runID,\r\n\t\tPipeline:    cfg.Name,\r\n\t\tStatus:      \"running\",\r\n\t\tParameters:  merged,\r\n\t\tStartTime:   &now,\r\n\t\tRunDir:      runDir,\r\n\t\tVariables:   copyMap(merged),\r\n\t\tWarnings:    []string{},\r\n\t\tTags:        copyTags(cfg.Tags),\r\n\t\tDescription: cfg.Description,\r\n\t\tSteps:       make([]*StepRun, 0, len(cfg.Steps)),\r\n\t}\r\n\tfor _, step := range cfg.Steps {\r\n\t\trun.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: \"pending\"})\r\n\t}\r\n\tsaveRun(run)\r\n\r\n\terr := executeSteps(cfg, run, tracker, merged, maxParallel)\r\n\tendTime := time.Now()\r\n\trun.EndTime = &endTime\r\n\tif err != nil {\r\n\t\trun.Status = \"failed\"\r\n\t} else if run.Status != \"succeeded_with_warnings\" {\r\n\t\trun.Status = \"succeeded\"\r\n\t}\r\n"]
[6203.966885, "o", "\tsaveRun(run)\r\n\treturn run, err\r\n}\r\n\r\nfunc executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n\tstepByName := make(map[string]*PipelineStep)\r\n\tfor _, s := range cfg.Steps {\r\n\t\tstepByName[s.Name] = s\r\n\t}\r\n\trunStepByName := make(map[string]*StepRun)\r\n\tfor _, sr := range run.Steps {\r\n\t\trunStepByName[sr.Name] = sr\r\n\t}\r\n\r\n\tvariables := make(map[string]string)\r\n"]
[6203.966954, "o", "\tif run.Variables != nil {\r\n\t\tfor k, v := range run.Variables {\r\n"]
