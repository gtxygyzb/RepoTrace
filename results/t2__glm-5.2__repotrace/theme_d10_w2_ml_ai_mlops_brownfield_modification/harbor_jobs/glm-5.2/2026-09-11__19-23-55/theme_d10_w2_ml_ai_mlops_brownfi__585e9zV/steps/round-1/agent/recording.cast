[1076.807617, "o", "\\t\\t\\tsr.Status = \"succeeded\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1076.807671, "o", "> "]
[1076.807725, "o", "\\t\\t\\tsr.Error = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
