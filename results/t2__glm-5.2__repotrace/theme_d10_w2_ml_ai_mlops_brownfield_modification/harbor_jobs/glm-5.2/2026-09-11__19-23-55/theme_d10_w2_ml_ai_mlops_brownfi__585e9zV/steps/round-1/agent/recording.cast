[6204.518277, "o", "\tsr.Status = \"failed\"\r\n}\r\nfunc getRunStep(run *PipelineRun, name string) *StepRun {\r\n\tfor _, sr := range run.Steps {\r\n\t\tif sr.Name == name {\r\n\t\t\treturn sr\r\n\t\t}\r\n\t}\r\n"]
[6204.518402, "o", "\treturn nil\r\n}\r\n\r\nfunc stepRunOutputValue(sr *StepRun) string {\r\n\tif sr == nil || sr.Status != \"succeeded\" {\r\n\t\treturn \"\"\r\n\t}\r\n"]
[6204.51848, "o", "\treturn strings.TrimSpace(sr.Stdout)\r\n}\r\n\r\nfunc stepRunDurationValue(sr *StepRun) string {\r\n\tif sr == nil || sr.StartTime == nil || sr.EndTime == nil {\r\n\t\treturn \"0.00\"\r\n\t}\r\n\treturn fmt.Sprintf(\"%.2f\", sr.EndTime.Sub(*sr.StartTime).Seconds())\r\n}\r\n\r\nfunc getStepConfig(cfg *PipelineConfig, name string) *PipelineStep {\r\n\tfor _, step := range cfg.Steps {\r\n\t\tif step.Name == name {\r\n\t\t\treturn step\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc createTrainExperiment(tracker *Tracker, step *PipelineStep, existingID string) (*Experiment, error) {\r\n\texpName := step.Name\r\n\tvar params map[string]string\r\n\tvar tags []string\r\n\tif step.ExperimentConfig != nil {\r\n\t\tif step.ExperimentConfig.Name != \"\" {\r\n\t\t\texpName = step.ExperimentConfig.Name\r\n\t\t}\r\n\t\tparams = step.ExperimentConfig.Params\r\n\t}\r\n"]
[6204.518593, "o", "\tif existingID != \"\" {\r\n\t\tif exp, err := tracker.store.GetExperiment(existingID); err == nil {\r\n\t\t\treturn exp, nil\r\n\t\t}\r\n\t}\r\n\treturn tracker.Create(expName, params, tags)\r\n}\r\n\r\nfunc finishTrainExperiment(tracker *Tracker, exp *Experiment, step *PipelineStep, output string) error {\r\n\tfor _, line := range strings.Split(output, \"\\n\") {\r\n\t\tkey, value, ok := parseMetricLine(line)\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif len(step.ExperimentConfig.Metrics) > 0 && !containsString(step.ExperimentConfig.Metrics, key) {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif err := tracker.LogMetric(exp.ID, key, value); err != nil {\r\n\t\t\treturn err\r\n"]
[6204.518623, "o", "\t\t}\r\n\t}\r\n\treturn tracker.Complete(exp.ID, ExperimentStatusCompleted)\r\n}\r\n\r\n"]
[6204.518773, "o", "func parseMetricLine(line string) (string, float64, bool) {\r\n\tparts := strings.SplitN(line, \"=\", 2)\r\n\tif len(parts) != 2 {\r\n\t\treturn \"\", 0, false\r\n\t}\r\n"]
[6204.51885, "o", "\tkey := strings.TrimSpace(parts[0])\r\n\tval := strings.TrimSpace(parts[1])\r\n\tif key == \"\" {\r\n\t\treturn \"\", 0, false\r\n\t}\r\n\tvalue, err := strconv.ParseFloat(val, 64)\r\n\tif err != nil {\r\n\t\treturn \"\", 0, false\r\n\t}\r\n\treturn key, value, true\r\n}\r\n\r\nfunc runShellCommand(command string, timeoutSeconds int, env []string) (string, string, int, error) {\r\n\tcmd := exec.Command(\"sh\", \"-c\", command)\r\n\tif env != nil {\r\n\t\tcmd.Env = env\r\n\t}\r\n\tvar stdout strings.Builder\r\n\tvar stderr strings.Builder\r\n\tcmd.Stdout = &stdout\r\n\tcmd.Stderr = &stderr\r\n\r\n\tif timeoutSeconds > 0 {\r\n\t\ttimer := time.AfterFunc(time.Duration(timeoutSeconds)*time.Second, func() {\r\n\t\t\tif cmd.Process != nil {\r\n\t\t\t\tcmd.Process.Kill()\r\n\t\t\t}\r\n\t\t})\r\n\t\tdefer timer.Stop()\r\n\t}\r\n\r\n"]
[6204.51892, "o", "\terr := cmd.Run()\r\n\texitCode := 0\r\n\tif err != nil {\r\n\t\tif exitErr, ok := err.(*exec.ExitError); ok {\r\n\t\t\texitCode = exitErr.ExitCode()\r\n\t\t} else {\r\n\t\t\texitCode = 1\r\n\t\t}\r\n\t\treturn stdout.String(), stderr.String(), exitCode, fmt.Errorf(\"command failed: %s\", err.Error())\r\n\t}\r\n"]
[6204.518996, "o", "\treturn stdout.String(), stderr.String(), exitCode, nil\r\n}\r\n\r\nfunc produceArtifacts(run *PipelineRun, step *PipelineStep, sr *StepRun, content string) {\r\n\tstepArtDir := filepath.Join(run.RunDir, \"artifacts\", step.Name)\r\n\tos.MkdirAll(stepArtDir, 0755)\r\n\tfor _, name := range step.Outputs {\r\n"]
[6204.519083, "o", "\t\tpath := filepath.Join(stepArtDir, name)\r\n\t\tif err := os.WriteFile(path, []byte(content), 0644); err != nil {\r\n\t\t\tsr.Error = appendError(sr.Error, fmt.Sprintf(\"write artifact %s: %v\", name, err))\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tinfo, _ := os.Stat(path)\r\n\t\tvar size int64\r\n\t\tif info != nil {\r\n\t\t\tsize = info.Size()\r\n\t\t}\r\n\t\tartType := \"data\"\r\n\t\tif step.Type == \"train\" {\r\n\t\t\tartType = \"model\"\r\n\t\t} else if step.Type == \"evaluate\" {\r\n\t\t\tartType = \"metrics\"\r\n\t\t}\r\n\t\tartifact := Artifact{Name: name, Type: artType, Producer: step.Name, Path: path, Size: size}\r\n"]
[6204.519162, "o", "\t\tsr.Artifacts = appendArtifact(sr.Artifacts, artifact)\r\n\t\trun.Artifacts = appendArtifact(run.Artifacts, artifact)\r\n\t}\r\n}\r\n\r\nfunc registerEvaluateArtifacts(run *PipelineRun, step *PipelineStep, sr *StepRun) {\r\n\tfor i, art := range sr.Artifacts {\r\n\t\tif art.Producer == step.Name && (art.Type == \"data\" || art.Type == \"\") {\r\n\t\t\tsr.Artifacts[i].Type = \"metrics\"\r\n\t\t}\r\n\t}\r\n\tfor i, art := range run.Artifacts {\r\n\t\tif art.Producer == step.Name && (art.Type == \"data\" || art.Type == \"\") {\r\n\t"]
[6204.519235, "o", "\t\trun.Artifacts[i].Type = \"metrics\"\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc appendArtifact(arts []Artifact, art Artifact) []Artifact {\r\n\tfor i, a := range arts {\r\n\t\tif a.Name == art.Name && a.Producer == art.Producer {\r\n\t\t\tarts[i] = art\r\n\t\t\treturn arts\r\n"]
