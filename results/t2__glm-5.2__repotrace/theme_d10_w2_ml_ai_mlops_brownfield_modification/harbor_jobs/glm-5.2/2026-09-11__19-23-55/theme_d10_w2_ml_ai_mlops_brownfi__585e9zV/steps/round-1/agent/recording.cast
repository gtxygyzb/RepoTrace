[1414.506132, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n"]
[1414.506233, "o", "\t\"time\"\r\n)\r\n\r\n// ModelStatus represents the lifecycle stage of a model\r\ntype ModelStatus string\r\n\r\nconst (\r\n\tModelStatusRegistered ModelStatus = \"registered\"\r\n"]
[1414.506322, "o", "\tModelStatusStaging    ModelStatus = \"staging\"\r\n\tModelStatusProduction ModelStatus = \"production\"\r\n\tModelStatusArchived   ModelStatus = \"archived\"\r\n)\r\n\r\n// Model represents an ML model in the registry\r\ntype Model struct {\r\n\tName        string             `json:\"name\"`\r\n\tVersion     string             `json:\"version\"`\r\n\tFramework   string             `json:\"framework\"`\r\n\tDescription string             `json:\"description,omitempty\"`\r\n\tTags        []string           `json:\"tags,omitempty\"`\r\n\tStatus      ModelStatus        `json:\"status\"`\r\n\tMetrics     map[string]float64 `json:\"metrics,omitempty\"`\r\n\tCreatedAt   time.Time          `json:\"created_at\"`\r\n\tUpdatedAt   time.Time          `json:\"updated_at\"`\r\n\tParentRef   string             `json:\"parent_ref,omitempty\"`\r\n}\r\n"]
[1414.506399, "o", "\r\nfunc (m *Model) Key() string {\r\n\treturn fmt.Sprintf(\"%s:%s\", m.Name, m.Version)\r\n}\r\n\r\n// ValidTransitions defines valid model lifecycle transitions\r\nvar ValidTransitions = map[ModelStatus][]ModelStatus{\r\n\tModelStatusRegistered: {ModelStatusStaging, ModelStatusArchived},\r\n\tModelStatusStaging:    {ModelStatusProduction, ModelStatusRegistered, ModelStatusArchived},\r\n\tModelStatusProduction: {ModelStatusStaging, ModelStatusArchived},\r\n\tModelStatusArchived:   {ModelStatusRegistered},\r\n}\r\n\r\nfunc (m *Model) CanTransitionTo(target ModelStatus) bool {\r\n\tallowed, ok := ValidTransitions[m.Status]\r\n\t"]
[1414.506519, "o", "if !ok {\r\n\t\treturn false\r\n\t}\r\n\tfor _, s := range allowed {\r\n\t\tif s == target {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\n// ExperimentStatus represents the state of an experiment run\r\ntype ExperimentStatus string\r\n\r\nconst (\r\n\tExperimentStatusRunning   ExperimentStatus = \"running\"\r\n\tExperimentStatusCompleted ExperimentStatus = \"completed\"\r\n\tExperimentStatusFailed    ExperimentStatus = \"failed\"\r\n)\r\n\r\n// Experiment represents an ML experiment run\r\ntype Experiment struct {\r\n\tID         string             `json:\"id\"`\r\n\tName       string             `json:\"name\"`\r\n\tStatus     ExperimentStatus   `json:\"status\"`\r\n\tParameters map[string]string  `json:\"parameters,omitempty\"`\r\n"]
[1414.506586, "o", "\tMetrics    map[string]float64 `json:\"metrics,omitempty\"`\r\n\tTags       []string           `json:\"tags,omitempty\"`\r\n\tModelRef   string             `json:\"model_ref,omitempty\"`\r\n\tDatasetRef string             `json:\"dataset_ref,omitempty\"`\r\n\tStartTime  time.Time          `json:\"start_time\"`\r\n\tEndTime    time.Time          `json:\"end_time,omitempty\"`\r\n\tNotes      string             `json:\"notes,omitempty\"`\r\n}\r\n\r\n// Dataset represents a dataset version\r\ntype Dataset struct {\r\n"]
[1414.50665, "o", "\tName      string    `json:\"name\"`\r\n\tVersion   string    `json:\"version\"`\r\n\tFormat    string    `json:\"format\"`\r\n\tPath      string    `json:\"path\"`\r\n\tRowCount  int64     `json:\"row_count\"`\r\n\tSchema    []Column  `json:\"schema,omitempty\"`\r\n\tCreatedAt time.Time `json:\"created_at\"`\r\n\tChecksum  string    `json:\"checksum,omitempty\"`\r\n}\r\n\r\nfunc (d *Dataset) Key() string {\r\n\treturn fmt.Sprintf(\"%s:%s\", d.Name, d.Version)\r\n}\r\n"]
[1414.506711, "o", "\r\n// Column represents a dataset column\r\ntype Column struct {\r\n\tName     string `json:\"name\"`\r\n\tType     string `json:\"type\"`\r\n\tNullable bool   `json:\"nullable\"`\r\n}\r\n\r\n// StoreData holds all persisted data\r\ntype StoreData struct {\r\n\tModels      map[string]*Model      `json:\"models\"`\r\n\tExperiments map[string]*Experiment `json:\"experiments\"`\r\n\tDatasets    map[string]*Dataset    `json:\"datasets\"`\r\n"]
[1414.506778, "o", "\tTagIndex    map[string][]string    `json:\"tag_index\"`\r\n}\r\n"]
[1414.507217, "o", "\u001b[?2004h"]
[1414.507279, "o", "root@n30009:/app# "]
[1414.785747, "i", "sed -n '1,260p' pipeline.go\n"]
[1414.786005, "o", "sed -n '1,260p' pipeline.go\r\n\u001b[?2004l\r"]
[1414.788926, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n"]
[1414.78902, "o", "\t\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n"]
[1414.789114, "o", "\r\nconst pipelineRunsDir = \"/tmp/nexus/runs\"\r\n\r\ntype PipelineResourceLimit struct {\r\n\tCPU      int `json:\"cpu,omitempty\"`\r\n\tMemoryMB int `json:\"memory_mb,omitempty\"`\r\n}\r\n\r\ntype PipelineStepResources struct {\r\n\tCPU      int `json:\"cpu,omitempty\"`\r\n\tMemoryMB int `json:\"memory_mb,omitempty\"`\r\n}\r\n\r\ntype PipelineStepRetry struct {\r\n"]
[1414.789186, "o", "\tMaxRetries         int `json:\"max_retries,omitempty\"`\r\n\tBackoffBaseSeconds int `json:\"backoff_base_seconds,omitempty\"`\r\n}\r\n\r\ntype PipelineExperimentConfig struct {\r\n\tName    string            `json:\"name,omitempty\"`\r\n\tParams  map[string]string `json:\"params,omitempty\"`\r\n\tMetrics []string          `json:\"metrics,omitempty\"`\r\n}\r\n\r\ntype PipelineStep struct {\r\n"]
[1414.789256, "o", "\tName             string                    `json:\"name\"`\r\n\tType             string                    `json:\"type\"`\r\n\tCommand          string                    `json:\"command\"`\r\n\tDependsOn        []string                  `json:\"depends_on,omitempty\"`\r\n\tInputs           []string                  `json:\"inputs,omitempty\"`\r\n\tOutputs          []string                  `json:\"outputs,omitempty\"`\r\n\tResources        *PipelineStepResources    `json:\"resources,omitempty\"`\r\n\tTimeoutSeconds   int                       `json:\"timeout_seconds,omitempty\"`\r\n\tRetry            *PipelineStepRetry        `json:\"retry,omitempty\"`\r\n\tCondition        string                    `json:\"condition,omitempty\"`\r\n\tExperimentConfig *PipelineExperimentConfig `json:\"experiment_config,omitempty\"`\r\n\tDatasetRef       string                    `json:\"dataset_ref,omitempty\"`\r\n}\r\n"]
[1414.789331, "o", "\r\ntype PipelineConfig struct {\r\n\tName          string                 `json:\"name\"`\r\n\tParameters    map[string]string      `json:\"parameters,omitempty\"`\r\n\tMaxParallel   int                    `json:\"max_parallel,omitempty\"`\r\n\tResourceLimit *PipelineResourceLimit `json:\"resource_limit,omitempty\"`\r\n\tSteps         []*PipelineStep        `json:\"steps\"`\r\n}\r\n\r\ntype Artifact struct {\r\n\tName     string `json:\"name\"`\r\n\tType     string `json:\"type\"`\r\n\tProducer string `json:\"producer\"`\r\n\tPath     string `json:\"path\"`\r\n"]
[1414.789394, "o", "\tSize     int64  `json:\"size\"`\r\n}\r\n\r\ntype StepRun struct {\r\n\tName         string     `json:\"name\"`\r\n\tType         string     `json:\"type\"`\r\n\tStatus       string     `json:\"status\"`\r\n\t"]
[1414.789456, "o", "StartTime    *time.Time `json:\"start_time,omitempty\"`\r\n\tEndTime      *time.Time `json:\"end_time,omitempty\"`\r\n\tExitCode     int        `json:\"exit_code,omitempty\"`\r\n\tOutput       string     `json:\"output,omitempty\"`\r\n\tError        string     `json:\"error,omitempty\"`\r\n\tArtifacts    []Artifact `json:\"artifacts,omitempty\"`\r\n\tExperimentID string     `json:\"experiment_id,omitempty\"`\r\n\tRetryCount   int        `json:\"retry_count\"`\r\n}\r\n"]
[1414.78952, "o", "\r\ntype PipelineRun struct {\r\n\tID         string            `json:\"id\"`\r\n\tPipeline   string            `json:\"pipeline\"`\r\n\tStatus     string            `json:\"status\"`\r\n\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n\tStartTime  *time.Time        `json:\"start_time,omitempty\"`\r\n\tEndTime    *time.Time        `json:\"end_time,omitempty\"`\r\n\tSteps      []*StepRun        `json:\"steps\"`\r\n\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n\tRunDir     string            `json:\"run_dir,omitempty\"`\r\n}\r\n\r\ntype Checkpoint struct {\r\n"]
[1414.789585, "o", "\tRunID      string            `json:\"run_id\"`\r\n\tStatus     string            `json:\"status\"`\r\n\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n\tSteps      []*StepRun        `json:\"steps\"`\r\n\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n}\r\n\r\n"]
[1414.789696, "o", "func loadPipelineConfig(path string) (*PipelineConfig, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"read pipeline config: %w\", err)\r\n\t}\r\n\tvar cfg PipelineConfig\r\n\tif err := json.Unmarshal(data, &cfg); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"parse pipeline config: %w\", err)\r\n\t}\r\n\tif cfg.MaxParallel <= 0 {\r\n\t\tcfg.MaxParallel = 4\r\n\t}\r\n\treturn &cfg, nil\r\n}\r\n\r\nfunc validatePipelineConfig(cfg *PipelineConfig) error {\r\n\tif cfg.Name == \"\" {\r\n"]
[1414.789721, "o", "\t\treturn fmt.Errorf(\"pipeline name is required\")\r\n\t}\r\n\tif len(cfg.Steps) == 0 {\r\n\t\treturn fmt.Errorf(\"pipeline must have at least one step\")\r\n\t}\r\n\r\n\tnames := make(map[string]bool)\r\n\t"]
[1414.789805, "o", "for _, step := range cfg.Steps {\r\n\t\tif step.Name == \"\" {\r\n\t\t\treturn fmt.Errorf(\"step name is required\")\r\n\t\t}\r\n\t\tif names[step.Name] {\r\n"]
[1414.789875, "o", "\t\t\treturn fmt.Errorf(\"duplicate step name: %s\", step.Name)\r\n\t\t}\r\n\t\tnames[step.Name] = true\r\n\t\tswitch step.Type {\r\n\t\tcase \"shell\", \"train\", \"evaluate\":\r\n\t\tdefault:\r\n\t\t\treturn fmt.Errorf(\"step %s has invalid type: %s\", step.Name, step.Type)\r\n\t\t}\r\n\t\tif step.Command == \"\" {\r\n\t\t\treturn fmt.Errorf(\"step %s command is required\", step.Name)\r\n\t\t}\r\n\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n\t\t\tif step.Resources.CPU > cfg.ResourceLimit.CPU {\r\n\t\t\t\treturn fmt.Errorf(\"step %s cpu requirement %d exceeds pipeline limit %d\", step.Name, step.Resources.CPU, cfg.ResourceLimit.CPU)\r\n\t\t\t}\r\n\t\t"]
[1414.789941, "o", "\tif step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n\t\t\t\treturn fmt.Errorf(\"step %s memory requirement %d MB exceeds pipeline limit %d MB\", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)\r\n\t\t\t}\r\n\t\t}\r\n\t\tif step.Type == \"train\" && step.ExperimentConfig == nil {\r\n\t\t\treturn fmt.Errorf(\"train step %s requires experiment_config\", step.Name)\r\n\t\t}\r\n"]
[1414.790005, "o", "\t}\r\n\r\n\tfor _, step := range cfg.Steps {\r\n\t\tfor _, dep := range step.DependsOn {\r\n\t\t\tif !names[dep] {\r\n\t\t\t\treturn fmt.Errorf(\"step %s depends on unknown step %s\", step.Name, dep)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif cycle := findCycle(cfg.Steps); cycle != nil {"]
[1414.790092, "o", "\r\n\t\treturn fmt.Errorf(\"cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n\t}\r\n\r\n\tproducers := make(map[string]string)\r\n\tfor _, step := range cfg.Steps {\r\n\t\tfor _, out := range step.Outputs {\r\n\t\t\tif _, ok := producers[out]; ok {\r\n\t\t\t\treturn fmt.Errorf(\"duplicate output artifact: %s\", out)\r\n\t\t\t}\r\n"]
[1414.790209, "o", "\t\t\tproducers[out] = step.Name\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, step := range cfg.Steps {\r\n\t\tfor _, in := range step.Inputs {\r\n\t\t\tprod, ok := producers[in]\r\n\t\t\tif !ok {\r\n\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s is not produced by any step\", step.Name, in)\r\n\t\t\t}\r\n\t\t\tif prod == step.Name {\r\n\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s must come from a dependency\", step.Name, in)\r\n\t\t\t}\r\n\t\t\tif !isTransitiveDependency(cfg.Steps, step.Name, prod) {\r\n\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s producer %s is not a transitive dependency\", step.Name, in, prod)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[1414.790342, "o", "\treturn nil\r\n}\r\n\r\nfunc findCycle(steps []*PipelineStep) []string {\r\n\tgraph := make(map[string][]string)\r\n\tfor _, s := range steps {\r\n\t\tgraph[s.Name] = append(graph[s.Name], s.DependsOn...)\r\n\t}\r\n\tvisited := make(map[string]int)\r\n\tvar stack []string\r\n\tvar dfs func(node string) []string\r\n\tdfs = func(node string) []string {\r\n\t\tvisited[node] = 1\r\n\t\tstack = append(stack, node)\r\n\t\tfor _, dep := range graph[node] {\r\n\t\t\tif visited[dep] == 1 {\r\n\t\t\t\tfor i, n := range stack {\r\n\t\t\t\t\tif n == dep {\r\n\t\t\t\t\t\treturn append(append([]string{}, stack[i:]...), dep)\r\n\t\t\t\t\t}\r\n"]
[1414.790412, "o", "\t\t\t\t}\r\n\t\t\t\treturn []string{node, dep}\r\n\t\t\t}\r\n\t\t\tif visited[dep] == 0 {\r\n\t\t\t\tif c := dfs(dep); c != nil {\r\n\t\t\t\t\treturn c\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t"]
[1414.790474, "o", "\tstack = stack[:len(stack)-1]\r\n\t\tvisited[node] = 2\r\n\t\treturn nil\r\n\t}\r\n\tfor _, s := range steps {\r\n\t\tif visited[s.Name] == 0 {\r\n\t\t\tif c := dfs(s.Name); c != nil {\r\n\t\t\t\treturn c\r\n\t\t\t}\r\n\t"]
[1414.790529, "o", "\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc isTransitiveDependency(steps []*PipelineStep, step, target string) bool {\r\n\tbyName := make(map[string]*PipelineStep)\r\n\tfor _, s := range steps {\r\n\t\tbyName[s.Name] = s\r\n"]
[1414.790591, "o", "\t}\r\n\tvar visit func(current string) bool\r\n\tvisit = func(current string) bool {\r\n\t\ts := byName[current]\r\n\t\tfor _, dep := range s.DependsOn {\r\n\t\t\tif dep == target {\r\n\t\t\t\treturn true\r\n\t\t\t}\r\n\t\t\tif visit(dep) {\r\n\t\t\t\treturn true\r\n"]
[1414.790645, "o", "\t\t\t}\r\n\t\t}\r\n\t\treturn false\r\n\t}\r\n\treturn visit(step)\r\n}\r\n\r\nfunc runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {\r\n\tif err := validatePipelineConfig(cfg); err != nil {\r\n"]
