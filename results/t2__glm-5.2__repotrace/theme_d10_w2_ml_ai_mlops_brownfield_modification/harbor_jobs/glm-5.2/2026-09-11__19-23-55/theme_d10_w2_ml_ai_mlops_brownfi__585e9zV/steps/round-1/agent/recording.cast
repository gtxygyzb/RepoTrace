[43.273372, "o", "\t\t\tprintUsage()\r\n    40\t\t\tos.Exit(1)\r\n    41\t\t}\r\n    42\t}\r\n    43\t\r\n    44\tfunc printUsage() {\r\n    45\t\tfmt.Println(\"nexus - ML Model & Experiment Management\")\r\n    46\t\tfmt.Println()\r\n    47\t\tfmt.Println(\"Commands:\")\r\n"]
[43.273448, "o", "    48\t\tfmt.Println(\"  model register <name> [--version V] [--framework F] [--description D] [--tags t1,t2]\")\r\n    49\t\tfmt.Println(\"  model list [--filter F]\")\r\n    50\t\tfmt.Println(\"  model get <name> <version>\")\r\n    51\t\tfmt.Println(\"  model promote <name> <version> <status>\")\r\n    52\t\tfmt.Println(\"  model delete <name> <version>\")\r\n    53\t\tfmt.Println(\"  model compare <name>\")\r\n    54\t\tfmt.Println(\"  experiment create <name> [--params k1=v1,k2=v2] [--tags t1,t2]\")\r\n    55\t\t"]
[43.273518, "o", "fmt.Println(\"  experiment list [--filter F]\")\r\n    56\t\tfmt.Println(\"  experiment get <id>\")\r\n    57\t\tfmt.Println(\"  experiment log-metric <id> <key> <value>\")\r\n    58\t\tfmt.Println(\"  experiment complete <id> [--status completed|failed]\")\r\n    59\t\tfmt.Println(\"  experiment compare <id1,id2,...>\")\r\n    60\t\tfmt.Println(\"  experiment export <output-path> [--format json|csv]\")\r\n    61\t\tfmt.Println(\"  dataset register <name> <version> <format> <path> [--rows N]\")\r\n    62\t\tfmt.Println(\"  dataset list\")\r\n    63\t"]
[43.273595, "o", "\tfmt.Println(\"  dataset get <name> <version>\")\r\n    64\t\tfmt.Println(\"  search --tag <tag>\")\r\n    65\t}\r\n    66\t\r\n    67\tfunc handleModel(reg *Registry, args []string) {\r\n    68\t\tif len(args) < 1 {\r\n    69\t\t\tfmt.Fprintln(os.Stderr, \"model subcommand required\")\r\n    70\t\t\tos.Exit(1)\r\n    71\t\t}\r\n    72\t\r\n    73\t\tswitch args[0] {\r\n    74\t"]
[43.273673, "o", "\tcase \"register\":\r\n    75\t\t\tif len(args) < 2 {\r\n    76\t\t\t\tfmt.Fprintln(os.Stderr, \"model name required\")\r\n    77\t\t\t\tos.Exit(1)\r\n    78\t\t\t}\r\n    79\t\t\tname := args[1]\r\n    80\t\t\tversion := getFlag(args, \"--version\", \"\")\r\n    81\t\t\tframework := getFlag(args, \"--framework\", \"unknown\")\r\n    82\t\t\tdescription := getFlag(args, \"--description\", \"\")\r\n    83\t\t\ttagsStr := getFlag(args, \"--tags\", \"\")\r\n"]
[43.27375, "o", "    84\t\t\tvar tags []string\r\n    85\t\t\tif tagsStr != \"\" {\r\n    86\t\t\t\ttags = strings.Split(tagsStr, \",\")\r\n    87\t\t\t}\r\n"]
[43.273823, "o", "    88\t\r\n    89\t\t\tm, err := reg.Register(name, version, framework, description, tags)\r\n    90\t\t\tif err != nil {\r\n    91\t\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n    92\t\t\t\tos.Exit(1)\r\n    93\t\t\t}\r\n    94\t\t\tprintJSON(m)\r\n    95\t\r\n    96\t\tcase \"list\":\r\n    97\t\t\tfilter := getFlag(args, \"--filter\", \"\")\r\n"]
[43.273952, "o", "    98\t\t\tmodels := reg.store.ListModels(filter)\r\n    99\t\t\tprintJSON(models)\r\n   100\t\r\n   101\t\tcase \"get\":\r\n   102\t\t\tif len(args) < 3 {\r\n   103\t\t\t\tfmt.Fprintln(os.Stderr, \"model name and version required\")\r\n   104\t\t\t\tos.Exit(1)\r\n   105\t\t\t}\r\n   106\t\t\tm, err := reg.store.GetModel(args[1], args[2])\r\n   107\t\t\tif err != nil {\r\n   108\t\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n   109\t\t\t\tos.Exit(1)\r\n   110\t\t\t}\r\n   111\t\t\tprintJSON(m)\r\n   112\t\r\n   113\t\tcase \"promote\":\r\n   114\t\t\tif len(args) < 4 {\r\n   115\t\t\t\tfmt.Fprintln(os.Stderr, \"model name, version, and target status required\")\r\n   116\t\t\t\tos.Exit(1)\r\n   117\t\t\t}\r\n   118\t\t\terr := reg.Promote(args[1], args[2], ModelStatus(args[3]))\r\n"]
