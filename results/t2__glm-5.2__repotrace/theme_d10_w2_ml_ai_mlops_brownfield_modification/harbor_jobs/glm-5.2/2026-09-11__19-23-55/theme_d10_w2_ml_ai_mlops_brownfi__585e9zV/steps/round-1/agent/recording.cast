[5837.735067, "o", "func runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {\r\n\tif err := validatePipelineConfig(cfg); err != nil {\r\n\t\treturn nil, err\r\n"]
[5837.735153, "o", "\t}\r\n\tmerged := mergeParams(cfg.Parameters, params)\r\n\tif maxParallel <= 0 {\r\n\t\tmaxParallel = cfg.MaxParallel\r\n\t}\r\n\tif maxParallel <= 0 {\r\n\t\tmaxParallel = 4\r\n\t}\r\n\r\n\trunID := generateRunID()\r\n\trunDir := filepath.Join(pipelineRunsDir, runID)\r\n\tartifactsDir := filepath.Join(runDir, \"artifacts\")\r\n\tif err := os.MkdirAll(artifactsDir, 0755); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"create run dir: %w\", err)\r\n\t}\r\n\t"]
[5837.735231, "o", "if cfgData, err := json.MarshalIndent(cfg, \"\", \"  \"); err == nil {\r\n\t\tos.WriteFile(filepath.Join(runDir, \"pipeline_config.json\"), cfgData, 0644)\r\n\t}\r\n\r\n\tnow := time.Now()\r\n\trun := &PipelineRun{\r\n\t\tID:         runID,\r\n\t\tPipeline:   cfg.Name,\r\n\t\tStatus:     \"running\",\r\n\t\tParameters: merged,\r\n\t\tStartTime:  &now,\r\n\t"]
[5837.735297, "o", "\tRunDir:     runDir,\r\n\t\tVariables:  copyMap(merged),\r\n\t\tWarnings:   []string{},\r\n\t\tSteps:      make([]*StepRun, 0, len(cfg.Steps)),\r\n\t}\r\n\tfor _, step := range cfg.Steps {\r\n\t\trun.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: \"pending\"})\r\n\t}\r\n\tsaveRun(run)\r\n\r\n\terr := executeSteps(cfg, run, tracker, merged, maxParallel)\r\n"]
[5837.73536, "o", "\tendTime := time.Now()\r\n\trun.EndTime = &endTime\r\n\tif err != nil {\r\n\t\trun.Status = \"failed\"\r\n\t} else if run.Status != \"succeeded_with_warnings\" {\r\n\t\trun.Status = \"succeeded\"\r\n\t}\r\n\tsaveRun(run)\r\n\treturn run, err\r\n}\r\n"]
