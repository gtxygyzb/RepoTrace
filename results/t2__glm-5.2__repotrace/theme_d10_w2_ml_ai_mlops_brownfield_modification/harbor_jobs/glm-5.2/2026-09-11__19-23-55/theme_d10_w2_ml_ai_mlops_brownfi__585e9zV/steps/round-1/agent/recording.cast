[1451.868116, "o", "   405\t\tcase \"status\":\r\n   406\t\t\tif len(args) < 2 {\r\n   407\t\t\t\tfmt.Fprintln(os.Stderr, \"run-id required\")\r\n   408\t\t\t\tos.Exit(1)\r\n   409\t\t\t}\r\n   410\t\t\trun, err := loadRun(args[1])\r\n   411\t\t\tif err != nil {\r\n   412\t\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n   413\t\t\t\tos.Exit(1)\r\n"]
