[716.526304, "o", "for _, dep := range step.DependsOn {\r\ndepStatus := getRunStep(run, dep).Status\r\nif depStatus != \"succeeded\" && depStatus != \"skipped\" {\r\nsr.Status = \"failed\"\r\nsr.Error = \"dependency failed\"\r\nreturn\r\n}\r\n}\r\n\r\nif step.Condition != \"\" {\r\ncond, err := evaluateCondition(step.Condition, params)\r\nif err != nil {\r\n"]
[716.526421, "o", "sr.Status = \"failed\"\r\nsr.Error = err.Error()\r\nreturn\r\n}\r\nif !cond {\r\nsr.Status = \"skipped\"\r\nsr.Output = \"condition false\"\r\nreturn\r\n}\r\n}\r\n\r\nmaxRetries := 0\r\nbackoffBase := 1\r\nif step.Retry != nil {\r\nmaxRetries = step.Retry.MaxRetries\r\nif step.Retry.BackoffBaseSeconds > 0 {\r\nbackoffBase = step.Retry.BackoffBaseSeconds\r\n}\r\n}\r\n\r\ncmdStr := substituteParams(step.Command, params)\r\nfor attempt := 0; attempt <= maxRetries; attempt++ {\r\nstart := time.Now()\r\nsr.StartTime = &start\r\nsr.RetryCount = attempt\r\n"]
