[4031.122622, "o", "\u001b[32m\u001b[K341\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc executeSteps\u001b[m\u001b[K(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kvariables[\"steps.\u001b[m\u001b[K\"+step.Name+\".status\"] = sr.Status\r\n\u001b[32m\u001b[K446\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kvariables[\"steps.\u001b[m\u001b[K\"+s.Name+\".status\"] = status\r\n"]
[4031.122725, "o", "\u001b[32m\u001b[K517\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc executeStep\u001b[m\u001b[K(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {\r\n"]
[4031.122979, "o", "\u001b[32m\u001b[K1051\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc substituteVariables\u001b[m\u001b[K(command string, vars map[string]string) (string, error) {\r\n"]
