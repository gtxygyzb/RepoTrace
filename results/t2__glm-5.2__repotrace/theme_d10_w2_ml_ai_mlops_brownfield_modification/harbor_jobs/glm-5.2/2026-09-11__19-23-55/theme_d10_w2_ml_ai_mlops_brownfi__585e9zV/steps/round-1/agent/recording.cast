[4064.594449, "o", "\u001b[32m\u001b[K630\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tvarMu.Lock()\r\n\u001b[32m\u001b[K631\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tvariables[step.CaptureOutput.Name] = val\r\n\u001b[32m\u001b[K632\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tvarMu.Unlock()\r\n\u001b[32m\u001b[K633\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t}\r\n\u001b[32m\u001b[K634\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K635\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn\r\n\u001b[32m\u001b[K636\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K637\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsr.Error = err.Error()\r\n\u001b[32m\u001b[K638\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif step.Type == \"train\" && exp != nil {\r\n\u001b[32m\u001b[K639\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\ttracker.Complete(exp.ID, ExperimentStatusFailed)\r\n\u001b[32m\u001b[K640\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n"]
[4064.594517, "o", "\u001b[32m\u001b[K641\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif attempt < maxRetries {\r\n\u001b[32m\u001b[K642\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tdelay := time.Duration(math.Pow(float64(backoffBase), float64(attempt+1))) * time.Second\r\n\u001b[32m\u001b[K643\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\ttime.Sleep(delay)\r\n\u001b[32m\u001b[K644\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K645\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
