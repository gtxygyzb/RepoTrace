[5493.789084, "o", "\t\treturn true, nil\r\n\t\t}\r\n\t}\r\n\r\n\treturn false, nil\r\n"]
[5493.789119, "o", "}\r\n\r\nfunc resolveParam(token string, params map[string]string) string {\r\n\tres, _ := substituteVariables(token, params)\r\n\treturn res\r\n}\r\n\r\n"]
