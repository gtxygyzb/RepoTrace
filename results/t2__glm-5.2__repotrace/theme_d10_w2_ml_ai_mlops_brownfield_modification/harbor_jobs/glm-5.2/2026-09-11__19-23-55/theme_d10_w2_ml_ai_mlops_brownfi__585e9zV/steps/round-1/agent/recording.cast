[7054.476365, "o", "\r\n\tswitch os.Args[1] {\r\n\tcase \"model\":\r\n\t\thandleModel(registry, os.Args[2:])\r\n\tcase \"experiment\":\r\n\t\thandleExperiment(tracker, os.Args[2:])\r\n\tcase \"pipeline\":\r\n"]
[7054.476383, "o", "\t\thandlePipeline(store, tracker, os.Args[2:])\r\n\tcase \"dataset\":\r\n\t\thandleDataset(store, os.Args[2:])\r\n"]
