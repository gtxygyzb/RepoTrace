[6785.816233, "o", "\t\trun, err := loadRun(args[1])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(run)\r\n\r\n\tcase \"list\":\r\n\t\tprintJSON(listRuns())\r\n\r\n\tcase \"artifacts\":\r\n"]
