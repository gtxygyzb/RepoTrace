[4619.216033, "i", "\nnew = '''func evaluateCondition(cond string, vars map[string]string) (bool, error) {\n\\tcond = strings.TrimSpace(cond)\n\\tif cond == \"\" {\n\\t\\treturn true, nil\n\\t}\n\n\\tunresolved := false\n\n\\tevalPrimitive := func(expr string) (bool, error) {\n\\t\\texpr = strings.TrimSpace(expr)\n\\t\\tif expr == \"\" {\n\\t\\t\\treturn false, fmt.Errorf(\"invalid condition: empty expression\")\n\\t\\t}\n\n\\t\\tsubstitute := func(s string) (string, bool) {\n\\t\\t\\tres, err := substituteVariables(strings.TrimSpace(s), vars)\n\\t\\t\\tif err != nil {\n\\t\\t\\t\\tunresolved = true\n\\t\\t\\t\\treturn \"\", false\n\\t\\t\\t}\n\\t\\t\\treturn res, true\n\\t\\t}\n\n\\t\\tif parts := strings.SplitN(expr, \" contains \", 2); len(parts) == 2 {\n\\t\\t\\tleft, ok := substitute(parts[0])\n\\t\\t\\tif !ok {\n\\t\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\tright, ok := substitute(parts[1])\n\\t\\t\\tif !ok {\n\\t\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\treturn strings.Contains(left, right), nil\n\\t\\t}\n\n\\t\\tif parts := strings.SplitN(expr, \"==\", 2); len(parts) == 2 {\n\\t\\t\\tleft, ok := substitute(parts[0])\n\\t\\t\\tif !ok {\n\\t"]
[4619.216111, "o", "python3 - <<'PY'\r\n"]
[4619.216295, "i", "\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\tright, ok := substitute(parts[1])\n\\t\\t\\tif !ok {\n\\t\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\treturn left == right, nil\n\\t\\t}\n\n\\t\\tif parts := strings.SplitN(expr, \"!=\", 2); len(parts) == 2 {\n\\t\\t\\tleft, ok := substitute(parts[0])\n\\t\\t\\tif !ok {\n\\t\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\tright, ok := substitute(parts[1])\n\\t\\t\\tif !ok {\n\\t\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\treturn left != right, nil\n\\t\\t}\n\n\\t\\treturn false, fmt.Errorf(\"invalid condition: %s\", expr)\n\\t}\n\n\\t// && binds tighter than ||, so split OR first and AND second.\n\\tfor _, orPart := range strings.Split(cond, \"||\") {\n\\t\\tandResult := true\n\\t\\tfor _, andPart := range strings.Split(orPart, \"&&\") {\n\\t\\t\\tres, err := evalPrimitive(andPart)\n\\t\\t\\tif err != nil {\n\\t\\t\\t\\treturn false, err\n\\t\\t\\t}\n\\t\\t\\tif !res {\n\\t\\t\\t\\tandResult = false\n\\t\\t\\t\\tbreak\n\\t\\t\\t}\n\\t\\t}\n\\t\\tif andResult {\n\\t\\t\\tif unresolved {\n\\t\\t\\t\\treturn false, nil\n\\t\\t\\t}\n\\t\\t\\treturn true, nil\n\\t\\t}\n\\t}\n\n\\tif unresolved {\n\\t\\treturn false, nil\n\\t}\n"]
