[4131.981473, "o", "  1128\ttype DryRunStep struct {\r\n  1129\t\tName            string   `json:\"name\"`\r\n  1130\t\tType            string   `json:\"type\"`\r\n  1131\t\tResolvedCommand string   `json:\"resolved_command\"`\r\n  1132\t\tStatus          string   `json:\"status\"`\r\n  1133\t\tDependsOn       []string `json:\"depends_on\"`\r\n  1134\t}\r\n  1135\t\r\n  1136"]
