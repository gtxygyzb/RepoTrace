[3651.187674, "i", "cat > /tmp/nexus_allow_failure_test.json <<'EOF'\n{\n  \"name\": \"allow-failure-test\",\n  \"parameters\": {},\n  \"steps\": [\n    {\n      \"name\": \"metrics\",\n      \"type\": \"shell\",\n      \"command\": \"echo metrics-ok; exit 1\",\n      \"allow_failure\": true,\n      \"capture_output\": \"metrics_status\"\n    },\n    {\n      \"name\": \"downstream\",\n      \"type\": \"shell\",\n      \"command\": \"echo downstream ran after metrics\",\n      \"depends_on\": [\"metrics\"]\n    },\n    {\n      \"name\": \"notify\",\n      \"type\": \"shell\",\n      \"command\": \"echo notifying because metrics failed\",\n      \"depends_on\": [\"metrics\"],\n      \"condition\": \"${steps.metrics.status} == failed\"\n    },\n    {\n      \"name\": \"cleanup\",\n      \"type\": \"shell\",\n      \"command\": \"echo cleanup always runs\",\n      \"condition\": \"${steps.metrics.status} != pending\"\n    }\n  ]\n}\nEOF\n"]
