[6753.489598, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n"]
[6753.48968, "o", "\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nconst dataDir = \"/tmp/nexus\"\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tstore, err := NewStore(dataDir)\r\n\tif err != nil {\r\n\t\t"]
[6753.489747, "o", "fmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tregistry := NewRegistry(store)\r\n\ttracker := NewTracker(store)\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"model\":\r\n\t\thandleModel(registry, os.Args[2:])\r\n\tcase \"experiment\":\r\n\t\thandleExperiment(tracker, os.Args[2:])\r\n\tcase \"pipeline\":\r\n"]
[6753.489821, "o", "\t\thandlePipeline(store, tracker, os.Args[2:])\r\n\tcase \"dataset\":\r\n\t\thandleDataset(store, os.Args[2:])\r\n\tcase \"search\":\r\n\t\thandleSearch(store, os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"Unknown command: %s\\n\", os.Args[1])\r\n\t\tprintUsage()\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[6753.489882, "o", "}\r\n\r\nfunc printUsage() {\r\n\tfmt.Println(\"nexus - ML Model & Experiment Management\")\r\n\tfmt.Println()\r\n\tfmt.Println(\"Commands:\")\r\n\tfmt.Println(\"  model register <name> [--version V] [--framework F] [--description D] [--tags t1,t2]\")\r\n\tfmt.Println(\"  model list [--filter F]\")\r\n\tfmt.Println(\"  model get <name> <version>\")\r\n"]
[6753.489949, "o", "\tfmt.Println(\"  model promote <name> <version> <status>\")\r\n\tfmt.Println(\"  model delete <name> <version>\")\r\n\tfmt.Println(\"  model compare <name>\")\r\n\tfmt.Println(\"  experiment create <name> [--params k1=v1,k2=v2] [--tags t1,t2]\")\r\n\tfmt.Println(\"  experiment list [--filter F]\")\r\n\tfmt.Println(\"  experiment get <id>\")\r\n\tfmt.Println(\"  experiment log-metric <id> <key> <value>\")\r\n\tfmt.Println(\"  experiment complete <id> [--status completed|failed]\")\r\n\tfmt.Println(\"  experiment compare <id1,id2,...>\")\r\n\tfmt.Println(\"  experiment export <output-path> [--format json|csv]\")\r\n\t"]
[6753.490019, "o", "fmt.Println(\"  dataset register <name> <version> <format> <path> [--rows N]\")\r\n\tfmt.Println(\"  dataset list\")\r\n\tfmt.Println(\"  dataset get <name> <version>\")\r\n\tfmt.Println(\"  search --tag <tag>\")\r\n\tfmt.Println(\"  pipeline validate <config.json>\")\r\n\tfmt.Println(\"  pipeline run [--dry-run] <config.json> [--param key=value ...] [--max-parallel N]\")\r\n"]
[6753.490117, "o", "\tfmt.Println(\"  pipeline graph <config.json>\")\r\n\tfmt.Println(\"  pipeline history <pipeline-name> [--status <status>] [--tag <tag>]\")\r\n\tfmt.Println(\"  pipeline status <run-id>\")\r\n\tfmt.Println(\"  pipeline list\")\r\n\tfmt.Println(\"  pipeline artifacts <run-id>\")\r\n\tfmt.Println(\"  pipeline resume <run-id>\")\r\n}\r\n\r\nfunc handleModel(reg *Registry, args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"model subcommand required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch args[0] {\r\n\tcase \"register\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name required\")\r\n\t\t\tos.Exit(1)\r\n\t"]
[6753.490179, "o", "\t}\r\n\t\tname := args[1]\r\n\t\tversion := getFlag(args, \"--version\", \"\")\r\n\t\tframework := getFlag(args, \"--framework\", \"unknown\")\r\n\t\tdescription := getFlag(args, \"--description\", \"\")\r\n\t\ttagsStr := getFlag(args, \"--tags\", \"\")\r\n\t\tvar tags []string\r\n\t\tif tagsStr != \"\" {\r\n\t\t\ttags = strings.Split(tagsStr, \",\")\r\n\t\t}\r\n"]
[6753.490241, "o", "\r\n\t\tm, err := reg.Register(name, version, framework, description, tags)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(m)\r\n\r\n\tcase \"list\":\r\n\t\tfilter := getFlag(args, \"--filter\", \"\")\r\n"]
[6753.490298, "o", "\t\tmodels := reg.store.ListModels(filter)\r\n\t\tprintJSON(models)\r\n\r\n\tcase \"get\":\r\n\t\tif len(args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name and version required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tm, err := reg.store.GetModel(args[1], args[2])\r\n"]
[6753.490354, "o", "\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(m)\r\n\r\n\tcase \"promote\":\r\n\t\tif len(args) < 4 {\r\n\t\t\t"]
[6753.490413, "o", "fmt.Fprintln(os.Stderr, \"model name, version, and target status required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\terr := reg.Promote(args[1], args[2], ModelStatus(args[3]))\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n"]
[6753.490471, "o", "\t\t}\r\n\t\tfmt.Println(\"Model promoted successfully\")\r\n\r\n\tcase \"delete\":\r\n\t\tif len(args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name and version required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tif err := reg.store.DeleteModel(args[1], args[2]); err != nil {\r\n"]
[6753.490528, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(\"Model deleted successfully\")\r\n\r\n\tcase \"compare\":\r\n\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"model name required\")\r\n\t\t\tos.Exit(1)\r\n"]
[6753.490589, "o", "\t\t}\r\n\t\tmodels, err := reg.Compare(args[1])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tprintJSON(models)\r\n\r\n\tdefault:\r\n"]
[6753.490659, "o", "\t\tfmt.Fprintf(os.Stderr, \"Unknown model subcommand: %s\\n\", args[0])\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc handleExperiment(tracker *Tracker, args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"experiment subcommand required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch args[0] {\r\n\tcase \"create\":\r\n\t\tif len(args) < 2 {\r\n"]
[6753.490718, "o", "\t\t\tfmt.Fprintln(os.Stderr, \"experiment name required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tname := args[1]\r\n\t\tparamsStr := getFlag(args, \"--params\", \"\")\r\n\t\ttagsStr := getFlag(args, \"--tags\", \"\")\r\n"]
[6753.4913, "o", "\u001b[?2004h"]
