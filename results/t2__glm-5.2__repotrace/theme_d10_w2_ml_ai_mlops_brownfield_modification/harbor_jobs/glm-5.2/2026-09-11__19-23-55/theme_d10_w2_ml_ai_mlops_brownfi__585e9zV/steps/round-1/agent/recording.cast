[1451.868362, "o", "\tprintJSON(listRuns())\r\n   419\t\r\n   420\t\tcase \"artifacts\":\r\n   421\t\t\tif len(args) < 2 {\r\n   422\t\t\t\tfmt.Fprintln(os.Stderr, \"run-id required\")\r\n   423\t\t\t\tos.Exit(1)\r\n   424\t\t\t}\r\n   425\t\t\trun, err := loadRun(args[1])\r\n   426\t\t\tif err != nil {\r\n   427\t\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n   428\t\t\t\tos.Exit(1)\r\n   429\t\t\t}\r\n   430\t\t\tvar cfg *PipelineConfig\r\n   431\t\t\tif cfgData, err := os.ReadFile(filepath.Join(pipelineRunsDir, args[1], \"pipeline_config.json\")); err == nil {\r\n   432\t\t\t\tvar c PipelineConfig\r\n   433\t\t\t\tif json.Unmarshal(cfgData, &c) == nil {\r\n   434\t\t\t\t\tcfg = &c\r\n   435\t\t\t\t}\r\n   436\t\t\t}\r\n   437\t\t\tprintJSON(buildArtifactManifest(run, cfg))\r\n   438\t\r\n   439\t\tcase \"resume\":\r\n   440\t\t\tif len(args) < 2 {\r\n   441\t\t\t\tfmt.Fprintln(os.Stderr, \"run-id required\")\r\n   442\t\t\t\tos.Exit(1)\r\n   443\t\t\t}\r\n   444\t\t\trun, err := resumePipeline(args[1], tracker)\r\n   445\t\t\tif run != nil {"]
[1451.868438, "o", "\r\n   446\t\t\t\tprintJSON(run)\r\n   447\t\t\t}\r\n   448\t\t\tif err != nil {\r\n   449\t\t\t\tos.Exit(1)\r\n   450\t\t\t}\r\n   451\t\r\n   452\t\tdefault:\r\n   453\t\t\tfmt.Fprintf(os.Stderr, \"Unknown pipeline subcommand: %s\\n\", args[0])\r\n   454\t\t\tos.Exit(1)\r\n   455\t\t}\r\n   456"]
[1451.868504, "o", "\t}\r\n   457\t\r\n   458\tfunc parsePipelineParams(args []string) map[string]string {\r\n   459\t\tparams := make(map[string]string)\r\n   460\t\tfor _, a := range args {\r\n   461\t\t\tif strings.HasPrefix(a, \"--param\") && len(a) > len(\"--param\") {\r\n   462\t\t\t\trest := a[len(\"--param\"):]\r\n   463\t\t\t\tif strings.HasPrefix(rest, \"=\") {\r\n   464\t\t\t\t\trest = rest[1:]\r\n   465\t\t\t\t}\r\n"]
[1451.868562, "o", "   466\t\t\t\tif rest == \"\" {\r\n   467\t\t\t\t\tcontinue\r\n   468\t\t\t\t}\r\n   469\t\t\t\tparts := strings.SplitN(rest, \"=\", 2)\r\n   470\t\t\t\tif len(parts) == 2 {\r\n   471\t\t\t\t\tparams[parts[0]] = parts[1]\r\n   472\t\t\t\t}\r\n   473\t\t\t}\r\n"]
[1451.868618, "o", "   474\t\t}\r\n   475\t\treturn params\r\n   476\t}\r\n"]
