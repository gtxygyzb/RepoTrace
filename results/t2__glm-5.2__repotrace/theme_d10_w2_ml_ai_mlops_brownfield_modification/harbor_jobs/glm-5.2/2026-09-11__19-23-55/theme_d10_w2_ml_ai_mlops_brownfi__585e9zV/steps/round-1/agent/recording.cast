[3110.899192, "o", "   376\t\t\tpending[step.Name] = true\r\n   377\t\t}\r\n   378\t\r\n   379\t\tvar wg sync.WaitGroup\r\n   380\t\tdone := false\r\n   381\t\r\n   382\t\tcanStart := func(step *PipelineStep) bool {\r\n   383\t\t\tfor _, dep := range step.DependsOn {\r\n   384\t\t\t\tstatus := runStepByName[dep].Status\r\n   385\t\t\t\tif status != \"succeeded\" && status != \"skipped\" {\r\n"]
[3110.899263, "o", "   386\t\t\t\t\treturn false\r\n   387\t\t\t\t}\r\n   388\t\t\t}\r\n   389\t\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n   390\t\t\t\tvar cpu, mem int\r\n   391\t\t\t\tfor _, r := range running {\r\n   392"]
[3110.899341, "o", "\t\t\t\t\tif r.Resources != nil {\r\n   393\t\t\t\t\t\tcpu += r.Resources.CPU\r\n   394\t\t\t\t\t\tmem += r.Resources.MemoryMB\r\n   395\t\t\t\t\t}\r\n   396\t\t\t\t}\r\n   397\t\t\t\t"]
[3110.899412, "o", "if cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n   398\t\t\t\t\treturn false\r\n   399\t\t\t\t}\r\n   400\t\t"]
[3110.899485, "o", "\t}\r\n   401\t\t\treturn true\r\n   402\t\t}\r\n   403\t\r\n   404\t\t"]
[3110.899566, "o", "startStep := func(step *PipelineStep) {\r\n   405\t\t\tpending[step.Name] = false\r\n   406\t\t\trunning = append(running, step)\r\n   407\t\t\twg.Add(1)\r\n   408\t\t\tgo func(s *PipelineStep) {\r\n   409\t\t\t\tdefer wg.Done()\r\n   410\t\t\t\texecuteStep(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])\r\n   411\t\t\t\tmu.Lock()\r\n   412\t\t\t\trunning = removeStep(running, s)\r\n   413\t\t\t\tif runStepByName[s.Name].Status == \"failed\" {\r\n   414\t\t\t\t\trun.Status = \"failed\"\r\n"]
[3110.899639, "o", "   415\t\t\t\t\tdone = true\r\n   416\t\t\t\t}\r\n   417\t\t\t\tvarMu.Lock()\r\n   418\t\t\t\trun.Variables = copyMap(variables)\r\n   419\t\t\t\tvarMu.Unlock()\r\n   420\t\t\t\tsaveCheckpoint(run)\r\n   421\t\t\t\tsaveRun(run)\r\n"]
[3110.899709, "o", "   422\t\t\t\tmu.Unlock()\r\n   423\t\t\t\t<-available\r\n   424\t\t\t}(step)\r\n   425\t\t}\r\n   426\t\r\n"]
[3110.899778, "o", "   427\t\tfor !done && (len(pending) > 0 || len(running) > 0) {\r\n   428\t\t\tstartedAny := false\r\n   429\t\t\tvar starts []*PipelineStep\r\n   430\t\t\tmu.Lock()\r\n   431\t\t\tfor _, step := range cfg.Steps {\r\n   432\t\t\t\tif pending[step.Name] && canStart(step) {\r\n   433\t\t\t\t\tstarts = append(starts, step)\r\n   434\t\t\t\t}\r\n   435\t\t\t}"]
[3110.899853, "o", "\r\n   436\t\t\tmu.Unlock()\r\n   437\t\t\tsort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })\r\n   438\t\t\tfor _, step := range starts {\r\n   439\t\t\t\tavailable <- struct{}{}\r\n   440\t\t\t\tmu.Lock()\r\n   441\t\t\t\tif done || !pending[step.Name] || !canStart(step) {\r\n   442\t\t\t\t\tmu.Unlock()\r\n   443\t\t\t\t\t<-available\r\n"]
[3110.899933, "o", "   444\t\t\t\t\tcontinue\r\n   445\t\t\t\t}\r\n   446\t\t\t\tstartStep(step)\r\n   447\t\t\t\tmu.Unlock()\r\n   448\t\t\t\tstartedAny = true\r\n   449\t\t\t}\r\n   450\t\r\n   451\t\t\tif !startedAny {\r\n   452\t\t\t\tif len(running) == 0 {\r\n   453\t\t\t\t\tbreak\r\n   454\t\t\t\t}\r\n   455\t\t\t\ttime.Sleep(10 * time.Millisecond)\r\n   456\t\t\t}\r\n   457"]
[3110.900006, "o", "\t\t}\r\n   458\t\twg.Wait()\r\n   459\t\r\n   460\t\tfor _, sr := range run.Steps {\r\n   461\t\t\tif sr.Status == \"pending\" {\r\n   462\t\t\t\tsr.Status = \"failed\"\r\n   463\t\t\t\tsr.Error = \"dependency failed\"\r\n   464"]
[3110.900093, "o", "\t\t\t}\r\n   465\t\t}\r\n   466\t\tvarMu.Lock()\r\n   467\t\trun.Variables = copyMap(variables)\r\n   468\t\tvarMu.Unlock()\r\n   469\t\tsaveCheckpoint(run)\r\n   470\t\tsaveRun(run)\r\n   471\t\r\n   472\t\tif run.Status == \"failed\" {\r\n   473\t\t\treturn fmt.Errorf(\"pipeline execution failed\")\r\n   474\t\t}\r\n"]
[3110.900168, "o", "   475\t\treturn nil\r\n   476\t}\r\n   477\tfunc removeStep(steps []*PipelineStep, target *PipelineStep) []*PipelineStep {\r\n   478\t\tout := make([]*PipelineStep, 0, len(steps))\r\n   479\t\tfor _, s := range steps {\r\n   480\t\t\tif s != target {\r\n   481\t\t\t\tout = append(out, s)\r\n   482\t\t\t}\r\n   483\t\t}\r\n   484\t\treturn out\r\n   485\t}\r\n   486\t"]
[3110.900245, "o", "\r\n   487\tfunc executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {\r\n   488\t\tfor _, dep := range step.DependsOn {\r\n   489\t\t\tdepStatus := getRunStep(run, dep).Status\r\n   490\t\t\tif depStatus != \"succeeded\" && depStatus != \"skipped\" {\r\n   491\t\t\t\tsr.Status = \"failed\"\r\n"]
[3110.900317, "o", "   492\t\t\t\tsr.Error = \"dependency failed\"\r\n   493\t\t\t\treturn\r\n   494\t\t\t}\r\n   495\t\t}\r\n   496\t\r\n   497\t\tvarMu.Lock()\r\n   498\t\tvars := copyMap(variables)\r\n   499\t\tvarMu.Unlock()\r\n   500\t\r\n   501\t\tif step.Condition != \"\" {\r\n   502\t\t\tcond, err := evaluateCondition(step.Condition, vars)\r\n   503\t\t\tif err != nil {\r\n   504\t\t\t\tsr.Status = \"failed\"\r\n   505\t\t\t\tsr.Error = err.Error()\r\n   506\t\t\t\treturn\r\n"]
[3110.90039, "o", "   507\t\t\t}\r\n   508\t\t\tif !cond {\r\n   509\t\t\t\tsr.Status = \"skipped\"\r\n   510\t\t\t\tsr.Output = \"condition false\"\r\n   511\t\t\t\treturn\r\n   512\t\t\t}\r\n   513\t\t}\r\n   514\t\r\n   515\t\tcmdStr, err := substituteVariables(step.Command, vars)\r\n   516\t\tif err != nil {\r\n"]
[3110.900455, "o", "   517\t\t\tsr.Status = \"failed\"\r\n   518\t\t\tsr.Error = err.Error()\r\n   519\t\t\treturn\r\n   520\t\t}\r\n   521\t\r\n   522\t\tenvVars := os.Environ()\r\n   523\t\tfor k, v := range vars {\r\n   524\t\t\tenvVars = append(envVars, \"NEXUS_PARAM_\"+k+\"=\"+v)\r\n   525\t\t}\r\n"]
[3110.900522, "o", "   526\t\tfor k, v := range step.Env {\r\n   527\t\t\tev, err := substituteVariables(v, vars)\r\n   528\t\t\tif err != nil {\r\n   529\t\t\t\tsr.Status = \"failed\"\r\n   530\t\t\t\tsr.Error = fmt.Sprintf(\"env %s: %v\", k, err)\r\n   531\t\t\t\treturn\r\n   532\t\t\t}\r\n   533\t\t\tenvVars = append(envVars, k+\"=\"+ev)\r\n   534\t\t}\r\n   535\t\r\n   536\t\tmaxRetries := 0\r\n   537\t"]
[3110.900589, "o", "\tbackoffBase := 1\r\n   538\t\tif step.Retry != nil {\r\n   539\t\t\tmaxRetries = step.Retry.MaxRetries\r\n   540\t\t\tif step.Retry.BackoffBaseSeconds > 0 {\r\n   541\t\t\t\tbackoffBase = step.Retry.BackoffBaseSeconds\r\n   542\t\t\t}\r\n   543\t\t}\r\n   544\t\r\n   545\t\tvar exp *Experiment\r\n"]
[3110.900659, "o", "   546\t\tif step.Type == \"train\" {\r\n   547\t\t\tvar err error\r\n   548\t\t\texp, err = createTrainExperiment(tracker, step, sr.ExperimentID)\r\n   549\t\t\tif err != nil {\r\n   550\t\t\t\tsr.Status = \"failed\"\r\n   551\t\t\t\tsr.Error = err.Error()\r\n   552\t\t\t\treturn\r\n   553\t\t\t}\r\n   554\t\t\tsr.ExperimentID = exp.ID\r\n   555\t\t}\r\n   556\t\r\n   557"]
[3110.900724, "o", "\t\tfor attempt := 0; attempt <= maxRetries; attempt++ {\r\n   558\t\t\tstart := time.Now()\r\n   559\t\t\tsr.StartTime = &start\r\n   560\t\t\tsr.RetryCount = attempt\r\n"]
