[6366.465988, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('pipeline.go')\ns = p.read_text()\n\nold = '''type StepRun struct {\n\\tName         string     `json:\"name\"`\n\\tType         string     `json:\"type\"`\n\\tStatus       string     `json:\"status\"`\n\\tStartTime    *time.Time `json:\"start_time,omitempty\"`\n\\tEndTime      *time.Time `json:\"end_time,omitempty\"`\n\\tExitCode     int        `json:\"exit_code,omitempty\"`\n\\tStdout       string     `json:\"stdout,omitempty\"`\n\\tOutput       string     `json:\"output,omitempty\"`\n\\tError        string     `json:\"error,omitempty\"`\n\\tArtifacts    []Artifact `json:\"artifacts,omitempty\"`\n\\tExperimentID string     `json:\"experiment_id,omitempty\"`\n\\tRetryCount   int        `json:\"retry_count\"`\n}\n'''\nnew = '''type RetryHistoryEntry struct {\n\\tAttempt int    `json:\"attempt\"`\n\\tError   string `json:\"error\"`\n}\n\ntype StepRun struct {\n\\tName         string              `json:\"name\"`\n\\tType         string              `json:\"type\"`\n\\tStatus       string              `json:\"status\"`\n\\tStartTime    *ti"]
[6366.466271, "i", "me.Time           `json:\"start_time,omitempty\"`\n\\tEndTime      *time.Time           `json:\"end_time,omitempty\"`\n\\tExitCode     int                 `json:\"exit_code,omitempty\"`\n\\tStdout       string              `json:\"stdout,omitempty\"`\n\\tOutput       string              `json:\"output,omitempty\"`\n\\tError        string              `json:\"error,omitempty\"`\n\\tArtifacts    []Artifact          `json:\"artifacts,omitempty\"`\n\\tExperimentID string              `json:\"experiment_id,omitempty\"`\n\\tRetryCount   int                 `json:\"retry_count\"`\n\\tRetryHistory []RetryHistoryEntry `json:\"retry_history\"`\n}\n'''\nif old not in s:\n    raise SystemExit('StepRun struct not found')\ns = s.replace(old, new)\n\nold = 'run.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: \"pending\"})'\nnew = 'run.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: \"pending\", RetryHistory: []RetryHistoryEntry{}})'\nif old not in s:\n    raise SystemExit('StepRun constructor not found')\ns = s.replace"]
[6366.466365, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
