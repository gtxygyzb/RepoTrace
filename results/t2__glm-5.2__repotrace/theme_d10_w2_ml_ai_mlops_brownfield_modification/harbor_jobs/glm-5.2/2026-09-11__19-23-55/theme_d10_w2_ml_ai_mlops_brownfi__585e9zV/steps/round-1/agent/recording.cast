[4331.137533, "o", "\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tName             string                    `json:\"name\"`\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tType             string                    `json:\"type\"`\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tCommand          string                    `json:\"command\"`\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tDependsOn        []string                  `json:\"depends_on,omitempty\"`\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tInputs           []string                  `json:\"inputs,omitempty\"`\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tOutputs          []string                  `json:\"outputs,omitempty\"`\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tResources        *PipelineStepResources    `json:\"resources,omitempty\"`\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tTimeoutSeconds   int                       `json:\"timeout_seconds,omitempty\"`\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRetry            *PipelineStepRetry        `json:\"retry,omitempty\"`\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tCondition        string                    `json:\"condition,omitempty\"`\r\n"]
[4331.137602, "o", "\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tExperimentConfig *PipelineExperimentConfig `json:\"experiment_config,omitempty\"`\r\n\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tDatasetRef       string                    `json:\"dataset_ref,omitempty\"`\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tCaptureOutput    *CaptureOutputConfig      `json:\"capture_output,omitempty\"`\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tEnv              map[string]string         `json:\"env,omitempty\"`\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tAllowFailure     bool                      `json:\"allow_failure,omitempty\"`\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[4331.137662, "o", "\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype PipelineConfig\u001b[m\u001b[K struct {\r\n"]
[4331.137728, "o", "\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tName          string                 `json:\"name\"`\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tParameters    map[string]string      `json:\"parameters,omitempty\"`\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tMaxParallel   int                    `json:\"max_parallel,omitempty\"`\r\n"]
[4331.137789, "o", "\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tResourceLimit *PipelineResourceLimit `json:\"resource_limit,omitempty\"`\r\n\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tSteps         []*PipelineStep        `json:\"steps\"`\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Ktype Artifact struct {\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tName     string `json:\"name\"`\r\n\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tType     string `json:\"type\"`\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tProducer string `json:\"producer\"`\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tPath     string `json:\"path\"`\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tSize     int64  `json:\"size\"`\r\n"]
[4331.137849, "o", "\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Ktype StepRun struct {\r\n\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tName         string     `json:\"name\"`\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tType         string     `json:\"type\"`\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tStatus       string     `json:\"status\"`\r\n\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tStartTime    *time.Time `json:\"start_time,omitempty\"`\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tEndTime      *time.Time `json:\"end_time,omitempty\"`\r\n"]
[4331.137911, "o", "\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tExitCode     int        `json:\"exit_code,omitempty\"`\r\n\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tStdout       string     `json:\"stdout,omitempty\"`\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tOutput       string     `json:\"output,omitempty\"`\r\n\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tError        string     `json:\"error,omitempty\"`\r\n\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tArtifacts    []Artifact `json:\"artifacts,omitempty\"`\r\n\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tExperimentID string     `json:\"experiment_id,omitempty\"`\r\n\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRetryCount   int        `json:\"retry_count\"`\r\n\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Ktype PipelineRun struct {\r\n\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tID         string            `json:\"id\"`\r\n\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[4331.137978, "o", "\tPipeline   string            `json:\"pipeline\"`\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tStatus     string            `json:\"status\"`\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tStartTime  *time.Time        `json:\"start_time,omitempty\"`\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tEndTime    *time.Time        `json:\"end_time,omitempty\"`\r\n\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tSteps      []*StepRun        `json:\"steps\"`\r\n"]
[4331.138041, "o", "\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRunDir     string            `json:\"run_dir,omitempty\"`\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc validate\u001b[m\u001b[KPipelineConfig(cfg *PipelineConfig) error {\r\n"]
[4331.138295, "o", "\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif cfg.Name == \"\" {\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn fmt.Errorf(\"pipeline name is required\")\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[4331.138356, "o", "\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(cfg.Steps) == 0 {\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn fmt.Errorf(\"pipeline must have at least one step\")\r\n\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tnames := make(map[string]bool)\r\n\u001b[32m\u001b[K162\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, step := range cfg.Steps {\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif step.Name == \"\" {\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn fmt.Errorf(\"step name is required\")\r\n"]
[4331.138423, "o", "\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K166\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif names[step.Name] {\r\n\u001b[32m\u001b[K167\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn fmt.Errorf(\"duplicate step name: %s\", step.Name)\r\n\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n"]
[4331.13853, "o", "\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tnames[step.Name] = true\r\n\u001b[32m\u001b[K170\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tswitch step.Type {\r\n\u001b[32m\u001b[K171\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcase \"shell\", \"train\", \"evaluate\":\r\n\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tdefault:\r\n\u001b[32m\u001b[K173\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn fmt.Errorf(\"step %s has invalid type: %s\", step.Name, step.Type)\r\n\u001b[32m\u001b[K174\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K175\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif step.Command == \"\" {\r\n\u001b[32m\u001b[K176\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn fmt.Errorf(\"step %s command is required\", step.Name)\r\n\u001b[32m\u001b[K177\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n\u001b[32m\u001b[K179\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif step.Resources.CPU > cfg.ResourceLimit.CPU {\r\n\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\treturn fmt.Errorf(\"step %s cpu requirement %d exceeds pipeline limit %d\", step.Name, step.Resources.CPU, cfg.ResourceLimit.CPU)\r\n\u001b[32m\u001b[K181\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif step.Resources.MemoryMB > cfg.ResourceLimit.M"]
[4331.138594, "o", "emoryMB {\r\n\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\treturn fmt.Errorf(\"step %s memory requirement %d MB exceeds pipeline limit %d MB\", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)\r\n\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif step.Type == \"train\" && step.ExperimentConfig == nil {\r\n\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn fmt.Errorf(\"train step %s requires experiment_config\", step.Name)\r\n\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K191\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, step := range cfg.Steps {\r\n\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor _, dep := range step.DependsOn {\r\n\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif !names[dep] {\r\n"]
[4331.139171, "o", "\u001b[?2004h"]
[4331.139233, "o", "root@n30009:/app# "]
[4339.649694, "i", "cat > /tmp/auto-output-pipeline.json <<'JSON'\n{\n  \"name\": \"auto-output-smoke\",\n  \"steps\": [\n    {\n      \"name\": \"prev\",\n      \"type\": \"shell\",\n      \"command\": \"echo '  hello output  '\"\n    },\n    {\n      \"name\": \"next\",\n      \"type\": \"shell\",\n      \"command\": \"echo got=\\\"${steps.prev.output}\\\" dur=\\\"${steps.prev.duration}\\\" status=\\\"${steps.prev.status}\\\"\",\n      \"depends_on\": [\"prev\"]\n    }\n  ]\n}\nJSON\n"]
