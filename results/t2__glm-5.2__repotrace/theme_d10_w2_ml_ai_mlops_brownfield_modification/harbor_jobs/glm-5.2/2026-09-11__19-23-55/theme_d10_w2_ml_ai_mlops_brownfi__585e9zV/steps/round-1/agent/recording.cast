[7198.496594, "o", "\t\tif len(args) < 2 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"run-id required\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tif err := deleteRun(args[1]); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
