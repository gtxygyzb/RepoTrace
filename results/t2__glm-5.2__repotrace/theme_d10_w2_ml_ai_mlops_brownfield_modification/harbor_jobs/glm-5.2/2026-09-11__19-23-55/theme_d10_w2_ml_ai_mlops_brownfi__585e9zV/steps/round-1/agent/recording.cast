[1986.320219, "o", "\u001b[?2004h> }\"\"\"\r\n\u001b[?2004l\r"]
[1986.320273, "o", "\u001b[?2004h> "]
[1986.320341, "o", "assert old in s\r\n\u001b[?2004l\r"]
[1986.320396, "o", "\u001b[?2004h> "]
[1986.3205, "o", "s = s.replace(old, new, 1)\r\n\u001b[?2004l\r"]
[1986.320557, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r.\u001b[?2004h"]
[1986.320614, "o", "> "]
[1986.320844, "o", "# Add capture_output validation after train step validation\r\n\u001b[?2004l\r"]
[1986.320899, "o", "\u001b[?2004h> "]
[1986.321201, "o", "old = \"\"\"\\t\\t\\tif step.Type == \"train\" && step.ExperimentConfig == nil {\r\n\u001b[?2004l\r"]
[1986.321256, "o", "\u001b[?2004h> "]
[1986.321613, "o", "\\t\\t\\t\\treturn fmt.Errorf(\"train step %s requires experiment_config\", step.Name)\r\n\u001b[?2004l\r"]
[1986.321668, "o", "\u001b[?2004h> "]
[1986.321722, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.321778, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.322025, "o", "new = old + \"\"\"\\t\\t\\tif step.CaptureOutput != nil {\r\n\u001b[?2004l\r"]
[1986.322087, "o", "\u001b[?2004h> "]
[1986.322268, "o", "\\t\\t\\t\\tif step.CaptureOutput.Name == \"\" {\r\n\u001b[?2004l\r"]
[1986.322323, "o", "\u001b[?2004h> "]
[1986.322674, "o", "\\t\\t\\t\\t\\treturn fmt.Errorf(\"step %s capture_output name is required\", step.Name)\r\n\u001b[?2004l\r"]
[1986.322729, "o", "\u001b[?2004h> "]
[1986.322783, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.322994, "o", "\\t\\t\\t\\tif step.CaptureOutput.Regex != \"\" {\r\n\u001b[?2004l\r"]
[1986.323058, "o", "\u001b[?2004h> "]
[1986.323416, "o", "\\t\\t\\t\\t\\tif _, err := regexp.Compile(step.CaptureOutput.Regex); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.323472, "o", "> "]
[1986.323843, "o", "\\t\\t\\t\\t\\t\\treturn fmt.Errorf(\"step %s capture_output regex is invalid: %w\", step.Name, err)\r\n\u001b[?2004l\r"]
[1986.323899, "o", "\u001b[?2004h> "]
[1986.32396, "o", "\\t\\t\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.324025, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r"]
[1986.324089, "o", "\u001b[?2004h> \\t\\t\\t}\r\n"]
[1986.324146, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1986.3242, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.324288, "o", "assert old in s\r\n\u001b[?2004l\r"]
[1986.324342, "o", "\u001b[?2004h> "]
[1986.324436, "o", "s = s.replace(old, new, 1)\r\n\u001b[?2004l\r"]
