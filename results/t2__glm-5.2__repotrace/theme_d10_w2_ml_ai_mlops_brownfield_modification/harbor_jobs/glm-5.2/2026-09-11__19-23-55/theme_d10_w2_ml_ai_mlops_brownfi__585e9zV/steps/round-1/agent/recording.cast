[67.600017, "o", "   159\t\r\n   160\t\tswitch args[0] {\r\n   161\t\tcase \"create\":\r\n   162\t\t\tif len(args) < 2 {\r\n   163\t\t\t\tfmt.Fprintln(os.Stderr, \"experiment name required\")\r\n   164\t\t\t\tos.Exit(1)\r\n   165\t\t\t}\r\n   166\t\t\tname := args[1]\r\n   167\t\t\tparamsStr := getFlag(args, \"--params\", \"\")\r\n   168\t\t\ttagsStr := getFlag(args, \"--tags\", \"\")\r\n   169\t\r\n   170\t\t\tparams := make(map[string]string)\r\n   171\t\t\tif paramsStr != \"\" {\r\n   172\t\t\t\tfor _, p := range strings.Split(paramsStr, \",\") {\r\n   173\t\t\t\t\tkv := strings.SplitN(p, \"=\", 2)\r\n   174\t\t\t\t\tif len(kv) == 2 {\r\n   175\t\t\t\t\t\tparams[kv[0]] = kv[1]\r\n   176\t\t\t\t\t}\r\n"]
[67.600107, "o", "   177\t\t\t\t}\r\n   178\t\t\t}\r\n   179\t\r\n   180\t\t\tvar tags []string\r\n   181\t\t\tif tagsStr != \"\" {\r\n   182\t\t\t\ttags = strings.Split(tagsStr, \",\")\r\n   183\t\t\t}\r\n   184\t\r\n   185\t\t\texp, err := tracker.Create(name, params, tags)\r\n   186\t\t\tif err != nil {\r\n   187\t\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n   188\t"]
