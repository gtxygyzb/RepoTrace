[37.7789, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\n"]
[37.778937, "o", "// Registry provides model lifecycle management\r\ntype Registry struct {\r\n\tstore *Store\r\n}\r\n\r\nfunc NewRegistry(store *Store) *Registry {\r\n\treturn &Registry{store: store}\r\n"]
[37.779203, "o", "}\r\n\r\nfunc (r *Registry) Register(name, version, framework, description string, tags []string) (*Model, error) {\r\n\tif name == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"model name is required\")\r\n\t}\r\n\tif version == \"\" {\r\n\t\tversion = r.nextVersion(name)\r\n\t}\r\n\tif !isValidSemver(version) {\r\n\t\treturn nil, fmt.Errorf(\"invalid version format: %s (expected semver like 1.0.0)\", version)\r\n\t}\r\n\r\n\tif existing, _ := r.store.GetModel(name, version); existing != nil {\r\n\t\treturn nil, fmt.Errorf(\"model %s:%s already exists\", name, version)\r\n\t}\r\n\r\n\tnow := time.Now()\r\n\tm := &Model{\r\n\t\tName:        name,\r\n\t\tVersion:     version,\r\n\t\tFramework:   framework,\r\n\t\tDescription: description,\r\n\t\tTags:        tags,\r\n\t\tStatus:      ModelStatusRegistered,\r\n\t\tMetrics:     make(map[string]float64),\r\n\t\tCreatedAt:   now,\r\n\t\tUpdatedAt:   now,\r\n\t}\r\n\r\n\tif err := r.store.SaveModel(m); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn m, nil\r\n}\r\n\r\nfunc (r *Registry) Promote(name, version string, targetStatus ModelStatus) error {\r\n\tm, err := r.store.GetModel(name, ve"]
[37.779301, "o", "rsion)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n\tif !m.CanTransitionTo(targetStatus) {\r\n\t\treturn fmt.Errorf(\"cannot transition model %s from %s to %s\", m.Key(), m.Status, targetStatus)\r\n\t}\r\n\r\n\t// If promoting to production, demote any current production version of same model name\r\n\tif targetStatus == ModelStatusProduction {\r\n\t\tmodels := r.store.ListModels(name)\r\n\t\tfor _, other := range models {\r\n\t\t\tif other.Name == name && other.Status == ModelStatusProduction && other.Version != version {\r\n\t\t\t\tother.Status = ModelStatusStaging\r\n\t\t\t\tother.UpdatedAt = time.Now()\r\n\t\t\t\tr.store.SaveModel(other)\r\n\t\t\t}\r\n\t\t}\r\n\t"]
[37.779367, "o", "}\r\n\r\n\tm.Status = targetStatus\r\n\tm.UpdatedAt = time.Now()\r\n\treturn r.store.SaveModel(m)\r\n}\r\n\r\nfunc (r *Registry) Compare(name string) ([]*Model, error) {\r\n\tmodels := r.store.ListModels(name)\r\n\tif len(models) == 0 {\r\n"]
[37.779444, "o", "\t\treturn nil, fmt.Errorf(\"no models found with name: %s\", name)\r\n\t}\r\n\r\n\tsort.Slice(models, func(i, j int) bool {\r\n\t\treturn compareSemver(models[i].Version, models[j].Version) > 0\r\n\t})\r\n\r\n\treturn models, nil\r\n}\r\n\r\nfunc (r *Registry) nextVersion(name string) string {\r\n\tmodels := r.store.ListModels(name)\r\n\tif len(models) == 0 {\r\n\t\treturn \"1.0.0\"\r\n\t}\r\n\r\n\tmaxMajor := 0\r\n\tfor _, m := range models {\r\n"]
[37.779505, "o", "\t\tif m.Name == name {\r\n\t\t\tparts := strings.Split(m.Version, \".\")\r\n\t\t\tif len(parts) >= 1 {\r\n\t\t\t\tif major, err := strconv.Atoi(parts[0]); err == nil && major > maxMajor {\r\n\t\t\t\t\tmaxMajor = major\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[37.779562, "o", "\r\n\treturn fmt.Sprintf(\"%d.0.0\", maxMajor+1)\r\n}\r\n\r\nfunc isValidSemver(v string) bool {\r\n\tparts := strings.Split(v, \".\")\r\n\tif len(parts) != 3 {\r\n\t\treturn false\r\n\t}\r\n\tfor _, p := range parts {\r\n"]
[37.779625, "o", "\t\tif _, err := strconv.Atoi(p); err != nil {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc compareSemver(a, b string) int {\r\n\tpa := strings.Split(a, \".\")\r\n\tpb := strings.Split(b, \".\")\r\n\tfor i := 0; i < 3; i++ {\r\n\t\t"]
[37.77969, "o", "ai, _ := strconv.Atoi(pa[i])\r\n\t\tbi, _ := strconv.Atoi(pb[i])\r\n\t\tif ai != bi {\r\n\t\t\treturn ai - bi\r\n\t\t}\r\n\t}\r\n\treturn 0\r\n}\r\n"]
