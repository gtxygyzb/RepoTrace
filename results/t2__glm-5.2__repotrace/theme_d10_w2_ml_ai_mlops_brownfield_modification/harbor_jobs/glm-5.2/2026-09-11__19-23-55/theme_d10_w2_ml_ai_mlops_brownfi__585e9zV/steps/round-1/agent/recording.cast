[1076.810422, "o", "new_handle_train='''func createTrainExperiment(tracker *Tracker, step *PipelineStep, existingID string) (*Experiment, error) {\r\n\u001b[?2004l\r"]
[1076.810497, "o", "\u001b[?2004h> \\texpName := step.Name\r\n\u001b[?2004l\r"]
[1076.810567, "o", "\u001b[?2004h> "]
