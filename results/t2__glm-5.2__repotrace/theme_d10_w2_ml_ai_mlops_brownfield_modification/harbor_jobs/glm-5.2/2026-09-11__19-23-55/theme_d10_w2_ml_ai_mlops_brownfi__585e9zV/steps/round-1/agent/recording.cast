[3271.98312, "o", "   865\t\tvar run PipelineRun\r\n   866\t\tif err := json.Unmarshal(data, &run); err != nil {\r\n   867\t\t\treturn nil, fmt.Errorf(\"parse run: %w\", err)\r\n   868\t\t}\r\n   869\t\treturn &run, nil\r\n   870\t}\r\n   871\t\r\n   872\tfunc listRuns() []*PipelineRun {\r\n   873\t\tentries, err := os.ReadDir(pipelineRunsDir)\r\n   874\t\tif err != nil {\r\n   875\t\t\treturn nil\r\n   876\t\t}\r\n   877\t\tvar runs []*PipelineRun\r\n"]
[3271.98322, "o", "   878\t\tfor _, entry := range entries {\r\n   879\t\t\tif !entry.IsDir() {\r\n   880\t\t\t\tcontinue\r\n   881\t\t\t}\r\n   882\t\t\trun, err := loadRun(entry.Name())\r\n   883\t\t\tif err != nil {\r\n   884\t\t\t\tcontinue\r\n   885\t\t\t}\r\n   886\t\t\truns = append(runs, run)\r\n   887\t\t}\r\n   888\t\tsort.Slice(runs, func(i, j int) bool {\r\n   889\t\t\tif runs[i].StartTime == nil || runs[j].StartTime == nil {\r\n   890\t\t\t\treturn runs[i].ID < runs[j].ID\r\n   891\t\t\t}\r\n   892\t\t\treturn runs[i].StartTime.Before(*runs[j].StartTime)\r\n   893"]
