[726.131894, "o", "} else {\r\nexp, err = tracker.Create(expName, params, tags)\r\n}\r\nif err != nil {\r\nreturn \"\", err\r\n}\r\nfor _, line := range strings.Split(output, \"\\n\") {\r\nkey, value, ok := parseMetricLine(line)\r\nif !ok {\r\ncontinue\r\n}\r\nif len(step.ExperimentConfig.Metrics) > 0 && !containsString(step.ExperimentConfig.Metrics, key) {\r\ncontinue\r\n}\r\n"]
[726.131969, "o", "if lerr := tracker.LogMetric(exp.ID, key, value); lerr != nil {\r\nerr = lerr\r\n}\r\n}\r\nif err != nil {\r\ntracker.Complete(exp.ID, ExperimentStatusFailed)\r\nreturn exp.ID, err\r\n}\r\ntracker.Complete(exp.ID, ExperimentStatusCompleted)\r\nreturn exp.ID, nil\r\n}\r\n\r\nfunc parseMetricLine(line string) (string, float64, bool) {\r\nparts := strings.SplitN(line, \"=\", 2)\r\nif len(parts) != 2 {\r\nreturn \"\", 0, false\r\n}\r\nkey := strings.TrimSpace(parts[0])\r\nval := strings.TrimSpace(parts[1])\r\nif key == \"\" {\r\nreturn \"\", 0, false\r\n}\r\nvalue, err := strconv.ParseFloat(val, 64)\r\nif err != nil {\r\nreturn \"\", 0, false\r\n}\r\nreturn key, value, true\r\n}\r\n\r\n"]
[726.132029, "o", "func runShellCommand(command string, timeoutSeconds int) (string, int, error) {\r\ncmd := exec.Command(\"sh\", \"-c\", command)\r\nvar out strings.Builder\r\ncmd.Stdout = &out\r\ncmd.Stderr = &out\r\n\r\nif timeoutSeconds > 0 {\r\ntimer := time.AfterFunc(time.Duration(timeoutSeconds)*time.Second, func() {\r\nif cmd.Process != nil {\r\ncmd.Process.Kill()\r\n}\r\n})\r\ndefer timer.Stop()\r\n}\r\n\r\n"]
[726.1321, "o", "err := cmd.Run()\r\nexitCode := 0\r\n"]
