[4080.696189, "o", "   590\t\t\t}\r\n   591\t\t\tsr.ExperimentID = exp.ID\r\n   592\t\t}\r\n   593\t\r\n"]
[4080.696256, "o", "   594\t\tfor attempt := 0; attempt <= maxRetries; attempt++ {\r\n   595\t\t\tstart := time.Now()\r\n   596\t\t\tsr.StartTime = &start\r\n   597\t\t\tsr.RetryCount = attempt\r\n   598\t\t\tstdout, stderr, exitCode, err := runShellCommand(cmdStr, step.TimeoutSeconds, envVars)\r\n   599\t\t\tsr.Output = stdout\r\n   600\t\t\tif stderr != \"\" {\r\n   601\t\t\t\tif sr.Output != \"\" {\r\n   602\t\t\t\t\tsr.Output += \"\\n\"\r\n   603\t\t\t\t}\r\n"]
[4080.696318, "o", "   604\t\t\t\tsr.Output += stderr\r\n   605\t\t\t}\r\n   606\t\t\tsr.ExitCode = exitCode\r\n   607\t\t\tif err == nil {\r\n   608\t\t\t\tsr.EndTime = nowPtr()\r\n   609\t\t\t\tsr.Status = \"succeeded\"\r\n   610\t\t\t\tsr.Error = \"\"\r\n   611\t\t\t\tproduceArtifacts(run, step, sr, stdout)\r\n   612"]
[4080.69638, "o", "\t\t\t\tif step.Type == \"train\" && exp != nil {\r\n   613\t\t\t\t\tif terr := finishTrainExperiment(tracker, exp, step, stdout); terr != nil {\r\n   614\t\t\t\t\t\tsr.Status = \"failed\"\r\n   615\t\t\t\t\t\tsr.Error = terr.Error()\r\n   616\t\t\t\t\t\treturn\r\n   617\t\t\t\t\t}\r\n   618\t\t\t\t}\r\n   619\t\t\t\tif step.Type == \"evaluate\" {\r\n   620\t\t"]
[4080.696444, "o", "\t\t\tregisterEvaluateArtifacts(run, step, sr)\r\n   621\t\t\t\t}\r\n   622\t\t\t\tif step.CaptureOutput != nil {\r\n   623\t\t\t\t\tval, ok, cerr := captureOutputValue(step, stdout)\r\n   624\t\t\t\t\tif cerr != nil {\r\n   625\t\t\t\t\t\tsr.Status = \"failed\"\r\n   626\t\t\t\t\t\tsr.Error = cerr.Error()\r\n"]
[4080.696505, "o", "   627\t\t\t\t\t\treturn\r\n   628\t\t\t\t\t}\r\n   629\t\t\t\t\tif ok {\r\n   630\t\t\t\t\t\tvarMu.Lock()\r\n   631\t\t\t\t\t\tvariables[step.CaptureOutput.Name] = val\r\n   632\t\t\t\t\t\tvarMu.Unlock()\r\n   633\t\t\t\t\t}\r\n   634\t\t\t\t}\r\n"]
[4080.696571, "o", "   635\t\t\t\treturn\r\n   636\t\t\t}\r\n   637\t\t\tsr.Error = err.Error()\r\n   638\t\t\tif step.Type == \"train\" && exp != nil {\r\n   639\t\t\t\ttracker.Complete(exp.ID, ExperimentStatusFailed)\r\n   640\t\t\t}\r\n   641\t\t\tif attempt < maxRetries {\r\n"]
[4080.69663, "o", "   642\t\t\t\tdelay := time.Duration(math.Pow(float64(backoffBase), float64(attempt+1))) * time.Second\r\n   643\t\t\t\ttime.Sleep(delay)\r\n   644\t\t\t}\r\n   645\t\t}\r\n   646\t\tsr.EndTime = nowPtr()\r\n   647\t\tsr.Status = \"failed\"\r\n   648\t}\r\n"]
