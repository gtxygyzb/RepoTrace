[3058.104811, "o", "   227\t\tgraph := make(map[string][]string)\r\n   228\t\tfor _, s := range steps {\r\n   229\t\t\tgraph[s.Name] = append(graph[s.Name], s.DependsOn...)\r\n   230\t\t}\r\n   231\t\tvisited := make(map[string]int)\r\n   232\t\tvar stack []string\r\n   233\t\tvar dfs func(node string) []string\r\n   234\t\tdfs = func(node string) []string {\r\n   235\t\t\tvisited[node] = 1\r\n   236\t\t\tstack = append(stack, node)\r\n   237\t\t\tfor _, dep := range graph[node] {\r\n"]
