[2184.004917, "o", "func pipelineHistory(name, status string) []PipelineHistoryEntry {\r\n\u001b[?2004l\r"]
[2184.004976, "o", "\u001b[?2004h> "]
[2184.005103, "o", "\\truns := listRuns()\r\n"]
[2184.00516, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[2184.005404, "o", "\\tout := make([]PipelineHistoryEntry, 0)\r\n\u001b[?2004l\r"]
[2184.00546, "o", "\u001b[?2004h> "]
[2184.005593, "o", "\\tfor _, run := range runs {\r\n\u001b[?2004l\r"]
[2184.005649, "o", "\u001b[?2004h> "]
[2184.00576, "o", "\\t\\tif run.Pipeline != name {\r\n\u001b[?2004l\r"]
[2184.005817, "o", "\u001b[?2004h> "]
