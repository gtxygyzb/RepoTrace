[1986.423941, "o", "# Replace substitution/condition/resolveParam block\r\n\u001b[?2004l\r"]
[1986.423995, "o", "\u001b[?2004h> "]
[1986.424213, "o", "old = '''func substituteParams(command string, params map[string]string) string {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.424291, "o", "\\tresult := command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.424393, "o", "\\tfor k, v := range params {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.424573, "o", "\\t\\tresult = strings.ReplaceAll(result, \"${\"+k+\"}\", v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.424628, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.424678, "o", "\\treturn result\r\n\u001b[?2004l\r"]
[1986.424738, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h"]
[1986.424792, "o", "> "]
[1986.424983, "o", "func evaluateCondition(cond string, params map[string]string) (bool, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.425111, "o", "\\tcond = strings.TrimSpace(cond)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.425183, "o", "\\tif cond == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.425269, "o", "\\t\\treturn true, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.425324, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.425423, "o", "\\tif strings.Contains(cond, \"==\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.425558, "o", "\\t\\tparts := strings.SplitN(cond, \"==\", 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.425751, "o", "\\t\\tleft := resolveParam(strings.TrimSpace(parts[0]), params)\r\n\u001b[?2004l\r"]
[1986.425772, "o", "\u001b[?2004h> "]
[1986.425956, "o", "\\t\\tright := resolveParam(strings.TrimSpace(parts[1]), params)\r\n\u001b[?2004l\r\\\u001b[?2004h> "]
[1986.426062, "o", "\\t\\treturn left == right, nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.426084, "o", "> \\t}\r\n\u001b[?2004l\r"]
[1986.426104, "o", "\u001b[?2004h> "]
[1986.426227, "o", "\\tif strings.Contains(cond, \"!=\") {\r\n\u001b[?2004l\rd\u001b[?2004h"]
[1986.426247, "o", "> "]
[1986.426363, "o", "\\t\\tparts := strings.SplitN(cond, \"!=\", 2)\r\n\u001b[?2004l\r"]
[1986.426383, "o", "\u001b[?2004h> "]
[1986.426553, "o", "\\t\\tleft := resolveParam(strings.TrimSpace(parts[0]), params)\r\n\u001b[?2004l\r"]
[1986.426574, "o", "\u001b[?2004h> "]
[1986.426735, "o", "\\t\\tright := resolveParam(strings.TrimSpace(parts[1]), params)\r\n\u001b[?2004l\r"]
[1986.426756, "o", "\u001b[?2004h> "]
[1986.426848, "o", "\\t\\treturn left != right, nil\r\n\u001b[?2004l\r"]
[1986.426871, "o", "\u001b[?2004h> \\t}"]
[1986.426892, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.490471, "o", "\\treturn false, fmt.Errorf(\"invalid condition: %s\", cond)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> func resolveParam(token string, params map[string]string) string {\r\n\u001b[?2004l\r\u001b[?2004h> \\tre := regexp.MustCompile(`^\\\\$\\\\{(.+)\\\\}$`)\r\n\u001b[?2004l\r\u001b[?2004h> \\tm := re.FindStringSubmatch(token)\r\n\u001b[?2004l\r\u001b[?2004h> \\tif m != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\treturn params[m[1]]\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\ru\u001b[?2004h> \\treturn token\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r}\u001b[?2004h> new = '''func substituteParams(command string, params map[string]string) string {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.490752, "o", "\\tres, _ := substituteVariables(command, params)\r\n\u001b[?2004l\r"]
[1986.490811, "o", "\u001b[?2004h> "]
[1986.490901, "o", "\\treturn res\r\n\u001b[?2004l\r"]
[1986.490962, "o", "\u001b[?2004h> }\r\n"]
[1986.491037, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1986.491107, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.491532, "o", "var variableTokenRe = regexp.MustCompile(`\\\\$\\\\{([^}]*)\\\\}`)\r\n\u001b[?2004l\r"]
[1986.491592, "o", "\u001b[?2004h> \r\n"]
[1986.491647, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1986.492219, "o", "func substituteVariables(command string, vars map[string]string) (string, error) {\r\n\u001b[?2004l\r"]
[1986.492287, "o", "\u001b[?2004h> "]
[1986.492428, "o", "\\tvar firstErr error\r\n\u001b[?2004l\r"]
[1986.492482, "o", "\u001b[?2004h> "]
[1986.493061, "o", "\\tresult := variableTokenRe.ReplaceAllStringFunc(command, func(token string) string {\r\n\u001b[?2004l\r"]
[1986.493126, "o", "\u001b[?2004h> "]
[1986.493388, "o", "\\t\\tcontent := token[2 : len(token)-1]\r\n\u001b[?2004l\r"]
[1986.493446, "o", "\u001b[?2004h> "]
[1986.493888, "o", "\\t\\tname, defaultVal, hasDefault := splitVariableDefault(content)\r\n\u001b[?2004l\r"]
[1986.493945, "o", "\u001b[?2004h> "]
[1986.494345, "o", "\\t\\tif hasDefault && strings.Contains(defaultVal, \"${\") {\r\n\u001b[?2004l\r"]
[1986.494403, "o", "\u001b[?2004h> "]
[1986.494589, "o", "\\t\\t\\tif firstErr == nil {\r\n\u001b[?2004l\r"]
[1986.494646, "o", "\u001b[?2004h> "]
[1986.495382, "o", "\\t\\t\\t\\tfirstErr = fmt.Errorf(\"default value for variable %s cannot contain nested ${...} references\", name)\r\n\u001b[?2004l\r"]
[1986.495445, "o", "\u001b[?2004h> "]
[1986.495506, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[1986.495567, "o", "\u001b[?2004h> "]
[1986.495702, "o", "\\t\\t\\treturn token\r\n\u001b[?2004l\r"]
[1986.495758, "o", "\u001b[?2004h> "]
[1986.495816, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.495872, "o", "\u001b[?2004h> "]
[1986.496123, "o", "\\t\\tif val, ok := vars[name]; ok {\r\n\u001b[?2004l\r"]
[1986.496182, "o", "\u001b[?2004h> "]
[1986.496303, "o", "\\t\\t\\treturn val\r\n\u001b[?2004l\r"]
[1986.496358, "o", "\u001b[?2004h> "]
[1986.496411, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.496467, "o", "\u001b[?2004h> "]
[1986.496609, "o", "\\t\\tif hasDefault {\r\n\u001b[?2004l\r"]
[1986.496664, "o", "\u001b[?2004h> "]
[1986.496836, "o", "\\t\\t\\treturn defaultVal\r\n\u001b[?2004l\r"]
[1986.496892, "o", "\u001b[?2004h> "]
[1986.496942, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.496996, "o", "\u001b[?2004h> "]
[1986.497189, "o", "\\t\\tif firstErr == nil {\r\n\u001b[?2004l\r"]
[1986.497246, "o", "\u001b[?2004h> "]
[1986.497674, "o", "\\t\\t\\tfirstErr = fmt.Errorf(\"unresolved variable: %s\", token)\r\n\u001b[?2004l\r"]
[1986.49773, "o", "\u001b[?2004h> "]
[1986.497786, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.497843, "o", "\u001b[?2004h> "]
[1986.497959, "o", "\\t\\treturn token\r\n\u001b[?2004l\r"]
[1986.498016, "o", "\u001b[?2004h> "]
[1986.498102, "o", "\\t})\r\n\u001b[?2004l\r"]
[1986.498159, "o", "\u001b[?2004h> "]
[1986.49832, "o", "\\tif firstErr != nil {\r\n\u001b[?2004l\r"]
[1986.498375, "o", "\u001b[?2004h> "]
[1986.498569, "o", "\\t\\treturn result, firstErr\r\n\u001b[?2004l\r"]
[1986.498624, "o", "\u001b[?2004h> "]
[1986.498682, "o", "\\t}\r\n\u001b[?2004l\r"]
[1986.498737, "o", "\u001b[?2004h> "]
[1986.498878, "o", "\\treturn result, nil\r\n\u001b[?2004l\r"]
[1986.498934, "o", "\u001b[?2004h> }"]
[1986.498988, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.49905, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.499105, "o", "> "]
[1986.49989, "o", "func substituteStaticForDryRun(command string, params map[string]string, captureNames map[string]bool) (string, error) {\r\n\u001b[?2004l\r"]
