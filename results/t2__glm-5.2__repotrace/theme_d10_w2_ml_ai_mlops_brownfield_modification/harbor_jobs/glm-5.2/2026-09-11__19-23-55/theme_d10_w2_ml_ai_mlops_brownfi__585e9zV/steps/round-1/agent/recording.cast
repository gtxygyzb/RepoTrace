[4080.41727, "o", "   517\tfunc executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {\r\n   518\t\tfor _, dep := range step.DependsOn {\r\n   519\t\t\tdepStatus := getRunStep(run, dep).Status\r\n   520\t\t\tif depStatus == \"succeeded\" || depStatus == \"skipped\" {\r\n   521\t\t\t\tcontinue\r\n   522\t\t\t}\r\n"]
[4080.417372, "o", "   523\t\t\tif depStatus == \"failed\" {\r\n   524\t\t\t\tdepStep := getStepConfig(cfg, dep)\r\n   525\t\t\t\tif depStep != nil && depStep.AllowFailure {\r\n   526\t\t\t\t\tcontinue\r\n   527\t\t\t\t}\r\n   528\t\t\t}\r\n"]
[4080.417441, "o", "   529\t\t\tsr.Status = \"failed\"\r\n   530\t\t\tsr.Error = \"dependency failed\"\r\n   531\t\t\treturn\r\n   532\t\t}\r\n   533\t\r\n   534\t\tvarMu.Lock()\r\n   535\t\tvars := copyMap(variables)\r\n   536\t\tvarMu.Unlock()\r\n   537\t\r\n   538\t\tif step.Condition != \"\" {\r\n   539\t\t\tcond, err := evaluateCondition(step.Condition, vars)\r\n   540\t\t\tif err != nil {\r\n   541\t\t\t\tsr.Status = \"failed\"\r\n   542\t\t\t\tsr.Error = err.Error()\r\n   543\t\t\t\treturn\r\n   544"]
[4080.417503, "o", "\t\t\t}\r\n   545\t\t\tif !cond {\r\n   546\t\t\t\tsr.Status = \"skipped\"\r\n   547\t\t\t\tsr.Output = \"condition false\"\r\n   548\t\t\t\treturn\r\n   549\t\t\t}\r\n   550\t\t}\r\n"]
[4080.417569, "o", "   551\t\r\n   552\t\tcmdStr, err := substituteVariables(step.Command, vars)\r\n   553\t\tif err != nil {\r\n   554\t\t\tsr.Status = \"failed\"\r\n   555\t\t\tsr.Error = err.Error()\r\n   556\t\t\treturn\r\n   557\t\t}\r\n   558"]
[4080.417628, "o", "\t\r\n   559\t\tenvVars := os.Environ()\r\n   560\t\tfor k, v := range vars {\r\n   561\t\t\tenvVars = append(envVars, \"NEXUS_PARAM_\"+k+\"=\"+v)\r\n   562\t\t}\r\n   563\t\tfor k, v := range step.Env {\r\n   564\t\t\tev, err := substituteVariables(v, vars)\r\n   565\t\t\tif err != nil {\r\n"]
[4080.417689, "o", "   566\t\t\t\tsr.Status = \"failed\"\r\n   567\t\t\t\tsr.Error = fmt.Sprintf(\"env %s: %v\", k, err)\r\n   568\t\t\t\treturn\r\n   569\t\t\t}\r\n   570\t\t\tenvVars = append(envVars, k+\"=\"+ev)\r\n   571\t\t}\r\n   572\t\r\n   573\t\tmaxRetries := 0\r\n   574\t\t"]
[4080.417746, "o", "backoffBase := 1\r\n   575\t\tif step.Retry != nil {\r\n   576\t\t\tmaxRetries = step.Retry.MaxRetries\r\n   577\t\t\tif step.Retry.BackoffBaseSeconds > 0 {\r\n   578\t\t\t\tbackoffBase = step.Retry.BackoffBaseSeconds\r\n   579\t\t\t}\r\n   580\t\t}\r\n   581\t\r\n   582\t\t"]
[4080.417806, "o", "var exp *Experiment\r\n   583\t\tif step.Type == \"train\" {\r\n   584\t\t\tvar err error\r\n   585\t\t\texp, err = createTrainExperiment(tracker, step, sr.ExperimentID)\r\n   586\t\t\tif err != nil {\r\n   587\t\t\t\tsr.Status = \"failed\"\r\n   588\t\t\t\tsr.Error = err.Error()\r\n   589\t\t\t\treturn\r\n   590\t\t\t}\r\n"]
[4080.418553, "o", "\u001b[?2004h"]
