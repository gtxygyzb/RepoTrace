[6227.15206, "o", "   124\t\tEndTime     *time.Time        `json:\"end_time,omitempty\"`\r\n   125\t\tSteps       []*StepRun        `json:\"steps\"`\r\n   126\t\tArtifacts   []Artifact        `json:\"artifacts,omitempty\"`\r\n   127\t\tRunDir      string            `json:\"run_dir,omitempty\"`\r\n   128\t\tVariables   map[string]string `json:\"variables,omitempty\"`\r\n   129\t\tWarnings    []string          `json:\"warnings\"`\r\n   130\t}\r\n   131\t\r\n   132\ttype Checkpoint struct {\r\n   133\t\tRunID      string            `json:\"run_id\"`\r\n   134\t\tStatus     string            `json:\"status\"`\r\n   135\t\tParameters map[string]string `json:\"parameters,omitempty\"`\r\n   136\t\tSteps      []*StepRun        `json:\"steps\"`\r\n   137\t\tArtifacts  []Artifact        `json:\"artifacts,omitempty\"`\r\n   138\t\tVariables  map[string]string `json:\"variables,omitempty\"`\r\n   139\t\tWarnings   []string          `json:\"warnings\"`\r\n   140\t}\r\n"]
