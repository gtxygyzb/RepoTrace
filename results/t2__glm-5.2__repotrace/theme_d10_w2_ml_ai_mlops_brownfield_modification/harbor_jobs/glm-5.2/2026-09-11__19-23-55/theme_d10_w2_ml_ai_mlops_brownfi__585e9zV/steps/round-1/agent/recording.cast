[6232.098249, "o", "   528\tfunc executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {\r\n   529\t\tfor _, dep := range step.DependsOn {\r\n   530\t\t\tdepStatus := getRunStep(run, dep).Status\r\n   531\t\t\tif depStatus == \"succeeded\" || depStatus == \"skipped\" {\r\n   532\t\t\t\tcontinue\r\n"]
[6232.098364, "o", "   533\t\t\t}\r\n   534\t\t\tif depStatus == \"failed\" {\r\n   535\t\t\t\tdepStep := getStepConfig(cfg, dep)\r\n   536\t\t\t\tif depStep != nil && depStep.AllowFailure {\r\n   537\t\t\t\t\tcontinue\r\n   538\t\t\t\t}\r\n   539\t\t\t}\r\n   540\t\t\tsr.Status = \"failed\"\r\n   541\t\t\tsr.Error = \"dependency failed\"\r\n   542\t\t\treturn\r\n   543\t\t}\r\n   544\t\r\n   545\t\tvarMu.Lock()\r\n   546\t\tvars := copyMap(variables)\r\n   547\t\tvarMu.Unlock()\r\n   548\t\r\n"]
[6232.098436, "o", "   549\t\tif step.Condition != \"\" {\r\n   550\t\t\tcond, err := evaluateCondition(step.Condition, vars)\r\n   551\t\t\tif err != nil {\r\n   552\t\t\t\tsr.Status = \"failed\"\r\n   553\t\t\t\tsr.Error = err.Error()\r\n   554\t\t\t\treturn\r\n   555\t\t\t}\r\n   556\t\t\tif !cond {\r\n   557\t\t\t\tsr.Status = \"skipped\"\r\n   558\t\t\t\tsr.Output = \"condition false\"\r\n   559\t\t\t\t"]
[6232.098509, "o", "sr.Stdout = \"\"\r\n   560\t\t\t\treturn\r\n   561\t\t\t}\r\n   562\t\t}\r\n   563\t\r\n   564\t\tcmdStr, err := substituteVariables(step.Command, vars)\r\n   565\t\tif err != nil {\r\n   566\t\t\tsr.Status = \"failed\"\r\n   567\t\t\tsr.Error = err.Error()\r\n   568\t\t\treturn\r\n"]
