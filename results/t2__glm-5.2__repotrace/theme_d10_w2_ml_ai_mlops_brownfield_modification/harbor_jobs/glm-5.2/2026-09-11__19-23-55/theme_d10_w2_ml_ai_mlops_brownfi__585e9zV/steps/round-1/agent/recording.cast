[1039.311752, "o", "\t\tdelay := time.Duration(math.Pow(float64(backoffBase), float64(attempt+1))) * time.Second\r\n\t\t\ttime.Sleep(delay)\r\n\t\t}\r\n\t}\r\n\tsr.EndTime = nowPtr()\r\n\tsr.Status = \"failed\"\r\n}\r\n\r\nfunc getRunStep(run *PipelineRun, name string) *StepRun {\r\n\tfor _, sr := range run.Steps {\r\n\t\tif sr.Name == name {\r\n\t\t\treturn sr\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n"]
