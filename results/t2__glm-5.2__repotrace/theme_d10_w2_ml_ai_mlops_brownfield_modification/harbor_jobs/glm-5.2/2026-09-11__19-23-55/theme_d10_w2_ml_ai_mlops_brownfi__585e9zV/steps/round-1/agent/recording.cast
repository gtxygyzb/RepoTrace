[716.526548, "o", "sr.Error = terr.Error()\r\n} else {\r\nsr.ExperimentID = expID\r\n}\r\n}\r\nif step.Type == \"evaluate\" {\r\nregisterEvaluateArtifacts(run, step, sr)\r\n}\r\nreturn\r\n}\r\nsr.Error = err.Error()\r\nif attempt < maxRetries {\r\ndelay := time.Duration(math.Pow(float64(backoffBase), float64(attempt+1))) * time.Second\r\n"]
[716.526606, "o", "time.Sleep(delay)\r\n}\r\n}\r\nsr.EndTime = nowPtr()\r\nsr.Status = \"failed\"\r\n}\r\n\r\nfunc getRunStep(run *PipelineRun, name string) *StepRun {\r\nfor _, sr := range run.Steps {\r\nif sr.Name == name {\r\nreturn sr\r\n}\r\n}\r\n"]
