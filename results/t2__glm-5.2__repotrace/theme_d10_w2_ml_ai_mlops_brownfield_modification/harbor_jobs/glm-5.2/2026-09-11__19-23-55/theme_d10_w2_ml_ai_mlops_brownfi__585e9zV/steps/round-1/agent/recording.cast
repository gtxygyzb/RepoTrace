[5826.39515, "o", "\tfor _, s := range steps {\r\n\t\tif visited[s.Name] == 0 {\r\n\t\t\tif c := dfs(s.Name); c != nil {\r\n"]
[5826.395229, "o", "\t\t\t\treturn c\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc isTransitiveDependency(steps []*PipelineStep, step, target string) bool {\r\n\tbyName := make(map[string]*PipelineStep)\r\n\tfor _, s := range steps {\r\n\t\tbyName[s.Name] = s\r\n\t}\r\n\tvar visit func(current string) bool\r\n\tvisit = func(current string) bool {\r\n\t\ts := byName[current]\r\n\t\tfor _, dep := range s.DependsOn {\r\n"]
[5826.395317, "o", "\t\t\tif dep == target {\r\n\t\t\t\treturn true\r\n\t\t\t}\r\n\t\t\tif visit(dep) {\r\n\t\t\t\treturn true\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn false\r\n\t}\r\n\treturn visit(step)\r\n}\r\n\r\nfunc runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {\r\n\t"]
[5826.395385, "o", "if err := validatePipelineConfig(cfg); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tmerged := mergeParams(cfg.Parameters, params)\r\n\tif maxParallel <= 0 {\r\n\t\tmaxParallel = cfg.MaxParallel\r\n\t}\r\n\tif maxParallel <= 0 {\r\n\t\tmaxParallel = 4\r\n\t}\r\n"]
[5826.395446, "o", "\r\n\trunID := generateRunID()\r\n\trunDir := filepath.Join(pipelineRunsDir, runID)\r\n\tartifactsDir := filepath.Join(runDir, \"artifacts\")\r\n\tif err := os.MkdirAll(artifactsDir, 0755); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"create run dir: %w\", err)\r\n\t}\r\n\tif cfgData, err := json.MarshalIndent(cfg, \"\", \"  \"); err == nil {\r\n\t\tos.WriteFile(filepath.Join(runDir, \"pipeline_config.json\"), cfgData, 0644)\r\n\t}\r\n"]
[5826.39551, "o", "\r\n\tnow := time.Now()\r\n\trun := &PipelineRun{\r\n\t\tID:         runID,\r\n\t\tPipeline:   cfg.Name,\r\n\t\tStatus:     \"running\",\r\n\t\tParameters: merged,\r\n\t\tStartTime:  &now,\r\n\t\tRunDir:     runDir,\r\n"]
[5826.395571, "o", "\t\tVariables:  copyMap(merged),\r\n\t\tWarnings:   []string{},\r\n\t\tSteps:      make([]*StepRun, 0, len(cfg.Steps)),\r\n\t}\r\n\tfor _, step := range cfg.Steps {\r\n\t\trun.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: \"pending\"})\r\n\t}\r\n\tsaveRun(run)\r\n\r\n\terr := executeSteps(cfg, run, tracker, merged, maxParallel)\r\n"]
[5826.395633, "o", "\tendTime := time.Now()\r\n\trun.EndTime = &endTime\r\n\tif err != nil {\r\n\t\trun.Status = \"failed\"\r\n\t} else if run.Status != \"succeeded_with_warnings\" {\r\n\t\trun.Status = \"succeeded\"\r\n\t}\r\n\tsaveRun(run)\r\n\treturn run, err\r\n}\r\n\r\n"]
[5826.395699, "o", "func executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n\tstepByName := make(map[string]*PipelineStep)\r\n\tfor _, s := range cfg.Steps {\r\n\t\tstepByName[s.Name] = s\r\n\t}\r\n"]
[5826.39576, "o", "\trunStepByName := make(map[string]*StepRun)\r\n\tfor _, sr := range run.Steps {\r\n\t\trunStepByName[sr.Name] = sr\r\n\t}\r\n\r\n\tvariables := make(map[string]string)\r\n\tif run.Variables != nil {\r\n\t\tfor k, v := range run.Variables {\r\n\t\t\tvariables[k] = v\r\n\t\t}\r\n\t} else {\r\n\t\tfor k, v := range params {\r\n\t\t\tvariables[k] = v\r\n\t\t}\r\n\t}\r\n"]
[5826.395826, "o", "\tif run.Warnings == nil {\r\n\t\trun.Warnings = []string{}\r\n\t}\r\n\r\n\tvar varMu sync.Mutex\r\n\r\n"]
[5826.39589, "o", "\tfor _, step := range cfg.Steps {\r\n\t\tsr := runStepByName[step.Name]\r\n\t\tif sr != nil && (sr.Status == \"succeeded\" || sr.Status == \"skipped\") {\r\n\t\t\tvariables[\"steps.\"+step.Name+\".status\"] = sr.Status\r\n\t\t\tvariables[\"steps.\"+step.Name+\".output\"] = stepRunOutputValue(sr)\r\n\t\t\tvariables[\"steps.\"+step.Name+\".duration\"] = stepRunDurationValue(sr)\r\n\t\t}\r\n\t}\r\n\r\n\tvar mu sync.Mutex\r\n\tvar running []*PipelineStep\r\n\tavailable := make(chan struct{}, maxParallel)\r\n\r\n\tpending := make(map[string]bool)\r\n\tfor _, step := range cfg.Steps {\r\n"]
[5826.395958, "o", "\t\tsr := runStepByName[step.Name]\r\n\t\tif sr.Status == \"succeeded\" || sr.Status == \"skipped\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif sr.Status == \"failed\" {\r\n\t"]
[5826.396027, "o", "\t\tsr.Status = \"pending\"\r\n\t\t\tsr.Error = \"\"\r\n\t\t\tsr.Output = \"\"\r\n\t\t\tsr.StartTime = nil\r\n\t\t\tsr.EndTime = nil\r\n\t\t}\r\n\t\tpending[step.Name] = true\r\n\t}\r\n\r\n\tvar wg sync.WaitGroup\r\n\tdone := false\r\n\r\n"]
[5826.396102, "o", "\tcanStart := func(step *PipelineStep) bool {\r\n\t\tfor _, dep := range step.DependsOn {\r\n\t\t\tstatus := runStepByName[dep].Status\r\n\t\t\tif status == \"succeeded\" || status == \"skipped\" {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif status == \"failed\" {\r\n\t\t\t\tif depStep := stepByName[dep]; depStep != nil && depStep.AllowFailure {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\treturn false\r\n\t\t}\r\n\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n\t"]
[5826.396165, "o", "\t\tvar cpu, mem int\r\n\t\t\tfor _, r := range running {\r\n\t\t\t\tif r.Resources != nil {\r\n\t\t\t\t\tcpu += r.Resources.CPU\r\n\t\t\t\t\tmem += r.Resources.MemoryMB\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n"]
[5826.396224, "o", "\t\t\t\treturn false\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn true\r\n\t}\r\n\r\n\tstartStep := func(step *PipelineStep) {\r\n\t\tpending[step.Name] = false\r\n\t\trunning = append(running, step)\r\n"]
