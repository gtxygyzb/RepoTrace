[1986.503217, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[1986.503275, "o", "\u001b[?2004h> "]
[1986.503405, "o", "\\t\\t\\treturn token\r\n\u001b[?2004l\r"]
[1986.503457, "o", "\u001b[?2004h> "]
[1986.503521, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.503577, "o", "\u001b[?2004h> "]
[1986.50378, "o", "\\t\\tif captureNames[name] {\r\n\u001b[?2004l\r"]
[1986.503834, "o", "\u001b[?2004h> "]
[1986.503972, "o", "\\t\\t\\treturn token\r\n\u001b[?2004l\r"]
[1986.504028, "o", "\u001b[?2004h> "]
[1986.504104, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.50416, "o", "\u001b[?2004h> "]
[1986.504397, "o", "\\t\\tif val, ok := params[name]; ok {\r\n\u001b[?2004l\r"]
[1986.504458, "o", "\u001b[?2004h> "]
[1986.504577, "o", "\\t\\t\\treturn val\r\n\u001b[?2004l\r"]
[1986.504631, "o", "\u001b[?2004h> "]
[1986.504691, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.504746, "o", "\u001b[?2004h> "]
[1986.504889, "o", "\\t\\tif hasDefault {\r\n\u001b[?2004l\r"]
[1986.504944, "o", "\u001b[?2004h> "]
[1986.505113, "o", "\\t\\t\\treturn defaultVal\r\n\u001b[?2004l\r"]
[1986.505171, "o", "\u001b[?2004h> "]
[1986.505227, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.505282, "o", "> "]
[1986.505391, "o", "\\t\\tif firstErr == nil {\r\n\u001b[?2004l\r"]
[1986.505446, "o", "\u001b[?2004h> "]
[1986.505767, "o", "\\t\\t\\tfirstErr = fmt.Errorf(\"unresolved variable: %s\", token)\r\n\u001b[?2004l\r"]
[1986.505825, "o", "\u001b[?2004h> "]
[1986.505879, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.505989, "o", "\\t\\treturn token\r\n\u001b[?2004l\r"]
[1986.506052, "o", "\u001b[?2004h> "]
[1986.506111, "o", "\\t})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.506249, "o", "\\tif firstErr != nil {\r\n\u001b[?2004l\r"]
[1986.506304, "o", "\u001b[?2004h> "]
[1986.506451, "o", "\\t\\treturn result, firstErr\r\n\u001b[?2004l\r"]
[1986.506507, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.506561, "o", "\u001b[?2004h> "]
[1986.506681, "o", "\\treturn result, nil\r\n\u001b[?2004l\r"]
[1986.506736, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1986.50679, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.506844, "o", "\u001b[?2004h> "]
[1986.507214, "o", "func splitVariableDefault(content string) (string, string, bool) {\r\n\u001b[?2004l\r"]
[1986.507271, "o", "\u001b[?2004h> "]
[1986.507596, "o", "\\tif idx := strings.Index(content, \":-\"); idx >= 0 {\r\n\u001b[?2004l\r"]
[1986.507651, "o", "\u001b[?2004h> "]
[1986.507901, "o", "\\t\\treturn content[:idx], content[idx+2:], true\r\n\u001b[?2004l\r"]
[1986.507956, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.508003, "o", "\u001b[?2004h> "]
[1986.508194, "o", "\\treturn content, \"\", false\r\n\u001b[?2004l\r"]
[1986.50825, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1986.508305, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.508359, "o", "\u001b[?2004h> "]
[1986.508744, "o", "func evaluateCondition(cond string, vars map[string]string) (bool, error) {\r\n\u001b[?2004l\r"]
[1986.5088, "o", "\u001b[?2004h> "]
[1986.508958, "o", "\\tcond = strings.TrimSpace(cond)\r\n\u001b[?2004l\r"]
[1986.509013, "o", "\u001b[?2004h> "]
[1986.509108, "o", "\\tif cond == \"\" {\r\n\u001b[?2004l\r"]
[1986.509163, "o", "\u001b[?2004h> "]
[1986.50927, "o", "\\t\\treturn true, nil\r\n\u001b[?2004l\r"]
[1986.509327, "o", "\u001b[?2004h> "]
[1986.509384, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.509588, "o", "\\tif strings.Contains(cond, \"==\") {\r\n\u001b[?2004l\r"]
[1986.509644, "o", "\u001b[?2004h> "]
[1986.509862, "o", "\\t\\tparts := strings.SplitN(cond, \"==\", 2)\r\n\u001b[?2004l\r"]
[1986.509917, "o", "\u001b[?2004h> "]
[1986.510326, "o", "\\t\\tleft, err := substituteVariables(strings.TrimSpace(parts[0]), vars)\r\n\u001b[?2004l\r"]
[1986.510383, "o", "\u001b[?2004h> "]
[1986.51049, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[1986.510536, "o", "\u001b[?2004h> "]
[1986.510692, "o", "\\t\\t\\treturn false, err\r\n\u001b[?2004l\r"]
[1986.510747, "o", "\u001b[?2004h> "]
[1986.510801, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.510856, "o", "> "]
[1986.511216, "o", "\\t\\tright, err := substituteVariables(strings.TrimSpace(parts[1]), vars)\r\n\u001b[?2004l\r"]
[1986.511273, "o", "\u001b[?2004h> "]
[1986.511381, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[1986.511435, "o", "\u001b[?2004h> "]
[1986.51156, "o", "\\t\\t\\treturn false, err\r\n\u001b[?2004l\r"]
[1986.511615, "o", "\u001b[?2004h> "]
[1986.511671, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.511839, "o", "\\t\\treturn left == right, nil\r\n\u001b[?2004l\r"]
[1986.511894, "o", "\u001b[?2004h> \\t}\r\n"]
[1986.511949, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1986.512149, "o", "\\tif strings.Contains(cond, \"!=\") {\r\n\u001b[?2004l\r"]
[1986.512206, "o", "\u001b[?2004h> "]
[1986.512436, "o", "\\t\\tparts := strings.SplitN(cond, \"!=\", 2)\r\n\u001b[?2004l\r"]
[1986.51249, "o", "\u001b[?2004h> "]
[1986.512842, "o", "\\t\\tleft, err := substituteVariables(strings.TrimSpace(parts[0]), vars)\r\n\u001b[?2004l\r"]
[1986.5129, "o", "\u001b[?2004h> "]
[1986.513008, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[1986.51308, "o", "\u001b[?2004h> "]
[1986.513195, "o", "\\t\\t\\treturn false, err\r\n\u001b[?2004l\r"]
[1986.513249, "o", "\u001b[?2004h> \\t\\t}\r\n"]
[1986.513304, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1986.513774, "o", "\\t\\tright, err := substituteVariables(strings.TrimSpace(parts[1]), vars)\r\n\u001b[?2004l\r"]
[1986.513829, "o", "\u001b[?2004h> "]
[1986.513916, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[1986.51397, "o", "\u001b[?2004h> "]
[1986.514119, "o", "\\t\\t\\treturn false, err\r\n\u001b[?2004l\r"]
[1986.514175, "o", "\u001b[?2004h> "]
[1986.514234, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.514289, "o", "> "]
[1986.514412, "o", "\\t\\treturn left != right, nil\r\n\u001b[?2004l\r"]
[1986.514468, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.514517, "o", "\u001b[?2004h> "]
[1986.514889, "o", "\\treturn false, fmt.Errorf(\"invalid condition: %s\", cond)\r\n\u001b[?2004l\r"]
[1986.51495, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1986.515003, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[1986.515076, "o", "\u001b[?2004h> "]
[1986.515308, "o", "assert old in s, \"substitution block not found\"\r\n\u001b[?2004l\r"]
[1986.515364, "o", "\u001b[?2004h> "]
[1986.515465, "o", "s = s.replace(old, new, 1)\r\n\u001b[?2004l\r"]
[1986.515521, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.515656, "o", "# Add Variables to checkpoint save\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.515712, "o", "> "]
[1986.51579, "o", "old = '''\\tcp := &Checkpoint{\r\n\u001b[?2004l\r"]
[1986.515846, "o", "\u001b[?2004h> "]
[1986.515921, "o", "\\t\\tRunID:      run.ID,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.51598, "o", "> "]
[1986.516059, "o", "\\t\\tStatus:     run.Status,\r\n\u001b[?2004l\r"]
[1986.516116, "o", "\u001b[?2004h> "]
[1986.516203, "o", "\\t\\tParameters: run.Parameters,\r\n\u001b[?2004l\r"]
[1986.516258, "o", "\u001b[?2004h> "]
[1986.516324, "o", "\\t\\tSteps:      run.Steps,\r\n\u001b[?2004l\r"]
[1986.516379, "o", "\u001b[?2004h> "]
[1986.516473, "o", "\\t\\tArtifacts:  run.Artifacts,\r\n\u001b[?2004l\r"]
[1986.516527, "o", "\u001b[?2004h> \\t}'''\r\n\u001b[?2004l\r"]
[1986.516581, "o", "\u001b[?2004h> "]
[1986.516672, "o", "new = '''\\tcp := &Checkpoint{\r\n\u001b[?2004l\r"]
[1986.516727, "o", "\u001b[?2004h> "]
[1986.516798, "o", "\\t\\tRunID:      run.ID,\r\n\u001b[?2004l\re\u001b[?2004h"]
[1986.516852, "o", "> "]
[1986.516924, "o", "\\t\\tStatus:     run.Status,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.516979, "o", "> "]
[1986.517076, "o", "\\t\\tParameters: run.Parameters,\r\n\u001b[?2004l\r"]
[1986.51713, "o", "\u001b[?2004h> "]
[1986.517205, "o", "\\t\\tSteps:      run.Steps,\r\n\u001b[?2004l\r"]
[1986.517259, "o", "\u001b[?2004h> "]
[1986.517362, "o", "\\t\\tArtifacts:  run.Artifacts,\r\n\u001b[?2004l\r"]
[1986.517417, "o", "\u001b[?2004h> "]
[1986.517507, "o", "\\t\\tVariables:  run.Variables,\r\n\u001b[?2004l\r"]
[1986.517562, "o", "\u001b[?2004h> \\t}'''\r\n\u001b[?2004l\r"]
[1986.517618, "o", "\u001b[?2004h> "]
[1986.517668, "o", "assert old in s\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[1986.517797, "o", "s = s.replace(old, new, 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.517851, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.518063, "o", "# Add helper functions before buildArtifactManifest\r\n\u001b[?2004l\r"]
[1986.518119, "o", "\u001b[?2004h> "]
[1986.51845, "o", "old = \"func buildArtifactManifest(run *PipelineRun, cfg *PipelineConfig) map[string]interface{} {\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.518506, "o", "> "]
[1986.518713, "o", "helpers = '''func copyMap(in map[string]string) map[string]string {\r\n\u001b[?2004l\r"]
[1986.518769, "o", "\u001b[?2004h> "]
[1986.518901, "o", "\\tout := make(map[string]string, len(in))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.518956, "o", "> "]
[1986.519026, "o", "\\tfor k, v := range in {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.519091, "o", "> "]
[1986.519147, "o", "\\t\\tout[k] = v\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n"]
[1986.519201, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1986.51925, "o", "\\treturn out\r\n\u001b[?2004l\r\\\u001b[?2004h"]
[1986.519304, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.519358, "o", "\u001b[?2004h> "]
[1986.51967, "o", "func captureOutputValue(step *PipelineStep, stdout string) (string, bool, error) {\r\n\u001b[?2004l\r"]
[1986.519725, "o", "\u001b[?2004h> "]
[1986.519817, "o", "\\tif step.CaptureOutput == nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.519873, "o", "> "]
[1986.519947, "o", "\\t\\treturn \"\", false, nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.520002, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.520158, "o", "\\tif step.CaptureOutput.Regex == \"\" {\r\n\u001b[?2004l\r"]
[1986.520214, "o", "\u001b[?2004h> "]
[1986.520368, "o", "\\t\\treturn strings.TrimSpace(stdout), true, nil\r\n\u001b[?2004l\r"]
[1986.520423, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.520477, "o", "> "]
[1986.520648, "o", "\\tre, err := regexp.Compile(step.CaptureOutput.Regex)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.520704, "o", "> "]
[1986.520757, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.520816, "o", "> "]
[1986.521096, "o", "\\t\\treturn \"\", false, fmt.Errorf(\"step %s capture_output regex: %w\", step.Name, err)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.521156, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.521308, "o", "\\tm := re.FindStringSubmatch(stdout)\r\n\u001b[?2004l\r"]
[1986.521364, "o", "\u001b[?2004h> "]
[1986.521451, "o", "\\tif m == nil || len(m) < 2 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.521506, "o", "> "]
[1986.521576, "o", "\\t\\treturn \"\", false, nil\r\n\u001b[?2004l\r"]
[1986.521631, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.521686, "o", "> "]
[1986.521766, "o", "\\treturn m[1], true, nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.521821, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.521875, "o", "\u001b[?2004h> "]
[1986.521946, "o", "type DryRunStep struct {\r\n\u001b[?2004l\r"]
[1986.522001, "o", "\u001b[?2004h> "]
[1986.52213, "o", "\\tName           string   `json:\"name\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.522185, "o", "> "]
[1986.522299, "o", "\\tType           string   `json:\"type\"`\r\n\u001b[?2004l\r"]
[1986.522354, "o", "\u001b[?2004h> "]
[1986.522547, "o", "\\tResolvedCommand string   `json:\"resolved_command\"`\r\n\u001b[?2004l\r"]
[1986.522603, "o", "\u001b[?2004h> "]
[1986.522751, "o", "\\tStatus         string   `json:\"status\"`\r\n\u001b[?2004l\r"]
[1986.522808, "o", "\u001b[?2004h> "]
[1986.522948, "o", "\\tDependsOn      []string `json:\"depends_on\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.523004, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.523066, "o", "\u001b[?2004h> "]
[1986.523415, "o", "func dryRunPipeline(cfg *PipelineConfig, params map[string]string) (map[string]interface{}, error) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.523472, "o", "> "]
[1986.523628, "o", "\\tif err := validatePipelineConfig(cfg); err != nil {\r\n\u001b[?2004l\r"]
[1986.523685, "o", "\u001b[?2004h> "]
[1986.523736, "o", "\\t\\treturn nil, err\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.523791, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.523974, "o", "\\tmerged := mergeParams(cfg.Parameters, params)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.524028, "o", "> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[1986.52418, "o", "\\tcaptureNames := make(map[string]bool)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.52424, "o", "> "]
[1986.524339, "o", "\\tfor _, step := range cfg.Steps {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.524397, "o", "> "]
[1986.524605, "o", "\\t\\tif step.CaptureOutput != nil && step.CaptureOutput.Name != \"\" {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.524662, "o", "> "]
[1986.524817, "o", "\\t\\t\\tcaptureNames[step.CaptureOutput.Name] = true\r\n\u001b[?2004l\r"]
[1986.524874, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[1986.524929, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.524982, "o", "> \r\n\u001b[?2004l\rS\u001b[?2004h> "]
[1986.525124, "o", "\\tstatus := make(map[string]string)\r\n\u001b[?2004l\r"]
[1986.52518, "o", "\u001b[?2004h> "]
[1986.525295, "o", "\\tassigned := make(map[string]bool)\r\n\u001b[?2004l\ru\u001b[?2004h"]
[1986.525351, "o", "> "]
[1986.525469, "o", "\\tfor len(assigned) < len(cfg.Steps) {\r\n\u001b[?2004l\r"]
[1986.525524, "o", "\u001b[?2004h> "]
[1986.525584, "o", "\\t\\tprogress := false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.52568, "o", "\\t\\tfor _, step := range cfg.Steps {\r\n\u001b[?2004l\r"]
[1986.525736, "o", "\u001b[?2004h> "]
[1986.525789, "o", "\\t\\t\\tif assigned[step.Name] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.525854, "o", "\\t\\t\\t\\tcontinue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.525909, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.525962, "o", "\\t\\t\\tdepsKnown := true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.526058, "o", "\\t\\t\\tfor _, dep := range step.DependsOn {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.526129, "o", "\\t\\t\\t\\tif !assigned[dep] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.526201, "o", "\\t\\t\\t\\t\\tdepsKnown = false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.526255, "o", "\\t\\t\\t\\t\\tbreak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.526314, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r"]
[1986.526371, "o", "\u001b[?2004h> "]
[1986.526439, "o", "\\t\\t\\tif !depsKnown {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\tcontinue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.526501, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.526561, "o", "\\t\\t\\tdepsOk := true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.526659, "o", "\\t\\t\\tfor _, dep := range step.DependsOn {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.526795, "o", "\\t\\t\\t\\tif status[dep] != \"ready\" && status[dep] != \"skipped\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.52686, "o", "\\t\\t\\t\\t\\tdepsOk = false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.526913, "o", "\\t\\t\\t\\t\\tbreak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.526968, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r"]
[1986.527023, "o", "\u001b[?2004h> \\t\\t\\tif !depsOk {\r\n\u001b[?2004l\r"]
[1986.527086, "o", "\u001b[?2004h> "]
[1986.52714, "o", "\\t\\t\\t\\tstatus[step.Name] = \"blocked\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.527207, "o", "\\t\\t\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.527321, "o", "\\t\\t\\t\\tcond, err := evaluateCondition(step.Condition, merged)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.527386, "o", "\\t\\t\\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.527539, "o", "\\t\\t\\t\\t\\treturn nil, fmt.Errorf(\"step %s condition: %w\", step.Name, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.527597, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.527653, "o", "\\t\\t\\t\\tif !cond {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.527727, "o", "\\t\\t\\t\\t\\tstatus[step.Name] = \"skipped\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.527784, "o", "\\t\\t\\t\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.527869, "o", "\\t\\t\\t\\t\\tstatus[step.Name] = \"ready\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.527929, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r"]
[1986.527988, "o", "\u001b[?2004h> "]
[1986.528016, "o", "\\t\\t\\tassigned[step.Name] = true\r\n\u001b[?2004l\r"]
[1986.528037, "o", "\u001b[?2004h> "]
[1986.528095, "o", "\\t\\t\\tprogress = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.528116, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.528138, "o", "\u001b[?2004h> "]
[1986.528183, "o", "\\t\\tif !progress {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.52823, "o", "\\t\\t\\tbreak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.528251, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.528273, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.528294, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.528315, "o", "\u001b[?2004h> "]
[1986.590292, "o", "\\tsteps := make([]map[string]interface{}, 0, len(cfg.Steps))\r\n\u001b[?2004l\r\u001b[?2004h> \\tfor _, step := range cfg.Steps {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tresolved, err := substituteStaticForDryRun(step.Command, merged, captureNames)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\treturn nil, fmt.Errorf(\"step %s command: %w\", step.Name, err)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tdeps := make([]string, 0, len(step.DependsOn))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.590385, "o", "\\t\\tdeps = append(deps, step.DependsOn...)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.590502, "o", "> "]
[1986.59056, "o", "\\t\\tif deps == nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.590615, "o", "> "]
[1986.590727, "o", "\\t\\t\\tdeps = []string{}\r\n\u001b[?2004l\r"]
[1986.590782, "o", "\u001b[?2004h> "]
[1986.590836, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.59089, "o", "\u001b[?2004h> "]
[1986.591053, "o", "\\t\\tst := status[step.Name]\r\n\u001b[?2004l\r"]
[1986.591109, "o", "\u001b[?2004h> "]
[1986.591217, "o", "\\t\\tif st == \"\" {\r\n\u001b[?2004l\r"]
[1986.591271, "o", "\u001b[?2004h> "]
[1986.591398, "o", "\\t\\t\\tst = \"blocked\"\r\n\u001b[?2004l\r"]
[1986.591453, "o", "\u001b[?2004h> "]
[1986.591507, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.591562, "o", "\u001b[?2004h> "]
[1986.591829, "o", "\\t\\tsteps = append(steps, map[string]interface{}{\r\n\u001b[?2004l\r"]
[1986.591883, "o", "\u001b[?2004h> "]
[1986.592102, "o", "\\t\\t\\t\"name\":            step.Name,\r\n\u001b[?2004l\r"]
[1986.592157, "o", "\u001b[?2004h> "]
[1986.592361, "o", "\\t\\t\\t\"type\":            step.Type,\r\n\u001b[?2004l\r"]
[1986.592416, "o", "\u001b[?2004h> "]
[1986.592625, "o", "\\t\\t\\t\"resolved_command\": resolved,\r\n\u001b[?2004l\r"]
[1986.592681, "o", "\u001b[?2004h> "]
[1986.592847, "o", "\\t\\t\\t\"status\":          st,\r\n\u001b[?2004l\r"]
[1986.592901, "o", "\u001b[?2004h> "]
[1986.593079, "o", "\\t\\t\\t\"depends_on\":      deps,\r\n\u001b[?2004l\r"]
[1986.593146, "o", "\u001b[?2004h> "]
[1986.593204, "o", "\\t\\t})\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.593257, "o", "> \\t}\r\n\u001b[?2004l\r"]
[1986.593316, "o", "\u001b[?2004h> "]
[1986.593631, "o", "\\treturn map[string]interface{}{\"steps\": steps}, nil\r\n\u001b[?2004l\r"]
[1986.593686, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1986.593743, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.593803, "o", "\u001b[?2004h> "]
[1986.594223, "o", "func buildPipelineGraph(cfg *PipelineConfig) map[string]interface{} {\r\n\u001b[?2004l\r"]
[1986.59428, "o", "\u001b[?2004h> "]
[1986.594595, "o", "\\tnodes := make([]map[string]string, 0, len(cfg.Steps))\r\n\u001b[?2004l\r"]
[1986.59465, "o", "\u001b[?2004h> "]
[1986.594829, "o", "\\tfor _, s := range cfg.Steps {\r\n\u001b[?2004l\r"]
[1986.594882, "o", "\u001b[?2004h> "]
[1986.595322, "o", "\\t\\tnodes = append(nodes, map[string]string{\"name\": s.Name, \"type\": s.Type})\r\n\u001b[?2004l\r"]
[1986.595382, "o", "\u001b[?2004h> "]
[1986.595437, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.59549, "o", "> \r\n\u001b[?2004l\r"]
[1986.595546, "o", "\u001b[?2004h> "]
[1986.595759, "o", "\\tedges := make([]map[string]string, 0)\r\n\u001b[?2004l\r"]
[1986.595813, "o", "\u001b[?2004h> "]
[1986.595999, "o", "\\tfor _, s := range cfg.Steps {\r\n\u001b[?2004l\r"]
[1986.596062, "o", "\u001b[?2004h> "]
[1986.596281, "o", "\\t\\tfor _, dep := range s.DependsOn {\r\n\u001b[?2004l\r"]
[1986.596336, "o", "\u001b[?2004h> "]
[1986.596751, "o", "\\t\\t\\tedges = append(edges, map[string]string{\"from\": dep, \"to\": s.Name})\r\n\u001b[?2004l\r"]
[1986.596806, "o", "\u001b[?2004h> "]
[1986.59686, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.596915, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.596975, "o", "\u001b[?2004h> \r\n"]
[1986.59703, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1986.597095, "o", "> "]
[1986.59725, "o", "\\treturn map[string]interface{}{\r\n\u001b[?2004l\r"]
[1986.597308, "o", "\u001b[?2004h> "]
[1986.59743, "o", "\\t\\t\"nodes\":  nodes,\r\n\u001b[?2004l\r"]
[1986.597484, "o", "\u001b[?2004h> "]
[1986.597609, "o", "\\t\\t\"edges\":  edges,\r\n\u001b[?2004l\r"]
[1986.597657, "o", "\u001b[?2004h> "]
[1986.597896, "o", "\\t\\t\"levels\": computeLevels(cfg.Steps),\r\n\u001b[?2004l\r"]
[1986.597952, "o", "\u001b[?2004h> "]
[1986.598006, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.598092, "o", "> }\r\n\u001b[?2004l\r"]
[1986.598146, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.598204, "o", "\u001b[?2004h> "]
[1986.598513, "o", "func computeLevels(steps []*PipelineStep) [][]string {\r\n\u001b[?2004l\r"]
[1986.598564, "o", "\u001b[?2004h> "]
[1986.598786, "o", "\\tassigned := make(map[string]bool)\r\n\u001b[?2004l\r"]
[1986.598841, "o", "\u001b[?2004h> "]
[1986.59898, "o", "\\tvar levels [][]string\r\n\u001b[?2004l\r"]
[1986.599037, "o", "\u001b[?2004h> "]
[1986.599247, "o", "\\tfor len(assigned) < len(steps) {\r\n\u001b[?2004l\r"]
[1986.599302, "o", "\u001b[?2004h> "]
[1986.599436, "o", "\\t\\tvar level []string\r\n\u001b[?2004l\r"]
[1986.599482, "o", "\u001b[?2004h> "]
[1986.599668, "o", "\\t\\tfor _, s := range steps {\r\n\u001b[?2004l\r"]
[1986.599724, "o", "\u001b[?2004h> "]
[1986.599887, "o", "\\t\\t\\tif assigned[s.Name] {\r\n\u001b[?2004l\r"]
[1986.599947, "o", "\u001b[?2004h> "]
[1986.600056, "o", "\\t\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[1986.600117, "o", "\u001b[?2004h> "]
[1986.60018, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[1986.600234, "o", "\u001b[?2004h> "]
[1986.600324, "o", "\\t\\t\\tok := true\r\n\u001b[?2004l\r"]
[1986.600379, "o", "\u001b[?2004h> "]
[1986.600606, "o", "\\t\\t\\tfor _, dep := range s.DependsOn {\r\n\u001b[?2004l\r"]
[1986.600666, "o", "\u001b[?2004h> "]
[1986.600828, "o", "\\t\\t\\t\\tif !assigned[dep] {\r\n\u001b[?2004l\r"]
[1986.600884, "o", "\u001b[?2004h> "]
[1986.601009, "o", "\\t\\t\\t\\t\\tok = false\r\n\u001b[?2004l\r"]
[1986.601074, "o", "\u001b[?2004h> "]
[1986.601167, "o", "\\t\\t\\t\\t\\tbreak\r\n\u001b[?2004l\r"]
[1986.601222, "o", "\u001b[?2004h> "]
[1986.601285, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r"]
[1986.601344, "o", "\u001b[?2004h> "]
[1986.601396, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[1986.60145, "o", "\u001b[?2004h> "]
[1986.601537, "o", "\\t\\t\\tif ok {\r\n\u001b[?2004l\r"]
[1986.601592, "o", "\u001b[?2004h> "]
[1986.60181, "o", "\\t\\t\\t\\tlevel = append(level, s.Name)\r\n\u001b[?2004l\r"]
[1986.601865, "o", "\u001b[?2004h> "]
[1986.601918, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[1986.601977, "o", "\u001b[?2004h> "]
[1986.602031, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.602102, "o", "\u001b[?2004h> "]
[1986.602229, "o", "\\t\\tif len(level) == 0 {\r\n\u001b[?2004l\r"]
[1986.602283, "o", "\u001b[?2004h> "]
[1986.602359, "o", "\\t\\t\\tbreak\r\n\u001b[?2004l\r"]
[1986.602423, "o", "\u001b[?2004h> "]
[1986.602478, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.602532, "o", "> "]
[1986.602652, "o", "\\t\\tsort.Strings(level)\r\n\u001b[?2004l\r"]
[1986.602707, "o", "\u001b[?2004h> "]
[1986.602883, "o", "\\t\\tfor _, n := range level {\r\n\u001b[?2004l\r"]
[1986.602928, "o", "\u001b[?2004h> "]
[1986.603094, "o", "\\t\\t\\tassigned[n] = true\r\n\u001b[?2004l\r"]
[1986.603151, "o", "\u001b[?2004h> "]
[1986.603206, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.60326, "o", "\u001b[?2004h> "]
[1986.603446, "o", "\\t\\tlevels = append(levels, level)\r\n\u001b[?2004l\r"]
[1986.603511, "o", "\u001b[?2004h> "]
[1986.603566, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.603622, "o", "> "]
[1986.603687, "o", "\\treturn levels\r\n\u001b[?2004l\r"]
[1986.603731, "o", "\u001b[?2004h> "]
[1986.603789, "o", "}\r\n\u001b[?2004l\r"]
[1986.603847, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.603902, "o", "\u001b[?2004h> "]
[1986.604092, "o", "type PipelineHistoryEntry struct {\r\n\u001b[?2004l\r"]
[1986.604148, "o", "\u001b[?2004h> "]
[1986.604383, "o", "\\tID              string     `json:\"id\"`\r\n\u001b[?2004l\r"]
[1986.604438, "o", "\u001b[?2004h> "]
[1986.604694, "o", "\\tStatus          string     `json:\"status\"`\r\n\u001b[?2004l\r"]
[1986.604741, "o", "\u001b[?2004h> "]
[1986.605094, "o", "\\tStartTime       *time.Time `json:\"start_time,omitempty\"`\r\n\u001b[?2004l\r"]
[1986.60515, "o", "\u001b[?2004h> "]
[1986.605473, "o", "\\tEndTime         *time.Time `json:\"end_time,omitempty\"`\r\n\u001b[?2004l\r"]
[1986.605521, "o", "\u001b[?2004h> "]
[1986.60584, "o", "\\tDurationSeconds float64    `json:\"duration_seconds\"`\r\n\u001b[?2004l\r"]
