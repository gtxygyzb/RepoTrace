[43.273205, "o", "os.Exit(1)\r\n    17\t\t}\r\n    18\t\r\n    19\t\tstore, err := NewStore(dataDir)\r\n    20\t\tif err != nil {\r\n    21\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n    22\t\t\tos.Exit(1)\r\n    23\t\t}\r\n    24\t\r\n    25\t\tregistry := NewRegistry(store)\r\n    26\t\ttracker := NewTracker(store)\r\n    27\t\r\n    28\t\tswitch os.Args[1] {\r\n    29\t\tcase \"model\":\r\n    30\t\t\thandleModel(registry, os.Args[2:])\r\n    31\t\tcase \"experiment\":\r\n    32\t\t\thandleExperiment(tracker, os.Args[2:])\r\n    33\t\tcase \"dataset\":\r\n    34\t\t\thandleDataset(store, os.Args[2:])\r\n    35"]
