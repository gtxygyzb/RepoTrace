[6198.364564, "o", "\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KexecuteSteps\u001b[m\u001b[K(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\trunStepByName := make(map[string]*\u001b[01;31m\u001b[KStepRun\u001b[m\u001b[K)\r\n\u001b[35m\u001b[K./pipeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K440\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KexecuteStep\u001b[m\u001b[K(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])\r\n"]
