[1986.42346, "o", "\\tcmd.Stdout = &out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.423529, "o", "\\tcmd.Stderr = &out\r\n\u001b[?2004l\r"]
[1986.423584, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.423648, "o", "assert old in s\r\n\u001b[?2004l\r\u001b[?2004h> "]
