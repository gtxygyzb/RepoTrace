[744.798187, "o", "func resumePipeline(runID string, tracker *Tracker) (*PipelineRun, error) {\r\nrun, err := loadRun(runID)\r\nif err != nil {\r\nreturn nil, err\r\n}\r\ncpPath := filepath.Join(run.RunDir, \"checkpoint.json\")\r\ncpData, err := os.ReadFile(cpPath)\r\n"]
[744.798298, "o", "if err == nil {\r\nvar cp Checkpoint\r\nif json.Unmarshal(cpData, &cp) == nil {\r\nrun.Status = cp.Status\r\nrun.Parameters = cp.Parameters\r\nrun.Steps = cp.Steps\r\nrun.Artifacts = cp.Artifacts\r\n}\r\n}\r\n\r\ncfgPath := filepath.Join(run.RunDir, \"pipeline_config.json\")\r\nvar cfg *PipelineConfig\r\nif cfgData, err := os.ReadFile(cfgPath); err == nil {\r\nvar c PipelineConfig\r\nif json.Unmarshal(cfgData, &c) == nil {\r\ncfg = &c\r\n}\r\n}\r\nif cfg == nil {\r\nreturn nil, fmt.Errorf(\"pipeline config not found for run %s\", runID)\r\n}\r\n\r\nrun.Status = \"running\"\r\n"]
[744.798403, "o", "saveRun(run)\r\n\r\nerr = executeSteps(cfg, run, tracker, run.Parameters, cfg.MaxParallel)\r\nendTime := time.Now()\r\nrun.EndTime = &endTime\r\nif err != nil {\r\nrun.Status = \"failed\"\r\n} else {\r\nrun.Status = \"succeeded\"\r\n}\r\n"]
[744.798551, "o", "saveRun(run)\r\nreturn run, err\r\n}\r\n\r\nfunc buildArtifactManifest(run *PipelineRun) map[string]interface{} {\r\nmanifest := map[string]interface{}{\r\n\"artifacts\": run.Artifacts,\r\n}\r\nlineage := make(map[string][]string)\r\ncfgStepsByName := make(map[string]*StepRun)\r\nfor _, sr := range run.Steps {\r\ncfgStepsByName[sr.Name] = sr\r\n}\r\nfor _, art := range run.Artifacts {\r\nvar consumers []string\r\n// We do not have the original config here; derive from run outputs is not possible.\r\n_ = cfgStepsByName\r\nlineage[art.Name] = consumers\r\n}\r\n"]
[744.798633, "o", "manifest[\"lineage\"] = lineage\r\nreturn manifest\r\n}\r\n"]
[744.798906, "o", "\u001b[?2004h"]
