[1986.418585, "o", "\\t\\t\\t\\tif ok {\r\n\u001b[?2004l\r"]
[1986.418642, "o", "\u001b[?2004h> "]
[1986.418716, "o", "\\t\\t\\t\\t\\tvarMu.Lock()\r\n\u001b[?2004l\r"]
[1986.41877, "o", "\u001b[?2004h> "]
