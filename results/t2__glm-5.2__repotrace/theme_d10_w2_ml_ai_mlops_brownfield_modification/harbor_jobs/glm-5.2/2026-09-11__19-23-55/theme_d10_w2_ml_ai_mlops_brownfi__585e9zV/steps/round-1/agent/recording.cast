[1986.306956, "o", "\u001b[?2004h> "]
[1986.307359, "o", "\\tif err := json.Unmarshal(data, &raw); err != nil {\r\n\u001b[?2004l\r"]
[1986.307422, "o", "\u001b[?2004h> "]
