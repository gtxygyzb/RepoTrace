[5806.91353, "o", "\t\t}\r\n\t\tlevels = append(levels, level)\r\n\t}\r\n\treturn levels\r\n}\r\n\r\ntype PipelineHistoryEntry struct {\r\n\tID              string     `json:\"id\"`\r\n"]
[5806.913632, "o", "\tStatus          string     `json:\"status\"`\r\n\tStartTime       *time.Time `json:\"start_time,omitempty\"`\r\n\tEndTime         *time.Time `json:\"end_time,omitempty\"`\r\n\tDurationSeconds float64    `json:\"duration_seconds\"`\r\n}\r\n\r\nfunc pipelineHistory(name, status string) []PipelineHistoryEntry {\r\n\truns := listRuns()\r\n\tout := make([]PipelineHistoryEntry, 0)\r\n\tfor _, run := range runs {\r\n\t\tif run.Pipeline != name {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif status != \"\" && run.Status != status {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tduration := 0.0\r\n\t\tif run.StartTime != nil && run.EndTime != nil {\r\n"]
[5806.913714, "o", "\t\t\tduration = run.EndTime.Sub(*run.StartTime).Seconds()\r\n\t\t}\r\n\t\tout = append(out, PipelineHistoryEntry{\r\n\t\t\tID:              run.ID,\r\n\t\t\tStatus:          run.Status,\r\n\t\t\tStartTime:       run.StartTime,\r\n"]
[5806.913783, "o", "\t\t\tEndTime:         run.EndTime,\r\n\t\t\tDurationSeconds: duration,\r\n\t\t})\r\n\t}\r\n\tsort.Slice(out, func(i, j int) bool {\r\n\t\tif out[i].StartTime == nil || out[j].StartTime == nil {\r\n\t\t\treturn out[i].ID > out[j].ID\r\n\t\t}\r\n\t\treturn out[i].StartTime.After(*out[j].StartTime)\r\n\t})\r\n\treturn out\r\n}\r\n\r\nfunc buildArtifactManifest(run *PipelineRun, cfg *PipelineConfig) map[string]interface{} {\r\n\tmanifest := map[string]interface{}{\r\n\t\t\"artifacts\": run.Artifacts,\r\n\t}\r\n"]
[5806.913844, "o", "\tlineage := make(map[string][]string)\r\n\tif cfg != nil {\r\n\t\tfor _, step := range cfg.Steps {\r\n\t\t\tfor _, in := range step.Inputs {\r\n\t\t\t\tlineage[in] = append(lineage[in], step.Name)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tmanifest[\"lineage\"] = lineage\r\n\treturn manifest\r\n}"]
[5806.913901, "o", "\r\n"]
