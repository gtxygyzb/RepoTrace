[1529.987749, "o", "   667\tfunc mergeParams(defaults, overrides map[string]string) map[string]string {\r\n   668\t\tmerged := make(map[string]string)\r\n   669\t\tfor k, v := range defaults {\r\n   670\t\t\tmerged[k] = v\r\n   671\t\t}\r\n"]
