[3652.465107, "i", "python3 - <<'PY'\nimport json\nwith open('/tmp/nexus_allow_failure_output.json') as f:\n    run = json.load(f)\nprint(json.dumps({\n    \"status\": run.get(\"status\"),\n    \"warnings\": run.get(\"warnings\"),\n    \"steps\": {s[\"name\"]: s[\"status\"] for s in run.get(\"steps\", [])},\n    \"variables\": run.get(\"variables\")\n}, indent=2))\nassert run[\"status\"] == \"succeeded_with_warnings\", run[\"status\"]\nassert run[\"warnings\"] == [\"metrics\"], run[\"warnings\"]\nsteps = {s[\"name\"]: s[\"status\"] for s in run[\"steps\"]}\nassert steps[\"metrics\"] == \"failed\", steps\nassert steps[\"downstream\"] == \"succeeded\", steps\nassert steps[\"notify\"] == \"succeeded\", steps\nassert steps[\"cleanup\"] == \"succeeded\", steps\nassert run[\"variables\"].get(\"steps.metrics.status\") == \"failed\", run[\"variables\"]\nprint(\"smoke test passed\")\nPY\n"]
