[4064.59246, "o", "\u001b[32m\u001b[K341\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc executeStep\u001b[m\u001b[Ks(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n\u001b[32m\u001b[K342\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tstepByName := make(map[string]*PipelineStep)\r\n\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, s := range cfg.Steps {\r\n\u001b[32m\u001b[K344\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tstepByName[s.Name] = s\r\n\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[4064.592542, "o", "\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\trunStepByName := make(map[string]*StepRun)\r\n\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, sr := range run.Steps {\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\trunStepByName[sr.Name] = sr\r\n\u001b[32m\u001b[K349\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvariables := make(map[string]string)\r\n\u001b[32m\u001b[K352\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif run.Variables != nil {\r\n\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor k, v := range run.Variables {\r\n\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tvariables[k] = v\r\n\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n"]
[4064.592611, "o", "\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t} else {\r\n\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor k, v := range params {\r\n\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tvariables[k] = v\r\n\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K360\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K361\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif run.Warnings == nil {\r\n\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\trun.Warnings = []string{}\r\n\u001b[32m\u001b[K363\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[4064.592679, "o", "\u001b[32m\u001b[K364\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K365\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar varMu sync.Mutex\r\n\u001b[32m\u001b[K366\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K367\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, step := range cfg.Steps {\r\n\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsr := runStepByName[step.Name]\r\n\u001b[32m\u001b[K369\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif sr != nil && (sr.Status == \"succeeded\" || sr.Status == \"skipped\") {\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tvariables[\"steps.\"+step.Name+\".status\"] = sr.Status\r\n\u001b[32m\u001b[K371\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[4064.592738, "o", "\u001b[32m\u001b[K373\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K374\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar mu sync.Mutex\r\n\u001b[32m\u001b[K375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar running []*PipelineStep\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tavailable := make(chan struct{}, maxParallel)\r\n\u001b[32m\u001b[K377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tpending := make(map[string]bool)\r\n\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, step := range cfg.Steps {\r\n"]
[4064.592847, "o", "\u001b[32m\u001b[K380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsr := runStepByName[step.Name]\r\n\u001b[32m\u001b[K381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif sr.Status == \"succeeded\" || sr.Status == \"skipped\" {\r\n\u001b[32m\u001b[K382\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tcontinue\r\n\u001b[32m\u001b[K383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif sr.Status == \"failed\" {\r\n\u001b[32m\u001b[K385\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.Status = \"pending\"\r\n\u001b[32m\u001b[K386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.Error = \"\"\r\n\u001b[32m\u001b[K387\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.Output = \"\"\r\n\u001b[32m\u001b[K388\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.StartTime = nil\r\n\u001b[32m\u001b[K389\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.EndTime = nil\r\n\u001b[32m\u001b[K390\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K391\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tpending[step.Name] = true\r\n\u001b[32m\u001b[K392\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K393\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K394\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar wg sync.WaitGroup\r\n\u001b[32m\u001b[K395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdone := false\r\n\u001b[32m\u001b[K396\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[4064.592916, "o", "\u001b[32m\u001b[K397\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcanStart := func(step *PipelineStep) bool {\r\n\u001b[32m\u001b[K398\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor _, dep := range step.DependsOn {\r\n\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tstatus := runStepByName[dep].Status\r\n\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif status == \"succeeded\" || status == \"skipped\" {\r\n\u001b[32m\u001b[K401\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tcontinue\r\n"]
[4064.592983, "o", "\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif status == \"failed\" {\r\n\u001b[32m\u001b[K404\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tif depStep := stepByName[dep]; depStep != nil && depStep.AllowFailure {\r\n\u001b[32m\u001b[K405\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tcontinue\r\n\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t}\r\n\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn false\r\n\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tvar cpu, mem int\r\n\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tfor _, r := range running {\r\n\u001b[32m\u001b[K413\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tif r.Resources != nil {\r\n"]
[4064.593051, "o", "\u001b[32m\u001b[K414\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tcpu += r.Resources.CPU\r\n\u001b[32m\u001b[K415\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tmem += r.Resources.MemoryMB\r\n\u001b[32m\u001b[K416\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t}\r\n\u001b[32m\u001b[K417\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K418\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\treturn false\r\n"]
[4064.593117, "o", "\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn true\r\n\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K424\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K425\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tstartStep := func(step *PipelineStep) {\r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tpending[step.Name] = false\r\n\u001b[32m\u001b[K427\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\trunning = append(running, step)\r\n"]
[4064.593177, "o", "\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twg.Add(1)\r\n\u001b[32m\u001b[K429\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tgo func(s *PipelineStep) {\r\n\u001b[32m\u001b[K430\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tdefer wg.Done()\r\n\u001b[32m\u001b[K431\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\texecuteStep(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])\r\n\u001b[32m\u001b[K432\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tmu.Lock()\r\n\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\trunning = removeStep(running, s)\r\n\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tstatus := runStepByName[s.Name].Status\r\n\u001b[32m\u001b[K435\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif status == \"failed\" {\r\n\u001b[32m\u001b[K436\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tif s.AllowFailure {\r\n\u001b[32m\u001b[K437\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tif !containsString(run.Warnings, s.Name) {\r\n"]
[4064.593244, "o", "\u001b[32m\u001b[K438\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t\trun.Warnings = append(run.Warnings, s.Name)\r\n\u001b[32m\u001b[K439\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t}\r\n\u001b[32m\u001b[K440\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t} else {\r\n\u001b[32m\u001b[K441\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\trun.Status = \"failed\"\r\n\u001b[32m\u001b[K442\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tdone = true\r\n\u001b[32m\u001b[K443\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t}\r\n\u001b[32m\u001b[K444\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n"]
[4064.593304, "o", "\u001b[32m\u001b[K445\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tvarMu.Lock()\r\n\u001b[32m\u001b[K446\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tvariables[\"steps.\"+s.Name+\".status\"] = status\r\n\u001b[32m\u001b[K447\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\trun.Variables = copyMap(variables)\r\n\u001b[32m\u001b[K448\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tvarMu.Unlock()\r\n\u001b[32m\u001b[K449\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsaveCheckpoint(run)\r\n\u001b[32m\u001b[K450\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsaveRun(run)\r\n\u001b[32m\u001b[K451\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tmu.Unlock()\r\n"]
[4064.593364, "o", "\u001b[32m\u001b[K452\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t<-available\r\n\u001b[32m\u001b[K453\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}(step)\r\n\u001b[32m\u001b[K454\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K455\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K456\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor !done && (len(pending) > 0 || len(running) > 0) {\r\n\u001b[32m\u001b[K457\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tstartedAny := false\r\n\u001b[32m\u001b[K458\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tvar starts []*PipelineStep\r\n\u001b[32m\u001b[K459\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tmu.Lock()\r\n\u001b[32m\u001b[K460\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor _, step := range cfg.Steps {\r\n\u001b[32m\u001b[K461\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif pending[step.Name] && canStart(step) {\r\n\u001b[32m\u001b[K462\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tstarts = append(starts, step)\r\n"]
[4064.593424, "o", "\u001b[32m\u001b[K463\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K464\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K465\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tmu.Unlock()\r\n\u001b[32m\u001b[K466\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })\r\n\u001b[32m\u001b[K467\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor _, step := range starts {\r\n\u001b[32m\u001b[K468\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tavailable <- struct{}{}\r\n\u001b[32m\u001b[K469\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tmu.Lock()\r\n\u001b[32m\u001b[K470\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif done || !pending[step.Name] || !canStart(step) {\r\n\u001b[32m\u001b[K471\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tmu.Unlock()\r\n"]
[4064.593482, "o", "\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K517\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc executeStep\u001b[m\u001b[K(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {\r\n"]
[4064.593541, "o", "\u001b[32m\u001b[K518\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, dep := range step.DependsOn {\r\n\u001b[32m\u001b[K519\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tdepStatus := getRunStep(run, dep).Status\r\n\u001b[32m\u001b[K520\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif depStatus == \"succeeded\" || depStatus == \"skipped\" {\r\n\u001b[32m\u001b[K521\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tcontinue\r\n\u001b[32m\u001b[K522\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K523\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif depStatus == \"failed\" {\r\n"]
[4064.593609, "o", "\u001b[32m\u001b[K524\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tdepStep := getStepConfig(cfg, dep)\r\n\u001b[32m\u001b[K525\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif depStep != nil && depStep.AllowFailure {\r\n\u001b[32m\u001b[K526\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tcontinue\r\n\u001b[32m\u001b[K527\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K528\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K529\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsr.Status = \"failed\"\r\n\u001b[32m\u001b[K530\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsr.Error = \"dependency failed\"\r\n\u001b[32m\u001b[K531\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K532\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K533\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K534\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvarMu.Lock()\r\n"]
[4064.593666, "o", "\u001b[32m\u001b[K535\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvars := copyMap(variables)\r\n\u001b[32m\u001b[K536\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvarMu.Unlock()\r\n\u001b[32m\u001b[K537\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K538\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif step.Condition != \"\" {\r\n\u001b[32m\u001b[K539\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcond, err := evaluateCondition(step.Condition, vars)\r\n\u001b[32m\u001b[K540\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err != nil {\r\n\u001b[32m\u001b[K541\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.Status = \"failed\"\r\n\u001b[32m\u001b[K542\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.Error = err.Error()\r\n"]
[4064.59373, "o", "\u001b[32m\u001b[K543\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn\r\n\u001b[32m\u001b[K544\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K545\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif !cond {\r\n\u001b[32m\u001b[K546\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.Status = \"skipped\"\r\n\u001b[32m\u001b[K547\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.Output = \"condition false\"\r\n\u001b[32m\u001b[K548\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn\r\n\u001b[32m\u001b[K549\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K550\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K551\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K552\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[4064.593789, "o", "\tcmdStr, err := substituteVariables(step.Command, vars)\r\n\u001b[32m\u001b[K553\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K554\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsr.Status = \"failed\"\r\n\u001b[32m\u001b[K555\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsr.Error = err.Error()\r\n\u001b[32m\u001b[K556\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K557\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K558\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K559\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t"]
[4064.593851, "o", "envVars := os.Environ()\r\n\u001b[32m\u001b[K560\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k, v := range vars {\r\n\u001b[32m\u001b[K561\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tenvVars = append(envVars, \"NEXUS_PARAM_\"+k+\"=\"+v)\r\n\u001b[32m\u001b[K562\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K563\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k, v := range step.Env {\r\n\u001b[32m\u001b[K564\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tev, err := substituteVariables(v, vars)\r\n\u001b[32m\u001b[K565\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err != nil {\r\n\u001b[32m\u001b[K566\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.Status = \"failed\"\r\n"]
[4064.593915, "o", "\u001b[32m\u001b[K567\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.Error = fmt.Sprintf(\"env %s: %v\", k, err)\r\n\u001b[32m\u001b[K568\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn\r\n\u001b[32m\u001b[K569\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K570\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tenvVars = append(envVars, k+\"=\"+ev)\r\n\u001b[32m\u001b[K571\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K572\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K573\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmaxRetries := 0\r\n\u001b[32m\u001b[K574\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tbackoffBase := 1\r\n\u001b[32m\u001b[K575\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif step.Retry != nil {\r\n"]
[4064.594003, "o", "\u001b[32m\u001b[K576\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tmaxRetries = step.Retry.MaxRetries\r\n\u001b[32m\u001b[K577\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif step.Retry.BackoffBaseSeconds > 0 {\r\n\u001b[32m\u001b[K578\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tbackoffBase = step.Retry.BackoffBaseSeconds\r\n\u001b[32m\u001b[K579\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K580\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K581\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K582\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar exp *Experiment\r\n\u001b[32m\u001b[K583\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif step.Type == \"train\" {\r\n\u001b[32m\u001b[K584\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tvar err error\r\n\u001b[32m\u001b[K585\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\texp, err = createTrainExperiment(tracker, step, sr.ExperimentID)\r\n\u001b[32m\u001b[K586\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err != nil {\r\n\u001b[32m\u001b[K587\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.Status = \"failed\"\r\n\u001b[32m\u001b[K588\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsr.Error = err.Error()\r\n"]
