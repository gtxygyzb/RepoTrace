[1451.297871, "o", "   259\tfunc runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {\r\n   260\t\tif err := validatePipelineConfig(cfg); err != nil {\r\n   261\t\t\treturn nil, err\r\n   262\t\t}\r\n"]
[1451.297972, "o", "   263\t\tmerged := mergeParams(cfg.Parameters, params)\r\n   264\t\tif maxParallel <= 0 {\r\n   265\t\t\tmaxParallel = cfg.MaxParallel\r\n   266\t\t}\r\n   267\t\tif maxParallel <= 0 {\r\n   268\t\t\tmaxParallel = 4\r\n"]
[1451.298056, "o", "   269\t\t}\r\n   270\t\r\n   271\t\trunID := generateRunID()\r\n   272\t\trunDir := filepath.Join(pipelineRunsDir, runID)\r\n   273\t\tartifactsDir := filepath.Join(runDir, \"artifacts\")\r\n   274\t\tif err := os.MkdirAll(artifactsDir, 0755); err != nil {\r\n   275\t\t\treturn nil, fmt.Errorf(\"create run dir: %w\", err)\r\n   276\t\t}\r\n   277\t\tif cfgData, err := json.MarshalIndent(cfg, \"\", \"  \"); err == nil {\r\n   278\t\t\tos.WriteFile(filepath.Join(runDir, \"pipeline_config.json\"), cfgData, 0644)\r\n   279\t\t}\r\n   280\t\r\n   281\t\tnow := time.Now()\r\n   282\t\trun := &PipelineRun{\r\n   283\t\t\tID:         runID,\r\n   284\t\t\tPipeline:   cfg.Name,\r\n   285\t\t\tStatus:     \"running\",\r\n   286\t\t\tParameters: merged,\r\n"]
[1451.29813, "o", "   287\t\t\tStartTime:  &now,\r\n   288\t\t\tRunDir:     runDir,\r\n   289\t\t\tSteps:      make([]*StepRun, 0, len(cfg.Steps)),\r\n   290\t\t}\r\n"]
[1451.298199, "o", "   291\t\tfor _, step := range cfg.Steps {\r\n   292\t\t\trun.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: \"pending\"})\r\n   293\t\t}\r\n   294\t\tsaveRun(run)\r\n   295\t\r\n   296\t\terr := executeSteps(cfg, run, tracker, merged, maxParallel)\r\n   297\t\tendTime := time.Now()\r\n   298\t\trun.EndTime = &endTime\r\n   299\t\tif err != nil {\r\n   300\t\t\trun.Status = \"failed\"\r\n   301\t\t} else {\r\n   302\t\t\trun.Status = \"succeeded\"\r\n   303\t\t}\r\n   304\t\tsaveRun(run)\r\n   305\t\treturn run, err\r\n   306\t}\r\n   307\t\r\n"]
[1451.298262, "o", "   308\tfunc executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n   309\t\tstepByName := make(map[string]*PipelineStep)\r\n   310\t\tfor _, s := range cfg.Steps {\r\n   311\t\t\tstepByName[s.Name] = s\r\n   312\t\t}\r\n   313\t\trunStepByName := make(map[string]*StepRun)\r\n   314\t\tfor _, sr := range run.Steps {\r\n   315\t\t\trunStepByName[sr.Name] = sr\r\n   316\t\t}\r\n   317\t"]
[1451.29833, "o", "\r\n   318\t\tvar mu sync.Mutex\r\n   319\t\tvar running []*PipelineStep\r\n   320\t\tavailable := make(chan struct{}, maxParallel)\r\n   321\t\r\n   322\t"]
[1451.29839, "o", "\tpending := make(map[string]bool)\r\n   323\t\tfor _, step := range cfg.Steps {\r\n   324\t\t\tsr := runStepByName[step.Name]\r\n   325\t\t\tif sr.Status == \"succeeded\" || sr.Status == \"skipped\" {\r\n   326\t\t\t\tcontinue\r\n   327\t\t\t}\r\n   328\t\t\tif sr.Status == \"failed\" {\r\n   329\t\t\t\tsr.Status = \"pending\"\r\n   330\t\t\t\tsr.Error = \"\"\r\n   331\t\t\t\tsr.Output = \"\"\r\n   332\t\t\t\tsr.StartTime = nil\r\n   333\t\t\t\tsr.EndTime = nil\r\n   334\t\t\t}\r\n   335"]
[1451.29845, "o", "\t\t\tpending[step.Name] = true\r\n   336\t\t}\r\n   337\t\r\n   338\t\tvar wg sync.WaitGroup\r\n   339\t\tdone := false\r\n   340\t\r\n   341\t\tcanStart := func(step *PipelineStep) bool {\r\n   342\t\t\tfor _, dep := range step.DependsOn {\r\n"]
[1451.29852, "o", "   343\t\t\t\tstatus := runStepByName[dep].Status\r\n   344\t\t\t\tif status != \"succeeded\" && status != \"skipped\" {\r\n   345\t\t\t\t\treturn false\r\n   346\t\t\t\t}\r\n"]
[1451.298584, "o", "   347\t\t\t}\r\n   348\t\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n   349\t\t\t\tvar cpu, mem int\r\n   350\t\t\t\tfor _, r := range running {\r\n   351\t\t\t\t\tif r.Resources != nil {\r\n   352\t\t\t\t\t\tcpu += r.Resources.CPU\r\n   353\t\t\t\t\t\tmem += r.Resources.MemoryMB\r\n   354\t\t\t\t\t}\r\n   355\t\t\t\t}\r\n"]
[1451.298653, "o", "   356\t\t\t\tif cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n   357\t\t\t\t\treturn false\r\n   358\t\t\t\t}\r\n   359\t\t\t}\r\n   360\t\t\treturn true\r\n   361\t\t}\r\n   362\t\r\n   363\t\tstartStep := func(step *PipelineStep) {\r\n   364\t\t\tpending[step.Name] = false\r\n   365\t\t\trunning = append(running, step)\r\n   366\t\t\twg.Add(1)\r\n"]
[1451.298718, "o", "   367\t\t\tgo func(s *PipelineStep) {\r\n   368\t\t\t\tdefer wg.Done()\r\n   369\t\t\t\texecuteStep(cfg, run, tracker, s, params, runStepByName[s.Name])\r\n   370\t\t\t\tmu.Lock()\r\n   371\t\t\t\trunning = removeStep(running, s)\r\n   372\t\t\t\tif runStepByName[s.Name].Status == \"failed\" {\r\n   373\t\t\t\t\trun.Status = \"failed\"\r\n   374\t\t\t\t\tdone = true\r\n   375\t\t\t\t}\r\n   376\t\t\t\tsaveCheckpoint(run)\r\n   377\t\t\t\tsaveRun(run)\r\n   378\t\t\t\tmu.Unlock()\r\n   379\t\t\t\t<-available\r\n"]
[1451.298777, "o", "   380\t\t\t}(step)\r\n   381\t\t}\r\n   382\t\r\n   383\t\tfor !done && (len(pending) > 0 || len(running) > 0) {\r\n   384\t\t\tstartedAny := false\r\n   385\t\t\tvar starts []*PipelineStep\r\n   386\t\t\tmu.Lock()\r\n"]
[1451.29884, "o", "   387\t\t\tfor _, step := range cfg.Steps {\r\n   388\t\t\t\tif pending[step.Name] && canStart(step) {\r\n   389\t\t\t\t\tstarts = append(starts, step)\r\n   390\t\t\t\t}\r\n   391\t\t\t}\r\n   392\t\t\tmu.Unlock()\r\n   393\t\t\tsort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })\r\n   394\t\t\tfor _, step := range starts {\r\n   395\t\t\t\tavailable <- struct{}{}\r\n   396\t\t\t\tmu.Lock()\r\n"]
[1451.298897, "o", "   397\t\t\t\tif done || !pending[step.Name] || !canStart(step) {\r\n   398\t\t\t\t\tmu.Unlock()\r\n   399\t\t\t\t\t<-available\r\n   400\t\t\t\t\tcontinue\r\n   401\t\t\t\t}\r\n   402\t\t\t\tstartStep(step)\r\n   403\t\t\t\tmu.Unlock()\r\n   404\t\t\t\tstartedAny = true\r\n   405\t\t\t}\r\n   406\t"]
[1451.298955, "o", "\r\n   407\t\t\tif !startedAny {\r\n   408\t\t\t\tif len(running) == 0 {\r\n   409\t\t\t\t\tbreak\r\n   410\t\t\t\t}\r\n   411\t\t\t\ttime.Sleep(10 * time.Millisecond)\r\n   412\t\t\t}\r\n   413\t\t}\r\n"]
[1451.299015, "o", "   414\t\twg.Wait()\r\n   415\t\r\n   416\t\tfor _, sr := range run.Steps {\r\n   417\t\t\tif sr.Status == \"pending\" {\r\n   418\t\t\t\tsr.Status = \"failed\"\r\n   419\t\t\t\tsr.Error = \"dependency failed\"\r\n"]
[1451.299062, "o", "   420\t\t\t}\r\n   421\t\t}\r\n   422\t\tsaveCheckpoint(run)\r\n   423\t\tsaveRun(run)\r\n   424\t\r\n   425\t\tif run.Status == \"failed\" {\r\n   426\t\t\t"]
[1451.299142, "o", "return fmt.Errorf(\"pipeline execution failed\")\r\n   427\t\t}\r\n   428\t\treturn nil\r\n   429\t}\r\n   430\tfunc removeStep(steps []*PipelineStep, target *PipelineStep) []*PipelineStep {\r\n   431\t\tout := make([]*PipelineStep, 0, len(steps))\r\n   432\t\tfor _, s := range steps {\r\n   433\t\t\tif s != target {\r\n   434\t\t\t\tout = append(out, s)\r\n   435\t\t\t}\r\n   436\t\t}\r\n   437"]
[1451.299205, "o", "\t\treturn out\r\n   438\t}\r\n   439\t\r\n   440\tfunc executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, params map[string]string, sr *StepRun) {\r\n   441\t\tfor _, dep := range step.DependsOn {\r\n   442\t\t\tdepStatus := getRunStep(run, dep).Status\r\n   443\t\t\tif depStatus != \"succeeded\" && depStatus != \"skipped\" {\r\n   444\t\t\t\tsr.Status = \"failed\"\r\n   445\t\t\t\tsr.Error = \"dependency failed\"\r\n"]
[1451.299266, "o", "   446\t\t\t\treturn\r\n   447\t\t\t}\r\n   448\t\t}\r\n   449\t\r\n"]
[1451.299328, "o", "   450\t\tif step.Condition != \"\" {\r\n   451\t\t\tcond, err := evaluateCondition(step.Condition, params)\r\n   452\t\t\tif err != nil {\r\n   453\t\t\t\tsr.Status = \"failed\"\r\n   454\t\t\t\tsr.Error = err.Error()\r\n   455\t\t\t\treturn\r\n   456\t\t\t}\r\n   457\t\t\tif !cond {\r\n   458\t\t\t\tsr.Status = \"skipped\"\r\n   459\t\t\t\tsr.Output = \"condition false\"\r\n   460\t\t\t\treturn\r\n   461\t\t\t}\r\n   462\t\t}\r\n"]
[1451.29939, "o", "   463\t\r\n   464\t\tmaxRetries := 0\r\n   465\t\tbackoffBase := 1\r\n   466\t\tif step.Retry != nil {\r\n   467\t\t\tmaxRetries = step.Retry.MaxRetries\r\n   468\t\t\tif step.Retry.BackoffBaseSeconds > 0 {\r\n   469\t\t\t\tbackoffBase = step.Retry.BackoffBaseSeconds\r\n"]
[1451.299445, "o", "   470\t\t\t}\r\n   471\t\t}\r\n   472\t\r\n   473\t\tcmdStr := substituteParams(step.Command, params)\r\n   474\t\r\n   475\t\tvar exp *Experiment\r\n   476\t\tif step.Type == \"train\" {\r\n   477\t\t\tvar err error\r\n"]
[1451.299513, "o", "   478\t\t\texp, err = createTrainExperiment(tracker, step, sr.ExperimentID)\r\n   479\t\t\tif err != nil {\r\n   480\t\t\t\tsr.Status = \"failed\"\r\n   481\t\t\t\tsr.Error = err.Error()\r\n   482\t\t\t\treturn\r\n   483\t\t\t}\r\n   484\t\t\tsr.ExperimentID = exp.ID\r\n   485\t\t}\r\n   486\t\r\n   487\t"]
[1451.299575, "o", "\tfor attempt := 0; attempt <= maxRetries; attempt++ {\r\n   488\t\t\tstart := time.Now()\r\n   489\t\t\tsr.StartTime = &start\r\n   490\t\t\tsr.RetryCount = attempt\r\n   491\t\t\tout, exitCode, err := runShellCommand(cmdStr, step.TimeoutSeconds)\r\n   492\t\t\tsr.Output = out\r\n   493\t\t\tsr.ExitCode = exitCode\r\n   494\t\t\tif err == nil {\r\n"]
[1451.299631, "o", "   495\t\t\t\tsr.EndTime = nowPtr()\r\n   496\t\t\t\tsr.Status = \"succeeded\"\r\n   497\t\t\t\tsr.Error = \"\"\r\n   498\t\t\t\tproduceArtifacts(run, step, sr, out)\r\n   499\t\t\t\tif step.Type == \"train\" && exp != nil {\r\n   500\t\t\t\t\tif terr := finishTrainExperiment(tracker, exp, step, out); terr != nil {\r\n   501\t\t\t\t\t\tsr.Status = \"failed\"\r\n   502\t\t\t\t\t\tsr.Error = terr.Error()\r\n"]
[1451.299692, "o", "   503\t\t\t\t\t\treturn\r\n   504\t\t\t\t\t}\r\n   505\t\t\t\t}\r\n   506\t\t\t\tif step.Type == \"evaluate\" {\r\n"]
[1451.29975, "o", "   507\t\t\t\t\tregisterEvaluateArtifacts(run, step, sr)\r\n   508\t\t\t\t}\r\n   509\t\t\t\treturn\r\n   510\t\t\t}\r\n   511\t\t\tsr.Error = err.Error()\r\n   512\t\t\tif step.Type == \"train\" && exp != nil {\r\n   513\t\t\t\ttracker.Complete(exp.ID, ExperimentStatusFailed)\r\n   514\t\t\t}\r\n   515\t\t\tif attempt < maxRetries {\r\n   516\t\t\t\tdelay := time.Duration(math.Pow(float64(backoffBase), float64(attempt+1))) * time.Second\r\n   517\t\t\t\ttime.Sleep(delay)\r\n   518\t\t\t}\r\n   519\t\t}\r\n   520"]
[1451.299809, "o", "\t\tsr.EndTime = nowPtr()\r\n   521\t\tsr.Status = \"failed\"\r\n   522\t}\r\n   523\tfunc getRunStep(run *PipelineRun, name string) *StepRun {\r\n   524\t\tfor _, sr := range run.Steps {\r\n   525\t\t\tif sr.Name == name {\r\n   526\t\t\t\treturn sr\r\n   527\t\t\t}\r\n   528\t\t}\r\n"]
