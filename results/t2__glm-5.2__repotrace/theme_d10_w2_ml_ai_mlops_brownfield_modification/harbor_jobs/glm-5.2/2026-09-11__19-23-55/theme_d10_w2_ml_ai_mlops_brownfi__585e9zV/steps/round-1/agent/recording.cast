[227.858315, "i", "pe == \"train\" && step.ExperimentConfig == nil {\r\t\t\treturn fmt.Errorf(\"train step %s requires experiment_config\", step.Name)\r\t\t}\r\t}\r\r\tfor _, step := range cfg.Steps {\r\t\tfor _, dep := range step.DependsOn {\r\t\t\tif !names[dep] {\r\t\t\t\treturn fmt.Errorf(\"step %s depends on unknown step %s\", step.Name, dep)\r\t\t\t}\r\t\t}\r\t}\r\r\tif cycle := findCycle(cfg.Steps); cycle != nil {\r\t\treturn fmt.Errorf(\"cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\t}\r\r\tproducers := make(map[string]string)\r\tfor _, step := range cfg.Steps {\r\t\tfor _, out := range step.Outputs {\r\t\t\tif _, ok := producers[out]; ok {\r\t\t\t\treturn fmt.Errorf(\"duplicate output artifact: %s\", out)\r\t\t\t}\r\t\t\tproducers[out] = step.Name\r\t\t}\r\t}\r\r\tfor _, step := range cfg.Steps {\r\t\tfor _, in := range step.Inputs {\r\t\t\tprod, ok := producers[in]\r\t\t\tif !ok {\r\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s is not produced by any step\", step.Name, in)\r\t\t\t}\r\t\t\tif prod == step.Name {\r\t\t\t\treturn fmt.Errorf(\"step %s input artifact %s must come from a dependency\", step.Name, in)\r\t\t\t}\r\t\t\t"]
