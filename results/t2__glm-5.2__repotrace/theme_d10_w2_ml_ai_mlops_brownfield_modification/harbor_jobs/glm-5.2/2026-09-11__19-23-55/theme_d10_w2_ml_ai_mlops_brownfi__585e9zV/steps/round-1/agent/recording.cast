[1986.32455, "o", "> "]
[1986.324667, "o", "# Replace executeSteps function\r\n\u001b[?2004l\r"]
[1986.324721, "o", "\u001b[?2004h> "]
[1986.325325, "o", "old_start = \"func executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\"\r\n\u001b[?2004l\r"]
[1986.325384, "o", "\u001b[?2004h> "]
[1986.32578, "o", "old_end = \"\\nfunc removeStep(steps []*PipelineStep, target *PipelineStep) []*PipelineStep {\"\r\n\u001b[?2004l\r"]
[1986.325837, "o", "\u001b[?2004h> "]
[1986.325948, "o", "idx0 = s.index(old_start)\r\n\u001b[?2004l\r"]
[1986.326003, "o", "\u001b[?2004h> "]
[1986.326121, "o", "idx1 = s.index(old_end)\r\n\u001b[?2004l\r"]
[1986.326176, "o", "\u001b[?2004h> "]
[1986.326781, "o", "new_exec_steps = '''func executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n\u001b[?2004l\r"]
[1986.326838, "o", "\u001b[?2004h> "]
[1986.327033, "o", "\\tstepByName := make(map[string]*PipelineStep)\r\n\u001b[?2004l\r"]
[1986.327098, "o", "\u001b[?2004h> "]
[1986.327232, "o", "\\tfor _, s := range cfg.Steps {\r\n\u001b[?2004l\r"]
[1986.327287, "o", "\u001b[?2004h> "]
[1986.327389, "o", "\\t\\tstepByName[s.Name] = s\r\n\u001b[?2004l\r"]
[1986.327444, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.327498, "o", "\u001b[?2004h> "]
[1986.327678, "o", "\\trunStepByName := make(map[string]*StepRun)\r\n\u001b[?2004l\r"]
[1986.327732, "o", "\u001b[?2004h> "]
[1986.327868, "o", "\\tfor _, sr := range run.Steps {\r\n\u001b[?2004l\r"]
[1986.327923, "o", "\u001b[?2004h> "]
[1986.328057, "o", "\\t\\trunStepByName[sr.Name] = sr\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.328113, "o", "> \\t}\r\n\u001b[?2004l\r"]
[1986.328169, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[1986.328365, "o", "\\tvariables := make(map[string]string)\r\n\u001b[?2004l\r"]
[1986.328422, "o", "\u001b[?2004h> "]
[1986.328534, "o", "\\tif run.Variables != nil {\r\n\u001b[?2004l\r"]
[1986.328589, "o", "\u001b[?2004h> "]
[1986.328709, "o", "\\t\\tfor k, v := range run.Variables {\r\n\u001b[?2004l\r"]
[1986.328764, "o", "\u001b[?2004h> "]
[1986.328828, "o", "\\t\\t\\tvariables[k] = v\r\n\u001b[?2004l\rs\u001b[?2004h> "]
[1986.328884, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.328935, "o", "\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.329086, "o", "\\t\\tfor k, v := range params {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.329183, "o", "\\t\\t\\tvariables[k] = v\r\n\u001b[?2004l\r\"\u001b[?2004h> "]
[1986.329234, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.329289, "o", "\\t}\r\n\u001b[?2004l\r\\t\u001b[?2004h> "]
[1986.329373, "o", "\\tvar varMu sync.Mutex\r\n\u001b[?2004l\r"]
[1986.329428, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.329491, "o", "\\tvar mu sync.Mutex\r\n\u001b[?2004l\r"]
[1986.329545, "o", "\u001b[?2004h> "]
[1986.329628, "o", "\\tvar running []*PipelineStep\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.329806, "o", "\\tavailable := make(chan struct{}, maxParallel)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.329861, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.329972, "o", "\\tpending := make(map[string]bool)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.330026, "o", "> "]
[1986.33012, "o", "\\tfor _, step := range cfg.Steps {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.330175, "o", "> "]
[1986.330269, "o", "\\t\\tsr := runStepByName[step.Name]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.330497, "o", "\\t\\tif sr.Status == \"succeeded\" || sr.Status == \"skipped\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.330577, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.330637, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.330746, "o", "\\t\\tif sr.Status == \"failed\" {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.330806, "o", "> "]
[1986.330858, "o", "\\t\\t\\tsr.Status = \"pending\"\r\n\u001b[?2004l\r"]
[1986.330913, "o", "\u001b[?2004h> "]
[1986.330973, "o", "\\t\\t\\tsr.Error = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.331066, "o", "\\t\\t\\tsr.Output = \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.33112, "o", "> "]
[1986.331169, "o", "\\t\\t\\tsr.StartTime = nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.331265, "o", "\\t\\t\\tsr.EndTime = nil\r\n\u001b[?2004l\r"]
[1986.331323, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[1986.33138, "o", "\u001b[?2004h> "]
[1986.331451, "o", "\\t\\tpending[step.Name] = true\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.331506, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.331561, "o", "\u001b[?2004h> "]
[1986.331628, "o", "\\tvar wg sync.WaitGroup\r\n\u001b[?2004l\r"]
[1986.331683, "o", "\u001b[?2004h> "]
[1986.331737, "o", "\\tdone := false\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.331803, "o", "\u001b[?2004h> "]
[1986.331922, "o", "\\tcanStart := func(step *PipelineStep) bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.331978, "o", "> "]
[1986.332083, "o", "\\t\\tfor _, dep := range step.DependsOn {\r\n\u001b[?2004l\r"]
[1986.332138, "o", "\u001b[?2004h> "]
[1986.332248, "o", "\\t\\t\\tstatus := runStepByName[dep].Status\r\n\u001b[?2004l\r"]
[1986.332304, "o", "\u001b[?2004h> "]
[1986.332468, "o", "\\t\\t\\tif status != \"succeeded\" && status != \"skipped\" {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.332523, "o", "> "]
[1986.332579, "o", "\\t\\t\\t\\treturn false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.332634, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\\t\u001b[?2004h> "]
[1986.332691, "o", "\\t\\t}\r\n\u001b[?2004l\rr\u001b[?2004h> "]
[1986.332867, "o", "\\t\\tif step.Resources != nil && cfg.ResourceLimit != nil {\r\n\u001b[?2004l\r"]
[1986.332922, "o", "\u001b[?2004h> "]
[1986.332981, "o", "\\t\\t\\tvar cpu, mem int\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.333116, "o", "\\t\\t\\tfor _, r := range running {\r\n\u001b[?2004l\r"]
[1986.333171, "o", "\u001b[?2004h> "]
[1986.333252, "o", "\\t\\t\\t\\tif r.Resources != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.333307, "o", "> "]
[1986.33339, "o", "\\t\\t\\t\\t\\tcpu += r.Resources.CPU\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.333538, "o", "\\t\\t\\t\\t\\tmem += r.Resources.MemoryMB\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.333598, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.333652, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\\\u001b[?2004h> "]
[1986.334074, "o", "\\t\\t\\tif cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.334166, "o", "\\t\\t\\t\\treturn false\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[1986.33422, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\\\u001b[?2004h> "]
[1986.334275, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.334339, "o", "\\t\\treturn true\r\n\u001b[?2004l\r"]
[1986.334366, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.334402, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.334423, "o", "\u001b[?2004h> "]
[1986.334573, "o", "\\tstartStep := func(step *PipelineStep) {\r\n\u001b[?2004l\r"]
[1986.334594, "o", "\u001b[?2004h> "]
[1986.334713, "o", "\\t\\tpending[step.Name] = false\r\n\u001b[?2004l\r"]
[1986.334733, "o", "\u001b[?2004h> "]
[1986.334879, "o", "\\t\\trunning = append(running, step)\r\n\u001b[?2004l\re\u001b[?2004h> "]
[1986.334953, "o", "\\t\\twg.Add(1)\r\n\u001b[?2004l\r"]
[1986.334975, "o", "\u001b[?2004h> "]
[1986.335094, "o", "\\t\\tgo func(s *PipelineStep) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.335184, "o", "\\t\\t\\tdefer wg.Done()\r\n\u001b[?2004l\r"]
[1986.335205, "o", "\u001b[?2004h> "]
[1986.335481, "o", "\\t\\t\\texecuteStep(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.33557, "o", "\\t\\t\\tmu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.390324, "o", "\\t\\t\\trunning = removeStep(running, s)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tif runStepByName[s.Name].Status == \"failed\" {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\trun.Status = \"failed\"\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\tdone = true\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tvarMu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\trun.Variables = copyMap(variables)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tvarMu.Unlock()\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tsaveCheckpoint(run)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tsaveRun(run)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tmu.Unlock()\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t<-available\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}(step)\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \\tfor !done && (len(pending) > 0 || len(running) > 0) {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tstartedAny := false\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tvar starts []*PipelineStep\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tmu.Lock()\r\n\u001b[?2004l\rn\u001b[?2004h> \\t\\tfor _, step := range cfg.Steps {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tif pending[step.Name] && canStart(step) {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\tstarts = append(starts, step)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t}"]
[1986.3904, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tmu.Unlock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.390984, "o", "\\t\\tsort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })\r\n\u001b[?2004l\r"]
[1986.391039, "o", "\u001b[?2004h> "]
[1986.391272, "o", "\\t\\tfor _, step := range starts {\r\n\u001b[?2004l\r"]
[1986.391329, "o", "\u001b[?2004h> "]
[1986.391534, "o", "\\t\\t\\tavailable <- struct{}{}\r\n\u001b[?2004l\r"]
[1986.3916, "o", "\u001b[?2004h> "]
[1986.391718, "o", "\\t\\t\\tmu.Lock()\r\n\u001b[?2004l\r"]
[1986.391774, "o", "\u001b[?2004h> "]
[1986.392173, "o", "\\t\\t\\tif done || !pending[step.Name] || !canStart(step) {\r\n\u001b[?2004l\r"]
[1986.39223, "o", "\u001b[?2004h> "]
[1986.392374, "o", "\\t\\t\\t\\tmu.Unlock()\r\n\u001b[?2004l\r"]
[1986.392421, "o", "\u001b[?2004h> "]
[1986.392576, "o", "\\t\\t\\t\\t<-available\r\n\u001b[?2004l\r"]
[1986.392631, "o", "\u001b[?2004h> "]
[1986.392746, "o", "\\t\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[1986.3928, "o", "\u001b[?2004h> "]
[1986.392872, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[1986.392928, "o", "\u001b[?2004h> "]
[1986.393093, "o", "\\t\\t\\tstartStep(step)\r\n\u001b[?2004l\r"]
[1986.393149, "o", "\u001b[?2004h> "]
[1986.393293, "o", "\\t\\t\\tmu.Unlock()\r\n\u001b[?2004l\r"]
[1986.393348, "o", "\u001b[?2004h> "]
[1986.393515, "o", "\\t\\t\\tstartedAny = true\r\n\u001b[?2004l\r"]
[1986.393571, "o", "\u001b[?2004h> "]
[1986.393622, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.393678, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.393728, "o", "\u001b[?2004h> "]
[1986.393891, "o", "\\t\\tif !startedAny {\r\n\u001b[?2004l\r"]
[1986.393942, "o", "\u001b[?2004h> "]
[1986.394179, "o", "\\t\\t\\tif len(running) == 0 {\r\n\u001b[?2004l\r"]
[1986.39425, "o", "\u001b[?2004h> "]
[1986.394371, "o", "\\t\\t\\t\\tbreak\r\n\u001b[?2004l\r"]
[1986.394432, "o", "\u001b[?2004h> "]
[1986.394494, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[1986.394555, "o", "\u001b[?2004h> "]
[1986.394833, "o", "\\t\\t\\ttime.Sleep(10 * time.Millisecond)\r\n\u001b[?2004l\r"]
[1986.394889, "o", "\u001b[?2004h> "]
[1986.394955, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.395011, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.395073, "o", "\u001b[?2004h> "]
[1986.395177, "o", "\\twg.Wait()\r\n\u001b[?2004l\r"]
[1986.395228, "o", "\u001b[?2004h> \r\n"]
[1986.395288, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1986.395344, "o", "> "]
[1986.395535, "o", "\\tfor _, sr := range run.Steps {\r\n\u001b[?2004l\r"]
[1986.39559, "o", "\u001b[?2004h> "]
[1986.395825, "o", "\\t\\tif sr.Status == \"pending\" {\r\n\u001b[?2004l\r"]
[1986.395881, "o", "\u001b[?2004h> "]
[1986.396069, "o", "\\t\\t\\tsr.Status = \"failed\"\r\n\u001b[?2004l\r"]
[1986.396125, "o", "\u001b[?2004h> "]
[1986.396397, "o", "\\t\\t\\tsr.Error = \"dependency failed\"\r\n\u001b[?2004l\r"]
[1986.396453, "o", "\u001b[?2004h> "]
[1986.396512, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.39657, "o", "\u001b[?2004h> "]
[1986.396625, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.39668, "o", "> "]
[1986.396776, "o", "\\tvarMu.Lock()\r\n\u001b[?2004l\r"]
[1986.396832, "o", "\u001b[?2004h> "]
[1986.397112, "o", "\\trun.Variables = copyMap(variables)\r\n\u001b[?2004l\r"]
[1986.39721, "o", "\u001b[?2004h"]
[1986.397304, "o", "> \\tvarMu.Unlock()\r\n\u001b[?2004l\r"]
[1986.397393, "o", "\u001b[?2004h> "]
[1986.397505, "o", "\\tsaveCheckpoint(run)\r\n\u001b[?2004l\r"]
[1986.397597, "o", "\u001b[?2004h> "]
[1986.397679, "o", "\\tsaveRun(run)\r\n\u001b[?2004l\r"]
[1986.397769, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.397861, "o", "> "]
[1986.398016, "o", "\\tif run.Status == \"failed\" {\r\n\u001b[?2004l\r"]
[1986.398074, "o", "\u001b[?2004h> "]
[1986.398443, "o", "\\t\\treturn fmt.Errorf(\"pipeline execution failed\")\r\n\u001b[?2004l\r"]
[1986.398542, "o", "\u001b[?2004h"]
[1986.398633, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.398722, "o", "\\treturn nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.398812, "o", "> }\r\n"]
[1986.398903, "o", "\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.399218, "o", "s = s[:idx0] + new_exec_steps + s[idx1:]\r\n\u001b[?2004l\r"]
[1986.399311, "o", "\u001b[?2004h"]
[1986.399404, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.399553, "o", "# Replace executeStep function\r\n\u001b[?2004l\r"]
[1986.399643, "o", "\u001b[?2004h"]
[1986.399734, "o", "> "]
[1986.400617, "o", "old_start = \"func executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, params map[string]string, sr *StepRun) {\"\r\n\u001b[?2004l\r"]
[1986.400734, "o", "\u001b[?2004h"]
[1986.400776, "o", "> "]
[1986.40117, "o", "old_end = \"\\nfunc getRunStep(run *PipelineRun, name string) *StepRun {\"\r\n\u001b[?2004l\r"]
[1986.401196, "o", "\u001b[?2004h"]
[1986.401327, "o", "> "]
[1986.401416, "o", "idx0 = s.index(old_start)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.401502, "o", "> "]
[1986.401573, "o", "idx1 = s.index(old_end)\r\n\u001b[?2004l\r"]
[1986.401666, "o", "\u001b[?2004h> "]
[1986.402616, "o", "new_exec_step = '''func executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {\r\n\u001b[?2004l\r"]
[1986.402645, "o", "\u001b[?2004h> "]
[1986.402898, "o", "\\tfor _, dep := range step.DependsOn {\r\n\u001b[?2004l\r"]
[1986.402988, "o", "\u001b[?2004h> "]
[1986.403189, "o", "\\t\\tdepStatus := getRunStep(run, dep).Status\r\n\u001b[?2004l\r"]
[1986.40328, "o", "\u001b[?2004h> "]
[1986.403548, "o", "\\t\\tif depStatus != \"succeeded\" && depStatus != \"skipped\" {\r\n\u001b[?2004l\r"]
[1986.403644, "o", "\u001b[?2004h> "]
[1986.403729, "o", "\\t\\t\\tsr.Status = \"failed\"\r\n\u001b[?2004l\r"]
[1986.403818, "o", "\u001b[?2004h> "]
[1986.403968, "o", "\\t\\t\\tsr.Error = \"dependency failed\"\r\n\u001b[?2004l\r"]
[1986.404068, "o", "\u001b[?2004h> "]
[1986.404158, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r"]
[1986.404248, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.404338, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.404427, "o", "\u001b[?2004h> "]
[1986.404515, "o", "\\tvarMu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.404613, "o", "\\tvars := copyMap(variables)\r\n\u001b[?2004l\r"]
[1986.404704, "o", "\u001b[?2004h> "]
[1986.404795, "o", "\\tvarMu.Unlock()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1986.404886, "o", "\u001b[?2004h> "]
[1986.405, "o", "\\tif step.Condition != \"\" {\r\n\u001b[?2004l\r"]
[1986.405112, "o", "\u001b[?2004h> "]
[1986.405365, "o", "\\t\\tcond, err := evaluateCondition(step.Condition, vars)\r\n\u001b[?2004l\r"]
[1986.405455, "o", "\u001b[?2004h> "]
[1986.405535, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[1986.405625, "o", "\u001b[?2004h> "]
[1986.405714, "o", "\\t\\t\\tsr.Status = \"failed\"\r\n\u001b[?2004l\r"]
[1986.405805, "o", "\u001b[?2004h"]
[1986.405893, "o", "> "]
[1986.405979, "o", "\\t\\t\\tsr.Error = err.Error()\r\n\u001b[?2004l\r"]
[1986.406078, "o", "\u001b[?2004h> "]
[1986.406172, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.406253, "o", "\\t\\tif !cond {\r\n\u001b[?2004l\r"]
[1986.406341, "o", "\u001b[?2004h"]
[1986.406431, "o", "> "]
[1986.406523, "o", "\\t\\t\\tsr.Status = \"skipped\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.406718, "o", "\\t\\t\\tsr.Output = \"condition false\"\r\n\u001b[?2004l\r"]
[1986.406813, "o", "\u001b[?2004h> \\t\\t\\treturn"]
[1986.406903, "o", "\r\n\u001b[?2004l\r"]
[1986.406991, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.407093, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.407441, "o", "\\tcmdStr, err := substituteVariables(step.Command, vars)\r\n\u001b[?2004l\r"]
[1986.407532, "o", "\u001b[?2004h"]
[1986.407622, "o", "> \\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.407709, "o", "> "]
[1986.407801, "o", "\\t\\tsr.Status = \"failed\"\r\n\u001b[?2004l\r"]
[1986.407887, "o", "\u001b[?2004h"]
[1986.407979, "o", "> \\t\\tsr.Error = err.Error()\r\n"]
[1986.408056, "o", "\u001b[?2004l\r"]
[1986.408146, "o", "\u001b[?2004h> "]
[1986.408236, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.408325, "o", "> "]
[1986.408423, "o", "\\tenvVars := os.Environ()\r\n\u001b[?2004l\r"]
[1986.408512, "o", "\u001b[?2004h> "]
[1986.408631, "o", "\\tfor k, v := range vars {\r\n\u001b[?2004l\r"]
[1986.408688, "o", "\u001b[?2004h> "]
[1986.408963, "o", "\\t\\tenvVars = append(envVars, \"NEXUS_PARAM_\"+k+\"=\"+v)\r\n\u001b[?2004l\r"]
[1986.409019, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.409084, "o", "\u001b[?2004h> "]
[1986.409269, "o", "\\tfor k, v := range step.Env {\r\n\u001b[?2004l\r"]
[1986.409323, "o", "\u001b[?2004h> "]
[1986.409546, "o", "\\t\\tev, err := substituteVariables(v, vars)\r\n\u001b[?2004l\r"]
[1986.409602, "o", "\u001b[?2004h> "]
[1986.409703, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[1986.409757, "o", "\u001b[?2004h> "]
[1986.409902, "o", "\\t\\t\\tsr.Status = \"failed\"\r\n\u001b[?2004l\r"]
[1986.409957, "o", "\u001b[?2004h> "]
[1986.410243, "o", "\\t\\t\\tsr.Error = fmt.Sprintf(\"env %s: %v\", k, err)\r\n\u001b[?2004l\r"]
[1986.410301, "o", "\u001b[?2004h> "]
[1986.41036, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r"]
[1986.410414, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[1986.410466, "o", "\u001b[?2004h> "]
[1986.410694, "o", "\\t\\tenvVars = append(envVars, k+\"=\"+ev)\r\n\u001b[?2004l\r"]
[1986.41075, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.410805, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re"]
[1986.410858, "o", "\u001b[?2004h> "]
[1986.410946, "o", "\\tmaxRetries := 0\r\n\u001b[?2004l\r"]
[1986.411001, "o", "\u001b[?2004h> "]
[1986.411103, "o", "\\tbackoffBase := 1\r\n\u001b[?2004l\r"]
[1986.411158, "o", "\u001b[?2004h> "]
[1986.411298, "o", "\\tif step.Retry != nil {\r\n\u001b[?2004l\r"]
[1986.411352, "o", "\u001b[?2004h> "]
[1986.411503, "o", "\\t\\tmaxRetries = step.Retry.MaxRetries\r\n\u001b[?2004l\r"]
[1986.411557, "o", "\u001b[?2004h> "]
[1986.411729, "o", "\\t\\tif step.Retry.BackoffBaseSeconds > 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.411784, "o", "> "]
[1986.411973, "o", "\\t\\t\\tbackoffBase = step.Retry.BackoffBaseSeconds\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.412028, "o", "> \\t\\t}\r\n\u001b[?2004l\r"]
[1986.412093, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\rn\u001b[?2004h"]
[1986.412147, "o", "> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[1986.412256, "o", "\\tvar exp *Experiment\r\n\u001b[?2004l\r"]
[1986.41231, "o", "\u001b[?2004h> "]
[1986.412399, "o", "\\tif step.Type == \"train\" {\r\n\u001b[?2004l\r"]
[1986.412454, "o", "\u001b[?2004h> "]
[1986.412513, "o", "\\t\\tvar err error\r\n\u001b[?2004l\r"]
[1986.412568, "o", "\u001b[?2004h> "]
[1986.412847, "o", "\\t\\texp, err = createTrainExperiment(tracker, step, sr.ExperimentID)\r\n\u001b[?2004l\r"]
[1986.412902, "o", "\u001b[?2004h> "]
[1986.412961, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[1986.413015, "o", "\u001b[?2004h> "]
[1986.413117, "o", "\\t\\t\\tsr.Status = \"failed\"\r\n\u001b[?2004l\r"]
[1986.413172, "o", "\u001b[?2004h> "]
[1986.413273, "o", "\\t\\t\\tsr.Error = err.Error()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.413327, "o", "> "]
[1986.413382, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.413441, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.413578, "o", "\\t\\tsr.ExperimentID = exp.ID\r\n\u001b[?2004l\r"]
[1986.413633, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.413687, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[1986.413922, "o", "\\tfor attempt := 0; attempt <= maxRetries; attempt++ {\r\n\u001b[?2004l\r"]
[1986.413975, "o", "\u001b[?2004h> "]
[1986.414065, "o", "\\t\\tstart := time.Now()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.41412, "o", "> "]
[1986.414205, "o", "\\t\\tsr.StartTime = &start\r\n\u001b[?2004l\r"]
[1986.414259, "o", "\u001b[?2004h> "]
[1986.414343, "o", "\\t\\tsr.RetryCount = attempt\r\n\u001b[?2004l\r"]
[1986.414398, "o", "\u001b[?2004h> "]
[1986.414707, "o", "\\t\\tout, exitCode, err := runShellCommand(cmdStr, step.TimeoutSeconds, envVars)\r\n\u001b[?2004l\r"]
[1986.414762, "o", "\u001b[?2004h> "]
[1986.414823, "o", "\\t\\tsr.Output = out\r\n\u001b[?2004l\r"]
[1986.414878, "o", "\u001b[?2004h> "]
