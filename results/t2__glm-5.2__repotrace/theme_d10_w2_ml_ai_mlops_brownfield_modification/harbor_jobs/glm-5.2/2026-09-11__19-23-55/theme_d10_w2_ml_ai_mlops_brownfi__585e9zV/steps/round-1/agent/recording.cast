[67.320962, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"sort\"\r\n     8"]
[67.321121, "o", "\t\t\"time\"\r\n     9\t)\r\n    10\t\r\n    11\t// Tracker manages experiment lifecycle\r\n    12\ttype Tracker struct {\r\n    13\t\tstore   *Store\r\n"]
[67.321199, "o", "    14\t\tcounter int\r\n    15\t}\r\n    16\t\r\n    17\tfunc NewTracker(store *Store) *Tracker {\r\n    18\t\tt := &Tracker{store: store}\r\n    19\t\texps := store.ListExperiments(\"\")\r\n    20\t\tfor _, exp := range exps {\r\n    21\t\t\tif id := extractCounter(exp.ID); id > t.counter {\r\n    22\t\t\t\tt.counter = id\r\n    23\t\t\t}\r\n    24\t\t}\r\n    25\t\treturn t\r\n    26\t}\r\n    27\t\r\n    28\tfunc extractCounter(id string) int {\r\n    29\t\tvar n int\r\n    30\t\tfmt.Sscanf(id, \"exp-%d\", &n)\r\n    31\t\treturn n\r\n    32\t}\r\n    33\t\r\n    34\tfunc (t *Tracker) Create(name string, params map[string]string, tags []string) (*Experiment, error) {\r\n    35\t\tif name == \"\" {\r\n    36\t\t\treturn nil, fmt.Errorf(\"experiment name is required\")\r\n    37\t\t}\r\n    38\t\r\n    39\t\t"]
[67.321295, "o", "t.counter++\r\n    40\t\texp := &Experiment{\r\n    41\t\t\tID:         fmt.Sprintf(\"exp-%04d\", t.counter),\r\n    42\t\t\tName:       name,\r\n    43\t\t\tStatus:     ExperimentStatusRunning,\r\n    44\t\t\tParameters: params,\r\n    45\t\t\tMetrics:    make(map[string]float64),\r\n    46\t\t\tTags:       tags,\r\n    47\t\t\tStartTime:  time.Now(),\r\n    48\t\t}\r\n    49\t\r\n    50\t\tif err := t.store.SaveExperiment(exp); err != nil {\r\n    51\t\t\treturn nil, err"]
[67.32136, "o", "\r\n    52\t\t}\r\n    53\t\treturn exp, nil\r\n    54\t}\r\n    55\t\r\n    56\tfunc (t *Tracker) LogMetric(id, key string, value float64) error {\r\n    57\t\texp, err := t.store.GetExperiment(id)\r\n    58\t\tif err != nil {\r\n    59\t\t\treturn err\r\n    60\t\t}\r\n"]
[67.321426, "o", "    61\t\tif exp.Status != ExperimentStatusRunning {\r\n    62\t\t\treturn fmt.Errorf(\"cannot log metrics to %s experiment\", exp.Status)\r\n    63\t\t}\r\n    64\t\r\n    65\t\texp.Metrics[key] = value\r\n    66\t\treturn t.store.SaveExperiment(exp)\r\n    67\t}\r\n    68\t\r\n    69\tfunc (t *Tracker) Complete(id string, status ExperimentStatus) error {\r\n    70\t\texp, err := t.store.GetExperiment(id)\r\n"]
[67.321487, "o", "    71\t\tif err != nil {\r\n    72\t\t\treturn err\r\n    73\t\t}\r\n    74\t\tif exp.Status != ExperimentStatusRunning {\r\n    75\t\t\treturn fmt.Errorf(\"experiment %s is already %s\", id, exp.Status)\r\n    76\t\t}\r\n    77\t\r\n    78\t\texp.Status = status\r\n"]
[67.321549, "o", "    79\t\texp.EndTime = time.Now()\r\n    80\t\treturn t.store.SaveExperiment(exp)\r\n    81\t}\r\n    82\t\r\n    83\tfunc (t *Tracker) CompareExperiments(ids []string) (string, error) {\r\n    84\t\tvar exps []*Experiment\r\n    85\t\tfor _, id := range ids {\r\n    86\t\t\texp, err := t.store.GetExperiment(id)\r\n    87\t\t\tif err != nil {\r\n"]
[67.321611, "o", "    88\t\t\t\treturn \"\", err\r\n    89\t\t\t}\r\n    90\t\t\texps = append(exps, exp)\r\n    91\t\t}\r\n    92\t\r\n    93\t\tmetricKeys := make(map[string]bool)\r\n    94\t\tfor _, exp := range exps {\r\n    95\t\t\tfor k := range exp.Metrics {\r\n    96\t\t"]
[67.321681, "o", "\t\tmetricKeys[k] = true\r\n    97\t\t\t}\r\n    98\t\t}\r\n    99\t\r\n   100\t\tvar keys []string\r\n   101\t\tfor k := range metricKeys {\r\n"]
[67.321745, "o", "   102\t\t\tkeys = append(keys, k)\r\n   103\t\t}\r\n   104\t\tsort.Strings(keys)\r\n   105\t\r\n   106\t\tresult := map[string]interface{}{\r\n   107\t\t\t\"experiments\": exps,\r\n   108\t\t\t\"metric_keys\": keys,\r\n   109\t\t}\r\n   110\t\r\n   111\t\tdata, _ := json.MarshalIndent(result, \"\", \"  \")\r\n   112\t\treturn string(data), nil\r\n   113\t}\r\n   114\t\r\n   115\tfunc (t *Tracker) LinkModel(experimentID, modelRef string) error {\r\n"]
[67.321808, "o", "   116\t\texp, err := t.store.GetExperiment(experimentID)\r\n   117\t\tif err != nil {\r\n   118\t\t\treturn err\r\n   119\t\t}\r\n   120\t\texp.ModelRef = modelRef\r\n"]
[67.321871, "o", "   121\t\treturn t.store.SaveExperiment(exp)\r\n   122\t}\r\n   123\t\r\n   124\tfunc (t *Tracker) Export(outputPath string, format string) error {\r\n   125\t\texps := t.store.ListExperiments(\"\")\r\n   126\t\r\n   127\t\tswitch format {\r\n   128\t\tcase \"json\":\r\n   129\t\t\tdata, err := json.MarshalIndent(exps, \"\", \"  \")\r\n   130\t\t\tif err != nil {\r\n   131\t\t\t\treturn err\r\n   132\t\t\t}\r\n   133\t\t\treturn os.WriteFile(outputPath, data, 0644)\r\n   134"]
[67.321928, "o", "\t\tcase \"csv\":\r\n   135\t\t\tf, err := os.Create(outputPath)\r\n   136\t\t\tif err != nil {\r\n   137\t\t\t\treturn err\r\n   138\t\t\t}\r\n   139\t\t\tdefer f.Close()\r\n   140\t\r\n"]
