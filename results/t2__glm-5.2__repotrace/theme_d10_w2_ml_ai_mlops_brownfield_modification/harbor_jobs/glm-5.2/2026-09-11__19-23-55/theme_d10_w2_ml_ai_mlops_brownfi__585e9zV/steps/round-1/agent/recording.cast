[1484.593962, "o", "   449\t\r\n   450\t\tif step.Condition != \"\" {\r\n   451\t\t\tcond, err := evaluateCondition(step.Condition, params)\r\n   452\t\t\tif err != nil {\r\n   453\t\t\t\tsr.Status = \"failed\"\r\n   454\t\t\t\tsr.Error = err.Error()\r\n   455\t\t\t\treturn\r\n   456\t\t\t}\r\n   457\t\t\tif !cond {\r\n   458\t\t\t\tsr.Status = \"skipped\"\r\n   459\t\t\t\tsr.Output = \"condition false\"\r\n   460\t\t\t\treturn\r\n   461\t\t\t}\r\n   462\t\t}\r\n   463\t\r\n   464\t\tmaxRetries := 0\r\n   465\t\tbackoffBase := 1\r\n   466\t\tif step.Retry != nil {\r\n   467\t\t\tmaxRetries = step.Retry.MaxRetries\r\n   468\t\t\tif step.Retry.BackoffBaseSeconds > 0 {\r\n   469\t\t\t\tbackoffBase = step.Retry.BackoffBaseSeconds\r\n   470\t\t\t}\r\n   471\t\t}\r\n   472\t\r\n   473\t\tcmdStr := substituteParams(step.Command, params)\r\n   474\t"]
[1484.59408, "o", "\r\n   475\t\tvar exp *Experiment\r\n   476\t\tif step.Type == \"train\" {\r\n   477\t\t\tvar err error\r\n   478\t\t\texp, err = createTrainExperiment(tracker, step, sr.ExperimentID)\r\n   479\t\t\tif err != nil {\r\n   480\t\t\t\tsr.Status = \"failed\"\r\n   481\t\t\t\tsr.Error = err.Error()\r\n   482\t\t\t\treturn\r\n   483\t\t\t}\r\n   484\t\t\tsr.ExperimentID = exp.ID\r\n   485\t\t}\r\n   486\t\r\n   487\t"]
[1484.59413, "o", "\tfor attempt := 0; attempt <= maxRetries; attempt++ {\r\n   488\t\t\tstart := time.Now()\r\n   489\t\t\tsr.StartTime = &start\r\n   490\t\t\tsr.RetryCount = attempt\r\n   491\t\t\tout, exitCode, err := runShellCommand(cmdStr, step.TimeoutSeconds)\r\n   492\t\t\t"]
[1484.59427, "o", "sr.Output = out\r\n   493\t\t\tsr.ExitCode = exitCode\r\n   494\t\t\tif err == nil {\r\n   495\t\t\t\tsr.EndTime = nowPtr()\r\n   496\t\t\t\tsr.Status = \"succeeded\"\r\n   497\t\t\t\tsr.Error = \"\"\r\n   498\t\t\t\tproduceArtifacts(run, step, sr, out)\r\n   499\t\t\t\tif step.Type == \"train\" && exp != nil {\r\n   500\t\t\t\t\tif terr := finishTrainExperiment(tracker, exp, step, out); terr != nil {\r\n   501\t\t\t\t\t\tsr.Status = \"failed\"\r\n   502\t\t\t\t\t\tsr.Error = terr.Error()\r\n   503\t\t\t\t\t\treturn\r\n   504\t\t\t\t\t}\r\n   505\t\t\t\t}\r\n   506\t\t\t\tif step.Type == \"evaluate\" {\r\n   507\t\t\t\t\tregisterEvaluateArtifacts(run, step, sr)\r\n   508\t\t\t\t}\r\n   509\t\t\t\treturn\r\n   510\t\t\t}\r\n"]
