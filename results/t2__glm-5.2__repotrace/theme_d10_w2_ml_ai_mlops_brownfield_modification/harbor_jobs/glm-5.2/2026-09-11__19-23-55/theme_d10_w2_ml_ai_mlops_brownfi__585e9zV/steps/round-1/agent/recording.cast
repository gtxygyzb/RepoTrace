[4085.213627, "o", "   592\t\t}\r\n   593\t\r\n   594\t\tfor attempt := 0; attempt <= maxRetries; attempt++ {\r\n   595\t\t\tstart := time.Now()\r\n   596\t\t\tsr.StartTime = &start\r\n   597\t\t\tsr.RetryCount = attempt\r\n   598\t\t\tstdout, stderr, exitCode, err := runShellCommand(cmdStr, step.TimeoutSeconds, envVars)\r\n   599\t\t\tsr.Output = stdout\r\n"]
[4085.21369, "o", "   600\t\t\tif stderr != \"\" {\r\n   601\t\t\t\tif sr.Output != \"\" {\r\n   602\t\t\t\t\tsr.Output += \"\\n\"\r\n   603\t\t\t\t}\r\n   604\t\t\t\tsr.Output += stderr\r\n   605\t\t\t}\r\n   606\t\t\tsr.ExitCode = exitCode\r\n   607\t\t\tif err == nil {\r\n"]
