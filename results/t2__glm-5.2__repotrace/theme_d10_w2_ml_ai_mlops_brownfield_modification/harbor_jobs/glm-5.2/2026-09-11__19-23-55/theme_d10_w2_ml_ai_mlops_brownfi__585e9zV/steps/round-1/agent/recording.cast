[6744.243078, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KprintUsage\u001b[m\u001b[K()\r\n"]
[6744.243297, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KhandlePipeline\u001b[m\u001b[K(store, tracker, os.Args[2:])\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KprintUsage\u001b[m\u001b[K()\r\n"]
