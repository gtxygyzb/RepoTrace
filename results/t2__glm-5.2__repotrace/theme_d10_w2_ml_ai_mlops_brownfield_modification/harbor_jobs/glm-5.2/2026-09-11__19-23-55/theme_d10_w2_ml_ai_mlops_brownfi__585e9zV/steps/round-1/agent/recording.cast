[3501.613822, "o", "  1000\t}\r\n  1001\t\r\n  1002\tfunc computeRunStatus(cfg *PipelineConfig, run *PipelineRun) {\r\n  1003\t\twarnings := []string{}\r\n  1004\t\thardFailed := false\r\n"]
[3501.613899, "o", "  1005\t\tfor _, step := range cfg.Steps {\r\n  1006\t\t\tsr := getRunStep(run, step.Name)\r\n  1007\t\t\tif sr == nil {\r\n  1008\t\t\t\tcontinue\r\n  1009\t\t\t}\r\n  1010\t\t\tif sr.Status == \"failed\" {\r\n  1011\t\t\t\tif step.AllowFailure {\r\n  1012\t\t\t\t\twarnings = append(warnings, step.Name)\r\n  1013\t\t\t\t} else {\r\n  1014\t\t\t\t\thardFailed = true\r\n  1015\t\t\t\t}\r\n"]
[3501.613965, "o", "  1016\t\t\t}\r\n  1017\t\t}\r\n  1018\t\tsort.Strings(warnings)\r\n  1019\t\trun.Warnings = warnings\r\n  1020\t\tif hardFailed {\r\n  1021\t\t\trun.Status = \"failed\"\r\n  1022\t\t} else if len(warnings) > 0 {\r\n  1023\t\t\trun.Status = \"succeeded_with_warnings\"\r\n"]
