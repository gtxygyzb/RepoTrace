[6232.37468, "o", "\t\t\t\t\t\treturn\r\n   630\t\t\t\t\t}\r\n   631\t\t\t\t}\r\n   632\t\t\t\tif step.Type == \"evaluate\" {\r\n   633\t\t\t\t\tregisterEvaluateArtifacts(run, step, sr)\r\n   634\t\t\t\t}\r\n   635\t\t\t\tif step.CaptureOutput != nil {\r\n   636\t\t\t\t\tval, ok, cerr := captureOutputValue(step, stdout)\r\n   637\t\t\t\t\tif cerr != nil {\r\n   638"]
[6232.374742, "o", "\t\t\t\t\t\tsr.Status = \"failed\"\r\n   639\t\t\t\t\t\tsr.Error = cerr.Error()\r\n   640\t\t\t\t\t\treturn\r\n   641\t\t\t\t\t}\r\n   642\t\t\t\t\tif ok {\r\n   643\t\t\t\t\t\tvarMu.Lock()\r\n   644\t\t\t\t\t\tvariables[step.CaptureOutput.Name] = val\r\n"]
[6232.374825, "o", "   645\t\t\t\t\t\tvarMu.Unlock()\r\n   646\t\t\t\t\t}\r\n   647\t\t\t\t}\r\n   648\t\t\t\treturn\r\n   649\t\t\t}\r\n   650\t\t\tsr.Error = err.Error()\r\n   651\t\t\tif step.Type == \"train\" && exp != nil {\r\n   652\t\t\t\ttracker.Complete(exp.ID, ExperimentStatusFailed)\r\n   653\t\t\t}\r\n   654\t\t\tif attempt < maxRetries {\r\n"]
