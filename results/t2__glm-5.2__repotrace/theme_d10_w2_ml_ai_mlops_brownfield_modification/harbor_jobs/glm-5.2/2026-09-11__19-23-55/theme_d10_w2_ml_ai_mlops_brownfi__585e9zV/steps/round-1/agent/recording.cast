[6863.131896, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('main.go')\nlines = p.read_text().splitlines()\nout = []\nfor i, line in enumerate(lines):\n    out.append(line)\n    if line.strip() == 'fmt.Println(\"  pipeline resume <run-id>\")':\n        out.append('    fmt.Println(\"  pipeline delete <run-id>\")')\np.write_text(\"\\n\".join(out) + \"\\n\")\n\nlines = p.read_text().splitlines()\nout = []\nfor i, line in enumerate(lines):\n    out.append(line)\n    if line.strip() == 'case \"resume\":':\n        # skip until the default case, then add delete case before default\n        j = i + 1\n        while j < len(lines) and lines[j].strip() != 'default:':\n            out.append(lines[j])\n            j += 1\n        out.extend([\n            '',\n            '        case \"delete\":',\n            '                if len(args) < 2 {',\n            '                        fmt.Fprintln(os.Stderr, \"run-id required\")',\n            '                        os.Exit(1)',\n            '                }',\n            '                if err := deleteRun(ar"]
