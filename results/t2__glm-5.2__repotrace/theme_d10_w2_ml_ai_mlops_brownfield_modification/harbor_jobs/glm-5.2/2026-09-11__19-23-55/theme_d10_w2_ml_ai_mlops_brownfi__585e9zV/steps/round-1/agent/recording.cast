[2183.927056, "o", "\\t\\t\\t\\t\\tdepsOk = false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.927112, "o", "\\t\\t\\t\\t\\tbreak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.927159, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.927201, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.927263, "o", "\\t\\t\\tif !depsOk {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.927364, "o", "\\t\\t\\t\\tstatus[step.Name] = \"blocked\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.927421, "o", "\\t\\t\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.927574, "o", "\\t\\t\\t\\tcond, err := evaluateCondition(step.Condition, merged)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.927647, "o", "\\t\\t\\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.927822, "o", "\\t\\t\\t\\t\\treturn nil, fmt.Errorf(\"step %s condition: %w\", step.Name, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.927869, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.927935, "o", "\\t\\t\\t\\tif !cond {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.990585, "o", "\\t\\t\\t\\t\\tstatus[step.Name] = \"skipped\"\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\t\\tstatus[step.Name] = \"ready\"\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tassigned[step.Name] = true\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tprogress = true\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tif !progress {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tbreak\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \\tsteps := make([]map[string]interface{}, 0, len(cfg.Steps))\r\n\u001b[?2004l\r\u001b[?2004h> \\tfor _, step := range cfg.Steps {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tresolved, err := substituteStaticForDryRun(step.Command, merged, captureNames)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\treturn nil, fmt.Errorf(\"step %s command: %w\", step.Name, err)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tdeps := make([]string, 0, len(step.DependsOn))\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tdeps = append(deps, step.DependsOn...)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tif deps == nil {\r"]
[2183.990662, "o", "\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tdeps = []string{}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tst := status[step.Name]\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tif st == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tst = \"blocked\"\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tsteps = append(steps, map[string]interface{}{\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\"name\":             step.Name,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.990789, "o", "\\t\\t\\t\"type\":             step.Type,\r\n\u001b[?2004l\r"]
[2183.990845, "o", "\u001b[?2004h> "]
[2183.991057, "o", "\\t\\t\\t\"resolved_command\": resolved,\r\n\u001b[?2004l\r"]
[2183.991111, "o", "\u001b[?2004h> "]
[2183.99129, "o", "\\t\\t\\t\"status\":           st,\r\n\u001b[?2004l\r"]
[2183.991347, "o", "\u001b[?2004h> "]
[2183.99153, "o", "\\t\\t\\t\"depends_on\":       deps,\r\n\u001b[?2004l\r"]
[2183.991587, "o", "\u001b[?2004h> "]
[2183.991643, "o", "\\t\\t})\r\n\u001b[?2004l\r"]
[2183.991699, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2183.991757, "o", "\u001b[?2004h> "]
[2183.992082, "o", "\\treturn map[string]interface{}{\"steps\": steps}, nil\r\n\u001b[?2004l\r"]
[2183.992139, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2183.992194, "o", "\u001b[?2004h> \r\n"]
[2183.992249, "o", "\u001b[?2004l\r\u001b[?2004h"]
