[744.514241, "o", "func runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {\r\nif err := validatePipelineConfig(cfg); err != nil {\r\nreturn nil, err\r\n}\r\nmerged := mergeParams(cfg.Parameters, params)\r\nif maxParallel <= 0 {\r\nmaxParallel = cfg.MaxParallel\r\n}\r\n"]
[744.514341, "o", "if maxParallel <= 0 {\r\nmaxParallel = 4\r\n}\r\n\r\nrunID := generateRunID()\r\nrunDir := filepath.Join(pipelineRunsDir, runID)\r\nartifactsDir := filepath.Join(runDir, \"artifacts\")\r\nif err := os.MkdirAll(artifactsDir, 0755); err != nil {\r\nreturn nil, fmt.Errorf(\"create run dir: %w\", err)\r\n}\r\n\r\nnow := time.Now()\r\nrun := &PipelineRun{\r\nID:         runID,\r\nPipeline:   cfg.Name,\r\nStatus:     \"running\",\r\nParameters: merged,\r\nStartTime:  &now,\r\nRunDir:     runDir,\r\nSteps:      make([]*StepRun, 0, len(cfg.Steps)),\r\n"]
[744.514416, "o", "}\r\nfor _, step := range cfg.Steps {\r\nrun.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: \"pending\"})\r\n}\r\nsaveRun(run)\r\n\r\nerr := executeSteps(cfg, run, tracker, merged, maxParallel)\r\nendTime := time.Now()\r\nrun.EndTime = &endTime\r\nif err != nil {\r\nrun.Status = \"failed\"\r\n} else {\r\nrun.Status = \"succeeded\"\r\n}\r\nsaveRun(run)\r\n"]
[744.514478, "o", "return run, err\r\n}\r\n\r\nfunc executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\nstepByName := make(map[string]*PipelineStep)\r\nfor _, s := range cfg.Steps {\r\nstepByName[s.Name] = s\r\n}\r\nrunStepByName := make(map[string]*StepRun)\r\nfor _, sr := range run.Steps {\r\nrunStepByName[sr.Name] = sr\r\n}\r\n\r\nartifactProducer := make(map[string]string)\r\n"]
[744.514542, "o", "for _, step := range cfg.Steps {\r\nfor _, out := range step.Outputs {\r\nartifactProducer[out] = step.Name\r\n}\r\n}\r\n\r\nvar mu sync.Mutex\r\nvar running []*PipelineStep\r\navailable := make(chan struct{}, maxParallel)\r\n\r\npending := make(map[string]bool)\r\nfor _, step := range cfg.Steps {\r\npending[step.Name] = true\r\n}\r\n\r\n"]
[744.515145, "o", "\u001b[?2004h"]
[744.515206, "o", "root@n30009:/app# "]
