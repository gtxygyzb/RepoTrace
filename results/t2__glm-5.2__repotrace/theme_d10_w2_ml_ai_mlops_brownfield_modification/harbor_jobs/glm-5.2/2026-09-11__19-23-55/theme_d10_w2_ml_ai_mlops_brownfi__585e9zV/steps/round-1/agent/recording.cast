[781.313623, "i", "cat >> pipeline.go <<'EOF'\n\nfunc handlePipeline(store *Store, tracker *Tracker, args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintln(os.Stderr, \"pipeline subcommand required\")\n\t\tos.Exit(1)\n\t}\n\n\tswitch args[0] {\n\tcase \"validate\":\n\t\tif len(args) < 2 {\n\t\t\tfmt.Fprintln(os.Stderr, \"pipeline config path required\")\n\t\t\tos.Exit(1)\n\t\t}\n\t\tcfg, err := loadPipelineConfig(args[1])\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tif err := validatePipelineConfig(cfg); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tfmt.Println(\"Pipeline is valid\")\n\n\tcase \"run\":\n\t\tif len(args) < 2 {\n\t\t\tfmt.Fprintln(os.Stderr, \"pipeline config path required\")\n\t\t\tos.Exit(1)\n\t\t}\n\t\tcfg, err := loadPipelineConfig(args[1])\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tparams := parsePipelineParams(args[2:])\n\t\tmaxParallel := 0\n\t\tif v := getFlag(args[2:], \"--max-parallel\", \"\"); v != \"\" {\n\t\t\tif n, err := strconv.Atoi(v); err == nil {\n\t\t\t\tmaxParallel"]
[781.31388, "i", " = n\n\t\t\t}\n\t\t}\n\t\trun, err := runPipeline(cfg, tracker, params, maxParallel)\n\t\tif run != nil {\n\t\t\tprintJSON(run)\n\t\t}\n\t\tif err != nil {\n\t\t\tos.Exit(1)\n\t\t}\n\n\tcase \"status\":\n\t\tif len(args) < 2 {\n\t\t\tfmt.Fprintln(os.Stderr, \"run-id required\")\n\t\t\tos.Exit(1)\n\t\t}\n\t\trun, err := loadRun(args[1])\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tprintJSON(run)\n\n\tcase \"list\":\n\t\tprintJSON(listRuns())\n\n\tcase \"artifacts\":\n\t\tif len(args) < 2 {\n\t\t\tfmt.Fprintln(os.Stderr, \"run-id required\")\n\t\t\tos.Exit(1)\n\t\t}\n\t\trun, err := loadRun(args[1])\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tvar cfg *PipelineConfig\n\t\tif cfgData, err := os.ReadFile(filepath.Join(pipelineRunsDir, args[1], \"pipeline_config.json\")); err == nil {\n\t\t\tvar c PipelineConfig\n\t\t\tif json.Unmarshal(cfgData, &c) == nil {\n\t\t\t\tcfg = &c\n\t\t\t}\n\t\t}\n\t\tprintJSON(buildArtifactManifest(run, cfg))\n\n\tcase \"resume\":\n\t\tif len(args) < 2 {\n\t\t\tfmt.Fprintln(os.Stderr, \"run-id required\")\n\t\t\tos.Exit(1)\n\t\t}\n\t\trun, err"]
[781.313978, "o", "cat >> pipeline.go <<'EOF'\r\n\u001b[?2004l\r"]
[781.314096, "i", " := resumePipeline(args[1], tracker)\n\t\tif run != nil {\n\t\t\tprintJSON(run)\n\t\t}\n\t\tif err != nil {\n\t\t\tos.Exit(1)\n\t\t}\n\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, \"Unknown pipeline subcommand: %s\\n\", args[0])\n\t\tos.Exit(1)\n\t}\n}\n\nfunc parsePipelineParams(args []string) map[string]string {\n\tparams := make(map[string]string)\n\tfor _, a := range args {\n\t\tif strings.HasPrefix(a, \"--param\") && len(a) > len(\"--param\") {\n\t\t\trest := a[len(\"--param\"):]\n\t\t\tif strings.HasPrefix(rest, \"=\") {\n\t\t\t\trest = rest[1:]\n\t\t\t}\n\t\t\tif rest == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tparts := strings.SplitN(rest, \"=\", 2)\n\t\t\tif len(parts) == 2 {\n\t\t\t\tparams[parts[0]] = parts[1]\n\t\t\t}\n\t\t}\n\t}\n\treturn params\n}\nEOF\n"]
