[67.601155, "o", "\r\n   315\t\t}\r\n   316\t}\r\n   317\t\r\n   318\tfunc handleSearch(store *Store, args []string) {\r\n   319\t\ttag := getFlag(args, \"--tag\", \"\")\r\n   320\t\tif tag == \"\" {\r\n   321\t\t\tfmt.Fprintln(os.Stderr, \"search requires --tag\")\r\n   322\t\t\tos.Exit(1)\r\n   323\t\t}\r\n   324\t\r\n   325\t\tresults := store.FindByTag(tag)\r\n   326\t\tprintJSON(results)\r\n   327\t}\r\n   328\t\r\n"]
[67.601211, "o", "   329\tfunc getFlag(args []string, flag, defaultVal string) string {\r\n   330\t\tfor i, a := range args {\r\n   331\t\t\tif a == flag && i+1 < len(args) {\r\n   332\t\t\t\treturn args[i+1]\r\n   333\t\t\t}\r\n   334\t\t}\r\n   335\t\treturn defaultVal\r\n   336\t}\r\n   337\t"]
[67.601268, "o", "\r\n   338\tfunc printJSON(v interface{}) {\r\n   339\t\tdata, err := json.MarshalIndent(v, \"\", \"  \")\r\n   340\t\tif err != nil {\r\n   341\t\t\tfmt.Fprintf(os.Stderr, \"Error: %v\\n\", err)\r\n   342\t\t\tos.Exit(1)\r\n   343\t\t}\r\n   344\t\tfmt.Println(string(data))\r\n   345\t"]
[67.601321, "o", "}\r\n"]
