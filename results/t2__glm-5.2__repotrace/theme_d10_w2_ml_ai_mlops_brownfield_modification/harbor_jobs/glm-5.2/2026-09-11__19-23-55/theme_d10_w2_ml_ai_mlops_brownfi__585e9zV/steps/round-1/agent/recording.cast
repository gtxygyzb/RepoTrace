[1986.60602, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1986.606422, "o", "func pipelineHistory(name, status string) []PipelineHistoryEntry {\r\n\u001b[?2004l\r"]
[1986.606484, "o", "\u001b[?2004h> "]
[1986.6066, "o", "\\truns := listRuns()\r\n\u001b[?2004l\r"]
[1986.606658, "o", "\u001b[?2004h> "]
[1986.606893, "o", "\\tout := make([]PipelineHistoryEntry, 0)\r\n\u001b[?2004l\r"]
[1986.606943, "o", "\u001b[?2004h> "]
[1986.607135, "o", "\\tfor _, run := range runs {\r\n\u001b[?2004l\r"]
[1986.607201, "o", "\u001b[?2004h> "]
[1986.607369, "o", "\\t\\tif run.Pipeline != name {\r\n\u001b[?2004l\r"]
[1986.607423, "o", "\u001b[?2004h> "]
[1986.607515, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[1986.607569, "o", "\u001b[?2004h> "]
[1986.607624, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.607682, "o", "\u001b[?2004h> "]
[1986.607959, "o", "\\t\\tif status != \"\" && run.Status != status {\r\n\u001b[?2004l\r"]
[1986.608012, "o", "\u001b[?2004h> "]
[1986.608121, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[1986.608176, "o", "\u001b[?2004h> "]
[1986.608231, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[1986.608285, "o", "\u001b[?2004h> "]
[1986.608392, "o", "\\t\\tduration := 0.0\r\n\u001b[?2004l\r"]
[1986.608439, "o", "\u001b[?2004h> "]
[1986.608705, "o", "\\t\\tif run.StartTime != nil && run.EndTime != nil {\r\n\u001b[?2004l\r"]
[1986.60876, "o", "\u001b[?2004h> "]
[1986.608968, "o", "\\t\\t\\tduration = run.EndTime.Sub(*run.StartTime).Seconds()\r\n\u001b[?2004l\r"]
[1986.609022, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[1986.609085, "o", "\u001b[?2004h> "]
[1986.609246, "o", "\\t\\tout = append(out, PipelineHistoryEntry{\r\n\u001b[?2004l\r"]
[1986.6093, "o", "\u001b[?2004h> "]
[1986.609406, "o", "\\t\\t\\tID:              run.ID,\r\n\u001b[?2004l\r"]
[1986.609461, "o", "\u001b[?2004h> "]
[1986.60958, "o", "\\t\\t\\tStatus:          run.Status,\r\n\u001b[?2004l\r"]
[1986.609635, "o", "\u001b[?2004h> "]
[1986.609762, "o", "\\t\\t\\tStartTime:       run.StartTime,\r\n\u001b[?2004l\r"]
[1986.609817, "o", "\u001b[?2004h> "]
[1986.609939, "o", "\\t\\t\\tEndTime:         run.EndTime,\r\n\u001b[?2004l\r"]
[1986.609993, "o", "\u001b[?2004h> "]
[1986.610111, "o", "\\t\\t\\tDurationSeconds: duration,\r\n\u001b[?2004l\r"]
[1986.610168, "o", "\u001b[?2004h> \\t\\t})\r\n\u001b[?2004l\r"]
[1986.610227, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[1986.610282, "o", "\u001b[?2004h> "]
[1986.61043, "o", "\\tsort.Slice(out, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[1986.610486, "o", "\u001b[?2004h> "]
[1986.610695, "o", "\\t\\tif out[i].StartTime == nil || out[j].StartTime == nil {\r\n\u001b[?2004l\r"]
[1986.61075, "o", "\u001b[?2004h> "]
[1986.610868, "o", "\\t\\t\\treturn out[i].ID > out[j].ID\r\n\u001b[?2004l\r"]
[1986.610924, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[1986.610982, "o", "\u001b[?2004h> "]
[1986.611181, "o", "\\t\\treturn out[i].StartTime.After(*out[j].StartTime)\r\n\u001b[?2004l\r"]
[1986.611237, "o", "\u001b[?2004h> \\t})\r\n\u001b[?2004l\r"]
[1986.611292, "o", "\u001b[?2004h> "]
[1986.611352, "o", "\\treturn out\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.611407, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.611461, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.611514, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1986.611596, "o", "assert old in s\r\n\u001b[?2004l\r"]
[1986.611651, "o", "\u001b[?2004h> "]
[1986.611781, "o", "s = s.replace(old, helpers + old, 1)\r\n\u001b[?2004l\r"]
[1986.611836, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1986.611889, "o", "> "]
[1986.611943, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h"]
