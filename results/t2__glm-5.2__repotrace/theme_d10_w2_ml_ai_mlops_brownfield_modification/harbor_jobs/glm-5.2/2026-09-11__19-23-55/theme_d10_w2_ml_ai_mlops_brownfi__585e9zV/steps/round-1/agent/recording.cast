[4301.870687, "o", "\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc main\u001b[m\u001b[K() {\r\n"]
[4301.870799, "o", "\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif len(\u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K) < 2 {\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tswitch \u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K[1] {\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\thandleModel(registry, \u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K[2:])\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\thandleExperiment(tracker, \u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K[2:])\r\n"]
[4301.870877, "o", "\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K\":\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\thandlePipeline(store, tracker, \u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K[2:])\r\n\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\thandleDataset(store, \u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K[2:])\r\n\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\thandleSearch(store, \u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K[2:])\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"Unknown command: %s\\n\", \u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K[1])\r\n"]
[4301.870969, "o", "\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Println(\"\u001b[01;31m\u001b[KCommand\u001b[m\u001b[Ks:\")\r\n"]
[4301.871039, "o", "\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Println(\"  \u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K validate <config.json>\")\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Println(\"  \u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K \u001b[01;31m\u001b[Krun\u001b[m\u001b[K [--\u001b[01;31m\u001b[Kdry-run\u001b[m\u001b[K] <config.json> [--param key=value ...] [--max-parallel N]\")\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Println(\"  \u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K graph <config.json>\")\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t"]
[4301.871147, "o", "fmt.Println(\"  \u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K history <\u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K-name> [--status <status>]\")\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Println(\"  \u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K status <\u001b[01;31m\u001b[Krun\u001b[m\u001b[K-id>\")\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Println(\"  \u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K list\")\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Println(\"  \u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K artifacts <\u001b[01;31m\u001b[Krun\u001b[m\u001b[K-id>\")\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Println(\"  \u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K resume <\u001b[01;31m\u001b[Krun\u001b[m\u001b[K-id>\")\r\n"]
[4301.871241, "o", "\u001b[32m\u001b[K365\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"\u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K subcommand required\")\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintln(os.Stderr, \"\u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K config path required\")\r\n"]
[4301.871308, "o", "\u001b[32m\u001b[K386\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Krun\u001b[m\u001b[K\":\r\n"]
[4301.871375, "o", "\u001b[32m\u001b[K391\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif a == \"--\u001b[01;31m\u001b[Kdry-run\u001b[m\u001b[K\" {\r\n\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintln(os.Stderr, \"\u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K config path required\")\r\n\u001b[32m\u001b[K435\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Krun\u001b[m\u001b[K, err := \u001b[01;31m\u001b[Krun\u001b[m\u001b[KPipeline(cfg, tracker, params, maxParallel)\r\n\u001b[32m\u001b[K436\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif \u001b[01;31m\u001b[Krun\u001b[m\u001b[K != nil {\r\n\u001b[32m\u001b[K437\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tprintJSON(\u001b[01;31m\u001b[Krun\u001b[m\u001b[K)\r\n"]
[4301.871451, "o", "\u001b[32m\u001b[K445\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintln(os.Stderr, \"\u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K config path required\")\r\n\u001b[32m\u001b[K461\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintln(os.Stderr, \"\u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K name required\")\r\n\u001b[32m\u001b[K465\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tprintJSON(\u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[KHistory(args[1], status))\r\n\u001b[32m\u001b[K469\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintln(os.Stderr, \"\u001b[01;31m\u001b[Krun\u001b[m\u001b[K-id required\")\r\n\u001b[32m\u001b[K472\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Krun\u001b[m\u001b[K, err := loadRun(args[1])\r\n"]
[4301.871528, "o", "\u001b[32m\u001b[K477\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tprintJSON(\u001b[01;31m\u001b[Krun\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K484\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintln(os.Stderr, \"\u001b[01;31m\u001b[Krun\u001b[m\u001b[K-id required\")\r\n\u001b[32m\u001b[K487\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Krun\u001b[m\u001b[K, err := loadRun(args[1])\r\n\u001b[32m\u001b[K493\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif cfgData, err := os.ReadFile(filepath.Join(\u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[KRunsDir, args[1], \"\u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K_config.json\")); err == nil {\r\n\u001b[32m\u001b[K499\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tprintJSON(buildArtifactManifest(\u001b[01;31m\u001b[Krun\u001b[m\u001b[K, cfg))\r\n\u001b[32m\u001b[K503\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintln(os.Stderr, \"\u001b[01;31m\u001b[Krun\u001b[m\u001b[K-id required\")\r\n"]
[4301.871598, "o", "\u001b[32m\u001b[K506\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Krun\u001b[m\u001b[K, err := resumePipeline(args[1], tracker)\r\n\u001b[32m\u001b[K507\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif \u001b[01;31m\u001b[Krun\u001b[m\u001b[K != nil {\r\n\u001b[32m\u001b[K508\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tprintJSON(\u001b[01;31m\u001b[Krun\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K515\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"Unknown \u001b[01;31m\u001b[Kpipeline\u001b[m\u001b[K subcommand: %s\\n\", args[0])\r\n"]
