[2183.924445, "o", "\\tfor _, step := range cfg.Steps {\r\n\u001b[?2004l\r"]
[2183.9245, "o", "\u001b[?2004h> "]
[2183.924659, "o", "\\t\\tif step.CaptureOutput != nil && step.CaptureOutput.Name != \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.924819, "o", "\\t\\t\\tcaptureNames[step.CaptureOutput.Name] = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.924875, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.924933, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r[\u001b[?2004h> "]
[2183.925076, "o", "\\tstatus := make(map[string]string)\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[2183.9252, "o", "\\tassigned := make(map[string]bool)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.925334, "o", "\\tfor len(assigned) < len(cfg.Steps) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2183.925416, "o", "\\t\\tprogress := false\r\n\u001b[?2004l\rut\u001b[?2004h> "]
[2183.925541, "o", "\\t\\tfor _, step := range cfg.Steps {\r\n\u001b[?2004l\r\u001b[?2004h> "]
