[6598.196577, "o", "   352\t}\r\n   353\t\r\n   354\tfunc executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {\r\n   355\t\tstepByName := make(map[string]*PipelineStep)\r\n   356\t\tfor _, s := range cfg.Steps {\r\n   357\t\t\tstepByName[s.Name] = s\r\n   358\t\t}\r\n   359\t\trunStepByName := make(map[string]*StepRun)\r\n   360\t\tfor _, sr := range run.Steps {\r\n   361\t\t\trunStepByName[sr.Name] = sr\r\n   362\t\t}\r\n   363\t\r\n   364\t\tvariables := make(map[string]string)\r\n"]
