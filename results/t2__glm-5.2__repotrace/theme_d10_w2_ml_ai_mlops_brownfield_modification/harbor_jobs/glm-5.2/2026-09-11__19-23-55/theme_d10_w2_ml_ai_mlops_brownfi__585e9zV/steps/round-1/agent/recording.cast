[2183.920384, "o", "\\t\\treturn \"\", false, nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[2183.920439, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2183.920497, "o", "> "]
[2183.92062, "o", "\\tif step.CaptureOutput.Regex == \"\" {\r\n\u001b[?2004l\r"]
[2183.920675, "o", "\u001b[?2004h> "]
[2183.920863, "o", "\\t\\treturn strings.TrimSpace(stdout), true, nil\r\n\u001b[?2004l\r"]
