[4018.987321, "o", "\r\n\tif run.Status == \"failed\" {\r\n\t\treturn fmt.Errorf(\"pipeline execution failed\")\r\n\t}\r\n\treturn nil\r\n}\r\nfunc removeStep(steps []*PipelineStep, target *PipelineStep) []*PipelineStep {\r\n\tout := make([]*PipelineStep, 0, len(steps))\r\n\tfor _, s := range steps {\r\n\t\tif s != target {\r\n"]
