[1484.300982, "o", "pending[step.Name] = false\r\n   365\t\t\trunning = append(running, step)\r\n   366\t\t\twg.Add(1)\r\n   367\t\t\tgo func(s *PipelineStep) {\r\n   368\t\t\t\tdefer wg.Done()\r\n   369\t\t\t\texecuteStep(cfg, run, tracker, s, params, runStepByName[s.Name])\r\n   370\t\t\t\tmu.Lock()\r\n   371\t\t\t\trunning = removeStep(running, s)\r\n   372\t\t\t\tif runStepByName[s.Name].Status == \"failed\" {\r\n   373\t\t\t\t\trun.Status = \"failed\"\r\n   374\t\t\t\t\tdone = true\r\n"]
[1484.301069, "o", "   375\t\t\t\t}\r\n   376\t\t\t\tsaveCheckpoint(run)\r\n   377\t\t\t\tsaveRun(run)\r\n   378\t\t\t\tmu.Unlock()\r\n   379\t\t\t\t<-available\r\n   380\t\t\t}(step)\r\n   381\t\t}\r\n   382\t\r\n   383\t\tfor !done && (len(pending) > 0 || len(running) > 0) {\r\n   384\t\t\tstartedAny := false\r\n   385\t\t\tvar starts []*PipelineStep\r\n"]
[1484.301154, "o", "   386\t\t\tmu.Lock()\r\n   387\t\t\tfor _, step := range cfg.Steps {\r\n   388\t\t\t\tif pending[step.Name] && canStart(step) {\r\n   389\t\t\t\t\tstarts = append(starts, step)\r\n   390\t\t\t\t}\r\n   391\t\t\t}\r\n   392\t\t\tmu.Unlock()\r\n   393\t\t\tsort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })\r\n   394\t\t\tfor _, step := range starts {\r\n   395\t\t\t\tavailable <- struct{}{}\r\n   396\t\t\t\tmu.Lock()\r\n   397"]
[1484.301223, "o", "\t\t\t\tif done || !pending[step.Name] || !canStart(step) {\r\n   398\t\t\t\t\tmu.Unlock()\r\n   399\t\t\t\t\t<-available\r\n   400\t\t\t\t\tcontinue\r\n   401\t\t\t\t}\r\n   402\t\t\t\tstartStep(step)\r\n   403\t\t\t\tmu.Unlock()\r\n   404"]
[1484.301294, "o", "\t\t\t\tstartedAny = true\r\n   405\t\t\t}\r\n   406\t\r\n   407\t\t\tif !startedAny {\r\n   408\t\t\t\tif len(running) == 0 {\r\n   409\t\t\t\t\tbreak\r\n   410\t\t\t\t}\r\n   411\t\t\t\ttime.Sleep(10 * time.Millisecond)\r\n   412\t\t\t}\r\n"]
