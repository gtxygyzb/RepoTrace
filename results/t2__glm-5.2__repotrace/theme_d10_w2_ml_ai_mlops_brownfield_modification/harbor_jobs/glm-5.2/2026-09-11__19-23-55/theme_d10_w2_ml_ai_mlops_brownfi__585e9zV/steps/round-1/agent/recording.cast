[2183.996962, "o", "func computeLevels(steps []*PipelineStep) [][]string {\r\n\u001b[?2004l\r"]
[2183.997022, "o", "\u001b[?2004h> "]
[2183.997234, "o", "\\tassigned := make(map[string]bool)\r\n\u001b[?2004l\r"]
[2183.99729, "o", "\u001b[?2004h> "]
[2183.997431, "o", "\\tvar levels [][]string\r\n\u001b[?2004l\r"]
[2183.997485, "o", "\u001b[?2004h> "]
[2183.99769, "o", "\\tfor len(assigned) < len(steps) {\r\n\u001b[?2004l\r"]
[2183.997747, "o", "\u001b[?2004h> "]
[2183.997879, "o", "\\t\\tvar level []string\r\n\u001b[?2004l\r"]
[2183.997935, "o", "\u001b[?2004h> "]
[2183.998118, "o", "\\t\\tfor _, s := range steps {\r\n\u001b[?2004l\r"]
[2183.998174, "o", "\u001b[?2004h> "]
[2183.998336, "o", "\\t\\t\\tif assigned[s.Name] {\r\n\u001b[?2004l\r"]
[2183.998392, "o", "\u001b[?2004h> "]
[2183.998493, "o", "\\t\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[2183.998548, "o", "\u001b[?2004h> "]
[2183.998601, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[2183.998657, "o", "\u001b[?2004h> "]
[2183.998757, "o", "\\t\\t\\tok := true\r\n\u001b[?2004l\r"]
[2183.998801, "o", "\u001b[?2004h> "]
[2183.999049, "o", "\\t\\t\\tfor _, dep := range s.DependsOn {\r\n\u001b[?2004l\r"]
[2183.999096, "o", "\u001b[?2004h> "]
[2183.999272, "o", "\\t\\t\\t\\tif !assigned[dep] {\r\n\u001b[?2004l\r"]
[2183.999328, "o", "\u001b[?2004h> "]
[2183.999454, "o", "\\t\\t\\t\\t\\tok = false\r\n\u001b[?2004l\r"]
[2183.99951, "o", "\u001b[?2004h> "]
[2183.999604, "o", "\\t\\t\\t\\t\\tbreak\r\n\u001b[?2004l\r"]
[2183.99966, "o", "\u001b[?2004h> "]
[2183.999725, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r"]
[2183.99978, "o", "\u001b[?2004h> "]
[2183.999831, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[2183.999886, "o", "\u001b[?2004h> "]
[2183.999972, "o", "\\t\\t\\tif ok {\r\n\u001b[?2004l\r"]
[2184.000027, "o", "\u001b[?2004h> "]
[2184.00025, "o", "\\t\\t\\t\\tlevel = append(level, s.Name)\r\n\u001b[?2004l\r"]
[2184.000304, "o", "\u001b[?2004h> "]
[2184.000359, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[2184.000414, "o", "\u001b[?2004h> "]
[2184.000469, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[2184.000524, "o", "\u001b[?2004h> "]
[2184.000716, "o", "\\t\\tif len(level) == 0 {\r\n\u001b[?2004l\r"]
[2184.00077, "o", "\u001b[?2004h> "]
[2184.000855, "o", "\\t\\t\\tbreak\r\n\u001b[?2004l\r"]
[2184.0009, "o", "\u001b[?2004h> "]
[2184.000954, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[2184.001013, "o", "\u001b[?2004h> "]
[2184.00116, "o", "\\t\\tsort.Strings(level)\r\n\u001b[?2004l\r"]
[2184.001216, "o", "\u001b[?2004h> "]
[2184.00139, "o", "\\t\\tfor _, n := range level {\r\n\u001b[?2004l\r"]
[2184.001445, "o", "\u001b[?2004h> "]
[2184.001595, "o", "\\t\\t\\tassigned[n] = true\r\n\u001b[?2004l\r"]
[2184.00165, "o", "\u001b[?2004h> "]
[2184.001708, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[2184.001763, "o", "\u001b[?2004h> "]
[2184.001945, "o", "\\t\\tlevels = append(levels, level)\r\n\u001b[?2004l\r"]
[2184.002002, "o", "\u001b[?2004h> "]
[2184.002074, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2184.002131, "o", "> "]
[2184.002194, "o", "\\treturn levels\r\n\u001b[?2004l\r"]
[2184.002248, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2184.002309, "o", "\u001b[?2004h> \r\n"]
