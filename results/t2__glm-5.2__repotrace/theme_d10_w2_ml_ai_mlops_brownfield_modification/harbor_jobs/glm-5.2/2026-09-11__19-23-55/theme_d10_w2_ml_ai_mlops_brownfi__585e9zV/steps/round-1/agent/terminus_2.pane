[?2004l   667	func mergeParams(defaults, overrides map[string]string) map[string]string {
   668		merged := make(map[string]string)
   669		for k, v := range defaults {
   670			merged[k] = v
   671		}
   672		for k, v := range overrides {
   673			merged[k] = v
   674		}
   675		return merged
   676	}
   677	
   678	func substituteParams(command string, params map[string]string) string {
   679		result := command
   680		for k, v := range params {
   681			result = strings.ReplaceAll(result, "${"+k+"}", v)
   682		}
   683		return result
   684	}
   685	
   686	func evaluateCondition(cond string, params map[string]string) (bool, error) {
   687		cond = strings.TrimSpace(cond)
   688		if cond == "" {
   689			return true, nil
   690		}
   691		if strings.Contains(cond, "==") {
   692			parts := strings.SplitN(cond, "==", 2)
   693			left := resolveParam(strings.TrimSpace(parts[0]), params)
   694			right := resolveParam(strings.TrimSpace(parts[1]), params)
   695			return left == right, nil
   696		}
   697		if strings.Contains(cond, "!=") {
   698			parts := strings.SplitN(cond, "!=", 2)
   699			left := resolveParam(strings.TrimSpace(parts[0]), params)
   700			right := resolveParam(strings.TrimSpace(parts[1]), params)
   701			return left != right, nil
   702		}
   703		return false, fmt.Errorf("invalid condition: %s", cond)
   704	}
   705	
   706	func resolveParam(token string, params map[string]string) string {
   707		re := regexp.MustCompile(`^\$\{(.+)\}$`)
   708		m := re.FindStringSubmatch(token)
   709		if m != nil {
   710			return params[m[1]]
   711		}
   712		return token
   713	}
