  1222	func buildPipelineGraph(cfg *PipelineConfig) map[string]interface{} {
  1223		nodes := make([]map[string]string, 0, len(cfg.Steps))
  1224		for _, s := range cfg.Steps {
  1225			nodes = append(nodes, map[string]string{"name": s.Name, "type": s.Type})
  1226		}
  1227	
  1228		edges := make([]map[string]string, 0)
  1229		for _, s := range cfg.Steps {
  1230			for _, dep := range s.DependsOn {
  1231				edges = append(edges, map[string]string{"from": dep, "to": s.Name})
  1232			}
  1233		}
  1234	
  1235		return map[string]interface{}{
  1236			"nodes":  nodes,
  1237			"edges":  edges,
  1238			"levels": computeLevels(cfg.Steps),
  1239		}
  1240	}
