    67	func handleModel(reg *Registry, args []string) {
    68		if len(args) < 1 {
    69			fmt.Fprintln(os.Stderr, "model subcommand required")
    70			os.Exit(1)
    71		}
    72	
    73		switch args[0] {
    74		case "register":
    75			if len(args) < 2 {
    76				fmt.Fprintln(os.Stderr, "model name required")
    77				os.Exit(1)
    78			}
    79			name := args[1]
    80			version := getFlag(args, "--version", "")
    81			framework := getFlag(args, "--framework", "unknown")
    82			description := getFlag(args, "--description", "")
    83			tagsStr := getFlag(args, "--tags", "")
    84			var tags []string
    85			if tagsStr != "" {
    86				tags = strings.Split(tagsStr, ",")
    87			}
    88	
    89			m, err := reg.Register(name, version, framework, description, tags)
    90			if err != nil {
    91				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
    92				os.Exit(1)
    93			}
    94			printJSON(m)
    95	
    96		case "list":
    97			filter := getFlag(args, "--filter", "")
    98			models := reg.store.ListModels(filter)
    99			printJSON(models)
   100	
   101		case "get":
   102			if len(args) < 3 {
   103				fmt.Fprintln(os.Stderr, "model name and version required")
   104				os.Exit(1)
   105			}
   106			m, err := reg.store.GetModel(args[1], args[2])
   107			if err != nil {
   108				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   109				os.Exit(1)
   110			}
   111			printJSON(m)
   112	
   113		case "promote":
   114			if len(args) < 4 {
   115				fmt.Fprintln(os.Stderr, "model name, version, and target status required")
   116				os.Exit(1)
   117			}
   118			err := reg.Promote(args[1], args[2], ModelStatus(args[3]))
   119			if err != nil {
   120				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   121				os.Exit(1)
   122			}
   123			fmt.Println("Model promoted successfully")
   124	
   125		case "delete":
   126			if len(args) < 3 {
   127				fmt.Fprintln(os.Stderr, "model name and version required")
   128				os.Exit(1)
   129			}
   130			if err := reg.store.DeleteModel(args[1], args[2]); err != nil {
   131				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   132				os.Exit(1)
   133			}
   134			fmt.Println("Model deleted successfully")
   135	
   136		case "compare":
   137			if len(args) < 2 {
   138				fmt.Fprintln(os.Stderr, "model name required")
   139				os.Exit(1)
   140			}
   141			models, err := reg.Compare(args[1])
   142			if err != nil {
   143				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   144				os.Exit(1)
   145			}
   146			printJSON(models)
   147	
   148		default:
   149			fmt.Fprintf(os.Stderr, "Unknown model subcommand: %s\n", args[0])
   150			os.Exit(1)
   151		}
   152	}
