const pipelineRunsDir = "/tmp/nexus/runs"

type PipelineResourceLimit struct {
	CPU      int `json:"cpu,omitempty"`
	MemoryMB int `json:"memory_mb,omitempty"`
}

type PipelineStepResources struct {
	CPU      int `json:"cpu,omitempty"`
	MemoryMB int `json:"memory_mb,omitempty"`
}

type PipelineStepRetry struct {
	MaxRetries         int `json:"max_retries,omitempty"`
	BackoffBaseSeconds int `json:"backoff_base_seconds,omitempty"`
}

type CaptureOutputConfig struct {
	Name  string `json:"name"`
	Regex string `json:"regex,omitempty"`
}

func (c *CaptureOutputConfig) UnmarshalJSON(data []byte) error {
	var str string
	if err := json.Unmarshal(data, &str); err == nil {
		c.Name = str
		c.Regex = ""
		return nil
	}
	var raw struct {
		Name  string `json:"name"`
		Regex string `json:"regex"`
	}
	if err := json.Unmarshal(data, &raw); err != nil {
		return fmt.Errorf("capture_output must be a string or an object with name and optional regex")
	}
	c.Name = raw.Name
	c.Regex = raw.Regex
	return nil
}

type PipelineExperimentConfig struct {
	Name    string            `json:"name,omitempty"`
	Params  map[string]string `json:"params,omitempty"`
	Metrics []string          `json:"metrics,omitempty"`
}

type PipelineStep struct {
	Name             string                    `json:"name"`
	Type             string                    `json:"type"`
	Command          string                    `json:"command"`
	DependsOn        []string                  `json:"depends_on,omitempty"`
	Inputs           []string                  `json:"inputs,omitempty"`
	Outputs          []string                  `json:"outputs,omitempty"`
	Resources        *PipelineStepResources    `json:"resources,omitempty"`
	TimeoutSeconds   int                       `json:"timeout_seconds,omitempty"`
	Retry            *PipelineStepRetry        `json:"retry,omitempty"`
	Condition        string                    `json:"condition,omitempty"`
	ExperimentConfig *PipelineExperimentConfig `json:"experiment_config,omitempty"`
	DatasetRef       string                    `json:"dataset_ref,omitempty"`
	CaptureOutput    *CaptureOutputConfig      `json:"capture_output,omitempty"`
	Env              map[string]string         `json:"env,omitempty"`
	AllowFailure     bool                      `json:"allow_failure,omitempty"`
}

type PipelineConfig struct {
	Name          string                 `json:"name"`
	Parameters    map[string]string      `json:"parameters,omitempty"`
	MaxParallel   int                    `json:"max_parallel,omitempty"`
	ResourceLimit *PipelineResourceLimit `json:"resource_limit,omitempty"`
	Steps         []*PipelineStep        `json:"steps"`
}

type Artifact struct {
	Name     string `json:"name"`
	Type     string `json:"type"`
	Producer string `json:"producer"`
	Path     string `json:"path"`
	Size     int64  `json:"size"`
}

type StepRun struct {
	Name         string     `json:"name"`
	Type         string     `json:"type"`
	Status       string     `json:"status"`
	StartTime    *time.Time `json:"start_time,omitempty"`
	EndTime      *time.Time `json:"end_time,omitempty"`
	ExitCode     int        `json:"exit_code,omitempty"`
	Output       string     `json:"output,omitempty"`
	Error        string     `json:"error,omitempty"`
	Artifacts    []Artifact `json:"artifacts,omitempty"`
	ExperimentID string     `json:"experiment_id,omitempty"`
	RetryCount   int        `json:"retry_count"`
}

type PipelineRun struct {
	ID         string            `json:"id"`
	Pipeline   string            `json:"pipeline"`
	Status     string            `json:"status"`
	Parameters map[string]string `json:"parameters,omitempty"`
	StartTime  *time.Time        `json:"start_time,omitempty"`
	EndTime    *time.Time        `json:"end_time,omitempty"`
	Steps      []*StepRun        `json:"steps"`
	Artifacts  []Artifact        `json:"artifacts,omitempty"`
	RunDir     string            `json:"run_dir,omitempty"`
	Variables  map[string]string `json:"variables,omitempty"`
	Warnings   []string          `json:"warnings"`
}

type Checkpoint struct {
	RunID      string            `json:"run_id"`
	Status     string            `json:"status"`
	Parameters map[string]string `json:"parameters,omitempty"`
	Steps      []*StepRun        `json:"steps"`
	Artifacts  []Artifact        `json:"artifacts,omitempty"`
	Variables  map[string]string `json:"variables,omitempty"`
	Warnings   []string          `json:"warnings"`
}

func loadPipelineConfig(path string) (*PipelineConfig, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, fmt.Errorf("read pipeline config: %w", err)
[?2004hroot@n30009:/app# sed -n '330,560p' pipeline.go
[?2004l	endTime := time.Now()
	run.EndTime = &endTime
	if err != nil {
		run.Status = "failed"
	} else if run.Status != "succeeded_with_warnings" {
