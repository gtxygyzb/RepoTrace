   130	func (s *Store) DeleteModel(name, version string) error {
   131		s.mu.Lock()
   132		defer s.mu.Unlock()
   133	
   134		key := fmt.Sprintf("%s:%s", name, version)
   135		if _, ok := s.data.Models[key]; !ok {
   136			return fmt.Errorf("model not found: %s", key)
   137		}
   138	
   139		// Referential integrity: cannot delete models referenced by experiments
   140		for _, exp := range s.data.Experiments {
   141			if exp.ModelRef == key {
   142				return fmt.Errorf("model %s is referenced by experiment %s", key, exp.ID)
   143			}
   144		}
   145	
   146		delete(s.data.Models, key)
   147		s.UpdateTagIndex("model:"+key, nil)
