  1138	func computeRunStatus(cfg *PipelineConfig, run *PipelineRun) {
  1139		warnings := []string{}
  1140		hardFailed := false
  1141		for _, step := range cfg.Steps {
  1142			sr := getRunStep(run, step.Name)
  1143			if sr == nil {
  1144				continue
  1145			}
  1146			if sr.Status == "failed" {
  1147				if step.AllowFailure {
  1148					warnings = append(warnings, step.Name)
  1149				} else {
  1150					hardFailed = true
  1151				}
  1152			}
  1153		}
  1154		sort.Strings(warnings)
  1155		run.Warnings = warnings
  1156		if hardFailed {
  1157			run.Status = "failed"
  1158		} else if len(warnings) > 0 {
  1159			run.Status = "succeeded_with_warnings"
  1160		} else {
  1161			run.Status = "succeeded"
  1162		}
  1163	}
