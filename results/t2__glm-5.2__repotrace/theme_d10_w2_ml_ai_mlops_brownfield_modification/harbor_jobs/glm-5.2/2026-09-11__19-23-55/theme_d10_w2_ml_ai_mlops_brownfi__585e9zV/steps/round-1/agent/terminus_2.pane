[?2004lpackage main

import (
	"fmt"
	"time"
)

// ModelStatus represents the lifecycle stage of a model
type ModelStatus string

const (
	ModelStatusRegistered ModelStatus = "registered"
	ModelStatusStaging    ModelStatus = "staging"
	ModelStatusProduction ModelStatus = "production"
	ModelStatusArchived   ModelStatus = "archived"
)

// Model represents an ML model in the registry
type Model struct {
	Name        string             `json:"name"`
	Version     string             `json:"version"`
	Framework   string             `json:"framework"`
	Description string             `json:"description,omitempty"`
	Tags        []string           `json:"tags,omitempty"`
	Status      ModelStatus        `json:"status"`
	Metrics     map[string]float64 `json:"metrics,omitempty"`
	CreatedAt   time.Time          `json:"created_at"`
	UpdatedAt   time.Time          `json:"updated_at"`
	ParentRef   string             `json:"parent_ref,omitempty"`
}

func (m *Model) Key() string {
	return fmt.Sprintf("%s:%s", m.Name, m.Version)
}

// ValidTransitions defines valid model lifecycle transitions
var ValidTransitions = map[ModelStatus][]ModelStatus{
	ModelStatusRegistered: {ModelStatusStaging, ModelStatusArchived},
	ModelStatusStaging:    {ModelStatusProduction, ModelStatusRegistered, ModelStatusArchived},
	ModelStatusProduction: {ModelStatusStaging, ModelStatusArchived},
	ModelStatusArchived:   {ModelStatusRegistered},
}

func (m *Model) CanTransitionTo(target ModelStatus) bool {
	allowed, ok := ValidTransitions[m.Status]
	if !ok {
		return false
	}
	for _, s := range allowed {
		if s == target {
			return true
		}
	}
	return false
}

// ExperimentStatus represents the state of an experiment run
type ExperimentStatus string

const (
	ExperimentStatusRunning   ExperimentStatus = "running"
	ExperimentStatusCompleted ExperimentStatus = "completed"
	ExperimentStatusFailed    ExperimentStatus = "failed"
)

// Experiment represents an ML experiment run
type Experiment struct {
	ID         string             `json:"id"`
	Name       string             `json:"name"`
	Status     ExperimentStatus   `json:"status"`
	Parameters map[string]string  `json:"parameters,omitempty"`
	Metrics    map[string]float64 `json:"metrics,omitempty"`
	Tags       []string           `json:"tags,omitempty"`
	ModelRef   string             `json:"model_ref,omitempty"`
	DatasetRef string             `json:"dataset_ref,omitempty"`
	StartTime  time.Time          `json:"start_time"`
	EndTime    time.Time          `json:"end_time,omitempty"`
	Notes      string             `json:"notes,omitempty"`
}

// Dataset represents a dataset version
type Dataset struct {
	Name      string    `json:"name"`
	Version   string    `json:"version"`
	Format    string    `json:"format"`
	Path      string    `json:"path"`
	RowCount  int64     `json:"row_count"`
	Schema    []Column  `json:"schema,omitempty"`
	CreatedAt time.Time `json:"created_at"`
	Checksum  string    `json:"checksum,omitempty"`
}

func (d *Dataset) Key() string {
	return fmt.Sprintf("%s:%s", d.Name, d.Version)
}

// Column represents a dataset column
type Column struct {
	Name     string `json:"name"`
	Type     string `json:"type"`
	Nullable bool   `json:"nullable"`
}

// StoreData holds all persisted data
type StoreData struct {
	Models      map[string]*Model      `json:"models"`
	Experiments map[string]*Experiment `json:"experiments"`
	Datasets    map[string]*Dataset    `json:"datasets"`
	TagIndex    map[string][]string    `json:"tag_index"`
}
[?2004hroot@n30009:/app# sed -n '1,240p' tracker.go
[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"sort"
	"time"
)

// Tracker manages experiment lifecycle
type Tracker struct {
	store   *Store
	counter int
}

func NewTracker(store *Store) *Tracker {
	t := &Tracker{store: store}
	exps := store.ListExperiments("")
	for _, exp := range exps {
		if id := extractCounter(exp.ID); id > t.counter {
			t.counter = id
		}
	}
	return t
}

func extractCounter(id string) int {
	var n int
	fmt.Sscanf(id, "exp-%d", &n)
	return n
}

func (t *Tracker) Create(name string, params map[string]string, tags []string) (*Experiment, error) {
	if name == "" {
		return nil, fmt.Errorf("experiment name is required")
	}

	t.counter++
	exp := &Experiment{
		ID:         fmt.Sprintf("exp-%04d", t.counter),
		Name:       name,
		Status:     ExperimentStatusRunning,
		Parameters: params,
		Metrics:    make(map[string]float64),
		Tags:       tags,
		StartTime:  time.Now(),
	}

	if err := t.store.SaveExperiment(exp); err != nil {
		return nil, err
	}
	return exp, nil
}

func (t *Tracker) LogMetric(id, key string, value float64) error {
	exp, err := t.store.GetExperiment(id)
	if err != nil {
		return err
	}
	if exp.Status != ExperimentStatusRunning {
		return fmt.Errorf("cannot log metrics to %s experiment", exp.Status)
	}

	exp.Metrics[key] = value
	return t.store.SaveExperiment(exp)
}

func (t *Tracker) Complete(id string, status ExperimentStatus) error {
	exp, err := t.store.GetExperiment(id)
	if err != nil {
		return err
	}
	if exp.Status != ExperimentStatusRunning {
		return fmt.Errorf("experiment %s is already %s", id, exp.Status)
	}

	exp.Status = status
	exp.EndTime = time.Now()
	return t.store.SaveExperiment(exp)
}

func (t *Tracker) CompareExperiments(ids []string) (string, error) {
	var exps []*Experiment
	for _, id := range ids {
		exp, err := t.store.GetExperiment(id)
		if err != nil {
			return "", err
		}
		exps = append(exps, exp)
	}

	metricKeys := make(map[string]bool)
	for _, exp := range exps {
		for k := range exp.Metrics {
			metricKeys[k] = true
		}
	}

	var keys []string
	for k := range metricKeys {
		keys = append(keys, k)
	}
	sort.Strings(keys)

	result := map[string]interface{}{
		"experiments": exps,
		"metric_keys": keys,
	}

	data, _ := json.MarshalIndent(result, "", "  ")
	return string(data), nil
}

func (t *Tracker) LinkModel(experimentID, modelRef string) error {
	exp, err := t.store.GetExperiment(experimentID)
	if err != nil {
		return err
	}
	exp.ModelRef = modelRef
	return t.store.SaveExperiment(exp)
}

func (t *Tracker) Export(outputPath string, format string) error {
	exps := t.store.ListExperiments("")

	switch format {
	case "json":
		data, err := json.MarshalIndent(exps, "", "  ")
		if err != nil {
			return err
		}
		return os.WriteFile(outputPath, data, 0644)
	case "csv":
		f, err := os.Create(outputPath)
		if err != nil {
			return err
		}
		defer f.Close()

		fmt.Fprintln(f, "id,name,status,start_time")
		for _, exp := range exps {
			fmt.Fprintf(f, "%s,%s,%s,%s\n", exp.ID, exp.Name, exp.Status, exp.StartTime.Format(time.RFC3339))
		}
		return nil
	default:
		return fmt.Errorf("unsupported export format: %s", format)
	}
}
