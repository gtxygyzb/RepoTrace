[?2004l   776	func evaluateCondition(cond string, vars map[string]string) (bool, error) {
   777		cond = strings.TrimSpace(cond)
   778		if cond == "" {
   779			return true, nil
   780		}
   781		if strings.Contains(cond, "==") {
   782			parts := strings.SplitN(cond, "==", 2)
   783			left, err := substituteVariables(strings.TrimSpace(parts[0]), vars)
   784			if err != nil {
   785				return false, err
   786			}
   787			right, err := substituteVariables(strings.TrimSpace(parts[1]), vars)
   788			if err != nil {
   789				return false, err
   790			}
   791			return left == right, nil
   792		}
   793		if strings.Contains(cond, "!=") {
   794			parts := strings.SplitN(cond, "!=", 2)
   795			left, err := substituteVariables(strings.TrimSpace(parts[0]), vars)
   796			if err != nil {
   797				return false, err
   798			}
   799			right, err := substituteVariables(strings.TrimSpace(parts[1]), vars)
   800			if err != nil {
   801				return false, err
   802			}
   803			return left != right, nil
   804		}
   805		return false, fmt.Errorf("invalid condition: %s", cond)
   806	}
