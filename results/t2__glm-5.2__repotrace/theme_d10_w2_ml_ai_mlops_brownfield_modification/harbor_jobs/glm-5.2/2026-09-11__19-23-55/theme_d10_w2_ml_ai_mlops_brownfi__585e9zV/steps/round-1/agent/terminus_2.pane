	for _, step := range cfg.Steps {
		sr := runStepByName[step.Name]
		if sr.Status == "succeeded" || sr.Status == "skipped" {
			continue
		}
		if sr.Status == "failed" {
			sr.Status = "pending"
			sr.Error = ""
			sr.Output = ""
			sr.StartTime = nil
			sr.EndTime = nil
		}
		pending[step.Name] = true
	}

