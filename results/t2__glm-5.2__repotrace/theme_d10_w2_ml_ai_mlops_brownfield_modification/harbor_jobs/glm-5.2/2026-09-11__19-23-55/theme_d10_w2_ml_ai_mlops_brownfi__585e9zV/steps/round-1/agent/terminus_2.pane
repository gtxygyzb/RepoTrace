   200	// === Dataset operations ===
   201	
   202	func (s *Store) SaveDataset(ds *Dataset) error {
   203		s.mu.Lock()
   204		defer s.mu.Unlock()
   205	
   206		s.data.Datasets[ds.Key()] = ds
   207		return s.save()
   208	}
   209	
   210	func (s *Store) GetDataset(name, version string) (*Dataset, error) {
   211		s.mu.RLock()
   212		defer s.mu.RUnlock()
   213	
   214		key := fmt.Sprintf("%s:%s", name, version)
   215		ds, ok := s.data.Datasets[key]
   216		if !ok {
   217			return nil, fmt.Errorf("dataset not found: %s", key)
   218		}
   219		return ds, nil
   220	}
   221	
   222	func (s *Store) ListDatasets() []*Dataset {
   223		s.mu.RLock()
   224		defer s.mu.RUnlock()
   225	
   226		var result []*Dataset
   227		for _, ds := range s.data.Datasets {
