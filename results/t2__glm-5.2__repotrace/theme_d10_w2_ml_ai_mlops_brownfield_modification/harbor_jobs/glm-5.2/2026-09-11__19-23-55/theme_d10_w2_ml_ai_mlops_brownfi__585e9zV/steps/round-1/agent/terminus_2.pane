    15		mu       sync.RWMutex
    16		data     *StoreData
    17	}
    18	
    19	func NewStore(dataDir string) (*Store, error) {
    20		if dataDir == "" {
    21			dataDir = filepath.Join(os.TempDir(), "nexus")
    22		}
    23		if err := os.MkdirAll(dataDir, 0755); err != nil {
    24			return nil, fmt.Errorf("create data directory: %w", err)
    25		}
    26	
    27		s := &Store{
    28			dataDir:  dataDir,
    29			dataFile: filepath.Join(dataDir, "nexus_data.json"),
    30			data: &StoreData{
    31				Models:      make(map[string]*Model),
    32				Experiments: make(map[string]*Experiment),
    33				Datasets:    make(map[string]*Dataset),
    34				TagIndex:    make(map[string][]string),
    35			},
    36		}
    37	
    38		if err := s.load(); err != nil && !os.IsNotExist(err) {
    39			return nil, fmt.Errorf("load store: %w", err)
    40		}
    41	
    42		return s, nil
    43	}
    44	
    45	func (s *Store) load() error {
    46		data, err := os.ReadFile(s.dataFile)
    47		if err != nil {
    48			return err
    49		}
    50		return json.Unmarshal(data, s.data)
    51	}
    52	
    53	func (s *Store) save() error {
    54		data, err := json.MarshalIndent(s.data, "", "  ")
    55		if err != nil {
    56			return fmt.Errorf("marshal data: %w", err)
    57		}
    58		tmpFile := s.dataFile + ".tmp"
    59		if err := os.WriteFile(tmpFile, data, 0644); err != nil {
    60			return fmt.Errorf("write temp file: %w", err)
    61		}
    62		return os.Rename(tmpFile, s.dataFile)
    63	}
    64	
    65	// UpdateTagIndex maintains a shared tag index across all entity types.
    66	// This index is global: a tag search returns both model and experiment keys.
    67	func (s *Store) UpdateTagIndex(entityKey string, tags []string) {
    68		for tag, keys := range s.data.TagIndex {
    69			filtered := make([]string, 0)
    70			for _, k := range keys {
    71				if k != entityKey {
    72					filtered = append(filtered, k)
    73				}
    74			}
    75			if len(filtered) == 0 {
    76				delete(s.data.TagIndex, tag)
    77			} else {
    78				s.data.TagIndex[tag] = filtered
    79			}
    80		}
    81		for _, tag := range tags {
    82			s.data.TagIndex[tag] = append(s.data.TagIndex[tag], entityKey)
    83		}
    84	}
    85	
    86	// FindByTag returns all entity keys with the given tag
    87	func (s *Store) FindByTag(tag string) []string {
    88		s.mu.RLock()
    89		defer s.mu.RUnlock()
    90		return s.data.TagIndex[tag]
    91	}
    92	
    93	// === Model operations ===
    94	
    95	func (s *Store) SaveModel(m *Model) error {
    96		s.mu.Lock()
    97		defer s.mu.Unlock()
    98	
    99		key := m.Key()
   100		s.data.Models[key] = m
   101		s.UpdateTagIndex("model:"+key, m.Tags)
   102		return s.save()
   103	}
   104	
   105	func (s *Store) GetModel(name, version string) (*Model, error) {
   106		s.mu.RLock()
   107		defer s.mu.RUnlock()
   108	
   109		key := fmt.Sprintf("%s:%s", name, version)
   110		m, ok := s.data.Models[key]
   111		if !ok {
   112			return nil, fmt.Errorf("model not found: %s", key)
   113		}
   114		return m, nil
   115	}
   116	
   117	func (s *Store) ListModels(filter string) []*Model {
   118		s.mu.RLock()
   119		defer s.mu.RUnlock()
   120	
   121		var result []*Model
   122		for _, m := range s.data.Models {
   123			if filter == "" || m.Name == filter || string(m.Status) == filter {
   124				result = append(result, m)
   125			}
   126		}
   127		return result
   128	}
   129	
   130	func (s *Store) DeleteModel(name, version string) error {
   131		s.mu.Lock()
   132		defer s.mu.Unlock()
   133	
   134		key := fmt.Sprintf("%s:%s", name, version)
   135		if _, ok := s.data.Models[key]; !ok {
   136			return fmt.Errorf("model not found: %s", key)
   137		}
   138	
   139		// Referential integrity: cannot delete models referenced by experiments
   140		for _, exp := range s.data.Experiments {
   141			if exp.ModelRef == key {
   142				return fmt.Errorf("model %s is referenced by experiment %s", key, exp.ID)
   143			}
   144		}
   145	
   146		delete(s.data.Models, key)
   147		s.UpdateTagIndex("model:"+key, nil)
   148		return s.save()
   149	}
   150	
   151	// === Experiment operations ===
   152	
   153	func (s *Store) SaveExperiment(exp *Experiment) error {
   154		s.mu.Lock()
   155		defer s.mu.Unlock()
   156	
   157		// Validate model reference if set
   158		if exp.ModelRef != "" {
   159			if _, ok := s.data.Models[exp.ModelRef]; !ok {
   160				return fmt.Errorf("referenced model not found: %s", exp.ModelRef)
   161			}
   162		}
   163	
   164		// Validate dataset reference if set
   165		if exp.DatasetRef != "" {
   166			if _, ok := s.data.Datasets[exp.DatasetRef]; !ok {
   167				return fmt.Errorf("referenced dataset not found: %s", exp.DatasetRef)
   168			}
   169		}
   170	
   171		s.data.Experiments[exp.ID] = exp
   172		s.UpdateTagIndex("experiment:"+exp.ID, exp.Tags)
   173		return s.save()
   174	}
   175	
   176	func (s *Store) GetExperiment(id string) (*Experiment, error) {
   177		s.mu.RLock()
   178		defer s.mu.RUnlock()
   179	
   180		exp, ok := s.data.Experiments[id]
   181		if !ok {
   182			return nil, fmt.Errorf("experiment not found: %s", id)
   183		}
   184		return exp, nil
   185	}
   186	
   187	func (s *Store) ListExperiments(filter string) []*Experiment {
   188		s.mu.RLock()
   189		defer s.mu.RUnlock()
   190	
   191		var result []*Experiment
   192		for _, exp := range s.data.Experiments {
   193			if filter == "" || exp.Name == filter || string(exp.Status) == filter {
   194				result = append(result, exp)
   195			}
   196		}
   197		return result
   198	}
   199	
   200	// === Dataset operations ===
   201	
   202	func (s *Store) SaveDataset(ds *Dataset) error {
   203		s.mu.Lock()
   204		defer s.mu.Unlock()
   205	
   206		s.data.Datasets[ds.Key()] = ds
   207		return s.save()
   208	}
   209	
   210	func (s *Store) GetDataset(name, version string) (*Dataset, error) {
   211		s.mu.RLock()
   212		defer s.mu.RUnlock()
   213	
   214		key := fmt.Sprintf("%s:%s", name, version)
   215		ds, ok := s.data.Datasets[key]
   216		if !ok {
   217			return nil, fmt.Errorf("dataset not found: %s", key)
   218		}
   219		return ds, nil
   220	}
   221	
   222	func (s *Store) ListDatasets() []*Dataset {
   223		s.mu.RLock()
   224		defer s.mu.RUnlock()
   225	
   226		var result []*Dataset
   227		for _, ds := range s.data.Datasets {
   228			result = append(result, ds)
   229		}
   230		return result
   231	}
