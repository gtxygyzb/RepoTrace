   286	
   287	func runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {
   288		if err := validatePipelineConfig(cfg); err != nil {
   289			return nil, err
   290		}
   291		merged := mergeParams(cfg.Parameters, params)
   292		if maxParallel <= 0 {
   293			maxParallel = cfg.MaxParallel
   294		}
   295		if maxParallel <= 0 {
   296			maxParallel = 4
   297		}
   298	
   299		runID := generateRunID()
   300		runDir := filepath.Join(pipelineRunsDir, runID)
   301		artifactsDir := filepath.Join(runDir, "artifacts")
   302		if err := os.MkdirAll(artifactsDir, 0755); err != nil {
   303			return nil, fmt.Errorf("create run dir: %w", err)
   304		}
   305		if cfgData, err := json.MarshalIndent(cfg, "", "  "); err == nil {
   306			os.WriteFile(filepath.Join(runDir, "pipeline_config.json"), cfgData, 0644)
   307		}
   308	
   309		now := time.Now()
   310		run := &PipelineRun{
   311			ID:         runID,
   312			Pipeline:   cfg.Name,
   313			Status:     "running",
   314			Parameters: merged,
   315			StartTime:  &now,
   316			RunDir:     runDir,
   317			Variables:  copyMap(merged),
   318			Steps:      make([]*StepRun, 0, len(cfg.Steps)),
   319		}
   320		for _, step := range cfg.Steps {
   321			run.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: "pending"})
   322		}
   323		saveRun(run)
   324	
   325		err := executeSteps(cfg, run, tracker, merged, maxParallel)
   326		endTime := time.Now()
   327		run.EndTime = &endTime
   328		if err != nil {
   329			run.Status = "failed"
   330		} else {
   331			run.Status = "succeeded"
   332		}
   333		saveRun(run)
   334		return run, err
   335	}
   336	
   337	func executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {
   338		stepByName := make(map[string]*PipelineStep)
   339		for _, s := range cfg.Steps {
   340			stepByName[s.Name] = s
   341		}
   342		runStepByName := make(map[string]*StepRun)
   343		for _, sr := range run.Steps {
   344			runStepByName[sr.Name] = sr
   345		}
   346	
   347		variables := make(map[string]string)
   348		if run.Variables != nil {
   349			for k, v := range run.Variables {
   350				variables[k] = v
   351			}
   352		} else {
   353			for k, v := range params {
   354				variables[k] = v
   355			}
   356		}
   357		var varMu sync.Mutex
   358	
   359		var mu sync.Mutex
   360		var running []*PipelineStep
   361		available := make(chan struct{}, maxParallel)
   362	
   363		pending := make(map[string]bool)
   364		for _, step := range cfg.Steps {
   365			sr := runStepByName[step.Name]
   366			if sr.Status == "succeeded" || sr.Status == "skipped" {
   367				continue
   368			}
   369			if sr.Status == "failed" {
   370				sr.Status = "pending"
   371				sr.Error = ""
   372				sr.Output = ""
   373				sr.StartTime = nil
   374				sr.EndTime = nil
   375			}
   376			pending[step.Name] = true
   377		}
   378	
   379		var wg sync.WaitGroup
   380		done := false
   381	
   382		canStart := func(step *PipelineStep) bool {
   383			for _, dep := range step.DependsOn {
   384				status := runStepByName[dep].Status
   385				if status != "succeeded" && status != "skipped" {
   386					return false
   387				}
   388			}
   389			if step.Resources != nil && cfg.ResourceLimit != nil {
   390				var cpu, mem int
   391				for _, r := range running {
   392					if r.Resources != nil {
   393						cpu += r.Resources.CPU
   394						mem += r.Resources.MemoryMB
   395					}
   396				}
   397				if cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {
   398					return false
   399				}
   400			}
   401			return true
   402		}
   403	
   404		startStep := func(step *PipelineStep) {
   405			pending[step.Name] = false
   406			running = append(running, step)
   407			wg.Add(1)
   408			go func(s *PipelineStep) {
   409				defer wg.Done()
   410				executeStep(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])
   411				mu.Lock()
   412				running = removeStep(running, s)
   413				if runStepByName[s.Name].Status == "failed" {
   414					run.Status = "failed"
   415					done = true
   416				}
   417				varMu.Lock()
   418				run.Variables = copyMap(variables)
   419				varMu.Unlock()
   420				saveCheckpoint(run)
   421				saveRun(run)
   422				mu.Unlock()
   423				<-available
   424			}(step)
   425		}
   426	
   427		for !done && (len(pending) > 0 || len(running) > 0) {
   428			startedAny := false
   429			var starts []*PipelineStep
   430			mu.Lock()
   431			for _, step := range cfg.Steps {
   432				if pending[step.Name] && canStart(step) {
   433					starts = append(starts, step)
   434				}
   435			}
   436			mu.Unlock()
   437			sort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })
   438			for _, step := range starts {
   439				available <- struct{}{}
   440				mu.Lock()
   441				if done || !pending[step.Name] || !canStart(step) {
   442					mu.Unlock()
   443					<-available
   444					continue
   445				}
   446				startStep(step)
   447				mu.Unlock()
   448				startedAny = true
   449			}
   450	
   451			if !startedAny {
   452				if len(running) == 0 {
   453					break
   454				}
   455				time.Sleep(10 * time.Millisecond)
   456			}
   457		}
   458		wg.Wait()
   459	
   460		for _, sr := range run.Steps {
   461			if sr.Status == "pending" {
   462				sr.Status = "failed"
   463				sr.Error = "dependency failed"
   464			}
   465		}
   466		varMu.Lock()
   467		run.Variables = copyMap(variables)
   468		varMu.Unlock()
   469		saveCheckpoint(run)
   470		saveRun(run)
