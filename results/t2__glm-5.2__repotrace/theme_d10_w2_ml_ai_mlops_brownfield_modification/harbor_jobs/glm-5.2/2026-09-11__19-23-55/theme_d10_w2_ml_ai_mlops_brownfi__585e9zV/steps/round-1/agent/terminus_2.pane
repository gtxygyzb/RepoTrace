   457	
   458	func parsePipelineParams(args []string) map[string]string {
   459		params := make(map[string]string)
   460		for _, a := range args {
   461			if strings.HasPrefix(a, "--param") && len(a) > len("--param") {
   462				rest := a[len("--param"):]
   463				if strings.HasPrefix(rest, "=") {
   464					rest = rest[1:]
   465				}
   466				if rest == "" {
   467					continue
   468				}
   469				parts := strings.SplitN(rest, "=", 2)
   470				if len(parts) == 2 {
   471					params[parts[0]] = parts[1]
   472				}
   473			}
   474		}
   475		return params
   476	}
