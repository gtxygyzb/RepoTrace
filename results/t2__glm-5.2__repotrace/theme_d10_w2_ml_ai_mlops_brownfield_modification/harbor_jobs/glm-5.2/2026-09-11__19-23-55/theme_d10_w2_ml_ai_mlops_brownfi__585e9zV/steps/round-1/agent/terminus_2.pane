  1042	var variableTokenRe = regexp.MustCompile(`\$\{([^}]*)\}`)
  1043	
  1044	func splitVariableDefault(content string) (string, string, bool) {
  1045		if idx := strings.Index(content, ":-"); idx >= 0 {
  1046			return content[:idx], content[idx+2:], true
  1047		}
  1048		return content, "", false
  1049	}
  1050	
  1051	func substituteVariables(command string, vars map[string]string) (string, error) {
  1052		var firstErr error
  1053		result := variableTokenRe.ReplaceAllStringFunc(command, func(token string) string {
  1054			content := token[2 : len(token)-1]
  1055			name, defaultVal, hasDefault := splitVariableDefault(content)
  1056			if hasDefault && strings.Contains(defaultVal, "${") {
  1057				if firstErr == nil {
  1058					firstErr = fmt.Errorf("default value for variable %s cannot contain nested ${...} references", name)
  1059				}
  1060				return token
  1061			}
  1062			if val, ok := vars[name]; ok {
  1063				return val
  1064			}
  1065			if hasDefault {
  1066				return defaultVal
  1067			}
  1068			if firstErr == nil {
  1069				firstErr = fmt.Errorf("unresolved variable: %s", token)
  1070			}
  1071			return token
  1072		})
  1073		if firstErr != nil {
  1074			return result, firstErr
  1075		}
  1076		return result, nil
  1077	}
  1078	
  1079	func substituteStaticForDryRun(command string, params map[string]string, captureNames map[string]bool) (string, error) {
  1080		var firstErr error
  1081		result := variableTokenRe.ReplaceAllStringFunc(command, func(token string) string {
  1082			content := token[2 : len(token)-1]
  1083			name, defaultVal, hasDefault := splitVariableDefault(content)
  1084			if hasDefault && strings.Contains(defaultVal, "${") {
  1085				if firstErr == nil {
  1086					firstErr = fmt.Errorf("default value for variable %s cannot contain nested ${...} references", name)
  1087				}
  1088				return token
  1089			}
  1090			if captureNames[name] {
  1091				return token
  1092			}
  1093			if val, ok := params[name]; ok {
  1094				return val
  1095			}
  1096			if hasDefault {
  1097				return defaultVal
  1098			}
  1099			if firstErr == nil {
  1100				firstErr = fmt.Errorf("unresolved variable: %s", token)
  1101			}
  1102			return token
  1103		})
  1104		if firstErr != nil {
  1105			return result, firstErr
  1106		}
  1107		return result, nil
  1108	}
