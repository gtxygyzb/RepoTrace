   308	func executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {
   309		stepByName := make(map[string]*PipelineStep)
   310		for _, s := range cfg.Steps {
   311			stepByName[s.Name] = s
   312		}
   313		runStepByName := make(map[string]*StepRun)
   314		for _, sr := range run.Steps {
   315			runStepByName[sr.Name] = sr
   316		}
   317	
   318		var mu sync.Mutex
   319		var running []*PipelineStep
   320		available := make(chan struct{}, maxParallel)
   321	
   322		pending := make(map[string]bool)
   323		for _, step := range cfg.Steps {
   324			sr := runStepByName[step.Name]
   325			if sr.Status == "succeeded" || sr.Status == "skipped" {
   326				continue
   327			}
   328			if sr.Status == "failed" {
   329				sr.Status = "pending"
   330				sr.Error = ""
   331				sr.Output = ""
   332				sr.StartTime = nil
   333				sr.EndTime = nil
   334			}
   335			pending[step.Name] = true
   336		}
   337	
   338		var wg sync.WaitGroup
   339		done := false
   340	
   341		canStart := func(step *PipelineStep) bool {
   342			for _, dep := range step.DependsOn {
   343				status := runStepByName[dep].Status
   344				if status != "succeeded" && status != "skipped" {
   345					return false
   346				}
   347			}
   348			if step.Resources != nil && cfg.ResourceLimit != nil {
   349				var cpu, mem int
   350				for _, r := range running {
   351					if r.Resources != nil {
   352						cpu += r.Resources.CPU
   353						mem += r.Resources.MemoryMB
   354					}
   355				}
   356				if cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {
   357					return false
   358				}
   359			}
   360			return true
[?2004hroot@n30009:/app# nl -ba pipeline.go | sed -n '360,440p'
[?2004l   360			return true
   361		}
   362	
   363		startStep := func(step *PipelineStep) {
   364			pending[step.Name] = false
   365			running = append(running, step)
   366			wg.Add(1)
   367			go func(s *PipelineStep) {
   368				defer wg.Done()
   369				executeStep(cfg, run, tracker, s, params, runStepByName[s.Name])
   370				mu.Lock()
   371				running = removeStep(running, s)
   372				if runStepByName[s.Name].Status == "failed" {
   373					run.Status = "failed"
   374					done = true
   375				}
   376				saveCheckpoint(run)
   377				saveRun(run)
   378				mu.Unlock()
   379				<-available
   380			}(step)
   381		}
   382	
   383		for !done && (len(pending) > 0 || len(running) > 0) {
   384			startedAny := false
   385			var starts []*PipelineStep
   386			mu.Lock()
   387			for _, step := range cfg.Steps {
   388				if pending[step.Name] && canStart(step) {
   389					starts = append(starts, step)
   390				}
   391			}
   392			mu.Unlock()
   393			sort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })
   394			for _, step := range starts {
   395				available <- struct{}{}
   396				mu.Lock()
   397				if done || !pending[step.Name] || !canStart(step) {
   398					mu.Unlock()
   399					<-available
   400					continue
   401				}
   402				startStep(step)
   403				mu.Unlock()
   404				startedAny = true
   405			}
   406	
   407			if !startedAny {
   408				if len(running) == 0 {
   409					break
   410				}
   411				time.Sleep(10 * time.Millisecond)
   412			}
   413		}
   414		wg.Wait()
   415	
   416		for _, sr := range run.Steps {
   417			if sr.Status == "pending" {
   418				sr.Status = "failed"
   419				sr.Error = "dependency failed"
   420			}
