    35	type CaptureOutputConfig struct {
    36		Name  string `json:"name"`
    37		Regex string `json:"regex,omitempty"`
    38	}
    39	
    40	func (c *CaptureOutputConfig) UnmarshalJSON(data []byte) error {
    41		var str string
    42		if err := json.Unmarshal(data, &str); err == nil {
    43			c.Name = str
    44			c.Regex = ""
    45			return nil
    46		}
    47		var raw struct {
    48			Name  string `json:"name"`
    49			Regex string `json:"regex"`
    50		}
    51		if err := json.Unmarshal(data, &raw); err != nil {
    52			return fmt.Errorf("capture_output must be a string or an object with name and optional regex")
    53		}
    54		c.Name = raw.Name
    55		c.Regex = raw.Regex
    56		return nil
    57	}
    58	
