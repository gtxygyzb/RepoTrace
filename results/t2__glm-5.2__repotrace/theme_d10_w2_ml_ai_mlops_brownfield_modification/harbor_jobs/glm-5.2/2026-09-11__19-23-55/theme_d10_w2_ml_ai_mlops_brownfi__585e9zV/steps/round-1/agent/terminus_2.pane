[?2004lfunc executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {
	for _, dep := range step.DependsOn {
		depStatus := getRunStep(run, dep).Status
		if depStatus == "succeeded" || depStatus == "skipped" {
			continue
		}
		if depStatus == "failed" {
			depStep := getStepConfig(cfg, dep)
			if depStep != nil && depStep.AllowFailure {
				continue
			}
		}
		sr.Status = "failed"
		sr.Error = "dependency failed"
		return
	}

	varMu.Lock()
	vars := copyMap(variables)
	varMu.Unlock()

	if step.Condition != "" {
		cond, err := evaluateCondition(step.Condition, vars)
		if err != nil {
			sr.Status = "failed"
			sr.Error = err.Error()
			return
		}
		if !cond {
			sr.Status = "skipped"
			sr.Output = "condition false"
			sr.Stdout = ""
			return
		}
	}

	cmdStr, err := substituteVariables(step.Command, vars)
	if err != nil {
		sr.Status = "failed"
		sr.Error = err.Error()
		return
	}

	envVars := os.Environ()
	for k, v := range vars {
		envVars = append(envVars, "NEXUS_PARAM_"+k+"="+v)
	}
	for k, v := range step.Env {
		ev, err := substituteVariables(v, vars)
		if err != nil {
			sr.Status = "failed"
			sr.Error = fmt.Sprintf("env %s: %v", k, err)
			return
		}
		envVars = append(envVars, k+"="+ev)
	}

	maxRetries := 0
	backoffBase := 1
	if step.Retry != nil {
		maxRetries = step.Retry.MaxRetries
		if step.Retry.BackoffBaseSeconds > 0 {
			backoffBase = step.Retry.BackoffBaseSeconds
		}
	}

	var exp *Experiment
	if step.Type == "train" {
		var err error
		exp, err = createTrainExperiment(tracker, step, sr.ExperimentID)
		if err != nil {
			sr.Status = "failed"
			sr.Error = err.Error()
			return
		}
		sr.ExperimentID = exp.ID
	}

	for attempt := 0; attempt <= maxRetries; attempt++ {
		start := time.Now()
		sr.StartTime = &start
		sr.RetryCount = attempt
		stdout, stderr, exitCode, err := runShellCommand(cmdStr, step.TimeoutSeconds, envVars)
		sr.Stdout = stdout
		sr.Output = stdout
		if stderr != "" {
			if sr.Output != "" {
				sr.Output += "\n"
			}
			sr.Output += stderr
		}
		sr.ExitCode = exitCode
		if err == nil {
			sr.EndTime = nowPtr()
			sr.Status = "succeeded"
			sr.Error = ""
			produceArtifacts(run, step, sr, stdout)
			if step.Type == "train" && exp != nil {
				if terr := finishTrainExperiment(tracker, exp, step, stdout); terr != nil {
					sr.Status = "failed"
					sr.Error = terr.Error()
					return
				}
			}
			if step.Type == "evaluate" {
				registerEvaluateArtifacts(run, step, sr)
			}
			if step.CaptureOutput != nil {
				val, ok, cerr := captureOutputValue(step, stdout)
				if cerr != nil {
					sr.Status = "failed"
					sr.Error = cerr.Error()
					return
				}
				if ok {
					varMu.Lock()
					variables[step.CaptureOutput.Name] = val
					varMu.Unlock()
				}
			}
			return
		}
		sr.Error = err.Error()
		if step.Type == "train" && exp != nil {
			tracker.Complete(exp.ID, ExperimentStatusFailed)
		}
		if attempt < maxRetries {
			delay := time.Duration(math.Pow(float64(backoffBase), float64(attempt+1))) * time.Second
			time.Sleep(delay)
		}
	}
	sr.EndTime = nowPtr()
	sr.Status = "failed"
}
func getRunStep(run *PipelineRun, name string) *StepRun {
	for _, sr := range run.Steps {
		if sr.Name == name {
			return sr
		}
	}
	return nil
}

func stepRunOutputValue(sr *StepRun) string {
	if sr == nil || sr.Status != "succeeded" {
		return ""
	}
	return strings.TrimSpace(sr.Stdout)
}

func stepRunDurationValue(sr *StepRun) string {
	if sr == nil || sr.StartTime == nil || sr.EndTime == nil {
		return "0.00"
	}
	return fmt.Sprintf("%.2f", sr.EndTime.Sub(*sr.StartTime).Seconds())
}

func getStepConfig(cfg *PipelineConfig, name string) *PipelineStep {
	for _, step := range cfg.Steps {
		if step.Name == name {
			return step
		}
	}
