[?2004l     1	package main
     2	
     3	import (
     4		"fmt"
     5		"time"
     6	)
     7	
     8	// ModelStatus represents the lifecycle stage of a model
     9	type ModelStatus string
    10	
    11	const (
    12		ModelStatusRegistered ModelStatus = "registered"
    13		ModelStatusStaging    ModelStatus = "staging"
    14		ModelStatusProduction ModelStatus = "production"
    15		ModelStatusArchived   ModelStatus = "archived"
    16	)
    17	
    18	// Model represents an ML model in the registry
    19	type Model struct {
    20		Name        string             `json:"name"`
    21		Version     string             `json:"version"`
    22		Framework   string             `json:"framework"`
    23		Description string             `json:"description,omitempty"`
    24		Tags        []string           `json:"tags,omitempty"`
    25		Status      ModelStatus        `json:"status"`
    26		Metrics     map[string]float64 `json:"metrics,omitempty"`
    27		CreatedAt   time.Time          `json:"created_at"`
    28		UpdatedAt   time.Time          `json:"updated_at"`
    29		ParentRef   string             `json:"parent_ref,omitempty"`
    30	}
    31	
    32	func (m *Model) Key() string {
    33		return fmt.Sprintf("%s:%s", m.Name, m.Version)
    34	}
    35	
    36	// ValidTransitions defines valid model lifecycle transitions
    37	var ValidTransitions = map[ModelStatus][]ModelStatus{
    38		ModelStatusRegistered: {ModelStatusStaging, ModelStatusArchived},
    39		ModelStatusStaging:    {ModelStatusProduction, ModelStatusRegistered, ModelStatusArchived},
    40		ModelStatusProduction: {ModelStatusStaging, ModelStatusArchived},
    41		ModelStatusArchived:   {ModelStatusRegistered},
    42	}
    43	
    44	func (m *Model) CanTransitionTo(target ModelStatus) bool {
    45		allowed, ok := ValidTransitions[m.Status]
    46		if !ok {
    47			return false
    48		}
    49		for _, s := range allowed {
    50			if s == target {
    51				return true
    52			}
    53		}
    54		return false
    55	}
    56	
    57	// ExperimentStatus represents the state of an experiment run
    58	type ExperimentStatus string
    59	
    60	const (
    61		ExperimentStatusRunning   ExperimentStatus = "running"
    62		ExperimentStatusCompleted ExperimentStatus = "completed"
    63		ExperimentStatusFailed    ExperimentStatus = "failed"
    64	)
    65	
    66	// Experiment represents an ML experiment run
    67	type Experiment struct {
    68		ID         string             `json:"id"`
    69		Name       string             `json:"name"`
    70		Status     ExperimentStatus   `json:"status"`
    71		Parameters map[string]string  `json:"parameters,omitempty"`
    72		Metrics    map[string]float64 `json:"metrics,omitempty"`
    73		Tags       []string           `json:"tags,omitempty"`
    74		ModelRef   string             `json:"model_ref,omitempty"`
    75		DatasetRef string             `json:"dataset_ref,omitempty"`
    76		StartTime  time.Time          `json:"start_time"`
    77		EndTime    time.Time          `json:"end_time,omitempty"`
    78		Notes      string             `json:"notes,omitempty"`
    79	}
    80	
    81	// Dataset represents a dataset version
    82	type Dataset struct {
    83		Name      string    `json:"name"`
    84		Version   string    `json:"version"`
    85		Format    string    `json:"format"`
    86		Path      string    `json:"path"`
    87		RowCount  int64     `json:"row_count"`
    88		Schema    []Column  `json:"schema,omitempty"`
    89		CreatedAt time.Time `json:"created_at"`
    90		Checksum  string    `json:"checksum,omitempty"`
    91	}
    92	
    93	func (d *Dataset) Key() string {
    94		return fmt.Sprintf("%s:%s", d.Name, d.Version)
    95	}
    96	
    97	// Column represents a dataset column
    98	type Column struct {
    99		Name     string `json:"name"`
   100		Type     string `json:"type"`
   101		Nullable bool   `json:"nullable"`
   102	}
   103	
   104	// StoreData holds all persisted data
   105	type StoreData struct {
   106		Models      map[string]*Model      `json:"models"`
   107		Experiments map[string]*Experiment `json:"experiments"`
   108		Datasets    map[string]*Dataset    `json:"datasets"`
   109		TagIndex    map[string][]string    `json:"tag_index"`
   110	}
[?2004hroot@n30009:/app# nl -ba tracker.go | sed -n '1,220p'
[?2004l     1	package main
     2	
     3	import (
     4		"encoding/json"
     5		"fmt"
     6		"os"
     7		"sort"
     8		"time"
     9	)
    10	
    11	// Tracker manages experiment lifecycle
    12	type Tracker struct {
    13		store   *Store
    14		counter int
    15	}
    16	
    17	func NewTracker(store *Store) *Tracker {
    18		t := &Tracker{store: store}
    19		exps := store.ListExperiments("")
    20		for _, exp := range exps {
    21			if id := extractCounter(exp.ID); id > t.counter {
    22				t.counter = id
    23			}
    24		}
    25		return t
    26	}
    27	
    28	func extractCounter(id string) int {
    29		var n int
    30		fmt.Sscanf(id, "exp-%d", &n)
    31		return n
    32	}
    33	
    34	func (t *Tracker) Create(name string, params map[string]string, tags []string) (*Experiment, error) {
    35		if name == "" {
    36			return nil, fmt.Errorf("experiment name is required")
    37		}
    38	
    39		t.counter++
    40		exp := &Experiment{
    41			ID:         fmt.Sprintf("exp-%04d", t.counter),
    42			Name:       name,
    43			Status:     ExperimentStatusRunning,
    44			Parameters: params,
    45			Metrics:    make(map[string]float64),
    46			Tags:       tags,
    47			StartTime:  time.Now(),
    48		}
    49	
    50		if err := t.store.SaveExperiment(exp); err != nil {
    51			return nil, err
    52		}
    53		return exp, nil
    54	}
    55	
    56	func (t *Tracker) LogMetric(id, key string, value float64) error {
    57		exp, err := t.store.GetExperiment(id)
    58		if err != nil {
    59			return err
    60		}
    61		if exp.Status != ExperimentStatusRunning {
    62			return fmt.Errorf("cannot log metrics to %s experiment", exp.Status)
    63		}
    64	
    65		exp.Metrics[key] = value
    66		return t.store.SaveExperiment(exp)
    67	}
    68	
    69	func (t *Tracker) Complete(id string, status ExperimentStatus) error {
    70		exp, err := t.store.GetExperiment(id)
    71		if err != nil {
    72			return err
    73		}
    74		if exp.Status != ExperimentStatusRunning {
    75			return fmt.Errorf("experiment %s is already %s", id, exp.Status)
    76		}
    77	
    78		exp.Status = status
    79		exp.EndTime = time.Now()
    80		return t.store.SaveExperiment(exp)
    81	}
    82	
    83	func (t *Tracker) CompareExperiments(ids []string) (string, error) {
    84		var exps []*Experiment
    85		for _, id := range ids {
    86			exp, err := t.store.GetExperiment(id)
    87			if err != nil {
    88				return "", err
    89			}
    90			exps = append(exps, exp)
    91		}
    92	
    93		metricKeys := make(map[string]bool)
    94		for _, exp := range exps {
    95			for k := range exp.Metrics {
    96				metricKeys[k] = true
    97			}
    98		}
    99	
   100		var keys []string
   101		for k := range metricKeys {
   102			keys = append(keys, k)
   103		}
   104		sort.Strings(keys)
   105	
   106		result := map[string]interface{}{
   107			"experiments": exps,
   108			"metric_keys": keys,
   109		}
   110	
   111		data, _ := json.MarshalIndent(result, "", "  ")
   112		return string(data), nil
   113	}
   114	
   115	func (t *Tracker) LinkModel(experimentID, modelRef string) error {
   116		exp, err := t.store.GetExperiment(experimentID)
   117		if err != nil {
   118			return err
   119		}
   120		exp.ModelRef = modelRef
   121		return t.store.SaveExperiment(exp)
   122	}
   123	
   124	func (t *Tracker) Export(outputPath string, format string) error {
   125		exps := t.store.ListExperiments("")
   126	
   127		switch format {
   128		case "json":
   129			data, err := json.MarshalIndent(exps, "", "  ")
   130			if err != nil {
   131				return err
   132			}
   133			return os.WriteFile(outputPath, data, 0644)
   134		case "csv":
   135			f, err := os.Create(outputPath)
   136			if err != nil {
   137				return err
   138			}
   139			defer f.Close()
   140	
   141			fmt.Fprintln(f, "id,name,status,start_time")
   142			for _, exp := range exps {
   143				fmt.Fprintf(f, "%s,%s,%s,%s\n", exp.ID, exp.Name, exp.Status, exp.StartTime.Format(time.RFC3339))
   144			}
   145			return nil
   146		default:
   147			return fmt.Errorf("unsupported export format: %s", format)
   148		}
   149	}
