new_run = '''\tcase "run":
\t\tdryRun := false
\t\tvar configPath string
\t\tfor _, a := range args[1:] {
\t\t\tif a == "--dry-run" {
\t\t\t\tdryRun = true
\t\t\t} else if configPath == "" && !strings.HasPrefix(a, "--") {
\t\t\t\tconfigPath = a
\t\t\t}
\t\t}
\t\tif configPath == "" {
\t\t\tfmt.Fprintln(os.Stderr, "pipeline config path required")
\t\t\tos.Exit(1)
\t\t}
\t\tcfg, err := loadPipelineConfig(configPath)
\t\tif err != nil {
\t\t\tfmt.Fprintf(os.Stderr, "Error: %v\\n", err)
\t\t\tos.Exit(1)
\t\t}
\t\tparams := parsePipelineParams(args[1:])
\t\tif dryRun {
\t\t\tplan, err := dryRunPipeline(cfg, params)
\t\t\tif err != nil {
\t\t\t\tfmt.Fprintf(os.Stderr, "Error: %v\\n", err)
\t\t\t\tos.Exit(1)
\t\t\t}
\t\t\tprintJSON(plan)
\t\t\treturn
\t\t}
\t\tmaxParallel := 0
\t\tif v := getFlag(args[1:], "--max-parallel", ""); v != "" {
\t\t\tif n, err := strconv.Atoi(v); err == nil {
\t\t\t\tmaxParallel = n
\t\t\t}
\t\t}
\t\trun, err := runPipeline(cfg, tracker, params, maxParallel)
\t\tif run != nil {
\t\t\tprintJSON(run)
\t\t}
\t\tif err != nil {
\t\t\tos.Exit(1)
\t\t}
'''
assert old_run in s
s = s.replace(old_run, new_run, 1)

# Add graph and history cases before status case
old_status = '''\tcase "status":
\t\tif len(args) < 2 {
\t\t\tfmt.Fprintln(os.Stderr, "run-id required")
\t\t\tos.Exit(1)
\t\t}
'''
new_status = '''\tcase "graph":
\t\tif len(args) < 2 {
\t\t\tfmt.Fprintln(os.Stderr, "pipeline config path required")
\t\t\tos.Exit(1)
\t\t}
\t\tcfg, err := loadPipelineConfig(args[1])
\t\tif err != nil {
\t\t\tfmt.Fprintf(os.Stderr, "Error: %v\\n", err)
\t\t\tos.Exit(1)
\t\t}
\t\tif err := validatePipelineConfig(cfg); err != nil {
\t\t\tfmt.Fprintf(os.Stderr, "Error: %v\\n", err)
\t\t\tos.Exit(1)
\t\t}
\t\tprintJSON(buildPipelineGraph(cfg))

\tcase "history":
\t\tif len(args) < 2 {
\t\t\tfmt.Fprintln(os.Stderr, "pipeline name required")
\t\t\tos.Exit(1)
\t\t}
\t\tstatus := getFlag(args[2:], "--status", "")
\t\tprintJSON(pipelineHistory(args[1], status))

\tcase "status":
\t\tif len(args) < 2 {
\t\t\tfmt.Fprintln(os.Stderr, "run-id required")
\t\t\tos.Exit(1)
\t\t}
'''
assert old_status in s
s = s.replace(old_status, new_status, 1)

p.write_text(s)
