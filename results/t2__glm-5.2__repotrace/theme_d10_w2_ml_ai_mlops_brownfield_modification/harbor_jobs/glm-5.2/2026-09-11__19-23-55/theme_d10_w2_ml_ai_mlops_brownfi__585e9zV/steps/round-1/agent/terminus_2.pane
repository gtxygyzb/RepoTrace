   606	func getRunStep(run *PipelineRun, name string) *StepRun {
   607		for _, sr := range run.Steps {
   608			if sr.Name == name {
   609				return sr
   610			}
   611		}
   612		return nil
   613	}
   614	
   615	func createTrainExperiment(tracker *Tracker, step *PipelineStep, existingID string) (*Experiment, error) {
   616		expName := step.Name
   617		var params map[string]string
   618		var tags []string
   619		if step.ExperimentConfig != nil {
   620			if step.ExperimentConfig.Name != "" {
   621				expName = step.ExperimentConfig.Name
   622			}
   623			params = step.ExperimentConfig.Params
   624		}
   625		if existingID != "" {
   626			if exp, err := tracker.store.GetExperiment(existingID); err == nil {
   627				return exp, nil
   628			}
   629		}
   630		return tracker.Create(expName, params, tags)
   631	}
   632	
   633	func finishTrainExperiment(tracker *Tracker, exp *Experiment, step *PipelineStep, output string) error {
   634		for _, line := range strings.Split(output, "\n") {
   635			key, value, ok := parseMetricLine(line)
   636			if !ok {
   637				continue
   638			}
   639			if len(step.ExperimentConfig.Metrics) > 0 && !containsString(step.ExperimentConfig.Metrics, key) {
   640				continue
   641			}
   642			if err := tracker.LogMetric(exp.ID, key, value); err != nil {
   643				return err
   644			}
   645		}
   646		return tracker.Complete(exp.ID, ExperimentStatusCompleted)
   647	}
   648	
   649	func parseMetricLine(line string) (string, float64, bool) {
   650		parts := strings.SplitN(line, "=", 2)
   651		if len(parts) != 2 {
   652			return "", 0, false
   653		}
   654		key := strings.TrimSpace(parts[0])
   655		val := strings.TrimSpace(parts[1])
   656		if key == "" {
   657			return "", 0, false
   658		}
   659		value, err := strconv.ParseFloat(val, 64)
   660		if err != nil {
   661			return "", 0, false
   662		}
   663		return key, value, true
   664	}
   665	
   666	func runShellCommand(command string, timeoutSeconds int, env []string) (string, int, error) {
   667		cmd := exec.Command("sh", "-c", command)
   668		if env != nil {
   669			cmd.Env = env
   670		}
   671		var out strings.Builder
   672		cmd.Stdout = &out
   673		cmd.Stderr = &out
   674	
   675		if timeoutSeconds > 0 {
   676			timer := time.AfterFunc(time.Duration(timeoutSeconds)*time.Second, func() {
   677				if cmd.Process != nil {
   678					cmd.Process.Kill()
   679				}
   680			})
   681			defer timer.Stop()
   682		}
   683	
   684		err := cmd.Run()
   685		exitCode := 0
   686		if err != nil {
   687			if exitErr, ok := err.(*exec.ExitError); ok {
   688				exitCode = exitErr.ExitCode()
   689			} else {
   690				exitCode = 1
   691			}
   692			return out.String(), exitCode, fmt.Errorf("command failed: %s", err.Error())
   693		}
   694		return out.String(), exitCode, nil
   695	}
