var variableTokenRe = regexp.MustCompile(`\$\{([^}]*)\}`)

func splitVariableDefault(content string) (string, string, bool) {
	if idx := strings.Index(content, ":-"); idx >= 0 {
		return content[:idx], content[idx+2:], true
	}
	return content, "", false
}

func substituteVariables(command string, vars map[string]string) (string, error) {
	var firstErr error
	result := variableTokenRe.ReplaceAllStringFunc(command, func(token string) string {
		content := token[2 : len(token)-1]
		name, defaultVal, hasDefault := splitVariableDefault(content)
		if hasDefault && strings.Contains(defaultVal, "${") {
			if firstErr == nil {
				firstErr = fmt.Errorf("default value for variable %s cannot contain nested ${...} references", name)
			}
			return token
		}
		if val, ok := vars[name]; ok {
			return val
		}
		if hasDefault {
			return defaultVal
		}
		if firstErr == nil {
			firstErr = fmt.Errorf("unresolved variable: %s", token)
		}
		return token
	})
	if firstErr != nil {
		return result, firstErr
	}
	return result, nil
}

func substituteStaticForDryRun(command string, params map[string]string, captureNames map[string]bool) (string, error) {
	var firstErr error
	result := variableTokenRe.ReplaceAllStringFunc(command, func(token string) string {
		content := token[2 : len(token)-1]
		name, defaultVal, hasDefault := splitVariableDefault(content)
		if hasDefault && strings.Contains(defaultVal, "${") {
			if firstErr == nil {
				firstErr = fmt.Errorf("default value for variable %s cannot contain nested ${...} references", name)
			}
			return token
		}
		if captureNames[name] {
			return token
		}
		if val, ok := params[name]; ok {
			return val
		}
		if hasDefault {
			return defaultVal
		}
		if firstErr == nil {
			firstErr = fmt.Errorf("unresolved variable: %s", token)
		}
		return token
	})
	if firstErr != nil {
		return result, firstErr
	}
	return result, nil
}

func captureOutputValue(step *PipelineStep, stdout string) (string, bool, error) {
	if step.CaptureOutput == nil {
		return "", false, nil
	}
	if step.CaptureOutput.Regex == "" {
		return strings.TrimSpace(stdout), true, nil
	}
	re, err := regexp.Compile(step.CaptureOutput.Regex)
	if err != nil {
		return "", false, fmt.Errorf("step %s capture_output regex: %w", step.Name, err)
	}
	m := re.FindStringSubmatch(stdout)
	if m == nil || len(m) < 2 {
		return "", false, nil
	}
	return m[1], true, nil
}

