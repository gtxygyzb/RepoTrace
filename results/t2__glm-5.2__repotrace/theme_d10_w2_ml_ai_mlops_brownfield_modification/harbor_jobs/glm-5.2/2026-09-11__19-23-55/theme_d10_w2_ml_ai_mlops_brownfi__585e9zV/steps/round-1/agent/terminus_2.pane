  1052		var firstErr error
  1053		result := variableTokenRe.ReplaceAllStringFunc(command, func(token string) string {
  1054			content := token[2 : len(token)-1]
  1055			name, defaultVal, hasDefault := splitVariableDefault(content)
  1056			if hasDefault && strings.Contains(defaultVal, "${") {
  1057				if firstErr == nil {
  1058					firstErr = fmt.Errorf("default value for variable %s cannot contain nested ${...} references", name)
  1059				}
  1060				return token
  1061			}
  1062			if val, ok := vars[name]; ok {
  1063				return val
  1064			}
  1065			if hasDefault {
  1066				return defaultVal
  1067			}
  1068			if firstErr == nil {
  1069				firstErr = fmt.Errorf("unresolved variable: %s", token)
  1070			}
  1071			return token
  1072		})
  1073		if firstErr != nil {
  1074			return result, firstErr
  1075		}
  1076		return result, nil
  1077	}
  1078	
  1079	func substituteStaticForDryRun(command string, params map[string]string, captureNames map[string]bool) (string, error) {
