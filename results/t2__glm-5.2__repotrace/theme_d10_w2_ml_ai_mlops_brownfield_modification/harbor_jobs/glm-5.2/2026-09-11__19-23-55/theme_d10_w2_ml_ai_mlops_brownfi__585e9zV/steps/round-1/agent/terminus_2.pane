func captureOutputValue(step *PipelineStep, stdout string) (string, bool, error) {
	if step.CaptureOutput == nil {
		return "", false, nil
	}
	if step.CaptureOutput.Regex == "" {
		return strings.TrimSpace(stdout), true, nil
	}
	re, err := regexp.Compile(step.CaptureOutput.Regex)
	if err != nil {
		return "", false, fmt.Errorf("step %s capture_output regex: %w", step.Name, err)
	}
	m := re.FindStringSubmatch(stdout)
	if m == nil || len(m) < 2 {
		return "", false, nil
	}
	return m[1], true, nil
}

type DryRunStep struct {
	Name            string   `json:"name"`
	Type            string   `json:"type"`
	ResolvedCommand string   `json:"resolved_command"`
	Status          string   `json:"status"`
	DependsOn       []string `json:"depends_on"`
}

