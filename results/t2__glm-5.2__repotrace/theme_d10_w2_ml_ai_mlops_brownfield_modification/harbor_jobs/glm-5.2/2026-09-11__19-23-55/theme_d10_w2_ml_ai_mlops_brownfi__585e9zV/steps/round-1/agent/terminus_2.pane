     7	
     8	// ModelStatus represents the lifecycle stage of a model
     9	type ModelStatus string
    10	
    11	const (
    12		ModelStatusRegistered ModelStatus = "registered"
    13		ModelStatusStaging    ModelStatus = "staging"
    14		ModelStatusProduction ModelStatus = "production"
    15		ModelStatusArchived   ModelStatus = "archived"
    16	)
    17	
    18	// Model represents an ML model in the registry
    19	type Model struct {
    20		Name        string             `json:"name"`
    21		Version     string             `json:"version"`
    22		Framework   string             `json:"framework"`
    23		Description string             `json:"description,omitempty"`
    24		Tags        []string           `json:"tags,omitempty"`
    25		Status      ModelStatus        `json:"status"`
    26		Metrics     map[string]float64 `json:"metrics,omitempty"`
    27		CreatedAt   time.Time          `json:"created_at"`
    28		UpdatedAt   time.Time          `json:"updated_at"`
    29		ParentRef   string             `json:"parent_ref,omitempty"`
    30	}
    31	
    32	func (m *Model) Key() string {
    33		return fmt.Sprintf("%s:%s", m.Name, m.Version)
    34	}
    35	
    36	// ValidTransitions defines valid model lifecycle transitions
    37	var ValidTransitions = map[ModelStatus][]ModelStatus{
    38		ModelStatusRegistered: {ModelStatusStaging, ModelStatusArchived},
    39		ModelStatusStaging:    {ModelStatusProduction, ModelStatusRegistered, ModelStatusArchived},
    40		ModelStatusProduction: {ModelStatusStaging, ModelStatusArchived},
    41		ModelStatusArchived:   {ModelStatusRegistered},
    42	}
    43	
    44	func (m *Model) CanTransitionTo(target ModelStatus) bool {
    45		allowed, ok := ValidTransitions[m.Status]
    46		if !ok {
    47			return false
    48		}
    49		for _, s := range allowed {
    50			if s == target {
    51				return true
    52			}
    53		}
    54		return false
    55	}
    56	
    57	// ExperimentStatus represents the state of an experiment run
    58	type ExperimentStatus string
    59	
    60	const (
    61		ExperimentStatusRunning   ExperimentStatus = "running"
    62		ExperimentStatusCompleted ExperimentStatus = "completed"
    63		ExperimentStatusFailed    ExperimentStatus = "failed"
    64	)
    65	
    66	// Experiment represents an ML experiment run
    67	type Experiment struct {
    68		ID         string             `json:"id"`
    69		Name       string             `json:"name"`
    70		Status     ExperimentStatus   `json:"status"`
    71		Parameters map[string]string  `json:"parameters,omitempty"`
    72		Metrics    map[string]float64 `json:"metrics,omitempty"`
    73		Tags       []string           `json:"tags,omitempty"`
    74		ModelRef   string             `json:"model_ref,omitempty"`
    75		DatasetRef string             `json:"dataset_ref,omitempty"`
    76		StartTime  time.Time          `json:"start_time"`
    77		EndTime    time.Time          `json:"end_time,omitempty"`
    78		Notes      string             `json:"notes,omitempty"`
    79	}
    80	
    81	// Dataset represents a dataset version
    82	type Dataset struct {
    83		Name      string    `json:"name"`
    84		Version   string    `json:"version"`
    85		Format    string    `json:"format"`
    86		Path      string    `json:"path"`
    87		RowCount  int64     `json:"row_count"`
    88		Schema    []Column  `json:"schema,omitempty"`
    89		CreatedAt time.Time `json:"created_at"`
    90		Checksum  string    `json:"checksum,omitempty"`
    91	}
    92	
    93	func (d *Dataset) Key() string {
    94		return fmt.Sprintf("%s:%s", d.Name, d.Version)
    95	}
    96	
    97	// Column represents a dataset column
    98	type Column struct {
    99		Name     string `json:"name"`
   100		Type     string `json:"type"`
   101		Nullable bool   `json:"nullable"`
   102	}
   103	
   104	// StoreData holds all persisted data
