func handlePipeline(store *Store, tracker *Tracker, args []string) {
	if len(args) < 1 {
		fmt.Fprintln(os.Stderr, "pipeline subcommand required")
		os.Exit(1)
	}

	switch args[0] {
	case "validate":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "pipeline config path required")
			os.Exit(1)
		}
		cfg, err := loadPipelineConfig(args[1])
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		if err := validatePipelineConfig(cfg); err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		fmt.Println("Pipeline is valid")

	case "run":
		dryRun := false
		var configPath string
		for i := 1; i < len(args); i++ {
			a := args[i]
			if a == "--dry-run" {
				dryRun = true
				continue
			}
			if a == "--param" && i+1 < len(args) {
				i++
				continue
			}
			if a == "--max-parallel" && i+1 < len(args) {
				i++
				continue
			}
			if strings.HasPrefix(a, "--param=") || strings.HasPrefix(a, "--max-parallel=") {
				continue
			}
			if configPath == "" && !strings.HasPrefix(a, "--") {
				configPath = a
			}
		}
		if configPath == "" {
			fmt.Fprintln(os.Stderr, "pipeline config path required")
			os.Exit(1)
		}
		cfg, err := loadPipelineConfig(configPath)
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		params := parsePipelineParams(args[1:])
		if dryRun {
			plan, err := dryRunPipeline(cfg, params)
			if err != nil {
				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
				os.Exit(1)
			}
			printJSON(plan)
			return
		}
		maxParallel := 0
		if v := getFlag(args[1:], "--max-parallel", ""); v != "" {
			if n, err := strconv.Atoi(v); err == nil {
				maxParallel = n
			}
		}
		run, err := runPipeline(cfg, tracker, params, maxParallel)
		if run != nil {
			printJSON(run)
		}
		if err != nil {
			os.Exit(1)
		}

	case "graph":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "pipeline config path required")
			os.Exit(1)
		}
		cfg, err := loadPipelineConfig(args[1])
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		if err := validatePipelineConfig(cfg); err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		printJSON(buildPipelineGraph(cfg))

	case "history":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "pipeline name required")
			os.Exit(1)
		}
		status := getFlag(args[2:], "--status", "")
		tag := getFlag(args[2:], "--tag", "")
		printJSON(pipelineHistory(args[1], status, tag))

	case "status":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "run-id required")
			os.Exit(1)
		}
		run, err := loadRun(args[1])
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		printJSON(run)

	case "list":
		printJSON(listRuns())

	case "artifacts":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "run-id required")
			os.Exit(1)
		}
		run, err := loadRun(args[1])
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		var cfg *PipelineConfig
		if cfgData, err := os.ReadFile(filepath.Join(pipelineRunsDir, args[1], "pipeline_config.json")); err == nil {
			var c PipelineConfig
			if json.Unmarshal(cfgData, &c) == nil {
				cfg = &c
			}
		}
		printJSON(buildArtifactManifest(run, cfg))

	case "resume":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "run-id required")
			os.Exit(1)
		}
		run, err := resumePipeline(args[1], tracker)
		if run != nil {
			printJSON(run)
		}
		if err != nil {
			os.Exit(1)
		}

	default:
		fmt.Fprintf(os.Stderr, "Unknown pipeline subcommand: %s\n", args[0])
		os.Exit(1)
	}
}

func parsePipelineParams(args []string) map[string]string {
	params := make(map[string]string)
	for i := 0; i < len(args); i++ {
		a := args[i]
		if a == "--param" && i+1 < len(args) {
[?2004hroot@n30009:/app# sed -n '990,1075p' pipeline.go
[?2004l			return true
		}
	}
	return false
}

func saveRun(run *PipelineRun) {
	if err := os.MkdirAll(run.RunDir, 0755); err != nil {
		return
	}
	data, err := json.MarshalIndent(run, "", "  ")
	if err == nil {
		os.WriteFile(filepath.Join(run.RunDir, "run.json"), data, 0644)
	}
}

func saveCheckpoint(run *PipelineRun) {
	if err := os.MkdirAll(run.RunDir, 0755); err != nil {
		return
	}
	cp := &Checkpoint{
		RunID:      run.ID,
		Status:     run.Status,
		Parameters: run.Parameters,
		Steps:      run.Steps,
		Artifacts:  run.Artifacts,
		Variables:  run.Variables,
		Warnings:   run.Warnings,
	}
	data, err := json.MarshalIndent(cp, "", "  ")
	if err == nil {
		os.WriteFile(filepath.Join(run.RunDir, "checkpoint.json"), data, 0644)
	}
}

func loadRun(runID string) (*PipelineRun, error) {
	path := filepath.Join(pipelineRunsDir, runID, "run.json")
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, fmt.Errorf("load run: %w", err)
	}
	var run PipelineRun
	if err := json.Unmarshal(data, &run); err != nil {
		return nil, fmt.Errorf("parse run: %w", err)
	}
	for _, sr := range run.Steps {
		if sr.RetryHistory == nil {
			sr.RetryHistory = []RetryHistoryEntry{}
		}
	}
	return &run, nil
}

func listRuns() []*PipelineRun {
	entries, err := os.ReadDir(pipelineRunsDir)
	if err != nil {
		return nil
	}
	var runs []*PipelineRun
	for _, entry := range entries {
		if !entry.IsDir() {
			continue
		}
		run, err := loadRun(entry.Name())
		if err != nil {
			continue
		}
		runs = append(runs, run)
	}
	sort.Slice(runs, func(i, j int) bool {
		if runs[i].StartTime == nil || runs[j].StartTime == nil {
			return runs[i].ID < runs[j].ID
		}
		return runs[i].StartTime.Before(*runs[j].StartTime)
	})
	return runs
}

