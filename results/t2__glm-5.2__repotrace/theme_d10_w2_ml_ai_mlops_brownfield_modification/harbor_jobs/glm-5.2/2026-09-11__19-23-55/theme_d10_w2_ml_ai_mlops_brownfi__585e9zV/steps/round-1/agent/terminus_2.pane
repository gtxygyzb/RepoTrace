   773	func listRuns() []*PipelineRun {
   774		entries, err := os.ReadDir(pipelineRunsDir)
   775		if err != nil {
   776			return nil
   777		}
   778		var runs []*PipelineRun
   779		for _, entry := range entries {
   780			if !entry.IsDir() {
   781				continue
   782			}
   783			run, err := loadRun(entry.Name())
   784			if err != nil {
   785				continue
   786			}
   787			runs = append(runs, run)
   788		}
   789		sort.Slice(runs, func(i, j int) bool {
   790			if runs[i].StartTime == nil || runs[j].StartTime == nil {
   791				return runs[i].ID < runs[j].ID
   792			}
   793			return runs[i].StartTime.Before(*runs[j].StartTime)
   794		})
   795		return runs
   796	}
   797	
   798	func resumePipeline(runID string, tracker *Tracker) (*PipelineRun, error) {
   799		run, err := loadRun(runID)
   800		if err != nil {
   801			return nil, err
   802		}
   803		cpPath := filepath.Join(run.RunDir, "checkpoint.json")
   804		cpData, err := os.ReadFile(cpPath)
   805		if err == nil {
   806			var cp Checkpoint
   807			if json.Unmarshal(cpData, &cp) == nil {
   808				run.Status = cp.Status
   809				run.Parameters = cp.Parameters
   810				run.Steps = cp.Steps
   811				run.Artifacts = cp.Artifacts
   812			}
   813		}
   814	
   815		cfgPath := filepath.Join(run.RunDir, "pipeline_config.json")
   816		var cfg *PipelineConfig
   817		if cfgData, err := os.ReadFile(cfgPath); err == nil {
   818			var c PipelineConfig
   819			if json.Unmarshal(cfgData, &c) == nil {
   820				cfg = &c
   821			}
   822		}
   823		if cfg == nil {
   824			return nil, fmt.Errorf("pipeline config not found for run %s", runID)
   825		}
   826	
   827		completed := true
   828		for _, sr := range run.Steps {
   829			if sr.Status != "succeeded" && sr.Status != "skipped" {
   830				completed = false
   831				break
   832			}
   833		}
   834		if completed {
   835			run.Status = "succeeded"
   836			saveRun(run)
   837			return run, nil
   838		}
   839	
   840		run.Status = "running"
   841		saveRun(run)
   842	
   843		err = executeSteps(cfg, run, tracker, run.Parameters, cfg.MaxParallel)
   844		endTime := time.Now()
   845		run.EndTime = &endTime
   846		if err != nil {
   847			run.Status = "failed"
   848		} else {
   849			run.Status = "succeeded"
   850		}
   851		saveRun(run)
   852		return run, err
   853	}
   854	
   855	func buildArtifactManifest(run *PipelineRun, cfg *PipelineConfig) map[string]interface{} {
   856		manifest := map[string]interface{}{
   857			"artifacts": run.Artifacts,
   858		}
   859		lineage := make(map[string][]string)
   860		if cfg != nil {
   861			for _, step := range cfg.Steps {
   862				for _, in := range step.Inputs {
   863					lineage[in] = append(lineage[in], step.Name)
   864				}
   865			}
   866		}
   867		manifest["lineage"] = lineage
   868		return manifest
   869	}
