  1136	func dryRunPipeline(cfg *PipelineConfig, params map[string]string) (map[string]interface{}, error) {
  1137		if err := validatePipelineConfig(cfg); err != nil {
  1138			return nil, err
  1139		}
  1140		merged := mergeParams(cfg.Parameters, params)
  1141	
  1142		captureNames := make(map[string]bool)
  1143		for _, step := range cfg.Steps {
  1144			if step.CaptureOutput != nil && step.CaptureOutput.Name != "" {
  1145				captureNames[step.CaptureOutput.Name] = true
  1146			}
  1147		}
  1148	
  1149		status := make(map[string]string)
  1150		assigned := make(map[string]bool)
  1151		for len(assigned) < len(cfg.Steps) {
  1152			progress := false
  1153			for _, step := range cfg.Steps {
  1154				if assigned[step.Name] {
  1155					continue
  1156				}
  1157				depsKnown := true
  1158				for _, dep := range step.DependsOn {
  1159					if !assigned[dep] {
  1160						depsKnown = false
  1161						break
  1162					}
  1163				}
  1164				if !depsKnown {
  1165					continue
  1166				}
  1167	
  1168				depsOk := true
  1169				for _, dep := range step.DependsOn {
  1170					if status[dep] != "ready" && status[dep] != "skipped" {
  1171						depsOk = false
  1172						break
  1173					}
  1174				}
  1175				if !depsOk {
  1176					status[step.Name] = "blocked"
  1177				} else {
  1178					cond, err := evaluateCondition(step.Condition, merged)
  1179					if err != nil {
  1180						return nil, fmt.Errorf("step %s condition: %w", step.Name, err)
  1181					}
  1182					if !cond {
  1183						status[step.Name] = "skipped"
  1184					} else {
  1185						status[step.Name] = "ready"
  1186					}
  1187				}
  1188				assigned[step.Name] = true
  1189				progress = true
  1190			}
  1191			if !progress {
  1192				break
  1193			}
  1194		}
  1195	
  1196		steps := make([]map[string]interface{}, 0, len(cfg.Steps))
  1197		for _, step := range cfg.Steps {
  1198			resolved, err := substituteStaticForDryRun(step.Command, merged, captureNames)
  1199			if err != nil {
  1200				return nil, fmt.Errorf("step %s command: %w", step.Name, err)
  1201			}
  1202			deps := make([]string, 0, len(step.DependsOn))
  1203			deps = append(deps, step.DependsOn...)
  1204			if deps == nil {
  1205				deps = []string{}
  1206			}
  1207			st := status[step.Name]
  1208			if st == "" {
  1209				st = "blocked"
  1210			}
  1211			steps = append(steps, map[string]interface{}{
  1212				"name":             step.Name,
  1213				"type":             step.Type,
  1214				"resolved_command": resolved,
  1215				"status":           st,
  1216				"depends_on":       deps,
  1217			})
  1218		}
  1219		return map[string]interface{}{"steps": steps}, nil
  1220	}
