  1084			if hasDefault && strings.Contains(defaultVal, "${") {
  1085				if firstErr == nil {
  1086					firstErr = fmt.Errorf("default value for variable %s cannot contain nested ${...} references", name)
  1087				}
  1088				return token
  1089			}
  1090			if captureNames[name] {
  1091				return token
  1092			}
  1093			if val, ok := params[name]; ok {
  1094				return val
  1095			}
  1096			if hasDefault {
  1097				return defaultVal
  1098			}
  1099			if firstErr == nil {
  1100				firstErr = fmt.Errorf("unresolved variable: %s", token)
  1101			}
  1102			return token
  1103		})
  1104		if firstErr != nil {
  1105			return result, firstErr
  1106		}
  1107		return result, nil
