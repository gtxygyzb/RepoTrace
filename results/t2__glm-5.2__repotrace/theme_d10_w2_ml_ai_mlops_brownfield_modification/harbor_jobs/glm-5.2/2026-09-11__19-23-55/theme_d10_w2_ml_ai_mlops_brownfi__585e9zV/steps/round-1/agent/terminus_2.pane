  1012	
  1013	func loadRun(runID string) (*PipelineRun, error) {
  1014		path := filepath.Join(pipelineRunsDir, runID, "run.json")
  1015		data, err := os.ReadFile(path)
  1016		if err != nil {
  1017			return nil, fmt.Errorf("load run: %w", err)
  1018		}
  1019		var run PipelineRun
  1020		if err := json.Unmarshal(data, &run); err != nil {
  1021			return nil, fmt.Errorf("parse run: %w", err)
  1022		}
  1023		return &run, nil
  1024	}
  1025	
  1026	func listRuns() []*PipelineRun {
  1027		entries, err := os.ReadDir(pipelineRunsDir)
  1028		if err != nil {
  1029			return nil
  1030		}
  1031		var runs []*PipelineRun
  1032		for _, entry := range entries {
  1033			if !entry.IsDir() {
  1034				continue
  1035			}
  1036			run, err := loadRun(entry.Name())
  1037			if err != nil {
  1038				continue
  1039			}
  1040			runs = append(runs, run)
  1041		}
  1042		sort.Slice(runs, func(i, j int) bool {
  1043			if runs[i].StartTime == nil || runs[j].StartTime == nil {
  1044				return runs[i].ID < runs[j].ID
  1045			}
  1046			return runs[i].StartTime.Before(*runs[j].StartTime)
  1047		})
  1048		return runs
  1049	}
  1050	
  1051	func resumePipeline(runID string, tracker *Tracker) (*PipelineRun, error) {
  1052		run, err := loadRun(runID)
  1053		if err != nil {
  1054			return nil, err
  1055		}
  1056		cpPath := filepath.Join(run.RunDir, "checkpoint.json")
  1057		cpData, err := os.ReadFile(cpPath)
  1058		if err == nil {
  1059			var cp Checkpoint
  1060			if json.Unmarshal(cpData, &cp) == nil {
  1061				run.Status = cp.Status
  1062				run.Parameters = cp.Parameters
  1063				run.Steps = cp.Steps
  1064				run.Artifacts = cp.Artifacts
  1065				run.Warnings = cp.Warnings
  1066				if run.Warnings == nil {
  1067					run.Warnings = []string{}
  1068				}
  1069			}
  1070		}
  1071	
  1072		cfgPath := filepath.Join(run.RunDir, "pipeline_config.json")
  1073		var cfg *PipelineConfig
  1074		if cfgData, err := os.ReadFile(cfgPath); err == nil {
  1075			var c PipelineConfig
  1076			if json.Unmarshal(cfgData, &c) == nil {
  1077				cfg = &c
  1078			}
  1079		}
  1080		if cfg == nil {
  1081			return nil, fmt.Errorf("pipeline config not found for run %s", runID)
  1082		}
  1083	
  1084		completed := true
  1085		for _, sr := range run.Steps {
  1086			if sr.Status != "succeeded" && sr.Status != "skipped" {
  1087				completed = false
  1088				break
  1089			}
  1090		}
  1091		if completed {
  1092			run.Status = "succeeded"
  1093			run.Warnings = []string{}
  1094			saveRun(run)
  1095			return run, nil
