   182					return fmt.Errorf("step %s memory requirement %d MB exceeds pipeline limit %d MB", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)
   183				}
   184			}
   185			if step.Type == "train" && step.ExperimentConfig == nil {
   186				return fmt.Errorf("train step %s requires experiment_config", step.Name)
   187			}
   188		}
   189	
   190		for _, step := range cfg.Steps {
   191			for _, dep := range step.DependsOn {
   192				if !names[dep] {
