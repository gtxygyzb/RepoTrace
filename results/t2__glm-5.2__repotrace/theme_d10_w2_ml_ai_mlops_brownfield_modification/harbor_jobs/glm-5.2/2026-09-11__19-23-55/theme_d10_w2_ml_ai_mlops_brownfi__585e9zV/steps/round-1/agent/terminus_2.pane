func handleSearch(store *Store, args []string) {
	tag := getFlag(args, "--tag", "")
	if tag == "" {
		fmt.Fprintln(os.Stderr, "search requires --tag")
		os.Exit(1)
	}

	results := store.FindByTag(tag)
	printJSON(results)
}

func getFlag(args []string, flag, defaultVal string) string {
	prefix := flag + "="
	for i, a := range args {
		if a == flag && i+1 < len(args) {
			return args[i+1]
		}
		if strings.HasPrefix(a, prefix) {
			return a[len(prefix):]
		}
	}
	return defaultVal
}

func printJSON(v interface{}) {
	data, err := json.MarshalIndent(v, "", "  ")
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error: %v\n", err)
		os.Exit(1)
	}
	fmt.Println(string(data))
}

