    17	
    18	// Model represents an ML model in the registry
    19	type Model struct {
    20		Name        string             `json:"name"`
    21		Version     string             `json:"version"`
    22		Framework   string             `json:"framework"`
    23		Description string             `json:"description,omitempty"`
    24		Tags        []string           `json:"tags,omitempty"`
    25		Status      ModelStatus        `json:"status"`
    26		Metrics     map[string]float64 `json:"metrics,omitempty"`
    27		CreatedAt   time.Time          `json:"created_at"`
    28		UpdatedAt   time.Time          `json:"updated_at"`
    29		ParentRef   string             `json:"parent_ref,omitempty"`
    30	}
    31	
    32	func (m *Model) Key() string {
    33		return fmt.Sprintf("%s:%s", m.Name, m.Version)
    34	}
    35	
    36	// ValidTransitions defines valid model lifecycle transitions
    37	var ValidTransitions = map[ModelStatus][]ModelStatus{
    38		ModelStatusRegistered: {ModelStatusStaging, ModelStatusArchived},
    39		ModelStatusStaging:    {ModelStatusProduction, ModelStatusRegistered, ModelStatusArchived},
    40		ModelStatusProduction: {ModelStatusStaging, ModelStatusArchived},
    41		ModelStatusArchived:   {ModelStatusRegistered},
    42	}
    43	
    44	func (m *Model) CanTransitionTo(target ModelStatus) bool {
    45		allowed, ok := ValidTransitions[m.Status]
    46		if !ok {
    47			return false
    48		}
    49		for _, s := range allowed {
    50			if s == target {
    51				return true
    52			}
    53		}
    54		return false
    55	}
    56	
