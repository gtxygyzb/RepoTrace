const pipelineRunsDir = "/tmp/nexus/runs"

type PipelineResourceLimit struct {
	CPU      int `json:"cpu,omitempty"`
	MemoryMB int `json:"memory_mb,omitempty"`
}

type PipelineStepResources struct {
	CPU      int `json:"cpu,omitempty"`
	MemoryMB int `json:"memory_mb,omitempty"`
}

type PipelineStepRetry struct {
	MaxRetries         int `json:"max_retries,omitempty"`
	BackoffBaseSeconds int `json:"backoff_base_seconds,omitempty"`
}

type CaptureOutputConfig struct {
	Name  string `json:"name"`
	Regex string `json:"regex,omitempty"`
}

func (c *CaptureOutputConfig) UnmarshalJSON(data []byte) error {
	var str string
	if err := json.Unmarshal(data, &str); err == nil {
		c.Name = str
		c.Regex = ""
		return nil
	}
	var raw struct {
		Name  string `json:"name"`
		Regex string `json:"regex"`
	}
	if err := json.Unmarshal(data, &raw); err != nil {
		return fmt.Errorf("capture_output must be a string or an object with name and optional regex")
	}
	c.Name = raw.Name
	c.Regex = raw.Regex
	return nil
}

type PipelineExperimentConfig struct {
	Name    string            `json:"name,omitempty"`
	Params  map[string]string `json:"params,omitempty"`
	Metrics []string          `json:"metrics,omitempty"`
}

type PipelineStep struct {
	Name             string                    `json:"name"`
	Type             string                    `json:"type"`
	Command          string                    `json:"command"`
	DependsOn        []string                  `json:"depends_on,omitempty"`
	Inputs           []string                  `json:"inputs,omitempty"`
	Outputs          []string                  `json:"outputs,omitempty"`
	Resources        *PipelineStepResources    `json:"resources,omitempty"`
	TimeoutSeconds   int                       `json:"timeout_seconds,omitempty"`
	Retry            *PipelineStepRetry        `json:"retry,omitempty"`
	Condition        string                    `json:"condition,omitempty"`
	ExperimentConfig *PipelineExperimentConfig `json:"experiment_config,omitempty"`
	DatasetRef       string                    `json:"dataset_ref,omitempty"`
	CaptureOutput    *CaptureOutputConfig      `json:"capture_output,omitempty"`
	Env              map[string]string         `json:"env,omitempty"`
	AllowFailure     bool                      `json:"allow_failure,omitempty"`
}

type PipelineConfig struct {
	Name          string                 `json:"name"`
	Description   string                 `json:"description,omitempty"`
	Tags          []string               `json:"tags,omitempty"`
	Parameters    map[string]string      `json:"parameters,omitempty"`
	MaxParallel   int                    `json:"max_parallel,omitempty"`
	ResourceLimit *PipelineResourceLimit `json:"resource_limit,omitempty"`
	Steps         []*PipelineStep        `json:"steps"`
}

type Artifact struct {
	Name     string `json:"name"`
	Type     string `json:"type"`
	Producer string `json:"producer"`
	Path     string `json:"path"`
	Size     int64  `json:"size"`
}

type RetryHistoryEntry struct {
	Attempt int    `json:"attempt"`
	Error   string `json:"error"`
}

type StepRun struct {
	Name         string              `json:"name"`
	Type         string              `json:"type"`
	Status       string              `json:"status"`
	StartTime    *time.Time          `json:"start_time,omitempty"`
	EndTime      *time.Time          `json:"end_time,omitempty"`
	ExitCode     int                 `json:"exit_code,omitempty"`
	Stdout       string              `json:"stdout,omitempty"`
	Output       string              `json:"output,omitempty"`
	Error        string              `json:"error,omitempty"`
	Artifacts    []Artifact          `json:"artifacts,omitempty"`
	ExperimentID string              `json:"experiment_id,omitempty"`
	RetryCount   int                 `json:"retry_count"`
	RetryHistory []RetryHistoryEntry `json:"retry_history"`
}

type PipelineRun struct {
	ID          string            `json:"id"`
	Pipeline    string            `json:"pipeline"`
	Status      string            `json:"status"`
	Description string            `json:"description"`
	Tags        []string          `json:"tags"`
	Parameters  map[string]string `json:"parameters,omitempty"`
	StartTime   *time.Time        `json:"start_time,omitempty"`
	EndTime     *time.Time        `json:"end_time,omitempty"`
	Steps       []*StepRun        `json:"steps"`
	Artifacts   []Artifact        `json:"artifacts,omitempty"`
	RunDir      string            `json:"run_dir,omitempty"`
	Variables   map[string]string `json:"variables,omitempty"`
	Warnings    []string          `json:"warnings"`
}

type Checkpoint struct {
	RunID      string            `json:"run_id"`
	Status     string            `json:"status"`
	Parameters map[string]string `json:"parameters,omitempty"`
	Steps      []*StepRun        `json:"steps"`
	Artifacts  []Artifact        `json:"artifacts,omitempty"`
	Variables  map[string]string `json:"variables,omitempty"`
	Warnings   []string          `json:"warnings"`
}

func loadPipelineConfig(path string) (*PipelineConfig, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, fmt.Errorf("read pipeline config: %w", err)
	}
	var cfg PipelineConfig
	if err := json.Unmarshal(data, &cfg); err != nil {
		return nil, fmt.Errorf("parse pipeline config: %w", err)
	}
	if cfg.MaxParallel <= 0 {
		cfg.MaxParallel = 4
	}
	return &cfg, nil
}

func validatePipelineConfig(cfg *PipelineConfig) error {
	if cfg.Name == "" {
		return fmt.Errorf("pipeline name is required")
	}
	if len(cfg.Steps) == 0 {
		return fmt.Errorf("pipeline must have at least one step")
	}

	names := make(map[string]bool)
	for _, step := range cfg.Steps {
		if step.Name == "" {
			return fmt.Errorf("step name is required")
		}
		if names[step.Name] {
			return fmt.Errorf("duplicate step name: %s", step.Name)
		}
		names[step.Name] = true
		switch step.Type {
		case "shell", "train", "evaluate":
		default:
			return fmt.Errorf("step %s has invalid type: %s", step.Name, step.Type)
		}
		if step.Command == "" {
			return fmt.Errorf("step %s command is required", step.Name)
		}
		if step.Resources != nil && cfg.ResourceLimit != nil {
			if step.Resources.CPU > cfg.ResourceLimit.CPU {
				return fmt.Errorf("step %s cpu requirement %d exceeds pipeline limit %d", step.Name, step.Resources.CPU, cfg.ResourceLimit.CPU)
			}
			if step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {
				return fmt.Errorf("step %s memory requirement %d MB exceeds pipeline limit %d MB", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)
			}
		}
		if step.Type == "train" && step.ExperimentConfig == nil {
			return fmt.Errorf("train step %s requires experiment_config", step.Name)
		}
	}

	for _, step := range cfg.Steps {
		for _, dep := range step.DependsOn {
			if !names[dep] {
				return fmt.Errorf("step %s depends on unknown step %s", step.Name, dep)
			}
		}
	}

	if cycle := findCycle(cfg.Steps); cycle != nil {
		return fmt.Errorf("cycle detected: %s", strings.Join(cycle, " -> "))
	}

	producers := make(map[string]string)
	for _, step := range cfg.Steps {
		for _, out := range step.Outputs {
			if _, ok := producers[out]; ok {
				return fmt.Errorf("duplicate output artifact: %s", out)
			}
			producers[out] = step.Name
		}
	}

	for _, step := range cfg.Steps {
		for _, in := range step.Inputs {
			prod, ok := producers[in]
			if !ok {
				return fmt.Errorf("step %s input artifact %s is not produced by any step", step.Name, in)
			}
			if prod == step.Name {
				return fmt.Errorf("step %s input artifact %s must come from a dependency", step.Name, in)
			}
			if !isTransitiveDependency(cfg.Steps, step.Name, prod) {
				return fmt.Errorf("step %s input artifact %s producer %s is not a transitive dependency", step.Name, in, prod)
			}
		}
	}
	return nil
}

func findCycle(steps []*PipelineStep) []string {
	graph := make(map[string][]string)
	for _, s := range steps {
		graph[s.Name] = append(graph[s.Name], s.DependsOn...)
	}
	visited := make(map[string]int)
	var stack []string
	var dfs func(node string) []string
	dfs = func(node string) []string {
		visited[node] = 1
		stack = append(stack, node)
		for _, dep := range graph[node] {
			if visited[dep] == 1 {
				for i, n := range stack {
					if n == dep {
						return append(append([]string{}, stack[i:]...), dep)
					}
				}
				return []string{node, dep}
			}
			if visited[dep] == 0 {
