  1025	func loadRun(runID string) (*PipelineRun, error) {
  1026		path := filepath.Join(pipelineRunsDir, runID, "run.json")
  1027		data, err := os.ReadFile(path)
  1028		if err != nil {
  1029			return nil, fmt.Errorf("load run: %w", err)
  1030		}
  1031		var run PipelineRun
  1032		if err := json.Unmarshal(data, &run); err != nil {
  1033			return nil, fmt.Errorf("parse run: %w", err)
  1034		}
  1035		for _, sr := range run.Steps {
  1036			if sr.RetryHistory == nil {
  1037				sr.RetryHistory = []RetryHistoryEntry{}
  1038			}
  1039		}
  1040		return &run, nil
  1041	}
  1042	
  1043	func listRuns() []*PipelineRun {
  1044		entries, err := os.ReadDir(pipelineRunsDir)
  1045		if err != nil {
  1046			return nil
  1047		}
  1048		var runs []*PipelineRun
  1049		for _, entry := range entries {
  1050			if !entry.IsDir() {
  1051				continue
  1052			}
  1053			run, err := loadRun(entry.Name())
  1054			if err != nil {
  1055				continue
  1056			}
  1057			runs = append(runs, run)
  1058		}
  1059		sort.Slice(runs, func(i, j int) bool {
  1060			if runs[i].StartTime == nil || runs[j].StartTime == nil {
  1061				return runs[i].ID < runs[j].ID
  1062			}
  1063			return runs[i].StartTime.Before(*runs[j].StartTime)
  1064		})
  1065		return runs
  1066	}
