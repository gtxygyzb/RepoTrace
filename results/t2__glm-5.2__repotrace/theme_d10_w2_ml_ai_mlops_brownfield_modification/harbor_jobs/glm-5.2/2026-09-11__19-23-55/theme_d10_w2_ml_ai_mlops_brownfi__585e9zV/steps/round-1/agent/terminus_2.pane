   529			sr.Status = "failed"
   530			sr.Error = "dependency failed"
   531			return
   532		}
   533	
   534		varMu.Lock()
   535		vars := copyMap(variables)
   536		varMu.Unlock()
   537	
   538		if step.Condition != "" {
   539			cond, err := evaluateCondition(step.Condition, vars)
   540			if err != nil {
   541				sr.Status = "failed"
   542				sr.Error = err.Error()
   543				return
   544			}
   545			if !cond {
   546				sr.Status = "skipped"
   547				sr.Output = "condition false"
   548				return
   549			}
   550		}
   551	
   552		cmdStr, err := substituteVariables(step.Command, vars)
   553		if err != nil {
   554			sr.Status = "failed"
   555			sr.Error = err.Error()
   556			return
   557		}
   558	
   559		envVars := os.Environ()
   560		for k, v := range vars {
   561			envVars = append(envVars, "NEXUS_PARAM_"+k+"="+v)
   562		}
   563		for k, v := range step.Env {
   564			ev, err := substituteVariables(v, vars)
   565			if err != nil {
   566				sr.Status = "failed"
   567				sr.Error = fmt.Sprintf("env %s: %v", k, err)
   568				return
   569			}
   570			envVars = append(envVars, k+"="+ev)
   571		}
   572	
   573		maxRetries := 0
   574		backoffBase := 1
   575		if step.Retry != nil {
   576			maxRetries = step.Retry.MaxRetries
   577			if step.Retry.BackoffBaseSeconds > 0 {
   578				backoffBase = step.Retry.BackoffBaseSeconds
   579			}
   580		}
   581	
   582		var exp *Experiment
   583		if step.Type == "train" {
   584			var err error
   585			exp, err = createTrainExperiment(tracker, step, sr.ExperimentID)
   586			if err != nil {
   587				sr.Status = "failed"
   588				sr.Error = err.Error()
   589				return
   590			}
   591			sr.ExperimentID = exp.ID
   592		}
   593	
   594		for attempt := 0; attempt <= maxRetries; attempt++ {
   595			start := time.Now()
   596			sr.StartTime = &start
   597			sr.RetryCount = attempt
   598			stdout, stderr, exitCode, err := runShellCommand(cmdStr, step.TimeoutSeconds, envVars)
   599			sr.Output = stdout
   600			if stderr != "" {
   601				if sr.Output != "" {
   602					sr.Output += "\n"
   603				}
   604				sr.Output += stderr
   605			}
   606			sr.ExitCode = exitCode
   607			if err == nil {
   608				sr.EndTime = nowPtr()
   609				sr.Status = "succeeded"
   610				sr.Error = ""
   611				produceArtifacts(run, step, sr, stdout)
   612				if step.Type == "train" && exp != nil {
   613					if terr := finishTrainExperiment(tracker, exp, step, stdout); terr != nil {
   614						sr.Status = "failed"
   615						sr.Error = terr.Error()
   616						return
   617					}
   618				}
   619				if step.Type == "evaluate" {
   620					registerEvaluateArtifacts(run, step, sr)
   621				}
   622				if step.CaptureOutput != nil {
   623					val, ok, cerr := captureOutputValue(step, stdout)
   624					if cerr != nil {
   625						sr.Status = "failed"
   626						sr.Error = cerr.Error()
   627						return
   628					}
   629					if ok {
   630						varMu.Lock()
   631						variables[step.CaptureOutput.Name] = val
   632						varMu.Unlock()
   633					}
   634				}
   635				return
   636			}
   637			sr.Error = err.Error()
   638			if step.Type == "train" && exp != nil {
   639				tracker.Complete(exp.ID, ExperimentStatusFailed)
   640			}
   641			if attempt < maxRetries {
   642				delay := time.Duration(math.Pow(float64(backoffBase), float64(attempt+1))) * time.Second
   643				time.Sleep(delay)
   644			}
   645		}
   646		sr.EndTime = nowPtr()
   647		sr.Status = "failed"
   648	}
