   557		}
   558	
   559		envVars := os.Environ()
   560		for k, v := range vars {
   561			envVars = append(envVars, "NEXUS_PARAM_"+k+"="+v)
   562		}
   563		for k, v := range step.Env {
   564			ev, err := substituteVariables(v, vars)
   565			if err != nil {
   566				sr.Status = "failed"
   567				sr.Error = fmt.Sprintf("env %s: %v", k, err)
   568				return
   569			}
   570			envVars = append(envVars, k+"="+ev)
   571		}
   572	
   573		maxRetries := 0
   574		backoffBase := 1
   575		if step.Retry != nil {
   576			maxRetries = step.Retry.MaxRetries
   577			if step.Retry.BackoffBaseSeconds > 0 {
   578				backoffBase = step.Retry.BackoffBaseSeconds
   579			}
   580		}
