   259	func runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {
   260		if err := validatePipelineConfig(cfg); err != nil {
   261			return nil, err
   262		}
   263		merged := mergeParams(cfg.Parameters, params)
   264		if maxParallel <= 0 {
   265			maxParallel = cfg.MaxParallel
   266		}
   267		if maxParallel <= 0 {
   268			maxParallel = 4
   269		}
   270	
   271		runID := generateRunID()
   272		runDir := filepath.Join(pipelineRunsDir, runID)
   273		artifactsDir := filepath.Join(runDir, "artifacts")
   274		if err := os.MkdirAll(artifactsDir, 0755); err != nil {
   275			return nil, fmt.Errorf("create run dir: %w", err)
   276		}
   277		if cfgData, err := json.MarshalIndent(cfg, "", "  "); err == nil {
   278			os.WriteFile(filepath.Join(runDir, "pipeline_config.json"), cfgData, 0644)
   279		}
   280	
   281		now := time.Now()
   282		run := &PipelineRun{
   283			ID:         runID,
   284			Pipeline:   cfg.Name,
   285			Status:     "running",
   286			Parameters: merged,
   287			StartTime:  &now,
   288			RunDir:     runDir,
   289			Steps:      make([]*StepRun, 0, len(cfg.Steps)),
   290		}
   291		for _, step := range cfg.Steps {
   292			run.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: "pending"})
   293		}
   294		saveRun(run)
   295	
   296		err := executeSteps(cfg, run, tracker, merged, maxParallel)
   297		endTime := time.Now()
   298		run.EndTime = &endTime
   299		if err != nil {
   300			run.Status = "failed"
   301		} else {
   302			run.Status = "succeeded"
   303		}
   304		saveRun(run)
   305		return run, err
   306	}
   307	
   308	func executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {
   309		stepByName := make(map[string]*PipelineStep)
   310		for _, s := range cfg.Steps {
   311			stepByName[s.Name] = s
   312		}
   313		runStepByName := make(map[string]*StepRun)
   314		for _, sr := range run.Steps {
   315			runStepByName[sr.Name] = sr
   316		}
   317	
   318		var mu sync.Mutex
   319		var running []*PipelineStep
   320		available := make(chan struct{}, maxParallel)
   321	
   322		pending := make(map[string]bool)
   323		for _, step := range cfg.Steps {
   324			sr := runStepByName[step.Name]
   325			if sr.Status == "succeeded" || sr.Status == "skipped" {
   326				continue
   327			}
   328			if sr.Status == "failed" {
   329				sr.Status = "pending"
   330				sr.Error = ""
   331				sr.Output = ""
   332				sr.StartTime = nil
   333				sr.EndTime = nil
   334			}
   335			pending[step.Name] = true
   336		}
   337	
   338		var wg sync.WaitGroup
   339		done := false
   340	
   341		canStart := func(step *PipelineStep) bool {
   342			for _, dep := range step.DependsOn {
   343				status := runStepByName[dep].Status
   344				if status != "succeeded" && status != "skipped" {
   345					return false
   346				}
   347			}
   348			if step.Resources != nil && cfg.ResourceLimit != nil {
   349				var cpu, mem int
   350				for _, r := range running {
   351					if r.Resources != nil {
   352						cpu += r.Resources.CPU
   353						mem += r.Resources.MemoryMB
   354					}
   355				}
   356				if cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {
   357					return false
   358				}
   359			}
   360			return true
[?2004hroot@n30009:/app# nl -ba pipeline.go | sed -n '361,620p'
[?2004l   361		}
   362	
   363		startStep := func(step *PipelineStep) {
   364			pending[step.Name] = false
   365			running = append(running, step)
   366			wg.Add(1)
   367			go func(s *PipelineStep) {
   368				defer wg.Done()
   369				executeStep(cfg, run, tracker, s, params, runStepByName[s.Name])
   370				mu.Lock()
   371				running = removeStep(running, s)
   372				if runStepByName[s.Name].Status == "failed" {
   373					run.Status = "failed"
   374					done = true
   375				}
   376				saveCheckpoint(run)
   377				saveRun(run)
   378				mu.Unlock()
   379				<-available
   380			}(step)
   381		}
   382	
   383		for !done && (len(pending) > 0 || len(running) > 0) {
   384			startedAny := false
   385			var starts []*PipelineStep
   386			mu.Lock()
   387			for _, step := range cfg.Steps {
   388				if pending[step.Name] && canStart(step) {
   389					starts = append(starts, step)
   390				}
   391			}
   392			mu.Unlock()
   393			sort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })
   394			for _, step := range starts {
   395				available <- struct{}{}
   396				mu.Lock()
   397				if done || !pending[step.Name] || !canStart(step) {
   398					mu.Unlock()
   399					<-available
   400					continue
   401				}
   402				startStep(step)
   403				mu.Unlock()
   404				startedAny = true
   405			}
   406	
   407			if !startedAny {
   408				if len(running) == 0 {
   409					break
   410				}
   411				time.Sleep(10 * time.Millisecond)
   412			}
   413		}
   414		wg.Wait()
   415	
   416		for _, sr := range run.Steps {
   417			if sr.Status == "pending" {
   418				sr.Status = "failed"
   419				sr.Error = "dependency failed"
   420			}
   421		}
   422		saveCheckpoint(run)
   423		saveRun(run)
   424	
   425		if run.Status == "failed" {
   426			return fmt.Errorf("pipeline execution failed")
   427		}
   428		return nil
   429	}
   430	func removeStep(steps []*PipelineStep, target *PipelineStep) []*PipelineStep {
   431		out := make([]*PipelineStep, 0, len(steps))
   432		for _, s := range steps {
   433			if s != target {
   434				out = append(out, s)
   435			}
   436		}
   437		return out
   438	}
   439	
   440	func executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, params map[string]string, sr *StepRun) {
   441		for _, dep := range step.DependsOn {
   442			depStatus := getRunStep(run, dep).Status
   443			if depStatus != "succeeded" && depStatus != "skipped" {
   444				sr.Status = "failed"
   445				sr.Error = "dependency failed"
   446				return
   447			}
   448		}
   449	
   450		if step.Condition != "" {
   451			cond, err := evaluateCondition(step.Condition, params)
   452			if err != nil {
   453				sr.Status = "failed"
   454				sr.Error = err.Error()
   455				return
   456			}
   457			if !cond {
   458				sr.Status = "skipped"
   459				sr.Output = "condition false"
   460				return
   461			}
   462		}
   463	
   464		maxRetries := 0
   465		backoffBase := 1
   466		if step.Retry != nil {
   467			maxRetries = step.Retry.MaxRetries
   468			if step.Retry.BackoffBaseSeconds > 0 {
   469				backoffBase = step.Retry.BackoffBaseSeconds
   470			}
   471		}
   472	
   473		cmdStr := substituteParams(step.Command, params)
   474	
   475		var exp *Experiment
   476		if step.Type == "train" {
   477			var err error
   478			exp, err = createTrainExperiment(tracker, step, sr.ExperimentID)
   479			if err != nil {
   480				sr.Status = "failed"
   481				sr.Error = err.Error()
   482				return
   483			}
   484			sr.ExperimentID = exp.ID
   485		}
   486	
   487		for attempt := 0; attempt <= maxRetries; attempt++ {
   488			start := time.Now()
   489			sr.StartTime = &start
   490			sr.RetryCount = attempt
   491			out, exitCode, err := runShellCommand(cmdStr, step.TimeoutSeconds)
   492			sr.Output = out
   493			sr.ExitCode = exitCode
   494			if err == nil {
   495				sr.EndTime = nowPtr()
   496				sr.Status = "succeeded"
   497				sr.Error = ""
   498				produceArtifacts(run, step, sr, out)
   499				if step.Type == "train" && exp != nil {
   500					if terr := finishTrainExperiment(tracker, exp, step, out); terr != nil {
   501						sr.Status = "failed"
   502						sr.Error = terr.Error()
   503						return
   504					}
   505				}
   506				if step.Type == "evaluate" {
   507					registerEvaluateArtifacts(run, step, sr)
   508				}
   509				return
   510			}
   511			sr.Error = err.Error()
   512			if step.Type == "train" && exp != nil {
   513				tracker.Complete(exp.ID, ExperimentStatusFailed)
   514			}
   515			if attempt < maxRetries {
   516				delay := time.Duration(math.Pow(float64(backoffBase), float64(attempt+1))) * time.Second
   517				time.Sleep(delay)
   518			}
   519		}
   520		sr.EndTime = nowPtr()
   521		sr.Status = "failed"
   522	}
   523	func getRunStep(run *PipelineRun, name string) *StepRun {
   524		for _, sr := range run.Steps {
   525			if sr.Name == name {
   526				return sr
   527			}
   528		}
   529		return nil
   530	}
   531	
   532	func createTrainExperiment(tracker *Tracker, step *PipelineStep, existingID string) (*Experiment, error) {
   533		expName := step.Name
   534		var params map[string]string
   535		var tags []string
   536		if step.ExperimentConfig != nil {
   537			if step.ExperimentConfig.Name != "" {
   538				expName = step.ExperimentConfig.Name
   539			}
   540			params = step.ExperimentConfig.Params
   541		}
   542		if existingID != "" {
   543			if exp, err := tracker.store.GetExperiment(existingID); err == nil {
   544				return exp, nil
   545			}
   546		}
   547		return tracker.Create(expName, params, tags)
   548	}
   549	
   550	func finishTrainExperiment(tracker *Tracker, exp *Experiment, step *PipelineStep, output string) error {
   551		for _, line := range strings.Split(output, "\n") {
   552			key, value, ok := parseMetricLine(line)
   553			if !ok {
   554				continue
   555			}
   556			if len(step.ExperimentConfig.Metrics) > 0 && !containsString(step.ExperimentConfig.Metrics, key) {
   557				continue
   558			}
   559			if err := tracker.LogMetric(exp.ID, key, value); err != nil {
   560				return err
   561			}
   562		}
   563		return tracker.Complete(exp.ID, ExperimentStatusCompleted)
   564	}
   565	
   566	func parseMetricLine(line string) (string, float64, bool) {
   567		parts := strings.SplitN(line, "=", 2)
   568		if len(parts) != 2 {
   569			return "", 0, false
   570		}
   571		key := strings.TrimSpace(parts[0])
   572		val := strings.TrimSpace(parts[1])
   573		if key == "" {
   574			return "", 0, false
   575		}
   576		value, err := strconv.ParseFloat(val, 64)
   577		if err != nil {
   578			return "", 0, false
   579		}
   580		return key, value, true
   581	}
   582	
   583	func runShellCommand(command string, timeoutSeconds int) (string, int, error) {
   584		cmd := exec.Command("sh", "-c", command)
   585		var out strings.Builder
   586		cmd.Stdout = &out
   587		cmd.Stderr = &out
   588	
   589		if timeoutSeconds > 0 {
   590			timer := time.AfterFunc(time.Duration(timeoutSeconds)*time.Second, func() {
   591				if cmd.Process != nil {
   592					cmd.Process.Kill()
   593				}
   594			})
   595			defer timer.Stop()
   596		}
   597	
   598		err := cmd.Run()
   599		exitCode := 0
   600		if err != nil {
   601			if exitErr, ok := err.(*exec.ExitError); ok {
   602				exitCode = exitErr.ExitCode()
   603			} else {
   604				exitCode = 1
   605			}
   606			return out.String(), exitCode, fmt.Errorf("command failed: %s", err.Error())
   607		}
   608		return out.String(), exitCode, nil
   609	}
