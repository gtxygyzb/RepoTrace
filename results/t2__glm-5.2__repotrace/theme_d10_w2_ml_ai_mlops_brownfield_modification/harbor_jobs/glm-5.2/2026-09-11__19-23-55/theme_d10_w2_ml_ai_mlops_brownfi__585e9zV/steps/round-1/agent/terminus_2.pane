   667	func mergeParams(defaults, overrides map[string]string) map[string]string {
   668		merged := make(map[string]string)
   669		for k, v := range defaults {
   670			merged[k] = v
   671		}
   672		for k, v := range overrides {
   673			merged[k] = v
   674		}
   675		return merged
