   158		if exp.ModelRef != "" {
   159			if _, ok := s.data.Models[exp.ModelRef]; !ok {
   160				return fmt.Errorf("referenced model not found: %s", exp.ModelRef)
   161			}
   162		}
   163	
   164		// Validate dataset reference if set
   165		if exp.DatasetRef != "" {
   166			if _, ok := s.data.Datasets[exp.DatasetRef]; !ok {
   167				return fmt.Errorf("referenced dataset not found: %s", exp.DatasetRef)
   168			}
   169		}
   170	
   171		s.data.Experiments[exp.ID] = exp
   172		s.UpdateTagIndex("experiment:"+exp.ID, exp.Tags)
   173		return s.save()
   174	}
