   364		for _, step := range cfg.Steps {
   365			sr := runStepByName[step.Name]
   366			if sr.Status == "succeeded" || sr.Status == "skipped" {
   367				continue
   368			}
   369			if sr.Status == "failed" {
   370				sr.Status = "pending"
   371				sr.Error = ""
   372				sr.Output = ""
   373				sr.StartTime = nil
   374				sr.EndTime = nil
