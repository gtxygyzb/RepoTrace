[?2004l     1	package main
     2	
     3	import (
     4		"encoding/json"
     5		"fmt"
     6		"os"
     7		"path/filepath"
     8		"sync"
     9	)
    10	
    11	// Store manages persistence for all entities
    12	type Store struct {
    13		dataDir  string
    14		dataFile string
    15		mu       sync.RWMutex
    16		data     *StoreData
    17	}
    18	
    19	func NewStore(dataDir string) (*Store, error) {
    20		if dataDir == "" {
    21			dataDir = filepath.Join(os.TempDir(), "nexus")
    22		}
    23		if err := os.MkdirAll(dataDir, 0755); err != nil {
    24			return nil, fmt.Errorf("create data directory: %w", err)
    25		}
    26	
    27		s := &Store{
    28			dataDir:  dataDir,
    29			dataFile: filepath.Join(dataDir, "nexus_data.json"),
    30			data: &StoreData{
    31				Models:      make(map[string]*Model),
    32				Experiments: make(map[string]*Experiment),
    33				Datasets:    make(map[string]*Dataset),
    34				TagIndex:    make(map[string][]string),
    35			},
    36		}
    37	
    38		if err := s.load(); err != nil && !os.IsNotExist(err) {
    39			return nil, fmt.Errorf("load store: %w", err)
    40		}
    41	
    42		return s, nil
    43	}
    44	
    45	func (s *Store) load() error {
    46		data, err := os.ReadFile(s.dataFile)
    47		if err != nil {
    48			return err
    49		}
    50		return json.Unmarshal(data, s.data)
    51	}
    52	
    53	func (s *Store) save() error {
    54		data, err := json.MarshalIndent(s.data, "", "  ")
    55		if err != nil {
    56			return fmt.Errorf("marshal data: %w", err)
    57		}
    58		tmpFile := s.dataFile + ".tmp"
    59		if err := os.WriteFile(tmpFile, data, 0644); err != nil {
    60			return fmt.Errorf("write temp file: %w", err)
    61		}
    62		return os.Rename(tmpFile, s.dataFile)
    63	}
    64	
    65	// UpdateTagIndex maintains a shared tag index across all entity types.
    66	// This index is global: a tag search returns both model and experiment keys.
    67	func (s *Store) UpdateTagIndex(entityKey string, tags []string) {
    68		for tag, keys := range s.data.TagIndex {
    69			filtered := make([]string, 0)
    70			for _, k := range keys {
    71				if k != entityKey {
    72					filtered = append(filtered, k)
    73				}
    74			}
    75			if len(filtered) == 0 {
    76				delete(s.data.TagIndex, tag)
    77			} else {
    78				s.data.TagIndex[tag] = filtered
    79			}
    80		}
    81		for _, tag := range tags {
    82			s.data.TagIndex[tag] = append(s.data.TagIndex[tag], entityKey)
    83		}
    84	}
    85	
    86	// FindByTag returns all entity keys with the given tag
    87	func (s *Store) FindByTag(tag string) []string {
    88		s.mu.RLock()
    89		defer s.mu.RUnlock()
    90		return s.data.TagIndex[tag]
    91	}
    92	
    93	// === Model operations ===
    94	
    95	func (s *Store) SaveModel(m *Model) error {
    96		s.mu.Lock()
    97		defer s.mu.Unlock()
    98	
    99		key := m.Key()
   100		s.data.Models[key] = m
   101		s.UpdateTagIndex("model:"+key, m.Tags)
   102		return s.save()
   103	}
   104	
   105	func (s *Store) GetModel(name, version string) (*Model, error) {
   106		s.mu.RLock()
   107		defer s.mu.RUnlock()
   108	
   109		key := fmt.Sprintf("%s:%s", name, version)
   110		m, ok := s.data.Models[key]
   111		if !ok {
   112			return nil, fmt.Errorf("model not found: %s", key)
   113		}
   114		return m, nil
   115	}
