[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"sync"
)

// Store manages persistence for all entities
type Store struct {
	dataDir  string
	dataFile string
	mu       sync.RWMutex
	data     *StoreData
}

func NewStore(dataDir string) (*Store, error) {
	if dataDir == "" {
		dataDir = filepath.Join(os.TempDir(), "nexus")
	}
	if err := os.MkdirAll(dataDir, 0755); err != nil {
		return nil, fmt.Errorf("create data directory: %w", err)
	}

	s := &Store{
		dataDir:  dataDir,
		dataFile: filepath.Join(dataDir, "nexus_data.json"),
		data: &StoreData{
			Models:      make(map[string]*Model),
			Experiments: make(map[string]*Experiment),
			Datasets:    make(map[string]*Dataset),
			TagIndex:    make(map[string][]string),
		},
	}

	if err := s.load(); err != nil && !os.IsNotExist(err) {
		return nil, fmt.Errorf("load store: %w", err)
	}

	return s, nil
}

func (s *Store) load() error {
	data, err := os.ReadFile(s.dataFile)
	if err != nil {
		return err
	}
	return json.Unmarshal(data, s.data)
}

func (s *Store) save() error {
	data, err := json.MarshalIndent(s.data, "", "  ")
	if err != nil {
		return fmt.Errorf("marshal data: %w", err)
	}
	tmpFile := s.dataFile + ".tmp"
	if err := os.WriteFile(tmpFile, data, 0644); err != nil {
		return fmt.Errorf("write temp file: %w", err)
	}
	return os.Rename(tmpFile, s.dataFile)
}

// UpdateTagIndex maintains a shared tag index across all entity types.
// This index is global: a tag search returns both model and experiment keys.
func (s *Store) UpdateTagIndex(entityKey string, tags []string) {
	for tag, keys := range s.data.TagIndex {
		filtered := make([]string, 0)
		for _, k := range keys {
			if k != entityKey {
				filtered = append(filtered, k)
			}
		}
		if len(filtered) == 0 {
			delete(s.data.TagIndex, tag)
		} else {
			s.data.TagIndex[tag] = filtered
		}
	}
	for _, tag := range tags {
		s.data.TagIndex[tag] = append(s.data.TagIndex[tag], entityKey)
	}
}

// FindByTag returns all entity keys with the given tag
func (s *Store) FindByTag(tag string) []string {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return s.data.TagIndex[tag]
}

// === Model operations ===

func (s *Store) SaveModel(m *Model) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	key := m.Key()
	s.data.Models[key] = m
	s.UpdateTagIndex("model:"+key, m.Tags)
	return s.save()
}

func (s *Store) GetModel(name, version string) (*Model, error) {
	s.mu.RLock()
	defer s.mu.RUnlock()

	key := fmt.Sprintf("%s:%s", name, version)
	m, ok := s.data.Models[key]
	if !ok {
		return nil, fmt.Errorf("model not found: %s", key)
	}
	return m, nil
}

func (s *Store) ListModels(filter string) []*Model {
	s.mu.RLock()
	defer s.mu.RUnlock()

	var result []*Model
	for _, m := range s.data.Models {
		if filter == "" || m.Name == filter || string(m.Status) == filter {
			result = append(result, m)
		}
	}
	return result
}

func (s *Store) DeleteModel(name, version string) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	key := fmt.Sprintf("%s:%s", name, version)
	if _, ok := s.data.Models[key]; !ok {
		return fmt.Errorf("model not found: %s", key)
	}

	// Referential integrity: cannot delete models referenced by experiments
	for _, exp := range s.data.Experiments {
		if exp.ModelRef == key {
			return fmt.Errorf("model %s is referenced by experiment %s", key, exp.ID)
		}
	}

	delete(s.data.Models, key)
	s.UpdateTagIndex("model:"+key, nil)
	return s.save()
}

// === Experiment operations ===

func (s *Store) SaveExperiment(exp *Experiment) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	// Validate model reference if set
	if exp.ModelRef != "" {
		if _, ok := s.data.Models[exp.ModelRef]; !ok {
			return fmt.Errorf("referenced model not found: %s", exp.ModelRef)
		}
	}

	// Validate dataset reference if set
	if exp.DatasetRef != "" {
		if _, ok := s.data.Datasets[exp.DatasetRef]; !ok {
			return fmt.Errorf("referenced dataset not found: %s", exp.DatasetRef)
		}
	}

	s.data.Experiments[exp.ID] = exp
	s.UpdateTagIndex("experiment:"+exp.ID, exp.Tags)
	return s.save()
}

func (s *Store) GetExperiment(id string) (*Experiment, error) {
	s.mu.RLock()
	defer s.mu.RUnlock()

	exp, ok := s.data.Experiments[id]
[?2004hroot@n30009:/app# sed -n '1,120p' models.go
[?2004lpackage main

import (
	"fmt"
	"time"
)

// ModelStatus represents the lifecycle stage of a model
type ModelStatus string

const (
	ModelStatusRegistered ModelStatus = "registered"
	ModelStatusStaging    ModelStatus = "staging"
	ModelStatusProduction ModelStatus = "production"
	ModelStatusArchived   ModelStatus = "archived"
)

// Model represents an ML model in the registry
type Model struct {
	Name        string             `json:"name"`
	Version     string             `json:"version"`
	Framework   string             `json:"framework"`
	Description string             `json:"description,omitempty"`
	Tags        []string           `json:"tags,omitempty"`
	Status      ModelStatus        `json:"status"`
	Metrics     map[string]float64 `json:"metrics,omitempty"`
	CreatedAt   time.Time          `json:"created_at"`
	UpdatedAt   time.Time          `json:"updated_at"`
	ParentRef   string             `json:"parent_ref,omitempty"`
}

func (m *Model) Key() string {
	return fmt.Sprintf("%s:%s", m.Name, m.Version)
}

// ValidTransitions defines valid model lifecycle transitions
var ValidTransitions = map[ModelStatus][]ModelStatus{
	ModelStatusRegistered: {ModelStatusStaging, ModelStatusArchived},
	ModelStatusStaging:    {ModelStatusProduction, ModelStatusRegistered, ModelStatusArchived},
	ModelStatusProduction: {ModelStatusStaging, ModelStatusArchived},
	ModelStatusArchived:   {ModelStatusRegistered},
}

func (m *Model) CanTransitionTo(target ModelStatus) bool {
	allowed, ok := ValidTransitions[m.Status]
	if !ok {
		return false
	}
	for _, s := range allowed {
		if s == target {
			return true
		}
	}
	return false
}

// ExperimentStatus represents the state of an experiment run
type ExperimentStatus string

const (
	ExperimentStatusRunning   ExperimentStatus = "running"
	ExperimentStatusCompleted ExperimentStatus = "completed"
	ExperimentStatusFailed    ExperimentStatus = "failed"
)

// Experiment represents an ML experiment run
type Experiment struct {
	ID         string             `json:"id"`
	Name       string             `json:"name"`
	Status     ExperimentStatus   `json:"status"`
	Parameters map[string]string  `json:"parameters,omitempty"`
	Metrics    map[string]float64 `json:"metrics,omitempty"`
	Tags       []string           `json:"tags,omitempty"`
	ModelRef   string             `json:"model_ref,omitempty"`
	DatasetRef string             `json:"dataset_ref,omitempty"`
	StartTime  time.Time          `json:"start_time"`
	EndTime    time.Time          `json:"end_time,omitempty"`
	Notes      string             `json:"notes,omitempty"`
}

// Dataset represents a dataset version
type Dataset struct {
	Name      string    `json:"name"`
	Version   string    `json:"version"`
	Format    string    `json:"format"`
	Path      string    `json:"path"`
	RowCount  int64     `json:"row_count"`
	Schema    []Column  `json:"schema,omitempty"`
	CreatedAt time.Time `json:"created_at"`
	Checksum  string    `json:"checksum,omitempty"`
}

func (d *Dataset) Key() string {
	return fmt.Sprintf("%s:%s", d.Name, d.Version)
}

// Column represents a dataset column
type Column struct {
	Name     string `json:"name"`
	Type     string `json:"type"`
	Nullable bool   `json:"nullable"`
}

// StoreData holds all persisted data
type StoreData struct {
	Models      map[string]*Model      `json:"models"`
	Experiments map[string]*Experiment `json:"experiments"`
	Datasets    map[string]*Dataset    `json:"datasets"`
	TagIndex    map[string][]string    `json:"tag_index"`
}
