   121	func validatePipelineConfig(cfg *PipelineConfig) error {
   122		if cfg.Name == "" {
   123			return fmt.Errorf("pipeline name is required")
   124		}
   125		if len(cfg.Steps) == 0 {
   126			return fmt.Errorf("pipeline must have at least one step")
   127		}
   128	
   129		names := make(map[string]bool)
   130		for _, step := range cfg.Steps {
   131			if step.Name == "" {
   132				return fmt.Errorf("step name is required")
   133			}
   134			if names[step.Name] {
   135				return fmt.Errorf("duplicate step name: %s", step.Name)
   136			}
   137			names[step.Name] = true
   138			switch step.Type {
   139			case "shell", "train", "evaluate":
   140			default:
   141				return fmt.Errorf("step %s has invalid type: %s", step.Name, step.Type)
   142			}
   143			if step.Command == "" {
   144				return fmt.Errorf("step %s command is required", step.Name)
   145			}
   146			if step.Resources != nil && cfg.ResourceLimit != nil {
   147				if step.Resources.CPU > cfg.ResourceLimit.CPU {
   148					return fmt.Errorf("step %s cpu requirement %d exceeds pipeline limit %d", step.Name, step.Resources.CPU, cfg.ResourceLimit.CPU)
   149				}
   150				if step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {
   151					return fmt.Errorf("step %s memory requirement %d MB exceeds pipeline limit %d MB", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)
   152				}
   153			}
   154			if step.Type == "train" && step.ExperimentConfig == nil {
   155				return fmt.Errorf("train step %s requires experiment_config", step.Name)
   156			}
   157		}
   158	
   159		for _, step := range cfg.Steps {
   160			for _, dep := range step.DependsOn {
   161				if !names[dep] {
   162					return fmt.Errorf("step %s depends on unknown step %s", step.Name, dep)
   163				}
   164			}
   165		}
   166	
   167		if cycle := findCycle(cfg.Steps); cycle != nil {
   168			return fmt.Errorf("cycle detected: %s", strings.Join(cycle, " -> "))
   169		}
   170	
   171		producers := make(map[string]string)
   172		for _, step := range cfg.Steps {
   173			for _, out := range step.Outputs {
   174				if _, ok := producers[out]; ok {
   175					return fmt.Errorf("duplicate output artifact: %s", out)
   176				}
   177				producers[out] = step.Name
   178			}
   179		}
   180	
   181		for _, step := range cfg.Steps {
   182			for _, in := range step.Inputs {
   183				prod, ok := producers[in]
   184				if !ok {
   185					return fmt.Errorf("step %s input artifact %s is not produced by any step", step.Name, in)
   186				}
   187				if prod == step.Name {
   188					return fmt.Errorf("step %s input artifact %s must come from a dependency", step.Name, in)
   189				}
   190				if !isTransitiveDependency(cfg.Steps, step.Name, prod) {
   191					return fmt.Errorf("step %s input artifact %s producer %s is not a transitive dependency", step.Name, in, prod)
   192				}
   193			}
   194		}
   195		return nil
   196	}
   197	
   198	func findCycle(steps []*PipelineStep) []string {
   199		graph := make(map[string][]string)
   200		for _, s := range steps {
   201			graph[s.Name] = append(graph[s.Name], s.DependsOn...)
   202		}
   203		visited := make(map[string]int)
   204		var stack []string
   205		var dfs func(node string) []string
   206		dfs = func(node string) []string {
   207			visited[node] = 1
   208			stack = append(stack, node)
   209			for _, dep := range graph[node] {
   210				if visited[dep] == 1 {
   211					for i, n := range stack {
   212						if n == dep {
   213							return append(append([]string{}, stack[i:]...), dep)
   214						}
   215					}
   216					return []string{node, dep}
   217				}
   218				if visited[dep] == 0 {
   219					if c := dfs(dep); c != nil {
   220						return c
   221					}
   222				}
   223			}
   224			stack = stack[:len(stack)-1]
   225			visited[node] = 2
   226			return nil
   227		}
   228		for _, s := range steps {
   229			if visited[s.Name] == 0 {
   230				if c := dfs(s.Name); c != nil {
   231					return c
   232				}
   233			}
   234		}
