[?2004l   341	func executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {
   342		stepByName := make(map[string]*PipelineStep)
   343		for _, s := range cfg.Steps {
   344			stepByName[s.Name] = s
   345		}
   346		runStepByName := make(map[string]*StepRun)
   347		for _, sr := range run.Steps {
   348			runStepByName[sr.Name] = sr
   349		}
   350	
   351		variables := make(map[string]string)
   352		if run.Variables != nil {
   353			for k, v := range run.Variables {
   354				variables[k] = v
   355			}
   356		} else {
   357			for k, v := range params {
   358				variables[k] = v
   359			}
   360		}
   361		if run.Warnings == nil {
   362			run.Warnings = []string{}
   363		}
   364	
   365		var varMu sync.Mutex
   366	
   367		for _, step := range cfg.Steps {
   368			sr := runStepByName[step.Name]
   369			if sr != nil && (sr.Status == "succeeded" || sr.Status == "skipped") {
   370				variables["steps."+step.Name+".status"] = sr.Status
   371			}
   372		}
   373	
   374		var mu sync.Mutex
   375		var running []*PipelineStep
   376		available := make(chan struct{}, maxParallel)
   377	
   378		pending := make(map[string]bool)
   379		for _, step := range cfg.Steps {
   380			sr := runStepByName[step.Name]
   381			if sr.Status == "succeeded" || sr.Status == "skipped" {
   382				continue
   383			}
   384			if sr.Status == "failed" {
   385				sr.Status = "pending"
   386				sr.Error = ""
   387				sr.Output = ""
   388				sr.StartTime = nil
   389				sr.EndTime = nil
   390			}
   391			pending[step.Name] = true
   392		}
   393	
   394		var wg sync.WaitGroup
   395		done := false
   396	
   397		canStart := func(step *PipelineStep) bool {
   398			for _, dep := range step.DependsOn {
   399				status := runStepByName[dep].Status
   400				if status == "succeeded" || status == "skipped" {
   401					continue
   402				}
   403				if status == "failed" {
   404					if depStep := stepByName[dep]; depStep != nil && depStep.AllowFailure {
   405						continue
   406					}
   407				}
   408				return false
   409			}
   410			if step.Resources != nil && cfg.ResourceLimit != nil {
   411				var cpu, mem int
   412				for _, r := range running {
   413					if r.Resources != nil {
   414						cpu += r.Resources.CPU
   415						mem += r.Resources.MemoryMB
   416					}
   417				}
   418				if cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {
   419					return false
   420				}
   421			}
   422			return true
   423		}
   424	
   425		startStep := func(step *PipelineStep) {
   426			pending[step.Name] = false
   427			running = append(running, step)
   428			wg.Add(1)
   429			go func(s *PipelineStep) {
   430				defer wg.Done()
   431				executeStep(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])
   432				mu.Lock()
   433				running = removeStep(running, s)
   434				status := runStepByName[s.Name].Status
   435				if status == "failed" {
   436					if s.AllowFailure {
   437						if !containsString(run.Warnings, s.Name) {
   438							run.Warnings = append(run.Warnings, s.Name)
   439						}
   440					} else {
   441						run.Status = "failed"
   442						done = true
   443					}
   444				}
   445				varMu.Lock()
   446				variables["steps."+s.Name+".status"] = status
   447				run.Variables = copyMap(variables)
   448				varMu.Unlock()
   449				saveCheckpoint(run)
   450				saveRun(run)
   451				mu.Unlock()
   452				<-available
   453			}(step)
   454		}
