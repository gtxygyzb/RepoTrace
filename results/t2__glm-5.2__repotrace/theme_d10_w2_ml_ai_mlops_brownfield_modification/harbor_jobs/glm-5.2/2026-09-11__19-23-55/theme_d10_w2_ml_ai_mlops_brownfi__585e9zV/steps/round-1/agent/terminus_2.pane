[?2004l   348	func executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {
   349		stepByName := make(map[string]*PipelineStep)
   350		for _, s := range cfg.Steps {
   351			stepByName[s.Name] = s
   352		}
   353		runStepByName := make(map[string]*StepRun)
   354		for _, sr := range run.Steps {
   355			runStepByName[sr.Name] = sr
   356		}
   357	
   358		variables := make(map[string]string)
   359		if run.Variables != nil {
   360			for k, v := range run.Variables {
   361				variables[k] = v
   362			}
   363		} else {
   364			for k, v := range params {
   365				variables[k] = v
   366			}
   367		}
   368		if run.Warnings == nil {
   369			run.Warnings = []string{}
   370		}
   371	
   372		var varMu sync.Mutex
   373	
   374		for _, step := range cfg.Steps {
   375			sr := runStepByName[step.Name]
   376			if sr != nil && (sr.Status == "succeeded" || sr.Status == "skipped") {
   377				variables["steps."+step.Name+".status"] = sr.Status
   378				variables["steps."+step.Name+".output"] = stepRunOutputValue(sr)
   379				variables["steps."+step.Name+".duration"] = stepRunDurationValue(sr)
   380			}
   381		}
   382	
   383		var mu sync.Mutex
   384		var running []*PipelineStep
   385		available := make(chan struct{}, maxParallel)
   386	
   387		pending := make(map[string]bool)
   388		for _, step := range cfg.Steps {
   389			sr := runStepByName[step.Name]
   390			if sr.Status == "succeeded" || sr.Status == "skipped" {
   391				continue
   392			}
   393			if sr.Status == "failed" {
   394				sr.Status = "pending"
   395				sr.Error = ""
   396				sr.Output = ""
   397				sr.StartTime = nil
   398				sr.EndTime = nil
   399			}
   400			pending[step.Name] = true
   401		}
   402	
   403		var wg sync.WaitGroup
   404		done := false
   405	
   406		canStart := func(step *PipelineStep) bool {
   407			for _, dep := range step.DependsOn {
   408				status := runStepByName[dep].Status
   409				if status == "succeeded" || status == "skipped" {
   410					continue
   411				}
   412				if status == "failed" {
   413					if depStep := stepByName[dep]; depStep != nil && depStep.AllowFailure {
   414						continue
   415					}
   416				}
   417				return false
   418			}
   419			if step.Resources != nil && cfg.ResourceLimit != nil {
   420				var cpu, mem int
   421				for _, r := range running {
   422					if r.Resources != nil {
   423						cpu += r.Resources.CPU
   424						mem += r.Resources.MemoryMB
   425					}
   426				}
   427				if cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {
   428					return false
   429				}
   430			}
   431			return true
   432		}
   433	
   434		startStep := func(step *PipelineStep) {
   435			pending[step.Name] = false
   436			running = append(running, step)
   437			wg.Add(1)
   438			go func(s *PipelineStep) {
   439				defer wg.Done()
   440				executeStep(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])
   441				mu.Lock()
   442				running = removeStep(running, s)
   443				status := runStepByName[s.Name].Status
   444				if status == "failed" {
   445					if s.AllowFailure {
   446						if !containsString(run.Warnings, s.Name) {
   447							run.Warnings = append(run.Warnings, s.Name)
   448						}
   449					} else {
   450						run.Status = "failed"
   451						done = true
   452					}
   453				}
   454				varMu.Lock()
   455				variables["steps."+s.Name+".status"] = status
