   129	
   130	func (s *Store) DeleteModel(name, version string) error {
   131		s.mu.Lock()
   132		defer s.mu.Unlock()
   133	
   134		key := fmt.Sprintf("%s:%s", name, version)
   135		if _, ok := s.data.Models[key]; !ok {
   136			return fmt.Errorf("model not found: %s", key)
   137		}
   138	
   139		// Referential integrity: cannot delete models referenced by experiments
   140		for _, exp := range s.data.Experiments {
   141			if exp.ModelRef == key {
   142				return fmt.Errorf("model %s is referenced by experiment %s", key, exp.ID)
   143			}
   144		}
   145	
   146		delete(s.data.Models, key)
   147		s.UpdateTagIndex("model:"+key, nil)
   148		return s.save()
   149	}
   150	
   151	// === Experiment operations ===
   152	
   153	func (s *Store) SaveExperiment(exp *Experiment) error {
   154		s.mu.Lock()
   155		defer s.mu.Unlock()
   156	
   157		// Validate model reference if set
   158		if exp.ModelRef != "" {
   159			if _, ok := s.data.Models[exp.ModelRef]; !ok {
   160				return fmt.Errorf("referenced model not found: %s", exp.ModelRef)
   161			}
   162		}
   163	
   164		// Validate dataset reference if set
   165		if exp.DatasetRef != "" {
   166			if _, ok := s.data.Datasets[exp.DatasetRef]; !ok {
   167				return fmt.Errorf("referenced dataset not found: %s", exp.DatasetRef)
   168			}
   169		}
   170	
   171		s.data.Experiments[exp.ID] = exp
   172		s.UpdateTagIndex("experiment:"+exp.ID, exp.Tags)
   173		return s.save()
   174	}
   175	
   176	func (s *Store) GetExperiment(id string) (*Experiment, error) {
   177		s.mu.RLock()
   178		defer s.mu.RUnlock()
   179	
   180		exp, ok := s.data.Experiments[id]
   181		if !ok {
   182			return nil, fmt.Errorf("experiment not found: %s", id)
   183		}
   184		return exp, nil
   185	}
   186	
   187	func (s *Store) ListExperiments(filter string) []*Experiment {
   188		s.mu.RLock()
   189		defer s.mu.RUnlock()
   190	
   191		var result []*Experiment
   192		for _, exp := range s.data.Experiments {
   193			if filter == "" || exp.Name == filter || string(exp.Status) == filter {
   194				result = append(result, exp)
   195			}
   196		}
   197		return result
   198	}
