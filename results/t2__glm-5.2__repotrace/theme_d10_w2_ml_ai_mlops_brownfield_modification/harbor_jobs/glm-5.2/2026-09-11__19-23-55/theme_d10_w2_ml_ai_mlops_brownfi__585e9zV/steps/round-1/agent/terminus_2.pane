   106	func loadPipelineConfig(path string) (*PipelineConfig, error) {
   107		data, err := os.ReadFile(path)
   108		if err != nil {
   109			return nil, fmt.Errorf("read pipeline config: %w", err)
   110		}
   111		var cfg PipelineConfig
   112		if err := json.Unmarshal(data, &cfg); err != nil {
   113			return nil, fmt.Errorf("parse pipeline config: %w", err)
   114		}
   115		if cfg.MaxParallel <= 0 {
   116			cfg.MaxParallel = 4
   117		}
   118		return &cfg, nil
   119	}
