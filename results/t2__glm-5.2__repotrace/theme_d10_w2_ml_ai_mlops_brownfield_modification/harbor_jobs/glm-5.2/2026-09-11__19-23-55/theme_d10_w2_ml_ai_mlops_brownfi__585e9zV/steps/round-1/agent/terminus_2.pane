old = '''func runShellCommand(command string, timeoutSeconds int, env []string) (string, int, error) {
\tcmd := exec.Command("sh", "-c", command)
\tif env != nil {
\t\tcmd.Env = env
\t}
\tvar out strings.Builder
\tcmd.Stdout = &out
\tcmd.Stderr = &out

\tif timeoutSeconds > 0 {
\t\ttimer := time.AfterFunc(time.Duration(timeoutSeconds)*time.Second, func() {
\t\t\tif cmd.Process != nil {
\t\t\t\tcmd.Process.Kill()
\t\t\t}
\t\t})
\t\tdefer timer.Stop()
\t}

\terr := cmd.Run()
\texitCode := 0
\tif err != nil {
\t\tif exitErr, ok := err.(*exec.ExitError); ok {
\t\t\texitCode = exitErr.ExitCode()
\t\t\t} else {
\t\t\t\texitCode = 1
\t\t\t}
\t\t\treturn out.String(), exitCode, fmt.Errorf("command failed: %s", err.Error())
\t\t}
\t\treturn out.String(), exitCode, nil
\t}
'''
new = '''func runShellCommand(command string, timeoutSeconds int, env []string) (string, string, int, error) {
\tcmd := exec.Command("sh", "-c", command)
\tif env != nil {
\t\tcmd.Env = env
\t}
\tvar stdout strings.Builder
\tvar stderr strings.Builder
\tcmd.Stdout = &stdout
\tcmd.Stderr = &stderr

\tif timeoutSeconds > 0 {
\t\ttimer := time.AfterFunc(time.Duration(timeoutSeconds)*time.Second, func() {
\t\t\tif cmd.Process != nil {
\t\t\t\tcmd.Process.Kill()
\t\t\t}
\t\t})
\t\tdefer timer.Stop()
\t}

\terr := cmd.Run()
\texitCode := 0
\tif err != nil {
\t\tif exitErr, ok := err.(*exec.ExitError); ok {
\t\t\texitCode = exitErr.ExitCode()
\t\t\t} else {
\t\t\t\texitCode = 1
\t\t\t}
\t\t\treturn stdout.String(), stderr.String(), exitCode, fmt.Errorf("command failed: %s", err.Error())
\t\t}
\t\treturn stdout.String(), stderr.String(), exitCode, nil
\t}
'''
