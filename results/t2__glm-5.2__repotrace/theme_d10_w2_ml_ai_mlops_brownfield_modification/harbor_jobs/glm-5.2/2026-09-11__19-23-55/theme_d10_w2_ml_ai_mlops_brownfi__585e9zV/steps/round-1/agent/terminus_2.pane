   134	func loadPipelineConfig(path string) (*PipelineConfig, error) {
   135		data, err := os.ReadFile(path)
   136		if err != nil {
   137			return nil, fmt.Errorf("read pipeline config: %w", err)
   138		}
   139		var cfg PipelineConfig
   140		if err := json.Unmarshal(data, &cfg); err != nil {
   141			return nil, fmt.Errorf("parse pipeline config: %w", err)
   142		}
   143		if cfg.MaxParallel <= 0 {
   144			cfg.MaxParallel = 4
   145		}
   146		return &cfg, nil
   147	}
   148	
   149	func validatePipelineConfig(cfg *PipelineConfig) error {
   150		if cfg.Name == "" {
   151			return fmt.Errorf("pipeline name is required")
   152		}
   153		if len(cfg.Steps) == 0 {
   154			return fmt.Errorf("pipeline must have at least one step")
   155		}
   156	
   157		names := make(map[string]bool)
   158		for _, step := range cfg.Steps {
   159			if step.Name == "" {
   160				return fmt.Errorf("step name is required")
   161			}
   162			if names[step.Name] {
   163				return fmt.Errorf("duplicate step name: %s", step.Name)
   164			}
   165			names[step.Name] = true
   166			switch step.Type {
   167			case "shell", "train", "evaluate":
   168			default:
   169				return fmt.Errorf("step %s has invalid type: %s", step.Name, step.Type)
   170			}
   171			if step.Command == "" {
   172				return fmt.Errorf("step %s command is required", step.Name)
   173			}
   174			if step.Resources != nil && cfg.ResourceLimit != nil {
   175				if step.Resources.CPU > cfg.ResourceLimit.CPU {
   176					return fmt.Errorf("step %s cpu requirement %d exceeds pipeline limit %d", step.Name, step.Resources.CPU, cfg.ResourceLimit.CPU)
   177				}
   178				if step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {
   179					return fmt.Errorf("step %s memory requirement %d MB exceeds pipeline limit %d MB", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)
   180				}
   181			}
   182			if step.Type == "train" && step.ExperimentConfig == nil {
   183				return fmt.Errorf("train step %s requires experiment_config", step.Name)
   184			}
   185		}
   186	
   187		for _, step := range cfg.Steps {
   188			for _, dep := range step.DependsOn {
   189				if !names[dep] {
   190					return fmt.Errorf("step %s depends on unknown step %s", step.Name, dep)
   191				}
   192			}
   193		}
   194	
   195		if cycle := findCycle(cfg.Steps); cycle != nil {
   196			return fmt.Errorf("cycle detected: %s", strings.Join(cycle, " -> "))
   197		}
   198	
   199		producers := make(map[string]string)
   200		for _, step := range cfg.Steps {
   201			for _, out := range step.Outputs {
   202				if _, ok := producers[out]; ok {
   203					return fmt.Errorf("duplicate output artifact: %s", out)
   204				}
   205				producers[out] = step.Name
   206			}
   207		}
   208	
   209		for _, step := range cfg.Steps {
   210			for _, in := range step.Inputs {
   211				prod, ok := producers[in]
   212				if !ok {
   213					return fmt.Errorf("step %s input artifact %s is not produced by any step", step.Name, in)
   214				}
   215				if prod == step.Name {
   216					return fmt.Errorf("step %s input artifact %s must come from a dependency", step.Name, in)
   217				}
   218				if !isTransitiveDependency(cfg.Steps, step.Name, prod) {
   219					return fmt.Errorf("step %s input artifact %s producer %s is not a transitive dependency", step.Name, in, prod)
   220				}
[?2004hroot@n30009:/app# nl -ba pipeline.go | sed -n '220,520p'
[?2004l   220				}
   221			}
   222		}
   223		return nil
   224	}
   225	
   226	func findCycle(steps []*PipelineStep) []string {
   227		graph := make(map[string][]string)
   228		for _, s := range steps {
   229			graph[s.Name] = append(graph[s.Name], s.DependsOn...)
   230		}
   231		visited := make(map[string]int)
   232		var stack []string
   233		var dfs func(node string) []string
   234		dfs = func(node string) []string {
   235			visited[node] = 1
   236			stack = append(stack, node)
   237			for _, dep := range graph[node] {
   238				if visited[dep] == 1 {
   239					for i, n := range stack {
   240						if n == dep {
   241							return append(append([]string{}, stack[i:]...), dep)
   242						}
   243					}
   244					return []string{node, dep}
   245				}
   246				if visited[dep] == 0 {
   247					if c := dfs(dep); c != nil {
   248						return c
   249					}
   250				}
   251			}
   252			stack = stack[:len(stack)-1]
   253			visited[node] = 2
   254			return nil
   255		}
   256		for _, s := range steps {
   257			if visited[s.Name] == 0 {
   258				if c := dfs(s.Name); c != nil {
   259					return c
   260				}
   261			}
   262		}
   263		return nil
   264	}
   265	
   266	func isTransitiveDependency(steps []*PipelineStep, step, target string) bool {
   267		byName := make(map[string]*PipelineStep)
   268		for _, s := range steps {
   269			byName[s.Name] = s
   270		}
   271		var visit func(current string) bool
   272		visit = func(current string) bool {
   273			s := byName[current]
   274			for _, dep := range s.DependsOn {
   275				if dep == target {
   276					return true
   277				}
   278				if visit(dep) {
   279					return true
   280				}
   281			}
   282			return false
   283		}
   284		return visit(step)
   285	}
   286	
   287	func runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {
   288		if err := validatePipelineConfig(cfg); err != nil {
   289			return nil, err
   290		}
   291		merged := mergeParams(cfg.Parameters, params)
   292		if maxParallel <= 0 {
   293			maxParallel = cfg.MaxParallel
   294		}
   295		if maxParallel <= 0 {
   296			maxParallel = 4
   297		}
   298	
   299		runID := generateRunID()
   300		runDir := filepath.Join(pipelineRunsDir, runID)
   301		artifactsDir := filepath.Join(runDir, "artifacts")
   302		if err := os.MkdirAll(artifactsDir, 0755); err != nil {
   303			return nil, fmt.Errorf("create run dir: %w", err)
   304		}
   305		if cfgData, err := json.MarshalIndent(cfg, "", "  "); err == nil {
   306			os.WriteFile(filepath.Join(runDir, "pipeline_config.json"), cfgData, 0644)
   307		}
   308	
   309		now := time.Now()
   310		run := &PipelineRun{
   311			ID:         runID,
   312			Pipeline:   cfg.Name,
   313			Status:     "running",
   314			Parameters: merged,
   315			StartTime:  &now,
   316			RunDir:     runDir,
   317			Variables:  copyMap(merged),
   318			Steps:      make([]*StepRun, 0, len(cfg.Steps)),
   319		}
   320		for _, step := range cfg.Steps {
   321			run.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: "pending"})
   322		}
   323		saveRun(run)
   324	
   325		err := executeSteps(cfg, run, tracker, merged, maxParallel)
   326		endTime := time.Now()
   327		run.EndTime = &endTime
   328		if err != nil {
   329			run.Status = "failed"
   330		} else {
   331			run.Status = "succeeded"
   332		}
   333		saveRun(run)
   334		return run, err
   335	}
   336	
   337	func executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {
   338		stepByName := make(map[string]*PipelineStep)
   339		for _, s := range cfg.Steps {
   340			stepByName[s.Name] = s
   341		}
   342		runStepByName := make(map[string]*StepRun)
   343		for _, sr := range run.Steps {
   344			runStepByName[sr.Name] = sr
   345		}
   346	
   347		variables := make(map[string]string)
   348		if run.Variables != nil {
   349			for k, v := range run.Variables {
   350				variables[k] = v
   351			}
   352		} else {
   353			for k, v := range params {
   354				variables[k] = v
   355			}
   356		}
   357		var varMu sync.Mutex
   358	
   359		var mu sync.Mutex
   360		var running []*PipelineStep
   361		available := make(chan struct{}, maxParallel)
   362	
   363		pending := make(map[string]bool)
   364		for _, step := range cfg.Steps {
   365			sr := runStepByName[step.Name]
   366			if sr.Status == "succeeded" || sr.Status == "skipped" {
   367				continue
   368			}
   369			if sr.Status == "failed" {
   370				sr.Status = "pending"
   371				sr.Error = ""
   372				sr.Output = ""
   373				sr.StartTime = nil
   374				sr.EndTime = nil
   375			}
   376			pending[step.Name] = true
   377		}
   378	
   379		var wg sync.WaitGroup
   380		done := false
   381	
   382		canStart := func(step *PipelineStep) bool {
   383			for _, dep := range step.DependsOn {
   384				status := runStepByName[dep].Status
   385				if status != "succeeded" && status != "skipped" {
   386					return false
   387				}
   388			}
   389			if step.Resources != nil && cfg.ResourceLimit != nil {
   390				var cpu, mem int
   391				for _, r := range running {
   392					if r.Resources != nil {
   393						cpu += r.Resources.CPU
   394						mem += r.Resources.MemoryMB
   395					}
   396				}
   397				if cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {
   398					return false
   399				}
   400			}
   401			return true
   402		}
   403	
   404		startStep := func(step *PipelineStep) {
   405			pending[step.Name] = false
   406			running = append(running, step)
   407			wg.Add(1)
   408			go func(s *PipelineStep) {
   409				defer wg.Done()
   410				executeStep(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])
   411				mu.Lock()
   412				running = removeStep(running, s)
   413				if runStepByName[s.Name].Status == "failed" {
   414					run.Status = "failed"
   415					done = true
   416				}
   417				varMu.Lock()
   418				run.Variables = copyMap(variables)
   419				varMu.Unlock()
   420				saveCheckpoint(run)
   421				saveRun(run)
   422				mu.Unlock()
   423				<-available
   424			}(step)
   425		}
   426	
   427		for !done && (len(pending) > 0 || len(running) > 0) {
   428			startedAny := false
   429			var starts []*PipelineStep
   430			mu.Lock()
   431			for _, step := range cfg.Steps {
   432				if pending[step.Name] && canStart(step) {
   433					starts = append(starts, step)
   434				}
   435			}
   436			mu.Unlock()
   437			sort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })
   438			for _, step := range starts {
   439				available <- struct{}{}
   440				mu.Lock()
   441				if done || !pending[step.Name] || !canStart(step) {
   442					mu.Unlock()
   443					<-available
   444					continue
   445				}
   446				startStep(step)
   447				mu.Unlock()
   448				startedAny = true
   449			}
   450	
   451			if !startedAny {
   452				if len(running) == 0 {
   453					break
   454				}
   455				time.Sleep(10 * time.Millisecond)
   456			}
   457		}
   458		wg.Wait()
   459	
   460		for _, sr := range run.Steps {
   461			if sr.Status == "pending" {
   462				sr.Status = "failed"
   463				sr.Error = "dependency failed"
   464			}
   465		}
   466		varMu.Lock()
   467		run.Variables = copyMap(variables)
   468		varMu.Unlock()
   469		saveCheckpoint(run)
   470		saveRun(run)
   471	
   472		if run.Status == "failed" {
   473			return fmt.Errorf("pipeline execution failed")
   474		}
   475		return nil
   476	}
   477	func removeStep(steps []*PipelineStep, target *PipelineStep) []*PipelineStep {
   478		out := make([]*PipelineStep, 0, len(steps))
   479		for _, s := range steps {
   480			if s != target {
   481				out = append(out, s)
   482			}
   483		}
   484		return out
   485	}
