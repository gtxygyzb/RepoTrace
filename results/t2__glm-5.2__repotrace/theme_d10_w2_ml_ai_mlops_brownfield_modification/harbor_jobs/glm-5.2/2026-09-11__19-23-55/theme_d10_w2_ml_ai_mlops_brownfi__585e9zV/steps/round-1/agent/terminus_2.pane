   943	func resumePipeline(runID string, tracker *Tracker) (*PipelineRun, error) {
   944		run, err := loadRun(runID)
   945		if err != nil {
   946			return nil, err
   947		}
   948		cpPath := filepath.Join(run.RunDir, "checkpoint.json")
   949		cpData, err := os.ReadFile(cpPath)
   950		if err == nil {
   951			var cp Checkpoint
   952			if json.Unmarshal(cpData, &cp) == nil {
   953				run.Status = cp.Status
   954				run.Parameters = cp.Parameters
   955				run.Steps = cp.Steps
   956				run.Artifacts = cp.Artifacts
   957			}
   958		}
   959	
   960		cfgPath := filepath.Join(run.RunDir, "pipeline_config.json")
   961		var cfg *PipelineConfig
   962		if cfgData, err := os.ReadFile(cfgPath); err == nil {
   963			var c PipelineConfig
   964			if json.Unmarshal(cfgData, &c) == nil {
   965				cfg = &c
   966			}
   967		}
   968		if cfg == nil {
   969			return nil, fmt.Errorf("pipeline config not found for run %s", runID)
   970		}
   971	
   972		completed := true
   973		for _, sr := range run.Steps {
   974			if sr.Status != "succeeded" && sr.Status != "skipped" {
   975				completed = false
   976				break
   977			}
   978		}
   979		if completed {
   980			run.Status = "succeeded"
   981			run.Warnings = []string{}
   982			saveRun(run)
   983			return run, nil
   984		}
   985	
   986		run.Status = "running"
   987		run.Warnings = []string{}
   988		saveRun(run)
   989	
   990		err = executeSteps(cfg, run, tracker, run.Parameters, cfg.MaxParallel)
   991		endTime := time.Now()
   992		run.EndTime = &endTime
   993		if err != nil {
   994			run.Status = "failed"
   995		} else if run.Status != "succeeded_with_warnings" {
   996			run.Status = "succeeded"
   997		}
   998		saveRun(run)
   999		return run, err
  1000	}
