[?2004hroot@n30009:/app# cat >> pipeline.go <<'EOF'
[?2004l = n
			}
		}
		run, err := runPipeline(cfg, tracker, params, maxParallel)
		if run != nil {
			printJSON(run)
		}
		if err != nil {
			os.Exit(1)
		}

	case "status":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "run-id required")
			os.Exit(1)
		}
		run, err := loadRun(args[1])
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		printJSON(run)

	case "list":
		printJSON(listRuns())

	case "artifacts":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "run-id required")
			os.Exit(1)
		}
		run, err := loadRun(args[1])
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		var cfg *PipelineConfig
		if cfgData, err := os.ReadFile(filepath.Join(pipelineRunsDir, args[1], "pipeline_config.json")); err == nil {
			var c PipelineConfig
			if json.Unmarshal(cfgData, &c) == nil {
				cfg = &c
			}
		}
		printJSON(buildArtifactManifest(run, cfg))

	case "resume":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "run-id required")
			os.Exit(1)
		}
		run, err := resumePipeline(args[1], tracker)
		if run != nil {
			printJSON(run)
		}
		if err != nil {
			os.Exit(1)
		}

	default:
		fmt.Fprintf(os.Stderr, "Unknown pipeline subcommand: %s\n", args[0])
		os.Exit(1)
	}
}

func parsePipelineParams(args []string) map[string]string {
	params := make(map[string]string)
	for _, a := range args {
		if strings.HasPrefix(a, "--param") && len(a) > len("--param") {
			rest := a[len("--param"):]
			if strings.HasPrefix(rest, "=") {
				rest = rest[1:]
			}
			if rest == "" {
				continue
			}
			parts := strings.SplitN(rest, "=", 2)
			if len(parts) == 2 {
				params[parts[0]] = parts[1]
			}
		}
	}
	return params
}
