func parsePipelineParams(args []string) map[string]string {
\tparams := make(map[string]string)
\tfor _, a := range args {
\t\tif strings.HasPrefix(a, "--param") && len(a) > len("--param") {
\t\t\trest := a[len("--param"):]            
\t\t\tif strings.HasPrefix(rest, "=") {
\t\t\t\trest = rest[1:]
\t\t\t}
\t\t\tif rest == "" {
\t\t\t\tcontinue
\t\t\t}
\t\t\tparts := strings.SplitN(rest, "=", 2)
\t\t\tif len(parts) == 2 {
\t\t\t\tparams[parts[0]] = parts[1]
\t\t\t}
\t\t}
\t}
\treturn params
}
'''
