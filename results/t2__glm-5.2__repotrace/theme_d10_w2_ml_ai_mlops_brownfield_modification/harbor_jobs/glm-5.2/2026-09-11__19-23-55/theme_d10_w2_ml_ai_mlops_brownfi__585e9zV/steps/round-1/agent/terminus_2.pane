	"sync"
	"time"
)

const pipelineRunsDir = "/tmp/nexus/runs"

type PipelineResourceLimit struct {
	CPU      int `json:"cpu,omitempty"`
	MemoryMB int `json:"memory_mb,omitempty"`
}

type PipelineStepResources struct {
	CPU      int `json:"cpu,omitempty"`
	MemoryMB int `json:"memory_mb,omitempty"`
}

type PipelineStepRetry struct {
	MaxRetries         int `json:"max_retries,omitempty"`
	BackoffBaseSeconds int `json:"backoff_base_seconds,omitempty"`
}

type CaptureOutputConfig struct {
	Name  string `json:"name"`
	Regex string `json:"regex,omitempty"`
}

func (c *CaptureOutputConfig) UnmarshalJSON(data []byte) error {
	var str string
	if err := json.Unmarshal(data, &str); err == nil {
		c.Name = str
		c.Regex = ""
		return nil
	}
	var raw struct {
		Name  string `json:"name"`
		Regex string `json:"regex"`
	}
	if err := json.Unmarshal(data, &raw); err != nil {
		return fmt.Errorf("capture_output must be a string or an object with name and optional regex")
	}
	c.Name = raw.Name
	c.Regex = raw.Regex
	return nil
}

type PipelineExperimentConfig struct {
	Name    string            `json:"name,omitempty"`
	Params  map[string]string `json:"params,omitempty"`
	Metrics []string          `json:"metrics,omitempty"`
}

type PipelineStep struct {
	Name             string                    `json:"name"`
	Type             string                    `json:"type"`
	Command          string                    `json:"command"`
	DependsOn        []string                  `json:"depends_on,omitempty"`
	Inputs           []string                  `json:"inputs,omitempty"`
	Outputs          []string                  `json:"outputs,omitempty"`
	Resources        *PipelineStepResources    `json:"resources,omitempty"`
	TimeoutSeconds   int                       `json:"timeout_seconds,omitempty"`
	Retry            *PipelineStepRetry        `json:"retry,omitempty"`
	Condition        string                    `json:"condition,omitempty"`
	ExperimentConfig *PipelineExperimentConfig `json:"experiment_config,omitempty"`
	DatasetRef       string                    `json:"dataset_ref,omitempty"`
	CaptureOutput    *CaptureOutputConfig      `json:"capture_output,omitempty"`
	Env              map[string]string         `json:"env,omitempty"`
}

type PipelineConfig struct {
	Name          string                 `json:"name"`
	Parameters    map[string]string      `json:"parameters,omitempty"`
	MaxParallel   int                    `json:"max_parallel,omitempty"`
	ResourceLimit *PipelineResourceLimit `json:"resource_limit,omitempty"`
	Steps         []*PipelineStep        `json:"steps"`
}

type Artifact struct {
	Name     string `json:"name"`
	Type     string `json:"type"`
	Producer string `json:"producer"`
	Path     string `json:"path"`
	Size     int64  `json:"size"`
}

type StepRun struct {
	Name         string     `json:"name"`
	Type         string     `json:"type"`
	Status       string     `json:"status"`
	StartTime    *time.Time `json:"start_time,omitempty"`
	EndTime      *time.Time `json:"end_time,omitempty"`
	ExitCode     int        `json:"exit_code,omitempty"`
	Output       string     `json:"output,omitempty"`
	Error        string     `json:"error,omitempty"`
	Artifacts    []Artifact `json:"artifacts,omitempty"`
	ExperimentID string     `json:"experiment_id,omitempty"`
	RetryCount   int        `json:"retry_count"`
}

type PipelineRun struct {
	ID         string            `json:"id"`
	Pipeline   string            `json:"pipeline"`
	Status     string            `json:"status"`
	Parameters map[string]string `json:"parameters,omitempty"`
	StartTime  *time.Time        `json:"start_time,omitempty"`
	EndTime    *time.Time        `json:"end_time,omitempty"`
	Steps      []*StepRun        `json:"steps"`
	Artifacts  []Artifact        `json:"artifacts,omitempty"`
	RunDir     string            `json:"run_dir,omitempty"`
	Variables  map[string]string `json:"variables,omitempty"`
}

type Checkpoint struct {
	RunID      string            `json:"run_id"`
	Status     string            `json:"status"`
	Parameters map[string]string `json:"parameters,omitempty"`
	Steps      []*StepRun        `json:"steps"`
	Artifacts  []Artifact        `json:"artifacts,omitempty"`
	Variables  map[string]string `json:"variables,omitempty"`
}

func loadPipelineConfig(path string) (*PipelineConfig, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, fmt.Errorf("read pipeline config: %w", err)
	}
	var cfg PipelineConfig
	if err := json.Unmarshal(data, &cfg); err != nil {
		return nil, fmt.Errorf("parse pipeline config: %w", err)
	}
	if cfg.MaxParallel <= 0 {
		cfg.MaxParallel = 4
	}
	return &cfg, nil
}

func validatePipelineConfig(cfg *PipelineConfig) error {
	if cfg.Name == "" {
		return fmt.Errorf("pipeline name is required")
	}
	if len(cfg.Steps) == 0 {
		return fmt.Errorf("pipeline must have at least one step")
	}

	names := make(map[string]bool)
	for _, step := range cfg.Steps {
		if step.Name == "" {
			return fmt.Errorf("step name is required")
		}
		if names[step.Name] {
			return fmt.Errorf("duplicate step name: %s", step.Name)
		}
		names[step.Name] = true
		switch step.Type {
		case "shell", "train", "evaluate":
		default:
			return fmt.Errorf("step %s has invalid type: %s", step.Name, step.Type)
		}
		if step.Command == "" {
			return fmt.Errorf("step %s command is required", step.Name)
		}
		if step.Resources != nil && cfg.ResourceLimit != nil {
			if step.Resources.CPU > cfg.ResourceLimit.CPU {
				return fmt.Errorf("step %s cpu requirement %d exceeds pipeline limit %d", step.Name, step.Resources.CPU, cfg.ResourceLimit.CPU)
			}
			if step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {
				return fmt.Errorf("step %s memory requirement %d MB exceeds pipeline limit %d MB", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)
			}
		}
		if step.Type == "train" && step.ExperimentConfig == nil {
			return fmt.Errorf("train step %s requires experiment_config", step.Name)
		}
	}

	for _, step := range cfg.Steps {
		for _, dep := range step.DependsOn {
			if !names[dep] {
				return fmt.Errorf("step %s depends on unknown step %s", step.Name, dep)
			}
		}
	}

	if cycle := findCycle(cfg.Steps); cycle != nil {
		return fmt.Errorf("cycle detected: %s", strings.Join(cycle, " -> "))
	}

	producers := make(map[string]string)
	for _, step := range cfg.Steps {
		for _, out := range step.Outputs {
			if _, ok := producers[out]; ok {
				return fmt.Errorf("duplicate output artifact: %s", out)
			}
			producers[out] = step.Name
		}
	}

	for _, step := range cfg.Steps {
		for _, in := range step.Inputs {
			prod, ok := producers[in]
			if !ok {
				return fmt.Errorf("step %s input artifact %s is not produced by any step", step.Name, in)
			}
			if prod == step.Name {
				return fmt.Errorf("step %s input artifact %s must come from a dependency", step.Name, in)
			}
			if !isTransitiveDependency(cfg.Steps, step.Name, prod) {
				return fmt.Errorf("step %s input artifact %s producer %s is not a transitive dependency", step.Name, in, prod)
			}
		}
	}
	return nil
}

func findCycle(steps []*PipelineStep) []string {
	graph := make(map[string][]string)
	for _, s := range steps {
		graph[s.Name] = append(graph[s.Name], s.DependsOn...)
	}
	visited := make(map[string]int)
	var stack []string
	var dfs func(node string) []string
	dfs = func(node string) []string {
		visited[node] = 1
		stack = append(stack, node)
		for _, dep := range graph[node] {
			if visited[dep] == 1 {
				for i, n := range stack {
					if n == dep {
						return append(append([]string{}, stack[i:]...), dep)
					}
				}
				return []string{node, dep}
			}
			if visited[dep] == 0 {
				if c := dfs(dep); c != nil {
					return c
				}
			}
		}
		stack = stack[:len(stack)-1]
		visited[node] = 2
		return nil
	}
	for _, s := range steps {
		if visited[s.Name] == 0 {
			if c := dfs(s.Name); c != nil {
				return c
			}
[?2004hroot@n30009:/app# sed -n '260,560p' pipeline.go
[?2004l			}
		}
	}
	return nil
}

func isTransitiveDependency(steps []*PipelineStep, step, target string) bool {
	byName := make(map[string]*PipelineStep)
	for _, s := range steps {
		byName[s.Name] = s
	}
	var visit func(current string) bool
	visit = func(current string) bool {
		s := byName[current]
		for _, dep := range s.DependsOn {
			if dep == target {
				return true
			}
			if visit(dep) {
				return true
			}
		}
		return false
	}
	return visit(step)
}

func runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {
	if err := validatePipelineConfig(cfg); err != nil {
		return nil, err
	}
	merged := mergeParams(cfg.Parameters, params)
	if maxParallel <= 0 {
		maxParallel = cfg.MaxParallel
	}
	if maxParallel <= 0 {
		maxParallel = 4
	}

	runID := generateRunID()
	runDir := filepath.Join(pipelineRunsDir, runID)
	artifactsDir := filepath.Join(runDir, "artifacts")
	if err := os.MkdirAll(artifactsDir, 0755); err != nil {
		return nil, fmt.Errorf("create run dir: %w", err)
	}
	if cfgData, err := json.MarshalIndent(cfg, "", "  "); err == nil {
		os.WriteFile(filepath.Join(runDir, "pipeline_config.json"), cfgData, 0644)
	}

	now := time.Now()
	run := &PipelineRun{
		ID:         runID,
		Pipeline:   cfg.Name,
		Status:     "running",
		Parameters: merged,
		StartTime:  &now,
		RunDir:     runDir,
		Variables:  copyMap(merged),
		Steps:      make([]*StepRun, 0, len(cfg.Steps)),
	}
	for _, step := range cfg.Steps {
		run.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: "pending"})
	}
	saveRun(run)

	err := executeSteps(cfg, run, tracker, merged, maxParallel)
	endTime := time.Now()
	run.EndTime = &endTime
	if err != nil {
		run.Status = "failed"
	} else {
		run.Status = "succeeded"
	}
	saveRun(run)
	return run, err
}

func executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {
	stepByName := make(map[string]*PipelineStep)
	for _, s := range cfg.Steps {
		stepByName[s.Name] = s
	}
	runStepByName := make(map[string]*StepRun)
	for _, sr := range run.Steps {
		runStepByName[sr.Name] = sr
	}

	variables := make(map[string]string)
	if run.Variables != nil {
		for k, v := range run.Variables {
			variables[k] = v
		}
	} else {
		for k, v := range params {
			variables[k] = v
		}
	}
	var varMu sync.Mutex

	var mu sync.Mutex
	var running []*PipelineStep
	available := make(chan struct{}, maxParallel)

	pending := make(map[string]bool)
	for _, step := range cfg.Steps {
		sr := runStepByName[step.Name]
		if sr.Status == "succeeded" || sr.Status == "skipped" {
			continue
		}
		if sr.Status == "failed" {
			sr.Status = "pending"
			sr.Error = ""
			sr.Output = ""
			sr.StartTime = nil
			sr.EndTime = nil
		}
		pending[step.Name] = true
	}

	var wg sync.WaitGroup
	done := false

	canStart := func(step *PipelineStep) bool {
		for _, dep := range step.DependsOn {
			status := runStepByName[dep].Status
			if status != "succeeded" && status != "skipped" {
				return false
			}
		}
		if step.Resources != nil && cfg.ResourceLimit != nil {
			var cpu, mem int
			for _, r := range running {
				if r.Resources != nil {
					cpu += r.Resources.CPU
					mem += r.Resources.MemoryMB
				}
			}
			if cpu+step.Resources.CPU > cfg.ResourceLimit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {
				return false
			}
		}
		return true
	}

	startStep := func(step *PipelineStep) {
		pending[step.Name] = false
		running = append(running, step)
		wg.Add(1)
		go func(s *PipelineStep) {
			defer wg.Done()
			executeStep(cfg, run, tracker, s, variables, &varMu, runStepByName[s.Name])
			mu.Lock()
			running = removeStep(running, s)
			if runStepByName[s.Name].Status == "failed" {
				run.Status = "failed"
				done = true
			}
			varMu.Lock()
			run.Variables = copyMap(variables)
			varMu.Unlock()
			saveCheckpoint(run)
			saveRun(run)
			mu.Unlock()
			<-available
		}(step)
	}

	for !done && (len(pending) > 0 || len(running) > 0) {
		startedAny := false
		var starts []*PipelineStep
		mu.Lock()
		for _, step := range cfg.Steps {
			if pending[step.Name] && canStart(step) {
				starts = append(starts, step)
			}
		}
		mu.Unlock()
		sort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })
		for _, step := range starts {
			available <- struct{}{}
			mu.Lock()
			if done || !pending[step.Name] || !canStart(step) {
				mu.Unlock()
				<-available
				continue
			}
			startStep(step)
			mu.Unlock()
			startedAny = true
		}

		if !startedAny {
			if len(running) == 0 {
				break
			}
			time.Sleep(10 * time.Millisecond)
		}
	}
	wg.Wait()

	for _, sr := range run.Steps {
		if sr.Status == "pending" {
			sr.Status = "failed"
			sr.Error = "dependency failed"
		}
	}
	varMu.Lock()
	run.Variables = copyMap(variables)
	varMu.Unlock()
	saveCheckpoint(run)
	saveRun(run)

	if run.Status == "failed" {
		return fmt.Errorf("pipeline execution failed")
	}
	return nil
}
func removeStep(steps []*PipelineStep, target *PipelineStep) []*PipelineStep {
	out := make([]*PipelineStep, 0, len(steps))
	for _, s := range steps {
		if s != target {
			out = append(out, s)
		}
	}
	return out
}

func executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, variables map[string]string, varMu *sync.Mutex, sr *StepRun) {
	for _, dep := range step.DependsOn {
		depStatus := getRunStep(run, dep).Status
		if depStatus != "succeeded" && depStatus != "skipped" {
			sr.Status = "failed"
			sr.Error = "dependency failed"
			return
		}
	}

	varMu.Lock()
	vars := copyMap(variables)
	varMu.Unlock()

	if step.Condition != "" {
		cond, err := evaluateCondition(step.Condition, vars)
		if err != nil {
			sr.Status = "failed"
			sr.Error = err.Error()
			return
		}
		if !cond {
			sr.Status = "skipped"
			sr.Output = "condition false"
			return
		}
	}

	cmdStr, err := substituteVariables(step.Command, vars)
	if err != nil {
		sr.Status = "failed"
		sr.Error = err.Error()
		return
	}

	envVars := os.Environ()
	for k, v := range vars {
		envVars = append(envVars, "NEXUS_PARAM_"+k+"="+v)
	}
	for k, v := range step.Env {
		ev, err := substituteVariables(v, vars)
		if err != nil {
			sr.Status = "failed"
			sr.Error = fmt.Sprintf("env %s: %v", k, err)
			return
		}
		envVars = append(envVars, k+"="+ev)
	}

	maxRetries := 0
	backoffBase := 1
	if step.Retry != nil {
		maxRetries = step.Retry.MaxRetries
		if step.Retry.BackoffBaseSeconds > 0 {
			backoffBase = step.Retry.BackoffBaseSeconds
		}
	}

	var exp *Experiment
	if step.Type == "train" {
		var err error
		exp, err = createTrainExperiment(tracker, step, sr.ExperimentID)
		if err != nil {
			sr.Status = "failed"
			sr.Error = err.Error()
			return
		}
		sr.ExperimentID = exp.ID
	}

	for attempt := 0; attempt <= maxRetries; attempt++ {
		start := time.Now()
		sr.StartTime = &start
		sr.RetryCount = attempt
