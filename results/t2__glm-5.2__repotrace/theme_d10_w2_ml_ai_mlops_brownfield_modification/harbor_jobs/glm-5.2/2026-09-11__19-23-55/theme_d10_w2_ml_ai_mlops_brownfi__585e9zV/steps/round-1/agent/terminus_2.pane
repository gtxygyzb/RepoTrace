func substituteParams(command string, params map[string]string) string {
	res, _ := substituteVariables(command, params)
	return res
}

func evaluateCondition(cond string, vars map[string]string) (bool, error) {
	cond = strings.TrimSpace(cond)
	if cond == "" {
		return true, nil
	}
	if strings.Contains(cond, "==") {
		parts := strings.SplitN(cond, "==", 2)
		left, err := substituteVariables(strings.TrimSpace(parts[0]), vars)
		if err != nil {
			return false, err
		}
		right, err := substituteVariables(strings.TrimSpace(parts[1]), vars)
		if err != nil {
			return false, err
		}
		return left == right, nil
	}
	if strings.Contains(cond, "!=") {
		parts := strings.SplitN(cond, "!=", 2)
		left, err := substituteVariables(strings.TrimSpace(parts[0]), vars)
		if err != nil {
			return false, err
		}
		right, err := substituteVariables(strings.TrimSpace(parts[1]), vars)
		if err != nil {
			return false, err
		}
		return left != right, nil
	}
	return false, fmt.Errorf("invalid condition: %s", cond)
}

func resolveParam(token string, params map[string]string) string {
	res, _ := substituteVariables(token, params)
	return res
}

func generateRunID() string {
	return fmt.Sprintf("run-%d", time.Now().UnixNano())
}

func nowPtr() *time.Time {
	t := time.Now()
	return &t
}

func containsString(list []string, s string) bool {
	for _, x := range list {
		if x == s {
			return true
		}
	}
	return false
}

func saveRun(run *PipelineRun) {
	if err := os.MkdirAll(run.RunDir, 0755); err != nil {
		return
	}
	data, err := json.MarshalIndent(run, "", "  ")
	if err == nil {
		os.WriteFile(filepath.Join(run.RunDir, "run.json"), data, 0644)
	}
}

