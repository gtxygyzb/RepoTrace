   287	func runPipeline(cfg *PipelineConfig, tracker *Tracker, params map[string]string, maxParallel int) (*PipelineRun, error) {
   288		if err := validatePipelineConfig(cfg); err != nil {
   289			return nil, err
   290		}
   291		merged := mergeParams(cfg.Parameters, params)
   292		if maxParallel <= 0 {
   293			maxParallel = cfg.MaxParallel
   294		}
   295		if maxParallel <= 0 {
   296			maxParallel = 4
   297		}
   298	
   299		runID := generateRunID()
   300		runDir := filepath.Join(pipelineRunsDir, runID)
   301		artifactsDir := filepath.Join(runDir, "artifacts")
   302		if err := os.MkdirAll(artifactsDir, 0755); err != nil {
   303			return nil, fmt.Errorf("create run dir: %w", err)
   304		}
   305		if cfgData, err := json.MarshalIndent(cfg, "", "  "); err == nil {
   306			os.WriteFile(filepath.Join(runDir, "pipeline_config.json"), cfgData, 0644)
   307		}
   308	
   309		now := time.Now()
   310		run := &PipelineRun{
   311			ID:         runID,
   312			Pipeline:   cfg.Name,
   313			Status:     "running",
   314			Parameters: merged,
   315			StartTime:  &now,
   316			RunDir:     runDir,
   317			Variables:  copyMap(merged),
   318			Steps:      make([]*StepRun, 0, len(cfg.Steps)),
   319		}
   320		for _, step := range cfg.Steps {
   321			run.Steps = append(run.Steps, &StepRun{Name: step.Name, Type: step.Type, Status: "pending"})
   322		}
   323		saveRun(run)
   324	
   325		err := executeSteps(cfg, run, tracker, merged, maxParallel)
   326		endTime := time.Now()
   327		run.EndTime = &endTime
   328		if err != nil {
   329			run.Status = "failed"
   330		} else {
   331			run.Status = "succeeded"
   332		}
   333		saveRun(run)
   334		return run, err
   335	}
