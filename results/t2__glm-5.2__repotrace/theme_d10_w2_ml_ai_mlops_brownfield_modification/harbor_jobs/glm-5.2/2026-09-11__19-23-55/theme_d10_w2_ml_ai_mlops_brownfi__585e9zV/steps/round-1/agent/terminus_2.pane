  1110	func captureOutputValue(step *PipelineStep, stdout string) (string, bool, error) {
  1111		if step.CaptureOutput == nil {
  1112			return "", false, nil
  1113		}
  1114		if step.CaptureOutput.Regex == "" {
  1115			return strings.TrimSpace(stdout), true, nil
  1116		}
  1117		re, err := regexp.Compile(step.CaptureOutput.Regex)
  1118		if err != nil {
  1119			return "", false, fmt.Errorf("step %s capture_output regex: %w", step.Name, err)
  1120		}
  1121		m := re.FindStringSubmatch(stdout)
  1122		if m == nil || len(m) < 2 {
  1123			return "", false, nil
  1124		}
  1125		return m[1], true, nil
  1126	}
