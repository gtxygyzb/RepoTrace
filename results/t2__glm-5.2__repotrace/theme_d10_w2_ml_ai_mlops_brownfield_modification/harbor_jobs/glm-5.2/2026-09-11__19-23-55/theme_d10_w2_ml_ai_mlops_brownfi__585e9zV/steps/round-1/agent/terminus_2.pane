   163				return fmt.Errorf("step name is required")
   164			}
   165			if names[step.Name] {
   166				return fmt.Errorf("duplicate step name: %s", step.Name)
   167			}
   168			names[step.Name] = true
   169			switch step.Type {
   170			case "shell", "train", "evaluate":
   171			default:
   172				return fmt.Errorf("step %s has invalid type: %s", step.Name, step.Type)
   173			}
   174			if step.Command == "" {
   175				return fmt.Errorf("step %s command is required", step.Name)
   176			}
