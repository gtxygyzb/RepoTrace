   490			if depStatus != "succeeded" && depStatus != "skipped" {
   491				sr.Status = "failed"
   492				sr.Error = "dependency failed"
   493				return
   494			}
   495		}
   496	
   497		varMu.Lock()
   498		vars := copyMap(variables)
   499		varMu.Unlock()
   500	
   501		if step.Condition != "" {
   502			cond, err := evaluateCondition(step.Condition, vars)
   503			if err != nil {
   504				sr.Status = "failed"
   505				sr.Error = err.Error()
   506				return
   507			}
   508			if !cond {
   509				sr.Status = "skipped"
   510				sr.Output = "condition false"
   511				return
   512			}
   513		}
   514	
   515		cmdStr, err := substituteVariables(step.Command, vars)
   516		if err != nil {
   517			sr.Status = "failed"
   518			sr.Error = err.Error()
   519			return
   520		}
   521	
   522		envVars := os.Environ()
   523		for k, v := range vars {
   524			envVars = append(envVars, "NEXUS_PARAM_"+k+"="+v)
   525		}
   526		for k, v := range step.Env {
   527			ev, err := substituteVariables(v, vars)
   528			if err != nil {
   529				sr.Status = "failed"
   530				sr.Error = fmt.Sprintf("env %s: %v", k, err)
   531				return
   532			}
   533			envVars = append(envVars, k+"="+ev)
   534		}
   535	
   536		maxRetries := 0
   537		backoffBase := 1
   538		if step.Retry != nil {
   539			maxRetries = step.Retry.MaxRetries
   540			if step.Retry.BackoffBaseSeconds > 0 {
   541				backoffBase = step.Retry.BackoffBaseSeconds
   542			}
   543		}
   544	
   545		var exp *Experiment
   546		if step.Type == "train" {
   547			var err error
   548			exp, err = createTrainExperiment(tracker, step, sr.ExperimentID)
   549			if err != nil {
   550				sr.Status = "failed"
   551				sr.Error = err.Error()
   552				return
   553			}
   554			sr.ExperimentID = exp.ID
   555		}
   556	
   557		for attempt := 0; attempt <= maxRetries; attempt++ {
   558			start := time.Now()
   559			sr.StartTime = &start
   560			sr.RetryCount = attempt
   561			stdout, stderr, exitCode, err := runShellCommand(cmdStr, step.TimeoutSeconds, envVars)
   562			sr.Output = stdout
   563			if stderr != "" {
   564				if sr.Output != "" {
   565					sr.Output += "\n"
   566				}
   567				sr.Output += stderr
   568			}
   569			sr.ExitCode = exitCode
   570			if err == nil {
   571				sr.EndTime = nowPtr()
   572				sr.Status = "succeeded"
   573				sr.Error = ""
   574				produceArtifacts(run, step, sr, stdout)
   575				if step.Type == "train" && exp != nil {
   576					if terr := finishTrainExperiment(tracker, exp, step, stdout); terr != nil {
   577						sr.Status = "failed"
   578						sr.Error = terr.Error()
   579						return
   580					}
   581				}
   582				if step.Type == "evaluate" {
   583					registerEvaluateArtifacts(run, step, sr)
   584				}
   585				if step.CaptureOutput != nil {
   586					val, ok, cerr := captureOutputValue(step, stdout)
   587					if cerr != nil {
   588						sr.Status = "failed"
   589						sr.Error = cerr.Error()
   590						return
   591					}
   592					if ok {
   593						varMu.Lock()
   594						variables[step.CaptureOutput.Name] = val
   595						varMu.Unlock()
   596					}
   597				}
   598				return
   599			}
   600			sr.Error = err.Error()
   601			if step.Type == "train" && exp != nil {
   602				tracker.Complete(exp.ID, ExperimentStatusFailed)
   603			}
   604			if attempt < maxRetries {
   605				delay := time.Duration(math.Pow(float64(backoffBase), float64(attempt+1))) * time.Second
   606				time.Sleep(delay)
   607			}
   608		}
   609		sr.EndTime = nowPtr()
   610		sr.Status = "failed"
   611	}
   612	func getRunStep(run *PipelineRun, name string) *StepRun {
   613		for _, sr := range run.Steps {
   614			if sr.Name == name {
   615				return sr
   616			}
   617		}
   618		return nil
   619	}
