   337	func executeSteps(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, params map[string]string, maxParallel int) error {
   338		stepByName := make(map[string]*PipelineStep)
   339		for _, s := range cfg.Steps {
   340			stepByName[s.Name] = s
   341		}
