   154	func handleExperiment(tracker *Tracker, args []string) {
   155		if len(args) < 1 {
   156			fmt.Fprintln(os.Stderr, "experiment subcommand required")
   157			os.Exit(1)
   158		}
   159	
   160		switch args[0] {
   161		case "create":
   162			if len(args) < 2 {
   163				fmt.Fprintln(os.Stderr, "experiment name required")
   164				os.Exit(1)
   165			}
   166			name := args[1]
   167			paramsStr := getFlag(args, "--params", "")
   168			tagsStr := getFlag(args, "--tags", "")
   169	
   170			params := make(map[string]string)
   171			if paramsStr != "" {
   172				for _, p := range strings.Split(paramsStr, ",") {
   173					kv := strings.SplitN(p, "=", 2)
   174					if len(kv) == 2 {
   175						params[kv[0]] = kv[1]
   176					}
   177				}
   178			}
   179	
   180			var tags []string
   181			if tagsStr != "" {
   182				tags = strings.Split(tagsStr, ",")
   183			}
   184	
   185			exp, err := tracker.Create(name, params, tags)
   186			if err != nil {
   187				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   188				os.Exit(1)
   189			}
   190			printJSON(exp)
   191	
   192		case "list":
   193			filter := getFlag(args, "--filter", "")
   194			exps := tracker.store.ListExperiments(filter)
   195			printJSON(exps)
   196	
   197		case "get":
   198			if len(args) < 2 {
   199				fmt.Fprintln(os.Stderr, "experiment ID required")
   200				os.Exit(1)
   201			}
   202			exp, err := tracker.store.GetExperiment(args[1])
   203			if err != nil {
   204				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   205				os.Exit(1)
   206			}
   207			printJSON(exp)
   208	
   209		case "log-metric":
   210			if len(args) < 4 {
   211				fmt.Fprintln(os.Stderr, "experiment ID, metric key, and value required")
   212				os.Exit(1)
   213			}
   214			var value float64
   215			fmt.Sscanf(args[3], "%f", &value)
   216			if err := tracker.LogMetric(args[1], args[2], value); err != nil {
   217				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   218				os.Exit(1)
   219			}
   220			fmt.Println("Metric logged successfully")
   221	
   222		case "complete":
   223			if len(args) < 2 {
   224				fmt.Fprintln(os.Stderr, "experiment ID required")
   225				os.Exit(1)
   226			}
   227			status := ExperimentStatus(getFlag(args, "--status", "completed"))
   228			if err := tracker.Complete(args[1], status); err != nil {
   229				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   230				os.Exit(1)
   231			}
   232			fmt.Println("Experiment completed")
   233	
   234		case "compare":
   235			if len(args) < 2 {
   236				fmt.Fprintln(os.Stderr, "experiment IDs required (comma-separated)")
   237				os.Exit(1)
   238			}
   239			ids := strings.Split(args[1], ",")
   240			result, err := tracker.CompareExperiments(ids)
   241			if err != nil {
   242				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   243				os.Exit(1)
   244			}
   245			fmt.Println(result)
   246	
   247		case "export":
   248			if len(args) < 2 {
   249				fmt.Fprintln(os.Stderr, "output path required")
   250				os.Exit(1)
   251			}
   252			format := getFlag(args, "--format", "json")
   253			if err := tracker.Export(args[1], format); err != nil {
   254				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   255				os.Exit(1)
   256			}
   257			fmt.Printf("Exported to %s\n", args[1])
   258	
   259		default:
   260			fmt.Fprintf(os.Stderr, "Unknown experiment subcommand: %s\n", args[0])
   261			os.Exit(1)
   262		}
   263	}
   264	
   265	func handleDataset(store *Store, args []string) {
   266		if len(args) < 1 {
   267			fmt.Fprintln(os.Stderr, "dataset subcommand required")
   268			os.Exit(1)
   269		}
   270	
   271		switch args[0] {
   272		case "register":
   273			if len(args) < 5 {
   274				fmt.Fprintln(os.Stderr, "dataset name, version, format, and path required")
   275				os.Exit(1)
   276			}
   277			var rowCount int64
   278			rowsStr := getFlag(args, "--rows", "0")
   279			fmt.Sscanf(rowsStr, "%d", &rowCount)
   280	
   281			ds := &Dataset{
   282				Name:      args[1],
   283				Version:   args[2],
   284				Format:    args[3],
   285				Path:      args[4],
   286				RowCount:  rowCount,
   287				CreatedAt: time.Now(),
   288			}
   289	
   290			if err := store.SaveDataset(ds); err != nil {
   291				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   292				os.Exit(1)
   293			}
   294			printJSON(ds)
   295	
   296		case "list":
   297			datasets := store.ListDatasets()
   298			printJSON(datasets)
   299	
   300		case "get":
   301			if len(args) < 3 {
   302				fmt.Fprintln(os.Stderr, "dataset name and version required")
   303				os.Exit(1)
   304			}
   305			ds, err := store.GetDataset(args[1], args[2])
   306			if err != nil {
   307				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   308				os.Exit(1)
   309			}
   310			printJSON(ds)
   311	
   312		default:
   313			fmt.Fprintf(os.Stderr, "Unknown dataset subcommand: %s\n", args[0])
   314			os.Exit(1)
   315		}
   316	}
   317	
   318	func handleSearch(store *Store, args []string) {
   319		tag := getFlag(args, "--tag", "")
   320		if tag == "" {
   321			fmt.Fprintln(os.Stderr, "search requires --tag")
   322			os.Exit(1)
   323		}
   324	
   325		results := store.FindByTag(tag)
   326		printJSON(results)
   327	}
   328	
   329	func getFlag(args []string, flag, defaultVal string) string {
   330		for i, a := range args {
   331			if a == flag && i+1 < len(args) {
   332				return args[i+1]
   333			}
   334		}
   335		return defaultVal
   336	}
   337	
   338	func printJSON(v interface{}) {
   339		data, err := json.MarshalIndent(v, "", "  ")
   340		if err != nil {
   341			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
   342			os.Exit(1)
   343		}
   344		fmt.Println(string(data))
   345	}
