   872	func listRuns() []*PipelineRun {
   873		entries, err := os.ReadDir(pipelineRunsDir)
   874		if err != nil {
   875			return nil
   876		}
   877		var runs []*PipelineRun
   878		for _, entry := range entries {
   879			if !entry.IsDir() {
   880				continue
   881			}
   882			run, err := loadRun(entry.Name())
   883			if err != nil {
   884				continue
   885			}
   886			runs = append(runs, run)
   887		}
   888		sort.Slice(runs, func(i, j int) bool {
   889			if runs[i].StartTime == nil || runs[j].StartTime == nil {
   890				return runs[i].ID < runs[j].ID
   891			}
   892			return runs[i].StartTime.Before(*runs[j].StartTime)
   893		})
   894		return runs
   895	}
   896	
   897	func resumePipeline(runID string, tracker *Tracker) (*PipelineRun, error) {
   898		run, err := loadRun(runID)
   899		if err != nil {
   900			return nil, err
   901		}
   902		cpPath := filepath.Join(run.RunDir, "checkpoint.json")
   903		cpData, err := os.ReadFile(cpPath)
   904		if err == nil {
   905			var cp Checkpoint
   906			if json.Unmarshal(cpData, &cp) == nil {
   907				run.Status = cp.Status
   908				run.Parameters = cp.Parameters
   909				run.Steps = cp.Steps
   910				run.Artifacts = cp.Artifacts
   911			}
   912		}
   913	
   914		cfgPath := filepath.Join(run.RunDir, "pipeline_config.json")
   915		var cfg *PipelineConfig
   916		if cfgData, err := os.ReadFile(cfgPath); err == nil {
   917			var c PipelineConfig
   918			if json.Unmarshal(cfgData, &c) == nil {
   919				cfg = &c
   920			}
   921		}
   922		if cfg == nil {
   923			return nil, fmt.Errorf("pipeline config not found for run %s", runID)
   924		}
   925	
   926		completed := true
   927		for _, sr := range run.Steps {
   928			if sr.Status != "succeeded" && sr.Status != "skipped" {
   929				completed = false
   930				break
   931			}
   932		}
   933		if completed {
   934			run.Status = "succeeded"
   935			saveRun(run)
   936			return run, nil
   937		}
   938	
   939		run.Status = "running"
   940		saveRun(run)
   941	
   942		err = executeSteps(cfg, run, tracker, run.Parameters, cfg.MaxParallel)
   943		endTime := time.Now()
   944		run.EndTime = &endTime
   945		if err != nil {
   946			run.Status = "failed"
   947		} else {
   948			run.Status = "succeeded"
   949		}
   950		saveRun(run)
   951		return run, err
   952	}
