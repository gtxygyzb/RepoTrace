[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"strings"
	"time"
)

const dataDir = "/tmp/nexus"

func main() {
	if len(os.Args) < 2 {
		printUsage()
		os.Exit(1)
	}

	store, err := NewStore(dataDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error: %v\n", err)
		os.Exit(1)
	}

	registry := NewRegistry(store)
	tracker := NewTracker(store)

	switch os.Args[1] {
	case "model":
		handleModel(registry, os.Args[2:])
	case "experiment":
		handleExperiment(tracker, os.Args[2:])
	case "dataset":
		handleDataset(store, os.Args[2:])
	case "search":
		handleSearch(store, os.Args[2:])
	default:
		fmt.Fprintf(os.Stderr, "Unknown command: %s\n", os.Args[1])
		printUsage()
		os.Exit(1)
	}
}

func printUsage() {
	fmt.Println("nexus - ML Model & Experiment Management")
	fmt.Println()
	fmt.Println("Commands:")
	fmt.Println("  model register <name> [--version V] [--framework F] [--description D] [--tags t1,t2]")
	fmt.Println("  model list [--filter F]")
	fmt.Println("  model get <name> <version>")
	fmt.Println("  model promote <name> <version> <status>")
	fmt.Println("  model delete <name> <version>")
	fmt.Println("  model compare <name>")
	fmt.Println("  experiment create <name> [--params k1=v1,k2=v2] [--tags t1,t2]")
	fmt.Println("  experiment list [--filter F]")
	fmt.Println("  experiment get <id>")
	fmt.Println("  experiment log-metric <id> <key> <value>")
	fmt.Println("  experiment complete <id> [--status completed|failed]")
	fmt.Println("  experiment compare <id1,id2,...>")
	fmt.Println("  experiment export <output-path> [--format json|csv]")
	fmt.Println("  dataset register <name> <version> <format> <path> [--rows N]")
	fmt.Println("  dataset list")
	fmt.Println("  dataset get <name> <version>")
	fmt.Println("  search --tag <tag>")
}

func handleModel(reg *Registry, args []string) {
	if len(args) < 1 {
		fmt.Fprintln(os.Stderr, "model subcommand required")
		os.Exit(1)
	}

	switch args[0] {
	case "register":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "model name required")
			os.Exit(1)
		}
		name := args[1]
		version := getFlag(args, "--version", "")
		framework := getFlag(args, "--framework", "unknown")
		description := getFlag(args, "--description", "")
		tagsStr := getFlag(args, "--tags", "")
		var tags []string
		if tagsStr != "" {
			tags = strings.Split(tagsStr, ",")
		}

		m, err := reg.Register(name, version, framework, description, tags)
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		printJSON(m)

	case "list":
		filter := getFlag(args, "--filter", "")
		models := reg.store.ListModels(filter)
		printJSON(models)

	case "get":
		if len(args) < 3 {
			fmt.Fprintln(os.Stderr, "model name and version required")
			os.Exit(1)
		}
		m, err := reg.store.GetModel(args[1], args[2])
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		printJSON(m)

	case "promote":
		if len(args) < 4 {
			fmt.Fprintln(os.Stderr, "model name, version, and target status required")
			os.Exit(1)
		}
		err := reg.Promote(args[1], args[2], ModelStatus(args[3]))
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		fmt.Println("Model promoted successfully")

	case "delete":
		if len(args) < 3 {
			fmt.Fprintln(os.Stderr, "model name and version required")
			os.Exit(1)
		}
		if err := reg.store.DeleteModel(args[1], args[2]); err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		fmt.Println("Model deleted successfully")

	case "compare":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "model name required")
			os.Exit(1)
		}
		models, err := reg.Compare(args[1])
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		printJSON(models)

	default:
		fmt.Fprintf(os.Stderr, "Unknown model subcommand: %s\n", args[0])
		os.Exit(1)
	}
}

func handleExperiment(tracker *Tracker, args []string) {
	if len(args) < 1 {
		fmt.Fprintln(os.Stderr, "experiment subcommand required")
		os.Exit(1)
	}

	switch args[0] {
	case "create":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "experiment name required")
			os.Exit(1)
		}
		name := args[1]
		paramsStr := getFlag(args, "--params", "")
		tagsStr := getFlag(args, "--tags", "")

		params := make(map[string]string)
		if paramsStr != "" {
			for _, p := range strings.Split(paramsStr, ",") {
				kv := strings.SplitN(p, "=", 2)
				if len(kv) == 2 {
					params[kv[0]] = kv[1]
				}
			}
		}

		var tags []string
		if tagsStr != "" {
			tags = strings.Split(tagsStr, ",")
		}

		exp, err := tracker.Create(name, params, tags)
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		printJSON(exp)

	case "list":
		filter := getFlag(args, "--filter", "")
		exps := tracker.store.ListExperiments(filter)
		printJSON(exps)

	case "get":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "experiment ID required")
			os.Exit(1)
		}
		exp, err := tracker.store.GetExperiment(args[1])
		if err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		printJSON(exp)

	case "log-metric":
		if len(args) < 4 {
			fmt.Fprintln(os.Stderr, "experiment ID, metric key, and value required")
			os.Exit(1)
		}
		var value float64
		fmt.Sscanf(args[3], "%f", &value)
		if err := tracker.LogMetric(args[1], args[2], value); err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		fmt.Println("Metric logged successfully")

	case "complete":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "experiment ID required")
			os.Exit(1)
		}
		status := ExperimentStatus(getFlag(args, "--status", "completed"))
		if err := tracker.Complete(args[1], status); err != nil {
			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
			os.Exit(1)
		}
		fmt.Println("Experiment completed")

	case "compare":
		if len(args) < 2 {
			fmt.Fprintln(os.Stderr, "experiment IDs required (comma-separated)")
			os.Exit(1)
		}
		ids := strings.Split(args[1], ",")
		result, err := tracker.CompareExperiments(ids)
