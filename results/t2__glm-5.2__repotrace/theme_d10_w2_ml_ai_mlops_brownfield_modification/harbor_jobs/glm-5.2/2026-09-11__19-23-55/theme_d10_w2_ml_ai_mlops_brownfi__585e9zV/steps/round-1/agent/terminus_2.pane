type PipelineHistoryEntry struct {
	ID              string     `json:"id"`
	Status          string     `json:"status"`
	StartTime       *time.Time `json:"start_time,omitempty"`
	EndTime         *time.Time `json:"end_time,omitempty"`
	DurationSeconds float64    `json:"duration_seconds"`
}

func pipelineHistory(name, status string) []PipelineHistoryEntry {
	runs := listRuns()
	out := make([]PipelineHistoryEntry, 0)
	for _, run := range runs {
		if run.Pipeline != name {
			continue
		}
		if status != "" && run.Status != status {
			continue
		}
		duration := 0.0
		if run.StartTime != nil && run.EndTime != nil {
			duration = run.EndTime.Sub(*run.StartTime).Seconds()
		}
		out = append(out, PipelineHistoryEntry{
			ID:              run.ID,
			Status:          run.Status,
			StartTime:       run.StartTime,
			EndTime:         run.EndTime,
			DurationSeconds: duration,
		})
	}
	sort.Slice(out, func(i, j int) bool {
		if out[i].StartTime == nil || out[j].StartTime == nil {
			return out[i].ID > out[j].ID
		}
		return out[i].StartTime.After(*out[j].StartTime)
	})
	return out
}

func buildArtifactManifest(run *PipelineRun, cfg *PipelineConfig) map[string]interface{} {
	manifest := map[string]interface{}{
		"artifacts": run.Artifacts,
	}
	lineage := make(map[string][]string)
	if cfg != nil {
		for _, step := range cfg.Steps {
			for _, in := range step.Inputs {
				lineage[in] = append(lineage[in], step.Name)
			}
		}
	}
	manifest["lineage"] = lineage
	return manifest
}
