func deleteRun(runID string) error {
	run, err := loadRun(runID)
	if err != nil {
		return fmt.Errorf("run not found: %s", runID)
	}
	if err := os.RemoveAll(run.RunDir); err != nil {
		return fmt.Errorf("delete run: %w", err)
	}
	return nil
}

