'\'\'func runShellCommand(command string, timeoutSeconds int, env []string) (string, int, error) {\n\\tcmd := exec.Command("sh", "-c", command)\n\\tif env != nil {\n\\t\\tcmd.Env = env\n\\t}\n\\tvar out strings.Builder\n\\tcmd.Stdout = &out\n\\tcmd.Stderr = &out\n\'\'\'\nassert old in s\ns = s.replace(old, new, 1)\n\n# Replace substitution/condition/resolveParam block\nold = \'\'\'func substituteParams(command string, params map[string]string) string {\n\\tresult := command\n\\tfor k, v := range params {\n\\t\\tresult = strings.ReplaceAll(result, "${"+k+"}", v)\n\\t}\n\\treturn result\n}\n\nfunc evaluateCondition(cond string, params map[string]string) (bool, error) {\n\\tcond = strings.TrimSpace(cond)\n\\tif cond == "" {\n\\t\\treturn true, nil\n\\t}\n\\tif strings.Contains(cond, "==") {\n\\t\\tparts := strings.SplitN(cond, "==", 2)\n\\t\\tleft := resolveParam(strings.TrimSpace(parts[0]), params)\n\\t\\tright := resolveParam(strings.TrimSpace(parts[1]), params)\n\\t\\treturn left == right, nil\n\\t}\n\\tif strings.Contains(cond, "!=") {\n\\t\\tparts := strings.SplitN(cond, "!=", 2)\n\\t\\tleft := resolveParam(strings.TrimSpace(parts[0]), params)\n\\t\\tright := resolveParam(strings.TrimSpace(parts[1]), params)\n\\t\\treturn left != right, nil\n\\t}\n\\treturn false, fmt.Errorf("invalid condition: %s", cond)\n}\n\nfunc resolveParam(token string, params map[string]string) string {\n\\tre := regexp.MustCompile(`^\\\\$\\\\{(.+)\\\\}$`)\n\\tm := re.FindStringSubmatch(token)\n\\tif m != nil {\n\\t\\treturn params[m[1]]\n\\t}\n\\treturn token\n}\n\'\'\'\nnew = \'\'\'func substituteParams(command string, params map[string]string) string {\n\\tres, _ := substituteVariables(command, params)\n\\treturn res\n}\n\nvar variableTokenRe = regexp.MustCompile(`\\\\$\\\\{([^}]*)\\\\}`)\n\nfunc substituteVariables(command string, vars map[string]string) (string, error) {\n\\tvar firstErr error\n\\tresult := variableTokenRe.ReplaceAllStringFunc(command, func(token string) string {\n\\t\