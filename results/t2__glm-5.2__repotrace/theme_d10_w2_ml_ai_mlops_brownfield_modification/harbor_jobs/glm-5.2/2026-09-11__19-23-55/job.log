\t\treturn nil, fmt.Errorf("parse pipeline config: %w", err)\n\t}\n\tif cfg.MaxParallel <= 0 {\n\t\tcfg.MaxParallel = 4\n\t}\n\treturn &cfg, nil\n}\n\nfunc validatePipelineConfig(cfg *PipelineConfig) error {\n\tif cfg.Name == "" {\n\t\treturn fmt.Errorf("pipeline name is required")\n\t}\n\tif len(cfg.Steps) == 0 {\n\t\treturn fmt.Errorf("pipeline must have at least one step")\n\t}\n\n\tnames := make(map[string]bool)\n\tfor _, step := range cfg.Steps {\n\t\tif step.Name == "" {\n\t\t\treturn fmt.Errorf("step name is required")\n\t\t}\n\t\tif names[step.Name] {\n\t\t\treturn fmt.Errorf("duplicate step name: %s", step.Name)\n\t\t}\n\t\tnames[step.Name] = true\n\t\tswitch step.Type {\n\t\tcase "shell", "train", "evaluate":\n\t\tdefault:\n\t\t\treturn fmt.Errorf("step %s has invalid type: %s", step.Name, step.Type)\n\t\t}\n\t\tif step.Command == "" {\n\t\t\treturn fmt.Errorf("step %s command is required", step.Name)\n\t\t}\n\t\tif step.Resources != nil && cfg.ResourceLimit != nil {\n\t\t\tif step.Resources.CPU > cfg.ResourceLimit.CPU {\n\t\t\t\treturn fmt.Errorf("step %s cpu requirement %d exceeds pipeline limit %d", step.Name, step.Resources.CPU, cfg.ResourceLimit.CPU)\n\t\t\t}\n\t\t\tif step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\n\t\t\t\treturn fmt.Errorf("step %s memory requirement %d MB exceeds pipeline limit %d MB", step.Name, step.Resources.MemoryMB, cfg.ResourceLimit.MemoryMB)\n\t\t\t}\n\t\t}\n\t\tif step.Type == "train" && step.ExperimentConfig == nil {\n\t\t\treturn fmt.Errorf("train step %s requires experiment_config", step.Name)\n\t\t}\n\t}\n\n\tfor _, step := range cfg.Steps {\n\t\tfor _, dep := range step.DependsOn {\n\t\t\tif !names[dep] {\n\t\t\t\treturn fmt.Errorf("step %s depends on unknown step %s", step.Name, dep)\n\t\t\t}\n\t\t}\n\t}\n\n\tif cycle := findCycle(cfg.Steps); cycle != nil {\n\t\treturn fmt.Errorf("cycle detected: %s", strings.Join(cycle, " -> "))\n\t}\n\n\tproducers := make(map[string]string)\n\tfor _, step := range cfg.Steps 