nsDir, args[1], "pipeline_config.json")); err == nil {\n\t\t\tvar c PipelineConfig\n\t\t\tif json.Unmarshal(cfgData, &c) == nil {\n\t\t\t\tcfg = &c\n\t\t\t}\n\t\t}\n\t\tprintJSON(buildArtifactManifest(run, cfg))\n\n\tcase "resume":\n\t\tif len(args) < 2 {\n\t\t\tfmt.Fprintln(os.Stderr, "run-id required")\n\t\t\tos.Exit(1)\n\t\t}\n\t\trun, err := resumePipeline(args[1], tracker)\n\t\tif run != nil {\n\t\t\tprintJSON(run)\n\t\t}\n\t\tif err != nil {\n\t\t\tos.Exit(1)\n\t\t}\n\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, "Unknown pipeline subcommand: %s\\n", args[0])\n\t\tos.Exit(1)\n\t}\n}\n\nfunc parsePipelineParams(args []string) map[string]string {\n\tparams := make(map[string]string)\n\tfor _, a := range args {\n\t\tif strings.HasPrefix(a, "--param") && len(a) > len("--param") {\n\t\t\trest := a[len("--param"):]\n\t\t\tif strings.HasPrefix(rest, "=") {\n\t\t\t\trest = rest[1:]\n\t\t\t}\n\t\t\tif rest == "" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tparts := strings.SplitN(rest, "=", 2)\n\t\t\tif len(parts) == 2 {\n\t\t\t\tparams[parts[0]] = parts[1]\n\t\t\t}\n\t\t}\n\t}\n\treturn params\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
