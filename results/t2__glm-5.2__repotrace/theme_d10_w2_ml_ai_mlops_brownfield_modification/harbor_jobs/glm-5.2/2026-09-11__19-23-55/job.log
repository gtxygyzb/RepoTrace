imit.CPU || mem+step.Resources.MemoryMB > cfg.ResourceLimit.MemoryMB {\n\\t\\t\\t\\treturn false\n\\t\\t\\t}\n\\t\\t}\n\\t\\treturn true\n\\t}\n\n\\tstartStep := func(step *PipelineStep) {\n\\t\\tpending[step.Name] = false\n\\t\\trunning = append(running, step)\n\\t\\twg.Add(1)\n\\t\\tgo func(s *PipelineStep) {\n\\t\\t\\tdefer wg.Done()\n\\t\\t\\texecuteStep(cfg, run, tracker, s, params, runStepByName[s.Name])\n\\t\\t\\tmu.Lock()\n\\t\\t\\trunning = removeStep(running, s)\n\\t\\t\\tif runStepByName[s.Name].Status == "failed" {\n\\t\\t\\t\\trun.Status = "failed"\n\\t\\t\\t\\tdone = true\n\\t\\t\\t}\n\\t\\t\\tsaveCheckpoint(run)\n\\t\\t\\tsaveRun(run)\n\\t\\t\\tmu.Unlock()\n\\t\\t\\t<-available\n\\t\\t}(step)\n\\t}\n\n\\tfor !done && (len(pending) > 0 || len(running) > 0) {\n\\t\\tstartedAny := false\n\\t\\tvar starts []*PipelineStep\n\\t\\tmu.Lock()\n\\t\\tfor _, step := range cfg.Steps {\n\\t\\t\\tif pending[step.Name] && canStart(step) {\n\\t\\t\\t\\tstarts = append(starts, step)\n\\t\\t\\t}\n\\t\\t}\n\\t\\tmu.Unlock()\n\\t\\tsort.Slice(starts, func(i, j int) bool { return starts[i].Name < starts[j].Name })\n\\t\\tfor _, step := range starts {\n\\t\\t\\tavailable <- struct{}{}\n\\t\\t\\tmu.Lock()\n\\t\\t\\tif done || !pending[step.Name] || !canStart(step) {\n\\t\\t\\t\\tmu.Unlock()\n\\t\\t\\t\\t<-available\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}\n\\t\\t\\tstartStep(step)\n\\t\\t\\tmu.Unlock()\n\\t\\t\\tstartedAny = true\n\\t\\t}\n\n\\t\\tif !startedAny {\n\\t\\t\\tif len(running) == 0 {\n\\t\\t\\t\\tbreak\n\\t\\t\\t}\n\\t\\t\\ttime.Sleep(10 * time.Millisecond)\n\\t\\t}\n\\t}\n\\twg.Wait()\n\n\\tfor _, sr := range run.Steps {\n\\t\\tif sr.Status == "pending" {\n\\t\\t\\tsr.Status = "failed"\n\\t\\t\\tsr.Error = "dependency failed"\n\\t\\t}\n\\t}\n\\tsaveCheckpoint(run)\n\\tsaveRun(run)\n\n\\tif run.Status == "failed" {\n\\t\\treturn fmt.Errorf("pipeline execution failed")\n\\t}\n\\treturn nil\n}\'\'\'\n\nnew_execute_step=\'\'\'func executeStep(cfg *PipelineConfig, run *PipelineRun, tracker *Tracker, step *PipelineStep, params map[string]string, sr *StepRun) {\n\\tfor _, dep := range step.DependsOn {\n\\t\\tdepStatus := getRunStep(run, dep).Status\n\\t\\tif depStatus != "succeeded" && depStatus != "skipped" {\n\\t\\t\\tsr.Status = "failed"\n\\t\\t\\tsr.Error = "dependency failed"\n\\t\\t\\treturn\n\\t\\t}\n\\t}\n\n\\tif step.Condition != "" {\n\\t\\tcond, err := evaluateCondition(step.Condition, params)\n\\t\\tif err != nil {\n\\t\\t\\tsr.Status = "failed"\n\\t\\t\\tsr.Error = err.Error()\n\\t\\t\\treturn\n\\t\\t}\n\\t\\tif !cond {\n\\t\\t\\tsr.Status = "skipped"\n\\t\\t\\tsr.Output = "condition false"\n\\t\\t\\treturn\n\\t\\t}\n\\t}\n\n\\tmaxRetries := 0\n\\tbackoffBase := 1\n\\tif step.Retry != nil {\n\\t\\tmaxRetries = step.Retry.MaxRetries\n\\t\\tif step.Retry.BackoffBaseSeconds > 0 {\n\\t\\t\\tbackoffBase = step.Retry.BackoffBaseSeconds\n\\t\\t}\n\\t}\n\n\\tcmdStr := substituteParams(step.Command, params)\n\n\\tvar exp *Experiment\n\\tif step.Type == "train" {\n\\t\\tvar err error\n\\t\\texp, err = createTrainExperiment(tracker, step, sr.ExperimentID)\n\\t\\tif err != nil {\n\\t\\t\\tsr.Status = "failed"\n\\t\\t\\tsr.Error = err.Error()\n\\t\\t\\treturn\n\\t\\t}\n\\t\\tsr.ExperimentID = exp.ID\n\\t}\n\n\\tfor attempt := 0; attempt <= maxRetries; attempt++ {\n\\t\\tstart := time.Now()\n\\t\\tsr.StartTime = &start\n\\t\\tsr.RetryCount = attempt\n\\t\\tout, exitCode, err := runShellCommand(cmdStr, step.TimeoutSeconds)\n\\t\\tsr.Output = out\n\\t\\tsr.ExitCode = exitCode\n\\t\\tif err == nil {\n\\t\\t\\tsr.EndTime = nowPtr()\n\\t\\t\\tsr.Status = "succeeded"\n\\t\\t\\tsr.Error = ""\n\\t\\t\\tproduceArtifacts(run, step, sr, out)\n\\t\\t\\tif step.Type == "train" && exp != nil {\n\\t\\t\\t\\tif terr := finishTrainExperiment(tracker, exp, step, out); terr != nil {\n\\t\\t\\t\\t\\tsr.Status = "failed"\n\\t\\t\\t\\t\\tsr.Error = terr.Error()\n\\t\\t\\t\\treturn\n\\t\\t\\t\\t}\n\\t\\t\\t}\n\\t\\t\\tif step.Type == "evaluate" {\n\\t\\t\\t\\tregisterEvaluateArtifacts(run, step, sr)\n\\t\\t\\t}\n\\t\\t\\treturn\n\\t\\t}\n\\t\\tsr.Error = err.Error()\n\\t\\tif step.Type == "train" && exp != nil {\n\\t\\t\\ttracker.Complete(exp.ID, ExperimentStatusFailed)\n\\t\\t}\n\\t\\tif attempt < maxRetries {\n\\t\\t\\tdelay := time.Duration(math.Pow(float64(backoffBase), float64(attempt+1))) * time.Second\n\\t\\t\\ttime.Sleep(delay)\n\\t\\t}\n\\t}\n\\tsr.EndTime = nowPtr()\n\\tsr.Status = "failed"\n}\'\'\'\n\nnew_handle_train=\'\'\'func createTrainExperiment(tracker *Tracker, step *PipelineStep, existingID string) (*Experiment, error) {\n\\texpName := step.Name\n\\tvar params map[string]string\n\\tvar tags []string\n\\tif step.ExperimentConfig != nil {\n\\t\\tif step.ExperimentConfig.Name != "" {\n\\t\\t\\texpName = step.ExperimentConfig.Name\n\\t\\t}\n\\t\\tparams = step.ExperimentConfig.Params\n\\t}\n\\tif existingID != "" {\n\\t\\tif exp, err := tracker.store.GetExperiment(existingID); err == nil {\n\\t\\t\\treturn exp, nil\n\\t\\t}\n\\t}\n\\treturn tracker.Create(expName, params, tags)\n}\n\nfunc finishTrainExperiment(tracker *Tracker, exp *Experiment, step *PipelineStep, output string) error {\n\\tfor _, line := range strings.Split(output, "\\n") {\n\\t\\tkey, value, ok := parseMetricLine(line)\n\\t\\tif !ok {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif len(step.ExperimentConfig.Metrics) > 0 && !containsString(step.ExperimentConfig.Metrics, key) {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif err := tracker.LogMetric(exp.ID, key, value); err != nil {\n\\t\\t\\treturn err\n\\t\\t}\n\\t}\n\\treturn tracker.Complete(exp.ID, ExperimentStatusCompleted)\n}\'\'\'\n\n# Replace executeSteps and executeStep\ns=replace_func(s,\'executeSteps\',new_execute_steps)\ns=replace_func(s,\'executeStep\',new_execute_step)\n# Replace old handleTrainExperiment with new helpers\nstart=s.find(\'func handleTrainExperiment(\')\nif start==-1:\n    raise SystemExit(\'handleTrainExperiment not found\')\nend=s.find(\'\\nfunc parseMetricLine(\', start)\nif