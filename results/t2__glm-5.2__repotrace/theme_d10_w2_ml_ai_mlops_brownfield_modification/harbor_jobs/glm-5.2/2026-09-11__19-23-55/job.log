il && (sr.Status == "succeeded" || sr.Status == "skipped") {\n\\t\\t\\tvariables["steps."+step.Name+".status"] = sr.Status\n\\t\\t}\n\\t}\n\n\\tvar mu sync.Mutex\'\'\'\n)\n\n# Update canStart to allow failed allow_failure dependencies.\ns = s.replace(\n\'\'\'\\t\\tfor _, dep := range step.DependsOn {\n\\t\\t\\tstatus := runStepByName[dep].Status\n\\t\\t\\tif status != "succeeded" && status != "skipped" {\n\\t\\t\\t\\treturn false\n\\t\\t\\t}\n\\t\\t}\'\'\',\n\'\'\'\\t\\tfor _, dep := range step.DependsOn {\n\\t\\t\\tstatus := runStepByName[dep].Status\n\\t\\t\\tif status == "succeeded" || status == "skipped" {\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}\n\\t\\t\\tif status == "failed" {\n\\t\\t\\t\\tif depStep := stepByName[dep]; depStep != nil && depStep.AllowFailure {\n\\t\\t\\t\\t\\tcontinue\n\\t\\t\\t\\t}\n\\t\\t\\t}\n\\t\\t\\treturn false\n\\t\\t}\'\'\'\n)\n\n# Update startStep failure handling and step status variable population.\ns = s.replace(\n\'\'\'\\t\\t\\tif runStepByName[s.Name].Status == "failed" {\n\\t\\t\\t\\trun.Status = "failed"\n\\t\\t\\t\\tdone = true\n\\t\\t\\t}\n\\t\\t\\tvarMu.Lock()\n\\t\\t\\trun.Variables = copyMap(variables)\n\\t\\t\\tvarMu.Unlock()\'\'\',\n\'\'\'\\t\\t\\tstatus := runStepByName[s.Name].Status\n\\t\\t\\tif status == "failed" {\n\\t\\t\\t\\tif s.AllowFailure {\n\\t\\t\\t\\t\\tif !containsString(run.Warnings, s.Name) {\n\\t\\t\\t\\t\\t\\trun.Warnings = append(run.Warnings, s.Name)\n\\t\\t\\t\\t\\t}\n\\t\\t\\t\\t} else {\n\\t\\t\\t\\t\\trun.Status = "failed"\n\\t\\t\\t\\t\\tdone = true\n\\t\\t\\t\\t}\n\\t\\t\\t}\n\\t\\t\\tvarMu.Lock()\n\\t\\t\\tvariables["steps."+s.Name+".status"] = status\n\\t\\t\\trun.Variables = copyMap(variables)\n\\t\\t\\tvarMu.Unlock()\'\'\'\n)\n\n# Update executeStep dependency check.\ns = s.replace(\n\'\'\'\\tfor _, dep := range step.DependsOn {\n\\t\\tdepStatus := getRunStep(run, dep).Status\n\\t\\tif depStatus != "succeeded" && depStatus != "skipped" {\n\\t\\t\\tsr.Status = "failed"\n\\t\\t\\tsr.Error = "dependency failed"\n\\t\\t\\treturn\n\\t\\t}\n\\t}\'\'\',\n\'\'\'\\tfor _, dep := range step.DependsOn {\n\\t\\tdepStatus := getRunStep(run, dep).Status\n\\t\\tif depStatus == "succeeded" || depStatus == "skipped" {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif depStatus == "failed" {\n\\t\\t\\tdepStep := getStepConfig(cfg, dep)\n\\t\\t\\tif depStep != nil && depStep.AllowFailure {\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}\n\\t\\t}\n\\t\\tsr.Status = "failed"\n\\t\\tsr.Error = "dependency failed"\n\\t\\treturn\n\\t}\'\'\'\n)\n\n# Compute final run status and warnings after step execution.\ns = s.replace(\n\'\'\'\\tfor _, sr := range run.Steps {\n\\t\\tif sr.Status == "pending" {\n\\t\\t\\tsr.Status = "failed"\n\\t\\t\\tsr.Error = "dependency failed"\n\\t\\t}\n\\t}\n\\tvarMu.Lock()\n\\trun.Variables = copyMap(variables)\n\\tvarMu.Unlock()\n\\tsaveCheckpoint(run)\n\\tsaveRun(run)\n\n\\tif run.Status == "failed" {\n\\t\\treturn fmt.Errorf("pipeline execution failed")\n\\t}\n\\treturn nil\n}\'\'\',\n\'\'\'\\tfor _, sr := range run.Steps {\n\\t\\tif sr.Status == "pending" {\n\\t\\t\\tsr.Status = "failed"\n\\t\\t\\tsr.Error = "dependency failed"\n\\t\\t}\n\\t}\n\\tcomputeRunStatus(cfg, run)\n\\tvarMu.Lock()\n\\trun.Variables = copyMap(variables)\n\\tvarMu.Unlock()\n\\tsaveCheckpoint(run)\n\\tsaveRun(run)\n\n\\tif run.Status == "failed" {\n\\t\\treturn fmt.Errorf("pipeline execution failed")\n\\t}\n\\treturn nil\n}\'\'\'\n)\n\n# Add computeRunStatus helper before copyMap.\ns = s.replace(\n\'\'\'func copyMap(in map[string]string) map[string]string {\'\'\',\n\'\'\'func computeRunStatus(cfg *PipelineConfig, run *PipelineRun) {\n\\twarnings := []string{}\n\\thardFailed := false\n\\tfor _, step := range cfg.Steps {\n\\t\\tsr := getRunStep(run, step.Name)\n\\t\\tif sr == nil {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif sr.Status == "failed" {\n\\t\\t\\tif step.AllowFailure {\n\\t\\t\\t\\twarnings = append(warnings, step.Name)\n\\t\\t\\t} else {\n\\t\\t\\t\\thardFailed = true\n\\t\\t\\t}\n\\t\\t}\n\\t}\n\\