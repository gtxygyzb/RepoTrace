 472:     double *b = NULL;
 473:     if (convdiff_assemble(nx, ny, x0, x1, y0, y1, kappa, vx, vy,
 474:                           source, left, right, bottom, top, &A, &b) != 0) {
 475:         fprintf(stderr, "Error: cannot assemble convdiff system\n");
 476:         return 1;
 477:     }
