   323	static int cmd_heat(int argc, char **argv)
   324	{
   325	    const char *nx_s = get_opt(argc, argv, "--nx");
   326	    const char *ny_s = get_opt(argc, argv, "--ny");
   327	    const char *x0_s = get_opt(argc, argv, "--x0");
   328	    const char *x1_s = get_opt(argc, argv, "--x1");
   329	    const char *y0_s = get_opt(argc, argv, "--y0");
   330	    const char *y1_s = get_opt(argc, argv, "--y1");
   331	    const char *alpha_s = get_opt(argc, argv, "--alpha");
   332	    const char *dt_s = get_opt(argc, argv, "--dt");
   333	    const char *nsteps_s = get_opt(argc, argv, "--nsteps");
   334	    const char *scheme = get_opt(argc, argv, "--scheme");
   335	    const char *ic_file = get_opt(argc, argv, "--ic");
   336	    const char *source_arg = get_opt(argc, argv, "--source");
   337	    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
   338	    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
   339	    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
   340	    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
   341	    const char *solver = get_opt(argc, argv, "--solver");
   342	    const char *precond = get_opt(argc, argv, "--precond");
   343	    const char *tol_s = get_opt(argc, argv, "--tol");
   344	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   345	    const char *restart_s = get_opt(argc, argv, "--restart");
   346	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   347	    const char *output = get_opt(argc, argv, "--output");
   348	
   349	    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !alpha_s ||
   350	        !dt_s || !nsteps_s || !scheme || !ic_file || !source_arg ||
   351	        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
   352	        !solver || !precond || !tol_s || !maxiter_s || !output) {
   353	        fprintf(stderr, "Error: heat requires grid, domain, alpha, dt, nsteps, scheme, ic, source, boundary conditions, solver, precond, tol, maxiter, output\n");
   354	        usage("numsim");
   355	        return 1;
   356	    }
   357	
   358	    int nx = atoi(nx_s);
   359	    int ny = atoi(ny_s);
   360	    double x0 = atof(x0_s);
   361	    double x1 = atof(x1_s);
   362	    double y0 = atof(y0_s);
   363	    double y1 = atof(y1_s);
   364	    double alpha = atof(alpha_s);
   365	    double dt = atof(dt_s);
   366	    int nsteps = atoi(nsteps_s);
   367	    double tol = atof(tol_s);
   368	    int maxiter = atoi(maxiter_s);
   369	    int restart = restart_s ? atoi(restart_s) : 30;
   370	    double omega = omega_s ? atof(omega_s) : 1.0;
   371	
   372	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || alpha <= 0.0 ||
   373	        dt <= 0.0 || nsteps < 0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {
   374	        fprintf(stderr, "Error: invalid heat parameters\n");
   375	        return 1;
   376	    }
   377	    if (validate_ssor_omega(omega) != 0) {
   378	        return 1;
   379	    }
   380	
   381	    PoissonBC left, right, bottom, top;
   382	    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
   383	        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
   384	        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
   385	        return 1;
   386	    }
   387	
   388	    int rc = heat_solve(nx, ny, x0, x1, y0, y1, alpha, dt, nsteps, scheme,
   389	                       ic_file, source_arg, left, right, bottom, top,
   390	                       solver, precond, tol, maxiter, restart, omega, output);
   391	    if (rc != 0) {
   392	        fprintf(stderr, "Error: heat solve failed\n");
   393	        return 1;
   394	    }
   395	    return 0;
   396	}
