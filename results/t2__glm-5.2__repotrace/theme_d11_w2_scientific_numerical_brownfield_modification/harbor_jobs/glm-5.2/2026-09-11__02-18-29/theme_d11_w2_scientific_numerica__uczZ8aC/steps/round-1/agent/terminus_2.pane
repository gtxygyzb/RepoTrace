   100	COOMatrix *csr_to_coo(const CSRMatrix *A)
   101	{
   102	    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);
   103	    if (!out) return NULL;
   104	    int k = 0;
   105	    for (int i = 0; i < A->rows; i++) {
   106	        for (int j = A->row_ptr[i]; j < A->row_ptr[i+1]; j++) {
   107	            out->row[k] = i;
   108	            out->col[k] = A->col_indices[j];
   109	            out->values[k] = A->values[j];
   110	            k++;
   111	        }
   112	    }
   113	    out->nnz = k;
   114	    return out;
   115	}
