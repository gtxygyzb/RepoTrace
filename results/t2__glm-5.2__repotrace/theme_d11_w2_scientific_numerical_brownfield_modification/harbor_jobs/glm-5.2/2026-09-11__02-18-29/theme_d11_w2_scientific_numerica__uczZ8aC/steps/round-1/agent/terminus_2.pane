[?2004l[?2004h> static int parse_bc(const char *s, PoissonBC *bc)
[?2004l[?2004h> {
[?2004l[?2004h>     const char *colon = strchr(s, ':');
[?2004l[?2004h>     if (!colon || colon == s) return -1;
[?2004l[?2004h> 
[?2004l[?2004h>     size_t len = colon - s;
[?2004l[?2004h>     char type[32];
[?2004l[?2004h>     if (len >= sizeof(type)) return -1;
[?2004l[?2004h>     memcpy(type, s, len);
[?2004l[?2004h>     type[len] = '\0';
[?2004l[?2004h> 
[?2004l[?2004h>     if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
[?2004l[?2004h>     else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
[?2004l[?2004h>     else return -1;
[?2004l[?2004h> 
[?2004l[?2004h>     bc->file = colon + 1;
[?2004l[?2004h>     return 0;
[?2004l[?2004h> }
