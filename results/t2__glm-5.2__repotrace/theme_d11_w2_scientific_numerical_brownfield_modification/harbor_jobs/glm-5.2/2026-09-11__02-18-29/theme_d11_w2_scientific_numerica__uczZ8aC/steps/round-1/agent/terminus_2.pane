#include "precond.h"$
#include "solvers.h"$
#include "poisson.h"$
$
static void usage(const char *prog)$
{$
    fprintf(stderr, "Usage:\n");$
    fprintf(stderr, "  %s dense-solve <matrix_file> <rhs_file> [output_file]\n", prog);$
    fprintf(stderr, "  %s sparse-solve --input <mtx_file> --rhs <rhs_file> \\$
", prog);$
    fprintf(stderr, "        --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> \\$
");$
    fprintf(stderr, "        --tol <value> --maxiter <value> \\$
");$
    fprintf(stderr, "        [--restart <m>] [--ssor-omega <value>] \\$
");$
    fprintf(stderr, "        [--output <file>] [--history <file>]\n");$
    fprintf(stderr, "  %s poisson --nx <int> --ny <int> \\$
", prog);$
    fprintf(stderr, "        --x0 <float> --x1 <float> --y0 <float> --y1 <float> \\$
");$
    fprintf(stderr, "        --source <file> \\$
");$
    fprintf(stderr, "        --bc-left <dirichlet|neumann>:<file> \\$
");$
    fprintf(stderr, "        --bc-right <dirichlet|neumann>:<file> \\$
");$
    fprintf(stderr, "        --bc-bottom <dirichlet|neumann>:<file> \\$
");$
    fprintf(stderr, "        --bc-top <dirichlet|neumann>:<file> \\$
");$
    fprintf(stderr, "        --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> \\$
");$
    fprintf(stderr, "        --tol <value> --maxiter <value> \\$
");$
    fprintf(stderr, "        [--restart <m>] [--ssor-omega <value>] \\$
");$
    fprintf(stderr, "        [--output <file>] [--history <file>]\n");$
}$
$
static const char *get_opt(int argc, char **argv, const char *name)$
{$
    for (int i = 0; i < argc - 1; i++) {$
        if (strcmp(argv[i], name) == 0) return argv[i+1];$
    }$
    return NULL;$
}$
$
static int write_history_file(const SolveResult *res, const char *filename)$
{$
    FILE *fp = fopen(filename, "w");$
    if (!fp) return -1;$
    for (int i = 0; i < res->history_len; i++) {$
        fprintf(fp, "%.15e\n", res->history[i]);$
    }$
    fclose(fp);$
    return 0;$
}$
$
static void print_solve_summary(const SolveResult *res)$
{$
    printf("converged: %s\n", res->converged ? "yes" : "no");$
    printf("iterations: %d\n", res->iterations);$
    printf("residual: %.6e\n", res->relres);$
}$
$
static int cmd_dense_solve(int argc, char **argv)$
{$
    if (argc < 2) {$
        fprintf(stderr, "Error: dense-solve requires <matrix_file> <rhs_file>\n");$
        return 1;$
    }$
$
