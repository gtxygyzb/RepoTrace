    80	        return 1;
    81	    }
    82	
    83	    if (A->rows != n || A->cols != n) {
    84	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
    85	                A->rows, A->cols, n);
    86	        free(b);
    87	        dm_destroy(A);
    88	        return 1;
    89	    }
    90	
    91	    double *x = vec_create(n);
    92	    if (!x) {
    93	        fprintf(stderr, "Error: allocation failed\n");
    94	        free(b);
    95	        dm_destroy(A);
    96	        return 1;
    97	    }
    98	
    99	    int rc = dm_solve(A, b, x);
   100	    if (rc != 0) {
   101	        fprintf(stderr, "Error: solver failed (singular or ill-conditioned)\n");
   102	        free(x);
   103	        free(b);
   104	        dm_destroy(A);
   105	        return 1;
   106	    }
   107	
   108	    if (out_file) {
   109	        vec_write_text(x, n, out_file);
   110	        printf("Solution written to %s\n", out_file);
   111	    } else {
   112	        printf("Solution:\n");
   113	        vec_print(x, n, stdout);
   114	    }
   115	
   116	    double *r = vec_create(n);
   117	    dm_matvec(A, x, r);
   118	    vec_axpy(-1.0, b, r, n);
   119	    printf("Residual norm: %.6e\n", vec_norm2(r, n));
   120	
   121	    free(r);
   122	    free(x);
   123	    free(b);
   124	    dm_destroy(A);
   125	    return 0;
   126	}
