    32	static int write_history_file(const SolveResult *res, const char *filename)
    33	{
    34	    FILE *fp = fopen(filename, "w");
    35	    if (!fp) return -1;
    36	    for (int i = 0; i < res->history_len; i++) {
    37	        fprintf(fp, "%d\t%.15e\n", i, res->history[i]);
    38	    }
    39	    fclose(fp);
    40	    return 0;
    41	}
    42	
    43	static void print_solve_summary(const SolveResult *res)
    44	{
    45	    printf("converged: %s\n", res->converged ? "yes" : "no");
    46	    printf("iterations: %d\n", res->iterations);
    47	    printf("residual: %.6e\n", res->relres);
    48	    printf("true_residual: %.6e\n", res->true_residual);
    49	}
    50	
    51	static int validate_ssor_omega(double omega)
    52	{
    53	    if (!(omega > 0.0 && omega < 2.0)) {
    54	        fprintf(stderr, "error: ssor-omega must be in (0,2)\n");
    55	        return 1;
    56	    }
    57	    return 0;
    58	}
