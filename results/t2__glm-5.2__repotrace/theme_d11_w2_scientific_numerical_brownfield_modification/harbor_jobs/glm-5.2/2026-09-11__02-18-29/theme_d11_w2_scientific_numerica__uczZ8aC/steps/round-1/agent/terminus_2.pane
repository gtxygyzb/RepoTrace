   257	static int cmd_poisson(int argc, char **argv)
   258	{
   259	    const char *nx_s = get_opt(argc, argv, "--nx");
   260	    const char *ny_s = get_opt(argc, argv, "--ny");
   261	    const char *x0_s = get_opt(argc, argv, "--x0");
   262	    const char *x1_s = get_opt(argc, argv, "--x1");
   263	    const char *y0_s = get_opt(argc, argv, "--y0");
   264	    const char *y1_s = get_opt(argc, argv, "--y1");
   265	    const char *source = get_opt(argc, argv, "--source");
   266	    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
   267	    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
   268	    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
   269	    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
   270	    const char *solver = get_opt(argc, argv, "--solver");
   271	    const char *precond = get_opt(argc, argv, "--precond");
   272	    const char *tol_s = get_opt(argc, argv, "--tol");
   273	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   274	    const char *restart_s = get_opt(argc, argv, "--restart");
   275	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   276	    const char *output = get_opt(argc, argv, "--output");
   277	    const char *history = get_opt(argc, argv, "--history");
   278	
   279	    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||
   280	        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
   281	        !solver || !precond || !tol_s || !maxiter_s) {
   282	        fprintf(stderr, "Error: poisson requires grid, source, boundary condition, solver, precond, tol, maxiter\n");
   283	        usage("numsim");
   284	        return 1;
   285	    }
   286	
   287	    int nx = atoi(nx_s);
   288	    int ny = atoi(ny_s);
   289	    double x0 = atof(x0_s);
   290	    double x1 = atof(x1_s);
   291	    double y0 = atof(y0_s);
   292	    double y1 = atof(y1_s);
   293	    double tol = atof(tol_s);
   294	    int maxiter = atoi(maxiter_s);
   295	    int restart = restart_s ? atoi(restart_s) : 30;
   296	    double omega = omega_s ? atof(omega_s) : 1.0;
   297	
   298	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {
   299	        fprintf(stderr, "Error: invalid poisson parameters\n");
   300	        return 1;
   301	    }
   302	    if (validate_ssor_omega(omega) != 0) {
   303	        return 1;
   304	    }
   305	
   306	    PoissonBC left, right, bottom, top;
   307	    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
   308	        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
   309	        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
   310	        return 1;
   311	    }
   312	
   313	    CSRMatrix *A = NULL;
   314	    double *b = NULL;
