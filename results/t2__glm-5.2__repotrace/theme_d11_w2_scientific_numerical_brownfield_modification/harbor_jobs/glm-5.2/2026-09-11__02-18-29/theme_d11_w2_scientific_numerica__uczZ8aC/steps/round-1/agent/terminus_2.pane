      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  285 | 
      |      
  286 |     if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  287 |         !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
