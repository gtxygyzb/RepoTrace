   194	static int cmd_sparse_solve(int argc, char **argv)
   195	{
   196	    const char *input = get_opt(argc, argv, "--input");
   197	    const char *rhs_file = get_opt(argc, argv, "--rhs");
   198	    const char *solver = get_opt(argc, argv, "--solver");
   199	    const char *precond = get_opt(argc, argv, "--precond");
   200	    const char *tol_s = get_opt(argc, argv, "--tol");
   201	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   202	    const char *restart_s = get_opt(argc, argv, "--restart");
   203	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   204	    const char *output = get_opt(argc, argv, "--output");
   205	    const char *history = get_opt(argc, argv, "--history");
   206	
   207	    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {
   208	        fprintf(stderr, "Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\n");
   209	        usage("numsim");
   210	        return 1;
   211	    }
   212	
   213	    double tol = atof(tol_s);
   214	    int maxiter = atoi(maxiter_s);
   215	    int restart = restart_s ? atoi(restart_s) : 30;
   216	    double omega = omega_s ? atof(omega_s) : 1.0;
   217	
   218	    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {
   219	        fprintf(stderr, "Error: invalid solver parameters\n");
   220	        return 1;
   221	    }
   222	    if (validate_ssor_omega(omega) != 0) {
   223	        return 1;
   224	    }
   225	
   226	    CSRMatrix *A = csr_read_mm(input);
   227	    if (!A) {
   228	        fprintf(stderr, "Error: cannot read sparse matrix from '%s'\n", input);
   229	        return 1;
   230	    }
   231	
   232	    int n;
   233	    double *b = vec_read_mm_array(rhs_file, &n);
   234	    if (!b) {
   235	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
   236	        csr_destroy(A);
   237	        return 1;
   238	    }
   239	
   240	    if (A->rows != n || A->cols != n) {
   241	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
   242	                A->rows, A->cols, n);
   243	        free(b);
   244	        csr_destroy(A);
   245	        return 1;
   246	    }
   247	
   248	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   249	
   250	    free(b);
   251	    csr_destroy(A);
   252	    return rc;
   253	}
