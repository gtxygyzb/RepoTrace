   487	int main(int argc, char **argv)
   488	{
   489	    if (argc < 2) {
   490	        usage(argv[0]);
   491	        return 1;
   492	    }
   493	
   494	    const char *cmd = argv[1];
   495	
   496	    if (strcmp(cmd, "dense-solve") == 0) {
   497	        return cmd_dense_solve(argc - 2, argv + 2);
   498	    } else if (strcmp(cmd, "sparse-solve") == 0) {
   499	        return cmd_sparse_solve(argc - 2, argv + 2);
   500	    } else if (strcmp(cmd, "poisson") == 0) {
   501	        return cmd_poisson(argc - 2, argv + 2);
   502	    } else if (strcmp(cmd, "heat") == 0) {
   503	        return cmd_heat(argc - 2, argv + 2);
   504	    } else if (strcmp(cmd, "convdiff") == 0) {
   505	        return cmd_convdiff(argc - 2, argv + 2);
   506	    } else if (strcmp(cmd, "--help") == 0 || strcmp(cmd, "-h") == 0) {
   507	        usage(argv[0]);
   508	        return 0;
   509	    } else if (strcmp(cmd, "eigenvalue") == 0) {
   510	        return cmd_eigenvalue(argc - 2, argv + 2);
   511	    } else {
   512	        fprintf(stderr, "Error: unknown command '%s'\n", cmd);
   513	        usage(argv[0]);
   514	        return 1;
   515	    }
   516	}
