    39	static void print_solve_summary(const SolveResult *res)
    40	{
    41	    printf("converged: %s\n", res->converged ? "yes" : "no");
    42	    printf("iterations: %d\n", res->iterations);
    43	    printf("residual: %.6e\n", res->relres);
    44	}
    45	
    46	static int cmd_dense_solve(int argc, char **argv)
    47	{
    48	    if (argc < 2) {
    49	        fprintf(stderr, "Error: dense-solve requires <matrix_file> <rhs_file>\n");
    50	        return 1;
    51	    }
    52	
    53	    const char *mat_file = argv[0];
    54	    const char *rhs_file = argv[1];
    55	    const char *out_file = (argc >= 3) ? argv[2] : NULL;
    56	
    57	    DenseMatrix *A = dm_read_text(mat_file);
    58	    if (!A) {
    59	        fprintf(stderr, "Error: cannot read matrix from '%s'\n", mat_file);
    60	        return 1;
    61	    }
    62	
    63	    int n;
    64	    double *b = vec_read_text(rhs_file, &n);
    65	    if (!b) {
    66	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
    67	        dm_destroy(A);
    68	        return 1;
    69	    }
    70	
    71	    if (A->rows != n || A->cols != n) {
    72	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
    73	                A->rows, A->cols, n);
    74	        free(b);
    75	        dm_destroy(A);
    76	        return 1;
    77	    }
    78	
    79	    double *x = vec_create(n);
    80	    if (!x) {
    81	        fprintf(stderr, "Error: allocation failed\n");
    82	        free(b);
    83	        dm_destroy(A);
    84	        return 1;
    85	    }
    86	
    87	    int rc = dm_solve(A, b, x);
    88	    if (rc != 0) {
    89	        fprintf(stderr, "Error: solver failed (singular or ill-conditioned)\n");
    90	        free(x);
    91	        free(b);
    92	        dm_destroy(A);
    93	        return 1;
    94	    }
    95	
    96	    if (out_file) {
    97	        vec_write_text(x, n, out_file);
    98	        printf("Solution written to %s\n", out_file);
    99	    } else {
   100	        printf("Solution:\n");
   101	        vec_print(x, n, stdout);
   102	    }
   103	
   104	    double *r = vec_create(n);
   105	    dm_matvec(A, x, r);
   106	    vec_axpy(-1.0, b, r, n);
   107	    printf("Residual norm: %.6e\n", vec_norm2(r, n));
   108	
   109	    free(r);
   110	    free(x);
   111	    free(b);
   112	    dm_destroy(A);
   113	    return 0;
   114	}
   115	
   116	static int parse_bc(const char *s, PoissonBC *bc)
   117	{
   118	    const char *colon = strchr(s, ':');
   119	    if (!colon || colon == s) return -1;
   120	
   121	    size_t len = colon - s;
   122	    char type[32];
   123	    if (len >= sizeof(type)) return -1;
   124	    memcpy(type, s, len);
   125	    type[len] = '\0';
   126	
   127	    if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
   128	    else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
   129	    else return -1;
   130	
   131	    bc->file = colon + 1;
   132	    return 0;
   133	}
   134	
   135	static int run_solver_and_print(const CSRMatrix *A, const double *b,
   136	                                const char *solver, const char *precond,
   137	                                double tol, int maxiter, int restart,
   138	                                double omega, const char *output,
   139	                                const char *history)
   140	{
   141	    Precond *P = precond_create(A, precond, omega);
   142	    if (!P) {
   143	        fprintf(stderr, "Error: cannot create preconditioner '%s'\n", precond);
   144	        return 1;
   145	    }
   146	
   147	    SolveResult *res = NULL;
   148	    if (strcmp(solver, "cg") == 0) {
   149	        res = cg_solve(A, b, NULL, tol, maxiter, P);
   150	    } else if (strcmp(solver, "gmres") == 0) {
   151	        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);
   152	    } else {
   153	        fprintf(stderr, "Error: unknown solver '%s'\n", solver);
   154	        precond_destroy(P);
   155	        return 1;
   156	    }
   157	
   158	    if (!res) {
   159	        fprintf(stderr, "Error: solver allocation failed\n");
   160	        precond_destroy(P);
   161	        return 1;
   162	    }
   163	
   164	    print_solve_summary(res);
   165	
   166	    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {
   167	        fprintf(stderr, "Error: cannot write output to '%s'\n", output);
   168	    }
   169	    if (history && write_history_file(res, history) != 0) {
   170	        fprintf(stderr, "Error: cannot write history to '%s'\n", history);
   171	    }
   172	
   173	    solve_result_destroy(res);
   174	    precond_destroy(P);
   175	    return 0;
   176	}
