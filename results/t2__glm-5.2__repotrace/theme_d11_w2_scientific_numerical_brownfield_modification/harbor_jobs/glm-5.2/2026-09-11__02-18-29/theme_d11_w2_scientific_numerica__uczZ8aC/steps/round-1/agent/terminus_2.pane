     6	
     7	static SolveResult *result_create(int n, int maxiter)
     8	{
     9	    if (maxiter < 0) maxiter = 0;
    10	    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));
    11	    if (!res) return NULL;
    12	
    13	    res->x = vec_create(n);
    14	    res->history = (double *)malloc((maxiter + 1) * sizeof(double));
    15	    if (!res->x || !res->history) {
    16	        free(res->x);
    17	        free(res->history);
    18	        free(res);
    19	        return NULL;
    20	    }
    21	    res->history_len = 0;
    22	    return res;
    23	}
    24	
    25	SolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,
    26	                      double tol, int maxiter, Precond *P)
    27	{
    28	    if (!A || !b || A->rows != A->cols) return NULL;
    29	    int n = A->rows;
    30	    if (maxiter < 0) maxiter = 0;
    31	
    32	    SolveResult *res = result_create(n, maxiter);
    33	    if (!res) return NULL;
    34	
    35	    double *r = vec_create(n);
    36	    double *z = vec_create(n);
    37	    double *p = vec_create(n);
    38	    double *Ap = vec_create(n);
    39	    if (!r || !z || !p || !Ap) {
    40	        free(r); free(z); free(p); free(Ap);
    41	        solve_result_destroy(res);
    42	        return NULL;
    43	    }
    44	
    45	    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);
    46	
    47	    csr_spmv(A, res->x, Ap);
    48	    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
    49	
    50	    double bnorm = vec_norm2(b, n);
    51	    if (bnorm == 0.0) bnorm = 1.0;
    52	
    53	    res->true_residual = vec_norm2(r, n);
    54	    res->relres = res->true_residual / bnorm;
    55	    res->history[0] = res->relres;
    56	    res->history_len = 1;
    57	    res->converged = (res->relres < tol) ? 1 : 0;
    58	    res->iterations = 0;
    59	    if (res->converged || maxiter == 0) {
    60	        free(r); free(z); free(p); free(Ap);
    61	        return res;
    62	    }
    63	
    64	    if (precond_apply(P, A, r, z) != 0) {
    65	        free(r); free(z); free(p); free(Ap);
    66	        return res;
    67	    }
    68	    vec_copy(z, p, n);
    69	    double rz_old = vec_dot(r, z, n);
    70	
    71	    for (int iter = 1; iter <= maxiter; iter++) {
    72	        csr_spmv(A, p, Ap);
    73	        double pAp = vec_dot(p, Ap, n);
    74	        if (fabs(pAp) < 1e-30) break;
    75	
    76	        double alpha = rz_old / pAp;
    77	        vec_axpy(alpha, p, res->x, n);
    78	        vec_axpy(-alpha, Ap, r, n);
    79	
    80	        /* Recompute the true residual rather than relying on the recurrence. */
    81	        csr_spmv(A, res->x, Ap);
    82	        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
    83	
    84	        res->true_residual = vec_norm2(r, n);
    85	        res->relres = res->true_residual / bnorm;
    86	        res->history[iter] = res->relres;
    87	        res->history_len = iter + 1;
    88	        res->iterations = iter;
    89	
    90	        if (res->relres < tol) {
    91	            res->converged = 1;
    92	            break;
    93	        }
    94	
    95	        if (precond_apply(P, A, r, z) != 0) break;
    96	        double rz_new = vec_dot(r, z, n);
    97	        if (fabs(rz_old) < 1e-30) break;
    98	        double beta = rz_new / rz_old;
    99	        vec_scale(beta, p, n);
   100	        vec_axpy(1.0, z, p, n);
   101	        rz_old = rz_new;
   102	    }
   103	
   104	    free(r); free(z); free(p); free(Ap);
   105	    return res;
   106	}
   107	
   108	static void apply_givens(double *a, double *b, double c, double s)
   109	{
   110	    double t = c * (*a) + s * (*b);
   111	    *b = -s * (*a) + c * (*b);
   112	    *a = t;
   113	}
   114	
   115	static int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)
   116	{
   117	    if (kdim <= 0) return -1;
   118	
   119	    double *c = (double *)malloc(m * sizeof(double));
   120	    double *s = (double *)malloc(m * sizeof(double));
   121	    if (!c || !s) { free(c); free(s); return -1; }
   122	
   123	    for (int i = 0; i < kdim; i++) {
   124	        for (int k = 0; k < i; k++) {
   125	            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);
   126	        }
   127	
   128	        double a = H[i*m+i];
   129	        double b = H[(i+1)*m+i];
   130	        if (b == 0.0) {
   131	            c[i] = 1.0;
   132	            s[i] = 0.0;
   133	        } else {
   134	            double r = hypot(a, b);
   135	            c[i] = a / r;
   136	            s[i] = b / r;
   137	        }
   138	        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);
   139	        apply_givens(&g[i], &g[i+1], c[i], s[i]);
   140	
   141	    }
   142	
   143	    for (int i = kdim - 1; i >= 0; i--) {
   144	        double sum = g[i];
   145	        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];
   146	        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }
   147	        y[i] = sum / H[i*m+i];
   148	    }
   149	
   150	    free(c);
   151	    free(s);
   152	    return 0;
   153	}
   154	
   155	SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,
   156	                           double tol, int maxiter, int m, Precond *P)
   157	{
   158	    if (!A || !b || A->rows != A->cols) return NULL;
   159	    int n = A->rows;
   160	    if (m <= 0) m = 30;
   161	    if (maxiter < 0) maxiter = 0;
   162	
   163	    SolveResult *res = result_create(n, maxiter);
   164	    if (!res) return NULL;
   165	
   166	    double *r = vec_create(n);
   167	    double *z = vec_create(n);
   168	    double *Ap = vec_create(n);
   169	    double *Av = vec_create(n);
   170	    double *w = vec_create(n);
   171	    double *g = (double *)malloc((m + 1) * sizeof(double));
   172	    double *y = (double *)malloc(m * sizeof(double));
   173	    double *H = (double *)calloc((m + 1) * m, sizeof(double));
   174	    double *V = (double *)malloc(n * (m + 1) * sizeof(double));
   175	
   176	    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {
   177	        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   178	        solve_result_destroy(res);
   179	        return NULL;
   180	    }
   181	
   182	    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);
   183	
   184	    csr_spmv(A, res->x, Ap);
   185	    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
   186	
   187	    double bnorm = vec_norm2(b, n);
   188	    if (bnorm == 0.0) bnorm = 1.0;
   189	
   190	    res->true_residual = vec_norm2(r, n);
   191	    res->relres = res->true_residual / bnorm;
   192	    res->history[0] = res->relres;
   193	    res->history_len = 1;
   194	    res->converged = (res->relres < tol) ? 1 : 0;
   195	    res->iterations = 0;
   196	    if (res->converged || maxiter == 0) {
   197	        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   198	        return res;
   199	    }
   200	
   201	    for (int cycle = 1; cycle <= maxiter; cycle++) {
   202	        if (precond_apply(P, A, r, z) != 0) break;
   203	        double beta = vec_norm2(z, n);
   204	        if (beta == 0.0) break;
   205	
   206	        for (int i = 0; i < n; i++) V[i] = z[i] / beta;
   207	        for (int i = 0; i <= m; i++) g[i] = 0.0;
   208	        g[0] = beta;
   209	        memset(H, 0, (m + 1) * m * sizeof(double));
   210	
   211	        int kdim = 0;
   212	        int fail = 0;
   213	        for (int j = 0; j < m; j++) {
   214	            csr_spmv(A, V + j * n, Av);
   215	            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }
   216	
   217	            for (int i = 0; i <= j; i++) {
   218	                double h = vec_dot(w, V + i * n, n);
   219	                H[i*m+j] = h;
   220	                vec_axpy(-h, V + i * n, w, n);
   221	            }
   222	
   223	            double hnorm = vec_norm2(w, n);
   224	            H[(j+1)*m+j] = hnorm;
   225	            kdim = j + 1;
   226	
   227	            if (hnorm < 1e-14) break;
   228	
   229	            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;
   230	        }
   231	        if (fail) break;
   232	        if (kdim == 0) break;
   233	
   234	        for (int i = 0; i < kdim; i++) y[i] = 0.0;
   235	        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;
   236	
   237	        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);
   238	
   239	        csr_spmv(A, res->x, Ap);
   240	        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
   241	
   242	        res->true_residual = vec_norm2(r, n);
   243	        res->relres = res->true_residual / bnorm;
   244	        res->history[cycle] = res->relres;
   245	        res->history_len = cycle + 1;
   246	        res->iterations = cycle;
   247	
   248	        if (res->relres < tol) {
   249	            res->converged = 1;
   250	            break;
   251	        }
   252	    }
   253	
   254	    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   255	    return res;
   256	}
   257	
   258	void solve_result_destroy(SolveResult *res)
   259	{
   260	    if (!res) return;
   261	    free(res->x);
   262	    free(res->history);
   263	    free(res);
   264	}
