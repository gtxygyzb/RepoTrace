[?2004hroot@n30009:/app# nl -ba src/poisson.c | sed -n '1,260p'
[?2004l     1	#include "poisson.h"
     2	#include "vector.h"
     3	#include <stdlib.h>
     4	#include <string.h>
     5	#include <math.h>
     6	
     7	double *poisson_read_source(const char *filename, int nx, int ny)
     8	{
     9	    FILE *fp = fopen(filename, "r");
    10	    if (!fp) return NULL;
    11	
    12	    int rx, ry;
    13	    if (fscanf(fp, "%d %d", &rx, &ry) != 2 || rx != nx || ry != ny) {
    14	        fclose(fp);
    15	        return NULL;
    16	    }
    17	
    18	    int n = nx * ny;
    19	    double *f = vec_create(n);
    20	    if (!f) { fclose(fp); return NULL; }
    21	
    22	    for (int i = 0; i < n; i++) {
    23	        if (fscanf(fp, "%lf", &f[i]) != 1) {
    24	            free(f);
    25	            fclose(fp);
    26	            return NULL;
    27	        }
    28	    }
    29	
    30	    fclose(fp);
    31	    return f;
    32	}
    33	
    34	double *poisson_read_boundary(const char *filename, int expected)
    35	{
    36	    FILE *fp = fopen(filename, "r");
    37	    if (!fp) return NULL;
    38	
    39	    double *vals = (double *)malloc(expected * sizeof(double));
    40	    if (!vals) { fclose(fp); return NULL; }
    41	
    42	    int count = 0;
    43	    while (count < expected) {
    44	        double v;
    45	        if (fscanf(fp, "%lf", &v) != 1) break;
    46	        vals[count++] = v;
    47	    }
    48	
    49	    fclose(fp);
    50	    if (count != expected) { free(vals); return NULL; }
    51	    return vals;
    52	}
    53	
    54	static void add_coo(COOMatrix *coo, int *k, int r, int c, double v)
    55	{
    56	    coo->row[*k] = r;
    57	    coo->col[*k] = c;
    58	    coo->values[*k] = v;
    59	    (*k)++;
    60	}
    61	
    62	int poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,
    63	                    const char *source_file, PoissonBC left, PoissonBC right,
    64	                    PoissonBC bottom, PoissonBC top,
    65	                    CSRMatrix **A_out, double **b_out)
    66	{
    67	    if (!A_out || !b_out) return -1;
    68	    *A_out = NULL;
    69	    *b_out = NULL;
    70	
    71	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || !source_file) return -1;
    72	
    73	    double hx = (x1 - x0) / (nx - 1);
    74	    double hy = (y1 - y0) / (ny - 1);
    75	    double hx2 = hx * hx;
    76	    double hy2 = hy * hy;
    77	
    78	    double *f = poisson_read_source(source_file, nx, ny);
    79	    if (!f) return -1;
    80	
    81	    double *left_vals = NULL;
    82	    double *right_vals = NULL;
    83	    double *bottom_vals = NULL;
    84	    double *top_vals = NULL;
    85	
    86	    if (left.type == POISSON_NEUMANN) { left_vals = poisson_read_boundary(left.file, ny); if (!left_vals) goto fail; }
    87	    if (right.type == POISSON_NEUMANN) { right_vals = poisson_read_boundary(right.file, ny); if (!right_vals) goto fail; }
    88	    if (bottom.type == POISSON_NEUMANN) { bottom_vals = poisson_read_boundary(bottom.file, nx); if (!bottom_vals) goto fail; }
    89	    if (top.type == POISSON_NEUMANN) { top_vals = poisson_read_boundary(top.file, nx); if (!top_vals) goto fail; }
    90	
    91	    if (left.type == POISSON_DIRICHLET) { left_vals = poisson_read_boundary(left.file, ny); if (!left_vals) goto fail; }
    92	    if (right.type == POISSON_DIRICHLET) { right_vals = poisson_read_boundary(right.file, ny); if (!right_vals) goto fail; }
    93	    if (bottom.type == POISSON_DIRICHLET) { bottom_vals = poisson_read_boundary(bottom.file, nx); if (!bottom_vals) goto fail; }
    94	    if (top.type == POISSON_DIRICHLET) { top_vals = poisson_read_boundary(top.file, nx); if (!top_vals) goto fail; }
    95	
    96	    int n = nx * ny;
    97	    COOMatrix *coo = coo_create(n, n, 5 * n);
    98	    double *b = vec_create(n);
    99	    if (!coo || !b) { coo_destroy(coo); free(b); goto fail; }
   100	
   101	    int k = 0;
   102	    for (int i = 0; i < nx; i++) {
   103	        for (int j = 0; j < ny; j++) {
   104	            int idx = i * ny + j;
   105	            int is_left = (i == 0);
   106	            int is_right = (i == nx - 1);
   107	            int is_bottom = (j == 0);
   108	            int is_top = (j == ny - 1);
   109	
   110	            if (is_left && left.type == POISSON_DIRICHLET) {
   111	                add_coo(coo, &k, idx, idx, 1.0);
   112	                b[idx] = left_vals[j];
   113	                continue;
   114	            }
   115	            if (is_right && right.type == POISSON_DIRICHLET) {
   116	                add_coo(coo, &k, idx, idx, 1.0);
   117	                b[idx] = right_vals[j];
   118	                continue;
   119	            }
   120	            if (is_bottom && bottom.type == POISSON_DIRICHLET) {
   121	                add_coo(coo, &k, idx, idx, 1.0);
   122	                b[idx] = bottom_vals[i];
   123	                continue;
   124	            }
   125	            if (is_top && top.type == POISSON_DIRICHLET) {
   126	                add_coo(coo, &k, idx, idx, 1.0);
   127	                b[idx] = top_vals[i];
   128	                continue;
   129	            }
   130	
   131	            double diag = 0.0;
   132	            double rhs = f[idx];
   133	            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;
   134	
   135	            if (is_left && left.type == POISSON_NEUMANN) {
   136	                diag += 2.0 / hx2;
   137	                c_ip = -2.0 / hx2;
   138	                rhs += 2.0 * left_vals[j] / hx;
   139	            } else if (is_right && right.type == POISSON_NEUMANN) {
   140	                diag += 2.0 / hx2;
   141	                c_im = -2.0 / hx2;
   142	                rhs += 2.0 * right_vals[j] / hx;
   143	            } else if (!is_left && !is_right) {
   144	                diag += 2.0 / hx2;
   145	                c_im = -1.0 / hx2;
   146	                c_ip = -1.0 / hx2;
   147	            }
   148	
   149	            if (is_bottom && bottom.type == POISSON_NEUMANN) {
   150	                diag += 2.0 / hy2;
   151	                c_jp = -2.0 / hy2;
   152	                rhs += 2.0 * bottom_vals[i] / hy;
   153	            } else if (is_top && top.type == POISSON_NEUMANN) {
   154	                diag += 2.0 / hy2;
   155	                c_jm = -2.0 / hy2;
   156	                rhs += 2.0 * top_vals[i] / hy;
   157	            } else if (!is_bottom && !is_top) {
   158	                diag += 2.0 / hy2;
   159	                c_jm = -1.0 / hy2;
   160	                c_jp = -1.0 / hy2;
   161	            }
   162	
   163	            add_coo(coo, &k, idx, idx, diag);
   164	            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);
   165	            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);
   166	            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);
   167	            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);
   168	            b[idx] = rhs;
   169	        }
   170	    }
   171	
   172	    coo->nnz = k;
   173	    CSRMatrix *A = coo_to_csr(coo);
   174	    coo_destroy(coo);
   175	    if (!A) { free(b); goto fail; }
   176	
   177	    free(f);
   178	    free(left_vals);
   179	    free(right_vals);
   180	    free(bottom_vals);
   181	    free(top_vals);
   182	
   183	    *A_out = A;
   184	    *b_out = b;
   185	    return 0;
   186	
   187	fail:
   188	    free(f);
   189	    free(left_vals);
   190	    free(right_vals);
   191	    free(bottom_vals);
   192	    free(top_vals);
   193	    return -1;
   194	}
