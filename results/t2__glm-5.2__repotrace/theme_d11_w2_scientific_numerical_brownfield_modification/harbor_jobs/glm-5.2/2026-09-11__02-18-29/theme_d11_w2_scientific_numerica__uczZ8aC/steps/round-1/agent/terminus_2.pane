    53	static int validate_ssor_omega(double omega)
    54	{
    55	    if (!(omega > 0.0 && omega < 2.0)) {
    56	        fprintf(stderr, "error: ssor-omega must be in (0,2)\n");
    57	        return 1;
    58	    }
    59	    return 0;
    60	}
