   385	        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
   386	        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
   387	        return 1;
   388	    }
