    49	static SolveResult *solve_linear_system(const CSRMatrix *A, const double *b,
    50	                                       const char *solver, const char *precond,
    51	                                       double tol, int maxiter, int restart,
    52	                                       double omega, int *fail)
    53	{
    54	    Precond *P = precond_create(A, precond, omega);
    55	    if (!P) {
    56	        *fail = 1;
    57	        return NULL;
    58	    }
    59	
    60	    SolveResult *res = NULL;
    61	    if (strcmp(solver, "cg") == 0) {
    62	        res = cg_solve(A, b, NULL, tol, maxiter, P);
    63	    } else if (strcmp(solver, "gmres") == 0) {
    64	        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);
    65	    } else {
    66	        *fail = 2;
    67	    }
    68	
    69	    precond_destroy(P);
    70	    if (!res) *fail = 1;
    71	    return res;
    72	}
    73	
    74	static CSRMatrix *make_shifted_matrix(const CSRMatrix *A, double sigma)
    75	{
    76	    int n = A->rows;
    77	    int *has_diag = (int *)calloc(n, sizeof(int));
    78	    if (!has_diag) return NULL;
    79	
    80	    for (int i = 0; i < n; i++) {
    81	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
    82	            if (A->col_indices[k] == i) has_diag[i] = 1;
    83	        }
    84	    }
    85	
    86	    int missing = 0;
    87	    for (int i = 0; i < n; i++) {
    88	        if (!has_diag[i]) missing++;
    89	    }
    90	
    91	    COOMatrix *coo = coo_create(n, n, A->nnz + missing);
    92	    if (!coo) { free(has_diag); return NULL; }
    93	
    94	    int idx = 0;
    95	    for (int i = 0; i < n; i++) {
    96	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
    97	            coo->row[idx] = i;
    98	            coo->col[idx] = A->col_indices[k];
    99	            coo->values[idx] = A->values[k];
   100	            if (A->col_indices[k] == i) coo->values[idx] -= sigma;
   101	            idx++;
   102	        }
   103	    }
   104	    for (int i = 0; i < n; i++) {
   105	        if (!has_diag[i]) {
   106	            coo->row[idx] = i;
   107	            coo->col[idx] = i;
   108	            coo->values[idx] = -sigma;
   109	            idx++;
   110	        }
   111	    }
   112	
   113	    CSRMatrix *S = coo_to_csr(coo);
   114	    coo_destroy(coo);
   115	    free(has_diag);
   116	    return S;
   117	}
