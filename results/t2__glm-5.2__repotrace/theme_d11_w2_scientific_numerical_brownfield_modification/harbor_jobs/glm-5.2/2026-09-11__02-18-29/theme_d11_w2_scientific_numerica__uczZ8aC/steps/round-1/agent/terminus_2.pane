   539	            csr_destroy(A);
   540	            return 1;
   541	        }
   542	        result_len = A->rows;
   543	    }
   544	
   545	    double *y = vec_create(result_len);
   546	    if (!y) {
   547	        free(x);
   548	        csr_destroy(A);
   549	        return 1;
   550	    }
   551	
   552	    if (transpose) {
   553	        for (int j = 0; j < A->cols; j++) y[j] = 0.0;
   554	        for (int i = 0; i < A->rows; i++) {
   555	            for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   556	                int j = A->col_indices[k];
   557	                y[j] += A->values[k] * x[i];
   558	            }
   559	        }
   560	    } else {
   561	        csr_spmv(A, x, y);
   562	    }
   563	
   564	    if (vec_write_mm_array(y, result_len, output) != 0) {
   565	        fprintf(stderr, "Error: cannot write output vector to '%s'\n", output);
   566	        free(y);
   567	        free(x);
   568	        csr_destroy(A);
   569	        return 1;
   570	    }
   571	
   572	    printf("operation: %s\n", transpose ? "matvec_transpose" : "matvec");
   573	    printf("rows: %d\n", A->rows);
   574	    printf("cols: %d\n", A->cols);
   575	    printf("result_norm: %.15e\n", vec_norm2(y, result_len));
   576	
   577	    free(y);
   578	    free(x);
   579	    csr_destroy(A);
   580	    return 0;
   581	}
