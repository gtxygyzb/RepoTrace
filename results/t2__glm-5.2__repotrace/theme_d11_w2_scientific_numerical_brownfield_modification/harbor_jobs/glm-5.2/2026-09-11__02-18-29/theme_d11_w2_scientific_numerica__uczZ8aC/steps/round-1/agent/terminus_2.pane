   190	static int cmd_sparse_solve(int argc, char **argv)
   191	{
   192	    const char *input = get_opt(argc, argv, "--input");
   193	    const char *rhs_file = get_opt(argc, argv, "--rhs");
   194	    const char *solver = get_opt(argc, argv, "--solver");
   195	    const char *precond = get_opt(argc, argv, "--precond");
   196	    const char *tol_s = get_opt(argc, argv, "--tol");
   197	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   198	    const char *restart_s = get_opt(argc, argv, "--restart");
   199	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   200	    const char *output = get_opt(argc, argv, "--output");
   201	    const char *history = get_opt(argc, argv, "--history");
   202	
   203	    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {
   204	        fprintf(stderr, "Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\n");
   205	        usage("numsim");
   206	        return 1;
   207	    }
   208	
   209	    double tol = atof(tol_s);
   210	    int maxiter = atoi(maxiter_s);
   211	    int restart = restart_s ? atoi(restart_s) : 30;
   212	    double omega = omega_s ? atof(omega_s) : 1.0;
   213	
   214	    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {
   215	        fprintf(stderr, "Error: invalid solver parameters\n");
   216	        return 1;
   217	    }
   218	    if (validate_ssor_omega(omega) != 0) {
   219	        return 1;
   220	    }
   221	
   222	    CSRMatrix *A = csr_read_mm(input);
   223	    if (!A) {
   224	        fprintf(stderr, "Error: cannot read sparse matrix from '%s'\n", input);
   225	        return 1;
   226	    }
   227	
   228	    int n;
   229	    double *b = vec_read_mm_array(rhs_file, &n);
   230	    if (!b) {
   231	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
   232	        csr_destroy(A);
   233	        return 1;
   234	    }
   235	
   236	    if (A->rows != n || A->cols != n) {
   237	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
   238	                A->rows, A->cols, n);
   239	        free(b);
   240	        csr_destroy(A);
   241	        return 1;
   242	    }
   243	
   244	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   245	
   246	    free(b);
   247	    csr_destroy(A);
   248	    return rc;
   249	}
