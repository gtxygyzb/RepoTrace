[?2004hroot@n30009:/app# cat include/sparse.h
[?2004l#ifndef SPARSE_H
#define SPARSE_H

#include <stdio.h>

typedef struct {
    int    rows;
    int    cols;
    int    nnz;
    double *values;
    int    *col_indices;
    int    *row_ptr;
} CSRMatrix;

typedef struct {
    int    rows;
    int    cols;
    int    nnz;
    double *values;
    int    *row;
    int    *col;
} COOMatrix;

/* Lifecycle */
CSRMatrix  *csr_create(int rows, int cols, int nnz);
void        csr_destroy(CSRMatrix *A);
COOMatrix  *coo_create(int rows, int cols, int nnz);
void        coo_destroy(COOMatrix *A);

/* Conversions */
COOMatrix  *csr_to_coo(const CSRMatrix *A);
CSRMatrix  *coo_to_csr(const COOMatrix *A);

/* Operations */
void        csr_spmv(const CSRMatrix *A, const double *x, double *y);
CSRMatrix  *csr_transpose(const CSRMatrix *A);
int         csr_is_symmetric(const CSRMatrix *A, double tol);
double     *csr_diagonal(const CSRMatrix *A);

/* Matrix Market I/O */
CSRMatrix  *csr_read_mm(const char *filename);
int         csr_write_mm(const CSRMatrix *A, const char *filename);
double     *vec_read_mm_array(const char *filename, int *n_out);
int         vec_write_mm_array(const double *x, int n, const char *filename);

#endif /* SPARSE_H */
