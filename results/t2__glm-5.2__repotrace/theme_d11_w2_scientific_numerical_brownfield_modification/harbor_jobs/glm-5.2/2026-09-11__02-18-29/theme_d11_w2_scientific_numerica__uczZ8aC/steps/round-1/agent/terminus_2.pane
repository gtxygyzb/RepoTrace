   174	CSRMatrix *csr_transpose(const CSRMatrix *A)
   175	{
   176	    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);
   177	    if (!T) return NULL;
   178	
   179	    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;
   180	    for (int k = 0; k < A->nnz; k++) {
[?2004hroot@n30009:/app# nl -ba src/sparse.c | sed -n '180,360p'
[?2004l   180	    for (int k = 0; k < A->nnz; k++) {
   181	        T->row_ptr[A->col_indices[k] + 1]++;
   182	    }
   183	    for (int i = 0; i < A->cols; i++) {
   184	        T->row_ptr[i+1] += T->row_ptr[i];
   185	    }
   186	
   187	    int *next = (int *)malloc((A->cols > 0 ? A->cols : 1) * sizeof(int));
   188	    if (!next) { csr_destroy(T); return NULL; }
   189	    for (int i = 0; i < A->cols; i++) next[i] = T->row_ptr[i];
   190	
   191	    for (int i = 0; i < A->rows; i++) {
   192	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   193	            int c = A->col_indices[k];
   194	            int pos = next[c]++;
   195	            T->col_indices[pos] = i;
   196	            T->values[pos] = A->values[k];
   197	        }
   198	    }
   199	
   200	    free(next);
   201	    return T;
   202	}
   203	
   204	int csr_is_symmetric(const CSRMatrix *A, double tol)
   205	{
   206	    if (A->rows != A->cols) return 0;
   207	    for (int i = 0; i < A->rows; i++) {
   208	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   209	            int j = A->col_indices[k];
   210	            int idx = csr_find_in_row(A, j, i);
   211	            if (idx < 0) return 0;
   212	            if (fabs(A->values[k] - A->values[idx]) > tol) return 0;
   213	        }
   214	    }
   215	    return 1;
   216	}
   217	
   218	double *csr_diagonal(const CSRMatrix *A)
   219	{
   220	    int n = A->rows < A->cols ? A->rows : A->cols;
   221	    double *diag = vec_create(n);
   222	    if (!diag) return NULL;
   223	    for (int i = 0; i < n; i++) {
   224	        int idx = csr_find_in_row(A, i, i);
   225	        diag[i] = (idx >= 0) ? A->values[idx] : 0.0;
   226	    }
   227	    return diag;
   228	}
