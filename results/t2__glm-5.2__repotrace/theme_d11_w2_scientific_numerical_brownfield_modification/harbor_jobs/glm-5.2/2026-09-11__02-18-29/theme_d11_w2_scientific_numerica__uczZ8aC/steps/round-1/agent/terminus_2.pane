   346	    const char *precond = get_opt(argc, argv, "--precond");
   347	    const char *tol_s = get_opt(argc, argv, "--tol");
   348	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   349	    const char *restart_s = get_opt(argc, argv, "--restart");
   350	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   351	    const char *output = get_opt(argc, argv, "--output");
   352	
   353	    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !alpha_s ||
   354	        !dt_s || !nsteps_s || !scheme || !ic_file || !source_arg ||
   355	        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
   356	        !solver || !precond || !tol_s || !maxiter_s || !output) {
