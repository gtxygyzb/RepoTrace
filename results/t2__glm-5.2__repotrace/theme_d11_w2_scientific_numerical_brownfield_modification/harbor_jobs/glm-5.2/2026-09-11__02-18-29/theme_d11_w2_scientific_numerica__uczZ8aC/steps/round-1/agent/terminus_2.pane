   132	static int parse_bc(const char *s, PoissonBC *bc)
   133	{
   134	    const char *colon = strchr(s, ':');
   135	    if (!colon || colon == s) return -1;
   136	
   137	    size_t len = colon - s;
   138	    char type[32];
   139	    if (len >= sizeof(type)) return -1;
   140	    memcpy(type, s, len);
   141	    type[len] = '\0';
   142	
   143	    if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
   144	    else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
   145	    else return -1;
   146	
   147	    bc->file = colon + 1;
   148	    return 0;
   149	}
   150	
   151	static int run_solver_and_print(const CSRMatrix *A, const double *b,
   152	                                const char *solver, const char *precond,
   153	                                double tol, int maxiter, int restart,
   154	                                double omega, const char *output,
   155	                                const char *history)
   156	{
   157	    Precond *P = precond_create(A, precond, omega);
   158	    if (!P) {
   159	        fprintf(stderr, "Error: cannot create preconditioner '%s'\n", precond);
   160	        return 1;
   161	    }
   162	
   163	    SolveResult *res = NULL;
   164	    if (strcmp(solver, "cg") == 0) {
   165	        res = cg_solve(A, b, NULL, tol, maxiter, P);
   166	    } else if (strcmp(solver, "gmres") == 0) {
   167	        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);
   168	    } else {
   169	        fprintf(stderr, "Error: unknown solver '%s'\n", solver);
   170	        precond_destroy(P);
   171	        return 1;
   172	    }
   173	
   174	    if (!res) {
   175	        fprintf(stderr, "Error: solver allocation failed\n");
   176	        precond_destroy(P);
   177	        return 1;
   178	    }
   179	
   180	    print_solve_summary(res);
   181	
   182	    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {
   183	        fprintf(stderr, "Error: cannot write output to '%s'\n", output);
   184	    }
   185	    if (history && write_history_file(res, history) != 0) {
   186	        fprintf(stderr, "Error: cannot write history to '%s'\n", history);
   187	    }
   188	
   189	    solve_result_destroy(res);
   190	    precond_destroy(P);
   191	    return 0;
   192	}
