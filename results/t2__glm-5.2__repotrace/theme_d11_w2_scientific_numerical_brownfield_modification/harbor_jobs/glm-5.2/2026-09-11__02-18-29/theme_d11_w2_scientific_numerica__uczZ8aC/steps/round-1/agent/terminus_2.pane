    36	static int write_history_file(const SolveResult *res, const char *filename)
    37	{
    38	    FILE *fp = fopen(filename, "w");
    39	    if (!fp) return -1;
    40	    for (int i = 0; i < res->history_len; i++) {
    41	        fprintf(fp, "%d\t%.15e\t%.15e\n", i, res->history[i], res->precond_history[i]);
    42	    }
    43	    fclose(fp);
    44	    return 0;
    45	}
    46	
    47	static void print_solve_summary(const SolveResult *res)
    48	{
    49	    printf("converged: %s\n", res->converged ? "yes" : "no");
    50	    printf("iterations: %d\n", res->iterations);
    51	    printf("residual: %.6e\n", res->relres);
    52	    printf("true_residual: %.6e\n", res->true_residual);
    53	}
    54	
    55	static int validate_ssor_omega(double omega)
    56	{
    57	    if (!(omega > 0.0 && omega < 2.0)) {
    58	        fprintf(stderr, "error: ssor-omega must be in (0,2)\n");
    59	        return 1;
    60	    }
    61	    return 0;
    62	}
