   343	    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
   344	    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
   345	    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
   346	    const char *solver = get_opt(argc, argv, "--solver");
   347	    const char *precond = get_opt(argc, argv, "--precond");
   348	    const char *tol_s = get_opt(argc, argv, "--tol");
   349	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   350	    const char *restart_s = get_opt(argc, argv, "--restart");
   351	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   352	    const char *output = get_opt(argc, argv, "--output");
   353	
   354	    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !alpha_s ||
   355	        !dt_s || !nsteps_s || !scheme || !ic_file || !source_arg ||
   356	        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
   357	        !solver || !precond || !tol_s || !maxiter_s || !output) {
   358	        fprintf(stderr, "Error: heat requires grid, domain, alpha, dt, nsteps, scheme, ic, source, boundary conditions, solver, precond, tol, maxiter, output\n");
   359	        usage("numsim");
   360	        return 1;
   361	    }
   362	
   363	    int nx = atoi(nx_s);
   364	    int ny = atoi(ny_s);
   365	    double x0 = atof(x0_s);
   366	    double x1 = atof(x1_s);
   367	    double y0 = atof(y0_s);
   368	    double y1 = atof(y1_s);
