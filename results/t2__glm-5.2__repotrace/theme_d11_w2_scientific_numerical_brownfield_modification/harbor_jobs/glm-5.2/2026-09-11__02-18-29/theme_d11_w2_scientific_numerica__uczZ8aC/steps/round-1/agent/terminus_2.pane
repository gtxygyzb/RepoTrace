[?2004lhar **argv)
{
    const char *input = get_opt(argc, argv, "--input");
    const char *vec_file = get_opt(argc, argv, "--vec");
    const char *output = get_opt(argc, argv, "--output");
    int transpose = 0;

    for (int i = 0; i < argc; i++) {
        if (strcmp(argv[i], "--transpose") == 0) {
            transpose = 1;
            break;
        }
    }

    if (!input || !vec_file || !output) {
        fprintf(stderr, "Error: matvec requires --input, --vec and --output\n");
        usage("numsim");
        return 1;
    }

    CSRMatrix *A = csr_read_mm(input);
    if (!A) {
        fprintf(stderr, "Error: cannot read sparse matrix from '%s'\n", input);
        return 1;
    }

    int n;
    double *x = vec_read_mm_array(vec_file, &n);
    if (!x) {
        fprintf(stderr, "Error: cannot read vector from '%s'\n", vec_file);
        csr_destroy(A);
        return 1;
    }

    int result_len;
    if (transpose) {
        if (n != A->rows) {
            fprintf(stderr, "error: dimension mismatch\n");
            free(x);
            csr_destroy(A);
            return 1;
        }
        result_len = A->cols;
    } else {
        if (n != A->cols) {
            fprintf(stderr, "error: dimension mismatch\n");
            free(x);
            csr_destroy(A);
            return 1;
        }
        result_len = A->rows;
    }

    double *y = vec_create(result_len);
    if (!y) {
        free(x);
        csr_destroy(A);
        return 1;
    }

    if (transpose) {
        for (int j = 0; j < A->cols; j++) y[j] = 0.0;
        for (int i = 0; i < A->rows; i++) {
            for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
                int j = A->col_indices[k];
                y[j] += A->values[k] * x[i];
            }
        }
    } else {
        csr_spmv(A, x, y);
    }

    if (vec_write_mm_array(y, result_len, output) != 0) {
        fprintf(stderr, "Error: cannot write output vector to '%s'\n", output);
        free(y);
        free(x);
        csr_destroy(A);
        return 1;
    }

    printf("operation: %s\n", transpose ? "matvec_transpose" : "matvec");
    printf("rows: %d\n", A->rows);
    printf("cols: %d\n", A->cols);
    printf("result_norm: %.15e\n", vec_norm2(y, result_len));

    free(y);
    free(x);
    csr_destroy(A);
    return 0;
}

