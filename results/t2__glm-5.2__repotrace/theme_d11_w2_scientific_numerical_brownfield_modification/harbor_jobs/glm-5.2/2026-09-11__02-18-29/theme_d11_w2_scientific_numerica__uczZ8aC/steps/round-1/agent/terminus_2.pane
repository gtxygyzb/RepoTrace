     7	CSRMatrix *csr_create(int rows, int cols, int nnz)
     8	{
     9	    CSRMatrix *A = (CSRMatrix *)malloc(sizeof(CSRMatrix));
    10	    if (!A) return NULL;
    11	    A->rows = rows;
    12	    A->cols = cols;
    13	    A->nnz = nnz;
    14	    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));
    15	    A->col_indices = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    16	    A->row_ptr = (int *)calloc((rows >= 0 ? rows + 1 : 1), sizeof(int));
    17	    if (!A->values || !A->col_indices || !A->row_ptr) {
    18	        csr_destroy(A);
    19	        return NULL;
    20	    }
    21	    return A;
    22	}
    23	
    24	void csr_destroy(CSRMatrix *A)
    25	{
    26	    if (!A) return;
    27	    free(A->values);
    28	    free(A->col_indices);
    29	    free(A->row_ptr);
    30	    free(A);
    31	}
    32	
    33	COOMatrix *coo_create(int rows, int cols, int nnz)
    34	{
    35	    COOMatrix *A = (COOMatrix *)malloc(sizeof(COOMatrix));
    36	    if (!A) return NULL;
    37	    A->rows = rows;
    38	    A->cols = cols;
    39	    A->nnz = nnz;
    40	    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));
    41	    A->row = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    42	    A->col = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    43	    if (!A->values || !A->row || !A->col) {
    44	        coo_destroy(A);
    45	        return NULL;
    46	    }
    47	    return A;
    48	}
    49	
    50	void coo_destroy(COOMatrix *A)
    51	{
    52	    if (!A) return;
    53	    free(A->values);
    54	    free(A->row);
    55	    free(A->col);
    56	    free(A);
    57	}
    58	
    59	static const COOMatrix *g_coo_sort_data = NULL;
    60	
    61	static int coo_qsort_cmp(const void *pa, const void *pb)
    62	{
    63	    int ia = *(const int *)pa;
    64	    int ib = *(const int *)pb;
    65	    const COOMatrix *A = g_coo_sort_data;
    66	    if (A->row[ia] != A->row[ib]) return A->row[ia] - A->row[ib];
    67	    return A->col[ia] - A->col[ib];
    68	}
    69	
    70	static COOMatrix *coo_sort_dedup(const COOMatrix *A)
    71	{
    72	    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);
    73	    if (!out) return NULL;
    74	
    75	    int *idx = (int *)malloc((A->nnz > 0 ? A->nnz : 1) * sizeof(int));
    76	    if (!idx) { coo_destroy(out); return NULL; }
    77	    for (int i = 0; i < A->nnz; i++) idx[i] = i;
    78	
    79	    g_coo_sort_data = A;
    80	    qsort(idx, A->nnz, sizeof(int), coo_qsort_cmp);
    81	    g_coo_sort_data = NULL;
    82	
    83	    int k = 0;
    84	    for (int i = 0; i < A->nnz; i++) {
    85	        int src = idx[i];
    86	        if (k > 0 && out->row[k-1] == A->row[src] && out->col[k-1] == A->col[src]) {
    87	            out->values[k-1] += A->values[src];
    88	        } else {
    89	            out->row[k] = A->row[src];
    90	            out->col[k] = A->col[src];
    91	            out->values[k] = A->values[src];
    92	            k++;
    93	        }
    94	    }
    95	    out->nnz = k;
    96	    free(idx);
    97	    return out;
    98	}
    99	
   100	COOMatrix *csr_to_coo(const CSRMatrix *A)
   101	{
   102	    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);
   103	    if (!out) return NULL;
   104	    int k = 0;
   105	    for (int i = 0; i < A->rows; i++) {
   106	        for (int j = A->row_ptr[i]; j < A->row_ptr[i+1]; j++) {
   107	            out->row[k] = i;
   108	            out->col[k] = A->col_indices[j];
   109	            out->values[k] = A->values[j];
   110	            k++;
   111	        }
   112	    }
   113	    out->nnz = k;
   114	    return out;
   115	}
   116	
   117	CSRMatrix *coo_to_csr(const COOMatrix *A)
   118	{
   119	    COOMatrix *sorted = coo_sort_dedup(A);
   120	    if (!sorted) return NULL;
   121	
   122	    CSRMatrix *out = csr_create(sorted->rows, sorted->cols, sorted->nnz);
   123	    if (!out) { coo_destroy(sorted); return NULL; }
   124	
   125	    for (int i = 0; i <= sorted->rows; i++) out->row_ptr[i] = 0;
   126	
   127	    for (int k = 0; k < sorted->nnz; k++) {
   128	        out->row_ptr[sorted->row[k] + 1]++;
   129	    }
   130	    for (int i = 0; i < sorted->rows; i++) {
   131	        out->row_ptr[i+1] += out->row_ptr[i];
   132	    }
   133	
   134	    int *next = (int *)malloc((sorted->rows > 0 ? sorted->rows : 1) * sizeof(int));
   135	    if (!next) { csr_destroy(out); coo_destroy(sorted); return NULL; }
   136	    for (int i = 0; i < sorted->rows; i++) next[i] = out->row_ptr[i];
   137	
   138	    for (int k = 0; k < sorted->nnz; k++) {
   139	        int r = sorted->row[k];
   140	        int pos = next[r]++;
   141	        out->col_indices[pos] = sorted->col[k];
   142	        out->values[pos] = sorted->values[k];
   143	    }
   144	
   145	    free(next);
   146	    coo_destroy(sorted);
   147	    return out;
   148	}
   149	
   150	void csr_spmv(const CSRMatrix *A, const double *x, double *y)
   151	{
   152	    for (int i = 0; i < A->rows; i++) {
   153	        double s = 0.0;
   154	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   155	            s += A->values[k] * x[A->col_indices[k]];
   156	        }
   157	        y[i] = s;
   158	    }
   159	}
   160	
   161	static int csr_find_in_row(const CSRMatrix *A, int row, int col)
   162	{
   163	    int lo = A->row_ptr[row];
   164	    int hi = A->row_ptr[row+1] - 1;
   165	    while (lo <= hi) {
   166	        int mid = (lo + hi) / 2;
   167	        if (A->col_indices[mid] == col) return mid;
   168	        if (A->col_indices[mid] < col) lo = mid + 1;
   169	        else hi = mid - 1;
   170	    }
   171	    return -1;
   172	}
   173	
   174	CSRMatrix *csr_transpose(const CSRMatrix *A)
   175	{
   176	    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);
   177	    if (!T) return NULL;
   178	
   179	    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;
   180	    for (int k = 0; k < A->nnz; k++) {
   181	        T->row_ptr[A->col_indices[k] + 1]++;
   182	    }
   183	    for (int i = 0; i < A->cols; i++) {
   184	        T->row_ptr[i+1] += T->row_ptr[i];
   185	    }
   186	
   187	    int *next = (int *)malloc((A->cols > 0 ? A->cols : 1) * sizeof(int));
   188	    if (!next) { csr_destroy(T); return NULL; }
   189	    for (int i = 0; i < A->cols; i++) next[i] = T->row_ptr[i];
   190	
   191	    for (int i = 0; i < A->rows; i++) {
   192	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   193	            int c = A->col_indices[k];
   194	            int pos = next[c]++;
   195	            T->col_indices[pos] = i;
   196	            T->values[pos] = A->values[k];
   197	        }
   198	    }
   199	
   200	    free(next);
   201	    return T;
   202	}
   203	
   204	int csr_is_symmetric(const CSRMatrix *A, double tol)
   205	{
   206	    if (A->rows != A->cols) return 0;
   207	    for (int i = 0; i < A->rows; i++) {
   208	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   209	            int j = A->col_indices[k];
   210	            int idx = csr_find_in_row(A, j, i);
   211	            if (idx < 0) return 0;
   212	            if (fabs(A->values[k] - A->values[idx]) > tol) return 0;
   213	        }
   214	    }
   215	    return 1;
   216	}
   217	
   218	double *csr_diagonal(const CSRMatrix *A)
   219	{
   220	    int n = A->rows < A->cols ? A->rows : A->cols;
   221	    double *diag = vec_create(n);
   222	    if (!diag) return NULL;
   223	    for (int i = 0; i < n; i++) {
   224	        int idx = csr_find_in_row(A, i, i);
   225	        diag[i] = (idx >= 0) ? A->values[idx] : 0.0;
   226	    }
   227	    return diag;
   228	}
