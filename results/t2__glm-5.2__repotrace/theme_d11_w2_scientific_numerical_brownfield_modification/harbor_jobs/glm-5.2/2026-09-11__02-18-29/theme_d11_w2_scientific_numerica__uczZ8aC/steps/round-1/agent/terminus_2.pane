void vec_copy(const double *src, double *dst, int n)
{
    memcpy(dst, src, (size_t)n * sizeof(double));
}

void vec_zero(double *x, int n)
{
    memset(x, 0, (size_t)n * sizeof(double));
}

void vec_scale(double a, double *x, int n)
{
    int i;
    for (i = 0; i < n; i++) x[i] *= a;
}

void vec_axpy(double a, const double *x, double *y, int n)
{
    int i;
    for (i = 0; i < n; i++) y[i] += a * x[i];
}

double vec_dot(const double *x, const double *y, int n)
{
    double s = 0.0;
    int i;
    for (i = 0; i < n; i++) s += x[i] * y[i];
    return s;
}

double vec_norm2(const double *x, int n)
{
    return sqrt(vec_dot(x, x, n));
}

void vec_print(const double *x, int n, FILE *out)
{
    int i;
    for (i = 0; i < n; i++)
        fprintf(out, "%.15g\n", x[i]);
}
[?2004hroot@n30009:/app# sed -n '1,180p' src/sparse.c
[?2004l#include "sparse.h"
#include "vector.h"
#include <stdlib.h>
#include <string.h>
#include <math.h>

CSRMatrix *csr_create(int rows, int cols, int nnz)
{
    CSRMatrix *A = (CSRMatrix *)malloc(sizeof(CSRMatrix));
    if (!A) return NULL;
    A->rows = rows;
    A->cols = cols;
    A->nnz = nnz;
    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));
    A->col_indices = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    A->row_ptr = (int *)calloc((rows >= 0 ? rows + 1 : 1), sizeof(int));
    if (!A->values || !A->col_indices || !A->row_ptr) {
        csr_destroy(A);
        return NULL;
    }
    return A;
}

void csr_destroy(CSRMatrix *A)
{
    if (!A) return;
    free(A->values);
    free(A->col_indices);
    free(A->row_ptr);
    free(A);
}

COOMatrix *coo_create(int rows, int cols, int nnz)
{
    COOMatrix *A = (COOMatrix *)malloc(sizeof(COOMatrix));
    if (!A) return NULL;
    A->rows = rows;
    A->cols = cols;
    A->nnz = nnz;
    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));
    A->row = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    A->col = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    if (!A->values || !A->row || !A->col) {
        coo_destroy(A);
        return NULL;
    }
    return A;
}

void coo_destroy(COOMatrix *A)
{
    if (!A) return;
    free(A->values);
    free(A->row);
    free(A->col);
    free(A);
}

static const COOMatrix *g_coo_sort_data = NULL;

static int coo_qsort_cmp(const void *pa, const void *pb)
{
    int ia = *(const int *)pa;
    int ib = *(const int *)pb;
    const COOMatrix *A = g_coo_sort_data;
    if (A->row[ia] != A->row[ib]) return A->row[ia] - A->row[ib];
    return A->col[ia] - A->col[ib];
}

static COOMatrix *coo_sort_dedup(const COOMatrix *A)
{
    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);
    if (!out) return NULL;

    int *idx = (int *)malloc((A->nnz > 0 ? A->nnz : 1) * sizeof(int));
    if (!idx) { coo_destroy(out); return NULL; }
    for (int i = 0; i < A->nnz; i++) idx[i] = i;

    g_coo_sort_data = A;
    qsort(idx, A->nnz, sizeof(int), coo_qsort_cmp);
    g_coo_sort_data = NULL;

    int k = 0;
    for (int i = 0; i < A->nnz; i++) {
        int src = idx[i];
        if (k > 0 && out->row[k-1] == A->row[src] && out->col[k-1] == A->col[src]) {
            out->values[k-1] += A->values[src];
        } else {
            out->row[k] = A->row[src];
            out->col[k] = A->col[src];
            out->values[k] = A->values[src];
            k++;
        }
    }
    out->nnz = k;
    free(idx);
    return out;
}

COOMatrix *csr_to_coo(const CSRMatrix *A)
{
    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);
    if (!out) return NULL;
    int k = 0;
    for (int i = 0; i < A->rows; i++) {
        for (int j = A->row_ptr[i]; j < A->row_ptr[i+1]; j++) {
            out->row[k] = i;
            out->col[k] = A->col_indices[j];
            out->values[k] = A->values[j];
            k++;
        }
    }
    out->nnz = k;
    return out;
}

CSRMatrix *coo_to_csr(const COOMatrix *A)
{
    COOMatrix *sorted = coo_sort_dedup(A);
    if (!sorted) return NULL;

    CSRMatrix *out = csr_create(sorted->rows, sorted->cols, sorted->nnz);
    if (!out) { coo_destroy(sorted); return NULL; }

    for (int i = 0; i <= sorted->rows; i++) out->row_ptr[i] = 0;

    for (int k = 0; k < sorted->nnz; k++) {
        out->row_ptr[sorted->row[k] + 1]++;
    }
    for (int i = 0; i < sorted->rows; i++) {
        out->row_ptr[i+1] += out->row_ptr[i];
    }

    int *next = (int *)malloc((sorted->rows > 0 ? sorted->rows : 1) * sizeof(int));
    if (!next) { csr_destroy(out); coo_destroy(sorted); return NULL; }
    for (int i = 0; i < sorted->rows; i++) next[i] = out->row_ptr[i];

    for (int k = 0; k < sorted->nnz; k++) {
        int r = sorted->row[k];
        int pos = next[r]++;
        out->col_indices[pos] = sorted->col[k];
        out->values[pos] = sorted->values[k];
    }

    free(next);
    coo_destroy(sorted);
    return out;
}

void csr_spmv(const CSRMatrix *A, const double *x, double *y)
{
    for (int i = 0; i < A->rows; i++) {
        double s = 0.0;
        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
            s += A->values[k] * x[A->col_indices[k]];
        }
        y[i] = s;
    }
}

static int csr_find_in_row(const CSRMatrix *A, int row, int col)
{
    int lo = A->row_ptr[row];
    int hi = A->row_ptr[row+1] - 1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        if (A->col_indices[mid] == col) return mid;
        if (A->col_indices[mid] < col) lo = mid + 1;
        else hi = mid - 1;
    }
    return -1;
}

CSRMatrix *csr_transpose(const CSRMatrix *A)
{
    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);
    if (!T) return NULL;

    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;
    for (int k = 0; k < A->nnz; k++) {
