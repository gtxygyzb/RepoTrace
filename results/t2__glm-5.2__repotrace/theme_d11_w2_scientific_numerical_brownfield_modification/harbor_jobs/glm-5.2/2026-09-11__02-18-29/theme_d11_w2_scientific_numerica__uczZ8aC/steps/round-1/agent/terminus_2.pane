   583	static int cmd_matinfo(int argc, char **argv)
   584	{
   585	    const char *input = get_opt(argc, argv, "--input");
   586	    if (!input) {
   587	        fprintf(stderr, "Error: matinfo requires --input <mtx_file>\n");
   588	        usage("numsim");
   589	        return 1;
   590	    }
   591	
   592	    CSRMatrix *A = csr_read_mm(input);
   593	    if (!A) {
   594	        fprintf(stderr, "error: cannot read matrix file\n");
   595	        return 1;
   596	    }
   597	
   598	    int rows = A->rows;
   599	    int cols = A->cols;
   600	
   601	    int symmetric = 0;
   602	    if (rows == cols) {
   603	        symmetric = 1;
   604	        for (int i = 0; i < rows && symmetric; i++) {
   605	            for (int k = A->row_ptr[i]; k < A->row_ptr[i+1] && symmetric; k++) {
   606	                int j = A->col_indices[k];
   607	                double v = A->values[k];
   608	
   609	                int idx = -1;
   610	                for (int l = A->row_ptr[j]; l < A->row_ptr[j+1]; l++) {
   611	                    if (A->col_indices[l] == i) {
   612	                        idx = l;
   613	                        break;
   614	                    }
   615	                }
   616	                if (idx < 0) {
   617	                    symmetric = 0;
   618	                    break;
   619	                }
   620	
   621	                double vt = A->values[idx];
   622	                double diff = fabs(v - vt);
   623	                double denom = fmax(fabs(v), fmax(fabs(vt), 1e-30));
   624	                if (diff >= 1e-12 * denom) {
   625	                    symmetric = 0;
   626	                    break;
   627	                }
   628	            }
   629	        }
   630	    }
   631	
   632	    int bandwidth = 0;
   633	    int nonzero_count = 0;
   634	    double frobenius_norm = 0.0;
   635	    double max_abs_value = 0.0;
   636	    double min_abs_nonzero = 0.0;
   637	
   638	    for (int i = 0; i < A->rows; i++) {
   639	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   640	            int j = A->col_indices[k];
   641	            double v = A->values[k];
   642	            double av = fabs(v);
   643	
   644	            frobenius_norm += v * v;
   645	
   646	            if (av > max_abs_value) max_abs_value = av;
   647	
   648	            if (av != 0.0) {
   649	                nonzero_count++;
   650	
   651	                int bw = i - j;
   652	                if (bw < 0) bw = -bw;
   653	                if (bw > bandwidth) bandwidth = bw;
   654	
   655	                if (min_abs_nonzero == 0.0 || av < min_abs_nonzero) {
   656	                    min_abs_nonzero = av;
   657	                }
   658	            }
   659	        }
   660	    }
   661	
   662	    frobenius_norm = sqrt(frobenius_norm);
   663	
   664	    int strict = 1;
   665	    int weak = 1;
   666	    for (int i = 0; i < A->rows; i++) {
   667	        double diag = 0.0;
   668	        double offsum = 0.0;
   669	
   670	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   671	            int j = A->col_indices[k];
   672	            if (j == i) {
   673	                diag = A->values[k];
   674	            } else {
   675	                offsum += fabs(A->values[k]);
   676	            }
   677	        }
   678	
   679	        if (fabs(diag) > offsum) {
   680	            continue;
   681	        }
   682	        if (fabs(diag) >= offsum) {
   683	            strict = 0;
   684	        } else {
   685	            strict = 0;
   686	            weak = 0;
   687	            break;
   688	        }
   689	    }
   690	
   691	    const char *diagonal_dominance = strict ? "strict" : (weak ? "weak" : "none");
   692	
   693	    printf("rows: %d\n", rows);
   694	    printf("cols: %d\n", cols);
   695	    printf("nnz: %d\n", nonzero_count);
   696	    printf("symmetric: %s\n", symmetric ? "yes" : "no");
   697	    printf("bandwidth: %d\n", bandwidth);
   698	    printf("frobenius_norm: %.15e\n", frobenius_norm);
   699	    printf("diagonal_dominance: %s\n", diagonal_dominance);
   700	    printf("max_abs_value: %.15e\n", max_abs_value);
   701	    printf("min_abs_nonzero: %.15e\n", min_abs_nonzero);
   702	
   703	    csr_destroy(A);
   704	    return 0;
   705	}
