    48	static const char *get_opt(int argc, char **argv, const char *name)
    49	{
    50	    for (int i = 0; i < argc - 1; i++) {
    51	        if (strcmp(argv[i], name) == 0) return argv[i+1];
    52	    }
    53	    return NULL;
