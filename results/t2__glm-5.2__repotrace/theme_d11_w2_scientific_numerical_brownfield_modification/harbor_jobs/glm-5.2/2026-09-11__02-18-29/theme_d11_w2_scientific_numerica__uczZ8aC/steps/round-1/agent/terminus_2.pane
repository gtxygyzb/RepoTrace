  144 | static int parse_bc(const char *s, PoissonBC *bc)
      | ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  145 | {
      | ~    
  146 |     const char *colon = strchr(s, ':');
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  147 |     if (!colon || colon == s) return -1;
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  148 | 
      |      
  149 |     size_t len = colon - s;
      |     ~~~~~~~~~~~~~~~~~~~~~~~
  150 |     char type[32];
      |     ~~~~~~~~~~~~~~
  151 |     if (len >= sizeof(type)) return -1;
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  152 |     memcpy(type, s, len);
      |     ~~~~~~~~~~~~~~~~~~~~~
  153 |     type[len] = '\0';
      |     ~~~~~~~~~~~~~~~~~
  154 | 
      |      
  155 |     if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  156 |     else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  157 |     else return -1;
      |     ~~~~~~~~~~~~~~~
  158 | 
      |      
  159 |     bc->file = colon + 1;
      |     ~~~~~~~~~~~~~~~~~~~~~
  160 |     return 0;
      |     ~~~~~~~~~
  161 | }
