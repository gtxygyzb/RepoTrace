    16	static void usage(const char *prog)
    17	{
    18	    fprintf(stderr, "Usage:\n");
    19	    fprintf(stderr, "  %s dense-solve <matrix_file> <rhs_file> [output_file]\n", prog);
    20	    fprintf(stderr, "  %s matinfo --input <mtx_file>\n", prog);
