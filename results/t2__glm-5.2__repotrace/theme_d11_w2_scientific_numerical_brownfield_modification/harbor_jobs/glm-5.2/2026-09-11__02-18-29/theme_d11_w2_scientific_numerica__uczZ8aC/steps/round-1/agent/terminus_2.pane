    56	static int write_history_file(const SolveResult *res, const char *filename)
    57	{
    58	    FILE *fp = fopen(filename, "w");
    59	    if (!fp) return -1;
    60	    for (int i = 0; i < res->history_len; i++) {
    61	        fprintf(fp, "%.15e\n", res->history[i]);
    62	    }
    63	    fclose(fp);
    64	    return 0;
    65	}
