   490	static int cmd_matinfo(int argc, char **argv)
   491	{
   492	    const char *input = get_opt(argc, argv, "--input");
   493	    if (!input) {
   494	        fprintf(stderr, "Error: matinfo requires --input <mtx_file>\n");
   495	        usage("numsim");
   496	        return 1;
   497	    }
   498	
   499	    CSRMatrix *A = csr_read_mm(input);
   500	    if (!A) {
   501	        fprintf(stderr, "error: cannot read matrix file\n");
   502	        return 1;
   503	    }
   504	
   505	    int rows = A->rows;
   506	    int cols = A->cols;
   507	
   508	    int symmetric = 0;
   509	    if (rows == cols) {
   510	        symmetric = 1;
   511	        for (int i = 0; i < rows && symmetric; i++) {
   512	            for (int k = A->row_ptr[i]; k < A->row_ptr[i+1] && symmetric; k++) {
   513	                int j = A->col_indices[k];
   514	                double v = A->values[k];
   515	
   516	                int idx = -1;
   517	                for (int l = A->row_ptr[j]; l < A->row_ptr[j+1]; l++) {
   518	                    if (A->col_indices[l] == i) {
   519	                        idx = l;
   520	                        break;
   521	                    }
   522	                }
   523	                if (idx < 0) {
   524	                    symmetric = 0;
   525	                    break;
   526	                }
   527	
   528	                double vt = A->values[idx];
   529	                double diff = fabs(v - vt);
   530	                double denom = fmax(fabs(v), fmax(fabs(vt), 1e-30));
   531	                if (diff >= 1e-12 * denom) {
   532	                    symmetric = 0;
   533	                    break;
   534	                }
   535	            }
   536	        }
   537	    }
   538	
   539	    int bandwidth = 0;
   540	    int nonzero_count = 0;
   541	    double frobenius_norm = 0.0;
   542	    double max_abs_value = 0.0;
   543	    double min_abs_nonzero = 0.0;
   544	
   545	    for (int i = 0; i < A->rows; i++) {
   546	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   547	            int j = A->col_indices[k];
   548	            double v = A->values[k];
   549	            double av = fabs(v);
   550	
   551	            frobenius_norm += v * v;
   552	
   553	            if (av > max_abs_value) max_abs_value = av;
   554	
   555	            if (av != 0.0) {
   556	                nonzero_count++;
   557	
   558	                int bw = i - j;
   559	                if (bw < 0) bw = -bw;
   560	                if (bw > bandwidth) bandwidth = bw;
   561	
   562	                if (min_abs_nonzero == 0.0 || av < min_abs_nonzero) {
   563	                    min_abs_nonzero = av;
   564	                }
   565	            }
   566	        }
   567	    }
   568	
   569	    frobenius_norm = sqrt(frobenius_norm);
   570	
   571	    int strict = 1;
   572	    int weak = 1;
   573	    for (int i = 0; i < A->rows; i++) {
   574	        double diag = 0.0;
   575	        double offsum = 0.0;
   576	
   577	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   578	            int j = A->col_indices[k];
   579	            if (j == i) {
   580	                diag = A->values[k];
   581	            } else {
   582	                offsum += fabs(A->values[k]);
   583	            }
   584	        }
   585	
   586	        if (fabs(diag) > offsum) {
   587	            continue;
   588	        }
   589	        if (fabs(diag) >= offsum) {
   590	            strict = 0;
   591	        } else {
   592	            strict = 0;
   593	            weak = 0;
   594	            break;
   595	        }
   596	    }
   597	
   598	    const char *diagonal_dominance = strict ? "strict" : (weak ? "weak" : "none");
   599	
   600	    printf("rows: %d\n", rows);
   601	    printf("cols: %d\n", cols);
   602	    printf("nnz: %d\n", nonzero_count);
   603	    printf("symmetric: %s\n", symmetric ? "yes" : "no");
   604	    printf("bandwidth: %d\n", bandwidth);
   605	    printf("frobenius_norm: %.15e\n", frobenius_norm);
   606	    printf("diagonal_dominance: %s\n", diagonal_dominance);
   607	    printf("max_abs_value: %.15e\n", max_abs_value);
   608	    printf("min_abs_nonzero: %.15e\n", min_abs_nonzero);
   609	
   610	    csr_destroy(A);
   611	    return 0;
   612	}
