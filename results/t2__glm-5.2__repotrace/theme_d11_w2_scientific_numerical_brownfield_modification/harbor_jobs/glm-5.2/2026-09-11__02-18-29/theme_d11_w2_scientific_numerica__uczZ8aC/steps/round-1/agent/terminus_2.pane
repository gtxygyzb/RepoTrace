   103	        fprintf(stderr, "Error: solver failed (singular or ill-conditioned)\n");
   104	        free(x);
   105	        free(b);
   106	        dm_destroy(A);
   107	        return 1;
   108	    }
   109	
   110	    if (out_file) {
   111	        vec_write_text(x, n, out_file);
   112	        printf("Solution written to %s\n", out_file);
   113	    } else {
   114	        printf("Solution:\n");
   115	        vec_print(x, n, stdout);
   116	    }
   117	
