    29	static const char *get_opt(int argc, char **argv, const char *name)
    30	{
    31	    for (int i = 0; i < argc - 1; i++) {
    32	        if (strcmp(argv[i], name) == 0) return argv[i+1];
    33	    }
    34	    return NULL;
    35	}
    36	
    37	static int write_history_file(const SolveResult *res, const char *filename)
    38	{
    39	    FILE *fp = fopen(filename, "w");
    40	    if (!fp) return -1;
    41	    for (int i = 0; i < res->history_len; i++) {
    42	        fprintf(fp, "%d\t%.15e\t%.15e\n", i, res->history[i], res->precond_history[i]);
    43	    }
    44	    fclose(fp);
    45	    return 0;
    46	}
    47	
    48	static void print_solve_summary(const SolveResult *res)
    49	{
    50	    printf("converged: %s\n", res->converged ? "yes" : "no");
    51	    printf("iterations: %d\n", res->iterations);
    52	    printf("residual: %.6e\n", res->relres_inf);
    53	    printf("true_residual: %.6e\n", res->true_residual_inf);
    54	}
    55	
    56	static int validate_ssor_omega(double omega)
    57	{
    58	    if (!(omega > 0.0 && omega < 2.0)) {
    59	        fprintf(stderr, "error: ssor-omega must be in (0,2)\n");
    60	        return 1;
    61	    }
    62	    return 0;
    63	}
