SRC     = src/main.c src/dense.c src/vector.c src/io.c src/sparse.c src/precond.c src/solvers.c src/poisson.c src/heat.c src/convdiff.c
OBJ     = $(SRC:.c=.o)
BIN     = numsim

.PHONY: all clean

all: $(BIN)

$(BIN): $(SRC)
>$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

clean:
>rm -f $(BIN) $(OBJ)
