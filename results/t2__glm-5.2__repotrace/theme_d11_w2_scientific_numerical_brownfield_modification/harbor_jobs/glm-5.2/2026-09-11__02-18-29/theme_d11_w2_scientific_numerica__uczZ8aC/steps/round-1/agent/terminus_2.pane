    59	static const COOMatrix *g_coo_sort_data = NULL;
    60	
    61	static int coo_qsort_cmp(const void *pa, const void *pb)
    62	{
    63	    int ia = *(const int *)pa;
    64	    int ib = *(const int *)pb;
    65	    const COOMatrix *A = g_coo_sort_data;
    66	    if (A->row[ia] != A->row[ib]) return A->row[ia] - A->row[ib];
    67	    return A->col[ia] - A->col[ib];
    68	}
    69	
    70	static COOMatrix *coo_sort_dedup(const COOMatrix *A)
    71	{
    72	    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);
    73	    if (!out) return NULL;
    74	
    75	    int *idx = (int *)malloc((A->nnz > 0 ? A->nnz : 1) * sizeof(int));
    76	    if (!idx) { coo_destroy(out); return NULL; }
    77	    for (int i = 0; i < A->nnz; i++) idx[i] = i;
    78	
    79	    g_coo_sort_data = A;
    80	    qsort(idx, A->nnz, sizeof(int), coo_qsort_cmp);
    81	    g_coo_sort_data = NULL;
    82	
    83	    int k = 0;
    84	    for (int i = 0; i < A->nnz; i++) {
    85	        int src = idx[i];
    86	        if (k > 0 && out->row[k-1] == A->row[src] && out->col[k-1] == A->col[src]) {
    87	            out->values[k-1] += A->values[src];
    88	        } else {
    89	            out->row[k] = A->row[src];
    90	            out->col[k] = A->col[src];
    91	            out->values[k] = A->values[src];
    92	            k++;
    93	        }
    94	    }
    95	    out->nnz = k;
    96	    free(idx);
    97	    return out;
    98	}
