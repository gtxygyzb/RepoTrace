    26	static const char *get_opt(int argc, char **argv, const char *name)
    27	{
    28	    for (int i = 0; i < argc - 1; i++) {
    29	        if (strcmp(argv[i], name) == 0) return argv[i+1];
    30	    }
    31	    return NULL;
    32	}
    33	
    34	static int write_history_file(const SolveResult *res, const char *filename)
    35	{
    36	    FILE *fp = fopen(filename, "w");
    37	    if (!fp) return -1;
    38	    for (int i = 0; i < res->history_len; i++) {
    39	        fprintf(fp, "%d\t%.15e\t%.15e\n", i, res->history[i], res->precond_history[i]);
    40	    }
    41	    fclose(fp);
    42	    return 0;
    43	}
    44	
    45	static void print_solve_summary(const SolveResult *res)
    46	{
    47	    printf("converged: %s\n", res->converged ? "yes" : "no");
    48	    printf("iterations: %d\n", res->iterations);
    49	    printf("residual: %.6e\n", res->relres);
    50	    printf("true_residual: %.6e\n", res->true_residual);
    51	}
