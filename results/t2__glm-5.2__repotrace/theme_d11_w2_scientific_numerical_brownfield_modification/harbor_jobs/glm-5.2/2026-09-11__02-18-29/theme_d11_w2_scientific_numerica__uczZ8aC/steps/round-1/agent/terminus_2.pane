     7	static SolveResult *result_create(int n, int maxiter)
     8	{
     9	    if (maxiter < 0) maxiter = 0;
    10	    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));
    11	    if (!res) return NULL;
    12	
    13	    res->x = vec_create(n);
    14	    res->history = (double *)malloc((maxiter + 1) * sizeof(double));
    15	    res->precond_history = (double *)malloc((maxiter + 1) * sizeof(double));
    16	    if (!res->x || !res->history || !res->precond_history) {
    17	        free(res->x);
    18	        free(res->history);
    19	        free(res->precond_history);
    20	        free(res);
    21	        return NULL;
    22	    }
    23	    res->history_len = 0;
    24	    return res;
    25	}
    26	
    27	SolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,
    28	                      double tol, int maxiter, Precond *P)
    29	{
    30	    if (!A || !b || A->rows != A->cols) return NULL;
    31	    int n = A->rows;
    32	    if (maxiter < 0) maxiter = 0;
    33	
    34	    SolveResult *res = result_create(n, maxiter);
    35	    if (!res) return NULL;
    36	
    37	    double *r = vec_create(n);
    38	    double *z = vec_create(n);
    39	    double *p = vec_create(n);
    40	    double *Ap = vec_create(n);
    41	    if (!r || !z || !p || !Ap) {
    42	        free(r); free(z); free(p); free(Ap);
    43	        solve_result_destroy(res);
    44	        return NULL;
    45	    }
    46	
    47	    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);
    48	
    49	    csr_spmv(A, res->x, Ap);
    50	    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
    51	
    52	    double bnorm = vec_norm2(b, n);
    53	    if (bnorm == 0.0) bnorm = 1.0;
    54	
    55	    res->true_residual = vec_norm2(r, n);
    56	    res->relres = res->true_residual / bnorm;
    57	    res->history[0] = res->relres;
    58	    res->precond_history[0] = res->true_residual;
    59	    res->history_len = 1;
    60	    res->converged = (res->relres < tol) ? 1 : 0;
    61	    res->iterations = 0;
    62	    if (res->converged || maxiter == 0) {
    63	        free(r); free(z); free(p); free(Ap);
    64	        return res;
    65	    }
    66	
    67	    if (precond_apply(P, A, r, z) != 0) {
    68	        free(r); free(z); free(p); free(Ap);
    69	        return res;
    70	    }
    71	    vec_copy(z, p, n);
    72	    double rz_old = vec_dot(r, z, n);
    73	
    74	    for (int iter = 1; iter <= maxiter; iter++) {
    75	        csr_spmv(A, p, Ap);
    76	        double pAp = vec_dot(p, Ap, n);
    77	        if (fabs(pAp) < 1e-30) break;
    78	
    79	        double alpha = rz_old / pAp;
    80	        vec_axpy(alpha, p, res->x, n);
    81	        vec_axpy(-alpha, Ap, r, n);
    82	
    83	        /* Recompute the true residual rather than relying on the recurrence. */
    84	        csr_spmv(A, res->x, Ap);
    85	        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
    86	
    87	        res->true_residual = vec_norm2(r, n);
    88	        res->relres = res->true_residual / bnorm;
    89	        res->history[iter] = res->relres;
    90	        res->precond_history[iter] = pznorm;
    91	        res->history_len = iter + 1;
    92	        res->iterations = iter;
    93	
    94	        if (res->relres < tol) {
    95	            res->converged = 1;
    96	            break;
    97	        }
    98	
    99	        if (precond_apply(P, A, r, z) != 0) break;
   100	        double rz_new = vec_dot(r, z, n);
   101	        if (fabs(rz_old) < 1e-30) break;
   102	        double beta = rz_new / rz_old;
   103	        vec_scale(beta, p, n);
   104	        vec_axpy(1.0, z, p, n);
   105	        rz_old = rz_new;
   106	    }
   107	
   108	    free(r); free(z); free(p); free(Ap);
   109	    return res;
   110	}
   111	
   112	static void apply_givens(double *a, double *b, double c, double s)
   113	{
   114	    double t = c * (*a) + s * (*b);
   115	    *b = -s * (*a) + c * (*b);
   116	    *a = t;
   117	}
   118	
   119	static int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)
   120	{
   121	    if (kdim <= 0) return -1;
   122	
   123	    double *c = (double *)malloc(m * sizeof(double));
   124	    double *s = (double *)malloc(m * sizeof(double));
   125	    if (!c || !s) { free(c); free(s); return -1; }
   126	
   127	    for (int i = 0; i < kdim; i++) {
   128	        for (int k = 0; k < i; k++) {
   129	            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);
   130	        }
[?2004hroot@n30009:/app# nl -ba src/solvers.c | sed -n '130,290p'
[?2004l   130	        }
   131	
   132	        double a = H[i*m+i];
   133	        double b = H[(i+1)*m+i];
   134	        if (b == 0.0) {
   135	            c[i] = 1.0;
   136	            s[i] = 0.0;
   137	        } else {
   138	            double r = hypot(a, b);
   139	            c[i] = a / r;
   140	            s[i] = b / r;
   141	        }
   142	        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);
   143	        apply_givens(&g[i], &g[i+1], c[i], s[i]);
   144	
   145	    }
   146	
   147	    for (int i = kdim - 1; i >= 0; i--) {
   148	        double sum = g[i];
   149	        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];
   150	        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }
   151	        y[i] = sum / H[i*m+i];
   152	    }
   153	
   154	    free(c);
   155	    free(s);
   156	    return 0;
   157	}
