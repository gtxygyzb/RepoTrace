   259	static int read_non_comment_line(FILE *fp, char *buf, int bufsize)
   260	{
[?2004hroot@n30009:/app# nl -ba src/sparse.c | sed -n '261,560p'
[?2004l   261	    while (fgets(buf, bufsize, fp)) {
   262	        char *s = buf;
