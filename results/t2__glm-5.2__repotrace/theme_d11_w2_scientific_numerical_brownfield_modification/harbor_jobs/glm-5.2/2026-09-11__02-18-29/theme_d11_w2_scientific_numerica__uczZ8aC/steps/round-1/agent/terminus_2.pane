    36	double *vec_create(int n)
    37	{
    38	    if (n <= 0) return NULL;
    39	    return calloc(n, sizeof(double));
    40	}
    41	
    42	void vec_copy(const double *src, double *dst, int n)
    43	{
    44	    memcpy(dst, src, (size_t)n * sizeof(double));
    45	}
    46	
    47	void vec_zero(double *x, int n)
    48	{
    49	    memset(x, 0, (size_t)n * sizeof(double));
    50	}
    51	
    52	void vec_scale(double a, double *x, int n)
    53	{
    54	    int i;
    55	    for (i = 0; i < n; i++) x[i] *= a;
    56	}
    57	
    58	void vec_axpy(double a, const double *x, double *y, int n)
    59	{
    60	    int i;
    61	    for (i = 0; i < n; i++) y[i] += a * x[i];
    62	}
    63	
    64	double vec_dot(const double *x, const double *y, int n)
    65	{
    66	    double s = 0.0;
    67	    int i;
    68	    for (i = 0; i < n; i++) s += x[i] * y[i];
    69	    return s;
    70	}
    71	
    72	double vec_norm2(const double *x, int n)
    73	{
    74	    return sqrt(vec_dot(x, x, n));
    75	}
