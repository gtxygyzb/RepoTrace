[?2004l[?2004h> 
[?2004l[?2004h> static int find_in_row(const CSRMatrix *A, int row, int col)
[?2004l[?2004h> {
[?2004l[?2004h>     int lo = A->row_ptr[row];
[?2004l[?2004h>     int hi = A->row_ptr[row+1] - 1;
[?2004l[?2004h>     while (lo <= hi) {
[?2004l[?2004h>         int mid = (lo + hi) / 2;
[?2004l[?2004h>         if (A->col_indices[mid] == col) return mid;
[?2004l[?2004h>         if (A->col_indices[mid] < col) lo = mid + 1;
[?2004l[?2004h>         else hi = mid - 1;
[?2004l[?2004h>     }
[?2004l[?2004h>     return -1;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> static CSRMatrix *csr_copy(const CSRMatrix *A)
[?2004l[?2004h> {
[?2004l[?2004h>     CSRMatrix *B = csr_create(A->rows, A->cols, A->nnz);
[?2004l[?2004h>     if (!B) return NULL;
[?2004l[?2004h>     memcpy(B->values, A->values, A->nnz * sizeof(double));
[?2004l[?2004h>     memcpy(B->col_indices, A->col_indices, A->nnz * sizeof(int));
[?2004l[?2004h>     memcpy(B->row_ptr, A->row_ptr, (A->rows + 1) * sizeof(int));
[?2004l[?2004h>     return B;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> static int ilu0_factorize(CSRMatrix *LU)
[?2004l[?2004h> {
[?2004l[?2004h>     int n = LU->rows;
[?2004l[?2004h>     for (int i = 0; i < n; i++) {
[?2004l[?2004h>         for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {
[?2004l[?2004h>             int c = LU->col_indices[k];
[?2004l[?2004h>             if (c >= i) break;
[?2004l[?2004h> 
[?2004l[?2004h>             int d = find_in_row(LU, c, c);
[?2004l[?2004h>             if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;
[?2004l[?2004h> 
[?2004l[?2004h>             LU->values[k] /= LU->values[d];
[?2004l[?2004h>             double aik = LU->values[k];
[?2004l[?2004h> 
[?2004l[?2004h>             for (int l = LU->row_ptr[c]; l < LU->row_ptr[c+1]; l++) {
[?2004l[?2004h>                 int j = LU->col_indices[l];
[?2004l[?2004h>                 if (j <= c) continue;
[?2004l[?2004h>                 int idx = find_in_row(LU, i, j);
[?2004l[?2004h>                 if (idx >= 0) LU->values[idx] -= aik * LU->values[l];
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     return 0;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> static int ilu_forward_solve(const CSRMatrix *LU, const double *r, double *y)
[?2004l[?2004h> {
[?2004l[?2004h>     for (int i = 0; i < LU->rows; i++) {
[?2004l[?2004h>         double s = r[i];
[?2004l[?2004h>         for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {
[?2004l[?2004h>             int j = LU->col_indices[k];
[?2004l[?2004h>             if (j < i) s -= LU->values[k] * y[j];
[?2004l[?2004h>             else break;
[?2004l[?2004h>         }
[?2004l[?2004h>         y[i] = s;
[?2004l[?2004h>     }
[?2004l[?2004h>     return 0;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> static int ilu_backward_solve(const CSRMatrix *LU, const double *y, double *z)
[?2004l[?2004h> {
[?2004l[?2004h>     for (int i = LU->rows - 1; i >= 0; i--) {
[?2004l[?2004h>         double s = y[i];
[?2004l[?2004h>         int d = -1;
[?2004l[?2004h>         for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {
[?2004l[?2004h>             int j = LU->col_indices[k];
[?2004l[?2004h>             if (j == i) d = k;
[?2004l[?2004h>             else if (j > i) s -= LU->values[k] * z[j];
[?2004l[?2004h>         }
[?2004l[?2004h>         if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;
[?2004l[?2004h>         z[i] = s / LU->values[d];
[?2004l[?2004h>     }
[?2004l[?2004h>     return 0;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> Precond *precond_create(const CSRMatrix *A, const char *name, double omega)
[?2004l[?2004h> {
[?2004l[?2004h>     if (!A || !name || A->rows != A->cols) return NULL;
[?2004l[?2004h> 
[?2004l[?2004h>     Precond *P = (Precond *)calloc(1, sizeof(Precond));
[?2004l[?2004h>     if (!P) return NULL;
[?2004l[?2004h> 
[?2004l[?2004h>     P->n = A->rows;
[?2004l[?2004h>     P->omega = (omega > 0.0) ? omega : 1.0;
[?2004l[?2004h> 
[?2004l[?2004h>     if (strcmp(name, "none") == 0) {
[?2004l[?2004h>         P->type = PRECOND_NONE;
[?2004l[?2004h>     } else if (strcmp(name, "jacobi") == 0) {
[?2004l[?2004h>         P->type = PRECOND_JACOBI;
[?2004l[?2004h>         P->diag = csr_diagonal(A);
[?2004l[?2004h>         if (!P->diag) { precond_destroy(P); return NULL; }
[?2004l[?2004h>     } else if (strcmp(name, "ilu0") == 0) {
[?2004l[?2004h>         P->type = PRECOND_ILU0;
[?2004l[?2004h>         P->lu = csr_copy(A);
[?2004l[?2004h>         if (!P->lu) { precond_destroy(P); return NULL; }
[?2004l[?2004h>         if (ilu0_factorize(P->lu) != 0) { precond_destroy(P); return NULL; }
[?2004l[?2004h>     } else if (strcmp(name, "ssor") == 0) {
[?2004l[?2004h>         P->type = PRECOND_SSOR;
[?2004l[?2004h>         P->ssor_A = A;
[?2004l[?2004h>         P->diag = csr_diagonal(A);
[?2004l[?2004h>         if (!P->diag) { precond_destroy(P); return NULL; }
[?2004l[?2004h>     } else {
[?2004l[?2004h>         precond_destroy(P);
[?2004l[?2004h>         return NULL;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     return P;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> void precond_destroy(Precond *P)
[?2004l[?2004h> {
[?2004l[?2004h>     if (!P) return;
[?2004l[?2004h>     free(P->diag);
[?2004l[?2004h>     csr_destroy(P->lu);
[?2004l[?2004h>     free(P);
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> int precond_apply(Precond *P, const CSRMatrix *A, const double *r, double *z)
[?2004l[?2004h> {
[?2004l[?2004h>     int n = A ? A->rows : (P ? P->n : 0);
[?2004l[?2004h>     if (!P || P->type == PRECOND_NONE) {
[?2004l[?2004h>         vec_copy(r, z, n);
[?2004l[?2004h>         return 0;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     switch (P->type) {
[?2004l[?2004h>     case PRECOND_JACOBI:
[?2004l[?2004h>         for (int i = 0; i < n; i++) {
[?2004l[?2004h>             if (fabs(P->diag[i]) < 1e-15) return -1;
[?2004l[?2004h>             z[i] = r[i] / P->diag[i];
[?2004l[?2004h>         }
[?2004l[?2004h>         return 0;
[?2004l[?2004h> 
[?2004l[?2004h>     case PRECOND_ILU0: {
[?2004l[?2004h>         double *y = vec_create(n);
[?2004l[?2004h>         if (!y) return -1;
[?2004l[?2004h>         if (ilu_forward_solve(P->lu, r, y) != 0) { free(y); return -1; }
[?2004l[?2004h>         if (ilu_backward_solve(P->lu, y, z) != 0) { free(y); return -1; }
[?2004l[?2004h>         free(y);
[?2004l[?2004h>         return 0;
