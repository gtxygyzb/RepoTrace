     7	double *poisson_read_source(const char *filename, int nx, int ny)
     8	{
     9	    FILE *fp = fopen(filename, "r");
    10	    if (!fp) return NULL;
    11	
    12	    int rx, ry;
    13	    if (fscanf(fp, "%d %d", &rx, &ry) != 2 || rx != nx || ry != ny) {
    14	        fclose(fp);
    15	        return NULL;
    16	    }
    17	
    18	    int n = nx * ny;
    19	    double *f = vec_create(n);
    20	    if (!f) { fclose(fp); return NULL; }
    21	
    22	    for (int i = 0; i < n; i++) {
    23	        if (fscanf(fp, "%lf", &f[i]) != 1) {
    24	            free(f);
    25	            fclose(fp);
    26	            return NULL;
    27	        }
    28	    }
    29	
    30	    fclose(fp);
    31	    return f;
    32	}
    33	
    34	double *poisson_read_boundary(const char *filename, int expected)
    35	{
    36	    FILE *fp = fopen(filename, "r");
    37	    if (!fp) return NULL;
    38	
    39	    double *vals = (double *)malloc(expected * sizeof(double));
    40	    if (!vals) { fclose(fp); return NULL; }
    41	
    42	    int count = 0;
    43	    while (count < expected) {
    44	        double v;
    45	        if (fscanf(fp, "%lf", &v) != 1) break;
    46	        vals[count++] = v;
    47	    }
    48	
    49	    fclose(fp);
    50	    if (count != expected) { free(vals); return NULL; }
    51	    return vals;
    52	}
    53	
    54	static void add_coo(COOMatrix *coo, int *k, int r, int c, double v)
    55	{
    56	    coo->row[*k] = r;
    57	    coo->col[*k] = c;
    58	    coo->values[*k] = v;
    59	    (*k)++;
    60	}
