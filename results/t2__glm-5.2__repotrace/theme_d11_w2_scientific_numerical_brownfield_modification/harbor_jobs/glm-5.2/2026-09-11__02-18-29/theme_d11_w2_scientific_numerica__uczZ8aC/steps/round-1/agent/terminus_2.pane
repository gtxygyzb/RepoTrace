   332	    const char *y1_s = get_opt(argc, argv, "--y1");
   333	    const char *alpha_s = get_opt(argc, argv, "--alpha");
   334	    const char *dt_s = get_opt(argc, argv, "--dt");
   335	    const char *nsteps_s = get_opt(argc, argv, "--nsteps");
   336	    const char *scheme = get_opt(argc, argv, "--scheme");
   337	    const char *ic_file = get_opt(argc, argv, "--ic");
   338	    const char *source_arg = get_opt(argc, argv, "--source");
   339	    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
   340	    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
   341	    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
   342	    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
   343	    const char *solver = get_opt(argc, argv, "--solver");
   344	    const char *precond = get_opt(argc, argv, "--precond");
   345	    const char *tol_s = get_opt(argc, argv, "--tol");
   346	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   347	    const char *restart_s = get_opt(argc, argv, "--restart");
   348	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   349	    const char *output = get_opt(argc, argv, "--output");
   350	
   351	    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !alpha_s ||
   352	        !dt_s || !nsteps_s || !scheme || !ic_file || !source_arg ||
   353	        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
   354	        !solver || !precond || !tol_s || !maxiter_s || !output) {
   355	        fprintf(stderr, "Error: heat requires grid, domain, alpha, dt, nsteps, scheme, ic, source, boundary conditions, solver, precond, tol, maxiter, output\n");
   356	        usage("numsim");
   357	        return 1;
   358	    }
   359	
   360	    int nx = atoi(nx_s);
   361	    int ny = atoi(ny_s);
   362	    double x0 = atof(x0_s);
   363	    double x1 = atof(x1_s);
   364	    double y0 = atof(y0_s);
   365	    double y1 = atof(y1_s);
   366	    double alpha = atof(alpha_s);
   367	    double dt = atof(dt_s);
   368	    int nsteps = atoi(nsteps_s);
   369	    double tol = atof(tol_s);
   370	    int maxiter = atoi(maxiter_s);
   371	    int restart = restart_s ? atoi(restart_s) : 30;
   372	    double omega = omega_s ? atof(omega_s) : 1.0;
   373	
   374	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || alpha <= 0.0 ||
   375	        dt <= 0.0 || nsteps < 0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {
   376	        fprintf(stderr, "Error: invalid heat parameters\n");
   377	        return 1;
   378	    }
   379	    if (validate_ssor_omega(omega) != 0) {
   380	        return 1;
   381	    }
