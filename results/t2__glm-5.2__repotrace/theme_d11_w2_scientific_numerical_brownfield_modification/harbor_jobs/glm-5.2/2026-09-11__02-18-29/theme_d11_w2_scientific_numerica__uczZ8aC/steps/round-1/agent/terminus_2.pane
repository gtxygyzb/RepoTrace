   206	static int cmd_sparse_solve(int argc, char **argv)
   207	{
   208	    const char *input = get_opt(argc, argv, "--input");
   209	    const char *rhs_file = get_opt(argc, argv, "--rhs");
   210	    const char *solver = get_opt(argc, argv, "--solver");
   211	    const char *precond = get_opt(argc, argv, "--precond");
   212	    const char *tol_s = get_opt(argc, argv, "--tol");
   213	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   214	    const char *restart_s = get_opt(argc, argv, "--restart");
   215	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   216	    const char *output = get_opt(argc, argv, "--output");
   217	    const char *history = get_opt(argc, argv, "--history");
   218	
   219	    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {
   220	        fprintf(stderr, "Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\n");
   221	        usage("numsim");
   222	        return 1;
   223	    }
   224	
   225	    double tol = atof(tol_s);
   226	    int maxiter = atoi(maxiter_s);
   227	    int restart = restart_s ? atoi(restart_s) : 30;
   228	    double omega = omega_s ? atof(omega_s) : 1.0;
   229	
   230	    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {
   231	        fprintf(stderr, "Error: invalid solver parameters\n");
   232	        return 1;
   233	    }
   234	
   235	    CSRMatrix *A = csr_read_mm(input);
   236	    if (!A) {
   237	        fprintf(stderr, "Error: cannot read sparse matrix from '%s'\n", input);
   238	        return 1;
   239	    }
   240	
   241	    int n;
   242	    double *b = vec_read_mm_array(rhs_file, &n);
   243	    if (!b) {
   244	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
   245	        csr_destroy(A);
   246	        return 1;
   247	    }
   248	
   249	    if (A->rows != n || A->cols != n) {
   250	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
   251	                A->rows, A->cols, n);
   252	        free(b);
   253	        csr_destroy(A);
   254	        return 1;
   255	    }
   256	
   257	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   258	
   259	    free(b);
   260	    csr_destroy(A);
   261	    return rc;
   262	}
   263	
   264	static int cmd_poisson(int argc, char **argv)
   265	{
   266	    const char *nx_s = get_opt(argc, argv, "--nx");
   267	    const char *ny_s = get_opt(argc, argv, "--ny");
   268	    const char *x0_s = get_opt(argc, argv, "--x0");
   269	    const char *x1_s = get_opt(argc, argv, "--x1");
   270	    const char *y0_s = get_opt(argc, argv, "--y0");
   271	    const char *y1_s = get_opt(argc, argv, "--y1");
   272	    const char *source = get_opt(argc, argv, "--source");
   273	    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
   274	    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
   275	    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
   276	    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
   277	    const char *solver = get_opt(argc, argv, "--solver");
   278	    const char *precond = get_opt(argc, argv, "--precond");
   279	    const char *tol_s = get_opt(argc, argv, "--tol");
   280	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   281	    const char *restart_s = get_opt(argc, argv, "--restart");
   282	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   283	    const char *output = get_opt(argc, argv, "--output");
   284	    const char *history = get_opt(argc, argv, "--history");
   285	
   286	    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||
   287	        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
   288	        !solver || !precond || !tol_s || !maxiter_s) {
   289	        fprintf(stderr, "Error: poisson is missing required arguments\n");
   290	        usage("numsim");
   291	        return 1;
   292	    }
   293	
   294	    int nx = atoi(nx_s);
   295	    int ny = atoi(ny_s);
   296	    double x0 = atof(x0_s);
   297	    double x1 = atof(x1_s);
   298	    double y0 = atof(y0_s);
   299	    double y1 = atof(y1_s);
   300	    double tol = atof(tol_s);
   301	    int maxiter = atoi(maxiter_s);
   302	    int restart = restart_s ? atoi(restart_s) : 30;
   303	    double omega = omega_s ? atof(omega_s) : 1.0;
   304	
   305	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {
   306	        fprintf(stderr, "Error: invalid poisson parameters\n");
   307	        return 1;
   308	    }
   309	
   310	    PoissonBC left, right, bottom, top;
   311	    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
   312	        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
   313	        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
   314	        return 1;
   315	    }
   316	
   317	    CSRMatrix *A = NULL;
   318	    double *b = NULL;
   319	    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {
   320	        fprintf(stderr, "Error: cannot assemble Poisson system\n");
   321	        return 1;
   322	    }
   323	
   324	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   325	
   326	    free(b);
   327	    csr_destroy(A);
   328	    return rc;
   329	}
   330	
   331	int main(int argc, char **argv)
   332	{
   333	    if (argc < 2) {
   334	        usage(argv[0]);
   335	        return 1;
   336	    }
   337	
   338	    const char *cmd = argv[1];
   339	
   340	    if (strcmp(cmd, "dense-solve") == 0) {
   341	        return cmd_dense_solve(argc - 2, argv + 2);
   342	    } else if (strcmp(cmd, "sparse-solve") == 0) {
   343	        return cmd_sparse_solve(argc - 2, argv + 2);
   344	    } else if (strcmp(cmd, "poisson") == 0) {
   345	        return cmd_poisson(argc - 2, argv + 2);
   346	    } else if (strcmp(cmd, "--help") == 0 || strcmp(cmd, "-h") == 0) {
   347	        usage(argv[0]);
   348	        return 0;
   349	    } else {
   350	        fprintf(stderr, "Error: unknown command '%s'\n", cmd);
   351	        usage(argv[0]);
   352	        return 1;
   353	    }
   354	}
