    67	static void print_solve_summary(const SolveResult *res)
    68	{
    69	    printf("converged: %s\n", res->converged ? "yes" : "no");
    70	    printf("iterations: %d\n", res->iterations);
    71	    printf("residual: %.6e\n", res->relres);
    72	}
