    59	static const COOMatrix *g_coo_sort_data = NULL;
    60	
    61	static int coo_qsort_cmp(const void *pa, const void *pb)
    62	{
    63	    int ia = *(const int *)pa;
    64	    int ib = *(const int *)pb;
    65	    const COOMatrix *A = g_coo_sort_data;
    66	    if (A->row[ia] != A->row[ib]) return A->row[ia] - A->row[ib];
    67	    return A->col[ia] - A->col[ib];
    68	}
    69	
    70	static COOMatrix *coo_sort_dedup(const COOMatrix *A)
    71	{
    72	    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);
    73	    if (!out) return NULL;
    74	
    75	    int *idx = (int *)malloc((A->nnz > 0 ? A->nnz : 1) * sizeof(int));
    76	    if (!idx) { coo_destroy(out); return NULL; }
    77	    for (int i = 0; i < A->nnz; i++) idx[i] = i;
    78	
    79	    g_coo_sort_data = A;
    80	    qsort(idx, A->nnz, sizeof(int), coo_qsort_cmp);
    81	    g_coo_sort_data = NULL;
    82	
    83	    int k = 0;
    84	    for (int i = 0; i < A->nnz; i++) {
    85	        int src = idx[i];
    86	        if (k > 0 && out->row[k-1] == A->row[src] && out->col[k-1] == A->col[src]) {
    87	            out->values[k-1] += A->values[src];
    88	        } else {
    89	            out->row[k] = A->row[src];
    90	            out->col[k] = A->col[src];
    91	            out->values[k] = A->values[src];
    92	            k++;
    93	        }
    94	    }
    95	    out->nnz = k;
    96	    free(idx);
    97	    return out;
    98	}
    99	
   100	COOMatrix *csr_to_coo(const CSRMatrix *A)
   101	{
   102	    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);
   103	    if (!out) return NULL;
   104	    int k = 0;
   105	    for (int i = 0; i < A->rows; i++) {
   106	        for (int j = A->row_ptr[i]; j < A->row_ptr[i+1]; j++) {
   107	            out->row[k] = i;
   108	            out->col[k] = A->col_indices[j];
   109	            out->values[k] = A->values[j];
   110	            k++;
   111	        }
   112	    }
   113	    out->nnz = k;
   114	    return out;
   115	}
   116	
   117	CSRMatrix *coo_to_csr(const COOMatrix *A)
   118	{
   119	    COOMatrix *sorted = coo_sort_dedup(A);
   120	    if (!sorted) return NULL;
   121	
   122	    CSRMatrix *out = csr_create(sorted->rows, sorted->cols, sorted->nnz);
   123	    if (!out) { coo_destroy(sorted); return NULL; }
   124	
   125	    for (int i = 0; i <= sorted->rows; i++) out->row_ptr[i] = 0;
   126	
   127	    for (int k = 0; k < sorted->nnz; k++) {
   128	        out->row_ptr[sorted->row[k] + 1]++;
   129	    }
   130	    for (int i = 0; i < sorted->rows; i++) {
   131	        out->row_ptr[i+1] += out->row_ptr[i];
   132	    }
   133	
   134	    int *next = (int *)malloc((sorted->rows > 0 ? sorted->rows : 1) * sizeof(int));
   135	    if (!next) { csr_destroy(out); coo_destroy(sorted); return NULL; }
   136	    for (int i = 0; i < sorted->rows; i++) next[i] = out->row_ptr[i];
   137	
   138	    for (int k = 0; k < sorted->nnz; k++) {
   139	        int r = sorted->row[k];
   140	        int pos = next[r]++;
   141	        out->col_indices[pos] = sorted->col[k];
   142	        out->values[pos] = sorted->values[k];
   143	    }
   144	
   145	    free(next);
   146	    coo_destroy(sorted);
   147	    return out;
   148	}
