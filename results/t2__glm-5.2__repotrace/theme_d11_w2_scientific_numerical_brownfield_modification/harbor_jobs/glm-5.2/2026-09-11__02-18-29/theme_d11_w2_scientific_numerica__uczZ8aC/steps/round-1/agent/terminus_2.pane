     7	static SolveResult *result_create(int n, int maxiter)
     8	{
     9	    if (maxiter < 0) maxiter = 0;
    10	    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));
    11	    if (!res) return NULL;
    12	
    13	    res->x = vec_create(n);
    14	    res->history = (double *)malloc((maxiter + 1) * sizeof(double));
    15	    res->precond_history = (double *)malloc((maxiter + 1) * sizeof(double));
    16	    if (!res->x || !res->history || !res->precond_history) {
    17	        free(res->x);
    18	        free(res->history);
    19	        free(res->precond_history);
    20	        free(res);
    21	        return NULL;
    22	    }
    23	    res->history_len = 0;
    24	    return res;
    25	}
    26	
    27	SolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,
    28	                      double tol, int maxiter, Precond *P)
    29	{
    30	    if (!A || !b || A->rows != A->cols) return NULL;
    31	    int n = A->rows;
    32	    if (maxiter < 0) maxiter = 0;
    33	
    34	    SolveResult *res = result_create(n, maxiter);
    35	    if (!res) return NULL;
    36	
    37	    double *r = vec_create(n);
    38	    double *z = vec_create(n);
    39	    double *p = vec_create(n);
    40	    double *Ap = vec_create(n);
    41	    if (!r || !z || !p || !Ap) {
    42	        free(r); free(z); free(p); free(Ap);
    43	        solve_result_destroy(res);
    44	        return NULL;
    45	    }
    46	
    47	    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);
    48	
    49	    csr_spmv(A, res->x, Ap);
    50	    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
