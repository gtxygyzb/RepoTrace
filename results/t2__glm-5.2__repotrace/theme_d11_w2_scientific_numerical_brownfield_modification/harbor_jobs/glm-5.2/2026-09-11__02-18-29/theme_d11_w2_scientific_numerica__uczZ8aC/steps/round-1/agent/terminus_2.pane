   707	int main(int argc, char **argv)
   708	{
   709	    if (argc < 2) {
   710	        usage(argv[0]);
   711	        return 1;
   712	    }
   713	
   714	    const char *cmd = argv[1];
   715	
   716	    if (strcmp(cmd, "dense-solve") == 0) {
   717	        return cmd_dense_solve(argc - 2, argv + 2);
   718	    } else if (strcmp(cmd, "sparse-solve") == 0) {
   719	        return cmd_sparse_solve(argc - 2, argv + 2);
   720	    } else if (strcmp(cmd, "poisson") == 0) {
   721	        return cmd_poisson(argc - 2, argv + 2);
   722	    } else if (strcmp(cmd, "heat") == 0) {
   723	        return cmd_heat(argc - 2, argv + 2);
   724	    } else if (strcmp(cmd, "convdiff") == 0) {
   725	        return cmd_convdiff(argc - 2, argv + 2);
   726	    } else if (strcmp(cmd, "--help") == 0 || strcmp(cmd, "-h") == 0) {
   727	        usage(argv[0]);
   728	        return 0;
   729	    } else if (strcmp(cmd, "matvec") == 0) {
   730	        return cmd_matvec(argc - 2, argv + 2);
   731	    } else if (strcmp(cmd, "matinfo") == 0) {
   732	        return cmd_matinfo(argc - 2, argv + 2);
   733	    } else if (strcmp(cmd, "eigenvalue") == 0) {
   734	        return cmd_eigenvalue(argc - 2, argv + 2);
   735	    } else {
   736	        fprintf(stderr, "Error: unknown command '%s'\n", cmd);
   737	        usage(argv[0]);
   738	        return 1;
   739	    }
   740	}
