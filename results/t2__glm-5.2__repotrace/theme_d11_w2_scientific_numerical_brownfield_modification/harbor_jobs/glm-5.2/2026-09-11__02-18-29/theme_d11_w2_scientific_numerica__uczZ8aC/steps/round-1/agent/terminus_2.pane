     7	static SolveResult *result_create(int n, int maxiter)
     8	{
     9	    if (maxiter < 0) maxiter = 0;
    10	    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));
    11	    if (!res) return NULL;
    12	
    13	    res->x = vec_create(n);
    14	    res->history = (double *)malloc((maxiter + 1) * sizeof(double));
    15	    if (!res->x || !res->history) {
    16	        free(res->x);
    17	        free(res->history);
    18	        free(res);
    19	        return NULL;
    20	    }
    21	    res->history_len = 0;
    22	    return res;
    23	}
    24	
    25	SolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,
    26	                      double tol, int maxiter, Precond *P)
    27	{
    28	    if (!A || !b || A->rows != A->cols) return NULL;
    29	    int n = A->rows;
    30	    if (maxiter < 0) maxiter = 0;
    31	
    32	    SolveResult *res = result_create(n, maxiter);
    33	    if (!res) return NULL;
    34	
    35	    double *r = vec_create(n);
    36	    double *z = vec_create(n);
    37	    double *p = vec_create(n);
    38	    double *Ap = vec_create(n);
    39	    if (!r || !z || !p || !Ap) {
    40	        free(r); free(z); free(p); free(Ap);
    41	        solve_result_destroy(res);
    42	        return NULL;
    43	    }
    44	
    45	    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);
    46	
    47	    csr_spmv(A, res->x, Ap);
    48	    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
    49	
    50	    double bnorm = vec_norm2(b, n);
    51	    if (bnorm == 0.0) bnorm = 1.0;
    52	
    53	    res->true_residual = vec_norm2(r, n);
    54	    res->relres = res->true_residual / bnorm;
    55	    res->history[0] = res->relres;
    56	    res->history_len = 1;
    57	    res->converged = (res->relres < tol) ? 1 : 0;
    58	    res->iterations = 0;
    59	    if (res->converged || maxiter == 0) {
    60	        free(r); free(z); free(p); free(Ap);
    61	        return res;
    62	    }
    63	
    64	    if (precond_apply(P, A, r, z) != 0) {
    65	        free(r); free(z); free(p); free(Ap);
    66	        return res;
    67	    }
    68	    vec_copy(z, p, n);
    69	    double rz_old = vec_dot(r, z, n);
    70	
    71	    for (int iter = 1; iter <= maxiter; iter++) {
    72	        csr_spmv(A, p, Ap);
    73	        double pAp = vec_dot(p, Ap, n);
    74	        if (fabs(pAp) < 1e-30) break;
    75	
    76	        double alpha = rz_old / pAp;
    77	        vec_axpy(alpha, p, res->x, n);
    78	        vec_axpy(-alpha, Ap, r, n);
    79	
    80	        /* Recompute the true residual rather than relying on the recurrence. */
    81	        csr_spmv(A, res->x, Ap);
    82	        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
    83	
    84	        res->true_residual = vec_norm2(r, n);
    85	        res->relres = res->true_residual / bnorm;
    86	        res->history[iter] = res->relres;
    87	        res->history_len = iter + 1;
    88	        res->iterations = iter;
    89	
    90	        if (res->relres < tol) {
    91	            res->converged = 1;
    92	            break;
    93	        }
    94	
    95	        if (precond_apply(P, A, r, z) != 0) break;
    96	        double rz_new = vec_dot(r, z, n);
    97	        if (fabs(rz_old) < 1e-30) break;
    98	        double beta = rz_new / rz_old;
    99	        vec_scale(beta, p, n);
   100	        vec_axpy(1.0, z, p, n);
   101	        rz_old = rz_new;
   102	    }
   103	
   104	    free(r); free(z); free(p); free(Ap);
   105	    return res;
   106	}
