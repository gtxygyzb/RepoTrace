[?2004hroot@n30009:/app# cat include/precond.h
[?2004l#ifndef PRECOND_H
#define PRECOND_H

#include "sparse.h"

typedef enum {
    PRECOND_NONE,
    PRECOND_JACOBI,
    PRECOND_ILU0,
    PRECOND_SSOR
} PrecondType;

typedef struct {
    PrecondType type;
    int n;
    double omega;
    double *diag;       /* Jacobi and SSOR */
    CSRMatrix *lu;      /* ILU(0) factors in one CSR pattern */
    const CSRMatrix *ssor_A;
} Precond;

Precond *precond_create(const CSRMatrix *A, const char *name, double omega);
void     precond_destroy(Precond *P);
int      precond_apply(Precond *P, const CSRMatrix *A, const double *r, double *z);

