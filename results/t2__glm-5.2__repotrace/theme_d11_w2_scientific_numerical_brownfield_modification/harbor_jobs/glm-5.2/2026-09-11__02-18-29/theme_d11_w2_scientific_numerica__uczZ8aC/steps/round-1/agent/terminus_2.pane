   315	    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {
   316	        fprintf(stderr, "Error: cannot assemble Poisson system\n");
   317	        return 1;
   318	    }
   319	
   320	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   321	
   322	    free(b);
   323	    csr_destroy(A);
   324	    return rc;
   325	}
