   398	static int cmd_convdiff(int argc, char **argv)
   399	{
   400	    const char *nx_s = get_opt(argc, argv, "--nx");
   401	    const char *ny_s = get_opt(argc, argv, "--ny");
   402	    const char *x0_s = get_opt(argc, argv, "--x0");
   403	    const char *x1_s = get_opt(argc, argv, "--x1");
   404	    const char *y0_s = get_opt(argc, argv, "--y0");
   405	    const char *y1_s = get_opt(argc, argv, "--y1");
   406	    const char *kappa_s = get_opt(argc, argv, "--kappa");
   407	    const char *vx_s = get_opt(argc, argv, "--vx");
   408	    const char *vy_s = get_opt(argc, argv, "--vy");
   409	    const char *source = get_opt(argc, argv, "--source");
   410	    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
   411	    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
   412	    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
   413	    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
   414	    const char *solver = get_opt(argc, argv, "--solver");
   415	    const char *precond = get_opt(argc, argv, "--precond");
   416	    const char *tol_s = get_opt(argc, argv, "--tol");
   417	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   418	    const char *restart_s = get_opt(argc, argv, "--restart");
   419	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   420	    const char *output = get_opt(argc, argv, "--output");
   421	    const char *history = get_opt(argc, argv, "--history");
   422	
   423	    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !kappa_s ||
   424	        !vx_s || !vy_s || !source ||
   425	        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
   426	        !solver || !precond || !tol_s || !maxiter_s || !output) {
   427	        fprintf(stderr, "Error: convdiff requires grid, domain, kappa, vx, vy, source, boundary conditions, solver, precond, tol, maxiter, output\n");
   428	        usage("numsim");
   429	        return 1;
   430	    }
   431	
   432	    int nx = atoi(nx_s);
   433	    int ny = atoi(ny_s);
   434	    double x0 = atof(x0_s);
   435	    double x1 = atof(x1_s);
   436	    double y0 = atof(y0_s);
   437	    double y1 = atof(y1_s);
   438	    double kappa = atof(kappa_s);
   439	    double vx = atof(vx_s);
   440	    double vy = atof(vy_s);
   441	    double tol = atof(tol_s);
   442	    int maxiter = atoi(maxiter_s);
   443	    int restart = restart_s ? atoi(restart_s) : 30;
   444	    double omega = omega_s ? atof(omega_s) : 1.0;
   445	
   446	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || kappa <= 0.0 ||
   447	        tol <= 0.0 || maxiter < 0 || restart <= 0) {
   448	        fprintf(stderr, "Error: invalid convdiff parameters\n");
   449	        return 1;
   450	    }
   451	    if (validate_ssor_omega(omega) != 0) {
   452	        return 1;
   453	    }
   454	
   455	    PoissonBC left, right, bottom, top;
   456	    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
   457	        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
   458	        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
   459	        return 1;
   460	    }
   461	
   462	    double hx = (x1 - x0) / (nx - 1);
   463	    double hy = (y1 - y0) / (ny - 1);
   464	    double pe = convdiff_peclet(vx, vy, hx, hy, kappa);
   465	    if (pe > 1.0) {
   466	        fprintf(stderr, "warning: cell Peclet number %.6e > 1, solution may exhibit oscillations\n", pe);
   467	    }
   468	
   469	    CSRMatrix *A = NULL;
   470	    double *b = NULL;
   471	    if (convdiff_assemble(nx, ny, x0, x1, y0, y1, kappa, vx, vy,
   472	                          source, left, right, bottom, top, &A, &b) != 0) {
   473	        fprintf(stderr, "Error: cannot assemble convdiff system\n");
   474	        return 1;
   475	    }
   476	
   477	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   478	    printf("peclet: %.6e\n", pe);
   479	
   480	    free(b);
   481	    csr_destroy(A);
   482	    return rc;
   483	}
   484	
   485	int main(int argc, char **argv)
   486	{
   487	    if (argc < 2) {
   488	        usage(argv[0]);
   489	        return 1;
   490	    }
   491	
   492	    const char *cmd = argv[1];
   493	
   494	    if (strcmp(cmd, "dense-solve") == 0) {
   495	        return cmd_dense_solve(argc - 2, argv + 2);
   496	    } else if (strcmp(cmd, "sparse-solve") == 0) {
   497	        return cmd_sparse_solve(argc - 2, argv + 2);
   498	    } else if (strcmp(cmd, "poisson") == 0) {
   499	        return cmd_poisson(argc - 2, argv + 2);
   500	    } else if (strcmp(cmd, "heat") == 0) {
   501	        return cmd_heat(argc - 2, argv + 2);
   502	    } else if (strcmp(cmd, "convdiff") == 0) {
   503	        return cmd_convdiff(argc - 2, argv + 2);
   504	    } else if (strcmp(cmd, "--help") == 0 || strcmp(cmd, "-h") == 0) {
   505	        usage(argv[0]);
   506	        return 0;
   507	    } else {
   508	        fprintf(stderr, "Error: unknown command '%s'\n", cmd);
   509	        usage(argv[0]);
   510	        return 1;
   511	    }
   512	}
