    28	static int write_history_file(const SolveResult *res, const char *filename)
    29	{
    30	    FILE *fp = fopen(filename, "w");
    31	    if (!fp) return -1;
    32	    for (int i = 0; i < res->history_len; i++) {
    33	        fprintf(fp, "%.15e\n", res->history[i]);
    34	    }
    35	    fclose(fp);
    36	    return 0;
    37	}
