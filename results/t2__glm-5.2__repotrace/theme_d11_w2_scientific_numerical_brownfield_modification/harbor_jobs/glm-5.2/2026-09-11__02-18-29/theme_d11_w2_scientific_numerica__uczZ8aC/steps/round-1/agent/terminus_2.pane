   373	    int maxiter = atoi(maxiter_s);
   374	    int restart = restart_s ? atoi(restart_s) : 30;
   375	    double omega = omega_s ? atof(omega_s) : 1.0;
   376	
   377	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || alpha <= 0.0 ||
   378	        dt <= 0.0 || nsteps < 0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {
   379	        fprintf(stderr, "Error: invalid heat parameters\n");
   380	        return 1;
   381	    }
   382	    if (validate_ssor_omega(omega) != 0) {
   383	        return 1;
   384	    }
   385	
   386	    PoissonBC left, right, bottom, top;
   387	    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
   388	        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
   389	        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
   390	        return 1;
   391	    }
   392	
   393	    int rc = heat_solve(nx, ny, x0, x1, y0, y1, alpha, dt, nsteps, scheme,
   394	                       ic_file, source_arg, left, right, bottom, top,
   395	                       solver, precond, tol, maxiter, restart, omega, output);
   396	    if (rc != 0) {
   397	        fprintf(stderr, "Error: heat solve failed\n");
   398	        return 1;
   399	    }
   400	    return 0;
   401	}
