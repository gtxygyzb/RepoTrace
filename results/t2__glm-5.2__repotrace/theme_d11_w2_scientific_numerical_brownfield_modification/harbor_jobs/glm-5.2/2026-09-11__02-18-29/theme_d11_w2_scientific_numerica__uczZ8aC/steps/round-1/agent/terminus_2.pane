   130	static int parse_bc(const char *s, PoissonBC *bc)
   131	{
   132	    const char *colon = strchr(s, ':');
   133	    if (!colon || colon == s) return -1;
   134	
   135	    size_t len = colon - s;
   136	    char type[32];
   137	    if (len >= sizeof(type)) return -1;
   138	    memcpy(type, s, len);
   139	    type[len] = '\0';
   140	
   141	    if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
   142	    else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
   143	    else return -1;
   144	
   145	    bc->file = colon + 1;
   146	    return 0;
   147	}
   148	
   149	static int run_solver_and_print(const CSRMatrix *A, const double *b,
   150	                                const char *solver, const char *precond,
   151	                                double tol, int maxiter, int restart,
   152	                                double omega, const char *output,
   153	                                const char *history)
   154	{
   155	    Precond *P = precond_create(A, precond, omega);
   156	    if (!P) {
   157	        fprintf(stderr, "Error: cannot create preconditioner '%s'\n", precond);
   158	        return 1;
   159	    }
   160	
   161	    SolveResult *res = NULL;
   162	    if (strcmp(solver, "cg") == 0) {
   163	        res = cg_solve(A, b, NULL, tol, maxiter, P);
   164	    } else if (strcmp(solver, "gmres") == 0) {
   165	        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);
   166	    } else {
   167	        fprintf(stderr, "Error: unknown solver '%s'\n", solver);
   168	        precond_destroy(P);
   169	        return 1;
   170	    }
   171	
   172	    if (!res) {
   173	        fprintf(stderr, "Error: solver allocation failed\n");
   174	        precond_destroy(P);
   175	        return 1;
   176	    }
   177	
   178	    print_solve_summary(res);
   179	
   180	    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {
   181	        fprintf(stderr, "Error: cannot write output to '%s'\n", output);
   182	    }
   183	    if (history && write_history_file(res, history) != 0) {
   184	        fprintf(stderr, "Error: cannot write history to '%s'\n", history);
   185	    }
   186	
   187	    solve_result_destroy(res);
   188	    precond_destroy(P);
   189	    return 0;
   190	}
