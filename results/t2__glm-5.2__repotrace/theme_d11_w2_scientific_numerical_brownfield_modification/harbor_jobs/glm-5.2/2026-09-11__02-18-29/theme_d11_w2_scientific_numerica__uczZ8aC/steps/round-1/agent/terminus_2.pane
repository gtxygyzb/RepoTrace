    62	        return 1;
    63	    }
    64	
    65	    const char *mat_file = argv[0];
    66	    const char *rhs_file = argv[1];
    67	    const char *out_file = (argc >= 3) ? argv[2] : NULL;
    68	
    69	    DenseMatrix *A = dm_read_text(mat_file);
