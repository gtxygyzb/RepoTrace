   292	    double y0 = atof(y0_s);
   293	    double y1 = atof(y1_s);
   294	    double tol = atof(tol_s);
   295	    int maxiter = atoi(maxiter_s);
   296	    int restart = restart_s ? atoi(restart_s) : 30;
   297	    double omega = omega_s ? atof(omega_s) : 1.0;
   298	
   299	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {
   300	        fprintf(stderr, "Error: invalid poisson parameters\n");
   301	        return 1;
   302	    }
   303	    if (validate_ssor_omega(omega) != 0) {
   304	        return 1;
   305	    }
   306	
   307	    PoissonBC left, right, bottom, top;
   308	    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
   309	        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
   310	        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
   311	        return 1;
   312	    }
   313	
   314	    CSRMatrix *A = NULL;
   315	    double *b = NULL;
   316	    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {
   317	        fprintf(stderr, "Error: cannot assemble Poisson system\n");
   318	        return 1;
   319	    }
   320	
   321	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   322	
   323	    free(b);
   324	    csr_destroy(A);
   325	    return rc;
   326	}
