     7	static SolveResult *result_create(int n, int maxiter)
     8	{
     9	    if (maxiter < 0) maxiter = 0;
    10	    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));
    11	    if (!res) return NULL;
    12	
    13	    res->x = vec_create(n);
    14	    res->history = (double *)malloc((maxiter + 1) * sizeof(double));
    15	    res->precond_history = (double *)malloc((maxiter + 1) * sizeof(double));
    16	    if (!res->x || !res->history || !res->precond_history) {
    17	        free(res->x);
    18	        free(res->history);
    19	        free(res->precond_history);
    20	        free(res);
    21	        return NULL;
    22	    }
    23	    res->history_len = 0;
    24	    return res;
    25	}
    26	
    27	SolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,
    28	                      double tol, int maxiter, Precond *P)
    29	{
    30	    if (!A || !b || A->rows != A->cols) return NULL;
    31	    int n = A->rows;
    32	    if (maxiter < 0) maxiter = 0;
    33	
    34	    SolveResult *res = result_create(n, maxiter);
    35	    if (!res) return NULL;
    36	
    37	    double *r = vec_create(n);
    38	    double *z = vec_create(n);
    39	    double *p = vec_create(n);
    40	    double *Ap = vec_create(n);
    41	    if (!r || !z || !p || !Ap) {
    42	        free(r); free(z); free(p); free(Ap);
    43	        solve_result_destroy(res);
    44	        return NULL;
    45	    }
    46	
    47	    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);
    48	
    49	    csr_spmv(A, res->x, Ap);
    50	    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
    51	
    52	    double bnorm = vec_norm2(b, n);
    53	    if (bnorm == 0.0) bnorm = 1.0;
    54	
    55	    res->true_residual = vec_norm2(r, n);
    56	    res->relres = res->true_residual / bnorm;
    57	    precond_apply(P, A, r, z);
    58	    double pnorm0 = vec_norm2(z, n);
    59	    res->history[0] = res->relres;
    60	    res->precond_history[0] = pnorm0;
    61	    res->history_len = 1;
    62	    res->converged = (res->relres < tol) ? 1 : 0;
    63	    res->iterations = 0;
    64	    if (res->converged || maxiter == 0) {
    65	        free(r); free(z); free(p); free(Ap);
    66	        return res;
    67	    }
    68	
    69	    if (precond_apply(P, A, r, z) != 0) {
    70	        free(r); free(z); free(p); free(Ap);
    71	        return res;
    72	    }
    73	    vec_copy(z, p, n);
    74	    double rz_old = vec_dot(r, z, n);
    75	
    76	    for (int iter = 1; iter <= maxiter; iter++) {
    77	        csr_spmv(A, p, Ap);
    78	        double pAp = vec_dot(p, Ap, n);
    79	        if (fabs(pAp) < 1e-30) break;
    80	
    81	        double alpha = rz_old / pAp;
    82	        vec_axpy(alpha, p, res->x, n);
    83	        vec_axpy(-alpha, Ap, r, n);
    84	
    85	        /* Recompute the true residual rather than relying on the recurrence. */
    86	        csr_spmv(A, res->x, Ap);
    87	        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
    88	
    89	        res->true_residual = vec_norm2(r, n);
    90	        res->relres = res->true_residual / bnorm;
    91	        precond_apply(P, A, r, z);
    92	        double pznorm = vec_norm2(z, n);
    93	        res->history[iter] = res->relres;
    94	        res->precond_history[iter] = pznorm;
    95	        res->history_len = iter + 1;
    96	        res->iterations = iter;
    97	
    98	        if (res->relres < tol) {
    99	            res->converged = 1;
   100	            break;
   101	        }
   102	
   103	        if (precond_apply(P, A, r, z) != 0) break;
   104	        double rz_new = vec_dot(r, z, n);
   105	        if (fabs(rz_old) < 1e-30) break;
   106	        double beta = rz_new / rz_old;
   107	        vec_scale(beta, p, n);
   108	        vec_axpy(1.0, z, p, n);
   109	        rz_old = rz_new;
   110	    }
   111	
   112	    free(r); free(z); free(p); free(Ap);
   113	    return res;
   114	}
   115	
   116	static void apply_givens(double *a, double *b, double c, double s)
   117	{
   118	    double t = c * (*a) + s * (*b);
   119	    *b = -s * (*a) + c * (*b);
   120	    *a = t;
   121	}
   122	
   123	static int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)
   124	{
   125	    if (kdim <= 0) return -1;
   126	
   127	    double *c = (double *)malloc(m * sizeof(double));
   128	    double *s = (double *)malloc(m * sizeof(double));
   129	    if (!c || !s) { free(c); free(s); return -1; }
   130	
   131	    for (int i = 0; i < kdim; i++) {
   132	        for (int k = 0; k < i; k++) {
   133	            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);
   134	        }
   135	
   136	        double a = H[i*m+i];
   137	        double b = H[(i+1)*m+i];
   138	        if (b == 0.0) {
   139	            c[i] = 1.0;
   140	            s[i] = 0.0;
   141	        } else {
   142	            double r = hypot(a, b);
   143	            c[i] = a / r;
   144	            s[i] = b / r;
   145	        }
   146	        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);
   147	        apply_givens(&g[i], &g[i+1], c[i], s[i]);
   148	
   149	    }
   150	
   151	    for (int i = kdim - 1; i >= 0; i--) {
   152	        double sum = g[i];
   153	        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];
   154	        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }
   155	        y[i] = sum / H[i*m+i];
   156	    }
   157	
   158	    free(c);
   159	    free(s);
   160	    return 0;
   161	}
   162	
   163	SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,
   164	                           double tol, int maxiter, int m, Precond *P)
   165	{
   166	    if (!A || !b || A->rows != A->cols) return NULL;
   167	    int n = A->rows;
   168	    if (m <= 0) m = 30;
   169	    if (maxiter < 0) maxiter = 0;
   170	
   171	    SolveResult *res = result_create(n, maxiter);
   172	    if (!res) return NULL;
   173	
   174	    double *r = vec_create(n);
   175	    double *z = vec_create(n);
   176	    double *Ap = vec_create(n);
   177	    double *Av = vec_create(n);
   178	    double *w = vec_create(n);
   179	    double *g = (double *)malloc((m + 1) * sizeof(double));
   180	    double *y = (double *)malloc(m * sizeof(double));
   181	    double *H = (double *)calloc((m + 1) * m, sizeof(double));
   182	    double *V = (double *)malloc(n * (m + 1) * sizeof(double));
   183	
   184	    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {
   185	        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   186	        solve_result_destroy(res);
   187	        return NULL;
   188	    }
   189	
   190	    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);
   191	
   192	    csr_spmv(A, res->x, Ap);
   193	    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
   194	
   195	    double bnorm = vec_norm2(b, n);
   196	    if (bnorm == 0.0) bnorm = 1.0;
   197	
   198	    res->true_residual = vec_norm2(r, n);
   199	    res->relres = res->true_residual / bnorm;
   200	    precond_apply(P, A, r, z);
   201	    double pnorm0 = vec_norm2(z, n);
   202	    res->history[0] = res->relres;
   203	    res->precond_history[0] = pnorm0;
   204	    res->history_len = 1;
   205	    res->converged = (res->relres < tol) ? 1 : 0;
   206	    res->iterations = 0;
   207	    if (res->converged || maxiter == 0) {
   208	        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   209	        return res;
   210	    }
   211	
   212	    for (int cycle = 1; cycle <= maxiter; cycle++) {
   213	        if (precond_apply(P, A, r, z) != 0) break;
   214	        double beta = vec_norm2(z, n);
   215	        if (beta == 0.0) break;
   216	
   217	        for (int i = 0; i < n; i++) V[i] = z[i] / beta;
   218	        for (int i = 0; i <= m; i++) g[i] = 0.0;
   219	        g[0] = beta;
   220	        memset(H, 0, (m + 1) * m * sizeof(double));
   221	
   222	        int kdim = 0;
   223	        int fail = 0;
   224	        for (int j = 0; j < m; j++) {
   225	            csr_spmv(A, V + j * n, Av);
   226	            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }
   227	
   228	            for (int i = 0; i <= j; i++) {
   229	                double h = vec_dot(w, V + i * n, n);
   230	                H[i*m+j] = h;
   231	                vec_axpy(-h, V + i * n, w, n);
   232	            }
   233	
   234	            double hnorm = vec_norm2(w, n);
   235	            H[(j+1)*m+j] = hnorm;
   236	            kdim = j + 1;
   237	
   238	            if (hnorm < 1e-14) break;
   239	
   240	            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;
   241	        }
   242	        if (fail) break;
   243	        if (kdim == 0) break;
   244	
   245	        for (int i = 0; i < kdim; i++) y[i] = 0.0;
   246	        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;
   247	
   248	        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);
   249	
   250	        csr_spmv(A, res->x, Ap);
   251	        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
   252	
   253	        res->true_residual = vec_norm2(r, n);
   254	        res->relres = res->true_residual / bnorm;
   255	        precond_apply(P, A, r, z);
   256	        double pznorm = vec_norm2(z, n);
   257	        res->history[cycle] = res->relres;
   258	        res->precond_history[cycle] = pznorm;
   259	        res->history_len = cycle + 1;
   260	        res->iterations = cycle;
   261	
   262	        if (res->relres < tol) {
   263	            res->converged = 1;
   264	            break;
   265	        }
   266	    }
   267	
   268	    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   269	    return res;
   270	}
   271	
   272	void solve_result_destroy(SolveResult *res)
   273	{
   274	    if (!res) return;
   275	    free(res->x);
   276	    free(res->history);
   277	    free(res->precond_history);
   278	    free(res);
   279	}
