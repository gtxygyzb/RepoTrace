   134	static int parse_bc(const char *s, PoissonBC *bc)
   135	{
   136	    const char *colon = strchr(s, ':');
   137	    if (!colon || colon == s) return -1;
   138	
   139	    size_t len = colon - s;
   140	    char type[32];
   141	    if (len >= sizeof(type)) return -1;
   142	    memcpy(type, s, len);
   143	    type[len] = '\0';
   144	
   145	    if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
   146	    else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
   147	    else return -1;
   148	
   149	    bc->file = colon + 1;
   150	    return 0;
   151	}
   152	
   153	static int run_solver_and_print(const CSRMatrix *A, const double *b,
   154	                                const char *solver, const char *precond,
   155	                                double tol, int maxiter, int restart,
   156	                                double omega, const char *output,
   157	                                const char *history)
   158	{
   159	    Precond *P = precond_create(A, precond, omega);
   160	    if (!P) {
   161	        fprintf(stderr, "Error: cannot create preconditioner '%s'\n", precond);
   162	        return 1;
   163	    }
   164	
   165	    SolveResult *res = NULL;
   166	    if (strcmp(solver, "cg") == 0) {
   167	        res = cg_solve(A, b, NULL, tol, maxiter, P);
   168	    } else if (strcmp(solver, "gmres") == 0) {
   169	        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);
   170	    } else {
   171	        fprintf(stderr, "Error: unknown solver '%s'\n", solver);
   172	        precond_destroy(P);
   173	        return 1;
   174	    }
   175	
   176	    if (!res) {
   177	        fprintf(stderr, "Error: solver allocation failed\n");
   178	        precond_destroy(P);
   179	        return 1;
   180	    }
   181	
   182	    print_solve_summary(res);
   183	
   184	    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {
   185	        fprintf(stderr, "Error: cannot write output to '%s'\n", output);
   186	    }
   187	    if (history && write_history_file(res, history) != 0) {
   188	        fprintf(stderr, "Error: cannot write history to '%s'\n", history);
   189	    }
   190	
   191	    solve_result_destroy(res);
   192	    precond_destroy(P);
   193	    return 0;
   194	}
