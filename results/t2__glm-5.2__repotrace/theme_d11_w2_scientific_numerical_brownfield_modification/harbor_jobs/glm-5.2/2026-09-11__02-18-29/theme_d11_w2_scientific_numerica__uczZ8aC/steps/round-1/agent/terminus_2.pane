[?2004hroot@n30009:/app# sed -n '1,260p' src/solvers.c
[?2004l#include "solvers.h"
#include "vector.h"
#include <stdlib.h>
#include <math.h>
#include <string.h>

static SolveResult *result_create(int n, int maxiter)
{
    if (maxiter < 0) maxiter = 0;
    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));
    if (!res) return NULL;

    res->x = vec_create(n);
    res->history = (double *)malloc((maxiter + 1) * sizeof(double));
    if (!res->x || !res->history) {
        free(res->x);
        free(res->history);
        free(res);
        return NULL;
    }
    res->history_len = 0;
    return res;
}

SolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,
                      double tol, int maxiter, Precond *P)
{
    if (!A || !b || A->rows != A->cols) return NULL;
    int n = A->rows;
    if (maxiter < 0) maxiter = 0;

    SolveResult *res = result_create(n, maxiter);
    if (!res) return NULL;

    double *r = vec_create(n);
    double *z = vec_create(n);
    double *p = vec_create(n);
    double *Ap = vec_create(n);
    if (!r || !z || !p || !Ap) {
        free(r); free(z); free(p); free(Ap);
        solve_result_destroy(res);
        return NULL;
    }

    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);

    csr_spmv(A, res->x, Ap);
    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];

    double bnorm = vec_norm2(b, n);
    if (bnorm == 0.0) bnorm = 1.0;

    res->relres = vec_norm2(r, n) / bnorm;
    res->history[0] = res->relres;
    res->history_len = 1;
    res->converged = (res->relres < tol) ? 1 : 0;
    res->iterations = 0;
    if (res->converged || maxiter == 0) {
        free(r); free(z); free(p); free(Ap);
        return res;
    }

    if (precond_apply(P, A, r, z) != 0) {
        free(r); free(z); free(p); free(Ap);
        return res;
    }
    vec_copy(z, p, n);
    double rz_old = vec_dot(r, z, n);

    for (int iter = 1; iter <= maxiter; iter++) {
        csr_spmv(A, p, Ap);
        double pAp = vec_dot(p, Ap, n);
        if (fabs(pAp) < 1e-30) break;

        double alpha = rz_old / pAp;
        vec_axpy(alpha, p, res->x, n);
        vec_axpy(-alpha, Ap, r, n);

        res->relres = vec_norm2(r, n) / bnorm;
        res->history[iter] = res->relres;
        res->history_len = iter + 1;
        res->iterations = iter;

        if (res->relres < tol) {
            res->converged = 1;
            break;
        }

        if (precond_apply(P, A, r, z) != 0) break;
        double rz_new = vec_dot(r, z, n);
        if (fabs(rz_old) < 1e-30) break;
        double beta = rz_new / rz_old;
        vec_scale(beta, p, n);
        vec_axpy(1.0, z, p, n);
        rz_old = rz_new;
    }

    free(r); free(z); free(p); free(Ap);
    return res;
}

static void apply_givens(double *a, double *b, double c, double s)
{
    double t = c * (*a) + s * (*b);
    *b = -s * (*a) + c * (*b);
    *a = t;
}

static int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)
{
    if (kdim <= 0) return -1;

    double *c = (double *)malloc(m * sizeof(double));
    double *s = (double *)malloc(m * sizeof(double));
    if (!c || !s) { free(c); free(s); return -1; }

    for (int i = 0; i < kdim; i++) {
        for (int k = 0; k < i; k++) {
            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);
        }

        double a = H[i*m+i];
        double b = H[(i+1)*m+i];
        if (b == 0.0) {
            c[i] = 1.0;
            s[i] = 0.0;
        } else {
            double r = hypot(a, b);
            c[i] = a / r;
            s[i] = b / r;
        }
        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);
        apply_givens(&g[i], &g[i+1], c[i], s[i]);

    }

    for (int i = kdim - 1; i >= 0; i--) {
        double sum = g[i];
        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];
        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }
        y[i] = sum / H[i*m+i];
    }

    free(c);
    free(s);
    return 0;
}

SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,
                         double tol, int maxiter, int m, Precond *P)
{
    if (!A || !b || A->rows != A->cols) return NULL;
    int n = A->rows;
    if (m <= 0) m = 30;
    if (maxiter < 0) maxiter = 0;

    SolveResult *res = result_create(n, maxiter);
    if (!res) return NULL;

    double *r = vec_create(n);
    double *z = vec_create(n);
    double *Ap = vec_create(n);
    double *Av = vec_create(n);
    double *w = vec_create(n);
    double *g = (double *)malloc((m + 1) * sizeof(double));
    double *y = (double *)malloc(m * sizeof(double));
    double *H = (double *)calloc((m + 1) * m, sizeof(double));
    double *V = (double *)malloc(n * (m + 1) * sizeof(double));

    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {
        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
        solve_result_destroy(res);
        return NULL;
    }

    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);

    csr_spmv(A, res->x, Ap);
    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];

    double bnorm = vec_norm2(b, n);
    if (bnorm == 0.0) bnorm = 1.0;

    res->relres = vec_norm2(r, n) / bnorm;
    res->history[0] = res->relres;
    res->history_len = 1;
    res->converged = (res->relres < tol) ? 1 : 0;
    res->iterations = 0;
    if (res->converged || maxiter == 0) {
        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
        return res;
    }

    for (int cycle = 1; cycle <= maxiter; cycle++) {
        if (precond_apply(P, A, r, z) != 0) break;
        double beta = vec_norm2(z, n);
        if (beta == 0.0) break;

        for (int i = 0; i < n; i++) V[i] = z[i] / beta;
        for (int i = 0; i <= m; i++) g[i] = 0.0;
        g[0] = beta;
        memset(H, 0, (m + 1) * m * sizeof(double));

        int kdim = 0;
        int fail = 0;
        for (int j = 0; j < m; j++) {
            csr_spmv(A, V + j * n, Av);
            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }

            for (int i = 0; i <= j; i++) {
                double h = vec_dot(w, V + i * n, n);
                H[i*m+j] = h;
                vec_axpy(-h, V + i * n, w, n);
            }

            double hnorm = vec_norm2(w, n);
            H[(j+1)*m+j] = hnorm;
            kdim = j + 1;

            if (hnorm < 1e-14) break;

            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;
        }
        if (fail) break;
        if (kdim == 0) break;

        for (int i = 0; i < kdim; i++) y[i] = 0.0;
        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;

        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);

        csr_spmv(A, res->x, Ap);
        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];

        res->relres = vec_norm2(r, n) / bnorm;
        res->history[cycle] = res->relres;
        res->history_len = cycle + 1;
        res->iterations = cycle;

        if (res->relres < tol) {
            res->converged = 1;
            break;
        }
    }

    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
    return res;
}

void solve_result_destroy(SolveResult *res)
{
    if (!res) return;
    free(res->x);
    free(res->history);
    free(res);
}
[?2004hroot@n30009:/app# sed -n '1,260p' include/poisson.h
[?2004l#ifndef POISSON_H
#define POISSON_H

#include "sparse.h"

typedef enum {
    POISSON_DIRICHLET,
    POISSON_NEUMANN
} PoissonBCType;

typedef struct {
    PoissonBCType type;
    const char *file;
} PoissonBC;

int poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,
                    const char *source_file, PoissonBC left, PoissonBC right,
                    PoissonBC bottom, PoissonBC top,
                    CSRMatrix **A_out, double **b_out);

double *poisson_read_source(const char *filename, int nx, int ny);
double *poisson_read_boundary(const char *filename, int expected);

#endif /* POISSON_H */
[?2004hroot@n30009:/app# sed -n '1,320p' src/poisson.c
[?2004l#include "poisson.h"
#include "vector.h"
#include <stdlib.h>
#include <string.h>
#include <math.h>

double *poisson_read_source(const char *filename, int nx, int ny)
{
    FILE *fp = fopen(filename, "r");
    if (!fp) return NULL;

    int rx, ry;
    if (fscanf(fp, "%d %d", &rx, &ry) != 2 || rx != nx || ry != ny) {
        fclose(fp);
        return NULL;
    }

    int n = nx * ny;
    double *f = vec_create(n);
    if (!f) { fclose(fp); return NULL; }

    for (int i = 0; i < n; i++) {
        if (fscanf(fp, "%lf", &f[i]) != 1) {
            free(f);
            fclose(fp);
            return NULL;
        }
    }

    fclose(fp);
    return f;
}

double *poisson_read_boundary(const char *filename, int expected)
{
    FILE *fp = fopen(filename, "r");
    if (!fp) return NULL;

    double *vals = (double *)malloc(expected * sizeof(double));
    if (!vals) { fclose(fp); return NULL; }

    int count = 0;
    while (count < expected) {
        double v;
        if (fscanf(fp, "%lf", &v) != 1) break;
        vals[count++] = v;
    }

    fclose(fp);
    if (count != expected) { free(vals); return NULL; }
    return vals;
}

static void add_coo(COOMatrix *coo, int *k, int r, int c, double v)
{
    coo->row[*k] = r;
    coo->col[*k] = c;
    coo->values[*k] = v;
    (*k)++;
}

int poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,
                    const char *source_file, PoissonBC left, PoissonBC right,
                    PoissonBC bottom, PoissonBC top,
                    CSRMatrix **A_out, double **b_out)
{
    if (!A_out || !b_out) return -1;
    *A_out = NULL;
    *b_out = NULL;

    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || !source_file) return -1;

    double hx = (x1 - x0) / (nx - 1);
    double hy = (y1 - y0) / (ny - 1);
    double hx2 = hx * hx;
    double hy2 = hy * hy;

    double *f = poisson_read_source(source_file, nx, ny);
    if (!f) return -1;

    double *left_vals = NULL;
    double *right_vals = NULL;
    double *bottom_vals = NULL;
    double *top_vals = NULL;

    if (left.type == POISSON_NEUMANN) { left_vals = poisson_read_boundary(left.file, ny); if (!left_vals) goto fail; }
    if (right.type == POISSON_NEUMANN) { right_vals = poisson_read_boundary(right.file, ny); if (!right_vals) goto fail; }
    if (bottom.type == POISSON_NEUMANN) { bottom_vals = poisson_read_boundary(bottom.file, nx); if (!bottom_vals) goto fail; }
    if (top.type == POISSON_NEUMANN) { top_vals = poisson_read_boundary(top.file, nx); if (!top_vals) goto fail; }

    if (left.type == POISSON_DIRICHLET) { left_vals = poisson_read_boundary(left.file, ny); if (!left_vals) goto fail; }
    if (right.type == POISSON_DIRICHLET) { right_vals = poisson_read_boundary(right.file, ny); if (!right_vals) goto fail; }
    if (bottom.type == POISSON_DIRICHLET) { bottom_vals = poisson_read_boundary(bottom.file, nx); if (!bottom_vals) goto fail; }
    if (top.type == POISSON_DIRICHLET) { top_vals = poisson_read_boundary(top.file, nx); if (!top_vals) goto fail; }

    int n = nx * ny;
    COOMatrix *coo = coo_create(n, n, 5 * n);
    double *b = vec_create(n);
    if (!coo || !b) { coo_destroy(coo); free(b); goto fail; }

    int k = 0;
    for (int i = 0; i < nx; i++) {
        for (int j = 0; j < ny; j++) {
            int idx = i * ny + j;
            int is_left = (i == 0);
            int is_right = (i == nx - 1);
            int is_bottom = (j == 0);
            int is_top = (j == ny - 1);

            if (is_left && left.type == POISSON_DIRICHLET) {
                add_coo(coo, &k, idx, idx, 1.0);
                b[idx] = left_vals[j];
                continue;
            }
            if (is_right && right.type == POISSON_DIRICHLET) {
                add_coo(coo, &k, idx, idx, 1.0);
                b[idx] = right_vals[j];
                continue;
            }
            if (is_bottom && bottom.type == POISSON_DIRICHLET) {
                add_coo(coo, &k, idx, idx, 1.0);
                b[idx] = bottom_vals[i];
                continue;
            }
            if (is_top && top.type == POISSON_DIRICHLET) {
                add_coo(coo, &k, idx, idx, 1.0);
                b[idx] = top_vals[i];
                continue;
            }

            double diag = 0.0;
            double rhs = f[idx];
            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;

            if (is_left && left.type == POISSON_NEUMANN) {
                diag += 2.0 / hx2;
                c_ip = -2.0 / hx2;
                rhs += 2.0 * left_vals[j] / hx;
            } else if (is_right && right.type == POISSON_NEUMANN) {
                diag += 2.0 / hx2;
                c_im = -2.0 / hx2;
                rhs += 2.0 * right_vals[j] / hx;
            } else if (!is_left && !is_right) {
                diag += 2.0 / hx2;
                c_im = -1.0 / hx2;
                c_ip = -1.0 / hx2;
            }

            if (is_bottom && bottom.type == POISSON_NEUMANN) {
                diag += 2.0 / hy2;
                c_jp = -2.0 / hy2;
                rhs += 2.0 * bottom_vals[i] / hy;
            } else if (is_top && top.type == POISSON_NEUMANN) {
                diag += 2.0 / hy2;
                c_jm = -2.0 / hy2;
                rhs += 2.0 * top_vals[i] / hy;
            } else if (!is_bottom && !is_top) {
                diag += 2.0 / hy2;
                c_jm = -1.0 / hy2;
                c_jp = -1.0 / hy2;
            }

            add_coo(coo, &k, idx, idx, diag);
            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);
            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);
            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);
            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);
            b[idx] = rhs;
        }
    }

    coo->nnz = k;
    CSRMatrix *A = coo_to_csr(coo);
    coo_destroy(coo);
    if (!A) { free(b); goto fail; }

    free(f);
    free(left_vals);
    free(right_vals);
    free(bottom_vals);
    free(top_vals);

    *A_out = A;
    *b_out = b;
    return 0;

fail:
    free(f);
    free(left_vals);
    free(right_vals);
    free(bottom_vals);
    free(top_vals);
    return -1;
}
