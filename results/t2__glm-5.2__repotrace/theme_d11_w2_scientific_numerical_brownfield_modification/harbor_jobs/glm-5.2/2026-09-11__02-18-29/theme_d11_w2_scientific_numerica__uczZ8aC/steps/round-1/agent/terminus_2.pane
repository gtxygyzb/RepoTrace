   159	SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,
   160	                           double tol, int maxiter, int m, Precond *P)
   161	{
   162	    if (!A || !b || A->rows != A->cols) return NULL;
   163	    int n = A->rows;
   164	    if (m <= 0) m = 30;
   165	    if (maxiter < 0) maxiter = 0;
   166	
   167	    SolveResult *res = result_create(n, maxiter);
   168	    if (!res) return NULL;
   169	
   170	    double *r = vec_create(n);
   171	    double *z = vec_create(n);
   172	    double *Ap = vec_create(n);
   173	    double *Av = vec_create(n);
   174	    double *w = vec_create(n);
   175	    double *g = (double *)malloc((m + 1) * sizeof(double));
   176	    double *y = (double *)malloc(m * sizeof(double));
   177	    double *H = (double *)calloc((m + 1) * m, sizeof(double));
   178	    double *V = (double *)malloc(n * (m + 1) * sizeof(double));
   179	
   180	    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {
   181	        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   182	        solve_result_destroy(res);
   183	        return NULL;
   184	    }
   185	
   186	    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);
   187	
   188	    csr_spmv(A, res->x, Ap);
   189	    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
   190	
   191	    double bnorm = vec_norm2(b, n);
   192	    if (bnorm == 0.0) bnorm = 1.0;
   193	
   194	    res->true_residual = vec_norm2(r, n);
   195	    res->relres = res->true_residual / bnorm;
   196	    res->history[0] = res->relres;
   197	    res->precond_history[0] = res->true_residual;
   198	    res->history_len = 1;
   199	    res->converged = (res->relres < tol) ? 1 : 0;
   200	    res->iterations = 0;
   201	    if (res->converged || maxiter == 0) {
   202	        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   203	        return res;
   204	    }
   205	
   206	    for (int cycle = 1; cycle <= maxiter; cycle++) {
   207	        if (precond_apply(P, A, r, z) != 0) break;
   208	        double beta = vec_norm2(z, n);
   209	        if (beta == 0.0) break;
   210	
   211	        for (int i = 0; i < n; i++) V[i] = z[i] / beta;
   212	        for (int i = 0; i <= m; i++) g[i] = 0.0;
   213	        g[0] = beta;
   214	        memset(H, 0, (m + 1) * m * sizeof(double));
   215	
   216	        int kdim = 0;
   217	        int fail = 0;
   218	        for (int j = 0; j < m; j++) {
   219	            csr_spmv(A, V + j * n, Av);
   220	            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }
   221	
   222	            for (int i = 0; i <= j; i++) {
   223	                double h = vec_dot(w, V + i * n, n);
   224	                H[i*m+j] = h;
   225	                vec_axpy(-h, V + i * n, w, n);
   226	            }
   227	
   228	            double hnorm = vec_norm2(w, n);
   229	            H[(j+1)*m+j] = hnorm;
   230	            kdim = j + 1;
   231	
   232	            if (hnorm < 1e-14) break;
   233	
   234	            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;
   235	        }
   236	        if (fail) break;
   237	        if (kdim == 0) break;
   238	
   239	        for (int i = 0; i < kdim; i++) y[i] = 0.0;
   240	        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;
   241	
   242	        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);
   243	
   244	        csr_spmv(A, res->x, Ap);
   245	        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
   246	
   247	        res->true_residual = vec_norm2(r, n);
   248	        res->relres = res->true_residual / bnorm;
   249	        res->history[cycle] = res->relres;
   250	        res->precond_history[cycle] = pznorm;
   251	        res->history_len = cycle + 1;
   252	        res->iterations = cycle;
   253	
   254	        if (res->relres < tol) {
   255	            res->converged = 1;
   256	            break;
   257	        }
   258	    }
   259	
   260	    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   261	    return res;
   262	}
   263	
   264	void solve_result_destroy(SolveResult *res)
   265	{
   266	    if (!res) return;
   267	    free(res->x);
   268	    free(res->history);
   269	    free(res->precond_history);
   270	    free(res);
   271	}
