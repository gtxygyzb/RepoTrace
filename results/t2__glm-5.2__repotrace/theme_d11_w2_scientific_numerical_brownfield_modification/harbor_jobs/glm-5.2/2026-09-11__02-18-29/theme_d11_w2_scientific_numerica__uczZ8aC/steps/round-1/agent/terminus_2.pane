     7	static int find_in_row(const CSRMatrix *A, int row, int col)
     8	{
     9	    int lo = A->row_ptr[row];
    10	    int hi = A->row_ptr[row+1] - 1;
    11	    while (lo <= hi) {
    12	        int mid = (lo + hi) / 2;
    13	        if (A->col_indices[mid] == col) return mid;
    14	        if (A->col_indices[mid] < col) lo = mid + 1;
    15	        else hi = mid - 1;
    16	    }
    17	    return -1;
    18	}
    19	
    20	static CSRMatrix *csr_copy(const CSRMatrix *A)
    21	{
    22	    CSRMatrix *B = csr_create(A->rows, A->cols, A->nnz);
    23	    if (!B) return NULL;
    24	    memcpy(B->values, A->values, A->nnz * sizeof(double));
    25	    memcpy(B->col_indices, A->col_indices, A->nnz * sizeof(int));
    26	    memcpy(B->row_ptr, A->row_ptr, (A->rows + 1) * sizeof(int));
    27	    return B;
    28	}
    29	
    30	static int ilu0_factorize(CSRMatrix *LU)
    31	{
    32	    int n = LU->rows;
    33	    for (int i = 0; i < n; i++) {
    34	        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {
    35	            int c = LU->col_indices[k];
    36	            if (c >= i) break;
    37	
    38	            int d = find_in_row(LU, c, c);
    39	            if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;
    40	
    41	            LU->values[k] /= LU->values[d];
    42	            double aik = LU->values[k];
    43	
    44	            for (int l = LU->row_ptr[c]; l < LU->row_ptr[c+1]; l++) {
    45	                int j = LU->col_indices[l];
    46	                if (j <= c) continue;
    47	                int idx = find_in_row(LU, i, j);
    48	                if (idx >= 0) LU->values[idx] -= aik * LU->values[l];
    49	            }
    50	        }
    51	    }
    52	    return 0;
    53	}
    54	
    55	static int ilu_forward_solve(const CSRMatrix *LU, const double *r, double *y)
    56	{
    57	    for (int i = 0; i < LU->rows; i++) {
    58	        double s = r[i];
    59	        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {
    60	            int j = LU->col_indices[k];
    61	            if (j < i) s -= LU->values[k] * y[j];
    62	            else break;
    63	        }
    64	        y[i] = s;
    65	    }
    66	    return 0;
    67	}
    68	
    69	static int ilu_backward_solve(const CSRMatrix *LU, const double *y, double *z)
    70	{
    71	    for (int i = LU->rows - 1; i >= 0; i--) {
    72	        double s = y[i];
    73	        int d = -1;
    74	        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {
    75	            int j = LU->col_indices[k];
    76	            if (j == i) d = k;
    77	            else if (j > i) s -= LU->values[k] * z[j];
    78	        }
    79	        if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;
    80	        z[i] = s / LU->values[d];
    81	    }
    82	    return 0;
    83	}
    84	
    85	Precond *precond_create(const CSRMatrix *A, const char *name, double omega)
    86	{
    87	    if (!A || !name || A->rows != A->cols) return NULL;
    88	
    89	    Precond *P = (Precond *)calloc(1, sizeof(Precond));
    90	    if (!P) return NULL;
    91	
    92	    P->n = A->rows;
    93	    P->omega = (omega > 0.0) ? omega : 1.0;
    94	
    95	    if (strcmp(name, "none") == 0) {
    96	        P->type = PRECOND_NONE;
    97	    } else if (strcmp(name, "jacobi") == 0) {
    98	        P->type = PRECOND_JACOBI;
    99	        P->diag = csr_diagonal(A);
   100	        if (!P->diag) { precond_destroy(P); return NULL; }
   101	    } else if (strcmp(name, "ilu0") == 0) {
   102	        P->type = PRECOND_ILU0;
   103	        P->lu = csr_copy(A);
   104	        if (!P->lu) { precond_destroy(P); return NULL; }
   105	        if (ilu0_factorize(P->lu) != 0) { precond_destroy(P); return NULL; }
   106	    } else if (strcmp(name, "ssor") == 0) {
   107	        P->type = PRECOND_SSOR;
   108	        P->ssor_A = A;
   109	        P->diag = csr_diagonal(A);
   110	        if (!P->diag) { precond_destroy(P); return NULL; }
   111	    } else {
   112	        precond_destroy(P);
   113	        return NULL;
   114	    }
