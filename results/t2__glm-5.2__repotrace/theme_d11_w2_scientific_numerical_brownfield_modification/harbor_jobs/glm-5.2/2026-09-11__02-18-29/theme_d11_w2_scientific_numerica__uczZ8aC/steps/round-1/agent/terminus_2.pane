    24	static const char *get_opt(int argc, char **argv, const char *name)
    25	{
    26	    for (int i = 0; i < argc - 1; i++) {
    27	        if (strcmp(argv[i], name) == 0) return argv[i+1];
    28	    }
    29	    return NULL;
    30	}
