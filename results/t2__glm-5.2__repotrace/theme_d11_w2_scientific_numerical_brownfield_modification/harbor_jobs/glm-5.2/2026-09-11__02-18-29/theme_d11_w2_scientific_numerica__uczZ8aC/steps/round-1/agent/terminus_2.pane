   128	            double r = hypot(a, b);
   129	            c[i] = a / r;
   130	            s[i] = b / r;
   131	        }
   132	        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);
   133	        apply_givens(&g[i], &g[i+1], c[i], s[i]);
   134	
