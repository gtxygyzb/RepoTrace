   136	            apply_givens(&H[i*m+j], &H[(i+1)*m+j], c[i], s[i]);
   137	        }
   138	    }
   139	
   140	    for (int i = kdim - 1; i >= 0; i--) {
   141	        double sum = g[i];
   142	        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];
   143	        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }
   144	        y[i] = sum / H[i*m+i];
   145	    }
