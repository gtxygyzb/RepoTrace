#include "vector.h"
#include <stdlib.h>
#include <string.h>
#include <math.h>

CSRMatrix *csr_create(int rows, int cols, int nnz)
{
    CSRMatrix *A = (CSRMatrix *)malloc(sizeof(CSRMatrix));
    if (!A) return NULL;
    A->rows = rows;
    A->cols = cols;
    A->nnz = nnz;
    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));
    A->col_indices = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    A->row_ptr = (int *)calloc((rows >= 0 ? rows + 1 : 1), sizeof(int));
    if (!A->values || !A->col_indices || !A->row_ptr) {
        csr_destroy(A);
        return NULL;
    }
    return A;
}

void csr_destroy(CSRMatrix *A)
{
    if (!A) return;
    free(A->values);
    free(A->col_indices);
    free(A->row_ptr);
    free(A);
}

COOMatrix *coo_create(int rows, int cols, int nnz)
{
    COOMatrix *A = (COOMatrix *)malloc(sizeof(COOMatrix));
    if (!A) return NULL;
    A->rows = rows;
    A->cols = cols;
    A->nnz = nnz;
    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));
    A->row = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    A->col = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    if (!A->values || !A->row || !A->col) {
        coo_destroy(A);
        return NULL;
    }
    return A;
}

void coo_destroy(COOMatrix *A)
{
    if (!A) return;
    free(A->values);
    free(A->row);
    free(A->col);
    free(A);
}

static const COOMatrix *g_coo_sort_data = NULL;

static int coo_qsort_cmp(const void *pa, const void *pb)
{
    int ia = *(const int *)pa;
    int ib = *(const int *)pb;
    const COOMatrix *A = g_coo_sort_data;
    if (A->row[ia] != A->row[ib]) return A->row[ia] - A->row[ib];
    return A->col[ia] - A->col[ib];
}

static COOMatrix *coo_sort_dedup(const COOMatrix *A)
{
    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);
    if (!out) return NULL;

    int *idx = (int *)malloc((A->nnz > 0 ? A->nnz : 1) * sizeof(int));
    if (!idx) { coo_destroy(out); return NULL; }
    for (int i = 0; i < A->nnz; i++) idx[i] = i;

    g_coo_sort_data = A;
    qsort(idx, A->nnz, sizeof(int), coo_qsort_cmp);
    g_coo_sort_data = NULL;

    int k = 0;
    for (int i = 0; i < A->nnz; i++) {
        int src = idx[i];
        if (k > 0 && out->row[k-1] == A->row[src] && out->col[k-1] == A->col[src]) {
            out->values[k-1] += A->values[src];
        } else {
            out->row[k] = A->row[src];
            out->col[k] = A->col[src];
            out->values[k] = A->values[src];
            k++;
        }
    }
    out->nnz = k;
    free(idx);
    return out;
}

COOMatrix *csr_to_coo(const CSRMatrix *A)
{
    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);
    if (!out) return NULL;
    int k = 0;
    for (int i = 0; i < A->rows; i++) {
        for (int j = A->row_ptr[i]; j < A->row_ptr[i+1]; j++) {
            out->row[k] = i;
            out->col[k] = A->col_indices[j];
            out->values[k] = A->values[j];
            k++;
        }
    }
    out->nnz = k;
    return out;
}

CSRMatrix *coo_to_csr(const COOMatrix *A)
{
    COOMatrix *sorted = coo_sort_dedup(A);
    if (!sorted) return NULL;
[?2004hroot@n30009:/app# sed -n '120,230p' src/sparse.c
[?2004l    if (!sorted) return NULL;

    CSRMatrix *out = csr_create(sorted->rows, sorted->cols, sorted->nnz);
    if (!out) { coo_destroy(sorted); return NULL; }

    for (int i = 0; i <= sorted->rows; i++) out->row_ptr[i] = 0;

    for (int k = 0; k < sorted->nnz; k++) {
        out->row_ptr[sorted->row[k] + 1]++;
    }
    for (int i = 0; i < sorted->rows; i++) {
        out->row_ptr[i+1] += out->row_ptr[i];
    }

    int *next = (int *)malloc((sorted->rows > 0 ? sorted->rows : 1) * sizeof(int));
    if (!next) { csr_destroy(out); coo_destroy(sorted); return NULL; }
    for (int i = 0; i < sorted->rows; i++) next[i] = out->row_ptr[i];

    for (int k = 0; k < sorted->nnz; k++) {
        int r = sorted->row[k];
        int pos = next[r]++;
        out->col_indices[pos] = sorted->col[k];
        out->values[pos] = sorted->values[k];
    }

    free(next);
    coo_destroy(sorted);
    return out;
}

void csr_spmv(const CSRMatrix *A, const double *x, double *y)
{
    for (int i = 0; i < A->rows; i++) {
        double s = 0.0;
        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
            s += A->values[k] * x[A->col_indices[k]];
        }
        y[i] = s;
    }
}

static int csr_find_in_row(const CSRMatrix *A, int row, int col)
{
    int lo = A->row_ptr[row];
    int hi = A->row_ptr[row+1] - 1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        if (A->col_indices[mid] == col) return mid;
        if (A->col_indices[mid] < col) lo = mid + 1;
        else hi = mid - 1;
    }
    return -1;
}

CSRMatrix *csr_transpose(const CSRMatrix *A)
{
    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);
    if (!T) return NULL;

    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;
    for (int k = 0; k < A->nnz; k++) {
        T->row_ptr[A->col_indices[k] + 1]++;
    }
    for (int i = 0; i < A->cols; i++) {
        T->row_ptr[i+1] += T->row_ptr[i];
    }

    int *next = (int *)malloc((A->cols > 0 ? A->cols : 1) * sizeof(int));
    if (!next) { csr_destroy(T); return NULL; }
    for (int i = 0; i < A->cols; i++) next[i] = T->row_ptr[i];

    for (int i = 0; i < A->rows; i++) {
        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
            int c = A->col_indices[k];
            int pos = next[c]++;
            T->col_indices[pos] = i;
            T->values[pos] = A->values[k];
        }
    }

    free(next);
    return T;
}

int csr_is_symmetric(const CSRMatrix *A, double tol)
{
    if (A->rows != A->cols) return 0;
    for (int i = 0; i < A->rows; i++) {
        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
            int j = A->col_indices[k];
            int idx = csr_find_in_row(A, j, i);
            if (idx < 0) return 0;
            if (fabs(A->values[k] - A->values[idx]) > tol) return 0;
        }
    }
    return 1;
}

double *csr_diagonal(const CSRMatrix *A)
{
    int n = A->rows < A->cols ? A->rows : A->cols;
    double *diag = vec_create(n);
    if (!diag) return NULL;
    for (int i = 0; i < n; i++) {
        int idx = csr_find_in_row(A, i, i);
        diag[i] = (idx >= 0) ? A->values[idx] : 0.0;
    }
    return diag;
}

static int mm_parse_header(const char *line, int *is_array, int *is_symmetric)
[?2004hroot@n30009:/app# sed -n '230,321p' src/sparse.c
[?2004lstatic int mm_parse_header(const char *line, int *is_array, int *is_symmetric)
{
    char buf[1024];
    strncpy(buf, line, sizeof(buf)-1);
    buf[sizeof(buf)-1] = '\0';

    char *tok = strtok(buf, " \t\r\n");
    if (!tok || strcmp(tok, "%%MatrixMarket") != 0) return -1;

    tok = strtok(NULL, " \t\r\n");
    if (!tok || strcmp(tok, "matrix") != 0) return -1;

    tok = strtok(NULL, " \t\r\n");
    if (!tok) return -1;
    if (strcmp(tok, "coordinate") == 0) *is_array = 0;
    else if (strcmp(tok, "array") == 0) *is_array = 1;
    else return -1;

    tok = strtok(NULL, " \t\r\n");
    if (!tok) return -1;
    if (strcmp(tok, "real") != 0 && strcmp(tok, "double") != 0) return -1;

    *is_symmetric = 0;
    tok = strtok(NULL, " \t\r\n");
    if (tok && strcmp(tok, "symmetric") == 0) *is_symmetric = 1;

    return 0;
}

static int read_non_comment_line(FILE *fp, char *buf, int bufsize)
{
    while (fgets(buf, bufsize, fp)) {
        char *s = buf;
        while (*s == ' ' || *s == '\t') s++;
        if (*s == '%' || *s == '\n' || *s == '\r' || *s == '\0') continue;
        return 0;
    }
    return -1;
}

CSRMatrix *csr_read_mm(const char *filename)
{
    FILE *fp = fopen(filename, "r");
    if (!fp) return NULL;

    char line[1024];
    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }
    int is_array = 0, is_symmetric = 0;
    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || is_array) {
        fclose(fp);
        return NULL;
    }

    int rows, cols, nnz;
    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }
    if (sscanf(line, "%d %d %d", &rows, &cols, &nnz) != 3 || rows <= 0 || cols <= 0 || nnz < 0) {
        fclose(fp);
        return NULL;
    }

    int cap = is_symmetric ? 2 * nnz + 1 : nnz;
    if (cap < 1) cap = 1;
    COOMatrix *coo = coo_create(rows, cols, cap);
    if (!coo) { fclose(fp); return NULL; }

    int k = 0;
    while (k < coo->nnz && read_non_comment_line(fp, line, sizeof(line)) == 0) {
        int r, c;
        double v;
        if (sscanf(line, "%d %d %lf", &r, &c, &v) != 3) continue;
        if (r < 1 || r > rows || c < 1 || c > cols) continue;
        r--; c--;

        coo->row[k] = r;
        coo->col[k] = c;
        coo->values[k] = v;
        k++;

        if (is_symmetric && r != c) {
            coo->row[k] = c;
            coo->col[k] = r;
            coo->values[k] = v;
            k++;
        }
    }
    coo->nnz = k;

    CSRMatrix *A = coo_to_csr(coo);
    coo_destroy(coo);
    fclose(fp);
    return A;
}
