   403	static int cmd_convdiff(int argc, char **argv)
   404	{
   405	    const char *nx_s = get_opt(argc, argv, "--nx");
   406	    const char *ny_s = get_opt(argc, argv, "--ny");
   407	    const char *x0_s = get_opt(argc, argv, "--x0");
   408	    const char *x1_s = get_opt(argc, argv, "--x1");
   409	    const char *y0_s = get_opt(argc, argv, "--y0");
   410	    const char *y1_s = get_opt(argc, argv, "--y1");
   411	    const char *kappa_s = get_opt(argc, argv, "--kappa");
   412	    const char *vx_s = get_opt(argc, argv, "--vx");
   413	    const char *vy_s = get_opt(argc, argv, "--vy");
   414	    const char *source = get_opt(argc, argv, "--source");
   415	    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
   416	    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
   417	    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
   418	    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
   419	    const char *solver = get_opt(argc, argv, "--solver");
   420	    const char *precond = get_opt(argc, argv, "--precond");
   421	    const char *tol_s = get_opt(argc, argv, "--tol");
   422	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   423	    const char *restart_s = get_opt(argc, argv, "--restart");
   424	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   425	    const char *output = get_opt(argc, argv, "--output");
   426	    const char *history = get_opt(argc, argv, "--history");
   427	
   428	    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !kappa_s ||
   429	        !vx_s || !vy_s || !source ||
   430	        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
   431	        !solver || !precond || !tol_s || !maxiter_s || !output) {
   432	        fprintf(stderr, "Error: convdiff requires grid, domain, kappa, vx, vy, source, boundary conditions, solver, precond, tol, maxiter, output\n");
   433	        usage("numsim");
   434	        return 1;
   435	    }
   436	
   437	    int nx = atoi(nx_s);
   438	    int ny = atoi(ny_s);
   439	    double x0 = atof(x0_s);
   440	    double x1 = atof(x1_s);
   441	    double y0 = atof(y0_s);
   442	    double y1 = atof(y1_s);
   443	    double kappa = atof(kappa_s);
   444	    double vx = atof(vx_s);
   445	    double vy = atof(vy_s);
   446	    double tol = atof(tol_s);
   447	    int maxiter = atoi(maxiter_s);
   448	    int restart = restart_s ? atoi(restart_s) : 30;
   449	    double omega = omega_s ? atof(omega_s) : 1.0;
   450	
   451	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || kappa <= 0.0 ||
   452	        tol <= 0.0 || maxiter < 0 || restart <= 0) {
   453	        fprintf(stderr, "Error: invalid convdiff parameters\n");
   454	        return 1;
   455	    }
   456	    if (validate_ssor_omega(omega) != 0) {
   457	        return 1;
   458	    }
   459	
   460	    PoissonBC left, right, bottom, top;
   461	    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
   462	        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
   463	        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
   464	        return 1;
   465	    }
   466	
   467	    double hx = (x1 - x0) / (nx - 1);
   468	    double hy = (y1 - y0) / (ny - 1);
   469	    double pe = convdiff_peclet(vx, vy, hx, hy, kappa);
   470	    if (pe > 1.0) {
   471	        fprintf(stderr, "warning: cell Peclet number %.6e > 1, solution may exhibit oscillations\n", pe);
   472	    }
   473	
   474	    CSRMatrix *A = NULL;
   475	    double *b = NULL;
   476	    if (convdiff_assemble(nx, ny, x0, x1, y0, y1, kappa, vx, vy,
   477	                          source, left, right, bottom, top, &A, &b) != 0) {
   478	        fprintf(stderr, "Error: cannot assemble convdiff system\n");
   479	        return 1;
   480	    }
   481	
   482	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   483	    printf("peclet: %.6e\n", pe);
   484	
   485	    free(b);
   486	    csr_destroy(A);
   487	    return rc;
   488	}
