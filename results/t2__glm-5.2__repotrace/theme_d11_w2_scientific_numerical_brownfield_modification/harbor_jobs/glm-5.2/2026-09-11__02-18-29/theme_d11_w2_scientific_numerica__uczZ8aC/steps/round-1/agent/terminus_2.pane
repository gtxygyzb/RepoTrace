   153	        apply_givens(&g[i], &g[i+1], c[i], s[i]);
   154	
   155	    }
   156	
   157	    for (int i = kdim - 1; i >= 0; i--) {
   158	        double sum = g[i];
   159	        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];
   160	        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }
   161	        y[i] = sum / H[i*m+i];
   162	    }
   163	
   164	    free(c);
   165	    free(s);
   166	    return 0;
   167	}
   168	
   169	SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,
   170	                           double tol, int maxiter, int m, Precond *P)
   171	{
   172	    if (!A || !b || A->rows != A->cols) return NULL;
   173	    int n = A->rows;
   174	    if (m <= 0) m = 30;
   175	    if (maxiter < 0) maxiter = 0;
   176	
   177	    SolveResult *res = result_create(n, maxiter);
   178	    if (!res) return NULL;
   179	
   180	    double *r = vec_create(n);
   181	    double *z = vec_create(n);
   182	    double *Ap = vec_create(n);
   183	    double *Av = vec_create(n);
   184	    double *w = vec_create(n);
   185	    double *g = (double *)malloc((m + 1) * sizeof(double));
   186	    double *y = (double *)malloc(m * sizeof(double));
   187	    double *H = (double *)calloc((m + 1) * m, sizeof(double));
   188	    double *V = (double *)malloc(n * (m + 1) * sizeof(double));
   189	
   190	    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {
   191	        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   192	        solve_result_destroy(res);
   193	        return NULL;
   194	    }
   195	
   196	    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);
   197	
   198	    csr_spmv(A, res->x, Ap);
   199	    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
   200	
   201	    double bnorm = vec_norm2(b, n);
   202	    if (bnorm == 0.0) bnorm = 1.0;
   203	    double bnorm_inf = vec_norm_inf(b, n);
   204	    if (bnorm_inf == 0.0) bnorm_inf = 1.0;
   205	
   206	    res->true_residual = vec_norm2(r, n);
   207	    res->relres = res->true_residual / bnorm;
   208	    res->true_residual_inf = vec_norm_inf(r, n);
   209	    res->relres_inf = res->true_residual_inf / bnorm_inf;
   210	    precond_apply(P, A, r, z);
   211	    double pnorm0 = vec_norm2(z, n);
   212	    res->history[0] = res->relres;
   213	    res->precond_history[0] = pnorm0;
   214	    res->history_len = 1;
   215	    res->converged = (res->relres < tol) ? 1 : 0;
   216	    res->iterations = 0;
   217	    if (res->converged || maxiter == 0) {
   218	        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   219	        return res;
   220	    }
   221	
   222	    for (int cycle = 1; cycle <= maxiter; cycle++) {
   223	        if (precond_apply(P, A, r, z) != 0) break;
   224	        double beta = vec_norm2(z, n);
   225	        if (beta == 0.0) break;
   226	
   227	        for (int i = 0; i < n; i++) V[i] = z[i] / beta;
   228	        for (int i = 0; i <= m; i++) g[i] = 0.0;
   229	        g[0] = beta;
   230	        memset(H, 0, (m + 1) * m * sizeof(double));
   231	
   232	        int kdim = 0;
   233	        int fail = 0;
   234	        for (int j = 0; j < m; j++) {
   235	            csr_spmv(A, V + j * n, Av);
   236	            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }
   237	
   238	            for (int i = 0; i <= j; i++) {
   239	                double h = vec_dot(w, V + i * n, n);
   240	                H[i*m+j] = h;
   241	                vec_axpy(-h, V + i * n, w, n);
   242	            }
   243	
   244	            double hnorm = vec_norm2(w, n);
   245	            H[(j+1)*m+j] = hnorm;
   246	            kdim = j + 1;
   247	
   248	            if (hnorm < 1e-14) break;
   249	
   250	            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;
   251	        }
   252	        if (fail) break;
   253	        if (kdim == 0) break;
   254	
   255	        for (int i = 0; i < kdim; i++) y[i] = 0.0;
   256	        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;
   257	
   258	        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);
   259	
   260	        csr_spmv(A, res->x, Ap);
   261	        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
   262	
   263	        res->true_residual = vec_norm2(r, n);
   264	        res->relres = res->true_residual / bnorm;
   265	        res->true_residual_inf = vec_norm_inf(r, n);
   266	        res->relres_inf = res->true_residual_inf / bnorm_inf;
   267	        precond_apply(P, A, r, z);
   268	        double pznorm = vec_norm2(z, n);
   269	        res->history[cycle] = res->relres;
   270	        res->precond_history[cycle] = pznorm;
   271	        res->history_len = cycle + 1;
   272	        res->iterations = cycle;
   273	
   274	        if (res->relres < tol) {
   275	            res->converged = 1;
   276	            break;
   277	        }
   278	    }
   279	
   280	    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   281	    return res;
   282	}
   283	
   284	void solve_result_destroy(SolveResult *res)
   285	{
   286	    if (!res) return;
   287	    free(res->x);
   288	    free(res->history);
   289	    free(res->precond_history);
   290	    free(res);
   291	}
