   400	static int cmd_convdiff(int argc, char **argv)
   401	{
   402	    const char *nx_s = get_opt(argc, argv, "--nx");
   403	    const char *ny_s = get_opt(argc, argv, "--ny");
   404	    const char *x0_s = get_opt(argc, argv, "--x0");
   405	    const char *x1_s = get_opt(argc, argv, "--x1");
   406	    const char *y0_s = get_opt(argc, argv, "--y0");
   407	    const char *y1_s = get_opt(argc, argv, "--y1");
   408	    const char *kappa_s = get_opt(argc, argv, "--kappa");
   409	    const char *vx_s = get_opt(argc, argv, "--vx");
   410	    const char *vy_s = get_opt(argc, argv, "--vy");
   411	    const char *source = get_opt(argc, argv, "--source");
   412	    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
   413	    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
   414	    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
   415	    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
   416	    const char *solver = get_opt(argc, argv, "--solver");
   417	    const char *precond = get_opt(argc, argv, "--precond");
   418	    const char *tol_s = get_opt(argc, argv, "--tol");
   419	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   420	    const char *restart_s = get_opt(argc, argv, "--restart");
   421	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   422	    const char *output = get_opt(argc, argv, "--output");
   423	    const char *history = get_opt(argc, argv, "--history");
   424	
   425	    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !kappa_s ||
   426	        !vx_s || !vy_s || !source ||
   427	        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
   428	        !solver || !precond || !tol_s || !maxiter_s || !output) {
   429	        fprintf(stderr, "Error: convdiff requires grid, domain, kappa, vx, vy, source, boundary conditions, solver, precond, tol, maxiter, output\n");
   430	        usage("numsim");
   431	        return 1;
   432	    }
   433	
   434	    int nx = atoi(nx_s);
   435	    int ny = atoi(ny_s);
   436	    double x0 = atof(x0_s);
   437	    double x1 = atof(x1_s);
   438	    double y0 = atof(y0_s);
   439	    double y1 = atof(y1_s);
   440	    double kappa = atof(kappa_s);
   441	    double vx = atof(vx_s);
   442	    double vy = atof(vy_s);
   443	    double tol = atof(tol_s);
   444	    int maxiter = atoi(maxiter_s);
   445	    int restart = restart_s ? atoi(restart_s) : 30;
   446	    double omega = omega_s ? atof(omega_s) : 1.0;
   447	
   448	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || kappa <= 0.0 ||
   449	        tol <= 0.0 || maxiter < 0 || restart <= 0) {
   450	        fprintf(stderr, "Error: invalid convdiff parameters\n");
   451	        return 1;
   452	    }
   453	    if (validate_ssor_omega(omega) != 0) {
   454	        return 1;
   455	    }
   456	
   457	    PoissonBC left, right, bottom, top;
   458	    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
   459	        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
   460	        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
   461	        return 1;
   462	    }
   463	
   464	    double hx = (x1 - x0) / (nx - 1);
   465	    double hy = (y1 - y0) / (ny - 1);
   466	    double pe = convdiff_peclet(vx, vy, hx, hy, kappa);
   467	    if (pe > 1.0) {
   468	        fprintf(stderr, "warning: cell Peclet number %.6e > 1, solution may exhibit oscillations\n", pe);
   469	    }
   470	
   471	    CSRMatrix *A = NULL;
   472	    double *b = NULL;
   473	    if (convdiff_assemble(nx, ny, x0, x1, y0, y1, kappa, vx, vy,
   474	                          source, left, right, bottom, top, &A, &b) != 0) {
   475	        fprintf(stderr, "Error: cannot assemble convdiff system\n");
   476	        return 1;
   477	    }
   478	
   479	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   480	    printf("peclet: %.6e\n", pe);
   481	
   482	    free(b);
   483	    csr_destroy(A);
   484	    return rc;
   485	}
   486	
   487	int main(int argc, char **argv)
   488	{
   489	    if (argc < 2) {
   490	        usage(argv[0]);
   491	        return 1;
   492	    }
   493	
   494	    const char *cmd = argv[1];
   495	
   496	    if (strcmp(cmd, "dense-solve") == 0) {
   497	        return cmd_dense_solve(argc - 2, argv + 2);
   498	    } else if (strcmp(cmd, "sparse-solve") == 0) {
   499	        return cmd_sparse_solve(argc - 2, argv + 2);
   500	    } else if (strcmp(cmd, "poisson") == 0) {
   501	        return cmd_poisson(argc - 2, argv + 2);
   502	    } else if (strcmp(cmd, "heat") == 0) {
   503	        return cmd_heat(argc - 2, argv + 2);
   504	    } else if (strcmp(cmd, "convdiff") == 0) {
   505	        return cmd_convdiff(argc - 2, argv + 2);
   506	    } else if (strcmp(cmd, "--help") == 0 || strcmp(cmd, "-h") == 0) {
   507	        usage(argv[0]);
   508	        return 0;
   509	    } else if (strcmp(cmd, "eigenvalue") == 0) {
   510	        return cmd_eigenvalue(argc - 2, argv + 2);
   511	    } else {
   512	        fprintf(stderr, "Error: unknown command '%s'\n", cmd);
   513	        usage(argv[0]);
   514	        return 1;
   515	    }
   516	}
