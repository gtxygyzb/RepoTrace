[?2004l[?2004h> static int mm_parse_header(const char *line, int *is_array, int *is_symmetric)
[?2004l[?2004h> {
[?2004l[?2004h>     char buf[1024];
[?2004l[?2004h>     strncpy(buf, line, sizeof(buf)-1);
[?2004l[?2004h>     buf[sizeof(buf)-1] = '\0';
[?2004l[?2004h> 
[?2004l[?2004h>     char *tok = strtok(buf, " \t\r\n");
[?2004l[?2004h>     if (!tok || strcmp(tok, "%%MatrixMarket") != 0) return -1;
[?2004l[?2004h> 
[?2004l[?2004h>     tok = strtok(NULL, " \t\r\n");
[?2004l[?2004h>     if (!tok || strcmp(tok, "matrix") != 0) return -1;
[?2004l[?2004h> 
[?2004l[?2004h>     tok = strtok(NULL, " \t\r\n");
[?2004l[?2004h>     if (!tok) return -1;
[?2004l[?2004h>     if (strcmp(tok, "coordinate") == 0) *is_array = 0;
[?2004l[?2004h>     else if (strcmp(tok, "array") == 0) *is_array = 1;
[?2004l[?2004h>     else return -1;
[?2004l[?2004h> 
[?2004l[?2004h>     tok = strtok(NULL, " \t\r\n");
[?2004l[?2004h>     if (!tok) return -1;
[?2004l[?2004h>     if (strcmp(tok, "real") != 0 && strcmp(tok, "double") != 0) return -1;
[?2004l[?2004h> 
[?2004l[?2004h>     *is_symmetric = 0;
[?2004l[?2004h>     tok = strtok(NULL, " \t\r\n");
[?2004l[?2004h>     if (tok && strcmp(tok, "symmetric") == 0) *is_symmetric = 1;
[?2004l[?2004h> 
[?2004l[?2004h>     return 0;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> static int read_non_comment_line(FILE *fp, char *buf, int bufsize)
[?2004l[?2004h> {
[?2004l[?2004h>     while (fgets(buf, bufsize, fp)) {
[?2004l[?2004h>         char *s = buf;
[?2004l[?2004h>         while (*s == ' ' || *s == '\t') s++;
[?2004l[?2004h>         if (*s == '%' || *s == '\n' || *s == '\r' || *s == '\0') continue;
[?2004l[?2004h>         return 0;
[?2004l[?2004h>     }
[?2004l[?2004h>     return -1;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> CSRMatrix *csr_read_mm(const char *filename)
[?2004l[?2004h> {
[?2004l[?2004h>     FILE *fp = fopen(filename, "r");
[?2004l[?2004h>     if (!fp) return NULL;
[?2004l[?2004h> 
[?2004l[?2004h>     char line[1024];
[?2004l[?2004h>     if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }
[?2004l[?2004h>     int is_array = 0, is_symmetric = 0;
[?2004l[?2004h>     if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || is_array) {
[?2004l[?2004h>         fclose(fp);
[?2004l[?2004h>         return NULL;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     int rows, cols, nnz;
[?2004l[?2004h>     if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }
[?2004l[?2004h>     if (sscanf(line, "%d %d %d", &rows, &cols, &nnz) != 3 || rows <= 0 || cols <= 0 || nnz < 0) {
[?2004l[?2004h>         fclose(fp);
[?2004l[?2004h>         return NULL;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     int cap = is_symmetric ? 2 * nnz + 1 : nnz;
[?2004l[?2004h>     if (cap < 1) cap = 1;
[?2004l[?2004h>     COOMatrix *coo = coo_create(rows, cols, cap);
[?2004l[?2004h>     if (!coo) { fclose(fp); return NULL; }
[?2004l[?2004h> 
[?2004l[?2004h>     int k = 0;
[?2004l[?2004h>     while (k < coo->nnz && read_non_comment_line(fp, line, sizeof(line)) == 0) {
[?2004l[?2004h>         int r, c;
[?2004l[?2004h>         double v;
[?2004l[?2004h>         if (sscanf(line, "%d %d %lf", &r, &c, &v) != 3) continue;
[?2004l[?2004h>         if (r < 1 || r > rows || c < 1 || c > cols) continue;
[?2004l[?2004h>         r--; c--;
[?2004l[?2004h> 
[?2004l[?2004h>         coo->row[k] = r;
[?2004l[?2004h>         coo->col[k] = c;
[?2004l[?2004h>         coo->values[k] = v;
[?2004l[?2004h>         k++;
[?2004l[?2004h> 
[?2004l[?2004h>         if (is_symmetric && r != c) {
[?2004l[?2004h>             coo->row[k] = c;
[?2004l[?2004h>             coo->col[k] = r;
[?2004l[?2004h>             coo->values[k] = v;
[?2004l[?2004h>             k++;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     coo->nnz = k;
[?2004l[?2004h> 
[?2004l[?2004h>     CSRMatrix *A = coo_to_csr(coo);
[?2004l[?2004h>     coo_destroy(coo);
[?2004l[?2004h>     fclose(fp);
[?2004l[?2004h>     return A;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> int csr_write_mm(const CSRMatrix *A, const char *filename)
[?2004l[?2004h> {
[?2004l[?2004h>     FILE *fp = fopen(filename, "w");
[?2004l[?2004h>     if (!fp) return -1;
[?2004l[?2004h> 
[?2004l[?2004h>     fprintf(fp, "%%%%MatrixMarket matrix coordinate real general\n");
[?2004l[?2004h>     fprintf(fp, "%d %d %d\n", A->rows, A->cols, A->nnz);
[?2004l[?2004h>     for (int i = 0; i < A->rows; i++) {
[?2004l[?2004h>         for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
[?2004l[?2004h>             fprintf(fp, "%d %d %.15g\n", i+1, A->col_indices[k]+1, A->values[k]);
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     fclose(fp);
[?2004l[?2004h>     return 0;
[?2004l[?2004h> }
