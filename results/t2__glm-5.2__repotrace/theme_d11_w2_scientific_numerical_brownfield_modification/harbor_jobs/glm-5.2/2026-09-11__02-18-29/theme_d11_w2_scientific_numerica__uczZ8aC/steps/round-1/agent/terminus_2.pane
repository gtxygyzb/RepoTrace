[?2004l[?2004h> double *vec_read_mm_array(const char *filename, int *n_out)
[?2004l[?2004h> {
[?2004l[?2004h>     FILE *fp = fopen(filename, "r");
[?2004l[?2004h>     if (!fp) return NULL;
[?2004l[?2004h> 
