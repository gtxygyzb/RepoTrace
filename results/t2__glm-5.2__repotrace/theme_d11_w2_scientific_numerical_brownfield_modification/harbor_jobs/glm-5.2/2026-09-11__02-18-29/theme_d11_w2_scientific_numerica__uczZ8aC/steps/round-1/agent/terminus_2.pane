[?2004l#ifndef SOLVERS_H
#define SOLVERS_H

#include "sparse.h"
#include "precond.h"

typedef struct {
    double *x;
    double relres;          /* true relative residual ||b-A*x||/||b|| */
    double true_residual;   /* absolute true residual norm ||b-A*x|| */
    int iterations;
    int converged;
