   197	static int cmd_sparse_solve(int argc, char **argv)
   198	{
   199	    const char *input = get_opt(argc, argv, "--input");
   200	    const char *rhs_file = get_opt(argc, argv, "--rhs");
   201	    const char *solver = get_opt(argc, argv, "--solver");
   202	    const char *precond = get_opt(argc, argv, "--precond");
   203	    const char *tol_s = get_opt(argc, argv, "--tol");
   204	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   205	    const char *restart_s = get_opt(argc, argv, "--restart");
   206	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   207	    const char *output = get_opt(argc, argv, "--output");
   208	    const char *history = get_opt(argc, argv, "--history");
   209	
   210	    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {
   211	        fprintf(stderr, "Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\n");
   212	        usage("numsim");
   213	        return 1;
   214	    }
   215	
   216	    double tol = atof(tol_s);
   217	    int maxiter = atoi(maxiter_s);
   218	    int restart = restart_s ? atoi(restart_s) : 30;
   219	    double omega = omega_s ? atof(omega_s) : 1.0;
   220	
   221	    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {
   222	        fprintf(stderr, "Error: invalid solver parameters\n");
   223	        return 1;
   224	    }
   225	    if (validate_ssor_omega(omega) != 0) {
   226	        return 1;
   227	    }
   228	
   229	    CSRMatrix *A = csr_read_mm(input);
   230	    if (!A) {
   231	        fprintf(stderr, "Error: cannot read sparse matrix from '%s'\n", input);
   232	        return 1;
   233	    }
   234	
   235	    int n;
   236	    double *b = vec_read_mm_array(rhs_file, &n);
   237	    if (!b) {
   238	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
   239	        csr_destroy(A);
   240	        return 1;
   241	    }
   242	
   243	    if (A->rows != n || A->cols != n) {
   244	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
   245	                A->rows, A->cols, n);
   246	        free(b);
   247	        csr_destroy(A);
   248	        return 1;
   249	    }
   250	
   251	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   252	
   253	    free(b);
   254	    csr_destroy(A);
   255	    return rc;
   256	}
