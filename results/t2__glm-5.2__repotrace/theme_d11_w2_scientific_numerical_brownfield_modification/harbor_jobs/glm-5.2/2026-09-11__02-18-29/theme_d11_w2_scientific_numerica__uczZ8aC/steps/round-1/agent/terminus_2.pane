   155	SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,
   156	                           double tol, int maxiter, int m, Precond *P)
   157	{
   158	    if (!A || !b || A->rows != A->cols) return NULL;
   159	    int n = A->rows;
   160	    if (m <= 0) m = 30;
   161	    if (maxiter < 0) maxiter = 0;
   162	
   163	    SolveResult *res = result_create(n, maxiter);
   164	    if (!res) return NULL;
   165	
   166	    double *r = vec_create(n);
   167	    double *z = vec_create(n);
   168	    double *Ap = vec_create(n);
   169	    double *Av = vec_create(n);
   170	    double *w = vec_create(n);
   171	    double *g = (double *)malloc((m + 1) * sizeof(double));
   172	    double *y = (double *)malloc(m * sizeof(double));
   173	    double *H = (double *)calloc((m + 1) * m, sizeof(double));
   174	    double *V = (double *)malloc(n * (m + 1) * sizeof(double));
   175	
   176	    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {
   177	        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   178	        solve_result_destroy(res);
   179	        return NULL;
   180	    }
   181	
   182	    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);
   183	
   184	    csr_spmv(A, res->x, Ap);
   185	    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
   186	
   187	    double bnorm = vec_norm2(b, n);
   188	    if (bnorm == 0.0) bnorm = 1.0;
   189	
   190	    res->true_residual = vec_norm2(r, n);
   191	    res->relres = res->true_residual / bnorm;
   192	    res->history[0] = res->relres;
   193	    res->history_len = 1;
   194	    res->converged = (res->relres < tol) ? 1 : 0;
   195	    res->iterations = 0;
   196	    if (res->converged || maxiter == 0) {
   197	        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   198	        return res;
   199	    }
   200	
   201	    for (int cycle = 1; cycle <= maxiter; cycle++) {
   202	        if (precond_apply(P, A, r, z) != 0) break;
   203	        double beta = vec_norm2(z, n);
   204	        if (beta == 0.0) break;
   205	
   206	        for (int i = 0; i < n; i++) V[i] = z[i] / beta;
   207	        for (int i = 0; i <= m; i++) g[i] = 0.0;
   208	        g[0] = beta;
   209	        memset(H, 0, (m + 1) * m * sizeof(double));
   210	
   211	        int kdim = 0;
   212	        int fail = 0;
   213	        for (int j = 0; j < m; j++) {
   214	            csr_spmv(A, V + j * n, Av);
   215	            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }
   216	
   217	            for (int i = 0; i <= j; i++) {
   218	                double h = vec_dot(w, V + i * n, n);
   219	                H[i*m+j] = h;
   220	                vec_axpy(-h, V + i * n, w, n);
   221	            }
   222	
   223	            double hnorm = vec_norm2(w, n);
   224	            H[(j+1)*m+j] = hnorm;
   225	            kdim = j + 1;
   226	
   227	            if (hnorm < 1e-14) break;
   228	
   229	            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;
   230	        }
   231	        if (fail) break;
   232	        if (kdim == 0) break;
   233	
   234	        for (int i = 0; i < kdim; i++) y[i] = 0.0;
   235	        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;
