#ifndef SPARSE_H
#define SPARSE_H

#include <stdio.h>

typedef struct {
    int    rows;
    int    cols;
    int    nnz;
    double *values;
    int    *col_indices;
    int    *row_ptr;
} CSRMatrix;

typedef struct {
    int    rows;
    int    cols;
    int    nnz;
    double *values;
    int    *row;
    int    *col;
} COOMatrix;

/* Lifecycle */
CSRMatrix  *csr_create(int rows, int cols, int nnz);
void        csr_destroy(CSRMatrix *A);
COOMatrix  *coo_create(int rows, int cols, int nnz);
void        coo_destroy(COOMatrix *A);

/* Conversions */
COOMatrix  *csr_to_coo(const CSRMatrix *A);
CSRMatrix  *coo_to_csr(const COOMatrix *A);

/* Operations */
void        csr_spmv(const CSRMatrix *A, const double *x, double *y);
CSRMatrix  *csr_transpose(const CSRMatrix *A);
int         csr_is_symmetric(const CSRMatrix *A, double tol);
double     *csr_diagonal(const CSRMatrix *A);

/* Matrix Market I/O */
CSRMatrix  *csr_read_mm(const char *filename);
int         csr_write_mm(const CSRMatrix *A, const char *filename);
double     *vec_read_mm_array(const char *filename, int *n_out);
int         vec_write_mm_array(const double *x, int n, const char *filename);

#endif /* SPARSE_H */

===== include/io.h =====
#ifndef IO_H
#define IO_H

#include "dense.h"

/*
 * Read dense matrix from text file.
 * Format:
 *   rows cols
 *   a00 a01 a02 ...
 *   a10 a11 a12 ...
 *   ...
 * Returns NULL on error.
 */
DenseMatrix *dm_read_text(const char *filename);

/*
 * Write dense matrix to text file.
 * Returns 0 on success, -1 on error.
 */
int dm_write_text(const DenseMatrix *m, const char *filename);

/*
 * Read vector from text file.
 * Format:
 *   n
 *   v0
 *   v1
 *   ...
 * Sets *n_out to the dimension. Returns NULL on error.
 */
double *vec_read_text(const char *filename, int *n_out);

/*
 * Write vector to text file.
 * Returns 0 on success, -1 on error.
 */
int vec_write_text(const double *x, int n, const char *filename);

#endif /* IO_H */

