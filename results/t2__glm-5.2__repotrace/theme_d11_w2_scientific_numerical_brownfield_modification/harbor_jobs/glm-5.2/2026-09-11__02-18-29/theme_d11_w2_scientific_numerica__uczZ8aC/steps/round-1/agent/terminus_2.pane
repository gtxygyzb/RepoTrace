   123	    for (int i = 0; i < kdim; i++) {
   124	        for (int k = 0; k < i; k++) {
   125	            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);
   126	        }
   127	
   128	        double a = H[i*m+i];
   129	        double b = H[(i+1)*m+i];
   130	        if (b == 0.0) {
   131	            c[i] = 1.0;
   132	            s[i] = 0.0;
   133	        } else {
   134	            double r = hypot(a, b);
   135	            c[i] = a / r;
   136	            s[i] = b / r;
   137	        }
   138	        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);
   139	        apply_givens(&g[i], &g[i+1], c[i], s[i]);
   140	
   141	    }
