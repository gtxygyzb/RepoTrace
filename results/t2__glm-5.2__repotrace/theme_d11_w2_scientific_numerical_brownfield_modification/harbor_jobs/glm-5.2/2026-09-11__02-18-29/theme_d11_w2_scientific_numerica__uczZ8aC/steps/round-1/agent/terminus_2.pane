    64	static int cmd_dense_solve(int argc, char **argv)
    65	{
    66	    if (argc < 2) {
    67	        fprintf(stderr, "Error: dense-solve requires <matrix_file> <rhs_file>\n");
    68	        return 1;
    69	    }
    70	
    71	    const char *mat_file = argv[0];
    72	    const char *rhs_file = argv[1];
    73	    const char *out_file = (argc >= 3) ? argv[2] : NULL;
    74	
    75	    DenseMatrix *A = dm_read_text(mat_file);
    76	    if (!A) {
    77	        fprintf(stderr, "Error: cannot read matrix from '%s'\n", mat_file);
    78	        return 1;
    79	    }
    80	
    81	    int n;
    82	    double *b = vec_read_text(rhs_file, &n);
    83	    if (!b) {
    84	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
    85	        dm_destroy(A);
    86	        return 1;
    87	    }
    88	
    89	    if (A->rows != n || A->cols != n) {
    90	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
    91	                A->rows, A->cols, n);
    92	        free(b);
    93	        dm_destroy(A);
    94	        return 1;
    95	    }
    96	
    97	    double *x = vec_create(n);
    98	    if (!x) {
    99	        fprintf(stderr, "Error: allocation failed\n");
   100	        free(b);
   101	        dm_destroy(A);
   102	        return 1;
   103	    }
   104	
   105	    int rc = dm_solve(A, b, x);
   106	    if (rc != 0) {
   107	        fprintf(stderr, "Error: solver failed (singular or ill-conditioned)\n");
   108	        free(x);
   109	        free(b);
   110	        dm_destroy(A);
   111	        return 1;
   112	    }
   113	
   114	    if (out_file) {
   115	        vec_write_text(x, n, out_file);
   116	        printf("Solution written to %s\n", out_file);
   117	    } else {
   118	        printf("Solution:\n");
   119	        vec_print(x, n, stdout);
   120	    }
   121	
   122	    double *r = vec_create(n);
   123	    dm_matvec(A, x, r);
   124	    vec_axpy(-1.0, b, r, n);
   125	    printf("Residual norm: %.6e\n", vec_norm2(r, n));
   126	
   127	    free(r);
   128	    free(x);
   129	    free(b);
   130	    dm_destroy(A);
   131	    return 0;
   132	}
   133	
   134	static int parse_bc(const char *s, PoissonBC *bc)
   135	{
   136	    const char *colon = strchr(s, ':');
   137	    if (!colon || colon == s) return -1;
   138	
   139	    size_t len = colon - s;
   140	    char type[32];
   141	    if (len >= sizeof(type)) return -1;
   142	    memcpy(type, s, len);
   143	    type[len] = '\0';
   144	
   145	    if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
   146	    else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
   147	    else return -1;
   148	
   149	    bc->file = colon + 1;
   150	    return 0;
   151	}
   152	
   153	static int run_solver_and_print(const CSRMatrix *A, const double *b,
   154	                                const char *solver, const char *precond,
   155	                                double tol, int maxiter, int restart,
   156	                                double omega, const char *output,
   157	                                const char *history)
   158	{
   159	    Precond *P = precond_create(A, precond, omega);
   160	    if (!P) {
   161	        fprintf(stderr, "Error: cannot create preconditioner '%s'\n", precond);
   162	        return 1;
   163	    }
   164	
   165	    SolveResult *res = NULL;
   166	    if (strcmp(solver, "cg") == 0) {
   167	        res = cg_solve(A, b, NULL, tol, maxiter, P);
   168	    } else if (strcmp(solver, "gmres") == 0) {
   169	        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);
   170	    } else {
   171	        fprintf(stderr, "Error: unknown solver '%s'\n", solver);
   172	        precond_destroy(P);
   173	        return 1;
   174	    }
   175	
   176	    if (!res) {
   177	        fprintf(stderr, "Error: solver allocation failed\n");
   178	        precond_destroy(P);
   179	        return 1;
   180	    }
   181	
   182	    print_solve_summary(res);
   183	
   184	    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {
   185	        fprintf(stderr, "Error: cannot write output to '%s'\n", output);
   186	    }
   187	    if (history && write_history_file(res, history) != 0) {
   188	        fprintf(stderr, "Error: cannot write history to '%s'\n", history);
   189	    }
   190	
   191	    solve_result_destroy(res);
   192	    precond_destroy(P);
   193	    return 0;
   194	}
