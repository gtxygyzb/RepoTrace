   192	static int cmd_sparse_solve(int argc, char **argv)
   193	{
   194	    const char *input = get_opt(argc, argv, "--input");
   195	    const char *rhs_file = get_opt(argc, argv, "--rhs");
   196	    const char *solver = get_opt(argc, argv, "--solver");
   197	    const char *precond = get_opt(argc, argv, "--precond");
   198	    const char *tol_s = get_opt(argc, argv, "--tol");
   199	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   200	    const char *restart_s = get_opt(argc, argv, "--restart");
   201	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   202	    const char *output = get_opt(argc, argv, "--output");
   203	    const char *history = get_opt(argc, argv, "--history");
   204	
   205	    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {
   206	        fprintf(stderr, "Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\n");
   207	        usage("numsim");
   208	        return 1;
   209	    }
   210	
   211	    double tol = atof(tol_s);
   212	    int maxiter = atoi(maxiter_s);
   213	    int restart = restart_s ? atoi(restart_s) : 30;
   214	    double omega = omega_s ? atof(omega_s) : 1.0;
   215	
   216	    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {
   217	        fprintf(stderr, "Error: invalid solver parameters\n");
   218	        return 1;
   219	    }
   220	    if (validate_ssor_omega(omega) != 0) {
   221	        return 1;
   222	    }
   223	
   224	    CSRMatrix *A = csr_read_mm(input);
   225	    if (!A) {
   226	        fprintf(stderr, "Error: cannot read sparse matrix from '%s'\n", input);
   227	        return 1;
   228	    }
   229	
   230	    int n;
   231	    double *b = vec_read_mm_array(rhs_file, &n);
   232	    if (!b) {
   233	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
   234	        csr_destroy(A);
   235	        return 1;
   236	    }
   237	
   238	    if (A->rows != n || A->cols != n) {
   239	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
   240	                A->rows, A->cols, n);
   241	        free(b);
   242	        csr_destroy(A);
   243	        return 1;
   244	    }
   245	
   246	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   247	
   248	    free(b);
   249	    csr_destroy(A);
   250	    return rc;
   251	}
