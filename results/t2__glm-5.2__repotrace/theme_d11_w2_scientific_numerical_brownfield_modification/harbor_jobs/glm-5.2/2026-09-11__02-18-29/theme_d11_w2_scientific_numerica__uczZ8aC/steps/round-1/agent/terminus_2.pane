   143	    for (int i = kdim - 1; i >= 0; i--) {
   144	        double sum = g[i];
   145	        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];
   146	        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }
   147	        y[i] = sum / H[i*m+i];
   148	    }
   149	
   150	    free(c);
   151	    free(s);
   152	    return 0;
   153	}
