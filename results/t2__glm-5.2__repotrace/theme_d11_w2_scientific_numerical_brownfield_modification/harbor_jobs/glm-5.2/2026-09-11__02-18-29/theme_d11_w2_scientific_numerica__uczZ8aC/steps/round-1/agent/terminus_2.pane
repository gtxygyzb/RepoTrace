[?2004l     1	#include "solvers.h"
     2	#include "vector.h"
     3	#include <stdlib.h>
     4	#include <math.h>
     5	#include <string.h>
     6	
     7	static SolveResult *result_create(int n, int maxiter)
     8	{
     9	    if (maxiter < 0) maxiter = 0;
    10	    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));
    11	    if (!res) return NULL;
    12	
    13	    res->x = vec_create(n);
    14	    res->history = (double *)malloc((maxiter + 1) * sizeof(double));
    15	    if (!res->x || !res->history) {
    16	        free(res->x);
    17	        free(res->history);
    18	        free(res);
    19	        return NULL;
    20	    }
    21	    res->history_len = 0;
    22	    return res;
    23	}
    24	
    25	SolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,
    26	                      double tol, int maxiter, Precond *P)
    27	{
    28	    if (!A || !b || A->rows != A->cols) return NULL;
    29	    int n = A->rows;
    30	    if (maxiter < 0) maxiter = 0;
    31	
    32	    SolveResult *res = result_create(n, maxiter);
    33	    if (!res) return NULL;
    34	
    35	    double *r = vec_create(n);
    36	    double *z = vec_create(n);
    37	    double *p = vec_create(n);
    38	    double *Ap = vec_create(n);
    39	    if (!r || !z || !p || !Ap) {
    40	        free(r); free(z); free(p); free(Ap);
    41	        solve_result_destroy(res);
    42	        return NULL;
    43	    }
    44	
    45	    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);
    46	
    47	    csr_spmv(A, res->x, Ap);
    48	    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
    49	
    50	    double bnorm = vec_norm2(b, n);
    51	    if (bnorm == 0.0) bnorm = 1.0;
    52	
    53	    res->relres = vec_norm2(r, n) / bnorm;
    54	    res->history[0] = res->relres;
    55	    res->history_len = 1;
    56	    res->converged = (res->relres < tol) ? 1 : 0;
    57	    res->iterations = 0;
    58	    if (res->converged || maxiter == 0) {
    59	        free(r); free(z); free(p); free(Ap);
    60	        return res;
    61	    }
    62	
    63	    if (precond_apply(P, A, r, z) != 0) {
    64	        free(r); free(z); free(p); free(Ap);
    65	        return res;
    66	    }
    67	    vec_copy(z, p, n);
    68	    double rz_old = vec_dot(r, z, n);
    69	
    70	    for (int iter = 1; iter <= maxiter; iter++) {
    71	        csr_spmv(A, p, Ap);
    72	        double pAp = vec_dot(p, Ap, n);
    73	        if (fabs(pAp) < 1e-30) break;
    74	
    75	        double alpha = rz_old / pAp;
    76	        vec_axpy(alpha, p, res->x, n);
    77	        vec_axpy(-alpha, Ap, r, n);
    78	
    79	        res->relres = vec_norm2(r, n) / bnorm;
    80	        res->history[iter] = res->relres;
    81	        res->history_len = iter + 1;
    82	        res->iterations = iter;
    83	
    84	        if (res->relres < tol) {
    85	            res->converged = 1;
    86	            break;
    87	        }
    88	
    89	        if (precond_apply(P, A, r, z) != 0) break;
    90	        double rz_new = vec_dot(r, z, n);
    91	        if (fabs(rz_old) < 1e-30) break;
    92	        double beta = rz_new / rz_old;
    93	        vec_scale(beta, p, n);
    94	        vec_axpy(1.0, z, p, n);
    95	        rz_old = rz_new;
    96	    }
    97	
    98	    free(r); free(z); free(p); free(Ap);
    99	    return res;
   100	}
   101	
   102	static void apply_givens(double *a, double *b, double c, double s)
   103	{
   104	    double t = c * (*a) + s * (*b);
   105	    *b = -s * (*a) + c * (*b);
   106	    *a = t;
   107	}
   108	
   109	static int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)
   110	{
   111	    if (kdim <= 0) return -1;
   112	
   113	    double *c = (double *)malloc(m * sizeof(double));
   114	    double *s = (double *)malloc(m * sizeof(double));
   115	    if (!c || !s) { free(c); free(s); return -1; }
   116	
   117	    for (int i = 0; i < kdim; i++) {
   118	        for (int k = 0; k < i; k++) {
   119	            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);
   120	        }
   121	
   122	        double a = H[i*m+i];
   123	        double b = H[(i+1)*m+i];
   124	        if (b == 0.0) {
   125	            c[i] = 1.0;
   126	            s[i] = 0.0;
   127	        } else {
   128	            double r = hypot(a, b);
   129	            c[i] = a / r;
   130	            s[i] = b / r;
   131	        }
   132	        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);
   133	        apply_givens(&g[i], &g[i+1], c[i], s[i]);
   134	
   135	    }
   136	
   137	    for (int i = kdim - 1; i >= 0; i--) {
   138	        double sum = g[i];
   139	        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];
   140	        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }
   141	        y[i] = sum / H[i*m+i];
   142	    }
   143	
   144	    free(c);
   145	    free(s);
   146	    return 0;
   147	}
   148	
   149	SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,
   150	                         double tol, int maxiter, int m, Precond *P)
   151	{
   152	    if (!A || !b || A->rows != A->cols) return NULL;
   153	    int n = A->rows;
   154	    if (m <= 0) m = 30;
   155	    if (maxiter < 0) maxiter = 0;
   156	
   157	    SolveResult *res = result_create(n, maxiter);
   158	    if (!res) return NULL;
   159	
   160	    double *r = vec_create(n);
   161	    double *z = vec_create(n);
   162	    double *Ap = vec_create(n);
   163	    double *Av = vec_create(n);
   164	    double *w = vec_create(n);
   165	    double *g = (double *)malloc((m + 1) * sizeof(double));
   166	    double *y = (double *)malloc(m * sizeof(double));
   167	    double *H = (double *)calloc((m + 1) * m, sizeof(double));
   168	    double *V = (double *)malloc(n * (m + 1) * sizeof(double));
   169	
   170	    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {
   171	        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   172	        solve_result_destroy(res);
   173	        return NULL;
   174	    }
   175	
   176	    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);
   177	
   178	    csr_spmv(A, res->x, Ap);
   179	    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
   180	
   181	    double bnorm = vec_norm2(b, n);
   182	    if (bnorm == 0.0) bnorm = 1.0;
   183	
   184	    res->relres = vec_norm2(r, n) / bnorm;
   185	    res->history[0] = res->relres;
   186	    res->history_len = 1;
   187	    res->converged = (res->relres < tol) ? 1 : 0;
   188	    res->iterations = 0;
   189	    if (res->converged || maxiter == 0) {
   190	        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   191	        return res;
   192	    }
   193	
   194	    for (int cycle = 1; cycle <= maxiter; cycle++) {
   195	        if (precond_apply(P, A, r, z) != 0) break;
   196	        double beta = vec_norm2(z, n);
   197	        if (beta == 0.0) break;
   198	
   199	        for (int i = 0; i < n; i++) V[i] = z[i] / beta;
   200	        for (int i = 0; i <= m; i++) g[i] = 0.0;
   201	        g[0] = beta;
   202	        memset(H, 0, (m + 1) * m * sizeof(double));
   203	
   204	        int kdim = 0;
   205	        int fail = 0;
   206	        for (int j = 0; j < m; j++) {
   207	            csr_spmv(A, V + j * n, Av);
   208	            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }
   209	
   210	            for (int i = 0; i <= j; i++) {
   211	                double h = vec_dot(w, V + i * n, n);
   212	                H[i*m+j] = h;
   213	                vec_axpy(-h, V + i * n, w, n);
   214	            }
   215	
   216	            double hnorm = vec_norm2(w, n);
   217	            H[(j+1)*m+j] = hnorm;
   218	            kdim = j + 1;
   219	
   220	            if (hnorm < 1e-14) break;
   221	
   222	            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;
   223	        }
   224	        if (fail) break;
   225	        if (kdim == 0) break;
   226	
   227	        for (int i = 0; i < kdim; i++) y[i] = 0.0;
   228	        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;
   229	
   230	        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);
   231	
   232	        csr_spmv(A, res->x, Ap);
   233	        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];
   234	
   235	        res->relres = vec_norm2(r, n) / bnorm;
   236	        res->history[cycle] = res->relres;
   237	        res->history_len = cycle + 1;
   238	        res->iterations = cycle;
   239	
   240	        if (res->relres < tol) {
   241	            res->converged = 1;
   242	            break;
   243	        }
   244	    }
   245	
   246	    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
   247	    return res;
   248	}
   249	
   250	void solve_result_destroy(SolveResult *res)
   251	{
   252	    if (!res) return;
   253	    free(res->x);
   254	    free(res->history);
   255	    free(res);
   256	}
