     7	CSRMatrix *csr_create(int rows, int cols, int nnz)
     8	{
     9	    CSRMatrix *A = (CSRMatrix *)malloc(sizeof(CSRMatrix));
    10	    if (!A) return NULL;
    11	    A->rows = rows;
    12	    A->cols = cols;
    13	    A->nnz = nnz;
    14	    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));
    15	    A->col_indices = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    16	    A->row_ptr = (int *)calloc((rows >= 0 ? rows + 1 : 1), sizeof(int));
    17	    if (!A->values || !A->col_indices || !A->row_ptr) {
    18	        csr_destroy(A);
    19	        return NULL;
    20	    }
    21	    return A;
    22	}
    23	
    24	void csr_destroy(CSRMatrix *A)
    25	{
    26	    if (!A) return;
    27	    free(A->values);
    28	    free(A->col_indices);
    29	    free(A->row_ptr);
    30	    free(A);
    31	}
