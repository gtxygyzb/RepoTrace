    24	static const char *get_opt(int argc, char **argv, const char *name)
    25	{
    26	    for (int i = 0; i < argc - 1; i++) {
    27	        if (strcmp(argv[i], name) == 0) return argv[i+1];
    28	    }
    29	    return NULL;
    30	}
    31	
    32	static int write_history_file(const SolveResult *res, const char *filename)
    33	{
    34	    FILE *fp = fopen(filename, "w");
    35	    if (!fp) return -1;
    36	    for (int i = 0; i < res->history_len; i++) {
    37	        fprintf(fp, "%d\t%.15e\n", i, res->history[i]);
    38	    }
    39	    fclose(fp);
    40	    return 0;
    41	}
    42	
    43	static void print_solve_summary(const SolveResult *res)
    44	{
    45	    printf("converged: %s\n", res->converged ? "yes" : "no");
    46	    printf("iterations: %d\n", res->iterations);
    47	    printf("residual: %.6e\n", res->relres);
    48	    printf("true_residual: %.6e\n", res->true_residual);
    49	}
    50	
    51	static int validate_ssor_omega(double omega)
    52	{
    53	    if (!(omega > 0.0 && omega < 2.0)) {
    54	        fprintf(stderr, "error: ssor-omega must be in (0,2)\n");
    55	        return 1;
    56	    }
    57	    return 0;
    58	}
    59	
    60	static int cmd_dense_solve(int argc, char **argv)
    61	{
    62	    if (argc < 2) {
    63	        fprintf(stderr, "Error: dense-solve requires <matrix_file> <rhs_file>\n");
    64	        return 1;
    65	    }
    66	
    67	    const char *mat_file = argv[0];
    68	    const char *rhs_file = argv[1];
    69	    const char *out_file = (argc >= 3) ? argv[2] : NULL;
    70	
    71	    DenseMatrix *A = dm_read_text(mat_file);
    72	    if (!A) {
    73	        fprintf(stderr, "Error: cannot read matrix from '%s'\n", mat_file);
    74	        return 1;
    75	    }
    76	
    77	    int n;
    78	    double *b = vec_read_text(rhs_file, &n);
    79	    if (!b) {
    80	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
    81	        dm_destroy(A);
    82	        return 1;
    83	    }
    84	
    85	    if (A->rows != n || A->cols != n) {
    86	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
    87	                A->rows, A->cols, n);
    88	        free(b);
    89	        dm_destroy(A);
    90	        return 1;
    91	    }
    92	
    93	    double *x = vec_create(n);
    94	    if (!x) {
    95	        fprintf(stderr, "Error: allocation failed\n");
    96	        free(b);
    97	        dm_destroy(A);
    98	        return 1;
    99	    }
   100	
   101	    int rc = dm_solve(A, b, x);
   102	    if (rc != 0) {
   103	        fprintf(stderr, "Error: solver failed (singular or ill-conditioned)\n");
   104	        free(x);
   105	        free(b);
   106	        dm_destroy(A);
   107	        return 1;
   108	    }
   109	
   110	    if (out_file) {
   111	        vec_write_text(x, n, out_file);
   112	        printf("Solution written to %s\n", out_file);
   113	    } else {
   114	        printf("Solution:\n");
   115	        vec_print(x, n, stdout);
   116	    }
   117	
   118	    double *r = vec_create(n);
   119	    dm_matvec(A, x, r);
   120	    vec_axpy(-1.0, b, r, n);
   121	    printf("Residual norm: %.6e\n", vec_norm2(r, n));
   122	
   123	    free(r);
   124	    free(x);
   125	    free(b);
   126	    dm_destroy(A);
   127	    return 0;
   128	}
   129	
   130	static int parse_bc(const char *s, PoissonBC *bc)
   131	{
   132	    const char *colon = strchr(s, ':');
   133	    if (!colon || colon == s) return -1;
   134	
   135	    size_t len = colon - s;
   136	    char type[32];
   137	    if (len >= sizeof(type)) return -1;
   138	    memcpy(type, s, len);
   139	    type[len] = '\0';
   140	
   141	    if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
   142	    else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
   143	    else return -1;
   144	
   145	    bc->file = colon + 1;
   146	    return 0;
   147	}
   148	
   149	static int run_solver_and_print(const CSRMatrix *A, const double *b,
   150	                                const char *solver, const char *precond,
   151	                                double tol, int maxiter, int restart,
   152	                                double omega, const char *output,
   153	                                const char *history)
   154	{
   155	    Precond *P = precond_create(A, precond, omega);
   156	    if (!P) {
   157	        fprintf(stderr, "Error: cannot create preconditioner '%s'\n", precond);
   158	        return 1;
   159	    }
   160	
   161	    SolveResult *res = NULL;
   162	    if (strcmp(solver, "cg") == 0) {
   163	        res = cg_solve(A, b, NULL, tol, maxiter, P);
   164	    } else if (strcmp(solver, "gmres") == 0) {
   165	        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);
   166	    } else {
   167	        fprintf(stderr, "Error: unknown solver '%s'\n", solver);
   168	        precond_destroy(P);
   169	        return 1;
   170	    }
   171	
   172	    if (!res) {
   173	        fprintf(stderr, "Error: solver allocation failed\n");
   174	        precond_destroy(P);
   175	        return 1;
   176	    }
   177	
   178	    print_solve_summary(res);
   179	
   180	    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {
   181	        fprintf(stderr, "Error: cannot write output to '%s'\n", output);
   182	    }
   183	    if (history && write_history_file(res, history) != 0) {
   184	        fprintf(stderr, "Error: cannot write history to '%s'\n", history);
   185	    }
   186	
   187	    solve_result_destroy(res);
   188	    precond_destroy(P);
   189	    return 0;
   190	}
   191	
   192	static int cmd_sparse_solve(int argc, char **argv)
   193	{
   194	    const char *input = get_opt(argc, argv, "--input");
   195	    const char *rhs_file = get_opt(argc, argv, "--rhs");
   196	    const char *solver = get_opt(argc, argv, "--solver");
   197	    const char *precond = get_opt(argc, argv, "--precond");
   198	    const char *tol_s = get_opt(argc, argv, "--tol");
   199	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   200	    const char *restart_s = get_opt(argc, argv, "--restart");
   201	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   202	    const char *output = get_opt(argc, argv, "--output");
   203	    const char *history = get_opt(argc, argv, "--history");
   204	
   205	    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {
   206	        fprintf(stderr, "Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\n");
   207	        usage("numsim");
   208	        return 1;
   209	    }
   210	
   211	    double tol = atof(tol_s);
   212	    int maxiter = atoi(maxiter_s);
   213	    int restart = restart_s ? atoi(restart_s) : 30;
   214	    double omega = omega_s ? atof(omega_s) : 1.0;
   215	
   216	    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {
   217	        fprintf(stderr, "Error: invalid solver parameters\n");
   218	        return 1;
   219	    }
   220	    if (validate_ssor_omega(omega) != 0) {
   221	        return 1;
   222	    }
   223	
   224	    CSRMatrix *A = csr_read_mm(input);
   225	    if (!A) {
   226	        fprintf(stderr, "Error: cannot read sparse matrix from '%s'\n", input);
   227	        return 1;
   228	    }
   229	
   230	    int n;
   231	    double *b = vec_read_mm_array(rhs_file, &n);
   232	    if (!b) {
   233	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
   234	        csr_destroy(A);
   235	        return 1;
   236	    }
   237	
   238	    if (A->rows != n || A->cols != n) {
   239	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
   240	                A->rows, A->cols, n);
   241	        free(b);
   242	        csr_destroy(A);
   243	        return 1;
   244	    }
   245	
   246	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   247	
   248	    free(b);
   249	    csr_destroy(A);
   250	    return rc;
   251	}
   252	
   253	static int cmd_poisson(int argc, char **argv)
   254	{
   255	    const char *nx_s = get_opt(argc, argv, "--nx");
   256	    const char *ny_s = get_opt(argc, argv, "--ny");
   257	    const char *x0_s = get_opt(argc, argv, "--x0");
   258	    const char *x1_s = get_opt(argc, argv, "--x1");
   259	    const char *y0_s = get_opt(argc, argv, "--y0");
   260	    const char *y1_s = get_opt(argc, argv, "--y1");
   261	    const char *source = get_opt(argc, argv, "--source");
   262	    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
   263	    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
   264	    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
   265	    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
   266	    const char *solver = get_opt(argc, argv, "--solver");
   267	    const char *precond = get_opt(argc, argv, "--precond");
   268	    const char *tol_s = get_opt(argc, argv, "--tol");
   269	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   270	    const char *restart_s = get_opt(argc, argv, "--restart");
   271	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   272	    const char *output = get_opt(argc, argv, "--output");
   273	    const char *history = get_opt(argc, argv, "--history");
   274	
   275	    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||
   276	        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
   277	        !solver || !precond || !tol_s || !maxiter_s) {
   278	        fprintf(stderr, "Error: poisson requires grid, source, boundary condition, solver, precond, tol, maxiter\n");
   279	        usage("numsim");
   280	        return 1;
   281	    }
   282	
   283	    int nx = atoi(nx_s);
   284	    int ny = atoi(ny_s);
   285	    double x0 = atof(x0_s);
   286	    double x1 = atof(x1_s);
   287	    double y0 = atof(y0_s);
   288	    double y1 = atof(y1_s);
   289	    double tol = atof(tol_s);
   290	    int maxiter = atoi(maxiter_s);
   291	    int restart = restart_s ? atoi(restart_s) : 30;
   292	    double omega = omega_s ? atof(omega_s) : 1.0;
   293	
   294	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {
   295	        fprintf(stderr, "Error: invalid poisson parameters\n");
   296	        return 1;
   297	    }
   298	    if (validate_ssor_omega(omega) != 0) {
   299	        return 1;
   300	    }
   301	
   302	    PoissonBC left, right, bottom, top;
   303	    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
   304	        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
   305	        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
   306	        return 1;
   307	    }
   308	
   309	    CSRMatrix *A = NULL;
   310	    double *b = NULL;
   311	    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {
   312	        fprintf(stderr, "Error: cannot assemble Poisson system\n");
   313	        return 1;
   314	    }
   315	
   316	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   317	
   318	    free(b);
   319	    csr_destroy(A);
   320	    return rc;
   321	}
