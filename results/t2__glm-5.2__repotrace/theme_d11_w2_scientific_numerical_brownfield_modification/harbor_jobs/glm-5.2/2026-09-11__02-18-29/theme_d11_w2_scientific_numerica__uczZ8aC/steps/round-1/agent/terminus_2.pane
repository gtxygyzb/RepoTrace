#ifndef VECTOR_H
#define VECTOR_H

#include <stdio.h>

/* Allocate a zero-initialized vector of length n. Returns NULL on failure. */
double *vec_create(int n);

/* Deep copy: dst[i] = src[i] */
void vec_copy(const double *src, double *dst, int n);

/* Zero out: x[i] = 0 */
void vec_zero(double *x, int n);

/* Scale: x[i] *= a */
void vec_scale(double a, double *x, int n);

/* AXPY: y[i] += a * x[i] */
void vec_axpy(double a, const double *x, double *y, int n);

/* Dot product: sum(x[i] * y[i]) */
double vec_dot(const double *x, const double *y, int n);

/* L2 norm: sqrt(sum(x[i]^2)) */
double vec_norm2(const double *x, int n);

/* Print vector to stream, one value per line */
void vec_print(const double *x, int n, FILE *out);

#endif /* VECTOR_H */
