  206 | static int cmd_sparse_solve(int argc, char **argv)
      | ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  207 | {
      | ~    
  208 |     const char *input = get_opt(argc, argv, "--input");
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
