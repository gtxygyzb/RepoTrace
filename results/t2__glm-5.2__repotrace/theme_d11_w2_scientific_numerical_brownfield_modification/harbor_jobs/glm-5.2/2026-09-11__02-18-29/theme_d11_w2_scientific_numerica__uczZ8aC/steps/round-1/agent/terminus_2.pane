    36	static int write_history_file(const SolveResult *res, const char *filename)
    37	{
    38	    FILE *fp = fopen(filename, "w");
    39	    if (!fp) return -1;
    40	    for (int i = 0; i < res->history_len; i++) {
    41	        fprintf(fp, "%d\t%.15e\t%.15e\n", i, res->history[i], res->precond_history[i]);
    42	    }
    43	    fclose(fp);
    44	    return 0;
    45	}
