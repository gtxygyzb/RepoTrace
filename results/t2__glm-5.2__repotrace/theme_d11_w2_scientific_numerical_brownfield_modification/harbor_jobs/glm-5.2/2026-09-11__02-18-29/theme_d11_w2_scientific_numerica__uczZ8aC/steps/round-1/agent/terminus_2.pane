    74	static int cmd_dense_solve(int argc, char **argv)
    75	{
    76	    if (argc < 2) {
    77	        fprintf(stderr, "Error: dense-solve requires <matrix_file> <rhs_file>\n");
    78	        return 1;
    79	    }
    80	
    81	    const char *mat_file = argv[0];
    82	    const char *rhs_file = argv[1];
    83	    const char *out_file = (argc >= 3) ? argv[2] : NULL;
    84	
    85	    DenseMatrix *A = dm_read_text(mat_file);
    86	    if (!A) {
    87	        fprintf(stderr, "Error: cannot read matrix from '%s'\n", mat_file);
    88	        return 1;
    89	    }
    90	
    91	    int n;
    92	    double *b = vec_read_text(rhs_file, &n);
    93	    if (!b) {
    94	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
    95	        dm_destroy(A);
    96	        return 1;
    97	    }
    98	
    99	    if (A->rows != n || A->cols != n) {
   100	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
   101	                A->rows, A->cols, n);
   102	        free(b);
   103	        dm_destroy(A);
   104	        return 1;
   105	    }
   106	
   107	    double *x = vec_create(n);
   108	    if (!x) {
   109	        fprintf(stderr, "Error: allocation failed\n");
   110	        free(b);
   111	        dm_destroy(A);
   112	        return 1;
   113	    }
   114	
   115	    int rc = dm_solve(A, b, x);
   116	    if (rc != 0) {
   117	        fprintf(stderr, "Error: solver failed (singular or ill-conditioned)\n");
   118	        free(x);
   119	        free(b);
   120	        dm_destroy(A);
   121	        return 1;
   122	    }
   123	
   124	    if (out_file) {
   125	        vec_write_text(x, n, out_file);
   126	        printf("Solution written to %s\n", out_file);
   127	    } else {
   128	        printf("Solution:\n");
   129	        vec_print(x, n, stdout);
   130	    }
   131	
   132	    double *r = vec_create(n);
   133	    dm_matvec(A, x, r);
   134	    vec_axpy(-1.0, b, r, n);
   135	    printf("Residual norm: %.6e\n", vec_norm2(r, n));
   136	
   137	    free(r);
   138	    free(x);
   139	    free(b);
   140	    dm_destroy(A);
   141	    return 0;
   142	}
   143	
   144	static int parse_bc(const char *s, PoissonBC *bc)
   145	{
   146	    const char *colon = strchr(s, ':');
   147	    if (!colon || colon == s) return -1;
   148	
   149	    size_t len = colon - s;
   150	    char type[32];
   151	    if (len >= sizeof(type)) return -1;
   152	    memcpy(type, s, len);
   153	    type[len] = '\0';
   154	
   155	    if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
   156	    else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
   157	    else return -1;
   158	
   159	    bc->file = colon + 1;
   160	    return 0;
   161	}
   162	
   163	static int run_solver_and_print(const CSRMatrix *A, const double *b,
   164	                                const char *solver, const char *precond,
   165	                                double tol, int maxiter, int restart,
   166	                                double omega, const char *output,
   167	                                const char *history)
   168	{
   169	    Precond *P = precond_create(A, precond, omega);
