}

static const char *get_opt(int argc, char **argv, const char *name)
{
    for (int i = 0; i < argc - 1; i++) {
        if (strcmp(argv[i], name) == 0) return argv[i+1];
    }
    return NULL;
}

static int write_history_file(const SolveResult *res, const char *filename)
{
    FILE *fp = fopen(filename, "w");
    if (!fp) return -1;
    for (int i = 0; i < res->history_len; i++) {
        fprintf(fp, "%d\t%.15e\t%.15e\n", i, res->history[i], res->precond_history[i]);
    }
    fclose(fp);
    return 0;
}

static void print_solve_summary(const SolveResult *res)
{
    printf("converged: %s\n", res->converged ? "yes" : "no");
    printf("iterations: %d\n", res->iterations);
    printf("residual: %.6e\n", res->relres);
    printf("true_residual: %.6e\n", res->true_residual);
}

static int validate_ssor_omega(double omega)
{
    if (!(omega > 0.0 && omega < 2.0)) {
        fprintf(stderr, "error: ssor-omega must be in (0,2)\n");
        return 1;
    }
    return 0;
}

static int cmd_dense_solve(int argc, char **argv)
{
    if (argc < 2) {
        fprintf(stderr, "Error: dense-solve requires <matrix_file> <rhs_file>\n");
        return 1;
    }

    const char *mat_file = argv[0];
    const char *rhs_file = argv[1];
    const char *out_file = (argc >= 3) ? argv[2] : NULL;

    DenseMatrix *A = dm_read_text(mat_file);
    if (!A) {
        fprintf(stderr, "Error: cannot read matrix from '%s'\n", mat_file);
        return 1;
    }

    int n;
    double *b = vec_read_text(rhs_file, &n);
    if (!b) {
        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
        dm_destroy(A);
        return 1;
    }

    if (A->rows != n || A->cols != n) {
        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
                A->rows, A->cols, n);
        free(b);
        dm_destroy(A);
        return 1;
    }

    double *x = vec_create(n);
    if (!x) {
        fprintf(stderr, "Error: allocation failed\n");
        free(b);
        dm_destroy(A);
        return 1;
    }

    int rc = dm_solve(A, b, x);
    if (rc != 0) {
        fprintf(stderr, "Error: solver failed (singular or ill-conditioned)\n");
        free(x);
        free(b);
        dm_destroy(A);
        return 1;
    }

    if (out_file) {
        vec_write_text(x, n, out_file);
        printf("Solution written to %s\n", out_file);
    } else {
        printf("Solution:\n");
        vec_print(x, n, stdout);
    }

    double *r = vec_create(n);
    dm_matvec(A, x, r);
    vec_axpy(-1.0, b, r, n);
    printf("Residual norm: %.6e\n", vec_norm2(r, n));

    free(r);
    free(x);
    free(b);
    dm_destroy(A);
    return 0;
}

static int parse_bc(const char *s, PoissonBC *bc)
{
    const char *colon = strchr(s, ':');
    if (!colon || colon == s) return -1;

    size_t len = colon - s;
    char type[32];
    if (len >= sizeof(type)) return -1;
    memcpy(type, s, len);
    type[len] = '\0';

    if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
    else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
    else return -1;

    bc->file = colon + 1;
    return 0;
}

static int run_solver_and_print(const CSRMatrix *A, const double *b,
                                const char *solver, const char *precond,
                                double tol, int maxiter, int restart,
                                double omega, const char *output,
                                const char *history)
{
    Precond *P = precond_create(A, precond, omega);
    if (!P) {
        fprintf(stderr, "Error: cannot create preconditioner '%s'\n", precond);
        return 1;
    }

    SolveResult *res = NULL;
    if (strcmp(solver, "cg") == 0) {
        res = cg_solve(A, b, NULL, tol, maxiter, P);
    } else if (strcmp(solver, "gmres") == 0) {
        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);
    } else {
        fprintf(stderr, "Error: unknown solver '%s'\n", solver);
        precond_destroy(P);
        return 1;
    }

    if (!res) {
        fprintf(stderr, "Error: solver allocation failed\n");
        precond_destroy(P);
        return 1;
    }

    print_solve_summary(res);

    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {
        fprintf(stderr, "Error: cannot write output to '%s'\n", output);
    }
    if (history && write_history_file(res, history) != 0) {
        fprintf(stderr, "Error: cannot write history to '%s'\n", history);
    }

    solve_result_destroy(res);
    precond_destroy(P);
    return 0;
}

static int cmd_sparse_solve(int argc, char **argv)
{
    const char *input = get_opt(argc, argv, "--input");
    const char *rhs_file = get_opt(argc, argv, "--rhs");
    const char *solver = get_opt(argc, argv, "--solver");
    const char *precond = get_opt(argc, argv, "--precond");
    const char *tol_s = get_opt(argc, argv, "--tol");
    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
    const char *restart_s = get_opt(argc, argv, "--restart");
    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
    const char *output = get_opt(argc, argv, "--output");
    const char *history = get_opt(argc, argv, "--history");

    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {
        fprintf(stderr, "Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\n");
        usage("numsim");
        return 1;
    }

    double tol = atof(tol_s);
    int maxiter = atoi(maxiter_s);
    int restart = restart_s ? atoi(restart_s) : 30;
    double omega = omega_s ? atof(omega_s) : 1.0;

    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {
[?2004hroot@n30009:/app# sed -n '1,260p' src/solvers.c
[?2004l#include "solvers.h"
#include "vector.h"
#include <stdlib.h>
#include <math.h>
#include <string.h>

static SolveResult *result_create(int n, int maxiter)
{
    if (maxiter < 0) maxiter = 0;
    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));
    if (!res) return NULL;

    res->x = vec_create(n);
    res->history = (double *)malloc((maxiter + 1) * sizeof(double));
    res->precond_history = (double *)malloc((maxiter + 1) * sizeof(double));
    if (!res->x || !res->history || !res->precond_history) {
        free(res->x);
        free(res->history);
        free(res->precond_history);
        free(res);
        return NULL;
    }
    res->history_len = 0;
    return res;
}

SolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,
                      double tol, int maxiter, Precond *P)
{
    if (!A || !b || A->rows != A->cols) return NULL;
    int n = A->rows;
    if (maxiter < 0) maxiter = 0;

    SolveResult *res = result_create(n, maxiter);
    if (!res) return NULL;

    double *r = vec_create(n);
    double *z = vec_create(n);
    double *p = vec_create(n);
    double *Ap = vec_create(n);
    if (!r || !z || !p || !Ap) {
        free(r); free(z); free(p); free(Ap);
        solve_result_destroy(res);
        return NULL;
    }

    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);

    csr_spmv(A, res->x, Ap);
    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];

    double bnorm = vec_norm2(b, n);
    if (bnorm == 0.0) bnorm = 1.0;

    res->true_residual = vec_norm2(r, n);
    res->relres = res->true_residual / bnorm;
    precond_apply(P, A, r, z);
    double pnorm0 = vec_norm2(z, n);
    res->history[0] = res->relres;
    res->precond_history[0] = pnorm0;
    res->history_len = 1;
    res->converged = (res->relres < tol) ? 1 : 0;
    res->iterations = 0;
    if (res->converged || maxiter == 0) {
        free(r); free(z); free(p); free(Ap);
        return res;
    }

    if (precond_apply(P, A, r, z) != 0) {
        free(r); free(z); free(p); free(Ap);
        return res;
    }
    vec_copy(z, p, n);
    double rz_old = vec_dot(r, z, n);

    for (int iter = 1; iter <= maxiter; iter++) {
        csr_spmv(A, p, Ap);
        double pAp = vec_dot(p, Ap, n);
        if (fabs(pAp) < 1e-30) break;

        double alpha = rz_old / pAp;
        vec_axpy(alpha, p, res->x, n);
        vec_axpy(-alpha, Ap, r, n);

        /* Recompute the true residual rather than relying on the recurrence. */
        csr_spmv(A, res->x, Ap);
        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];

        res->true_residual = vec_norm2(r, n);
        res->relres = res->true_residual / bnorm;
        precond_apply(P, A, r, z);
        double pznorm = vec_norm2(z, n);
        res->history[iter] = res->relres;
        res->precond_history[iter] = pznorm;
        res->history_len = iter + 1;
        res->iterations = iter;

        if (res->relres < tol) {
            res->converged = 1;
            break;
        }

        if (precond_apply(P, A, r, z) != 0) break;
        double rz_new = vec_dot(r, z, n);
        if (fabs(rz_old) < 1e-30) break;
        double beta = rz_new / rz_old;
        vec_scale(beta, p, n);
        vec_axpy(1.0, z, p, n);
        rz_old = rz_new;
    }

    free(r); free(z); free(p); free(Ap);
    return res;
}

static void apply_givens(double *a, double *b, double c, double s)
{
    double t = c * (*a) + s * (*b);
    *b = -s * (*a) + c * (*b);
    *a = t;
}

static int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)
{
    if (kdim <= 0) return -1;

    double *c = (double *)malloc(m * sizeof(double));
    double *s = (double *)malloc(m * sizeof(double));
    if (!c || !s) { free(c); free(s); return -1; }

    for (int i = 0; i < kdim; i++) {
        for (int k = 0; k < i; k++) {
            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);
        }

        double a = H[i*m+i];
        double b = H[(i+1)*m+i];
        if (b == 0.0) {
            c[i] = 1.0;
            s[i] = 0.0;
        } else {
            double r = hypot(a, b);
            c[i] = a / r;
            s[i] = b / r;
        }
        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);
        apply_givens(&g[i], &g[i+1], c[i], s[i]);

    }

    for (int i = kdim - 1; i >= 0; i--) {
        double sum = g[i];
        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];
        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }
        y[i] = sum / H[i*m+i];
    }

    free(c);
    free(s);
    return 0;
}

SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,
                           double tol, int maxiter, int m, Precond *P)
{
    if (!A || !b || A->rows != A->cols) return NULL;
    int n = A->rows;
    if (m <= 0) m = 30;
    if (maxiter < 0) maxiter = 0;

    SolveResult *res = result_create(n, maxiter);
    if (!res) return NULL;

    double *r = vec_create(n);
    double *z = vec_create(n);
    double *Ap = vec_create(n);
    double *Av = vec_create(n);
    double *w = vec_create(n);
    double *g = (double *)malloc((m + 1) * sizeof(double));
    double *y = (double *)malloc(m * sizeof(double));
    double *H = (double *)calloc((m + 1) * m, sizeof(double));
    double *V = (double *)malloc(n * (m + 1) * sizeof(double));

    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {
        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
        solve_result_destroy(res);
        return NULL;
    }

    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);

    csr_spmv(A, res->x, Ap);
    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];

    double bnorm = vec_norm2(b, n);
    if (bnorm == 0.0) bnorm = 1.0;

    res->true_residual = vec_norm2(r, n);
    res->relres = res->true_residual / bnorm;
    precond_apply(P, A, r, z);
    double pnorm0 = vec_norm2(z, n);
    res->history[0] = res->relres;
    res->precond_history[0] = pnorm0;
    res->history_len = 1;
    res->converged = (res->relres < tol) ? 1 : 0;
    res->iterations = 0;
    if (res->converged || maxiter == 0) {
        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
        return res;
    }

    for (int cycle = 1; cycle <= maxiter; cycle++) {
        if (precond_apply(P, A, r, z) != 0) break;
        double beta = vec_norm2(z, n);
        if (beta == 0.0) break;

        for (int i = 0; i < n; i++) V[i] = z[i] / beta;
        for (int i = 0; i <= m; i++) g[i] = 0.0;
        g[0] = beta;
        memset(H, 0, (m + 1) * m * sizeof(double));

        int kdim = 0;
        int fail = 0;
        for (int j = 0; j < m; j++) {
            csr_spmv(A, V + j * n, Av);
            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }

            for (int i = 0; i <= j; i++) {
                double h = vec_dot(w, V + i * n, n);
                H[i*m+j] = h;
                vec_axpy(-h, V + i * n, w, n);
