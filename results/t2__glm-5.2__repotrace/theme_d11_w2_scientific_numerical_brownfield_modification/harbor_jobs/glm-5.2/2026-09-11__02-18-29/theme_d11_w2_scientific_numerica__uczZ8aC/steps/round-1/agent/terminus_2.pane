   265	        return 0;
   266	    }
   267	    return -1;
   268	}
   269	
   270	CSRMatrix *csr_read_mm(const char *filename)
   271	{
   272	    FILE *fp = fopen(filename, "r");
   273	    if (!fp) return NULL;
   274	
   275	    char line[1024];
   276	    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }
   277	    int is_array = 0, is_symmetric = 0;
   278	    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || is_array) {
   279	        fclose(fp);
   280	        return NULL;
   281	    }
   282	
   283	    int rows, cols, nnz;
   284	    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }
   285	    if (sscanf(line, "%d %d %d", &rows, &cols, &nnz) != 3 || rows <= 0 || cols <= 0 || nnz < 0) {
   286	        fclose(fp);
   287	        return NULL;
   288	    }
   289	
   290	    int cap = is_symmetric ? 2 * nnz + 1 : nnz;
   291	    if (cap < 1) cap = 1;
   292	    COOMatrix *coo = coo_create(rows, cols, cap);
   293	    if (!coo) { fclose(fp); return NULL; }
   294	
   295	    int k = 0;
   296	    while (k < coo->nnz && read_non_comment_line(fp, line, sizeof(line)) == 0) {
   297	        int r, c;
   298	        double v;
   299	        if (sscanf(line, "%d %d %lf", &r, &c, &v) != 3) continue;
   300	        if (r < 1 || r > rows || c < 1 || c > cols) continue;
   301	        r--; c--;
   302	
   303	        coo->row[k] = r;
   304	        coo->col[k] = c;
   305	        coo->values[k] = v;
   306	        k++;
   307	
   308	        if (is_symmetric && r != c) {
   309	            coo->row[k] = c;
   310	            coo->col[k] = r;
   311	            coo->values[k] = v;
   312	            k++;
   313	        }
   314	    }
   315	    coo->nnz = k;
   316	
   317	    CSRMatrix *A = coo_to_csr(coo);
   318	    coo_destroy(coo);
   319	    fclose(fp);
   320	    return A;
   321	}
   322	
   323	int csr_write_mm(const CSRMatrix *A, const char *filename)
   324	{
   325	    FILE *fp = fopen(filename, "w");
   326	    if (!fp) return -1;
   327	
   328	    fprintf(fp, "%%%%MatrixMarket matrix coordinate real general\n");
   329	    fprintf(fp, "%d %d %d\n", A->rows, A->cols, A->nnz);
   330	    for (int i = 0; i < A->rows; i++) {
   331	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   332	            fprintf(fp, "%d %d %.15g\n", i+1, A->col_indices[k]+1, A->values[k]);
   333	        }
   334	    }
   335	    fclose(fp);
   336	    return 0;
   337	}
   338	
   339	double *vec_read_mm_array(const char *filename, int *n_out)
   340	{
   341	    FILE *fp = fopen(filename, "r");
   342	    if (!fp) return NULL;
   343	
   344	    char line[1024];
   345	    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }
   346	    int is_array = 0, is_symmetric = 0;
   347	    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || !is_array) {
   348	        fclose(fp);
   349	        return NULL;
   350	    }
   351	
   352	    int rows, cols;
   353	    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }
   354	    if (sscanf(line, "%d %d", &rows, &cols) != 2 || rows <= 0 || cols != 1) {
   355	        fclose(fp);
   356	        return NULL;
   357	    }
   358	
   359	    double *x = vec_create(rows);
   360	    if (!x) { fclose(fp); return NULL; }
   361	
   362	    int i = 0;
   363	    while (i < rows && read_non_comment_line(fp, line, sizeof(line)) == 0) {
   364	        double v;
   365	        if (sscanf(line, "%lf", &v) != 1) { free(x); fclose(fp); return NULL; }
   366	        x[i++] = v;
   367	    }
   368	    if (i != rows) { free(x); fclose(fp); return NULL; }
   369	
   370	    fclose(fp);
   371	    *n_out = rows;
   372	    return x;
   373	}
   374	
   375	int vec_write_mm_array(const double *x, int n, const char *filename)
   376	{
   377	    FILE *fp = fopen(filename, "w");
   378	    if (!fp) return -1;
   379	    fprintf(fp, "%%%%MatrixMarket matrix array real general\n");
   380	    fprintf(fp, "%d 1\n", n);
   381	    for (int i = 0; i < n; i++) {
   382	        fprintf(fp, "%.15g\n", x[i]);
   383	    }
   384	    fclose(fp);
   385	    return 0;
   386	}
