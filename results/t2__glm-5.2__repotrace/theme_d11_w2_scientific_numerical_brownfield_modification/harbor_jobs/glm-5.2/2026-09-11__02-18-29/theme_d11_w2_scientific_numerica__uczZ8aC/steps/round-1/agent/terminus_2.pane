   328	static int cmd_heat(int argc, char **argv)
   329	{
   330	    const char *nx_s = get_opt(argc, argv, "--nx");
   331	    const char *ny_s = get_opt(argc, argv, "--ny");
   332	    const char *x0_s = get_opt(argc, argv, "--x0");
