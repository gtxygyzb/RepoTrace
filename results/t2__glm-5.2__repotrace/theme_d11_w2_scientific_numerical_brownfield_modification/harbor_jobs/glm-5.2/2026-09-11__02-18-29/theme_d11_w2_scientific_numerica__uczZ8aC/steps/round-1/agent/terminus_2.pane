   402	static int cmd_convdiff(int argc, char **argv)
   403	{
   404	    const char *nx_s = get_opt(argc, argv, "--nx");
   405	    const char *ny_s = get_opt(argc, argv, "--ny");
   406	    const char *x0_s = get_opt(argc, argv, "--x0");
   407	    const char *x1_s = get_opt(argc, argv, "--x1");
   408	    const char *y0_s = get_opt(argc, argv, "--y0");
   409	    const char *y1_s = get_opt(argc, argv, "--y1");
   410	    const char *kappa_s = get_opt(argc, argv, "--kappa");
   411	    const char *vx_s = get_opt(argc, argv, "--vx");
   412	    const char *vy_s = get_opt(argc, argv, "--vy");
   413	    const char *source = get_opt(argc, argv, "--source");
   414	    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
   415	    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
   416	    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
   417	    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
   418	    const char *solver = get_opt(argc, argv, "--solver");
   419	    const char *precond = get_opt(argc, argv, "--precond");
   420	    const char *tol_s = get_opt(argc, argv, "--tol");
   421	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   422	    const char *restart_s = get_opt(argc, argv, "--restart");
   423	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   424	    const char *output = get_opt(argc, argv, "--output");
   425	    const char *history = get_opt(argc, argv, "--history");
   426	
   427	    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !kappa_s ||
   428	        !vx_s || !vy_s || !source ||
   429	        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
   430	        !solver || !precond || !tol_s || !maxiter_s || !output) {
   431	        fprintf(stderr, "Error: convdiff requires grid, domain, kappa, vx, vy, source, boundary conditions, solver, precond, tol, maxiter, output\n");
   432	        usage("numsim");
   433	        return 1;
   434	    }
   435	
   436	    int nx = atoi(nx_s);
   437	    int ny = atoi(ny_s);
   438	    double x0 = atof(x0_s);
   439	    double x1 = atof(x1_s);
   440	    double y0 = atof(y0_s);
   441	    double y1 = atof(y1_s);
   442	    double kappa = atof(kappa_s);
   443	    double vx = atof(vx_s);
   444	    double vy = atof(vy_s);
   445	    double tol = atof(tol_s);
   446	    int maxiter = atoi(maxiter_s);
   447	    int restart = restart_s ? atoi(restart_s) : 30;
   448	    double omega = omega_s ? atof(omega_s) : 1.0;
   449	
   450	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || kappa <= 0.0 ||
   451	        tol <= 0.0 || maxiter < 0 || restart <= 0) {
   452	        fprintf(stderr, "Error: invalid convdiff parameters\n");
   453	        return 1;
   454	    }
   455	    if (validate_ssor_omega(omega) != 0) {
   456	        return 1;
   457	    }
   458	
   459	    PoissonBC left, right, bottom, top;
   460	    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
   461	        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
   462	        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
   463	        return 1;
   464	    }
   465	
   466	    double hx = (x1 - x0) / (nx - 1);
   467	    double hy = (y1 - y0) / (ny - 1);
   468	    double pe = convdiff_peclet(vx, vy, hx, hy, kappa);
   469	    if (pe > 1.0) {
   470	        fprintf(stderr, "warning: cell Peclet number %.6e > 1, solution may exhibit oscillations\n", pe);
   471	    }
   472	
   473	    CSRMatrix *A = NULL;
   474	    double *b = NULL;
   475	    if (convdiff_assemble(nx, ny, x0, x1, y0, y1, kappa, vx, vy,
   476	                          source, left, right, bottom, top, &A, &b) != 0) {
   477	        fprintf(stderr, "Error: cannot assemble convdiff system\n");
   478	        return 1;
   479	    }
   480	
   481	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   482	    printf("peclet: %.6e\n", pe);
   483	
   484	    free(b);
   485	    csr_destroy(A);
   486	    return rc;
   487	}
