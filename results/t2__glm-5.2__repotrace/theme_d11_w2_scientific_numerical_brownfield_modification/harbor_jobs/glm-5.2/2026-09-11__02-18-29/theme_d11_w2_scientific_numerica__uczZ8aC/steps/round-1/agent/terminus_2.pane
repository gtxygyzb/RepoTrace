    37	static void init_random_vector(double *v, int n)
    38	{
    39	    srand(42);
    40	    for (int i = 0; i < n; i++) v[i] = (double)rand() / (double)RAND_MAX;
    41	    double nrm = vec_norm2(v, n);
    42	    if (nrm > 0.0) {
    43	        for (int i = 0; i < n; i++) v[i] /= nrm;
    44	    } else {
    45	        v[0] = 1.0;
    46	    }
    47	}
