   327	static int cmd_heat(int argc, char **argv)
   328	{
   329	    const char *nx_s = get_opt(argc, argv, "--nx");
   330	    const char *ny_s = get_opt(argc, argv, "--ny");
   331	    const char *x0_s = get_opt(argc, argv, "--x0");
   332	    const char *x1_s = get_opt(argc, argv, "--x1");
   333	    const char *y0_s = get_opt(argc, argv, "--y0");
   334	    const char *y1_s = get_opt(argc, argv, "--y1");
   335	    const char *alpha_s = get_opt(argc, argv, "--alpha");
   336	    const char *dt_s = get_opt(argc, argv, "--dt");
   337	    const char *nsteps_s = get_opt(argc, argv, "--nsteps");
   338	    const char *scheme = get_opt(argc, argv, "--scheme");
   339	    const char *ic_file = get_opt(argc, argv, "--ic");
   340	    const char *source_arg = get_opt(argc, argv, "--source");
   341	    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
   342	    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
   343	    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
   344	    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
   345	    const char *solver = get_opt(argc, argv, "--solver");
