   230	static int mm_parse_header(const char *line, int *is_array, int *is_symmetric)
   231	{
   232	    char buf[1024];
   233	    strncpy(buf, line, sizeof(buf)-1);
   234	    buf[sizeof(buf)-1] = '\0';
   235	
   236	    char *tok = strtok(buf, " \t\r\n");
   237	    if (!tok || strcmp(tok, "%%MatrixMarket") != 0) return -1;
   238	
   239	    tok = strtok(NULL, " \t\r\n");
   240	    if (!tok || strcmp(tok, "matrix") != 0) return -1;
   241	
   242	    tok = strtok(NULL, " \t\r\n");
   243	    if (!tok) return -1;
   244	    if (strcmp(tok, "coordinate") == 0) *is_array = 0;
   245	    else if (strcmp(tok, "array") == 0) *is_array = 1;
   246	    else return -1;
   247	
   248	    tok = strtok(NULL, " \t\r\n");
   249	    if (!tok) return -1;
   250	    if (strcmp(tok, "real") != 0 && strcmp(tok, "double") != 0) return -1;
   251	
   252	    *is_symmetric = 0;
   253	    tok = strtok(NULL, " \t\r\n");
   254	    if (tok && strcmp(tok, "symmetric") == 0) *is_symmetric = 1;
   255	
   256	    return 0;
   257	}
   258	
   259	static int read_non_comment_line(FILE *fp, char *buf, int bufsize)
   260	{
   261	    while (fgets(buf, bufsize, fp)) {
   262	        char *s = buf;
   263	        while (*s == ' ' || *s == '\t') s++;
   264	        if (*s == '%' || *s == '\n' || *s == '\r' || *s == '\0') continue;
   265	        return 0;
   266	    }
   267	    return -1;
   268	}
   269	
   270	CSRMatrix *csr_read_mm(const char *filename)
   271	{
   272	    FILE *fp = fopen(filename, "r");
   273	    if (!fp) return NULL;
   274	
   275	    char line[1024];
   276	    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }
   277	    int is_array = 0, is_symmetric = 0;
   278	    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || is_array) {
   279	        fclose(fp);
   280	        return NULL;
   281	    }
   282	
   283	    int rows, cols, nnz;
   284	    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }
   285	    if (sscanf(line, "%d %d %d", &rows, &cols, &nnz) != 3 || rows <= 0 || cols <= 0 || nnz < 0) {
   286	        fclose(fp);
   287	        return NULL;
   288	    }
   289	
   290	    int cap = is_symmetric ? 2 * nnz + 1 : nnz;
   291	    if (cap < 1) cap = 1;
   292	    COOMatrix *coo = coo_create(rows, cols, cap);
   293	    if (!coo) { fclose(fp); return NULL; }
   294	
   295	    int k = 0;
   296	    while (k < coo->nnz && read_non_comment_line(fp, line, sizeof(line)) == 0) {
   297	        int r, c;
   298	        double v;
   299	        if (sscanf(line, "%d %d %lf", &r, &c, &v) != 3) continue;
   300	        if (r < 1 || r > rows || c < 1 || c > cols) continue;
   301	        r--; c--;
   302	
   303	        coo->row[k] = r;
   304	        coo->col[k] = c;
   305	        coo->values[k] = v;
   306	        k++;
   307	
   308	        if (is_symmetric && r != c) {
   309	            coo->row[k] = c;
   310	            coo->col[k] = r;
   311	            coo->values[k] = v;
   312	            k++;
   313	        }
   314	    }
   315	    coo->nnz = k;
   316	
   317	    CSRMatrix *A = coo_to_csr(coo);
   318	    coo_destroy(coo);
   319	    fclose(fp);
   320	    return A;
   321	}
   322	
   323	int csr_write_mm(const CSRMatrix *A, const char *filename)
   324	{
   325	    FILE *fp = fopen(filename, "w");
   326	    if (!fp) return -1;
   327	
   328	    fprintf(fp, "%%%%MatrixMarket matrix coordinate real general\n");
   329	    fprintf(fp, "%d %d %d\n", A->rows, A->cols, A->nnz);
   330	    for (int i = 0; i < A->rows; i++) {
   331	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   332	            fprintf(fp, "%d %d %.15g\n", i+1, A->col_indices[k]+1, A->values[k]);
   333	        }
   334	    }
   335	    fclose(fp);
   336	    return 0;
   337	}
   338	
   339	double *vec_read_mm_array(const char *filename, int *n_out)
   340	{
   341	    FILE *fp = fopen(filename, "r");
   342	    if (!fp) return NULL;
   343	
