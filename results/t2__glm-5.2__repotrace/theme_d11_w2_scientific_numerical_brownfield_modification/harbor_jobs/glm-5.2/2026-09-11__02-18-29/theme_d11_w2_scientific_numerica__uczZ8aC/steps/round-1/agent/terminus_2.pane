   530	            free(x);
   531	            csr_destroy(A);
   532	            return 1;
   533	        }
   534	        result_len = A->cols;
   535	    } else {
   536	        if (n != A->cols) {
   537	            fprintf(stderr, "error: dimension mismatch\n");
