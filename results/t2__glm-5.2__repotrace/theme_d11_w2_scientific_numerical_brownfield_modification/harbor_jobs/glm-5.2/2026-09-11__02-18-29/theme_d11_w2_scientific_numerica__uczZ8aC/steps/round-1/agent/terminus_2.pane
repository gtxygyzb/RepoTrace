   128	static int parse_bc(const char *s, PoissonBC *bc)
   129	{
   130	    const char *colon = strchr(s, ':');
   131	    if (!colon || colon == s) return -1;
   132	
   133	    size_t len = colon - s;
   134	    char type[32];
   135	    if (len >= sizeof(type)) return -1;
   136	    memcpy(type, s, len);
   137	    type[len] = '\0';
   138	
   139	    if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
   140	    else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
[?2004hroot@n30009:/app# nl -ba src/main.c | sed -n '141,280p'
[?2004l   141	    else return -1;
   142	
   143	    bc->file = colon + 1;
   144	    return 0;
   145	}
   146	
   147	static int run_solver_and_print(const CSRMatrix *A, const double *b,
   148	                                const char *solver, const char *precond,
   149	                                double tol, int maxiter, int restart,
   150	                                double omega, const char *output,
   151	                                const char *history)
   152	{
   153	    Precond *P = precond_create(A, precond, omega);
   154	    if (!P) {
   155	        fprintf(stderr, "Error: cannot create preconditioner '%s'\n", precond);
   156	        return 1;
   157	    }
   158	
   159	    SolveResult *res = NULL;
   160	    if (strcmp(solver, "cg") == 0) {
   161	        res = cg_solve(A, b, NULL, tol, maxiter, P);
   162	    } else if (strcmp(solver, "gmres") == 0) {
   163	        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);
   164	    } else {
   165	        fprintf(stderr, "Error: unknown solver '%s'\n", solver);
   166	        precond_destroy(P);
   167	        return 1;
   168	    }
   169	
   170	    if (!res) {
   171	        fprintf(stderr, "Error: solver allocation failed\n");
   172	        precond_destroy(P);
   173	        return 1;
   174	    }
   175	
   176	    print_solve_summary(res);
   177	
   178	    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {
   179	        fprintf(stderr, "Error: cannot write output to '%s'\n", output);
   180	    }
   181	    if (history && write_history_file(res, history) != 0) {
   182	        fprintf(stderr, "Error: cannot write history to '%s'\n", history);
   183	    }
   184	
   185	    solve_result_destroy(res);
   186	    precond_destroy(P);
   187	    return 0;
   188	}
