    33	COOMatrix *coo_create(int rows, int cols, int nnz)
    34	{
    35	    COOMatrix *A = (COOMatrix *)malloc(sizeof(COOMatrix));
    36	    if (!A) return NULL;
    37	    A->rows = rows;
    38	    A->cols = cols;
    39	    A->nnz = nnz;
    40	    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));
    41	    A->row = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    42	    A->col = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    43	    if (!A->values || !A->row || !A->col) {
    44	        coo_destroy(A);
    45	        return NULL;
    46	    }
    47	    return A;
    48	}
    49	
    50	void coo_destroy(COOMatrix *A)
    51	{
    52	    if (!A) return;
    53	    free(A->values);
    54	    free(A->row);
    55	    free(A->col);
    56	    free(A);
    57	}
