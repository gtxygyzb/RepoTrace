}


static int cmd_matinfo(int argc, char **argv)
{
    const char *input = get_opt(argc, argv, "--input");
    if (!input) {
        fprintf(stderr, "Error: matinfo requires --input <mtx_file>\n");
        usage("numsim");
        return 1;
    }

    CSRMatrix *A = csr_read_mm(input);
    if (!A) {
        fprintf(stderr, "error: cannot read matrix file\n");
        return 1;
    }

    int rows = A->rows;
    int cols = A->cols;

    int symmetric = 0;
    if (rows == cols) {
        symmetric = 1;
        for (int i = 0; i < rows && symmetric; i++) {
            for (int k = A->row_ptr[i]; k < A->row_ptr[i+1] && symmetric; k++) {
                int j = A->col_indices[k];
                double v = A->values[k];

                int idx = -1;
                for (int l = A->row_ptr[j]; l < A->row_ptr[j+1]; l++) {
                    if (A->col_indices[l] == i) {
                        idx = l;
                        break;
                    }
                }
                if (idx < 0) {
                    symmetric = 0;
                    break;
                }

                double vt = A->values[idx];
                double diff = fabs(v - vt);
                double denom = fmax(fabs(v), fmax(fabs(vt), 1e-30));
                if (diff >= 1e-12 * denom) {
                    symmetric = 0;
                    break;
                }
            }
        }
    }

    int bandwidth = 0;
    int nonzero_count = 0;
    double frobenius_norm = 0.0;
    double max_abs_value = 0.0;
    double min_abs_nonzero = 0.0;

    for (int i = 0; i < A->rows; i++) {
        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
            int j = A->col_indices[k];
            double v = A->values[k];
            double av = fabs(v);

            frobenius_norm += v * v;

            if (av > max_abs_value) max_abs_value = av;

            if (av != 0.0) {
                nonzero_count++;

                int bw = i - j;
                if (bw < 0) bw = -bw;
                if (bw > bandwidth) bandwidth = bw;

                if (min_abs_nonzero == 0.0 || av < min_abs_nonzero) {
                    min_abs_nonzero = av;
                }
            }
        }
    }

    frobenius_norm = sqrt(frobenius_norm);

    int strict = 1;
    int weak = 1;
    for (int i = 0; i < A->rows; i++) {
        double diag = 0.0;
        double offsum = 0.0;

        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
            int j = A->col_indices[k];
            if (j == i) {
                diag = A->values[k];
            } else {
                offsum += fabs(A->values[k]);
            }
        }

        if (fabs(diag) > offsum) {
            continue;
        }
        if (fabs(diag) >= offsum) {
            strict = 0;
        } else {
            strict = 0;
            weak = 0;
            break;
        }
    }

    const char *diagonal_dominance = strict ? "strict" : (weak ? "weak" : "none");

    printf("rows: %d\n", rows);
    printf("cols: %d\n", cols);
    printf("nnz: %d\n", nonzero_count);
    printf("symmetric: %s\n", symmetric ? "yes" : "no");
    printf("bandwidth: %d\n", bandwidth);
    printf("frobenius_norm: %.15e\n", frobenius_norm);
    printf("diagonal_dominance: %s\n", diagonal_dominance);
    printf("max_abs_value: %.15e\n", max_abs_value);
    printf("min_abs_nonzero: %.15e\n", min_abs_nonzero);

    csr_destroy(A);
    return 0;
}

int main(int argc, char **argv)
{
    if (argc < 2) {
        usage(argv[0]);
        return 1;
    }

    const char *cmd = argv[1];

    if (strcmp(cmd, "dense-solve") == 0) {
        return cmd_dense_solve(argc - 2, argv + 2);
    } else if (strcmp(cmd, "sparse-solve") == 0) {
        return cmd_sparse_solve(argc - 2, argv + 2);
    } else if (strcmp(cmd, "poisson") == 0) {
        return cmd_poisson(argc - 2, argv + 2);
    } else if (strcmp(cmd, "heat") == 0) {
        return cmd_heat(argc - 2, argv + 2);
    } else if (strcmp(cmd, "convdiff") == 0) {
        return cmd_convdiff(argc - 2, argv + 2);
    } else if (strcmp(cmd, "--help") == 0 || strcmp(cmd, "-h") == 0) {
        usage(argv[0]);
        return 0;
    } else if (strcmp(cmd, "matinfo") == 0) {
        return cmd_matinfo(argc - 2, argv + 2);
    } else if (strcmp(cmd, "eigenvalue") == 0) {
        return cmd_eigenvalue(argc - 2, argv + 2);
    } else {
        fprintf(stderr, "Error: unknown command '%s'\n", cmd);
        usage(argv[0]);
        return 1;
    }
}
