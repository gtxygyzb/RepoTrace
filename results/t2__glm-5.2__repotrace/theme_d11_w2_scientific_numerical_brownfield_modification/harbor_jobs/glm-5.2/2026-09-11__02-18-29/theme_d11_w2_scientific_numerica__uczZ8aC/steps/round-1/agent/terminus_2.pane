   361	
   362	    int nx = atoi(nx_s);
   363	    int ny = atoi(ny_s);
   364	    double x0 = atof(x0_s);
   365	    double x1 = atof(x1_s);
   366	    double y0 = atof(y0_s);
   367	    double y1 = atof(y1_s);
   368	    double alpha = atof(alpha_s);
   369	    double dt = atof(dt_s);
   370	    int nsteps = atoi(nsteps_s);
   371	    double tol = atof(tol_s);
   372	    int maxiter = atoi(maxiter_s);
   373	    int restart = restart_s ? atoi(restart_s) : 30;
   374	    double omega = omega_s ? atof(omega_s) : 1.0;
   375	
   376	    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || alpha <= 0.0 ||
   377	        dt <= 0.0 || nsteps < 0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {
   378	        fprintf(stderr, "Error: invalid heat parameters\n");
   379	        return 1;
