#ifndef DENSE_H
#define DENSE_H

#include <stdio.h>

/*
 * Dense matrix stored in row-major order.
 * Element (i,j) is at data[i * cols + j].
 */
typedef struct {
    int    rows;
    int    cols;
    double *data;
} DenseMatrix;

/* Lifecycle */
DenseMatrix *dm_create(int rows, int cols);
void         dm_destroy(DenseMatrix *m);

/* Element access */
double dm_get(const DenseMatrix *m, int i, int j);
void   dm_set(DenseMatrix *m, int i, int j, double val);

/* Operations */
void dm_matvec(const DenseMatrix *A, const double *x, double *y);

/*
 * Solve Ax = b using LU decomposition with partial pivoting.
 * A is not modified (internal copy is made).
 * Returns 0 on success, -1 on singular matrix or allocation failure.
 */
int dm_solve(const DenseMatrix *A, const double *b, double *x);

/* Debug */
void dm_print(const DenseMatrix *m, FILE *out);

#endif /* DENSE_H */
