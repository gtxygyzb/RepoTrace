    78	    double *b = vec_read_text(rhs_file, &n);
    79	    if (!b) {
    80	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
    81	        dm_destroy(A);
    82	        return 1;
    83	    }
    84	
    85	    if (A->rows != n || A->cols != n) {
    86	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
    87	                A->rows, A->cols, n);
    88	        free(b);
    89	        dm_destroy(A);
    90	        return 1;
    91	    }
    92	
