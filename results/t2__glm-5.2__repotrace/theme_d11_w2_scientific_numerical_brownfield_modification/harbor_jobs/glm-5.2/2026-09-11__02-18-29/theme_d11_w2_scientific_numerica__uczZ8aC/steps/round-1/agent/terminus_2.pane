static SolveResult *result_create(int n, int maxiter)
{
    if (maxiter < 0) maxiter = 0;
    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));
    if (!res) return NULL;

    res->x = vec_create(n);
    res->history = (double *)malloc((maxiter + 1) * sizeof(double));
    res->precond_history = (double *)malloc((maxiter + 1) * sizeof(double));
    if (!res->x || !res->history || !res->precond_history) {
        free(res->x);
        free(res->history);
        free(res->precond_history);
        free(res);
        return NULL;
    }
    res->history_len = 0;
    return res;
}

