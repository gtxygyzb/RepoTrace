   151	
   152	SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,
   153	                         double tol, int maxiter, int m, Precond *P)
   154	{
   155	    if (!A || !b || A->rows != A->cols) return NULL;
   156	    int n = A->rows;
   157	    if (m <= 0) m = 30;
   158	    if (maxiter < 0) maxiter = 0;
   159	
   160	    SolveResult *res = result_create(n, maxiter);
   161	    if (!res) return NULL;
   162	
   163	    double *r = vec_create(n);
   164	    double *z = vec_create(n);
   165	    double *Ap = vec_create(n);
   166	    double *Av = vec_create(n);
