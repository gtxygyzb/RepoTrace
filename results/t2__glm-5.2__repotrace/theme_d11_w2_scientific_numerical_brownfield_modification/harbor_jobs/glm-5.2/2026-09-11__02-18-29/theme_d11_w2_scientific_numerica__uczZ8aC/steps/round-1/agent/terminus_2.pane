    28	static const char *get_opt(int argc, char **argv, const char *name)
    29	{
    30	    for (int i = 0; i < argc - 1; i++) {
    31	        if (strcmp(argv[i], name) == 0) return argv[i+1];
    32	    }
    33	    return NULL;
    34	}
