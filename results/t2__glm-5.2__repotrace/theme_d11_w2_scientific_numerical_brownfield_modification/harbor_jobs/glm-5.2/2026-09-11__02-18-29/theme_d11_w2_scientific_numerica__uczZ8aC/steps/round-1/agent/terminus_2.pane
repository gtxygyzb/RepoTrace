   150	void csr_spmv(const CSRMatrix *A, const double *x, double *y)
   151	{
   152	    for (int i = 0; i < A->rows; i++) {
   153	        double s = 0.0;
   154	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   155	            s += A->values[k] * x[A->col_indices[k]];
   156	        }
   157	        y[i] = s;
   158	    }
   159	}
   160	
   161	static int csr_find_in_row(const CSRMatrix *A, int row, int col)
   162	{
   163	    int lo = A->row_ptr[row];
   164	    int hi = A->row_ptr[row+1] - 1;
   165	    while (lo <= hi) {
   166	        int mid = (lo + hi) / 2;
   167	        if (A->col_indices[mid] == col) return mid;
   168	        if (A->col_indices[mid] < col) lo = mid + 1;
   169	        else hi = mid - 1;
   170	    }
   171	    return -1;
   172	}
   173	
   174	CSRMatrix *csr_transpose(const CSRMatrix *A)
   175	{
   176	    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);
   177	    if (!T) return NULL;
   178	
   179	    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;
   180	    for (int k = 0; k < A->nnz; k++) {
   181	        T->row_ptr[A->col_indices[k] + 1]++;
   182	    }
   183	    for (int i = 0; i < A->cols; i++) {
   184	        T->row_ptr[i+1] += T->row_ptr[i];
   185	    }
   186	
   187	    int *next = (int *)malloc((A->cols > 0 ? A->cols : 1) * sizeof(int));
   188	    if (!next) { csr_destroy(T); return NULL; }
   189	    for (int i = 0; i < A->cols; i++) next[i] = T->row_ptr[i];
   190	
   191	    for (int i = 0; i < A->rows; i++) {
   192	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   193	            int c = A->col_indices[k];
   194	            int pos = next[c]++;
   195	            T->col_indices[pos] = i;
   196	            T->values[pos] = A->values[k];
   197	        }
   198	    }
   199	
   200	    free(next);
   201	    return T;
   202	}
   203	
   204	int csr_is_symmetric(const CSRMatrix *A, double tol)
   205	{
   206	    if (A->rows != A->cols) return 0;
   207	    for (int i = 0; i < A->rows; i++) {
   208	        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
   209	            int j = A->col_indices[k];
   210	            int idx = csr_find_in_row(A, j, i);
   211	            if (idx < 0) return 0;
   212	            if (fabs(A->values[k] - A->values[idx]) > tol) return 0;
   213	        }
   214	    }
   215	    return 1;
   216	}
   217	
   218	double *csr_diagonal(const CSRMatrix *A)
   219	{
   220	    int n = A->rows < A->cols ? A->rows : A->cols;
   221	    double *diag = vec_create(n);
   222	    if (!diag) return NULL;
   223	    for (int i = 0; i < n; i++) {
   224	        int idx = csr_find_in_row(A, i, i);
   225	        diag[i] = (idx >= 0) ? A->values[idx] : 0.0;
   226	    }
   227	    return diag;
   228	}
   229	
   230	static int mm_parse_header(const char *line, int *is_array, int *is_symmetric)
   231	{
   232	    char buf[1024];
   233	    strncpy(buf, line, sizeof(buf)-1);
   234	    buf[sizeof(buf)-1] = '\0';
   235	
   236	    char *tok = strtok(buf, " \t\r\n");
   237	    if (!tok || strcmp(tok, "%%MatrixMarket") != 0) return -1;
   238	
   239	    tok = strtok(NULL, " \t\r\n");
   240	    if (!tok || strcmp(tok, "matrix") != 0) return -1;
   241	
   242	    tok = strtok(NULL, " \t\r\n");
   243	    if (!tok) return -1;
   244	    if (strcmp(tok, "coordinate") == 0) *is_array = 0;
   245	    else if (strcmp(tok, "array") == 0) *is_array = 1;
   246	    else return -1;
   247	
   248	    tok = strtok(NULL, " \t\r\n");
   249	    if (!tok) return -1;
   250	    if (strcmp(tok, "real") != 0 && strcmp(tok, "double") != 0) return -1;
   251	
   252	    *is_symmetric = 0;
   253	    tok = strtok(NULL, " \t\r\n");
   254	    if (tok && strcmp(tok, "symmetric") == 0) *is_symmetric = 1;
   255	
   256	    return 0;
   257	}
   258	
   259	static int read_non_comment_line(FILE *fp, char *buf, int bufsize)
   260	{
   261	    while (fgets(buf, bufsize, fp)) {
   262	        char *s = buf;
   263	        while (*s == ' ' || *s == '\t') s++;
   264	        if (*s == '%' || *s == '\n' || *s == '\r' || *s == '\0') continue;
   265	        return 0;
   266	    }
   267	    return -1;
   268	}
   269	
   270	CSRMatrix *csr_read_mm(const char *filename)
   271	{
   272	    FILE *fp = fopen(filename, "r");
   273	    if (!fp) return NULL;
   274	
   275	    char line[1024];
   276	    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }
   277	    int is_array = 0, is_symmetric = 0;
   278	    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || is_array) {
   279	        fclose(fp);
   280	        return NULL;
   281	    }
   282	
   283	    int rows, cols, nnz;
   284	    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }
   285	    if (sscanf(line, "%d %d %d", &rows, &cols, &nnz) != 3 || rows <= 0 || cols <= 0 || nnz < 0) {
   286	        fclose(fp);
   287	        return NULL;
   288	    }
   289	
   290	    int cap = is_symmetric ? 2 * nnz + 1 : nnz;
   291	    if (cap < 1) cap = 1;
   292	    COOMatrix *coo = coo_create(rows, cols, cap);
   293	    if (!coo) { fclose(fp); return NULL; }
   294	
   295	    int k = 0;
   296	    while (k < coo->nnz && read_non_comment_line(fp, line, sizeof(line)) == 0) {
   297	        int r, c;
   298	        double v;
   299	        if (sscanf(line, "%d %d %lf", &r, &c, &v) != 3) continue;
   300	        if (r < 1 || r > rows || c < 1 || c > cols) continue;
   301	        r--; c--;
   302	
   303	        coo->row[k] = r;
   304	        coo->col[k] = c;
   305	        coo->values[k] = v;
   306	        k++;
   307	
   308	        if (is_symmetric && r != c) {
   309	            coo->row[k] = c;
   310	            coo->col[k] = r;
   311	            coo->values[k] = v;
   312	            k++;
   313	        }
   314	    }
   315	    coo->nnz = k;
   316	
   317	    CSRMatrix *A = coo_to_csr(coo);
   318	    coo_destroy(coo);
   319	    fclose(fp);
   320	    return A;
