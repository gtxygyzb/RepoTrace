[?2004l    if (validate_ssor_omega(omega) != 0) {
        return 1;
    }

    CSRMatrix *A = csr_read_mm(input);
    if (!A) {
        fprintf(stderr, "Error: cannot read sparse matrix from '%s'\n", input);
        return 1;
    }

    int n;
    double *b = vec_read_mm_array(rhs_file, &n);
    if (!b) {
        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
        csr_destroy(A);
        return 1;
    }

    if (A->rows != n || A->cols != n) {
        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
                A->rows, A->cols, n);
        free(b);
        csr_destroy(A);
        return 1;
    }

    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);

    free(b);
    csr_destroy(A);
    return rc;
}

static int cmd_poisson(int argc, char **argv)
{
    const char *nx_s = get_opt(argc, argv, "--nx");
    const char *ny_s = get_opt(argc, argv, "--ny");
    const char *x0_s = get_opt(argc, argv, "--x0");
    const char *x1_s = get_opt(argc, argv, "--x1");
    const char *y0_s = get_opt(argc, argv, "--y0");
    const char *y1_s = get_opt(argc, argv, "--y1");
    const char *source = get_opt(argc, argv, "--source");
    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
    const char *solver = get_opt(argc, argv, "--solver");
    const char *precond = get_opt(argc, argv, "--precond");
    const char *tol_s = get_opt(argc, argv, "--tol");
    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
    const char *restart_s = get_opt(argc, argv, "--restart");
    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
    const char *output = get_opt(argc, argv, "--output");
    const char *history = get_opt(argc, argv, "--history");

    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||
        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
        !solver || !precond || !tol_s || !maxiter_s) {
        fprintf(stderr, "Error: poisson requires grid, source, boundary condition, solver, precond, tol, maxiter\n");
        usage("numsim");
        return 1;
    }

    int nx = atoi(nx_s);
    int ny = atoi(ny_s);
    double x0 = atof(x0_s);
    double x1 = atof(x1_s);
    double y0 = atof(y0_s);
    double y1 = atof(y1_s);
    double tol = atof(tol_s);
    int maxiter = atoi(maxiter_s);
    int restart = restart_s ? atoi(restart_s) : 30;
    double omega = omega_s ? atof(omega_s) : 1.0;

    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {
        fprintf(stderr, "Error: invalid poisson parameters\n");
        return 1;
    }
    if (validate_ssor_omega(omega) != 0) {
        return 1;
    }

    PoissonBC left, right, bottom, top;
    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
        return 1;
    }

    CSRMatrix *A = NULL;
    double *b = NULL;
    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {
        fprintf(stderr, "Error: cannot assemble Poisson system\n");
        return 1;
    }

    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);

    free(b);
    csr_destroy(A);
    return rc;
}

static int cmd_heat(int argc, char **argv)
{
    const char *nx_s = get_opt(argc, argv, "--nx");
    const char *ny_s = get_opt(argc, argv, "--ny");
    const char *x0_s = get_opt(argc, argv, "--x0");
    const char *x1_s = get_opt(argc, argv, "--x1");
    const char *y0_s = get_opt(argc, argv, "--y0");
    const char *y1_s = get_opt(argc, argv, "--y1");
    const char *alpha_s = get_opt(argc, argv, "--alpha");
    const char *dt_s = get_opt(argc, argv, "--dt");
    const char *nsteps_s = get_opt(argc, argv, "--nsteps");
    const char *scheme = get_opt(argc, argv, "--scheme");
    const char *ic_file = get_opt(argc, argv, "--ic");
    const char *source_arg = get_opt(argc, argv, "--source");
    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
    const char *solver = get_opt(argc, argv, "--solver");
    const char *precond = get_opt(argc, argv, "--precond");
    const char *tol_s = get_opt(argc, argv, "--tol");
    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
    const char *restart_s = get_opt(argc, argv, "--restart");
    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
    const char *output = get_opt(argc, argv, "--output");

    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !alpha_s ||
        !dt_s || !nsteps_s || !scheme || !ic_file || !source_arg ||
        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
        !solver || !precond || !tol_s || !maxiter_s || !output) {
        fprintf(stderr, "Error: heat requires grid, domain, alpha, dt, nsteps, scheme, ic, source, boundary conditions, solver, precond, tol, maxiter, output\n");
        usage("numsim");
        return 1;
    }

    int nx = atoi(nx_s);
    int ny = atoi(ny_s);
    double x0 = atof(x0_s);
    double x1 = atof(x1_s);
    double y0 = atof(y0_s);
    double y1 = atof(y1_s);
    double alpha = atof(alpha_s);
    double dt = atof(dt_s);
    int nsteps = atoi(nsteps_s);
    double tol = atof(tol_s);
    int maxiter = atoi(maxiter_s);
    int restart = restart_s ? atoi(restart_s) : 30;
    double omega = omega_s ? atof(omega_s) : 1.0;

    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || alpha <= 0.0 ||
        dt <= 0.0 || nsteps < 0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {
        fprintf(stderr, "Error: invalid heat parameters\n");
        return 1;
    }
    if (validate_ssor_omega(omega) != 0) {
        return 1;
    }

    PoissonBC left, right, bottom, top;
    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
        return 1;
    }

    int rc = heat_solve(nx, ny, x0, x1, y0, y1, alpha, dt, nsteps, scheme,
                       ic_file, source_arg, left, right, bottom, top,
                       solver, precond, tol, maxiter, restart, omega, output);
    if (rc != 0) {
        fprintf(stderr, "Error: heat solve failed\n");
        return 1;
    }
    return 0;
}

static int cmd_convdiff(int argc, char **argv)
{
    const char *nx_s = get_opt(argc, argv, "--nx");
    const char *ny_s = get_opt(argc, argv, "--ny");
    const char *x0_s = get_opt(argc, argv, "--x0");
    const char *x1_s = get_opt(argc, argv, "--x1");
    const char *y0_s = get_opt(argc, argv, "--y0");
    const char *y1_s = get_opt(argc, argv, "--y1");
    const char *kappa_s = get_opt(argc, argv, "--kappa");
    const char *vx_s = get_opt(argc, argv, "--vx");
    const char *vy_s = get_opt(argc, argv, "--vy");
    const char *source = get_opt(argc, argv, "--source");
    const char *bc_left_s = get_opt(argc, argv, "--bc-left");
    const char *bc_right_s = get_opt(argc, argv, "--bc-right");
    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");
    const char *bc_top_s = get_opt(argc, argv, "--bc-top");
    const char *solver = get_opt(argc, argv, "--solver");
    const char *precond = get_opt(argc, argv, "--precond");
    const char *tol_s = get_opt(argc, argv, "--tol");
    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
    const char *restart_s = get_opt(argc, argv, "--restart");
    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
    const char *output = get_opt(argc, argv, "--output");
    const char *history = get_opt(argc, argv, "--history");

    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !kappa_s ||
        !vx_s || !vy_s || !source ||
        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||
        !solver || !precond || !tol_s || !maxiter_s || !output) {
        fprintf(stderr, "Error: convdiff requires grid, domain, kappa, vx, vy, source, boundary conditions, solver, precond, tol, maxiter, output\n");
        usage("numsim");
        return 1;
    }

    int nx = atoi(nx_s);
    int ny = atoi(ny_s);
    double x0 = atof(x0_s);
    double x1 = atof(x1_s);
    double y0 = atof(y0_s);
    double y1 = atof(y1_s);
    double kappa = atof(kappa_s);
    double vx = atof(vx_s);
    double vy = atof(vy_s);
    double tol = atof(tol_s);
    int maxiter = atoi(maxiter_s);
    int restart = restart_s ? atoi(restart_s) : 30;
    double omega = omega_s ? atof(omega_s) : 1.0;

    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || kappa <= 0.0 ||
        tol <= 0.0 || maxiter < 0 || restart <= 0) {
        fprintf(stderr, "Error: invalid convdiff parameters\n");
        return 1;
    }
    if (validate_ssor_omega(omega) != 0) {
        return 1;
    }

    PoissonBC left, right, bottom, top;
    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||
        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {
        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\n");
        return 1;
    }

    double hx = (x1 - x0) / (nx - 1);
    double hy = (y1 - y0) / (ny - 1);
    double pe = convdiff_peclet(vx, vy, hx, hy, kappa);
    if (pe > 1.0) {
        fprintf(stderr, "warning: cell Peclet number %.6e > 1, solution may exhibit oscillations\n", pe);
    }

    CSRMatrix *A = NULL;
    double *b = NULL;
    if (convdiff_assemble(nx, ny, x0, x1, y0, y1, kappa, vx, vy,
                          source, left, right, bottom, top, &A, &b) != 0) {
        fprintf(stderr, "Error: cannot assemble convdiff system\n");
        return 1;
    }

    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
    printf("peclet: %.6e\n", pe);

    free(b);
    csr_destroy(A);
    return rc;
}

int main(int argc, char **argv)
{
    if (argc < 2) {
        usage(argv[0]);
        return 1;
    }

    const char *cmd = argv[1];

    if (strcmp(cmd, "dense-solve") == 0) {
        return cmd_dense_solve(argc - 2, argv + 2);
    } else if (strcmp(cmd, "sparse-solve") == 0) {
        return cmd_sparse_solve(argc - 2, argv + 2);
    } else if (strcmp(cmd, "poisson") == 0) {
        return cmd_poisson(argc - 2, argv + 2);
    } else if (strcmp(cmd, "heat") == 0) {
        return cmd_heat(argc - 2, argv + 2);
    } else if (strcmp(cmd, "convdiff") == 0) {
        return cmd_convdiff(argc - 2, argv + 2);
    } else if (strcmp(cmd, "--help") == 0 || strcmp(cmd, "-h") == 0) {
        usage(argv[0]);
        return 0;
    } else {
        fprintf(stderr, "Error: unknown command '%s'\n", cmd);
        usage(argv[0]);
        return 1;
    }
}
[?2004hroot@n30009:/app# sed -n '1,280p' src/solvers.c
[?2004l#include "solvers.h"
#include "vector.h"
#include <stdlib.h>
#include <math.h>
#include <string.h>

static SolveResult *result_create(int n, int maxiter)
{
    if (maxiter < 0) maxiter = 0;
    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));
    if (!res) return NULL;

    res->x = vec_create(n);
    res->history = (double *)malloc((maxiter + 1) * sizeof(double));
    if (!res->x || !res->history) {
        free(res->x);
        free(res->history);
        free(res);
        return NULL;
    }
    res->history_len = 0;
    return res;
}

SolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,
                      double tol, int maxiter, Precond *P)
{
    if (!A || !b || A->rows != A->cols) return NULL;
    int n = A->rows;
    if (maxiter < 0) maxiter = 0;

    SolveResult *res = result_create(n, maxiter);
    if (!res) return NULL;

    double *r = vec_create(n);
    double *z = vec_create(n);
    double *p = vec_create(n);
    double *Ap = vec_create(n);
    if (!r || !z || !p || !Ap) {
        free(r); free(z); free(p); free(Ap);
        solve_result_destroy(res);
        return NULL;
    }

    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);

    csr_spmv(A, res->x, Ap);
    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];

    double bnorm = vec_norm2(b, n);
    if (bnorm == 0.0) bnorm = 1.0;

    res->true_residual = vec_norm2(r, n);
    res->relres = res->true_residual / bnorm;
    res->history[0] = res->relres;
    res->history_len = 1;
    res->converged = (res->relres < tol) ? 1 : 0;
    res->iterations = 0;
    if (res->converged || maxiter == 0) {
        free(r); free(z); free(p); free(Ap);
        return res;
    }

    if (precond_apply(P, A, r, z) != 0) {
        free(r); free(z); free(p); free(Ap);
        return res;
    }
    vec_copy(z, p, n);
    double rz_old = vec_dot(r, z, n);

    for (int iter = 1; iter <= maxiter; iter++) {
        csr_spmv(A, p, Ap);
        double pAp = vec_dot(p, Ap, n);
        if (fabs(pAp) < 1e-30) break;

        double alpha = rz_old / pAp;
        vec_axpy(alpha, p, res->x, n);
        vec_axpy(-alpha, Ap, r, n);

        /* Recompute the true residual rather than relying on the recurrence. */
        csr_spmv(A, res->x, Ap);
        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];

        res->true_residual = vec_norm2(r, n);
        res->relres = res->true_residual / bnorm;
        res->history[iter] = res->relres;
        res->history_len = iter + 1;
        res->iterations = iter;

        if (res->relres < tol) {
            res->converged = 1;
            break;
        }

        if (precond_apply(P, A, r, z) != 0) break;
        double rz_new = vec_dot(r, z, n);
        if (fabs(rz_old) < 1e-30) break;
        double beta = rz_new / rz_old;
        vec_scale(beta, p, n);
        vec_axpy(1.0, z, p, n);
        rz_old = rz_new;
    }

    free(r); free(z); free(p); free(Ap);
    return res;
}

static void apply_givens(double *a, double *b, double c, double s)
{
    double t = c * (*a) + s * (*b);
    *b = -s * (*a) + c * (*b);
    *a = t;
}

static int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)
{
    if (kdim <= 0) return -1;

    double *c = (double *)malloc(m * sizeof(double));
    double *s = (double *)malloc(m * sizeof(double));
    if (!c || !s) { free(c); free(s); return -1; }

    for (int i = 0; i < kdim; i++) {
        for (int k = 0; k < i; k++) {
            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);
        }

        double a = H[i*m+i];
        double b = H[(i+1)*m+i];
        if (b == 0.0) {
            c[i] = 1.0;
            s[i] = 0.0;
        } else {
            double r = hypot(a, b);
            c[i] = a / r;
            s[i] = b / r;
        }
        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);
        apply_givens(&g[i], &g[i+1], c[i], s[i]);

    }

    for (int i = kdim - 1; i >= 0; i--) {
        double sum = g[i];
        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];
        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }
        y[i] = sum / H[i*m+i];
    }

    free(c);
    free(s);
    return 0;
}

SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,
                           double tol, int maxiter, int m, Precond *P)
{
    if (!A || !b || A->rows != A->cols) return NULL;
    int n = A->rows;
    if (m <= 0) m = 30;
    if (maxiter < 0) maxiter = 0;

    SolveResult *res = result_create(n, maxiter);
    if (!res) return NULL;

    double *r = vec_create(n);
    double *z = vec_create(n);
    double *Ap = vec_create(n);
    double *Av = vec_create(n);
    double *w = vec_create(n);
    double *g = (double *)malloc((m + 1) * sizeof(double));
    double *y = (double *)malloc(m * sizeof(double));
    double *H = (double *)calloc((m + 1) * m, sizeof(double));
    double *V = (double *)malloc(n * (m + 1) * sizeof(double));

    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {
        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
        solve_result_destroy(res);
        return NULL;
    }

    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);

    csr_spmv(A, res->x, Ap);
    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];

    double bnorm = vec_norm2(b, n);
    if (bnorm == 0.0) bnorm = 1.0;

    res->true_residual = vec_norm2(r, n);
    res->relres = res->true_residual / bnorm;
    res->history[0] = res->relres;
    res->history_len = 1;
    res->converged = (res->relres < tol) ? 1 : 0;
    res->iterations = 0;
    if (res->converged || maxiter == 0) {
        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
        return res;
    }

    for (int cycle = 1; cycle <= maxiter; cycle++) {
        if (precond_apply(P, A, r, z) != 0) break;
        double beta = vec_norm2(z, n);
        if (beta == 0.0) break;

        for (int i = 0; i < n; i++) V[i] = z[i] / beta;
        for (int i = 0; i <= m; i++) g[i] = 0.0;
        g[0] = beta;
        memset(H, 0, (m + 1) * m * sizeof(double));

        int kdim = 0;
        int fail = 0;
        for (int j = 0; j < m; j++) {
            csr_spmv(A, V + j * n, Av);
            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }

            for (int i = 0; i <= j; i++) {
                double h = vec_dot(w, V + i * n, n);
                H[i*m+j] = h;
                vec_axpy(-h, V + i * n, w, n);
            }

            double hnorm = vec_norm2(w, n);
            H[(j+1)*m+j] = hnorm;
            kdim = j + 1;

            if (hnorm < 1e-14) break;

            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;
        }
        if (fail) break;
        if (kdim == 0) break;

        for (int i = 0; i < kdim; i++) y[i] = 0.0;
        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;

        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);

        csr_spmv(A, res->x, Ap);
        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];

        res->true_residual = vec_norm2(r, n);
        res->relres = res->true_residual / bnorm;
        res->history[cycle] = res->relres;
        res->history_len = cycle + 1;
        res->iterations = cycle;

        if (res->relres < tol) {
            res->converged = 1;
            break;
        }
    }

    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);
    return res;
}

void solve_result_destroy(SolveResult *res)
{
    if (!res) return;
    free(res->x);
    free(res->history);
    free(res);
}
[?2004hroot@n30009:/app# sed -n '1,360p' src/precond.c
[?2004l#include "precond.h"
#include "vector.h"
#include <stdlib.h>
#include <string.h>
#include <math.h>

static int find_in_row(const CSRMatrix *A, int row, int col)
{
    int lo = A->row_ptr[row];
    int hi = A->row_ptr[row+1] - 1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        if (A->col_indices[mid] == col) return mid;
        if (A->col_indices[mid] < col) lo = mid + 1;
        else hi = mid - 1;
    }
    return -1;
}

static CSRMatrix *csr_copy(const CSRMatrix *A)
{
    CSRMatrix *B = csr_create(A->rows, A->cols, A->nnz);
    if (!B) return NULL;
    memcpy(B->values, A->values, A->nnz * sizeof(double));
    memcpy(B->col_indices, A->col_indices, A->nnz * sizeof(int));
    memcpy(B->row_ptr, A->row_ptr, (A->rows + 1) * sizeof(int));
    return B;
}

static int ilu0_factorize(CSRMatrix *LU)
{
    int n = LU->rows;
    for (int i = 0; i < n; i++) {
        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {
            int c = LU->col_indices[k];
            if (c >= i) break;

            int d = find_in_row(LU, c, c);
            if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;

            LU->values[k] /= LU->values[d];
            double aik = LU->values[k];

            for (int l = LU->row_ptr[c]; l < LU->row_ptr[c+1]; l++) {
                int j = LU->col_indices[l];
                if (j <= c) continue;
                int idx = find_in_row(LU, i, j);
                if (idx >= 0) LU->values[idx] -= aik * LU->values[l];
            }
        }
    }
    return 0;
}

static int ilu_forward_solve(const CSRMatrix *LU, const double *r, double *y)
{
    for (int i = 0; i < LU->rows; i++) {
        double s = r[i];
        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {
            int j = LU->col_indices[k];
            if (j < i) s -= LU->values[k] * y[j];
            else break;
        }
        y[i] = s;
    }
    return 0;
}

static int ilu_backward_solve(const CSRMatrix *LU, const double *y, double *z)
{
    for (int i = LU->rows - 1; i >= 0; i--) {
        double s = y[i];
        int d = -1;
        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {
            int j = LU->col_indices[k];
            if (j == i) d = k;
            else if (j > i) s -= LU->values[k] * z[j];
        }
        if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;
        z[i] = s / LU->values[d];
    }
    return 0;
}

Precond *precond_create(const CSRMatrix *A, const char *name, double omega)
{
    if (!A || !name || A->rows != A->cols) return NULL;

    Precond *P = (Precond *)calloc(1, sizeof(Precond));
    if (!P) return NULL;

    P->n = A->rows;
    P->omega = (omega > 0.0) ? omega : 1.0;

    if (strcmp(name, "none") == 0) {
        P->type = PRECOND_NONE;
    } else if (strcmp(name, "jacobi") == 0) {
        P->type = PRECOND_JACOBI;
        P->diag = csr_diagonal(A);
        if (!P->diag) { precond_destroy(P); return NULL; }
    } else if (strcmp(name, "ilu0") == 0) {
        P->type = PRECOND_ILU0;
        P->lu = csr_copy(A);
        if (!P->lu) { precond_destroy(P); return NULL; }
        if (ilu0_factorize(P->lu) != 0) { precond_destroy(P); return NULL; }
    } else if (strcmp(name, "ssor") == 0) {
        P->type = PRECOND_SSOR;
        P->ssor_A = A;
        P->diag = csr_diagonal(A);
        if (!P->diag) { precond_destroy(P); return NULL; }
    } else {
        precond_destroy(P);
        return NULL;
    }

    return P;
}

void precond_destroy(Precond *P)
{
    if (!P) return;
    free(P->diag);
    csr_destroy(P->lu);
    free(P);
}

int precond_apply(Precond *P, const CSRMatrix *A, const double *r, double *z)
{
    int n = A ? A->rows : (P ? P->n : 0);
    if (!P || P->type == PRECOND_NONE) {
        vec_copy(r, z, n);
        return 0;
    }

    switch (P->type) {
    case PRECOND_JACOBI:
        for (int i = 0; i < n; i++) {
            if (fabs(P->diag[i]) < 1e-15) return -1;
            z[i] = r[i] / P->diag[i];
        }
        return 0;

    case PRECOND_ILU0: {
        double *y = vec_create(n);
        if (!y) return -1;
        if (ilu_forward_solve(P->lu, r, y) != 0) { free(y); return -1; }
        if (ilu_backward_solve(P->lu, y, z) != 0) { free(y); return -1; }
        free(y);
        return 0;
    }

    case PRECOND_SSOR: {
        const CSRMatrix *M = A ? A : P->ssor_A;
        if (!M) return -1;
        vec_zero(z, n);

        for (int i = 0; i < n; i++) {
            double diag = P->diag[i];
            if (fabs(diag) < 1e-15) return -1;
            double sum = 0.0;
            for (int k = M->row_ptr[i]; k < M->row_ptr[i+1]; k++) {
                int j = M->col_indices[k];
                if (j != i) sum += M->values[k] * z[j];
            }
            z[i] = (1.0 - P->omega) * z[i] + (P->omega / diag) * (r[i] - sum);
        }
        for (int i = n - 1; i >= 0; i--) {
            double diag = P->diag[i];
            if (fabs(diag) < 1e-15) return -1;
            double sum = 0.0;
            for (int k = M->row_ptr[i]; k < M->row_ptr[i+1]; k++) {
                int j = M->col_indices[k];
                if (j != i) sum += M->values[k] * z[j];
            }
            z[i] = (1.0 - P->omega) * z[i] + (P->omega / diag) * (r[i] - sum);
        }
        return 0;
    }

    default:
        vec_copy(r, z, n);
        return 0;
    }
}
[?2004hroot@n30009:/app# sed -n '1,260p' src/sparse.c
[?2004l#include "sparse.h"
#include "vector.h"
#include <stdlib.h>
#include <string.h>
#include <math.h>

CSRMatrix *csr_create(int rows, int cols, int nnz)
{
    CSRMatrix *A = (CSRMatrix *)malloc(sizeof(CSRMatrix));
    if (!A) return NULL;
    A->rows = rows;
    A->cols = cols;
    A->nnz = nnz;
    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));
    A->col_indices = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    A->row_ptr = (int *)calloc((rows >= 0 ? rows + 1 : 1), sizeof(int));
    if (!A->values || !A->col_indices || !A->row_ptr) {
        csr_destroy(A);
        return NULL;
    }
    return A;
}

void csr_destroy(CSRMatrix *A)
{
    if (!A) return;
    free(A->values);
    free(A->col_indices);
    free(A->row_ptr);
    free(A);
}

COOMatrix *coo_create(int rows, int cols, int nnz)
{
    COOMatrix *A = (COOMatrix *)malloc(sizeof(COOMatrix));
    if (!A) return NULL;
    A->rows = rows;
    A->cols = cols;
    A->nnz = nnz;
    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));
    A->row = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    A->col = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));
    if (!A->values || !A->row || !A->col) {
        coo_destroy(A);
        return NULL;
    }
    return A;
}

void coo_destroy(COOMatrix *A)
{
    if (!A) return;
    free(A->values);
    free(A->row);
    free(A->col);
    free(A);
}

static const COOMatrix *g_coo_sort_data = NULL;

static int coo_qsort_cmp(const void *pa, const void *pb)
{
    int ia = *(const int *)pa;
    int ib = *(const int *)pb;
    const COOMatrix *A = g_coo_sort_data;
    if (A->row[ia] != A->row[ib]) return A->row[ia] - A->row[ib];
    return A->col[ia] - A->col[ib];
}

static COOMatrix *coo_sort_dedup(const COOMatrix *A)
{
    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);
    if (!out) return NULL;

    int *idx = (int *)malloc((A->nnz > 0 ? A->nnz : 1) * sizeof(int));
    if (!idx) { coo_destroy(out); return NULL; }
    for (int i = 0; i < A->nnz; i++) idx[i] = i;

    g_coo_sort_data = A;
    qsort(idx, A->nnz, sizeof(int), coo_qsort_cmp);
    g_coo_sort_data = NULL;

    int k = 0;
    for (int i = 0; i < A->nnz; i++) {
        int src = idx[i];
        if (k > 0 && out->row[k-1] == A->row[src] && out->col[k-1] == A->col[src]) {
            out->values[k-1] += A->values[src];
        } else {
            out->row[k] = A->row[src];
            out->col[k] = A->col[src];
            out->values[k] = A->values[src];
            k++;
        }
    }
    out->nnz = k;
    free(idx);
    return out;
}

COOMatrix *csr_to_coo(const CSRMatrix *A)
{
    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);
    if (!out) return NULL;
    int k = 0;
    for (int i = 0; i < A->rows; i++) {
        for (int j = A->row_ptr[i]; j < A->row_ptr[i+1]; j++) {
            out->row[k] = i;
            out->col[k] = A->col_indices[j];
            out->values[k] = A->values[j];
            k++;
        }
    }
    out->nnz = k;
    return out;
}

CSRMatrix *coo_to_csr(const COOMatrix *A)
{
    COOMatrix *sorted = coo_sort_dedup(A);
    if (!sorted) return NULL;

    CSRMatrix *out = csr_create(sorted->rows, sorted->cols, sorted->nnz);
    if (!out) { coo_destroy(sorted); return NULL; }

    for (int i = 0; i <= sorted->rows; i++) out->row_ptr[i] = 0;

    for (int k = 0; k < sorted->nnz; k++) {
        out->row_ptr[sorted->row[k] + 1]++;
    }
    for (int i = 0; i < sorted->rows; i++) {
        out->row_ptr[i+1] += out->row_ptr[i];
    }

    int *next = (int *)malloc((sorted->rows > 0 ? sorted->rows : 1) * sizeof(int));
    if (!next) { csr_destroy(out); coo_destroy(sorted); return NULL; }
    for (int i = 0; i < sorted->rows; i++) next[i] = out->row_ptr[i];

    for (int k = 0; k < sorted->nnz; k++) {
        int r = sorted->row[k];
        int pos = next[r]++;
        out->col_indices[pos] = sorted->col[k];
        out->values[pos] = sorted->values[k];
    }

    free(next);
    coo_destroy(sorted);
    return out;
}

void csr_spmv(const CSRMatrix *A, const double *x, double *y)
{
    for (int i = 0; i < A->rows; i++) {
        double s = 0.0;
        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
            s += A->values[k] * x[A->col_indices[k]];
        }
        y[i] = s;
    }
}

static int csr_find_in_row(const CSRMatrix *A, int row, int col)
{
    int lo = A->row_ptr[row];
    int hi = A->row_ptr[row+1] - 1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        if (A->col_indices[mid] == col) return mid;
        if (A->col_indices[mid] < col) lo = mid + 1;
        else hi = mid - 1;
    }
    return -1;
}

CSRMatrix *csr_transpose(const CSRMatrix *A)
{
    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);
    if (!T) return NULL;

    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;
    for (int k = 0; k < A->nnz; k++) {
        T->row_ptr[A->col_indices[k] + 1]++;
    }
    for (int i = 0; i < A->cols; i++) {
        T->row_ptr[i+1] += T->row_ptr[i];
    }

    int *next = (int *)malloc((A->cols > 0 ? A->cols : 1) * sizeof(int));
    if (!next) { csr_destroy(T); return NULL; }
    for (int i = 0; i < A->cols; i++) next[i] = T->row_ptr[i];

    for (int i = 0; i < A->rows; i++) {
        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
            int c = A->col_indices[k];
            int pos = next[c]++;
            T->col_indices[pos] = i;
            T->values[pos] = A->values[k];
        }
    }

    free(next);
    return T;
}

int csr_is_symmetric(const CSRMatrix *A, double tol)
{
    if (A->rows != A->cols) return 0;
    for (int i = 0; i < A->rows; i++) {
        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
            int j = A->col_indices[k];
            int idx = csr_find_in_row(A, j, i);
            if (idx < 0) return 0;
            if (fabs(A->values[k] - A->values[idx]) > tol) return 0;
        }
    }
    return 1;
}

double *csr_diagonal(const CSRMatrix *A)
{
    int n = A->rows < A->cols ? A->rows : A->cols;
    double *diag = vec_create(n);
    if (!diag) return NULL;
    for (int i = 0; i < n; i++) {
        int idx = csr_find_in_row(A, i, i);
        diag[i] = (idx >= 0) ? A->values[idx] : 0.0;
    }
    return diag;
}

static int mm_parse_header(const char *line, int *is_array, int *is_symmetric)
{
    char buf[1024];
    strncpy(buf, line, sizeof(buf)-1);
    buf[sizeof(buf)-1] = '\0';

    char *tok = strtok(buf, " \t\r\n");
    if (!tok || strcmp(tok, "%%MatrixMarket") != 0) return -1;

    tok = strtok(NULL, " \t\r\n");
    if (!tok || strcmp(tok, "matrix") != 0) return -1;

    tok = strtok(NULL, " \t\r\n");
    if (!tok) return -1;
    if (strcmp(tok, "coordinate") == 0) *is_array = 0;
    else if (strcmp(tok, "array") == 0) *is_array = 1;
    else return -1;

    tok = strtok(NULL, " \t\r\n");
    if (!tok) return -1;
    if (strcmp(tok, "real") != 0 && strcmp(tok, "double") != 0) return -1;

    *is_symmetric = 0;
    tok = strtok(NULL, " \t\r\n");
    if (tok && strcmp(tok, "symmetric") == 0) *is_symmetric = 1;

    return 0;
}

static int read_non_comment_line(FILE *fp, char *buf, int bufsize)
{
[?2004hroot@n30009:/app# sed -n '1,220p' src/vector.c
[?2004l#include "vector.h"
#include <stdlib.h>
#include <string.h>
#include <math.h>

double *vec_create(int n)
{
    if (n <= 0) return NULL;
    return calloc(n, sizeof(double));
}

void vec_copy(const double *src, double *dst, int n)
{
    memcpy(dst, src, (size_t)n * sizeof(double));
}

void vec_zero(double *x, int n)
{
    memset(x, 0, (size_t)n * sizeof(double));
}

void vec_scale(double a, double *x, int n)
{
    int i;
    for (i = 0; i < n; i++) x[i] *= a;
}

void vec_axpy(double a, const double *x, double *y, int n)
{
    int i;
    for (i = 0; i < n; i++) y[i] += a * x[i];
}

double vec_dot(const double *x, const double *y, int n)
{
    double s = 0.0;
    int i;
    for (i = 0; i < n; i++) s += x[i] * y[i];
    return s;
}

double vec_norm2(const double *x, int n)
{
    return sqrt(vec_dot(x, x, n));
}

void vec_print(const double *x, int n, FILE *out)
{
    int i;
    for (i = 0; i < n; i++)
        fprintf(out, "%.15g\n", x[i]);
}
