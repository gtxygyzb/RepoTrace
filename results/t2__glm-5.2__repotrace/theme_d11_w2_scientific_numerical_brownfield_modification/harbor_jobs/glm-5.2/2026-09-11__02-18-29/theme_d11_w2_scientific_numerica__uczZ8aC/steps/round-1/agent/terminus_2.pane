    65	static int cmd_dense_solve(int argc, char **argv)
    66	{
    67	    if (argc < 2) {
    68	        fprintf(stderr, "Error: dense-solve requires <matrix_file> <rhs_file>\n");
    69	        return 1;
    70	    }
    71	
    72	    const char *mat_file = argv[0];
    73	    const char *rhs_file = argv[1];
    74	    const char *out_file = (argc >= 3) ? argv[2] : NULL;
    75	
    76	    DenseMatrix *A = dm_read_text(mat_file);
    77	    if (!A) {
    78	        fprintf(stderr, "Error: cannot read matrix from '%s'\n", mat_file);
    79	        return 1;
    80	    }
    81	
    82	    int n;
    83	    double *b = vec_read_text(rhs_file, &n);
    84	    if (!b) {
    85	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
    86	        dm_destroy(A);
    87	        return 1;
    88	    }
    89	
    90	    if (A->rows != n || A->cols != n) {
    91	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
    92	                A->rows, A->cols, n);
    93	        free(b);
    94	        dm_destroy(A);
    95	        return 1;
    96	    }
    97	
    98	    double *x = vec_create(n);
    99	    if (!x) {
   100	        fprintf(stderr, "Error: allocation failed\n");
   101	        free(b);
   102	        dm_destroy(A);
   103	        return 1;
   104	    }
   105	
   106	    int rc = dm_solve(A, b, x);
   107	    if (rc != 0) {
   108	        fprintf(stderr, "Error: solver failed (singular or ill-conditioned)\n");
   109	        free(x);
   110	        free(b);
   111	        dm_destroy(A);
   112	        return 1;
   113	    }
   114	
   115	    if (out_file) {
   116	        vec_write_text(x, n, out_file);
   117	        printf("Solution written to %s\n", out_file);
   118	    } else {
   119	        printf("Solution:\n");
   120	        vec_print(x, n, stdout);
[?2004hroot@n30009:/app# nl -ba src/main.c | sed -n '120,260p'
[?2004l   120	        vec_print(x, n, stdout);
   121	    }
   122	
   123	    double *r = vec_create(n);
   124	    dm_matvec(A, x, r);
   125	    vec_axpy(-1.0, b, r, n);
   126	    printf("Residual norm: %.6e\n", vec_norm2(r, n));
   127	
   128	    free(r);
   129	    free(x);
   130	    free(b);
   131	    dm_destroy(A);
   132	    return 0;
   133	}
   134	
   135	static int parse_bc(const char *s, PoissonBC *bc)
   136	{
   137	    const char *colon = strchr(s, ':');
   138	    if (!colon || colon == s) return -1;
   139	
   140	    size_t len = colon - s;
   141	    char type[32];
   142	    if (len >= sizeof(type)) return -1;
   143	    memcpy(type, s, len);
   144	    type[len] = '\0';
   145	
   146	    if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
   147	    else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
   148	    else return -1;
   149	
   150	    bc->file = colon + 1;
   151	    return 0;
   152	}
   153	
   154	static int run_solver_and_print(const CSRMatrix *A, const double *b,
   155	                                const char *solver, const char *precond,
   156	                                double tol, int maxiter, int restart,
   157	                                double omega, const char *output,
   158	                                const char *history)
   159	{
   160	    Precond *P = precond_create(A, precond, omega);
   161	    if (!P) {
   162	        fprintf(stderr, "Error: cannot create preconditioner '%s'\n", precond);
   163	        return 1;
   164	    }
   165	
   166	    SolveResult *res = NULL;
   167	    if (strcmp(solver, "cg") == 0) {
   168	        res = cg_solve(A, b, NULL, tol, maxiter, P);
   169	    } else if (strcmp(solver, "gmres") == 0) {
   170	        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);
   171	    } else {
   172	        fprintf(stderr, "Error: unknown solver '%s'\n", solver);
   173	        precond_destroy(P);
   174	        return 1;
   175	    }
   176	
   177	    if (!res) {
   178	        fprintf(stderr, "Error: solver allocation failed\n");
   179	        precond_destroy(P);
   180	        return 1;
   181	    }
   182	
   183	    print_solve_summary(res);
   184	
   185	    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {
   186	        fprintf(stderr, "Error: cannot write output to '%s'\n", output);
   187	    }
   188	    if (history && write_history_file(res, history) != 0) {
   189	        fprintf(stderr, "Error: cannot write history to '%s'\n", history);
   190	    }
   191	
   192	    solve_result_destroy(res);
   193	    precond_destroy(P);
   194	    return 0;
   195	}
   196	
   197	static int cmd_sparse_solve(int argc, char **argv)
   198	{
   199	    const char *input = get_opt(argc, argv, "--input");
   200	    const char *rhs_file = get_opt(argc, argv, "--rhs");
   201	    const char *solver = get_opt(argc, argv, "--solver");
   202	    const char *precond = get_opt(argc, argv, "--precond");
   203	    const char *tol_s = get_opt(argc, argv, "--tol");
   204	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   205	    const char *restart_s = get_opt(argc, argv, "--restart");
   206	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   207	    const char *output = get_opt(argc, argv, "--output");
   208	    const char *history = get_opt(argc, argv, "--history");
   209	
   210	    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {
   211	        fprintf(stderr, "Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\n");
   212	        usage("numsim");
   213	        return 1;
   214	    }
   215	
   216	    double tol = atof(tol_s);
   217	    int maxiter = atoi(maxiter_s);
   218	    int restart = restart_s ? atoi(restart_s) : 30;
   219	    double omega = omega_s ? atof(omega_s) : 1.0;
   220	
   221	    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {
   222	        fprintf(stderr, "Error: invalid solver parameters\n");
   223	        return 1;
   224	    }
   225	    if (validate_ssor_omega(omega) != 0) {
   226	        return 1;
   227	    }
   228	
   229	    CSRMatrix *A = csr_read_mm(input);
   230	    if (!A) {
   231	        fprintf(stderr, "Error: cannot read sparse matrix from '%s'\n", input);
   232	        return 1;
   233	    }
   234	
   235	    int n;
   236	    double *b = vec_read_mm_array(rhs_file, &n);
   237	    if (!b) {
   238	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
   239	        csr_destroy(A);
   240	        return 1;
   241	    }
   242	
   243	    if (A->rows != n || A->cols != n) {
   244	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
   245	                A->rows, A->cols, n);
   246	        free(b);
   247	        csr_destroy(A);
   248	        return 1;
   249	    }
   250	
   251	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   252	
   253	    free(b);
   254	    csr_destroy(A);
   255	    return rc;
   256	}
