[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> int csr_is_symmetric(const CSRMatrix *A, double tol)
[?2004l[?2004h> {
[?2004l[?2004h>     if (A->rows != A->cols) return 0;
[?2004l[?2004h>     for (int i = 0; i < A->rows; i++) {
[?2004l[?2004h>         for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {
[?2004l[?2004h>             int j = A->col_indices[k];
[?2004l[?2004h>             int idx = csr_find_in_row(A, j, i);
[?2004l[?2004h>             if (idx < 0) return 0;
[?2004l[?2004h>             if (fabs(A->values[k] - A->values[idx]) > tol) return 0;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     return 1;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> double *csr_diagonal(const CSRMatrix *A)
[?2004l[?2004h> {
[?2004l[?2004h>     int n = A->rows < A->cols ? A->rows : A->cols;
[?2004l[?2004h>     double *diag = vec_create(n);
[?2004l[?2004h>     if (!diag) return NULL;
[?2004l[?2004h>     for (int i = 0; i < n; i++) {
[?2004l[?2004h>         int idx = csr_find_in_row(A, i, i);
[?2004l[?2004h>         diag[i] = (idx >= 0) ? A->values[idx] : 0.0;
[?2004l[?2004h>     }
[?2004l[?2004h>     return diag;
[?2004l[?2004h> }
