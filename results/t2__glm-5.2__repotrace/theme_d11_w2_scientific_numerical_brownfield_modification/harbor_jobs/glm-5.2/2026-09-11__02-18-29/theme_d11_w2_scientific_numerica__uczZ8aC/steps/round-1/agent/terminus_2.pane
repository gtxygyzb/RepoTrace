    65	static int cmd_dense_solve(int argc, char **argv)
    66	{
    67	    if (argc < 2) {
    68	        fprintf(stderr, "Error: dense-solve requires <matrix_file> <rhs_file>\n");
    69	        return 1;
    70	    }
    71	
    72	    const char *mat_file = argv[0];
    73	    const char *rhs_file = argv[1];
    74	    const char *out_file = (argc >= 3) ? argv[2] : NULL;
    75	
    76	    DenseMatrix *A = dm_read_text(mat_file);
    77	    if (!A) {
    78	        fprintf(stderr, "Error: cannot read matrix from '%s'\n", mat_file);
    79	        return 1;
    80	    }
    81	
    82	    int n;
    83	    double *b = vec_read_text(rhs_file, &n);
    84	    if (!b) {
    85	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
    86	        dm_destroy(A);
    87	        return 1;
    88	    }
    89	
    90	    if (A->rows != n || A->cols != n) {
    91	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
    92	                A->rows, A->cols, n);
    93	        free(b);
    94	        dm_destroy(A);
    95	        return 1;
    96	    }
    97	
    98	    double *x = vec_create(n);
    99	    if (!x) {
   100	        fprintf(stderr, "Error: allocation failed\n");
   101	        free(b);
   102	        dm_destroy(A);
   103	        return 1;
   104	    }
   105	
   106	    int rc = dm_solve(A, b, x);
   107	    if (rc != 0) {
   108	        fprintf(stderr, "Error: solver failed (singular or ill-conditioned)\n");
   109	        free(x);
   110	        free(b);
   111	        dm_destroy(A);
   112	        return 1;
   113	    }
   114	
   115	    if (out_file) {
   116	        vec_write_text(x, n, out_file);
   117	        printf("Solution written to %s\n", out_file);
   118	    } else {
   119	        printf("Solution:\n");
   120	        vec_print(x, n, stdout);
   121	    }
   122	
   123	    double *r = vec_create(n);
   124	    dm_matvec(A, x, r);
   125	    vec_axpy(-1.0, b, r, n);
   126	    printf("Residual norm: %.6e\n", vec_norm2(r, n));
   127	
   128	    free(r);
   129	    free(x);
   130	    free(b);
   131	    dm_destroy(A);
   132	    return 0;
   133	}
