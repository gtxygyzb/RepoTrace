  163 | static int run_solver_and_print(const CSRMatrix *A, const double *b,
      | ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  164 |                                 const char *solver, const char *precond,
      |                                 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  165 |                                 double tol, int maxiter, int restart,
      |                                 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  166 |                                 double omega, const char *output,
      |                                 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  167 |                                 const char *history)
      |                                 ~~~~~~~~~~~~~~~~~~~~
  168 | {
      | ~    
  169 |     Precond *P = precond_create(A, precond, omega);
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  170 |     if (!P) {
      |     ~~~~~~~~~
  171 |         fprintf(stderr, "Error: cannot create preconditioner '%s'\n", precond);
      |         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  172 |         return 1;
      |         ~~~~~~~~~
  173 |     }
      |     ~
  174 | 
      |      
  175 |     SolveResult *res = NULL;
      |     ~~~~~~~~~~~~~~~~~~~~~~~~
  176 |     if (strcmp(solver, "cg") == 0) {
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  177 |         res = cg_solve(A, b, NULL, tol, maxiter, P);
      |         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  178 |     } else if (strcmp(solver, "gmres") == 0) {
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  179 |         res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);
      |         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  180 |     } else {
      |     ~~~~~~~~
  181 |         fprintf(stderr, "Error: unknown solver '%s'\n", solver);
      |         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  182 |         precond_destroy(P);
      |         ~~~~~~~~~~~~~~~~~~~
  183 |         return 1;
      |         ~~~~~~~~~
  184 |     }
      |     ~
  185 | 
      |      
  186 |     if (!res) {
      |     ~~~~~~~~~~~
  187 |         fprintf(stderr, "Error: solver allocation failed\n");
      |         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  188 |         precond_destroy(P);
      |         ~~~~~~~~~~~~~~~~~~~
  189 |         return 1;
      |         ~~~~~~~~~
  190 |     }
      |     ~
  191 | 
      |      
  192 |     print_solve_summary(res);
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~
  193 | 
      |      
  194 |     if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  195 |         fprintf(stderr, "Error: cannot write output to '%s'\n", output);
      |         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  196 |     }
      |     ~
  197 |     if (history && write_history_file(res, history) != 0) {
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  198 |         fprintf(stderr, "Error: cannot write history to '%s'\n", history);
      |         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  199 |     }
      |     ~
  200 | 
      |      
  201 |     solve_result_destroy(res);
      |     ~~~~~~~~~~~~~~~~~~~~~~~~~~
  202 |     precond_destroy(P);
      |     ~~~~~~~~~~~~~~~~~~~
  203 |     return 0;
      |     ~~~~~~~~~
  204 | }
