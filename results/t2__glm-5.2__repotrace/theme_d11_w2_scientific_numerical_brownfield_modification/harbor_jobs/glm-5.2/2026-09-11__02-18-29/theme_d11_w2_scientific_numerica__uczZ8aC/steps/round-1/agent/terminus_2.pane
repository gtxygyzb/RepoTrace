   134	static int parse_bc(const char *s, PoissonBC *bc)
   135	{
   136	    const char *colon = strchr(s, ':');
   137	    if (!colon || colon == s) return -1;
   138	
   139	    size_t len = colon - s;
   140	    char type[32];
   141	    if (len >= sizeof(type)) return -1;
   142	    memcpy(type, s, len);
   143	    type[len] = '\0';
   144	
   145	    if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;
   146	    else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;
   147	    else return -1;
   148	
   149	    bc->file = colon + 1;
   150	    return 0;
   151	}
   152	
   153	static int run_solver_and_print(const CSRMatrix *A, const double *b,
   154	                                const char *solver, const char *precond,
   155	                                double tol, int maxiter, int restart,
   156	                                double omega, const char *output,
   157	                                const char *history)
   158	{
   159	    Precond *P = precond_create(A, precond, omega);
   160	    if (!P) {
   161	        fprintf(stderr, "Error: cannot create preconditioner '%s'\n", precond);
   162	        return 1;
   163	    }
   164	
   165	    SolveResult *res = NULL;
   166	    if (strcmp(solver, "cg") == 0) {
   167	        res = cg_solve(A, b, NULL, tol, maxiter, P);
   168	    } else if (strcmp(solver, "gmres") == 0) {
   169	        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);
   170	    } else {
   171	        fprintf(stderr, "Error: unknown solver '%s'\n", solver);
   172	        precond_destroy(P);
   173	        return 1;
   174	    }
   175	
   176	    if (!res) {
   177	        fprintf(stderr, "Error: solver allocation failed\n");
   178	        precond_destroy(P);
   179	        return 1;
   180	    }
   181	
   182	    print_solve_summary(res);
   183	
   184	    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {
   185	        fprintf(stderr, "Error: cannot write output to '%s'\n", output);
   186	    }
   187	    if (history && write_history_file(res, history) != 0) {
   188	        fprintf(stderr, "Error: cannot write history to '%s'\n", history);
   189	    }
   190	
   191	    solve_result_destroy(res);
   192	    precond_destroy(P);
   193	    return 0;
   194	}
   195	
   196	static int cmd_sparse_solve(int argc, char **argv)
   197	{
   198	    const char *input = get_opt(argc, argv, "--input");
   199	    const char *rhs_file = get_opt(argc, argv, "--rhs");
   200	    const char *solver = get_opt(argc, argv, "--solver");
   201	    const char *precond = get_opt(argc, argv, "--precond");
   202	    const char *tol_s = get_opt(argc, argv, "--tol");
   203	    const char *maxiter_s = get_opt(argc, argv, "--maxiter");
   204	    const char *restart_s = get_opt(argc, argv, "--restart");
   205	    const char *omega_s = get_opt(argc, argv, "--ssor-omega");
   206	    const char *output = get_opt(argc, argv, "--output");
   207	    const char *history = get_opt(argc, argv, "--history");
   208	
   209	    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {
   210	        fprintf(stderr, "Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\n");
   211	        usage("numsim");
   212	        return 1;
   213	    }
   214	
   215	    double tol = atof(tol_s);
   216	    int maxiter = atoi(maxiter_s);
   217	    int restart = restart_s ? atoi(restart_s) : 30;
   218	    double omega = omega_s ? atof(omega_s) : 1.0;
   219	
   220	    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {
   221	        fprintf(stderr, "Error: invalid solver parameters\n");
   222	        return 1;
   223	    }
   224	    if (validate_ssor_omega(omega) != 0) {
   225	        return 1;
   226	    }
   227	
   228	    CSRMatrix *A = csr_read_mm(input);
   229	    if (!A) {
   230	        fprintf(stderr, "Error: cannot read sparse matrix from '%s'\n", input);
   231	        return 1;
   232	    }
   233	
   234	    int n;
   235	    double *b = vec_read_mm_array(rhs_file, &n);
   236	    if (!b) {
   237	        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
   238	        csr_destroy(A);
   239	        return 1;
   240	    }
   241	
   242	    if (A->rows != n || A->cols != n) {
   243	        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
   244	                A->rows, A->cols, n);
   245	        free(b);
   246	        csr_destroy(A);
   247	        return 1;
   248	    }
   249	
   250	    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);
   251	
   252	    free(b);
   253	    csr_destroy(A);
   254	    return rc;
   255	}
