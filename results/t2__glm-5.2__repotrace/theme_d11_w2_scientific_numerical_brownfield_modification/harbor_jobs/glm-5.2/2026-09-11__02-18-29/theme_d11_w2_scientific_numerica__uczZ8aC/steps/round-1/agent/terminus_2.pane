[?2004hroot@n30009:/app# sed -n '1,260p' src/main.c
[?2004l#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "dense.h"
#include "vector.h"
#include "io.h"

static void usage(const char *prog)
{
    fprintf(stderr, "Usage:\n");
    fprintf(stderr, "  %s dense-solve <matrix_file> <rhs_file> [output_file]\n", prog);
    fprintf(stderr, "\nSolves Ax = b using dense LU decomposition.\n");
}

static int cmd_dense_solve(int argc, char **argv)
{
    if (argc < 2) {
        fprintf(stderr, "Error: dense-solve requires <matrix_file> <rhs_file>\n");
        return 1;
    }

    const char *mat_file = argv[0];
    const char *rhs_file = argv[1];
    const char *out_file = (argc >= 3) ? argv[2] : NULL;

    DenseMatrix *A = dm_read_text(mat_file);
    if (!A) {
        fprintf(stderr, "Error: cannot read matrix from '%s'\n", mat_file);
        return 1;
    }

    int n;
    double *b = vec_read_text(rhs_file, &n);
    if (!b) {
        fprintf(stderr, "Error: cannot read RHS from '%s'\n", rhs_file);
        dm_destroy(A);
        return 1;
    }

    if (A->rows != n || A->cols != n) {
        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\n",
                A->rows, A->cols, n);
        free(b);
        dm_destroy(A);
        return 1;
    }

    double *x = vec_create(n);
    if (!x) {
        fprintf(stderr, "Error: allocation failed\n");
        free(b);
        dm_destroy(A);
        return 1;
    }

    int rc = dm_solve(A, b, x);
    if (rc != 0) {
        fprintf(stderr, "Error: solver failed (singular or ill-conditioned)\n");
        free(x);
        free(b);
        dm_destroy(A);
        return 1;
    }

    if (out_file) {
        vec_write_text(x, n, out_file);
        printf("Solution written to %s\n", out_file);
    } else {
        printf("Solution:\n");
        vec_print(x, n, stdout);
    }

    /* Compute residual norm */
    double *r = vec_create(n);
    dm_matvec(A, x, r);
    vec_axpy(-1.0, b, r, n);
    printf("Residual norm: %.6e\n", vec_norm2(r, n));

    free(r);
    free(x);
    free(b);
    dm_destroy(A);
    return 0;
}

int main(int argc, char **argv)
{
    if (argc < 2) {
        usage(argv[0]);
        return 1;
    }

    const char *cmd = argv[1];

    if (strcmp(cmd, "dense-solve") == 0) {
        return cmd_dense_solve(argc - 2, argv + 2);
    } else if (strcmp(cmd, "--help") == 0 || strcmp(cmd, "-h") == 0) {
        usage(argv[0]);
        return 0;
    } else {
        fprintf(stderr, "Error: unknown command '%s'\n", cmd);
        usage(argv[0]);
        return 1;
    }
}
[?2004hroot@n30009:/app# sed -n '1,240p' include/dense.h
[?2004l#ifndef DENSE_H
#define DENSE_H

#include <stdio.h>

/*
 * Dense matrix stored in row-major order.
 * Element (i,j) is at data[i * cols + j].
 */
typedef struct {
    int    rows;
    int    cols;
    double *data;
} DenseMatrix;

/* Lifecycle */
DenseMatrix *dm_create(int rows, int cols);
void         dm_destroy(DenseMatrix *m);

/* Element access */
double dm_get(const DenseMatrix *m, int i, int j);
void   dm_set(DenseMatrix *m, int i, int j, double val);

/* Operations */
void dm_matvec(const DenseMatrix *A, const double *x, double *y);

/*
 * Solve Ax = b using LU decomposition with partial pivoting.
 * A is not modified (internal copy is made).
 * Returns 0 on success, -1 on singular matrix or allocation failure.
 */
int dm_solve(const DenseMatrix *A, const double *b, double *x);

/* Debug */
void dm_print(const DenseMatrix *m, FILE *out);

#endif /* DENSE_H */
[?2004hroot@n30009:/app# sed -n '1,240p' include/vector.h
[?2004l#ifndef VECTOR_H
#define VECTOR_H

#include <stdio.h>

/* Allocate a zero-initialized vector of length n. Returns NULL on failure. */
double *vec_create(int n);

/* Deep copy: dst[i] = src[i] */
void vec_copy(const double *src, double *dst, int n);

/* Zero out: x[i] = 0 */
void vec_zero(double *x, int n);

/* Scale: x[i] *= a */
void vec_scale(double a, double *x, int n);

/* AXPY: y[i] += a * x[i] */
void vec_axpy(double a, const double *x, double *y, int n);

/* Dot product: sum(x[i] * y[i]) */
double vec_dot(const double *x, const double *y, int n);

/* L2 norm: sqrt(sum(x[i]^2)) */
double vec_norm2(const double *x, int n);

/* Print vector to stream, one value per line */
void vec_print(const double *x, int n, FILE *out);

#endif /* VECTOR_H */
[?2004hroot@n30009:/app# sed -n '1,260p' include/io.h
[?2004l#ifndef IO_H
#define IO_H

#include "dense.h"

/*
 * Read dense matrix from text file.
 * Format:
 *   rows cols
 *   a00 a01 a02 ...
 *   a10 a11 a12 ...
 *   ...
 * Returns NULL on error.
 */
DenseMatrix *dm_read_text(const char *filename);

/*
 * Write dense matrix to text file.
 * Returns 0 on success, -1 on error.
 */
int dm_write_text(const DenseMatrix *m, const char *filename);

/*
 * Read vector from text file.
 * Format:
 *   n
 *   v0
 *   v1
 *   ...
 * Sets *n_out to the dimension. Returns NULL on error.
 */
double *vec_read_text(const char *filename, int *n_out);

/*
 * Write vector to text file.
 * Returns 0 on success, -1 on error.
 */
int vec_write_text(const double *x, int n, const char *filename);

#endif /* IO_H */
[?2004hroot@n30009:/app# sed -n '1,320p' src/io.c
[?2004l#include "io.h"
#include "vector.h"
#include <stdlib.h>
#include <string.h>

DenseMatrix *dm_read_text(const char *filename)
{
    FILE *fp = fopen(filename, "r");
    if (!fp) return NULL;

    int rows, cols;
    if (fscanf(fp, "%d %d", &rows, &cols) != 2) {
        fclose(fp);
        return NULL;
    }

    DenseMatrix *m = dm_create(rows, cols);
    if (!m) { fclose(fp); return NULL; }

    int i, j;
    for (i = 0; i < rows; i++)
        for (j = 0; j < cols; j++)
            if (fscanf(fp, "%lf", &m->data[i * cols + j]) != 1) {
                dm_destroy(m);
                fclose(fp);
                return NULL;
            }

    fclose(fp);
    return m;
}

int dm_write_text(const DenseMatrix *m, const char *filename)
{
    FILE *fp = fopen(filename, "w");
    if (!fp) return -1;
    dm_print(m, fp);
    fclose(fp);
    return 0;
}

double *vec_read_text(const char *filename, int *n_out)
{
    FILE *fp = fopen(filename, "r");
    if (!fp) return NULL;

    int n;
    if (fscanf(fp, "%d", &n) != 1 || n <= 0) {
        fclose(fp);
        return NULL;
    }

    double *x = vec_create(n);
    if (!x) { fclose(fp); return NULL; }

    int i;
    for (i = 0; i < n; i++)
        if (fscanf(fp, "%lf", &x[i]) != 1) {
            free(x);
            fclose(fp);
            return NULL;
        }

    fclose(fp);
    *n_out = n;
    return x;
}

int vec_write_text(const double *x, int n, const char *filename)
{
    FILE *fp = fopen(filename, "w");
    if (!fp) return -1;
    fprintf(fp, "%d\n", n);
    vec_print(x, n, fp);
    fclose(fp);
    return 0;
}
