    37	static int write_history_file(const SolveResult *res, const char *filename)
    38	{
    39	    FILE *fp = fopen(filename, "w");
    40	    if (!fp) return -1;
    41	    for (int i = 0; i < res->history_len; i++) {
    42	        fprintf(fp, "%d\t%.15e\t%.15e\n", i, res->history[i], res->precond_history[i]);
    43	    }
    44	    fclose(fp);
    45	    return 0;
    46	}
