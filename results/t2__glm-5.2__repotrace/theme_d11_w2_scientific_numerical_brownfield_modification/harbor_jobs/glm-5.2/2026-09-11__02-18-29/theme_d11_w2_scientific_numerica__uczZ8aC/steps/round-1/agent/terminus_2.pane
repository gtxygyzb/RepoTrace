     7	double *poisson_read_source(const char *filename, int nx, int ny)
     8	{
     9	    FILE *fp = fopen(filename, "r");
    10	    if (!fp) return NULL;
    11	
    12	    int rx, ry;
    13	    if (fscanf(fp, "%d %d", &rx, &ry) != 2 || rx != nx || ry != ny) {
    14	        fclose(fp);
    15	        return NULL;
    16	    }
    17	
    18	    int n = nx * ny;
    19	    double *f = vec_create(n);
    20	    if (!f) { fclose(fp); return NULL; }
