[1145.651744, "o", "\u001b[?2004h> "]
[1145.651805, "o", "int main(int argc, char **argv)\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.651881, "o", "    if (argc < 2) {\r\n\u001b[?2004l\r\u001b[?2004h>         usage(argv[0]);\r\n\u001b[?2004l\r"]
