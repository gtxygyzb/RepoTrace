[11043.806731, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n#include \"dense.h\"\r\n#include \"vector.h\"\r\n#include \"io.h\"\r\n#include \"sparse.h\"\r\n#include \"precond.h\"\r\n#include \"solvers.h\"\r\n"]
[11043.806813, "o", "#include \"poisson.h\"\r\n#include \"heat.h\"\r\n#include \"convdiff.h\"\r\n#include \"eigen.h\"\r\n\r\nstatic void usage(const char *prog)\r\n{\r\n    fprintf(stderr, \"Usage:\\n\");\r\n    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\n\", prog);\r\n    fprintf(stderr, \"  %s matinfo --input <mtx_file>\\n\", prog);\r\n    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n"]
[11043.806943, "o", "    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s heat --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --alpha <float> --dt <float> --nsteps <int> --scheme <backward-euler|crank-nicolson> --ic <file> --source <file>[,<file>,...] --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file>\\n\", prog);\r\n    fprintf(stderr, \"  %s convdiff --nx <i"]
[11043.807002, "o", "nt> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --kappa <float> --vx <float> --vy <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file> [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s eigenvalue --input <mtx_file> --method <power|inverse|shifted-inverse> [--shift <sigma>] --tol <value> --maxiter <int> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> [--restart <m>] [--ssor-omega <value>] [--solver-tol <value>] [--solver-maxiter <int>] [--eigvec-output <file>]\\n\", prog);\r\n}\r\n\r\nstatic const char *get_opt(int argc, char **argv, const char *name)\r\n{\r\n    for (int i = 0; i < argc - 1; i++) {\r\n        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    }\r\n    return NULL;\r\n}\r\n\r\nstatic int write_history_file(const SolveResul"]
[11043.807221, "o", "t *res, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    for (int i = 0; i < res->history_len; i++) {\r\n        fprintf(fp, \"%d\\t%.15e\\t%.15e\\n\", i, res->history[i], res->precond_history[i]);\r\n    }\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n\r\nstatic void print_solve_summary(const SolveResult *res)\r\n{\r\n    printf(\"converged: %s\\n\", res->converged ? \"yes\" : \"no\");\r\n    printf(\"iterations: %d\\n\", res->iterations);\r\n    printf(\"residual: %.6e\\n\", res->relres);\r\n    printf(\"true_residual: %.6e\\n\", res->true_residual);\r\n}\r\n\r\nstatic int validate_ssor_omega(double omega)\r\n{\r\n    if (!(omega > 0.0 && omega < 2.0)) {\r\n        fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int cmd_dense_solve(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"Error: dense-solve requires <matrix_file> <rhs_file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    const char *mat_file = argv[0];\r\n    const char *rhs_file = argv[1];"]
[11043.807296, "o", "\r\n    const char *out_file = (argc >= 3) ? argv[2] : NULL;\r\n\r\n    DenseMatrix *A = dm_read_text(mat_file);\r\n    if (!A) {\r\n        fprintf(stderr, \"Error: cannot read matrix from '%s'\\n\", mat_file);\r\n        return 1;\r\n    }\r\n\r\n    int n;\r\n    double *b = vec_read_text(rhs_file, &n);\r\n    if (!b) {\r\n        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (A->rows != n || A->cols != n) {\r\n        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n                A->rows, A->cols, n);\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    double *x = vec_create(n);\r\n    if (!x) {\r\n        fprintf(stderr, \"Error: allocation failed\\n\");\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    int rc = dm_solve(A, b, x);\r\n    if (rc != 0) {\r\n        fprintf(stderr, \"Error: solver failed (singular or ill-conditioned)\\n\");\r\n        free(x);\r\n        free(b);\r\n        dm_destroy(A);\r\n     "]
[11043.807361, "o", "   return 1;\r\n    }\r\n\r\n    if (out_file) {\r\n        vec_write_text(x, n, out_file);\r\n        printf(\"Solution written to %s\\n\", out_file);\r\n    } else {\r\n        printf(\"Solution:\\n\");\r\n        vec_print(x, n, stdout);\r\n    }\r\n\r\n    double *r = vec_create(n);\r\n    dm_matvec(A, x, r);\r\n    vec_axpy(-1.0, b, r, n);\r\n    printf(\"Residual norm: %.6e\\n\", vec_norm2(r, n));\r\n"]
[11043.807423, "o", "\r\n    free(r);\r\n    free(x);\r\n    free(b);\r\n    dm_destroy(A);\r\n    return 0;\r\n}\r\n\r\nstatic int parse_bc(const char *s, PoissonBC *bc)\r\n{\r\n    const char *colon = strchr(s, ':');\r\n    if (!colon || colon == s) return -1;\r\n\r\n    size_t len = colon - s;\r\n"]
[11043.807484, "o", "    char type[32];\r\n    if (len >= sizeof(type)) return -1;\r\n    memcpy(type, s, len);\r\n    type[len] = '\\0';\r\n\r\n    if (strcmp(type, \"dirichlet\") == 0) bc->type = POISSON_DIRICHLET;\r\n    else if (strcmp(type, \"neumann\") == 0) bc->type = POISSON_NEUMANN;\r\n    else return -1;\r\n\r\n    bc->file = colon + 1;\r\n    return 0;\r\n"]
[11043.807543, "o", "}\r\n\r\nstatic int run_solver_and_print(const CSRMatrix *A, const double *b,\r\n                                const char *solver, const char *precond,\r\n                                double tol, int maxiter, int restart,\r\n                                double omega, const char *output,\r\n                                const char *history)\r\n{\r\n    Precond *P = precond_create(A, precond, omega);\r\n    if (!P) {\r\n        fprintf(stderr, \"Error: cannot create preconditioner '%s'\\n\", precond);\r\n"]
[11043.807603, "o", "        return 1;\r\n    }\r\n\r\n    SolveResult *res = NULL;\r\n    if (strcmp(solver, \"cg\") == 0) {\r\n        res = cg_solve(A, b, NULL, tol, maxiter, P);\r\n    } else if (strcmp(solver, \"gmres\") == 0) {\r\n        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);\r\n    } else {\r\n        fprintf(stderr, \"Error: unknown solver '%s'\\n\", solver);\r\n        precond_destroy(P);\r\n        return 1;\r\n"]
[11043.807682, "o", "    }\r\n\r\n    if (!res) {\r\n        fprintf(stderr, \"Error: solver allocation failed\\n\");\r\n        precond_destroy(P);\r\n        return 1;\r\n    }\r\n\r\n    print_solve_summary(res);\r\n\r\n    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {\r\n        fprintf(stderr, \"Error: cannot write output to '%s'\\n\", output);\r\n    }\r\n    if (history && write_history_file(res, history) != 0) {\r\n"]
[11043.807748, "o", "        fprintf(stderr, \"Error: cannot write history to '%s'\\n\", history);\r\n    }\r\n\r\n    solve_result_destroy(res);\r\n    precond_destroy(P);\r\n    return 0;\r\n}\r\n\r\nstatic int cmd_sparse_solve(int argc, char **argv)\r\n{\r\n    const char *input = get_opt(argc, argv, \"--input\");\r\n    const char *rhs_file = get_opt(argc, argv, \"--rhs\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n"]
[11043.807808, "o", "    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n    const char *history = get_opt(argc, argv, \"--history\");\r\n\r\n    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {\r\n        fprintf(stderr, \"Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n"]
[11043.807877, "o", "    }\r\n\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n"]
[11043.808453, "o", "\u001b[?2004h"]
[11043.808515, "o", "root@n30009:/app# "]
[11044.082659, "i", "sed -n '1,260p' src/solvers.c\n"]
[11044.082959, "o", "sed -n '1,260p' src/solvers.c\r\n"]
[11044.083042, "o", "\u001b[?2004l\r"]
[11044.085829, "o", "#include \"solvers.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <math.h>\r\n#include <string.h>\r\n\r\n"]
[11044.085934, "o", "static SolveResult *result_create(int n, int maxiter)\r\n{\r\n    if (maxiter < 0) maxiter = 0;\r\n    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    if (!res) return NULL;\r\n\r\n    res->x = vec_create(n);\r\n    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    res->precond_history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    if (!res->x || !res->history || !res->precond_history) {\r\n        free(res->x);\r\n        free(res->history);\r\n        free(res->precond_history);\r\n        free(res);\r\n        return NULL;\r\n    }"]
[11044.086025, "o", "\r\n    res->history_len = 0;\r\n    return res;\r\n}\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;"]
[11044.086092, "o", "\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *p = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    if (!r || !z || !p || !Ap) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    precond_apply(P, A, r, z);\r\n"]
[11044.086157, "o", "    double pnorm0 = vec_norm2(z, n);\r\n    res->history[0] = res->relres;\r\n    res->precond_history[0] = pnorm0;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n\r\n    if (precond_apply(P, A, r, z) != 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n"]
[11044.086217, "o", "    vec_copy(z, p, n);\r\n    double rz_old = vec_dot(r, z, n);\r\n\r\n    for (int iter = 1; iter <= maxiter; iter++) {\r\n        csr_spmv(A, p, Ap);\r\n        double pAp = vec_dot(p, Ap, n);\r\n        if (fabs(pAp) < 1e-30) break;\r\n\r\n        double alpha = rz_old / pAp;\r\n        vec_axpy(alpha, p, res->x, n);\r\n"]
[11044.086278, "o", "        vec_axpy(-alpha, Ap, r, n);\r\n\r\n        /* Recompute the true residual rather than relying on the recurrence. */\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n        res->relres = res->true_residual / bnorm;\r\n        precond_apply(P, A, r, z);\r\n        double pznorm = vec_norm2(z, n);\r\n        res->history[iter] = res->relres;\r\n        res->precond_history[iter] = pznorm;\r\n"]
[11044.086338, "o", "        res->history_len = iter + 1;\r\n        res->iterations = iter;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double rz_new = vec_dot(r, z, n);\r\n        if (fabs(rz_old) < 1e-30) break;\r\n        double beta = rz_new / rz_old;\r\n        vec_scale(beta, p, n);\r\n"]
[11044.086396, "o", "        vec_axpy(1.0, z, p, n);\r\n        rz_old = rz_new;\r\n    }\r\n\r\n    free(r); free(z); free(p); free(Ap);\r\n    return res;\r\n}\r\n\r\nstatic void apply_givens(double *a, double *b, double c, double s)\r\n{\r\n    double t = c * (*a) + s * (*b);\r\n    *b = -s * (*a) + c * (*b);\r\n"]
[11044.086453, "o", "    *a = t;\r\n}\r\n\r\nstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n{\r\n    if (kdim <= 0) return -1;\r\n\r\n    double *c = (double *)malloc(m * sizeof(double));\r\n    double *s = (double *)malloc(m * sizeof(double));\r\n    if (!c || !s) { free(c); free(s); return -1; }\r\n\r\n"]
[11044.08654, "o", "    for (int i = 0; i < kdim; i++) {\r\n        for (int k = 0; k < i; k++) {\r\n            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n        }\r\n\r\n        double a = H[i*m+i];\r\n        double b = H[(i+1)*m+i];\r\n        if (b == 0.0) {\r\n            c[i] = 1.0;\r\n            s[i] = 0.0;\r\n        } else {\r\n            double r = hypot(a, b);\r\n            c[i] = a / r;\r\n            s[i] = b / r;\r\n        }\r\n        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n\r\n    }\r\n"]
[11044.086608, "o", "\r\n    for (int i = kdim - 1; i >= 0; i--) {\r\n        double sum = g[i];\r\n        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n        y[i] = sum / H[i*m+i];\r\n    }\r\n\r\n    free(c);\r\n    free(s);\r\n    return 0;\r\n}\r\n\r\n"]
[11044.086665, "o", "SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                           double tol, int maxiter, int m, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (m <= 0) m = 30;\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n"]
[11044.086724, "o", "    double *Ap = vec_create(n);\r\n    double *Av = vec_create(n);\r\n    double *w = vec_create(n);\r\n    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n    double *y = (double *)malloc(m * sizeof(double));\r\n    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n\r\n    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n"]
[11044.086798, "o", "    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    precond_apply(P, A, r, z);\r\n    double pnorm0 = vec_norm2(z, n);\r\n    res->history[0] = res->relres;\r\n    res->precond_history[0] = pnorm0;\r\n"]
[11044.086861, "o", "    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        return res;\r\n    }\r\n\r\n    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double beta = vec_norm2(z, n);\r\n        if (beta == 0.0) break;\r\n\r\n"]
[11044.086931, "o", "        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n        g[0] = beta;\r\n        memset(H, 0, (m + 1) * m * sizeof(double));\r\n\r\n        int kdim = 0;\r\n        int fail = 0;\r\n        for (int j = 0; j < m; j++) {\r\n            csr_spmv(A, V + j * n, Av);\r\n            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n\r\n            for (int i = 0; i <= j; i++) {\r\n"]
[11044.086996, "o", "                double h = vec_dot(w, V + i * n, n);\r\n                H[i*m+j] = h;\r\n                vec_axpy(-h, V + i * n, w, n);\r\n            }\r\n\r\n            double hnorm = vec_norm2(w, n);\r\n            H[(j+1)*m+j] = hnorm;\r\n            kdim = j + 1;\r\n\r\n            if (hnorm < 1e-14) break;\r\n\r\n            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n        }\r\n        if (fail) break;\r\n"]
[11044.087054, "o", "        if (kdim == 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n        res->relres = res->true_residual / bnorm;\r\n        precond_apply(P, A, r, z);\r\n        double pznorm = vec_norm2(z, n);\r\n"]
[11044.087113, "o", "        res->history[cycle] = res->relres;\r\n        res->precond_history[cycle] = pznorm;\r\n        res->history_len = cycle + 1;\r\n        res->iterations = cycle;\r\n"]
[11044.087588, "o", "\u001b[?2004h"]
