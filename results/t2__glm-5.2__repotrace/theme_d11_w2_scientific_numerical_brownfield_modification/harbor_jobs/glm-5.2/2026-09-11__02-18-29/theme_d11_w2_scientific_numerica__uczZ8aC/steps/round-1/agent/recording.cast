[1145.638791, "o", "> "]
[1145.638993, "o", "    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.63905, "o", "> "]
[1145.639271, "o", "    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n\u001b[?2004l\r"]
[1145.639327, "o", "\u001b[?2004h> "]
