[12822.233382, "o", "     6\tstatic void add_coo(COOMatrix *coo, int *k, int r, int c, double v)\r\n     7\t{\r\n     8\t    coo->row[*k] = r;\r\n     9\t    coo->col[*k] = c;\r\n    10\t    coo->values[*k] = v;\r\n    11\t    (*k)++;\r\n    12\t}\r\n    13\t\r\n    14\tdouble convdiff_peclet(double vx, double vy, double hx, double hy, double kappa)\r\n    15\t{\r\n    16\t    double pe_x = fabs(vx) * hx;\r\n    17\t    double pe_y = fabs(vy) * hy;\r\n    18\t    double num = pe_x > pe_y ? pe_x : pe_y;\r\n    19\t    return num / (2.0 * kappa);\r\n    20\t}\r\n"]
[12822.233477, "o", "    21\t\r\n    22\tint convdiff_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n    23\t                      double kappa, double vx, double vy,\r\n    24\t                      const char *source_file, PoissonBC left, PoissonBC right,\r\n    25\t                      PoissonBC bottom, PoissonBC top,\r\n    26\t                      CSRMatrix **A_out, double **b_out)\r\n    27\t{\r\n    28\t    if (!A_out || !b_out) return -1;\r\n    29\t    *A_out = NULL;\r\n    30\t    *b_out = NULL;\r\n    31\t\r\n    32\t    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || kappa <= 0.0 || !source_file) {\r\n    33\t        return -1;\r\n    34\t    }\r\n    35\t\r\n"]
[12822.233573, "o", "    36\t    double hx = (x1 - x0) / (nx - 1);\r\n    37\t    double hy = (y1 - y0) / (ny - 1);\r\n    38\t    double hx2 = hx * hx;\r\n    39\t    double hy2 = hy * hy;\r\n    40\t\r\n    41\t    double *f = poisson_read_source(source_file, nx, ny);\r\n    42\t    if (!f) return -1;\r\n    43\t\r\n    44\t    double *left_vals = NULL;\r\n    45\t    double *right_vals = NULL;\r\n    46\t    double *bottom_vals = NULL;\r\n    47\t    double *top_vals = NULL;\r\n    48\t\r\n    49\t    if (left.type == POISSON_NEUMANN) {\r\n    50\t        left_vals = poisson_read_boundary(left.file, ny);\r\n"]
[12822.233658, "o", "    51\t        if (!left_vals) goto fail;\r\n    52\t    }\r\n    53\t    if (right.type == POISSON_NEUMANN) {\r\n    54\t        right_vals = poisson_read_boundary(right.file, ny);\r\n    55\t        if (!right_vals) goto fail;\r\n    56\t    }\r\n    57\t    if (bottom.type == POISSON_NEUMANN) {\r\n    58\t        bottom_vals = poisson_read_boundary(bottom.file, nx);\r\n    59\t        if (!bottom_vals) goto fail;\r\n    60\t    }\r\n    61\t    if (top.type == POISSON_NEUMANN) {\r\n    62\t        top_vals = poisson_read_boundary(top.file, nx);\r\n    63\t        if (!top_vals) goto fail;\r\n    64\t    }"]
[12822.233767, "o", "\r\n    65\t\r\n    66\t    if (left.type == POISSON_DIRICHLET) {\r\n    67\t        left_vals = poisson_read_boundary(left.file, ny);\r\n    68\t        if (!left_vals) goto fail;\r\n    69\t    }\r\n    70\t    if (right.type == POISSON_DIRICHLET) {\r\n    71\t        right_vals = poisson_read_boundary(right.file, ny);\r\n    72\t        if (!right_vals) goto fail;\r\n    73\t    }\r\n    74\t    if (bottom.type == POISSON_DIRICHLET) {\r\n    75\t        bottom_vals = poisson_read_boundary(bottom.file, nx);\r\n    76\t        if (!bottom_vals) goto fail;\r\n    77\t    }\r\n    78\t    if (top.type == POISSON_DIRICHLET) {\r\n    79\t        top_vals = poisson_read_boundary(top.file, nx);\r\n    80\t        if (!top_vals) goto fail;\r\n    81\t    }\r\n    82\t\r\n"]
[12822.233839, "o", "    83\t    int n = nx * ny;\r\n    84\t    COOMatrix *coo = coo_create(n, n, 5 * n);\r\n    85\t    double *b = vec_create(n);\r\n    86\t    if (!coo || !b) {\r\n    87\t        coo_destroy(coo);\r\n    88\t        free(b);\r\n    89\t        goto fail;\r\n    90\t    }\r\n    91\t\r\n    92\t    int k = 0;\r\n"]
[12822.233945, "o", "    93\t    for (int i = 0; i < nx; i++) {\r\n    94\t        for (int j = 0; j < ny; j++) {\r\n    95\t            int idx = i * ny + j;\r\n    96\t            int is_left = (i == 0);\r\n    97\t            int is_right = (i == nx - 1);\r\n    98\t            int is_bottom = (j == 0);\r\n    99\t            int is_top = (j == ny - 1);\r\n   100\t\r\n   101\t            if (is_left && left.type == POISSON_DIRICHLET) {\r\n   102\t                add_coo(coo, &k, idx, idx, 1.0);\r\n   103\t                b[idx] = left_vals[j];\r\n   104\t                continue;\r\n   105\t            }\r\n   106\t            if (is_right && right.type == POISSON_DIRICHLET) {\r\n   107\t                add_coo(coo, &k, idx, idx, 1.0);\r\n   108\t"]
[12822.234005, "o", "                b[idx] = right_vals[j];\r\n   109\t                continue;\r\n   110\t            }\r\n   111\t            if (is_bottom && bottom.type == POISSON_DIRICHLET) {\r\n   112\t                add_coo(coo, &k, idx, idx, 1.0);\r\n   113\t                b[idx] = bottom_vals[i];\r\n   114\t                continue;\r\n   115\t            }\r\n   116\t            if (is_top && top.type == POISSON_DIRICHLET) {\r\n   117\t"]
[12822.234063, "o", "                add_coo(coo, &k, idx, idx, 1.0);\r\n   118\t                b[idx] = top_vals[i];\r\n   119\t                continue;\r\n   120\t            }\r\n   121\t\r\n   122\t            double diag = 0.0;\r\n   123\t            double rhs = f[idx];\r\n   124\t            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;\r\n   125\t"]
[12822.234126, "o", "\r\n   126\t            /* Diffusion: -kappa * laplacian(u) */\r\n   127\t            if (is_left && left.type == POISSON_NEUMANN) {\r\n   128\t                diag += 2.0 * kappa / hx2;\r\n   129\t                c_ip += -2.0 * kappa / hx2;\r\n   130\t                rhs += 2.0 * kappa * left_vals[j] / hx;\r\n   131\t            } else if (is_right && right.type == POISSON_NEUMANN) {\r\n   132\t                diag += 2.0 * kappa / hx2;\r\n   133\t                c_im += -2.0 * kappa / hx2;\r\n   134\t"]
[12822.234182, "o", "                rhs += 2.0 * kappa * right_vals[j] / hx;\r\n   135\t            } else if (!is_left && !is_right) {\r\n   136\t                diag += 2.0 * kappa / hx2;\r\n   137\t                c_im += -kappa / hx2;\r\n   138\t                c_ip += -kappa / hx2;\r\n   139\t            }\r\n   140\t\r\n"]
