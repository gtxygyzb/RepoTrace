[11075.735472, "o", "   487\t}\r\n   488\t\r\n   489\t\r\n   490\tstatic int cmd_matinfo(int argc, char **argv)\r\n   491\t{\r\n   492\t    const char *input = get_opt(argc, argv, \"--input\");\r\n   493\t    if (!input) {\r\n   494\t        fprintf(stderr, \"Error: matinfo requires --input <mtx_file>\\n\");\r\n   495\t        usage(\"numsim\");\r\n   496\t        return 1;\r\n"]
[11075.735531, "o", "   497\t    }\r\n   498\t\r\n   499\t    CSRMatrix *A = csr_read_mm(input);\r\n   500\t    if (!A) {\r\n   501\t        fprintf(stderr, \"error: cannot read matrix file\\n\");\r\n   502\t        return 1;\r\n   503\t    }\r\n   504\t\r\n"]
[11075.735591, "o", "   505\t    int rows = A->rows;\r\n   506\t    int cols = A->cols;\r\n   507\t\r\n   508\t    int symmetric = 0;\r\n   509\t    if (rows == cols) {\r\n   510\t        symmetric = 1;\r\n   511\t        for (int i = 0; i < rows && symmetric; i++) {\r\n   512\t            for (int k = A->row_ptr[i]; k < A->row_ptr[i+1] && symmetric; k++) {\r\n"]
[11075.73566, "o", "   513\t                int j = A->col_indices[k];\r\n   514\t                double v = A->values[k];\r\n   515\t\r\n   516\t                int idx = -1;\r\n   517\t                for (int l = A->row_ptr[j]; l < A->row_ptr[j+1]; l++) {\r\n   518\t                    if (A->col_indices[l] == i) {\r\n   519\t                        idx = l;\r\n   520\t                        break;\r\n   521\t                    }\r\n   522\t                }\r\n"]
[11075.735718, "o", "   523\t                if (idx < 0) {\r\n   524\t                    symmetric = 0;\r\n   525\t                    break;\r\n   526\t                }\r\n   527\t\r\n   528\t                double vt = A->values[idx];\r\n   529\t                double diff = fabs(v - vt);\r\n   530\t                double denom = fmax(fabs(v), fmax(fabs(vt), 1e-30));\r\n"]
[11075.735783, "o", "   531\t                if (diff >= 1e-12 * denom) {\r\n   532\t                    symmetric = 0;\r\n   533\t                    break;\r\n   534\t                }\r\n   535\t            }\r\n   536\t        }\r\n   537\t    }\r\n   538\t\r\n   539\t    int bandwidth = 0;\r\n   540\t    int nonzero_count = 0;\r\n   541\t"]
[11075.73584, "o", "    double frobenius_norm = 0.0;\r\n   542\t    double max_abs_value = 0.0;\r\n   543\t    double min_abs_nonzero = 0.0;\r\n   544\t\r\n   545\t    for (int i = 0; i < A->rows; i++) {\r\n   546\t        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n   547\t            int j = A->col_indices[k];\r\n   548\t            double v = A->values[k];\r\n"]
[11075.735906, "o", "   549\t            double av = fabs(v);\r\n   550\t\r\n   551\t            frobenius_norm += v * v;\r\n   552\t\r\n   553\t            if (av > max_abs_value) max_abs_value = av;\r\n   554\t\r\n   555\t            if (av != 0.0) {\r\n"]
[11075.735975, "o", "   556\t                nonzero_count++;\r\n   557\t\r\n   558\t                int bw = i - j;\r\n   559\t                if (bw < 0) bw = -bw;\r\n   560\t                if (bw > bandwidth) bandwidth = bw;\r\n"]
