[4142.199767, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[4142.199828, "o", "\u001b[?2004h> "]
[4142.220481, "o", "    printf(\"converged: %s\\n\", res->converged ? \"yes\" : \"no\");\r\n\u001b[?2004l\r\u001b[?2004h>     printf(\"iterations: %d\\n\", res->iterations);\r\n\u001b[?2004l\r\u001b[?2004h>     printf(\"residual: %.6e\\n\", res->relres);\r\n\u001b[?2004l\r\u001b[?2004h>     printf(\"true_residual: %.6e\\n\", res->true_residual);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static int validate_ssor_omega(double omega)\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h>     if (!(omega > 0.0 && omega < 2.0)) {\r\n\u001b[?2004l\r\u001b[?2004h>         fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static int cmd_dense_solve(int argc, char **argv)\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h>     if (argc < 2) {\r\n\u001b[?2004l\r\u001b[?2004h>         fprintf(stderr, \"Error: dense-solve requires <matrix_file> <rhs_file>\\n\");\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2"]
[4142.220556, "o", "004h>     const char *mat_file = argv[0];\r\n\u001b[?2004l\r\u001b[?2004h>     const char *rhs_file = argv[1];\r\n\u001b[?2004l\r\u001b[?2004h>     const char *out_file = (argc >= 3) ? argv[2] : NULL;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[4142.220688, "o", "    DenseMatrix *A = dm_read_text(mat_file);\r\n\u001b[?2004l\r"]
[4142.220751, "o", "\u001b[?2004h> "]
[4142.220823, "o", "    if (!A) {\r\n\u001b[?2004l\r"]
[4142.220888, "o", "\u001b[?2004h> "]
[4142.221286, "o", "        fprintf(stderr, \"Error: cannot read matrix from '%s'\\n\", mat_file);\r\n\u001b[?2004l\r"]
[4142.221343, "o", "\u001b[?2004h> "]
[4142.221423, "o", "        return 1;\r\n\u001b[?2004l\r"]
[4142.22148, "o", "\u001b[?2004h>     }\r\n"]
[4142.221535, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.221591, "o", "\u001b[?2004h> "]
[4142.221653, "o", "    int n;\r\n\u001b[?2004l\r"]
[4142.221717, "o", "\u001b[?2004h> "]
[4142.22195, "o", "    double *b = vec_read_text(rhs_file, &n);\r\n\u001b[?2004l\r"]
[4142.222006, "o", "\u001b[?2004h> "]
[4142.222062, "o", "    if (!b) {\r\n\u001b[?2004l\r"]
[4142.222117, "o", "\u001b[?2004h> "]
[4142.222512, "o", "        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n\u001b[?2004l\r"]
[4142.222567, "o", "\u001b[?2004h> "]
