[12472.466292, "o", "tory[0] = res->relres;\r\nsrc/solvers.c:213:    res->precond_history[0] = pnorm0;\r\nsrc/solvers.c:214:    res->history_len = 1;\r\nsrc/solvers.c:269:        res->history[cycle] = res->relres;\r\nsrc/solvers.c:270:        res->precond_history[cycle] = pznorm;\r\nsrc/solvers.c:271:        res->history_len = cycle + 1;\r\nsrc/solvers.c:284:void solve_result_destroy(SolveResult *res)\r\nsrc/solvers.c:288:    free(res->history);\r\nsrc/solvers.c:289:    free(res->precond_history);\r\nsrc/heat.c:417:        SolveResult *res = NULL;\r\nsrc/eigen.c:49:static SolveResult *solve_linear_system(const CSRMatrix *A, const double *b,\r\nsrc/eigen.c:60:    SolveResult *res = NULL;\r\nsrc/eigen.c:119:int cmd_eigenvalue(int argc, char **argv)\r\nsrc/eigen.c:135:        fprintf(stderr, \"Error: missing required arguments for eigenvalue\\n\");\r\nsrc/eigen.c:140:    if (strcmp(method_s, \"power\") == 0) method = 0;\r\nsrc/eigen.c:141:    else if (strcmp(method_s, \"inverse\") == 0) method = 1;\r\nsrc/eigen.c:142:    else if (strcmp(method_s, \"shifted-inverse\") == 0)"]
[12472.46636, "o", " method = 2;\r\nsrc/eigen.c:151:            fprintf(stderr, \"Error: --shift is required for shifted-inverse\\n\");\r\nsrc/eigen.c:177:        fprintf(stderr, \"Error: unknown preconditioner '%s'\\n\", precond);\r\nsrc/eigen.c:205:        fprintf(stderr, \"Error: eigenvalue requires a square matrix\\n\");\r\nsrc/eigen.c:225:    double eigenvalue = NAN;\r\nsrc/eigen.c:244:            eigenvalue = vec_dot(v, w, n);\r\nsrc/eigen.c:252:            SolveResult *res = solve_linear_system(OpA, v, solver, precond, solver_tol, solver_maxiter, restart, omega, &fail);\r\nsrc/eigen.c:254:                eigenvalue = NAN;\r\nsrc/eigen.c:260:                eigenvalue = NAN;\r\nsrc/eigen.c:266:                eigenvalue = NAN;\r\nsrc/eigen.c:271:                eigenvalue = 1.0 / rq;\r\nsrc/eigen.c:273:                eigenvalue = sigma + 1.0 / rq;\r\nsrc/eigen.c:281:        if (!isnan(prev_lambda) && fabs(eigenvalue) > 0.0) {\r\nsrc/eigen.c:282:            if (fabs(eigenvalue - prev_lambda) / fabs(eigenvalue) < tol) {\r\nsrc/eigen.c:287:        prev_lambda ="]
[12472.466425, "o", " eigenvalue;\r\nsrc/eigen.c:301:    printf(\"eigenvalue: %.15e\\n\", eigenvalue);\r\nsrc/eigen.c:304:    if (!isnan(eigenvalue)) {\r\nsrc/eigen.c:306:        double lambda = eigenvalue;\r\ninclude/eigen.h:4:int cmd_eigenvalue(int argc, char **argv);\r\ninclude/solvers.h:15:    double *history;        /* true relative residual at each iteration */\r\ninclude/solvers.h:16:    double *precond_history; /* preconditioned residual norm ||M^-1 r|| at each iteration */\r\ninclude/solvers.h:17:    int history_len;        /* number of stored history entries */\r\ninclude/solvers.h:18:} SolveResult;\r\ninclude/solvers.h:20:SolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\ninclude/solvers.h:23:SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\ninclude/solvers.h:26:void solve_result_destroy(SolveResult *res);\r\n"]
