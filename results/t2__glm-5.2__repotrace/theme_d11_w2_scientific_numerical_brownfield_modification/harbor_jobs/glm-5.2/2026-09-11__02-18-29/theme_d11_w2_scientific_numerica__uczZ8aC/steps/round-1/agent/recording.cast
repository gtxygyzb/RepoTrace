[29.527709, "o", "./Makefile\r\n./README.md\r\n./data/sample_matrix.txt\r\n./data/sample_rhs.txt\r\n./include/dense.h\r\n./include/io.h\r\n./include/vector.h\r\n./numsim\r\n./src/dense.c\r\n./src/io.c\r\n./src/main.c\r\n./src/vector.c\r\n"]
