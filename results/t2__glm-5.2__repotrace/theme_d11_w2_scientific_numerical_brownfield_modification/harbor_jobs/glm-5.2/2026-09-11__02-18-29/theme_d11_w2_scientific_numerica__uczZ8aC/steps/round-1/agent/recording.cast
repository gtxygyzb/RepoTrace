[2180.974004, "o", "     5\t\r\n     6\t/*\r\n     7\t * Read dense matrix from text file.\r\n     8\t * Format:\r\n     9\t *   rows cols\r\n    10\t *   a00 a01 a02 ...\r\n    11\t *   a10 a11 a12 ...\r\n    12\t *   ...\r\n    13\t * Returns NULL on error.\r\n"]
[2180.974069, "o", "    14\t */\r\n    15\tDenseMatrix *dm_read_text(const char *filename);\r\n    16\t\r\n    17\t/*\r\n    18\t * Write dense matrix to text file.\r\n    19\t * Returns 0 on success, -1 on error.\r\n    20\t */\r\n    21\tint dm_write_text(const DenseMatrix *m, const char *filename);\r\n    22\t\r\n    23\t/*\r\n    24\t * Read vector from text file.\r\n    25\t * Format:\r\n    26\t *   n\r\n    27\t *   v0\r\n    28\t *   v1\r\n    29\t *   ...\r\n    30\t * Sets *n_out to the dimension. Returns NULL on error.\r\n    31\t */\r\n    32\tdouble *vec_read_text(const char *filename, int *n_out);\r\n    33\t\r\n    34\t/*\r\n    35\t * Write vector to text file.\r\n"]
[2180.974144, "o", "    36\t * Returns 0 on success, -1 on error.\r\n    37\t */\r\n    38\tint vec_write_text(const double *x, int n, const char *filename);\r\n    39\t\r\n    40\t#endif /* IO_H */\r\n"]
