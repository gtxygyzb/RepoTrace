[2249.957384, "o", "\t\r\n   127\t    if (strcmp(type, \"dirichlet\") == 0) bc->type = POISSON_DIRICHLET;\r\n   128\t    else if (strcmp(type, \"neumann\") == 0) bc->type = POISSON_NEUMANN;\r\n   129\t    else return -1;\r\n   130\t\r\n   131\t    bc->file = colon + 1;\r\n   132\t    return 0;\r\n   133\t}\r\n   134\t\r\n   135\tstatic int run_solver_and_print(const CSRMatrix *A, const double *b,\r\n   136\t                                const char *solver, const char *precond,\r\n   137\t                                double tol, int maxiter, int restart,\r\n   138\t                                double omega, const char *output,\r\n   139\t                                const char *history)\r\n   140\t{\r\n   141\t    Precond *P = precond_create(A, precond, omega);\r\n   142\t    if (!P) {\r\n   143\t        fprintf(stderr, \"Error: cannot create preconditioner '%s'\\n\", precond);\r\n   144\t        return 1;\r\n   145\t    }\r\n   146\t\r\n   147\t    SolveResult *res = NULL;\r\n"]
[2249.957486, "o", "   148\t    if (strcmp(solver, \"cg\") == 0) {\r\n   149\t        res = cg_solve(A, b, NULL, tol, maxiter, P);\r\n   150\t    } else if (strcmp(solver, \"gmres\") == 0) {\r\n   151\t        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);\r\n   152\t    } else {\r\n   153\t        fprintf(stderr, \"Error: unknown solver '%s'\\n\", solver);\r\n   154\t        precond_destroy(P);\r\n"]
[2249.957612, "o", "   155\t        return 1;\r\n   156\t    }\r\n   157\t\r\n   158\t    if (!res) {\r\n   159\t        fprintf(stderr, \"Error: solver allocation failed\\n\");\r\n   160\t        precond_destroy(P);\r\n   161\t        return 1;\r\n   162\t    }\r\n   163\t\r\n   164\t    print_solve_summary(res);\r\n   165\t\r\n   166\t    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {\r\n   167\t        fprintf(stderr, \"Error: cannot write output to '%s'\\n\", output);\r\n   168\t    }\r\n   169\t    if (history && write_history_file(res, history) != 0) {\r\n   170\t        fprintf(stderr, \"Error: cannot write history to '%s'\\n\", history);\r\n   171\t    }\r\n   172\t\r\n   173\t    solve_result_destroy(res);\r\n   174\t    precond_destroy(P);\r\n   175\t    return 0;\r\n   176\t}\r\n   177\t\r\n   178\tstatic int cmd_sparse_solve(int argc, char **argv)\r\n   179\t{\r\n   180\t    const char *input = get_opt(argc, argv, \"--input\");\r\n   181\t    const char *rhs_file = get_opt(argc, argv, \"--rhs\");\r\n   182\t    const char *solver = get_opt(argc, argv, \"--solver\");\r\n   183\t    const char *pre"]
[2249.957693, "o", "cond = get_opt(argc, argv, \"--precond\");\r\n   184\t    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n   185\t    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n   186\t    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n   187\t    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n   188\t    const char *output = get_opt(argc, argv, \"--output\");\r\n   189\t    const char *history = get_opt(argc, argv, \"--history\");\r\n   190\t\r\n   191\t    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {\r\n   192\t        fprintf(stderr, \"Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\\n\");\r\n   193\t        usage(\"numsim\");\r\n   194\t        return 1;\r\n   195\t    }\r\n   196\t\r\n   197\t    double tol = atof(tol_s);\r\n   198\t    int maxiter = atoi(maxiter_s);\r\n"]
[2249.957767, "o", "   199\t    int restart = restart_s ? atoi(restart_s) : 30;\r\n   200\t    double omega = omega_s ? atof(omega_s) : 1.0;\r\n   201\t\r\n   202\t    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n   203\t        fprintf(stderr, \"Error: invalid solver parameters\\n\");\r\n   204\t        return 1;\r\n   205\t    }\r\n   206\t\r\n   207\t    CSRMatrix *A = csr_read_mm(input);\r\n   208\t    if (!A) {\r\n   209\t        fprintf(stderr, \"Error: cannot read sparse matrix from '%s'\\n\", input);\r\n"]
