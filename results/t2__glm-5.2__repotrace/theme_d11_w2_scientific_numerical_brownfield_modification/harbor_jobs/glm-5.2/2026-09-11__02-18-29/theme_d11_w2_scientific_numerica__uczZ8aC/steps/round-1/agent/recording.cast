[4142.230305, "o", "\u001b[?2004h> "]
[4142.230487, "o", "    vec_axpy(-1.0, b, r, n);\r\n\u001b[?2004l\r"]
[4142.230543, "o", "\u001b[?2004h> "]
[4142.230912, "o", "    printf(\"Residual norm: %.6e\\n\", vec_norm2(r, n));\r\n\u001b[?2004l\r"]
[4142.230971, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.231039, "o", "\u001b[?2004h> "]
[4142.231124, "o", "    free(r);\r\n\u001b[?2004l\r"]
[4142.23118, "o", "\u001b[?2004h> "]
[4142.231275, "o", "    free(x);\r\n\u001b[?2004l\r"]
[4142.23133, "o", "\u001b[?2004h> "]
[4142.231425, "o", "    free(b);\r\n\u001b[?2004l\r"]
[4142.231489, "o", "\u001b[?2004h> "]
[4142.231614, "o", "    dm_destroy(A);\r\n\u001b[?2004l\r"]
[4142.231678, "o", "\u001b[?2004h> "]
[4142.231777, "o", "    return 0;\r\n\u001b[?2004l\r"]
[4142.231841, "o", "\u001b[?2004h> }\r\n"]
[4142.23191, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[4142.231966, "o", "\u001b[?2004l\r\u001b[?2004h"]
[4142.23202, "o", "> "]
[4142.232325, "o", "static int parse_bc(const char *s, PoissonBC *bc)\r\n\u001b[?2004l\r"]
[4142.232381, "o", "\u001b[?2004h> {\r\n"]
[4142.232442, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4142.232739, "o", "    const char *colon = strchr(s, ':');\r\n\u001b[?2004l\r"]
[4142.232795, "o", "\u001b[?2004h> "]
[4142.233091, "o", "    if (!colon || colon == s) return -1;\r\n\u001b[?2004l\r"]
[4142.23315, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.233209, "o", "\u001b[?2004h> "]
[4142.233399, "o", "    size_t len = colon - s;\r\n\u001b[?2004l\r"]
[4142.233448, "o", "\u001b[?2004h> "]
[4142.233594, "o", "    char type[32];\r\n\u001b[?2004l\r"]
[4142.233652, "o", "\u001b[?2004h> "]
[4142.233931, "o", "    if (len >= sizeof(type)) return -1;\r\n\u001b[?2004l\r"]
[4142.233987, "o", "\u001b[?2004h> "]
[4142.234167, "o", "    memcpy(type, s, len);\r\n\u001b[?2004l\r"]
[4142.23423, "o", "\u001b[?2004h> "]
[4142.234383, "o", "    type[len] = '\\0';\r\n\u001b[?2004l\r"]
[4142.234447, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.234493, "o", "\u001b[?2004h> "]
[4142.234985, "o", "    if (strcmp(type, \"dirichlet\") == 0) bc->type = POISSON_DIRICHLET;\r\n\u001b[?2004l\r"]
[4142.235043, "o", "\u001b[?2004h> "]
[4142.235516, "o", "    else if (strcmp(type, \"neumann\") == 0) bc->type = POISSON_NEUMANN;\r\n\u001b[?2004l\r"]
[4142.235573, "o", "\u001b[?2004h> "]
[4142.235713, "o", "    else return -1;\r\n\u001b[?2004l\r"]
[4142.235771, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.235828, "o", "\u001b[?2004h> "]
[4142.235938, "o", "    bc->file = colon + 1;\r\n\u001b[?2004l\r"]
[4142.235995, "o", "\u001b[?2004h> "]
[4142.236047, "o", "    return 0;\r\n\u001b[?2004l\r"]
[4142.236101, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4142.236156, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4142.236211, "o", "> "]
