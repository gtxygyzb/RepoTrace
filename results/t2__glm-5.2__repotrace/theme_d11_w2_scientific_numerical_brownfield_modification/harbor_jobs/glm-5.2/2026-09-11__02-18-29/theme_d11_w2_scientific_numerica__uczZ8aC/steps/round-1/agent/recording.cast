[916.221145, "o", "\u001b[?2004h> "]
[916.221245, "o", "#define POISSON_H\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[916.221325, "o", "\u001b[?2004h> "]
[916.221427, "o", "#include \"sparse.h\"\r\n\u001b[?2004l\r"]
