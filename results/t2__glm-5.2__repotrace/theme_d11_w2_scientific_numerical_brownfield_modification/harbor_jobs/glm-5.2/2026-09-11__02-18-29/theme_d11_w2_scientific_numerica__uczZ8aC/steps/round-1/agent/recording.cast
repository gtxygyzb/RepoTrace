[11138.73474, "o", "\t        }\r\n   426\t        solver_calls++;\r\n   427\t\r\n   428\t        if (res) {\r\n   429\t            if (!res->converged) converged_all = 0;\r\n   430\t            if (res->relres > max_residual) max_residual = res->relres;\r\n   431\t            vec_copy(res->x, u_new, n);\r\n   432\t            solve_result_destroy(res);\r\n   433\t        } else {\r\n   434\t            converged_all = 0;\r\n   435\t            if (max_residual < 1.0e30) max_residual = 1.0e30;\r\n   436\t            vec_copy(u, u_new, n);\r\n   437\t        }\r\n"]
