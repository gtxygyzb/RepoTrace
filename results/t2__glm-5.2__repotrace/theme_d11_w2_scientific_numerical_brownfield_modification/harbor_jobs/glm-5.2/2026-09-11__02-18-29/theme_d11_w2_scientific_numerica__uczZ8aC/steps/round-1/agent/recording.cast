[2180.14773, "o", "     7\t    int    rows;\r\n     8\t    int    cols;\r\n     9\t    int    nnz;\r\n    10\t    double *values;\r\n    11\t    int    *col_indices;\r\n    12\t    int    *row_ptr;\r\n    13\t} CSRMatrix;\r\n"]
[2180.147799, "o", "    14\t\r\n    15\ttypedef struct {\r\n    16\t    int    rows;\r\n    17\t    int    cols;\r\n    18\t    int    nnz;\r\n    19\t    double *values;\r\n    20\t    int    *row;\r\n    21\t    int    *col;\r\n    22\t} COOMatrix;\r\n    23\t\r\n    24\t/* Lifecycle */\r\n    25\tCSRMatrix  *csr_create(int rows, int cols, int nnz);\r\n    26\tvoid        csr_destroy(CSRMatrix *A);\r\n    27\tCOOMatrix  *coo_create(int rows, int cols, int nnz);\r\n    28\tvoid        coo_destroy(COOMatrix *A);\r\n    29\t\r\n    30\t/* Conversions */\r\n    31\tCOOMatrix  *csr_to_coo(const CSRMatrix *A);\r\n    32\tCSRMatrix  *coo_to_csr(const COOMatrix *A);\r\n    33\t\r\n    34\t/* Operations */\r\n    35\tvoid        csr_spmv(const CSRMatrix *A, const double *x, double *y);\r\n    36\tCSRMatrix  *csr_transpose(const CSRMatrix *A);\r\n"]
[2180.147865, "o", "    37\tint         csr_is_symmetric(const CSRMatrix *A, double tol);\r\n    38\tdouble     *csr_diagonal(const CSRMatrix *A);\r\n    39\t\r\n    40\t/* Matrix Market I/O */\r\n    41\tCSRMatrix  *csr_read_mm(const char *filename);\r\n    42\tint         csr_write_mm(const CSRMatrix *A, const char *filename);\r\n    43\tdouble     *vec_read_mm_array(const char *filename, int *n_out);\r\n    44\tint         vec_write_mm_array(const double *x, int n, const char *filename);\r\n    45\t\r\n"]
