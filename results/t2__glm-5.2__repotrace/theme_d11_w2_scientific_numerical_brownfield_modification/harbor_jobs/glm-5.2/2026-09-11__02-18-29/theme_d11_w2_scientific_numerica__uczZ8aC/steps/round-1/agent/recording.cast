[7946.334234, "o", "\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    bc->file = colon + 1;\r\n\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return 0;\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[7946.334398, "o", "\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstatic int run_solver_and_print\u001b[m\u001b[K(const CSRMatrix *A, const double *b,\r\n"]
[7946.33447, "o", "\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                const char *solver, const char *precond,\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                double tol, int maxiter, int restart,\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                double omega, const char *output,\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                const char *history)\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Precond *P = precond_create(A, precond, omega);\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!P) {\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fprintf(stderr, \"Error: cannot create preconditioner '%s'\\n\", precond);\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        return 1;\r\n\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    SolveResult *res = NULL;"]
[7946.334555, "o", "\r\n\u001b[32m\u001b[K162\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (strcmp(solver, \"cg\") == 0) {\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        res = cg_solve(A, b, NULL, tol, maxiter, P);\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else if (strcmp(solver, \"gmres\") == 0) {\r\n\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);\r\n\u001b[32m\u001b[K166\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else {\r\n\u001b[32m\u001b[K167\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fprintf(stderr, \"Error: unknown solver '%s'\\n\", solver);\r\n\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        precond_destroy(P);\r\n\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        return 1;\r\n\u001b[32m\u001b[K170\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K171\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!res) {\r\n\u001b[32m\u001b[K173\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fprintf(stderr, \"Error: solver allocation failed\\n\");\r\n"]
[7946.334622, "o", "\u001b[32m\u001b[K174\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        precond_destroy(P);\r\n\u001b[32m\u001b[K175\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        return 1;\r\n\u001b[32m\u001b[K176\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K177\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    print_solve_summary(res);\r\n\u001b[32m\u001b[K179\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {\r\n\u001b[32m\u001b[K181\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fprintf(stderr, \"Error: cannot write output to '%s'\\n\", output);\r\n\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (history && write_history_file(res, history) != 0) {\r\n\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fprintf(stderr, \"Error: cannot write history to '%s'\\n\", history);\r\n"]
[7946.334686, "o", "\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    solve_result_destroy(res);\r\n\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    precond_destroy(P);\r\n\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return 0;\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K191\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic int cmd_sparse_solve(int argc, char **argv)\r\n\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const char *input = get_opt(argc, argv, \"--input\");\r\n\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const char *rhs_file = get_opt(argc, argv, \"--rhs\");\r\n"]
