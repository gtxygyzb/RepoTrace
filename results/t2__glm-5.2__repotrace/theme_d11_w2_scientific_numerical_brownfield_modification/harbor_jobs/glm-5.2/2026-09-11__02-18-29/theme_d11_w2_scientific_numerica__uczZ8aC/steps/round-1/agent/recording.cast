[8278.028971, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/eigen.c')\ns = p.read_text()\nold = '''            double nrm = vec_norm2(res->x, n);\n            if (nrm < 1e-300) {\n                eigenvalue = NAN;\n                solve_result_destroy(res);\n                break;\n            }\n            for (int i = 0; i < n; i++) w[i] = res->x[i] / nrm;\n            csr_spmv(OpA, w, Av);\n            double rq = vec_dot(w, Av, n);\n            if (fabs(rq) < 1e-300) {\n                eigenvalue = NAN;\n                solve_result_destroy(res);\n                break;\n            }\n            if (method == 1) {\n                eigenvalue = 1.0 / rq;\n            } else {\n                eigenvalue = sigma + 1.0 / rq;\n            }\n            memcpy(v, w, n * sizeof(double));\n            solve_result_destroy(res);'''\nnew = '''            double wnorm = vec_norm2(res->x, n);\n            if (wnorm < 1e-300) {\n                eigenvalue = NAN;\n                solve_result_destroy(res);\n                break;\n            }\n"]
[8278.029287, "i", "            double rq = vec_dot(v, res->x, n);\n            if (fabs(rq) < 1e-300) {\n                eigenvalue = NAN;\n                solve_result_destroy(res);\n                break;\n            }\n            if (method == 1) {\n                eigenvalue = 1.0 / rq;\n            } else {\n                eigenvalue = sigma + 1.0 / rq;\n            }\n            for (int i = 0; i < n; i++) w[i] = res->x[i] / wnorm;\n            memcpy(v, w, n * sizeof(double));\n            solve_result_destroy(res);'''\ns = s.replace(old, new)\ns = s.replace('    if (eigvec_output && !isnan(eigenvalue)) {', '    if (eigvec_output) {')\np.write_text(s)\nPY\n"]
