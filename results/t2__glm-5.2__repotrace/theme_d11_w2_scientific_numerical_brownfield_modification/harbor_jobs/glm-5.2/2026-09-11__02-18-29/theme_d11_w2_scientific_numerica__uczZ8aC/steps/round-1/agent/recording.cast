[11146.178087, "o", "    free(next);\r\n    coo_destroy(sorted);\r\n    return out;\r\n}\r\n\r\nvoid csr_spmv(const CSRMatrix *A, const double *x, double *y)\r\n{\r\n"]
[11146.178224, "o", "    for (int i = 0; i < A->rows; i++) {\r\n        double s = 0.0;\r\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n            s += A->values[k] * x[A->col_indices[k]];\r\n        }\r\n        y[i] = s;\r\n    }\r\n}\r\n\r\nstatic int csr_find_in_row(const CSRMatrix *A, int row, int col)\r\n{\r\n    int lo = A->row_ptr[row];\r\n    int hi = A->row_ptr[row+1] - 1;\r\n    while (lo <= hi) {\r\n        int mid = (lo + hi) / 2;\r\n        if (A->col_indices[mid] == col) return mid;\r\n        if (A->col_indices[mid] < col) lo = mid + 1;\r\n        else hi = mid - 1;\r\n    }\r\n    return -1;\r\n}\r\n\r\nCSRMatrix *csr_transpose(const CSRMatrix *A)\r\n{\r\n    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);\r\n    if (!T) return NULL;\r\n\r\n    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;\r\n    for (int k = 0; k < A->nnz; k++) {\r\n        T->row_ptr[A->col_indices[k] + 1]++;\r\n"]
[11146.178304, "o", "    }\r\n    for (int i = 0; i < A->cols; i++) {\r\n        T->row_ptr[i+1] += T->row_ptr[i];\r\n    }\r\n\r\n    int *next = (int *)malloc((A->cols > 0 ? A->cols : 1) * sizeof(int));\r\n    if (!next) { csr_destroy(T); return NULL; }\r\n    for (int i = 0; i < A->cols; i++) next[i] = T->row_ptr[i];\r\n\r\n"]
