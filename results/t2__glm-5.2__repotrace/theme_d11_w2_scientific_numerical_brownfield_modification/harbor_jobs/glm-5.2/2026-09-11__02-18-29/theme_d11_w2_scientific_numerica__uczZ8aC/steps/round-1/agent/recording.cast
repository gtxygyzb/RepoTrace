[4012.741739, "o", "\u001b[?2004h> "]
[4012.742026, "o", "    double factor = is_cn ? 0.5 * alpha * dt : alpha * dt;\r\n\u001b[?2004l\r"]
[4012.742117, "o", "\u001b[?2004h> "]
