[9723.225488, "o", "nl -ba src/sparse.c | sed -n '120,320p'\r\n"]
[9723.225578, "o", "\u001b[?2004l\r"]
[9723.229162, "o", "   120\t    if (!sorted) return NULL;\r\n   121\t\r\n   122\t    CSRMatrix *out = csr_create(sorted->rows, sorted->cols, sorted->nnz);\r\n   123\t    if (!out) { coo_destroy(sorted); return NULL; }\r\n   124\t\r\n   125"]
[9723.229243, "o", "\t    for (int i = 0; i <= sorted->rows; i++) out->row_ptr[i] = 0;\r\n   126\t\r\n   127\t    for (int k = 0; k < sorted->nnz; k++) {\r\n   128\t        out->row_ptr[sorted->row[k] + 1]++;\r\n   129\t    }\r\n   130\t    for (int i = 0; i < sorted->rows; i++) {\r\n   131\t        out->row_ptr[i+1] += out->row_ptr[i];\r\n   132\t    }\r\n   133\t\r\n   134\t    int *next = (int *)malloc((sorted->rows > 0 ? sorted->rows : 1) * sizeof(int));\r\n   135\t    if (!next) { csr_destroy(out); coo_destroy(sorted); return NULL; }\r\n   136\t    for (int i = 0; i < sorted->rows; i++) next[i] = out->row_ptr[i];\r\n   137\t\r\n"]
[9723.22934, "o", "   138\t    for (int k = 0; k < sorted->nnz; k++) {\r\n   139\t        int r = sorted->row[k];\r\n   140\t        int pos = next[r]++;\r\n   141\t        out->col_indices[pos] = sorted->col[k];\r\n   142\t        out->values[pos] = sorted->values[k];\r\n   143\t    }\r\n   144\t\r\n   145\t    free(next);\r\n   146\t    coo_destroy(sorted);\r\n   147\t    return out;\r\n   148\t}\r\n   149\t\r\n   150\tvoid csr_spmv(const CSRMatrix *A, const double *x, double *y)\r\n   151\t{\r\n   152\t    for (int i = 0; i < A->rows; i++) {\r\n   153\t        double s = 0.0;\r\n"]
[9723.229407, "o", "   154\t        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n   155\t            s += A->values[k] * x[A->col_indices[k]];\r\n   156\t        }\r\n   157\t        y[i] = s;\r\n   158\t    }\r\n   159\t}\r\n   160\t\r\n   161\tstatic int csr_find_in_row(const CSRMatrix *A, int row, int col)\r\n   162\t{\r\n   163\t"]
[9723.22947, "o", "    int lo = A->row_ptr[row];\r\n   164\t    int hi = A->row_ptr[row+1] - 1;\r\n   165\t    while (lo <= hi) {\r\n   166\t        int mid = (lo + hi) / 2;\r\n   167\t        if (A->col_indices[mid] == col) return mid;\r\n   168\t        if (A->col_indices[mid] < col) lo = mid + 1;\r\n   169\t        else hi = mid - 1;\r\n   170\t    }\r\n   171\t    return -1;\r\n"]
[9723.229537, "o", "   172\t}\r\n   173\t\r\n   174\tCSRMatrix *csr_transpose(const CSRMatrix *A)\r\n   175\t{\r\n   176\t    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);\r\n   177\t    if (!T) return NULL;\r\n   178\t\r\n   179\t    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;\r\n   180\t    for (int k = 0; k < A->nnz; k++) {\r\n   181\t        T->row_ptr[A->col_indices[k] + 1]++;\r\n   182\t    }\r\n"]
[9723.2296, "o", "   183\t    for (int i = 0; i < A->cols; i++) {\r\n   184\t        T->row_ptr[i+1] += T->row_ptr[i];\r\n   185\t    }\r\n   186\t\r\n   187\t    int *next = (int *)malloc((A->cols > 0 ? A->cols : 1) * sizeof(int));\r\n   188\t    if (!next) { csr_destroy(T); return NULL; }\r\n   189\t    for (int i = 0; i < A->cols; i++) next[i] = T->row_ptr[i];\r\n   190\t\r\n   191\t    for (int i = 0; i < A->rows; i++) {\r\n"]
[9723.229675, "o", "   192\t        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n   193\t            int c = A->col_indices[k];\r\n   194\t            int pos = next[c]++;\r\n   195\t            T->col_indices[pos] = i;\r\n   196\t            T->values[pos] = A->values[k];\r\n   197\t        }\r\n   198\t    }\r\n   199\t\r\n   200\t    free(next);\r\n   201\t    return T;\r\n   202\t}\r\n   203\t\r\n   204"]
[9723.229735, "o", "\tint csr_is_symmetric(const CSRMatrix *A, double tol)\r\n   205\t{\r\n   206\t    if (A->rows != A->cols) return 0;\r\n   207\t    for (int i = 0; i < A->rows; i++) {\r\n   208\t        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n   209\t            int j = A->col_indices[k];\r\n   210\t            int idx = csr_find_in_row(A, j, i);\r\n   211\t            if (idx < 0) return 0;\r\n   212\t            if (fabs(A->values[k] - A->values[idx]) > tol) return 0;"]
[9723.229796, "o", "\r\n   213\t        }\r\n   214\t    }\r\n   215\t    return 1;\r\n   216\t}\r\n   217\t\r\n   218\tdouble *csr_diagonal(const CSRMatrix *A)\r\n   219\t{\r\n   220\t    int n = A->rows < A->cols ? A->rows : A->cols;\r\n   221"]
[9723.229855, "o", "\t    double *diag = vec_create(n);\r\n   222\t    if (!diag) return NULL;\r\n   223\t    for (int i = 0; i < n; i++) {\r\n   224\t        int idx = csr_find_in_row(A, i, i);\r\n   225\t        diag[i] = (idx >= 0) ? A->values[idx] : 0.0;\r\n   226\t    }\r\n   227\t    return diag;\r\n   228\t}\r\n"]
[9723.229935, "o", "   229\t\r\n   230\tstatic int mm_parse_header(const char *line, int *is_array, int *is_symmetric)\r\n   231\t{\r\n   232\t    char buf[1024];\r\n   233\t    strncpy(buf, line, sizeof(buf)-1);\r\n   234\t    buf[sizeof(buf)-1] = '\\0';\r\n   235\t\r\n   236\t    char *tok = strtok(buf, \" \\t\\r\\n\");\r\n   237\t    if (!tok || strcmp(tok, \"%%MatrixMarket\") != 0) return -1;\r\n"]
[9723.230001, "o", "   238\t\r\n   239\t    tok = strtok(NULL, \" \\t\\r\\n\");\r\n   240\t    if (!tok || strcmp(tok, \"matrix\") != 0) return -1;\r\n   241\t\r\n   242\t    tok = strtok(NULL, \" \\t\\r\\n\");\r\n   243\t    if (!tok) return -1;\r\n   244\t    if (strcmp(tok, \"coordinate\") == 0) *is_array = 0;\r\n   245\t    else if (strcmp(tok, \"array\") == 0) *is_array = 1;\r\n   246\t    else return -1;\r\n   247\t\r\n"]
[9723.230063, "o", "   248\t    tok = strtok(NULL, \" \\t\\r\\n\");\r\n   249\t    if (!tok) return -1;\r\n   250\t    if (strcmp(tok, \"real\") != 0 && strcmp(tok, \"double\") != 0) return -1;\r\n   251\t\r\n   252\t    *is_symmetric = 0;\r\n   253\t    tok = strtok(NULL, \" \\t\\r\\n\");\r\n   254\t    if (tok && strcmp(tok, \"symmetric\") == 0) *is_symmetric = 1;\r\n   255\t\r\n"]
[9723.230127, "o", "   256\t    return 0;\r\n   257\t}\r\n   258\t\r\n   259\tstatic int read_non_comment_line(FILE *fp, char *buf, int bufsize)\r\n   260\t{\r\n   261\t    while (fgets(buf, bufsize, fp)) {\r\n   262\t        char *s = buf;\r\n   263\t        while (*s == ' ' || *s == '\\t') s++;\r\n   264\t        if (*s == '%' || *s == '\\n' || *s == '\\r' || *s == '\\0') continue;\r\n   265\t        return 0;\r\n"]
[9723.230193, "o", "   266\t    }\r\n   267\t    return -1;\r\n   268\t}\r\n   269\t\r\n   270\tCSRMatrix *csr_read_mm(const char *filename)\r\n   271\t{\r\n   272\t    FILE *fp = fopen(filename, \"r\");\r\n   273\t    if (!fp) return NULL;\r\n   274\t\r\n   275\t    char line[1024];\r\n   276"]
[9723.230252, "o", "\t    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }\r\n   277\t    int is_array = 0, is_symmetric = 0;\r\n   278\t    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || is_array) {\r\n   279\t        fclose(fp);\r\n   280\t        return NULL;\r\n   281\t    }\r\n   282\t\r\n   283\t    int rows, cols, nnz;\r\n"]
[9723.230325, "o", "   284\t    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }\r\n   285\t    if (sscanf(line, \"%d %d %d\", &rows, &cols, &nnz) != 3 || rows <= 0 || cols <= 0 || nnz < 0) {\r\n   286\t        fclose(fp);\r\n   287\t        return NULL;\r\n   288\t    }\r\n   289\t\r\n   290\t    int cap = is_symmetric ? 2 * nnz + 1 : nnz;\r\n   291\t    if (cap < 1) cap = 1;\r\n   292\t    COOMatrix *coo = coo_create(rows, cols, cap);\r\n   293\t    if (!coo) { fclose(fp); return NULL; }\r\n   294\t\r\n"]
[9723.230385, "o", "   295\t    int k = 0;\r\n   296\t    while (k < coo->nnz && read_non_comment_line(fp, line, sizeof(line)) == 0) {\r\n   297\t        int r, c;\r\n   298\t        double v;\r\n   299\t        if (sscanf(line, \"%d %d %lf\", &r, &c, &v) != 3) continue;\r\n   300\t        if (r < 1 || r > rows || c < 1 || c > cols) continue;\r\n   301\t        r--; c--;\r\n   302\t\r\n"]
[9723.230449, "o", "   303\t        coo->row[k] = r;\r\n   304\t        coo->col[k] = c;\r\n   305\t        coo->values[k] = v;\r\n   306\t        k++;\r\n   307\t\r\n   308\t        if (is_symmetric && r != c) {\r\n   309\t            coo->row[k] = c;\r\n   310\t            coo->col[k] = r;\r\n"]
[9723.230509, "o", "   311\t            coo->values[k] = v;\r\n   312\t            k++;\r\n   313\t        }\r\n   314\t    }\r\n   315\t    coo->nnz = k;\r\n   316\t\r\n   317\t    CSRMatrix *A = coo_to_csr(coo);\r\n   318\t    coo_destroy(coo);\r\n   319\t    fclose(fp);\r\n"]
[9723.230564, "o", "   320\t    return A;\r\n"]
