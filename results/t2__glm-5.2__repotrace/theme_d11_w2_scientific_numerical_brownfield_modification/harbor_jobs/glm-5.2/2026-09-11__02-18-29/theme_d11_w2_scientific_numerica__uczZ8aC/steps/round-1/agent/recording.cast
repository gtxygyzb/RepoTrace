[916.224406, "o", "\u001b[?2004h> "]
[916.224719, "o", "                    CSRMatrix **A_out, double **b_out);\r\n\u001b[?2004l\r"]
[916.224775, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[916.224832, "o", "\u001b[?2004h> "]
