[11068.027692, "o", "-history <file>]\\n\", prog);\r\n    25\t    fprintf(stderr, \"  %s eigenvalue --input <mtx_file> --method <power|inverse|shifted-inverse> [--shift <sigma>] --tol <value> --maxiter <int> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> [--restart <m>] [--ssor-omega <value>] [--solver-tol <value>] [--solver-maxiter <int>] [--eigvec-output <file>]\\n\", prog);\r\n    26\t}\r\n    27\t\r\n    28\tstatic const char *get_opt(int argc, char **argv, const char *name)\r\n    29\t{\r\n    30\t    for (int i = 0; i < argc - 1; i++) {\r\n    31\t        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    32\t    }\r\n    33\t    return NULL;\r\n    34\t}\r\n    35\t\r\n    36\tstatic int write_history_file(const SolveResult *res, const char *filename)\r\n    37\t{\r\n    38\t    FILE *fp = fopen(filename, \"w\");\r\n    39\t    if (!fp) return -1;\r\n    40\t    for (int i = 0; i < res->history_len; i++) {\r\n    41\t        fprintf(fp, \"%d\\t%.15e\\t%.15e\\n\", i, res->history[i], res->precond_history[i]);\r\n    42\t    }\r\n    43\t    fclose(fp);\r\n    44\t    return 0;\r\n   "]
[11068.027763, "o", " 45\t}\r\n    46\t\r\n    47\tstatic void print_solve_summary(const SolveResult *res)\r\n    48\t{\r\n    49\t    printf(\"converged: %s\\n\", res->converged ? \"yes\" : \"no\");\r\n    50\t    printf(\"iterations: %d\\n\", res->iterations);\r\n    51\t    printf(\"residual: %.6e\\n\", res->relres);\r\n    52\t    printf(\"true_residual: %.6e\\n\", res->true_residual);\r\n    53\t}\r\n    54\t\r\n    55\tstatic int validate_ssor_omega(double omega)\r\n    56\t{\r\n    57\t    if (!(omega > 0.0 && omega < 2.0)) {\r\n    58\t        fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n    59\t        return 1;\r\n    60\t    }\r\n    61\t    return 0;\r\n    62\t}\r\n    63\t\r\n"]
[11068.027843, "o", "    64\tstatic int cmd_dense_solve(int argc, char **argv)\r\n    65\t{\r\n    66\t    if (argc < 2) {\r\n    67\t        fprintf(stderr, \"Error: dense-solve requires <matrix_file> <rhs_file>\\n\");\r\n    68\t        return 1;\r\n    69\t    }\r\n    70\t\r\n    71\t    const char *mat_file = argv[0];\r\n    72\t    const char *rhs_file = argv[1];\r\n    73\t    const char *out_file = (argc >= 3) ? argv[2] : NULL;\r\n    74\t\r\n    75\t    DenseMatrix *A = dm_read_text(mat_file);\r\n    76\t    if (!A) {\r\n    77\t        fprintf(stderr, \"Error: cannot read matrix from '%s'\\n\", mat_file);\r\n    78\t        return 1;\r\n    79\t"]
[11068.027952, "o", "    }\r\n    80\t\r\n    81\t    int n;\r\n    82\t    double *b = vec_read_text(rhs_file, &n);\r\n    83\t    if (!b) {\r\n    84\t        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n    85\t        dm_destroy(A);\r\n    86\t        return 1;\r\n    87\t    }\r\n    88\t\r\n    89\t    if (A->rows != n || A->cols != n) {\r\n    90\t        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n    91\t                A->rows, A->cols, n);\r\n"]
[11068.028016, "o", "    92\t        free(b);\r\n    93\t        dm_destroy(A);\r\n    94\t        return 1;\r\n    95\t    }\r\n    96\t\r\n    97\t    double *x = vec_create(n);\r\n    98\t    if (!x) {\r\n    99\t        fprintf(stderr, \"Error: allocation failed\\n\");\r\n   100\t        free(b);\r\n   101\t        dm_destroy(A);\r\n   102\t        return 1;\r\n   103\t    }\r\n   104\t\r\n"]
