[11119.105634, "o", "\t    printf(\"final_time: %.15e\\n\", dt * (double)nsteps);\r\n   448\t    printf(\"solver_calls: %d\\n\", solver_calls);\r\n   449\t    printf(\"converged_all: %s\\n\", converged_all ? \"yes\" : \"no\");\r\n   450\t    printf(\"max_residual: %.6e\\n\", max_residual);\r\n   451\t\r\n   452\t    free(u_new); free(rhs); free(tmp);\r\n   453\t    precond_destroy(P);\r\n   454\t    csr_destroy(A_rhs);\r\n   455\t    csr_destroy(A_sys);\r\n   456\t    free(flux);\r\n"]
[11119.105695, "o", "   457\t    free(left_vals); free(right_vals); free(bottom_vals); free(top_vals);\r\n   458\t    for (int i = 0; i < nsources; i++) free(sources[i]);\r\n   459\t    free(sources);\r\n   460\t    free_source_list(source_files, nsources);\r\n   461\t    free(u);\r\n   462\t    return rc;\r\n   463\t}\r\n"]
[11119.106234, "o", "\u001b[?2004h"]
