[9695.061733, "o", "#ifndef IO_H\r\n#define IO_H\r\n\r\n#include \"dense.h\"\r\n\r\n"]
[9695.061779, "o", "/*\r\n * Read dense matrix from text file.\r\n * Format:\r\n *   rows cols\r\n *   a00 a01 a02 ...\r\n"]
[9695.061928, "o", " *   a10 a11 a12 ...\r\n *   ...\r\n * Returns NULL on error.\r\n */\r\nDenseMatrix *dm_read_text(const char *filename);\r\n\r\n/*\r\n * Write dense matrix to text file.\r\n * Returns 0 on success, -1 on error.\r\n */\r\nint dm_write_text(const DenseMatrix *m, const char *filename);\r\n\r\n/*\r\n * Read vector from text file.\r\n * Format:\r\n *   n\r\n *   v0\r\n *   v1\r\n *   ...\r\n * Sets *n_out to the dimension. Returns NULL on error.\r\n"]
[9695.062001, "o", " */\r\ndouble *vec_read_text(const char *filename, int *n_out);\r\n\r\n/*\r\n * Write vector to text file.\r\n * Returns 0 on success, -1 on error.\r\n */\r\nint vec_write_text(const double *x, int n, const char *filename);\r\n\r\n#endif /* IO_H */\r\n"]
[9695.062484, "o", "\u001b[?2004h"]
[9695.062542, "o", "root@n30009:/app# "]
[9695.330467, "i", "sed -n '1,260p' include/sparse.h\n"]
[9695.330784, "o", "sed -n '1,260p' include/sparse.h\r\n\u001b[?2004l\r"]
[9695.33377, "o", "#ifndef SPARSE_H\r\n#define SPARSE_H\r\n\r\n#include <stdio.h>\r\n\r\ntypedef struct {\r\n    int    rows;\r\n    int    cols;\r\n"]
[9695.333917, "o", "    int    nnz;\r\n    double *values;\r\n    int    *col_indices;\r\n    int    *row_ptr;\r\n} CSRMatrix;\r\n\r\ntypedef struct {\r\n    int    rows;\r\n    int    cols;\r\n    int    nnz;\r\n    double *values;\r\n    int    *row;\r\n    int    *col;\r\n} COOMatrix;\r\n\r\n/* Lifecycle */\r\nCSRMatrix  *csr_create(int rows, int cols, int nnz);\r\nvoid        csr_destroy(CSRMatrix *A);\r\nCOOMatrix  *coo_create(int rows, int cols, int nnz);\r\nvoid        coo_destroy(COOMatrix *A);\r\n\r\n/* Conversions */\r\nCOOMatrix  *csr_to_coo(const CSRMatrix *A);\r\nCSRMatrix  *coo_to_csr(const COOMatrix *A);\r\n\r\n/* Operations */\r\nvoid        csr_spmv(const CSRMatrix *A, const double *x, double *y);\r\nCSRMatrix  *csr_transpose(const CSRMatrix *A);\r\n"]
[9695.333996, "o", "int         csr_is_symmetric(const CSRMatrix *A, double tol);\r\ndouble     *csr_diagonal(const CSRMatrix *A);\r\n\r\n/* Matrix Market I/O */\r\nCSRMatrix  *csr_read_mm(const char *filename);\r\nint         csr_write_mm(const CSRMatrix *A, const char *filename);\r\ndouble     *vec_read_mm_array(const char *filename, int *n_out);\r\nint         vec_write_mm_array(const double *x, int n, const char *filename);"]
[9695.334073, "o", "\r\n\r\n#endif /* SPARSE_H */\r\n"]
[9695.334508, "o", "\u001b[?2004h"]
[9695.334566, "o", "root@n30009:/app# "]
[9695.60462, "i", "cat Makefile\n"]
[9695.604833, "o", "cat Makefile\r\n\u001b[?2004l\r"]
[9695.607196, "o", ".RECIPEPREFIX := >\r\n\r\nCC      = gcc\r\nCFLAGS  = -Wall -Wextra -O2 -Iinclude\r\nLDFLAGS = -lm\r\n\r\nSRC     = src/main.c src/dense.c src/vector.c src/io.c src/sparse.c src/precond.c src/solvers.c src/poisson.c src/heat.c src/convdiff.c src/eigen.c\r\nOBJ     = $(SRC:.c=.o)\r\nBIN     = numsim\r\n\r\n.PHONY: all clean\r\n\r\nall: $(BIN)\r\n\r\n$(BIN): $(SRC)\r\n>$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)\r\n\r\nclean:\r\n>rm -f $(BIN) $(OBJ)\r\n"]
[9695.607608, "o", "\u001b[?2004h"]
[9695.607674, "o", "root@n30009:/app# "]
[9702.777164, "i", "sed -n '1,180p' src/main.c\n"]
[9702.777446, "o", "sed -n '1,180p' src/main.c\r\n\u001b[?2004l\r"]
[9702.780541, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include \"dense.h\"\r\n#include \"vector.h\"\r\n#include \"io.h\"\r\n#include \"sparse.h\"\r\n#include \"precond.h\"\r\n#include \"solvers.h\"\r\n#include \"poisson.h\"\r\n#include \"heat.h\"\r\n#include \"convdiff.h\"\r\n#include \"eigen.h\"\r\n"]
[9702.780691, "o", "\r\nstatic void usage(const char *prog)\r\n{\r\n    fprintf(stderr, \"Usage:\\n\");\r\n    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\n\", prog);\r\n    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s heat --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --alpha <float> --dt <float> --nsteps <int> --scheme <bac"]
[9702.780773, "o", "kward-euler|crank-nicolson> --ic <file> --source <file>[,<file>,...] --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file>\\n\", prog);\r\n    fprintf(stderr, \"  %s convdiff --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --kappa <float> --vx <float> --vy <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file> [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s eigenvalue --input <mtx_file> --method <power|inverse|shifted-inverse> [--shift <sigma>] --tol <value> --maxiter <int> --solver <cg|gmres"]
[9702.780838, "o", "> --precond <none|jacobi|ilu0|ssor> [--restart <m>] [--ssor-omega <value>] [--solver-tol <value>] [--solver-maxiter <int>] [--eigvec-output <file>]\\n\", prog);\r\n}\r\n\r\nstatic const char *get_opt(int argc, char **argv, const char *name)\r\n{\r\n    for (int i = 0; i < argc - 1; i++) {\r\n        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    }\r\n    return NULL;\r\n}\r\n\r\nstatic int write_history_file(const SolveResult *res, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    for (int i = 0; i < res->history_len; i++) {\r\n        fprintf(fp, \"%d\\t%.15e\\t%.15e\\n\", i, res->history[i], res->precond_history[i]);\r\n    }\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n\r\nstatic void print_solve_summary(const SolveResult *res)\r\n{\r\n    printf(\"converged: %s\\n\", res->converged ? \"yes\" : \"no\");\r\n    printf(\"iterations: %d\\n\", res->iterations);\r\n    printf(\"residual: %.6e\\n\", res->relres);\r\n    printf(\"true_residual: %.6e\\n\", res->true_residual);\r\n}\r\n\r\nstatic int validate_ssor_omega(double omega)\r\n{\r"]
[9702.780927, "o", "\n    if (!(omega > 0.0 && omega < 2.0)) {\r\n        fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int cmd_dense_solve(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"Error: dense-solve requires <matrix_file> <rhs_file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    const char *mat_file = argv[0];\r\n    const char *rhs_file = argv[1];\r\n    const char *out_file = (argc >= 3) ? argv[2] : NULL;\r\n\r\n    DenseMatrix *A = dm_read_text(mat_file);\r\n    if (!A) {\r\n        fprintf(stderr, \"Error: cannot read matrix from '%s'\\n\", mat_file);\r\n        return 1;\r\n    }\r\n\r\n    int n;\r\n    double *b = vec_read_text(rhs_file, &n);\r\n    if (!b) {\r\n        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n"]
[9702.780988, "o", "        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (A->rows != n || A->cols != n) {\r\n        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n                A->rows, A->cols, n);\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n"]
[9702.781068, "o", "    double *x = vec_create(n);\r\n    if (!x) {\r\n        fprintf(stderr, \"Error: allocation failed\\n\");\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n"]
[9702.78113, "o", "    int rc = dm_solve(A, b, x);\r\n    if (rc != 0) {\r\n        fprintf(stderr, \"Error: solver failed (singular or ill-conditioned)\\n\");\r\n        free(x);\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (out_file) {\r\n        vec_write_text(x, n, out_file);\r\n        printf(\"Solution written to %s\\n\", out_file);\r\n    } else {\r\n        printf(\"Solution:\\n\");\r\n        vec_print(x, n, stdout);\r\n    }\r\n\r\n    double *r = vec_create(n);\r\n    dm_matvec(A, x, r);\r\n    vec_axpy(-1.0, b, r, n);\r\n    printf(\"Residual norm: %.6e\\n\", vec_norm2(r, n));\r\n"]
[9702.781189, "o", "\r\n    free(r);\r\n    free(x);\r\n    free(b);\r\n    dm_destroy(A);\r\n    return 0;\r\n}\r\n\r\nstatic int parse_bc(const char *s, PoissonBC *bc)\r\n{\r\n    const char *colon = strchr(s, ':');\r\n    if (!colon || colon == s) return -1;\r\n\r\n    size_t len = colon - s;\r\n    char type[32];\r\n"]
[9702.781256, "o", "    if (len >= sizeof(type)) return -1;\r\n    memcpy(type, s, len);\r\n    type[len] = '\\0';\r\n\r\n    if (strcmp(type, \"dirichlet\") == 0) bc->type = POISSON_DIRICHLET;\r\n    else if (strcmp(type, \"neumann\") == 0) bc->type = POISSON_NEUMANN;\r\n    else return -1;\r\n\r\n    bc->file = colon + 1;\r\n    return 0;\r\n}\r\n\r\nstatic int run_solver_and_print(const CSRMatrix *A, const double *b,\r\n                                const char *solver, const char *precond,\r\n                                double tol, int maxiter, int restart,\r\n                                double omega, const char *output,\r\n"]
[9702.781313, "o", "                                const char *history)\r\n{\r\n    Precond *P = precond_create(A, precond, omega);\r\n    if (!P) {\r\n        fprintf(stderr, \"Error: cannot create preconditioner '%s'\\n\", precond);\r\n        return 1;\r\n    }\r\n\r\n    SolveResult *res = NULL;\r\n    if (strcmp(solver, \"cg\") == 0) {\r\n        res = cg_solve(A, b, NULL, tol, maxiter, P);\r\n"]
[9702.781375, "o", "    } else if (strcmp(solver, \"gmres\") == 0) {\r\n        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);\r\n    } else {\r\n        fprintf(stderr, \"Error: unknown solver '%s'\\n\", solver);\r\n        precond_destroy(P);\r\n        return 1;\r\n    }\r\n\r\n    if (!res) {\r\n        fprintf(stderr, \"Error: solver allocation failed\\n\");\r\n        precond_destroy(P);\r\n        return 1;\r\n    }\r\n"]
[9702.781432, "o", "\r\n    print_solve_summary(res);\r\n"]
[9702.781989, "o", "\u001b[?2004h"]
[9702.78205, "o", "root@n30009:/app# "]
[9703.067733, "i", "sed -n '180,360p' src/main.c\n"]
[9703.068043, "o", "sed -n '180,360p' src/main.c\r\n"]
[9703.068143, "o", "\u001b[?2004l\r"]
[9703.070963, "o", "    print_solve_summary(res);\r\n\r\n    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {\r\n        fprintf(stderr, \"Error: cannot write output to '%s'\\n\", output);\r\n    }\r\n    if (history && write_history_file(res, history) != 0) {\r\n        fprintf(stderr, \"Error: cannot write history to '%s'\\n\", history);\r\n    }\r\n\r\n"]
[9703.071065, "o", "    solve_result_destroy(res);\r\n    precond_destroy(P);\r\n    return 0;\r\n}\r\n\r\nstatic int cmd_sparse_solve(int argc, char **argv)\r\n{\r\n    const char *input = get_opt(argc, argv, \"--input\");\r\n    const char *rhs_file = get_opt(argc, argv, \"--rhs\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n    const char *history = get_opt(argc, argv, \"--history\");\r\n\r\n    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {\r\n        fprintf(stderr, \"Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n"]
[9703.07114, "o", "    }\r\n\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n"]
[9703.071207, "o", "\r\n    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid solver parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n    }\r\n\r\n    CSRMatrix *A = csr_read_mm(input);\r\n    if (!A) {\r\n        fprintf(stderr, \"Error: cannot read sparse matrix from '%s'\\n\", input);\r\n        return 1;\r\n    }\r\n\r\n    int n;\r\n    double *b = vec_read_mm_array(rhs_file, &n);\r\n    if (!b) {\r\n        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n        csr_destroy(A);\r\n        return 1;\r\n    }\r\n"]
[9703.071273, "o", "\r\n    if (A->rows != n || A->cols != n) {\r\n        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n                A->rows, A->cols, n);\r\n        free(b);\r\n        csr_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\r\n    free(b);\r\n    csr_destroy(A);\r\n    return rc;\r\n}\r\n\r\n"]
[9703.071341, "o", "static int cmd_poisson(int argc, char **argv)\r\n{\r\n    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n    const char *source = get_opt(argc, argv, \"--source\");\r\n    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n"]
[9703.071405, "o", "    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n    const char *history = get_opt(argc, argv, \"--history\");\r\n\r\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||\r\n"]
[9703.07147, "o", "        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n        !solver || !precond || !tol_s || !maxiter_s) {\r\n        fprintf(stderr, \"Error: poisson requires grid, source, boundary condition, solver, precond, tol, maxiter\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n\r\n    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n"]
[9703.071537, "o", "    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid poisson parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n"]
[9703.071608, "o", "        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    CSRMatrix *A = NULL;\r\n    double *b = NULL;\r\n    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {\r\n        fprintf(stderr, \"Error: cannot assemble Poisson system\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\r\n    free(b);\r\n"]
[9703.07167, "o", "    csr_destroy(A);\r\n    return rc;\r\n}\r\n\r\nstatic int cmd_heat(int argc, char **argv)\r\n{\r\n    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n"]
[9703.071735, "o", "    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n    const char *alpha_s = get_opt(argc, argv, \"--alpha\");\r\n    const char *dt_s = get_opt(argc, argv, \"--dt\");\r\n    const char *nsteps_s = get_opt(argc, argv, \"--nsteps\");\r\n    const char *scheme = get_opt(argc, argv, \"--scheme\");\r\n    const char *ic_file = get_opt(argc, argv, \"--ic\");\r\n    const char *source_arg = get_opt(argc, argv, \"--source\");\r\n    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");"]
[9703.071805, "o", "\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n\r\n"]
[9703.071865, "o", "    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !alpha_s ||\r\n        !dt_s || !nsteps_s || !scheme || !ic_file || !source_arg ||\r\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n        !solver || !precond || !tol_s || !maxiter_s || !output) {\r\n        fprintf(stderr, \"Error: heat requires grid, domain, alpha, dt, nsteps, scheme, ic, source, boundary conditions, solver, precond, tol, maxiter, output\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n\r\n    int nx = atoi(nx_s);\r\n"]
[9703.072386, "o", "\u001b[?2004h"]
[9703.072444, "o", "root@n30009:/app# "]
[9703.340597, "i", "sed -n '360,560p' src/main.c\n"]
[9703.340904, "o", "sed -n '360,560p' src/main.c\r\n\u001b[?2004l\r"]
[9703.343838, "o", "    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n    double alpha = atof(alpha_s);\r\n    double dt = atof(dt_s);\r\n"]
[9703.343943, "o", "    int nsteps = atoi(nsteps_s);\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || alpha <= 0.0 ||\r\n        dt <= 0.0 || nsteps < 0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid heat parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n        return 1;\r\n"]
[9703.344024, "o", "    }\r\n\r\n    int rc = heat_solve(nx, ny, x0, x1, y0, y1, alpha, dt, nsteps, scheme,\r\n                       ic_file, source_arg, left, right, bottom, top,\r\n                       solver, precond, tol, maxiter, restart, omega, output);\r\n    if (rc != 0) {\r\n        fprintf(stderr, \"Error: heat solve failed\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n"]
