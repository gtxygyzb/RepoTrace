[2309.035317, "o", "\r\nCSRMatrix *csr_create(int rows, int cols, int nnz)\r\n{\r\n    CSRMatrix *A = (CSRMatrix *)malloc(sizeof(CSRMatrix));\r\n    if (!A) return NULL;\r\n    A->rows = rows;\r\n    A->cols = cols;\r\n"]
[2309.035386, "o", "    A->nnz = nnz;\r\n    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));\r\n    A->col_indices = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    A->row_ptr = (int *)calloc((rows >= 0 ? rows + 1 : 1), sizeof(int));\r\n    if (!A->values || !A->col_indices || !A->row_ptr) {\r\n        csr_destroy(A);\r\n        return NULL;\r\n    }\r\n    return A;\r\n}\r\n\r\nvoid csr_destroy(CSRMatrix *A)\r\n{\r\n    if (!A) return;\r\n    free(A->values);\r\n    free(A->col_indices);\r\n    free(A->row_ptr);\r\n    free(A);\r\n}\r\n\r\nCOOMatrix *coo_create(int rows, int cols, int nnz)\r\n{\r\n    COOMatrix *A = (COOMatrix *)malloc(sizeof(COOMatrix));\r\n"]
[2309.035484, "o", "    if (!A) return NULL;\r\n    A->rows = rows;\r\n    A->cols = cols;\r\n    A->nnz = nnz;\r\n    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));\r\n    A->row = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    A->col = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    if (!A->values || !A->row || !A->col) {\r\n        coo_destroy(A);\r\n        return NULL;\r\n    }\r\n    return A;\r\n}\r\n\r\nvoid coo_destroy(COOMatrix *A)\r\n{\r\n    if (!A) return;\r\n    free(A->values);\r\n    free(A->row);\r\n    free(A->col);\r\n    free(A);\r\n}\r\n\r\nstatic const COOMatrix *g_coo_sort_data = NULL;\r\n\r\nstatic int coo_qsort_cmp(const void *pa, const void *pb)\r\n{\r\n    int ia = *(const int *)pa;\r\n    int ib = *(const int *)pb;\r\n    const COOMatrix *A = g_coo_sort_data;\r\n"]
[2309.035552, "o", "    if (A->row[ia] != A->row[ib]) return A->row[ia] - A->row[ib];\r\n    return A->col[ia] - A->col[ib];\r\n}\r\n\r\nstatic COOMatrix *coo_sort_dedup(const COOMatrix *A)\r\n{\r\n    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);\r\n    if (!out) return NULL;\r\n\r\n    int *idx = (int *)malloc((A->nnz > 0 ? A->nnz : 1) * sizeof(int));\r\n    if (!idx) { coo_destroy(out); return NULL; }\r\n    for (int i = 0; i < A->nnz; i++) idx[i] = i;\r\n"]
[2309.035619, "o", "\r\n    g_coo_sort_data = A;\r\n    qsort(idx, A->nnz, sizeof(int), coo_qsort_cmp);\r\n    g_coo_sort_data = NULL;\r\n\r\n    int k = 0;\r\n    for (int i = 0; i < A->nnz; i++) {\r\n        int src = idx[i];\r\n        if (k > 0 && out->row[k-1] == A->row[src] && out->col[k-1] == A->col[src]) {\r\n            out->values[k-1] += A->values[src];\r\n        } else {\r\n            out->row[k] = A->row[src];\r\n"]
[2309.03568, "o", "            out->col[k] = A->col[src];\r\n            out->values[k] = A->values[src];\r\n            k++;\r\n        }\r\n    }\r\n    out->nnz = k;\r\n    free(idx);\r\n    return out;\r\n}\r\n\r\nCOOMatrix *csr_to_coo(const CSRMatrix *A)\r\n{\r\n"]
[2309.035743, "o", "    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);\r\n    if (!out) return NULL;\r\n    int k = 0;\r\n    for (int i = 0; i < A->rows; i++) {\r\n        for (int j = A->row_ptr[i]; j < A->row_ptr[i+1]; j++) {\r\n            out->row[k] = i;\r\n            out->col[k] = A->col_indices[j];\r\n            out->values[k] = A->values[j];\r\n            k++;\r\n        }\r\n    }\r\n    out->nnz = k;\r\n"]
[2309.035806, "o", "    return out;\r\n}\r\n\r\nCSRMatrix *coo_to_csr(const COOMatrix *A)\r\n{\r\n    COOMatrix *sorted = coo_sort_dedup(A);\r\n    if (!sorted) return NULL;\r\n\r\n    CSRMatrix *out = csr_create(sorted->rows, sorted->cols, sorted->nnz);\r\n    if (!out) { coo_destroy(sorted); return NULL; }\r\n\r\n    for (int i = 0; i <= sorted->rows; i++) out->row_ptr[i] = 0;\r\n\r\n    for (int k = 0; k < sorted->nnz; k++) {\r\n"]
[2309.035865, "o", "        out->row_ptr[sorted->row[k] + 1]++;\r\n    }\r\n    for (int i = 0; i < sorted->rows; i++) {\r\n        out->row_ptr[i+1] += out->row_ptr[i];\r\n    }\r\n\r\n    int *next = (int *)malloc((sorted->rows > 0 ? sorted->rows : 1) * sizeof(int));\r\n    if (!next) { csr_destroy(out); coo_destroy(sorted); return NULL; }\r\n    for (int i = 0; i < sorted->rows; i++) next[i] = out->row_ptr[i];\r\n\r\n    for (int k = 0; k < sorted->nnz; k++) {\r\n        int r = sorted->row[k];\r\n        int pos = next[r]++;\r\n"]
[2309.035938, "o", "        out->col_indices[pos] = sorted->col[k];\r\n        out->values[pos] = sorted->values[k];\r\n    }\r\n\r\n    free(next);\r\n    coo_destroy(sorted);\r\n    return out;\r\n}\r\n\r\nvoid csr_spmv(const CSRMatrix *A, const double *x, double *y)\r\n{\r\n    for (int i = 0; i < A->rows; i++) {\r\n        double s = 0.0;\r\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n            s += A->values[k] * x[A->col_indices[k]];\r\n"]
[2309.035999, "o", "        }\r\n        y[i] = s;\r\n    }\r\n}\r\n\r\nstatic int csr_find_in_row(const CSRMatrix *A, int row, int col)\r\n{\r\n    int lo = A->row_ptr[row];\r\n    int hi = A->row_ptr[row+1] - 1;\r\n    while (lo <= hi) {\r\n        int mid = (lo + hi) / 2;\r\n        if (A->col_indices[mid] == col) return mid;\r\n        if (A->col_indices[mid] < col) lo = mid + 1;\r\n"]
[2309.03606, "o", "        else hi = mid - 1;\r\n    }\r\n    return -1;\r\n}\r\n\r\nCSRMatrix *csr_transpose(const CSRMatrix *A)\r\n{\r\n    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);\r\n    if (!T) return NULL;\r\n\r\n    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;\r\n    for (int k = 0; k < A->nnz; k++) {\r\n"]
