[12681.548089, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\n# Update eigen.h header\np = Path('include/eigen.h')\ns = p.read_text()\ns = s.replace('int cmd_eigenvalue(int argc, char **argv);\\n\\n#endif', 'int cmd_eigenvalue(int argc, char **argv);\\nint cmd_condition(int argc, char **argv);\\n\\n#endif')\np.write_text(s)\n\n# Update main.c: history writer and command dispatch\np = Path('src/main.c')\ns = p.read_text()\nold = '''    for (int i = 0; i < res->history_len; i++) {\n        fprintf(fp, \"%d\\\\t%.15e\\\\t%.15e\\\\n\", i, res->history[i], res->precond_history[i]);\n    }\n'''\nnew = '''    for (int i = 0; i < res->history_len; i++) {\n        double rate = NAN;\n        if (i > 0 && res->history[i-1] != 0.0) {\n            rate = res->history[i] / res->history[i-1];\n        }\n        fprintf(fp, \"%d\\\\t%.15e\\\\t%.15e\\\\t%.15e\\\\n\", i, res->history[i], res->precond_history[i], rate);\n    }\n'''\nif old not in s:\n    raise SystemExit('history writer block not found')\ns = s.replace(old, new)\nold = '''    } else if (strcmp(cmd, \"eigenvalue\") == 0) {\n   "]
[12681.54835, "i", "     return cmd_eigenvalue(argc - 2, argv + 2);\n    } else {\n'''\nnew = '''    } else if (strcmp(cmd, \"eigenvalue\") == 0) {\n        return cmd_eigenvalue(argc - 2, argv + 2);\n    } else if (strcmp(cmd, \"condition\") == 0) {\n        return cmd_condition(argc - 2, argv + 2);\n    } else {\n'''\nif old not in s:\n    raise SystemExit('dispatch block not found')\ns = s.replace(old, new)\np.write_text(s)\n\n# Add cmd_condition to eigen.c\np = Path('src/eigen.c')\ns = p.read_text()\ninsert = r'''\n\nint cmd_condition(int argc, char **argv)\n{\n    const char *input = get_opt(argc, argv, \"--input\");\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\n    const char *solver = get_opt(argc, argv, \"--solver\");\n    const char *precond = get_opt(argc, argv, \"--precond\");\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\n    const char *solver_tol_s = get_opt(argc, argv, \"--solver-tol\");\n    const char"]
