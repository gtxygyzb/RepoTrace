[2180.426366, "o", "\u001b[?2004l\r"]
[2180.429855, "o", "     1\t#ifndef VECTOR_H\r\n     2\t#define VECTOR_H\r\n     3\t\r\n     4\t#include <stdio.h>\r\n"]
[2180.429974, "o", "     5\t\r\n     6\t/* Allocate a zero-initialized vector of length n. Returns NULL on failure. */\r\n     7\tdouble *vec_create(int n);\r\n     8\t\r\n     9\t/* Deep copy: dst[i] = src[i] */\r\n    10\tvoid vec_copy(const double *src, double *dst, int n);\r\n    11\t\r\n    12\t/* Zero out: x[i] = 0 */\r\n    13\tvoid vec_zero(double *x, int n);\r\n    14\t\r\n    15\t/* Scale: x[i] *= a */\r\n    16\tvoid vec_scale(double a, double *x, int n);\r\n    17\t\r\n    18\t/* AXPY: y[i] += a * x[i] */\r\n    19\tvoid vec_axpy(double a, const double *x, double *y, int n);\r\n    20\t\r\n    21\t/* Dot product: sum(x[i] * y[i]) */\r\n    22"]
[2180.430047, "o", "\tdouble vec_dot(const double *x, const double *y, int n);\r\n    23\t\r\n    24\t/* L2 norm: sqrt(sum(x[i]^2)) */\r\n    25\tdouble vec_norm2(const double *x, int n);\r\n    26\t\r\n    27\t/* Print vector to stream, one value per line */\r\n    28\tvoid vec_print(const double *x, int n, FILE *out);\r\n    29\t\r\n    30\t#endif /* VECTOR_H */\r\n"]
