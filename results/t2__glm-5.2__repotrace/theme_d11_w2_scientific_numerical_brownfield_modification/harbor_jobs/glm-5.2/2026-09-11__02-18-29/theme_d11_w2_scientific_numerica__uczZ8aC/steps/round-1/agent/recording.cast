[4142.196336, "o", "static const char *get_opt(int argc, char **argv, const char *name)\r\n\u001b[?2004l\r"]
[4142.196393, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[4142.196449, "o", "\u001b[?2004h> "]
[4142.196669, "o", "    for (int i = 0; i < argc - 1; i++) {\r\n\u001b[?2004l\r"]
[4142.196724, "o", "\u001b[?2004h> "]
[4142.19706, "o", "        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n\u001b[?2004l\r"]
[4142.197119, "o", "\u001b[?2004h>     }\r\n"]
[4142.197176, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4142.197273, "o", "    return NULL;\r\n\u001b[?2004l\r"]
[4142.19733, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4142.197386, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h"]
[4142.197441, "o", "> "]
