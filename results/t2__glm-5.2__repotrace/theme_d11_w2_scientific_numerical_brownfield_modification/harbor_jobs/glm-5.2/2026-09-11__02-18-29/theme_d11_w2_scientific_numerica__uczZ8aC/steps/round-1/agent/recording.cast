[2139.524524, "i", "sed -n '1,240p' include/solvers.h\n"]
[2139.524821, "o", "sed -n '1,240p' include/solvers.h\r\n"]
[2139.524954, "o", "\u001b[?2004l\r"]
[2139.527838, "o", "#ifndef SOLVERS_H\r\n#define SOLVERS_H\r\n\r\n#include \"sparse.h\"\r\n#include \"precond.h\"\r\n\r\n"]
[2139.527943, "o", "typedef struct {\r\n    double *x;\r\n    double relres;\r\n    int iterations;\r\n    int converged;\r\n    double *history;\r\n    int history_len;\r\n} SolveResult;\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P);\r\n"]
[2139.528033, "o", "\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                         double tol, int maxiter, int m, Precond *P);\r\n\r\nvoid solve_result_destroy(SolveResult *res);\r\n\r\n#endif /* SOLVERS_H */\r\n"]
[2139.528421, "o", "\u001b[?2004h"]
[2139.528487, "o", "root@n30009:/app# "]
[2139.802753, "i", "sed -n '1,260p' src/solvers.c\n"]
[2139.803045, "o", "sed -n '1,260p' src/solvers.c\r\n\u001b[?2004l\r"]
[2139.805851, "o", "#include \"solvers.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <math.h>\r\n#include <string.h>\r\n\r\nstatic SolveResult *result_create(int n, int maxiter)\r\n"]
[2139.805949, "o", "{\r\n    if (maxiter < 0) maxiter = 0;\r\n    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    if (!res) return NULL;\r\n\r\n    res->x = vec_create(n);\r\n    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    if (!res->x || !res->history) {\r\n        free(res->x);\r\n        free(res->history);\r\n        free(res);\r\n        return NULL;\r\n    }\r\n    res->history_len = 0;\r\n    return res;\r\n}\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n"]
[2139.806036, "o", "                      double tol, int maxiter, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n"]
[2139.806113, "o", "\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *p = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    if (!r || !z || !p || !Ap) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;"]
[2139.806189, "o", "\r\n\r\n    res->relres = vec_norm2(r, n) / bnorm;\r\n    res->history[0] = res->relres;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n\r\n    if (precond_apply(P, A, r, z) != 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n    vec_copy(z, p, n);\r\n    double rz_old = vec_dot(r, z, n);\r\n\r\n"]
[2139.806262, "o", "    for (int iter = 1; iter <= maxiter; iter++) {\r\n        csr_spmv(A, p, Ap);\r\n        double pAp = vec_dot(p, Ap, n);\r\n        if (fabs(pAp) < 1e-30) break;\r\n\r\n        double alpha = rz_old / pAp;\r\n        vec_axpy(alpha, p, res->x, n);\r\n        vec_axpy(-alpha, Ap, r, n);\r\n\r\n        res->relres = vec_norm2(r, n) / bnorm;\r\n        res->history[iter] = res->relres;\r\n        res->history_len = iter + 1;\r\n        res->iterations = iter;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double rz_new = vec_dot(r, z, n);\r\n        if (fabs(rz_old) < 1e-30) break;\r\n        double beta = rz_new / rz_old;\r\n"]
[2139.806338, "o", "        vec_scale(beta, p, n);\r\n        vec_axpy(1.0, z, p, n);\r\n        rz_old = rz_new;\r\n    }\r\n\r\n    free(r); free(z); free(p); free(Ap);\r\n    return res;\r\n}\r\n\r\nstatic void apply_givens(double *a, double *b, double c, double s)\r\n{\r\n    double t = c * (*a) + s * (*b);\r\n    *b = -s * (*a) + c * (*b);\r\n    *a = t;\r\n}\r\n\r\n"]
[2139.806409, "o", "static int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n{\r\n    if (kdim <= 0) return -1;\r\n\r\n    double *c = (double *)malloc(m * sizeof(double));\r\n    double *s = (double *)malloc(m * sizeof(double));\r\n    if (!c || !s) { free(c); free(s); return -1; }\r\n\r\n    for (int i = 0; i < kdim; i++) {\r\n        for (int k = 0; k < i; k++) {\r\n            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n        }\r\n\r\n        double a = H[i*m+i];\r\n        double b = H[(i+1)*m+i];\r\n        if (b == 0.0) {\r\n"]
[2139.806479, "o", "            c[i] = 1.0;\r\n            s[i] = 0.0;\r\n        } else {\r\n            double r = hypot(a, b);\r\n            c[i] = a / r;\r\n            s[i] = b / r;\r\n        }\r\n        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n\r\n    }\r\n\r\n    for (int i = kdim - 1; i >= 0; i--) {\r\n        double sum = g[i];\r\n        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n"]
[2139.806594, "o", "        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n        y[i] = sum / H[i*m+i];\r\n    }\r\n\r\n    free(c);\r\n    free(s);\r\n    return 0;\r\n}\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                         double tol, int maxiter, int m, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (m <= 0) m = 30;\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    double *Av = vec_create(n);\r\n    double *w = vec_create(n);\r\n"]
[2139.806667, "o", "    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n    double *y = (double *)malloc(m * sizeof(double));\r\n    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n\r\n    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n"]
[2139.806738, "o", "    if (bnorm == 0.0) bnorm = 1.0;\r\n\r\n    res->relres = vec_norm2(r, n) / bnorm;\r\n    res->history[0] = res->relres;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        return res;\r\n    }\r\n\r\n    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n"]
[2139.806814, "o", "        if (precond_apply(P, A, r, z) != 0) break;\r\n        double beta = vec_norm2(z, n);\r\n        if (beta == 0.0) break;\r\n\r\n        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n        g[0] = beta;\r\n        memset(H, 0, (m + 1) * m * sizeof(double));\r\n\r\n        int kdim = 0;\r\n        int fail = 0;\r\n"]
[2139.806893, "o", "        for (int j = 0; j < m; j++) {\r\n            csr_spmv(A, V + j * n, Av);\r\n            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n\r\n            for (int i = 0; i <= j; i++) {\r\n                double h = vec_dot(w, V + i * n, n);\r\n                H[i*m+j] = h;\r\n                vec_axpy(-h, V + i * n, w, n);\r\n            }\r\n\r\n            double hnorm = vec_norm2(w, n);\r\n            H[(j+1)*m+j] = hnorm;\r\n            kdim = j + 1;\r\n\r\n            if (hnorm < 1e-14) break;\r\n\r\n            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n        }\r\n        if (fail) break;\r\n        if (kdim == 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n"]
[2139.806962, "o", "        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->relres = vec_norm2(r, n) / bnorm;\r\n        res->history[cycle] = res->relres;\r\n        res->history_len = cycle + 1;\r\n        res->iterations = cycle;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n"]
[2139.80703, "o", "        }\r\n    }\r\n\r\n    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n    return res;\r\n}\r\n\r\nvoid solve_result_destroy(SolveResult *res)\r\n{\r\n    if (!res) return;\r\n    free(res->x);\r\n    free(res->history);\r\n    free(res);\r\n}\r\n"]
[2139.807515, "o", "\u001b[?2004h"]
[2139.807588, "o", "root@n30009:/app# "]
[2140.072631, "i", "sed -n '1,260p' include/poisson.h\n"]
[2140.072952, "o", "sed -n '1,260p' include/poisson.h\r\n\u001b[?2004l\r"]
[2140.075856, "o", "#ifndef POISSON_H\r\n#define POISSON_H\r\n\r\n#include \"sparse.h\"\r\n\r\ntypedef enum {\r\n    POISSON_DIRICHLET,\r\n    POISSON_NEUMANN\r\n"]
[2140.075973, "o", "} PoissonBCType;\r\n\r\ntypedef struct {\r\n    PoissonBCType type;\r\n    const char *file;\r\n} PoissonBC;\r\n\r\nint poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n                    const char *source_file, PoissonBC left, PoissonBC right,\r\n                    PoissonBC bottom, PoissonBC top,\r\n                    CSRMatrix **A_out, double **b_out);\r\n\r\ndouble *poisson_read_source(const char *filename, int nx, int ny);\r\ndouble *poisson_read_boundary(const char *filename, int expected);\r\n\r\n#endif /* POISSON_H */\r\n"]
[2140.076447, "o", "\u001b[?2004h"]
[2140.07655, "o", "root@n30009:/app# "]
[2140.333112, "i", "sed -n '1,320p' src/poisson.c\n"]
[2140.333372, "o", "sed -n '1,320p' src/poisson.c\r\n\u001b[?2004l\r"]
[2140.336298, "o", "#include \"poisson.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n\r\ndouble *poisson_read_source(const char *filename, int nx, int ny)\r\n{\r\n"]
[2140.336395, "o", "    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    int rx, ry;\r\n    if (fscanf(fp, \"%d %d\", &rx, &ry) != 2 || rx != nx || ry != ny) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    int n = nx * ny;\r\n"]
[2140.33647, "o", "    double *f = vec_create(n);\r\n    if (!f) { fclose(fp); return NULL; }\r\n\r\n    for (int i = 0; i < n; i++) {\r\n        if (fscanf(fp, \"%lf\", &f[i]) != 1) {\r\n            free(f);\r\n            fclose(fp);\r\n            return NULL;\r\n        }\r\n    }\r\n\r\n    fclose(fp);\r\n    return f;\r\n}\r\n\r\ndouble *poisson_read_boundary(const char *filename, int expected)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    double *vals = (double *)malloc(expected * sizeof(double));\r\n    if (!vals) { fclose(fp); return NULL; }\r\n\r\n    int count = 0;\r\n    while (count < expected) {\r\n        double v;\r\n"]
[2140.336546, "o", "        if (fscanf(fp, \"%lf\", &v) != 1) break;\r\n        vals[count++] = v;\r\n    }\r\n\r\n    fclose(fp);\r\n    if (count != expected) { free(vals); return NULL; }\r\n    return vals;\r\n}\r\n"]
[2140.336617, "o", "\r\nstatic void add_coo(COOMatrix *coo, int *k, int r, int c, double v)\r\n{\r\n    coo->row[*k] = r;\r\n    coo->col[*k] = c;\r\n    coo->values[*k] = v;\r\n    (*k)++;\r\n}\r\n\r\nint poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n                    const char *source_file, PoissonBC left, PoissonBC right,\r\n                    PoissonBC bottom, PoissonBC top,\r\n                    CSRMatrix **A_out, double **b_out)\r\n{\r\n    if (!A_out || !b_out) return -1;\r\n    *A_out = NULL;\r\n    *b_out = NULL;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || !source_file) return -1;\r\n\r\n    double hx = (x1 - x0) / (nx - 1);\r\n    double hy = (y1 - y0) / (ny - 1);\r\n    double hx2 = hx * hx;\r\n"]
[2140.336689, "o", "    double hy2 = hy * hy;\r\n\r\n    double *f = poisson_read_source(source_file, nx, ny);\r\n    if (!f) return -1;\r\n\r\n    double *left_vals = NULL;\r\n    double *right_vals = NULL;\r\n    double *bottom_vals = NULL;\r\n    double *top_vals = NULL;\r\n\r\n    if (left.type == POISSON_NEUMANN) { left_vals = poisson_read_boundary(left.file, ny); if (!left_vals) goto fail; }\r\n    if (right.type == POISSON_NEUMANN) { right_vals = poisson_read_boundary(right.file, ny); if (!right_vals) goto fail; }\r\n    if (bottom.type == POISSON_NEUMANN) { bottom_vals = poisson_read_boundary(bottom.file, nx); if (!bottom_vals) goto fail; }\r\n    if (top.type == POISSON_NEUMANN) { top_vals = poisson_read_boundary(top.file, nx); if (!top_vals) goto fail; }\r\n"]
[2140.336762, "o", "\r\n    if (left.type == POISSON_DIRICHLET) { left_vals = poisson_read_boundary(left.file, ny); if (!left_vals) goto fail; }\r\n    if (right.type == POISSON_DIRICHLET) { right_vals = poisson_read_boundary(right.file, ny); if (!right_vals) goto fail; }\r\n    if (bottom.type == POISSON_DIRICHLET) { bottom_vals = poisson_read_boundary(bottom.file, nx); if (!bottom_vals) goto fail; }\r\n    if (top.type == POISSON_DIRICHLET) { top_vals = poisson_read_boundary(top.file, nx); if (!top_vals) goto fail; }\r\n\r\n    int n = nx * ny;\r\n    COOMatrix *coo = coo_create(n, n, 5 * n);\r\n    double *b = vec_create(n);\r\n    if (!coo || !b) { coo_destroy(coo); free(b); goto fail; }\r\n\r\n    int k = 0;\r\n"]
[2140.336833, "o", "    for (int i = 0; i < nx; i++) {\r\n        for (int j = 0; j < ny; j++) {\r\n            int idx = i * ny + j;\r\n            int is_left = (i == 0);\r\n            int is_right = (i == nx - 1);\r\n            int is_bottom = (j == 0);\r\n            int is_top = (j == ny - 1);\r\n\r\n            if (is_left && left.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = left_vals[j];\r\n                continue;\r\n            }\r\n            if (is_right && right.type == POISSON_DIRICHLET) {\r\n"]
[2140.336903, "o", "                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = right_vals[j];\r\n                continue;\r\n            }\r\n            if (is_bottom && bottom.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = bottom_vals[i];\r\n                continue;\r\n"]
[2140.337034, "o", "            }\r\n            if (is_top && top.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = top_vals[i];\r\n                continue;\r\n            }\r\n\r\n            double diag = 0.0;\r\n            double rhs = f[idx];\r\n            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;\r\n\r\n            if (is_left && left.type == POISSON_NEUMANN) {\r\n                diag += 2.0 / hx2;\r\n                c_ip = -2.0 / hx2;\r\n                rhs += 2.0 * left_vals[j] / hx;\r\n            } else if (is_right && right.type == POISSON_NEUMANN) {\r\n                diag += 2.0 / hx2;\r\n                c_im = -2.0 / hx2;\r\n                rhs += 2.0 * right_vals[j] / hx;\r\n            } else if (!is_left && !is_right) {\r\n                diag += 2.0 / hx2;\r\n                c_im = -1.0 / hx2;\r\n                c_ip = -1.0 / hx2;\r\n            }\r\n\r\n            if (is_bottom && bottom.type == POISSON_NEUMANN) {\r\n"]
[2140.337132, "o", "                diag += 2.0 / hy2;\r\n                c_jp = -2.0 / hy2;\r\n                rhs += 2.0 * bottom_vals[i] / hy;\r\n            } else if (is_top && top.type == POISSON_NEUMANN) {\r\n                diag += 2.0 / hy2;\r\n                c_jm = -2.0 / hy2;\r\n                rhs += 2.0 * top_vals[i] / hy;\r\n            } else if (!is_bottom && !is_top) {\r\n                diag += 2.0 / hy2;\r\n                c_jm = -1.0 / hy2;\r\n                c_jp = -1.0 / hy2;\r\n            }\r\n\r\n            add_coo(coo, &k, idx, idx, diag);\r\n            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);\r\n            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);\r\n            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);\r\n"]
[2140.337204, "o", "            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);\r\n            b[idx] = rhs;\r\n        }\r\n    }\r\n\r\n    coo->nnz = k;\r\n    CSRMatrix *A = coo_to_csr(coo);\r\n    coo_destroy(coo);\r\n    if (!A) { free(b); goto fail; }\r\n\r\n    free(f);\r\n    free(left_vals);\r\n    free(right_vals);\r\n    free(bottom_vals);\r\n    free(top_vals);\r\n\r\n"]
[2140.337271, "o", "    *A_out = A;\r\n    *b_out = b;\r\n    return 0;\r\n\r\nfail:\r\n    free(f);\r\n    free(left_vals);\r\n    free(right_vals);\r\n    free(bottom_vals);\r\n    free(top_vals);\r\n    return -1;\r\n}\r\n"]
