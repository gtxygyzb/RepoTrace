[1145.613681, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.613737, "o", "> "]
[1145.613964, "o", "    DenseMatrix *A = dm_read_text(mat_file);\r\n\u001b[?2004l\r"]
[1145.614021, "o", "\u001b[?2004h> "]
[1145.614082, "o", "    if (!A) {\r\n\u001b[?2004l\r"]
[1145.614138, "o", "\u001b[?2004h> "]
