[12500.468409, "o", "\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K729\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else if (strcmp(cmd, \"\u001b[01;31m\u001b[Kmatvec\u001b[m\u001b[K\") == 0) {\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K730\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        return \u001b[01;31m\u001b[Kcmd_\u001b[m\u001b[K\u001b[01;31m\u001b[Kmatvec\u001b[m\u001b[K(argc - 2, argv + 2);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K732\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        return \u001b[01;31m\u001b[Kcmd_\u001b[m\u001b[Kmatinfo(argc - 2, argv + 2);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K733\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else if (strcmp(cmd, \"\u001b[01;31m\u001b[Keigenvalue\u001b[m\u001b[K\") == 0) {\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K734\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        return \u001b[01;31m\u001b[Kcmd_\u001b[m\u001b[K\u001b[01;31m\u001b[Keigenvalue\u001b[m\u001b[K(argc - 2, argv + 2);\r\n"]
[12500.468568, "o", "grep: include/main.h: No such file or directory\r\n"]
[12500.46897, "o", "\u001b[?2004h"]
[12500.469, "o", "root@n30009:/app# "]
[12500.73942, "i", "sed -n '1,120p' include/solvers.h\n"]
[12500.739712, "o", "sed -n '1,120p' include/solvers.h\r\n"]
[12500.739802, "o", "\u001b[?2004l\r"]
[12500.7426, "o", "#ifndef SOLVERS_H\r\n#define SOLVERS_H\r\n\r\n#include \"sparse.h\"\r\n#include \"precond.h\"\r\n\r\ntypedef struct {\r\n    double *x;\r\n"]
[12500.74268, "o", "    double relres;          /* true relative residual ||b-A*x||/||b|| */\r\n    double true_residual;   /* absolute true residual norm ||b-A*x|| */\r\n    double relres_inf;      /* reported relative residual ||b-A*x||_inf / ||b||_inf */\r\n    double true_residual_inf; /* reported absolute residual ||b-A*x||_inf */\r\n    int iterations;\r\n    int converged;\r\n    double *history;        /* true relative residual at each iteration */\r\n    double *precond_history; /* preconditioned residual norm ||M^-1 r|| at each iteration */\r\n    int history_len;        /* number of stored history entries */\r\n} SolveResult;\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P);\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n"]
[12500.742755, "o", "                           double tol, int maxiter, int m, Precond *P);\r\n\r\nvoid solve_result_destroy(SolveResult *res);\r\n\r\n#endif /* SOLVERS_H */\r\n"]
[12500.7432, "o", "\u001b[?2004h"]
[12500.74326, "o", "root@n30009:/app# "]
[12501.013985, "i", "sed -n '1,120p' src/solvers.c\n"]
[12501.014252, "o", "sed -n '1,120p' src/solvers.c\r\n\u001b[?2004l\r"]
[12501.017096, "o", "#include \"solvers.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <math.h>\r\n#include <string.h>\r\n\r\nstatic SolveResult *result_create(int n, int maxiter)\r\n"]
[12501.017193, "o", "{\r\n    if (maxiter < 0) maxiter = 0;\r\n    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    if (!res) return NULL;\r\n\r\n    res->x = vec_create(n);\r\n    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    res->precond_history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    if (!res->x || !res->history || !res->precond_history) {\r\n        free(res->x);\r\n        free(res->history);\r\n        free(res->precond_history);\r\n        free(res);\r\n        return NULL;\r\n    }\r\n    res->history_len = 0;\r\n    return res;\r\n}\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P)\r\n"]
[12501.017286, "o", "{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *p = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    if (!r || !z || !p || !Ap) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n"]
[12501.017361, "o", "    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n    double bnorm_inf = vec_norm_inf(b, n);\r\n    if (bnorm_inf == 0.0) bnorm_inf = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n"]
[12501.017421, "o", "    res->true_residual_inf = vec_norm_inf(r, n);\r\n    res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n    precond_apply(P, A, r, z);\r\n    double pnorm0 = vec_norm2(z, n);\r\n    res->history[0] = res->relres;\r\n    res->precond_history[0] = pnorm0;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n\r\n    if (precond_apply(P, A, r, z) != 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n    vec_copy(z, p, n);\r\n"]
[12501.017485, "o", "    double rz_old = vec_dot(r, z, n);\r\n\r\n    for (int iter = 1; iter <= maxiter; iter++) {\r\n        csr_spmv(A, p, Ap);\r\n        double pAp = vec_dot(p, Ap, n);\r\n        if (fabs(pAp) < 1e-30) break;\r\n\r\n        double alpha = rz_old / pAp;\r\n        vec_axpy(alpha, p, res->x, n);\r\n        vec_axpy(-alpha, Ap, r, n);\r\n\r\n        /* Recompute the true residual rather than relying on the recurrence. */\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n"]
[12501.017545, "o", "\r\n        res->true_residual = vec_norm2(r, n);\r\n        res->relres = res->true_residual / bnorm;\r\n        res->true_residual_inf = vec_norm_inf(r, n);\r\n        res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n        precond_apply(P, A, r, z);\r\n        double pznorm = vec_norm2(z, n);\r\n        res->history[iter] = res->relres;\r\n        res->precond_history[iter] = pznorm;\r\n        res->history_len = iter + 1;\r\n        res->iterations = iter;\r\n\r\n        if (res->relres < tol) {\r\n"]
[12501.017605, "o", "            res->converged = 1;\r\n            break;\r\n        }\r\n\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double rz_new = vec_dot(r, z, n);\r\n        if (fabs(rz_old) < 1e-30) break;\r\n        double beta = rz_new / rz_old;\r\n        vec_scale(beta, p, n);\r\n        vec_axpy(1.0, z, p, n);\r\n        rz_old = rz_new;\r\n    }\r\n"]
[12501.017661, "o", "\r\n    free(r); free(z); free(p); free(Ap);\r\n    return res;\r\n}\r\n"]
[12501.018166, "o", "\u001b[?2004h"]
[12501.018225, "o", "root@n30009:/app# "]
[12501.282159, "i", "sed -n '120,340p' src/solvers.c\n"]
[12501.282437, "o", "sed -n '120,340p' src/solvers.c\r\n\u001b[?2004l\r"]
[12501.28555, "o", "}\r\n\r\nstatic void apply_givens(double *a, double *b, double c, double s)\r\n{\r\n    double t = c * (*a) + s * (*b);\r\n    *b = -s * (*a) + c * (*b);\r\n    *a = t;\r\n}\r\n\r\nstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n{\r\n    if (kdim <= 0) return -1;\r\n"]
[12501.285702, "o", "\r\n    double *c = (double *)malloc(m * sizeof(double));\r\n    double *s = (double *)malloc(m * sizeof(double));\r\n    if (!c || !s) { free(c); free(s); return -1; }\r\n\r\n    for (int i = 0; i < kdim; i++) {\r\n        for (int k = 0; k < i; k++) {\r\n            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n        }\r\n\r\n        double a = H[i*m+i];\r\n        double b = H[(i+1)*m+i];\r\n        if (b == 0.0) {\r\n            c[i] = 1.0;\r\n            s[i] = 0.0;\r\n        } else {\r\n            double r = hypot(a, b);\r\n            c[i] = a / r;\r\n            s[i] = b / r;\r\n        }\r\n        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n\r\n    }\r\n\r\n    for (int i = kdim - 1; i >= 0; i--) {\r\n        double sum = g[i];\r\n        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n        y[i] = sum / H[i*m+i];\r\n    }\r\n\r\n"]
[12501.28578, "o", "    free(c);\r\n    free(s);\r\n    return 0;\r\n}\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                           double tol, int maxiter, int m, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (m <= 0) m = 30;\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n"]
[12501.285848, "o", "    double *Ap = vec_create(n);\r\n    double *Av = vec_create(n);\r\n    double *w = vec_create(n);\r\n    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n    double *y = (double *)malloc(m * sizeof(double));\r\n    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n\r\n    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n"]
[12501.285943, "o", "    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n    double bnorm_inf = vec_norm_inf(b, n);\r\n    if (bnorm_inf == 0.0) bnorm_inf = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    res->true_residual_inf = vec_norm_inf(r, n);\r\n    res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n    precond_apply(P, A, r, z);\r\n    double pnorm0 = vec_norm2(z, n);\r\n"]
[12501.286012, "o", "    res->history[0] = res->relres;\r\n    res->precond_history[0] = pnorm0;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        return res;\r\n    }\r\n"]
[12501.286081, "o", "\r\n    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double beta = vec_norm2(z, n);\r\n        if (beta == 0.0) break;\r\n\r\n        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n        g[0] = beta;\r\n        memset(H, 0, (m + 1) * m * sizeof(double));\r\n\r\n        int kdim = 0;\r\n        int fail = 0;\r\n        for (int j = 0; j < m; j++) {\r\n            csr_spmv(A, V + j * n, Av);\r\n            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n\r\n            for (int i = 0; i <= j; i++) {\r\n"]
[12501.28614, "o", "                double h = vec_dot(w, V + i * n, n);\r\n                H[i*m+j] = h;\r\n                vec_axpy(-h, V + i * n, w, n);\r\n            }\r\n\r\n            double hnorm = vec_norm2(w, n);\r\n            H[(j+1)*m+j] = hnorm;\r\n            kdim = j + 1;\r\n\r\n            if (hnorm < 1e-14) break;\r\n\r\n            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n        }\r\n        if (fail) break;\r\n"]
[12501.286201, "o", "        if (kdim == 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n        res->relres = res->true_residual / bnorm;\r\n        res->true_residual_inf = vec_norm_inf(r, n);\r\n"]
[12501.28626, "o", "        res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n        precond_apply(P, A, r, z);\r\n        double pznorm = vec_norm2(z, n);\r\n        res->history[cycle] = res->relres;\r\n        res->precond_history[cycle] = pznorm;\r\n        res->history_len = cycle + 1;\r\n        res->iterations = cycle;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n    }\r\n"]
[12501.286327, "o", "\r\n    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n    return res;\r\n}\r\n\r\nvoid solve_result_destroy(SolveResult *res)\r\n{"]
[12501.286388, "o", "\r\n    if (!res) return;\r\n    free(res->x);\r\n    free(res->history);\r\n    free(res->precond_history);\r\n    free(res);\r\n}\r\n"]
[12501.286834, "o", "\u001b[?2004h"]
[12501.286925, "o", "root@n30009:/app# "]
[12508.560399, "i", "nl -ba include/solvers.h | sed -n '1,120p'\n"]
[12508.560743, "o", "nl -ba include/solvers.h | sed -n '1,120p'\r\n"]
[12508.560824, "o", "\u001b[?2004l\r"]
[12508.563933, "o", "     1\t#ifndef SOLVERS_H\r\n     2\t#define SOLVERS_H\r\n     3\t\r\n     4\t#include \"sparse.h\"\r\n     5\t#include \"precond.h\"\r\n     6\t\r\n"]
[12508.56397, "o", "     7\ttypedef struct {\r\n     8\t    double *x;\r\n     9\t    double relres;          /* true relative residual ||b-A*x||/||b|| */\r\n    10\t    double true_residual;   /* absolute true residual norm ||b-A*x|| */\r\n    11\t    double relres_inf;      /* reported relative residual ||b-A*x||_inf / ||b||_inf */\r\n    12\t    double true_residual_inf; /* reported absolute residual ||b-A*x||_inf */\r\n    13\t    int iterations;\r\n"]
[12508.564291, "o", "    14\t    int converged;\r\n    15\t    double *history;        /* true relative residual at each iteration */\r\n    16\t    double *precond_history; /* preconditioned residual norm ||M^-1 r|| at each iteration */\r\n    17\t    int history_len;        /* number of stored history entries */\r\n    18\t} SolveResult;\r\n    19\t\r\n    20\tSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n    21\t                      double tol, int maxiter, Precond *P);\r\n    22\t\r\n    23\tSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n    24\t                           double tol, int maxiter, int m, Precond *P);\r\n    25\t\r\n    26\tvoid solve_result_destroy(SolveResult *res);\r\n    27\t\r\n    28\t#endif /* SOLVERS_H */\r\n"]
