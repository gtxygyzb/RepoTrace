[11075.180387, "o", "ue> --maxiter <int> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> [--restart <m>] [--ssor-omega <value>] [--solver-tol <value>] [--solver-maxiter <int>] [--eigvec-output <file>]\\n\", prog);\r\n    26\t}\r\n    27\t\r\n    28\tstatic const char *get_opt(int argc, char **argv, const char *name)\r\n    29\t{\r\n    30\t    for (int i = 0; i < argc - 1; i++) {\r\n    31\t        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    32\t    }\r\n    33\t    return NULL;\r\n    34\t}\r\n    35\t\r\n    36\tstatic int write_history_file(const SolveResult *res, const char *filename)\r\n    37\t{\r\n    38\t    FILE *fp = fopen(filename, \"w\");\r\n    39\t    if (!fp) return -1;\r\n    40\t    for (int i = 0; i < res->history_len; i++) {\r\n    41\t        fprintf(fp, \"%d\\t%.15e\\t%.15e\\n\", i, res->history[i], res->precond_history[i]);\r\n    42\t    }\r\n    43"]
