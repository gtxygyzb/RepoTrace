[11050.901909, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n#include \"dense.h\"\r\n#include \"vector.h\"\r\n#include \"io.h\"\r\n#include \"sparse.h\"\r\n"]
[11050.902008, "o", "#include \"precond.h\"\r\n#include \"solvers.h\"\r\n#include \"poisson.h\"\r\n#include \"heat.h\"\r\n#include \"convdiff.h\"\r\n#include \"eigen.h\"\r\n\r\nstatic void usage(const char *prog)\r\n{\r\n    fprintf(stderr, \"Usage:\\n\");\r\n    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\n\", prog);\r\n    fprintf(stderr, \"  %s matinfo --input <mtx_file>\\n\", prog);\r\n    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] "]
[11050.902082, "o", "[--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s heat --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --alpha <float> --dt <float> --nsteps <int> --scheme <backward-euler|crank-nicolson> --ic <file> --source <file>[,<file>,...] --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file>\\n\", prog);\r\n    fprintf(stderr, \"  %s convdiff --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --kappa <float> --vx <float> --vy <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file> ["]
[11050.902153, "o", "--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s eigenvalue --input <mtx_file> --method <power|inverse|shifted-inverse> [--shift <sigma>] --tol <value> --maxiter <int> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> [--restart <m>] [--ssor-omega <value>] [--solver-tol <value>] [--solver-maxiter <int>] [--eigvec-output <file>]\\n\", prog);\r\n}\r\n\r\nstatic const char *get_opt(int argc, char **argv, const char *name)\r\n{\r\n    for (int i = 0; i < argc - 1; i++) {\r\n        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    }\r\n    return NULL;\r\n}\r\n\r\nstatic int write_history_file(const SolveResult *res, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    for (int i = 0; i < res->history_len; i++) {\r\n        fprintf(fp, \"%d\\t%.15e\\t%.15e\\n\", i, res->history[i], res->precond_history[i]);\r\n    }\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n\r\nstatic void print_solve_summary(const SolveResult *res)\r\n{\r\n    printf(\"converged: %s\\n\", res->converged ? \"yes\" : \"no\");\r\n    printf(\"it"]
[11050.902216, "o", "erations: %d\\n\", res->iterations);\r\n    printf(\"residual: %.6e\\n\", res->relres);\r\n    printf(\"true_residual: %.6e\\n\", res->true_residual);\r\n}\r\n\r\nstatic int validate_ssor_omega(double omega)\r\n{\r\n    if (!(omega > 0.0 && omega < 2.0)) {\r\n        fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n"]
[11050.902277, "o", "\r\nstatic int cmd_dense_solve(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"Error: dense-solve requires <matrix_file> <rhs_file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    const char *mat_file = argv[0];\r\n    const char *rhs_file = argv[1];\r\n    const char *out_file = (argc >= 3) ? argv[2] : NULL;\r\n"]
[11050.902339, "o", "\r\n    DenseMatrix *A = dm_read_text(mat_file);\r\n    if (!A) {\r\n        fprintf(stderr, \"Error: cannot read matrix from '%s'\\n\", mat_file);\r\n        return 1;\r\n    }\r\n\r\n    int n;\r\n    double *b = vec_read_text(rhs_file, &n);\r\n    if (!b) {\r\n        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n"]
[11050.902403, "o", "\r\n    if (A->rows != n || A->cols != n) {\r\n        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n                A->rows, A->cols, n);\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    double *x = vec_create(n);\r\n    if (!x) {\r\n"]
[11050.902463, "o", "        fprintf(stderr, \"Error: allocation failed\\n\");\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    int rc = dm_solve(A, b, x);\r\n    if (rc != 0) {\r\n        fprintf(stderr, \"Error: solver failed (singular or ill-conditioned)\\n\");\r\n        free(x);\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (out_file) {\r\n"]
[11050.902523, "o", "        vec_write_text(x, n, out_file);\r\n        printf(\"Solution written to %s\\n\", out_file);\r\n    } else {\r\n        printf(\"Solution:\\n\");\r\n        vec_print(x, n, stdout);\r\n    }\r\n\r\n    double *r = vec_create(n);\r\n    dm_matvec(A, x, r);\r\n    vec_axpy(-1.0, b, r, n);\r\n    printf(\"Residual norm: %.6e\\n\", vec_norm2(r, n));\r\n\r\n    free(r);\r\n"]
[11050.90258, "o", "    free(x);\r\n    free(b);\r\n    dm_destroy(A);\r\n    return 0;\r\n}\r\n\r\nstatic int parse_bc(const char *s, PoissonBC *bc)\r\n{\r\n    const char *colon = strchr(s, ':');\r\n    if (!colon || colon == s) return -1;\r\n"]
[11050.902645, "o", "\r\n    size_t len = colon - s;\r\n    char type[32];\r\n    if (len >= sizeof(type)) return -1;\r\n    memcpy(type, s, len);\r\n    type[len] = '\\0';\r\n\r\n    if (strcmp(type, \"dirichlet\") == 0) bc->type = POISSON_DIRICHLET;\r\n    else if (strcmp(type, \"neumann\") == 0) bc->type = POISSON_NEUMANN;\r\n    else return -1;\r\n\r\n    bc->file = colon + 1;\r\n    return 0;\r\n}\r\n\r\n"]
[11050.902706, "o", "static int run_solver_and_print(const CSRMatrix *A, const double *b,\r\n                                const char *solver, const char *precond,\r\n                                double tol, int maxiter, int restart,\r\n                                double omega, const char *output,\r\n                                const char *history)\r\n{\r\n    Precond *P = precond_create(A, precond, omega);\r\n    if (!P) {\r\n        fprintf(stderr, \"Error: cannot create preconditioner '%s'\\n\", precond);\r\n        return 1;\r\n    }\r\n"]
[11050.90277, "o", "\r\n    SolveResult *res = NULL;\r\n    if (strcmp(solver, \"cg\") == 0) {\r\n        res = cg_solve(A, b, NULL, tol, maxiter, P);\r\n    } else if (strcmp(solver, \"gmres\") == 0) {\r\n        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);\r\n    } else {\r\n        fprintf(stderr, \"Error: unknown solver '%s'\\n\", solver);\r\n        precond_destroy(P);\r\n        return 1;\r\n    }\r\n\r\n    if (!res) {\r\n"]
[11050.902828, "o", "        fprintf(stderr, \"Error: solver allocation failed\\n\");\r\n        precond_destroy(P);\r\n        return 1;\r\n    }\r\n"]
[11050.903376, "o", "\u001b[?2004h"]
