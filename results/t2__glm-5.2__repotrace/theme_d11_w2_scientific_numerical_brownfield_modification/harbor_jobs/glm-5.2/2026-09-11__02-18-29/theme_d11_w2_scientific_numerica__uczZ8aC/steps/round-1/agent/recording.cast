[9370.756863, "o", "   185\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   186\t        solve_result_destroy(res);\r\n   187\t        return NULL;\r\n   188\t    }\r\n   189\t\r\n   190\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n   191\t\r\n   192\t    csr_spmv(A, res->x, Ap);\r\n   193\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   194"]
