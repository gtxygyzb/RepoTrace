[297.523568, "o", "    for (int i = 0; i < A->nnz; i++) {\r\n\u001b[?2004l\r"]
[297.523638, "o", "\u001b[?2004h> "]
[297.52377, "o", "        int src = idx[i];\r\n\u001b[?2004l\r"]
[297.523831, "o", "\u001b[?2004h> "]
[297.524307, "o", "        if (k > 0 && out->row[k-1] == A->row[src] && out->col[k-1] == A->col[src]) {\r\n\u001b[?2004l\r"]
[297.524368, "o", "\u001b[?2004h> "]
[297.52463, "o", "            out->values[k-1] += A->values[src];\r\n\u001b[?2004l\r"]
[297.524691, "o", "\u001b[?2004h> "]
[297.524784, "o", "        } else {\r\n\u001b[?2004l\r"]
[297.524846, "o", "\u001b[?2004h> "]
[297.525067, "o", "            out->row[k] = A->row[src];\r\n\u001b[?2004l\r"]
[297.52513, "o", "\u001b[?2004h> "]
[297.52535, "o", "            out->col[k] = A->col[src];\r\n\u001b[?2004l\r"]
[297.525416, "o", "\u001b[?2004h> "]
[297.525651, "o", "            out->values[k] = A->values[src];\r\n\u001b[?2004l\r"]
[297.52571, "o", "\u001b[?2004h> "]
[297.525802, "o", "            k++;\r\n\u001b[?2004l\r"]
[297.525863, "o", "\u001b[?2004h> "]
[297.525953, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.526025, "o", "> "]
[297.526102, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.526175, "o", "> "]
[297.526249, "o", "    out->nnz = k;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.526318, "o", "    free(idx);\r\n\u001b[?2004l\r"]
[297.526395, "o", "\u001b[?2004h"]
[297.526456, "o", ">     return out;\r\n\u001b[?2004l\r"]
[297.526521, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[297.526598, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[297.526629, "o", "\u001b[?2004h> "]
[297.526888, "o", "COOMatrix *csr_to_coo(const CSRMatrix *A)\r\n\u001b[?2004l\r"]
[297.526953, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[297.527022, "o", "\u001b[?2004h> "]
[297.527343, "o", "    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);\r\n\u001b[?2004l\r"]
[297.5274, "o", "\u001b[?2004h> "]
[297.52755, "o", "    if (!out) return NULL;\r\n\u001b[?2004l\r"]
[297.527609, "o", "\u001b[?2004h> "]
[297.527692, "o", "    int k = 0;\r\n\u001b[?2004l\r"]
[297.527723, "o", "\u001b[?2004h"]
[297.527819, "o", "> "]
[297.527983, "o", "    for (int i = 0; i < A->rows; i++) {\r\n\u001b[?2004l\r"]
[297.528046, "o", "\u001b[?2004h> "]
[297.528395, "o", "        for (int j = A->row_ptr[i]; j < A->row_ptr[i+1]; j++) {\r\n\u001b[?2004l\r"]
[297.528454, "o", "\u001b[?2004h> "]
[297.528614, "o", "            out->row[k] = i;\r\n\u001b[?2004l\r"]
[297.528673, "o", "\u001b[?2004h> "]
[297.528929, "o", "            out->col[k] = A->col_indices[j];\r\n\u001b[?2004l\r"]
[297.529003, "o", "\u001b[?2004h"]
[297.529081, "o", "> "]
[297.529221, "o", "            out->values[k] = A->values[j];\r\n\u001b[?2004l\r"]
[297.529285, "o", "\u001b[?2004h> "]
[297.529377, "o", "            k++;\r\n\u001b[?2004l\r"]
[297.529451, "o", "\u001b[?2004h> "]
[297.529519, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.529598, "o", "> "]
[297.529669, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.529738, "o", "    out->nnz = k;\r\n\u001b[?2004l\r"]
[297.529809, "o", "\u001b[?2004h"]
[297.529901, "o", "> "]
[297.529973, "o", "    return out;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[297.530006, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[297.5301, "o", "\u001b[?2004h> "]
[297.530308, "o", "CSRMatrix *coo_to_csr(const COOMatrix *A)\r\n\u001b[?2004l\r"]
[297.530365, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[297.530442, "o", "\u001b[?2004h> "]
[297.53067, "o", "    COOMatrix *sorted = coo_sort_dedup(A);\r\n\u001b[?2004l\r"]
[297.530728, "o", "\u001b[?2004h> "]
[297.530904, "o", "    if (!sorted) return NULL;\r\n\u001b[?2004l\r"]
[297.530975, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[297.531048, "o", "\u001b[?2004h> "]
[297.531431, "o", "    CSRMatrix *out = csr_create(sorted->rows, sorted->cols, sorted->nnz);\r\n\u001b[?2004l\r"]
[297.53149, "o", "\u001b[?2004h> "]
[297.531778, "o", "    if (!out) { coo_destroy(sorted); return NULL; }\r\n\u001b[?2004l\r"]
[297.531836, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[297.531934, "o", "\u001b[?2004h"]
[297.532004, "o", "> "]
[297.532258, "o", "    for (int i = 0; i <= sorted->rows; i++) out->row_ptr[i] = 0;\r\n\u001b[?2004l\r"]
[297.532318, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[297.532386, "o", "\u001b[?2004h> "]
[297.532622, "o", "    for (int k = 0; k < sorted->nnz; k++) {\r\n\u001b[?2004l\r"]
[297.53267, "o", "\u001b[?2004h> "]
[297.532939, "o", "        out->row_ptr[sorted->row[k] + 1]++;\r\n\u001b[?2004l\r"]
[297.533011, "o", "\u001b[?2004h"]
[297.533088, "o", ">     }\r\n\u001b[?2004l\r"]
[297.53312, "o", "\u001b[?2004h> "]
[297.533332, "o", "    for (int i = 0; i < sorted->rows; i++) {\r\n\u001b[?2004l\r"]
[297.533391, "o", "\u001b[?2004h> "]
[297.533644, "o", "        out->row_ptr[i+1] += out->row_ptr[i];\r\n\u001b[?2004l\r"]
[297.533704, "o", "\u001b[?2004h> "]
[297.533786, "o", "    }\r\n\u001b[?2004l\r"]
[297.533844, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.53433, "o", "    int *next = (int *)malloc((sorted->rows > 0 ? sorted->rows : 1) * sizeof(int));\r\n\u001b[?2004l\r"]
[297.534389, "o", "\u001b[?2004h> "]
[297.534779, "o", "    if (!next) { csr_destroy(out); coo_destroy(sorted); return NULL; }\r\n\u001b[?2004l\r"]
[297.534847, "o", "\u001b[?2004h"]
[297.534881, "o", "> "]
[297.535237, "o", "    for (int i = 0; i < sorted->rows; i++) next[i] = out->row_ptr[i];\r\n\u001b[?2004l\r"]
[297.535268, "o", "\u001b[?2004h"]
[297.535373, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.535598, "o", "    for (int k = 0; k < sorted->nnz; k++) {\r\n\u001b[?2004l\r"]
[297.535655, "o", "\u001b[?2004h> "]
[297.53584, "o", "        int r = sorted->row[k];\r\n\u001b[?2004l\r"]
[297.53594, "o", "\u001b[?2004h> "]
[297.536069, "o", "        int pos = next[r]++;\r\n\u001b[?2004l\r"]
[297.536145, "o", "\u001b[?2004h> "]
[297.53639, "o", "        out->col_indices[pos] = sorted->col[k];\r\n\u001b[?2004l\r"]
[297.536455, "o", "\u001b[?2004h> "]
[297.536705, "o", "        out->values[pos] = sorted->values[k];\r\n\u001b[?2004l\r"]
[297.536769, "o", "\u001b[?2004h> "]
[297.536886, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.536962, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.53704, "o", "    free(next);\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.537071, "o", "> "]
[297.537208, "o", "    coo_destroy(sorted);\r\n\u001b[?2004l\r"]
[297.537266, "o", "\u001b[?2004h> "]
[297.537354, "o", "    return out;\r\n\u001b[?2004l\r"]
[297.537415, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[297.53749, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[297.537521, "o", "\u001b[?2004h> "]
[297.537763, "o", "void csr_spmv(const CSRMatrix *A, const double *x, double *y)\r\n\u001b[?2004l\r"]
[297.537821, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.537919, "o", "> "]
[297.538007, "o", "    for (int i = 0; i < A->rows; i++) {\r\n\u001b[?2004l\r"]
[297.538065, "o", "\u001b[?2004h> "]
[297.538138, "o", "        double s = 0.0;\r\n\u001b[?2004l\r"]
[297.53821, "o", "\u001b[?2004h> "]
[297.538412, "o", "        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n\u001b[?2004l\r"]
[297.538471, "o", "\u001b[?2004h> "]
[297.538655, "o", "            s += A->values[k] * x[A->col_indices[k]];\r\n\u001b[?2004l\r"]
[297.538713, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[297.538781, "o", "\u001b[?2004h> "]
[297.538857, "o", "        y[i] = s;\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.538942, "o", ">     }\r\n\u001b[?2004l\r"]
[297.539015, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.53927, "o", "static int csr_find_in_row(const CSRMatrix *A, int row, int col)\r\n\u001b[?2004l\r"]
[297.53933, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.539411, "o", "> "]
[297.539473, "o", "    int lo = A->row_ptr[row];\r\n\u001b[?2004l\r"]
[297.539555, "o", "\u001b[?2004h> "]
[297.539642, "o", "    int hi = A->row_ptr[row+1] - 1;\r\n\u001b[?2004l\r"]
[297.5397, "o", "\u001b[?2004h> "]
[297.539785, "o", "    while (lo <= hi) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.539844, "o", "> "]
[297.539935, "o", "        int mid = (lo + hi) / 2;\r\n\u001b[?2004l\r"]
[297.539994, "o", "\u001b[?2004h> "]
[297.540167, "o", "        if (A->col_indices[mid] == col) return mid;\r\n\u001b[?2004l\r"]
[297.540232, "o", "\u001b[?2004h> "]
[297.540402, "o", "        if (A->col_indices[mid] < col) lo = mid + 1;\r\n\u001b[?2004l\r"]
[297.540461, "o", "\u001b[?2004h> "]
[297.540541, "o", "        else hi = mid - 1;\r\n\u001b[?2004l\r"]
[297.540601, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[297.540682, "o", "\u001b[?2004h> "]
[297.540741, "o", "    return -1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[297.540807, "o", "\u001b[?2004h"]
[297.540885, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.540997, "o", "CSRMatrix *csr_transpose(const CSRMatrix *A)\r\n\u001b[?2004l\r"]
[297.541055, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.541135, "o", "> "]
[297.541297, "o", "    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);\r\n\u001b[?2004l\r"]
[297.541355, "o", "\u001b[?2004h> "]
[297.541429, "o", "    if (!T) return NULL;\r\n\u001b[?2004l\r"]
[297.541459, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[297.541563, "o", "\u001b[?2004h> "]
[297.541721, "o", "    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;\r\n\u001b[?2004l\r"]
[297.541779, "o", "\u001b[?2004h> "]
[297.541913, "o", "    for (int k = 0; k < A->nnz; k++) {\r\n\u001b[?2004l\r"]
[297.541975, "o", "\u001b[?2004h> "]
[297.542117, "o", "        T->row_ptr[A->col_indices[k] + 1]++;\r\n\u001b[?2004l\r"]
[297.542179, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[297.542263, "o", "\u001b[?2004h> "]
[297.542367, "o", "    for (int i = 0; i < A->cols; i++) {\r\n\u001b[?2004l\r"]
[297.542425, "o", "\u001b[?2004h> "]
[297.542565, "o", "        T->row_ptr[i+1] += T->row_ptr[i];\r\n\u001b[?2004l\r"]
[297.542631, "o", "\u001b[?2004h> "]
[297.542713, "o", "    }\r\n\u001b[?2004l\r"]
[297.542771, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.543025, "o", "    int *next = (int *)malloc((A->cols > 0 ? A->cols : 1) * sizeof(int));\r\n\u001b[?2004l\r"]
[297.543095, "o", "\u001b[?2004h> "]
[297.543241, "o", "    if (!next) { csr_destroy(T); return NULL; }\r\n\u001b[?2004l\r"]
[297.5433, "o", "\u001b[?2004h> "]
[297.543514, "o", "    for (int i = 0; i < A->cols; i++) next[i] = T->row_ptr[i];\r\n\u001b[?2004l\r"]
[297.543544, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[297.543639, "o", "\u001b[?2004h> "]
[297.543739, "o", "    for (int i = 0; i < A->rows; i++) {\r\n\u001b[?2004l\r"]
[297.543798, "o", "\u001b[?2004h> "]
[297.544024, "o", "        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n\u001b[?2004l\r"]
[297.544095, "o", "\u001b[?2004h> "]
[297.544206, "o", "            int c = A->col_indices[k];\r\n\u001b[?2004l\r"]
[297.544265, "o", "\u001b[?2004h> "]
[297.544367, "o", "            int pos = next[c]++;\r\n\u001b[?2004l\r"]
[297.544427, "o", "\u001b[?2004h> "]
[297.544543, "o", "            T->col_indices[pos] = i;\r\n\u001b[?2004l\r"]
[297.544603, "o", "\u001b[?2004h> "]
[297.544741, "o", "            T->values[pos] = A->values[k];\r\n\u001b[?2004l\r"]
[297.544801, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[297.544878, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[297.544953, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[297.545033, "o", "\u001b[?2004h> "]
[297.545063, "o", "    free(next);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.54517, "o", "    return T;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.545228, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.545438, "o", "int csr_is_symmetric(const CSRMatrix *A, double tol)\r\n\u001b[?2004l\r"]
[297.545498, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.545581, "o", "> "]
[297.54567, "o", "    if (A->rows != A->cols) return 0;\r\n\u001b[?2004l\r"]
[297.545738, "o", "\u001b[?2004h> "]
[297.545856, "o", "    for (int i = 0; i < A->rows; i++) {\r\n\u001b[?2004l\r"]
[297.545927, "o", "\u001b[?2004h> "]
[297.546139, "o", "        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n\u001b[?2004l\r"]
[297.5462, "o", "\u001b[?2004h> "]
[297.546323, "o", "            int j = A->col_indices[k];\r\n\u001b[?2004l\r"]
[297.546384, "o", "\u001b[?2004h> "]
[297.546541, "o", "            int idx = csr_find_in_row(A, j, i);\r\n\u001b[?2004l\r"]
[297.546572, "o", "\u001b[?2004h> "]
[297.546711, "o", "            if (idx < 0) return 0;\r\n\u001b[?2004l\r"]
[297.546773, "o", "\u001b[?2004h> "]
[297.547011, "o", "            if (fabs(A->values[k] - A->values[idx]) > tol) return 0;\r\n\u001b[?2004l\r"]
[297.547081, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[297.547143, "o", "\u001b[?2004h"]
[297.547231, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>     return 1;\r\n\u001b[?2004l\r"]
[297.547291, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[297.547373, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[297.547432, "o", "\u001b[?2004h> "]
[297.547531, "o", "double *csr_diagonal(const CSRMatrix *A)\r\n\u001b[?2004l\r"]
[297.54759, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.54767, "o", "> "]
[297.547808, "o", "    int n = A->rows < A->cols ? A->rows : A->cols;\r\n\u001b[?2004l\r"]
[297.547875, "o", "\u001b[?2004h> "]
[297.547981, "o", "    double *diag = vec_create(n);\r\n\u001b[?2004l\r"]
[297.548039, "o", "\u001b[?2004h> "]
[297.548122, "o", "    if (!diag) return NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.548208, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.548267, "o", "> "]
[297.548353, "o", "        int idx = csr_find_in_row(A, i, i);\r\n\u001b[?2004l\r"]
[297.548411, "o", "\u001b[?2004h> "]
[297.548525, "o", "        diag[i] = (idx >= 0) ? A->values[idx] : 0.0;\r\n\u001b[?2004l\r"]
[297.548584, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.54865, "o", "    return diag;\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.548727, "o", "> }\r\n\u001b[?2004l\r"]
[297.548789, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[297.552096, "o", "\u001b[?2004hroot@n30009:/app# "]
