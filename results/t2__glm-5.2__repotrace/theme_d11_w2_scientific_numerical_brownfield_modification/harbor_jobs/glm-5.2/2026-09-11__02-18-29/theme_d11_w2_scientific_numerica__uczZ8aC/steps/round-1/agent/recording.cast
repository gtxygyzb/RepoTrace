[12681.54902, "i", "esult_destroy(res);\n            break;\n        }\n        lambda_min = 1.0 / rq;\n        for (int i = 0; i < n; i++) w[i] = res->x[i] / wnorm;\n        memcpy(vi, w, n * sizeof(double));\n        solve_result_destroy(res);\n\n        inverse_iterations = iter + 1;\n        if (!isnan(prev_lambda_min) && fabs(lambda_min) > 0.0) {\n            if (fabs(lambda_min - prev_lambda_min) / fabs(lambda_min) < tol) {\n                inverse_converged = 1;\n                break;\n            }\n        }\n        prev_lambda_min = lambda_min;\n    }\n\n    double condition_number;\n    if (isnan(lambda_max) || isnan(lambda_min) || lambda_min == 0.0) {\n        condition_number = INFINITY;\n    } else {\n        condition_number = fabs(lambda_max) / fabs(lambda_min);\n    }\n\n    printf(\"lambda_max: %.15e\\n\", lambda_max);\n    printf(\"lambda_min: %.15e\\n\", lambda_min);\n    printf(\"condition_number: %.15e\\n\", condition_number);\n    printf(\"power_iterations: %d\\n\", power_iterations);\n    printf(\"inverse_iterations: %d\\n\", inverse_iterations);"]
