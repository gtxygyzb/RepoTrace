[4142.222733, "o", "\u001b[?2004h> "]
[4142.222811, "o", "        return 1;\r\n\u001b[?2004l\r"]
[4142.222865, "o", "\u001b[?2004h> "]
[4142.222932, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.222988, "o", "\u001b[?2004h> "]
[4142.2232, "o", "    if (A->rows != n || A->cols != n) {\r\n\u001b[?2004l\r"]
[4142.223256, "o", "\u001b[?2004h> "]
[4142.223638, "o", "        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n\u001b[?2004l\r"]
[4142.223693, "o", "\u001b[?2004h> "]
[4142.223887, "o", "                A->rows, A->cols, n);\r\n\u001b[?2004l\r"]
[4142.223945, "o", "\u001b[?2004h> "]
[4142.224027, "o", "        free(b);\r\n\u001b[?2004l\r"]
[4142.224085, "o", "\u001b[?2004h> "]
[4142.2242, "o", "        dm_destroy(A);\r\n\u001b[?2004l\r"]
[4142.224256, "o", "\u001b[?2004h> "]
[4142.224332, "o", "        return 1;\r\n\u001b[?2004l\r"]
[4142.224388, "o", "\u001b[?2004h> "]
[4142.224454, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.224513, "o", "\u001b[?2004h> "]
[4142.224681, "o", "    double *x = vec_create(n);\r\n\u001b[?2004l\r"]
[4142.224737, "o", "\u001b[?2004h> "]
[4142.224809, "o", "    if (!x) {\r\n\u001b[?2004l\r"]
[4142.224865, "o", "\u001b[?2004h> "]
[4142.225168, "o", "        fprintf(stderr, \"Error: allocation failed\\n\");\r\n\u001b[?2004l\r"]
[4142.225224, "o", "\u001b[?2004h> "]
[4142.225301, "o", "        free(b);\r\n\u001b[?2004l\r"]
[4142.225356, "o", "\u001b[?2004h> "]
[4142.225497, "o", "        dm_destroy(A);\r\n\u001b[?2004l\r"]
[4142.225562, "o", "\u001b[?2004h> "]
[4142.225697, "o", "        return 1;\r\n\u001b[?2004l\r"]
[4142.225757, "o", "\u001b[?2004h> "]
[4142.225815, "o", "    }\r\n\u001b[?2004l\r"]
[4142.225879, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rr"]
[4142.225937, "o", "\u001b[?2004h> "]
[4142.226174, "o", "    int rc = dm_solve(A, b, x);\r\n\u001b[?2004l\r"]
[4142.226239, "o", "\u001b[?2004h> "]
[4142.226364, "o", "    if (rc != 0) {\r\n\u001b[?2004l\r"]
[4142.226424, "o", "\u001b[?2004h> "]
[4142.226974, "o", "        fprintf(stderr, \"Error: solver failed (singular or ill-conditioned)\\n\");\r\n\u001b[?2004l\r"]
[4142.227037, "o", "\u001b[?2004h> "]
[4142.227153, "o", "        free(x);\r\n\u001b[?2004l\r"]
[4142.227208, "o", "\u001b[?2004h> "]
[4142.227329, "o", "        free(b);\r\n\u001b[?2004l\r"]
[4142.227385, "o", "\u001b[?2004h> "]
[4142.227545, "o", "        dm_destroy(A);\r\n\u001b[?2004l\r"]
[4142.227609, "o", "\u001b[?2004h> "]
[4142.227735, "o", "        return 1;\r\n\u001b[?2004l\r"]
[4142.22779, "o", "\u001b[?2004h> "]
[4142.227852, "o", "    }\r\n\u001b[?2004l\r"]
[4142.227918, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.227977, "o", "\u001b[?2004h> "]
[4142.228103, "o", "    if (out_file) {\r\n\u001b[?2004l\r"]
[4142.228167, "o", "\u001b[?2004h> "]
[4142.228439, "o", "        vec_write_text(x, n, out_file);\r\n\u001b[?2004l\r"]
[4142.228495, "o", "\u001b[?2004h> "]
[4142.228854, "o", "        printf(\"Solution written to %s\\n\", out_file);\r\n\u001b[?2004l\r"]
[4142.228915, "o", "\u001b[?2004h> "]
[4142.229014, "o", "    } else {\r\n\u001b[?2004l\r"]
[4142.229078, "o", "\u001b[?2004h> "]
[4142.229283, "o", "        printf(\"Solution:\\n\");\r\n\u001b[?2004l\r"]
[4142.229339, "o", "\u001b[?2004h> "]
