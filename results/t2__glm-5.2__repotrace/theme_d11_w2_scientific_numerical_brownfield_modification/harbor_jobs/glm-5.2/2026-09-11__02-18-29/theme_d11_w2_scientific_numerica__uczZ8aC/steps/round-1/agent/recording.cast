[491.659259, "o", "\u001b[?2004h> "]
[491.659395, "o", "            int idx = csr_find_in_row(A, j, i);\r\n\u001b[?2004l\r"]
[491.659415, "o", "\u001b[?2004h> "]
[491.659514, "o", "            if (idx < 0) return 0;\r\n\u001b[?2004l\r"]
[491.659534, "o", "\u001b[?2004h> "]
[491.720826, "o", "            if (fabs(A->values[k] - A->values[idx]) > tol) return 0;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return 1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[491.72095, "o", "double *csr_diagonal(const CSRMatrix *A)\r\n\u001b[?2004l\r"]
[491.72102, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[491.721092, "o", "\u001b[?2004h> "]
[491.721358, "o", "    int n = A->rows < A->cols ? A->rows : A->cols;\r\n\u001b[?2004l\r"]
[491.721416, "o", "\u001b[?2004h> "]
[491.721607, "o", "    double *diag = vec_create(n);\r\n\u001b[?2004l\r"]
[491.721666, "o", "\u001b[?2004h> "]
[491.721821, "o", "    if (!diag) return NULL;\r\n\u001b[?2004l\r"]
[491.721917, "o", "\u001b[?2004h> "]
[491.722082, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[491.722158, "o", "\u001b[?2004h> "]
[491.722389, "o", "        int idx = csr_find_in_row(A, i, i);\r\n\u001b[?2004l\r"]
[491.722458, "o", "\u001b[?2004h> "]
[491.722746, "o", "        diag[i] = (idx >= 0) ? A->values[idx] : 0.0;\r\n\u001b[?2004l\r"]
[491.722808, "o", "\u001b[?2004h> "]
[491.722892, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[491.723003, "o", "    return diag;\r\n\u001b[?2004l\r"]
[491.723066, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
