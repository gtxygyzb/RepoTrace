[12546.517081, "o", "    10\t\r\n    11\tstatic const char *get_opt(int argc, char **argv, const char *name)\r\n    12\t{\r\n    13\t    for (int i = 0; i < argc - 1; i++) {\r\n    14\t        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    15\t    }\r\n    16\t    return NULL;\r\n    17\t}\r\n    18\t\r\n    19\tstatic int parse_int(const char *s, int *out)\r\n    20\t{\r\n    21\t    char *end;\r\n    22\t    long v = strtol(s, &end, 10);\r\n    23\t    if (end == s || *end != '\\0' || v < 1) return -1;\r\n    24\t    *out = (int)v;\r\n    25\t    return 0;\r\n    26\t}\r\n"]
[12546.517158, "o", "    27\t\r\n    28\tstatic int parse_double(const char *s, double *out)\r\n    29\t{\r\n    30\t    char *end;\r\n    31\t    double v = strtod(s, &end);\r\n    32\t    if (end == s) return -1;\r\n"]
[12546.517223, "o", "    33\t    *out = v;\r\n    34\t    return 0;\r\n    35\t}\r\n    36\t\r\n    37\tstatic void init_random_vector(double *v, int n)\r\n    38\t{\r\n    39\t    srand(42);\r\n    40\t    for (int i = 0; i < n; i++) v[i] = (double)rand() / (double)RAND_MAX;\r\n    41\t    double nrm = vec_norm2(v, n);\r\n    42\t    if (nrm > 0.0) {\r\n    43\t        for (int i = 0; i < n; i++) v[i] /= nrm;\r\n    44\t    } else {\r\n    45\t        v[0] = 1.0;\r\n    46\t    }\r\n    47\t}\r\n    48\t\r\n"]
[12546.517286, "o", "    49\tstatic SolveResult *solve_linear_system(const CSRMatrix *A, const double *b,\r\n    50\t                                       const char *solver, const char *precond,\r\n    51\t                                       double tol, int maxiter, int restart,\r\n    52\t                                       double omega, int *fail)\r\n    53\t{\r\n    54\t    Precond *P = precond_create(A, precond, omega);\r\n    55\t    if (!P) {\r\n    56\t        *fail = 1;\r\n    57\t        return NULL;\r\n    58\t    }\r\n"]
[12546.517349, "o", "    59\t\r\n    60\t    SolveResult *res = NULL;\r\n    61\t    if (strcmp(solver, \"cg\") == 0) {\r\n    62\t        res = cg_solve(A, b, NULL, tol, maxiter, P);\r\n    63\t    } else if (strcmp(solver, \"gmres\") == 0) {\r\n    64\t        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);\r\n    65\t    } else {\r\n    66\t        *fail = 2;\r\n    67\t    }\r\n    68\t\r\n"]
[12546.517407, "o", "    69\t    precond_destroy(P);\r\n    70\t    if (!res) *fail = 1;\r\n    71\t    return res;\r\n    72\t}\r\n    73\t\r\n    74\tstatic CSRMatrix *make_shifted_matrix(const CSRMatrix *A, double sigma)\r\n    75\t{\r\n    76\t    int n = A->rows;\r\n    77\t    int *has_diag = (int *)calloc(n, sizeof(int));\r\n"]
[12546.517466, "o", "    78\t    if (!has_diag) return NULL;\r\n    79\t\r\n    80\t    for (int i = 0; i < n; i++) {\r\n    81\t        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n    82\t            if (A->col_indices[k] == i) has_diag[i] = 1;\r\n    83\t        }\r\n    84\t    }\r\n    85\t\r\n    86\t    int missing = 0;\r\n    87\t    for (int i = 0; i < n; i++) {\r\n"]
[12546.517522, "o", "    88\t        if (!has_diag[i]) missing++;\r\n    89\t    }\r\n    90\t\r\n    91\t    COOMatrix *coo = coo_create(n, n, A->nnz + missing);\r\n    92\t    if (!coo) { free(has_diag); return NULL; }\r\n    93\t\r\n    94\t    int idx = 0;\r\n    95\t    for (int i = 0; i < n; i++) {\r\n    96\t        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n"]
[12546.517579, "o", "    97\t            coo->row[idx] = i;\r\n    98\t            coo->col[idx] = A->col_indices[k];\r\n    99\t            coo->values[idx] = A->values[k];\r\n   100\t            if (A->col_indices[k] == i) coo->values[idx] -= sigma;\r\n   101\t            idx++;\r\n   102\t        }\r\n   103\t    }\r\n   104\t    for (int i = 0; i < n; i++) {\r\n   105\t        if (!has_diag[i]) {\r\n"]
[12546.517649, "o", "   106\t            coo->row[idx] = i;\r\n   107\t            coo->col[idx] = i;\r\n   108\t            coo->values[idx] = -sigma;\r\n   109\t            idx++;\r\n   110\t        }\r\n   111\t    }\r\n   112\t\r\n   113\t    CSRMatrix *S = coo_to_csr(coo);\r\n   114\t    coo_destroy(coo);\r\n   115\t    free(has_diag);\r\n"]
