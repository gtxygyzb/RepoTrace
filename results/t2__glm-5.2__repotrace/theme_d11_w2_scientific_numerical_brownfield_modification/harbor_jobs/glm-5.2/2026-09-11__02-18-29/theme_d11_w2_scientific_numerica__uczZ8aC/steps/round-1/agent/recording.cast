[1145.645816, "o", "    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.645974, "o", "    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
