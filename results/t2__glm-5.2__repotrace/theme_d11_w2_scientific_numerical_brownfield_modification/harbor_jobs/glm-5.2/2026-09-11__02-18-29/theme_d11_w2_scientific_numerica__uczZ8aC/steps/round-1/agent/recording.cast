[11130.895484, "o", "     9\t    CSRMatrix *A = (CSRMatrix *)malloc(sizeof(CSRMatrix));\r\n    10\t    if (!A) return NULL;\r\n    11\t    A->rows = rows;\r\n    12\t    A->cols = cols;\r\n    13\t    A->nnz = nnz;\r\n    14\t    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));\r\n    15\t    A->col_indices = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    16\t    A->row_ptr = (int *)calloc((rows >= 0 ? rows + 1 : 1), sizeof(int));\r\n    17\t    if (!A->values || !A->col_indices || !A->row_ptr) {\r\n    18\t        csr_destroy(A);\r\n    19\t        return NULL;\r\n    20\t    }\r\n    21\t    return A;\r\n    22\t}\r\n    23\t\r\n    24\tvoid csr_destroy(CSRMatrix *A)\r\n    25\t{\r\n    26\t    if (!A) return;\r\n    27\t    free(A->values);\r\n    28\t    free(A->col_indices);\r\n    29\t    free(A->row_ptr);\r\n    30\t    free(A);\r\n    31\t}\r\n"]
[11130.895571, "o", "    32\t\r\n    33\tCOOMatrix *coo_create(int rows, int cols, int nnz)\r\n    34\t{\r\n    35\t    COOMatrix *A = (COOMatrix *)malloc(sizeof(COOMatrix));\r\n    36\t    if (!A) return NULL;\r\n    37\t    A->rows = rows;\r\n    38\t    A->cols = cols;\r\n    39\t    A->nnz = nnz;\r\n    40\t    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));\r\n    41\t    A->row = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    42\t    A->col = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    43\t    if (!A->values || !A->row || !A->col) {\r\n"]
[11130.895637, "o", "    44\t        coo_destroy(A);\r\n    45\t        return NULL;\r\n    46\t    }\r\n    47\t    return A;\r\n    48\t}\r\n    49\t\r\n    50\tvoid coo_destroy(COOMatrix *A)\r\n    51\t{\r\n    52\t    if (!A) return;\r\n    53\t    free(A->values);\r\n    54\t"]
[11130.8957, "o", "    free(A->row);\r\n    55\t    free(A->col);\r\n    56\t    free(A);\r\n    57\t}\r\n    58\t\r\n    59\tstatic const COOMatrix *g_coo_sort_data = NULL;\r\n    60\t\r\n    61\tstatic int coo_qsort_cmp(const void *pa, const void *pb)\r\n    62\t{\r\n"]
[11130.89576, "o", "    63\t    int ia = *(const int *)pa;\r\n    64\t    int ib = *(const int *)pb;\r\n    65\t    const COOMatrix *A = g_coo_sort_data;\r\n    66\t    if (A->row[ia] != A->row[ib]) return A->row[ia] - A->row[ib];\r\n    67\t    return A->col[ia] - A->col[ib];\r\n    68\t}\r\n    69\t\r\n    70\tstatic COOMatrix *coo_sort_dedup(const COOMatrix *A)\r\n    71\t{\r\n"]
[11130.895821, "o", "    72\t    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);\r\n    73\t    if (!out) return NULL;\r\n    74\t\r\n    75\t    int *idx = (int *)malloc((A->nnz > 0 ? A->nnz : 1) * sizeof(int));\r\n    76\t    if (!idx) { coo_destroy(out); return NULL; }\r\n    77\t    for (int i = 0; i < A->nnz; i++) idx[i] = i;\r\n    78\t\r\n    79\t    g_coo_sort_data = A;\r\n    80\t    qsort(idx, A->nnz, sizeof(int), coo_qsort_cmp);"]
[11130.895911, "o", "\r\n    81\t    g_coo_sort_data = NULL;\r\n    82\t\r\n    83\t    int k = 0;\r\n    84\t    for (int i = 0; i < A->nnz; i++) {\r\n    85\t        int src = idx[i];\r\n    86\t        if (k > 0 && out->row[k-1] == A->row[src] && out->col[k-1] == A->col[src]) {\r\n    87\t            out->values[k-1] += A->values[src];\r\n    88\t        } else {\r\n    89\t            out->row[k] = A->row[src];\r\n    90\t            out->col[k] = A->col[src];\r\n"]
[11130.895975, "o", "    91\t            out->values[k] = A->values[src];\r\n    92\t            k++;\r\n    93\t        }\r\n    94\t    }\r\n    95\t    out->nnz = k;\r\n    96\t    free(idx);\r\n    97\t    return out;\r\n    98\t}\r\n    99\t\r\n   100\tCOOMatrix *csr_to_coo(const CSRMatrix *A)\r\n"]
[11130.896033, "o", "   101\t{\r\n   102\t    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);\r\n   103\t    if (!out) return NULL;\r\n   104\t    int k = 0;\r\n   105\t    for (int i = 0; i < A->rows; i++) {\r\n   106\t        for (int j = A->row_ptr[i]; j < A->row_ptr[i+1]; j++) {\r\n   107\t            out->row[k] = i;\r\n   108"]
[11130.896097, "o", "\t            out->col[k] = A->col_indices[j];\r\n   109\t            out->values[k] = A->values[j];\r\n   110\t            k++;\r\n   111\t        }\r\n   112\t    }\r\n   113\t    out->nnz = k;\r\n   114\t    return out;\r\n   115\t}\r\n   116\t\r\n   117\tCSRMatrix *coo_to_csr(const COOMatrix *A)\r\n   118\t"]
