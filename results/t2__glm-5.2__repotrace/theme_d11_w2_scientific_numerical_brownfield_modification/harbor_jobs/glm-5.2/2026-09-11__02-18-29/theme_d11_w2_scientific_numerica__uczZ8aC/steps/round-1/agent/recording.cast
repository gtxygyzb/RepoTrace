[11434.747112, "o", "\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int \u001b[01;31m\u001b[Kcmd_poisson\u001b[m\u001b[K(int argc, char **argv)\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int rc = \u001b[01;31m\u001b[Krun_solver_and_print\u001b[m\u001b[K(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int \u001b[01;31m\u001b[Kcmd_convdiff\u001b[m\u001b[K(int argc, char **argv)\r\n"]
[11434.747204, "o", "\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K482\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int rc = \u001b[01;31m\u001b[Krun_solver_and_print\u001b[m\u001b[K(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n"]
[11434.747276, "o", "\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K721\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        return \u001b[01;31m\u001b[Kcmd_poisson\u001b[m\u001b[K(argc - 2, argv + 2);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K725\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        return \u001b[01;31m\u001b[Kcmd_convdiff\u001b[m\u001b[K(argc - 2, argv + 2);\r\n"]
