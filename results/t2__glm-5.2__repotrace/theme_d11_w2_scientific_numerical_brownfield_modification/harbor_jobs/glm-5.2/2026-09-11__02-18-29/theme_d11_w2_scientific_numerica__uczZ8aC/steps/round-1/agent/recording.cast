[7822.676388, "o", ".RECIPEPREFIX := >\r\n\r\nCC      = gcc\r\nCFLAGS  = -Wall -Wextra -O2 -Iinclude\r\nLDFLAGS = -lm\r\n\r\nSRC     = src/main.c src/dense.c src/vector.c src/io.c src/sparse.c src/precond.c src/solvers.c src/poisson.c src/heat.c src/convdiff.c\r\nOBJ     = $(SRC:.c=.o)\r\nBIN     = numsim\r\n\r\n"]
