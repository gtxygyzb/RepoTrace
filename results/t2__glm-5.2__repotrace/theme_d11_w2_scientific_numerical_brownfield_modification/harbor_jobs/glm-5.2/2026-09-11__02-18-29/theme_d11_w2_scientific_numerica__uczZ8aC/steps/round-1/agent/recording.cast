[12509.119669, "o", "   120\t}\r\n   121\t\r\n   122\tstatic void apply_givens(double *a, double *b, double c, double s)\r\n   123\t{\r\n   124\t    double t = c * (*a) + s * (*b);\r\n"]
[12509.119764, "o", "   125\t    *b = -s * (*a) + c * (*b);\r\n   126\t    *a = t;\r\n   127\t}\r\n   128\t\r\n   129\tstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n   130\t{\r\n   131\t    if (kdim <= 0) return -1;\r\n   132\t\r\n   133\t    double *c = (double *)malloc(m * sizeof(double));\r\n   134\t    double *s = (double *)malloc(m * sizeof(double));\r\n   135\t    if (!c || !s) { free(c); free(s); return -1; }\r\n   136\t\r\n   137\t    for (int i = 0; i < kdim; i++) {\r\n   138\t        for (int k = 0; k < i; k++) {\r\n   139\t            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n"]
[12509.11984, "o", "   140\t        }\r\n   141\t\r\n   142\t        double a = H[i*m+i];\r\n   143\t        double b = H[(i+1)*m+i];\r\n   144\t        if (b == 0.0) {\r\n   145\t            c[i] = 1.0;\r\n   146\t            s[i] = 0.0;\r\n   147\t        } else {\r\n   148\t            double r = hypot(a, b);\r\n   149\t            c[i] = a / r;\r\n"]
[12509.11993, "o", "   150\t            s[i] = b / r;\r\n   151\t        }\r\n   152\t        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n   153\t        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n   154\t\r\n   155\t    }\r\n   156\t\r\n   157\t    for (int i = kdim - 1; i >= 0; i--) {\r\n   158\t        double sum = g[i];\r\n   159\t        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n"]
[12509.119989, "o", "   160\t        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n   161\t        y[i] = sum / H[i*m+i];\r\n   162\t    }\r\n   163\t\r\n   164\t    free(c);\r\n   165\t    free(s);\r\n   166\t    return 0;\r\n   167\t}\r\n   168\t\r\n   169\t"]
[12509.12005, "o", "SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n   170\t                           double tol, int maxiter, int m, Precond *P)\r\n   171\t{\r\n   172\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n   173\t    int n = A->rows;\r\n   174\t    if (m <= 0) m = 30;\r\n   175\t    if (maxiter < 0) maxiter = 0;\r\n   176\t\r\n   177\t    SolveResult *res = result_create(n, maxiter);\r\n   178\t    if (!res) return NULL;\r\n   179"]
[12509.120111, "o", "\t\r\n   180\t    double *r = vec_create(n);\r\n   181\t    double *z = vec_create(n);\r\n   182\t    double *Ap = vec_create(n);\r\n   183\t    double *Av = vec_create(n);\r\n   184\t    double *w = vec_create(n);\r\n   185\t    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n"]
[12509.120182, "o", "   186\t    double *y = (double *)malloc(m * sizeof(double));\r\n   187\t    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n   188\t    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n   189\t\r\n   190\t    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n   191\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   192\t        solve_result_destroy(res);\r\n   193\t        return NULL;\r\n"]
[12509.120249, "o", "   194\t    }\r\n   195\t\r\n   196\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n   197\t\r\n   198\t    csr_spmv(A, res->x, Ap);\r\n   199\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   200\t\r\n   201\t    double bnorm = vec_norm2(b, n);\r\n   202\t    if (bnorm == 0.0) bnorm = 1.0;\r\n   203\t    double bnorm_inf = vec_norm_inf(b, n);\r\n   204\t    if (bnorm_inf == 0.0) bnorm_inf = 1.0;\r\n"]
[12509.12031, "o", "   205\t\r\n   206\t    res->true_residual = vec_norm2(r, n);\r\n   207\t    res->relres = res->true_residual / bnorm;\r\n   208\t    res->true_residual_inf = vec_norm_inf(r, n);\r\n   209\t    res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n   210\t    precond_apply(P, A, r, z);\r\n   211\t    double pnorm0 = vec_norm2(z, n);\r\n   212\t    res->history[0] = res->relres;\r\n   213\t    res->precond_history[0] = pnorm0;\r\n   214\t    res->history_len = 1;\r\n   215\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n   216\t    res->iterations = 0;\r\n   217\t    if (res->converged || maxiter == 0) {\r\n"]
[12509.120373, "o", "   218\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   219\t        return res;\r\n   220\t    }\r\n   221\t\r\n   222\t    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n   223\t        if (precond_apply(P, A, r, z) != 0) break;\r\n   224\t        double beta = vec_norm2(z, n);\r\n   225\t        if (beta == 0.0) break;\r\n   226\t\r\n   227\t        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n   228\t        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n   229"]
[12509.120434, "o", "\t        g[0] = beta;\r\n   230\t        memset(H, 0, (m + 1) * m * sizeof(double));\r\n   231\t\r\n   232\t        int kdim = 0;\r\n   233\t        int fail = 0;\r\n   234\t        for (int j = 0; j < m; j++) {\r\n   235\t            csr_spmv(A, V + j * n, Av);\r\n   236\t"]
[12509.120507, "o", "            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n   237\t\r\n   238\t            for (int i = 0; i <= j; i++) {\r\n   239\t                double h = vec_dot(w, V + i * n, n);\r\n   240\t                H[i*m+j] = h;\r\n   241\t                vec_axpy(-h, V + i * n, w, n);\r\n"]
[12509.120574, "o", "   242\t            }\r\n   243\t\r\n   244\t            double hnorm = vec_norm2(w, n);\r\n   245\t            H[(j+1)*m+j] = hnorm;\r\n   246\t            kdim = j + 1;\r\n   247\t\r\n   248\t            if (hnorm < 1e-14) break;\r\n   249\t\r\n   250\t            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n   251\t        }\r\n   252\t        if (fail) break;\r\n   253\t        if (kdim == 0) break;\r\n   254\t\r\n   255\t        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n"]
[12509.120662, "o", "   256\t        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n   257\t\r\n   258\t        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n   259\t\r\n   260\t        csr_spmv(A, res->x, Ap);\r\n   261\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   262\t\r\n   263\t        res->true_residual = vec_norm2(r, n);\r\n   264\t        res->relres = res->true_residual / bnorm;\r\n   265\t        res->true_residual_inf = vec_norm_inf(r, n);\r\n   266\t        res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n   267\t        precond_apply(P, A, r, z);\r\n   268\t        double pznorm = vec_norm2(z, n);\r\n"]
[12509.120726, "o", "   269\t        res->history[cycle] = res->relres;\r\n   270\t        res->precond_history[cycle] = pznorm;\r\n   271\t        res->history_len = cycle + 1;\r\n   272\t        res->iterations = cycle;\r\n   273\t\r\n   274\t        if (res->relres < tol) {\r\n   275\t            res->converged = 1;\r\n   276\t            break;\r\n   277\t        }\r\n   278\t    }\r\n   279\t"]
[12509.120787, "o", "\r\n   280\t    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   281\t    return res;\r\n   282\t}\r\n   283\t\r\n   284\tvoid solve_result_destroy(SolveResult *res)\r\n   285\t{\r\n   286\t    if (!res) return;\r\n   287\t    free(res->x);\r\n   288\t    free(res->history);\r\n   289\t"]
[12509.120842, "o", "    free(res->precond_history);\r\n   290\t    free(res);\r\n   291\t}\r\n"]
