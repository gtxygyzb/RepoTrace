[12760.853284, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/main.c')\ns = p.read_text()\nneedle = '    fprintf(stderr, \"  %s matvec --input <mtx_file> --vec <vec_file> [--output <out_file>] [--transpose\\\\n\", prog);\\n'\nif needle not in s:\n    # fallback: insert before matinfo line\n    needle = '    fprintf(stderr, \"  %s matinfo --input <mtx_file>\\\\n\", prog);\\n'\nif 'condition --input' not in s:\n    insert = '    fprintf(stderr, \"  %s condition --input <mtx_file> --tol <float> --maxiter <int> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> [--restart <m>] [--ssor-omega <w>] [--solver-tol <float>] [--solver-maxiter <int>]\\\\n\", prog);\\n'\n    s = s.replace(needle, insert + needle)\np.write_text(s)\nPY\n"]
