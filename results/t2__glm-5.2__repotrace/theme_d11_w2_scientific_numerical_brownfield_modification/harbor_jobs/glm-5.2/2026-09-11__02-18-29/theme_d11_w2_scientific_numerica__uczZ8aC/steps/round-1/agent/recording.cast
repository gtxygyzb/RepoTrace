[11075.735348, "o", "   469\t    if (pe > 1.0) {\r\n   470\t        fprintf(stderr, \"warning: cell Peclet number %.6e > 1, solution may exhibit oscillations\\n\", pe);\r\n   471\t    }\r\n   472\t\r\n   473\t    CSRMatrix *A = NULL;\r\n   474\t    double *b = NULL;\r\n   475\t    if (convdiff_assemble(nx, ny, x0, x1, y0, y1, kappa, vx, vy,\r\n   476\t                          source, left, right, bottom, top, &A, &b) != 0) {\r\n   477\t        fprintf(stderr, \"Error: cannot assemble convdiff system\\n\");\r\n   478\t        return 1;"]
