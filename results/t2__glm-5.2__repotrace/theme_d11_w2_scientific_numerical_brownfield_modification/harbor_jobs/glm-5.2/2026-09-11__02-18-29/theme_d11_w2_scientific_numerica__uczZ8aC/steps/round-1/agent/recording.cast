[2854.421018, "o", "   100\t}\r\n   101\t\r\n   102\tstatic void apply_givens(double *a, double *b, double c, double s)\r\n   103\t{\r\n"]
[2854.42114, "o", "   104\t    double t = c * (*a) + s * (*b);\r\n   105\t    *b = -s * (*a) + c * (*b);\r\n   106\t    *a = t;\r\n   107\t}\r\n   108\t\r\n   109\tstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n   110\t{\r\n   111\t    if (kdim <= 0) return -1;\r\n"]
[2854.421217, "o", "   112\t\r\n   113\t    double *c = (double *)malloc(m * sizeof(double));\r\n   114\t    double *s = (double *)malloc(m * sizeof(double));\r\n   115\t    if (!c || !s) { free(c); free(s); return -1; }\r\n   116\t\r\n   117\t    for (int i = 0; i < kdim; i++) {\r\n   118\t        for (int k = 0; k < i; k++) {\r\n   119\t            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n   120\t        }\r\n   121\t\r\n   122\t        double a = H[i*m+i];\r\n   123\t        double b = H[(i+1)*m+i];\r\n   124\t        if (b == 0.0) {\r\n   125\t            c[i] = 1.0;\r\n   126\t            s[i] = 0.0;\r\n   127\t        } else {\r\n   128\t            double r = hypot(a, b);\r\n   129\t            c[i] = a / r;\r\n   130\t            s[i] = b / r;\r\n   131\t        }\r\n   132\t        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n   133\t        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n   134\t\r\n   135\t    }\r\n"]
[2854.421288, "o", "   136\t\r\n   137\t    for (int i = kdim - 1; i >= 0; i--) {\r\n   138\t        double sum = g[i];\r\n   139\t        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n   140\t        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n   141\t        y[i] = sum / H[i*m+i];\r\n   142\t    }\r\n   143\t\r\n   144\t    free(c);\r\n   145\t    free(s);\r\n   146\t    return 0;\r\n"]
