[11051.463028, "o", "\u001b[?2004l\r"]
[11051.465952, "o", "    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n"]
[11051.466029, "o", "    const char *history = get_opt(argc, argv, \"--history\");\r\n\r\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !kappa_s ||\r\n        !vx_s || !vy_s || !source ||\r\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n        !solver || !precond || !tol_s || !maxiter_s || !output) {\r\n        fprintf(stderr, \"Error: convdiff requires grid, domain, kappa, vx, vy, source, boundary conditions, solver, precond, tol, maxiter, output\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n\r\n    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n"]
[11051.466101, "o", "    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n    double kappa = atof(kappa_s);\r\n    double vx = atof(vx_s);\r\n    double vy = atof(vy_s);\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || kappa <= 0.0 ||\r\n        tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid convdiff parameters\\n\");\r\n        return 1;\r\n"]
[11051.466176, "o", "    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    double hx = (x1 - x0) / (nx - 1);\r\n    double hy = (y1 - y0) / (ny - 1);\r\n    double pe = convdiff_peclet(vx, vy, hx, hy, kappa);\r\n    if (pe > 1.0) {\r\n"]
[11051.466242, "o", "        fprintf(stderr, \"warning: cell Peclet number %.6e > 1, solution may exhibit oscillations\\n\", pe);\r\n    }\r\n\r\n    CSRMatrix *A = NULL;\r\n    double *b = NULL;\r\n    if (convdiff_assemble(nx, ny, x0, x1, y0, y1, kappa, vx, vy,\r\n                          source, left, right, bottom, top, &A, &b) != 0) {\r\n        fprintf(stderr, \"Error: cannot assemble convdiff system\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n    printf(\"peclet: %.6e\\n\", pe);\r\n\r\n"]
[11051.466312, "o", "    free(b);\r\n    csr_destroy(A);\r\n    return rc;\r\n}\r\n\r\n\r\nstatic int cmd_matinfo(int argc, char **argv)\r\n{\r\n    const char *input = get_opt(argc, argv, \"--input\");\r\n    if (!input) {\r\n        fprintf(stderr, \"Error: matinfo requires --input <mtx_file>\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n\r\n    CSRMatrix *A = csr_read_mm(input);"]
[11051.466375, "o", "\r\n    if (!A) {\r\n        fprintf(stderr, \"error: cannot read matrix file\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int rows = A->rows;\r\n    int cols = A->cols;\r\n\r\n"]
[11051.466467, "o", "    int symmetric = 0;\r\n    if (rows == cols) {\r\n        symmetric = 1;\r\n        for (int i = 0; i < rows && symmetric; i++) {\r\n            for (int k = A->row_ptr[i]; k < A->row_ptr[i+1] && symmetric; k++) {\r\n                int j = A->col_indices[k];\r\n                double v = A->values[k];\r\n\r\n                int idx = -1;\r\n                for (int l = A->row_ptr[j]; l < A->row_ptr[j+1]; l++) {\r\n"]
[11051.466535, "o", "                    if (A->col_indices[l] == i) {\r\n                        idx = l;\r\n                        break;\r\n                    }\r\n                }\r\n                if (idx < 0) {\r\n                    symmetric = 0;\r\n                    break;\r\n                }\r\n\r\n                double vt = A->values[idx];\r\n                double diff = fabs(v - vt);\r\n                double denom = fmax(fabs(v), fmax(fabs(vt), 1e-30));\r\n                if (diff >= 1e-12 * denom) {\r\n                    symmetric = 0;\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n    }\r\n\r\n    int bandwidth = 0;\r\n    int nonzero_count = 0;\r\n"]
[11051.466646, "o", "    double frobenius_norm = 0.0;\r\n    double max_abs_value = 0.0;\r\n    double min_abs_nonzero = 0.0;\r\n\r\n    for (int i = 0; i < A->rows; i++) {\r\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n            int j = A->col_indices[k];\r\n            double v = A->values[k];\r\n            double av = fabs(v);\r\n\r\n            frobenius_norm += v * v;\r\n\r\n            if (av > max_abs_value) max_abs_value = av;\r\n\r\n            if (av != 0.0) {\r\n                nonzero_count++;\r\n\r\n                int bw = i - j;\r\n                if (bw < 0) bw = -bw;\r\n                if (bw > bandwidth) bandwidth = bw;\r\n\r\n                if (min_abs_nonzero == 0.0 || av < min_abs_nonzero) {\r\n                    min_abs_nonzero = av;\r\n                }\r\n            }\r\n        }\r\n    }\r\n"]
[11051.466717, "o", "\r\n    frobenius_norm = sqrt(frobenius_norm);\r\n\r\n    int strict = 1;\r\n    int weak = 1;\r\n    for (int i = 0; i < A->rows; i++) {\r\n        double diag = 0.0;\r\n        double offsum = 0.0;\r\n\r\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n            int j = A->col_indices[k];\r\n            if (j == i) {\r\n                diag = A->values[k];\r\n            } else {\r\n                offsum += fabs(A->values[k]);\r\n            }\r\n"]
[11051.46678, "o", "        }\r\n\r\n        if (fabs(diag) > offsum) {\r\n            continue;\r\n        }\r\n        if (fabs(diag) >= offsum) {\r\n            strict = 0;\r\n        } else {\r\n            strict = 0;\r\n            weak = 0;\r\n            break;\r\n        }\r\n    }\r\n"]
[11051.466814, "o", "\r\n    const char *diagonal_dominance = strict ? \"strict\" : (weak ? \"weak\" : \"none\");\r\n\r\n    printf(\"rows: %d\\n\", rows);\r\n    printf(\"cols: %d\\n\", cols);\r\n    printf(\"nnz: %d\\n\", nonzero_count);\r\n    printf(\"symmetric: %s\\n\", symmetric ? \"yes\" : \"no\");\r\n    printf(\"bandwidth: %d\\n\", bandwidth);\r\n"]
[11051.466896, "o", "    printf(\"frobenius_norm: %.15e\\n\", frobenius_norm);\r\n    printf(\"diagonal_dominance: %s\\n\", diagonal_dominance);\r\n    printf(\"max_abs_value: %.15e\\n\", max_abs_value);\r\n    printf(\"min_abs_nonzero: %.15e\\n\", min_abs_nonzero);\r\n\r\n    csr_destroy(A);\r\n"]
[11051.466984, "o", "    return 0;\r\n}\r\n\r\nint main(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        usage(argv[0]);\r\n        return 1;\r\n    }\r\n\r\n    const char *cmd = argv[1];\r\n\r\n    if (strcmp(cmd, \"dense-solve\") == 0) {\r\n        return cmd_dense_solve(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"sparse-solve\") == 0) {\r\n"]
[11051.46704, "o", "        return cmd_sparse_solve(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"poisson\") == 0) {\r\n        return cmd_poisson(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"heat\") == 0) {\r\n        return cmd_heat(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"convdiff\") == 0) {\r\n        return cmd_convdiff(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"--help\") == 0 || strcmp(cmd, \"-h\") == 0) {\r\n        usage(argv[0]);\r\n        return 0;\r\n    } else if (strcmp(cmd, \"matinfo\") == 0) {\r\n        return cmd_matinfo(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"eigenvalue\") == 0) {\r\n        return cmd_eigenvalue(argc - 2, argv + 2);\r\n    } else {\r\n        fprintf(stderr, \"Error: unknown command '%s'\\n\", cmd);\r\n        usage(argv[0]);\r\n        return 1;\r\n    }\r\n}\r\n"]
