[4311.417745, "o", "\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int \u001b[01;31m\u001b[Kmm_parse_header\u001b[m\u001b[K(const char *line, int *is_array, int *is_symmetric)\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    char buf[1024];\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    strncpy(buf, line, sizeof(buf)-1);\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    buf[sizeof(buf)-1] = '\\0';\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    char *tok = strtok(buf, \" \\t\\r\\n\");\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!tok || strcmp(tok, \"%%MatrixMarket\") != 0) return -1;\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    tok = strtok(NULL, \" \\t\\r\\n\");\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!tok || strcmp(tok, \"matrix\") != 0) return -1;\r\n\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    tok = strtok(NULL, \" \\t\\r\\n\");\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!tok) return -1;\r\n\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (strcmp(tok, \"coordinate\") == 0) *is_array = 0;\r\n"]
