[4142.321231, "o", "\u001b[?2004h> "]
[4142.321778, "o", "    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n\u001b[?2004l\r"]
[4142.321857, "o", "\u001b[?2004h> "]
[4142.322376, "o", "        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n\u001b[?2004l\r"]
[4142.322428, "o", "\u001b[?2004h> "]
[4142.323048, "o", "        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n\u001b[?2004l\r"]
[4142.323114, "o", "\u001b[?2004h> "]
[4142.32323, "o", "        return 1;\r\n\u001b[?2004l\r"]
[4142.323297, "o", "\u001b[?2004h> "]
[4142.323376, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4142.323442, "o", "> \r\n\u001b[?2004l\r"]
[4142.323522, "o", "\u001b[?2004h> "]
[4142.32366, "o", "    CSRMatrix *A = NULL;\r\n\u001b[?2004l\r"]
[4142.323718, "o", "\u001b[?2004h> "]
[4142.323866, "o", "    double *b = NULL;\r\n\u001b[?2004l\r"]
[4142.323947, "o", "\u001b[?2004h> "]
[4142.324602, "o", "    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {\r\n\u001b[?2004l\r"]
[4142.324672, "o", "\u001b[?2004h> "]
[4142.32512, "o", "        fprintf(stderr, \"Error: cannot assemble Poisson system\\n\");\r\n\u001b[?2004l\r"]
[4142.325186, "o", "\u001b[?2004h> "]
[4142.325299, "o", "        return 1;\r\n\u001b[?2004l\r"]
[4142.325366, "o", "\u001b[?2004h"]
[4142.325426, "o", "> "]
[4142.325507, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4142.325584, "o", "> "]
[4142.326184, "o", "    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\u001b[?2004l\r"]
[4142.326255, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.32634, "o", "\u001b[?2004h> "]
[4142.32641, "o", "    free(b);\r\n\u001b[?2004l\r"]
[4142.326467, "o", "\u001b[?2004h> "]
[4142.326553, "o", "    csr_destroy(A);\r\n\u001b[?2004l\r"]
[4142.326614, "o", "\u001b[?2004h> "]
[4142.3267, "o", "    return rc;\r\n\u001b[?2004l\r"]
[4142.326778, "o", "\u001b[?2004h> "]
[4142.326855, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.326939, "o", "\u001b[?2004h> "]
[4142.327159, "o", "static int cmd_heat(int argc, char **argv)\r\n\u001b[?2004l\r"]
[4142.327223, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[4142.32729, "o", "\u001b[?2004h> "]
[4142.32758, "o", "    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n\u001b[?2004l\r"]
[4142.327638, "o", "\u001b[?2004h> "]
[4142.327938, "o", "    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n\u001b[?2004l\r"]
[4142.327997, "o", "\u001b[?2004h> "]
[4142.328285, "o", "    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n\u001b[?2004l\r"]
[4142.328355, "o", "\u001b[?2004h> "]
[4142.328633, "o", "    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n\u001b[?2004l\r"]
[4142.328692, "o", "\u001b[?2004h> "]
[4142.328989, "o", "    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n\u001b[?2004l\r"]
[4142.329047, "o", "\u001b[?2004h> "]
[4142.329334, "o", "    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n\u001b[?2004l\r"]
[4142.329391, "o", "\u001b[?2004h> "]
[4142.329684, "o", "    const char *alpha_s = get_opt(argc, argv, \"--alpha\");\r\n\u001b[?2004l\r"]
[4142.329738, "o", "\u001b[?2004h> "]
[4142.329996, "o", "    const char *dt_s = get_opt(argc, argv, \"--dt\");\r\n\u001b[?2004l\r"]
[4142.330055, "o", "\u001b[?2004h> "]
[4142.330343, "o", "    const char *nsteps_s = get_opt(argc, argv, \"--nsteps\");\r\n\u001b[?2004l\r"]
[4142.3304, "o", "\u001b[?2004h> "]
[4142.33068, "o", "    const char *scheme = get_opt(argc, argv, \"--scheme\");\r\n\u001b[?2004l\r"]
[4142.330737, "o", "\u001b[?2004h> "]
[4142.331011, "o", "    const char *ic_file = get_opt(argc, argv, \"--ic\");\r\n\u001b[?2004l\r"]
[4142.331067, "o", "\u001b[?2004h> "]
[4142.33137, "o", "    const char *source_arg = get_opt(argc, argv, \"--source\");\r\n\u001b[?2004l\r"]
[4142.331427, "o", "\u001b[?2004h> "]
[4142.331726, "o", "    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n\u001b[?2004l\r"]
[4142.331782, "o", "\u001b[?2004h> "]
[4142.332098, "o", "    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n\u001b[?2004l\r"]
[4142.332155, "o", "\u001b[?2004h> "]
[4142.332476, "o", "    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n\u001b[?2004l\r"]
[4142.332534, "o", "\u001b[?2004h> "]
[4142.332821, "o", "    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n\u001b[?2004l\r"]
[4142.332894, "o", "\u001b[?2004h> "]
[4142.333164, "o", "    const char *solver = get_opt(argc, argv, \"--solver\");\r\n\u001b[?2004l\r"]
[4142.333219, "o", "\u001b[?2004h> "]
[4142.333511, "o", "    const char *precond = get_opt(argc, argv, \"--precond\");\r\n\u001b[?2004l\r"]
[4142.333566, "o", "\u001b[?2004h> "]
[4142.333829, "o", "    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n\u001b[?2004l\r"]
[4142.333898, "o", "\u001b[?2004h> "]
[4142.334198, "o", "    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n\u001b[?2004l\r"]
[4142.334253, "o", "\u001b[?2004h> "]
[4142.334554, "o", "    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n\u001b[?2004l\r"]
[4142.33461, "o", "\u001b[?2004h> "]
[4142.334922, "o", "    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n\u001b[?2004l\r"]
[4142.334978, "o", "\u001b[?2004h> "]
[4142.335261, "o", "    const char *output = get_opt(argc, argv, \"--output\");\r\n\u001b[?2004l\r"]
[4142.335317, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.335385, "o", "\u001b[?2004h> "]
[4142.33573, "o", "    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !alpha_s ||\r\n\u001b[?2004l\r"]
[4142.335787, "o", "\u001b[?2004h> "]
[4142.336126, "o", "        !dt_s || !nsteps_s || !scheme || !ic_file || !source_arg ||\r\n\u001b[?2004l\r"]
[4142.336182, "o", "\u001b[?2004h> "]
[4142.336503, "o", "        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n\u001b[?2004l\r"]
[4142.33656, "o", "\u001b[?2004h> "]
[4142.336884, "o", "        !solver || !precond || !tol_s || !maxiter_s || !output) {\r\n\u001b[?2004l\r"]
[4142.33694, "o", "\u001b[?2004h> "]
[4142.337742, "o", "        fprintf(stderr, \"Error: heat requires grid, domain, alpha, dt, nsteps, scheme, ic, source, boundary conditions, solver, precond, tol, maxiter, output\\n\");\r\n\u001b[?2004l\r"]
[4142.337809, "o", "\u001b[?2004h> "]
[4142.337933, "o", "        usage(\"numsim\");\r\n\u001b[?2004l\r"]
[4142.337994, "o", "\u001b[?2004h> "]
[4142.338076, "o", "        return 1;\r\n\u001b[?2004l\r"]
[4142.338133, "o", "\u001b[?2004h> "]
[4142.338201, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[4142.338257, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4142.338389, "o", "    int nx = atoi(nx_s);\r\n\u001b[?2004l\r"]
[4142.338444, "o", "\u001b[?2004h> "]
[4142.338566, "o", "    int ny = atoi(ny_s);\r\n\u001b[?2004l\r"]
[4142.338621, "o", "\u001b[?2004h> "]
[4142.338757, "o", "    double x0 = atof(x0_s);\r\n\u001b[?2004l\r"]
[4142.338812, "o", "\u001b[?2004h> "]
[4142.338958, "o", "    double x1 = atof(x1_s);\r\n\u001b[?2004l\r"]
[4142.339014, "o", "\u001b[?2004h> "]
[4142.339147, "o", "    double y0 = atof(y0_s);\r\n\u001b[?2004l\r"]
[4142.339204, "o", "\u001b[?2004h> "]
[4142.339341, "o", "    double y1 = atof(y1_s);\r\n\u001b[?2004l\r"]
[4142.339396, "o", "\u001b[?2004h> "]
[4142.33956, "o", "    double alpha = atof(alpha_s);\r\n\u001b[?2004l\r"]
[4142.339617, "o", "\u001b[?2004h> "]
[4142.339734, "o", "    double dt = atof(dt_s);\r\n\u001b[?2004l\r"]
[4142.339789, "o", "\u001b[?2004h> "]
[4142.339901, "o", "    int nsteps = atoi(nsteps_s);\r\n\u001b[?2004l\r"]
[4142.339958, "o", "\u001b[?2004h> "]
[4142.340057, "o", "    double tol = atof(tol_s);\r\n\u001b[?2004l\r"]
[4142.340113, "o", "\u001b[?2004h> "]
[4142.340229, "o", "    int maxiter = atoi(maxiter_s);\r\n\u001b[?2004l\r"]
[4142.340283, "o", "\u001b[?2004h> "]
[4142.340462, "o", "    int restart = restart_s ? atoi(restart_s) : 30;\r\n\u001b[?2004l\r"]
[4142.340518, "o", "\u001b[?2004h> "]
[4142.340689, "o", "    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\u001b[?2004l\r"]
[4142.340743, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4142.340799, "o", "> "]
[4142.341027, "o", "    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || alpha <= 0.0 ||\r\n\u001b[?2004l\r"]
[4142.341084, "o", "\u001b[?2004h> "]
[4142.341363, "o", "        dt <= 0.0 || nsteps < 0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n\u001b[?2004l\r"]
[4142.34142, "o", "\u001b[?2004h> "]
[4142.341629, "o", "        fprintf(stderr, \"Error: invalid heat parameters\\n\");\r\n\u001b[?2004l\r"]
[4142.341684, "o", "\u001b[?2004h> "]
[4142.341736, "o", "        return 1;\r\n\u001b[?2004l\r"]
[4142.341794, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4142.341861, "o", "\u001b[?2004h> "]
[4142.342005, "o", "    if (validate_ssor_omega(omega) != 0) {\r\n\u001b[?2004l\r"]
[4142.34207, "o", "\u001b[?2004h> "]
[4142.342154, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4142.342211, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.342268, "o", "\u001b[?2004h> "]
[4142.342405, "o", "    PoissonBC left, right, bottom, top;\r\n\u001b[?2004l\r"]
[4142.342459, "o", "\u001b[?2004h> "]
[4142.342742, "o", "    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n\u001b[?2004l\r"]
[4142.342798, "o", "\u001b[?2004h> "]
[4142.343083, "o", "        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n\u001b[?2004l\r"]
[4142.343161, "o", "\u001b[?2004h> "]
[4142.343461, "o", "        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n\u001b[?2004l\r"]
[4142.34352, "o", "\u001b[?2004h> "]
[4142.343585, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[4142.343664, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.343747, "o", "\u001b[?2004h> "]
[4142.343998, "o", "    int rc = heat_solve(nx, ny, x0, x1, y0, y1, alpha, dt, nsteps, scheme,\r\n\u001b[?2004l\r"]
[4142.344075, "o", "\u001b[?2004h> "]
[4142.344297, "o", "                       ic_file, source_arg, left, right, bottom, top,\r\n\u001b[?2004l\r"]
[4142.344325, "o", "\u001b[?2004h> "]
[4142.344629, "o", "                       solver, precond, tol, maxiter, restart, omega, output);\r\n\u001b[?2004l\r"]
[4142.344688, "o", "\u001b[?2004h> "]
[4142.344767, "o", "    if (rc != 0) {\r\n\u001b[?2004l\r"]
[4142.344844, "o", "\u001b[?2004h> "]
[4142.344992, "o", "        fprintf(stderr, \"Error: heat solve failed\\n\");\r\n\u001b[?2004l\r"]
[4142.345054, "o", "\u001b[?2004h> "]
[4142.345119, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[4142.345186, "o", ">     }\r\n\u001b[?2004l\r"]
[4142.345262, "o", "\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r"]
[4142.345317, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4142.345377, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.345448, "o", "\u001b[?2004h> "]
[4142.345511, "o", "int main(int argc, char **argv)\r\n\u001b[?2004l\r"]
[4142.345568, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[4142.345634, "o", "\u001b[?2004h> "]
[4142.345682, "o", "    if (argc < 2) {\r\n\u001b[?2004l\r"]
[4142.34574, "o", "\u001b[?2004h> "]
[4142.345808, "o", "        usage(argv[0]);\r\n\u001b[?2004l\r"]
[4142.345886, "o", "\u001b[?2004h> "]
[4142.34596, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4142.346016, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.346086, "o", "\u001b[?2004h> "]
[4142.346185, "o", "    const char *cmd = argv[1];\r\n\u001b[?2004l\r"]
[4142.34624, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4142.346306, "o", "> "]
[4142.346425, "o", "    if (strcmp(cmd, \"dense-solve\") == 0) {\r\n\u001b[?2004l\r"]
[4142.346479, "o", "\u001b[?2004h> "]
[4142.34666, "o", "        return cmd_dense_solve(argc - 2, argv + 2);\r\n\u001b[?2004l\r"]
[4142.346714, "o", "\u001b[?2004h> "]
[4142.346896, "o", "    } else if (strcmp(cmd, \"sparse-solve\") == 0) {\r\n\u001b[?2004l\r"]
[4142.346956, "o", "\u001b[?2004h> "]
[4142.347134, "o", "        return cmd_sparse_solve(argc - 2, argv + 2);\r\n\u001b[?2004l\r"]
[4142.347189, "o", "\u001b[?2004h> "]
[4142.347345, "o", "    } else if (strcmp(cmd, \"poisson\") == 0) {\r\n\u001b[?2004l\r"]
[4142.347401, "o", "\u001b[?2004h> "]
[4142.347564, "o", "        return cmd_poisson(argc - 2, argv + 2);\r\n\u001b[?2004l\r"]
[4142.34762, "o", "\u001b[?2004h> "]
[4142.347763, "o", "    } else if (strcmp(cmd, \"heat\") == 0) {\r\n\u001b[?2004l\r"]
[4142.347819, "o", "\u001b[?2004h> "]
[4142.347975, "o", "        return cmd_heat(argc - 2, argv + 2);\r\n\u001b[?2004l\r"]
[4142.348032, "o", "\u001b[?2004h> "]
[4142.348279, "o", "    } else if (strcmp(cmd, \"--help\") == 0 || strcmp(cmd, \"-h\") == 0) {\r\n\u001b[?2004l\r"]
[4142.348334, "o", "\u001b[?2004h> "]
[4142.348409, "o", "        usage(argv[0]);\r\n\u001b[?2004l\r"]
[4142.348464, "o", "\u001b[?2004h> "]
[4142.348519, "o", "        return 0;\r\n\u001b[?2004l\r"]
[4142.348573, "o", "\u001b[?2004h> "]
[4142.348627, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4142.348682, "o", "> "]
[4142.348893, "o", "        fprintf(stderr, \"Error: unknown command '%s'\\n\", cmd);\r\n\u001b[?2004l\r"]
[4142.348949, "o", "\u001b[?2004h> "]
[4142.349026, "o", "        usage(argv[0]);\r\n\u001b[?2004l\r"]
[4142.349087, "o", "\u001b[?2004h> "]
[4142.349156, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[4142.349231, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4142.349287, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4142.349347, "o", "EOF\r\n\u001b[?2004l\r"]
[4142.352461, "o", "\u001b[?2004hroot@n30009:/app# "]
[4142.455573, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('Makefile')\ns = p.read_text()\ns = s.replace('SRC     = src/main.c src/dense.c src/vector.c src/io.c src/sparse.c src/precond.c src/solvers.c src/poisson.c',\n              'SRC     = src/main.c src/dense.c src/vector.c src/io.c src/sparse.c src/precond.c src/solvers.c src/poisson.c src/heat.c')\np.write_text(s)\nPY\n"]
[4142.455753, "o", "python3 - <<'PY'\r\n"]
[4142.455814, "o", "\u001b[?2004l\r"]
[4142.455914, "o", "\u001b[?2004h"]
[4142.455976, "o", "> "]
