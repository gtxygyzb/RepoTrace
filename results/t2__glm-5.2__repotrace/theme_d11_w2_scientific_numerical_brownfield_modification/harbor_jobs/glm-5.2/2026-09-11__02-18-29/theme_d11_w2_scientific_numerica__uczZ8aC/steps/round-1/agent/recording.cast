[491.927764, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[491.927991, "o", "double *vec_read_mm_array(const char *filename, int *n_out)\r\n\u001b[?2004l\r"]
[491.928078, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[491.928144, "o", "\u001b[?2004h> "]
[491.928218, "o", "    FILE *fp = fopen(filename, \"r\");\r\n\u001b[?2004l\r"]
[491.928282, "o", "\u001b[?2004h> "]
[491.928354, "o", "    if (!fp) return NULL;\r\n\u001b[?2004l\r"]
[491.928418, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[491.928511, "o", "    char line[1024];\r\n\u001b[?2004l\r"]
[491.928576, "o", "\u001b[?2004h> "]
[491.928808, "o", "    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }\r\n\u001b[?2004l\r"]
[491.928884, "o", "\u001b[?2004h> "]
[491.929006, "o", "    int is_array = 0, is_symmetric = 0;\r\n\u001b[?2004l\r"]
[491.929071, "o", "\u001b[?2004h> "]
[491.929333, "o", "    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || !is_array) {\r\n\u001b[?2004l\r"]
[491.929398, "o", "\u001b[?2004h> "]
[491.929486, "o", "        fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[491.929563, "o", "        return NULL;\r\n\u001b[?2004l\r"]
[491.92965, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[491.929721, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[491.929785, "o", "    int rows, cols;\r\n\u001b[?2004l\r"]
[491.929855, "o", "\u001b[?2004h> "]
[491.930166, "o", "    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }\r\n\u001b[?2004l\r"]
[491.930237, "o", "\u001b[?2004h> "]
[491.930507, "o", "    if (sscanf(line, \"%d %d\", &rows, &cols) != 2 || rows <= 0 || cols != 1) {\r\n\u001b[?2004l\r"]
[491.930538, "o", "\u001b[?2004h> "]
[491.930757, "o", "        fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h>         return NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[491.930828, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[491.930911, "o", "\u001b[?2004h> "]
[491.931024, "o", "    double *x = vec_create(rows);\r\n\u001b[?2004l\r"]
[491.93108, "o", "\u001b[?2004h> "]
[491.931214, "o", "    if (!x) { fclose(fp); return NULL; }\r\n\u001b[?2004l\r"]
[491.931269, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[491.931325, "o", "> "]
[491.93138, "o", "    int i = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[491.931673, "o", "    while (i < rows && read_non_comment_line(fp, line, sizeof(line)) == 0) {\r\n\u001b[?2004l\r"]
[491.93173, "o", "\u001b[?2004h> "]
[491.931786, "o", "        double v;\r\n\u001b[?2004l\r"]
[491.931842, "o", "\u001b[?2004h> "]
[491.932133, "o", "        if (sscanf(line, \"%lf\", &v) != 1) { free(x); fclose(fp); return NULL; }\r\n\u001b[?2004l\r"]
[491.93219, "o", "\u001b[?2004h> "]
[491.932247, "o", "        x[i++] = v;\r\n\u001b[?2004l\r"]
[491.932302, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[491.932362, "o", "\u001b[?2004h> "]
[491.932561, "o", "    if (i != rows) { free(x); fclose(fp); return NULL; }\r\n\u001b[?2004l\r"]
[491.932616, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[491.932672, "o", "> "]
[491.932726, "o", "    fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[491.932811, "o", "    *n_out = rows;\r\n\u001b[?2004l\r"]
[491.932866, "o", "\u001b[?2004h> "]
[491.932932, "o", "    return x;\r\n\u001b[?2004l\r\u001b[?2004h"]
[491.932986, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[491.933042, "o", "\u001b[?2004h> "]
