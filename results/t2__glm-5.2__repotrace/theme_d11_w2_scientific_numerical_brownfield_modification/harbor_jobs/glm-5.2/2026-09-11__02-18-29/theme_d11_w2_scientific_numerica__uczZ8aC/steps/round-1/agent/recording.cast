[5782.085685, "o", "#ifndef VECTOR_H\r\n#define VECTOR_H\r\n\r\n#include <stdio.h>\r\n\r\n/* Allocate a zero-initialized vector of length n. Returns NULL on failure. */\r\ndouble *vec_create(int n);\r\n\r\n/* Deep copy: dst[i] = src[i] */\r\nvoid vec_copy(const double *src, double *dst, int n);\r\n\r\n/* Zero out: x[i] = 0 */\r\nvoid vec_zero(double *x, int n);\r\n\r\n/* Scale: x[i] *= a */\r\nvoid vec_scale(double a, double *x, int n);\r\n\r\n/* AXPY: y[i] += a * x[i] */\r\nvoid vec_axpy(double a, const double *x, double *y, int n);\r\n\r\n"]
[5782.085792, "o", "/* Dot product: sum(x[i] * y[i]) */\r\ndouble vec_dot(const double *x, const double *y, int n);\r\n\r\n/* L2 norm: sqrt(sum(x[i]^2)) */\r\ndouble vec_norm2(const double *x, int n);\r\n\r\n/* Print vector to stream, one value per line */\r\nvoid vec_print(const double *x, int n, FILE *out);\r\n\r\n#endif /* VECTOR_H */\r\n"]
