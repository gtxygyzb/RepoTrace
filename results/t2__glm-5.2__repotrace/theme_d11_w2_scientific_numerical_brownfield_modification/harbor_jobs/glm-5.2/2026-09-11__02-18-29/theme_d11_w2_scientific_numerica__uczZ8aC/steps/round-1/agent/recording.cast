[9722.95021, "o", "\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K && r != c) {\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K *A = coo_to_csr(coo);\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint csr_write_mm(const \u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K *A, const char *filename)\r\n"]
[9722.950273, "o", "\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(fp, \"%%\u001b[01;31m\u001b[K%%MatrixMarket\u001b[m\u001b[K matrix coordinate real \u001b[01;31m\u001b[Kgeneral\u001b[m\u001b[K\\n\");\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int is_array = 0, is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K = 0;\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (mm_parse_header(line, &is_array, &is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K) != 0 || !is_array) {\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kread_non_comment_line\u001b[m\u001b[K(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }\r\n"]
[9722.950333, "o", "\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K363\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    while (i < rows && \u001b[01;31m\u001b[Kread_non_comment_line\u001b[m\u001b[K(fp, line, sizeof(line)) == 0) {\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(fp, \"%%\u001b[01;31m\u001b[K%%MatrixMarket\u001b[m\u001b[K matrix array real \u001b[01;31m\u001b[Kgeneral\u001b[m\u001b[K\\n\");\r\n"]
