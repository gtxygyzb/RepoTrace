[4142.229621, "o", "\u001b[?2004h> "]
[4142.22969, "o", "    }\r\n\u001b[?2004l\r"]
[4142.229745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4142.229804, "o", "\u001b[?2004h> "]
