[5601.236034, "o", "\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstatic const char *get_opt(\u001b[m\u001b[Kint argc, char **argv, const char *name)\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstatic int write_history_file(\u001b[m\u001b[Kconst SolveResult *res, const char *filename)\r\n\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstatic void print_solve_summary(\u001b[m\u001b[Kconst SolveResult *res)\r\n\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstatic int validate_ssor_omega(\u001b[m\u001b[Kdouble omega)\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstatic int cmd_dense_solve(\u001b[m\u001b[Kint argc, char **argv)\r\n\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstatic int parse_bc(\u001b[m\u001b[Kconst char *s, PoissonBC *bc)\r\n"]
[5601.236125, "o", "\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstatic int run_solver_and_print(\u001b[m\u001b[Kconst CSRMatrix *A, const double *b,\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstatic int cmd_sparse_solve(\u001b[m\u001b[Kint argc, char **argv)\r\n"]
