[1145.625865, "o", "> "]
[1145.62598, "o", "    double *r = vec_create(n);\r\n\u001b[?2004l\r"]
[1145.626039, "o", "\u001b[?2004h> "]
[1145.62613, "o", "    dm_matvec(A, x, r);\r\n\u001b[?2004l\r"]
[1145.626185, "o", "\u001b[?2004h> "]
[1145.62632, "o", "    vec_axpy(-1.0, b, r, n);\r\n\u001b[?2004l\r"]
[1145.626375, "o", "\u001b[?2004h> "]
