[1498.302518, "o", "   120\t        }\r\n   121\t\r\n   122\t        double a = H[i*m+i];\r\n   123\t        double b = H[(i+1)*m+i];\r\n"]
[1498.302596, "o", "   124\t        if (b == 0.0) {\r\n   125\t            c[i] = 1.0;\r\n   126\t            s[i] = 0.0;\r\n   127\t        } else {\r\n   128\t            double r = hypot(a, b);\r\n   129\t            c[i] = a / r;\r\n   130\t            s[i] = b / r;\r\n   131\t        }\r\n   132\t        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n   133\t        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n   134\t\r\n   135\t        for (int j = i + 1; j < kdim; j++) {\r\n   136\t            apply_givens(&H[i*m+j], &H[(i+1)*m+j], c[i], s[i]);\r\n   137\t        }\r\n"]
[1498.302672, "o", "   138\t    }\r\n   139\t\r\n   140\t    for (int i = kdim - 1; i >= 0; i--) {\r\n   141\t        double sum = g[i];\r\n   142\t        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n   143\t        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n   144\t        y[i] = sum / H[i*m+i];\r\n   145\t    }\r\n   146\t\r\n   147\t    free(c);\r\n   148\t"]
[1498.302737, "o", "    free(s);\r\n   149\t    return 0;\r\n   150\t}\r\n   151\t\r\n   152\tSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n   153\t                         double tol, int maxiter, int m, Precond *P)\r\n   154\t{\r\n   155\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n   156\t    int n = A->rows;\r\n   157\t    if (m <= 0) m = 30;\r\n   158\t    if (maxiter < 0) maxiter = 0;\r\n"]
[1498.302799, "o", "   159\t\r\n   160\t    SolveResult *res = result_create(n, maxiter);\r\n   161\t    if (!res) return NULL;\r\n   162\t\r\n   163\t    double *r = vec_create(n);\r\n   164\t    double *z = vec_create(n);\r\n   165\t    double *Ap = vec_create(n);\r\n   166\t    double *Av = vec_create(n);\r\n   167\t    double *w = vec_create(n);\r\n   168\t    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n"]
[1498.302859, "o", "   169\t    double *y = (double *)malloc(m * sizeof(double));\r\n   170\t    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n   171\t    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n   172\t\r\n   173\t    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n   174\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   175\t        solve_result_destroy(res);\r\n   176\t        return NULL;\r\n   177\t    }\r\n   178\t\r\n"]
[1498.302956, "o", "   179\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n   180\t\r\n   181\t    csr_spmv(A, res->x, Ap);\r\n   182\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   183\t\r\n   184\t    double bnorm = vec_norm2(b, n);\r\n   185\t    if (bnorm == 0.0) bnorm = 1.0;\r\n   186\t\r\n   187\t    res->relres = vec_norm2(r, n) / bnorm;\r\n   188\t    res->history[0] = res->relres;\r\n   189\t    res->history_len = 1;\r\n   190\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n"]
