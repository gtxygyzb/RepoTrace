[2167.632549, "o", "   172\t        solve_result_destroy(res);\r\n   173\t        return NULL;\r\n   174\t    }\r\n   175\t\r\n   176\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n   177\t\r\n   178\t    csr_spmv(A, res->x, Ap);\r\n   179\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   180\t\r\n   181\t"]
[2167.632616, "o", "    double bnorm = vec_norm2(b, n);\r\n   182\t    if (bnorm == 0.0) bnorm = 1.0;\r\n   183\t\r\n   184\t    res->relres = vec_norm2(r, n) / bnorm;\r\n   185\t    res->history[0] = res->relres;\r\n   186\t    res->history_len = 1;\r\n   187\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n   188\t    res->iterations = 0;\r\n   189\t    if (res->converged || maxiter == 0) {\r\n   190\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   191"]
[2167.632678, "o", "\t        return res;\r\n   192\t    }\r\n   193\t\r\n   194\t    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n   195\t        if (precond_apply(P, A, r, z) != 0) break;\r\n   196\t        double beta = vec_norm2(z, n);\r\n   197\t        if (beta == 0.0) break;\r\n   198\t\r\n   199\t        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n   200\t        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n"]
[2167.632743, "o", "   201\t        g[0] = beta;\r\n   202\t        memset(H, 0, (m + 1) * m * sizeof(double));\r\n   203\t\r\n   204\t        int kdim = 0;\r\n   205\t        int fail = 0;\r\n   206\t        for (int j = 0; j < m; j++) {\r\n   207\t            csr_spmv(A, V + j * n, Av);\r\n   208\t            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n"]
[2167.632806, "o", "   209\t\r\n   210\t            for (int i = 0; i <= j; i++) {\r\n   211\t                double h = vec_dot(w, V + i * n, n);\r\n   212\t                H[i*m+j] = h;\r\n   213\t                vec_axpy(-h, V + i * n, w, n);\r\n   214\t            }\r\n   215\t\r\n   216\t            double hnorm = vec_norm2(w, n);\r\n   217\t            H[(j+1)*m+j] = hnorm;\r\n   218\t"]
[2167.632912, "o", "            kdim = j + 1;\r\n   219\t\r\n   220\t            if (hnorm < 1e-14) break;\r\n   221\t\r\n   222\t            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n   223\t        }\r\n"]
[2167.632978, "o", "   224\t        if (fail) break;\r\n   225\t        if (kdim == 0) break;\r\n   226\t\r\n   227\t        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n   228\t        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n   229\t\r\n   230\t        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n   231\t\r\n   232\t        csr_spmv(A, res->x, Ap);\r\n   233\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   234\t\r\n   235\t        res->relres = vec_norm2(r, n) / bnorm;\r\n   236\t        res->history[cycle] = res->relres;\r\n   237\t        res->history_len = cycle + 1;\r\n   238\t        res->iterations = cycle;\r\n   239\t\r\n   240\t        if (res->relres < tol) {\r\n   241\t            res->converged = 1;\r\n"]
[2167.633044, "o", "   242\t            break;\r\n   243\t        }\r\n   244\t    }\r\n   245\t\r\n   246\t    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n"]
[2167.633156, "o", "   247\t    return res;\r\n   248\t}\r\n   249\t\r\n   250\tvoid solve_result_destroy(SolveResult *res)\r\n   251\t{\r\n   252\t    if (!res) return;\r\n   253\t    free(res->x);\r\n   254\t    free(res->history);\r\n   255\t    free(res);\r\n   256\t}\r\n"]
