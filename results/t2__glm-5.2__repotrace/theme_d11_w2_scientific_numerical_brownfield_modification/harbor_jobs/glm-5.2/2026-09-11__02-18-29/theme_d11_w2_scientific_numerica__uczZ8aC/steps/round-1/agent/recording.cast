[12564.786968, "o", "    82\t            if (A->col_indices[k] == i) has_diag[i] = 1;\r\n    83\t        }\r\n    84\t    }\r\n    85\t\r\n    86\t    int missing = 0;\r\n    87\t    for (int i = 0; i < n; i++) {\r\n    88\t        if (!has_diag[i]) missing++;\r\n    89\t    }\r\n    90\t\r\n    91\t"]
