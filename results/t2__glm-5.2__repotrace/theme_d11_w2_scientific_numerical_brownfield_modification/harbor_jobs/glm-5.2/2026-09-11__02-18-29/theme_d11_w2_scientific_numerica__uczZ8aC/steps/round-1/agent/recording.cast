[12865.445908, "o", "\t    if (!m) { fclose(fp); return NULL; }\r\n    19\t\r\n    20\t    int i, j;\r\n    21\t    for (i = 0; i < rows; i++)\r\n    22\t        for (j = 0; j < cols; j++)\r\n    23\t            if (fscanf(fp, \"%lf\", &m->data[i * cols + j]) != 1) {\r\n    24\t                dm_destroy(m);\r\n    25\t                fclose(fp);\r\n    26\t                return NULL;\r\n    27\t            }\r\n    28\t\r\n"]
