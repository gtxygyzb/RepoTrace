[11201.043962, "o", "[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K499\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CSRMatrix *A = csr_read_mm(input);\r\n\u001b[32m\u001b[K500\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!A) {\r\n\u001b[32m\u001b[K501\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fprintf(stderr, \"error: cannot read matrix file\\n\");\r\n\u001b[32m\u001b[K502\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        return 1;\r\n\u001b[32m\u001b[K503\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K504\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K505\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int rows = A->rows;\r\n\u001b[32m\u001b[K506\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int cols = A->cols;\r\n\u001b[32m\u001b[K507\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K508\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int symmetric = 0;\r\n\u001b[32m\u001b[K509\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (rows == cols) {\r\n\u001b[32m\u001b[K510\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        symmetric = 1;\r\n\u001b[32m\u001b[K511\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        for (int i = 0; i < rows && symmetric; i++) {\r\n\u001b[32m\u001b[K512\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            for (int k = A->row_ptr[i]; k < A->row_ptr[i+1] && symmetric; k++) {\r\n\u001b[32m\u001b[K513\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int j = A->col_indices[k];\r\n\u001b[32m\u001b[K514\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                double v = A->values[k];\r\n"]
[11201.044051, "o", "\u001b[32m\u001b[K515\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K516\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int idx = -1;\r\n\u001b[32m\u001b[K517\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                for (int l = A->row_ptr[j]; l < A->row_ptr[j+1]; l++) {\r\n\u001b[32m\u001b[K518\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    if (A->col_indices[l] == i) {\r\n\u001b[32m\u001b[K519\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                        idx = l;\r\n\u001b[32m\u001b[K520\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                        break;\r\n\u001b[32m\u001b[K521\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    }\r\n\u001b[32m\u001b[K522\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                }\r\n\u001b[32m\u001b[K523\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (idx < 0) {\r\n\u001b[32m\u001b[K524\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    symmetric = 0;\r\n\u001b[32m\u001b[K525\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    break;\r\n\u001b[32m\u001b[K526\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                }\r\n\u001b[32m\u001b[K527\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[11201.044141, "o", "\u001b[32m\u001b[K528\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                double vt = A->values[idx];\r\n\u001b[32m\u001b[K529\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                double diff = fabs(v - vt);\r\n\u001b[32m\u001b[K530\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                double denom = fmax(fabs(v), fmax(fabs(vt), 1e-30));\r\n\u001b[32m\u001b[K531\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (diff >= 1e-12 * denom) {\r\n\u001b[32m\u001b[K532\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    symmetric = 0;\r\n\u001b[32m\u001b[K533\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    break;\r\n\u001b[32m\u001b[K534\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                }\r\n\u001b[32m\u001b[K535\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K536\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K537\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K538\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K539\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int bandwidth = 0;\r\n\u001b[32m\u001b[K540\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int nonzero_count = 0;\r\n\u001b[32m\u001b[K541\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    double frobenius_norm = 0.0;\r\n\u001b[32m\u001b[K542\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    double max_abs_value = 0.0;\r\n\u001b[32m\u001b[K543\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    double min_abs_nonzero = 0.0;"]
[11201.044231, "o", "\r\n\u001b[32m\u001b[K544\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K545\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (int i = 0; i < A->rows; i++) {\r\n\u001b[32m\u001b[K546\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n\u001b[32m\u001b[K547\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            int j = A->col_indices[k];\r\n\u001b[32m\u001b[K548\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            double v = A->values[k];\r\n\u001b[32m\u001b[K549\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            double av = fabs(v);\r\n\u001b[32m\u001b[K550\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K551\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            frobenius_norm += v * v;\r\n\u001b[32m\u001b[K552\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K553\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (av > max_abs_value) max_abs_value = av;\r\n\u001b[32m\u001b[K554\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K555\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (av != 0.0) {\r\n\u001b[32m\u001b[K556\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                nonzero_count++;\r\n\u001b[32m\u001b[K557\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K558\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int bw = i - j;\r\n"]
[11201.044314, "o", "\u001b[32m\u001b[K559\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (bw < 0) bw = -bw;\r\n\u001b[32m\u001b[K560\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (bw > bandwidth) bandwidth = bw;\r\n\u001b[32m\u001b[K561\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
