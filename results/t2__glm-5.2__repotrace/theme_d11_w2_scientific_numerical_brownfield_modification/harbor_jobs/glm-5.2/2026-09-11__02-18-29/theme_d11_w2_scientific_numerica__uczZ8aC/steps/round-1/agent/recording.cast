[29.819499, "o", "sed -n '1,220p' Makefile\r\n\u001b[?2004l\r"]
[29.822566, "o", "CC      = gcc\r\nCFLAGS  = -Wall -Wextra -O2 -Iinclude\r\nLDFLAGS = -lm\r\n\r\nSRC     = src/main.c src/dense.c src/vector.c src/io.c\r\nOBJ     = $(SRC:.c=.o)\r\nBIN     = numsim\r\n\r\n.PHONY: all clean\r\n\r\n"]
[29.822648, "o", "all: $(BIN)\r\n\r\n$(BIN): $(SRC)\r\n\t$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)\r\n\r\nclean:\r\n\trm -f $(BIN) $(OBJ)\r\n"]
[29.823121, "o", "\u001b[?2004h"]
[29.823182, "o", "root@n30009:/app# "]
[30.099811, "i", "sed -n '1,260p' src/main.c\n"]
[30.100092, "o", "sed -n '1,260p' src/main.c\r\n\u001b[?2004l\r"]
[30.102907, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include \"dense.h\"\r\n#include \"vector.h\"\r\n#include \"io.h\"\r\n"]
[30.102985, "o", "\r\nstatic void usage(const char *prog)\r\n{\r\n    fprintf(stderr, \"Usage:\\n\");\r\n    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\n\", prog);\r\n    fprintf(stderr, \"\\nSolves Ax = b using dense LU decomposition.\\n\");\r\n}\r\n\r\nstatic int cmd_dense_solve(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"Error: dense-solve requires <matrix_file> <rhs_file>\\n\");\r\n        return 1;\r\n    }\r\n"]
[30.10307, "o", "\r\n    const char *mat_file = argv[0];\r\n    const char *rhs_file = argv[1];\r\n    const char *out_file = (argc >= 3) ? argv[2] : NULL;\r\n\r\n    DenseMatrix *A = dm_read_text(mat_file);\r\n    if (!A) {\r\n"]
[30.103134, "o", "        fprintf(stderr, \"Error: cannot read matrix from '%s'\\n\", mat_file);\r\n        return 1;\r\n    }\r\n\r\n    int n;\r\n    double *b = vec_read_text(rhs_file, &n);\r\n    if (!b) {\r\n        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (A->rows != n || A->cols != n) {\r\n        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n                A->rows, A->cols, n);\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n"]
[30.103176, "o", "\r\n    double *x = vec_create(n);\r\n    if (!x) {\r\n        fprintf(stderr, \"Error: allocation failed\\n\");\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n"]
[30.103273, "o", "\r\n    int rc = dm_solve(A, b, x);\r\n    if (rc != 0) {\r\n        fprintf(stderr, \"Error: solver failed (singular or ill-conditioned)\\n\");\r\n        free(x);\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (out_file) {\r\n        vec_write_text(x, n, out_file);\r\n        printf(\"Solution written to %s\\n\", out_file);\r\n    } else {\r\n        printf(\"Solution:\\n\");\r\n        vec_print(x, n, stdout);\r\n    }\r\n\r\n    /* Compute residual norm */\r\n    double *r = vec_create(n);\r\n    dm_matvec(A, x, r);\r\n    vec_axpy(-1.0, b, r, n);\r\n"]
[30.103343, "o", "    printf(\"Residual norm: %.6e\\n\", vec_norm2(r, n));\r\n\r\n    free(r);\r\n    free(x);\r\n    free(b);\r\n    dm_destroy(A);\r\n    return 0;\r\n}\r\n\r\nint main(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        usage(argv[0]);\r\n        return 1;\r\n    }\r\n\r\n"]
[30.103426, "o", "    const char *cmd = argv[1];\r\n\r\n    if (strcmp(cmd, \"dense-solve\") == 0) {\r\n        return cmd_dense_solve(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"--help\") == 0 || strcmp(cmd, \"-h\") == 0) {\r\n        usage(argv[0]);\r\n        return 0;\r\n    } else {\r\n        fprintf(stderr, \"Error: unknown command '%s'\\n\", cmd);\r\n        usage(argv[0]);\r\n        return 1;\r\n    }\r\n}\r\n"]
[30.103907, "o", "\u001b[?2004hroot@n30009:/app# "]
[36.724643, "i", "sed -n '1,240p' include/dense.h\n"]
[36.724959, "o", "sed -n '1,240p' include/dense.h\r\n"]
[36.724995, "o", "\u001b[?2004l\r"]
[36.72799, "o", "#ifndef DENSE_H\r\n#define DENSE_H\r\n\r\n#include <stdio.h>\r\n\r\n/*\r\n * Dense matrix stored in row-major order.\r\n * Element (i,j) is at data[i * cols + j].\r\n"]
[36.728109, "o", " */\r\ntypedef struct {\r\n    int    rows;\r\n    int    cols;\r\n    double *data;\r\n} DenseMatrix;\r\n\r\n/* Lifecycle */\r\nDenseMatrix *dm_create(int rows, int cols);\r\nvoid         dm_destroy(DenseMatrix *m);\r\n\r\n/* Element access */\r\ndouble dm_get(const DenseMatrix *m, int i, int j);\r\nvoid   dm_set(DenseMatrix *m, int i, int j, double val);\r\n\r\n/* Operations */\r\nvoid dm_matvec(const DenseMatrix *A, const double *x, double *y);\r\n\r\n/*\r\n * Solve Ax = b using LU decomposition with partial pivoting.\r\n * A is not modified (internal copy is made).\r\n * Returns 0 on success, -1 on singular matrix or allocation failure.\r\n */\r\n"]
[36.728204, "o", "int dm_solve(const DenseMatrix *A, const double *b, double *x);\r\n\r\n/* Debug */\r\nvoid dm_print(const DenseMatrix *m, FILE *out);\r\n\r\n#endif /* DENSE_H */\r\n"]
[36.728647, "o", "\u001b[?2004h"]
[36.728709, "o", "root@n30009:/app# "]
[37.010976, "i", "sed -n '1,240p' include/vector.h\n"]
[37.011267, "o", "sed -n '1,240p' include/vector.h\r\n\u001b[?2004l\r"]
[37.014092, "o", "#ifndef VECTOR_H\r\n#define VECTOR_H\r\n\r\n#include <stdio.h>\r\n\r\n/* Allocate a zero-initialized vector of length n. Returns NULL on failure. */\r\ndouble *vec_create(int n);\r\n\r\n/* Deep copy: dst[i] = src[i] */\r\nvoid vec_copy(const double *src, double *dst, int n);\r\n"]
[37.014228, "o", "\r\n/* Zero out: x[i] = 0 */\r\nvoid vec_zero(double *x, int n);\r\n\r\n/* Scale: x[i] *= a */\r\nvoid vec_scale(double a, double *x, int n);\r\n\r\n/* AXPY: y[i] += a * x[i] */\r\nvoid vec_axpy(double a, const double *x, double *y, int n);\r\n\r\n/* Dot product: sum(x[i] * y[i]) */\r\ndouble vec_dot(const double *x, const double *y, int n);\r\n\r\n/* L2 norm: sqrt(sum(x[i]^2)) */\r\ndouble vec_norm2(const double *x, int n);\r\n\r\n/* Print vector to stream, one value per line */\r\nvoid vec_print(const double *x, int n, FILE *out);\r\n\r\n#endif /* VECTOR_H */\r\n"]
[37.014665, "o", "\u001b[?2004h"]
[37.01474, "o", "root@n30009:/app# "]
[37.298766, "i", "sed -n '1,260p' include/io.h\n"]
[37.299068, "o", "sed -n '1,260p' include/io.h\r\n\u001b[?2004l\r"]
[37.301953, "o", "#ifndef IO_H\r\n#define IO_H\r\n\r\n#include \"dense.h\"\r\n\r\n/*\r\n * Read dense matrix from text file.\r\n"]
[37.30207, "o", " * Format:\r\n *   rows cols\r\n *   a00 a01 a02 ...\r\n *   a10 a11 a12 ...\r\n *   ...\r\n * Returns NULL on error.\r\n */\r\nDenseMatrix *dm_read_text(const char *filename);\r\n\r\n/*\r\n * Write dense matrix to text file.\r\n * Returns 0 on success, -1 on error.\r\n */\r\nint dm_write_text(const DenseMatrix *m, const char *filename);\r\n\r\n/*\r\n * Read vector from text file.\r\n * Format:\r\n *   n\r\n *   v0\r\n *   v1\r\n *   ...\r\n * Sets *n_out to the dimension. Returns NULL on error.\r\n */\r\ndouble *vec_read_text(const char *filename, int *n_out);\r\n"]
[37.302142, "o", "\r\n/*\r\n * Write vector to text file.\r\n * Returns 0 on success, -1 on error.\r\n */\r\nint vec_write_text(const double *x, int n, const char *filename);\r\n\r\n#endif /* IO_H */\r\n"]
[37.302607, "o", "\u001b[?2004h"]
[37.302681, "o", "root@n30009:/app# "]
[37.576325, "i", "sed -n '1,320p' src/io.c\n"]
[37.576571, "o", "sed -n '1,320p' src/io.c\r\n\u001b[?2004l\r"]
[37.579517, "o", "#include \"io.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nDenseMatrix *dm_read_text(const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n"]
[37.579654, "o", "    if (!fp) return NULL;\r\n\r\n    int rows, cols;\r\n    if (fscanf(fp, \"%d %d\", &rows, &cols) != 2) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    DenseMatrix *m = dm_create(rows, cols);\r\n    if (!m) { fclose(fp); return NULL; }\r\n\r\n    int i, j;\r\n    for (i = 0; i < rows; i++)\r\n        for (j = 0; j < cols; j++)\r\n            if (fscanf(fp, \"%lf\", &m->data[i * cols + j]) != 1) {\r\n                dm_destroy(m);\r\n                fclose(fp);\r\n                return NULL;\r\n            }\r\n\r\n    fclose(fp);\r\n    return m;\r\n}\r\n\r\nint dm_write_text(const DenseMatrix *m, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    dm_print(m, fp);\r\n    fclose(fp);\r\n    return 0;\r\n"]
[37.579742, "o", "}\r\n\r\ndouble *vec_read_text(const char *filename, int *n_out)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    int n;\r\n    if (fscanf(fp, \"%d\", &n) != 1 || n <= 0) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    double *x = vec_create(n);\r\n    if (!x) { fclose(fp); return NULL; }\r\n\r\n    int i;\r\n    for (i = 0; i < n; i++)\r\n        if (fscanf(fp, \"%lf\", &x[i]) != 1) {\r\n"]
[37.579821, "o", "            free(x);\r\n            fclose(fp);\r\n            return NULL;\r\n        }\r\n\r\n    fclose(fp);\r\n    *n_out = n;\r\n    return x;\r\n}\r\n\r\nint vec_write_text(const double *x, int n, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    fprintf(fp, \"%d\\n\", n);\r\n    vec_print(x, n, fp);\r\n"]
[37.579937, "o", "    fclose(fp);\r\n    return 0;\r\n}\r\n"]
[37.58033, "o", "\u001b[?2004h"]
[37.58039, "o", "root@n30009:/app# "]
[297.193158, "i", "cat > include/sparse.h <<'EOF'\n#ifndef SPARSE_H\n#define SPARSE_H\n\n#include <stdio.h>\n\ntypedef struct {\n    int    rows;\n    int    cols;\n    int    nnz;\n    double *values;\n    int    *col_indices;\n    int    *row_ptr;\n} CSRMatrix;\n\ntypedef struct {\n    int    rows;\n    int    cols;\n    int    nnz;\n    double *values;\n    int    *row;\n    int    *col;\n} COOMatrix;\n\n/* Lifecycle */\nCSRMatrix  *csr_create(int rows, int cols, int nnz);\nvoid        csr_destroy(CSRMatrix *A);\nCOOMatrix  *coo_create(int rows, int cols, int nnz);\nvoid        coo_destroy(COOMatrix *A);\n\n/* Conversions */\nCOOMatrix  *csr_to_coo(const CSRMatrix *A);\nCSRMatrix  *coo_to_csr(const COOMatrix *A);\n\n/* Operations */\nvoid        csr_spmv(const CSRMatrix *A, const double *x, double *y);\nCSRMatrix  *csr_transpose(const CSRMatrix *A);\nint         csr_is_symmetric(const CSRMatrix *A, double tol);\ndouble     *csr_diagonal(const CSRMatrix *A);\n\n/* Matrix Market I/O */\nCSRMatrix  *csr_read_mm(const char *filename);\nint         csr_write_mm(const CSR"]
[297.193465, "i", "Matrix *A, const char *filename);\ndouble     *vec_read_mm_array(const char *filename, int *n_out);\nint         vec_write_mm_array(const double *x, int n, const char *filename);\n\n#endif /* SPARSE_H */\nEOF\n"]
[297.193604, "o", "cat > include/sparse.h <<'EOF'\r\n\u001b[?2004l\rMatrix *A, const char *filename);\r\ndouble     *vec_read_mm_array(const char *filename, int *n_out);\r\nint         vec_write_mm_array(con"]
[297.193697, "o", "st double *x, int n, const char *filename);\r\n\r\n#endif /* SPARSE_H */\r\nEOF\r\n\u001b[?2004h"]
