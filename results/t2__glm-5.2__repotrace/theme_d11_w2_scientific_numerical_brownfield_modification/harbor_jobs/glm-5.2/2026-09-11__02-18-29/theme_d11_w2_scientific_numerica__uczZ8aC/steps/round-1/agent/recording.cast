[7966.983236, "o", "nl -ba src/solvers.c | sed -n '121,280p'\r\n\u001b[?2004l\r"]
[7966.987065, "o", "   121\t    if (!c || !s) { free(c); free(s); return -1; }\r\n   122\t\r\n   123\t    for (int i = 0; i < kdim; i++) {\r\n   124\t        for (int k = 0; k < i; k++) {\r\n   125\t            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n   126\t        }\r\n   127\t\r\n   128\t        double a = H[i*m+i];\r\n   129\t        double b = H[(i+1)*m+i];\r\n   130\t        if (b == 0.0) {\r\n"]
[7966.987207, "o", "   131\t            c[i] = 1.0;\r\n   132\t            s[i] = 0.0;\r\n   133\t        } else {\r\n   134\t            double r = hypot(a, b);\r\n   135\t            c[i] = a / r;\r\n   136\t            s[i] = b / r;\r\n   137\t        }\r\n   138\t        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n   139\t        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n   140\t\r\n   141\t    }\r\n   142\t\r\n   143\t    for (int i = kdim - 1; i >= 0; i--) {\r\n   144\t        double sum = g[i];\r\n   145\t        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n   146\t        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n   147\t        y[i] = sum / H[i*m+i];\r\n   148\t    }\r\n   149\t\r\n   150\t    free(c);\r\n   151\t    free(s);\r\n   152\t    return 0;\r\n   153\t}\r\n   154\t\r\n   155\tSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n   156\t                           double tol, int maxiter, int m, Precond *P)\r\n   157\t{\r\n"]
[7966.987279, "o", "   158\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n   159\t    int n = A->rows;\r\n   160\t    if (m <= 0) m = 30;\r\n   161\t    if (maxiter < 0) maxiter = 0;\r\n   162\t\r\n   163\t    SolveResult *res = result_create(n, maxiter);\r\n   164\t    if (!res) return NULL;\r\n   165\t\r\n   166\t    double *r = vec_create(n);\r\n   167\t    double *z = vec_create(n);\r\n   168\t    double *Ap = vec_create(n);\r\n   169\t    double *Av = vec_create(n);\r\n   170\t"]
[7966.98735, "o", "    double *w = vec_create(n);\r\n   171\t    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n   172\t    double *y = (double *)malloc(m * sizeof(double));\r\n   173\t    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n   174\t    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n   175\t\r\n   176\t    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n   177\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   178\t        solve_result_destroy(res);\r\n   179\t        return NULL;\r\n   180\t    }\r\n   181\t\r\n   182\t"]
[7966.987414, "o", "    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n   183\t\r\n   184\t    csr_spmv(A, res->x, Ap);\r\n   185\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   186\t\r\n   187\t    double bnorm = vec_norm2(b, n);\r\n   188\t    if (bnorm == 0.0) bnorm = 1.0;\r\n   189\t\r\n   190\t    res->true_residual = vec_norm2(r, n);\r\n   191\t    res->relres = res->true_residual / bnorm;\r\n   192\t    res->history[0] = res->relres;\r\n"]
[7966.987478, "o", "   193\t    res->history_len = 1;\r\n   194\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n   195\t    res->iterations = 0;\r\n   196\t    if (res->converged || maxiter == 0) {\r\n   197\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   198\t        return res;\r\n   199\t    }\r\n   200\t\r\n   201\t    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n   202\t        if (precond_apply(P, A, r, z) != 0) break;\r\n   203\t        double beta = vec_norm2(z, n);\r\n"]
[7966.987541, "o", "   204\t        if (beta == 0.0) break;\r\n   205\t\r\n   206\t        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n   207\t        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n   208\t        g[0] = beta;\r\n   209\t        memset(H, 0, (m + 1) * m * sizeof(double));\r\n   210\t\r\n   211\t        int kdim = 0;\r\n   212\t        int fail = 0;\r\n   213\t        for (int j = 0; j < m; j++) {\r\n   214\t            csr_spmv(A, V + j * n, Av);\r\n   215"]
[7966.987605, "o", "\t            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n   216\t\r\n   217\t            for (int i = 0; i <= j; i++) {\r\n   218\t                double h = vec_dot(w, V + i * n, n);\r\n   219\t                H[i*m+j] = h;\r\n   220\t                vec_axpy(-h, V + i * n, w, n);\r\n   221\t            }\r\n   222\t\r\n   223\t            double hnorm = vec_norm2(w, n);\r\n   224\t            H[(j+1)*m+j] = hnorm;\r\n"]
[7966.987667, "o", "   225\t            kdim = j + 1;\r\n   226\t\r\n   227\t            if (hnorm < 1e-14) break;\r\n   228\t\r\n   229\t            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n   230\t        }\r\n   231\t        if (fail) break;\r\n   232\t        if (kdim == 0) break;\r\n   233\t\r\n   234\t        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n"]
[7966.987745, "o", "   235\t        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n   236\t\r\n   237\t        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n   238\t\r\n   239\t        csr_spmv(A, res->x, Ap);\r\n   240\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   241\t\r\n"]
[7966.98781, "o", "   242\t        res->true_residual = vec_norm2(r, n);\r\n   243\t        res->relres = res->true_residual / bnorm;\r\n   244\t        res->history[cycle] = res->relres;\r\n   245\t        res->history_len = cycle + 1;\r\n   246\t        res->iterations = cycle;\r\n   247\t\r\n   248\t        if (res->relres < tol) {\r\n   249\t            res->converged = 1;\r\n   250\t            break;\r\n   251\t        }\r\n   252\t    }\r\n   253\t\r\n   254\t    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   255\t    return res;\r\n   256\t}\r\n"]
[7966.987891, "o", "   257\t\r\n   258\tvoid solve_result_destroy(SolveResult *res)\r\n   259\t{\r\n   260\t    if (!res) return;\r\n   261\t    free(res->x);\r\n   262\t    free(res->history);\r\n   263\t    free(res);\r\n   264\t}\r\n"]
