[6056.590383, "o", "\u001b[?2004h> "]
[6056.590659, "o", "    double hx = (x1 - x0) / (nx - 1);\r\n\u001b[?2004l\r"]
[6056.590722, "o", "\u001b[?2004h> "]
[6056.590985, "o", "    double hy = (y1 - y0) / (ny - 1);\r\n\u001b[?2004l\r"]
[6056.591043, "o", "\u001b[?2004h> "]
[6056.591223, "o", "    double hx2 = hx * hx;\r\n\u001b[?2004l\r"]
[6056.59128, "o", "\u001b[?2004h> "]
[6056.591456, "o", "    double hy2 = hy * hy;\r\n\u001b[?2004l\r"]
[6056.591522, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6056.591578, "o", "\u001b[?2004h> "]
[6056.591984, "o", "    double *f = poisson_read_source(source_file, nx, ny);\r\n\u001b[?2004l\r"]
[6056.592041, "o", "\u001b[?2004h> "]
[6056.592202, "o", "    if (!f) return -1;\r\n\u001b[?2004l\r"]
[6056.59226, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6056.592326, "o", "\u001b[?2004h> "]
[6056.592535, "o", "    double *left_vals = NULL;\r\n\u001b[?2004l\r"]
[6056.592601, "o", "\u001b[?2004h> "]
[6056.592812, "o", "    double *right_vals = NULL;\r\n\u001b[?2004l\r"]
[6056.592879, "o", "\u001b[?2004h> "]
[6056.593108, "o", "    double *bottom_vals = NULL;\r\n\u001b[?2004l\r"]
[6056.593164, "o", "\u001b[?2004h> "]
[6056.593357, "o", "    double *top_vals = NULL;\r\n\u001b[?2004l\r"]
[6056.593417, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6056.593472, "o", "\u001b[?2004h> "]
[6056.593758, "o", "    if (left.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[6056.593813, "o", "\u001b[?2004h> "]
[6056.594215, "o", "        left_vals = poisson_read_boundary(left.file, ny);\r\n\u001b[?2004l\r"]
[6056.594271, "o", "\u001b[?2004h> "]
[6056.594521, "o", "        if (!left_vals) goto fail;\r\n\u001b[?2004l\r"]
[6056.594578, "o", "\u001b[?2004h> "]
[6056.59464, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[6056.594696, "o", "> "]
[6056.594967, "o", "    if (right.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[6056.595024, "o", "\u001b[?2004h> "]
[6056.595424, "o", "        right_vals = poisson_read_boundary(right.file, ny);\r\n\u001b[?2004l\r"]
[6056.59548, "o", "\u001b[?2004h> "]
[6056.5957, "o", "        if (!right_vals) goto fail;\r\n\u001b[?2004l\r"]
[6056.595757, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[6056.595822, "o", "\u001b[?2004h> "]
[6056.596054, "o", "    if (bottom.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[6056.596111, "o", "\u001b[?2004h> "]
[6056.59643, "o", "        bottom_vals = poisson_read_boundary(bottom.file, nx);\r\n\u001b[?2004l\r"]
[6056.596486, "o", "\u001b[?2004h> "]
[6056.596667, "o", "        if (!bottom_vals) goto fail;\r\n\u001b[?2004l\r"]
[6056.596725, "o", "\u001b[?2004h> "]
[6056.596784, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6056.597008, "o", "    if (top.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[6056.597065, "o", "\u001b[?2004h> "]
[6056.597341, "o", "        top_vals = poisson_read_boundary(top.file, nx);\r\n\u001b[?2004l\r"]
[6056.597399, "o", "\u001b[?2004h> "]
[6056.597581, "o", "        if (!top_vals) goto fail;\r\n\u001b[?2004l\r"]
[6056.597638, "o", "\u001b[?2004h>     }"]
[6056.597695, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6056.597751, "o", "\u001b[?2004h> "]
[6056.597984, "o", "    if (left.type == POISSON_DIRICHLET) {\r\n\u001b[?2004l\r"]
[6056.598041, "o", "\u001b[?2004h> "]
[6056.598324, "o", "        left_vals = poisson_read_boundary(left.file, ny);\r\n\u001b[?2004l\r"]
[6056.598381, "o", "\u001b[?2004h> "]
[6056.598551, "o", "        if (!left_vals) goto fail;\r\n\u001b[?2004l\r"]
[6056.598607, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[6056.598673, "o", "\u001b[?2004h> "]
[6056.598902, "o", "    if (right.type == POISSON_DIRICHLET) {\r\n\u001b[?2004l\r"]
[6056.598961, "o", "\u001b[?2004h> "]
[6056.599267, "o", "        right_vals = poisson_read_boundary(right.file, ny);\r\n\u001b[?2004l\r"]
[6056.599324, "o", "\u001b[?2004h> "]
[6056.599499, "o", "        if (!right_vals) goto fail;\r\n\u001b[?2004l\r"]
[6056.599557, "o", "\u001b[?2004h>     }\r\n"]
[6056.599613, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[6056.59989, "o", "    if (bottom.type == POISSON_DIRICHLET) {\r\n\u001b[?2004l\r"]
[6056.599948, "o", "\u001b[?2004h> "]
[6056.600252, "o", "        bottom_vals = poisson_read_boundary(bottom.file, nx);\r\n\u001b[?2004l\r"]
[6056.60031, "o", "\u001b[?2004h> "]
[6056.600483, "o", "        if (!bottom_vals) goto fail;\r\n\u001b[?2004l\r"]
[6056.600541, "o", "\u001b[?2004h> "]
[6056.600598, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6056.600829, "o", "    if (top.type == POISSON_DIRICHLET) {\r\n\u001b[?2004l\r"]
[6056.600896, "o", "\u001b[?2004h> "]
[6056.601185, "o", "        top_vals = poisson_read_boundary(top.file, nx);\r\n\u001b[?2004l\r"]
[6056.60124, "o", "\u001b[?2004h> "]
[6056.60141, "o", "        if (!top_vals) goto fail;\r\n\u001b[?2004l\r"]
[6056.601466, "o", "\u001b[?2004h>     }\r\n"]
[6056.601521, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6056.601576, "o", "\u001b[?2004h> "]
[6056.60169, "o", "    int n = nx * ny;\r\n\u001b[?2004l\r"]
[6056.62048, "o", "\u001b[?2004h>     COOMatrix *coo = coo_create(n, n, 5 * n);\r\n\u001b[?2004l\r\u001b[?2004h>     double *b = vec_create(n);\r\n\u001b[?2004l\r\u001b[?2004h>     if (!coo || !b) {\r\n\u001b[?2004l\r\u001b[?2004h>         coo_destroy(coo);\r\n\u001b[?2004l\r\u001b[?2004h>         free(b);\r\n\u001b[?2004l\r\u001b[?2004h>         goto fail;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     int k = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = 0; i < nx; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         for (int j = 0; j < ny; j++) {\r\n\u001b[?2004l\r\u001b[?2004h>             int idx = i * ny + j;\r\n\u001b[?2004l\r\u001b[?2004h>             int is_left = (i == 0);\r\n\u001b[?2004l\r\u001b[?2004h>             int is_right = (i == nx - 1);\r\n\u001b[?2004l\r\u001b[?2004h>             int is_bottom = (j == 0);\r\n\u001b[?2004l\r\u001b[?2004h>             int is_top = (j == ny - 1);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[6056.620548, "o", "> "]
[6056.620829, "o", "            if (is_left && left.type == POISSON_DIRICHLET) {\r\n\u001b[?2004l\r"]
[6056.620858, "o", "\u001b[?2004h> "]
[6056.621153, "o", "                add_coo(coo, &k, idx, idx, 1.0);\r\n\u001b[?2004l\r"]
[6056.621211, "o", "\u001b[?2004h> "]
[6056.621424, "o", "                b[idx] = left_vals[j];\r\n\u001b[?2004l\r"]
[6056.621482, "o", "\u001b[?2004h> "]
[6056.621617, "o", "                continue;\r\n\u001b[?2004l\r"]
[6056.621674, "o", "\u001b[?2004h> "]
[6056.621741, "o", "            }\r\n\u001b[?2004l\r"]
[6056.621799, "o", "\u001b[?2004h> "]
[6056.622139, "o", "            if (is_right && right.type == POISSON_DIRICHLET) {\r\n\u001b[?2004l\r"]
[6056.622196, "o", "\u001b[?2004h> "]
[6056.622463, "o", "                add_coo(coo, &k, idx, idx, 1.0);\r\n\u001b[?2004l\r"]
[6056.622519, "o", "\u001b[?2004h> "]
[6056.622713, "o", "                b[idx] = right_vals[j];\r\n\u001b[?2004l\r"]
[6056.62277, "o", "\u001b[?2004h> "]
[6056.622859, "o", "                continue;\r\n\u001b[?2004l\r"]
[6056.622923, "o", "\u001b[?2004h> "]
[6056.622991, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6056.623275, "o", "            if (is_bottom && bottom.type == POISSON_DIRICHLET) {\r\n\u001b[?2004l\r"]
[6056.623332, "o", "\u001b[?2004h> "]
[6056.623512, "o", "                add_coo(coo, &k, idx, idx, 1.0);\r\n\u001b[?2004l\r"]
[6056.623568, "o", "\u001b[?2004h> "]
[6056.623722, "o", "                b[idx] = bottom_vals[i];\r\n\u001b[?2004l\r"]
[6056.623776, "o", "\u001b[?2004h> "]
[6056.623878, "o", "                continue;\r\n\u001b[?2004l\r"]
[6056.623935, "o", "\u001b[?2004h> "]
[6056.624, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[6056.624056, "o", "> "]
[6056.62426, "o", "            if (is_top && top.type == POISSON_DIRICHLET) {\r\n\u001b[?2004l\r"]
[6056.624316, "o", "\u001b[?2004h> "]
[6056.624502, "o", "                add_coo(coo, &k, idx, idx, 1.0);\r\n\u001b[?2004l\r"]
[6056.624556, "o", "\u001b[?2004h> "]
[6056.624699, "o", "                b[idx] = top_vals[i];\r\n\u001b[?2004l\r"]
[6056.624753, "o", "\u001b[?2004h> "]
[6056.624848, "o", "                continue;\r\n\u001b[?2004l\r"]
[6056.624911, "o", "\u001b[?2004h> "]
[6056.624978, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[6056.625034, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[6056.625166, "o", "            double diag = 0.0;\r\n\u001b[?2004l\r"]
[6056.625221, "o", "\u001b[?2004h> "]
[6056.625343, "o", "            double rhs = f[idx];\r\n\u001b[?2004l\r"]
[6056.625399, "o", "\u001b[?2004h> "]
[6056.625656, "o", "            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;\r\n\u001b[?2004l\r"]
[6056.62571, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[6056.625765, "o", "> "]
[6056.625957, "o", "            /* Diffusion: -kappa * laplacian(u) */\r\n\u001b[?2004l\r"]
[6056.626018, "o", "\u001b[?2004h> "]
[6056.626239, "o", "            if (is_left && left.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[6056.626301, "o", "\u001b[?2004h> "]
[6056.626456, "o", "                diag += 2.0 * kappa / hx2;\r\n\u001b[?2004l\r"]
[6056.62651, "o", "\u001b[?2004h> "]
[6056.626683, "o", "                c_ip += -2.0 * kappa / hx2;\r\n\u001b[?2004l\r"]
[6056.626737, "o", "\u001b[?2004h> "]
[6056.626961, "o", "                rhs += 2.0 * kappa * left_vals[j] / hx;\r\n\u001b[?2004l\r"]
[6056.627017, "o", "\u001b[?2004h> "]
[6056.627277, "o", "            } else if (is_right && right.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[6056.627333, "o", "\u001b[?2004h> "]
[6056.627496, "o", "                diag += 2.0 * kappa / hx2;\r\n\u001b[?2004l\r"]
[6056.62755, "o", "\u001b[?2004h> "]
[6056.627716, "o", "                c_im += -2.0 * kappa / hx2;\r\n\u001b[?2004l\r"]
[6056.62777, "o", "\u001b[?2004h> "]
[6056.627997, "o", "                rhs += 2.0 * kappa * right_vals[j] / hx;\r\n\u001b[?2004l\r"]
[6056.628054, "o", "\u001b[?2004h> "]
[6056.628278, "o", "            } else if (!is_left && !is_right) {\r\n\u001b[?2004l\r"]
[6056.628336, "o", "\u001b[?2004h> "]
[6056.628543, "o", "                diag += 2.0 * kappa / hx2;\r\n\u001b[?2004l\r"]
[6056.628598, "o", "\u001b[?2004h> "]
[6056.628781, "o", "                c_im += -kappa / hx2;\r\n\u001b[?2004l\r"]
[6056.628843, "o", "\u001b[?2004h> "]
[6056.629028, "o", "                c_ip += -kappa / hx2;\r\n\u001b[?2004l\r"]
[6056.629087, "o", "\u001b[?2004h> "]
[6056.629153, "o", "            }\r\n\u001b[?2004l\r"]
[6056.629212, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6056.629267, "o", "\u001b[?2004h> "]
[6056.629567, "o", "            if (is_bottom && bottom.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[6056.629632, "o", "\u001b[?2004h> "]
[6056.62983, "o", "                diag += 2.0 * kappa / hy2;\r\n\u001b[?2004l\r"]
[6056.629898, "o", "\u001b[?2004h> "]
[6056.630107, "o", "                c_jp += -2.0 * kappa / hy2;\r\n\u001b[?2004l\r"]
[6056.630162, "o", "\u001b[?2004h> "]
[6056.630444, "o", "                rhs += 2.0 * kappa * bottom_vals[i] / hy;\r\n\u001b[?2004l\r"]
[6056.630499, "o", "\u001b[?2004h> "]
[6056.63081, "o", "            } else if (is_top && top.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[6056.630865, "o", "\u001b[?2004h> "]
[6056.631082, "o", "                diag += 2.0 * kappa / hy2;\r\n\u001b[?2004l\r"]
[6056.631138, "o", "\u001b[?2004h> "]
[6056.631351, "o", "                c_jm += -2.0 * kappa / hy2;\r\n\u001b[?2004l\r"]
[6056.631406, "o", "\u001b[?2004h> "]
[6056.631674, "o", "                rhs += 2.0 * kappa * top_vals[i] / hy;\r\n\u001b[?2004l\r"]
[6056.631732, "o", "\u001b[?2004h> "]
[6056.631969, "o", "            } else if (!is_bottom && !is_top) {\r\n\u001b[?2004l\r"]
[6056.632025, "o", "\u001b[?2004h> "]
[6056.632234, "o", "                diag += 2.0 * kappa / hy2;\r\n\u001b[?2004l\r"]
[6056.632289, "o", "\u001b[?2004h> "]
[6056.632471, "o", "                c_jm += -kappa / hy2;\r\n\u001b[?2004l\r"]
[6056.632526, "o", "\u001b[?2004h> "]
[6056.63271, "o", "                c_jp += -kappa / hy2;\r\n\u001b[?2004l\r"]
[6056.632765, "o", "\u001b[?2004h> "]
[6056.632831, "o", "            }\r\n\u001b[?2004l\r"]
[6056.632894, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6056.63295, "o", "\u001b[?2004h> "]
[6056.633183, "o", "            /* Convection: first-order upwind */\r\n\u001b[?2004l\r"]
[6056.633238, "o", "\u001b[?2004h> "]
[6056.633374, "o", "            if (vx > 0.0) {\r\n\u001b[?2004l\r"]
[6056.63343, "o", "\u001b[?2004h> "]
[6056.633735, "o", "                if (is_left && left.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[6056.63379, "o", "\u001b[?2004h> "]
[6056.633978, "o", "                    diag += vx / hx;\r\n\u001b[?2004l\r"]
[6056.634033, "o", "\u001b[?2004h> "]
[6056.634217, "o", "                    c_ip += -vx / hx;\r\n\u001b[?2004l\r"]
[6056.634271, "o", "\u001b[?2004h> "]
[6056.634524, "o", "                    rhs += 2.0 * vx * left_vals[j];\r\n\u001b[?2004l\r"]
[6056.63458, "o", "\u001b[?2004h> "]
[6056.6347, "o", "                } else {\r\n\u001b[?2004l\r"]
[6056.63476, "o", "\u001b[?2004h> "]
[6056.634943, "o", "                    diag += vx / hx;\r\n\u001b[?2004l\r"]
[6056.635, "o", "\u001b[?2004h> "]
[6056.635236, "o", "                    if (i > 0) c_im += -vx / hx;\r\n\u001b[?2004l\r"]
[6056.635291, "o", "\u001b[?2004h> "]
[6056.635377, "o", "                }\r\n\u001b[?2004l\r"]
[6056.635432, "o", "\u001b[?2004h> "]
[6056.635602, "o", "            } else if (vx < 0.0) {\r\n\u001b[?2004l\r"]
[6056.635657, "o", "\u001b[?2004h> "]
[6056.635982, "o", "                if (is_right && right.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[6056.636038, "o", "\u001b[?2004h> "]
[6056.636221, "o", "                    diag += -vx / hx;\r\n\u001b[?2004l\r"]
[6056.636277, "o", "\u001b[?2004h> "]
[6056.636455, "o", "                    c_im += vx / hx;\r\n\u001b[?2004l\r"]
[6056.636511, "o", "\u001b[?2004h> "]
[6056.636776, "o", "                    rhs += -2.0 * vx * right_vals[j];\r\n\u001b[?2004l\r"]
[6056.636831, "o", "\u001b[?2004h> "]
[6056.636956, "o", "                } else {\r\n\u001b[?2004l\r"]
[6056.637011, "o", "\u001b[?2004h> "]
[6056.637196, "o", "                    diag += -vx / hx;\r\n\u001b[?2004l\r"]
[6056.637251, "o", "\u001b[?2004h> "]
[6056.637507, "o", "                    if (i < nx - 1) c_ip += vx / hx;\r\n\u001b[?2004l\r"]
[6056.637562, "o", "\u001b[?2004h> "]
[6056.637622, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[6056.637682, "o", "> "]
[6056.637741, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6056.637802, "o", "\u001b[?2004h> "]
[6056.637877, "o", "            if (vy > 0.0) {\r\n\u001b[?2004l\r"]
[6056.637937, "o", "\u001b[?2004h> "]
[6056.63814, "o", "                if (is_bottom && bottom.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[6056.638195, "o", "\u001b[?2004h> "]
