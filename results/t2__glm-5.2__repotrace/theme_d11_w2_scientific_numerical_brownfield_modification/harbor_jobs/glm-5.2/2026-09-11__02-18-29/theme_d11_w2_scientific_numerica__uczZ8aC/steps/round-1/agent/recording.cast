[1145.649287, "o", "\u001b[?2004h> "]
[1145.649472, "o", "    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.649626, "o", "        fprintf(stderr, \"Error: invalid poisson parameters\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.649689, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.649747, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.649857, "o", "    PoissonBC left, right, bottom, top;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.650048, "o", "    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.650237, "o", "        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.650444, "o", "        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.650507, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
