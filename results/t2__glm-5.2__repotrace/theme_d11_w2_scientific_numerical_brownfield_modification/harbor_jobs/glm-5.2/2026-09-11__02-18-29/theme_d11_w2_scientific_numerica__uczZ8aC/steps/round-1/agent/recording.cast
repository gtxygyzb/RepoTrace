[1145.642422, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.642503, "o", "    CSRMatrix *A = csr_read_mm(input);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.642557, "o", "    if (!A) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
