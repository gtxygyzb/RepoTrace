[12482.712828, "o", "sed -n '1,260p' include/solvers.h && sed -n '1,340p' src/solvers.c\r\n\u001b[?2004l\r"]
[12482.715739, "o", "#ifndef SOLVERS_H\r\n#define SOLVERS_H\r\n\r\n#include \"sparse.h\"\r\n#include \"precond.h\"\r\n\r\ntypedef struct {\r\n    double *x;\r\n"]
[12482.715829, "o", "    double relres;          /* true relative residual ||b-A*x||/||b|| */\r\n    double true_residual;   /* absolute true residual norm ||b-A*x|| */\r\n    double relres_inf;      /* reported relative residual ||b-A*x||_inf / ||b||_inf */\r\n    double true_residual_inf; /* reported absolute residual ||b-A*x||_inf */\r\n    int iterations;\r\n    int converged;\r\n    double *history;        /* true relative residual at each iteration */\r\n    double *precond_history; /* preconditioned residual norm ||M^-1 r|| at each iteration */\r\n    int history_len;        /* number of stored history entries */\r\n} SolveResult;\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P);\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                           double tol, int maxiter, int m, Precond *P);\r\n\r\nvoid solve_result_destroy(SolveResult *res);\r\n"]
[12482.715891, "o", "\r\n#endif /* SOLVERS_H */\r\n"]
[12482.718955, "o", "#include \"solvers.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <math.h>\r\n#include <string.h>\r\n\r\n"]
[12482.71904, "o", "static SolveResult *result_create(int n, int maxiter)\r\n{\r\n    if (maxiter < 0) maxiter = 0;\r\n    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    if (!res) return NULL;\r\n\r\n    res->x = vec_create(n);\r\n    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    res->precond_history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    if (!res->x || !res->history || !res->precond_history) {\r\n        free(res->x);\r\n        free(res->history);\r\n        free(res->precond_history);\r\n        free(res);\r\n        return NULL;\r\n    }\r\n    res->history_len = 0;\r\n    return res;\r\n}\r\n\r\n"]
[12482.719127, "o", "SolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *p = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    if (!r || !z || !p || !Ap) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n"]
[12482.719207, "o", "\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n    double bnorm_inf = vec_norm_inf(b, n);\r\n    if (bnorm_inf == 0.0) bnorm_inf = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    res->true_residual_inf = vec_norm_inf(r, n);\r\n    res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n    precond_apply(P, A, r, z);\r\n    double pnorm0 = vec_norm2(z, n);\r\n"]
[12482.719291, "o", "    res->history[0] = res->relres;\r\n    res->precond_history[0] = pnorm0;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n\r\n    if (precond_apply(P, A, r, z) != 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n    vec_copy(z, p, n);\r\n    double rz_old = vec_dot(r, z, n);\r\n\r\n    for (int iter = 1; iter <= maxiter; iter++) {\r\n"]
[12482.719386, "o", "        csr_spmv(A, p, Ap);\r\n        double pAp = vec_dot(p, Ap, n);\r\n        if (fabs(pAp) < 1e-30) break;\r\n\r\n        double alpha = rz_old / pAp;\r\n        vec_axpy(alpha, p, res->x, n);\r\n        vec_axpy(-alpha, Ap, r, n);\r\n\r\n        /* Recompute the true residual rather than relying on the recurrence. */\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n        res->relres = res->true_residual / bnorm;\r\n        res->true_residual_inf = vec_norm_inf(r, n);\r\n        res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n        precond_apply(P, A, r, z);\r\n        double pznorm = vec_norm2(z, n);\r\n        res->history[iter] = res->relres;\r\n"]
[12482.719455, "o", "        res->precond_history[iter] = pznorm;\r\n        res->history_len = iter + 1;\r\n        res->iterations = iter;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double rz_new = vec_dot(r, z, n);\r\n        if (fabs(rz_old) < 1e-30) break;\r\n        double beta = rz_new / rz_old;\r\n        vec_scale(beta, p, n);\r\n        vec_axpy(1.0, z, p, n);\r\n"]
[12482.719534, "o", "        rz_old = rz_new;\r\n    }\r\n\r\n    free(r); free(z); free(p); free(Ap);\r\n    return res;\r\n}\r\n\r\nstatic void apply_givens(double *a, double *b, double c, double s)\r\n{\r\n    double t = c * (*a) + s * (*b);\r\n    *b = -s * (*a) + c * (*b);\r\n    *a = t;\r\n}\r\n\r\nstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n{\r\n    if (kdim <= 0) return -1;\r\n"]
[12482.719616, "o", "\r\n    double *c = (double *)malloc(m * sizeof(double));\r\n    double *s = (double *)malloc(m * sizeof(double));\r\n    if (!c || !s) { free(c); free(s); return -1; }\r\n\r\n    for (int i = 0; i < kdim; i++) {\r\n        for (int k = 0; k < i; k++) {\r\n            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n        }\r\n\r\n        double a = H[i*m+i];\r\n        double b = H[(i+1)*m+i];\r\n        if (b == 0.0) {\r\n            c[i] = 1.0;\r\n            s[i] = 0.0;\r\n        } else {\r\n            double r = hypot(a, b);\r\n            c[i] = a / r;\r\n            s[i] = b / r;\r\n"]
[12482.719705, "o", "        }\r\n        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n\r\n    }\r\n\r\n    for (int i = kdim - 1; i >= 0; i--) {\r\n        double sum = g[i];\r\n        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n        y[i] = sum / H[i*m+i];\r\n    }\r\n\r\n    free(c);\r\n    free(s);\r\n    return 0;\r\n}\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n"]
[12482.71978, "o", "                           double tol, int maxiter, int m, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (m <= 0) m = 30;\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    double *Av = vec_create(n);\r\n    double *w = vec_create(n);\r\n    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n"]
[12482.71985, "o", "    double *y = (double *)malloc(m * sizeof(double));\r\n    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n\r\n    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n"]
[12482.719951, "o", "\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n    double bnorm_inf = vec_norm_inf(b, n);\r\n    if (bnorm_inf == 0.0) bnorm_inf = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    res->true_residual_inf = vec_norm_inf(r, n);\r\n    res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n    precond_apply(P, A, r, z);\r\n    double pnorm0 = vec_norm2(z, n);\r\n    res->history[0] = res->relres;\r\n    res->precond_history[0] = pnorm0;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n"]
[12482.720026, "o", "        return res;\r\n    }\r\n\r\n    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double beta = vec_norm2(z, n);\r\n        if (beta == 0.0) break;\r\n\r\n        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n        g[0] = beta;\r\n        memset(H, 0, (m + 1) * m * sizeof(double));\r\n\r\n        int kdim = 0;\r\n        int fail = 0;\r\n        for (int j = 0; j < m; j++) {\r\n            csr_spmv(A, V + j * n, Av);\r\n            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n"]
[12482.720109, "o", "\r\n            for (int i = 0; i <= j; i++) {\r\n                double h = vec_dot(w, V + i * n, n);\r\n                H[i*m+j] = h;\r\n                vec_axpy(-h, V + i * n, w, n);\r\n            }\r\n\r\n            double hnorm = vec_norm2(w, n);\r\n            H[(j+1)*m+j] = hnorm;\r\n            kdim = j + 1;\r\n\r\n            if (hnorm < 1e-14) break;\r\n\r\n            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n        }\r\n        if (fail) break;\r\n"]
[12482.72019, "o", "        if (kdim == 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n        res->relres = res->true_residual / bnorm;\r\n        res->true_residual_inf = vec_norm_inf(r, n);\r\n"]
[12482.720271, "o", "        res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n        precond_apply(P, A, r, z);\r\n        double pznorm = vec_norm2(z, n);\r\n        res->history[cycle] = res->relres;\r\n        res->precond_history[cycle] = pznorm;\r\n        res->history_len = cycle + 1;\r\n        res->iterations = cycle;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n    }\r\n\r\n    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n    return res;\r\n}\r\n\r\nvoid solve_result_destroy(SolveResult *res)\r\n"]
[12482.720338, "o", "{\r\n    if (!res) return;\r\n    free(res->x);\r\n    free(res->history);\r\n    free(res->precond_history);\r\n    free(res);\r\n}\r\n"]
[12482.720819, "o", "\u001b[?2004h"]
[12482.720911, "o", "root@n30009:/app# "]
[12482.966845, "i", "sed -n '1,380p' src/eigen.c && sed -n '1,220p' include/eigen.h\n"]
[12482.967339, "o", "sed -n '1,380p' src/eigen.c && sed -n '1,220p' include/eigen.h\r\n\u001b[?2004l\r"]
[12482.970354, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n#include \"sparse.h\"\r\n"]
[12482.970441, "o", "#include \"vector.h\"\r\n#include \"precond.h\"\r\n#include \"solvers.h\"\r\n#include \"eigen.h\"\r\n\r\nstatic const char *get_opt(int argc, char **argv, const char *name)\r\n{\r\n    for (int i = 0; i < argc - 1; i++) {\r\n        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    }\r\n    return NULL;\r\n}\r\n\r\n"]
[12482.970485, "o", "static int parse_int(const char *s, int *out)\r\n{\r\n    char *end;\r\n    long v = strtol(s, &end, 10);\r\n    if (end == s || *end != '\\0' || v < 1) return -1;\r\n    *out = (int)v;\r\n    return 0;\r\n}\r\n\r\n"]
[12482.970581, "o", "static int parse_double(const char *s, double *out)\r\n{\r\n    char *end;\r\n    double v = strtod(s, &end);\r\n    if (end == s) return -1;\r\n    *out = v;\r\n    return 0;\r\n}\r\n\r\nstatic void init_random_vector(double *v, int n)\r\n{\r\n    srand(42);\r\n    for (int i = 0; i < n; i++) v[i] = (double)rand() / (double)RAND_MAX;\r\n"]
[12482.970658, "o", "    double nrm = vec_norm2(v, n);\r\n    if (nrm > 0.0) {\r\n        for (int i = 0; i < n; i++) v[i] /= nrm;\r\n    } else {\r\n        v[0] = 1.0;\r\n"]
[12482.970725, "o", "    }\r\n}\r\n\r\nstatic SolveResult *solve_linear_system(const CSRMatrix *A, const double *b,\r\n                                       const char *solver, const char *precond,\r\n                                       double tol, int maxiter, int restart,\r\n                                       double omega, int *fail)\r\n{\r\n    Precond *P = precond_create(A, precond, omega);\r\n    if (!P) {\r\n        *fail = 1;\r\n        return NULL;\r\n    }\r\n\r\n    SolveResult *res = NULL;\r\n    if (strcmp(solver, \"cg\") == 0) {\r\n        res = cg_solve(A, b, NULL, tol, maxiter, P);\r\n    } else if (strcmp(solver, \"gmres\") == 0) {\r\n        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);\r\n"]
[12482.970798, "o", "    } else {\r\n        *fail = 2;\r\n    }\r\n\r\n    precond_destroy(P);\r\n    if (!res) *fail = 1;\r\n    return res;\r\n}\r\n\r\n"]
[12482.970842, "o", "static CSRMatrix *make_shifted_matrix(const CSRMatrix *A, double sigma)\r\n{\r\n    int n = A->rows;\r\n    int *has_diag = (int *)calloc(n, sizeof(int));\r\n    if (!has_diag) return NULL;\r\n\r\n    for (int i = 0; i < n; i++) {\r\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n            if (A->col_indices[k] == i) has_diag[i] = 1;\r\n        }\r\n    }\r\n\r\n    int missing = 0;\r\n    for (int i = 0; i < n; i++) {\r\n"]
[12482.970958, "o", "        if (!has_diag[i]) missing++;\r\n    }\r\n\r\n    COOMatrix *coo = coo_create(n, n, A->nnz + missing);\r\n    if (!coo) { free(has_diag); return NULL; }\r\n\r\n    int idx = 0;\r\n    for (int i = 0; i < n; i++) {\r\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n            coo->row[idx] = i;\r\n            coo->col[idx] = A->col_indices[k];\r\n            coo->values[idx] = A->values[k];\r\n            if (A->col_indices[k] == i) coo->values[idx] -= sigma;\r\n"]
[12482.971033, "o", "            idx++;\r\n        }\r\n    }\r\n    for (int i = 0; i < n; i++) {\r\n        if (!has_diag[i]) {\r\n            coo->row[idx] = i;\r\n            coo->col[idx] = i;\r\n            coo->values[idx] = -sigma;\r\n"]
[12482.971106, "o", "            idx++;\r\n        }\r\n    }\r\n\r\n    CSRMatrix *S = coo_to_csr(coo);\r\n    coo_destroy(coo);\r\n    free(has_diag);\r\n    return S;\r\n}\r\n\r\nint cmd_eigenvalue(int argc, char **argv)\r\n{\r\n    const char *input = get_opt(argc, argv, \"--input\");\r\n    const char *method_s = get_opt(argc, argv, \"--method\");\r\n    const char *shift_s = get_opt(argc, argv, \"--shift\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n"]
[12482.971178, "o", "    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *solver_tol_s = get_opt(argc, argv, \"--solver-tol\");\r\n    const char *solver_maxiter_s = get_opt(argc, argv, \"--solver-maxiter\");\r\n"]
[12482.971253, "o", "    const char *eigvec_output = get_opt(argc, argv, \"--eigvec-output\");\r\n\r\n    if (!input || !method_s || !tol_s || !maxiter_s || !solver || !precond) {\r\n        fprintf(stderr, \"Error: missing required arguments for eigenvalue\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int method;\r\n    if (strcmp(method_s, \"power\") == 0) method = 0;\r\n    else if (strcmp(method_s, \"inverse\") == 0) method = 1;\r\n    else if (strcmp(method_s, \"shifted-inverse\") == 0) method = 2;\r\n    else {\r\n        fprintf(stderr, \"Error: unknown method '%s'\\n\", method_s);\r\n        return 1;\r\n    }\r\n\r\n    double sigma = 0.0;\r\n    if (method == 2) {\r\n"]
[12482.971327, "o", "        if (!shift_s) {\r\n            fprintf(stderr, \"Error: --shift is required for shifted-inverse\\n\");\r\n            return 1;\r\n        }\r\n        if (parse_double(shift_s, &sigma) != 0) {\r\n            fprintf(stderr, \"Error: invalid shift '%s'\\n\", shift_s);\r\n            return 1;\r\n        }\r\n    }\r\n\r\n    double tol, omega = 1.0, solver_tol = 1e-12;\r\n    int maxiter, restart = 30, solver_maxiter = 1000;\r\n\r\n    if (parse_double(tol_s, &tol) != 0 || tol <= 0.0) {\r\n        fprintf(stderr, \"Error: invalid tol '%s'\\n\", tol_s);\r\n"]
[12482.9714, "o", "        return 1;\r\n    }\r\n    if (parse_int(maxiter_s, &maxiter) != 0) {\r\n        fprintf(stderr, \"Error: invalid maxiter '%s'\\n\", maxiter_s);\r\n        return 1;\r\n    }\r\n    if (strcmp(solver, \"cg\") != 0 && strcmp(solver, \"gmres\") != 0) {\r\n        fprintf(stderr, \"Error: unknown solver '%s'\\n\", solver);\r\n        return 1;\r\n    }\r\n    if (strcmp(precond, \"none\") != 0 && strcmp(precond, \"jacobi\") != 0 &&"]
[12482.971474, "o", "\r\n        strcmp(precond, \"ilu0\") != 0 && strcmp(precond, \"ssor\") != 0) {\r\n        fprintf(stderr, \"Error: unknown preconditioner '%s'\\n\", precond);\r\n        return 1;\r\n    }\r\n    if (omega_s) {\r\n        if (parse_double(omega_s, &omega) != 0 || !(omega > 0.0 && omega < 2.0)) {\r\n            fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n            return 1;\r\n        }\r\n    }"]
[12482.971546, "o", "\r\n    if (restart_s && parse_int(restart_s, &restart) != 0) {\r\n        fprintf(stderr, \"Error: invalid restart '%s'\\n\", restart_s);\r\n        return 1;\r\n    }\r\n    if (solver_tol_s && (parse_double(solver_tol_s, &solver_tol) != 0 || solver_tol <= 0.0)) {\r\n        fprintf(stderr, \"Error: invalid solver-tol '%s'\\n\", solver_tol_s);\r\n        return 1;\r\n    }\r\n"]
[12482.971621, "o", "    if (solver_maxiter_s && parse_int(solver_maxiter_s, &solver_maxiter) != 0) {\r\n        fprintf(stderr, \"Error: invalid solver-maxiter '%s'\\n\", solver_maxiter_s);\r\n        return 1;\r\n    }\r\n\r\n    CSRMatrix *A = csr_read_mm(input);\r\n    if (!A) {\r\n        fprintf(stderr, \"Error: cannot read sparse matrix from '%s'\\n\", input);\r\n        return 1;\r\n    }\r\n    if (A->rows != A->cols) {\r\n        fprintf(stderr, \"Error: eigenvalue requires a square matrix\\n\");\r\n"]
[12482.971666, "o", "        csr_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    int n = A->rows;\r\n    double *v = vec_create(n);\r\n    double *w = vec_create(n);\r\n"]
[12482.971755, "o", "    double *Av = vec_create(n);\r\n    if (!v || !w || !Av) {\r\n        fprintf(stderr, \"Error: allocation failed\\n\");\r\n        free(v); free(w); free(Av);\r\n        csr_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    init_random_vector(v, n);\r\n\r\n    int converged = 0;\r\n    int iterations = 0;\r\n    double eigenvalue = NAN;\r\n    double prev_lambda = NAN;\r\n    CSRMatrix *S = NULL;\r\n"]
[12482.971826, "o", "    const CSRMatrix *OpA = A;\r\n\r\n    if (method == 2) {\r\n        S = make_shifted_matrix(A, sigma);\r\n        if (!S) {\r\n            fprintf(stderr, \"Error: allocation failed\\n\");\r\n            free(v); free(w); free(Av);\r\n            csr_destroy(A);\r\n            return 1;\r\n        }\r\n        OpA = S;"]
[12482.971911, "o", "\r\n    }\r\n\r\n    for (int iter = 0; iter < maxiter; iter++) {\r\n        if (method == 0) {\r\n            csr_spmv(A, v, w);\r\n            eigenvalue = vec_dot(v, w, n);\r\n            double nrm = vec_norm2(w, n);\r\n            if (nrm < 1e-300) {\r\n                break;\r\n            }\r\n"]
[12482.971978, "o", "            for (int i = 0; i < n; i++) v[i] = w[i] / nrm;\r\n        } else {\r\n            int fail = 0;\r\n            SolveResult *res = solve_linear_system(OpA, v, solver, precond, solver_tol, solver_maxiter, restart, omega, &fail);\r\n            if (!res || !res->converged || fail) {\r\n                eigenvalue = NAN;\r\n                if (res) solve_result_destroy(res);\r\n                break;\r\n            }\r\n"]
[12482.972049, "o", "            double wnorm = vec_norm2(res->x, n);\r\n            if (wnorm < 1e-300) {\r\n                eigenvalue = NAN;\r\n                solve_result_destroy(res);\r\n                break;\r\n            }\r\n            double rq = vec_dot(v, res->x, n);\r\n            if (fabs(rq) < 1e-300) {\r\n                eigenvalue = NAN;\r\n                solve_result_destroy(res);\r\n                break;\r\n            }"]
[12482.97213, "o", "\r\n            if (method == 1) {\r\n                eigenvalue = 1.0 / rq;\r\n            } else {\r\n                eigenvalue = sigma + 1.0 / rq;\r\n            }\r\n            for (int i = 0; i < n; i++) w[i] = res->x[i] / wnorm;\r\n            memcpy(v, w, n * sizeof(double));\r\n            solve_result_destroy(res);\r\n        }\r\n\r\n        iterations = iter + 1;\r\n"]
[12482.972205, "o", "        if (!isnan(prev_lambda) && fabs(eigenvalue) > 0.0) {\r\n            if (fabs(eigenvalue - prev_lambda) / fabs(eigenvalue) < tol) {\r\n                converged = 1;\r\n                break;\r\n            }\r\n        }\r\n        prev_lambda = eigenvalue;\r\n    }\r\n\r\n"]
[12482.972276, "o", "    double vn = vec_norm2(v, n);\r\n    if (vn > 0.0) {\r\n        for (int i = 0; i < n; i++) v[i] /= vn;\r\n    } else {\r\n        vec_zero(v, n);\r\n        if (n > 0) v[0] = 1.0;\r\n    }\r\n\r\n    printf(\"method: %s\\n\", method_s);\r\n    printf(\"converged: %s\\n\", converged ? \"yes\" : \"no\");\r\n    printf(\"iterations: %d\\n\", iterations);\r\n    printf(\"eigenvalue: %.15e\\n\", eigenvalue);\r\n\r\n    double resnorm = NAN;\r\n    if (!isnan(eigenvalue)) {\r\n        csr_spmv(A, v, Av);\r\n        double lambda = eigenvalue;\r\n"]
[12482.972347, "o", "        for (int i = 0; i < n; i++) w[i] = Av[i] - lambda * v[i];\r\n        double num = vec_norm2(w, n);\r\n        double vnrm = vec_norm2(v, n);\r\n        if (fabs(lambda) == 0.0) {\r\n            resnorm = INFINITY;\r\n        } else if (vnrm > 0.0) {\r\n"]
[12482.972419, "o", "            resnorm = num / (fabs(lambda) * vnrm);\r\n        } else {\r\n            resnorm = INFINITY;\r\n        }\r\n    } else {\r\n        resnorm = NAN;\r\n    }\r\n    printf(\"eigenvector_residual: %.15e\\n\", resnorm);\r\n\r\n    if (method == 2) {\r\n        printf(\"shift: %.15e\\n\", sigma);\r\n    }\r\n\r\n    if (eigvec_output) {\r\n"]
[12482.972489, "o", "        if (vec_write_mm_array(v, n, eigvec_output) != 0) {\r\n            fprintf(stderr, \"Error: cannot write eigenvector to '%s'\\n\", eigvec_output);\r\n        }\r\n    }\r\n\r\n    free(v); free(w); free(Av);\r\n    if (S) csr_destroy(S);\r\n    csr_destroy(A);\r\n    return 0;\r\n}\r\n"]
[12482.975697, "o", "#ifndef EIGEN_H\r\n#define EIGEN_H\r\n\r\nint cmd_eigenvalue(int argc, char **argv);\r\n\r\n#endif /* EIGEN_H */\r\n"]
[12482.976204, "o", "\u001b[?2004h"]
[12482.976264, "o", "root@n30009:/app# "]
[12483.241023, "i", "sed -n '1,260p' src/main.c && sed -n '1,220p' include/main.h\n"]
[12483.241463, "o", "sed -n '1,260p' src/main.c && sed -n '1,220p' include/main.h\r\n"]
[12483.241518, "o", "\u001b[?2004l\r"]
[12483.244416, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n#include \"dense.h\"\r\n#include \"vector.h\"\r\n#include \"io.h\"\r\n#include \"sparse.h\"\r\n#include \"precond.h\"\r\n#include \"solvers.h\"\r\n#include \"poisson.h\"\r\n"]
[12483.244575, "o", "#include \"heat.h\"\r\n#include \"convdiff.h\"\r\n#include \"eigen.h\"\r\n\r\nstatic void usage(const char *prog)\r\n{\r\n    fprintf(stderr, \"Usage:\\n\");\r\n    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\n\", prog);\r\n    fprintf(stderr, \"  %s matinfo --input <mtx_file>\\n\", prog);\r\n    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s heat --nx"]
