[9770.336923, "o", "static int mm_parse_header(const char *line, int *is_array, int *is_symmetric)\r\n{\r\n    char buf[1024];\r\n    strncpy(buf, line, sizeof(buf)-1);\r\n    buf[sizeof(buf)-1] = '\\0';\r\n"]
[9770.336937, "o", "\r\n    char *tok = strtok(buf, \" \\t\\r\\n\");\r\n"]
[9770.337005, "o", "    if (!tok || strcmp(tok, \"%%MatrixMarket\") != 0) return -1;\r\n\r\n    tok = strtok(NULL, \" \\t\\r\\n\");\r\n    if (!tok || strcmp(tok, \"matrix\") != 0) return -1;\r\n\r\n    tok = strtok(NULL, \" \\t\\r\\n\");\r\n    if (!tok) return -1;\r\n    if (strcmp(tok, \"coordinate\") == 0) *is_array = 0;\r\n    else if (strcmp(tok, \"array\") == 0) *is_array = 1;\r\n    else return -1;\r\n\r\n    tok = strtok(NULL, \" \\t\\r\\n\");\r\n    if (!tok) return -1;\r\n    if (strcmp(tok, \"real\") != 0 && strcmp(tok, \"double\") != 0) return -1;\r\n"]
[9770.337048, "o", "\r\n    *is_symmetric = 0;\r\n    tok = strtok(NULL, \" \\t\\r\\n\");\r\n    if (tok && strcmp(tok, \"symmetric\") == 0) *is_symmetric = 1;\r\n\r\n    return 0;\r\n}\r\n\r\nstatic int read_non_comment_line(FILE *fp, char *buf, int bufsize)\r\n{\r\n"]
[9770.337088, "o", "    while (fgets(buf, bufsize, fp)) {\r\n"]
[9770.337125, "o", "        char *s = buf;\r\n        while (*s == ' ' || *s == '\\t') s++;\r\n        if (*s == '%' || *s == '\\n' || *s == '\\r' || *s == '\\0') continue;\r\n        return 0;\r\n    }\r\n    return -1;\r\n}\r\n\r\n"]
[9770.337169, "o", "CSRMatrix *csr_read_mm(const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    char line[1024];\r\n    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }\r\n    int is_array = 0, is_symmetric = 0;\r\n    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || is_array) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    int rows, cols, nnz;\r\n    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }\r\n"]
[9770.337212, "o", "    if (sscanf(line, \"%d %d %d\", &rows, &cols, &nnz) != 3 || rows <= 0 || cols <= 0 || nnz < 0) {\r\n        fclose(fp);\r\n        return NULL;\r\n"]
[9770.337255, "o", "    }\r\n\r\n    int cap = is_symmetric ? 2 * nnz + 1 : nnz;\r\n    if (cap < 1) cap = 1;\r\n    COOMatrix *coo = coo_create(rows, cols, cap);\r\n    if (!coo) { fclose(fp); return NULL; }\r\n\r\n    int k = 0;\r\n"]
[9770.337295, "o", "    while (k < coo->nnz && read_non_comment_line(fp, line, sizeof(line)) == 0) {\r\n        int r, c;\r\n        double v;\r\n        if (sscanf(line, \"%d %d %lf\", &r, &c, &v) != 3) continue;\r\n        if (r < 1 || r > rows || c < 1 || c > cols) continue;\r\n        r--; c--;\r\n\r\n        coo->row[k] = r;\r\n        coo->col[k] = c;\r\n"]
[9770.337336, "o", "        coo->values[k] = v;\r\n        k++;\r\n\r\n        if (is_symmetric && r != c) {\r\n            coo->row[k] = c;\r\n            coo->col[k] = r;\r\n            coo->values[k] = v;\r\n            k++;\r\n"]
[9770.337376, "o", "        }\r\n    }\r\n    coo->nnz = k;\r\n\r\n    CSRMatrix *A = coo_to_csr(coo);\r\n    coo_destroy(coo);\r\n    fclose(fp);\r\n"]
[9770.337418, "o", "    return A;\r\n}\r\n"]
[9770.337864, "o", "\u001b[?2004h"]
[9770.337975, "o", "root@n30009:/app# "]
[9787.521309, "i", "sed -n '1,80p' include/sparse.h\n"]
[9787.521606, "o", "sed -n '1,80p' include/sparse.h\r\n\u001b[?2004l\r"]
[9787.524489, "o", "#ifndef SPARSE_H\r\n#define SPARSE_H\r\n\r\n#include <stdio.h>\r\n\r\ntypedef struct {\r\n    int    rows;\r\n    int    cols;\r\n    int    nnz;\r\n    double *values;\r\n"]
[9787.524676, "o", "    int    *col_indices;\r\n    int    *row_ptr;\r\n} CSRMatrix;\r\n\r\ntypedef struct {\r\n    int    rows;\r\n    int    cols;\r\n    int    nnz;\r\n    double *values;"]
[9787.524776, "o", "\r\n    int    *row;\r\n    int    *col;\r\n} COOMatrix;\r\n\r\n/* Lifecycle */\r\nCSRMatrix  *csr_create(int rows, int cols, int nnz);\r\nvoid        csr_destroy(CSRMatrix *A);\r\nCOOMatrix  *coo_create(int rows, int cols, int nnz);\r\nvoid        coo_destroy(COOMatrix *A);\r\n\r\n/* Conversions */\r\nCOOMatrix  *csr_to_coo(const CSRMatrix *A);\r\nCSRMatrix  *coo_to_csr(const COOMatrix *A);\r\n\r\n/* Operations */\r\nvoid        csr_spmv(const CSRMatrix *A, const double *x, double *y);\r\nCSRMatrix  *csr_transpose(const CSRMatrix *A);\r\nint         csr_is_symmetric(const CSRMatrix *A, double tol);\r\ndouble     *csr_diagonal(const CSRMatrix *A);\r\n\r\n/* Matrix Market I/O */\r\nCSRMatrix  *csr_read_mm(const char *filename);\r\nint         csr_write_mm(const CSRMatrix *A, const char *filename);\r\ndouble     *vec_read_mm_array(const char *filename, int *n_out);\r\nint         vec_write_mm_array(const double *x, int n, const char *filename);\r\n\r\n#endif /* SPARSE_H */\r\n"]
[9787.525193, "o", "\u001b[?2004h"]
[9787.525259, "o", "root@n30009:/app# "]
[9792.708451, "i", "sed -n '1,120p' src/main.c\n"]
[9792.708726, "o", "sed -n '1,120p' src/main.c\r\n\u001b[?2004l\r"]
[9792.71164, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include \"dense.h\"\r\n#include \"vector.h\"\r\n#include \"io.h\"\r\n#include \"sparse.h\"\r\n#include \"precond.h\""]
[9792.711683, "o", "\r\n#include \"solvers.h\"\r\n#include \"poisson.h\"\r\n#include \"heat.h\"\r\n#include \"convdiff.h\"\r\n#include \"eigen.h\"\r\n\r\n"]
[9792.711972, "o", "static void usage(const char *prog)\r\n{\r\n    fprintf(stderr, \"Usage:\\n\");\r\n    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\n\", prog);\r\n    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s heat --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --alpha <float> --dt <float> --nsteps <int> --scheme <backw"]
[9792.712073, "o", "ard-euler|crank-nicolson> --ic <file> --source <file>[,<file>,...] --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file>\\n\", prog);\r\n    fprintf(stderr, \"  %s convdiff --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --kappa <float> --vx <float> --vy <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file> [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s eigenvalue --input <mtx_file> --method <power|inverse|shifted-inverse> [--shift <sigma>] --tol <value> --maxiter <int> --solver <cg|gmres> "]
[9792.712148, "o", "--precond <none|jacobi|ilu0|ssor> [--restart <m>] [--ssor-omega <value>] [--solver-tol <value>] [--solver-maxiter <int>] [--eigvec-output <file>]\\n\", prog);\r\n}\r\n\r\nstatic const char *get_opt(int argc, char **argv, const char *name)\r\n{\r\n    for (int i = 0; i < argc - 1; i++) {\r\n        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    }\r\n    return NULL;\r\n}\r\n\r\nstatic int write_history_file(const SolveResult *res, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    for (int i = 0; i < res->history_len; i++) {\r\n        fprintf(fp, \"%d\\t%.15e\\t%.15e\\n\", i, res->history[i], res->precond_history[i]);\r\n    }\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n\r\nstatic void print_solve_summary(const SolveResult *res)\r\n{\r\n    printf(\"converged: %s\\n\", res->converged ? \"yes\" : \"no\");\r\n    printf(\"iterations: %d\\n\", res->iterations);\r\n    printf(\"residual: %.6e\\n\", res->relres);\r\n    printf(\"true_residual: %.6e\\n\", res->true_residual);\r\n}\r\n\r\nstatic int validate_ssor_omega(double omega)\r\n{\r\n "]
[9792.712223, "o", "   if (!(omega > 0.0 && omega < 2.0)) {\r\n        fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int cmd_dense_solve(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"Error: dense-solve requires <matrix_file> <rhs_file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    const char *mat_file = argv[0];\r\n    const char *rhs_file = argv[1];\r\n    const char *out_file = (argc >= 3) ? argv[2] : NULL;\r\n\r\n    DenseMatrix *A = dm_read_text(mat_file);\r\n    if (!A) {\r\n        fprintf(stderr, \"Error: cannot read matrix from '%s'\\n\", mat_file);\r\n        return 1;\r\n    }\r\n\r\n    int n;\r\n    double *b = vec_read_text(rhs_file, &n);\r\n    if (!b) {\r\n        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (A->rows != n || A->cols != n) {\r\n        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n                A->rows, A->cols, n);\r\n        free(b);\r\n        dm_de"]
[9792.712288, "o", "stroy(A);\r\n        return 1;\r\n    }\r\n\r\n    double *x = vec_create(n);\r\n    if (!x) {\r\n        fprintf(stderr, \"Error: allocation failed\\n\");\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    int rc = dm_solve(A, b, x);\r\n    if (rc != 0) {\r\n        fprintf(stderr, \"Error: solver failed (singular or ill-conditioned)\\n\");\r\n        free(x);\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (out_file) {\r\n        vec_write_text(x, n, out_file);\r\n        printf(\"Solution written to %s\\n\", out_file);\r\n    } else {\r\n        printf(\"Solution:\\n\");\r\n        vec_print(x, n, stdout);\r\n    }\r\n\r\n    double *r = vec_create(n);\r\n"]
