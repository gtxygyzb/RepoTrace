[1145.63962, "o", "\u001b[?2004h> "]
[1145.639856, "o", "    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n\u001b[?2004l\r"]
[1145.639921, "o", "\u001b[?2004h> "]
