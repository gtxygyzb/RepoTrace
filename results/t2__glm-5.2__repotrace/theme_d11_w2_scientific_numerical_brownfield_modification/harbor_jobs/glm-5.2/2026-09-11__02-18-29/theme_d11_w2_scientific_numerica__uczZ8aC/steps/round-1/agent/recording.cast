[12681.548896, "i", "           if (fabs(lambda_max - prev_lambda_max) / fabs(lambda_max) < tol) {\n                power_converged = 1;\n                break;\n            }\n        }\n        prev_lambda_max = lambda_max;\n    }\n\n    /* Inverse iteration for lambda_min */\n    int inverse_converged = 0;\n    int inverse_iterations = 0;\n    double lambda_min = NAN;\n    double prev_lambda_min = NAN;\n\n    for (int iter = 0; iter < maxiter; iter++) {\n        int fail = 0;\n        SolveResult *res = solve_linear_system(A, vi, solver, precond, solver_tol, solver_maxiter, restart, omega, &fail);\n        if (!res || !res->converged || fail) {\n            lambda_min = NAN;\n            if (res) solve_result_destroy(res);\n            break;\n        }\n        double wnorm = vec_norm2(res->x, n);\n        if (wnorm < 1e-300) {\n            lambda_min = NAN;\n            solve_result_destroy(res);\n            break;\n        }\n        double rq = vec_dot(vi, res->x, n);\n        if (fabs(rq) < 1e-300) {\n            lambda_min = NAN;\n            solve_r"]
