[11157.079882, "o", "\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        out->values[pos] = sorted->values[k];\r\n\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    free(next);\r\n"]
[11157.079967, "o", "\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    coo_destroy(sorted);\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return out;\r\n\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[11157.08003, "o", "\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kvoid csr_spmv\u001b[m\u001b[K(const CSRMatrix *A, const double *x, double *y)\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (int i = 0; i < A->rows; i++) {\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        double s = 0.0;\r\n"]
[11157.080109, "o", "\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            s += A->values[k] * x[A->col_indices[k]];\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        y[i] = s;\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n"]
