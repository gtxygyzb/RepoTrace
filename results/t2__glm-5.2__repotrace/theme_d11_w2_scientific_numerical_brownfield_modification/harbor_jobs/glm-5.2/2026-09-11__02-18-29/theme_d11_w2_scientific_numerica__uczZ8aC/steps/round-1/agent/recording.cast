[2495.929899, "o", "cat README.md\r\n\u001b[?2004l\r"]
[2495.932051, "o", "# numsim - Numerical Simulation Toolkit\r\n\r\nA C library and command-line tool for solving linear systems arising from\r\nscientific and engineering applications.\r\n\r\n## Building\r\n\r\n```\r\nmake\r\n```\r\n\r\n## Usage\r\n\r\n```\r\n./numsim dense-solve <matrix_file> <rhs_file> [output_file]\r\n```\r\n\r\n### File Formats\r\n\r\n**Dense matrix** (text):\r\n```\r\nrows cols\r\na00 a01 ...\r\na10 a11 ...\r\n```\r\n\r\n**Vector** (text):\r\n```\r\nn\r\nv0\r\nv1\r\n...\r\n```"]
[2495.932156, "o", "\r\n\r\n## Architecture\r\n\r\n- `include/` - Public headers\r\n- `src/` - Implementation\r\n  - `dense.c` - Dense matrix operations, LU solver\r\n  - `vector.c` - Vector arithmetic (dot, axpy, norm, ...)\r\n  - `io.c` - File I/O for matrices and vectors\r\n  - `main.c` - CLI entry point\r\n\r\n## License\r\n\r\nMIT\r\n"]
[2495.932486, "o", "\u001b[?2004h"]
[2495.932552, "o", "root@n30009:/app# "]
[2610.795112, "i", "sed -n '120,260p' src/solvers.c\n"]
[2610.795408, "o", "sed -n '120,260p' src/solvers.c\r\n"]
[2610.795501, "o", "\u001b[?2004l\r"]
[2610.798454, "o", "        }\r\n\r\n        double a = H[i*m+i];\r\n        double b = H[(i+1)*m+i];\r\n        if (b == 0.0) {\r\n            c[i] = 1.0;\r\n            s[i] = 0.0;\r\n"]
[2610.798584, "o", "        } else {\r\n            double r = hypot(a, b);\r\n            c[i] = a / r;\r\n            s[i] = b / r;\r\n        }\r\n        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n\r\n    }\r\n\r\n    for (int i = kdim - 1; i >= 0; i--) {\r\n        double sum = g[i];\r\n        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n        y[i] = sum / H[i*m+i];\r\n    }\r\n\r\n    free(c);\r\n    free(s);\r\n    return 0;\r\n}\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                         double tol, int maxiter, int m, Precond *P)\r\n{\r\n"]
[2610.798675, "o", "    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (m <= 0) m = 30;\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    double *Av = vec_create(n);\r\n    double *w = vec_create(n);\r\n    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n    double *y = (double *)malloc(m * sizeof(double));\r\n    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n\r\n"]
[2610.798806, "o", "    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n\r\n    res->relres = vec_norm2(r, n) / bnorm;\r\n    res->history[0] = res->relres;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        return res;\r\n    }\r\n\r\n    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double beta = vec_norm2(z, n);\r\n        if (beta == 0.0) break;\r\n"]
[2610.798933, "o", "\r\n        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n        g[0] = beta;\r\n        memset(H, 0, (m + 1) * m * sizeof(double));\r\n\r\n        int kdim = 0;\r\n        int fail = 0;\r\n        for (int j = 0; j < m; j++) {\r\n            csr_spmv(A, V + j * n, Av);\r\n            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n\r\n            for (int i = 0; i <= j; i++) {\r\n                double h = vec_dot(w, V + i * n, n);\r\n                H[i*m+j] = h;\r\n                vec_axpy(-h, V + i * n, w, n);\r\n            }\r\n\r\n            double hnorm = vec_norm2(w, n);\r\n            H[(j+1)*m+j] = hnorm;\r\n            kdim = j + 1;\r\n\r\n            if (hnorm < 1e-14) break;\r\n\r\n"]
[2610.799005, "o", "            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n        }\r\n        if (fail) break;\r\n        if (kdim == 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->relres = vec_norm2(r, n) / bnorm;\r\n        res->history[cycle] = res->relres;\r\n"]
[2610.799069, "o", "        res->history_len = cycle + 1;\r\n        res->iterations = cycle;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n    }\r\n\r\n    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n    return res;\r\n}\r\n\r\nvoid solve_result_destroy(SolveResult *res)\r\n"]
[2610.799131, "o", "{\r\n    if (!res) return;\r\n    free(res->x);\r\n    free(res->history);\r\n    free(res);\r\n}\r\n"]
