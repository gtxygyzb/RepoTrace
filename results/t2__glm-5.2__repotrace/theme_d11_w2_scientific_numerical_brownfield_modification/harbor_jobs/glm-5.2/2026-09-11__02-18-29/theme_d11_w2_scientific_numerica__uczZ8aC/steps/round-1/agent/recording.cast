[4012.745885, "o", "\u001b[?2004h> "]
[4012.746069, "o", "            for (int i = 0; i < nsources; i++) free(sources[i]);\r\n\u001b[?2004l\r"]
[4012.746158, "o", "\u001b[?2004h> "]
[4012.746244, "o", "            free(sources);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.746356, "o", "            free_source_list(source_files, nsources);\r\n\u001b[?2004l\r"]
[4012.746421, "o", "\u001b[?2004h> "]
[4012.746477, "o", "            free(u);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.74654, "o", "            return -1;\r\n\u001b[?2004l\r"]
[4012.7466, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4012.746667, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4012.746734, "o", "\u001b[?2004h> "]
[4012.746863, "o", "    Precond *P = precond_create(A_sys, precond, omega);\r\n\u001b[?2004l\r"]
[4012.746927, "o", "\u001b[?2004h>     if (!P) {\r\n\u001b[?2004l\r"]
[4012.746982, "o", "\u001b[?2004h> "]
[4012.747048, "o", "        csr_destroy(A_rhs);\r\n\u001b[?2004l\r"]
[4012.747102, "o", "\u001b[?2004h> "]
[4012.747158, "o", "        csr_destroy(A_sys);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4012.747214, "o", "> "]
[4012.74728, "o", "        free(flux);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.74749, "o", "        free(left_vals); free(right_vals); free(bottom_vals); free(top_vals);\r\n\u001b[?2004l\r"]
[4012.74755, "o", "\u001b[?2004h> "]
[4012.747688, "o", "        for (int i = 0; i < nsources; i++) free(sources[i]);\r\n\u001b[?2004l\r"]
[4012.747742, "o", "\u001b[?2004h> "]
[4012.747792, "o", "        free(sources);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.747962, "o", "        free_source_list(source_files, nsources);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4012.74802, "o", ">         free(u);\r\n\u001b[?2004l\r"]
[4012.748077, "o", "\u001b[?2004h> "]
[4012.748137, "o", "        return -1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.748194, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4012.748262, "o", "\u001b[?2004h> "]
[4012.748329, "o", "    double *u_new = vec_create(n);\r\n\u001b[?2004l\r"]
[4012.748384, "o", "\u001b[?2004h> "]
[4012.748452, "o", "    double *rhs = vec_create(n);\r\n\u001b[?2004l\r"]
[4012.748507, "o", "\u001b[?2004h> "]
[4012.748575, "o", "    double *tmp = vec_create(n);\r\n\u001b[?2004l\r"]
[4012.748635, "o", "\u001b[?2004h> "]
[4012.748704, "o", "    if (!u_new || !rhs || !tmp) {\r\n\u001b[?2004l\r"]
[4012.74876, "o", "\u001b[?2004h> "]
[4012.748855, "o", "        free(u_new); free(rhs); free(tmp);\r\n\u001b[?2004l\r"]
[4012.748919, "o", "\u001b[?2004h> "]
[4012.748982, "o", "        precond_destroy(P);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.749081, "o", "        csr_destroy(A_rhs);\r\n\u001b[?2004l\r"]
[4012.749136, "o", "\u001b[?2004h> "]
[4012.749192, "o", "        csr_destroy(A_sys);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4012.749247, "o", "> "]
[4012.749301, "o", "        free(flux);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.749525, "o", "        free(left_vals); free(right_vals); free(bottom_vals); free(top_vals);\r\n\u001b[?2004l\r"]
[4012.749581, "o", "\u001b[?2004h> "]
[4012.749724, "o", "        for (int i = 0; i < nsources; i++) free(sources[i]);\r\n\u001b[?2004l\r"]
[4012.749779, "o", "\u001b[?2004h> "]
[4012.749848, "o", "        free(sources);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.749993, "o", "        free_source_list(source_files, nsources);\r\n\u001b[?2004l\r"]
[4012.75005, "o", "\u001b[?2004h> "]
[4012.750106, "o", "        free(u);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.750171, "o", "        return -1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.75023, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4012.750284, "o", "\u001b[?2004h> "]
[4012.750341, "o", "    int solver_calls = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[4012.750395, "o", "> "]
[4012.750458, "o", "    int converged_all = 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.750565, "o", "    double max_residual = 0.0;\r\n\u001b[?2004l\r"]
[4012.750619, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.75076, "o", "    for (int step = 0; step < nsteps; step++) {\r\n\u001b[?2004l\r"]
[4012.750816, "o", "\u001b[?2004h> "]
[4012.751002, "o", "        const double *f_n = (nsources == 1) ? sources[0] : sources[step];\r\n\u001b[?2004l\r"]
[4012.75106, "o", "\u001b[?2004h> "]
[4012.751255, "o", "        const double *f_np1 = (nsources == 1) ? sources[0] : sources[step + 1];\r\n\u001b[?2004l\r"]
[4012.751312, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.751377, "o", "        if (is_be) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4012.751433, "o", "> "]
[4012.751525, "o", "            for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4012.751581, "o", "> "]
[4012.751748, "o", "                rhs[i] = u[i] + dt * f_np1[i] + alpha * dt * flux[i];\r\n\u001b[?2004l\r"]
[4012.751804, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[4012.751859, "o", "\u001b[?2004h> "]
[4012.751925, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.752036, "o", "            csr_spmv(A_rhs, u, tmp);\r\n\u001b[?2004l\r"]
[4012.752091, "o", "\u001b[?2004h> "]
[4012.752183, "o", "            for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[4012.75224, "o", "\u001b[?2004h> "]
[4012.75246, "o", "                rhs[i] = tmp[i] + 0.5 * dt * (f_n[i] + f_np1[i]) + alpha * dt * flux[i];\r\n\u001b[?2004l\r"]
[4012.752518, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[4012.752575, "o", "\u001b[?2004h> "]
[4012.752632, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.752759, "o", "        for (int i = 0; i < nx; i++) {\r\n\u001b[?2004l\r"]
[4012.752819, "o", "\u001b[?2004h> "]
[4012.752918, "o", "            for (int j = 0; j < ny; j++) {\r\n\u001b[?2004l\r"]
[4012.752977, "o", "\u001b[?2004h> "]
[4012.753172, "o", "                if (is_dirichlet_node(i, j, nx, ny, left, right, bottom, top)) {\r\n\u001b[?2004l\r"]
[4012.75323, "o", "\u001b[?2004h> "]
[4012.753321, "o", "                    int idx = i * ny + j;\r\n\u001b[?2004l\r"]
[4012.753378, "o", "\u001b[?2004h> "]
[4012.753583, "o", "                    rhs[idx] = dirichlet_value(i, j, nx, ny, left_vals, right_vals,\r\n\u001b[?2004l\r"]
[4012.753639, "o", "\u001b[?2004h> "]
[4012.753856, "o", "                                                bottom_vals, top_vals, left, right,\r\n\u001b[?2004l\r"]
[4012.753922, "o", "\u001b[?2004h> "]
[4012.753995, "o", "                                                bottom, top);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.754061, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.754115, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4012.75417, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.754234, "o", "        SolveResult *res = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.754326, "o", "        if (strcmp(solver, \"cg\") == 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.754452, "o", "            res = cg_solve(A_sys, rhs, u, tol, maxiter, P);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.754562, "o", "        } else if (strcmp(solver, \"gmres\") == 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.754711, "o", "            res = gmres_solve(A_sys, rhs, u, tol, maxiter, restart, P);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.754771, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.754839, "o", "            converged_all = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.754927, "o", "            vec_copy(u, u_new, n);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.754982, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.755042, "o", "        solver_calls++;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4012.755101, "o", "\u001b[?2004h>         if (res) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.755214, "o", "            if (!res->converged) converged_all = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.755363, "o", "            if (res->relres > max_residual) max_residual = res->relres;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.755453, "o", "            vec_copy(res->x, u_new, n);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.755543, "o", "            solve_result_destroy(res);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.755607, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.755672, "o", "            converged_all = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.7558, "o", "            if (max_residual < 1.0e30) max_residual = 1.0e30;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.755886, "o", "            vec_copy(u, u_new, n);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.755943, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.756021, "o", "        double *swap = u;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.756098, "o", "        u = u_new;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.756179, "o", "        u_new = swap;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.756283, "o", "    int rc = vec_write_mm_array(u, n, output);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[4012.756338, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4012.756397, "o", "    printf(\"timesteps: %d\\n\", nsteps);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4012.756452, "o", "> "]
[4012.756518, "o", "    printf(\"final_time: %.15e\\n\", dt * (double)nsteps);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.756623, "o", "    printf(\"solver_calls: %d\\n\", solver_calls);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.756759, "o", "    printf(\"converged_all: %s\\n\", converged_all ? \"yes\" : \"no\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.756878, "o", "    printf(\"max_residual: %.6e\\n\", max_residual);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.756938, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.756998, "o", "    free(u_new); free(rhs); free(tmp);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.757057, "o", "    precond_destroy(P);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.757117, "o", "    csr_destroy(A_rhs);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.757177, "o", "    csr_destroy(A_sys);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.757245, "o", "    free(flux);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.757381, "o", "    free(left_vals); free(right_vals); free(bottom_vals); free(top_vals);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.757501, "o", "    for (int i = 0; i < nsources; i++) free(sources[i]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.757558, "o", "    free(sources);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.757659, "o", "    free_source_list(source_files, nsources);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.757723, "o", "    free(u);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4012.757778, "o", "    return rc;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
