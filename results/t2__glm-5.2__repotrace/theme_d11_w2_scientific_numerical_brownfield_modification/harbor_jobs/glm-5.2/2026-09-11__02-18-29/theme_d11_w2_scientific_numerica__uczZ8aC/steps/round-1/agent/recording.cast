[11201.324899, "o", "\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n\u001b[32m\u001b[K265\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const char *source = get_opt(argc, argv, \"--source\");\r\n\u001b[32m\u001b[K266\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n"]
