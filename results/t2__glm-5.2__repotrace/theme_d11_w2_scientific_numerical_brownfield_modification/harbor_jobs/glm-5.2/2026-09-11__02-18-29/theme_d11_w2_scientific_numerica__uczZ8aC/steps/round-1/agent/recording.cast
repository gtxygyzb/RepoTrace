[7829.423361, "o", "    solve_result_destroy(res);\r\n    precond_destroy(P);\r\n    return 0;\r\n}\r\n\r\nstatic int cmd_sparse_solve(int argc, char **argv)\r\n{\r\n    const char *input = get_opt(argc, argv, \"--input\");\r\n    const char *rhs_file = get_opt(argc, argv, \"--rhs\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n"]
[7829.423424, "o", "    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n    const char *history = get_opt(argc, argv, \"--history\");\r\n\r\n    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {\r\n        fprintf(stderr, \"Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n"]
[7829.42349, "o", "    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid solver parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n    }\r\n\r\n    CSRMatrix *A = csr_read_mm(input);\r\n    if (!A) {\r\n        fprintf(stderr, \"Error: cannot read sparse matrix from '%s'\\n\", input);\r\n"]
[7829.42355, "o", "        return 1;\r\n    }\r\n\r\n    int n;\r\n    double *b = vec_read_mm_array(rhs_file, &n);\r\n    if (!b) {\r\n        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n        csr_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (A->rows != n || A->cols != n) {\r\n"]
[7829.423612, "o", "        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n                A->rows, A->cols, n);\r\n        free(b);\r\n        csr_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\r\n    free(b);\r\n    csr_destroy(A);\r\n    return rc;\r\n}\r\n"]
[7829.423674, "o", "\r\nstatic int cmd_poisson(int argc, char **argv)\r\n{\r\n    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n    const char *source = get_opt(argc, argv, \"--source\");\r\n    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n"]
[7829.423734, "o", "    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n    const char *history = get_opt(argc, argv, \"--history\");\r\n"]
[7829.423813, "o", "\r\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||\r\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n        !solver || !precond || !tol_s || !maxiter_s) {\r\n        fprintf(stderr, \"Error: poisson requires grid, source, boundary condition, solver, precond, tol, maxiter\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n\r\n"]
[7829.423889, "o", "    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid poisson parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n        return 1;\r\n    }\r\n"]
[7829.42395, "o", "\r\n    CSRMatrix *A = NULL;\r\n    double *b = NULL;\r\n    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {\r\n        fprintf(stderr, \"Error: cannot assemble Poisson system\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\r\n"]
[7829.42401, "o", "    free(b);\r\n    csr_destroy(A);\r\n    return rc;\r\n}\r\n\r\nstatic int cmd_heat(int argc, char **argv)\r\n{\r\n    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n"]
[7829.424072, "o", "    const char *alpha_s = get_opt(argc, argv, \"--alpha\");\r\n    const char *dt_s = get_opt(argc, argv, \"--dt\");\r\n    const char *nsteps_s = get_opt(argc, argv, \"--nsteps\");\r\n    const char *scheme = get_opt(argc, argv, \"--scheme\");\r\n    const char *ic_file = get_opt(argc, argv, \"--ic\");\r\n    const char *source_arg = get_opt(argc, argv, \"--source\");\r\n    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n"]
[7829.424141, "o", "    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n\r\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !alpha_s ||\r\n        !dt_s || !nsteps_s || !scheme || !ic_file || !source_arg ||\r\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n        !solver || !precond || !tol_s || !maxiter_s || !output) {\r\n        fprintf(stderr, \"Error: heat requires grid, domain, alpha, dt, nsteps, scheme, ic, source, boundary conditions, solver, precond, tol, maxiter, output\\n\");\r\n        usage(\"numsim\");\r\n"]
[7829.424204, "o", "        return 1;\r\n    }\r\n\r\n    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n    double alpha = atof(alpha_s);\r\n    double dt = atof(dt_s);\r\n    int nsteps = atoi(nsteps_s);\r\n    double tol = atof(tol_s);\r\n"]
[7829.424265, "o", "    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || alpha <= 0.0 ||\r\n        dt <= 0.0 || nsteps < 0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid heat parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n"]
[7829.424324, "o", "    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int rc = heat_solve(nx, ny, x0, x1, y0, y1, alpha, dt, nsteps, scheme,\r\n"]
[7829.424389, "o", "                       ic_file, source_arg, left, right, bottom, top,\r\n                       solver, precond, tol, maxiter, restart, omega, output);\r\n    if (rc != 0) {\r\n        fprintf(stderr, \"Error: heat solve failed\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int cmd_convdiff(int argc, char **argv)\r\n{\r\n    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n    const char *x1_s = get_opt(argc, argv, \"--x1\");"]
[7829.424468, "o", "\r\n    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n    const char *kappa_s = get_opt(argc, argv, \"--kappa\");\r\n    const char *vx_s = get_opt(argc, argv, \"--vx\");\r\n    const char *vy_s = get_opt(argc, argv, \"--vy\");\r\n    const char *source = get_opt(argc, argv, \"--source\");\r\n    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n"]
[7829.424529, "o", "    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n"]
[7829.425045, "o", "\u001b[?2004h"]
