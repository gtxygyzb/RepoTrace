[3840.582218, "o", "c_im = -1.0 / hx2;\r\n            }\r\n\r\n            if "]
[3840.582286, "o", "(is_bottom && bottom.type == POISSON_NEUMANN) {\r\n                diag += 2.0 "]
[3840.582343, "o", "/ hy2;\r\n                c_jp = -2.0 / hy2;\r\n                flux[idx] += 2.0 * bott"]
[3840.582398, "o", "om_vals[i] / hy;\r\n            } else if (is_top && top.type ="]
[3840.58246, "o", "= POISSON_NEUMANN) {\r\n                diag += 2.0 / hy2;\r\n                c_jm = -2.0 / hy2;\r\n   "]
