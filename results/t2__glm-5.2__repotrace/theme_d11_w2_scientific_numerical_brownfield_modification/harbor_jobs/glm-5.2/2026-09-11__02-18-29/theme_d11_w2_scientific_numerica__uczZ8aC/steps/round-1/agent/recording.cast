[915.38622, "o", "    int lo = A->row_ptr[row];\r\n\u001b[?2004l\r"]
[915.386301, "o", "\u001b[?2004h"]
[915.386381, "o", "> "]
[915.386528, "o", "    int hi = A->row_ptr[row+1] - 1;\r\n\u001b[?2004l\r"]
[915.386617, "o", "\u001b[?2004h"]
[915.386705, "o", "> "]
[915.386795, "o", "    while (lo <= hi) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.386829, "o", "> "]
[915.38705, "o", "        int mid = (lo + hi) / 2;\r\n\u001b[?2004l\r"]
[915.387108, "o", "\u001b[?2004h> "]
[915.38746, "o", "        if (A->col_indices[mid] == col) return mid;\r\n\u001b[?2004l\r"]
[915.387527, "o", "\u001b[?2004h> "]
[915.387893, "o", "        if (A->col_indices[mid] < col) lo = mid + 1;\r\n\u001b[?2004l\r"]
[915.387962, "o", "\u001b[?2004h> "]
[915.388135, "o", "        else hi = mid - 1;\r\n\u001b[?2004l\r"]
[915.388196, "o", "\u001b[?2004h> "]
[915.388271, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.388343, "o", "> "]
[915.388415, "o", "    return -1;\r\n\u001b[?2004l\r"]
[915.388484, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[915.388556, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.388626, "o", "\u001b[?2004h> "]
[915.388922, "o", "static CSRMatrix *csr_copy(const CSRMatrix *A)\r\n\u001b[?2004l\r"]
[915.388983, "o", "\u001b[?2004h> {\r\n"]
[915.389055, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[915.389445, "o", "    CSRMatrix *B = csr_create(A->rows, A->cols, A->nnz);\r\n\u001b[?2004l\r"]
[915.389513, "o", "\u001b[?2004h> "]
[915.389679, "o", "    if (!B) return NULL;\r\n\u001b[?2004l\r"]
[915.389739, "o", "\u001b[?2004h> "]
[915.390147, "o", "    memcpy(B->values, A->values, A->nnz * sizeof(double));\r\n\u001b[?2004l\r"]
[915.390177, "o", "\u001b[?2004h"]
[915.39026, "o", "> "]
[915.390658, "o", "    memcpy(B->col_indices, A->col_indices, A->nnz * sizeof(int));\r\n\u001b[?2004l\r"]
[915.390717, "o", "\u001b[?2004h> "]
[915.391168, "o", "    memcpy(B->row_ptr, A->row_ptr, (A->rows + 1) * sizeof(int));\r\n\u001b[?2004l\r"]
[915.39123, "o", "\u001b[?2004h> "]
[915.391335, "o", "    return B;\r\n\u001b[?2004l\r"]
[915.391395, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[915.391467, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.391535, "o", "\u001b[?2004h> "]
[915.39179, "o", "static int ilu0_factorize(CSRMatrix *LU)\r\n\u001b[?2004l\r"]
[915.39185, "o", "\u001b[?2004h> {\r\n"]
[915.391938, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[915.392087, "o", "    int n = LU->rows;\r\n\u001b[?2004l\r"]
[915.392142, "o", "\u001b[?2004h> "]
[915.392378, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[915.392441, "o", "\u001b[?2004h> "]
[915.392881, "o", "        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n\u001b[?2004l\r"]
[915.392942, "o", "\u001b[?2004h> "]
[915.393218, "o", "            int c = LU->col_indices[k];\r\n\u001b[?2004l\r"]
[915.393267, "o", "\u001b[?2004h> "]
[915.393494, "o", "            if (c >= i) break;\r\n\u001b[?2004l\r"]
[915.393578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.393643, "o", "\u001b[?2004h> "]
[915.39392, "o", "            int d = find_in_row(LU, c, c);\r\n\u001b[?2004l\r"]
[915.393978, "o", "\u001b[?2004h> "]
[915.394415, "o", "            if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;\r\n\u001b[?2004l\r"]
[915.394474, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.39452, "o", "\u001b[?2004h> "]
[915.394832, "o", "            LU->values[k] /= LU->values[d];\r\n\u001b[?2004l\r"]
[915.394905, "o", "\u001b[?2004h> "]
[915.39517, "o", "            double aik = LU->values[k];\r\n\u001b[?2004l\r"]
[915.395229, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.395298, "o", "\u001b[?2004h> "]
[915.395706, "o", "            for (int l = LU->row_ptr[c]; l < LU->row_ptr[c+1]; l++) {\r\n\u001b[?2004l\r"]
[915.395773, "o", "\u001b[?2004h> "]
[915.396019, "o", "                int j = LU->col_indices[l];\r\n\u001b[?2004l\r"]
[915.396082, "o", "\u001b[?2004h> "]
[915.396286, "o", "                if (j <= c) continue;\r\n\u001b[?2004l\r"]
[915.39635, "o", "\u001b[?2004h> "]
[915.396616, "o", "                int idx = find_in_row(LU, i, j);\r\n\u001b[?2004l\r"]
[915.396677, "o", "\u001b[?2004h> "]
[915.397076, "o", "                if (idx >= 0) LU->values[idx] -= aik * LU->values[l];\r\n\u001b[?2004l\r"]
[915.397136, "o", "\u001b[?2004h> "]
[915.397209, "o", "            }\r\n\u001b[?2004l\r"]
[915.39728, "o", "\u001b[?2004h> "]
[915.397359, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.397425, "o", ">     }\r\n\u001b[?2004l\r"]
[915.397508, "o", "\u001b[?2004h> "]
[915.39757, "o", "    return 0;\r\n\u001b[?2004l\r"]
[915.39764, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.39771, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[915.39778, "o", "> "]
[915.398182, "o", "static int ilu_forward_solve(const CSRMatrix *LU, const double *r, double *y)\r\n\u001b[?2004l\r"]
[915.398252, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[915.398321, "o", "\u001b[?2004h> "]
[915.398536, "o", "    for (int i = 0; i < LU->rows; i++) {\r\n\u001b[?2004l\r"]
[915.398596, "o", "\u001b[?2004h> "]
[915.398733, "o", "        double s = r[i];\r\n\u001b[?2004l\r"]
[915.398795, "o", "\u001b[?2004h> "]
[915.399169, "o", "        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n\u001b[?2004l\r"]
[915.399231, "o", "\u001b[?2004h> "]
[915.399435, "o", "            int j = LU->col_indices[k];\r\n\u001b[?2004l\r"]
[915.399496, "o", "\u001b[?2004h> "]
[915.399681, "o", "            if (j < i) s -= LU->values[k] * y[j];\r\n\u001b[?2004l\r"]
[915.399742, "o", "\u001b[?2004h> "]
[915.399813, "o", "            else break;\r\n\u001b[?2004l\r"]
[915.399899, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[915.39997, "o", "\u001b[?2004h> "]
[915.400041, "o", "        y[i] = s;\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.40011, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.400181, "o", ">     return 0;\r\n\u001b[?2004l\r"]
[915.400248, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[915.40032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.400653, "o", "static int ilu_backward_solve(const CSRMatrix *LU, const double *y, double *z)\r\n\u001b[?2004l\r"]
[915.400709, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[915.400777, "o", "\u001b[?2004h> "]
[915.400942, "o", "    for (int i = LU->rows - 1; i >= 0; i--) {\r\n\u001b[?2004l\r"]
[915.401, "o", "\u001b[?2004h> "]
[915.40109, "o", "        double s = y[i];\r\n\u001b[?2004l\r"]
[915.401161, "o", "\u001b[?2004h> "]
[915.401235, "o", "        int d = -1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.401517, "o", "        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n\u001b[?2004l\r"]
[915.401574, "o", "\u001b[?2004h> "]
[915.401723, "o", "            int j = LU->col_indices[k];\r\n\u001b[?2004l\r"]
[915.401779, "o", "\u001b[?2004h> "]
[915.401909, "o", "            if (j == i) d = k;\r\n\u001b[?2004l\r"]
[915.401956, "o", "\u001b[?2004h> "]
[915.402168, "o", "            else if (j > i) s -= LU->values[k] * z[j];\r\n\u001b[?2004l\r"]
[915.402233, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[915.402306, "o", "\u001b[?2004h> "]
[915.402541, "o", "        if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;\r\n\u001b[?2004l\r"]
[915.402598, "o", "\u001b[?2004h> "]
[915.402726, "o", "        z[i] = s / LU->values[d];\r\n\u001b[?2004l\r"]
[915.402786, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[915.402858, "o", "\u001b[?2004h> "]
[915.402951, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[915.403029, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.403101, "o", "\u001b[?2004h> "]
[915.403342, "o", "Precond *precond_create(const CSRMatrix *A, const char *name, double omega)\r\n\u001b[?2004l\r"]
[915.403399, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[915.403468, "o", "\u001b[?2004h> "]
[915.403666, "o", "    if (!A || !name || A->rows != A->cols) return NULL;\r\n\u001b[?2004l\r"]
[915.403727, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[915.403796, "o", "> "]
[915.420626, "o", "    Precond *P = (Precond *)calloc(1, sizeof(Precond));\r\n\u001b[?2004l\r"]
[915.420697, "o", "\u001b[?2004h> "]
[915.420834, "o", "    if (!P) return NULL;\r\n\u001b[?2004l\r"]
[915.420904, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.420977, "o", "\u001b[?2004h> "]
[915.421081, "o", "    P->n = A->rows;\r\n\u001b[?2004l\r"]
[915.421142, "o", "\u001b[?2004h> "]
[915.421375, "o", "    P->omega = (omega > 0.0) ? omega : 1.0;\r\n\u001b[?2004l\r"]
[915.421435, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.421506, "o", "\u001b[?2004h> "]
[915.421696, "o", "    if (strcmp(name, \"none\") == 0) {\r\n\u001b[?2004l\r"]
[915.421757, "o", "\u001b[?2004h> "]
[915.421943, "o", "        P->type = PRECOND_NONE;\r\n\u001b[?2004l\r"]
[915.422003, "o", "\u001b[?2004h> "]
[915.422256, "o", "    } else if (strcmp(name, \"jacobi\") == 0) {\r\n\u001b[?2004l\r"]
[915.422319, "o", "\u001b[?2004h> "]
[915.4225, "o", "        P->type = PRECOND_JACOBI;\r\n\u001b[?2004l\r"]
[915.422564, "o", "\u001b[?2004h> "]
[915.422751, "o", "        P->diag = csr_diagonal(A);\r\n\u001b[?2004l\r"]
[915.422812, "o", "\u001b[?2004h> "]
[915.423146, "o", "        if (!P->diag) { precond_destroy(P); return NULL; }\r\n\u001b[?2004l\r"]
[915.423212, "o", "\u001b[?2004h> "]
[915.423446, "o", "    } else if (strcmp(name, \"ilu0\") == 0) {\r\n\u001b[?2004l\r"]
[915.423507, "o", "\u001b[?2004h> "]
[915.42368, "o", "        P->type = PRECOND_ILU0;\r\n\u001b[?2004l\r"]
[915.423745, "o", "\u001b[?2004h> "]
[915.423911, "o", "        P->lu = csr_copy(A);\r\n\u001b[?2004l\r"]
[915.423977, "o", "\u001b[?2004h> "]
[915.424285, "o", "        if (!P->lu) { precond_destroy(P); return NULL; }\r\n\u001b[?2004l\r"]
[915.424349, "o", "\u001b[?2004h> "]
[915.424767, "o", "        if (ilu0_factorize(P->lu) != 0) { precond_destroy(P); return NULL; }\r\n\u001b[?2004l\r"]
[915.424828, "o", "\u001b[?2004h> "]
[915.425079, "o", "    } else if (strcmp(name, \"ssor\") == 0) {\r\n\u001b[?2004l\r"]
[915.425146, "o", "\u001b[?2004h> "]
[915.425316, "o", "        P->type = PRECOND_SSOR;\r\n\u001b[?2004l\r"]
[915.425379, "o", "\u001b[?2004h> "]
[915.4255, "o", "        P->ssor_A = A;\r\n\u001b[?2004l\r"]
[915.425563, "o", "\u001b[?2004h> "]
[915.425752, "o", "        P->diag = csr_diagonal(A);\r\n\u001b[?2004l\r"]
[915.425816, "o", "\u001b[?2004h> "]
[915.426142, "o", "        if (!P->diag) { precond_destroy(P); return NULL; }\r\n\u001b[?2004l\r"]
[915.426202, "o", "\u001b[?2004h> "]
[915.426274, "o", "    } else {\r\n\u001b[?2004l\r"]
[915.426349, "o", "\u001b[?2004h> "]
[915.426493, "o", "        precond_destroy(P);\r\n\u001b[?2004l\r"]
[915.426554, "o", "\u001b[?2004h> "]
[915.426668, "o", "        return NULL;\r\n\u001b[?2004l\r"]
[915.426731, "o", "\u001b[?2004h> "]
[915.426804, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[915.42688, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[915.426965, "o", "    return P;\r\n\u001b[?2004l\r"]
[915.427032, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[915.427102, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.427173, "o", "\u001b[?2004h> "]
[915.427332, "o", "void precond_destroy(Precond *P)\r\n\u001b[?2004l\r"]
[915.427393, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[915.427463, "o", "\u001b[?2004h> "]
[915.427572, "o", "    if (!P) return;\r\n\u001b[?2004l\r"]
[915.427638, "o", "\u001b[?2004h> "]
[915.427741, "o", "    free(P->diag);\r\n\u001b[?2004l\r"]
[915.427796, "o", "\u001b[?2004h> "]
[915.427933, "o", "    csr_destroy(P->lu);\r\n\u001b[?2004l\r"]
[915.427995, "o", "\u001b[?2004h> "]
[915.428065, "o", "    free(P);\r\n\u001b[?2004l\r"]
[915.428136, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[915.428205, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.428277, "o", "\u001b[?2004h> "]
[915.42868, "o", "int precond_apply(Precond *P, const CSRMatrix *A, const double *r, double *z)\r\n\u001b[?2004l\r"]
[915.428738, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[915.428809, "o", "\u001b[?2004h> "]
[915.429047, "o", "    int n = A ? A->rows : (P ? P->n : 0);\r\n\u001b[?2004l\r"]
[915.42911, "o", "\u001b[?2004h> "]
[915.429329, "o", "    if (!P || P->type == PRECOND_NONE) {\r\n\u001b[?2004l\r"]
[915.429389, "o", "\u001b[?2004h> "]
[915.429515, "o", "        vec_copy(r, z, n);\r\n\u001b[?2004l\r"]
[915.429575, "o", "\u001b[?2004h> "]
[915.42966, "o", "        return 0;\r\n\u001b[?2004l\r"]
[915.429735, "o", "\u001b[?2004h> "]
[915.429806, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.429889, "o", "\u001b[?2004h> "]
[915.429961, "o", "    switch (P->type) {\r\n\u001b[?2004l\r"]
[915.430031, "o", "\u001b[?2004h> "]
[915.430139, "o", "    case PRECOND_JACOBI:\r\n\u001b[?2004l\r"]
[915.4302, "o", "\u001b[?2004h> "]
[915.430377, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[915.430442, "o", "\u001b[?2004h> "]
[915.430692, "o", "            if (fabs(P->diag[i]) < 1e-15) return -1;\r\n\u001b[?2004l\r"]
[915.43075, "o", "\u001b[?2004h> "]
[915.430939, "o", "            z[i] = r[i] / P->diag[i];\r\n\u001b[?2004l\r"]
[915.431, "o", "\u001b[?2004h> "]
[915.431072, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.431181, "o", "        return 0;\r\n\u001b[?2004l\r"]
[915.43124, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.431314, "o", "\u001b[?2004h> "]
[915.431416, "o", "    case PRECOND_ILU0: {\r\n\u001b[?2004l\r"]
[915.431479, "o", "\u001b[?2004h> "]
[915.43163, "o", "        double *y = vec_create(n);\r\n\u001b[?2004l\r"]
[915.43169, "o", "\u001b[?2004h> "]
[915.431816, "o", "        if (!y) return -1;\r\n\u001b[?2004l\r"]
[915.431888, "o", "\u001b[?2004h> "]
[915.432237, "o", "        if (ilu_forward_solve(P->lu, r, y) != 0) { free(y); return -1; }\r\n\u001b[?2004l\r"]
[915.432295, "o", "\u001b[?2004h> "]
[915.432654, "o", "        if (ilu_backward_solve(P->lu, y, z) != 0) { free(y); return -1; }\r\n\u001b[?2004l\r"]
[915.432714, "o", "\u001b[?2004h> "]
[915.432785, "o", "        free(y);\r\n\u001b[?2004l\r"]
[915.432853, "o", "\u001b[?2004h> "]
[915.43293, "o", "        return 0;\r\n\u001b[?2004l\r"]
[915.433006, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[915.433072, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.433143, "o", "\u001b[?2004h> "]
[915.433246, "o", "    case PRECOND_SSOR: {\r\n\u001b[?2004l\r"]
[915.433306, "o", "\u001b[?2004h> "]
[915.433532, "o", "        const CSRMatrix *M = A ? A : P->ssor_A;\r\n\u001b[?2004l\r"]
[915.433592, "o", "\u001b[?2004h> "]
[915.433716, "o", "        if (!M) return -1;\r\n\u001b[?2004l\r"]
[915.433776, "o", "\u001b[?2004h> "]
[915.433901, "o", "        vec_zero(z, n);\r\n\u001b[?2004l\r"]
[915.43396, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.434031, "o", "\u001b[?2004h> "]
[915.434185, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[915.434244, "o", "\u001b[?2004h> "]
[915.434424, "o", "            double diag = P->diag[i];\r\n\u001b[?2004l\r"]
[915.434455, "o", "\u001b[?2004h"]
[915.434682, "o", "> "]
[915.434757, "o", "            if (fabs(diag) < 1e-15) return -1;\r\n\u001b[?2004l\r"]
[915.434829, "o", "\u001b[?2004h> "]
[915.434931, "o", "            double sum = 0.0;\r\n\u001b[?2004l\r"]
[915.434999, "o", "\u001b[?2004h> "]
[915.435303, "o", "            for (int k = M->row_ptr[i]; k < M->row_ptr[i+1]; k++) {\r\n\u001b[?2004l\r"]
[915.435366, "o", "\u001b[?2004h> "]
[915.435567, "o", "                int j = M->col_indices[k];\r\n\u001b[?2004l\r"]
[915.435634, "o", "\u001b[?2004h> "]
[915.43592, "o", "                if (j != i) sum += M->values[k] * z[j];\r\n\u001b[?2004l\r"]
[915.435952, "o", "\u001b[?2004h> "]
[915.436052, "o", "            }\r\n\u001b[?2004l\r"]
[915.436113, "o", "\u001b[?2004h> "]
[915.436489, "o", "            z[i] = (1.0 - P->omega) * z[i] + (P->omega / diag) * (r[i] - sum);\r\n\u001b[?2004l\r"]
[915.43655, "o", "\u001b[?2004h> "]
[915.436631, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.436857, "o", "        for (int i = n - 1; i >= 0; i--) {\r\n\u001b[?2004l\r"]
[915.436897, "o", "\u001b[?2004h> "]
[915.437103, "o", "            double diag = P->diag[i];\r\n\u001b[?2004l\r"]
[915.437159, "o", "\u001b[?2004h> "]
[915.437387, "o", "            if (fabs(diag) < 1e-15) return -1;\r\n\u001b[?2004l\r"]
[915.437444, "o", "\u001b[?2004h> "]
[915.437587, "o", "            double sum = 0.0;\r\n\u001b[?2004l\r"]
[915.437645, "o", "\u001b[?2004h> "]
[915.437978, "o", "            for (int k = M->row_ptr[i]; k < M->row_ptr[i+1]; k++) {\r\n\u001b[?2004l\r"]
[915.43804, "o", "\u001b[?2004h> "]
[915.43824, "o", "                int j = M->col_indices[k];\r\n\u001b[?2004l\r"]
[915.438301, "o", "\u001b[?2004h> "]
[915.438568, "o", "                if (j != i) sum += M->values[k] * z[j];\r\n\u001b[?2004l\r"]
[915.438627, "o", "\u001b[?2004h> "]
[915.438698, "o", "            }\r\n\u001b[?2004l\r"]
[915.438771, "o", "\u001b[?2004h> "]
[915.439147, "o", "            z[i] = (1.0 - P->omega) * z[i] + (P->omega / diag) * (r[i] - sum);\r\n\u001b[?2004l\r"]
[915.439215, "o", "\u001b[?2004h> "]
[915.439289, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.439399, "o", "        return 0;\r\n\u001b[?2004l\r"]
[915.439456, "o", "\u001b[?2004h> "]
[915.439528, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.439595, "o", "\u001b[?2004h> "]
[915.439667, "o", "    default:\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.439736, "o", "> "]
[915.439809, "o", "        vec_copy(r, z, n);\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.439893, "o", ">         return 0;\r\n\u001b[?2004l\r"]
[915.439973, "o", "\u001b[?2004h> "]
[915.440046, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[915.442796, "o", "\u001b[?2004hroot@n30009:/app# "]
[915.645442, "i", "cat > include/solvers.h <<'EOF'\n#ifndef SOLVERS_H\n#define SOLVERS_H\n\n#include \"sparse.h\"\n#include \"precond.h\"\n\ntypedef struct {\n    double *x;\n    double relres;\n    int iterations;\n    int converged;\n    double *history;\n    int history_len;\n} SolveResult;\n\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\n                      double tol, int maxiter, Precond *P);\n\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\n                         double tol, int maxiter, int m, Precond *P);\n\nvoid solve_result_destroy(SolveResult *res);\n\n#endif /* SOLVERS_H */\nEOF\n"]
[915.645714, "o", "cat > include/solvers.h <<'EOF'\r\n\u001b[?2004l\r"]
