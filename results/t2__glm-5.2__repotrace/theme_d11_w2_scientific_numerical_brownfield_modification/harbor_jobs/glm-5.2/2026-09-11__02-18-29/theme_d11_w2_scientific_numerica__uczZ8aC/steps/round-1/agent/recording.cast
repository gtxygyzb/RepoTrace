[1145.626661, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h"]
[1145.626715, "o", "> "]
[1145.626774, "o", "    free(r);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.62686, "o", "    free(x);\r\n\u001b[?2004l\r"]
[1145.626925, "o", "\u001b[?2004h> "]
[1145.626992, "o", "    free(b);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.627048, "o", "> "]
[1145.627105, "o", "    dm_destroy(A);\r\n\u001b[?2004l\r"]
[1145.627161, "o", "\u001b[?2004h> "]
[1145.627221, "o", "    return 0;\r\n\u001b[?2004l\r"]
[1145.627278, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1145.627336, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r;\u001b[?2004h"]
[1145.627392, "o", "> "]
[1145.62758, "o", "static int parse_bc(const char *s, PoissonBC *bc)\r\n\u001b[?2004l\r"]
[1145.627635, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[1145.62769, "o", "\u001b[?2004h> "]
[1145.627851, "o", "    const char *colon = strchr(s, ':');\r\n\u001b[?2004l\r"]
[1145.627914, "o", "\u001b[?2004h> "]
[1145.628085, "o", "    if (!colon || colon == s) return -1;\r\n\u001b[?2004l\r"]
[1145.62814, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h"]
[1145.628197, "o", "> "]
[1145.628298, "o", "    size_t len = colon - s;\r\n\u001b[?2004l\r"]
[1145.628354, "o", "\u001b[?2004h> "]
[1145.628426, "o", "    char type[32];\r\n\u001b[?2004l\r"]
[1145.628482, "o", "\u001b[?2004h> "]
[1145.628645, "o", "    if (len >= sizeof(type)) return -1;\r\n\u001b[?2004l\r"]
[1145.6287, "o", "\u001b[?2004h> "]
[1145.628802, "o", "    memcpy(type, s, len);\r\n\u001b[?2004l\r"]
[1145.628857, "o", "\u001b[?2004h> "]
[1145.628927, "o", "    type[len] = '\\0';\r\n\u001b[?2004l\r"]
[1145.628984, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h"]
[1145.629039, "o", "> "]
[1145.629322, "o", "    if (strcmp(type, \"dirichlet\") == 0) bc->type = POISSON_DIRICHLET;\r\n\u001b[?2004l\r"]
[1145.629378, "o", "\u001b[?2004h> "]
[1145.62967, "o", "    else if (strcmp(type, \"neumann\") == 0) bc->type = POISSON_NEUMANN;\r\n\u001b[?2004l\r"]
[1145.629725, "o", "\u001b[?2004h> "]
[1145.629793, "o", "    else return -1;\r\n\u001b[?2004l\r"]
[1145.629849, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rc\u001b[?2004h> "]
[1145.629979, "o", "    bc->file = colon + 1;\r\n\u001b[?2004l\r"]
[1145.630035, "o", "\u001b[?2004h> "]
[1145.630102, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1145.630159, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h"]
[1145.630214, "o", "> "]
