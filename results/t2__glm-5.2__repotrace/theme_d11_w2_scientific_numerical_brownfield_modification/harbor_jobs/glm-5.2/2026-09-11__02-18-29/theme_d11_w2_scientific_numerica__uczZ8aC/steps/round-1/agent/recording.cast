[8056.725587, "o", "    if (method == 2) {\r\n\u001b[?2004l\r"]
[8056.725667, "o", "\u001b[?2004h> "]
[8056.725896, "o", "        if (!shift_s) {\r\n\u001b[?2004l\r"]
[8056.72598, "o", "\u001b[?2004h> "]
[8056.726569, "o", "            fprintf(stderr, \"Error: --shift is required for shifted-inverse\\n\");\r\n\u001b[?2004l\r"]
[8056.726653, "o", "\u001b[?2004h> "]
[8056.726863, "o", "            return 1;\r\n\u001b[?2004l\r"]
[8056.726962, "o", "\u001b[?2004h> "]
[8056.727075, "o", "        }\r\n\u001b[?2004l\r"]
[8056.727156, "o", "\u001b[?2004h> "]
[8056.727551, "o", "        if (parse_double(shift_s, &sigma) != 0) {\r\n\u001b[?2004l\r"]
[8056.727649, "o", "\u001b[?2004h> "]
[8056.728166, "o", "            fprintf(stderr, \"Error: invalid shift '%s'\\n\", shift_s);\r\n\u001b[?2004l\r"]
[8056.728218, "o", "\u001b[?2004h"]
[8056.728316, "o", "> "]
[8056.728487, "o", "            return 1;\r\n\u001b[?2004l\r"]
[8056.728567, "o", "\u001b[?2004h> "]
[8056.728685, "o", "        }\r\n\u001b[?2004l\r"]
[8056.728765, "o", "\u001b[?2004h> "]
[8056.728844, "o", "    }\r\n"]
[8056.728933, "o", "\u001b[?2004l\r\u001b[?2004h"]
[8056.729011, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[8056.729089, "o", "> "]
[8056.729451, "o", "    double tol, omega = 1.0, solver_tol = 1e-12;\r\n\u001b[?2004l\r"]
[8056.729532, "o", "\u001b[?2004h> "]
[8056.729961, "o", "    int maxiter, restart = 30, solver_maxiter = 1000;\r\n\u001b[?2004l\r"]
[8056.730042, "o", "\u001b[?2004h> \r\n"]
[8056.730121, "o", "\u001b[?2004l\r\u001b[?2004h"]
[8056.7302, "o", "> "]
[8056.730602, "o", "    if (parse_double(tol_s, &tol) != 0 || tol <= 0.0) {\r\n\u001b[?2004l\r"]
[8056.730682, "o", "\u001b[?2004h> "]
[8056.731177, "o", "        fprintf(stderr, \"Error: invalid tol '%s'\\n\", tol_s);\r\n\u001b[?2004l\r"]
[8056.731259, "o", "\u001b[?2004h> "]
[8056.731436, "o", "        return 1;\r\n\u001b[?2004l\r"]
[8056.731517, "o", "\u001b[?2004h> "]
[8056.731606, "o", "    }\r\n\u001b[?2004l\r"]
[8056.731687, "o", "\u001b[?2004h> "]
[8056.732054, "o", "    if (parse_int(maxiter_s, &maxiter) != 0) {\r\n\u001b[?2004l\r"]
[8056.732103, "o", "\u001b[?2004h"]
[8056.732196, "o", "> "]
[8056.732672, "o", "        fprintf(stderr, \"Error: invalid maxiter '%s'\\n\", maxiter_s);\r\n\u001b[?2004l\r"]
[8056.732751, "o", "\u001b[?2004h> "]
[8056.732943, "o", "        return 1;\r\n\u001b[?2004l\r"]
[8056.733015, "o", "\u001b[?2004h> "]
[8056.733082, "o", "    }\r\n\u001b[?2004l\r"]
[8056.733149, "o", "\u001b[?2004h> "]
[8056.733565, "o", "    if (strcmp(solver, \"cg\") != 0 && strcmp(solver, \"gmres\") != 0) {\r\n\u001b[?2004l\r"]
[8056.733626, "o", "\u001b[?2004h> "]
[8056.734027, "o", "        fprintf(stderr, \"Error: unknown solver '%s'\\n\", solver);\r\n\u001b[?2004l\r"]
[8056.73409, "o", "\u001b[?2004h> "]
[8056.734207, "o", "        return 1;\r\n\u001b[?2004l\r"]
[8056.734261, "o", "\u001b[?2004h> "]
[8056.734333, "o", "    }\r\n\u001b[?2004l\r"]
[8056.734396, "o", "\u001b[?2004h> "]
[8056.734818, "o", "    if (strcmp(precond, \"none\") != 0 && strcmp(precond, \"jacobi\") != 0 &&\r\n\u001b[?2004l\r"]
[8056.73489, "o", "\u001b[?2004h> "]
[8056.735313, "o", "        strcmp(precond, \"ilu0\") != 0 && strcmp(precond, \"ssor\") != 0) {\r\n\u001b[?2004l\r"]
[8056.735354, "o", "\u001b[?2004h> "]
[8056.735823, "o", "        fprintf(stderr, \"Error: unknown preconditioner '%s'\\n\", precond);\r\n\u001b[?2004l\r"]
[8056.735899, "o", "\u001b[?2004h> "]
[8056.736032, "o", "        return 1;\r\n\u001b[?2004l\r"]
[8056.736104, "o", "\u001b[?2004h> "]
[8056.736179, "o", "    }\r\n\u001b[?2004l\r"]
[8056.736247, "o", "\u001b[?2004h> "]
[8056.736373, "o", "    if (omega_s) {\r\n\u001b[?2004l\r"]
[8056.73644, "o", "\u001b[?2004h"]
[8056.736502, "o", "> "]
[8056.73692, "o", "        if (parse_double(omega_s, &omega) != 0 || !(omega > 0.0 && omega < 2.0)) {\r\n\u001b[?2004l\r"]
[8056.736983, "o", "\u001b[?2004h> "]
[8056.73738, "o", "            fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n\u001b[?2004l\r"]
[8056.737445, "o", "\u001b[?2004h> "]
[8056.73759, "o", "            return 1;\r\n\u001b[?2004l\r"]
[8056.737653, "o", "\u001b[?2004h> "]
[8056.737736, "o", "        }\r\n\u001b[?2004l\r"]
[8056.737792, "o", "\u001b[?2004h> "]
[8056.737856, "o", "    }\r\n\u001b[?2004l\r"]
[8056.737929, "o", "\u001b[?2004h> "]
[8056.738264, "o", "    if (restart_s && parse_int(restart_s, &restart) != 0) {\r\n\u001b[?2004l\r"]
[8056.738325, "o", "\u001b[?2004h> "]
[8056.738702, "o", "        fprintf(stderr, \"Error: invalid restart '%s'\\n\", restart_s);\r\n\u001b[?2004l\r"]
[8056.738757, "o", "\u001b[?2004h> "]
[8056.738896, "o", "        return 1;\r\n\u001b[?2004l\r"]
[8056.738963, "o", "\u001b[?2004h> "]
[8056.739025, "o", "    }\r\n\u001b[?2004l\r"]
[8056.739081, "o", "\u001b[?2004h> "]
[8056.739604, "o", "    if (solver_tol_s && (parse_double(solver_tol_s, &solver_tol) != 0 || solver_tol <= 0.0)) {\r\n\u001b[?2004l\r"]
[8056.739666, "o", "\u001b[?2004h> "]
[8056.740126, "o", "        fprintf(stderr, \"Error: invalid solver-tol '%s'\\n\", solver_tol_s);\r\n\u001b[?2004l\r"]
[8056.740189, "o", "\u001b[?2004h> "]
[8056.740314, "o", "        return 1;\r\n\u001b[?2004l\r"]
[8056.740369, "o", "\u001b[?2004h"]
[8056.740431, "o", ">     }\r\n"]
[8056.740493, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[8056.740972, "o", "    if (solver_maxiter_s && parse_int(solver_maxiter_s, &solver_maxiter) != 0) {\r\n\u001b[?2004l\r"]
[8056.741034, "o", "\u001b[?2004h> "]
[8056.741511, "o", "        fprintf(stderr, \"Error: invalid solver-maxiter '%s'\\n\", solver_maxiter_s);\r\n\u001b[?2004l\r"]
[8056.741575, "o", "\u001b[?2004h> "]
[8056.741701, "o", "        return 1;\r\n\u001b[?2004l\r"]
[8056.741773, "o", "\u001b[?2004h> "]
[8056.741848, "o", "    }\r\n\u001b[?2004l\r"]
[8056.741894, "o", "\u001b[?2004h> "]
[8056.741976, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.742237, "o", "    CSRMatrix *A = csr_read_mm(input);\r\n\u001b[?2004l\r"]
[8056.742301, "o", "\u001b[?2004h> "]
[8056.742405, "o", "    if (!A) {\r\n\u001b[?2004l\r"]
[8056.742444, "o", "\u001b[?2004h> "]
[8056.742897, "o", "        fprintf(stderr, \"Error: cannot read sparse matrix from '%s'\\n\", input);\r\n\u001b[?2004l\r"]
[8056.742966, "o", "\u001b[?2004h"]
[8056.743034, "o", "> "]
[8056.743117, "o", "        return 1;\r\n\u001b[?2004l\r"]
[8056.743182, "o", "\u001b[?2004h"]
[8056.74325, "o", ">     }\r\n"]
[8056.743317, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[8056.743495, "o", "    if (A->rows != A->cols) {\r\n\u001b[?2004l\r"]
[8056.743557, "o", "\u001b[?2004h> "]
[8056.743888, "o", "        fprintf(stderr, \"Error: eigenvalue requires a square matrix\\n\");\r\n\u001b[?2004l\r"]
[8056.743941, "o", "\u001b[?2004h> "]
[8056.744021, "o", "        csr_destroy(A);\r\n\u001b[?2004l\r"]
[8056.744075, "o", "\u001b[?2004h> "]
[8056.744137, "o", "        return 1;\r\n\u001b[?2004l\r"]
[8056.744191, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[8056.744236, "o", "\u001b[?2004h> \r\n"]
[8056.744288, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[8056.744436, "o", "    int n = A->rows;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.744526, "o", "    double *v = vec_create(n);\r\n\u001b[?2004l\r"]
[8056.744614, "o", "\u001b[?2004h> "]
[8056.744677, "o", "    double *w = vec_create(n);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.744773, "o", "    double *Av = vec_create(n);\r\n\u001b[?2004l\r\u001b[?2004h"]
[8056.74483, "o", "> "]
[8056.744908, "o", "    if (!v || !w || !Av) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.745073, "o", "        fprintf(stderr, \"Error: allocation failed\\n\");\r\n\u001b[?2004l\r"]
[8056.74513, "o", "\u001b[?2004h> "]
[8056.745206, "o", "        free(v); free(w); free(Av);\r\n\u001b[?2004l\r\u001b[?2004h"]
[8056.745262, "o", "> "]
[8056.745319, "o", "        csr_destroy(A);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.745384, "o", "        return 1;\r\n\u001b[?2004l\r"]
[8056.745439, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[8056.745506, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.745581, "o", "    init_random_vector(v, n);\r\n\u001b[?2004l\r"]
[8056.745646, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[8056.745707, "o", ">     int converged = 0;\r\n\u001b[?2004l\r"]
[8056.745763, "o", "\u001b[?2004h> "]
[8056.745825, "o", "    int iterations = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.745928, "o", "    double eigenvalue = NAN;\r\n\u001b[?2004l\r"]
[8056.745984, "o", "\u001b[?2004h> "]
[8056.746044, "o", "    double prev_lambda = NAN;\r\n\u001b[?2004l\r"]
[8056.746098, "o", "\u001b[?2004h> "]
[8056.746161, "o", "    CSRMatrix *S = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.746263, "o", "    const CSRMatrix *OpA = A;\r\n\u001b[?2004l\r"]
[8056.746318, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.746393, "o", "    if (method == 2) {\r\n\u001b[?2004l\r"]
[8056.746449, "o", "\u001b[?2004h> "]
[8056.746543, "o", "        S = make_shifted_matrix(A, sigma);\r\n\u001b[?2004l\r"]
[8056.746598, "o", "\u001b[?2004h> "]
[8056.746654, "o", "        if (!S) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.74682, "o", "            fprintf(stderr, \"Error: allocation failed\\n\");\r\n\u001b[?2004l\r"]
[8056.746884, "o", "\u001b[?2004h> "]
[8056.746972, "o", "            free(v); free(w); free(Av);\r\n\u001b[?2004l\r"]
[8056.747026, "o", "\u001b[?2004h> "]
[8056.747081, "o", "            csr_destroy(A);\r\n\u001b[?2004l\r"]
[8056.747136, "o", "\u001b[?2004h> "]
[8056.747194, "o", "            return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.747249, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.747311, "o", "        OpA = S;\r\n\u001b[?2004l\r"]
[8056.747366, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[8056.747425, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.747563, "o", "    for (int iter = 0; iter < maxiter; iter++) {\r\n\u001b[?2004l\r"]
[8056.747618, "o", "\u001b[?2004h> "]
[8056.747673, "o", "        if (method == 0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[8056.747728, "o", "> "]
[8056.747789, "o", "            csr_spmv(A, v, w);\r\n\u001b[?2004l\r"]
[8056.747845, "o", "\u001b[?2004h> "]
[8056.747945, "o", "            double nrm = vec_norm2(w, n);\r\n\u001b[?2004l\r"]
[8056.748001, "o", "\u001b[?2004h> "]
[8056.748067, "o", "            if (nrm < 1e-300) {\r\n\u001b[?2004l\r"]
[8056.748123, "o", "\u001b[?2004h> "]
[8056.748199, "o", "                eigenvalue = 0.0;\r\n\u001b[?2004l\r"]
[8056.748254, "o", "\u001b[?2004h> "]
[8056.748317, "o", "                break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.748381, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.748547, "o", "            for (int i = 0; i < n; i++) w[i] /= nrm;\r\n\u001b[?2004l\r"]
[8056.748602, "o", "\u001b[?2004h> "]
[8056.748668, "o", "            csr_spmv(A, w, Av);\r\n\u001b[?2004l\r"]
[8056.748724, "o", "\u001b[?2004h> "]
[8056.748822, "o", "            eigenvalue = vec_dot(w, Av, n);\r\n\u001b[?2004l\r"]
[8056.748885, "o", "\u001b[?2004h> "]
[8056.748991, "o", "            memcpy(v, w, n * sizeof(double));\r\n\u001b[?2004l\r"]
[8056.749047, "o", "\u001b[?2004h> "]
[8056.749101, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.749175, "o", "            int fail = 0;\r\n\u001b[?2004l\r"]
[8056.74923, "o", "\u001b[?2004h> "]
[8056.749561, "o", "            SolveResult *res = solve_linear_system(OpA, v, solver, precond, solver_tol, solver_maxiter, restart, omega, &fail);\r\n\u001b[?2004l\r"]
[8056.749619, "o", "\u001b[?2004h> "]
[8056.749737, "o", "            if (!res || !res->converged || fail) {\r\n\u001b[?2004l\r"]
[8056.749791, "o", "\u001b[?2004h> "]
[8056.749864, "o", "                eigenvalue = NAN;\r\n\u001b[?2004l\r"]
[8056.749926, "o", "\u001b[?2004h> "]
[8056.750045, "o", "                if (res) solve_result_destroy(res);\r\n\u001b[?2004l\r"]
[8056.750102, "o", "\u001b[?2004h> "]
[8056.750162, "o", "                break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.750229, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.750375, "o", "            double nrm = vec_norm2(res->x, n);\r\n\u001b[?2004l\r"]
[8056.750431, "o", "\u001b[?2004h> "]
[8056.750495, "o", "            if (nrm < 1e-300) {\r\n\u001b[?2004l\r"]
[8056.750552, "o", "\u001b[?2004h> "]
[8056.750621, "o", "                eigenvalue = NAN;\r\n\u001b[?2004l\r"]
[8056.750677, "o", "\u001b[?2004h> "]
[8056.750772, "o", "                solve_result_destroy(res);\r\n\u001b[?2004l\r"]
[8056.750827, "o", "\u001b[?2004h> "]
[8056.750895, "o", "                break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.750943, "o", "            }\r\n\u001b[?2004l\r"]
[8056.750974, "o", "\u001b[?2004h> "]
[8056.751158, "o", "            for (int i = 0; i < n; i++) w[i] = res->x[i] / nrm;\r\n\u001b[?2004l\r"]
[8056.751213, "o", "\u001b[?2004h> "]
[8056.751283, "o", "            csr_spmv(OpA, w, Av);\r\n\u001b[?2004l\r"]
[8056.751339, "o", "\u001b[?2004h> "]
[8056.751435, "o", "            double rq = vec_dot(w, Av, n);\r\n\u001b[?2004l\r"]
[8056.75149, "o", "\u001b[?2004h> "]
[8056.751569, "o", "            if (fabs(rq) < 1e-300) {\r\n\u001b[?2004l\r"]
[8056.751624, "o", "\u001b[?2004h> "]
[8056.751695, "o", "                eigenvalue = NAN;\r\n\u001b[?2004l\r"]
[8056.751751, "o", "\u001b[?2004h> "]
[8056.751846, "o", "                solve_result_destroy(res);\r\n\u001b[?2004l\r"]
[8056.751907, "o", "\u001b[?2004h> "]
[8056.75197, "o", "                break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.752031, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.752138, "o", "            if (method == 1) {\r\n\u001b[?2004l\r"]
[8056.752193, "o", "\u001b[?2004h> "]
[8056.752279, "o", "                eigenvalue = 1.0 / rq;\r\n\u001b[?2004l\r"]
[8056.752334, "o", "\u001b[?2004h> "]
[8056.75239, "o", "            } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.752531, "o", "                eigenvalue = sigma + 1.0 / rq;\r\n\u001b[?2004l\r"]
[8056.752586, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[8056.752654, "o", "\u001b[?2004h> "]
[8056.75276, "o", "            memcpy(v, w, n * sizeof(double));\r\n\u001b[?2004l\r"]
[8056.752815, "o", "\u001b[?2004h> "]
[8056.752905, "o", "            solve_result_destroy(res);\r\n\u001b[?2004l\r"]
[8056.75296, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[8056.753015, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.753113, "o", "        iterations = iter + 1;\r\n\u001b[?2004l\r"]
[8056.753168, "o", "\u001b[?2004h> "]
[8056.753315, "o", "        if (!isnan(prev_lambda) && fabs(eigenvalue) > 0.0) {\r\n\u001b[?2004l\r"]
[8056.75337, "o", "\u001b[?2004h> "]
[8056.753556, "o", "            if (fabs(eigenvalue - prev_lambda) / fabs(eigenvalue) < tol) {\r\n\u001b[?2004l\r"]
[8056.753611, "o", "\u001b[?2004h> "]
[8056.753674, "o", "                converged = 1;\r\n\u001b[?2004l\r"]
[8056.753729, "o", "\u001b[?2004h> "]
[8056.753784, "o", "                break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.753839, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[8056.753925, "o", "\u001b[?2004h>         prev_lambda = eigenvalue;\r\n\u001b[?2004l\r"]
[8056.75398, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8056.754035, "o", "\u001b[?2004h> "]
[8056.754094, "o", "    if (!isnan(eigenvalue)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.754158, "o", "        csr_spmv(A, v, Av);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.754238, "o", "        double Avn = vec_norm2(Av, n);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.754328, "o", "        double vn = vec_norm2(v, n);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.754395, "o", "        if (vn > 0.0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.754513, "o", "            for (int i = 0; i < n; i++) v[i] /= vn;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.754632, "o", "            for (int i = 0; i < n; i++) Av[i] /= vn;\r\n\u001b[?2004l\r\u001b[?2004h> "]
