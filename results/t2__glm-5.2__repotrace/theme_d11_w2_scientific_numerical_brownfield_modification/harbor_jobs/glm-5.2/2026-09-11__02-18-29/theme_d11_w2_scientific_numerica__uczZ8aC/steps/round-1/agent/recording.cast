[4012.744588, "o", "        return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4012.744676, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4012.744768, "o", "\u001b[?2004h> "]
