[11246.280353, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/solvers.c')\ns = p.read_text()\n\n# Add bnorm_inf in CG if missing\nif 'bnorm_inf' not in s:\n    s = s.replace('    double bnorm = vec_norm2(b, n);\\n    if (bnorm == 0.0) bnorm = 1.0;\\n\\n',\n                  '    double bnorm = vec_norm2(b, n);\\n    if (bnorm == 0.0) bnorm = 1.0;\\n    double bnorm_inf = vec_norm_inf(b, n);\\n    if (bnorm_inf == 0.0) bnorm_inf = 1.0;\\n\\n', 1)\n\n# Add bnorm_inf in GMRES if still missing (second occurrence)\nif s.count('bnorm_inf') < 2:\n    s = s.replace('    double bnorm = vec_norm2(b, n);\\n    if (bnorm == 0.0) bnorm = 1.0;\\n\\n',\n                  '    double bnorm = vec_norm2(b, n);\\n    if (bnorm == 0.0) bnorm = 1.0;\\n    double bnorm_inf = vec_norm_inf(b, n);\\n    if (bnorm_inf == 0.0) bnorm_inf = 1.0;\\n\\n', 1)\n\n# Add inf residual assignments after 2-norm residual assignments\ns = s.replace('res->true_residual = vec_norm2(r, n);\\n    res->relres = res->true_residual / bnorm;\\n',\n              'res->true_residual = vec_norm2(r"]
[11246.280608, "i", ", n);\\n    res->relres = res->true_residual / bnorm;\\n    res->true_residual_inf = vec_norm_inf(r, n);\\n    res->relres_inf = res->true_residual_inf / bnorm_inf;\\n')\ns = s.replace('res->true_residual = vec_norm2(r, n);\\n        res->relres = res->true_residual / bnorm;\\n',\n              'res->true_residual = vec_norm2(r, n);\\n        res->relres = res->true_residual / bnorm;\\n        res->true_residual_inf = vec_norm_inf(r, n);\\n        res->relres_inf = res->true_residual_inf / bnorm_inf;\\n')\n\np.write_text(s)\nPY\n"]
[11246.2807, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[11246.280788, "o", ", n);\\n    res->relres = res->true_residual / bnorm;\\n    res->true_residual_inf = vec_norm_inf(r, n);\\n    res->relres_inf = res->true_residual_inf / bnorm_inf;\\n')\r\ns = s.replace('res->true_residual = vec_norm"]
[11246.280856, "o", "2(r, n);\\n        res->relres = res->true_residual / bnorm;\\n',\r\n              'res->true_resid"]
[11246.280954, "o", "ual = vec_norm2(r, n);\\n        res->relres = res->true_residual / bnorm;\\n        res->true"]
[11246.28102, "o", "_residual_inf = vec_norm_inf(r, n);\\n        res->relres_inf = res->true_resid"]
[11246.281051, "o", "ual_inf / bnorm_inf;\\n')\r\n\r\np.write_text(s)\r\nPY\r\n"]
