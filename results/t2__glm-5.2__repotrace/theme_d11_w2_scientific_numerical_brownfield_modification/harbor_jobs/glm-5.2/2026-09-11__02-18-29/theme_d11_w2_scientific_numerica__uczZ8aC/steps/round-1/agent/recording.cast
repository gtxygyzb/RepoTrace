[1145.631476, "o", "\u001b[?2004h> "]
[1145.631665, "o", "                                const char *history)\r\n\u001b[?2004l\r"]
[1145.631721, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.631777, "o", "> "]
[1145.631962, "o", "    Precond *P = precond_create(A, precond, omega);\r\n\u001b[?2004l\r"]
[1145.632019, "o", "\u001b[?2004h> "]
[1145.632075, "o", "    if (!P) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.632422, "o", "        fprintf(stderr, \"Error: cannot create preconditioner '%s'\\n\", precond);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.632478, "o", "> "]
[1145.632529, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.632585, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.632645, "o", "> \r\n\u001b[?2004l\r|\u001b[?2004h> "]
[1145.632768, "o", "    SolveResult *res = NULL;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.632823, "o", "> "]
[1145.632957, "o", "    if (strcmp(solver, \"cg\") == 0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.633012, "o", "> "]
[1145.633205, "o", "        res = cg_solve(A, b, NULL, tol, maxiter, P);\r\n\u001b[?2004l\r"]
[1145.633262, "o", "\u001b[?2004h> "]
[1145.633429, "o", "    } else if (strcmp(solver, \"gmres\") == 0) {\r\n\u001b[?2004l\r"]
[1145.633485, "o", "\u001b[?2004h> "]
[1145.633727, "o", "        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);\r\n\u001b[?2004l\r"]
[1145.633783, "o", "\u001b[?2004h> "]
[1145.633839, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.63413, "o", "        fprintf(stderr, \"Error: unknown solver '%s'\\n\", solver);\r\n\u001b[?2004l\r"]
[1145.634189, "o", "\u001b[?2004h> "]
[1145.634288, "o", "        precond_destroy(P);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.634344, "o", "> "]
[1145.634396, "o", "        return 1;\r\n\u001b[?2004l\r"]
[1145.634452, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1145.634511, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[1145.634596, "o", "    if (!res) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.634651, "o", "> "]
[1145.634892, "o", "        fprintf(stderr, \"Error: solver allocation failed\\n\");\r\n\u001b[?2004l\r"]
[1145.634949, "o", "\u001b[?2004h> "]
[1145.635046, "o", "        precond_destroy(P);\r\n\u001b[?2004l\r"]
[1145.635102, "o", "\u001b[?2004h> "]
[1145.635155, "o", "        return 1;\r\n\u001b[?2004l\r"]
[1145.635209, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1145.635268, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rf\u001b[?2004h> "]
[1145.63541, "o", "    print_solve_summary(res);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.635465, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[1145.635758, "o", "    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.635813, "o", "> "]
[1145.636086, "o", "        fprintf(stderr, \"Error: cannot write output to '%s'\\n\", output);\r\n\u001b[?2004l\r"]
[1145.636143, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1145.636199, "o", "\u001b[?2004h> "]
[1145.636418, "o", "    if (history && write_history_file(res, history) != 0) {\r\n\u001b[?2004l\r"]
[1145.636476, "o", "\u001b[?2004h> "]
[1145.636772, "o", "        fprintf(stderr, \"Error: cannot write history to '%s'\\n\", history);\r\n\u001b[?2004l\r"]
[1145.636828, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1145.6369, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.637034, "o", "    solve_result_destroy(res);\r\n\u001b[?2004l\r"]
[1145.63709, "o", "\u001b[?2004h> "]
[1145.637167, "o", "    precond_destroy(P);\r\n\u001b[?2004l\r"]
[1145.637224, "o", "\u001b[?2004h> "]
[1145.63728, "o", "    return 0;\r\n\u001b[?2004l\r&\u001b[?2004h> }\r\n"]
[1145.637336, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rp"]
[1145.637391, "o", "\u001b[?2004h> "]
[1145.637583, "o", "static int cmd_sparse_solve(int argc, char **argv)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.637639, "o", "> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.637895, "o", "    const char *input = get_opt(argc, argv, \"--input\");\r\n\u001b[?2004l\r"]
[1145.637951, "o", "\u001b[?2004h> "]
