[5563.796412, "o", "cat Makefile\r\n\u001b[?2004l\r"]
[5563.798461, "o", ".RECIPEPREFIX := >\r\n\r\nCC      = gcc\r\nCFLAGS  = -Wall -Wextra -O2 -Iinclude\r\nLDFLAGS = -lm\r\n\r\nSRC     = src/main.c src/dense.c src/vector.c src/io.c src/sparse.c src/precond.c src/solvers.c src/poisson.c src/heat.c\r\nOBJ     = $(SRC:.c=.o)\r\nBIN     = numsim\r\n\r\n.PHONY: all clean\r\n\r\nall: $(BIN)\r\n\r\n$(BIN): $(SRC)\r\n>$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)\r\n\r\nclean:\r\n>rm -f $(BIN) $(OBJ)\r\n"]
[5563.7988, "o", "\u001b[?2004hroot@n30009:/app# "]
[5564.066288, "i", "sed -n '1,240p' include/poisson.h\n"]
[5564.066483, "o", "sed -n '1,240p' include/poisson.h\r\n\u001b[?2004l\r"]
[5564.069314, "o", "#ifndef POISSON_H\r\n#define POISSON_H\r\n\r\n#include \"sparse.h\"\r\n\r\ntypedef enum {\r\n    POISSON_DIRICHLET,\r\n    POISSON_NEUMANN\r\n} PoissonBCType;"]
[5564.06939, "o", "\r\n\r\ntypedef struct {\r\n    PoissonBCType type;\r\n    const char *file;\r\n} PoissonBC;\r\n\r\nint poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n                    const char *source_file, PoissonBC left, PoissonBC right,\r\n                    PoissonBC bottom, PoissonBC top,\r\n                    CSRMatrix **A_out, double **b_out);\r\n"]
[5564.069461, "o", "\r\ndouble *poisson_read_source(const char *filename, int nx, int ny);\r\ndouble *poisson_read_boundary(const char *filename, int expected);\r\n\r\n#endif /* POISSON_H */\r\n"]
[5564.069864, "o", "\u001b[?2004hroot@n30009:/app# "]
[5564.342834, "i", "sed -n '1,260p' src/main.c\n"]
[5564.343112, "o", "sed -n '1,260p' src/main.c\r\n\u001b[?2004l\r"]
[5564.345866, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include \"dense.h\"\r\n#include \"vector.h\"\r\n#include \"io.h\""]
[5564.34595, "o", "\r\n#include \"sparse.h\"\r\n#include \"precond.h\"\r\n#include \"solvers.h\"\r\n#include \"poisson.h\"\r\n#include \"heat.h\"\r\n\r\nstatic void usage(const char *prog)\r\n{\r\n    fprintf(stderr, \"Usage:\\n\");\r\n    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\n\", prog);\r\n    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n"]
[5564.346029, "o", "    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s heat --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --alpha <float> --dt <float> --nsteps <int> --scheme <backward-euler|crank-nicolson> --ic <file> --source <file>[,<file>,...] --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file>\\n\", prog);\r\n}\r\n\r\nstatic const char *get_opt(int argc, "]
[5564.346102, "o", "char **argv, const char *name)\r\n{\r\n    for (int i = 0; i < argc - 1; i++) {\r\n        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    }\r\n    return NULL;\r\n}\r\n\r\nstatic int write_history_file(const SolveResult *res, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    for (int i = 0; i < res->history_len; i++) {\r\n        fprintf(fp, \"%d\\t%.15e\\n\", i, res->history[i]);\r\n    }\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n\r\nstatic void print_solve_summary(const SolveResult *res)\r\n{\r\n    printf(\"converged: %s\\n\", res->converged ? \"yes\" : \"no\");\r\n    printf(\"iterations: %d\\n\", res->iterations);\r\n    printf(\"residual: %.6e\\n\", res->relres);\r\n    printf(\"true_residual: %.6e\\n\", res->true_residual);\r\n}\r\n"]
[5564.346165, "o", "\r\nstatic int validate_ssor_omega(double omega)\r\n{\r\n    if (!(omega > 0.0 && omega < 2.0)) {\r\n        fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int cmd_dense_solve(int argc, char **argv)\r\n{"]
[5564.346227, "o", "\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"Error: dense-solve requires <matrix_file> <rhs_file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    const char *mat_file = argv[0];\r\n    const char *rhs_file = argv[1];\r\n    const char *out_file = (argc >= 3) ? argv[2] : NULL;\r\n\r\n    DenseMatrix *A = dm_read_text(mat_file);\r\n    if (!A) {\r\n"]
[5564.346286, "o", "        fprintf(stderr, \"Error: cannot read matrix from '%s'\\n\", mat_file);\r\n        return 1;\r\n    }\r\n\r\n    int n;\r\n    double *b = vec_read_text(rhs_file, &n);\r\n    if (!b) {\r\n        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (A->rows != n || A->cols != n) {\r\n"]
[5564.346344, "o", "        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n                A->rows, A->cols, n);\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    double *x = vec_create(n);\r\n    if (!x) {\r\n        fprintf(stderr, \"Error: allocation failed\\n\");\r\n        free(b);\r\n"]
[5564.346404, "o", "        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    int rc = dm_solve(A, b, x);\r\n    if (rc != 0) {\r\n        fprintf(stderr, \"Error: solver failed (singular or ill-conditioned)\\n\");\r\n        free(x);\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n"]
[5564.346467, "o", "    }\r\n\r\n    if (out_file) {\r\n        vec_write_text(x, n, out_file);\r\n        printf(\"Solution written to %s\\n\", out_file);\r\n    } else {\r\n        printf(\"Solution:\\n\");\r\n        vec_print(x, n, stdout);\r\n    }\r\n\r\n    double *r = vec_create(n);\r\n    dm_matvec(A, x, r);\r\n    vec_axpy(-1.0, b, r, n);\r\n"]
[5564.346525, "o", "    printf(\"Residual norm: %.6e\\n\", vec_norm2(r, n));\r\n\r\n    free(r);\r\n    free(x);\r\n    free(b);\r\n    dm_destroy(A);\r\n    return 0;\r\n}\r\n\r\nstatic int parse_bc(const char *s, PoissonBC *bc)\r\n{\r\n    const char *colon = strchr(s, ':');"]
[5564.346582, "o", "\r\n    if (!colon || colon == s) return -1;\r\n\r\n    size_t len = colon - s;\r\n    char type[32];\r\n    if (len >= sizeof(type)) return -1;\r\n    memcpy(type, s, len);\r\n    type[len] = '\\0';\r\n\r\n    if (strcmp(type, \"dirichlet\") == 0) bc->type = POISSON_DIRICHLET;\r\n"]
[5564.346645, "o", "    else if (strcmp(type, \"neumann\") == 0) bc->type = POISSON_NEUMANN;\r\n    else return -1;\r\n\r\n    bc->file = colon + 1;\r\n    return 0;\r\n}\r\n\r\nstatic int run_solver_and_print(const CSRMatrix *A, const double *b,\r\n                                const char *solver, const char *precond,\r\n                                double tol, int maxiter, int restart,\r\n                                double omega, const char *output,\r\n                                const char *history)\r\n{\r\n"]
[5564.346707, "o", "    Precond *P = precond_create(A, precond, omega);\r\n    if (!P) {\r\n        fprintf(stderr, \"Error: cannot create preconditioner '%s'\\n\", precond);\r\n        return 1;\r\n    }\r\n\r\n    SolveResult *res = NULL;\r\n    if (strcmp(solver, \"cg\") == 0) {\r\n        res = cg_solve(A, b, NULL, tol, maxiter, P);\r\n    } else if (strcmp(solver, \"gmres\") == 0) {\r\n        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);\r\n    } else {\r\n        fprintf(stderr, \"Error: unknown solver '%s'\\n\", solver);\r\n"]
[5564.34677, "o", "        precond_destroy(P);\r\n        return 1;\r\n    }\r\n\r\n    if (!res) {\r\n        fprintf(stderr, \"Error: solver allocation failed\\n\");\r\n        precond_destroy(P);\r\n        return 1;\r\n    }\r\n\r\n    print_solve_summary(res);\r\n\r\n"]
[5564.346828, "o", "    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {\r\n        fprintf(stderr, \"Error: cannot write output to '%s'\\n\", output);\r\n    }\r\n    if (history && write_history_file(res, history) != 0) {\r\n        fprintf(stderr, \"Error: cannot write history to '%s'\\n\", history);\r\n    }\r\n\r\n    solve_result_destroy(res);\r\n    precond_destroy(P);\r\n    return 0;\r\n}\r\n"]
[5564.346905, "o", "\r\nstatic int cmd_sparse_solve(int argc, char **argv)\r\n{\r\n    const char *input = get_opt(argc, argv, \"--input\");\r\n    const char *rhs_file = get_opt(argc, argv, \"--rhs\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n    const char *history = get_opt(argc, argv, \"--history\");\r\n\r\n"]
[5564.346967, "o", "    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {\r\n        fprintf(stderr, \"Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid solver parameters\\n\");\r\n"]
[5564.347074, "o", "        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n    }\r\n\r\n    CSRMatrix *A = csr_read_mm(input);\r\n    if (!A) {\r\n        fprintf(stderr, \"Error: cannot read sparse matrix from '%s'\\n\", input);\r\n        return 1;\r\n    }\r\n\r\n    int n;\r\n    double *b = vec_read_mm_array(rhs_file, &n);\r\n    if (!b) {\r\n        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n        csr_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (A->rows != n || A->cols != n) {\r\n        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n                A->rows, A->cols, n);\r\n"]
[5564.347135, "o", "        free(b);\r\n        csr_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\r\n    free(b);\r\n    csr_destroy(A);\r\n    return rc;\r\n}\r\n"]
[5564.347194, "o", "\r\nstatic int cmd_poisson(int argc, char **argv)\r\n{\r\n    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n    const char *source = get_opt(argc, argv, \"--source\");\r\n"]
[5564.34725, "o", "    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n"]
