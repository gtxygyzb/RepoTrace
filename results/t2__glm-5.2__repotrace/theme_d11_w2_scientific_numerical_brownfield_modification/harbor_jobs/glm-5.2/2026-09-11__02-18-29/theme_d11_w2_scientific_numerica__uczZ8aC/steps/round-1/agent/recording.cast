[4012.745131, "o", "\u001b[?2004h> "]
[4012.745281, "o", "                                       left, right, bottom, top, -factor);\r\n\u001b[?2004l\r"]
[4012.745372, "o", "\u001b[?2004h> "]
[4012.745459, "o", "        if (!A_rhs) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
