[12865.168282, "o", "    39\t    double *vals = (double *)malloc(expected * sizeof(double));\r\n    40\t    if (!vals) { fclose(fp); return NULL; }\r\n    41\t\r\n    42\t    int count = 0;\r\n    43\t    while (count < expected) {\r\n    44\t        double v;\r\n    45\t        if (fscanf(fp, \"%lf\", &v) != 1) break;\r\n    46\t        vals[count++] = v;\r\n"]
[12865.168344, "o", "    47\t    }\r\n    48\t\r\n    49\t    fclose(fp);\r\n    50\t    if (count != expected) { free(vals); return NULL; }\r\n    51\t    return vals;\r\n    52\t}\r\n    53\t\r\n    54\tstatic void add_coo(COOMatrix *coo, int *k, int r, int c, double v)\r\n    55\t{\r\n    56\t    coo->row[*k] = r;\r\n    57"]
[12865.168404, "o", "\t    coo->col[*k] = c;\r\n    58\t    coo->values[*k] = v;\r\n    59\t    (*k)++;\r\n    60\t}\r\n    61\t\r\n    62\tint poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n    63\t                    const char *source_file, PoissonBC left, PoissonBC right,\r\n    64\t                    PoissonBC bottom, PoissonBC top,\r\n    65\t                    CSRMatrix **A_out, double **b_out)\r\n"]
