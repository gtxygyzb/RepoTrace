[8074.002591, "o", "    29\t{\r\n    30\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n    31\t    int n = A->rows;\r\n    32\t    if (maxiter < 0) maxiter = 0;\r\n    33\t\r\n    34\t    SolveResult *res = result_create(n, maxiter);\r\n    35\t    if (!res) return NULL;\r\n    36\t\r\n    37\t    double *r = vec_create(n);\r\n    38\t    double *z = vec_create(n);\r\n    39\t    double *p = vec_create(n);\r\n    40\t    double *Ap = vec_create(n);\r\n    41\t    if (!r || !z || !p || !Ap) {\r\n    42\t        free(r); free(z); free(p); free(Ap);\r\n    43\t        solve_result_destroy(res);\r\n    44\t        return NULL;\r\n    45"]
[8074.002657, "o", "\t    }\r\n    46\t\r\n    47\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n    48\t\r\n    49\t    csr_spmv(A, res->x, Ap);\r\n    50\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n    51\t\r\n    52\t    double bnorm = vec_norm2(b, n);\r\n    53\t    if (bnorm == 0.0) bnorm = 1.0;\r\n    54\t\r\n    55\t"]
[8074.002726, "o", "    res->true_residual = vec_norm2(r, n);\r\n    56\t    res->relres = res->true_residual / bnorm;\r\n    57\t    res->history[0] = res->relres;\r\n    58\t    res->precond_history[0] = res->true_residual;\r\n    59\t    res->history_len = 1;\r\n    60\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n    61\t    res->iterations = 0;\r\n    62\t    if (res->converged || maxiter == 0) {\r\n    63\t        free(r); free(z); free(p); free(Ap);\r\n    64\t        return res;\r\n    65\t    }\r\n    66"]
[8074.002784, "o", "\t\r\n    67\t    if (precond_apply(P, A, r, z) != 0) {\r\n    68\t        free(r); free(z); free(p); free(Ap);\r\n    69\t        return res;\r\n    70\t    }\r\n    71\t    vec_copy(z, p, n);\r\n    72\t    double rz_old = vec_dot(r, z, n);\r\n    73\t\r\n    74\t    for (int iter = 1; iter <= maxiter; iter++) {\r\n"]
[8074.002851, "o", "    75\t        csr_spmv(A, p, Ap);\r\n    76\t        double pAp = vec_dot(p, Ap, n);\r\n    77\t        if (fabs(pAp) < 1e-30) break;\r\n    78\t\r\n    79\t        double alpha = rz_old / pAp;\r\n"]
[8074.002933, "o", "    80\t        vec_axpy(alpha, p, res->x, n);\r\n    81\t        vec_axpy(-alpha, Ap, r, n);\r\n    82\t\r\n    83\t        /* Recompute the true residual rather than relying on the recurrence. */\r\n    84\t        csr_spmv(A, res->x, Ap);\r\n    85\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n    86\t\r\n    87\t        res->true_residual = vec_norm2(r, n);\r\n    88\t        res->relres = res->true_residual / bnorm;\r\n    89\t        res->history[iter] = res->relres;\r\n    90\t        res->precond_history[iter] = pznorm;\r\n    91\t        res->history_len = iter + 1;\r\n    92\t        res->iterations = iter;\r\n    93\t\r\n"]
[8074.002999, "o", "    94\t        if (res->relres < tol) {\r\n    95\t            res->converged = 1;\r\n    96\t            break;\r\n    97\t        }\r\n    98\t\r\n    99\t        if (precond_apply(P, A, r, z) != 0) break;\r\n   100\t        double rz_new = vec_dot(r, z, n);\r\n   101\t        if (fabs(rz_old) < 1e-30) break;\r\n   102\t        double beta = rz_new / rz_old;\r\n   103\t        vec_scale(beta, p, n);\r\n   104\t        vec_axpy(1.0, z, p, n);\r\n   105\t        rz_old = rz_new;\r\n   106\t    }\r\n   107\t\r\n   108\t    free(r); free(z); free(p); free(Ap);\r\n   109"]
[8074.003057, "o", "\t    return res;\r\n   110\t}\r\n   111\t\r\n   112\tstatic void apply_givens(double *a, double *b, double c, double s)\r\n   113\t{\r\n   114\t    double t = c * (*a) + s * (*b);\r\n   115\t    *b = -s * (*a) + c * (*b);\r\n   116\t    *a = t;\r\n"]
[8074.00314, "o", "   117\t}\r\n   118\t\r\n   119\tstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n   120\t{\r\n   121\t    if (kdim <= 0) return -1;\r\n   122"]
[8074.003203, "o", "\t\r\n   123\t    double *c = (double *)malloc(m * sizeof(double));\r\n   124\t    double *s = (double *)malloc(m * sizeof(double));\r\n   125\t    if (!c || !s) { free(c); free(s); return -1; }\r\n   126\t\r\n   127\t    for (int i = 0; i < kdim; i++) {\r\n   128\t        for (int k = 0; k < i; k++) {\r\n   129\t            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n   130\t        }\r\n"]
