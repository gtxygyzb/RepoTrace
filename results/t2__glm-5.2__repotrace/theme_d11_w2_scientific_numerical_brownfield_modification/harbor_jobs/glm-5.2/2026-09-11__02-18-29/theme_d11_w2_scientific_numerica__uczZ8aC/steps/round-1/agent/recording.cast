[11201.042386, "o", "\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {\r\n\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fprintf(stderr, \"Error: cannot write output to '%s'\\n\", output);\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (history && write_history_file(res, history) != 0) {\r\n\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fprintf(stderr, \"Error: cannot write history to '%s'\\n\", history);\r\n\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K191\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    solve_result_destroy(res);\r\n\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    precond_destroy(P);\r\n\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return 0;\r\n\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K196\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic int cmd_sparse_solve(int argc, char **argv)\r\n\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const char *input = get_opt(argc, argv, \"--input\");\r\n"]
