[11119.387355, "o", "nl -ba src/solvers.c | sed -n '1,300p'\r\n"]
[11119.387372, "o", "\u001b[?2004l\r"]
[11119.39101, "o", "     1\t#include \"solvers.h\"\r\n     2\t#include \"vector.h\"\r\n     3\t#include <stdlib.h>\r\n"]
[11119.391024, "o", "     4\t#include <math.h>\r\n     5\t#include <string.h>\r\n"]
[11119.391108, "o", "     6\t\r\n     7\tstatic SolveResult *result_create(int n, int maxiter)\r\n     8\t{\r\n     9\t    if (maxiter < 0) maxiter = 0;\r\n    10\t    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    11\t    if (!res) return NULL;\r\n    12"]
[11119.391124, "o", "\t\r\n    13\t    res->x = vec_create(n);\r\n    14\t    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    15\t    res->precond_history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    16\t    if (!res->x || !res->history || !res->precond_history) {\r\n    17\t        free(res->x);\r\n    18"]
[11119.391197, "o", "\t        free(res->history);\r\n    19\t        free(res->precond_history);\r\n    20\t        free(res);\r\n    21\t        return NULL;\r\n    22\t    }\r\n    23\t    res->history_len = 0;\r\n    24\t    return res;\r\n    25\t}\r\n    26\t\r\n    27\tSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n    28\t                      double tol, int maxiter, Precond *P)\r\n"]
[11119.39121, "o", "    29\t{\r\n"]
[11119.391278, "o", "    30\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n    31\t    int n = A->rows;\r\n    32\t    if (maxiter < 0) maxiter = 0;\r\n    33\t\r\n    34\t    SolveResult *res = result_create(n, maxiter);\r\n    35\t    if (!res) return NULL;\r\n    36\t\r\n    37\t    double *r = vec_create(n);\r\n    38\t    double *z = vec_create(n);\r\n    39\t    double *p = vec_create(n);\r\n    40\t    double *Ap = vec_create(n);\r\n    41\t"]
[11119.391291, "o", "    if (!r || !z || !p || !Ap) {\r\n    42\t        free(r); free(z); free(p); free(Ap);\r\n"]
[11119.391357, "o", "    43\t        solve_result_destroy(res);\r\n    44\t        return NULL;\r\n    45\t    }\r\n    46\t\r\n    47\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n    48\t\r\n    49\t    csr_spmv(A, res->x, Ap);\r\n    50\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n"]
[11119.39137, "o", "    51\t\r\n    52\t"]
[11119.391436, "o", "    double bnorm = vec_norm2(b, n);\r\n    53\t    if (bnorm == 0.0) bnorm = 1.0;\r\n    54\t\r\n    55\t    res->true_residual = vec_norm2(r, n);\r\n    56\t    res->relres = res->true_residual / bnorm;\r\n    57\t    precond_apply(P, A, r, z);\r\n    58\t    double pnorm0 = vec_norm2(z, n);\r\n    59\t    res->history[0] = res->relres;\r\n    60\t    res->precond_history[0] = pnorm0;\r\n    61\t    res->history_len = 1;\r\n    62\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n"]
[11119.39149, "o", "    63\t    res->iterations = 0;\r\n    64\t    if (res->converged || maxiter == 0) {\r\n    65\t        free(r); free(z); free(p); free(Ap);\r\n    66\t        return res;\r\n    67\t    }\r\n    68\t\r\n    69\t    if (precond_apply(P, A, r, z) != 0) {\r\n    70\t        free(r); free(z); free(p); free(Ap);\r\n"]
[11119.391506, "o", "    71\t        return res;\r\n    72\t    }\r\n"]
[11119.391582, "o", "    73\t    vec_copy(z, p, n);\r\n    74\t    double rz_old = vec_dot(r, z, n);\r\n    75\t\r\n    76\t    for (int iter = 1; iter <= maxiter; iter++) {\r\n    77\t        csr_spmv(A, p, Ap);\r\n    78\t        double pAp = vec_dot(p, Ap, n);\r\n    79\t        if (fabs(pAp) < 1e-30) break;\r\n    80\t\r\n    81\t        double alpha = rz_old / pAp;\r\n    82\t        vec_axpy(alpha, p, res->x, n);\r\n    83\t        vec_axpy(-alpha, Ap, r, n);\r\n"]
[11119.391632, "o", "    84\t\r\n    85\t        /* Recompute the true residual rather than relying on the recurrence. */\r\n    86\t        csr_spmv(A, res->x, Ap);\r\n"]
[11119.391681, "o", "    87\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n    88\t\r\n    89\t        res->true_residual = vec_norm2(r, n);\r\n    90\t        res->relres = res->true_residual / bnorm;\r\n    91\t        precond_apply(P, A, r, z);\r\n    92\t        double pznorm = vec_norm2(z, n);\r\n    93\t        res->history[iter] = res->relres;\r\n    94\t        res->precond_history[iter] = pznorm;\r\n"]
[11119.391722, "o", "    95\t        res->history_len = iter + 1;\r\n    96\t        res->iterations = iter;\r\n    97\t\r\n    98\t        if (res->relres < tol) {\r\n    99\t            res->converged = 1;\r\n   100\t            break;\r\n"]
[11119.391777, "o", "   101\t        }\r\n   102\t\r\n   103\t        if (precond_apply(P, A, r, z) != 0) break;\r\n   104\t        double rz_new = vec_dot(r, z, n);\r\n   105\t        if (fabs(rz_old) < 1e-30) break;\r\n   106\t        double beta = rz_new / rz_old;\r\n   107\t        vec_scale(beta, p, n);\r\n   108\t        vec_axpy(1.0, z, p, n);\r\n   109\t        rz_old = rz_new;\r\n   110\t    }\r\n   111\t\r\n"]
[11119.391826, "o", "   112\t    free(r); free(z); free(p); free(Ap);\r\n"]
[11119.391934, "o", "   113\t    return res;\r\n   114\t}\r\n   115\t\r\n   116\tstatic void apply_givens(double *a, double *b, double c, double s)\r\n   117\t{\r\n   118\t    double t = c * (*a) + s * (*b);\r\n   119\t    *b = -s * (*a) + c * (*b);\r\n   120\t    *a = t;\r\n   121\t}\r\n   122\t\r\n   123\tstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n   124\t{\r\n   125\t    if (kdim <= 0) return -1;\r\n   126\t\r\n   127\t    double *c = (double *)malloc(m * sizeof(double));\r\n   128\t    double *s = (double *)malloc(m * sizeof(double));\r\n   129\t    if (!c || !s) { free(c); free(s); return -1; }\r\n   130\t\r\n   131\t    for (int i = 0; i < kdim; i++) {\r\n   132\t"]
[11119.391951, "o", "        for (int k = 0; k < i; k++) {\r\n   133\t            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n   134\t        }\r\n"]
[11119.39203, "o", "   135\t\r\n   136\t        double a = H[i*m+i];\r\n   137\t        double b = H[(i+1)*m+i];\r\n   138\t        if (b == 0.0) {\r\n   139\t            c[i] = 1.0;\r\n   140\t            s[i] = 0.0;\r\n   141\t        } else {\r\n   142\t            double r = hypot(a, b);\r\n   143\t            c[i] = a / r;\r\n   144\t            s[i] = b / r;\r\n   145\t        }\r\n"]
[11119.392079, "o", "   146\t        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n   147\t        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n   148\t\r\n"]
[11119.392128, "o", "   149\t    }\r\n   150\t\r\n   151\t    for (int i = kdim - 1; i >= 0; i--) {\r\n   152\t        double sum = g[i];\r\n   153\t        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n   154\t        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n"]
[11119.392177, "o", "   155\t        y[i] = sum / H[i*m+i];\r\n   156\t    }\r\n   157\t\r\n   158\t    free(c);\r\n   159\t    free(s);\r\n   160\t    return 0;\r\n   161\t}\r\n   162\t\r\n   163\tSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n"]
[11119.392225, "o", "   164\t                           double tol, int maxiter, int m, Precond *P)\r\n   165\t{\r\n   166\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n   167\t    int n = A->rows;\r\n   168\t    if (m <= 0) m = 30;\r\n   169\t    if (maxiter < 0) maxiter = 0;\r\n   170"]
[11119.392273, "o", "\t\r\n   171\t    SolveResult *res = result_create(n, maxiter);\r\n   172\t    if (!res) return NULL;\r\n   173\t\r\n   174\t    double *r = vec_create(n);\r\n   175\t    double *z = vec_create(n);\r\n   176\t    double *Ap = vec_create(n);\r\n   177"]
[11119.392328, "o", "\t    double *Av = vec_create(n);\r\n   178\t    double *w = vec_create(n);\r\n   179\t    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n   180\t    double *y = (double *)malloc(m * sizeof(double));\r\n   181\t    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n   182\t    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n   183\t\r\n   184\t    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n   185\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   186\t        solve_result_destroy(res);\r\n   187\t        return NULL;\r\n   188\t    }\r\n   189\t\r\n"]
[11119.392377, "o", "   190\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n   191\t\r\n"]
[11119.392426, "o", "   192\t    csr_spmv(A, res->x, Ap);\r\n   193\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   194\t\r\n   195\t    double bnorm = vec_norm2(b, n);\r\n   196\t    if (bnorm == 0.0) bnorm = 1.0;\r\n   197\t\r\n   198\t    res->true_residual = vec_norm2(r, n);\r\n   199\t    res->relres = res->true_residual / bnorm;\r\n"]
[11119.392474, "o", "   200\t    precond_apply(P, A, r, z);\r\n   201\t    double pnorm0 = vec_norm2(z, n);\r\n   202\t    res->history[0] = res->relres;\r\n   203\t    res->precond_history[0] = pnorm0;\r\n   204\t    res->history_len = 1;\r\n"]
[11119.392524, "o", "   205\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n   206\t    res->iterations = 0;\r\n   207\t    if (res->converged || maxiter == 0) {\r\n   208\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   209\t        return res;\r\n   210\t    }\r\n   211\t\r\n   212\t    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n   213\t        if (precond_apply(P, A, r, z) != 0) break;\r\n"]
[11119.392573, "o", "   214\t        double beta = vec_norm2(z, n);\r\n   215\t        if (beta == 0.0) break;\r\n   216\t\r\n   217\t        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n   218\t        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n   219\t        g[0] = beta;\r\n   220\t        memset(H, 0, (m + 1) * m * sizeof(double));\r\n   221\t"]
[11119.392624, "o", "\r\n   222\t        int kdim = 0;\r\n   223\t        int fail = 0;\r\n   224\t        for (int j = 0; j < m; j++) {\r\n   225\t            csr_spmv(A, V + j * n, Av);\r\n   226\t            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n   227\t\r\n   228\t            for (int i = 0; i <= j; i++) {\r\n"]
[11119.392678, "o", "   229\t                double h = vec_dot(w, V + i * n, n);\r\n   230\t                H[i*m+j] = h;\r\n   231\t                vec_axpy(-h, V + i * n, w, n);\r\n   232\t            }\r\n   233\t\r\n   234\t            double hnorm = vec_norm2(w, n);\r\n   235\t            H[(j+1)*m+j] = hnorm;\r\n   236\t            kdim = j + 1;\r\n   237\t\r\n   238\t            if (hnorm < 1e-14) break;\r\n   239\t\r\n   240\t            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n   241\t        }\r\n   242\t        if (fail) break;\r\n"]
[11119.392727, "o", "   243\t        if (kdim == 0) break;\r\n   244\t\r\n"]
[11119.392776, "o", "   245\t        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n   246\t        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n   247\t\r\n   248\t        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n   249\t\r\n   250\t        csr_spmv(A, res->x, Ap);\r\n   251\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   252"]
[11119.392825, "o", "\t\r\n   253\t        res->true_residual = vec_norm2(r, n);\r\n   254\t        res->relres = res->true_residual / bnorm;\r\n   255\t        precond_apply(P, A, r, z);\r\n   256\t        double pznorm = vec_norm2(z, n);\r\n   257\t        res->history[cycle] = res->relres;\r\n   258\t        res->precond_history[cycle] = pznorm;\r\n"]
[11119.392882, "o", "   259\t        res->history_len = cycle + 1;\r\n   260\t        res->iterations = cycle;\r\n   261\t\r\n   262\t        if (res->relres < tol) {\r\n   263\t            res->converged = 1;\r\n   264\t            break;\r\n   265\t        }\r\n   266\t"]
[11119.392935, "o", "    }\r\n   267\t\r\n   268\t    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   269\t    return res;\r\n   270\t}\r\n   271\t\r\n   272\tvoid solve_result_destroy(SolveResult *res)\r\n   273\t"]
[11119.392983, "o", "{\r\n   274\t    if (!res) return;\r\n   275\t    free(res->x);\r\n   276\t    free(res->history);\r\n   277\t    free(res->precond_history);\r\n   278\t    free(res);\r\n   279\t}\r\n"]
[11119.393484, "o", "\u001b[?2004h"]
