[1145.611786, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[1145.611843, "o", "\u001b[?2004h> "]
[1145.611945, "o", "    if (argc < 2) {\r\n\u001b[?2004l\r"]
[1145.612003, "o", "\u001b[?2004h> "]
[1145.612428, "o", "        fprintf(stderr, \"Error: dense-solve requires <matrix_file> <rhs_file>\\n\");\r\n\u001b[?2004l\r"]
[1145.612485, "o", "\u001b[?2004h> "]
[1145.612577, "o", "        return 1;\r\n\u001b[?2004l\r"]
[1145.612632, "o", "\u001b[?2004h> "]
[1145.612689, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1145.612744, "o", "\u001b[?2004l\rd\u001b[?2004h> "]
[1145.612951, "o", "    const char *mat_file = argv[0];\r\n\u001b[?2004l\r"]
[1145.613007, "o", "\u001b[?2004h> "]
