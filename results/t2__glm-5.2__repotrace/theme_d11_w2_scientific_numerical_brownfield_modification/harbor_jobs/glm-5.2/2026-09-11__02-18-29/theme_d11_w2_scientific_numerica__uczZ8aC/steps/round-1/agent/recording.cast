[7936.919786, "o", "\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KCSRMatrix *coo_to_csr(const \u001b[01;31m\u001b[KCOOMatrix\u001b[m\u001b[K *A)\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[KCOOMatrix\u001b[m\u001b[K *sorted = coo_sort_dedup(A);\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CSRMatrix *out = \u001b[01;31m\u001b[Kcsr_create\u001b[m\u001b[K(sorted->rows, sorted->cols, sorted->nnz);\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    for (int i = 0; i <= sorted->rows; i++) out->\u001b[01;31m\u001b[Krow_ptr\u001b[m\u001b[K[i] = 0;\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        out->\u001b[01;31m\u001b[Krow_ptr\u001b[m\u001b[K[sorted->row[k] + 1]++;\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        out->\u001b[01;31m\u001b[Krow_ptr\u001b[m\u001b[K[i+1] += out->\u001b[01;31m\u001b[Krow_ptr\u001b[m\u001b[K[i];\r\n"]
