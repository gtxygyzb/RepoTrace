[2293.072508, "i", "sed -n '361,520p' src/sparse.c\n"]
[2293.072793, "o", "sed -n '361,520p' src/sparse.c\r\n\u001b[?2004l\r"]
[2293.075643, "o", "\r\n    int i = 0;\r\n    while (i < rows && read_non_comment_line(fp, line, sizeof(line)) == 0) {\r\n        double v;\r\n        if (sscanf(line, \"%lf\", &v) != 1) { free(x); fclose(fp); return NULL; }\r\n        x[i++] = v;\r\n    }\r\n    if (i != rows) { free(x); fclose(fp); return NULL; }\r\n\r\n"]
[2293.075736, "o", "    fclose(fp);\r\n    *n_out = rows;\r\n    return x;\r\n}\r\n\r\nint vec_write_mm_array(const double *x, int n, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    fprintf(fp, \"%%%%MatrixMarket matrix array real general\\n\");\r\n    fprintf(fp, \"%d 1\\n\", n);\r\n    for (int i = 0; i < n; i++) {\r\n        fprintf(fp, \"%.15g\\n\", x[i]);\r\n    }\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n"]
