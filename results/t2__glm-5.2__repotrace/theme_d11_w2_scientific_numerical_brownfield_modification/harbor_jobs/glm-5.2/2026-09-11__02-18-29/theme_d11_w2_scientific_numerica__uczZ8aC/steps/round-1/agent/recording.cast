[4142.19786, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[4142.197927, "o", "\u001b[?2004h> "]
[4142.198117, "o", "    FILE *fp = fopen(filename, \"w\");\r\n\u001b[?2004l\r"]
[4142.198171, "o", "\u001b[?2004h> "]
[4142.198287, "o", "    if (!fp) return -1;\r\n\u001b[?2004l\r"]
[4142.198344, "o", "\u001b[?2004h> "]
[4142.198593, "o", "    for (int i = 0; i < res->history_len; i++) {\r\n\u001b[?2004l\r"]
[4142.198649, "o", "\u001b[?2004h> "]
[4142.198942, "o", "        fprintf(fp, \"%d\\t%.15e\\n\", i, res->history[i]);\r\n\u001b[?2004l\r"]
[4142.198999, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4142.199065, "o", "\u001b[?2004h> "]
[4142.199148, "o", "    fclose(fp);\r\n\u001b[?2004l\r"]
[4142.199205, "o", "\u001b[?2004h> "]
[4142.19928, "o", "    return 0;\r\n\u001b[?2004l\r"]
[4142.199336, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4142.199403, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h"]
[4142.199458, "o", "> "]
