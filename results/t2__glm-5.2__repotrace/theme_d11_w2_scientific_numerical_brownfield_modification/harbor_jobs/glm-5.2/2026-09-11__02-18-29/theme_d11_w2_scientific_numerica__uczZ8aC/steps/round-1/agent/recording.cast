[12812.724061, "o", "        fclose(fp);\r\n    15\t        return NULL;\r\n    16\t    }\r\n    17\t\r\n    18\t    int n = nx * ny;\r\n    19\t    double *f = vec_create(n);\r\n    20\t    if (!f) { fclose(fp); return NULL; }\r\n    21\t\r\n    22\t    for (int i = 0; i < n; i++) {\r\n    23\t        if (fscanf(fp, \"%lf\", &f[i]) != 1) {\r\n    24\t            free(f);\r\n    25\t            fclose(fp);\r\n    26\t            return NULL;\r\n    27\t        }\r\n    28\t    }\r\n    29\t\r\n    30\t    fclose(fp);\r\n    31\t    return f;\r\n    32\t}\r\n    33\t\r\n    34\tdouble *poisson_read_boundary(const char *filename, int expected)\r\n    35\t{\r\n    36\t    FILE *fp = fopen(filename, \"r\");\r\n    37\t    if (!fp) return NULL;\r\n    38\t\r\n    39\t    double *vals = (double *)malloc(expected * sizeof(double));\r\n    40\t    if (!vals) { fclose(fp); return NULL; }\r\n    41\t\r\n    42\t    int count = 0;\r\n    43\t"]
[12812.724173, "o", "    while (count < expected) {\r\n    44\t        double v;\r\n    45\t        if (fscanf(fp, \"%lf\", &v) != 1) break;\r\n    46\t        vals[count++] = v;\r\n    47\t    }\r\n    48\t\r\n    49\t    fclose(fp);\r\n    50\t    if (count != expected) { free(vals); return NULL; }\r\n    51\t    return vals;\r\n    52\t}\r\n    53\t\r\n    54\tstatic void add_coo(COOMatrix *coo, int *k, int r, int c, double v)\r\n    55\t{\r\n    56\t    coo->row[*k] = r;\r\n    57\t    coo->col[*k] = c;\r\n    58\t    coo->values[*k] = v;\r\n    59\t    (*k)++;\r\n    60\t}\r\n    61\t\r\n    62\tint poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n    63\t                    const char *source_file, PoissonBC left, PoissonBC right,\r\n    64\t                    PoissonBC bottom, PoissonBC top,\r\n    65\t                    CSRMatrix **A_out, double **b_out)\r\n    66\t{\r\n    67\t    if (!A_out || !b_out) return -1;\r\n    68\t    *A_out = NULL;\r\n    69\t    *b_out = NULL;\r\n    70\t\r\n    71\t    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || !source_file) return -1;\r\n "]
[12812.724277, "o", "   72\t\r\n    73\t    double hx = (x1 - x0) / (nx - 1);\r\n    74\t    double hy = (y1 - y0) / (ny - 1);\r\n    75\t    double hx2 = hx * hx;\r\n    76\t    double hy2 = hy * hy;\r\n    77\t\r\n    78\t    double *f = poisson_read_source(source_file, nx, ny);\r\n    79\t    if (!f) return -1;\r\n    80\t\r\n    81\t    double *left_vals = NULL;\r\n    82\t    double *right_vals = NULL;\r\n    83\t    double *bottom_vals = NULL;\r\n    84\t    double *top_vals = NULL;\r\n    85\t\r\n    86\t    if (left.type == POISSON_NEUMANN) { left_vals = poisson_read_boundary(left.file, ny); if (!left_vals) goto fail; }\r\n    87\t    if (right.type == POISSON_NEUMANN) { right_vals = poisson_read_boundary(right.file, ny); if (!right_vals) goto fail; }\r\n    88\t    if (bottom.type == POISSON_NEUMANN) { bottom_vals = poisson_read_boundary(bottom.file, nx); if (!bottom_vals) goto fail; }\r\n"]
[12812.72438, "o", "    89\t    if (top.type == POISSON_NEUMANN) { top_vals = poisson_read_boundary(top.file, nx); if (!top_vals) goto fail; }\r\n    90\t\r\n    91\t    if (left.type == POISSON_DIRICHLET) { left_vals = poisson_read_boundary(left.file, ny); if (!left_vals) goto fail; }\r\n    92\t    if (right.type == POISSON_DIRICHLET) { right_vals = poisson_read_boundary(right.file, ny); if (!right_vals) goto fail; }\r\n    93\t    if (bottom.type == POISSON_DIRICHLET) { bottom_vals = poisson_read_boundary(bottom.file, nx); if (!bottom_vals) goto fail; }\r\n    94\t    if (top.type == POISSON_DIRICHLET) { top_vals = poisson_read_boundary(top.file, nx); if (!top_vals) goto fail; }\r\n    95\t\r\n    96\t    int n = nx * ny;\r\n    97\t    COOMatrix *coo = coo_create(n, n, 5 * n);\r\n    98\t    double *b = vec_create(n);\r\n    99\t    if (!coo || !b) { coo_destroy(coo); free(b); goto fail; }\r\n   100\t\r\n   101\t    int k = 0;\r\n   102\t    for (int i = 0; i < nx; i++) {\r\n   103\t        for (int j = 0; j < ny; j++) {\r\n   104\t"]
[12812.724476, "o", "            int idx = i * ny + j;\r\n   105\t            int is_left = (i == 0);\r\n   106\t            int is_right = (i == nx - 1);\r\n   107\t            int is_bottom = (j == 0);\r\n   108\t            int is_top = (j == ny - 1);\r\n   109\t\r\n   110\t            if (is_left && left.type == POISSON_DIRICHLET) {\r\n   111\t                add_coo(coo, &k, idx, idx, 1.0);\r\n   112\t                b[idx] = left_vals[j];\r\n   113\t                continue;\r\n   114\t            }\r\n   115\t            if (is_right && right.type == POISSON_DIRICHLET) {\r\n   116\t                add_coo(coo, &k, idx, idx, 1.0);\r\n   117\t                b[idx] = right_vals[j];\r\n"]
[12812.724583, "o", "   118\t                continue;\r\n   119\t            }\r\n   120\t            if (is_bottom && bottom.type == POISSON_DIRICHLET) {\r\n   121\t                add_coo(coo, &k, idx, idx, 1.0);\r\n   122\t                b[idx] = bottom_vals[i];\r\n   123\t                continue;\r\n   124\t            }\r\n   125\t            if (is_top && top.type == POISSON_DIRICHLET) {\r\n   126\t                add_coo(coo, &k, idx, idx, 1.0);\r\n   127\t                b[idx] = top_vals[i];\r\n"]
[12812.724682, "o", "   128\t                continue;\r\n   129\t            }\r\n   130\t\r\n   131\t            double diag = 0.0;\r\n   132\t            double rhs = f[idx];\r\n   133\t            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;\r\n   134\t\r\n   135\t            if (is_left && left.type == POISSON_NEUMANN) {\r\n   136\t                diag += 2.0 / hx2;\r\n   137\t                c_ip = -2.0 / hx2;\r\n   138\t                rhs += 2.0 * left_vals[j] / hx;\r\n   139\t            } else if (is_right && right.type == POISSON_NEUMANN) {\r\n   140\t                diag += 2.0 / hx2;\r\n   141\t                c_im = -2.0 / hx2;\r\n   142\t                rhs += 2.0 * right_vals[j] / hx;\r\n   143\t            } else if (!is_left && !is_right) {\r\n"]
[12812.724799, "o", "   144\t                diag += 2.0 / hx2;\r\n   145\t                c_im = -1.0 / hx2;\r\n   146\t                c_ip = -1.0 / hx2;\r\n   147\t            }\r\n   148\t\r\n   149\t            if (is_bottom && bottom.type == POISSON_NEUMANN) {\r\n   150\t                diag += 2.0 / hy2;\r\n   151\t                c_jp = -2.0 / hy2;\r\n   152\t                rhs += 2.0 * bottom_vals[i] / hy;\r\n   153\t            } else if (is_top && top.type == POISSON_NEUMANN) {\r\n   154\t                diag += 2.0 / hy2;\r\n   155\t                c_jm = -2.0 / hy2;\r\n   156\t                rhs += 2.0 * top_vals[i] / hy;\r\n   157\t            } else if (!is_bottom && !is_top) {\r\n   158\t                diag += 2.0 / hy2;\r\n   159\t                c_jm = -1.0 / hy2;\r\n   160\t"]
[12812.724915, "o", "                c_jp = -1.0 / hy2;\r\n   161\t            }\r\n   162\t\r\n   163\t            add_coo(coo, &k, idx, idx, diag);\r\n   164\t            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);\r\n   165\t            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);\r\n   166\t            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);\r\n   167\t            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);\r\n   168\t            b[idx] = rhs;\r\n   169\t        }\r\n   170\t    }\r\n   171\t\r\n   172\t    coo->nnz = k;\r\n   173\t    CSRMatrix *A = coo_to_csr(coo);\r\n   174\t    coo_destroy(coo);\r\n   175\t    if (!A) { free(b); goto fail; }\r\n   176\t\r\n   177\t    free(f);\r\n   178\t    free(left_vals);\r\n   179\t    free(right_vals);\r\n   180\t    free(bottom_vals);\r\n"]
