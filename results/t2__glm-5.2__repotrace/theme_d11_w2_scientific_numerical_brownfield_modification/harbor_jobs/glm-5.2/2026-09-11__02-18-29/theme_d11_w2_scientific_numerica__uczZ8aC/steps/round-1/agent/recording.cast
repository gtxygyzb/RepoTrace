[3505.673569, "o", "        vec_axpy(-alpha, Ap, r, n);\r\n\u001b[?2004l\r"]
[3505.673625, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[3505.673681, "o", "> "]
[3505.674052, "o", "        /* Recompute the true residual rather than relying on the recurrence. */\r\n\u001b[?2004l\r"]
[3505.67411, "o", "\u001b[?2004h> "]
[3505.674253, "o", "        csr_spmv(A, res->x, Ap);\r\n\u001b[?2004l\r"]
[3505.67431, "o", "\u001b[?2004h> "]
[3505.674573, "o", "        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\u001b[?2004l\r"]
[3505.67463, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[3505.674686, "o", "> "]
[3505.674894, "o", "        res->true_residual = vec_norm2(r, n);\r\n\u001b[?2004l\r"]
[3505.674951, "o", "\u001b[?2004h> "]
[3505.675209, "o", "        res->relres = res->true_residual / bnorm;\r\n\u001b[?2004l\r"]
[3505.675267, "o", "\u001b[?2004h> "]
[3505.675454, "o", "        res->history[iter] = res->relres;\r\n\u001b[?2004l\r"]
[3505.67551, "o", "\u001b[?2004h> "]
[3505.675677, "o", "        res->history_len = iter + 1;\r\n\u001b[?2004l\r"]
[3505.675733, "o", "\u001b[?2004h> "]
[3505.675888, "o", "        res->iterations = iter;\r\n\u001b[?2004l\r"]
[3505.675945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.676002, "o", "\u001b[?2004h> "]
[3505.676142, "o", "        if (res->relres < tol) {\r\n\u001b[?2004l\r"]
[3505.676199, "o", "\u001b[?2004h> "]
[3505.676353, "o", "            res->converged = 1;\r\n\u001b[?2004l\r"]
[3505.67641, "o", "\u001b[?2004h> "]
[3505.676477, "o", "            break;\r\n\u001b[?2004l\r"]
[3505.676533, "o", "\u001b[?2004h> "]
[3505.676592, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3505.676647, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3505.676918, "o", "        if (precond_apply(P, A, r, z) != 0) break;\r\n\u001b[?2004l\r"]
[3505.676973, "o", "\u001b[?2004h> "]
[3505.677167, "o", "        double rz_new = vec_dot(r, z, n);\r\n\u001b[?2004l\r"]
[3505.677222, "o", "\u001b[?2004h> "]
[3505.677423, "o", "        if (fabs(rz_old) < 1e-30) break;\r\n\u001b[?2004l\r"]
[3505.677478, "o", "\u001b[?2004h> "]
[3505.677664, "o", "        double beta = rz_new / rz_old;\r\n\u001b[?2004l\r"]
[3505.677692, "o", "\u001b[?2004h> "]
[3505.677862, "o", "        vec_scale(beta, p, n);\r\n\u001b[?2004l\r"]
[3505.677949, "o", "\u001b[?2004h"]
[3505.678022, "o", "> "]
[3505.678083, "o", "        vec_axpy(1.0, z, p, n);\r\n\u001b[?2004l\r"]
[3505.67814, "o", "\u001b[?2004h> "]
[3505.678252, "o", "        rz_old = rz_new;\r\n\u001b[?2004l\r"]
[3505.678308, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[3505.678365, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.678421, "o", "\u001b[?2004h> "]
[3505.678602, "o", "    free(r); free(z); free(p); free(Ap);\r\n\u001b[?2004l\r"]
[3505.678657, "o", "\u001b[?2004h> "]
[3505.67872, "o", "    return res;\r\n\u001b[?2004l\r"]
[3505.678775, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[3505.67883, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3505.678895, "o", "> "]
[3505.679204, "o", "static void apply_givens(double *a, double *b, double c, double s)\r\n\u001b[?2004l\r"]
[3505.67926, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[3505.679314, "o", "\u001b[?2004h> "]
[3505.679483, "o", "    double t = c * (*a) + s * (*b);\r\n\u001b[?2004l\r"]
[3505.679538, "o", "\u001b[?2004h> "]
[3505.679667, "o", "    *b = -s * (*a) + c * (*b);\r\n\u001b[?2004l\r"]
[3505.679722, "o", "\u001b[?2004h> "]
[3505.679775, "o", "    *a = t;\r\n\u001b[?2004l\r"]
[3505.67983, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[3505.679893, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.679948, "o", "\u001b[?2004h> "]
[3505.680335, "o", "static int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n\u001b[?2004l\r"]
[3505.68039, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[3505.680444, "o", "\u001b[?2004h> "]
[3505.680573, "o", "    if (kdim <= 0) return -1;\r\n\u001b[?2004l\r"]
[3505.680629, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[3505.680683, "o", "> "]
[3505.680929, "o", "    double *c = (double *)malloc(m * sizeof(double));\r\n\u001b[?2004l\r"]
[3505.680984, "o", "\u001b[?2004h> "]
[3505.681242, "o", "    double *s = (double *)malloc(m * sizeof(double));\r\n\u001b[?2004l\r"]
[3505.681297, "o", "\u001b[?2004h> "]
[3505.68155, "o", "    if (!c || !s) { free(c); free(s); return -1; }\r\n\u001b[?2004l\r"]
[3505.681605, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h"]
[3505.681664, "o", "> "]
[3505.68182, "o", "    for (int i = 0; i < kdim; i++) {\r\n\u001b[?2004l\r"]
[3505.681885, "o", "\u001b[?2004h> "]
[3505.682057, "o", "        for (int k = 0; k < i; k++) {\r\n\u001b[?2004l\r"]
[3505.682112, "o", "\u001b[?2004h> "]
[3505.682435, "o", "            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n\u001b[?2004l\r"]
[3505.68249, "o", "\u001b[?2004h> "]
[3505.682544, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.682603, "o", "\u001b[?2004h> "]
[3505.682699, "o", "        double a = H[i*m+i];\r\n\u001b[?2004l\r"]
[3505.682754, "o", "\u001b[?2004h> "]
[3505.682858, "o", "        double b = H[(i+1)*m+i];\r\n\u001b[?2004l\r"]
[3505.682921, "o", "\u001b[?2004h"]
[3505.720521, "o", "> "]
[3505.720706, "o", "        if (b == 0.0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[3505.720765, "o", "> "]
[3505.720864, "o", "            c[i] = 1.0;\r\n\u001b[?2004l\r"]
[3505.720926, "o", "\u001b[?2004h> "]
[3505.721067, "o", "            s[i] = 0.0;\r\n\u001b[?2004l\r"]
[3505.721119, "o", "\u001b[?2004h> "]
[3505.72122, "o", "        } else {\r\n\u001b[?2004l\r"]
[3505.721281, "o", "\u001b[?2004h> "]
[3505.72148, "o", "            double r = hypot(a, b);\r\n\u001b[?2004l\r"]
[3505.721535, "o", "\u001b[?2004h> "]
[3505.721684, "o", "            c[i] = a / r;\r\n\u001b[?2004l\r"]
[3505.721738, "o", "\u001b[?2004h> "]
[3505.721895, "o", "            s[i] = b / r;\r\n\u001b[?2004l\r"]
[3505.721937, "o", "\u001b[?2004h> "]
[3505.722012, "o", "        }\r\n\u001b[?2004l\r"]
[3505.722064, "o", "\u001b[?2004h> "]
[3505.722402, "o", "        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n\u001b[?2004l\r"]
[3505.722464, "o", "\u001b[?2004h> "]
[3505.72274, "o", "        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n\u001b[?2004l\r"]
[3505.722792, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.722835, "o", "\u001b[?2004h"]
[3505.722894, "o", "> "]
[3505.722946, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3505.722997, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3505.72305, "o", "> "]
[3505.723269, "o", "    for (int i = kdim - 1; i >= 0; i--) {\r\n\u001b[?2004l\r"]
[3505.723324, "o", "\u001b[?2004h> "]
[3505.723478, "o", "        double sum = g[i];\r\n\u001b[?2004l\r"]
[3505.723532, "o", "\u001b[?2004h> "]
[3505.723915, "o", "        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n\u001b[?2004l\r"]
[3505.723979, "o", "\u001b[?2004h> "]
[3505.724358, "o", "        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n\u001b[?2004l\r"]
[3505.724409, "o", "\u001b[?2004h> "]
[3505.724589, "o", "        y[i] = sum / H[i*m+i];\r\n\u001b[?2004l\r"]
[3505.724639, "o", "\u001b[?2004h> "]
[3505.724688, "o", "    }\r\n\u001b[?2004l\r"]
[3505.724737, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.724785, "o", "\u001b[?2004h> "]
[3505.724881, "o", "    free(c);\r\n\u001b[?2004l\r"]
[3505.724931, "o", "\u001b[?2004h"]
[3505.724979, "o", "> "]
[3505.725027, "o", "    free(s);\r\n\u001b[?2004l\r"]
[3505.725075, "o", "\u001b[?2004h> "]
[3505.725166, "o", "    return 0;\r\n\u001b[?2004l\r"]
[3505.725215, "o", "\u001b[?2004h> "]
[3505.725262, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[3505.72531, "o", "> \r\n\u001b[?2004l\r"]
[3505.725358, "o", "\u001b[?2004h> "]
[3505.725802, "o", "SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n\u001b[?2004l\r"]
[3505.725853, "o", "\u001b[?2004h> "]
[3505.72626, "o", "                           double tol, int maxiter, int m, Precond *P)\r\n\u001b[?2004l\r"]
[3505.726311, "o", "\u001b[?2004h> "]
[3505.72636, "o", "{\r\n\u001b[?2004l\r\u001b[?2004h"]
[3505.726408, "o", "> "]
[3505.726681, "o", "    if (!A || !b || A->rows != A->cols) return NULL;\r\n\u001b[?2004l\r"]
[3505.726731, "o", "\u001b[?2004h> "]
[3505.72686, "o", "    int n = A->rows;\r\n\u001b[?2004l\r"]
[3505.726913, "o", "\u001b[?2004h> "]
[3505.72706, "o", "    if (m <= 0) m = 30;\r\n\u001b[?2004l\r"]
[3505.727113, "o", "\u001b[?2004h> "]
[3505.727308, "o", "    if (maxiter < 0) maxiter = 0;\r\n\u001b[?2004l\r"]
[3505.727335, "o", "\u001b[?2004h"]
[3505.727387, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3505.727433, "o", "> "]
[3505.727701, "o", "    SolveResult *res = result_create(n, maxiter);\r\n\u001b[?2004l\r"]
[3505.72775, "o", "\u001b[?2004h> "]
[3505.727918, "o", "    if (!res) return NULL;\r\n\u001b[?2004l\r"]
[3505.72797, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.728019, "o", "\u001b[?2004h> "]
[3505.728207, "o", "    double *r = vec_create(n);\r\n\u001b[?2004l\r"]
[3505.728255, "o", "\u001b[?2004h> "]
[3505.728438, "o", "    double *z = vec_create(n);\r\n\u001b[?2004l\r"]
[3505.728487, "o", "\u001b[?2004h> "]
[3505.728675, "o", "    double *Ap = vec_create(n);\r\n\u001b[?2004l\r"]
[3505.728724, "o", "\u001b[?2004h> "]
[3505.72892, "o", "    double *Av = vec_create(n);\r\n\u001b[?2004l\r"]
[3505.728951, "o", "\u001b[?2004h"]
[3505.729019, "o", "> "]
[3505.729148, "o", "    double *w = vec_create(n);\r\n\u001b[?2004l\r"]
[3505.729198, "o", "\u001b[?2004h> "]
[3505.729541, "o", "    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n\u001b[?2004l\r"]
[3505.729592, "o", "\u001b[?2004h> "]
[3505.72991, "o", "    double *y = (double *)malloc(m * sizeof(double));\r\n\u001b[?2004l\r"]
[3505.72996, "o", "\u001b[?2004h> "]
[3505.730313, "o", "    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n\u001b[?2004l\r"]
[3505.730368, "o", "\u001b[?2004h> "]
[3505.730725, "o", "    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n\u001b[?2004l\r"]
[3505.730775, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.730826, "o", "\u001b[?2004h"]
[3505.73088, "o", "> "]
[3505.731206, "o", "    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n\u001b[?2004l\r"]
[3505.731255, "o", "\u001b[?2004h> "]
[3505.731769, "o", "        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n\u001b[?2004l\r"]
[3505.73182, "o", "\u001b[?2004h> "]
[3505.732033, "o", "        solve_result_destroy(res);\r\n\u001b[?2004l\r"]
[3505.732086, "o", "\u001b[?2004h> "]
[3505.732209, "o", "        return NULL;\r\n\u001b[?2004l\r"]
[3505.73226, "o", "\u001b[?2004h> "]
[3505.732308, "o", "    }\r\n\u001b[?2004l\r"]
[3505.732357, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.732405, "o", "\u001b[?2004h> "]
[3505.732765, "o", "    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\u001b[?2004l\r"]
[3505.732818, "o", "\u001b[?2004h> \r\n"]
[3505.732873, "o", "\u001b[?2004l\r\u001b[?2004h"]
[3505.732924, "o", "> "]
[3505.733057, "o", "    csr_spmv(A, res->x, Ap);\r\n\u001b[?2004l\r"]
[3505.733105, "o", "\u001b[?2004h> "]
[3505.733411, "o", "    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\u001b[?2004l\r"]
[3505.733462, "o", "\u001b[?2004h> \r\n"]
[3505.733511, "o", "\u001b[?2004l\r\u001b[?2004h"]
[3505.733559, "o", "> "]
[3505.733732, "o", "    double bnorm = vec_norm2(b, n);\r\n\u001b[?2004l\r"]
[3505.73378, "o", "\u001b[?2004h> "]
[3505.733995, "o", "    if (bnorm == 0.0) bnorm = 1.0;\r\n\u001b[?2004l\r"]
[3505.734044, "o", "\u001b[?2004h> "]
[3505.734092, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[3505.734141, "o", "> "]
[3505.734348, "o", "    res->true_residual = vec_norm2(r, n);\r\n\u001b[?2004l\r"]
[3505.734399, "o", "\u001b[?2004h> "]
[3505.734662, "o", "    res->relres = res->true_residual / bnorm;\r\n\u001b[?2004l\r"]
[3505.734713, "o", "\u001b[?2004h> "]
[3505.734927, "o", "    res->history[0] = res->relres;\r\n\u001b[?2004l\r"]
[3505.734976, "o", "\u001b[?2004h> "]
[3505.735075, "o", "    res->history_len = 1;\r\n\u001b[?2004l\r"]
[3505.735115, "o", "\u001b[?2004h> "]
[3505.735324, "o", "    res->converged = (res->relres < tol) ? 1 : 0;\r\n\u001b[?2004l\r"]
[3505.735362, "o", "\u001b[?2004h> "]
[3505.73547, "o", "    res->iterations = 0;\r\n\u001b[?2004l\r"]
[3505.735508, "o", "\u001b[?2004h> "]
[3505.735681, "o", "    if (res->converged || maxiter == 0) {\r\n\u001b[?2004l\r"]
[3505.735719, "o", "\u001b[?2004h> "]
[3505.736095, "o", "        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n\u001b[?2004l\r"]
[3505.736134, "o", "\u001b[?2004h> "]
[3505.736222, "o", "        return res;\r\n\u001b[?2004l\r"]
[3505.73627, "o", "\u001b[?2004h> "]
[3505.736317, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.736363, "o", "\u001b[?2004h> "]
[3505.736588, "o", "    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n\u001b[?2004l\r"]
[3505.736635, "o", "\u001b[?2004h> "]
[3505.736835, "o", "        if (precond_apply(P, A, r, z) != 0) break;\r\n\u001b[?2004l\r"]
[3505.736889, "o", "\u001b[?2004h> "]
[3505.737043, "o", "        double beta = vec_norm2(z, n);\r\n\u001b[?2004l\r"]
[3505.737091, "o", "\u001b[?2004h> "]
[3505.737217, "o", "        if (beta == 0.0) break;\r\n\u001b[?2004l\r"]
[3505.737264, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.73731, "o", "\u001b[?2004h> "]
[3505.737527, "o", "        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n\u001b[?2004l\r"]
[3505.737567, "o", "\u001b[?2004h> "]
[3505.737767, "o", "        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n\u001b[?2004l\r"]
[3505.737816, "o", "\u001b[?2004h> "]
[3505.7379, "o", "        g[0] = beta;\r\n\u001b[?2004l\r"]
[3505.737953, "o", "\u001b[?2004h> "]
[3505.738162, "o", "        memset(H, 0, (m + 1) * m * sizeof(double));\r\n\u001b[?2004l\r"]
[3505.738213, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.738261, "o", "\u001b[?2004h> "]
[3505.738335, "o", "        int kdim = 0;\r\n\u001b[?2004l\r"]
[3505.738383, "o", "\u001b[?2004h> "]
[3505.738469, "o", "        int fail = 0;\r\n\u001b[?2004l\r"]
[3505.738517, "o", "\u001b[?2004h> "]
[3505.738664, "o", "        for (int j = 0; j < m; j++) {\r\n\u001b[?2004l\r"]
[3505.738703, "o", "\u001b[?2004h> "]
[3505.738875, "o", "            csr_spmv(A, V + j * n, Av);\r\n\u001b[?2004l\r"]
[3505.738913, "o", "\u001b[?2004h> "]
[3505.739201, "o", "            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n\u001b[?2004l\r"]
[3505.739239, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.739277, "o", "\u001b[?2004h> "]
[3505.739462, "o", "            for (int i = 0; i <= j; i++) {\r\n\u001b[?2004l\r"]
[3505.739501, "o", "\u001b[?2004h> "]
[3505.739719, "o", "                double h = vec_dot(w, V + i * n, n);\r\n\u001b[?2004l\r"]
[3505.739757, "o", "\u001b[?2004h> "]
[3505.739885, "o", "                H[i*m+j] = h;\r\n\u001b[?2004l\r"]
[3505.739923, "o", "\u001b[?2004h> "]
[3505.740134, "o", "                vec_axpy(-h, V + i * n, w, n);\r\n\u001b[?2004l\r"]
[3505.740184, "o", "\u001b[?2004h> "]
[3505.740234, "o", "            }\r\n\u001b[?2004l\r"]
[3505.740281, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.740329, "o", "\u001b[?2004h> "]
[3505.7405, "o", "            double hnorm = vec_norm2(w, n);\r\n\u001b[?2004l\r"]
[3505.740553, "o", "\u001b[?2004h> "]
[3505.74068, "o", "            H[(j+1)*m+j] = hnorm;\r\n\u001b[?2004l\r"]
[3505.740718, "o", "\u001b[?2004h> "]
[3505.740827, "o", "            kdim = j + 1;\r\n\u001b[?2004l\r"]
[3505.74088, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.740928, "o", "\u001b[?2004h> "]
[3505.741072, "o", "            if (hnorm < 1e-14) break;\r\n\u001b[?2004l\r"]
[3505.741119, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.741164, "o", "\u001b[?2004h> "]
[3505.741437, "o", "            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n\u001b[?2004l\r"]
[3505.741486, "o", "\u001b[?2004h> "]
[3505.741532, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3505.741579, "o", "> "]
[3505.741666, "o", "        if (fail) break;\r\n\u001b[?2004l\r"]
[3505.741712, "o", "\u001b[?2004h> "]
[3505.741832, "o", "        if (kdim == 0) break;\r\n\u001b[?2004l\r"]
[3505.741886, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.741935, "o", "\u001b[?2004h> "]
[3505.74213, "o", "        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n\u001b[?2004l\r"]
[3505.742177, "o", "\u001b[?2004h> "]
[3505.742427, "o", "        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n\u001b[?2004l\r"]
[3505.742477, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.742525, "o", "\u001b[?2004h> "]
[3505.742824, "o", "        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n\u001b[?2004l\r"]
[3505.742884, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.742931, "o", "\u001b[?2004h> "]
[3505.743052, "o", "        csr_spmv(A, res->x, Ap);\r\n\u001b[?2004l\r"]
[3505.743099, "o", "\u001b[?2004h> "]
[3505.743326, "o", "        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\u001b[?2004l\r"]
[3505.743376, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.743424, "o", "\u001b[?2004h> "]
[3505.743599, "o", "        res->true_residual = vec_norm2(r, n);\r\n\u001b[?2004l\r"]
[3505.743646, "o", "\u001b[?2004h> "]
[3505.743844, "o", "        res->relres = res->true_residual / bnorm;\r\n\u001b[?2004l\r"]
[3505.743899, "o", "\u001b[?2004h> "]
[3505.744068, "o", "        res->history[cycle] = res->relres;\r\n\u001b[?2004l\r"]
[3505.744115, "o", "\u001b[?2004h> "]
[3505.744267, "o", "        res->history_len = cycle + 1;\r\n\u001b[?2004l\r"]
[3505.744315, "o", "\u001b[?2004h> "]
[3505.744443, "o", "        res->iterations = cycle;\r\n\u001b[?2004l\r"]
[3505.74449, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3505.744537, "o", "\u001b[?2004h> "]
[3505.744664, "o", "        if (res->relres < tol) {\r\n\u001b[?2004l\r"]
[3505.744711, "o", "\u001b[?2004h> "]
[3505.744838, "o", "            res->converged = 1;\r\n\u001b[?2004l\r"]
[3505.744891, "o", "\u001b[?2004h> "]
[3505.744963, "o", "            break;\r\n\u001b[?2004l\r"]
[3505.745009, "o", "\u001b[?2004h> "]
[3505.745055, "o", "        }\r\n\u001b[?2004l\r"]
[3505.745101, "o", "\u001b[?2004h> "]
[3505.745147, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[3505.745194, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3505.745554, "o", "    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n\u001b[?2004l\r"]
[3505.745592, "o", "\u001b[?2004h> "]
[3505.745662, "o", "    return res;\r\n\u001b[?2004l\r"]
[3505.745702, "o", "\u001b[?2004h> }\r\n"]
[3505.745739, "o", "\u001b[?2004l\r\u001b[?2004h"]
[3505.745776, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
