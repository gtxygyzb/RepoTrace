[7877.259308, "o", "     1\t#ifndef SOLVERS_H\r\n     2\t#define SOLVERS_H\r\n     3\t\r\n     4\t#include \"sparse.h\"\r\n     5\t#include \"precond.h\"\r\n     6\t\r\n     7\ttypedef struct {\r\n"]
[7877.259395, "o", "     8\t    double *x;\r\n     9\t    double relres;          /* true relative residual ||b-A*x||/||b|| */\r\n    10\t    double true_residual;   /* absolute true residual norm ||b-A*x|| */\r\n    11\t    int iterations;\r\n    12\t    int converged;\r\n    13\t    double *history;        /* true relative residual at each iteration */\r\n"]
[7877.259501, "o", "    14\t    int history_len;        /* number of stored history entries */\r\n    15\t} SolveResult;\r\n    16\t\r\n    17\tSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n    18\t                      double tol, int maxiter, Precond *P);\r\n    19\t\r\n    20\tSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n"]
[7877.259587, "o", "    21\t                           double tol, int maxiter, int m, Precond *P);\r\n    22\t\r\n    23\tvoid solve_result_destroy(SolveResult *res);\r\n    24\t\r\n    25\t#endif /* SOLVERS_H */\r\n"]
