[1145.652299, "o", "    } else if (strcmp(cmd, \"sparse-solve\") == 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.65239, "o", "        return cmd_sparse_solve(argc - 2, argv + 2);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.65247, "o", "    } else if (strcmp(cmd, \"poisson\") == 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.652554, "o", "        return cmd_poisson(argc - 2, argv + 2);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.652668, "o", "    } else if (strcmp(cmd, \"--help\") == 0 || strcmp(cmd, \"-h\") == 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
