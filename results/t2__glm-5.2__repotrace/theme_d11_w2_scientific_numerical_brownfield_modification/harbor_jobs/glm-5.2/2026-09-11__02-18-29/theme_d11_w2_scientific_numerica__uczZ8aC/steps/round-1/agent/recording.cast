[2149.65339, "o", "     1\t#include \"solvers.h\"\r\n     2\t#include \"vector.h\"\r\n     3\t#include <stdlib.h>\r\n     4\t#include <math.h>\r\n     5\t#include <string.h>\r\n"]
[2149.653491, "o", "     6\t\r\n     7\tstatic SolveResult *result_create(int n, int maxiter)\r\n     8\t{\r\n     9\t    if (maxiter < 0) maxiter = 0;\r\n    10\t    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    11\t    if (!res) return NULL;\r\n    12\t\r\n    13\t    res->x = vec_create(n);\r\n    14\t    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    15\t    if (!res->x || !res->history) {\r\n    16\t        free(res->x);\r\n    17\t        free(res->history);\r\n    18\t        free(res);\r\n    19\t        return NULL;\r\n    20\t"]
[2149.653574, "o", "    }\r\n    21\t    res->history_len = 0;\r\n    22\t    return res;\r\n    23\t}\r\n    24\t\r\n    25\tSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n    26\t                      double tol, int maxiter, Precond *P)\r\n    27\t{\r\n    28\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n    29\t    int n = A->rows;\r\n    30\t    if (maxiter < 0) maxiter = 0;\r\n    31\t\r\n    32\t    SolveResult *res = result_create(n, maxiter);\r\n    33"]
[2149.653647, "o", "\t    if (!res) return NULL;\r\n    34\t\r\n    35\t    double *r = vec_create(n);\r\n    36\t    double *z = vec_create(n);\r\n    37\t    double *p = vec_create(n);\r\n    38\t    double *Ap = vec_create(n);\r\n    39\t    if (!r || !z || !p || !Ap) {\r\n    40\t        free(r); free(z); free(p); free(Ap);\r\n    41\t        solve_result_destroy(res);\r\n    42\t        return NULL;\r\n"]
[2149.653718, "o", "    43\t    }\r\n    44\t\r\n    45\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n    46\t\r\n    47\t    csr_spmv(A, res->x, Ap);\r\n    48\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n    49\t\r\n    50\t    double bnorm = vec_norm2(b, n);\r\n    51\t    if (bnorm == 0.0) bnorm = 1.0;\r\n    52\t\r\n    53\t    res->relres = vec_norm2(r, n) / bnorm;\r\n"]
[2149.653788, "o", "    54\t    res->history[0] = res->relres;\r\n    55\t    res->history_len = 1;\r\n    56\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n    57\t    res->iterations = 0;\r\n    58\t    if (res->converged || maxiter == 0) {\r\n    59\t        free(r); free(z); free(p); free(Ap);\r\n    60\t        return res;\r\n    61\t    }\r\n    62\t\r\n    63\t    if (precond_apply(P, A, r, z) != 0) {\r\n    64\t"]
[2149.653859, "o", "        free(r); free(z); free(p); free(Ap);\r\n    65\t        return res;\r\n    66\t    }\r\n    67\t    vec_copy(z, p, n);\r\n    68\t    double rz_old = vec_dot(r, z, n);\r\n    69\t\r\n    70\t    for (int iter = 1; iter <= maxiter; iter++) {\r\n    71\t        csr_spmv(A, p, Ap);\r\n    72\t        double pAp = vec_dot(p, Ap, n);\r\n    73\t        if (fabs(pAp) < 1e-30) break;\r\n    74\t\r\n    75\t        double alpha = rz_old / pAp;\r\n"]
[2149.653939, "o", "    76\t        vec_axpy(alpha, p, res->x, n);\r\n    77\t        vec_axpy(-alpha, Ap, r, n);\r\n    78\t\r\n    79\t        res->relres = vec_norm2(r, n) / bnorm;\r\n    80\t        res->history[iter] = res->relres;\r\n    81\t        res->history_len = iter + 1;\r\n    82\t        res->iterations = iter;\r\n    83\t\r\n    84\t        if (res->relres < tol) {\r\n    85\t            res->converged = 1;\r\n    86\t            break;\r\n    87\t        }\r\n"]
[2149.654007, "o", "    88\t\r\n    89\t        if (precond_apply(P, A, r, z) != 0) break;\r\n    90\t        double rz_new = vec_dot(r, z, n);\r\n    91\t        if (fabs(rz_old) < 1e-30) break;\r\n    92\t        double beta = rz_new / rz_old;\r\n    93\t        vec_scale(beta, p, n);\r\n    94\t        vec_axpy(1.0, z, p, n);\r\n    95\t        rz_old = rz_new;\r\n    96\t    }\r\n"]
[2149.654075, "o", "    97\t\r\n    98\t    free(r); free(z); free(p); free(Ap);\r\n    99\t    return res;\r\n   100\t}\r\n   101\t\r\n   102\tstatic void apply_givens(double *a, double *b, double c, double s)\r\n   103\t{\r\n   104\t    double t = c * (*a) + s * (*b);\r\n   105\t    *b = -s * (*a) + c * (*b);\r\n   106\t    *a = t;\r\n"]
[2149.654151, "o", "   107\t}\r\n   108\t\r\n   109\tstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n   110\t{\r\n   111\t    if (kdim <= 0) return -1;\r\n   112\t\r\n   113\t    double *c = (double *)malloc(m * sizeof(double));\r\n   114\t    double *s = (double *)malloc(m * sizeof(double));\r\n   115\t    if (!c || !s) { free(c); free(s); return -1; }\r\n   116\t\r\n   117\t    for (int i = 0; i < kdim; i++) {\r\n   118\t        for (int k = 0; k < i; k++) {\r\n"]
[2149.654218, "o", "   119\t            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n   120\t        }\r\n   121\t\r\n   122\t        double a = H[i*m+i];\r\n   123\t        double b = H[(i+1)*m+i];\r\n   124\t        if (b == 0.0) {\r\n   125\t            c[i] = 1.0;\r\n   126\t            s[i] = 0.0;\r\n   127\t        } else {\r\n"]
[2149.654331, "o", "   128\t            double r = hypot(a, b);\r\n   129\t            c[i] = a / r;\r\n   130\t            s[i] = b / r;\r\n   131\t        }\r\n   132\t        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n   133\t        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n   134\t\r\n   135\t    }\r\n   136\t\r\n   137\t    for (int i = kdim - 1; i >= 0; i--) {\r\n   138\t        double sum = g[i];\r\n   139\t        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n   140\t        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n   141\t        y[i] = sum / H[i*m+i];\r\n   142\t    }\r\n   143\t\r\n   144\t    free(c);\r\n   145\t    free(s);\r\n   146\t    return 0;\r\n"]
[2149.654401, "o", "   147\t}\r\n   148\t\r\n   149\tSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n   150\t                         double tol, int maxiter, int m, Precond *P)\r\n   151\t{\r\n   152\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n   153\t    int n = A->rows;\r\n   154\t    if (m <= 0) m = 30;\r\n   155\t    if (maxiter < 0) maxiter = 0;\r\n   156\t\r\n"]
[2149.654485, "o", "   157\t    SolveResult *res = result_create(n, maxiter);\r\n   158\t    if (!res) return NULL;\r\n   159\t\r\n   160\t    double *r = vec_create(n);\r\n   161\t    double *z = vec_create(n);\r\n   162\t    double *Ap = vec_create(n);\r\n   163\t    double *Av = vec_create(n);\r\n   164\t    double *w = vec_create(n);\r\n   165\t    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n   166\t    double *y = (double *)malloc(m * sizeof(double));\r\n   167\t    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n   168\t    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n"]
[2149.654561, "o", "   169\t\r\n   170\t    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n   171\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   172\t        solve_result_destroy(res);\r\n   173\t        return NULL;\r\n   174\t    }\r\n   175\t\r\n   176\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n   177\t\r\n   178\t    csr_spmv(A, res->x, Ap);\r\n   179\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];"]
[2149.654636, "o", "\r\n   180\t\r\n   181\t    double bnorm = vec_norm2(b, n);\r\n   182\t    if (bnorm == 0.0) bnorm = 1.0;\r\n   183\t\r\n   184\t    res->relres = vec_norm2(r, n) / bnorm;\r\n   185\t    res->history[0] = res->relres;\r\n   186\t    res->history_len = 1;\r\n   187\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n   188\t    res->iterations = 0;\r\n   189\t    if (res->converged || maxiter == 0) {\r\n   190\t"]
[2149.654706, "o", "        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   191\t        return res;\r\n   192\t    }\r\n   193\t\r\n   194\t    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n   195\t        if (precond_apply(P, A, r, z) != 0) break;\r\n   196\t        double beta = vec_norm2(z, n);\r\n   197\t        if (beta == 0.0) break;\r\n   198\t\r\n   199\t        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n   200\t        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n   201\t        g[0] = beta;\r\n"]
[2149.654776, "o", "   202\t        memset(H, 0, (m + 1) * m * sizeof(double));\r\n   203\t\r\n   204\t        int kdim = 0;\r\n   205\t        int fail = 0;\r\n   206\t        for (int j = 0; j < m; j++) {\r\n   207\t            csr_spmv(A, V + j * n, Av);\r\n   208\t            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n   209\t\r\n   210\t            for (int i = 0; i <= j; i++) {\r\n   211\t                double h = vec_dot(w, V + i * n, n);\r\n   212\t                H[i*m+j] = h;\r\n"]
[2149.654844, "o", "   213\t                vec_axpy(-h, V + i * n, w, n);\r\n   214\t            }\r\n   215\t\r\n   216\t            double hnorm = vec_norm2(w, n);\r\n   217\t            H[(j+1)*m+j] = hnorm;\r\n   218\t            kdim = j + 1;\r\n   219\t\r\n   220\t            if (hnorm < 1e-14) break;\r\n   221\t\r\n   222\t            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n   223"]
[2149.65493, "o", "\t        }\r\n   224\t        if (fail) break;\r\n   225\t        if (kdim == 0) break;\r\n   226\t\r\n   227\t        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n   228\t        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n   229\t\r\n   230\t        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n   231\t\r\n   232\t        csr_spmv(A, res->x, Ap);\r\n   233\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   234\t\r\n"]
[2149.655018, "o", "   235\t        res->relres = vec_norm2(r, n) / bnorm;\r\n   236\t        res->history[cycle] = res->relres;\r\n   237\t        res->history_len = cycle + 1;\r\n   238\t        res->iterations = cycle;\r\n   239\t\r\n   240\t        if (res->relres < tol) {\r\n   241\t            res->converged = 1;\r\n   242\t            break;\r\n   243\t        }\r\n   244\t    }\r\n   245\t\r\n   246\t    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   247\t    return res;\r\n"]
[2149.655086, "o", "   248\t}\r\n   249\t\r\n   250\tvoid solve_result_destroy(SolveResult *res)\r\n   251\t{\r\n   252\t    if (!res) return;\r\n   253\t    free(res->x);\r\n   254\t    free(res->history);\r\n   255\t    free(res);\r\n   256\t}\r\n"]
