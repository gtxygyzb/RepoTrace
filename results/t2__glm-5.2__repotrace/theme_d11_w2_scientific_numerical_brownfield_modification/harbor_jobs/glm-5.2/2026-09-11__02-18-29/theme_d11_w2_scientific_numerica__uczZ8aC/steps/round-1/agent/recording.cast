[8056.75645, "o", "            resnorm = num / (fabs(lambda) * vn);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.756503, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.756584, "o", "            resnorm = INFINITY;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.756648, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.756702, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.75677, "o", "        resnorm = NAN;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[8056.756825, "o", "\u001b[?2004h> "]
