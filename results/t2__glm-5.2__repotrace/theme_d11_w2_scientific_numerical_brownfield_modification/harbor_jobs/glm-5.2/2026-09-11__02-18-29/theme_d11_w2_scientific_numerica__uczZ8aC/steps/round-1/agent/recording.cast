[7965.588703, "o", "nvdiff --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --kappa <float> --vx <float> --vy <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file> [--history <file>]\\n\", prog);\r\n    22\t}\r\n    23\t\r\n    24\tstatic const char *get_opt(int argc, char **argv, const char *name)\r\n    25\t{\r\n    26\t    for (int i = 0; i < argc - 1; i++) {\r\n    27\t        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    28\t    }\r\n    29\t    return NULL;\r\n    30\t}\r\n    31\t\r\n    32\tstatic int write_history_file(const SolveResult *res, const char *filename)\r\n    33\t{\r\n    34\t    FILE *fp = fopen(filename, \"w\");\r\n    35\t    if (!fp) return -1;\r\n"]
[7965.58877, "o", "    36\t    for (int i = 0; i < res->history_len; i++) {\r\n    37\t        fprintf(fp, \"%d\\t%.15e\\n\", i, res->history[i]);\r\n    38\t    }\r\n    39\t    fclose(fp);\r\n    40\t    return 0;\r\n    41\t}\r\n    42\t\r\n    43\tstatic void print_solve_summary(const SolveResult *res)\r\n    44\t{\r\n    45\t    printf(\"converged: %s\\n\", res->converged ? \"yes\" : \"no\");\r\n    46\t    printf(\"iterations: %d\\n\", res->iterations);\r\n    47\t    printf(\"residual: %.6e\\n\", res->relres);\r\n    48\t    printf(\"true_residual: %.6e\\n\", res->true_residual);\r\n    49\t}\r\n    50\t\r\n    51\t"]
[7965.58883, "o", "static int validate_ssor_omega(double omega)\r\n    52\t{\r\n    53\t    if (!(omega > 0.0 && omega < 2.0)) {\r\n    54\t        fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n    55\t        return 1;\r\n    56\t    }\r\n    57\t    return 0;\r\n    58\t}\r\n    59\t\r\n"]
