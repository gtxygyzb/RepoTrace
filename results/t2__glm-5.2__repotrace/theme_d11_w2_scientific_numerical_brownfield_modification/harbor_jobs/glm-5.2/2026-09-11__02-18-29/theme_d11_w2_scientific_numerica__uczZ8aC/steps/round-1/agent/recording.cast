[11156.797102, "o", "\u001b[32m\u001b[K385\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K387\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int solver_calls = 0;\r\n\u001b[32m\u001b[K388\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int converged_all = 1;\r\n"]
[11156.797218, "o", "\u001b[32m\u001b[K389\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    double \u001b[01;31m\u001b[Kmax_residual\u001b[m\u001b[K = 0.0;\r\n\u001b[32m\u001b[K390\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K391\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (int step = 0; step < nsteps; step++) {\r\n\u001b[32m\u001b[K392\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        const double *f_n = (nsources == 1) ? sources[0] : sources[step];\r\n\u001b[32m\u001b[K393\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        const double *f_np1 = (nsources == 1) ? sources[0] : sources[step + 1];\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        solver_calls++;\r\n\u001b[32m\u001b[K427\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (res) {\r\n\u001b[32m\u001b[K429\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (!res->converged) converged_all = 0;\r\n\u001b[32m\u001b[K430\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (res->relres > \u001b[01;31m\u001b[Kmax_residual\u001b[m\u001b[K) \u001b[01;31m\u001b[Kmax_residual\u001b[m\u001b[K = res->relres;\r\n\u001b[32m\u001b[K431\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            vec_copy(res->x, u_new, n);\r\n\u001b[32m\u001b[K432\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            solve_result_destroy(res);\r\n\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        } else {\r\n\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b["]
[11156.797289, "o", "m\u001b[K            converged_all = 0;\r\n\u001b[32m\u001b[K435\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (\u001b[01;31m\u001b[Kmax_residual\u001b[m\u001b[K < 1.0e30) \u001b[01;31m\u001b[Kmax_residual\u001b[m\u001b[K = 1.0e30;\r\n\u001b[32m\u001b[K436\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            vec_copy(u, u_new, n);\r\n\u001b[32m\u001b[K437\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K438\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K439\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        double *swap = u;\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K446\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    printf(\"timesteps: %d\\n\", nsteps);\r\n\u001b[32m\u001b[K447\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    printf(\"final_time: %.15e\\n\", dt * (double)nsteps);\r\n\u001b[32m\u001b[K448\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    printf(\"solver_calls: %d\\n\", solver_calls);\r\n\u001b[32m\u001b[K449\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    printf(\"converged_all: %s\\n\", converged_all ? \"yes\" : \"no\");\r\n\u001b[32m\u001b[K450\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    printf(\"\u001b[01;31m\u001b[Kmax_residual\u001b[m\u001b[K: %.6e\\n\", \u001b[01;31m\u001b[Kmax_residual\u001b[m\u001b[K);\r\n\u001b[32m\u001b[K451\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K452\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    free(u_new); free(rhs); free(tmp);\r\n\u001b[32m\u001b[K453\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    precond_destroy(P);\r\n\u001b[32m\u001b[K454\u001b[m\u001b[K"]
