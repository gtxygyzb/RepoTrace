[9714.040226, "o", "     1\t#include \"sparse.h\"\r\n     2\t#include \"vector.h\"\r\n     3\t#include <stdlib.h>\r\n     4\t#include <string.h>\r\n"]
[9714.040347, "o", "     5\t#include <math.h>\r\n     6\t\r\n     7\tCSRMatrix *csr_create(int rows, int cols, int nnz)\r\n     8\t{\r\n     9\t    CSRMatrix *A = (CSRMatrix *)malloc(sizeof(CSRMatrix));\r\n    10\t    if (!A) return NULL;\r\n    11\t    A->rows = rows;\r\n    12\t    A->cols = cols;\r\n    13\t    A->nnz = nnz;\r\n    14\t    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));\r\n    15\t    A->col_indices = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    16\t    A->row_ptr = (int *)calloc((rows >= 0 ? rows + 1 : 1), sizeof(int));\r\n    17\t    if (!A->values || !A->col_indices || !A->row_ptr) {\r\n    18\t        csr_destroy(A);\r\n    19\t        return NULL;\r\n    20\t    }\r\n"]
[9714.040432, "o", "    21\t    return A;\r\n    22\t}\r\n    23\t\r\n    24\tvoid csr_destroy(CSRMatrix *A)\r\n    25\t{\r\n    26\t    if (!A) return;\r\n    27\t    free(A->values);\r\n    28\t    free(A->col_indices);\r\n    29\t    free(A->row_ptr);\r\n    30\t    free(A);\r\n    31\t}\r\n    32\t\r\n    33\tCOOMatrix *coo_create(int rows, int cols, int nnz)\r\n"]
[9714.04051, "o", "    34\t{\r\n    35\t    COOMatrix *A = (COOMatrix *)malloc(sizeof(COOMatrix));\r\n    36\t    if (!A) return NULL;\r\n    37\t    A->rows = rows;\r\n    38\t    A->cols = cols;\r\n    39\t    A->nnz = nnz;\r\n    40\t    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));\r\n    41\t    A->row = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    42\t    A->col = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    43\t    if (!A->values || !A->row || !A->col) {\r\n    44\t        coo_destroy(A);\r\n    45\t        return NULL;\r\n    46\t    }\r\n"]
[9714.040581, "o", "    47\t    return A;\r\n    48\t}\r\n    49\t\r\n    50\tvoid coo_destroy(COOMatrix *A)\r\n    51\t{\r\n    52\t    if (!A) return;\r\n    53\t    free(A->values);\r\n    54\t    free(A->row);\r\n    55\t    free(A->col);\r\n    56\t    free(A);\r\n    57\t}\r\n    58"]
[9714.040652, "o", "\t\r\n    59\tstatic const COOMatrix *g_coo_sort_data = NULL;\r\n    60\t\r\n    61\tstatic int coo_qsort_cmp(const void *pa, const void *pb)\r\n    62\t{\r\n    63\t"]
[9714.040714, "o", "    int ia = *(const int *)pa;\r\n    64\t    int ib = *(const int *)pb;\r\n    65\t    const COOMatrix *A = g_coo_sort_data;\r\n    66\t    if (A->row[ia] != A->row[ib]) return A->row[ia] - A->row[ib];\r\n    67\t    return A->col[ia] - A->col[ib];\r\n    68\t}\r\n    69\t\r\n    70\tstatic COOMatrix *coo_sort_dedup(const COOMatrix *A)\r\n    71\t{\r\n    72\t    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);\r\n    73\t    if (!out) return NULL;\r\n    74\t\r\n    75\t    int *idx = (int *)malloc((A->nnz > 0 ? A->nnz : 1) * sizeof(int));\r\n    76\t    if (!idx) { coo_destroy(out); return NULL; }\r\n"]
[9714.04078, "o", "    77\t    for (int i = 0; i < A->nnz; i++) idx[i] = i;\r\n    78\t\r\n    79\t    g_coo_sort_data = A;\r\n    80\t    qsort(idx, A->nnz, sizeof(int), coo_qsort_cmp);\r\n    81\t    g_coo_sort_data = NULL;\r\n    82\t\r\n    83\t    int k = 0;\r\n    84\t    for (int i = 0; i < A->nnz; i++) {\r\n    85\t        int src = idx[i];\r\n"]
[9714.040839, "o", "    86\t        if (k > 0 && out->row[k-1] == A->row[src] && out->col[k-1] == A->col[src]) {\r\n    87\t            out->values[k-1] += A->values[src];\r\n    88\t        } else {\r\n    89\t            out->row[k] = A->row[src];\r\n    90\t            out->col[k] = A->col[src];\r\n    91\t            out->values[k] = A->values[src];\r\n    92\t            k++;\r\n    93\t        }\r\n    94\t    }\r\n    95\t"]
[9714.040934, "o", "    out->nnz = k;\r\n    96\t    free(idx);\r\n    97\t    return out;\r\n    98\t}\r\n    99\t\r\n   100\tCOOMatrix *csr_to_coo(const CSRMatrix *A)\r\n   101\t{\r\n   102\t    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);\r\n   103\t    if (!out) return NULL;\r\n   104\t    int k = 0;\r\n   105\t    for (int i = 0; i < A->rows; i++) {\r\n   106\t        for (int j = A->row_ptr[i]; j < A->row_ptr[i+1]; j++) {\r\n   107\t            out->row[k] = i;\r\n"]
[9714.040996, "o", "   108\t            out->col[k] = A->col_indices[j];\r\n   109\t            out->values[k] = A->values[j];\r\n   110\t            k++;\r\n   111\t        }\r\n   112\t    }\r\n   113\t    out->nnz = k;\r\n"]
[9714.041058, "o", "   114\t    return out;\r\n   115\t}\r\n   116\t\r\n   117\tCSRMatrix *coo_to_csr(const COOMatrix *A)\r\n   118\t{\r\n   119\t    COOMatrix *sorted = coo_sort_dedup(A);\r\n   120\t    if (!sorted) return NULL;\r\n   121\t\r\n   122\t    CSRMatrix *out = csr_create(sorted->rows, sorted->cols, sorted->nnz);\r\n   123\t    if (!out) { coo_destroy(sorted); return NULL; }\r\n   124\t\r\n   125\t    for (int i = 0; i <= sorted->rows; i++) out->row_ptr[i] = 0;\r\n   126\t\r\n   127\t    for (int k = 0; k < sorted->nnz; k++) {"]
[9714.04112, "o", "\r\n   128\t        out->row_ptr[sorted->row[k] + 1]++;\r\n   129\t    }\r\n   130\t    for (int i = 0; i < sorted->rows; i++) {\r\n   131\t        out->row_ptr[i+1] += out->row_ptr[i];\r\n   132\t    }\r\n   133\t\r\n   134\t    int *next = (int *)malloc((sorted->rows > 0 ? sorted->rows : 1) * sizeof(int));\r\n   135\t    if (!next) { csr_destroy(out); coo_destroy(sorted); return NULL; }\r\n   136\t    for (int i = 0; i < sorted->rows; i++) next[i] = out->row_ptr[i];\r\n   137\t\r\n   138\t"]
[9714.041194, "o", "    for (int k = 0; k < sorted->nnz; k++) {\r\n   139\t        int r = sorted->row[k];\r\n   140\t        int pos = next[r]++;\r\n   141\t        out->col_indices[pos] = sorted->col[k];\r\n   142\t        out->values[pos] = sorted->values[k];\r\n   143\t    }\r\n   144\t\r\n   145\t    free(next);\r\n   146\t    coo_destroy(sorted);\r\n   147\t    return out;\r\n   148\t}\r\n   149\t\r\n"]
[9714.041257, "o", "   150\tvoid csr_spmv(const CSRMatrix *A, const double *x, double *y)\r\n   151\t{\r\n   152\t    for (int i = 0; i < A->rows; i++) {\r\n   153\t        double s = 0.0;\r\n   154\t        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n   155\t            s += A->values[k] * x[A->col_indices[k]];\r\n   156\t        }\r\n   157\t        y[i] = s;\r\n   158\t    }\r\n   159\t}\r\n   160\t"]
[9714.041314, "o", "\r\n   161\tstatic int csr_find_in_row(const CSRMatrix *A, int row, int col)\r\n   162\t{\r\n   163\t    int lo = A->row_ptr[row];\r\n   164\t    int hi = A->row_ptr[row+1] - 1;\r\n   165\t    while (lo <= hi) {\r\n   166\t        int mid = (lo + hi) / 2;\r\n   167\t        if (A->col_indices[mid] == col) return mid;\r\n   168\t"]
[9714.041378, "o", "        if (A->col_indices[mid] < col) lo = mid + 1;\r\n   169\t        else hi = mid - 1;\r\n   170\t    }\r\n   171\t    return -1;\r\n   172\t}\r\n   173\t\r\n"]
[9714.041435, "o", "   174\tCSRMatrix *csr_transpose(const CSRMatrix *A)\r\n   175\t{\r\n   176\t    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);\r\n   177\t    if (!T) return NULL;\r\n   178\t\r\n   179\t    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;\r\n   180\t    for (int k = 0; k < A->nnz; k++) {\r\n   181\t        T->row_ptr[A->col_indices[k] + 1]++;\r\n   182\t    }\r\n   183\t    for (int i = 0; i < A->cols; i++) {\r\n   184\t        T->row_ptr[i+1] += T->row_ptr[i];\r\n   185\t    }\r\n   186\t\r\n"]
[9714.041493, "o", "   187\t    int *next = (int *)malloc((A->cols > 0 ? A->cols : 1) * sizeof(int));\r\n   188\t    if (!next) { csr_destroy(T); return NULL; }\r\n   189\t    for (int i = 0; i < A->cols; i++) next[i] = T->row_ptr[i];\r\n   190\t\r\n   191\t    for (int i = 0; i < A->rows; i++) {\r\n   192\t        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n   193\t            int c = A->col_indices[k];\r\n   194\t            int pos = next[c]++;\r\n   195\t            T->col_indices[pos] = i;\r\n"]
[9714.041559, "o", "   196\t            T->values[pos] = A->values[k];\r\n   197\t        }\r\n   198\t    }\r\n   199\t\r\n   200\t    free(next);\r\n   201\t    return T;\r\n   202\t"]
[9714.041618, "o", "}\r\n   203\t\r\n   204\tint csr_is_symmetric(const CSRMatrix *A, double tol)\r\n   205\t{\r\n   206\t    if (A->rows != A->cols) return 0;\r\n   207\t    for (int i = 0; i < A->rows; i++) {\r\n   208\t        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n   209\t            int j = A->col_indices[k];\r\n   210\t            int idx = csr_find_in_row(A, j, i);\r\n   211\t            if (idx < 0) return 0;\r\n   212\t            if (fabs(A->values[k] - A->values[idx]) > tol) return 0;\r\n   213\t        }\r\n   214\t    }\r\n   215\t    return 1;\r\n"]
[9714.04168, "o", "   216\t}\r\n   217\t\r\n   218\tdouble *csr_diagonal(const CSRMatrix *A)\r\n   219\t{\r\n   220\t    int n = A->rows < A->cols ? A->rows : A->cols;\r\n   221\t    double *diag = vec_create(n);\r\n   222\t    if (!diag) return NULL;\r\n   223\t    for (int i = 0; i < n; i++) {\r\n   224\t        int idx = csr_find_in_row(A, i, i);\r\n"]
[9714.041738, "o", "   225\t        diag[i] = (idx >= 0) ? A->values[idx] : 0.0;\r\n   226\t    }\r\n   227\t    return diag;\r\n   228\t}\r\n   229\t\r\n   230\tstatic int mm_parse_header(const char *line, int *is_array, int *is_symmetric)\r\n   231\t{\r\n   232\t    char buf[1024];\r\n   233\t    strncpy(buf, line, sizeof(buf)-1);\r\n"]
[9714.041795, "o", "   234\t    buf[sizeof(buf)-1] = '\\0';\r\n   235\t\r\n   236\t    char *tok = strtok(buf, \" \\t\\r\\n\");\r\n   237\t    if (!tok || strcmp(tok, \"%%MatrixMarket\") != 0) return -1;\r\n   238\t\r\n   239\t    tok = strtok(NULL, \" \\t\\r\\n\");\r\n   240\t    if (!tok || strcmp(tok, \"matrix\") != 0) return -1;\r\n   241\t\r\n"]
[9714.04185, "o", "   242\t    tok = strtok(NULL, \" \\t\\r\\n\");\r\n   243\t    if (!tok) return -1;\r\n   244\t    if (strcmp(tok, \"coordinate\") == 0) *is_array = 0;\r\n   245\t    else if (strcmp(tok, \"array\") == 0) *is_array = 1;\r\n   246\t    else return -1;\r\n   247\t\r\n   248\t    tok = strtok(NULL, \" \\t\\r\\n\");\r\n"]
[9714.041919, "o", "   249\t    if (!tok) return -1;\r\n   250\t    if (strcmp(tok, \"real\") != 0 && strcmp(tok, \"double\") != 0) return -1;\r\n   251\t\r\n   252\t    *is_symmetric = 0;\r\n   253\t    tok = strtok(NULL, \" \\t\\r\\n\");\r\n   254\t    if (tok && strcmp(tok, \"symmetric\") == 0) *is_symmetric = 1;\r\n   255\t\r\n   256\t    return 0;\r\n   257\t}\r\n"]
[9714.041982, "o", "   258\t\r\n   259\tstatic int read_non_comment_line(FILE *fp, char *buf, int bufsize)\r\n   260\t{\r\n"]
[9714.042556, "o", "\u001b[?2004h"]
[9714.042613, "o", "root@n30009:/app# "]
[9714.311645, "i", "nl -ba src/sparse.c | sed -n '261,560p'\n"]
[9714.312064, "o", "nl -ba src/sparse.c | sed -n '261,560p'\r\n\u001b[?2004l\r"]
[9714.315939, "o", "   261\t    while (fgets(buf, bufsize, fp)) {\r\n   262\t        char *s = buf;\r\n   263\t        while (*s == ' ' || *s == '\\t') s++;\r\n   264\t        if (*s == '%' || *s == '\\n' || *s == '\\r' || *s == '\\0') continue;\r\n   265\t        return 0;\r\n   266\t    }\r\n   267\t    return -1;\r\n   268\t}\r\n   269\t\r\n   270\tCSRMatrix *csr_read_mm(const char *filename)\r\n   271\t{\r\n   272\t    FILE *fp = fopen(filename, \"r\");\r\n   273\t    if (!fp) return NULL;\r\n   274\t\r\n   275\t    char line[1024];\r\n   276\t    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }\r\n   277\t    int is_array = 0, is_symmetric = 0;\r\n   278\t    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || is_array) {\r\n   279\t        fclose(fp);\r\n   280\t        return NULL;"]
[9714.3161, "o", "\r\n   281\t    }\r\n   282\t\r\n   283\t    int rows, cols, nnz;\r\n   284\t    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }\r\n   285\t    if (sscanf(line, \"%d %d %d\", &rows, &cols, &nnz) != 3 || rows <= 0 || cols <= 0 || nnz < 0) {\r\n   286\t        fclose(fp);\r\n   287\t        return NULL;\r\n   288\t    }\r\n   289\t\r\n   290\t    int cap = is_symmetric ? 2 * nnz + 1 : nnz;\r\n   291\t    if (cap < 1) cap = 1;\r\n   292\t    COOMatrix *coo = coo_create(rows, cols, cap);\r\n   293\t    if (!coo) { fclose(fp); return NULL; }\r\n   294\t\r\n   295\t    int k = 0;\r\n   296\t    while (k < coo->nnz && read_non_comment_line(fp, line, sizeof(line)) == 0) {\r\n   297\t        int r, c;\r\n   298\t        double v;\r\n   299\t        if (sscanf(line, \"%d %d %lf\", &r, &c, &v) != 3) continue;\r\n   300\t        if (r < 1 || r > rows || c < 1 || c > cols) continue;\r\n   301\t        r--; c--;\r\n   302\t\r\n   303\t        coo->row[k] = r;\r\n   304"]
[9714.31619, "o", "\t        coo->col[k] = c;\r\n   305\t        coo->values[k] = v;\r\n   306\t        k++;\r\n   307\t\r\n   308\t        if (is_symmetric && r != c) {\r\n   309\t            coo->row[k] = c;\r\n   310\t            coo->col[k] = r;\r\n   311\t            coo->values[k] = v;\r\n   312\t            k++;\r\n   313\t        }\r\n   314\t    }\r\n   315\t    coo->nnz = k;\r\n   316\t\r\n   317\t    CSRMatrix *A = coo_to_csr(coo);\r\n"]
[9714.316265, "o", "   318\t    coo_destroy(coo);\r\n   319\t    fclose(fp);\r\n   320\t    return A;\r\n   321\t}\r\n   322\t\r\n   323\tint csr_write_mm(const CSRMatrix *A, const char *filename)\r\n   324\t{\r\n   325\t    FILE *fp = fopen(filename, \"w\");\r\n   326\t    if (!fp) return -1;\r\n   327\t\r\n   328\t    fprintf(fp, \"%%%%MatrixMarket matrix coordinate real general\\n\");\r\n   329\t    fprintf(fp, \"%d %d %d\\n\", A->rows, A->cols, A->nnz);\r\n   330\t    for (int i = 0; i < A->rows; i++) {\r\n   331\t"]
[9714.316335, "o", "        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n   332\t            fprintf(fp, \"%d %d %.15g\\n\", i+1, A->col_indices[k]+1, A->values[k]);\r\n   333\t        }\r\n   334\t    }\r\n   335\t    fclose(fp);\r\n   336\t    return 0;\r\n   337\t}\r\n   338\t\r\n   339\tdouble *vec_read_mm_array(const char *filename, int *n_out)\r\n   340\t{\r\n   341\t    FILE *fp = fopen(filename, \"r\");"]
[9714.316407, "o", "\r\n   342\t    if (!fp) return NULL;\r\n   343\t\r\n   344\t    char line[1024];\r\n   345\t    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }\r\n   346\t    int is_array = 0, is_symmetric = 0;\r\n   347\t    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || !is_array) {\r\n   348\t        fclose(fp);\r\n   349\t        return NULL;\r\n   350\t    }\r\n   351\t\r\n   352\t    int rows, cols;\r\n   353\t"]
[9714.316478, "o", "    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }\r\n   354\t    if (sscanf(line, \"%d %d\", &rows, &cols) != 2 || rows <= 0 || cols != 1) {\r\n   355\t        fclose(fp);\r\n   356\t        return NULL;\r\n   357\t    }\r\n   358\t\r\n   359\t    double *x = vec_create(rows);\r\n   360\t    if (!x) { fclose(fp); return NULL; }\r\n   361\t\r\n"]
[9714.31655, "o", "   362\t    int i = 0;\r\n   363\t    while (i < rows && read_non_comment_line(fp, line, sizeof(line)) == 0) {\r\n   364\t        double v;\r\n   365\t        if (sscanf(line, \"%lf\", &v) != 1) { free(x); fclose(fp); return NULL; }\r\n   366\t        x[i++] = v;\r\n   367\t    }\r\n   368\t    if (i != rows) { free(x); fclose(fp); return NULL; }\r\n   369\t\r\n   370\t    fclose(fp);\r\n   371\t    *n_out = rows;\r\n   372\t    return x;\r\n   373\t}\r\n   374\t\r\n   375\tint vec_write_mm_array(const double *x, int n, const char *filename)\r\n"]
[9714.316627, "o", "   376\t{\r\n   377\t    FILE *fp = fopen(filename, \"w\");\r\n   378\t    if (!fp) return -1;\r\n   379\t    fprintf(fp, \"%%%%MatrixMarket matrix array real general\\n\");\r\n   380\t    fprintf(fp, \"%d 1\\n\", n);\r\n   381\t    for (int i = 0; i < n; i++) {\r\n   382\t        fprintf(fp, \"%.15g\\n\", x[i]);\r\n   383\t    }\r\n   384\t    fclose(fp);\r\n   385\t    return 0;\r\n   386\t}\r\n"]
