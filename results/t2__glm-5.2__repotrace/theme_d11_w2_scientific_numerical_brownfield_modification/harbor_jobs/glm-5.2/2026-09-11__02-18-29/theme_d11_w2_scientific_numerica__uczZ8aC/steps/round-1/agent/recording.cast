[1145.625249, "o", "\u001b[?2004h> "]
[1145.625309, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.625363, "o", "> "]
[1145.625479, "o", "        printf(\"Solution:\\n\");\r\n\u001b[?2004l\r"]
[1145.625535, "o", "\u001b[?2004h> "]
