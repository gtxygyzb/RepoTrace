[11145.890092, "o", "            csr_spmv(A_rhs, u, tmp);\r\n            for (int i = 0; i < n; i++) {\r\n                rhs[i] = tmp[i] + 0.5 * dt * (f_n[i] + f_np1[i]) + alpha * dt * flux[i];\r\n            }\r\n        }\r\n\r\n        for (int i = 0; i < nx; i++) {\r\n"]
[11145.890204, "o", "            for (int j = 0; j < ny; j++) {\r\n                if (is_dirichlet_node(i, j, nx, ny, left, right, bottom, top)) {\r\n                    int idx = i * ny + j;\r\n                    rhs[idx] = dirichlet_value(i, j, nx, ny, left_vals, right_vals,\r\n                                                bottom_vals, top_vals, left, right,\r\n                                                bottom, top);\r\n                }\r\n            }\r\n        }\r\n\r\n        SolveResult *res = NULL;\r\n        if (strcmp(solver, \"cg\") == 0) {\r\n            res = cg_solve(A_sys, rhs, u, tol, maxiter, P);\r\n        } else if (strcmp(solver, \"gmres\") == 0) {\r\n            res = gmres_solve(A_sys, rhs, u, tol, maxiter, restart, P);\r\n        } else {\r\n            converged_all = 0;\r\n            vec_copy(u, u_new, n);\r\n        }\r\n        solver_calls++;\r\n\r\n        if (res) {\r\n            if (!res->converged) converged_all = 0;\r\n"]
[11145.890301, "o", "            if (res->relres > max_residual) max_residual = res->relres;\r\n            vec_copy(res->x, u_new, n);\r\n            solve_result_destroy(res);\r\n        } else {\r\n            converged_all = 0;\r\n            if (max_residual < 1.0e30) max_residual = 1.0e30;\r\n            vec_copy(u, u_new, n);\r\n        }\r\n\r\n        double *swap = u;\r\n        u = u_new;\r\n        u_new = swap;\r\n    }\r\n\r\n    int rc = vec_write_mm_array(u, n, output);\r\n\r\n    printf(\"timesteps: %d\\n\", nsteps);\r\n    printf(\"final_time: %.15e\\n\", dt * (double)nsteps);\r\n    printf(\"solver_calls: %d\\n\", solver_calls);\r\n    printf(\"converged_all: %s\\n\", converged_all ? \"yes\" : \"no\");\r\n"]
[11145.890374, "o", "    printf(\"max_residual: %.6e\\n\", max_residual);\r\n\r\n    free(u_new); free(rhs); free(tmp);\r\n    precond_destroy(P);\r\n    csr_destroy(A_rhs);\r\n    csr_destroy(A_sys);\r\n    free(flux);\r\n    free(left_vals); free(right_vals); free(bottom_vals); free(top_vals);\r\n    for (int i = 0; i < nsources; i++) free(sources[i]);\r\n    free(sources);\r\n    free_source_list(source_files, nsources);\r\n"]
