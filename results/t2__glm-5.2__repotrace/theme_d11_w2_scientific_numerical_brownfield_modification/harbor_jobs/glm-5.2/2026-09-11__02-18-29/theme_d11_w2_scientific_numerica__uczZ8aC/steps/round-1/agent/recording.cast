[7830.510566, "o", "===== include/convdiff.h =====\r\n"]
[7830.51363, "o", "#ifndef CONVDIFF_H\r\n#define CONVDIFF_H\r\n\r\n#include \"sparse.h\"\r\n#include \"poisson.h\"\r\n\r\nint convdiff_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n                      double kappa, double vx, double vy,\r\n                      const char *source_file, PoissonBC left, PoissonBC right,\r\n"]
[7830.513703, "o", "                      PoissonBC bottom, PoissonBC top,\r\n                      CSRMatrix **A_out, double **b_out);\r\n\r\ndouble convdiff_peclet(double vx, double vy, double hx, double hy, double kappa);\r\n\r\n#endif /* CONVDIFF_H */\r\n"]
[7830.514127, "o", "===== include/dense.h =====\r\n"]
[7830.517025, "o", "#ifndef DENSE_H\r\n#define DENSE_H\r\n\r\n#include <stdio.h>\r\n\r\n"]
[7830.517072, "o", "/*\r\n * Dense matrix stored in row-major order.\r\n * Element (i,j) is at data[i * cols + j].\r\n */\r\ntypedef struct {\r\n    int    rows;\r\n    int    cols;\r\n    double *data;\r\n} DenseMatrix;\r\n\r\n"]
[7830.517119, "o", "/* Lifecycle */\r\nDenseMatrix *dm_create(int rows, int cols);\r\nvoid         dm_destroy(DenseMatrix *m);\r\n\r\n/* Element access */\r\ndouble dm_get(const DenseMatrix *m, int i, int j);\r\nvoid   dm_set(DenseMatrix *m, int i, int j, double val);\r\n\r\n/* Operations */\r\n"]
[7830.517179, "o", "void dm_matvec(const DenseMatrix *A, const double *x, double *y);\r\n\r\n/*\r\n * Solve Ax = b using LU decomposition with partial pivoting.\r\n * A is not modified (internal copy is made).\r\n * Returns 0 on success, -1 on singular matrix or allocation failure.\r\n */\r\nint dm_solve(const DenseMatrix *A, const double *b, double *x);\r\n\r\n/* Debug */\r\nvoid dm_print(const DenseMatrix *m, FILE *out);\r\n\r\n"]
[7830.517244, "o", "#endif /* DENSE_H */\r\n"]
[7830.517662, "o", "===== include/heat.h =====\r\n"]
[7830.520367, "o", "#ifndef HEAT_H\r\n#define HEAT_H\r\n\r\n#include \"poisson.h\"\r\n\r\n"]
[7830.520414, "o", "int heat_solve(int nx, int ny, double x0, double x1, double y0, double y1,\r\n               double alpha, double dt, int nsteps, const char *scheme,\r\n               const char *ic_file, const char *source_arg,\r\n               PoissonBC left, PoissonBC right, PoissonBC bottom, PoissonBC top,\r\n               const char *solver, const char *precond, double tol, int maxiter,\r\n               int restart, double omega, const char *output);\r\n\r\n#endif /* HEAT_H */\r\n"]
[7830.520895, "o", "===== include/io.h =====\r\n"]
[7830.523585, "o", "#ifndef IO_H\r\n#define IO_H\r\n\r\n#include \"dense.h\"\r\n\r\n"]
[7830.523632, "o", "/*\r\n * Read dense matrix from text file.\r\n * Format:\r\n *   rows cols\r\n *   a00 a01 a02 ...\r\n *   a10 a11 a12 ...\r\n *   ...\r\n * Returns NULL on error.\r\n */\r\nDenseMatrix *dm_read_text(const char *filename);\r\n\r\n/*\r\n"]
[7830.523675, "o", " * Write dense matrix to text file.\r\n * Returns 0 on success, -1 on error.\r\n */\r\nint dm_write_text(const DenseMatrix *m, const char *filename);\r\n\r\n/*\r\n * Read vector from text file.\r\n * Format:\r\n *   n\r\n"]
[7830.523715, "o", " *   v0\r\n *   v1\r\n *   ...\r\n * Sets *n_out to the dimension. Returns NULL on error.\r\n */\r\ndouble *vec_read_text(const char *filename, int *n_out);\r\n\r\n"]
[7830.523755, "o", "/*\r\n * Write vector to text file.\r\n * Returns 0 on success, -1 on error.\r\n */\r\nint vec_write_text(const double *x, int n, const char *filename);\r\n\r\n#endif /* IO_H */\r\n"]
[7830.52419, "o", "===== include/poisson.h =====\r\n"]
[7830.52685, "o", "#ifndef POISSON_H\r\n#define POISSON_H\r\n\r\n#include \"sparse.h\"\r\n\r\ntypedef enum {\r\n"]
[7830.526912, "o", "    POISSON_DIRICHLET,\r\n    POISSON_NEUMANN\r\n} PoissonBCType;\r\n\r\ntypedef struct {\r\n    PoissonBCType type;\r\n    const char *file;\r\n} PoissonBC;\r\n\r\n"]
[7830.526957, "o", "int poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n                    const char *source_file, PoissonBC left, PoissonBC right,\r\n                    PoissonBC bottom, PoissonBC top,\r\n                    CSRMatrix **A_out, double **b_out);\r\n\r\ndouble *poisson_read_source(const char *filename, int nx, int ny);\r\ndouble *poisson_read_boundary(const char *filename, int expected);\r\n\r\n#endif /* POISSON_H */\r\n"]
[7830.527364, "o", "===== include/precond.h =====\r\n"]
[7830.530052, "o", "#ifndef PRECOND_H\r\n#define PRECOND_H\r\n\r\n#include \"sparse.h\"\r\n\r\ntypedef enum {\r\n"]
[7830.530107, "o", "    PRECOND_NONE,\r\n    PRECOND_JACOBI,\r\n    PRECOND_ILU0,\r\n    PRECOND_SSOR\r\n} PrecondType;\r\n\r\ntypedef struct {\r\n    PrecondType type;\r\n    int n;\r\n    double omega;\r\n    double *diag;       /* Jacobi and SSOR */\r\n    CSRMatrix *lu;      /* ILU(0) factors in one CSR pattern */"]
[7830.530161, "o", "\r\n    const CSRMatrix *ssor_A;\r\n} Precond;\r\n\r\nPrecond *precond_create(const CSRMatrix *A, const char *name, double omega);\r\nvoid     precond_destroy(Precond *P);\r\nint      precond_apply(Precond *P, const CSRMatrix *A, const double *r, double *z);\r\n\r\n#endif /* PRECOND_H */\r\n"]
[7830.530561, "o", "===== include/solvers.h =====\r\n"]
[7830.533225, "o", "#ifndef SOLVERS_H\r\n#define SOLVERS_H\r\n\r\n#include \"sparse.h\"\r\n#include \"precond.h\"\r\n"]
[7830.533278, "o", "\r\ntypedef struct {\r\n    double *x;\r\n    double relres;          /* true relative residual ||b-A*x||/||b|| */\r\n    double true_residual;   /* absolute true residual norm ||b-A*x|| */\r\n    int iterations;\r\n    int converged;\r\n    double *history;        /* true relative residual at each iteration */\r\n    int history_len;        /* number of stored history entries */\r\n} SolveResult;\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n"]
[7830.533328, "o", "                      double tol, int maxiter, Precond *P);\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                           double tol, int maxiter, int m, Precond *P);\r\n\r\nvoid solve_result_destroy(SolveResult *res);\r\n\r\n#endif /* SOLVERS_H */\r\n"]
[7830.533728, "o", "===== include/sparse.h =====\r\n"]
[7830.536386, "o", "#ifndef SPARSE_H\r\n#define SPARSE_H\r\n\r\n#include <stdio.h>\r\n\r\ntypedef struct {\r\n    int    rows;\r\n"]
[7830.536441, "o", "    int    cols;\r\n    int    nnz;\r\n    double *values;\r\n    int    *col_indices;\r\n    int    *row_ptr;\r\n} CSRMatrix;\r\n\r\ntypedef struct {\r\n    int    rows;\r\n    int    cols;\r\n    int    nnz;"]
[7830.53649, "o", "\r\n    double *values;\r\n    int    *row;\r\n    int    *col;\r\n} COOMatrix;\r\n\r\n/* Lifecycle */\r\nCSRMatrix  *csr_create(int rows, int cols, int nnz);\r\nvoid        csr_destroy(CSRMatrix *A);\r\nCOOMatrix  *coo_create(int rows, int cols, int nnz);\r\nvoid        coo_destroy(COOMatrix *A);\r\n"]
[7830.536541, "o", "\r\n/* Conversions */\r\nCOOMatrix  *csr_to_coo(const CSRMatrix *A);\r\nCSRMatrix  *coo_to_csr(const COOMatrix *A);\r\n\r\n/* Operations */\r\nvoid        csr_spmv(const CSRMatrix *A, const double *x, double *y);\r\nCSRMatrix  *csr_transpose(const CSRMatrix *A);\r\nint         csr_is_symmetric(const CSRMatrix *A, double tol);\r\ndouble     *csr_diagonal(const CSRMatrix *A);\r\n\r\n"]
[7830.53659, "o", "/* Matrix Market I/O */\r\nCSRMatrix  *csr_read_mm(const char *filename);\r\nint         csr_write_mm(const CSRMatrix *A, const char *filename);\r\ndouble     *vec_read_mm_array(const char *filename, int *n_out);\r\nint         vec_write_mm_array(const double *x, int n, const char *filename);\r\n\r\n#endif /* SPARSE_H */\r\n"]
[7830.536993, "o", "===== include/vector.h =====\r\n"]
[7830.539551, "o", "#ifndef VECTOR_H\r\n#define VECTOR_H\r\n\r\n#include <stdio.h>\r\n\r\n/* Allocate a zero-initialized vector of length n. Returns NULL on failure. */\r\ndouble *vec_create(int n);\r\n"]
[7830.539623, "o", "\r\n/* Deep copy: dst[i] = src[i] */\r\nvoid vec_copy(const double *src, double *dst, int n);\r\n\r\n/* Zero out: x[i] = 0 */\r\nvoid vec_zero(double *x, int n);\r\n\r\n/* Scale: x[i] *= a */\r\nvoid vec_scale(double a, double *x, int n);\r\n\r\n/* AXPY: y[i] += a * x[i] */\r\nvoid vec_axpy(double a, const double *x, double *y, int n);\r\n\r\n/* Dot product: sum(x[i] * y[i]) */\r\n"]
[7830.539677, "o", "double vec_dot(const double *x, const double *y, int n);\r\n\r\n/* L2 norm: sqrt(sum(x[i]^2)) */\r\ndouble vec_norm2(const double *x, int n);\r\n\r\n/* Print vector to stream, one value per line */\r\nvoid vec_print(const double *x, int n, FILE *out);\r\n\r\n#endif /* VECTOR_H */\r\n"]
[7830.540196, "o", "\u001b[?2004h"]
[7830.54025, "o", "root@n30009:/app# "]
[7839.099127, "i", "sed -n '1,260p' src/main.c\n"]
[7839.099401, "o", "sed -n '1,260p' src/main.c\r\n\u001b[?2004l\r"]
[7839.102334, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include \"dense.h\"\r\n#include \"vector.h\"\r\n#include \"io.h\"\r\n#include \"sparse.h\"\r\n"]
[7839.102421, "o", "#include \"precond.h\"\r\n#include \"solvers.h\"\r\n#include \"poisson.h\"\r\n#include \"heat.h\"\r\n#include \"convdiff.h\"\r\n\r\nstatic void usage(const char *prog)\r\n{\r\n    fprintf(stderr, \"Usage:\\n\");\r\n    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\n\", prog);\r\n    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n"]
[7839.102507, "o", "    fprintf(stderr, \"  %s heat --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --alpha <float> --dt <float> --nsteps <int> --scheme <backward-euler|crank-nicolson> --ic <file> --source <file>[,<file>,...] --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file>\\n\", prog);\r\n    fprintf(stderr, \"  %s convdiff --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --kappa <float> --vx <float> --vy <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file> [--history <file>]\\n\", prog);\r\n}"]
[7839.102575, "o", "\r\n\r\nstatic const char *get_opt(int argc, char **argv, const char *name)\r\n{\r\n    for (int i = 0; i < argc - 1; i++) {\r\n        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    }\r\n    return NULL;\r\n}\r\n\r\nstatic int write_history_file(const SolveResult *res, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    for (int i = 0; i < res->history_len; i++) {\r\n        fprintf(fp, \"%d\\t%.15e\\n\", i, res->history[i]);\r\n    }\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n\r\nstatic void print_solve_summary(const SolveResult *res)\r\n{\r\n    printf(\"converged: %s\\n\", res->converged ? \"yes\" : \"no\");\r\n    printf(\"iterations: %d\\n\", res->iterations);\r\n    printf(\"residual: %.6e\\n\", res->relres);\r\n    printf(\"true_residual: %.6e\\n\", res->true_residual);\r\n}\r\n"]
[7839.102623, "o", "\r\nstatic int validate_ssor_omega(double omega)\r\n{\r\n    if (!(omega > 0.0 && omega < 2.0)) {\r\n        fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n\r\n"]
[7839.102714, "o", "static int cmd_dense_solve(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"Error: dense-solve requires <matrix_file> <rhs_file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    const char *mat_file = argv[0];\r\n    const char *rhs_file = argv[1];\r\n    const char *out_file = (argc >= 3) ? argv[2] : NULL;\r\n\r\n    DenseMatrix *A = dm_read_text(mat_file);\r\n    if (!A) {\r\n        fprintf(stderr, \"Error: cannot read matrix from '%s'\\n\", mat_file);\r\n        return 1;\r\n    }\r\n\r\n"]
[7839.102774, "o", "    int n;\r\n    double *b = vec_read_text(rhs_file, &n);\r\n    if (!b) {\r\n        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (A->rows != n || A->cols != n) {\r\n        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n                A->rows, A->cols, n);\r\n        free(b);\r\n        dm_destroy(A);\r\n"]
[7839.102834, "o", "        return 1;\r\n    }\r\n\r\n    double *x = vec_create(n);\r\n    if (!x) {\r\n        fprintf(stderr, \"Error: allocation failed\\n\");\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    int rc = dm_solve(A, b, x);\r\n    if (rc != 0) {\r\n"]
[7839.102948, "o", "        fprintf(stderr, \"Error: solver failed (singular or ill-conditioned)\\n\");\r\n        free(x);\r\n        free(b);\r\n        dm_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    if (out_file) {\r\n        vec_write_text(x, n, out_file);\r\n        printf(\"Solution written to %s\\n\", out_file);\r\n    } else {\r\n        printf(\"Solution:\\n\");\r\n        vec_print(x, n, stdout);\r\n    }\r\n\r\n    double *r = vec_create(n);\r\n    dm_matvec(A, x, r);\r\n    vec_axpy(-1.0, b, r, n);\r\n    printf(\"Residual norm: %.6e\\n\", vec_norm2(r, n));\r\n\r\n    free(r);\r\n    free(x);\r\n    free(b);\r\n    dm_destroy(A);\r\n    return 0;"]
[7839.103009, "o", "\r\n}\r\n\r\nstatic int parse_bc(const char *s, PoissonBC *bc)\r\n{\r\n    const char *colon = strchr(s, ':');\r\n    if (!colon || colon == s) return -1;\r\n\r\n    size_t len = colon - s;\r\n    char type[32];\r\n    if (len >= sizeof(type)) return -1;\r\n    memcpy(type, s, len);\r\n    type[len] = '\\0';\r\n\r\n    if (strcmp(type, \"dirichlet\") == 0) bc->type = POISSON_DIRICHLET;\r\n"]
[7839.103071, "o", "    else if (strcmp(type, \"neumann\") == 0) bc->type = POISSON_NEUMANN;\r\n    else return -1;\r\n\r\n    bc->file = colon + 1;\r\n    return 0;\r\n}\r\n\r\nstatic int run_solver_and_print(const CSRMatrix *A, const double *b,\r\n                                const char *solver, const char *precond,\r\n                                double tol, int maxiter, int restart,\r\n                                double omega, const char *output,\r\n                                const char *history)\r\n{\r\n    Precond *P = precond_create(A, precond, omega);\r\n    if (!P) {"]
[7839.103129, "o", "\r\n        fprintf(stderr, \"Error: cannot create preconditioner '%s'\\n\", precond);\r\n        return 1;\r\n    }\r\n\r\n    SolveResult *res = NULL;\r\n    if (strcmp(solver, \"cg\") == 0) {\r\n        res = cg_solve(A, b, NULL, tol, maxiter, P);\r\n    } else if (strcmp(solver, \"gmres\") == 0) {\r\n        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);\r\n    } else {\r\n"]
[7839.103193, "o", "        fprintf(stderr, \"Error: unknown solver '%s'\\n\", solver);\r\n        precond_destroy(P);\r\n        return 1;\r\n    }\r\n\r\n    if (!res) {\r\n        fprintf(stderr, \"Error: solver allocation failed\\n\");\r\n        precond_destroy(P);\r\n        return 1;\r\n    }\r\n\r\n    print_solve_summary(res);\r\n\r\n    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {\r\n        fprintf(stderr, \"Error: cannot write output to '%s'\\n\", output);\r\n"]
[7839.10326, "o", "    }\r\n    if (history && write_history_file(res, history) != 0) {\r\n        fprintf(stderr, \"Error: cannot write history to '%s'\\n\", history);\r\n    }\r\n\r\n    solve_result_destroy(res);\r\n    precond_destroy(P);\r\n    return 0;\r\n}\r\n\r\nstatic int cmd_sparse_solve(int argc, char **argv)\r\n{\r\n    const char *input = get_opt(argc, argv, \"--input\");\r\n"]
[7839.103323, "o", "    const char *rhs_file = get_opt(argc, argv, \"--rhs\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n    const char *history = get_opt(argc, argv, \"--history\");\r\n\r\n    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {\r\n        fprintf(stderr, \"Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n"]
[7839.103386, "o", "    }\r\n\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid solver parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n"]
[7839.103447, "o", "        return 1;\r\n    }\r\n\r\n    CSRMatrix *A = csr_read_mm(input);\r\n    if (!A) {\r\n        fprintf(stderr, \"Error: cannot read sparse matrix from '%s'\\n\", input);\r\n        return 1;\r\n    }\r\n\r\n    int n;\r\n    double *b = vec_read_mm_array(rhs_file, &n);\r\n    if (!b) {\r\n        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n        csr_destroy(A);\r\n        return 1;\r\n"]
[7839.103506, "o", "    }\r\n\r\n    if (A->rows != n || A->cols != n) {\r\n        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n                A->rows, A->cols, n);\r\n        free(b);\r\n        csr_destroy(A);\r\n        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\r\n    free(b);\r\n"]
[7839.103575, "o", "    csr_destroy(A);\r\n    return rc;\r\n}\r\n\r\nstatic int cmd_poisson(int argc, char **argv)\r\n{\r\n    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n"]
[7839.103634, "o", "    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n"]
[7839.104137, "o", "\u001b[?2004h"]
[7839.104202, "o", "root@n30009:/app# "]
[7839.378673, "i", "sed -n '260,620p' src/main.c\n"]
[7839.378987, "o", "sed -n '260,620p' src/main.c\r\n\u001b[?2004l\r"]
[7839.382056, "o", "    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n    const char *source = get_opt(argc, argv, \"--source\");\r\n    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n"]
[7839.38215, "o", "    const char *history = get_opt(argc, argv, \"--history\");\r\n\r\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||\r\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n        !solver || !precond || !tol_s || !maxiter_s) {\r\n        fprintf(stderr, \"Error: poisson requires grid, source, boundary condition, solver, precond, tol, maxiter\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n\r\n    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n"]
[7839.382218, "o", "\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid poisson parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n"]
[7839.382282, "o", "        return 1;\r\n    }\r\n\r\n    CSRMatrix *A = NULL;\r\n    double *b = NULL;\r\n    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {\r\n        fprintf(stderr, \"Error: cannot assemble Poisson system\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n"]
[7839.382343, "o", "\r\n    free(b);\r\n    csr_destroy(A);\r\n    return rc;\r\n}\r\n\r\nstatic int cmd_heat(int argc, char **argv)\r\n{\r\n    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n"]
[7839.382405, "o", "    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n    const char *alpha_s = get_opt(argc, argv, \"--alpha\");\r\n    const char *dt_s = get_opt(argc, argv, \"--dt\");\r\n    const char *nsteps_s = get_opt(argc, argv, \"--nsteps\");\r\n    const char *scheme = get_opt(argc, argv, \"--scheme\");\r\n    const char *ic_file = get_opt(argc, argv, \"--ic\");\r\n    const char *source_arg = get_opt(argc, argv, \"--source\");\r\n    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n"]
[7839.382469, "o", "    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n\r\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !alpha_s ||\r\n        !dt_s || !nsteps_s || !scheme || !ic_file || !source_arg ||\r\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n        !solver || !precond || !tol_s || !maxiter_s || !output) {\r\n"]
[7839.382532, "o", "        fprintf(stderr, \"Error: heat requires grid, domain, alpha, dt, nsteps, scheme, ic, source, boundary conditions, solver, precond, tol, maxiter, output\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n\r\n    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n    double alpha = atof(alpha_s);\r\n    double dt = atof(dt_s);\r\n"]
[7839.382596, "o", "    int nsteps = atoi(nsteps_s);\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || alpha <= 0.0 ||\r\n        dt <= 0.0 || nsteps < 0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid heat parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n"]
[7839.382658, "o", "    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int rc = heat_solve(nx, ny, x0, x1, y0, y1, alpha, dt, nsteps, scheme,\r\n                       ic_file, source_arg, left, right, bottom, top,\r\n                       solver, precond, tol, maxiter, restart, omega, output);\r\n"]
[7839.382721, "o", "    if (rc != 0) {\r\n        fprintf(stderr, \"Error: heat solve failed\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int cmd_convdiff(int argc, char **argv)\r\n{\r\n    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n"]
[7839.382785, "o", "    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n    const char *kappa_s = get_opt(argc, argv, \"--kappa\");\r\n    const char *vx_s = get_opt(argc, argv, \"--vx\");\r\n    const char *vy_s = get_opt(argc, argv, \"--vy\");\r\n    const char *source = get_opt(argc, argv, \"--source\");\r\n    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n"]
[7839.382852, "o", "    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n    const char *history = get_opt(argc, argv, \"--history\");\r\n\r\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !kappa_s ||\r\n        !vx_s || !vy_s || !source ||\r\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n        !solver || !precond || !tol_s || !maxiter_s || !output) {\r\n        fprintf(stderr, \"Error: convdiff requires grid, domain, kappa, vx, vy, source, boundary conditions, solver, precond, tol, maxiter, output\\n\");\r\n        usage(\"numsim\");\r\n"]
[7839.382928, "o", "        return 1;\r\n    }\r\n\r\n    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n    double kappa = atof(kappa_s);\r\n    double vx = atof(vx_s);\r\n    double vy = atof(vy_s);\r\n"]
[7839.382989, "o", "    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || kappa <= 0.0 ||\r\n        tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid convdiff parameters\\n\");\r\n        return 1;\r\n    }\r\n"]
[7839.383049, "o", "    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    double hx = (x1 - x0) / (nx - 1);\r\n"]
[7839.383109, "o", "    double hy = (y1 - y0) / (ny - 1);\r\n    double pe = convdiff_peclet(vx, vy, hx, hy, kappa);\r\n    if (pe > 1.0) {\r\n        fprintf(stderr, \"warning: cell Peclet number %.6e > 1, solution may exhibit oscillations\\n\", pe);\r\n    }\r\n\r\n    CSRMatrix *A = NULL;\r\n    double *b = NULL;\r\n    if (convdiff_assemble(nx, ny, x0, x1, y0, y1, kappa, vx, vy,\r\n                          source, left, right, bottom, top, &A, &b) != 0) {\r\n        fprintf(stderr, \"Error: cannot assemble convdiff system\\n\");\r\n"]
[7839.383168, "o", "        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n    printf(\"peclet: %.6e\\n\", pe);\r\n\r\n    free(b);\r\n    csr_destroy(A);\r\n    return rc;\r\n}\r\n\r\nint main(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        usage(argv[0]);\r\n"]
[7839.383227, "o", "        return 1;\r\n    }\r\n\r\n    const char *cmd = argv[1];\r\n\r\n    if (strcmp(cmd, \"dense-solve\") == 0) {\r\n        return cmd_dense_solve(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"sparse-solve\") == 0) {\r\n        return cmd_sparse_solve(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"poisson\") == 0) {\r\n        return cmd_poisson(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"heat\") == 0) {\r\n        return cmd_heat(argc - 2, argv + 2);\r\n"]
[7839.38329, "o", "    } else if (strcmp(cmd, \"convdiff\") == 0) {\r\n        return cmd_convdiff(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"--help\") == 0 || strcmp(cmd, \"-h\") == 0) {\r\n        usage(argv[0]);\r\n        return 0;\r\n    } else {\r\n        fprintf(stderr, \"Error: unknown command '%s'\\n\", cmd);\r\n        usage(argv[0]);\r\n        return 1;\r\n    }\r\n}\r\n"]
[7839.3838, "o", "\u001b[?2004h"]
[7839.383856, "o", "root@n30009:/app# "]
[7839.647468, "i", "sed -n '620,900p' src/main.c\n"]
[7839.647739, "o", "sed -n '620,900p' src/main.c\r\n\u001b[?2004l\r"]
[7839.65131, "o", "\u001b[?2004hroot@n30009:/app# "]
[7839.917971, "i", "sed -n '1,260p' include/solvers.h\n"]
[7839.918268, "o", "sed -n '1,260p' include/solvers.h\r\n\u001b[?2004l\r"]
[7839.921383, "o", "#ifndef SOLVERS_H\r\n#define SOLVERS_H\r\n\r\n#include \"sparse.h\"\r\n#include \"precond.h\"\r\n\r\ntypedef struct {\r\n    double *x;\r\n"]
[7839.921461, "o", "    double relres;          /* true relative residual ||b-A*x||/||b|| */\r\n    double true_residual;   /* absolute true residual norm ||b-A*x|| */\r\n    int iterations;\r\n    int converged;\r\n    double *history;        /* true relative residual at each iteration */\r\n    int history_len;        /* number of stored history entries */\r\n} SolveResult;\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P);\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                           double tol, int maxiter, int m, Precond *P);\r\n\r\nvoid solve_result_destroy(SolveResult *res);\r\n\r\n"]
[7839.921536, "o", "#endif /* SOLVERS_H */\r\n"]
[7839.922019, "o", "\u001b[?2004hroot@n30009:/app# "]
[7840.197826, "i", "sed -n '1,360p' src/solvers.c\n"]
[7840.198124, "o", "sed -n '1,360p' src/solvers.c\r\n\u001b[?2004l\r"]
[7840.201147, "o", "#include \"solvers.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <math.h>\r\n#include <string.h>\r\n\r\nstatic SolveResult *result_create(int n, int maxiter)\r\n{\r\n    if (maxiter < 0) maxiter = 0;"]
[7840.201242, "o", "\r\n    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    if (!res) return NULL;\r\n\r\n    res->x = vec_create(n);\r\n    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    if (!res->x || !res->history) {\r\n        free(res->x);\r\n        free(res->history);\r\n        free(res);\r\n        return NULL;\r\n    }\r\n    res->history_len = 0;\r\n    return res;\r\n}\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n"]
[7840.20132, "o", "    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *p = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n"]
[7840.201389, "o", "    if (!r || !z || !p || !Ap) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    res->history[0] = res->relres;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n"]
[7840.20145, "o", "        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n\r\n    if (precond_apply(P, A, r, z) != 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n    vec_copy(z, p, n);\r\n    double rz_old = vec_dot(r, z, n);\r\n\r\n    for (int iter = 1; iter <= maxiter; iter++) {\r\n"]
[7840.201514, "o", "        csr_spmv(A, p, Ap);\r\n        double pAp = vec_dot(p, Ap, n);\r\n        if (fabs(pAp) < 1e-30) break;\r\n\r\n        double alpha = rz_old / pAp;\r\n        vec_axpy(alpha, p, res->x, n);\r\n        vec_axpy(-alpha, Ap, r, n);\r\n\r\n        /* Recompute the true residual rather than relying on the recurrence. */\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n"]
[7840.20158, "o", "        res->relres = res->true_residual / bnorm;\r\n        res->history[iter] = res->relres;\r\n        res->history_len = iter + 1;\r\n        res->iterations = iter;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double rz_new = vec_dot(r, z, n);\r\n        if (fabs(rz_old) < 1e-30) break;\r\n        double beta = rz_new / rz_old;\r\n"]
[7840.201646, "o", "        vec_scale(beta, p, n);\r\n        vec_axpy(1.0, z, p, n);\r\n        rz_old = rz_new;\r\n    }\r\n\r\n    free(r); free(z); free(p); free(Ap);\r\n    return res;\r\n}\r\n\r\nstatic void apply_givens(double *a, double *b, double c, double s)\r\n{\r\n    double t = c * (*a) + s * (*b);\r\n    *b = -s * (*a) + c * (*b);\r\n    *a = t;\r\n}"]
[7840.201754, "o", "\r\n\r\nstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n{\r\n    if (kdim <= 0) return -1;\r\n\r\n    double *c = (double *)malloc(m * sizeof(double));\r\n    double *s = (double *)malloc(m * sizeof(double));\r\n    if (!c || !s) { free(c); free(s); return -1; }\r\n\r\n    for (int i = 0; i < kdim; i++) {\r\n        for (int k = 0; k < i; k++) {\r\n            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n        }\r\n\r\n        double a = H[i*m+i];\r\n        double b = H[(i+1)*m+i];\r\n        if (b == 0.0) {\r\n            c[i] = 1.0;\r\n            s[i] = 0.0;\r\n        } else {\r\n            double r = hypot(a, b);\r\n            c[i] = a / r;\r\n            s[i] = b / r;\r\n"]
[7840.201821, "o", "        }\r\n        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n\r\n    }\r\n\r\n    for (int i = kdim - 1; i >= 0; i--) {\r\n        double sum = g[i];\r\n        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n        y[i] = sum / H[i*m+i];\r\n    }\r\n\r\n    free(c);\r\n"]
[7840.201908, "o", "    free(s);\r\n    return 0;\r\n}\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                           double tol, int maxiter, int m, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (m <= 0) m = 30;\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);"]
[7840.201938, "o", "\r\n    double *z = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    double *Av = vec_create(n);\r\n    double *w = vec_create(n);\r\n"]
[7840.202035, "o", "    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n    double *y = (double *)malloc(m * sizeof(double));\r\n    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n\r\n"]
[7840.202176, "o", "    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    res->history[0] = res->relres;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        return res;\r\n    }\r\n\r\n    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double beta = vec_norm2(z, n);\r\n        if (beta == 0.0) break;\r"]
[7840.202257, "o", "\n\r\n        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n        g[0] = beta;\r\n        memset(H, 0, (m + 1) * m * sizeof(double));\r\n\r\n        int kdim = 0;\r\n        int fail = 0;\r\n        for (int j = 0; j < m; j++) {\r\n            csr_spmv(A, V + j * n, Av);\r\n            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n\r\n            for (int i = 0; i <= j; i++) {\r\n                double h = vec_dot(w, V + i * n, n);\r\n                H[i*m+j] = h;\r\n                vec_axpy(-h, V + i * n, w, n);\r\n            }\r\n\r\n            double hnorm = vec_norm2(w, n);\r\n            H[(j+1)*m+j] = hnorm;\r\n            kdim = j + 1;\r\n\r\n            if (hnorm < 1e-14) break;\r\n\r\n            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n        }\r\n        if (fail) break;\r\n        if (kdim == 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n\r\n"]
[7840.202326, "o", "        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n        res->relres = res->true_residual / bnorm;\r\n        res->history[cycle] = res->relres;\r\n        res->history_len = cycle + 1;\r\n        res->iterations = cycle;\r\n"]
[7840.202394, "o", "\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n    }\r\n\r\n    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n    return res;\r\n}\r\n\r\nvoid solve_result_destroy(SolveResult *res)\r\n{\r\n    if (!res) return;\r\n    free(res->x);\r\n    free(res->history);\r\n"]
[7840.202456, "o", "    free(res);\r\n}\r\n"]
[7840.202901, "o", "\u001b[?2004h"]
[7840.202961, "o", "root@n30009:/app# "]
[7840.496973, "i", "sed -n '360,760p' src/solvers.c\n"]
[7840.497265, "o", "sed -n '360,760p' src/solvers.c\r\n\u001b[?2004l\r"]
[7840.500788, "o", "\u001b[?2004h"]
[7840.500856, "o", "root@n30009:/app# "]
[7847.374152, "i", "cat include/solvers.h\n"]
[7847.374428, "o", "cat include/solvers.h\r\n\u001b[?2004l\r"]
[7847.376759, "o", "#ifndef SOLVERS_H\r\n#define SOLVERS_H\r\n\r\n#include \"sparse.h\"\r\n#include \"precond.h\"\r\n\r\ntypedef struct {\r\n    double *x;\r\n    double relres;          /* true relative residual ||b-A*x||/||b|| */\r\n    double true_residual;   /* absolute true residual norm ||b-A*x|| */\r\n    int iterations;\r\n    int converged;\r\n    double *history;        /* true relative residual at each iteration */\r\n    int history_len;        /* number of stored history entries */\r\n} SolveResult;\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P);\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                           double tol, int maxiter, int m, Precond *P);\r\n\r\nvoid solve_result_destroy(SolveResult *res);\r\n\r\n#endif /* SOLVERS_H */\r\n"]
[7847.377217, "o", "\u001b[?2004h"]
[7847.377308, "o", "root@n30009:/app# "]
[7847.653078, "i", "cat include/precond.h\n"]
[7847.653333, "o", "cat include/precond.h\r\n\u001b[?2004l\r"]
[7847.655516, "o", "#ifndef PRECOND_H\r\n#define PRECOND_H\r\n\r\n#include \"sparse.h\"\r\n\r\ntypedef enum {\r\n    PRECOND_NONE,\r\n    PRECOND_JACOBI,\r\n    PRECOND_ILU0,\r\n    PRECOND_SSOR\r\n} PrecondType;\r\n\r\ntypedef struct {\r\n    PrecondType type;\r\n    int n;\r\n    double omega;\r\n    double *diag;       /* Jacobi and SSOR */\r\n    CSRMatrix *lu;      /* ILU(0) factors in one CSR pattern */\r\n    const CSRMatrix *ssor_A;\r\n} Precond;\r\n\r\nPrecond *precond_create(const CSRMatrix *A, const char *name, double omega);\r\nvoid     precond_destroy(Precond *P);\r\nint      precond_apply(Precond *P, const CSRMatrix *A, const double *r, double *z);\r\n\r\n#endif /* PRECOND_H */\r\n"]
[7847.655969, "o", "\u001b[?2004h"]
[7847.656043, "o", "root@n30009:/app# "]
[7847.9305, "i", "sed -n '1,360p' src/precond.c\n"]
[7847.930797, "o", "sed -n '1,360p' src/precond.c\r\n\u001b[?2004l\r"]
[7847.933787, "o", "#include \"precond.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n\r\nstatic int find_in_row(const CSRMatrix *A, int row, int col)\r\n"]
[7847.933893, "o", "{\r\n    int lo = A->row_ptr[row];\r\n    int hi = A->row_ptr[row+1] - 1;\r\n    while (lo <= hi) {\r\n        int mid = (lo + hi) / 2;\r\n        if (A->col_indices[mid] == col) return mid;\r\n        if (A->col_indices[mid] < col) lo = mid + 1;\r\n        else hi = mid - 1;\r\n    }\r\n    return -1;\r\n}\r\n\r\nstatic CSRMatrix *csr_copy(const CSRMatrix *A)\r\n{\r\n    CSRMatrix *B = csr_create(A->rows, A->cols, A->nnz);\r\n    if (!B) return NULL;\r\n    memcpy(B->values, A->values, A->nnz * sizeof(double));\r\n"]
[7847.933982, "o", "    memcpy(B->col_indices, A->col_indices, A->nnz * sizeof(int));\r\n    memcpy(B->row_ptr, A->row_ptr, (A->rows + 1) * sizeof(int));\r\n    return B;\r\n}\r\n\r\nstatic int ilu0_factorize(CSRMatrix *LU)\r\n{\r\n    int n = LU->rows;\r\n    for (int i = 0; i < n; i++) {\r\n        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n            int c = LU->col_indices[k];\r\n            if (c >= i) break;\r\n\r\n            int d = find_in_row(LU, c, c);\r\n            if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;\r\n\r\n            LU->values[k] /= LU->values[d];\r\n            double aik = LU->values[k];\r\n"]
[7847.934072, "o", "\r\n            for (int l = LU->row_ptr[c]; l < LU->row_ptr[c+1]; l++) {\r\n                int j = LU->col_indices[l];\r\n                if (j <= c) continue;\r\n                int idx = find_in_row(LU, i, j);\r\n                if (idx >= 0) LU->values[idx] -= aik * LU->values[l];\r\n            }\r\n        }\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int ilu_forward_solve(const CSRMatrix *LU, const double *r, double *y)\r\n{\r\n    for (int i = 0; i < LU->rows; i++) {\r\n        double s = r[i];\r\n        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n"]
[7847.934145, "o", "            int j = LU->col_indices[k];\r\n            if (j < i) s -= LU->values[k] * y[j];\r\n            else break;\r\n        }\r\n        y[i] = s;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int ilu_backward_solve(const CSRMatrix *LU, const double *y, double *z)\r\n{\r\n    for (int i = LU->rows - 1; i >= 0; i--) {\r\n        double s = y[i];\r\n        int d = -1;\r\n        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n            int j = LU->col_indices[k];\r\n            if (j == i) d = k;\r\n"]
[7847.934228, "o", "            else if (j > i) s -= LU->values[k] * z[j];\r\n        }\r\n        if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;\r\n        z[i] = s / LU->values[d];\r\n    }\r\n    return 0;\r\n}\r\n\r\nPrecond *precond_create(const CSRMatrix *A, const char *name, double omega)\r\n{\r\n    if (!A || !name || A->rows != A->cols) return NULL;\r\n\r\n    Precond *P = (Precond *)calloc(1, sizeof(Precond));\r\n    if (!P) return NULL;\r\n\r\n"]
[7847.934316, "o", "    P->n = A->rows;\r\n    P->omega = (omega > 0.0) ? omega : 1.0;\r\n\r\n    if (strcmp(name, \"none\") == 0) {\r\n        P->type = PRECOND_NONE;\r\n    } else if (strcmp(name, \"jacobi\") == 0) {\r\n        P->type = PRECOND_JACOBI;\r\n        P->diag = csr_diagonal(A);\r\n        if (!P->diag) { precond_destroy(P); return NULL; }\r\n    } else if (strcmp(name, \"ilu0\") == 0) {\r\n        P->type = PRECOND_ILU0;\r\n        P->lu = csr_copy(A);\r\n        if (!P->lu) { precond_destroy(P); return NULL; }\r\n        if (ilu0_factorize(P->lu) != 0) { precond_destroy(P); return NULL; }\r\n    } else if (strcmp(name, \"ssor\") == 0) {\r\n        P->type = PRECOND_SSOR;\r\n        P->ssor_A = A;\r\n        P->diag = csr_diagonal(A);\r\n"]
[7847.934388, "o", "        if (!P->diag) { precond_destroy(P); return NULL; }\r\n    } else {\r\n        precond_destroy(P);\r\n        return NULL;\r\n    }\r\n\r\n    return P;\r\n}\r\n\r\nvoid precond_destroy(Precond *P)\r\n{\r\n    if (!P) return;\r\n    free(P->diag);\r\n    csr_destroy(P->lu);\r\n    free(P);\r\n}\r\n"]
[7847.934464, "o", "\r\nint precond_apply(Precond *P, const CSRMatrix *A, const double *r, double *z)\r\n{\r\n    int n = A ? A->rows : (P ? P->n : 0);\r\n    if (!P || P->type == PRECOND_NONE) {\r\n        vec_copy(r, z, n);\r\n        return 0;\r\n    }\r\n\r\n    switch (P->type) {\r\n    case PRECOND_JACOBI:\r\n        for (int i = 0; i < n; i++) {\r\n            if (fabs(P->diag[i]) < 1e-15) return -1;\r\n            z[i] = r[i] / P->diag[i];\r\n        }\r\n        return 0;\r\n\r\n    case PRECOND_ILU0: {\r\n"]
[7847.934547, "o", "        double *y = vec_create(n);\r\n        if (!y) return -1;\r\n        if (ilu_forward_solve(P->lu, r, y) != 0) { free(y); return -1; }\r\n        if (ilu_backward_solve(P->lu, y, z) != 0) { free(y); return -1; }\r\n        free(y);\r\n        return 0;\r\n    }\r\n\r\n    case PRECOND_SSOR: {\r\n        const CSRMatrix *M = A ? A : P->ssor_A;\r\n        if (!M) return -1;\r\n        vec_zero(z, n);\r\n\r\n        for (int i = 0; i < n; i++) {\r\n            double diag = P->diag[i];\r\n            if (fabs(diag) < 1e-15) return -1;\r\n            double sum = 0.0;\r\n            for (int k = M->row_ptr[i]; k < M->row_ptr[i+1]; k++) {\r\n"]
[7847.934631, "o", "                int j = M->col_indices[k];\r\n                if (j != i) sum += M->values[k] * z[j];\r\n            }\r\n            z[i] = (1.0 - P->omega) * z[i] + (P->omega / diag) * (r[i] - sum);\r\n        }\r\n        for (int i = n - 1; i >= 0; i--) {\r\n            double diag = P->diag[i];\r\n            if (fabs(diag) < 1e-15) return -1;\r\n            double sum = 0.0;\r\n            for (int k = M->row_ptr[i]; k < M->row_ptr[i+1]; k++) {\r\n                int j = M->col_indices[k];\r\n                if (j != i) sum += M->values[k] * z[j];\r\n            }\r\n            z[i] = (1.0 - P->omega) * z[i] + (P->omega / diag) * (r[i] - sum);\r\n        }\r\n        return 0;\r\n    }\r\n\r\n    default:\r\n"]
[7847.934698, "o", "        vec_copy(r, z, n);\r\n        return 0;\r\n    }\r\n}\r\n"]
[7847.935191, "o", "\u001b[?2004h"]
[7847.935259, "o", "root@n30009:/app# "]
[7848.211336, "i", "sed -n '1,320p' src/sparse.c\n"]
[7848.211624, "o", "sed -n '1,320p' src/sparse.c\r\n\u001b[?2004l\r"]
[7848.214491, "o", "#include \"sparse.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n"]
[7848.214563, "o", "#include <math.h>\r\n\r\nCSRMatrix *csr_create(int rows, int cols, int nnz)\r\n{\r\n    CSRMatrix *A = (CSRMatrix *)malloc(sizeof(CSRMatrix));\r\n    if (!A) return NULL;\r\n    A->rows = rows;\r\n    A->cols = cols;\r\n    A->nnz = nnz;\r\n    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));\r\n    A->col_indices = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n"]
[7848.214613, "o", "    A->row_ptr = (int *)calloc((rows >= 0 ? rows + 1 : 1), sizeof(int));\r\n    if (!A->values || !A->col_indices || !A->row_ptr) {\r\n        csr_destroy(A);\r\n        return NULL;\r\n    }\r\n    return A;\r\n}\r\n"]
[7848.214703, "o", "\r\nvoid csr_destroy(CSRMatrix *A)\r\n{\r\n    if (!A) return;\r\n    free(A->values);\r\n    free(A->col_indices);\r\n    free(A->row_ptr);\r\n    free(A);\r\n}\r\n\r\nCOOMatrix *coo_create(int rows, int cols, int nnz)\r\n{\r\n"]
[7848.214766, "o", "    COOMatrix *A = (COOMatrix *)malloc(sizeof(COOMatrix));\r\n    if (!A) return NULL;\r\n    A->rows = rows;\r\n    A->cols = cols;\r\n    A->nnz = nnz;\r\n    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));\r\n    A->row = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    A->col = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n"]
[7848.214811, "o", "    if (!A->values || !A->row || !A->col) {\r\n        coo_destroy(A);\r\n        return NULL;\r\n    }\r\n    return A;\r\n}\r\n\r\nvoid coo_destroy(COOMatrix *A)\r\n"]
[7848.214945, "o", "{\r\n    if (!A) return;\r\n    free(A->values);\r\n    free(A->row);\r\n    free(A->col);\r\n    free(A);\r\n}\r\n\r\nstatic const COOMatrix *g_coo_sort_data = NULL;\r\n\r\nstatic int coo_qsort_cmp(const void *pa, const void *pb)\r\n{\r\n    int ia = *(const int *)pa;\r\n    int ib = *(const int *)pb;\r\n    const COOMatrix *A = g_coo_sort_data;\r\n    if (A->row[ia] != A->row[ib]) return A->row[ia] - A->row[ib];\r\n    return A->col[ia] - A->col[ib];\r\n}\r\n\r\nstatic COOMatrix *coo_sort_dedup(const COOMatrix *A)\r\n{\r\n    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);\r\n    if (!out) return NULL;"]
[7848.215014, "o", "\r\n\r\n    int *idx = (int *)malloc((A->nnz > 0 ? A->nnz : 1) * sizeof(int));\r\n    if (!idx) { coo_destroy(out); return NULL; }\r\n    for (int i = 0; i < A->nnz; i++) idx[i] = i;\r\n\r\n    g_coo_sort_data = A;\r\n    qsort(idx, A->nnz, sizeof(int), coo_qsort_cmp);\r\n    g_coo_sort_data = NULL;\r\n"]
[7848.215131, "o", "\r\n    int k = 0;\r\n    for (int i = 0; i < A->nnz; i++) {\r\n        int src = idx[i];\r\n        if (k > 0 && out->row[k-1] == A->row[src] && out->col[k-1] == A->col[src]) {\r\n            out->values[k-1] += A->values[src];\r\n        } else {\r\n            out->row[k] = A->row[src];\r\n            out->col[k] = A->col[src];\r\n            out->values[k] = A->values[src];\r\n            k++;\r\n        }\r\n    }\r\n    out->nnz = k;\r\n    free(idx);\r\n    return out;\r\n}\r\n\r\nCOOMatrix *csr_to_coo(const CSRMatrix *A)\r\n"]
[7848.215199, "o", "{\r\n    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);\r\n    if (!out) return NULL;\r\n    int k = 0;\r\n    for (int i = 0; i < A->rows; i++) {\r\n        for (int j = A->row_ptr[i]; j < A->row_ptr[i+1]; j++) {\r\n            out->row[k] = i;\r\n            out->col[k] = A->col_indices[j];\r\n            out->values[k] = A->values[j];\r\n            k++;\r\n        }\r\n    }\r\n    out->nnz = k;\r\n    return out;\r\n}\r\n"]
[7848.215271, "o", "\r\nCSRMatrix *coo_to_csr(const COOMatrix *A)\r\n{\r\n    COOMatrix *sorted = coo_sort_dedup(A);\r\n    if (!sorted) return NULL;\r\n\r\n    CSRMatrix *out = csr_create(sorted->rows, sorted->cols, sorted->nnz);\r\n    if (!out) { coo_destroy(sorted); return NULL; }\r\n\r\n    for (int i = 0; i <= sorted->rows; i++) out->row_ptr[i] = 0;\r\n"]
[7848.215315, "o", "\r\n    for (int k = 0; k < sorted->nnz; k++) {\r\n        out->row_ptr[sorted->row[k] + 1]++;\r\n    }\r\n    for (int i = 0; i < sorted->rows; i++) {\r\n        out->row_ptr[i+1] += out->row_ptr[i];\r\n"]
[7848.215407, "o", "    }\r\n\r\n    int *next = (int *)malloc((sorted->rows > 0 ? sorted->rows : 1) * sizeof(int));\r\n    if (!next) { csr_destroy(out); coo_destroy(sorted); return NULL; }\r\n    for (int i = 0; i < sorted->rows; i++) next[i] = out->row_ptr[i];\r\n\r\n    for (int k = 0; k < sorted->nnz; k++) {\r\n"]
[7848.215482, "o", "        int r = sorted->row[k];\r\n        int pos = next[r]++;\r\n        out->col_indices[pos] = sorted->col[k];\r\n        out->values[pos] = sorted->values[k];\r\n    }\r\n\r\n    free(next);\r\n    coo_destroy(sorted);\r\n    return out;\r\n}\r\n\r\nvoid csr_spmv(const CSRMatrix *A, const double *x, double *y)\r\n{\r\n"]
[7848.215558, "o", "    for (int i = 0; i < A->rows; i++) {\r\n        double s = 0.0;\r\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n            s += A->values[k] * x[A->col_indices[k]];\r\n        }\r\n        y[i] = s;\r\n    }\r\n}\r\n\r\nstatic int csr_find_in_row(const CSRMatrix *A, int row, int col)\r\n{\r\n    int lo = A->row_ptr[row];\r\n    int hi = A->row_ptr[row+1] - 1;\r\n    while (lo <= hi) {\r\n        int mid = (lo + hi) / 2;\r\n        if (A->col_indices[mid] == col) return mid;\r\n        if (A->col_indices[mid] < col) lo = mid + 1;\r\n        else hi = mid - 1;\r\n    }\r\n    return -1;"]
[7848.215629, "o", "\r\n}\r\n\r\nCSRMatrix *csr_transpose(const CSRMatrix *A)\r\n{\r\n"]
[7848.215676, "o", "    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);\r\n    if (!T) return NULL;\r\n\r\n    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;\r\n    for (int k = 0; k < A->nnz; k++) {\r\n        T->row_ptr[A->col_indices[k] + 1]++;\r\n    }\r\n    for (int i = 0; i < A->cols; i++) {\r\n        T->row_ptr[i+1] += T->row_ptr[i];\r\n    }\r\n\r\n    int *next = (int *)malloc((A->cols > 0 ? A->cols : 1) * sizeof(int));\r\n"]
[7848.215757, "o", "    if (!next) { csr_destroy(T); return NULL; }\r\n    for (int i = 0; i < A->cols; i++) next[i] = T->row_ptr[i];\r\n\r\n    for (int i = 0; i < A->rows; i++) {\r\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n            int c = A->col_indices[k];\r\n            int pos = next[c]++;\r\n            T->col_indices[pos] = i;\r\n            T->values[pos] = A->values[k];\r\n        }\r\n    }\r\n\r\n    free(next);\r\n    return T;\r\n}"]
[7848.215802, "o", "\r\n\r\nint csr_is_symmetric(const CSRMatrix *A, double tol)\r\n{\r\n    if (A->rows != A->cols) return 0;\r\n    for (int i = 0; i < A->rows; i++) {\r\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n            int j = A->col_indices[k];\r\n            int idx = csr_find_in_row(A, j, i);\r\n            if (idx < 0) return 0;\r\n"]
[7848.215909, "o", "            if (fabs(A->values[k] - A->values[idx]) > tol) return 0;\r\n        }\r\n    }\r\n    return 1;\r\n}\r\n\r\ndouble *csr_diagonal(const CSRMatrix *A)\r\n{\r\n    int n = A->rows < A->cols ? A->rows : A->cols;\r\n    double *diag = vec_create(n);\r\n    if (!diag) return NULL;\r\n    for (int i = 0; i < n; i++) {\r\n        int idx = csr_find_in_row(A, i, i);\r\n        diag[i] = (idx >= 0) ? A->values[idx] : 0.0;\r\n"]
[7848.215977, "o", "    }\r\n    return diag;\r\n}\r\n\r\nstatic int mm_parse_header(const char *line, int *is_array, int *is_symmetric)\r\n{\r\n    char buf[1024];\r\n    strncpy(buf, line, sizeof(buf)-1);\r\n    buf[sizeof(buf)-1] = '\\0';\r\n\r\n    char *tok = strtok(buf, \" \\t\\r\\n\");\r\n"]
[7848.216051, "o", "    if (!tok || strcmp(tok, \"%%MatrixMarket\") != 0) return -1;\r\n\r\n    tok = strtok(NULL, \" \\t\\r\\n\");\r\n    if (!tok || strcmp(tok, \"matrix\") != 0) return -1;\r\n\r\n    tok = strtok(NULL, \" \\t\\r\\n\");\r\n    if (!tok) return -1;\r\n    if (strcmp(tok, \"coordinate\") == 0) *is_array = 0;\r\n    else if (strcmp(tok, \"array\") == 0) *is_array = 1;\r\n    else return -1;\r\n\r\n    tok = strtok(NULL, \" \\t\\r\\n\");\r\n    if (!tok) return -1;\r\n    if (strcmp(tok, \"real\") != 0 && strcmp(tok, \"double\") != 0) return -1;"]
[7848.216123, "o", "\r\n\r\n    *is_symmetric = 0;\r\n    tok = strtok(NULL, \" \\t\\r\\n\");\r\n    if (tok && strcmp(tok, \"symmetric\") == 0) *is_symmetric = 1;\r\n\r\n    return 0;\r\n}\r\n\r\nstatic int read_non_comment_line(FILE *fp, char *buf, int bufsize)\r\n{\r\n    while (fgets(buf, bufsize, fp)) {\r\n        char *s = buf;\r\n"]
[7848.216195, "o", "        while (*s == ' ' || *s == '\\t') s++;\r\n        if (*s == '%' || *s == '\\n' || *s == '\\r' || *s == '\\0') continue;\r\n        return 0;\r\n    }\r\n    return -1;\r\n}\r\n\r\nCSRMatrix *csr_read_mm(const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    char line[1024];\r\n    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }\r\n    int is_array = 0, is_symmetric = 0;\r\n    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || is_array) {\r\n        fclose(fp);\r\n        return NULL;\r\n"]
[7848.216262, "o", "    }\r\n\r\n    int rows, cols, nnz;\r\n    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }\r\n    if (sscanf(line, \"%d %d %d\", &rows, &cols, &nnz) != 3 || rows <= 0 || cols <= 0 || nnz < 0) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    int cap = is_symmetric ? 2 * nnz + 1 : nnz;\r\n"]
[7848.216325, "o", "    if (cap < 1) cap = 1;\r\n    COOMatrix *coo = coo_create(rows, cols, cap);\r\n    if (!coo) { fclose(fp); return NULL; }\r\n\r\n    int k = 0;\r\n    while (k < coo->nnz && read_non_comment_line(fp, line, sizeof(line)) == 0) {\r\n        int r, c;\r\n        double v;\r\n        if (sscanf(line, \"%d %d %lf\", &r, &c, &v) != 3) continue;\r\n"]
[7848.216389, "o", "        if (r < 1 || r > rows || c < 1 || c > cols) continue;\r\n        r--; c--;\r\n\r\n        coo->row[k] = r;\r\n        coo->col[k] = c;\r\n        coo->values[k] = v;\r\n        k++;\r\n\r\n        if (is_symmetric && r != c) {"]
[7848.21646, "o", "\r\n            coo->row[k] = c;\r\n            coo->col[k] = r;\r\n            coo->values[k] = v;\r\n            k++;\r\n        }\r\n    }\r\n    coo->nnz = k;\r\n\r\n    CSRMatrix *A = coo_to_csr(coo);\r\n    coo_destroy(coo);\r\n    fclose(fp);\r\n"]
[7848.216527, "o", "    return A;\r\n"]
[7848.217022, "o", "\u001b[?2004h"]
[7848.217092, "o", "root@n30009:/app# "]
[7848.482289, "i", "grep -R \"history\" -n src include Makefile\n"]
[7848.482646, "o", "grep -R \"history\" -n src include Makefile\r\n\u001b[?2004l\r"]
[7848.485955, "o", "\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K <file>]\\n\", prog);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K <file>]\\n\", prog);\r\n"]
[7848.486041, "o", "\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"  %s convdiff --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --kappa <float> --vx <float> --vy <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file> [--\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K <file>]\\n\", prog);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int write_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_file(const SolveResult *res, const char *filename)\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    for (int i = 0; i < res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len; i++) {\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fprintf(fp, \"%d\\t%.15e\\n\", i, res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[i]);\r\n\u001b[3"]
[7848.486114, "o", "5m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                                const char *\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K)\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K && write_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_file(res, \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K) != 0) {\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fprintf(stderr, \"Error: cannot write \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K to '%s'\\n\", \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const char *\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = get_opt(argc, argv, \"--\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K\");\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const char *\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = get_opt(argc, argv, \"--\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K"]
[7848.486177, "o", "\");\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const char *\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = get_opt(argc, argv, \"--\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K\");\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K477\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n"]
[7848.486274, "o", "\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = (double *)malloc((maxiter + 1) * sizeof(double));\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!res->x || !res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K) {\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        free(res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n"]
[7848.486342, "o", "\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = 0;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[0] = res->relres;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = 1;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[iter] = res->relres;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = iter + 1;\r\n"]
[7848.486408, "o", "\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[0] = res->relres;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = 1;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[cycle] = res->relres;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = cycle + 1;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    free(res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n"]
[7848.486959, "o", "\u001b[35m\u001b[Kinclude/solvers.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    double *\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K;        /* true relative residual at each iteration */\r\n\u001b[35m\u001b[Kinclude/solvers.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len;        /* number of stored \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K entries */\r\n"]
