[9713.752534, "o", "\u001b[32m\u001b[K7\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KCSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *csr_create(int rows, int cols, int nnz)\r\n\u001b[32m\u001b[K9\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A = (CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *)malloc(sizeof(CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K));\r\n"]
[9713.752647, "o", "\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvoid csr_destroy(CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A)\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KCOO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *coo_create(int rows, int cols, int nnz)\r\n\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A = (COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *)malloc(sizeof(COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K));\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvoid coo_destroy(COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A)\r\n\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic const COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *g_coo_sort_data = NULL;\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A = g_coo_sort_data;\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *coo_sort_dedup(const COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A)\r\n"]
[9713.752725, "o", "\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *out = coo_create(A->rows, A->cols, A->nnz);\r\n\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KCOO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *csr_to_coo(const CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A)\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *out = coo_create(A->rows, A->cols, A->nnz);\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KCSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *coo_to_csr(const COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A)\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *sorted = coo_sort_dedup(A);\r\n\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *out = csr_create(sorted->rows, sorted->cols, sorted->nnz);\r\n"]
[9713.752808, "o", "\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvoid csr_spmv(const CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A, const double *x, double *y)\r\n\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int csr_find_in_row(const CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A, int row, int col)\r\n\u001b[32m\u001b[K174\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KCSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *csr_transpose(const CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A)\r\n\u001b[32m\u001b[K176\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *T = csr_create(A->cols, A->rows, A->nnz);\r\n"]
[9713.752897, "o", "\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint csr_is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K(const CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A, double tol)\r\n\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdouble *csr_diagonal(const CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A)\r\n"]
[9713.752965, "o", "\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int mm_parse_header(const char *line, int *is_array, int *is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!tok || strcmp(tok, \"\u001b[01;31m\u001b[K%%\u001b[m\u001b[K\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[KMarket\") != 0) return -1;\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    *is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K = 0;\r\n\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (tok && strcmp(tok, \"\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K\") == 0) *is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K = 1;\r\n"]
[9713.753037, "o", "\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KCSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *\u001b[01;31m\u001b[Kcsr_read_mm\u001b[m\u001b[K(const char *filename)\r\n\u001b[32m\u001b[K277\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int is_array = 0, is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K = 0;\r\n\u001b[32m\u001b[K278\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (mm_parse_header(line, &is_array, &is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K) != 0 || is_array) {\r\n\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int cap = is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K ? 2 * nnz + 1 : nnz;\r\n"]
[9713.753103, "o", "\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    COO\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *coo = coo_create(rows, cols, cap);\r\n\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K && r != c) {\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A = coo_to_csr(coo);\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint csr_write_mm(const CSR\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[K *A, const char *filename)\r\n"]
[9713.753175, "o", "\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(fp, \"\u001b[01;31m\u001b[K%%\u001b[m\u001b[K\u001b[01;31m\u001b[K%%\u001b[m\u001b[K\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[KMarket matrix coordinate real \u001b[01;31m\u001b[Kgeneral\u001b[m\u001b[K\\n\");\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int is_array = 0, is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K = 0;\r\n\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (mm_parse_header(line, &is_array, &is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K) != 0 || !is_array) {\r\n\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(fp, \"\u001b[01;31m\u001b[K%%\u001b[m\u001b[K\u001b[01;31m\u001b[K%%\u001b[m\u001b[K\u001b[01;31m\u001b[KMatrix\u001b[m\u001b[KMarket matrix array real \u001b[01;31m\u001b[Kgeneral\u001b[m\u001b[K\\n\");\r\n"]
