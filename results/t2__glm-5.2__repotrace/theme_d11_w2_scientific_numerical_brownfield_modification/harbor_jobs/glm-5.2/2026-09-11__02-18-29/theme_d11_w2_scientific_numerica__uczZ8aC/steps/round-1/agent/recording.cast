[6056.580973, "i", "cat > src/convdiff.c <<'EOF'\n#include \"convdiff.h\"\n#include \"vector.h\"\n#include <stdlib.h>\n#include <math.h>\n\nstatic void add_coo(COOMatrix *coo, int *k, int r, int c, double v)\n{\n    coo->row[*k] = r;\n    coo->col[*k] = c;\n    coo->values[*k] = v;\n    (*k)++;\n}\n\ndouble convdiff_peclet(double vx, double vy, double hx, double hy, double kappa)\n{\n    double pe_x = fabs(vx) * hx;\n    double pe_y = fabs(vy) * hy;\n    double num = pe_x > pe_y ? pe_x : pe_y;\n    return num / (2.0 * kappa);\n}\n\nint convdiff_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\n                      double kappa, double vx, double vy,\n                      const char *source_file, PoissonBC left, PoissonBC right,\n                      PoissonBC bottom, PoissonBC top,\n                      CSRMatrix **A_out, double **b_out)\n{\n    if (!A_out || !b_out) return -1;\n    *A_out = NULL;\n    *b_out = NULL;\n\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || kappa <= 0.0 || !source_file) {\n        return -1;\n    }\n\n    double h"]
[6056.581206, "i", "x = (x1 - x0) / (nx - 1);\n    double hy = (y1 - y0) / (ny - 1);\n    double hx2 = hx * hx;\n    double hy2 = hy * hy;\n\n    double *f = poisson_read_source(source_file, nx, ny);\n    if (!f) return -1;\n\n    double *left_vals = NULL;\n    double *right_vals = NULL;\n    double *bottom_vals = NULL;\n    double *top_vals = NULL;\n\n    if (left.type == POISSON_NEUMANN) {\n        left_vals = poisson_read_boundary(left.file, ny);\n        if (!left_vals) goto fail;\n    }\n    if (right.type == POISSON_NEUMANN) {\n        right_vals = poisson_read_boundary(right.file, ny);\n        if (!right_vals) goto fail;\n    }\n    if (bottom.type == POISSON_NEUMANN) {\n        bottom_vals = poisson_read_boundary(bottom.file, nx);\n        if (!bottom_vals) goto fail;\n    }\n    if (top.type == POISSON_NEUMANN) {\n        top_vals = poisson_read_boundary(top.file, nx);\n        if (!top_vals) goto fail;\n    }\n\n    if (left.type == POISSON_DIRICHLET) {\n        left_vals = poisson_read_boundary(left.file, ny);\n        if (!left_vals) goto fail;\n  "]
[6056.581277, "o", "cat > src/convdiff.c <<'EOF'\r\n\u001b[?2004l\r"]
[6056.581352, "i", "  }\n    if (right.type == POISSON_DIRICHLET) {\n        right_vals = poisson_read_boundary(right.file, ny);\n        if (!right_vals) goto fail;\n    }\n    if (bottom.type == POISSON_DIRICHLET) {\n        bottom_vals = poisson_read_boundary(bottom.file, nx);\n        if (!bottom_vals) goto fail;\n    }\n    if (top.type == POISSON_DIRICHLET) {\n        top_vals = poisson_read_boundary(top.file, nx);\n        if (!top_vals) goto fail;\n    }\n\n    int n = nx * ny;\n    COOMatrix *coo = coo_create(n, n, 5 * n);\n    double *b = vec_create(n);\n    if (!coo || !b) {\n        coo_destroy(coo);\n        free(b);\n        goto fail;\n    }\n\n    int k = 0;\n    for (int i = 0; i < nx; i++) {\n        for (int j = 0; j < ny; j++) {\n            int idx = i * ny + j;\n            int is_left = (i == 0);\n            int is_right = (i == nx - 1);\n            int is_bottom = (j == 0);\n            int is_top = (j == ny - 1);\n\n            if (is_left && left.type == POISSON_DIRICHLET) {\n                add_coo(coo, &k, idx, idx, 1.0);\n         "]
[6056.581408, "o", "\u001b[?2004h> "]
[6056.581471, "i", "       b[idx] = left_vals[j];\n                continue;\n            }\n            if (is_right && right.type == POISSON_DIRICHLET) {\n                add_coo(coo, &k, idx, idx, 1.0);\n                b[idx] = right_vals[j];\n                continue;\n            }\n            if (is_bottom && bottom.type == POISSON_DIRICHLET) {\n                add_coo(coo, &k, idx, idx, 1.0);\n                b[idx] = bottom_vals[i];\n                continue;\n            }\n            if (is_top && top.type == POISSON_DIRICHLET) {\n                add_coo(coo, &k, idx, idx, 1.0);\n                b[idx] = top_vals[i];\n                continue;\n            }\n\n            double diag = 0.0;\n            double rhs = f[idx];\n            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;\n\n            /* Diffusion: -kappa * laplacian(u) */\n            if (is_left && left.type == POISSON_NEUMANN) {\n                diag += 2.0 * kappa / hx2;\n                c_ip += -2.0 * kappa / hx2;\n                rhs += 2.0 * kappa * left_vals[j] /"]
[6056.581526, "o", "#include \"convdiff.h\"\r\n\u001b[?2004l\r"]
[6056.581587, "i", " hx;\n            } else if (is_right && right.type == POISSON_NEUMANN) {\n                diag += 2.0 * kappa / hx2;\n                c_im += -2.0 * kappa / hx2;\n                rhs += 2.0 * kappa * right_vals[j] / hx;\n            } else if (!is_left && !is_right) {\n                diag += 2.0 * kappa / hx2;\n                c_im += -kappa / hx2;\n                c_ip += -kappa / hx2;\n            }\n\n            if (is_bottom && bottom.type == POISSON_NEUMANN) {\n                diag += 2.0 * kappa / hy2;\n                c_jp += -2.0 * kappa / hy2;\n                rhs += 2.0 * kappa * bottom_vals[i] / hy;\n            } else if (is_top && top.type == POISSON_NEUMANN) {\n                diag += 2.0 * kappa / hy2;\n                c_jm += -2.0 * kappa / hy2;\n                rhs += 2.0 * kappa * top_vals[i] / hy;\n            } else if (!is_bottom && !is_top) {\n                diag += 2.0 * kappa / hy2;\n                c_jm += -kappa / hy2;\n                c_jp += -kappa / hy2;\n            }\n\n            /* Convection: fi"]
[6056.581643, "o", "\u001b[?2004h> "]
[6056.5817, "i", "rst-order upwind */\n            if (vx > 0.0) {\n                if (is_left && left.type == POISSON_NEUMANN) {\n                    diag += vx / hx;\n                    c_ip += -vx / hx;\n                    rhs += 2.0 * vx * left_vals[j];\n                } else {\n                    diag += vx / hx;\n                    if (i > 0) c_im += -vx / hx;\n                }\n            } else if (vx < 0.0) {\n                if (is_right && right.type == POISSON_NEUMANN) {\n                    diag += -vx / hx;\n                    c_im += vx / hx;\n                    rhs += -2.0 * vx * right_vals[j];\n                } else {\n                    diag += -vx / hx;\n                    if (i < nx - 1) c_ip += vx / hx;\n                }\n            }\n\n            if (vy > 0.0) {\n                if (is_bottom && bottom.type == POISSON_NEUMANN) {\n                    diag += vy / hy;\n                    c_jp += -vy / hy;\n                    rhs += 2.0 * vy * bottom_vals[i];\n                } else {\n                    diag += vy"]
[6056.581751, "o", "#include \"vector.h\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[6056.581808, "i", " / hy;\n                    if (j > 0) c_jm += -vy / hy;\n                }\n            } else if (vy < 0.0) {\n                if (is_top && top.type == POISSON_NEUMANN) {\n                    diag += -vy / hy;\n                    c_jm += vy / hy;\n                    rhs += -2.0 * vy * top_vals[i];\n                } else {\n                    diag += -vy / hy;\n                    if (j < ny - 1) c_jp += vy / hy;\n                }\n            }\n\n            add_coo(coo, &k, idx, idx, diag);\n            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);\n            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);\n            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);\n            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);\n            b[idx] = rhs;\n        }\n    }\n\n    coo->nnz = k;\n    CSRMatrix *A = coo_to_csr(coo);\n    coo_destroy(coo);\n    if (!A) { free(b); goto fail; }\n\n    free(f);\n    free(left_vals);\n    free(right_vals)"]
