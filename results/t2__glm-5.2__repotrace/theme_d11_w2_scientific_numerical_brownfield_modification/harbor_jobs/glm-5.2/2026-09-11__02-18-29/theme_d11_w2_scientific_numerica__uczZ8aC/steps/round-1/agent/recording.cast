[11286.172121, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/solvers.c')\ns = p.read_text()\nold = '    double bnorm = vec_norm2(b, n);\\n    if (bnorm == 0.0) bnorm = 1.0;\\n\\n    double *r = vec_create(n);'\nnew = '    double bnorm = vec_norm2(b, n);\\n    if (bnorm == 0.0) bnorm = 1.0;\\n    double bnorm_inf = vec_norm_inf(b, n);\\n    if (bnorm_inf == 0.0) bnorm_inf = 1.0;\\n\\n    double *r = vec_create(n);'\nif old in s:\n    s = s.replace(old, new, 1)\nelse:\n    # fallback: insert after second bnorm block if not already present\n    idx = s.find('    double bnorm = vec_norm2(b, n);\\n    if (bnorm == 0.0) bnorm = 1.0;\\n')\n    # find second occurrence\n    idx2 = s.find('    double bnorm = vec_norm2(b, n);\\n    if (bnorm == 0.0) bnorm = 1.0;\\n', idx+1)\n    if idx2 != -1 and 'bnorm_inf' not in s[idx2:idx2+120]:\n        insert = '    double bnorm = vec_norm2(b, n);\\n    if (bnorm == 0.0) bnorm = 1.0;\\n    double bnorm_inf = vec_norm_inf(b, n);\\n    if (bnorm_inf == 0.0) bnorm_inf = 1.0;\\n'\n        s = s[:idx2] + insert + s[id"]
[11286.172364, "i", "x2+len('    double bnorm = vec_norm2(b, n);\\n    if (bnorm == 0.0) bnorm = 1.0;\\n'):]\np.write_text(s)\nPY\n"]
