[9722.950477, "o", "\u001b[35m\u001b[Kinclude/sparse.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K  *csr_create(int rows, int cols, int nnz);\r\n\u001b[35m\u001b[Kinclude/sparse.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvoid        csr_destroy(\u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K *A);\r\n\u001b[35m\u001b[Kinclude/sparse.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCOOMatrix\u001b[m\u001b[K  *coo_create(int rows, int cols, int nnz);\r\n\u001b[35m\u001b[Kinclude/sparse.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvoid        coo_destroy(\u001b[01;31m\u001b[KCOOMatrix\u001b[m\u001b[K *A);\r\n\u001b[35m\u001b[Kinclude/sparse.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCOOMatrix\u001b[m\u001b[K  *csr_to_coo(const \u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K *A);\r\n"]
[9722.950545, "o", "\u001b[35m\u001b[Kinclude/sparse.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K  *coo_to_csr(const \u001b[01;31m\u001b[KCOOMatrix\u001b[m\u001b[K *A);\r\n\u001b[35m\u001b[Kinclude/sparse.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvoid        csr_spmv(const \u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K *A, const double *x, double *y);\r\n\u001b[35m\u001b[Kinclude/sparse.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K  *csr_transpose(const \u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K *A);\r\n\u001b[35m\u001b[Kinclude/sparse.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint         csr_is_\u001b[01;31m\u001b[Ksymmetric\u001b[m\u001b[K(const \u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K *A, double tol);\r\n\u001b[35m\u001b[Kinclude/sparse.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdouble     *csr_diagonal(const \u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K *A);\r\n"]
[9722.950605, "o", "\u001b[35m\u001b[Kinclude/sparse.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K  *\u001b[01;31m\u001b[Kcsr_read_mm\u001b[m\u001b[K(const char *filename);\r\n\u001b[35m\u001b[Kinclude/sparse.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint         csr_write_mm(const \u001b[01;31m\u001b[KCSRMatrix\u001b[m\u001b[K *A, const char *filename);\r\n"]
