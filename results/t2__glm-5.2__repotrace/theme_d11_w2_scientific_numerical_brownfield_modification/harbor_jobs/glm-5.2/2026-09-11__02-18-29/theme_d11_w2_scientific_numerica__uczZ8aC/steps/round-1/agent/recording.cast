[2244.543171, "o", "#include \"poisson.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n\r\ndouble *poisson_read_source(const char *filename, int nx, int ny)\r\n{\r\n"]
[2244.543412, "o", "    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    int rx, ry;\r\n    if (fscanf(fp, \"%d %d\", &rx, &ry) != 2 || rx != nx || ry != ny) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    int n = nx * ny;\r\n    double *f = vec_create(n);\r\n    if (!f) { fclose(fp); return NULL; }\r\n\r\n    for (int i = 0; i < n; i++) {\r\n        if (fscanf(fp, \"%lf\", &f[i]) != 1) {\r\n            free(f);\r\n            fclose(fp);\r\n            return NULL;\r\n        }\r\n    }\r\n\r\n    fclose(fp);\r\n    return f;\r\n}\r\n\r\ndouble *poisson_read_boundary(const char *filename, int expected)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    double *vals = (double *)malloc(expected * sizeof(double));\r\n    if (!vals) { fclose(fp); return NULL; }\r\n\r\n    int count = 0;\r\n    while (count < expected) {\r\n        double v;\r\n        if (fscanf(fp, \"%lf\", &v) != 1) break;\r\n        vals[count++] = v;\r\n    }\r\n\r\n    fclose(fp);\r\n    if (count != expected) { free(vals); return NULL; }\r\n    return vals;\r\n}\r\n\r\nstatic"]
[2244.543539, "o", " void add_coo(COOMatrix *coo, int *k, int r, int c, double v)\r\n{\r\n    coo->row[*k] = r;\r\n    coo->col[*k] = c;\r\n    coo->values[*k] = v;\r\n    (*k)++;\r\n}\r\n\r\nint poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n                    const char *source_file, PoissonBC left, PoissonBC right,\r\n                    PoissonBC bottom, PoissonBC top,\r\n                    CSRMatrix **A_out, double **b_out)\r\n{\r\n    if (!A_out || !b_out) return -1;\r\n    *A_out = NULL;\r\n    *b_out = NULL;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || !source_file) return -1;\r\n\r\n    double hx = (x1 - x0) / (nx - 1);\r\n    double hy = (y1 - y0) / (ny - 1);\r\n    double hx2 = hx * hx;\r\n    double hy2 = hy * hy;\r\n\r\n    double *f = poisson_read_source(source_file, nx, ny);\r\n    if (!f) return -1;\r\n\r\n    double *left_vals = NULL;\r\n    double *right_vals = NULL;\r\n    double *bottom_vals = NULL;\r\n    double *top_vals = NULL;\r\n\r\n"]
[2244.543649, "o", "    if (left.type == POISSON_NEUMANN) { left_vals = poisson_read_boundary(left.file, ny); if (!left_vals) goto fail; }\r\n    if (right.type == POISSON_NEUMANN) { right_vals = poisson_read_boundary(right.file, ny); if (!right_vals) goto fail; }\r\n    if (bottom.type == POISSON_NEUMANN) { bottom_vals = poisson_read_boundary(bottom.file, nx); if (!bottom_vals) goto fail; }\r\n    if (top.type == POISSON_NEUMANN) { top_vals = poisson_read_boundary(top.file, nx); if (!top_vals) goto fail; }\r\n\r\n    if (left.type == POISSON_DIRICHLET) { left_vals = poisson_read_boundary(left.file, ny); if (!left_vals) goto fail; }\r\n    if (right.type == POISSON_DIRICHLET) { right_vals = poisson_read_boundary(right.file, ny); if (!right_vals) goto fail; }\r\n    if (bottom.type == POISSON_DIRICHLET) { bottom_vals = poisson_read_boundary(bottom.file, nx); if (!bottom_vals) goto fail; }\r\n    if (top.type == POISSON_DIRICHLET) { top_vals = poisson_read_boundary(top.file, nx); if (!top_vals) goto fail; }\r\n\r\n    int n = nx * ny;\r\n    COOMatrix "]
[2244.543739, "o", "*coo = coo_create(n, n, 5 * n);\r\n    double *b = vec_create(n);\r\n    if (!coo || !b) { coo_destroy(coo); free(b); goto fail; }\r\n\r\n    int k = 0;\r\n    for (int i = 0; i < nx; i++) {\r\n        for (int j = 0; j < ny; j++) {\r\n            int idx = i * ny + j;\r\n            int is_left = (i == 0);\r\n            int is_right = (i == nx - 1);\r\n            int is_bottom = (j == 0);\r\n            int is_top = (j == ny - 1);\r\n\r\n            if (is_left && left.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = left_vals[j];\r\n                continue;\r\n            }\r\n            if (is_right && right.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = right_vals[j];\r\n                continue;\r\n            }\r\n            if (is_bottom && bottom.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = bottom_vals[i];\r\n                continue;\r\n            }\r\n"]
[2244.543824, "o", "            if (is_top && top.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = top_vals[i];\r\n                continue;\r\n            }\r\n\r\n            double diag = 0.0;\r\n            double rhs = f[idx];\r\n            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;\r\n\r\n            if (is_left && left.type == POISSON_NEUMANN) {\r\n                diag += 2.0 / hx2;\r\n                c_ip = -2.0 / hx2;\r\n                rhs += 2.0 * left_vals[j] / hx;\r\n            } else if (is_right && right.type == POISSON_NEUMANN) {\r\n                diag += 2.0 / hx2;\r\n                c_im = -2.0 / hx2;\r\n                rhs += 2.0 * right_vals[j] / hx;\r\n            } else if (!is_left && !is_right) {\r\n                diag += 2.0 / hx2;\r\n"]
[2244.543936, "o", "                c_im = -1.0 / hx2;\r\n                c_ip = -1.0 / hx2;\r\n            }\r\n\r\n            if (is_bottom && bottom.type == POISSON_NEUMANN) {\r\n                diag += 2.0 / hy2;\r\n                c_jp = -2.0 / hy2;\r\n                rhs += 2.0 * bottom_vals[i] / hy;\r\n            } else if (is_top && top.type == POISSON_NEUMANN) {\r\n                diag += 2.0 / hy2;\r\n                c_jm = -2.0 / hy2;\r\n                rhs += 2.0 * top_vals[i] / hy;\r\n            } else if (!is_bottom && !is_top) {\r\n                diag += 2.0 / hy2;\r\n                c_jm = -1.0 / hy2;\r\n                c_jp = -1.0 / hy2;\r\n            }\r\n\r\n            add_coo(coo, &k, idx, idx, diag);\r\n            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);\r\n            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);\r\n            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);\r\n            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);\r\n"]
[2244.544026, "o", "            b[idx] = rhs;\r\n        }\r\n    }\r\n\r\n    coo->nnz = k;\r\n    CSRMatrix *A = coo_to_csr(coo);\r\n    coo_destroy(coo);\r\n    if (!A) { free(b); goto fail; }\r\n\r\n    free(f);\r\n    free(left_vals);\r\n    free(right_vals);\r\n    free(bottom_vals);\r\n    free(top_vals);\r\n\r\n    *A_out = A;\r\n    *b_out = b;\r\n    return 0;\r\n\r\nfail:\r\n    free(f);\r\n"]
[2244.544105, "o", "    free(left_vals);\r\n    free(right_vals);\r\n    free(bottom_vals);\r\n    free(top_vals);\r\n    return -1;\r\n}\r\n"]
