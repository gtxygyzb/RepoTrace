[7868.544049, "o", "     8\t{\r\n     9\t    if (maxiter < 0) maxiter = 0;\r\n    10\t    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    11\t    if (!res) return NULL;\r\n    12\t\r\n    13\t    res->x = vec_create(n);\r\n    14\t    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    15\t    if (!res->x || !res->history) {\r\n    16\t        free(res->x);\r\n    17\t        free(res->history);\r\n    18\t        free(res);\r\n    19\t        return NULL;\r\n    20\t    }\r\n    21\t    res->history_len = 0;\r\n    22\t"]
[7868.544129, "o", "    return res;\r\n    23\t}\r\n    24\t\r\n    25\tSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n    26\t                      double tol, int maxiter, Precond *P)\r\n    27\t{\r\n    28\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n    29\t    int n = A->rows;\r\n    30\t    if (maxiter < 0) maxiter = 0;\r\n    31\t\r\n    32\t    SolveResult *res = result_create(n, maxiter);\r\n    33\t    if (!res) return NULL;\r\n    34\t"]
[7868.544198, "o", "\r\n    35\t    double *r = vec_create(n);\r\n    36\t    double *z = vec_create(n);\r\n    37\t    double *p = vec_create(n);\r\n    38\t    double *Ap = vec_create(n);\r\n    39\t    if (!r || !z || !p || !Ap) {\r\n    40\t        free(r); free(z); free(p); free(Ap);\r\n    41\t        solve_result_destroy(res);\r\n    42\t        return NULL;\r\n    43\t    }\r\n    44\t\r\n    45\t"]
[7868.544269, "o", "    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n    46\t\r\n    47\t    csr_spmv(A, res->x, Ap);\r\n    48\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n    49\t\r\n    50\t    double bnorm = vec_norm2(b, n);\r\n    51\t    if (bnorm == 0.0) bnorm = 1.0;\r\n    52\t\r\n    53\t    res->true_residual = vec_norm2(r, n);\r\n    54\t    res->relres = res->true_residual / bnorm;\r\n    55\t    res->history[0] = res->relres;\r\n    56\t    res->history_len = 1;\r\n"]
[7868.544331, "o", "    57\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n    58\t    res->iterations = 0;\r\n    59\t    if (res->converged || maxiter == 0) {\r\n    60\t        free(r); free(z); free(p); free(Ap);\r\n    61\t        return res;\r\n    62\t    }\r\n    63\t\r\n    64\t    if (precond_apply(P, A, r, z) != 0) {\r\n"]
[7868.544398, "o", "    65\t        free(r); free(z); free(p); free(Ap);\r\n    66\t        return res;\r\n    67\t    }\r\n    68\t    vec_copy(z, p, n);\r\n    69\t    double rz_old = vec_dot(r, z, n);\r\n    70\t\r\n    71\t    for (int iter = 1; iter <= maxiter; iter++) {\r\n    72\t        csr_spmv(A, p, Ap);\r\n    73\t        double pAp = vec_dot(p, Ap, n);\r\n    74\t"]
[7868.544461, "o", "        if (fabs(pAp) < 1e-30) break;\r\n    75\t\r\n    76\t        double alpha = rz_old / pAp;\r\n    77\t        vec_axpy(alpha, p, res->x, n);\r\n    78\t        vec_axpy(-alpha, Ap, r, n);\r\n    79\t\r\n    80\t        /* Recompute the true residual rather than relying on the recurrence. */\r\n    81\t        csr_spmv(A, res->x, Ap);\r\n    82\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n    83\t\r\n    84\t        res->true_residual = vec_norm2(r, n);\r\n"]
[7868.544534, "o", "    85\t        res->relres = res->true_residual / bnorm;\r\n    86\t        res->history[iter] = res->relres;\r\n    87\t        res->history_len = iter + 1;\r\n    88\t        res->iterations = iter;\r\n    89\t\r\n    90\t        if (res->relres < tol) {\r\n    91\t            res->converged = 1;\r\n    92\t            break;\r\n    93\t        }\r\n    94\t\r\n"]
[7868.544599, "o", "    95\t        if (precond_apply(P, A, r, z) != 0) break;\r\n    96\t        double rz_new = vec_dot(r, z, n);\r\n    97\t        if (fabs(rz_old) < 1e-30) break;\r\n    98\t        double beta = rz_new / rz_old;\r\n    99\t        vec_scale(beta, p, n);\r\n   100\t        vec_axpy(1.0, z, p, n);\r\n   101\t        rz_old = rz_new;\r\n   102\t    }\r\n   103\t\r\n   104\t    free(r); free(z); free(p); free(Ap);\r\n"]
[7868.544643, "o", "   105\t    return res;\r\n   106\t}\r\n   107\t\r\n   108\tstatic void apply_givens(double *a, double *b, double c, double s)\r\n   109\t{\r\n   110\t    double t = c * (*a) + s * (*b);\r\n   111\t    *b = -s * (*a) + c * (*b);\r\n"]
[7868.544738, "o", "   112\t    *a = t;\r\n   113\t}\r\n   114\t\r\n   115\tstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n   116\t{\r\n"]
[7868.544785, "o", "   117\t    if (kdim <= 0) return -1;\r\n   118\t\r\n   119\t    double *c = (double *)malloc(m * sizeof(double));\r\n   120\t    double *s = (double *)malloc(m * sizeof(double));\r\n   121\t    if (!c || !s) { free(c); free(s); return -1; }\r\n   122\t\r\n   123\t    for (int i = 0; i < kdim; i++) {\r\n   124\t        for (int k = 0; k < i; k++) {\r\n   125\t            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n   126\t        }\r\n   127\t\r\n   128\t        double a = H[i*m+i];\r\n   129\t        double b = H[(i+1)*m+i];\r\n   130\t        if (b == 0.0) {\r\n   131\t            c[i] = 1.0;\r\n   132\t            s[i] = 0.0;\r\n   133\t        } else {\r\n"]
[7868.544884, "o", "   134\t            double r = hypot(a, b);\r\n   135\t            c[i] = a / r;\r\n   136\t            s[i] = b / r;\r\n   137\t        }\r\n   138\t        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n   139\t        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n   140\t\r\n   141\t    }\r\n   142\t\r\n   143\t    for (int i = kdim - 1; i >= 0; i--) {\r\n   144\t        double sum = g[i];\r\n   145\t        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n"]
[7868.54498, "o", "   146\t        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n   147\t        y[i] = sum / H[i*m+i];\r\n   148\t    }\r\n   149\t\r\n   150\t    free(c);\r\n   151\t    free(s);\r\n   152\t    return 0;\r\n   153\t}\r\n   154\t\r\n   155\tSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n   156\t                           double tol, int maxiter, int m, Precond *P)\r\n"]
[7868.545053, "o", "   157\t{\r\n   158\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n   159\t    int n = A->rows;\r\n   160\t    if (m <= 0) m = 30;\r\n   161\t    if (maxiter < 0) maxiter = 0;\r\n   162\t\r\n   163\t    SolveResult *res = result_create(n, maxiter);\r\n   164\t    if (!res) return NULL;\r\n   165\t\r\n   166\t    double *r = vec_create(n);\r\n   167\t    double *z = vec_create(n);\r\n   168\t    double *Ap = vec_create(n);\r\n   169\t    double *Av = vec_create(n);\r\n   170\t    double *w = vec_create(n);\r\n   171\t    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n   172\t    double *y = (double *)malloc(m * sizeof(double));\r\n"]
[7868.545125, "o", "   173\t    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n   174\t    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n   175\t\r\n   176\t    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n   177\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   178\t        solve_result_destroy(res);\r\n   179\t        return NULL;\r\n   180\t    }\r\n   181\t\r\n   182\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n"]
[7868.545192, "o", "   183\t\r\n   184\t    csr_spmv(A, res->x, Ap);\r\n   185\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   186\t\r\n   187\t    double bnorm = vec_norm2(b, n);\r\n   188\t    if (bnorm == 0.0) bnorm = 1.0;\r\n   189\t\r\n   190\t    res->true_residual = vec_norm2(r, n);\r\n   191\t    res->relres = res->true_residual / bnorm;\r\n   192\t    res->history[0] = res->relres;\r\n   193\t    res->history_len = 1;\r\n"]
[7868.545265, "o", "   194\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n   195\t    res->iterations = 0;\r\n   196\t    if (res->converged || maxiter == 0) {\r\n   197\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   198\t        return res;\r\n   199\t    }\r\n   200\t\r\n   201\t    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n   202\t        if (precond_apply(P, A, r, z) != 0) break;\r\n   203\t        double beta = vec_norm2(z, n);\r\n"]
[7868.545339, "o", "   204\t        if (beta == 0.0) break;\r\n   205\t\r\n   206\t        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n   207\t        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n   208\t        g[0] = beta;\r\n   209\t        memset(H, 0, (m + 1) * m * sizeof(double));\r\n   210\t\r\n   211\t        int kdim = 0;\r\n   212\t        int fail = 0;\r\n   213\t        for (int j = 0; j < m; j++) {\r\n   214\t            csr_spmv(A, V + j * n, Av);\r\n"]
[7868.545382, "o", "   215\t            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n   216\t\r\n   217\t            for (int i = 0; i <= j; i++) {\r\n   218\t                double h = vec_dot(w, V + i * n, n);\r\n   219\t                H[i*m+j] = h;\r\n   220\t                vec_axpy(-h, V + i * n, w, n);\r\n"]
[7868.545472, "o", "   221\t            }\r\n   222\t\r\n   223\t            double hnorm = vec_norm2(w, n);\r\n   224\t            H[(j+1)*m+j] = hnorm;\r\n   225\t            kdim = j + 1;\r\n   226\t\r\n   227\t            if (hnorm < 1e-14) break;\r\n   228\t\r\n   229\t            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n   230\t        }\r\n   231\t        if (fail) break;\r\n   232\t        if (kdim == 0) break;\r\n   233\t\r\n   234\t        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n"]
[7868.545545, "o", "   235\t        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n   236\t\r\n   237\t        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n   238\t\r\n   239\t        csr_spmv(A, res->x, Ap);\r\n   240\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   241\t\r\n   242\t        res->true_residual = vec_norm2(r, n);\r\n   243\t        res->relres = res->true_residual / bnorm;\r\n   244\t        res->history[cycle] = res->relres;\r\n   245\t        res->history_len = cycle + 1;\r\n   246\t        res->iterations = cycle;\r\n"]
[7868.545589, "o", "   247\t\r\n   248\t        if (res->relres < tol) {\r\n   249\t            res->converged = 1;\r\n   250\t            break;\r\n   251\t        }\r\n   252\t    }\r\n"]
[7868.545628, "o", "   253\t\r\n   254\t    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   255\t    return res;\r\n   256\t}\r\n   257\t\r\n   258\tvoid solve_result_destroy(SolveResult *res)\r\n   259\t"]
[7868.545726, "o", "{\r\n   260\t    if (!res) return;\r\n   261\t    free(res->x);\r\n   262\t    free(res->history);\r\n   263\t    free(res);\r\n   264\t}\r\n"]
