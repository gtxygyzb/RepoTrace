[1145.620661, "o", "\u001b[?2004h> "]
[1145.620713, "o", "        return 1;\r\n\u001b[?2004l\r"]
[1145.62077, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1145.620825, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r_"]
[1145.620891, "o", "\u001b[?2004h> "]
[1145.621047, "o", "    if (A->rows != n || A->cols != n) {\r\n\u001b[?2004l\r"]
[1145.621103, "o", "\u001b[?2004h> "]
[1145.621393, "o", "        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n\u001b[?2004l\r"]
[1145.62145, "o", "\u001b[?2004h> "]
[1145.621606, "o", "                A->rows, A->cols, n);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.62166, "o", "> "]
[1145.621723, "o", "        free(b);\r\n\u001b[?2004l\r"]
[1145.62178, "o", "\u001b[?2004h> "]
[1145.621877, "o", "        dm_destroy(A);\r\n\u001b[?2004l\r"]
[1145.621934, "o", "\u001b[?2004h> "]
[1145.622012, "o", "        return 1;\r\n\u001b[?2004l\r"]
[1145.622067, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1145.622122, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h"]
[1145.622177, "o", "> "]
[1145.622292, "o", "    double *x = vec_create(n);\r\n\u001b[?2004l\r"]
[1145.622347, "o", "\u001b[?2004h> "]
[1145.622394, "o", "    if (!x) {\r\n\u001b[?2004l\r"]
[1145.622454, "o", "\u001b[?2004h> "]
[1145.622683, "o", "        fprintf(stderr, \"Error: allocation failed\\n\");\r\n\u001b[?2004l\r"]
[1145.622739, "o", "\u001b[?2004h> "]
[1145.622803, "o", "        free(b);\r\n\u001b[?2004l\r"]
[1145.622858, "o", "\u001b[?2004h> "]
[1145.622959, "o", "        dm_destroy(A);\r\n\u001b[?2004l\r"]
[1145.623015, "o", "\u001b[?2004h> "]
[1145.623103, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1145.623158, "o", ">     }\r\n\u001b[?2004l\r"]
[1145.623213, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rf\u001b[?2004h"]
[1145.623268, "o", "> "]
[1145.62339, "o", "    int rc = dm_solve(A, b, x);\r\n\u001b[?2004l\r"]
[1145.623446, "o", "\u001b[?2004h> "]
[1145.623512, "o", "    if (rc != 0) {\r\n\u001b[?2004l\r"]
[1145.623571, "o", "\u001b[?2004h> "]
[1145.623934, "o", "        fprintf(stderr, \"Error: solver failed (singular or ill-conditioned)\\n\");\r\n\u001b[?2004l\r"]
[1145.62399, "o", "\u001b[?2004h> "]
[1145.624051, "o", "        free(x);\r\n\u001b[?2004l\r"]
[1145.624108, "o", "\u001b[?2004h> "]
[1145.624168, "o", "        free(b);\r\n\u001b[?2004l\r"]
[1145.624222, "o", "\u001b[?2004h> "]
[1145.624308, "o", "        dm_destroy(A);\r\n\u001b[?2004l\r"]
[1145.624363, "o", "\u001b[?2004h> "]
[1145.62442, "o", "        return 1;\r\n\u001b[?2004l\r"]
[1145.624475, "o", "\u001b[?2004h>     }"]
[1145.62453, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rc"]
[1145.624584, "o", "\u001b[?2004h> "]
[1145.62467, "o", "    if (out_file) {\r\n\u001b[?2004l\r"]
[1145.624725, "o", "\u001b[?2004h> "]
[1145.624902, "o", "        vec_write_text(x, n, out_file);\r\n\u001b[?2004l\r"]
[1145.624957, "o", "\u001b[?2004h> "]
