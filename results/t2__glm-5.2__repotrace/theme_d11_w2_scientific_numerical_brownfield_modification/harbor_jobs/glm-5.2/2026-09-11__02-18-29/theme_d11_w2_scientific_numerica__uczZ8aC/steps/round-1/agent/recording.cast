[2344.963773, "o", "\t        if (b == 0.0) {\r\n   125\t            c[i] = 1.0;\r\n   126\t            s[i] = 0.0;\r\n   127\t        } else {\r\n   128\t            double r = hypot(a, b);\r\n   129\t            c[i] = a / r;\r\n   130\t            s[i] = b / r;\r\n   131\t        }\r\n   132\t        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n   133\t        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n   134\t\r\n   135\t    }\r\n   136\t\r\n"]
[2344.963855, "o", "   137\t    for (int i = kdim - 1; i >= 0; i--) {\r\n   138\t        double sum = g[i];\r\n   139\t        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n   140\t        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n   141\t        y[i] = sum / H[i*m+i];\r\n   142\t    }\r\n   143\t\r\n   144\t    free(c);\r\n   145\t    free(s);\r\n   146\t    return 0;\r\n   147\t}\r\n   148\t\r\n   149"]
[2344.963934, "o", "\tSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n   150\t                         double tol, int maxiter, int m, Precond *P)\r\n   151\t{\r\n   152\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n   153\t    int n = A->rows;\r\n   154\t    if (m <= 0) m = 30;\r\n   155\t    if (maxiter < 0) maxiter = 0;\r\n   156\t\r\n   157\t    SolveResult *res = result_create(n, maxiter);\r\n"]
[2344.963997, "o", "   158\t    if (!res) return NULL;\r\n   159\t\r\n   160\t    double *r = vec_create(n);\r\n   161\t    double *z = vec_create(n);\r\n   162\t    double *Ap = vec_create(n);\r\n   163\t    double *Av = vec_create(n);\r\n   164\t    double *w = vec_create(n);\r\n   165\t    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n"]
[2344.964065, "o", "   166\t    double *y = (double *)malloc(m * sizeof(double));\r\n   167\t    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n   168\t    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n   169\t\r\n   170\t    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n   171\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   172\t        solve_result_destroy(res);\r\n   173\t        return NULL;\r\n   174\t    }\r\n   175\t\r\n"]
[2344.964128, "o", "   176\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n   177\t\r\n   178\t    csr_spmv(A, res->x, Ap);\r\n   179\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   180\t\r\n   181\t    double bnorm = vec_norm2(b, n);\r\n   182\t    if (bnorm == 0.0) bnorm = 1.0;\r\n   183\t\r\n   184\t    res->relres = vec_norm2(r, n) / bnorm;\r\n   185\t    res->history[0] = res->relres;\r\n"]
[2344.964248, "o", "   186\t    res->history_len = 1;\r\n   187\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n   188\t    res->iterations = 0;\r\n   189\t    if (res->converged || maxiter == 0) {\r\n   190\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   191\t        return res;\r\n   192\t    }\r\n   193\t\r\n   194\t    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n   195\t        if (precond_apply(P, A, r, z) != 0) break;\r\n   196\t        double beta = vec_norm2(z, n);\r\n   197\t        if (beta == 0.0) break;\r\n   198\t\r\n   199\t        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n   200\t        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n   201\t        g[0] = beta;\r\n   202\t        memset(H, 0, (m + 1) * m * sizeof(double));\r\n   203\t\r\n   204\t        int kdim = 0;\r\n"]
[2344.964316, "o", "   205\t        int fail = 0;\r\n   206\t        for (int j = 0; j < m; j++) {\r\n   207\t            csr_spmv(A, V + j * n, Av);\r\n   208\t            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n   209\t\r\n   210\t            for (int i = 0; i <= j; i++) {\r\n   211\t                double h = vec_dot(w, V + i * n, n);\r\n   212\t                H[i*m+j] = h;\r\n   213\t                vec_axpy(-h, V + i * n, w, n);\r\n   214\t            }\r\n   215\t\r\n"]
[2344.964378, "o", "   216\t            double hnorm = vec_norm2(w, n);\r\n   217\t            H[(j+1)*m+j] = hnorm;\r\n   218\t            kdim = j + 1;\r\n   219\t\r\n   220\t            if (hnorm < 1e-14) break;\r\n"]
