[2199.032765, "o", "     9\t#include \"solvers.h\"\r\n    10\t#include \"poisson.h\"\r\n    11\t\r\n    12\tstatic void usage(const char *prog)\r\n    13\t{\r\n    14\t    fprintf(stderr, \"Usage:\\n\");\r\n    15\t    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\n\", prog);\r\n    16\t    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    17\t    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    18\t}\r\n    19\t\r\n    20\tstatic const char *get_opt(in"]
[2199.032889, "o", "t argc, char **argv, const char *name)\r\n    21\t{\r\n    22\t    for (int i = 0; i < argc - 1; i++) {\r\n    23\t        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    24\t    }\r\n    25\t    return NULL;\r\n    26\t}\r\n    27\t\r\n    28\tstatic int write_history_file(const SolveResult *res, const char *filename)\r\n    29\t{\r\n    30\t    FILE *fp = fopen(filename, \"w\");\r\n    31\t    if (!fp) return -1;\r\n    32\t    for (int i = 0; i < res->history_len; i++) {\r\n    33\t        fprintf(fp, \"%.15e\\n\", res->history[i]);\r\n    34\t    }\r\n    35\t    fclose(fp);\r\n    36\t    return 0;\r\n    37\t}\r\n    38\t\r\n    39\tstatic void print_solve_summary(const SolveResult *res)\r\n    40\t{\r\n    41\t    printf(\"converged: %s\\n\", res->converged ? \"yes\" : \"no\");\r\n    42\t    printf(\"iterations: %d\\n\", res->iterations);\r\n    43\t    printf(\"residual: %.6e\\n\", res->relres);\r\n    44\t}\r\n    45\t\r\n    46\tstatic int cmd_dense_solve(int argc, char **argv)\r\n"]
[2199.032997, "o", "    47\t{\r\n    48\t    if (argc < 2) {\r\n    49\t        fprintf(stderr, \"Error: dense-solve requires <matrix_file> <rhs_file>\\n\");\r\n    50\t        return 1;\r\n    51\t    }\r\n    52\t\r\n    53\t    const char *mat_file = argv[0];\r\n    54\t    const char *rhs_file = argv[1];\r\n    55\t    const char *out_file = (argc >= 3) ? argv[2] : NULL;\r\n    56\t\r\n    57\t    DenseMatrix *A = dm_read_text(mat_file);\r\n    58\t    if (!A) {\r\n    59\t        fprintf(stderr, \"Error: cannot read matrix from '%s'\\n\", mat_file);\r\n    60\t        return 1;\r\n    61\t    }\r\n    62\t\r\n    63\t"]
[2199.033147, "o", "    int n;\r\n    64\t    double *b = vec_read_text(rhs_file, &n);\r\n    65\t    if (!b) {\r\n    66\t        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n    67\t        dm_destroy(A);\r\n    68\t        return 1;\r\n    69\t    }\r\n    70\t\r\n    71\t    if (A->rows != n || A->cols != n) {\r\n    72\t        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n    73\t                A->rows, A->cols, n);\r\n    74\t        free(b);\r\n    75\t        dm_destroy(A);\r\n    76\t        return 1;\r\n    77\t    }\r\n    78\t\r\n    79\t    double *x = vec_create(n);\r\n    80\t    if (!x) {\r\n    81\t        fprintf(stderr, \"Error: allocation failed\\n\");\r\n    82\t        free(b);\r\n    83\t        dm_destroy(A);\r\n    84\t        return 1;\r\n"]
[2199.033245, "o", "    85\t    }\r\n    86\t\r\n    87\t    int rc = dm_solve(A, b, x);\r\n    88\t    if (rc != 0) {\r\n    89\t        fprintf(stderr, \"Error: solver failed (singular or ill-conditioned)\\n\");\r\n    90\t        free(x);\r\n    91\t        free(b);\r\n    92\t        dm_destroy(A);\r\n    93\t        return 1;\r\n    94\t    }\r\n    95\t\r\n    96\t    if (out_file) {\r\n    97\t        vec_write_text(x, n, out_file);\r\n    98\t        printf(\"Solution written to %s\\n\", out_file);\r\n    99\t    } else {\r\n   100"]
[2199.033335, "o", "\t        printf(\"Solution:\\n\");\r\n   101\t        vec_print(x, n, stdout);\r\n   102\t    }\r\n   103\t\r\n   104\t    double *r = vec_create(n);\r\n   105\t    dm_matvec(A, x, r);\r\n   106\t    vec_axpy(-1.0, b, r, n);\r\n   107\t    printf(\"Residual norm: %.6e\\n\", vec_norm2(r, n));\r\n   108\t\r\n   109\t    free(r);\r\n   110\t    free(x);\r\n   111\t    free(b);\r\n   112\t    dm_destroy(A);\r\n"]
