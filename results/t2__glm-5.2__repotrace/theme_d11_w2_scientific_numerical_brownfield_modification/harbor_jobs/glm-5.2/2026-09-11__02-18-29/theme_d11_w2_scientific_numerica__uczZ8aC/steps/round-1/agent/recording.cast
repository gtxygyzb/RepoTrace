[7423.350546, "i", "cat > /tmp/cddiag.c <<'EOF'\n#include <stdio.h>\n#include <stdlib.h>\n#include \"sparse.h\"\n#include \"poisson.h\"\n#include \"convdiff.h\"\n#include \"precond.h\"\n#include \"vector.h\"\n\nint main(void) {\n    PoissonBC left={POISSON_DIRICHLET,\"/tmp/cdtest/left4.txt\"};\n    PoissonBC right={POISSON_DIRICHLET,\"/tmp/cdtest/right4.txt\"};\n    PoissonBC bottom={POISSON_DIRICHLET,\"/tmp/cdtest/bottom4.txt\"};\n    PoissonBC top={POISSON_DIRICHLET,\"/tmp/cdtest/top4.txt\"};\n    CSRMatrix *A=NULL; double *b=NULL;\n    if (convdiff_assemble(4,4,0,1,0,1,0.2,1.0,0.5,\"/tmp/cdtest/source4.txt\",left,right,bottom,top,&A,&b)!=0) { printf(\"assemble failed\\n\"); return 1; }\n    printf(\"n=%d nnz=%d\\n\", A->rows, A->nnz);\n    double *diag=csr_diagonal(A);\n    int zeros=0;\n    for (int i=0;i<A->rows;i++) { if (diag[i]==0.0 || fabs(diag[i])<1e-15) { zeros++; printf(\"zero diag row %d\\n\", i); } }\n    printf(\"zero diag count=%d\\n\", zeros);\n    Precond *P=precond_create(A,\"jacobi\",1.0);\n    printf(\"P=%p\\n\",(void*)P);\n    if (P) {\n        double *r=vec_create(A"]
[7423.350918, "i", "->rows);\n        double *z=vec_create(A->rows);\n        for (int i=0;i<A->rows;i++) r[i]=b[i];\n        int st=precond_apply(P,A,r,z);\n        printf(\"precond_apply=%d\\n\", st);\n        free(r); free(z);\n        precond_destroy(P);\n    }\n    free(diag); free(b); csr_destroy(A);\n    return 0;\n}\nEOF\ngcc -Wall -Wextra -O2 -Iinclude -o /tmp/cddiag /tmp/cddiag.c src/convdiff.c src/sparse.c src/vector.c src/poisson.c src/precond.c -lm\n"]
[7423.351028, "o", "cat > /tmp/cddiag.c <<'EOF'\r\n\u001b[?2004l\r->rows);\r\n        double *z=vec_create(A->rows);\r\n        for (int i=0;i<A->rows;i++) r[i]=b[i];\r\n        int st=precond_apply(P,A,r,z);\r\n        printf(\"precond_app"]
[7423.351121, "o", "ly=%d\\n\", st);\r\n        free(r); free(z);\r\n        precond_destroy(P);\r\n    }\r\n    free(diag); free(b); csr_destroy(A);\r\n "]
