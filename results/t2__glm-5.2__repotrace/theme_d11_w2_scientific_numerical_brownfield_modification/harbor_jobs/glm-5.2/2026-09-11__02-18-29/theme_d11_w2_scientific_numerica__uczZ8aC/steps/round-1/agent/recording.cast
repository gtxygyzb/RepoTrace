[2274.320721, "o", "    33\tint dm_write_text(const DenseMatrix *m, const char *filename)\r\n    34\t{\r\n    35\t    FILE *fp = fopen(filename, \"w\");\r\n    36\t    if (!fp) return -1;\r\n    37\t    dm_print(m, fp);\r\n    38\t    fclose(fp);\r\n    39\t    return 0;\r\n    40\t}\r\n    41\t\r\n    42\tdouble *vec_read_text(const char *filename, int *n_out)\r\n    43\t{\r\n    44\t    FILE *fp = fopen(filename, \"r\");\r\n    45\t    if (!fp) return NULL;\r\n    46\t\r\n    47\t    int n;\r\n    48\t    if (fscanf(fp, \"%d\", &n) != 1 || n <= 0) {\r\n"]
[2274.320781, "o", "    49\t        fclose(fp);\r\n    50\t        return NULL;\r\n    51\t    }\r\n    52\t\r\n    53\t    double *x = vec_create(n);\r\n    54\t    if (!x) { fclose(fp); return NULL; }\r\n    55\t\r\n    56\t    int i;\r\n"]
[2274.320842, "o", "    57\t    for (i = 0; i < n; i++)\r\n    58\t        if (fscanf(fp, \"%lf\", &x[i]) != 1) {\r\n    59\t            free(x);\r\n    60\t            fclose(fp);\r\n    61\t            return NULL;\r\n    62\t        }\r\n    63\t\r\n    64\t    fclose(fp);\r\n    65\t    *n_out = n;\r\n    66\t    return x;\r\n    67\t}\r\n"]
[2274.320961, "o", "    68\t\r\n    69\tint vec_write_text(const double *x, int n, const char *filename)\r\n    70\t{\r\n    71\t    FILE *fp = fopen(filename, \"w\");\r\n    72\t    if (!fp) return -1;\r\n    73\t    fprintf(fp, \"%d\\n\", n);\r\n    74\t    vec_print(x, n, fp);\r\n    75\t    fclose(fp);\r\n    76\t    return 0;\r\n    77\t}\r\n"]
