[7280.887472, "o", "\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KSolveResult *\u001b[01;31m\u001b[Kcg_solve\u001b[m\u001b[K(const CSRMatrix *A, const double *b, const double *x0,\r\n"]
[7280.887533, "o", "\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(P, A, r, z) != 0) {\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(P, A, r, z) != 0) break;\r\n"]
[7280.88763, "o", "\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KSolveResult *\u001b[01;31m\u001b[Kgmres_solve\u001b[m\u001b[K(const CSRMatrix *A, const double *b, const double *x0,\r\n"]
[7280.887691, "o", "\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K202\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(P, A, r, z) != 0) break;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (\u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(P, A, Av, w) != 0) { fail = 1; break; }\r\n"]
