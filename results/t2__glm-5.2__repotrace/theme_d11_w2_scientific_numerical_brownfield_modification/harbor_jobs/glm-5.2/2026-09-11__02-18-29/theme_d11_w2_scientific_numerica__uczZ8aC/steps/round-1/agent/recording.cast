[2279.586778, "i", "cat Makefile\n"]
[2279.587082, "o", "cat Makefile\r\n\u001b[?2004l\r"]
[2279.589364, "o", ".RECIPEPREFIX := >\r\n\r\nCC      = gcc\r\nCFLAGS  = -Wall -Wextra -O2 -Iinclude\r\nLDFLAGS = -lm\r\n\r\nSRC     = src/main.c src/dense.c src/vector.c src/io.c src/sparse.c src/precond.c src/solvers.c src/poisson.c\r\nOBJ     = $(SRC:.c=.o)\r\nBIN     = numsim\r\n\r\n.PHONY: all clean\r\n\r\nall: $(BIN)\r\n\r\n$(BIN): $(SRC)\r\n>$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)\r\n\r\nclean:\r\n>rm -f $(BIN) $(OBJ)\r\n"]
[2279.589785, "o", "\u001b[?2004h"]
[2279.589856, "o", "root@n30009:/app# "]
[2279.867078, "i", "sed -n '1,160p' src/io.c\n"]
[2279.867345, "o", "sed -n '1,160p' src/io.c\r\n\u001b[?2004l\r"]
[2279.870627, "o", "#include \"io.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n"]
[2279.870733, "o", "\r\nDenseMatrix *dm_read_text(const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    int rows, cols;\r\n"]
[2279.870814, "o", "    if (fscanf(fp, \"%d %d\", &rows, &cols) != 2) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    DenseMatrix *m = dm_create(rows, cols);\r\n    if (!m) { fclose(fp); return NULL; }\r\n\r\n    int i, j;\r\n    for (i = 0; i < rows; i++)\r\n        for (j = 0; j < cols; j++)\r\n            if (fscanf(fp, \"%lf\", &m->data[i * cols + j]) != 1) {\r\n                dm_destroy(m);\r\n                fclose(fp);\r\n                return NULL;\r\n            }\r\n\r\n"]
[2279.870924, "o", "    fclose(fp);\r\n    return m;\r\n}\r\n\r\nint dm_write_text(const DenseMatrix *m, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    dm_print(m, fp);\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n\r\ndouble *vec_read_text(const char *filename, int *n_out)\r\n{\r\n"]
[2279.870993, "o", "    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    int n;\r\n    if (fscanf(fp, \"%d\", &n) != 1 || n <= 0) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n"]
[2279.871058, "o", "    double *x = vec_create(n);\r\n    if (!x) { fclose(fp); return NULL; }\r\n\r\n    int i;\r\n    for (i = 0; i < n; i++)\r\n        if (fscanf(fp, \"%lf\", &x[i]) != 1) {\r\n            free(x);\r\n            fclose(fp);\r\n"]
[2279.871129, "o", "            return NULL;\r\n        }\r\n\r\n    fclose(fp);\r\n    *n_out = n;\r\n    return x;\r\n}\r\n\r\nint vec_write_text(const double *x, int n, const char *filename)\r\n{"]
[2279.871205, "o", "\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    fprintf(fp, \"%d\\n\", n);\r\n    vec_print(x, n, fp);\r\n    fclose(fp);\r\n    return 0;\r\n"]
[2279.871249, "o", "}\r\n"]
