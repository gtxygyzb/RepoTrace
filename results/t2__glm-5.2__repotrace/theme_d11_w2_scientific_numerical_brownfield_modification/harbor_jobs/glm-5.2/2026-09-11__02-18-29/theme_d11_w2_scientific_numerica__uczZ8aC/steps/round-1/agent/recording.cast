[12865.446163, "o", "    65\t    *n_out = n;\r\n    66\t    return x;\r\n    67\t}\r\n    68\t\r\n    69\tint vec_write_text(const double *x, int n, const char *filename)\r\n    70\t{\r\n    71\t    FILE *fp = fopen(filename, \"w\");\r\n    72\t    if (!fp) return -1;\r\n    73\t    fprintf(fp, \"%d\\n\", n);\r\n    74\t    vec_print(x, n, fp);\r\n    75\t    fclose(fp);\r\n    76\t    return 0;\r\n"]
