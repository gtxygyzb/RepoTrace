[11232.852041, "o", "nl -ba src/solvers.c | sed -n '180,270p'\r\n"]
[11232.852131, "o", "\u001b[?2004l\r"]
[11232.855608, "o", "   180\t    double *y = (double *)malloc(m * sizeof(double));\r\n   181\t    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n   182\t    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n   183\t\r\n"]
[11232.855688, "o", "   184\t    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n   185\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   186\t        solve_result_destroy(res);\r\n   187\t        return NULL;\r\n   188\t    }\r\n   189\t\r\n   190\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n   191\t\r\n   192\t    csr_spmv(A, res->x, Ap);\r\n   193\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   194\t\r\n   195\t    double bnorm = vec_norm2(b, n);\r\n"]
[11232.855759, "o", "   196\t    if (bnorm == 0.0) bnorm = 1.0;\r\n   197\t\r\n   198\t    res->true_residual = vec_norm2(r, n);\r\n   199\t    res->relres = res->true_residual / bnorm;\r\n   200\t    precond_apply(P, A, r, z);\r\n   201\t    double pnorm0 = vec_norm2(z, n);\r\n   202\t"]
[11232.855824, "o", "    res->history[0] = res->relres;\r\n   203\t    res->precond_history[0] = pnorm0;\r\n   204\t    res->history_len = 1;\r\n   205\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n   206\t    res->iterations = 0;\r\n   207\t    if (res->converged || maxiter == 0) {\r\n   208\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   209\t        return res;\r\n   210\t    }\r\n   211\t\r\n   212\t    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n   213\t        if (precond_apply(P, A, r, z) != 0) break;\r\n   214\t        double beta = vec_norm2(z, n);\r\n   215\t        if (beta == 0.0) break;\r\n   216"]
[11232.855896, "o", "\t\r\n   217\t        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n   218\t        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n   219\t        g[0] = beta;\r\n   220\t        memset(H, 0, (m + 1) * m * sizeof(double));\r\n   221\t\r\n   222\t        int kdim = 0;\r\n"]
[11232.855957, "o", "   223\t        int fail = 0;\r\n   224\t        for (int j = 0; j < m; j++) {\r\n   225\t            csr_spmv(A, V + j * n, Av);\r\n   226\t            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n   227\t\r\n   228\t            for (int i = 0; i <= j; i++) {\r\n   229\t                double h = vec_dot(w, V + i * n, n);\r\n   230\t                H[i*m+j] = h;\r\n   231\t                vec_axpy(-h, V + i * n, w, n);\r\n   232\t            }\r\n   233\t\r\n"]
[11232.856014, "o", "   234\t            double hnorm = vec_norm2(w, n);\r\n   235\t            H[(j+1)*m+j] = hnorm;\r\n   236\t            kdim = j + 1;\r\n   237\t\r\n   238\t            if (hnorm < 1e-14) break;\r\n   239\t\r\n   240\t            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n   241\t        }\r\n   242\t        if (fail) break;\r\n"]
[11232.856075, "o", "   243\t        if (kdim == 0) break;\r\n   244\t\r\n   245\t        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n   246\t        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n   247\t\r\n   248\t        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n   249\t\r\n   250\t        csr_spmv(A, res->x, Ap);\r\n   251\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   252\t\r\n"]
[11232.856137, "o", "   253\t        res->true_residual = vec_norm2(r, n);\r\n   254\t        res->relres = res->true_residual / bnorm;\r\n   255\t        precond_apply(P, A, r, z);\r\n   256\t        double pznorm = vec_norm2(z, n);\r\n   257\t        res->history[cycle] = res->relres;\r\n   258\t        res->precond_history[cycle] = pznorm;\r\n   259\t        res->history_len = cycle + 1;\r\n   260\t        res->iterations = cycle;\r\n   261\t"]
[11232.856197, "o", "\r\n   262\t        if (res->relres < tol) {\r\n   263\t            res->converged = 1;\r\n   264\t            break;\r\n   265\t        }\r\n   266\t    }\r\n   267\t\r\n   268\t    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n"]
[11232.856256, "o", "   269\t    return res;\r\n   270\t}\r\n"]
