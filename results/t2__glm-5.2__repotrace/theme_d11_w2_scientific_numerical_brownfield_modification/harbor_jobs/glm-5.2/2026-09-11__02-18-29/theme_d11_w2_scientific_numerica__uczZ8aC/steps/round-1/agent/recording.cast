[7268.377763, "o", "static SolveResult *result_create(int n, int maxiter)\r\n     8\t{\r\n     9\t    if (maxiter < 0) maxiter = 0;\r\n    10\t    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    11\t    if (!res) return NULL;\r\n    12\t\r\n    13\t    res->x = vec_create(n);\r\n    14\t    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    15\t    if (!res->x || !res->history) {\r\n    16\t        free(res->x);\r\n    17\t        free(res->history);\r\n    18\t        free(res);\r\n"]
[7268.377845, "o", "    19\t        return NULL;\r\n    20\t    }\r\n    21\t    res->history_len = 0;\r\n    22\t    return res;\r\n    23\t}\r\n    24\t\r\n    25\tSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n"]
[7268.377928, "o", "    26\t                      double tol, int maxiter, Precond *P)\r\n    27\t{\r\n    28\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n    29\t    int n = A->rows;\r\n    30\t    if (maxiter < 0) maxiter = 0;\r\n    31\t\r\n    32\t    SolveResult *res = result_create(n, maxiter);\r\n    33\t    if (!res) return NULL;\r\n    34\t\r\n    35\t    double *r = vec_create(n);\r\n    36\t    double *z = vec_create(n);\r\n    37\t    double *p = vec_create(n);\r\n    38\t    double *Ap = vec_create(n);\r\n    39\t    if (!r || !z || !p || !Ap) {\r\n    40\t        free(r); free(z); free(p); free(Ap);\r\n    41"]
[7268.377995, "o", "\t        solve_result_destroy(res);\r\n    42\t        return NULL;\r\n    43\t    }\r\n    44\t\r\n    45\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n    46\t\r\n    47\t    csr_spmv(A, res->x, Ap);\r\n    48\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n    49\t\r\n    50\t"]
[7268.378058, "o", "    double bnorm = vec_norm2(b, n);\r\n    51\t    if (bnorm == 0.0) bnorm = 1.0;\r\n    52\t\r\n    53\t    res->true_residual = vec_norm2(r, n);\r\n    54\t    res->relres = res->true_residual / bnorm;\r\n    55\t    res->history[0] = res->relres;\r\n    56\t    res->history_len = 1;\r\n    57\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n    58\t"]
[7268.378118, "o", "    res->iterations = 0;\r\n    59\t    if (res->converged || maxiter == 0) {\r\n    60\t        free(r); free(z); free(p); free(Ap);\r\n    61\t        return res;\r\n    62\t    }\r\n    63\t\r\n    64\t    if (precond_apply(P, A, r, z) != 0) {\r\n    65\t        free(r); free(z); free(p); free(Ap);\r\n    66\t        return res;\r\n"]
[7268.378179, "o", "    67\t    }\r\n    68\t    vec_copy(z, p, n);\r\n    69\t    double rz_old = vec_dot(r, z, n);\r\n    70\t\r\n    71\t    for (int iter = 1; iter <= maxiter; iter++) {\r\n    72\t        csr_spmv(A, p, Ap);\r\n    73\t        double pAp = vec_dot(p, Ap, n);\r\n    74\t        if (fabs(pAp) < 1e-30) break;\r\n"]
[7268.378241, "o", "    75\t\r\n    76\t        double alpha = rz_old / pAp;\r\n    77\t        vec_axpy(alpha, p, res->x, n);\r\n    78\t        vec_axpy(-alpha, Ap, r, n);\r\n    79\t\r\n    80\t        /* Recompute the true residual rather than relying on the recurrence. */\r\n    81\t        csr_spmv(A, res->x, Ap);\r\n    82\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n"]
[7268.3783, "o", "    83\t\r\n    84\t        res->true_residual = vec_norm2(r, n);\r\n    85\t        res->relres = res->true_residual / bnorm;\r\n    86\t        res->history[iter] = res->relres;\r\n    87\t        res->history_len = iter + 1;\r\n    88\t        res->iterations = iter;\r\n    89\t\r\n    90\t        if (res->relres < tol) {\r\n    91\t            res->converged = 1;\r\n    92\t            break;\r\n"]
[7268.378357, "o", "    93\t        }\r\n    94\t\r\n    95\t        if (precond_apply(P, A, r, z) != 0) break;\r\n    96\t        double rz_new = vec_dot(r, z, n);\r\n    97\t        if (fabs(rz_old) < 1e-30) break;\r\n    98\t        double beta = rz_new / rz_old;\r\n    99\t        vec_scale(beta, p, n);\r\n   100\t        vec_axpy(1.0, z, p, n);\r\n   101\t        rz_old = rz_new;\r\n"]
