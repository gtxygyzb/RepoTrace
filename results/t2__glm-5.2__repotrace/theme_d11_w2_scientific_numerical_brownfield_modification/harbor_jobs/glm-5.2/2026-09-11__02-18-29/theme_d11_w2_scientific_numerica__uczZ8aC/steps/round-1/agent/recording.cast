[7876.976671, "o", "nl -ba src/precond.c | sed -n '1,420p'\r\n\u001b[?2004l\r"]
[7876.980357, "o", "     1\t#include \"precond.h\"\r\n     2\t#include \"vector.h\"\r\n     3\t#include <stdlib.h>\r\n     4\t#include <string.h>\r\n     5\t#include <math.h>\r\n     6"]
[7876.980465, "o", "\t\r\n     7\tstatic int find_in_row(const CSRMatrix *A, int row, int col)\r\n     8\t{\r\n     9\t    int lo = A->row_ptr[row];\r\n    10\t    int hi = A->row_ptr[row+1] - 1;\r\n    11\t    while (lo <= hi) {\r\n    12\t        int mid = (lo + hi) / 2;\r\n    13\t        if (A->col_indices[mid] == col) return mid;\r\n    14\t        if (A->col_indices[mid] < col) lo = mid + 1;\r\n    15\t        else hi = mid - 1;\r\n    16\t    }\r\n    17\t    return -1;\r\n    18\t}\r\n    19\t\r\n    20\tstatic CSRMatrix *csr_copy(const CSRMatrix *A)\r\n    21\t{\r\n    22\t"]
[7876.980548, "o", "    CSRMatrix *B = csr_create(A->rows, A->cols, A->nnz);\r\n    23\t    if (!B) return NULL;\r\n    24\t    memcpy(B->values, A->values, A->nnz * sizeof(double));\r\n    25\t    memcpy(B->col_indices, A->col_indices, A->nnz * sizeof(int));\r\n    26\t    memcpy(B->row_ptr, A->row_ptr, (A->rows + 1) * sizeof(int));\r\n    27\t    return B;\r\n    28\t}\r\n    29\t\r\n    30\tstatic int ilu0_factorize(CSRMatrix *LU)\r\n    31\t{\r\n    32\t    int n = LU->rows;\r\n    33\t    for (int i = 0; i < n; i++) {\r\n    34\t        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n    35\t"]
[7876.980624, "o", "            int c = LU->col_indices[k];\r\n    36\t            if (c >= i) break;\r\n    37\t\r\n    38\t            int d = find_in_row(LU, c, c);\r\n    39\t            if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;\r\n    40\t\r\n    41\t            LU->values[k] /= LU->values[d];\r\n    42\t            double aik = LU->values[k];\r\n    43\t\r\n    44\t            for (int l = LU->row_ptr[c]; l < LU->row_ptr[c+1]; l++) {\r\n    45\t                int j = LU->col_indices[l];\r\n"]
[7876.980694, "o", "    46\t                if (j <= c) continue;\r\n    47\t                int idx = find_in_row(LU, i, j);\r\n    48\t                if (idx >= 0) LU->values[idx] -= aik * LU->values[l];\r\n    49\t            }\r\n    50\t        }\r\n    51\t    }\r\n    52\t    return 0;\r\n    53\t}\r\n    54\t\r\n    55\tstatic int ilu_forward_solve(const CSRMatrix *LU, const double *r, double *y)\r\n    56\t{\r\n"]
[7876.980771, "o", "    57\t    for (int i = 0; i < LU->rows; i++) {\r\n    58\t        double s = r[i];\r\n    59\t        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n    60\t            int j = LU->col_indices[k];\r\n    61\t            if (j < i) s -= LU->values[k] * y[j];\r\n    62\t            else break;\r\n    63\t        }\r\n    64\t        y[i] = s;\r\n    65\t    }\r\n    66\t    return 0;\r\n    67\t}\r\n    68\t\r\n"]
[7876.980846, "o", "    69\tstatic int ilu_backward_solve(const CSRMatrix *LU, const double *y, double *z)\r\n    70\t{\r\n    71\t    for (int i = LU->rows - 1; i >= 0; i--) {\r\n    72\t        double s = y[i];\r\n    73\t        int d = -1;\r\n    74\t        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n    75\t            int j = LU->col_indices[k];\r\n    76\t            if (j == i) d = k;\r\n    77\t            else if (j > i) s -= LU->values[k] * z[j];\r\n    78\t        }\r\n    79\t        if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;\r\n    80\t        z[i] = s / LU->values[d];\r\n"]
[7876.980952, "o", "    81\t    }\r\n    82\t    return 0;\r\n    83\t}\r\n    84\t\r\n    85\tPrecond *precond_create(const CSRMatrix *A, const char *name, double omega)\r\n    86\t{\r\n    87\t    if (!A || !name || A->rows != A->cols) return NULL;\r\n    88\t\r\n    89\t    Precond *P = (Precond *)calloc(1, sizeof(Precond));\r\n    90\t    if (!P) return NULL;\r\n    91\t\r\n"]
[7876.981024, "o", "    92\t    P->n = A->rows;\r\n    93\t    P->omega = (omega > 0.0) ? omega : 1.0;\r\n    94\t\r\n    95\t    if (strcmp(name, \"none\") == 0) {\r\n    96\t        P->type = PRECOND_NONE;\r\n    97\t    } else if (strcmp(name, \"jacobi\") == 0) {\r\n    98\t        P->type = PRECOND_JACOBI;\r\n    99\t        P->diag = csr_diagonal(A);\r\n   100\t        if (!P->diag) { precond_destroy(P); return NULL; }\r\n   101\t    } else if (strcmp(name, \"ilu0\") == 0) {\r\n   102\t        P->type = PRECOND_ILU0;\r\n   103\t        P->lu = csr_copy(A);\r\n   104\t        if (!P->lu) { precond_destroy(P); return NULL; }\r\n   105\t        if (ilu0_factorize(P->lu) != 0) { precond_destroy(P); return NULL; }\r\n"]
[7876.981087, "o", "   106\t    } else if (strcmp(name, \"ssor\") == 0) {\r\n   107\t        P->type = PRECOND_SSOR;\r\n   108\t        P->ssor_A = A;\r\n   109\t        P->diag = csr_diagonal(A);\r\n   110\t        if (!P->diag) { precond_destroy(P); return NULL; }\r\n   111\t    } else {\r\n   112\t        precond_destroy(P);\r\n   113\t        return NULL;\r\n   114\t    }\r\n   115\t\r\n"]
[7876.981161, "o", "   116\t    return P;\r\n   117\t}\r\n   118\t\r\n   119\tvoid precond_destroy(Precond *P)\r\n   120\t{\r\n   121\t    if (!P) return;\r\n   122\t    free(P->diag);\r\n   123\t    csr_destroy(P->lu);\r\n   124\t    free(P);\r\n   125\t}\r\n   126"]
[7876.981225, "o", "\t\r\n   127\tint precond_apply(Precond *P, const CSRMatrix *A, const double *r, double *z)\r\n   128\t{\r\n   129\t    int n = A ? A->rows : (P ? P->n : 0);\r\n   130\t    if (!P || P->type == PRECOND_NONE) {\r\n   131\t        vec_copy(r, z, n);\r\n   132\t        return 0;\r\n   133\t    }\r\n   134\t\r\n   135\t    switch (P->type) {\r\n"]
[7876.9813, "o", "   136\t    case PRECOND_JACOBI:\r\n   137\t        for (int i = 0; i < n; i++) {\r\n   138\t            if (fabs(P->diag[i]) < 1e-15) return -1;\r\n   139\t            z[i] = r[i] / P->diag[i];\r\n   140\t        }\r\n   141\t        return 0;\r\n   142\t\r\n   143\t    case PRECOND_ILU0: {\r\n   144\t        double *y = vec_create(n);\r\n   145\t        if (!y) return -1;\r\n   146\t        if (ilu_forward_solve(P->lu, r, y) != 0) { free(y); return -1; }\r\n   147\t        if (ilu_backward_solve(P->lu, y, z) != 0) { free(y); return -1; }\r\n"]
[7876.981371, "o", "   148\t        free(y);\r\n   149\t        return 0;\r\n   150\t    }\r\n   151\t\r\n   152\t    case PRECOND_SSOR: {\r\n   153\t        const CSRMatrix *M = A ? A : P->ssor_A;\r\n   154\t        if (!M) return -1;\r\n   155\t        vec_zero(z, n);\r\n   156\t\r\n   157\t        for (int i = 0; i < n; i++) {\r\n   158\t            double diag = P->diag[i];\r\n   159\t            if (fabs(diag) < 1e-15) return -1;\r\n"]
[7876.981445, "o", "   160\t            double sum = 0.0;\r\n   161\t            for (int k = M->row_ptr[i]; k < M->row_ptr[i+1]; k++) {\r\n   162\t                int j = M->col_indices[k];\r\n   163\t                if (j != i) sum += M->values[k] * z[j];\r\n   164\t            }\r\n   165\t            z[i] = (1.0 - P->omega) * z[i] + (P->omega / diag) * (r[i] - sum);\r\n   166\t        }\r\n   167\t        for (int i = n - 1; i >= 0; i--) {\r\n   168\t            double diag = P->diag[i];\r\n   169\t            if (fabs(diag) < 1e-15) return -1;\r\n"]
[7876.981515, "o", "   170\t            double sum = 0.0;\r\n   171\t            for (int k = M->row_ptr[i]; k < M->row_ptr[i+1]; k++) {\r\n   172\t                int j = M->col_indices[k];\r\n   173\t                if (j != i) sum += M->values[k] * z[j];\r\n   174\t            }\r\n   175\t            z[i] = (1.0 - P->omega) * z[i] + (P->omega / diag) * (r[i] - sum);\r\n   176\t        }\r\n   177\t        return 0;\r\n   178\t    }\r\n   179\t\r\n   180\t    default:\r\n"]
[7876.981587, "o", "   181\t        vec_copy(r, z, n);\r\n   182\t        return 0;\r\n   183\t    }\r\n   184\t}\r\n"]
