[2150.220635, "o", "     6\ttypedef enum {\r\n     7\t    POISSON_DIRICHLET,\r\n     8\t    POISSON_NEUMANN\r\n     9\t} PoissonBCType;\r\n    10\t\r\n    11\ttypedef struct {\r\n    12\t    PoissonBCType type;\r\n    13\t    const char *file;\r\n    14\t} PoissonBC;\r\n    15\t\r\n    16\tint poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n    17\t                    const char *source_file, PoissonBC left, PoissonBC right,\r\n    18\t                    PoissonBC bottom, PoissonBC top,\r\n    19\t                    CSRMatrix **A_out, double **b_out);\r\n    20\t\r\n"]
