[4012.743361, "o", "\u001b[?2004h> "]
[4012.743739, "o", "        free(left_vals); free(right_vals); free(bottom_vals); free(top_vals);\r\n\u001b[?2004l\r"]
[4012.743782, "o", "\u001b[?2004h> "]
