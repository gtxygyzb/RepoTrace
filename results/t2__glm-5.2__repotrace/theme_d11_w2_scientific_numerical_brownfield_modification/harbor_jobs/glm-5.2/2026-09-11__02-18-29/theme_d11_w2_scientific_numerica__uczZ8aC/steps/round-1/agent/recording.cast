[7945.763517, "o", "\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n"]
[7945.763597, "o", "\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fprintf(stderr, \"  %s heat --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --alpha <float> --dt <float> --nsteps <int> --scheme <backward-euler|crank-nicolson> --ic <file> --source <file>[,<file>,...] --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file>\\n\", prog);\r\n\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fprintf(stderr, \"  %s convdiff --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --kappa <float> --vx <float> --vy <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-o"]
