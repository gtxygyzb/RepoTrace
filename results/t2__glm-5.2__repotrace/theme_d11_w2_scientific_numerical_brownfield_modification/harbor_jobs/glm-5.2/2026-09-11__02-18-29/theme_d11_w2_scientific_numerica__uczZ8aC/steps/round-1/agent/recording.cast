[951.231077, "o", "   304\t\r\n   305\t    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n   306\t        fprintf(stderr, \"Error: invalid poisson parameters\\n\");\r\n   307\t        return 1;\r\n   308\t    }\r\n   309\t\r\n   310\t    PoissonBC left, right, bottom, top;\r\n   311\t    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n   312\t        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n"]
