[7829.67038, "i", "sed -n '420,760p' src/main.c\n"]
[7829.670662, "o", "sed -n '420,760p' src/main.c\r\n\u001b[?2004l\r"]
[7829.673842, "o", "    const char *output = get_opt(argc, argv, \"--output\");\r\n    const char *history = get_opt(argc, argv, \"--history\");\r\n\r\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !kappa_s ||\r\n        !vx_s || !vy_s || !source ||\r\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n        !solver || !precond || !tol_s || !maxiter_s || !output) {\r\n        fprintf(stderr, \"Error: convdiff requires grid, domain, kappa, vx, vy, source, boundary conditions, solver, precond, tol, maxiter, output\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n"]
[7829.674024, "o", "\r\n    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n    double kappa = atof(kappa_s);\r\n    double vx = atof(vx_s);\r\n    double vy = atof(vy_s);\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || kappa <= 0.0 ||\r\n        tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid convdiff parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n      "]
[7829.674176, "o", "  return 1;\r\n    }\r\n\r\n    double hx = (x1 - x0) / (nx - 1);\r\n    double hy = (y1 - y0) / (ny - 1);\r\n    double pe = convdiff_peclet(vx, vy, hx, hy, kappa);\r\n    if (pe > 1.0) {\r\n        fprintf(stderr, \"warning: cell Peclet number %.6e > 1, solution may exhibit oscillations\\n\", pe);\r\n    }\r\n\r\n    CSRMatrix *A = NULL;\r\n    double *b = NULL;\r\n    if (convdiff_assemble(nx, ny, x0, x1, y0, y1, kappa, vx, vy,\r\n                          source, left, right, bottom, top, &A, &b) != 0) {\r\n        fprintf(stderr, \"Error: cannot assemble convdiff system\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n    printf(\"peclet: %.6e\\n\", pe);\r\n\r\n    free(b);\r\n    csr_destroy(A);\r\n    return rc;\r\n}\r\n\r\nint main(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        usage(argv[0]);\r\n        return 1;\r\n    }\r\n\r\n    const char *cmd = argv[1];\r\n\r\n    if (strcmp(cmd, \"dense-solve\") == 0) {\r\n        return cmd_dense_solve(argc - 2, argv + 2);\r\n"]
[7829.674268, "o", "    } else if (strcmp(cmd, \"sparse-solve\") == 0) {\r\n        return cmd_sparse_solve(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"poisson\") == 0) {\r\n        return cmd_poisson(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"heat\") == 0) {\r\n        return cmd_heat(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"convdiff\") == 0) {\r\n        return cmd_convdiff(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"--help\") == 0 || strcmp(cmd, \"-h\") == 0) {\r\n        usage(argv[0]);\r\n        return 0;\r\n    } else {\r\n        fprintf(stderr, \"Error: unknown command '%s'\\n\", cmd);\r\n        usage(argv[0]);\r\n        return 1;\r\n    }\r\n}\r\n"]
