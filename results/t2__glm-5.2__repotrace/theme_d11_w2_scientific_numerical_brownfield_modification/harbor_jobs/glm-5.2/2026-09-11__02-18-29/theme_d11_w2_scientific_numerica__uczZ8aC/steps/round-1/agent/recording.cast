[2186.489019, "o", "    int    cols;\r\n     9\t    int    nnz;\r\n    10\t    double *values;\r\n    11\t    int    *col_indices;\r\n    12\t    int    *row_ptr;\r\n    13\t} CSRMatrix;\r\n    14\t\r\n    15\ttypedef struct {\r\n    16\t    int    rows;\r\n    17\t    int    cols;\r\n    18\t    int    nnz;\r\n    19\t    double *values;\r\n    20\t    int    *row;\r\n    21\t    int    *col;\r\n    22\t} COOMatrix;\r\n    23\t\r\n    24\t/* Lifecycle */\r\n    25\tCSRMatrix  *csr_create(int rows, int cols, int nnz);\r\n    26\tvoid        csr_destroy(CSRMatrix *A);\r\n"]
