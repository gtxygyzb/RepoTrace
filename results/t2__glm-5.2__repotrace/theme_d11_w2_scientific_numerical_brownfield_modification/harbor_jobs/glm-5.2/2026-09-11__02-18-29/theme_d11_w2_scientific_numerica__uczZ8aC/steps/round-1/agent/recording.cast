[1145.642804, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.64286, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.642927, "o", "    int n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.643041, "o", "    double *b = vec_read_mm_array(rhs_file, &n);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.643097, "o", "    if (!b) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.643269, "o", "        fprintf(stderr, \"Error: cannot read RHS from '%s'\\n\", rhs_file);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.643343, "o", "        csr_destroy(A);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.643405, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.643462, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.64357, "o", "    if (A->rows != n || A->cols != n) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.643741, "o", "        fprintf(stderr, \"Error: dimension mismatch A(%d,%d) vs b(%d)\\n\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.643844, "o", "                A->rows, A->cols, n);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.643906, "o", "        free(b);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.643984, "o", "        csr_destroy(A);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.644047, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.644102, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.644342, "o", "    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.6444, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     free(b);\r\n\u001b[?2004l\r"]
[1145.644456, "o", "\u001b[?2004h> "]
[1145.644512, "o", "    csr_destroy(A);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.644573, "o", "    return rc;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1145.644628, "o", "\u001b[?2004h> "]
