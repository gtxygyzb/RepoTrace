[5655.771245, "o", "   105\t            int is_left = (i == 0);\r\n   106\t            int is_right = (i == nx - 1);\r\n   107\t            int is_bottom = (j == 0);\r\n   108\t            int is_top = (j == ny - 1);\r\n   109\t\r\n   110\t            if (is_left && left.type == POISSON_DIRICHLET) {\r\n   111\t                add_coo(coo, &k, idx, idx, 1.0);\r\n   112\t                b[idx] = left_vals[j];\r\n   113\t                continue;\r\n   114\t            }\r\n   115\t            if (is_right && right.type == POISSON_DIRICHLET) {\r\n   116\t                add_coo(coo, &k, idx, idx, 1.0);\r\n   117\t                b[idx] = right_vals[j];\r\n   118\t                continue;\r\n   119"]
