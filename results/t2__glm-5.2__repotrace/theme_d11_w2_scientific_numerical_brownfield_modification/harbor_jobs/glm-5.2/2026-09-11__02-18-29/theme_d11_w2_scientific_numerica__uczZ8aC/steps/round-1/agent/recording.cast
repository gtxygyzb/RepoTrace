[7268.378481, "o", "   111\t    *b = -s * (*a) + c * (*b);\r\n   112\t    *a = t;\r\n   113\t}\r\n   114\t\r\n   115\tstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n   116\t{\r\n   117\t    if (kdim <= 0) return -1;\r\n   118\t\r\n"]
