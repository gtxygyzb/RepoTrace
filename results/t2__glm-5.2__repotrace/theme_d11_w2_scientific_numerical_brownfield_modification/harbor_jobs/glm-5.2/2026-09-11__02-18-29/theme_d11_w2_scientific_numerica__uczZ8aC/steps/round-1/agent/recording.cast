[7868.829428, "o", "     1\t#ifndef PRECOND_H\r\n     2\t#define PRECOND_H\r\n     3\t\r\n     4\t#include \"sparse.h\"\r\n     5\t\r\n     6\ttypedef enum {\r\n"]
[7868.829526, "o", "     7\t    PRECOND_NONE,\r\n     8\t    PRECOND_JACOBI,\r\n     9\t    PRECOND_ILU0,\r\n    10\t    PRECOND_SSOR\r\n    11\t} PrecondType;\r\n    12\t\r\n    13\ttypedef struct {\r\n    14\t    PrecondType type;\r\n    15\t    int n;\r\n    16\t    double omega;\r\n    17\t    double *diag;       /* Jacobi and SSOR */\r\n    18\t    CSRMatrix *lu;      /* ILU(0) factors in one CSR pattern */\r\n    19\t    const CSRMatrix *ssor_A;\r\n    20\t} Precond;\r\n    21\t\r\n    22\tPrecond *precond_create(const CSRMatrix *A, const char *name, double omega);"]
[7868.829601, "o", "\r\n    23\tvoid     precond_destroy(Precond *P);\r\n    24\tint      precond_apply(Precond *P, const CSRMatrix *A, const double *r, double *z);\r\n    25\t\r\n    26\t#endif /* PRECOND_H */\r\n"]
[7868.830005, "o", "\u001b[?2004h"]
