[9722.655317, "o", "\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"  %s sparse-solve --\u001b[01;31m\u001b[Kinput\u001b[m\u001b[K <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"  %s eigenvalue --\u001b[01;31m\u001b[Kinput\u001b[m\u001b[K <mtx_file> --method <power|inverse|shifted-inverse> [--shift <sigma>] --tol <value> --maxiter <int> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> [--restart <m>] [--ssor-omega <value>] [--solver-tol <value>] [--solver-maxiter <int>] [--eigvec-output <file>]\\n\", prog);\r\n\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(argv[i], name) == 0) return argv[i+1];\r\n"]
[9722.655437, "o", "\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int \u001b[01;31m\u001b[Kcmd\u001b[m\u001b[K_dense_solve(int argc, char **argv)\r\n\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(type, \"dirichlet\") == 0) bc->type = POISSON_DIRICHLET;\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    else if (\u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(type, \"neumann\") == 0) bc->type = POISSON_NEUMANN;\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(solver, \"cg\") == 0) {\r\n\u001b[32m\u001b[K166\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else if (\u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(solver, \"gmres\") == 0) {\r\n"]
[9722.655541, "o", "\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int \u001b[01;31m\u001b[Kcmd\u001b[m\u001b[K_sparse_solve(int argc, char **argv)\r\n\u001b[32m\u001b[K196\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const char *\u001b[01;31m\u001b[Kinput\u001b[m\u001b[K = get_opt(argc, argv, \"--\u001b[01;31m\u001b[Kinput\u001b[m\u001b[K\");\r\n"]
[9722.655643, "o", "\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!\u001b[01;31m\u001b[Kinput\u001b[m\u001b[K || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {\r\n\u001b[32m\u001b[K208\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fprintf(stderr, \"Error: sparse-solve requires --\u001b[01;31m\u001b[Kinput\u001b[m\u001b[K, --rhs, --solver, --precond, --tol, --maxiter\\n\");\r\n\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kusage\u001b[m\u001b[K(\"numsim\");\r\n\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CSRMatrix *A = csr_read_mm(\u001b[01;31m\u001b[Kinput\u001b[m\u001b[K);\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fprintf(stderr, \"Error: cannot read sparse matrix from '%s'\\n\", \u001b[01;31m\u001b[Kinput\u001b[m\u001b[K);\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int \u001b[01;31m\u001b[Kcmd\u001b[m\u001b[K_poisson(int argc, char **argv)\r\n\u001b[32m\u001b[K281\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kusage\u001b[m\u001b[K(\"numsim\");\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int \u001b[01;31m\u001b[Kcmd\u001b[m\u001b[K_heat(int argc, char **argv)\r\n\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kusage\u001b[m\u001b[K(\"numsim\");\r\n"]
[9722.655745, "o", "\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int \u001b[01;31m\u001b[Kcmd\u001b[m\u001b[K_convdiff(int argc, char **argv)\r\n\u001b[32m\u001b[K430\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kusage\u001b[m\u001b[K(\"numsim\");\r\n\u001b[32m\u001b[K490\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kusage\u001b[m\u001b[K(argv[0]);\r\n\u001b[32m\u001b[K494\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const char *\u001b[01;31m\u001b[Kcmd\u001b[m\u001b[K = argv[1];\r\n\u001b[32m\u001b[K496\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(\u001b[01;31m\u001b[Kcmd\u001b[m\u001b[K, \"dense-solve\") == 0) {\r\n\u001b[32m\u001b[K497\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        return \u001b[01;31m\u001b[Kcmd\u001b[m\u001b[K_dense_solve(argc - 2, argv + 2);\r\n\u001b[32m\u001b[K498\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else if (\u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(\u001b[01;31m\u001b[Kcmd\u001b[m\u001b[K, \"sparse-solve\") == 0) {\r\n"]
