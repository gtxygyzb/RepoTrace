[916.22162, "o", "typedef enum {\r\n\u001b[?2004l\r"]
[916.221693, "o", "\u001b[?2004h"]
[916.221766, "o", "> "]
[916.221837, "o", "    POISSON_DIRICHLET,\r\n\u001b[?2004l\r\u001b[?2004h"]
[916.221942, "o", "> "]
[916.222029, "o", "    POISSON_NEUMANN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[916.222139, "o", "} PoissonBCType;\r\n\u001b[?2004l\r"]
[916.222219, "o", "\u001b[?2004h> "]
[916.222311, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[916.222378, "o", "> "]
[916.222465, "o", "typedef struct {\r\n\u001b[?2004l\r\u001b[?2004h"]
[916.222497, "o", "> "]
[916.222634, "o", "    PoissonBCType type;\r\n\u001b[?2004l\r"]
[916.222754, "o", "\u001b[?2004h> "]
