[8074.28555, "o", "   136\t            s[i] = 0.0;\r\n   137\t        } else {\r\n   138\t            double r = hypot(a, b);\r\n   139\t            c[i] = a / r;\r\n   140\t            s[i] = b / r;\r\n   141\t        }\r\n   142\t        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n   143\t        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n   144\t\r\n   145\t    }\r\n   146\t\r\n   147\t    for (int i = kdim - 1; i >= 0; i--) {\r\n   148\t        double sum = g[i];\r\n   149\t        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n   150\t        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n   151\t        y[i] = sum / H[i*m+i];\r\n"]
[8074.285638, "o", "   152\t    }\r\n   153\t\r\n   154\t    free(c);\r\n   155\t    free(s);\r\n   156\t    return 0;\r\n   157\t}\r\n   158\t\r\n   159\tSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n"]
[8074.285714, "o", "   160\t                           double tol, int maxiter, int m, Precond *P)\r\n   161\t{\r\n   162\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n   163\t    int n = A->rows;\r\n   164\t    if (m <= 0) m = 30;\r\n   165\t    if (maxiter < 0) maxiter = 0;\r\n   166\t\r\n   167\t    SolveResult *res = result_create(n, maxiter);\r\n   168\t    if (!res) return NULL;\r\n   169\t\r\n   170\t    double *r = vec_create(n);\r\n   171\t    double *z = vec_create(n);\r\n   172\t    double *Ap = vec_create(n);\r\n   173\t    double *Av = vec_create(n);\r\n   174\t    double *w = vec_create(n);\r\n   175\t    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n   176\t    double *y = (double *)malloc(m * sizeof(double));\r\n   177\t    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n"]
[8074.285784, "o", "   178\t    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n   179\t\r\n   180\t    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n   181\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   182\t        solve_result_destroy(res);\r\n   183\t        return NULL;\r\n   184\t    }\r\n   185\t\r\n   186\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n   187"]
[8074.285848, "o", "\t\r\n   188\t    csr_spmv(A, res->x, Ap);\r\n   189\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   190\t\r\n   191\t    double bnorm = vec_norm2(b, n);\r\n   192\t    if (bnorm == 0.0) bnorm = 1.0;\r\n   193\t\r\n   194\t    res->true_residual = vec_norm2(r, n);\r\n   195\t    res->relres = res->true_residual / bnorm;\r\n"]
[8074.285933, "o", "   196\t    res->history[0] = res->relres;\r\n   197\t    res->precond_history[0] = res->true_residual;\r\n   198\t    res->history_len = 1;\r\n   199\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n   200\t    res->iterations = 0;\r\n   201\t    if (res->converged || maxiter == 0) {\r\n"]
[8074.285994, "o", "   202\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   203\t        return res;\r\n   204\t    }\r\n   205\t\r\n   206\t    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n   207\t        if (precond_apply(P, A, r, z) != 0) break;\r\n   208\t        double beta = vec_norm2(z, n);\r\n   209\t        if (beta == 0.0) break;\r\n   210\t\r\n   211\t        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n   212\t        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n   213\t        g[0] = beta;\r\n"]
[8074.286052, "o", "   214\t        memset(H, 0, (m + 1) * m * sizeof(double));\r\n   215\t\r\n   216\t        int kdim = 0;\r\n   217\t        int fail = 0;\r\n   218\t        for (int j = 0; j < m; j++) {\r\n   219\t            csr_spmv(A, V + j * n, Av);\r\n   220\t            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n   221\t\r\n"]
[8074.286114, "o", "   222\t            for (int i = 0; i <= j; i++) {\r\n   223\t                double h = vec_dot(w, V + i * n, n);\r\n   224\t                H[i*m+j] = h;\r\n   225\t                vec_axpy(-h, V + i * n, w, n);\r\n   226\t            }\r\n   227\t\r\n   228\t            double hnorm = vec_norm2(w, n);\r\n   229\t            H[(j+1)*m+j] = hnorm;\r\n   230\t            kdim = j + 1;\r\n"]
[8074.286173, "o", "   231\t\r\n   232\t            if (hnorm < 1e-14) break;\r\n   233\t\r\n   234\t            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n   235\t        }\r\n   236\t        if (fail) break;\r\n   237\t        if (kdim == 0) break;\r\n   238\t\r\n   239\t        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n"]
[8074.286231, "o", "   240\t        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n   241\t\r\n   242\t        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n   243\t\r\n   244\t        csr_spmv(A, res->x, Ap);\r\n   245\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   246\t\r\n"]
[8074.286294, "o", "   247\t        res->true_residual = vec_norm2(r, n);\r\n   248\t        res->relres = res->true_residual / bnorm;\r\n   249\t        res->history[cycle] = res->relres;\r\n   250\t        res->precond_history[cycle] = pznorm;\r\n   251\t        res->history_len = cycle + 1;\r\n   252\t        res->iterations = cycle;\r\n   253\t\r\n   254\t        if (res->relres < tol) {\r\n   255\t            res->converged = 1;\r\n   256\t            break;\r\n"]
[8074.28635, "o", "   257\t        }\r\n   258\t    }\r\n   259\t\r\n   260\t    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   261\t    return res;\r\n   262\t}\r\n   263\t\r\n   264\tvoid solve_result_destroy(SolveResult *res)\r\n"]
[8074.286407, "o", "   265\t{\r\n   266\t    if (!res) return;\r\n   267\t    free(res->x);\r\n   268\t    free(res->history);\r\n   269\t    free(res->precond_history);\r\n   270\t    free(res);\r\n   271\t}\r\n"]
