[9094.694218, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/eigen.c')\ns = p.read_text()\nold = '''    if (!isnan(eigenvalue)) {\n        csr_spmv(A, v, Av);\n        double vn = vec_norm2(v, n);\n        if (vn > 0.0) {\n            for (int i = 0; i < n; i++) v[i] /= vn;\n            for (int i = 0; i < n; i++) Av[i] /= vn;\n        }\n    }\n\n    printf(\"method: %s\\\\n\", method_s);\n    printf(\"converged: %s\\\\n\", converged ? \"yes\" : \"no\");\n    printf(\"iterations: %d\\\\n\", iterations);\n    printf(\"eigenvalue: %.15e\\\\n\", eigenvalue);\n    if (method == 2) {\n        printf(\"shift: %.15e\\\\n\", sigma);\n    }\n\n    double resnorm = NAN;\n    if (!isnan(eigenvalue)) {\n        csr_spmv(A, v, Av);\n        double lambda = eigenvalue;\n        for (int i = 0; i < n; i++) w[i] = Av[i] - lambda * v[i];\n        double num = vec_norm2(w, n);\n        double vn = vec_norm2(v, n);\n        if (fabs(lambda) == 0.0) {\n            resnorm = INFINITY;\n        } else if (vn > 0.0) {\n            resnorm = num / (fabs(lambda) * vn);\n        } else {\n   "]
