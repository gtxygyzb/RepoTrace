[915.943446, "o", "static SolveResult *result_create(int n, int maxiter)\r\n\u001b[?2004l\r"]
[915.943516, "o", "\u001b[?2004h> {"]
[915.943588, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.943846, "o", "    if (maxiter < 0) maxiter = 0;\r\n\u001b[?2004l\r"]
[915.943934, "o", "\u001b[?2004h> "]
[915.944392, "o", "    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n\u001b[?2004l\r"]
[915.94446, "o", "\u001b[?2004h> "]
[915.944645, "o", "    if (!res) return NULL;\r\n\u001b[?2004l\r"]
[915.944714, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.944785, "o", "\u001b[?2004h> "]
[915.944972, "o", "    res->x = vec_create(n);\r\n\u001b[?2004l\r"]
[915.945035, "o", "\u001b[?2004h> "]
[915.945482, "o", "    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n\u001b[?2004l\r"]
[915.94555, "o", "\u001b[?2004h> "]
[915.945801, "o", "    if (!res->x || !res->history) {\r\n\u001b[?2004l\r"]
[915.94586, "o", "\u001b[?2004h> "]
[915.946028, "o", "        free(res->x);\r\n\u001b[?2004l\r"]
[915.94609, "o", "\u001b[?2004h> "]
[915.94628, "o", "        free(res->history);\r\n\u001b[?2004l\r"]
[915.946343, "o", "\u001b[?2004h> "]
[915.94647, "o", "        free(res);\r\n\u001b[?2004l\r"]
[915.946533, "o", "\u001b[?2004h> "]
[915.946674, "o", "        return NULL;\r\n\u001b[?2004l\r"]
[915.946738, "o", "\u001b[?2004h> "]
[915.946812, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.946899, "o", "> "]
[915.947025, "o", "    res->history_len = 0;\r\n\u001b[?2004l\r"]
[915.947084, "o", "\u001b[?2004h> "]
[915.947206, "o", "    return res;\r\n\u001b[?2004l\r"]
[915.947276, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[915.947346, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.947415, "o", "\u001b[?2004h> "]
[915.947924, "o", "SolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n\u001b[?2004l\r"]
[915.947991, "o", "\u001b[?2004h> "]
[915.948398, "o", "                      double tol, int maxiter, Precond *P)\r\n\u001b[?2004l\r"]
[915.948605, "o", "\u001b[?2004h> "]
[915.948689, "o", "{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.948902, "o", "    if (!A || !b || A->rows != A->cols) return NULL;\r\n\u001b[?2004l\r"]
[915.948969, "o", "\u001b[?2004h> "]
[915.949115, "o", "    int n = A->rows;\r\n\u001b[?2004l\r"]
[915.949171, "o", "\u001b[?2004h> "]
[915.949393, "o", "    if (maxiter < 0) maxiter = 0;\r\n\u001b[?2004l\r"]
[915.949453, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.949522, "o", "\u001b[?2004h> "]
[915.949845, "o", "    SolveResult *res = result_create(n, maxiter);\r\n\u001b[?2004l\r"]
[915.949909, "o", "\u001b[?2004h> "]
[915.9501, "o", "    if (!res) return NULL;\r\n\u001b[?2004l\r"]
[915.95016, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.95023, "o", "\u001b[?2004h> "]
[915.950424, "o", "    double *r = vec_create(n);\r\n\u001b[?2004l\r"]
[915.950492, "o", "\u001b[?2004h> "]
[915.950694, "o", "    double *z = vec_create(n);\r\n\u001b[?2004l\r"]
[915.950742, "o", "\u001b[?2004h"]
[915.950817, "o", "> "]
[915.950981, "o", "    double *p = vec_create(n);\r\n\u001b[?2004l\r"]
[915.951043, "o", "\u001b[?2004h> "]
[915.951262, "o", "    double *Ap = vec_create(n);\r\n\u001b[?2004l\r"]
[915.951316, "o", "\u001b[?2004h> "]
[915.951551, "o", "    if (!r || !z || !p || !Ap) {\r\n\u001b[?2004l\r"]
[915.951608, "o", "\u001b[?2004h> "]
[915.951927, "o", "        free(r); free(z); free(p); free(Ap);\r\n\u001b[?2004l\r"]
[915.951995, "o", "\u001b[?2004h> "]
[915.952224, "o", "        solve_result_destroy(res);\r\n\u001b[?2004l\r"]
[915.952286, "o", "\u001b[?2004h> "]
[915.952421, "o", "        return NULL;\r\n\u001b[?2004l\r"]
[915.952486, "o", "\u001b[?2004h> "]
[915.952558, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.95263, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[915.952704, "o", "> "]
[915.953067, "o", "    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\u001b[?2004l\r"]
[915.953127, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.953198, "o", "\u001b[?2004h> "]
[915.953346, "o", "    csr_spmv(A, res->x, Ap);\r\n\u001b[?2004l\r"]
[915.953406, "o", "\u001b[?2004h> "]
[915.953725, "o", "    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\u001b[?2004l\r"]
[915.953784, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.953864, "o", "\u001b[?2004h> "]
[915.954046, "o", "    double bnorm = vec_norm2(b, n);\r\n\u001b[?2004l\r"]
[915.954108, "o", "\u001b[?2004h> "]
[915.95431, "o", "    if (bnorm == 0.0) bnorm = 1.0;\r\n\u001b[?2004l\r"]
[915.95437, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rf"]
[915.954442, "o", "\u001b[?2004h> "]
[915.954681, "o", "    res->relres = vec_norm2(r, n) / bnorm;\r\n\u001b[?2004l\r"]
[915.954742, "o", "\u001b[?2004h> "]
[915.954947, "o", "    res->history[0] = res->relres;\r\n\u001b[?2004l\r"]
[915.955011, "o", "\u001b[?2004h> "]
[915.955152, "o", "    res->history_len = 1;\r\n\u001b[?2004l\r"]
[915.955212, "o", "\u001b[?2004h> "]
[915.955508, "o", "    res->converged = (res->relres < tol) ? 1 : 0;\r\n\u001b[?2004l\r"]
[915.955562, "o", "\u001b[?2004h> "]
[915.955704, "o", "    res->iterations = 0;\r\n\u001b[?2004l\r"]
[915.955761, "o", "\u001b[?2004h> "]
[915.956001, "o", "    if (res->converged || maxiter == 0) {\r\n\u001b[?2004l\r"]
[915.956063, "o", "\u001b[?2004h> "]
[915.956348, "o", "        free(r); free(z); free(p); free(Ap);\r\n\u001b[?2004l\r"]
[915.956406, "o", "\u001b[?2004h> "]
[915.95652, "o", "        return res;\r\n\u001b[?2004l\r"]
[915.95658, "o", "\u001b[?2004h> "]
[915.956653, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.956726, "o", "\u001b[?2004h> "]
[915.956973, "o", "    if (precond_apply(P, A, r, z) != 0) {\r\n\u001b[?2004l\r"]
[915.957031, "o", "\u001b[?2004h> "]
[915.957308, "o", "        free(r); free(z); free(p); free(Ap);\r\n\u001b[?2004l\r"]
[915.957365, "o", "\u001b[?2004h> "]
[915.957476, "o", "        return res;\r\n\u001b[?2004l\r"]
[915.95754, "o", "\u001b[?2004h> "]
[915.957612, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.957755, "o", "    vec_copy(z, p, n);\r\n\u001b[?2004l\r"]
[915.957839, "o", "\u001b[?2004h> "]
[915.958028, "o", "    double rz_old = vec_dot(r, z, n);\r\n\u001b[?2004l\r"]
[915.958112, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.958447, "o", "    for (int iter = 1; iter <= maxiter; iter++) {\r\n\u001b[?2004l\r"]
[915.958534, "o", "\u001b[?2004h> "]
[915.958652, "o", "        csr_spmv(A, p, Ap);\r\n\u001b[?2004l\r"]
[915.958729, "o", "\u001b[?2004h"]
[915.958817, "o", "> "]
[915.95893, "o", "        double pAp = vec_dot(p, Ap, n);\r\n\u001b[?2004l\r"]
[915.959014, "o", "\u001b[?2004h> "]
[915.959202, "o", "        if (fabs(pAp) < 1e-30) break;\r\n\u001b[?2004l\r"]
[915.959276, "o", "\u001b[?2004h"]
[915.959366, "o", "> \r\n\u001b[?2004l\r,\u001b[?2004h> "]
[915.959521, "o", "        double alpha = rz_old / pAp;\r\n\u001b[?2004l\r"]
[915.959604, "o", "\u001b[?2004h> "]
[915.959789, "o", "        vec_axpy(alpha, p, res->x, n);\r\n\u001b[?2004l\r"]
[915.959884, "o", "\u001b[?2004h> "]
[915.960062, "o", "        vec_axpy(-alpha, Ap, r, n);\r\n\u001b[?2004l\r"]
[915.960134, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.960231, "o", " \u001b[?2004h> "]
[915.960432, "o", "        res->relres = vec_norm2(r, n) / bnorm;\r\n\u001b[?2004l\r"]
[915.960512, "o", "\u001b[?2004h> "]
[915.96072, "o", "        res->history[iter] = res->relres;\r\n\u001b[?2004l\r"]
[915.960802, "o", "\u001b[?2004h> "]
[915.960988, "o", "        res->history_len = iter + 1;\r\n\u001b[?2004l\r"]
[915.961059, "o", "\u001b[?2004h> "]
[915.961233, "o", "        res->iterations = iter;\r\n\u001b[?2004l\r"]
[915.961325, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.961527, "o", "        if (res->relres < tol) {\r\n\u001b[?2004l\r"]
[915.961562, "o", "\u001b[?2004h> "]
[915.961753, "o", "            res->converged = 1;\r\n\u001b[?2004l\r"]
[915.961851, "o", "\u001b[?2004h> "]
[915.961957, "o", "            break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.962037, "o", "        }\r\n\u001b[?2004l\r"]
[915.962076, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.962172, "o", "\u001b[?2004h> "]
[915.962425, "o", "        if (precond_apply(P, A, r, z) != 0) break;\r\n\u001b[?2004l\r"]
[915.962511, "o", "\u001b[?2004h"]
[915.962598, "o", "> "]
[915.962693, "o", "        double rz_new = vec_dot(r, z, n);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.962865, "o", "        if (fabs(rz_old) < 1e-30) break;\r\n\u001b[?2004l\r"]
[915.962914, "o", "\u001b[?2004h> "]
[915.963081, "o", "        double beta = rz_new / rz_old;\r\n\u001b[?2004l\r"]
[915.963149, "o", "\u001b[?2004h> "]
[915.963249, "o", "        vec_scale(beta, p, n);\r\n\u001b[?2004l\r"]
[915.963315, "o", "\u001b[?2004h> "]
[915.963422, "o", "        vec_axpy(1.0, z, p, n);\r\n\u001b[?2004l\r"]
[915.963508, "o", "\u001b[?2004h> "]
[915.963591, "o", "        rz_old = rz_new;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.963676, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[915.963887, "o", "    free(r); free(z); free(p); free(Ap);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.963985, "o", "    return res;\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.964066, "o", "> }\r\n\u001b[?2004l\r"]
[915.964149, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.964379, "o", "static void apply_givens(double *a, double *b, double c, double s)\r\n\u001b[?2004l\r"]
[915.964461, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[915.964547, "o", "\u001b[?2004h> "]
[915.964634, "o", "    double t = c * (*a) + s * (*b);\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.964713, "o", "> "]
[915.964809, "o", "    *b = -s * (*a) + c * (*b);\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.964899, "o", "> "]
[915.964981, "o", "    *a = t;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[915.965051, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.965384, "o", "static int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n\u001b[?2004l\r"]
[915.965472, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.965584, "o", "    if (kdim <= 0) return -1;\r\n\u001b[?2004l\r"]
[915.965666, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[915.96591, "o", "    double *c = (double *)malloc(m * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.965992, "o", "> "]
[915.966169, "o", "    double *s = (double *)malloc(m * sizeof(double));\r\n\u001b[?2004l\r"]
[915.966247, "o", "\u001b[?2004h> "]
[915.966441, "o", "    if (!c || !s) { free(c); free(s); return -1; }\r\n\u001b[?2004l\r"]
[915.966512, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[915.966597, "o", "\u001b[?2004h> "]
[915.966689, "o", "    for (int i = 0; i < kdim; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.96689, "o", "        for (int k = 0; k < i; k++) {\r\n\u001b[?2004l\r"]
[915.966974, "o", "\u001b[?2004h> "]
[915.967201, "o", "            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n\u001b[?2004l\r"]
[915.967283, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[915.967364, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[915.967464, "o", "        double a = H[i*m+i];\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.96752, "o", "> "]
[915.967593, "o", "        double b = H[(i+1)*m+i];\r\n\u001b[?2004l\r"]
[915.967663, "o", "\u001b[?2004h> "]
[915.967763, "o", "        if (b == 0.0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.96786, "o", "            c[i] = 1.0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.967939, "o", "            s[i] = 0.0;\r\n\u001b[?2004l\r"]
[915.968009, "o", "\u001b[?2004h> "]
[915.968097, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.968193, "o", "            double r = hypot(a, b);\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.968264, "o", "> "]
[915.968344, "o", "            c[i] = a / r;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.968417, "o", "            s[i] = b / r;\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.968515, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.968704, "o", "        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n\u001b[?2004l\r"]
[915.968764, "o", "\u001b[?2004h> "]
[915.968904, "o", "        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n\u001b[?2004l\r"]
[915.968988, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.969115, "o", "        for (int j = i + 1; j < kdim; j++) {\r\n\u001b[?2004l\r"]
[915.969182, "o", "\u001b[?2004h> "]
[915.969353, "o", "            apply_givens(&H[i*m+j], &H[(i+1)*m+j], c[i], s[i]);\r\n\u001b[?2004l\r"]
[915.969439, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.969509, "o", "    }\r\n\u001b[?2004l\r"]
[915.969581, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.969688, "o", "    for (int i = kdim - 1; i >= 0; i--) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[915.969747, "o", "> "]
[915.969846, "o", "        double sum = g[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[915.970051, "o", "        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n\u001b[?2004l\r"]
[915.970078, "o", "\u001b[?2004h> "]
[916.020551, "o", "        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n\u001b[?2004l\r\u001b[?2004h>         y[i] = sum / H[i*m+i];\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     free(c);\r\n\u001b[?2004l\r\u001b[?2004h>     free(s);\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> SolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n\u001b[?2004l\r\u001b[?2004h>                          double tol, int maxiter, int m, Precond *P)\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h>     if (!A || !b || A->rows != A->cols) return NULL;\r\n\u001b[?2004l\r\u001b[?2004h>     int n = A->rows;\r\n\u001b[?2004l\r\u001b[?2004h>     if (m <= 0) m = 30;\r\n\u001b[?2004l\r\u001b[?2004h>     if (maxiter < 0) maxiter = 0;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     SolveResult *res = result_create(n, maxiter);\r\n\u001b[?2004l\r\u001b[?2004h>     if (!res) return NULL;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     double *r = vec_create(n);\r\n\u001b[?2004l\r\u001b[?2004h>     double *z = vec_create(n);\r\n\u001b[?2004l\r\u001b[?2004h>     double"]
[916.020616, "o", " *Ap = vec_create(n);\r\n\u001b[?2004l\r\u001b[?2004h>     double *Av = vec_create(n);\r\n\u001b[?2004l\r\u001b[?2004h>     double *w = vec_create(n);\r\n\u001b[?2004l\r\u001b[?2004h"]
[916.020673, "o", "> "]
[916.021001, "o", "    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n\u001b[?2004l\r"]
[916.021065, "o", "\u001b[?2004h> "]
[916.021355, "o", "    double *y = (double *)malloc(m * sizeof(double));\r\n\u001b[?2004l\r"]
[916.021433, "o", "\u001b[?2004h> "]
[916.021767, "o", "    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n\u001b[?2004l\r"]
[916.021842, "o", "\u001b[?2004h> "]
[916.022192, "o", "    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n\u001b[?2004l\r"]
[916.022272, "o", "\u001b[?2004h"]
[916.022349, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[916.022671, "o", "    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n\u001b[?2004l\r"]
[916.022739, "o", "\u001b[?2004h"]
[916.022814, "o", "> "]
[916.023239, "o", "        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n\u001b[?2004l\r"]
[916.023312, "o", "\u001b[?2004h"]
[916.023388, "o", "> "]
[916.023493, "o", "        solve_result_destroy(res);\r\n\u001b[?2004l\r"]
[916.023568, "o", "\u001b[?2004h> "]
[916.023668, "o", "        return NULL;\r\n\u001b[?2004l\r"]
[916.023744, "o", "\u001b[?2004h> "]
[916.02383, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[916.023913, "o", "\u001b[?2004h"]
[916.023987, "o", "> "]
[916.024236, "o", "    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\u001b[?2004l\r"]
[916.024313, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[916.024379, "o", "\u001b[?2004h> "]
[916.024516, "o", "    csr_spmv(A, res->x, Ap);\r\n\u001b[?2004l\r"]
[916.024591, "o", "\u001b[?2004h> "]
[916.024879, "o", "    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\u001b[?2004l\r"]
[916.024959, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[916.025033, "o", "> "]
[916.025196, "o", "    double bnorm = vec_norm2(b, n);\r\n\u001b[?2004l\r"]
[916.025271, "o", "\u001b[?2004h> "]
[916.02545, "o", "    if (bnorm == 0.0) bnorm = 1.0;\r\n\u001b[?2004l\r"]
[916.025535, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[916.025617, "o", "\u001b[?2004h> "]
[916.02582, "o", "    res->relres = vec_norm2(r, n) / bnorm;\r\n\u001b[?2004l\r"]
[916.025907, "o", "\u001b[?2004h> "]
[916.026088, "o", "    res->history[0] = res->relres;\r\n\u001b[?2004l\r"]
[916.026166, "o", "\u001b[?2004h> "]
[916.026296, "o", "    res->history_len = 1;\r\n\u001b[?2004l\r"]
[916.026371, "o", "\u001b[?2004h> "]
[916.026634, "o", "    res->converged = (res->relres < tol) ? 1 : 0;\r\n\u001b[?2004l\r"]
[916.02671, "o", "\u001b[?2004h> "]
[916.026832, "o", "    res->iterations = 0;\r\n\u001b[?2004l\r"]
[916.026926, "o", "\u001b[?2004h> "]
[916.027132, "o", "    if (res->converged || maxiter == 0) {\r\n\u001b[?2004l\r"]
[916.027207, "o", "\u001b[?2004h> "]
[916.027691, "o", "        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n\u001b[?2004l\r"]
[916.02777, "o", "\u001b[?2004h> "]
[916.027885, "o", "        return res;\r\n\u001b[?2004l\r"]
[916.027961, "o", "\u001b[?2004h> "]
[916.02805, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[916.028116, "o", "\u001b[?2004h> "]
[916.028386, "o", "    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n\u001b[?2004l\r"]
[916.028462, "o", "\u001b[?2004h> "]
[916.028727, "o", "        if (precond_apply(P, A, r, z) != 0) break;\r\n\u001b[?2004l\r"]
[916.028803, "o", "\u001b[?2004h> "]
[916.029014, "o", "        double beta = vec_norm2(z, n);\r\n\u001b[?2004l\r"]
[916.029088, "o", "\u001b[?2004h"]
[916.029157, "o", "> "]
[916.029258, "o", "        if (beta == 0.0) break;\r\n\u001b[?2004l\r"]
[916.029335, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[916.029416, "o", "> "]
[916.02968, "o", "        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n\u001b[?2004l\r"]
[916.029752, "o", "\u001b[?2004h"]
[916.029829, "o", "> "]
[916.03002, "o", "        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n\u001b[?2004l\r"]
[916.030097, "o", "\u001b[?2004h> "]
[916.030201, "o", "        g[0] = beta;\r\n\u001b[?2004l\r"]
[916.030273, "o", "\u001b[?2004h> "]
[916.030544, "o", "        memset(H, 0, (m + 1) * m * sizeof(double));\r\n\u001b[?2004l\r"]
[916.030609, "o", "\u001b[?2004h"]
[916.030653, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[916.030789, "o", "        int kdim = 0;\r\n\u001b[?2004l\r"]
[916.030875, "o", "\u001b[?2004h> "]
[916.030988, "o", "        int fail = 0;\r\n\u001b[?2004l\r"]
[916.031057, "o", "\u001b[?2004h"]
[916.03113, "o", "> "]
[916.031257, "o", "        for (int j = 0; j < m; j++) {\r\n\u001b[?2004l\r"]
[916.031335, "o", "\u001b[?2004h> "]
[916.031543, "o", "            csr_spmv(A, V + j * n, Av);\r\n\u001b[?2004l\r"]
[916.03162, "o", "\u001b[?2004h> "]
[916.032, "o", "            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n\u001b[?2004l\r"]
[916.032074, "o", "\u001b[?2004h"]
[916.032157, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[916.032358, "o", "            for (int i = 0; i <= j; i++) {\r\n\u001b[?2004l\r"]
[916.032428, "o", "\u001b[?2004h"]
[916.032515, "o", "> "]
[916.032713, "o", "                double h = vec_dot(w, V + i * n, n);\r\n\u001b[?2004l\r"]
[916.032784, "o", "\u001b[?2004h> "]
[916.032946, "o", "                H[i*m+j] = h;\r\n\u001b[?2004l\r"]
[916.032973, "o", "\u001b[?2004h"]
[916.033049, "o", "> "]
[916.033264, "o", "                vec_axpy(-h, V + i * n, w, n);\r\n\u001b[?2004l\r"]
[916.033341, "o", "\u001b[?2004h> "]
[916.033409, "o", "            }\r\n\u001b[?2004l\r"]
[916.033488, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[916.033563, "o", "\u001b[?2004h> "]
[916.033762, "o", "            double hnorm = vec_norm2(w, n);\r\n\u001b[?2004l\r"]
[916.033839, "o", "\u001b[?2004h> "]
[916.034021, "o", "            H[(j+1)*m+j] = hnorm;\r\n\u001b[?2004l\r"]
[916.034087, "o", "\u001b[?2004h> "]
[916.034226, "o", "            kdim = j + 1;\r\n\u001b[?2004l\r"]
[916.034302, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[916.034367, "o", "\u001b[?2004h> "]
[916.034555, "o", "            if (hnorm < 1e-14) break;\r\n\u001b[?2004l\r"]
[916.034628, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[916.034696, "o", "\u001b[?2004h> "]
[916.035065, "o", "            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n\u001b[?2004l\r"]
[916.035138, "o", "\u001b[?2004h> "]
[916.035208, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[916.035289, "o", "> "]
[916.035386, "o", "        if (fail) break;\r\n\u001b[?2004l\r"]
[916.035461, "o", "\u001b[?2004h> "]
[916.035568, "o", "        if (kdim == 0) break;\r\n\u001b[?2004l\r"]
[916.035638, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[916.035708, "o", "\u001b[?2004h> "]
[916.035858, "o", "        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n\u001b[?2004l\r"]
[916.035934, "o", "\u001b[?2004h> "]
[916.036164, "o", "        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n\u001b[?2004l\r"]
[916.036254, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[916.03656, "o", "        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n\u001b[?2004l\r"]
[916.036652, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[916.036785, "o", "        csr_spmv(A, res->x, Ap);\r\n\u001b[?2004l\r"]
[916.036852, "o", "\u001b[?2004h> "]
[916.037066, "o", "        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\u001b[?2004l\r"]
[916.037163, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[916.037343, "o", "        res->relres = vec_norm2(r, n) / bnorm;\r\n\u001b[?2004l\r"]
[916.03741, "o", "\u001b[?2004h"]
[916.037452, "o", "> "]
[916.03756, "o", "        res->history[cycle] = res->relres;\r\n\u001b[?2004l\r"]
[916.037637, "o", "\u001b[?2004h> "]
[916.037757, "o", "        res->history_len = cycle + 1;\r\n\u001b[?2004l\r"]
[916.037827, "o", "\u001b[?2004h> "]
[916.037945, "o", "        res->iterations = cycle;\r\n\u001b[?2004l\r"]
[916.038028, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[916.038161, "o", "        if (res->relres < tol) {\r\n\u001b[?2004l\r"]
[916.038231, "o", "\u001b[?2004h> "]
[916.038335, "o", "            res->converged = 1;\r\n\u001b[?2004l\r"]
[916.038409, "o", "\u001b[?2004h> "]
[916.038499, "o", "            break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[916.038573, "o", "        }\r\n\u001b[?2004l\r"]
[916.038675, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[916.039049, "o", "    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n\u001b[?2004l\r"]
[916.039119, "o", "\u001b[?2004h> "]
[916.039215, "o", "    return res;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[916.039312, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[916.039478, "o", "void solve_result_destroy(SolveResult *res)\r\n\u001b[?2004l\r"]
[916.039545, "o", "\u001b[?2004h> {\r\n"]
[916.039611, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[916.039713, "o", "    if (!res) return;\r\n\u001b[?2004l\r"]
[916.039819, "o", "\u001b[?2004h>     free(res->x);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[916.03994, "o", "    free(res->history);\r\n\u001b[?2004l\r"]
[916.040016, "o", "\u001b[?2004h> "]
[916.040093, "o", "    free(res);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[916.040169, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[916.043189, "o", "\u001b[?2004hroot@n30009:/app# "]
[916.220474, "i", "cat > include/poisson.h <<'EOF'\n#ifndef POISSON_H\n#define POISSON_H\n\n#include \"sparse.h\"\n\ntypedef enum {\n    POISSON_DIRICHLET,\n    POISSON_NEUMANN\n} PoissonBCType;\n\ntypedef struct {\n    PoissonBCType type;\n    const char *file;\n} PoissonBC;\n\nint poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\n                    const char *source_file, PoissonBC left, PoissonBC right,\n                    PoissonBC bottom, PoissonBC top,\n                    CSRMatrix **A_out, double **b_out);\n\ndouble *poisson_read_source(const char *filename, int nx, int ny);\ndouble *poisson_read_boundary(const char *filename, int expected);\n\n#endif /* POISSON_H */\nEOF\n"]
[916.220768, "o", "cat > include/poisson.h <<'EOF'\r\n\u001b[?2004l\r"]
[916.220897, "o", "\u001b[?2004h"]
[916.220996, "o", "> "]
