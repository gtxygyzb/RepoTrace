[9694.50737, "o", "    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n    const char *source = get_opt(argc, argv, \"--source\");\r\n    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n"]
[9694.507438, "o", "    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n    const char *history = get_opt(argc, argv, \"--history\");\r\n\r\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||\r\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n"]
[9694.507568, "o", "        !solver || !precond || !tol_s || !maxiter_s) {\r\n        fprintf(stderr, \"Error: poisson requires grid, source, boundary condition, solver, precond, tol, maxiter\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n\r\n    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n"]
[9694.507641, "o", "    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid poisson parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n"]
[9694.507711, "o", "    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    CSRMatrix *A = NULL;\r\n    double *b = NULL;\r\n    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {\r\n        fprintf(stderr, \"Error: cannot assemble Poisson system\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\r\n    free(b);\r\n    csr_destroy(A);\r\n"]
[9694.507779, "o", "    return rc;\r\n}\r\n\r\nstatic int cmd_heat(int argc, char **argv)\r\n{\r\n    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n    const char *alpha_s = get_opt(argc, argv, \"--alpha\");\r\n"]
[9694.507854, "o", "    const char *dt_s = get_opt(argc, argv, \"--dt\");\r\n    const char *nsteps_s = get_opt(argc, argv, \"--nsteps\");\r\n    const char *scheme = get_opt(argc, argv, \"--scheme\");\r\n    const char *ic_file = get_opt(argc, argv, \"--ic\");\r\n    const char *source_arg = get_opt(argc, argv, \"--source\");\r\n    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n"]
[9694.507926, "o", "    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n\r\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !alpha_s ||\r\n        !dt_s || !nsteps_s || !scheme || !ic_file || !source_arg ||\r\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n        !solver || !precond || !tol_s || !maxiter_s || !output) {\r\n        fprintf(stderr, \"Error: heat requires grid, domain, alpha, dt, nsteps, scheme, ic, source, boundary conditions, solver, precond, tol, maxiter, output\\n\");\r\n        usage(\"numsim\");\r\n        return 1;"]
[9694.508013, "o", "\r\n    }\r\n\r\n    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n    double alpha = atof(alpha_s);\r\n    double dt = atof(dt_s);\r\n    int nsteps = atoi(nsteps_s);\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n"]
[9694.508106, "o", "    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || alpha <= 0.0 ||\r\n        dt <= 0.0 || nsteps < 0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid heat parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n"]
[9694.508142, "o", "    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int rc = heat_solve(nx, ny, x0, x1, y0, y1, alpha, dt, nsteps, scheme,\r\n                       ic_file, source_arg, left, right, bottom, top,\r\n                       solver, precond, tol, maxiter, restart, omega, output);\r\n    if (rc != 0) {\r\n        fprintf(stderr, \"Error: heat solve failed\\n\");\r\n        return 1;\r\n    }\r\n"]
[9694.508222, "o", "    return 0;\r\n}\r\n\r\nstatic int cmd_convdiff(int argc, char **argv)\r\n{\r\n"]
[9694.508307, "o", "    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n    const char *kappa_s = get_opt(argc, argv, \"--kappa\");\r\n    const char *vx_s = get_opt(argc, argv, \"--vx\");\r\n"]
[9694.50839, "o", "    const char *vy_s = get_opt(argc, argv, \"--vy\");\r\n    const char *source = get_opt(argc, argv, \"--source\");\r\n    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n    const char *history = get_opt(argc, argv, \"--history\");\r\n\r\n"]
[9694.50847, "o", "    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !kappa_s ||\r\n        !vx_s || !vy_s || !source ||\r\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n        !solver || !precond || !tol_s || !maxiter_s || !output) {\r\n        fprintf(stderr, \"Error: convdiff requires grid, domain, kappa, vx, vy, source, boundary conditions, solver, precond, tol, maxiter, output\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n\r\n    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n"]
[9694.508568, "o", "    double kappa = atof(kappa_s);\r\n    double vx = atof(vx_s);\r\n    double vy = atof(vy_s);\r\n    double tol = atof(tol_s);\r\n    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || kappa <= 0.0 ||\r\n"]
[9694.508629, "o", "        tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid convdiff parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n"]
[9694.508729, "o", "        return 1;\r\n    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    double hx = (x1 - x0) / (nx - 1);\r\n    double hy = (y1 - y0) / (ny - 1);\r\n    double pe = convdiff_peclet(vx, vy, hx, hy, kappa);\r\n"]
[9694.508793, "o", "    if (pe > 1.0) {\r\n        fprintf(stderr, \"warning: cell Peclet number %.6e > 1, solution may exhibit oscillations\\n\", pe);\r\n    }\r\n\r\n    CSRMatrix *A = NULL;\r\n    double *b = NULL;\r\n    if (convdiff_assemble(nx, ny, x0, x1, y0, y1, kappa, vx, vy,\r\n                          source, left, right, bottom, top, &A, &b) != 0) {\r\n        fprintf(stderr, \"Error: cannot assemble convdiff system\\n\");\r\n        return 1;\r\n    }\r\n\r\n"]
[9694.508858, "o", "    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n    printf(\"peclet: %.6e\\n\", pe);\r\n\r\n    free(b);\r\n    csr_destroy(A);\r\n    return rc;\r\n}\r\n"]
[9694.508928, "o", "\r\nint main(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        usage(argv[0]);\r\n        return 1;\r\n    }\r\n\r\n    const char *cmd = argv[1];\r\n\r\n    if (strcmp(cmd, \"dense-solve\") == 0) {\r\n        return cmd_dense_solve(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"sparse-solve\") == 0) {\r\n        return cmd_sparse_solve(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"poisson\") == 0) {\r\n        return cmd_poisson(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"heat\") == 0) {\r\n        return cmd_heat(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"convdiff\") == 0) {\r\n        return cmd_convdiff(argc - 2, argv + 2);\r\n"]
[9694.509037, "o", "    } else if (strcmp(cmd, \"--help\") == 0 || strcmp(cmd, \"-h\") == 0) {\r\n        usage(argv[0]);\r\n        return 0;\r\n    } else if (strcmp(cmd, \"eigenvalue\") == 0) {\r\n        return cmd_eigenvalue(argc - 2, argv + 2);\r\n    } else {\r\n        fprintf(stderr, \"Error: unknown command '%s'\\n\", cmd);\r\n        usage(argv[0]);\r\n        return 1;\r\n    }\r\n}\r\n"]
[9694.509542, "o", "\u001b[?2004h"]
[9694.509602, "o", "root@n30009:/app# "]
[9694.786783, "i", "sed -n '1,260p' src/io.c\n"]
[9694.787043, "o", "sed -n '1,260p' src/io.c\r\n\u001b[?2004l\r"]
[9694.789714, "o", "#include \"io.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nDenseMatrix *dm_read_text(const char *filename)\r\n"]
[9694.789804, "o", "{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    int rows, cols;\r\n    if (fscanf(fp, \"%d %d\", &rows, &cols) != 2) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    DenseMatrix *m = dm_create(rows, cols);\r\n    if (!m) { fclose(fp); return NULL; }\r\n\r\n    int i, j;\r\n    for (i = 0; i < rows; i++)\r\n        for (j = 0; j < cols; j++)\r\n"]
[9694.789892, "o", "            if (fscanf(fp, \"%lf\", &m->data[i * cols + j]) != 1) {\r\n                dm_destroy(m);\r\n                fclose(fp);\r\n                return NULL;\r\n            }\r\n\r\n    fclose(fp);\r\n    return m;\r\n}\r\n\r\nint dm_write_text(const DenseMatrix *m, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    dm_print(m, fp);\r\n"]
[9694.789952, "o", "    fclose(fp);\r\n    return 0;\r\n}\r\n\r\ndouble *vec_read_text(const char *filename, int *n_out)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n"]
[9694.790011, "o", "    int n;\r\n    if (fscanf(fp, \"%d\", &n) != 1 || n <= 0) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    double *x = vec_create(n);\r\n    if (!x) { fclose(fp); return NULL; }\r\n\r\n    int i;\r\n    for (i = 0; i < n; i++)\r\n        if (fscanf(fp, \"%lf\", &x[i]) != 1) {\r\n            free(x);\r\n            fclose(fp);\r\n"]
[9694.790078, "o", "            return NULL;\r\n        }\r\n\r\n    fclose(fp);\r\n    *n_out = n;\r\n    return x;\r\n}\r\n\r\nint vec_write_text(const double *x, int n, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    fprintf(fp, \"%d\\n\", n);\r\n"]
[9694.790135, "o", "    vec_print(x, n, fp);\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n"]
[9694.790497, "o", "\u001b[?2004hroot@n30009:/app# "]
[9695.058532, "i", "sed -n '1,220p' include/io.h\n"]
