[2267.470222, "o", "cat include/poisson.h\r\n\u001b[?2004l\r"]
[2267.472568, "o", "#ifndef POISSON_H\r\n#define POISSON_H\r\n\r\n#include \"sparse.h\"\r\n\r\ntypedef enum {\r\n    POISSON_DIRICHLET,\r\n    POISSON_NEUMANN\r\n} PoissonBCType;\r\n\r\ntypedef struct {\r\n    PoissonBCType type;\r\n    const char *file;\r\n} PoissonBC;\r\n\r\nint poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n                    const char *source_file, PoissonBC left, PoissonBC right,\r\n                    PoissonBC bottom, PoissonBC top,\r\n                    CSRMatrix **A_out, double **b_out);\r\n\r\ndouble *poisson_read_source(const char *filename, int nx, int ny);\r\ndouble *poisson_read_boundary(const char *filename, int expected);\r\n\r\n#endif /* POISSON_H */\r\n"]
[2267.473084, "o", "\u001b[?2004hroot@n30009:/app# "]
[2267.741384, "i", "head -n 80 src/poisson.c\n"]
[2267.741695, "o", "head -n 80 src/poisson.c\r\n"]
[2267.741819, "o", "\u001b[?2004l\r"]
[2267.744134, "o", "#include \"poisson.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n\r\ndouble *poisson_read_source(const char *filename, int nx, int ny)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    int rx, ry;\r\n    if (fscanf(fp, \"%d %d\", &rx, &ry) != 2 || rx != nx || ry != ny) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    int n = nx * ny;\r\n    double *f = vec_create(n);\r\n    if (!f) { fclose(fp); return NULL; }\r\n\r\n    for (int i = 0; i < n; i++) {\r\n        if (fscanf(fp, \"%lf\", &f[i]) != 1) {\r\n            free(f);\r\n            fclose(fp);\r\n            return NULL;\r\n        }\r\n    }\r\n\r\n    fclose(fp);\r\n    return f;\r\n}\r\n\r\n"]
[2267.744266, "o", "double *poisson_read_boundary(const char *filename, int expected)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    double *vals = (double *)malloc(expected * sizeof(double));\r\n    if (!vals) { fclose(fp); return NULL; }\r\n\r\n    int count = 0;\r\n    while (count < expected) {\r\n        double v;\r\n        if (fscanf(fp, \"%lf\", &v) != 1) break;\r\n        vals[count++] = v;\r\n    }\r\n\r\n    fclose(fp);\r\n    if (count != expected) { free(vals); return NULL; }\r\n    return vals;\r\n}\r\n\r\nstatic void add_coo(COOMatrix *coo, int *k, int r, int c, double v)\r\n{\r\n    coo->row[*k] = r;\r\n    coo->col[*k] = c;\r\n    coo->values[*k] = v;\r\n    (*k)++;\r\n}\r\n\r\nint poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n                    const char *source_file, PoissonBC left, PoissonBC right,\r\n                    PoissonBC bottom, PoissonBC top,\r\n                    CSRMatrix **A_out, double **b_out)\r\n{\r\n    if (!A_out || !b_out) return -1;\r\n    *A_out = NULL;\r\n    *b_out = NULL;\r\n\r\n    if"]
[2267.744361, "o", " (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || !source_file) return -1;\r\n\r\n    double hx = (x1 - x0) / (nx - 1);\r\n    double hy = (y1 - y0) / (ny - 1);\r\n    double hx2 = hx * hx;\r\n    double hy2 = hy * hy;\r\n\r\n    double *f = poisson_read_source(source_file, nx, ny);\r\n    if (!f) return -1;\r\n\r\n"]
