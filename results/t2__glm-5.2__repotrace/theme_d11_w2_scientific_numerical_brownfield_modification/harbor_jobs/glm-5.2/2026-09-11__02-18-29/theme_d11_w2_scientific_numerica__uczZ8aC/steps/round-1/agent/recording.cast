[9746.453439, "o", "   132\tstatic int parse_bc(const char *s, PoissonBC *bc)\r\n   133\t{\r\n   134\t    const char *colon = strchr(s, ':');\r\n   135\t    if (!colon || colon == s) return -1;\r\n   136\t\r\n   137\t    size_t len = colon - s;\r\n   138\t    char type[32];\r\n   139\t    if (len >= sizeof(type)) return -1;\r\n   140\t    memcpy(type, s, len);\r\n   141\t    type[len] = '\\0';\r\n"]
[9746.453455, "o", "   142\t\r\n   143\t    if (strcmp(type, \"dirichlet\") == 0) bc->type = POISSON_DIRICHLET;\r\n"]
[9746.453527, "o", "   144\t    else if (strcmp(type, \"neumann\") == 0) bc->type = POISSON_NEUMANN;\r\n   145\t    else return -1;\r\n   146\t\r\n   147\t    bc->file = colon + 1;\r\n   148\t    return 0;\r\n   149\t}\r\n   150\t\r\n   151\tstatic int run_solver_and_print(const CSRMatrix *A, const double *b,\r\n   152\t                                const char *solver, const char *precond,\r\n   153\t                                double tol, int maxiter, int restart,\r\n   154\t                                double omega, const char *output,\r\n   155\t                                const char *history)\r\n"]
