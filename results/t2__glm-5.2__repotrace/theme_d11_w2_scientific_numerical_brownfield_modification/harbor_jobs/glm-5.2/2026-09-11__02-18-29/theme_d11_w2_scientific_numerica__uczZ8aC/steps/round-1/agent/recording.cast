[9731.94416, "o", "> [--restart <m>] [--ssor-omega <value>] [--solver-tol <value>] [--solver-maxiter <int>] [--eigvec-output <file>]\\n\", prog);\r\n    24\t}\r\n    25\t\r\n    26\tstatic const char *get_opt(int argc, char **argv, const char *name)\r\n    27\t{\r\n    28\t    for (int i = 0; i < argc - 1; i++) {\r\n    29\t        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    30\t    }\r\n    31\t    return NULL;\r\n    32\t}\r\n    33\t\r\n    34\tstatic int write_history_file(const SolveResult *res, const char *filename)\r\n    35\t{\r\n    36\t    FILE *fp = fopen(filename, \"w\");\r\n    37\t    if (!fp) return -1;\r\n    38\t    for (int i = 0; i < res->history_len; i++) {\r\n    39\t        fprintf(fp, \"%d\\t%.15e\\t%.15e\\n\", i, res->history[i], res->precond_history[i]);\r\n    40\t    }\r\n    41\t    fclose(fp);\r\n    42\t    return 0;\r\n    43\t}\r\n    44\t\r\n    45\tstatic void print_solve_summary(const SolveResult *res)\r\n    46\t{\r\n    47\t    printf(\"converged: %s\\n\", res->converged ? \"yes\" : \"no\");\r\n"]
[9731.944229, "o", "    48\t    printf(\"iterations: %d\\n\", res->iterations);\r\n    49\t    printf(\"residual: %.6e\\n\", res->relres);\r\n    50\t    printf(\"true_residual: %.6e\\n\", res->true_residual);\r\n    51\t}\r\n    52\t\r\n    53\tstatic int validate_ssor_omega(double omega)\r\n    54\t{\r\n    55\t    if (!(omega > 0.0 && omega < 2.0)) {\r\n    56\t        fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n    57\t        return 1;\r\n    58\t    }\r\n    59\t    return 0;\r\n    60\t}\r\n"]
