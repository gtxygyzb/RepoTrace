[7848.760132, "o", "\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int \u001b[01;31m\u001b[Kcmd_\u001b[m\u001b[Kpoisson(int argc, char **argv)\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int rc = \u001b[01;31m\u001b[Krun_solver_and_print\u001b[m\u001b[K(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int \u001b[01;31m\u001b[Kcmd_\u001b[m\u001b[Kheat(int argc, char **argv)\r\n"]
