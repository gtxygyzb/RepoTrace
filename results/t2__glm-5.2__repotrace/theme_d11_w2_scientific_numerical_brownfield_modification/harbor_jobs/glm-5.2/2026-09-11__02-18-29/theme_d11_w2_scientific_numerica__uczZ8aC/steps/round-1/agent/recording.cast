[1145.650711, "o", "    double *b = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.650941, "o", "    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.651101, "o", "        fprintf(stderr, \"Error: cannot assemble Poisson system\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.651165, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.651221, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.651461, "o", "    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.651519, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
