[1145.611003, "o", "    printf(\"iterations: %d\\n\", res->iterations);\r\n\u001b[?2004l\r"]
[1145.611062, "o", "\u001b[?2004h> "]
[1145.611283, "o", "    printf(\"residual: %.6e\\n\", res->relres);\r\n\u001b[?2004l\r"]
[1145.611341, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1145.611399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1145.611458, "o", "\u001b[?2004h> "]
