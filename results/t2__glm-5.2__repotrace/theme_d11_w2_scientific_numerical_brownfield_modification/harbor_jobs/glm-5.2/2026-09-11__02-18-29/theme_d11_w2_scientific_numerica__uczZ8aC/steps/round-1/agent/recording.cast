[11285.886399, "o", "   190\t    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n   191\t        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n   192\t        solve_result_destroy(res);\r\n   193\t        return NULL;\r\n   194\t    }\r\n   195\t\r\n   196\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n   197\t\r\n   198\t    csr_spmv(A, res->x, Ap);\r\n   199\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n   200\t\r\n"]
[11285.886628, "o", "   201\t    double bnorm = vec_norm2(b, n);\r\n   202\t    if (bnorm == 0.0) bnorm = 1.0;\r\n   203\t\r\n   204\t    res->true_residual = vec_norm2(r, n);\r\n   205\t    res->relres = res->true_residual / bnorm;\r\n   206\t    res->true_residual_inf = vec_norm_inf(r, n);\r\n   207\t    res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n   208\t    precond_apply(P, A, r, z);\r\n   209\t    double pnorm0 = vec_norm2(z, n);\r\n   210\t    res->history[0] = res->relres;\r\n   211\t    res->precond_history[0] = pnorm0;\r\n   212\t    res->history_len = 1;\r\n   213\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n   214\t    res->iterations = 0;\r\n   215\t    if (res->converged || maxiter == 0) {\r\n"]
