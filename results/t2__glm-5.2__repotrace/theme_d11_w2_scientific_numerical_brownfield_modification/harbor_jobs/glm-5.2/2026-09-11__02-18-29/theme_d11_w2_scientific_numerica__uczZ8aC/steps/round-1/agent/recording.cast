[11068.904652, "o", "     1\t#ifndef VECTOR_H\r\n     2\t#define VECTOR_H\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t\r\n     6\t/* Allocate a zero-initialized vector of length n. Returns NULL on failure. */\r\n     7\tdouble *vec_create(int n);\r\n     8\t\r\n     9\t"]
[11068.904747, "o", "/* Deep copy: dst[i] = src[i] */\r\n    10\tvoid vec_copy(const double *src, double *dst, int n);\r\n    11\t\r\n    12\t/* Zero out: x[i] = 0 */\r\n    13\tvoid vec_zero(double *x, int n);\r\n    14\t\r\n    15\t/* Scale: x[i] *= a */\r\n    16\tvoid vec_scale(double a, double *x, int n);\r\n    17\t\r\n    18\t/* AXPY: y[i] += a * x[i] */\r\n    19\tvoid vec_axpy(double a, const double *x, double *y, int n);\r\n    20\t\r\n    21\t/* Dot product: sum(x[i] * y[i]) */\r\n    22\tdouble vec_dot(const double *x, const double *y, int n);\r\n    23\t\r\n"]
[11068.904817, "o", "    24\t/* L2 norm: sqrt(sum(x[i]^2)) */\r\n    25\tdouble vec_norm2(const double *x, int n);\r\n    26\t\r\n    27\t/* Print vector to stream, one value per line */\r\n    28\tvoid vec_print(const double *x, int n, FILE *out);\r\n    29\t\r\n    30\t#endif /* VECTOR_H */\r\n    31\t#include \"vector.h\"\r\n    32\t#include <stdlib.h>\r\n    33\t#include <string.h>\r\n    34\t#include <math.h>\r\n"]
[11068.904917, "o", "    35\t\r\n    36\tdouble *vec_create(int n)\r\n    37\t{\r\n    38\t    if (n <= 0) return NULL;\r\n    39\t    return calloc(n, sizeof(double));\r\n    40\t}\r\n    41\t\r\n    42\tvoid vec_copy(const double *src, double *dst, int n)\r\n    43\t{\r\n    44\t    memcpy(dst, src, (size_t)n * sizeof(double));\r\n    45\t}\r\n    46\t"]
[11068.904998, "o", "\r\n    47\tvoid vec_zero(double *x, int n)\r\n    48\t{\r\n    49\t    memset(x, 0, (size_t)n * sizeof(double));\r\n    50\t}\r\n    51\t\r\n    52\tvoid vec_scale(double a, double *x, int n)\r\n"]
[11068.905064, "o", "    53\t{\r\n    54\t    int i;\r\n    55\t    for (i = 0; i < n; i++) x[i] *= a;\r\n    56\t}\r\n    57\t\r\n    58\tvoid vec_axpy(double a, const double *x, double *y, int n)\r\n    59\t{\r\n    60\t    int i;\r\n    61\t    for (i = 0; i < n; i++) y[i] += a * x[i];\r\n    62\t}\r\n"]
[11068.905123, "o", "    63\t\r\n    64\tdouble vec_dot(const double *x, const double *y, int n)\r\n    65\t{\r\n    66\t    double s = 0.0;\r\n    67\t    int i;\r\n    68\t    for (i = 0; i < n; i++) s += x[i] * y[i];\r\n    69\t    return s;\r\n    70\t}\r\n    71\t\r\n    72\tdouble vec_norm2(const double *x, int n)\r\n    73\t{\r\n    74\t    return sqrt(vec_dot(x, x, n));\r\n    75\t}\r\n"]
[11068.905186, "o", "    76\t\r\n    77\tvoid vec_print(const double *x, int n, FILE *out)\r\n    78\t{\r\n    79\t    int i;\r\n"]
[11068.905252, "o", "    80\t    for (i = 0; i < n; i++)\r\n    81\t        fprintf(out, \"%.15g\\n\", x[i]);\r\n    82\t}\r\n"]
