[5571.019483, "i", "sed -n '1,220p' include/poisson.h\n"]
[5571.019767, "o", "sed -n '1,220p' include/poisson.h\r\n\u001b[?2004l\r"]
[5571.022686, "o", "#ifndef POISSON_H\r\n#define POISSON_H\r\n\r\n#include \"sparse.h\"\r\n\r\ntypedef enum {\r\n    POISSON_DIRICHLET,\r\n"]
[5571.02276, "o", "    POISSON_NEUMANN\r\n} PoissonBCType;\r\n\r\ntypedef struct {\r\n    PoissonBCType type;\r\n    const char *file;\r\n} PoissonBC;\r\n\r\nint poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n                    const char *source_file, PoissonBC left, PoissonBC right,\r\n                    PoissonBC bottom, PoissonBC top,\r\n                    CSRMatrix **A_out, double **b_out);\r\n\r\ndouble *poisson_read_source(const char *filename, int nx, int ny);\r\ndouble *poisson_read_boundary(const char *filename, int expected);\r\n"]
[5571.022831, "o", "\r\n#endif /* POISSON_H */\r\n"]
