[9937.141235, "o", "# Insert cmd_matinfo before main\r\n\u001b[?2004l\r"]
[9937.141301, "o", "\u001b[?2004h> "]
[9937.141366, "o", "cmd = r'''\r\n\u001b[?2004l\r"]
[9937.141423, "o", "\u001b[?2004h> "]
[9937.141681, "o", "static int cmd_matinfo(int argc, char **argv)\r\n\u001b[?2004l\r"]
[9937.141748, "o", "\u001b[?2004h> "]
[9937.141809, "o", "{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9937.142143, "o", "    const char *input = get_opt(argc, argv, \"--input\");\r\n\u001b[?2004l\r"]
[9937.142213, "o", "\u001b[?2004h> "]
[9937.142314, "o", "    if (!input) {\r\n\u001b[?2004l\r"]
[9937.14237, "o", "\u001b[?2004h> "]
[9937.142784, "o", "        fprintf(stderr, \"Error: matinfo requires --input <mtx_file>\\n\");\r\n\u001b[?2004l\r"]
[9937.142849, "o", "\u001b[?2004h> "]
[9937.142999, "o", "        usage(\"numsim\");\r\n\u001b[?2004l\r"]
[9937.143066, "o", "\u001b[?2004h> "]
[9937.143171, "o", "        return 1;\r\n\u001b[?2004l\r"]
[9937.143228, "o", "\u001b[?2004h> "]
[9937.143285, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.143342, "o", "> \r\n\u001b[?2004l\r"]
[9937.143397, "o", "\u001b[?2004h> "]
[9937.1436, "o", "    CSRMatrix *A = csr_read_mm(input);\r\n\u001b[?2004l\r"]
[9937.143658, "o", "\u001b[?2004h> "]
[9937.143748, "o", "    if (!A) {\r\n\u001b[?2004l\r"]
[9937.143819, "o", "\u001b[?2004h> "]
[9937.144158, "o", "        fprintf(stderr, \"error: cannot read matrix file\\n\");\r\n\u001b[?2004l\r"]
[9937.144212, "o", "\u001b[?2004h> "]
[9937.144337, "o", "        return 1;\r\n\u001b[?2004l\r"]
[9937.144393, "o", "\u001b[?2004h> "]
[9937.144453, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.14451, "o", "> \r\n\u001b[?2004l\r"]
[9937.144566, "o", "\u001b[?2004h> "]
[9937.144689, "o", "    int rows = A->rows;\r\n\u001b[?2004l\r"]
[9937.144744, "o", "\u001b[?2004h> "]
[9937.144891, "o", "    int cols = A->cols;\r\n\u001b[?2004l\r"]
[9937.144948, "o", "\u001b[?2004h> "]
[9937.145079, "o", "    int nnz = A->nnz;\r\n\u001b[?2004l\r"]
[9937.145136, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[9937.145182, "o", "\u001b[?2004h> "]
[9937.145332, "o", "    int symmetric = 0;\r\n\u001b[?2004l\r"]
[9937.145388, "o", "\u001b[?2004h> "]
[9937.145528, "o", "    if (rows == cols) {\r\n\u001b[?2004l\r"]
[9937.145584, "o", "\u001b[?2004h> "]
[9937.14572, "o", "        symmetric = 1;\r\n\u001b[?2004l\r"]
[9937.145776, "o", "\u001b[?2004h> "]
[9937.146089, "o", "        for (int i = 0; i < rows && symmetric; i++) {\r\n\u001b[?2004l\r"]
[9937.146147, "o", "\u001b[?2004h> "]
[9937.146603, "o", "            for (int k = A->row_ptr[i]; k < A->row_ptr[i+1] && symmetric; k++) {\r\n\u001b[?2004l\r"]
[9937.146661, "o", "\u001b[?2004h> "]
[9937.146911, "o", "                int j = A->col_indices[k];\r\n\u001b[?2004l\r"]
[9937.146969, "o", "\u001b[?2004h> "]
[9937.1472, "o", "                double v = A->values[k];\r\n\u001b[?2004l\r"]
[9937.147258, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[9937.147326, "o", "\u001b[?2004h> "]
[9937.147491, "o", "                int idx = -1;\r\n\u001b[?2004l\r"]
[9937.147547, "o", "\u001b[?2004h> "]
[9937.147958, "o", "                for (int l = A->row_ptr[j]; l < A->row_ptr[j+1]; l++) {\r\n\u001b[?2004l\r"]
[9937.148015, "o", "\u001b[?2004h> "]
[9937.148296, "o", "                    if (A->col_indices[l] == i) {\r\n\u001b[?2004l\r"]
[9937.148355, "o", "\u001b[?2004h> "]
[9937.148543, "o", "                        idx = l;\r\n\u001b[?2004l\r"]
[9937.148599, "o", "\u001b[?2004h> "]
[9937.148778, "o", "                        break;\r\n\u001b[?2004l\r"]
[9937.148834, "o", "\u001b[?2004h> "]
[9937.148969, "o", "                    }\r\n\u001b[?2004l\r"]
[9937.149027, "o", "\u001b[?2004h> "]
[9937.14913, "o", "                }\r\n\u001b[?2004l\r"]
[9937.149185, "o", "\u001b[?2004h> "]
[9937.149364, "o", "                if (idx < 0) {\r\n\u001b[?2004l\r"]
[9937.14942, "o", "\u001b[?2004h> "]
[9937.14962, "o", "                    symmetric = 0;\r\n\u001b[?2004l\r"]
[9937.149676, "o", "\u001b[?2004h> "]
[9937.149834, "o", "                    break;\r\n\u001b[?2004l\r"]
[9937.1499, "o", "\u001b[?2004h> "]
[9937.150003, "o", "                }\r\n\u001b[?2004l\r"]
[9937.150059, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[9937.150123, "o", "\u001b[?2004h> "]
[9937.150371, "o", "                double vt = A->values[idx];\r\n\u001b[?2004l\r"]
[9937.150428, "o", "\u001b[?2004h> "]
[9937.150675, "o", "                double diff = fabs(v - vt);\r\n\u001b[?2004l\r"]
[9937.150731, "o", "\u001b[?2004h> "]
[9937.151129, "o", "                double denom = fmax(fabs(v), fmax(fabs(vt), 1e-30));\r\n\u001b[?2004l\r"]
[9937.151195, "o", "\u001b[?2004h> "]
[9937.151445, "o", "                if (diff >= 1e-12 * denom) {\r\n\u001b[?2004l\r"]
[9937.151503, "o", "\u001b[?2004h> "]
[9937.151701, "o", "                    symmetric = 0;\r\n\u001b[?2004l\r"]
[9937.151758, "o", "\u001b[?2004h> "]
[9937.15192, "o", "                    break;\r\n\u001b[?2004l\r"]
[9937.151978, "o", "\u001b[?2004h> "]
[9937.152081, "o", "                }\r\n\u001b[?2004l\r"]
[9937.152138, "o", "\u001b[?2004h> "]
[9937.152223, "o", "            }\r\n\u001b[?2004l\r"]
[9937.152281, "o", "\u001b[?2004h> "]
[9937.152337, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.152395, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.152462, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[9937.152555, "o", "    int bandwidth = 0;\r\n\u001b[?2004l\r"]
[9937.152612, "o", "\u001b[?2004h> "]
[9937.15272, "o", "    double frobenius_norm = 0.0;\r\n\u001b[?2004l\r"]
[9937.152776, "o", "\u001b[?2004h> "]
[9937.152892, "o", "    double max_abs_value = 0.0;\r\n\u001b[?2004l\r"]
[9937.152949, "o", "\u001b[?2004h> "]
[9937.153058, "o", "    double min_abs_nonzero = 0.0;\r\n\u001b[?2004l\r"]
[9937.153114, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.153174, "o", "> "]
[9937.153288, "o", "    for (int i = 0; i < A->rows; i++) {\r\n\u001b[?2004l\r"]
[9937.153344, "o", "\u001b[?2004h> "]
[9937.153568, "o", "        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n\u001b[?2004l\r"]
[9937.153625, "o", "\u001b[?2004h> "]
[9937.153754, "o", "            int j = A->col_indices[k];\r\n\u001b[?2004l\r"]
[9937.153811, "o", "\u001b[?2004h> "]
[9937.153938, "o", "            double v = A->values[k];\r\n\u001b[?2004l\r"]
[9937.153996, "o", "\u001b[?2004h> "]
[9937.154105, "o", "            double av = fabs(v);\r\n\u001b[?2004l\r"]
[9937.154161, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.154217, "o", "> "]
[9937.154293, "o", "            int bw = i - j;\r\n\u001b[?2004l\r"]
[9937.154349, "o", "\u001b[?2004h> "]
[9937.154461, "o", "            if (bw < 0) bw = -bw;\r\n\u001b[?2004l\r"]
[9937.154517, "o", "\u001b[?2004h> "]
[9937.154681, "o", "            if (bw > bandwidth) bandwidth = bw;\r\n\u001b[?2004l\r"]
[9937.154738, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.154793, "o", "> "]
[9937.154908, "o", "            frobenius_norm += v * v;\r\n\u001b[?2004l\r"]
[9937.154967, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[9937.155196, "o", "            if (av > max_abs_value) max_abs_value = av;\r\n\u001b[?2004l\r"]
[9937.155254, "o", "\u001b[?2004h> "]
[9937.155354, "o", "            if (av != 0.0) {\r\n\u001b[?2004l\r"]
[9937.155412, "o", "\u001b[?2004h> "]
[9937.155659, "o", "                if (min_abs_nonzero == 0.0 || av < min_abs_nonzero) {\r\n\u001b[?2004l\r"]
[9937.155717, "o", "\u001b[?2004h> "]
[9937.155857, "o", "                    min_abs_nonzero = av;\r\n\u001b[?2004l\r"]
[9937.155923, "o", "\u001b[?2004h> "]
[9937.155977, "o", "                }\r\n\u001b[?2004l\r"]
[9937.156034, "o", "\u001b[?2004h> "]
[9937.15609, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9937.156147, "o", "        }\r\n\u001b[?2004l\r"]
[9937.156203, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[9937.156258, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.156317, "o", "> "]
[9937.156455, "o", "    frobenius_norm = sqrt(frobenius_norm);\r\n\u001b[?2004l\r"]
[9937.15651, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.156578, "o", "> "]
[9937.156635, "o", "    int strict = 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9937.156724, "o", "    int weak = 1;\r\n\u001b[?2004l\r"]
[9937.15678, "o", "\u001b[?2004h> "]
[9937.156921, "o", "    for (int i = 0; i < A->rows; i++) {\r\n\u001b[?2004l\r"]
[9937.156978, "o", "\u001b[?2004h> "]
[9937.157065, "o", "        double diag = 0.0;\r\n\u001b[?2004l\r"]
[9937.157121, "o", "\u001b[?2004h> "]
[9937.157214, "o", "        double offsum = 0.0;\r\n\u001b[?2004l\r"]
[9937.15727, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.157325, "o", "> "]
[9937.157534, "o", "        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n\u001b[?2004l\r"]
[9937.157589, "o", "\u001b[?2004h> "]
[9937.15772, "o", "            int j = A->col_indices[k];\r\n\u001b[?2004l\r"]
[9937.157776, "o", "\u001b[?2004h> "]
[9937.15786, "o", "            if (j == i) {\r\n\u001b[?2004l\r"]
[9937.157927, "o", "\u001b[?2004h> "]
[9937.158046, "o", "                diag = A->values[k];\r\n\u001b[?2004l\r"]
[9937.158102, "o", "\u001b[?2004h> "]
[9937.158172, "o", "            } else {\r\n\u001b[?2004l\r"]
[9937.158229, "o", "\u001b[?2004h> "]
[9937.158384, "o", "                offsum += fabs(A->values[k]);\r\n\u001b[?2004l\r"]
[9937.158441, "o", "\u001b[?2004h> "]
[9937.158509, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9937.158579, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.158636, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[9937.158773, "o", "        if (fabs(diag) > offsum) {\r\n\u001b[?2004l\r"]
[9937.158828, "o", "\u001b[?2004h> "]
[9937.15891, "o", "            continue;\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.158967, "o", ">         }\r\n\u001b[?2004l\r"]
[9937.159022, "o", "\u001b[?2004h> "]
[9937.159154, "o", "        if (fabs(diag) >= offsum) {\r\n\u001b[?2004l\r"]
[9937.159209, "o", "\u001b[?2004h> "]
[9937.159286, "o", "            strict = 0;\r\n\u001b[?2004l\r"]
[9937.159342, "o", "\u001b[?2004h> "]
[9937.159395, "o", "        } else {\r\n\u001b[?2004l\r"]
[9937.15945, "o", "\u001b[?2004h> "]
[9937.159528, "o", "            strict = 0;\r\n\u001b[?2004l\r"]
[9937.159584, "o", "\u001b[?2004h> "]
[9937.159652, "o", "            weak = 0;\r\n\u001b[?2004l\r"]
[9937.159708, "o", "\u001b[?2004h> "]
[9937.159765, "o", "            break;\r\n\u001b[?2004l\r"]
[9937.159827, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[9937.159888, "o", "\u001b[?2004h> "]
[9937.159944, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[9937.16, "o", "\u001b[?2004h> "]
[9937.160306, "o", "    const char *diagonal_dominance = strict ? \"strict\" : (weak ? \"weak\" : \"none\");\r\n\u001b[?2004l\r"]
[9937.160362, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.160417, "o", "> "]
[9937.160508, "o", "    printf(\"rows: %d\\n\", rows);\r\n\u001b[?2004l\r"]
[9937.160563, "o", "\u001b[?2004h> "]
[9937.160669, "o", "    printf(\"cols: %d\\n\", cols);\r\n\u001b[?2004l\r"]
[9937.160725, "o", "\u001b[?2004h> "]
[9937.160823, "o", "    printf(\"nnz: %d\\n\", nnz);\r\n\u001b[?2004l\r"]
[9937.160888, "o", "\u001b[?2004h> "]
[9937.161086, "o", "    printf(\"symmetric: %s\\n\", symmetric ? \"yes\" : \"no\");\r\n\u001b[?2004l\r"]
[9937.16115, "o", "\u001b[?2004h> "]
[9937.161279, "o", "    printf(\"bandwidth: %d\\n\", bandwidth);\r\n\u001b[?2004l\r"]
[9937.161341, "o", "\u001b[?2004h> "]
[9937.161524, "o", "    printf(\"frobenius_norm: %.15e\\n\", frobenius_norm);\r\n\u001b[?2004l\r"]
[9937.161579, "o", "\u001b[?2004h> "]
[9937.161785, "o", "    printf(\"diagonal_dominance: %s\\n\", diagonal_dominance);\r\n\u001b[?2004l\r"]
[9937.161841, "o", "\u001b[?2004h> "]
[9937.162032, "o", "    printf(\"max_abs_value: %.15e\\n\", max_abs_value);\r\n\u001b[?2004l\r"]
[9937.162088, "o", "\u001b[?2004h> "]
[9937.162283, "o", "    printf(\"min_abs_nonzero: %.15e\\n\", min_abs_nonzero);\r\n\u001b[?2004l\r"]
[9937.16234, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.162396, "o", "> "]
[9937.162455, "o", "    csr_destroy(A);\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.16251, "o", "> "]
[9937.162565, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[9937.162611, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[9937.162668, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[9937.162724, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[9937.162783, "o", "\u001b[?2004h> "]
[9937.162884, "o", "if 'static int cmd_matinfo' not in s:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9937.163192, "o", "    s = s.replace('\\nint main(int argc, char **argv)\\n', '\\n' + cmd + 'int main(int argc, char **argv)\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.163249, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[9937.163313, "o", "# Add dispatch branch\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.163367, "o", "> "]
[9937.163459, "o", "if 'strcmp(cmd, \"matinfo\") == 0' not in s:\r\n\u001b[?2004l\r"]
[9937.163515, "o", "\u001b[?2004h> "]
[9937.163581, "o", "    s = s.replace(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9937.163737, "o", "        '    } else if (strcmp(cmd, \"eigenvalue\") == 0) {\\n',\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.163792, "o", "> "]
[9937.163928, "o", "        '    } else if (strcmp(cmd, \"matinfo\") == 0) {\\n'\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.163984, "o", "> "]
[9937.164121, "o", "        '        return cmd_matinfo(argc - 2, argv + 2);\\n'\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.164178, "o", "> "]
[9937.164314, "o", "        '    } else if (strcmp(cmd, \"eigenvalue\") == 0) {\\n'\r\n\u001b[?2004l\r\u001b[?2004h"]
[9937.164371, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[9937.164428, "o", "\u001b[?2004h> "]
[9937.164486, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9937.164542, "o", "PY\r\n\u001b[?2004l\r"]
[9937.260587, "o", "\u001b[?2004h"]
[9937.2607, "o", "root@n30009:/app# "]
[9937.419333, "i", "make\n"]
[9937.419529, "o", "make\r\n\u001b[?2004l\r"]
[9937.424438, "o", "gcc -Wall -Wextra -O2 -Iinclude -o numsim src/main.c src/dense.c src/vector.c src/io.c src/sparse.c src/precond.c src/solvers.c src/poisson.c src/heat.c src/convdiff.c src/eigen.c -lm\r\n"]
[9939.029083, "o", "\u001b[?2004hroot@n30009:/app# "]
[9947.685438, "i", "cat > /tmp/general.mtx <<'EOF'\n%%MatrixMarket matrix coordinate real general\n3 3 5\n1 1 2.0\n1 2 1.0\n2 2 3.0\n2 3 1.0\n3 3 4.0\nEOF\n"]
[9947.68573, "o", "cat > /tmp/general.mtx <<'EOF'\r\n\u001b[?2004l\r"]
[9947.685857, "o", "\u001b[?2004h"]
[9947.685969, "o", "> "]
