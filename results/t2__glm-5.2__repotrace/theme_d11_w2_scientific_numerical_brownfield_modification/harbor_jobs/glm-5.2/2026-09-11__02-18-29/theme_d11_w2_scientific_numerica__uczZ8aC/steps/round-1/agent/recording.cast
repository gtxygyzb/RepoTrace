[7898.248661, "o", "#include \"solvers.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <math.h>\r\n#include <string.h>\r\n\r\nstatic SolveResult *result_create(int n, int maxiter)\r\n{\r\n    if (maxiter < 0) maxiter = 0;\r\n"]
[7898.248753, "o", "    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    if (!res) return NULL;\r\n\r\n    res->x = vec_create(n);\r\n    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    if (!res->x || !res->history) {\r\n        free(res->x);\r\n        free(res->history);\r\n        free(res);\r\n        return NULL;\r\n    }\r\n    res->history_len = 0;\r\n    return res;\r\n}\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n"]
[7898.248833, "o", "    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *p = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    if (!r || !z || !p || !Ap) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);"]
[7898.248933, "o", "\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    res->history[0] = res->relres;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n\r\n"]
[7898.249015, "o", "    if (precond_apply(P, A, r, z) != 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n    vec_copy(z, p, n);\r\n    double rz_old = vec_dot(r, z, n);\r\n\r\n    for (int iter = 1; iter <= maxiter; iter++) {\r\n        csr_spmv(A, p, Ap);\r\n        double pAp = vec_dot(p, Ap, n);\r\n        if (fabs(pAp) < 1e-30) break;\r\n\r\n        double alpha = rz_old / pAp;\r\n        vec_axpy(alpha, p, res->x, n);\r\n        vec_axpy(-alpha, Ap, r, n);\r\n\r\n        /* Recompute the true residual rather than relying on the recurrence. */\r\n        csr_spmv(A, res->x, Ap);\r\n"]
[7898.24909, "o", "        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n        res->relres = res->true_residual / bnorm;\r\n        res->history[iter] = res->relres;\r\n        res->history_len = iter + 1;\r\n        res->iterations = iter;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double rz_new = vec_dot(r, z, n);\r\n        if (fabs(rz_old) < 1e-30) break;\r\n"]
[7898.249134, "o", "        double beta = rz_new / rz_old;\r\n        vec_scale(beta, p, n);\r\n        vec_axpy(1.0, z, p, n);\r\n"]
[7898.249639, "o", "\u001b[?2004h"]
[7898.249717, "o", "root@n30009:/app# "]
[7898.513491, "i", "sed -n '101,220p' src/solvers.c\n"]
[7898.513782, "o", "sed -n '101,220p' src/solvers.c\r\n\u001b[?2004l\r"]
[7898.516749, "o", "        rz_old = rz_new;\r\n    }\r\n\r\n    free(r); free(z); free(p); free(Ap);\r\n    return res;\r\n}\r\n\r\n"]
[7898.516856, "o", "static void apply_givens(double *a, double *b, double c, double s)\r\n{\r\n    double t = c * (*a) + s * (*b);\r\n    *b = -s * (*a) + c * (*b);\r\n    *a = t;\r\n}\r\n\r\nstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n{\r\n    if (kdim <= 0) return -1;\r\n\r\n    double *c = (double *)malloc(m * sizeof(double));\r\n    double *s = (double *)malloc(m * sizeof(double));\r\n    if (!c || !s) { free(c); free(s); return -1; }\r\n\r\n    for (int i = 0; i < kdim; i++) {\r\n        for (int k = 0; k < i; k++) {\r\n            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n        }"]
[7898.516958, "o", "\r\n\r\n        double a = H[i*m+i];\r\n        double b = H[(i+1)*m+i];\r\n        if (b == 0.0) {\r\n            c[i] = 1.0;\r\n            s[i] = 0.0;\r\n        } else {\r\n            double r = hypot(a, b);\r\n            c[i] = a / r;\r\n            s[i] = b / r;\r\n        }\r\n        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n\r\n    }\r\n\r\n    for (int i = kdim - 1; i >= 0; i--) {\r\n        double sum = g[i];\r\n        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n"]
[7898.517022, "o", "        y[i] = sum / H[i*m+i];\r\n    }\r\n\r\n    free(c);\r\n    free(s);\r\n    return 0;\r\n}\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                           double tol, int maxiter, int m, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (m <= 0) m = 30;\r\n"]
[7898.517119, "o", "    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    double *Av = vec_create(n);\r\n    double *w = vec_create(n);\r\n    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n    double *y = (double *)malloc(m * sizeof(double));\r\n    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n\r\n    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n"]
[7898.51717, "o", "\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    res->history[0] = res->relres;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        return res;\r\n    }"]
[7898.517242, "o", "\r\n\r\n    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double beta = vec_norm2(z, n);\r\n        if (beta == 0.0) break;\r\n\r\n        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n"]
[7898.51733, "o", "        g[0] = beta;\r\n        memset(H, 0, (m + 1) * m * sizeof(double));\r\n\r\n        int kdim = 0;\r\n        int fail = 0;\r\n        for (int j = 0; j < m; j++) {\r\n            csr_spmv(A, V + j * n, Av);\r\n            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n\r\n            for (int i = 0; i <= j; i++) {\r\n                double h = vec_dot(w, V + i * n, n);\r\n                H[i*m+j] = h;\r\n                vec_axpy(-h, V + i * n, w, n);\r\n"]
[7898.517823, "o", "\u001b[?2004h"]
[7898.517901, "o", "root@n30009:/app# "]
[7898.795293, "i", "sed -n '221,320p' src/solvers.c\n"]
[7898.79559, "o", "sed -n '221,320p' src/solvers.c\r\n\u001b[?2004l\r"]
[7898.798648, "o", "            }\r\n\r\n            double hnorm = vec_norm2(w, n);\r\n            H[(j+1)*m+j] = hnorm;\r\n            kdim = j + 1;\r\n\r\n"]
[7898.798773, "o", "            if (hnorm < 1e-14) break;\r\n\r\n            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n        }\r\n        if (fail) break;\r\n        if (kdim == 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n        res->relres = res->true_residual / bnorm;\r\n        res->history[cycle] = res->relres;\r\n        res->history_len = cycle + 1;\r\n        res->iterations = cycle;\r\n"]
[7898.798853, "o", "\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n    }\r\n\r\n    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n    return res;\r\n}\r\n\r\nvoid solve_result_destroy(SolveResult *res)\r\n{\r\n"]
[7898.798931, "o", "    if (!res) return;\r\n    free(res->x);\r\n    free(res->history);\r\n    free(res);\r\n}\r\n"]
[7898.799502, "o", "\u001b[?2004h"]
[7898.799582, "o", "root@n30009:/app# "]
[7936.08394, "i", "cat include/precond.h\n"]
[7936.084188, "o", "cat include/precond.h\r\n\u001b[?2004l\r"]
[7936.086486, "o", "#ifndef PRECOND_H\r\n#define PRECOND_H\r\n\r\n#include \"sparse.h\"\r\n\r\ntypedef enum {\r\n    PRECOND_NONE,\r\n    PRECOND_JACOBI,\r\n    PRECOND_ILU0,\r\n    PRECOND_SSOR\r\n} PrecondType;\r\n\r\ntypedef struct {\r\n    PrecondType type;\r\n    int n;\r\n    double omega;\r\n    double *diag;       /* Jacobi and SSOR */\r\n    CSRMatrix *lu;      /* ILU(0) factors in one CSR pattern */\r\n    const CSRMatrix *ssor_A;\r\n} Precond;\r\n\r\nPrecond *precond_create(const CSRMatrix *A, const char *name, double omega);\r\nvoid     precond_destroy(Precond *P);\r\nint      precond_apply(Precond *P, const CSRMatrix *A, const double *r, double *z);\r\n\r\n#endif /* PRECOND_H */\r\n"]
[7936.086947, "o", "\u001b[?2004h"]
[7936.087008, "o", "root@n30009:/app# "]
[7936.357786, "i", "grep -n \"get_opt\\|parse_\\|PRECOND_\\|SOLVER_\\|strcmp(argv\\[1\\]\\|usage\\|restart\\|omega\\|ssor\" src/main.c\n"]
[7936.35851, "o", "grep -n \"get_opt\\|parse_\\|PRECOND_\\|SOLVER_\\|strcmp(argv\\[1\\]\\|usage\\|restart\\|omega\\|ssor\" src/main.c\r\n\u001b[?2004l\r"]
[7936.362001, "o", "\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void \u001b[01;31m\u001b[Kusage\u001b[m\u001b[K(const char *prog)\r\n"]
[7936.362112, "o", "\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|\u001b[01;31m\u001b[Kssor\u001b[m\u001b[K> --tol <value> --maxiter <value> [--\u001b[01;31m\u001b[Krestart\u001b[m\u001b[K <m>] [--\u001b[01;31m\u001b[Kssor\u001b[m\u001b[K-\u001b[01;31m\u001b[Komega\u001b[m\u001b[K <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n"]
[7936.362194, "o", "\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|\u001b[01;31m\u001b[Kssor\u001b[m\u001b[K> --tol <value> --maxiter <value> [--\u001b[01;31m\u001b[Krestart\u001b[m\u001b[K <m>] [--\u001b[01;31m\u001b[Kssor\u001b[m\u001b[K-\u001b[01;31m\u001b[Komega\u001b[m\u001b[K <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"  %s heat --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --alpha <float> --dt <float> --nsteps <int> --scheme <backward-euler|crank-nicolson> --ic <file> --source <file>[,<file>,...] --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|\u001b[01;31m\u001b[Kssor\u001b["]
[7936.362275, "o", "m\u001b[K> --tol <value> --maxiter <value> [--\u001b[01;31m\u001b[Krestart\u001b[m\u001b[K <m>] [--\u001b[01;31m\u001b[Kssor\u001b[m\u001b[K-\u001b[01;31m\u001b[Komega\u001b[m\u001b[K <value>] --output <file>\\n\", prog);\r\n\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"  %s convdiff --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --kappa <float> --vx <float> --vy <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|\u001b[01;31m\u001b[Kssor\u001b[m\u001b[K> --tol <value> --maxiter <value> [--\u001b[01;31m\u001b[Krestart\u001b[m\u001b[K <m>] [--\u001b[01;31m\u001b[Kssor\u001b[m\u001b[K-\u001b[01;31m\u001b[Komega\u001b[m\u001b[K <value>] --output <file> [--history <file>]\\n\", prog);\r\n"]
[7936.362327, "o", "\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic const char *\u001b[01;31m\u001b[Kget_opt\u001b[m\u001b[K(int argc, char **argv, const char *name)\r\n"]
[7936.36241, "o", "\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int validate_\u001b[01;31m\u001b[Kssor\u001b[m\u001b[K_\u001b[01;31m\u001b[Komega\u001b[m\u001b[K(double \u001b[01;31m\u001b[Komega\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!(\u001b[01;31m\u001b[Komega\u001b[m\u001b[K > 0.0 && \u001b[01;31m\u001b[Komega\u001b[m\u001b[K < 2.0)) {\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fprintf(stderr, \"error: \u001b[01;31m\u001b[Kssor\u001b[m\u001b[K-\u001b[01;31m\u001b[Komega\u001b[m\u001b[K must be in (0,2)\\n\");\r\n"]
[7936.362479, "o", "\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int \u001b[01;31m\u001b[Kparse_\u001b[m\u001b[Kbc(const char *s, PoissonBC *bc)\r\n"]
