[1145.65278, "o", "        return 0;\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r"]
[1145.652839, "o", "\u001b[?2004h> "]
[1145.652911, "o", "        fprintf(stderr, \"Error: unknown command '%s'\\n\", cmd);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.652968, "o", "        usage(argv[0]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.653031, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
