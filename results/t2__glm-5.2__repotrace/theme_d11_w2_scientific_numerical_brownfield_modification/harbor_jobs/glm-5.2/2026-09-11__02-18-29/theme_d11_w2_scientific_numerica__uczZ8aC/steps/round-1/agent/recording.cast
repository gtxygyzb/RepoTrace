[7897.966044, "o", "\r\n    const char *cmd = argv[1];\r\n\r\n    if (strcmp(cmd, \"dense-solve\") == 0) {\r\n        return cmd_dense_solve(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"sparse-solve\") == 0) {\r\n        return cmd_sparse_solve(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"poisson\") == 0) {\r\n        return cmd_poisson(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"heat\") == 0) {\r\n        return cmd_heat(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"convdiff\") == 0) {\r\n        return cmd_convdiff(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"--help\") == 0 || strcmp(cmd, \"-h\") == 0) {\r\n        usage(argv[0]);\r\n        return 0;\r\n    } else {\r\n        fprintf(stderr, \"Error: unknown command '%s'\\n\", cmd);\r\n"]
