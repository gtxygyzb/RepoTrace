[9703.617978, "o", "#include \"io.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nDenseMatrix *dm_read_text(const char *filename)\r\n{"]
[9703.618083, "o", "\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n"]
[9703.618151, "o", "\r\n    int rows, cols;\r\n    if (fscanf(fp, \"%d %d\", &rows, &cols) != 2) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    DenseMatrix *m = dm_create(rows, cols);\r\n    if (!m) { fclose(fp); return NULL; }\r\n\r\n    int i, j;\r\n    for (i = 0; i < rows; i++)\r\n        for (j = 0; j < cols; j++)\r\n            if (fscanf(fp, \"%lf\", &m->data[i * cols + j]) != 1) {\r\n                dm_destroy(m);\r\n                fclose(fp);\r\n                return NULL;\r\n            }\r\n\r\n    fclose(fp);\r\n    return m;\r\n}\r\n\r\nint dm_write_text(const DenseMatrix *m, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n"]
[9703.618244, "o", "    dm_print(m, fp);\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n\r\ndouble *vec_read_text(const char *filename, int *n_out)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    int n;\r\n    if (fscanf(fp, \"%d\", &n) != 1 || n <= 0) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    double *x = vec_create(n);\r\n    if (!x) { fclose(fp); return NULL; }\r\n\r\n    int i;\r\n"]
[9703.618308, "o", "    for (i = 0; i < n; i++)\r\n        if (fscanf(fp, \"%lf\", &x[i]) != 1) {\r\n            free(x);\r\n            fclose(fp);\r\n            return NULL;\r\n        }\r\n\r\n    fclose(fp);\r\n    *n_out = n;\r\n    return x;\r\n}\r\n"]
[9703.618371, "o", "\r\nint vec_write_text(const double *x, int n, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n"]
[9703.618431, "o", "    fprintf(fp, \"%d\\n\", n);\r\n    vec_print(x, n, fp);\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n"]
