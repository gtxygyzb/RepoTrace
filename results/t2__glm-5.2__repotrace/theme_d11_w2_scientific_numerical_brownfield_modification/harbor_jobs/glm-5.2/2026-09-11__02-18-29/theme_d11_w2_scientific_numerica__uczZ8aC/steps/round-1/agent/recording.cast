[8056.755509, "o", "    double resnorm = NAN;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.755587, "o", "    if (!isnan(eigenvalue)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.75566, "o", "        csr_spmv(A, v, Av);\r\n\u001b[?2004l\r\u001b[?2004h> "]
