[297.476246, "i", "}\n\ndouble *csr_diagonal(const CSRMatrix *A)\n{\n    int n = A->rows < A->cols ? A->rows : A->cols;\n    double *diag = vec_create(n);\n    if (!diag) return NULL;\n    for (int i = 0; i < n; i++) {\n        int idx = csr_find_in_row(A, i, i);\n        diag[i] = (idx >= 0) ? A->values[idx] : 0.0;\n    }\n    return diag;\n}\nEOF\n"]
