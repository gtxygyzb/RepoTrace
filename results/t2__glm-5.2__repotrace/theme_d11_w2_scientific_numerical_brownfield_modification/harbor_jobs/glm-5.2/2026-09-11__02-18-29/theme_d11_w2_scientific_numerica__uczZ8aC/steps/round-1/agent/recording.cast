[2285.50222, "o", ".RECIPEPREFIX := >\r\n\r\nCC      = gcc\r\nCFLAGS  = -Wall -Wextra -O2 -Iinclude\r\nLDFLAGS = -lm\r\n\r\nSRC     = src/main.c src/dense.c src/vector.c src/io.c src/sparse.c src/precond.c src/solvers.c src/poisson.c\r\nOBJ     = $(SRC:.c=.o)\r\nBIN     = numsim\r\n\r\n.PHONY: all clean\r\n\r\nall: $(BIN)\r\n\r\n$(BIN): $(SRC)\r\n>$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)\r\n\r\nclean:\r\n>rm -f $(BIN) $(OBJ)\r\n"]
