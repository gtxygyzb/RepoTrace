[8056.754819, "o", "    printf(\"method: %s\\n\", method_s);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.75495, "o", "    printf(\"converged: %s\\n\", converged ? \"yes\" : \"no\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.755053, "o", "    printf(\"iterations: %d\\n\", iterations);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.755223, "o", "    printf(\"eigenvalue: %.15e\\n\", isnan(eigenvalue) ? eigenvalue : eigenvalue);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.755288, "o", "    if (method == 2) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.755384, "o", "        printf(\"shift: %.15e\\n\", sigma);\r\n\u001b[?2004l\r\u001b[?2004h> "]
