[4142.456092, "o", "\u001b[?2004h> "]
[4142.456224, "o", "p = Path('Makefile')\r\n\u001b[?2004l\r"]
[4142.456293, "o", "\u001b[?2004h"]
[4142.45635, "o", "> "]
