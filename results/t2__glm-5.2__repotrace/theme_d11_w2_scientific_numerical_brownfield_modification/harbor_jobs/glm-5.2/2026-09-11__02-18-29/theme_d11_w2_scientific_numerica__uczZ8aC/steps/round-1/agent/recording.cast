[1145.651991, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.652046, "o", "    const char *cmd = argv[1];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.652122, "o", "    if (strcmp(cmd, \"dense-solve\") == 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
