[11119.641215, "o", "\u001b[?2004l\r"]
[11119.644855, "o", "     1\t#ifndef SOLVERS_H\r\n     2\t#define SOLVERS_H\r\n     3\t\r\n     4\t#include \"sparse.h\"\r\n     5\t#include \"precond.h\"\r\n     6\t\r\n     7\ttypedef struct {\r\n"]
[11119.645004, "o", "     8\t    double *x;\r\n     9\t    double relres;          /* true relative residual ||b-A*x||/||b|| */\r\n    10\t    double true_residual;   /* absolute true residual norm ||b-A*x|| */\r\n    11\t    int iterations;\r\n    12\t    int converged;\r\n    13\t    double *history;        /* true relative residual at each iteration */\r\n    14\t    double *precond_history; /* preconditioned residual norm ||M^-1 r|| at each iteration */\r\n    15\t    int history_len;        /* number of stored history entries */\r\n    16\t} SolveResult;\r\n    17\t\r\n    18\tSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n    19\t                      double tol, int maxiter, Precond *P);\r\n    20\t\r\n    21\tSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n    22\t                           double tol, int maxiter, int m, Precond *P);\r\n    23\t\r\n    24\tvoid solve_result_destroy(SolveResult *res);\r\n    25\t\r\n    26\t#endif /* SOLVERS_H */\r\n    27\t#ifndef SPARSE_H\r\n    28\t#define SPARSE_H\r\n"]
[11119.645098, "o", "    29\t\r\n    30\t#include <stdio.h>\r\n    31\t\r\n    32\ttypedef struct {\r\n    33\t    int    rows;\r\n    34\t    int    cols;\r\n    35\t    int    nnz;\r\n    36\t    double *values;\r\n    37\t    int    *col_indices;\r\n    38\t    int    *row_ptr;\r\n    39\t} CSRMatrix;\r\n    40\t\r\n    41\ttypedef struct {\r\n    42\t    int    rows;\r\n    43\t    int    cols;\r\n    44\t    int    nnz;\r\n    45\t"]
