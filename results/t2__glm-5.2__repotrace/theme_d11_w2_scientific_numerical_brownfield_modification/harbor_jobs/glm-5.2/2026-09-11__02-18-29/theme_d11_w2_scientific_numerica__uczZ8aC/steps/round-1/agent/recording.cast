[5616.151619, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include \"dense.h\"\r\n#include \"vector.h\"\r\n#include \"io.h\"\r\n"]
[5616.151698, "o", "#include \"sparse.h\"\r\n#include \"precond.h\"\r\n#include \"solvers.h\"\r\n#include \"poisson.h\"\r\n#include \"heat.h\"\r\n\r\nstatic void usage(const char *prog)\r\n{\r\n    fprintf(stderr, \"Usage:\\n\");\r\n    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\n\", prog);\r\n    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\r\n"]
[5616.151782, "o", "    fprintf(stderr, \"  %s heat --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --alpha <float> --dt <float> --nsteps <int> --scheme <backward-euler|crank-nicolson> --ic <file> --source <file>[,<file>,...] --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file>\\n\", prog);\r\n}\r\n\r\nstatic const char *get_opt(int argc, char **argv, const char *name)\r\n{\r\n    for (int i = 0; i < argc - 1; i++) {\r\n        if (strcmp(argv[i], name) == 0) return argv[i+1];\r\n    }\r\n    return NULL;\r\n}\r\n\r\nstatic int write_history_file(const SolveResult *res, const char *filename)\r\n{\r\n    FILE *fp = fopen(filename, \"w\");\r\n    if (!fp) return -1;\r\n    for (int i = 0; i < res->history_len; i++) {\r\n        fprintf(fp, \"%d\\t%.15e\\n\", i, res->history[i]);\r\n    }\r\n"]
[5616.151854, "o", "    fclose(fp);\r\n    return 0;\r\n}\r\n\r\nstatic void print_solve_summary(const SolveResult *res)\r\n{\r\n    printf(\"converged: %s\\n\", res->converged ? \"yes\" : \"no\");\r\n    printf(\"iterations: %d\\n\", res->iterations);\r\n    printf(\"residual: %.6e\\n\", res->relres);\r\n    printf(\"true_residual: %.6e\\n\", res->true_residual);\r\n}\r\n\r\nstatic int validate_ssor_omega(double omega)\r\n{\r\n"]
[5616.151931, "o", "    if (!(omega > 0.0 && omega < 2.0)) {\r\n        fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n\r\n"]
[5616.152488, "o", "\u001b[?2004h"]
