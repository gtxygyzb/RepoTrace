[1145.648486, "o", "    int ny = atoi(ny_s);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.648542, "o", "    double x0 = atof(x0_s);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.648624, "o", "    double x1 = atof(x1_s);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.648709, "o", "    double y0 = atof(y0_s);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.648787, "o", "    double y1 = atof(y1_s);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.64888, "o", "    double tol = atof(tol_s);\r\n\u001b[?2004l\r\u001b[?2004h> "]
