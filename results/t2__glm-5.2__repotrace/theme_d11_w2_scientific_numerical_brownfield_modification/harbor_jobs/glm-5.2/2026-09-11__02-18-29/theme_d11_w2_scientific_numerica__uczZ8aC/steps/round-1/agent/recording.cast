[1145.64169, "o", "    int restart = restart_s ? atoi(restart_s) : 30;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.64185, "o", "    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\u001b[?2004l\r \u001b[?2004h> "]
[1145.641915, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.642061, "o", "    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.642248, "o", "        fprintf(stderr, \"Error: invalid solver parameters\\n\");\r\n\u001b[?2004l\r"]
