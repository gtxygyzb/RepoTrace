[1043.596677, "i", "python3 - <<'PY'\nfrom pathlib import Path\nfor fn in ['src/main.c','include/sparse.h','include/precond.h','include/solvers.h','include/poisson.h']:\n    print('---', fn)\n    for i,line in enumerate(Path(fn).read_text().splitlines(),1):\n        for j,ch in enumerate(line):\n            o=ord(ch)\n            if o > 127 or (o < 32 and o not in (9,)):\n                print(f'line {i} col {j+1}: {o} {repr(ch)}')\nPY\n"]
