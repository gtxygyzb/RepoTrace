[12483.526061, "o", "int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = (double *)malloc((maxiter + 1) * sizeof(double));\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = (double *)malloc((maxiter + 1) * sizeof(double));\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!res->x || !res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K || !res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K) {\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        free(res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        free(res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = 0;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[3"]
[12483.526158, "o", "2m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[0] = res->relres;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[0] = pnorm0;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = 1;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[iter] = res->relres;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[iter] = pznorm;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = iter + 1;\r\n"]
[12483.526191, "o", "\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[0] = res->relres;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K213\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[0] = pnorm0;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = 1;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[cycle] = res->relres;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[cycle] = pznorm;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = cycle + 1;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    free(res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K289\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    free(res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n"]
[12483.526774, "o", "\u001b[35m\u001b[Kinclude/solvers.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    double *\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K;        /* true relative residual at each iteration */\r\n\u001b[35m\u001b[Kinclude/solvers.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    double *precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K; /* preconditioned residual norm ||M^-1 r|| at each iteration */\r\n"]
[12483.526836, "o", "\u001b[35m\u001b[Kinclude/solvers.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len;        /* number of stored \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K entries */\r\n"]
[12483.530369, "o", "#include \"poisson.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n\r\n"]
[12483.530445, "o", "double *poisson_read_source(const char *filename, int nx, int ny)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    int rx, ry;\r\n    if (fscanf(fp, \"%d %d\", &rx, &ry) != 2 || rx != nx || ry != ny) {\r\n        fclose(fp);\r\n        return NULL;\r\n    }\r\n\r\n    int n = nx * ny;\r\n    double *f = vec_create(n);\r\n    if (!f) { fclose(fp); return NULL; }\r\n\r\n    for (int i = 0; i < n; i++) {\r\n        if (fscanf(fp, \"%lf\", &f[i]) != 1) {\r\n            free(f);\r\n            fclose(fp);\r\n            return NULL;\r\n        }\r\n"]
[12483.530519, "o", "    }\r\n\r\n    fclose(fp);\r\n    return f;\r\n}\r\n\r\ndouble *poisson_read_boundary(const char *filename, int expected)\r\n{\r\n    FILE *fp = fopen(filename, \"r\");\r\n    if (!fp) return NULL;\r\n\r\n    double *vals = (double *)malloc(expected * sizeof(double));\r\n    if (!vals) { fclose(fp); return NULL; }\r\n\r\n    int count = 0;\r\n    while (count < expected) {\r\n        double v;\r\n        if (fscanf(fp, \"%lf\", &v) != 1) break;\r\n"]
[12483.53059, "o", "        vals[count++] = v;\r\n    }\r\n\r\n    fclose(fp);\r\n    if (count != expected) { free(vals); return NULL; }\r\n    return vals;\r\n}\r\n\r\nstatic void add_coo(COOMatrix *coo, int *k, int r, int c, double v)\r\n{\r\n    coo->row[*k] = r;\r\n    coo->col[*k] = c;\r\n"]
[12483.530668, "o", "    coo->values[*k] = v;\r\n    (*k)++;\r\n}\r\n\r\nint poisson_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n                    const char *source_file, PoissonBC left, PoissonBC right,\r\n                    PoissonBC bottom, PoissonBC top,\r\n                    CSRMatrix **A_out, double **b_out)\r\n{\r\n    if (!A_out || !b_out) return -1;\r\n    *A_out = NULL;\r\n"]
[12483.530736, "o", "    *b_out = NULL;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || !source_file) return -1;\r\n\r\n    double hx = (x1 - x0) / (nx - 1);\r\n    double hy = (y1 - y0) / (ny - 1);\r\n    double hx2 = hx * hx;\r\n    double hy2 = hy * hy;\r\n\r\n    double *f = poisson_read_source(source_file, nx, ny);\r\n    if (!f) return -1;\r\n\r\n    double *left_vals = NULL;\r\n    double *right_vals = NULL;\r\n    double *bottom_vals = NULL;\r\n    double *top_vals = NULL;\r\n"]
[12483.530805, "o", "\r\n    if (left.type == POISSON_NEUMANN) { left_vals = poisson_read_boundary(left.file, ny); if (!left_vals) goto fail; }\r\n    if (right.type == POISSON_NEUMANN) { right_vals = poisson_read_boundary(right.file, ny); if (!right_vals) goto fail; }\r\n    if (bottom.type == POISSON_NEUMANN) { bottom_vals = poisson_read_boundary(bottom.file, nx); if (!bottom_vals) goto fail; }\r\n    if (top.type == POISSON_NEUMANN) { top_vals = poisson_read_boundary(top.file, nx); if (!top_vals) goto fail; }\r\n\r\n    if (left.type == POISSON_DIRICHLET) { left_vals = poisson_read_boundary(left.file, ny); if (!left_vals) goto fail; }\r\n"]
[12483.530864, "o", "    if (right.type == POISSON_DIRICHLET) { right_vals = poisson_read_boundary(right.file, ny); if (!right_vals) goto fail; }\r\n    if (bottom.type == POISSON_DIRICHLET) { bottom_vals = poisson_read_boundary(bottom.file, nx); if (!bottom_vals) goto fail; }\r\n    if (top.type == POISSON_DIRICHLET) { top_vals = poisson_read_boundary(top.file, nx); if (!top_vals) goto fail; }\r\n\r\n    int n = nx * ny;\r\n    COOMatrix *coo = coo_create(n, n, 5 * n);\r\n    double *b = vec_create(n);\r\n    if (!coo || !b) { coo_destroy(coo); free(b); goto fail; }\r\n\r\n    int k = 0;\r\n    for (int i = 0; i < nx; i++) {\r\n"]
[12483.530917, "o", "        for (int j = 0; j < ny; j++) {\r\n            int idx = i * ny + j;\r\n            int is_left = (i == 0);\r\n            int is_right = (i == nx - 1);\r\n            int is_bottom = (j == 0);\r\n            int is_top = (j == ny - 1);\r\n\r\n            if (is_left && left.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = left_vals[j];\r\n                continue;\r\n            }\r\n"]
[12483.531015, "o", "            if (is_right && right.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = right_vals[j];\r\n                continue;\r\n            }\r\n            if (is_bottom && bottom.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = bottom_vals[i];\r\n                continue;\r\n            }\r\n            if (is_top && top.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = top_vals[i];\r\n                continue;\r\n            }\r\n"]
[12483.531085, "o", "\r\n            double diag = 0.0;\r\n            double rhs = f[idx];\r\n            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;\r\n\r\n            if (is_left && left.type == POISSON_NEUMANN) {\r\n                diag += 2.0 / hx2;\r\n                c_ip = -2.0 / hx2;\r\n                rhs += 2.0 * left_vals[j] / hx;\r\n            } else if (is_right && right.type == POISSON_NEUMANN) {\r\n                diag += 2.0 / hx2;\r\n                c_im = -2.0 / hx2;\r\n                rhs += 2.0 * right_vals[j] / hx;\r\n            } else if (!is_left && !is_right) {\r\n                diag += 2.0 / hx2;\r\n                c_im = -1.0 / hx2;\r\n"]
[12483.531156, "o", "                c_ip = -1.0 / hx2;\r\n            }\r\n\r\n            if (is_bottom && bottom.type == POISSON_NEUMANN) {\r\n                diag += 2.0 / hy2;\r\n                c_jp = -2.0 / hy2;\r\n                rhs += 2.0 * bottom_vals[i] / hy;\r\n            } else if (is_top && top.type == POISSON_NEUMANN) {\r\n                diag += 2.0 / hy2;\r\n                c_jm = -2.0 / hy2;\r\n                rhs += 2.0 * top_vals[i] / hy;\r\n            } else if (!is_bottom && !is_top) {\r\n                diag += 2.0 / hy2;\r\n                c_jm = -1.0 / hy2;\r\n                c_jp = -1.0 / hy2;\r\n            }\r\n\r\n"]
[12483.53123, "o", "            add_coo(coo, &k, idx, idx, diag);\r\n            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);\r\n            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);\r\n            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);\r\n            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);\r\n            b[idx] = rhs;\r\n        }\r\n    }\r\n\r\n    coo->nnz = k;\r\n    CSRMatrix *A = coo_to_csr(coo);\r\n    coo_destroy(coo);\r\n    if (!A) { free(b); goto fail; }\r\n\r\n    free(f);\r\n    free(left_vals);\r\n    free(right_vals);\r\n"]
[12483.531295, "o", "    free(bottom_vals);\r\n    free(top_vals);\r\n\r\n    *A_out = A;\r\n    *b_out = b;\r\n    return 0;\r\n\r\nfail:\r\n    free(f);\r\n    free(left_vals);\r\n    free(right_vals);\r\n    free(bottom_vals);\r\n    free(top_vals);\r\n    return -1;\r\n"]
[12483.531358, "o", "}\r\n"]
[12483.534434, "o", "#include \"convdiff.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <math.h>\r\n\r\nstatic void add_coo(COOMatrix *coo, int *k, int r, int c, double v)\r\n{\r\n"]
[12483.534514, "o", "    coo->row[*k] = r;\r\n    coo->col[*k] = c;\r\n    coo->values[*k] = v;\r\n    (*k)++;\r\n}\r\n\r\ndouble convdiff_peclet(double vx, double vy, double hx, double hy, double kappa)\r\n{\r\n    double pe_x = fabs(vx) * hx;\r\n    double pe_y = fabs(vy) * hy;\r\n    double num = pe_x > pe_y ? pe_x : pe_y;\r\n    return num / (2.0 * kappa);\r\n}\r\n\r\nint convdiff_assemble(int nx, int ny, double x0, double x1, double y0, double y1,\r\n                      double kappa, double vx, double vy,\r\n"]
[12483.534596, "o", "                      const char *source_file, PoissonBC left, PoissonBC right,\r\n                      PoissonBC bottom, PoissonBC top,\r\n                      CSRMatrix **A_out, double **b_out)\r\n{\r\n    if (!A_out || !b_out) return -1;\r\n    *A_out = NULL;\r\n    *b_out = NULL;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || kappa <= 0.0 || !source_file) {\r\n        return -1;\r\n    }\r\n\r\n    double hx = (x1 - x0) / (nx - 1);\r\n    double hy = (y1 - y0) / (ny - 1);\r\n    double hx2 = hx * hx;\r\n    double hy2 = hy * hy;\r\n\r\n    double *f = poisson_read_source(source_file, nx, ny);\r\n    if (!f) return -1;\r\n"]
[12483.534647, "o", "\r\n    double *left_vals = NULL;\r\n    double *right_vals = NULL;\r\n    double *bottom_vals = NULL;\r\n    double *top_vals = NULL;\r\n\r\n    if (left.type == POISSON_NEUMANN) {\r\n        left_vals = poisson_read_boundary(left.file, ny);\r\n        if (!left_vals) goto fail;\r\n    }\r\n    if (right.type == POISSON_NEUMANN) {\r\n"]
[12483.53474, "o", "        right_vals = poisson_read_boundary(right.file, ny);\r\n        if (!right_vals) goto fail;\r\n    }\r\n    if (bottom.type == POISSON_NEUMANN) {\r\n        bottom_vals = poisson_read_boundary(bottom.file, nx);\r\n        if (!bottom_vals) goto fail;\r\n    }\r\n    if (top.type == POISSON_NEUMANN) {\r\n        top_vals = poisson_read_boundary(top.file, nx);\r\n        if (!top_vals) goto fail;\r\n    }\r\n\r\n    if (left.type == POISSON_DIRICHLET) {\r\n        left_vals = poisson_read_boundary(left.file, ny);\r\n        if (!left_vals) goto fail;\r\n    }\r\n    if (right.type == POISSON_DIRICHLET) {\r\n        right_vals = poisson_read_boundary(right.file, ny);\r\n        if (!right_vals) goto fail;\r\n    }\r\n"]
[12483.534821, "o", "    if (bottom.type == POISSON_DIRICHLET) {\r\n        bottom_vals = poisson_read_boundary(bottom.file, nx);\r\n        if (!bottom_vals) goto fail;\r\n    }\r\n    if (top.type == POISSON_DIRICHLET) {\r\n        top_vals = poisson_read_boundary(top.file, nx);\r\n        if (!top_vals) goto fail;\r\n    }\r\n\r\n    int n = nx * ny;\r\n    COOMatrix *coo = coo_create(n, n, 5 * n);\r\n    double *b = vec_create(n);\r\n    if (!coo || !b) {\r\n        coo_destroy(coo);\r\n        free(b);\r\n        goto fail;\r\n    }\r\n\r\n"]
[12483.53493, "o", "    int k = 0;\r\n    for (int i = 0; i < nx; i++) {\r\n        for (int j = 0; j < ny; j++) {\r\n            int idx = i * ny + j;\r\n            int is_left = (i == 0);\r\n            int is_right = (i == nx - 1);\r\n            int is_bottom = (j == 0);\r\n            int is_top = (j == ny - 1);\r\n\r\n            if (is_left && left.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = left_vals[j];\r\n                continue;\r\n            }\r\n            if (is_right && right.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = right_vals[j];\r\n"]
[12483.535016, "o", "                continue;\r\n            }\r\n            if (is_bottom && bottom.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = bottom_vals[i];\r\n                continue;\r\n            }\r\n            if (is_top && top.type == POISSON_DIRICHLET) {\r\n                add_coo(coo, &k, idx, idx, 1.0);\r\n                b[idx] = top_vals[i];\r\n                continue;\r\n            }\r\n\r\n            double diag = 0.0;\r\n            double rhs = f[idx];\r\n            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;\r\n\r\n            /* Diffusion: -kappa * laplacian(u) */\r\n            if (is_left && left.type == POISSON_NEUMANN) {\r\n"]
[12483.535095, "o", "                diag += 2.0 * kappa / hx2;\r\n                c_ip += -2.0 * kappa / hx2;\r\n                rhs += 2.0 * kappa * left_vals[j] / hx;\r\n            } else if (is_right && right.type == POISSON_NEUMANN) {\r\n                diag += 2.0 * kappa / hx2;\r\n                c_im += -2.0 * kappa / hx2;\r\n                rhs += 2.0 * kappa * right_vals[j] / hx;\r\n            } else if (!is_left && !is_right) {\r\n                diag += 2.0 * kappa / hx2;\r\n                c_im += -kappa / hx2;\r\n                c_ip += -kappa / hx2;\r\n            }\r\n\r\n"]
[12483.535171, "o", "            if (is_bottom && bottom.type == POISSON_NEUMANN) {\r\n                diag += 2.0 * kappa / hy2;\r\n                c_jp += -2.0 * kappa / hy2;\r\n                rhs += 2.0 * kappa * bottom_vals[i] / hy;\r\n            } else if (is_top && top.type == POISSON_NEUMANN) {\r\n                diag += 2.0 * kappa / hy2;\r\n                c_jm += -2.0 * kappa / hy2;\r\n                rhs += 2.0 * kappa * top_vals[i] / hy;\r\n            } else if (!is_bottom && !is_top) {\r\n                diag += 2.0 * kappa / hy2;\r\n                c_jm += -kappa / hy2;\r\n                c_jp += -kappa / hy2;\r\n            }\r\n\r\n            /* Convection: first-order upwind */\r\n            if (vx > 0.0) {\r\n"]
[12483.535254, "o", "                if (is_left && left.type == POISSON_NEUMANN) {\r\n                    diag += vx / hx;\r\n                    c_ip += -vx / hx;\r\n                    rhs += 2.0 * vx * left_vals[j];\r\n                } else {\r\n                    diag += vx / hx;\r\n                    if (i > 0) c_im += -vx / hx;\r\n                }\r\n            } else if (vx < 0.0) {\r\n                if (is_right && right.type == POISSON_NEUMANN) {\r\n                    diag += -vx / hx;\r\n                    c_im += vx / hx;\r\n                    rhs += -2.0 * vx * right_vals[j];\r\n                } else {\r\n                    diag += -vx / hx;\r\n                    if (i < nx - 1) c_ip += vx / hx;\r\n                }\r\n"]
[12483.535336, "o", "            }\r\n\r\n            if (vy > 0.0) {\r\n                if (is_bottom && bottom.type == POISSON_NEUMANN) {\r\n                    diag += vy / hy;\r\n                    c_jp += -vy / hy;\r\n                    rhs += 2.0 * vy * bottom_vals[i];\r\n                } else {\r\n                    diag += vy / hy;\r\n                    if (j > 0) c_jm += -vy / hy;\r\n                }\r\n            } else if (vy < 0.0) {\r\n                if (is_top && top.type == POISSON_NEUMANN) {\r\n                    diag += -vy / hy;\r\n                    c_jm += vy / hy;\r\n                    rhs += -2.0 * vy * top_vals[i];\r\n                } else {\r\n                    diag += -vy / hy;\r\n"]
[12483.535421, "o", "                    if (j < ny - 1) c_jp += vy / hy;\r\n                }\r\n            }\r\n\r\n            add_coo(coo, &k, idx, idx, diag);\r\n            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);\r\n            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);\r\n            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);\r\n            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);\r\n            b[idx] = rhs;\r\n        }\r\n    }\r\n\r\n    coo->nnz = k;\r\n    CSRMatrix *A = coo_to_csr(coo);\r\n    coo_destroy(coo);\r\n    if (!A) { free(b); goto fail; }\r\n\r\n    free(f);\r\n    free(left_vals);\r\n"]
[12483.5355, "o", "    free(right_vals);\r\n    free(bottom_vals);\r\n    free(top_vals);\r\n\r\n    *A_out = A;\r\n    *b_out = b;\r\n    return 0;\r\n\r\nfail:\r\n    free(f);\r\n    free(left_vals);\r\n    free(right_vals);\r\n    free(bottom_vals);\r\n    free(top_vals);\r\n    return -1;\r\n}\r\n"]
[12483.536031, "o", "\u001b[?2004h"]
[12483.536089, "o", "root@n30009:/app# "]
[12490.418391, "i", "sed -n '1,240p' include/solvers.h\n"]
[12490.418689, "o", "sed -n '1,240p' include/solvers.h\r\n"]
[12490.418798, "o", "\u001b[?2004l\r"]
[12490.421657, "o", "#ifndef SOLVERS_H\r\n#define SOLVERS_H\r\n\r\n#include \"sparse.h\"\r\n#include \"precond.h\"\r\n\r\ntypedef struct {\r\n    double *x;\r\n"]
[12490.421791, "o", "    double relres;          /* true relative residual ||b-A*x||/||b|| */\r\n    double true_residual;   /* absolute true residual norm ||b-A*x|| */\r\n    double relres_inf;      /* reported relative residual ||b-A*x||_inf / ||b||_inf */\r\n    double true_residual_inf; /* reported absolute residual ||b-A*x||_inf */\r\n    int iterations;\r\n    int converged;\r\n    double *history;        /* true relative residual at each iteration */\r\n    double *precond_history; /* preconditioned residual norm ||M^-1 r|| at each iteration */\r\n    int history_len;        /* number of stored history entries */\r\n} SolveResult;\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P);\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                           double tol, int maxiter, int m, Precond *P);\r\n\r\nvoid solve_result_destroy(SolveResult *res);\r\n\r\n#endif /* SOLVERS_H */\r\n"]
[12490.422287, "o", "\u001b[?2004h"]
[12490.422379, "o", "root@n30009:/app# "]
[12490.694568, "i", "sed -n '1,360p' src/solvers.c\n"]
[12490.694841, "o", "sed -n '1,360p' src/solvers.c\r\n\u001b[?2004l\r"]
[12490.697916, "o", "#include \"solvers.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <math.h>\r\n#include <string.h>\r\n\r\nstatic SolveResult *result_create(int n, int maxiter)\r\n{\r\n    if (maxiter < 0) maxiter = 0;\r\n    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    if (!res) return NULL;\r\n\r\n    res->x = vec_create(n);\r\n"]
[12490.698042, "o", "    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    res->precond_history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    if (!res->x || !res->history || !res->precond_history) {\r\n        free(res->x);\r\n        free(res->history);\r\n        free(res->precond_history);\r\n        free(res);\r\n        return NULL;\r\n    }\r\n    res->history_len = 0;\r\n    return res;\r\n}\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *p = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    if (!r || !z || !p || !Ap) {\r\n"]
[12490.698134, "o", "        free(r); free(z); free(p); free(Ap);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n    double bnorm_inf = vec_norm_inf(b, n);\r\n    if (bnorm_inf == 0.0) bnorm_inf = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    res->true_residual_inf = vec_norm_inf(r, n);\r\n    res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n"]
[12490.698219, "o", "    precond_apply(P, A, r, z);\r\n    double pnorm0 = vec_norm2(z, n);\r\n    res->history[0] = res->relres;\r\n    res->precond_history[0] = pnorm0;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n\r\n    if (precond_apply(P, A, r, z) != 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n"]
[12490.698268, "o", "    }\r\n    vec_copy(z, p, n);\r\n    double rz_old = vec_dot(r, z, n);\r\n\r\n    for (int iter = 1; iter <= maxiter; iter++) {\r\n        csr_spmv(A, p, Ap);\r\n        double pAp = vec_dot(p, Ap, n);\r\n        if (fabs(pAp) < 1e-30) break;\r\n\r\n        double alpha = rz_old / pAp;\r\n        vec_axpy(alpha, p, res->x, n);\r\n"]
[12490.698378, "o", "        vec_axpy(-alpha, Ap, r, n);\r\n\r\n        /* Recompute the true residual rather than relying on the recurrence. */\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n        res->relres = res->true_residual / bnorm;\r\n        res->true_residual_inf = vec_norm_inf(r, n);\r\n        res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n        precond_apply(P, A, r, z);\r\n        double pznorm = vec_norm2(z, n);\r\n        res->history[iter] = res->relres;\r\n        res->precond_history[iter] = pznorm;\r\n        res->history_len = iter + 1;\r\n        res->iterations = iter;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n"]
[12490.698461, "o", "        double rz_new = vec_dot(r, z, n);\r\n        if (fabs(rz_old) < 1e-30) break;\r\n        double beta = rz_new / rz_old;\r\n        vec_scale(beta, p, n);\r\n        vec_axpy(1.0, z, p, n);\r\n        rz_old = rz_new;\r\n    }\r\n\r\n    free(r); free(z); free(p); free(Ap);\r\n    return res;\r\n}\r\n\r\nstatic void apply_givens(double *a, double *b, double c, double s)\r\n{\r\n    double t = c * (*a) + s * (*b);\r\n    *b = -s * (*a) + c * (*b);\r\n    *a = t;\r\n}\r\n\r\nstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n{\r\n    if (kdim <= 0) return -1;\r\n"]
[12490.698544, "o", "\r\n    double *c = (double *)malloc(m * sizeof(double));\r\n    double *s = (double *)malloc(m * sizeof(double));\r\n    if (!c || !s) { free(c); free(s); return -1; }\r\n\r\n    for (int i = 0; i < kdim; i++) {\r\n        for (int k = 0; k < i; k++) {\r\n            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n        }\r\n\r\n        double a = H[i*m+i];\r\n        double b = H[(i+1)*m+i];\r\n        if (b == 0.0) {\r\n            c[i] = 1.0;\r\n            s[i] = 0.0;\r\n        } else {\r\n"]
[12490.698624, "o", "            double r = hypot(a, b);\r\n            c[i] = a / r;\r\n            s[i] = b / r;\r\n        }\r\n        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n\r\n    }\r\n\r\n    for (int i = kdim - 1; i >= 0; i--) {\r\n        double sum = g[i];\r\n        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n        y[i] = sum / H[i*m+i];\r\n    }\r\n\r\n    free(c);\r\n    free(s);\r\n"]
[12490.698704, "o", "    return 0;\r\n}\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                           double tol, int maxiter, int m, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (m <= 0) m = 30;\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n"]
[12490.698787, "o", "    double *Ap = vec_create(n);\r\n    double *Av = vec_create(n);\r\n    double *w = vec_create(n);\r\n    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n    double *y = (double *)malloc(m * sizeof(double));\r\n    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n\r\n    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n"]
[12490.698883, "o", "    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n    double bnorm_inf = vec_norm_inf(b, n);\r\n    if (bnorm_inf == 0.0) bnorm_inf = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    res->true_residual_inf = vec_norm_inf(r, n);\r\n    res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n    precond_apply(P, A, r, z);\r\n    double pnorm0 = vec_norm2(z, n);\r\n    res->history[0] = res->relres;\r\n    res->precond_history[0] = pnorm0;\r\n"]
[12490.69897, "o", "    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        return res;\r\n    }\r\n\r\n    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double beta = vec_norm2(z, n);\r\n        if (beta == 0.0) break;\r\n\r\n        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n        g[0] = beta;\r\n        memset(H, 0, (m + 1) * m * sizeof(double));\r\n\r\n        int kdim = 0;\r\n        int fail = 0;\r\n"]
[12490.69905, "o", "        for (int j = 0; j < m; j++) {\r\n            csr_spmv(A, V + j * n, Av);\r\n            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n\r\n            for (int i = 0; i <= j; i++) {\r\n                double h = vec_dot(w, V + i * n, n);\r\n                H[i*m+j] = h;\r\n                vec_axpy(-h, V + i * n, w, n);\r\n            }\r\n\r\n            double hnorm = vec_norm2(w, n);\r\n            H[(j+1)*m+j] = hnorm;\r\n            kdim = j + 1;\r\n\r\n            if (hnorm < 1e-14) break;\r\n\r\n"]
[12490.699131, "o", "            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n        }\r\n        if (fail) break;\r\n        if (kdim == 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n        res->relres = res->true_residual / bnorm;\r\n        res->true_residual_inf = vec_norm_inf(r, n);\r\n"]
[12490.69921, "o", "        res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n        precond_apply(P, A, r, z);\r\n        double pznorm = vec_norm2(z, n);\r\n        res->history[cycle] = res->relres;\r\n        res->precond_history[cycle] = pznorm;\r\n        res->history_len = cycle + 1;\r\n        res->iterations = cycle;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n    }\r\n\r\n    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n    return res;\r\n}\r\n\r\nvoid solve_result_destroy(SolveResult *res)"]
[12490.699286, "o", "\r\n{\r\n    if (!res) return;\r\n    free(res->x);\r\n    free(res->history);\r\n    free(res->precond_history);\r\n    free(res);\r\n}\r\n"]
[12490.699761, "o", "\u001b[?2004h"]
[12490.699838, "o", "root@n30009:/app# "]
[12490.972328, "i", "grep -R \"write_history\\|history_file\\|history\" -n src include tests 2>/dev/null\n"]
[12490.973563, "o", "grep -R \"write_history\\|history_file\\|history\" -n src include tests 2>/dev/null\r\n\u001b[?2004l\r"]
[12490.976421, "o", "\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K <file>]\\n\", prog);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K <file>]\\n\", prog);\r\n"]
[12490.976546, "o", "\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"  %s convdiff --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --kappa <float> --vx <float> --vy <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] --output <file> [--\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K <file>]\\n\", prog);\r\n"]
[12490.976762, "o", "\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic int \u001b[01;31m\u001b[Kwrite_history\u001b[m\u001b[K_file(const SolveResult *res, const char *filename)\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    for (int i = 0; i < res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len; i++) {\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fprintf(fp, \"%d\\t%.15e\\t%.15e\\n\", i, res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[i], res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[i]);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                                const char *\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K)\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K && \u001b[01;31m\u001b[Kwrite_history\u001b[m\u001b[K_file(res, \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K) != 0) {\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fprintf(stderr, \"Error: cannot write \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K to '%s'\\n\", \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K"]
[12490.976915, "o", "\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K208\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const char *\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = get_opt(argc, argv, \"--\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K\");\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K278\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const char *\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = get_opt(argc, argv, \"--\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K\");\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const char *\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = get_opt(argc, argv, \"--\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K\");\r\n\u001b[35m\u001b[Ksrc/main.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K482\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, outp"]
[12490.976981, "o", "ut, \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = (double *)malloc((maxiter + 1) * sizeof(double));\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = (double *)malloc((maxiter + 1) * sizeof(double));\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!res->x || !res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K || !res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K) {\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        free(res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        free(res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = 0;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[0] = res->relres;\r\n\u001b[35m\u001b"]
[12490.97705, "o", "[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[0] = pnorm0;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = 1;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[iter] = res->relres;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[iter] = pznorm;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = iter + 1;\r\n"]
[12490.977115, "o", "\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[0] = res->relres;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K213\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[0] = pnorm0;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = 1;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[cycle] = res->relres;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[cycle] = pznorm;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = cycle + 1;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    free(res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K289\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    free(res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n"]
[12490.977698, "o", "\u001b[35m\u001b[Kinclude/solvers.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    double *\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K;        /* true relative residual at each iteration */\r\n\u001b[35m\u001b[Kinclude/solvers.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    double *precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K; /* preconditioned residual norm ||M^-1 r|| at each iteration */\r\n"]
[12490.97776, "o", "\u001b[35m\u001b[Kinclude/solvers.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len;        /* number of stored \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K entries */\r\n"]
