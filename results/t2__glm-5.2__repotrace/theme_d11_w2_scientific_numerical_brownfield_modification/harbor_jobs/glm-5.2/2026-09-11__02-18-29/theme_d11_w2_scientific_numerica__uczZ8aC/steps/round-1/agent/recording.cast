[12508.842688, "o", "     1\t#include \"solvers.h\"\r\n     2\t#include \"vector.h\"\r\n     3\t#include <stdlib.h>\r\n     4\t#include <math.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n"]
[12508.842785, "o", "     7\tstatic SolveResult *result_create(int n, int maxiter)\r\n     8\t{\r\n     9\t    if (maxiter < 0) maxiter = 0;\r\n    10\t    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    11\t    if (!res) return NULL;\r\n    12\t\r\n    13\t    res->x = vec_create(n);\r\n    14\t    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    15\t    res->precond_history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    16\t    if (!res->x || !res->history || !res->precond_history) {\r\n    17\t        free(res->x);\r\n    18\t        free(res->history);\r\n    19\t        free(res->precond_history);\r\n    20\t        free(res);\r\n    21\t        return NULL;\r\n    22"]
[12508.842892, "o", "\t    }\r\n    23\t    res->history_len = 0;\r\n    24\t    return res;\r\n    25\t}\r\n    26\t\r\n    27\tSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n    28\t                      double tol, int maxiter, Precond *P)\r\n    29\t{\r\n    30\t    if (!A || !b || A->rows != A->cols) return NULL;\r\n    31\t    int n = A->rows;\r\n    32\t    if (maxiter < 0) maxiter = 0;\r\n    33\t\r\n    34\t    SolveResult *res = result_create(n, maxiter);\r\n    35\t    if (!res) return NULL;\r\n"]
[12508.842957, "o", "    36\t\r\n    37\t    double *r = vec_create(n);\r\n    38\t    double *z = vec_create(n);\r\n    39\t    double *p = vec_create(n);\r\n    40\t    double *Ap = vec_create(n);\r\n    41\t    if (!r || !z || !p || !Ap) {\r\n    42\t        free(r); free(z); free(p); free(Ap);\r\n    43\t        solve_result_destroy(res);\r\n    44\t"]
[12508.843017, "o", "        return NULL;\r\n    45\t    }\r\n    46\t\r\n    47\t    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n    48\t\r\n    49\t    csr_spmv(A, res->x, Ap);\r\n    50\t    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n    51\t\r\n    52\t    double bnorm = vec_norm2(b, n);\r\n"]
[12508.843081, "o", "    53\t    if (bnorm == 0.0) bnorm = 1.0;\r\n    54\t    double bnorm_inf = vec_norm_inf(b, n);\r\n    55\t    if (bnorm_inf == 0.0) bnorm_inf = 1.0;\r\n    56\t\r\n    57\t    res->true_residual = vec_norm2(r, n);\r\n    58\t    res->relres = res->true_residual / bnorm;\r\n    59\t    res->true_residual_inf = vec_norm_inf(r, n);\r\n    60\t    res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n    61\t    precond_apply(P, A, r, z);"]
[12508.843143, "o", "\r\n    62\t    double pnorm0 = vec_norm2(z, n);\r\n    63\t    res->history[0] = res->relres;\r\n    64\t    res->precond_history[0] = pnorm0;\r\n    65\t    res->history_len = 1;\r\n    66\t    res->converged = (res->relres < tol) ? 1 : 0;\r\n    67\t    res->iterations = 0;\r\n    68\t    if (res->converged || maxiter == 0) {\r\n    69\t        free(r); free(z); free(p); free(Ap);\r\n    70\t        return res;\r\n"]
[12508.843206, "o", "    71\t    }\r\n    72\t\r\n    73\t    if (precond_apply(P, A, r, z) != 0) {\r\n    74\t        free(r); free(z); free(p); free(Ap);\r\n    75\t        return res;\r\n    76\t    }\r\n    77\t    vec_copy(z, p, n);\r\n    78\t    double rz_old = vec_dot(r, z, n);\r\n"]
[12508.843274, "o", "    79\t\r\n    80\t    for (int iter = 1; iter <= maxiter; iter++) {\r\n    81\t        csr_spmv(A, p, Ap);\r\n    82\t        double pAp = vec_dot(p, Ap, n);\r\n    83\t        if (fabs(pAp) < 1e-30) break;\r\n    84\t\r\n    85\t        double alpha = rz_old / pAp;\r\n    86\t        vec_axpy(alpha, p, res->x, n);\r\n    87\t        vec_axpy(-alpha, Ap, r, n);\r\n    88\t\r\n    89\t        /* Recompute the true residual rather than relying on the recurrence. */\r\n    90\t        csr_spmv(A, res->x, Ap);\r\n"]
[12508.843333, "o", "    91\t        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n    92\t\r\n    93\t        res->true_residual = vec_norm2(r, n);\r\n    94\t        res->relres = res->true_residual / bnorm;\r\n    95\t        res->true_residual_inf = vec_norm_inf(r, n);\r\n    96\t        res->relres_inf = res->true_residual_inf / bnorm_inf;\r\n    97\t        precond_apply(P, A, r, z);\r\n    98\t        double pznorm = vec_norm2(z, n);\r\n    99"]
[12508.84339, "o", "\t        res->history[iter] = res->relres;\r\n   100\t        res->precond_history[iter] = pznorm;\r\n   101\t        res->history_len = iter + 1;\r\n   102\t        res->iterations = iter;\r\n   103\t\r\n   104\t        if (res->relres < tol) {\r\n   105\t            res->converged = 1;\r\n   106\t            break;\r\n   107\t        }\r\n   108\t\r\n"]
[12508.84346, "o", "   109\t        if (precond_apply(P, A, r, z) != 0) break;\r\n   110\t        double rz_new = vec_dot(r, z, n);\r\n   111\t        if (fabs(rz_old) < 1e-30) break;\r\n   112\t        double beta = rz_new / rz_old;\r\n   113\t        vec_scale(beta, p, n);\r\n   114\t        vec_axpy(1.0, z, p, n);\r\n   115\t        rz_old = rz_new;\r\n   116\t    }\r\n   117\t\r\n   118\t    free(r); free(z); free(p); free(Ap);\r\n   119\t    return res;\r\n   120"]
[12508.843516, "o", "\t}\r\n"]
