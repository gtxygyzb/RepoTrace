[10099.082516, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/main.c')\ns = p.read_text()\n\ns = s.replace(\n'''    int rows = A->rows;\n    int cols = A->cols;\n    int nnz = A->nnz;\n\n    int symmetric = 0;''',\n'''    int rows = A->rows;\n    int cols = A->cols;\n\n    int symmetric = 0;'''\n)\n\ns = s.replace(\n'''    int bandwidth = 0;\n    double frobenius_norm = 0.0;\n    double max_abs_value = 0.0;\n    double min_abs_nonzero = 0.0;\n\n    for (int i = 0; i < A->rows; i++) {\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\n            int j = A->col_indices[k];\n            double v = A->values[k];\n            double av = fabs(v);\n\n            int bw = i - j;\n            if (bw < 0) bw = -bw;\n            if (bw > bandwidth) bandwidth = bw;\n\n            frobenius_norm += v * v;\n\n            if (av > max_abs_value) max_abs_value = av;\n            if (av != 0.0) {\n                if (min_abs_nonzero == 0.0 || av < min_abs_nonzero) {\n                    min_abs_nonzero = av;\n                }\n            }\n        }\n"]
[10099.082852, "i", "    }\n''',\n'''    int bandwidth = 0;\n    int nonzero_count = 0;\n    double frobenius_norm = 0.0;\n    double max_abs_value = 0.0;\n    double min_abs_nonzero = 0.0;\n\n    for (int i = 0; i < A->rows; i++) {\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\n            int j = A->col_indices[k];\n            double v = A->values[k];\n            double av = fabs(v);\n\n            frobenius_norm += v * v;\n\n            if (av > max_abs_value) max_abs_value = av;\n\n            if (av != 0.0) {\n                nonzero_count++;\n\n                int bw = i - j;\n                if (bw < 0) bw = -bw;\n                if (bw > bandwidth) bandwidth = bw;\n\n                if (min_abs_nonzero == 0.0 || av < min_abs_nonzero) {\n                    min_abs_nonzero = av;\n                }\n            }\n        }\n    }\n'''\n)\n\ns = s.replace('''    printf(\"nnz: %d\\\\n\", nnz);''', '''    printf(\"nnz: %d\\\\n\", nonzero_count);''')\n\np.write_text(s)\nPY\n"]
[10099.082988, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
