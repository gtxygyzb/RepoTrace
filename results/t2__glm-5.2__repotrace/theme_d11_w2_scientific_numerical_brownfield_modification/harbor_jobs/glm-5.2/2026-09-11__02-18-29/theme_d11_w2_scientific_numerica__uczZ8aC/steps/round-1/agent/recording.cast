[5643.917582, "o", "static int cmd_poisson(int argc, char **argv)\r\n{\r\n    const char *nx_s = get_opt(argc, argv, \"--nx\");\r\n    const char *ny_s = get_opt(argc, argv, \"--ny\");\r\n"]
[5643.917672, "o", "    const char *x0_s = get_opt(argc, argv, \"--x0\");\r\n    const char *x1_s = get_opt(argc, argv, \"--x1\");\r\n    const char *y0_s = get_opt(argc, argv, \"--y0\");\r\n    const char *y1_s = get_opt(argc, argv, \"--y1\");\r\n    const char *source = get_opt(argc, argv, \"--source\");\r\n    const char *bc_left_s = get_opt(argc, argv, \"--bc-left\");\r\n    const char *bc_right_s = get_opt(argc, argv, \"--bc-right\");\r\n    const char *bc_bottom_s = get_opt(argc, argv, \"--bc-bottom\");\r\n    const char *bc_top_s = get_opt(argc, argv, \"--bc-top\");\r\n    const char *solver = get_opt(argc, argv, \"--solver\");\r\n    const char *precond = get_opt(argc, argv, \"--precond\");\r\n    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n    const char *output = get_opt(argc, argv, \"--output\");\r\n    const char *history = get_opt(argc, argv, \"--history\");"]
[5643.917759, "o", "\r\n\r\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||\r\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n        !solver || !precond || !tol_s || !maxiter_s) {\r\n        fprintf(stderr, \"Error: poisson requires grid, source, boundary condition, solver, precond, tol, maxiter\\n\");\r\n        usage(\"numsim\");\r\n        return 1;\r\n    }\r\n\r\n    int nx = atoi(nx_s);\r\n    int ny = atoi(ny_s);\r\n    double x0 = atof(x0_s);\r\n    double x1 = atof(x1_s);\r\n    double y0 = atof(y0_s);\r\n    double y1 = atof(y1_s);\r\n    double tol = atof(tol_s);\r\n"]
[5643.917822, "o", "    int maxiter = atoi(maxiter_s);\r\n    int restart = restart_s ? atoi(restart_s) : 30;\r\n    double omega = omega_s ? atof(omega_s) : 1.0;\r\n\r\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\r\n        fprintf(stderr, \"Error: invalid poisson parameters\\n\");\r\n        return 1;\r\n    }\r\n    if (validate_ssor_omega(omega) != 0) {\r\n        return 1;\r\n    }\r\n\r\n    PoissonBC left, right, bottom, top;\r\n"]
[5643.917924, "o", "    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\r\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\r\n        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    CSRMatrix *A = NULL;\r\n    double *b = NULL;\r\n    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {\r\n        fprintf(stderr, \"Error: cannot assemble Poisson system\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n\r\n    free(b);\r\n    csr_destroy(A);\r\n    return rc;\r\n}\r\n"]
