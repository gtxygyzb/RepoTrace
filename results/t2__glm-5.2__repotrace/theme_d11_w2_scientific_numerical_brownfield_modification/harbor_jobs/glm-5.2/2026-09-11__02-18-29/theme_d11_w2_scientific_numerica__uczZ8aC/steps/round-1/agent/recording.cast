[1145.595573, "i", "cat > src/main.c <<'EOF'\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"dense.h\"\n#include \"vector.h\"\n#include \"io.h\"\n#include \"sparse.h\"\n#include \"precond.h\"\n#include \"solvers.h\"\n#include \"poisson.h\"\n\nstatic void usage(const char *prog)\n{\n    fprintf(stderr, \"Usage:\\n\");\n    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\n\", prog);\n    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <value>] [--output <file>] [--history <file>]\\n\", prog);\n    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> --x0 <float> --x1 <float> --y0 <float> --y1 <float> --source <file> --bc-left <dirichlet|neumann>:<file> --bc-right <dirichlet|neumann>:<file> --bc-bottom <dirichlet|neumann>:<file> --bc-top <dirichlet|neumann>:<file> --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> --tol <value> --maxiter <value> [--restart <m>] [--ssor-omega <val"]
