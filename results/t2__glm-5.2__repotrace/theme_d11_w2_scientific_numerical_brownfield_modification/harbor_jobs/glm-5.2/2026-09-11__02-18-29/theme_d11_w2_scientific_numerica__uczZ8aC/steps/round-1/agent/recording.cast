[11068.280317, "o", "\t        return 1;\r\n   497\t    }\r\n   498\t\r\n   499\t    CSRMatrix *A = csr_read_mm(input);\r\n   500\t    if (!A) {\r\n   501\t        fprintf(stderr, \"error: cannot read matrix file\\n\");\r\n   502\t        return 1;\r\n   503\t    }\r\n   504\t\r\n   505\t    int rows = A->rows;\r\n"]
[11068.280379, "o", "   506\t    int cols = A->cols;\r\n   507\t\r\n   508\t    int symmetric = 0;\r\n   509\t    if (rows == cols) {\r\n   510\t        symmetric = 1;\r\n   511\t        for (int i = 0; i < rows && symmetric; i++) {\r\n   512\t            for (int k = A->row_ptr[i]; k < A->row_ptr[i+1] && symmetric; k++) {\r\n   513\t                int j = A->col_indices[k];\r\n   514\t                double v = A->values[k];\r\n   515\t\r\n"]
[11068.280442, "o", "   516\t                int idx = -1;\r\n   517\t                for (int l = A->row_ptr[j]; l < A->row_ptr[j+1]; l++) {\r\n   518\t                    if (A->col_indices[l] == i) {\r\n   519\t                        idx = l;\r\n   520\t                        break;\r\n   521\t                    }\r\n   522\t                }\r\n"]
[11068.280504, "o", "   523\t                if (idx < 0) {\r\n   524\t                    symmetric = 0;\r\n   525\t                    break;\r\n   526\t                }\r\n   527\t\r\n   528\t                double vt = A->values[idx];\r\n   529\t                double diff = fabs(v - vt);\r\n   530\t                double denom = fmax(fabs(v), fmax(fabs(vt), 1e-30));\r\n   531\t                if (diff >= 1e-12 * denom) {\r\n   532\t                    symmetric = 0;\r\n"]
[11068.28057, "o", "   533\t                    break;\r\n   534\t                }\r\n   535\t            }\r\n   536\t        }\r\n   537\t    }\r\n   538\t\r\n   539\t    int bandwidth = 0;\r\n   540\t    int nonzero_count = 0;\r\n   541\t    double frobenius_norm = 0.0;\r\n"]
[11068.280633, "o", "   542\t    double max_abs_value = 0.0;\r\n   543\t    double min_abs_nonzero = 0.0;\r\n   544\t\r\n   545\t    for (int i = 0; i < A->rows; i++) {\r\n   546\t        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n   547\t            int j = A->col_indices[k];\r\n   548\t            double v = A->values[k];\r\n   549\t            double av = fabs(v);\r\n   550\t\r\n   551\t            frobenius_norm += v * v;\r\n   552"]
[11068.280695, "o", "\t\r\n   553\t            if (av > max_abs_value) max_abs_value = av;\r\n   554\t\r\n   555\t            if (av != 0.0) {\r\n   556\t                nonzero_count++;\r\n   557\t\r\n   558\t                int bw = i - j;\r\n   559\t                if (bw < 0) bw = -bw;\r\n   560\t                if (bw > bandwidth) bandwidth = bw;\r\n"]
[11068.280756, "o", "   561\t\r\n   562\t                if (min_abs_nonzero == 0.0 || av < min_abs_nonzero) {\r\n   563\t                    min_abs_nonzero = av;\r\n   564\t                }\r\n   565\t            }\r\n   566\t        }\r\n   567\t    }\r\n   568\t\r\n   569\t    frobenius_norm = sqrt(frobenius_norm);\r\n   570"]
[11068.280827, "o", "\t\r\n   571\t    int strict = 1;\r\n   572\t    int weak = 1;\r\n   573\t    for (int i = 0; i < A->rows; i++) {\r\n   574\t        double diag = 0.0;\r\n   575\t        double offsum = 0.0;\r\n   576\t\r\n   577\t        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n   578\t            int j = A->col_indices[k];\r\n   579\t            if (j == i) {\r\n   580\t                diag = A->values[k];\r\n   581\t"]
[11068.28098, "o", "            } else {\r\n   582\t                offsum += fabs(A->values[k]);\r\n   583\t            }\r\n   584\t        }\r\n   585\t\r\n   586\t        if (fabs(diag) > offsum) {\r\n"]
[11068.281056, "o", "   587\t            continue;\r\n   588\t        }\r\n   589\t        if (fabs(diag) >= offsum) {\r\n   590\t            strict = 0;\r\n   591\t        } else {\r\n   592\t            strict = 0;\r\n   593\t            weak = 0;\r\n   594\t            break;\r\n   595\t        }\r\n   596\t    }\r\n   597\t\r\n   598\t    const char *diagonal_dominance = strict ? \"strict\" : (weak ? \"weak\" : \"none\");\r\n   599\t\r\n   600\t    printf(\"rows: %d\\n\", rows);\r\n   601\t    printf(\"cols: %d\\n\", cols);\r\n   602\t    printf(\"nnz: %d\\n\", nonzero_count);\r\n   603\t    printf(\"symmetric: %s\\n\", symmetric ? \"yes\" : \"no\");\r\n   604\t    printf(\"bandwidth: %d\\n\", bandwidth);\r\n   605\t    printf(\"frobenius_norm: %.15e\\n\", frobenius_norm);\r\n   606\t    printf(\"diagonal_dominance: %s\\n\", diagonal_dominance);\r\n   607\t    printf(\"max_abs_value: %.15e\\n\", max_abs_value);\r\n   608\t    printf(\"min_abs_nonzero: %.15e\\n\", min_abs_nonzero);\r\n   609\t\r\n   610\t    csr_destroy(A);\r\n   611\t    return 0;\r\n   612\t}\r\n   613\t\r\n   614\tint main(int argc, char **argv)\r\n   615\t{\r\n"]
