[11119.645232, "o", "\t/* Conversions */\r\n    57\tCOOMatrix  *csr_to_coo(const CSRMatrix *A);\r\n    58\tCSRMatrix  *coo_to_csr(const COOMatrix *A);\r\n    59\t\r\n    60\t/* Operations */\r\n    61\tvoid        csr_spmv(const CSRMatrix *A, const double *x, double *y);\r\n    62\tCSRMatrix  *csr_transpose(const CSRMatrix *A);\r\n    63\tint         csr_is_symmetric(const CSRMatrix *A, double tol);\r\n"]
