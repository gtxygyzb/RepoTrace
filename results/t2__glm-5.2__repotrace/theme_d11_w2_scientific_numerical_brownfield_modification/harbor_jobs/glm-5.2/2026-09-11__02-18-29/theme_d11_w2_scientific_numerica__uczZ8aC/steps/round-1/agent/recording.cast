[9769.508461, "o", "\u001b[32m\u001b[K502\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else if (\u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(cmd, \"heat\") == 0) {\r\n\u001b[32m\u001b[K503\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        return \u001b[01;31m\u001b[Kcmd_\u001b[m\u001b[Kheat(argc - 2, argv + 2);\r\n\u001b[32m\u001b[K504\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else if (\u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(cmd, \"convdiff\") == 0) {\r\n\u001b[32m\u001b[K505\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        return \u001b[01;31m\u001b[Kcmd_\u001b[m\u001b[Kconvdiff(argc - 2, argv + 2);\r\n\u001b[32m\u001b[K506\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else if (\u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(cmd, \"--help\") == 0 || \u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(cmd, \"-h\") == 0) {\r\n\u001b[32m\u001b[K507\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kusage\u001b[m\u001b[K(argv[0]);\r\n\u001b[32m\u001b[K509\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else if (\u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(cmd, \"eigenvalue\") == 0) {\r\n"]
