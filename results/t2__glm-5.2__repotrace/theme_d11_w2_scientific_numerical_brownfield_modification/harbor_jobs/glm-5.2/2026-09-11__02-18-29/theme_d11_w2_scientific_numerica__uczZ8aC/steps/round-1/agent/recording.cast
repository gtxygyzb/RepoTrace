[491.905027, "i", "cat >> src/sparse.c <<'EOF'\n\nstatic int mm_parse_header(const char *line, int *is_array, int *is_symmetric)\n{\n    char buf[1024];\n    strncpy(buf, line, sizeof(buf)-1);\n    buf[sizeof(buf)-1] = '\\0';\n\n    char *tok = strtok(buf, \" \\t\\r\\n\");\n    if (!tok || strcmp(tok, \"%%MatrixMarket\") != 0) return -1;\n\n    tok = strtok(NULL, \" \\t\\r\\n\");\n    if (!tok || strcmp(tok, \"matrix\") != 0) return -1;\n\n    tok = strtok(NULL, \" \\t\\r\\n\");\n    if (!tok) return -1;\n    if (strcmp(tok, \"coordinate\") == 0) *is_array = 0;\n    else if (strcmp(tok, \"array\") == 0) *is_array = 1;\n    else return -1;\n\n    tok = strtok(NULL, \" \\t\\r\\n\");\n    if (!tok) return -1;\n    if (strcmp(tok, \"real\") != 0 && strcmp(tok, \"double\") != 0) return -1;\n\n    *is_symmetric = 0;\n    tok = strtok(NULL, \" \\t\\r\\n\");\n    if (tok && strcmp(tok, \"symmetric\") == 0) *is_symmetric = 1;\n\n    return 0;\n}\n\nstatic int read_non_comment_line(FILE *fp, char *buf, int bufsize)\n{\n    while (fgets(buf, bufsize, fp)) {\n        char *s = buf;\n        while (*s == ' ' || *s"]
[491.905408, "i", " == '\\t') s++;\n        if (*s == '%' || *s == '\\n' || *s == '\\r' || *s == '\\0') continue;\n        return 0;\n    }\n    return -1;\n}\n\nCSRMatrix *csr_read_mm(const char *filename)\n{\n    FILE *fp = fopen(filename, \"r\");\n    if (!fp) return NULL;\n\n    char line[1024];\n    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }\n    int is_array = 0, is_symmetric = 0;\n    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || is_array) {\n        fclose(fp);\n        return NULL;\n    }\n\n    int rows, cols, nnz;\n    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }\n    if (sscanf(line, \"%d %d %d\", &rows, &cols, &nnz) != 3 || rows <= 0 || cols <= 0 || nnz < 0) {\n        fclose(fp);\n        return NULL;\n    }\n\n    int cap = is_symmetric ? 2 * nnz + 1 : nnz;\n    if (cap < 1) cap = 1;\n    COOMatrix *coo = coo_create(rows, cols, cap);\n    if (!coo) { fclose(fp); return NULL; }\n\n    int k = 0;\n    while (k < coo->nnz && read_non_comment_line(fp, line, sizeof(line)) == 0) {\n   "]
[491.905574, "o", "cat >> src/sparse.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[491.905694, "i", "     int r, c;\n        double v;\n        if (sscanf(line, \"%d %d %lf\", &r, &c, &v) != 3) continue;\n        if (r < 1 || r > rows || c < 1 || c > cols) continue;\n        r--; c--;\n\n        coo->row[k] = r;\n        coo->col[k] = c;\n        coo->values[k] = v;\n        k++;\n\n        if (is_symmetric && r != c) {\n            coo->row[k] = c;\n            coo->col[k] = r;\n            coo->values[k] = v;\n            k++;\n        }\n    }\n    coo->nnz = k;\n\n    CSRMatrix *A = coo_to_csr(coo);\n    coo_destroy(coo);\n    fclose(fp);\n    return A;\n}\n\nint csr_write_mm(const CSRMatrix *A, const char *filename)\n{\n    FILE *fp = fopen(filename, \"w\");\n    if (!fp) return -1;\n\n    fprintf(fp, \"%%%%MatrixMarket matrix coordinate real general\\n\");\n    fprintf(fp, \"%d %d %d\\n\", A->rows, A->cols, A->nnz);\n    for (int i = 0; i < A->rows; i++) {\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\n            fprintf(fp, \"%d %d %.15g\\n\", i+1, A->col_indices[k]+1, A->values[k]);\n        }\n    }\n    fclose(fp);\n    return 0;"]
[491.905767, "o", "\u001b[?2004h> "]
[491.905842, "i", "\n}\n\ndouble *vec_read_mm_array(const char *filename, int *n_out)\n{\n    FILE *fp = fopen(filename, \"r\");\n    if (!fp) return NULL;\n\n    char line[1024];\n    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }\n    int is_array = 0, is_symmetric = 0;\n    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || !is_array) {\n        fclose(fp);\n        return NULL;\n    }\n\n    int rows, cols;\n    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }\n    if (sscanf(line, \"%d %d\", &rows, &cols) != 2 || rows <= 0 || cols != 1) {\n        fclose(fp);\n        return NULL;\n    }\n\n    double *x = vec_create(rows);\n    if (!x) { fclose(fp); return NULL; }\n\n    int i = 0;\n    while (i < rows && read_non_comment_line(fp, line, sizeof(line)) == 0) {\n        double v;\n        if (sscanf(line, \"%lf\", &v) != 1) { free(x); fclose(fp); return NULL; }\n        x[i++] = v;\n    }\n    if (i != rows) { free(x); fclose(fp); return NULL; }\n\n    fclose(fp);\n    *n_out = rows;\n    return x;\n}\n\nin"]
[491.905931, "i", "t vec_write_mm_array(const double *x, int n, const char *filename)\n{\n    FILE *fp = fopen(filename, \"w\");\n    if (!fp) return -1;\n    fprintf(fp, \"%%%%MatrixMarket matrix array real general\\n\");\n    fprintf(fp, \"%d 1\\n\", n);\n    for (int i = 0; i < n; i++) {\n        fprintf(fp, \"%.15g\\n\", x[i]);\n    }\n    fclose(fp);\n    return 0;\n}\nEOF\n"]
