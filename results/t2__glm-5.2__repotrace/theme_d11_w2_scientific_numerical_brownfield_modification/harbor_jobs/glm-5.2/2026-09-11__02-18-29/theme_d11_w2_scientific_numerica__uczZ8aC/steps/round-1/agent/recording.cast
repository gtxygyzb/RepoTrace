[2132.402188, "o", "-rw-rw-r-- 1 root root   351 Sep 10 18:38 Makefile\r\n-rw-rw-r-- 1 root root   666 Apr  8 17:13 README.md\r\ndrwxrwxr-x 2 root root  4096 Jul 21 12:50 \u001b[01;34mdata\u001b[0m\r\ndrwxrwxr-x 1 root root  4096 Sep 10 18:37 \u001b[01;34minclude\u001b[0m\r\n-rwxr-xr-x 1 root root 44008 Sep 10 18:52 \u001b[01;32mnumsim\u001b[0m\r\n"]
