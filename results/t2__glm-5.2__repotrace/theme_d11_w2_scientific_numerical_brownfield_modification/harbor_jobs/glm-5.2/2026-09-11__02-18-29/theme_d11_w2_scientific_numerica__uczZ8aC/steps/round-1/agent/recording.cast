[9937.135579, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/main.c')\ns = p.read_text()\n\n# Add math.h if not present\nif '#include <math.h>' not in s:\n    s = s.replace('#include <string.h>\\n', '#include <string.h>\\n#include <math.h>\\n')\n\n# Add usage line for matinfo after dense-solve usage\nif 'matinfo --input <mtx_file>' not in s:\n    s = s.replace(\n        '    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\\\n\", prog);\\n',\n        '    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\\\n\", prog);\\n'\n        '    fprintf(stderr, \"  %s matinfo --input <mtx_file>\\\\n\", prog);\\n'\n    )\n\n# Insert cmd_matinfo before main\ncmd = r'''\nstatic int cmd_matinfo(int argc, char **argv)\n{\n    const char *input = get_opt(argc, argv, \"--input\");\n    if (!input) {\n        fprintf(stderr, \"Error: matinfo requires --input <mtx_file>\\n\");\n        usage(\"numsim\");\n        return 1;\n    }\n\n    CSRMatrix *A = csr_read_mm(input);\n    if (!A) {\n        fprintf(stderr, \"error: cannot read matr"]
[9937.135935, "i", "ix file\\n\");\n        return 1;\n    }\n\n    int rows = A->rows;\n    int cols = A->cols;\n    int nnz = A->nnz;\n\n    int symmetric = 0;\n    if (rows == cols) {\n        symmetric = 1;\n        for (int i = 0; i < rows && symmetric; i++) {\n            for (int k = A->row_ptr[i]; k < A->row_ptr[i+1] && symmetric; k++) {\n                int j = A->col_indices[k];\n                double v = A->values[k];\n\n                int idx = -1;\n                for (int l = A->row_ptr[j]; l < A->row_ptr[j+1]; l++) {\n                    if (A->col_indices[l] == i) {\n                        idx = l;\n                        break;\n                    }\n                }\n                if (idx < 0) {\n                    symmetric = 0;\n                    break;\n                }\n\n                double vt = A->values[idx];\n                double diff = fabs(v - vt);\n                double denom = fmax(fabs(v), fmax(fabs(vt), 1e-30));\n                if (diff >= 1e-12 * denom) {\n                    symmetric = 0;\n                    "]
[9937.136034, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9937.136116, "i", "break;\n                }\n            }\n        }\n    }\n\n    int bandwidth = 0;\n    double frobenius_norm = 0.0;\n    double max_abs_value = 0.0;\n    double min_abs_nonzero = 0.0;\n\n    for (int i = 0; i < A->rows; i++) {\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\n            int j = A->col_indices[k];\n            double v = A->values[k];\n            double av = fabs(v);\n\n            int bw = i - j;\n            if (bw < 0) bw = -bw;\n            if (bw > bandwidth) bandwidth = bw;\n\n            frobenius_norm += v * v;\n\n            if (av > max_abs_value) max_abs_value = av;\n            if (av != 0.0) {\n                if (min_abs_nonzero == 0.0 || av < min_abs_nonzero) {\n                    min_abs_nonzero = av;\n                }\n            }\n        }\n    }\n\n    frobenius_norm = sqrt(frobenius_norm);\n\n    int strict = 1;\n    int weak = 1;\n    for (int i = 0; i < A->rows; i++) {\n        double diag = 0.0;\n        double offsum = 0.0;\n\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; "]
[9937.136175, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[9937.136243, "i", "k++) {\n            int j = A->col_indices[k];\n            if (j == i) {\n                diag = A->values[k];\n            } else {\n                offsum += fabs(A->values[k]);\n            }\n        }\n\n        if (fabs(diag) > offsum) {\n            continue;\n        }\n        if (fabs(diag) >= offsum) {\n            strict = 0;\n        } else {\n            strict = 0;\n            weak = 0;\n            break;\n        }\n    }\n\n    const char *diagonal_dominance = strict ? \"strict\" : (weak ? \"weak\" : \"none\");\n\n    printf(\"rows: %d\\n\", rows);\n    printf(\"cols: %d\\n\", cols);\n    printf(\"nnz: %d\\n\", nnz);\n    printf(\"symmetric: %s\\n\", symmetric ? \"yes\" : \"no\");\n    printf(\"bandwidth: %d\\n\", bandwidth);\n    printf(\"frobenius_norm: %.15e\\n\", frobenius_norm);\n    printf(\"diagonal_dominance: %s\\n\", diagonal_dominance);\n    printf(\"max_abs_value: %.15e\\n\", max_abs_value);\n    printf(\"min_abs_nonzero: %.15e\\n\", min_abs_nonzero);\n\n    csr_destroy(A);\n    return 0;\n}\n\n'''\n\nif 'static int cmd_matinfo' not in s:\n    s = s.repl"]
