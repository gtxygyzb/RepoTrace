[1145.647441, "o", "    const char *history = get_opt(argc, argv, \"--history\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1145.647496, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1145.647639, "o", "    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.647795, "o", "        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1145.647936, "o", "        !solver || !precond || !tol_s || !maxiter_s) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
