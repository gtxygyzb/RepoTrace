[1145.614652, "o", "\u001b[?2004h> "]
[1145.614741, "o", "        return 1;\r\n\u001b[?2004l\r"]
[1145.614798, "o", "\u001b[?2004h> "]
[1145.614856, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1145.614926, "o", "\u001b[?2004h> "]
[1145.614981, "o", "    int n;\r\n\u001b[?2004l\r"]
[1145.615036, "o", "\u001b[?2004h> "]
