[491.933708, "o", "\u001b[?2004h> "]
[491.933948, "o", "    fprintf(fp, \"%%%%MatrixMarket matrix array real general\\n\");\r\n\u001b[?2004l\r"]
[491.934005, "o", "\u001b[?2004h> "]
[491.934102, "o", "    fprintf(fp, \"%d 1\\n\", n);\r\n\u001b[?2004l\r"]
[491.93416, "o", "\u001b[?2004h> "]
[491.934237, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[491.934292, "o", "> "]
[491.934362, "o", "        fprintf(fp, \"%.15g\\n\", x[i]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[491.934416, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[491.934486, "o", "    fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[491.934549, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[491.934604, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
