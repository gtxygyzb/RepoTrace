[9370.756545, "o", "        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n   148\t\r\n   149\t    }\r\n   150\t\r\n   151\t    for (int i = kdim - 1; i >= 0; i--) {\r\n   152\t        double sum = g[i];\r\n"]
[9370.756614, "o", "   153\t        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n   154\t        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n   155\t        y[i] = sum / H[i*m+i];\r\n   156\t    }\r\n   157\t\r\n   158\t    free(c);\r\n   159\t    free(s);\r\n   160\t    return 0;\r\n   161\t}\r\n   162\t\r\n   163\tSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n   164\t                           double tol, int maxiter, int m, Precond *P)\r\n"]
