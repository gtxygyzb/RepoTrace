[2405.57934, "o", "   141\t                c_im = -2.0 / hx2;\r\n   142\t                rhs += 2.0 * right_vals[j] / hx;\r\n   143\t            } else if (!is_left && !is_right) {\r\n   144\t                diag += 2.0 / hx2;\r\n   145\t                c_im = -1.0 / hx2;\r\n   146\t                c_ip = -1.0 / hx2;\r\n   147\t            }\r\n   148\t\r\n   149"]
[2405.579415, "o", "\t            if (is_bottom && bottom.type == POISSON_NEUMANN) {\r\n   150\t                diag += 2.0 / hy2;\r\n   151\t                c_jp = -2.0 / hy2;\r\n   152\t                rhs += 2.0 * bottom_vals[i] / hy;\r\n   153\t            } else if (is_top && top.type == POISSON_NEUMANN) {\r\n   154\t                diag += 2.0 / hy2;\r\n   155\t                c_jm = -2.0 / hy2;\r\n   156\t                rhs += 2.0 * top_vals[i] / hy;\r\n   157\t            } else if (!is_bottom && !is_top) {\r\n   158\t                diag += 2.0 / hy2;"]
[2405.579482, "o", "\r\n   159\t                c_jm = -1.0 / hy2;\r\n   160\t                c_jp = -1.0 / hy2;\r\n   161\t            }\r\n"]
[2405.579545, "o", "   162\t\r\n   163\t            add_coo(coo, &k, idx, idx, diag);\r\n   164\t            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);\r\n   165\t            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);\r\n   166\t            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);\r\n   167\t            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);\r\n   168\t            b[idx] = rhs;\r\n"]
[2405.579608, "o", "   169\t        }\r\n   170\t    }\r\n   171\t\r\n   172\t    coo->nnz = k;\r\n   173\t    CSRMatrix *A = coo_to_csr(coo);\r\n   174\t    coo_destroy(coo);\r\n   175\t    if (!A) { free(b); goto fail; }\r\n   176\t\r\n   177\t    free(f);\r\n"]
[2405.579669, "o", "   178\t    free(left_vals);\r\n   179\t    free(right_vals);\r\n   180\t    free(bottom_vals);\r\n   181\t    free(top_vals);\r\n   182\t\r\n   183\t    *A_out = A;\r\n   184\t    *b_out = b;\r\n   185\t    return 0;\r\n   186\t\r\n   187\tfail:\r\n   188\t    free(f);\r\n   189\t    free(left_vals);\r\n   190\t    free(right_vals);\r\n"]
[2405.57973, "o", "   191\t    free(bottom_vals);\r\n   192\t    free(top_vals);\r\n   193\t    return -1;\r\n   194\t}\r\n"]
