[3840.591776, "o", "\u001b[?2004h> "]
[3840.59234, "o", "                              double *bottom_vals, double *top_vals,\r\n\u001b[?2004l\r"]
[3840.592409, "o", "\u001b[?2004h> "]
[3840.592844, "o", "                              PoissonBC left, PoissonBC right,\r\n\u001b[?2004l\r"]
[3840.592912, "o", "\u001b[?2004h> "]
[3840.593338, "o", "                              PoissonBC bottom, PoissonBC top)\r\n\u001b[?2004l\r"]
[3840.593403, "o", "\u001b[?2004h> {\r\n"]
[3840.593457, "o", "\u001b[?2004l\r\u001b[?2004h"]
[3840.593516, "o", "> "]
[3840.593969, "o", "    if (i == 0 && left.type == POISSON_DIRICHLET) return left_vals[j];\r\n\u001b[?2004l\r"]
[3840.594027, "o", "\u001b[?2004h> "]
[3840.594546, "o", "    if (i == nx - 1 && right.type == POISSON_DIRICHLET) return right_vals[j];\r\n\u001b[?2004l\r"]
[3840.59461, "o", "\u001b[?2004h> "]
[3840.595118, "o", "    if (j == 0 && bottom.type == POISSON_DIRICHLET) return bottom_vals[i];\r\n\u001b[?2004l\r"]
[3840.595185, "o", "\u001b[?2004h> "]
[3840.595672, "o", "    if (j == ny - 1 && top.type == POISSON_DIRICHLET) return top_vals[i];\r\n\u001b[?2004l\r"]
[3840.595728, "o", "\u001b[?2004h> "]
[3840.595843, "o", "    return 0.0;\r\n\u001b[?2004l\r"]
[3840.595902, "o", "\u001b[?2004h> "]
[3840.595956, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[3840.596012, "o", "> \r\n\u001b[?2004l\r"]
[3840.596079, "o", "\u001b[?2004h> "]
[3840.596547, "o", "/* Assemble stiffness matrix K (negative Laplacian) with Neumann one-sided\r\n\u001b[?2004l\r"]
[3840.596604, "o", "\u001b[?2004h> "]
[3840.597154, "o", " * stencil where applicable.  Dirichlet rows use the standard stencil; they are\r\n\u001b[?2004l\r"]
[3840.597224, "o", "\u001b[?2004h> "]
[3840.597747, "o", " * later replaced with identity rows in the time-stepping matrix.  The returned\r\n\u001b[?2004l\r"]
[3840.59781, "o", "\u001b[?2004h> "]
[3840.598269, "o", " * flux vector contains the Neumann boundary flux contributions. */\r\n\u001b[?2004l\r"]
[3840.598327, "o", "\u001b[?2004h> "]
[3840.598834, "o", "static CSRMatrix *assemble_stiffness(int nx, int ny, double x0, double x1,\r\n\u001b[?2004l\r"]
[3840.598901, "o", "\u001b[?2004h> "]
[3840.599297, "o", "                                     double y0, double y1,\r\n\u001b[?2004l\r"]
[3840.599363, "o", "\u001b[?2004h> "]
[3840.599768, "o", "                                     PoissonBC left, PoissonBC right,\r\n\u001b[?2004l\r"]
[3840.599825, "o", "\u001b[?2004h> "]
[3840.600151, "o", "                                     PoissonBC bottom, PoissonBC top,\r\n\u001b[?2004l\r"]
[3840.600208, "o", "\u001b[?2004h> "]
[3840.600589, "o", "                                     double *left_vals, double *right_vals,\r\n\u001b[?2004l\r"]
[3840.600645, "o", "\u001b[?2004h> "]
[3840.601038, "o", "                                     double *bottom_vals, double *top_vals,\r\n\u001b[?2004l\r"]
[3840.601095, "o", "\u001b[?2004h> "]
[3840.601368, "o", "                                     double **flux_out)\r\n\u001b[?2004l\r"]
[3840.601424, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[3840.60148, "o", "\u001b[?2004h> "]
[3840.601562, "o", "    int n = nx * ny;\r\n\u001b[?2004l\r"]
[3840.601618, "o", "\u001b[?2004h> "]
[3840.60184, "o", "    COOMatrix *coo = coo_create(n, n, 5 * n);\r\n\u001b[?2004l\r"]
[3840.601915, "o", "\u001b[?2004h> "]
[3840.602078, "o", "    double *flux = vec_create(n);\r\n\u001b[?2004l\r"]
[3840.620478, "o", "\u001b[?2004h>     if (!coo || !flux) { coo_destroy(coo); free(flux); return NULL; }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     double hx = (x1 - x0) / (nx - 1);\r\n\u001b[?2004l\r\u001b[?2004h>     double hy = (y1 - y0) / (ny - 1);\r\n\u001b[?2004l\r\u001b[?2004h>     double hx2 = hx * hx;\r\n\u001b[?2004l\r\u001b[?2004h>     double hy2 = hy * hy;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     int k = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = 0; i < nx; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         for (int j = 0; j < ny; j++) {\r\n\u001b[?2004l\r\u001b[?2004h>             int idx = i * ny + j;\r\n\u001b[?2004l\r\u001b[?2004h>             int is_left = (i == 0);\r\n\u001b[?2004l\r\u001b[?2004h>             int is_right = (i == nx - 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.620597, "o", "            int is_bottom = (j == 0);\r\n\u001b[?2004l\r"]
[3840.620656, "o", "\u001b[?2004h> "]
[3840.620912, "o", "            int is_top = (j == ny - 1);\r\n\u001b[?2004l\r"]
[3840.62097, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3840.621029, "o", "\u001b[?2004h> "]
[3840.621241, "o", "            double diag = 0.0;\r\n\u001b[?2004l\r"]
[3840.621297, "o", "\u001b[?2004h> "]
[3840.621747, "o", "            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;\r\n\u001b[?2004l\r"]
[3840.621803, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3840.621877, "o", "\u001b[?2004h> "]
[3840.622284, "o", "            if (is_left && left.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[3840.622341, "o", "\u001b[?2004h> "]
[3840.622578, "o", "                diag += 2.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.622627, "o", "\u001b[?2004h> "]
[3840.622886, "o", "                c_ip = -2.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.622943, "o", "\u001b[?2004h> "]
[3840.623306, "o", "                flux[idx] += 2.0 * left_vals[j] / hx;\r\n\u001b[?2004l\r"]
[3840.623364, "o", "\u001b[?2004h> "]
[3840.623818, "o", "            } else if (is_right && right.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[3840.623884, "o", "\u001b[?2004h> "]
[3840.624127, "o", "                diag += 2.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.624184, "o", "\u001b[?2004h> "]
[3840.624421, "o", "                c_im = -2.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.624489, "o", "\u001b[?2004h> "]
[3840.624852, "o", "                flux[idx] += 2.0 * right_vals[j] / hx;\r\n\u001b[?2004l\r"]
[3840.624913, "o", "\u001b[?2004h> "]
[3840.625242, "o", "            } else if (!is_left && !is_right) {\r\n\u001b[?2004l\r"]
[3840.625299, "o", "\u001b[?2004h> "]
[3840.625537, "o", "                diag += 2.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.625602, "o", "\u001b[?2004h> "]
[3840.625839, "o", "                c_im = -1.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.625909, "o", "\u001b[?2004h> "]
[3840.626149, "o", "                c_ip = -1.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.626195, "o", "\u001b[?2004h> "]
[3840.626354, "o", "            } else {\r\n\u001b[?2004l\r"]
[3840.6264, "o", "\u001b[?2004h> "]
[3840.62692, "o", "                /* Boundary node with Dirichlet or unspecified BC: use the\r\n\u001b[?2004l\r"]
[3840.626977, "o", "\u001b[?2004h> "]
[3840.627461, "o", "                 * standard interior stencil with the missing neighbour\r\n\u001b[?2004l\r"]
[3840.627518, "o", "\u001b[?2004h> "]
[3840.627732, "o", "                 * omitted. */\r\n\u001b[?2004l\r"]
[3840.62779, "o", "\u001b[?2004h> "]
[3840.628034, "o", "                diag += 2.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.628091, "o", "\u001b[?2004h> "]
[3840.628418, "o", "                if (is_left) c_ip = -1.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.628473, "o", "\u001b[?2004h> "]
[3840.628805, "o", "                if (is_right) c_im = -1.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.628859, "o", "\u001b[?2004h> "]
[3840.628973, "o", "            }\r\n\u001b[?2004l\r"]
[3840.62903, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3840.629094, "o", "\u001b[?2004h> "]
[3840.629513, "o", "            if (is_bottom && bottom.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[3840.629569, "o", "\u001b[?2004h> "]
[3840.629809, "o", "                diag += 2.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.629855, "o", "\u001b[?2004h> "]
[3840.630112, "o", "                c_jp = -2.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.630177, "o", "\u001b[?2004h> "]
[3840.630549, "o", "                flux[idx] += 2.0 * bottom_vals[i] / hy;\r\n\u001b[?2004l\r"]
[3840.630606, "o", "\u001b[?2004h> "]
[3840.631041, "o", "            } else if (is_top && top.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[3840.631096, "o", "\u001b[?2004h> "]
[3840.631335, "o", "                diag += 2.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.6314, "o", "\u001b[?2004h> "]
[3840.631605, "o", "                c_jm = -2.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.631659, "o", "\u001b[?2004h> "]
[3840.631954, "o", "                flux[idx] += 2.0 * top_vals[i] / hy;\r\n\u001b[?2004l\r"]
[3840.63201, "o", "\u001b[?2004h> "]
[3840.632286, "o", "            } else if (!is_bottom && !is_top) {\r\n\u001b[?2004l\r"]
[3840.632339, "o", "\u001b[?2004h> "]
[3840.632515, "o", "                diag += 2.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.632571, "o", "\u001b[?2004h> "]
[3840.632749, "o", "                c_jm = -1.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.632804, "o", "\u001b[?2004h> "]
[3840.632989, "o", "                c_jp = -1.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.633044, "o", "\u001b[?2004h> "]
[3840.633148, "o", "            } else {\r\n\u001b[?2004l\r"]
[3840.633202, "o", "\u001b[?2004h> "]
[3840.633382, "o", "                diag += 2.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.633436, "o", "\u001b[?2004h> "]
[3840.63368, "o", "                if (is_bottom) c_jp = -1.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.633745, "o", "\u001b[?2004h> "]
[3840.633983, "o", "                if (is_top) c_jm = -1.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.63404, "o", "\u001b[?2004h> "]
[3840.63409, "o", "            }\r\n\u001b[?2004l\r"]
[3840.634152, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3840.634208, "o", "(\u001b[?2004h> "]
[3840.634421, "o", "            add_coo(coo, &k, idx, idx, diag);\r\n\u001b[?2004l\r"]
[3840.634476, "o", "\u001b[?2004h> "]
[3840.634881, "o", "            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);\r\n\u001b[?2004l\r"]
[3840.634939, "o", "\u001b[?2004h> "]
[3840.635362, "o", "            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);\r\n\u001b[?2004l\r"]
[3840.635417, "o", "\u001b[?2004h> "]
[3840.635807, "o", "            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);\r\n\u001b[?2004l\r"]
[3840.635864, "o", "\u001b[?2004h> "]
[3840.636332, "o", "            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);\r\n\u001b[?2004l\r"]
[3840.636388, "o", "\u001b[?2004h> "]
[3840.636443, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.636509, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[3840.636563, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3840.636645, "o", "    coo->nnz = k;\r\n\u001b[?2004l\r"]
[3840.6367, "o", "\u001b[?2004h> "]
[3840.636835, "o", "    CSRMatrix *K = coo_to_csr(coo);\r\n\u001b[?2004l\r"]
[3840.636897, "o", "\u001b[?2004h> "]
[3840.636974, "o", "    coo_destroy(coo);\r\n\u001b[?2004l\r"]
[3840.637028, "o", "\u001b[?2004h> "]
[3840.637186, "o", "    if (!K) { free(flux); return NULL; }\r\n\u001b[?2004l\r"]
[3840.637241, "o", "\u001b[?2004h> "]
[3840.637321, "o", "    *flux_out = flux;\r\n\u001b[?2004l\r"]
[3840.637375, "o", "\u001b[?2004h> "]
[3840.637431, "o", "    return K;\r\n\u001b[?2004l\r\u001b[?2004h"]
[3840.637486, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3840.637552, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.637877, "o", "/* Assemble the time-stepping system matrix I + factor*K with Dirichlet rows\r\n\u001b[?2004l\r"]
[3840.637932, "o", "\u001b[?2004h> "]
[3840.638033, "o", " * replaced by identity. */\r\n\u001b[?2004l\r"]
[3840.638088, "o", "\u001b[?2004h> "]
[3840.638397, "o", "static CSRMatrix *assemble_system_matrix(int nx, int ny, double x0, double x1,\r\n\u001b[?2004l\r"]
[3840.638452, "o", "\u001b[?2004h> "]
[3840.638691, "o", "                                        double y0, double y1,\r\n\u001b[?2004l\r"]
[3840.638747, "o", "\u001b[?2004h> "]
[3840.639038, "o", "                                        PoissonBC left, PoissonBC right,\r\n\u001b[?2004l\r"]
[3840.639094, "o", "\u001b[?2004h> "]
[3840.639377, "o", "                                        PoissonBC bottom, PoissonBC top,\r\n\u001b[?2004l\r"]
[3840.639432, "o", "\u001b[?2004h> "]
[3840.639656, "o", "                                        double factor)\r\n\u001b[?2004l\r"]
[3840.639727, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[3840.639783, "o", "\u001b[?2004h> "]
[3840.63985, "o", "    int n = nx * ny;\r\n\u001b[?2004l\r\u001b[?2004h"]
[3840.639919, "o", "> "]
[3840.640064, "o", "    COOMatrix *coo = coo_create(n, n, 5 * n);\r\n\u001b[?2004l\r"]
[3840.640119, "o", "\u001b[?2004h> "]
[3840.640221, "o", "    if (!coo) return NULL;\r\n\u001b[?2004l\r"]
[3840.640276, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3840.640331, "o", "> "]
[3840.64046, "o", "    double hx = (x1 - x0) / (nx - 1);\r\n\u001b[?2004l\r"]
[3840.640516, "o", "\u001b[?2004h> "]
[3840.64066, "o", "    double hy = (y1 - y0) / (ny - 1);\r\n\u001b[?2004l\r"]
[3840.640716, "o", "\u001b[?2004h> "]
[3840.640808, "o", "    double hx2 = hx * hx;\r\n\u001b[?2004l\r"]
[3840.640862, "o", "\u001b[?2004h> "]
[3840.640963, "o", "    double hy2 = hy * hy;\r\n\u001b[?2004l\r"]
[3840.641019, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3840.641075, "o", "> "]
[3840.641129, "o", "    int k = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[3840.641185, "o", "> "]
[3840.641297, "o", "    for (int i = 0; i < nx; i++) {\r\n\u001b[?2004l\r"]
[3840.641352, "o", "\u001b[?2004h> "]
[3840.641499, "o", "        for (int j = 0; j < ny; j++) {\r\n\u001b[?2004l\r"]
[3840.641554, "o", "\u001b[?2004h> "]
[3840.641681, "o", "            int idx = i * ny + j;\r\n\u001b[?2004l\r"]
[3840.641735, "o", "\u001b[?2004h> "]
[3840.641831, "o", "            int is_left = (i == 0);\r\n\u001b[?2004l\r"]
[3840.641895, "o", "\u001b[?2004h> "]
[3840.641994, "o", "            int is_right = (i == nx - 1);\r\n\u001b[?2004l\r"]
[3840.64205, "o", "\u001b[?2004h> "]
[3840.642141, "o", "            int is_bottom = (j == 0);\r\n\u001b[?2004l\r"]
[3840.642196, "o", "\u001b[?2004h> "]
[3840.642295, "o", "            int is_top = (j == ny - 1);\r\n\u001b[?2004l\r"]
[3840.642349, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.64259, "o", "            if (is_dirichlet_node(i, j, nx, ny, left, right, bottom, top)) {\r\n\u001b[?2004l\r"]
[3840.642645, "o", "\u001b[?2004h> "]
[3840.642768, "o", "                add_coo(coo, &k, idx, idx, 1.0);\r\n\u001b[?2004l\r"]
[3840.642822, "o", "\u001b[?2004h> "]
[3840.642885, "o", "                continue;\r\n\u001b[?2004l\r"]
[3840.642941, "o", "\u001b[?2004h> "]
[3840.642996, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3840.64305, "o", "\u001b[?2004h> "]
[3840.643207, "o", "            double diag = 1.0;  /* identity contribution */\r\n\u001b[?2004l\r"]
[3840.643261, "o", "\u001b[?2004h> "]
[3840.643438, "o", "            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;\r\n\u001b[?2004l\r"]
[3840.643493, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.64368, "o", "            if (is_left && left.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[3840.643735, "o", "\u001b[?2004h> "]
[3840.643845, "o", "                diag += factor * 2.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.643908, "o", "\u001b[?2004h> "]
[3840.64402, "o", "                c_ip = factor * (-2.0 / hx2);\r\n\u001b[?2004l\r"]
[3840.644075, "o", "\u001b[?2004h> "]
[3840.644254, "o", "            } else if (is_right && right.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[3840.644309, "o", "\u001b[?2004h> "]
[3840.644417, "o", "                diag += factor * 2.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.644472, "o", "\u001b[?2004h> "]
[3840.644587, "o", "                c_im = factor * (-2.0 / hx2);\r\n\u001b[?2004l\r"]
[3840.644642, "o", "\u001b[?2004h> "]
[3840.644763, "o", "            } else if (!is_left && !is_right) {\r\n\u001b[?2004l\r"]
[3840.644822, "o", "\u001b[?2004h> "]
[3840.644934, "o", "                diag += factor * 2.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.644989, "o", "\u001b[?2004h> "]
[3840.645102, "o", "                c_im = factor * (-1.0 / hx2);\r\n\u001b[?2004l\r"]
[3840.645158, "o", "\u001b[?2004h> "]
[3840.645271, "o", "                c_ip = factor * (-1.0 / hx2);\r\n\u001b[?2004l\r"]
[3840.645325, "o", "\u001b[?2004h> "]
[3840.645383, "o", "            } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.645529, "o", "                diag += factor * 2.0 / hx2;\r\n\u001b[?2004l\r"]
[3840.645584, "o", "\u001b[?2004h> "]
[3840.645738, "o", "                if (is_left) c_ip = factor * (-1.0 / hx2);\r\n\u001b[?2004l\r"]
[3840.645793, "o", "\u001b[?2004h> "]
[3840.645957, "o", "                if (is_right) c_im = factor * (-1.0 / hx2);\r\n\u001b[?2004l\r\u001b[?2004h"]
[3840.646014, "o", ">             }\r\n\u001b[?2004l\r"]
[3840.646095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.64628, "o", "            if (is_bottom && bottom.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[3840.646337, "o", "\u001b[?2004h> "]
[3840.646443, "o", "                diag += factor * 2.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.6465, "o", "\u001b[?2004h> "]
[3840.646614, "o", "                c_jp = factor * (-2.0 / hy2);\r\n\u001b[?2004l\r"]
[3840.646674, "o", "\u001b[?2004h> "]
[3840.646838, "o", "            } else if (is_top && top.type == POISSON_NEUMANN) {\r\n\u001b[?2004l\r"]
[3840.646904, "o", "\u001b[?2004h> "]
[3840.647006, "o", "                diag += factor * 2.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.647062, "o", "\u001b[?2004h> "]
[3840.647177, "o", "                c_jm = factor * (-2.0 / hy2);\r\n\u001b[?2004l\r"]
[3840.647233, "o", "\u001b[?2004h> "]
[3840.647352, "o", "            } else if (!is_bottom && !is_top) {\r\n\u001b[?2004l\r"]
[3840.647407, "o", "\u001b[?2004h> "]
[3840.647516, "o", "                diag += factor * 2.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.647571, "o", "\u001b[?2004h> "]
[3840.647685, "o", "                c_jm = factor * (-1.0 / hy2);\r\n\u001b[?2004l\r"]
[3840.64774, "o", "\u001b[?2004h> "]
[3840.647854, "o", "                c_jp = factor * (-1.0 / hy2);\r\n\u001b[?2004l\r"]
[3840.647917, "o", "\u001b[?2004h> "]
[3840.647972, "o", "            } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.648119, "o", "                diag += factor * 2.0 / hy2;\r\n\u001b[?2004l\r"]
[3840.648175, "o", "\u001b[?2004h> "]
[3840.648341, "o", "                if (is_bottom) c_jp = factor * (-1.0 / hy2);\r\n\u001b[?2004l\r"]
[3840.648397, "o", "\u001b[?2004h> "]
[3840.648555, "o", "                if (is_top) c_jm = factor * (-1.0 / hy2);\r\n\u001b[?2004l\r"]
[3840.648611, "o", "\u001b[?2004h> "]
[3840.648668, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3840.648723, "o", "> "]
[3840.648833, "o", "            add_coo(coo, &k, idx, idx, diag);\r\n\u001b[?2004l\r"]
[3840.64891, "o", "\u001b[?2004h> "]
[3840.649105, "o", "            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);\r\n\u001b[?2004l\r"]
[3840.649162, "o", "\u001b[?2004h> "]
[3840.649384, "o", "            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);\r\n\u001b[?2004l\r"]
[3840.649439, "o", "\u001b[?2004h> "]
[3840.64965, "o", "            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);\r\n\u001b[?2004l\r"]
[3840.649704, "o", "\u001b[?2004h> "]
[3840.649931, "o", "            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);\r\n\u001b[?2004l\r"]
[3840.649989, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[3840.650044, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[3840.6501, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.65017, "o", "    coo->nnz = k;\r\n\u001b[?2004l\r"]
[3840.650225, "o", "\u001b[?2004h> "]
[3840.650311, "o", "    CSRMatrix *A = coo_to_csr(coo);\r\n\u001b[?2004l\r"]
[3840.650367, "o", "\u001b[?2004h> "]
[3840.650429, "o", "    coo_destroy(coo);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.650485, "o", "    return A;\r\n\u001b[?2004l\r"]
[3840.650543, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3840.650598, "o", "\u001b[?2004h> "]
[3840.65083, "o", "static int parse_source_list(const char *arg, char ***files_out, int *count_out)\r\n\u001b[?2004l\r"]
[3840.650901, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.650996, "o", "    char *copy = strdup(arg);\r\n\u001b[?2004l\r"]
[3840.651057, "o", "\u001b[?2004h> "]
[3840.651117, "o", "    if (!copy) return -1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[3840.651172, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.651235, "o", "    int count = 1;\r\n\u001b[?2004l\r"]
[3840.651294, "o", "\u001b[?2004h> "]
[3840.651443, "o", "    for (char *p = copy; *p; p++) if (*p == ',') count++;\r\n\u001b[?2004l\r"]
[3840.6515, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.651685, "o", "    char **files = (char **)calloc(count, sizeof(char *));\r\n\u001b[?2004l\r"]
[3840.651747, "o", "\u001b[?2004h> "]
[3840.65185, "o", "    if (!files) { free(copy); return -1; }\r\n\u001b[?2004l\r"]
[3840.651912, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.651972, "o", "    int idx = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.652064, "o", "    char *tok = strtok(copy, \",\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.652124, "o", "    while (tok) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.652215, "o", "        files[idx++] = strdup(tok);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.652303, "o", "        tok = strtok(NULL, \",\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.652358, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.652413, "o", "    free(copy);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3840.652468, "o", "\u001b[?2004h> "]
[3840.652522, "o", "    if (idx != count) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.652616, "o", "        for (int i = 0; i < idx; i++) free(files[i]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.652678, "o", "        free(files);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.652739, "o", "        return -1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.652794, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.652865, "o", "    *files_out = files;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.65294, "o", "    *count_out = count;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.653001, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[3840.653056, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.653172, "o", "static void free_source_list(char **files, int count)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.653227, "o", "{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.653327, "o", "    for (int i = 0; i < count; i++) free(files[i]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.653384, "o", "    free(files);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3840.653441, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[3840.656132, "o", "\u001b[?2004hroot@n30009:/app# "]
[4012.716661, "i", "cat >> src/heat.c <<'EOF'\n\nint heat_solve(int nx, int ny, double x0, double x1, double y0, double y1,\n               double alpha, double dt, int nsteps, const char *scheme,\n               const char *ic_file, const char *source_arg,\n               PoissonBC left, PoissonBC right, PoissonBC bottom, PoissonBC top,\n               const char *solver, const char *precond, double tol, int maxiter,\n               int restart, double omega, const char *output)\n{\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || alpha <= 0.0 || dt <= 0.0 ||\n        nsteps < 0 || !scheme || !ic_file || !source_arg || !solver ||\n        !precond || !output) {\n        return -1;\n    }\n\n    int is_cn = (strcmp(scheme, \"crank-nicolson\") == 0);\n    int is_be = (strcmp(scheme, \"backward-euler\") == 0);\n    if (!is_be && !is_cn) return -1;\n\n    int n = nx * ny;\n\n    double *u = poisson_read_source(ic_file, nx, ny);\n    if (!u) return -1;\n\n    char **source_files = NULL;\n    int nsources = 0;\n    if (parse_source_list(source_arg, &source_fil"]
