[11435.605927, "o", "\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->history[0] = \u001b[01;31m\u001b[Kres->relres\u001b[m\u001b[K;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->converged = (\u001b[01;31m\u001b[Kres->relres\u001b[m\u001b[K < tol) ? 1 : 0;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kres->true_residual\u001b[m\u001b[K = vec_norm2(r, n);\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kres->relres\u001b[m\u001b[K = \u001b[01;31m\u001b[Kres->true_residual\u001b[m\u001b[K / bnorm;\r\n"]
