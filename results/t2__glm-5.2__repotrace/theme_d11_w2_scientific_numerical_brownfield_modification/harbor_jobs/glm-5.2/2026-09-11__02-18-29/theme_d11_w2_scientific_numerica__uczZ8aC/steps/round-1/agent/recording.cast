[2161.46285, "o", "    74\t\r\n    75\t        double alpha = rz_old / pAp;\r\n    76\t        vec_axpy(alpha, p, res->x, n);\r\n    77\t        vec_axpy(-alpha, Ap, r, n);\r\n    78\t\r\n    79\t        res->relres = vec_norm2(r, n) / bnorm;\r\n    80\t        res->history[iter] = res->relres;\r\n    81\t        res->history_len = iter + 1;\r\n    82\t        res->iterations = iter;\r\n    83\t\r\n    84\t        if (res->relres < tol) {\r\n"]
[2161.462942, "o", "    85\t            res->converged = 1;\r\n    86\t            break;\r\n    87\t        }\r\n    88\t\r\n    89\t        if (precond_apply(P, A, r, z) != 0) break;\r\n    90\t        double rz_new = vec_dot(r, z, n);\r\n    91\t        if (fabs(rz_old) < 1e-30) break;\r\n    92\t        double beta = rz_new / rz_old;\r\n    93\t        vec_scale(beta, p, n);\r\n    94\t        vec_axpy(1.0, z, p, n);\r\n"]
[2161.463001, "o", "    95\t        rz_old = rz_new;\r\n    96\t    }\r\n    97\t\r\n    98\t    free(r); free(z); free(p); free(Ap);\r\n    99\t    return res;\r\n   100\t}\r\n   101\t\r\n   102\tstatic void apply_givens(double *a, double *b, double c, double s)\r\n   103\t{\r\n   104\t    double t = c * (*a) + s * (*b);\r\n"]
[2161.463062, "o", "   105\t    *b = -s * (*a) + c * (*b);\r\n   106\t    *a = t;\r\n   107\t}\r\n   108\t\r\n   109\tstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n   110\t{\r\n   111\t    if (kdim <= 0) return -1;\r\n   112\t\r\n   113\t    double *c = (double *)malloc(m * sizeof(double));\r\n   114\t    double *s = (double *)malloc(m * sizeof(double));\r\n"]
[2161.46312, "o", "   115\t    if (!c || !s) { free(c); free(s); return -1; }\r\n   116\t\r\n   117\t    for (int i = 0; i < kdim; i++) {\r\n   118\t        for (int k = 0; k < i; k++) {\r\n   119\t            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n   120\t        }\r\n   121\t\r\n   122\t        double a = H[i*m+i];\r\n   123\t"]
[2161.463181, "o", "        double b = H[(i+1)*m+i];\r\n   124\t        if (b == 0.0) {\r\n   125\t            c[i] = 1.0;\r\n   126\t            s[i] = 0.0;\r\n   127\t        } else {\r\n   128\t            double r = hypot(a, b);\r\n   129\t            c[i] = a / r;\r\n   130\t            s[i] = b / r;\r\n"]
[2161.463242, "o", "   131\t        }\r\n   132\t        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n   133\t        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n   134\t\r\n   135\t    }\r\n   136\t\r\n   137\t    for (int i = kdim - 1; i >= 0; i--) {\r\n   138\t        double sum = g[i];\r\n   139\t        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n   140\t        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n"]
