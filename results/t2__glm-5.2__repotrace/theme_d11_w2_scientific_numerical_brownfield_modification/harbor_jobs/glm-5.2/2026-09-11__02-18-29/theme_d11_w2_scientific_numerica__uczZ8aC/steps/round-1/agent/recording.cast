[9316.134586, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/eigen.c')\ns = p.read_text()\nold = '''static CSRMatrix *make_shifted_matrix(const CSRMatrix *A, double sigma)\n{\n    CSRMatrix *S = csr_create(A->rows, A->cols, A->nnz);\n    if (!S) return NULL;\n    for (int i = 0; i <= A->rows; i++) S->row_ptr[i] = A->row_ptr[i];\n    for (int k = 0; k < A->nnz; k++) S->col_indices[k] = A->col_indices[k];\n    for (int i = 0; i < A->rows; i++) {\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\n            S->values[k] = A->values[k];\n            if (A->col_indices[k] == i) S->values[k] -= sigma;\n        }\n    }\n    return S;\n}\n'''\nnew = '''static CSRMatrix *make_shifted_matrix(const CSRMatrix *A, double sigma)\n{\n    int n = A->rows;\n    int *has_diag = (int *)calloc(n, sizeof(int));\n    if (!has_diag) return NULL;\n\n    for (int i = 0; i < n; i++) {\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\n            if (A->col_indices[k] == i) has_diag[i] = 1;\n        }\n    }\n\n    int missing = 0;\n    "]
[9316.134899, "i", "for (int i = 0; i < n; i++) {\n        if (!has_diag[i]) missing++;\n    }\n\n    COOMatrix *coo = coo_create(n, n, A->nnz + missing);\n    if (!coo) { free(has_diag); return NULL; }\n\n    int idx = 0;\n    for (int i = 0; i < n; i++) {\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\n            coo->row[idx] = i;\n            coo->col[idx] = A->col_indices[k];\n            coo->values[idx] = A->values[k];\n            if (A->col_indices[k] == i) coo->values[idx] -= sigma;\n            idx++;\n        }\n    }\n    for (int i = 0; i < n; i++) {\n        if (!has_diag[i]) {\n            coo->row[idx] = i;\n            coo->col[idx] = i;\n            coo->values[idx] = -sigma;\n            idx++;\n        }\n    }\n\n    CSRMatrix *S = coo_to_csr(coo);\n    coo_destroy(coo);\n    free(has_diag);\n    return S;\n}\n'''\nif old not in s:\n    raise SystemExit('make_shifted_matrix block not found')\ns = s.replace(old, new)\np.write_text(s)\nPY\n"]
[9316.135004, "o", "python3 - <<'PY'\r\n\u001b[?2004l\rfor (int i = 0; i < n; i++) {\r\n        if (!has_diag[i]) missing++;\r\n    }\r\n\r\n "]
