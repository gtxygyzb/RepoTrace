[1062.385802, "o", "#include \"sparse.h\"$\r\n#include \"precond.h\"$\r\n#include \"solvers.h\"$\r\n#include \"poisson.h\"$\r\n$\r\nstatic void usage(const char *prog)$\r\n{$\r\n    fprintf(stderr, \"Usage:\\n\");$\r\n    fprintf(stderr, \"  %s dense-solve <matrix_file> <rhs_file> [output_file]\\n\", prog);$\r\n    fprintf(stderr, \"  %s sparse-solve --input <mtx_file> --rhs <rhs_file> \\\\$\r\n\", prog);$\r\n    fprintf(stderr, \"        --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> \\\\$\r\n\");$\r\n    fprintf(stderr, \"        --tol <value> --maxiter <value> \\\\$\r\n\");$\r\n    fprintf(stderr, \"        [--restart <m>] [--ssor-omega <value>] \\\\$\r\n\");$\r\n    fprintf(stderr, \"        [--output <file>] [--history <file>]\\n\");$\r\n    fprintf(stderr, \"  %s poisson --nx <int> --ny <int> \\\\$\r\n\", prog);$\r\n    fprintf(stderr, \"        --x0 <float> --x1 <float> --y0 <float> --y1 <float> \\\\$\r\n\");$\r\n    fprintf(stderr, \"        --source <file> \\\\$\r\n\");$\r\n    fprintf(stderr, \"        --bc-left <dirichlet|neumann>:<file> \\\\$\r\n"]
[1062.385885, "o", "\");$\r\n    fprintf(stderr, \"        --bc-right <dirichlet|neumann>:<file> \\\\$\r\n\");$\r\n    fprintf(stderr, \"        --bc-bottom <dirichlet|neumann>:<file> \\\\$\r\n\");$\r\n    fprintf(stderr, \"        --bc-top <dirichlet|neumann>:<file> \\\\$\r\n\");$\r\n    fprintf(stderr, \"        --solver <cg|gmres> --precond <none|jacobi|ilu0|ssor> \\\\$\r\n\");$\r\n"]
