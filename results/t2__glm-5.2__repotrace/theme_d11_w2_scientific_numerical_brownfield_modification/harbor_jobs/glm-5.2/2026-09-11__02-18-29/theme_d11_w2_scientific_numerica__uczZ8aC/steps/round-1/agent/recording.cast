[491.925601, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[491.925669, "o", "\u001b[?2004h> "]
[491.925756, "o", "    FILE *fp = fopen(filename, \"w\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[491.925865, "o", "    if (!fp) return -1;\r\n\u001b[?2004l\r"]
[491.925946, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[491.926001, "o", "\u001b[?2004h> "]
[491.926219, "o", "    fprintf(fp, \"%%%%MatrixMarket matrix coordinate real general\\n\");\r\n\u001b[?2004l\r"]
[491.926284, "o", "\u001b[?2004h> "]
[491.926475, "o", "    fprintf(fp, \"%d %d %d\\n\", A->rows, A->cols, A->nnz);\r\n\u001b[?2004l\r"]
[491.92654, "o", "\u001b[?2004h> "]
[491.926666, "o", "    for (int i = 0; i < A->rows; i++) {\r\n\u001b[?2004l\r"]
[491.926733, "o", "\u001b[?2004h> "]
[491.926959, "o", "        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n\u001b[?2004l\r"]
[491.927025, "o", "\u001b[?2004h> "]
[491.927303, "o", "            fprintf(fp, \"%d %d %.15g\\n\", i+1, A->col_indices[k]+1, A->values[k]);\r\n\u001b[?2004l\r"]
[491.927386, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[491.927444, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[491.9275, "o", "\u001b[?2004h> "]
[491.927587, "o", "    fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h> "]
