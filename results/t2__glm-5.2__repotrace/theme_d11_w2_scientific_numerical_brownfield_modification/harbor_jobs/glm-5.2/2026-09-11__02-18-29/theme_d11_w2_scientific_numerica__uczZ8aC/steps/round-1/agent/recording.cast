[2298.852422, "i", "sed -n '1,120p' src/vector.c\n"]
[2298.852628, "o", "sed -n '1,120p' src/vector.c\r\n\u001b[?2004l\r"]
[2298.855301, "o", "#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n\r\ndouble *vec_create(int n)\r\n{\r\n    if (n <= 0) return NULL;\r\n    return calloc(n, sizeof(double));\r\n}\r\n"]
[2298.855405, "o", "\r\nvoid vec_copy(const double *src, double *dst, int n)\r\n{\r\n    memcpy(dst, src, (size_t)n * sizeof(double));\r\n}\r\n\r\nvoid vec_zero(double *x, int n)\r\n{\r\n    memset(x, 0, (size_t)n * sizeof(double));\r\n}\r\n"]
[2298.855478, "o", "\r\nvoid vec_scale(double a, double *x, int n)\r\n{\r\n    int i;\r\n    for (i = 0; i < n; i++) x[i] *= a;\r\n}\r\n\r\nvoid vec_axpy(double a, const double *x, double *y, int n)\r\n{\r\n    int i;\r\n    for (i = 0; i < n; i++) y[i] += a * x[i];\r\n}\r\n\r\ndouble vec_dot(const double *x, const double *y, int n)\r\n{\r\n    double s = 0.0;\r\n    int i;\r\n    for (i = 0; i < n; i++) s += x[i] * y[i];\r\n    return s;\r\n}\r\n\r\ndouble vec_norm2(const double *x, int n)\r\n{\r\n    return sqrt(vec_dot(x, x, n));\r\n}\r\n\r\n"]
[2298.855551, "o", "void vec_print(const double *x, int n, FILE *out)\r\n{\r\n    int i;\r\n    for (i = 0; i < n; i++)\r\n        fprintf(out, \"%.15g\\n\", x[i]);\r\n}\r\n"]
[2298.855922, "o", "\u001b[?2004hroot@n30009:/app# "]
[2299.123286, "i", "sed -n '1,120p' src/precond.c\n"]
[2299.123564, "o", "sed -n '1,120p' src/precond.c\r\n"]
[2299.123651, "o", "\u001b[?2004l\r"]
[2299.126442, "o", "#include \"precond.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n"]
[2299.126516, "o", "\r\nstatic int find_in_row(const CSRMatrix *A, int row, int col)\r\n{\r\n    int lo = A->row_ptr[row];\r\n    int hi = A->row_ptr[row+1] - 1;\r\n    while (lo <= hi) {\r\n        int mid = (lo + hi) / 2;\r\n        if (A->col_indices[mid] == col) return mid;\r\n        if (A->col_indices[mid] < col) lo = mid + 1;\r\n        else hi = mid - 1;\r\n    }\r\n    return -1;\r\n}\r\n\r\n"]
[2299.126595, "o", "static CSRMatrix *csr_copy(const CSRMatrix *A)\r\n{\r\n    CSRMatrix *B = csr_create(A->rows, A->cols, A->nnz);\r\n    if (!B) return NULL;\r\n    memcpy(B->values, A->values, A->nnz * sizeof(double));\r\n    memcpy(B->col_indices, A->col_indices, A->nnz * sizeof(int));\r\n    memcpy(B->row_ptr, A->row_ptr, (A->rows + 1) * sizeof(int));\r\n    return B;\r\n}\r\n\r\nstatic int ilu0_factorize(CSRMatrix *LU)\r\n{\r\n    int n = LU->rows;\r\n"]
[2299.126659, "o", "    for (int i = 0; i < n; i++) {\r\n        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n            int c = LU->col_indices[k];\r\n            if (c >= i) break;\r\n\r\n            int d = find_in_row(LU, c, c);\r\n            if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;\r\n\r\n            LU->values[k] /= LU->values[d];\r\n            double aik = LU->values[k];\r\n\r\n            for (int l = LU->row_ptr[c]; l < LU->row_ptr[c+1]; l++) {\r\n                int j = LU->col_indices[l];\r\n                if (j <= c) continue;\r\n                int idx = find_in_row(LU, i, j);\r\n"]
[2299.126722, "o", "                if (idx >= 0) LU->values[idx] -= aik * LU->values[l];\r\n            }\r\n        }\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int ilu_forward_solve(const CSRMatrix *LU, const double *r, double *y)\r\n{\r\n    for (int i = 0; i < LU->rows; i++) {\r\n"]
[2299.126781, "o", "        double s = r[i];\r\n        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n            int j = LU->col_indices[k];\r\n            if (j < i) s -= LU->values[k] * y[j];\r\n            else break;\r\n        }\r\n        y[i] = s;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int ilu_backward_solve(const CSRMatrix *LU, const double *y, double *z)\r\n{\r\n    for (int i = LU->rows - 1; i >= 0; i--) {\r\n        double s = y[i];\r\n"]
[2299.126838, "o", "        int d = -1;\r\n        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n            int j = LU->col_indices[k];\r\n            if (j == i) d = k;\r\n            else if (j > i) s -= LU->values[k] * z[j];\r\n        }\r\n        if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;\r\n        z[i] = s / LU->values[d];\r\n    }\r\n    return 0;\r\n}\r\n\r\n"]
[2299.12693, "o", "Precond *precond_create(const CSRMatrix *A, const char *name, double omega)\r\n{\r\n    if (!A || !name || A->rows != A->cols) return NULL;\r\n\r\n    Precond *P = (Precond *)calloc(1, sizeof(Precond));\r\n    if (!P) return NULL;\r\n\r\n    P->n = A->rows;\r\n    P->omega = (omega > 0.0) ? omega : 1.0;\r\n\r\n    if (strcmp(name, \"none\") == 0) {\r\n        P->type = PRECOND_NONE;\r\n    } else if (strcmp(name, \"jacobi\") == 0) {\r\n        P->type = PRECOND_JACOBI;\r\n"]
[2299.126992, "o", "        P->diag = csr_diagonal(A);\r\n        if (!P->diag) { precond_destroy(P); return NULL; }\r\n    } else if (strcmp(name, \"ilu0\") == 0) {\r\n        P->type = PRECOND_ILU0;\r\n        P->lu = csr_copy(A);\r\n        if (!P->lu) { precond_destroy(P); return NULL; }\r\n        if (ilu0_factorize(P->lu) != 0) { precond_destroy(P); return NULL; }\r\n    } else if (strcmp(name, \"ssor\") == 0) {\r\n        P->type = PRECOND_SSOR;\r\n        P->ssor_A = A;\r\n        P->diag = csr_diagonal(A);\r\n        if (!P->diag) { precond_destroy(P); return NULL; }\r\n    } else {\r\n        precond_destroy(P);\r\n"]
[2299.127053, "o", "        return NULL;\r\n    }\r\n\r\n    return P;\r\n}\r\n\r\nvoid precond_destroy(Precond *P)\r\n{\r\n"]
