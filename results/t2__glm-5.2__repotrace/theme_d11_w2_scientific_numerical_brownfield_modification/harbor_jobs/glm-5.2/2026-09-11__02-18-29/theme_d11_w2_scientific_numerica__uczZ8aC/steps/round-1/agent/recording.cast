[12681.556406, "o", "        if (i > 0 && res->history[i-1] != 0.0) {\r\n\u001b[?2004l\r"]
[12681.556482, "o", "\u001b[?2004h> "]
[12681.556834, "o", "            rate = res->history[i] / res->history[i-1];\r\n\u001b[?2004l\r"]
[12681.556912, "o", "\u001b[?2004h> "]
[12681.556978, "o", "        }\r\n\u001b[?2004l\r"]
[12681.557027, "o", "\u001b[?2004h> "]
[12681.557739, "o", "        fprintf(fp, \"%d\\\\t%.15e\\\\t%.15e\\\\t%.15e\\\\n\", i, res->history[i], res->precond_history[i], rate);\r\n\u001b[?2004l\r"]
[12681.557814, "o", "\u001b[?2004h> "]
[12681.557895, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
