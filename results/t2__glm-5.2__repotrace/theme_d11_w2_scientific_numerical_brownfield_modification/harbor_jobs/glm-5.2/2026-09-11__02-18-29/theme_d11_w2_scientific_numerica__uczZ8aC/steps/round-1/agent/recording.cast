[7857.320189, "o", "        fprintf(stderr, \"Error: boundary condition must be <dirichlet|neumann>:<file>\\n\");\r\n        return 1;\r\n    }\r\n\r\n    double hx = (x1 - x0) / (nx - 1);\r\n    double hy = (y1 - y0) / (ny - 1);\r\n    double pe = convdiff_peclet(vx, vy, hx, hy, kappa);\r\n    if (pe > 1.0) {\r\n        fprintf(stderr, \"warning: cell Peclet number %.6e > 1, solution may exhibit oscillations\\n\", pe);\r\n    }\r\n"]
[7857.320238, "o", "\r\n    CSRMatrix *A = NULL;\r\n    double *b = NULL;\r\n    if (convdiff_assemble(nx, ny, x0, x1, y0, y1, kappa, vx, vy,\r\n                          source, left, right, bottom, top, &A, &b) != 0) {\r\n        fprintf(stderr, \"Error: cannot assemble convdiff system\\n\");\r\n        return 1;\r\n    }\r\n\r\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\r\n    printf(\"peclet: %.6e\\n\", pe);\r\n\r\n    free(b);\r\n    csr_destroy(A);\r\n    return rc;\r\n}\r\n\r\nint main(int argc, char **argv)\r\n{\r\n"]
[7857.320334, "o", "    if (argc < 2) {\r\n        usage(argv[0]);\r\n        return 1;\r\n    }\r\n\r\n    const char *cmd = argv[1];\r\n\r\n    if (strcmp(cmd, \"dense-solve\") == 0) {\r\n        return cmd_dense_solve(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"sparse-solve\") == 0) {\r\n        return cmd_sparse_solve(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"poisson\") == 0) {\r\n        return cmd_poisson(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"heat\") == 0) {\r\n        return cmd_heat(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"convdiff\") == 0) {\r\n        return cmd_convdiff(argc - 2, argv + 2);\r\n    } else if (strcmp(cmd, \"--help\") == 0 || strcmp(cmd, \"-h\") == 0) {\r\n        usage(argv[0]);\r\n"]
[7857.32038, "o", "        return 0;\r\n    } else {\r\n        fprintf(stderr, \"Error: unknown command '%s'\\n\", cmd);\r\n        usage(argv[0]);\r\n        return 1;\r\n    }\r\n}\r\n"]
[7857.320902, "o", "\u001b[?2004h"]
[7857.320973, "o", "root@n30009:/app# "]
[7857.589166, "i", "sed -n '1,280p' src/solvers.c\n"]
[7857.589466, "o", "sed -n '1,280p' src/solvers.c\r\n"]
[7857.58957, "o", "\u001b[?2004l\r"]
[7857.592406, "o", "#include \"solvers.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <math.h>\r\n#include <string.h>\r\n\r\nstatic SolveResult *result_create(int n, int maxiter)\r\n"]
[7857.592482, "o", "{\r\n    if (maxiter < 0) maxiter = 0;\r\n    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\r\n    if (!res) return NULL;\r\n\r\n    res->x = vec_create(n);\r\n    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\r\n    if (!res->x || !res->history) {\r\n        free(res->x);\r\n        free(res->history);\r\n        free(res);\r\n        return NULL;\r\n    }\r\n"]
[7857.59256, "o", "    res->history_len = 0;\r\n    return res;\r\n}\r\n\r\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                      double tol, int maxiter, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n"]
[7857.592635, "o", "    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *p = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    if (!r || !z || !p || !Ap) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n"]
[7857.592705, "o", "\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    res->history[0] = res->relres;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n"]
[7857.592782, "o", "    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n\r\n    if (precond_apply(P, A, r, z) != 0) {\r\n        free(r); free(z); free(p); free(Ap);\r\n        return res;\r\n    }\r\n    vec_copy(z, p, n);\r\n    double rz_old = vec_dot(r, z, n);\r\n\r\n    for (int iter = 1; iter <= maxiter; iter++) {\r\n        csr_spmv(A, p, Ap);\r\n        double pAp = vec_dot(p, Ap, n);\r\n        if (fabs(pAp) < 1e-30) break;\r\n\r\n        double alpha = rz_old / pAp;\r\n        vec_axpy(alpha, p, res->x, n);\r\n        vec_axpy(-alpha, Ap, r, n);\r\n\r\n        /* Recompute the true residual rather than relying on the recurrence. */\r\n        csr_spmv(A, res->x, Ap);\r\n"]
[7857.592855, "o", "        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n        res->relres = res->true_residual / bnorm;\r\n        res->history[iter] = res->relres;\r\n        res->history_len = iter + 1;\r\n        res->iterations = iter;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double rz_new = vec_dot(r, z, n);\r\n"]
[7857.592967, "o", "        if (fabs(rz_old) < 1e-30) break;\r\n        double beta = rz_new / rz_old;\r\n        vec_scale(beta, p, n);\r\n        vec_axpy(1.0, z, p, n);\r\n        rz_old = rz_new;\r\n    }\r\n\r\n    free(r); free(z); free(p); free(Ap);\r\n    return res;\r\n}\r\n\r\nstatic void apply_givens(double *a, double *b, double c, double s)\r\n{\r\n    double t = c * (*a) + s * (*b);\r\n    *b = -s * (*a) + c * (*b);\r\n    *a = t;\r\n}\r\n\r\nstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\r\n{\r\n    if (kdim <= 0) return -1;\r\n\r\n    double *c = (double *)malloc(m * sizeof(double));\r\n"]
[7857.59304, "o", "    double *s = (double *)malloc(m * sizeof(double));\r\n    if (!c || !s) { free(c); free(s); return -1; }\r\n\r\n    for (int i = 0; i < kdim; i++) {\r\n        for (int k = 0; k < i; k++) {\r\n            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\r\n        }\r\n\r\n        double a = H[i*m+i];\r\n        double b = H[(i+1)*m+i];\r\n        if (b == 0.0) {\r\n            c[i] = 1.0;\r\n            s[i] = 0.0;\r\n        } else {\r\n"]
[7857.593112, "o", "            double r = hypot(a, b);\r\n            c[i] = a / r;\r\n            s[i] = b / r;\r\n        }\r\n        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n        apply_givens(&g[i], &g[i+1], c[i], s[i]);\r\n\r\n    }\r\n\r\n    for (int i = kdim - 1; i >= 0; i--) {\r\n        double sum = g[i];\r\n        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\r\n        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\r\n        y[i] = sum / H[i*m+i];\r\n"]
[7857.593183, "o", "    }\r\n\r\n    free(c);\r\n    free(s);\r\n    return 0;\r\n}\r\n\r\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n                           double tol, int maxiter, int m, Precond *P)\r\n{\r\n    if (!A || !b || A->rows != A->cols) return NULL;\r\n    int n = A->rows;\r\n    if (m <= 0) m = 30;\r\n"]
[7857.593226, "o", "    if (maxiter < 0) maxiter = 0;\r\n\r\n    SolveResult *res = result_create(n, maxiter);\r\n    if (!res) return NULL;\r\n\r\n    double *r = vec_create(n);\r\n    double *z = vec_create(n);\r\n    double *Ap = vec_create(n);\r\n    double *Av = vec_create(n);\r\n    double *w = vec_create(n);\r\n"]
[7857.593269, "o", "    double *g = (double *)malloc((m + 1) * sizeof(double));\r\n    double *y = (double *)malloc(m * sizeof(double));\r\n    double *H = (double *)calloc((m + 1) * m, sizeof(double));\r\n    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\r\n\r\n    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        solve_result_destroy(res);\r\n        return NULL;\r\n"]
[7857.593379, "o", "    }\r\n\r\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\r\n\r\n    csr_spmv(A, res->x, Ap);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n    double bnorm = vec_norm2(b, n);\r\n    if (bnorm == 0.0) bnorm = 1.0;\r\n\r\n    res->true_residual = vec_norm2(r, n);\r\n    res->relres = res->true_residual / bnorm;\r\n    res->history[0] = res->relres;\r\n    res->history_len = 1;\r\n    res->converged = (res->relres < tol) ? 1 : 0;\r\n    res->iterations = 0;\r\n    if (res->converged || maxiter == 0) {\r\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n        return res;\r\n    }\r\n\r\n    for (int cycle = 1; cycle <= maxiter; cycle++) {\r\n        if (precond_apply(P, A, r, z) != 0) break;\r\n        double beta = vec_norm2(z, n);\r\n"]
[7857.593423, "o", "        if (beta == 0.0) break;\r\n\r\n        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\r\n        for (int i = 0; i <= m; i++) g[i] = 0.0;\r\n        g[0] = beta;\r\n        memset(H, 0, (m + 1) * m * sizeof(double));\r\n\r\n        int kdim = 0;\r\n        int fail = 0;\r\n"]
[7857.593522, "o", "        for (int j = 0; j < m; j++) {\r\n            csr_spmv(A, V + j * n, Av);\r\n            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\r\n\r\n            for (int i = 0; i <= j; i++) {\r\n                double h = vec_dot(w, V + i * n, n);\r\n                H[i*m+j] = h;\r\n                vec_axpy(-h, V + i * n, w, n);\r\n            }\r\n"]
[7857.593595, "o", "\r\n            double hnorm = vec_norm2(w, n);\r\n            H[(j+1)*m+j] = hnorm;\r\n            kdim = j + 1;\r\n\r\n            if (hnorm < 1e-14) break;\r\n\r\n            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n        }\r\n        if (fail) break;\r\n        if (kdim == 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n\r\n        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n\r\n        csr_spmv(A, res->x, Ap);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\r\n\r\n        res->true_residual = vec_norm2(r, n);\r\n"]
[7857.593676, "o", "        res->relres = res->true_residual / bnorm;\r\n        res->history[cycle] = res->relres;\r\n        res->history_len = cycle + 1;\r\n        res->iterations = cycle;\r\n\r\n        if (res->relres < tol) {\r\n            res->converged = 1;\r\n            break;\r\n        }\r\n    }\r\n\r\n    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\r\n    return res;\r\n}\r\n\r\nvoid solve_result_destroy(SolveResult *res)\r\n{\r\n    if (!res) return;\r\n    free(res->x);\r\n"]
[7857.593742, "o", "    free(res->history);\r\n    free(res);\r\n}\r\n"]
[7857.594218, "o", "\u001b[?2004h"]
[7857.594298, "o", "root@n30009:/app# "]
[7857.872082, "i", "sed -n '1,360p' src/precond.c\n"]
[7857.872386, "o", "sed -n '1,360p' src/precond.c\r\n\u001b[?2004l\r"]
[7857.87538, "o", "#include \"precond.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n\r\n"]
[7857.875477, "o", "static int find_in_row(const CSRMatrix *A, int row, int col)\r\n{\r\n    int lo = A->row_ptr[row];\r\n    int hi = A->row_ptr[row+1] - 1;\r\n    while (lo <= hi) {\r\n        int mid = (lo + hi) / 2;\r\n        if (A->col_indices[mid] == col) return mid;\r\n        if (A->col_indices[mid] < col) lo = mid + 1;\r\n        else hi = mid - 1;\r\n    }\r\n    return -1;\r\n}\r\n\r\nstatic CSRMatrix *csr_copy(const CSRMatrix *A)\r\n{\r\n    CSRMatrix *B = csr_create(A->rows, A->cols, A->nnz);\r\n    if (!B) return NULL;\r\n    memcpy(B->values, A->values, A->nnz * sizeof(double));\r\n    memcpy(B->col_indices, A->col_indices, A->nnz * sizeof(int));\r\n    memcpy(B->row_ptr, A->row_ptr, (A->rows + 1) * sizeof(int));\r\n"]
[7857.875557, "o", "    return B;\r\n}\r\n\r\nstatic int ilu0_factorize(CSRMatrix *LU)\r\n{\r\n    int n = LU->rows;\r\n    for (int i = 0; i < n; i++) {\r\n        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n            int c = LU->col_indices[k];\r\n            if (c >= i) break;\r\n\r\n            int d = find_in_row(LU, c, c);\r\n            if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;\r\n\r\n            LU->values[k] /= LU->values[d];\r\n            double aik = LU->values[k];\r\n\r\n"]
[7857.87563, "o", "            for (int l = LU->row_ptr[c]; l < LU->row_ptr[c+1]; l++) {\r\n                int j = LU->col_indices[l];\r\n                if (j <= c) continue;\r\n                int idx = find_in_row(LU, i, j);\r\n                if (idx >= 0) LU->values[idx] -= aik * LU->values[l];\r\n            }\r\n        }\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int ilu_forward_solve(const CSRMatrix *LU, const double *r, double *y)\r\n{\r\n    for (int i = 0; i < LU->rows; i++) {\r\n        double s = r[i];\r\n"]
[7857.875705, "o", "        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n            int j = LU->col_indices[k];\r\n            if (j < i) s -= LU->values[k] * y[j];\r\n            else break;\r\n        }\r\n        y[i] = s;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int ilu_backward_solve(const CSRMatrix *LU, const double *y, double *z)\r\n{\r\n    for (int i = LU->rows - 1; i >= 0; i--) {\r\n        double s = y[i];\r\n        int d = -1;\r\n        for (int k = LU->row_ptr[i]; k < LU->row_ptr[i+1]; k++) {\r\n"]
[7857.875781, "o", "            int j = LU->col_indices[k];\r\n            if (j == i) d = k;\r\n            else if (j > i) s -= LU->values[k] * z[j];\r\n        }\r\n        if (d < 0 || fabs(LU->values[d]) < 1e-15) return -1;\r\n        z[i] = s / LU->values[d];\r\n    }\r\n    return 0;\r\n}\r\n\r\nPrecond *precond_create(const CSRMatrix *A, const char *name, double omega)\r\n{\r\n    if (!A || !name || A->rows != A->cols) return NULL;\r\n\r\n    Precond *P = (Precond *)calloc(1, sizeof(Precond));\r\n    if (!P) return NULL;\r\n\r\n"]
[7857.875854, "o", "    P->n = A->rows;\r\n    P->omega = (omega > 0.0) ? omega : 1.0;\r\n\r\n    if (strcmp(name, \"none\") == 0) {\r\n        P->type = PRECOND_NONE;\r\n    } else if (strcmp(name, \"jacobi\") == 0) {\r\n        P->type = PRECOND_JACOBI;\r\n        P->diag = csr_diagonal(A);\r\n        if (!P->diag) { precond_destroy(P); return NULL; }\r\n    } else if (strcmp(name, \"ilu0\") == 0) {\r\n        P->type = PRECOND_ILU0;\r\n"]
[7857.875936, "o", "        P->lu = csr_copy(A);\r\n        if (!P->lu) { precond_destroy(P); return NULL; }\r\n        if (ilu0_factorize(P->lu) != 0) { precond_destroy(P); return NULL; }\r\n    } else if (strcmp(name, \"ssor\") == 0) {\r\n        P->type = PRECOND_SSOR;\r\n        P->ssor_A = A;\r\n        P->diag = csr_diagonal(A);\r\n        if (!P->diag) { precond_destroy(P); return NULL; }\r\n    } else {\r\n        precond_destroy(P);\r\n        return NULL;\r\n    }\r\n\r\n    return P;\r\n}\r\n\r\nvoid precond_destroy(Precond *P)\r\n{\r\n    if (!P) return;\r\n    free(P->diag);\r\n    csr_destroy(P->lu);"]
[7857.876002, "o", "\r\n    free(P);\r\n}\r\n\r\nint precond_apply(Precond *P, const CSRMatrix *A, const double *r, double *z)\r\n{\r\n    int n = A ? A->rows : (P ? P->n : 0);\r\n    if (!P || P->type == PRECOND_NONE) {\r\n        vec_copy(r, z, n);\r\n        return 0;\r\n    }\r\n\r\n"]
[7857.876083, "o", "    switch (P->type) {\r\n    case PRECOND_JACOBI:\r\n        for (int i = 0; i < n; i++) {\r\n            if (fabs(P->diag[i]) < 1e-15) return -1;\r\n            z[i] = r[i] / P->diag[i];\r\n        }\r\n        return 0;\r\n\r\n    case PRECOND_ILU0: {\r\n        double *y = vec_create(n);\r\n        if (!y) return -1;\r\n        if (ilu_forward_solve(P->lu, r, y) != 0) { free(y); return -1; }\r\n        if (ilu_backward_solve(P->lu, y, z) != 0) { free(y); return -1; }\r\n        free(y);\r\n        return 0;\r\n    }\r\n\r\n    case PRECOND_SSOR: {\r\n"]
[7857.876156, "o", "        const CSRMatrix *M = A ? A : P->ssor_A;\r\n        if (!M) return -1;\r\n        vec_zero(z, n);\r\n\r\n        for (int i = 0; i < n; i++) {\r\n            double diag = P->diag[i];\r\n            if (fabs(diag) < 1e-15) return -1;\r\n            double sum = 0.0;\r\n            for (int k = M->row_ptr[i]; k < M->row_ptr[i+1]; k++) {\r\n"]
[7857.876231, "o", "                int j = M->col_indices[k];\r\n                if (j != i) sum += M->values[k] * z[j];\r\n            }\r\n            z[i] = (1.0 - P->omega) * z[i] + (P->omega / diag) * (r[i] - sum);\r\n        }\r\n        for (int i = n - 1; i >= 0; i--) {\r\n            double diag = P->diag[i];\r\n            if (fabs(diag) < 1e-15) return -1;\r\n            double sum = 0.0;\r\n            for (int k = M->row_ptr[i]; k < M->row_ptr[i+1]; k++) {\r\n                int j = M->col_indices[k];\r\n                if (j != i) sum += M->values[k] * z[j];\r\n            }\r\n            z[i] = (1.0 - P->omega) * z[i] + (P->omega / diag) * (r[i] - sum);\r\n"]
[7857.876274, "o", "        }\r\n        return 0;\r\n    }\r\n\r\n    default:\r\n        vec_copy(r, z, n);\r\n        return 0;\r\n    }\r\n}\r\n"]
[7857.876789, "o", "\u001b[?2004h"]
[7857.876859, "o", "root@n30009:/app# "]
[7858.149666, "i", "sed -n '1,260p' src/sparse.c\n"]
[7858.150001, "o", "sed -n '1,260p' src/sparse.c\r\n"]
[7858.150104, "o", "\u001b[?2004l\r"]
[7858.152905, "o", "#include \"sparse.h\"\r\n#include \"vector.h\"\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n"]
[7858.152976, "o", "\r\nCSRMatrix *csr_create(int rows, int cols, int nnz)\r\n{\r\n    CSRMatrix *A = (CSRMatrix *)malloc(sizeof(CSRMatrix));\r\n    if (!A) return NULL;\r\n    A->rows = rows;\r\n    A->cols = cols;\r\n    A->nnz = nnz;\r\n    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));\r\n    A->col_indices = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    A->row_ptr = (int *)calloc((rows >= 0 ? rows + 1 : 1), sizeof(int));\r\n"]
[7858.153058, "o", "    if (!A->values || !A->col_indices || !A->row_ptr) {\r\n        csr_destroy(A);\r\n        return NULL;\r\n    }\r\n    return A;\r\n}\r\n\r\nvoid csr_destroy(CSRMatrix *A)\r\n{\r\n    if (!A) return;\r\n    free(A->values);\r\n    free(A->col_indices);\r\n    free(A->row_ptr);\r\n    free(A);\r\n}\r\n\r\n"]
[7858.153127, "o", "COOMatrix *coo_create(int rows, int cols, int nnz)\r\n{\r\n    COOMatrix *A = (COOMatrix *)malloc(sizeof(COOMatrix));\r\n    if (!A) return NULL;\r\n    A->rows = rows;\r\n    A->cols = cols;\r\n    A->nnz = nnz;\r\n    A->values = (double *)calloc((nnz > 0 ? nnz : 1), sizeof(double));\r\n    A->row = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    A->col = (int *)calloc((nnz > 0 ? nnz : 1), sizeof(int));\r\n    if (!A->values || !A->row || !A->col) {\r\n        coo_destroy(A);\r\n"]
[7858.153199, "o", "        return NULL;\r\n    }\r\n    return A;\r\n}\r\n\r\nvoid coo_destroy(COOMatrix *A)\r\n{\r\n    if (!A) return;\r\n    free(A->values);\r\n    free(A->row);\r\n    free(A->col);\r\n    free(A);\r\n}\r\n\r\n"]
[7858.153246, "o", "static const COOMatrix *g_coo_sort_data = NULL;\r\n\r\nstatic int coo_qsort_cmp(const void *pa, const void *pb)\r\n{\r\n    int ia = *(const int *)pa;\r\n    int ib = *(const int *)pb;\r\n    const COOMatrix *A = g_coo_sort_data;\r\n    if (A->row[ia] != A->row[ib]) return A->row[ia] - A->row[ib];\r\n    return A->col[ia] - A->col[ib];\r\n}\r\n"]
[7858.153334, "o", "\r\nstatic COOMatrix *coo_sort_dedup(const COOMatrix *A)\r\n{\r\n    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);\r\n    if (!out) return NULL;\r\n\r\n    int *idx = (int *)malloc((A->nnz > 0 ? A->nnz : 1) * sizeof(int));\r\n    if (!idx) { coo_destroy(out); return NULL; }\r\n    for (int i = 0; i < A->nnz; i++) idx[i] = i;\r\n\r\n    g_coo_sort_data = A;\r\n    qsort(idx, A->nnz, sizeof(int), coo_qsort_cmp);\r\n    g_coo_sort_data = NULL;\r\n\r\n    int k = 0;\r\n    for (int i = 0; i < A->nnz; i++) {\r\n"]
[7858.153404, "o", "        int src = idx[i];\r\n        if (k > 0 && out->row[k-1] == A->row[src] && out->col[k-1] == A->col[src]) {\r\n            out->values[k-1] += A->values[src];\r\n        } else {\r\n            out->row[k] = A->row[src];\r\n            out->col[k] = A->col[src];\r\n            out->values[k] = A->values[src];\r\n            k++;\r\n        }\r\n    }\r\n    out->nnz = k;\r\n    free(idx);\r\n    return out;\r\n"]
[7858.15347, "o", "}\r\n\r\nCOOMatrix *csr_to_coo(const CSRMatrix *A)\r\n{\r\n    COOMatrix *out = coo_create(A->rows, A->cols, A->nnz);\r\n    if (!out) return NULL;\r\n    int k = 0;\r\n    for (int i = 0; i < A->rows; i++) {\r\n        for (int j = A->row_ptr[i]; j < A->row_ptr[i+1]; j++) {\r\n            out->row[k] = i;\r\n            out->col[k] = A->col_indices[j];\r\n            out->values[k] = A->values[j];\r\n            k++;\r\n"]
[7858.153543, "o", "        }\r\n    }\r\n    out->nnz = k;\r\n    return out;\r\n}\r\n\r\nCSRMatrix *coo_to_csr(const COOMatrix *A)\r\n{\r\n"]
[7858.153615, "o", "    COOMatrix *sorted = coo_sort_dedup(A);\r\n    if (!sorted) return NULL;\r\n\r\n    CSRMatrix *out = csr_create(sorted->rows, sorted->cols, sorted->nnz);\r\n    if (!out) { coo_destroy(sorted); return NULL; }\r\n\r\n    for (int i = 0; i <= sorted->rows; i++) out->row_ptr[i] = 0;\r\n\r\n    for (int k = 0; k < sorted->nnz; k++) {\r\n        out->row_ptr[sorted->row[k] + 1]++;\r\n    }\r\n    for (int i = 0; i < sorted->rows; i++) {\r\n        out->row_ptr[i+1] += out->row_ptr[i];\r\n    }\r\n\r\n    int *next = (int *)malloc((sorted->rows > 0 ? sorted->rows : 1) * sizeof(int));\r\n    if (!next) { csr_destroy(out); coo_destroy(sorted); return NULL; }\r\n    for (int i = 0; i < sorted->rows; i++) next[i] = out->row_ptr[i];\r\n\r\n    for (int k = 0; k < sorted->nnz; k++) {\r\n        int r = sorted->row[k];\r\n"]
[7858.153682, "o", "        int pos = next[r]++;\r\n        out->col_indices[pos] = sorted->col[k];\r\n        out->values[pos] = sorted->values[k];\r\n    }\r\n\r\n    free(next);\r\n    coo_destroy(sorted);\r\n    return out;\r\n}\r\n\r\nvoid csr_spmv(const CSRMatrix *A, const double *x, double *y)\r\n{\r\n    for (int i = 0; i < A->rows; i++) {\r\n        double s = 0.0;\r\n"]
[7858.153754, "o", "        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n            s += A->values[k] * x[A->col_indices[k]];\r\n        }\r\n        y[i] = s;\r\n    }\r\n}\r\n\r\nstatic int csr_find_in_row(const CSRMatrix *A, int row, int col)\r\n{\r\n    int lo = A->row_ptr[row];\r\n    int hi = A->row_ptr[row+1] - 1;\r\n    while (lo <= hi) {\r\n        int mid = (lo + hi) / 2;\r\n        if (A->col_indices[mid] == col) return mid;\r\n        if (A->col_indices[mid] < col) lo = mid + 1;\r\n"]
[7858.153823, "o", "        else hi = mid - 1;\r\n    }\r\n    return -1;\r\n}\r\n\r\nCSRMatrix *csr_transpose(const CSRMatrix *A)\r\n{\r\n    CSRMatrix *T = csr_create(A->cols, A->rows, A->nnz);\r\n    if (!T) return NULL;\r\n\r\n    for (int i = 0; i <= A->cols; i++) T->row_ptr[i] = 0;\r\n"]
[7858.153938, "o", "    for (int k = 0; k < A->nnz; k++) {\r\n        T->row_ptr[A->col_indices[k] + 1]++;\r\n    }\r\n    for (int i = 0; i < A->cols; i++) {\r\n        T->row_ptr[i+1] += T->row_ptr[i];\r\n    }\r\n\r\n    int *next = (int *)malloc((A->cols > 0 ? A->cols : 1) * sizeof(int));\r\n    if (!next) { csr_destroy(T); return NULL; }\r\n    for (int i = 0; i < A->cols; i++) next[i] = T->row_ptr[i];\r\n\r\n    for (int i = 0; i < A->rows; i++) {\r\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n            int c = A->col_indices[k];\r\n            int pos = next[c]++;\r\n            T->col_indices[pos] = i;\r\n            T->values[pos] = A->values[k];\r\n        }\r\n    }\r\n\r\n    free(next);\r\n    return T;\r\n}\r\n\r\nint csr_is_symmetric(const CSRMatrix *A, double tol)\r\n{\r\n    if (A->rows != A->cols) return 0;\r\n    for (int i = 0; i < A->rows; i++) {\r\n"]
[7858.153987, "o", "        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n            int j = A->col_indices[k];\r\n            int idx = csr_find_in_row(A, j, i);\r\n            if (idx < 0) return 0;\r\n            if (fabs(A->values[k] - A->values[idx]) > tol) return 0;\r\n        }\r\n    }\r\n    return 1;\r\n}\r\n\r\n"]
[7858.154081, "o", "double *csr_diagonal(const CSRMatrix *A)\r\n{\r\n    int n = A->rows < A->cols ? A->rows : A->cols;\r\n    double *diag = vec_create(n);\r\n    if (!diag) return NULL;\r\n    for (int i = 0; i < n; i++) {\r\n        int idx = csr_find_in_row(A, i, i);\r\n        diag[i] = (idx >= 0) ? A->values[idx] : 0.0;\r\n    }\r\n    return diag;\r\n}\r\n\r\nstatic int mm_parse_header(const char *line, int *is_array, int *is_symmetric)\r\n{\r\n    char buf[1024];\r\n    strncpy(buf, line, sizeof(buf)-1);\r\n    buf[sizeof(buf)-1] = '\\0';\r\n\r\n    char *tok = strtok(buf, \" \\t\\r\\n\");\r\n    if (!tok || strcmp(tok, \"%%MatrixMarket\") != 0) return -1;\r\n"]
[7858.154153, "o", "\r\n    tok = strtok(NULL, \" \\t\\r\\n\");\r\n    if (!tok || strcmp(tok, \"matrix\") != 0) return -1;\r\n\r\n    tok = strtok(NULL, \" \\t\\r\\n\");\r\n    if (!tok) return -1;\r\n    if (strcmp(tok, \"coordinate\") == 0) *is_array = 0;\r\n    else if (strcmp(tok, \"array\") == 0) *is_array = 1;\r\n    else return -1;\r\n\r\n    tok = strtok(NULL, \" \\t\\r\\n\");\r\n    if (!tok) return -1;\r\n    if (strcmp(tok, \"real\") != 0 && strcmp(tok, \"double\") != 0) return -1;\r\n\r\n"]
[7858.154227, "o", "    *is_symmetric = 0;\r\n    tok = strtok(NULL, \" \\t\\r\\n\");\r\n    if (tok && strcmp(tok, \"symmetric\") == 0) *is_symmetric = 1;\r\n\r\n    return 0;\r\n}\r\n\r\nstatic int read_non_comment_line(FILE *fp, char *buf, int bufsize)\r\n{\r\n"]
