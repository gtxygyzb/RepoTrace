[3840.579936, "i", "cat > src/heat.c <<'EOF'\n#include \"heat.h\"\n#include \"vector.h\"\n#include \"sparse.h\"\n#include \"solvers.h\"\n#include \"precond.h\"\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdio.h>\n\nstatic void add_coo(COOMatrix *coo, int *k, int r, int c, double v)\n{\n    coo->row[*k] = r;\n    coo->col[*k] = c;\n    coo->values[*k] = v;\n    (*k)++;\n}\n\nstatic int is_dirichlet_node(int i, int j, int nx, int ny,\n                            PoissonBC left, PoissonBC right,\n                            PoissonBC bottom, PoissonBC top)\n{\n    if (i == 0 && left.type == POISSON_DIRICHLET) return 1;\n    if (i == nx - 1 && right.type == POISSON_DIRICHLET) return 1;\n    if (j == 0 && bottom.type == POISSON_DIRICHLET) return 1;\n    if (j == ny - 1 && top.type == POISSON_DIRICHLET) return 1;\n    return 0;\n}\n\nstatic double dirichlet_value(int i, int j, int nx, int ny,\n                              double *left_vals, double *right_vals,\n                              double *bottom_vals, double *top_vals,\n                 "]
[3840.580172, "i", "             PoissonBC left, PoissonBC right,\n                              PoissonBC bottom, PoissonBC top)\n{\n    if (i == 0 && left.type == POISSON_DIRICHLET) return left_vals[j];\n    if (i == nx - 1 && right.type == POISSON_DIRICHLET) return right_vals[j];\n    if (j == 0 && bottom.type == POISSON_DIRICHLET) return bottom_vals[i];\n    if (j == ny - 1 && top.type == POISSON_DIRICHLET) return top_vals[i];\n    return 0.0;\n}\n\n/* Assemble stiffness matrix K (negative Laplacian) with Neumann one-sided\n * stencil where applicable.  Dirichlet rows use the standard stencil; they are\n * later replaced with identity rows in the time-stepping matrix.  The returned\n * flux vector contains the Neumann boundary flux contributions. */\nstatic CSRMatrix *assemble_stiffness(int nx, int ny, double x0, double x1,\n                                     double y0, double y1,\n                                     PoissonBC left, PoissonBC right,\n                                     PoissonBC bottom, PoissonBC top,\n                   "]
[3840.580238, "o", "cat > src/heat.c <<'EOF'\r\n"]
[3840.580309, "i", "                  double *left_vals, double *right_vals,\n                                     double *bottom_vals, double *top_vals,\n                                     double **flux_out)\n{\n    int n = nx * ny;\n    COOMatrix *coo = coo_create(n, n, 5 * n);\n    double *flux = vec_create(n);\n    if (!coo || !flux) { coo_destroy(coo); free(flux); return NULL; }\n\n    double hx = (x1 - x0) / (nx - 1);\n    double hy = (y1 - y0) / (ny - 1);\n    double hx2 = hx * hx;\n    double hy2 = hy * hy;\n\n    int k = 0;\n    for (int i = 0; i < nx; i++) {\n        for (int j = 0; j < ny; j++) {\n            int idx = i * ny + j;\n            int is_left = (i == 0);\n            int is_right = (i == nx - 1);\n            int is_bottom = (j == 0);\n            int is_top = (j == ny - 1);\n\n            double diag = 0.0;\n            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;\n\n            if (is_left && left.type == POISSON_NEUMANN) {\n                diag += 2.0 / hx2;\n                c_ip = -2.0 / hx2;\n                flux[idx"]
[3840.580366, "o", "\u001b[?2004l\r             PoissonBC left, PoissonBC right,\r\n                              PoissonBC bottom, PoissonBC top)\r\n{\r\n    if (i == 0 && left.type == POISSON_DIRICHLET) return left_vals[j];\r\n    if (i == nx - 1 && right.type == POISSON_DIRICHLET"]
[3840.580436, "i", "] += 2.0 * left_vals[j] / hx;\n            } else if (is_right && right.type == POISSON_NEUMANN) {\n                diag += 2.0 / hx2;\n                c_im = -2.0 / hx2;\n                flux[idx] += 2.0 * right_vals[j] / hx;\n            } else if (!is_left && !is_right) {\n                diag += 2.0 / hx2;\n                c_im = -1.0 / hx2;\n                c_ip = -1.0 / hx2;\n            } else {\n                /* Boundary node with Dirichlet or unspecified BC: use the\n                 * standard interior stencil with the missing neighbour\n                 * omitted. */\n                diag += 2.0 / hx2;\n                if (is_left) c_ip = -1.0 / hx2;\n                if (is_right) c_im = -1.0 / hx2;\n            }\n\n            if (is_bottom && bottom.type == POISSON_NEUMANN) {\n                diag += 2.0 / hy2;\n                c_jp = -2.0 / hy2;\n                flux[idx] += 2.0 * bottom_vals[i] / hy;\n            } else if (is_top && top.type == POISSON_NEUMANN) {\n                diag += 2.0 / hy2;\n              "]
[3840.580489, "o", ") return right_vals[j];\r\n    if (j == 0 && bottom.type == POISSON_DIRICHLET) return bottom_vals[i];\r\n    if (j == ny - 1 && top.type == POISSON_DIRICHLET) return top_vals[i];\r\n    return 0.0;\r\n}\r\n\r\n/* Assemble stiffness matrix K (negative"]
[3840.580547, "i", "  c_jm = -2.0 / hy2;\n                flux[idx] += 2.0 * top_vals[i] / hy;\n            } else if (!is_bottom && !is_top) {\n                diag += 2.0 / hy2;\n                c_jm = -1.0 / hy2;\n                c_jp = -1.0 / hy2;\n            } else {\n                diag += 2.0 / hy2;\n                if (is_bottom) c_jp = -1.0 / hy2;\n                if (is_top) c_jm = -1.0 / hy2;\n            }\n\n            add_coo(coo, &k, idx, idx, diag);\n            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);\n            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);\n            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);\n            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);\n        }\n    }\n\n    coo->nnz = k;\n    CSRMatrix *K = coo_to_csr(coo);\n    coo_destroy(coo);\n    if (!K) { free(flux); return NULL; }\n    *flux_out = flux;\n    return K;\n}\n\n/* Assemble the time-stepping system matrix I + factor*K with Dirichlet rows\n * replaced"]
[3840.58061, "o", " Laplacian) with Neumann one-sided\r\n * stencil where applicable.  Dirichlet rows use the standard stencil; they are\r\n * later replaced wi"]
[3840.580666, "i", " by identity. */\nstatic CSRMatrix *assemble_system_matrix(int nx, int ny, double x0, double x1,\n                                        double y0, double y1,\n                                        PoissonBC left, PoissonBC right,\n                                        PoissonBC bottom, PoissonBC top,\n                                        double factor)\n{\n    int n = nx * ny;\n    COOMatrix *coo = coo_create(n, n, 5 * n);\n    if (!coo) return NULL;\n\n    double hx = (x1 - x0) / (nx - 1);\n    double hy = (y1 - y0) / (ny - 1);\n    double hx2 = hx * hx;\n    double hy2 = hy * hy;\n\n    int k = 0;\n    for (int i = 0; i < nx; i++) {\n        for (int j = 0; j < ny; j++) {\n            int idx = i * ny + j;\n            int is_left = (i == 0);\n            int is_right = (i == nx - 1);\n            int is_bottom = (j == 0);\n            int is_top = (j == ny - 1);\n\n            if (is_dirichlet_node(i, j, nx, ny, left, right, bottom, top)) {\n                add_coo(coo, &k, idx, idx, 1.0);\n                continue;\n       "]
[3840.580717, "o", "th identity rows in the time-stepping matrix.  The returned\r\n * flux vector contains the Neumann boundary flux contributions. */\r\nstatic CS"]
[3840.580775, "i", "     }\n\n            double diag = 1.0;  /* identity contribution */\n            double c_im = 0.0, c_ip = 0.0, c_jm = 0.0, c_jp = 0.0;\n\n            if (is_left && left.type == POISSON_NEUMANN) {\n                diag += factor * 2.0 / hx2;\n                c_ip = factor * (-2.0 / hx2);\n            } else if (is_right && right.type == POISSON_NEUMANN) {\n                diag += factor * 2.0 / hx2;\n                c_im = factor * (-2.0 / hx2);\n            } else if (!is_left && !is_right) {\n                diag += factor * 2.0 / hx2;\n                c_im = factor * (-1.0 / hx2);\n                c_ip = factor * (-1.0 / hx2);\n            } else {\n                diag += factor * 2.0 / hx2;\n                if (is_left) c_ip = factor * (-1.0 / hx2);\n                if (is_right) c_im = factor * (-1.0 / hx2);\n            }\n\n            if (is_bottom && bottom.type == POISSON_NEUMANN) {\n                diag += factor * 2.0 / hy2;\n                c_jp = factor * (-2.0 / hy2);\n            } else if (is_top && top.type == "]
[3840.580825, "o", "RMatrix *assemble_stiffness(int nx, int ny, double x0, double x1,\r\n                                     double y0, double y1,\r\n                                     PoissonBC left, PoissonBC right,\r\n                   "]
[3840.580901, "i", "POISSON_NEUMANN) {\n                diag += factor * 2.0 / hy2;\n                c_jm = factor * (-2.0 / hy2);\n            } else if (!is_bottom && !is_top) {\n                diag += factor * 2.0 / hy2;\n                c_jm = factor * (-1.0 / hy2);\n                c_jp = factor * (-1.0 / hy2);\n            } else {\n                diag += factor * 2.0 / hy2;\n                if (is_bottom) c_jp = factor * (-1.0 / hy2);\n                if (is_top) c_jm = factor * (-1.0 / hy2);\n            }\n\n            add_coo(coo, &k, idx, idx, diag);\n            if (i > 0 && c_im != 0.0) add_coo(coo, &k, idx, (i-1)*ny+j, c_im);\n            if (i < nx-1 && c_ip != 0.0) add_coo(coo, &k, idx, (i+1)*ny+j, c_ip);\n            if (j > 0 && c_jm != 0.0) add_coo(coo, &k, idx, i*ny+(j-1), c_jm);\n            if (j < ny-1 && c_jp != 0.0) add_coo(coo, &k, idx, i*ny+(j+1), c_jp);\n        }\n    }\n\n    coo->nnz = k;\n    CSRMatrix *A = coo_to_csr(coo);\n    coo_destroy(coo);\n    return A;\n}\n\nstatic int parse_source_list(const char *arg, char ***"]
[3840.580924, "o", "                  PoissonBC bottom, PoissonBC top,\r\n                                     double *left_vals, double *right_vals,\r\n                                     double *bottom_vals, double *to"]
[3840.581011, "i", "files_out, int *count_out)\n{\n    char *copy = strdup(arg);\n    if (!copy) return -1;\n\n    int count = 1;\n    for (char *p = copy; *p; p++) if (*p == ',') count++;\n\n    char **files = (char **)calloc(count, sizeof(char *));\n    if (!files) { free(copy); return -1; }\n\n    int idx = 0;\n    char *tok = strtok(copy, \",\");\n    while (tok) {\n        files[idx++] = strdup(tok);\n        tok = strtok(NULL, \",\");\n    }\n    free(copy);\n\n    if (idx != count) {\n        for (int i = 0; i < idx; i++) free(files[i]);\n        free(files);\n        return -1;\n    }\n\n    *files_out = files;\n    *count_out = count;\n    return 0;\n}\n\nstatic void free_source_list(char **files, int count)\n{\n    for (int i = 0; i < count; i++) free(files[i]);\n    free(files);\n}\nEOF\n"]
