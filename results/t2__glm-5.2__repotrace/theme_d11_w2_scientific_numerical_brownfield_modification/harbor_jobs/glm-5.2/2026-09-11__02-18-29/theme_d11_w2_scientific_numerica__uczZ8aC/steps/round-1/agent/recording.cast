[4298.585666, "o", "\u001b[32m\u001b[K319\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fclose(fp);\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return A;\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[4298.585753, "o", "\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kint csr_write_mm(const CSRMatrix *A, const char *filename)\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    FILE *fp = fopen(filename, \"w\");\r\n\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!fp) return -1;\r\n\u001b[32m\u001b[K327\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fprintf(fp, \"%%%%MatrixMarket matrix coordinate real general\\n\");\r\n\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fprintf(fp, \"%d %d %d\\n\", A->rows, A->cols, A->nnz);\r\n\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (int i = 0; i < A->rows; i++) {\r\n\u001b[32m\u001b[K331\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\r\n\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            fprintf(fp, \"%d %d %.15g\\n\", i+1, A->col_indices[k]+1, A->values[k]);\r\n\u001b[32m\u001b[K333\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K334\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K335\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fclose(fp);\r\n\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return 0;\r\n"]
[4298.585834, "o", "\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K338\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
