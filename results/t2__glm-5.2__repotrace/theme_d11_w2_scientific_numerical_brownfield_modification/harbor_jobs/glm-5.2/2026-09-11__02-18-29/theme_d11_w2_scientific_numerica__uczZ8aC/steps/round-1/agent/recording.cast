[304.398088, "o", "#ifndef SPARSE_H\r\n#define SPARSE_H\r\n\r\n#include <stdio.h>\r\n\r\ntypedef struct {\r\n    int    rows;\r\n    int    cols;\r\n    int    nnz;\r\n    double *values;\r\n    int    *col_indices;\r\n"]
