[12681.558024, "o", "\u001b[?2004h> "]
[12681.558137, "o", "if old not in s:\r\n\u001b[?2004l\r"]
[12681.558192, "o", "\u001b[?2004h"]
[12681.558247, "o", "> "]
[12681.558582, "o", "    raise SystemExit('history writer block not found')\r\n\u001b[?2004l\r"]
[12681.558648, "o", "\u001b[?2004h> "]
[12681.558813, "o", "s = s.replace(old, new)\r\n\u001b[?2004l\r"]
[12681.558896, "o", "\u001b[?2004h> "]
[12681.55928, "o", "old = '''    } else if (strcmp(cmd, \"eigenvalue\") == 0) {\r\n\u001b[?2004l\r"]
[12681.559337, "o", "\u001b[?2004h> "]
[12681.559681, "o", "        return cmd_eigenvalue(argc - 2, argv + 2);\r\n\u001b[?2004l\r"]
[12681.559742, "o", "\u001b[?2004h> "]
[12681.559838, "o", "    } else {\r\n\u001b[?2004l\r"]
[12681.559917, "o", "\u001b[?2004h> "]
[12681.559973, "o", "'''\r\n\u001b[?2004l\r"]
[12681.560028, "o", "\u001b[?2004h> "]
[12681.560398, "o", "new = '''    } else if (strcmp(cmd, \"eigenvalue\") == 0) {\r\n\u001b[?2004l\r"]
[12681.560446, "o", "\u001b[?2004h> "]
[12681.560817, "o", "        return cmd_eigenvalue(argc - 2, argv + 2);\r\n\u001b[?2004l\r"]
[12681.560898, "o", "\u001b[?2004h> "]
[12681.561231, "o", "    } else if (strcmp(cmd, \"condition\") == 0) {\r\n\u001b[?2004l\r"]
[12681.561297, "o", "\u001b[?2004h> "]
[12681.561635, "o", "        return cmd_condition(argc - 2, argv + 2);\r\n\u001b[?2004l\r"]
[12681.561699, "o", "\u001b[?2004h"]
[12681.561754, "o", "> "]
[12681.561829, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.56191, "o", "> '''\r\n\u001b[?2004l\r"]
[12681.561972, "o", "\u001b[?2004h> "]
[12681.562072, "o", "if old not in s:\r\n\u001b[?2004l\r"]
[12681.562132, "o", "\u001b[?2004h> "]
[12681.56247, "o", "    raise SystemExit('dispatch block not found')\r\n\u001b[?2004l\r"]
[12681.562535, "o", "\u001b[?2004h> "]
[12681.562706, "o", "s = s.replace(old, new)\r\n\u001b[?2004l\r"]
[12681.562769, "o", "\u001b[?2004h> "]
[12681.562902, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[12681.56297, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12681.563028, "o", "\u001b[?2004h> "]
[12681.563234, "o", "# Add cmd_condition to eigen.c\r\n\u001b[?2004l\r"]
[12681.563292, "o", "\u001b[?2004h> "]
[12681.563459, "o", "p = Path('src/eigen.c')\r\n\u001b[?2004l\r"]
[12681.563508, "o", "\u001b[?2004h> "]
[12681.563638, "o", "s = p.read_text()\r\n"]
[12681.563694, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[12681.563799, "o", "insert = r'''\r\n"]
[12681.563857, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12681.563943, "o", "\u001b[?2004h> "]
[12681.56422, "o", "int cmd_condition(int argc, char **argv)\r\n\u001b[?2004l\r"]
[12681.564283, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[12681.564336, "o", "\u001b[?2004h> "]
[12681.564728, "o", "    const char *input = get_opt(argc, argv, \"--input\");\r\n\u001b[?2004l\r"]
[12681.564792, "o", "\u001b[?2004h> "]
[12681.565171, "o", "    const char *tol_s = get_opt(argc, argv, \"--tol\");\r\n\u001b[?2004l\r"]
[12681.56523, "o", "\u001b[?2004h> "]
[12681.565644, "o", "    const char *maxiter_s = get_opt(argc, argv, \"--maxiter\");\r\n\u001b[?2004l\r"]
[12681.565702, "o", "\u001b[?2004h> "]
[12681.566085, "o", "    const char *solver = get_opt(argc, argv, \"--solver\");\r\n\u001b[?2004l\r"]
[12681.566144, "o", "\u001b[?2004h> "]
[12681.566489, "o", "    const char *precond = get_opt(argc, argv, \"--precond\");\r\n\u001b[?2004l\r"]
[12681.566546, "o", "\u001b[?2004h> "]
[12681.566857, "o", "    const char *restart_s = get_opt(argc, argv, \"--restart\");\r\n\u001b[?2004l\r"]
[12681.566929, "o", "\u001b[?2004h> "]
[12681.567298, "o", "    const char *omega_s = get_opt(argc, argv, \"--ssor-omega\");\r\n\u001b[?2004l\r"]
[12681.567354, "o", "\u001b[?2004h> "]
[12681.5677, "o", "    const char *solver_tol_s = get_opt(argc, argv, \"--solver-tol\");\r\n\u001b[?2004l\r"]
[12681.567756, "o", "\u001b[?2004h> "]
[12681.568209, "o", "    const char *solver_maxiter_s = get_opt(argc, argv, \"--solver-maxiter\");\r\n\u001b[?2004l\r"]
[12681.568269, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h"]
[12681.568325, "o", "> "]
[12681.568639, "o", "    if (!input || !tol_s || !maxiter_s || !solver || !precond) {\r\n\u001b[?2004l\r"]
[12681.568696, "o", "\u001b[?2004h> "]
[12681.569131, "o", "        fprintf(stderr, \"Error: missing required arguments for condition\\n\");\r\n\u001b[?2004l\r"]
[12681.569191, "o", "\u001b[?2004h> "]
[12681.569272, "o", "        return 1;\r\n\u001b[?2004l\r"]
[12681.569333, "o", "\u001b[?2004h> "]
[12681.569394, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ri"]
[12681.569453, "o", "\u001b[?2004h> "]
[12681.56971, "o", "    double tol, omega = 1.0, solver_tol = 1e-12;\r\n\u001b[?2004l\r"]
[12681.569772, "o", "\u001b[?2004h> "]
[12681.570059, "o", "    int maxiter, restart = 30, solver_maxiter = 1000;\r\n\u001b[?2004l\r"]
[12681.570121, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.570182, "o", "> "]
[12681.570439, "o", "    if (parse_double(tol_s, &tol) != 0 || tol <= 0.0) {\r\n\u001b[?2004l\r"]
[12681.570498, "o", "\u001b[?2004h> "]
[12681.570822, "o", "        fprintf(stderr, \"Error: invalid tol '%s'\\n\", tol_s);\r\n\u001b[?2004l\r"]
[12681.570896, "o", "\u001b[?2004h> "]
[12681.571002, "o", "        return 1;\r\n\u001b[?2004l\r"]
[12681.571062, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r "]
[12681.571121, "o", "\u001b[?2004h> "]
[12681.571365, "o", "    if (parse_int(maxiter_s, &maxiter) != 0) {\r\n\u001b[?2004l\r"]
[12681.571427, "o", "\u001b[?2004h> "]
[12681.571795, "o", "        fprintf(stderr, \"Error: invalid maxiter '%s'\\n\", maxiter_s);\r\n\u001b[?2004l\r"]
[12681.571849, "o", "\u001b[?2004h> "]
[12681.571956, "o", "        return 1;\r\n\u001b[?2004l\r"]
[12681.572017, "o", "\u001b[?2004h> "]
[12681.572078, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.57214, "o", "> "]
[12681.572559, "o", "    if (strcmp(solver, \"cg\") != 0 && strcmp(solver, \"gmres\") != 0) {\r\n\u001b[?2004l\r"]
[12681.572619, "o", "\u001b[?2004h> "]
[12681.572963, "o", "        fprintf(stderr, \"Error: unknown solver '%s'\\n\", solver);\r\n\u001b[?2004l\r"]
[12681.573021, "o", "\u001b[?2004h> "]
[12681.573094, "o", "        return 1;\r\n\u001b[?2004l\r"]
[12681.573152, "o", "\u001b[?2004h> "]
[12681.573208, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12681.573609, "o", "    if (strcmp(precond, \"none\") != 0 && strcmp(precond, \"jacobi\") != 0 &&\r\n\u001b[?2004l\r"]
[12681.573666, "o", "\u001b[?2004h> "]
[12681.574059, "o", "        strcmp(precond, \"ilu0\") != 0 && strcmp(precond, \"ssor\") != 0) {\r\n\u001b[?2004l\r"]
[12681.57409, "o", "\u001b[?2004h> "]
[12681.57448, "o", "        fprintf(stderr, \"Error: unknown preconditioner '%s'\\n\", precond);\r\n\u001b[?2004l\r"]
[12681.574536, "o", "\u001b[?2004h> "]
[12681.574619, "o", "        return 1;\r\n\u001b[?2004l\r"]
[12681.574674, "o", "\u001b[?2004h> "]
[12681.57473, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.574785, "o", "> "]
[12681.574862, "o", "    if (omega_s) {\r\n\u001b[?2004l\r"]
[12681.574933, "o", "\u001b[?2004h> "]
[12681.575412, "o", "        if (parse_double(omega_s, &omega) != 0 || !(omega > 0.0 && omega < 2.0)) {\r\n\u001b[?2004l\r"]
[12681.575472, "o", "\u001b[?2004h> "]
[12681.575818, "o", "            fprintf(stderr, \"error: ssor-omega must be in (0,2)\\n\");\r\n\u001b[?2004l\r"]
[12681.575884, "o", "\u001b[?2004h> "]
[12681.575995, "o", "            return 1;\r\n\u001b[?2004l\r"]
[12681.576051, "o", "\u001b[?2004h> "]
[12681.576114, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.576169, "o", ">     }\r\n\u001b[?2004l\r"]
[12681.576234, "o", "\u001b[?2004h> "]
[12681.576524, "o", "    if (restart_s && parse_int(restart_s, &restart) != 0) {\r\n\u001b[?2004l\r"]
[12681.576579, "o", "\u001b[?2004h> "]
[12681.576831, "o", "        fprintf(stderr, \"Error: invalid restart '%s'\\n\", restart_s);\r\n\u001b[?2004l\r"]
[12681.576901, "o", "\u001b[?2004h> "]
[12681.576968, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[12681.577024, "o", "\u001b[?2004h> "]
[12681.577258, "o", "    if (solver_tol_s && (parse_double(solver_tol_s, &solver_tol) != 0 || solver_tol <= 0.0)) {\r\n\u001b[?2004l\r"]
[12681.577313, "o", "\u001b[?2004h> "]
[12681.577484, "o", "        fprintf(stderr, \"Error: invalid solver-tol '%s'\\n\", solver_tol_s);\r\n\u001b[?2004l\r"]
[12681.57754, "o", "\u001b[?2004h> "]
[12681.577595, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[12681.57765, "o", "\u001b[?2004h> "]
[12681.577852, "o", "    if (solver_maxiter_s && parse_int(solver_maxiter_s, &solver_maxiter) != 0) {\r\n\u001b[?2004l\r"]
[12681.577926, "o", "\u001b[?2004h> "]
[12681.578106, "o", "        fprintf(stderr, \"Error: invalid solver-maxiter '%s'\\n\", solver_maxiter_s);\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.578195, "o", "> "]
[12681.578255, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12681.578322, "o", "\u001b[?2004h> "]
[12681.578389, "o", "    CSRMatrix *A = csr_read_mm(input);\r\n\u001b[?2004l\r"]
[12681.578444, "o", "\u001b[?2004h>     if (!A) {\r\n\u001b[?2004l\r"]
[12681.578499, "o", "\u001b[?2004h> "]
[12681.578696, "o", "        fprintf(stderr, \"Error: cannot read sparse matrix from '%s'\\n\", input);\r\n\u001b[?2004l\r"]
[12681.578751, "o", "\u001b[?2004h> "]
[12681.578805, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[12681.578859, "o", "\u001b[?2004h> "]
[12681.578936, "o", "    if (A->rows != A->cols) {\r\n\u001b[?2004l\r"]
[12681.578992, "o", "\u001b[?2004h> "]
[12681.579155, "o", "        fprintf(stderr, \"Error: condition requires a square matrix\\n\");\r\n\u001b[?2004l\r"]
[12681.57921, "o", "\u001b[?2004h> "]
[12681.579267, "o", "        csr_destroy(A);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12681.579327, "o", "        return 1;\r\n\u001b[?2004l\r"]
[12681.579382, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[12681.579449, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[12681.579505, "o", "    int n = A->rows;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12681.579602, "o", "    double *v0 = vec_create(n);\r\n\u001b[?2004l\r"]
[12681.579657, "o", "\u001b[?2004h> "]
[12681.579717, "o", "    double *vp = vec_create(n);\r\n\u001b[?2004l\r"]
[12681.579793, "o", "\u001b[?2004h> "]
[12681.579899, "o", "    double *vi = vec_create(n);\r\n\u001b[?2004l\r"]
[12681.579933, "o", "\u001b[?2004h>     double *w = vec_create(n);\r\n\u001b[?2004l\r"]
[12681.580062, "o", "\u001b[?2004h>     double *Av = vec_create(n);\r\n\u001b[?2004l\r"]
[12681.580088, "o", "\u001b[?2004h> "]
[12681.5802, "o", "    if (!v0 || !vp || !vi || !w || !Av) {\r\n\u001b[?2004l\r"]
[12681.580231, "o", "\u001b[?2004h> "]
[12681.580381, "o", "        fprintf(stderr, \"Error: allocation failed\\n\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.580402, "o", "> "]
[12681.580555, "o", "        free(v0); free(vp); free(vi); free(w); free(Av);\r\n\u001b[?2004l\r"]
[12681.580576, "o", "\u001b[?2004h> "]
[12681.580652, "o", "        csr_destroy(A);\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.580673, "o", "> "]
[12681.580716, "o", "        return 1;\r\n\u001b[?2004l\r"]
[12681.580741, "o", "\u001b[?2004h> "]
[12681.580773, "o", "    }\r\n\u001b[?2004l\r"]
[12681.580794, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12681.580826, "o", "\u001b[?2004h> "]
[12681.580927, "o", "    init_random_vector(v0, n);\r\n\u001b[?2004l\r"]
[12681.580949, "o", "\u001b[?2004h> "]
[12681.581023, "o", "    vec_copy(v0, vp, n);\r\n\u001b[?2004l\r"]
[12681.581044, "o", "\u001b[?2004h> "]
[12681.581117, "o", "    vec_copy(v0, vi, n);\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.58114, "o", "> \r\n\u001b[?2004l\r"]
[12681.581161, "o", "\u001b[?2004h"]
[12681.58118, "o", "> "]
[12681.581294, "o", "    /* Power iteration for lambda_max */\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.581347, "o", "> "]
[12681.621049, "o", "    int power_converged = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     int power_iterations = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     double lambda_max = NAN;\r\n\u001b[?2004l\r\u001b[?2004h>     double prev_lambda_max = NAN;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for (int iter = 0; iter < maxiter; iter++) {\r\n\u001b[?2004l\r\u001b[?2004h>         csr_spmv(A, vp, w);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12681.621136, "o", "        lambda_max = vec_dot(vp, w, n);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12681.621358, "o", "        double nrm = vec_norm2(w, n);\r\n\u001b[?2004l\r"]
[12681.621417, "o", "\u001b[?2004h> "]
[12681.621577, "o", "        if (nrm < 1e-300) {\r\n\u001b[?2004l\r"]
[12681.621641, "o", "\u001b[?2004h> "]
[12681.621747, "o", "            break;\r\n\u001b[?2004l\r"]
[12681.621806, "o", "\u001b[?2004h> "]
[12681.621877, "o", "        }\r\n\u001b[?2004l\r"]
[12681.621935, "o", "\u001b[?2004h> "]
[12681.622249, "o", "        for (int i = 0; i < n; i++) vp[i] = w[i] / nrm;\r\n\u001b[?2004l\r"]
[12681.622313, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12681.62237, "o", "\u001b[?2004h> "]
[12681.622579, "o", "        power_iterations = iter + 1;\r\n\u001b[?2004l\r"]
[12681.622644, "o", "\u001b[?2004h> "]
[12681.623018, "o", "        if (!isnan(prev_lambda_max) && fabs(lambda_max) > 0.0) {\r\n\u001b[?2004l\r"]
[12681.623085, "o", "\u001b[?2004h"]
[12681.623141, "o", "> "]
[12681.623528, "o", "            if (fabs(lambda_max - prev_lambda_max) / fabs(lambda_max) < tol) {\r\n\u001b[?2004l\r"]
[12681.623593, "o", "\u001b[?2004h> "]
[12681.623798, "o", "                power_converged = 1;\r\n\u001b[?2004l\r"]
[12681.623863, "o", "\u001b[?2004h> "]
[12681.623998, "o", "                break;\r\n\u001b[?2004l\r"]
[12681.624047, "o", "\u001b[?2004h> "]
[12681.624139, "o", "            }\r\n\u001b[?2004l\r"]
[12681.624187, "o", "\u001b[?2004h> "]
[12681.624258, "o", "        }\r\n\u001b[?2004l\r"]
[12681.624325, "o", "\u001b[?2004h> "]
[12681.62453, "o", "        prev_lambda_max = lambda_max;\r\n\u001b[?2004l\r"]
[12681.624578, "o", "\u001b[?2004h> "]
[12681.624635, "o", "    }\r\n\u001b[?2004l\r"]
[12681.624691, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12681.624747, "o", "\u001b[?2004h> "]
[12681.624998, "o", "    /* Inverse iteration for lambda_min */\r\n\u001b[?2004l\r"]
[12681.62507, "o", "\u001b[?2004h> "]
[12681.625233, "o", "    int inverse_converged = 0;\r\n\u001b[?2004l\r"]
[12681.625281, "o", "\u001b[?2004h> "]
[12681.625475, "o", "    int inverse_iterations = 0;\r\n\u001b[?2004l\r"]
[12681.625522, "o", "\u001b[?2004h> "]
[12681.6257, "o", "    double lambda_min = NAN;\r\n\u001b[?2004l\r"]
[12681.625765, "o", "\u001b[?2004h> "]
[12681.625962, "o", "    double prev_lambda_min = NAN;\r\n\u001b[?2004l\r"]
[12681.62602, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12681.626067, "o", "\u001b[?2004h> "]
[12681.626354, "o", "    for (int iter = 0; iter < maxiter; iter++) {\r\n\u001b[?2004l\r"]
[12681.626401, "o", "\u001b[?2004h> "]
[12681.626539, "o", "        int fail = 0;\r\n\u001b[?2004l\r"]
[12681.626587, "o", "\u001b[?2004h> "]
[12681.627292, "o", "        SolveResult *res = solve_linear_system(A, vi, solver, precond, solver_tol, solver_maxiter, restart, omega, &fail);\r\n\u001b[?2004l\r"]
[12681.627356, "o", "\u001b[?2004h> "]
[12681.627617, "o", "        if (!res || !res->converged || fail) {\r\n\u001b[?2004l\r"]
[12681.627685, "o", "\u001b[?2004h> "]
[12681.627847, "o", "            lambda_min = NAN;\r\n\u001b[?2004l\r"]
[12681.627919, "o", "\u001b[?2004h> "]
[12681.628182, "o", "            if (res) solve_result_destroy(res);\r\n\u001b[?2004l\r"]
[12681.628228, "o", "\u001b[?2004h> "]
[12681.628352, "o", "            break;\r\n\u001b[?2004l\r"]
[12681.628399, "o", "\u001b[?2004h> "]
[12681.628471, "o", "        }\r\n\u001b[?2004l\r"]
[12681.628534, "o", "\u001b[?2004h> "]
[12681.628836, "o", "        double wnorm = vec_norm2(res->x, n);\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.628974, "o", "> "]
[12681.629055, "o", "        if (wnorm < 1e-300) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.629114, "o", "> "]
[12681.62925, "o", "            lambda_min = NAN;\r\n\u001b[?2004l\r"]
[12681.629316, "o", "\u001b[?2004h> "]
[12681.629528, "o", "            solve_result_destroy(res);\r\n\u001b[?2004l\r"]
[12681.629573, "o", "\u001b[?2004h> "]
[12681.629697, "o", "            break;\r\n\u001b[?2004l\r"]
[12681.629753, "o", "\u001b[?2004h> "]
[12681.629814, "o", "        }\r\n\u001b[?2004l\r"]
[12681.62988, "o", "\u001b[?2004h> "]
[12681.630094, "o", "        double rq = vec_dot(vi, res->x, n);\r\n\u001b[?2004l\r"]
[12681.630151, "o", "\u001b[?2004h> "]
[12681.630313, "o", "        if (fabs(rq) < 1e-300) {\r\n\u001b[?2004l\r"]
[12681.630371, "o", "\u001b[?2004h> "]
[12681.630517, "o", "            lambda_min = NAN;\r\n\u001b[?2004l\r"]
[12681.630573, "o", "\u001b[?2004h> "]
[12681.630767, "o", "            solve_result_destroy(res);\r\n\u001b[?2004l\r"]
[12681.630825, "o", "\u001b[?2004h> "]
[12681.630925, "o", "            break;\r\n\u001b[?2004l\r"]
[12681.630984, "o", "\u001b[?2004h> "]
[12681.631044, "o", "        }\r\n\u001b[?2004l\r"]
[12681.631101, "o", "\u001b[?2004h> "]
[12681.631238, "o", "        lambda_min = 1.0 / rq;\r\n\u001b[?2004l\r"]
[12681.631295, "o", "\u001b[?2004h> "]
[12681.631603, "o", "        for (int i = 0; i < n; i++) w[i] = res->x[i] / wnorm;\r\n\u001b[?2004l\r"]
[12681.63166, "o", "\u001b[?2004h> "]
[12681.631884, "o", "        memcpy(vi, w, n * sizeof(double));\r\n\u001b[?2004l\r"]
[12681.63195, "o", "\u001b[?2004h> "]
[12681.63211, "o", "        solve_result_destroy(res);\r\n\u001b[?2004l\r"]
[12681.632167, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12681.632223, "o", "\u001b[?2004h> "]
[12681.632411, "o", "        inverse_iterations = iter + 1;\r\n\u001b[?2004l\r"]
[12681.632467, "o", "\u001b[?2004h> "]
[12681.632789, "o", "        if (!isnan(prev_lambda_min) && fabs(lambda_min) > 0.0) {\r\n\u001b[?2004l\r"]
[12681.632845, "o", "\u001b[?2004h> "]
[12681.633241, "o", "            if (fabs(lambda_min - prev_lambda_min) / fabs(lambda_min) < tol) {\r\n\u001b[?2004l\r"]
[12681.633301, "o", "\u001b[?2004h> "]
[12681.633502, "o", "                inverse_converged = 1;\r\n\u001b[?2004l\r"]
[12681.63356, "o", "\u001b[?2004h> "]
[12681.633666, "o", "                break;\r\n\u001b[?2004l\r"]
[12681.633722, "o", "\u001b[?2004h> "]
[12681.633792, "o", "            }\r\n\u001b[?2004l\r"]
[12681.633847, "o", "\u001b[?2004h> "]
[12681.633915, "o", "        }\r\n\u001b[?2004l\r"]
[12681.633971, "o", "\u001b[?2004h> "]
[12681.634147, "o", "        prev_lambda_min = lambda_min;\r\n\u001b[?2004l\r"]
[12681.634202, "o", "\u001b[?2004h> "]
[12681.634263, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.634319, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.634374, "o", "> "]
[12681.634487, "o", "    double condition_number;\r\n\u001b[?2004l\r"]
[12681.634542, "o", "\u001b[?2004h> "]
[12681.634904, "o", "    if (isnan(lambda_max) || isnan(lambda_min) || lambda_min == 0.0) {\r\n\u001b[?2004l\r"]
[12681.634962, "o", "\u001b[?2004h> "]
[12681.635139, "o", "        condition_number = INFINITY;\r\n\u001b[?2004l\r"]
[12681.635194, "o", "\u001b[?2004h> "]
[12681.635261, "o", "    } else {\r\n\u001b[?2004l\r"]
[12681.635315, "o", "\u001b[?2004h> "]
[12681.635632, "o", "        condition_number = fabs(lambda_max) / fabs(lambda_min);\r\n\u001b[?2004l\r"]
[12681.635689, "o", "\u001b[?2004h> "]
[12681.635743, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.635799, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.635866, "o", "> "]
[12681.636067, "o", "    printf(\"lambda_max: %.15e\\n\", lambda_max);\r\n\u001b[?2004l\r"]
[12681.636123, "o", "\u001b[?2004h> "]
[12681.636355, "o", "    printf(\"lambda_min: %.15e\\n\", lambda_min);\r\n\u001b[?2004l\r"]
[12681.636413, "o", "\u001b[?2004h> "]
[12681.636705, "o", "    printf(\"condition_number: %.15e\\n\", condition_number);\r\n\u001b[?2004l\r"]
[12681.636762, "o", "\u001b[?2004h> "]
[12681.637045, "o", "    printf(\"power_iterations: %d\\n\", power_iterations);\r\n\u001b[?2004l\r"]
[12681.637103, "o", "\u001b[?2004h> "]
[12681.637394, "o", "    printf(\"inverse_iterations: %d\\n\", inverse_iterations);\r\n\u001b[?2004l\r"]
[12681.63745, "o", "\u001b[?2004h> "]
[12681.637793, "o", "    printf(\"power_converged: %s\\n\", power_converged ? \"yes\" : \"no\");\r\n\u001b[?2004l\r"]
[12681.63785, "o", "\u001b[?2004h> "]
[12681.638221, "o", "    printf(\"inverse_converged: %s\\n\", inverse_converged ? \"yes\" : \"no\");\r\n\u001b[?2004l\r"]
[12681.638279, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12681.638334, "o", "\u001b[?2004h> "]
[12681.638589, "o", "    free(v0); free(vp); free(vi); free(w); free(Av);\r\n\u001b[?2004l\r"]
[12681.638645, "o", "\u001b[?2004h> "]
[12681.638745, "o", "    csr_destroy(A);\r\n\u001b[?2004l\r"]
[12681.638801, "o", "\u001b[?2004h> "]
[12681.63888, "o", "    return 0;\r\n\u001b[?2004l\r"]
[12681.638938, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[12681.639002, "o", "\u001b[?2004h> "]
[12681.639058, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h"]
[12681.639124, "o", "> "]
[12681.639364, "o", "if 'int cmd_condition(int argc, char **argv)' not in s:\r\n\u001b[?2004l\r"]
[12681.63942, "o", "\u001b[?2004h> "]
[12681.639563, "o", "    s = s.rstrip() + insert\r\n\u001b[?2004l\r"]
[12681.639619, "o", "\u001b[?2004h> "]
