[9370.75733, "o", "   237\t\r\n   238\t            if (hnorm < 1e-14) break;\r\n   239\t\r\n   240\t            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\r\n   241\t        }\r\n   242\t        if (fail) break;\r\n"]
[9370.757387, "o", "   243\t        if (kdim == 0) break;\r\n   244\t\r\n   245\t        for (int i = 0; i < kdim; i++) y[i] = 0.0;\r\n   246\t        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\r\n   247\t\r\n   248\t        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\r\n"]
