[12520.858126, "o", "\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = (double *)malloc((maxiter + 1) * sizeof(double));\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K = (double *)malloc((maxiter + 1) * sizeof(double));\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!res->x || !res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K || !res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K) {\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        free(res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        free(res->precond_\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K_len = 0;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    res->\u001b[01;31m\u001b[Khistory\u001b[m\u001b[K[0] = res->relres;\r\n\u001b[35m\u001b[Ksrc/solvers.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b["]
