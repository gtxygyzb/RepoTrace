[4311.701166, "o", "\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int cap = is_symmetric ? 2 * nnz + 1 : nnz;\r\n\u001b[32m\u001b[K291\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (cap < 1) cap = 1;\r\n\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    COOMatrix *coo = coo_create(rows, cols, cap);\r\n\u001b[32m\u001b[K293\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!coo) { fclose(fp); return NULL; }\r\n\u001b[32m\u001b[K294\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K295\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int k = 0;\r\n\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    while (k < coo->nnz && \u001b[01;31m\u001b[Kread_non_comment_line\u001b[m\u001b[K(fp, line, sizeof(line)) == 0) {\r\n\u001b[32m\u001b[K297\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int r, c;\r\n\u001b[32m\u001b[K298\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        double v;\r\n\u001b[32m\u001b[K299\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (sscanf(line, \"%d %d %lf\", &r, &c, &v) != 3) continue;\r\n\u001b[32m\u001b[K300\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (r < 1 || r > rows || c < 1 || c > cols) continue;\r\n\u001b[32m\u001b[K301\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        r--; c--;\r\n\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K303\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        coo->row[k] = r;\r\n\u001b[32m\u001b[K304\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        coo->col[k] = c;\r\n\u001b[32m\u001b[K305\u001b[m\u001b"]
[4311.701231, "o", "[K\u001b[36m\u001b[K-\u001b[m\u001b[K        coo->values[k] = v;\r\n\u001b[32m\u001b[K306\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        k++;\r\n\u001b[32m\u001b[K307\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (is_symmetric && r != c) {\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            coo->row[k] = c;\r\n\u001b[32m\u001b[K310\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            coo->col[k] = r;\r\n\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            coo->values[k] = v;\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            k++;\r\n\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    coo->nnz = k;\r\n\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CSRMatrix *A = coo_to_csr(coo);\r\n"]
[4311.701292, "o", "\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    coo_destroy(coo);\r\n\u001b[32m\u001b[K319\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fclose(fp);\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return A;\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kint csr_write_mm(const CSRMatrix *A, const char *filename)\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    FILE *fp = fopen(filename, \"w\");\r\n\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!fp) return -1;\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n"]
[4311.701414, "o", "\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kread_non_comment_line\u001b[m\u001b[K(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }\r\n\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (sscanf(line, \"%d %d\", &rows, &cols) != 2 || rows <= 0 || cols != 1) {\r\n\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fclose(fp);\r\n\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        return NULL;\r\n\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    double *x = vec_create(rows);\r\n\u001b[32m\u001b[K360\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!x) { fclose(fp); return NULL; }\r\n\u001b[32m\u001b[K361\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int i = 0;\r\n\u001b[32m\u001b[K363\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    while (i < rows && \u001b[01;31m\u001b[Kread_non_comment_line\u001b[m\u001b[K(fp, line, sizeof(line)) == 0) {\r\n\u001b[32m\u001b[K364\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        double v;\r\n\u001b[32m\u001b[K365\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (sscanf(line, \"%lf\", &v) != 1) { free(x); fclose(fp); return NULL; }\r\n\u001b[32m\u001b[K366\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        x[i++] = v;\r\n\u001b[32m\u001b[K367\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b"]
[4311.70148, "o", "[m\u001b[K    }\r\n\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (i != rows) { free(x); fclose(fp); return NULL; }\r\n\u001b[32m\u001b[K369\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fclose(fp);\r\n\u001b[32m\u001b[K371\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    *n_out = rows;\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return x;\r\n\u001b[32m\u001b[K373\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K374\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kint vec_write_mm_array(const double *x, int n, const char *filename)\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    FILE *fp = fopen(filename, \"w\");\r\n\u001b[32m\u001b[K378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!fp) return -1;\r\n\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fprintf(fp, \"%%%%MatrixMarket matrix array real general\\n\");\r\n\u001b[32m\u001b[K380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fprintf(fp, \"%d 1\\n\", n);\r\n"]
[4311.701537, "o", "\u001b[32m\u001b[K381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (int i = 0; i < n; i++) {\r\n\u001b[32m\u001b[K382\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fprintf(fp, \"%.15g\\n\", x[i]);\r\n\u001b[32m\u001b[K383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fclose(fp);\r\n\u001b[32m\u001b[K385\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return 0;\r\n\u001b[32m\u001b[K386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
[4311.702022, "o", "\u001b[?2004h"]
[4311.702084, "o", "root@n30009:/app# "]
[4319.106985, "i", "grep -n 'static.*mm_parse_header\\|static.*read_non_comment_line' src/sparse.c\n"]
[4319.10754, "o", "grep -n 'static.*mm_parse_header\\|static.*read_non_comment_line' src/sparse.c\r\n\u001b[?2004l\r"]
[4319.110905, "o", "\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstatic int mm_parse_header\u001b[m\u001b[K(const char *line, int *is_array, int *is_symmetric)\r\n"]
[4319.111214, "o", "\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstatic int read_non_comment_line\u001b[m\u001b[K(FILE *fp, char *buf, int bufsize)\r\n"]
[4319.111697, "o", "\u001b[?2004h"]
