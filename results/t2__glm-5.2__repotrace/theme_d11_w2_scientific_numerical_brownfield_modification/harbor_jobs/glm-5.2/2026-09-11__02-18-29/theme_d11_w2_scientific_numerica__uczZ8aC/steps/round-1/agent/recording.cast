[8056.756177, "o", "        if (fabs(lambda) == 0.0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8056.756258, "o", "            resnorm = INFINITY;\r\n\u001b[?2004l\r\u001b[?2004h> "]
