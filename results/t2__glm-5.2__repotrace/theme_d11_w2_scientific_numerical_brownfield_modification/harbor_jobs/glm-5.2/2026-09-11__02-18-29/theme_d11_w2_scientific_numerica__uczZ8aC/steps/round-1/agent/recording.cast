[2255.917351, "o", "#ifndef SPARSE_H\r\n#define SPARSE_H\r\n\r\n#include <stdio.h>\r\n\r\ntypedef struct {\r\n    int    rows;\r\n    int    cols;\r\n    int    nnz;\r\n    double *values;\r\n    int    *col_indices;\r\n    int    *row_ptr;\r\n} CSRMatrix;\r\n\r\ntypedef struct {\r\n    int    rows;\r\n    int    cols;\r\n    int    nnz;\r\n    double *values;\r\n    int    *row;\r\n    int    *col;\r\n} COOMatrix;\r\n\r\n/* Lifecycle */\r\nCSRMatrix  *csr_create(int rows, int cols, int nnz);\r\nvoid        csr_destroy(CSRMatrix *A);\r\nCOOMatrix  *coo_create(int rows, int cols, int nnz);\r\n"]
[2255.917478, "o", "void        coo_destroy(COOMatrix *A);\r\n\r\n/* Conversions */\r\nCOOMatrix  *csr_to_coo(const CSRMatrix *A);\r\nCSRMatrix  *coo_to_csr(const COOMatrix *A);\r\n\r\n/* Operations */\r\nvoid        csr_spmv(const CSRMatrix *A, const double *x, double *y);\r\nCSRMatrix  *csr_transpose(const CSRMatrix *A);\r\nint         csr_is_symmetric(const CSRMatrix *A, double tol);\r\ndouble     *csr_diagonal(const CSRMatrix *A);\r\n\r\n/* Matrix Market I/O */\r\nCSRMatrix  *csr_read_mm(const char *filename);\r\nint         csr_write_mm(const CSRMatrix *A, const char *filename);\r\ndouble     *vec_read_mm_array(const char *filename, int *n_out);\r\nint         vec_write_mm_array(const double *x, int n, const char *filename);\r\n\r\n#endif /* SPARSE_H */\r\n"]
