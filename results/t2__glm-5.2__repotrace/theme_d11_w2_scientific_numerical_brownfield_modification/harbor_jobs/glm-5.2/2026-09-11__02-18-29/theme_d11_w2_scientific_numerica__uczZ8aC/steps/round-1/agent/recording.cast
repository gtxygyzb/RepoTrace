[11195.162459, "o", "   120\t    }\r\n   121\t\r\n   122\t    double *r = vec_create(n);\r\n   123\t    dm_matvec(A, x, r);\r\n   124\t    vec_axpy(-1.0, b, r, n);\r\n   125\t    printf(\"Residual norm: %.6e\\n\", vec_norm2(r, n));\r\n   126\t\r\n   127\t    free(r);\r\n   128\t"]
[11195.162563, "o", "    free(x);\r\n   129\t    free(b);\r\n   130\t    dm_destroy(A);\r\n   131\t    return 0;\r\n   132\t}\r\n   133\t\r\n   134\tstatic int parse_bc(const char *s, PoissonBC *bc)\r\n   135\t{\r\n   136\t    const char *colon = strchr(s, ':');\r\n   137\t    if (!colon || colon == s) return -1;\r\n   138\t\r\n   139\t    size_t len = colon - s;\r\n   140\t    char type[32];\r\n   141\t    if (len >= sizeof(type)) return -1;\r\n   142\t    memcpy(type, s, len);\r\n   143\t    type[len] = '\\0';\r\n"]
[11195.162636, "o", "   144\t\r\n   145\t    if (strcmp(type, \"dirichlet\") == 0) bc->type = POISSON_DIRICHLET;\r\n   146\t    else if (strcmp(type, \"neumann\") == 0) bc->type = POISSON_NEUMANN;\r\n   147\t    else return -1;\r\n   148\t\r\n   149\t    bc->file = colon + 1;\r\n   150\t    return 0;\r\n   151\t}\r\n   152\t\r\n   153\t"]
