[2149.369332, "o", "     1\t#ifndef SOLVERS_H\r\n     2\t#define SOLVERS_H\r\n     3\t\r\n     4\t#include \"sparse.h\"\r\n     5\t#include \"precond.h\"\r\n     6\t\r\n     7\ttypedef struct {\r\n     8\t    double *x;\r\n     9\t"]
[2149.369431, "o", "    double relres;\r\n    10\t    int iterations;\r\n    11\t    int converged;\r\n    12\t    double *history;\r\n    13\t    int history_len;\r\n    14\t} SolveResult;\r\n    15\t\r\n    16\tSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n    17\t                      double tol, int maxiter, Precond *P);\r\n    18\t\r\n    19\tSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\r\n    20\t                         double tol, int maxiter, int m, Precond *P);\r\n    21\t\r\n    22\tvoid solve_result_destroy(SolveResult *res);\r\n    23\t\r\n"]
[2149.369526, "o", "    24\t#endif /* SOLVERS_H */\r\n"]
