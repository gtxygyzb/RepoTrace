[7897.148168, "o", "        fprintf(stderr, \"Error: unknown solver '%s'\\n\", solver);\r\n        precond_destroy(P);\r\n        return 1;\r\n    }\r\n\r\n    if (!res) {\r\n        fprintf(stderr, \"Error: solver allocation failed\\n\");\r\n        precond_destroy(P);\r\n        return 1;\r\n    }\r\n\r\n    print_solve_summary(res);\r\n\r\n"]
