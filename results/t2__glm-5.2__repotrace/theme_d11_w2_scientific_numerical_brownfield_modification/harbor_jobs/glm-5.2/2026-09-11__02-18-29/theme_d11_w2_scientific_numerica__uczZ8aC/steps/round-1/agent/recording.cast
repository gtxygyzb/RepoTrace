[7268.378614, "o", "\t        double a = H[i*m+i];\r\n   129\t        double b = H[(i+1)*m+i];\r\n   130\t        if (b == 0.0) {\r\n   131\t            c[i] = 1.0;\r\n   132\t            s[i] = 0.0;\r\n   133\t        } else {\r\n   134\t            double r = hypot(a, b);\r\n   135\t            c[i] = a / r;\r\n   136\t            s[i] = b / r;\r\n   137\t        }\r\n   138\t        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\r\n"]
