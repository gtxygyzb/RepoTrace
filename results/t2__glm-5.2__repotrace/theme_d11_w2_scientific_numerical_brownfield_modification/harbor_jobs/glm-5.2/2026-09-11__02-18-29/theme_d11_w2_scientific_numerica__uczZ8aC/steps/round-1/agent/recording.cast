[7316.458612, "o", "\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        P->\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K = \u001b[01;31m\u001b[Kcsr_diagonal\u001b[m\u001b[K(A);\r\n\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!P->\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K) { precond_destroy(P); return NULL; }\r\n"]
[7316.458697, "o", "\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        P->\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K = \u001b[01;31m\u001b[Kcsr_diagonal\u001b[m\u001b[K(A);\r\n\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!P->\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K) { precond_destroy(P); return NULL; }\r\n\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    free(P->\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (fabs(P->\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K[i]) < 1e-15) return -1;\r\n"]
[7316.458766, "o", "\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K139\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            z[i] = r[i] / P->\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K[i];\r\n\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            double \u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K = P->\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K[i];\r\n\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (fabs(\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K) < 1e-15) return -1;\r\n\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            z[i] = (1.0 - P->omega) * z[i] + (P->omega / \u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K) * (r[i] - sum);\r\n\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            double \u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K = P->\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K[i];\r\n\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (fabs(\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K) < 1e-15) return -1;\r\n\u001b[35m\u001b[Ksrc/precond.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K175\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            z[i] = (1.0 - P->omega) * z[i] + (P->omega / \u001b[01;31m\u001b[Kdiag\u001b[m\u001b["]
[7316.458836, "o", "K) * (r[i] - sum);\r\n"]
[7316.458929, "o", "\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdouble *\u001b[01;31m\u001b[Kcsr_diagonal\u001b[m\u001b[K(const CSRMatrix *A)\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    double *\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K = vec_create(n);\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!\u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K) return NULL;\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K[i] = (idx >= 0) ? A->values[idx] : 0.0;\r\n\u001b[35m\u001b[Ksrc/sparse.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    return \u001b[01;31m\u001b[Kdiag\u001b[m\u001b[K;\r\n"]
