[2180.709546, "o", "     7\t    PRECOND_NONE,\r\n     8\t    PRECOND_JACOBI,\r\n     9\t    PRECOND_ILU0,\r\n    10\t    PRECOND_SSOR\r\n    11\t} PrecondType;\r\n"]
