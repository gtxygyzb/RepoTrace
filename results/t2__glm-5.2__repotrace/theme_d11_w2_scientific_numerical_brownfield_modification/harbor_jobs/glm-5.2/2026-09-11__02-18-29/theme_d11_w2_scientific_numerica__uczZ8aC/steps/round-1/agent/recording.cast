[4284.494761, "o", "\u001b[32m\u001b[K339\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdouble *\u001b[01;31m\u001b[Kvec_read_mm_array\u001b[m\u001b[K(const char *filename, int *n_out)\r\n\u001b[32m\u001b[K340\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K341\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    FILE *fp = fopen(filename, \"r\");\r\n\u001b[32m\u001b[K342\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!fp) return NULL;\r\n\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K344\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    char line[1024];\r\n"]
[4284.4949, "o", "\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!fgets(line, sizeof(line), fp)) { fclose(fp); return NULL; }\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int is_array = 0, is_symmetric = 0;\r\n\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (mm_parse_header(line, &is_array, &is_symmetric) != 0 || !is_array) {\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fclose(fp);\r\n\u001b[32m\u001b[K349\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        return NULL;\r\n\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K352\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int rows, cols;\r\n\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (read_non_comment_line(fp, line, sizeof(line)) != 0) { fclose(fp); return NULL; }\r\n\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (sscanf(line, \"%d %d\", &rows, &cols) != 2 || rows <= 0 || cols != 1) {\r\n\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fclose(fp);\r\n\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        return NULL;\r\n\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    double *x = vec_create(rows);\r\n\u001b[32m\u001b[K360\u001b[m\u001b[K\u001b[36m\u001b[K-"]
[4284.494996, "o", "\u001b[m\u001b[K    if (!x) { fclose(fp); return NULL; }\r\n\u001b[32m\u001b[K361\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int i = 0;\r\n\u001b[32m\u001b[K363\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (i < rows && read_non_comment_line(fp, line, sizeof(line)) == 0) {\r\n\u001b[32m\u001b[K364\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        double v;\r\n\u001b[32m\u001b[K365\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (sscanf(line, \"%lf\", &v) != 1) { free(x); fclose(fp); return NULL; }\r\n\u001b[32m\u001b[K366\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        x[i++] = v;\r\n\u001b[32m\u001b[K367\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (i != rows) { free(x); fclose(fp); return NULL; }\r\n\u001b[32m\u001b[K369\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fclose(fp);\r\n\u001b[32m\u001b[K371\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    *n_out = rows;\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return x;\r\n\u001b[32m\u001b[K373\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K374\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[4284.495063, "o", "\u001b[32m\u001b[K375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kint vec_write_mm_array(const double *x, int n, const char *filename)\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    FILE *fp = fopen(filename, \"w\");\r\n\u001b[32m\u001b[K378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!fp) return -1;\r\n\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fprintf(fp, \"%%%%MatrixMarket matrix array real general\\n\");\r\n\u001b[32m\u001b[K380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fprintf(fp, \"%d 1\\n\", n);\r\n\u001b[32m\u001b[K381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (int i = 0; i < n; i++) {\r\n\u001b[32m\u001b[K382\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        fprintf(fp, \"%.15g\\n\", x[i]);\r\n\u001b[32m\u001b[K383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    fclose(fp);\r\n\u001b[32m\u001b[K385\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return 0;\r\n\u001b[32m\u001b[K386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
[4284.495578, "o", "\u001b[?2004h"]
[4284.495638, "o", "root@n30009:/app# "]
