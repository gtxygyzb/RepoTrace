[3840.585238, "o", "\u001b[?2004h> "]
[3840.585695, "o", "static void add_coo(COOMatrix *coo, int *k, int r, int c, double v)\r\n\u001b[?2004l\r"]
[3840.585746, "o", "\u001b[?2004h> "]
[3840.585802, "o", "{\r\n\u001b[?2004l\r\u001b[?2004h"]
[3840.585859, "o", "> "]
[3840.586, "o", "    coo->row[*k] = r;\r\n\u001b[?2004l\r"]
[3840.586058, "o", "\u001b[?2004h> "]
[3840.586248, "o", "    coo->col[*k] = c;\r\n\u001b[?2004l\r"]
[3840.586314, "o", "\u001b[?2004h> "]
[3840.586508, "o", "    coo->values[*k] = v;\r\n\u001b[?2004l\r"]
[3840.586571, "o", "\u001b[?2004h> "]
[3840.586653, "o", "    (*k)++;\r\n\u001b[?2004l\r"]
[3840.586717, "o", "\u001b[?2004h> }\r\n"]
[3840.58678, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[3840.586836, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3840.587311, "o", "static int is_dirichlet_node(int i, int j, int nx, int ny,\r\n\u001b[?2004l\r"]
[3840.587364, "o", "\u001b[?2004h> "]
[3840.587781, "o", "                            PoissonBC left, PoissonBC right,\r\n\u001b[?2004l\r"]
[3840.587847, "o", "\u001b[?2004h> "]
[3840.588264, "o", "                            PoissonBC bottom, PoissonBC top)\r\n\u001b[?2004l\r"]
[3840.588322, "o", "\u001b[?2004h> {"]
[3840.588377, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[3840.588433, "o", "> "]
[3840.58881, "o", "    if (i == 0 && left.type == POISSON_DIRICHLET) return 1;\r\n\u001b[?2004l\r"]
[3840.588891, "o", "\u001b[?2004h> "]
[3840.589327, "o", "    if (i == nx - 1 && right.type == POISSON_DIRICHLET) return 1;\r\n\u001b[?2004l\r"]
[3840.589375, "o", "\u001b[?2004h> "]
[3840.589806, "o", "    if (j == 0 && bottom.type == POISSON_DIRICHLET) return 1;\r\n\u001b[?2004l\r"]
[3840.589882, "o", "\u001b[?2004h> "]
[3840.590327, "o", "    if (j == ny - 1 && top.type == POISSON_DIRICHLET) return 1;\r\n\u001b[?2004l\r"]
[3840.590397, "o", "\u001b[?2004h> "]
[3840.590495, "o", "    return 0;\r\n\u001b[?2004l\r"]
[3840.590558, "o", "\u001b[?2004h> }"]
[3840.590618, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
