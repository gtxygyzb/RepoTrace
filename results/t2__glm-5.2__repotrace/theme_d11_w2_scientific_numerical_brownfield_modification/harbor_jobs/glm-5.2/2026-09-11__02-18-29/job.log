b, r, n);\n    printf("Residual norm: %.6e\\n", vec_norm2(r, n));\n\n    free(r);\n    free(x);\n    free(b);\n    dm_destroy(A);\n    return 0;\n}\n\nstatic int parse_bc(const char *s, PoissonBC *bc)\n{\n    const char *colon = strchr(s, \':\');\n    if (!colon || colon == s) return -1;\n\n    size_t len = colon - s;\n    char type[32];\n    if (len >= sizeof(type)) return -1;\n    memcpy(type, s, len);\n    type[len] = \'\\0\';\n\n    if (strcmp(type, "dirichlet") == 0) bc->type = POISSON_DIRICHLET;\n    else if (strcmp(type, "neumann") == 0) bc->type = POISSON_NEUMANN;\n    else return -1;\n\n    bc->file = colon + 1;\n    return 0;\n}\n\nstatic int run_solver_and_print(const CSRMatrix *A, const double *b,\n                                const char *solver, const char *precond,\n                                double tol, int maxiter, int restart,\n                                double omega, const char *output,\n                                const char *history)\n{\n    Precond *P = precond_create(A, precond, omega);\n    if (!P) {\n        fprintf(stderr, "Error: cannot create preconditioner \'%s\'\\n", precond);\n        return 1;\n    }\n\n    SolveResult *res = NULL;\n    if (strcmp(solver, "cg") == 0) {\n        res = cg_solve(A, b, NULL, tol, maxiter, P);\n    } else if (strcmp(solver, "gmres") == 0) {\n        res = gmres_solve(A, b, NULL, tol, maxiter, restart, P);\n    } else {\n        fprintf(stderr, "Error: unknown solver \'%s\'\\n", solver);\n        precond_destroy(P);\n        return 1;\n    }\n\n    if (!res) {\n        fprintf(stderr, "Error: solver allocation failed\\n");\n        precond_destroy(P);\n        return 1;\n    }\n\n    print_solve_summary(res);\n\n    if (output && vec_write_mm_array(res->x, A->rows, output) != 0) {\n        fprintf(stderr, "Error: cannot write output to \'%s\'\\n", output);\n    }\n    if (history && write_history_file(res, history) != 0) {\n        fprintf(stderr, "Error: cannot write history to \'%s\'\\n", history);\n    }\n\n    solve_result_destroy(res);\n    precond_destroy(P);\n    return 0;\n}\n\nstatic int cmd_sparse_solve(int argc, char **argv)\n{\n    const char *input = get_opt(argc, argv, "--input");\n    const char *rhs_file = get_opt(argc, argv, "--rhs");\n    const char *solver = get_opt(argc, argv, "--solver");\n    const char *precond = get_opt(argc, argv, "--precond");\n    const char *tol_s = get_opt(argc, argv, "--tol");\n    const char *maxiter_s = get_opt(argc, argv, "--maxiter");\n    const char *restart_s = get_opt(argc, argv, "--restart");\n    const char *omega_s = get_opt(argc, argv, "--ssor-omega");\n    const char *output = get_opt(argc, argv, "--output");\n    const char *history = get_opt(argc, argv, "--history");\n\n    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {\n        fprintf(stderr, "Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\\n");\n        usage("numsim");\n        return 1;\n    }\n\n    double tol = atof(tol_s);\n    int maxiter = atoi(maxiter_s);\n    int restart = restart_s ? atoi(restart_s) : 30;\n    double omega = omega_s ? atof(omega_s) : 1.0;\n\n    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {\n        fprintf(stderr, "Error: invalid solver parameters\\n");\n        return 1;\n    }\n\n    CSRMatrix *A = csr_read_mm(input);\n    if (!A) {\n        fprintf(stderr, "Error: cannot read sparse matrix from \'%s\'\\n", input);\n        return 1;\n    }\n\n    int n;\n    double *b = vec_read_mm_array(rhs_file, &n);\n    if (!b) {\n        fprintf(stderr, "Error: cannot read RHS from \'%s\'\\n", rhs_file);\n        csr_destroy(A);\n        return 1;\n    }\n\n    if (A->rows != n || A->cols != n) {\n        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\\n",\n                A->rows, A->cols, n);\n        free(b);\n        csr_destroy(A);\n        return 1;\n    }\n\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\n\n    free(b);\n    csr_destroy(A);\n    return rc;\n}\n\nstatic int cmd_poisson(int argc, char **argv)\n{\n    const char *nx_s = get_opt(argc, argv, "--nx");\n    const char *ny_s = get_opt(argc, argv, "--ny");\n    const char *x0_s = get_opt(argc, argv, "--x0");\n    const char *x1_s = get_opt(argc, argv, "--x1");\n    const char *y0_s = get_opt(argc, argv, "--y0");\n    const char *y1_s = get_opt(argc, argv, "--y1");\n    const char *source = get_opt(argc, argv, "--source");\n    const char *bc_left_s = get_opt(argc, argv, "--bc-left");\n    const char *bc_right_s = get_opt(argc, argv, "--bc-right");\n    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");\n    const char *bc_top_s = get_opt(argc, argv, "--bc-top");\n    const char *solver = get_opt(argc, argv, "--solver");\n    const char *precond = get_opt(argc, argv, "--precond");\n    const char *tol_s = get_opt(argc, argv, "--tol");\n    const char *maxiter_s = get_opt(argc, argv, "--maxiter");\n    const char *restart_s = get_opt(argc, argv, "--restart");\n    const char *omega_s = get_opt(argc, argv, "--ssor-omega");\n    const char *output = get_opt(argc, argv, "--output");\n    const char *history = get_opt(argc, argv, "--history");\n\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\n        !solver || !precond || !tol_s || !maxiter_s) {\n        fprintf(stderr, "Error: poisson is missing required arguments\\n");\n        usage("numsim");\n        return 1;\n    }\n\n    int nx = atoi(nx_s);\n    int ny = atoi(ny_s);\n    double x0 = atof(x0_s);\n    double x1 = atof(x1_s);\n    double y0 = atof(y0_s);\n    double y1 = atof(y1_s);\n    double tol = atof(tol_s);\n    int maxiter = atoi(maxiter_s);\n    int restart = restart_s ? atoi(restart_s) : 30;\n    double omega = omega_s ? atof(omega_s) : 1.0;\n\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter <