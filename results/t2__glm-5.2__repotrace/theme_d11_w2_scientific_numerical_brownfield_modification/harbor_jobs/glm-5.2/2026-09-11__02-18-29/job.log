Sending keys: ['cat > src/solvers.c <<\'EOF\'\n#include "solvers.h"\n#include "vector.h"\n#include <stdlib.h>\n#include <math.h>\n#include <string.h>\n\nstatic SolveResult *result_create(int n, int maxiter)\n{\n    if (maxiter < 0) maxiter = 0;\n    SolveResult *res = (SolveResult *)calloc(1, sizeof(SolveResult));\n    if (!res) return NULL;\n\n    res->x = vec_create(n);\n    res->history = (double *)malloc((maxiter + 1) * sizeof(double));\n    if (!res->x || !res->history) {\n        free(res->x);\n        free(res->history);\n        free(res);\n        return NULL;\n    }\n    res->history_len = 0;\n    return res;\n}\n\nSolveResult *cg_solve(const CSRMatrix *A, const double *b, const double *x0,\n                      double tol, int maxiter, Precond *P)\n{\n    if (!A || !b || A->rows != A->cols) return NULL;\n    int n = A->rows;\n    if (maxiter < 0) maxiter = 0;\n\n    SolveResult *res = result_create(n, maxiter);\n    if (!res) return NULL;\n\n    double *r = vec_create(n);\n    double *z = vec_create(n);\n    double *p = vec_create(n);\n    double *Ap = vec_create(n);\n    if (!r || !z || !p || !Ap) {\n        free(r); free(z); free(p); free(Ap);\n        solve_result_destroy(res);\n        return NULL;\n    }\n\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\n\n    csr_spmv(A, res->x, Ap);\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\n\n    double bnorm = vec_norm2(b, n);\n    if (bnorm == 0.0) bnorm = 1.0;\n\n    res->true_residual = vec_norm2(r, n);\n    res->relres = res->true_residual / bnorm;\n    res->history[0] = res->relres;\n    res->history_len = 1;\n    res->converged = (res->relres < tol) ? 1 : 0;\n    res->iterations = 0;\n    if (res->converged || maxiter == 0) {\n        free(r); free(z); free(p); free(Ap);\n        return res;\n    }\n\n    if (precond_apply(P, A, r, z) != 0) {\n        free(r); free(z); free(p); free(Ap);\n        return res;\n    }\n    vec_copy(z, p, n);\n    double rz_old = vec_dot(r, z, n);\n\n    for (int iter = 1; iter <= maxiter; iter++) {\n        csr_spmv(A, p, Ap);\n        double pAp = vec_dot(p, Ap, n);\n        if (fabs(pAp) < 1e-30) break;\n\n        double alpha = rz_old / pAp;\n        vec_axpy(alpha, p, res->x, n);\n        vec_axpy(-alpha, Ap, r, n);\n\n        /* Recompute the true residual rather than relying on the recurrence. */\n        csr_spmv(A, res->x, Ap);\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\n\n        res->true_residual = vec_norm2(r, n);\n        res->relres = res->true_residual / bnorm;\n        res->history[iter] = res->relres;\n        res->history_len = iter + 1;\n        res->iterations = iter;\n\n        if (res->relres < tol) {\n            res->converged = 1;\n            break;\n        }\n\n        if (precond_apply(P, A, r, z) != 0) break;\n        double rz_new = vec_dot(r, z, n);\n        if (fabs(rz_old) < 1e-30) break;\n        double beta = rz_new / rz_old;\n        vec_scale(beta, p, n);\n        vec_axpy(1.0, z, p, n);\n        rz_old = rz_new;\n    }\n\n    free(r); free(z); free(p); free(Ap);\n    return res;\n}\n\nstatic void apply_givens(double *a, double *b, double c, double s)\n{\n    double t = c * (*a) + s * (*b);\n    *b = -s * (*a) + c * (*b);\n    *a = t;\n}\n\nstatic int solve_hessenberg_ls(double *H, double *g, int m, int kdim, double *y)\n{\n    if (kdim <= 0) return -1;\n\n    double *c = (double *)malloc(m * sizeof(double));\n    double *s = (double *)malloc(m * sizeof(double));\n    if (!c || !s) { free(c); free(s); return -1; }\n\n    for (int i = 0; i < kdim; i++) {\n        for (int k = 0; k < i; k++) {\n            apply_givens(&H[k*m+i], &H[(k+1)*m+i], c[k], s[k]);\n        }\n\n        double a = H[i*m+i];\n        double b = H[(i+1)*m+i];\n        if (b == 0.0) {\n            c[i] = 1.0;\n            s[i] = 0.0;\n        } else {\n            double r = hypot(a, b);\n            c[i] = a / r;\n            s[i] = b / r;\n        }\n        apply_givens(&H[i*m+i], &H[(i+1)*m+i], c[i], s[i]);\n        apply_givens(&g[i], &g[i+1], c[i], s[i]);\n\n    }\n\n    for (int i = kdim - 1; i >= 0; i--) {\n        double sum = g[i];\n        for (int j = i + 1; j < kdim; j++) sum -= H[i*m+j] * y[j];\n        if (fabs(H[i*m+i]) < 1e-15) { free(c); free(s); return -1; }\n        y[i] = sum / H[i*m+i];\n    }\n\n    free(c);\n    free(s);\n    return 0;\n}\n\nSolveResult *gmres_solve(const CSRMatrix *A, const double *b, const double *x0,\n                           double tol, int maxiter, int m, Precond *P)\n{\n    if (!A || !b || A->rows != A->cols) return NULL;\n    int n = A->rows;\n    if (m <= 0) m = 30;\n    if (maxiter < 0) maxiter = 0;\n\n    SolveResult *res = result_create(n, maxiter);\n    if (!res) return NULL;\n\n    double *r = vec_create(n);\n    double *z = vec_create(n);\n    double *Ap = vec_create(n);\n    double *Av = vec_create(n);\n    double *w = vec_create(n);\n    double *g = (double *)malloc((m + 1) * sizeof(double));\n    double *y = (double *)malloc(m * sizeof(double));\n    double *H = (double *)calloc((m + 1) * m, sizeof(double));\n    double *V = (double *)malloc(n * (m + 1) * sizeof(double));\n\n    if (!r || !z || !Ap || !Av || !w || !g || !y || !H || !V) {\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\n        solve_result_destroy(res);\n        return NULL;\n    }\n\n    if (x0) vec_copy(x0, res->x, n); else vec_zero(res->x, n);\n\n    csr_spmv(A, res->x, Ap);\n    for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\n\n    double bnorm = vec_norm2(b, n);\n    if (bnorm == 0.0) bnorm = 1.0;\n\n    res->true_residual = vec_norm2(r, n);\n    res->relres = res->true_residual / bnorm;\n    res->history[0] = res->relres;\n    res->history_len = 1;\n    res->converged = (res->relres < tol) ? 1 : 0;\n    res->iterations = 0;\n    if (res->converged || maxiter == 0) {\n        free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\n        return res;\n    }\n\n    for (int cycle = 1; cycle <= maxiter; cycle++) {\n        if (precond_apply(P, A, r, z) != 0) break;\n        double beta = vec_norm2(z, n);\n        if (beta == 0.0) break;\n\n        for (int i = 0; i < n; i++) V[i] = z[i] / beta;\n        for (int i = 0; i <= m; i++) g[i] = 0.0;\n        g[0] = beta;\n        memset(H, 0, (m + 1) * m * sizeof(double));\n\n        int kdim = 0;\n        int fail = 0;\n        for (int j = 0; j < m; j++) {\n            csr_spmv(A, V + j * n, Av);\n            if (precond_apply(P, A, Av, w) != 0) { fail = 1; break; }\n\n            for (int i = 0; i <= j; i++) {\n                double h = vec_dot(w, V + i * n, n);\n                H[i*m+j] = h;\n                vec_axpy(-h, V + i * n, w, n);\n            }\n\n            double hnorm = vec_norm2(w, n);\n            H[(j+1)*m+j] = hnorm;\n            kdim = j + 1;\n\n            if (hnorm < 1e-14) break;\n\n            for (int i = 0; i < n; i++) V[(j+1)*n+i] = w[i] / hnorm;\n        }\n        if (fail) break;\n        if (kdim == 0) break;\n\n        for (int i = 0; i < kdim; i++) y[i] = 0.0;\n        if (solve_hessenberg_ls(H, g, m, kdim, y) != 0) break;\n\n        for (int i = 0; i < kdim; i++) vec_axpy(y[i], V + i * n, res->x, n);\n\n        csr_spmv(A, res->x, Ap);\n        for (int i = 0; i < n; i++) r[i] = b[i] - Ap[i];\n\n        res->true_residual = vec_norm2(r, n);\n        res->relres = res->true_residual / bnorm;\n        res->history[cycle] = res->relres;\n        res->history_len = cycle + 1;\n        res->iterations = cycle;\n\n        if (res->relres < tol) {\n            res->converged = 1;\n            break;\n        }\n    }\n\n    free(r); free(z); free(Ap); free(Av); free(w); free(g); free(y); free(H); free(V);\n    return res;\n}\n\nvoid solve_result_destroy(SolveResult *res)\n{\n    if (!res) return;\n    free(res->x);\n    free(res->history);\n    free(res);\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
