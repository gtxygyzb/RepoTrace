ls, A->nnz);\n    if (!S) return NULL;\n    for (int i = 0; i <= A->rows; i++) S->row_ptr[i] = A->row_ptr[i];\n    for (int k = 0; k < A->nnz; k++) S->col_indices[k] = A->col_indices[k];\n    for (int i = 0; i < A->rows; i++) {\n        for (int k = A->row_ptr[i]; k < A->row_ptr[i+1]; k++) {\n            S->values[k] = A->values[k];\n            if (A->col_indices[k] == i) S->values[k] -= sigma;\n        }\n    }\n    return S;\n}\n\nint cmd_eigenvalue(int argc, char **argv)\n{\n    const char *input = get_opt(argc, argv, "--input");\n    const char *method_s = get_opt(argc, argv, "--method");\n    const char *shift_s = get_opt(argc, argv, "--shift");\n    const char *tol_s = get_opt(argc, argv, "--tol");\n    const char *maxiter_s = get_opt(argc, argv, "--maxiter");\n    const char *solver = get_opt(argc, argv, "--solver");\n    const char *precond = get_opt(argc, argv, "--precond");\n    const char *restart_s = get_opt(argc, argv, "--restart");\n    const char *omega_s = get_opt(argc, argv, "--ssor-omega");\n    const char *solver_tol_s = get_opt(argc, argv, "--solver-tol");\n    const char *solver_maxiter_s = get_opt(argc, argv, "--solver-maxiter");\n    const char *eigvec_output = get_opt(argc, argv, "--eigvec-output");\n\n    if (!input || !method_s || !tol_s || !maxiter_s || !solver || !precond) {\n        fprintf(stderr, "Error: missing required arguments for eigenvalue\\n");\n        return 1;\n    }\n\n    int method;\n    if (strcmp(method_s, "power") == 0) method = 0;\n    else if (strcmp(method_s, "inverse") == 0) method = 1;\n    else if (strcmp(method_s, "shifted-inverse") == 0) method = 2;\n    else {\n        fprintf(stderr, "Error: unknown method \'%s\'\\n", method_s);\n        return 1;\n    }\n\n    double sigma = 0.0;\n    if (method == 2) {\n        if (!shift_s) {\n            fprintf(stderr, "Error: --shift is required for shifted-inverse\\n");\n            return 1;\n        }\n        if (parse_double(shift_s, &sigma) != 0) {\n            fp