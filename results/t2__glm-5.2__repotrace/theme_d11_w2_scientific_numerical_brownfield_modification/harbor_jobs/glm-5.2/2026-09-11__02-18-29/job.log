ec_write_mm_array(res->x, A->rows, output) != 0) {\n        fprintf(stderr, "Error: cannot write output to \'%s\'\\n", output);\n    }\n    if (history && write_history_file(res, history) != 0) {\n        fprintf(stderr, "Error: cannot write history to \'%s\'\\n", history);\n    }\n\n    solve_result_destroy(res);\n    precond_destroy(P);\n    return 0;\n}\n\nstatic int cmd_sparse_solve(int argc, char **argv)\n{\n    const char *input = get_opt(argc, argv, "--input");\n    const char *rhs_file = get_opt(argc, argv, "--rhs");\n    const char *solver = get_opt(argc, argv, "--solver");\n    const char *precond = get_opt(argc, argv, "--precond");\n    const char *tol_s = get_opt(argc, argv, "--tol");\n    const char *maxiter_s = get_opt(argc, argv, "--maxiter");\n    const char *restart_s = get_opt(argc, argv, "--restart");\n    const char *omega_s = get_opt(argc, argv, "--ssor-omega");\n    const char *output = get_opt(argc, argv, "--output");\n    const char *history = get_opt(argc, argv, "--history");\n\n    if (!input || !rhs_file || !solver || !precond || !tol_s || !maxiter_s) {\n        fprintf(stderr, "Error: sparse-solve requires --input, --rhs, --solver, --precond, --tol, --maxiter\\n");\n        usage("numsim");\n        return 1;\n    }\n\n    double tol = atof(tol_s);\n    int maxiter = atoi(maxiter_s);\n    int restart = restart_s ? atoi(restart_s) : 30;\n    double omega = omega_s ? atof(omega_s) : 1.0;\n\n    if (tol <= 0.0 || maxiter < 0 || restart <= 0) {\n        fprintf(stderr, "Error: invalid solver parameters\\n");\n        return 1;\n    }\n    if (validate_ssor_omega(omega) != 0) {\n        return 1;\n    }\n\n    CSRMatrix *A = csr_read_mm(input);\n    if (!A) {\n        fprintf(stderr, "Error: cannot read sparse matrix from \'%s\'\\n", input);\n        return 1;\n    }\n\n    int n;\n    double *b = vec_read_mm_array(rhs_file, &n);\n    if (!b) {\n        fprintf(stderr, "Error: cannot read RHS from \'%s\'\\n", rhs_file);\n        csr_destroy(A);\n        return 1;\n    }\n\n    if (A->rows != n || A->cols != n) {\n        fprintf(stderr, "Error: dimension mismatch A(%d,%d) vs b(%d)\\n",\n                A->rows, A->cols, n);\n        free(b);\n        csr_destroy(A);\n        return 1;\n    }\n\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\n\n    free(b);\n    csr_destroy(A);\n    return rc;\n}\n\nstatic int cmd_poisson(int argc, char **argv)\n{\n    const char *nx_s = get_opt(argc, argv, "--nx");\n    const char *ny_s = get_opt(argc, argv, "--ny");\n    const char *x0_s = get_opt(argc, argv, "--x0");\n    const char *x1_s = get_opt(argc, argv, "--x1");\n    const char *y0_s = get_opt(argc, argv, "--y0");\n    const char *y1_s = get_opt(argc, argv, "--y1");\n    const char *source = get_opt(argc, argv, "--source");\n    const char *bc_left_s = get_opt(argc, argv, "--bc-left");\n    const char *bc_right_s = get_opt(argc, argv, "--bc-right");\n    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");\n    const char *bc_top_s = get_opt(argc, argv, "--bc-top");\n    const char *solver = get_opt(argc, argv, "--solver");\n    const char *precond = get_opt(argc, argv, "--precond");\n    const char *tol_s = get_opt(argc, argv, "--tol");\n    const char *maxiter_s = get_opt(argc, argv, "--maxiter");\n    const char *restart_s = get_opt(argc, argv, "--restart");\n    const char *omega_s = get_opt(argc, argv, "--ssor-omega");\n    const char *output = get_opt(argc, argv, "--output");\n    const char *history = get_opt(argc, argv, "--history");\n\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !source ||\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\n        !solver || !precond || !tol_s || !maxiter_s) {\n        fprintf(stderr, "Error: poisson requires grid, source, boundary condition, solver, precond, tol, maxiter\\n");\n        usage("numsim");\n        return 1;\n    }\n\n    int nx = atoi(nx_s);\n    int ny = atoi(ny_s);\n    double x0 = atof(x0_s);\n    double x1 = atof(x1_s);\n    double y0 = atof(y0_s);\n    double y1 = atof(y1_s);\n    double tol = atof(tol_s);\n    int maxiter = atoi(maxiter_s);\n    int restart = restart_s ? atoi(restart_s) : 30;\n    double omega = omega_s ? atof(omega_s) : 1.0;\n\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\n        fprintf(stderr, "Error: invalid poisson parameters\\n");\n        return 1;\n    }\n    if (validate_ssor_omega(omega) != 0) {\n        return 1;\n    }\n\n    PoissonBC left, right, bottom, top;\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\n        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\\n");\n        return 1;\n    }\n\n    CSRMatrix *A = NULL;\n    double *b = NULL;\n    if (poisson_assemble(nx, ny, x0, x1, y0, y1, source, left, right, bottom, top, &A, &b) != 0) {\n        fprintf(stderr, "Error: cannot assemble Poisson system\\n");\n        return 1;\n    }\n\n    int rc = run_solver_and_print(A, b, solver, precond, tol, maxiter, restart, omega, output, history);\n\n    free(b);\n    csr_destroy(A);\n    return rc;\n}\n\nstatic int cmd_heat(int argc, char **argv)\n{\n    const char *nx_s = get_opt(argc, argv, "--nx");\n    const char *ny_s = get_opt(argc, argv, "--ny");\n    const char *x0_s = get_opt(argc, argv, "--x0");\n    const char *x1_s = get_opt(argc, argv, "--x1");\n    const char *y0_s = get_opt(argc, argv, "--y0");\n    const char *y1_s = get_opt(argc, argv, "--y1");\n    const char *alpha_s = get_opt(argc, argv, "--alpha");\n    const char *dt_s = get_opt(argc, argv, "--dt");\n    const char *nsteps_s = get_opt(argc, argv, "--nsteps");\n    const char *scheme = get_opt(argc, argv, "--scheme");\n    const char *ic_file = get_opt(argc, argv, "--ic");\n    const char *source_arg = get_opt(argc, argv, "--source");\n    const char *bc_left_s = get_opt(argc, argv, "--bc-left");\n    const char *bc_right_s = get_opt(argc, argv, "--bc-right");\n    const char *bc_bottom_s = get_opt(argc, argv, "--bc-bottom");\n    const char *bc_top_s = get_opt(argc, argv, "--bc-top");\n    const char *solver = get_opt(argc, argv, "--solver");\n    const char *precond = get_opt(argc, argv, "--precond");\n    const char *tol_s = get_opt(argc, argv, "--tol");\n    const char *maxiter_s = get_opt(argc, argv, "--maxiter");\n    const char *restart_s = get_opt(argc, argv, "--restart");\n    const char *omega_s = get_opt(argc, argv, "--ssor-omega");\n    const char *output = get_opt(argc, argv, "--output");\n\n    if (!nx_s || !ny_s || !x0_s || !x1_s || !y0_s || !y1_s || !alpha_s ||\n        !dt_s || !nsteps_s || !scheme || !ic_file || !source_arg ||\n        !bc_left_s || !bc_right_s || !bc_bottom_s || !bc_top_s ||\n        !solver || !precond || !tol_s || !maxiter_s || !output) {\n        fprintf(stderr, "Error: heat requires grid, domain, alpha, dt, nsteps, scheme, ic, source, boundary conditions, solver, precond, tol, maxiter, output\\n");\n        usage("numsim");\n        return 1;\n    }\n\n    int nx = atoi(nx_s);\n    int ny = atoi(ny_s);\n    double x0 = atof(x0_s);\n    double x1 = atof(x1_s);\n    double y0 = atof(y0_s);\n    double y1 = atof(y1_s);\n    double alpha = atof(alpha_s);\n    double dt = atof(dt_s);\n    int nsteps = atoi(nsteps_s);\n    double tol = atof(tol_s);\n    int maxiter = atoi(maxiter_s);\n    int restart = restart_s ? atoi(restart_s) : 30;\n    double omega = omega_s ? atof(omega_s) : 1.0;\n\n    if (nx < 2 || ny < 2 || x1 <= x0 || y1 <= y0 || alpha <= 0.0 ||\n        dt <= 0.0 || nsteps < 0 || tol <= 0.0 || maxiter < 0 || restart <= 0) {\n        fprintf(stderr, "Error: invalid heat parameters\\n");\n        return 1;\n    }\n    if (validate_ssor_omega(omega) != 0) {\n        return 1;\n    }\n\n    PoissonBC left, right, bottom, top;\n    if (parse_bc(bc_left_s, &left) != 0 || parse_bc(bc_right_s, &right) != 0 ||\n        parse_bc(bc_bottom_s, &bottom) != 0 || parse_bc(bc_top_s, &top) != 0) {\n        fprintf(stderr, "Error: boundary condition must be <dirichlet|neumann>:<file>\\n");\n        return 1;\n    }\n\n    int rc = heat_solve(nx, ny, x0, x1, y0, y1, alpha, dt, nsteps, scheme,\n                       ic_file, source_arg, left, right, bottom, top,\n                       solver, precond, tol, maxiter, restart, omega, output);\n    if (rc != 0) {\n        fprintf(stderr, "Error: heat solve failed\\n");\n        return 1;\n    }\n    return 0;\n}\n\nint main(int argc, char **argv)\n{\n    if (argc < 2) {\n        usage(argv[0]);\n        return 1;\n    }\n\n    const char *cmd = argv[1];\n\n    if (strcmp(cmd, "dense-solve") == 0) {\n        return cmd_dense_solve(argc - 2, argv + 2);\n    } else if (strcmp(cmd, "sparse-solve") == 0) {\n        return cmd_sparse_solve(argc - 2, argv + 2);\n    } else if (strcmp(cmd, "poisson") == 0) {\n        return cmd_poisson(argc - 2, argv + 2);\n    } else if (strcmp(cmd, "heat") == 0) {\n        return cmd_heat(argc - 2, argv + 2);\n    } else if (strcmp(cmd, "--help") == 0 || strcmp(cmd, "-h") == 0) {\n        usage(argv[0]);\n        return 0;\n    } else {\n        fprintf(stderr, "Error: unknown command \'%s\'\\n", cmd);\n        usage(argv[0]);\n        return 1;\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
