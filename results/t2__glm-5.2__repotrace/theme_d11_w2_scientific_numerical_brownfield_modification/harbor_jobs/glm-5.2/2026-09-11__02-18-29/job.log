eturn 1;\n    }\n\n    int n = A->rows;\n    double *v = vec_create(n);\n    double *w = vec_create(n);\n    double *Av = vec_create(n);\n    if (!v || !w || !Av) {\n        fprintf(stderr, "Error: allocation failed\\n");\n        free(v); free(w); free(Av);\n        csr_destroy(A);\n        return 1;\n    }\n\n    init_random_vector(v, n);\n\n    int converged = 0;\n    int iterations = 0;\n    double eigenvalue = NAN;\n    double prev_lambda = NAN;\n    CSRMatrix *S = NULL;\n    const CSRMatrix *OpA = A;\n\n    if (method == 2) {\n        S = make_shifted_matrix(A, sigma);\n        if (!S) {\n            fprintf(stderr, "Error: allocation failed\\n");\n            free(v); free(w); free(Av);\n            csr_destroy(A);\n            return 1;\n        }\n        OpA = S;\n    }\n\n    for (int iter = 0; iter < maxiter; iter++) {\n        if (method == 0) {\n            csr_spmv(A, v, w);\n            double nrm = vec_norm2(w, n);\n            if (nrm < 1e-300) {\n                eigenvalue = 0.0;\n                break;\n            }\n            for (int i = 0; i < n; i++) w[i] /= nrm;\n            csr_spmv(A, w, Av);\n            eigenvalue = vec_dot(w, Av, n);\n            memcpy(v, w, n * sizeof(double));\n        } else {\n            int fail = 0;\n            SolveResult *res = solve_linear_system(OpA, v, solver, precond, solver_tol, solver_maxiter, restart, omega, &fail);\n            if (!res || !res->converged || fail) {\n                eigenvalue = NAN;\n                if (res) solve_result_destroy(res);\n                break;\n            }\n            double nrm = vec_norm2(res->x, n);\n            if (nrm < 1e-300) {\n                eigenvalue = NAN;\n                solve_result_destroy(res);\n                break;\n            }\n            for (int i = 0; i < n; i++) w[i] = res->x[i] / nrm;\n            csr_spmv(OpA, w, Av);\n            double rq = vec_dot(w, Av, n);\n            if (fabs(rq) < 1e-300) {\n                eigenvalue = NAN;