Sending keys: ['cat > prioritize.go <<\'EOF\'\npackage main\n\nimport (\n\t"bufio"\n\t"encoding/json"\n\t"fmt"\n\t"math"\n\t"os"\n\t"sort"\n\t"time"\n)\n\nconst (\n\twSeverity   = 0.30\n\twRecency    = 0.25\n\twRisk       = 0.25\n\twConfidence = 0.15\n\twActor      = 0.05\n)\n\nvar prioritySeverityRanks = map[string]int{\n\t"none":     0,\n\t"low":      1,\n\t"medium":   2,\n\t"high":     3,\n\t"critical": 4,\n}\n\ntype prioritizeOutput struct {\n\tSourceIP          string                 `json:"source_ip"`\n\tThreatType        string                 `json:"threat_type"`\n\tPriorityScore     float64                `json:"priority_score"`\n\tPriorityLabel     string                 `json:"priority_label"`\n\tComponents        map[string]float64     `json:"components"`\n\tEnrichedRiskScore float64                `json:"enriched_risk_score"`\n\tIOCSeverity       string                 `json:"ioc_severity"`\n\tThreatActors      []string               `json:"threat_actors"`\n\tReferenceTime     string                 `json:"reference_time"`\n}\n\nfunc runPrioritize(args []string) int {\n\tfs := newFlagSet("prioritize")\n\trefStr := fs.String("reference-time", "", "reference timestamp for recency scoring (RFC3339)")\n\tif !parseFlags(fs, args) {\n\t\treturn 1\n\t}\n\tif !isFlagSet(fs, "reference-time") || *refStr == "" {\n\t\tfmt.Fprintln(os.Stderr, "missing --reference-time flag")\n\t\treturn 1\n\t}\n\trefTime, err := parseTime(*refStr)\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\n\tscanner := bufio.NewScanner(os.Stdin)\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\n\n\tvar results []prioritizeOutput\n\tlineNo := 0\n\tfor scanner.Scan() {\n\t\tlineNo++\n\t\tline := scanner.Text()\n\t\tif line == "" {\n\t\t\tcontinue\n\t\t}\n\t\tvar threat map[string]interface{}\n\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "line %d: %v\\n", lineNo, err)\n\t\t\treturn 2\n\t\t}\n\n\t\tout, ok := prioritizeThreat(threat, refTime)\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tresults = append(results, out)\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\n\tsort.SliceStable(results, func(i, j int) bool {\n\t\tif results[i].PriorityScore != results[j].PriorityScore {\n\t\t\treturn results[i].PriorityScore > results[j].PriorityScore\n\t\t}\n\t\treturn results[i].SourceIP < results[j].SourceIP\n\t})\n\n\twriter := bufio.NewWriter(os.Stdout)\n\tdefer writer.Flush()\n\tfor _, r := range results {\n\t\tb, err := json.Marshal(r)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "failed to encode output: %v\\n", err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintln(writer, string(b))\n\t}\n\treturn 0\n}\n\nfunc prioritizeThreat(threat map[string]interface{}, refTime time.Time) (prioritizeOutput, bool) {\n\tsourceIP := getStringDefault(threat, "source_ip")\n\tthreatType := getStringDefault(threat, "threat_type")\n\n\trefStr := ""\n\tif t := threatReferenceTime(threat); !t.IsZero() {\n\t\trefStr = t.UTC().Format(time.RFC3339)\n\t}\n\n\teventTime := threatReferenceTime(threat)\n\tageMinutes := 0.0\n\tif !eventTime.IsZero() {\n\t\tageMinutes = refTime.Sub(eventTime).Minutes()\n\t}\n\tif ageMinutes < 0 {\n\t\tageMinutes = 0\n\t}\n\trecency := math.Pow(2, -ageMinutes/60.0)\n\n\triskScore, _ := getFloat(threat, "enriched_risk_score")\n\trisk := riskScore / 500.0\n\tif risk > 1.0 {\n\t\trisk = 1.0\n\t}\n\tif risk < 0 {\n\t\trisk = 0\n\t}\n\n\tconfidence := 0.0\n\tif c, ok := getFloat(threat, "max_ioc_confidence"); ok {\n\t\tconfidence = c\n\t}\n\tif confidence < 0 {\n\t\tconfidence = 0\n\t}\n\tif confidence > 1 {\n\t\tconfidence = 1\n\t}\n\n\tactors := []string{}\n\tif a, ok := getStringSlice(threat, "threat_actors"); ok {\n\t\tactors = a\n\t}\n\tactor := float64(len(actors)) / 3.0\n\tif actor > 1.0 {\n\t\tactor = 1.0\n\t}\n\tif actor < 0 {\n\t\tactor = 0\n\t}\n\n\tseverity := getStringDefault(threat, "ioc_severity")\n\tseverityRank := prioritySeverityRanks[severity]\n\tseverityComponent := float64(severityRank) / 4.0\n\n\tscore := wSeverity*severityComponent +\n\t\twRecency*recency +\n\t\twRisk*risk +\n\t\twConfidence*confidence +\n\t\twActor*actor\n\n\tlabel := priorityLabel(score)\n\n\treturn prioritizeOutput{\n\t\tSourceIP:          sourceIP,\n\t\tThreatType:        threatType,\n\t\tPriorityScore:     round3(score),\n\t\tPriorityLabel:     label,\n\t\tComponents: map[string]float64{\n\t\t\t"severity":   round3(severityComponent),\n\t\t\t"recency":    round3(recency),\n\t\t\t"risk":       round3(risk),\n\t\t\t"confidence": round3(confidence),\n\t\t\t"actor":      round3(actor),\n\t\t},\n\t\tEnrichedRiskScore: riskScore,\n\t\tIOCSeverity:       severity,\n\t\tThreatActors:      actors,\n\t\tReferenceTime:     refStr,\n\t}, true\n}\n\nfunc priorityLabel(score float64) string {\n\tswitch {\n\tcase score >= 0.75:\n\t\treturn "critical"\n\tcase score >= 0.50:\n\t\treturn "high"\n\tcase score >= 0.25:\n\t\treturn "medium"\n\tdefault:\n\t\treturn "low"\n\t}\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
