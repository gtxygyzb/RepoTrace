Sending keys: ['cat > timeline.go <<\'EOF\'\npackage main\n\nimport (\n\t"bufio"\n\t"encoding/json"\n\t"fmt"\n\t"math"\n\t"os"\n\t"sort"\n\t"time"\n)\n\ntype timelineBucket struct {\n\tBucketStart       string                   `json:"bucket_start"`\n\tBucketEnd         string                   `json:"bucket_end"`\n\tThreatCount       int                      `json:"threat_count"`\n\tAvgRisk           float64                  `json:"avg_risk"`\n\tMaxRisk           float64                  `json:"max_risk"`\n\tMinRisk           float64                  `json:"min_risk"`\n\tRiskStdDev        float64                  `json:"risk_std_dev"`\n\tDominantType      string                   `json:"dominant_type"`\n\tTypeDistribution  map[string]int           `json:"type_distribution"`\n\tUniqueActors     []string                 `json:"unique_actors"`\n\tSeverityHistogram map[string]int           `json:"severity_histogram"`\n\tEscalationIndex   float64                  `json:"escalation_index"`\n\tRiskTrend         float64                  `json:"risk_trend"`\n\tBurstScore        float64                  `json:"burst_score"`\n\tTopThreats        []map[string]interface{} `json:"top_threats"`\n}\n\nfunc runTimeline(args []string) int {\n\tfs := newFlagSet("timeline")\n\tbucketMinutes := fs.Int("bucket-minutes", 0, "width of each time bucket in minutes")\n\ttopN := fs.Int("top-n", 3, "maximum number of top threats to include per bucket")\n\tif !parseFlags(fs, args) {\n\t\treturn 1\n\t}\n\tif !isFlagSet(fs, "bucket-minutes") {\n\t\tfmt.Fprintln(os.Stderr, "missing required flag: --bucket-minutes")\n\t\treturn 1\n\t}\n\tif *bucketMinutes <= 0 {\n\t\tfmt.Fprintf(os.Stderr, "invalid --bucket-minutes: must be a positive integer\\n")\n\t\treturn 1\n\t}\n\tif *topN < 0 {\n\t\tfmt.Fprintf(os.Stderr, "invalid --top-n: must be non-negative\\n")\n\t\treturn 1\n\t}\n\n\tscanner := bufio.NewScanner(os.Stdin)\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\n\tlineNo := 0\n\tvar threats []map[string]interface{}\n\tfor scanner.Scan() {\n\t\tlineNo++\n\t\tline := scanner.Text()\n\t\tif line == "" {\n\t\t\tcontinue\n\t\t}\n\t\tvar threat map[string]interface{}\n\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "line %d: %v\\n", lineNo, err)\n\t\t\treturn 2\n\t\t}\n\t\tthreats = append(threats, threat)\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error reading input: %v\\n", err)\n\t\treturn 2\n\t}\n\n\tbucketSeconds := int64(*bucketMinutes) * 60\n\tbuckets := make(map[int64][]map[string]interface{})\n\tvar bucketStarts []int64\n\tfor _, threat := range threats {\n\t\trefTime := threatSortTime(threat)\n\t\tvar refUnix int64\n\t\tif !refTime.IsZero() {\n\t\t\trefUnix = refTime.Unix()\n\t\t}\n\t\tstart := (refUnix / bucketSeconds) * bucketSeconds\n\t\tif _, ok := buckets[start]; !ok {\n\t\t\tbucketStarts = append(bucketStarts, start)\n\t\t}\n\t\tbuckets[start] = append(buckets[start], threat)\n\t}\n\n\tsort.Slice(bucketStarts, func(i, j int) bool { return bucketStarts[i] < bucketStarts[j] })\n\n\twriter := bufio.NewWriter(os.Stdout)\n\tdefer writer.Flush()\n\n\tfor _, start := range bucketStarts {\n\t\tbucketThreats := buckets[start]\n\t\tstartTime := time.Unix(start, 0).UTC()\n\t\tendTime := startTime.Add(time.Duration(*bucketMinutes) * time.Minute)\n\t\tb := buildTimelineBucket(bucketThreats, startTime, endTime, *bucketMinutes, *topN)\n\t\tdata, err := json.Marshal(b)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error marshalling bucket: %v\\n", err)\n\t\t\treturn 2\n\t\t}\n\t\twriter.Write(data)\n\t\twriter.WriteByte(\'\\n\')\n\t}\n\n\treturn 0\n}\n\nfunc buildTimelineBucket(threats []map[string]interface{}, startTime time.Time, endTime time.Time, bucketMinutes int, topN int) timelineBucket {\n\tn := len(threats)\n\tb := timelineBucket{\n\t\tBucketStart:       startTime.Format(time.RFC3339),\n\t\tBucketEnd:         endTime.Format(time.RFC3339),\n\t\tThreatCount:       n,\n\t\tTypeDistribution:  map[string]int{},\n\t\tSeverityHistogram: map[string]int{"none": 0, "low": 0, "medium": 0, "high": 0, "critical": 0},\n\t\tUniqueActors:     []string{},\n\t\tTopThreats:        []map[string]interface{}{},\n\t}\n\n\tif n == 0 {\n\t\treturn b\n\t}\n\n\tvar sumRisk, maxRisk, minRisk float64\n\ttypeCounts := map[string]int{}\n\tactorSet := map[string]bool{}\n\trisks := make([]float64, 0, n)\n\tfor _, threat := range threats {\n\t\trisk, _ := getFloat(threat, "enriched_risk_score")\n\t\trisks = append(risks, risk)\n\t\tsumRisk += risk\n\t\tif risk > maxRisk {\n\t\t\tmaxRisk = risk\n\t\t}\n\t\tif risk < minRisk {\n\t\t\tminRisk = risk\n\t\t}\n\t\tif tt, ok := getString(threat, "threat_type"); ok {\n\t\t\ttypeCounts[tt]++\n\t\t}\n\t\tif sev, ok := getString(threat, "ioc_severity"); ok {\n\t\t\tif _, exists := b.SeverityHistogram[sev]; exists {\n\t\t\t\tb.SeverityHistogram[sev]++\n\t\t\t}\n\t\t}\n\t\tif actors, ok := getStringSlice(threat, "threat_actors"); ok {\n\t\t\tfor _, actor := range actors {\n\t\t\t\tif actor != "" {\n\t\t\t\t\tactorSet[actor] = true\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tb.AvgRisk = round2(sumRisk / float64(n))\n\tb.MaxRisk = round2(maxRisk)\n\tb.MinRisk = round2(minRisk)\n\n\tmean := sumRisk / float64(n)\n\tvar variance float64\n\tfor _, risk := range risks {\n\t\tdiff := risk - mean\n\t\tvariance += diff * diff\n\t}\n\tif n == 1 {\n\t\tvariance = 0.0\n\t} else {\n\t\tvariance /= float64(n)\n\t}\n\tb.RiskStdDev = round2(math.Sqrt(variance))\n\n\tb.DominantType = dominantThreatType(typeCounts)\n\tb.TypeDistribution = typeCounts\n\n\tb.UniqueActors = nonNilStrings(sortedUniqueStringsFromSet(actorSet))\n\n\tb.EscalationIndex = round2(timelineEscalationIndex(threats))\n\tb.RiskTrend = round2(timelineRiskTrend(threats, startTime))\n\tb.BurstScore = round2(timelineBurstScore(threats))\n\n\tsortedTop := make([]map[string]interface{}, len(threats))\n\tcopy(sortedTop, threats)\n\tsort.SliceStable(sortedTop, func(i, j int) bool {\n\t\tri, _ := getFloat(sortedTop[i], "enriched_risk_score")\n\t\trj, _ := getFloat(sortedTop[j], "enriched_risk_score")\n\t\tif ri != rj {\n\t\t\treturn ri > rj\n\t\t}\n\t\tti, tj := threatSortTime(sortedTop[i]), threatSortTime(sortedTop[j])\n\t\tif !ti.Equal(tj) {\n\t\t\treturn ti.Before(tj)\n\t\t}\n\t\ttta, _ := getString(sortedTop[i], "threat_type")\n\t\tttb, _ := getString(sortedTop[j], "threat_type")\n\t\treturn tta < ttb\n\t})\n\tif topN < len(sortedTop) {\n\t\tsortedTop = sortedTop[:topN]\n\t}\n\tb.TopThreats = sortedTop\n\n\treturn b\n}\n\nfunc dominantThreatType(counts map[string]int) string {\n\tvar keys []string\n\tfor k := range counts {\n\t\tkeys = append(keys, k)\n\t}\n\tsort.Strings(keys)\n\tdominant := ""\n\tmaxCount := -1\n\tfor _, k := range keys {\n\t\tif counts[k] > maxCount {\n\t\t\tmaxCount = counts[k]\n\t\t\tdominant = k\n\t\t}\n\t}\n\treturn dominant\n}\n\nfunc timelineSeverityRank(sev string) int {\n\tswitch sev {\n\tcase "none":\n\t\treturn 0\n\tcase "low":\n\t\treturn 1\n\tcase "medium":\n\t\treturn 2\n\tcase "high":\n\t\treturn 3\n\tcase "critical":\n\t\treturn 4\n\tdefault:\n\t\treturn -1\n\t}\n}\n\nfunc timelineEscalationIndex(threats []map[string]interface{}) float64 {\n\tn := len(threats)\n\tif n < 2 {\n\t\treturn 0.0\n\t}\n\tordered := make([]map[string]interface{}, len(threats))\n\tcopy(ordered, threats)\n\tsort.SliceStable(ordered, func(i, j int) bool {\n\t\tti, tj := threatSortTime(ordered[i]), threatSortTime(ordered[j])\n\t\tif !ti.Equal(tj) {\n\t\t\treturn ti.Before(tj)\n\t\t}\n\t\ttta, _ := getString(ordered[i], "threat_type")\n\t\tttb, _ := getString(ordered[j], "threat_type")\n\t\treturn tta < ttb\n\t})\n\n\tpositiveSum := 0.0\n\tfor i := 0; i < len(ordered)-1; i++ {\n\t\trankI := timelineSeverityRank(getStringDefault(ordered[i], "ioc_severity"))\n\t\trankJ := timelineSeverityRank(getStringDefault(ordered[i+1], "ioc_severity"))\n\t\tif rankI < 0 {\n\t\t\trankI = 0\n\t\t}\n\t\tif rankJ < 0 {\n\t\t\trankJ = 0\n\t\t}\n\t\tdelta := rankJ - rankI\n\t\tif delta > 0 {\n\t\t\tpositiveSum += float64(delta)\n\t\t}\n\t}\n\treturn positiveSum / (4.0 * float64(n-1))\n}\n\nfunc timelineRiskTrend(threats []map[string]interface{}, startTime time.Time) float64 {\n\tn := len(threats)\n\tif n < 2 {\n\t\treturn 0.0\n\t}\n\txs := make([]float64, n)\n\tys := make([]float64, n)\n\tfor i, threat := range threats {\n\t\trefTime := threatSortTime(threat)\n\t\txs[i] = refTime.Sub(startTime).Minutes()\n\t\tys[i], _ = getFloat(threat, "enriched_risk_score")\n\t}\n\tsameX := true\n\tfor i := 1; i < n; i++ {\n\t\tif xs[i] != xs[0] {\n\t\t\tsameX = false\n\t\t\tbreak\n\t\t}\n\t}\n\tif sameX {\n\t\treturn 0.0\n\t}\n\tvar sumX, sumY, sumXY, sumXX2 float64\n\tfor i := 0; i < n; i++ {\n\t\tsumX += xs[i]\n\t\tsumY += ys[i]\n\t\tsumXY += xs[i] * ys[i]\n\t\tsumXX2 += xs[i] * xs[i]\n\t}\n\tdenom := float64(n)*sumXX2 - sumX*sumX\n\tif denom == 0 {\n\t\treturn 0.0\n\t}\n\treturn (float64(n)*sumXY - sumX*sumY) / denom\n}\n\nfunc timelineBurstScore(threats []map[string]interface{}) float64 {\n\tn := len(threats)\n\tif n < 2 {\n\t\treturn 0.0\n\t}\n\ttimes := make([]float64, n)\n\tfor i, threat := range threats {\n\t\trefTime := threatSortTime(threat)\n\t\ttimes[i] = float64(refTime.Unix()) / 60.0\n\t}\n\tsum := 0.0\n\tpairs := 0\n\tfor i := 0; i < n; i++ {\n\t\tfor j := i + 1; j < n; j++ {\n\t\t\tsum += 1.0 / (1.0 + math.Abs(times[i]-times[j]))\n\t\t\tpairs++\n\t\t}\n\t}\n\treturn sum / float64(pairs)\n}\n\nfunc getStringDefault(m map[string]interface{}, key string) string {\n\tif v, ok := getString(m, key); ok {\n\t\treturn v\n\t}\n\treturn ""\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
