t\t}\n\t}\n\n\tif len(snapshots) < 3 {\n\t\tfmt.Fprintln(os.Stderr, "error: requires at least 3 valid JSON lines on stdin")\n\t\treturn 1\n\t}\n\n\trisks := make([]float64, len(snapshots))\n\tthreats := make([]float64, len(snapshots))\n\tfor i, snap := range snapshots {\n\t\trisks[i] = snap.GlobalMeanRisk\n\t\tthreats[i] = float64(snap.TotalThreats)\n\t}\n\n\tvar anomalies []anomalyRecord\n\tfor i := 0; i < len(snapshots); i++ {\n\t\tstart := i - *window\n\t\tif start < 0 {\n\t\t\tstart = 0\n\t\t}\n\t\tbaselineCount := i - start\n\t\tif baselineCount < 2 {\n\t\t\tcontinue\n\t\t}\n\n\t\triskMean, riskStd := baselineStats(risks[start:i])\n\t\tthreatMean, threatStd := baselineStats(threats[start:i])\n\n\t\triskZ := zScore(risks[i], riskMean, riskStd)\n\t\tthreatZ := zScore(threats[i], threatMean, threatStd)\n\t\tcombinedZ := math.Sqrt(riskZ*riskZ + threatZ*threatZ)\n\t\troundedCombinedZ := roundHalfUp4(combinedZ)\n\n\t\tif roundedCombinedZ < *threshold {\n\t\t\tcontinue\n\t\t}\n\n\t\tdirection := "mixed"\n\t\tif riskZ >= 0 && threatZ >= 0 {\n\t\t\tdirection = "above"\n\t\t} else if riskZ <= 0 && threatZ <= 0 {\n\t\t\tdirection = "below"\n\t\t}\n\n\t\tseverity := "low"\n\t\tif roundedCombinedZ >= 4.0 {\n\t\t\tseverity = "extreme"\n\t\t} else if roundedCombinedZ >= 3.0 {\n\t\t\tseverity = "high"\n\t\t} else if roundedCombinedZ >= 2.0 {\n\t\t\tseverity = "moderate"\n\t\t}\n\n\t\tanomalies = append(anomalies, anomalyRecord{\n\t\t\tIndex: i,\n\t\t\tMetrics: anomalyMetrics{\n\t\t\t\tGlobalMeanRisk: anomalyMetricResult{\n\t\t\t\t\tValue:          json.Number(formatRiskValue(risks[i])),\n\t\t\t\t\tBaselineMean:   json.Number(format4(riskMean)),\n\t\t\t\t\tBaselineStddev: json.Number(format4(riskStd)),\n\t\t\t\t\tZScore:         json.Number(format4(riskZ)),\n\t\t\t\t},\n\t\t\t\tTotalThreats: anomalyMetricResult{\n\t\t\t\t\tValue:          json.Number(strconv.FormatInt(int64(threats[i]), 10)),\n\t\t\t\t\tBaselineMean:   json.Number(format4(threatMean)),\n\t\t\t\t\tBaselineStddev: json.Number(format4(threatStd)),\n\t\t\t\t\tZScore:         json.Number(format4(threatZ)),\n\t\t\t\t},\n\t\t\t},\n\t\t\tCombinedZ:         json.Number(format4(combinedZ)),\n\t\t\tBaselineCount:    baselineCount,\n\t\t\tDirection:        direction,\n\t\t\tSeverity:         severity,\n\t\t\troundedCombinedZ: roundedCombinedZ,\n\t\t})\n\t}\n\n\tsort.SliceStable(anomalies, func(a, b int) bool {\n\t\tif anomalies[a].roundedCombinedZ != anomalies[b].roundedCombinedZ {\n\t\t\treturn anomalies[a].roundedCombinedZ > anomalies[b].roundedCombinedZ\n\t\t}\n\t\treturn anomalies[a].Index < anomalies[b].Index\n\t})\n\n\tencoder := json.NewEncoder(os.Stdout)\n\tencoder.SetEscapeHTML(false)\n\tfor _, rec := range anomalies {\n\t\tif err := encoder.Encode(rec); err != nil {\n\t\t\tfmt.Fprintln(os.Stderr, "error: failed to write anomaly record:", err)\n\t\t\treturn 1\n\t\t}\n\t}\n\n\treturn 0\n}\n\nfunc baselineStats(values []float64) (float64, float64) {\n\tn := len(values)\n\tif n == 0 {\n\t\treturn 0, 0\n\t}\n\n\tsum := 0.0\n\tfor _, v := range values {\n\t\tsum += v\n\t}\n\tmean := sum / float64(n)\n\n\tsquaredSum := 0.0\n\tfor _, v := range values {\n\t\tdiff := v - mean\n\t\tsquaredSum += diff * diff\n\t}\n\tstddev := math.Sqrt(squaredSum / float64(n))\n\n\treturn mean, stddev\n}\n\nfunc zScore(current, mean, stddev float64) float64 {\n\tif stddev == 0 {\n\t\tif current == mean {\n\t\t\treturn 0.0\n\t\t}\n\t\tif current > mean {\n\t\t\treturn 999.0\n\t\t}\n\t\treturn -999.0\n\t}\n\treturn (current - mean) / stddev\n}\n\nfunc roundHalfUp4(f float64) float64 {\n\tpow := 10000.0\n\treturn math.Floor(f*pow+0.5) / pow\n}\n\nfunc format4(f float64) string {\n\trounded := roundHalfUp4(f)\n\tif rounded == 0 {\n\t\treturn "0.0000"\n\t}\n\treturn fmt.Sprintf("%.4f", rounded)\n}\n\nfunc formatRiskValue(f float64) string {\n\ts := strconv.FormatFloat(f, \'f\', -1, 64)\n\tif !strings.Contains(s, ".") {\n\t\ts += ".0"\n\t}\n\treturn s\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
