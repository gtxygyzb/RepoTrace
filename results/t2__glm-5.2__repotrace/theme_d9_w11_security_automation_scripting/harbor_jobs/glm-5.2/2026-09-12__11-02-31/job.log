Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\nPath(\'forecast.go\').write_text(\'\'\'package main\n\nimport (\n\\t"bufio"\n\\t"encoding/json"\n\\t"fmt"\n\\t"math"\n\\t"os"\n)\n\ntype forecastInputSnapshot struct {\n\\tGlobalMeanRisk float64 `json:"global_mean_risk"`\n\\tTotalThreats   int     `json:"total_threats"`\n}\n\ntype forecastMetricResult struct {\n\\tSlope       float64   `json:"slope"`\n\\tIntercept   float64   `json:"intercept"`\n\\tTrend       string    `json:"trend"`\n\\tLastValue   interface{} `json:"last_value"`\n\\tPredictions []float64 `json:"predictions"`\n}\n\ntype forecastOutput struct {\n\\tInputCount   int                                    `json:"input_count"`\n\\tMetrics      map[string]forecastMetricResult        `json:"metrics"`\n\\tOverallTrend string                                 `json:"overall_trend"`\n\\tAlertLevel   string                                 `json:"alert_level"`\n}\n\nfunc runForecast(args []string) int {\n\\tfs := newFlagSet("forecast")\n\\tsteps := fs.Int("steps", 3, "number of future steps to predict")\n\\tif !parseFlags(fs, args) {\n\\t\\treturn 1\n\\t}\n\\tif *steps < 1 {\n\\t\\tfmt.Fprintln(os.Stderr, "error: --steps must be at least 1")\n\\t\\treturn 1\n\\t}\n\n\\tvar snapshots []forecastInputSnapshot\n\\tscanner := bufio.NewScanner(os.Stdin)\n\\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\n\\tfor scanner.Scan() {\n\\t\\tline := scanner.Text()\n\\t\\tif len(line) == 0 {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tvar snap forecastInputSnapshot\n\\t\\tif err := json.Unmarshal([]byte(line), &snap); err != nil {\n\\t\\t\\tfmt.Fprintf(os.Stderr, "error: malformed JSON input: %s\\\\n", err)\n\\t\\t\\treturn 2\n\\t\\t}\n\\t\\tsnapshots = append(snapshots, snap)\n\\t}\n\\tif err := scanner.Err(); err != nil {\n\\t\\tfmt.Fprintf(os.Stderr, "error: reading input: %s\\\\n", err)\n\\t\\treturn 1\n\\t}\n\\tif len(snapshots) < 3 {\n\\t\\tfmt.Fprintln(os.Stderr, "error: at least 3 valid input snapshots are required")\n\\t\\treturn 1\n\\t}\n\n\\trisks := make([]float64, len(snapshots))\n\\tthreats := make([]float64, len(snapshots))\n\\tfor i, snap := range snapshots {\n\\t\\trisks[i] = snap.GlobalMeanRisk\n\\t\\tthreats[i] = float64(snap.TotalThreats)\n\\t}\n\n\\triskSlope, riskIntercept := olsLine(0, risks)\n\\tthreatSlope, threatIntercept := olsLine(0, threats)\n\n\\triskPredictions := predictLine(riskSlope, riskIntercept, len(snapshots), *steps)\n\\tthreatPredictions := predictLine(threatSlope, threatIntercept, len(snapshots), *steps)\n\n\\triskTrend := trendFromSlope(riskSlope)\n\\tthreatTrend := trendFromSlope(threatSlope)\n\n\\tmetrics := map[string]forecastMetricResult{\n\\t\\t"global_mean_risk": {\n\\t\\t\\tSlope:       roundHalfUp4(riskSlope),\n\\t\\t\\tIntercept:   roundHalfUp4(riskIntercept),\n\\t\\t\\tTrend:       riskTrend,\n\\t\\t\\tLastValue:   snapshots[len(snapshots)-1].GlobalMeanRisk,\n\\t\\t\\tPredictions: roundAll4(riskPredictions),\n\\t\\t},\n\\t\\t"total_threats": {\n\\t\\t\\tSlope:       roundHalfUp4(threatSlope),\n\\t\\t\\tIntercept:   roundHalfUp4(threatIntercept),\n\\t\\t\\tTrend:       threatTrend,\n\\t\\t\\tLastValue:   snapshots[len(snapshots)-1].TotalThreats,\n\\t\\t\\tPredictions: roundAll4(threatPredictions),\n\\t\\t},\n\\t}\n\n\\tout := forecastOutput{\n\\t\\tInputCount:   len(snapshots),\n\\t\\tMetrics:      metrics,\n\\t\\tOverallTrend: overallTrend(riskTrend, threatTrend),\n\\t\\tAlertLevel:   alertLevelFromSlopes(risks, threats, riskSlope, threatSlope),\n\\t}\n\n\\tencoded, err := json.Marshal(out)\n\\tif err != nil {\n\\t\\tfmt.Fprintln(os.Stderr, "error: encoding forecast output:", err)\n\\t\\treturn 1\n\\t}\n\\tfmt.Println(string(encoded))\n\\treturn 0\n}\n\nfunc olsLine(startIndex int, values []float64) (slope, intercept float64) {\n\\tn := len(values)\n\\tif n == 0 {\n\\t\\treturn 0, 0\n\\t}\n\\tvar sumX, sumY, sumXY, sumX2 float64\n\\tfor i, y := range values {\n\\t\\tx := float64(startIndex + i)\n\\t\\tsumX += x\n\\t\\tsumY += y\n\\t\\tsumXY += x * y\n\\t\\tsumX2 += x * x\n\\t}\n\tdenom := float64(n)*sumX2 - sumX*sumX\n\\tif denom == 0 {\n\\t\\tslope = 0\n\\t\\tintercept = values[0]\n\\t\\treturn\n\\t}\n\tslope = (float64(n)*sumXY - sumX*sumY) / denom\n\\tintercept = (sumY - slope*sumX) / float64(n)\n\\treturn\n}\n\nfunc predictLine(slope, intercept float64, startIndex, steps int) []float64 {\n\\tpredictions := make([]float64, steps)\n\\tfor i := 0; i < steps; i++ {\n\\t\\tpredictions[i] = slope*float64(startIndex+i) + intercept\n\\t}\n\\treturn predictions\n}\n\nfunc trendFromSlope(slope float64) string {\n\\tr := roundHalfUp4(slope)\n\\tif r > 0 {\n\\t\\treturn "increasing"\n\\t}\n\\tif r < 0 {\n\\t\\treturn "decreasing"\n\\t}\n\\treturn "stable"\n}\n\nfunc overallTrend(a, b string) string {\n\\tif a == "increasing" && b == "increasing" {\n\\t\\treturn "increasing"\n\\t}\n\\tif a == "decreasing" && b == "decreasing" {\n\\t\\treturn "decreasing"\n\\t}\n\\tif a == "increasing" || b == "increasing" {\n\\t\\tif a == "decreasing" || b == "decreasing" {\n\\t\\t\\treturn "mixed"\n\\t\\t}\n\\t\\treturn "increasing"\n\\t}\n\\tif a == "decreasing" || b == "decreasing" {\n\\t\\treturn "decreasing"\n\\t}\n\\treturn "stable"\n}\n\nfunc alertLevelFromSlopes(risks, threats []float64, riskSlope, threatSlope float64) string {\n\\triskMean := meanOfValues(risks)\n\\tthreatMean := meanOfValues(threats)\n\n\\tmaxRatio := 0.0\n\\tif riskSlope > 0 {\n\\t\\tratio := riskSlope / math.Max(riskMean, 1.0)\n\\t\\tif ratio > maxRatio {\n\\t\\t\\tmaxRatio = ratio\n\\t\\t}\n\\t}\n\\tif threatSlope > 0 {\n\\t\\tratio := threatSlope / math.Max(threatMean, 1.0)\n\\t\\tif ratio > maxRatio {\n\\t\\t\\tmaxRatio = ratio\n\\t\\t}\n\\t}\n\n\\tif maxRatio >= 0.5 {\n\\t\\treturn "critical"\n\\t}\n\\tif maxRatio >= 0.2 {\n\\t\\treturn "warning"\n\\t}\n\\treturn "normal"\n}\n\nfunc meanOfValues(values []float64) float64 {\n\\tif len(values) == 0 {\n\\t\\treturn 0\n\\t}\n\\tvar sum float64\n\\tfor _, v := range values {\n\\t\\tsum += v\n\\t}\n\\treturn sum / float64(len(values))\n}\n\nfunc roundAll4(values []float64) []float64 {\n\\tout := make([]float64, len(values))\n\\tfor i, v := range values {\n\\t\\tout[i] = roundHalfUp4(v)\n\\t}\n\\treturn out\n}\n\'\'\')\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
