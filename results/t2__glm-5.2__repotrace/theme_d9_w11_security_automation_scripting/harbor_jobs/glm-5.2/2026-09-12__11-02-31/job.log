Sending keys: ['cat > track.go <<\'EOF\'\npackage main\n\nimport (\n\t"bufio"\n\t"encoding/json"\n\t"fmt"\n\t"os"\n\t"sort"\n)\n\ntype trackGroup struct {\n\tSourceIP          string\n\tEventCount        int\n\tMaxEnrichedRisk   float64\n\tThreatTypes       []string\n\tThreatActors      []string\n\tFirstActivity     string\n\tLastActivity      string\n}\n\ntype trackOutput struct {\n\tSourceIP        string   `json:"source_ip"`\n\tEventCount      int      `json:"event_count"`\n\tMaxEnrichedRisk float64  `json:"max_enriched_risk"`\n\tThreatTypes     []string `json:"threat_types"`\n\tThreatActors    []string `json:"threat_actors"`\n\tFirstActivity   string   `json:"first_activity"`\n\tLastActivity    string   `json:"last_activity"`\n\tThreatLevel    string   `json:"threat_level"`\n}\n\nfunc runTrack(args []string) int {\n\tscanner := bufio.NewScanner(os.Stdin)\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\n\n\tgroups := make(map[string]*trackGroup)\n\tlineNo := 0\n\n\tfor scanner.Scan() {\n\t\tlineNo++\n\t\tline := scanner.Text()\n\t\tif line == "" {\n\t\t\tcontinue\n\t\t}\n\n\t\tvar ev map[string]interface{}\n\t\tif err := json.Unmarshal([]byte(line), &ev); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "line %d: invalid JSON: %v\\n", lineNo, err)\n\t\t\treturn 2\n\t\t}\n\n\t\tsourceIP := trackGetString(ev, "source_ip", "")\n\t\tg, ok := groups[sourceIP]\n\t\tif !ok {\n\t\t\tg = &trackGroup{\n\t\t\t\tSourceIP:        sourceIP,\n\t\t\t\tMaxEnrichedRisk: -1,\n\t\t\t\tThreatTypes:     []string{},\n\t\t\t\tThreatActors:    []string{},\n\t\t\t}\n\t\t\tgroups[sourceIP] = g\n\t\t}\n\n\t\tg.EventCount++\n\n\t\tif risk, ok := trackGetFloat(ev, "enriched_risk_score"); ok && risk > g.MaxEnrichedRisk {\n\t\t\tg.MaxEnrichedRisk = risk\n\t\t}\n\n\t\tif threatType, ok := trackGetStringOk(ev, "threat_type"); ok {\n\t\t\tg.ThreatTypes = append(g.ThreatTypes, threatType)\n\t\t}\n\n\t\tif actors, ok := trackGetStringSlice(ev, "threat_actors"); ok {\n\t\t\tg.ThreatActors = append(g.ThreatActors, actors...)\n\t\t}\n\n\t\tfirstSeen := trackGetString(ev, "first_seen", "")\n\t\tif g.FirstActivity == "" || firstSeen < g.FirstActivity {\n\t\t\tg.FirstActivity = firstSeen\n\t\t}\n\n\t\tlastSeen := trackGetString(ev, "last_seen", "")\n\t\tif lastSeen > g.LastActivity {\n\t\t\tg.LastActivity = lastSeen\n\t\t}\n\t}\n\n\tif err := scanner.Err(); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error reading input: %v\\n", err)\n\t\treturn 2\n\t}\n\n\toutputs := make([]trackOutput, 0, len(groups))\n\tfor _, g := range groups {\n\t\tif g.MaxEnrichedRisk < 0 {\n\t\t\tg.MaxEnrichedRisk = 0\n\t\t}\n\t\toutputs = append(outputs, trackOutput{\n\t\t\tSourceIP:        g.SourceIP,\n\t\t\tEventCount:      g.EventCount,\n\t\t\tMaxEnrichedRisk: g.MaxEnrichedRisk,\n\t\t\tThreatTypes:     ensureStringSlice(uniqueSortedStrings(g.ThreatTypes)),\n\t\t\tThreatActors:    ensureStringSlice(uniqueSortedStrings(g.ThreatActors)),\n\t\t\tFirstActivity:   g.FirstActivity,\n\t\t\tLastActivity:    g.LastActivity,\n\t\t\tThreatLevel:     trackThreatLevel(g.EventCount, g.MaxEnrichedRisk),\n\t\t})\n\t}\n\n\tsort.SliceStable(outputs, func(i, j int) bool {\n\t\tif outputs[i].MaxEnrichedRisk != outputs[j].MaxEnrichedRisk {\n\t\t\treturn outputs[i].MaxEnrichedRisk > outputs[j].MaxEnrichedRisk\n\t\t}\n\t\treturn outputs[i].SourceIP < outputs[j].SourceIP\n\t})\n\n\tfor _, out := range outputs {\n\t\tb, err := json.Marshal(out)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error encoding output: %v\\n", err)\n\t\t\treturn 2\n\t\t}\n\t\tfmt.Println(string(b))\n\t}\n\n\treturn 0\n}\n\nfunc trackThreatLevel(eventCount int, maxRisk float64) string {\n\tif eventCount >= 5 || maxRisk >= 500.0 {\n\t\treturn "critical"\n\t}\n\tif eventCount >= 3 || maxRisk >= 300.0 {\n\t\treturn "high"\n\t}\n\tif eventCount >= 2 || maxRisk >= 150.0 {\n\t\treturn "medium"\n\t}\n\treturn "low"\n}\n\nfunc ensureStringSlice(s []string) []string {\n\tif s == nil {\n\t\treturn []string{}\n\t}\n\treturn s\n}\n\nfunc trackGetString(ev map[string]interface{}, key, fallback string) string {\n\tif v, ok := ev[key].(string); ok {\n\t\treturn v\n\t}\n\treturn fallback\n}\n\nfunc trackGetStringOk(ev map[string]interface{}, key string) (string, bool) {\n\tv, ok := ev[key].(string)\n\treturn v, ok\n}\n\nfunc trackGetFloat(ev map[string]interface{}, key string) (float64, bool) {\n\tswitch v := ev[key].(type) {\n\tcase float64:\n\t\treturn v, true\n\tcase int:\n\t\treturn float64(v), true\n\tcase int64:\n\t\treturn float64(v), true\n\t}\n\treturn 0, false\n}\n\nfunc trackGetStringSlice(ev map[string]interface{}, key string) ([]string, bool) {\n\tarr, ok := ev[key].([]interface{})\n\tif !ok {\n\t\treturn nil, false\n\t}\n\tout := make([]string, 0, len(arr))\n\tfor _, item := range arr {\n\t\tif s, ok := item.(string); ok {\n\t\t\tout = append(out, s)\n\t\t}\n\t}\n\treturn out, true\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
