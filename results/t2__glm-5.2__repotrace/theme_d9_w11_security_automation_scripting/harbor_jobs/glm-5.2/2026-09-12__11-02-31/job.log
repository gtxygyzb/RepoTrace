ror: --max-threats must be greater than 0")\n\t\treturn 1\n\t}\n\n\tvar snapshots []complianceInputSnapshot\n\tscanner := bufio.NewScanner(os.Stdin)\n\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\n\tfor scanner.Scan() {\n\t\tline := strings.TrimSpace(scanner.Text())\n\t\tif line == "" {\n\t\t\tcontinue\n\t\t}\n\n\t\tvar snap complianceInputSnapshot\n\t\tif err := json.Unmarshal([]byte(line), &snap); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error: malformed JSON input: %s\\n", err)\n\t\t\treturn 2\n\t\t}\n\t\tsnapshots = append(snapshots, snap)\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: reading input: %s\\n", err)\n\t\treturn 1\n\t}\n\n\tif len(snapshots) < *minSnapshots {\n\t\tfmt.Fprintf(os.Stderr, "error: at least %d valid input snapshot(s) required\\n", *minSnapshots)\n\t\treturn 1\n\t}\n\n\ttotal := len(snapshots)\n\tcompliant := 0\n\tviolations := []complianceViolation{}\n\tvar worstRisk float64\n\tworstThreats := 0\n\tvar sumRisk, sumThreats float64\n\n\tfor i, snap := range snapshots {\n\t\tif i == 0 || snap.GlobalMeanRisk > worstRisk {\n\t\t\tworstRisk = snap.GlobalMeanRisk\n\t\t}\n\t\tif i == 0 || snap.TotalThreats > worstThreats {\n\t\t\tworstThreats = snap.TotalThreats\n\t\t}\n\t\tsumRisk += snap.GlobalMeanRisk\n\t\tsumThreats += float64(snap.TotalThreats)\n\n\t\treasons := []string{}\n\t\tif snap.GlobalMeanRisk > *maxRisk {\n\t\t\treasons = append(reasons, "risk_exceeded")\n\t\t}\n\t\tif snap.TotalThreats > *maxThreats {\n\t\t\treasons = append(reasons, "threats_exceeded")\n\t\t}\n\t\tif len(reasons) == 0 {\n\t\t\tcompliant++\n\t\t\tcontinue\n\t\t}\n\n\t\tsort.Strings(reasons)\n\t\tviolations = append(violations, complianceViolation{\n\t\t\tIndex:          i,\n\t\t\tGlobalMeanRisk: json.Number(formatRiskValue(snap.GlobalMeanRisk)),\n\t\t\tTotalThreats:   snap.TotalThreats,\n\t\t\tReasons:        reasons,\n\t\t})\n\t}\n\n\tvar percentage float64\n\tif total > 0 {\n\t\tpercentage = float64(compliant) / float64(total) * 100.0\n\t}\n\troundedPercentage := roundHalfUp4(percentage)\n\n\tstatus := "partial"\n\tswitch {\n\tcase roundedPercentage == 100.0:\n\t\tstatus = "full"\n\tcase roundedPercentage == 0.0:\n\t\tstatus = "none"\n\t}\n\n\tvar meanRisk, meanThreats float64\n\tif total > 0 {\n\t\tmeanRisk = sumRisk / float64(total)\n\t\tmeanThreats = sumThreats / float64(total)\n\t}\n\n\tout := complianceOutput{\n\t\tTotalSnapshots:       total,\n\t\tCompliantCount:       compliant,\n\t\tViolationCount:       len(violations),\n\t\tCompliancePercentage: json.Number(format4(roundedPercentage)),\n\t\tStatus:               status,\n\t\tPolicy: compliancePolicy{\n\t\t\tMaxRisk:    *maxRisk,\n\t\t\tMaxThreats: *maxThreats,\n\t\t},\n\t\tViolations: violations,\n\t\tSummary: complianceSummary{\n\t\t\tWorstRisk:    json.Number(formatRiskValue(worstRisk)),\n\t\t\tWorstThreats: worstThreats,\n\t\t\tMeanRisk:     json.Number(format4(meanRisk)),\n\t\t\tMeanThreats:  json.Number(format4(meanThreats)),\n\t\t},\n\t}\n\n\tencoded, err := json.Marshal(out)\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, "error: encoding compliance output:", err)\n\t\treturn 1\n\t}\n\tfmt.Println(string(encoded))\n\treturn 0\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
