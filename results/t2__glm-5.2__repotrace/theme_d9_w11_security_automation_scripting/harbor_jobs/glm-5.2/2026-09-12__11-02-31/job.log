4)\n\tthreats := make([]correlateThreat, 0)\n\tlineNo := 0\n\tfor scanner.Scan() {\n\t\tlineNo++\n\t\tline := scanner.Text()\n\t\tif line == "" {\n\t\t\tcontinue\n\t\t}\n\t\tvar obj map[string]interface{}\n\t\tif err := json.Unmarshal([]byte(line), &obj); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "line %d: %v\\n", lineNo, err)\n\t\t\treturn 2\n\t\t}\n\t\tct := correlateThreat{\n\t\t\tobj: obj,\n\t\t\tref: threatReferenceTime(obj),\n\t\t}\n\t\tif actors, ok := getStringSlice(obj, "threat_actors"); ok {\n\t\t\tct.actors = actors\n\t\t} else {\n\t\t\tct.actors = []string{}\n\t\t}\n\t\tif r, ok := getFloat(obj, "enriched_risk_score"); ok {\n\t\t\tct.risk = r\n\t\t}\n\t\tif tt, ok := getString(obj, "threat_type"); ok {\n\t\t\tct.threatType = tt\n\t\t}\n\t\tif sev, ok := getString(obj, "ioc_severity"); ok {\n\t\t\tct.severity = sev\n\t\t}\n\t\tthreats = append(threats, ct)\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\n\tn := len(threats)\n\tlinked := make([][]bool, n)\n\tfor i := range linked {\n\t\tlinked[i] = make([]bool, n)\n\t}\n\tfor i := 0; i < n; i++ {\n\t\tif len(threats[i].actors) == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tfor j := i + 1; j < n; j++ {\n\t\t\tif len(threats[j].actors) == 0 {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif absDuration(threats[i].ref.Sub(threats[j].ref)) <= window && sharedActorCount(threats[i].actors, threats[j].actors) > 0 {\n\t\t\t\tlinked[i][j] = true\n\t\t\t\tlinked[j][i] = true\n\t\t\t}\n\t\t}\n\t}\n\n\tvisited := make([]bool, n)\n\tvar campaigns []correlateCampaign\n\tfor start := 0; start < n; start++ {\n\t\tif visited[start] {\n\t\t\tcontinue\n\t\t}\n\t\tqueue := []int{start}\n\t\tvisited[start] = true\n\t\tcomponent := []int{start}\n\t\tfor len(queue) > 0 {\n\t\t\tcur := queue[0]\n\t\t\tqueue = queue[1:]\n\t\t\tfor next := 0; next < n; next++ {\n\t\t\t\tif !visited[next] && linked[cur][next] {\n\t\t\t\t\tvisited[next] = true\n\t\t\t\t\tqueue = append(queue, next)\n\t\t\t\t\tcomponent = append(component, next)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif len(component) < *minCampaignSize {\n\t\t\tcontinue\n\t\t}\n\t\tcampaigns = append(campaigns, buildCorrelateCampaign(threats, component, linked))\n\t}\n\n\tsort.SliceStable(campaigns, func(i, j int) bool {\n\t\tif !campaigns[i].earliestTime.Equal(campaigns[j].earliestTime) {\n\t\t\treturn campaigns[i].earliestTime.Before(campaigns[j].earliestTime)\n\t\t}\n\t\treturn campaigns[i].minThreatType < campaigns[j].minThreatType\n\t})\n\tfor i := range campaigns {\n\t\tcampaigns[i].CampaignID = fmt.Sprintf("CAMP-%03d", i+1)\n\t}\n\n\tsort.SliceStable(campaigns, func(i, j int) bool {\n\t\tif campaigns[i].CombinedRisk != campaigns[j].CombinedRisk {\n\t\t\treturn campaigns[i].CombinedRisk > campaigns[j].CombinedRisk\n\t\t}\n\t\tif campaigns[i].Cohesion != campaigns[j].Cohesion {\n\t\t\treturn campaigns[i].Cohesion > campaigns[j].Cohesion\n\t\t}\n\t\treturn campaigns[i].CampaignID < campaigns[j].CampaignID\n\t})\n\n\tw := bufio.NewWriter(os.Stdout)\n\tdefer w.Flush()\n\tenc := json.NewEncoder(w)\n\tfor _, c := range campaigns {\n\t\tif err := enc.Encode(c); err != nil {\n\t\t\tfmt.Fprintln(os.Stderr, err)\n\t\t\treturn 1\n\t\t}\n\t}\n\treturn 0\n}\n\nfunc buildCorrelateCampaign(threats []correlateThreat, indices []int, linked [][]bool) correlateCampaign {\n\tc := correlateCampaign{\n\t\tThreatCount:  len(indices),\n\t\tThreatTypes:  []string{},\n\t\tSharedActors: []string{},\n\t\tAllActors:    []string{},\n\t\tThreats:      []map[string]interface{}{},\n\t}\n\n\ttypeSet := make(map[string]bool)\n\tactorSet := make(map[string]bool)\n\tfor _, idx := range indices {\n\t\ttypeSet[threats[idx].threatType] = true\n\t\tfor _, actor := range threats[idx].actors {\n\t\t\tactorSet[actor] = true\n\t\t}\n\t}\n\tc.ThreatTypes = sortedKeys(typeSet)\n\tc.AllActors = sortedUniqueStringsFromSet(actorSet)\n\n\tif len(indices) > 0 {\n\t\tshared := make(map[string]bool)\n\t\tfor _, actor := range threats[indices[0]].actors {\n\t\t\tshared[actor] = true\n\t\t}\n\t\tfor _, idx := range indices[1:] {\n\t\t\tnext := make(map[string]bool)\n\t\t\tfor _, actor := range threats[idx].actors {\n\t\t\t\tif shared[actor] {\n\t\t\t\t\tnext[actor] = true\n\t\t\t\t}\n\t\t\t}\n\t\t\tshared = next\n\t\t}\n\t\tc.SharedActors = sortedUniqueStringsFromSet(shared)\n\t}\n\n\tdirectLinkCount := 0\n\tfor ii, i := range indices {\n\t\tfor jj := ii + 1; jj < len(indices); jj++ {\n\t\t\tif linked[i][indices[jj]] {\n\t\t\t\tdirectLinkCount++\n\t\t\t}\n\t\t}\n\t}\n\tc.DirectLinkCount = directLinkCount\n\tif c.ThreatCount > 1 {\n\t\tc.Cohesion = float64(directLinkCount) / (float64(c.ThreatCount*(c.ThreatCount-1)) / 2.0)\n\t} else {\n\t\tc.Cohesion = 0.0\n\t}\n\n\tpropagationScore := 0.0\n\tfor ii, i := range indices {\n\t\tfor jj := ii + 1; jj < len(indices); jj++ {\n\t\t\tj := indices[jj]\n\t\t\tif !linked[i][j] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tsharedCount := sharedActorCount(threats[i].actors, threats[j].actors)\n\t\t\tmultiplier := 0.05\n\t\t\tif sharedCount >= 2 {\n\t\t\t\tmultiplier = 0.1\n\t\t\t}\n\t\t\tpropagationScore += (threats[i].risk + threats[j].risk) * multiplier\n\t\t}\n\t}\n\tc.PropagationScore = propagationScore\n\n\tmaxSeverity := "none"\n\tfor _, idx := range indices {\n\t\tif correlateSeverityRank(threats[idx].severity) > correlateSeverityRank(maxSeverity) {\n\t\t\tmaxSeverity = threats[idx].severity\n\t\t}\n\t}\n\tc.MaxSeverity = maxSeverity\n\n\tearliest := threats[indices[0]].ref\n\tlatest := earliest\n\tfor _, idx := range indices[1:] {\n\t\tif threats[idx].ref.Before(earliest) {\n\t\t\tearliest = threats[idx].ref\n\t\t}\n\t\tif threats[idx].ref.After(latest) {\n\t\t\tlatest = threats[idx].ref\n\t\t}\n\t}\n\tc.earliestTime = earliest\n\tc.Earliest = earliest.Format(time.RFC3339)\n\tc.Latest = latest.Format(time.RFC3339)\n\tc.TimeSpanMinutes = latest.Sub(earliest).Seconds() / 60.0\n\n\tcombinedRisk := 0.0\n\tminThreatType := ""\n\tfor _, idx := range indices {\n\t\tcombinedRisk += threats[idx].risk\n\t\ttt := threats[idx].threatType\n\t\tif minThreatType == "" || tt < minThreatType {\n\t\t\tminThreatType = tt\n\t\t}\n\t}\n\tc.CombinedRisk = combinedRisk\n\tc.minThreatType = minThreatType\n\n\tsortedIndices := make([]int, len(indices))\n\tcopy(sortedIndices, indices)\n\tsort.SliceStable(sortedIndices, func(a, b int) bool {\n\t\tta := threats[sortedIndices[a]]\n\t\ttb := threats[sortedIndices[b]]\n\t\tif ta.risk != tb.risk {\n\t\t\treturn ta.risk > tb.risk\n\t\t}\n\t\tif !ta.ref.Equal(tb.ref) {\n\t\t\treturn ta.ref.Before(tb.ref)\n\t\t}\n\t\treturn ta.threatType < tb.threatType\n\t})\n\tc.Threats = make([]map[string]interface{}, 0, len(sortedIndices))\n\tfor _, idx := range sortedIndices {\n\t\tc.Threats = append(c.Threats, threats[idx].obj)\n\t}\n\n\treturn c\n}\n\nfunc sharedActorCount(a, b []string) int {\n\tset := make(map[string]bool)\n\tfor _, s := range a {\n\t\tset[s] = true\n\t}\n\tcount := 0\n\tseen := make(map[string]bool)\n\tfor _, s := range b {\n\t\tif set[s] && !seen[s] {\n\t\t\tcount++\n\t\t\tseen[s] = true\n\t\t}\n\t}\n\treturn count\n}\n\nfunc absDuration(d time.Duration) time.Duration {\n\tif d < 0 {\n\t\treturn -d\n\t}\n\treturn d\n}\n\nfunc correlateSeverityRank(s string) int {\n\tswitch s {\n\tcase "none":\n\t\treturn 0\n\tcase "low":\n\t\treturn 1\n\tcase "medium":\n\t\treturn 2\n\tcase "high":\n\t\treturn 3\n\tcase "critical":\n\t\treturn 4\n\tdefault:\n\t\treturn 0\n\t}\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
