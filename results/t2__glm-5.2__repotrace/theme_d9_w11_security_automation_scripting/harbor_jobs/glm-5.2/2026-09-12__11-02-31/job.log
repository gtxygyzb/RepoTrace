sValue(tag) * factor\n\t}\n\n\tmultiVectorBonus := 0.0\n\tswitch len(indicatorTypes) {\n\tcase 0, 1:\n\t\tmultiVectorBonus = 0.0\n\tcase 2:\n\t\tmultiVectorBonus = 25.0\n\tdefault:\n\t\tmultiVectorBonus = 50.0\n\t}\n\n\tactorBonus := 0.0\n\tswitch len(actors) {\n\tcase 0, 1:\n\t\tactorBonus = 0.0\n\tcase 2:\n\t\tactorBonus = 15.0\n\tdefault:\n\t\tactorBonus = 30.0\n\t}\n\n\tenrichedScore := riskScore*(1.0+maxConf) + tagBonus + multiVectorBonus + float64(severityContrib) + actorBonus\n\n\toutMatches := make([]iocMatchOutput, 0, len(matches))\n\tfor _, m := range matches {\n\t\toutMatches = append(outMatches, iocMatchOutput{\n\t\t\tIocID:         m.p.entry.ID,\n\t\t\tIndicator:     m.p.entry.Indicator,\n\t\t\tIndicatorType: m.p.entry.IndicatorType,\n\t\t\tThreatActor:   m.p.entry.ThreatActor,\n\t\t\tConfidence:    m.p.entry.Confidence,\n\t\t\tTags:          nonNilStrings(m.p.entry.Tags),\n\t\t\tMatchedFields: nonNilStrings(m.matchedFields),\n\t\t})\n\t}\n\n\tthreat["ioc_matches"] = outMatches\n\tthreat["enriched_risk_score"] = enrichedScore\n\tthreat["threat_actors"] = nonNilStrings(sortedUniqueStringsFromSet(actors))\n\tthreat["max_ioc_confidence"] = maxConf\n\tif len(matches) == 0 {\n\t\tthreat["ioc_severity"] = "none"\n\t} else {\n\t\tthreat["ioc_severity"] = severityFromRank(sevRank)\n\t}\n\treturn threat\n}\n\nfunc computeIOCMatches(threat map[string]interface{}, iocs []processedIOC, refTime time.Time, minConf float64) []iocMatchInternal {\n\tactive := make([]activeIOC, 0, len(iocs))\n\tfor _, p := range iocs {\n\t\tbase, factor, ok := computeFreshness(p, refTime)\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif base < minConf {\n\t\t\tcontinue\n\t\t}\n\t\tactive = append(active, activeIOC{p: p, base: base, factor: factor})\n\t}\n\n\tmatchedFields := make([]map[string]bool, len(active))\n\tfor i := range active {\n\t\tmatchedFields[i] = make(map[string]bool)\n\t}\n\n\ttype cidrCandidate struct {\n\t\tactiveIdx int\n\t\tbase      float64\n\t\tprefixLen int\n\t\tiocID     string\n\t}\n\tcidrCandidates := make(map[string]map[string][]cidrCandidate)\n\n\taddCIDRCandidate := func(field, ipStr string, idx int, a activeIOC) {\n\t\tif cidrCandidates[field] == nil {\n\t\t\tcidrCandidates[field] = make(map[string][]cidrCandidate)\n\t\t}\n\t\tcidrCandidates[field][ipStr] = append(cidrCandidates[field][ipStr], cidrCandidate{\n\t\t\tactiveIdx: idx,\n\t\t\tbase:      a.base,\n\t\t\tprefixLen: a.p.prefixLen,\n\t\t\tiocID:     a.p.entry.ID,\n\t\t})\n\t}\n\n\tfor i, a := range active {\n\t\tswitch a.p.entry.IndicatorType {\n\t\tcase "ipv4":\n\t\t\tif val, ok := getString(threat, "source_ip"); ok && a.p.entry.Indicator == val {\n\t\t\t\tmatchedFields[i]["source_ip"] = true\n\t\t\t}\n\t\t\tif val, ok := getString(threat, "dest_ip"); ok && a.p.entry.Indicator == val {\n\t\t\t\tmatchedFields[i]["dest_ip"] = true\n\t\t\t}\n\t\t\tif vals, ok := getStringSlice(threat, "dest_ips"); ok {\n\t\t\t\tfor _, val := range vals {\n\t\t\t\t\tif a.p.entry.Indicator == val {\n\t\t\t\t\t\tmatchedFields[i]["dest_ips"] = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif vals, ok := getStringSlice(threat, "compromised_hosts"); ok {\n\t\t\t\tfor _, val := range vals {\n\t\t\t\t\tif a.p.entry.Indicator == val {\n\t\t\t\t\t\tmatchedFields[i]["compromised_hosts"] = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\tcase "ipv4_cidr":\n\t\t\tif val, ok := getString(threat, "source_ip"); ok {\n\t\t\t\tif ip := net.ParseIP(val); ip != nil && a.p.ipNet.Contains(ip) {\n\t\t\t\t\taddCIDRCandidate("source_ip", val, i, a)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif val, ok := getString(threat, "dest_ip"); ok {\n\t\t\t\tif ip := net.ParseIP(val); ip != nil && a.p.ipNet.Contains(ip) {\n\t\t\t\t\taddCIDRCandidate("dest_ip", val, i, a)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif vals, ok := getStringSlice(threat, "dest_ips"); ok {\n\t\t\t\tfor _, val := range vals {\n\t\t\t\t\tif ip := net.ParseIP(val); ip != nil && a.p.ipNet.Contains(ip) {\n\t\t\t\t\t\taddCIDRCandidate("dest_ips", val, i, a)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif vals, ok := getStringSlice(threat, "compromised_hosts"); ok {\n\t\t\t\tfor _, val := range vals {\n\t\t\t\t\tif ip := net.ParseIP(val); ip != nil && a.p.ipNet.Contains(ip) {\n\t\t\t\t\t\taddCIDRCandidate("compromised_hosts", val, i, a)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\tcase "port":\n\t\t\tif vals, ok := getIntSlice(threat, "ports_scanned"); ok {\n\t\t\t\tfor _, val := range vals {\n\t\t\t\t\tif a.p.port == val {\n\t\t\t\t\t\tmatchedFields[i]["ports_scanned"] = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\tcase "user":\n\t\t\tif val, ok := getString(threat, "user"); ok && a.p.entry.Indicator == val {\n\t\t\t\tmatchedFields[i]["user"] = true\n\t\t\t}\n\t\t\tif vals, ok := getStringSlice(threat, "target_users"); ok {\n\t\t\t\tfor _, val := range vals {\n\t\t\t\t\tif a.p.entry.Indicator == val {\n\t\t\t\t\t\tmatchedFields[i]["target_users"] = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tfor field, ipMap := range cidrCandidates {\n\t\tfor _, cands := range ipMap {\n\t\t\tsort.Slice(cands, func(i, j int) bool {\n\t\t\t\tif cands[i].prefixLen != cands[j].prefixLen {\n\t\t\t\t\treturn cands[i].prefixLen > cands[j].prefixLen\n\t\t\t\t}\n\t\t\t\tif cands[i].base != cands[j].base {\n\t\t\t\t\treturn cands[i].base > cands[j].base\n\t\t\t\t}\n\t\t\t\treturn cands[i].iocID < cands[j].iocID\n\t\t\t})\n\t\t\twinner := cands[0].activeIdx\n\t\t\tmatchedFields[winner][field] = true\n\t\t}\n\t}\n\n\tmatches := make([]iocMatchInternal, 0, len(active))\n\tfor i, a := range active {\n\t\tif len(matchedFields[i]) == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tfields := sortedKeys(matchedFields[i])\n\t\tadjusted := a.base * maxFieldMultiplier(fields)\n\t\tmatches = append(matches, iocMatchInternal{\n\t\t\tp:             a.p,\n\t\t\tbase:          a.base,\n\t\t\tfreshness:     a.factor,\n\t\t\tadjusted:      adjusted,\n\t\t\tmatchedFields: fields,\n\t\t})\n\t}\n\n\tsort.SliceStable(matches, func(i, j int) bool {\n\t\tif matches[i].adjusted != matches[j].adjusted {\n\t\t\treturn matches[i].adjusted > matches[j].adjusted\n\t\t}\n\t\treturn matches[i].p.entry.ID < matches[j].p.entry.ID\n\t})\n\treturn matches\n}\n\nfunc computeFreshness(p processedIOC, refTime time.Time) (float64, float64, bool) {\n\tageHours := refTime.Sub(p.lastUpdated).Hours()\n\tfreshnessFraction := ageHours / float64(p.ttlHours)\n\tif freshnessFraction >= 1.0 {\n\t\treturn 0, 0, false\n\t}\n\tfactor := freshnessFactor(freshnessFraction)\n\treturn p.entry.Confidence * factor, factor, true\n}\n\nfunc freshnessFactor(fraction float64) float64 {\n\tswitch {\n\tcase fraction < 0.25:\n\t\treturn 1.0\n\tcase fraction < 0.50:\n\t\treturn 0.9\n\tcase fraction < 0.75:\n\t\treturn 0.7\n\tdefault:\n\t\treturn 0.5\n\t}\n}\n\nfunc fieldMultiplier(field string) float64 {\n\tswitch field {\n\tcase "source_ip", "dest_ip", "compromised_hosts", "user":\n\t\treturn 1.0\n\tcase "dest_ips", "target_users":\n\t\treturn 0.8\n\tcase "ports_scanned":\n\t\treturn 0.6\n\tdefault:\n\t\treturn 0.0\n\t}\n}\n\nfunc maxFieldMultiplier(fields []string) float64 {\n\tmax := 0.0\n\tfor _, f := range fields {\n\t\tif m := fieldMultiplier(f); m > max {\n\t\t\tmax = m\n\t\t}\n\t}\n\treturn max\n}\n\nfunc tagBonusValue(tag string) float64 {\n\tswitch tag {\n\tcase "apt":\n\t\treturn 100.0\n\tcase "ransomware":\n\t\treturn 75.0\n\tcase "botnet":\n\t\treturn 50.0\n\tcase "phishing":\n\t\treturn 30.0\n\tcase "scanner":\n\t\treturn 25.0\n\tcase "cryptominer":\n\t\treturn 20.0\n\tdefault:\n\t\treturn 0.0\n\t}\n}\n\nfunc severityWeight(s string) int {\n\tswitch s {\n\tcase "low":\n\t\treturn 5\n\tcase "medium":\n\t\treturn 10\n\tcase "high":\n\t\treturn 20\n\tcase "critical":\n\t\treturn 40\n\tdefault:\n\t\treturn 0\n\t}\n}\n\nfunc severityFromRank(rank int) string {\n\tswitch rank {\n\tcase 1:\n\t\treturn "low"\n\tcase 2:\n\t\treturn "medium"\n\tcase 3:\n\t\treturn "high"\n\tcase 4:\n\t\treturn "critical"\n\tdefault:\n\t\treturn "none"\n\t}\n}\n\nfunc threatReferenceTime(threat map[string]interface{}) time.Time {\n\tif tt, ok := getString(threat, "threat_type"); ok && tt == "privilege_escalation" {\n\t\tif ts, ok := getString(threat, "timestamp"); ok {\n\t\t\tif t, err := parseTime(ts); err == nil {\n\t\t\t\treturn t\n\t\t\t}\n\t\t}\n\t}\n\tif ts, ok := getString(threat, "first_seen"); ok {\n\t\tif t, err := parseTime(ts); err == nil {\n\t\t\treturn t\n\t\t}\n\t}\n\treturn time.Time{}\n}\n\nfunc sortEnrichedThreats(threats []map[string]interface{}) {\n\tsort.SliceStable(threats, func(i, j int) bool {\n\t\ta := threats[i]\n\t\tb := threats[j]\n\t\tea, _ := getFloat(a, "enriched_risk_score")\n\t\teb, _ := getFloat(b, "enriched_risk_score")\n\t\tif ea != eb {\n\t\t\treturn ea > eb\n\t\t}\n\t\tta := threatSortTime(a)\n\t\ttb := threatSortTime(b)\n\t\tif !ta.Equal(tb) {\n\t\t\treturn ta.Before(tb)\n\t\t}\n\t\ttta, _ := getString(a, "threat_type")\n\t\tttb, _ := getString(b, "threat_type")\n\t\treturn tta < ttb\n\t})\n}\n\nfunc threatSortTime(threat map[string]interface{}) time.Time {\n\tif tt, ok := getString(threat, "threat_type"); ok && tt == "privilege_escalation" {\n\t\tif ts, ok := getString(threat, "timestamp"); ok {\n\t\t\tif t, err := parseTime(ts); err == nil {\n\t\t\t\treturn t\n\t\t\t}\n\t\t}\n\t}\n\tif ts, ok := getString(threat, "first_seen"); ok {\n\t\tif t, err := parseTime(ts); err == nil {\n\t\t\treturn t\n\t\t}\n\t}\n\treturn time.Time{}\n}\n\nfunc getString(m map[string]interface{}, key string) (string, bool) {\n\tv, ok := m[key]\n\tif !ok {\n\t\treturn "", false\n\t}\n\ts, ok := v.(string)\n\treturn s, ok\n}\n\nfunc getStringSlice(m map[string]interface{}, key string) ([]string, bool) {\n\tv, ok := m[key]\n\tif !ok {\n\t\treturn nil, false\n\t}\n\tswitch val := v.(type) {\n\tcase []string:\n\t\treturn val, true\n\tcase []interface{}:\n\t\tout := make([]string, 0, len(val))\n\t\tfor _, e := range val {\n\t\t\ts, ok := e.(string)\n\t\t\tif !ok {\n\t\t\t\treturn nil, false\n\t\t\t}\n\t\t\t