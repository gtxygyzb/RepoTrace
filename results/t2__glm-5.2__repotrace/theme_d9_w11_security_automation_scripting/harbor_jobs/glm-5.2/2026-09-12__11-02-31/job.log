emplates := make(map[string]string)\n    scanner := bufio.NewScanner(f)\n    scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\n    lineNo := 0\n    for scanner.Scan() {\n        lineNo++\n        line := scanner.Text()\n        if strings.TrimSpace(line) == "" {\n            continue\n        }\n        idx := strings.Index(line, ":")\n        if idx < 0 {\n            return nil, fmt.Errorf("invalid template line %d: missing colon", lineNo)\n        }\n        threatType := strings.TrimSpace(line[:idx])\n        action := strings.TrimSpace(line[idx+1:])\n        templates[threatType] = action\n    }\n    if err := scanner.Err(); err != nil {\n        return nil, err\n    }\n    return templates, nil\n}\n\nfunc readThreats() ([]ThreatInput, error) {\n    scanner := bufio.NewScanner(os.Stdin)\n    scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\n    var threats []ThreatInput\n    lineNo := 0\n    for scanner.Scan() {\n        lineNo++\n        line := scanner.Text()\n        if line == "" {\n            continue\n        }\n        var raw map[string]interface{}\n        if err := json.Unmarshal([]byte(line), &raw); err != nil {\n            return threats, fmt.Errorf("line %d: %w", lineNo, err)\n        }\n        t := ThreatInput{\n            ThreatType: stringValue(raw, "threat_type"),\n            SourceIP:   stringValue(raw, "source_ip"),\n            DestIP:     stringValue(raw, "dest_ip"),\n            User:       stringValue(raw, "user"),\n            Timestamp:  stringValue(raw, "timestamp"),\n            RiskScore:  floatValue(raw, "risk_score"),\n            raw:        raw,\n        }\n        t.PortsScanned = intSliceValue(raw, "ports_scanned")\n        threats = append(threats, t)\n    }\n    if err := scanner.Err(); err != nil {\n        return threats, err\n    }\n    return threats, nil\n}\n\nfunc substituteTemplate(tmpl string, t ThreatInput) string {\n    replace := func(key, value string) {\n        tmpl = strings.ReplaceAll(tmpl, key,