tif err := scanner.Err(); err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\tif len(values) == 0 {\n\t\tfmt.Fprintln(os.Stderr, "no valid events")\n\t\treturn 1\n\t}\n\n\tn := len(values)\n\tbucketWidth := (*maxVal - *minVal) / float64(*buckets)\n\tbucketWidth = round4(bucketWidth)\n\n\tcounts := make([]int, *buckets)\n\tfor _, v := range values {\n\t\tidx := int((v - *minVal) / bucketWidth)\n\t\tif idx < 0 {\n\t\t\tidx = 0\n\t\t}\n\t\tif idx >= *buckets {\n\t\t\tidx = *buckets - 1\n\t\t}\n\t\tcounts[idx]++\n\t}\n\n\tbucketsOut := make([]histogramBucket, 0, *buckets)\n\tfor i := 0; i < *buckets; i++ {\n\t\tstart := *minVal + float64(i)*bucketWidth\n\t\tend := *minVal + float64(i+1)*bucketWidth\n\t\tif i == *buckets-1 {\n\t\t\tend = *maxVal\n\t\t}\n\t\tbucketsOut = append(bucketsOut, histogramBucket{\n\t\t\tRangeStart: round4(start),\n\t\t\tRangeEnd:   round4(end),\n\t\t\tCount:      counts[i],\n\t\t\tPercentage: round4(float64(counts[i]) / float64(n) * 100),\n\t\t})\n\t}\n\n\tsorted := make([]float64, n)\n\tcopy(sorted, values)\n\tsort.Float64s(sorted)\n\n\tmin := sorted[0]\n\tmax := sorted[n-1]\n\tsum := 0.0\n\tfor _, v := range values {\n\t\tsum += v\n\t}\n\tmean := sum / float64(n)\n\tmedian := percentile(sorted, 50)\n\tp90 := percentile(sorted, 90)\n\tp95 := percentile(sorted, 95)\n\n\tvar sqSum float64\n\tfor _, v := range values {\n\t\tsqSum += (v - mean) * (v - mean)\n\t}\n\tstddev := math.Sqrt(sqSum / float64(n))\n\n\tout := histogramOutput{\n\t\tEventCount:  n,\n\t\tBucketWidth: bucketWidth,\n\t\tBuckets:     bucketsOut,\n\t\tStatistics: histogramStats{\n\t\t\tMin:    round4(min),\n\t\t\tMax:    round4(max),\n\t\t\tMean:   round4(mean),\n\t\t\tMedian: round4(median),\n\t\t\tP90:   round4(p90),\n\t\t\tP95:   round4(p95),\n\t\t\tStdDev: round4(stddev),\n\t\t},\n\t}\n\tencoder := json.NewEncoder(os.Stdout)\n\tencoder.SetOutput(os.Stdout)\n\tif err := encoder.Encode(&out); err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc percentile(sorted []float64, p float64) float64 {\n\tn := len(sorted)\n\tif n == 1 {\n\t\treturn sorted[0]\n\t}\n\trank := p / 100 * float64(n-1)\n\tlower := int(math.Floor(rank))\n\tupper := int(math.Ceil(rank))\n\tif lower < 0 {\n\t\tlower = 0\n\t}\n\tif lower > n-1 {\n\t\tlower = n - 1\n\t}\n\tif upper < 0 {\n\t\tupper = 0\n\t}\n\tif upper > n-1 {\n\t\tupper = n - 1\n\t}\n\tfrac := rank - float64(lower)\n\treturn sorted[lower] + frac*(sorted[upper]-sorted[lower])\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
