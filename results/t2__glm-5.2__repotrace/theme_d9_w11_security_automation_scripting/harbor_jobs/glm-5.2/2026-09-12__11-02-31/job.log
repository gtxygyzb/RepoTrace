Sending keys: ['cat > diff.go <<\'EOF\'\npackage main\n\nimport (\n\t"bufio"\n\t"encoding/json"\n\t"fmt"\n\t"os"\n\t"sort"\n\t"strings"\n)\n\ntype diffReport struct {\n\tThreatCountDelta    int            `json:"threat_count_delta"`\n\tThreatCountPctChange float64        `json:"threat_count_pct_change"`\n\tRiskDelta           float64        `json:"risk_delta"`\n\tRiskPctChange       float64        `json:"risk_pct_change"`\n\tRiskTrend           string         `json:"risk_trend"`\n\tNewActors           []string       `json:"new_actors"`\n\tGoneActors          []string       `json:"gone_actors"`\n\tPersistentActors    []string       `json:"persistent_actors"`\n\tActorCountDeltas    map[string]int `json:"actor_count_deltas"`\n\tTypeShift           map[string]int `json:"type_shift"`\n\tCampaignDelta       int            `json:"campaign_delta"`\n\tRiskCategoryChange  diffCategory   `json:"risk_category_change"`\n\tEscalation          bool           `json:"escalation"`\n}\n\ntype diffCategory struct {\n\tFrom string `json:"from"`\n\tTo   string `json:"to"`\n}\n\nfunc runDiff(args []string) int {\n\treader := bufio.NewReader(os.Stdin)\n\n\tvar reports []aggregateReport\n\tfor {\n\t\tline, err := reader.ReadString(\'\\n\')\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif trimmed == "" {\n\t\t\tif err != nil {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\n\t\tvar report aggregateReport\n\t\tif jerr := json.Unmarshal([]byte(trimmed), &report); jerr != nil {\n\t\t\tfmt.Fprintln(os.Stderr, "error: malformed JSON input:", jerr)\n\t\t\treturn 2\n\t\t}\n\n\t\treports = append(reports, report)\n\t\tif len(reports) >= 2 {\n\t\t\tbreak\n\t\t}\n\n\t\tif err != nil {\n\t\t\tbreak\n\t\t}\n\t}\n\n\tif len(reports) < 2 {\n\t\tfmt.Fprintln(os.Stderr, "error: expected two aggregate JSON objects on stdin")\n\t\treturn 1\n\t}\n\n\tbaseline := reports[0]\n\tcurrent := reports[1]\n\n\treport := diffReport{\n\t\tThreatCountDelta: current.TotalThreats - baseline.TotalThreats,\n\t\tRiskDelta:        current.GlobalMeanRisk - baseline.GlobalMeanRisk,\n\t\tNewActors:        []string{},\n\t\tGoneActors:       []string{},\n\t\tPersistentActors: []string{},\n\t\tActorCountDeltas: map[string]int{},\n\t\tTypeShift:        map[string]int{},\n\t\tCampaignDelta:    current.TotalCampaigns - baseline.TotalCampaigns,\n\t\tRiskCategoryChange: diffCategory{\n\t\t\tFrom: baseline.GlobalRiskCategory,\n\t\t\tTo:   current.GlobalRiskCategory,\n\t\t},\n\t\tEscalation: riskCategoryRank(current.GlobalRiskCategory) > riskCategoryRank(baseline.GlobalRiskCategory),\n\t}\n\n\treport.ThreatCountPctChange = pctChange(report.ThreatCountDelta, baseline.TotalThreats)\n\treport.RiskPctChange = pctChangeFloat(report.RiskDelta, baseline.GlobalMeanRisk)\n\n\tswitch {\n\tcase report.RiskDelta > 0:\n\t\treport.RiskTrend = "increasing"\n\tcase report.RiskDelta < 0:\n\t\treport.RiskTrend = "decreasing"\n\tdefault:\n\t\treport.RiskTrend = "stable"\n\t}\n\n\tactors := make(map[string]struct{}, len(baseline.CombinedActorCounts)+len(current.CombinedActorCounts))\n\tfor actor := range baseline.CombinedActorCounts {\n\t\tactors[actor] = struct{}{}\n\t}\n\tfor actor := range current.CombinedActorCounts {\n\t\tactors[actor] = struct{}{}\n\t}\n\n\tfor actor := range actors {\n\t\tbaseCount := baseline.CombinedActorCounts[actor]\n\t\tcurCount := current.CombinedActorCounts[actor]\n\t\treport.ActorCountDeltas[actor] = curCount - baseCount\n\n\t\t_, inBase := baseline.CombinedActorCounts[actor]\n\t\t_, inCur := current.CombinedActorCounts[actor]\n\t\tif inBase && inCur {\n\t\t\treport.PersistentActors = append(report.PersistentActors, actor)\n\t\t} else if inCur {\n\t\t\treport.NewActors = append(report.NewActors, actor)\n\t\t} else {\n\t\t\treport.GoneActors = append(report.GoneActors, actor)\n\t\t}\n\t}\n\tsort.Strings(report.NewActors)\n\tsort.Strings(report.GoneActors)\n\tsort.Strings(report.PersistentActors)\n\n\ttypes := make(map[string]struct{}, len(baseline.TypeCounts)+len(current.TypeCounts))\n\tfor t := range baseline.TypeCounts {\n\t\ttypes[t] = struct{}{}\n\t}\n\tfor t := range current.TypeCounts {\n\t\ttypes[t] = struct{}{}\n\t}\n\tfor t := range types {\n\t\treport.TypeShift[t] = current.TypeCounts[t] - baseline.TypeCounts[t]\n\t}\n\n\tout, err := json.Marshal(report)\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, "error: encoding diff report:", err)\n\t\treturn 1\n\t}\n\tfmt.Println(string(out))\n\treturn 0\n}\n\nfunc pctChange(delta int, baseline int) float64 {\n\tif baseline == 0 {\n\t\tif delta > 0 {\n\t\t\treturn 100.0\n\t\t}\n\t\tif delta < 0 {\n\t\t\treturn -100.0\n\t\t}\n\t\treturn 0.0\n\t}\n\treturn round2(float64(delta) / float64(baseline) * 100.0)\n}\n\nfunc pctChangeFloat(delta float64, baseline float64) float64 {\n\tif baseline == 0 {\n\t\tif delta > 0 {\n\t\t\treturn 100.0\n\t\t}\n\t\tif delta < 0 {\n\t\t\treturn -100.0\n\t\t}\n\t\treturn 0.0\n\t}\n\treturn round2(delta / baseline * 100.0)\n}\n\nfunc riskCategoryRank(category string) int {\n\tswitch category {\n\tcase "low":\n\t\treturn 1\n\tcase "medium":\n\t\treturn 2\n\tcase "high":\n\t\treturn 3\n\tcase "critical":\n\t\treturn 4\n\tdefault:\n\t\treturn 0\n\t}\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
