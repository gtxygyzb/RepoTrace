ByFirstSeen(exploits)\n    sortThreatsByFirstSeen(exfils)\n\n    for _, ps := range portScans {\n        for _, ex := range exploits {\n            if !ex.firstTime.After(ps.firstTime) {\n                continue\n            }\n            for _, ef := range exfils {\n                if !ef.firstTime.After(ex.firstTime) {\n                    continue\n                }\n                stages := []string{ps.ThreatType, ex.ThreatType, ef.ThreatType}\n                first := ps.firstTime\n                last := ps.lastTime\n                if ex.firstTime.Before(first) {\n                    first = ex.firstTime\n                }\n                if ef.firstTime.Before(first) {\n                    first = ef.firstTime\n                }\n                if ex.lastTime.After(last) {\n                    last = ex.lastTime\n                }\n                if ef.lastTime.After(last) {\n                    last = ef.lastTime\n                }\n                return []Chain{{\n                    ChainType:      "recon_exploit_exfil",\n                    SourceIP:       ip,\n                    Stages:         stages,\n                    TotalRiskScore: ps.RiskScore + ex.RiskScore + ef.RiskScore,\n                    FirstSeen:      first.Format(time.RFC3339),\n                    LastSeen:       last.Format(time.RFC3339),\n                    firstTime:      first,\n                    lastTime:       last,\n                }}\n            }\n        }\n    }\n    return nil\n}\n\nfunc detectCredentialLateral(ip string, threats []Threat) []Chain {\n    var brute []Threat\n    var lateral []Threat\n    for _, t := range threats {\n        switch t.ThreatType {\n        case "brute_force":\n            brute = append(brute, t)\n        case "lateral_movement":\n            lateral = append(lateral, t)\n        }\n    }\n\n    sortThreatsByFirstSeen(brute)\n    sortThreatsByFirstSeen(lateral)\n\n    for _, b := range brute {\n        for _, l := range lateral {\