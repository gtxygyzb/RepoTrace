:= json.Unmarshal(data, &rules); err != nil {\n\t\treturn nil, err\n\t}\n\tfor i := range rules {\n\t\tif rules[i].Conditions.ActorPattern != nil && *rules[i].Conditions.ActorPattern != "" {\n\t\t\tre, err := regexp.Compile("^" + *rules[i].Conditions.ActorPattern + "$")\n\t\t\tif err != nil {\n\t\t\t\treturn nil, fmt.Errorf("invalid actor_pattern in rule %s: %w", rules[i].ID, err)\n\t\t\t}\n\t\t\trules[i].actorRegex = re\n\t\t}\n\t}\n\treturn rules, nil\n}\n\nfunc matchAlertRule(threat map[string]interface{}, rule alertRule) (bool, alertOutput) {\n\tthreatType, _ := getString(threat, "threat_type")\n\tsourceIP, _ := getString(threat, "source_ip")\n\tvar enrichedRisk float64\n\tif v, ok := getFloat(threat, "enriched_risk_score"); ok {\n\t\tenrichedRisk = v\n\t}\n\tiocSeverity, _ := getString(threat, "ioc_severity")\n\tactors, _ := getStringSlice(threat, "threat_actors")\n\tif actors == nil {\n\t\tactors = []string{}\n\t}\n\n\tif len(rule.Conditions.ThreatTypes) > 0 {\n\t\tif !containsString(rule.Conditions.ThreatTypes, threatType) {\n\t\t\treturn false, alertOutput{}\n\t\t}\n\t}\n\tif rule.Conditions.MinEnrichedRisk != nil {\n\t\tif enrichedRisk < *rule.Conditions.MinEnrichedRisk {\n\t\t\treturn false, alertOutput{}\n\t\t}\n\t}\n\tif rule.Conditions.MinSeverityRank != nil {\n\t\tif severityValue(iocSeverity) < *rule.Conditions.MinSeverityRank {\n\t\t\treturn false, alertOutput{}\n\t\t}\n\t}\n\n\tmatchedActors := actors\n\tif rule.actorRegex != nil {\n\t\tmatchedActors = []string{}\n\t\tfor _, actor := range actors {\n\t\t\tif rule.actorRegex.MatchString(actor) {\n\t\t\t\tmatchedActors = append(matchedActors, actor)\n\t\t\t}\n\t\t}\n\t\tif len(matchedActors) == 0 {\n\t\t\treturn false, alertOutput{}\n\t\t}\n\t}\n\tsort.Strings(matchedActors)\n\tif matchedActors == nil {\n\t\tmatchedActors = []string{}\n\t}\n\n\talert := alertOutput{\n\t\tRuleID:            rule.ID,\n\t\tRuleName:          rule.Name,\n\t\tAlertPriority:     float64(rule.Priority) * enrichedRisk,\n\t\tT