valid JSON lines on stdin")\n\t\treturn 1\n\t}\n\n\trisks := make([]float64, len(snapshots))\n\tthreats := make([]float64, len(snapshots))\n\tfor i, snap := range snapshots {\n\t\trisks[i] = snap.GlobalMeanRisk\n\t\tthreats[i] = float64(snap.TotalThreats)\n\t}\n\n\tvar anomalies []anomalyRecord\n\tfor i := 0; i < len(snapshots); i++ {\n\t\tstart := i - *window\n\t\tif start < 0 {\n\t\t\tstart = 0\n\t\t}\n\t\tbaseline := i - start\n\t\tif baseline < 2 {\n\t\t\tcontinue\n\t\t}\n\n\t\triskMean, riskStd := baselineStats(risks[start:i])\n\t\tthreatMean, threatStd := baselineStats(threats[start:i])\n\n\t\triskZ := zScore(risks[i], riskMean, riskStd)\n\t\tthreatZ := zScore(threats[i], threatMean, threatStd)\n\t\tcombinedZ := math.Sqrt(riskZ*riskZ + threatZ*threatZ)\n\n\t\tif combinedZ < *threshold {\n\t\t\tcontinue\n\t\t}\n\n\t\tdirection := "mixed"\n\t\tif riskZ >= 0 && threatZ >= 0 {\n\t\t\tdirection = "above"\n\t\t} else if riskZ <= 0 && threatZ <= 0 {\n\t\t\tdirection = "below"\n\t\t}\n\n\t\tseverity := "moderate"\n\t\tif combinedZ >= 4.0 {\n\t\t\tseverity = "extreme"\n\t\t} else if combinedZ >= 3.0 {\n\t\t\tseverity = "high"\n\t\t}\n\n\t\tanomalies = append(anomalies, anomalyRecord{\n\t\t\tIndex: i,\n\t\t\tMetrics: map[string]anomalyMetricResult{\n\t\t\t\t"global_mean_risk": {\n\t\t\t\t\tValue:          numberFromFloat(risks[i], false),\n\t\t\t\t\tBaselineMean:   json.Number(round4String(riskMean)),\n\t\t\t\t\tBaselineStddev: json.Number(round4String(riskStd)),\n\t\t\t\t\tZScore:         json.Number(round4String(riskZ)),\n\t\t\t\t},\n\t\t\t\t"total_threats": {\n\t\t\t\t\tValue:          numberFromFloat(threats[i], true),\n\t\t\t\t\tBaselineMean:   json.Number(round4String(threatMean)),\n\t\t\t\t\tBaselineStddev: json.Number(round4String(threatStd)),\n\t\t\t\t\tZScore:         json.Number(round4String(threatZ)),\n\t\t\t\t},\n\t\t\t},\n\t\t\tCombinedZ:     json.Number(round4String(combinedZ)),\n\t\t\tBaselineCount: baseline,\n\t\t\tDirection:     direction,\n\t\t\tSeverity:      severity,\n\t\t})\n\t}\n\n\tsort.SliceStable(anomalies, func(a, b int) bool {\n\t\taZ, _ := anomalies[a].CombinedZ.Float64()\n\t\tbZ, _ := anomalies[b].CombinedZ.Float64()\n\t\tif aZ != bZ {\n\t\t\treturn aZ > bZ\n\t\t}\n\t\treturn anomalies[a].Index < anomalies[b].Index\n\t})\n\n\tencoder := json.NewEncoder(os.Stdout)\n\tencoder.SetEscapeHTML(false)\n\tfor _, rec := range anomalies {\n\t\tif err := encoder.Encode(rec); err != nil {\n\t\t\tfmt.Fprintln(os.Stderr, "error: failed to write anomaly record:", err)\n\t\t\treturn 1\n\t\t}\n\t}\n\n\treturn 0\n}\n\nfunc baselineStats(values []float64) (float64, float64) {\n\tn := len(values)\n\tif n == 0 {\n\t\treturn 0, 0\n\t}\n\n\tsum := 0.0\n\tfor _, v := range values {\n\t\tsum += v\n\t}\n\tmean := sum / float64(n)\n\n\tsquaredSum := 0.0\n\tfor _, v := range values {\n\t\tdiff := v - mean\n\t\tsquaredSum += diff * diff\n\t}\n\tstddev := math.Sqrt(squaredSum / float64(n))\n\n\treturn mean, stddev\n}\n\nfunc zScore(current, mean, stddev float64) float64 {\n\tif stddev == 0 {\n\t\tif current == mean {\n\t\t\treturn 0.0\n\t\t}\n\t\tif current > mean {\n\t\t\treturn 999.0\n\t\t}\n\t\treturn -999.0\n\t}\n\treturn (current - mean) / stddev\n}\n\nfunc numberFromFloat(value float64, asInteger bool) json.Number {\n\tif asInteger {\n\t\treturn json.Number(fmt.Sprintf("%d", int64(value)))\n\t}\n\treturn json.Number(round4String(value))\n}\n\nfunc round4String(f float64) string {\n\treturn fmt.Sprintf("%.4f", round4(f))\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
