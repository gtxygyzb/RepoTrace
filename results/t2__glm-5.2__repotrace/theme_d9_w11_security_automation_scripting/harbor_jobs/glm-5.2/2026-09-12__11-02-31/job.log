Sending keys: ['cat > rate.go <<\'EOF\'\npackage main\n\nimport (\n        "bufio"\n        "encoding/json"\n        "fmt"\n        "math"\n        "os"\n        "strconv"\n)\n\ntype rateMetricResult struct {\n        MeanRate    json.Number `json:"mean_rate"`\n        MaxRate     json.Number `json:"max_rate"`\n        MinRate     json.Number `json:"min_rate"`\n        Volatility  json.Number `json:"volatility"`\n        Stability   string      `json:"stability"`\n        Deltas      []json.Number `json:"deltas"`\n}\n\ntype rateOutput struct {\n        InputCount       int                       `json:"input_count"`\n        StepCount        int                       `json:"step_count"`\n        Metrics          map[string]rateMetricResult `json:"metrics"`\n        OverallStability string                    `json:"overall_stability"`\n}\n\nfunc runRate(args []string) int {\n        fs := newFlagSet("rate")\n        minSnapshots := fs.Int("min-snapshots", 2, "minimum number of input snapshots")\n        if !parseFlags(fs, args) {\n                return 1\n        }\n        if *minSnapshots < 2 {\n                fmt.Fprintln(os.Stderr, "error: --min-snapshots must be at least 2")\n                return 1\n        }\n\n        var snapshots []forecastInputSnapshot\n        scanner := bufio.NewScanner(os.Stdin)\n        scanner.Buffer(make([]byte, 1024*1024), 1024*1024)\n        for scanner.Scan() {\n                line := scanner.Text()\n                if len(line) == 0 {\n                        continue\n                }\n                var snap forecastInputSnapshot\n                if err := json.Unmarshal([]byte(line), &snap); err != nil {\n                        fmt.Fprintf(os.Stderr, "error: malformed JSON input: %s\\n", err)\n                        return 2\n                }\n                snapshots = append(snapshots, snap)\n        }\n        if err := scanner.Err(); err != nil {\n                fmt.Fprintf(os.Stderr, "error: reading input: %s\\n", err)\n                return 1\n        }\n        if len(snapshots) < *minSnapshots {\n                fmt.Fprintf(os.Stderr, "error: at least %d valid input snapshots are required\\n", *minSnapshots)\n                return 1\n        }\n\n        riskDeltas := make([]float64, 0, len(snapshots)-1)\n        threatDeltas := make([]int, 0, len(snapshots)-1)\n        for i := 0; i < len(snapshots)-1; i++ {\n                riskDeltas = append(riskDeltas, snapshots[i+1].GlobalMeanRisk-snapshots[i].GlobalMeanRisk)\n                threatDeltas = append(threatDeltas, snapshots[i+1].TotalThreats-snapshots[i].TotalThreats)\n        }\n\n        metrics := map[string]rateMetricResult{\n                "global_mean_risk": buildRateMetric(riskDeltasAsNumbers(riskDeltas), true),\n                "total_threats":    buildRateMetric(threatDeltasAsNumbers(threatDeltas), false),\n        }\n\n        out := rateOutput{\n                InputCount:       len(snapshots),\n                StepCount:        len(riskDeltas),\n                Metrics:          metrics,\n                OverallStability: overallRateStability(metrics),\n        }\n\n        encoded, err := json.Marshal(out)\n        if err != nil {\n                fmt.Fprintln(os.Stderr, "error: encoding rate output:", err)\n                return 1\n        }\n        fmt.Println(string(encoded))\n        return 0\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
