     2	
     3	import (
     4		"bufio"
     5		"encoding/json"
     6		"fmt"
     7		"io"
     8		"os"
     9		"sort"
    10		"strings"
    11	)
    12	
    13	type aggregateSnapshot struct {
    14		TotalThreats       int            `json:"total_threats"`
    15		ActiveCampaigns    int            `json:"active_campaigns"`
    16		MeanEnrichedRisk   float64        `json:"mean_enriched_risk"`
    17		DominantThreatType string         `json:"dominant_threat_type"`
    18		ActorThreatCounts  map[string]int `json:"actor_threat_counts"`
    19	}
    20	
    21	type aggregateReport struct {
    22		SnapshotCount       int            `json:"snapshot_count"`
    23		TotalThreats        int            `json:"total_threats"`
    24		TotalCampaigns      int            `json:"total_campaigns"`
    25		GlobalMeanRisk      float64        `json:"global_mean_risk"`
    26		GlobalMaxMeanRisk   float64        `json:"global_max_mean_risk"`
    27		GlobalRiskCategory  string         `json:"global_risk_category"`
    28		CombinedActorCounts map[string]int `json:"combined_actor_counts"`
    29		TopActor            string         `json:"top_actor"`
    30		DominantThreatType  string         `json:"dominant_threat_type"`
    31		TypeCounts          map[string]int `json:"type_counts"`
    32	}
    33	
    34	func runAggregate(args []string) int {
    35		report := aggregateReport{
    36			CombinedActorCounts: map[string]int{},
    37			TypeCounts:          map[string]int{},
    38		}
    39	
    40		reader := bufio.NewReader(os.Stdin)
    41		weightedRiskSum := 0.0
    42		maxMeanRisk := 0.0
    43		dominantTypeCounts := map[string]int{}
    44		actorCounts := map[string]int{}
    45		snapshotCount := 0
    46	
    47		for {
    48			line, err := reader.ReadString('\n')
    49			trimmed := strings.TrimSpace(line)
    50			if trimmed == "" {
    51				if err == io.EOF {
    52					break
    53				}
    54				continue
    55			}
    56	
    57			var snap aggregateSnapshot
    58			if jerr := json.Unmarshal([]byte(trimmed), &snap); jerr != nil {
    59				fmt.Fprintln(os.Stderr, "error: malformed JSON input:", jerr)
    60				return 2
    61			}
    62	
    63			snapshotCount++
    64			report.TotalThreats += snap.TotalThreats
    65			report.TotalCampaigns += snap.ActiveCampaigns
    66			weightedRiskSum += snap.MeanEnrichedRisk * float64(snap.TotalThreats)
    67			if snap.MeanEnrichedRisk > maxMeanRisk {
    68				maxMeanRisk = snap.MeanEnrichedRisk
    69			}
    70			for actor, count := range snap.ActorThreatCounts {
    71				actorCounts[actor] += count
    72			}
    73			dominantType := snap.DominantThreatType
    74			dominantTypeCounts[dominantType]++
    75			report.TypeCounts[dominantType] += snap.TotalThreats
    76	
    77			if err == io.EOF {
    78				break
    79			}
    80		}
    81	
    82		report.SnapshotCount = snapshotCount
    83		if report.TotalThreats > 0 {
    84			report.GlobalMeanRisk = round2(weightedRiskSum / float64(report.TotalThreats))
    85		} else {
    86			report.GlobalMeanRisk = 0.0
    87		}
    88		report.GlobalMaxMeanRisk = round2(maxMeanRisk)
    89		report.GlobalRiskCategory = snapshotRiskCategory(report.GlobalMeanRisk)
    90		report.CombinedActorCounts = actorCounts
    91		report.TopActor = topActorFromCounts(actorCounts)
    92		report.DominantThreatType = topDominantType(dominantTypeCounts)
    93	
    94		if report.CombinedActorCounts == nil {
    95			report.CombinedActorCounts = map[string]int{}
    96		}
    97		if report.TypeCounts == nil {
    98			report.TypeCounts = map[string]int{}
    99		}
   100	
   101		out, err := json.Marshal(report)
   102		if err != nil {
   103			fmt.Fprintln(os.Stderr, "error: encoding aggregate report:", err)
   104			return 1
   105		}
   106		fmt.Println(string(out))
   107		return 0
   108	}
   109	
   110	func topActorFromCounts(counts map[string]int) string {
   111		actors := make([]string, 0, len(counts))
   112		for actor := range counts {
   113			actors = append(actors, actor)
   114		}
   115		sort.Strings(actors)
   116	
   117		topActor := ""
   118		maxCount := -1
   119		for _, actor := range actors {
   120			count := counts[actor]
   121			if count > maxCount {
   122				maxCount = count
   123				topActor = actor
   124			}
   125		}
   126		if maxCount < 0 {
   127			return ""
   128		}
   129		return topActor
   130	}
   131	
   132	func topDominantType(counts map[string]int) string {
   133		types := make([]string, 0, len(counts))
   134		for t := range counts {
   135			types = append(types, t)
   136		}
   137		sort.Strings(types)
   138	
   139		topType := ""
   140		maxCount := -1
   141		for _, t := range types {
   142			count := counts[t]
   143			if count > maxCount {
   144				maxCount = count
   145				topType = t
   146			}
   147		}
   148		if maxCount < 0 {
   149			return ""
   150		}
   151		return topType
   152	}
