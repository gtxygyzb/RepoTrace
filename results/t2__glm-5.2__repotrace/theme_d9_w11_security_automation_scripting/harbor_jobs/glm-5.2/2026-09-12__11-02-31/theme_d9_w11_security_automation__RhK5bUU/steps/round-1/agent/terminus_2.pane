[?2004lpackage main

import (
"bufio"
"encoding/json"
"fmt"
"os"
"regexp"
"sort"
"time"
)

type alertRule struct {
ID          string          `json:"id"`
Name        string          `json:"name"`
Priority    int             `json:"priority"`
Conditions  ruleConditions  `json:"conditions"`
actorRegex  *regexp.Regexp `json:"-"`
}

type ruleConditions struct {
ThreatTypes      []string `json:"threat_types"`
MinEnrichedRisk  *float64 `json:"min_enriched_risk"`
MinSeverityRank  *int     `json:"min_severity_rank"`
ActorPattern     *string  `json:"actor_pattern"`
}

type alertOutput struct {
RuleID            string   `json:"rule_id"`
RuleName          string   `json:"rule_name"`
AlertPriority     float64  `json:"alert_priority"`
ThreatType        string   `json:"threat_type"`
SourceIP          string   `json:"source_ip"`
EnrichedRiskScore float64  `json:"enriched_risk_score"`
IocSeverity       string   `json:"ioc_severity"`
ReferenceTime     string   `json:"reference_time"`
MatchedActors     []string `json:"matched_actors"`
}

type dedupEntry struct {
ruleID      string
sourceIP    string
refTime     time.Time
threat      map[string]interface{}
alert       alertOutput
rule        alertRule
emitted     bool
}

func runAlert(args []string) int {
fs := newFlagSet("alert")
rulesPath := fs.String("rules", "", "path to alert rules JSON file")
dedupWindow := fs.Int("dedup-window", 0, "deduplication window in minutes")
if !parseFlags(fs, args) {
return 1
}
if !isFlagSet(fs, "rules") || *rulesPath == "" {
fmt.Fprintln(os.Stderr, "error: --rules flag is required")
return 1
}

rules, err := loadAlertRules(*rulesPath)
if err != nil {
fmt.Fprintln(os.Stderr, err)
return 1
}

scanner := bufio.NewScanner(os.Stdin)
scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
w := bufio.NewWriter(os.Stdout)
defer w.Flush()
enc := json.NewEncoder(w)

var dedup []*dedupEntry
lineNo := 0
for scanner.Scan() {
lineNo++
line := scanner.Text()
if line == "" {
continue
}
var threat map[string]interface{}
if err := json.Unmarshal([]byte(line), &threat); err != nil {
fmt.Fprintf(os.Stderr, "line %d: %v\n", lineNo, err)
return 2
}

for _, rule := range rules {
matched, alert := matchAlertRule(threat, rule)
if !matched {
continue
}

if *dedupWindow > 0 {
now := alertReferenceTime(threat)
window := time.Duration(*dedupWindow) * time.Minute
existing := findDedupEntry(dedup, rule.ID, alert.SourceIP, now, window)
if existing != nil {
if alert.EnrichedRiskScore > existing.alert.EnrichedRiskScore {
existing.threat = threat
existing.alert = alert
existing.refTime = now
existing.rule = rule
}
continue
}
entry := &dedupEntry{
ruleID:      rule.ID,
sourceIP:    alert.SourceIP,
refTime:     now,
threat:      threat,
alert:       alert,
rule:        rule,
emitted:     false,
}
dedup = append(dedup, entry)
continue
}

if err := enc.Encode(alert); err != nil {
fmt.Fprintln(os.Stderr, err)
return 1
}
}
}
if err := scanner.Err(); err != nil {
fmt.Fprintln(os.Stderr, err)
return 1
}

if *dedupWindow > 0 {
for _, entry := range dedup {
if err := enc.Encode(entry.alert); err != nil {
fmt.Fprintln(os.Stderr, err)
return 1
}
}
}
return 0
}

func loadAlertRules(path string) ([]alertRule, error) {
data, err := os.ReadFile(path)
if err != nil {
return nil, err
}
var rules []alertRule
if err := json.Unmarshal(data, &rules); err != nil {
return nil, err
}
for i := range rules {
if rules[i].Conditions.ActorPattern != nil && *rules[i].Conditions.ActorPattern != "" {
re, err := regexp.Compile("^" + *rules[i].Conditions.ActorPattern + "$")
if err != nil {
return nil, fmt.Errorf("invalid actor_pattern in rule %s: %w", rules[i].ID, err)
}
rules[i].actorRegex = re
}
}
return rules, nil
}

func matchAlertRule(threat map[string]interface{}, rule alertRule) (bool, alertOutput) {
threatType, _ := getString(threat, "threat_type")
sourceIP, _ := getString(threat, "source_ip")
var enrichedRisk float64
if v, ok := getFloat(threat, "enriched_risk_score"); ok {
enrichedRisk = v
}
iocSeverity, _ := getString(threat, "ioc_severity")
actors, _ := getStringSlice(threat, "threat_actors")
if actors == nil {
actors = []string{}
}

if len(rule.Conditions.ThreatTypes) > 0 {
if !containsString(rule.Conditions.ThreatTypes, threatType) {
return false, alertOutput{}
}
}
if rule.Conditions.MinEnrichedRisk != nil {
if enrichedRisk < *rule.Conditions.MinEnrichedRisk {
return false, alertOutput{}
}
}
if rule.Conditions.MinSeverityRank != nil {
if severityValue(iocSeverity) < *rule.Conditions.MinSeverityRank {
return false, alertOutput{}
}
}

matchedActors := actors
if rule.actorRegex != nil {
matchedActors = []string{}
for _, actor := range actors {
if rule.actorRegex.MatchString(actor) {
matchedActors = append(matchedActors, actor)
}
}
if len(matchedActors) == 0 {
return false, alertOutput{}
}
}
sort.Strings(matchedActors)
if matchedActors == nil {
matchedActors = []string{}
}

alert := alertOutput{
RuleID:            rule.ID,
RuleName:          rule.Name,
AlertPriority:     float64(rule.Priority) * enrichedRisk,
ThreatType:        threatType,
SourceIP:          sourceIP,
EnrichedRiskScore: enrichedRisk,
IocSeverity:       iocSeverity,
ReferenceTime:     alertReferenceTimeString(threat),
MatchedActors:     matchedActors,
}
return true, alert
}

func findDedupEntry(entries []*dedupEntry, ruleID, sourceIP string, now time.Time, window time.Duration) *dedupEntry {
for _, e := range entries {
if e.ruleID != ruleID || e.sourceIP != sourceIP {
continue
}
if !e.refTime.Before(now.Add(-window)) && !e.refTime.After(now.Add(window)) {
return e
}
}
return nil
}

func alertReferenceTime(threat map[string]interface{}) time.Time {
if ts, ok := getString(threat, "reference_time"); ok {
if t, err := parseTime(ts); err == nil {
return t
}
}
return threatReferenceTime(threat)
}

func alertReferenceTimeString(threat map[string]interface{}) string {
if ts, ok := getString(threat, "reference_time"); ok {
return ts
}
t := threatReferenceTime(threat)
if t.IsZero() {
return ""
}
return t.UTC().Format(time.RFC3339)
}

func containsString(list []string, s string) bool {
for _, item := range list {
if item == s {
return true
}
}
