[?2004lpackage main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"sort"
	"time"
)

type timelineBucket struct {
	BucketStart       string                   `json:"bucket_start"`
	BucketEnd         string                   `json:"bucket_end"`
	ThreatCount       int                      `json:"threat_count"`
	AvgRisk           float64                  `json:"avg_risk"`
	MaxRisk           float64                  `json:"max_risk"`
	MinRisk           float64                  `json:"min_risk"`
	RiskStdDev        float64                  `json:"risk_std_dev"`
	DominantType      string                   `json:"dominant_type"`
	TypeDistribution  map[string]int           `json:"type_distribution"`
	UniqueActors      []string                 `json:"unique_actors"`
	SeverityHistogram map[string]int           `json:"severity_histogram"`
	EscalationIndex   float64                  `json:"escalation_index"`
	RiskTrend         float64                  `json:"risk_trend"`
	BurstScore        float64                  `json:"burst_score"`
	TopThreats        []map[string]interface{} `json:"top_threats"`
}

func runTimeline(args []string) int {
	fs := newFlagSet("timeline")
	bucketMinutes := fs.Int("bucket-minutes", 0, "width of each time bucket in minutes")
	topN := fs.Int("top-n", 3, "maximum number of top threats to include per bucket")
	if !parseFlags(fs, args) {
		return 1
	}
	if !isFlagSet(fs, "bucket-minutes") {
		fmt.Fprintln(os.Stderr, "missing required flag: --bucket-minutes")
		return 1
	}
	if *bucketMinutes <= 0 {
		fmt.Fprintf(os.Stderr, "invalid --bucket-minutes: must be a positive integer\n")
		return 1
	}
	if *topN < 0 {
		fmt.Fprintf(os.Stderr, "invalid --top-n: must be non-negative\n")
		return 1
	}

	scanner := bufio.NewScanner(os.Stdin)
	scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
	lineNo := 0
	var threats []map[string]interface{}
	for scanner.Scan() {
		lineNo++
		line := scanner.Text()
		if line == "" {
			continue
		}
		var threat map[string]interface{}
		if err := json.Unmarshal([]byte(line), &threat); err != nil {
			fmt.Fprintf(os.Stderr, "line %d: %v\n", lineNo, err)
			return 2
		}
		threats = append(threats, threat)
	}
	if err := scanner.Err(); err != nil {
		fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
		return 2
	}

	bucketSeconds := int64(*bucketMinutes) * 60
	buckets := make(map[int64][]map[string]interface{})
	var bucketStarts []int64
	for _, threat := range threats {
		refTime := threatSortTime(threat)
		var refUnix int64
		if !refTime.IsZero() {
			refUnix = refTime.Unix()
		}
		start := refUnix - ((refUnix%bucketSeconds)+bucketSeconds)%bucketSeconds
		if _, ok := buckets[start]; !ok {
			bucketStarts = append(bucketStarts, start)
		}
		buckets[start] = append(buckets[start], threat)
	}

	sort.Slice(bucketStarts, func(i, j int) bool { return bucketStarts[i] < bucketStarts[j] })

	writer := bufio.NewWriter(os.Stdout)
	defer writer.Flush()

	for _, start := range bucketStarts {
		bucketThreats := buckets[start]
		startTime := time.Unix(start, 0).UTC()
		endTime := startTime.Add(time.Duration(*bucketMinutes) * time.Minute)
		b := buildTimelineBucket(bucketThreats, startTime, endTime, *bucketMinutes, *topN)
		data, err := json.Marshal(b)
		if err != nil {
			fmt.Fprintf(os.Stderr, "error marshalling bucket: %v\n", err)
			return 2
		}
		writer.Write(data)
		writer.WriteByte('\n')
	}

	return 0
}

func buildTimelineBucket(threats []map[string]interface{}, startTime time.Time, endTime time.Time, bucketMinutes int, topN int) timelineBucket {
	n := len(threats)
	b := timelineBucket{
		BucketStart:       startTime.Format(time.RFC3339),
		BucketEnd:         endTime.Format(time.RFC3339),
		ThreatCount:       n,
		TypeDistribution:  map[string]int{},
		SeverityHistogram: map[string]int{"none": 0, "low": 0, "medium": 0, "high": 0, "critical": 0},
		UniqueActors:      []string{},
		TopThreats:        []map[string]interface{}{},
	}

	if n == 0 {
		return b
	}

	var sumRisk, maxRisk, minRisk float64
	typeCounts := map[string]int{}
	actorSet := map[string]bool{}
	risks := make([]float64, 0, n)
	for i, threat := range threats {
		risk, _ := getFloat(threat, "enriched_risk_score")
		risks = append(risks, risk)
		sumRisk += risk
		if i == 0 {
			maxRisk = risk
			minRisk = risk
		} else {
			if risk > maxRisk {
				maxRisk = risk
			}
			if risk < minRisk {
				minRisk = risk
			}
		}
		if tt, ok := getString(threat, "threat_type"); ok {
			typeCounts[tt]++
		}
		if sev, ok := getString(threat, "ioc_severity"); ok {
			if _, exists := b.SeverityHistogram[sev]; exists {
				b.SeverityHistogram[sev]++
			}
		}
		if actors, ok := getStringSlice(threat, "threat_actors"); ok {
			for _, actor := range actors {
				if actor != "" {
					actorSet[actor] = true
				}
			}
		}
	}
	b.AvgRisk = round2(sumRisk / float64(n))
	b.MaxRisk = maxRisk
	b.MinRisk = minRisk

	mean := sumRisk / float64(n)
	var variance float64
	for _, risk := range risks {
		diff := risk - mean
		variance += diff * diff
	}
	if n == 1 {
		variance = 0.0
	} else {
		variance /= float64(n)
	}
	b.RiskStdDev = round2(math.Sqrt(variance))

	b.DominantType = dominantThreatType(typeCounts)
	b.TypeDistribution = typeCounts

	b.UniqueActors = nonNilStrings(sortedUniqueStringsFromSet(actorSet))

	b.EscalationIndex = round3(timelineEscalationIndex(threats))
	b.RiskTrend = round3(timelineRiskTrend(threats, startTime))
	b.BurstScore = round3(timelineBurstScore(threats))

	sortedTop := make([]map[string]interface{}, len(threats))
	copy(sortedTop, threats)
	sort.SliceStable(sortedTop, func(i, j int) bool {
		ri, _ := getFloat(sortedTop[i], "enriched_risk_score")
		rj, _ := getFloat(sortedTop[j], "enriched_risk_score")
		if ri != rj {
			return ri > rj
		}
		ti, tj := threatSortTime(sortedTop[i]), threatSortTime(sortedTop[j])
		if !ti.Equal(tj) {
			return ti.Before(tj)
		}
		tta, _ := getString(sortedTop[i], "threat_type")
		ttb, _ := getString(sortedTop[j], "threat_type")
		return tta < ttb
	})
	if topN < len(sortedTop) {
		sortedTop = sortedTop[:topN]
	}
	b.TopThreats = sortedTop

	return b
}

func dominantThreatType(counts map[string]int) string {
	var keys []string
	for k := range counts {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	dominant := ""
	maxCount := -1
	for _, k := range keys {
		if counts[k] > maxCount {
			maxCount = counts[k]
			dominant = k
		}
	}
	return dominant
}

func timelineSeverityRank(sev string) int {
	switch sev {
	case "none":
		return 0
	case "low":
		return 1
	case "medium":
		return 2
	case "high":
		return 3
	case "critical":
		return 4
	default:
		return -1
	}
}

func timelineEscalationIndex(threats []map[string]interface{}) float64 {
	n := len(threats)
	if n < 2 {
		return 0.0
	}
	ordered := make([]map[string]interface{}, len(threats))
	copy(ordered, threats)
	sort.SliceStable(ordered, func(i, j int) bool {
		ti, tj := threatSortTime(ordered[i]), threatSortTime(ordered[j])
		if !ti.Equal(tj) {
			return ti.Before(tj)
		}
		tta, _ := getString(ordered[i], "threat_type")
		ttb, _ := getString(ordered[j], "threat_type")
		return tta < ttb
[?2004hroot@n30009:/app# sed -n '1,300p' correlate.go
[?2004lpackage main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"os"
	"sort"
	"time"
)

type correlateThreat struct {
	obj        map[string]interface{}
	ref        time.Time
	actors     []string
	risk       float64
	threatType string
	severity   string
}

type correlateCampaign struct {
	CampaignID       string                   `json:"campaign_id"`
	ThreatCount      int                      `json:"threat_count"`
	ThreatTypes      []string                 `json:"threat_types"`
	SharedActors     []string                 `json:"shared_actors"`
	AllActors        []string                 `json:"all_actors"`
	CombinedRisk     float64                  `json:"combined_risk"`
	DirectLinkCount  int                      `json:"direct_link_count"`
	Cohesion         float64                  `json:"cohesion"`
	PropagationScore float64                  `json:"propagation_score"`
	MaxSeverity      string                   `json:"max_severity"`
	TimeSpanMinutes  float64                  `json:"time_span_minutes"`
	Earliest         string                   `json:"earliest"`
	Latest           string                   `json:"latest"`
	Threats          []map[string]interface{} `json:"threats"`

	earliestTime  time.Time
	minThreatType string
}

func runCorrelate(args []string) int {
	fs := newFlagSet("correlate")
	timeWindow := fs.Int("time-window", 0, "maximum temporal distance in minutes for two threats to be linkable")
	minCampaignSize := fs.Int("min-campaign-size", 2, "minimum number of threats in a campaign to output")
	if !parseFlags(fs, args) {
		return 1
	}
	if !isFlagSet(fs, "time-window") {
		fmt.Fprintln(os.Stderr, "error: --time-window flag is required")
		return 1
	}

	window := time.Duration(*timeWindow) * time.Minute

	scanner := bufio.NewScanner(os.Stdin)
	scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
	threats := make([]correlateThreat, 0)
	lineNo := 0
	for scanner.Scan() {
		lineNo++
		line := scanner.Text()
		if line == "" {
			continue
		}
		var obj map[string]interface{}
		if err := json.Unmarshal([]byte(line), &obj); err != nil {
			fmt.Fprintf(os.Stderr, "line %d: %v\n", lineNo, err)
			return 2
		}
		ct := correlateThreat{
			obj: obj,
			ref: threatReferenceTime(obj),
		}
		if actors, ok := getStringSlice(obj, "threat_actors"); ok {
			ct.actors = actors
		} else {
			ct.actors = []string{}
		}
		if r, ok := getFloat(obj, "enriched_risk_score"); ok {
			ct.risk = r
		}
		if tt, ok := getString(obj, "threat_type"); ok {
			ct.threatType = tt
		}
		if sev, ok := getString(obj, "ioc_severity"); ok {
			ct.severity = sev
		}
		threats = append(threats, ct)
	}
	if err := scanner.Err(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	n := len(threats)
	linked := make([][]bool, n)
	for i := range linked {
		linked[i] = make([]bool, n)
	}
	for i := 0; i < n; i++ {
		if len(threats[i].actors) == 0 {
			continue
		}
		for j := i + 1; j < n; j++ {
			if len(threats[j].actors) == 0 {
				continue
			}
			if absDuration(threats[i].ref.Sub(threats[j].ref)) <= window && sharedActorCount(threats[i].actors, threats[j].actors) > 0 {
				linked[i][j] = true
				linked[j][i] = true
			}
		}
	}

	visited := make([]bool, n)
	var campaigns []correlateCampaign
	for start := 0; start < n; start++ {
		if visited[start] {
			continue
		}
		queue := []int{start}
		visited[start] = true
		component := []int{start}
		for len(queue) > 0 {
			cur := queue[0]
			queue = queue[1:]
			for next := 0; next < n; next++ {
				if !visited[next] && linked[cur][next] {
					visited[next] = true
					queue = append(queue, next)
					component = append(component, next)
				}
			}
		}
		if len(component) < *minCampaignSize {
			continue
		}
		campaigns = append(campaigns, buildCorrelateCampaign(threats, component, linked))
	}

	sort.SliceStable(campaigns, func(i, j int) bool {
		if !campaigns[i].earliestTime.Equal(campaigns[j].earliestTime) {
			return campaigns[i].earliestTime.Before(campaigns[j].earliestTime)
		}
		return campaigns[i].minThreatType < campaigns[j].minThreatType
	})
	for i := range campaigns {
		campaigns[i].CampaignID = fmt.Sprintf("CAMP-%03d", i+1)
	}

	sort.SliceStable(campaigns, func(i, j int) bool {
		if campaigns[i].CombinedRisk != campaigns[j].CombinedRisk {
			return campaigns[i].CombinedRisk > campaigns[j].CombinedRisk
		}
		if campaigns[i].Cohesion != campaigns[j].Cohesion {
			return campaigns[i].Cohesion > campaigns[j].Cohesion
		}
		return campaigns[i].CampaignID < campaigns[j].CampaignID
	})

	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	enc := json.NewEncoder(w)
	for _, c := range campaigns {
		if err := enc.Encode(c); err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 1
		}
	}
	return 0
}

func buildCorrelateCampaign(threats []correlateThreat, indices []int, linked [][]bool) correlateCampaign {
	c := correlateCampaign{
		ThreatCount:  len(indices),
		ThreatTypes:  []string{},
		SharedActors: []string{},
		AllActors:    []string{},
		Threats:      []map[string]interface{}{},
	}

	typeSet := make(map[string]bool)
	actorSet := make(map[string]bool)
	for _, idx := range indices {
		typeSet[threats[idx].threatType] = true
		for _, actor := range threats[idx].actors {
			actorSet[actor] = true
		}
	}
	c.ThreatTypes = sortedKeys(typeSet)
	c.AllActors = sortedUniqueStringsFromSet(actorSet)

	if len(indices) > 0 {
		shared := make(map[string]bool)
		for _, actor := range threats[indices[0]].actors {
			shared[actor] = true
		}
		for _, idx := range indices[1:] {
			next := make(map[string]bool)
			for _, actor := range threats[idx].actors {
				if shared[actor] {
					next[actor] = true
				}
			}
			shared = next
		}
		c.SharedActors = sortedUniqueStringsFromSet(shared)
	}

	directLinkCount := 0
	for ii, i := range indices {
		for jj := ii + 1; jj < len(indices); jj++ {
			if linked[i][indices[jj]] {
				directLinkCount++
			}
		}
	}
	c.DirectLinkCount = directLinkCount
	if c.ThreatCount > 1 {
		c.Cohesion = float64(directLinkCount) / (float64(c.ThreatCount*(c.ThreatCount-1)) / 2.0)
	} else {
		c.Cohesion = 0.0
	}

	propagationScore := 0.0
	for ii, i := range indices {
		for jj := ii + 1; jj < len(indices); jj++ {
			j := indices[jj]
			if !linked[i][j] {
				continue
			}
			sharedCount := sharedActorCount(threats[i].actors, threats[j].actors)
			multiplier := 0.05
			if sharedCount >= 2 {
				multiplier = 0.1
			}
			propagationScore += (threats[i].risk + threats[j].risk) * multiplier
		}
	}
	c.PropagationScore = propagationScore

	maxSeverity := "none"
	for _, idx := range indices {
		if correlateSeverityRank(threats[idx].severity) > correlateSeverityRank(maxSeverity) {
			maxSeverity = threats[idx].severity
		}
	}
	c.MaxSeverity = maxSeverity

	earliest := threats[indices[0]].ref
	latest := earliest
	for _, idx := range indices[1:] {
		if threats[idx].ref.Before(earliest) {
			earliest = threats[idx].ref
		}
		if threats[idx].ref.After(latest) {
			latest = threats[idx].ref
		}
	}
	c.earliestTime = earliest
	c.Earliest = earliest.Format(time.RFC3339)
	c.Latest = latest.Format(time.RFC3339)
	c.TimeSpanMinutes = latest.Sub(earliest).Seconds() / 60.0

	combinedRisk := 0.0
	minThreatType := ""
	for _, idx := range indices {
		combinedRisk += threats[idx].risk
		tt := threats[idx].threatType
		if minThreatType == "" || tt < minThreatType {
			minThreatType = tt
		}
	}
	c.CombinedRisk = combinedRisk
	c.minThreatType = minThreatType

	sortedIndices := make([]int, len(indices))
	copy(sortedIndices, indices)
	sort.SliceStable(sortedIndices, func(a, b int) bool {
		ta := threats[sortedIndices[a]]
		tb := threats[sortedIndices[b]]
		if ta.risk != tb.risk {
			return ta.risk > tb.risk
		}
		if !ta.ref.Equal(tb.ref) {
			return ta.ref.Before(tb.ref)
		}
		return ta.threatType < tb.threatType
	})
	c.Threats = make([]map[string]interface{}, 0, len(sortedIndices))
	for _, idx := range sortedIndices {
		c.Threats = append(c.Threats, threats[idx].obj)
	}

	return c
}

