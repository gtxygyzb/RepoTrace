   446		}
   447	
   448		sort.SliceStable(matches, func(i, j int) bool {
   449			if matches[i].adjusted != matches[j].adjusted {
   450				return matches[i].adjusted > matches[j].adjusted
   451			}
   452			return matches[i].p.entry.ID < matches[j].p.entry.ID
   453		})
   454		return matches
   455	}
   456	
   457	func computeFreshness(p processedIOC, refTime time.Time) (float64, float64, bool) {
   458		ageHours := refTime.Sub(p.lastUpdated).Hours()
   459		freshnessFraction := ageHours / float64(p.ttlHours)
   460		if freshnessFraction >= 1.0 {
   461			return 0, 0, false
   462		}
   463		factor := freshnessFactor(freshnessFraction)
   464		return p.entry.Confidence * factor, factor, true
   465	}
   466	
   467	func freshnessFactor(fraction float64) float64 {
   468		switch {
   469		case fraction < 0.25:
   470			return 1.0
   471		case fraction < 0.50:
   472			return 0.9
   473		case fraction < 0.75:
   474			return 0.7
   475		default:
   476			return 0.5
   477		}
   478	}
   479	
   480	func fieldMultiplier(field string) float64 {
   481		switch field {
   482		case "source_ip", "dest_ip", "compromised_hosts", "user":
   483			return 1.0
   484		case "dest_ips", "target_users":
   485			return 0.8
   486		case "ports_scanned":
   487			return 0.6
   488		default:
   489			return 0.0
   490		}
   491	}
   492	
   493	func maxFieldMultiplier(fields []string) float64 {
   494		max := 0.0
   495		for _, f := range fields {
   496			if m := fieldMultiplier(f); m > max {
   497				max = m
   498			}
   499		}
   500		return max
   501	}
   502	
   503	func tagBonusValue(tag string) float64 {
   504		switch tag {
   505		case "apt":
   506			return 100.0
   507		case "ransomware":
   508			return 75.0
   509		case "botnet":
   510			return 50.0
   511		case "phishing":
   512			return 30.0
   513		case "scanner":
   514			return 25.0
   515		case "cryptominer":
   516			return 20.0
   517		default:
   518			return 0.0
   519		}
   520	}
   521	
   522	func severityWeight(s string) int {
   523		switch s {
   524		case "low":
   525			return 5
   526		case "medium":
   527			return 10
   528		case "high":
   529			return 20
   530		case "critical":
   531			return 40
   532		default:
   533			return 0
   534		}
   535	}
   536	
   537	func severityFromRank(rank int) string {
   538		switch rank {
