[?2004lpackage main

import (
	"flag"
	"fmt"
	"os"
)

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot> [flags]")
		os.Exit(1)
	}

	var code int
	switch os.Args[1] {
	case "analyze":
		code = runAnalyze(os.Args[2:])
	case "summarize":
		code = runSummarize(os.Args[2:])
	case "filter":
		code = runFilter(os.Args[2:])
	case "respond":
		code = runRespond(os.Args[2:])
	case "enrich":
		code = runEnrich(os.Args[2:])
	case "correlate":
		code = runCorrelate(os.Args[2:])
	case "timeline":
		code = runTimeline(os.Args[2:])
	case "snapshot":
		code = runSnapshot(os.Args[2:])
	default:
		fmt.Fprintf(os.Stderr, "invalid subcommand: %s\n", os.Args[1])
		code = 1
	}
	os.Exit(code)
}

func newFlagSet(name string) *flag.FlagSet {
	fs := flag.NewFlagSet(name, flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	fs.Usage = func() {}
	return fs
}

func parseFlags(fs *flag.FlagSet, args []string) bool {
	if err := fs.Parse(args); err != nil {
		return false
	}
	return true
}

func isFlagSet(fs *flag.FlagSet, name string) bool {
	set := false
	fs.Visit(func(f *flag.Flag) {
		if f.Name == name {
			set = true
		}
	})
	return set
}
[?2004hroot@n30009:/app# sed -n '1,200p' event.go
[?2004lpackage main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"os"
	"sort"
	"time"
)

type Event struct {
	Timestamp   string            `json:"timestamp"`
	SourceIP    string            `json:"source_ip"`
	DestIP      string            `json:"dest_ip"`
	DestPort    int               `json:"dest_port"`
	Protocol    string            `json:"protocol"`
	Action      string            `json:"action"`
	EventType   string            `json:"event_type"`
	User        string            `json:"user"`
	Severity    string            `json:"severity"`
	PayloadSize int64             `json:"payload_size"`
	Metadata    map[string]string `json:"metadata"`
}

var severityMap = map[string]int{
	"low":      1,
	"medium":   2,
	"high":     3,
	"critical": 4,
}

func severityValue(s string) int {
	return severityMap[s]
}

func parseEvent(line string) (Event, error) {
	var e Event
	if err := json.Unmarshal([]byte(line), &e); err != nil {
		return e, err
	}
	return e, nil
}

func parseTime(ts string) (time.Time, error) {
	t, err := time.Parse(time.RFC3339, ts)
	if err != nil {
		return time.Time{}, fmt.Errorf("invalid timestamp %q: %w", ts, err)
	}
	return t, nil
}

func readEvents() ([]Event, error) {
	scanner := bufio.NewScanner(os.Stdin)
	scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
	var events []Event
	lineNo := 0
	for scanner.Scan() {
		lineNo++
		line := scanner.Text()
		if line == "" {
			continue
		}
		e, err := parseEvent(line)
		if err != nil {
			return events, fmt.Errorf("line %d: %w", lineNo, err)
		}
		events = append(events, e)
	}
	if err := scanner.Err(); err != nil {
		return events, err
	}
	return events, nil
}

func sortEventsByTime(events []Event) {
	sort.SliceStable(events, func(i, j int) bool {
		return events[i].Timestamp < events[j].Timestamp
	})
}

func uniqueSortedStrings(input []string) []string {
	seen := make(map[string]bool)
	var out []string
	for _, s := range input {
		if !seen[s] {
			seen[s] = true
			out = append(out, s)
		}
	}
	sort.Strings(out)
	return out
}

func uniqueSortedInts(input []int) []int {
	seen := make(map[int]bool)
	var out []int
	for _, n := range input {
		if !seen[n] {
			seen[n] = true
			out = append(out, n)
		}
	}
	sort.Ints(out)
	return out
}

func round2(f float64) float64 {
	return float64(int64(f*100+0.5)) / 100
}
