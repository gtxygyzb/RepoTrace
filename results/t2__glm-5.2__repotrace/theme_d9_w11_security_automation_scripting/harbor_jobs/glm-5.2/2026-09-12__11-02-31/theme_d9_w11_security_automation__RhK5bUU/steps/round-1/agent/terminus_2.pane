    88			risks[i] = snap.GlobalMeanRisk
    89			threats[i] = float64(snap.TotalThreats)
    90		}
    91	
    92		var anomalies []anomalyRecord
    93		for i := 0; i < len(snapshots); i++ {
    94			start := i - *window
    95			if start < 0 {
    96				start = 0
    97			}
    98			baselineCount := i - start
    99			if baselineCount < 2 {
   100				continue
   101			}
   102	
   103			riskMean, riskStd := baselineStats(risks[start:i])
   104			threatMean, threatStd := baselineStats(threats[start:i])
   105	
   106			riskZ := zScore(risks[i], riskMean, riskStd)
   107			threatZ := zScore(threats[i], threatMean, threatStd)
   108			combinedZ := math.Sqrt(riskZ*riskZ + threatZ*threatZ)
   109			roundedCombinedZ := roundHalfUp4(combinedZ)
   110	
   111			if combinedZ < *threshold {
   112				continue
   113			}
   114	
   115			direction := "mixed"
   116			if riskZ >= 0 && threatZ >= 0 {
   117				direction = "above"
   118			} else if riskZ <= 0 && threatZ <= 0 {
   119				direction = "below"
   120			}
   121	
   122			severity := "low"
   123			if combinedZ >= 4.0 {
   124				severity = "extreme"
   125			} else if combinedZ >= 3.0 {
   126				severity = "high"
   127			} else if combinedZ >= 2.0 {
   128				severity = "moderate"
   129			}
   130	
   131			anomalies = append(anomalies, anomalyRecord{
   132				Index: i,
   133				Metrics: anomalyMetrics{
   134					GlobalMeanRisk: anomalyMetricResult{
   135						Value:          json.Number(formatRiskValue(risks[i])),
   136						BaselineMean:   json.Number(format4(riskMean)),
   137						BaselineStddev: json.Number(format4(riskStd)),
   138						ZScore:         json.Number(format4(riskZ)),
   139					},
   140					TotalThreats: anomalyMetricResult{
   141						Value:          json.Number(strconv.FormatInt(int64(threats[i]), 10)),
   142						BaselineMean:   json.Number(format4(threatMean)),
   143						BaselineStddev: json.Number(format4(threatStd)),
   144						ZScore:         json.Number(format4(threatZ)),
   145					},
   146				},
   147				CombinedZ:        json.Number(format4(combinedZ)),
   148				BaselineCount:    baselineCount,
   149				Direction:        direction,
   150				Severity:         severity,
   151				roundedCombinedZ: roundedCombinedZ,
   152			})
   153		}
   154	
   155		sort.SliceStable(anomalies, func(a, b int) bool {
   156			if anomalies[a].roundedCombinedZ != anomalies[b].roundedCombinedZ {
   157				return anomalies[a].roundedCombinedZ > anomalies[b].roundedCombinedZ
   158			}
   159			return anomalies[a].Index < anomalies[b].Index
   160		})
   161	
   162		encoder := json.NewEncoder(os.Stdout)
   163		encoder.SetEscapeHTML(false)
   164		for _, rec := range anomalies {
   165			if err := encoder.Encode(rec); err != nil {
   166				fmt.Fprintln(os.Stderr, "error: failed to write anomaly record:", err)
   167				return 1
   168			}
   169		}
   170	
   171		return 0
   172	}
   173	
   174	func baselineStats(values []float64) (float64, float64) {
   175		n := len(values)
   176		if n == 0 {
   177			return 0, 0
   178		}
   179	
   180		sum := 0.0
   181		for _, v := range values {
   182			sum += v
   183		}
   184		mean := sum / float64(n)
   185	
   186		squaredSum := 0.0
   187		for _, v := range values {
   188			diff := v - mean
   189			squaredSum += diff * diff
   190		}
   191		stddev := math.Sqrt(squaredSum / float64(n))
   192	
   193		return mean, stddev
   194	}
   195	
   196	func zScore(current, mean, stddev float64) float64 {
   197		if stddev == 0 {
   198			if current == mean {
   199				return 0.0
   200			}
   201			if current > mean {
   202				return 999.0
   203			}
   204			return -999.0
   205		}
   206		return (current - mean) / stddev
   207	}
   208	
   209	func roundHalfUp4(f float64) float64 {
   210		pow := 10000.0
   211		return math.Copysign(math.Floor(math.Abs(f)*pow+0.5)/pow, f)
   212	}
   213	
   214	func format4(f float64) string {
   215		rounded := roundHalfUp4(f)
   216		if rounded == 0 {
   217			return "0.0000"
   218		}
   219		return fmt.Sprintf("%.4f", rounded)
   220	}
   221	
   222	func formatRiskValue(f float64) string {
   223		s := strconv.FormatFloat(f, 'f', -1, 64)
   224		if !strings.Contains(s, ".") {
   225			s += ".0"
   226		}
   227		return s
   228	}
