[?2004lpackage main

import (
	"flag"
	"fmt"
	"os"
)

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: secsentinel <analyze|summarize|filter|respond> [flags]")
		os.Exit(1)
	}

	var code int
	switch os.Args[1] {
	case "analyze":
		code = runAnalyze(os.Args[2:])
	case "summarize":
		code = runSummarize(os.Args[2:])
	case "filter":
		code = runFilter(os.Args[2:])
	case "respond":
		code = runRespond(os.Args[2:])
	default:
		fmt.Fprintf(os.Stderr, "invalid subcommand: %s\n", os.Args[1])
		code = 1
	}
	os.Exit(code)
}

func newFlagSet(name string) *flag.FlagSet {
	fs := flag.NewFlagSet(name, flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	fs.Usage = func() {}
	return fs
}

func parseFlags(fs *flag.FlagSet, args []string) bool {
	if err := fs.Parse(args); err != nil {
		return false
	}
	return true
}

func isFlagSet(fs *flag.FlagSet, name string) bool {
	set := false
	fs.Visit(func(f *flag.Flag) {
		if f.Name == name {
			set = true
		}
	})
	return set
}
[?2004hroot@n30009:/app# sed -n '1,260p' analyze.go
[?2004lpackage main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"os"
)

func runAnalyze(args []string) int {
	fs := newFlagSet("analyze")
	chain := fs.Bool("chain", false, "perform attack chain correlation")
	if !parseFlags(fs, args) {
		return 1
	}

	events, err := readEvents()
	if err != nil {
		threats := detectThreats(events)
		outputThreats(threats)
		if *chain {
			outputChains(detectChains(threats))
		}
		fmt.Fprintln(os.Stderr, err)
		return 2
	}

	threats := detectThreats(events)
	outputThreats(threats)
	if *chain {
		outputChains(detectChains(threats))
	}
	return 0
}

func outputThreats(threats []Threat) {
	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	enc := json.NewEncoder(w)
	for _, t := range threats {
		if err := enc.Encode(t); err != nil {
			fmt.Fprintln(os.Stderr, err)
			return
		}
	}
}

func outputChains(chains []Chain) {
	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	enc := json.NewEncoder(w)
	for _, c := range chains {
		if err := enc.Encode(c); err != nil {
			fmt.Fprintln(os.Stderr, err)
			return
		}
	}
}
