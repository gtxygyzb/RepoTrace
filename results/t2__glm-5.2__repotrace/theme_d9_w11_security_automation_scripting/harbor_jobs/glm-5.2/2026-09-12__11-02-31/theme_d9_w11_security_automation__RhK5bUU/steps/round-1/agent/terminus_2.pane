=== enrich.go ===
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"net"
	"os"
	"sort"
	"strconv"
	"time"
)

type iocEntry struct {
	ID            string   `json:"id"`
	Indicator     string   `json:"indicator"`
	IndicatorType string   `json:"indicator_type"`
	ThreatActor   string   `json:"threat_actor"`
	Confidence    float64  `json:"confidence"`
	Tags          []string `json:"tags"`
	Severity      string   `json:"severity"`
	LastUpdated   string   `json:"last_updated"`
	TTLHours      int      `json:"ttl_hours"`
}

type processedIOC struct {
	entry       iocEntry
	lastUpdated time.Time
	ttlHours    int
	ip          net.IP
	ipNet       *net.IPNet
	prefixLen   int
	port        int
}

type activeIOC struct {
	p      processedIOC
	base   float64
	factor float64
}

type iocMatchInternal struct {
	p             processedIOC
	base          float64
	freshness     float64
	adjusted      float64
	matchedFields []string
}

type iocMatchOutput struct {
	IocID         string   `json:"ioc_id"`
	Indicator     string   `json:"indicator"`
	IndicatorType string   `json:"indicator_type"`
	ThreatActor   string   `json:"threat_actor"`
	Confidence    float64  `json:"confidence"`
	Tags          []string `json:"tags"`
	MatchedFields []string `json:"matched_fields"`
}

func runEnrich(args []string) int {
	fs := newFlagSet("enrich")
	iocPath := fs.String("ioc", "", "path to IOC database JSON file")
	refTimeStr := fs.String("reference-time", "", "ISO 8601 timestamp used for TTL evaluation")
	minConf := fs.Float64("min-confidence", 0.0, "minimum base effective confidence")
	if !parseFlags(fs, args) {
		return 1
	}
	if !isFlagSet(fs, "ioc") || *iocPath == "" {
		fmt.Fprintln(os.Stderr, "error: --ioc flag is required")
		return 1
	}

	hasRef := isFlagSet(fs, "reference-time")
	var refTime time.Time
	if hasRef {
		t, err := parseTime(*refTimeStr)
		if err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 1
		}
		refTime = t
	}

	iocs, err := loadIOCDB(*iocPath)
	if err != nil {
		if os.IsNotExist(err) {
			fmt.Fprintln(os.Stderr, err)
			return 1
		}
		if _, ok := err.(*json.SyntaxError); ok {
			fmt.Fprintln(os.Stderr, err)
			return 2
		}
		if _, ok := err.(*json.UnmarshalTypeError); ok {
			fmt.Fprintln(os.Stderr, err)
			return 2
		}
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	scanner := bufio.NewScanner(os.Stdin)
	scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
	var enriched []map[string]interface{}
	lineNo := 0
	for scanner.Scan() {
		lineNo++
		line := scanner.Text()
		if line == "" {
			continue
		}
		var threat map[string]interface{}
		if err := json.Unmarshal([]byte(line), &threat); err != nil {
			fmt.Fprintf(os.Stderr, "line %d: %v\n", lineNo, err)
			return 2
		}
		enriched = append(enriched, enrichThreat(threat, iocs, refTime, hasRef, *minConf))
	}
	if err := scanner.Err(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	sortEnrichedThreats(enriched)
	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	enc := json.NewEncoder(w)
	for _, t := range enriched {
		if err := enc.Encode(t); err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 1
		}
	}
	return 0
}

func loadIOCDB(path string) ([]processedIOC, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	var entries []iocEntry
	if err := json.Unmarshal(data, &entries); err != nil {
		return nil, err
	}
	processed := make([]processedIOC, 0, len(entries))
	for _, e := range entries {
		p, ok := processIOC(e)
		if !ok {
			continue
		}
		processed = append(processed, p)
	}
	return processed, nil
}

func processIOC(e iocEntry) (processedIOC, bool) {
	p := processedIOC{entry: e, ttlHours: e.TTLHours}
	if p.ttlHours <= 0 {
		return p, false
	}
	t, err := parseTime(e.LastUpdated)
	if err != nil {
		return p, false
	}
	p.lastUpdated = t
	switch e.IndicatorType {
	case "ipv4":
		ip := net.ParseIP(e.Indicator)
		if ip == nil || ip.To4() == nil {
			return p, false
		}
		p.ip = ip
	case "ipv4_cidr":
		_, ipNet, err := net.ParseCIDR(e.Indicator)
		if err != nil {
			return p, false
		}
		if ipNet.IP.To4() == nil {
			return p, false
		}
		p.ipNet = ipNet
		ones, _ := ipNet.Mask.Size()
		p.prefixLen = ones
	case "port":
		port, err := strconv.Atoi(e.Indicator)
		if err != nil {
			return p, false
		}
		p.port = port
	case "user":
	default:
		return p, false
	}
	return p, true
}

func enrichThreat(threat map[string]interface{}, iocs []processedIOC, fixedRef time.Time, hasRef bool, minConf float64) map[string]interface{} {
	refTime := fixedRef
	if !hasRef {
		refTime = threatReferenceTime(threat)
	}

	matches := computeIOCMatches(threat, iocs, refTime, minConf)

	riskScore, _ := getFloat(threat, "risk_score")
	maxConf := 0.0
	tagFactor := make(map[string]float64)
	severityContrib := 0
	indicatorTypes := make(map[string]bool)
	actors := make(map[string]bool)
	sevRank := 0

	for _, m := range matches {
		if m.adjusted > maxConf {
			maxConf = m.adjusted
		}
		for _, tag := range m.p.entry.Tags {
			if cur, ok := tagFactor[tag]; ok {
				if m.freshness > cur {
					tagFactor[tag] = m.freshness
				}
			} else {
				tagFactor[tag] = m.freshness
			}
		}
		severityContrib += severityWeight(m.p.entry.Severity)
		indicatorTypes[m.p.entry.IndicatorType] = true
		actors[m.p.entry.ThreatActor] = true
		if v := severityValue(m.p.entry.Severity); v > sevRank {
			sevRank = v
		}
	}

	tagBonus := 0.0
	for tag, factor := range tagFactor {
		tagBonus += tagBonusValue(tag) * factor
	}

	multiVectorBonus := 0.0
	switch len(indicatorTypes) {
	case 0, 1:
		multiVectorBonus = 0.0
	case 2:
		multiVectorBonus = 25.0
	default:
		multiVectorBonus = 50.0
	}

	actorBonus := 0.0
	switch len(actors) {
	case 0, 1:
		actorBonus = 0.0
	case 2:
		actorBonus = 15.0
	default:
		actorBonus = 30.0
	}

	enrichedScore := riskScore*(1.0+maxConf) + tagBonus + multiVectorBonus + float64(severityContrib) + actorBonus
