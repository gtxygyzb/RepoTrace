    32	func runForecast(args []string) int {
    33		fs := newFlagSet("forecast")
    34		steps := fs.Int("steps", 3, "number of future steps to predict")
    35		if !parseFlags(fs, args) {
    36			return 1
    37		}
    38		if *steps < 1 {
    39			fmt.Fprintln(os.Stderr, "error: --steps must be at least 1")
    40			return 1
    41		}
    42	
    43		var snapshots []forecastInputSnapshot
    44		scanner := bufio.NewScanner(os.Stdin)
    45		scanner.Buffer(make([]byte, 1024*1024), 1024*1024)
    46		for scanner.Scan() {
    47			line := scanner.Text()
    48			if len(line) == 0 {
    49				continue
    50			}
    51			var snap forecastInputSnapshot
    52			if err := json.Unmarshal([]byte(line), &snap); err != nil {
    53				fmt.Fprintf(os.Stderr, "error: malformed JSON input: %s\n", err)
    54				return 2
    55			}
    56			snapshots = append(snapshots, snap)
    57		}
    58		if err := scanner.Err(); err != nil {
    59			fmt.Fprintf(os.Stderr, "error: reading input: %s\n", err)
    60			return 1
    61		}
    62		if len(snapshots) < 3 {
    63			fmt.Fprintln(os.Stderr, "error: at least 3 valid input snapshots are required")
    64			return 1
    65		}
    66	
    67		risks := make([]float64, len(snapshots))
    68		threats := make([]float64, len(snapshots))
    69		for i, snap := range snapshots {
    70			risks[i] = snap.GlobalMeanRisk
    71			threats[i] = float64(snap.TotalThreats)
    72		}
    73	
    74		riskSlope, riskIntercept := olsLine(0, risks)
    75		threatSlope, threatIntercept := olsLine(0, threats)
    76	
    77		riskPredictions := predictLine(riskSlope, riskIntercept, len(snapshots), *steps)
    78		threatPredictions := predictLine(threatSlope, threatIntercept, len(snapshots), *steps)
    79	
    80		riskTrend := trendFromSlope(riskSlope)
    81		threatTrend := trendFromSlope(threatSlope)
    82	
    83		last := snapshots[len(snapshots)-1]
    84		metrics := map[string]forecastMetricResult{
    85			"global_mean_risk": {
    86				Slope:       json.Number(format4(riskSlope)),
    87				Intercept:   json.Number(format4(riskIntercept)),
    88				Trend:       riskTrend,
    89				LastValue:   json.Number(formatRiskValue(last.GlobalMeanRisk)),
    90				Predictions: roundAll4(riskPredictions),
    91			},
    92			"total_threats": {
    93				Slope:       json.Number(format4(threatSlope)),
    94				Intercept:   json.Number(format4(threatIntercept)),
    95				Trend:       threatTrend,
    96				LastValue:   json.Number(strconv.Itoa(last.TotalThreats)),
    97				Predictions: roundAll4(threatPredictions),
    98			},
    99		}
   100	
   101		out := forecastOutput{
   102			InputCount:   len(snapshots),
   103			Metrics:      metrics,
   104			OverallTrend: overallTrend(riskTrend, threatTrend),
   105			AlertLevel:   alertLevelFromSlopes(risks, threats, riskSlope, threatSlope),
   106		}
   107	
   108		encoded, err := json.Marshal(out)
   109		if err != nil {
   110			fmt.Fprintln(os.Stderr, "error: encoding forecast output:", err)
   111			return 1
   112		}
   113		fmt.Println(string(encoded))
   114		return 0
   115	}
   116	
   117	func olsLine(startIndex int, values []float64) (slope, intercept float64) {
   118		n := len(values)
   119		if n == 0 {
   120			return 0, 0
   121		}
   122		var sumX, sumY, sumXY, sumX2 float64
   123		for i, y := range values {
   124			x := float64(startIndex + i)
   125			sumX += x
   126			sumY += y
   127			sumXY += x * y
   128			sumX2 += x * x
   129		}
   130	
   131		denom := float64(n)*sumX2 - sumX*sumX
   132		if denom == 0 {
   133			slope = 0
   134			intercept = values[0]
   135			return
   136		}
   137		slope = (float64(n)*sumXY - sumX*sumY) / denom
   138		intercept = (sumY - slope*sumX) / float64(n)
   139		return
   140	}
