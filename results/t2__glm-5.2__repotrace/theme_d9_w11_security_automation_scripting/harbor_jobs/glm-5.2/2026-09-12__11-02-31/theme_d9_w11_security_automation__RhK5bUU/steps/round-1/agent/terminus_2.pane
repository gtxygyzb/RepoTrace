     2	
     3	import (
     4		"bufio"
     5		"encoding/json"
     6		"fmt"
     7		"os"
     8		"sort"
     9		"time"
    10	)
    11	
    12	type Event struct {
    13		Timestamp   string            `json:"timestamp"`
    14		SourceIP    string            `json:"source_ip"`
    15		DestIP      string            `json:"dest_ip"`
    16		DestPort    int               `json:"dest_port"`
    17		Protocol    string            `json:"protocol"`
    18		Action      string            `json:"action"`
    19		EventType   string            `json:"event_type"`
    20		User        string            `json:"user"`
    21		Severity    string            `json:"severity"`
    22		PayloadSize int64             `json:"payload_size"`
    23		Metadata    map[string]string `json:"metadata"`
    24	}
    25	
    26	var severityMap = map[string]int{
    27		"low":      1,
    28		"medium":   2,
    29		"high":     3,
    30		"critical": 4,
    31	}
    32	
    33	func severityValue(s string) int {
    34		return severityMap[s]
    35	}
    36	
    37	func parseEvent(line string) (Event, error) {
    38		var e Event
    39		if err := json.Unmarshal([]byte(line), &e); err != nil {
    40			return e, err
    41		}
    42		return e, nil
    43	}
    44	
    45	func parseTime(ts string) (time.Time, error) {
    46		t, err := time.Parse(time.RFC3339, ts)
    47		if err != nil {
    48			return time.Time{}, fmt.Errorf("invalid timestamp %q: %w", ts, err)
    49		}
    50		return t, nil
    51	}
    52	
    53	func readEvents() ([]Event, error) {
    54		scanner := bufio.NewScanner(os.Stdin)
    55		scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
    56		var events []Event
    57		lineNo := 0
    58		for scanner.Scan() {
    59			lineNo++
    60			line := scanner.Text()
    61			if line == "" {
    62				continue
    63			}
    64			e, err := parseEvent(line)
    65			if err != nil {
    66				return events, fmt.Errorf("line %d: %w", lineNo, err)
    67			}
    68			events = append(events, e)
    69		}
    70		if err := scanner.Err(); err != nil {
    71			return events, err
    72		}
    73		return events, nil
    74	}
    75	
    76	func sortEventsByTime(events []Event) {
    77		sort.SliceStable(events, func(i, j int) bool {
    78			return events[i].Timestamp < events[j].Timestamp
    79		})
    80	}
