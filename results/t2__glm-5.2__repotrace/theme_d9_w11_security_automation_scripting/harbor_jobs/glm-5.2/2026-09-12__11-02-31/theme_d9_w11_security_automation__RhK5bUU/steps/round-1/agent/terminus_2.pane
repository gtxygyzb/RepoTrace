	TTLHours      int      `json:"ttl_hours"`
}

type processedIOC struct {
	entry       iocEntry
	lastUpdated time.Time
	ttlHours    int
	ip          net.IP
	ipNet       *net.IPNet
	prefixLen   int
	port        int
}

type activeIOC struct {
	p      processedIOC
	base   float64
	factor float64
}

type iocMatchInternal struct {
	p             processedIOC
	base          float64
	freshness     float64
	adjusted      float64
	matchedFields []string
}

