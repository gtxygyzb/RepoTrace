    41	func runCorrelate(args []string) int {
    42		fs := newFlagSet("correlate")
    43		timeWindow := fs.Int("time-window", 0, "maximum temporal distance in minutes for two threats to be linkable")
    44		minCampaignSize := fs.Int("min-campaign-size", 2, "minimum number of threats in a campaign to output")
    45		if !parseFlags(fs, args) {
    46			return 1
    47		}
    48		if !isFlagSet(fs, "time-window") {
    49			fmt.Fprintln(os.Stderr, "error: --time-window flag is required")
    50			return 1
    51		}
    52	
    53		window := time.Duration(*timeWindow) * time.Minute
    54	
    55		scanner := bufio.NewScanner(os.Stdin)
    56		scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
    57		threats := make([]correlateThreat, 0)
    58		lineNo := 0
    59		for scanner.Scan() {
    60			lineNo++
    61			line := scanner.Text()
    62			if line == "" {
    63				continue
    64			}
    65			var obj map[string]interface{}
    66			if err := json.Unmarshal([]byte(line), &obj); err != nil {
    67				fmt.Fprintf(os.Stderr, "line %d: %v\n", lineNo, err)
    68				return 2
    69			}
    70			ct := correlateThreat{
    71				obj: obj,
    72				ref: threatReferenceTime(obj),
    73			}
    74			if actors, ok := getStringSlice(obj, "threat_actors"); ok {
    75				ct.actors = actors
    76			} else {
    77				ct.actors = []string{}
    78			}
    79			if r, ok := getFloat(obj, "enriched_risk_score"); ok {
    80				ct.risk = r
    81			}
    82			if tt, ok := getString(obj, "threat_type"); ok {
    83				ct.threatType = tt
    84			}
    85			if sev, ok := getString(obj, "ioc_severity"); ok {
    86				ct.severity = sev
    87			}
    88			threats = append(threats, ct)
    89		}
    90		if err := scanner.Err(); err != nil {
    91			fmt.Fprintln(os.Stderr, err)
    92			return 1
    93		}
    94	
    95		n := len(threats)
    96		linked := make([][]bool, n)
    97		for i := range linked {
    98			linked[i] = make([]bool, n)
    99		}
   100		for i := 0; i < n; i++ {
   101			if len(threats[i].actors) == 0 {
   102				continue
   103			}
   104			for j := i + 1; j < n; j++ {
   105				if len(threats[j].actors) == 0 {
   106					continue
   107				}
   108				if absDuration(threats[i].ref.Sub(threats[j].ref)) <= window && sharedActorCount(threats[i].actors, threats[j].actors) > 0 {
   109					linked[i][j] = true
   110					linked[j][i] = true
   111				}
   112			}
   113		}
   114	
   115		visited := make([]bool, n)
   116		var campaigns []correlateCampaign
   117		for start := 0; start < n; start++ {
   118			if visited[start] {
   119				continue
   120			}
   121			queue := []int{start}
   122			visited[start] = true
   123			component := []int{start}
   124			for len(queue) > 0 {
   125				cur := queue[0]
   126				queue = queue[1:]
   127				for next := 0; next < n; next++ {
   128					if !visited[next] && linked[cur][next] {
   129						visited[next] = true
   130						queue = append(queue, next)
   131						component = append(component, next)
   132					}
   133				}
   134			}
   135			if len(component) < *minCampaignSize {
   136				continue
   137			}
   138			campaigns = append(campaigns, buildCorrelateCampaign(threats, component, linked))
   139		}
   140	
   141		sort.SliceStable(campaigns, func(i, j int) bool {
   142			if !campaigns[i].earliestTime.Equal(campaigns[j].earliestTime) {
   143				return campaigns[i].earliestTime.Before(campaigns[j].earliestTime)
   144			}
   145			return campaigns[i].minThreatType < campaigns[j].minThreatType
   146		})
   147		for i := range campaigns {
   148			campaigns[i].CampaignID = fmt.Sprintf("CAMP-%03d", i+1)
   149		}
   150	
   151		sort.SliceStable(campaigns, func(i, j int) bool {
   152			if campaigns[i].CombinedRisk != campaigns[j].CombinedRisk {
   153				return campaigns[i].CombinedRisk > campaigns[j].CombinedRisk
   154			}
   155			if campaigns[i].Cohesion != campaigns[j].Cohesion {
   156				return campaigns[i].Cohesion > campaigns[j].Cohesion
   157			}
   158			return campaigns[i].CampaignID < campaigns[j].CampaignID
   159		})
   160	
   161		w := bufio.NewWriter(os.Stdout)
   162		defer w.Flush()
   163		enc := json.NewEncoder(w)
   164		for _, c := range campaigns {
   165			if err := enc.Encode(c); err != nil {
   166				fmt.Fprintln(os.Stderr, err)
   167				return 1
   168			}
   169		}
   170		return 0
   171	}
   172	
   173	func buildCorrelateCampaign(threats []correlateThreat, indices []int, linked [][]bool) correlateCampaign {
   174		c := correlateCampaign{
   175			ThreatCount:  len(indices),
   176			ThreatTypes:  []string{},
   177			SharedActors: []string{},
   178			AllActors:    []string{},
   179			Threats:      []map[string]interface{}{},
   180		}
   181	
   182		typeSet := make(map[string]bool)
   183		actorSet := make(map[string]bool)
   184		for _, idx := range indices {
   185			typeSet[threats[idx].threatType] = true
   186			for _, actor := range threats[idx].actors {
   187				actorSet[actor] = true
   188			}
   189		}
   190		c.ThreatTypes = sortedKeys(typeSet)
   191		c.AllActors = sortedUniqueStringsFromSet(actorSet)
   192	
   193		if len(indices) > 0 {
   194			shared := make(map[string]bool)
   195			for _, actor := range threats[indices[0]].actors {
   196				shared[actor] = true
   197			}
   198			for _, idx := range indices[1:] {
   199				next := make(map[string]bool)
   200				for _, actor := range threats[idx].actors {
   201					if shared[actor] {
   202						next[actor] = true
   203					}
   204				}
   205				shared = next
   206			}
   207			c.SharedActors = sortedUniqueStringsFromSet(shared)
   208		}
   209	
   210		directLinkCount := 0
   211		for ii, i := range indices {
   212			for jj := ii + 1; jj < len(indices); jj++ {
   213				if linked[i][indices[jj]] {
   214					directLinkCount++
   215				}
   216			}
   217		}
   218		c.DirectLinkCount = directLinkCount
   219		if c.ThreatCount > 1 {
   220			c.Cohesion = float64(directLinkCount) / (float64(c.ThreatCount*(c.ThreatCount-1)) / 2.0)
   221		} else {
   222			c.Cohesion = 0.0
   223		}
   224	
   225		propagationScore := 0.0
   226		for ii, i := range indices {
   227			for jj := ii + 1; jj < len(indices); jj++ {
   228				j := indices[jj]
   229				if !linked[i][j] {
   230					continue
   231				}
   232				sharedCount := sharedActorCount(threats[i].actors, threats[j].actors)
   233				multiplier := 0.05
   234				if sharedCount >= 2 {
   235					multiplier = 0.1
   236				}
   237				propagationScore += (threats[i].risk + threats[j].risk) * multiplier
   238			}
   239		}
   240		c.PropagationScore = propagationScore
   241	
   242		maxSeverity := "none"
   243		for _, idx := range indices {
   244			if correlateSeverityRank(threats[idx].severity) > correlateSeverityRank(maxSeverity) {
   245				maxSeverity = threats[idx].severity
   246			}
   247		}
   248		c.MaxSeverity = maxSeverity
   249	
   250		earliest := threats[indices[0]].ref
   251		latest := earliest
   252		for _, idx := range indices[1:] {
   253			if threats[idx].ref.Before(earliest) {
   254				earliest = threats[idx].ref
   255			}
   256			if threats[idx].ref.After(latest) {
   257				latest = threats[idx].ref
   258			}
   259		}
   260		c.earliestTime = earliest
   261		c.Earliest = earliest.Format(time.RFC3339)
   262		c.Latest = latest.Format(time.RFC3339)
   263		c.TimeSpanMinutes = latest.Sub(earliest).Seconds() / 60.0
   264	
   265		combinedRisk := 0.0
   266		minThreatType := ""
   267		for _, idx := range indices {
   268			combinedRisk += threats[idx].risk
   269			tt := threats[idx].threatType
   270			if minThreatType == "" || tt < minThreatType {
   271				minThreatType = tt
   272			}
   273		}
   274		c.CombinedRisk = combinedRisk
   275		c.minThreatType = minThreatType
   276	
   277		sortedIndices := make([]int, len(indices))
   278		copy(sortedIndices, indices)
   279		sort.SliceStable(sortedIndices, func(a, b int) bool {
   280			ta := threats[sortedIndices[a]]
   281			tb := threats[sortedIndices[b]]
   282			if ta.risk != tb.risk {
   283				return ta.risk > tb.risk
   284			}
   285			if !ta.ref.Equal(tb.ref) {
   286				return ta.ref.Before(tb.ref)
   287			}
   288			return ta.threatType < tb.threatType
   289		})
   290		c.Threats = make([]map[string]interface{}, 0, len(sortedIndices))
   291		for _, idx := range sortedIndices {
   292			c.Threats = append(c.Threats, threats[idx].obj)
   293		}
   294	
   295		return c
   296	}
   297	
   298	func sharedActorCount(a, b []string) int {
   299		set := make(map[string]bool)
   300		for _, s := range a {
   301			set[s] = true
   302		}
   303		count := 0
   304		seen := make(map[string]bool)
   305		for _, s := range b {
   306			if set[s] && !seen[s] {
   307				count++
   308				seen[s] = true
   309			}
   310		}
   311		return count
   312	}
   313	
   314	func absDuration(d time.Duration) time.Duration {
   315		if d < 0 {
   316			return -d
   317		}
   318		return d
   319	}
