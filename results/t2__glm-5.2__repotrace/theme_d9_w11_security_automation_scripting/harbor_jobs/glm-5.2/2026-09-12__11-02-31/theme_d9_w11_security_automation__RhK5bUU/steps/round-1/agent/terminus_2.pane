    37	func parseEvent(line string) (Event, error) {
    38		var e Event
    39		if err := json.Unmarshal([]byte(line), &e); err != nil {
    40			return e, err
    41		}
    42		return e, nil
    43	}
    44	
    45	func parseTime(ts string) (time.Time, error) {
    46		t, err := time.Parse(time.RFC3339, ts)
    47		if err != nil {
    48			return time.Time{}, fmt.Errorf("invalid timestamp %q: %w", ts, err)
    49		}
    50		return t, nil
    51	}
    52	
    53	func readEvents() ([]Event, error) {
    54		scanner := bufio.NewScanner(os.Stdin)
    55		scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
    56		var events []Event
    57		lineNo := 0
    58		for scanner.Scan() {
    59			lineNo++
    60			line := scanner.Text()
    61			if line == "" {
    62				continue
    63			}
    64			e, err := parseEvent(line)
    65			if err != nil {
    66				return events, fmt.Errorf("line %d: %w", lineNo, err)
    67			}
    68			events = append(events, e)
    69		}
    70		if err := scanner.Err(); err != nil {
    71			return events, err
    72		}
    73		return events, nil
    74	}
    75	
    76	func sortEventsByTime(events []Event) {
    77		sort.SliceStable(events, func(i, j int) bool {
    78			return events[i].Timestamp < events[j].Timestamp
    79		})
    80	}
    81	
    82	func uniqueSortedStrings(input []string) []string {
    83		seen := make(map[string]bool)
    84		var out []string
    85		for _, s := range input {
    86			if !seen[s] {
    87				seen[s] = true
    88				out = append(out, s)
    89			}
    90		}
    91		sort.Strings(out)
    92		return out
    93	}
    94	
    95	func uniqueSortedInts(input []int) []int {
    96		seen := make(map[int]bool)
    97		var out []int
    98		for _, n := range input {
    99			if !seen[n] {
   100				seen[n] = true
   101				out = append(out, n)
   102			}
   103		}
   104		sort.Ints(out)
   105		return out
   106	}
   107	
   108	func round2(f float64) float64 {
   109		return float64(int64(f*100+0.5)) / 100
   110	}
