    12	type snapshotReport struct {
    13		TotalThreats       int            `json:"total_threats"`
    14		UniqueSources      int            `json:"unique_sources"`
    15		ActiveCampaigns    int            `json:"active_campaigns"`
    16		MaxCampaignSize    int            `json:"max_campaign_size"`
    17		RiskCategory       string         `json:"risk_category"`
    18		MeanEnrichedRisk   float64        `json:"mean_enriched_risk"`
    19		PeakBucketAvg      float64        `json:"peak_bucket_avg"`
    20		PeakBucketStart    string         `json:"peak_bucket_start"`
    21		DominantThreatType string         `json:"dominant_threat_type"`
    22		TopActor           string         `json:"top_actor"`
    23		ActorThreatCounts  map[string]int `json:"actor_threat_counts"`
    24	}
    25	
    26	func runSnapshot(args []string) int {
    27		fs := newFlagSet("snapshot")
    28		campaignWindow := fs.Int("campaign-window", 60, "time window in minutes for campaign detection")
    29		bucketMinutes := fs.Int("bucket-minutes", 60, "bucket width in minutes for internal timeline analysis")
    30		if !parseFlags(fs, args) {
    31			return 1
    32		}
    33		if *campaignWindow < 0 {
    34			fmt.Fprintf(os.Stderr, "invalid --campaign-window: must be non-negative\n")
    35			return 1
    36		}
    37		if *bucketMinutes <= 0 {
    38			fmt.Fprintf(os.Stderr, "invalid --bucket-minutes: must be a positive integer\n")
    39			return 1
    40		}
    41	
    42		scanner := bufio.NewScanner(os.Stdin)
    43		scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
    44		var threats []map[string]interface{}
    45		lineNo := 0
    46		for scanner.Scan() {
    47			lineNo++
    48			line := scanner.Text()
    49			if line == "" {
    50				continue
    51			}
    52			var threat map[string]interface{}
    53			if err := json.Unmarshal([]byte(line), &threat); err != nil {
    54				fmt.Fprintf(os.Stderr, "line %d: %v\n", lineNo, err)
    55				return 2
    56			}
    57			threats = append(threats, threat)
    58		}
    59		if err := scanner.Err(); err != nil {
    60			fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
    61			return 2
    62		}
    63	
    64		report := buildSnapshot(threats, *campaignWindow, *bucketMinutes)
    65		data, err := json.Marshal(report)
    66		if err != nil {
    67			fmt.Fprintf(os.Stderr, "error marshalling report: %v\n", err)
    68			return 2
    69		}
    70		fmt.Println(string(data))
    71		return 0
    72	}
    73	
    74	func buildSnapshot(threats []map[string]interface{}, campaignWindow int, bucketMinutes int) snapshotReport {
    75		report := snapshotReport{
    76			ActorThreatCounts: map[string]int{},
    77			RiskCategory:      "low",
    78		}
    79		if len(threats) == 0 {
    80			return report
    81		}
    82	
    83		report.TotalThreats = len(threats)
    84	
    85		sourceSet := map[string]bool{}
    86		for _, t := range threats {
    87			if ip, ok := getString(t, "source_ip"); ok && ip != "" {
    88				sourceSet[ip] = true
    89			}
    90		}
    91		report.UniqueSources = len(sourceSet)
    92	
    93		var sumRisk float64
    94		for _, t := range threats {
    95			risk, _ := getFloat(t, "enriched_risk_score")
    96			sumRisk += risk
    97		}
    98		meanRisk := sumRisk / float64(len(threats))
    99		report.MeanEnrichedRisk = round2(meanRisk)
   100		report.RiskCategory = snapshotRiskCategory(meanRisk)
   101	
   102		bucketSeconds := int64(bucketMinutes) * 60
   103		buckets := make(map[int64][]map[string]interface{})
   104		for _, threat := range threats {
   105			refTime := threatSortTime(threat)
   106			var refUnix int64
   107			if !refTime.IsZero() {
   108				refUnix = refTime.Unix()
   109			}
   110			start := refUnix - ((refUnix%bucketSeconds)+bucketSeconds)%bucketSeconds
   111			buckets[start] = append(buckets[start], threat)
   112		}
   113	
   114		peakAvg := 0.0
   115		peakStart := ""
   116		first := true
   117		var starts []int64
   118		for s := range buckets {
   119			starts = append(starts, s)
   120		}
   121		sort.Slice(starts, func(i, j int) bool { return starts[i] < starts[j] })
   122		for _, start := range starts {
   123			bucketThreats := buckets[start]
   124			var sum float64
   125			for _, t := range bucketThreats {
   126				risk, _ := getFloat(t, "enriched_risk_score")
   127				sum += risk
   128			}
   129			avg := sum / float64(len(bucketThreats))
   130			if first || avg > peakAvg {
   131				first = false
   132				peakAvg = avg
   133				peakStart = time.Unix(start, 0).UTC().Format(time.RFC3339)
   134			}
   135		}
   136		report.PeakBucketAvg = round2(peakAvg)
   137		report.PeakBucketStart = peakStart
   138	
   139		typeCounts := map[string]int{}
   140		for _, t := range threats {
   141			if tt, ok := getString(t, "threat_type"); ok && tt != "" {
   142				typeCounts[tt]++
   143			}
   144		}
   145		report.DominantThreatType = dominantThreatType(threats, typeCounts)
   146	
   147		actorCounts := map[string]int{}
   148		for _, t := range threats {
   149			if actors, ok := getStringSlice(t, "threat_actors"); ok {
   150				seen := map[string]bool{}
   151				for _, actor := range actors {
   152					if actor != "" && !seen[actor] {
   153						seen[actor] = true
   154						actorCounts[actor]++
   155					}
   156				}
   157			}
   158		}
   159		report.ActorThreatCounts = actorCounts
   160	
   161		var actors []string
   162		for a := range actorCounts {
   163			actors = append(actors, a)
   164		}
   165		sort.Strings(actors)
   166		topActor := ""
   167		maxActorCount := 0
   168		for _, a := range actors {
   169			if actorCounts[a] > maxActorCount {
   170				maxActorCount = actorCounts[a]
   171				topActor = a
   172			}
   173		}
   174		report.TopActor = topActor
   175	
   176		type snapThreat struct {
   177			ref    time.Time
   178			actors []string
   179		}
   180		campaignThreats := make([]snapThreat, len(threats))
