   136	
   137	func loadIOCDB(path string) ([]processedIOC, error) {
   138		data, err := os.ReadFile(path)
   139		if err != nil {
   140			return nil, err
   141		}
   142		var entries []iocEntry
   143		if err := json.Unmarshal(data, &entries); err != nil {
   144			return nil, err
   145		}
   146		processed := make([]processedIOC, 0, len(entries))
   147		for _, e := range entries {
   148			p, ok := processIOC(e)
   149			if !ok {
   150				continue
   151			}
   152			processed = append(processed, p)
   153		}
   154		return processed, nil
   155	}
   156	
   157	func processIOC(e iocEntry) (processedIOC, bool) {
   158		p := processedIOC{entry: e, ttlHours: e.TTLHours}
   159		if p.ttlHours <= 0 {
   160			return p, false
   161		}
   162		t, err := parseTime(e.LastUpdated)
   163		if err != nil {
   164			return p, false
   165		}
   166		p.lastUpdated = t
   167		switch e.IndicatorType {
   168		case "ipv4":
   169			ip := net.ParseIP(e.Indicator)
   170			if ip == nil || ip.To4() == nil {
   171				return p, false
   172			}
   173			p.ip = ip
   174		case "ipv4_cidr":
   175			_, ipNet, err := net.ParseCIDR(e.Indicator)
   176			if err != nil {
   177				return p, false
   178			}
   179			if ipNet.IP.To4() == nil {
   180				return p, false
   181			}
   182			p.ipNet = ipNet
   183			ones, _ := ipNet.Mask.Size()
   184			p.prefixLen = ones
   185		case "port":
   186			port, err := strconv.Atoi(e.Indicator)
   187			if err != nil {
   188				return p, false
   189			}
   190			p.port = port
   191		case "user":
   192		default:
   193			return p, false
   194		}
   195		return p, true
   196	}
   197	
   198	func enrichThreat(threat map[string]interface{}, iocs []processedIOC, fixedRef time.Time, hasRef bool, minConf float64) map[string]interface{} {
   199		refTime := fixedRef
   200		if !hasRef {
   201			refTime = threatReferenceTime(threat)
   202		}
   203	
   204		matches := computeIOCMatches(threat, iocs, refTime, minConf)
   205	
   206		riskScore, _ := getFloat(threat, "risk_score")
   207		maxConf := 0.0
   208		tagFactor := make(map[string]float64)
   209		severityContrib := 0
   210		indicatorTypes := make(map[string]bool)
   211		actors := make(map[string]bool)
   212		sevRank := 0
   213	
   214		for _, m := range matches {
   215			if m.adjusted > maxConf {
   216				maxConf = m.adjusted
   217			}
   218			for _, tag := range m.p.entry.Tags {
   219				if cur, ok := tagFactor[tag]; ok {
   220					if m.freshness > cur {
   221						tagFactor[tag] = m.freshness
   222					}
   223				} else {
   224					tagFactor[tag] = m.freshness
   225				}
   226			}
   227			severityContrib += severityWeight(m.p.entry.Severity)
   228			indicatorTypes[m.p.entry.IndicatorType] = true
   229			actors[m.p.entry.ThreatActor] = true
   230			if v := severityValue(m.p.entry.Severity); v > sevRank {
   231				sevRank = v
   232			}
   233		}
   234	
   235		tagBonus := 0.0
   236		for tag, factor := range tagFactor {
   237			tagBonus += tagBonusValue(tag) * factor
   238		}
   239	
   240		multiVectorBonus := 0.0
   241		switch len(indicatorTypes) {
   242		case 0, 1:
   243			multiVectorBonus = 0.0
   244		case 2:
   245			multiVectorBonus = 25.0
   246		default:
   247			multiVectorBonus = 50.0
   248		}
   249	
   250		actorBonus := 0.0
   251		switch len(actors) {
   252		case 0, 1:
   253			actorBonus = 0.0
   254		case 2:
   255			actorBonus = 15.0
   256		default:
   257			actorBonus = 30.0
   258		}
   259	
   260		enrichedScore := riskScore*(1.0+maxConf) + tagBonus + multiVectorBonus + float64(severityContrib) + actorBonus
   261	
   262		outMatches := make([]iocMatchOutput, 0, len(matches))
   263		for _, m := range matches {
   264			outMatches = append(outMatches, iocMatchOutput{
   265				IocID:         m.p.entry.ID,
   266				Indicator:     m.p.entry.Indicator,
   267				IndicatorType: m.p.entry.IndicatorType,
   268				ThreatActor:   m.p.entry.ThreatActor,
   269				Confidence:    m.p.entry.Confidence,
   270				Tags:          nonNilStrings(m.p.entry.Tags),
   271				MatchedFields: nonNilStrings(m.matchedFields),
   272			})
   273		}
   274	
   275		threat["ioc_matches"] = outMatches
   276		threat["enriched_risk_score"] = enrichedScore
   277		threat["threat_actors"] = nonNilStrings(sortedUniqueStringsFromSet(actors))
   278		threat["max_ioc_confidence"] = maxConf
   279		if len(matches) == 0 {
   280			threat["ioc_severity"] = "none"
   281		} else {
   282			threat["ioc_severity"] = severityFromRank(sevRank)
   283		}
   284		return threat
   285	}
   286	
   287	func computeIOCMatches(threat map[string]interface{}, iocs []processedIOC, refTime time.Time, minConf float64) []iocMatchInternal {
   288		active := make([]activeIOC, 0, len(iocs))
   289		for _, p := range iocs {
   290			base, factor, ok := computeFreshness(p, refTime)
   291			if !ok {
   292				continue
   293			}
   294			if base < minConf {
   295				continue
   296			}
   297			active = append(active, activeIOC{p: p, base: base, factor: factor})
   298		}
   299	
   300		matchedFields := make([]map[string]bool, len(active))
   301		for i := range active {
   302			matchedFields[i] = make(map[string]bool)
   303		}
   304	
   305		type cidrCandidate struct {
   306			activeIdx int
   307			base      float64
   308			prefixLen int
   309			iocID     string
   310		}
   311		cidrCandidates := make(map[string]map[string][]cidrCandidate)
   312	
   313		addCIDRCandidate := func(field, ipStr string, idx int, a activeIOC) {
   314			if cidrCandidates[field] == nil {
   315				cidrCandidates[field] = make(map[string][]cidrCandidate)
   316			}
   317			cidrCandidates[field][ipStr] = append(cidrCandidates[field][ipStr], cidrCandidate{
   318				activeIdx: idx,
   319				base:      a.base,
   320				prefixLen: a.p.prefixLen,
   321				iocID:     a.p.entry.ID,
   322			})
   323		}
   324	
   325		shadowPairs := make(map[string]bool)
   326		addShadow := func(field, ip string) {
   327			shadowPairs[field+"\x00"+ip] = true
   328		}
   329		isShadowed := func(field, ip string) bool {
   330			return shadowPairs[field+"\x00"+ip]
   331		}
   332	
   333		for i, a := range active {
   334			switch a.p.entry.IndicatorType {
   335			case "ipv4":
   336				if val, ok := getString(threat, "source_ip"); ok && a.p.entry.Indicator == val {
   337					matchedFields[i]["source_ip"] = true
   338					addShadow("source_ip", val)
   339				}
   340				if val, ok := getString(threat, "dest_ip"); ok && a.p.entry.Indicator == val {
   341					matchedFields[i]["dest_ip"] = true
   342					addShadow("dest_ip", val)
   343				}
   344				if vals, ok := getStringSlice(threat, "dest_ips"); ok {
   345					for _, val := range vals {
   346						if a.p.entry.Indicator == val {
   347							matchedFields[i]["dest_ips"] = true
   348							addShadow("dest_ips", val)
   349							break
   350						}
   351					}
   352				}
   353				if vals, ok := getStringSlice(threat, "compromised_hosts"); ok {
   354					for _, val := range vals {
   355						if a.p.entry.Indicator == val {
   356							matchedFields[i]["compromised_hosts"] = true
   357							addShadow("compromised_hosts", val)
   358							break
   359						}
   360					}
