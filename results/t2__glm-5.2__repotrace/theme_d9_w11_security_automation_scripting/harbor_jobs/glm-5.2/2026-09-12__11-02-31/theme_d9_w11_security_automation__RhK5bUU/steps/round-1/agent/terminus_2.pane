   100				continue
   101			}
   102	
   103			riskMean, riskStd := baselineStats(risks[start:i])
   104			threatMean, threatStd := baselineStats(threats[start:i])
   105	
   106			riskZ := zScore(risks[i], riskMean, riskStd)
   107			threatZ := zScore(threats[i], threatMean, threatStd)
   108			combinedZ := math.Sqrt(riskZ*riskZ + threatZ*threatZ)
   109			roundedCombinedZ := roundHalfUp4(combinedZ)
   110	
   111			if combinedZ < *threshold {
   112				continue
   113			}
   114	
   115			direction := "mixed"
   116			if riskZ >= 0 && threatZ >= 0 {
   117				direction = "above"
   118			} else if riskZ <= 0 && threatZ <= 0 {
   119				direction = "below"
   120			}
