[?2004l   212	func dominantThreatType(threats []map[string]interface{}, counts map[string]int) string {
   213		var keys []string
   214		for k := range counts {
   215			keys = append(keys, k)
   216		}
   217		sort.Strings(keys)
   218	
   219		sumRisk := make(map[string]float64)
   220		typeNum := make(map[string]int)
   221		for _, threat := range threats {
   222			tt, ok := getString(threat, "threat_type")
   223			if !ok {
   224				continue
   225			}
   226			risk, _ := getFloat(threat, "enriched_risk_score")
   227			sumRisk[tt] += risk
   228			typeNum[tt]++
   229		}
   230		meanRisk := make(map[string]float64)
   231		for k, sum := range sumRisk {
   232			if c := typeNum[k]; c > 0 {
   233				meanRisk[k] = sum / float64(c)
   234			}
   235		}
   236	
   237		dominant := ""
   238		maxCount := -1
   239		maxMean := 0.0
   240		for _, k := range keys {
   241			c := counts[k]
   242			mean := meanRisk[k]
   243			if dominant == "" || c > maxCount || (c == maxCount && mean > maxMean) {
   244				maxCount = c
   245				maxMean = mean
   246				dominant = k
   247			}
   248		}
   249		return dominant
   250	}
