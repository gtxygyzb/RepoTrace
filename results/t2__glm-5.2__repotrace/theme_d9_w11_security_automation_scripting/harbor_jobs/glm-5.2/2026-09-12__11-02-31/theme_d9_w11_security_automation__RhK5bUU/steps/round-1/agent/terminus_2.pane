   441		ageHours := refTime.Sub(p.lastUpdated).Hours()
   442		freshnessFraction := ageHours / float64(p.ttlHours)
   443		if freshnessFraction >= 1.0 {
   444			return 0, 0, false
   445		}
   446		factor := freshnessFactor(freshnessFraction)
   447		return p.entry.Confidence * factor, factor, true
   448	}
   449	
   450	func freshnessFactor(fraction float64) float64 {
   451		switch {
   452		case fraction < 0.25:
   453			return 1.0
   454		case fraction < 0.50:
   455			return 0.9
   456		case fraction < 0.75:
   457			return 0.7
   458		default:
   459			return 0.5
   460		}
   461	}
