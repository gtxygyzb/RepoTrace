[?2004hroot@n30009:/app# sed -n '1,75p' forecast.go
[?2004lpackage main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
)

type forecastInputSnapshot struct {
	GlobalMeanRisk float64 `json:"global_mean_risk"`
	TotalThreats   int     `json:"total_threats"`
}

type forecastMetricResult struct {
	Slope       json.Number   `json:"slope"`
	Intercept   json.Number   `json:"intercept"`
	Trend       string        `json:"trend"`
	LastValue   json.Number   `json:"last_value"`
	Predictions []json.Number `json:"predictions"`
}

type forecastOutput struct {
	InputCount   int                             `json:"input_count"`
	Metrics      map[string]forecastMetricResult `json:"metrics"`
	OverallTrend string                          `json:"overall_trend"`
	AlertLevel   string                          `json:"alert_level"`
}

func runForecast(args []string) int {
	fs := newFlagSet("forecast")
	steps := fs.Int("steps", 3, "number of future steps to predict")
	if !parseFlags(fs, args) {
		return 1
	}
	if *steps < 1 {
		fmt.Fprintln(os.Stderr, "error: --steps must be at least 1")
		return 1
	}

	var snapshots []forecastInputSnapshot
	scanner := bufio.NewScanner(os.Stdin)
	scanner.Buffer(make([]byte, 1024*1024), 1024*1024)
	for scanner.Scan() {
		line := scanner.Text()
		if len(line) == 0 {
			continue
		}
		var snap forecastInputSnapshot
		if err := json.Unmarshal([]byte(line), &snap); err != nil {
			fmt.Fprintf(os.Stderr, "error: malformed JSON input: %s\n", err)
			return 2
		}
		snapshots = append(snapshots, snap)
	}
	if err := scanner.Err(); err != nil {
		fmt.Fprintf(os.Stderr, "error: reading input: %s\n", err)
		return 1
	}
	if len(snapshots) < 3 {
		fmt.Fprintln(os.Stderr, "error: at least 3 valid input snapshots are required")
		return 1
	}

	risks := make([]float64, len(snapshots))
	threats := make([]float64, len(snapshots))
	for i, snap := range snapshots {
		risks[i] = snap.GlobalMeanRisk
		threats[i] = float64(snap.TotalThreats)
	}

	riskSlope, riskIntercept := olsLine(0, risks)
	threatSlope, threatIntercept := olsLine(0, threats)
[?2004hroot@n30009:/app# cat > compliance.go <<'EOF'
[?2004l  `json:"violation_count"`
	CompliancePercentage json.Number           `json:"compliance_percentage"`
	Status               string                `json:"status"`
	Policy               compliancePolicy      `json:"policy"`
	Violations           []complianceViolation `json:"violations"`
	Summary              complianceSummary     `json:"summary"`
}

func runCompliance(args []string) int {
	fs := newFlagSet("compliance")
	maxRisk := fs.Float64("max-risk", 300.0, "maximum allowed global mean risk")
	maxThreats := fs.Int("max-threats", 20, "maximum allowed total threats")
	minSnapshots := fs.Int("min-snapshots", 1, "minimum number of input snapshots")
	if !parseFlags(fs, args) {
		return 1
	}

	if *maxRisk <= 0 {
		fmt.Fprintln(os.Stderr, "error: --max-risk must be greater than 0")
		return 1
	}
	if *maxThreats <= 0 {
		fmt.Fprintln(os.Stderr, "error: --max-threats must be greater than 0")
		return 1
	}

	var snapshots []complianceInputSnapshot
	scanner := bufio.NewScanner(os.Stdin)
	scanner.Buffer(make([]byte, 1024*1024), 1024*1024)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" {
			continue
		}

		var snap complianceInputSnapshot
		if err := json.Unmarshal([]byte(line), &snap); err != nil {
			fmt.Fprintf(os.Stderr, "error: malformed JSON input: %s\n", err)
			return 2
		}
		snapshots = append(snapshots, snap)
	}
	if err := scanner.Err(); err != nil {
		fmt.Fprintf(os.Stderr, "error: reading input: %s\n", err)
		return 1
	}

	if len(snapshots) < *minSnapshots {
		fmt.Fprintf(os.Stderr, "error: at least %d valid input snapshot(s) required\n", *minSnapshots)
		return 1
	}

	total := len(snapshots)
	compliant := 0
	violations := []complianceViolation{}
	var worstRisk float64
	worstThreats := 0
	var sumRisk, sumThreats float64

	for i, snap := range snapshots {
		if i == 0 || snap.GlobalMeanRisk > worstRisk {
			worstRisk = snap.GlobalMeanRisk
		}
		if i == 0 || snap.TotalThreats > worstThreats {
			worstThreats = snap.TotalThreats
		}
		sumRisk += snap.GlobalMeanRisk
		sumThreats += float64(snap.TotalThreats)

		reasons := []string{}
		if snap.GlobalMeanRisk > *maxRisk {
			reasons = append(reasons, "risk_exceeded")
		}
		if snap.TotalThreats > *maxThreats {
			reasons = append(reasons, "threats_exceeded")
		}
		if len(reasons) == 0 {
			compliant++
			continue
		}

		sort.Strings(reasons)
		violations = append(violations, complianceViolation{
			Index:          i,
			GlobalMeanRisk: json.Number(formatRiskValue(snap.GlobalMeanRisk)),
			TotalThreats:   snap.TotalThreats,
			Reasons:        reasons,
		})
	}

	var percentage float64
	if total > 0 {
		percentage = float64(compliant) / float64(total) * 100.0
	}
	roundedPercentage := roundHalfUp4(percentage)

	status := "partial"
	switch {
	case roundedPercentage == 100.0:
		status = "full"
	case roundedPercentage == 0.0:
		status = "none"
	}

	var meanRisk, meanThreats float64
	if total > 0 {
		meanRisk = sumRisk / float64(total)
		meanThreats = sumThreats / float64(total)
	}

	out := complianceOutput{
		TotalSnapshots:       total,
		CompliantCount:       compliant,
