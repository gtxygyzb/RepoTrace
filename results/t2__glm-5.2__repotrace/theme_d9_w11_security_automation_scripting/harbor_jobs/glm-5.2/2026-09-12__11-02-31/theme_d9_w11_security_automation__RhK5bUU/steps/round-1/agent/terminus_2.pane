			SourceIP:    t.SourceIP,
			Count:       t.Count,
			FirstSeen:   t.FirstSeen,
			LastSeen:    t.LastSeen,
			TargetUsers: nonNilStrings(t.TargetUsers),
			RiskScore:   t.RiskScore,
		})
	case "port_scan":
		return json.Marshal(struct {
			ThreatType   string  `json:"threat_type"`
			SourceIP     string  `json:"source_ip"`
			DestIP       string  `json:"dest_ip"`
			PortsScanned []int   `json:"ports_scanned"`
			FirstSeen    string  `json:"first_seen"`
			LastSeen     string  `json:"last_seen"`
			RiskScore    float64 `json:"risk_score"`
		}{
			ThreatType:   t.ThreatType,
			SourceIP:     t.SourceIP,
			DestIP:       t.DestIP,
			PortsScanned: nonNilInts(t.PortsScanned),
			FirstSeen:    t.FirstSeen,
			LastSeen:     t.LastSeen,
			RiskScore:    t.RiskScore,
		})
	case "data_exfiltration":
		return json.Marshal(struct {
			ThreatType string   `json:"threat_type"`
			SourceIP   string   `json:"source_ip"`
			TotalBytes int64    `json:"total_bytes"`
			FirstSeen  string   `json:"first_seen"`
			LastSeen   string   `json:"last_seen"`
			DestIPs    []string `json:"dest_ips"`
			RiskScore  float64  `json:"risk_score"`
		}{
			ThreatType: t.ThreatType,
			SourceIP:   t.SourceIP,
			TotalBytes: t.TotalBytes,
			FirstSeen:  t.FirstSeen,
			LastSeen:   t.LastSeen,
			DestIPs:    nonNilStrings(t.DestIPs),
			RiskScore:  t.RiskScore,
		})
	case "privilege_escalation":
		return json.Marshal(struct {
			ThreatType    string  `json:"threat_type"`
			User          string  `json:"user"`
			SourceIP      string  `json:"source_ip"`
			Timestamp     string  `json:"timestamp"`
			PriorFailures int     `json:"prior_failures"`
			RiskScore     float64 `json:"risk_score"`
		}{
			ThreatType:    t.ThreatType,
			User:          t.User,
			SourceIP:      t.SourceIP,
			Timestamp:     t.Timestamp,
			PriorFailures: t.PriorFailures,
			RiskScore:     t.RiskScore,
		})
	case "lateral_movement":
		return json.Marshal(struct {
			ThreatType       string   `json:"threat_type"`
			SourceIP         string   `json:"source_ip"`
			CompromisedHosts []string `json:"compromised_hosts"`
			FirstSeen        string   `json:"first_seen"`
			LastSeen         string   `json:"last_seen"`
			RiskScore        float64  `json:"risk_score"`
		}{
			ThreatType:       t.ThreatType,
			SourceIP:         t.SourceIP,
			CompromisedHosts: nonNilStrings(t.CompromisedHosts),
			FirstSeen:        t.FirstSeen,
			LastSeen:         t.LastSeen,
			RiskScore:        t.RiskScore,
		})
	case "dns_tunneling":
