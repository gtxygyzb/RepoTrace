   137	func loadIOCDB(path string) ([]processedIOC, error) {
   138		data, err := os.ReadFile(path)
   139		if err != nil {
   140			return nil, err
   141		}
   142		var entries []iocEntry
   143		if err := json.Unmarshal(data, &entries); err != nil {
   144			return nil, err
   145		}
   146		processed := make([]processedIOC, 0, len(entries))
   147		for _, e := range entries {
   148			p, ok := processIOC(e)
   149			if !ok {
   150				continue
   151			}
   152			processed = append(processed, p)
   153		}
   154		return processed, nil
   155	}
   156	
   157	func processIOC(e iocEntry) (processedIOC, bool) {
   158		p := processedIOC{entry: e, ttlHours: e.TTLHours}
   159		if p.ttlHours <= 0 {
   160			return p, false
   161		}
   162		t, err := parseTime(e.LastUpdated)
   163		if err != nil {
   164			return p, false
   165		}
   166		p.lastUpdated = t
   167		switch e.IndicatorType {
   168		case "ipv4":
   169			ip := net.ParseIP(e.Indicator)
   170			if ip == nil || ip.To4() == nil {
   171				return p, false
   172			}
   173			p.ip = ip
   174		case "ipv4_cidr":
   175			_, ipNet, err := net.ParseCIDR(e.Indicator)
   176			if err != nil {
   177				return p, false
   178			}
   179			if ipNet.IP.To4() == nil {
   180				return p, false
   181			}
   182			p.ipNet = ipNet
   183			ones, _ := ipNet.Mask.Size()
   184			p.prefixLen = ones
   185		case "port":
   186			port, err := strconv.Atoi(e.Indicator)
   187			if err != nil {
   188				return p, false
   189			}
   190			p.port = port
