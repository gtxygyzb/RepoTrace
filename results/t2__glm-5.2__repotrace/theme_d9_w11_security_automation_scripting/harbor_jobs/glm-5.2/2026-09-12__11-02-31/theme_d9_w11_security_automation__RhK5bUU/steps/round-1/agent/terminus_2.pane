     9	func main() {
    10		if len(os.Args) < 2 {
    11			fmt.Fprintln(os.Stderr, "usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate> [flags]")
    12			os.Exit(1)
    13		}
    14	
    15		var code int
    16		switch os.Args[1] {
    17		case "analyze":
    18			code = runAnalyze(os.Args[2:])
    19		case "summarize":
    20			code = runSummarize(os.Args[2:])
    21		case "filter":
    22			code = runFilter(os.Args[2:])
    23		case "respond":
    24			code = runRespond(os.Args[2:])
    25		case "enrich":
    26			code = runEnrich(os.Args[2:])
    27		case "correlate":
    28			code = runCorrelate(os.Args[2:])
    29		case "timeline":
    30			code = runTimeline(os.Args[2:])
    31		case "snapshot":
    32			code = runSnapshot(os.Args[2:])
    33		case "alert":
    34			code = runAlert(os.Args[2:])
    35		case "aggregate":
    36			code = runAggregate(os.Args[2:])
    37		default:
    38			fmt.Fprintf(os.Stderr, "invalid subcommand: %s\n", os.Args[1])
    39			code = 1
    40		}
    41		os.Exit(code)
    42	}
    43	
    44	func newFlagSet(name string) *flag.FlagSet {
    45		fs := flag.NewFlagSet(name, flag.ContinueOnError)
    46		fs.SetOutput(os.Stderr)
    47		fs.Usage = func() {}
    48		return fs
    49	}
    50	
    51	func parseFlags(fs *flag.FlagSet, args []string) bool {
    52		if err := fs.Parse(args); err != nil {
    53			return false
    54		}
    55		return true
    56	}
    57	
    58	func isFlagSet(fs *flag.FlagSet, name string) bool {
    59		set := false
    60		fs.Visit(func(f *flag.Flag) {
    61			if f.Name == name {
    62				set = true
    63			}
    64		})
    65		return set
    66	}
