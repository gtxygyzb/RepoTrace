   441		ageHours := refTime.Sub(p.lastUpdated).Hours()
   442		freshnessFraction := ageHours / float64(p.ttlHours)
   443		if freshnessFraction >= 1.0 {
   444			return 0, 0, false
   445		}
   446		factor := freshnessFactor(freshnessFraction)
   447		return p.entry.Confidence * factor, factor, true
   448	}
   449	
   450	func freshnessFactor(fraction float64) float64 {
   451		switch {
   452		case fraction < 0.25:
   453			return 1.0
   454		case fraction < 0.50:
   455			return 0.9
   456		case fraction < 0.75:
   457			return 0.7
   458		default:
   459			return 0.5
   460		}
   461	}
   462	
   463	func fieldMultiplier(field string) float64 {
   464		switch field {
   465		case "source_ip", "dest_ip", "compromised_hosts", "user":
   466			return 1.0
   467		case "dest_ips", "target_users":
   468			return 0.8
   469		case "ports_scanned":
   470			return 0.6
   471		default:
   472			return 0.0
   473		}
   474	}
   475	
   476	func maxFieldMultiplier(fields []string) float64 {
   477		max := 0.0
   478		for _, f := range fields {
   479			if m := fieldMultiplier(f); m > max {
   480				max = m
   481			}
   482		}
   483		return max
   484	}
