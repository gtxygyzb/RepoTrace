	case score >= 0.75:
		return "critical"
	case score >= 0.50:
		return "high"
	case score >= 0.25:
		return "medium"
	default:
		return "low"
	}
}

func round4(f float64) float64 {
	return math.Round(f*10000) / 10000
}
