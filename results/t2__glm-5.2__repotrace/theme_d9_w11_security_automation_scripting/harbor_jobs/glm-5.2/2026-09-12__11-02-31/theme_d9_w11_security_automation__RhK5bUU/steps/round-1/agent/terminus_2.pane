    66			return 1
    67		}
    68		if !isFlagSet(fs, "ioc") || *iocPath == "" {
    69			fmt.Fprintln(os.Stderr, "error: --ioc flag is required")
    70			return 1
    71		}
    72	
    73		hasRef := isFlagSet(fs, "reference-time")
    74		var refTime time.Time
    75		if hasRef {
    76			t, err := parseTime(*refTimeStr)
    77			if err != nil {
    78				fmt.Fprintln(os.Stderr, err)
    79				return 1
    80			}
    81			refTime = t
    82		}
    83	
    84		iocs, err := loadIOCDB(*iocPath)
    85		if err != nil {
    86			if os.IsNotExist(err) {
    87				fmt.Fprintln(os.Stderr, err)
    88				return 1
    89			}
    90			if _, ok := err.(*json.SyntaxError); ok {
    91				fmt.Fprintln(os.Stderr, err)
    92				return 2
    93			}
    94			if _, ok := err.(*json.UnmarshalTypeError); ok {
    95				fmt.Fprintln(os.Stderr, err)
    96				return 2
    97			}
    98			fmt.Fprintln(os.Stderr, err)
    99			return 1
   100		}
   101	
   102		scanner := bufio.NewScanner(os.Stdin)
   103		scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
   104		var enriched []map[string]interface{}
   105		lineNo := 0
   106		for scanner.Scan() {
   107			lineNo++
   108			line := scanner.Text()
   109			if line == "" {
   110				continue
   111			}
