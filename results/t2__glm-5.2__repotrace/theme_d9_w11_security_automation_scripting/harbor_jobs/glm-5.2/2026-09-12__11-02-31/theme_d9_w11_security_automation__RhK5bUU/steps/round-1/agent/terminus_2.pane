    31	
    32	func (t Threat) MarshalJSON() ([]byte, error) {
    33		switch t.ThreatType {
    34		case "brute_force":
    35			return json.Marshal(struct {
    36				ThreatType  string   `json:"threat_type"`
    37				SourceIP    string   `json:"source_ip"`
    38				Count       int      `json:"count"`
    39				FirstSeen   string   `json:"first_seen"`
    40				LastSeen    string   `json:"last_seen"`
    41				TargetUsers []string `json:"target_users"`
    42				RiskScore   float64  `json:"risk_score"`
    43			}{
    44				ThreatType:  t.ThreatType,
    45				SourceIP:    t.SourceIP,
    46				Count:       t.Count,
    47				FirstSeen:   t.FirstSeen,
    48				LastSeen:    t.LastSeen,
    49				TargetUsers: nonNilStrings(t.TargetUsers),
    50				RiskScore:   t.RiskScore,
    51			})
    52		case "port_scan":
