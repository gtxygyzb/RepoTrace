package main

import (
	"flag"
	"fmt"
	"os"
)

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot> [flags]")
		os.Exit(1)
	}

	var code int
	switch os.Args[1] {
	case "analyze":
		code = runAnalyze(os.Args[2:])
	case "summarize":
		code = runSummarize(os.Args[2:])
	case "filter":
		code = runFilter(os.Args[2:])
	case "respond":
		code = runRespond(os.Args[2:])
	case "enrich":
		code = runEnrich(os.Args[2:])
	case "correlate":
		code = runCorrelate(os.Args[2:])
	case "timeline":
		code = runTimeline(os.Args[2:])
	case "snapshot":
		code = runSnapshot(os.Args[2:])
	default:
		fmt.Fprintf(os.Stderr, "invalid subcommand: %s\n", os.Args[1])
		code = 1
	}
	os.Exit(code)
}

