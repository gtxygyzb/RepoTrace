[?2004lpackage main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
)

type forecastInputSnapshot struct {
	GlobalMeanRisk float64 `json:"global_mean_risk"`
	TotalThreats   int     `json:"total_threats"`
}

type forecastMetricResult struct {
	Slope       json.Number   `json:"slope"`
	Intercept   json.Number   `json:"intercept"`
	Trend       string        `json:"trend"`
	LastValue   json.Number   `json:"last_value"`
	Predictions []json.Number `json:"predictions"`
}

type forecastOutput struct {
	InputCount   int                             `json:"input_count"`
	Metrics      map[string]forecastMetricResult `json:"metrics"`
	OverallTrend string                          `json:"overall_trend"`
	AlertLevel   string                          `json:"alert_level"`
}

func runForecast(args []string) int {
	fs := newFlagSet("forecast")
	steps := fs.Int("steps", 3, "number of future steps to predict")
	if !parseFlags(fs, args) {
		return 1
	}
	if *steps < 1 {
		fmt.Fprintln(os.Stderr, "error: --steps must be at least 1")
		return 1
	}

	var snapshots []forecastInputSnapshot
	scanner := bufio.NewScanner(os.Stdin)
	scanner.Buffer(make([]byte, 1024*1024), 1024*1024)
	for scanner.Scan() {
		line := scanner.Text()
		if len(line) == 0 {
			continue
		}
		var snap forecastInputSnapshot
		if err := json.Unmarshal([]byte(line), &snap); err != nil {
			fmt.Fprintf(os.Stderr, "error: malformed JSON input: %s\n", err)
			return 2
		}
		snapshots = append(snapshots, snap)
	}
	if err := scanner.Err(); err != nil {
		fmt.Fprintf(os.Stderr, "error: reading input: %s\n", err)
		return 1
	}
	if len(snapshots) < 3 {
		fmt.Fprintln(os.Stderr, "error: at least 3 valid input snapshots are required")
		return 1
	}

	risks := make([]float64, len(snapshots))
	threats := make([]float64, len(snapshots))
	for i, snap := range snapshots {
		risks[i] = snap.GlobalMeanRisk
		threats[i] = float64(snap.TotalThreats)
	}

	riskSlope, riskIntercept := olsLine(0, risks)
	threatSlope, threatIntercept := olsLine(0, threats)

	riskPredictions := predictLine(riskSlope, riskIntercept, len(snapshots), *steps)
	threatPredictions := predictLine(threatSlope, threatIntercept, len(snapshots), *steps)

	riskTrend := trendFromSlope(riskSlope)
	threatTrend := trendFromSlope(threatSlope)

	last := snapshots[len(snapshots)-1]
	metrics := map[string]forecastMetricResult{
		"global_mean_risk": {
			Slope:       json.Number(format4(riskSlope)),
			Intercept:   json.Number(format4(riskIntercept)),
			Trend:       riskTrend,
			LastValue:   json.Number(formatRiskValue(last.GlobalMeanRisk)),
			Predictions: roundAll4(riskPredictions),
		},
		"total_threats": {
			Slope:       json.Number(format4(threatSlope)),
			Intercept:   json.Number(format4(threatIntercept)),
			Trend:       threatTrend,
			LastValue:   json.Number(strconv.Itoa(last.TotalThreats)),
			Predictions: roundAll4(threatPredictions),
		},
	}

	out := forecastOutput{
		InputCount:   len(snapshots),
		Metrics:      metrics,
		OverallTrend: overallTrend(riskTrend, threatTrend),
		AlertLevel:   alertLevelFromSlopes(risks, threats, riskSlope, threatSlope),
	}

	encoded, err := json.Marshal(out)
	if err != nil {
		fmt.Fprintln(os.Stderr, "error: encoding forecast output:", err)
		return 1
	}
	fmt.Println(string(encoded))
	return 0
}

func olsLine(startIndex int, values []float64) (slope, intercept float64) {
	n := len(values)
	if n == 0 {
		return 0, 0
	}
	var sumX, sumY, sumXY, sumX2 float64
	for i, y := range values {
		x := float64(startIndex + i)
		sumX += x
		sumY += y
		sumXY += x * y
		sumX2 += x * x
	}

	denom := float64(n)*sumX2 - sumX*sumX
	if denom == 0 {
		slope = 0
		intercept = values[0]
		return
	}
	slope = (float64(n)*sumXY - sumX*sumY) / denom
	intercept = (sumY - slope*sumX) / float64(n)
	return
}

func predictLine(slope, intercept float64, startIndex, steps int) []float64 {
	predictions := make([]float64, steps)
	for i := 0; i < steps; i++ {
		predictions[i] = slope*float64(startIndex+i) + intercept
	}
	return predictions
}

func trendFromSlope(slope float64) string {
	r := roundHalfUp4(slope)
	if r > 0 {
		return "increasing"
	}
	if r < 0 {
		return "decreasing"
	}
	return "stable"
}

func overallTrend(a, b string) string {
	if a == "increasing" && b == "increasing" {
		return "increasing"
	}
	if a == "decreasing" && b == "decreasing" {
		return "decreasing"
	}
	if a == "increasing" || b == "increasing" {
		if a == "decreasing" || b == "decreasing" {
			return "mixed"
		}
		return "increasing"
	}
	if a == "decreasing" || b == "decreasing" {
		return "decreasing"
	}
	return "stable"
}

func alertLevelFromSlopes(risks, threats []float64, riskSlope, threatSlope float64) string {
	riskMean := meanOfValues(risks)
	threatMean := meanOfValues(threats)

	maxRatio := 0.0
	if riskSlope > 0 {
		ratio := riskSlope / math.Max(riskMean, 1.0)
		if ratio > maxRatio {
			maxRatio = ratio
		}
	}
	if threatSlope > 0 {
		ratio := threatSlope / math.Max(threatMean, 1.0)
		if ratio > maxRatio {
			maxRatio = ratio
		}
	}

	if maxRatio >= 0.5 {
		return "critical"
	}
	if maxRatio >= 0.2 {
		return "warning"
	}
	return "normal"
}

func meanOfValues(values []float64) float64 {
	if len(values) == 0 {
		return 0
	}
	var sum float64
	for _, v := range values {
		sum += v
	}
	return sum / float64(len(values))
}

func roundAll4(values []float64) []json.Number {
	out := make([]json.Number, len(values))
	for i, v := range values {
		out[i] = json.Number(format4(v))
	}
	return out
}
