   456	
   457	func computeFreshness(p processedIOC, refTime time.Time) (float64, float64, bool) {
   458		ageHours := refTime.Sub(p.lastUpdated).Hours()
   459		freshnessFraction := ageHours / float64(p.ttlHours)
   460		if freshnessFraction >= 1.0 {
   461			return 0, 0, false
   462		}
   463		factor := freshnessFactor(freshnessFraction)
   464		return p.entry.Confidence * factor, factor, true
   465	}
   466	
   467	func freshnessFactor(fraction float64) float64 {
   468		switch {
   469		case fraction < 0.25:
   470			return 1.0
   471		case fraction < 0.50:
   472			return 0.9
   473		case fraction < 0.75:
   474			return 0.7
   475		default:
   476			return 0.5
   477		}
   478	}
   479	
   480	func fieldMultiplier(field string) float64 {
   481		switch field {
   482		case "source_ip", "dest_ip", "compromised_hosts", "user":
   483			return 1.0
   484		case "dest_ips", "target_users":
   485			return 0.8
   486		case "ports_scanned":
   487			return 0.6
   488		default:
   489			return 0.0
   490		}
   491	}
   492	
   493	func maxFieldMultiplier(fields []string) float64 {
   494		max := 0.0
   495		for _, f := range fields {
   496			if m := fieldMultiplier(f); m > max {
   497				max = m
   498			}
   499		}
   500		return max
   501	}
   502	
   503	func tagBonusValue(tag string) float64 {
   504		switch tag {
   505		case "apt":
   506			return 100.0
   507		case "ransomware":
   508			return 75.0
   509		case "botnet":
   510			return 50.0
   511		case "phishing":
   512			return 30.0
   513		case "scanner":
   514			return 25.0
   515		case "cryptominer":
   516			return 20.0
   517		default:
   518			return 0.0
   519		}
   520	}
   521	
   522	func severityWeight(s string) int {
   523		switch s {
   524		case "low":
   525			return 5
   526		case "medium":
   527			return 10
   528		case "high":
   529			return 20
   530		case "critical":
   531			return 40
   532		default:
   533			return 0
   534		}
   535	}
   536	
   537	func severityFromRank(rank int) string {
   538		switch rank {
   539		case 1:
   540			return "low"
   541		case 2:
   542			return "medium"
   543		case 3:
   544			return "high"
   545		case 4:
   546			return "critical"
   547		default:
   548			return "none"
   549		}
   550	}
   551	
   552	func threatReferenceTime(threat map[string]interface{}) time.Time {
   553		if tt, ok := getString(threat, "threat_type"); ok && tt == "privilege_escalation" {
   554			if ts, ok := getString(threat, "timestamp"); ok {
   555				if t, err := parseTime(ts); err == nil {
   556					return t
   557				}
   558			}
   559		}
   560		if ts, ok := getString(threat, "first_seen"); ok {
   561			if t, err := parseTime(ts); err == nil {
   562				return t
   563			}
   564		}
   565		return time.Time{}
   566	}
   567	
   568	func sortEnrichedThreats(threats []map[string]interface{}) {
   569		sort.SliceStable(threats, func(i, j int) bool {
   570			a := threats[i]
   571			b := threats[j]
   572			ea, _ := getFloat(a, "enriched_risk_score")
   573			eb, _ := getFloat(b, "enriched_risk_score")
   574			if ea != eb {
   575				return ea > eb
   576			}
   577			ta := threatSortTime(a)
   578			tb := threatSortTime(b)
   579			if !ta.Equal(tb) {
   580				return ta.Before(tb)
   581			}
   582			tta, _ := getString(a, "threat_type")
   583			ttb, _ := getString(b, "threat_type")
   584			return tta < ttb
   585		})
   586	}
   587	
   588	func threatSortTime(threat map[string]interface{}) time.Time {
   589		if tt, ok := getString(threat, "threat_type"); ok && tt == "privilege_escalation" {
   590			if ts, ok := getString(threat, "timestamp"); ok {
   591				if t, err := parseTime(ts); err == nil {
   592					return t
   593				}
   594			}
   595		}
   596		if ts, ok := getString(threat, "first_seen"); ok {
   597			if t, err := parseTime(ts); err == nil {
   598				return t
   599			}
   600		}
   601		return time.Time{}
   602	}
   603	
   604	func getString(m map[string]interface{}, key string) (string, bool) {
   605		v, ok := m[key]
   606		if !ok {
   607			return "", false
   608		}
   609		s, ok := v.(string)
   610		return s, ok
   611	}
   612	
   613	func getStringSlice(m map[string]interface{}, key string) ([]string, bool) {
   614		v, ok := m[key]
   615		if !ok {
   616			return nil, false
   617		}
   618		switch val := v.(type) {
   619		case []string:
   620			return val, true
   621		case []interface{}:
   622			out := make([]string, 0, len(val))
   623			for _, e := range val {
   624				s, ok := e.(string)
   625				if !ok {
   626					return nil, false
   627				}
   628				out = append(out, s)
   629			}
   630			return out, true
   631		default:
   632			return nil, false
   633		}
   634	}
   635	
   636	func getFloat(m map[string]interface{}, key string) (float64, bool) {
   637		v, ok := m[key]
   638		if !ok {
   639			return 0, false
