    47		if !parseFlags(fs, args) {
    48			return 1
    49		}
    50	
    51		if *window < 2 {
    52			fmt.Fprintln(os.Stderr, "error: --window must be at least 2")
    53			return 1
    54		}
    55	
    56		var snapshots []anomalyInputSnapshot
