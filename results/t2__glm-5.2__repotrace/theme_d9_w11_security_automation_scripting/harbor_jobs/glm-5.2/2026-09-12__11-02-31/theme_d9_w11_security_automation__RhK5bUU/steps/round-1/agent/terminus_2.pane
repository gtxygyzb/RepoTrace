   119				continue
   120			}
   121			queue := []int{start}
   122			visited[start] = true
   123			component := []int{start}
   124			for len(queue) > 0 {
   125				cur := queue[0]
   126				queue = queue[1:]
   127				for next := 0; next < n; next++ {
   128					if !visited[next] && linked[cur][next] {
   129						visited[next] = true
   130						queue = append(queue, next)
   131						component = append(component, next)
   132					}
   133				}
   134			}
   135			if len(component) < *minCampaignSize {
   136				continue
   137			}
   138			campaigns = append(campaigns, buildCorrelateCampaign(threats, component, linked))
   139		}
   140	
   141		sort.SliceStable(campaigns, func(i, j int) bool {
   142			if !campaigns[i].earliestTime.Equal(campaigns[j].earliestTime) {
   143				return campaigns[i].earliestTime.Before(campaigns[j].earliestTime)
   144			}
   145			return campaigns[i].minThreatType < campaigns[j].minThreatType
   146		})
   147		for i := range campaigns {
   148			campaigns[i].CampaignID = fmt.Sprintf("CAMP-%03d", i+1)
   149		}
   150	
   151		sort.SliceStable(campaigns, func(i, j int) bool {
   152			if campaigns[i].CombinedRisk != campaigns[j].CombinedRisk {
   153				return campaigns[i].CombinedRisk > campaigns[j].CombinedRisk
   154			}
   155			if campaigns[i].Cohesion != campaigns[j].Cohesion {
   156				return campaigns[i].Cohesion > campaigns[j].Cohesion
   157			}
   158			return campaigns[i].CampaignID < campaigns[j].CampaignID
   159		})
