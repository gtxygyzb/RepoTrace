   148	func nonNilStrings(s []string) []string {
   149		if s == nil {
   150			return []string{}
   151		}
   152		return s
   153	}
   154	
   155	func nonNilInts(s []int) []int {
   156		if s == nil {
   157			return []int{}
   158		}
   159		return s
   160	}
   161	
   162	func sortEvents(events []Event) {
   163		sort.SliceStable(events, func(i, j int) bool {
   164			ti, errI := parseTime(events[i].Timestamp)
   165			tj, errJ := parseTime(events[j].Timestamp)
   166			if errI == nil && errJ == nil {
   167				if ti.Before(tj) {
   168					return true
   169				}
   170				if tj.Before(ti) {
   171					return false
   172				}
   173				return events[i].Timestamp < events[j].Timestamp
   174			}
   175			return events[i].Timestamp < events[j].Timestamp
   176		})
   177	}
   178	
   179	func eventTime(e Event) (time.Time, bool) {
   180		t, err := parseTime(e.Timestamp)
   181		return t, err == nil
   182	}
   183	
   184	func detectThreats(events []Event) []Threat {
   185		sortEvents(events)
   186		var threats []Threat
   187		threats = append(threats, detectBruteForce(events)...)
   188		threats = append(threats, detectPortScan(events)...)
   189		threats = append(threats, detectDataExfiltration(events)...)
   190		threats = append(threats, detectPrivilegeEscalation(events)...)
   191		threats = append(threats, detectLateralMovement(events)...)
   192		threats = append(threats, detectDNSTunneling(events)...)
   193		sortThreats(threats)
   194		return threats
   195	}
   196	
   197	func sortThreats(threats []Threat) {
   198		sort.SliceStable(threats, func(i, j int) bool {
   199			if threats[i].RiskScore != threats[j].RiskScore {
   200				return threats[i].RiskScore > threats[j].RiskScore
   201			}
   202			if !threats[i].firstTime.Equal(threats[j].firstTime) {
   203				return threats[i].firstTime.Before(threats[j].firstTime)
   204			}
   205			return threats[i].ThreatType < threats[j].ThreatType
   206		})
   207	}
   208	
   209	func detectBruteForce(events []Event) []Threat {
   210		byIP := make(map[string][]Event)
   211		for _, e := range events {
   212			if e.EventType == "auth_failure" {
   213				byIP[e.SourceIP] = append(byIP[e.SourceIP], e)
   214			}
   215		}
   216	
   217		var threats []Threat
   218		for ip, evs := range byIP {
   219			for i := 0; i < len(evs); i++ {
   220				start, ok := eventTime(evs[i])
   221				if !ok {
   222					continue
   223				}
   224				var window []Event
   225				for j := i; j < len(evs); j++ {
   226					t, ok := eventTime(evs[j])
   227					if !ok {
   228						continue
   229					}
   230					if t.Sub(start) <= 60*time.Second {
   231						window = append(window, evs[j])
   232					} else {
   233						break
   234					}
   235				}
   236				if len(window) >= 5 {
   237					users := make([]string, 0, len(window))
   238					for _, e := range window {
   239						users = append(users, e.User)
   240					}
   241					users = uniqueSortedStrings(users)
   242					risk := float64(len(window)) * 5.0
   243					if len(users) > 3 {
   244						risk = float64(len(window)) * 10.0
   245					}
   246					last, ok := eventTime(window[len(window)-1])
   247					if !ok {
   248						last = start
   249					}
   250					threats = append(threats, Threat{
   251						ThreatType:  "brute_force",
   252						SourceIP:    ip,
   253						Count:       len(window),
   254						FirstSeen:   window[0].Timestamp,
   255						LastSeen:    window[len(window)-1].Timestamp,
   256						TargetUsers: users,
   257						RiskScore:   risk,
   258						firstTime:   start,
   259						lastTime:    last,
   260					})
   261					break
   262				}
   263			}
   264		}
   265		return threats
   266	}
   267	
   268	func detectPortScan(events []Event) []Threat {
   269		byPair := make(map[string][]Event)
   270		for _, e := range events {
   271			if e.EventType == "connection" || e.EventType == "port_scan" {
   272				key := e.SourceIP + "|" + e.DestIP
   273				byPair[key] = append(byPair[key], e)
   274			}
   275		}
   276	
   277		var threats []Threat
   278		for pair, evs := range byPair {
   279			parts := splitKey(pair)
   280			ip := parts[0]
   281			dest := parts[1]
   282			for i := 0; i < len(evs); i++ {
   283				start, ok := eventTime(evs[i])
   284				if !ok {
   285					continue
   286				}
   287				var window []Event
   288				for j := i; j < len(evs); j++ {
   289					t, ok := eventTime(evs[j])
   290					if !ok {
   291						continue
   292					}
   293					if t.Sub(start) <= 300*time.Second {
   294						window = append(window, evs[j])
   295					} else {
   296						break
   297					}
   298				}
   299				ports := make([]int, 0, len(window))
   300				for _, e := range window {
   301					ports = append(ports, e.DestPort)
   302				}
   303				ports = uniqueSortedInts(ports)
   304				if len(ports) >= 10 {
   305					risk := float64(len(ports)) * 3.0
   306					if hasSensitivePort(ports) {
   307						risk += 20.0
   308					}
   309					last, ok := eventTime(window[len(window)-1])
   310					if !ok {
   311						last = start
   312					}
   313					threats = append(threats, Threat{
   314						ThreatType:   "port_scan",
   315						SourceIP:     ip,
   316						DestIP:       dest,
   317						PortsScanned: ports,
   318						FirstSeen:    window[0].Timestamp,
   319						LastSeen:     window[len(window)-1].Timestamp,
   320						RiskScore:    risk,
