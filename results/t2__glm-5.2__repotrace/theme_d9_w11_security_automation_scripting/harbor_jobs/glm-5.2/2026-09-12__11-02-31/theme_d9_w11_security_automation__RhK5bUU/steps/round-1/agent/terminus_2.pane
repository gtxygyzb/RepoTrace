   188		threats = append(threats, detectPortScan(events)...)
   189		threats = append(threats, detectDataExfiltration(events)...)
   190		threats = append(threats, detectPrivilegeEscalation(events)...)
   191		threats = append(threats, detectLateralMovement(events)...)
   192		threats = append(threats, detectDNSTunneling(events)...)
   193		sortThreats(threats)
   194		return threats
   195	}
   196	
   197	func sortThreats(threats []Threat) {
   198		sort.SliceStable(threats, func(i, j int) bool {
   199			if threats[i].RiskScore != threats[j].RiskScore {
   200				return threats[i].RiskScore > threats[j].RiskScore
   201			}
   202			if !threats[i].firstTime.Equal(threats[j].firstTime) {
   203				return threats[i].firstTime.Before(threats[j].firstTime)
   204			}
   205			return threats[i].ThreatType < threats[j].ThreatType
   206		})
   207	}
