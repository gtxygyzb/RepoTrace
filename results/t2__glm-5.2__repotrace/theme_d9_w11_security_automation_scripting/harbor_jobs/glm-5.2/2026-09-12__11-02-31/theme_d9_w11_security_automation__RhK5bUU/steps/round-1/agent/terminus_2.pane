   189			squaredSum += diff * diff
   190		}
   191		stddev := math.Sqrt(squaredSum / float64(n))
   192	
   193		return mean, stddev
   194	}
   195	
   196	func zScore(current, mean, stddev float64) float64 {
   197		if stddev == 0 {
   198			if current == mean {
   199				return 0.0
   200			}
   201			if current > mean {
   202				return 999.0
   203			}
   204			return -999.0
   205		}
   206		return (current - mean) / stddev
   207	}
   208	
   209	func roundHalfUp4(f float64) float64 {
   210		pow := 10000.0
   211		return math.Copysign(math.Floor(math.Abs(f)*pow+0.5)/pow, f)
   212	}
   213	
   214	func format4(f float64) string {
   215		rounded := roundHalfUp4(f)
   216		if rounded == 0 {
   217			return "0.0000"
   218		}
   219		return fmt.Sprintf("%.4f", rounded)
   220	}
   221	
   222	func formatRiskValue(f float64) string {
   223		s := strconv.FormatFloat(f, 'f', -1, 64)
   224		if !strings.Contains(s, ".") {
   225			s += ".0"
   226		}
   227		return s
   228	}
