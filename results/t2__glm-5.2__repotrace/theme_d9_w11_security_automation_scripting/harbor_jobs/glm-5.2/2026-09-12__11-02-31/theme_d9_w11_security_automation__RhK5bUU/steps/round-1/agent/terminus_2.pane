[?2004lpackage main

import (
        "bufio"
        "encoding/json"
        "fmt"
        "math"
        "os"
        "strconv"
)

type rateMetricResult struct {
        MeanRate    json.Number `json:"mean_rate"`
        MaxRate     json.Number `json:"max_rate"`
        MinRate     json.Number `json:"min_rate"`
        Volatility  json.Number `json:"volatility"`
        Stability   string      `json:"stability"`
        Deltas      []json.Number `json:"deltas"`
}

type rateOutput struct {
        InputCount       int                       `json:"input_count"`
        StepCount        int                       `json:"step_count"`
        Metrics          map[string]rateMetricResult `json:"metrics"`
        OverallStability string                    `json:"overall_stability"`
}

func runRate(args []string) int {
        fs := newFlagSet("rate")
        minSnapshots := fs.Int("min-snapshots", 2, "minimum number of input snapshots")
        if !parseFlags(fs, args) {
                return 1
        }
        if *minSnapshots < 2 {
                fmt.Fprintln(os.Stderr, "error: --min-snapshots must be at least 2")
                return 1
        }

        var snapshots []forecastInputSnapshot
        scanner := bufio.NewScanner(os.Stdin)
        scanner.Buffer(make([]byte, 1024*1024), 1024*1024)
        for scanner.Scan() {
                line := scanner.Text()
                if len(line) == 0 {
                        continue
                }
                var snap forecastInputSnapshot
                if err := json.Unmarshal([]byte(line), &snap); err != nil {
                        fmt.Fprintf(os.Stderr, "error: malformed JSON input: %s\n", err)
                        return 2
                }
                snapshots = append(snapshots, snap)
        }
        if err := scanner.Err(); err != nil {
                fmt.Fprintf(os.Stderr, "error: reading input: %s\n", err)
                return 1
        }
        if len(snapshots) < *minSnapshots {
                fmt.Fprintf(os.Stderr, "error: at least %d valid input snapshots are required\n", *minSnapshots)
                return 1
        }

        riskDeltas := make([]float64, 0, len(snapshots)-1)
        threatDeltas := make([]int, 0, len(snapshots)-1)
        for i := 0; i < len(snapshots)-1; i++ {
                riskDeltas = append(riskDeltas, snapshots[i+1].GlobalMeanRisk-snapshots[i].GlobalMeanRisk)
                threatDeltas = append(threatDeltas, snapshots[i+1].TotalThreats-snapshots[i].TotalThreats)
        }

        metrics := map[string]rateMetricResult{
                "global_mean_risk": buildRateMetric(riskDeltasAsNumbers(riskDeltas), true),
                "total_threats":    buildRateMetric(threatDeltasAsNumbers(threatDeltas), false),
        }

        out := rateOutput{
                InputCount:       len(snapshots),
                StepCount:        len(riskDeltas),
                Metrics:          metrics,
                OverallStability: overallRateStability(metrics),
        }

        encoded, err := json.Marshal(out)
        if err != nil {
                fmt.Fprintln(os.Stderr, "error: encoding rate output:", err)
                return 1
        }
        fmt.Println(string(encoded))
        return 0
}

func buildRateMetric(deltas []json.Number, isRisk bool) rateMetricResult {
        if len(deltas) == 0 {
                return rateMetricResult{
                        MeanRate:    json.Number(format4(0)),
                        MaxRate:     json.Number("0"),
                        MinRate:     json.Number("0"),
                        Volatility:  json.Number(format4(0)),
                        Stability:   "stable",
                        Deltas:      deltas,
                }
        }

        floatDeltas := make([]float64, len(deltas))
        for i, d := range deltas {
                v, _ := d.Float64()
                floatDeltas[i] = v
        }

        meanRate := meanOfValues(floatDeltas)
        maxRate := maxRateDelta(floatDeltas)
        minRate := minRateDelta(floatDeltas)
        volatility := populationStdDev(floatDeltas)
        stability := rateStability(volatility, math.Abs(meanRate))

        var maxNum, minNum json.Number
        if isRisk {
                maxNum = json.Number(format4(maxRate))
                minNum = json.Number(format4(minRate))
        } else {
                maxNum = json.Number(strconv.Itoa(int(maxRate)))
                minNum = json.Number(strconv.Itoa(int(minRate)))
        }

        return rateMetricResult{
                MeanRate:    json.Number(format4(meanRate)),
                MaxRate:     maxNum,
                MinRate:     minNum,
                Volatility:  json.Number(format4(volatility)),
                Stability:   stability,
                Deltas:      deltas,
        }
}

func riskDeltasAsNumbers(deltas []float64) []json.Number {
        out := make([]json.Number, len(deltas))
        for i, d := range deltas {
                out[i] = json.Number(format4(d))
        }
        return out
}

func threatDeltasAsNumbers(deltas []int) []json.Number {
        out := make([]json.Number, len(deltas))
        for i, d := range deltas {
                out[i] = json.Number(strconv.Itoa(d))
        }
        return out
}

func maxRateDelta(deltas []float64) float64 {
        var best float64
        for i, d := range deltas {
                if i == 0 {
                        best = d
                        continue
                }
                if math.Abs(d) > math.Abs(best) || (math.Abs(d) == math.Abs(best) && d > best) {
                        best = d
                }
        }
        return best
}

func minRateDelta(deltas []float64) float64 {
        var best float64
        for i, d := range deltas {
                if i == 0 {
                        best = d
                        continue
                }
                if math.Abs(d) < math.Abs(best) || (math.Abs(d) == math.Abs(best) && d > best) {
                        best = d
                }
        }
        return best
}

func populationStdDev(values []float64) float64 {
        if len(values) == 0 {
                return 0
        }
        mean := meanOfValues(values)
        var sumSqDiff float64
        for _, v := range values {
                diff := v - mean
                sumSqDiff += diff * diff
        }
        return math.Sqrt(sumSqDiff / float64(len(values)))
}

func rateStability(volatility, absMeanRate float64) string {
        if volatility < 0.1*math.Max(absMeanRate, 1.0) {
                return "stable"
        }
        return "volatile"
}

func overallRateStability(metrics map[string]rateMetricResult) string {
        if metrics["global_mean_risk"].Stability == "stable" && metrics["total_threats"].Stability == "stable" {
                return "stable"
        }
        return "volatile"
}
