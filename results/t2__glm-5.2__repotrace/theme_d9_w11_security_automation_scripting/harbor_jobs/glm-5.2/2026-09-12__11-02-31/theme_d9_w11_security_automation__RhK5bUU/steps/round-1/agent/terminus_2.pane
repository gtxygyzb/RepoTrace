    38	func newFlagSet(name string) *flag.FlagSet {
    39		fs := flag.NewFlagSet(name, flag.ContinueOnError)
    40		fs.SetOutput(os.Stderr)
    41		fs.Usage = func() {}
    42		return fs
    43	}
    44	
    45	func parseFlags(fs *flag.FlagSet, args []string) bool {
    46		if err := fs.Parse(args); err != nil {
    47			return false
    48		}
    49		return true
    50	}
    51	
    52	func isFlagSet(fs *flag.FlagSet, name string) bool {
    53		set := false
    54		fs.Visit(func(f *flag.Flag) {
    55			if f.Name == name {
    56				set = true
    57			}
    58		})
    59		return set
    60	}
