import (
	"flag"
	"fmt"
	"os"
)

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|track|diff|anomaly|forecast|histogram> [flags]")
		os.Exit(1)
	}

	var code int
	switch os.Args[1] {
	case "prioritize":
		code = runPrioritize(os.Args[2:])
	case "analyze":
		code = runAnalyze(os.Args[2:])
	case "summarize":
		code = runSummarize(os.Args[2:])
	case "filter":
		code = runFilter(os.Args[2:])
	case "respond":
		code = runRespond(os.Args[2:])
	case "enrich":
		code = runEnrich(os.Args[2:])
	case "correlate":
		code = runCorrelate(os.Args[2:])
	case "timeline":
		code = runTimeline(os.Args[2:])
	case "snapshot":
		code = runSnapshot(os.Args[2:])
	case "alert":
		code = runAlert(os.Args[2:])
	case "aggregate":
		code = runAggregate(os.Args[2:])
	case "diff":
		code = runDiff(os.Args[2:])
	case "anomaly":
		code = runAnomaly(os.Args[2:])
	case "track":
		code = runTrack(os.Args[2:])
	case "forecast":
		code = runForecast(os.Args[2:])
	case "histogram":
		code = runHistogram(os.Args[2:])
	default:
		fmt.Fprintf(os.Stderr, "invalid subcommand: %s\n", os.Args[1])
		code = 1
	}
	os.Exit(code)
}

func newFlagSet(name string) *flag.FlagSet {
	fs := flag.NewFlagSet(name, flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	fs.Usage = func() {}
	return fs
}

func parseFlags(fs *flag.FlagSet, args []string) bool {
	if err := fs.Parse(args); err != nil {
		return false
	}
	return true
}

func isFlagSet(fs *flag.FlagSet, name string) bool {
	set := false
	fs.Visit(func(f *flag.Flag) {
		if f.Name == name {
			set = true
		}
	})
	return set
}
