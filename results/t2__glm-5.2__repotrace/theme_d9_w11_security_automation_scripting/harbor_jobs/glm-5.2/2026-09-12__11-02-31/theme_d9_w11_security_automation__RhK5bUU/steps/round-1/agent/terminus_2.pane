    34	func runAggregate(args []string) int {
    35		report := aggregateReport{
    36			CombinedActorCounts: map[string]int{},
    37			TypeCounts:          map[string]int{},
    38		}
    39	
    40		reader := bufio.NewReader(os.Stdin)
    41		weightedRiskSum := 0.0
    42		maxMeanRisk := 0.0
    43		dominantTypeCounts := map[string]int{}
    44		actorCounts := map[string]int{}
    45		snapshotCount := 0
    46	
    47		for {
    48			line, err := reader.ReadString('\n')
    49			trimmed := strings.TrimSpace(line)
    50			if trimmed == "" {
    51				if err == io.EOF {
    52					break
    53				}
    54				continue
    55			}
    56	
    57			var snap aggregateSnapshot
    58			if jerr := json.Unmarshal([]byte(trimmed), &snap); jerr != nil {
    59				fmt.Fprintln(os.Stderr, "error: malformed JSON input:", jerr)
    60				return 2
    61			}
    62	
    63			snapshotCount++
    64			report.TotalThreats += snap.TotalThreats
    65			report.TotalCampaigns += snap.ActiveCampaigns
    66			weightedRiskSum += snap.MeanEnrichedRisk * float64(snap.TotalThreats)
    67			if snap.MeanEnrichedRisk > maxMeanRisk {
    68				maxMeanRisk = snap.MeanEnrichedRisk
    69			}
    70			for actor, count := range snap.ActorThreatCounts {
    71				actorCounts[actor] += count
    72			}
    73			dominantType := snap.DominantThreatType
    74			dominantTypeCounts[dominantType]++
    75			report.TypeCounts[dominantType] += snap.TotalThreats
    76	
    77			if err == io.EOF {
    78				break
    79			}
    80		}
    81	
    82		report.SnapshotCount = snapshotCount
    83		if report.TotalThreats > 0 {
    84			report.GlobalMeanRisk = round2(weightedRiskSum / float64(report.TotalThreats))
    85		} else {
    86			report.GlobalMeanRisk = 0.0
    87		}
    88		report.GlobalMaxMeanRisk = round2(maxMeanRisk)
    89		report.GlobalRiskCategory = snapshotRiskCategory(report.GlobalMeanRisk)
    90		report.CombinedActorCounts = actorCounts
    91		report.TopActor = topActorFromCounts(actorCounts)
    92		report.DominantThreatType = topDominantType(dominantTypeCounts)
    93	
    94		if report.CombinedActorCounts == nil {
    95			report.CombinedActorCounts = map[string]int{}
    96		}
    97		if report.TypeCounts == nil {
    98			report.TypeCounts = map[string]int{}
    99		}
   100	
   101		out, err := json.Marshal(report)
   102		if err != nil {
   103			fmt.Fprintln(os.Stderr, "error: encoding aggregate report:", err)
   104			return 1
   105		}
   106		fmt.Println(string(out))
   107		return 0
   108	}
