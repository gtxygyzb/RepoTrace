    42	func newFlagSet(name string) *flag.FlagSet {
    43		fs := flag.NewFlagSet(name, flag.ContinueOnError)
    44		fs.SetOutput(os.Stderr)
    45		fs.Usage = func() {}
    46		return fs
    47	}
