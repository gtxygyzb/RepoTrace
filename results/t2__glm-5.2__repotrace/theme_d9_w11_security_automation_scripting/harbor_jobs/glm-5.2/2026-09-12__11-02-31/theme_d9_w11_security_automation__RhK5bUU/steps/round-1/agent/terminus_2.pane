[?2004hroot@n30009:/app# sed -n '250,620p' enrich.go
[?2004l	actorBonus := 0.0
	switch len(actors) {
	case 0, 1:
		actorBonus = 0.0
	case 2:
		actorBonus = 15.0
	default:
		actorBonus = 30.0
	}

	enrichedScore := riskScore*(1.0+maxConf) + tagBonus + multiVectorBonus + float64(severityContrib) + actorBonus

	outMatches := make([]iocMatchOutput, 0, len(matches))
	for _, m := range matches {
		outMatches = append(outMatches, iocMatchOutput{
			IocID:         m.p.entry.ID,
			Indicator:     m.p.entry.Indicator,
			IndicatorType: m.p.entry.IndicatorType,
			ThreatActor:   m.p.entry.ThreatActor,
			Confidence:    m.p.entry.Confidence,
			Tags:          nonNilStrings(m.p.entry.Tags),
			MatchedFields: nonNilStrings(m.matchedFields),
		})
	}

	threat["ioc_matches"] = outMatches
	threat["enriched_risk_score"] = enrichedScore
	threat["threat_actors"] = nonNilStrings(sortedUniqueStringsFromSet(actors))
	threat["max_ioc_confidence"] = maxConf
	if len(matches) == 0 {
		threat["ioc_severity"] = "none"
	} else {
		threat["ioc_severity"] = severityFromRank(sevRank)
	}
	return threat
}

func computeIOCMatches(threat map[string]interface{}, iocs []processedIOC, refTime time.Time, minConf float64) []iocMatchInternal {
	active := make([]activeIOC, 0, len(iocs))
	for _, p := range iocs {
		base, factor, ok := computeFreshness(p, refTime)
		if !ok {
			continue
		}
		if base < minConf {
			continue
		}
		active = append(active, activeIOC{p: p, base: base, factor: factor})
	}

	matchedFields := make([]map[string]bool, len(active))
	for i := range active {
		matchedFields[i] = make(map[string]bool)
	}

	type cidrCandidate struct {
		activeIdx int
		base      float64
		prefixLen int
		iocID     string
	}
	cidrCandidates := make(map[string]map[string][]cidrCandidate)

	addCIDRCandidate := func(field, ipStr string, idx int, a activeIOC) {
		if cidrCandidates[field] == nil {
			cidrCandidates[field] = make(map[string][]cidrCandidate)
		}
		cidrCandidates[field][ipStr] = append(cidrCandidates[field][ipStr], cidrCandidate{
			activeIdx: idx,
			base:      a.base,
			prefixLen: a.p.prefixLen,
			iocID:     a.p.entry.ID,
		})
	}

	shadowPairs := make(map[string]bool)
	addShadow := func(field, ip string) {
		shadowPairs[field+"\x00"+ip] = true
	}
	isShadowed := func(field, ip string) bool {
		return shadowPairs[field+"\x00"+ip]
	}

	for i, a := range active {
		switch a.p.entry.IndicatorType {
		case "ipv4":
			if val, ok := getString(threat, "source_ip"); ok && a.p.entry.Indicator == val {
				matchedFields[i]["source_ip"] = true
				addShadow("source_ip", val)
			}
			if val, ok := getString(threat, "dest_ip"); ok && a.p.entry.Indicator == val {
				matchedFields[i]["dest_ip"] = true
				addShadow("dest_ip", val)
			}
			if vals, ok := getStringSlice(threat, "dest_ips"); ok {
				for _, val := range vals {
					if a.p.entry.Indicator == val {
						matchedFields[i]["dest_ips"] = true
						addShadow("dest_ips", val)
						break
					}
				}
			}
			if vals, ok := getStringSlice(threat, "compromised_hosts"); ok {
				for _, val := range vals {
					if a.p.entry.Indicator == val {
						matchedFields[i]["compromised_hosts"] = true
						addShadow("compromised_hosts", val)
						break
					}
				}
			}
		case "port":
			if vals, ok := getIntSlice(threat, "ports_scanned"); ok {
				for _, val := range vals {
					if a.p.port == val {
						matchedFields[i]["ports_scanned"] = true
						break
					}
				}
			}
		case "user":
			if val, ok := getString(threat, "user"); ok && a.p.entry.Indicator == val {
				matchedFields[i]["user"] = true
			}
			if vals, ok := getStringSlice(threat, "target_users"); ok {
				for _, val := range vals {
					if a.p.entry.Indicator == val {
						matchedFields[i]["target_users"] = true
						break
					}
				}
			}
		}
	}

	for i, a := range active {
		if a.p.entry.IndicatorType != "ipv4_cidr" {
			continue
		}
		if val, ok := getString(threat, "source_ip"); ok {
			if ip := net.ParseIP(val); ip != nil && a.p.ipNet.Contains(ip) && !isShadowed("source_ip", val) {
				addCIDRCandidate("source_ip", val, i, a)
			}
		}
		if val, ok := getString(threat, "dest_ip"); ok {
			if ip := net.ParseIP(val); ip != nil && a.p.ipNet.Contains(ip) && !isShadowed("dest_ip", val) {
				addCIDRCandidate("dest_ip", val, i, a)
			}
		}
		if vals, ok := getStringSlice(threat, "dest_ips"); ok {
			for _, val := range vals {
				if ip := net.ParseIP(val); ip != nil && a.p.ipNet.Contains(ip) && !isShadowed("dest_ips", val) {
					addCIDRCandidate("dest_ips", val, i, a)
				}
			}
		}
		if vals, ok := getStringSlice(threat, "compromised_hosts"); ok {
			for _, val := range vals {
				if ip := net.ParseIP(val); ip != nil && a.p.ipNet.Contains(ip) && !isShadowed("compromised_hosts", val) {
					addCIDRCandidate("compromised_hosts", val, i, a)
				}
			}
		}
	}

	for field, ipMap := range cidrCandidates {
		for _, cands := range ipMap {
			sort.Slice(cands, func(i, j int) bool {
				if cands[i].prefixLen != cands[j].prefixLen {
					return cands[i].prefixLen > cands[j].prefixLen
				}
				if cands[i].base != cands[j].base {
					return cands[i].base > cands[j].base
				}
				return cands[i].iocID < cands[j].iocID
			})
			winner := cands[0].activeIdx
			matchedFields[winner][field] = true
		}
	}

	matches := make([]iocMatchInternal, 0, len(active))
	for i, a := range active {
		if len(matchedFields[i]) == 0 {
			continue
		}
		fields := sortedKeys(matchedFields[i])
		adjusted := a.base * maxFieldMultiplier(fields)
		matches = append(matches, iocMatchInternal{
			p:             a.p,
			base:          a.base,
			freshness:     a.factor,
			adjusted:      adjusted,
			matchedFields: fields,
		})
	}

	sort.SliceStable(matches, func(i, j int) bool {
		if matches[i].adjusted != matches[j].adjusted {
			return matches[i].adjusted > matches[j].adjusted
		}
		return matches[i].p.entry.ID < matches[j].p.entry.ID
	})
	return matches
}

func computeFreshness(p processedIOC, refTime time.Time) (float64, float64, bool) {
	ageHours := refTime.Sub(p.lastUpdated).Hours()
	freshnessFraction := ageHours / float64(p.ttlHours)
	if freshnessFraction >= 1.0 {
		return 0, 0, false
	}
	factor := freshnessFactor(freshnessFraction)
	return p.entry.Confidence * factor, factor, true
}

func freshnessFactor(fraction float64) float64 {
	switch {
	case fraction < 0.25:
		return 1.0
	case fraction < 0.50:
		return 0.9
	case fraction < 0.75:
		return 0.7
	default:
		return 0.5
	}
}

func fieldMultiplier(field string) float64 {
	switch field {
	case "source_ip", "dest_ip", "compromised_hosts", "user":
		return 1.0
	case "dest_ips", "target_users":
		return 0.8
	case "ports_scanned":
		return 0.6
	default:
		return 0.0
	}
}

func maxFieldMultiplier(fields []string) float64 {
	max := 0.0
	for _, f := range fields {
		if m := fieldMultiplier(f); m > max {
			max = m
		}
	}
	return max
}

func tagBonusValue(tag string) float64 {
	switch tag {
	case "apt":
		return 100.0
	case "ransomware":
		return 75.0
	case "botnet":
		return 50.0
	case "phishing":
		return 30.0
	case "scanner":
		return 25.0
	case "cryptominer":
		return 20.0
	default:
		return 0.0
	}
}

func severityWeight(s string) int {
	switch s {
	case "low":
		return 5
	case "medium":
		return 10
	case "high":
		return 20
	case "critical":
		return 40
	default:
		return 0
	}
}

func severityFromRank(rank int) string {
	switch rank {
	case 1:
		return "low"
	case 2:
		return "medium"
	case 3:
		return "high"
	case 4:
		return "critical"
	default:
		return "none"
	}
}

func threatReferenceTime(threat map[string]interface{}) time.Time {
	if tt, ok := getString(threat, "threat_type"); ok && tt == "privilege_escalation" {
		if ts, ok := getString(threat, "timestamp"); ok {
			if t, err := parseTime(ts); err == nil {
				return t
			}
		}
	}
	if ts, ok := getString(threat, "first_seen"); ok {
		if t, err := parseTime(ts); err == nil {
			return t
		}
	}
	return time.Time{}
}

func sortEnrichedThreats(threats []map[string]interface{}) {
	sort.SliceStable(threats, func(i, j int) bool {
		a := threats[i]
		b := threats[j]
		ea, _ := getFloat(a, "enriched_risk_score")
		eb, _ := getFloat(b, "enriched_risk_score")
		if ea != eb {
			return ea > eb
		}
		ta := threatSortTime(a)
		tb := threatSortTime(b)
		if !ta.Equal(tb) {
			return ta.Before(tb)
		}
		tta, _ := getString(a, "threat_type")
		ttb, _ := getString(b, "threat_type")
		return tta < ttb
	})
}

func threatSortTime(threat map[string]interface{}) time.Time {
	if tt, ok := getString(threat, "threat_type"); ok && tt == "privilege_escalation" {
		if ts, ok := getString(threat, "timestamp"); ok {
			if t, err := parseTime(ts); err == nil {
				return t
			}
		}
	}
	if ts, ok := getString(threat, "first_seen"); ok {
		if t, err := parseTime(ts); err == nil {
			return t
		}
	}
	return time.Time{}
}

