    86				ct.severity = sev
    87			}
    88			threats = append(threats, ct)
    89		}
    90		if err := scanner.Err(); err != nil {
    91			fmt.Fprintln(os.Stderr, err)
    92			return 1
    93		}
    94	
    95		n := len(threats)
    96		linked := make([][]bool, n)
    97		for i := range linked {
    98			linked[i] = make([]bool, n)
    99		}
   100		for i := 0; i < n; i++ {
   101			if len(threats[i].actors) == 0 {
   102				continue
   103			}
   104			for j := i + 1; j < n; j++ {
   105				if len(threats[j].actors) == 0 {
   106					continue
   107				}
   108				if absDuration(threats[i].ref.Sub(threats[j].ref)) <= window && sharedActorCount(threats[i].actors, threats[j].actors) > 0 {
   109					linked[i][j] = true
   110					linked[j][i] = true
   111				}
   112			}
   113		}
   114	
   115		visited := make([]bool, n)
   116		var campaigns []correlateCampaign
   117		for start := 0; start < n; start++ {
