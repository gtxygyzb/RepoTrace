\t\tsumY += y
\t\tsumXY += x * y
\t\tsumX2 += x * x
\t}
	denom := float64(n)*sumX2 - sumX*sumX
\tif denom == 0 {
\t\tslope = 0
\t\tintercept = values[0]
\t\treturn
\t}
	slope = (float64(n)*sumXY - sumX*sumY) / denom
\tintercept = (sumY - slope*sumX) / float64(n)
\treturn
}

