     9	func main() {
    10		if len(os.Args) < 2 {
    11			fmt.Fprintln(os.Stderr, "usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert> [flags]")
    12			os.Exit(1)
    13		}
    14	
    15		var code int
    16		switch os.Args[1] {
    17		case "analyze":
    18			code = runAnalyze(os.Args[2:])
    19		case "summarize":
    20			code = runSummarize(os.Args[2:])
    21		case "filter":
    22			code = runFilter(os.Args[2:])
    23		case "respond":
    24			code = runRespond(os.Args[2:])
    25		case "enrich":
    26			code = runEnrich(os.Args[2:])
    27		case "correlate":
    28			code = runCorrelate(os.Args[2:])
    29		case "timeline":
    30			code = runTimeline(os.Args[2:])
    31		case "snapshot":
    32			code = runSnapshot(os.Args[2:])
    33		case "alert":
    34			code = runAlert(os.Args[2:])
    35		default:
    36			fmt.Fprintf(os.Stderr, "invalid subcommand: %s\n", os.Args[1])
    37			code = 1
    38		}
    39		os.Exit(code)
    40	}
    41	
    42	func newFlagSet(name string) *flag.FlagSet {
    43		fs := flag.NewFlagSet(name, flag.ContinueOnError)
    44		fs.SetOutput(os.Stderr)
    45		fs.Usage = func() {}
    46		return fs
    47	}
    48	
    49	func parseFlags(fs *flag.FlagSet, args []string) bool {
    50		if err := fs.Parse(args); err != nil {
    51			return false
    52		}
    53		return true
    54	}
    55	
    56	func isFlagSet(fs *flag.FlagSet, name string) bool {
    57		set := false
    58		fs.Visit(func(f *flag.Flag) {
    59			if f.Name == name {
    60				set = true
    61			}
    62		})
    63		return set
    64	}
