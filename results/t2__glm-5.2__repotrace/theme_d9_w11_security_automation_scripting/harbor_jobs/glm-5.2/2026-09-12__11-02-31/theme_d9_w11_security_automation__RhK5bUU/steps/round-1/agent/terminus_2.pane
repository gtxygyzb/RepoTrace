     9		"strconv"
    10	)
    11	
    12	type forecastInputSnapshot struct {
    13		GlobalMeanRisk float64 `json:"global_mean_risk"`
    14		TotalThreats   int     `json:"total_threats"`
    15	}
    16	
    17	type forecastMetricResult struct {
    18		Slope       json.Number   `json:"slope"`
    19		Intercept   json.Number   `json:"intercept"`
    20		Trend       string        `json:"trend"`
    21		LastValue   json.Number   `json:"last_value"`
    22		Predictions []json.Number `json:"predictions"`
    23	}
    24	
    25	type forecastOutput struct {
    26		InputCount   int                             `json:"input_count"`
    27		Metrics      map[string]forecastMetricResult `json:"metrics"`
    28		OverallTrend string                          `json:"overall_trend"`
    29		AlertLevel   string                          `json:"alert_level"`
    30	}
    31	
    32	func runForecast(args []string) int {
    33		fs := newFlagSet("forecast")
    34		steps := fs.Int("steps", 3, "number of future steps to predict")
    35		if !parseFlags(fs, args) {
    36			return 1
    37		}
    38		if *steps < 1 {
    39			fmt.Fprintln(os.Stderr, "error: --steps must be at least 1")
    40			return 1
    41		}
    42	
    43		var snapshots []forecastInputSnapshot
    44		scanner := bufio.NewScanner(os.Stdin)
    45		scanner.Buffer(make([]byte, 1024*1024), 1024*1024)
    46		for scanner.Scan() {
    47			line := scanner.Text()
    48			if len(line) == 0 {
    49				continue
    50			}
    51			var snap forecastInputSnapshot
    52			if err := json.Unmarshal([]byte(line), &snap); err != nil {
    53				fmt.Fprintf(os.Stderr, "error: malformed JSON input: %s\n", err)
    54				return 2
    55			}
    56			snapshots = append(snapshots, snap)
    57		}
    58		if err := scanner.Err(); err != nil {
    59			fmt.Fprintf(os.Stderr, "error: reading input: %s\n", err)
    60			return 1
    61		}
    62		if len(snapshots) < 3 {
    63			fmt.Fprintln(os.Stderr, "error: at least 3 valid input snapshots are required")
    64			return 1
    65		}
    66	
    67		risks := make([]float64, len(snapshots))
    68		threats := make([]float64, len(snapshots))
    69		for i, snap := range snapshots {
    70			risks[i] = snap.GlobalMeanRisk
    71			threats[i] = float64(snap.TotalThreats)
    72		}
    73	
    74		riskSlope, riskIntercept := olsLine(0, risks)
    75		threatSlope, threatIntercept := olsLine(0, threats)
    76	
    77		riskPredictions := predictLine(riskSlope, riskIntercept, len(snapshots), *steps)
    78		threatPredictions := predictLine(threatSlope, threatIntercept, len(snapshots), *steps)
    79	
    80		riskTrend := trendFromSlope(riskSlope)
    81		threatTrend := trendFromSlope(threatSlope)
    82	
    83		last := snapshots[len(snapshots)-1]
    84		metrics := map[string]forecastMetricResult{
    85			"global_mean_risk": {
    86				Slope:       json.Number(format4(riskSlope)),
    87				Intercept:   json.Number(format4(riskIntercept)),
    88				Trend:       riskTrend,
    89				LastValue:   json.Number(formatRiskValue(last.GlobalMeanRisk)),
    90				Predictions: roundAll4(riskPredictions),
    91			},
    92			"total_threats": {
    93				Slope:       json.Number(format4(threatSlope)),
    94				Intercept:   json.Number(format4(threatIntercept)),
    95				Trend:       threatTrend,
    96				LastValue:   json.Number(strconv.Itoa(last.TotalThreats)),
    97				Predictions: roundAll4(threatPredictions),
    98			},
    99		}
   100	
   101		out := forecastOutput{
   102			InputCount:   len(snapshots),
   103			Metrics:      metrics,
   104			OverallTrend: overallTrend(riskTrend, threatTrend),
   105			AlertLevel:   alertLevelFromSlopes(risks, threats, riskSlope, threatSlope),
   106		}
   107	
   108		encoded, err := json.Marshal(out)
   109		if err != nil {
   110			fmt.Fprintln(os.Stderr, "error: encoding forecast output:", err)
   111			return 1
   112		}
   113		fmt.Println(string(encoded))
   114		return 0
   115	}
   116	
   117	func olsLine(startIndex int, values []float64) (slope, intercept float64) {
   118		n := len(values)
   119		if n == 0 {
   120			return 0, 0
   121		}
   122		var sumX, sumY, sumXY, sumX2 float64
   123		for i, y := range values {
   124			x := float64(startIndex + i)
   125			sumX += x
   126			sumY += y
   127			sumXY += x * y
   128			sumX2 += x * x
   129		}
   130	
   131		denom := float64(n)*sumX2 - sumX*sumX
   132		if denom == 0 {
   133			slope = 0
   134			intercept = values[0]
   135			return
   136		}
   137		slope = (float64(n)*sumXY - sumX*sumY) / denom
   138		intercept = (sumY - slope*sumX) / float64(n)
   139		return
   140	}
   141	
   142	func predictLine(slope, intercept float64, startIndex, steps int) []float64 {
   143		predictions := make([]float64, steps)
   144		for i := 0; i < steps; i++ {
   145			predictions[i] = slope*float64(startIndex+i) + intercept
   146		}
   147		return predictions
   148	}
   149	
   150	func trendFromSlope(slope float64) string {
   151		r := roundHalfUp4(slope)
   152		if r > 0 {
   153			return "increasing"
   154		}
   155		if r < 0 {
   156			return "decreasing"
   157		}
   158		return "stable"
   159	}
   160	
   161	func overallTrend(a, b string) string {
   162		if a == "increasing" && b == "increasing" {
   163			return "increasing"
   164		}
   165		if a == "decreasing" && b == "decreasing" {
   166			return "decreasing"
   167		}
   168		if a == "increasing" || b == "increasing" {
   169			if a == "decreasing" || b == "decreasing" {
   170				return "mixed"
   171			}
   172			return "increasing"
   173		}
   174		if a == "decreasing" || b == "decreasing" {
   175			return "decreasing"
   176		}
   177		return "stable"
   178	}
   179	
   180	func alertLevelFromSlopes(risks, threats []float64, riskSlope, threatSlope float64) string {
   181		riskMean := meanOfValues(risks)
   182		threatMean := meanOfValues(threats)
   183	
   184		maxRatio := 0.0
   185		if riskSlope > 0 {
   186			ratio := riskSlope / math.Max(riskMean, 1.0)
   187			if ratio > maxRatio {
   188				maxRatio = ratio
   189			}
   190		}
   191		if threatSlope > 0 {
   192			ratio := threatSlope / math.Max(threatMean, 1.0)
   193			if ratio > maxRatio {
   194				maxRatio = ratio
   195			}
   196		}
   197	
   198		if maxRatio >= 0.5 {
   199			return "critical"
   200		}
   201		if maxRatio >= 0.2 {
   202			return "warning"
   203		}
   204		return "normal"
   205	}
   206	
   207	func meanOfValues(values []float64) float64 {
   208		if len(values) == 0 {
   209			return 0
   210		}
   211		var sum float64
   212		for _, v := range values {
   213			sum += v
   214		}
   215		return sum / float64(len(values))
   216	}
   217	
   218	func roundAll4(values []float64) []json.Number {
   219		out := make([]json.Number, len(values))
   220		for i, v := range values {
   221			out[i] = json.Number(format4(v))
   222		}
   223		return out
   224	}
