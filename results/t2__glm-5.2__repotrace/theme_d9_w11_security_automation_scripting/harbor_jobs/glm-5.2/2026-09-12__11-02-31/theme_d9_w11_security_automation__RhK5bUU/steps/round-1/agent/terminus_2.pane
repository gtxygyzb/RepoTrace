    60	func runEnrich(args []string) int {
    61		fs := newFlagSet("enrich")
    62		iocPath := fs.String("ioc", "", "path to IOC database JSON file")
    63		refTimeStr := fs.String("reference-time", "", "ISO 8601 timestamp used for TTL evaluation")
    64		minConf := fs.Float64("min-confidence", 0.0, "minimum base effective confidence")
    65		if !parseFlags(fs, args) {
    66			return 1
    67		}
    68		if !isFlagSet(fs, "ioc") || *iocPath == "" {
    69			fmt.Fprintln(os.Stderr, "error: --ioc flag is required")
    70			return 1
    71		}
    72	
    73		hasRef := isFlagSet(fs, "reference-time")
    74		var refTime time.Time
    75		if hasRef {
    76			t, err := parseTime(*refTimeStr)
    77			if err != nil {
    78				fmt.Fprintln(os.Stderr, err)
    79				return 1
    80			}
    81			refTime = t
    82		}
    83	
    84		iocs, err := loadIOCDB(*iocPath)
    85		if err != nil {
    86			if os.IsNotExist(err) {
    87				fmt.Fprintln(os.Stderr, err)
    88				return 1
    89			}
    90			if _, ok := err.(*json.SyntaxError); ok {
    91				fmt.Fprintln(os.Stderr, err)
    92				return 2
    93			}
    94			if _, ok := err.(*json.UnmarshalTypeError); ok {
    95				fmt.Fprintln(os.Stderr, err)
    96				return 2
    97			}
    98			fmt.Fprintln(os.Stderr, err)
    99			return 1
   100		}
   101	
   102		scanner := bufio.NewScanner(os.Stdin)
   103		scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
   104		var enriched []map[string]interface{}
   105		lineNo := 0
   106		for scanner.Scan() {
   107			lineNo++
   108			line := scanner.Text()
   109			if line == "" {
   110				continue
   111			}
   112			var threat map[string]interface{}
   113			if err := json.Unmarshal([]byte(line), &threat); err != nil {
   114				fmt.Fprintf(os.Stderr, "line %d: %v\n", lineNo, err)
   115				return 2
   116			}
   117			enriched = append(enriched, enrichThreat(threat, iocs, refTime, hasRef, *minConf))
   118		}
   119		if err := scanner.Err(); err != nil {
   120			fmt.Fprintln(os.Stderr, err)
   121			return 1
   122		}
   123	
   124		sortEnrichedThreats(enriched)
   125		w := bufio.NewWriter(os.Stdout)
   126		defer w.Flush()
   127		enc := json.NewEncoder(w)
   128		for _, t := range enriched {
   129			if err := enc.Encode(t); err != nil {
   130				fmt.Fprintln(os.Stderr, err)
   131				return 1
   132			}
   133		}
   134		return 0
   135	}
   136	
   137	func loadIOCDB(path string) ([]processedIOC, error) {
   138		data, err := os.ReadFile(path)
   139		if err != nil {
   140			return nil, err
   141		}
   142		var entries []iocEntry
   143		if err := json.Unmarshal(data, &entries); err != nil {
   144			return nil, err
   145		}
   146		processed := make([]processedIOC, 0, len(entries))
   147		for _, e := range entries {
   148			p, ok := processIOC(e)
   149			if !ok {
   150				continue
   151			}
   152			processed = append(processed, p)
   153		}
   154		return processed, nil
   155	}
   156	
   157	func processIOC(e iocEntry) (processedIOC, bool) {
   158		p := processedIOC{entry: e, ttlHours: e.TTLHours}
   159		if p.ttlHours <= 0 {
   160			return p, false
   161		}
   162		t, err := parseTime(e.LastUpdated)
   163		if err != nil {
   164			return p, false
   165		}
   166		p.lastUpdated = t
   167		switch e.IndicatorType {
   168		case "ipv4":
   169			ip := net.ParseIP(e.Indicator)
   170			if ip == nil || ip.To4() == nil {
   171				return p, false
   172			}
   173			p.ip = ip
   174		case "ipv4_cidr":
   175			_, ipNet, err := net.ParseCIDR(e.Indicator)
   176			if err != nil {
   177				return p, false
   178			}
   179			if ipNet.IP.To4() == nil {
   180				return p, false
   181			}
   182			p.ipNet = ipNet
   183			ones, _ := ipNet.Mask.Size()
   184			p.prefixLen = ones
   185		case "port":
   186			port, err := strconv.Atoi(e.Indicator)
   187			if err != nil {
   188				return p, false
   189			}
   190			p.port = port
   191		case "user":
   192		default:
   193			return p, false
   194		}
   195		return p, true
   196	}
   197	
   198	func enrichThreat(threat map[string]interface{}, iocs []processedIOC, fixedRef time.Time, hasRef bool, minConf float64) map[string]interface{} {
   199		refTime := fixedRef
   200		if !hasRef {
   201			refTime = threatReferenceTime(threat)
   202		}
   203	
   204		matches := computeIOCMatches(threat, iocs, refTime, minConf)
   205	
   206		riskScore, _ := getFloat(threat, "risk_score")
   207		maxConf := 0.0
   208		tagFactor := make(map[string]float64)
   209		severityContrib := 0
   210		indicatorTypes := make(map[string]bool)
   211		actors := make(map[string]bool)
   212		sevRank := 0
   213	
   214		for _, m := range matches {
   215			if m.adjusted > maxConf {
   216				maxConf = m.adjusted
   217			}
   218			for _, tag := range m.p.entry.Tags {
   219				if cur, ok := tagFactor[tag]; ok {
   220					if m.freshness > cur {
   221						tagFactor[tag] = m.freshness
   222					}
   223				} else {
   224					tagFactor[tag] = m.freshness
   225				}
   226			}
   227			severityContrib += severityWeight(m.p.entry.Severity)
   228			indicatorTypes[m.p.entry.IndicatorType] = true
   229			actors[m.p.entry.ThreatActor] = true
   230			if v := severityValue(m.p.entry.Severity); v > sevRank {
   231				sevRank = v
   232			}
   233		}
   234	
   235		tagBonus := 0.0
   236		for tag, factor := range tagFactor {
   237			tagBonus += tagBonusValue(tag) * factor
   238		}
   239	
   240		multiVectorBonus := 0.0
   241		switch len(indicatorTypes) {
   242		case 0, 1:
   243			multiVectorBonus = 0.0
   244		case 2:
   245			multiVectorBonus = 25.0
   246		default:
   247			multiVectorBonus = 50.0
   248		}
   249	
   250		actorBonus := 0.0
   251		switch len(actors) {
   252		case 0, 1:
   253			actorBonus = 0.0
   254		case 2:
   255			actorBonus = 15.0
   256		default:
   257			actorBonus = 30.0
   258		}
   259	
   260		enrichedScore := riskScore*(1.0+maxConf) + tagBonus + multiVectorBonus + float64(severityContrib) + actorBonus
