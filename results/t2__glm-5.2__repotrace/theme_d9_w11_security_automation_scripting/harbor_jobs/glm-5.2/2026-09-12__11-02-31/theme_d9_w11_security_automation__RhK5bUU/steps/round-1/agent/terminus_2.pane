     9	func main() {
    10		if len(os.Args) < 2 {
    11			fmt.Fprintln(os.Stderr, "usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot> [flags]")
    12			os.Exit(1)
    13		}
    14	
    15		var code int
    16		switch os.Args[1] {
    17		case "analyze":
    18			code = runAnalyze(os.Args[2:])
    19		case "summarize":
    20			code = runSummarize(os.Args[2:])
    21		case "filter":
    22			code = runFilter(os.Args[2:])
    23		case "respond":
    24			code = runRespond(os.Args[2:])
    25		case "enrich":
    26			code = runEnrich(os.Args[2:])
    27		case "correlate":
    28			code = runCorrelate(os.Args[2:])
    29		case "timeline":
    30			code = runTimeline(os.Args[2:])
    31		case "snapshot":
    32			code = runSnapshot(os.Args[2:])
    33		default:
    34			fmt.Fprintf(os.Stderr, "invalid subcommand: %s\n", os.Args[1])
    35			code = 1
    36		}
    37		os.Exit(code)
    38	}
    39	
    40	func newFlagSet(name string) *flag.FlagSet {
    41		fs := flag.NewFlagSet(name, flag.ContinueOnError)
    42		fs.SetOutput(os.Stderr)
    43		fs.Usage = func() {}
    44		return fs
    45	}
    46	
    47	func parseFlags(fs *flag.FlagSet, args []string) bool {
    48		if err := fs.Parse(args); err != nil {
    49			return false
    50		}
    51		return true
    52	}
    53	
    54	func isFlagSet(fs *flag.FlagSet, name string) bool {
    55		set := false
    56		fs.Visit(func(f *flag.Flag) {
    57			if f.Name == name {
    58				set = true
    59			}
    60		})
    61		return set
    62	}
