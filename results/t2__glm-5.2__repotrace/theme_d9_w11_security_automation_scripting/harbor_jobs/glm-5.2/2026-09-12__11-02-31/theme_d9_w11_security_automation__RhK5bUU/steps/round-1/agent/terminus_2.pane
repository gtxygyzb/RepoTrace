    10		"time"
    11	)
    12	
    13	type timelineBucket struct {
    14		BucketStart       string                   `json:"bucket_start"`
    15		BucketEnd         string                   `json:"bucket_end"`
    16		ThreatCount       int                      `json:"threat_count"`
    17		AvgRisk           float64                  `json:"avg_risk"`
    18		MaxRisk           float64                  `json:"max_risk"`
    19		MinRisk           float64                  `json:"min_risk"`
    20		RiskStdDev        float64                  `json:"risk_std_dev"`
    21		DominantType      string                   `json:"dominant_type"`
    22		TypeDistribution  map[string]int           `json:"type_distribution"`
    23		UniqueActors      []string                 `json:"unique_actors"`
    24		SeverityHistogram map[string]int           `json:"severity_histogram"`
    25		EscalationIndex   float64                  `json:"escalation_index"`
    26		RiskTrend         float64                  `json:"risk_trend"`
    27		BurstScore        float64                  `json:"burst_score"`
    28		TopThreats        []map[string]interface{} `json:"top_threats"`
    29	}
    30	
    31	func runTimeline(args []string) int {
    32		fs := newFlagSet("timeline")
    33		bucketMinutes := fs.Int("bucket-minutes", 0, "width of each time bucket in minutes")
    34		topN := fs.Int("top-n", 3, "maximum number of top threats to include per bucket")
    35		if !parseFlags(fs, args) {
    36			return 1
    37		}
    38		if !isFlagSet(fs, "bucket-minutes") {
    39			fmt.Fprintln(os.Stderr, "missing required flag: --bucket-minutes")
    40			return 1
    41		}
    42		if *bucketMinutes <= 0 {
    43			fmt.Fprintf(os.Stderr, "invalid --bucket-minutes: must be a positive integer\n")
    44			return 1
    45		}
    46		if *topN < 0 {
    47			fmt.Fprintf(os.Stderr, "invalid --top-n: must be non-negative\n")
    48			return 1
    49		}
    50	
    51		scanner := bufio.NewScanner(os.Stdin)
    52		scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
    53		lineNo := 0
    54		var threats []map[string]interface{}
    55		for scanner.Scan() {
    56			lineNo++
    57			line := scanner.Text()
    58			if line == "" {
    59				continue
    60			}
    61			var threat map[string]interface{}
    62			if err := json.Unmarshal([]byte(line), &threat); err != nil {
    63				fmt.Fprintf(os.Stderr, "line %d: %v\n", lineNo, err)
    64				return 2
    65			}
    66			threats = append(threats, threat)
    67		}
    68		if err := scanner.Err(); err != nil {
    69			fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
    70			return 2
    71		}
    72	
    73		bucketSeconds := int64(*bucketMinutes) * 60
    74		buckets := make(map[int64][]map[string]interface{})
    75		var bucketStarts []int64
    76		for _, threat := range threats {
    77			refTime := threatSortTime(threat)
    78			var refUnix int64
    79			if !refTime.IsZero() {
    80				refUnix = refTime.Unix()
    81			}
    82			start := refUnix - ((refUnix%bucketSeconds)+bucketSeconds)%bucketSeconds
    83			if _, ok := buckets[start]; !ok {
    84				bucketStarts = append(bucketStarts, start)
    85			}
    86			buckets[start] = append(buckets[start], threat)
    87		}
    88	
    89		sort.Slice(bucketStarts, func(i, j int) bool { return bucketStarts[i] < bucketStarts[j] })
    90	
    91		writer := bufio.NewWriter(os.Stdout)
    92		defer writer.Flush()
    93	
    94		for _, start := range bucketStarts {
    95			bucketThreats := buckets[start]
    96			startTime := time.Unix(start, 0).UTC()
    97			endTime := startTime.Add(time.Duration(*bucketMinutes) * time.Minute)
    98			b := buildTimelineBucket(bucketThreats, startTime, endTime, *bucketMinutes, *topN)
    99			data, err := json.Marshal(b)
   100			if err != nil {
   101				fmt.Fprintf(os.Stderr, "error marshalling bucket: %v\n", err)
   102				return 2
   103			}
   104			writer.Write(data)
   105			writer.WriteByte('\n')
   106		}
   107	
   108		return 0
   109	}
   110	
   111	func buildTimelineBucket(threats []map[string]interface{}, startTime time.Time, endTime time.Time, bucketMinutes int, topN int) timelineBucket {
   112		n := len(threats)
   113		b := timelineBucket{
   114			BucketStart:       startTime.Format(time.RFC3339),
   115			BucketEnd:         endTime.Format(time.RFC3339),
   116			ThreatCount:       n,
   117			TypeDistribution:  map[string]int{},
   118			SeverityHistogram: map[string]int{"none": 0, "low": 0, "medium": 0, "high": 0, "critical": 0},
   119			UniqueActors:      []string{},
   120			TopThreats:        []map[string]interface{}{},
   121		}
   122	
   123		if n == 0 {
   124			return b
   125		}
   126	
   127		var sumRisk, maxRisk, minRisk float64
   128		typeCounts := map[string]int{}
   129		actorSet := map[string]bool{}
   130		risks := make([]float64, 0, n)
   131		for i, threat := range threats {
   132			risk, _ := getFloat(threat, "enriched_risk_score")
   133			risks = append(risks, risk)
   134			sumRisk += risk
   135			if i == 0 {
   136				maxRisk = risk
   137				minRisk = risk
   138			} else {
   139				if risk > maxRisk {
   140					maxRisk = risk
   141				}
   142				if risk < minRisk {
   143					minRisk = risk
   144				}
   145			}
   146			if tt, ok := getString(threat, "threat_type"); ok {
   147				typeCounts[tt]++
   148			}
   149			if sev, ok := getString(threat, "ioc_severity"); ok {
   150				if _, exists := b.SeverityHistogram[sev]; exists {
   151					b.SeverityHistogram[sev]++
   152				}
   153			}
   154			if actors, ok := getStringSlice(threat, "threat_actors"); ok {
   155				for _, actor := range actors {
   156					if actor != "" {
   157						actorSet[actor] = true
   158					}
   159				}
   160			}
   161		}
   162		b.AvgRisk = round2(sumRisk / float64(n))
   163		b.MaxRisk = maxRisk
   164		b.MinRisk = minRisk
   165	
   166		mean := sumRisk / float64(n)
   167		var variance float64
   168		for _, risk := range risks {
   169			diff := risk - mean
   170			variance += diff * diff
   171		}
   172		if n == 1 {
   173			variance = 0.0
   174		} else {
   175			variance /= float64(n)
   176		}
   177		b.RiskStdDev = round2(math.Sqrt(variance))
   178	
   179		b.DominantType = dominantThreatType(threats, typeCounts)
   180		b.TypeDistribution = typeCounts
   181	
   182		b.UniqueActors = nonNilStrings(sortedUniqueStringsFromSet(actorSet))
   183	
   184		b.EscalationIndex = round3(timelineEscalationIndex(threats))
   185		b.RiskTrend = round3(timelineRiskTrend(threats, startTime))
   186		b.BurstScore = round3(timelineBurstScore(threats))
   187	
   188		sortedTop := make([]map[string]interface{}, len(threats))
   189		copy(sortedTop, threats)
   190		sort.SliceStable(sortedTop, func(i, j int) bool {
   191			ri, _ := getFloat(sortedTop[i], "enriched_risk_score")
   192			rj, _ := getFloat(sortedTop[j], "enriched_risk_score")
   193			if ri != rj {
   194				return ri > rj
   195			}
   196			ti, tj := threatSortTime(sortedTop[i]), threatSortTime(sortedTop[j])
   197			if !ti.Equal(tj) {
   198				return ti.Before(tj)
   199			}
   200			tta, _ := getString(sortedTop[i], "threat_type")
   201			ttb, _ := getString(sortedTop[j], "threat_type")
   202			return tta < ttb
   203		})
   204		if topN < len(sortedTop) {
   205			sortedTop = sortedTop[:topN]
   206		}
   207		b.TopThreats = sortedTop
   208	
   209		return b
   210	}
   211	
   212	func dominantThreatType(threats []map[string]interface{}, counts map[string]int) string {
   213		var keys []string
   214		for k := range counts {
   215			keys = append(keys, k)
   216		}
   217		sort.Strings(keys)
   218	
   219		sumRisk := make(map[string]float64)
   220		typeNum := make(map[string]int)
