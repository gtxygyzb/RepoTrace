[?2004lpackage main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"io"
	"math"
	"os"
	"sort"
	"strconv"
	"strings"
)

type anomalyInputSnapshot struct {
	GlobalMeanRisk float64 `json:"global_mean_risk"`
	TotalThreats   int     `json:"total_threats"`
}

type anomalyMetricResult struct {
	Value          json.Number `json:"value"`
	BaselineMean   json.Number `json:"baseline_mean"`
	BaselineStddev json.Number `json:"baseline_stddev"`
	ZScore         json.Number `json:"z_score"`
}

type anomalyMetrics struct {
	GlobalMeanRisk anomalyMetricResult `json:"global_mean_risk"`
	TotalThreats   anomalyMetricResult `json:"total_threats"`
}

type anomalyRecord struct {
	Index         int            `json:"index"`
	Metrics       anomalyMetrics `json:"metrics"`
	CombinedZ     json.Number    `json:"combined_z"`
	BaselineCount int            `json:"baseline_count"`
	Direction     string         `json:"direction"`
	Severity      string         `json:"severity"`

	roundedCombinedZ float64
}

func runAnomaly(args []string) int {
	fs := newFlagSet("anomaly")
	window := fs.Int("window", 5, "baseline window size")
	threshold := fs.Float64("threshold", 2.0, "combined z-score anomaly threshold")
	if !parseFlags(fs, args) {
		return 1
	}

	if *window < 2 {
		fmt.Fprintln(os.Stderr, "error: --window must be at least 2")
		return 1
	}

	var snapshots []anomalyInputSnapshot
	reader := bufio.NewReader(os.Stdin)
	for {
		line, err := reader.ReadString('\n')
		trimmed := strings.TrimSpace(line)
		if trimmed == "" {
			if err == io.EOF {
				break
			}
			continue
		}

		var snap anomalyInputSnapshot
		if jerr := json.Unmarshal([]byte(trimmed), &snap); jerr != nil {
			fmt.Fprintln(os.Stderr, "error: malformed JSON input:", jerr)
			return 2
		}
		snapshots = append(snapshots, snap)

		if err == io.EOF {
			break
		}
	}

	if len(snapshots) < 3 {
		fmt.Fprintln(os.Stderr, "error: requires at least 3 valid JSON lines on stdin")
		return 1
	}

	risks := make([]float64, len(snapshots))
	threats := make([]float64, len(snapshots))
	for i, snap := range snapshots {
		risks[i] = snap.GlobalMeanRisk
		threats[i] = float64(snap.TotalThreats)
	}

	var anomalies []anomalyRecord
	for i := 0; i < len(snapshots); i++ {
		start := i - *window
		if start < 0 {
			start = 0
		}
		baselineCount := i - start
		if baselineCount < 2 {
			continue
		}

		riskMean, riskStd := baselineStats(risks[start:i])
		threatMean, threatStd := baselineStats(threats[start:i])

		riskZ := zScore(risks[i], riskMean, riskStd)
		threatZ := zScore(threats[i], threatMean, threatStd)
		combinedZ := math.Sqrt(riskZ*riskZ + threatZ*threatZ)
		roundedCombinedZ := roundHalfUp4(combinedZ)

		if combinedZ < *threshold {
			continue
		}

		direction := "mixed"
		if riskZ >= 0 && threatZ >= 0 {
			direction = "above"
		} else if riskZ <= 0 && threatZ <= 0 {
			direction = "below"
		}

		severity := "low"
		if combinedZ >= 4.0 {
			severity = "extreme"
		} else if combinedZ >= 3.0 {
			severity = "high"
		} else if combinedZ >= 2.0 {
			severity = "moderate"
		}

		anomalies = append(anomalies, anomalyRecord{
			Index: i,
			Metrics: anomalyMetrics{
				GlobalMeanRisk: anomalyMetricResult{
					Value:          json.Number(formatRiskValue(risks[i])),
					BaselineMean:   json.Number(format4(riskMean)),
					BaselineStddev: json.Number(format4(riskStd)),
					ZScore:         json.Number(format4(riskZ)),
				},
				TotalThreats: anomalyMetricResult{
					Value:          json.Number(strconv.FormatInt(int64(threats[i]), 10)),
					BaselineMean:   json.Number(format4(threatMean)),
					BaselineStddev: json.Number(format4(threatStd)),
					ZScore:         json.Number(format4(threatZ)),
				},
			},
			CombinedZ:        json.Number(format4(combinedZ)),
			BaselineCount:    baselineCount,
			Direction:        direction,
			Severity:         severity,
			roundedCombinedZ: roundedCombinedZ,
		})
	}

	sort.SliceStable(anomalies, func(a, b int) bool {
		if anomalies[a].roundedCombinedZ != anomalies[b].roundedCombinedZ {
			return anomalies[a].roundedCombinedZ > anomalies[b].roundedCombinedZ
		}
		return anomalies[a].Index < anomalies[b].Index
	})

	encoder := json.NewEncoder(os.Stdout)
	encoder.SetEscapeHTML(false)
	for _, rec := range anomalies {
		if err := encoder.Encode(rec); err != nil {
			fmt.Fprintln(os.Stderr, "error: failed to write anomaly record:", err)
			return 1
		}
	}

	return 0
}

func baselineStats(values []float64) (float64, float64) {
	n := len(values)
	if n == 0 {
		return 0, 0
	}

	sum := 0.0
	for _, v := range values {
		sum += v
	}
	mean := sum / float64(n)

	squaredSum := 0.0
	for _, v := range values {
		diff := v - mean
		squaredSum += diff * diff
	}
	stddev := math.Sqrt(squaredSum / float64(n))

	return mean, stddev
}

func zScore(current, mean, stddev float64) float64 {
	if stddev == 0 {
		if current == mean {
			return 0.0
		}
		if current > mean {
			return 999.0
		}
		return -999.0
	}
	return (current - mean) / stddev
}

func roundHalfUp4(f float64) float64 {
	pow := 10000.0
	return math.Copysign(math.Floor(math.Abs(f)*pow+0.5)/pow, f)
}

func format4(f float64) string {
	rounded := roundHalfUp4(f)
	if rounded == 0 {
		return "0.0000"
	}
	return fmt.Sprintf("%.4f", rounded)
}

func formatRiskValue(f float64) string {
	s := strconv.FormatFloat(f, 'f', -1, 64)
	if !strings.Contains(s, ".") {
		s += ".0"
	}
	return s
}
