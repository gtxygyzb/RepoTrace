   321	func correlateSeverityRank(s string) int {
   322		switch s {
   323		case "none":
   324			return 0
   325		case "low":
   326			return 1
   327		case "medium":
   328			return 2
   329		case "high":
   330			return 3
   331		case "critical":
   332			return 4
   333		default:
   334			return 0
   335		}
   336	}
