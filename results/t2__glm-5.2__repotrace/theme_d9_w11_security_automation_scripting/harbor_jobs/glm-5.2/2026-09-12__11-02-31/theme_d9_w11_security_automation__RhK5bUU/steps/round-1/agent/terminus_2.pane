    70				fmt.Fprintln(os.Stderr, "error: malformed JSON input:", jerr)
    71				return 2
    72			}
    73			snapshots = append(snapshots, snap)
    74	
    75			if err == io.EOF {
    76				break
    77			}
    78		}
    79	
    80		if len(snapshots) < 3 {
    81			fmt.Fprintln(os.Stderr, "error: requires at least 3 valid JSON lines on stdin")
    82			return 1
    83		}
    84	
    85		risks := make([]float64, len(snapshots))
