import json
logs=[]
# brute force
for i in range(5):
    logs.append({"timestamp":f"2024-01-15T08:00:{i:02d}Z","source_ip":"10.0.0.1","dest_ip":"10.0.0.2","dest_port":22,"protocol":"TCP","action":"DENY","event_type":"auth_failure","user":f"user{i}","severity":"medium","payload_size":0,"metadata":{}})
# port scan
for i in range(10):
    logs.append({"timestamp":f"2024-01-15T08:01:{i:02d}Z","source_ip":"10.0.0.3","dest_ip":"10.0.0.4","dest_port":9000+i,"protocol":"TCP","action":"ALLOW","event_type":"connection","severity":"low","payload_size":0,"metadata":{}})
# data exfiltration
logs.append({"timestamp":"2024-01-15T08:02:00Z","source_ip":"10.0.0.5","dest_ip":"10.0.0.6","dest_port":443,"protocol":"TCP","action":"ALLOW","event_type":"connection","severity":"low","payload_size":104857601,"metadata":{}})
# privilege escalation
logs.append({"timestamp":"2024-01-15T08:03:00Z","source_ip":"10.0.0.7","dest_ip":"10.0.0.8","dest_port":22,"protocol":"TCP","action":"DENY","event_type":"auth_failure","user":"admin","severity":"medium","payload_size":0,"metadata":{}})
logs.append({"timestamp":"2024-01-15T08:03:30Z","source_ip":"10.0.0.7","dest_ip":"10.0.0.8","dest_port":22,"protocol":"TCP","action":"ALLOW","event_type":"auth_success","user":"admin","severity":"high","payload_size":0,"metadata":{"privilege_change":"elevated"}})
# lateral movement
for idx,dest in enumerate(["10.0.0.10","10.0.0.11","10.0.0.12"]):
    logs.append({"timestamp":f"2024-01-15T08:04:{idx:02d}Z","source_ip":"10.0.0.9","dest_ip":dest,"dest_port":22,"protocol":"TCP","action":"DENY","event_type":"auth_failure","user":"svc","severity":"medium","payload_size":0,"metadata":{}})
    logs.append({"timestamp":f"2024-01-15T08:04:{idx+10:02d}Z","source_ip":"10.0.0.9","dest_ip":dest,"dest_port":22,"protocol":"TCP","action":"ALLOW","event_type":"auth_success","user":"svc","severity":"high","payload_size":0,"metadata":{}})
# dns tunneling
for i in range(50):
    logs.append({"timestamp":f"2024-01-15T08:05:{i:02d}Z","source_ip":"10.0.0.13","dest_ip":"8.8.8.8","dest_port":53,"protocol":"UDP","action":"ALLOW","event_type":"dns_query","user":"","severity":"low","payload_size":513,"metadata":{}})
with open("/tmp/full.jsonl","w") as f:
    for e in logs:
        f.write(json.dumps(e)+"\n")
