    37	type prioritizeOutput struct {
    38		SourceIP          string             `json:"source_ip"`
    39		ThreatType        string             `json:"threat_type"`
    40		PriorityScore     float64            `json:"priority_score"`
    41		PriorityLabel     string             `json:"priority_label"`
    42		Components        priorityComponents `json:"components"`
    43		EnrichedRiskScore float64            `json:"enriched_risk_score"`
    44		IOCSeverity       string             `json:"ioc_severity"`
    45		ThreatActors      []string           `json:"threat_actors"`
    46		ReferenceTime     string             `json:"reference_time"`
    47	}
    48	
    49	func runPrioritize(args []string) int {
    50		fs := newFlagSet("prioritize")
    51		refStr := fs.String("reference-time", "", "reference timestamp for recency scoring (RFC3339)")
    52		if !parseFlags(fs, args) {
    53			return 1
    54		}
    55		if !isFlagSet(fs, "reference-time") || *refStr == "" {
    56			fmt.Fprintln(os.Stderr, "missing --reference-time flag")
    57			return 1
    58		}
    59		refTime, err := parseTime(*refStr)
    60		if err != nil {
    61			fmt.Fprintln(os.Stderr, err)
    62			return 1
    63		}
    64	
    65		scanner := bufio.NewScanner(os.Stdin)
    66		scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)
    67	
    68		var results []prioritizeOutput
    69		lineNo := 0
    70		for scanner.Scan() {
    71			lineNo++
    72			line := scanner.Text()
    73			if line == "" {
    74				continue
    75			}
    76			var threat map[string]interface{}
    77			if err := json.Unmarshal([]byte(line), &threat); err != nil {
    78				fmt.Fprintf(os.Stderr, "line %d: %v\n", lineNo, err)
    79				return 2
    80			}
    81			out, ok := prioritizeThreat(threat, refTime)
    82			if !ok {
    83				continue
    84			}
    85			results = append(results, out)
    86		}
    87		if err := scanner.Err(); err != nil {
    88			fmt.Fprintln(os.Stderr, err)
    89			return 1
    90		}
    91	
    92		sort.SliceStable(results, func(i, j int) bool {
    93			if results[i].PriorityScore != results[j].PriorityScore {
    94				return results[i].PriorityScore > results[j].PriorityScore
    95			}
    96			return results[i].SourceIP < results[j].SourceIP
    97		})
    98	
    99		writer := bufio.NewWriter(os.Stdout)
   100		defer writer.Flush()
   101		for _, r := range results {
   102			b, err := json.Marshal(r)
   103			if err != nil {
   104				fmt.Fprintf(os.Stderr, "failed to encode output: %v\n", err)
   105				return 1
   106			}
   107			fmt.Fprintln(writer, string(b))
   108		}
   109		return 0
   110	}
   111	
   112	func prioritizeThreat(threat map[string]interface{}, refTime time.Time) (prioritizeOutput, bool) {
   113		sourceIP := getStringDefault(threat, "source_ip")
   114		threatType := getStringDefault(threat, "threat_type")
   115	
   116		eventTime := threatReferenceTime(threat)
   117		refStr := ""
   118		if !eventTime.IsZero() {
   119			refStr = eventTime.UTC().Format(time.RFC3339)
   120		}
   121	
   122		ageMinutes := 0.0
   123		if !eventTime.IsZero() {
   124			ageMinutes = refTime.Sub(eventTime).Minutes()
   125		}
   126		if ageMinutes < 0 {
   127			ageMinutes = 0
   128		}
   129		recency := math.Pow(2, -ageMinutes/60.0)
   130	
   131		riskScore, _ := getFloat(threat, "enriched_risk_score")
   132		risk := riskScore / 500.0
   133		if risk > 1.0 {
   134			risk = 1.0
   135		}
   136		if risk < 0 {
   137			risk = 0
   138		}
   139	
   140		confidence := 0.0
   141		if c, ok := getFloat(threat, "max_ioc_confidence"); ok {
   142			confidence = c
   143		}
   144		if confidence < 0 {
   145			confidence = 0
   146		}
   147		if confidence > 1 {
   148			confidence = 1
   149		}
   150	
   151		actors := []string{}
   152		if a, ok := getStringSlice(threat, "threat_actors"); ok {
   153			actors = a
   154		}
   155		actor := float64(len(actors)) / 3.0
   156		if actor > 1.0 {
   157			actor = 1.0
   158		}
   159		if actor < 0 {
   160			actor = 0
   161		}
   162	
   163		severity := getStringDefault(threat, "ioc_severity")
   164		severityRank := prioritySeverityRanks[severity]
   165		severityComponent := float64(severityRank) / 4.0
   166	
   167		score := wSeverity*severityComponent +
   168			wRecency*recency +
   169			wRisk*risk +
   170			wConfidence*confidence +
   171			wActor*actor
   172	
   173		label := priorityLabel(score)
   174	
   175		return prioritizeOutput{
   176			SourceIP:      sourceIP,
   177			ThreatType:    threatType,
   178			PriorityScore: round4(score),
   179			PriorityLabel: label,
   180			Components: priorityComponents{
   181				Severity:   round4(severityComponent),
   182				Recency:    round4(recency),
   183				Risk:       round4(risk),
   184				Confidence: round4(confidence),
   185				Actor:      round4(actor),
   186			},
   187			EnrichedRiskScore: riskScore,
   188			IOCSeverity:       severity,
   189			ThreatActors:      actors,
   190			ReferenceTime:     refStr,
   191		}, true
   192	}
   193	
   194	func priorityLabel(score float64) string {
   195		switch {
   196		case score >= 0.75:
   197			return "critical"
   198		case score >= 0.50:
   199			return "high"
   200		case score >= 0.25:
   201			return "medium"
   202		default:
   203			return "low"
   204		}
   205	}
   206	
   207	func round4(f float64) float64 {
   208		return math.Round(f*10000) / 10000
   209	}
