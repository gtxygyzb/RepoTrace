     2	
     3	import (
     4		"flag"
     5		"fmt"
     6		"os"
     7	)
     8	
     9	func main() {
    10		if len(os.Args) < 2 {
    11			fmt.Fprintln(os.Stderr, "usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline> [flags]")
    12			os.Exit(1)
    13		}
    14	
    15		var code int
    16		switch os.Args[1] {
    17		case "analyze":
    18			code = runAnalyze(os.Args[2:])
    19		case "summarize":
    20			code = runSummarize(os.Args[2:])
    21		case "filter":
    22			code = runFilter(os.Args[2:])
    23		case "respond":
    24			code = runRespond(os.Args[2:])
    25		case "enrich":
    26			code = runEnrich(os.Args[2:])
    27		case "correlate":
    28			code = runCorrelate(os.Args[2:])
    29		case "timeline":
    30			code = runTimeline(os.Args[2:])
    31		default:
    32			fmt.Fprintf(os.Stderr, "invalid subcommand: %s\n", os.Args[1])
    33			code = 1
    34		}
    35		os.Exit(code)
    36	}
    37	
    38	func newFlagSet(name string) *flag.FlagSet {
    39		fs := flag.NewFlagSet(name, flag.ContinueOnError)
    40		fs.SetOutput(os.Stderr)
    41		fs.Usage = func() {}
    42		return fs
    43	}
    44	
    45	func parseFlags(fs *flag.FlagSet, args []string) bool {
    46		if err := fs.Parse(args); err != nil {
    47			return false
    48		}
    49		return true
    50	}
    51	
    52	func isFlagSet(fs *flag.FlagSet, name string) bool {
    53		set := false
    54		fs.Visit(func(f *flag.Flag) {
    55			if f.Name == name {
    56				set = true
    57			}
    58		})
    59		return set
    60	}
