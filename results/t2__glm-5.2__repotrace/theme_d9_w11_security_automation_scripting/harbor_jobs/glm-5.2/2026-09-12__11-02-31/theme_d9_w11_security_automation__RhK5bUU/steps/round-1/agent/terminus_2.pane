func sortEnrichedThreats(threats []map[string]interface{}) {
	sort.SliceStable(threats, func(i, j int) bool {
		a := threats[i]
		b := threats[j]
		ea, _ := getFloat(a, "enriched_risk_score")
		eb, _ := getFloat(b, "enriched_risk_score")
		if ea != eb {
			return ea > eb
		}
		ta := threatSortTime(a)
		tb := threatSortTime(b)
		if !ta.Equal(tb) {
			return ta.Before(tb)
		}
		tta, _ := getString(a, "threat_type")
		ttb, _ := getString(b, "threat_type")
		return tta < ttb
	})
}

func threatSortTime(threat map[string]interface{}) time.Time {
	if tt, ok := getString(threat, "threat_type"); ok && tt == "privilege_escalation" {
		if ts, ok := getString(threat, "timestamp"); ok {
			if t, err := parseTime(ts); err == nil {
				return t
			}
		}
	}
	if ts, ok := getString(threat, "first_seen"); ok {
		if t, err := parseTime(ts); err == nil {
			return t
		}
	}
	return time.Time{}
}

func getString(m map[string]interface{}, key string) (string, bool) {
	v, ok := m[key]
	if !ok {
		return "", false
	}
	s, ok := v.(string)
	return s, ok
}

func getStringSlice(m map[string]interface{}, key string) ([]string, bool) {
	v, ok := m[key]
	if !ok {
		return nil, false
	}
	switch val := v.(type) {
	case []string:
		return val, true
	case []interface{}:
		out := make([]string, 0, len(val))
		for _, e := range val {
			s, ok := e.(string)
			if !ok {
				return nil, false
			}
			out = append(out, s)
		}
		return out, true
	default:
		return nil, false
	}
}

func getFloat(m map[string]interface{}, key string) (float64, bool) {
	v, ok := m[key]
	if !ok {
		return 0, false
	}
	switch val := v.(type) {
	case float64:
		return val, true
	case int:
		return float64(val), true
	default:
		return 0, false
	}
}

func getIntSlice(m map[string]interface{}, key string) ([]int, bool) {
	v, ok := m[key]
	if !ok {
		return nil, false
	}
	switch val := v.(type) {
	case []int:
		return val, true
	case []interface{}:
		out := make([]int, 0, len(val))
		for _, e := range val {
			switch n := e.(type) {
			case float64:
				out = append(out, int(n))
			case int:
				out = append(out, n)
			default:
				return nil, false
			}
		}
