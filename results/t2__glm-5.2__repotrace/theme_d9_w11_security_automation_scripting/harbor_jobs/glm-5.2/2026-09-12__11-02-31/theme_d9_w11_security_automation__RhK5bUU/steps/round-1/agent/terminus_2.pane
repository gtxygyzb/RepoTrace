   269	func timelineEscalationIndex(threats []map[string]interface{}) float64 {
   270		n := len(threats)
   271		if n < 2 {
   272			return 0.0
   273		}
   274		ordered := make([]map[string]interface{}, len(threats))
   275		copy(ordered, threats)
   276		sort.SliceStable(ordered, func(i, j int) bool {
   277			ti, tj := threatSortTime(ordered[i]), threatSortTime(ordered[j])
   278			if !ti.Equal(tj) {
   279				return ti.Before(tj)
   280			}
   281			tta, _ := getString(ordered[i], "threat_type")
   282			ttb, _ := getString(ordered[j], "threat_type")
   283			return tta < ttb
   284		})
   285	
   286		positiveSum := 0.0
   287		for i := 0; i < len(ordered)-1; i++ {
   288			rankI := timelineSeverityRank(getStringDefault(ordered[i], "ioc_severity"))
   289			rankJ := timelineSeverityRank(getStringDefault(ordered[i+1], "ioc_severity"))
   290			if rankI < 0 {
   291				rankI = 0
   292			}
   293			if rankJ < 0 {
   294				rankJ = 0
   295			}
   296			delta := rankJ - rankI
   297			if delta > 0 {
   298				positiveSum += float64(delta)
   299			}
   300		}
   301		return positiveSum / (4.0 * float64(n-1))
   302	}
   303	
   304	func timelineRiskTrend(threats []map[string]interface{}, startTime time.Time) float64 {
   305		n := len(threats)
   306		if n < 2 {
   307			return 0.0
   308		}
   309		xs := make([]float64, n)
   310		ys := make([]float64, n)
   311		for i, threat := range threats {
   312			refTime := threatSortTime(threat)
   313			xs[i] = refTime.Sub(startTime).Minutes()
   314			ys[i], _ = getFloat(threat, "enriched_risk_score")
   315		}
   316		sameX := true
   317		for i := 1; i < n; i++ {
   318			if xs[i] != xs[0] {
   319				sameX = false
   320				break
   321			}
   322		}
   323		if sameX {
   324			return 0.0
   325		}
   326		var sumX, sumY, sumXY, sumXX2 float64
   327		for i := 0; i < n; i++ {
   328			sumX += xs[i]
   329			sumY += ys[i]
   330			sumXY += xs[i] * ys[i]
   331			sumXX2 += xs[i] * xs[i]
   332		}
   333		denom := float64(n)*sumXX2 - sumX*sumX
   334		if denom == 0 {
   335			return 0.0
   336		}
   337		return (float64(n)*sumXY - sumX*sumY) / denom
   338	}
   339	
   340	func timelineBurstScore(threats []map[string]interface{}) float64 {
   341		n := len(threats)
   342		if n < 2 {
   343			return 0.0
   344		}
   345		times := make([]float64, n)
   346		for i, threat := range threats {
   347			refTime := threatSortTime(threat)
   348			times[i] = float64(refTime.Unix()) / 60.0
   349		}
   350		sum := 0.0
   351		pairs := 0
   352		for i := 0; i < n; i++ {
   353			for j := i + 1; j < n; j++ {
   354				sum += 1.0 / (1.0 + math.Abs(times[i]-times[j]))
   355				pairs++
   356			}
   357		}
   358		return sum / float64(pairs)
   359	}
