   577			ta := threatSortTime(a)
   578			tb := threatSortTime(b)
   579			if !ta.Equal(tb) {
   580				return ta.Before(tb)
   581			}
   582			tta, _ := getString(a, "threat_type")
   583			ttb, _ := getString(b, "threat_type")
   584			return tta < ttb
   585		})
   586	}
