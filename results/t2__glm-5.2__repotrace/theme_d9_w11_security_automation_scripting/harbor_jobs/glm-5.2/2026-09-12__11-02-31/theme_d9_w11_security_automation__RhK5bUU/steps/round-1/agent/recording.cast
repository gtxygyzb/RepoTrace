[4826.21229, "o", "   305\t\tfor _, s := range b {\r\n   306\t\t\tif set[s] && !seen[s] {\r\n   307\t\t\t\tcount++\r\n   308\t\t\t\tseen[s] = true\r\n   309\t\t\t}\r\n   310\t\t}\r\n   311\t\treturn count\r\n   312\t}\r\n   313\t\r\n   314\tfunc absDuration(d time.Duration) time.Duration {\r\n   315\t\tif d < 0 {\r\n   316\t\t\treturn -d\r\n   317\t\t}\r\n   318\t\treturn d\r\n   319\t}\r\n   320\t\r\n   321\t"]
[4826.212348, "o", "func correlateSeverityRank(s string) int {\r\n   322\t\tswitch s {\r\n   323\t\tcase \"none\":\r\n   324\t\t\treturn 0\r\n   325\t\tcase \"low\":\r\n   326\t\t\treturn 1\r\n   327\t\tcase \"medium\":\r\n   328\t\t\treturn 2\r\n   329"]
