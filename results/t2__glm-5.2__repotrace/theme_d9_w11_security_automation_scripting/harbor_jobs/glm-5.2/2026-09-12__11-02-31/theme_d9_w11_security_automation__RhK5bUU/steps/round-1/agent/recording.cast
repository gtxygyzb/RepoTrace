[11607.324574, "o", "    17\ttype forecastMetricResult struct {\r\n    18\t\tSlope       json.Number   `json:\"slope\"`\r\n    19\t\tIntercept   json.Number   `json:\"intercept\"`\r\n    20\t\tTrend       string        `json:\"trend\"`\r\n    21\t\tLastValue   json.Number   `json:\"last_value\"`\r\n    22\t\tPredictions []json.Number `json:\"predictions\"`\r\n    23\t}\r\n    24\t\r\n    25\t"]
[11607.324638, "o", "type forecastOutput struct {\r\n    26\t\tInputCount   int                             `json:\"input_count\"`\r\n    27\t\tMetrics      map[string]forecastMetricResult `json:\"metrics\"`\r\n    28\t\tOverallTrend string                          `json:\"overall_trend\"`\r\n    29\t\tAlertLevel   string                          `json:\"alert_level\"`\r\n    30\t}\r\n    31\t\r\n    32\tfunc runForecast(args []string) int {\r\n    33\t\tfs := newFlagSet(\"forecast\")\r\n"]
[11607.324704, "o", "    34\t\tsteps := fs.Int(\"steps\", 3, \"number of future steps to predict\")\r\n    35\t\tif !parseFlags(fs, args) {\r\n    36\t\t\treturn 1\r\n    37\t\t}\r\n    38\t\tif *steps < 1 {\r\n    39\t\t\tfmt.Fprintln(os.Stderr, \"error: --steps must be at least 1\")\r\n    40\t\t\treturn 1\r\n    41\t\t}\r\n    42\t\r\n    43\t\tvar snapshots []forecastInputSnapshot\r\n    44\t\tscanner := bufio.NewScanner(os.Stdin)\r\n"]
[11607.324767, "o", "    45\t\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n    46\t\tfor scanner.Scan() {\r\n    47\t\t\tline := scanner.Text()\r\n    48\t\t\tif len(line) == 0 {\r\n    49\t\t\t\tcontinue\r\n    50\t\t\t}\r\n"]
[11607.324825, "o", "    51\t\t\tvar snap forecastInputSnapshot\r\n    52\t\t\tif err := json.Unmarshal([]byte(line), &snap); err != nil {\r\n    53\t\t\t\tfmt.Fprintf(os.Stderr, \"error: malformed JSON input: %s\\n\", err)\r\n    54\t\t\t\treturn 2\r\n    55\t\t\t}\r\n    56\t\t\tsnapshots = append(snapshots, snap)\r\n    57\t\t}\r\n    58\t\tif err := scanner.Err(); err != nil {\r\n    59\t\t\tfmt.Fprintf(os.Stderr, \"error: reading input: %s\\n\", err)\r\n"]
