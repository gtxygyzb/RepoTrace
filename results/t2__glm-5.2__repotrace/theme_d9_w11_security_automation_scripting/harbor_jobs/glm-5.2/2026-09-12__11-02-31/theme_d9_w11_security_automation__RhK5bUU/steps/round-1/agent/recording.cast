[2853.653052, "o", "   198\tfunc enrichThreat(threat map[string]interface{}, iocs []processedIOC, fixedRef time.Time, hasRef bool, minConf float64) map[string]interface{} {\r\n   199\t\trefTime := fixedRef\r\n   200\t\tif !hasRef {\r\n   201\t\t\trefTime = threatReferenceTime(threat)\r\n   202\t\t}\r\n   203\t"]
[2853.653152, "o", "\r\n   204\t\tmatches := computeIOCMatches(threat, iocs, refTime, minConf)\r\n   205\t\r\n   206\t\triskScore, _ := getFloat(threat, \"risk_score\")\r\n   207\t\tmaxConf := 0.0\r\n   208\t\ttagFactor := make(map[string]float64)\r\n   209\t\tseverityContrib := 0\r\n   210\t\tindicatorTypes := make(map[string]bool)\r\n   211\t\tactors := make(map[string]bool)\r\n   212\t\tsevRank := 0\r\n   213\t\r\n   214\t\tfor _, m := range matches {\r\n   215\t\t\tif m.adjusted > maxConf {\r\n   216\t\t\t\tmaxConf = m.adjusted\r\n   217\t\t\t}\r\n"]
[2853.653226, "o", "   218\t\t\tfor _, tag := range m.p.entry.Tags {\r\n   219\t\t\t\tif cur, ok := tagFactor[tag]; ok {\r\n   220\t\t\t\t\tif m.freshness > cur {\r\n   221\t\t\t\t\t\ttagFactor[tag] = m.freshness\r\n   222\t\t\t\t\t}\r\n   223\t\t\t\t} else {\r\n   224\t\t\t\t\ttagFactor[tag] = m.freshness\r\n   225\t\t\t\t}\r\n   226\t\t\t}\r\n"]
[2853.653292, "o", "   227\t\t\tseverityContrib += severityWeight(m.p.entry.Severity)\r\n   228\t\t\tindicatorTypes[m.p.entry.IndicatorType] = true\r\n   229\t\t\tactors[m.p.entry.ThreatActor] = true\r\n   230\t\t\tif v := severityValue(m.p.entry.Severity); v > sevRank {\r\n   231\t\t\t\tsevRank = v\r\n   232\t\t\t}\r\n   233\t\t}\r\n   234\t\r\n   235\t\t"]
[2853.653373, "o", "tagBonus := 0.0\r\n   236\t\tfor tag, factor := range tagFactor {\r\n   237\t\t\ttagBonus += tagBonusValue(tag) * factor\r\n   238\t\t}\r\n   239\t\r\n   240\t\tmultiVectorBonus := 0.0\r\n   241\t\tswitch len(indicatorTypes) {\r\n   242\t\tcase 0, 1:\r\n   243\t\t\tmultiVectorBonus = 0.0\r\n"]
[2853.653469, "o", "   244\t\tcase 2:\r\n   245\t\t\tmultiVectorBonus = 25.0\r\n   246\t\tdefault:\r\n   247\t\t\tmultiVectorBonus = 50.0\r\n   248\t\t}\r\n   249\t\r\n   250\t\t"]
[2853.65353, "o", "actorBonus := 0.0\r\n   251\t\tswitch len(actors) {\r\n   252\t\tcase 0, 1:\r\n   253\t\t\tactorBonus = 0.0\r\n   254\t\tcase 2:\r\n   255\t\t\tactorBonus = 15.0\r\n   256\t\tdefault:\r\n   257\t\t\tactorBonus = 30.0\r\n   258\t\t}\r\n   259\t\r\n   260\t\tenrichedScore := riskScore*(1.0+maxConf) + tagBonus + multiVectorBonus + float64(severityContrib) + actorBonus\r\n   261\t\r\n   262\t\toutMatches := make([]iocMatchOutput, 0, len(matches))\r\n   263\t\tfor _, m := range matches {\r\n"]
[2853.653592, "o", "   264\t\t\toutMatches = append(outMatches, iocMatchOutput{\r\n   265\t\t\t\tIocID:         m.p.entry.ID,\r\n   266\t\t\t\tIndicator:     m.p.entry.Indicator,\r\n   267\t\t\t\tIndicatorType: m.p.entry.IndicatorType,\r\n   268\t\t\t\tThreatActor:   m.p.entry.ThreatActor,\r\n"]
[2853.65365, "o", "   269\t\t\t\tConfidence:    m.p.entry.Confidence,\r\n   270\t\t\t\tTags:          nonNilStrings(m.p.entry.Tags),\r\n   271\t\t\t\tMatchedFields: nonNilStrings(m.matchedFields),\r\n   272\t\t\t})\r\n   273\t\t}\r\n"]
[2853.653713, "o", "   274\t\r\n   275\t\tthreat[\"ioc_matches\"] = outMatches\r\n   276\t\tthreat[\"enriched_risk_score\"] = enrichedScore\r\n   277\t\tthreat[\"threat_actors\"] = nonNilStrings(sortedUniqueStringsFromSet(actors))\r\n"]
[2853.653782, "o", "   278\t\tthreat[\"max_ioc_confidence\"] = maxConf\r\n   279\t\tif len(matches) == 0 {\r\n   280\t\t\tthreat[\"ioc_severity\"] = \"none\"\r\n"]
[2853.653844, "o", "   281\t\t} else {\r\n   282\t\t\tthreat[\"ioc_severity\"] = severityFromRank(sevRank)\r\n   283\t\t}\r\n   284\t\treturn threat\r\n   285\t}\r\n   286\t\r\n"]
