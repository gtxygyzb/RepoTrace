[8924.367966, "o", "> "]
[8924.368071, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[8924.368134, "o", "\u001b[?2004h> "]
[8924.368243, "o", "p=Path('main.go')\r\n"]
[8924.368316, "o", "\u001b[?2004l\r"]
[8924.368372, "o", "\u001b[?2004h> "]
[8924.368431, "o", "s=p.read_text()\r\n\u001b[?2004l\r"]
[8924.368494, "o", "\u001b[?2004h> "]
[8924.368774, "o", "s=s.replace('track|diff>', 'track|diff|anomaly>')\r\n\u001b[?2004l\r"]
[8924.368832, "o", "\u001b[?2004h> "]
[8924.369826, "o", "s=s.replace('\\tcase \"diff\":\\n\\t\\tcode = runDiff(os.Args[2:])\\n', '\\tcase \"diff\":\\n\\t\\tcode = runDiff(os.Args[2:])\\n\\tcase \"anomaly\":\\n\\t\\tcode = runAnomaly(os.Args[2:])\\n')\r\n\u001b[?2004l\r"]
