[862.365651, "o", "\u001b[?2004h"]
[862.365707, "o", "> "]
[862.36577, "o", "    \"fmt\"\r\n\u001b[?2004l\r"]
[862.365836, "o", "\u001b[?2004h> "]
[862.365922, "o", "    \"os\"\r\n\u001b[?2004l\r"]
[862.365978, "o", "\u001b[?2004h> "]
[862.366086, "o", "    \"sort\"\r\n\u001b[?2004l\r"]
[862.366134, "o", "\u001b[?2004h"]
[862.366181, "o", "> "]
[862.366249, "o", "    \"time\"\r\n\u001b[?2004l\r"]
[862.366299, "o", "\u001b[?2004h"]
[862.366311, "o", "> "]
[862.366373, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.366386, "o", "> \r\n\u001b[?2004l\r"]
[862.366447, "o", "\u001b[?2004h> "]
[862.366598, "o", "type Summary struct {\r\n"]
[862.366611, "o", "\u001b[?2004l\r"]
[862.366673, "o", "\u001b[?2004h> "]
[862.367059, "o", "    TotalEvents    int               `json:\"total_events\"`\r\n\u001b[?2004l\r"]
[862.367109, "o", "\u001b[?2004h"]
[862.367121, "o", "> "]
[862.367516, "o", "    TimeRange      TimeRange         `json:\"time_range\"`\r\n\u001b[?2004l\r"]
[862.367571, "o", "\u001b[?2004h> "]
[862.367959, "o", "    BySeverity     map[string]int    `json:\"by_severity\"`\r\n\u001b[?2004l\r"]
[862.368008, "o", "\u001b[?2004h"]
[862.36802, "o", "> "]
[862.368425, "o", "    ByAction       map[string]int    `json:\"by_action\"`\r\n\u001b[?2004l\r"]
[862.368482, "o", "\u001b[?2004h"]
[862.368495, "o", "> "]
[862.368877, "o", "    ByEventType    map[string]int    `json:\"by_event_type\"`\r\n\u001b[?2004l\r"]
[862.36893, "o", "\u001b[?2004h> "]
[862.369357, "o", "    TopSourceIPs   []SourceIPStat    `json:\"top_source_ips\"`\r\n\u001b[?2004l\r"]
[862.369407, "o", "\u001b[?2004h"]
[862.36942, "o", "> "]
[862.369823, "o", "    TopDestPorts   []DestPortStat    `json:\"top_dest_ports\"`\r\n\u001b[?2004l\r"]
[862.369876, "o", "\u001b[?2004h"]
[862.36989, "o", "> "]
[862.370332, "o", "    UniqueSourceIPs int              `json:\"unique_source_ips\"`\r\n\u001b[?2004l\r"]
[862.370388, "o", "\u001b[?2004h"]
[862.370401, "o", "> "]
[862.370802, "o", "    UniqueDestIPs   int              `json:\"unique_dest_ips\"`\r\n\u001b[?2004l\r"]
[862.370854, "o", "\u001b[?2004h> "]
[862.37129, "o", "    SeverityTrend  []SeverityWindow  `json:\"severity_trend\"`\r\n\u001b[?2004l\r"]
[862.371346, "o", "\u001b[?2004h> }"]
[862.371397, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.371452, "o", "> \r\n\u001b[?2004l\r"]
[862.371506, "o", "\u001b[?2004h> "]
[862.371646, "o", "type TimeRange struct {\r\n\u001b[?2004l\r"]
[862.3717, "o", "\u001b[?2004h> "]
[862.371923, "o", "    Start string `json:\"start\"`\r\n\u001b[?2004l\r"]
[862.371977, "o", "\u001b[?2004h> "]
[862.372187, "o", "    End   string `json:\"end\"`\r\n\u001b[?2004l\r"]
[862.372262, "o", "\u001b[?2004h> "]
[862.372314, "o", "}\r\n\u001b[?2004l\r"]
[862.372359, "o", "\u001b[?2004h> \r\n"]
[862.372409, "o", "\u001b[?2004l\r\u001b[?2004h"]
[862.37246, "o", "> "]
[862.372584, "o", "type SourceIPStat struct {\r\n\u001b[?2004l\r"]
[862.372629, "o", "\u001b[?2004h"]
[862.372679, "o", "> "]
[862.372891, "o", "    IP          string  `json:\"ip\"`\r\n\u001b[?2004l\r"]
[862.372943, "o", "\u001b[?2004h> "]
[862.373218, "o", "    Count       int     `json:\"count\"`\r\n\u001b[?2004l\r"]
[862.373267, "o", "\u001b[?2004h"]
[862.373319, "o", "> "]
[862.373591, "o", "    ThreatScore float64 `json:\"threat_score\"`\r\n\u001b[?2004l\r"]
[862.373639, "o", "\u001b[?2004h"]
[862.373688, "o", "> "]
[862.373739, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.373782, "o", "> \r\n\u001b[?2004l\r"]
[862.373838, "o", "\u001b[?2004h> "]
[862.373979, "o", "type DestPortStat struct {\r\n\u001b[?2004l\r"]
[862.374025, "o", "\u001b[?2004h"]
[862.374039, "o", "> "]
[862.37425, "o", "    Port  int `json:\"port\"`\r\n\u001b[?2004l\r"]
[862.374301, "o", "\u001b[?2004h"]
[862.374354, "o", "> "]
[862.374512, "o", "    Count int `json:\"count\"`\r\n\u001b[?2004l\r"]
[862.374564, "o", "\u001b[?2004h"]
[862.374617, "o", "> }\r\n\u001b[?2004l\r"]
[862.374657, "o", "\u001b[?2004h"]
[862.374672, "o", "> \r\n\u001b[?2004l\r"]
[862.374737, "o", "\u001b[?2004h> "]
[862.374906, "o", "type SeverityWindow struct {\r\n\u001b[?2004l\r"]
[862.374959, "o", "\u001b[?2004h> "]
[862.375288, "o", "    WindowStart  string  `json:\"window_start\"`\r\n\u001b[?2004l\r"]
[862.375341, "o", "\u001b[?2004h> "]
[862.375647, "o", "    WindowEnd    string  `json:\"window_end\"`\r\n\u001b[?2004l\r"]
[862.375701, "o", "\u001b[?2004h> "]
[862.376029, "o", "    AvgSeverity  float64 `json:\"avg_severity\"`\r\n\u001b[?2004l\r"]
[862.376085, "o", "\u001b[?2004h> }"]
[862.376134, "o", "\r\n\u001b[?2004l\r"]
[862.376184, "o", "\u001b[?2004h> \r\n"]
[862.37625, "o", "\u001b[?2004l\r\u001b[?2004h"]
[862.376304, "o", "> "]
[862.376496, "o", "func runSummarize(args []string) int {\r\n\u001b[?2004l\r"]
[862.376547, "o", "\u001b[?2004h> "]
[862.376785, "o", "    fs := newFlagSet(\"summarize\")\r\n\u001b[?2004l\r"]
[862.376835, "o", "\u001b[?2004h"]
[862.376888, "o", "> "]
[862.377334, "o", "    format := fs.String(\"format\", \"json\", \"output format (text|json)\")\r\n\u001b[?2004l\r"]
[862.377388, "o", "\u001b[?2004h> "]
[862.377603, "o", "    if !parseFlags(fs, args) {\r\n\u001b[?2004l\r"]
[862.377655, "o", "\u001b[?2004h> "]
[862.377771, "o", "        return 1\r\n"]
[862.377786, "o", "\u001b[?2004l\r"]
[862.377851, "o", "\u001b[?2004h"]
[862.377899, "o", "> "]
[862.37795, "o", "    }\r\n\u001b[?2004l\r"]
[862.378, "o", "\u001b[?2004h> "]
[862.378286, "o", "    if *format != \"json\" && *format != \"text\" {\r\n\u001b[?2004l\r"]
[862.378338, "o", "\u001b[?2004h> "]
[862.378681, "o", "        fmt.Fprintln(os.Stderr, \"invalid format\")\r\n\u001b[?2004l\r"]
[862.378724, "o", "\u001b[?2004h"]
[862.378772, "o", "> "]
[862.378861, "o", "        return 1\r\n\u001b[?2004l\r"]
[862.378915, "o", "\u001b[?2004h> "]
[862.378961, "o", "    }\r\n\u001b[?2004l\r"]
[862.379014, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[862.379056, "o", "\u001b[?2004h"]
[862.37907, "o", "> "]
[862.379312, "o", "    events, err := readEvents()\r\n\u001b[?2004l\r"]
[862.37937, "o", "\u001b[?2004h> "]
[862.379611, "o", "    summary := buildSummary(events)\r\n\u001b[?2004l\r"]
[862.379664, "o", "\u001b[?2004h> "]
[862.379853, "o", "    if *format == \"text\" {\r\n\u001b[?2004l\r"]
[862.379905, "o", "\u001b[?2004h> "]
[862.380144, "o", "        printTextSummary(summary)\r\n\u001b[?2004l\r"]
[862.380201, "o", "\u001b[?2004h> "]
[862.380313, "o", "    } else {\r\n\u001b[?2004l\r"]
[862.380357, "o", "\u001b[?2004h"]
[862.380406, "o", "> "]
[862.38061, "o", "        printJSONSummary(summary)\r\n\u001b[?2004l\r"]
[862.380664, "o", "\u001b[?2004h> "]
[862.380715, "o", "    }\r\n\u001b[?2004l\r"]
[862.38077, "o", "\u001b[?2004h> "]
[862.380902, "o", "    if err != nil {\r\n"]
[862.380916, "o", "\u001b[?2004l\r"]
[862.380986, "o", "\u001b[?2004h> "]
[862.381226, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r"]
[862.381277, "o", "\u001b[?2004h> "]
[862.381366, "o", "        return 2\r\n\u001b[?2004l\r"]
[862.381422, "o", "\u001b[?2004h> "]
[862.381478, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.381537, "o", "    return 0\r\n\u001b[?2004l\r"]
[862.381593, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[862.38165, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[862.381706, "o", "\u001b[?2004h> "]
[862.381908, "o", "func buildSummary(events []Event) Summary {\r\n\u001b[?2004l\r"]
[862.381967, "o", "\u001b[?2004h> "]
[862.382046, "o", "    s := Summary{\r\n\u001b[?2004l\r"]
[862.382105, "o", "\u001b[?2004h> "]
[862.395711, "o", "        TotalEvents: len(events),\r\n\u001b[?2004l\r"]
[862.395746, "o", "\u001b[?2004h> "]
[862.396058, "o", "        BySeverity:  make(map[string]int),\r\n\u001b[?2004l\r"]
[862.396121, "o", "\u001b[?2004h> "]
[862.396456, "o", "        ByAction:    make(map[string]int),\r\n\u001b[?2004l\r"]
[862.396519, "o", "\u001b[?2004h> "]
[862.396808, "o", "        ByEventType: make(map[string]int),\r\n\u001b[?2004l\r"]
[862.396863, "o", "\u001b[?2004h> "]
[862.396923, "o", "    }\r\n\u001b[?2004l\r"]
[862.396978, "o", "\u001b[?2004h> "]
[862.39714, "o", "    if len(events) == 0 {\r\n\u001b[?2004l\r"]
[862.397206, "o", "\u001b[?2004h> "]
[862.397567, "o", "        s.TimeRange = TimeRange{Start: \"\", End: \"\"}\r\n\u001b[?2004l\r"]
[862.397627, "o", "\u001b[?2004h> "]
[862.39794, "o", "        s.TopSourceIPs = []SourceIPStat{}\r\n\u001b[?2004l\r"]
[862.397995, "o", "\u001b[?2004h> "]
[862.398284, "o", "        s.TopDestPorts = []DestPortStat{}\r\n\u001b[?2004l\r"]
[862.398343, "o", "\u001b[?2004h> "]
[862.398659, "o", "        s.SeverityTrend = []SeverityWindow{}\r\n\u001b[?2004l\r"]
[862.398716, "o", "\u001b[?2004h> "]
[862.398828, "o", "        return s\r\n\u001b[?2004l\r"]
[862.398885, "o", "\u001b[?2004h> "]
[862.398943, "o", "    }\r\n\u001b[?2004l\r"]
[862.398999, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[862.399056, "o", "\u001b[?2004h"]
[862.399111, "o", "> "]
[862.399277, "o", "    var minT, maxT time.Time\r\n\u001b[?2004l\r"]
[862.399341, "o", "\u001b[?2004h> "]
[862.399619, "o", "    sourceCounts := make(map[string]int)\r\n\u001b[?2004l\r"]
[862.399676, "o", "\u001b[?2004h> "]
[862.399978, "o", "    sourceScores := make(map[string]float64)\r\n\u001b[?2004l\r"]
[862.400034, "o", "\u001b[?2004h> "]
[862.400294, "o", "    destIPs := make(map[string]bool)\r\n\u001b[?2004l\r"]
[862.400353, "o", "\u001b[?2004h> "]
[862.400593, "o", "    portCounts := make(map[int]int)\r\n\u001b[?2004l\r"]
[862.400645, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[862.400702, "o", "\u001b[?2004h> "]
[862.400926, "o", "    for i, e := range events {\r\n\u001b[?2004l\r"]
[862.400979, "o", "\u001b[?2004h> "]
[862.401187, "o", "        t, ok := eventTime(e)\r\n\u001b[?2004l\r"]
[862.401249, "o", "\u001b[?2004h> "]
[862.401359, "o", "        if ok {\r\n\u001b[?2004l\r"]
[862.401419, "o", "\u001b[?2004h"]
[862.40147, "o", "> "]
[862.401713, "o", "            if i == 0 || t.Before(minT) {\r\n\u001b[?2004l\r"]
[862.401773, "o", "\u001b[?2004h> "]
[862.401943, "o", "                minT = t\r\n\u001b[?2004l\r"]
[862.401996, "o", "\u001b[?2004h> "]
[862.402102, "o", "            }\r\n\u001b[?2004l\r"]
[862.402157, "o", "\u001b[?2004h> "]
[862.402444, "o", "            if i == 0 || t.After(maxT) {\r\n\u001b[?2004l\r"]
[862.4025, "o", "\u001b[?2004h> "]
[862.402669, "o", "                maxT = t\r\n\u001b[?2004l\r"]
[862.402724, "o", "\u001b[?2004h> "]
[862.402829, "o", "            }\r\n\u001b[?2004l\r"]
[862.402884, "o", "\u001b[?2004h> "]
[862.403, "o", "        } else {\r\n\u001b[?2004l\r"]
[862.403059, "o", "\u001b[?2004h> "]
[862.403312, "o", "            if e.Timestamp != \"\" {\r\n\u001b[?2004l\r"]
[862.403371, "o", "\u001b[?2004h> "]
[862.403725, "o", "                if i == 0 || e.Timestamp < minTStr {\r\n\u001b[?2004l\r"]
[862.403781, "o", "\u001b[?2004h> "]
[862.404061, "o", "                    minTStr = e.Timestamp\r\n\u001b[?2004l\r"]
[862.404116, "o", "\u001b[?2004h> "]
[862.404251, "o", "                }\r\n\u001b[?2004l\r"]
[862.404315, "o", "\u001b[?2004h> "]
[862.404664, "o", "                if i == 0 || e.Timestamp > maxTStr {\r\n\u001b[?2004l\r"]
[862.40472, "o", "\u001b[?2004h> "]
[862.405003, "o", "                    maxTStr = e.Timestamp\r\n\u001b[?2004l\r"]
[862.405058, "o", "\u001b[?2004h> "]
[862.405177, "o", "                }\r\n\u001b[?2004l\r"]
[862.405234, "o", "\u001b[?2004h> "]
[862.405344, "o", "            }\r\n\u001b[?2004l\r"]
[862.405391, "o", "\u001b[?2004h> "]
[862.405476, "o", "        }\r\n\u001b[?2004l\r"]
[862.405525, "o", "\u001b[?2004h> "]
[862.405773, "o", "        s.BySeverity[e.Severity]++\r\n\u001b[?2004l\r"]
[862.40583, "o", "\u001b[?2004h> "]
[862.406047, "o", "        s.ByAction[e.Action]++\r\n\u001b[?2004l\r"]
[862.406102, "o", "\u001b[?2004h> "]
[862.40636, "o", "        s.ByEventType[e.EventType]++\r\n\u001b[?2004l\r"]
[862.406418, "o", "\u001b[?2004h> "]
[862.40665, "o", "        sourceCounts[e.SourceIP]++\r\n\u001b[?2004l\r"]
[862.406713, "o", "\u001b[?2004h> "]
[862.407185, "o", "        sourceScores[e.SourceIP] += float64(severityValue(e.Severity))\r\n\u001b[?2004l\r"]
[862.407249, "o", "\u001b[?2004h> "]
[862.407473, "o", "        destIPs[e.DestIP] = true\r\n\u001b[?2004l\r"]
[862.407529, "o", "\u001b[?2004h> "]
[862.40775, "o", "        portCounts[e.DestPort]++\r\n\u001b[?2004l\r"]
[862.407815, "o", "\u001b[?2004h> "]
[862.407871, "o", "    }\r\n\u001b[?2004l\r"]
[862.407927, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[862.407983, "o", "\u001b[?2004h> "]
[862.408168, "o", "    s.TimeRange = TimeRange{\r\n\u001b[?2004l\r"]
[862.408233, "o", "\u001b[?2004h> "]
[862.408479, "o", "        Start: minT.Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[862.408535, "o", "\u001b[?2004h> "]
[862.408772, "o", "        End:   maxT.Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[862.408836, "o", "\u001b[?2004h"]
[862.408895, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.408954, "o", "> "]
[862.409153, "o", "    s.UniqueSourceIPs = len(sourceCounts)\r\n\u001b[?2004l\r"]
[862.409208, "o", "\u001b[?2004h> "]
[862.409412, "o", "    s.UniqueDestIPs = len(destIPs)\r\n\u001b[?2004l\r"]
[862.409469, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[862.409532, "o", "\u001b[?2004h> "]
[862.409873, "o", "    s.TopSourceIPs = topSourceIPs(sourceCounts, sourceScores)\r\n\u001b[?2004l\r"]
[862.409928, "o", "\u001b[?2004h> "]
[862.410184, "o", "    s.TopDestPorts = topDestPorts(portCounts)\r\n\u001b[?2004l\r"]
[862.410258, "o", "\u001b[?2004h> "]
[862.410522, "o", "    s.SeverityTrend = severityTrend(events, minT)\r\n\u001b[?2004l\r"]
[862.410578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[862.41064, "o", "\u001b[?2004h> "]
[862.410715, "o", "    return s\r\n\u001b[?2004l\r"]
[862.410782, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[862.410838, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[862.410896, "o", "\u001b[?2004h> "]
[862.411057, "o", "var minTStr, maxTStr string\r\n\u001b[?2004l\r"]
[862.411111, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[862.411173, "o", "\u001b[?2004h> "]
[862.411652, "o", "func topSourceIPs(counts map[string]int, scores map[string]float64) []SourceIPStat {\r\n\u001b[?2004l\r"]
[862.411709, "o", "\u001b[?2004h> "]
[862.411978, "o", "    out := make([]SourceIPStat, 0, len(counts))\r\n\u001b[?2004l\r"]
[862.412033, "o", "\u001b[?2004h> "]
[862.412224, "o", "    for ip, c := range counts {\r\n\u001b[?2004l\r"]
[862.412281, "o", "\u001b[?2004h> "]
[862.412581, "o", "        out = append(out, SourceIPStat{IP: ip, Count: c, ThreatScore: scores[ip]})\r\n\u001b[?2004l\r"]
[862.412637, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[862.412692, "o", "\u001b[?2004h> "]
[862.412841, "o", "    sort.Slice(out, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[862.412898, "o", "\u001b[?2004h> "]
[862.413038, "o", "        if out[i].Count != out[j].Count {\r\n\u001b[?2004l\r"]
[862.413094, "o", "\u001b[?2004h> "]
[862.413257, "o", "            return out[i].Count > out[j].Count\r\n\u001b[?2004l\r"]
[862.413311, "o", "\u001b[?2004h> "]
[862.413368, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.41351, "o", "        return out[i].IP < out[j].IP\r\n\u001b[?2004l\r"]
[862.413566, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
[862.413621, "o", "\u001b[?2004h> "]
[862.413701, "o", "    if len(out) > 10 {\r\n\u001b[?2004l\r"]
[862.413756, "o", "\u001b[?2004h> "]
[862.413826, "o", "        out = out[:10]\r\n\u001b[?2004l\r"]
[862.41388, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[862.413939, "o", "\u001b[?2004h> "]
[862.413999, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.414065, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[862.414121, "o", "\u001b[?2004h> "]
[862.414318, "o", "func topDestPorts(counts map[int]int) []DestPortStat {\r\n\u001b[?2004l\r"]
[862.414374, "o", "\u001b[?2004h> "]
[862.414536, "o", "    out := make([]DestPortStat, 0, len(counts))\r\n\u001b[?2004l\r"]
[862.414589, "o", "\u001b[?2004h> "]
[862.414691, "o", "    for p, c := range counts {\r\n\u001b[?2004l\r"]
[862.414746, "o", "\u001b[?2004h> "]
[862.414948, "o", "        out = append(out, DestPortStat{Port: p, Count: c})\r\n\u001b[?2004l\r"]
[862.415003, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[862.41506, "o", "\u001b[?2004h> "]
[862.415203, "o", "    sort.Slice(out, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[862.415267, "o", "\u001b[?2004h> "]
[862.415403, "o", "        if out[i].Count != out[j].Count {\r\n\u001b[?2004l\r"]
[862.415458, "o", "\u001b[?2004h> "]
[862.415615, "o", "            return out[i].Count > out[j].Count\r\n\u001b[?2004l\r"]
[862.415671, "o", "\u001b[?2004h> "]
[862.415726, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.415882, "o", "        return out[i].Port < out[j].Port\r\n\u001b[?2004l\r"]
[862.415907, "o", "\u001b[?2004h> "]
[862.416025, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.416078, "o", "    if len(out) > 10 {\r\n\u001b[?2004l\r"]
[862.416133, "o", "\u001b[?2004h> "]
[862.416207, "o", "        out = out[:10]\r\n\u001b[?2004l\r"]
[862.41627, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[862.416324, "o", "\u001b[?2004h> "]
[862.41637, "o", "    return out\r\n\u001b[?2004l\r"]
[862.416424, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.416478, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.416753, "o", "func severityTrend(events []Event, first time.Time) []SeverityWindow {\r\n\u001b[?2004l\r"]
[862.416806, "o", "\u001b[?2004h> "]
[862.416937, "o", "    windows := make(map[int64][]Event)\r\n\u001b[?2004l\r"]
[862.416992, "o", "\u001b[?2004h> "]
[862.417091, "o", "    for _, e := range events {\r\n\u001b[?2004l\r"]
[862.417145, "o", "\u001b[?2004h> "]
[862.417253, "o", "        t, ok := eventTime(e)\r\n\u001b[?2004l\r"]
[862.417311, "o", "\u001b[?2004h> "]
[862.417375, "o", "        if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.417469, "o", "            continue\r\n\u001b[?2004l\r"]
[862.417523, "o", "\u001b[?2004h> "]
[862.417578, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.417769, "o", "        offset := int64(t.Sub(first).Seconds())\r\n\u001b[?2004l\r"]
[862.417824, "o", "\u001b[?2004h> "]
[862.417899, "o", "        if offset < 0 {\r\n\u001b[?2004l\r"]
[862.417954, "o", "\u001b[?2004h> "]
[862.418024, "o", "            offset = 0\r\n\u001b[?2004l\r"]
[862.418078, "o", "\u001b[?2004h> "]
[862.418132, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.418265, "o", "        window := offset / 3600\r\n\u001b[?2004l\r"]
[862.418321, "o", "\u001b[?2004h> "]
[862.418502, "o", "        windows[window] = append(windows[window], e)\r\n\u001b[?2004l\r"]
[862.418555, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[862.418611, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[862.41867, "o", "\u001b[?2004h> "]
[862.41874, "o", "    var keys []int64\r\n\u001b[?2004l\r"]
[862.418798, "o", "\u001b[?2004h> "]
[862.418873, "o", "    for k := range windows {\r\n\u001b[?2004l\r"]
[862.418927, "o", "\u001b[?2004h> "]
[862.419029, "o", "        keys = append(keys, k)\r\n\u001b[?2004l\r"]
[862.419083, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[862.419137, "o", "\u001b[?2004h> "]
[862.419399, "o", "    sort.Slice(keys, func(i, j int) bool { return keys[i] < keys[j] })\r\n\u001b[?2004l\r"]
[862.419453, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[862.419508, "o", "> "]
[862.419657, "o", "    out := make([]SeverityWindow, 0, len(keys))\r\n\u001b[?2004l\r"]
[862.41971, "o", "\u001b[?2004h> "]
[862.419806, "o", "    for _, k := range keys {\r\n\u001b[?2004l\r"]
[862.419862, "o", "\u001b[?2004h> "]
[862.419941, "o", "        evs := windows[k]\r\n\u001b[?2004l\r"]
[862.419996, "o", "\u001b[?2004h> "]
[862.420075, "o", "        var total float64\r\n\u001b[?2004l\r"]
[862.42013, "o", "\u001b[?2004h> "]
[862.420239, "o", "        for _, e := range evs {\r\n\u001b[?2004l\r"]
[862.420294, "o", "\u001b[?2004h> "]
[862.420485, "o", "            total += float64(severityValue(e.Severity))\r\n\u001b[?2004l\r"]
[862.42054, "o", "\u001b[?2004h> "]
[862.420594, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.420753, "o", "        avg := total / float64(len(evs))\r\n\u001b[?2004l\r"]
[862.420807, "o", "\u001b[?2004h> "]
[862.42103, "o", "        start := first.Add(time.Duration(k*3600) * time.Second)\r\n\u001b[?2004l\r"]
[862.421086, "o", "\u001b[?2004h> "]
[862.421321, "o", "        end := first.Add(time.Duration((k+1)*3600) * time.Second)\r\n\u001b[?2004l\r"]
[862.421378, "o", "\u001b[?2004h> "]
[862.421514, "o", "        out = append(out, SeverityWindow{\r\n\u001b[?2004l\r"]
[862.421569, "o", "\u001b[?2004h> "]
[862.421749, "o", "            WindowStart: start.Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[862.421803, "o", "\u001b[?2004h> "]
[862.421975, "o", "            WindowEnd:   end.Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[862.422031, "o", "\u001b[?2004h> "]
[862.422154, "o", "            AvgSeverity: round2(avg),\r\n\u001b[?2004l\r"]
[862.42221, "o", "\u001b[?2004h> "]
[862.422278, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.422335, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.422402, "o", "    return out\r\n\u001b[?2004l\r"]
[862.422457, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[862.422512, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.422663, "o", "func printJSONSummary(s Summary) {\r\n\u001b[?2004l\r"]
[862.422717, "o", "\u001b[?2004h> "]
[862.422836, "o", "    w := bufio.NewWriter(os.Stdout)\r\n\u001b[?2004l\r"]
[862.42289, "o", "\u001b[?2004h> "]
[862.422951, "o", "    defer w.Flush()\r\n\u001b[?2004l\r"]
[862.423005, "o", "\u001b[?2004h> "]
[862.423076, "o", "    enc := json.NewEncoder(w)\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.423134, "o", "> "]
[862.423194, "o", "    enc.SetEscapeHTML(false)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.423322, "o", "    if err := enc.Encode(s); err != nil {\r\n\u001b[?2004l\r"]
[862.42338, "o", "\u001b[?2004h> "]
[862.423448, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r"]
[862.423504, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.423562, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[862.423615, "o", "\u001b[?2004h> "]
[862.423682, "o", "func printTextSummary(s Summary) {\r\n\u001b[?2004l\r"]
[862.423738, "o", "\u001b[?2004h> "]
[862.423808, "o", "    w := bufio.NewWriter(os.Stdout)\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.423897, "o", "> "]
[862.423988, "o", "    defer w.Flush()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.424088, "o", "    fmt.Fprintf(w, \"=== Security Log Summary ===\\n\")\r\n\u001b[?2004l\r"]
[862.424145, "o", "\u001b[?2004h> "]
[862.424268, "o", "    fmt.Fprintf(w, \"Total Events: %d\\n\", s.TotalEvents)\r\n\u001b[?2004l\r"]
[862.424324, "o", "\u001b[?2004h> "]
[862.424508, "o", "    fmt.Fprintf(w, \"Time Range: %s to %s\\n\", s.TimeRange.Start, s.TimeRange.End)\r\n\u001b[?2004l\r"]
[862.424566, "o", "\u001b[?2004h> "]
[862.424707, "o", "    fmt.Fprintf(w, \"Unique Source IPs: %d\\n\", s.UniqueSourceIPs)\r\n\u001b[?2004l\r"]
[862.424763, "o", "\u001b[?2004h> "]
[862.424896, "o", "    fmt.Fprintf(w, \"Unique Dest IPs: %d\\n\", s.UniqueDestIPs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.424952, "o", "> "]
[862.425007, "o", "    fmt.Fprintln(w)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[862.425063, "o", "> "]
[862.425174, "o", "    fmt.Fprintln(w, \"--- Severity Distribution ---\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.425239, "o", "> "]
[862.425377, "o", "    severities := []string{\"critical\", \"high\", \"medium\", \"low\"}\r\n\u001b[?2004l\r"]
[862.425432, "o", "\u001b[?2004h> "]
[862.425506, "o", "    for _, sev := range severities {\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.425561, "o", "> "]
[862.425625, "o", "        count := s.BySeverity[sev]\r\n\u001b[?2004l\r"]
[862.425679, "o", "\u001b[?2004h> "]
[862.425732, "o", "        if count == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.425804, "o", "            continue\r\n\u001b[?2004l\r"]
[862.425858, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[862.425917, "o", "\u001b[?2004h> "]
[862.425972, "o", "        pct := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.426047, "o", "        if s.TotalEvents > 0 {\r\n\u001b[?2004l\r"]
[862.426101, "o", "\u001b[?2004h> "]
[862.426255, "o", "            pct = float64(count) * 100.0 / float64(s.TotalEvents)\r\n\u001b[?2004l\r"]
[862.426312, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.426371, "o", "> "]
[862.426504, "o", "        fmt.Fprintf(w, \"  %s: %d (%.1f%%)\\n\", sev, count, pct)\r\n\u001b[?2004l\r"]
[862.426557, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.426612, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.426674, "o", "    fmt.Fprintln(w)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.426807, "o", "    fmt.Fprintln(w, \"--- Top Source IPs ---\")\r\n\u001b[?2004l\r"]
[862.426862, "o", "\u001b[?2004h> "]
[862.426944, "o", "    for i, src := range s.TopSourceIPs {\r\n\u001b[?2004l\r"]
[862.426999, "o", "\u001b[?2004h> "]
[862.427261, "o", "        fmt.Fprintf(w, \"  %d. %s - %d events (threat score: %g)\\n\", i+1, src.IP, src.Count, src.ThreatScore)\r\n\u001b[?2004l\r"]
[862.427318, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[862.427372, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[862.427434, "o", "    fmt.Fprintln(w)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[862.42758, "o", "    fmt.Fprintln(w, \"--- Action Distribution ---\")\r\n\u001b[?2004l\r"]
[862.427634, "o", "\u001b[?2004h> "]
[862.427755, "o", "    fmt.Fprintf(w, \"ALLOW: %d\\n\", s.ByAction[\"ALLOW\"])\r\n\u001b[?2004l\r"]
[862.42781, "o", "\u001b[?2004h> "]
[862.42793, "o", "    fmt.Fprintf(w, \"DENY:  %d\\n\", s.ByAction[\"DENY\"])\r\n\u001b[?2004l\r"]
[862.427984, "o", "\u001b[?2004h> "]
[862.428104, "o", "    fmt.Fprintf(w, \"DROP:  %d\\n\", s.ByAction[\"DROP\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[862.42816, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[862.43082, "o", "\u001b[?2004hroot@n30009:/app# "]
