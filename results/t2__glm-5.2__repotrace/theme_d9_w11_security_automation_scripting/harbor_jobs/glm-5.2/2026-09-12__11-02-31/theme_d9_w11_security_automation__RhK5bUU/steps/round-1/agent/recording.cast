[1848.696324, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"sort\"\r\n"]
[1848.696409, "o", "\t\"time\"\r\n)\r\n\r\ntype Threat struct {\r\n\tThreatType       string\r\n\tSourceIP         string\r\n\tDestIP           string\r\n\tCount            int\r\n\tFirstSeen        string\r\n\tLastSeen         string\r\n\tTargetUsers      []string\r\n\tRiskScore        float64\r\n\tPortsScanned     []int\r\n\tTotalBytes       int64\r\n"]
[1848.69645, "o", "\tDestIPs          []string\r\n\tUser             string\r\n\tTimestamp        string\r\n\tPriorFailures    int\r\n\tCompromisedHosts []string\r\n\tQueryCount       int\r\n\tAvgPayload       float64\r\n\r\n\t"]
[1848.696541, "o", "firstTime time.Time\r\n\tlastTime  time.Time\r\n}\r\n\r\nfunc (t Threat) MarshalJSON() ([]byte, error) {\r\n\tswitch t.ThreatType {\r\n\tcase \"brute_force\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType  string   `json:\"threat_type\"`\r\n\t\t\tSourceIP    string   `json:\"source_ip\"`\r\n\t\t\tCount       int      `json:\"count\"`\r\n\t\t\tFirstSeen   string   `json:\"first_seen\"`\r\n\t\t\tLastSeen    string   `json:\"last_seen\"`\r\n\t\t\tTargetUsers []string `json:\"target_users\"`"]
[1848.696604, "o", "\r\n\t\t\tRiskScore   float64  `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType:  t.ThreatType,\r\n\t\t\tSourceIP:    t.SourceIP,\r\n\t\t\tCount:       t.Count,\r\n\t\t\tFirstSeen:   t.FirstSeen,\r\n\t\t\tLastSeen:    t.LastSeen,\r\n\t\t\tTargetUsers: nonNilStrings(t.TargetUsers),\r\n\t\t\tRiskScore:   t.RiskScore,\r\n\t"]
[1848.696687, "o", "\t})\r\n\tcase \"port_scan\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType   string  `json:\"threat_type\"`\r\n\t\t\tSourceIP     string  `json:\"source_ip\"`\r\n\t\t"]
[1848.696749, "o", "\tDestIP       string  `json:\"dest_ip\"`\r\n\t\t\tPortsScanned []int   `json:\"ports_scanned\"`\r\n\t\t\tFirstSeen    string  `json:\"first_seen\"`\r\n\t\t\tLastSeen     string  `json:\"last_seen\"`\r\n\t\t\tRiskScore    float64 `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType:   t.ThreatType,\r\n\t\t\tSourceIP:     t.SourceIP,\r\n\t\t\tDestIP:       t.DestIP,\r\n\t\t\tPortsScanned: nonNilInts(t.PortsScanned),\r\n\t\t\tFirstSeen:    t.FirstSeen,\r\n\t\t\tLastSeen:     t.LastSeen,\r\n\t\t\tRiskScore:    t.RiskScore,\r\n\t\t})\r\n\tcase \"data_exfiltration\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType string   `json:\"threat_type\"`\r\n"]
[1848.696808, "o", "\t\t\tSourceIP   string   `json:\"source_ip\"`\r\n\t\t\tTotalBytes int64    `json:\"total_bytes\"`\r\n\t\t\tFirstSeen  string   `json:\"first_seen\"`\r\n\t\t\tLastSeen   string   `json:\"last_seen\"`\r\n\t\t\tDestIPs    []string `json:\"dest_ips\"`\r\n\t\t\tRiskScore  float64  `json:\"risk_score\"`\r\n"]
[1848.696868, "o", "\t\t}{\r\n\t\t\tThreatType: t.ThreatType,\r\n\t\t\tSourceIP:   t.SourceIP,\r\n\t\t\tTotalBytes: t.TotalBytes,\r\n\t\t\tFirstSeen:  t.FirstSeen,\r\n\t\t\tLastSeen:   t.LastSeen,\r\n\t\t\tDestIPs:    nonNilStrings(t.DestIPs),\r\n\t\t\tRiskScore:  t.RiskScore,\r\n\t\t})\r\n\tcase \"privilege_escalation\":\r\n"]
[1848.696925, "o", "\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType    string  `json:\"threat_type\"`\r\n\t\t\tUser          string  `json:\"user\"`\r\n\t\t\tSourceIP      string  `json:\"source_ip\"`\r\n\t\t\tTimestamp     string  `json:\"timestamp\"`\r\n\t\t\tPriorFailures int     `json:\"prior_failures\"`\r\n\t\t\tRiskScore     float64 `json:\"risk_score\"`\r\n\t\t}{\r\n"]
[1848.696995, "o", "\t\t\tThreatType:    t.ThreatType,\r\n\t\t\tUser:          t.User,\r\n\t\t\tSourceIP:      t.SourceIP,\r\n\t\t\tTimestamp:     t.Timestamp,\r\n\t\t\tPriorFailures: t.PriorFailures,\r\n\t\t\tRiskScore:     t.RiskScore,\r\n\t\t})\r\n\tcase \"lateral_movement\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType       string   `json:\"threat_type\"`\r\n\t\t\tSourceIP         string   `json:\"source_ip\"`\r\n"]
[1848.697058, "o", "\t\t\tCompromisedHosts []string `json:\"compromised_hosts\"`\r\n\t\t\tFirstSeen        string   `json:\"first_seen\"`\r\n\t\t\tLastSeen         string   `json:\"last_seen\"`\r\n\t\t\tRiskScore        float64  `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType:       t.ThreatType,\r\n\t\t\tSourceIP:         t.SourceIP,\r\n\t\t\tCompromisedHosts: nonNilStrings(t.CompromisedHosts),\r\n\t\t\tFirstSeen:        t.FirstSeen,\r\n"]
[1848.697128, "o", "\t\t\tLastSeen:         t.LastSeen,\r\n\t\t\tRiskScore:        t.RiskScore,\r\n\t\t})\r\n\tcase \"dns_tunneling\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType string  `json:\"threat_type\"`\r\n\t\t\tSourceIP   string  `json:\"source_ip\"`\r\n\t\t\tQueryCount int     `json:\"query_count\"`\r\n\t\t\tAvgPayload float64 `json:\"avg_payload\"`\r\n\t\t\tFirstSeen  string  `json:\"first_seen\"`\r\n\t\t\tLastSeen   string  `json:\"last_seen\"`\r\n"]
[1848.697189, "o", "\t\t\tRiskScore  float64 `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType: t.ThreatType,\r\n\t\t\tSourceIP:   t.SourceIP,\r\n\t\t\tQueryCount: t.QueryCount,\r\n\t\t\tAvgPayload: t.AvgPayload,\r\n\t\t\tFirstSeen:  t.FirstSeen,\r\n"]
[1848.697284, "o", "\t\t\tLastSeen:   t.LastSeen,\r\n\t\t\tRiskScore:  t.RiskScore,\r\n\t\t})\r\n\t}\r\n\treturn json.Marshal(struct {\r\n\t\tThreatType string  `json:\"threat_type\"`\r\n\t\tRiskScore  float64 `json:\"risk_score\"`\r\n\t}{\r\n\t\tThreatType: t.ThreatType,\r\n\t\tRiskScore:  t.RiskScore,\r\n"]
[1848.697467, "o", "\t})\r\n}\r\n\r\nfunc nonNilStrings(s []string) []string {\r\n\tif s == nil {\r\n"]
[1848.697558, "o", "\t\treturn []string{}\r\n\t}\r\n\treturn s\r\n}\r\n\r\nfunc nonNilInts(s []int) []int {\r\n\tif s == nil {\r\n\t\treturn []int{}\r\n\t}\r\n\treturn s\r\n}\r\n\r\nfunc sortEvents(events []Event) {\r\n\tsort.SliceStable(events, func(i, j int) bool {\r\n\t\tti, errI := parseTime(events[i].Timestamp)\r\n\t\ttj, errJ := parseTime(events[j].Timestamp)\r\n\t\tif errI == nil && errJ == nil {\r\n\t\t\tif ti.Before(tj) {\r\n\t\t\t\treturn true\r\n\t\t\t}\r\n\t\t\tif tj.Before(ti) {\r\n\t\t\t\treturn false\r\n\t\t\t}\r\n\t\t\treturn events[i].Timestamp < events[j].Timestamp\r\n\t\t}\r\n\t\treturn events[i].Timestamp < events[j].Timestamp\r\n\t})\r\n}\r\n\r\nfunc eventTime(e Event) (time.Time, bool) {\r\n\tt, err := parseTime(e.Timestamp)\r\n\treturn t, err == nil\r\n}\r\n\r\nfunc detectThreats(events []Event) []Threat {\r\n\tsortEvents(events)\r\n\tvar threats []Threat\r\n\tthreats = append(threats, detectBruteForce(events)...)\r\n\tthreats = append(threats, detectPortScan(events)...)\r\n\tthreats = append(threats, detectDataExfiltration(events)...)\r\n\tthreats = append(threats, detectPrivilegeEscalation(events)...)\r\n\tthreats = append(threats, dete"]
[1848.69765, "o", "ctLateralMovement(events)...)\r\n\tthreats = append(threats, detectDNSTunneling(events)...)\r\n\tsortThreats(threats)\r\n\treturn threats\r\n}\r\n\r\nfunc sortThreats(threats []Threat) {\r\n\tsort.SliceStable(threats, func(i, j int) bool {\r\n\t\tif threats[i].RiskScore != threats[j].RiskScore {\r\n\t\t\treturn threats[i].RiskScore > threats[j].RiskScore\r\n\t\t}\r\n\t\tif !threats[i].firstTime.Equal(threats[j].firstTime) {\r\n\t\t\treturn threats[i].firstTime.Before(threats[j].firstTime)\r\n\t\t}\r\n\t\treturn threats[i].ThreatType < threats[j].ThreatType\r\n\t})\r\n}\r\n"]
[1848.697712, "o", "\r\nfunc detectBruteForce(events []Event) []Threat {\r\n\tbyIP := make(map[string][]Event)\r\n\tfor _, e := range events {\r\n\t\tif e.EventType == \"auth_failure\" {\r\n\t\t\tbyIP[e.SourceIP] = append(byIP[e.SourceIP], e)\r\n\t\t}\r\n\t}\r\n\r\n\tvar threats []Threat\r\n\tfor ip, evs := range byIP {\r\n"]
[1848.697773, "o", "\t\tfor i := 0; i < len(evs); i++ {\r\n\t\t\tstart, ok := eventTime(evs[i])\r\n\t\t\tif !ok {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvar window []Event\r\n\t\t\tfor j := i; j < len(evs); j++ {\r\n\t\t\t\tt, ok := eventTime(evs[j])\r\n\t\t\t\tif !ok {\r\n"]
[1848.69783, "o", "\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tif t.Sub(start) <= 60*time.Second {\r\n\t\t\t\t\twindow = append(window, evs[j])\r\n\t\t\t\t} else {\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif len(window) >= 5 {\r\n\t"]
[1848.697887, "o", "\t\t\tusers := make([]string, 0, len(window))\r\n\t\t\t\tfor _, e := range window {\r\n\t\t\t\t\tusers = append(users, e.User)\r\n\t\t\t\t}\r\n\t\t\t\tusers = uniqueSortedStrings(users)\r\n\t\t\t\trisk := float64(len(window)) * 5.0\r\n\t\t\t\tif len(users) > 3 {\r\n\t\t\t"]
[1848.697944, "o", "\t\trisk = float64(len(window)) * 10.0\r\n\t\t\t\t}\r\n\t\t\t\tlast, ok := eventTime(window[len(window)-1])\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\tlast = start\r\n\t\t\t\t}\r\n\t\t\t\tthreats = append(threats, Threat{\r\n\t\t\t\t\tThreatType:  \"brute_force\",\r\n"]
[1848.698005, "o", "\t\t\t\t\tSourceIP:    ip,\r\n\t\t\t\t\tCount:       len(window),\r\n\t\t\t\t\tFirstSeen:   window[0].Timestamp,\r\n\t\t\t\t\tLastSeen:    window[len(window)-1].Timestamp,\r\n\t\t\t\t\tTargetUsers: users,\r\n\t\t\t\t\tRiskScore:   risk,\r\n\t\t"]
[1848.698065, "o", "\t\t\tfirstTime:   start,\r\n\t\t\t\t\tlastTime:    last,\r\n\t\t\t\t})\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn threats\r\n}\r\n\r\n"]
[1848.698126, "o", "func detectPortScan(events []Event) []Threat {\r\n\tbyPair := make(map[string][]Event)\r\n\tfor _, e := range events {\r\n\t\tif e.EventType == \"connection\" || e.EventType == \"port_scan\" {\r\n\t\t\tkey := e.SourceIP + \"|\" + e.DestIP\r\n\t\t\tbyPair[key] = append(byPair[key], e)\r\n\t\t}\r\n\t}\r\n\r\n"]
[1848.698186, "o", "\tvar threats []Threat\r\n\tfor pair, evs := range byPair {\r\n\t\tparts := splitKey(pair)\r\n\t\tip := parts[0]\r\n\t\tdest := parts[1]\r\n\t\tfor i := 0; i < len(evs); i++ {\r\n\t\t\tstart, ok := eventTime(evs[i])\r\n\t\t\tif !ok {\r\n\t\t\t\tcontinue\r\n"]
[1848.698255, "o", "\t\t\t}\r\n\t\t\tvar window []Event\r\n\t\t\tfor j := i; j < len(evs); j++ {\r\n\t\t\t\tt, ok := eventTime(evs[j])\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n"]
[1848.698311, "o", "\t\t\t\tif t.Sub(start) <= 300*time.Second {\r\n\t\t\t\t\twindow = append(window, evs[j])\r\n\t\t\t\t} else {\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[1848.698373, "o", "\t\t\tports := make([]int, 0, len(window))\r\n\t\t\tfor _, e := range window {\r\n\t\t\t\tports = append(ports, e.DestPort)\r\n\t\t\t}\r\n\t\t\tports = uniqueSortedInts(ports)\r\n\t\t\tif len(ports) >= 10 {\r\n\t\t\t\trisk := float64(len(ports)) * 3.0\r\n\t\t\t\tif hasSensitivePort(ports) {\r\n\t\t\t\t\trisk += 20.0\r\n"]
[1848.698434, "o", "\t\t\t\t}\r\n\t\t\t\tlast, ok := eventTime(window[len(window)-1])\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\tlast = start\r\n\t\t\t\t}\r\n\t\t\t\tthreats = append(threats, Threat{\r\n\t\t\t\t\tThreatType:   \"port_scan\",\r\n\t\t\t\t\tSourceIP:     ip,\r\n\t\t\t"]
[1848.698492, "o", "\t\tDestIP:       dest,\r\n\t\t\t\t\tPortsScanned: ports,\r\n\t\t\t\t\tFirstSeen:    window[0].Timestamp,\r\n\t\t\t\t\tLastSeen:     window[len(window)-1].Timestamp,\r\n\t\t\t\t\tRiskScore:    risk,\r\n"]
[1848.698902, "o", "\u001b[?2004hroot@n30009:/app# "]
