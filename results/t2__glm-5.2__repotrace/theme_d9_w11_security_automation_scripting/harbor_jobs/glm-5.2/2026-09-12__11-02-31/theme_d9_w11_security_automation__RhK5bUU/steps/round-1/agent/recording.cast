[7690.136232, "o", "   203\t\t\t\treturn threats[i].firstTime.Before(threats[j].firstTime)\r\n   204\t\t\t}\r\n   205\t\t\treturn threats[i].ThreatType < threats[j].ThreatType\r\n   206\t\t})\r\n   207\t}\r\n   208\t\r\n   209\tfunc detectBruteForce(events []Event) []Threat {\r\n   210\t\tbyIP := make(map[string][]Event)\r\n   211\t\tfor _, e := range events {\r\n   212\t\t\tif e.EventType == \"auth_failure\" {\r\n   213"]
[7690.136295, "o", "\t\t\t\tbyIP[e.SourceIP] = append(byIP[e.SourceIP], e)\r\n   214\t\t\t}\r\n   215\t\t}\r\n   216\t\r\n   217\t\tvar threats []Threat\r\n   218\t\tfor ip, evs := range byIP {\r\n   219\t\t\tfor i := 0; i < len(evs); i++ {\r\n   220\t\t\t\tstart, ok := eventTime(evs[i])\r\n"]
