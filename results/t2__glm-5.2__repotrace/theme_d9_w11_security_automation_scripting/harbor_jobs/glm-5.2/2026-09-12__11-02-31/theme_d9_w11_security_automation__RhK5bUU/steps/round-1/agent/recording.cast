[4439.731533, "o", "{\"bucket_start\":\"2024-01-15T08:00:00Z\",\"bucket_end\":\"2024-01-15T08:30:00Z\",\"threat_count\":1,\"avg_risk\":50,\"max_risk\":50,\"min_risk\":50,\"risk_std_dev\":0,\"dominant_type\":\"brute_force\",\"type_distribution\":{\"brute_force\":1},\"unique_actors\":[\"APT-29\"],\"severity_histogram\":{\"critical\":0,\"high\":0,\"low\":1,\"medium\":0,\"none\":0},\"escalation_index\":0,\"risk_trend\":0,\"burst_score\":0,\"top_threats\":[{\"enriched_risk_score\":50,\"first_seen\":\"2024-01-15T08:00:00Z\",\"ioc_severity\":\"low\",\"threat_actors\":[\"APT-29\"],\"threat_type\":\"brute_force\",\"timestamp\":\"2024-01-15T08:00:00Z\"}]}\r\n{\"bucket_start\":\"2024-01-15T08:30:00Z\",\"bucket_end\":\"2024-01-15T09:00:00Z\",\"threat_count\":1,\"avg_risk\":100,\"max_risk\":100,\"min_risk\":100,\"risk_std_dev\":0,\"dominant_type\":\"port_scan\",\"type_distribution\":{\"port_scan\":1},\"unique_actors\":[\"Lazarus\"],\"severity_histogram\":{\"critical\":0,\"high\":0,\"low\":0,\"medium\":1,\"none\":0},\"escalation_index\":0,\"risk_trend\":0,\"burst_score\":0,\"top_threats\":[{\"enriched_risk_score\":100,\"first_seen\":\"2024-01-15T08:40:00Z\",\"ioc_severit"]
