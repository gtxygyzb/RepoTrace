[6062.302429, "o", "\tThreatType: t.ThreatType,\r\n    81\t\t\t\tSourceIP:   t.SourceIP,\r\n    82\t\t\t\tTotalBytes: t.TotalBytes,\r\n    83\t\t\t\tFirstSeen:  t.FirstSeen,\r\n    84\t\t\t\tLastSeen:   t.LastSeen,\r\n    85\t\t\t\tDestIPs:    nonNilStrings(t.DestIPs),\r\n    86\t\t\t\tRiskScore:  t.RiskScore,\r\n    87\t\t\t})\r\n    88\t\tcase \"privilege_escalation\":\r\n    89\t\t\treturn json.Marshal(struct {\r\n    90\t\t\t\tThreatType    string  `json:\"threat_type\"`\r\n"]
[6062.302473, "o", "    91\t\t\t\tUser          string  `json:\"user\"`\r\n    92\t\t\t\tSourceIP      string  `json:\"source_ip\"`\r\n    93\t\t\t\tTimestamp     string  `json:\"timestamp\"`\r\n    94\t\t\t\tPriorFailures int     `json:\"prior_failures\"`\r\n    95\t\t\t\tRiskScore     float64 `json:\"risk_score\"`\r\n    96\t\t\t}{\r\n"]
[6062.302558, "o", "    97\t\t\t\tThreatType:    t.ThreatType,\r\n    98\t\t\t\tUser:          t.User,\r\n    99\t\t\t\tSourceIP:      t.SourceIP,\r\n   100\t\t\t\tTimestamp:     t.Timestamp,\r\n   101\t\t\t\tPriorFailures: t.PriorFailures,\r\n   102\t\t\t\tRiskScore:     t.RiskScore,\r\n   103\t\t\t})\r\n   104\t\tcase \"lateral_movement\":\r\n   105\t\t\treturn json.Marshal(struct {\r\n   106\t\t\t\tThreatType       string   `json:\"threat_type\"`\r\n   107\t\t\t\tSourceIP         string   `json:\"source_ip\"`\r\n   108\t\t\t\tCompromisedHosts []string `json:\"compromised_hosts\"`\r\n   109\t\t\t\tFirstSeen        string   `json:\"first_seen\"`\r\n"]
