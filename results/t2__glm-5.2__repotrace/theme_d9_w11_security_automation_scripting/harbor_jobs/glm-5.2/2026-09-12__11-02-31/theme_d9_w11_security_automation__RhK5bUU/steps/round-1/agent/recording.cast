[7985.929728, "o", "\u001b[?2004h> "]
[7985.929805, "o", "        return 1\r\n\u001b[?2004l\r"]
[7985.929862, "o", "\u001b[?2004h>     }\r\n"]
[7985.929918, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[7985.930112, "o", "    refTime, err := parseTime(*refStr)\r\n\u001b[?2004l\r"]
[7985.93017, "o", "\u001b[?2004h> "]
[7985.930251, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[7985.930312, "o", "\u001b[?2004h> "]
[7985.930446, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r"]
[7985.93051, "o", "\u001b[?2004h> "]
[7985.930598, "o", "        return 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.930654, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.930717, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.930889, "o", "    scanner := bufio.NewScanner(os.Stdin)\r\n\u001b[?2004l\r"]
[7985.930972, "o", "\u001b[?2004h> "]
[7985.931192, "o", "    scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\u001b[?2004l\r"]
[7985.931266, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.931328, "o", "> "]
[7985.931428, "o", "    var results []prioritizeOutput\r\n\u001b[?2004l\r"]
[7985.931489, "o", "\u001b[?2004h> "]
[7985.931544, "o", "    lineNo := 0\r\n\u001b[?2004l\r"]
[7985.931604, "o", "\u001b[?2004h> "]
[7985.931684, "o", "    for scanner.Scan() {\r\n\u001b[?2004l\r"]
[7985.931744, "o", "\u001b[?2004h> "]
[7985.931797, "o", "        lineNo++\r\n\u001b[?2004l\r"]
[7985.931855, "o", "\u001b[?2004h> "]
[7985.931965, "o", "        line := scanner.Text()\r\n\u001b[?2004l\r"]
[7985.932025, "o", "\u001b[?2004h> "]
[7985.932105, "o", "        if line == \"\" {\r\n\u001b[?2004l\r"]
[7985.932165, "o", "\u001b[?2004h> "]
[7985.932252, "o", "            continue\r\n\u001b[?2004l\r"]
[7985.932309, "o", "\u001b[?2004h> "]
[7985.932364, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.932548, "o", "        var threat map[string]interface{}\r\n\u001b[?2004l\r"]
[7985.932611, "o", "\u001b[?2004h> "]
[7985.932875, "o", "        if err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n\u001b[?2004l\r"]
[7985.932934, "o", "\u001b[?2004h> "]
[7985.933182, "o", "            fmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n\u001b[?2004l\r"]
[7985.933253, "o", "\u001b[?2004h> "]
[7985.933323, "o", "            return 2\r\n\u001b[?2004l\r"]
[7985.933378, "o", "\u001b[?2004h> "]
[7985.933433, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.933667, "o", "        out, ok := prioritizeThreat(threat, refTime)\r\n\u001b[?2004l\r"]
[7985.933722, "o", "\u001b[?2004h> "]
[7985.93378, "o", "        if !ok {\r\n\u001b[?2004l\r"]
[7985.933834, "o", "\u001b[?2004h> "]
[7985.933909, "o", "            continue\r\n\u001b[?2004l\r"]
[7985.933964, "o", "\u001b[?2004h> "]
[7985.934024, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.934194, "o", "        results = append(results, out)\r\n\u001b[?2004l\r"]
[7985.934264, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[7985.934329, "o", "\u001b[?2004h> "]
[7985.934496, "o", "    if err := scanner.Err(); err != nil {\r\n\u001b[?2004l\r"]
[7985.934551, "o", "\u001b[?2004h> "]
[7985.934689, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r"]
[7985.934743, "o", "\u001b[?2004h> "]
[7985.934803, "o", "        return 1\r\n\u001b[?2004l\r"]
[7985.934862, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[7985.934917, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7985.934972, "o", "\u001b[?2004h> "]
[7985.935165, "o", "    sort.SliceStable(results, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[7985.935253, "o", "\u001b[?2004h> "]
[7985.935493, "o", "        if results[i].PriorityScore != results[j].PriorityScore {\r\n\u001b[?2004l\r"]
[7985.935549, "o", "\u001b[?2004h> "]
[7985.935822, "o", "            return results[i].PriorityScore > results[j].PriorityScore\r\n\u001b[?2004l\r"]
[7985.935878, "o", "\u001b[?2004h> "]
[7985.935932, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.93618, "o", "        return results[i].SourceIP < results[j].SourceIP\r\n\u001b[?2004l\r"]
[7985.936253, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
[7985.936314, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7985.936368, "o", "\u001b[?2004h> "]
[7985.936522, "o", "    writer := bufio.NewWriter(os.Stdout)\r\n\u001b[?2004l\r"]
[7985.936577, "o", "\u001b[?2004h> "]
[7985.936665, "o", "    defer writer.Flush()\r\n\u001b[?2004l\r"]
[7985.93672, "o", "\u001b[?2004h> "]
[7985.936838, "o", "    for _, r := range results {\r\n\u001b[?2004l\r"]
[7985.936897, "o", "\u001b[?2004h> "]
[7985.93702, "o", "        b, err := json.Marshal(r)\r\n\u001b[?2004l\r"]
[7985.937074, "o", "\u001b[?2004h> "]
[7985.937165, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[7985.937233, "o", "\u001b[?2004h> "]
[7985.937517, "o", "            fmt.Fprintf(os.Stderr, \"failed to encode output: %v\\n\", err)\r\n\u001b[?2004l\r"]
[7985.937573, "o", "\u001b[?2004h> "]
[7985.937645, "o", "            return 1\r\n\u001b[?2004l\r"]
[7985.9377, "o", "\u001b[?2004h> "]
[7985.93776, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.937935, "o", "        fmt.Fprintln(writer, string(b))\r\n\u001b[?2004l\r"]
[7985.937993, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[7985.938061, "o", "\u001b[?2004h> "]
[7985.93812, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.938174, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.938246, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.938569, "o", "func prioritizeThreat(threat map[string]interface{}, refTime time.Time) (prioritizeOutput, bool) {\r\n\u001b[?2004l\r"]
[7985.938625, "o", "\u001b[?2004h> "]
[7985.938755, "o", "    sourceIP := getStringDefault(threat, \"source_ip\")\r\n\u001b[?2004l\r"]
[7985.93881, "o", "\u001b[?2004h> "]
[7985.938952, "o", "    threatType := getStringDefault(threat, \"threat_type\")\r\n\u001b[?2004l\r"]
[7985.939012, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.939135, "o", "    eventTime := threatReferenceTime(threat)\r\n\u001b[?2004l\r"]
[7985.939189, "o", "\u001b[?2004h> "]
[7985.939263, "o", "    refStr := \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.939318, "o", "> "]
[7985.939498, "o", "    if tt, ok := getString(threat, \"threat_type\"); ok && tt == \"privilege_escalation\" {\r\n\u001b[?2004l\r"]
[7985.939554, "o", "\u001b[?2004h> "]
[7985.939691, "o", "        if ts, ok := getString(threat, \"timestamp\"); ok {\r\n\u001b[?2004l\r"]
[7985.939746, "o", "\u001b[?2004h> "]
[7985.939802, "o", "            refStr = ts\r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.939858, "o", ">         }\r\n\u001b[?2004l\r"]
[7985.939918, "o", "\u001b[?2004h>     } else {\r\n\u001b[?2004l\r"]
[7985.939978, "o", "\u001b[?2004h> "]
[7985.940117, "o", "        if ts, ok := getString(threat, \"first_seen\"); ok {\r\n\u001b[?2004l\r"]
[7985.940171, "o", "\u001b[?2004h> "]
[7985.940245, "o", "            refStr = ts\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.940301, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.940356, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7985.940414, "o", "\u001b[?2004h> "]
[7985.940478, "o", "    ageMinutes := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.940567, "o", "    if !eventTime.IsZero() {\r\n\u001b[?2004l\r"]
[7985.940624, "o", "\u001b[?2004h> "]
[7985.940748, "o", "        ageMinutes = refTime.Sub(eventTime).Minutes()\r\n\u001b[?2004l\r"]
[7985.940803, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.940857, "o", "> "]
[7985.940906, "o", "    if ageMinutes < 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.940977, "o", ">         ageMinutes = 0\r\n\u001b[?2004l\r"]
[7985.941032, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[7985.941086, "o", "\u001b[?2004h> "]
[7985.941196, "o", "    recency := math.Pow(2, -ageMinutes/60.0)\r\n\u001b[?2004l\r"]
[7985.941295, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.94138, "o", "> "]
[7985.941458, "o", "    riskScore, _ := getFloat(threat, \"enriched_risk_score\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.94154, "o", "    risk := riskScore / 500.0\r\n\u001b[?2004l\r"]
[7985.941618, "o", "\u001b[?2004h> "]
[7985.941696, "o", "    if risk > 1.0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.941773, "o", "        risk = 1.0\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.941846, "o", "    if risk < 0 {\r\n\u001b[?2004l\r"]
[7985.941922, "o", "\u001b[?2004h>         risk = 0\r\n\u001b[?2004l\r"]
[7985.941998, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7985.942075, "o", "\u001b[?2004h> "]
[7985.94215, "o", "    confidence := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.942298, "o", "    if c, ok := getFloat(threat, \"max_ioc_confidence\"); ok {\r\n\u001b[?2004l\r"]
[7985.942362, "o", "\u001b[?2004h> "]
[7985.942417, "o", "        confidence = c\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.942471, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.942536, "o", "    if confidence < 0 {\r\n\u001b[?2004l\r"]
[7985.942591, "o", "\u001b[?2004h> "]
[7985.942655, "o", "        confidence = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.94271, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.942779, "o", "    if confidence > 1 {\r\n\u001b[?2004l\r"]
[7985.942834, "o", "\u001b[?2004h> "]
[7985.942894, "o", "        confidence = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.942955, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.943009, "o", "> "]
[7985.943072, "o", "    actors := []string{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.943259, "o", "    if a, ok := getStringSlice(threat, \"threat_actors\"); ok {\r\n\u001b[?2004l\r"]
[7985.943316, "o", "\u001b[?2004h> "]
[7985.94337, "o", "        actors = a\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.943425, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.943531, "o", "    actor := float64(len(actors)) / 3.0\r\n\u001b[?2004l\r"]
[7985.943585, "o", "\u001b[?2004h> "]
[7985.94364, "o", "    if actor > 1.0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.94371, "o", "        actor = 1.0\r\n\u001b[?2004l\r"]
[7985.943766, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.943823, "o", ">     if actor < 0 {\r\n"]
[7985.943877, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[7985.943943, "o", "        actor = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.943999, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7985.944054, "o", "\u001b[?2004h> "]
[7985.944188, "o", "    severity := getStringDefault(threat, \"ioc_severity\")\r\n\u001b[?2004l\r"]
[7985.94425, "o", "\u001b[?2004h> "]
[7985.944366, "o", "    severityRank := prioritySeverityRanks[severity]\r\n\u001b[?2004l\r"]
[7985.944421, "o", "\u001b[?2004h> "]
[7985.944547, "o", "    severityComponent := float64(severityRank) / 4.0\r\n\u001b[?2004l\r"]
[7985.944569, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7985.944591, "o", "\u001b[?2004h> "]
[7985.944726, "o", "    score := wSeverity*severityComponent +\r\n\u001b[?2004l\r"]
[7985.944747, "o", "\u001b[?2004h> "]
[7985.944835, "o", "        wRecency*recency +\r\n\u001b[?2004l\r"]
[7985.944854, "o", "\u001b[?2004h> "]
[7985.944927, "o", "        wRisk*risk +\r\n\u001b[?2004l\r"]
[7985.944948, "o", "\u001b[?2004h> "]
[7985.945049, "o", "        wConfidence*confidence +\r\n\u001b[?2004l\r"]
[7985.94507, "o", "\u001b[?2004h> "]
[7985.995913, "o", "        wActor*actor\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     label := priorityLabel(score)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return prioritizeOutput{\r\n\u001b[?2004l\r\u001b[?2004h>         SourceIP:      sourceIP,\r\n\u001b[?2004l\r\u001b[?2004h>         ThreatType:    threatType,\r\n\u001b[?2004l\r\u001b[?2004h>         PriorityScore: round4(score),\r\n\u001b[?2004l\r\u001b[?2004h>         PriorityLabel: label,\r\n\u001b[?2004l\r\u001b[?2004h>         Components: priorityComponents{\r\n\u001b[?2004l\r\u001b[?2004h>             Severity:   round4(severityComponent),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7985.996084, "o", "            Recency:    round4(recency),\r\n\u001b[?2004l\r"]
[7985.996143, "o", "\u001b[?2004h> "]
[7985.996371, "o", "            Risk:       round4(risk),\r\n\u001b[?2004l\r"]
[7985.996436, "o", "\u001b[?2004h> "]
[7985.996681, "o", "            Confidence: round4(confidence),\r\n\u001b[?2004l\r"]
[7985.996737, "o", "\u001b[?2004h> "]
[7985.996957, "o", "            Actor:      round4(actor),\r\n\u001b[?2004l\r"]
[7985.997013, "o", "\u001b[?2004h> "]
[7985.99708, "o", "        },\r\n\u001b[?2004l\r"]
[7985.997137, "o", "\u001b[?2004h> "]
[7985.997362, "o", "        EnrichedRiskScore: riskScore,\r\n\u001b[?2004l\r"]
[7985.997421, "o", "\u001b[?2004h> "]
[7985.997628, "o", "        IOCSeverity:       severity,\r\n\u001b[?2004l\r"]
[7985.997685, "o", "\u001b[?2004h> "]
[7985.997881, "o", "        ThreatActors:      actors,\r\n\u001b[?2004l\r"]
[7985.997946, "o", "\u001b[?2004h> "]
[7985.998142, "o", "        ReferenceTime:     refStr,\r\n\u001b[?2004l\r"]
[7985.998198, "o", "\u001b[?2004h> "]
[7985.998287, "o", "    }, true\r\n\u001b[?2004l\r"]
[7985.998346, "o", "\u001b[?2004h> }\r\n"]
[7985.998404, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[7985.99846, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[7985.998518, "o", "> "]
[7985.998719, "o", "func priorityLabel(score float64) string {\r\n\u001b[?2004l\r"]
[7985.998768, "o", "\u001b[?2004h> "]
[7985.998856, "o", "    switch {\r\n\u001b[?2004l\r"]
[7985.998911, "o", "\u001b[?2004h> "]
[7985.99905, "o", "    case score >= 0.75:\r\n\u001b[?2004l\r"]
[7985.99911, "o", "\u001b[?2004h> "]
[7985.999268, "o", "        return \"critical\"\r\n\u001b[?2004l\r"]
[7985.9993, "o", "\u001b[?2004h"]
[7985.999375, "o", "> "]
[7985.999461, "o", "    case score >= 0.50:\r\n\u001b[?2004l\r"]
[7985.999517, "o", "\u001b[?2004h> "]
[7985.999645, "o", "        return \"high\"\r\n\u001b[?2004l\r"]
[7985.999699, "o", "\u001b[?2004h> "]
[7985.999838, "o", "    case score >= 0.25:\r\n\u001b[?2004l\r"]
[7985.999893, "o", "\u001b[?2004h> "]
[7986.000033, "o", "        return \"medium\"\r\n\u001b[?2004l\r"]
[7986.000088, "o", "\u001b[?2004h> "]
[7986.000171, "o", "    default:\r\n\u001b[?2004l\r"]
[7986.000236, "o", "\u001b[?2004h> "]
[7986.00036, "o", "        return \"low\"\r\n\u001b[?2004l\r"]
[7986.000417, "o", "\u001b[?2004h> "]
[7986.000474, "o", "    }\r\n\u001b[?2004l\r"]
[7986.000529, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[7986.000589, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7986.000644, "o", "\u001b[?2004h> "]
[7986.000835, "o", "func round4(f float64) float64 {\r\n\u001b[?2004l\r"]
[7986.00089, "o", "\u001b[?2004h> "]
[7986.001117, "o", "    return math.Round(f*10000) / 10000\r\n\u001b[?2004l\r"]
