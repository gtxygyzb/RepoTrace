[7260.481688, "o", "sed -n '1,260p' timeline.go\r\n\u001b[?2004l\r"]
[7260.484564, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n"]
[7260.484633, "o", "\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\ntype timelineBucket struct {\r\n\tBucketStart       string                   `json:\"bucket_start\"`\r\n\tBucketEnd         string                   `json:\"bucket_end\"`\r\n\tThreatCount       int                      `json:\"threat_count\"`\r\n\tAvgRisk           float64                  `json:\"avg_risk\"`\r\n\tMaxRisk           float64                  `json:\"max_risk\"`\r\n\t"]
[7260.484708, "o", "MinRisk           float64                  `json:\"min_risk\"`\r\n\tRiskStdDev        float64                  `json:\"risk_std_dev\"`\r\n\tDominantType      string                   `json:\"dominant_type\"`\r\n\tTypeDistribution  map[string]int           `json:\"type_distribution\"`\r\n\tUniqueActors      []string                 `json:\"unique_actors\"`\r\n\tSeverityHistogram map[string]int           `json:\"severity_histogram\"`\r\n\tEscalationIndex   float64                  `json:\"escalation_index\"`\r\n\tRiskTrend         float64                  `json:\"risk_trend\"`\r\n\tBurstScore        float64                  `json:\"burst_score\"`\r\n\tTopThreats        []map[string]interface{} `json:\"top_threats\"`\r\n}\r\n\r\nfunc runTimeline(args []string) int {\r\n"]
[7260.484772, "o", "\tfs := newFlagSet(\"timeline\")\r\n\tbucketMinutes := fs.Int(\"bucket-minutes\", 0, \"width of each time bucket in minutes\")\r\n\ttopN := fs.Int(\"top-n\", 3, \"maximum number of top threats to include per bucket\")\r\n\tif !parseFlags(fs, args) {\r\n\t\treturn 1\r\n\t}\r\n\tif !isFlagSet(fs, \"bucket-minutes\") {\r\n\t\tfmt.Fprintln(os.Stderr, \"missing required flag: --bucket-minutes\")\r\n\t\treturn 1\r\n\t}\r\n"]
[7260.484833, "o", "\tif *bucketMinutes <= 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid --bucket-minutes: must be a positive integer\\n\")\r\n\t\treturn 1\r\n\t}\r\n\tif *topN < 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid --top-n: must be non-negative\\n\")\r\n\t\treturn 1\r\n\t}\r\n\r\n"]
[7260.484896, "o", "\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\tlineNo := 0\r\n\tvar threats []map[string]interface{}\r\n\tfor scanner.Scan() {\r\n\t\tlineNo++\r\n\t\tline := scanner.Text()\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n"]
[7260.484956, "o", "\t\t}\r\n\t\tvar threat map[string]interface{}\r\n\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tthreats = append(threats, threat)\r\n\t}\r\n"]
[7260.485027, "o", "\tif err := scanner.Err(); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tbucketSeconds := int64(*bucketMinutes) * 60\r\n\tbuckets := make(map[int64][]map[string]interface{})\r\n\tvar bucketStarts []int64\r\n\tfor _, threat := range threats {\r\n\t\trefTime := threatSortTime(threat)\r\n\t\tvar refUnix int64\r\n\t"]
[7260.485098, "o", "\tif !refTime.IsZero() {\r\n\t\t\trefUnix = refTime.Unix()\r\n\t\t}\r\n\t\tstart := refUnix - ((refUnix%bucketSeconds)+bucketSeconds)%bucketSeconds\r\n\t\tif _, ok := buckets[start]; !ok {\r\n\t\t\tbucketStarts = append(bucketStarts, start)\r\n\t\t}\r\n\t\tbuckets[start] = append(buckets[start], threat)\r\n\t}\r\n\r\n\t"]
[7260.485166, "o", "sort.Slice(bucketStarts, func(i, j int) bool { return bucketStarts[i] < bucketStarts[j] })\r\n\r\n\twriter := bufio.NewWriter(os.Stdout)\r\n\tdefer writer.Flush()\r\n\r\n\tfor _, start := range bucketStarts {\r\n\t\tbucketThreats := buckets[start]\r\n\t\tstartTime := time.Unix(start, 0).UTC()\r\n\t\tendTime := startTime.Add(time.Duration(*bucketMinutes) * time.Minute)\r\n\t\tb := buildTimelineBucket(bucketThreats, startTime, endTime, *bucketMinutes, *topN)\r\n\t\tdata, err := json.Marshal(b)\r\n\t"]
[7260.485288, "o", "\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error marshalling bucket: %v\\n\", err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\twriter.Write(data)\r\n\t\twriter.WriteByte('\\n')\r\n\t}\r\n\r\n\treturn 0\r\n}\r\n\r\nfunc buildTimelineBucket(threats []map[string]interface{}, startTime time.Time, endTime time.Time, bucketMinutes int, topN int) timelineBucket {\r\n\tn := len(threats)\r\n\tb := timelineBucket{\r\n\t\tBucketStart:       startTime.Format(time.RFC3339),\r\n\t\tBucketEnd:         endTime.Format(time.RFC3339),\r\n"]
[7260.48536, "o", "\t\tThreatCount:       n,\r\n\t\tTypeDistribution:  map[string]int{},\r\n\t\tSeverityHistogram: map[string]int{\"none\": 0, \"low\": 0, \"medium\": 0, \"high\": 0, \"critical\": 0},\r\n\t\tUniqueActors:      []string{},\r\n\t\tTopThreats:        []map[string]interface{}{},\r\n\t}\r\n\r\n\tif n == 0 {\r\n\t\treturn b\r\n\t}\r\n\r\n\tvar sumRisk, maxRisk, minRisk float64\r\n\ttypeCounts := map[string]int{}\r\n\t"]
[7260.485488, "o", "actorSet := map[string]bool{}\r\n\trisks := make([]float64, 0, n)\r\n\tfor i, threat := range threats {\r\n\t\trisk, _ := getFloat(threat, \"enriched_risk_score\")\r\n\t\trisks = append(risks, risk)\r\n\t"]
[7260.485557, "o", "\tsumRisk += risk\r\n\t\tif i == 0 {\r\n\t\t\tmaxRisk = risk\r\n\t\t\tminRisk = risk\r\n\t\t} else {\r\n\t\t\tif risk > maxRisk {\r\n\t\t\t\tmaxRisk = risk\r\n\t\t\t}\r\n\t\t\tif risk < minRisk {\r\n\t\t\t\tminRisk = risk\r\n\t\t\t}\r\n\t\t}\r\n\t\tif tt, ok := getString(threat, \"threat_type\"); ok {\r\n\t\t\ttypeCounts[tt]++\r\n\t\t}\r\n\t\tif sev, ok := getString(threat, \"ioc_severity\"); ok {\r\n\t\t\tif _, exists := b.SeverityHistogram[sev]; exists {\r\n\t\t\t\tb.SeverityHistogram[sev]++\r\n\t\t\t}\r\n\t\t}\r\n\t\tif actors, ok := getStringSlice(threat, \"threat_actors\"); ok {\r\n\t\t\tfor _, actor := range actors {\r\n\t\t\t\tif actor != \"\" {\r\n"]
[7260.485623, "o", "\t\t\t\t\tactorSet[actor] = true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tb.AvgRisk = round2(sumRisk / float64(n))\r\n\tb.MaxRisk = maxRisk\r\n\tb.MinRisk = minRisk\r\n\r\n\tmean := sumRisk / float64(n)\r\n"]
[7260.485681, "o", "\tvar variance float64\r\n\tfor _, risk := range risks {\r\n\t\tdiff := risk - mean\r\n\t\tvariance += diff * diff\r\n\t}\r\n\tif n == 1 {\r\n\t\tvariance = 0.0\r\n\t} else {\r\n\t\tvariance /= float64(n)\r\n\t}"]
[7260.485744, "o", "\r\n\tb.RiskStdDev = round2(math.Sqrt(variance))\r\n\r\n\tb.DominantType = dominantThreatType(threats, typeCounts)\r\n\tb.TypeDistribution = typeCounts\r\n\r\n\tb.UniqueActors = nonNilStrings(sortedUniqueStringsFromSet(actorSet))\r\n\r\n\tb.EscalationIndex = round3(timelineEscalationIndex(threats))\r\n\tb.RiskTrend = round3(timelineRiskTrend(threats, startTime))\r\n\tb.BurstScore = round3(timelineBurstScore(threats))\r\n\r\n"]
[7260.485804, "o", "\tsortedTop := make([]map[string]interface{}, len(threats))\r\n\tcopy(sortedTop, threats)\r\n\tsort.SliceStable(sortedTop, func(i, j int) bool {\r\n\t\tri, _ := getFloat(sortedTop[i], \"enriched_risk_score\")\r\n\t\trj, _ := getFloat(sortedTop[j], \"enriched_risk_score\")\r\n\t\tif ri != rj {\r\n\t\t\treturn ri > rj\r\n"]
[7260.485874, "o", "\t\t}\r\n\t\tti, tj := threatSortTime(sortedTop[i]), threatSortTime(sortedTop[j])\r\n\t\tif !ti.Equal(tj) {\r\n\t\t\treturn ti.Before(tj)\r\n\t\t}\r\n\t\ttta, _ := getString(sortedTop[i], \"threat_type\")\r\n\t\tttb, _ := getString(sortedTop[j], \"threat_type\")\r\n\t\treturn tta < ttb\r\n\t})\r\n\tif topN < len(sortedTop) {\r\n\t\tsortedTop = sortedTop[:topN]\r\n\t}\r\n"]
[7260.485935, "o", "\tb.TopThreats = sortedTop\r\n\r\n\treturn b\r\n}\r\n\r\nfunc dominantThreatType(threats []map[string]interface{}, counts map[string]int) string {\r\n\tvar keys []string\r\n\tfor k := range counts {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n\tsort.Strings(keys)"]
[7260.485995, "o", "\r\n\r\n\tsumRisk := make(map[string]float64)\r\n\ttypeNum := make(map[string]int)\r\n\tfor _, threat := range threats {\r\n\t\ttt, ok := getString(threat, \"threat_type\")\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n"]
[7260.486058, "o", "\t\t}\r\n\t\trisk, _ := getFloat(threat, \"enriched_risk_score\")\r\n\t\tsumRisk[tt] += risk\r\n\t\ttypeNum[tt]++\r\n\t}\r\n\tmeanRisk := make(map[string]float64)\r\n\tfor k, sum := range sumRisk {\r\n\t\tif c := typeNum[k]; c > 0 {\r\n\t\t\tmeanRisk[k] = sum / float64(c)\r\n\t\t}\r\n\t}\r\n\r\n"]
[7260.486119, "o", "\tdominant := \"\"\r\n\tmaxCount := -1\r\n\tmaxMean := 0.0\r\n\tfor _, k := range keys {\r\n\t\tc := counts[k]\r\n\t\tmean := meanRisk[k]\r\n\t\tif dominant == \"\" || c > maxCount || (c == maxCount && mean > maxMean) {\r\n\t\t\tmaxCount = c\r\n\t\t\tmaxMean = mean\r\n\t\t"]
[7260.486182, "o", "\tdominant = k\r\n\t\t}\r\n\t}\r\n\treturn dominant\r\n}\r\n\r\nfunc timelineSeverityRank(sev string) int {\r\n\tswitch sev {\r\n\tcase \"none\":\r\n\t\treturn 0\r\n\tcase \"low\":\r\n\t\treturn 1"]
[7260.486238, "o", "\r\n\tcase \"medium\":\r\n\t\treturn 2\r\n\tcase \"high\":\r\n"]
[7260.486738, "o", "\u001b[?2004h"]
[7260.486796, "o", "root@n30009:/app# "]
[7260.749138, "i", "sed -n '1,260p' snapshot.go\n"]
[7260.749446, "o", "sed -n '1,260p' snapshot.go\r\n\u001b[?2004l\r"]
[7260.752287, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n"]
[7260.752354, "o", "\t\"fmt\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\ntype snapshotReport struct {\r\n\tTotalThreats       int            `json:\"total_threats\"`\r\n\tUniqueSources      int            `json:\"unique_sources\"`\r\n\tActiveCampaigns    int            `json:\"active_campaigns\"`\r\n\tMaxCampaignSize    int            `json:\"max_campaign_size\"`\r\n\tRiskCategory       string         `json:\"risk_category\"`\r\n"]
[7260.752416, "o", "\tMeanEnrichedRisk   float64        `json:\"mean_enriched_risk\"`\r\n\tPeakBucketAvg      float64        `json:\"peak_bucket_avg\"`\r\n\tPeakBucketStart    string         `json:\"peak_bucket_start\"`\r\n\tDominantThreatType string         `json:\"dominant_threat_type\"`\r\n\tTopActor           string         `json:\"top_actor\"`\r\n\tActorThreatCounts  map[string]int `json:\"actor_threat_counts\"`\r\n}\r\n\r\nfunc runSnapshot(args []string) int {\r\n"]
[7260.752482, "o", "\tfs := newFlagSet(\"snapshot\")\r\n\tcampaignWindow := fs.Int(\"campaign-window\", 60, \"time window in minutes for campaign detection\")\r\n\tbucketMinutes := fs.Int(\"bucket-minutes\", 60, \"bucket width in minutes for internal timeline analysis\")\r\n\tif !parseFlags(fs, args) {\r\n\t\treturn 1\r\n\t}\r\n\tif *campaignWindow < 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid --campaign-window: must be non-negative\\n\")\r\n\t\treturn 1\r\n"]
[7260.752542, "o", "\t}\r\n\tif *bucketMinutes <= 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid --bucket-minutes: must be a positive integer\\n\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\tvar threats []map[string]interface{}\r\n\tlineNo := 0"]
[7260.752601, "o", "\r\n\tfor scanner.Scan() {\r\n\t\tlineNo++\r\n\t\tline := scanner.Text()\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvar threat map[string]interface{}\r\n"]
[7260.752667, "o", "\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tthreats = append(threats, threat)\r\n\t}\r\n\tif err := scanner.Err(); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\treport := buildSnapshot(threats, *campaignWindow, *bucketMinutes)\r\n"]
[7260.752728, "o", "\tdata, err := json.Marshal(report)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error marshalling report: %v\\n\", err)\r\n\t\treturn 2\r\n\t}\r\n\tfmt.Println(string(data))\r\n\treturn 0\r\n}\r\n\r\nfunc buildSnapshot(threats []map[string]interface{}, campaignWindow int, bucketMinutes int) snapshotReport {\r\n"]
[7260.752791, "o", "\treport := snapshotReport{\r\n\t\tActorThreatCounts: map[string]int{},\r\n\t\tRiskCategory:      \"low\",\r\n\t}\r\n\tif len(threats) == 0 {\r\n\t\treturn report\r\n"]
[7260.752857, "o", "\t}\r\n\r\n\treport.TotalThreats = len(threats)\r\n\r\n\tsourceSet := map[string]bool{}\r\n\tfor _, t := range threats {\r\n\t\tif ip, ok := getString(t, \"source_ip\"); ok && ip != \"\" {\r\n\t\t\tsourceSet[ip] = true\r\n\t\t}\r\n\t}\r\n\treport.UniqueSources = len(sourceSet)\r\n\r\n\tvar sumRisk float64\r\n\tfor _, t := range threats {\r\n\t\trisk, _ := getFloat(t, \"enriched_risk_score\")\r\n\t\tsumRisk += risk\r\n"]
[7260.752922, "o", "\t}\r\n\tmeanRisk := sumRisk / float64(len(threats))\r\n\treport.MeanEnrichedRisk = round2(meanRisk)\r\n\treport.RiskCategory = snapshotRiskCategory(meanRisk)\r\n\r\n\tbucketSeconds := int64(bucketMinutes) * 60\r\n\tbuckets := make(map[int64][]map[string]interface{})\r\n\tfor _, threat := range threats {\r\n\t\trefTime := threatSortTime(threat)\r\n\t\tvar refUnix int64\r\n"]
[7260.752985, "o", "\t\tif !refTime.IsZero() {\r\n\t\t\trefUnix = refTime.Unix()\r\n\t\t}\r\n\t\tstart := refUnix - ((refUnix%bucketSeconds)+bucketSeconds)%bucketSeconds\r\n\t\tbuckets[start] = append(buckets[start], threat)\r\n\t"]
[7260.753048, "o", "}\r\n\r\n\tpeakAvg := 0.0\r\n\tpeakStart := \"\"\r\n\tfirst := true\r\n\tvar starts []int64\r\n\tfor s := range buckets {\r\n\t\tstarts = append(starts, s)\r\n\t}\r\n\tsort.Slice(starts, func(i, j int) bool { return starts[i] < starts[j] })\r\n\tfor _, start := range starts {\r\n\t\tbucketThreats := buckets[start]\r\n\t\tvar sum float64\r\n\t\tfor _, t := range bucketThreats {\r\n\t\t\t"]
[7260.753109, "o", "risk, _ := getFloat(t, \"enriched_risk_score\")\r\n\t\t\tsum += risk\r\n\t\t}\r\n\t\tavg := sum / float64(len(bucketThreats))\r\n\t\tif first || avg > peakAvg {\r\n\t\t\tfirst = false\r\n\t\t\tpeakAvg = avg\r\n\t\t\tpeakStart = time.Unix(start, 0).UTC().Format(time.RFC3339)\r\n\t\t}\r\n"]
[7260.753175, "o", "\t}\r\n\treport.PeakBucketAvg = round2(peakAvg)\r\n\treport.PeakBucketStart = peakStart\r\n\r\n\ttypeCounts := map[string]int{}\r\n\tfor _, t := range threats {\r\n\t\tif tt, ok := getString(t, \"threat_type\"); ok && tt != \"\" {\r\n"]
[7260.753249, "o", "\t\t\ttypeCounts[tt]++\r\n\t\t}\r\n\t}\r\n\treport.DominantThreatType = dominantThreatType(threats, typeCounts)\r\n\r\n\tactorCounts := map[string]int{}\r\n\tfor _, t := range threats {\r\n\t\tif actors, ok := getStringSlice(t, \"threat_actors\"); ok {\r\n\t\t\tseen := map[string]bool{}\r\n\t\t\tfor _, actor := range actors {\r\n"]
[7260.75329, "o", "\t\t\t\tif actor != \"\" && !seen[actor] {\r\n\t\t\t\t\tseen[actor] = true\r\n\t\t\t\t\tactorCounts[actor]++\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treport.ActorThreatCounts = actorCounts\r\n\r\n"]
[7260.753372, "o", "\tvar actors []string\r\n\tfor a := range actorCounts {\r\n\t\tactors = append(actors, a)\r\n\t}\r\n\tsort.Strings(actors)\r\n\ttopActor := \"\"\r\n\tmaxActorCount := 0\r\n\tfor _, a := range actors {\r\n\t\tif actorCounts[a] > maxActorCount {\r\n\t\t\tmaxActorCount = actorCounts[a]\r\n\t\t\ttopActor = a\r\n\t\t}\r\n\t}"]
[7260.753437, "o", "\r\n\treport.TopActor = topActor\r\n\r\n\ttype snapThreat struct {\r\n\t\tref    time.Time\r\n\t\tactors []string\r\n"]
[7260.753502, "o", "\t}\r\n\tcampaignThreats := make([]snapThreat, len(threats))\r\n\tfor i, t := range threats {\r\n\t\tct := snapThreat{\r\n\t\t\tref: threatReferenceTime(t),\r\n\t\t}\r\n\t\tif actors, ok := getStringSlice(t, \"threat_actors\"); ok {\r\n\t\t\tct.actors = actors\r\n\t\t} else {\r\n"]
[7260.753565, "o", "\t\t\tct.actors = []string{}\r\n\t\t}\r\n\t\tcampaignThreats[i] = ct\r\n\t}\r\n\r\n\twindow := time.Duration(campaignWindow) * time.Minute\r\n\tn := len(campaignThreats)\r\n\tlinked := make([][]bool, n)\r\n\tfor i := range linked {\r\n\t\tlinked[i] = make([]bool, n)\r\n\t}\r\n"]
[7260.753629, "o", "\tfor i := 0; i < n; i++ {\r\n\t\tif len(campaignThreats[i].actors) == 0 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfor j := i + 1; j < n; j++ {\r\n\t\t\tif len(campaignThreats[j].actors) == 0 {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
[7260.753693, "o", "\t\t\tif absDuration(campaignThreats[i].ref.Sub(campaignThreats[j].ref)) <= window && sharedActorCount(campaignThreats[i].actors, campaignThreats[j].actors) > 0 {\r\n\t\t\t\tlinked[i][j] = true\r\n\t\t\t\tlinked[j][i] = true\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tvisited := make([]bool, n)\r\n\tmaxCampaignSize := 0\r\n\tcampaignCount := 0\r\n"]
[7260.753734, "o", "\tfor start := 0; start < n; start++ {\r\n\t\tif visited[start] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tqueue := []int{start}\r\n\t\tvisited[start] = true\r\n\t\tcomponent := []int{start}\r\n\t\tfor len(queue) > 0 {\r\n\t\t\tcur := queue[0]\r\n\t\t\tqueue = queue[1:]\r\n\t\t\tfor next := 0; next < n; next++ {\r\n"]
[7260.753813, "o", "\t\t\t\tif !visited[next] && linked[cur][next] {\r\n\t\t\t\t\tvisited[next] = true\r\n\t\t\t\t\tqueue = append(queue, next)\r\n\t\t\t\t\tcomponent = append(component, next)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif len(component) >= 2 {\r\n\t\t\tcampaignCount++\r\n\t\t\tif len(component) > maxCampaignSize {\r\n\t\t\t\tmaxCampaignSize = len(component)\r\n"]
[7260.753878, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\treport.ActiveCampaigns = campaignCount\r\n\treport.MaxCampaignSize = maxCampaignSize\r\n\r\n\treturn report\r\n"]
[7260.753944, "o", "}\r\n\r\nfunc snapshotRiskCategory(mean float64) string {\r\n\tif mean < 100 {\r\n\t\treturn \"low\"\r\n\t}\r\n\tif mean < 250 {\r\n\t\treturn \"medium\"\r\n\t}\r\n\tif mean < 500 {\r\n\t\treturn \"high\"\r\n\t}\r\n\t"]
[7260.754005, "o", "return \"critical\"\r\n}\r\n"]
