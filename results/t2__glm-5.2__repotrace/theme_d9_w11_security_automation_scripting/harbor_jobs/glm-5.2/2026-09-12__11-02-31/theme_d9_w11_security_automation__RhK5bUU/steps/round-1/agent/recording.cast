[11089.096782, "i", "at64(*buckets)\n\n\tcounts := make([]int, *buckets)\n\tfor _, v := range values {\n\t\tidx := histogramBucketIndex(v, *minVal, *maxVal, *buckets, rawWidth)\n\t\tcounts[idx]++\n\t}\n\n\tbucketsOut := make([]histogramBucket, 0, *buckets)\n\tfor i := 0; i < *buckets; i++ {\n\t\tstart := *minVal + float64(i)*rawWidth\n\t\tend := *minVal + float64(i+1)*rawWidth\n\t\tif i == *buckets-1 {\n\t\t\tend = *maxVal\n\t\t}\n\t\tbucketsOut = append(bucketsOut, histogramBucket{\n\t\t\tRangeStart: round4(start),\n\t\t\tRangeEnd:   round4(end),\n\t\t\tCount:      counts[i],\n\t\t\tPercentage: round4(float64(counts[i]) / float64(n) * 100),\n\t\t})\n\t}\n\n\tsorted := make([]float64, n)\n\tcopy(sorted, values)\n\tsort.Float64s(sorted)\n\n\tmin := sorted[0]\n\tmax := sorted[n-1]\n\tsum := 0.0\n\tfor _, v := range values {\n\t\tsum += v\n\t}\n\tmean := sum / float64(n)\n\n\tvar sqSum float64\n\tfor _, v := range values {\n\t\tsqSum += (v - mean) * (v - mean)\n\t}\n\tstddev := math.Sqrt(sqSum / float64(n))\n\n\tout := histogramOutput{\n\t\tEventCount:  n,\n\t\tBucketWidth: round4(rawWidth),\n\t\tBuckets:     bucketsOut,\n\t\tStatistics: "]
[11089.096812, "o", "\u001b[?2004h> \u0007\"bufio\"\r\n\u001b[?2004l\r\u001b[?2004h> \u0007"]
[11089.096899, "i", "histogramStats{\n\t\t\tMin:    round4(min),\n\t\t\tMax:    round4(max),\n\t\t\tMean:   round4(mean),\n\t\t\tMedian: round4(percentile(sorted, 50)),\n\t\t\tP90:   round4(percentile(sorted, 90)),\n\t\t\tP95:   round4(percentile(sorted, 95)),\n\t\t\tStdDev: round4(stddev),\n\t\t},\n\t}\n\n\tencoder := json.NewEncoder(os.Stdout)\n\tif err := encoder.Encode(&out); err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc histogramBucketIndex(v, min, max float64, buckets int, width float64) int {\n\tif v <= min {\n\t\treturn 0\n\t}\n\tif v >= max {\n\t\treturn buckets - 1\n\t}\n\tidx := int((v - min) / width)\n\tif idx < 0 {\n\t\treturn 0\n\t}\n\tif idx >= buckets {\n\t\treturn buckets - 1\n\t}\n\n\t// Correct floating-point dust around exact bucket boundaries.\n\tlowerStart := min + float64(idx)*width\n\tupperStart := min + float64(idx+1)*width\n\tif v < lowerStart && idx > 0 {\n\t\tidx--\n\t} else if v >= upperStart && idx < buckets-1 {\n\t\tidx++\n\t}\n\treturn idx\n}\n\nfunc percentile(sorted []float64, p float64) float64 {\n\tn := len(sorted)\n\tif n == 1 {\n\t\treturn sorted[0]\n\t}\n\trank :"]
