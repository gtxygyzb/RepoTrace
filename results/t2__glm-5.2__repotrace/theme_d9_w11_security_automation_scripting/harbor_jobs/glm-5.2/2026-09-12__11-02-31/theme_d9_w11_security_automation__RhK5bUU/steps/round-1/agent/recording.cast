[10220.981948, "o", "package main\r\n\r\nimport (\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n"]
[10220.982025, "o", "\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|track|diff|anomaly> [flags]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar code int\r\n\tswitch os.Args[1] {\r\n\tcase \"prioritize\":\r\n\t\t"]
[10220.982097, "o", "code = runPrioritize(os.Args[2:])\r\n\tcase \"analyze\":\r\n\t\tcode = runAnalyze(os.Args[2:])\r\n\tcase \"summarize\":\r\n\t\tcode = runSummarize(os.Args[2:])\r\n\tcase \"filter\":\r\n\t\tcode = runFilter(os.Args[2:])\r\n\tcase \"respond\":\r\n\t\tcode = runRespond(os.Args[2:])\r\n\tcase \"enrich\":\r\n\t\tcode = runEnrich(os.Args[2:])\r\n\tcase \"correlate\":\r\n"]
[10220.982165, "o", "\t\tcode = runCorrelate(os.Args[2:])\r\n\tcase \"timeline\":\r\n\t\tcode = runTimeline(os.Args[2:])\r\n\tcase \"snapshot\":\r\n\t\tcode = runSnapshot(os.Args[2:])\r\n\tcase \"alert\":\r\n\t\tcode = runAlert(os.Args[2:])\r\n\tcase \"aggregate\":\r\n\t\tcode = runAggregate(os.Args[2:])\r\n\tcase \"diff\":\r\n\t\tcode = runDiff(os.Args[2:])\r\n"]
[10220.982268, "o", "\tcase \"anomaly\":\r\n\t\tcode = runAnomaly(os.Args[2:])\r\n\tcase \"track\":\r\n\t\tcode = runTrack(os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n\t\tcode = 1\r\n\t}\r\n\tos.Exit(code)\r\n}\r\n\r\nfunc newFlagSet(name string) *flag.FlagSet {\r\n\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n"]
[10220.982331, "o", "\tfs.SetOutput(os.Stderr)\r\n\tfs.Usage = func() {}\r\n\treturn fs\r\n}\r\n\r\nfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn false\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n\tset := false\r\n\t"]
[10220.982399, "o", "fs.Visit(func(f *flag.Flag) {\r\n\t\tif f.Name == name {\r\n\t\t\tset = true\r\n\t\t}\r\n\t})\r\n\treturn set\r\n"]
[10220.982461, "o", "}\r\n"]
