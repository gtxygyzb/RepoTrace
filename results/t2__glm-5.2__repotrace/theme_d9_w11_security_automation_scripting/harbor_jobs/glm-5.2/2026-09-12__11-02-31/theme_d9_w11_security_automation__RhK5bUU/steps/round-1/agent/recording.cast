[10312.145501, "o", "es[0]\r\n\\t\\treturn\r\n\\t}\r\n\tslope = (float64(n)*sumXY - sumX*sumY) / denom\r\n"]
[10312.14557, "o", "\\tintercept = (sumY - slope*sumX) / float64(n)\r\n\\t"]
[10312.145602, "o", "return\r\n}\r\n\r\nfunc predictLine(slope"]
[10312.145756, "o", ", intercept float64, startIndex, steps int) []float64 {\r\n\\tpredictions := make([]float64, steps)\r\n\\tfor i := 0; i < steps; i++ {\r\n\\t\\tpredict"]
