[4115.919385, "o", "\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tthreat[\"\u001b[01;31m\u001b[Kenriched_risk_score\u001b[m\u001b[K\"] = enrichedScore\r\n"]
