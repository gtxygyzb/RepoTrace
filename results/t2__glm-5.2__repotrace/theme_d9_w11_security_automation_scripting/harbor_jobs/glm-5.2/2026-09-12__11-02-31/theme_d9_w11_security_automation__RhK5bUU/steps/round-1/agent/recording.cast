[10148.427094, "o", "\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KroundedCombinedZ\u001b[m\u001b[K float64\r\n"]
[10148.427183, "o", "\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KroundedCombinedZ\u001b[m\u001b[K := \u001b[01;31m\u001b[KroundHalfUp4\u001b[m\u001b[K(combinedZ)\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KroundedCombinedZ\u001b[m\u001b[K: \u001b[01;31m\u001b[KroundedCombinedZ\u001b[m\u001b[K,\r\n"]
[10148.427287, "o", "\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif anomalies[a].\u001b[01;31m\u001b[KroundedCombinedZ\u001b[m\u001b[K != anomalies[b].\u001b[01;31m\u001b[KroundedCombinedZ\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn anomalies[a].\u001b[01;31m\u001b[KroundedCombinedZ\u001b[m\u001b[K > anomalies[b].\u001b[01;31m\u001b[KroundedCombinedZ\u001b[m\u001b[K\r\n\u001b[32m\u001b[K210\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KroundHalfUp4\u001b[m\u001b[K(f float64) float64 {\r\n\u001b[32m\u001b[K216\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\trounded := \u001b[01;31m\u001b[KroundHalfUp4\u001b[m\u001b[K(f)\r\n"]
