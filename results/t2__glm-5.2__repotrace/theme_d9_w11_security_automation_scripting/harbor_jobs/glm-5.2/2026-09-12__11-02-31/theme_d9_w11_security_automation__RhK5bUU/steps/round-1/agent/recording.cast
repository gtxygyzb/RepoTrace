[10441.609534, "o", "grep -n \"type anomaly\\|json:\\|roundHalfUp4\\|format4\\|Marshal\" anomaly.go\r\n\u001b[?2004l\r"]
[10441.612686, "o", "\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype anomaly\u001b[m\u001b[KInputSnapshot struct {\r\n"]
[10441.612817, "o", "\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tGlobalMeanRisk float64 `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"global_mean_risk\"`\r\n\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tTotalThreats   int     `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"total_threats\"`\r\n"]
[10441.612887, "o", "\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype anomaly\u001b[m\u001b[KMetricResult struct {\r\n\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tValue          json.Number `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"value\"`\r\n\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tBaselineMean   json.Number `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"baseline_mean\"`\r\n\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tBaselineStddev json.Number `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"baseline_stddev\"`\r\n\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tZScore         json.Number `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"z_score\"`\r\n\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype anomaly\u001b[m\u001b[KMetrics struct {\r\n\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tGlobalMeanRisk anomalyMetricResult `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"global_mean_risk\"`\r\n\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tTotalThreats   anomalyMetricResult `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"total_threats\"`\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype anomaly\u001b[m\u001b[KRecord struct {\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tIndex         int            `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"index\"`\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tMetrics       anomalyMetrics `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\""]
[10441.612966, "o", "metrics\"`\r\n\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tCombinedZ     json.Number    `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"combined_z\"`\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tBaselineCount int            `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"baseline_count\"`\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tDirection     string         `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"direction\"`\r\n\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tSeverity      string         `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"severity\"`\r\n"]
[10441.613072, "o", "\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\troundedCombinedZ := \u001b[01;31m\u001b[KroundHalfUp4\u001b[m\u001b[K(combinedZ)\r\n"]
[10441.613123, "o", "\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tBaselineMean:   json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(riskMean)),\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tBaselineStddev: json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(riskStd)),\r\n"]
[10441.613184, "o", "\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tZScore:         json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(riskZ)),\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tBaselineMean:   json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(threatMean)),\r\n\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tBaselineStddev: json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(threatStd)),\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tZScore:         json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(threatZ)),\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tCombinedZ:        json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(combinedZ)),\r\n"]
[10441.613278, "o", "\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KroundHalfUp4\u001b[m\u001b[K(f float64) float64 {\r\n\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(f float64) string {\r\n\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\trounded := \u001b[01;31m\u001b[KroundHalfUp4\u001b[m\u001b[K(f)\r\n"]
[10441.613761, "o", "\u001b[?2004h"]
[10441.613819, "o", "root@n30009:/app# "]
[10441.882778, "i", "sed -n '1,230p' anomaly.go\n"]
[10441.883031, "o", "sed -n '1,230p' anomaly.go\r\n"]
[10441.883086, "o", "\u001b[?2004l\r"]
[10441.885901, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t"]
[10441.886002, "o", "\"io\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n"]
[10441.88607, "o", "\t\"strings\"\r\n)\r\n\r\ntype anomalyInputSnapshot struct {\r\n\tGlobalMeanRisk float64 `json:\"global_mean_risk\"`\r\n\tTotalThreats   int     `json:\"total_threats\"`\r\n}\r\n\r\ntype anomalyMetricResult struct {\r\n\tValue          json.Number `json:\"value\"`\r\n\tBaselineMean   json.Number `json:\"baseline_mean\"`\r\n\tBaselineStddev json.Number `json:\"baseline_stddev\"`\r\n\tZScore         json.Number `json:\"z_score\"`\r\n}\r\n\r\ntype anomalyMetrics struct {\r\n\tGlobalMeanRisk anomalyMetricResult `json:\"global_mean_risk\"`\r\n\tTotalThreats   anomalyMetricResult `json:\"total_threats\"`\r\n}\r\n\r\ntype anomalyRecord struct {\r\n\tIndex         int            `json:\"index\"`\r\n\tMetrics       anomalyMetrics `json:\"metrics\"`\r\n\tCombinedZ     json.Number    `json:\"combined_z\"`\r\n"]
[10441.886148, "o", "\tBaselineCount int            `json:\"baseline_count\"`\r\n\tDirection     string         `json:\"direction\"`\r\n\tSeverity      string         `json:\"severity\"`\r\n\r\n\troundedCombinedZ float64\r\n}\r\n\r\nfunc runAnomaly(args []string) int {\r\n"]
[10441.886261, "o", "\tfs := newFlagSet(\"anomaly\")\r\n\twindow := fs.Int(\"window\", 5, \"baseline window size\")\r\n\tthreshold := fs.Float64(\"threshold\", 2.0, \"combined z-score anomaly threshold\")\r\n\tif !parseFlags(fs, args) {\r\n\t\treturn 1\r\n\t}\r\n\r\n\tif *window < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --window must be at least 2\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\tvar snapshots []anomalyInputSnapshot\r\n\treader := bufio.NewReader(os.Stdin)\r\n\tfor {\r\n\t\tline, err := reader.ReadString('\\n')\r\n\t\ttrimmed := strings.TrimSpace(line)\r\n\t\tif trimmed == \"\" {\r\n\t\t\tif err == io.EOF {\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t"]
[10441.886324, "o", "\tcontinue\r\n\t\t}\r\n\r\n\t\tvar snap anomalyInputSnapshot\r\n\t\tif jerr := json.Unmarshal([]byte(trimmed), &snap); jerr != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"error: malformed JSON input:\", jerr)\r\n\t\t\treturn 2\r\n\t\t}\r\n"]
[10441.886383, "o", "\t\tsnapshots = append(snapshots, snap)\r\n\r\n\t\tif err == io.EOF {\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n\tif len(snapshots) < 3 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: requires at least 3 valid JSON lines on stdin\")\r\n\t\treturn 1\r\n"]
[10441.886441, "o", "\t}\r\n\r\n\trisks := make([]float64, len(snapshots))\r\n\tthreats := make([]float64, len(snapshots))\r\n\tfor i, snap := range snapshots {\r\n\t\trisks[i] = snap.GlobalMeanRisk\r\n\t\tthreats[i] = float64(snap.TotalThreats)\r\n\t}\r\n\r\n\tvar anomalies []anomalyRecord\r\n\tfor i := 0; i < len(snapshots); i++ {\r\n\t\tstart := i - *window\r\n\t\tif start < 0 {\r\n\t"]
[10441.886508, "o", "\t\tstart = 0\r\n\t\t}\r\n\t\tbaselineCount := i - start\r\n\t\tif baselineCount < 2 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n"]
[10441.886581, "o", "\t\triskMean, riskStd := baselineStats(risks[start:i])\r\n\t\tthreatMean, threatStd := baselineStats(threats[start:i])\r\n\r\n\t\triskZ := zScore(risks[i], riskMean, riskStd)\r\n\t\tthreatZ := zScore(threats[i], threatMean, threatStd)\r\n\t\tcombinedZ := math.Sqrt(riskZ*riskZ + threatZ*threatZ)\r\n\t\troundedCombinedZ := roundHalfUp4(combinedZ)\r\n\r\n\t\tif combinedZ < *threshold {\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tdirection := \"mixed\"\r\n\t\tif riskZ >= 0 && threatZ >= 0 {\r\n\t\t\tdirection = \"above\"\r\n\t\t} else if riskZ <= 0 && threatZ <= 0 {\r\n"]
[10441.886642, "o", "\t\t\tdirection = \"below\"\r\n\t\t}\r\n\r\n\t\tseverity := \"low\"\r\n\t\tif combinedZ >= 4.0 {\r\n\t\t\tseverity = \"extreme\"\r\n\t\t} else if combinedZ >= 3.0 {\r\n\t\t\tseverity = \"high\"\r\n\t\t} else if combinedZ >= 2.0 {\r\n\t\t\tseverity = \"moderate\"\r\n\t\t}\r\n\r\n"]
[10441.886683, "o", "\t\tanomalies = append(anomalies, anomalyRecord{\r\n\t\t\tIndex: i,\r\n\t\t\tMetrics: anomalyMetrics{\r\n\t\t\t\tGlobalMeanRisk: anomalyMetricResult{\r\n\t\t\t\t\tValue:          json.Number(formatRiskValue(risks[i])),\r\n\t\t\t\t\tBaselineMean:   json.Number(format4(riskMean)),\r\n"]
[10441.886764, "o", "\t\t\t\t\tBaselineStddev: json.Number(format4(riskStd)),\r\n\t\t\t\t\tZScore:         json.Number(format4(riskZ)),\r\n\t\t\t\t},\r\n\t\t\t\tTotalThreats: anomalyMetricResult{\r\n\t\t\t\t\tValue:          json.Number(strconv.FormatInt(int64(threats[i]), 10)),\r\n\t\t\t\t\tBaselineMean:   json.Number(format4(threatMean)),\r\n\t\t\t\t\tBaselineStddev: json.Number(format4(threatStd)),\r\n\t\t\t\t\tZScore:         json.Number(format4(threatZ)),\r\n\t\t\t\t},\r\n\t\t\t},\r\n"]
[10441.886828, "o", "\t\t\tCombinedZ:        json.Number(format4(combinedZ)),\r\n\t\t\tBaselineCount:    baselineCount,\r\n\t\t\tDirection:        direction,\r\n\t\t\tSeverity:         severity,\r\n\t\t\troundedCombinedZ: roundedCombinedZ,\r\n\t\t})\r\n\t}\r\n\r\n\t"]
[10441.886886, "o", "sort.SliceStable(anomalies, func(a, b int) bool {\r\n\t\tif anomalies[a].roundedCombinedZ != anomalies[b].roundedCombinedZ {\r\n\t\t\treturn anomalies[a].roundedCombinedZ > anomalies[b].roundedCombinedZ\r\n\t\t}\r\n\t\treturn anomalies[a].Index < anomalies[b].Index\r\n\t})\r\n\r\n\tencoder := json.NewEncoder(os.Stdout)\r\n\tencoder.SetEscapeHTML(false)\r\n\tfor _, rec := range anomalies {\r\n\t\tif err := encoder.Encode(rec); err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"error: failed to write anomaly record:\", err)\r\n\t\t\treturn 1\r\n\t"]
[10441.886948, "o", "\t}\r\n\t}\r\n\r\n\treturn 0\r\n}\r\n\r\nfunc baselineStats(values []float64) (float64, float64) {\r\n\tn := len(values)\r\n\t"]
[10441.887006, "o", "if n == 0 {\r\n\t\treturn 0, 0\r\n\t}\r\n\r\n\tsum := 0.0\r\n\tfor _, v := range values {\r\n\t\tsum += v\r\n\t}\r\n\tmean := sum / float64(n)\r\n\r\n\tsquaredSum := 0.0\r\n\tfor _, v := range values {\r\n\t\tdiff := v - mean\r\n\t\tsquaredSum += diff * diff\r\n\t}\r\n\tstddev := math.Sqrt(squaredSum / float64(n))\r\n"]
[10441.887061, "o", "\r\n\treturn mean, stddev\r\n}\r\n\r\nfunc zScore(current, mean, stddev float64) float64 {\r\n\tif stddev == 0 {\r\n\t\tif current == mean {\r\n\t\t\treturn 0.0\r\n\t\t}\r\n"]
[10441.887118, "o", "\t\tif current > mean {\r\n\t\t\treturn 999.0\r\n\t\t}\r\n\t\treturn -999.0\r\n\t}\r\n\treturn (current - mean) / stddev\r\n}\r\n\r\nfunc roundHalfUp4(f float64) float64 {\r\n\tpow := 10000.0\r\n\treturn math.Copysign(math.Floor(math.Abs(f)*pow+0.5)/pow, f)\r\n"]
[10441.887185, "o", "}\r\n\r\nfunc format4(f float64) string {\r\n\trounded := roundHalfUp4(f)\r\n\tif rounded == 0 {\r\n\t\treturn \"0.0000\"\r\n\t}\r\n\treturn fmt.Sprintf(\"%.4f\", rounded)\r\n}\r\n\r\nfunc formatRiskValue(f float64) string {\r\n\t"]
[10441.887262, "o", "s := strconv.FormatFloat(f, 'f', -1, 64)\r\n\tif !strings.Contains(s, \".\") {\r\n\t\ts += \".0\"\r\n\t}\r\n\treturn s\r\n}\r\n"]
[10441.887712, "o", "\u001b[?2004h"]
[10441.887773, "o", "root@n30009:/app# "]
[10442.159943, "i", "grep -n -A12 -B2 \"func priorityLabel\" prioritize.go\n"]
[10442.160373, "o", "grep -n -A12 -B2 \"func priorityLabel\" prioritize.go\r\n\u001b[?2004l\r"]
[10442.163241, "o", "\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[10442.163363, "o", "\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc priorityLabel\u001b[m\u001b[K(score float64) string {\r\n\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tswitch {\r\n\u001b[32m\u001b[K196\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase score >= 0.80:\r\n"]
[10442.163435, "o", "\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn \"critical\"\r\n\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase score >= 0.55:\r\n\u001b[32m\u001b[K199\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn \"high\"\r\n\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase score >= 0.30:\r\n\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn \"medium\"\r\n\u001b[32m\u001b[K202\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefault:\r\n\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn \"low\"\r\n\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K205\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K206\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[10442.163882, "o", "\u001b[?2004h"]
