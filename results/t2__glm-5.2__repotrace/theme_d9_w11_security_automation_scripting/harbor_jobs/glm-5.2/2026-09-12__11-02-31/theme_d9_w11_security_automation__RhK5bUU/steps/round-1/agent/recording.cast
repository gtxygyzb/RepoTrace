[4833.542125, "o", "   188\t\t\t}\r\n   189\t\t}\r\n   190\t\tc.ThreatTypes = sortedKeys(typeSet)\r\n   191\t\tc.AllActors = sortedUniqueStringsFromSet(actorSet)\r\n   192\t\r\n   193\t\tif len(indices) > 0 {\r\n   194\t\t\tshared := make(map[string]bool)\r\n   195\t\t\tfor _, actor := range threats[indices[0]].actors {\r\n   196\t\t\t\tshared[actor] = true\r\n   197\t\t\t}\r\n   198\t\t\tfor _, idx := range indices[1:] {\r\n   199\t\t\t\tnext := make(map[string]bool)\r\n   200\t\t\t"]
[4833.542187, "o", "\tfor _, actor := range threats[idx].actors {\r\n   201\t\t\t\t\tif shared[actor] {\r\n   202\t\t\t\t\t\tnext[actor] = true\r\n   203\t\t\t\t\t}\r\n   204\t\t\t\t}\r\n   205\t"]
[4833.542258, "o", "\t\t\tshared = next\r\n   206\t\t\t}\r\n   207\t\t\tc.SharedActors = sortedUniqueStringsFromSet(shared)\r\n   208\t\t}\r\n   209\t\r\n   210\t\tdirectLinkCount := 0\r\n   211\t\tfor ii, i := range indices {\r\n   212\t\t\tfor jj := ii + 1; jj < len(indices); jj++ {\r\n   213\t\t\t\tif linked[i][indices[jj]] {\r\n   214\t\t\t\t\tdirectLinkCount++\r\n   215\t\t\t\t}\r\n"]
[4833.542318, "o", "   216\t\t\t}\r\n   217\t\t}\r\n   218\t\tc.DirectLinkCount = directLinkCount\r\n   219\t\tif c.ThreatCount > 1 {\r\n   220\t\t\tc.Cohesion = float64(directLinkCount) / (float64(c.ThreatCount*(c.ThreatCount-1)) / 2.0)\r\n   221\t\t} else {\r\n   222\t\t\tc.Cohesion = 0.0\r\n   223\t\t}\r\n"]
[4833.542381, "o", "   224\t\r\n   225\t\tpropagationScore := 0.0\r\n   226\t\tfor ii, i := range indices {\r\n   227\t\t\tfor jj := ii + 1; jj < len(indices); jj++ {\r\n   228\t\t\t\tj := indices[jj]\r\n   229\t\t\t\tif !linked[i][j] {\r\n   230\t\t\t\t\tcontinue\r\n   231\t\t\t\t}\r\n   232\t\t\t\tsharedCount := sharedActorCount(threats[i].actors, threats[j].actors)\r\n   233\t\t\t\tmultiplier := 0.05"]
[4833.542445, "o", "\r\n   234\t\t\t\tif sharedCount >= 2 {\r\n   235\t\t\t\t\tmultiplier = 0.1\r\n   236\t\t\t\t}\r\n   237\t\t\t\tpropagationScore += (threats[i].risk + threats[j].risk) * multiplier\r\n   238\t\t\t}\r\n   239\t\t}\r\n   240\t\tc.PropagationScore = propagationScore\r\n   241\t\r\n   242\t\tmaxSeverity := \"none\"\r\n"]
[4833.542508, "o", "   243\t\tfor _, idx := range indices {\r\n   244\t\t\tif correlateSeverityRank(threats[idx].severity) > correlateSeverityRank(maxSeverity) {\r\n   245\t\t\t\tmaxSeverity = threats[idx].severity\r\n   246\t\t\t}\r\n   247\t\t}\r\n   248\t\tc.MaxSeverity = maxSeverity\r\n   249\t\r\n   250\t\tearliest := threats[indices[0]].ref\r\n   251\t\t"]
[4833.542565, "o", "latest := earliest\r\n   252\t\tfor _, idx := range indices[1:] {\r\n   253\t\t\tif threats[idx].ref.Before(earliest) {\r\n   254\t\t\t\tearliest = threats[idx].ref\r\n   255\t\t\t}\r\n   256\t\t\tif threats[idx].ref.After(latest) {\r\n   257\t\t\t\tlatest = threats[idx].ref\r\n   258\t\t\t}\r\n"]
[4833.54263, "o", "   259\t\t}\r\n   260\t\tc.earliestTime = earliest\r\n   261\t\tc.Earliest = earliest.Format(time.RFC3339)\r\n   262\t\tc.Latest = latest.Format(time.RFC3339)\r\n   263\t\tc.TimeSpanMinutes = latest.Sub(earliest).Seconds() / 60.0\r\n   264\t\r\n   265\t\t"]
[4833.542688, "o", "combinedRisk := 0.0\r\n   266\t\tminThreatType := \"\"\r\n   267\t\tfor _, idx := range indices {\r\n   268\t\t\tcombinedRisk += threats[idx].risk\r\n   269\t\t\ttt := threats[idx].threatType\r\n   270\t\t\tif minThreatType == \"\" || tt < minThreatType {\r\n   271\t\t\t\tminThreatType = tt\r\n   272\t\t\t}\r\n   273\t\t}\r\n   274\t\tc.CombinedRisk = combinedRisk\r\n   275\t\tc.minThreatType = minThreatType\r\n   276\t\r\n   277\t"]
[4833.542746, "o", "\tsortedIndices := make([]int, len(indices))\r\n   278\t\tcopy(sortedIndices, indices)\r\n   279\t\tsort.SliceStable(sortedIndices, func(a, b int) bool {\r\n   280\t\t\tta := threats[sortedIndices[a]]\r\n   281\t\t\ttb := threats[sortedIndices[b]]\r\n   282\t\t\tif ta.risk != tb.risk {\r\n   283\t\t\t\treturn ta.risk > tb.risk\r\n   284\t\t\t}\r\n"]
[4833.542819, "o", "   285\t\t\tif !ta.ref.Equal(tb.ref) {\r\n   286\t\t\t\treturn ta.ref.Before(tb.ref)\r\n   287\t\t\t}\r\n   288\t\t\treturn ta.threatType < tb.threatType\r\n   289\t\t})\r\n   290\t\tc.Threats = make([]map[string]interface{}, 0, len(sortedIndices))\r\n   291\t\tfor _, idx := range sortedIndices {\r\n   292\t\t\tc.Threats = append(c.Threats, threats[idx].obj)\r\n   293\t\t}\r\n   294\t\r\n   295\t\treturn c\r\n"]
[4833.54289, "o", "   296\t}\r\n   297\t\r\n   298\tfunc sharedActorCount(a, b []string) int {\r\n   299\t\tset := make(map[string]bool)\r\n   300\t\tfor _, s := range a {\r\n   301\t\t\tset[s] = true\r\n   302\t\t}\r\n   303\t\tcount := 0\r\n   304\t\tseen := make(map[string]bool)\r\n   305\t\tfor _, s := range b {\r\n   306\t\t\tif set[s] && !seen[s] {\r\n   307"]
[4833.542963, "o", "\t\t\t\tcount++\r\n   308\t\t\t\tseen[s] = true\r\n   309\t\t\t}\r\n   310\t\t}\r\n   311\t\treturn count\r\n   312\t}\r\n   313\t\r\n   314\tfunc absDuration(d time.Duration) time.Duration {\r\n   315\t\tif d < 0 {\r\n   316\t\t\treturn -d\r\n   317\t\t}\r\n   318\t"]
[4833.543024, "o", "\treturn d\r\n   319\t}\r\n   320\t\r\n   321\tfunc correlateSeverityRank(s string) int {\r\n   322\t\tswitch s {\r\n   323\t\tcase \"none\":\r\n   324\t\t\treturn 0\r\n   325\t\tcase \"low\":\r\n   326\t\t\treturn 1\r\n   327\t\tcase \"medium\":\r\n   328"]
[4833.543083, "o", "\t\t\treturn 2\r\n   329\t\tcase \"high\":\r\n   330\t\t\treturn 3\r\n   331\t\tcase \"critical\":\r\n   332\t\t\treturn 4\r\n   333\t\tdefault:\r\n   334\t\t\treturn 0\r\n   335\t\t}\r\n   336\t}\r\n"]
