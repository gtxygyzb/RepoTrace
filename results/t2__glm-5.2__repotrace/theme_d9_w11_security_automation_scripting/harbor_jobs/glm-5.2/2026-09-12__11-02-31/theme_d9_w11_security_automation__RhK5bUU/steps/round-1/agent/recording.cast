[11579.299923, "o", "\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kswitch os.Args\u001b[m\u001b[K[1] {\r\n\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"prioritize\":\r\n\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runPrioritize(os.Args[2:])\r\n\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"analyze\":\r\n\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runAnalyze(os.Args[2:])\r\n"]
[11579.300021, "o", "\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"summarize\":\r\n\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runSummarize(os.Args[2:])\r\n\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"filter\":\r\n\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runFilter(os.Args[2:])\r\n\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"respond\":\r\n\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runRespond(os.Args[2:])\r\n\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"enrich\":\r\n\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runEnrich(os.Args[2:])\r\n\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"correlate\":\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runCorrelate(os.Args[2:])\r\n\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"timeline\":\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runTimeline(os.Args[2:])\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"snapshot\":\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runSnapshot(os.Args[2:])\r\n"]
[11579.300094, "o", "\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"alert\":\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runAlert(os.Args[2:])\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"aggregate\":\r\n\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runAggregate(os.Args[2:])\r\n\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"diff\":\r\n\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runDiff(os.Args[2:])\r\n\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"anomaly\":\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runAnomaly(os.Args[2:])\r\n\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"track\":\r\n\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runTrack(os.Args[2:])\r\n"]
[11579.300159, "o", "\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"forecast\":\r\n\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runForecast(os.Args[2:])\r\n\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"histogram\":\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = runHistogram(os.Args[2:])\r\n\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefault:\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcode = 1\r\n\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tos.Exit(code)\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
[11579.300281, "o", "\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc newFlagSet(name string) *flag.FlagSet {\r\n\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfs.SetOutput(os.Stderr)\r\n\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfs.Usage = func() {}\r\n\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn fs\r\n\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := fs.Parse(args); err != nil {\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn false\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn true\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[11579.300346, "o", "\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tset := false\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfs.Visit(func(f *flag.Flag) {\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif f.Name == name {\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tset = true\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t})\r\n\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn set\r\n"]
