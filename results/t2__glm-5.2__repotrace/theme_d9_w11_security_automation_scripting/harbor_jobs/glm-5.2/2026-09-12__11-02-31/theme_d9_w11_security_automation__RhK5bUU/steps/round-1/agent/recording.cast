[7431.872711, "i", "cat > aggregate.go <<'EOF'\npackage main\n\nimport (\n\t\"bufio\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n)\n\ntype aggregateSnapshot struct {\n\tTotalThreats       int            `json:\"total_threats\"`\n\tActiveCampaigns    int            `json:\"active_campaigns\"`\n\tMeanEnrichedRisk   float64        `json:\"mean_enriched_risk\"`\n\tDominantThreatType string         `json:\"dominant_threat_type\"`\n\tActorThreatCounts  map[string]int `json:\"actor_threat_counts\"`\n}\n\ntype aggregateReport struct {\n\tSnapshotCount       int            `json:\"snapshot_count\"`\n\tTotalThreats        int            `json:\"total_threats\"`\n\tTotalCampaigns      int            `json:\"total_campaigns\"`\n\tGlobalMeanRisk      float64        `json:\"global_mean_risk\"`\n\tGlobalMaxMeanRisk   float64        `json:\"global_max_mean_risk\"`\n\tGlobalRiskCategory  string         `json:\"global_risk_category\"`\n\tCombinedActorCounts map[string]int `json:\"combined_actor_counts\"`\n\tTopActor            string         `json:\"top_actor\"`\n\tDominantThreatType  string        "]
[7431.872886, "i", " `json:\"dominant_threat_type\"`\n\tTypeCounts          map[string]int `json:\"type_counts\"`\n}\n\nfunc runAggregate(args []string) int {\n\treport := aggregateReport{\n\t\tCombinedActorCounts: map[string]int{},\n\t\tTypeCounts:          map[string]int{},\n\t}\n\n\treader := bufio.NewReader(os.Stdin)\n\tweightedRiskSum := 0.0\n\tmaxMeanRisk := 0.0\n\tdominantTypeCounts := map[string]int{}\n\tactorCounts := map[string]int{}\n\tsnapshotCount := 0\n\n\tfor {\n\t\tline, err := reader.ReadString('\\n')\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif trimmed == \"\" {\n\t\t\tif err == io.EOF {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\n\t\tvar snap aggregateSnapshot\n\t\tif jerr := json.Unmarshal([]byte(trimmed), &snap); jerr != nil {\n\t\t\tfmt.Fprintln(os.Stderr, \"error: malformed JSON input:\", jerr)\n\t\t\treturn 2\n\t\t}\n\n\t\tsnapshotCount++\n\t\treport.TotalThreats += snap.TotalThreats\n\t\treport.TotalCampaigns += snap.ActiveCampaigns\n\t\tweightedRiskSum += snap.MeanEnrichedRisk * float64(snap.TotalThreats)\n\t\tif snap.MeanEnrichedRisk > maxMeanRisk {\n\t\t\tmaxMeanRisk = snap.MeanEnrichedRisk\n\t\t}\n\t\t"]
[7431.872945, "i", "for actor, count := range snap.ActorThreatCounts {\n\t\t\tactorCounts[actor] += count\n\t\t}\n\t\tdominantType := snap.DominantThreatType\n\t\tdominantTypeCounts[dominantType]++\n\t\treport.TypeCounts[dominantType] += snap.TotalThreats\n\n\t\tif err == io.EOF {\n\t\t\tbreak\n\t\t}\n\t}\n\n\treport.SnapshotCount = snapshotCount\n\tif report.TotalThreats > 0 {\n\t\treport.GlobalMeanRisk = round2(weightedRiskSum / float64(report.TotalThreats))\n\t} else {\n\t\treport.GlobalMeanRisk = 0.0\n\t}\n\treport.GlobalMaxMeanRisk = round2(maxMeanRisk)\n\treport.GlobalRiskCategory = snapshotRiskCategory(report.GlobalMeanRisk)\n\treport.CombinedActorCounts = actorCounts\n\treport.TopActor = topActorFromCounts(actorCounts)\n\treport.DominantThreatType = topDominantType(dominantTypeCounts)\n\n\tif report.CombinedActorCounts == nil {\n\t\treport.CombinedActorCounts = map[string]int{}\n\t}\n\tif report.TypeCounts == nil {\n\t\treport.TypeCounts = map[string]int{}\n\t}\n\n\tout, err := json.Marshal(report)\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, \"error: encoding aggregate report:\", err)\n\t\treturn "]
[7431.87299, "o", "cat > aggregate.go <<'EOF'\r\n"]
[7431.873086, "i", "1\n\t}\n\tfmt.Println(string(out))\n\treturn 0\n}\n\nfunc topActorFromCounts(counts map[string]int) string {\n\tactors := make([]string, 0, len(counts))\n\tfor actor := range counts {\n\t\tactors = append(actors, actor)\n\t}\n\tsort.Strings(actors)\n\n\ttopActor := \"\"\n\tmaxCount := -1\n\tfor _, actor := range actors {\n\t\tcount := counts[actor]\n\t\tif count > maxCount {\n\t\t\tmaxCount = count\n\t\t\ttopActor = actor\n\t\t}\n\t}\n\tif maxCount < 0 {\n\t\treturn \"\"\n\t}\n\treturn topActor\n}\n\nfunc topDominantType(counts map[string]int) string {\n\ttypes := make([]string, 0, len(counts))\n\tfor t := range counts {\n\t\ttypes = append(types, t)\n\t}\n\tsort.Strings(types)\n\n\ttopType := \"\"\n\tmaxCount := -1\n\tfor _, t := range types {\n\t\tcount := counts[t]\n\t\tif count > maxCount {\n\t\t\tmaxCount = count\n\t\t\ttopType = t\n\t\t}\n\t}\n\tif maxCount < 0 {\n\t\treturn \"\"\n\t}\n\treturn topType\n}\nEOF\n"]
