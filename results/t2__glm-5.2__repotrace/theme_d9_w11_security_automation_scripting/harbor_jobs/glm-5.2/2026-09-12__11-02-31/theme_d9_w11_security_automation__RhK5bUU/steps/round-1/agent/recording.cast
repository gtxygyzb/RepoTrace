[1875.475911, "o", "\u001b[35m\u001b[Kchain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tSourceIP       string   `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"source_ip\"`\r\n\u001b[35m\u001b[Kchain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tStages         []string `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"stages\"`\r\n\u001b[35m\u001b[Kchain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tTotalRiskScore float64  `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"total_risk_score\"`\r\n\u001b[35m\u001b[Kchain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tFirstSeen      string   `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"first_seen\"`\r\n\u001b[35m\u001b[Kchain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tLastSeen       string   `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"last_seen\"`\r\n"]
