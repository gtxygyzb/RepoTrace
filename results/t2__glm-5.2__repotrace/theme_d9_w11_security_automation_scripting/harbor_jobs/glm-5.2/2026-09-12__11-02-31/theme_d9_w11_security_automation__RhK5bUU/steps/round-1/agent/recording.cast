[3168.600687, "o", "    42\t\tfs := newFlagSet(\"correlate\")\r\n    43\t\ttimeWindow := fs.Int(\"time-window\", 0, \"maximum temporal distance in minutes for two threats to be linkable\")\r\n    44\t\tminCampaignSize := fs.Int(\"min-campaign-size\", 2, \"minimum number of threats in a campaign to output\")\r\n    45\t\tif !parseFlags(fs, args) {\r\n    46\t\t\treturn 1\r\n    47\t\t}\r\n    48\t\tif !isFlagSet(fs, \"time-window\") {\r\n    49\t\t\tfmt.Fprintln(os.Stderr, \"error: --time-window flag is required\")\r\n"]
