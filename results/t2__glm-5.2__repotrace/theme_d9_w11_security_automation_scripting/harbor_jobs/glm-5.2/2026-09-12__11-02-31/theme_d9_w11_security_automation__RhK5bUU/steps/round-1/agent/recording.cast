[8924.093947, "i", "\n\t\t}\n\t}\n\n\treturn 0\n}\n\nfunc baselineStats(values []float64) (float64, float64) {\n\tn := len(values)\n\tif n == 0 {\n\t\treturn 0, 0\n\t}\n\n\tsum := 0.0\n\tfor _, v := range values {\n\t\tsum += v\n\t}\n\tmean := sum / float64(n)\n\n\tsquaredSum := 0.0\n\tfor _, v := range values {\n\t\tdiff := v - mean\n\t\tsquaredSum += diff * diff\n\t}\n\tstddev := math.Sqrt(squaredSum / float64(n))\n\n\treturn mean, stddev\n}\n\nfunc zScore(current, mean, stddev float64) float64 {\n\tif stddev == 0 {\n\t\tif current == mean {\n\t\t\treturn 0.0\n\t\t}\n\t\tif current > mean {\n\t\t\treturn 999.0\n\t\t}\n\t\treturn -999.0\n\t}\n\treturn (current - mean) / stddev\n}\n\nfunc numberFromFloat(value float64, asInteger bool) json.Number {\n\tif asInteger {\n\t\treturn json.Number(fmt.Sprintf(\"%d\", int64(value)))\n\t}\n\treturn json.Number(round4String(value))\n}\n\nfunc round4String(f float64) string {\n\treturn fmt.Sprintf(\"%.4f\", round4(f))\n}\nEOF\n"]
