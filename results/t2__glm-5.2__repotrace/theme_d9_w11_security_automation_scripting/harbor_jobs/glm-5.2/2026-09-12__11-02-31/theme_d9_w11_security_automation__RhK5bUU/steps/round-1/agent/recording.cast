[7690.411684, "o", "   188\t\t\t\treturn p, false\r\n   189\t\t\t}\r\n   190\t\t\tp.port = port\r\n   191\t\tcase \"user\":\r\n   192\t\tdefault:\r\n   193\t\t\treturn p, false\r\n   194\t\t}\r\n   195\t\treturn p, true\r\n   196\t}\r\n   197\t\r\n"]
[7690.411749, "o", "   198\tfunc enrichThreat(threat map[string]interface{}, iocs []processedIOC, fixedRef time.Time, hasRef bool, minConf float64) map[string]interface{} {\r\n   199\t\trefTime := fixedRef\r\n   200\t\tif !hasRef {\r\n   201\t\t\trefTime = threatReferenceTime(threat)\r\n   202\t\t}\r\n   203\t\r\n   204\t\tmatches := computeIOCMatches(threat, iocs, refTime, minConf)\r\n   205\t\r\n   206\t\triskScore, _ := getFloat(threat, \"risk_score\")\r\n   207\t\tmaxConf := 0.0\r\n"]
[7690.41181, "o", "   208\t\ttagFactor := make(map[string]float64)\r\n   209\t\tseverityContrib := 0\r\n   210\t\tindicatorTypes := make(map[string]bool)\r\n   211\t\tactors := make(map[string]bool)\r\n   212\t\tsevRank := 0\r\n   213\t\r\n   214\t\tfor _, m := range matches {\r\n   215\t\t\tif m.adjusted > maxConf {\r\n   216\t\t"]
[7690.41187, "o", "\t\tmaxConf = m.adjusted\r\n   217\t\t\t}\r\n   218\t\t\tfor _, tag := range m.p.entry.Tags {\r\n   219\t\t\t\tif cur, ok := tagFactor[tag]; ok {\r\n   220\t\t\t\t\tif m.freshness > cur {\r\n   221\t\t\t\t\t\ttagFactor[tag] = m.freshness\r\n   222\t\t\t\t\t}\r\n   223\t\t\t\t} else {"]
[7690.411933, "o", "\r\n   224\t\t\t\t\ttagFactor[tag] = m.freshness\r\n   225\t\t\t\t}\r\n   226\t\t\t}\r\n   227\t\t\tseverityContrib += severityWeight(m.p.entry.Severity)\r\n   228\t\t\tindicatorTypes[m.p.entry.IndicatorType] = true\r\n   229\t\t\tactors[m.p.entry.ThreatActor] = true\r\n   230\t\t\tif v := severityValue(m.p.entry.Severity); v > sevRank {\r\n   231\t\t\t\t"]
[7690.412002, "o", "sevRank = v\r\n   232\t\t\t}\r\n   233\t\t}\r\n   234\t\r\n   235\t\ttagBonus := 0.0\r\n   236\t\tfor tag, factor := range tagFactor {\r\n   237\t\t\ttagBonus += tagBonusValue(tag) * factor\r\n   238\t\t}\r\n   239\t\r\n   240\t\tmultiVectorBonus := 0.0\r\n   241\t\tswitch len(indicatorTypes) {\r\n"]
[7690.412061, "o", "   242\t\tcase 0, 1:\r\n   243\t\t\tmultiVectorBonus = 0.0\r\n   244\t\tcase 2:\r\n   245\t\t\tmultiVectorBonus = 25.0\r\n   246\t\tdefault:\r\n   247\t\t\tmultiVectorBonus = 50.0\r\n   248\t\t}\r\n   249\t\r\n   250\t\t"]
[7690.412122, "o", "actorBonus := 0.0\r\n   251\t\tswitch len(actors) {\r\n   252\t\tcase 0, 1:\r\n   253\t\t\tactorBonus = 0.0\r\n   254\t\tcase 2:\r\n   255\t\t\tactorBonus = 15.0\r\n   256\t\tdefault:\r\n   257\t\t\tactorBonus = 30.0\r\n   258\t\t}\r\n"]
[7690.412181, "o", "   259\t\r\n   260\t\tenrichedScore := riskScore*(1.0+maxConf) + tagBonus + multiVectorBonus + float64(severityContrib) + actorBonus\r\n"]
