[322.824084, "o", "    return e, nil\r\n\u001b[?2004l\r"]
[322.824172, "o", "\u001b[?2004h> }\r\n"]
[322.824282, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[322.824363, "o", "\u001b[?2004h> "]
[322.824743, "o", "func parseTime(ts string) (time.Time, error) {\r\n\u001b[?2004l\r"]
[322.824815, "o", "\u001b[?2004h"]
[322.824877, "o", "> "]
[322.825156, "o", "    t, err := time.Parse(time.RFC3339, ts)\r\n\u001b[?2004l\r"]
[322.825235, "o", "\u001b[?2004h> "]
[322.825423, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[322.825511, "o", "\u001b[?2004h> "]
[322.826111, "o", "        return time.Time{}, fmt.Errorf(\"invalid timestamp %q: %w\", ts, err)\r\n\u001b[?2004l\r"]
[322.82619, "o", "\u001b[?2004h> "]
[322.826282, "o", "    }\r\n\u001b[?2004l\r"]
[322.826349, "o", "\u001b[?2004h> "]
[322.82644, "o", "    return t, nil\r\n\u001b[?2004l\r"]
[322.826503, "o", "\u001b[?2004h> "]
[322.826556, "o", "}\r\n\u001b[?2004l\r"]
[322.826653, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.826914, "o", "func readEvents() ([]Event, error) {\r\n\u001b[?2004l\r"]
[322.826977, "o", "\u001b[?2004h> "]
[322.827243, "o", "    scanner := bufio.NewScanner(os.Stdin)\r\n\u001b[?2004l\r"]
[322.827294, "o", "\u001b[?2004h> "]
[322.827643, "o", "    scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\u001b[?2004l\r"]
[322.827703, "o", "\u001b[?2004h> "]
[322.827838, "o", "    var events []Event\r\n\u001b[?2004l\r"]
[322.827906, "o", "\u001b[?2004h> "]
[322.82798, "o", "    lineNo := 0\r\n\u001b[?2004l\r"]
[322.828037, "o", "\u001b[?2004h> "]
[322.828175, "o", "    for scanner.Scan() {\r\n\u001b[?2004l\r"]
[322.828247, "o", "\u001b[?2004h> "]
[322.828358, "o", "        lineNo++\r\n\u001b[?2004l\r"]
[322.828416, "o", "\u001b[?2004h> "]
[322.82859, "o", "        line := scanner.Text()\r\n\u001b[?2004l\r"]
[322.828651, "o", "\u001b[?2004h> "]
[322.828784, "o", "        if line == \"\" {\r\n\u001b[?2004l\r"]
[322.828847, "o", "\u001b[?2004h> "]
[322.828954, "o", "            continue\r\n\u001b[?2004l\r"]
[322.829012, "o", "\u001b[?2004h> "]
[322.829075, "o", "        }\r\n\u001b[?2004l\r"]
[322.829119, "o", "\u001b[?2004h> "]
[322.829332, "o", "        e, err := parseEvent(line)\r\n\u001b[?2004l\r"]
[322.829391, "o", "\u001b[?2004h> "]
[322.829524, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[322.829586, "o", "\u001b[?2004h> "]
[322.830038, "o", "            return events, fmt.Errorf(\"line %d: %w\", lineNo, err)\r\n\u001b[?2004l\r"]
[322.830104, "o", "\u001b[?2004h"]
[322.830173, "o", "> "]
[322.830252, "o", "        }\r\n\u001b[?2004l\r"]
[322.830317, "o", "\u001b[?2004h"]
[322.83038, "o", "> "]
[322.830676, "o", "        events = append(events, e)\r\n\u001b[?2004l\r"]
[322.830747, "o", "\u001b[?2004h"]
[322.830803, "o", "> "]
[322.830866, "o", "    }\r\n\u001b[?2004l\r"]
[322.830935, "o", "\u001b[?2004h> "]
[322.831351, "o", "    if err := scanner.Err(); err != nil {\r\n\u001b[?2004l\r"]
[322.831429, "o", "\u001b[?2004h"]
[322.831498, "o", "> "]
[322.831733, "o", "        return events, err\r\n\u001b[?2004l\r"]
[322.831805, "o", "\u001b[?2004h> "]
[322.831885, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.831954, "o", "> "]
[322.832065, "o", "    return events, nil\r\n\u001b[?2004l\r"]
[322.832141, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[322.83223, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[322.832296, "o", "\u001b[?2004h> "]
[322.832555, "o", "func sortEventsByTime(events []Event) {\r\n\u001b[?2004l\r"]
[322.832611, "o", "\u001b[?2004h> "]
[322.832956, "o", "    sort.SliceStable(events, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[322.833025, "o", "\u001b[?2004h> "]
[322.833405, "o", "        return events[i].Timestamp < events[j].Timestamp\r\n\u001b[?2004l\r"]
[322.833477, "o", "\u001b[?2004h> "]
[322.833535, "o", "    })\r\n\u001b[?2004l\r"]
[322.833601, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[322.833676, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[322.833738, "o", "\u001b[?2004h> "]
[322.834085, "o", "func uniqueSortedStrings(input []string) []string {\r\n\u001b[?2004l\r"]
[322.834153, "o", "\u001b[?2004h> "]
[322.834387, "o", "    seen := make(map[string]bool)\r\n\u001b[?2004l\r"]
[322.834445, "o", "\u001b[?2004h> "]
[322.834599, "o", "    var out []string\r\n\u001b[?2004l\r"]
[322.834657, "o", "\u001b[?2004h> "]
[322.834868, "o", "    for _, s := range input {\r\n\u001b[?2004l\r"]
[322.834914, "o", "\u001b[?2004h> "]
[322.835055, "o", "        if !seen[s] {\r\n\u001b[?2004l\r"]
[322.835121, "o", "\u001b[?2004h> "]
[322.835203, "o", "            seen[s] = true\r\n\u001b[?2004l\r"]
[322.835281, "o", "\u001b[?2004h> "]
[322.835374, "o", "            out = append(out, s)\r\n\u001b[?2004l\r"]
[322.835453, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[322.835521, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.835583, "o", "> "]
[322.835656, "o", "    sort.Strings(out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.835722, "o", "    return out\r\n\u001b[?2004l\r"]
[322.835801, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[322.835861, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.836016, "o", "func uniqueSortedInts(input []int) []int {\r\n\u001b[?2004l\r"]
[322.836084, "o", "\u001b[?2004h> "]
[322.83617, "o", "    seen := make(map[int]bool)\r\n\u001b[?2004l\r"]
[322.836251, "o", "\u001b[?2004h> "]
[322.836322, "o", "    var out []int\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.836432, "o", "    for _, n := range input {\r\n\u001b[?2004l\r"]
[322.836499, "o", "\u001b[?2004h> "]
[322.836575, "o", "        if !seen[n] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.836691, "o", "            seen[n] = true\r\n\u001b[?2004l\r"]
[322.836758, "o", "\u001b[?2004h> "]
[322.836852, "o", "            out = append(out, n)\r\n\u001b[?2004l\r"]
[322.83693, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[322.836999, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.837094, "o", "    sort.Ints(out)\r\n\u001b[?2004l\r"]
[322.837149, "o", "\u001b[?2004h> "]
[322.837236, "o", "    return out\r\n\u001b[?2004l\r"]
[322.83731, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[322.837373, "o", "\u001b[?2004h> "]
[322.837456, "o", "func round2(f float64) float64 {\r\n\u001b[?2004l\r"]
[322.837521, "o", "\u001b[?2004h> "]
[322.837658, "o", "    return float64(int64(f*100+0.5)) / 100\r\n\u001b[?2004l\r"]
[322.837734, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[322.837803, "o", "\u001b[?2004h> "]
