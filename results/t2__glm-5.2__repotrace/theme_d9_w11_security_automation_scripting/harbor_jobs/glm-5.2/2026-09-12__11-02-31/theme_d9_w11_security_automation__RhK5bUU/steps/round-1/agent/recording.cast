[11621.099877, "o", "\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn 1\r\n\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif *steps < 1 {\r\n\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"error: --steps must be at least 1\")\r\n\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn 1\r\n\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[11621.099951, "o", "\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar snapshots []forecastInputSnapshot\r\n\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tscanner := bufio.NewScanner(os.Stdin)\r\n\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n"]
