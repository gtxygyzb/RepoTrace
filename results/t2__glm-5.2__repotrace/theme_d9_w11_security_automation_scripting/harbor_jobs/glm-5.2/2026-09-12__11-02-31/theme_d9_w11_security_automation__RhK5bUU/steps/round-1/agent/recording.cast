[637.104028, "o", "func nonNilStrings(s []string) []string {\r\n\u001b[?2004l\r"]
[637.104122, "o", "\u001b[?2004h"]
[637.104192, "o", "> "]
[637.104227, "o", "    if s == nil {\r\n\u001b[?2004l\r"]
[637.104324, "o", "\u001b[?2004h> "]
[637.104461, "o", "        return []string{}\r\n\u001b[?2004l\r"]
[637.104553, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[637.104626, "o", "\u001b[?2004h> "]
