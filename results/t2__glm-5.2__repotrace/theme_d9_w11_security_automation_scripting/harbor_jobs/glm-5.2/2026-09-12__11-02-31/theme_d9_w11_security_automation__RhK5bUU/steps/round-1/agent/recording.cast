[4833.80725, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5"]
[4833.807341, "o", "\t\t\"sort\"\r\n     6\t\t\"time\"\r\n     7\t)\r\n     8\t\r\n     9\ttype Threat struct {\r\n    10\t\tThreatType       string\r\n    11\t\tSourceIP         string\r\n    12\t\tDestIP           string\r\n    13\t\tCount            int\r\n    14\t\tFirstSeen        string\r\n    15\t\tLastSeen         string\r\n    16\t\tTargetUsers      []string\r\n    17\t\tRiskScore        float64\r\n    18\t\tPortsScanned     []int\r\n"]
[4833.807419, "o", "    19\t\tTotalBytes       int64\r\n    20\t\tDestIPs          []string\r\n    21\t\tUser             string\r\n    22\t\tTimestamp        string\r\n    23\t\tPriorFailures    int\r\n    24\t\tCompromisedHosts []string\r\n    25\t\tQueryCount       int\r\n    26\t\tAvgPayload       float64\r\n    27\t\r\n    28\t\tfirstTime time.Time\r\n    29\t\tlastTime  time.Time\r\n    30\t"]
[4833.80748, "o", "}\r\n    31\t\r\n    32\tfunc (t Threat) MarshalJSON() ([]byte, error) {\r\n    33\t\tswitch t.ThreatType {\r\n    34\t\tcase \"brute_force\":\r\n    35\t\t\treturn json.Marshal(struct {\r\n    36\t\t\t\tThreatType  string   `json:\"threat_type\"`\r\n    37\t\t\t\tSourceIP    string   `json:\"source_ip\"`\r\n    38\t\t\t\tCount       int      `json:\"count\"`\r\n"]
[4833.807538, "o", "    39\t\t\t\tFirstSeen   string   `json:\"first_seen\"`\r\n    40\t\t\t\tLastSeen    string   `json:\"last_seen\"`\r\n    41\t\t\t\tTargetUsers []string `json:\"target_users\"`\r\n    42\t\t\t\tRiskScore   float64  `json:\"risk_score\"`\r\n    43\t\t\t}{\r\n    44\t\t\t\tThreatType:  t.ThreatType,\r\n"]
[4833.807601, "o", "    45\t\t\t\tSourceIP:    t.SourceIP,\r\n    46\t\t\t\tCount:       t.Count,\r\n    47\t\t\t\tFirstSeen:   t.FirstSeen,\r\n    48\t\t\t\tLastSeen:    t.LastSeen,\r\n    49\t\t\t\tTargetUsers: nonNilStrings(t.TargetUsers),\r\n    50\t\t\t\tRiskScore:   t.RiskScore,\r\n    51\t\t\t})\r\n    52\t\tcase \"port_scan\":\r\n    53\t\t\treturn json.Marshal(struct {\r\n"]
[4833.807661, "o", "    54\t\t\t\tThreatType   string  `json:\"threat_type\"`\r\n    55\t\t\t\tSourceIP     string  `json:\"source_ip\"`\r\n    56\t\t\t\tDestIP       string  `json:\"dest_ip\"`\r\n    57\t\t\t\tPortsScanned []int   `json:\"ports_scanned\"`\r\n    58\t\t\t\tFirstSeen    string  `json:\"first_seen\"`\r\n    59\t\t\t\tLastSeen     string  `json:\"last_seen\"`\r\n    60\t\t\t\tRiskScore    float64 `json:\"risk_score\"`\r\n    61\t\t\t}{\r\n    62\t\t\t\tThreatType:   t.ThreatType,\r\n    63"]
[4833.807718, "o", "\t\t\t\tSourceIP:     t.SourceIP,\r\n    64\t\t\t\tDestIP:       t.DestIP,\r\n    65\t\t\t\tPortsScanned: nonNilInts(t.PortsScanned),\r\n    66\t\t\t\tFirstSeen:    t.FirstSeen,\r\n    67\t\t\t\tLastSeen:     t.LastSeen,\r\n    68\t\t\t\tRiskScore:    t.RiskScore,\r\n    69\t\t\t})\r\n"]
[4833.807783, "o", "    70\t\tcase \"data_exfiltration\":\r\n    71\t\t\treturn json.Marshal(struct {\r\n    72\t\t\t\tThreatType string   `json:\"threat_type\"`\r\n    73\t\t\t\tSourceIP   string   `json:\"source_ip\"`\r\n    74\t\t\t\tTotalBytes int64    `json:\"total_bytes\"`\r\n    75\t\t\t\tFirstSeen  string   `json:\"first_seen\"`\r\n    76\t\t\t\tLastSeen   string   `json:\"last_seen\"`\r\n    77\t\t\t\tDestIPs    []string `json:\"dest_ips\"`\r\n    78\t\t\t\tRiskScore  float64  `json:\"risk_score\"`\r\n"]
[4833.807852, "o", "    79\t\t\t}{\r\n    80\t\t\t\tThreatType: t.ThreatType,\r\n    81\t\t\t\tSourceIP:   t.SourceIP,\r\n    82\t\t\t\tTotalBytes: t.TotalBytes,\r\n    83\t\t\t\tFirstSeen:  t.FirstSeen,\r\n    84\t\t\t\tLastSeen:   t.LastSeen,"]
[4833.807913, "o", "\r\n    85\t\t\t\tDestIPs:    nonNilStrings(t.DestIPs),\r\n    86\t\t\t\tRiskScore:  t.RiskScore,\r\n    87\t\t\t})\r\n    88\t\tcase \"privilege_escalation\":\r\n    89\t\t\treturn json.Marshal(struct {\r\n    90\t\t\t\tThreatType    string  `json:\"threat_type\"`\r\n    91\t\t\t\tUser          string  `json:\"user\"`\r\n    92\t\t\t\tSourceIP      string  `json:\"source_ip\"`\r\n    93\t\t\t\tTimestamp     string  `json:\"timestamp\"`\r\n    94\t\t\t\tPriorFailures int     `json:\"prior_failures\"`\r\n    95"]
[4833.807976, "o", "\t\t\t\tRiskScore     float64 `json:\"risk_score\"`\r\n    96\t\t\t}{\r\n    97\t\t\t\tThreatType:    t.ThreatType,\r\n    98\t\t\t\tUser:          t.User,\r\n    99\t\t\t\tSourceIP:      t.SourceIP,\r\n   100\t\t\t\tTimestamp:     t.Timestamp,\r\n   101\t\t\t\tPriorFailures: t.PriorFailures,\r\n   102\t\t\t\tRiskScore:     t.RiskScore,\r\n   103\t\t\t})\r\n   104\t\tcase \"lateral_movement\":\r\n"]
[4833.808037, "o", "   105\t\t\treturn json.Marshal(struct {\r\n   106\t\t\t\tThreatType       string   `json:\"threat_type\"`\r\n   107\t\t\t\tSourceIP         string   `json:\"source_ip\"`\r\n   108\t\t\t\tCompromisedHosts []string `json:\"compromised_hosts\"`\r\n   109\t\t\t\tFirstSeen        string   `json:\"first_seen\"`\r\n   110\t\t\t\tLastSeen         string   `json:\"last_seen\"`\r\n   111\t\t\t\tRiskScore        float64  `json:\"risk_score\"`\r\n   112\t\t\t}{\r\n   113\t\t\t"]
[4833.8081, "o", "\tThreatType:       t.ThreatType,\r\n   114\t\t\t\tSourceIP:         t.SourceIP,\r\n   115\t\t\t\tCompromisedHosts: nonNilStrings(t.CompromisedHosts),\r\n   116\t\t\t\tFirstSeen:        t.FirstSeen,\r\n   117\t\t\t\tLastSeen:         t.LastSeen,\r\n   118\t\t\t\tRiskScore:        t.RiskScore,\r\n   119\t\t\t})\r\n"]
[4833.808158, "o", "   120\t\tcase \"dns_tunneling\":\r\n   121\t\t\treturn json.Marshal(struct {\r\n   122\t\t\t\tThreatType string  `json:\"threat_type\"`\r\n   123\t\t\t\tSourceIP   string  `json:\"source_ip\"`\r\n   124\t\t\t\tQueryCount int     `json:\"query_count\"`\r\n   125\t\t\t\tAvgPayload float64 `json:\"avg_payload\"`\r\n   126\t\t\t\tFirstSeen  string  `json:\"first_seen\"`\r\n   127\t\t\t\tLastSeen   string  `json:\"last_seen\"`\r\n"]
[4833.808225, "o", "   128\t\t\t\tRiskScore  float64 `json:\"risk_score\"`\r\n   129\t\t\t}{\r\n   130\t\t\t\tThreatType: t.ThreatType,\r\n   131\t\t\t\tSourceIP:   t.SourceIP,\r\n   132\t\t\t\tQueryCount: t.QueryCount,\r\n   133\t\t\t\tAvgPayload: t.AvgPayload,\r\n   134\t\t\t\tFirstSeen:  t.FirstSeen,\r\n   135\t\t\t\tLastSeen:   t.LastSeen,\r\n   136\t\t\t\tRiskScore:  t.RiskScore,\r\n"]
[4833.808286, "o", "   137\t\t\t})\r\n   138\t\t}\r\n   139\t\treturn json.Marshal(struct {\r\n   140\t\t\tThreatType string  `json:\"threat_type\"`\r\n   141\t\t\tRiskScore  float64 `json:\"risk_score\"`\r\n   142\t\t}{\r\n   143\t\t\tThreatType: t.ThreatType,\r\n   144\t\t\tRiskScore:  t.RiskScore,\r\n   145\t"]
[4833.808343, "o", "\t})\r\n   146\t}\r\n   147\t\r\n   148\tfunc nonNilStrings(s []string) []string {\r\n   149\t\tif s == nil {\r\n   150\t\t\treturn []string{}\r\n   151\t\t}\r\n   152\t\treturn s\r\n   153\t"]
[4833.808403, "o", "}\r\n   154\t\r\n   155\tfunc nonNilInts(s []int) []int {\r\n   156\t\tif s == nil {\r\n   157\t\t\treturn []int{}\r\n   158\t\t}\r\n   159\t\treturn s\r\n   160\t}\r\n   161\t\r\n   162\tfunc sortEvents(events []Event) {\r\n"]
[4833.808465, "o", "   163\t\tsort.SliceStable(events, func(i, j int) bool {\r\n   164\t\t\tti, errI := parseTime(events[i].Timestamp)\r\n   165\t\t\ttj, errJ := parseTime(events[j].Timestamp)\r\n   166\t\t\tif errI == nil && errJ == nil {\r\n   167\t\t\t\tif ti.Before(tj) {\r\n   168\t\t\t\t\treturn true\r\n   169\t\t\t\t}\r\n   170\t\t\t\tif tj.Before(ti) {\r\n"]
[4833.808534, "o", "   171\t\t\t\t\treturn false\r\n   172\t\t\t\t}\r\n   173\t\t\t\treturn events[i].Timestamp < events[j].Timestamp\r\n   174\t\t\t}\r\n   175\t\t\treturn events[i].Timestamp < events[j].Timestamp\r\n   176\t\t})\r\n   177\t}\r\n   178\t\r\n   179\tfunc eventTime(e Event) (time.Time, bool) {\r\n   180\t\tt, err := parseTime(e.Timestamp)\r\n   181\t\treturn t, err == nil\r\n"]
[4833.808592, "o", "   182\t}\r\n   183\t\r\n   184\tfunc detectThreats(events []Event) []Threat {\r\n   185\t\tsortEvents(events)\r\n   186\t\tvar threats []Threat\r\n   187\t\tthreats = append(threats, detectBruteForce(events)...)\r\n   188\t\tthreats = append(threats, detectPortScan(events)...)\r\n   189\t\tthreats = append(threats, detectDataExfiltration(events)...)\r\n   190\t\tthreats = append(threats, detectPrivilegeEscalation(events)...)\r\n   191\t"]
[4833.808654, "o", "\tthreats = append(threats, detectLateralMovement(events)...)\r\n   192\t\tthreats = append(threats, detectDNSTunneling(events)...)\r\n   193\t\tsortThreats(threats)\r\n   194\t\treturn threats\r\n   195\t}\r\n   196\t\r\n   197\tfunc sortThreats(threats []Threat) {\r\n   198\t\tsort.SliceStable(threats, func(i, j int) bool {\r\n   199\t\t"]
[4833.808712, "o", "\tif threats[i].RiskScore != threats[j].RiskScore {\r\n   200\t\t\t\treturn threats[i].RiskScore > threats[j].RiskScore\r\n   201\t\t\t}\r\n   202\t\t\tif !threats[i].firstTime.Equal(threats[j].firstTime) {\r\n   203\t\t\t\treturn threats[i].firstTime.Before(threats[j].firstTime)\r\n   204\t\t\t}\r\n   205\t\t\treturn threats[i].ThreatType < threats[j].ThreatType\r\n   206\t\t})\r\n   207\t}\r\n"]
[4833.808777, "o", "   208\t\r\n   209\tfunc detectBruteForce(events []Event) []Threat {\r\n   210\t\tbyIP := make(map[string][]Event)\r\n   211\t\tfor _, e := range events {\r\n   212\t\t\tif e.EventType == \"auth_failure\" {\r\n   213\t\t\t\tbyIP[e.SourceIP] = append(byIP[e.SourceIP], e)\r\n   214\t\t\t}\r\n   215"]
[4833.808817, "o", "\t\t}\r\n   216\t\r\n   217\t\tvar threats []Threat\r\n   218\t\tfor ip, evs := range byIP {\r\n"]
[4833.8089, "o", "   219\t\t\tfor i := 0; i < len(evs); i++ {\r\n   220\t\t\t\tstart, ok := eventTime(evs[i])\r\n   221\t\t\t\tif !ok {\r\n   222\t\t\t\t\tcontinue\r\n   223\t\t\t\t}\r\n   224\t\t\t\tvar window []Event\r\n   225\t\t\t\tfor j := i; j < len(evs); j++ {\r\n   226\t\t\t\t\tt, ok := eventTime(evs[j])\r\n   227\t\t\t\t\tif !ok {\r\n   228\t\t\t\t\t\tcontinue\r\n   229\t\t\t\t\t}\r\n   230\t\t\t\t\tif t.Sub(start) <= 60*time.Second {\r\n   231\t\t\t\t\t\twindow = append(window, evs[j])\r\n"]
[4833.808957, "o", "   232\t\t\t\t\t} else {\r\n   233\t\t\t\t\t\tbreak\r\n   234\t\t\t\t\t}\r\n   235\t\t\t\t}\r\n   236\t\t\t\tif len(window) >= 5 {\r\n   237\t\t\t\t\tusers := make([]string, 0, len(window))\r\n"]
