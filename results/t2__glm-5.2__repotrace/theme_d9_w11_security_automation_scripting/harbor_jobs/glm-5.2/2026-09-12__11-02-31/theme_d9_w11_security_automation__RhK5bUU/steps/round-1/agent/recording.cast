[7662.066083, "o", "\tSourceIP         string\r\n\tDestIP           string\r\n\tCount            int\r\n\tFirstSeen        string\r\n\tLastSeen         string\r\n\tTargetUsers      []string\r\n\tRiskScore        float64\r\n\tPortsScanned     []int\r\n\tTotalBytes       int64\r\n\tDestIPs          []string\r\n\tUser             string\r\n\tTimestamp        string\r\n\tPriorFailures    int\r\n\tCompromisedHosts []string\r\n\t"]
