[7716.55687, "o", "\t\"os\"\r\n     7\t)\r\n     8\t\r\n     9\tfunc main() {\r\n    10\t\tif len(os.Args) < 2 {\r\n    11\t\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate> [flags]\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\r\n    15\t\tvar code int\r\n    16\t\tswitch os.Args[1] {\r\n    17\t\tcase \"analyze\":\r\n"]
