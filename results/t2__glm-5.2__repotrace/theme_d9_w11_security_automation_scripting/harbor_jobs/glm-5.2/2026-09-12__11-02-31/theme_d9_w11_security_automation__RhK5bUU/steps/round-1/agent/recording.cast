[8220.207035, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('main.go')\ns = p.read_text()\ns = s.replace('secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize> [flags]', 'secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|diff> [flags]')\ns = s.replace('\\tcase \"aggregate\":\\n\\t\\tcode = runAggregate(os.Args[2:])\\n', '\\tcase \"aggregate\":\\n\\t\\tcode = runAggregate(os.Args[2:])\\n\\tcase \"diff\":\\n\\t\\tcode = runDiff(os.Args[2:])\\n')\np.write_text(s)\nPY\n"]
