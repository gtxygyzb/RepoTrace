[951.967708, "o", "\u001b[?2004h> "]
[951.967799, "o", "        os.Exit(1)\r\n\u001b[?2004l\r"]
[951.967855, "o", "\u001b[?2004h> "]
[951.967913, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[951.967968, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[951.968025, "o", "> "]
[951.968102, "o", "    var code int\r\n\u001b[?2004l\r"]
[951.968157, "o", "\u001b[?2004h> "]
[951.9683, "o", "    switch os.Args[1] {\r\n\u001b[?2004l\r"]
[951.968358, "o", "\u001b[?2004h> "]
[951.96847, "o", "    case \"analyze\":\r\n\u001b[?2004l\r"]
[951.968525, "o", "\u001b[?2004h> "]
