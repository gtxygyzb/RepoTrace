[1556.158561, "i", "ntln(w)\n    fmt.Fprintln(w, \"--- Top Source IPs ---\")\n    for i, src := range s.TopSourceIPs {\n        fmt.Fprintf(w, \"  %d. %s - %d events (threat score: %g)\\n\", i+1, src.IP, src.Count, src.ThreatScore)\n    }\n\n    fmt.Fprintln(w)\n    fmt.Fprintln(w, \"--- Action Distribution ---\")\n    fmt.Fprintf(w, \"ALLOW: %d\\n\", s.ByAction[\"ALLOW\"])\n    fmt.Fprintf(w, \"DENY:  %d\\n\", s.ByAction[\"DENY\"])\n    fmt.Fprintf(w, \"DROP:  %d\\n\", s.ByAction[\"DROP\"])\n}\nEOF\n"]
