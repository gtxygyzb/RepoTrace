[4845.414121, "o", "\t\tfs.SetOutput(os.Stderr)\r\n    41\t\tfs.Usage = func() {}\r\n    42\t\treturn fs\r\n    43\t}\r\n    44\t\r\n    45\tfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n    46\t\tif err := fs.Parse(args); err != nil {\r\n    47\t\t\treturn false\r\n    48\t\t}\r\n    49"]
[4845.41418, "o", "\t\treturn true\r\n    50\t}\r\n    51\t\r\n    52\tfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n    53\t\tset := false\r\n    54\t\tfs.Visit(func(f *flag.Flag) {\r\n    55\t\t\tif f.Name == name {\r\n    56\t\t\t\tset = true\r\n"]
[4845.414309, "o", "    57\t\t\t}\r\n    58\t\t})\r\n    59\t\treturn set\r\n    60\t}\r\n"]
