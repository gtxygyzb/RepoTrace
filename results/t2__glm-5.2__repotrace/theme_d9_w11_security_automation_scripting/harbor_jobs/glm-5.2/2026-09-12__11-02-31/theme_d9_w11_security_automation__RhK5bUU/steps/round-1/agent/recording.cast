[12051.79982, "o", "package main\r\n\r\nimport (\r\n        \"bufio\"\r\n        \"encoding/json\"\r\n        \"fmt\"\r\n        \"math\"\r\n        \"os\"\r\n        \"strconv\"\r\n)\r\n\r\n"]
[12051.799927, "o", "type rateMetricResult struct {\r\n        MeanRate    json.Number `json:\"mean_rate\"`\r\n        MaxRate     json.Number `json:\"max_rate\"`\r\n        MinRate     json.Number `json:\"min_rate\"`\r\n        Volatility  json.Number `json:\"volatility\"`\r\n        Stability   string      `json:\"stability\"`\r\n        Deltas      []json.Number `json:\"deltas\"`\r\n}\r\n\r\ntype rateOutput struct {\r\n        InputCount       int                       `json:\"input_count\"`\r\n        StepCount        int                       `json:\"step_count\"`\r\n        Metrics          map[string]rateMetricResult `json:\"metrics\"`\r\n        OverallStability string                    `json:\"overall_stability\"`\r\n}\r\n\r\nfunc runRate(args []string) int {\r\n        fs := newFlagSet(\"rate\")\r\n        minSnapshots := fs.Int(\"min-snapshots\", 2, \"minimum number of input snapshots\")\r\n        if !parseFlags(fs, args) {\r\n                return 1\r\n"]
[12051.800009, "o", "        }\r\n        if *minSnapshots < 2 {\r\n                fmt.Fprintln(os.Stderr, \"error: --min-snapshots must be at least 2\")\r\n                return 1\r\n        }\r\n\r\n        var snapshots []forecastInputSnapshot\r\n        scanner := bufio.NewScanner(os.Stdin)\r\n        scanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n        for scanner.Scan() {\r\n                line := scanner.Text()\r\n                if len(line) == 0 {\r\n                        continue\r\n                }\r\n                var snap forecastInputSnapshot\r\n                if err := json.Unmarshal([]byte(line), &snap); err != nil {\r\n                        fmt.Fprintf(os.Stderr, \"error: malformed JSON input: %s\\n\", err)"]
[12051.800122, "o", "\r\n                        return 2\r\n                }\r\n                snapshots = append(snapshots, snap)\r\n        }\r\n        if err := scanner.Err(); err != nil {\r\n                fmt.Fprintf(os.Stderr, \"error: reading input: %s\\n\", err)\r\n                return 1\r\n        }\r\n        if len(snapshots) < *minSnapshots {\r\n                fmt.Fprintf(os.Stderr, \"error: at least %d valid input snapshots are required\\n\", *minSnapshots)\r\n                return 1\r\n        }\r\n\r\n        riskDeltas := make([]float64, 0, len(snapshots)-1)\r\n        threatDeltas := make([]int, 0, len(snapshots)-1)\r\n        for i := 0; i < len(snapshots)-1; i++ {\r\n                riskDeltas = append(riskDeltas, snapshots[i+1].GlobalMeanRisk-snapshots[i].GlobalMeanRisk)\r\n                threatDeltas = append(threatDeltas, snapshots[i+1].TotalThreats-snapshots[i].TotalThreats)\r\n        }\r\n\r\n        metrics := map[string]rateMetricResult{\r\n"]
[12051.800187, "o", "                \"global_mean_risk\": buildRateMetric(riskDeltasAsNumbers(riskDeltas), true),\r\n                \"total_threats\":    buildRateMetric(threatDeltasAsNumbers(threatDeltas), false),\r\n        }\r\n\r\n        out := rateOutput{\r\n                InputCount:       len(snapshots),\r\n                StepCount:        len(riskDeltas),\r\n                Metrics:          metrics,\r\n                OverallStability: overallRateStability(metrics),\r\n        }\r\n\r\n        encoded, err := json.Marshal(out)\r\n        if err != nil {\r\n"]
[12051.800326, "o", "                fmt.Fprintln(os.Stderr, \"error: encoding rate output:\", err)\r\n                return 1\r\n        }\r\n        fmt.Println(string(encoded))\r\n        return 0\r\n}\r\n\r\nfunc buildRateMetric(deltas []json.Number, isRisk bool) rateMetricResult {\r\n        if len(deltas) == 0 {\r\n                return rateMetricResult{\r\n                        MeanRate:    json.Number(format4(0)),\r\n                        MaxRate:     json.Number(\"0\"),\r\n                        MinRate:     json.Number(\"0\"),\r\n                        Volatility:  json.Number(format4(0)),\r\n                        Stability:   \"stable\",\r\n                        Deltas:      deltas,\r\n                }\r\n        }\r\n\r\n        floatDeltas := make([]float64, len(deltas))\r\n        for i, d := range deltas {\r\n                v, _ := d.Float64()\r\n                floatDeltas[i] = v\r\n        }\r\n\r\n        meanRate := meanOfValues(floatDeltas)\r\n        maxRate := maxRateDelta(floatDeltas)\r\n"]
[12051.800388, "o", "        minRate := minRateDelta(floatDeltas)\r\n        volatility := populationStdDev(floatDeltas)\r\n        stability := rateStability(volatility, math.Abs(meanRate))\r\n\r\n        var maxNum, minNum json.Number\r\n        if isRisk {\r\n                maxNum = json.Number(format4(maxRate))\r\n                minNum = json.Number(format4(minRate))\r\n        } else {\r\n                maxNum = json.Number(strconv.Itoa(int(maxRate)))\r\n                minNum = json.Number(strconv.Itoa(int(minRate)))\r\n        }\r\n"]
[12051.800454, "o", "\r\n        return rateMetricResult{\r\n                MeanRate:    json.Number(format4(meanRate)),\r\n                MaxRate:     maxNum,\r\n                MinRate:     minNum,\r\n                Volatility:  json.Number(format4(volatility)),\r\n                Stability:   stability,\r\n                Deltas:      deltas,\r\n        }\r\n}\r\n\r\nfunc riskDeltasAsNumbers(deltas []float64) []json.Number {\r\n"]
[12051.800527, "o", "        out := make([]json.Number, len(deltas))\r\n        for i, d := range deltas {\r\n                out[i] = json.Number(format4(d))\r\n        }\r\n        return out\r\n}\r\n\r\nfunc threatDeltasAsNumbers(deltas []int) []json.Number {\r\n        out := make([]json.Number, len(deltas))\r\n        for i, d := range deltas {\r\n                out[i] = json.Number(strconv.Itoa(d))\r\n        }\r\n        return out\r\n}\r\n\r\n"]
[12051.800588, "o", "func maxRateDelta(deltas []float64) float64 {\r\n        var best float64\r\n        for i, d := range deltas {\r\n                if i == 0 {\r\n                        best = d\r\n                        continue\r\n                }\r\n                if math.Abs(d) > math.Abs(best) || (math.Abs(d) == math.Abs(best) && d > best) {\r\n                        best = d\r\n                }\r\n        }\r\n        return best\r\n"]
[12051.800644, "o", "}\r\n\r\nfunc minRateDelta(deltas []float64) float64 {\r\n        var best float64\r\n        for i, d := range deltas {\r\n                if i == 0 {\r\n                        best = d\r\n                        continue\r\n                }\r\n                if math.Abs(d) < math.Abs(best) || (math.Abs(d) == math.Abs(best) && d > best) {\r\n                        best = d\r\n                }\r\n"]
[12051.800707, "o", "        }\r\n        return best\r\n}\r\n\r\nfunc populationStdDev(values []float64) float64 {\r\n        if len(values) == 0 {\r\n                return 0\r\n        }\r\n        mean := meanOfValues(values)\r\n        var sumSqDiff float64\r\n        for _, v := range values {\r\n                diff := v - mean\r\n"]
[12051.800764, "o", "                sumSqDiff += diff * diff\r\n        }\r\n        return math.Sqrt(sumSqDiff / float64(len(values)))\r\n}\r\n\r\nfunc rateStability(volatility, absMeanRate float64) string {\r\n        if volatility < 0.1*math.Max(absMeanRate, 1.0) {\r\n                return \"stable\"\r\n        }\r\n        return \"volatile\"\r\n}\r\n\r\n"]
[12051.800821, "o", "func overallRateStability(metrics map[string]rateMetricResult) string {\r\n        if metrics[\"global_mean_risk\"].Stability == \"stable\" && metrics[\"total_threats\"].Stability == \"stable\" {\r\n                return \"stable\"\r\n        }\r\n        return \"volatile\"\r\n}\r\n"]
[12051.801295, "o", "\u001b[?2004h"]
