[5570.613787, "o", "\u001b[35m\u001b[K./enrich.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K552\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc threatReferenceTime\u001b[m\u001b[K(threat map[string]interface{}) time.Time {\r\n"]
[5570.613858, "o", "\u001b[35m\u001b[K./enrich.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K588\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc threatSortTime\u001b[m\u001b[K(threat map[string]interface{}) time.Time {\r\n"]
