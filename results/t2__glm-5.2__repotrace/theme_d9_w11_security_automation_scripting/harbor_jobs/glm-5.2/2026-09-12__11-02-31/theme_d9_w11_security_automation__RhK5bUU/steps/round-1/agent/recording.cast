[4139.212411, "o", "   624\t\t\t\ts, ok := e.(string)\r\n   625\t\t\t\tif !ok {\r\n   626\t\t\t\t\treturn nil, false\r\n   627\t\t\t\t}\r\n   628\t\t\t\tout = append(out, s)\r\n   629\t\t\t}\r\n   630\t\t\treturn out, true\r\n   631\t\tdefault:\r\n   632\t\t\treturn nil, false\r\n   633\t\t}\r\n   634"]
[4139.212473, "o", "\t}\r\n   635\t\r\n   636\tfunc getFloat(m map[string]interface{}, key string) (float64, bool) {\r\n   637\t\tv, ok := m[key]\r\n   638\t\tif !ok {\r\n   639\t\t\treturn 0, false\r\n   640\t\t}\r\n   641\t\tswitch val := v.(type) {\r\n   642\t\tcase float64:\r\n"]
[4139.212529, "o", "   643\t\t\treturn val, true\r\n   644\t\tcase int:\r\n   645\t\t\treturn float64(val), true\r\n   646\t\tdefault:\r\n   647\t\t\treturn 0, false\r\n   648\t\t}\r\n   649\t}\r\n"]
[4139.212586, "o", "   650\t\r\n   651\tfunc getIntSlice(m map[string]interface{}, key string) ([]int, bool) {\r\n   652\t\tv, ok := m[key]\r\n   653\t\tif !ok {\r\n   654\t\t\treturn nil, false\r\n   655\t\t}\r\n   656\t\tswitch val := v.(type) {\r\n   657\t\tcase []int:\r\n   658\t\t\treturn val, true\r\n"]
