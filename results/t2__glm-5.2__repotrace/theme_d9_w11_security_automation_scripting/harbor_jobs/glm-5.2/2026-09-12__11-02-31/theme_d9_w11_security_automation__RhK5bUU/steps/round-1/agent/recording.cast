[11089.096319, "i", "cat > histogram.go <<'EOF'\npackage main\n\nimport (\n\t\"bufio\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"math\"\n\t\"os\"\n\t\"sort\"\n)\n\ntype histogramBucket struct {\n\tRangeStart float64 `json:\"range_start\"`\n\tRangeEnd   float64 `json:\"range_end\"`\n\tCount      int     `json:\"count\"`\n\tPercentage float64 `json:\"percentage\"`\n}\n\ntype histogramStats struct {\n\tMin    float64 `json:\"min\"`\n\tMax    float64 `json:\"max\"`\n\tMean   float64 `json:\"mean\"`\n\tMedian float64 `json:\"median\"`\n\tP90   float64 `json:\"p90\"`\n\tP95   float64 `json:\"p95\"`\n\tStdDev float64 `json:\"stddev\"`\n}\n\ntype histogramOutput struct {\n\tEventCount  int               `json:\"event_count\"`\n\tBucketWidth float64           `json:\"bucket_width\"`\n\tBuckets     []histogramBucket `json:\"buckets\"`\n\tStatistics  histogramStats    `json:\"statistics\"`\n}\n\nfunc runHistogram(args []string) int {\n\tfs := newFlagSet(\"histogram\")\n\tbuckets := fs.Int(\"buckets\", 5, \"number of buckets\")\n\tminVal := fs.Float64(\"min\", 0, \"minimum value\")\n\tmaxVal := fs.Float64(\"max\", 500, \"maximum value\")\n\tif !parseFlags(fs, args) {"]
[11089.096599, "i", "\n\t\treturn 1\n\t}\n\tif *buckets < 2 {\n\t\tfmt.Fprintln(os.Stderr, \"--buckets must be at least 2\")\n\t\treturn 1\n\t}\n\tif *minVal >= *maxVal {\n\t\tfmt.Fprintln(os.Stderr, \"--min must be less than --max\")\n\t\treturn 1\n\t}\n\n\tscanner := bufio.NewScanner(os.Stdin)\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\n\n\tvar values []float64\n\tlineNo := 0\n\tfor scanner.Scan() {\n\t\tlineNo++\n\t\tline := scanner.Text()\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tvar event map[string]interface{}\n\t\tif err := json.Unmarshal([]byte(line), &event); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\n\t\t\treturn 2\n\t\t}\n\t\tscore, ok := getFloat(event, \"enriched_risk_score\")\n\t\tif !ok {\n\t\t\tfmt.Fprintf(os.Stderr, \"line %d: missing or invalid enriched_risk_score\\n\", lineNo)\n\t\t\treturn 2\n\t\t}\n\t\tvalues = append(values, score)\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\tif len(values) == 0 {\n\t\tfmt.Fprintln(os.Stderr, \"no valid events\")\n\t\treturn 1\n\t}\n\n\tn := len(values)\n\trawWidth := (*maxVal - *minVal) / flo"]
