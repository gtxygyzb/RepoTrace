[951.971553, "o", "func newFlagSet(name string) *flag.FlagSet {\r\n\u001b[?2004l\r"]
[951.971608, "o", "\u001b[?2004h> "]
[951.97191, "o", "    fs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n\u001b[?2004l\r"]
[951.971965, "o", "\u001b[?2004h> "]
[951.972124, "o", "    fs.SetOutput(os.Stderr)\r\n\u001b[?2004l\r"]
[951.97218, "o", "\u001b[?2004h> "]
[951.972329, "o", "    fs.Usage = func() {}\r\n\u001b[?2004l\r"]
[951.97239, "o", "\u001b[?2004h> "]
[951.972464, "o", "    return fs\r\n\u001b[?2004l\r"]
[951.97252, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[951.972586, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[951.972643, "o", "\u001b[?2004h> "]
[951.972956, "o", "func parseFlags(fs *flag.FlagSet, args []string) bool {\r\n\u001b[?2004l\r"]
[951.973012, "o", "\u001b[?2004h> "]
[951.973263, "o", "    if err := fs.Parse(args); err != nil {\r\n\u001b[?2004l\r"]
[951.973331, "o", "\u001b[?2004h> "]
[951.973446, "o", "        return false\r\n\u001b[?2004l\r"]
[951.973501, "o", "\u001b[?2004h> "]
[951.973557, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[951.973614, "o", "> "]
[951.973684, "o", "    return true\r\n\u001b[?2004l\r"]
[951.97374, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[951.973805, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[951.973862, "o", "\u001b[?2004h> "]
[951.974159, "o", "func isFlagSet(fs *flag.FlagSet, name string) bool {\r\n\u001b[?2004l\r"]
[951.974234, "o", "\u001b[?2004h> "]
[951.974326, "o", "    set := false\r\n\u001b[?2004l\r"]
[951.97438, "o", "\u001b[?2004h> "]
[951.974577, "o", "    fs.Visit(func(f *flag.Flag) {\r\n\u001b[?2004l\r"]
[951.974632, "o", "\u001b[?2004h> "]
[951.974797, "o", "        if f.Name == name {\r\n\u001b[?2004l\r"]
[951.974853, "o", "\u001b[?2004h> "]
[951.974986, "o", "            set = true\r\n\u001b[?2004l\r"]
[951.975042, "o", "\u001b[?2004h> "]
[951.975101, "o", "        }\r\n\u001b[?2004l\r"]
[951.975156, "o", "\u001b[?2004h> "]
[951.97523, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h"]
[951.97529, "o", "> "]
[951.975347, "o", "    return set\r\n\u001b[?2004l\r"]
[951.975404, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[951.975466, "o", "\u001b[?2004h> "]
[951.975521, "o", "EOF\r\n\u001b[?2004l\r"]
