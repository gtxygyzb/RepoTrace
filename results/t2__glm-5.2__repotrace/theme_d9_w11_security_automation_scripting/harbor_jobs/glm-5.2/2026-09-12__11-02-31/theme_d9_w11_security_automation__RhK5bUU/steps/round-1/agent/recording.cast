[4826.493439, "o", "   309\t\t\t\t\tlast, ok := eventTime(window[len(window)-1])\r\n   310\t\t\t\t\tif !ok {\r\n   311\t\t\t\t\t\tlast = start\r\n   312\t\t\t\t\t}\r\n   313\t\t\t\t\tthreats = append(threats, Threat{\r\n   314\t\t\t\t\t\tThreatType:   \"port_scan\",\r\n   315\t\t\t\t\t\tSourceIP:     ip,\r\n   316\t\t\t\t\t\tDestIP:       dest,\r\n   317\t\t\t\t\t"]
