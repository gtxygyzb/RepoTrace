[10269.940768, "o", "\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"io\"\r\n     8\t\t\"os\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"strings\"\r\n    11\t)\r\n    12\t\r\n    13\ttype aggregateSnapshot struct {\r\n    14\t\tTotalThreats       int            `json:\"total_threats\"`\r\n    15\t\tActiveCampaigns    int            `json:\"active_campaigns\"`\r\n    16\t\tMeanEnrichedRisk   float64        `json:\"mean_enriched_risk\"`\r\n    17\t\tDominantThreatType string         `json:\"dominant_threat_type\"`\r\n    18\t\tActorThreatCounts  map[string]int `json:\"actor_threat_counts\"`\r\n    19\t}\r\n    20\t\r\n"]
[10269.940847, "o", "    21\ttype aggregateReport struct {\r\n    22\t\tSnapshotCount       int            `json:\"snapshot_count\"`\r\n    23\t\tTotalThreats        int            `json:\"total_threats\"`\r\n    24\t\tTotalCampaigns      int            `json:\"total_campaigns\"`\r\n    25\t\tGlobalMeanRisk      float64        `json:\"global_mean_risk\"`\r\n    26\t\tGlobalMaxMeanRisk   float64        `json:\"global_max_mean_risk\"`\r\n    27\t\tGlobalRiskCategory  string         `json:\"global_risk_category\"`\r\n    28\t\tCombinedActorCounts map[string]int `json:\"combined_actor_counts\"`\r\n    29\t\tTopActor            string         `json:\"top_actor\"`\r\n    30"]
[10269.940916, "o", "\t\tDominantThreatType  string         `json:\"dominant_threat_type\"`\r\n    31\t\tTypeCounts          map[string]int `json:\"type_counts\"`\r\n    32\t}\r\n    33\t\r\n    34\tfunc runAggregate(args []string) int {\r\n    35\t\treport := aggregateReport{\r\n    36\t\t\tCombinedActorCounts: map[string]int{},\r\n"]
[10269.940982, "o", "    37\t\t\tTypeCounts:          map[string]int{},\r\n    38\t\t}\r\n    39\t\r\n    40\t\treader := bufio.NewReader(os.Stdin)\r\n    41\t\tweightedRiskSum := 0.0\r\n    42\t\tmaxMeanRisk := 0.0\r\n    43\t\tdominantTypeCounts := map[string]int{}\r\n    44\t\tactorCounts := map[string]int{}\r\n    45\t\tsnapshotCount := 0\r\n    46\t"]
[10269.941045, "o", "\r\n    47\t\tfor {\r\n    48\t\t\tline, err := reader.ReadString('\\n')\r\n    49\t\t\ttrimmed := strings.TrimSpace(line)\r\n    50\t\t\tif trimmed == \"\" {\r\n    51\t\t\t\tif err == io.EOF {\r\n    52\t\t\t\t\tbreak\r\n    53\t\t\t\t}\r\n    54\t\t\t\tcontinue\r\n    55"]
[10269.941108, "o", "\t\t\t}\r\n    56\t\r\n    57\t\t\tvar snap aggregateSnapshot\r\n    58\t\t\tif jerr := json.Unmarshal([]byte(trimmed), &snap); jerr != nil {\r\n    59\t\t\t\tfmt.Fprintln(os.Stderr, \"error: malformed JSON input:\", jerr)\r\n    60\t\t\t\treturn 2\r\n    61\t\t\t}\r\n    62\t\r\n    63\t"]
[10269.941171, "o", "\t\tsnapshotCount++\r\n    64\t\t\treport.TotalThreats += snap.TotalThreats\r\n    65\t\t\treport.TotalCampaigns += snap.ActiveCampaigns\r\n    66\t\t\tweightedRiskSum += snap.MeanEnrichedRisk * float64(snap.TotalThreats)\r\n    67\t\t\tif snap.MeanEnrichedRisk > maxMeanRisk {\r\n    68\t\t\t\tmaxMeanRisk = snap.MeanEnrichedRisk\r\n"]
[10269.941276, "o", "    69\t\t\t}\r\n    70\t\t\tfor actor, count := range snap.ActorThreatCounts {\r\n    71\t\t\t\tactorCounts[actor] += count\r\n    72\t\t\t}\r\n    73\t\t\tdominantType := snap.DominantThreatType\r\n    74\t\t\tdominantTypeCounts[dominantType]++\r\n    75\t\t\treport.TypeCounts[dominantType] += snap.TotalThreats\r\n    76\t\r\n    77\t\t\tif err == io.EOF {\r\n    78\t\t\t\tbreak\r\n    79\t\t\t}\r\n    80\t\t}\r\n    81\t\r\n    82\t\treport.SnapshotCount = snapshotCount\r\n    83\t\tif report.TotalThreats > 0 {\r\n    84\t\t\treport.GlobalMeanRisk = round2(weightedRiskSum / float64(report.TotalThreats))\r\n"]
[10269.941304, "o", "    85\t\t} else {\r\n    86\t\t\treport.GlobalMeanRisk = 0.0\r\n    87\t\t}\r\n    88\t\treport.GlobalMaxMeanRisk = round2(maxMeanRisk)\r\n"]
[10269.941419, "o", "    89\t\treport.GlobalRiskCategory = snapshotRiskCategory(report.GlobalMeanRisk)\r\n    90\t\treport.CombinedActorCounts = actorCounts\r\n    91\t\treport.TopActor = topActorFromCounts(actorCounts)\r\n    92\t\treport.DominantThreatType = topDominantType(dominantTypeCounts)\r\n    93\t\r\n    94\t\tif report.CombinedActorCounts == nil {\r\n    95\t\t\treport.CombinedActorCounts = map[string]int{}\r\n    96\t\t}\r\n    97\t\tif report.TypeCounts == nil {\r\n"]
[10269.941512, "o", "    98\t\t\treport.TypeCounts = map[string]int{}\r\n    99\t\t}\r\n   100\t\r\n"]
[10269.941746, "o", "   101\t\tout, err := json.Marshal(report)\r\n   102\t\tif err != nil {\r\n   103\t\t\tfmt.Fprintln(os.Stderr, \"error: encoding aggregate report:\", err)\r\n   104\t\t\treturn 1\r\n   105\t\t}\r\n   106\t\tfmt.Println(string(out))\r\n   107\t\treturn 0\r\n   108\t}\r\n   109\t\r\n   110\tfunc topActorFromCounts(counts map[string]int) string {\r\n   111\t\tactors := make([]string, 0, len(counts))\r\n   112\t\tfor actor := range counts {\r\n   113\t\t\tactors = append(actors, actor)\r\n   114\t\t}\r\n   115\t\tsort.Strings(actors)\r\n   116\t\r\n   117\t\ttopActor := \"\"\r\n   118\t\tmaxCount := -1\r\n   119\t\tfor _, actor := range actors {\r\n   120\t\t\tcount := counts[actor]\r\n"]
