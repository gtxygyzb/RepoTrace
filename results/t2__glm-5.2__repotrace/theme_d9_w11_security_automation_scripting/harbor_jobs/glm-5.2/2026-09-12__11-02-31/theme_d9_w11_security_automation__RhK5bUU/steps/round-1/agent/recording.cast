[6062.302039, "o", "    32\tfunc (t Threat) MarshalJSON() ([]byte, error) {\r\n    33\t\tswitch t.ThreatType {\r\n    34\t\tcase \"brute_force\":\r\n    35\t\t\treturn json.Marshal(struct {\r\n    36\t\t\t\tThreatType  string   `json:\"threat_type\"`\r\n    37\t\t\t\tSourceIP    string   `json:\"source_ip\"`\r\n    38\t\t\t\tCount       int      `json:\"count\"`\r\n    39\t\t\t\tFirstSeen   string   `json:\"first_seen\"`\r\n    40\t\t\t\tLastSeen    string   `json:\"last_seen\"`\r\n    41\t\t\t\tTargetUsers []string `json:\"target_users\"`\r\n"]
