[4813.918728, "o", "drwxr-xr-x 1 root root    4096 Sep 12 04:16 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root    4096 Sep 12 04:22 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root    1047 Sep 12 03:20 analyze.go\r\n-rw-r--r-- 1 root root    4126 Sep 12 03:20 chain.go\r\n-rw-r--r-- 1 root root    8472 Sep 12 03:55 correlate.go\r\n-rw-r--r-- 1 root root   15970 Sep 12 03:55 enrich.go\r\n-rw-r--r-- 1 root root    2295 Sep 12 03:27 event.go\r\n-rw-r--r-- 1 root root    3100 Sep 12 03:27 filter.go\r\n"]
