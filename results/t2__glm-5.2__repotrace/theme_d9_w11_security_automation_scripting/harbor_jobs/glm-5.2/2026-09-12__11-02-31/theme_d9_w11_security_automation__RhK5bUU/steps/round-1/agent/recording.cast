[8413.306294, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"math\"\r\n"]
[8413.306406, "o", "     8\t\t\"os\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"time\"\r\n    11\t)\r\n    12\t\r\n    13\tconst (\r\n    14\t\twSeverity   = 0.30\r\n    15\t\twRecency    = 0.25\r\n    16\t\twRisk       = 0.25\r\n    17\t\twConfidence = 0.15\r\n    18\t\twActor      = 0.05\r\n    19\t)\r\n    20\t\r\n    21\tvar prioritySeverityRanks = map[string]int{\r\n    22\t\t\"none\":     0,\r\n"]
[8413.306489, "o", "    23\t\t\"low\":      1,\r\n    24\t\t\"medium\":   2,\r\n    25\t\t\"high\":     3,\r\n    26\t\t\"critical\": 4,\r\n    27\t}\r\n    28\t\r\n    29\ttype priorityComponents struct {\r\n    30"]
[8413.306556, "o", "\t\tSeverity   float64 `json:\"severity\"`\r\n    31\t\tRecency    float64 `json:\"recency\"`\r\n    32\t\tRisk       float64 `json:\"risk\"`\r\n    33\t\tConfidence float64 `json:\"confidence\"`\r\n    34\t\tActor      float64 `json:\"actor\"`\r\n    35\t}\r\n    36\t\r\n    37\ttype prioritizeOutput struct {\r\n    38\t\tSourceIP          string             `json:\"source_ip\"`\r\n    39\t\tThreatType        string             `json:\"threat_type\"`\r\n    40\t\tPriorityScore     float64            `json:\"priority_score\"`\r\n    41\t\tPriorityLabel     string             `json:\"priority_label\"`\r\n"]
[8413.306625, "o", "    42\t\tComponents        priorityComponents `json:\"components\"`\r\n    43\t\tEnrichedRiskScore float64            `json:\"enriched_risk_score\"`\r\n    44\t\tIOCSeverity       string             `json:\"ioc_severity\"`\r\n    45\t\tThreatActors      []string           `json:\"threat_actors\"`\r\n    46\t\tReferenceTime     string             `json:\"reference_time\"`\r\n    47\t}\r\n    48\t\r\n    49\tfunc runPrioritize(args []string) int {\r\n    50\t\tfs := newFlagSet(\"prioritize\")\r\n    51\t\trefStr := fs.String(\"reference-time\", \"\", \"reference timestamp for recency scoring (RFC3339)\")\r\n    52\t\tif !parseFlags(fs, args) {\r\n    53\t\t"]
[8413.30669, "o", "\treturn 1\r\n    54\t\t}\r\n    55\t\tif !isFlagSet(fs, \"reference-time\") || *refStr == \"\" {\r\n    56\t\t\tfmt.Fprintln(os.Stderr, \"missing --reference-time flag\")\r\n    57\t\t\treturn 1\r\n    58\t\t}\r\n    59\t\trefTime, err := parseTime(*refStr)\r\n    60\t\tif err != nil {\r\n    61\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    62\t\t\treturn 1\r\n"]
[8413.306759, "o", "    63\t\t}\r\n    64\t\r\n    65\t\tscanner := bufio.NewScanner(os.Stdin)\r\n    66\t\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n    67\t\r\n    68\t\tvar results []prioritizeOutput\r\n    69\t\tlineNo := 0\r\n    70\t\tfor scanner.Scan() {\r\n    71\t\t\tlineNo++\r\n    72\t"]
[8413.306819, "o", "\t\tline := scanner.Text()\r\n    73\t\t\tif line == \"\" {\r\n    74\t\t\t\tcontinue\r\n    75\t\t\t}\r\n    76\t\t\tvar threat map[string]interface{}\r\n    77\t\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n    78\t\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n    79\t\t\t\treturn 2\r\n    80\t\t\t}\r\n"]
[8413.306883, "o", "    81\t\t\tout, ok := prioritizeThreat(threat, refTime)\r\n    82\t\t\tif !ok {\r\n    83\t\t\t\tcontinue\r\n    84\t\t\t}\r\n    85\t\t\tresults = append(results, out)\r\n    86\t\t}\r\n    87\t\tif err := scanner.Err(); err != nil {\r\n    88\t\t\t"]
[8413.306947, "o", "fmt.Fprintln(os.Stderr, err)\r\n    89\t\t\treturn 1\r\n    90\t\t}\r\n    91\t\r\n    92\t\tsort.SliceStable(results, func(i, j int) bool {\r\n    93\t\t\tif results[i].PriorityScore != results[j].PriorityScore {\r\n    94\t\t\t\treturn results[i].PriorityScore > results[j].PriorityScore\r\n    95\t\t\t}\r\n"]
[8413.307008, "o", "    96\t\t\treturn results[i].SourceIP < results[j].SourceIP\r\n    97\t\t})\r\n    98\t\r\n    99\t\twriter := bufio.NewWriter(os.Stdout)\r\n   100\t\tdefer writer.Flush()\r\n   101\t\tfor _, r := range results {\r\n   102\t\t\tb, err := json.Marshal(r)\r\n   103\t\t\tif err != nil {\r\n   104\t\t\t\tfmt.Fprintf(os.Stderr, \"failed to encode output: %v\\n\", err)\r\n   105\t\t\t\treturn 1\r\n"]
[8413.307075, "o", "   106\t\t\t}\r\n   107\t\t\tfmt.Fprintln(writer, string(b))\r\n   108\t\t}\r\n   109\t\treturn 0\r\n   110\t}\r\n"]
[8413.307139, "o", "   111\t\r\n   112\tfunc prioritizeThreat(threat map[string]interface{}, refTime time.Time) (prioritizeOutput, bool) {\r\n   113\t\tsourceIP := getStringDefault(threat, \"source_ip\")\r\n   114\t\tthreatType := getStringDefault(threat, \"threat_type\")\r\n   115\t\r\n   116\t\teventTime := threatReferenceTime(threat)\r\n   117\t\trefStr := \"\"\r\n   118\t\tif !eventTime.IsZero() {\r\n   119\t\t\trefStr = eventTime.UTC().Format(time.RFC3339)\r\n   120\t\t}\r\n   121\t\r\n   122\t\tageMinutes := 0.0\r\n   123\t\tif !eventTime.IsZero() {\r\n   124\t\t\t"]
[8413.307201, "o", "ageMinutes = refTime.Sub(eventTime).Minutes()\r\n   125\t\t}\r\n   126\t\tif ageMinutes < 0 {\r\n   127\t\t\tageMinutes = 0\r\n   128\t\t}\r\n   129\t\trecency := math.Pow(2, -ageMinutes/60.0)\r\n   130\t\r\n   131\t\triskScore, _ := getFloat(threat, \"enriched_risk_score\")\r\n   132\t\trisk := riskScore / 500.0\r\n"]
[8413.307347, "o", "   133\t\tif risk > 1.0 {\r\n   134\t\t\trisk = 1.0\r\n   135\t\t}\r\n   136\t\tif risk < 0 {\r\n   137\t\t\trisk = 0\r\n   138\t\t}\r\n   139\t\r\n   140\t\tconfidence := 0.0\r\n   141\t\tif c, ok := getFloat(threat, \"max_ioc_confidence\"); ok {\r\n   142\t\t\tconfidence = c\r\n   143\t\t}\r\n   144\t\tif confidence < 0 {\r\n   145\t\t\tconfidence = 0\r\n   146\t\t}\r\n   147\t\tif confidence > 1 {\r\n   148\t\t\tconfidence = 1\r\n   149\t\t}\r\n   150\t\r\n   151\t\tactors := []string{}\r\n   152\t\tif a, ok := getStringSlice(threat, \"threat_actors\"); ok {\r\n   153"]
[8413.30741, "o", "\t\t\tactors = a\r\n   154\t\t}\r\n   155\t\tactor := float64(len(actors)) / 3.0\r\n   156\t\tif actor > 1.0 {\r\n   157\t\t\tactor = 1.0\r\n   158\t\t}\r\n   159\t\tif actor < 0 {\r\n   160\t"]
[8413.307483, "o", "\t\tactor = 0\r\n   161\t\t}\r\n   162\t\r\n   163\t\tseverity := getStringDefault(threat, \"ioc_severity\")\r\n   164\t\tseverityRank := prioritySeverityRanks[severity]\r\n   165\t\tseverityComponent := float64(severityRank) / 4.0\r\n   166\t\r\n   167\t\tscore := wSeverity*severityComponent +\r\n   168\t\t\twRecency*recency +\r\n"]
[8413.307549, "o", "   169\t\t\twRisk*risk +\r\n   170\t\t\twConfidence*confidence +\r\n   171\t\t\twActor*actor\r\n   172\t\r\n   173\t\tlabel := priorityLabel(score)\r\n   174\t\r\n   175\t\treturn prioritizeOutput{\r\n   176\t\t\tSourceIP:      sourceIP,\r\n   177\t\t\tThreatType:    threatType,\r\n   178\t\t\tPriorityScore: round4(score),\r\n   179\t\t\tPriorityLabel: label,\r\n"]
[8413.307616, "o", "   180\t\t\tComponents: priorityComponents{\r\n   181\t\t\t\tSeverity:   round4(severityComponent),\r\n   182\t\t\t\tRecency:    round4(recency),\r\n   183\t\t\t\tRisk:       round4(risk),\r\n   184\t\t\t\tConfidence: round4(confidence),\r\n   185\t\t\t\tActor:      round4(actor),\r\n   186\t\t\t},\r\n   187\t\t\tEnrichedRiskScore: riskScore,\r\n   188\t\t\tIOCSeverity:       severity,\r\n   189\t\t\tThreatActors:      actors,\r\n   190\t\t\tReferenceTime:     refStr,\r\n"]
[8413.307676, "o", "   191\t\t}, true\r\n   192\t}\r\n   193\t\r\n   194\tfunc priorityLabel(score float64) string {\r\n   195\t\tswitch {\r\n   196\t\tcase score >= 0.75:\r\n   197\t\t\treturn \"critical\"\r\n   198\t\tcase score >= 0.50:\r\n   199"]
[8413.307735, "o", "\t\t\treturn \"high\"\r\n   200\t\tcase score >= 0.25:\r\n   201\t\t\treturn \"medium\"\r\n   202\t\tdefault:\r\n   203\t\t\treturn \"low\"\r\n   204\t\t}\r\n   205\t}\r\n   206\t\r\n   207\tfunc round4(f float64) float64 {\r\n   208\t\treturn math.Round(f*10000) / 10000"]
[8413.307794, "o", "\r\n   209\t}\r\n"]
