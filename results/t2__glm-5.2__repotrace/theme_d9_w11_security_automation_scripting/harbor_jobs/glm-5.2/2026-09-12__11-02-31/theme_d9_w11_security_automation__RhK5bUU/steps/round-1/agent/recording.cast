[4139.211651, "o", "   520\t}\r\n   521\t\r\n   522\tfunc severityWeight(s string) int {\r\n   523\t\tswitch s {\r\n   524\t\tcase \"low\":\r\n   525\t\t\treturn 5\r\n   526\t\tcase \"medium\":\r\n   527\t\t\treturn 10\r\n   528\t\tcase \"high\":\r\n   529\t\t\treturn 20\r\n"]
[4139.211785, "o", "   530\t\tcase \"critical\":\r\n   531\t\t\treturn 40\r\n   532\t\tdefault:\r\n   533\t\t\treturn 0\r\n   534\t\t}\r\n   535\t}\r\n   536\t\r\n   537\tfunc severityFromRank(rank int) string {\r\n   538\t\tswitch rank {\r\n   539\t\tcase 1:\r\n   540\t\t\treturn \"low\"\r\n   541\t\tcase 2:\r\n   542\t\t\treturn \"medium\"\r\n   543\t\tcase 3:\r\n   544\t\t\treturn \"high\"\r\n   545\t\tcase 4:\r\n   546\t\t\treturn \"critical\"\r\n   547\t\tdefault:\r\n   548\t\t\t"]
[4139.211877, "o", "return \"none\"\r\n   549\t\t}\r\n   550\t}\r\n   551\t\r\n   552\tfunc threatReferenceTime(threat map[string]interface{}) time.Time {\r\n   553\t\tif tt, ok := getString(threat, \"threat_type\"); ok && tt == \"privilege_escalation\" {\r\n   554\t\t\tif ts, ok := getString(threat, \"timestamp\"); ok {\r\n   555\t\t\t\tif t, err := parseTime(ts); err == nil {\r\n   556\t\t\t\t\treturn t\r\n   557\t\t\t\t}\r\n   558\t\t\t}\r\n   559\t\t"]
[4139.211941, "o", "}\r\n   560\t\tif ts, ok := getString(threat, \"first_seen\"); ok {\r\n   561\t\t\tif t, err := parseTime(ts); err == nil {\r\n   562\t\t\t\treturn t\r\n   563\t\t\t}\r\n   564\t\t}\r\n   565\t\treturn time.Time{}\r\n   566\t}\r\n   567\t\r\n"]
[4139.212004, "o", "   568\tfunc sortEnrichedThreats(threats []map[string]interface{}) {\r\n   569\t\tsort.SliceStable(threats, func(i, j int) bool {\r\n   570\t\t\ta := threats[i]\r\n   571\t\t\tb := threats[j]\r\n   572\t\t\tea, _ := getFloat(a, \"enriched_risk_score\")\r\n   573\t\t\teb, _ := getFloat(b, \"enriched_risk_score\")\r\n   574\t\t\tif ea != eb {\r\n   575\t\t\t\treturn ea > eb\r\n   576\t\t\t}\r\n   577"]
[4139.212071, "o", "\t\t\tta := threatSortTime(a)\r\n   578\t\t\ttb := threatSortTime(b)\r\n   579\t\t\tif !ta.Equal(tb) {\r\n   580\t\t\t\treturn ta.Before(tb)\r\n   581\t\t\t}\r\n   582\t\t\ttta, _ := getString(a, \"threat_type\")"]
[4139.212137, "o", "\r\n   583\t\t\tttb, _ := getString(b, \"threat_type\")\r\n   584\t\t\treturn tta < ttb\r\n   585\t\t})\r\n   586\t}\r\n   587\t\r\n   588\tfunc threatSortTime(threat map[string]interface{}) time.Time {\r\n   589\t\tif tt, ok := getString(threat, \"threat_type\"); ok && tt == \"privilege_escalation\" {\r\n   590\t\t\tif ts, ok := getString(threat, \"timestamp\"); ok {\r\n   591\t\t\t\tif t, err := parseTime(ts); err == nil {\r\n   592\t\t\t\t\treturn t\r\n   593\t\t\t\t}\r\n   594\t\t\t}\r\n"]
[4139.212203, "o", "   595\t\t}\r\n   596\t\tif ts, ok := getString(threat, \"first_seen\"); ok {\r\n   597\t\t\tif t, err := parseTime(ts); err == nil {\r\n   598\t\t\t\treturn t\r\n   599\t\t\t}\r\n   600\t\t}\r\n   601\t\treturn time.Time{}\r\n   602\t}\r\n   603\t\r\n   604\tfunc getString(m map[string]interface{}, key string) (string, bool) {\r\n   605\t"]
[4139.212289, "o", "\tv, ok := m[key]\r\n   606\t\tif !ok {\r\n   607\t\t\treturn \"\", false\r\n   608\t\t}\r\n   609\t\ts, ok := v.(string)\r\n   610\t\treturn s, ok\r\n   611\t}\r\n   612\t\r\n   613\tfunc getStringSlice(m map[string]interface{}, key string) ([]string, bool) {\r\n   614\t\tv, ok := m[key]\r\n   615\t\tif !ok {\r\n   616"]
