[6102.353882, "o", "    19\t\tEventType   string            `json:\"event_type\"`\r\n    20\t\tUser        string            `json:\"user\"`\r\n    21\t\tSeverity    string            `json:\"severity\"`\r\n    22\t\tPayloadSize int64             `json:\"payload_size\"`\r\n    23\t\tMetadata    map[string]string `json:\"metadata\"`\r\n    24\t}\r\n    25\t\r\n    26\tvar severityMap = map[string]int{\r\n    27\t\t\"low\":      1,\r\n    28\t\t\"medium\":   2,\r\n    29\t\t\"high\":     3,\r\n    30\t\t\"critical\": 4,\r\n    31\t}\r\n    32\t\r\n    33\tfunc severityValue(s string) int {\r\n    34\t\treturn severityMap[s]\r\n    35\t}\r\n    36\t\r\n    37\tfunc parseEvent(line string) (Event, error) {\r\n    38\t\tvar e Event\r\n    39\t\tif err := json.Unmarshal([]byte(line), &e); err != nil {\r\n    40\t\t\treturn e, err\r\n    41\t\t}\r\n    42\t\treturn e, nil\r\n    43\t}\r\n    44\t\r\n    45\tfunc parseTime(ts string) (time.Time, error) {\r\n    46\t\tt, err := time.Parse(time.RFC3339, ts)\r\n    47\t\tif err != nil {\r\n    48\t\t\treturn time.Time{}, fmt.Errorf(\"invalid timestamp %q: %w\", ts, err)\r\n    49\t\t}\r\n    50\t\treturn t, nil\r\n    51\t}\r\n"]
[6102.353975, "o", "    52\t\r\n    53\tfunc readEvents() ([]Event, error) {\r\n    54\t\tscanner := bufio.NewScanner(os.Stdin)\r\n    55\t\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n    56\t\tvar events []Event\r\n    57\t\tlineNo := 0\r\n    58\t\tfor scanner.Scan() {\r\n    59\t\t\tlineNo++\r\n"]
