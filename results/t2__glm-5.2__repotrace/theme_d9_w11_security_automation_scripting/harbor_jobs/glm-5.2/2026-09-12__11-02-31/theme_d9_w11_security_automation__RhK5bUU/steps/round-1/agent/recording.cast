[7280.625058, "o", "\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KtimelineSeverityRank(sev string) int {\r\n\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[Ktimeline\u001b[01;31m\u001b[KEscalation\u001b[m\u001b[KIndex(threats []map[string]interface{}) float64 {\r\n\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\trankI := timelineSeverityRank(getStringDefault(ordered[i], \"ioc_\u001b[01;31m\u001b[Kseverity\u001b[m\u001b[K\"))\r\n"]
