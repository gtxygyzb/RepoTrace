[4845.959731, "o", "     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"sort\"\r\n     9\t\t\"time\"\r\n    10\t)\r\n    11\t\r\n    12\ttype correlateThreat struct {\r\n    13\t\tobj        map[string]interface{}\r\n    14\t\tref        time.Time\r\n    15\t\tactors     []string\r\n    16\t\trisk       float64\r\n    17\t\tthreatType string\r\n"]
[4845.959808, "o", "    18\t\tseverity   string\r\n    19\t}\r\n    20\t\r\n    21\ttype correlateCampaign struct {\r\n    22\t\tCampaignID       string                   `json:\"campaign_id\"`\r\n    23\t\tThreatCount      int                      `json:\"threat_count\"`\r\n    24\t\tThreatTypes      []string                 `json:\"threat_types\"`\r\n    25\t\tSharedActors     []string                 `json:\"shared_actors\"`\r\n"]
[4845.959872, "o", "    26\t\tAllActors        []string                 `json:\"all_actors\"`\r\n    27\t\tCombinedRisk     float64                  `json:\"combined_risk\"`\r\n    28\t\tDirectLinkCount  int                      `json:\"direct_link_count\"`\r\n    29\t\tCohesion         float64                  `json:\"cohesion\"`\r\n    30\t\tPropagationScore float64                  `json:\"propagation_score\"`\r\n    31\t\tMaxSeverity      string                   `json:\"max_severity\"`\r\n    32\t\tTimeSpanMinutes  float64                  `json:\"time_span_minutes\"`\r\n    33\t\tEarliest         string                   `json:\"earliest\"`\r\n    34\t\tLatest           string                   `json:\"latest\"`\r\n    35\t\tThreats          []map[string]interface{} `json:\"threats\"`\r\n    36\t\r\n    37\t\tearliestTime  time.Time\r\n    38\t\tminThreatType string\r\n"]
[4845.959942, "o", "    39\t}\r\n    40\t\r\n    41\tfunc runCorrelate(args []string) int {\r\n    42\t\tfs := newFlagSet(\"correlate\")\r\n    43\t\ttimeWindow := fs.Int(\"time-window\", 0, \"maximum temporal distance in minutes for two threats to be linkable\")\r\n    44\t\tminCampaignSize := fs.Int(\"min-campaign-size\", 2, \"minimum number of threats in a campaign to output\")\r\n    45\t\tif !parseFlags(fs, args) {\r\n    46\t\t\treturn 1\r\n    47\t\t}\r\n    48\t\tif !isFlagSet(fs, \"time-window\") {\r\n    49\t\t\tfmt.Fprintln(os.Stderr, \"error: --time-window flag is required\")\r\n"]
[4845.960002, "o", "    50\t\t\treturn 1\r\n    51\t\t}\r\n    52\t\r\n    53\t\twindow := time.Duration(*timeWindow) * time.Minute\r\n    54\t\r\n    55\t\tscanner := bufio.NewScanner(os.Stdin)\r\n    56\t\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n    57\t\tthreats := make([]correlateThreat, 0)\r\n    58\t\tlineNo := 0\r\n"]
[4845.960062, "o", "    59\t\tfor scanner.Scan() {\r\n    60\t\t\tlineNo++\r\n    61\t\t\tline := scanner.Text()\r\n    62\t\t\tif line == \"\" {\r\n    63\t\t\t\tcontinue\r\n    64\t\t\t}\r\n    65\t\t\tvar obj map[string]interface{}\r\n"]
[4845.960128, "o", "    66\t\t\tif err := json.Unmarshal([]byte(line), &obj); err != nil {\r\n    67\t\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n    68\t\t\t\treturn 2\r\n    69\t\t\t}\r\n    70\t\t\tct := correlateThreat{\r\n    71\t\t\t\tobj: obj,\r\n    72\t\t\t\tref: threatReferenceTime(obj),\r\n    73\t\t\t}\r\n    74\t\t\tif actors, ok := getStringSlice(obj, \"threat_actors\"); ok {\r\n    75\t\t\t\tct.actors = actors\r\n"]
