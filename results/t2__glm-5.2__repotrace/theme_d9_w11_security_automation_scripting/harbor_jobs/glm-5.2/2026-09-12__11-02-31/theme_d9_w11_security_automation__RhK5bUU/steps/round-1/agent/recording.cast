[2867.72685, "o", "   440\tfunc computeFreshness(p processedIOC, refTime time.Time) (float64, float64, bool) {\r\n   441\t\tageHours := refTime.Sub(p.lastUpdated).Hours()\r\n   442\t\tfreshnessFraction := ageHours / float64(p.ttlHours)\r\n   443\t\tif freshnessFraction >= 1.0 {\r\n   444\t\t\t"]
[2867.72692, "o", "return 0, 0, false\r\n   445\t\t}\r\n   446\t\tfactor := freshnessFactor(freshnessFraction)\r\n   447\t\treturn p.entry.Confidence * factor, factor, true\r\n   448\t}\r\n   449\t\r\n   450\tfunc freshnessFactor(fraction float64) float64 {\r\n   451\t\tswitch {\r\n   452\t\tcase fraction < 0.25:\r\n   453\t\t\treturn 1.0\r\n"]
[2867.726985, "o", "   454\t\tcase fraction < 0.50:\r\n   455\t\t\treturn 0.9\r\n   456\t\tcase fraction < 0.75:\r\n   457\t\t\treturn 0.7\r\n   458\t\tdefault:\r\n   459\t\t\treturn 0.5\r\n   460\t\t}\r\n   461\t}\r\n   462\t\r\n   463\tfunc fieldMultiplier(field string) float64 {\r\n   464\t\tswitch field {\r\n"]
[2867.72703, "o", "   465\t\tcase \"source_ip\", \"dest_ip\", \"compromised_hosts\", \"user\":\r\n   466\t\t\treturn 1.0\r\n   467\t\tcase \"dest_ips\", \"target_users\":\r\n   468\t\t\treturn 0.8\r\n   469\t\tcase \"ports_scanned\":\r\n   470\t\t\treturn 0.6\r\n   471\t\tdefault:\r\n"]
[2867.727071, "o", "   472\t\t\treturn 0.0\r\n   473\t\t}\r\n   474\t}\r\n   475\t\r\n   476\tfunc maxFieldMultiplier(fields []string) float64 {\r\n"]
[2867.727112, "o", "   477\t\tmax := 0.0\r\n   478\t\tfor _, f := range fields {\r\n   479\t\t\tif m := fieldMultiplier(f); m > max {\r\n   480\t\t\t\tmax = m\r\n   481\t\t\t}\r\n   482\t\t}\r\n"]
[2867.727153, "o", "   483\t\treturn max\r\n   484\t}\r\n   485\t\r\n   486\tfunc tagBonusValue(tag string) float64 {\r\n   487\t\tswitch tag {\r\n   488\t\tcase \"apt\":\r\n   489"]
[2867.727197, "o", "\t\t\treturn 100.0\r\n   490\t\tcase \"ransomware\":\r\n   491\t\t\treturn 75.0\r\n   492\t\tcase \"botnet\":\r\n   493\t\t\treturn 50.0\r\n   494\t\tcase \"phishing\":\r\n"]
[2867.727284, "o", "   495\t\t\treturn 30.0\r\n   496\t\tcase \"scanner\":\r\n   497\t\t\treturn 25.0\r\n   498\t\tcase \"cryptominer\":\r\n   499\t\t\treturn 20.0\r\n"]
[2867.72734, "o", "   500\t\tdefault:\r\n   501\t\t\treturn 0.0\r\n   502\t\t}\r\n   503\t}\r\n   504\t\r\n   505\tfunc severityWeight(s string) int {\r\n"]
[2867.727408, "o", "   506\t\tswitch s {\r\n   507\t\tcase \"low\":\r\n   508\t\t\treturn 5\r\n   509\t\tcase \"medium\":\r\n   510\t\t\treturn 10\r\n   511\t\tcase \"high\":\r\n   512\t\t\treturn 20\r\n   513\t\tcase \"critical\":\r\n   514\t\t\treturn 40\r\n   515\t\tdefault:\r\n   516\t\t\treturn 0"]
[2867.727473, "o", "\r\n   517\t\t}\r\n   518\t}\r\n   519\t\r\n   520\tfunc severityFromRank(rank int) string {\r\n   521\t\tswitch rank {\r\n   522\t\tcase 1:\r\n   523\t\t\treturn \"low\"\r\n   524\t\tcase 2:\r\n   525\t\t\treturn \"medium\"\r\n   526\t\tcase 3:\r\n"]
[2867.727539, "o", "   527\t\t\treturn \"high\"\r\n   528\t\tcase 4:\r\n   529\t\t\treturn \"critical\"\r\n   530\t\tdefault:\r\n   531\t\t\treturn \"none\"\r\n   532\t\t}\r\n   533\t}\r\n   534\t\r\n   535\tfunc threatReferenceTime(threat map[string]interface{}) time.Time {\r\n"]
[2867.727606, "o", "   536\t\tif tt, ok := getString(threat, \"threat_type\"); ok && tt == \"privilege_escalation\" {\r\n   537\t\t\tif ts, ok := getString(threat, \"timestamp\"); ok {\r\n   538\t\t\t\tif t, err := parseTime(ts); err == nil {\r\n   539\t\t\t\t\treturn t\r\n   540\t\t\t\t}\r\n   541\t\t\t}\r\n   542\t\t}"]
[2867.727662, "o", "\r\n   543\t\tif ts, ok := getString(threat, \"first_seen\"); ok {\r\n   544\t\t\tif t, err := parseTime(ts); err == nil {\r\n   545\t\t\t\treturn t\r\n   546\t\t\t}\r\n   547\t\t}\r\n   548\t\treturn time.Time{}\r\n   549\t}\r\n"]
[2867.727729, "o", "   550\t\r\n   551\tfunc sortEnrichedThreats(threats []map[string]interface{}) {\r\n   552\t\tsort.SliceStable(threats, func(i, j int) bool {\r\n   553\t\t\ta := threats[i]\r\n   554\t\t\tb := threats[j]\r\n   555\t\t\tea, _ := getFloat(a, \"enriched_risk_score\")\r\n   556\t\t\teb, _ := getFloat(b, \"enriched_risk_score\")\r\n   557\t\t\tif ea != eb {\r\n   558\t\t\t\treturn ea > eb\r\n"]
[2867.727782, "o", "   559\t\t\t}\r\n   560\t\t\tta := threatSortTime(a)\r\n"]
