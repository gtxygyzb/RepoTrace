[6082.234914, "o", "   153\t\t}\r\n   154\t\treturn processed, nil\r\n   155\t}\r\n   156\t\r\n   157\tfunc processIOC(e iocEntry) (processedIOC, bool) {\r\n   158\t\tp := processedIOC{entry: e, ttlHours: e.TTLHours}\r\n   159\t\tif p.ttlHours <= 0 {\r\n   160\t\t\treturn p, false\r\n   161\t\t}\r\n   162\t\tt, err := parseTime(e.LastUpdated)\r\n   163\t\tif err != nil {\r\n   164\t\t\treturn p, false\r\n   165\t\t}\r\n   166\t\tp.lastUpdated = t\r\n"]
