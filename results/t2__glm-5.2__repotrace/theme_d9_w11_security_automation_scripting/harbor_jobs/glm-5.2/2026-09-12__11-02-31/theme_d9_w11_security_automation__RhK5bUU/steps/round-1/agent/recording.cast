[11607.32495, "o", "    66\t\r\n    67\t\trisks := make([]float64, len(snapshots))\r\n    68\t\tthreats := make([]float64, len(snapshots))\r\n    69\t\tfor i, snap := range snapshots {\r\n    70\t\t\trisks[i] = snap.GlobalMeanRisk\r\n    71\t\t\tthreats[i] = float64(snap.TotalThreats)\r\n    72\t\t}\r\n    73\t\r\n    74\t\triskSlope, riskIntercept := olsLine(0, risks)\r\n    75\t\tthreatSlope, threatIntercept := olsLine(0, threats)\r\n    76\t\r\n    77\t"]
[11607.325009, "o", "\triskPredictions := predictLine(riskSlope, riskIntercept, len(snapshots), *steps)\r\n    78\t\tthreatPredictions := predictLine(threatSlope, threatIntercept, len(snapshots), *steps)\r\n    79\t\r\n    80\t\triskTrend := trendFromSlope(riskSlope)\r\n    81\t\tthreatTrend := trendFromSlope(threatSlope)\r\n    82\t\r\n    83\t\tlast := snapshots[len(snapshots)-1]\r\n    84\t\tmetrics := map[string]forecastMetricResult{\r\n    85\t\t\t\"global_mean_risk\": {\r\n    86"]
[11607.325073, "o", "\t\t\t\tSlope:       json.Number(format4(riskSlope)),\r\n    87\t\t\t\tIntercept:   json.Number(format4(riskIntercept)),\r\n    88\t\t\t\tTrend:       riskTrend,\r\n    89\t\t\t\tLastValue:   json.Number(formatRiskValue(last.GlobalMeanRisk)),\r\n    90\t\t\t\tPredictions: roundAll4(riskPredictions),\r\n    91\t\t\t},\r\n"]
[11607.325138, "o", "    92\t\t\t\"total_threats\": {\r\n    93\t\t\t\tSlope:       json.Number(format4(threatSlope)),\r\n    94\t\t\t\tIntercept:   json.Number(format4(threatIntercept)),\r\n    95\t\t\t\tTrend:       threatTrend,\r\n    96\t\t\t\tLastValue:   json.Number(strconv.Itoa(last.TotalThreats)),\r\n    97\t\t\t\tPredictions: roundAll4(threatPredictions),\r\n    98\t\t\t},\r\n    99\t\t}\r\n   100\t\r\n   101\t\tout := forecastOutput{\r\n   102\t\t\tInputCount:   len(snapshots),\r\n   103\t\t\tMetrics:      metrics,\r\n   104\t\t\tOverallTrend: overallTrend(riskTrend, threatTrend),\r\n   105\t\t\tAlertLevel:   alertLevelFromSlopes(risks, threats, riskSlope, threatSlope),\r\n   106\t"]
[11607.325202, "o", "\t}\r\n   107\t\r\n   108\t\tencoded, err := json.Marshal(out)\r\n   109\t\tif err != nil {\r\n   110\t\t\tfmt.Fprintln(os.Stderr, \"error: encoding forecast output:\", err)\r\n   111\t\t\treturn 1\r\n   112\t\t}\r\n"]
