[10915.61894, "o", "func isFlagSet(fs *flag.FlagSet, name string) bool {\r\n\tset := false\r\n\tfs.Visit(func(f *flag.Flag) {\r\n\t\tif f.Name == name {\r\n\t\t\tset = true\r\n\t\t}\r\n\t})\r\n\treturn set\r\n}\r\n"]
