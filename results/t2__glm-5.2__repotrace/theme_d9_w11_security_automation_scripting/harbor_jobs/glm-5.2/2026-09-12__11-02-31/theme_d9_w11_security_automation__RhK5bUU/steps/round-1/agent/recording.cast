[10481.083925, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n"]
[10481.084018, "o", "\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n)\r\n\r\n"]
[10481.084084, "o", "type forecastInputSnapshot struct {\r\n\tGlobalMeanRisk float64 `json:\"global_mean_risk\"`\r\n\tTotalThreats   int     `json:\"total_threats\"`\r\n}\r\n\r\ntype forecastMetricResult struct {\r\n\tSlope       float64     `json:\"slope\"`\r\n\tIntercept   float64     `json:\"intercept\"`\r\n\tTrend       string      `json:\"trend\"`\r\n\tLastValue   interface{} `json:\"last_value\"`\r\n\tPredictions []float64   `json:\"predictions\"`\r\n}\r\n\r\ntype forecastOutput struct {\r\n\tInputCount   int                             `json:\"input_count\"`\r\n\tMetrics      map[string]forecastMetricResult `json:\"metrics\"`\r\n\tOverallTrend string                          `json:\"overall_trend\"`\r\n\tAlertLevel   string                          `json:\"alert_level\"`\r\n}\r\n\r\nfunc runForecast(args []string) int {\r\n\tfs := newFlagSet(\"forecast\")\r\n"]
[10481.084156, "o", "\tsteps := fs.Int(\"steps\", 3, \"number of future steps to predict\")\r\n\tif !parseFlags(fs, args) {\r\n\t\treturn 1\r\n\t}\r\n\tif *steps < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --steps must be at least 1\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\tvar snapshots []forecastInputSnapshot\r\n\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n\tfor scanner.Scan() {\r\n\t\t"]
[10481.08425, "o", "line := scanner.Text()\r\n\t\tif len(line) == 0 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvar snap forecastInputSnapshot\r\n\t\tif err := json.Unmarshal([]byte(line), &snap); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: malformed JSON input: %s\\n\", err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tsnapshots = append(snapshots, snap)\r\n\t}\r\n\tif err := scanner.Err(); err != nil {\r\n"]
[10481.084313, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: reading input: %s\\n\", err)\r\n\t\treturn 1\r\n\t}\r\n\tif len(snapshots) < 3 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: at least 3 valid input snapshots are required\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\trisks := make([]float64, len(snapshots))\r\n\tthreats := make([]float64, len(snapshots))\r\n\tfor i, snap := range snapshots {\r\n\t\trisks[i] = snap.GlobalMeanRisk\r\n"]
[10481.084372, "o", "\t\tthreats[i] = float64(snap.TotalThreats)\r\n\t}\r\n\r\n\triskSlope, riskIntercept := olsLine(0, risks)\r\n\tthreatSlope, threatIntercept := olsLine(0, threats)\r\n\r\n\triskPredictions := predictLine(riskSlope, riskIntercept, len(snapshots), *steps)\r\n\tthreatPredictions := predictLine(threatSlope, threatIntercept, len(snapshots), *steps)\r\n\r\n\triskTrend := trendFromSlope(riskSlope)\r\n"]
[10481.084438, "o", "\tthreatTrend := trendFromSlope(threatSlope)\r\n"]
[10481.08493, "o", "\u001b[?2004h"]
[10481.084988, "o", "root@n30009:/app# "]
[10489.756932, "i", "printf '{\"global_mean_risk\":10.0,\"total_threats\":1}\\n{\"global_mean_risk\":20.0,\"total_threats\":2}\\n{\"global_mean_risk\":30.0,\"total_threats\":3}\\n{\"global_mean_risk\":40.0,\"total_threats\":4}\\n' | ./secsentinel anomaly --window 2 --threshold 1\n"]
[10489.758505, "o", "printf '{\"global_mean_risk\":10.0,\"total_threats\":1}\\n{\"global_mean_risk\":20.0,\"total_threats\":2}\\n{\"global_mean_risk\":30.0,\"total_threats\":3}\\n{\"global_mean_risk\":40.0,\"total_threats\":4}\\n' | ./secsentinel anomaly --window 2 --threshold 1\r\n\u001b[?2004l\r"]
[10489.766747, "o", "{\"index\":2,\"metrics\":{\"global_mean_risk\":{\"value\":30.0,\"baseline_mean\":15.0000,\"baseline_stddev\":5.0000,\"z_score\":3.0000},\"total_threats\":{\"value\":3,\"baseline_mean\":1.5000,\"baseline_stddev\":0.5000,\"z_score\":3.0000}},\"combined_z\":4.2426,\"baseline_count\":2,\"direction\":\"above\",\"severity\":\"extreme\"}\r\n{\"index\":3,\"metrics\":{\"global_mean_risk\":{\"value\":40.0,\"baseline_mean\":25.0000,\"baseline_stddev\":5.0000,\"z_score\":3.0000},\"total_threats\":{\"value\":4,\"baseline_mean\":2.5000,\"baseline_stddev\":0.5000,\"z_score\":3.0000}},\"combined_z\":4.2426,\"baseline_count\":2,\"direction\":\"above\",\"severity\":\"extreme\"}\r\n"]
