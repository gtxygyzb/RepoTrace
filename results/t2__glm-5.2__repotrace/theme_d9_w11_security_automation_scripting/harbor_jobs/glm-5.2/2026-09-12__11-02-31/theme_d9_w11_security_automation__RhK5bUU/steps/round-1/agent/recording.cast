[7466.350167, "o", "\t\"time\"\r\n    11\t)\r\n    12\t\r\n    13\ttype timelineBucket struct {\r\n    14\t\tBucketStart       string                   `json:\"bucket_start\"`\r\n    15\t\tBucketEnd         string                   `json:\"bucket_end\"`\r\n    16\t\tThreatCount       int                      `json:\"threat_count\"`\r\n    17\t\tAvgRisk           float64                  `json:\"avg_risk\"`\r\n    18\t\tMaxRisk           float64                  `json:\"max_risk\"`\r\n    19\t\tMinRisk           float64                  `json:\"min_risk\"`\r\n    20\t\tRiskStdDev        float64                  `json:\"risk_std_dev\"`\r\n    21\t\tDominantType      string                   `json:\"dominant_type\"`\r\n    22\t\tTypeDistribution  map[string]int           `json:\"type_distribution\"`\r\n    23\t\tUniqueActors      []string                 `json:\"unique_actors\"`\r\n    24\t\tSeverityHistogram map[string]int           `json:\"severity_histogram\"`\r\n"]
[7466.350273, "o", "    25\t\tEscalationIndex   float64                  `json:\"escalation_index\"`\r\n    26\t\tRiskTrend         float64                  `json:\"risk_trend\"`\r\n    27\t\tBurstScore        float64                  `json:\"burst_score\"`\r\n    28\t\tTopThreats        []map[string]interface{} `json:\"top_threats\"`\r\n"]
[7466.350344, "o", "    29\t}\r\n    30\t\r\n    31\tfunc runTimeline(args []string) int {\r\n    32\t\tfs := newFlagSet(\"timeline\")\r\n    33\t\tbucketMinutes := fs.Int(\"bucket-minutes\", 0, \"width of each time bucket in minutes\")\r\n    34\t\ttopN := fs.Int(\"top-n\", 3, \"maximum number of top threats to include per bucket\")\r\n    35\t\tif !parseFlags(fs, args) {\r\n    36\t\t\treturn 1\r\n    37\t\t}\r\n    38\t\tif !isFlagSet(fs, \"bucket-minutes\") {\r\n    39\t\t\tfmt.Fprintln(os.Stderr, \"missing required flag: --bucket-minutes\")\r\n    40\t\t\treturn 1\r\n    41\t\t}\r\n    42\t\tif *bucketMinutes <= 0 {\r\n    43\t\t\tfmt.Fprintf(os.Stderr, \"invalid --bucket-minutes: must be a positive integer\\n\")\r\n    44\t"]
[7466.350405, "o", "\t\treturn 1\r\n    45\t\t}\r\n    46\t\tif *topN < 0 {\r\n    47\t\t\tfmt.Fprintf(os.Stderr, \"invalid --top-n: must be non-negative\\n\")\r\n    48\t\t\treturn 1\r\n    49\t\t}\r\n    50\t\r\n    51\t"]
[7466.350471, "o", "\tscanner := bufio.NewScanner(os.Stdin)\r\n    52\t\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n    53\t\tlineNo := 0\r\n    54\t\tvar threats []map[string]interface{}\r\n    55\t\tfor scanner.Scan() {\r\n    56\t\t\tlineNo++\r\n    57\t\t\tline := scanner.Text()\r\n    58\t\t\tif line == \"\" {\r\n    59\t\t\t\tcontinue\r\n"]
[7466.350533, "o", "    60\t\t\t}\r\n    61\t\t\tvar threat map[string]interface{}\r\n    62\t\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n    63\t\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n    64\t\t\t\treturn 2\r\n    65\t\t\t}\r\n    66\t\t\tthreats = append(threats, threat)\r\n    67\t\t}\r\n    68\t\tif err := scanner.Err(); err != nil {\r\n"]
[7466.350597, "o", "    69\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    70\t\t\treturn 2\r\n    71\t\t}\r\n    72\t\r\n    73\t\tbucketSeconds := int64(*bucketMinutes) * 60\r\n"]
[7466.350664, "o", "    74\t\tbuckets := make(map[int64][]map[string]interface{})\r\n    75\t\tvar bucketStarts []int64\r\n    76\t\tfor _, threat := range threats {\r\n    77\t\t\trefTime := threatSortTime(threat)\r\n    78\t\t\tvar refUnix int64\r\n    79\t\t\tif !refTime.IsZero() {\r\n    80\t\t\t\trefUnix = refTime.Unix()\r\n    81\t\t\t}\r\n    82\t\t\tstart := refUnix - ((refUnix%bucketSeconds)+bucketSeconds)%bucketSeconds\r\n"]
[7466.35073, "o", "    83\t\t\tif _, ok := buckets[start]; !ok {\r\n    84\t\t\t\tbucketStarts = append(bucketStarts, start)\r\n    85\t\t\t}\r\n    86\t\t\tbuckets[start] = append(buckets[start], threat)\r\n    87\t\t}\r\n    88\t\r\n    89\t\tsort.Slice(bucketStarts, func(i, j int) bool { return bucketStarts[i] < bucketStarts[j] })\r\n    90\t\r\n    91\t\twriter := bufio.NewWriter(os.Stdout)\r\n    92\t\tdefer writer.Flush()\r\n    93\t\r\n"]
[7466.350794, "o", "    94\t\tfor _, start := range bucketStarts {\r\n    95\t\t\tbucketThreats := buckets[start]\r\n    96\t\t\tstartTime := time.Unix(start, 0).UTC()\r\n    97\t\t\tendTime := startTime.Add(time.Duration(*bucketMinutes) * time.Minute)\r\n    98\t\t\tb := buildTimelineBucket(bucketThreats, startTime, endTime, *bucketMinutes, *topN)\r\n    99\t\t\tdata, err := json.Marshal(b)\r\n   100\t\t\tif err != nil {\r\n   101\t\t\t\tfmt.Fprintf(os.Stderr, \"error marshalling bucket: %v\\n\", err)\r\n   102\t\t\t\treturn 2\r\n   103\t\t\t}\r\n   104\t\t\twriter.Write(data)\r\n"]
[7466.350857, "o", "   105\t\t\twriter.WriteByte('\\n')\r\n   106\t\t}\r\n   107\t\r\n   108\t\treturn 0\r\n   109\t}\r\n   110\t\r\n   111\tfunc buildTimelineBucket(threats []map[string]interface{}, startTime time.Time, endTime time.Time, bucketMinutes int, topN int) timelineBucket {\r\n   112\t\tn := len(threats)\r\n   113\t\tb := timelineBucket{\r\n"]
[7466.350915, "o", "   114\t\t\tBucketStart:       startTime.Format(time.RFC3339),\r\n   115\t\t\tBucketEnd:         endTime.Format(time.RFC3339),\r\n   116\t\t\tThreatCount:       n,\r\n   117\t\t\tTypeDistribution:  map[string]int{},\r\n   118\t\t\tSeverityHistogram: map[string]int{\"none\": 0, \"low\": 0, \"medium\": 0, \"high\": 0, \"critical\": 0},\r\n   119\t\t\tUniqueActors:      []string{},\r\n   120\t\t\tTopThreats:        []map[string]interface{}{},\r\n"]
