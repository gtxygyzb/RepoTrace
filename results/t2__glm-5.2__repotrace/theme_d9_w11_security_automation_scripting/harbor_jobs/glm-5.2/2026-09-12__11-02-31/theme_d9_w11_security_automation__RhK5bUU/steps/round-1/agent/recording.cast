[4826.21188, "o", "\t\r\n   250\t\tearliest := threats[indices[0]].ref\r\n   251\t\tlatest := earliest\r\n   252\t\tfor _, idx := range indices[1:] {\r\n   253\t\t\tif threats[idx].ref.Before(earliest) {\r\n   254\t\t\t\tearliest = threats[idx].ref\r\n   255\t\t\t}\r\n   256\t\t\tif threats[idx].ref.After(latest) {\r\n   257\t\t\t\tlatest = threats[idx].ref\r\n   258\t\t\t}\r\n   259\t\t}\r\n   260\t\tc.earliestTime = earliest\r\n"]
