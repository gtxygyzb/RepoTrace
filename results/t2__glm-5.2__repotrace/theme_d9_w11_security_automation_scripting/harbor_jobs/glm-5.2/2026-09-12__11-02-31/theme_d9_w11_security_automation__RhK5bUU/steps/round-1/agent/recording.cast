[7740.884398, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n"]
[7740.884487, "o", "\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\ntype Threat struct {\r\n\tThreatType       string\r\n\tSourceIP         string\r\n\tDestIP           string\r\n\tCount            int\r\n\tFirstSeen        string\r\n\tLastSeen         string\r\n\tTargetUsers      []string\r\n\tRiskScore        float64\r\n\tPortsScanned     []int\r\n\tTotalBytes       int64\r\n\tDestIPs          []string\r\n\tUser             string\r\n\tTimestamp        string\r\n"]
[7740.884567, "o", "\tPriorFailures    int\r\n\tCompromisedHosts []string\r\n\tQueryCount       int\r\n\tAvgPayload       float64\r\n\r\n\tfirstTime time.Time\r\n\tlastTime  time.Time\r\n}\r\n\r\nfunc (t Threat) MarshalJSON() ([]byte, error) {\r\n\tswitch t.ThreatType {\r\n\tcase \"brute_force\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType  string   `json:\"threat_type\"`"]
[7740.884633, "o", "\r\n\t\t\tSourceIP    string   `json:\"source_ip\"`\r\n\t\t\tCount       int      `json:\"count\"`\r\n\t\t\tFirstSeen   string   `json:\"first_seen\"`\r\n\t\t\tLastSeen    string   `json:\"last_seen\"`\r\n\t\t\tTargetUsers []string `json:\"target_users\"`\r\n\t\t\tRiskScore   float64  `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType:  t.ThreatType,"]
[7740.884693, "o", "\r\n\t\t\tSourceIP:    t.SourceIP,\r\n\t\t\tCount:       t.Count,\r\n\t\t\tFirstSeen:   t.FirstSeen,\r\n\t\t\tLastSeen:    t.LastSeen,\r\n\t\t\tTargetUsers: nonNilStrings(t.TargetUsers),\r\n\t\t\tRiskScore:   t.RiskScore,\r\n\t\t})\r\n\tcase \"port_scan\":\r\n\t\t"]
[7740.884758, "o", "return json.Marshal(struct {\r\n\t\t\tThreatType   string  `json:\"threat_type\"`\r\n\t\t\tSourceIP     string  `json:\"source_ip\"`\r\n\t\t\tDestIP       string  `json:\"dest_ip\"`\r\n\t\t\tPortsScanned []int   `json:\"ports_scanned\"`\r\n\t\t\tFirstSeen    string  `json:\"first_seen\"`\r\n\t\t\tLastSeen     string  `json:\"last_seen\"`\r\n\t\t\tRiskScore    float64 `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType:   t.ThreatType,\r\n"]
[7740.884822, "o", "\t\t\tSourceIP:     t.SourceIP,\r\n\t\t\tDestIP:       t.DestIP,\r\n\t\t\tPortsScanned: nonNilInts(t.PortsScanned),\r\n\t\t\tFirstSeen:    t.FirstSeen,\r\n\t\t\tLastSeen:     t.LastSeen,\r\n\t\t\tRiskScore:    t.RiskScore,\r\n\t\t})\r\n\tcase \"data_exfiltration\":\r\n\t\t"]
[7740.884886, "o", "return json.Marshal(struct {\r\n\t\t\tThreatType string   `json:\"threat_type\"`\r\n\t\t\tSourceIP   string   `json:\"source_ip\"`\r\n\t\t\tTotalBytes int64    `json:\"total_bytes\"`\r\n\t\t\tFirstSeen  string   `json:\"first_seen\"`\r\n\t\t\tLastSeen   string   `json:\"last_seen\"`\r\n\t\t\tDestIPs    []string `json:\"dest_ips\"`\r\n\t\t\tRiskScore  float64  `json:\"risk_score\"`\r\n\t"]
[7740.884947, "o", "\t}{\r\n\t\t\tThreatType: t.ThreatType,\r\n\t\t\tSourceIP:   t.SourceIP,\r\n\t\t\tTotalBytes: t.TotalBytes,\r\n\t\t\tFirstSeen:  t.FirstSeen,\r\n\t\t\tLastSeen:   t.LastSeen,\r\n\t\t\tDestIPs:    nonNilStrings(t.DestIPs),\r\n\t\t\tRiskScore:  t.RiskScore,\r\n"]
[7740.885008, "o", "\t\t})\r\n\tcase \"privilege_escalation\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType    string  `json:\"threat_type\"`\r\n\t\t\tUser          string  `json:\"user\"`\r\n\t\t\tSourceIP      string  `json:\"source_ip\"`\r\n\t\t\tTimestamp     string  `json:\"timestamp\"`\r\n\t\t\tPriorFailures int     `json:\"prior_failures\"`\r\n\t\t\tRiskScore     float64 `json:\"risk_score\"`\r\n"]
[7740.885079, "o", "\t\t}{\r\n\t\t\tThreatType:    t.ThreatType,\r\n\t\t\tUser:          t.User,\r\n\t\t\tSourceIP:      t.SourceIP,\r\n\t\t\tTimestamp:     t.Timestamp,\r\n\t\t\tPriorFailures: t.PriorFailures,\r\n\t\t\tRiskScore:     t.RiskScore,\r\n\t\t})\r\n\tcase \"lateral_movement\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType       string   `json:\"threat_type\"`\r\n"]
[7740.885142, "o", "\t\t\tSourceIP         string   `json:\"source_ip\"`\r\n\t\t\tCompromisedHosts []string `json:\"compromised_hosts\"`\r\n\t\t\tFirstSeen        string   `json:\"first_seen\"`\r\n\t\t\tLastSeen         string   `json:\"last_seen\"`\r\n\t\t\tRiskScore        float64  `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType:       t.ThreatType,\r\n\t\t\tSourceIP:         t.SourceIP,\r\n"]
[7740.885203, "o", "\t\t\tCompromisedHosts: nonNilStrings(t.CompromisedHosts),\r\n\t\t\tFirstSeen:        t.FirstSeen,\r\n\t\t\tLastSeen:         t.LastSeen,\r\n\t\t\tRiskScore:        t.RiskScore,\r\n\t\t})\r\n\tcase \"dns_tunneling\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType string  `json:\"threat_type\"`\r\n"]
[7740.885286, "o", "\t\t\tSourceIP   string  `json:\"source_ip\"`\r\n\t\t\tQueryCount int     `json:\"query_count\"`\r\n\t\t\tAvgPayload float64 `json:\"avg_payload\"`\r\n\t\t\tFirstSeen  string  `json:\"first_seen\"`\r\n\t\t\tLastSeen   string  `json:\"last_seen\"`\r\n\t\t\tRiskScore  float64 `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType: t.ThreatType,\r\n"]
[7740.885346, "o", "\t\t\tSourceIP:   t.SourceIP,\r\n\t\t\tQueryCount: t.QueryCount,\r\n\t\t\tAvgPayload: t.AvgPayload,\r\n\t\t\tFirstSeen:  t.FirstSeen,\r\n"]
[7740.885408, "o", "\t\t\tLastSeen:   t.LastSeen,\r\n\t\t\tRiskScore:  t.RiskScore,\r\n\t\t})\r\n\t}\r\n\treturn json.Marshal(struct {\r\n\t\tThreatType string  `json:\"threat_type\"`\r\n\t\tRiskScore  float64 `json:\"risk_score\"`\r\n\t}{\r\n\t\tThreatType: t.ThreatType,\r\n\t\tRiskScore:  t.RiskScore,\r\n\t})\r\n"]
[7740.88547, "o", "}\r\n\r\nfunc nonNilStrings(s []string) []string {\r\n\tif s == nil {\r\n\t\treturn []string{}\r\n\t}\r\n\treturn s\r\n}\r\n\r\nfunc nonNilInts(s []int) []int {\r\n\tif s == nil {\r\n\t\treturn []int{}\r\n"]
[7740.88553, "o", "\t}\r\n\treturn s\r\n}\r\n"]
