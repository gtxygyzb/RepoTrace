[12135.945075, "o", "        \"bufio\"\r\n\u001b[?2004l\r"]
[12135.945133, "o", "\u001b[?2004h> "]
[12135.945326, "o", "        \"encoding/json\"\r\n\u001b[?2004l\r"]
[12135.945397, "o", "\u001b[?2004h> "]
[12135.945491, "o", "        \"fmt\"\r\n\u001b[?2004l\r"]
[12135.945543, "o", "\u001b[?2004h> "]
[12135.945663, "o", "        \"math\"\r\n\u001b[?2004l\r"]
[12135.945719, "o", "\u001b[?2004h> "]
[12135.945815, "o", "        \"os\"\r\n\u001b[?2004l\r"]
[12135.94588, "o", "\u001b[?2004h> "]
[12135.946007, "o", "        \"strconv\"\r\n\u001b[?2004l\r"]
[12135.946074, "o", "\u001b[?2004h> )\r\n"]
[12135.946131, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[12135.946185, "o", "\u001b[?2004l\r\u001b[?2004h"]
[12135.946238, "o", "> "]
[12135.946433, "o", "type rateMetricResult struct {\r\n\u001b[?2004l\r"]
[12135.946487, "o", "\u001b[?2004h> "]
[12135.946849, "o", "        MeanRate   json.Number   `json:\"mean_rate\"`\r\n\u001b[?2004l\r"]
[12135.946912, "o", "\u001b[?2004h> "]
[12135.947272, "o", "        MaxRate    json.Number   `json:\"max_rate\"`\r\n\u001b[?2004l\r"]
[12135.947337, "o", "\u001b[?2004h> "]
[12135.947679, "o", "        MinRate    json.Number   `json:\"min_rate\"`\r\n\u001b[?2004l\r"]
[12135.947729, "o", "\u001b[?2004h> "]
[12135.9481, "o", "        Volatility json.Number   `json:\"volatility\"`\r\n\u001b[?2004l\r"]
[12135.948159, "o", "\u001b[?2004h> "]
[12135.948531, "o", "        Stability  string        `json:\"stability\"`\r\n\u001b[?2004l\r"]
[12135.948592, "o", "\u001b[?2004h> "]
[12135.948925, "o", "        Deltas     []json.Number `json:\"deltas\"`\r\n\u001b[?2004l\r"]
[12135.94899, "o", "\u001b[?2004h> }\r\n"]
[12135.949046, "o", "\u001b[?2004l\r\u001b[?2004h"]
[12135.949103, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[12135.949158, "o", "> "]
[12135.949315, "o", "type rateOutput struct {\r\n\u001b[?2004l\r"]
[12135.949373, "o", "\u001b[?2004h> "]
[12135.949869, "o", "        InputCount       int                        `json:\"input_count\"`\r\n\u001b[?2004l\r"]
[12135.94992, "o", "\u001b[?2004h> "]
[12135.950436, "o", "        StepCount        int                        `json:\"step_count\"`\r\n\u001b[?2004l\r"]
[12135.950514, "o", "\u001b[?2004h> "]
[12135.950973, "o", "        Metrics          map[string]rateMetricResult `json:\"metrics\"`\r\n\u001b[?2004l\r"]
[12135.951048, "o", "\u001b[?2004h> "]
[12135.951578, "o", "        OverallStability string                     `json:\"overall_stability\"`\r\n\u001b[?2004l\r"]
[12135.95166, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[12135.951735, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[12135.95181, "o", "> "]
[12135.952016, "o", "func runRate(args []string) int {\r\n\u001b[?2004l\r"]
[12135.952093, "o", "\u001b[?2004h> "]
[12135.952323, "o", "        fs := newFlagSet(\"rate\")\r\n\u001b[?2004l\r"]
[12135.952401, "o", "\u001b[?2004h> "]
[12135.952966, "o", "        minSnapshots := fs.Int(\"min-snapshots\", 2, \"minimum number of input snapshots\")\r\n\u001b[?2004l\r"]
[12135.953042, "o", "\u001b[?2004h> "]
[12135.953277, "o", "        if !parseFlags(fs, args) {\r\n\u001b[?2004l\r"]
[12135.953352, "o", "\u001b[?2004h> "]
[12135.953516, "o", "                return 1\r\n\u001b[?2004l\r"]
[12135.953593, "o", "\u001b[?2004h> "]
[12135.953669, "o", "        }\r\n\u001b[?2004l\r"]
[12135.953746, "o", "\u001b[?2004h> "]
[12135.953954, "o", "        if *minSnapshots < 2 {\r\n\u001b[?2004l\r"]
[12135.95403, "o", "\u001b[?2004h> "]
[12135.954621, "o", "                fmt.Fprintln(os.Stderr, \"error: --min-snapshots must be at least 2\")\r\n\u001b[?2004l\r"]
[12135.954682, "o", "\u001b[?2004h> "]
[12135.954853, "o", "                return 1\r\n\u001b[?2004l\r"]
[12135.954918, "o", "\u001b[?2004h> "]
[12135.954985, "o", "        }\r\n\u001b[?2004l\r"]
[12135.95505, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12135.955104, "o", "\u001b[?2004h> "]
[12135.955431, "o", "        var snapshots []forecastInputSnapshot\r\n\u001b[?2004l\r"]
[12135.95549, "o", "\u001b[?2004h> "]
[12135.9558, "o", "        scanner := bufio.NewScanner(os.Stdin)\r\n\u001b[?2004l\r"]
[12135.955864, "o", "\u001b[?2004h> "]
[12135.956269, "o", "        scanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n\u001b[?2004l\r"]
[12135.956328, "o", "\u001b[?2004h> "]
[12135.956527, "o", "        for scanner.Scan() {\r\n\u001b[?2004l\r"]
[12135.956584, "o", "\u001b[?2004h> "]
[12135.956856, "o", "                line := scanner.Text()\r\n\u001b[?2004l\r"]
[12135.956912, "o", "\u001b[?2004h> "]
[12135.957162, "o", "                if len(line) == 0 {\r\n\u001b[?2004l\r"]
[12135.957231, "o", "\u001b[?2004h> "]
[12135.957463, "o", "                        continue\r\n\u001b[?2004l\r"]
[12135.95753, "o", "\u001b[?2004h> "]
[12135.957645, "o", "                }\r\n\u001b[?2004l\r"]
[12135.957706, "o", "\u001b[?2004h> "]
[12135.958032, "o", "                var snap forecastInputSnapshot\r\n\u001b[?2004l\r"]
[12135.958097, "o", "\u001b[?2004h> "]
[12135.958612, "o", "                if err := json.Unmarshal([]byte(line), &snap); err != nil {\r\n\u001b[?2004l\r"]
[12135.958669, "o", "\u001b[?2004h> "]
[12135.959274, "o", "                        fmt.Fprintf(os.Stderr, \"error: malformed JSON input: %s\\n\", err)\r\n\u001b[?2004l\r"]
[12135.959345, "o", "\u001b[?2004h> "]
[12135.959567, "o", "                        return 2\r\n\u001b[?2004l\r"]
[12135.959624, "o", "\u001b[?2004h> "]
[12135.959723, "o", "                }\r\n\u001b[?2004l\r"]
[12135.959784, "o", "\u001b[?2004h> "]
[12135.960067, "o", "                snapshots = append(snapshots, snap)\r\n\u001b[?2004l\r"]
[12135.960125, "o", "\u001b[?2004h> "]
[12135.960179, "o", "        }\r\n\u001b[?2004l\r"]
[12135.960253, "o", "\u001b[?2004h> "]
[12135.960473, "o", "        if err := scanner.Err(); err != nil {\r\n\u001b[?2004l\r"]
[12135.960529, "o", "\u001b[?2004h> "]
[12135.960905, "o", "                fmt.Fprintf(os.Stderr, \"error: reading input: %s\\n\", err)\r\n\u001b[?2004l\r"]
[12135.960964, "o", "\u001b[?2004h> "]
[12135.961095, "o", "                return 1\r\n\u001b[?2004l\r"]
[12135.96115, "o", "\u001b[?2004h> "]
[12135.961203, "o", "        }\r\n\u001b[?2004l\r"]
[12135.961285, "o", "\u001b[?2004h> "]
[12135.961527, "o", "        if len(snapshots) < *minSnapshots {\r\n\u001b[?2004l\r"]
[12135.961583, "o", "\u001b[?2004h> "]
[12135.962233, "o", "                fmt.Fprintf(os.Stderr, \"error: at least %d valid input snapshots are required\\n\", *minSnapshots)\r\n\u001b[?2004l\r"]
[12135.962314, "o", "\u001b[?2004h> "]
[12135.962406, "o", "                return 1\r\n\u001b[?2004l\r"]
[12135.962462, "o", "\u001b[?2004h> "]
[12135.962522, "o", "        }\r\n\u001b[?2004l\r"]
[12135.962577, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[12135.962633, "o", "> "]
[12135.962939, "o", "        riskDeltas := make([]float64, 0, len(snapshots)-1)\r\n\u001b[?2004l\r"]
[12135.962994, "o", "\u001b[?2004h> "]
[12135.963284, "o", "        threatDeltas := make([]int, 0, len(snapshots)-1)\r\n\u001b[?2004l\r"]
[12135.963342, "o", "\u001b[?2004h> "]
[12135.963625, "o", "        for i := 0; i < len(snapshots)-1; i++ {\r\n\u001b[?2004l\r"]
[12135.963681, "o", "\u001b[?2004h> "]
[12135.964154, "o", "                riskDeltas = append(riskDeltas, snapshots[i+1].GlobalMeanRisk-snapshots[i].GlobalMeanRisk)\r\n\u001b[?2004l\r"]
[12135.964222, "o", "\u001b[?2004h> "]
[12135.964638, "o", "                threatDeltas = append(threatDeltas, snapshots[i+1].TotalThreats-snapshots[i].TotalThreats)\r\n\u001b[?2004l\r"]
[12135.964697, "o", "\u001b[?2004h> "]
[12135.964752, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12135.964817, "o", "\u001b[?2004h> "]
[12135.965007, "o", "        metrics := map[string]rateMetricResult{\r\n\u001b[?2004l\r"]
[12135.965028, "o", "\u001b[?2004h> "]
[12135.965347, "o", "                \"global_mean_risk\": buildRateMetric(riskDeltas, true),\r\n\u001b[?2004l\r"]
[12135.965369, "o", "\u001b[?2004h> "]
[12135.965779, "o", "                \"total_threats\":    buildRateMetric(threatDeltasAsFloats(threatDeltas), false),\r\n\u001b[?2004l\r"]
[12135.965801, "o", "\u001b[?2004h> "]
[12135.965865, "o", "        }\r\n\u001b[?2004l\r"]
[12135.965887, "o", "\u001b[?2004h> "]
[12135.965917, "o", "\r\n\u001b[?2004l\r"]
[12135.965938, "o", "\u001b[?2004h> "]
[12135.966067, "o", "        out := rateOutput{\r\n\u001b[?2004l\r"]
[12135.966087, "o", "\u001b[?2004h"]
[12135.966107, "o", "> "]
[12135.966317, "o", "                InputCount:       len(snapshots),\r\n\u001b[?2004l\r"]
[12135.966343, "o", "\u001b[?2004h> "]
[12135.966573, "o", "                StepCount:        len(riskDeltas),\r\n\u001b[?2004l\r"]
[12135.966593, "o", "\u001b[?2004h> "]
[12135.966789, "o", "                Metrics:          metrics,\r\n\u001b[?2004l\r"]
[12135.966809, "o", "\u001b[?2004h"]
[12135.966831, "o", "> "]
[12135.967101, "o", "                OverallStability: overallRateStability(metrics),\r\n\u001b[?2004l\r"]
[12135.967122, "o", "\u001b[?2004h> "]
[12135.967185, "o", "        }\r\n\u001b[?2004l\r"]
[12135.967205, "o", "\u001b[?2004h"]
[12135.967243, "o", "> \r\n\u001b[?2004l\r"]
[12135.967263, "o", "\u001b[?2004h"]
[12135.967282, "o", "> "]
[12135.9962, "o", "        encoded, err := json.Marshal(out)\r\n\u001b[?2004l\r\u001b[?2004h>         if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>                 fmt.Fprintln(os.Stderr, \"error: encoding rate output:\", err)\r\n\u001b[?2004l\r\u001b[?2004h>                 return 1\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         fmt.Println(string(encoded))\r\n\u001b[?2004l\r\u001b[?2004h>         return 0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[12135.996618, "o", "func buildRateMetric(deltas []float64, isRisk bool) rateMetricResult {\r\n\u001b[?2004l\r"]
[12135.996676, "o", "\u001b[?2004h> "]
[12135.996909, "o", "        meanRate := meanOfValues(deltas)\r\n\u001b[?2004l\r"]
[12135.996972, "o", "\u001b[?2004h> "]
[12135.997193, "o", "        maxRate := maxRateDelta(deltas)\r\n\u001b[?2004l\r"]
[12135.997259, "o", "\u001b[?2004h> "]
[12135.997494, "o", "        minRate := minRateDelta(deltas)\r\n\u001b[?2004l\r"]
[12135.997551, "o", "\u001b[?2004h> "]
[12135.997816, "o", "        volatility := populationStdDev(deltas)\r\n\u001b[?2004l\r"]
[12135.997876, "o", "\u001b[?2004h> "]
[12135.998262, "o", "        stability := rateStability(volatility, math.Abs(meanRate))\r\n\u001b[?2004l\r"]
[12135.998327, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12135.99839, "o", "\u001b[?2004h> "]
[12135.998588, "o", "        var deltasOut []json.Number\r\n\u001b[?2004l\r"]
[12135.998653, "o", "\u001b[?2004h> "]
[12135.99887, "o", "        var maxOut, minOut json.Number\r\n\u001b[?2004l\r"]
[12135.998928, "o", "\u001b[?2004h> "]
[12135.999043, "o", "        if isRisk {\r\n\u001b[?2004l\r"]
[12135.999101, "o", "\u001b[?2004h> "]
[12135.999457, "o", "                deltasOut = make([]json.Number, len(deltas))\r\n\u001b[?2004l\r"]
[12135.999514, "o", "\u001b[?2004h> "]
[12135.999757, "o", "                for i, d := range deltas {\r\n\u001b[?2004l\r"]
[12135.999813, "o", "\u001b[?2004h> "]
[12136.000217, "o", "                        deltasOut[i] = json.Number(formatRiskValue(d))\r\n\u001b[?2004l\r"]
[12136.000285, "o", "\u001b[?2004h> "]
[12136.000385, "o", "                }\r\n\u001b[?2004l\r"]
[12136.000444, "o", "\u001b[?2004h> "]
[12136.000795, "o", "                maxOut = json.Number(formatRiskValue(maxRate))\r\n\u001b[?2004l\r"]
[12136.000857, "o", "\u001b[?2004h> "]
[12136.001207, "o", "                minOut = json.Number(formatRiskValue(minRate))\r\n\u001b[?2004l\r"]
[12136.001272, "o", "\u001b[?2004h> "]
[12136.00137, "o", "        } else {\r\n\u001b[?2004l\r"]
[12136.001428, "o", "\u001b[?2004h> "]
[12136.00177, "o", "                deltasOut = make([]json.Number, len(deltas))\r\n\u001b[?2004l\r"]
[12136.001828, "o", "\u001b[?2004h> "]
[12136.00207, "o", "                for i, d := range deltas {\r\n\u001b[?2004l\r"]
[12136.002137, "o", "\u001b[?2004h> "]
[12136.002546, "o", "                        deltasOut[i] = json.Number(strconv.Itoa(int(d)))\r\n\u001b[?2004l\r"]
[12136.002606, "o", "\u001b[?2004h> "]
[12136.002708, "o", "                }\r\n\u001b[?2004l\r"]
[12136.002763, "o", "\u001b[?2004h> "]
[12136.003127, "o", "                maxOut = json.Number(strconv.Itoa(int(maxRate)))\r\n\u001b[?2004l\r"]
[12136.003184, "o", "\u001b[?2004h> "]
[12136.003559, "o", "                minOut = json.Number(strconv.Itoa(int(minRate)))\r\n\u001b[?2004l\r"]
[12136.003618, "o", "\u001b[?2004h> "]
[12136.003678, "o", "        }\r\n\u001b[?2004l\r"]
[12136.003732, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12136.003799, "o", "\u001b[?2004h> "]
[12136.003979, "o", "        return rateMetricResult{\r\n\u001b[?2004l\r"]
[12136.004039, "o", "\u001b[?2004h> "]
[12136.004384, "o", "                MeanRate:   json.Number(format4(meanRate)),\r\n\u001b[?2004l\r"]
[12136.004441, "o", "\u001b[?2004h> "]
[12136.004647, "o", "                MaxRate:    maxOut,\r\n\u001b[?2004l\r"]
[12136.004702, "o", "\u001b[?2004h> "]
[12136.004906, "o", "                MinRate:    minOut,\r\n\u001b[?2004l\r"]
[12136.004962, "o", "\u001b[?2004h> "]
[12136.00532, "o", "                Volatility: json.Number(format4(volatility)),\r\n\u001b[?2004l\r"]
[12136.005391, "o", "\u001b[?2004h> "]
[12136.0056, "o", "                Stability:  stability,\r\n\u001b[?2004l\r"]
[12136.005656, "o", "\u001b[?2004h> "]
[12136.005879, "o", "                Deltas:     deltasOut,\r\n\u001b[?2004l\r"]
[12136.005935, "o", "\u001b[?2004h> "]
[12136.005996, "o", "        }\r\n\u001b[?2004l\r"]
[12136.006058, "o", "\u001b[?2004h> }\r\n"]
[12136.006118, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[12136.006177, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[12136.006492, "o", "func threatDeltasAsFloats(deltas []int) []float64 {\r\n\u001b[?2004l\r"]
[12136.006552, "o", "\u001b[?2004h> "]
[12136.006799, "o", "        out := make([]float64, len(deltas))\r\n\u001b[?2004l\r"]
[12136.006864, "o", "\u001b[?2004h> "]
[12136.007055, "o", "        for i, d := range deltas {\r\n\u001b[?2004l\r"]
[12136.007118, "o", "\u001b[?2004h> "]
[12136.007326, "o", "                out[i] = float64(d)\r\n\u001b[?2004l\r"]
[12136.007384, "o", "\u001b[?2004h> "]
[12136.007443, "o", "        }\r\n\u001b[?2004l\r"]
[12136.0075, "o", "\u001b[?2004h> "]
[12136.007612, "o", "        return out\r\n\u001b[?2004l\r"]
[12136.00767, "o", "\u001b[?2004h> }\r\n"]
[12136.007728, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[12136.007784, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[12136.007839, "o", "> "]
[12136.008063, "o", "func maxRateDelta(deltas []float64) float64 {\r\n\u001b[?2004l\r"]
[12136.00811, "o", "\u001b[?2004h> "]
[12136.008271, "o", "        var best float64\r\n\u001b[?2004l\r"]
[12136.008319, "o", "\u001b[?2004h> "]
[12136.008528, "o", "        for i, d := range deltas {\r\n\u001b[?2004l\r"]
[12136.008594, "o", "\u001b[?2004h> "]
[12136.008747, "o", "                if i == 0 {\r\n\u001b[?2004l\r"]
[12136.008803, "o", "\u001b[?2004h> "]
[12136.008992, "o", "                        best = d\r\n\u001b[?2004l\r"]
[12136.009048, "o", "\u001b[?2004h> "]
[12136.009241, "o", "                        continue\r\n\u001b[?2004l\r"]
[12136.009302, "o", "\u001b[?2004h> "]
[12136.00941, "o", "                }\r\n\u001b[?2004l\r"]
[12136.009468, "o", "\u001b[?2004h> "]
[12136.010007, "o", "                if math.Abs(d) > math.Abs(best) || (math.Abs(d) == math.Abs(best) && d > best) {\r\n\u001b[?2004l\r"]
[12136.010073, "o", "\u001b[?2004h> "]
[12136.010261, "o", "                        best = d\r\n\u001b[?2004l\r"]
[12136.010328, "o", "\u001b[?2004h> "]
[12136.010425, "o", "                }\r\n\u001b[?2004l\r"]
[12136.010481, "o", "\u001b[?2004h> "]
[12136.01054, "o", "        }\r\n\u001b[?2004l\r"]
[12136.010603, "o", "\u001b[?2004h> "]
[12136.010716, "o", "        return best\r\n\u001b[?2004l\r"]
[12136.010779, "o", "\u001b[?2004h> }\r\n"]
[12136.010838, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[12136.010897, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[12136.011083, "o", "func minRateDelta(deltas []float64) float64 {\r\n\u001b[?2004l\r"]
[12136.011138, "o", "\u001b[?2004h> "]
[12136.011235, "o", "        var best float64\r\n\u001b[?2004l\r"]
[12136.011292, "o", "\u001b[?2004h> "]
[12136.011435, "o", "        for i, d := range deltas {\r\n\u001b[?2004l\r"]
[12136.01149, "o", "\u001b[?2004h> "]
[12136.011595, "o", "                if i == 0 {\r\n\u001b[?2004l\r"]
[12136.011651, "o", "\u001b[?2004h> "]
[12136.011775, "o", "                        best = d\r\n\u001b[?2004l\r"]
[12136.011831, "o", "\u001b[?2004h> "]
[12136.011954, "o", "                        continue\r\n\u001b[?2004l\r"]
[12136.01201, "o", "\u001b[?2004h> "]
[12136.012073, "o", "                }\r\n\u001b[?2004l\r"]
[12136.012132, "o", "\u001b[?2004h> "]
[12136.012515, "o", "                if math.Abs(d) < math.Abs(best) || (math.Abs(d) == math.Abs(best) && d > best) {\r\n\u001b[?2004l\r"]
[12136.012573, "o", "\u001b[?2004h> "]
[12136.012694, "o", "                        best = d\r\n\u001b[?2004l\r"]
[12136.012751, "o", "\u001b[?2004h> "]
[12136.012812, "o", "                }\r\n\u001b[?2004l\r"]
[12136.012868, "o", "\u001b[?2004h> "]
[12136.012924, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[12136.01298, "o", "> "]
[12136.013045, "o", "        return best\r\n\u001b[?2004l\r\u001b[?2004h"]
[12136.0131, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[12136.013155, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[12136.013376, "o", "func populationStdDev(values []float64) float64 {\r\n\u001b[?2004l\r"]
[12136.013432, "o", "\u001b[?2004h> "]
[12136.013543, "o", "        if len(values) == 0 {\r\n\u001b[?2004l\r"]
[12136.013597, "o", "\u001b[?2004h> "]
[12136.013693, "o", "                return 0\r\n\u001b[?2004l\r"]
[12136.013748, "o", "\u001b[?2004h> "]
[12136.013805, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12136.013974, "o", "        mean := meanOfValues(values)\r\n\u001b[?2004l\r"]
[12136.014029, "o", "\u001b[?2004h> "]
[12136.014141, "o", "        var sumSqDiff float64\r\n\u001b[?2004l\r"]
[12136.014196, "o", "\u001b[?2004h> "]
[12136.014335, "o", "        for _, v := range values {\r\n\u001b[?2004l\r"]
[12136.014391, "o", "\u001b[?2004h> "]
[12136.014515, "o", "                diff := v - mean\r\n\u001b[?2004l\r"]
[12136.014571, "o", "\u001b[?2004h> "]
[12136.014721, "o", "                sumSqDiff += diff * diff\r\n\u001b[?2004l\r"]
[12136.014781, "o", "\u001b[?2004h> "]
[12136.014841, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12136.015096, "o", "        return math.Sqrt(sumSqDiff / float64(len(values)))\r\n\u001b[?2004l\r"]
[12136.015123, "o", "\u001b[?2004h> }"]
[12136.015295, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[12136.015491, "o", "func rateStability(volatility, absMeanRate float64) string {\r\n\u001b[?2004l\r"]
[12136.015521, "o", "\u001b[?2004h> "]
[12136.015764, "o", "        if volatility < 0.1*math.Max(absMeanRate, 1.0) {\r\n\u001b[?2004l\r"]
[12136.015824, "o", "\u001b[?2004h> "]
[12136.015938, "o", "                return \"stable\"\r\n\u001b[?2004l\r"]
[12136.015995, "o", "\u001b[?2004h> "]
[12136.016051, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12136.016174, "o", "        return \"volatile\"\r\n\u001b[?2004l\r"]
[12136.016249, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[12136.016307, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[12136.016615, "o", "func overallRateStability(metrics map[string]rateMetricResult) string {\r\n\u001b[?2004l\r"]
[12136.016671, "o", "\u001b[?2004h> "]
[12136.017119, "o", "        if metrics[\"global_mean_risk\"].Stability == \"stable\" && metrics[\"total_threats\"].Stability == \"stable\" {\r\n\u001b[?2004l\r"]
[12136.017176, "o", "\u001b[?2004h> "]
[12136.017307, "o", "                return \"stable\"\r\n\u001b[?2004l\r"]
[12136.017364, "o", "\u001b[?2004h> "]
[12136.01742, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12136.017545, "o", "        return \"volatile\"\r\n\u001b[?2004l\r"]
[12136.017601, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[12136.017656, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
