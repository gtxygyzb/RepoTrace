[5528.049485, "i", "python3 - << 'PYEOF'\nwith open('snapshot.go', 'r') as f:\n    s = f.read()\n\n# Initialize empty report risk_category to low.\ns = s.replace(\n    '\\treport := snapshotReport{\\n\\t\\tActorThreatCounts: map[string]int{},\\n\\t}\\n\\tif len(threats) == 0 {\\n\\t\\treturn report\\n\\t}',\n    '\\treport := snapshotReport{\\n\\t\\tActorThreatCounts: map[string]int{},\\n\\t\\tRiskCategory:  \"low\",\\n\\t}\\n\\tif len(threats) == 0 {\\n\\t\\treturn report\\n\\t}'\n)\n\n# Use threatSortTime for timeline-style bucketing in snapshot peak bucket.\ns = s.replace(\n    '\\t\\trefTime := threatReferenceTime(threat)\\n\\t\\tvar refUnix int64\\n\\t\\tif !refTime.IsZero() {\\n\\t\\t\\trefUnix = refTime.Unix()\\n\\t\\t}',\n    '\\t\\trefTime := threatSortTime(threat)\\n\\t\\tvar refUnix int64\\n\\t\\tif !refTime.IsZero() {\\n\\t\\t\\trefUnix = refTime.Unix()\\n\\t\\t}'\n)\n\n# Use rounded mean for risk category.\ns = s.replace(\n    '\\treport.MeanEnrichedRisk = round2(meanRisk)\\n\\treport.RiskCategory = snapshotRiskCategory(meanRisk)',\n    '\\treport.MeanEnrichedRisk = round2(meanRisk)\\n\\treport.RiskC"]
[5528.049714, "i", "ategory = snapshotRiskCategory(report.MeanEnrichedRisk)'\n)\n\n# Robust peak bucket selection.\ns = s.replace(\n    '\\tpeakAvg := 0.0\\n\\tpeakStart := \"\"\\n\\tvar peakStartUnix int64 = -1\\n\\tvar starts []int64\\n\\tfor s := range buckets {\\n\\t\\tstarts = append(starts, s)\\n\\t}\\n\\tsort.Slice(starts, func(i, j int) bool { return starts[i] < starts[j] })\\n\\tfor _, start := range starts {\\n\\t\\tbucketThreats := buckets[start]\\n\\t\\tvar sum float64\\n\\t\\tfor _, t := range bucketThreats {\\n\\t\\t\\trisk, _ := getFloat(t, \"enriched_risk_score\")\\n\\t\\t\\tsum += risk\\n\\t\\t}\\n\\t\\tavg := sum / float64(len(bucketThreats))\\n\\t\\tif peakStartUnix == -1 || avg > peakAvg {\\n\\t\\t\\tpeakAvg = avg\\n\\t\\t\\tpeakStartUnix = start\\n\\t\\t\\tpeakStart = time.Unix(start, 0).UTC().Format(time.RFC3339)\\n\\t\\t}\\n\\t}\\n\\treport.PeakBucketAvg = round2(peakAvg)\\n\\treport.PeakBucketStart = peakStart',\n    '\\tpeakAvg := 0.0\\n\\tpeakStart := \"\"\\n\\tfirst := true\\n\\tvar starts []int64\\n\\tfor s := range buckets {\\n\\t\\tstarts = append(starts, s)\\n\\t}\\n\\tsort.Slice(starts, f"]
[5528.049826, "o", "python3 - << 'PYEOF'\r\n\u001b[?2004l\r"]
[5528.049918, "i", "unc(i, j int) bool { return starts[i] < starts[j] })\\n\\tfor _, start := range starts {\\n\\t\\tbucketThreats := buckets[start]\\n\\t\\tvar sum float64\\n\\t\\tfor _, t := range bucketThreats {\\n\\t\\t\\trisk, _ := getFloat(t, \"enriched_risk_score\")\\n\\t\\t\\tsum += risk\\n\\t\\t}\\n\\t\\tavg := sum / float64(len(bucketThreats))\\n\\t\\tif first || avg > peakAvg {\\n\\t\\t\\tfirst = false\\n\\t\\t\\tpeakAvg = avg\\n\\t\\t\\tpeakStart = time.Unix(start, 0).UTC().Format(time.RFC3339)\\n\\t\\t}\\n\\t}\\n\\treport.PeakBucketAvg = round2(peakAvg)\\n\\treport.PeakBucketStart = peakStart'\n)\n\nwith open('snapshot.go', 'w') as f:\n    f.write(s)\nPYEOF\n"]
