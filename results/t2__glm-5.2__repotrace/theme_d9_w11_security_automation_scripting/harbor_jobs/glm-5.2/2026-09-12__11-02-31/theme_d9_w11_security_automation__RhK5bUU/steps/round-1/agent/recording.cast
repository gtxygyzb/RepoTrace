[10234.994057, "o", "   120\t\t}\r\n   121\t\r\n   122\t\tageMinutes := 0.0\r\n   123\t\tif !eventTime.IsZero() {\r\n   124\t\t\tageMinutes = refTime.Sub(eventTime).Minutes()\r\n   125\t\t"]
[10234.994145, "o", "}\r\n   126\t\tif ageMinutes < 0 {\r\n   127\t\t\tageMinutes = 0\r\n   128\t\t}\r\n   129\t\trecency := math.Pow(2, -ageMinutes/30.0)\r\n   130\t\r\n   131\t\triskScore, _ := getFloat(threat, \"enriched_risk_score\")\r\n   132\t\trisk := riskScore / 500.0\r\n   133\t\tif risk > 1.0 {\r\n   134\t\t\trisk = 1.0\r\n   135\t\t}\r\n"]
[10234.994231, "o", "   136\t\tif risk < 0 {\r\n   137\t\t\trisk = 0\r\n   138\t\t}\r\n   139\t\r\n   140\t\tconfidence := 0.0\r\n   141\t\tif c, ok := getFloat(threat, \"max_ioc_confidence\"); ok {\r\n   142\t\t\tconfidence = c\r\n   143\t\t}\r\n   144\t\tif confidence < 0 {\r\n   145\t\t\t"]
[10234.994293, "o", "confidence = 0\r\n   146\t\t}\r\n   147\t\tif confidence > 1 {\r\n   148\t\t\tconfidence = 1\r\n   149\t\t}\r\n   150\t\r\n   151\t\tactors := []string{}\r\n   152\t\tif a, ok := getStringSlice(threat, \"threat_actors\"); ok {\r\n   153\t\t\tactors = a"]
[10234.994354, "o", "\r\n   154\t\t}\r\n   155\t\tactor := float64(len(actors)) / 3.0\r\n   156\t\tif actor > 1.0 {\r\n   157\t\t\tactor = 1.0\r\n   158\t\t}\r\n   159\t\tif actor < 0 {\r\n   160\t\t\tactor = 0\r\n   161\t\t}\r\n   162\t\r\n"]
[10234.994412, "o", "   163\t\tseverity := getStringDefault(threat, \"ioc_severity\")\r\n   164\t\tseverityRank := prioritySeverityRanks[severity]\r\n   165\t\tseverityComponent := float64(severityRank) / 4.0\r\n   166\t\r\n   167\t\tscore := wSeverity*severityComponent +\r\n   168\t\t\twRecency*recency +\r\n   169\t\t\twRisk*risk +\r\n"]
[10234.994481, "o", "   170\t\t\twConfidence*confidence +\r\n   171\t\t\twActor*actor\r\n   172\t\r\n   173\t\tlabel := priorityLabel(score)\r\n   174\t\r\n   175\t\treturn prioritizeOutput{\r\n"]
[10234.994539, "o", "   176\t\t\tSourceIP:      sourceIP,\r\n   177\t\t\tThreatType:    threatType,\r\n   178\t\t\tPriorityScore: round4(score),\r\n   179\t\t\tPriorityLabel: label,\r\n   180\t\t\tComponents: priorityComponents{\r\n   181\t\t\t\tSeverity:   round4(severityComponent),\r\n   182\t\t\t\tRecency:    round4(recency),\r\n   183\t\t\t\tRisk:       round4(risk),\r\n   184\t\t\t\tConfidence: round4(confidence),\r\n   185\t\t\t\tActor:      round4(actor),\r\n   186\t\t\t},\r\n   187\t\t\tEnrichedRiskScore: riskScore,\r\n   188\t\t\tIOCSeverity:       severity,\r\n"]
[10234.994609, "o", "   189\t\t\tThreatActors:      actors,\r\n   190\t\t\tReferenceTime:     refStr,\r\n   191\t\t}, true\r\n   192\t}\r\n   193\t\r\n   194\tfunc priorityLabel(score float64) string {\r\n   195\t\tswitch {\r\n   196\t\tcase score >= 0.75:\r\n   197\t\t\treturn \"critical\"\r\n   198\t\tcase score >= 0.50:\r\n   199"]
[10234.99467, "o", "\t\t\treturn \"high\"\r\n   200\t\tcase score >= 0.25:\r\n   201\t\t\treturn \"medium\"\r\n   202\t\tdefault:\r\n   203\t\t\treturn \"low\"\r\n   204\t\t}\r\n   205\t}\r\n   206\t\r\n   207\tfunc round4(f float64) float64 {\r\n   208\t"]
[10234.994729, "o", "\treturn math.Round(f*10000) / 10000\r\n   209\t}\r\n"]
