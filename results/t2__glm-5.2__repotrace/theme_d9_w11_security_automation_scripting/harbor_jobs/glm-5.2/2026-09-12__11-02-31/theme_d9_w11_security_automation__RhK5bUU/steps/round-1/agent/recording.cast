[116.755448, "o", "\r\ntype Event struct {\r\ngo.mod Timestamp   string            `json:\"timestamp\"`\r\ngo.mod SourceIP    string            `json:\"source_ip\"`\r\ngo.mod DestIP      string            `json:\"dest_ip\"`\r\ngo.mod DestPort    int               `json:\"dest_port\"`\r\ngo.mod Protocol    string            `json:\"protocol\"`\r\ngo.mod Action      string            `json:\"action\"`\r\ngo.mod EventType  string            `json:\"event_type\"`\r\ngo.mod User        string            `json:\"user\"`\r\ngo.mod Severity    string            `json:\"severity\"`\r\ngo.mod PayloadSize int64             `json:\"payload_size\"`\r\ngo.mod Metadata    map[string]string `json:\"metadata\"`\r\n}\r\n\r\nvar severityMap = map[string]int{\r\ngo.mod \"low\":      1,\r\ngo.mod \"medium\":   2,\r\ngo.mod \"high\":     3,\r\ngo.mod \"critical\": 4,\r\n}\r\n\r\nfunc severityValue(s string) int {\r\ngo.mod return severityMap[s]\r\n}\r\n\r\nfunc parseEvent(line string) (Event, error) {\r\ngo.mod var e Event\r\ngo.mod if err := json.Unmarshal([]byte(line), &e); err != nil {\r\ngo.mod go.mod return e, err\r\ngo.mod }\r\ngo.mo"]
[116.755506, "o", "d return e, nil\r\n}\r\n\r\nfunc parseTime(ts string) (time.Time, error) {\r\ngo.mod t, err := time.Parse(time.RFC3339, ts)\r\ngo.mod if err != nil {\r\ngo.mod go.mod return time.Time{}, fmt.Errorf(\"invalid timestamp %q: %w\", ts, err)\r\ngo.mod }\r\ngo.mod return t, nil\r\n}\r\n\r\nfunc readEvents() ([]Event, error) {\r\ngo.mod scanner := bufio.NewScanner(os.Stdin)\r\ngo.mod scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\ngo.mod var events []Event\r\ngo.mod lineNo := 0\r\ngo.mod for scanner.Scan() {\r\ngo.mod go.mod lineNo++\r\ngo.mod go.mod line := scanner.Text()\r\ngo.mod go.mod if line == \"\" {\r\ngo.mod go.mod go.mod continue\r\ngo.mod go.mod }\r\ngo.mod go.mod e, err := parseEvent(line)\r\ngo.mod go.mod if err != nil {\r\ngo.mod go.mod go.mod return events, fmt.Errorf(\"line %d: %w\", lineNo, err)\r\ngo.mod go.mod }\r\ngo.mod go.mod events = append(events, e)\r\n"]
[116.75562, "o", "go.mod }\r\ngo.mod if err := scanner.Err(); err != nil {\r\ngo.mod go.mod return events, err\r\ngo.mod }\r\ngo.mod return events, nil\r\n}\r\n\r\nfunc sortEventsByTime(events []Event) {\r\ngo.mod sort.SliceStable(events, func(i, j int) bool {\r\ngo.mod go.mod return events[i].Timestamp < events[j].Timestamp\r\ngo.mod })\r\n}\r\n\r\nfunc uniqueSortedStrings(input []string) []string {\r\ngo.mod seen := make(map[string]bool)\r\ngo.mod var out []string\r\ngo.mod for _, s := range input {\r\ngo.mod go.mod if !seen[s] {\r\ngo.mod go.mod go.mod seen[s] = true\r\ngo.mod go.mod go.mod out = append(out, s)\r\ngo.mod go.mod }\r\ngo.mod }\r\ngo.mod sort.Strings(out)\r\ngo.mod return out\r\n"]
