[862.363324, "i", "cat > summarize.go <<'EOF'\npackage main\n\nimport (\n    \"bufio\"\n    \"encoding/json\"\n    \"fmt\"\n    \"os\"\n    \"sort\"\n    \"time\"\n)\n\ntype Summary struct {\n    TotalEvents    int               `json:\"total_events\"`\n    TimeRange      TimeRange         `json:\"time_range\"`\n    BySeverity     map[string]int    `json:\"by_severity\"`\n    ByAction       map[string]int    `json:\"by_action\"`\n    ByEventType    map[string]int    `json:\"by_event_type\"`\n    TopSourceIPs   []SourceIPStat    `json:\"top_source_ips\"`\n    TopDestPorts   []DestPortStat    `json:\"top_dest_ports\"`\n    UniqueSourceIPs int              `json:\"unique_source_ips\"`\n    UniqueDestIPs   int              `json:\"unique_dest_ips\"`\n    SeverityTrend  []SeverityWindow  `json:\"severity_trend\"`\n}\n\ntype TimeRange struct {\n    Start string `json:\"start\"`\n    End   string `json:\"end\"`\n}\n\ntype SourceIPStat struct {\n    IP          string  `json:\"ip\"`\n    Count       int     `json:\"count\"`\n    ThreatScore float64 `json:\"threat_score\"`\n}\n\ntype DestPortStat struct {\n    Por"]
[862.363369, "i", "t  int `json:\"port\"`\n    Count int `json:\"count\"`\n}\n\ntype SeverityWindow struct {\n    WindowStart  string  `json:\"window_start\"`\n    WindowEnd    string  `json:\"window_end\"`\n    AvgSeverity  float64 `json:\"avg_severity\"`\n}\n\nfunc runSummarize(args []string) int {\n    fs := newFlagSet(\"summarize\")\n    format := fs.String(\"format\", \"json\", \"output format (text|json)\")\n    if !parseFlags(fs, args) {\n        return 1\n    }\n    if *format != \"json\" && *format != \"text\" {\n        fmt.Fprintln(os.Stderr, \"invalid format\")\n        return 1\n    }\n\n    events, err := readEvents()\n    summary := buildSummary(events)\n    if *format == \"text\" {\n        printTextSummary(summary)\n    } else {\n        printJSONSummary(summary)\n    }\n    if err != nil {\n        fmt.Fprintln(os.Stderr, err)\n        return 2\n    }\n    return 0\n}\n\nfunc buildSummary(events []Event) Summary {\n    s := Summary{\n        TotalEvents: len(events),\n        BySeverity:  make(map[string]int),\n        ByAction:    make(map[string]int),\n        ByEventType:"]
[862.363593, "i", " make(map[string]int),\n    }\n    if len(events) == 0 {\n        s.TimeRange = TimeRange{Start: \"\", End: \"\"}\n        s.TopSourceIPs = []SourceIPStat{}\n        s.TopDestPorts = []DestPortStat{}\n        s.SeverityTrend = []SeverityWindow{}\n        return s\n    }\n\n    var minT, maxT time.Time\n    sourceCounts := make(map[string]int)\n    sourceScores := make(map[string]float64)\n    destIPs := make(map[string]bool)\n    portCounts := make(map[int]int)\n\n    for i, e := range events {\n        t, ok := eventTime(e)\n        if ok {\n            if i == 0 || t.Before(minT) {\n                minT = t\n            }\n            if i == 0 || t.After(maxT) {\n                maxT = t\n            }\n        } else {\n            if e.Timestamp != \"\" {\n                if i == 0 || e.Timestamp < minTStr {\n                    minTStr = e.Timestamp\n                }\n                if i == 0 || e.Timestamp > maxTStr {\n                    maxTStr = e.Timestamp\n                }\n            }\n        }\n        s.BySeverity[e.Severity]++\n"]
[862.363606, "o", "cat > summarize.go <<'EOF'\r\n\u001b[?2004l\r"]
[862.36362, "i", "        s.ByAction[e.Action]++\n        s.ByEventType[e.EventType]++\n        sourceCounts[e.SourceIP]++\n        sourceScores[e.SourceIP] += float64(severityValue(e.Severity))\n        destIPs[e.DestIP] = true\n        portCounts[e.DestPort]++\n    }\n\n    s.TimeRange = TimeRange{\n        Start: minT.Format(time.RFC3339),\n        End:   maxT.Format(time.RFC3339),\n    }\n    s.UniqueSourceIPs = len(sourceCounts)\n    s.UniqueDestIPs = len(destIPs)\n\n    s.TopSourceIPs = topSourceIPs(sourceCounts, sourceScores)\n    s.TopDestPorts = topDestPorts(portCounts)\n    s.SeverityTrend = severityTrend(events, minT)\n\n    return s\n}\n\nvar minTStr, maxTStr string\n\nfunc topSourceIPs(counts map[string]int, scores map[string]float64) []SourceIPStat {\n    out := make([]SourceIPStat, 0, len(counts))\n    for ip, c := range counts {\n        out = append(out, SourceIPStat{IP: ip, Count: c, ThreatScore: scores[ip]})\n    }\n    sort.Slice(out, func(i, j int) bool {\n        if out[i].Count != out[j].Count {\n            return out[i].Count > out["]
[862.363723, "i", "j].Count\n        }\n        return out[i].IP < out[j].IP\n    })\n    if len(out) > 10 {\n        out = out[:10]\n    }\n    return out\n}\n\nfunc topDestPorts(counts map[int]int) []DestPortStat {\n    out := make([]DestPortStat, 0, len(counts))\n    for p, c := range counts {\n        out = append(out, DestPortStat{Port: p, Count: c})\n    }\n    sort.Slice(out, func(i, j int) bool {\n        if out[i].Count != out[j].Count {\n            return out[i].Count > out[j].Count\n        }\n        return out[i].Port < out[j].Port\n    })\n    if len(out) > 10 {\n        out = out[:10]\n    }\n    return out\n}\n\nfunc severityTrend(events []Event, first time.Time) []SeverityWindow {\n    windows := make(map[int64][]Event)\n    for _, e := range events {\n        t, ok := eventTime(e)\n        if !ok {\n            continue\n        }\n        offset := int64(t.Sub(first).Seconds())\n        if offset < 0 {\n            offset = 0\n        }\n        window := offset / 3600\n        windows[window] = append(windows[window], e)\n    }\n\n    var keys []in"]
[862.363742, "o", " make(map[string]int),\r\n    }\r\n    if len(events) == 0 {\r\n        s.TimeRange = TimeRange{Start: \"\", End: \"\"}\r\n        s.TopSourceIPs = []SourceIPStat{}\r\n        s.TopDestPorts = []DestPortStat{}\r\n        s.SeverityTrend = []SeverityWindow{}\r\n    "]
[862.363752, "i", "t64\n    for k := range windows {\n        keys = append(keys, k)\n    }\n    sort.Slice(keys, func(i, j int) bool { return keys[i] < keys[j] })\n\n    out := make([]SeverityWindow, 0, len(keys))\n    for _, k := range keys {\n        evs := windows[k]\n        var total float64\n        for _, e := range evs {\n            total += float64(severityValue(e.Severity))\n        }\n        avg := total / float64(len(evs))\n        start := first.Add(time.Duration(k*3600) * time.Second)\n        end := first.Add(time.Duration((k+1)*3600) * time.Second)\n        out = append(out, SeverityWindow{\n            WindowStart: start.Format(time.RFC3339),\n            WindowEnd:   end.Format(time.RFC3339),\n            AvgSeverity: round2(avg),\n        })\n    }\n    return out\n}\n\nfunc printJSONSummary(s Summary) {\n    w := bufio.NewWriter(os.Stdout)\n    defer w.Flush()\n    enc := json.NewEncoder(w)\n    enc.SetEscapeHTML(false)\n    if err := enc.Encode(s); err != nil {\n        fmt.Fprintln(os.Stderr, err)\n    }\n}\n\nfunc printTextSummary(s Sum"]
