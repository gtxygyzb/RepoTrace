[8278.41085, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n"]
[8278.410936, "o", "\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n)\r\n\r\ntype diffReport struct {\r\n\tThreatCountDelta     int            `json:\"threat_count_delta\"`\r\n\tThreatCountPctChange float64        `json:\"threat_count_pct_change\"`\r\n\tRiskDelta            float64        `json:\"risk_delta\"`\r\n\tRiskPctChange        float64        `json:\"risk_pct_change\"`\r\n\tRiskTrend            string         `json:\"risk_trend\"`\r\n\tNewActors            []string       `json:\"new_actors\"`\r\n\t"]
[8278.411015, "o", "GoneActors           []string       `json:\"gone_actors\"`\r\n\tPersistentActors     []string       `json:\"persistent_actors\"`\r\n\tActorCountDeltas     map[string]int `json:\"actor_count_deltas\"`\r\n\tTypeShift            map[string]int `json:\"type_shift\"`\r\n\tCampaignDelta        int            `json:\"campaign_delta\"`\r\n\tRiskCategoryChange   diffCategory   `json:\"risk_category_change\"`\r\n\tEscalation           bool           `json:\"escalation\"`\r\n}\r\n"]
[8278.411086, "o", "\r\ntype diffCategory struct {\r\n\tFrom string `json:\"from\"`\r\n\tTo   string `json:\"to\"`\r\n}\r\n\r\nfunc runDiff(args []string) int {\r\n\treader := bufio.NewReader(os.Stdin)\r\n\r\n\tvar reports []aggregateReport\r\n\tfor {\r\n\t\tline, err := reader.ReadString('\\n')\r\n\t\ttrimmed := strings.TrimSpace(line)\r\n\t\tif trimmed == \"\" {\r\n\t\t\tif err != nil {\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\tcontinue\r\n"]
[8278.41115, "o", "\t\t}\r\n\r\n\t\tvar report aggregateReport\r\n\t\tif jerr := json.Unmarshal([]byte(trimmed), &report); jerr != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"error: malformed JSON input:\", jerr)\r\n\t\t\treturn 2\r\n\t\t}\r\n\r\n\t\treports = append(reports, report)\r\n\t\tif len(reports) >= 2 {\r\n\t\t\tbreak\r\n"]
[8278.411259, "o", "\t\t}\r\n\r\n\t\tif err != nil {\r\n\t\t\tbreak\r\n"]
[8278.411325, "o", "\t\t}\r\n\t}\r\n\r\n\tif len(reports) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: expected two aggregate JSON objects on stdin\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\tbaseline := reports[0]\r\n\tcurrent := reports[1]\r\n\r\n\treport := diffReport{\r\n\t\tThreatCountDelta: current.TotalThreats - baseline.TotalThreats,\r\n\t\tRiskDelta:        current.GlobalMeanRisk - baseline.GlobalMeanRisk,\r\n\t\tNewActors:        []string{},\r\n\t\tGoneActors:       []string{},\r\n\t\tPersistentActors: []string{},\r\n\t\tActorCountDeltas: map[string]int{},\r\n\t\tTypeShift:        map[string]int{},\r\n\t\tCampaignDelta:    current.TotalCampaigns - baseline.TotalCampaigns,\r\n\t\tRiskCategoryChange: diffCategory{\r\n\t\t\tFrom: baseline.GlobalRiskCategory,\r\n"]
[8278.411392, "o", "\t\t\tTo:   current.GlobalRiskCategory,\r\n\t\t},\r\n\t\tEscalation: riskCategoryRank(current.GlobalRiskCategory) > riskCategoryRank(baseline.GlobalRiskCategory),\r\n\t}\r\n\r\n\treport.ThreatCountPctChange = pctChange(report.ThreatCountDelta, baseline.TotalThreats)\r\n\treport.RiskPctChange = pctChangeFloat(report.RiskDelta, baseline.GlobalMeanRisk)\r\n\r\n\tswitch {\r\n\tcase report.RiskDelta > 0:\r\n\t\treport.RiskTrend = \"increasing\"\r\n\tcase report.RiskDelta < 0:\r\n"]
[8278.411455, "o", "\t\treport.RiskTrend = \"decreasing\"\r\n\tdefault:\r\n\t\treport.RiskTrend = \"stable\"\r\n\t}\r\n\r\n\tactors := make(map[string]struct{}, len(baseline.CombinedActorCounts)+len(current.CombinedActorCounts))\r\n\tfor actor := range baseline.CombinedActorCounts {\r\n\t\tactors[actor] = struct{}{}\r\n\t}\r\n\tfor actor := range current.CombinedActorCounts {\r\n\t\tactors[actor] = struct{}{}\r\n"]
[8278.411515, "o", "\t}\r\n\r\n\tfor actor := range actors {\r\n\t\tbaseCount := baseline.CombinedActorCounts[actor]\r\n\t\tcurCount := current.CombinedActorCounts[actor]\r\n\t\treport.ActorCountDeltas[actor] = curCount - baseCount\r\n\r\n\t\t_, inBase := baseline.CombinedActorCounts[actor]\r\n\t\t_, inCur := current.CombinedActorCounts[actor]\r\n\t\tif inBase && inCur {\r\n\t\t\treport.PersistentActors = append(report.PersistentActors, actor)\r\n"]
[8278.411608, "o", "\t\t} else if inCur {\r\n\t\t\treport.NewActors = append(report.NewActors, actor)\r\n\t\t} else {\r\n\t\t\treport.GoneActors = append(report.GoneActors, actor)\r\n\t\t}\r\n\t}\r\n"]
[8278.411669, "o", "\tsort.Strings(report.NewActors)\r\n\tsort.Strings(report.GoneActors)\r\n\tsort.Strings(report.PersistentActors)\r\n\r\n\ttypes := make(map[string]struct{}, len(baseline.TypeCounts)+len(current.TypeCounts))\r\n\tfor t := range baseline.TypeCounts {\r\n\t\ttypes[t] = struct{}{}\r\n\t}\r\n\tfor t := range current.TypeCounts {\r\n\t\ttypes[t] = struct{}{}\r\n\t}\r\n\tfor t := range types {\r\n\t\treport.TypeShift[t] = current.TypeCounts[t] - baseline.TypeCounts[t]\r\n\t}\r\n\r\n\tout, err := json.Marshal(report)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: encoding diff report:\", err)\r\n\t\treturn 1\r\n"]
[8278.411727, "o", "\t}\r\n\tfmt.Println(string(out))\r\n\treturn 0\r\n}\r\n\r\nfunc pctChange(delta int, baseline int) float64 {\r\n\tif baseline == 0 {\r\n\t\tif delta > 0 {\r\n\t\t\treturn 100.0\r\n"]
[8278.411786, "o", "\t\t}\r\n\t\tif delta < 0 {\r\n\t\t\treturn -100.0\r\n\t\t}\r\n\t\treturn 0.0\r\n\t}\r\n\treturn round2(float64(delta) / float64(baseline) * 100.0)\r\n}\r\n\r\nfunc pctChangeFloat(delta float64, baseline float64) float64 {\r\n\tif baseline == 0 {\r\n\t\tif delta > 0 {\r\n\t\t\treturn 100.0"]
[8278.411844, "o", "\r\n\t\t}\r\n\t\tif delta < 0 {\r\n\t\t\treturn -100.0\r\n\t\t}\r\n\t\treturn 0.0\r\n\t}\r\n\treturn round2(delta / baseline * 100.0)\r\n}\r\n\r\nfunc riskCategoryRank(category string) int {\r\n\tswitch category {\r\n"]
[8278.411904, "o", "\tcase \"low\":\r\n\t\treturn 1\r\n\tcase \"medium\":\r\n\t\treturn 2\r\n\tcase \"high\":\r\n\t\treturn 3\r\n\tcase \"critical\":\r\n\t\treturn 4\r\n\tdefault:\r\n\t\treturn 0\r\n"]
[8278.411963, "o", "\t}\r\n}\r\n"]
[8278.412425, "o", "\u001b[?2004h"]
[8278.412483, "o", "root@n30009:/app# "]
[8278.683075, "i", "sed -n '1,50p' main.go\n"]
[8278.683344, "o", "sed -n '1,50p' main.go\r\n\u001b[?2004l\r"]
[8278.686134, "o", "package main\r\n\r\nimport (\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n"]
[8278.686269, "o", "\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|diff> [flags]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[8278.686373, "o", "\tvar code int\r\n\tswitch os.Args[1] {\r\n\tcase \"prioritize\":\r\n\t\tcode = runPrioritize(os.Args[2:])\r\n\tcase \"analyze\":\r\n\t\tcode = runAnalyze(os.Args[2:])\r\n\tcase \"summarize\":\r\n\t\tcode = runSummarize(os.Args[2:])\r\n\tcase \"filter\":\r\n\t\tcode = runFilter(os.Args[2:])\r\n\tcase \"respond\":\r\n\t\tcode = runRespond(os.Args[2:])\r\n\tcase \"enrich\":\r\n\t\tcode = runEnrich(os.Args[2:])\r\n\tcase \"correlate\":\r\n\t\tcode = runCorrelate(os.Args[2:])\r\n\tcase \"timeline\":\r\n\t\tcode = runTimeline(os.Args[2:])\r\n\tcase \"snapshot\":\r\n\t\tcode = runSnapshot(os.Args[2:])\r\n\tcase \"alert\":\r\n\t\tcode = runAlert(os.Args[2:])\r\n\tcase \"aggregate\":\r\n\t\tcode = runAggregate(os.Args[2:])\r\n\tcase \"diff\":\r\n\t\tcode = runDiff(os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n\t\tcode = 1\r\n\t}\r\n\tos.Exit(code)\r\n"]
[8278.686472, "o", "}\r\n\r\nfunc newFlagSet(name string) *flag.FlagSet {\r\n\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n"]
