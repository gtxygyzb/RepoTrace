[10908.59688, "o", "package main\r\n\r\nimport (\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[10908.59691, "o", ")\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n"]
[10908.597083, "o", "\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|track|diff|anomaly|forecast> [flags]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar code int\r\n\tswitch os.Args[1] {\r\n\tcase \"prioritize\":\r\n\t\tcode = runPrioritize(os.Args[2:])\r\n\tcase \"analyze\":\r\n\t\tcode = runAnalyze(os.Args[2:])\r\n\tcase \"summarize\":\r\n\t\tcode = runSummarize(os.Args[2:])\r\n\tcase \"filter\":\r\n\t\tcode = runFilter(os.Args[2:])\r\n\tcase \"respond\":\r\n\t\tcode = runRespond(os.Args[2:])\r\n\tcase \"enrich\":\r\n\t\tcode = runEnrich(os.Args[2:])\r\n\tcase \"correlate\":\r\n\t\tcode = runCorrelate(os.Args[2:])\r\n\tcase \"timeline\":\r\n\t\tcode = runTimeline(os.Args[2:])\r\n\tcase \"snapshot\":\r\n\t\tcode = runSnapshot(os.Args[2:])\r\n\tcase \"alert\":\r\n\t\tcode = runAlert(os.Args[2:])\r\n\tcase \"aggregate\":\r\n\t\tcode = runAggregate(os.Args[2:])\r\n"]
[10908.597196, "o", "\tcase \"diff\":\r\n\t\tcode = runDiff(os.Args[2:])\r\n\tcase \"anomaly\":\r\n\t\tcode = runAnomaly(os.Args[2:])\r\n"]
[10908.597289, "o", "\tcase \"track\":\r\n\t\tcode = runTrack(os.Args[2:])\r\n\tcase \"forecast\":\r\n\t\tcode = runForecast(os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n\t\tcode = 1\r\n\t}\r\n\tos.Exit(code)\r\n}\r\n\r\nfunc newFlagSet(name string) *flag.FlagSet {\r\n\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tfs.Usage = func() {}\r\n\treturn fs\r\n}\r\n\r\nfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn false\r\n\t}\r\n\treturn true\r\n}\r\n"]
[10908.59736, "o", "\r\nfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n\tset := false\r\n"]
[10908.597425, "o", "\tfs.Visit(func(f *flag.Flag) {\r\n\t\tif f.Name == name {\r\n\t\t\tset = true\r\n\t\t}\r\n\t})\r\n\treturn set\r\n}\r\n"]
[10908.597912, "o", "\u001b[?2004h"]
[10908.597976, "o", "root@n30009:/app# "]
[10908.884514, "i", "sed -n '1,220p' prioritize.go 2>/dev/null || sed -n '1,220p' aggregate.go\n"]
[10908.88505, "o", "sed -n '1,220p' prioritize.go 2>/dev/null || sed -n '1,220p' aggregate.go\r\n\u001b[?2004l\r"]
[10908.888125, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n"]
[10908.888241, "o", "\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\nconst (\r\n\twSeverity   = 0.30\r\n\twRecency    = 0.25\r\n\twRisk       = 0.25\r\n\twConfidence = 0.15\r\n\twActor      = 0.05\r\n)\r\n\r\nvar prioritySeverityRanks = map[string]int{\r\n\t\"none\":     0,\r\n\t\"low\":      1,\r\n\t\"medium\":   2,\r\n\t\"high\":     3,\r\n\t\"critical\": 4,\r\n}\r\n\r\ntype priorityComponents struct {\r\n\tSeverity   float64 `json:\"severity\"`\r\n"]
[10908.888332, "o", "\tRecency    float64 `json:\"recency\"`\r\n\tRisk       float64 `json:\"risk\"`\r\n\tConfidence float64 `json:\"confidence\"`\r\n\tActor      float64 `json:\"actor\"`\r\n}\r\n\r\ntype prioritizeOutput struct {\r\n\tSourceIP          string             `json:\"source_ip\"`\r\n\tThreatType        string             `json:\"threat_type\"`\r\n\tPriorityScore     float64            `json:\"priority_score\"`\r\n\tPriorityLabel     string             `json:\"priority_label\"`\r\n\tComponents        priorityComponents `json:\"components\"`\r\n\tEnrichedRiskScore float64            `json:\"enriched_risk_score\"`\r\n\tIOCSeverity       string             `json:\"ioc_severity\"`\r\n\tThreatActors      []string           `json:\"threat_actors\"`\r\n\tReferenceTime     string             `json:\"reference_time\"`\r\n}\r\n\r\nfunc runPrioritize(args []string) int {\r\n"]
[10908.888406, "o", "\tfs := newFlagSet(\"prioritize\")\r\n\trefStr := fs.String(\"reference-time\", \"\", \"reference timestamp for recency scoring (RFC3339)\")\r\n\tif !parseFlags(fs, args) {\r\n\t\treturn 1\r\n\t}\r\n\tif !isFlagSet(fs, \"reference-time\") || *refStr == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"missing --reference-time flag\")\r\n\t"]
[10908.888474, "o", "\treturn 1\r\n\t}\r\n\trefTime, err := parseTime(*refStr)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\r\n"]
[10908.888536, "o", "\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\r\n\tvar results []prioritizeOutput\r\n\tlineNo := 0\r\n\tfor scanner.Scan() {\r\n\t"]
[10908.8886, "o", "\tlineNo++\r\n\t\tline := scanner.Text()\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvar threat map[string]interface{}\r\n\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n\t\t\treturn 2\r\n\t\t}\r\n"]
[10908.888671, "o", "\t\tout, ok := prioritizeThreat(threat, refTime)\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tresults = append(results, out)\r\n\t}\r\n\tif err := scanner.Err(); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[10908.88873, "o", "\t\treturn 1\r\n\t}\r\n\r\n\tsort.SliceStable(results, func(i, j int) bool {\r\n\t\tif results[i].PriorityScore != results[j].PriorityScore {\r\n\t\t\treturn results[i].PriorityScore > results[j].PriorityScore\r\n\t\t}\r\n\t\treturn results[i].SourceIP < results[j].SourceIP\r\n\t})\r\n\r\n\twriter := bufio.NewWriter(os.Stdout)\r\n\tdefer writer.Flush()\r\n\tfor _, r := range results {\r\n"]
[10908.88879, "o", "\t\tb, err := json.Marshal(r)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"failed to encode output: %v\\n\", err)\r\n\t\t\treturn 1\r\n\t\t}\r\n\t\tfmt.Fprintln(writer, string(b))\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[10908.888861, "o", "\r\nfunc prioritizeThreat(threat map[string]interface{}, refTime time.Time) (prioritizeOutput, bool) {\r\n\tsourceIP := getStringDefault(threat, \"source_ip\")\r\n\tthreatType := getStringDefault(threat, \"threat_type\")\r\n\r\n\teventTime := threatReferenceTime(threat)\r\n\trefStr := \"\"\r\n\tif !eventTime.IsZero() {\r\n\t\trefStr = eventTime.UTC().Format(time.RFC3339)"]
[10908.888922, "o", "\r\n\t}\r\n\r\n\tageMinutes := 0.0\r\n\tif !eventTime.IsZero() {\r\n\t\tageMinutes = refTime.Sub(eventTime).Minutes()\r\n\t}\r\n\tif ageMinutes < 0 {\r\n\t\tageMinutes = 0\r\n\t}\r\n\trecency := math.Pow(2, -ageMinutes/30.0)\r\n\r\n"]
[10908.888988, "o", "\triskScore, _ := getFloat(threat, \"enriched_risk_score\")\r\n\trisk := riskScore / 500.0\r\n\tif risk > 1.0 {\r\n\t\trisk = 1.0\r\n\t}\r\n\tif risk < 0 {\r\n\t\trisk = 0\r\n\t}\r\n\r\n\tconfidence := 0.0\r\n\tif c, ok := getFloat(threat, \"max_ioc_confidence\"); ok {\r\n\t\tconfidence = c\r\n"]
[10908.889048, "o", "\t}\r\n\tif confidence < 0 {\r\n\t\tconfidence = 0\r\n\t}\r\n\tif confidence > 1 {\r\n\t\tconfidence = 1\r\n\t}\r\n\r\n\tactors := []string{}\r\n\tif a, ok := getStringSlice(threat, \"threat_actors\"); ok {\r\n\t\tactors = a\r\n"]
[10908.889107, "o", "\t}\r\n\tactor := float64(len(actors)) / 3.0\r\n\tif actor > 1.0 {\r\n\t\tactor = 1.0\r\n\t}\r\n\tif actor < 0 {\r\n\t\tactor = 0\r\n\t}\r\n\r\n\tseverity := getStringDefault(threat, \"ioc_severity\")\r\n"]
[10908.889167, "o", "\tseverityRank := prioritySeverityRanks[severity]\r\n\tseverityComponent := float64(severityRank) / 4.0\r\n\r\n\tscore := wSeverity*severityComponent +\r\n\t\twRecency*recency +\r\n\t\twRisk*risk +\r\n\t\twConfidence*confidence +\r\n\t\twActor*actor\r\n\r\n\tlabel := priorityLabel(score)\r\n\r\n\treturn prioritizeOutput{\r\n"]
[10908.889281, "o", "\t\tSourceIP:      sourceIP,\r\n\t\tThreatType:    threatType,\r\n\t\tPriorityScore: round4(score),\r\n\t\tPriorityLabel: label,\r\n\t\tComponents: priorityComponents{\r\n\t\t\tSeverity:   round4(severityComponent),\r\n\t\t\tRecency:    round4(recency),\r\n\t\t\tRisk:       round4(risk),\r\n\t\t\tConfidence: round4(confidence),\r\n"]
[10908.889352, "o", "\t\t\tActor:      round4(actor),\r\n\t\t},\r\n\t\tEnrichedRiskScore: riskScore,\r\n\t\tIOCSeverity:       severity,\r\n\t\tThreatActors:      actors,\r\n\t\tReferenceTime:     refStr,\r\n\t}, true\r\n}\r\n\r\n"]
[10908.889408, "o", "func priorityLabel(score float64) string {\r\n\tswitch {\r\n\tcase score >= 0.80:\r\n\t\treturn \"critical\"\r\n\tcase score >= 0.55:\r\n\t\treturn \"high\"\r\n\tcase score >= 0.30:\r\n\t\treturn \"medium\"\r\n\tdefault:\r\n\t\treturn \"low\"\r\n\t}\r\n}\r\n\r\nfunc round4(f float64) float64 {\r\n\treturn math.Round(f*10000) / 10000\r\n"]
[10908.889439, "o", "}\r\n"]
[10908.889944, "o", "\u001b[?2004h"]
