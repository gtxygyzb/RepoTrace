[8924.367632, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('main.go')\ns=p.read_text()\ns=s.replace('track|diff>', 'track|diff|anomaly>')\ns=s.replace('\\tcase \"diff\":\\n\\t\\tcode = runDiff(os.Args[2:])\\n', '\\tcase \"diff\":\\n\\t\\tcode = runDiff(os.Args[2:])\\n\\tcase \"anomaly\":\\n\\t\\tcode = runAnomaly(os.Args[2:])\\n')\np.write_text(s)\nPY\n"]
[8924.367814, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
