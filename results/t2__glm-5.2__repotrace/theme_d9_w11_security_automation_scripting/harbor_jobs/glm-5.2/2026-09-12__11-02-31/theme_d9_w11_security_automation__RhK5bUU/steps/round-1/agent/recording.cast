[1848.426355, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\n"]
[1848.426484, "o", "func runAnalyze(args []string) int {\r\n\tfs := newFlagSet(\"analyze\")\r\n\tchain := fs.Bool(\"chain\", false, \"perform attack chain correlation\")\r\n\tif !parseFlags(fs, args) {\r\n\t\treturn 1\r\n\t}\r\n\r\n\tevents, err := readEvents()\r\n\tif err != nil {\r\n\t\tthreats := detectThreats(events)\r\n\t\toutputThreats(threats)\r\n\t\tif *chain {\r\n\t\t\toutputChains(detectChains(threats))\r\n\t\t}\r\n"]
[1848.426574, "o", "\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tthreats := detectThreats(events)\r\n\toutputThreats(threats)\r\n\tif *chain {\r\n\t\toutputChains(detectChains(threats))\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc outputThreats(threats []Threat) {\r\n\tw := bufio.NewWriter(os.Stdout)\r\n\tdefer w.Flush()\r\n"]
[1848.426642, "o", "\tenc := json.NewEncoder(w)\r\n\tfor _, t := range threats {\r\n\t\tif err := enc.Encode(t); err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc outputChains(chains []Chain) {\r\n"]
[1848.426705, "o", "\tw := bufio.NewWriter(os.Stdout)\r\n\tdefer w.Flush()\r\n\tenc := json.NewEncoder(w)\r\n\tfor _, c := range chains {\r\n\t\tif err := enc.Encode(c); err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n}\r\n"]
[1848.427231, "o", "\u001b[?2004h"]
[1848.427319, "o", "root@n30009:/app# "]
