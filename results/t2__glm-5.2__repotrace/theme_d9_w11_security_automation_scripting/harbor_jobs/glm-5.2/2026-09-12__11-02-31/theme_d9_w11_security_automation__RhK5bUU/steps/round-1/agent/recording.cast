[7726.594497, "o", "func eventTime(e Event) (time.Time, bool) {\r\n\tt, err := parseTime(e.Timestamp)\r\n\treturn t, err == nil\r\n}\r\n\r\nfunc detectThreats(events []Event) []Threat {\r\n\tsortEvents(events)\r\n"]
[7726.594586, "o", "\tvar threats []Threat\r\n\tthreats = append(threats, detectBruteForce(events)...)\r\n\tthreats = append(threats, detectPortScan(events)...)\r\n\tthreats = append(threats, detectDataExfiltration(events)...)\r\n\tthreats = append(threats, detectPrivilegeEscalation(events)...)\r\n\tthreats = append(threats, detectLateralMovement(events)...)\r\n\tthreats = append(threats, detectDNSTunneling(events)...)\r\n\tsortThreats(threats)"]
[7726.594668, "o", "\r\n\treturn threats\r\n}\r\n\r\nfunc sortThreats(threats []Threat) {\r\n\tsort.SliceStable(threats, func(i, j int) bool {\r\n\t\tif threats[i].RiskScore != threats[j].RiskScore {\r\n\t\t\treturn threats[i].RiskScore > threats[j].RiskScore\r\n\t\t}\r\n\t\tif !threats[i].firstTime.Equal(threats[j].firstTime) {\r\n\t\t\treturn threats[i].firstTime.Before(threats[j].firstTime)\r\n\t\t}\r\n\t\treturn threats[i].ThreatType < threats[j].ThreatType\r\n"]
[7726.594736, "o", "\t})\r\n}\r\n\r\nfunc detectBruteForce(events []Event) []Threat {\r\n\tbyIP := make(map[string][]Event)\r\n"]
[7726.5951, "o", "\u001b[?2004hroot@n30009:/app# "]
