[11514.932591, "o", "-rw-r--r-- 1 root root    4389 Sep 12 06:07 histogram.go\r\n-rw-r--r-- 1 root root    1687 Sep 12 06:12 main.go\r\n-rw-r--r-- 1 root root    4765 Sep 12 05:54 prioritize.go\r\n-rw-r--r-- 1 root root    4674 Sep 12 03:20 respond.go\r\n-rwxr-xr-x 1 root root 3281997 Sep 12 06:12 \u001b[01;32msecsentinel\u001b[0m\r\n-rw-r--r-- 1 root root    6553 Sep 12 04:39 snapshot.go\r\n-rw-r--r-- 1 root root    6557 Sep 12 03:29 summarize.go\r\n-rw-r--r-- 1 root root   14620 Sep 12 03:20 threats.go\r\n-rw-r--r-- 1 root root    9522 Sep 12 05:06 timeline.go\r\n-rw-r--r-- 1 root root    4379 Sep 12 05:25 track.go\r\n"]
