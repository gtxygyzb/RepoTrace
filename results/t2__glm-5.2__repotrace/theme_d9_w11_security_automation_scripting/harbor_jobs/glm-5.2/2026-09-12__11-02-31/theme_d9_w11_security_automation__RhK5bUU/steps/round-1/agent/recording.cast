[7733.833684, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n"]
[7733.833776, "o", "\r\ntype Threat struct {\r\n\tThreatType       string\r\n\tSourceIP         string\r\n\tDestIP           string\r\n\tCount            int\r\n\tFirstSeen        string\r\n\tLastSeen         string\r\n\tTargetUsers      []string\r\n\tRiskScore        float64\r\n\tPortsScanned     []int\r\n\tTotalBytes       int64\r\n\tDestIPs          []string\r\n\tUser             string\r\n\tTimestamp        string\r\n\tPriorFailures    int\r\n"]
[7733.833868, "o", "\tCompromisedHosts []string\r\n\tQueryCount       int\r\n\tAvgPayload       float64\r\n\r\n\tfirstTime time.Time\r\n\tlastTime  time.Time\r\n}\r\n"]
[7733.833945, "o", "\r\nfunc (t Threat) MarshalJSON() ([]byte, error) {\r\n\tswitch t.ThreatType {\r\n\tcase \"brute_force\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType  string   `json:\"threat_type\"`\r\n\t\t\tSourceIP    string   `json:\"source_ip\"`\r\n\t\t\tCount       int      `json:\"count\"`\r\n\t\t\tFirstSeen   string   `json:\"first_seen\"`\r\n\t\t\tLastSeen    string   `json:\"last_seen\"`\r\n\t\t\tTargetUsers []string `json:\"target_users\"`\r\n\t\t\tRiskScore   float64  `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType:  t.ThreatType,\r\n\t\t\tSourceIP:    t.SourceIP,"]
[7733.834018, "o", "\r\n\t\t\tCount:       t.Count,\r\n\t\t\tFirstSeen:   t.FirstSeen,\r\n\t\t\tLastSeen:    t.LastSeen,\r\n\t\t\tTargetUsers: nonNilStrings(t.TargetUsers),\r\n\t\t\tRiskScore:   t.RiskScore,\r\n\t\t})\r\n\tcase \"port_scan\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType   string  `json:\"threat_type\"`\r\n\t\t\tSourceIP     string  `json:\"source_ip\"`\r\n\t\t\tDestIP       string  `json:\"dest_ip\"`\r\n\t\t\tPortsScanned []int   `json:\"ports_scanned\"`\r\n\t\t\tFirstSeen    string  `json:\"first_seen\"`\r\n\t\t\tLastSeen     string  `json:\"last_seen\"`\r\n\t\t\tRiskScore    float64 `json:\"risk_score\"`\r\n\t"]
[7733.834099, "o", "\t}{\r\n\t\t\tThreatType:   t.ThreatType,\r\n\t\t\tSourceIP:     t.SourceIP,\r\n\t\t\tDestIP:       t.DestIP,\r\n\t\t\tPortsScanned: nonNilInts(t.PortsScanned),\r\n"]
[7733.834172, "o", "\t\t\tFirstSeen:    t.FirstSeen,\r\n\t\t\tLastSeen:     t.LastSeen,\r\n\t\t\tRiskScore:    t.RiskScore,\r\n\t\t})\r\n\tcase \"data_exfiltration\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType string   `json:\"threat_type\"`\r\n\t\t\tSourceIP   string   `json:\"source_ip\"`\r\n\t\t\tTotalBytes int64    `json:\"total_bytes\"`\r\n\t\t\tFirstSeen  string   `json:\"first_seen\"`\r\n\t\t\tLastSeen   string   `json:\"last_seen\"`\r\n\t\t\tDestIPs    []string `json:\"dest_ips\"`\r\n\t\t\tRiskScore  float64  `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType: t.ThreatType,\r\n"]
[7733.834282, "o", "\t\t\tSourceIP:   t.SourceIP,\r\n\t\t\tTotalBytes: t.TotalBytes,\r\n\t\t\tFirstSeen:  t.FirstSeen,\r\n\t\t\tLastSeen:   t.LastSeen,\r\n\t\t\tDestIPs:    nonNilStrings(t.DestIPs),\r\n\t\t\tRiskScore:  t.RiskScore,\r\n\t\t})\r\n\tcase \"privilege_escalation\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType    string  `json:\"threat_type\"`\r\n\t\t\tUser          string  `json:\"user\"`\r\n\t\t\tSourceIP      string  `json:\"source_ip\"`\r\n"]
[7733.834358, "o", "\t\t\tTimestamp     string  `json:\"timestamp\"`\r\n\t\t\tPriorFailures int     `json:\"prior_failures\"`\r\n\t\t\tRiskScore     float64 `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType:    t.ThreatType,\r\n\t\t\tUser:          t.User,\r\n\t\t\tSourceIP:      t.SourceIP,\r\n\t\t\tTimestamp:     t.Timestamp,\r\n\t\t\tPriorFailures: t.PriorFailures,\r\n\t\t\tRiskScore:     t.RiskScore,\r\n\t\t})\r\n\tcase \"lateral_movement\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\t"]
[7733.834427, "o", "ThreatType       string   `json:\"threat_type\"`\r\n\t\t\tSourceIP         string   `json:\"source_ip\"`\r\n\t\t\tCompromisedHosts []string `json:\"compromised_hosts\"`\r\n\t\t\tFirstSeen        string   `json:\"first_seen\"`\r\n\t\t\tLastSeen         string   `json:\"last_seen\"`\r\n\t\t\tRiskScore        float64  `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType:       t.ThreatType,\r\n\t\t\tSourceIP:         t.SourceIP,\r\n"]
[7733.834503, "o", "\t\t\tCompromisedHosts: nonNilStrings(t.CompromisedHosts),\r\n\t\t\tFirstSeen:        t.FirstSeen,\r\n\t\t\tLastSeen:         t.LastSeen,\r\n\t\t\tRiskScore:        t.RiskScore,\r\n\t\t})\r\n\tcase \"dns_tunneling\":\r\n\t\treturn json.Marshal(struct {\r\n\t\t\tThreatType string  `json:\"threat_type\"`\r\n\t\t\tSourceIP   string  `json:\"source_ip\"`\r\n\t\t\tQueryCount int     `json:\"query_count\"`\r\n\t\t\tAvgPayload float64 `json:\"avg_payload\"`\r\n"]
[7733.834574, "o", "\t\t\tFirstSeen  string  `json:\"first_seen\"`\r\n\t\t\tLastSeen   string  `json:\"last_seen\"`\r\n\t\t\tRiskScore  float64 `json:\"risk_score\"`\r\n\t\t}{\r\n\t\t\tThreatType: t.ThreatType,\r\n\t\t\tSourceIP:   t.SourceIP,\r\n\t\t\tQueryCount: t.QueryCount,\r\n\t\t\tAvgPayload: t.AvgPayload,\r\n\t\t\tFirstSeen:  t.FirstSeen,\r\n\t\t\tLastSeen:   t.LastSeen,\r\n\t\t\tRiskScore:  t.RiskScore,"]
[7733.83465, "o", "\r\n\t\t})\r\n\t}\r\n\treturn json.Marshal(struct {\r\n\t\tThreatType string  `json:\"threat_type\"`\r\n\t\tRiskScore  float64 `json:\"risk_score\"`\r\n\t}{\r\n\t\tThreatType: t.ThreatType,\r\n\t\tRiskScore:  t.RiskScore,\r\n\t})\r\n}\r\n\r\n"]
[7733.834729, "o", "func nonNilStrings(s []string) []string {\r\n\tif s == nil {\r\n\t\treturn []string{}\r\n\t}\r\n\treturn s\r\n}\r\n\r\nfunc nonNilInts(s []int) []int {\r\n\tif s == nil {\r\n\t\treturn []int{}\r\n\t}\r\n\treturn s\r\n}\r\n\r\nfunc sortEvents(events []Event) {\r\n\tsort.SliceStable(events, func(i, j int) bool {\r\n\t\tti, errI := parseTime(events[i].Timestamp)\r\n"]
[7733.834796, "o", "\t\ttj, errJ := parseTime(events[j].Timestamp)\r\n\t\tif errI == nil && errJ == nil {\r\n\t\t\tif ti.Before(tj) {\r\n\t\t\t\treturn true\r\n\t\t\t}\r\n\t\t\tif tj.Before(ti) {\r\n"]
