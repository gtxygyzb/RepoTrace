[6263.697636, "o", "package main\r\n\r\nimport (\r\n\"bufio\"\r\n"]
[6263.697713, "o", "\"encoding/json\"\r\n\"fmt\"\r\n\"os\"\r\n\"regexp\"\r\n\"sort\"\r\n\"time\"\r\n)\r\n\r\ntype alertRule struct {\r\nID          string          `json:\"id\"`\r\nName        string          `json:\"name\"`\r\nPriority    int             `json:\"priority\"`\r\nConditions  ruleConditions  `json:\"conditions\"`\r\nactorRegex  *regexp.Regexp `json:\"-\"`\r\n}\r\n"]
[6263.697793, "o", "\r\ntype ruleConditions struct {\r\nThreatTypes      []string `json:\"threat_types\"`\r\nMinEnrichedRisk  *float64 `json:\"min_enriched_risk\"`\r\nMinSeverityRank  *int     `json:\"min_severity_rank\"`\r\nActorPattern     *string  `json:\"actor_pattern\"`\r\n}\r\n\r\n"]
[6263.69786, "o", "type alertOutput struct {\r\nRuleID            string   `json:\"rule_id\"`\r\nRuleName          string   `json:\"rule_name\"`\r\nAlertPriority     float64  `json:\"alert_priority\"`\r\nThreatType        string   `json:\"threat_type\"`\r\nSourceIP          string   `json:\"source_ip\"`\r\nEnrichedRiskScore float64  `json:\"enriched_risk_score\"`\r\nIocSeverity       string   `json:\"ioc_severity\"`\r\nReferenceTime     string   `json:\"reference_time\"`\r\nMatchedActors     []string `json:\"matched_actors\"`\r\n}\r\n\r\ntype dedupEntry struct {\r\nruleID      string\r\nsourceIP    string\r\nrefTime     time.Time\r\nthreat      map[string]interface{}\r\nalert       alertOutput\r\nrule        alertRule\r\nemitted     bool\r\n}\r\n\r\n"]
[6263.69793, "o", "func runAlert(args []string) int {\r\nfs := newFlagSet(\"alert\")\r\nrulesPath := fs.String(\"rules\", \"\", \"path to alert rules JSON file\")\r\ndedupWindow := fs.Int(\"dedup-window\", 0, \"deduplication window in minutes\")\r\nif !parseFlags(fs, args) {\r\nreturn 1\r\n}\r\nif !isFlagSet(fs, \"rules\") || *rulesPath == \"\" {\r\nfmt.Fprintln(os.Stderr, \"error: --rules flag is required\")\r\nreturn 1\r\n}\r\n\r\nrules, err := loadAlertRules(*rulesPath)\r\nif err != nil {"]
[6263.697993, "o", "\r\nfmt.Fprintln(os.Stderr, err)\r\nreturn 1\r\n}\r\n\r\nscanner := bufio.NewScanner(os.Stdin)\r\nscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\nw := bufio.NewWriter(os.Stdout)\r\ndefer w.Flush()\r\nenc := json.NewEncoder(w)\r\n\r\nvar dedup []*dedupEntry\r\nlineNo := 0\r\nfor scanner.Scan() {\r\nlineNo++"]
[6263.698057, "o", "\r\nline := scanner.Text()\r\nif line == \"\" {\r\ncontinue\r\n}\r\nvar threat map[string]interface{}\r\nif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\nfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\nreturn 2\r\n}\r\n\r\nfor _, rule := range rules {\r\nmatched, alert := matchAlertRule(threat, rule)\r\nif !matched {\r\ncontinue\r\n"]
[6263.698119, "o", "}\r\n\r\nif *dedupWindow > 0 {\r\nnow := alertReferenceTime(threat)\r\nwindow := time.Duration(*dedupWindow) * time.Minute\r\nexisting := findDedupEntry(dedup, rule.ID, alert.SourceIP, now, window)\r\nif existing != nil {\r\nif alert.EnrichedRiskScore > existing.alert.EnrichedRiskScore {\r\nexisting.threat = threat\r\nexisting.alert = alert\r\nexisting.refTime = now\r\nexisting.rule = rule\r\n"]
[6263.698182, "o", "}\r\ncontinue\r\n}\r\nentry := &dedupEntry{\r\nruleID:      rule.ID,\r\nsourceIP:    alert.SourceIP,\r\nrefTime:     now,\r\nthreat:      threat,\r\nalert:       alert,\r\nrule:        rule,\r\nemitted:     false,\r\n}\r\ndedup = append(dedup, entry)\r\ncontinue\r\n"]
[6263.698287, "o", "}\r\n\r\nif err := enc.Encode(alert); err != nil {\r\nfmt.Fprintln(os.Stderr, err)\r\nreturn 1\r\n}\r\n}\r\n}\r\nif err := scanner.Err(); err != nil {\r\nfmt.Fprintln(os.Stderr, err)\r\nreturn 1\r\n}\r\n\r\nif *dedupWindow > 0 {\r\nfor _, entry := range dedup {\r\nif err := enc.Encode(entry.alert); err != nil {\r\n"]
[6263.698351, "o", "fmt.Fprintln(os.Stderr, err)\r\nreturn 1\r\n}\r\n}\r\n}\r\nreturn 0\r\n"]
[6263.698415, "o", "}\r\n\r\nfunc loadAlertRules(path string) ([]alertRule, error) {\r\ndata, err := os.ReadFile(path)\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nvar rules []alertRule\r\nif err := json.Unmarshal(data, &rules); err != nil {\r\nreturn nil, err\r\n}\r\nfor i := range rules {\r\nif rules[i].Conditions.ActorPattern != nil && *rules[i].Conditions.ActorPattern != \"\" {\r\nre, err := regexp.Compile(\"^\" + *rules[i].Conditions.ActorPattern + \"$\")\r\nif err != nil {\r\nreturn nil, fmt.Errorf(\"invalid actor_pattern in rule %s: %w\", rules[i].ID, err)\r\n}\r\nrules[i].actorRegex = re\r\n}\r\n}\r\n"]
[6263.698483, "o", "return rules, nil\r\n}\r\n\r\nfunc matchAlertRule(threat map[string]interface{}, rule alertRule) (bool, alertOutput) {\r\nthreatType, _ := getString(threat, \"threat_type\")\r\nsourceIP, _ := getString(threat, \"source_ip\")\r\nvar enrichedRisk float64\r\nif v, ok := getFloat(threat, \"enriched_risk_score\"); ok {\r\nenrichedRisk = v\r\n}\r\niocSeverity, _ := getString(threat, \"ioc_severity\")\r\nactors, _ := getStringSlice(threat, \"threat_actors\")\r\nif actors == nil {\r\n"]
[6263.698553, "o", "actors = []string{}\r\n}\r\n\r\nif len(rule.Conditions.ThreatTypes) > 0 {\r\nif !containsString(rule.Conditions.ThreatTypes, threatType) {\r\nreturn false, alertOutput{}\r\n}\r\n}\r\nif rule.Conditions.MinEnrichedRisk != nil {\r\n"]
[6263.69862, "o", "if enrichedRisk < *rule.Conditions.MinEnrichedRisk {\r\nreturn false, alertOutput{}\r\n}\r\n}\r\nif rule.Conditions.MinSeverityRank != nil {\r\nif severityValue(iocSeverity) < *rule.Conditions.MinSeverityRank {\r\nreturn false, alertOutput{}\r\n}\r\n}\r\n\r\nmatchedActors := actors\r\nif rule.actorRegex != nil {\r\nmatchedActors = []string{}\r\nfor _, actor := range actors {\r\n"]
[6263.698689, "o", "if rule.actorRegex.MatchString(actor) {\r\nmatchedActors = append(matchedActors, actor)\r\n}\r\n}\r\nif len(matchedActors) == 0 {\r\nreturn false, alertOutput{}\r\n}\r\n}\r\nsort.Strings(matchedActors)\r\nif matchedActors == nil {\r\nmatchedActors = []string{}\r\n}\r\n\r\nalert := alertOutput{\r\nRuleID:            rule.ID,\r\n"]
[6263.698732, "o", "RuleName:          rule.Name,\r\nAlertPriority:     float64(rule.Priority) * enrichedRisk,\r\nThreatType:        threatType,\r\nSourceIP:          sourceIP,\r\nEnrichedRiskScore: enrichedRisk,\r\nIocSeverity:       iocSeverity,\r\nReferenceTime:     alertReferenceTimeString(threat),\r\nMatchedActors:     matchedActors,\r\n}\r\nreturn true, alert\r\n}\r\n\r\nfunc findDedupEntry(entries []*dedupEntry, ruleID, sourceIP string, now time.Time, window time.Duration) *dedupEntry {\r\nfor _, e := range entries {\r\nif e.ruleID != ruleID || e.sourceIP != sourceIP {\r\n"]
[6263.698819, "o", "continue\r\n}\r\nif !e.refTime.Before(now.Add(-window)) && !e.refTime.After(now.Add(window)) {\r\nreturn e\r\n}\r\n}\r\nreturn nil\r\n}\r\n\r\nfunc alertReferenceTime(threat map[string]interface{}) time.Time {\r\nif ts, ok := getString(threat, \"reference_time\"); ok {\r\nif t, err := parseTime(ts); err == nil {\r\nreturn t\r\n}\r\n}\r\nreturn threatReferenceTime(threat)\r\n}\r\n\r\nfunc alertReferenceTimeString(threat map[string]interface{}) string {\r\nif ts, ok := getString(threat, \"reference_time\"); ok {\r\nreturn ts\r\n}\r\n"]
[6263.698892, "o", "t := threatReferenceTime(threat)\r\nif t.IsZero() {\r\nreturn \"\"\r\n}\r\nreturn t.UTC().Format(time.RFC3339)\r\n}\r\n\r\nfunc containsString(list []string, s string) bool {\r\nfor _, item := range list {\r\nif item == s {\r\nreturn true\r\n}\r\n}\r\n"]
