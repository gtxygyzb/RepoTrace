[8445.047007, "o", "\t\treturn events[i].Timestamp < events[j].Timestamp\r\n\t})\r\n}\r\n\r\nfunc uniqueSortedStrings(input []string) []string {\r\n\tseen := make(map[string]bool)\r\n\tvar out []string\r\n\tfor _, s := range input {\r\n\t\tif !seen[s] {\r\n\t\t\tseen[s] = true\r\n\t\t\tout = append(out, s)\r\n\t\t}\r\n"]
