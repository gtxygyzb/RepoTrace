[714.499187, "i", "cat > chain.go <<'EOF'\npackage main\n\nimport (\n    \"encoding/json\"\n    \"sort\"\n    \"time\"\n)\n\ntype Chain struct {\n    ChainType      string\n    SourceIP       string\n    Stages         []string\n    TotalRiskScore float64\n    FirstSeen      string\n    LastSeen       string\n    firstTime      time.Time\n    lastTime       time.Time\n}\n\nfunc (c Chain) MarshalJSON() ([]byte, error) {\n    return json.Marshal(struct {\n        ChainType      string   `json:\"chain_type\"`\n        SourceIP       string   `json:\"source_ip\"`\n        Stages         []string `json:\"stages\"`\n        TotalRiskScore float64  `json:\"total_risk_score\"`\n        FirstSeen      string   `json:\"first_seen\"`\n        LastSeen       string   `json:\"last_seen\"`\n    }{\n        ChainType:      c.ChainType,\n        SourceIP:       c.SourceIP,\n        Stages:         nonNilStrings(c.Stages),\n        TotalRiskScore: c.TotalRiskScore,\n        FirstSeen:      c.FirstSeen,\n        LastSeen:       c.LastSeen,\n    })\n}\n\nfunc detectChains(threats []Threat) []Chain {\n "]
[714.499497, "i", "   byIP := make(map[string][]Threat)\n    for _, t := range threats {\n        byIP[t.SourceIP] = append(byIP[t.SourceIP], t)\n    }\n\n    var chains []Chain\n    for ip, ts := range byIP {\n        chains = append(chains, detectReconExploitExfil(ip, ts)...)\n        chains = append(chains, detectCredentialLateral(ip, ts)...)\n    }\n\n    sortChains(chains)\n    return chains\n}\n\nfunc detectReconExploitExfil(ip string, threats []Threat) []Chain {\n    var portScans []Threat\n    var exploits []Threat\n    var exfils []Threat\n    for _, t := range threats {\n        switch t.ThreatType {\n        case \"port_scan\":\n            portScans = append(portScans, t)\n        case \"brute_force\", \"privilege_escalation\":\n            exploits = append(exploits, t)\n        case \"data_exfiltration\":\n            exfils = append(exfils, t)\n        }\n    }\n\n    sortThreatsByFirstSeen(portScans)\n    sortThreatsByFirstSeen(exploits)\n    sortThreatsByFirstSeen(exfils)\n\n    for _, ps := range portScans {\n        for _, ex := range exploits {\n     "]
[714.499533, "o", "cat > chain.go <<'EOF'\r\n\u001b[?2004l\r"]
[714.49984, "i", "       if !ex.firstTime.After(ps.firstTime) {\n                continue\n            }\n            for _, ef := range exfils {\n                if !ef.firstTime.After(ex.firstTime) {\n                    continue\n                }\n                stages := []string{ps.ThreatType, ex.ThreatType, ef.ThreatType}\n                first := ps.firstTime\n                last := ps.lastTime\n                if ex.firstTime.Before(first) {\n                    first = ex.firstTime\n                }\n                if ef.firstTime.Before(first) {\n                    first = ef.firstTime\n                }\n                if ex.lastTime.After(last) {\n                    last = ex.lastTime\n                }\n                if ef.lastTime.After(last) {\n                    last = ef.lastTime\n                }\n                return []Chain{{\n                    ChainType:      \"recon_exploit_exfil\",\n                    SourceIP:       ip,\n                    Stages:         stages,\n                    TotalRiskScore: ps.RiskScore "]
[714.499866, "o", "   byIP := make(map[string][]Threat)\r\n    for _, t := range threats {\r\n        byIP[t.SourceIP] = append(byIP[t.SourceIP], t)\r\n    }\r\n\r\n    var chains []Chain\r\n    for ip, ts := range byIP {\r\n        chains = append(chains, detectReconExploitExfil(ip, ts)...)\r\n      "]
[714.500014, "i", "+ ex.RiskScore + ef.RiskScore,\n                    FirstSeen:      first.Format(time.RFC3339),\n                    LastSeen:       last.Format(time.RFC3339),\n                    firstTime:      first,\n                    lastTime:       last,\n                }}\n            }\n        }\n    }\n    return nil\n}\n\nfunc detectCredentialLateral(ip string, threats []Threat) []Chain {\n    var brute []Threat\n    var lateral []Threat\n    for _, t := range threats {\n        switch t.ThreatType {\n        case \"brute_force\":\n            brute = append(brute, t)\n        case \"lateral_movement\":\n            lateral = append(lateral, t)\n        }\n    }\n\n    sortThreatsByFirstSeen(brute)\n    sortThreatsByFirstSeen(lateral)\n\n    for _, b := range brute {\n        for _, l := range lateral {\n            if !l.firstTime.After(b.firstTime) {\n                continue\n            }\n            stages := []string{b.ThreatType, l.ThreatType}\n            first := b.firstTime\n            last := b.lastTime\n            if l.firstTime.Befor"]
[714.500105, "o", "  chains = append(chains, detectCredentialLateral(ip, ts)...)\r\n    }\r\n\r\n    sortChains(chains)\r\n    return chains\r\n}\r\n\r\nfunc detectReconExploitExfil(ip string, threats []Threat) ["]
[714.500198, "i", "e(first) {\n                first = l.firstTime\n            }\n            if l.lastTime.After(last) {\n                last = l.lastTime\n            }\n            return []Chain{{\n                ChainType:      \"credential_lateral\",\n                SourceIP:       ip,\n                Stages:         stages,\n                TotalRiskScore: b.RiskScore + l.RiskScore,\n                FirstSeen:      first.Format(time.RFC3339),\n                LastSeen:       last.Format(time.RFC3339),\n                firstTime:      first,\n                lastTime:       last,\n            }}\n        }\n    }\n    return nil\n}\n\nfunc sortThreatsByFirstSeen(threats []Threat) {\n    sort.SliceStable(threats, func(i, j int) bool {\n        return threats[i].firstTime.Before(threats[j].firstTime)\n    })\n}\n\nfunc sortChains(chains []Chain) {\n    sort.SliceStable(chains, func(i, j int) bool {\n        if chains[i].TotalRiskScore != chains[j].TotalRiskScore {\n            return chains[i].TotalRiskScore > chains[j].TotalRiskScore\n        }\n     "]
