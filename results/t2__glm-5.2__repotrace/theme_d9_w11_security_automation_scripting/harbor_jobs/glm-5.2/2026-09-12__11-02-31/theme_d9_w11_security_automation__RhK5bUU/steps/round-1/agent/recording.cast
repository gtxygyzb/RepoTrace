[4131.07142, "o", "   426\t\t\t\t})\r\n   427\t\t\t\twinner := cands[0].activeIdx\r\n   428\t\t\t\tmatchedFields[winner][field] = true\r\n   429\t\t\t}\r\n   430\t\t}\r\n   431\t\r\n   432\t\tmatches := make([]iocMatchInternal, 0, len(active))\r\n   433\t\tfor i, a := range active {\r\n   434\t\t\tif len(matchedFields[i]) == 0 {\r\n   435\t\t\t\tcontinue\r\n   436\t\t\t}\r\n   437\t\t\tfields := sortedKeys(matchedFields[i])\r\n   438\t\t\tadjusted := a.base * maxFieldMultiplier(fields)\r\n   439\t\t\tmatches = append(matches, iocMatchInternal{\r\n   440\t\t\t\tp:             a.p,\r\n   441\t\t\t\tbase:          a.base,\r\n   442\t\t\t\tfreshness:     a.factor,\r\n   443\t\t\t\tadjusted:      adjusted,\r\n   444\t\t\t\tmatchedFields: fields,\r\n   445\t\t\t})\r\n   446"]
[4131.071486, "o", "\t\t}\r\n   447\t\r\n   448\t\tsort.SliceStable(matches, func(i, j int) bool {\r\n   449\t\t\tif matches[i].adjusted != matches[j].adjusted {\r\n   450\t\t\t\treturn matches[i].adjusted > matches[j].adjusted\r\n   451\t\t\t}\r\n   452\t\t\treturn matches[i].p.entry.ID < matches[j].p.entry.ID\r\n   453\t\t})\r\n   454\t\treturn matches\r\n   455\t}\r\n"]
[4131.071616, "o", "   456\t\r\n   457\tfunc computeFreshness(p processedIOC, refTime time.Time) (float64, float64, bool) {\r\n   458\t\tageHours := refTime.Sub(p.lastUpdated).Hours()\r\n   459\t\tfreshnessFraction := ageHours / float64(p.ttlHours)\r\n   460\t\tif freshnessFraction >= 1.0 {\r\n   461\t\t\treturn 0, 0, false\r\n   462\t\t}\r\n   463\t\tfactor := freshnessFactor(freshnessFraction)\r\n   464\t\treturn p.entry.Confidence * factor, factor, true\r\n   465\t}\r\n   466\t\r\n   467\tfunc freshnessFactor(fraction float64) float64 {\r\n   468\t\tswitch {\r\n   469\t\tcase fraction < 0.25:\r\n   470\t\t\treturn 1.0\r\n   471\t\tcase fraction < 0.50:\r\n   472"]
[4131.071685, "o", "\t\t\treturn 0.9\r\n   473\t\tcase fraction < 0.75:\r\n   474\t\t\treturn 0.7\r\n   475\t\tdefault:\r\n"]
[4131.071745, "o", "   476\t\t\treturn 0.5\r\n   477\t\t}\r\n   478\t}\r\n   479\t\r\n   480\tfunc fieldMultiplier(field string) float64 {\r\n   481\t\tswitch field {\r\n   482\t\tcase \"source_ip\", \"dest_ip\", \"compromised_hosts\", \"user\":\r\n   483\t\t\treturn 1.0\r\n   484\t\tcase \"dest_ips\", \"target_users\":\r\n   485\t\t\treturn 0.8\r\n   486\t\tcase \"ports_scanned\":\r\n   487\t\t\treturn 0.6\r\n   488\t\tdefault:\r\n   489\t\t\treturn 0.0\r\n   490\t\t}\r\n   491\t}\r\n"]
[4131.07178, "o", "   492\t\r\n   493\tfunc maxFieldMultiplier(fields []string) float64 {\r\n   494\t\tmax := 0.0\r\n   495\t\tfor _, f := range fields {\r\n   496\t\t\tif m := fieldMultiplier(f); m > max {\r\n   497\t"]
[4131.071864, "o", "\t\t\tmax = m\r\n   498\t\t\t}\r\n   499\t\t}\r\n   500\t\treturn max\r\n   501\t}\r\n   502\t\r\n   503\tfunc tagBonusValue(tag string) float64 {\r\n   504\t\tswitch tag {\r\n   505\t\tcase \"apt\":\r\n   506\t\t\treturn 100.0\r\n   507\t\tcase \"ransomware\":\r\n"]
[4131.071938, "o", "   508\t\t\treturn 75.0\r\n   509\t\tcase \"botnet\":\r\n   510\t\t\treturn 50.0\r\n   511\t\tcase \"phishing\":\r\n   512\t\t\treturn 30.0\r\n   513\t\tcase \"scanner\":\r\n   514\t\t\treturn 25.0\r\n   515\t\tcase \"cryptominer\":\r\n   516\t\t\treturn 20.0\r\n   517\t\tdefault:\r\n   518\t\t\treturn 0.0\r\n   519\t\t}\r\n"]
[4131.072021, "o", "   520\t}\r\n   521\t\r\n   522\tfunc severityWeight(s string) int {\r\n   523\t\tswitch s {\r\n   524\t\tcase \"low\":\r\n   525\t\t\treturn 5\r\n   526\t\tcase \"medium\":\r\n   527\t\t\treturn 10\r\n   528\t\tcase \"high\":\r\n   529\t\t\treturn 20\r\n   530\t\tcase \"critical\":\r\n   531"]
[4131.072083, "o", "\t\t\treturn 40\r\n   532\t\tdefault:\r\n   533\t\t\treturn 0\r\n   534\t\t}\r\n   535\t}\r\n"]
[4131.072146, "o", "   536\t\r\n   537\tfunc severityFromRank(rank int) string {\r\n   538\t\tswitch rank {\r\n   539\t\tcase 1:\r\n   540\t\t\treturn \"low\"\r\n   541\t\tcase 2:\r\n   542\t\t\treturn \"medium\"\r\n   543\t\tcase 3:\r\n   544\t\t\treturn \"high\"\r\n   545\t\tcase 4:\r\n   546\t\t\treturn \"critical\"\r\n   547\t\tdefault:\r\n   548\t\t\treturn \"none\"\r\n   549\t\t}\r\n   550\t}\r\n"]
[4131.072228, "o", "   551\t\r\n   552\tfunc threatReferenceTime(threat map[string]interface{}) time.Time {\r\n   553\t\tif tt, ok := getString(threat, \"threat_type\"); ok && tt == \"privilege_escalation\" {\r\n   554\t\t\tif ts, ok := getString(threat, \"timestamp\"); ok {\r\n   555\t\t\t\tif t, err := parseTime(ts); err == nil {\r\n   556\t\t\t\t\treturn t\r\n   557\t\t\t\t}\r\n   558\t\t\t}\r\n   559\t\t}\r\n   560\t\tif ts, ok := getString(threat, \"first_seen\"); ok {\r\n   561\t\t"]
[4131.072327, "o", "\tif t, err := parseTime(ts); err == nil {\r\n   562\t\t\t\treturn t\r\n   563\t\t\t}\r\n   564\t\t}\r\n"]
[4131.072412, "o", "   565\t\treturn time.Time{}\r\n   566\t}\r\n   567\t\r\n   568\tfunc sortEnrichedThreats(threats []map[string]interface{}) {\r\n   569\t\tsort.SliceStable(threats, func(i, j int) bool {\r\n   570\t\t\ta := threats[i]\r\n   571\t\t\tb := threats[j]\r\n   572\t\t\tea, _ := getFloat(a, \"enriched_risk_score\")\r\n   573\t\t\teb, _ := getFloat(b, \"enriched_risk_score\")\r\n   574\t\t\tif ea != eb {\r\n   575\t\t\t\treturn ea > eb\r\n   576\t\t\t}\r\n   577\t\t\tta := threatSortTime(a)\r\n   578\t\t\ttb := threatSortTime(b)\r\n   579\t\t\tif !ta.Equal(tb) {\r\n   580\t\t\t\treturn ta.Before(tb)\r\n   581\t\t\t}\r\n   582\t\t\ttta, _ := getString(a, \"threat_type\")\r\n   583\t\t\tttb, _ := getString(b, \"threat_type\")\r\n   584\t\t\treturn tta < ttb\r\n   585\t\t})\r\n   586\t}\r\n   587\t\r\n"]
[4131.072478, "o", "   588\tfunc threatSortTime(threat map[string]interface{}) time.Time {\r\n   589\t\tif tt, ok := getString(threat, \"threat_type\"); ok && tt == \"privilege_escalation\" {\r\n   590\t\t\tif ts, ok := getString(threat, \"timestamp\"); ok {\r\n   591\t\t\t\tif t, err := parseTime(ts); err == nil {\r\n   592\t\t\t\t\treturn t\r\n   593\t\t\t\t}\r\n   594\t\t\t}\r\n   595\t\t}\r\n   596\t\tif ts, ok := getString(threat, \"first_seen\"); ok {\r\n   597\t\t\tif t, err := parseTime(ts); err == nil {\r\n   598"]
[4131.072536, "o", "\t\t\t\treturn t\r\n   599\t\t\t}\r\n   600\t\t}\r\n   601\t\treturn time.Time{}\r\n   602\t}\r\n   603\t\r\n   604\tfunc getString(m map[string]interface{}, key string) (string, bool) {\r\n   605\t\tv, ok := m[key]\r\n"]
