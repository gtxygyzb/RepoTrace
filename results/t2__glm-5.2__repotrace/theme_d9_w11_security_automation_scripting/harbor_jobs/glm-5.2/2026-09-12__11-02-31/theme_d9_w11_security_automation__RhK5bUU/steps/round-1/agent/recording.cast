[2888.746867, "o", "   556\t\t\teb, _ := getFloat(b, \"enriched_risk_score\")\r\n   557\t\t\tif ea != eb {\r\n   558\t\t\t\treturn ea > eb\r\n   559\t\t\t}\r\n   560\t\t\tta := threatSortTime(a)\r\n   561\t\t\ttb := threatSortTime(b)\r\n"]
[2888.747028, "o", "   562\t\t\tif !ta.Equal(tb) {\r\n   563\t\t\t\treturn ta.Before(tb)\r\n   564\t\t\t}\r\n   565\t\t\ttta, _ := getString(a, \"threat_type\")\r\n   566\t\t\tttb, _ := getString(b, \"threat_type\")\r\n   567\t\t\treturn tta < ttb\r\n   568\t\t})\r\n   569\t}\r\n   570\t\r\n   571\tfunc threatSortTime(threat map[string]interface{}) time.Time {\r\n   572\t\tif tt, ok := getString(threat, \"threat_type\"); ok && tt == \"privilege_escalation\" {\r\n   573\t\t\tif ts, ok := getString(threat, \"timestamp\"); ok {\r\n   574\t\t\t\tif t, err := parseTime(ts); err == nil {\r\n   575\t\t\t\t\treturn t\r\n   576\t\t\t\t}\r\n   577\t\t\t}\r\n   578\t\t}\r\n   579\t\tif ts, ok := getString(threat, \"first_seen\"); ok {\r\n   580\t\t\tif t, err := parseTime(ts); err == nil {\r\n   581\t\t\t\treturn t\r\n   582\t\t\t}\r\n"]
[2888.74711, "o", "   583\t\t}\r\n   584\t\treturn time.Time{}\r\n   585\t}\r\n   586\t\r\n   587\tfunc getString(m map[string]interface{}, key string) (string, bool) {\r\n   588\t\tv, ok := m[key]\r\n   589\t\tif !ok {\r\n   590\t\t\treturn \"\", false\r\n   591\t\t}\r\n   592\t\ts, ok := v.(string)\r\n   593\t\treturn s, ok\r\n   594\t}\r\n"]
[2888.747178, "o", "   595\t\r\n   596\tfunc getStringSlice(m map[string]interface{}, key string) ([]string, bool) {\r\n   597\t\tv, ok := m[key]\r\n   598\t\tif !ok {\r\n   599\t\t\treturn nil, false\r\n   600\t\t}\r\n   601\t\tswitch val := v.(type) {\r\n   602\t\tcase []string:\r\n   603\t\t\treturn val, true\r\n"]
[2888.747292, "o", "   604\t\tcase []interface{}:\r\n   605\t\t\tout := make([]string, 0, len(val))\r\n   606\t\t\tfor _, e := range val {\r\n   607\t\t\t\ts, ok := e.(string)\r\n   608\t\t\t\tif !ok {\r\n   609\t\t\t\t\treturn nil, false\r\n   610\t\t\t\t}\r\n   611\t\t\t\tout = append(out, s)\r\n   612\t\t\t}\r\n   613\t\t\treturn out, true\r\n   614\t\tdefault:\r\n   615\t\t\treturn nil, false\r\n   616\t\t}\r\n   617\t}\r\n"]
