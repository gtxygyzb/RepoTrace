[11579.576614, "o", "\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfs := newFlagSet(\"anomaly\")\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\twindow := fs.Int(\"window\", 5, \"baseline window size\")\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tthreshold := fs.Float64(\"threshold\", 2.0, \"combined z-score anomaly threshold\")\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif !parseFlags(fs, args) {\r\n"]
[11579.5767, "o", "\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn 1\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif *window < 2 {\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"error: --window must be at least 2\")\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn 1\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar snapshots []anomalyInputSnapshot\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treader := bufio.NewReader(os.Stdin)\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor {\r\n\u001b[35m\u001b[Kanomaly.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\