[10988.801723, "i", "cat > histogram.go <<'EOF'\npackage main\n\nimport (\n\t\"bufio\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"math\"\n\t\"os\"\n\t\"sort\"\n)\n\ntype histogramBucket struct {\n\tRangeStart float64 `json:\"range_start\"`\n\tRangeEnd   float64 `json:\"range_end\"`\n\tCount      int     `json:\"count\"`\n\tPercentage float64 `json:\"percentage\"`\n}\n\ntype histogramStats struct {\n\tMin    float64 `json:\"min\"`\n\tMax    float64 `json:\"max\"`\n\tMean   float64 `json:\"mean\"`\n\tMedian float64 `json:\"median\"`\n\tP90   float64 `json:\"p90\"`\n\tP95   float64 `json:\"p95\"`\n\tStdDev float64 `json:\"stddev\"`\n}\n\ntype histogramOutput struct {\n\tEventCount  int             `json:\"event_count\"`\n\tBucketWidth float64         `json:\"bucket_width\"`\n\tBuckets     []histogramBucket `json:\"buckets\"`\n\tStatistics  histogramStats  `json:\"statistics\"`\n}\n\nfunc runHistogram(args []string) int {\n\tfs := newFlagSet(\"histogram\")\n\tbuckets := fs.Int(\"buckets\", 5, \"number of buckets\")\n\tminVal := fs.Float64(\"min\", 0, \"minimum value\")\n\tmaxVal := fs.Float64(\"max\", 500, \"maximum value\")\n\tif !parseFlags(fs, args) {\n\t\tret"]
[10988.801958, "i", "urn 1\n\t}\n\tif *buckets < 2 {\n\t\tfmt.Fprintln(os.Stderr, \"--buckets must be at least 2\")\n\t\treturn 1\n\t}\n\tif *minVal >= *maxVal {\n\t\tfmt.Fprintln(os.Stderr, \"--min must be less than --max\")\n\t\treturn 1\n\t}\n\n\tscanner := bufio.NewScanner(os.Stdin)\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\n\n\tvar values []float64\n\tlineNo := 0\n\tfor scanner.Scan() {\n\t\tlineNo++\n\t\tline := scanner.Text()\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tvar event map[string]interface{}\n\t\tif err := json.Unmarshal([]byte(line), &event); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\n\t\t\treturn 2\n\t\t}\n\t\tscore, ok := getFloat(event, \"enriched_risk_score\")\n\t\tif !ok {\n\t\t\tfmt.Fprintf(os.Stderr, \"line %d: missing or invalid enriched_risk_score\\n\", lineNo)\n\t\t\treturn 2\n\t\t}\n\t\tvalues = append(values, score)\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\tif len(values) == 0 {\n\t\tfmt.Fprintln(os.Stderr, \"no valid events\")\n\t\treturn 1\n\t}\n\n\tn := len(values)\n\tbucketWidth := (*maxVal - *minVal) / float6"]
[10988.802043, "o", "cat > histogram.go <<'EOF'\r\n\u001b[?2004l\r"]
[10988.802118, "i", "4(*buckets)\n\tbucketWidth = round4(bucketWidth)\n\n\tcounts := make([]int, *buckets)\n\tfor _, v := range values {\n\t\tidx := int((v - *minVal) / bucketWidth)\n\t\tif idx < 0 {\n\t\t\tidx = 0\n\t\t}\n\t\tif idx >= *buckets {\n\t\t\tidx = *buckets - 1\n\t\t}\n\t\tcounts[idx]++\n\t}\n\n\tbucketsOut := make([]histogramBucket, 0, *buckets)\n\tfor i := 0; i < *buckets; i++ {\n\t\tstart := *minVal + float64(i)*bucketWidth\n\t\tend := *minVal + float64(i+1)*bucketWidth\n\t\tif i == *buckets-1 {\n\t\t\tend = *maxVal\n\t\t}\n\t\tbucketsOut = append(bucketsOut, histogramBucket{\n\t\t\tRangeStart: round4(start),\n\t\t\tRangeEnd:   round4(end),\n\t\t\tCount:      counts[i],\n\t\t\tPercentage: round4(float64(counts[i]) / float64(n) * 100),\n\t\t})\n\t}\n\n\tsorted := make([]float64, n)\n\tcopy(sorted, values)\n\tsort.Float64s(sorted)\n\n\tmin := sorted[0]\n\tmax := sorted[n-1]\n\tsum := 0.0\n\tfor _, v := range values {\n\t\tsum += v\n\t}\n\tmean := sum / float64(n)\n\tmedian := percentile(sorted, 50)\n\tp90 := percentile(sorted, 90)\n\tp95 := percentile(sorted, 95)\n\n\tvar sqSum float64\n\tfor _, v := range values {\n\t\tsqSum += (v"]
[10988.80218, "o", "\u001b[?2004h> "]
[10988.802274, "i", " - mean) * (v - mean)\n\t}\n\tstddev := math.Sqrt(sqSum / float64(n))\n\n\tout := histogramOutput{\n\t\tEventCount:  n,\n\t\tBucketWidth: bucketWidth,\n\t\tBuckets:     bucketsOut,\n\t\tStatistics: histogramStats{\n\t\t\tMin:    round4(min),\n\t\t\tMax:    round4(max),\n\t\t\tMean:   round4(mean),\n\t\t\tMedian: round4(median),\n\t\t\tP90:   round4(p90),\n\t\t\tP95:   round4(p95),\n\t\t\tStdDev: round4(stddev),\n\t\t},\n\t}\n\tencoder := json.NewEncoder(os.Stdout)\n\tencoder.SetOutput(os.Stdout)\n\tif err := encoder.Encode(&out); err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc percentile(sorted []float64, p float64) float64 {\n\tn := len(sorted)\n\tif n == 1 {\n\t\treturn sorted[0]\n\t}\n\trank := p / 100 * float64(n-1)\n\tlower := int(math.Floor(rank))\n\tupper := int(math.Ceil(rank))\n\tif lower < 0 {\n\t\tlower = 0\n\t}\n\tif lower > n-1 {\n\t\tlower = n - 1\n\t}\n\tif upper < 0 {\n\t\tupper = 0\n\t}\n\tif upper > n-1 {\n\t\tupper = n - 1\n\t}\n\tfrac := rank - float64(lower)\n\treturn sorted[lower] + frac*(sorted[upper]-sorted[lower])\n}\nEOF\n"]
