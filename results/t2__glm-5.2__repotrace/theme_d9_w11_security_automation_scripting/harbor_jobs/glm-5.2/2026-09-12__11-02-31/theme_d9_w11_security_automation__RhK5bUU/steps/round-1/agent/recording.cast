[7671.817785, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n"]
[7671.817855, "o", "\t\"fmt\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\ntype Event struct {\r\n\tTimestamp   string            `json:\"timestamp\"`\r\n\tSourceIP    string            `json:\"source_ip\"`\r\n"]
[7671.817934, "o", "\tDestIP      string            `json:\"dest_ip\"`\r\n\tDestPort    int               `json:\"dest_port\"`\r\n\tProtocol    string            `json:\"protocol\"`\r\n\tAction      string            `json:\"action\"`\r\n\tEventType   string            `json:\"event_type\"`\r\n\t"]
[7671.818014, "o", "User        string            `json:\"user\"`\r\n\tSeverity    string            `json:\"severity\"`\r\n\tPayloadSize int64             `json:\"payload_size\"`\r\n\tMetadata    map[string]string `json:\"metadata\"`\r\n}\r\n\r\nvar severityMap = map[string]int{\r\n\t\"low\":      1,\r\n\t\"medium\":   2,\r\n\t\"high\":     3,\r\n"]
[7671.818084, "o", "\t\"critical\": 4,\r\n}\r\n\r\nfunc severityValue(s string) int {\r\n\treturn severityMap[s]\r\n}\r\n\r\nfunc parseEvent(line string) (Event, error) {\r\n\tvar e Event\r\n\tif err := json.Unmarshal([]byte(line), &e); err != nil {\r\n\t\treturn e, err\r\n\t}\r\n\treturn e, nil\r\n}\r\n\r\n"]
[7671.818142, "o", "func parseTime(ts string) (time.Time, error) {\r\n\tt, err := time.Parse(time.RFC3339, ts)\r\n\tif err != nil {\r\n\t\treturn time.Time{}, fmt.Errorf(\"invalid timestamp %q: %w\", ts, err)\r\n\t}\r\n\treturn t, nil\r\n}\r\n\r\n"]
[7671.818206, "o", "func readEvents() ([]Event, error) {\r\n\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\tvar events []Event\r\n\tlineNo := 0\r\n\tfor scanner.Scan() {\r\n\t\tlineNo++\r\n\t\tline := scanner.Text()\r\n"]
[7671.818309, "o", "\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\te, err := parseEvent(line)\r\n\t\tif err != nil {\r\n\t\t\treturn events, fmt.Errorf(\"line %d: %w\", lineNo, err)\r\n\t\t}\r\n\t\tevents = append(events, e)\r\n\t"]
[7671.818375, "o", "}\r\n\tif err := scanner.Err(); err != nil {\r\n\t\treturn events, err\r\n\t}\r\n\treturn events, nil\r\n}\r\n\r\nfunc sortEventsByTime(events []Event) {\r\n"]
[7671.818437, "o", "\tsort.SliceStable(events, func(i, j int) bool {\r\n\t\treturn events[i].Timestamp < events[j].Timestamp\r\n\t})\r\n}\r\n\r\nfunc uniqueSortedStrings(input []string) []string {\r\n\tseen := make(map[string]bool)\r\n\tvar out []string\r\n\tfor _, s := range input {\r\n\t\tif !seen[s] {\r\n"]
[7671.8185, "o", "\t\t\tseen[s] = true\r\n\t\t\tout = append(out, s)\r\n\t\t}\r\n\t}\r\n"]
[7671.818563, "o", "\tsort.Strings(out)\r\n\treturn out\r\n}\r\n\r\nfunc uniqueSortedInts(input []int) []int {\r\n\tseen := make(map[int]bool)\r\n\tvar out []int\r\n\tfor _, n := range input {\r\n\t\tif !seen[n] {\r\n\t\t\tseen[n] = true\r\n\t\t\tout = append(out, n)\r\n\t\t}\r\n\t}\r\n\t"]
[7671.818622, "o", "sort.Ints(out)\r\n\treturn out\r\n}\r\n\r\nfunc round2(f float64) float64 {\r\n\treturn float64(int64(f*100+0.5)) / 100\r\n}\r\n"]
[7671.81909, "o", "\u001b[?2004h"]
