[4437.539164, "o", "func getStringSlice(m map[string]interface{}, key string) ([]string, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn nil, false\r\n"]
[4437.539264, "o", "\t}\r\n\tswitch val := v.(type) {\r\n\tcase []string:\r\n\t\treturn val, true\r\n\tcase []interface{}:\r\n\t\tout := make([]string, 0, len(val))\r\n\t\tfor _, e := range val {\r\n\t\t\ts, ok := e.(string)\r\n\t\t\tif !ok {\r\n\t\t\t\treturn nil, false\r\n\t\t\t}\r\n\t\t\tout = append(out, s)\r\n\t\t}\r\n\t\treturn out, true\r\n\tdefault:\r\n"]
[4437.539337, "o", "\t\treturn nil, false\r\n\t}\r\n}\r\n\r\nfunc getFloat(m map[string]interface{}, key string) (float64, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn 0, false\r\n\t}\r\n\tswitch val := v.(type) {\r\n\tcase float64:\r\n\t\treturn val, true\r\n\tcase int:\r\n"]
[4437.539401, "o", "\t\treturn float64(val), true\r\n\tdefault:\r\n\t\treturn 0, false\r\n\t}\r\n}\r\n\r\nfunc getIntSlice(m map[string]interface{}, key string) ([]int, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn nil, false\r\n"]
[4437.539462, "o", "\t}\r\n\tswitch val := v.(type) {\r\n\tcase []int:\r\n\t\treturn val, true\r\n\tcase []interface{}:\r\n\t\tout := make([]int, 0, len(val))\r\n\t\tfor _, e := range val {\r\n\t\t\tswitch n := e.(type) {\r\n\t\t\tcase float64:\r\n"]
[4437.539521, "o", "\t\t\t\tout = append(out, int(n))\r\n\t\t\tcase int:\r\n\t\t\t\tout = append(out, n)\r\n\t\t\tdefault:\r\n\t\t\t\treturn nil, false\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn out, true\r\n\tdefault:\r\n\t"]
[4437.539578, "o", "\treturn nil, false\r\n\t}\r\n}\r\n\r\n"]
