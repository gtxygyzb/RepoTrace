[10234.74529, "o", "\u001b[35m\u001b[Kprioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K173\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tlabel := \u001b[01;31m\u001b[KpriorityLabel\u001b[m\u001b[K(score)\r\n"]
[10234.745301, "o", "\u001b[35m\u001b[Kprioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K179\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KPriorityLabel\u001b[m\u001b[K: label,\r\n"]
[10234.745364, "o", "\u001b[35m\u001b[Kprioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KpriorityLabel\u001b[m\u001b[K(score float64) string {\r\n\u001b[35m\u001b[Kprioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K196\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase score >= \u001b[01;31m\u001b[K0.75\u001b[m\u001b[K:\r\n"]
[10234.745418, "o", "\u001b[35m\u001b[Kprioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase score >= \u001b[01;31m\u001b[K0.50\u001b[m\u001b[K:\r\n\u001b[35m\u001b[Kprioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase score >= \u001b[01;31m\u001b[K0.25\u001b[m\u001b[K:\r\n"]
