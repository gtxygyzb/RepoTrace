[12028.795825, "i", "cat >> rate.go <<'EOF'\n\nfunc maxRateDelta(deltas []float64) float64 {\n        var best float64\n        for i, d := range deltas {\n                if i == 0 {\n                        best = d\n                        continue\n                }\n                if math.Abs(d) > math.Abs(best) || (math.Abs(d) == math.Abs(best) && d > best) {\n                        best = d\n                }\n        }\n        return best\n}\n\nfunc minRateDelta(deltas []float64) float64 {\n        var best float64\n        for i, d := range deltas {\n                if i == 0 {\n                        best = d\n                        continue\n                }\n                if math.Abs(d) < math.Abs(best) || (math.Abs(d) == math.Abs(best) && d > best) {\n                        best = d\n                }\n        }\n        return best\n}\n\nfunc populationStdDev(values []float64) float64 {\n        if len(values) == 0 {\n                return 0\n        }\n        mean := meanOfValues(values)\n        var sumSqDiff float64\n        for _, v := "]
[12028.79586, "i", "range values {\n                diff := v - mean\n                sumSqDiff += diff * diff\n        }\n        return math.Sqrt(sumSqDiff / float64(len(values)))\n}\n\nfunc rateStability(volatility, absMeanRate float64) string {\n        if volatility < 0.1*math.Max(absMeanRate, 1.0) {\n                return \"stable\"\n        }\n        return \"volatile\"\n}\n\nfunc overallRateStability(metrics map[string]rateMetricResult) string {\n        if metrics[\"global_mean_risk\"].Stability == \"stable\" && metrics[\"total_threats\"].Stability == \"stable\" {\n                return \"stable\"\n        }\n        return \"volatile\"\n}\nEOF\n"]
[12028.796052, "o", "cat >> rate.go <<'EOF'\r\n"]
