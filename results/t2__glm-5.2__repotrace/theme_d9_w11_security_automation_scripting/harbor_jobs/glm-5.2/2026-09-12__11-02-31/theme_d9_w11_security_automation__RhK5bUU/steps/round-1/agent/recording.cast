[11535.041586, "o", "cat main.go\r\n\u001b[?2004l\r"]
[11535.04372, "o", "package main\r\n\r\nimport (\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|track|diff|anomaly|forecast|histogram> [flags]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar code int\r\n\tswitch os.Args[1] {\r\n\tcase \"prioritize\":\r\n\t\tcode = runPrioritize(os.Args[2:])\r\n\tcase \"analyze\":\r\n\t\t"]
[11535.043862, "o", "code = runAnalyze(os.Args[2:])\r\n\tcase \"summarize\":\r\n\t\tcode = runSummarize(os.Args[2:])\r\n\tcase \"filter\":\r\n\t\tcode = runFilter(os.Args[2:])\r\n\tcase \"respond\":\r\n\t\tcode = runRespond(os.Args[2:])\r\n\tcase \"enrich\":\r\n\t\tcode = runEnrich(os.Args[2:])\r\n\tcase \"correlate\":\r\n\t\tcode = runCorrelate(os.Args[2:])\r\n\tcase \"timeline\":\r\n\t\tcode = runTimeline(os.Args[2:])\r\n\tcase \"snapshot\":\r\n\t\tcode = runSnapshot(os.Args[2:])\r\n\tcase \"alert\":\r\n\t\tcode = runAlert(os.Args[2:])\r\n\tcase \"aggregate\":\r\n\t\tcode = runAggregate(os.Args[2:])\r\n\tcase \"diff\":\r\n\t\tcode = runDiff(os.Args[2:])\r\n\tcase \"anomaly\":\r\n\t\tcode = runAnomaly(os.Args[2:])\r\n\tcase \"track\":\r\n\t\tcode = runTrack(os.Args[2:])\r\n\tcase \"forecast\":\r\n\t\tcode = runForecast(os.Args[2:])\r\n\tcase \"histogram\":\r\n\t\tcode = runHistogram(os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n\t\tcode = 1\r\n\t}\r\n\tos.Exit(code)\r\n}\r\n\r\nfunc newFlagSet(name string) *flag.FlagSet {\r\n\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tfs.Usage = func() {}\r"]
[11535.043985, "o", "\n\treturn fs\r\n}\r\n\r\nfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn false\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n\tset := false\r\n\tfs.Visit(func(f *flag.Flag) {\r\n\t\tif f.Name == name {\r\n\t\t\tset = true\r\n\t\t}\r\n\t})\r\n\treturn set\r\n}\r\n"]
[11535.044371, "o", "\u001b[?2004h"]
[11535.044469, "o", "root@n30009:/app# "]
[11535.319938, "i", "grep -R \"os.Args\" -n *.go | head -40\n"]
[11535.320289, "o", "grep -R \"os.Args\" -n *.go | head -40\r\n"]
[11535.320422, "o", "\u001b[?2004l\r"]
[11535.325391, "o", "main.go:10:\tif len(os.Args) < 2 {\r\nmain.go:16:\tswitch os.Args[1] {\r\nmain.go:18:\t\tcode = runPrioritize(os.Args[2:])\r\nmain.go:20:\t\tcode = runAnalyze(os.Args[2:])\r\nmain.go:22:\t\tcode = runSummarize(os.Args[2:])\r\nmain.go:24:\t\tcode = runFilter(os.Args[2:])\r\n"]
[11535.325505, "o", "main.go:26:\t\tcode = runRespond(os.Args[2:])\r\nmain.go:28:\t\tcode = runEnrich(os.Args[2:])\r\nmain.go:30:\t\tcode = runCorrelate(os.Args[2:])\r\nmain.go:32:\t\tcode = runTimeline(os.Args[2:])\r\nmain.go:34:\t"]
[11535.325617, "o", "\tcode = runSnapshot(os.Args[2:])\r\nmain.go:36:\t\tcode = runAlert(os.Args[2:])\r\nmain.go:38:\t\tcode = runAggregate(os.Args[2:])\r\nmain.go:40:\t\tcode = runDiff(os.Args[2:])\r\nmain.go:42:\t\tcode = runAnomaly(os.Args[2:])\r\nmain.go:44:\t\tcode = runTrack(os.Args[2:])\r\nmain.go:46:\t\tcode = runForecast(os.Args[2:])\r\nmain.go:48:\t\tcode = runHistogram(os.Args[2:])\r\nmain.go:50:\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n"]
