[637.207839, "o", "\u001b[?2004h> "]
[637.208116, "o", "                    SourceIP:    ip,\r\n\u001b[?2004l\r"]
[637.208173, "o", "\u001b[?2004h> "]
[637.20845, "o", "                    TotalBytes:  total,\r\n\u001b[?2004l\r"]
[637.208508, "o", "\u001b[?2004h> "]
[637.208874, "o", "                    FirstSeen:   window[0].Timestamp,\r\n\u001b[?2004l\r"]
[637.20893, "o", "\u001b[?2004h> "]
[637.20938, "o", "                    LastSeen:    window[len(window)-1].Timestamp,\r\n\u001b[?2004l\r"]
[637.209439, "o", "\u001b[?2004h> "]
[637.209718, "o", "                    DestIPs:     dests,\r\n\u001b[?2004l\r"]
[637.209774, "o", "\u001b[?2004h> "]
[637.210058, "o", "                    RiskScore:   risk,\r\n\u001b[?2004l\r"]
[637.210115, "o", "\u001b[?2004h> "]
[637.210401, "o", "                    firstTime:   start,\r\n\u001b[?2004l\r"]
[637.210461, "o", "\u001b[?2004h> "]
[637.210735, "o", "                    lastTime:    last,\r\n\u001b[?2004l\r"]
[637.210791, "o", "\u001b[?2004h> "]
[637.210927, "o", "                })\r\n\u001b[?2004l\r"]
[637.210984, "o", "\u001b[?2004h> "]
[637.211152, "o", "                break\r\n\u001b[?2004l\r"]
[637.211208, "o", "\u001b[?2004h> "]
[637.211319, "o", "            }\r\n\u001b[?2004l\r"]
[637.211383, "o", "\u001b[?2004h> "]
[637.211452, "o", "        }\r\n\u001b[?2004l\r"]
[637.211508, "o", "\u001b[?2004h> "]
[637.211564, "o", "    }\r\n\u001b[?2004l\r"]
[637.21162, "o", "\u001b[?2004h> "]
[637.211758, "o", "    return threats\r\n\u001b[?2004l\r"]
[637.211812, "o", "\u001b[?2004h> }\r\n"]
[637.211868, "o", "\u001b[?2004l\r\u001b[?2004h"]
[637.211922, "o", "> \r\n\u001b[?2004l\r"]
[637.211977, "o", "\u001b[?2004h> "]
[637.212363, "o", "func detectPrivilegeEscalation(events []Event) []Threat {\r\n\u001b[?2004l\r"]
[637.21242, "o", "\u001b[?2004h> "]
[637.212734, "o", "    byUserFail := make(map[string][]Event)\r\n\u001b[?2004l\r"]
[637.212791, "o", "\u001b[?2004h> "]
[637.213022, "o", "    var elevatedSuccess []Event\r\n\u001b[?2004l\r"]
[637.213078, "o", "\u001b[?2004h> "]
[637.213304, "o", "    for _, e := range events {\r\n\u001b[?2004l\r"]
[637.213335, "o", "\u001b[?2004h"]
[637.213411, "o", "> "]
[637.213663, "o", "        if e.EventType == \"auth_failure\" {\r\n\u001b[?2004l\r"]
[637.213719, "o", "\u001b[?2004h> "]
[637.214039, "o", "            byUserFail[e.User] = append(byUserFail[e.User], e)\r\n\u001b[?2004l\r"]
[637.214096, "o", "\u001b[?2004h> "]
[637.21415, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.214206, "o", "> "]
[637.214671, "o", "        if e.EventType == \"auth_success\" && e.Metadata[\"privilege_change\"] == \"elevated\" {\r\n\u001b[?2004l\r"]
[637.21473, "o", "\u001b[?2004h> "]
[637.215001, "o", "            elevatedSuccess = append(elevatedSuccess, e)\r\n\u001b[?2004l\r"]
[637.215057, "o", "\u001b[?2004h> "]
[637.215114, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.21517, "o", ">     }\r\n\u001b[?2004l\r"]
[637.215242, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.215429, "o", "    sortEvents(elevatedSuccess)\r\n\u001b[?2004l\r"]
[637.215485, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[637.215541, "o", "> "]
[637.2157, "o", "    seenUser := make(map[string]bool)\r\n\u001b[?2004l\r"]
[637.215762, "o", "\u001b[?2004h> "]
[637.215861, "o", "    var threats []Threat\r\n\u001b[?2004l\r"]
[637.215919, "o", "\u001b[?2004h> "]
[637.216118, "o", "    for _, e := range elevatedSuccess {\r\n\u001b[?2004l\r"]
[637.216173, "o", "\u001b[?2004h> "]
[637.216328, "o", "        if seenUser[e.User] {\r\n\u001b[?2004l\r"]
[637.216387, "o", "\u001b[?2004h> "]
[637.21648, "o", "            continue\r\n\u001b[?2004l\r"]
[637.216537, "o", "\u001b[?2004h> "]
[637.216593, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.216648, "o", "> "]
[637.216769, "o", "        t, ok := eventTime(e)\r\n\u001b[?2004l\r"]
[637.216843, "o", "\u001b[?2004h> "]
[637.216896, "o", "        if !ok {\r\n\u001b[?2004l\r"]
[637.216951, "o", "\u001b[?2004h> "]
[637.217044, "o", "            continue\r\n\u001b[?2004l\r"]
[637.2171, "o", "\u001b[?2004h> "]
[637.217155, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.217218, "o", "> "]
[637.2174, "o", "        start := t.Add(-300 * time.Second)\r\n\u001b[?2004l\r"]
[637.217457, "o", "\u001b[?2004h> "]
[637.217528, "o", "        count := 0\r\n\u001b[?2004l\r"]
[637.217582, "o", "\u001b[?2004h> "]
[637.217826, "o", "        for _, f := range byUserFail[e.User] {\r\n\u001b[?2004l\r"]
[637.217881, "o", "\u001b[?2004h> "]
[637.21804, "o", "            ft, ok := eventTime(f)\r\n\u001b[?2004l\r"]
[637.218097, "o", "\u001b[?2004h> "]
[637.218172, "o", "            if !ok {\r\n\u001b[?2004l\r"]
[637.218241, "o", "\u001b[?2004h> "]
[637.218356, "o", "                continue\r\n\u001b[?2004l\r"]
[637.218413, "o", "\u001b[?2004h> "]
[637.218472, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.218533, "o", "> "]
[637.218782, "o", "            if !ft.Before(start) && !ft.After(t) {\r\n\u001b[?2004l\r"]
[637.218837, "o", "\u001b[?2004h> "]
[637.218943, "o", "                count++\r\n\u001b[?2004l\r"]
[637.219004, "o", "\u001b[?2004h> "]
[637.219066, "o", "            }\r\n\u001b[?2004l\r"]
[637.219122, "o", "\u001b[?2004h> "]
[637.219182, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.219327, "o", "        if count >= 1 {\r\n\u001b[?2004l\r"]
[637.219383, "o", "\u001b[?2004h> "]
[637.21956, "o", "            seenUser[e.User] = true\r\n\u001b[?2004l\r"]
[637.219616, "o", "\u001b[?2004h> "]
[637.219836, "o", "            threats = append(threats, Threat{\r\n\u001b[?2004l\r"]
[637.219892, "o", "\u001b[?2004h> "]
[637.220158, "o", "                ThreatType:    \"privilege_escalation\",\r\n\u001b[?2004l\r"]
[637.220224, "o", "\u001b[?2004h> "]
[637.220391, "o", "                User:          e.User,\r\n\u001b[?2004l\r"]
[637.220447, "o", "\u001b[?2004h> "]
[637.220666, "o", "                SourceIP:      e.SourceIP,\r\n\u001b[?2004l\r"]
[637.220724, "o", "\u001b[?2004h> "]
[637.220923, "o", "                Timestamp:     e.Timestamp,\r\n\u001b[?2004l\r"]
[637.220979, "o", "\u001b[?2004h> "]
[637.221149, "o", "                PriorFailures: count,\r\n\u001b[?2004l\r"]
[637.221209, "o", "\u001b[?2004h> "]
[637.221491, "o", "                RiskScore:     float64(count) * 25.0,\r\n\u001b[?2004l\r"]
[637.221548, "o", "\u001b[?2004h> "]
[637.221767, "o", "                FirstSeen:     e.Timestamp,\r\n\u001b[?2004l\r"]
[637.221823, "o", "\u001b[?2004h> "]
[637.222021, "o", "                LastSeen:      e.Timestamp,\r\n\u001b[?2004l\r"]
[637.222077, "o", "\u001b[?2004h> "]
[637.222231, "o", "                firstTime:     t,\r\n\u001b[?2004l\r"]
[637.222288, "o", "\u001b[?2004h> "]
[637.222464, "o", "                lastTime:      t,\r\n\u001b[?2004l\r"]
[637.222521, "o", "\u001b[?2004h> "]
[637.222568, "o", "            })\r\n\u001b[?2004l\r"]
[637.222629, "o", "\u001b[?2004h> "]
[637.222691, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.222749, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.222805, "o", "> "]
[637.222877, "o", "    return threats\r\n\u001b[?2004l\r"]
[637.222932, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[637.223, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[637.223307, "o", "func detectLateralMovement(events []Event) []Threat {\r\n\u001b[?2004l\r"]
[637.223364, "o", "\u001b[?2004h> "]
[637.223545, "o", "    byIPSuccess := make(map[string][]Event)\r\n\u001b[?2004l\r"]
[637.2236, "o", "\u001b[?2004h> "]
[637.223724, "o", "    byPairFail := make(map[string][]Event)\r\n\u001b[?2004l\r"]
[637.223782, "o", "\u001b[?2004h> "]
[637.223876, "o", "    for _, e := range events {\r\n\u001b[?2004l\r \u001b[?2004h"]
[637.223932, "o", "> "]
[637.224066, "o", "        if e.EventType == \"auth_success\" {\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.224123, "o", "> "]
[637.224368, "o", "            byIPSuccess[e.SourceIP] = append(byIPSuccess[e.SourceIP], e)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.224433, "o", "        }\r\n\u001b[?2004l\r"]
[637.224488, "o", "\u001b[?2004h> "]
[637.224629, "o", "        if e.EventType == \"auth_failure\" {\r\n\u001b[?2004l\r"]
[637.224685, "o", "\u001b[?2004h> "]
[637.224838, "o", "            key := e.SourceIP + \"|\" + e.DestIP\r\n\u001b[?2004l\r"]
[637.224909, "o", "\u001b[?2004h> "]
[637.225084, "o", "            byPairFail[key] = append(byPairFail[key], e)\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.22514, "o", "> "]
[637.225195, "o", "        }\r\n\u001b[?2004l\r \u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[637.225251, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[637.225361, "o", "    var threats []Threat\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.225419, "o", "> "]
[637.225532, "o", "    for ip, evs := range byIPSuccess {\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.225588, "o", "> "]
[637.225709, "o", "        for i := 0; i < len(evs); i++ {\r\n\u001b[?2004l\r"]
[637.225764, "o", "\u001b[?2004h> "]
[637.225898, "o", "            start, ok := eventTime(evs[i])\r\n\u001b[?2004l\r"]
[637.225955, "o", "\u001b[?2004h> "]
[637.226006, "o", "            if !ok {\r\n\u001b[?2004l\r"]
[637.226063, "o", "\u001b[?2004h> "]
[637.226135, "o", "                continue\r\n\u001b[?2004l\r"]
[637.226192, "o", "\u001b[?2004h> "]
[637.226257, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.226376, "o", "            var window []Event\r\n\u001b[?2004l\r"]
[637.226433, "o", "\u001b[?2004h> "]
[637.226541, "o", "            for j := i; j < len(evs); j++ {\r\n\u001b[?2004l\r"]
[637.226597, "o", "\u001b[?2004h> "]
[637.226682, "o", "                t, ok := eventTime(evs[j])\r\n\u001b[?2004l\r"]
[637.226737, "o", "\u001b[?2004h> "]
[637.226796, "o", "                if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.226879, "o", "                    continue\r\n\u001b[?2004l\r"]
[637.226935, "o", "\u001b[?2004h> "]
[637.226991, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.227124, "o", "                if t.Sub(start) <= 600*time.Second {\r\n\u001b[?2004l\r"]
[637.227183, "o", "\u001b[?2004h> "]
[637.2273, "o", "                    window = append(window, evs[j])\r\n\u001b[?2004l\r"]
[637.227356, "o", "\u001b[?2004h> "]
[637.227412, "o", "                } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.227486, "o", "                    break\r\n\u001b[?2004l\r"]
[637.22754, "o", "\u001b[?2004h> "]
[637.227597, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.227658, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.227771, "o", "            hosts := make(map[string]bool)\r\n\u001b[?2004l\r"]
[637.227832, "o", "\u001b[?2004h> "]
[637.227905, "o", "            for _, e := range window {\r\n\u001b[?2004l\r"]
[637.227962, "o", "\u001b[?2004h> "]
[637.228036, "o", "                et, ok := eventTime(e)\r\n\u001b[?2004l\r"]
[637.228092, "o", "\u001b[?2004h> "]
[637.228159, "o", "                if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.228246, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.228302, "o", ">                 }\r\n\u001b[?2004l\r"]
[637.228357, "o", "\u001b[?2004h> "]
[637.22849, "o", "                failStart := et.Add(-300 * time.Second)\r\n\u001b[?2004l\r"]
[637.228545, "o", "\u001b[?2004h> "]
[637.228657, "o", "                key := e.SourceIP + \"|\" + e.DestIP\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.228712, "o", "> "]
[637.228821, "o", "                for _, f := range byPairFail[key] {\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.228881, "o", "> "]
[637.228961, "o", "                    ft, ok := eventTime(f)\r\n\u001b[?2004l\r"]
[637.229017, "o", "\u001b[?2004h> "]
[637.229069, "o", "                    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.229123, "o", "> "]
[637.229181, "o", "                        continue\r\n\u001b[?2004l\r"]
[637.229248, "o", "\u001b[?2004h> "]
[637.229304, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.229466, "o", "                    if !ft.Before(failStart) && !ft.After(et) {\r\n\u001b[?2004l\r"]
[637.229521, "o", "\u001b[?2004h> "]
[637.229621, "o", "                        hosts[e.DestIP] = true\r\n\u001b[?2004l\r"]
[637.229676, "o", "\u001b[?2004h> "]
[637.229739, "o", "                        break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.229814, "o", "                    }\r\n\u001b[?2004l\r"]
[637.229869, "o", "\u001b[?2004h> "]
[637.229924, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.22998, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.230072, "o", "            if len(hosts) >= 3 {\r\n\u001b[?2004l\r"]
[637.230128, "o", "\u001b[?2004h> "]
[637.230263, "o", "                compromised := make([]string, 0, len(hosts))\r\n\u001b[?2004l\r"]
[637.230319, "o", "\u001b[?2004h> "]
[637.230393, "o", "                for h := range hosts {\r\n\u001b[?2004l\r"]
[637.230453, "o", "\u001b[?2004h> "]
[637.230572, "o", "                    compromised = append(compromised, h)\r\n\u001b[?2004l\r"]
[637.230627, "o", "\u001b[?2004h> "]
[637.230682, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.230841, "o", "                compromised = uniqueSortedStrings(compromised)\r\n\u001b[?2004l\r"]
[637.230896, "o", "\u001b[?2004h> "]
[637.231023, "o", "                risk := float64(len(compromised)) * 40.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.231079, "o", "> "]
[637.231222, "o", "                last, ok := eventTime(window[len(window)-1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.231279, "o", "> "]
[637.231334, "o", "                if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.231433, "o", "                    last = start\r\n\u001b[?2004l\r"]
[637.231493, "o", "\u001b[?2004h>                 }\r\n\u001b[?2004l\r"]
[637.231548, "o", "\u001b[?2004h> "]
[637.231663, "o", "                threats = append(threats, Threat{\r\n\u001b[?2004l\r"]
[637.231718, "o", "\u001b[?2004h> "]
[637.231844, "o", "                    ThreatType:       \"lateral_movement\",\r\n\u001b[?2004l\r"]
[637.231901, "o", "\u001b[?2004h> "]
[637.231984, "o", "                    SourceIP:         ip,\r\n\u001b[?2004l\r"]
[637.232039, "o", "\u001b[?2004h> "]
[637.232147, "o", "                    CompromisedHosts: compromised,\r\n\u001b[?2004l\r"]
[637.232203, "o", "\u001b[?2004h> "]
[637.295873, "o", "                    FirstSeen:        window[0].Timestamp,\r\n\u001b[?2004l\r"]
[637.295948, "o", "\u001b[?2004h> "]
[637.29636, "o", "                    LastSeen:         window[len(window)-1].Timestamp,\r\n\u001b[?2004l\r"]
[637.29642, "o", "\u001b[?2004h> "]
[637.296664, "o", "                    RiskScore:        risk,\r\n\u001b[?2004l\r"]
[637.296722, "o", "\u001b[?2004h> "]
[637.296976, "o", "                    firstTime:        start,\r\n\u001b[?2004l\r"]
[637.297032, "o", "\u001b[?2004h> "]
[637.297288, "o", "                    lastTime:         last,\r\n\u001b[?2004l\r"]
[637.297347, "o", "\u001b[?2004h> "]
[637.297453, "o", "                })\r\n\u001b[?2004l\r"]
[637.29751, "o", "\u001b[?2004h> "]
[637.297641, "o", "                break\r\n\u001b[?2004l\r"]
[637.297697, "o", "\u001b[?2004h> "]
[637.297774, "o", "            }\r\n\u001b[?2004l\r"]
[637.297829, "o", "\u001b[?2004h> "]
[637.297889, "o", "        }\r\n\u001b[?2004l\r"]
[637.297945, "o", "\u001b[?2004h> "]
[637.297999, "o", "    }\r\n\u001b[?2004l\r"]
[637.298059, "o", "\u001b[?2004h> "]
[637.29815, "o", "    return threats\r\n\u001b[?2004l\r"]
[637.298208, "o", "\u001b[?2004h> "]
[637.298282, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[637.298347, "o", "\u001b[?2004h> "]
[637.298638, "o", "func detectDNSTunneling(events []Event) []Threat {\r\n\u001b[?2004l\r"]
[637.298701, "o", "\u001b[?2004h> "]
[637.298905, "o", "    byIP := make(map[string][]Event)\r\n\u001b[?2004l\r"]
[637.298968, "o", "\u001b[?2004h> "]
[637.299137, "o", "    for _, e := range events {\r\n\u001b[?2004l\r"]
[637.299194, "o", "\u001b[?2004h> "]
[637.29943, "o", "        if e.EventType == \"dns_query\" {\r\n\u001b[?2004l\r"]
[637.299488, "o", "\u001b[?2004h> "]
[637.299814, "o", "            byIP[e.SourceIP] = append(byIP[e.SourceIP], e)\r\n\u001b[?2004l\r"]
[637.299872, "o", "\u001b[?2004h> "]
[637.299931, "o", "        }\r\n\u001b[?2004l\r"]
[637.299987, "o", "\u001b[?2004h> "]
[637.300043, "o", "    }\r\n\u001b[?2004l\r"]
[637.3001, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[637.300159, "o", "\u001b[?2004h> "]
[637.300292, "o", "    var threats []Threat\r\n\u001b[?2004l\r"]
[637.300349, "o", "\u001b[?2004h> "]
[637.300529, "o", "    for ip, evs := range byIP {\r\n\u001b[?2004l\r"]
[637.300592, "o", "\u001b[?2004h> "]
[637.30081, "o", "        for i := 0; i < len(evs); i++ {\r\n\u001b[?2004l\r"]
[637.300871, "o", "\u001b[?2004h> "]
[637.301112, "o", "            start, ok := eventTime(evs[i])\r\n\u001b[?2004l\r"]
[637.301168, "o", "\u001b[?2004h> "]
[637.301296, "o", "            if !ok {\r\n\u001b[?2004l\r"]
[637.301355, "o", "\u001b[?2004h> "]
[637.301496, "o", "                continue\r\n\u001b[?2004l\r"]
[637.30155, "o", "\u001b[?2004h> "]
[637.301632, "o", "            }\r\n\u001b[?2004l\r"]
[637.301687, "o", "\u001b[?2004h> "]
[637.301864, "o", "            var window []Event\r\n\u001b[?2004l\r"]
[637.301919, "o", "\u001b[?2004h> "]
[637.30208, "o", "            var total int64\r\n\u001b[?2004l\r"]
[637.302134, "o", "\u001b[?2004h> "]
[637.302392, "o", "            for j := i; j < len(evs); j++ {\r\n\u001b[?2004l\r"]
[637.302459, "o", "\u001b[?2004h> "]
[637.302689, "o", "                t, ok := eventTime(evs[j])\r\n\u001b[?2004l\r"]
[637.302745, "o", "\u001b[?2004h> "]
[637.302888, "o", "                if !ok {\r\n\u001b[?2004l\r"]
[637.302945, "o", "\u001b[?2004h> "]
[637.303107, "o", "                    continue\r\n\u001b[?2004l\r"]
[637.303163, "o", "\u001b[?2004h> "]
[637.303276, "o", "                }\r\n\u001b[?2004l\r"]
[637.303337, "o", "\u001b[?2004h> "]
[637.303623, "o", "                if t.Sub(start) <= 60*time.Second {\r\n\u001b[?2004l\r"]
[637.303679, "o", "\u001b[?2004h> "]
[637.303969, "o", "                    window = append(window, evs[j])\r\n\u001b[?2004l\r"]
[637.304026, "o", "\u001b[?2004h> "]
[637.304304, "o", "                    total += evs[j].PayloadSize\r\n\u001b[?2004l\r"]
[637.304361, "o", "\u001b[?2004h> "]
[637.304502, "o", "                } else {\r\n\u001b[?2004l\r"]
[637.304568, "o", "\u001b[?2004h> "]
[637.304705, "o", "                    break\r\n\u001b[?2004l\r"]
[637.304767, "o", "\u001b[?2004h> "]
[637.304866, "o", "                }\r\n\u001b[?2004l\r"]
[637.304921, "o", "\u001b[?2004h> "]
[637.305003, "o", "            }\r\n\u001b[?2004l\r"]
[637.305066, "o", "\u001b[?2004h> "]
[637.305276, "o", "            if len(window) >= 50 {\r\n\u001b[?2004l\r"]
[637.305333, "o", "\u001b[?2004h> "]
[637.305663, "o", "                avg := float64(total) / float64(len(window))\r\n\u001b[?2004l\r"]
[637.305721, "o", "\u001b[?2004h> "]
[637.305895, "o", "                if avg > 512 {\r\n\u001b[?2004l\r"]
[637.305958, "o", "\u001b[?2004h> "]
[637.306387, "o", "                    risk := (avg / 512.0) * float64(len(window)) * 0.5\r\n\u001b[?2004l\r"]
[637.306454, "o", "\u001b[?2004h> "]
[637.306819, "o", "                    last, ok := eventTime(window[len(window)-1])\r\n\u001b[?2004l\r"]
[637.306876, "o", "\u001b[?2004h> "]
[637.307042, "o", "                    if !ok {\r\n\u001b[?2004l\r"]
[637.307098, "o", "\u001b[?2004h> "]
[637.307313, "o", "                        last = start\r\n\u001b[?2004l\r"]
[637.307371, "o", "\u001b[?2004h> "]
[637.307495, "o", "                    }\r\n\u001b[?2004l\r"]
[637.307552, "o", "\u001b[?2004h> "]
[637.307801, "o", "                    threats = append(threats, Threat{\r\n\u001b[?2004l\r"]
[637.307857, "o", "\u001b[?2004h> "]
[637.308064, "o", "                        ThreatType:  \"dns_tunneling\",\r\n\u001b[?2004l\r"]
[637.30812, "o", "\u001b[?2004h> "]
[637.308279, "o", "                        SourceIP:    ip,\r\n\u001b[?2004l\r"]
[637.308346, "o", "\u001b[?2004h> "]
[637.308539, "o", "                        QueryCount:  len(window),\r\n\u001b[?2004l\r"]
[637.308595, "o", "\u001b[?2004h> "]
[637.308786, "o", "                        AvgPayload:  round2(avg),\r\n\u001b[?2004l\r"]
[637.308841, "o", "\u001b[?2004h> "]
[637.309067, "o", "                        FirstSeen:   window[0].Timestamp,\r\n\u001b[?2004l\r"]
[637.309124, "o", "\u001b[?2004h> "]
[637.309398, "o", "                        LastSeen:    window[len(window)-1].Timestamp,\r\n\u001b[?2004l\r"]
[637.309456, "o", "\u001b[?2004h> "]
[637.309614, "o", "                        RiskScore:   risk,\r\n\u001b[?2004l\r"]
[637.30967, "o", "\u001b[?2004h> "]
[637.309836, "o", "                        firstTime:   start,\r\n\u001b[?2004l\r"]
[637.309891, "o", "\u001b[?2004h> "]
[637.310053, "o", "                        lastTime:    last,\r\n\u001b[?2004l\r"]
[637.310109, "o", "\u001b[?2004h> "]
[637.310193, "o", "                    })\r\n\u001b[?2004l\r"]
[637.310256, "o", "\u001b[?2004h> "]
[637.310348, "o", "                    break\r\n\u001b[?2004l\r"]
[637.310408, "o", "\u001b[?2004h> "]
[637.310469, "o", "                }\r\n\u001b[?2004l\r"]
[637.310524, "o", "\u001b[?2004h> "]
[637.310584, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.310638, "o", ">         }\r\n\u001b[?2004l\r"]
[637.310706, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[637.310754, "o", "\u001b[?2004h> "]
[637.310844, "o", "    return threats\r\n\u001b[?2004l\r"]
[637.310899, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[637.310959, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[637.311018, "o", "> "]
[637.311137, "o", "func splitKey(key string) []string {\r\n\u001b[?2004l\r"]
[637.311193, "o", "\u001b[?2004h> "]
[637.311336, "o", "    for i := 0; i < len(key); i++ {\r\n\u001b[?2004l\r"]
[637.311392, "o", "\u001b[?2004h> "]
[637.311494, "o", "        if key[i] == '|' {\r\n\u001b[?2004l\r"]
[637.311548, "o", "\u001b[?2004h> "]
[637.311738, "o", "            return []string{key[:i], key[i+1:]}\r\n\u001b[?2004l\r"]
[637.311794, "o", "\u001b[?2004h> "]
[637.311855, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.311911, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.311967, "o", "> "]
[637.312057, "o", "    return []string{key, \"\"}\r\n\u001b[?2004l\r"]
[637.312117, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[637.312173, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
