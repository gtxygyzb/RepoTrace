[4508.075859, "o", "\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif *\u001b[01;31m\u001b[KtopN < 0\u001b[m\u001b[K {\r\n"]
[4508.075914, "o", "\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KUniqueActors\u001b[m\u001b[K:      []string{},\r\n"]
[4508.075977, "o", "\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tb.\u001b[01;31m\u001b[KUniqueActors\u001b[m\u001b[K = nonNilStrings(sortedUniqueStringsFromSet(actorSet))\r\n"]
[4508.076038, "o", "\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tb.EscalationIndex = \u001b[01;31m\u001b[Kround3\u001b[m\u001b[K(timelineEscalationIndex(threats))\r\n\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tb.RiskTrend = \u001b[01;31m\u001b[Kround3\u001b[m\u001b[K(timelineRiskTrend(threats, startTime))\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tb.BurstScore = \u001b[01;31m\u001b[Kround3\u001b[m\u001b[K(timelineBurstScore(threats))\r\n"]
[4508.076111, "o", "\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[Kround3\u001b[m\u001b[K(f float64) float64 {\r\n"]
