[7717.200077, "o", "\t\tThreatType       string   `json:\"threat_type\"`\r\n   107\t\t\t\tSourceIP         string   `json:\"source_ip\"`\r\n   108\t\t\t\tCompromisedHosts []string `json:\"compromised_hosts\"`\r\n   109\t\t\t\tFirstSeen        string   `json:\"first_seen\"`\r\n   110\t\t\t\tLastSeen         string   `json:\"last_seen\"`\r\n   111\t\t\t\tRiskScore        float64  `json:\"risk_score\"`\r\n   112\t\t\t}{\r\n   113\t\t\t\tThreatType:       t.ThreatType,\r\n   114\t\t\t\tSourceIP:         t.SourceIP,\r\n   115\t\t\t\t"]
