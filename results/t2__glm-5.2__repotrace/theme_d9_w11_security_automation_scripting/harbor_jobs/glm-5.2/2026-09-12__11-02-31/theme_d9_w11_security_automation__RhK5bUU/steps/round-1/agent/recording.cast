[4874.128162, "o", "   180\t\tb.TypeDistribution = typeCounts\r\n   181\t\r\n   182\t\tb.UniqueActors = nonNilStrings(sortedUniqueStringsFromSet(actorSet))\r\n   183\t\r\n"]
[4874.128244, "o", "   184\t\tb.EscalationIndex = round3(timelineEscalationIndex(threats))\r\n   185\t\tb.RiskTrend = round3(timelineRiskTrend(threats, startTime))\r\n   186\t\tb.BurstScore = round3(timelineBurstScore(threats))\r\n   187\t\r\n   188\t\tsortedTop := make([]map[string]interface{}, len(threats))\r\n   189\t\tcopy(sortedTop, threats)\r\n   190\t\tsort.SliceStable(sortedTop, func(i, j int) bool {\r\n   191\t\t\tri, _ := getFloat(sortedTop[i], \"enriched_risk_score\")\r\n   192\t\t\trj, _ := getFloat(sortedTop[j], \"enriched_risk_score\")\r\n"]
[4874.128317, "o", "   193\t\t\tif ri != rj {\r\n   194\t\t\t\treturn ri > rj\r\n   195\t\t\t}\r\n   196\t\t\tti, tj := threatSortTime(sortedTop[i]), threatSortTime(sortedTop[j])\r\n   197\t\t\tif !ti.Equal(tj) {\r\n   198\t\t\t\treturn ti.Before(tj)\r\n   199\t\t\t}\r\n   200\t\t\ttta, _ := getString(sortedTop[i], \"threat_type\")\r\n"]
[4874.128378, "o", "   201\t\t\tttb, _ := getString(sortedTop[j], \"threat_type\")\r\n   202\t\t\treturn tta < ttb\r\n   203\t\t})\r\n   204\t\tif topN < len(sortedTop) {\r\n   205\t\t\tsortedTop = sortedTop[:topN]\r\n   206\t\t}\r\n   207\t\tb.TopThreats = sortedTop\r\n   208\t\r\n   209\t\treturn b\r\n   210\t}\r\n   211\t\r\n"]
[4874.128443, "o", "   212\tfunc dominantThreatType(counts map[string]int) string {\r\n   213\t\tvar keys []string\r\n   214\t\tfor k := range counts {\r\n   215\t\t\tkeys = append(keys, k)\r\n   216\t\t}\r\n   217\t\tsort.Strings(keys)\r\n   218\t\tdominant := \"\"\r\n   219\t\tmaxCount := -1\r\n"]
[4874.128501, "o", "   220\t\tfor _, k := range keys {\r\n   221\t\t\tif counts[k] > maxCount {\r\n   222\t\t\t\tmaxCount = counts[k]\r\n   223\t\t\t\tdominant = k\r\n   224\t\t\t}\r\n   225\t\t}\r\n   226\t\treturn dominant\r\n   227\t"]
[4874.128567, "o", "}\r\n   228\t\r\n   229\tfunc timelineSeverityRank(sev string) int {\r\n   230\t\tswitch sev {\r\n   231\t\tcase \"none\":\r\n   232\t\t\treturn 0"]
[4874.128624, "o", "\r\n   233\t\tcase \"low\":\r\n   234\t\t\treturn 1\r\n   235\t\tcase \"medium\":\r\n   236\t\t\treturn 2\r\n   237\t\tcase \"high\":\r\n   238\t\t\treturn 3\r\n   239\t\tcase \"critical\":\r\n   240\t\t\treturn 4\r\n   241\t\tdefault:\r\n   242\t\t\treturn -1\r\n   243\t\t}\r\n   244\t}"]
[4874.128681, "o", "\r\n   245\t\r\n   246\tfunc timelineEscalationIndex(threats []map[string]interface{}) float64 {\r\n   247\t\tn := len(threats)\r\n   248\t\tif n < 2 {\r\n   249\t\t\treturn 0.0\r\n   250\t\t}\r\n"]
[4874.128745, "o", "   251\t\tordered := make([]map[string]interface{}, len(threats))\r\n   252\t\tcopy(ordered, threats)\r\n   253\t\tsort.SliceStable(ordered, func(i, j int) bool {\r\n"]
[4874.12881, "o", "   254\t\t\tti, tj := threatSortTime(ordered[i]), threatSortTime(ordered[j])\r\n   255\t\t\tif !ti.Equal(tj) {\r\n   256\t\t\t\treturn ti.Before(tj)\r\n   257\t\t\t}\r\n   258\t\t\ttta, _ := getString(ordered[i], \"threat_type\")\r\n   259\t\t\tttb, _ := getString(ordered[j], \"threat_type\")\r\n   260\t\t\treturn tta < ttb\r\n   261\t\t})\r\n   262\t\r\n   263\t\tpositiveSum := 0.0\r\n   264\t\tfor i := 0; i < len(ordered)-1; i++ {\r\n   265\t\t\trankI := timelineSeverityRank(getStringDefault(ordered[i], \"ioc_severity\"))\r\n   266\t\t\trankJ := timelineSeverityRank(getStringDefault(ordered[i+1], \"ioc_severity\"))\r\n   267\t\t\tif rankI < 0 {\r\n   268\t\t\t\trankI = 0\r\n   269\t\t\t}\r\n   270\t\t\t"]
[4874.128877, "o", "if rankJ < 0 {\r\n   271\t\t\t\trankJ = 0\r\n   272\t\t\t}\r\n   273\t\t\tdelta := rankJ - rankI\r\n   274\t\t\tif delta > 0 {\r\n"]
[4874.128937, "o", "   275\t\t\t\tpositiveSum += float64(delta)\r\n   276\t\t\t}\r\n   277\t\t}\r\n   278\t\treturn positiveSum / (4.0 * float64(n-1))\r\n   279\t}\r\n   280\t\r\n   281\tfunc timelineRiskTrend(threats []map[string]interface{}, startTime time.Time) float64 {\r\n   282\t\tn := len(threats)\r\n   283\t\tif n < 2 {\r\n   284\t\t\treturn 0.0\r\n   285\t\t}\r\n   286\t\txs := make([]float64, n)\r\n   287\t\tys := make([]float64, n)\r\n"]
[4874.129, "o", "   288\t\tfor i, threat := range threats {\r\n   289\t\t\trefTime := threatSortTime(threat)\r\n   290\t\t\txs[i] = refTime.Sub(startTime).Minutes()\r\n   291\t\t\tys[i], _ = getFloat(threat, \"enriched_risk_score\")\r\n   292\t\t}\r\n   293\t\tsameX := true\r\n   294\t\tfor i := 1; i < n; i++ {\r\n   295\t\t\tif xs[i] != xs[0] {\r\n"]
[4874.129058, "o", "   296\t\t\t\tsameX = false\r\n   297\t\t\t\tbreak\r\n   298\t\t\t}\r\n   299\t\t}\r\n   300\t\tif sameX {\r\n   301\t\t\treturn 0.0\r\n   302\t\t}\r\n   303\t\tvar sumX, sumY, sumXY, sumXX2 float64\r\n   304\t\tfor i := 0; i < n; i++ {\r\n"]
[4874.129123, "o", "   305\t\t\tsumX += xs[i]\r\n   306\t\t\tsumY += ys[i]\r\n   307\t\t\tsumXY += xs[i] * ys[i]\r\n   308\t\t\tsumXX2 += xs[i] * xs[i]\r\n   309\t\t}\r\n   310\t\tdenom := float64(n)*sumXX2 - sumX*sumX\r\n   311\t\tif denom == 0 {\r\n   312\t\t\treturn 0.0\r\n"]
[4874.129185, "o", "   313\t\t}\r\n   314\t\treturn (float64(n)*sumXY - sumX*sumY) / denom\r\n   315\t}\r\n   316\t\r\n   317\tfunc timelineBurstScore(threats []map[string]interface{}) float64 {\r\n   318\t\tn := len(threats)\r\n   319\t\tif n < 2 {\r\n   320\t\t\treturn 0.0\r\n   321\t\t}\r\n   322\t\ttimes := make([]float64, n)\r\n"]
[4874.129263, "o", "   323\t\tfor i, threat := range threats {\r\n   324\t\t\trefTime := threatSortTime(threat)\r\n   325\t\t\ttimes[i] = float64(refTime.Unix()) / 60.0\r\n   326\t\t}\r\n   327\t\tsum := 0.0\r\n   328\t\tpairs := 0\r\n   329\t\tfor i := 0; i < n; i++ {\r\n   330\t\t\tfor j := i + 1; j < n; j++ {\r\n   331\t\t\t\t"]
[4874.129321, "o", "sum += 1.0 / (1.0 + math.Abs(times[i]-times[j]))\r\n   332\t\t\t\tpairs++\r\n   333\t\t\t}\r\n   334\t\t}\r\n   335\t\treturn sum / float64(pairs)\r\n   336\t}\r\n   337\t\r\n   338\tfunc getStringDefault(m map[string]interface{}, key string) string {"]
[4874.129379, "o", "\r\n   339\t\tif v, ok := getString(m, key); ok {\r\n   340\t\t\treturn v\r\n   341\t\t}\r\n   342\t\treturn \"\"\r\n   343\t}\r\n   344\t\r\n   345\tfunc round3(f float64) float64 {\r\n   346\t\treturn math.Round(f*1000) / 1000\r\n"]
[4874.129437, "o", "   347\t}\r\n"]
