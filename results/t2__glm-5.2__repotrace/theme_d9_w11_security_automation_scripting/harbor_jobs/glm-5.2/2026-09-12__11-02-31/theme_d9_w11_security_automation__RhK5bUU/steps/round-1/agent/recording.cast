[8863.903867, "o", "    11\t\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|track|diff> [flags]\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\r\n    15\t\tvar code int\r\n    16\t\tswitch os.Args[1] {\r\n    17\t\tcase \"prioritize\":\r\n    18\t\t\tcode = runPrioritize(os.Args[2:])\r\n    19\t\tcase \"analyze\":\r\n    20\t\t\tcode = runAnalyze(os.Args[2:])\r\n    21\t\tcase \"summarize\":\r\n    22\t\t\tcode = runSummarize(os.Args[2:])\r\n    23\t\tcase \"filter\":\r\n    24\t\t\tcode = runFilter(os.Args[2:])\r\n    25\t\tcase \"respond\":\r\n    26\t\t\tcode = runRespond(os.Args[2:])\r\n    27\t\tcase \"enrich\":\r\n    28\t\t\tcode = runEnrich(os.Args[2:])\r\n    29\t\tcase \"correlate\":\r\n    30"]
[8863.903911, "o", "\t\t\tcode = runCorrelate(os.Args[2:])\r\n    31\t\tcase \"timeline\":\r\n    32\t\t\tcode = runTimeline(os.Args[2:])\r\n    33\t\tcase \"snapshot\":\r\n    34\t\t\tcode = runSnapshot(os.Args[2:])\r\n    35\t\tcase \"alert\":\r\n    36\t\t\tcode = runAlert(os.Args[2:])\r\n    37\t\tcase \"aggregate\":\r\n    38\t\t\tcode = runAggregate(os.Args[2:])\r\n    39\t\tcase \"diff\":\r\n    40\t\t\tcode = runDiff(os.Args[2:])\r\n    41\t\tcase \"track\":\r\n"]
[8863.90401, "o", "    42\t\t\tcode = runTrack(os.Args[2:])\r\n    43\t\tdefault:\r\n    44\t\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n    45\t\t\tcode = 1\r\n    46\t\t}\r\n    47\t\tos.Exit(code)\r\n    48\t}\r\n    49\t\r\n    50\tfunc newFlagSet(name string) *flag.FlagSet {\r\n    51\t\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n    52\t\tfs.SetOutput(os.Stderr)\r\n    53\t\tfs.Usage = func() {}\r\n    54\t\treturn fs\r\n    55\t}\r\n    56\t"]
[8863.904071, "o", "\r\n    57\tfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n    58\t\tif err := fs.Parse(args); err != nil {\r\n    59\t\t\treturn false\r\n    60\t\t}\r\n    61\t\treturn true\r\n    62\t}\r\n    63\t\r\n    64\tfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n"]
[8863.904129, "o", "    65\t\tset := false\r\n    66\t\tfs.Visit(func(f *flag.Flag) {\r\n    67\t\t\tif f.Name == name {\r\n    68\t\t\t\tset = true\r\n    69\t\t\t}\r\n    70\t\t})\r\n    71\t\treturn set\r\n    72\t}\r\n"]
