[7280.898963, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"flag\"\r\n     5\t\t\"fmt\"\r\n"]
[7280.899037, "o", "     6\t\t\"os\"\r\n     7\t)\r\n     8\t\r\n     9\tfunc main() {\r\n    10\t\tif len(os.Args) < 2 {\r\n    11\t\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert> [flags]\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\r\n    15\t\tvar code int\r\n    16\t\tswitch os.Args[1] {\r\n    17\t\tcase \"analyze\":\r\n"]
[7280.899099, "o", "    18\t\t\tcode = runAnalyze(os.Args[2:])\r\n    19\t\tcase \"summarize\":\r\n    20\t\t\tcode = runSummarize(os.Args[2:])\r\n    21\t\tcase \"filter\":\r\n    22\t\t\tcode = runFilter(os.Args[2:])\r\n    23\t\tcase \"respond\":\r\n    24\t\t\tcode = runRespond(os.Args[2:])\r\n"]
[7280.899167, "o", "    25\t\tcase \"enrich\":\r\n    26\t\t\tcode = runEnrich(os.Args[2:])\r\n    27\t\tcase \"correlate\":\r\n    28\t\t\tcode = runCorrelate(os.Args[2:])\r\n    29\t\tcase \"timeline\":\r\n    30\t\t\tcode = runTimeline(os.Args[2:])\r\n    31\t\tcase \"snapshot\":\r\n    32\t\t\tcode = runSnapshot(os.Args[2:])\r\n    33\t\tcase \"alert\":\r\n    34"]
[7280.899275, "o", "\t\t\tcode = runAlert(os.Args[2:])\r\n    35\t\tdefault:\r\n    36\t\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n    37\t\t\tcode = 1\r\n    38\t\t}\r\n    39\t\tos.Exit(code)\r\n    40\t}\r\n    41\t\r\n    42\tfunc newFlagSet(name string) *flag.FlagSet {\r\n    43\t\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n    44\t\tfs.SetOutput(os.Stderr)\r\n"]
[7280.899336, "o", "    45\t\tfs.Usage = func() {}\r\n    46\t\treturn fs\r\n    47\t}\r\n    48\t\r\n    49\tfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n    50\t\tif err := fs.Parse(args); err != nil {\r\n    51\t\t\treturn false\r\n    52\t\t}\r\n    53\t\treturn true\r\n    54"]
[7280.899394, "o", "\t}\r\n    55\t\r\n    56\tfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n    57\t\tset := false\r\n    58\t\tfs.Visit(func(f *flag.Flag) {\r\n    59\t\t\tif f.Name == name {\r\n    60\t\t\t\tset = true\r\n    61\t\t\t}\r\n    62\t\t})\r\n"]
[7280.899451, "o", "    63\t\treturn set\r\n    64\t}\r\n"]
