[1556.158448, "i", "enc := json.NewEncoder(w)\n    enc.SetEscapeHTML(false)\n    if err := enc.Encode(s); err != nil {\n        fmt.Fprintln(os.Stderr, err)\n    }\n}\n\nfunc printTextSummary(s Summary) {\n    w := bufio.NewWriter(os.Stdout)\n    defer w.Flush()\n\n    fmt.Fprintf(w, \"=== Security Log Summary ===\\n\")\n    fmt.Fprintf(w, \"Total Events: %d\\n\", s.TotalEvents)\n    fmt.Fprintf(w, \"Time Range: %s to %s\\n\", s.TimeRange.Start, s.TimeRange.End)\n    fmt.Fprintf(w, \"Unique Source IPs: %d\\n\", s.UniqueSourceIPs)\n    fmt.Fprintf(w, \"Unique Dest IPs: %d\\n\", s.UniqueDestIPs)\n    fmt.Fprintln(w)\n\n    fmt.Fprintln(w, \"--- Severity Distribution ---\")\n    severities := []string{\"critical\", \"high\", \"medium\", \"low\"}\n    for _, sev := range severities {\n        count := s.BySeverity[sev]\n        if count == 0 {\n            continue\n        }\n        pct := 0.0\n        if s.TotalEvents > 0 {\n            pct = float64(count) * 100.0 / float64(s.TotalEvents)\n        }\n        fmt.Fprintf(w, \"  %s: %d (%.1f%%)\\n\", sev, count, pct)\n    }\n\n    fmt.Fpri"]
