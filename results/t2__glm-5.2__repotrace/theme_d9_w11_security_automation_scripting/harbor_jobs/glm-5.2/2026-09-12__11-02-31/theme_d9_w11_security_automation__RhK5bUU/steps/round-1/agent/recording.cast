[7268.094877, "o", "\u001b[35m\u001b[K./timeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KEscalationIndex\u001b[m\u001b[K   float64                  `json:\"\u001b[01;31m\u001b[Kescalation_index\u001b[m\u001b[K\"`\r\n"]
[7268.095035, "o", "\u001b[35m\u001b[K./timeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tb.\u001b[01;31m\u001b[KEscalationIndex\u001b[m\u001b[K = round3(\u001b[01;31m\u001b[KtimelineEscalationIndex\u001b[m\u001b[K(threats))\r\n"]
[7268.095171, "o", "\u001b[35m\u001b[K./timeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KtimelineEscalationIndex\u001b[m\u001b[K(threats []map[string]interface{}) float64 {\r\n"]
