[1863.706651, "o", "   148\tfunc nonNilStrings(s []string) []string {\r\n   149\t\tif s == nil {\r\n   150\t\t\treturn []string{}\r\n   151\t\t}\r\n   152\t\treturn s\r\n   153\t}\r\n   154\t\r\n   155\tfunc nonNilInts(s []int) []int {\r\n   156\t\tif s == nil {\r\n   157\t\t\treturn []int{}\r\n   158\t\t}\r\n"]
[1863.706711, "o", "   159\t\treturn s\r\n   160\t}\r\n   161\t\r\n   162\tfunc sortEvents(events []Event) {\r\n   163\t\tsort.SliceStable(events, func(i, j int) bool {\r\n   164\t\t\tti, errI := parseTime(events[i].Timestamp)\r\n   165\t\t\ttj, errJ := parseTime(events[j].Timestamp)\r\n   166\t\t\tif errI == nil && errJ == nil {\r\n"]
[1863.706774, "o", "   167\t\t\t\tif ti.Before(tj) {\r\n   168\t\t\t\t\treturn true\r\n   169\t\t\t\t}\r\n   170\t\t\t\tif tj.Before(ti) {\r\n   171\t\t\t\t\treturn false\r\n   172\t\t\t\t}\r\n   173\t\t\t\treturn events[i].Timestamp < events[j].Timestamp\r\n   174\t\t\t}\r\n"]
[1863.706834, "o", "   175\t\t\treturn events[i].Timestamp < events[j].Timestamp\r\n   176\t\t})\r\n   177\t}\r\n   178\t\r\n   179\tfunc eventTime(e Event) (time.Time, bool) {\r\n   180\t\tt, err := parseTime(e.Timestamp)\r\n   181\t\treturn t, err == nil\r\n   182\t}\r\n   183\t\r\n   184\tfunc detectThreats(events []Event) []Threat {\r\n"]
[1863.706898, "o", "   185\t\tsortEvents(events)\r\n   186\t\tvar threats []Threat\r\n   187\t\tthreats = append(threats, detectBruteForce(events)...)\r\n   188\t\tthreats = append(threats, detectPortScan(events)...)\r\n   189\t\tthreats = append(threats, detectDataExfiltration(events)...)\r\n   190\t\tthreats = append(threats, detectPrivilegeEscalation(events)...)\r\n   191\t\tthreats = append(threats, detectLateralMovement(events)...)\r\n   192\t\tthreats = append(threats, detectDNSTunneling(events)...)\r\n"]
[1863.706958, "o", "   193\t\tsortThreats(threats)\r\n   194\t\treturn threats\r\n   195\t}\r\n   196\t\r\n   197\tfunc sortThreats(threats []Threat) {\r\n   198\t\tsort.SliceStable(threats, func(i, j int) bool {\r\n   199\t\t\tif threats[i].RiskScore != threats[j].RiskScore {\r\n"]
[1863.707021, "o", "   200\t\t\t\treturn threats[i].RiskScore > threats[j].RiskScore\r\n   201\t\t\t}\r\n   202\t\t\tif !threats[i].firstTime.Equal(threats[j].firstTime) {\r\n   203\t\t\t\treturn threats[i].firstTime.Before(threats[j].firstTime)\r\n   204\t\t\t}\r\n   205\t\t\treturn threats[i].ThreatType < threats[j].ThreatType\r\n   206\t\t})\r\n   207\t}\r\n   208\t\r\n   209\tfunc detectBruteForce(events []Event) []Threat {\r\n   210\t\tbyIP := make(map[string][]Event)\r\n"]
