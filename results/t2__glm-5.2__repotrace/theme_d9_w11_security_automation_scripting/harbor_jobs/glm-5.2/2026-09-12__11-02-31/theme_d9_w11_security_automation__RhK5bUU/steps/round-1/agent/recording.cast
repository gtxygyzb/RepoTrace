[4826.211347, "o", "\tThreatCount:  len(indices),\r\n   176\t\t\tThreatTypes:  []string{},\r\n   177\t\t\tSharedActors: []string{},\r\n   178\t\t\tAllActors:    []string{},\r\n   179\t\t\tThreats:      []map[string]interface{}{},\r\n   180\t\t}\r\n   181\t\r\n   182\t\ttypeSet := make(map[string]bool)\r\n   183\t\tactorSet := make(map[string]bool)\r\n"]
