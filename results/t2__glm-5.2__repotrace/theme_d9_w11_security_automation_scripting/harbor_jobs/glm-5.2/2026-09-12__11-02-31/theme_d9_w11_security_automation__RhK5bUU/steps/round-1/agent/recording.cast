[8422.036666, "o", "\u001b[35m\u001b[Ktimeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"medium\":\r\n\u001b[35m\u001b[Ktimeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"high\":\r\n\u001b[35m\u001b[Ktimeline.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"critical\":\r\n"]
