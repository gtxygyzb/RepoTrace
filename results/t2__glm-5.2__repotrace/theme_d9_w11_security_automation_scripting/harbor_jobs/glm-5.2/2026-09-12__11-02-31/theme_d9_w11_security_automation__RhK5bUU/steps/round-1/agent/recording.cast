[4833.017046, "o", "     6\t\t\"os\"\r\n     7\t)\r\n     8\t\r\n     9\tfunc main() {\r\n    10\t\tif len(os.Args) < 2 {\r\n    11\t\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline> [flags]\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\r\n    15\t\tvar code int\r\n    16\t\tswitch os.Args[1] {\r\n    17\t\t"]
[4833.017121, "o", "case \"analyze\":\r\n    18\t\t\tcode = runAnalyze(os.Args[2:])\r\n    19\t\tcase \"summarize\":\r\n    20\t\t\tcode = runSummarize(os.Args[2:])\r\n    21\t\tcase \"filter\":\r\n    22\t\t\tcode = runFilter(os.Args[2:])\r\n    23\t\tcase \"respond\":\r\n    24\t\t\tcode = runRespond(os.Args[2:])\r\n    25\t\tcase \"enrich\":\r\n    26\t\t\tcode = runEnrich(os.Args[2:])\r\n"]
[4833.017188, "o", "    27\t\tcase \"correlate\":\r\n    28\t\t\tcode = runCorrelate(os.Args[2:])\r\n    29\t\tcase \"timeline\":\r\n    30\t\t\tcode = runTimeline(os.Args[2:])\r\n    31\t\tdefault:\r\n    32\t\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n    33\t\t\tcode = 1\r\n    34\t\t}\r\n    35\t\tos.Exit(code)\r\n"]
[4833.017282, "o", "    36\t}\r\n    37\t\r\n    38\tfunc newFlagSet(name string) *flag.FlagSet {\r\n    39\t\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n    40\t\tfs.SetOutput(os.Stderr)\r\n    41\t\tfs.Usage = func() {}\r\n    42\t\treturn fs\r\n    43\t}\r\n    44\t\r\n    45\tfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n    46\t\tif err := fs.Parse(args); err != nil {\r\n    47\t\t\treturn false\r\n    48\t\t}\r\n    49\t\treturn true\r\n"]
[4833.017345, "o", "    50\t}\r\n    51\t\r\n    52\tfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n    53\t\tset := false\r\n    54\t\tfs.Visit(func(f *flag.Flag) {\r\n    55\t\t\tif f.Name == name {\r\n    56\t\t\t\tset = true\r\n    57\t\t\t"]
[4833.017408, "o", "}\r\n    58\t\t})\r\n    59\t\treturn set\r\n    60\t}\r\n"]
