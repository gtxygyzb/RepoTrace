[11710.190202, "i", "cat > compliance.go <<'EOF'\npackage main\n\nimport (\n\t\"bufio\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n)\n\ntype complianceInputSnapshot struct {\n\tGlobalMeanRisk float64 `json:\"global_mean_risk\"`\n\tTotalThreats   int     `json:\"total_threats\"`\n}\n\ntype compliancePolicy struct {\n\tMaxRisk    float64 `json:\"max_risk\"`\n\tMaxThreats int     `json:\"max_threats\"`\n}\n\ntype complianceViolation struct {\n\tIndex          int        `json:\"index\"`\n\tGlobalMeanRisk json.Number `json:\"global_mean_risk\"`\n\tTotalThreats   int        `json:\"total_threats\"`\n\tReasons        []string   `json:\"reasons\"`\n}\n\ntype complianceSummary struct {\n\tWorstRisk    json.Number `json:\"worst_risk\"`\n\tWorstThreats int         `json:\"worst_threats\"`\n\tMeanRisk     json.Number `json:\"mean_risk\"`\n\tMeanThreats  json.Number `json:\"mean_threats\"`\n}\n\ntype complianceOutput struct {\n\tTotalSnapshots       int                   `json:\"total_snapshots\"`\n\tCompliantCount       int                   `json:\"compliant_count\"`\n\tViolationCount       int                 "]
[11710.190517, "i", "  `json:\"violation_count\"`\n\tCompliancePercentage json.Number           `json:\"compliance_percentage\"`\n\tStatus               string                `json:\"status\"`\n\tPolicy               compliancePolicy      `json:\"policy\"`\n\tViolations           []complianceViolation `json:\"violations\"`\n\tSummary              complianceSummary     `json:\"summary\"`\n}\n\nfunc runCompliance(args []string) int {\n\tfs := newFlagSet(\"compliance\")\n\tmaxRisk := fs.Float64(\"max-risk\", 300.0, \"maximum allowed global mean risk\")\n\tmaxThreats := fs.Int(\"max-threats\", 20, \"maximum allowed total threats\")\n\tminSnapshots := fs.Int(\"min-snapshots\", 1, \"minimum number of input snapshots\")\n\tif !parseFlags(fs, args) {\n\t\treturn 1\n\t}\n\n\tif *maxRisk <= 0 {\n\t\tfmt.Fprintln(os.Stderr, \"error: --max-risk must be greater than 0\")\n\t\treturn 1\n\t}\n\tif *maxThreats <= 0 {\n\t\tfmt.Fprintln(os.Stderr, \"error: --max-threats must be greater than 0\")\n\t\treturn 1\n\t}\n\n\tvar snapshots []complianceInputSnapshot\n\tscanner := bufio.NewScanner(os.Stdin)\n\tscanner.Buffer(make([]byte, 10"]
