[4123.954777, "o", "\tactorBonus := 0.0\r\n\tswitch len(actors) {\r\n\tcase 0, 1:\r\n\t\tactorBonus = 0.0\r\n\tcase 2:\r\n\t\tactorBonus = 15.0\r\n\tdefault:\r\n\t\tactorBonus = 30.0\r\n\t}\r\n\r\n\tenrichedScore := riskScore*(1.0+maxConf) + tagBonus + multiVectorBonus + float64(severityContrib) + actorBonus\r\n\r\n"]
[4123.955029, "o", "\toutMatches := make([]iocMatchOutput, 0, len(matches))\r\n\tfor _, m := range matches {\r\n\t\toutMatches = append(outMatches, iocMatchOutput{\r\n\t\t\tIocID:         m.p.entry.ID,\r\n\t\t\tIndicator:     m.p.entry.Indicator,\r\n\t\t\tIndicatorType: m.p.entry.IndicatorType,\r\n\t\t\tThreatActor:   m.p.entry.ThreatActor,\r\n\t\t\tConfidence:    m.p.entry.Confidence,\r\n\t\t\tTags:          nonNilStrings(m.p.entry.Tags),\r\n\t\t\tMatchedFields: nonNilStrings(m.matchedFields),\r\n\t\t})\r\n\t}\r\n\r\n\tthreat[\"ioc_matches\"] = outMatches\r\n\tthreat[\"enriched_risk_score\"] = enrichedScore\r\n\tthreat[\"threat_actors\"] = nonNilStrings(sortedUniqueStringsFromSet(actors))\r\n\tthreat[\"max_ioc_confidence\"] = maxConf\r\n\tif len(matches) == 0 {\r\n\t\tthreat[\"ioc_severity\"] = \"none\"\r\n\t} else {\r\n\t\tthreat[\"ioc_severity\"] = severityFromRank(sevRank)\r\n\t}\r\n\treturn threat\r\n}\r\n\r\nfunc computeIOCMatches(threat map[string]interface{}, iocs []processedIOC, refTime time.Time, minConf float64) []iocMatchInternal {\r\n\tactive := make([]activeIOC, 0, len(iocs))\r\n\tfor _, p := range iocs {\r\n\t\tbase, factor, "]
[4123.955146, "o", "ok := computeFreshness(p, refTime)\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif base < minConf {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tactive = append(active, activeIOC{p: p, base: base, factor: factor})\r\n\t}\r\n\r\n\tmatchedFields := make([]map[string]bool, len(active))\r\n\tfor i := range active {\r\n\t\tmatchedFields[i] = make(map[string]bool)\r\n\t}\r\n\r\n\ttype cidrCandidate struct {\r\n\t\tactiveIdx int\r\n\t\tbase      float64\r\n\t\tprefixLen int\r\n\t\tiocID     string\r\n\t}\r\n\tcidrCandidates := make(map[string]map[string][]cidrCandidate)\r\n\r\n\taddCIDRCandidate := func(field, ipStr string, idx int, a activeIOC) {\r\n\t\tif cidrCandidates[field] == nil {\r\n\t\t\tcidrCandidates[field] = make(map[string][]cidrCandidate)\r\n\t\t}\r\n\t\tcidrCandidates[field][ipStr] = append(cidrCandidates[field][ipStr], cidrCandidate{\r\n\t\t\tactiveIdx: idx,\r\n\t\t\tbase:      a.base,\r\n\t\t\tprefixLen: a.p.prefixLen,\r\n\t"]
[4123.955284, "o", "\t\tiocID:     a.p.entry.ID,\r\n\t\t})\r\n\t}\r\n\r\n\tshadowPairs := make(map[string]bool)\r\n\taddShadow := func(field, ip string) {\r\n\t\tshadowPairs[field+\"\\x00\"+ip] = true\r\n\t}\r\n\tisShadowed := func(field, ip string) bool {\r\n\t\treturn shadowPairs[field+\"\\x00\"+ip]\r\n\t}\r\n\r\n\tfor i, a := range active {\r\n\t\tswitch a.p.entry.IndicatorType {\r\n\t\tcase \"ipv4\":\r\n"]
[4123.955357, "o", "\t\t\tif val, ok := getString(threat, \"source_ip\"); ok && a.p.entry.Indicator == val {\r\n\t\t\t\tmatchedFields[i][\"source_ip\"] = true\r\n\t\t\t\taddShadow(\"source_ip\", val)\r\n\t\t\t}\r\n\t\t\tif val, ok := getString(threat, \"dest_ip\"); ok && a.p.entry.Indicator == val {\r\n\t\t\t\tmatchedFields[i][\"dest_ip\"] = true\r\n\t\t\t\taddShadow(\"dest_ip\", val)\r\n"]
[4123.955415, "o", "\t\t\t}\r\n\t\t\tif vals, ok := getStringSlice(threat, \"dest_ips\"); ok {\r\n\t\t\t\tfor _, val := range vals {\r\n\t\t\t\t\tif a.p.entry.Indicator == val {\r\n\t\t\t\t\t\tmatchedFields[i][\"dest_ips\"] = true\r\n\t\t\t\t\t\taddShadow(\"dest_ips\", val)\r\n"]
[4123.955499, "o", "\t\t\t\t\t\tbreak\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[4123.955625, "o", "\t\t\tif vals, ok := getStringSlice(threat, \"compromised_hosts\"); ok {\r\n\t\t\t\tfor _, val := range vals {\r\n\t\t\t\t\tif a.p.entry.Indicator == val {\r\n\t\t\t\t\t\tmatchedFields[i][\"compromised_hosts\"] = true\r\n\t\t\t\t\t\taddShadow(\"compromised_hosts\", val)\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\tcase \"port\":\r\n\t\t\tif vals, ok := getIntSlice(threat, \"ports_scanned\"); ok {\r\n\t\t\t\tfor _, val := range vals {\r\n\t\t\t\t\tif a.p.port == val {\r\n\t\t\t\t\t\tmatchedFields[i][\"ports_scanned\"] = true\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\tcase \"user\":\r\n\t\t\tif val, ok := getString(threat, \"user\"); ok && a.p.entry.Indicator == val {\r\n"]
[4123.955768, "o", "\t\t\t\tmatchedFields[i][\"user\"] = true\r\n\t\t\t}\r\n\t\t\tif vals, ok := getStringSlice(threat, \"target_users\"); ok {\r\n\t\t\t\tfor _, val := range vals {\r\n\t\t\t\t\tif a.p.entry.Indicator == val {\r\n\t\t\t\t\t\tmatchedFields[i][\"target_users\"] = true\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfor i, a := range active {\r\n\t\tif a.p.entry.IndicatorType != \"ipv4_cidr\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif val, ok := getString(threat, \"source_ip\"); ok {\r\n\t\t\tif ip := net.ParseIP(val); ip != nil && a.p.ipNet.Contains(ip) && !isShadowed(\"source_ip\", val) {\r\n\t\t\t\taddCIDRCandidate(\"source_ip\", val, i, a)\r\n\t\t\t}\r\n\t\t}\r\n\t\tif val, ok := getString(threat, \"dest_ip\"); ok {\r\n"]
[4123.955872, "o", "\t\t\tif ip := net.ParseIP(val); ip != nil && a.p.ipNet.Contains(ip) && !isShadowed(\"dest_ip\", val) {\r\n\t\t\t\taddCIDRCandidate(\"dest_ip\", val, i, a)\r\n\t\t\t}\r\n\t\t}\r\n\t\tif vals, ok := getStringSlice(threat, \"dest_ips\"); ok {\r\n\t\t\tfor _, val := range vals {\r\n\t\t\t\tif ip := net.ParseIP(val); ip != nil && a.p.ipNet.Contains(ip) && !isShadowed(\"dest_ips\", val) {\r\n\t\t\t\t\taddCIDRCandidate(\"dest_ips\", val, i, a)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif vals, ok := getStringSlice(threat, \"compromised_hosts\"); ok {\r\n\t\t\tfor _, val := range vals {\r\n\t\t\t\tif ip := net.ParseIP(val); ip != nil && a.p.ipNet.Contains(ip) && !isShadowed(\"compromised_hosts\", val) {\r\n"]
[4123.955959, "o", "\t\t\t\t\taddCIDRCandidate(\"compromised_hosts\", val, i, a)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfor field, ipMap := range cidrCandidates {\r\n\t\tfor _, cands := range ipMap {\r\n\t\t\tsort.Slice(cands, func(i, j int) bool {\r\n\t\t\t\tif cands[i].prefixLen != cands[j].prefixLen {\r\n\t\t\t\t\treturn cands[i].prefixLen > cands[j].prefixLen\r\n"]
[4123.956043, "o", "\t\t\t\t}\r\n\t\t\t\tif cands[i].base != cands[j].base {\r\n\t\t\t\t\treturn cands[i].base > cands[j].base\r\n\t\t\t\t}\r\n\t\t\t\treturn cands[i].iocID < cands[j].iocID\r\n\t\t\t})\r\n\t\t\twinner := cands[0].activeIdx\r\n"]
[4123.956135, "o", "\t\t\tmatchedFields[winner][field] = true\r\n\t\t}\r\n\t}\r\n\r\n\tmatches := make([]iocMatchInternal, 0, len(active))\r\n\tfor i, a := range active {\r\n\t\tif len(matchedFields[i]) == 0 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfields := sortedKeys(matchedFields[i])\r\n\t\tadjusted := a.base * maxFieldMultiplier(fields)\r\n\t\tmatches = append(matches, iocMatchInternal{\r\n"]
[4123.956207, "o", "\t\t\tp:             a.p,\r\n\t\t\tbase:          a.base,\r\n\t\t\tfreshness:     a.factor,\r\n\t\t\tadjusted:      adjusted,\r\n\t\t\tmatchedFields: fields,\r\n\t\t})\r\n"]
[4123.95629, "o", "\t}\r\n\r\n\tsort.SliceStable(matches, func(i, j int) bool {\r\n\t\tif matches[i].adjusted != matches[j].adjusted {\r\n\t\t\treturn matches[i].adjusted > matches[j].adjusted\r\n\t\t}\r\n\t\treturn matches[i].p.entry.ID < matches[j].p.entry.ID\r\n\t})\r\n\treturn matches\r\n}\r\n\r\nfunc computeFreshness(p processedIOC, refTime time.Time) (float64, float64, bool) {\r\n\tageHours := refTime.Sub(p.lastUpdated).Hours()\r\n\tfreshnessFraction := ageHours / float64(p.ttlHours)\r\n\tif freshnessFraction >= 1.0 {\r\n\t\treturn 0, 0, false\r\n"]
[4123.956371, "o", "\t}\r\n\tfactor := freshnessFactor(freshnessFraction)\r\n\treturn p.entry.Confidence * factor, factor, true\r\n}\r\n\r\nfunc freshnessFactor(fraction float64) float64 {\r\n\tswitch {\r\n\tcase fraction < 0.25:\r\n\t\treturn 1.0\r\n\tcase fraction < 0.50:\r\n\t\treturn 0.9\r\n\tcase fraction < 0.75:\r\n"]
[4123.956463, "o", "\t\treturn 0.7\r\n\tdefault:\r\n\t\treturn 0.5\r\n\t}\r\n}\r\n\r\nfunc fieldMultiplier(field string) float64 {\r\n\tswitch field {\r\n\tcase \"source_ip\", \"dest_ip\", \"compromised_hosts\", \"user\":\r\n\t\treturn 1.0\r\n\tcase \"dest_ips\", \"target_users\":\r\n\t\treturn 0.8\r\n\tcase \"ports_scanned\":\r\n\t\treturn 0.6\r\n\t"]
[4123.956525, "o", "default:\r\n\t\treturn 0.0\r\n\t}\r\n}\r\n\r\n"]
[4123.956616, "o", "func maxFieldMultiplier(fields []string) float64 {\r\n\tmax := 0.0\r\n\tfor _, f := range fields {\r\n\t\tif m := fieldMultiplier(f); m > max {\r\n\t\t\tmax = m\r\n\t\t}\r\n"]
[4123.956676, "o", "\t}\r\n\treturn max\r\n}\r\n\r\nfunc tagBonusValue(tag string) float64 {\r\n\tswitch tag {\r\n\tcase \"apt\":\r\n\t\treturn 100.0\r\n\tcase \"ransomware\":\r\n\t\treturn 75.0\r\n\tcase \"botnet\":\r\n\t\treturn 50.0\r\n\tcase \"phishing\":\r\n\t\treturn 30.0\r\n\tcase \"scanner\":\r\n\t\treturn 25.0\r\n\tcase \"cryptominer\":\r\n\t\treturn 20.0\r\n\tdefault:\r\n\t\treturn 0.0\r\n\t}\r\n}\r\n"]
[4123.956754, "o", "\r\nfunc severityWeight(s string) int {\r\n\tswitch s {\r\n\tcase \"low\":\r\n\t\treturn 5\r\n\tcase \"medium\":\r\n\t\treturn 10\r\n\tcase \"high\":\r\n\t\treturn 20\r\n\tcase \"critical\":\r\n\t\treturn 40\r\n\tdefault:\r\n\t\treturn 0\r\n\t}\r\n}\r\n"]
[4123.956814, "o", "\r\nfunc severityFromRank(rank int) string {\r\n\tswitch rank {\r\n\tcase 1:\r\n\t\treturn \"low\"\r\n\tcase 2:\r\n\t\treturn \"medium\"\r\n\tcase 3:\r\n\t\treturn \"high\"\r\n"]
[4123.956894, "o", "\tcase 4:\r\n\t\treturn \"critical\"\r\n\tdefault:\r\n\t\treturn \"none\"\r\n\t}\r\n}\r\n\r\nfunc threatReferenceTime(threat map[string]interface{}) time.Time {\r\n\tif tt, ok := getString(threat, \"threat_type\"); ok && tt == \"privilege_escalation\" {\r\n\t\tif ts, ok := getString(threat, \"timestamp\"); ok {\r\n\t\t\tif t, err := parseTime(ts); err == nil {\r\n\t\t\t\treturn t\r\n\t\t\t}\r\n\t\t}\r\n"]
[4123.95697, "o", "\t}\r\n\tif ts, ok := getString(threat, \"first_seen\"); ok {\r\n\t\tif t, err := parseTime(ts); err == nil {\r\n\t\t\treturn t\r\n\t\t}\r\n\t}\r\n\treturn time.Time{}\r\n}\r\n\r\nfunc sortEnrichedThreats(threats []map[string]interface{}) {\r\n\t"]
[4123.957054, "o", "sort.SliceStable(threats, func(i, j int) bool {\r\n\t\ta := threats[i]\r\n\t\tb := threats[j]\r\n\t\tea, _ := getFloat(a, \"enriched_risk_score\")\r\n\t\teb, _ := getFloat(b, \"enriched_risk_score\")\r\n\t\tif ea != eb {\r\n\t\t\treturn ea > eb\r\n\t\t}\r\n\t\tta := threatSortTime(a)\r\n\t\ttb := threatSortTime(b)\r\n\t\tif !ta.Equal(tb) {\r\n\t\t\treturn ta.Before(tb)\r\n"]
[4123.957117, "o", "\t\t}\r\n\t\ttta, _ := getString(a, \"threat_type\")\r\n\t\tttb, _ := getString(b, \"threat_type\")\r\n\t\treturn tta < ttb\r\n\t})\r\n}\r\n\r\nfunc threatSortTime(threat map[string]interface{}) time.Time {\r\n\tif tt, ok := getString(threat, \"threat_type\"); ok && tt == \"privilege_escalation\" {\r\n\t\tif ts, ok := getString(threat, \"timestamp\"); ok {\r\n\t\t\tif t, err := parseTime(ts); err == nil {"]
[4123.95719, "o", "\r\n\t\t\t\treturn t\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif ts, ok := getString(threat, \"first_seen\"); ok {\r\n\t\tif t, err := parseTime(ts); err == nil {\r\n\t\t\treturn t\r\n\t\t}\r\n\t}\r\n\treturn time.Time{}\r\n"]
[4123.957273, "o", "}\r\n\r\nfunc getString(m map[string]interface{}, key string) (string, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn \"\", false\r\n\t}\r\n\ts, ok := v.(string)\r\n\treturn s, ok\r\n"]
[4123.95733, "o", "}\r\n\r\nfunc getStringSlice(m map[string]interface{}, key string) ([]string, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn nil, false\r\n\t}\r\n\tswitch val := v.(type) {\r\n"]
[4123.957406, "o", "\tcase []string:\r\n\t\treturn val, true\r\n"]
