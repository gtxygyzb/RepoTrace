[2820.980337, "o", "     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t)\r\n     8\t\r\n     9\tfunc main() {\r\n    10\t\tif len(os.Args) < 2 {\r\n    11\t\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich> [flags]\")\r\n"]
[2820.980424, "o", "    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\r\n    15\t\tvar code int\r\n    16\t\tswitch os.Args[1] {\r\n    17\t\tcase \"analyze\":\r\n    18\t\t\tcode = runAnalyze(os.Args[2:])\r\n    19\t\tcase \"summarize\":\r\n    20\t\t\tcode = runSummarize(os.Args[2:])\r\n    21\t\tcase \"filter\":\r\n    22\t\t\tcode = runFilter(os.Args[2:])\r\n    23\t\tcase \"respond\":\r\n    24\t\t\tcode = runRespond(os.Args[2:])\r\n    25\t\tcase \"enrich\":\r\n    26\t\t\tcode = runEnrich(os.Args[2:])\r\n    27\t\tdefault:\r\n    28\t\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n    29\t\t\tcode = 1\r\n    30\t\t}\r\n    31\t\tos.Exit(code)\r\n    32\t}\r\n    33\t\r\n    34\tfunc newFlagSet(name string) *flag.FlagSet {\r\n    35\t\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n    36\t\tfs.SetOutput(os.Stderr)\r\n    37\t\tfs.Usage = func() {}\r\n    38\t\treturn fs\r\n    39\t}\r\n    40\t\r\n    41\tfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n"]
[2820.980533, "o", "    42\t\tif err := fs.Parse(args); err != nil {\r\n    43\t\t\treturn false\r\n    44\t\t}\r\n    45\t\treturn true\r\n    46\t}\r\n    47\t\r\n    48\tfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n    49\t\tset := false\r\n    50\t\tfs.Visit(func(f *flag.Flag) {\r\n    51\t\t\tif f.Name == name {\r\n    52\t\t\t\tset = true\r\n    53\t\t\t}\r\n    54\t\t})\r\n    55\t\treturn set\r\n    56\t}\r\n"]
