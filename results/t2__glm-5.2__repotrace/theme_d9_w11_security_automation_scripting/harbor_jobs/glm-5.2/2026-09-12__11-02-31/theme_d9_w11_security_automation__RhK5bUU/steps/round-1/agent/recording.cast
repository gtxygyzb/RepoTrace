[10241.967887, "o", "\u001b[32m\u001b[K196\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase score >= \u001b[01;31m\u001b[K0.75\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn \"\u001b[01;31m\u001b[Kcritical\u001b[m\u001b[K\"\r\n"]
