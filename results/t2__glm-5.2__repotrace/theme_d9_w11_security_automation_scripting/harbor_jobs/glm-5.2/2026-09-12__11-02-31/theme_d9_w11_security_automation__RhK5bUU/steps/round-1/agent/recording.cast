[951.730872, "o", "\u001b[?2004h> "]
[951.730943, "o", "        lineNo++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[951.731094, "o", "        line := scanner.Text()\r\n\u001b[?2004l\r"]
[951.731154, "o", "\u001b[?2004h> "]
[951.731339, "o", "        if strings.TrimSpace(line) == \"\" {\r\n\u001b[?2004l\r"]
[951.731398, "o", "\u001b[?2004h> "]
[951.731479, "o", "            continue\r\n\u001b[?2004l\r"]
[951.731534, "o", "\u001b[?2004h> "]
[951.73159, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[951.731646, "o", "> "]
[951.731793, "o", "        idx := strings.Index(line, \":\")\r\n\u001b[?2004l\r"]
[951.731848, "o", "\u001b[?2004h> "]
[951.731933, "o", "        if idx < 0 {\r\n\u001b[?2004l\r"]
[951.731988, "o", "\u001b[?2004h> "]
[951.732373, "o", "            return nil, fmt.Errorf(\"invalid template line %d: missing colon\", lineNo)\r\n\u001b[?2004l\r"]
[951.732431, "o", "\u001b[?2004h> "]
[951.732487, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[951.732739, "o", "        threatType := strings.TrimSpace(line[:idx])\r\n\u001b[?2004l\r"]
[951.732796, "o", "\u001b[?2004h> "]
[951.733009, "o", "        action := strings.TrimSpace(line[idx+1:])\r\n\u001b[?2004l\r"]
[951.733065, "o", "\u001b[?2004h> "]
