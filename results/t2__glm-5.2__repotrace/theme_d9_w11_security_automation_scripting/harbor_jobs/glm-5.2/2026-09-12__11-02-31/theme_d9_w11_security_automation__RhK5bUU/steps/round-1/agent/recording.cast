[11908.169666, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"math\"\r\n     8\t\t\"os\"\r\n     9\t"]
[11908.16975, "o", "\t\"strconv\"\r\n    10\t)\r\n    11\t\r\n    12\ttype forecastInputSnapshot struct {\r\n    13\t\tGlobalMeanRisk float64 `json:\"global_mean_risk\"`\r\n    14\t\tTotalThreats   int     `json:\"total_threats\"`\r\n    15\t}\r\n    16\t\r\n    17\ttype forecastMetricResult struct {\r\n    18\t\tSlope       json.Number   `json:\"slope\"`\r\n    19\t\tIntercept   json.Number   `json:\"intercept\"`\r\n    20\t\tTrend       string        `json:\"trend\"`\r\n    21\t\t"]
[11908.169825, "o", "LastValue   json.Number   `json:\"last_value\"`\r\n    22\t\tPredictions []json.Number `json:\"predictions\"`\r\n    23\t}\r\n    24\t\r\n    25\ttype forecastOutput struct {\r\n    26\t\tInputCount   int                             `json:\"input_count\"`\r\n    27\t\tMetrics      map[string]forecastMetricResult `json:\"metrics\"`\r\n    28\t\tOverallTrend string                          `json:\"overall_trend\"`\r\n    29\t\tAlertLevel   string                          `json:\"alert_level\"`\r\n"]
[11908.169886, "o", "    30\t}\r\n    31\t\r\n    32\tfunc runForecast(args []string) int {\r\n    33\t\tfs := newFlagSet(\"forecast\")\r\n    34\t\tsteps := fs.Int(\"steps\", 3, \"number of future steps to predict\")\r\n    35\t\tif !parseFlags(fs, args) {\r\n    36\t\t\treturn 1\r\n    37\t\t}\r\n    38\t\tif *steps < 1 {\r\n    39\t\t"]
[11908.169955, "o", "\tfmt.Fprintln(os.Stderr, \"error: --steps must be at least 1\")\r\n    40\t\t\treturn 1\r\n    41\t\t}\r\n    42\t\r\n    43\t\tvar snapshots []forecastInputSnapshot\r\n    44\t\tscanner := bufio.NewScanner(os.Stdin)\r\n    45\t\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n    46\t\tfor scanner.Scan() {\r\n    47\t\t\tline := scanner.Text()\r\n    48\t\t\tif len(line) == 0 {\r\n"]
[11908.170035, "o", "    49\t\t\t\tcontinue\r\n    50\t\t\t}\r\n    51\t\t\tvar snap forecastInputSnapshot\r\n    52\t\t\tif err := json.Unmarshal([]byte(line), &snap); err != nil {\r\n    53\t\t\t\tfmt.Fprintf(os.Stderr, \"error: malformed JSON input: %s\\n\", err)\r\n    54\t\t\t\treturn 2\r\n    55\t\t\t}\r\n    56\t\t\tsnapshots = append(snapshots, snap)\r\n    57\t\t}\r\n    58\t\tif err := scanner.Err(); err != nil {\r\n    59\t\t\tfmt.Fprintf(os.Stderr, \"error: reading input: %s\\n\", err)\r\n"]
[11908.170094, "o", "    60\t\t\treturn 1\r\n    61\t\t}\r\n    62\t\tif len(snapshots) < 3 {\r\n    63\t\t\tfmt.Fprintln(os.Stderr, \"error: at least 3 valid input snapshots are required\")\r\n    64\t\t\treturn 1\r\n    65\t\t}\r\n    66\t\r\n    67\t\trisks := make([]float64, len(snapshots))\r\n    68\t\t"]
[11908.170154, "o", "threats := make([]float64, len(snapshots))\r\n    69\t\tfor i, snap := range snapshots {\r\n    70\t\t\trisks[i] = snap.GlobalMeanRisk\r\n    71\t\t\tthreats[i] = float64(snap.TotalThreats)\r\n    72\t\t}\r\n    73\t\r\n    74\t\triskSlope, riskIntercept := olsLine(0, risks)\r\n    75\t\tthreatSlope, threatIntercept := olsLine(0, threats)\r\n    76\t\r\n"]
[11908.170232, "o", "    77\t\triskPredictions := predictLine(riskSlope, riskIntercept, len(snapshots), *steps)\r\n    78\t\tthreatPredictions := predictLine(threatSlope, threatIntercept, len(snapshots), *steps)\r\n    79\t\r\n    80\t\triskTrend := trendFromSlope(riskSlope)\r\n    81\t\tthreatTrend := trendFromSlope(threatSlope)\r\n    82\t\r\n    83\t\tlast := snapshots[len(snapshots)-1]\r\n    84\t\tmetrics := map[string]forecastMetricResult{\r\n    85\t\t"]
[11908.170298, "o", "\t\"global_mean_risk\": {\r\n    86\t\t\t\tSlope:       json.Number(format4(riskSlope)),\r\n    87\t\t\t\tIntercept:   json.Number(format4(riskIntercept)),\r\n    88\t\t\t\tTrend:       riskTrend,\r\n    89\t\t\t\tLastValue:   json.Number(formatRiskValue(last.GlobalMeanRisk)),\r\n    90\t\t\t\tPredictions: roundAll4(riskPredictions),\r\n    91\t\t\t},\r\n    92\t\t\t\"total_threats\": {\r\n    93\t\t\t\tSlope:       json.Number(format4(threatSlope)),\r\n    94\t\t\t\tIntercept:   json.Number(format4(threatIntercept)),\r\n"]
[11908.170356, "o", "    95\t\t\t\tTrend:       threatTrend,\r\n    96\t\t\t\tLastValue:   json.Number(strconv.Itoa(last.TotalThreats)),\r\n    97\t\t\t\tPredictions: roundAll4(threatPredictions),\r\n    98\t\t\t},\r\n    99\t\t}\r\n   100\t\r\n   101\t\tout := forecastOutput{\r\n   102\t\t\tInputCount:   len(snapshots),\r\n"]
[11908.170421, "o", "   103\t\t\tMetrics:      metrics,\r\n   104\t\t\tOverallTrend: overallTrend(riskTrend, threatTrend),\r\n   105\t\t\tAlertLevel:   alertLevelFromSlopes(risks, threats, riskSlope, threatSlope),\r\n   106\t\t}\r\n   107\t\r\n   108\t\tencoded, err := json.Marshal(out)\r\n   109\t\tif err != nil {\r\n   110\t\t\tfmt.Fprintln(os.Stderr, \"error: encoding forecast output:\", err)\r\n   111\t\t\treturn 1\r\n"]
[11908.170482, "o", "   112\t\t}\r\n   113\t\tfmt.Println(string(encoded))\r\n   114\t\treturn 0\r\n   115\t}\r\n   116\t\r\n   117\tfunc olsLine(startIndex int, values []float64) (slope, intercept float64) {\r\n   118\t\tn := len(values)\r\n   119\t\tif n == 0 {\r\n"]
[11908.170544, "o", "   120\t\t\treturn 0, 0\r\n   121\t\t}\r\n   122\t\tvar sumX, sumY, sumXY, sumX2 float64\r\n   123\t\tfor i, y := range values {\r\n   124\t\t\tx := float64(startIndex + i)\r\n   125\t\t\tsumX += x\r\n   126\t\t\tsumY += y\r\n   127\t\t\tsumXY += x * y\r\n   128\t\t\tsumX2 += x * x\r\n   129"]
[11908.170603, "o", "\t\t}\r\n   130\t\r\n   131\t\tdenom := float64(n)*sumX2 - sumX*sumX\r\n   132\t\tif denom == 0 {\r\n   133\t\t\tslope = 0\r\n   134\t\t\tintercept = values[0]\r\n   135\t\t\treturn\r\n   136\t\t}\r\n"]
[11908.170664, "o", "   137\t\tslope = (float64(n)*sumXY - sumX*sumY) / denom\r\n   138\t\tintercept = (sumY - slope*sumX) / float64(n)\r\n   139\t\treturn\r\n   140\t}\r\n   141\t\r\n   142\tfunc predictLine(slope, intercept float64, startIndex, steps int) []float64 {\r\n   143\t\tpredictions := make([]float64, steps)\r\n   144\t\tfor i := 0; i < steps; i++ {\r\n"]
[11908.17073, "o", "   145\t\t\tpredictions[i] = slope*float64(startIndex+i) + intercept\r\n   146\t\t}\r\n   147\t\treturn predictions\r\n   148\t}\r\n   149\t\r\n   150\tfunc trendFromSlope(slope float64) string {\r\n   151"]
[11908.170794, "o", "\t\tr := roundHalfUp4(slope)\r\n   152\t\tif r > 0 {\r\n   153\t\t\treturn \"increasing\"\r\n   154\t\t}\r\n   155\t\tif r < 0 {\r\n   156\t\t\treturn \"decreasing\"\r\n   157\t\t}\r\n   158\t\treturn \"stable\"\r\n   159\t}\r\n   160\t\r\n   161\tfunc overallTrend(a, b string) string {\r\n   162\t\tif a == \"increasing\" && b == \"increasing\" {\r\n   163\t\t\treturn \"increasing\"\r\n"]
[11908.170854, "o", "   164\t\t}\r\n   165\t\tif a == \"decreasing\" && b == \"decreasing\" {\r\n   166\t\t\treturn \"decreasing\"\r\n   167\t\t}\r\n   168\t\tif a == \"increasing\" || b == \"increasing\" {\r\n   169\t\t\tif a == \"decreasing\" || b == \"decreasing\" {\r\n   170\t\t\t\treturn \"mixed\"\r\n   171\t\t\t}\r\n   172\t\t\t"]
[11908.170916, "o", "return \"increasing\"\r\n   173\t\t}\r\n   174\t\tif a == \"decreasing\" || b == \"decreasing\" {\r\n   175\t\t\treturn \"decreasing\"\r\n   176\t\t}\r\n   177\t\treturn \"stable\"\r\n   178\t}\r\n   179\t"]
[11908.17098, "o", "\r\n   180\tfunc alertLevelFromSlopes(risks, threats []float64, riskSlope, threatSlope float64) string {\r\n   181\t\triskMean := meanOfValues(risks)\r\n   182\t\tthreatMean := meanOfValues(threats)\r\n   183\t\r\n   184\t\tmaxRatio := 0.0\r\n   185\t\tif riskSlope > 0 {\r\n   186\t\t\tratio := riskSlope / math.Max(riskMean, 1.0)\r\n   187\t\t\tif ratio > maxRatio {\r\n   188\t\t\t\tmaxRatio = ratio\r\n"]
[11908.171041, "o", "   189\t\t\t}\r\n   190\t\t}\r\n   191\t\tif threatSlope > 0 {\r\n   192\t\t\tratio := threatSlope / math.Max(threatMean, 1.0)\r\n   193\t\t\tif ratio > maxRatio {\r\n   194\t\t\t\tmaxRatio = ratio\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197"]
[11908.171104, "o", "\t\r\n   198\t\tif maxRatio >= 0.5 {\r\n   199\t\t\treturn \"critical\"\r\n   200\t\t}\r\n   201\t\tif maxRatio >= 0.2 {\r\n   202\t\t\treturn \"warning\"\r\n   203\t\t}\r\n   204\t\treturn \"normal\"\r\n   205\t}\r\n   206"]
[11908.171163, "o", "\t\r\n   207\tfunc meanOfValues(values []float64) float64 {\r\n   208\t\tif len(values) == 0 {\r\n   209\t\t\treturn 0\r\n   210\t\t}\r\n   211\t\tvar sum float64\r\n   212\t\tfor _, v := range values {\r\n   213\t\t\tsum += v\r\n   214\t\t}\r\n"]
[11908.171249, "o", "   215\t\treturn sum / float64(len(values))\r\n   216\t}\r\n   217\t\r\n   218\tfunc roundAll4(values []float64) []json.Number {\r\n   219\t\tout := make([]json.Number, len(values))\r\n   220\t\tfor i, v := range values {\r\n   221\t\t\tout[i] = json.Number(format4(v))\r\n   222\t\t}\r\n   223\t\treturn out\r\n   224\t}\r\n"]
