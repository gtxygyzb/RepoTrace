[11966.375914, "o", "\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktype \u001b[01;31m\u001b[KforecastOutput\u001b[m\u001b[K struct {\r\n\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tMetrics      map[string]\u001b[01;31m\u001b[KforecastMetricResult\u001b[m\u001b[K `json:\"metrics\"`\r\n"]
[11966.37598, "o", "\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc runForecast\u001b[m\u001b[K(args []string) int {\r\n"]
[11966.376045, "o", "\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar snapshots []\u001b[01;31m\u001b[KforecastInputSnapshot\u001b[m\u001b[K\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tvar snap \u001b[01;31m\u001b[KforecastInputSnapshot\u001b[m\u001b[K\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmetrics := map[string]\u001b[01;31m\u001b[KforecastMetricResult\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tout := \u001b[01;31m\u001b[KforecastOutput\u001b[m\u001b[K{\r\n"]
[11966.376116, "o", "\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KolsLine(startIndex int, values []float64) (slope, intercept float64) {\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KpredictLine(slope, intercept float64, startIndex, steps int) []float64 {\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KtrendFromSlope(slope float64) string {\r\n"]
[11966.376181, "o", "\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KoverallTrend(a, b string) string {\r\n\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KalertLevelFromSlopes(risks, threats []float64, riskSlope, threatSlope float64) string {\r\n\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KmeanOfValues(values []float64) float64 {\r\n\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KroundAll4(values []float64) []json.Number {\r\n"]
