[4855.609442, "o", "\tminRisk = risk\r\n   138\t\t\t} else {\r\n   139\t\t\t\tif risk > maxRisk {\r\n   140\t\t\t\t\tmaxRisk = risk\r\n   141\t\t\t\t}\r\n   142\t\t\t\tif risk < minRisk {\r\n   143\t\t\t\t\tminRisk = risk\r\n   144\t\t\t\t}\r\n   145\t\t\t}\r\n   146\t\t\tif tt, ok := getString(threat, \"threat_type\"); ok {\r\n   147\t\t\t\ttypeCounts[tt]++\r\n   148\t\t\t}\r\n   149\t\t\tif sev, ok := getString(threat, \"ioc_severity\"); ok {\r\n   150\t\t\t\tif _, exists := b.SeverityHistogram[sev]; exists {\r\n"]
[4855.609509, "o", "   151\t\t\t\t\tb.SeverityHistogram[sev]++\r\n   152\t\t\t\t}\r\n   153\t\t\t}\r\n   154\t\t\tif actors, ok := getStringSlice(threat, \"threat_actors\"); ok {\r\n   155\t\t\t\tfor _, actor := range actors {\r\n"]
[4855.609579, "o", "   156\t\t\t\t\tif actor != \"\" {\r\n   157\t\t\t\t\t\tactorSet[actor] = true\r\n   158\t\t\t\t\t}\r\n   159\t\t\t\t}\r\n   160\t\t\t}\r\n   161\t\t}\r\n   162\t\tb.AvgRisk = round2(sumRisk / float64(n))\r\n   163\t\tb.MaxRisk = maxRisk\r\n   164\t\tb.MinRisk = minRisk\r\n   165\t\r\n   166\t\tmean := sumRisk / float64(n)\r\n"]
[4855.609641, "o", "   167\t\tvar variance float64\r\n   168\t\tfor _, risk := range risks {\r\n   169\t\t\tdiff := risk - mean\r\n   170\t\t\tvariance += diff * diff\r\n   171\t\t}\r\n   172\t\tif n == 1 {\r\n   173\t\t\tvariance = 0.0\r\n   174\t\t} else {\r\n   175\t\t\tvariance /= float64(n)\r\n"]
[4855.60971, "o", "   176\t\t}\r\n   177\t\tb.RiskStdDev = round2(math.Sqrt(variance))\r\n   178\t\r\n   179\t\tb.DominantType = dominantThreatType(typeCounts)\r\n   180\t\tb.TypeDistribution = typeCounts\r\n   181\t\r\n   182\t\tb.UniqueActors = nonNilStrings(sortedUniqueStringsFromSet(actorSet))\r\n   183\t\r\n   184\t\tb.EscalationIndex = round3(timelineEscalationIndex(threats))\r\n   185\t\tb.RiskTrend = round3(timelineRiskTrend(threats, startTime))\r\n"]
[4855.609803, "o", "   186\t\tb.BurstScore = round3(timelineBurstScore(threats))\r\n   187\t\r\n   188\t\tsortedTop := make([]map[string]interface{}, len(threats))\r\n   189\t\tcopy(sortedTop, threats)\r\n   190\t\tsort.SliceStable(sortedTop, func(i, j int) bool {\r\n   191\t\t\tri, _ := getFloat(sortedTop[i], \"enriched_risk_score\")\r\n   192\t\t\trj, _ := getFloat(sortedTop[j], \"enriched_risk_score\")\r\n   193\t\t\tif ri != rj {\r\n   194\t\t\t\treturn ri > rj\r\n   195\t\t\t}\r\n   196\t\t\tti, tj := threatSortTime(sortedTop[i]), threatSortTime(sortedTop[j])\r\n"]
[4855.609886, "o", "   197\t\t\tif !ti.Equal(tj) {\r\n   198\t\t\t\treturn ti.Before(tj)\r\n   199\t\t\t}\r\n   200\t\t\ttta, _ := getString(sortedTop[i], \"threat_type\")\r\n   201\t\t\tttb, _ := getString(sortedTop[j], \"threat_type\")\r\n   202\t\t\treturn tta < ttb\r\n   203\t\t})\r\n   204\t\tif topN < len(sortedTop) {\r\n   205\t\t\tsortedTop = sortedTop[:topN]\r\n   206\t\t}\r\n   207\t\tb.TopThreats = sortedTop\r\n   208\t\r\n   209\t\treturn b\r\n   210\t}\r\n"]
[4855.609976, "o", "   211\t\r\n   212\tfunc dominantThreatType(counts map[string]int) string {\r\n   213\t\tvar keys []string\r\n   214\t\tfor k := range counts {\r\n   215\t\t\tkeys = append(keys, k)\r\n   216\t\t}\r\n   217"]
[4855.610063, "o", "\t\tsort.Strings(keys)\r\n   218\t\tdominant := \"\"\r\n   219\t\tmaxCount := -1\r\n   220\t\tfor _, k := range keys {\r\n   221\t\t\tif counts[k] > maxCount {\r\n   222\t\t\t\tmaxCount = counts[k]\r\n   223\t\t\t\tdominant = k\r\n   224\t\t\t}\r\n   225\t\t}\r\n   226\t\treturn dominant\r\n   227\t}\r\n   228\t\r\n   229\tfunc timelineSeverityRank(sev string) int {\r\n   230\t\tswitch sev {\r\n   231\t\tcase \"none\":\r\n   232\t\t\treturn 0\r\n   233\t\tcase \"low\":\r\n   234\t\t\treturn 1\r\n   235\t\tcase \"medium\":\r\n   236\t\t\t"]
[4855.610155, "o", "return 2\r\n   237\t\tcase \"high\":\r\n   238\t\t\treturn 3\r\n   239\t\tcase \"critical\":\r\n   240\t\t\treturn 4\r\n   241\t\tdefault:\r\n   242\t\t\treturn -1\r\n   243\t\t}\r\n   244\t}\r\n   245\t\r\n   246\tfunc timelineEscalationIndex(threats []map[string]interface{}) float64 {\r\n   247\t\tn := len(threats)\r\n   248\t\tif n < 2 {\r\n   249\t\t\treturn 0.0\r\n   250\t\t}\r\n"]
[4855.610317, "o", "   251\t\tordered := make([]map[string]interface{}, len(threats))\r\n   252\t\tcopy(ordered, threats)\r\n   253\t\tsort.SliceStable(ordered, func(i, j int) bool {\r\n   254\t\t\tti, tj := threatSortTime(ordered[i]), threatSortTime(ordered[j])\r\n   255\t\t\tif !ti.Equal(tj) {\r\n"]
[4855.610415, "o", "   256\t\t\t\treturn ti.Before(tj)\r\n   257\t\t\t}\r\n   258\t\t\ttta, _ := getString(ordered[i], \"threat_type\")\r\n   259\t\t\tttb, _ := getString(ordered[j], \"threat_type\")\r\n   260\t\t\treturn tta < ttb\r\n   261\t\t})\r\n   262\t\r\n   263\t\tpositiveSum := 0.0\r\n   264\t\tfor i := 0; i < len(ordered)-1; i++ {\r\n   265\t\t\trankI := timelineSeverityRank(getStringDefault(ordered[i], \"ioc_severity\"))\r\n   266\t\t\trankJ := timelineSeverityRank(getStringDefault(ordered[i+1], \"ioc_severity\"))\r\n   267\t\t\tif rankI < 0 {\r\n   268\t\t\t\trankI = 0\r\n   269\t\t\t}\r\n   270\t\t\tif rankJ < 0 {\r\n   271\t\t\t\trankJ = 0\r\n   272\t\t\t}\r\n   273\t\t\tdelta := rankJ - rankI\r\n   274\t\t\tif delta > 0 {\r\n   275\t\t\t\tpositiveSum += float64(delta)\r\n"]
[4855.610487, "o", "   276\t\t\t}\r\n   277\t\t}\r\n   278\t\treturn positiveSum / (4.0 * float64(n-1))\r\n   279\t}\r\n   280\t\r\n   281\tfunc timelineRiskTrend(threats []map[string]interface{}, startTime time.Time) float64 {\r\n   282\t\tn := len(threats)\r\n   283\t\tif n < 2 {\r\n   284\t\t\treturn 0.0\r\n   285\t\t}\r\n   286\t\txs := make([]float64, n)\r\n   287\t\tys := make([]float64, n)\r\n   288\t\tfor i, threat := range threats {\r\n   289\t\t\trefTime := threatSortTime(threat)\r\n   290\t\t\txs[i] = refTime.Sub(startTime).Minutes()\r\n   291\t\t\tys[i], _ = getFloat(threat, \"enriched_risk_score\")\r\n   292\t\t}\r\n   293\t\tsameX := true\r\n   294\t"]
[4855.61057, "o", "\tfor i := 1; i < n; i++ {\r\n   295\t\t\tif xs[i] != xs[0] {\r\n   296\t\t\t\tsameX = false\r\n   297\t\t\t\tbreak\r\n   298\t\t\t}\r\n   299\t\t}\r\n   300\t\tif sameX {\r\n   301\t\t\treturn 0.0\r\n   302\t\t}\r\n"]
[4855.610654, "o", "   303\t\tvar sumX, sumY, sumXY, sumXX2 float64\r\n   304\t\tfor i := 0; i < n; i++ {\r\n   305\t\t\tsumX += xs[i]\r\n   306\t\t\tsumY += ys[i]\r\n   307\t\t\tsumXY += xs[i] * ys[i]\r\n   308\t\t\tsumXX2 += xs[i] * xs[i]\r\n   309\t\t}\r\n   310\t\tdenom := float64(n)*sumXX2 - sumX*sumX\r\n   311\t\tif denom == 0 {\r\n   312\t\t\treturn 0.0\r\n   313\t\t}\r\n   314\t\treturn (float64(n)*sumXY - sumX*sumY) / denom\r\n   315\t}\r\n   316\t\r\n"]
