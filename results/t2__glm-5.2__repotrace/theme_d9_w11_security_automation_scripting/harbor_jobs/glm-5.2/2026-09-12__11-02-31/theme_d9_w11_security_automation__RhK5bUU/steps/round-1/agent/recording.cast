[12028.51155, "i", "cat >> rate.go <<'EOF'\n\nfunc buildRateMetric(deltas []json.Number, isRisk bool) rateMetricResult {\n        if len(deltas) == 0 {\n                return rateMetricResult{\n                        MeanRate:    json.Number(format4(0)),\n                        MaxRate:     json.Number(\"0\"),\n                        MinRate:     json.Number(\"0\"),\n                        Volatility:  json.Number(format4(0)),\n                        Stability:   \"stable\",\n                        Deltas:      deltas,\n                }\n        }\n\n        floatDeltas := make([]float64, len(deltas))\n        for i, d := range deltas {\n                v, _ := d.Float64()\n                floatDeltas[i] = v\n        }\n\n        meanRate := meanOfValues(floatDeltas)\n        maxRate := maxRateDelta(floatDeltas)\n        minRate := minRateDelta(floatDeltas)\n        volatility := populationStdDev(floatDeltas)\n        stability := rateStability(volatility, math.Abs(meanRate))\n\n        var maxNum, minNum json.Number\n        if isRisk {\n               "]
[12028.511738, "i", " maxNum = json.Number(format4(maxRate))\n                minNum = json.Number(format4(minRate))\n        } else {\n                maxNum = json.Number(strconv.Itoa(int(maxRate)))\n                minNum = json.Number(strconv.Itoa(int(minRate)))\n        }\n\n        return rateMetricResult{\n                MeanRate:    json.Number(format4(meanRate)),\n                MaxRate:     maxNum,\n                MinRate:     minNum,\n                Volatility:  json.Number(format4(volatility)),\n                Stability:   stability,\n                Deltas:      deltas,\n        }\n}\n\nfunc riskDeltasAsNumbers(deltas []float64) []json.Number {\n        out := make([]json.Number, len(deltas))\n        for i, d := range deltas {\n                out[i] = json.Number(format4(d))\n        }\n        return out\n}\n\nfunc threatDeltasAsNumbers(deltas []int) []json.Number {\n        out := make([]json.Number, len(deltas))\n        for i, d := range deltas {\n                out[i] = json.Number(strconv.Itoa(d))\n        }\n        return out\n}\nEO"]
[12028.511806, "i", "F\n"]
