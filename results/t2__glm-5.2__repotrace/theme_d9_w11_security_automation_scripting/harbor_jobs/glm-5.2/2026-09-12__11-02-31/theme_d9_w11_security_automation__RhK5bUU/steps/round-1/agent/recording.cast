[951.734289, "o", "func readThreats() ([]ThreatInput, error) {\r\n\u001b[?2004l\r"]
[951.734347, "o", "\u001b[?2004h> "]
[951.734519, "o", "    scanner := bufio.NewScanner(os.Stdin)\r\n\u001b[?2004l\r"]
[951.734575, "o", "\u001b[?2004h> "]
[951.734825, "o", "    scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\u001b[?2004l\r"]
[951.734886, "o", "\u001b[?2004h> "]
[951.735006, "o", "    var threats []ThreatInput\r\n\u001b[?2004l\r"]
[951.735061, "o", "\u001b[?2004h> "]
[951.735132, "o", "    lineNo := 0\r\n\u001b[?2004l\r"]
[951.735187, "o", "\u001b[?2004h> "]
[951.735297, "o", "    for scanner.Scan() {\r\n\u001b[?2004l\r"]
[951.735353, "o", "\u001b[?2004h> "]
[951.735407, "o", "        lineNo++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[951.735502, "o", "        line := scanner.Text()\r\n\u001b[?2004l\r"]
[951.735562, "o", "\u001b[?2004h> "]
[951.735629, "o", "        if line == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[951.735702, "o", "            continue\r\n\u001b[?2004l\r"]
[951.735759, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[951.735826, "o", "\u001b[?2004h> "]
[951.735913, "o", "        var raw map[string]interface{}\r\n\u001b[?2004l\r"]
[951.735968, "o", "\u001b[?2004h> "]
[951.736145, "o", "        if err := json.Unmarshal([]byte(line), &raw); err != nil {\r\n\u001b[?2004l\r"]
[951.736203, "o", "\u001b[?2004h> "]
[951.736383, "o", "            return threats, fmt.Errorf(\"line %d: %w\", lineNo, err)\r\n\u001b[?2004l\r"]
[951.736444, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[951.736503, "o", "\u001b[?2004h> "]
[951.736558, "o", "        t := ThreatInput{\r\n\u001b[?2004l\r"]
[951.736619, "o", "\u001b[?2004h> "]
[951.736759, "o", "            ThreatType: stringValue(raw, \"threat_type\"),\r\n\u001b[?2004l\r"]
[951.73682, "o", "\u001b[?2004h> "]
[951.736956, "o", "            SourceIP:   stringValue(raw, \"source_ip\"),\r\n\u001b[?2004l\r"]
[951.737016, "o", "\u001b[?2004h> "]
[951.737145, "o", "            DestIP:     stringValue(raw, \"dest_ip\"),\r\n\u001b[?2004l\r"]
[951.737201, "o", "\u001b[?2004h> "]
[951.737334, "o", "            User:       stringValue(raw, \"user\"),\r\n\u001b[?2004l\r"]
[951.737395, "o", "\u001b[?2004h> "]
[951.73753, "o", "            Timestamp:  stringValue(raw, \"timestamp\"),\r\n\u001b[?2004l\r"]
[951.737589, "o", "\u001b[?2004h> "]
[951.737725, "o", "            RiskScore:  floatValue(raw, \"risk_score\"),\r\n\u001b[?2004l\r"]
[951.73778, "o", "\u001b[?2004h> "]
[951.737843, "o", "            raw:        raw,\r\n\u001b[?2004l\r"]
[951.7379, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[951.737956, "o", "\u001b[?2004h> "]
[951.738118, "o", "        t.PortsScanned = intSliceValue(raw, \"ports_scanned\")\r\n\u001b[?2004l\r"]
[951.738174, "o", "\u001b[?2004h> "]
[951.738268, "o", "        threats = append(threats, t)\r\n\u001b[?2004l\r"]
[951.738327, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[951.738386, "o", "> "]
[951.738478, "o", "    if err := scanner.Err(); err != nil {\r\n\u001b[?2004l\r"]
