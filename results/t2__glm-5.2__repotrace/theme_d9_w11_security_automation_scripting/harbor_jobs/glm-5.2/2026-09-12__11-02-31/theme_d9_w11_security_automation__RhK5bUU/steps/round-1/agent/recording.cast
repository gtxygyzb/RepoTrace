[637.105142, "o", "func nonNilInts(s []int) []int {\r\n\u001b[?2004l\r"]
[637.105242, "o", "\u001b[?2004h> "]
[637.105339, "o", "    if s == nil {\r\n\u001b[?2004l\r"]
[637.105418, "o", "\u001b[?2004h> "]
[637.105568, "o", "        return []int{}\r\n\u001b[?2004l\r"]
[637.105633, "o", "\u001b[?2004h> "]
[637.105687, "o", "    }\r\n\u001b[?2004l\r"]
[637.105757, "o", "\u001b[?2004h> "]
[637.105838, "o", "    return s\r\n\u001b[?2004l\r"]
[637.105901, "o", "\u001b[?2004h> }"]
[637.105954, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.106009, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[637.106073, "o", "> "]
[637.10637, "o", "func sortEvents(events []Event) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.106728, "o", "    sort.SliceStable(events, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[637.106801, "o", "\u001b[?2004h> "]
[637.10713, "o", "        ti, errI := parseTime(events[i].Timestamp)\r\n\u001b[?2004l\r"]
[637.10719, "o", "\u001b[?2004h> "]
[637.107564, "o", "        tj, errJ := parseTime(events[j].Timestamp)\r\n\u001b[?2004l\r"]
[637.107629, "o", "\u001b[?2004h"]
[637.107702, "o", "> "]
[637.107894, "o", "        if errI == nil && errJ == nil {\r\n\u001b[?2004l\r"]
[637.107956, "o", "\u001b[?2004h> "]
[637.108169, "o", "            if ti.Before(tj) {\r\n\u001b[?2004l\r"]
[637.108236, "o", "\u001b[?2004h> "]
[637.108422, "o", "                return true\r\n\u001b[?2004l\r"]
[637.10849, "o", "\u001b[?2004h> "]
[637.108629, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.108856, "o", "            if tj.Before(ti) {\r\n\u001b[?2004l\r"]
[637.108943, "o", "\u001b[?2004h> "]
[637.109117, "o", "                return false\r\n\u001b[?2004l\r"]
[637.109177, "o", "\u001b[?2004h> "]
[637.109275, "o", "            }\r\n\u001b[?2004l\r"]
[637.109332, "o", "\u001b[?2004h> "]
[637.109735, "o", "            return events[i].Timestamp < events[j].Timestamp\r\n\u001b[?2004l\r"]
[637.109832, "o", "\u001b[?2004h> "]
[637.109912, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[637.110319, "o", "        return events[i].Timestamp < events[j].Timestamp\r\n\u001b[?2004l\r"]
[637.110382, "o", "\u001b[?2004h> "]
[637.110441, "o", "    })\r\n\u001b[?2004l\r"]
[637.110498, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[637.110559, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[637.110622, "o", "\u001b[?2004h> "]
[637.110863, "o", "func eventTime(e Event) (time.Time, bool) {\r\n\u001b[?2004l\r"]
[637.110921, "o", "\u001b[?2004h> "]
[637.111118, "o", "    t, err := parseTime(e.Timestamp)\r\n\u001b[?2004l\r"]
[637.111194, "o", "\u001b[?2004h> "]
[637.111304, "o", "    return t, err == nil\r\n\u001b[?2004l\r"]
[637.111363, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[637.111418, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[637.111473, "o", "\u001b[?2004h> "]
[637.111702, "o", "func detectThreats(events []Event) []Threat {\r\n\u001b[?2004l\r"]
[637.111756, "o", "\u001b[?2004h> "]
[637.111864, "o", "    sortEvents(events)\r\n\u001b[?2004l\r"]
[637.111921, "o", "\u001b[?2004h> "]
[637.112036, "o", "    var threats []Threat\r\n\u001b[?2004l\r"]
[637.112096, "o", "\u001b[?2004h> "]
[637.112421, "o", "    threats = append(threats, detectBruteForce(events)...)\r\n\u001b[?2004l\r"]
[637.112479, "o", "\u001b[?2004h> "]
[637.112777, "o", "    threats = append(threats, detectPortScan(events)...)\r\n\u001b[?2004l\r"]
[637.112832, "o", "\u001b[?2004h> "]
[637.113144, "o", "    threats = append(threats, detectDataExfiltration(events)...)\r\n\u001b[?2004l\r"]
[637.1132, "o", "\u001b[?2004h> "]
[637.113556, "o", "    threats = append(threats, detectPrivilegeEscalation(events)...)\r\n\u001b[?2004l\r"]
[637.113613, "o", "\u001b[?2004h> "]
[637.11394, "o", "    threats = append(threats, detectLateralMovement(events)...)\r\n\u001b[?2004l\r"]
[637.113996, "o", "\u001b[?2004h> "]
[637.114308, "o", "    threats = append(threats, detectDNSTunneling(events)...)\r\n\u001b[?2004l\r"]
[637.114365, "o", "\u001b[?2004h> "]
[637.114494, "o", "    sortThreats(threats)\r\n\u001b[?2004l\r"]
[637.114555, "o", "\u001b[?2004h> "]
[637.114635, "o", "    return threats\r\n\u001b[?2004l\r"]
[637.114691, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[637.114746, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[637.1148, "o", "\u001b[?2004h> "]
[637.114974, "o", "func sortThreats(threats []Threat) {\r\n\u001b[?2004l\r"]
[637.115029, "o", "\u001b[?2004h> "]
[637.115299, "o", "    sort.SliceStable(threats, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[637.115356, "o", "\u001b[?2004h> "]
[637.11568, "o", "        if threats[i].RiskScore != threats[j].RiskScore {\r\n\u001b[?2004l\r"]
[637.115736, "o", "\u001b[?2004h> "]
[637.116051, "o", "            return threats[i].RiskScore > threats[j].RiskScore\r\n\u001b[?2004l\r"]
[637.116108, "o", "\u001b[?2004h> "]
[637.116155, "o", "        }\r\n\u001b[?2004l\r"]
[637.116208, "o", "\u001b[?2004h> "]
[637.116548, "o", "        if !threats[i].firstTime.Equal(threats[j].firstTime) {\r\n\u001b[?2004l\r"]
[637.116604, "o", "\u001b[?2004h> "]
[637.116983, "o", "            return threats[i].firstTime.Before(threats[j].firstTime)\r\n\u001b[?2004l\r"]
[637.117037, "o", "\u001b[?2004h> "]
[637.117093, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.117149, "o", "> "]
[637.117447, "o", "        return threats[i].ThreatType < threats[j].ThreatType\r\n\u001b[?2004l\r"]
[637.117507, "o", "\u001b[?2004h> "]
[637.117563, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> }"]
[637.117618, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[637.117673, "o", "\u001b[?2004h> "]
[637.117934, "o", "func detectBruteForce(events []Event) []Threat {\r\n\u001b[?2004l\r"]
[637.11799, "o", "\u001b[?2004h> "]
[637.118188, "o", "    byIP := make(map[string][]Event)\r\n\u001b[?2004l\r"]
[637.118252, "o", "\u001b[?2004h> "]
[637.118406, "o", "    for _, e := range events {\r\n\u001b[?2004l\r"]
[637.118461, "o", "\u001b[?2004h> "]
[637.118698, "o", "        if e.EventType == \"auth_failure\" {\r\n\u001b[?2004l\r"]
[637.118753, "o", "\u001b[?2004h> "]
[637.119064, "o", "            byIP[e.SourceIP] = append(byIP[e.SourceIP], e)\r\n\u001b[?2004l\r"]
[637.119119, "o", "\u001b[?2004h> "]
[637.119181, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[637.119243, "o", ">     }\r\n\u001b[?2004l\r"]
[637.119299, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[637.119355, "o", "\u001b[?2004h> "]
