[10466.333269, "o", "   144\t\t\t\t\t\tZScore:         json.Number(format4(threatZ)),\r\n   145\t\t\t\t\t},\r\n   146\t\t\t\t},\r\n   147\t\t\t\tCombinedZ:        json.Number(format4(combinedZ)),\r\n   148\t\t\t\tBaselineCount:    baselineCount,\r\n   149\t\t\t\tDirection:        direction,\r\n   150\t\t\t\tSeverity:         severity,\r\n   151\t\t\t\troundedCombinedZ: roundedCombinedZ,\r\n   152\t\t\t})\r\n   153\t\t}\r\n   154\t\r\n   155\t\tsort.SliceStable(anomalies, func(a, b int) bool {\r\n   156\t\t\tif anomalies[a].roundedCombinedZ != anomalies[b].roundedCombinedZ {\r\n   157\t\t"]
[10466.333347, "o", "\t\treturn anomalies[a].roundedCombinedZ > anomalies[b].roundedCombinedZ\r\n   158\t\t\t}\r\n   159\t\t\treturn anomalies[a].Index < anomalies[b].Index\r\n   160\t\t})\r\n   161\t\r\n   162\t\tencoder := json.NewEncoder(os.Stdout)\r\n   163\t\tencoder.SetEscapeHTML(false)\r\n   164\t\tfor _, rec := range anomalies {\r\n   165\t\t\tif err := encoder.Encode(rec); err != nil {\r\n   166\t\t\t\tfmt.Fprintln(os.Stderr, \"error: failed to write anomaly record:\", err)\r\n   167\t\t\t"]
[10466.333429, "o", "\treturn 1\r\n   168\t\t\t}\r\n   169\t\t}\r\n   170\t\r\n   171\t\treturn 0\r\n   172\t}\r\n"]
[10466.333496, "o", "   173\t\r\n   174\tfunc baselineStats(values []float64) (float64, float64) {\r\n   175\t\tn := len(values)\r\n   176\t\tif n == 0 {\r\n   177\t\t\treturn 0, 0\r\n   178\t\t}\r\n   179\t\r\n   180\t\tsum := 0.0\r\n   181\t\tfor _, v := range values {\r\n   182\t\t\tsum += v\r\n   183\t\t}\r\n"]
[10466.333559, "o", "   184\t\tmean := sum / float64(n)\r\n   185\t\r\n   186\t\tsquaredSum := 0.0\r\n   187\t\tfor _, v := range values {\r\n   188\t\t\tdiff := v - mean\r\n   189\t\t\tsquaredSum += diff * diff\r\n   190\t\t}\r\n   191\t\tstddev := math.Sqrt(squaredSum / float64(n))\r\n   192\t\r\n   193\t\treturn mean, stddev\r\n   194\t}\r\n   195\t\r\n   196\tfunc zScore(current, mean, stddev float64) float64 {\r\n   197\t\tif stddev == 0 {\r\n   198"]
[10466.333621, "o", "\t\t\tif current == mean {\r\n   199\t\t\t\treturn 0.0\r\n   200\t\t\t}\r\n   201\t\t\tif current > mean {\r\n   202\t\t\t\treturn 999.0\r\n   203\t\t\t}\r\n   204\t\t\treturn -999.0\r\n   205\t\t}\r\n   206\t\treturn (current - mean) / stddev\r\n"]
[10466.333684, "o", "   207\t}\r\n   208\t\r\n   209\tfunc roundHalfUp4(f float64) float64 {\r\n   210\t\tpow := 10000.0\r\n   211\t\treturn math.Copysign(math.Floor(math.Abs(f)*pow+0.5)/pow, f)\r\n   212\t}\r\n   213\t\r\n   214\tfunc format4(f float64) string {\r\n   215\t\trounded := roundHalfUp4(f)\r\n"]
[10466.333741, "o", "   216\t\tif rounded == 0 {\r\n   217\t\t\treturn \"0.0000\"\r\n   218\t\t}\r\n   219\t\treturn fmt.Sprintf(\"%.4f\", rounded)\r\n   220\t}\r\n   221\t\r\n   222\tfunc formatRiskValue(f float64) string {\r\n   223"]
[10466.333797, "o", "\t\ts := strconv.FormatFloat(f, 'f', -1, 64)\r\n   224\t\tif !strings.Contains(s, \".\") {\r\n   225\t\t\ts += \".0\"\r\n   226\t\t}\r\n   227\t\treturn s\r\n   228\t}\r\n"]
