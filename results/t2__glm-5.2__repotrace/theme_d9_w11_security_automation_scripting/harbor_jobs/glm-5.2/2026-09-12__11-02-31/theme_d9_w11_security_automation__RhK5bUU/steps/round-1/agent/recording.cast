[6062.302159, "o", "    52\t\tcase \"port_scan\":\r\n    53\t\t\treturn json.Marshal(struct {\r\n    54\t\t\t\tThreatType   string  `json:\"threat_type\"`\r\n    55\t\t\t\tSourceIP     string  `json:\"source_ip\"`\r\n    56\t\t\t\tDestIP       string  `json:\"dest_ip\"`\r\n    57\t\t\t\tPortsScanned []int   `json:\"ports_scanned\"`\r\n    58\t\t\t\tFirstSeen    string  `json:\"first_seen\"`\r\n    59\t\t\t\tLastSeen     string  `json:\"last_seen\"`\r\n    60\t\t\t\tRiskScore    float64 `json:\"risk_score\"`\r\n    61\t\t\t}{\r\n"]
[6062.302268, "o", "    62\t\t\t\tThreatType:   t.ThreatType,\r\n    63\t\t\t\tSourceIP:     t.SourceIP,\r\n    64\t\t\t\tDestIP:       t.DestIP,\r\n    65\t\t\t\tPortsScanned: nonNilInts(t.PortsScanned),\r\n    66\t\t\t\tFirstSeen:    t.FirstSeen,\r\n    67\t\t\t\tLastSeen:     t.LastSeen,\r\n    68\t\t\t\tRiskScore:    t.RiskScore,\r\n    69\t\t\t})"]
