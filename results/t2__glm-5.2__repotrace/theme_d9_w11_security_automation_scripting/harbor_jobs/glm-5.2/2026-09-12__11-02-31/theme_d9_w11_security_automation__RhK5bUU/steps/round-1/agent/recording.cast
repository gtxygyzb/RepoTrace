[7699.538621, "o", "\t\tif len(os.Args) < 2 {\r\n    11\t\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate> [flags]\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\r\n    15\t\tvar code int\r\n    16\t\tswitch os.Args[1] {\r\n    17\t\tcase \"analyze\":\r\n    18\t\t\tcode = runAnalyze(os.Args[2:])\r\n    19\t\tcase \"summarize\":\r\n    20\t\t\tcode = runSummarize(os.Args[2:])\r\n    21\t\tcase \"filter\":\r\n    22\t\t\tcode = runFilter(os.Args[2:])\r\n    23\t\tcase \"respond\":\r\n    24\t\t\tcode = runRespond(os.Args[2:])\r\n    25\t\tcase \"enrich\":\r\n    26\t\t\tcode = runEnrich(os.Args[2:])\r\n    27\t\tcase \"correlate\":\r\n    28"]
[7699.538715, "o", "\t\t\tcode = runCorrelate(os.Args[2:])\r\n    29\t\tcase \"timeline\":\r\n    30\t\t\tcode = runTimeline(os.Args[2:])\r\n    31\t\tcase \"snapshot\":\r\n    32\t\t\tcode = runSnapshot(os.Args[2:])\r\n    33\t\tcase \"alert\":\r\n    34\t\t\tcode = runAlert(os.Args[2:])\r\n    35\t\tcase \"aggregate\":\r\n    36\t\t\tcode = runAggregate(os.Args[2:])\r\n    37\t\tdefault:\r\n    38\t\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n    39\t\t\tcode = 1\r\n    40\t"]
[7699.538795, "o", "\t}\r\n    41\t\tos.Exit(code)\r\n    42\t}\r\n    43\t\r\n    44\tfunc newFlagSet(name string) *flag.FlagSet {\r\n    45\t\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n    46\t\tfs.SetOutput(os.Stderr)\r\n    47\t\tfs.Usage = func() {}\r\n    48\t\treturn fs\r\n    49\t}\r\n    50\t\r\n    51\t"]
[7699.538871, "o", "func parseFlags(fs *flag.FlagSet, args []string) bool {\r\n    52\t\tif err := fs.Parse(args); err != nil {\r\n    53\t\t\treturn false\r\n    54\t\t}\r\n    55\t\treturn true\r\n    56\t}\r\n    57\t\r\n    58\tfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n    59\t\tset := false\r\n    60\t\tfs.Visit(func(f *flag.Flag) {\r\n    61\t\t\tif f.Name == name {\r\n    62\t\t\t\tset = true\r\n"]
[7699.538944, "o", "    63\t\t\t}\r\n    64\t\t})\r\n    65\t\treturn set\r\n    66\t}\r\n"]
