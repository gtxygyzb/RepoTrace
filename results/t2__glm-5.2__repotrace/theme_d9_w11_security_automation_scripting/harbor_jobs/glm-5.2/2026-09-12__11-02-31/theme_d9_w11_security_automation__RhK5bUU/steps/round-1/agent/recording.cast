[5570.895593, "o", "   212\tfunc dominantThreatType(threats []map[string]interface{}, counts map[string]int) string {\r\n   213\t\tvar keys []string\r\n   214\t\tfor k := range counts {\r\n   215\t\t\tkeys = append(keys, k)\r\n"]
[5570.895685, "o", "   216\t\t}\r\n   217\t\tsort.Strings(keys)\r\n   218\t\r\n   219\t\tsumRisk := make(map[string]float64)\r\n   220\t\ttypeNum := make(map[string]int)\r\n   221\t\tfor _, threat := range threats {\r\n   222\t\t\ttt, ok := getString(threat, \"threat_type\")\r\n   223\t\t\tif !ok {\r\n   224\t\t\t\tcontinue\r\n   225\t\t\t}\r\n   226\t\t"]
[5570.895766, "o", "\trisk, _ := getFloat(threat, \"enriched_risk_score\")\r\n   227\t\t\tsumRisk[tt] += risk\r\n   228\t\t\ttypeNum[tt]++\r\n   229\t\t}\r\n   230\t\tmeanRisk := make(map[string]float64)\r\n   231\t\tfor k, sum := range sumRisk {\r\n   232\t\t\tif c := typeNum[k]; c > 0 {\r\n   233\t\t\t\tmeanRisk[k] = sum / float64(c)\r\n   234\t\t\t}\r\n   235\t\t}\r\n   236\t\r\n"]
[5570.895833, "o", "   237\t\tdominant := \"\"\r\n   238\t\tmaxCount := -1\r\n   239\t\tmaxMean := 0.0\r\n   240\t\tfor _, k := range keys {\r\n   241\t\t\tc := counts[k]\r\n   242\t\t\tmean := meanRisk[k]\r\n   243\t\t\tif dominant == \"\" || c > maxCount || (c == maxCount && mean > maxMean) {\r\n   244\t\t\t\tmaxCount = c\r\n   245\t\t\t\tmaxMean = mean\r\n   246\t"]
[5570.895891, "o", "\t\t\tdominant = k\r\n   247\t\t\t}\r\n   248\t\t}\r\n   249\t\treturn dominant\r\n   250\t}\r\n   251\t\r\n   252\tfunc timelineSeverityRank(sev string) int {\r\n   253\t\tswitch sev {\r\n   254\t\tcase \"none\":\r\n"]
[5570.895947, "o", "   255\t\t\treturn 0\r\n   256\t\tcase \"low\":\r\n   257\t\t\treturn 1\r\n   258\t\tcase \"medium\":\r\n   259\t\t\treturn 2\r\n   260\t\tcase \"high\":\r\n"]
[5570.89648, "o", "\u001b[?2004h"]
