[7717.199785, "o", "    60\t\t\t\tRiskScore    float64 `json:\"risk_score\"`\r\n    61\t\t\t}{\r\n    62\t\t\t\tThreatType:   t.ThreatType,\r\n    63\t\t\t\tSourceIP:     t.SourceIP,\r\n    64\t\t\t\tDestIP:       t.DestIP,\r\n    65\t\t\t\tPortsScanned: nonNilInts(t.PortsScanned),\r\n    66\t\t\t\tFirstSeen:    t.FirstSeen,\r\n    67\t\t\t\tLastSeen:     t.LastSeen,\r\n    68\t\t\t\tRiskScore:    t.RiskScore,\r\n    69\t\t\t})\r\n    70\t\tcase \"data_exfiltration\":\r\n    71\t\t\treturn json.Marshal(struct {\r\n    72\t\t\t\tThreatType string   `json:\"threat_type\"`\r\n    73\t\t\t\tSourceIP   string   `json:\"source_ip\"`\r\n    74\t\t\t\tTotalBytes int64    `json:\"total_bytes\"`\r\n    75\t\t\t\tFirstSeen  string   `json:\"first_seen\"`\r\n"]
[7717.199855, "o", "    76\t\t\t\tLastSeen   string   `json:\"last_seen\"`\r\n    77\t\t\t\tDestIPs    []string `json:\"dest_ips\"`\r\n    78\t\t\t\tRiskScore  float64  `json:\"risk_score\"`\r\n    79\t\t\t}{\r\n    80\t\t\t\tThreatType: t.ThreatType,\r\n    81\t\t\t\tSourceIP:   t.SourceIP,\r\n    82\t\t\t\tTotalBytes: t.TotalBytes,\r\n    83\t\t\t\tFirstSeen:  t.FirstSeen,\r\n    84\t\t\t\tLastSeen:   t.LastSeen,\r\n    85\t\t\t\tDestIPs:    nonNilStrings(t.DestIPs),\r\n    86"]
