[1875.746302, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"flag\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t)\r\n"]
[1875.746419, "o", "     8\t\r\n     9\tfunc main() {\r\n    10\t\tif len(os.Args) < 2 {\r\n    11\t\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond> [flags]\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\r\n    15\t\tvar code int\r\n    16\t\tswitch os.Args[1] {\r\n    17\t\tcase \"analyze\":\r\n    18\t\t\tcode = runAnalyze(os.Args[2:])\r\n    19\t\tcase \"summarize\":\r\n    20\t\t\tcode = runSummarize(os.Args[2:])\r\n    21\t\tcase \"filter\":\r\n    22\t\t\tcode = runFilter(os.Args[2:])\r\n    23\t\tcase \"respond\":\r\n"]
[1875.746487, "o", "    24\t\t\tcode = runRespond(os.Args[2:])\r\n    25\t\tdefault:\r\n    26\t\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n    27\t\t\tcode = 1\r\n    28\t\t}\r\n    29\t\tos.Exit(code)\r\n    30\t}\r\n    31\t\r\n    32\tfunc newFlagSet(name string) *flag.FlagSet {\r\n    33\t\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n    34\t\tfs.SetOutput(os.Stderr)\r\n    35\t\tfs.Usage = func() {}"]
[1875.746552, "o", "\r\n    36\t\treturn fs\r\n    37\t}\r\n    38\t\r\n    39\tfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n    40\t\tif err := fs.Parse(args); err != nil {\r\n    41\t\t\treturn false\r\n    42\t\t}\r\n    43\t\treturn true\r\n    44\t}\r\n    45\t\r\n    46\tfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n    47\t\t"]
[1875.746611, "o", "set := false\r\n    48\t\tfs.Visit(func(f *flag.Flag) {\r\n    49\t\t\tif f.Name == name {\r\n    50\t\t\t\tset = true\r\n    51\t\t\t}\r\n    52\t\t})\r\n    53\t\treturn set\r\n    54\t}\r\n"]
