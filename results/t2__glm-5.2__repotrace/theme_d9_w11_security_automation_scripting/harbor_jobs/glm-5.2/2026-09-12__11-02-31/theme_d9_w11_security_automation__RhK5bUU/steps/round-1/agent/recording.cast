[7689.862471, "o", "     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"sort\"\r\n     9\t\t\"time\"\r\n    10\t)\r\n    11\t\r\n    12\ttype Event struct {\r\n    13\t\tTimestamp   string            `json:\"timestamp\"`\r\n    14\t\tSourceIP    string            `json:\"source_ip\"`\r\n    15\t\tDestIP      string            `json:\"dest_ip\"`\r\n    16\t\tDestPort    int               `json:\"dest_port\"`\r\n    17\t\tProtocol    string            `json:\"protocol\"`\r\n    18\t\tAction      string            `json:\"action\"`\r\n    19\t\tEventType   string            `json:\"event_type\"`\r\n"]
[7689.862582, "o", "    20\t\tUser        string            `json:\"user\"`\r\n    21\t\tSeverity    string            `json:\"severity\"`\r\n    22\t\tPayloadSize int64             `json:\"payload_size\"`\r\n    23\t\tMetadata    map[string]string `json:\"metadata\"`\r\n    24\t}\r\n    25\t\r\n    26\tvar severityMap = map[string]int{\r\n    27\t\t\"low\":      1,\r\n    28\t\t\"medium\":   2,\r\n"]
[7689.862723, "o", "    29\t\t\"high\":     3,\r\n    30\t\t\"critical\": 4,\r\n    31\t}\r\n    32\t\r\n    33\tfunc severityValue(s string) int {\r\n    34\t\treturn severityMap[s]\r\n    35\t}\r\n    36\t\r\n    37\tfunc parseEvent(line string) (Event, error) {\r\n    38\t\tvar e Event\r\n    39\t\tif err := json.Unmarshal([]byte(line), &e); err != nil {\r\n    40\t\t\treturn e, err\r\n    41\t\t}\r\n    42\t\treturn e, nil\r\n    43\t}\r\n    44\t\r\n    45\tfunc parseTime(ts string) (time.Time, error) {\r\n    46\t\tt, err := time.Parse(time.RFC3339, ts)\r\n    47\t\tif err != nil {\r\n    48\t\t\treturn time.Time{}, fmt.Errorf(\"invalid timestamp %q: %w\", ts, err)\r\n    49\t\t}\r\n    50\t\treturn t, nil\r\n    51\t}\r\n    52\t\r\n    53\tfunc readEvents() ([]Event, error) {\r\n    54\t\tscanner := bufio.NewScanner(os.Stdin)\r\n    55\t\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n"]
[7689.862795, "o", "    56\t\tvar events []Event\r\n    57\t\tlineNo := 0\r\n    58\t\tfor scanner.Scan() {\r\n    59\t\t\tlineNo++\r\n    60\t\t\tline := scanner.Text()\r\n    61\t\t\tif line == \"\" {\r\n    62\t\t\t\tcontinue\r\n    63\t\t\t}\r\n    64\t\t\te, err := parseEvent(line)\r\n    65\t\t\tif err != nil {\r\n    66\t\t\t"]
[7689.862857, "o", "\treturn events, fmt.Errorf(\"line %d: %w\", lineNo, err)\r\n    67\t\t\t}\r\n    68\t\t\tevents = append(events, e)\r\n    69\t\t}\r\n    70\t\tif err := scanner.Err(); err != nil {\r\n    71\t\t\treturn events, err\r\n    72\t\t}\r\n    73\t\treturn events, nil\r\n    74\t}\r\n"]
[7689.862932, "o", "    75\t\r\n    76\tfunc sortEventsByTime(events []Event) {\r\n    77\t\tsort.SliceStable(events, func(i, j int) bool {\r\n    78\t\t\treturn events[i].Timestamp < events[j].Timestamp\r\n    79\t\t})\r\n    80\t}\r\n    81\t\r\n    82\tfunc uniqueSortedStrings(input []string) []string {\r\n    83\t\tseen := make(map[string]bool)\r\n    84\t\tvar out []string\r\n"]
[7689.862994, "o", "    85\t\tfor _, s := range input {\r\n    86\t\t\tif !seen[s] {\r\n    87\t\t\t\tseen[s] = true\r\n    88\t\t\t\tout = append(out, s)\r\n    89\t\t\t}\r\n    90\t\t}\r\n    91\t\tsort.Strings(out)\r\n    92\t\treturn out\r\n"]
[7689.863057, "o", "    93\t}\r\n    94\t\r\n    95\tfunc uniqueSortedInts(input []int) []int {\r\n    96\t\tseen := make(map[int]bool)\r\n    97\t\tvar out []int\r\n    98\t\tfor _, n := range input {\r\n    99\t\t\tif !seen[n] {\r\n   100\t\t\t\tseen[n] = true\r\n   101\t\t\t\tout = append(out, n)\r\n"]
[7689.863125, "o", "   102\t\t\t}\r\n   103\t\t}\r\n   104\t\tsort.Ints(out)\r\n   105\t\treturn out\r\n   106\t}\r\n   107\t\r\n"]
[7689.863188, "o", "   108\tfunc round2(f float64) float64 {\r\n   109\t\treturn float64(int64(f*100+0.5)) / 100\r\n   110\t}\r\n"]
