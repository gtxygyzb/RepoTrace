[10160.788853, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('anomaly.go')\ns = p.read_text()\ns = s.replace('\\trawCombinedZ     float64\\n\\troundedCombinedZ float64\\n}', '\\troundedCombinedZ float64\\n}')\ns = s.replace('func roundHalfUp4(f float64) float64 {\\n\\tpow := 10000.0\\n\\treturn math.Floor(f*pow+0.5) / pow\\n}', 'func roundHalfUp4(f float64) float64 {\\n\\tpow := 10000.0\\n\\treturn math.Copysign(math.Floor(math.Abs(f)*pow+0.5)/pow, f)\\n}')\np.write_text(s)\nPY\n"]
[10160.789113, "o", "python3 - <<'PY'\r\n"]
