[4881.123691, "o", "\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tBucketStart       string                   `json:\"\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[K_start\"`\r\n\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tBucketEnd         string                   `json:\"\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[K_end\"`\r\n"]
[4881.123777, "o", "\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tDominantType      string                   `json:\"\u001b[01;31m\u001b[Kdominant\u001b[m\u001b[K_type\"`\r\n"]
[4881.12384, "o", "\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunTimeline(args []string) int {\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KMinutes := fs.Int(\"\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[K-minutes\", 0, \"width of each time \u001b[01;31m\u001b[Kbucket\u001b[m\u001b[K in minutes\")\r\n"]
[4881.123903, "o", "\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\ttopN := fs.Int(\"top-n\", 3, \"maximum number of top threats to include per \u001b[01;31m\u001b[Kbucket\u001b[m\u001b[K\")\r\n\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif !isFlagSet(fs, \"\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[K-minutes\") {\r\n\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"missing required flag: --\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[K-minutes\")\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif *\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KMinutes <= 0 {\r\n\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"invalid --\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[K-minutes: must be a positive integer\\n\")\r\n"]
[4881.123974, "o", "\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KSeconds := int64(*\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KMinutes) * 60\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[Ks := make(map[int64][]map[string]interface{})\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar \u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KStarts []int64\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t"]
[4881.124041, "o", "start := refUnix - ((refUnix%\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KSeconds)+\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KSeconds)%\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KSeconds\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif _, ok := \u001b[01;31m\u001b[Kbucket\u001b[m\u001b[Ks[start]; !ok {\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KStarts = append(\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KStarts, start)\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[Ks[start] = append(\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[Ks[start], threat)\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tsort.Slice(\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KStarts, func(i, j int) bool { return \u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KStarts[i] < \u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KStarts[j] })\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, start := range \u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KStarts {\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KThreats := \u001b[01;31m\u001b[Kbucket\u001b[m\u001b[Ks[start]\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tendTime := startTime.Add(time.Duration(*\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KMinutes) * time.Minute)\r\n"]
[4881.124105, "o", "\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tb := buildTimelineBucket(\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KThreats, startTime, endTime, *\u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KMinutes, *topN)\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintf(os.Stderr, \"error marshalling \u001b[01;31m\u001b[Kbucket\u001b[m\u001b[K: %v\\n\", err)\r\n\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KbuildTimelineBucket(threats []map[string]interface{}, startTime time.Time, endTime time.Time, \u001b[01;31m\u001b[Kbucket\u001b[m\u001b[KMinutes int, topN int) timelineBucket {\r\n\u001b[32m\u001b[K179\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tb.DominantType = \u001b[01;31m\u001b[Kdominant\u001b[m\u001b[KThreatType(typeCounts)\r\n"]
[4881.124242, "o", "\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K\u001b[01;31m\u001b[Kdominant\u001b[m\u001b[KThreatType(counts map[string]int) string {\r\n\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kdominant\u001b[m\u001b[K := \"\"\r\n\u001b[32m\u001b[K223\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kdominant\u001b[m\u001b[K = k\r\n\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn \u001b[01;31m\u001b[Kdominant\u001b[m\u001b[K\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KtimelineSeverityRank(sev string) int {\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KtimelineEscalationIndex(threats []map[string]interface{}) float64 {\r\n\u001b[32m\u001b[K281\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KtimelineRiskTrend(threats []map[string]interface{}, startTime time.Time) float64 {\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KtimelineBurstScore(threats []map[string]interface{}) float64 {\r\n\u001b[32m\u001b[K338\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KgetStringDefault(m map[string]interface{}, key string) string {\r\n"]
[4881.124303, "o", "\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[Kround3(f float64) float64 {\r\n"]
