[4826.21164, "o", "   214\t\t\t\t\tdirectLinkCount++\r\n   215\t\t\t\t}\r\n   216\t\t\t}\r\n   217\t\t}\r\n   218\t\tc.DirectLinkCount = directLinkCount\r\n   219\t\tif c.ThreatCount > 1 {\r\n   220\t\t\tc.Cohesion = float64(directLinkCount) / (float64(c.ThreatCount*(c.ThreatCount-1)) / 2.0)\r\n   221\t\t} else {\r\n   222\t\t\tc.Cohesion = 0.0\r\n   223\t\t}\r\n   224\t\r\n   225\t\tpropagationScore := 0.0\r\n"]
[4826.211698, "o", "   226\t\tfor ii, i := range indices {\r\n   227\t\t\tfor jj := ii + 1; jj < len(indices); jj++ {\r\n   228\t\t\t\tj := indices[jj]\r\n   229\t\t\t\tif !linked[i][j] {\r\n   230\t\t\t\t\tcontinue\r\n   231\t\t\t\t}\r\n   232\t\t\t\tsharedCount := sharedActorCount(threats[i].actors, threats[j].actors)\r\n   233\t\t\t\tmultiplier := 0.05\r\n   234\t\t\t\tif sharedCount >= 2 {\r\n   235\t\t\t\t\tmultiplier = 0.1\r\n"]
[4826.21176, "o", "   236\t\t\t\t}\r\n   237\t\t\t\tpropagationScore += (threats[i].risk + threats[j].risk) * multiplier\r\n   238\t\t\t}\r\n   239\t\t}\r\n   240\t\tc.PropagationScore = propagationScore\r\n   241\t\r\n   242\t\tmaxSeverity := \"none\"\r\n"]
