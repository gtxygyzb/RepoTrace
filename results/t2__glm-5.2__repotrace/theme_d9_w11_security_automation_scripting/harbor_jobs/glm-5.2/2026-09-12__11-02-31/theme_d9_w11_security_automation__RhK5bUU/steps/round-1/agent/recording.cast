[4815.018472, "i", "sed -n '1,300p' correlate.go\n"]
[4815.018731, "o", "sed -n '1,300p' correlate.go\r\n\u001b[?2004l\r"]
[4815.021705, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"sort\"\r\n"]
[4815.021808, "o", "\t\"time\"\r\n)\r\n\r\ntype correlateThreat struct {\r\n\tobj        map[string]interface{}\r\n\tref        time.Time\r\n\tactors     []string\r\n\trisk       float64\r\n\tthreatType string\r\n\tseverity   string\r\n}\r\n\r\ntype correlateCampaign struct {\r\n\tCampaignID       string                   `json:\"campaign_id\"`\r\n\tThreatCount      int                      `json:\"threat_count\"`\r\n\tThreatTypes      []string                 `json:\"threat_types\"`\r\n\tSharedActors     []string                 `json:\"shared_actors\"`\r\n\tAllActors        []string                 `json:\"all_actors\"`\r\n\tCombinedRisk     float64                  `json:\"combined_risk\"`\r\n\t"]
[4815.021883, "o", "DirectLinkCount  int                      `json:\"direct_link_count\"`\r\n\tCohesion         float64                  `json:\"cohesion\"`\r\n\tPropagationScore float64                  `json:\"propagation_score\"`\r\n\tMaxSeverity      string                   `json:\"max_severity\"`\r\n\tTimeSpanMinutes  float64                  `json:\"time_span_minutes\"`\r\n\tEarliest         string                   `json:\"earliest\"`\r\n\tLatest           string                   `json:\"latest\"`\r\n\tThreats          []map[string]interface{} `json:\"threats\"`\r\n\r\n\tearliestTime  time.Time\r\n\tminThreatType string\r\n}\r\n"]
[4815.021996, "o", "\r\nfunc runCorrelate(args []string) int {\r\n\tfs := newFlagSet(\"correlate\")\r\n\ttimeWindow := fs.Int(\"time-window\", 0, \"maximum temporal distance in minutes for two threats to be linkable\")\r\n\tminCampaignSize := fs.Int(\"min-campaign-size\", 2, \"minimum number of threats in a campaign to output\")\r\n\tif !parseFlags(fs, args) {\r\n\t\treturn 1\r\n\t}\r\n\tif !isFlagSet(fs, \"time-window\") {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --time-window flag is required\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\twindow := time.Duration(*timeWindow) * time.Minute\r\n\r\n\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\tthreats := make([]correlateThreat, 0)\r\n"]
[4815.022063, "o", "\tlineNo := 0\r\n\tfor scanner.Scan() {\r\n\t\tlineNo++\r\n\t\tline := scanner.Text()\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvar obj map[string]interface{}\r\n\t\tif err := json.Unmarshal([]byte(line), &obj); err != nil {\r\n"]
[4815.022129, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tct := correlateThreat{\r\n"]
[4815.022196, "o", "\t\t\tobj: obj,\r\n\t\t\tref: threatReferenceTime(obj),\r\n\t\t}\r\n\t\tif actors, ok := getStringSlice(obj, \"threat_actors\"); ok {\r\n\t\t\tct.actors = actors\r\n\t\t} else {\r\n\t\t\tct.actors = []string{}\r\n\t\t}\r\n\t\tif r, ok := getFloat(obj, \"enriched_risk_score\"); ok {\r\n\t\t\tct.risk = r\r\n\t\t}\r\n\t\tif tt, ok := getString(obj, \"threat_type\"); ok {"]
[4815.022276, "o", "\r\n\t\t\tct.threatType = tt\r\n\t\t}\r\n\t\tif sev, ok := getString(obj, \"ioc_severity\"); ok {\r\n\t\t\tct.severity = sev\r\n\t\t}\r\n\t\tthreats = append(threats, ct)\r\n\t}\r\n\tif err := scanner.Err(); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[4815.022334, "o", "\t\treturn 1\r\n\t}\r\n\r\n\tn := len(threats)\r\n\tlinked := make([][]bool, n)\r\n\tfor i := range linked {\r\n\t\tlinked[i] = make([]bool, n)\r\n\t}\r\n\tfor i := 0; i < n; i++ {\r\n\t\tif len(threats[i].actors) == 0 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfor j := i + 1; j < n; j++ {\r\n\t\t\t"]
[4815.022393, "o", "if len(threats[j].actors) == 0 {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif absDuration(threats[i].ref.Sub(threats[j].ref)) <= window && sharedActorCount(threats[i].actors, threats[j].actors) > 0 {\r\n\t\t\t\tlinked[i][j] = true\r\n\t\t\t\tlinked[j][i] = true\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[4815.02245, "o", "\tvisited := make([]bool, n)\r\n\tvar campaigns []correlateCampaign\r\n\tfor start := 0; start < n; start++ {\r\n\t\tif visited[start] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tqueue := []int{start}\r\n\t"]
[4815.022507, "o", "\tvisited[start] = true\r\n\t\tcomponent := []int{start}\r\n\t\tfor len(queue) > 0 {\r\n\t\t\tcur := queue[0]\r\n\t\t\tqueue = queue[1:]\r\n\t\t\tfor next := 0; next < n; next++ {\r\n\t\t\t\tif !visited[next] && linked[cur][next] {\r\n\t\t\t\t\tvisited[next] = true\r\n"]
[4815.022568, "o", "\t\t\t\t\tqueue = append(queue, next)\r\n\t\t\t\t\tcomponent = append(component, next)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif len(component) < *minCampaignSize {\r\n\t\t\tcontinue\r\n\t"]
[4815.022631, "o", "\t}\r\n\t\tcampaigns = append(campaigns, buildCorrelateCampaign(threats, component, linked))\r\n\t}\r\n\r\n\tsort.SliceStable(campaigns, func(i, j int) bool {\r\n\t\tif !campaigns[i].earliestTime.Equal(campaigns[j].earliestTime) {\r\n\t\t\treturn campaigns[i].earliestTime.Before(campaigns[j].earliestTime)\r\n\t\t}\r\n\t\treturn campaigns[i].minThreatType < campaigns[j].minThreatType\r\n\t})\r\n\t"]
[4815.022693, "o", "for i := range campaigns {\r\n\t\tcampaigns[i].CampaignID = fmt.Sprintf(\"CAMP-%03d\", i+1)\r\n\t}\r\n\r\n\tsort.SliceStable(campaigns, func(i, j int) bool {\r\n\t\tif campaigns[i].CombinedRisk != campaigns[j].CombinedRisk {\r\n\t\t\treturn campaigns[i].CombinedRisk > campaigns[j].CombinedRisk\r\n\t\t}\r\n\t\tif campaigns[i].Cohesion != campaigns[j].Cohesion {\r\n\t"]
[4815.022754, "o", "\t\treturn campaigns[i].Cohesion > campaigns[j].Cohesion\r\n\t\t}\r\n\t\treturn campaigns[i].CampaignID < campaigns[j].CampaignID\r\n\t})\r\n\r\n\tw := bufio.NewWriter(os.Stdout)\r\n\tdefer w.Flush()\r\n\tenc := json.NewEncoder(w)\r\n"]
[4815.022809, "o", "\tfor _, c := range campaigns {\r\n\t\tif err := enc.Encode(c); err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\treturn 1\r\n\t\t}\r\n\t}\r\n\treturn 0\r\n}\r\n\r\n"]
[4815.022866, "o", "func buildCorrelateCampaign(threats []correlateThreat, indices []int, linked [][]bool) correlateCampaign {\r\n\tc := correlateCampaign{\r\n\t\tThreatCount:  len(indices),\r\n\t\tThreatTypes:  []string{},\r\n\t\tSharedActors: []string{},\r\n\t\tAllActors:    []string{},\r\n\t\tThreats:      []map[string]interface{}{},\r\n\t}\r\n\r\n\ttypeSet := make(map[string]bool)\r\n\tactorSet := make(map[string]bool)\r\n"]
[4815.02293, "o", "\tfor _, idx := range indices {\r\n\t\ttypeSet[threats[idx].threatType] = true\r\n\t\tfor _, actor := range threats[idx].actors {\r\n\t\t\tactorSet[actor] = true\r\n\t\t}\r\n\t}\r\n\tc.ThreatTypes = sortedKeys(typeSet)\r\n\tc.AllActors = sortedUniqueStringsFromSet(actorSet)\r\n\r\n\tif len(indices) > 0 {\r\n\t\tshared := make(map[string]bool)\r\n\t\t"]
[4815.022994, "o", "for _, actor := range threats[indices[0]].actors {\r\n\t\t\tshared[actor] = true\r\n\t\t}\r\n\t\tfor _, idx := range indices[1:] {\r\n\t\t\tnext := make(map[string]bool)\r\n\t\t\tfor _, actor := range threats[idx].actors {\r\n\t\t\t\tif shared[actor] {\r\n\t\t\t\t\tnext[actor] = true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t"]
[4815.023056, "o", "\tshared = next\r\n\t\t}\r\n\t\tc.SharedActors = sortedUniqueStringsFromSet(shared)\r\n\t}\r\n\r\n\tdirectLinkCount := 0\r\n\tfor ii, i := range indices {\r\n\t\tfor jj := ii + 1; jj < len(indices); jj++ {\r\n\t\t\tif linked[i][indices[jj]] {\r\n"]
[4815.023112, "o", "\t\t\t\tdirectLinkCount++\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tc.DirectLinkCount = directLinkCount\r\n\tif c.ThreatCount > 1 {\r\n\t\tc.Cohesion = float64(directLinkCount) / (float64(c.ThreatCount*(c.ThreatCount-1)) / 2.0)\r\n\t} else {\r\n\t\tc.Cohesion = 0.0\r\n\t}\r\n\r\n"]
[4815.023168, "o", "\tpropagationScore := 0.0\r\n\tfor ii, i := range indices {\r\n\t\tfor jj := ii + 1; jj < len(indices); jj++ {\r\n\t\t\tj := indices[jj]\r\n\t\t\tif !linked[i][j] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tsharedCount := sharedActorCount(threats[i].actors, threats[j].actors)\r\n\t"]
[4815.023246, "o", "\t\tmultiplier := 0.05\r\n\t\t\tif sharedCount >= 2 {\r\n\t\t\t\tmultiplier = 0.1\r\n\t\t\t}\r\n\t\t\tpropagationScore += (threats[i].risk + threats[j].risk) * multiplier\r\n\t\t}\r\n\t}\r\n\tc.PropagationScore = propagationScore\r\n\r\n\tmaxSeverity := \"none\"\r\n\tfor _, idx := range indices {\r\n\t"]
[4815.023305, "o", "\tif correlateSeverityRank(threats[idx].severity) > correlateSeverityRank(maxSeverity) {\r\n\t\t\tmaxSeverity = threats[idx].severity\r\n\t\t}\r\n\t}\r\n\tc.MaxSeverity = maxSeverity\r\n\r\n\tearliest := threats[indices[0]].ref\r\n\tlatest := earliest\r\n\tfor _, idx := range indices[1:] {\r\n\t\tif threats[idx].ref.Before(earliest) {\r\n"]
[4815.023365, "o", "\t\t\tearliest = threats[idx].ref\r\n\t\t}\r\n\t\tif threats[idx].ref.After(latest) {\r\n\t\t\tlatest = threats[idx].ref\r\n\t\t}\r\n\t}\r\n\tc.earliestTime = earliest\r\n\tc.Earliest = earliest.Format(time.RFC3339)\r\n"]
[4815.023424, "o", "\tc.Latest = latest.Format(time.RFC3339)\r\n\tc.TimeSpanMinutes = latest.Sub(earliest).Seconds() / 60.0\r\n\r\n\tcombinedRisk := 0.0\r\n\tminThreatType := \"\"\r\n\tfor _, idx := range indices {\r\n\t\tcombinedRisk += threats[idx].risk\r\n\t\ttt := threats[idx].threatType\r\n\t\tif minThreatType == \"\" || tt < minThreatType {\r\n\t\t\tminThreatType = tt\r\n"]
[4815.023464, "o", "\t\t}\r\n\t}\r\n\tc.CombinedRisk = combinedRisk\r\n\tc.minThreatType = minThreatType\r\n\r\n\tsortedIndices := make([]int, len(indices))\r\n\tcopy(sortedIndices, indices)\r\n"]
[4815.023545, "o", "\tsort.SliceStable(sortedIndices, func(a, b int) bool {\r\n\t\tta := threats[sortedIndices[a]]\r\n\t\ttb := threats[sortedIndices[b]]\r\n\t\tif ta.risk != tb.risk {\r\n\t\t\treturn ta.risk > tb.risk\r\n\t\t}\r\n\t\tif !ta.ref.Equal(tb.ref) {\r\n\t\t\treturn ta.ref.Before(tb.ref)\r\n\t\t}\r\n\t\treturn ta.threatType < tb.threatType\r\n\t})\r\n\tc.Threats = make([]map[string]interface{}, 0, len(sortedIndices))\r\n"]
[4815.023607, "o", "\tfor _, idx := range sortedIndices {\r\n\t\tc.Threats = append(c.Threats, threats[idx].obj)\r\n\t}\r\n\r\n\treturn c\r\n}\r\n\r\nfunc sharedActorCount(a, b []string) int {\r\n\tset := make(map[string]bool)\r\n\tfor _, s := range a {\r\n"]
