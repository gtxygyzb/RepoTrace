[8590.679491, "o", "\u001b[35m\u001b[Kprioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\trecency := math.Pow(2, -\u001b[01;31m\u001b[KageMinutes/30.0\u001b[m\u001b[K)\r\n"]
[8590.679656, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K11\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|\u001b[01;31m\u001b[Ktrack|diff\u001b[m\u001b[K> [flags]\")\r\n"]
[8590.679758, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"track\"\u001b[m\u001b[K:\r\n"]
[8590.680346, "o", "\u001b[?2004h"]
[8590.680404, "o", "root@n30009:/app# "]
[8590.956717, "i", "sed -n '1,220p' track.go\n"]
[8590.956957, "o", "sed -n '1,220p' track.go\r\n\u001b[?2004l\r"]
[8590.959816, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[8590.959855, "o", "\t\"sort\"\r\n)\r\n\r\ntype trackGroup struct {\r\n\tSourceIP        string\r\n\tEventCount      int\r\n\tMaxEnrichedRisk float64\r\n"]
[8590.959966, "o", "\tThreatTypes     []string\r\n\tThreatActors    []string\r\n\tFirstActivity   string\r\n\tLastActivity    string\r\n}\r\n\r\ntype trackOutput struct {\r\n\tSourceIP        string   `json:\"source_ip\"`\r\n\tEventCount      int      `json:\"event_count\"`\r\n\tMaxEnrichedRisk float64  `json:\"max_enriched_risk\"`\r\n\tThreatTypes     []string `json:\"threat_types\"`\r\n\tThreatActors    []string `json:\"threat_actors\"`\r\n\tFirstActivity   string   `json:\"first_activity\"`\r\n\tLastActivity    string   `json:\"last_activity\"`\r\n\tThreatLevel     string   `json:\"threat_level\"`\r\n}\r\n\r\nfunc runTrack(args []string) int {\r\n\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\r\n"]
[8590.960039, "o", "\tgroups := make(map[string]*trackGroup)\r\n\tlineNo := 0\r\n\r\n\tfor scanner.Scan() {\r\n\t\tlineNo++\r\n\t\tline := scanner.Text()\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tvar ev map[string]interface{}\r\n\t\tif err := json.Unmarshal([]byte(line), &ev); err != nil {\r\n"]
[8590.960103, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"line %d: invalid JSON: %v\\n\", lineNo, err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\r\n\t\tsourceIP := trackGetString(ev, \"source_ip\", \"\")\r\n\t\tg, ok := groups[sourceIP]\r\n\t\tif !ok {\r\n\t\t\tg = &trackGroup{\r\n\t\t\t\tSourceIP:        sourceIP,\r\n\t\t\t\tMaxEnrichedRisk: -1,\r\n"]
[8590.960164, "o", "\t\t\t\tThreatTypes:     []string{},\r\n\t\t\t\tThreatActors:    []string{},\r\n\t\t\t}\r\n\t\t\tgroups[sourceIP] = g\r\n\t\t}\r\n\r\n\t\tg.EventCount++\r\n\r\n\t\tif risk, ok := trackGetFloat(ev, \"enriched_risk_score\"); ok && risk > g.MaxEnrichedRisk {\r\n\t\t\tg.MaxEnrichedRisk = risk\r\n"]
[8590.960256, "o", "\t\t}\r\n\r\n\t\tif threatType, ok := trackGetStringOk(ev, \"threat_type\"); ok {\r\n\t\t\tg.ThreatTypes = append(g.ThreatTypes, threatType)\r\n\t\t}\r\n\r\n\t\tif actors, ok := trackGetStringSlice(ev, \"threat_actors\"); ok {\r\n\t\t\tg.ThreatActors = append(g.ThreatActors, actors...)\r\n\t\t}\r\n\r\n\t\tfirstSeen := trackGetString(ev, \"first_seen\", \"\")\r\n\t\tif g.FirstActivity == \"\" || firstSeen < g.FirstActivity {\r\n"]
[8590.960321, "o", "\t\t\tg.FirstActivity = firstSeen\r\n\t\t}\r\n\r\n\t\tlastSeen := trackGetString(ev, \"last_seen\", \"\")\r\n\t\tif lastSeen > g.LastActivity {\r\n\t\t\tg.LastActivity = lastSeen\r\n\t\t}\r\n\t}\r\n\r\n\tif err := scanner.Err(); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n\t\treturn 2\r\n"]
[8590.960378, "o", "\t}\r\n\r\n\toutputs := make([]trackOutput, 0, len(groups))\r\n\tfor _, g := range groups {\r\n\t\tif g.MaxEnrichedRisk < 0 {\r\n\t\t\tg.MaxEnrichedRisk = 0\r\n\t\t}\r\n\t\toutputs = append(outputs, trackOutput{\r\n\t\t\tSourceIP:        g.SourceIP,\r\n"]
[8590.960437, "o", "\t\t\tEventCount:      g.EventCount,\r\n\t\t\tMaxEnrichedRisk: g.MaxEnrichedRisk,\r\n\t\t\tThreatTypes:     ensureStringSlice(uniqueSortedStrings(g.ThreatTypes)),\r\n\t\t\tThreatActors:    ensureStringSlice(uniqueSortedStrings(g.ThreatActors)),\r\n\t\t\tFirstActivity:   g.FirstActivity,\r\n\t\t\tLastActivity:    g.LastActivity,\r\n\t\t\tThreatLevel:     trackThreatLevel(g.EventCount, g.MaxEnrichedRisk),\r\n\t\t})\r\n\t}\r\n"]
[8590.960496, "o", "\r\n\tsort.SliceStable(outputs, func(i, j int) bool {\r\n\t\tif outputs[i].MaxEnrichedRisk != outputs[j].MaxEnrichedRisk {\r\n\t\t\treturn outputs[i].MaxEnrichedRisk > outputs[j].MaxEnrichedRisk\r\n\t\t}\r\n\t\treturn outputs[i].SourceIP < outputs[j].SourceIP\r\n\t})\r\n\r\n\tfor _, out := range outputs {\r\n\t\tb, err := json.Marshal(out)\r\n\t\tif err != nil {"]
[8590.960553, "o", "\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error encoding output: %v\\n\", err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tfmt.Println(string(b))\r\n\t}\r\n\r\n\treturn 0\r\n}\r\n\r\n"]
[8590.960614, "o", "func trackThreatLevel(eventCount int, maxRisk float64) string {\r\n\tif eventCount >= 5 || maxRisk >= 500.0 {\r\n\t\treturn \"critical\"\r\n\t}\r\n\tif eventCount >= 3 || maxRisk >= 300.0 {\r\n\t\treturn \"high\"\r\n\t}\r\n\tif eventCount >= 2 || maxRisk >= 150.0 {\r\n\t\treturn \"medium\"\r\n\t}\r\n\treturn \"low\"\r\n}\r\n"]
[8590.960676, "o", "\r\nfunc ensureStringSlice(s []string) []string {\r\n\tif s == nil {\r\n\t\treturn []string{}\r\n\t}\r\n\treturn s\r\n}\r\n\r\nfunc trackGetString(ev map[string]interface{}, key, fallback string) string {\r\n\tif v, ok := ev[key].(string); ok {\r\n\t\treturn v\r\n\t}\r\n\treturn fallback\r\n"]
[8590.960741, "o", "}\r\n\r\nfunc trackGetStringOk(ev map[string]interface{}, key string) (string, bool) {\r\n\tv, ok := ev[key].(string)\r\n\treturn v, ok\r\n}\r\n"]
[8590.9608, "o", "\r\nfunc trackGetFloat(ev map[string]interface{}, key string) (float64, bool) {\r\n\tswitch v := ev[key].(type) {\r\n\tcase float64:\r\n\t\treturn v, true\r\n\tcase int:\r\n\t\treturn float64(v), true\r\n\tcase int64:\r\n\t\treturn float64(v), true\r\n\t}\r\n\treturn 0, false\r\n}\r\n\r\nfunc trackGetStringSlice(ev map[string]interface{}, key string) ([]string, bool) {\r\n\tarr, ok := ev[key].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, false\r\n"]
[8590.96086, "o", "\t}\r\n\tout := make([]string, 0, len(arr))\r\n\tfor _, item := range arr {\r\n\t\tif s, ok := item.(string); ok {\r\n\t\t\tout = append(out, s)\r\n\t\t}\r\n\t}\r\n\treturn out, true\r\n}\r\n"]
