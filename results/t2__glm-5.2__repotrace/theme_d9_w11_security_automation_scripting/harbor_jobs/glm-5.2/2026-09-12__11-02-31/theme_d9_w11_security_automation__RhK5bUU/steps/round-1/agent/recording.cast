[951.739036, "o", "func substituteTemplate(tmpl string, t ThreatInput) string {\r\n\u001b[?2004l\r"]
[951.739095, "o", "\u001b[?2004h> "]
[951.739189, "o", "    replace := func(key, value string) {\r\n\u001b[?2004l\r"]
[951.739257, "o", "\u001b[?2004h> "]
[951.739383, "o", "        tmpl = strings.ReplaceAll(tmpl, key, value)\r\n\u001b[?2004l\r"]
[951.739437, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[951.739496, "o", "\u001b[?2004h> "]
[951.739587, "o", "    replace(\"{source_ip}\", t.SourceIP)\r\n\u001b[?2004l\r"]
[951.739645, "o", "\u001b[?2004h> "]
[951.739742, "o", "    replace(\"{dest_ip}\", orNA(t.DestIP))\r\n\u001b[?2004l\r"]
[951.739803, "o", "\u001b[?2004h> "]
[951.739882, "o", "    replace(\"{user}\", orNA(t.User))\r\n\u001b[?2004l\r"]
[951.739941, "o", "\u001b[?2004h> "]
[951.740051, "o", "    replace(\"{timestamp}\", orNA(t.Timestamp))\r\n\u001b[?2004l\r"]
[951.74011, "o", "\u001b[?2004h> "]
[951.740287, "o", "    if t.raw[\"ports_scanned\"] != nil && len(t.PortsScanned) > 0 {\r\n\u001b[?2004l\r"]
[951.740344, "o", "\u001b[?2004h> "]
[951.740476, "o", "        replace(\"{ports}\", joinInts(t.PortsScanned))\r\n\u001b[?2004l\r"]
[951.740532, "o", "\u001b[?2004h>     } else {\r\n\u001b[?2004l\r"]
[951.740586, "o", "\u001b[?2004h> "]
[951.740682, "o", "        replace(\"{ports}\", \"N/A\")\r\n\u001b[?2004l\r"]
[951.740743, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[951.740803, "o", ">     return tmpl\r\n\u001b[?2004l\r"]
[951.740832, "o", "\u001b[?2004h> }\r\n"]
[951.740931, "o", "\u001b[?2004l\r\u001b[?2004h"]
[951.740989, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> func orNA(s string) string {\r\n\u001b[?2004l\r"]
[951.741046, "o", "\u001b[?2004h> "]
[951.74111, "o", "    if s == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[951.741183, "o", "        return \"N/A\"\r\n\u001b[?2004l\r"]
[951.741257, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[951.741313, "o", "    return s\r\n\u001b[?2004l\r"]
[951.741368, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[951.741422, "o", "\u001b[?2004h> "]
[951.741604, "o", "func stringValue(m map[string]interface{}, key string) string {\r\n\u001b[?2004l\r"]
[951.741672, "o", "\u001b[?2004h> "]
[951.74174, "o", "    if v, ok := m[key]; ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[951.741868, "o", "        if s, ok := v.(string); ok {\r\n\u001b[?2004l\r"]
[951.741926, "o", "\u001b[?2004h> "]
[951.74198, "o", "            return s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[951.742042, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[951.742098, "o", "> "]
[951.742151, "o", "        return fmt.Sprint(v)\r\n\u001b[?2004l\r"]
[951.742178, "o", "\u001b[?2004h>     }"]
[951.742198, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[951.742237, "o", "> "]
[951.742282, "o", "    return \"\"\r\n\u001b[?2004l\r"]
[951.742303, "o", "\u001b[?2004h> }"]
[951.742323, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[951.742343, "o", "> \r\n\u001b[?2004l\r"]
[951.742393, "o", "\u001b[?2004h> "]
[951.742579, "o", "func floatValue(m map[string]interface{}, key string) float64 {\r\n\u001b[?2004l\r"]
[951.742598, "o", "\u001b[?2004h> "]
[951.742696, "o", "    if v, ok := m[key]; ok {\r\n\u001b[?2004l\r"]
[951.742715, "o", "\u001b[?2004h> "]
[951.742822, "o", "        switch n := v.(type) {\r\n\u001b[?2004l\r"]
[951.742842, "o", "\u001b[?2004h> "]
[951.74292, "o", "        case float64:\r\n\u001b[?2004l\r"]
[951.74294, "o", "\u001b[?2004h> "]
[951.743015, "o", "            return n\r\n\u001b[?2004l\r"]
[951.743034, "o", "\u001b[?2004h> "]
[951.796053, "o", "        case int64:\r\n\u001b[?2004l\r\u001b[?2004h>             return float64(n)\r\n\u001b[?2004l\r\u001b[?2004h>         case int:\r\n\u001b[?2004l\r\u001b[?2004h>             return float64(n)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return 0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func intSliceValue(m map[string]interface{}, key string) []int {\r\n\u001b[?2004l\r\u001b[?2004h>     v, ok := m[key]\r\n\u001b[?2004l\r\u001b[?2004h>     if !ok || v == nil {\r\n\u001b[?2004l\r\u001b[?2004h>         return nil\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     arr, ok := v.([]interface{})\r\n\u001b[?2004l\r\u001b[?2004h>     if !ok {\r\n\u001b[?2004l\r\u001b[?2004h>         return nil\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     out := make([]int, 0, len(arr))\r\n\u001b[?2004l\r\u001b[?2004h>     for _, item := range arr {\r\n\u001b[?2004l\r\u001b[?2004h>         switch n := item.(type) {\r\n\u001b[?2004l\r\u001b[?2004h>         case float64:\r\n\u001b[?2004l\r\u001b[?2004h>             out = append(out, int(n))\r\n\u001b[?2004l\r\u001b[?2004h>         case int64:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[951.796131, "o", "            out = append(out, int(n))\r\n\u001b[?2004l\r"]
[951.796188, "o", "\u001b[?2004h> "]
[951.79629, "o", "        case int:\r\n\u001b[?2004l\r"]
[951.796347, "o", "\u001b[?2004h> "]
[951.796531, "o", "            out = append(out, n)\r\n\u001b[?2004l\r"]
[951.796588, "o", "\u001b[?2004h> "]
[951.796645, "o", "        }\r\n\u001b[?2004l\r"]
[951.7967, "o", "\u001b[?2004h> "]
[951.796754, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[951.796808, "o", "> "]
[951.796876, "o", "    return out\r\n\u001b[?2004l\r"]
[951.796931, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[951.79698, "o", "\u001b[?2004h"]
[951.797034, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[951.797088, "o", "> "]
[951.797295, "o", "func joinInts(vals []int) string {\r\n\u001b[?2004l\r"]
[951.797351, "o", "\u001b[?2004h"]
[951.797405, "o", "> "]
[951.797587, "o", "    strs := make([]string, len(vals))\r\n\u001b[?2004l\r"]
[951.797644, "o", "\u001b[?2004h> "]
[951.797811, "o", "    for i, v := range vals {\r\n\u001b[?2004l\r"]
[951.797867, "o", "\u001b[?2004h> "]
[951.798093, "o", "        strs[i] = fmt.Sprintf(\"%d\", v)\r\n\u001b[?2004l\r"]
[951.79815, "o", "\u001b[?2004h> "]
[951.798206, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[951.79827, "o", "> "]
[951.798451, "o", "    return strings.Join(strs, \",\")\r\n\u001b[?2004l\r"]
[951.798507, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[951.798563, "o", "\u001b[?2004h> "]
[951.798623, "o", "EOF\r\n\u001b[?2004l\r"]
[951.801483, "o", "\u001b[?2004h"]
[951.801548, "o", "root@n30009:/app# "]
[951.965592, "i", "cat > main.go <<'EOF'\npackage main\n\nimport (\n    \"flag\"\n    \"fmt\"\n    \"os\"\n)\n\nfunc main() {\n    if len(os.Args) < 2 {\n        fmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond> [flags]\")\n        os.Exit(1)\n    }\n\n    var code int\n    switch os.Args[1] {\n    case \"analyze\":\n        code = runAnalyze(os.Args[2:])\n    case \"summarize\":\n        code = runSummarize(os.Args[2:])\n    case \"filter\":\n        code = runFilter(os.Args[2:])\n    case \"respond\":\n        code = runRespond(os.Args[2:])\n    default:\n        fmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\n        code = 1\n    }\n    os.Exit(code)\n}\n\nfunc newFlagSet(name string) *flag.FlagSet {\n    fs := flag.NewFlagSet(name, flag.ContinueOnError)\n    fs.SetOutput(os.Stderr)\n    fs.Usage = func() {}\n    return fs\n}\n\nfunc parseFlags(fs *flag.FlagSet, args []string) bool {\n    if err := fs.Parse(args); err != nil {\n        return false\n    }\n    return true\n}\n\nfunc isFlagSet(fs *flag.FlagSet, name string) bool {\n    set :"]
[951.965792, "i", "= false\n    fs.Visit(func(f *flag.Flag) {\n        if f.Name == name {\n            set = true\n        }\n    })\n    return set\n}\nEOF\n"]
[951.965865, "o", "cat > main.go <<'EOF'\r\n\u001b[?2004l\r"]
[951.965936, "o", "\u001b[?2004h> "]
