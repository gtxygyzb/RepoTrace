[8856.203876, "o", "package main\r\n\r\nimport (\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n"]
[8856.203986, "o", "\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|track|diff> [flags]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar code int\r\n\tswitch os.Args[1] {\r\n"]
[8856.204085, "o", "\tcase \"prioritize\":\r\n\t\tcode = runPrioritize(os.Args[2:])\r\n\tcase \"analyze\":\r\n\t\tcode = runAnalyze(os.Args[2:])\r\n\tcase \"summarize\":\r\n\t\tcode = runSummarize(os.Args[2:])\r\n\tcase \"filter\":\r\n\t\tcode = runFilter(os.Args[2:])\r\n\tcase \"respond\":\r\n\t\tcode = runRespond(os.Args[2:])\r\n\tcase \"enrich\":\r\n\t\tcode = runEnrich(os.Args[2:])\r\n\tcase \"correlate\":\r\n\t\tcode = runCorrelate(os.Args[2:])\r\n\tcase \"timeline\":\r\n\t\tcode = runTimeline(os.Args[2:])\r\n\tcase \"snapshot\":\r\n\t\tcode = runSnapshot(os.Args[2:])\r\n\tcase \"alert\":\r\n\t\tcode = runAlert(os.Args[2:])\r\n\tcase \"aggregate\":\r\n\t\tcode = runAggregate(os.Args[2:])\r\n\tcase \"diff\":\r\n\t\tcode = runDiff(os.Args[2:])\r\n\tcase \"track\":\r\n\t\tcode = runTrack(os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n"]
[8856.204186, "o", "\t\tcode = 1\r\n\t}\r\n\tos.Exit(code)\r\n}\r\n\r\nfunc newFlagSet(name string) *flag.FlagSet {\r\n\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tfs.Usage = func() {}\r\n\treturn fs\r\n}\r\n\r\nfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn false\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n\tset := false\r\n"]
[8856.204292, "o", "\tfs.Visit(func(f *flag.Flag) {\r\n\t\tif f.Name == name {\r\n\t\t\tset = true\r\n\t\t}\r\n\t})\r\n\treturn set\r\n}\r\n"]
[8856.204764, "o", "\u001b[?2004h"]
[8856.204871, "o", "root@n30009:/app# "]
[8856.439868, "i", "sed -n '1,260p' aggregate.go\n"]
[8856.440145, "o", "sed -n '1,260p' aggregate.go\r\n\u001b[?2004l\r"]
[8856.442997, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n"]
[8856.443125, "o", "\t\"os\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n)\r\n\r\ntype aggregateSnapshot struct {\r\n\tTotalThreats       int            `json:\"total_threats\"`\r\n\tActiveCampaigns    int            `json:\"active_campaigns\"`\r\n\tMeanEnrichedRisk   float64        `json:\"mean_enriched_risk\"`\r\n\tDominantThreatType string         `json:\"dominant_threat_type\"`\r\n\tActorThreatCounts  map[string]int `json:\"actor_threat_counts\"`\r\n}\r\n\r\ntype aggregateReport struct {\r\n\tSnapshotCount       int            `json:\"snapshot_count\"`\r\n\tTotalThreats        int            `json:\"total_threats\"`\r\n\tTotalCampaigns      int            `json:\"total_campaigns\"`\r\n\tGlobalMeanRisk      float64        `json:\"global_mean_risk\"`\r\n\tGlobalMaxMeanRisk   float64        `json:\"global_max_mean_risk\"`\r\n\tGlobalRiskCategory  string         `json:\"global_risk_category\"`\r\n\tCombinedActorCounts map[string]int `json:\"combined_actor_counts\"`\r\n"]
[8856.443244, "o", "\tTopActor            string         `json:\"top_actor\"`\r\n\tDominantThreatType  string         `json:\"dominant_threat_type\"`\r\n\tTypeCounts          map[string]int `json:\"type_counts\"`\r\n}\r\n\r\nfunc runAggregate(args []string) int {\r\n\treport := aggregateReport{\r\n\t\tCombinedActorCounts: map[string]int{},\r\n\t\tTypeCounts:          map[string]int{},\r\n\t}\r\n\r\n\treader := bufio.NewReader(os.Stdin)\r\n\tweightedRiskSum := 0.0\r\n\tmaxMeanRisk := 0.0\r\n\tdominantTypeCounts := map[string]int{}\r\n\tactorCounts := map[string]int{}\r\n\tsnapshotCount := 0\r\n\r\n"]
[8856.44334, "o", "\tfor {\r\n\t\tline, err := reader.ReadString('\\n')\r\n\t\ttrimmed := strings.TrimSpace(line)\r\n\t\tif trimmed == \"\" {\r\n\t\t\tif err == io.EOF {\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tvar snap aggregateSnapshot\r\n\t\tif jerr := json.Unmarshal([]byte(trimmed), &snap); jerr != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"error: malformed JSON input:\", jerr)\r\n\t\t\treturn 2\r\n\t\t}\r\n"]
[8856.443429, "o", "\r\n\t\tsnapshotCount++\r\n\t\treport.TotalThreats += snap.TotalThreats\r\n\t\treport.TotalCampaigns += snap.ActiveCampaigns\r\n\t\tweightedRiskSum += snap.MeanEnrichedRisk * float64(snap.TotalThreats)\r\n\t\tif snap.MeanEnrichedRisk > maxMeanRisk {\r\n\t\t\tmaxMeanRisk = snap.MeanEnrichedRisk\r\n\t\t}\r\n\t\tfor actor, count := range snap.ActorThreatCounts {\r\n\t\t\tactorCounts[actor] += count\r\n\t\t}\r\n\t\tdominantType := snap.DominantThreatType\r\n"]
[8856.443506, "o", "\t\tdominantTypeCounts[dominantType]++\r\n\t\treport.TypeCounts[dominantType] += snap.TotalThreats\r\n\r\n\t\tif err == io.EOF {\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n\treport.SnapshotCount = snapshotCount\r\n\tif report.TotalThreats > 0 {\r\n\t\treport.GlobalMeanRisk = round2(weightedRiskSum / float64(report.TotalThreats))\r\n\t} else {\r\n\t\treport.GlobalMeanRisk = 0.0\r\n"]
[8856.443576, "o", "\t}\r\n\treport.GlobalMaxMeanRisk = round2(maxMeanRisk)\r\n\treport.GlobalRiskCategory = snapshotRiskCategory(report.GlobalMeanRisk)\r\n\treport.CombinedActorCounts = actorCounts\r\n\treport.TopActor = topActorFromCounts(actorCounts)\r\n\treport.DominantThreatType = topDominantType(dominantTypeCounts)\r\n\r\n\tif report.CombinedActorCounts == nil {\r\n\t\treport.CombinedActorCounts = map[string]int{}\r\n\t}\r\n\tif report.TypeCounts == nil {\r\n"]
[8856.443653, "o", "\t\treport.TypeCounts = map[string]int{}\r\n\t}\r\n\r\n\tout, err := json.Marshal(report)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: encoding aggregate report:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tfmt.Println(string(out))\r\n\treturn 0\r\n}\r\n\r\nfunc topActorFromCounts(counts map[string]int) string {\r\n"]
[8856.443733, "o", "\tactors := make([]string, 0, len(counts))\r\n\tfor actor := range counts {\r\n\t\tactors = append(actors, actor)\r\n\t}\r\n\tsort.Strings(actors)\r\n\r\n\ttopActor := \"\"\r\n\tmaxCount := -1\r\n\tfor _, actor := range actors {\r\n\t\tcount := counts[actor]\r\n\t\tif count > maxCount {\r\n\t\t\tmaxCount = count\r\n\t\t\ttopActor = actor\r\n\t\t}\r\n\t}\r\n"]
[8856.443799, "o", "\tif maxCount < 0 {\r\n\t\treturn \"\"\r\n\t}\r\n\treturn topActor\r\n}\r\n\r\nfunc topDominantType(counts map[string]int) string {\r\n\ttypes := make([]string, 0, len(counts))\r\n\tfor t := range counts {\r\n\t\ttypes = append(types, t)\r\n\t}\r\n\tsort.Strings(types)\r\n"]
[8856.443871, "o", "\r\n\ttopType := \"\"\r\n\tmaxCount := -1\r\n\tfor _, t := range types {\r\n\t\tcount := counts[t]\r\n\t\tif count > maxCount {\r\n\t\t\tmaxCount = count\r\n\t\t\ttopType = t\r\n\t\t}\r\n\t}\r\n\tif maxCount < 0 {\r\n\t\treturn \"\"\r\n"]
[8856.443938, "o", "\t}\r\n\treturn topType\r\n}\r\n"]
