[2853.383651, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n"]
[2853.383759, "o", "     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"net\"\r\n     8\t\t\"os\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"time\"\r\n    12\t)\r\n    13\t\r\n    14\ttype iocEntry struct {\r\n    15\t\tID            string   `json:\"id\"`\r\n    16\t\tIndicator     string   `json:\"indicator\"`\r\n    17\t\tIndicatorType string   `json:\"indicator_type\"`\r\n    18\t\tThreatActor   string   `json:\"threat_actor\"`\r\n    19\t\tConfidence    float64  `json:\"confidence\"`\r\n    20"]
[2853.383866, "o", "\t\tTags          []string `json:\"tags\"`\r\n    21\t\tSeverity      string   `json:\"severity\"`\r\n    22\t\tLastUpdated   string   `json:\"last_updated\"`\r\n    23\t\tTTLHours      int      `json:\"ttl_hours\"`\r\n    24\t}\r\n    25\t\r\n    26\ttype processedIOC struct {\r\n    27\t\tentry       iocEntry\r\n    28\t\tlastUpdated time.Time\r\n    29\t\tttlHours    int\r\n    30\t\tip          net.IP\r\n    31\t\tipNet       *net.IPNet\r\n    32\t\tprefixLen   int\r\n    33\t\tport        int\r\n"]
[2853.383929, "o", "    34\t}\r\n    35\t\r\n    36\ttype activeIOC struct {\r\n    37\t\tp      processedIOC\r\n    38\t\tbase   float64\r\n    39\t\tfactor float64\r\n    40\t}\r\n    41\t\r\n    42\ttype iocMatchInternal struct {\r\n"]
[2853.383998, "o", "    43\t\tp             processedIOC\r\n    44\t\tbase          float64\r\n    45\t\tfreshness     float64\r\n    46\t\tadjusted      float64\r\n    47\t\tmatchedFields []string\r\n    48\t}\r\n    49\t\r\n    50\ttype iocMatchOutput struct {\r\n    51\t\tIocID         string   `json:\"ioc_id\"`\r\n    52\t\tIndicator     string   `json:\"indicator\"`\r\n"]
[2853.384057, "o", "    53\t\tIndicatorType string   `json:\"indicator_type\"`\r\n    54\t\tThreatActor   string   `json:\"threat_actor\"`\r\n    55\t\tConfidence    float64  `json:\"confidence\"`\r\n    56\t\tTags          []string `json:\"tags\"`\r\n    57\t\tMatchedFields []string `json:\"matched_fields\"`\r\n    58\t}\r\n    59\t\r\n"]
[2853.384128, "o", "    60\tfunc runEnrich(args []string) int {\r\n    61\t\tfs := newFlagSet(\"enrich\")\r\n    62\t\tiocPath := fs.String(\"ioc\", \"\", \"path to IOC database JSON file\")\r\n    63\t\trefTimeStr := fs.String(\"reference-time\", \"\", \"ISO 8601 timestamp used for TTL evaluation\")\r\n    64\t\tminConf := fs.Float64(\"min-confidence\", 0.0, \"minimum base effective confidence\")\r\n    65\t\tif !parseFlags(fs, args) {\r\n    66"]
[2853.384188, "o", "\t\t\treturn 1\r\n    67\t\t}\r\n    68\t\tif !isFlagSet(fs, \"ioc\") || *iocPath == \"\" {\r\n    69\t\t\tfmt.Fprintln(os.Stderr, \"error: --ioc flag is required\")\r\n    70\t\t\treturn 1\r\n    71\t\t}\r\n    72\t\r\n    73\t\thasRef := isFlagSet(fs, \"reference-time\")\r\n    74\t\tvar refTime time.Time\r\n    75\t\tif hasRef {\r\n"]
[2853.384284, "o", "    76\t\t\tt, err := parseTime(*refTimeStr)\r\n    77\t\t\tif err != nil {\r\n    78\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    79\t\t\t\treturn 1\r\n    80\t\t\t}\r\n    81\t\t\trefTime = t\r\n    82\t\t}\r\n    83\t\r\n    84\t\tiocs, err := loadIOCDB(*iocPath)\r\n    85\t\tif err != nil {\r\n    86\t\t\tif os.IsNotExist(err) {\r\n    87\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    88\t"]
[2853.384351, "o", "\t\t\treturn 1\r\n    89\t\t\t}\r\n    90\t\t\tif _, ok := err.(*json.SyntaxError); ok {\r\n    91\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    92\t\t\t\treturn 2\r\n"]
[2853.384407, "o", "    93\t\t\t}\r\n    94\t\t\tif _, ok := err.(*json.UnmarshalTypeError); ok {\r\n    95\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    96\t\t\t\treturn 2\r\n    97\t\t\t}\r\n    98\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    99\t\t\treturn 1\r\n   100\t\t}\r\n   101\t\r\n   102\t\tscanner := bufio.NewScanner(os.Stdin)\r\n   103\t\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n"]
[2853.384465, "o", "   104\t\tvar enriched []map[string]interface{}\r\n   105\t\tlineNo := 0\r\n   106\t\tfor scanner.Scan() {\r\n   107\t\t\tlineNo++\r\n   108\t\t\tline := scanner.Text()\r\n   109\t\t\tif line == \"\" {\r\n   110\t\t\t\tcontinue\r\n   111\t\t\t}\r\n   112\t\t\tvar threat map[string]interface{}\r\n"]
[2853.384531, "o", "   113\t\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n   114\t\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n   115\t\t\t\treturn 2\r\n   116\t\t\t}\r\n   117\t\t\tenriched = append(enriched, enrichThreat(threat, iocs, refTime, hasRef, *minConf))\r\n   118\t\t}\r\n   119\t\tif err := scanner.Err(); err != nil {\r\n   120\t\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[2853.384605, "o", "   121\t\t\treturn 1\r\n   122\t\t}\r\n   123\t\r\n   124\t\tsortEnrichedThreats(enriched)\r\n   125\t\tw := bufio.NewWriter(os.Stdout)\r\n   126\t\tdefer w.Flush()\r\n   127\t\tenc := json.NewEncoder(w)\r\n   128\t\tfor _, t := range enriched {\r\n   129\t\t\tif err := enc.Encode(t); err != nil {\r\n   130\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   131\t\t\t\treturn 1\r\n"]
[2853.38466, "o", "   132\t\t\t}\r\n   133\t\t}\r\n   134\t\treturn 0\r\n   135\t}\r\n   136\t\r\n"]
