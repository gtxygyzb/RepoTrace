[10955.915002, "o", "func getFloat(m map[string]interface{}, key string) (float64, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn 0, false\r\n\t}\r\n\tswitch val := v.(type) {\r\n\t"]
[10955.915065, "o", "case float64:\r\n\t\treturn val, true\r\n\tcase int:\r\n\t\treturn float64(val), true\r\n\tdefault:\r\n\t\treturn 0, false\r\n\t}\r\n}\r\n\r\nfunc getIntSlice(m map[string]interface{}, key string) ([]int, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn nil, false\r\n\t}\r\n\tswitch val := v.(type) {\r\n\tcase []int:\r\n\t\treturn val, true\r\n\tcase []interface{}:\r\n\t\tout := make([]int, 0, len(val))\r\n"]
