[8472.704702, "o", "   124\t\t\tageMinutes = refTime.Sub(eventTime).Minutes()\r\n   125\t\t}\r\n   126\t\tif ageMinutes < 0 {\r\n   127\t\t\tageMinutes = 0\r\n   128\t\t}\r\n   129\t\trecency := math.Pow(2, -ageMinutes/60.0)\r\n   130\t\r\n   131\t\triskScore, _ := getFloat(threat, \"enriched_risk_score\")\r\n   132\t\trisk := riskScore / 500.0\r\n   133\t\tif risk > 1.0 {\r\n   134\t\t\trisk = 1.0\r\n   135\t\t}\r\n   136\t\tif risk < 0 {\r\n   137\t\t\trisk = 0\r\n   138\t\t}\r\n   139\t\r\n   140\t\tconfidence := 0.0\r\n"]
[8472.704818, "o", "   141\t\tif c, ok := getFloat(threat, \"max_ioc_confidence\"); ok {\r\n   142\t\t\tconfidence = c\r\n   143\t\t}\r\n   144\t\tif confidence < 0 {\r\n   145\t\t\tconfidence = 0\r\n   146\t\t}\r\n   147\t\tif confidence > 1 {\r\n   148\t\t\tconfidence = 1\r\n   149\t\t}\r\n   150\t\r\n"]
[8472.704887, "o", "   151\t\tactors := []string{}\r\n   152\t\tif a, ok := getStringSlice(threat, \"threat_actors\"); ok {\r\n   153\t\t\tactors = a\r\n   154\t\t}\r\n   155\t\tactor := float64(len(actors)) / 3.0\r\n   156\t\tif actor > 1.0 {\r\n   157\t\t\tactor = 1.0\r\n   158\t\t}\r\n   159\t\tif actor < 0 {\r\n   160\t\t\tactor = 0\r\n   161\t\t}\r\n   162\t\r\n   163\t\tseverity := getStringDefault(threat, \"ioc_severity\")\r\n   164\t\tseverityRank := prioritySeverityRanks[severity]\r\n   165\t\tseverityComponent := float64(severityRank) / 4.0\r\n   166\t\r\n   167\t\tscore := wSeverity*severityComponent +\r\n"]
