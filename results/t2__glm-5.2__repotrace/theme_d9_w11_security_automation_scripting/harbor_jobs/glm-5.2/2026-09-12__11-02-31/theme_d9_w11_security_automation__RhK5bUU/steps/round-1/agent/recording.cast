[8471.892604, "o", "    77\t\t\t\tDestIPs    []string `json:\"dest_ips\"`\r\n    78\t\t\t\tRiskScore  float64  `json:\"risk_score\"`\r\n    79\t\t\t}{\r\n    80\t\t\t\tThreatType: t.ThreatType,\r\n    81\t\t\t\tSourceIP:   t.SourceIP,\r\n    82\t\t\t\tTotalBytes: t.TotalBytes,\r\n    83\t\t\t\tFirstSeen:  t.FirstSeen,\r\n    84\t\t\t\tLastSeen:   t.LastSeen,\r\n    85\t\t\t\tDestIPs:    nonNilStrings(t.DestIPs),\r\n    86\t\t\t\tRiskScore:  t.RiskScore,\r\n    87\t\t\t})\r\n    88\t\tcase \"privilege_escalation\":\r\n    89\t\t\treturn json.Marshal(struct {\r\n    90\t\t\t\tThreatType    string  `json:\"threat_type\"`\r\n    91\t\t\t\tUser          string  `json:\"user\"`\r\n    92\t\t\t\tSourceIP      string  `json:\"source_ip\"`\r\n    93\t\t\t\tTimestamp     string  `json:\"timestamp\"`\r\n    94\t\t\t\tPriorFailures int     `json:\"prior_failures\"`\r\n    95\t\t\t\tRiskScore     float64 `json:\"risk_score\"`\r\n    96\t\t\t}{\r\n    97\t\t\t\tThreatType:    t.ThreatType,\r\n    98\t\t\t\tUser:          t.User,\r\n    99\t\t\t\tSourceIP:      t.SourceIP,\r\n"]
