[7820.022462, "o", "\u001b[?2004h> "]
[7820.022534, "i", "hreat, \"enriched_risk_score\")\n\trisk := riskScore / 500.0\n\tif risk > 1.0 {\n\t\trisk = 1.0\n\t}\n\tif risk < 0 {\n\t\trisk = 0\n\t}\n\n\tconfidence := 0.0\n\tif c, ok := getFloat(threat, \"max_ioc_confidence\"); ok {\n\t\tconfidence = c\n\t}\n\tif confidence < 0 {\n\t\tconfidence = 0\n\t}\n\tif confidence > 1 {\n\t\tconfidence = 1\n\t}\n\n\tactors := []string{}\n\tif a, ok := getStringSlice(threat, \"threat_actors\"); ok {\n\t\tactors = a\n\t}\n\tactor := float64(len(actors)) / 3.0\n\tif actor > 1.0 {\n\t\tactor = 1.0\n\t}\n\tif actor < 0 {\n\t\tactor = 0\n\t}\n\n\tseverity := getStringDefault(threat, \"ioc_severity\")\n\tseverityRank := prioritySeverityRanks[severity]\n\tseverityComponent := float64(severityRank) / 4.0\n\n\tscore := wSeverity*severityComponent +\n\t\twRecency*recency +\n\t\twRisk*risk +\n\t\twConfidence*confidence +\n\t\twActor*actor\n\n\tlabel := priorityLabel(score)\n\n\treturn prioritizeOutput{\n\t\tSourceIP:          sourceIP,\n\t\tThreatType:        threatType,\n\t\tPriorityScore:     round3(score),\n\t\tPriorityLabel:     label,\n\t\tComponents: map[string]float64{\n\t\t\t\"severity\":   round3(severi"]
