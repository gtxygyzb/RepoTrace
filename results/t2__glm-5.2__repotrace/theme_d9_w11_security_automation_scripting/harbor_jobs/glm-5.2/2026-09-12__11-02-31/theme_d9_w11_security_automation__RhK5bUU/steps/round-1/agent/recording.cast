[5571.167576, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/json\""]
[5571.167658, "o", "\r\n     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"sort\"\r\n     9\t\t\"time\"\r\n    10\t)\r\n    11\t\r\n    12\ttype snapshotReport struct {\r\n    13\t\tTotalThreats       int            `json:\"total_threats\"`\r\n    14\t\tUniqueSources      int            `json:\"unique_sources\"`\r\n    15\t\tActiveCampaigns    int            `json:\"active_campaigns\"`\r\n    16\t\t"]
[5571.167734, "o", "MaxCampaignSize    int            `json:\"max_campaign_size\"`\r\n    17\t\tRiskCategory       string         `json:\"risk_category\"`\r\n    18\t\tMeanEnrichedRisk   float64        `json:\"mean_enriched_risk\"`\r\n    19\t\tPeakBucketAvg      float64        `json:\"peak_bucket_avg\"`\r\n    20\t\tPeakBucketStart    string         `json:\"peak_bucket_start\"`\r\n    21\t\tDominantThreatType string         `json:\"dominant_threat_type\"`\r\n    22\t\tTopActor           string         `json:\"top_actor\"`\r\n    23\t\tActorThreatCounts  map[string]int `json:\"actor_threat_counts\"`\r\n    24\t}\r\n    25\t\r\n    26"]
[5571.167796, "o", "\tfunc runSnapshot(args []string) int {\r\n    27\t\tfs := newFlagSet(\"snapshot\")\r\n    28\t\tcampaignWindow := fs.Int(\"campaign-window\", 60, \"time window in minutes for campaign detection\")\r\n    29\t\tbucketMinutes := fs.Int(\"bucket-minutes\", 60, \"bucket width in minutes for internal timeline analysis\")\r\n    30\t\tif !parseFlags(fs, args) {\r\n    31\t\t\treturn 1\r\n    32\t\t}\r\n    33\t\tif *campaignWindow < 0 {\r\n"]
[5571.167863, "o", "    34\t\t\tfmt.Fprintf(os.Stderr, \"invalid --campaign-window: must be non-negative\\n\")\r\n    35\t\t\treturn 1\r\n    36\t\t}\r\n    37\t\tif *bucketMinutes <= 0 {\r\n    38\t\t\tfmt.Fprintf(os.Stderr, \"invalid --bucket-minutes: must be a positive integer\\n\")\r\n    39\t\t\treturn 1\r\n    40\t\t}\r\n    41\t\r\n    42\t\tscanner := bufio.NewScanner(os.Stdin)\r\n    43\t\t"]
[5571.16793, "o", "scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n    44\t\tvar threats []map[string]interface{}\r\n    45\t\tlineNo := 0\r\n    46\t\tfor scanner.Scan() {\r\n    47\t\t\tlineNo++\r\n    48\t\t\tline := scanner.Text()\r\n    49\t\t\tif line == \"\" {\r\n    50\t\t\t\tcontinue\r\n    51\t\t\t}\r\n"]
[5571.167991, "o", "    52\t\t\tvar threat map[string]interface{}\r\n    53\t\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n    54\t\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n    55\t\t\t\treturn 2\r\n    56\t\t\t}\r\n    57\t\t\tthreats = append(threats, threat)\r\n    58\t\t}\r\n    59\t\tif err := scanner.Err(); err != nil {\r\n    60\t\t\t"]
[5571.168055, "o", "fmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    61\t\t\treturn 2\r\n    62\t\t}\r\n    63\t\r\n    64\t\treport := buildSnapshot(threats, *campaignWindow, *bucketMinutes)\r\n    65\t\tdata, err := json.Marshal(report)\r\n    66\t\tif err != nil {\r\n    67\t\t\tfmt.Fprintf(os.Stderr, \"error marshalling report: %v\\n\", err)\r\n"]
[5571.168121, "o", "    68\t\t\treturn 2\r\n    69\t\t}\r\n    70\t\tfmt.Println(string(data))\r\n    71\t\treturn 0\r\n    72\t}\r\n    73\t\r\n"]
[5571.168185, "o", "    74\tfunc buildSnapshot(threats []map[string]interface{}, campaignWindow int, bucketMinutes int) snapshotReport {\r\n    75\t\treport := snapshotReport{\r\n    76\t\t\tActorThreatCounts: map[string]int{},\r\n    77\t\t\tRiskCategory:      \"low\",\r\n    78\t\t}\r\n    79\t\tif len(threats) == 0 {\r\n    80\t\t\treturn report\r\n    81\t\t}\r\n    82\t\r\n    83\t\treport.TotalThreats = len(threats)\r\n    84\t\r\n    85\t\tsourceSet := map[string]bool{}\r\n    86\t\tfor _, t := range threats {\r\n    87\t\t\tif ip, ok := getString(t, \"source_ip\"); ok && ip != \"\" {\r\n"]
[5571.168278, "o", "    88\t\t\t\tsourceSet[ip] = true\r\n    89\t\t\t}\r\n    90\t\t}\r\n    91\t\treport.UniqueSources = len(sourceSet)\r\n    92\t\r\n    93\t\tvar sumRisk float64\r\n    94\t\tfor _, t := range threats {\r\n    95\t\t\trisk, _ := getFloat(t, \"enriched_risk_score\")\r\n    96\t\t\tsumRisk += risk\r\n    97\t\t}\r\n    98\t\tmeanRisk := sumRisk / float64(len(threats))\r\n    99\t\t"]
[5571.168342, "o", "report.MeanEnrichedRisk = round2(meanRisk)\r\n   100\t\treport.RiskCategory = snapshotRiskCategory(report.MeanEnrichedRisk)\r\n   101\t\r\n   102\t\tbucketSeconds := int64(bucketMinutes) * 60\r\n   103\t\tbuckets := make(map[int64][]map[string]interface{})\r\n   104"]
[5571.1684, "o", "\t\tfor _, threat := range threats {\r\n   105\t\t\trefTime := threatSortTime(threat)\r\n   106\t\t\tvar refUnix int64\r\n   107\t\t\tif !refTime.IsZero() {\r\n   108\t\t\t\trefUnix = refTime.Unix()\r\n   109\t\t\t}\r\n   110\t\t\tstart := refUnix - ((refUnix%bucketSeconds)+bucketSeconds)%bucketSeconds\r\n   111\t\t\tbuckets[start] = append(buckets[start], threat)\r\n   112\t\t}\r\n   113\t\r\n   114\t\tpeakAvg := 0.0\r\n"]
[5571.168476, "o", "   115\t\tpeakStart := \"\"\r\n   116\t\tfirst := true\r\n   117\t\tvar starts []int64\r\n   118\t\tfor s := range buckets {\r\n   119\t\t\tstarts = append(starts, s)\r\n   120\t\t}\r\n   121\t\tsort.Slice(starts, func(i, j int) bool { return starts[i] < starts[j] })\r\n   122\t\tfor _, start := range starts {\r\n   123\t\t\tbucketThreats := buckets[start]\r\n   124\t\t\tvar sum float64\r\n   125\t\t\tfor _, t := range bucketThreats {\r\n"]
[5571.168538, "o", "   126\t\t\t\trisk, _ := getFloat(t, \"enriched_risk_score\")\r\n   127\t\t\t\tsum += risk\r\n   128\t\t\t}\r\n   129\t\t\tavg := sum / float64(len(bucketThreats))\r\n   130\t\t\tif first || avg > peakAvg {\r\n   131\t\t\t\tfirst = false\r\n   132\t\t\t\tpeakAvg = avg\r\n"]
[5571.168598, "o", "   133\t\t\t\tpeakStart = time.Unix(start, 0).UTC().Format(time.RFC3339)\r\n   134\t\t\t}\r\n   135\t\t}\r\n   136\t\treport.PeakBucketAvg = round2(peakAvg)\r\n   137\t\treport.PeakBucketStart = peakStart\r\n   138\t\r\n   139\t\ttypeCounts := map[string]int{}\r\n   140\t\tfor _, t := range threats {\r\n"]
[5571.168658, "o", "   141\t\t\tif tt, ok := getString(t, \"threat_type\"); ok && tt != \"\" {\r\n   142\t\t\t\ttypeCounts[tt]++\r\n   143\t\t\t}\r\n   144\t\t}\r\n   145\t\treport.DominantThreatType = dominantThreatType(threats, typeCounts)\r\n   146\t\r\n   147\t\tactorCounts := map[string]int{}\r\n   148\t\tfor _, t := range threats {\r\n   149\t\t\tif actors, ok := getStringSlice(t, \"threat_actors\"); ok {\r\n   150\t\t\t\tseen := map[string]bool{}\r\n   151\t\t"]
[5571.168714, "o", "\t\tfor _, actor := range actors {\r\n   152\t\t\t\t\tif actor != \"\" && !seen[actor] {\r\n   153\t\t\t\t\t\tseen[actor] = true\r\n   154\t\t\t\t\t\tactorCounts[actor]++\r\n   155\t\t\t\t\t}\r\n   156\t\t\t\t}\r\n   157\t\t\t}\r\n"]
[5571.168769, "o", "   158\t\t}\r\n   159\t\treport.ActorThreatCounts = actorCounts\r\n   160\t\r\n   161\t\tvar actors []string\r\n   162\t\tfor a := range actorCounts {\r\n   163\t\t\tactors = append(actors, a)\r\n   164\t\t}\r\n   165\t\tsort.Strings(actors)\r\n   166\t\t"]
[5571.16883, "o", "topActor := \"\"\r\n   167\t\tmaxActorCount := 0\r\n   168\t\tfor _, a := range actors {\r\n   169\t\t\tif actorCounts[a] > maxActorCount {\r\n   170\t\t\t\tmaxActorCount = actorCounts[a]\r\n   171\t\t\t\ttopActor = a\r\n   172\t\t\t}\r\n   173\t\t}\r\n"]
[5571.168892, "o", "   174\t\treport.TopActor = topActor\r\n   175\t\r\n   176\t\ttype snapThreat struct {\r\n   177\t\t\tref    time.Time\r\n   178\t\t\tactors []string\r\n   179\t\t}\r\n   180\t\tcampaignThreats := make([]snapThreat, len(threats))\r\n   181\t\tfor i, t := range threats {\r\n   182\t\t\tct := snapThreat{\r\n   183\t\t\t\tref: threatReferenceTime(t),\r\n"]
[5571.168955, "o", "   184\t\t\t}\r\n   185\t\t\tif actors, ok := getStringSlice(t, \"threat_actors\"); ok {\r\n   186\t\t\t\tct.actors = actors\r\n   187\t\t\t} else {\r\n"]
[5571.169017, "o", "   188\t\t\t\tct.actors = []string{}\r\n   189\t\t\t}\r\n   190\t\t\tcampaignThreats[i] = ct\r\n   191\t\t}\r\n   192\t\r\n   193\t\twindow := time.Duration(campaignWindow) * time.Minute\r\n   194\t\tn := len(campaignThreats)\r\n   195\t\tlinked := make([][]bool, n)\r\n   196\t\tfor i := range linked {\r\n   197\t\t\tlinked[i] = make([]bool, n)\r\n   198\t\t}\r\n   199\t\tfor i := 0; i < n; i++ {\r\n   200\t\t\tif len(campaignThreats[i].actors) == 0 {\r\n"]
[5571.169079, "o", "   201\t\t\t\tcontinue\r\n   202\t\t\t}\r\n   203\t\t\tfor j := i + 1; j < n; j++ {\r\n   204\t\t\t\tif len(campaignThreats[j].actors) == 0 {\r\n   205\t\t\t\t\tcontinue\r\n   206\t\t\t\t}\r\n   207\t\t\t\tif absDuration(campaignThreats[i].ref.Sub(campaignThreats[j].ref)) <= window && sharedActorCount(campaignThreats[i].actors, campaignThreats[j].actors) > 0 {\r\n   208\t\t\t\t\tlinked[i][j] = true\r\n"]
[5571.169137, "o", "   209\t\t\t\t\tlinked[j][i] = true\r\n   210\t\t\t\t}\r\n   211\t\t\t}\r\n   212\t\t}\r\n   213\t\r\n   214\t\tvisited := make([]bool, n)\r\n   215\t\tmaxCampaignSize := 0\r\n"]
[5571.169194, "o", "   216\t\tcampaignCount := 0\r\n   217\t\tfor start := 0; start < n; start++ {\r\n   218\t\t\tif visited[start] {\r\n   219\t\t\t\tcontinue\r\n   220\t\t\t}\r\n   221\t\t\tqueue := []int{start}\r\n   222\t\t\tvisited[start] = true\r\n   223\t\t\tcomponent := []int{start}\r\n"]
[5571.169262, "o", "   224\t\t\tfor len(queue) > 0 {\r\n   225\t\t\t\tcur := queue[0]\r\n   226\t\t\t\tqueue = queue[1:]\r\n   227\t\t\t\tfor next := 0; next < n; next++ {\r\n   228\t\t\t\t\tif !visited[next] && linked[cur][next] {\r\n   229\t\t\t\t\t\tvisited[next] = true\r\n"]
[5571.169317, "o", "   230\t\t\t\t\t\tqueue = append(queue, next)\r\n   231\t\t\t\t\t\tcomponent = append(component, next)\r\n   232\t\t\t\t\t}\r\n   233\t\t\t\t}\r\n   234\t\t\t}\r\n"]
[5571.169376, "o", "   235\t\t\tif len(component) >= 2 {\r\n   236\t\t\t\tcampaignCount++\r\n   237\t\t\t\tif len(component) > maxCampaignSize {\r\n   238\t\t\t\t\tmaxCampaignSize = len(component)\r\n   239\t\t\t\t}\r\n   240\t\t\t}\r\n   241\t\t}\r\n   242\t\treport.ActiveCampaigns = campaignCount\r\n   243\t\treport.MaxCampaignSize = maxCampaignSize\r\n"]
[5571.169433, "o", "   244\t\r\n   245\t\treturn report\r\n   246\t}\r\n   247\t\r\n   248\tfunc snapshotRiskCategory(mean float64) string {\r\n   249\t\tif mean < 100 {\r\n"]
[5571.169493, "o", "   250\t\t\treturn \"low\"\r\n   251\t\t}\r\n   252\t\tif mean < 250 {\r\n   253\t\t\treturn \"medium\"\r\n   254\t\t}\r\n   255\t\tif mean < 500 {\r\n   256\t\t\treturn \"high\"\r\n   257\t\t}\r\n   258\t\treturn \"critical\"\r\n   259\t}\r\n"]
