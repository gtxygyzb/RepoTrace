[1863.70778, "o", "\t\t\tports := make([]int, 0, len(window))\r\n   300\t\t\t\tfor _, e := range window {\r\n   301\t\t\t\t\tports = append(ports, e.DestPort)\r\n   302\t\t\t\t}\r\n   303\t\t\t\tports = uniqueSortedInts(ports)\r\n   304\t\t\t\tif len(ports) >= 10 {\r\n   305\t\t\t\t\trisk := float64(len(ports)) * 3.0\r\n   306\t\t\t\t\tif hasSensitivePort(ports) {\r\n   307\t\t\t\t\t\trisk += 20.0\r\n"]
