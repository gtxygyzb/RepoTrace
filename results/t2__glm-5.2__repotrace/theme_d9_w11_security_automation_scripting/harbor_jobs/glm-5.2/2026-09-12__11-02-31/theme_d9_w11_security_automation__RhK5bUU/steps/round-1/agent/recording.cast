[11896.478186, "o", "./main.go:11:\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|track|diff|anomaly|forecast|histogram|compliance> [flags]\")\r\n./main.go:45:\tcase \"forecast\":\r\n./track.go:132:\t\treturn \"critical\"\r\n./timeline.go:118:\t\tSeverityHistogram: map[string]int{\"none\": 0, \"low\": 0, \"medium\": 0, \"high\": 0, \"critical\": 0},\r\n./timeline.go:262:\tcase \"critical\":\r\n./event.go:30:\t\"critical\": 4,\r\n./snapshot.go:258:\treturn \"critical\"\r\n./diff.go:180:\tcase \"critical\":\r\n./prioritize.go:26:\t\"critical\": 4,\r\n./prioritize.go:197:\t\treturn \"critical\"\r\n./anomaly.go:128:\t\t\tseverity = \"moderate\"\r\n./summarize.go:245:\t"]
[11896.478325, "o", "severities := []string{\"critical\", \"high\", \"medium\", \"low\"}\r\n./enrich.go:530:\tcase \"critical\":\r\n./enrich.go:546:\t\treturn \"critical\"\r\n./forecast.go:12:type forecastInputSnapshot struct {\r\n./forecast.go:17:type forecastMetricResult struct {\r\n./forecast.go:25:type forecastOutput struct {\r\n./forecast.go:27:\tMetrics      map[string]forecastMetricResult `json:\"metrics\"`\r\n./forecast.go:33:\tfs := newFlagSet(\"forecast\")\r\n./forecast.go:43:\tvar snapshots []forecastInputSnapshot\r\n./forecast.go:51:\t\tvar snap forecastInputSnapshot\r\n./forecast.go:84:\tmetrics := map[string]forecastMetricResult{\r\n./forecast.go:101:\tout := forecastOutput{\r\n./forecast.go:110:\t\tfmt.Fprintln(os.Stderr, \"error: encoding forecast output:\", err)\r\n./forecast.go:199:\t\treturn \"critical\"\r\n./forecast.go:202:\t\treturn \"warning\"\r\n"]
[11896.478399, "o", "./correlate.go:331:\tcase \"critical\":\r\n"]
[11896.478771, "o", "\u001b[?2004hroot@n30009:/app# "]
[11901.823829, "i", "sed -n '1,240p' forecast.go\n"]
