[4507.79668, "o", "func getFloat(m map[string]interface{}, key string) (float64, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn 0, false\r\n\t}\r\n\tswitch val := v.(type) {\r\n\tcase float64:\r\n\t\treturn val, true\r\n"]
[4507.796762, "o", "\tcase int:\r\n\t\treturn float64(val), true\r\n\tdefault:\r\n\t\treturn 0, false\r\n\t}\r\n}\r\n\r\nfunc getIntSlice(m map[string]interface{}, key string) ([]int, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn nil, false\r\n\t}\r\n\tswitch val := v.(type) {\r\n"]
[4507.796829, "o", "\tcase []int:\r\n\t\treturn val, true\r\n\tcase []interface{}:\r\n\t\tout := make([]int, 0, len(val))\r\n\t\tfor _, e := range val {\r\n\t\t\tswitch n := e.(type) {\r\n\t\t\tcase float64:\r\n\t\t\t\tout = append(out, int(n))\r\n\t\t\tcase int:\r\n"]
[4507.796892, "o", "\t\t\t\tout = append(out, n)\r\n\t\t\tdefault:\r\n\t\t\t\treturn nil, false\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn out, true\r\n\tdefault:\r\n\t\treturn nil, false\r\n\t}\r\n}\r\n"]
[4507.796948, "o", "\r\n"]
