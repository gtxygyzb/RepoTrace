[6081.951028, "o", "    85\t\tif err != nil {\r\n    86\t\t\tif os.IsNotExist(err) {\r\n    87\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    88\t\t\t\treturn 1\r\n    89\t\t\t}\r\n    90\t\t\tif _, ok := err.(*json.SyntaxError); ok {\r\n    91\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    92\t\t\t\treturn 2\r\n    93\t\t\t}\r\n    94\t\t\tif _, ok := err.(*json.UnmarshalTypeError); ok {\r\n    95\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    96\t\t\t\treturn 2\r\n    97\t\t\t}\r\n    98\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    99\t\t\treturn 1\r\n   100\t\t}\r\n   101\t\r\n   102\t\tscanner := bufio.NewScanner(os.Stdin)\r\n   103\t\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n   104\t\tvar enriched []map[string]interface{}\r\n   105\t\tlineNo := 0\r\n   106\t\tfor scanner.Scan() {\r\n   107\t\t\tlineNo++\r\n   108\t\t\tline := scanner.Text()\r\n   109\t\t\tif line == \"\" {\r\n   110\t\t\t\tcontinue\r\n"]
