[11528.040738, "i", "sed -n '1,260p' forecast.go\n"]
[11528.040972, "o", "sed -n '1,260p' forecast.go\r\n\u001b[?2004l\r"]
[11528.044465, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n)\r\n"]
[11528.0446, "o", "\r\ntype forecastInputSnapshot struct {\r\n\tGlobalMeanRisk float64 `json:\"global_mean_risk\"`\r\n\tTotalThreats   int     `json:\"total_threats\"`\r\n}\r\n\r\ntype forecastMetricResult struct {\r\n\tSlope       json.Number   `json:\"slope\"`\r\n\tIntercept   json.Number   `json:\"intercept\"`\r\n\tTrend       string        `json:\"trend\"`\r\n\tLastValue   json.Number   `json:\"last_value\"`\r\n\tPredictions []json.Number `json:\"predictions\"`\r\n}\r\n\r\ntype forecastOutput struct {\r\n\tInputCount   int                             `json:\"input_count\"`\r\n\tMetrics      map[string]forecastMetricResult `json:\"metrics\"`\r\n\tOverallTrend string                          `json:\"overall_trend\"`\r\n\tAlertLevel   string                          `json:\"alert_level\"`\r\n}\r\n"]
[11528.044744, "o", "\r\nfunc runForecast(args []string) int {\r\n\tfs := newFlagSet(\"forecast\")\r\n\tsteps := fs.Int(\"steps\", 3, \"number of future steps to predict\")\r\n\tif !parseFlags(fs, args) {\r\n\t\treturn 1\r\n\t}\r\n\tif *steps < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --steps must be at least 1\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\tvar snapshots []forecastInputSnapshot\r\n\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n\tfor scanner.Scan() {\r\n\t\tline := scanner.Text()\r\n\t\tif len(line) == 0 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvar snap forecastInputSnapshot\r\n\t\tif err := json.Unmarshal([]byte(line), &snap); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: malformed JSON input: %s\\n\", err)\r\n"]
[11528.044891, "o", "\t\t\treturn 2\r\n\t\t}\r\n\t\tsnapshots = append(snapshots, snap)\r\n\t}\r\n\tif err := scanner.Err(); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: reading input: %s\\n\", err)\r\n\t\treturn 1\r\n\t}\r\n\tif len(snapshots) < 3 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: at least 3 valid input snapshots are required\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\trisks := make([]float64, len(snapshots))\r\n\tthreats := make([]float64, len(snapshots))\r\n\tfor i, snap := range snapshots {\r\n\t\trisks[i] = snap.GlobalMeanRisk\r\n\t\tthreats[i] = float64(snap.TotalThreats)\r\n\t}\r\n\r\n\triskSlope, riskIntercept := olsLine(0, risks)\r\n\tthreatSlope, threatIntercept := olsLine(0, threats)\r\n\r\n"]
[11528.045024, "o", "\triskPredictions := predictLine(riskSlope, riskIntercept, len(snapshots), *steps)\r\n\tthreatPredictions := predictLine(threatSlope, threatIntercept, len(snapshots), *steps)\r\n\r\n\triskTrend := trendFromSlope(riskSlope)\r\n\tthreatTrend := trendFromSlope(threatSlope)\r\n\r\n\tlast := snapshots[len(snapshots)-1]\r\n\tmetrics := map[string]forecastMetricResult{\r\n\t\t\"global_mean_risk\": {\r\n\t\t\tSlope:       json.Number(format4(riskSlope)),\r\n\t\t\tIntercept:   json.Number(format4(riskIntercept)),\r\n\t\t\tTrend:       riskTrend,\r\n\t\t\tLastValue:   json.Number(formatRiskValue(last.GlobalMeanRisk)),\r\n\t\t\tPredictions: roundAll4(riskPredictions),\r\n\t\t},\r\n\t\t\"total_threats\": {\r\n\t\t\tSlope:       json.Number(format4(threatSlope)),\r\n\t\t\tIntercept:   json.Number(format4(threatIntercept)),\r\n\t\t\tTrend:       threatTrend,\r\n\t\t\tLastValue:   json.Number(strconv.Itoa(last.TotalThreats)),\r\n\t\t\tPredictions: roundAll4(threatPredictions),\r\n\t\t},\r\n"]
[11528.045156, "o", "\t}\r\n\r\n\tout := forecastOutput{\r\n\t\tInputCount:   len(snapshots),\r\n\t\tMetrics:      metrics,\r\n\t\tOverallTrend: overallTrend(riskTrend, threatTrend),\r\n\t\tAlertLevel:   alertLevelFromSlopes(risks, threats, riskSlope, threatSlope),\r\n\t}\r\n\r\n\tencoded, err := json.Marshal(out)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: encoding forecast output:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tfmt.Println(string(encoded))\r\n\treturn 0\r\n}\r\n\r\nfunc olsLine(startIndex int, values []float64) (slope, intercept float64) {\r\n\tn := len(values)\r\n\tif n == 0 {\r\n\t\treturn 0, 0\r\n\t}\r\n\t"]
[11528.045334, "o", "var sumX, sumY, sumXY, sumX2 float64\r\n\tfor i, y := range values {\r\n\t\tx := float64(startIndex + i)\r\n\t\tsumX += x\r\n\t\tsumY += y\r\n\t\tsumXY += x * y\r\n\t\tsumX2 += x * x\r\n\t}\r\n\r\n\tdenom := float64(n)*sumX2 - sumX*sumX\r\n\tif denom == 0 {\r\n\t\tslope = 0\r\n\t\tintercept = values[0]\r\n\t\treturn\r\n\t}\r\n\tslope = (float64(n)*sumXY - sumX*sumY) / denom\r\n\tintercept = (sumY - slope*sumX) / float64(n)\r\n\treturn\r\n}\r\n\r\nfunc predictLine(slope, intercept float64, startIndex, steps int) []float64 {\r\n\tpredictions := make([]float64, steps)\r\n\tfor i := 0; i < steps; i++ {\r\n\t\tpredictions[i] = slope*float64(startIndex+i) + intercept\r\n\t}\r\n\treturn predictions\r\n}\r\n\r\nfunc trendFromSlope(slope float64) string {\r\n\tr := roundHalfUp4(slope)\r\n"]
[11528.04552, "o", "\tif r > 0 {\r\n\t\treturn \"increasing\"\r\n\t}\r\n\tif r < 0 {\r\n\t\treturn \"decreasing\"\r\n\t}\r\n\treturn \"stable\"\r\n}\r\n\r\n"]
[11528.045635, "o", "func overallTrend(a, b string) string {\r\n\tif a == \"increasing\" && b == \"increasing\" {\r\n\t\treturn \"increasing\"\r\n\t}\r\n\tif a == \"decreasing\" && b == \"decreasing\" {\r\n\t\treturn \"decreasing\"\r\n\t}\r\n\tif a == \"increasing\" || b == \"increasing\" {\r\n\t\tif a == \"decreasing\" || b == \"decreasing\" {\r\n\t\t\treturn \"mixed\"\r\n\t\t}\r\n\t\treturn \"increasing\"\r\n\t}\r\n\tif a == \"decreasing\" || b == \"decreasing\" {\r\n\t\treturn \"decreasing\"\r\n\t}\r\n\treturn \"stable\"\r\n}\r\n\r\nfunc alertLevelFromSlopes(risks, threats []float64, riskSlope, threatSlope float64) string {\r\n\triskMean := meanOfValues(risks)\r\n\tthreatMean := meanOfValues(threats)\r\n\r\n\tmaxRatio := 0.0\r\n\tif riskSlope > 0 {\r\n\t\tratio := riskSlope / math.Max(riskMean, 1.0)\r\n\t\tif ratio > maxRatio {\r\n\t\t\tmaxRatio = ratio\r\n\t\t}\r\n"]
[11528.045746, "o", "\t}\r\n\tif threatSlope > 0 {\r\n\t\tratio := threatSlope / math.Max(threatMean, 1.0)\r\n\t\tif ratio > maxRatio {\r\n\t\t\tmaxRatio = ratio\r\n\t\t}\r\n\t}\r\n\r\n\tif maxRatio >= 0.5 {\r\n\t\treturn \"critical\"\r\n\t}\r\n\tif maxRatio >= 0.2 {\r\n\t\treturn \"warning\"\r\n\t}\r\n\treturn \"normal\"\r\n}\r\n\r\nfunc meanOfValues(values []float64) float64 {\r\n\tif len(values) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tvar sum float64\r\n\tfor _, v := range values {\r\n\t\tsum += v\r\n\t}\r\n\treturn sum / float64(len(values))\r\n}\r\n\r\nfunc roundAll4(values []float64) []json.Number {\r\n"]
[11528.045864, "o", "\tout := make([]json.Number, len(values))\r\n\tfor i, v := range values {\r\n\t\tout[i] = json.Number(format4(v))\r\n\t}\r\n\treturn out\r\n}\r\n"]
