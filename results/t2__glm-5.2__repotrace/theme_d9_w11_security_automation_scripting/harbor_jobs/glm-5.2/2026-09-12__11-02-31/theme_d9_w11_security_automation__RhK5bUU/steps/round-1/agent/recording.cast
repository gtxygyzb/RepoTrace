[10148.158442, "o", "\t\t\t\tZScore:         json.Number(format4(threatZ)),\r\n   146\t\t\t\t\t},\r\n   147\t\t\t\t},\r\n   148\t\t\t\tCombinedZ:        json.Number(format4(combinedZ)),\r\n   149\t\t\t\tBaselineCount:    baselineCount,\r\n   150\t\t\t\tDirection:        direction,\r\n   151\t\t\t\tSeverity:         severity,\r\n   152\t\t\t\troundedCombinedZ: roundedCombinedZ,\r\n   153\t\t\t})\r\n   154\t\t}\r\n   155\t\r\n   156\t\tsort.SliceStable(anomalies, func(a, b int) bool {\r\n"]
[10148.158499, "o", "   157\t\t\tif anomalies[a].roundedCombinedZ != anomalies[b].roundedCombinedZ {\r\n   158\t\t\t\treturn anomalies[a].roundedCombinedZ > anomalies[b].roundedCombinedZ\r\n   159\t\t\t}\r\n   160\t\t\treturn anomalies[a].Index < anomalies[b].Index\r\n   161\t\t})\r\n   162\t\r\n   163\t\tencoder := json.NewEncoder(os.Stdout)\r\n   164\t\tencoder.SetEscapeHTML(false)\r\n"]
[10148.158561, "o", "   165\t\tfor _, rec := range anomalies {\r\n   166\t\t\tif err := encoder.Encode(rec); err != nil {\r\n   167\t\t\t\tfmt.Fprintln(os.Stderr, \"error: failed to write anomaly record:\", err)\r\n   168\t\t\t\treturn 1\r\n   169\t\t\t}\r\n   170\t\t}\r\n   171\t\r\n   172\t\treturn 0\r\n   173\t}\r\n   174\t"]
[10148.158617, "o", "\r\n   175\tfunc baselineStats(values []float64) (float64, float64) {\r\n   176\t\tn := len(values)\r\n   177\t\tif n == 0 {\r\n   178\t\t\treturn 0, 0\r\n   179\t\t}\r\n   180\t\r\n   181\t\tsum := 0.0\r\n"]
[10148.158674, "o", "   182\t\tfor _, v := range values {\r\n   183\t\t\tsum += v\r\n   184\t\t}\r\n   185\t\tmean := sum / float64(n)\r\n   186\t\r\n   187\t\tsquaredSum := 0.0\r\n   188\t\tfor _, v := range values {\r\n   189\t\t\tdiff := v - mean\r\n   190\t\t\tsquaredSum += diff * diff\r\n"]
[10148.15873, "o", "   191\t\t}\r\n   192\t\tstddev := math.Sqrt(squaredSum / float64(n))\r\n   193\t\r\n   194\t\treturn mean, stddev\r\n   195\t}\r\n   196\t\r\n   197\tfunc zScore(current, mean, stddev float64) float64 {\r\n   198\t\tif stddev == 0 {\r\n"]
[10148.158792, "o", "   199\t\t\tif current == mean {\r\n   200\t\t\t\treturn 0.0\r\n   201\t\t\t}\r\n   202\t\t\tif current > mean {\r\n   203\t\t\t\treturn 999.0\r\n   204\t\t\t}\r\n   205\t\t\treturn -999.0\r\n   206\t\t}\r\n   207\t\treturn (current - mean) / stddev\r\n   208"]
[10148.158849, "o", "\t}\r\n   209\t\r\n   210\tfunc roundHalfUp4(f float64) float64 {\r\n   211\t\tpow := 10000.0\r\n   212\t\treturn math.Floor(f*pow+0.5) / pow\r\n   213\t}\r\n   214\t\r\n   215\tfunc format4(f float64) string {\r\n   216\t\trounded := roundHalfUp4(f)\r\n   217\t\tif rounded == 0 {"]
[10148.158906, "o", "\r\n   218\t\t\treturn \"0.0000\"\r\n   219\t\t}\r\n   220\t\treturn fmt.Sprintf(\"%.4f\", rounded)\r\n   221\t}\r\n   222\t\r\n   223\tfunc formatRiskValue(f float64) string {\r\n   224\t\ts := strconv.FormatFloat(f, 'f', -1, 64)\r\n   225\t\tif !strings.Contains(s, \".\") {\r\n   226\t\t\ts += \".0\"\r\n   227\t\t"]
[10148.158962, "o", "}\r\n   228\t\treturn s\r\n   229\t}\r\n"]
