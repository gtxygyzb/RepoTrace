[7733.564395, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[7733.564482, "o", "\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\ntype Event struct {\r\n\tTimestamp   string            `json:\"timestamp\"`\r\n\tSourceIP    string            `json:\"source_ip\"`\r\n\tDestIP      string            `json:\"dest_ip\"`\r\n"]
[7733.564556, "o", "\tDestPort    int               `json:\"dest_port\"`\r\n\tProtocol    string            `json:\"protocol\"`\r\n\tAction      string            `json:\"action\"`\r\n\tEventType   string            `json:\"event_type\"`\r\n\tUser        string            `json:\"user\"`\r\n\tSeverity    string            `json:\"severity\"`\r\n\tPayloadSize int64             `json:\"payload_size\"`\r\n\tMetadata    map[string]string `json:\"metadata\"`\r\n}\r\n\r\nvar severityMap = map[string]int{\r\n\t\"low\":      1,\r\n\t\"medium\":   2,\r\n\t\"high\":     3,\r\n\t\"critical\": 4,\r\n}\r\n\r\nfunc severityValue(s string) int {\r\n\treturn severityMap[s]\r\n}"]
[7733.564637, "o", "\r\n\r\nfunc parseEvent(line string) (Event, error) {\r\n\tvar e Event\r\n\tif err := json.Unmarshal([]byte(line), &e); err != nil {\r\n\t\treturn e, err\r\n\t}\r\n"]
[7733.564718, "o", "\treturn e, nil\r\n}\r\n\r\nfunc parseTime(ts string) (time.Time, error) {\r\n\tt, err := time.Parse(time.RFC3339, ts)\r\n\tif err != nil {\r\n\t\treturn time.Time{}, fmt.Errorf(\"invalid timestamp %q: %w\", ts, err)\r\n\t}\r\n\treturn t, nil\r\n}\r\n\r\nfunc readEvents() ([]Event, error) {\r\n\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\tvar events []Event\r\n\tlineNo := 0\r\n\tfor scanner.Scan() {"]
[7733.564795, "o", "\r\n\t\tlineNo++\r\n\t\tline := scanner.Text()\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\te, err := parseEvent(line)\r\n\t\tif err != nil {\r\n\t\t\treturn events, fmt.Errorf(\"line %d: %w\", lineNo, err)\r\n\t\t}\r\n\t\tevents = append(events, e)\r\n"]
[7733.564864, "o", "\t}\r\n\tif err := scanner.Err(); err != nil {\r\n\t\treturn events, err\r\n\t}\r\n\treturn events, nil\r\n}\r\n\r\nfunc sortEventsByTime(events []Event) {\r\n\tsort.SliceStable(events, func(i, j int) bool {\r\n\t\treturn events[i].Timestamp < events[j].Timestamp\r\n\t})\r\n}\r\n"]
