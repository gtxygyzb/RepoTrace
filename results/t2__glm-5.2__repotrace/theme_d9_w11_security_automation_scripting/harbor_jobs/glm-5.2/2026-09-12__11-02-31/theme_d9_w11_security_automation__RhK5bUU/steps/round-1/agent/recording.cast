[951.733303, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[951.733359, "o", "\u001b[?2004h> "]
[951.733543, "o", "    if err := scanner.Err(); err != nil {\r\n\u001b[?2004l\r"]
[951.733599, "o", "\u001b[?2004h> "]
[951.733695, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[951.733756, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[951.73381, "o", "\u001b[?2004h> "]
