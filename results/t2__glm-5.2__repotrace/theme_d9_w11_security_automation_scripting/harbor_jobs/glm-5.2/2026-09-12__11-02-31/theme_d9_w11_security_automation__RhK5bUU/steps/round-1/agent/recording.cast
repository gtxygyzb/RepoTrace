[10220.421202, "o", "\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\twRecency    = \u001b[01;31m\u001b[K0.25\u001b[m\u001b[K\r\n\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\twRisk       = \u001b[01;31m\u001b[K0.25\u001b[m\u001b[K\r\n"]
[10220.421427, "o", "\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tPriorityScore     float64            `json:\"\u001b[01;31m\u001b[Kpriority_score\u001b[m\u001b[K\"`\r\n\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tPriorityLabel     string             `json:\"\u001b[01;31m\u001b[Kpriority_label\u001b[m\u001b[K\"`\r\n\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K173\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tlabel := \u001b[01;31m\u001b[KpriorityLabel\u001b[m\u001b[K(score)\r\n\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KpriorityLabel\u001b[m\u001b[K(score float64) string {\r\n"]
[10220.421503, "o", "\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K196\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase score >= \u001b[01;31m\u001b[K0.75\u001b[m\u001b[K:\r\n"]
[10220.421569, "o", "\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase score >= \u001b[01;31m\u001b[K0.50\u001b[m\u001b[K:\r\n\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase score >= \u001b[01;31m\u001b[K0.25\u001b[m\u001b[K:\r\n"]
[10220.437718, "o", "grep: ./secsentinel: binary file matches\r\n"]
[10220.437977, "o", "\u001b[35m\u001b[K./enrich.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K469\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase fraction < \u001b[01;31m\u001b[K0.25\u001b[m\u001b[K:\r\n\u001b[35m\u001b[K./enrich.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K471\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase fraction < \u001b[01;31m\u001b[K0.50\u001b[m\u001b[K:\r\n\u001b[35m\u001b[K./enrich.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K473\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase fraction < \u001b[01;31m\u001b[K0.75\u001b[m\u001b[K:\r\n"]
