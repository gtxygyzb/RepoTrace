[951.968985, "o", "\u001b[?2004h> "]
[951.969228, "o", "        code = runSummarize(os.Args[2:])\r\n\u001b[?2004l\r"]
[951.969285, "o", "\u001b[?2004h> "]
[951.969391, "o", "    case \"filter\":\r\n\u001b[?2004l\r"]
[951.96945, "o", "\u001b[?2004h> "]
[951.969665, "o", "        code = runFilter(os.Args[2:])\r\n\u001b[?2004l\r"]
[951.969731, "o", "\u001b[?2004h> "]
[951.96984, "o", "    case \"respond\":\r\n\u001b[?2004l\r"]
[951.969896, "o", "\u001b[?2004h> "]
