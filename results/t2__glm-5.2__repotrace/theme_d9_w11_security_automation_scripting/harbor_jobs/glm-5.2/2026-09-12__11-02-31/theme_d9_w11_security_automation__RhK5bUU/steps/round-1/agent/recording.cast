[10312.147415, "o", "\u001b[?2004h> )"]
[10312.14747, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.147524, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
