[4130.799194, "o", "     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t)\r\n     8\t\r\n     9\tfunc main() {\r\n    10\t\tif len(os.Args) < 2 {\r\n    11\t\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate> [flags]\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\r\n    15\t\tvar code int\r\n    16\t\tswitch os.Args[1] {\r\n    17\t\tcase \"analyze\":\r\n    18\t\t\tcode = runAnalyze(os.Args[2:])\r\n    19\t\tcase \"summarize\":\r\n    20\t\t"]
[4130.799297, "o", "\tcode = runSummarize(os.Args[2:])\r\n    21\t\tcase \"filter\":\r\n    22\t\t\tcode = runFilter(os.Args[2:])\r\n    23\t\tcase \"respond\":\r\n    24\t\t"]
[4130.799358, "o", "\tcode = runRespond(os.Args[2:])\r\n    25\t\tcase \"enrich\":\r\n    26\t\t\tcode = runEnrich(os.Args[2:])\r\n    27\t\tcase \"correlate\":\r\n    28\t\t\tcode = runCorrelate(os.Args[2:])\r\n    29\t\tdefault:\r\n    30\t\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n    31\t\t\tcode = 1\r\n    32\t\t}\r\n    33\t\tos.Exit(code)\r\n    34\t}\r\n    35\t\r\n    36\tfunc newFlagSet(name string) *flag.FlagSet {\r\n    37\t\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n    38\t\tfs.SetOutput(os.Stderr)\r\n    39\t\tfs.Usage = func() {}\r\n"]
[4130.799457, "o", "    40\t\treturn fs\r\n    41\t}\r\n    42\t\r\n    43\tfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n    44\t\tif err := fs.Parse(args); err != nil {\r\n    45\t\t\treturn false\r\n    46\t\t}\r\n    47\t\treturn true\r\n    48\t}\r\n    49\t\r\n    50\tfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n    51\t\tset := false\r\n    52\t\tfs.Visit(func(f *flag.Flag) {\r\n    53\t\t\tif f.Name == name {\r\n    54\t\t"]
