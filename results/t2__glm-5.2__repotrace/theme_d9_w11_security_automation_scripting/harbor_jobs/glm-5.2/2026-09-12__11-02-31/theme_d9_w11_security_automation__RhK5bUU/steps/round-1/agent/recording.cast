[10221.219609, "o", "\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tRecency:    \u001b[01;31m\u001b[Kround4\u001b[m\u001b[K(recency),\r\n\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tRisk:       \u001b[01;31m\u001b[Kround4\u001b[m\u001b[K(risk),\r\n\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tConfidence: \u001b[01;31m\u001b[Kround4\u001b[m\u001b[K(confidence),\r\n\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tActor:      \u001b[01;31m\u001b[Kround4\u001b[m\u001b[K(actor),\r\n"]
[10221.219662, "o", "\u001b[35m\u001b[K./prioritize.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc round4\u001b[m\u001b[K(f float64) float64 {\r\n"]
[10221.235421, "o", "grep: ./secsentinel: binary file matches\r\n"]
