[7295.840704, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n"]
[7295.840804, "o", "     7\t\t\"math\"\r\n     8\t\t\"os\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"time\"\r\n    11\t)\r\n    12\t\r\n    13\ttype timelineBucket struct {\r\n    14\t\tBucketStart       string                   `json:\"bucket_start\"`\r\n    15\t\tBucketEnd         string                   `json:\"bucket_end\"`\r\n    16\t\tThreatCount       int                      `json:\"threat_count\"`\r\n    17\t\tAvgRisk           float64                  `json:\"avg_risk\"`\r\n    18\t\tMaxRisk           float64                  `json:\"max_risk\"`\r\n    19\t\tMinRisk           float64                  `json:\"min_risk\"`\r\n    20\t\tRiskStdDev        float64                  `json:\"risk_std_dev\"`\r\n    21\t\tDominantType      string                   `json:\"dominant_type\"`\r\n"]
[7295.840888, "o", "    22\t\tTypeDistribution  map[string]int           `json:\"type_distribution\"`\r\n    23\t\tUniqueActors      []string                 `json:\"unique_actors\"`\r\n    24\t\tSeverityHistogram map[string]int           `json:\"severity_histogram\"`\r\n    25\t\tEscalationIndex   float64                  `json:\"escalation_index\"`\r\n    26\t\tRiskTrend         float64                  `json:\"risk_trend\"`\r\n    27\t\tBurstScore        float64                  `json:\"burst_score\"`\r\n    28\t\tTopThreats        []map[string]interface{} `json:\"top_threats\"`\r\n    29\t}\r\n    30\t\r\n    31\tfunc runTimeline(args []string) int {\r\n    32\t\tfs := newFlagSet(\"timeline\")\r\n    33\t\tbucketMinutes := fs.Int(\"bucket-minutes\", 0, \"width of each time bucket in minutes\")\r\n"]
[7295.84095, "o", "    34\t\ttopN := fs.Int(\"top-n\", 3, \"maximum number of top threats to include per bucket\")\r\n    35\t\tif !parseFlags(fs, args) {\r\n    36\t\t\treturn 1\r\n    37\t\t}\r\n    38\t\tif !isFlagSet(fs, \"bucket-minutes\") {\r\n    39\t\t\tfmt.Fprintln(os.Stderr, \"missing required flag: --bucket-minutes\")\r\n    40\t\t\treturn 1\r\n    41\t\t}\r\n"]
[7295.841018, "o", "    42\t\tif *bucketMinutes <= 0 {\r\n    43\t\t\tfmt.Fprintf(os.Stderr, \"invalid --bucket-minutes: must be a positive integer\\n\")\r\n    44\t\t\treturn 1\r\n    45\t\t}\r\n    46\t\tif *topN < 0 {\r\n    47\t\t\tfmt.Fprintf(os.Stderr, \"invalid --top-n: must be non-negative\\n\")\r\n    48\t\t\treturn 1\r\n    49\t\t}\r\n    50\t\r\n"]
[7295.84108, "o", "    51\t\tscanner := bufio.NewScanner(os.Stdin)\r\n    52\t\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n    53\t\tlineNo := 0\r\n    54\t\tvar threats []map[string]interface{}\r\n    55\t\tfor scanner.Scan() {\r\n    56\t\t\tlineNo++\r\n    57\t\t\tline := scanner.Text()\r\n    58\t\t\tif line == \"\" {\r\n    59\t\t\t\tcontinue\r\n"]
[7295.841142, "o", "    60\t\t\t}\r\n    61\t\t\tvar threat map[string]interface{}\r\n    62\t\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n    63\t\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n    64\t\t\t\treturn 2\r\n    65\t\t\t}\r\n    66\t\t\tthreats = append(threats, threat)\r\n    67\t\t}\r\n    68\t\tif err := scanner.Err(); err != nil {\r\n    69"]
[7295.841202, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n    70\t\t\treturn 2\r\n    71\t\t}\r\n    72\t\r\n    73\t\tbucketSeconds := int64(*bucketMinutes) * 60\r\n    74\t\tbuckets := make(map[int64][]map[string]interface{})\r\n    75\t\tvar bucketStarts []int64\r\n    76\t\tfor _, threat := range threats {\r\n"]
[7295.841319, "o", "    77\t\t\trefTime := threatSortTime(threat)\r\n    78\t\t\tvar refUnix int64\r\n    79\t\t\tif !refTime.IsZero() {\r\n    80\t\t\t\trefUnix = refTime.Unix()\r\n    81\t\t\t}\r\n    82\t\t\tstart := refUnix - ((refUnix%bucketSeconds)+bucketSeconds)%bucketSeconds\r\n    83\t\t\tif _, ok := buckets[start]; !ok {\r\n    84\t\t\t\tbucketStarts = append(bucketStarts, start)\r\n    85\t\t\t}\r\n    86\t\t\tbuckets[start] = append(buckets[start], threat)\r\n    87\t\t}\r\n    88\t\r\n    89\t\tsort.Slice(bucketStarts, func(i, j int) bool { return bucketStarts[i] < bucketStarts[j] })\r\n    90\t\r\n    91\t\twriter := bufio.NewWriter(os.Stdout)\r\n"]
[7295.841383, "o", "    92\t\tdefer writer.Flush()\r\n    93\t\r\n    94\t\tfor _, start := range bucketStarts {\r\n    95\t\t\tbucketThreats := buckets[start]\r\n    96\t\t\tstartTime := time.Unix(start, 0).UTC()\r\n    97\t\t\tendTime := startTime.Add(time.Duration(*bucketMinutes) * time.Minute)\r\n    98\t\t\tb := buildTimelineBucket(bucketThreats, startTime, endTime, *bucketMinutes, *topN)\r\n    99\t\t\tdata, err := json.Marshal(b)\r\n"]
[7295.841446, "o", "   100\t\t\tif err != nil {\r\n   101\t\t\t\tfmt.Fprintf(os.Stderr, \"error marshalling bucket: %v\\n\", err)\r\n   102\t\t\t\treturn 2\r\n   103\t\t\t}\r\n   104\t\t\twriter.Write(data)\r\n   105\t\t\twriter.WriteByte('\\n')\r\n   106\t\t}\r\n   107\t\r\n   108\t\t"]
[7295.841511, "o", "return 0\r\n   109\t}\r\n   110\t\r\n   111\tfunc buildTimelineBucket(threats []map[string]interface{}, startTime time.Time, endTime time.Time, bucketMinutes int, topN int) timelineBucket {\r\n   112\t\tn := len(threats)\r\n   113\t\tb := timelineBucket{\r\n   114\t\t\tBucketStart:       startTime.Format(time.RFC3339),\r\n   115\t\t\tBucketEnd:         endTime.Format(time.RFC3339),\r\n   116\t\t\tThreatCount:       n,\r\n"]
[7295.841574, "o", "   117\t\t\tTypeDistribution:  map[string]int{},\r\n   118\t\t\tSeverityHistogram: map[string]int{\"none\": 0, \"low\": 0, \"medium\": 0, \"high\": 0, \"critical\": 0},\r\n   119\t\t\tUniqueActors:      []string{},\r\n   120\t\t\tTopThreats:        []map[string]interface{}{},\r\n"]
[7295.841651, "o", "   121\t\t}\r\n   122\t\r\n   123\t\tif n == 0 {\r\n   124\t\t\treturn b\r\n   125\t\t}\r\n   126\t\r\n   127\t\tvar sumRisk, maxRisk, minRisk float64\r\n   128\t\ttypeCounts := map[string]int{}\r\n   129\t\tactorSet := map[string]bool{}\r\n   130\t\trisks := make([]float64, 0, n)\r\n   131\t\tfor i, threat := range threats {\r\n   132\t\t\trisk, _ := getFloat(threat, \"enriched_risk_score\")\r\n   133\t\t\trisks = append(risks, risk)\r\n   134\t\t\tsumRisk += risk\r\n   135"]
[7295.841715, "o", "\t\t\tif i == 0 {\r\n   136\t\t\t\tmaxRisk = risk\r\n   137\t\t\t\tminRisk = risk\r\n   138\t\t\t} else {\r\n   139\t\t\t\tif risk > maxRisk {\r\n   140\t\t\t\t\tmaxRisk = risk\r\n   141\t\t\t\t}\r\n   142\t\t\t\tif risk < minRisk {\r\n   143\t\t\t\t\tminRisk = risk\r\n   144\t\t\t\t}\r\n   145\t\t\t}\r\n   146"]
[7295.841778, "o", "\t\t\tif tt, ok := getString(threat, \"threat_type\"); ok {\r\n   147\t\t\t\ttypeCounts[tt]++\r\n   148\t\t\t}\r\n   149\t\t\tif sev, ok := getString(threat, \"ioc_severity\"); ok {\r\n   150\t\t\t\tif _, exists := b.SeverityHistogram[sev]; exists {\r\n   151\t\t\t\t\tb.SeverityHistogram[sev]++\r\n   152\t\t\t\t}\r\n   153\t\t\t}\r\n   154\t\t\tif actors, ok := getStringSlice(threat, \"threat_actors\"); ok {\r\n"]
[7295.841846, "o", "   155\t\t\t\tfor _, actor := range actors {\r\n   156\t\t\t\t\tif actor != \"\" {\r\n   157\t\t\t\t\t\tactorSet[actor] = true\r\n   158\t\t\t\t\t}\r\n   159\t\t\t\t}\r\n   160\t\t\t}\r\n   161\t\t}\r\n   162\t\tb.AvgRisk = round2(sumRisk / float64(n))\r\n   163\t\tb.MaxRisk = maxRisk\r\n"]
[7295.841908, "o", "   164\t\tb.MinRisk = minRisk\r\n   165\t\r\n   166\t\tmean := sumRisk / float64(n)\r\n   167\t\tvar variance float64\r\n   168\t\tfor _, risk := range risks {\r\n   169\t\t\tdiff := risk - mean\r\n   170\t\t\tvariance += diff * diff\r\n   171\t\t}\r\n   172\t\tif n == 1 {\r\n"]
[7295.841971, "o", "   173\t\t\tvariance = 0.0\r\n   174\t\t} else {\r\n   175\t\t\tvariance /= float64(n)\r\n   176\t\t}\r\n   177\t\tb.RiskStdDev = round2(math.Sqrt(variance))\r\n   178\t\r\n   179\t\tb.DominantType = dominantThreatType(threats, typeCounts)\r\n   180\t\tb.TypeDistribution = typeCounts\r\n"]
[7295.842014, "o", "   181\t\r\n   182\t\tb.UniqueActors = nonNilStrings(sortedUniqueStringsFromSet(actorSet))\r\n   183\t\r\n   184\t\tb.EscalationIndex = round3(timelineEscalationIndex(threats))\r\n   185\t\tb.RiskTrend = round3(timelineRiskTrend(threats, startTime))\r\n   186\t\tb.BurstScore = round3(timelineBurstScore(threats))\r\n"]
[7295.842098, "o", "   187\t\r\n   188\t\tsortedTop := make([]map[string]interface{}, len(threats))\r\n   189\t\tcopy(sortedTop, threats)\r\n   190\t\tsort.SliceStable(sortedTop, func(i, j int) bool {\r\n   191\t\t\tri, _ := getFloat(sortedTop[i], \"enriched_risk_score\")\r\n   192\t\t\trj, _ := getFloat(sortedTop[j], \"enriched_risk_score\")\r\n   193\t\t\tif ri != rj {\r\n   194\t\t\t\treturn ri > rj\r\n   195\t\t\t}\r\n   196\t\t\tti, tj := threatSortTime(sortedTop[i]), threatSortTime(sortedTop[j])\r\n   197\t\t\tif !ti.Equal(tj) {\r\n   198\t\t\t\treturn ti.Before(tj)\r\n"]
[7295.842162, "o", "   199\t\t\t}\r\n   200\t\t\ttta, _ := getString(sortedTop[i], \"threat_type\")\r\n   201\t\t\tttb, _ := getString(sortedTop[j], \"threat_type\")\r\n   202\t\t\treturn tta < ttb\r\n   203\t\t})\r\n   204\t\tif topN < len(sortedTop) {\r\n"]
[7295.842302, "o", "   205\t\t\tsortedTop = sortedTop[:topN]\r\n   206\t\t}\r\n   207\t\tb.TopThreats = sortedTop\r\n   208\t\r\n   209\t\treturn b\r\n   210\t}\r\n   211\t\r\n   212\tfunc dominantThreatType(threats []map[string]interface{}, counts map[string]int) string {\r\n   213\t\tvar keys []string\r\n   214"]
[7295.842367, "o", "\t\tfor k := range counts {\r\n   215\t\t\tkeys = append(keys, k)\r\n   216\t\t}\r\n   217\t\tsort.Strings(keys)\r\n   218\t\r\n   219\t\tsumRisk := make(map[string]float64)\r\n   220\t\ttypeNum := make(map[string]int)\r\n"]
