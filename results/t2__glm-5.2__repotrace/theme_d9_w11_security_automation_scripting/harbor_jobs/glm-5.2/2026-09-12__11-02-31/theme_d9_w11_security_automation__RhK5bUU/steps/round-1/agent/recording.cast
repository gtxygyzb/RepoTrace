[4826.493313, "o", "   293\t\t\t\t\tif t.Sub(start) <= 300*time.Second {\r\n   294\t\t\t\t\t\twindow = append(window, evs[j])\r\n   295\t\t\t\t\t} else {\r\n   296\t\t\t\t\t\tbreak\r\n   297\t\t\t\t\t}\r\n   298\t\t\t\t}\r\n   299\t\t\t\tports := make([]int, 0, len(window))\r\n   300\t\t\t\tfor _, e := range window {\r\n"]
