[12291.099933, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"flag\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t)\r\n     8\t\r\n"]
[12291.10003, "o", "     9\tfunc main() {\r\n    10\t\tif len(os.Args) < 2 {\r\n    11\t\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|track|diff|anomaly|forecast|rate|histogram|compliance> [flags]\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\r\n    15\t\tvar code int\r\n    16\t\tswitch os.Args[1] {\r\n    17\t\tcase \"prioritize\":\r\n    18\t\t\tcode = runPrioritize(os.Args[2:])\r\n    19\t\tcase \"analyze\":\r\n    20\t\t\tcode = runAnalyze(os.Args[2:])\r\n"]
[12291.10011, "o", "    21\t\tcase \"summarize\":\r\n    22\t\t\tcode = runSummarize(os.Args[2:])\r\n    23\t\tcase \"filter\":\r\n    24\t\t\tcode = runFilter(os.Args[2:])\r\n    25\t\tcase \"respond\":\r\n    26\t\t\tcode = runRespond(os.Args[2:])\r\n    27\t\tcase \"enrich\":\r\n    28\t\t\tcode = runEnrich(os.Args[2:])\r\n    29\t\tcase \"correlate\":\r\n    30\t\t\tcode = runCorrelate(os.Args[2:])\r\n    31\t\tcase \"timeline\":\r\n"]
[12291.100177, "o", "    32\t\t\tcode = runTimeline(os.Args[2:])\r\n    33\t\tcase \"snapshot\":\r\n    34\t\t\tcode = runSnapshot(os.Args[2:])\r\n    35\t\tcase \"alert\":\r\n    36\t\t\tcode = runAlert(os.Args[2:])\r\n    37\t\tcase \"aggregate\":\r\n    38\t\t\tcode = runAggregate(os.Args[2:])\r\n    39\t\tcase \"diff\":\r\n    40\t\t\tcode = runDiff(os.Args[2:])\r\n    41\t\tcase \"anomaly\":\r\n    42\t\t"]
[12291.100281, "o", "\tcode = runAnomaly(os.Args[2:])\r\n    43\t\tcase \"track\":\r\n    44\t\t\tcode = runTrack(os.Args[2:])\r\n    45\t\tcase \"forecast\":\r\n    46\t\t\tcode = runForecast(os.Args[2:])\r\n    47\t\tcase \"histogram\":\r\n    48\t\t\tcode = runHistogram(os.Args[2:])\r\n    49\t\tcase \"compliance\":\r\n    50\t\t\tcode = runCompliance(os.Args[2:])\r\n"]
[12291.100314, "o", "    51\t\tdefault:\r\n    52\t\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n    53\t\t\tcode = 1\r\n    54\t\t}\r\n    55\t\tos.Exit(code)\r\n    56\t}\r\n"]
[12291.100534, "o", "    57\t\r\n    58\tfunc newFlagSet(name string) *flag.FlagSet {\r\n    59\t\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n    60\t\tfs.SetOutput(os.Stderr)\r\n    61\t\tfs.Usage = func() {}\r\n    62\t\treturn fs\r\n    63\t}\r\n    64\t\r\n    65\tfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n    66\t\tif err := fs.Parse(args); err != nil {\r\n    67\t\t\treturn false\r\n    68\t\t}\r\n    69\t\treturn true\r\n    70\t}\r\n"]
