[714.508669, "o", "        SourceIP       string   `json:\"source_ip\"`\r\n\u001b[?2004l\r"]
[714.508741, "o", "\u001b[?2004h> "]
[714.509076, "o", "        Stages         []string `json:\"stages\"`\r\n\u001b[?2004l\r"]
[714.509169, "o", "\u001b[?2004h> "]
[714.509552, "o", "        TotalRiskScore float64  `json:\"total_risk_score\"`\r\n\u001b[?2004l\r"]
[714.509639, "o", "\u001b[?2004h> "]
[714.509969, "o", "        FirstSeen      string   `json:\"first_seen\"`\r\n\u001b[?2004l\r"]
[714.510041, "o", "\u001b[?2004h> "]
[714.510391, "o", "        LastSeen       string   `json:\"last_seen\"`\r\n\u001b[?2004l\r"]
[714.510478, "o", "\u001b[?2004h>     }{"]
[714.510505, "o", "\r\n\u001b[?2004l\r"]
[714.510598, "o", "\u001b[?2004h> "]
[714.510835, "o", "        ChainType:      c.ChainType,\r\n\u001b[?2004l\r"]
[714.510924, "o", "\u001b[?2004h> "]
[714.511142, "o", "        SourceIP:       c.SourceIP,\r\n\u001b[?2004l\r"]
[714.511221, "o", "\u001b[?2004h> "]
[714.511552, "o", "        Stages:         nonNilStrings(c.Stages),\r\n\u001b[?2004l\r"]
[714.511627, "o", "\u001b[?2004h> "]
[714.511901, "o", "        TotalRiskScore: c.TotalRiskScore,\r\n\u001b[?2004l\r"]
[714.511986, "o", "\u001b[?2004h> "]
[714.512219, "o", "        FirstSeen:      c.FirstSeen,\r\n\u001b[?2004l\r"]
[714.512311, "o", "\u001b[?2004h> "]
[714.512529, "o", "        LastSeen:       c.LastSeen,\r\n\u001b[?2004l\r"]
[714.512599, "o", "\u001b[?2004h"]
[714.512674, "o", ">     })\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.512759, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[714.512842, "o", "k"]
[714.512911, "o", "\u001b[?2004h> "]
[714.513149, "o", "func detectChains(threats []Threat) []Chain {\r\n\u001b[?2004l\r"]
[714.513237, "o", "\u001b[?2004h> "]
[714.513485, "o", "    byIP := make(map[string][]Threat)\r\n\u001b[?2004l\r"]
[714.513558, "o", "\u001b[?2004h> "]
[714.513763, "o", "    for _, t := range threats {\r\n\u001b[?2004l\r"]
[714.513893, "o", "\u001b[?2004h> "]
[714.514207, "o", "        byIP[t.SourceIP] = append(byIP[t.SourceIP], t)\r\n\u001b[?2004l\r"]
[714.514288, "o", "\u001b[?2004h> "]
[714.51435, "o", "    }\r\n\u001b[?2004l\r"]
[714.514414, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[714.514469, "o", "\u001b[?2004h> "]
[714.514562, "o", "    var chains []Chain\r\n\u001b[?2004l\r"]
[714.51463, "o", "\u001b[?2004h> "]
[714.514796, "o", "    for ip, ts := range byIP {\r\n\u001b[?2004l\r"]
[714.514862, "o", "\u001b[?2004h> "]
[714.51525, "o", "        chains = append(chains, detectReconExploitExfil(ip, ts)...)\r\n\u001b[?2004l\r"]
[714.515322, "o", "\u001b[?2004h> "]
[714.51569, "o", "        chains = append(chains, detectCredentialLateral(ip, ts)...)\r\n\u001b[?2004l\r"]
[714.515767, "o", "\u001b[?2004h"]
[714.515801, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.515909, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.51602, "o", "    sortChains(chains)\r\n\u001b[?2004l\r"]
[714.516092, "o", "\u001b[?2004h> "]
[714.516179, "o", "    return chains\r\n\u001b[?2004l\r"]
[714.516255, "o", "\u001b[?2004h"]
[714.516321, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[714.516387, "o", "\u001b[?2004h> "]
[714.516754, "o", "func detectReconExploitExfil(ip string, threats []Threat) []Chain {\r\n\u001b[?2004l\r"]
[714.516825, "o", "\u001b[?2004h> "]
[714.516966, "o", "    var portScans []Threat\r\n\u001b[?2004l\r"]
[714.517034, "o", "\u001b[?2004h> "]
[714.51717, "o", "    var exploits []Threat\r\n\u001b[?2004l\r"]
[714.51725, "o", "\u001b[?2004h"]
[714.517318, "o", "> "]
[714.517397, "o", "    var exfils []Threat\r\n\u001b[?2004l\r"]
[714.517462, "o", "\u001b[?2004h> "]
[714.517617, "o", "    for _, t := range threats {\r\n\u001b[?2004l\r"]
[714.517689, "o", "\u001b[?2004h> "]
[714.517842, "o", "        switch t.ThreatType {\r\n\u001b[?2004l\r"]
[714.517916, "o", "\u001b[?2004h> "]
[714.518044, "o", "        case \"port_scan\":\r\n\u001b[?2004l\r"]
[714.518117, "o", "\u001b[?2004h> "]
[714.518345, "o", "            portScans = append(portScans, t)\r\n\u001b[?2004l\r"]
[714.518416, "o", "\u001b[?2004h> "]
[714.518601, "o", "        case \"brute_force\", \"privilege_escalation\":\r\n\u001b[?2004l\r"]
[714.518671, "o", "\u001b[?2004h> "]
[714.518819, "o", "            exploits = append(exploits, t)\r\n\u001b[?2004l\r"]
[714.518888, "o", "\u001b[?2004h> "]
[714.519, "o", "        case \"data_exfiltration\":\r\n\u001b[?2004l\r"]
[714.519065, "o", "\u001b[?2004h> "]
[714.5192, "o", "            exfils = append(exfils, t)\r\n\u001b[?2004l\r"]
[714.519278, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[714.519362, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[714.519424, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[714.51948, "o", "\u001b[?2004h> "]
[714.519598, "o", "    sortThreatsByFirstSeen(portScans)\r\n\u001b[?2004l\r"]
[714.519663, "o", "\u001b[?2004h> "]
[714.519791, "o", "    sortThreatsByFirstSeen(exploits)\r\n\u001b[?2004l\r"]
[714.519853, "o", "\u001b[?2004h> "]
[714.519973, "o", "    sortThreatsByFirstSeen(exfils)\r\n\u001b[?2004l\r"]
[714.520056, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.5202, "o", "    for _, ps := range portScans {\r\n\u001b[?2004l\r"]
[714.520284, "o", "\u001b[?2004h> "]
[714.520407, "o", "        for _, ex := range exploits {\r\n\u001b[?2004l\r"]
[714.520469, "o", "\u001b[?2004h"]
[714.520526, "o", "> "]
[714.520659, "o", "            if !ex.firstTime.After(ps.firstTime) {\r\n\u001b[?2004l\r"]
[714.520723, "o", "\u001b[?2004h> "]
[714.520805, "o", "                continue\r\n\u001b[?2004l\r"]
[714.520872, "o", "\u001b[?2004h"]
[714.520954, "o", ">             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.521107, "o", "            for _, ef := range exfils {\r\n\u001b[?2004l\r"]
[714.521174, "o", "\u001b[?2004h"]
[714.521255, "o", "> "]
[714.521384, "o", "                if !ef.firstTime.After(ex.firstTime) {\r\n\u001b[?2004l\r"]
[714.52145, "o", "\u001b[?2004h> "]
[714.521547, "o", "                    continue\r\n\u001b[?2004l\r"]
[714.521581, "o", "\u001b[?2004h> "]
[714.521661, "o", "                }\r\n\u001b[?2004l\r"]
[714.521727, "o", "\u001b[?2004h> "]
[714.522027, "o", "                stages := []string{ps.ThreatType, ex.ThreatType, ef.ThreatType}\r\n\u001b[?2004l\r"]
[714.522089, "o", "\u001b[?2004h> "]
[714.522226, "o", "                first := ps.firstTime\r\n\u001b[?2004l\r"]
[714.522297, "o", "\u001b[?2004h> "]
[714.522422, "o", "                last := ps.lastTime\r\n\u001b[?2004l\r"]
[714.522487, "o", "\u001b[?2004h> "]
[714.522659, "o", "                if ex.firstTime.Before(first) {\r\n\u001b[?2004l\r"]
[714.522724, "o", "\u001b[?2004h> "]
[714.522866, "o", "                    first = ex.firstTime\r\n\u001b[?2004l\r"]
[714.522928, "o", "\u001b[?2004h> "]
[714.523, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.523065, "o", "> "]
[714.523223, "o", "                if ef.firstTime.Before(first) {\r\n\u001b[?2004l\r"]
[714.52329, "o", "\u001b[?2004h> "]
[714.523435, "o", "                    first = ef.firstTime\r\n\u001b[?2004l\r"]
[714.523505, "o", "\u001b[?2004h> "]
[714.523594, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.523773, "o", "                if ex.lastTime.After(last) {\r\n\u001b[?2004l\r"]
[714.523838, "o", "\u001b[?2004h> "]
[714.523975, "o", "                    last = ex.lastTime\r\n\u001b[?2004l\r"]
[714.524036, "o", "\u001b[?2004h"]
[714.524092, "o", ">                 }\r\n\u001b[?2004l\r"]
[714.524155, "o", "\u001b[?2004h> "]
[714.524327, "o", "                if ef.lastTime.After(last) {\r\n\u001b[?2004l\r"]
[714.524396, "o", "\u001b[?2004h> "]
[714.524524, "o", "                    last = ef.lastTime\r\n\u001b[?2004l\r"]
[714.524591, "o", "\u001b[?2004h> "]
[714.524659, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.524715, "o", "> "]
[714.524817, "o", "                return []Chain{{\r\n\u001b[?2004l\r"]
[714.524889, "o", "\u001b[?2004h> "]
[714.5251, "o", "                    ChainType:      \"recon_exploit_exfil\",\r\n\u001b[?2004l\r"]
[714.525162, "o", "\u001b[?2004h> "]
[714.525325, "o", "                    SourceIP:       ip,\r\n\u001b[?2004l\r"]
[714.525395, "o", "\u001b[?2004h> "]
[714.525548, "o", "                    Stages:         stages,\r\n\u001b[?2004l\r"]
[714.52563, "o", "\u001b[?2004h> "]
[714.525912, "o", "                    TotalRiskScore: ps.RiskScore + ex.RiskScore + ef.RiskScore,\r\n\u001b[?2004l\r"]
[714.525996, "o", "\u001b[?2004h> "]
[714.526219, "o", "                    FirstSeen:      first.Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[714.526312, "o", "\u001b[?2004h"]
[714.526407, "o", "> "]
[714.526521, "o", "                    LastSeen:       last.Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[714.526601, "o", "\u001b[?2004h> "]
[714.526738, "o", "                    firstTime:      first,\r\n\u001b[?2004l\r"]
[714.526828, "o", "\u001b[?2004h> "]
[714.52695, "o", "                    lastTime:       last,\r\n\u001b[?2004l\r"]
[714.527038, "o", "\u001b[?2004h> "]
[714.527127, "o", "                }}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.52722, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.527331, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[714.527358, "o", "\u001b[?2004h> "]
[714.527436, "o", "    return nil\r\n\u001b[?2004l\r"]
[714.527521, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[714.527613, "o", "\u001b[?2004h> "]
[714.527836, "o", "func detectCredentialLateral(ip string, threats []Threat) []Chain {\r\n\u001b[?2004l\r"]
[714.527918, "o", "\u001b[?2004h> "]
[714.527998, "o", "    var brute []Threat\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.528118, "o", "    var lateral []Threat\r\n\u001b[?2004l\r"]
[714.528188, "o", "\u001b[?2004h"]
[714.528264, "o", "> "]
[714.528366, "o", "    for _, t := range threats {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.528472, "o", "        switch t.ThreatType {\r\n\u001b[?2004l\r"]
[714.528561, "o", "\u001b[?2004h> "]
[714.528655, "o", "        case \"brute_force\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.528724, "o", "            brute = append(brute, t)\r\n\u001b[?2004l\r"]
[714.528782, "o", "\u001b[?2004h> "]
[714.528843, "o", "        case \"lateral_movement\":\r\n\u001b[?2004l\r"]
[714.528956, "o", "\u001b[?2004h> "]
[714.529044, "o", "            lateral = append(lateral, t)\r\n\u001b[?2004l\r"]
[714.529132, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[714.529188, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.529287, "o", "    sortThreatsByFirstSeen(brute)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.529356, "o", "    sortThreatsByFirstSeen(lateral)\r\n\u001b[?2004l\r"]
[714.529426, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[714.52951, "o", "\u001b[?2004h>     for _, b := range brute {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.529622, "o", "        for _, l := range lateral {\r\n\u001b[?2004l\r"]
[714.529676, "o", "\u001b[?2004h> "]
[714.529779, "o", "            if !l.firstTime.After(b.firstTime) {\r\n\u001b[?2004l\r"]
[714.529845, "o", "\u001b[?2004h> "]
[714.529909, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.529979, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.530123, "o", "            stages := []string{b.ThreatType, l.ThreatType}\r\n\u001b[?2004l\r"]
[714.530176, "o", "\u001b[?2004h> "]
[714.530246, "o", "            first := b.firstTime\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.530307, "o", "> "]
[714.53039, "o", "            last := b.lastTime\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.530499, "o", "            if l.firstTime.Before(first) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.530564, "o", "> "]
[714.530643, "o", "                first = l.firstTime\r\n\u001b[?2004l\r"]
[714.530707, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.530816, "o", "            if l.lastTime.After(last) {\r\n\u001b[?2004l\r"]
[714.530879, "o", "\u001b[?2004h> "]
[714.530967, "o", "                last = l.lastTime\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.531029, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.531106, "o", "            return []Chain{{\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.53116, "o", "> "]
[714.531279, "o", "                ChainType:      \"credential_lateral\",\r\n\u001b[?2004l\r"]
[714.531335, "o", "\u001b[?2004h> "]
[714.531404, "o", "                SourceIP:       ip,\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.531458, "o", "> "]
[714.531536, "o", "                Stages:         stages,\r\n\u001b[?2004l\r"]
[714.53159, "o", "\u001b[?2004h> "]
[714.531719, "o", "                TotalRiskScore: b.RiskScore + l.RiskScore,\r\n\u001b[?2004l\r"]
[714.531774, "o", "\u001b[?2004h> "]
[714.531906, "o", "                FirstSeen:      first.Format(time.RFC3339),\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.531966, "o", "> "]
[714.532088, "o", "                LastSeen:       last.Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[714.532143, "o", "\u001b[?2004h> "]
[714.532225, "o", "                firstTime:      first,\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.532282, "o", "> "]
[714.532353, "o", "                lastTime:       last,\r\n\u001b[?2004l\r"]
[714.532408, "o", "\u001b[?2004h>             }}\r\n\u001b[?2004l\r"]
[714.532493, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.532562, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.53265, "o", ">     return nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[714.532713, "o", "\u001b[?2004h> "]
[714.532809, "o", "func sortThreatsByFirstSeen(threats []Threat) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.532871, "o", "> "]
[714.532973, "o", "    sort.SliceStable(threats, func(i, j int) bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.533037, "o", "> "]
[714.533172, "o", "        return threats[i].firstTime.Before(threats[j].firstTime)\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.53328, "o", ">     })\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[714.533341, "o", "\u001b[?2004h> "]
[714.533402, "o", "func sortChains(chains []Chain) {\r\n\u001b[?2004l\r"]
[714.533462, "o", "\u001b[?2004h> "]
[714.533564, "o", "    sort.SliceStable(chains, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[714.533619, "o", "\u001b[?2004h> "]
[714.533767, "o", "        if chains[i].TotalRiskScore != chains[j].TotalRiskScore {\r\n\u001b[?2004l\r"]
[714.533827, "o", "\u001b[?2004h> "]
[714.533986, "o", "            return chains[i].TotalRiskScore > chains[j].TotalRiskScore\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.534055, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[714.534249, "o", "        return chains[i].firstTime.Before(chains[j].firstTime)\r\n\u001b[?2004l\r\u001b[?2004h"]
[714.534332, "o", "> "]
[714.534395, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
