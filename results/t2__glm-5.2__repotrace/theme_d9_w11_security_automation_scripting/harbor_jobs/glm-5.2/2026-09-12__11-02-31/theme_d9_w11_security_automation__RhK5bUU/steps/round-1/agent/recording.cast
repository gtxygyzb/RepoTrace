[2308.893964, "i", "\n\nfunc freshnessFactor(fraction float64) float64 {\n\tswitch {\n\tcase fraction < 0.25:\n\t\treturn 1.0\n\tcase fraction < 0.50:\n\t\treturn 0.9\n\tcase fraction < 0.75:\n\t\treturn 0.7\n\tdefault:\n\t\treturn 0.5\n\t}\n}\n\nfunc fieldMultiplier(field string) float64 {\n\tswitch field {\n\tcase \"source_ip\", \"dest_ip\", \"compromised_hosts\", \"user\":\n\t\treturn 1.0\n\tcase \"dest_ips\", \"target_users\":\n\t\treturn 0.8\n\tcase \"ports_scanned\":\n\t\treturn 0.6\n\tdefault:\n\t\treturn 0.0\n\t}\n}\n\nfunc maxFieldMultiplier(fields []string) float64 {\n\tmax := 0.0\n\tfor _, f := range fields {\n\t\tif m := fieldMultiplier(f); m > max {\n\t\t\tmax = m\n\t\t}\n\t}\n\treturn max\n}\n\nfunc tagBonusValue(tag string) float64 {\n\tswitch tag {\n\tcase \"apt\":\n\t\treturn 100.0\n\tcase \"ransomware\":\n\t\treturn 75.0\n\tcase \"botnet\":\n\t\treturn 50.0\n\tcase \"phishing\":\n\t\treturn 30.0\n\tcase \"scanner\":\n\t\treturn 25.0\n\tcase \"cryptominer\":\n\t\treturn 20.0\n\tdefault:\n\t\treturn 0.0\n\t}\n}\n\nfunc severityWeight(s string) int {\n\tswitch s {\n\tcase \"low\":\n\t\treturn 5\n\tcase \"medium\":\n\t\treturn 10\n\tcase \"high\":\n\t\treturn 20\n\tcase \"critical\":"]
