[10480.514429, "o", "\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tMetrics      map[string]forecastMetricResult `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"metrics\"`\r\n\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tOverallTrend string                          `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"overall_trend\"`\r\n\u001b[35m\u001b[Kforecast.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tAlertLevel   string                          `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"alert_level\"`\r\n"]
