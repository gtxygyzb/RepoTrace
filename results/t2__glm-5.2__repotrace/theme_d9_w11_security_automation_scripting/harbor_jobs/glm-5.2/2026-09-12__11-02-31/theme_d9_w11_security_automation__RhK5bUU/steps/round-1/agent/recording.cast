[8574.48189, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('main.go')\ns = p.read_text()\ns = s.replace('aggregate|prioritize|diff', 'aggregate|prioritize|track|diff')\ns = s.replace('\\tcase \"diff\":\\n\\t\\tcode = runDiff(os.Args[2:])\\n', '\\tcase \"diff\":\\n\\t\\tcode = runDiff(os.Args[2:])\\n\\tcase \"track\":\\n\\t\\tcode = runTrack(os.Args[2:])\\n')\np.write_text(s)\nPY\n"]
[8574.482119, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[8574.482209, "o", "\u001b[?2004h> "]
[8574.482404, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[8574.482483, "o", "\u001b[?2004h> "]
