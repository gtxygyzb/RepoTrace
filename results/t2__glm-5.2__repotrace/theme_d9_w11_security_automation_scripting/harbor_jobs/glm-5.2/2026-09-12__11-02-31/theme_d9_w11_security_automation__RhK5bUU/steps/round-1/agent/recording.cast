[11600.090834, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"io\"\r\n     8"]
[11600.090908, "o", "\t\t\"math\"\r\n     9\t\t\"os\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t)\r\n    14\t\r\n    15\ttype anomalyInputSnapshot struct {\r\n    16\t\tGlobalMeanRisk float64 `json:\"global_mean_risk\"`\r\n    17\t\tTotalThreats   int     `json:\"total_threats\"`\r\n    18\t}\r\n"]
[11600.09098, "o", "    19\t\r\n    20\ttype anomalyMetricResult struct {\r\n    21\t\tValue          json.Number `json:\"value\"`\r\n    22\t\tBaselineMean   json.Number `json:\"baseline_mean\"`\r\n    23\t\tBaselineStddev json.Number `json:\"baseline_stddev\"`\r\n    24\t\tZScore         json.Number `json:\"z_score\"`\r\n    25\t}\r\n    26\t\r\n    27\ttype anomalyMetrics struct {\r\n    28\t\tGlobalMeanRisk anomalyMetricResult `json:\"global_mean_risk\"`\r\n    29\t\tTotalThreats   anomalyMetricResult `json:\"total_threats\"`\r\n"]
[11600.091048, "o", "    30\t}\r\n    31\t\r\n    32\ttype anomalyRecord struct {\r\n    33\t\tIndex         int            `json:\"index\"`\r\n    34\t\tMetrics       anomalyMetrics `json:\"metrics\"`\r\n    35\t\tCombinedZ     json.Number    `json:\"combined_z\"`\r\n    36\t\tBaselineCount int            `json:\"baseline_count\"`\r\n    37\t\tDirection     string         `json:\"direction\"`\r\n    38\t\tSeverity      string         `json:\"severity\"`\r\n    39\t\r\n    40\t\t"]
[11600.091111, "o", "roundedCombinedZ float64\r\n    41\t}\r\n    42\t\r\n    43\tfunc runAnomaly(args []string) int {\r\n    44\t\tfs := newFlagSet(\"anomaly\")\r\n    45\t\twindow := fs.Int(\"window\", 5, \"baseline window size\")\r\n    46\t\tthreshold := fs.Float64(\"threshold\", 2.0, \"combined z-score anomaly threshold\")\r\n    47\t\tif !parseFlags(fs, args) {\r\n    48\t\t\treturn 1\r\n    49\t\t}\r\n    50\t\r\n"]
[11600.09117, "o", "    51\t\tif *window < 2 {\r\n    52\t\t\tfmt.Fprintln(os.Stderr, \"error: --window must be at least 2\")\r\n    53\t\t\treturn 1\r\n    54\t\t}\r\n    55\t\r\n    56\t\tvar snapshots []anomalyInputSnapshot\r\n    57\t\treader := bufio.NewReader(os.Stdin)\r\n"]
[11600.091268, "o", "    58\t\tfor {\r\n    59\t\t\tline, err := reader.ReadString('\\n')\r\n    60\t\t\ttrimmed := strings.TrimSpace(line)\r\n    61\t\t\tif trimmed == \"\" {\r\n    62\t\t\t\tif err == io.EOF {\r\n    63\t\t\t\t\tbreak\r\n    64\t\t\t\t}\r\n    65\t\t\t\tcontinue\r\n    66\t\t\t}\r\n    67\t\r\n    68\t\t\tvar snap anomalyInputSnapshot\r\n    69\t\t\t"]
[11600.09134, "o", "if jerr := json.Unmarshal([]byte(trimmed), &snap); jerr != nil {\r\n    70\t\t\t\tfmt.Fprintln(os.Stderr, \"error: malformed JSON input:\", jerr)\r\n    71\t\t\t\treturn 2\r\n    72\t\t\t}\r\n    73\t\t\tsnapshots = append(snapshots, snap)\r\n    74\t\r\n    75\t\t\tif err == io.EOF {\r\n    76\t\t\t\tbreak\r\n    77\t\t\t}\r\n    78\t\t}\r\n    79\t"]
[11600.091396, "o", "\r\n    80\t\tif len(snapshots) < 3 {\r\n    81\t\t\tfmt.Fprintln(os.Stderr, \"error: requires at least 3 valid JSON lines on stdin\")\r\n    82\t\t\treturn 1\r\n    83\t\t}\r\n    84\t\r\n    85\t\trisks := make([]float64, len(snapshots))\r\n"]
[11600.091459, "o", "    86\t\tthreats := make([]float64, len(snapshots))\r\n    87\t\tfor i, snap := range snapshots {\r\n    88\t\t\trisks[i] = snap.GlobalMeanRisk\r\n    89\t\t\tthreats[i] = float64(snap.TotalThreats)\r\n    90\t\t}\r\n    91\t\r\n    92\t\tvar anomalies []anomalyRecord\r\n    93\t\tfor i := 0; i < len(snapshots); i++ {\r\n    94\t\t\tstart := i - *window\r\n"]
[11600.091519, "o", "    95\t\t\tif start < 0 {\r\n    96\t\t\t\tstart = 0\r\n    97\t\t\t}\r\n    98\t\t\tbaselineCount := i - start\r\n    99\t\t\tif baselineCount < 2 {\r\n   100\t\t\t\tcontinue\r\n   101\t\t\t}\r\n   102\t\r\n"]
[11600.091591, "o", "   103\t\t\triskMean, riskStd := baselineStats(risks[start:i])\r\n   104\t\t\tthreatMean, threatStd := baselineStats(threats[start:i])\r\n   105\t\r\n   106\t\t\triskZ := zScore(risks[i], riskMean, riskStd)\r\n   107\t\t\tthreatZ := zScore(threats[i], threatMean, threatStd)\r\n   108\t\t\tcombinedZ := math.Sqrt(riskZ*riskZ + threatZ*threatZ)\r\n   109\t\t\troundedCombinedZ := roundHalfUp4(combinedZ)\r\n   110\t\r\n   111\t\t\tif combinedZ < *threshold {\r\n   112\t\t\t\t"]
[11600.091647, "o", "continue\r\n   113\t\t\t}\r\n   114\t\r\n   115\t\t\tdirection := \"mixed\"\r\n   116\t\t\tif riskZ >= 0 && threatZ >= 0 {\r\n   117\t\t\t\tdirection = \"above\"\r\n   118\t\t\t} else if riskZ <= 0 && threatZ <= 0 {\r\n   119\t\t\t\tdirection = \"below\"\r\n   120\t\t\t}\r\n"]
