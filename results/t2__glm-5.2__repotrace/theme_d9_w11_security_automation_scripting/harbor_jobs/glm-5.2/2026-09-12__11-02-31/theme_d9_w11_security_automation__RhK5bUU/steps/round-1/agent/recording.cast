[1848.155656, "o", "package main\r\n\r\nimport (\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n)"]
[1848.155749, "o", "\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond> [flags]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar code int\r\n\tswitch os.Args[1] {\r\n\tcase \"analyze\":\r\n\t\tcode = runAnalyze(os.Args[2:])\r\n\tcase \"summarize\":\r\n\t\tcode = runSummarize(os.Args[2:])\r\n\tcase \"filter\":\r\n"]
[1848.155833, "o", "\t\tcode = runFilter(os.Args[2:])\r\n\tcase \"respond\":\r\n\t\tcode = runRespond(os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n\t\tcode = 1\r\n\t}\r\n\tos.Exit(code)\r\n}\r\n\r\nfunc newFlagSet(name string) *flag.FlagSet {\r\n\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tfs.Usage = func() {}\r\n\treturn fs\r\n}\r\n\r\n"]
[1848.155906, "o", "func parseFlags(fs *flag.FlagSet, args []string) bool {\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn false\r\n\t}\r\n\treturn true\r\n}\r\n\r\n"]
[1848.155965, "o", "func isFlagSet(fs *flag.FlagSet, name string) bool {\r\n\tset := false\r\n\tfs.Visit(func(f *flag.Flag) {\r\n\t\tif f.Name == name {\r\n\t\t\tset = true\r\n\t\t}\r\n\t})\r\n\treturn set\r\n}\r\n"]
[1848.156468, "o", "\u001b[?2004h"]
[1848.156546, "o", "root@n30009:/app# "]
