[8471.892179, "o", "\tRiskScore        float64\r\n    18\t\tPortsScanned     []int\r\n    19\t\tTotalBytes       int64\r\n    20\t\tDestIPs          []string\r\n    21\t\tUser             string\r\n    22\t\tTimestamp        string\r\n    23\t\tPriorFailures    int\r\n    24\t\tCompromisedHosts []string\r\n    25\t\tQueryCount       int\r\n    26\t\tAvgPayload       float64\r\n    27\t\r\n    28\t\tfirstTime time.Time\r\n    29\t\tlastTime  time.Time\r\n    30\t}\r\n    31\t\r\n    32\tfunc (t Threat) MarshalJSON() ([]byte, error) {\r\n    33\t\tswitch t.ThreatType {\r\n    34\t\tcase \"brute_force\":\r\n    35\t\t\treturn json.Marshal(struct {\r\n    36\t\t\t\tThreatType  string   `json:\"threat_type\"`\r\n    37\t\t\t"]
