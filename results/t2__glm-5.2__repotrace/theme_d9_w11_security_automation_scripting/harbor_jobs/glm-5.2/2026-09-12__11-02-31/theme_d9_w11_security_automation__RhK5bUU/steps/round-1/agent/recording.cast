[5270.80783, "i", "python3 - << 'PYEOF'\nimport sys\n\n# Patch timeline.go\nwith open('timeline.go', 'r') as f:\n    lines = f.readlines()\n\nstart_idx = None\nfor i, line in enumerate(lines):\n    if line.startswith('func dominantThreatType('):\n        start_idx = i\n        break\n\nif start_idx is None:\n    print('ERROR: Could not find dominantThreatType function')\n    sys.exit(1)\n\nend_idx = None\nfor i in range(start_idx + 1, len(lines)):\n    if lines[i] == '}\\n':\n        end_idx = i\n        break\n\nif end_idx is None:\n    print('ERROR: Could not find end of dominantThreatType function')\n    sys.exit(1)\n\nnew_func = \"\"\"func dominantThreatType(threats []map[string]interface{}, counts map[string]int) string {\n\\tvar keys []string\n\\tfor k := range counts {\n\\t\\tkeys = append(keys, k)\n\\t}\n\\tsort.Strings(keys)\n\n\\tsumRisk := make(map[string]float64)\n\\ttypeNum := make(map[string]int)\n\\tfor _, threat := range threats {\n\\t\\ttt, ok := getString(threat, \"threat_type\")\n\\t\\tif !ok {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\trisk, _ := getFloat(threat, \"enriched_risk_sco"]
[5270.808084, "i", "re\")\n\\t\\tsumRisk[tt] += risk\n\\t\\ttypeNum[tt]++\n\\t}\n\\tmeanRisk := make(map[string]float64)\n\\tfor k, sum := range sumRisk {\n\\t\\tif c := typeNum[k]; c > 0 {\n\\t\\t\\tmeanRisk[k] = sum / float64(c)\n\\t\\t}\n\\t}\n\n\\tdominant := \"\"\n\\tmaxCount := -1\n\\tmaxMean := 0.0\n\\tfor _, k := range keys {\n\\t\\tc := counts[k]\n\\t\\tmean := meanRisk[k]\n\\t\\tif dominant == \"\" || c > maxCount || (c == maxCount && mean > maxMean) {\n\\t\\t\\tmaxCount = c\n\\t\\t\\tmaxMean = mean\n\\t\\t\\tdominant = k\n\\t\\t}\n\\t}\n\\treturn dominant\n}\n\"\"\"\n\nlines[start_idx:end_idx+1] = [new_func]\n\nfor i, line in enumerate(lines):\n    if 'dominantThreatType(typeCounts)' in line:\n        lines[i] = line.replace('dominantThreatType(typeCounts)', 'dominantThreatType(threats, typeCounts)')\n\nwith open('timeline.go', 'w') as f:\n    f.writelines(lines)\n\n# Patch main.go\nwith open('main.go', 'r') as f:\n    content = f.read()\n\ncontent = content.replace(\n    'secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline> [flags]',\n    'secsentinel <analyze|summarize|filter|respon"]
