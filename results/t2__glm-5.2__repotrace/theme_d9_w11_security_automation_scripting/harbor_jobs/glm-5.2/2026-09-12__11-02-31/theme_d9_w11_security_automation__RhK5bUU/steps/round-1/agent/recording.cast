[4814.465447, "i", "sed -n '1,240p' main.go\n"]
[4814.465709, "o", "sed -n '1,240p' main.go\r\n\u001b[?2004l\r"]
[4814.468681, "o", "package main\r\n\r\nimport (\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[4814.468777, "o", ")\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline> [flags]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar code int\r\n\tswitch os.Args[1] {\r\n\tcase \"analyze\":\r\n\t\tcode = runAnalyze(os.Args[2:])\r\n\tcase \"summarize\":\r\n\t\tcode = runSummarize(os.Args[2:])\r\n\t"]
[4814.468855, "o", "case \"filter\":\r\n\t\tcode = runFilter(os.Args[2:])\r\n\tcase \"respond\":\r\n\t\tcode = runRespond(os.Args[2:])\r\n\tcase \"enrich\":\r\n\t\tcode = runEnrich(os.Args[2:])\r\n"]
[4814.468921, "o", "\tcase \"correlate\":\r\n\t\tcode = runCorrelate(os.Args[2:])\r\n\tcase \"timeline\":\r\n\t\tcode = runTimeline(os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n\t\tcode = 1\r\n\t}\r\n\tos.Exit(code)\r\n}\r\n\r\nfunc newFlagSet(name string) *flag.FlagSet {\r\n\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tfs.Usage = func() {}\r\n\treturn fs\r\n}\r\n\r\n"]
[4814.468983, "o", "func parseFlags(fs *flag.FlagSet, args []string) bool {\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn false\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n\tset := false\r\n\tfs.Visit(func(f *flag.Flag) {\r\n\t\tif f.Name == name {\r\n"]
[4814.469047, "o", "\t\t\tset = true\r\n\t\t}\r\n\t})\r\n\treturn set\r\n}\r\n"]
[4814.469519, "o", "\u001b[?2004h"]
[4814.469581, "o", "root@n30009:/app# "]
[4814.743342, "i", "sed -n '1,260p' timeline.go\n"]
[4814.743608, "o", "sed -n '1,260p' timeline.go\r\n\u001b[?2004l\r"]
[4814.746528, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
[4814.746615, "o", "\t\"os\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\ntype timelineBucket struct {\r\n\tBucketStart       string                   `json:\"bucket_start\"`\r\n\tBucketEnd         string                   `json:\"bucket_end\"`\r\n\tThreatCount       int                      `json:\"threat_count\"`\r\n\tAvgRisk           float64                  `json:\"avg_risk\"`\r\n\tMaxRisk           float64                  `json:\"max_risk\"`\r\n\tMinRisk           float64                  `json:\"min_risk\"`\r\n\tRiskStdDev        float64                  `json:\"risk_std_dev\"`\r\n\tDominantType      string                   `json:\"dominant_type\"`\r\n\tTypeDistribution  map[string]int           `json:\"type_distribution\"`\r\n"]
[4814.746659, "o", "\tUniqueActors      []string                 `json:\"unique_actors\"`\r\n\tSeverityHistogram map[string]int           `json:\"severity_histogram\"`\r\n\tEscalationIndex   float64                  `json:\"escalation_index\"`\r\n\tRiskTrend         float64                  `json:\"risk_trend\"`\r\n\tBurstScore        float64                  `json:\"burst_score\"`\r\n\tTopThreats        []map[string]interface{} `json:\"top_threats\"`\r\n}\r\n\r\n"]
[4814.746751, "o", "func runTimeline(args []string) int {\r\n\tfs := newFlagSet(\"timeline\")\r\n\tbucketMinutes := fs.Int(\"bucket-minutes\", 0, \"width of each time bucket in minutes\")\r\n\ttopN := fs.Int(\"top-n\", 3, \"maximum number of top threats to include per bucket\")\r\n\tif !parseFlags(fs, args) {\r\n\t\treturn 1\r\n\t}\r\n\tif !isFlagSet(fs, \"bucket-minutes\") {\r\n\t\tfmt.Fprintln(os.Stderr, \"missing required flag: --bucket-minutes\")\r\n\t\treturn 1\r\n\t}\r\n\tif *bucketMinutes <= 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid --bucket-minutes: must be a positive integer\\n\")\r\n\t\treturn 1\r\n"]
[4814.74682, "o", "\t}\r\n\tif *topN < 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid --top-n: must be non-negative\\n\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\tlineNo := 0\r\n\tvar threats []map[string]interface{}\r\n"]
[4814.74689, "o", "\tfor scanner.Scan() {\r\n\t\tlineNo++\r\n\t\tline := scanner.Text()\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvar threat map[string]interface{}\r\n\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tthreats = append(threats, threat)\r\n"]
[4814.746957, "o", "\t}\r\n\tif err := scanner.Err(); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error reading input: %v\\n\", err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tbucketSeconds := int64(*bucketMinutes) * 60\r\n\tbuckets := make(map[int64][]map[string]interface{})\r\n\tvar bucketStarts []int64\r\n\tfor _, threat := range threats {\r\n\t\trefTime := threatSortTime(threat)\r\n\t\tvar refUnix int64\r\n\t\tif !refTime.IsZero() {\r\n\t\t\trefUnix = refTime.Unix()\r\n\t\t}\r\n\t\tstart := refUnix - ((refUnix%bucketSeconds)+bucketSeconds)%bucketSeconds\r\n\t\tif _, ok := buckets[start]; !ok {\r\n\t\t\tbucketStarts = append(bucketStarts, start)\r\n\t\t}\r\n"]
[4814.747025, "o", "\t\tbuckets[start] = append(buckets[start], threat)\r\n\t}\r\n\r\n\tsort.Slice(bucketStarts, func(i, j int) bool { return bucketStarts[i] < bucketStarts[j] })\r\n\r\n\twriter := bufio.NewWriter(os.Stdout)\r\n\t"]
[4814.747089, "o", "defer writer.Flush()\r\n\r\n\tfor _, start := range bucketStarts {\r\n\t\tbucketThreats := buckets[start]\r\n\t\tstartTime := time.Unix(start, 0).UTC()\r\n\t\tendTime := startTime.Add(time.Duration(*bucketMinutes) * time.Minute)\r\n\t\tb := buildTimelineBucket(bucketThreats, startTime, endTime, *bucketMinutes, *topN)\r\n\t\tdata, err := json.Marshal(b)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error marshalling bucket: %v\\n\", err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\twriter.Write(data)\r\n\t\twriter.WriteByte('\\n')\r\n\t}"]
[4814.747148, "o", "\r\n\r\n\treturn 0\r\n}\r\n\r\nfunc buildTimelineBucket(threats []map[string]interface{}, startTime time.Time, endTime time.Time, bucketMinutes int, topN int) timelineBucket {\r\n\tn := len(threats)\r\n\tb := timelineBucket{\r\n\t\tBucketStart:       startTime.Format(time.RFC3339),\r\n\t\tBucketEnd:         endTime.Format(time.RFC3339),"]
[4814.747249, "o", "\r\n\t\tThreatCount:       n,\r\n\t\tTypeDistribution:  map[string]int{},\r\n\t\tSeverityHistogram: map[string]int{\"none\": 0, \"low\": 0, \"medium\": 0, \"high\": 0, \"critical\": 0},\r\n\t\tUniqueActors:      []string{},\r\n\t\tTopThreats:        []map[string]interface{}{},\r\n\t}\r\n\r\n\tif n == 0 {\r\n\t\treturn b\r\n\t}\r\n\r\n"]
[4814.747314, "o", "\tvar sumRisk, maxRisk, minRisk float64\r\n\ttypeCounts := map[string]int{}\r\n\tactorSet := map[string]bool{}\r\n\trisks := make([]float64, 0, n)\r\n\tfor i, threat := range threats {\r\n\t\trisk, _ := getFloat(threat, \"enriched_risk_score\")\r\n\t\trisks = append(risks, risk)\r\n\t\tsumRisk += risk\r\n\t\tif i == 0 {\r\n\t\t\tmaxRisk = risk\r\n\t\t\tminRisk = risk\r\n\t\t} else {\r\n"]
[4814.747376, "o", "\t\t\tif risk > maxRisk {\r\n\t\t\t\tmaxRisk = risk\r\n\t\t\t}\r\n\t\t\tif risk < minRisk {\r\n\t\t\t\tminRisk = risk\r\n\t\t\t}\r\n\t\t}\r\n\t\tif tt, ok := getString(threat, \"threat_type\"); ok {\r\n\t\t\ttypeCounts[tt]++\r\n"]
[4814.747438, "o", "\t\t}\r\n\t\tif sev, ok := getString(threat, \"ioc_severity\"); ok {\r\n\t\t\tif _, exists := b.SeverityHistogram[sev]; exists {\r\n\t\t\t\tb.SeverityHistogram[sev]++\r\n\t\t\t}\r\n\t\t}\r\n\t\tif actors, ok := getStringSlice(threat, \"threat_actors\"); ok {\r\n\t\t\tfor _, actor := range actors {\r\n\t\t\t\tif actor != \"\" {\r\n"]
[4814.747498, "o", "\t\t\t\t\tactorSet[actor] = true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tb.AvgRisk = round2(sumRisk / float64(n))\r\n\tb.MaxRisk = maxRisk\r\n\tb.MinRisk = minRisk\r\n\r\n\tmean := sumRisk / float64(n)\r\n"]
[4814.747558, "o", "\tvar variance float64\r\n\tfor _, risk := range risks {\r\n\t\tdiff := risk - mean\r\n\t\tvariance += diff * diff\r\n\t}\r\n\tif n == 1 {\r\n\t\tvariance = 0.0\r\n\t} else {\r\n\t\tvariance /= float64(n)\r\n\t}\r\n"]
[4814.747616, "o", "\tb.RiskStdDev = round2(math.Sqrt(variance))\r\n\r\n\tb.DominantType = dominantThreatType(typeCounts)\r\n\tb.TypeDistribution = typeCounts\r\n\r\n\tb.UniqueActors = nonNilStrings(sortedUniqueStringsFromSet(actorSet))\r\n\r\n\tb.EscalationIndex = round3(timelineEscalationIndex(threats))\r\n\tb.RiskTrend = round3(timelineRiskTrend(threats, startTime))\r\n\t"]
[4814.747683, "o", "b.BurstScore = round3(timelineBurstScore(threats))\r\n\r\n\tsortedTop := make([]map[string]interface{}, len(threats))\r\n\tcopy(sortedTop, threats)\r\n\tsort.SliceStable(sortedTop, func(i, j int) bool {\r\n\t\tri, _ := getFloat(sortedTop[i], \"enriched_risk_score\")\r\n\t\trj, _ := getFloat(sortedTop[j], \"enriched_risk_score\")\r\n"]
[4814.747745, "o", "\t\tif ri != rj {\r\n\t\t\treturn ri > rj\r\n\t\t}\r\n\t\tti, tj := threatSortTime(sortedTop[i]), threatSortTime(sortedTop[j])\r\n\t\tif !ti.Equal(tj) {\r\n\t\t\treturn ti.Before(tj)\r\n\t\t}\r\n\t\ttta, _ := getString(sortedTop[i], \"threat_type\")\r\n\t\tttb, _ := getString(sortedTop[j], \"threat_type\")\r\n\t\treturn tta < ttb\r\n\t})\r\n\tif topN < len(sortedTop) {\r\n\t\tsortedTop = sortedTop[:topN]\r\n"]
[4814.747806, "o", "\t}\r\n\tb.TopThreats = sortedTop\r\n\r\n\treturn b\r\n}\r\n\r\nfunc dominantThreatType(counts map[string]int) string {\r\n\tvar keys []string\r\n\tfor k := range counts {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n\tsort.Strings(keys)\r\n\tdominant := \"\"\r\n"]
[4814.747865, "o", "\tmaxCount := -1\r\n\tfor _, k := range keys {\r\n\t\tif counts[k] > maxCount {\r\n\t\t\tmaxCount = counts[k]\r\n\t\t\tdominant = k\r\n\t\t}\r\n\t}\r\n\treturn dominant\r\n}\r\n\r\n"]
[4814.747921, "o", "func timelineSeverityRank(sev string) int {\r\n\tswitch sev {\r\n\tcase \"none\":\r\n\t\treturn 0\r\n\tcase \"low\":\r\n\t\treturn 1\r\n\tcase \"medium\":\r\n\t\treturn 2\r\n\tcase \"high\":\r\n\t\t"]
[4814.747983, "o", "return 3\r\n\tcase \"critical\":\r\n\t\treturn 4\r\n\tdefault:\r\n\t\treturn -1\r\n\t}\r\n}\r\n\r\nfunc timelineEscalationIndex(threats []map[string]interface{}) float64 {\r\n\tn := len(threats)\r\n\tif n < 2 {\r\n\t\treturn 0.0\r\n"]
[4814.748043, "o", "\t}\r\n\tordered := make([]map[string]interface{}, len(threats))\r\n\tcopy(ordered, threats)\r\n\tsort.SliceStable(ordered, func(i, j int) bool {\r\n\t\tti, tj := threatSortTime(ordered[i]), threatSortTime(ordered[j])\r\n\t\tif !ti.Equal(tj) {\r\n\t\t\treturn ti.Before(tj)\r\n\t\t}\r\n\t\ttta, _ := getString(ordered[i], \"threat_type\")\r\n"]
[4814.748104, "o", "\t\tttb, _ := getString(ordered[j], \"threat_type\")\r\n\t\treturn tta < ttb\r\n"]
[4814.748579, "o", "\u001b[?2004h"]
