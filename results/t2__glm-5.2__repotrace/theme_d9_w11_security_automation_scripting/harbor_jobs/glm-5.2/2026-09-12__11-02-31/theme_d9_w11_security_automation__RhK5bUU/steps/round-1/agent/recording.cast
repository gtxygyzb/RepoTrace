[6062.613142, "o", "\t\"fmt\"\r\n     7\t\t\"net\"\r\n     8\t\t\"os\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"time\"\r\n    12\t)\r\n    13\t\r\n    14\ttype iocEntry struct {\r\n    15\t\tID            string   `json:\"id\"`\r\n    16\t\tIndicator     string   `json:\"indicator\"`\r\n    17\t\tIndicatorType string   `json:\"indicator_type\"`\r\n    18"]
[6062.613233, "o", "\t\tThreatActor   string   `json:\"threat_actor\"`\r\n    19\t\tConfidence    float64  `json:\"confidence\"`\r\n    20\t\tTags          []string `json:\"tags\"`\r\n    21\t\tSeverity      string   `json:\"severity\"`\r\n    22\t\tLastUpdated   string   `json:\"last_updated\"`\r\n    23\t\t"]
[6062.613301, "o", "TTLHours      int      `json:\"ttl_hours\"`\r\n    24\t}\r\n    25\t\r\n    26\ttype processedIOC struct {\r\n    27\t\tentry       iocEntry\r\n    28\t\tlastUpdated time.Time\r\n    29\t\tttlHours    int\r\n    30\t\tip          net.IP\r\n    31\t\tipNet       *net.IPNet\r\n    32\t\tprefixLen   int\r\n    33\t\tport        int\r\n    34\t}\r\n    35\t\r\n    36\t"]
[6062.613363, "o", "type activeIOC struct {\r\n    37\t\tp      processedIOC\r\n    38\t\tbase   float64\r\n    39\t\tfactor float64\r\n    40\t}\r\n    41\t\r\n    42\ttype iocMatchInternal struct {\r\n    43\t\tp             processedIOC\r\n    44\t\tbase          float64\r\n    45\t\tfreshness     float64\r\n    46\t\t"]
[6062.613422, "o", "adjusted      float64\r\n    47\t\tmatchedFields []string\r\n    48\t}\r\n    49\t\r\n    50\ttype iocMatchOutput struct {\r\n    51\t\tIocID         string   `json:\"ioc_id\"`\r\n"]
[6062.613493, "o", "    52\t\tIndicator     string   `json:\"indicator\"`\r\n    53\t\tIndicatorType string   `json:\"indicator_type\"`\r\n    54\t\tThreatActor   string   `json:\"threat_actor\"`\r\n    55\t\tConfidence    float64  `json:\"confidence\"`\r\n    56\t\tTags          []string `json:\"tags\"`\r\n    57\t\tMatchedFields []string `json:\"matched_fields\"`\r\n    58\t}\r\n    59\t\r\n    60\tfunc runEnrich(args []string) int {\r\n    61\t\tfs := newFlagSet(\"enrich\")\r\n    62\t\tiocPath := fs.String(\"ioc\", \"\", \"path to IOC database JSON file\")\r\n"]
[6062.613574, "o", "    63\t\trefTimeStr := fs.String(\"reference-time\", \"\", \"ISO 8601 timestamp used for TTL evaluation\")\r\n    64\t\tminConf := fs.Float64(\"min-confidence\", 0.0, \"minimum base effective confidence\")\r\n    65\t\tif !parseFlags(fs, args) {\r\n    66\t\t\treturn 1\r\n    67\t\t}\r\n    68\t\tif !isFlagSet(fs, \"ioc\") || *iocPath == \"\" {\r\n    69\t\t\tfmt.Fprintln(os.Stderr, \"error: --ioc flag is required\")\r\n    70\t\t\treturn 1\r\n    71\t\t}\r\n    72\t\r\n    73\t\thasRef := isFlagSet(fs, \"reference-time\")\r\n    74\t\tvar refTime time.Time\r\n"]
[6062.613662, "o", "    75\t\tif hasRef {\r\n    76\t\t\tt, err := parseTime(*refTimeStr)\r\n    77\t\t\tif err != nil {\r\n    78\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    79\t\t\t\treturn 1\r\n    80\t\t\t}\r\n    81\t\t\trefTime = t\r\n    82\t\t}\r\n    83\t\r\n    84\t\tiocs, err := loadIOCDB(*iocPath)\r\n    85\t\tif err != nil {\r\n"]
