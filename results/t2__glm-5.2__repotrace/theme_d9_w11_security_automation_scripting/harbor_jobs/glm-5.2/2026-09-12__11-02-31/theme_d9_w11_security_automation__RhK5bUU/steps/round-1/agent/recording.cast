[1556.158828, "o", "\u001b[?2004h> "]
[1556.158964, "o", "    \"encoding/json\"\r\n\u001b[?2004l\r"]
[1556.159028, "o", "\u001b[?2004h> "]
[1556.159102, "o", "    \"fmt\"\r\n\u001b[?2004l\r"]
[1556.159149, "o", "\u001b[?2004h> "]
[1556.159241, "o", "    \"os\"\r\n"]
[1556.159301, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1556.159355, "o", "> "]
[1556.159414, "o", "    \"sort\"\r\n\u001b[?2004l\r"]
[1556.159468, "o", "\u001b[?2004h> "]
[1556.159552, "o", "    \"time\"\r\n\u001b[?2004l\r"]
[1556.159608, "o", "\u001b[?2004h> )"]
[1556.159663, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.159719, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.159773, "o", "> "]
[1556.159971, "o", "type Summary struct {\r\n\u001b[?2004l\r"]
[1556.160168, "o", "\u001b[?2004h> "]
[1556.160433, "o", "    TotalEvents     int              `json:\"total_events\"`\r\n\u001b[?2004l\r"]
[1556.160505, "o", "\u001b[?2004h> "]
[1556.160884, "o", "    TimeRange       TimeRange        `json:\"time_range\"`\r\n\u001b[?2004l\r"]
[1556.160943, "o", "\u001b[?2004h> "]
[1556.161362, "o", "    BySeverity      map[string]int    `json:\"by_severity\"`\r\n\u001b[?2004l\r"]
[1556.161424, "o", "\u001b[?2004h"]
[1556.161481, "o", "> "]
[1556.161805, "o", "    ByAction        map[string]int    `json:\"by_action\"`\r\n\u001b[?2004l\r"]
[1556.161863, "o", "\u001b[?2004h> "]
[1556.162286, "o", "    ByEventType     map[string]int    `json:\"by_event_type\"`\r\n\u001b[?2004l\r"]
[1556.16235, "o", "\u001b[?2004h> "]
[1556.162769, "o", "    TopSourceIPs    []SourceIPStat    `json:\"top_source_ips\"`\r\n\u001b[?2004l\r"]
[1556.162829, "o", "\u001b[?2004h> "]
[1556.163231, "o", "    TopDestPorts    []DestPortStat    `json:\"top_dest_ports\"`\r\n\u001b[?2004l\r"]
[1556.163297, "o", "\u001b[?2004h> "]
[1556.163741, "o", "    UniqueSourceIPs int              `json:\"unique_source_ips\"`\r\n\u001b[?2004l\r"]
[1556.163804, "o", "\u001b[?2004h> "]
[1556.164228, "o", "    UniqueDestIPs   int              `json:\"unique_dest_ips\"`\r\n\u001b[?2004l\r"]
[1556.164287, "o", "\u001b[?2004h> "]
[1556.164705, "o", "    SeverityTrend   []SeverityWindow `json:\"severity_trend\"`\r\n\u001b[?2004l\r"]
[1556.164764, "o", "\u001b[?2004h> }\r\n"]
[1556.164821, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1556.164879, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.164934, "o", "> "]
[1556.165074, "o", "type TimeRange struct {\r\n\u001b[?2004l\r"]
[1556.165134, "o", "\u001b[?2004h> "]
[1556.165363, "o", "    Start string `json:\"start\"`\r\n\u001b[?2004l\r"]
[1556.165423, "o", "\u001b[?2004h> "]
[1556.165627, "o", "    End   string `json:\"end\"`\r\n\u001b[?2004l\r"]
[1556.165686, "o", "\u001b[?2004h> }"]
[1556.165742, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.16581, "o", "> \r\n\u001b[?2004l\r"]
[1556.165865, "o", "\u001b[?2004h> "]
[1556.166008, "o", "type SourceIPStat struct {\r\n\u001b[?2004l\r"]
[1556.166072, "o", "\u001b[?2004h> "]
[1556.166329, "o", "    IP          string  `json:\"ip\"`\r\n\u001b[?2004l\r"]
[1556.166379, "o", "\u001b[?2004h> "]
[1556.166669, "o", "    Count       int     `json:\"count\"`\r\n\u001b[?2004l\r"]
[1556.166758, "o", "\u001b[?2004h> "]
[1556.167044, "o", "    ThreatScore float64 `json:\"threat_score\"`\r\n\u001b[?2004l\r"]
[1556.167099, "o", "\u001b[?2004h> }"]
[1556.167154, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.167228, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.167434, "o", "type DestPortStat struct {\r\n\u001b[?2004l\r"]
[1556.167489, "o", "\u001b[?2004h> "]
[1556.167696, "o", "    Port  int `json:\"port\"`\r\n\u001b[?2004l\r"]
[1556.167743, "o", "\u001b[?2004h> "]
[1556.16796, "o", "    Count int `json:\"count\"`\r\n\u001b[?2004l\r"]
[1556.168018, "o", "\u001b[?2004h> }\r\n"]
[1556.168074, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1556.16813, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.168185, "o", "> "]
[1556.168367, "o", "type SeverityWindow struct {\r\n\u001b[?2004l\r"]
[1556.168435, "o", "\u001b[?2004h> "]
[1556.168736, "o", "    WindowStart string  `json:\"window_start\"`\r\n\u001b[?2004l\r"]
[1556.168793, "o", "\u001b[?2004h> "]
[1556.169093, "o", "    WindowEnd   string  `json:\"window_end\"`\r\n\u001b[?2004l\r"]
[1556.169147, "o", "\u001b[?2004h> "]
[1556.169479, "o", "    AvgSeverity float64 `json:\"avg_severity\"`\r\n\u001b[?2004l\r"]
[1556.169538, "o", "\u001b[?2004h"]
[1556.169595, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.16965, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.16971, "o", "> "]
[1556.16994, "o", "func runSummarize(args []string) int {\r\n\u001b[?2004l\r"]
[1556.169996, "o", "\u001b[?2004h> "]
[1556.170243, "o", "    fs := newFlagSet(\"summarize\")\r\n\u001b[?2004l\r"]
[1556.170302, "o", "\u001b[?2004h> "]
[1556.170771, "o", "    format := fs.String(\"format\", \"json\", \"output format (text|json)\")\r\n\u001b[?2004l\r"]
[1556.170827, "o", "\u001b[?2004h> "]
[1556.171042, "o", "    if !parseFlags(fs, args) {\r\n\u001b[?2004l\r"]
[1556.171097, "o", "\u001b[?2004h> "]
[1556.171228, "o", "        return 1\r\n\u001b[?2004l\r"]
[1556.171285, "o", "\u001b[?2004h> "]
[1556.171344, "o", "    }\r\n\u001b[?2004l\r"]
[1556.171404, "o", "\u001b[?2004h> "]
[1556.171731, "o", "    if *format != \"json\" && *format != \"text\" {\r\n\u001b[?2004l\r"]
[1556.171787, "o", "\u001b[?2004h> "]
[1556.17213, "o", "        fmt.Fprintln(os.Stderr, \"invalid format\")\r\n\u001b[?2004l\r"]
[1556.172185, "o", "\u001b[?2004h> "]
[1556.172313, "o", "        return 1\r\n\u001b[?2004l\r"]
[1556.172372, "o", "\u001b[?2004h> "]
[1556.172424, "o", "    }\r\n\u001b[?2004l\r"]
[1556.17248, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1556.172532, "o", "\u001b[?2004h> "]
[1556.172769, "o", "    events, err := readEvents()\r\n\u001b[?2004l\r"]
[1556.172826, "o", "\u001b[?2004h> "]
[1556.173065, "o", "    summary := buildSummary(events)\r\n\u001b[?2004l\r"]
[1556.17312, "o", "\u001b[?2004h> "]
[1556.173279, "o", "    if *format == \"text\" {\r\n\u001b[?2004l\r"]
[1556.173337, "o", "\u001b[?2004h> "]
[1556.173498, "o", "        printTextSummary(summary)\r\n\u001b[?2004l\r"]
[1556.173553, "o", "\u001b[?2004h> "]
[1556.173629, "o", "    } else {\r\n\u001b[?2004l\r"]
[1556.173684, "o", "\u001b[?2004h> "]
[1556.173847, "o", "        printJSONSummary(summary)\r\n\u001b[?2004l\r"]
[1556.173902, "o", "\u001b[?2004h> "]
[1556.173957, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.174011, "o", "> "]
[1556.174076, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1556.174132, "o", "\u001b[?2004h> "]
[1556.174323, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r"]
[1556.174379, "o", "\u001b[?2004h> "]
[1556.174455, "o", "        return 2\r\n\u001b[?2004l\r"]
[1556.17451, "o", "\u001b[?2004h> "]
[1556.174568, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.174637, "o", "    return 0\r\n\u001b[?2004l\r"]
[1556.174692, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1556.174758, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.175012, "o", "func buildSummary(events []Event) Summary {\r\n\u001b[?2004l\r"]
[1556.175068, "o", "\u001b[?2004h> "]
[1556.175163, "o", "    s := Summary{\r\n\u001b[?2004l\r"]
[1556.175224, "o", "\u001b[?2004h> "]
[1556.175397, "o", "        TotalEvents: len(events),\r\n\u001b[?2004l\r"]
[1556.175452, "o", "\u001b[?2004h> "]
[1556.175683, "o", "        BySeverity:  make(map[string]int),\r\n\u001b[?2004l\r"]
[1556.175739, "o", "\u001b[?2004h> "]
[1556.175957, "o", "        ByAction:    make(map[string]int),\r\n\u001b[?2004l\r"]
[1556.176012, "o", "\u001b[?2004h> "]
[1556.176263, "o", "        ByEventType: make(map[string]int),\r\n\u001b[?2004l\r"]
[1556.176295, "o", "\u001b[?2004h> "]
[1556.176373, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.176432, "o", "> "]
[1556.176527, "o", "    if len(events) == 0 {\r\n\u001b[?2004l\r"]
[1556.176584, "o", "\u001b[?2004h> "]
[1556.176837, "o", "        s.TimeRange = TimeRange{Start: \"\", End: \"\"}\r\n\u001b[?2004l\r"]
[1556.176892, "o", "\u001b[?2004h> "]
[1556.195639, "o", "        s.TopSourceIPs = []SourceIPStat{}\r\n\u001b[?2004l\r\u001b[?2004h>         s.TopDestPorts = []DestPortStat{}\r\n\u001b[?2004l\r\u001b[?2004h>         s.SeverityTrend = []SeverityWindow{}\r\n\u001b[?2004l\r\u001b[?2004h>         return s\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     var minT, maxT time.Time\r\n\u001b[?2004l\r\u001b[?2004h>     firstValid := false\r\n\u001b[?2004l\r\u001b[?2004h>     sourceCounts := make(map[string]int)\r\n\u001b[?2004l\r\u001b[?2004h>     sourceScores := make(map[string]float64)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.195732, "o", "    destIPs := make(map[string]bool)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.195808, "o", "> "]
[1556.196021, "o", "    portCounts := make(map[int]int)\r\n\u001b[?2004l\r"]
[1556.196076, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1556.196133, "o", "\u001b[?2004h> "]
[1556.196358, "o", "    for _, e := range events {\r\n\u001b[?2004l\r"]
[1556.196416, "o", "\u001b[?2004h> "]
[1556.196653, "o", "        t, ok := eventTime(e)\r\n\u001b[?2004l\r"]
[1556.196708, "o", "\u001b[?2004h> "]
[1556.196833, "o", "        if ok {\r\n\u001b[?2004l\r"]
[1556.196901, "o", "\u001b[?2004h> "]
[1556.197092, "o", "            if !firstValid {\r\n\u001b[?2004l\r"]
[1556.197147, "o", "\u001b[?2004h> "]
[1556.197333, "o", "                minT = t\r\n\u001b[?2004l\r"]
[1556.197394, "o", "\u001b[?2004h> "]
[1556.197577, "o", "                maxT = t\r\n\u001b[?2004l\r"]
[1556.197633, "o", "\u001b[?2004h> "]
[1556.197896, "o", "                firstValid = true\r\n\u001b[?2004l\r"]
[1556.197952, "o", "\u001b[?2004h> "]
[1556.198093, "o", "            } else {\r\n\u001b[?2004l\r"]
[1556.198159, "o", "\u001b[?2004h> "]
[1556.198411, "o", "                if t.Before(minT) {\r\n\u001b[?2004l\r"]
[1556.198469, "o", "\u001b[?2004h> "]
[1556.198667, "o", "                    minT = t\r\n\u001b[?2004l\r"]
[1556.198724, "o", "\u001b[?2004h> "]
[1556.198848, "o", "                }\r\n\u001b[?2004l\r"]
[1556.198904, "o", "\u001b[?2004h> "]
[1556.199142, "o", "                if t.After(maxT) {\r\n\u001b[?2004l\r"]
[1556.199198, "o", "\u001b[?2004h> "]
[1556.199407, "o", "                    maxT = t\r\n\u001b[?2004l\r"]
[1556.19948, "o", "\u001b[?2004h> "]
[1556.199594, "o", "                }\r\n\u001b[?2004l\r"]
[1556.19966, "o", "\u001b[?2004h> "]
[1556.199757, "o", "            }\r\n\u001b[?2004l\r"]
[1556.199824, "o", "\u001b[?2004h> "]
[1556.19989, "o", "        }\r\n\u001b[?2004l\r"]
[1556.199946, "o", "\u001b[?2004h> "]
[1556.200188, "o", "        s.BySeverity[e.Severity]++\r\n\u001b[?2004l\r"]
[1556.200252, "o", "\u001b[?2004h> "]
[1556.200466, "o", "        s.ByAction[e.Action]++\r\n\u001b[?2004l\r"]
[1556.200528, "o", "\u001b[?2004h> "]
[1556.200776, "o", "        s.ByEventType[e.EventType]++\r\n\u001b[?2004l\r"]
[1556.200844, "o", "\u001b[?2004h> "]
[1556.201079, "o", "        sourceCounts[e.SourceIP]++\r\n\u001b[?2004l\r"]
[1556.201134, "o", "\u001b[?2004h> "]
[1556.20162, "o", "        sourceScores[e.SourceIP] += float64(severityValue(e.Severity))\r\n\u001b[?2004l\r"]
[1556.20168, "o", "\u001b[?2004h> "]
[1556.201941, "o", "        destIPs[e.DestIP] = true\r\n\u001b[?2004l\r"]
[1556.201998, "o", "\u001b[?2004h> "]
[1556.202226, "o", "        portCounts[e.DestPort]++\r\n\u001b[?2004l\r"]
[1556.202283, "o", "\u001b[?2004h> "]
[1556.202335, "o", "    }\r\n\u001b[?2004l\r"]
[1556.202391, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1556.202447, "o", "\u001b[?2004h> "]
[1556.202593, "o", "    if !firstValid {\r\n\u001b[?2004l\r"]
[1556.202647, "o", "\u001b[?2004h> "]
[1556.203, "o", "        s.TimeRange = TimeRange{Start: \"\", End: \"\"}\r\n\u001b[?2004l\r"]
[1556.203055, "o", "\u001b[?2004h> "]
[1556.203151, "o", "    } else {\r\n\u001b[?2004l\r"]
[1556.203226, "o", "\u001b[?2004h> "]
[1556.203443, "o", "        s.TimeRange = TimeRange{\r\n\u001b[?2004l\r"]
[1556.203499, "o", "\u001b[?2004h> "]
[1556.20381, "o", "            Start: minT.Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[1556.203868, "o", "\u001b[?2004h> "]
[1556.204177, "o", "            End:   maxT.Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[1556.204241, "o", "\u001b[?2004h> "]
[1556.204315, "o", "        }\r\n\u001b[?2004l\r"]
[1556.204371, "o", "\u001b[?2004h> "]
[1556.204424, "o", "    }\r\n\u001b[?2004l\r"]
[1556.20448, "o", "\u001b[?2004h> "]
[1556.204767, "o", "    s.UniqueSourceIPs = len(sourceCounts)\r\n\u001b[?2004l\r"]
[1556.204822, "o", "\u001b[?2004h> "]
[1556.205055, "o", "    s.UniqueDestIPs = len(destIPs)\r\n\u001b[?2004l\r"]
[1556.20511, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1556.205164, "o", "\u001b[?2004h> "]
[1556.205499, "o", "    s.TopSourceIPs = topSourceIPs(sourceCounts, sourceScores)\r\n\u001b[?2004l\r"]
[1556.20556, "o", "\u001b[?2004h> "]
[1556.205783, "o", "    s.TopDestPorts = topDestPorts(portCounts)\r\n\u001b[?2004l\r"]
[1556.205837, "o", "\u001b[?2004h> "]
[1556.206079, "o", "    s.SeverityTrend = severityTrend(events, minT)\r\n\u001b[?2004l\r"]
[1556.206139, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1556.206198, "o", "\u001b[?2004h> "]
[1556.206327, "o", "    cleanMap(s.BySeverity)\r\n\u001b[?2004l\r"]
[1556.206422, "o", "\u001b[?2004h> "]
[1556.206502, "o", "    cleanMap(s.ByAction)\r\n\u001b[?2004l\r"]
[1556.206583, "o", "\u001b[?2004h> "]
[1556.206702, "o", "    cleanMap(s.ByEventType)\r\n\u001b[?2004l\r"]
[1556.206785, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.206812, "o", "> "]
[1556.206918, "o", "    return s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.206997, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1556.207086, "o", "\u001b[?2004h> "]
[1556.207227, "o", "func cleanMap(m map[string]int) {\r\n\u001b[?2004l\r"]
[1556.207306, "o", "\u001b[?2004h"]
[1556.207363, "o", "> "]
[1556.207428, "o", "    for k, v := range m {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.207483, "o", "> "]
[1556.207562, "o", "        if v == 0 {\r\n\u001b[?2004l\r"]
[1556.207622, "o", "\u001b[?2004h> "]
[1556.207738, "o", "            delete(m, k)\r\n\u001b[?2004l\r"]
[1556.207793, "o", "\u001b[?2004h> "]
[1556.207852, "o", "        }\r\n\u001b[?2004l\r"]
[1556.207906, "o", "\u001b[?2004h> "]
[1556.207966, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.208021, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1556.208074, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1556.20852, "o", "func topSourceIPs(counts map[string]int, scores map[string]float64) []SourceIPStat {\r\n\u001b[?2004l\r"]
[1556.208577, "o", "\u001b[?2004h> "]
[1556.208811, "o", "    out := make([]SourceIPStat, 0, len(counts))\r\n\u001b[?2004l\r"]
[1556.208865, "o", "\u001b[?2004h> "]
[1556.209022, "o", "    for ip, c := range counts {\r\n\u001b[?2004l\r"]
[1556.209077, "o", "\u001b[?2004h> "]
[1556.209497, "o", "        out = append(out, SourceIPStat{IP: ip, Count: c, ThreatScore: scores[ip]})\r\n\u001b[?2004l\r"]
[1556.209554, "o", "\u001b[?2004h> "]
[1556.209607, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.209835, "o", "    sort.Slice(out, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[1556.209893, "o", "\u001b[?2004h> "]
[1556.210098, "o", "        if out[i].Count != out[j].Count {\r\n\u001b[?2004l\r"]
[1556.210157, "o", "\u001b[?2004h> "]
[1556.210389, "o", "            return out[i].Count > out[j].Count\r\n\u001b[?2004l\r"]
[1556.210445, "o", "\u001b[?2004h> "]
[1556.210494, "o", "        }\r\n\u001b[?2004l\r"]
[1556.210554, "o", "\u001b[?2004h> "]
[1556.210722, "o", "        return out[i].IP < out[j].IP\r\n\u001b[?2004l\r"]
[1556.210781, "o", "\u001b[?2004h> "]
[1556.210835, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.210889, "o", "> "]
[1556.210974, "o", "    if len(out) > 10 {\r\n\u001b[?2004l\r"]
[1556.211034, "o", "\u001b[?2004h> "]
[1556.21114, "o", "        out = out[:10]\r\n\u001b[?2004l\r"]
[1556.211204, "o", "\u001b[?2004h> "]
[1556.211268, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.211353, "o", "    return out\r\n\u001b[?2004l\r"]
[1556.211408, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1556.21147, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1556.211524, "o", "\u001b[?2004h> "]
[1556.211795, "o", "func topDestPorts(counts map[int]int) []DestPortStat {\r\n\u001b[?2004l\r"]
[1556.211855, "o", "\u001b[?2004h> "]
[1556.212084, "o", "    out := make([]DestPortStat, 0, len(counts))\r\n\u001b[?2004l\r"]
[1556.212139, "o", "\u001b[?2004h> "]
[1556.212295, "o", "    for p, c := range counts {\r\n\u001b[?2004l\r"]
[1556.212351, "o", "\u001b[?2004h> "]
[1556.212637, "o", "        out = append(out, DestPortStat{Port: p, Count: c})\r\n\u001b[?2004l\r"]
[1556.212692, "o", "\u001b[?2004h> "]
[1556.212746, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.212806, "o", "> "]
[1556.212978, "o", "    sort.Slice(out, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[1556.213038, "o", "\u001b[?2004h> "]
[1556.213247, "o", "        if out[i].Count != out[j].Count {\r\n\u001b[?2004l\r"]
[1556.21333, "o", "\u001b[?2004h"]
[1556.21339, "o", "> "]
[1556.213534, "o", "            return out[i].Count > out[j].Count\r\n\u001b[?2004l\r"]
[1556.213597, "o", "\u001b[?2004h> "]
[1556.213659, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.213723, "o", "> "]
[1556.213886, "o", "        return out[i].Port < out[j].Port\r\n\u001b[?2004l\r"]
[1556.213943, "o", "\u001b[?2004h> "]
[1556.213969, "o", "    })\r\n\u001b[?2004l\r"]
[1556.214074, "o", "\u001b[?2004h> "]
[1556.214142, "o", "    if len(out) > 10 {\r\n\u001b[?2004l\r"]
[1556.214194, "o", "\u001b[?2004h"]
[1556.214272, "o", "> "]
[1556.21432, "o", "        out = out[:10]\r\n\u001b[?2004l\r"]
[1556.214413, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.214477, "o", "> "]
[1556.214538, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.214597, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.214653, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.214711, "o", "> "]
[1556.215012, "o", "func severityTrend(events []Event, first time.Time) []SeverityWindow {\r\n\u001b[?2004l\r"]
[1556.215078, "o", "\u001b[?2004h> "]
[1556.215196, "o", "    windows := make(map[int64][]Event)\r\n\u001b[?2004l\r"]
[1556.215268, "o", "\u001b[?2004h> "]
[1556.215354, "o", "    for _, e := range events {\r\n\u001b[?2004l\r"]
[1556.215415, "o", "\u001b[?2004h> "]
[1556.215506, "o", "        t, ok := eventTime(e)\r\n\u001b[?2004l\r"]
[1556.215573, "o", "\u001b[?2004h> "]
[1556.215637, "o", "        if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.215723, "o", "            continue\r\n\u001b[?2004l\r"]
[1556.215786, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1556.215847, "o", "\u001b[?2004h> "]
[1556.216015, "o", "        offset := int64(t.Sub(first).Seconds())\r\n\u001b[?2004l\r"]
[1556.216076, "o", "\u001b[?2004h> "]
[1556.216147, "o", "        if offset < 0 {\r\n\u001b[?2004l\r"]
[1556.216207, "o", "\u001b[?2004h> "]
[1556.216285, "o", "            offset = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.216347, "o", ">         }\r\n\u001b[?2004l\r"]
[1556.216414, "o", "\u001b[?2004h> "]
[1556.21651, "o", "        window := offset / 3600\r\n\u001b[?2004l\r"]
[1556.216569, "o", "\u001b[?2004h> "]
[1556.216742, "o", "        windows[window] = append(windows[window], e)\r\n\u001b[?2004l\r"]
[1556.216803, "o", "\u001b[?2004h> "]
[1556.216863, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1556.216923, "o", "\u001b[?2004h> "]
[1556.216988, "o", "    var keys []int64\r\n\u001b[?2004l\r"]
[1556.217048, "o", "\u001b[?2004h> "]
[1556.217128, "o", "    for k := range windows {\r\n\u001b[?2004l\r"]
[1556.217174, "o", "\u001b[?2004h> "]
[1556.217299, "o", "        keys = append(keys, k)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.217355, "o", ">     }\r\n\u001b[?2004l\r"]
[1556.217413, "o", "\u001b[?2004h> "]
[1556.217655, "o", "    sort.Slice(keys, func(i, j int) bool { return keys[i] < keys[j] })\r\n\u001b[?2004l\r"]
[1556.21774, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1556.2178, "o", "\u001b[?2004h> "]
[1556.21791, "o", "    out := make([]SeverityWindow, 0, len(keys))\r\n\u001b[?2004l\r"]
[1556.217965, "o", "\u001b[?2004h> "]
[1556.218058, "o", "    for _, k := range keys {\r\n\u001b[?2004l\r"]
[1556.218112, "o", "\u001b[?2004h> "]
[1556.218193, "o", "        evs := windows[k]\r\n\u001b[?2004l\r"]
[1556.218228, "o", "\u001b[?2004h> "]
[1556.218336, "o", "        var total float64\r\n\u001b[?2004l\r"]
[1556.21839, "o", "\u001b[?2004h> "]
[1556.218494, "o", "        for _, e := range evs {\r\n\u001b[?2004l\r"]
[1556.218548, "o", "\u001b[?2004h> "]
[1556.21874, "o", "            total += float64(severityValue(e.Severity))\r\n\u001b[?2004l\r"]
[1556.218794, "o", "\u001b[?2004h> "]
[1556.218849, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.219007, "o", "        avg := total / float64(len(evs))\r\n\u001b[?2004l\r"]
[1556.219061, "o", "\u001b[?2004h> "]
[1556.219292, "o", "        start := first.Add(time.Duration(k*3600) * time.Second)\r\n\u001b[?2004l\r"]
[1556.21935, "o", "\u001b[?2004h> "]
[1556.219575, "o", "        end := first.Add(time.Duration((k+1)*3600) * time.Second)\r\n\u001b[?2004l\r"]
[1556.21963, "o", "\u001b[?2004h> "]
[1556.219768, "o", "        out = append(out, SeverityWindow{\r\n\u001b[?2004l\r"]
[1556.219823, "o", "\u001b[?2004h> "]
[1556.220003, "o", "            WindowStart: start.Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[1556.220059, "o", "\u001b[?2004h> "]
[1556.220237, "o", "            WindowEnd:   end.Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[1556.220293, "o", "\u001b[?2004h> "]
[1556.22042, "o", "            AvgSeverity: round2(avg),\r\n\u001b[?2004l\r"]
[1556.220478, "o", "\u001b[?2004h> "]
[1556.220533, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.220589, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.220655, "o", "    return out\r\n\u001b[?2004l\r"]
[1556.220734, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1556.220767, "o", "\u001b[?2004h> "]
[1556.220914, "o", "func printJSONSummary(s Summary) {\r\n\u001b[?2004l\r"]
[1556.220977, "o", "\u001b[?2004h> "]
[1556.221087, "o", "    w := bufio.NewWriter(os.Stdout)\r\n\u001b[?2004l\r"]
[1556.221142, "o", "\u001b[?2004h> "]
[1556.221202, "o", "    defer w.Flush()\r\n\u001b[?2004l\r"]
[1556.221271, "o", "\u001b[?2004h> "]
[1556.221359, "o", "    enc := json.NewEncoder(w)\r\n\u001b[?2004l\r"]
[1556.221413, "o", "\u001b[?2004h> "]
[1556.221507, "o", "    enc.SetEscapeHTML(false)\r\n\u001b[?2004l\r"]
[1556.221562, "o", "\u001b[?2004h> "]
[1556.221705, "o", "    if err := enc.Encode(s); err != nil {\r\n\u001b[?2004l\r"]
[1556.22176, "o", "\u001b[?2004h> "]
[1556.221883, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r"]
[1556.221937, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1556.221997, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1556.222052, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.222106, "o", "> "]
[1556.222203, "o", "func printTextSummary(s Summary) {\r\n\u001b[?2004l\r"]
[1556.222269, "o", "\u001b[?2004h> "]
[1556.222382, "o", "    w := bufio.NewWriter(os.Stdout)\r\n\u001b[?2004l\r"]
[1556.222436, "o", "\u001b[?2004h> "]
[1556.222497, "o", "    defer w.Flush()\r\n\u001b[?2004l\r"]
[1556.222552, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.222611, "o", "> "]
[1556.222773, "o", "    fmt.Fprintf(w, \"=== Security Log Summary ===\\n\")\r\n\u001b[?2004l\r"]
[1556.222828, "o", "\u001b[?2004h> "]
[1556.22302, "o", "    fmt.Fprintf(w, \"Total Events: %d\\n\", s.TotalEvents)\r\n\u001b[?2004l\r"]
[1556.223075, "o", "\u001b[?2004h> "]
[1556.223366, "o", "    fmt.Fprintf(w, \"Time Range: %s to %s\\n\", s.TimeRange.Start, s.TimeRange.End)\r\n\u001b[?2004l\r"]
[1556.223425, "o", "\u001b[?2004h> "]
[1556.223646, "o", "    fmt.Fprintf(w, \"Unique Source IPs: %d\\n\", s.UniqueSourceIPs)\r\n\u001b[?2004l\r"]
[1556.223702, "o", "\u001b[?2004h> "]
[1556.22391, "o", "    fmt.Fprintf(w, \"Unique Dest IPs: %d\\n\", s.UniqueDestIPs)\r\n\u001b[?2004l\r"]
[1556.223968, "o", "\u001b[?2004h> "]
[1556.224025, "o", "    fmt.Fprintln(w)\r\n\u001b[?2004l\r"]
[1556.224082, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.224307, "o", "    fmt.Fprintln(w, \"--- Severity Distribution ---\")\r\n\u001b[?2004l\r"]
[1556.224365, "o", "\u001b[?2004h> "]
[1556.224576, "o", "    severities := []string{\"critical\", \"high\", \"medium\", \"low\"}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.224632, "o", "> "]
[1556.224695, "o", "    for _, sev := range severities {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.224768, "o", "> "]
[1556.224847, "o", "        count := s.BySeverity[sev]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.224907, "o", "        if count == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.224978, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.225033, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.225087, "o", "> "]
[1556.225141, "o", "        pct := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.225219, "o", "        if s.TotalEvents > 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.225275, "o", "> "]
[1556.225409, "o", "            pct = float64(count) * 100.0 / float64(s.TotalEvents)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.225465, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.225524, "o", "> "]
[1556.225645, "o", "        fmt.Fprintf(w, \"  %s: %d (%.1f%%)\\n\", sev, count, pct)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.2257, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1556.225768, "o", "\u001b[?2004h> "]
[1556.225823, "o", "    fmt.Fprintln(w)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.22594, "o", "    fmt.Fprintln(w, \"--- Top Source IPs ---\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.225995, "o", "> "]
[1556.226072, "o", "    for i, src := range s.TopSourceIPs {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.226126, "o", "> "]
[1556.226372, "o", "        fmt.Fprintf(w, \"  %d. %s - %d events (threat score: %g)\\n\", i+1, src.IP, src.Count, src.ThreatScore)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.226428, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1556.226484, "o", "\u001b[?2004h> "]
[1556.226541, "o", "    fmt.Fprintln(w)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1556.226673, "o", "    fmt.Fprintln(w, \"--- Action Distribution ---\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.226732, "o", "> "]
[1556.226845, "o", "    fmt.Fprintf(w, \"ALLOW: %d\\n\", s.ByAction[\"ALLOW\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.226902, "o", "> "]
[1556.227009, "o", "    fmt.Fprintf(w, \"DENY:  %d\\n\", s.ByAction[\"DENY\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.227065, "o", "> "]
[1556.227173, "o", "    fmt.Fprintf(w, \"DROP:  %d\\n\", s.ByAction[\"DROP\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1556.227249, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
