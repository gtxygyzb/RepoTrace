[1863.707144, "o", "for i := 0; i < len(evs); i++ {\r\n   220\t\t\t\tstart, ok := eventTime(evs[i])\r\n   221\t\t\t\tif !ok {\r\n   222\t\t\t\t\tcontinue\r\n   223\t\t\t\t}\r\n   224\t\t\t\tvar window []Event\r\n   225\t\t\t\tfor j := i; j < len(evs); j++ {\r\n   226\t\t\t\t\tt, ok := eventTime(evs[j])\r\n   227\t\t\t\t\tif !ok {\r\n   228\t"]
[1863.707244, "o", "\t\t\t\t\tcontinue\r\n   229\t\t\t\t\t}\r\n   230\t\t\t\t\tif t.Sub(start) <= 60*time.Second {\r\n   231\t\t\t\t\t\twindow = append(window, evs[j])\r\n   232\t\t\t\t\t} else {\r\n   233\t\t\t\t\t\tbreak\r\n   234\t\t\t\t\t}\r\n   235\t\t\t\t}\r\n   236\t\t\t\tif len(window) >= 5 {\r\n   237\t\t\t\t\tusers := make([]string, 0, len(window))\r\n   238\t\t\t\t\tfor _, e := range window {\r\n   239\t\t\t\t\t\tusers = append(users, e.User)\r\n   240\t\t\t\t\t}\r\n"]
