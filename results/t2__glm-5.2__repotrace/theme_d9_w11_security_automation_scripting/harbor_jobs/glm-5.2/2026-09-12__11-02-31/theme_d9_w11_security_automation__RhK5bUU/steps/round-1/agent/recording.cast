[2825.612, "o", "   197\t\r\n   198\tfunc enrichThreat(threat map[string]interface{}, iocs []processedIOC, fixedRef time.Time, hasRef bool, minConf float64) map[string]interface{} {\r\n   199\t\trefTime := fixedRef\r\n   200\t\tif !hasRef {\r\n   201\t\t\trefTime = threatReferenceTime(threat)\r\n   202\t\t}\r\n   203\t\r\n   204\t\tmatches := computeIOCMatches(threat, iocs, refTime, minConf)\r\n   205\t\r\n   206\t\triskScore, _ := getFloat(threat, \"risk_score\")\r\n   207\t\tmaxConf := 0.0\r\n   208\t\ttagFactor := make(map[string]float64)\r\n   209"]
[2825.612067, "o", "\t\tseverityContrib := 0\r\n   210\t\tindicatorTypes := make(map[string]bool)\r\n   211\t\tactors := make(map[string]bool)\r\n   212\t\tsevRank := 0\r\n   213\t\r\n   214\t\tfor _, m := range matches {\r\n   215\t\t\tif m.adjusted > maxConf {\r\n   216\t\t\t\tmaxConf = m.adjusted\r\n   217\t\t\t}\r\n"]
