[8931.139272, "i", "grep -n \"anomaly\" main.go\n"]
[8931.139559, "o", "grep -n \"anomaly\" main.go\r\n\u001b[?2004l\r"]
[8931.142589, "o", "\u001b[32m\u001b[K11\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|track|diff|\u001b[01;31m\u001b[Kanomaly\u001b[m\u001b[K> [flags]\")\r\n\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kanomaly\u001b[m\u001b[K\":\r\n"]
[8931.143111, "o", "\u001b[?2004hroot@n30009:/app# "]
[8931.415867, "i", "sed -n '1,260p' anomaly.go\n"]
[8931.416132, "o", "sed -n '1,260p' anomaly.go\r\n"]
[8931.416254, "o", "\u001b[?2004l\r"]
[8931.419017, "o", "package main\r\n\r\nimport (\r\n\"bufio\"\r\n\"encoding/json\"\r\n\"fmt\"\r\n\"io\"\r\n\"math\"\r\n\"os\"\r\n\"sort\"\r\n\"strings\"\r\n)\r\n\r\ntype anomalyInputSnapshot struct {\r\nGlobalMeanRisk float64 `json:\"global_mean_risk\"`\r\n"]
[8931.419128, "o", "TotalThreats   int     `json:\"total_threats\"`\r\n}\r\n\r\ntype anomalyMetricResult struct {\r\nValue          json.Number `json:\"value\"`\r\nBaselineMean   json.Number `json:\"baseline_mean\"`\r\nBaselineStddev json.Number `json:\"baseline_stddev\"`\r\nZScore         json.Number `json:\"z_score\"`\r\n}\r\n\r\ntype anomalyRecord struct {\r\nIndex         int                             `json:\"index\"`\r\nMetrics       map[string]anomalyMetricResult  `json:\"metrics\"`\r\nCombinedZ     json.Number                     `json:\"combined_z\"`\r\nBaselineCount int                             `json:\"baseline_count\"`\r\nDirection     string                          `json:\"direction\"`\r\nSeverity      string                          `json:\"severity\"`\r\n}\r\n\r\nfunc runAnomaly(args []string) int {\r\nfs := newFlagSet(\"anomaly\")\r\nwindow := fs.Int(\"window\", 5, \"baseline window size\")\r\nthreshold := fs.Float64(\"threshold\", 2.0, \"combined z-score anomaly threshold\")\r\nif !parseFlags(fs, args) {\r\n"]
[8931.419207, "o", "return 1\r\n}\r\n\r\nif *window < 2 {\r\nfmt.Fprintln(os.Stderr, \"error: --window must be at least 2\")\r\nreturn 1\r\n}\r\n\r\nvar snapshots []anomalyInputSnapshot\r\nreader := bufio.NewReader(os.Stdin)\r\nfor {\r\nline, err := reader.ReadString('\\n')\r\ntrimmed := strings.TrimSpace(line)\r\nif trimmed == \"\" {\r\nif err == io.EOF {\r\nbreak\r\n}\r\n"]
[8931.419363, "o", "continue\r\n}\r\n\r\nvar snap anomalyInputSnapshot\r\nif jerr := json.Unmarshal([]byte(trimmed), &snap); jerr != nil {\r\nfmt.Fprintln(os.Stderr, \"error: malformed JSON input:\", jerr)\r\nreturn 2\r\n}\r\nsnapshots = append(snapshots, snap)\r\n\r\nif err == io.EOF {\r\nbreak\r\n}\r\n}\r\n\r\nif len(snapshots) < 3 {\r\nfmt.Fprintln(os.Stderr, \"error: requires at least 3 valid JSON lines on stdin\")\r\nreturn 1\r\n}\r\n\r\nrisks := make([]float64, len(snapshots))\r\nthreats := make([]float64, len(snapshots))\r\nfor i, snap := range snapshots {\r\nrisks[i] = snap.GlobalMeanRisk\r\nthreats[i] = float64(snap.TotalThreats)\r\n}\r\n\r\nvar anomalies []anomalyRecord\r\nfor i := 0; i < len(snapshots); i++ {\r\nstart := i - *window\r\n"]
[8931.419429, "o", "if start < 0 {\r\nstart = 0\r\n}\r\nbaseline := i - start\r\nif baseline < 2 {\r\ncontinue\r\n}\r\n\r\nriskMean, riskStd := baselineStats(risks[start:i])\r\nthreatMean, threatStd := baselineStats(threats[start:i])\r\n\r\nriskZ := zScore(risks[i], riskMean, riskStd)\r\nthreatZ := zScore(threats[i], threatMean, threatStd)\r\ncombinedZ := math.Sqrt(riskZ*riskZ + threatZ*threatZ)\r\n\r\nif combinedZ < *threshold {\r\n"]
[8931.419492, "o", "continue\r\n}\r\n\r\ndirection := \"mixed\"\r\nif riskZ >= 0 && threatZ >= 0 {\r\ndirection = \"above\"\r\n} else if riskZ <= 0 && threatZ <= 0 {\r\ndirection = \"below\"\r\n}\r\n\r\nseverity := \"moderate\"\r\nif combinedZ >= 4.0 {\r\nseverity = \"extreme\"\r\n"]
[8931.419559, "o", "} else if combinedZ >= 3.0 {\r\nseverity = \"high\"\r\n}\r\n\r\nanomalies = append(anomalies, anomalyRecord{\r\nIndex: i,\r\nMetrics: map[string]anomalyMetricResult{\r\n\"global_mean_risk\": {\r\nValue:          numberFromFloat(risks[i], false),\r\nBaselineMean:   json.Number(round4String(riskMean)),\r\nBaselineStddev: json.Number(round4String(riskStd)),\r\nZScore:         json.Number(round4String(riskZ)),\r\n"]
[8931.419616, "o", "},\r\n\"total_threats\": {\r\nValue:          numberFromFloat(threats[i], true),\r\nBaselineMean:   json.Number(round4String(threatMean)),\r\nBaselineStddev: json.Number(round4String(threatStd)),\r\nZScore:         json.Number(round4String(threatZ)),\r\n},\r\n},\r\nCombinedZ:     json.Number(round4String(combinedZ)),\r\nBaselineCount: baseline,\r\nDirection:     direction,\r\nSeverity:      severity,\r\n})\r\n"]
[8931.419674, "o", "}\r\n\r\nsort.SliceStable(anomalies, func(a, b int) bool {\r\naZ, _ := anomalies[a].CombinedZ.Float64()\r\nbZ, _ := anomalies[b].CombinedZ.Float64()\r\nif aZ != bZ {\r\nreturn aZ > bZ\r\n}\r\nreturn anomalies[a].Index < anomalies[b].Index\r\n})\r\n\r\nencoder := json.NewEncoder(os.Stdout)\r\nencoder.SetEscapeHTML(false)\r\n"]
[8931.419743, "o", "for _, rec := range anomalies {\r\nif err := encoder.Encode(rec); err != nil {\r\nfmt.Fprintln(os.Stderr, \"error: failed to write anomaly record:\", err)\r\nreturn 1\r\n}\r\n}\r\n\r\nreturn 0\r\n}\r\n"]
[8931.419805, "o", "\r\nfunc baselineStats(values []float64) (float64, float64) {\r\nn := len(values)\r\nif n == 0 {\r\nreturn 0, 0\r\n}\r\n\r\nsum := 0.0\r\nfor _, v := range values {\r\nsum += v\r\n}\r\nmean := sum / float64(n)\r\n\r\nsquaredSum := 0.0\r\nfor _, v := range values {\r\ndiff := v - mean\r\nsquaredSum += diff * diff\r\n}\r\n"]
[8931.419865, "o", "stddev := math.Sqrt(squaredSum / float64(n))\r\n\r\nreturn mean, stddev\r\n}\r\n\r\nfunc zScore(current, mean, stddev float64) float64 {\r\nif stddev == 0 {\r\nif current == mean {\r\nreturn 0.0\r\n}\r\nif current > mean {\r\nreturn 999.0\r\n"]
[8931.419924, "o", "}\r\nreturn -999.0\r\n}\r\nreturn (current - mean) / stddev\r\n}\r\n\r\nfunc numberFromFloat(value float64, asInteger bool) json.Number {\r\nif asInteger {\r\nreturn json.Number(fmt.Sprintf(\"%d\", int64(value)))\r\n}\r\nreturn json.Number(round4String(value))\r\n}\r\n"]
[8931.41998, "o", "\r\nfunc round4String(f float64) string {\r\nreturn fmt.Sprintf(\"%.4f\", round4(f))\r\n}\r\n"]
[8931.42046, "o", "\u001b[?2004h"]
[8931.420519, "o", "root@n30009:/app# "]
[8931.699929, "i", "gofmt -w anomaly.go main.go\n"]
[8931.700185, "o", "gofmt -w anomaly.go main.go\r\n\u001b[?2004l\r"]
[8931.711183, "o", "\u001b[?2004h"]
[8931.711389, "o", "root@n30009:/app# "]
