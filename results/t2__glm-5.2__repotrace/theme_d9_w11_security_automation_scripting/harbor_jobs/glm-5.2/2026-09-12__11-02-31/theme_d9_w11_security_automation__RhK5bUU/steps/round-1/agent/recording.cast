[10312.153829, "o", "> "]
[10312.154069, "o", "func runForecast(args []string) int {\r\n\u001b[?2004l\r"]
[10312.154132, "o", "\u001b[?2004h> "]
[10312.154347, "o", "\\tfs := newFlagSet(\"forecast\")\r\n\u001b[?2004l\r"]
[10312.154408, "o", "\u001b[?2004h> "]
[10312.15486, "o", "\\tsteps := fs.Int(\"steps\", 3, \"number of future steps to predict\")\r\n\u001b[?2004l\r"]
[10312.154911, "o", "\u001b[?2004h> "]
[10312.155111, "o", "\\tif !parseFlags(fs, args) {\r\n\u001b[?2004l\r"]
[10312.155172, "o", "\u001b[?2004h> "]
[10312.155271, "o", "\\t\\treturn 1\r\n\u001b[?2004l\r"]
[10312.155339, "o", "\u001b[?2004h> "]
[10312.155393, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10312.15553, "o", "\\tif *steps < 1 {\r\n\u001b[?2004l\r"]
[10312.155606, "o", "\u001b[?2004h> "]
[10312.155999, "o", "\\t\\tfmt.Fprintln(os.Stderr, \"error: --steps must be at least 1\")\r\n\u001b[?2004l\r"]
[10312.156064, "o", "\u001b[?2004h> "]
[10312.156133, "o", "\\t\\treturn 1\r\n\u001b[?2004l\r"]
[10312.156187, "o", "\u001b[?2004h> "]
[10312.156249, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.156305, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h"]
[10312.156363, "o", "> "]
[10312.156582, "o", "\\tvar snapshots []forecastInputSnapshot\r\n"]
[10312.156636, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[10312.156906, "o", "\\tscanner := bufio.NewScanner(os.Stdin)\r\n\u001b[?2004l\r"]
[10312.156964, "o", "\u001b[?2004h> "]
[10312.157314, "o", "\\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n\u001b[?2004l\r"]
[10312.157371, "o", "\u001b[?2004h> "]
[10312.157516, "o", "\\tfor scanner.Scan() {\r\n\u001b[?2004l\r"]
[10312.157582, "o", "\u001b[?2004h> "]
[10312.157743, "o", "\\t\\tline := scanner.Text()\r\n\u001b[?2004l\r"]
[10312.157797, "o", "\u001b[?2004h> "]
[10312.157943, "o", "\\t\\tif len(line) == 0 {\r\n\u001b[?2004l\r"]
[10312.158005, "o", "\u001b[?2004h> "]
[10312.158104, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[10312.158159, "o", "\u001b[?2004h> "]
[10312.158205, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[10312.158276, "o", "\u001b[?2004h> "]
[10312.158482, "o", "\\t\\tvar snap forecastInputSnapshot\r\n\u001b[?2004l\r"]
[10312.158538, "o", "\u001b[?2004h> "]
[10312.158939, "o", "\\t\\tif err := json.Unmarshal([]byte(line), &snap); err != nil {\r\n\u001b[?2004l\r"]
[10312.158994, "o", "\u001b[?2004h> "]
[10312.15946, "o", "\\t\\t\\tfmt.Fprintf(os.Stderr, \"error: malformed JSON input: %s\\\\n\", err)\r\n\u001b[?2004l\r"]
[10312.159517, "o", "\u001b[?2004h> "]
[10312.159609, "o", "\\t\\t\\treturn 2\r\n\u001b[?2004l\r"]
[10312.159665, "o", "\u001b[?2004h> "]
[10312.159721, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[10312.159777, "o", "\u001b[?2004h> "]
[10312.160004, "o", "\\t\\tsnapshots = append(snapshots, snap)\r\n\u001b[?2004l\r"]
[10312.160067, "o", "\u001b[?2004h> "]
[10312.160126, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.16018, "o", "> "]
[10312.160376, "o", "\\tif err := scanner.Err(); err != nil {\r\n\u001b[?2004l\r"]
[10312.160435, "o", "\u001b[?2004h> "]
[10312.160742, "o", "\\t\\tfmt.Fprintf(os.Stderr, \"error: reading input: %s\\\\n\", err)\r\n\u001b[?2004l\r"]
[10312.160796, "o", "\u001b[?2004h> "]
[10312.160865, "o", "\\t\\treturn 1\r\n\u001b[?2004l\r"]
[10312.160927, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[10312.161017, "o", "\u001b[?2004h> "]
[10312.161117, "o", "\\tif len(snapshots) < 3 {\r\n\u001b[?2004l\r"]
[10312.161178, "o", "\u001b[?2004h> "]
[10312.161596, "o", "\\t\\tfmt.Fprintln(os.Stderr, \"error: at least 3 valid input snapshots are required\")\r\n\u001b[?2004l\r"]
[10312.161653, "o", "\u001b[?2004h> "]
[10312.161717, "o", "\\t\\treturn 1\r\n\u001b[?2004l\r"]
[10312.161781, "o", "\u001b[?2004h> \\t}\r\n"]
[10312.161835, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[10312.161894, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[10312.162121, "o", "\\trisks := make([]float64, len(snapshots))\r\n\u001b[?2004l\r"]
[10312.162175, "o", "\u001b[?2004h> "]
[10312.162408, "o", "\\tthreats := make([]float64, len(snapshots))\r\n\u001b[?2004l\r"]
[10312.162464, "o", "\u001b[?2004h> "]
[10312.162641, "o", "\\tfor i, snap := range snapshots {\r\n\u001b[?2004l\r"]
[10312.162695, "o", "\u001b[?2004h> "]
[10312.16287, "o", "\\t\\trisks[i] = snap.GlobalMeanRisk\r\n\u001b[?2004l\r"]
[10312.162925, "o", "\u001b[?2004h> "]
[10312.163141, "o", "\\t\\tthreats[i] = float64(snap.TotalThreats)\r\n\u001b[?2004l\r"]
[10312.163196, "o", "\u001b[?2004h> "]
[10312.16327, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[10312.163325, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[10312.163573, "o", "\\triskSlope, riskIntercept := olsLine(0, risks)\r\n\u001b[?2004l\r"]
[10312.163628, "o", "\u001b[?2004h> "]
[10312.163896, "o", "\\tthreatSlope, threatIntercept := olsLine(0, threats)\r\n\u001b[?2004l\r"]
[10312.16395, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[10312.164004, "o", "\u001b[?2004h> "]
[10312.164382, "o", "\\triskPredictions := predictLine(riskSlope, riskIntercept, len(snapshots), *steps)\r\n\u001b[?2004l\r"]
[10312.164439, "o", "\u001b[?2004h> "]
[10312.164752, "o", "\\tthreatPredictions := predictLine(threatSlope, threatIntercept, len(snapshots), *steps)\r\n\u001b[?2004l\r"]
[10312.164808, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.164862, "o", "> "]
[10312.164985, "o", "\\triskTrend := trendFromSlope(riskSlope)\r\n\u001b[?2004l\r"]
[10312.165039, "o", "\u001b[?2004h> "]
[10312.165195, "o", "\\tthreatTrend := trendFromSlope(threatSlope)\r\n\u001b[?2004l\r"]
[10312.165257, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.165311, "o", "> "]
[10312.165451, "o", "\\tmetrics := map[string]forecastMetricResult{\r\n\u001b[?2004l\r"]
[10312.165504, "o", "\u001b[?2004h> "]
[10312.165587, "o", "\\t\\t\"global_mean_risk\": {\r\n\u001b[?2004l\r"]
[10312.16561, "o", "\u001b[?2004h> "]
[10312.165792, "o", "\\t\\t\\tSlope:       roundHalfUp4(riskSlope),\r\n\u001b[?2004l\r"]
[10312.165812, "o", "\u001b[?2004h> "]
[10312.195778, "o", "\\t\\t\\tIntercept:   roundHalfUp4(riskIntercept),\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tTrend:       riskTrend,\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tLastValue:   snapshots[len(snapshots)-1].GlobalMeanRisk,\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tPredictions: roundAll4(riskPredictions),\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t},\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\"total_threats\": {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tSlope:       roundHalfUp4(threatSlope),\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tIntercept:   roundHalfUp4(threatIntercept),\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tTrend:       threatTrend,\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tLastValue:   snapshots[len(snapshots)-1].TotalThreats,\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tPredictions: roundAll4(threatPredictions),\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t},\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \\tout := forecastOutput{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10312.195932, "o", "\\t\\tInputCount:   len(snapshots),\r\n\u001b[?2004l\r"]
[10312.196005, "o", "\u001b[?2004h> "]
[10312.196141, "o", "\\t\\tMetrics:      metrics,\r\n\u001b[?2004l\r"]
[10312.196205, "o", "\u001b[?2004h> "]
[10312.196523, "o", "\\t\\tOverallTrend: overallTrend(riskTrend, threatTrend),\r\n\u001b[?2004l\r"]
[10312.19658, "o", "\u001b[?2004h> "]
[10312.19703, "o", "\\t\\tAlertLevel:   alertLevelFromSlopes(risks, threats, riskSlope, threatSlope),\r\n\u001b[?2004l\r"]
[10312.197086, "o", "\u001b[?2004h> "]
[10312.197141, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.197196, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.197266, "o", "> "]
[10312.197446, "o", "\\tencoded, err := json.Marshal(out)\r\n\u001b[?2004l\r"]
[10312.197506, "o", "\u001b[?2004h> "]
[10312.197608, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[10312.197668, "o", "\u001b[?2004h> "]
[10312.198052, "o", "\\t\\tfmt.Fprintln(os.Stderr, \"error: encoding forecast output:\", err)\r\n\u001b[?2004l\r"]
[10312.198098, "o", "\u001b[?2004h> "]
[10312.198189, "o", "\\t\\treturn 1\r\n\u001b[?2004l\r"]
[10312.198254, "o", "\u001b[?2004h> "]
[10312.19831, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.198364, "o", "> "]
[10312.19851, "o", "\\tfmt.Println(string(encoded))\r\n\u001b[?2004l\r"]
[10312.198575, "o", "\u001b[?2004h> "]
[10312.198635, "o", "\\treturn 0\r\n\u001b[?2004l\r"]
[10312.198682, "o", "\u001b[?2004h> "]
[10312.198737, "o", "}\r\n\u001b[?2004l\r"]
[10312.198791, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.198845, "o", "> "]
[10312.199258, "o", "func olsLine(startIndex int, values []float64) (slope, intercept float64) {\r\n\u001b[?2004l\r"]
[10312.199322, "o", "\u001b[?2004h> "]
[10312.199429, "o", "\\tn := len(values)\r\n\u001b[?2004l\r"]
[10312.199507, "o", "\u001b[?2004h> "]
[10312.199583, "o", "\\tif n == 0 {\r\n\u001b[?2004l\r"]
[10312.199659, "o", "\u001b[?2004h> "]
[10312.199723, "o", "\\t\\treturn 0, 0\r\n\u001b[?2004l\r"]
[10312.199784, "o", "\u001b[?2004h> "]
[10312.199843, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10312.200078, "o", "\\tvar sumX, sumY, sumXY, sumX2 float64\r\n\u001b[?2004l\r"]
[10312.200126, "o", "\u001b[?2004h> "]
[10312.20031, "o", "\\tfor i, y := range values {\r\n\u001b[?2004l\r"]
[10312.200374, "o", "\u001b[?2004h> "]
[10312.200554, "o", "\\t\\tx := float64(startIndex + i)\r\n\u001b[?2004l\r"]
[10312.200617, "o", "\u001b[?2004h> "]
[10312.200695, "o", "\\t\\tsumX += x\r\n\u001b[?2004l\r"]
[10312.200741, "o", "\u001b[?2004h> "]
[10312.200834, "o", "\\t\\tsumY += y\r\n\u001b[?2004l\r"]
[10312.200891, "o", "\u001b[?2004h> "]
[10312.201001, "o", "\\t\\tsumXY += x * y\r\n\u001b[?2004l\r"]
[10312.201058, "o", "\u001b[?2004h> "]
[10312.201168, "o", "\\t\\tsumX2 += x * x\r\n\u001b[?2004l\r"]
[10312.201239, "o", "\u001b[?2004h> "]
[10312.201295, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.20135, "o", "> "]
[10312.201491, "o", "\u0007"]
[10312.201731, "o", "denom := float64(n)*sumX2 - sumX*sumX\r\n\u001b[?2004l\r"]
[10312.201799, "o", "\u001b[?2004h"]
[10312.201854, "o", "> "]
[10312.201925, "o", "\\tif denom == 0 {\r\n\u001b[?2004l\r"]
[10312.201988, "o", "\u001b[?2004h> "]
[10312.202067, "o", "\\t\\tslope = 0\r\n\u001b[?2004l\r"]
[10312.202129, "o", "\u001b[?2004h> "]
[10312.202284, "o", "\\t\\tintercept = values[0]\r\n\u001b[?2004l\r"]
[10312.202348, "o", "\u001b[?2004h> "]
[10312.202413, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[10312.202459, "o", "\u001b[?2004h> "]
[10312.20253, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.202585, "o", "> "]
[10312.20266, "o", "\u0007"]
[10312.20293, "o", "slope = (float64(n)*sumXY - sumX*sumY) / denom\r\n\u001b[?2004l\r"]
[10312.202994, "o", "\u001b[?2004h> "]
[10312.203271, "o", "\\tintercept = (sumY - slope*sumX) / float64(n)\r\n\u001b[?2004l\r"]
[10312.203336, "o", "\u001b[?2004h> "]
[10312.203396, "o", "\\treturn\r\n\u001b[?2004l\r"]
[10312.203455, "o", "\u001b[?2004h> }\r\n"]
[10312.20351, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[10312.203568, "o", "\u001b[?2004h> "]
[10312.204015, "o", "func predictLine(slope, intercept float64, startIndex, steps int) []float64 {\r\n\u001b[?2004l\r"]
[10312.204077, "o", "\u001b[?2004h> "]
[10312.204306, "o", "\\tpredictions := make([]float64, steps)\r\n\u001b[?2004l\r"]
[10312.204368, "o", "\u001b[?2004h> "]
[10312.204544, "o", "\\tfor i := 0; i < steps; i++ {\r\n\u001b[?2004l\r"]
[10312.204601, "o", "\u001b[?2004h> "]
[10312.204946, "o", "\\t\\tpredictions[i] = slope*float64(startIndex+i) + intercept\r\n\u001b[?2004l\r"]
[10312.205011, "o", "\u001b[?2004h> "]
[10312.205067, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.205122, "o", "> "]
[10312.205216, "o", "\\treturn predictions\r\n\u001b[?2004l\r"]
[10312.205279, "o", "\u001b[?2004h> }\r\n"]
[10312.205333, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[10312.205387, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[10312.205621, "o", "func trendFromSlope(slope float64) string {\r\n\u001b[?2004l\r"]
[10312.205676, "o", "\u001b[?2004h> "]
[10312.20581, "o", "\\tr := roundHalfUp4(slope)\r\n\u001b[?2004l\r"]
[10312.205864, "o", "\u001b[?2004h> "]
[10312.20593, "o", "\\tif r > 0 {\r\n\u001b[?2004l\r"]
[10312.205984, "o", "\u001b[?2004h> "]
[10312.206105, "o", "\\t\\treturn \"increasing\"\r\n\u001b[?2004l\r"]
[10312.20616, "o", "\u001b[?2004h> "]
[10312.206221, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.206277, "o", "> "]
[10312.206333, "o", "\\tif r < 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.206388, "o", "> "]
[10312.206482, "o", "\\t\\treturn \"decreasing\"\r\n\u001b[?2004l\r"]
[10312.206537, "o", "\u001b[?2004h> "]
[10312.206591, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.206645, "o", "> "]
[10312.206704, "o", "\\treturn \"stable\"\r\n\u001b[?2004l\r"]
[10312.206758, "o", "\u001b[?2004h> }\r\n"]
[10312.206813, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[10312.206872, "o", "\u001b[?2004h> "]
[10312.207071, "o", "func overallTrend(a, b string) string {\r\n\u001b[?2004l\r"]
[10312.207135, "o", "\u001b[?2004h> "]
[10312.207365, "o", "\\tif a == \"increasing\" && b == \"increasing\" {\r\n\u001b[?2004l\r"]
[10312.207422, "o", "\u001b[?2004h> "]
[10312.207541, "o", "\\t\\treturn \"increasing\"\r\n\u001b[?2004l\r"]
[10312.207597, "o", "\u001b[?2004h> "]
[10312.207652, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.207706, "o", "> "]
[10312.207901, "o", "\\tif a == \"decreasing\" && b == \"decreasing\" {\r\n\u001b[?2004l\r"]
[10312.207957, "o", "\u001b[?2004h> "]
[10312.208076, "o", "\\t\\treturn \"decreasing\"\r\n\u001b[?2004l\r"]
[10312.208133, "o", "\u001b[?2004h> "]
[10312.208187, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.208253, "o", "> "]
[10312.208442, "o", "\\tif a == \"increasing\" || b == \"increasing\" {\r\n\u001b[?2004l\r"]
[10312.208497, "o", "\u001b[?2004h> "]
[10312.208736, "o", "\\t\\tif a == \"decreasing\" || b == \"decreasing\" {\r\n\u001b[?2004l\r"]
[10312.208792, "o", "\u001b[?2004h> "]
[10312.208895, "o", "\\t\\t\\treturn \"mixed\"\r\n\u001b[?2004l\r"]
[10312.20895, "o", "\u001b[?2004h> "]
[10312.20901, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.209064, "o", "> "]
[10312.209154, "o", "\\t\\treturn \"increasing\"\r\n\u001b[?2004l\r"]
[10312.209209, "o", "\u001b[?2004h> "]
[10312.209274, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10312.209518, "o", "\\tif a == \"decreasing\" || b == \"decreasing\" {\r\n\u001b[?2004l\r"]
[10312.209573, "o", "\u001b[?2004h> "]
[10312.209693, "o", "\\t\\treturn \"decreasing\"\r\n\u001b[?2004l\r"]
[10312.209747, "o", "\u001b[?2004h> "]
[10312.209803, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10312.209913, "o", "\\treturn \"stable\"\r\n\u001b[?2004l\r"]
[10312.209968, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[10312.210028, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[10312.210074, "o", "\u001b[?2004h> "]
[10312.210557, "o", "func alertLevelFromSlopes(risks, threats []float64, riskSlope, threatSlope float64) string {\r\n\u001b[?2004l\r"]
[10312.210614, "o", "\u001b[?2004h> "]
[10312.21078, "o", "\\triskMean := meanOfValues(risks)\r\n\u001b[?2004l\r"]
[10312.210836, "o", "\u001b[?2004h> "]
[10312.211028, "o", "\\tthreatMean := meanOfValues(threats)\r\n\u001b[?2004l\r"]
[10312.211084, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[10312.211138, "o", "\u001b[?2004h> "]
[10312.211228, "o", "\\tmaxRatio := 0.0\r\n\u001b[?2004l\r"]
[10312.211291, "o", "\u001b[?2004h> "]
[10312.21139, "o", "\\tif riskSlope > 0 {\r\n\u001b[?2004l\r"]
[10312.211445, "o", "\u001b[?2004h> "]
[10312.211688, "o", "\\t\\tratio := riskSlope / math.Max(riskMean, 1.0)\r\n\u001b[?2004l\r"]
[10312.211743, "o", "\u001b[?2004h> "]
[10312.211875, "o", "\\t\\tif ratio > maxRatio {\r\n\u001b[?2004l\r"]
[10312.211929, "o", "\u001b[?2004h> "]
[10312.212045, "o", "\\t\\t\\tmaxRatio = ratio\r\n\u001b[?2004l\r"]
[10312.2121, "o", "\u001b[?2004h> "]
[10312.21216, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.212225, "o", "> \\t}\r\n\u001b[?2004l\r"]
[10312.212282, "o", "\u001b[?2004h> "]
[10312.212387, "o", "\\tif threatSlope > 0 {\r\n\u001b[?2004l\r"]
[10312.212441, "o", "\u001b[?2004h> "]
[10312.212705, "o", "\\t\\tratio := threatSlope / math.Max(threatMean, 1.0)\r\n\u001b[?2004l\r"]
[10312.21276, "o", "\u001b[?2004h> "]
[10312.21289, "o", "\\t\\tif ratio > maxRatio {\r\n\u001b[?2004l\r"]
[10312.212947, "o", "\u001b[?2004h> "]
[10312.213063, "o", "\\t\\t\\tmaxRatio = ratio\r\n\u001b[?2004l\r"]
[10312.213118, "o", "\u001b[?2004h> "]
[10312.213173, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[10312.213236, "o", "> \\t}\r\n\u001b[?2004l\r"]
[10312.21329, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[10312.213348, "o", "\u001b[?2004h> "]
[10312.213456, "o", "\\tif maxRatio >= 0.5 {\r\n\u001b[?2004l\r"]
[10312.21351, "o", "\u001b[?2004h> "]
[10312.21362, "o", "\\t\\treturn \"critical\"\r\n\u001b[?2004l\r"]
[10312.213675, "o", "\u001b[?2004h> "]
[10312.213734, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10312.213863, "o", "\\tif maxRatio >= 0.2 {\r\n\u001b[?2004l\r"]
[10312.213918, "o", "\u001b[?2004h> "]
[10312.214023, "o", "\\t\\treturn \"warning\"\r\n\u001b[?2004l\r"]
[10312.214077, "o", "\u001b[?2004h> "]
[10312.214137, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10312.21425, "o", "\\treturn \"normal\"\r\n\u001b[?2004l\r"]
[10312.214307, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[10312.21437, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[10312.214425, "o", "\u001b[?2004h> "]
[10312.214654, "o", "func meanOfValues(values []float64) float64 {\r\n\u001b[?2004l\r"]
[10312.214709, "o", "\u001b[?2004h> "]
[10312.214831, "o", "\\tif len(values) == 0 {\r\n\u001b[?2004l\r"]
[10312.214885, "o", "\u001b[?2004h> "]
[10312.214951, "o", "\\t\\treturn 0\r\n\u001b[?2004l\r"]
[10312.215006, "o", "\u001b[?2004h> "]
[10312.215065, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10312.215173, "o", "\\tvar sum float64\r\n\u001b[?2004l\r"]
[10312.215235, "o", "\u001b[?2004h> "]
[10312.215381, "o", "\\tfor _, v := range values {\r\n\u001b[?2004l\r"]
[10312.215436, "o", "\u001b[?2004h> "]
[10312.215499, "o", "\\t\\tsum += v\r\n\u001b[?2004l\r"]
[10312.215555, "o", "\u001b[?2004h> "]
[10312.215611, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10312.215738, "o", "\\treturn sum / float64(len(values))\r\n\u001b[?2004l\r"]
[10312.215793, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[10312.215847, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[10312.216018, "o", "func roundAll4(values []float64) []float64 {\r\n\u001b[?2004l\r"]
[10312.216074, "o", "\u001b[?2004h> "]
[10312.216192, "o", "\\tout := make([]float64, len(values))\r\n\u001b[?2004l\r"]
[10312.216255, "o", "\u001b[?2004h> "]
[10312.21634, "o", "\\tfor i, v := range values {\r\n\u001b[?2004l\r"]
[10312.216394, "o", "\u001b[?2004h> "]
[10312.21648, "o", "\\t\\tout[i] = roundHalfUp4(v)\r\n\u001b[?2004l\r"]
[10312.216534, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[10312.216603, "o", "\u001b[?2004h> \\treturn out\r\n\u001b[?2004l\r"]
[10312.216658, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[10312.216713, "o", "\u001b[?2004h> ''')\r\n\u001b[?2004l\r"]
[10312.216767, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
