[10235.276321, "o", "    47\t\t\tcode = 1\r\n    48\t\t}\r\n    49\t\tos.Exit(code)\r\n    50\t}\r\n    51\t\r\n    52\tfunc newFlagSet(name string) *flag.FlagSet {\r\n    53\t\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n    54\t\tfs.SetOutput(os.Stderr)\r\n    55\t\tfs.Usage = func() {}\r\n    56\t\t"]
[10235.276389, "o", "return fs\r\n    57\t}\r\n    58\t\r\n    59\tfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n    60\t\tif err := fs.Parse(args); err != nil {\r\n"]
[10235.276456, "o", "    61\t\t\treturn false\r\n    62\t\t}\r\n    63\t\treturn true\r\n    64\t}\r\n    65\t\r\n    66\tfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n    67\t\tset := false\r\n    68\t\tfs.Visit(func(f *flag.Flag) {\r\n    69\t\t\tif f.Name == name {\r\n    70\t\t\t\tset = true\r\n    71\t\t\t"]
