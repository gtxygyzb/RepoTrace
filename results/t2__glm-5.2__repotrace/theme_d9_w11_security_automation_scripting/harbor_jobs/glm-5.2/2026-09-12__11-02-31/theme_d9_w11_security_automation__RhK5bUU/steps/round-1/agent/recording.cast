[11924.153194, "o", "   134\t\t\tintercept = values[0]\r\n   135\t\t\treturn\r\n   136\t\t}\r\n   137\t\tslope = (float64(n)*sumXY - sumX*sumY) / denom\r\n   138\t\tintercept = (sumY - slope*sumX) / float64(n)\r\n   139\t\treturn\r\n"]
[11924.153276, "o", "   140\t}\r\n   141\t\r\n   142\tfunc predictLine(slope, intercept float64, startIndex, steps int) []float64 {\r\n   143\t\tpredictions := make([]float64, steps)\r\n   144\t\tfor i := 0; i < steps; i++ {\r\n   145\t\t\tpredictions[i] = slope*float64(startIndex+i) + intercept\r\n   146\t\t}\r\n   147\t\treturn predictions\r\n   148\t}\r\n   149\t\r\n   150\tfunc trendFromSlope(slope float64) string {\r\n   151\t\tr := roundHalfUp4(slope)\r\n   152\t\tif r > 0 {\r\n   153"]
[11924.15336, "o", "\t\t\treturn \"increasing\"\r\n   154\t\t}\r\n   155\t\tif r < 0 {\r\n   156\t\t\treturn \"decreasing\"\r\n   157\t\t}\r\n   158\t\treturn \"stable\"\r\n   159\t}\r\n   160\t\r\n   161\tfunc overallTrend(a, b string) string {\r\n   162\t\tif a == \"increasing\" && b == \"increasing\" {\r\n   163\t\t\treturn \"increasing\"\r\n   164\t\t}\r\n   165\t\tif a == \"decreasing\" && b == \"decreasing\" {\r\n   166\t\t\treturn \"decreasing\"\r\n   167\t\t}\r\n   168\t\tif a == \"increasing\" || b == \"increasing\" {\r\n   169\t\t\tif a == \"decreasing\" || b == \"decreasing\" {\r\n   170\t\t\t\treturn \"mixed\"\r\n   171\t\t\t}\r\n   172\t\t\treturn \"increasing\"\r\n"]
[11924.153423, "o", "   173\t\t}\r\n   174\t\tif a == \"decreasing\" || b == \"decreasing\" {\r\n   175\t\t\treturn \"decreasing\"\r\n   176\t\t}\r\n   177\t\treturn \"stable\"\r\n   178\t}\r\n   179\t\r\n   180\tfunc alertLevelFromSlopes(risks, threats []float64, riskSlope, threatSlope float64) string {\r\n   181\t\triskMean := meanOfValues(risks)\r\n   182\t\t"]
[11924.153498, "o", "threatMean := meanOfValues(threats)\r\n   183\t\r\n   184\t\tmaxRatio := 0.0\r\n   185\t\tif riskSlope > 0 {\r\n   186\t\t\tratio := riskSlope / math.Max(riskMean, 1.0)\r\n   187\t\t\tif ratio > maxRatio {\r\n"]
[11924.153558, "o", "   188\t\t\t\tmaxRatio = ratio\r\n   189\t\t\t}\r\n   190\t\t}\r\n   191\t\tif threatSlope > 0 {\r\n   192\t\t\tratio := threatSlope / math.Max(threatMean, 1.0)\r\n   193\t\t\tif ratio > maxRatio {\r\n   194\t\t\t\tmaxRatio = ratio\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197\t\r\n   198\t\tif maxRatio >= 0.5 {\r\n   199\t\t\treturn \"critical\"\r\n   200\t\t}\r\n   201\t"]
[11924.153618, "o", "\tif maxRatio >= 0.2 {\r\n   202\t\t\treturn \"warning\"\r\n   203\t\t}\r\n   204\t\treturn \"normal\"\r\n   205\t}\r\n   206\t\r\n   207\tfunc meanOfValues(values []float64) float64 {\r\n   208\t\tif len(values) == 0 {\r\n"]
