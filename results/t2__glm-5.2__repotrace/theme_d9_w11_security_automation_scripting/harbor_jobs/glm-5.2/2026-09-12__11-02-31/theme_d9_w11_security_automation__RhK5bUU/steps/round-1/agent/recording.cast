[8219.918877, "i", "cat > diff.go <<'EOF'\npackage main\n\nimport (\n\t\"bufio\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n)\n\ntype diffReport struct {\n\tThreatCountDelta    int            `json:\"threat_count_delta\"`\n\tThreatCountPctChange float64        `json:\"threat_count_pct_change\"`\n\tRiskDelta           float64        `json:\"risk_delta\"`\n\tRiskPctChange       float64        `json:\"risk_pct_change\"`\n\tRiskTrend           string         `json:\"risk_trend\"`\n\tNewActors           []string       `json:\"new_actors\"`\n\tGoneActors          []string       `json:\"gone_actors\"`\n\tPersistentActors    []string       `json:\"persistent_actors\"`\n\tActorCountDeltas    map[string]int `json:\"actor_count_deltas\"`\n\tTypeShift           map[string]int `json:\"type_shift\"`\n\tCampaignDelta       int            `json:\"campaign_delta\"`\n\tRiskCategoryChange  diffCategory   `json:\"risk_category_change\"`\n\tEscalation          bool           `json:\"escalation\"`\n}\n\ntype diffCategory struct {\n\tFrom string `json:\"from\"`\n\tTo   string `json:\"to\"`\n}\n\nfunc runDiff(args []str"]
[8219.919149, "i", "ing) int {\n\treader := bufio.NewReader(os.Stdin)\n\n\tvar reports []aggregateReport\n\tfor {\n\t\tline, err := reader.ReadString('\\n')\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif trimmed == \"\" {\n\t\t\tif err != nil {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\n\t\tvar report aggregateReport\n\t\tif jerr := json.Unmarshal([]byte(trimmed), &report); jerr != nil {\n\t\t\tfmt.Fprintln(os.Stderr, \"error: malformed JSON input:\", jerr)\n\t\t\treturn 2\n\t\t}\n\n\t\treports = append(reports, report)\n\t\tif len(reports) >= 2 {\n\t\t\tbreak\n\t\t}\n\n\t\tif err != nil {\n\t\t\tbreak\n\t\t}\n\t}\n\n\tif len(reports) < 2 {\n\t\tfmt.Fprintln(os.Stderr, \"error: expected two aggregate JSON objects on stdin\")\n\t\treturn 1\n\t}\n\n\tbaseline := reports[0]\n\tcurrent := reports[1]\n\n\treport := diffReport{\n\t\tThreatCountDelta: current.TotalThreats - baseline.TotalThreats,\n\t\tRiskDelta:        current.GlobalMeanRisk - baseline.GlobalMeanRisk,\n\t\tNewActors:        []string{},\n\t\tGoneActors:       []string{},\n\t\tPersistentActors: []string{},\n\t\tActorCountDeltas: map[string]int{},\n\t\tTypeShift:        map[string]int{},\n\t"]
[8219.919275, "o", "cat > diff.go <<'EOF'\r\n\u001b[?2004l\r"]
