[8885.22677, "o", "\t\tif snap.MeanEnrichedRisk > maxMeanRisk {\r\n\t\t\tmaxMeanRisk = snap.MeanEnrichedRisk\r\n\t\t}\r\n\t\tfor actor, count := range snap.ActorThreatCounts {\r\n\t\t\tactorCounts[actor] += count\r\n\t\t}\r\n\t\tdominantType := snap.DominantThreatType\r\n\t\tdominantTypeCounts[dominantType]++\r\n\t\treport.TypeCounts[dominantType] += snap.TotalThreats\r\n\r\n\t\tif err == io.EOF {\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n\treport.SnapshotCount = snapshotCount\r\n\t"]
[8885.22685, "o", "if report.TotalThreats > 0 {\r\n\t\treport.GlobalMeanRisk = round2(weightedRiskSum / float64(report.TotalThreats))\r\n\t} else {\r\n\t\treport.GlobalMeanRisk = 0.0\r\n\t}\r\n\treport.GlobalMaxMeanRisk = round2(maxMeanRisk)\r\n\treport.GlobalRiskCategory = snapshotRiskCategory(report.GlobalMeanRisk)\r\n\treport.CombinedActorCounts = actorCounts\r\n\treport.TopActor = topActorFromCounts(actorCounts)\r\n\treport.DominantThreatType = topDominantType(dominantTypeCounts)\r\n\r\n\tif report.CombinedActorCounts == nil {\r\n\t\treport.CombinedActorCounts = map[string]int{}\r\n"]
[8885.226916, "o", "\t}\r\n\tif report.TypeCounts == nil {\r\n\t\treport.TypeCounts = map[string]int{}\r\n\t}\r\n\r\n\tout, err := json.Marshal(report)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: encoding aggregate report:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tfmt.Println(string(out))\r\n"]
[8885.226985, "o", "\treturn 0\r\n}\r\n\r\nfunc topActorFromCounts(counts map[string]int) string {\r\n\tactors := make([]string, 0, len(counts))\r\n\tfor actor := range counts {\r\n\t\tactors = append(actors, actor)\r\n\t}\r\n\tsort.Strings(actors)\r\n\r\n"]
[8885.22705, "o", "\ttopActor := \"\"\r\n\tmaxCount := -1\r\n\tfor _, actor := range actors {\r\n\t\tcount := counts[actor]\r\n\t\tif count > maxCount {\r\n\t\t\tmaxCount = count\r\n\t\t\ttopActor = actor\r\n\t\t}\r\n\t}\r\n\tif maxCount < 0 {\r\n\t\treturn \"\"\r\n\t}\r\n"]
[8885.227106, "o", "\treturn topActor\r\n}\r\n\r\nfunc topDominantType(counts map[string]int) string {\r\n\ttypes := make([]string, 0, len(counts))\r\n\tfor t := range counts {\r\n\t\ttypes = append(types, t)\r\n\t}\r\n\tsort.Strings(types)\r\n\r\n"]
[8885.22717, "o", "\ttopType := \"\"\r\n\tmaxCount := -1\r\n\tfor _, t := range types {\r\n\t\tcount := counts[t]\r\n\t\tif count > maxCount {\r\n"]
[8885.227279, "o", "\t\t\tmaxCount = count\r\n\t\t\ttopType = t\r\n\t\t}\r\n\t}\r\n\tif maxCount < 0 {\r\n\t\treturn \"\"\r\n\t}\r\n\treturn topType\r\n}\r\n"]
