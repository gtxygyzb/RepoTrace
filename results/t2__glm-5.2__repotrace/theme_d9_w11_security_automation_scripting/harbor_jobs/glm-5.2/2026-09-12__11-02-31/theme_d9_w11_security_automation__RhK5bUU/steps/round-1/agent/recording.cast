[8406.59248, "i", "sed -n '1,220p' main.go\n"]
[8406.592757, "o", "sed -n '1,220p' main.go\r\n\u001b[?2004l\r"]
[8406.595598, "o", "package main\r\n\r\nimport (\r\n\t\"flag\"\r\n"]
[8406.595689, "o", "\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|diff> [flags]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar code int\r\n\tswitch os.Args[1] {\r\n\tcase \"prioritize\":\r\n\t\tcode = runPrioritize(os.Args[2:])\r\n"]
[8406.59578, "o", "\tcase \"analyze\":\r\n\t\tcode = runAnalyze(os.Args[2:])\r\n\tcase \"summarize\":\r\n\t\tcode = runSummarize(os.Args[2:])\r\n\tcase \"filter\":\r\n\t\tcode = runFilter(os.Args[2:])\r\n\tcase \"respond\":\r\n\t\tcode = runRespond(os.Args[2:])\r\n\t"]
[8406.595845, "o", "case \"enrich\":\r\n\t\tcode = runEnrich(os.Args[2:])\r\n\tcase \"correlate\":\r\n\t\tcode = runCorrelate(os.Args[2:])\r\n\tcase \"timeline\":\r\n\t\tcode = runTimeline(os.Args[2:])\r\n\tcase \"snapshot\":\r\n\t\tcode = runSnapshot(os.Args[2:])\r\n\tcase \"alert\":\r\n\t\tcode = runAlert(os.Args[2:])\r\n\tcase \"aggregate\":\r\n\t\tcode = runAggregate(os.Args[2:])\r\n\tcase \"diff\":\r\n\t\tcode = runDiff(os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n\t\tcode = 1\r\n\t}\r\n\tos.Exit(code)\r\n}\r\n\r\nfunc newFlagSet(name string) *flag.FlagSet {\r\n"]
[8406.595906, "o", "\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tfs.Usage = func() {}\r\n\treturn fs\r\n}\r\n\r\nfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn false\r\n\t}\r\n"]
[8406.595966, "o", "\treturn true\r\n}\r\n\r\nfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n\tset := false\r\n\tfs.Visit(func(f *flag.Flag) {\r\n\t\tif f.Name == name {\r\n\t\t\tset = true\r\n\t\t}\r\n\t})\r\n\treturn set\r\n"]
[8406.596022, "o", "}\r\n"]
[8406.59649, "o", "\u001b[?2004h"]
[8406.59656, "o", "root@n30009:/app# "]
[8406.875094, "i", "sed -n '1,260p' prioritize.go\n"]
[8406.875415, "o", "sed -n '1,260p' prioritize.go\r\n\u001b[?2004l\r"]
[8406.878251, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n"]
[8406.878378, "o", "\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\nconst (\r\n\twSeverity   = 0.30\r\n\twRecency    = 0.25\r\n\twRisk       = 0.25\r\n\twConfidence = 0.15\r\n\twActor      = 0.05\r\n)\r\n\r\nvar prioritySeverityRanks = map[string]int{\r\n\t\"none\":     0,\r\n"]
[8406.878453, "o", "\t\"low\":      1,\r\n\t\"medium\":   2,\r\n\t\"high\":     3,\r\n\t\"critical\": 4,\r\n}\r\n\r\ntype priorityComponents struct {\r\n\tSeverity   float64 `json:\"severity\"`\r\n\tRecency    float64 `json:\"recency\"`\r\n\tRisk       float64 `json:\"risk\"`\r\n\tConfidence float64 `json:\"confidence\"`\r\n\tActor      float64 `json:\"actor\"`\r\n}\r\n"]
[8406.878525, "o", "\r\ntype prioritizeOutput struct {\r\n\tSourceIP          string             `json:\"source_ip\"`\r\n\tThreatType        string             `json:\"threat_type\"`\r\n\tPriorityScore     float64            `json:\"priority_score\"`\r\n\tPriorityLabel     string             `json:\"priority_label\"`\r\n\tComponents        priorityComponents `json:\"components\"`\r\n\tEnrichedRiskScore float64            `json:\"enriched_risk_score\"`\r\n\tIOCSeverity       string             `json:\"ioc_severity\"`\r\n\tThreatActors      []string           `json:\"threat_actors\"`\r\n\tReferenceTime     string             `json:\"reference_time\"`\r\n"]
[8406.878607, "o", "}\r\n\r\nfunc runPrioritize(args []string) int {\r\n\tfs := newFlagSet(\"prioritize\")\r\n\trefStr := fs.String(\"reference-time\", \"\", \"reference timestamp for recency scoring (RFC3339)\")\r\n\tif !parseFlags(fs, args) {\r\n\t\treturn 1\r\n\t}\r\n\tif !isFlagSet(fs, \"reference-time\") || *refStr == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"missing --reference-time flag\")\r\n\t\treturn 1\r\n\t}\r\n"]
[8406.878677, "o", "\trefTime, err := parseTime(*refStr)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\r\n\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\r\n\tvar results []prioritizeOutput\r\n\t"]
[8406.878759, "o", "lineNo := 0\r\n\tfor scanner.Scan() {\r\n\t\tlineNo++\r\n\t\tline := scanner.Text()\r\n\t\tif line == \"\" {\r\n"]
[8406.878829, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tvar threat map[string]interface{}\r\n\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n\t\t\treturn 2\r\n"]
[8406.878891, "o", "\t\t}\r\n\t\tout, ok := prioritizeThreat(threat, refTime)\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tresults = append(results, out)\r\n\t}\r\n\tif err := scanner.Err(); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[8406.878962, "o", "\t\treturn 1\r\n\t}\r\n\r\n\tsort.SliceStable(results, func(i, j int) bool {\r\n\t\tif results[i].PriorityScore != results[j].PriorityScore {\r\n\t\t\treturn results[i].PriorityScore > results[j].PriorityScore\r\n\t\t}\r\n"]
[8406.879028, "o", "\t\treturn results[i].SourceIP < results[j].SourceIP\r\n\t})\r\n\r\n\twriter := bufio.NewWriter(os.Stdout)\r\n\tdefer writer.Flush()\r\n\tfor _, r := range results {\r\n\t\tb, err := json.Marshal(r)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"failed to encode output: %v\\n\", err)\r\n\t\t\treturn 1\r\n\t\t}\r\n\t\tfmt.Fprintln(writer, string(b))\r\n\t}\r\n"]
[8406.879094, "o", "\treturn 0\r\n}\r\n\r\nfunc prioritizeThreat(threat map[string]interface{}, refTime time.Time) (prioritizeOutput, bool) {\r\n\tsourceIP := getStringDefault(threat, \"source_ip\")\r\n\tthreatType := getStringDefault(threat, \"threat_type\")\r\n\r\n\teventTime := threatReferenceTime(threat)\r\n\trefStr := \"\"\r\n\tif !eventTime.IsZero() {\r\n\t\trefStr = eventTime.UTC().Format(time.RFC3339)\r\n"]
[8406.879157, "o", "\t}\r\n\r\n\tageMinutes := 0.0\r\n\tif !eventTime.IsZero() {\r\n\t\tageMinutes = refTime.Sub(eventTime).Minutes()\r\n\t}\r\n\tif ageMinutes < 0 {\r\n\t\tageMinutes = 0\r\n\t}\r\n\trecency := math.Pow(2, -ageMinutes/60.0)\r\n\r\n\triskScore, _ := getFloat(threat, \"enriched_risk_score\")\r\n"]
[8406.879233, "o", "\trisk := riskScore / 500.0\r\n\tif risk > 1.0 {\r\n\t\trisk = 1.0\r\n\t}\r\n\tif risk < 0 {\r\n\t\trisk = 0\r\n\t}\r\n\r\n\tconfidence := 0.0\r\n\tif c, ok := getFloat(threat, \"max_ioc_confidence\"); ok {\r\n\t\tconfidence = c"]
[8406.879291, "o", "\r\n\t}\r\n\tif confidence < 0 {\r\n\t\tconfidence = 0\r\n\t}\r\n\tif confidence > 1 {\r\n\t\tconfidence = 1\r\n\t}\r\n\r\n\tactors := []string{}\r\n\tif a, ok := getStringSlice(threat, \"threat_actors\"); ok {\r\n"]
[8406.879356, "o", "\t\tactors = a\r\n\t}\r\n\tactor := float64(len(actors)) / 3.0\r\n\tif actor > 1.0 {\r\n\t\tactor = 1.0\r\n"]
[8406.879421, "o", "\t}\r\n\tif actor < 0 {\r\n\t\tactor = 0\r\n\t}\r\n\r\n\tseverity := getStringDefault(threat, \"ioc_severity\")\r\n\tseverityRank := prioritySeverityRanks[severity]\r\n\tseverityComponent := float64(severityRank) / 4.0\r\n\r\n\tscore := wSeverity*severityComponent +\r\n\t\twRecency*recency +\r\n\t\twRisk*risk +\r\n\t\twConfidence*confidence +\r\n\t\twActor*actor\r\n\r\n\tlabel := priorityLabel(score)\r\n\r\n\treturn prioritizeOutput{\r\n\t\tSourceIP:      sourceIP,\r\n\t\tThreatType:    threatType,\r\n\t\tPriorityScore: round4(score),\r\n\t\tPriorityLabel: label,\r\n"]
[8406.879494, "o", "\t\tComponents: priorityComponents{\r\n\t\t\tSeverity:   round4(severityComponent),\r\n\t\t\tRecency:    round4(recency),\r\n\t\t\tRisk:       round4(risk),\r\n\t\t\tConfidence: round4(confidence),\r\n\t\t\tActor:      round4(actor),\r\n\t\t},\r\n\t\tEnrichedRiskScore: riskScore,\r\n\t\tIOCSeverity:       severity,\r\n\t\tThreatActors:      actors,\r\n\t\tReferenceTime:     refStr,\r\n\t}, true\r\n}\r\n\r\nfunc priorityLabel(score float64) string {\r\n"]
[8406.879561, "o", "\tswitch {\r\n\tcase score >= 0.75:\r\n\t\treturn \"critical\"\r\n\tcase score >= 0.50:\r\n\t\treturn \"high\"\r\n\tcase score >= 0.25:\r\n\t\treturn \"medium\"\r\n\tdefault:\r\n\t\treturn \"low\"\r\n\t}\r\n}\r\n\r\nfunc round4(f float64) float64 {\r\n"]
[8406.879622, "o", "\treturn math.Round(f*10000) / 10000\r\n}\r\n"]
[8406.880073, "o", "\u001b[?2004h"]
[8406.880131, "o", "root@n30009:/app# "]
[8407.154509, "i", "sed -n '1,220p' event.go\n"]
[8407.154744, "o", "sed -n '1,220p' event.go\r\n\u001b[?2004l\r"]
[8407.157593, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n"]
[8407.157677, "o", "\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\ntype Event struct {\r\n\tTimestamp   string            `json:\"timestamp\"`\r\n\tSourceIP    string            `json:\"source_ip\"`\r\n\tDestIP      string            `json:\"dest_ip\"`\r\n\tDestPort    int               `json:\"dest_port\"`\r\n\tProtocol    string            `json:\"protocol\"`\r\n\tAction      string            `json:\"action\"`\r\n\tEventType   string            `json:\"event_type\"`\r\n"]
[8407.15775, "o", "\tUser        string            `json:\"user\"`\r\n\tSeverity    string            `json:\"severity\"`\r\n\tPayloadSize int64             `json:\"payload_size\"`\r\n\tMetadata    map[string]string `json:\"metadata\"`\r\n}\r\n\r\nvar severityMap = map[string]int{\r\n\t\"low\":      1,\r\n\t\"medium\":   2,\r\n\t\"high\":     3,\r\n\t\"critical\": 4,\r\n}\r\n\r\nfunc severityValue(s string) int {\r\n\treturn severityMap[s]\r\n}\r\n\r\nfunc parseEvent(line string) (Event, error) {\r\n\tvar e Event\r\n"]
[8407.157818, "o", "\tif err := json.Unmarshal([]byte(line), &e); err != nil {\r\n\t\treturn e, err\r\n\t}\r\n\treturn e, nil\r\n}\r\n\r\nfunc parseTime(ts string) (time.Time, error) {\r\n\tt, err := time.Parse(time.RFC3339, ts)\r\n\tif err != nil {\r\n\t\treturn time.Time{}, fmt.Errorf(\"invalid timestamp %q: %w\", ts, err)\r\n\t}\r\n\treturn t, nil\r\n}\r\n\r\n"]
[8407.157885, "o", "func readEvents() ([]Event, error) {\r\n\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\tvar events []Event\r\n\tlineNo := 0\r\n\tfor scanner.Scan() {\r\n"]
[8407.157945, "o", "\t\tlineNo++\r\n\t\tline := scanner.Text()\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\te, err := parseEvent(line)\r\n\t\tif err != nil {\r\n\t\t\treturn events, fmt.Errorf(\"line %d: %w\", lineNo, err)\r\n\t\t}\r\n\t\tevents = append(events, e)\r\n\t}\r\n"]
[8407.158007, "o", "\tif err := scanner.Err(); err != nil {\r\n\t\treturn events, err\r\n\t}\r\n\treturn events, nil\r\n}\r\n\r\nfunc sortEventsByTime(events []Event) {\r\n\tsort.SliceStable(events, func(i, j int) bool {\r\n\t\t"]
[8407.158113, "o", "return events[i].Timestamp < events[j].Timestamp\r\n\t})\r\n}\r\n\r\nfunc uniqueSortedStrings(input []string) []string {\r\n\tseen := make(map[string]bool)\r\n\tvar out []string\r\n\tfor _, s := range input {\r\n\t\tif !seen[s] {\r\n\t\t\tseen[s] = true\r\n\t\t\tout = append(out, s)\r\n\t\t}\r\n\t}\r\n\tsort.Strings(out)\r\n\treturn out\r\n"]
[8407.158208, "o", "}\r\n\r\nfunc uniqueSortedInts(input []int) []int {\r\n\tseen := make(map[int]bool)\r\n\tvar out []int\r\n\tfor _, n := range input {\r\n\t\tif !seen[n] {\r\n\t\t\tseen[n] = true\r\n\t\t\tout = append(out, n)\r\n\t\t}\r\n"]
[8407.158266, "o", "\t}\r\n\tsort.Ints(out)\r\n\treturn out\r\n}\r\n\r\nfunc round2(f float64) float64 {\r\n\treturn float64(int64(f*100+0.5)) / 100\r\n}\r\n"]
