[10227.71469, "i", "sed -n '1,230p' anomaly.go\n"]
[10227.714937, "o", "sed -n '1,230p' anomaly.go\r\n\u001b[?2004l\r"]
[10227.717791, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n"]
[10227.717874, "o", "\t\"fmt\"\r\n\t\"io\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\ntype anomalyInputSnapshot struct {\r\n\tGlobalMeanRisk float64 `json:\"global_mean_risk\"`\r\n\tTotalThreats   int     `json:\"total_threats\"`\r\n}\r\n\r\ntype anomalyMetricResult struct {\r\n\tValue          json.Number `json:\"value\"`\r\n"]
[10227.71795, "o", "\tBaselineMean   json.Number `json:\"baseline_mean\"`\r\n\tBaselineStddev json.Number `json:\"baseline_stddev\"`\r\n\tZScore         json.Number `json:\"z_score\"`\r\n}\r\n\r\ntype anomalyMetrics struct {\r\n\tGlobalMeanRisk anomalyMetricResult `json:\"global_mean_risk\"`\r\n\tTotalThreats   anomalyMetricResult `json:\"total_threats\"`\r\n}\r\n\r\ntype anomalyRecord struct {\r\n\tIndex         int            `json:\"index\"`\r\n\tMetrics       anomalyMetrics `json:\"metrics\"`\r\n\tCombinedZ     json.Number    `json:\"combined_z\"`\r\n\tBaselineCount int            `json:\"baseline_count\"`"]
[10227.718003, "o", "\r\n\tDirection     string         `json:\"direction\"`\r\n\tSeverity      string         `json:\"severity\"`\r\n\r\n\troundedCombinedZ float64\r\n}\r\n\r\nfunc runAnomaly(args []string) int {\r\n\tfs := newFlagSet(\"anomaly\")\r\n\t"]
[10227.718105, "o", "window := fs.Int(\"window\", 5, \"baseline window size\")\r\n\tthreshold := fs.Float64(\"threshold\", 2.0, \"combined z-score anomaly threshold\")\r\n\tif !parseFlags(fs, args) {\r\n\t\treturn 1\r\n\t}\r\n\r\n\tif *window < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --window must be at least 2\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\tvar snapshots []anomalyInputSnapshot\r\n\treader := bufio.NewReader(os.Stdin)\r\n\tfor {\r\n\t\tline, err := reader.ReadString('\\n')\r\n\t\ttrimmed := strings.TrimSpace(line)\r\n"]
[10227.718167, "o", "\t\tif trimmed == \"\" {\r\n\t\t\tif err == io.EOF {\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tvar snap anomalyInputSnapshot\r\n\t\tif jerr := json.Unmarshal([]byte(trimmed), &snap); jerr != nil {\r\n"]
[10227.718266, "o", "\t\t\tfmt.Fprintln(os.Stderr, \"error: malformed JSON input:\", jerr)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tsnapshots = append(snapshots, snap)\r\n\r\n\t\tif err == io.EOF {\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n\tif len(snapshots) < 3 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: requires at least 3 valid JSON lines on stdin\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\trisks := make([]float64, len(snapshots))\r\n\tthreats := make([]float64, len(snapshots))\r\n\t"]
[10227.718327, "o", "for i, snap := range snapshots {\r\n\t\trisks[i] = snap.GlobalMeanRisk\r\n\t\tthreats[i] = float64(snap.TotalThreats)\r\n\t}\r\n\r\n\tvar anomalies []anomalyRecord\r\n\tfor i := 0; i < len(snapshots); i++ {\r\n\t\tstart := i - *window\r\n\t\tif start < 0 {\r\n\t\t\tstart = 0\r\n"]
[10227.718383, "o", "\t\t}\r\n\t\tbaselineCount := i - start\r\n\t\tif baselineCount < 2 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\triskMean, riskStd := baselineStats(risks[start:i])\r\n\t\tthreatMean, threatStd := baselineStats(threats[start:i])\r\n\r\n"]
[10227.718441, "o", "\t\triskZ := zScore(risks[i], riskMean, riskStd)\r\n\t\tthreatZ := zScore(threats[i], threatMean, threatStd)\r\n\t\tcombinedZ := math.Sqrt(riskZ*riskZ + threatZ*threatZ)\r\n\t\troundedCombinedZ := roundHalfUp4(combinedZ)\r\n\r\n\t\tif combinedZ < *threshold {\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tdirection := \"mixed\"\r\n\t\tif riskZ >= 0 && threatZ >= 0 {"]
[10227.718504, "o", "\r\n\t\t\tdirection = \"above\"\r\n\t\t} else if riskZ <= 0 && threatZ <= 0 {\r\n\t\t\tdirection = \"below\"\r\n\t\t}\r\n\r\n\t\tseverity := \"low\"\r\n\t\tif combinedZ >= 4.0 {\r\n\t\t\tseverity = \"extreme\"\r\n\t\t} else if combinedZ >= 3.0 {\r\n"]
[10227.718564, "o", "\t\t\tseverity = \"high\"\r\n\t\t} else if combinedZ >= 2.0 {\r\n\t\t\tseverity = \"moderate\"\r\n\t\t}\r\n\r\n\t\tanomalies = append(anomalies, anomalyRecord{\r\n\t\t\tIndex: i,\r\n\t\t\tMetrics: anomalyMetrics{\r\n\t\t\t\tGlobalMeanRisk: anomalyMetricResult{\r\n\t\t\t\t\tValue:          json.Number(formatRiskValue(risks[i])),\r\n\t\t\t\t\tBaselineMean:   json.Number(format4(riskMean)),\r\n"]
[10227.718631, "o", "\t\t\t\t\tBaselineStddev: json.Number(format4(riskStd)),\r\n\t\t\t\t\tZScore:         json.Number(format4(riskZ)),\r\n\t\t\t\t},\r\n\t\t\t\tTotalThreats: anomalyMetricResult{\r\n"]
[10227.718706, "o", "\t\t\t\t\tValue:          json.Number(strconv.FormatInt(int64(threats[i]), 10)),\r\n\t\t\t\t\tBaselineMean:   json.Number(format4(threatMean)),\r\n\t\t\t\t\tBaselineStddev: json.Number(format4(threatStd)),\r\n\t\t\t\t\tZScore:         json.Number(format4(threatZ)),\r\n\t\t\t\t},\r\n\t\t\t},\r\n\t\t\tCombinedZ:        json.Number(format4(combinedZ)),\r\n\t\t\tBaselineCount:    baselineCount,\r\n\t\t\tDirection:        direction,\r\n\t"]
[10227.718772, "o", "\t\tSeverity:         severity,\r\n\t\t\troundedCombinedZ: roundedCombinedZ,\r\n\t\t})\r\n\t}\r\n\r\n\tsort.SliceStable(anomalies, func(a, b int) bool {\r\n\t\tif anomalies[a].roundedCombinedZ != anomalies[b].roundedCombinedZ {\r\n\t\t\treturn anomalies[a].roundedCombinedZ > anomalies[b].roundedCombinedZ\r\n\t\t}\r\n\t\treturn anomalies[a].Index < anomalies[b].Index\r\n\t})\r\n"]
[10227.718832, "o", "\r\n\tencoder := json.NewEncoder(os.Stdout)\r\n\tencoder.SetEscapeHTML(false)\r\n\tfor _, rec := range anomalies {\r\n\t\tif err := encoder.Encode(rec); err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"error: failed to write anomaly record:\", err)\r\n\t\t\treturn 1\r\n\t\t}\r\n\t}\r\n\r\n\treturn 0\r\n}\r\n\r\nfunc baselineStats(values []float64) (float64, float64) {\r\n\tn := len(values)\r\n\tif n == 0 {\r\n"]
[10227.718892, "o", "\t\treturn 0, 0\r\n\t}\r\n\r\n\tsum := 0.0\r\n\tfor _, v := range values {\r\n\t\tsum += v\r\n\t}\r\n\tmean := sum / float64(n)\r\n\r\n\tsquaredSum := 0.0\r\n"]
[10227.718947, "o", "\tfor _, v := range values {\r\n\t\tdiff := v - mean\r\n\t\tsquaredSum += diff * diff\r\n\t}\r\n\tstddev := math.Sqrt(squaredSum / float64(n))\r\n\r\n\treturn mean, stddev\r\n}\r\n\r\n"]
[10227.719005, "o", "func zScore(current, mean, stddev float64) float64 {\r\n\tif stddev == 0 {\r\n\t\tif current == mean {\r\n\t\t\treturn 0.0\r\n\t\t}\r\n\t\tif current > mean {\r\n\t\t\treturn 999.0\r\n"]
[10227.719066, "o", "\t\t}\r\n\t\treturn -999.0\r\n\t}\r\n\treturn (current - mean) / stddev\r\n}\r\n\r\nfunc roundHalfUp4(f float64) float64 {\r\n\tpow := 10000.0\r\n\treturn math.Copysign(math.Floor(math.Abs(f)*pow+0.5)/pow, f)\r\n}\r\n\r\nfunc format4(f float64) string {\r\n\trounded := roundHalfUp4(f)\r\n\tif rounded == 0 {\r\n\t\treturn \"0.0000\""]
[10227.719133, "o", "\r\n\t}\r\n\treturn fmt.Sprintf(\"%.4f\", rounded)\r\n}\r\n\r\nfunc formatRiskValue(f float64) string {\r\n\ts := strconv.FormatFloat(f, 'f', -1, 64)\r\n\tif !strings.Contains(s, \".\") {\r\n\t\ts += \".0\"\r\n\t}\r\n\treturn s\r\n}\r\n"]
