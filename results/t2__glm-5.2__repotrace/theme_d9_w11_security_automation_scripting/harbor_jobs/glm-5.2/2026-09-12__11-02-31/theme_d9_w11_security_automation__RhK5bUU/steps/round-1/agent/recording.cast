[2844.16588, "o", "   287\tfunc computeIOCMatches(threat map[string]interface{}, iocs []processedIOC, refTime time.Time, minConf float64) []iocMatchInternal {\r\n   288\t\tactive := make([]activeIOC, 0, len(iocs))\r\n   289\t\tfor _, p := range iocs {\r\n   290\t\t\tbase, factor, ok := computeFreshness(p, refTime)\r\n   291\t\t\tif !ok {\r\n   292\t\t\t\tcontinue\r\n   293\t\t\t"]
[2844.165985, "o", "}\r\n   294\t\t\tif base < minConf {\r\n   295\t\t\t\tcontinue\r\n   296\t\t\t}\r\n   297\t\t\tactive = append(active, activeIOC{p: p, base: base, factor: factor})\r\n   298\t\t}\r\n   299\t\r\n   300\t\tmatchedFields := make([]map[string]bool, len(active))\r\n   301\t\tfor i := range active {\r\n   302\t\t\tmatchedFields[i] = make(map[string]bool)\r\n   303\t\t}\r\n   304\t\r\n   305\t\ttype cidrCandidate struct {\r\n   306\t\t\tactiveIdx int\r\n"]
[2844.166053, "o", "   307\t\t\tbase      float64\r\n   308\t\t\tprefixLen int\r\n   309\t\t\tiocID     string\r\n   310\t\t}\r\n   311\t\tcidrCandidates := make(map[string]map[string][]cidrCandidate)\r\n   312\t\r\n   313\t\taddCIDRCandidate := func(field, ipStr string, idx int, a activeIOC) {\r\n   314\t\t\tif cidrCandidates[field] == nil {\r\n"]
[2844.166115, "o", "   315\t\t\t\tcidrCandidates[field] = make(map[string][]cidrCandidate)\r\n   316\t\t\t}\r\n   317\t\t\tcidrCandidates[field][ipStr] = append(cidrCandidates[field][ipStr], cidrCandidate{\r\n   318\t\t\t\tactiveIdx: idx,\r\n   319\t\t\t\tbase:      a.base,\r\n   320\t\t\t\tprefixLen: a.p.prefixLen,\r\n   321\t\t\t\tiocID:     a.p.entry.ID,\r\n   322\t\t\t})\r\n   323\t\t}\r\n   324"]
[2844.166196, "o", "\t\r\n   325\t\tfor i, a := range active {\r\n   326\t\t\tswitch a.p.entry.IndicatorType {\r\n   327\t\t\tcase \"ipv4\":\r\n   328\t\t\t\tif val, ok := getString(threat, \"source_ip\"); ok && a.p.entry.Indicator == val {\r\n"]
[2844.166272, "o", "   329\t\t\t\t\tmatchedFields[i][\"source_ip\"] = true\r\n"]
