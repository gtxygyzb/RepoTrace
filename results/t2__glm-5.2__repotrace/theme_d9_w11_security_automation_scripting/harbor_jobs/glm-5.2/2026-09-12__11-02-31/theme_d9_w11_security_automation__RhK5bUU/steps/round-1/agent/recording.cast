[7859.346629, "o", "if confidence < 0 {\r\nconfidence = 0\r\n}\r\nif confidence > 1 {\r\nconfidence = 1\r\n}\r\n\r\nactors := []string{}\r\nif a, ok := getStringSlice(threat, \"threat_actors\"); ok {\r\nactors = a\r\n}\r\nactor := float64(len(actors)) / 3.0\r\nif actor > 1.0 {\r\nactor = 1.0\r\n}\r\nif actor < 0 {\r\nactor = 0\r\n}\r\n\r\nseverity := getStringDefault(threat, \"ioc_severity\")\r\n"]
[7859.346709, "o", "severityRank := prioritySeverityRanks[severity]\r\nseverityComponent := float64(severityRank) / 4.0\r\n\r\nscore := wSeverity*severityComponent +\r\nwRecency*recency +\r\nwRisk*risk +\r\nwConfidence*confidence +\r\nwActor*actor\r\n\r\nlabel := priorityLabel(score)\r\n\r\nreturn prioritizeOutput{\r\nSourceIP:          sourceIP,\r\nThreatType:        threatType,\r\nPriorityScore:     round3(score),\r\nPriorityLabel:     label,\r\nComponents: map[string]float64{\r\n\"severity\":   round3(severityComponent),\r\n\"recency\":    round3(recency),"]
[7859.346789, "o", "\r\n\"risk\":       round3(risk),\r\n\"confidence\": round3(confidence),\r\n\"actor\":      round3(actor),\r\n},\r\nEnrichedRiskScore: riskScore,\r\nIOCSeverity:       severity,\r\nThreatActors:      actors,\r\nReferenceTime:     refStr,\r\n}, true\r\n}\r\n\r\nfunc priorityLabel(score float64) string {\r\nswitch {\r\ncase score >= 0.75:\r\nreturn \"critical\"\r\ncase score >= 0.50:\r\n"]
[7859.346902, "o", "return \"high\"\r\ncase score >= 0.25:\r\nreturn \"medium\"\r\ndefault:\r\nreturn \"low\"\r\n}\r\n}\r\n"]
