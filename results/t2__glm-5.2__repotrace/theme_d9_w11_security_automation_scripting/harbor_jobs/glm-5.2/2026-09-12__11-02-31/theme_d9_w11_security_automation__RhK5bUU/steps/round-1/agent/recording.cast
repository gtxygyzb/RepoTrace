[8173.288686, "o", "    10\t\t\"strings\"\r\n    11\t)\r\n    12\t\r\n    13\ttype aggregateSnapshot struct {\r\n    14\t\tTotalThreats       int            `json:\"total_threats\"`\r\n    15\t\tActiveCampaigns    int            `json:\"active_campaigns\"`\r\n    16\t\tMeanEnrichedRisk   float64        `json:\"mean_enriched_risk\"`\r\n    17\t\tDominantThreatType string         `json:\"dominant_threat_type\"`\r\n    18\t\tActorThreatCounts  map[string]int `json:\"actor_threat_counts\"`\r\n    19\t}\r\n    20\t\r\n    21\ttype aggregateReport struct {\r\n    22\t\tSnapshotCount       int            `json:\"snapshot_count\"`\r\n    23\t\tTotalThreats        int            `json:\"total_threats\"`\r\n"]
