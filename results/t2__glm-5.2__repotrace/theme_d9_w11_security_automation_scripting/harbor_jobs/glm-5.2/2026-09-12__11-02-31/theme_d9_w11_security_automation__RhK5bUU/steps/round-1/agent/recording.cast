[10922.292197, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"flag\"\r\n     5\t\t\"fmt\"\r\n"]
[10922.292347, "o", "     6\t\t\"os\"\r\n     7\t)\r\n     8\t\r\n     9\tfunc main() {\r\n    10\t\tif len(os.Args) < 2 {\r\n    11\t\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot|alert|aggregate|prioritize|track|diff|anomaly|forecast> [flags]\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\r\n    15\t\tvar code int\r\n    16\t\tswitch os.Args[1] {\r\n    17\t\tcase \"prioritize\":\r\n    18\t\t\tcode = runPrioritize(os.Args[2:])\r\n    19\t\tcase \"analyze\":\r\n    20\t\t\tcode = runAnalyze(os.Args[2:])\r\n    21\t\tcase \"summarize\":\r\n    22\t\t\tcode = runSummarize(os.Args[2:])\r\n    23\t\tcase \"filter\":\r\n"]
[10922.292434, "o", "    24\t\t\tcode = runFilter(os.Args[2:])\r\n    25\t\tcase \"respond\":\r\n    26\t\t\tcode = runRespond(os.Args[2:])\r\n    27\t\tcase \"enrich\":\r\n    28\t\t\tcode = runEnrich(os.Args[2:])\r\n    29\t\tcase \"correlate\":\r\n    30\t\t\tcode = runCorrelate(os.Args[2:])\r\n    31\t\tcase \"timeline\":\r\n    32\t\t\tcode = runTimeline(os.Args[2:])\r\n    33\t\tcase \"snapshot\":\r\n"]
[10922.292497, "o", "    34\t\t\tcode = runSnapshot(os.Args[2:])\r\n    35\t\tcase \"alert\":\r\n    36\t\t\tcode = runAlert(os.Args[2:])\r\n    37\t\tcase \"aggregate\":\r\n    38\t\t\tcode = runAggregate(os.Args[2:])\r\n    39\t\tcase \"diff\":\r\n    40\t\t\tcode = runDiff(os.Args[2:])\r\n    41\t\tcase \"anomaly\":\r\n    42\t\t\tcode = runAnomaly(os.Args[2:])\r\n    43\t"]
[10922.292557, "o", "\tcase \"track\":\r\n    44\t\t\tcode = runTrack(os.Args[2:])\r\n    45\t\tcase \"forecast\":\r\n    46\t\t\tcode = runForecast(os.Args[2:])\r\n    47\t\tdefault:\r\n    48\t\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n    49\t\t\tcode = 1\r\n    50\t\t}\r\n"]
[10922.292615, "o", "    51\t\tos.Exit(code)\r\n    52\t}\r\n    53\t\r\n    54\tfunc newFlagSet(name string) *flag.FlagSet {\r\n    55\t\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n    56\t\tfs.SetOutput(os.Stderr)\r\n    57\t\tfs.Usage = func() {}\r\n    58\t\treturn fs\r\n"]
[10922.292678, "o", "    59\t}\r\n    60\t\r\n    61\tfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n    62\t\tif err := fs.Parse(args); err != nil {\r\n    63\t\t\treturn false\r\n    64\t\t}\r\n    65\t\treturn true\r\n    66\t}\r\n    67\t\r\n    68\tfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n"]
[10922.292735, "o", "    69\t\tset := false\r\n    70\t\tfs.Visit(func(f *flag.Flag) {\r\n    71\t\t\tif f.Name == name {\r\n    72\t\t\t\tset = true\r\n    73\t\t\t}\r\n    74\t\t})\r\n    75\t\treturn set\r\n    76\t}\r\n"]
