[951.966522, "o", ">     \"fmt\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[951.966584, "o", "    \"os\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[951.96664, "o", "> )\r\n\u001b[?2004l\r"]
[951.966697, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[951.966753, "o", "\u001b[?2004h> "]
[951.966819, "o", "func main() {\r\n\u001b[?2004l\r"]
