[1863.984652, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t)\r\n     9\t\r\n    10\tfunc runAnalyze(args []string) int {"]
[1863.984877, "o", "\r\n    11\t\tfs := newFlagSet(\"analyze\")\r\n    12\t\tchain := fs.Bool(\"chain\", false, \"perform attack chain correlation\")\r\n    13\t\tif !parseFlags(fs, args) {\r\n    14\t\t\treturn 1\r\n    15\t\t}\r\n    16\t\r\n    17\t\tevents, err := readEvents()\r\n    18\t\tif err != nil {\r\n    19\t\t\tthreats := detectThreats(events)\r\n    20\t\t\toutputThreats(threats)\r\n    21\t\t\tif *chain {\r\n    22\t\t\t\toutputChains(detectChains(threats))\r\n    23\t\t\t}\r\n    24\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    25\t\t\treturn 2\r\n    26\t\t}\r\n    27\t\r\n    28\t\tthreats := detectThreats(events)\r\n    29\t\toutputThreats(threats)\r\n    30\t\tif *chain {\r\n    31\t\t\toutputChains(detectChains(threats))\r\n    32\t\t}\r\n    33\t\treturn 0\r\n    34\t}\r\n    35\t\r\n    36\tfunc outputThreats(threats []Threat) {\r\n    37\t\tw := bufio.NewWriter(os.Stdout)\r\n    38\t\tdefer w.Flush()\r\n    39\t\tenc := json.NewEncoder(w)\r\n    40\t\tfor _, t := range threats {\r\n    41\t\t\tif err := enc.Encode(t); err != nil {\r\n    42"]
[1863.98499, "o", "\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    43\t\t\t\treturn\r\n    44\t\t\t}\r\n    45\t\t}\r\n    46\t}\r\n    47\t\r\n    48\tfunc outputChains(chains []Chain) {\r\n    49\t\tw := bufio.NewWriter(os.Stdout)\r\n    50\t\tdefer w.Flush()\r\n    51\t\tenc := json.NewEncoder(w)\r\n    52\t\tfor _, c := range chains {\r\n    53\t\t\tif err := enc.Encode(c); err != nil {\r\n    54\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    55\t\t\t\treturn\r\n    56\t\t\t}\r\n    57\t\t}\r\n    58\t}\r\n"]
