[7453.802834, "o", "    82\t\t\tstart := refUnix - ((refUnix%bucketSeconds)+bucketSeconds)%bucketSeconds\r\n    83\t\t\tif _, ok := buckets[start]; !ok {\r\n    84\t\t\t\tbucketStarts = append(bucketStarts, start)\r\n    85\t\t\t}\r\n    86\t\t\tbuckets[start] = append(buckets[start], threat)\r\n    87\t\t}\r\n    88\t\r\n    89\t\t"]
