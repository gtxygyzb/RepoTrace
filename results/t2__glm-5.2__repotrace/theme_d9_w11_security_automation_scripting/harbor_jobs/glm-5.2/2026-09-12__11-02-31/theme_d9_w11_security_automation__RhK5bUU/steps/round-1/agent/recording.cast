[6061.803018, "o", "     8\t\r\n     9\tfunc main() {\r\n    10\t\tif len(os.Args) < 2 {\r\n    11\t\t\tfmt.Fprintln(os.Stderr, \"usage: secsentinel <analyze|summarize|filter|respond|enrich|correlate|timeline|snapshot> [flags]\")\r\n    12\t\t\tos.Exit(1)\r\n    13\t\t}\r\n    14\t\r\n    15\t\tvar code int\r\n    16\t\tswitch os.Args[1] {\r\n    17\t\tcase \"analyze\":\r\n    18\t\t\tcode = runAnalyze(os.Args[2:])\r\n    19\t\tcase \"summarize\":\r\n    20\t\t"]
[6061.8031, "o", "\tcode = runSummarize(os.Args[2:])\r\n    21\t\tcase \"filter\":\r\n    22\t\t\tcode = runFilter(os.Args[2:])\r\n    23\t\tcase \"respond\":\r\n    24\t\t\tcode = runRespond(os.Args[2:])\r\n    25\t\tcase \"enrich\":\r\n    26\t\t\tcode = runEnrich(os.Args[2:])\r\n    27\t\tcase \"correlate\":\r\n    28\t\t\tcode = runCorrelate(os.Args[2:])\r\n    29\t\tcase \"timeline\":\r\n    30\t\t\tcode = runTimeline(os.Args[2:])\r\n    31\t\tcase \"snapshot\":\r\n"]
[6061.80317, "o", "    32\t\t\tcode = runSnapshot(os.Args[2:])\r\n    33\t\tdefault:\r\n    34\t\t\tfmt.Fprintf(os.Stderr, \"invalid subcommand: %s\\n\", os.Args[1])\r\n    35\t\t\tcode = 1\r\n    36\t\t}\r\n    37\t\tos.Exit(code)\r\n    38\t}\r\n    39\t\r\n    40\tfunc newFlagSet(name string) *flag.FlagSet {\r\n    41"]
[6061.803302, "o", "\t\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n    42\t\tfs.SetOutput(os.Stderr)\r\n    43\t\tfs.Usage = func() {}\r\n    44\t\treturn fs\r\n    45\t}\r\n    46\t\r\n    47\tfunc parseFlags(fs *flag.FlagSet, args []string) bool {\r\n    48\t\tif err := fs.Parse(args); err != nil {\r\n    49\t\t\treturn false\r\n    50\t\t}\r\n    51\t\treturn true\r\n    52\t}\r\n    53\t\r\n    54\tfunc isFlagSet(fs *flag.FlagSet, name string) bool {\r\n    55\t\tset := false\r\n    56\t\tfs.Visit(func(f *flag.Flag) {\r\n    57"]
[6061.803385, "o", "\t\t\tif f.Name == name {\r\n    58\t\t\t\tset = true\r\n    59\t\t\t}\r\n    60\t\t})\r\n    61\t\treturn set\r\n    62\t}\r\n"]
