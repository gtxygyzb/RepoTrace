[8084.615784, "o", "func prioritizeThreat(threat map[string]interface{}, refTime time.Time) (prioritizeOutput, bool) {\r\n\tsourceIP := getStringDefault(threat, \"source_ip\")\r\n\tthreatType := getStringDefault(threat, \"threat_type\")\r\n\r\n\teventTime := threatReferenceTime(threat)\r\n\trefStr := \"\"\r\n\tif !eventTime.IsZero() {\r\n"]
[8084.61626, "o", "\t\trefStr = eventTime.UTC().Format(time.RFC3339)\r\n\t}\r\n\r\n\tageMinutes := 0.0\r\n\tif !eventTime.IsZero() {\r\n\t\tageMinutes = refTime.Sub(eventTime).Minutes()\r\n\t}\r\n\tif ageMinutes < 0 {\r\n\t\tageMinutes = 0\r\n\t}\r\n\trecency := math.Pow(2, -ageMinutes/60.0)\r\n\r\n\u001b[?2004hroot@n30009:/app# "]
