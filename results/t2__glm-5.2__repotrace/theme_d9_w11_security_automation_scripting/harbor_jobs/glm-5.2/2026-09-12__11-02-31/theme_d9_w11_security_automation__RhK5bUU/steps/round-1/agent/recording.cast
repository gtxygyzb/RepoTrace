[2809.618099, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"net\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"time\"\r\n"]
[2809.618233, "o", ")\r\n\r\ntype iocEntry struct {\r\n\tID            string   `json:\"id\"`\r\n\tIndicator     string   `json:\"indicator\"`\r\n\tIndicatorType string   `json:\"indicator_type\"`\r\n\tThreatActor   string   `json:\"threat_actor\"`\r\n\tConfidence    float64  `json:\"confidence\"`\r\n\tTags          []string `json:\"tags\"`\r\n\tSeverity      string   `json:\"severity\"`\r\n\tLastUpdated   string   `json:\"last_updated\"`\r\n\tTTLHours      int      `json:\"ttl_hours\"`\r\n}\r\n\r\ntype processedIOC struct {\r\n\tentry       iocEntry\r\n\tlastUpdated time.Time\r\n\tttlHours    int\r\n\tip          net.IP\r\n\tipNet       *net.IPNet\r\n\tprefixLen   int\r\n\tport        int\r\n}\r\n"]
[2809.618275, "o", "\r\ntype activeIOC struct {\r\n\tp      processedIOC\r\n\tbase   float64\r\n\tfactor float64\r\n}\r\n\r\ntype iocMatchInternal struct {\r\n\tp             processedIOC\r\n\tbase          float64\r\n"]
[2809.618415, "o", "\tfreshness     float64\r\n\tadjusted      float64\r\n\tmatchedFields []string\r\n}\r\n\r\ntype iocMatchOutput struct {\r\n\tIocID         string   `json:\"ioc_id\"`\r\n\tIndicator     string   `json:\"indicator\"`\r\n\tIndicatorType string   `json:\"indicator_type\"`\r\n\tThreatActor   string   `json:\"threat_actor\"`\r\n\tConfidence    float64  `json:\"confidence\"`\r\n\tTags          []string `json:\"tags\"`\r\n\tMatchedFields []string `json:\"matched_fields\"`\r\n}\r\n\r\nfunc runEnrich(args []string) int {\r\n\tfs := newFlagSet(\"enrich\")\r\n\tiocPath := fs.String(\"ioc\", \"\", \"path to IOC database JSON file\")\r\n\trefTimeStr := fs.String(\"reference-time\", \"\", \"ISO 8601 timestamp used for TTL evaluation\")\r\n\tminConf := fs.Float64(\"min-confidence\", 0.0, \"minimum base effective confidence\")\r\n\tif !parseFlags(fs, args) {\r\n"]
[2809.618478, "o", "\t\treturn 1\r\n\t}\r\n\tif !isFlagSet(fs, \"ioc\") || *iocPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --ioc flag is required\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\thasRef := isFlagSet(fs, \"reference-time\")\r\n\tvar refTime time.Time\r\n\tif hasRef {\r\n\t\tt, err := parseTime(*refTimeStr)\r\n\t\tif err != nil {\r\n\t\t"]
[2809.618535, "o", "\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\treturn 1\r\n\t\t}\r\n\t\trefTime = t\r\n\t}\r\n\r\n\tiocs, err := loadIOCDB(*iocPath)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t"]
[2809.61859, "o", "\t\treturn 1\r\n\t\t}\r\n\t\tif _, ok := err.(*json.SyntaxError); ok {\r\n\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tif _, ok := err.(*json.UnmarshalTypeError); ok {\r\n\t"]
[2809.618666, "o", "\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\r\n"]
[2809.618726, "o", "\tscanner := bufio.NewScanner(os.Stdin)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n\tvar enriched []map[string]interface{}\r\n\tlineNo := 0\r\n\tfor scanner.Scan() {\r\n\t\tlineNo++\r\n\t\tline := scanner.Text()\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvar threat map[string]interface{}\r\n\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t"]
[2809.618785, "o", "\tenriched = append(enriched, enrichThreat(threat, iocs, refTime, hasRef, *minConf))\r\n\t}\r\n\tif err := scanner.Err(); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\r\n\tsortEnrichedThreats(enriched)\r\n\tw := bufio.NewWriter(os.Stdout)\r\n\tdefer w.Flush()\r\n\tenc := json.NewEncoder(w)\r\n\tfor _, t := range enriched {\r\n"]
[2809.618851, "o", "\t\tif err := enc.Encode(t); err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\treturn 1\r\n\t\t}\r\n\t}"]
[2809.61891, "o", "\r\n\treturn 0\r\n}\r\n\r\nfunc loadIOCDB(path string) ([]processedIOC, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar entries []iocEntry\r\n\tif err := json.Unmarshal(data, &entries); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tprocessed := make([]processedIOC, 0, len(entries))\r\n\tfor _, e := range entries {\r\n\t\tp, ok := processIOC(e)"]
[2809.61897, "o", "\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tprocessed = append(processed, p)\r\n\t}\r\n\treturn processed, nil\r\n}\r\n\r\n"]
[2809.619032, "o", "func processIOC(e iocEntry) (processedIOC, bool) {\r\n\tp := processedIOC{entry: e, ttlHours: e.TTLHours}\r\n\tif p.ttlHours <= 0 {\r\n\t\treturn p, false\r\n\t}\r\n\tt, err := parseTime(e.LastUpdated)\r\n"]
[2809.619091, "o", "\tif err != nil {\r\n\t\treturn p, false\r\n\t}\r\n\tp.lastUpdated = t\r\n\tswitch e.IndicatorType {\r\n\tcase \"ipv4\":\r\n\t\tip := net.ParseIP(e.Indicator)\r\n\t\tif ip == nil || ip.To4() == nil {\r\n\t\t\treturn p, false\r\n\t\t}\r\n\t\tp.ip = ip\r\n\tcase \"ipv4_cidr\":\r\n\t\t_, ipNet, err := net.ParseCIDR(e.Indicator)\r\n\t\tif err != nil {\r\n\t\t\treturn p, false\r\n\t"]
[2809.619148, "o", "\t}\r\n\t\tif ipNet.IP.To4() == nil {\r\n\t\t\treturn p, false\r\n\t\t}\r\n\t\tp.ipNet = ipNet\r\n\t\tones, _ := ipNet.Mask.Size()\r\n\t\tp.prefixLen = ones\r\n\tcase \"port\":\r\n"]
[2809.619203, "o", "\t\tport, err := strconv.Atoi(e.Indicator)\r\n\t\tif err != nil {\r\n\t\t\treturn p, false\r\n\t\t}\r\n\t\tp.port = port\r\n\tcase \"user\":\r\n\tdefault:\r\n"]
[2809.619274, "o", "\t\treturn p, false\r\n\t}\r\n\treturn p, true\r\n}\r\n\r\nfunc enrichThreat(threat map[string]interface{}, iocs []processedIOC, fixedRef time.Time, hasRef bool, minConf float64) map[string]interface{} {\r\n\trefTime := fixedRef\r\n\tif !hasRef {\r\n\t\trefTime = threatReferenceTime(threat)\r\n\t}\r\n\r\n"]
[2809.619336, "o", "\tmatches := computeIOCMatches(threat, iocs, refTime, minConf)\r\n\r\n\triskScore, _ := getFloat(threat, \"risk_score\")\r\n\tmaxConf := 0.0\r\n\ttagFactor := make(map[string]float64)\r\n\tseverityContrib := 0\r\n\tindicatorTypes := make(map[string]bool)\r\n\tactors := make(map[string]bool)\r\n\tsevRank := 0\r\n\r\n\tfor _, m := range matches {\r\n\t\t"]
[2809.619395, "o", "if m.adjusted > maxConf {\r\n\t\t\tmaxConf = m.adjusted\r\n\t\t}\r\n\t\tfor _, tag := range m.p.entry.Tags {\r\n\t\t\tif cur, ok := tagFactor[tag]; ok {\r\n\t\t\t\tif m.freshness > cur {\r\n\t\t\t\t\ttagFactor[tag] = m.freshness\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n"]
[2809.61945, "o", "\t\t\t\ttagFactor[tag] = m.freshness\r\n\t\t\t}\r\n\t\t}\r\n\t\tseverityContrib += severityWeight(m.p.entry.Severity)\r\n\t\tindicatorTypes[m.p.entry.IndicatorType] = true\r\n\t\tactors[m.p.entry.ThreatActor] = true\r\n\t\tif v := severityValue(m.p.entry.Severity); v > sevRank {\r\n\t\t\tsevRank = v\r\n"]
[2809.619509, "o", "\t\t}\r\n\t}\r\n\r\n\ttagBonus := 0.0\r\n\tfor tag, factor := range tagFactor {\r\n\t\ttagBonus += tagBonusValue(tag) * factor\r\n\t}\r\n\r\n\tmultiVectorBonus := 0.0\r\n\tswitch len(indicatorTypes) {\r\n\tcase 0, 1:\r\n"]
[2809.619566, "o", "\t\tmultiVectorBonus = 0.0\r\n\tcase 2:\r\n\t\tmultiVectorBonus = 25.0\r\n\tdefault:\r\n\t\tmultiVectorBonus = 50.0\r\n\t}\r\n\r\n\tactorBonus := 0.0\r\n\tswitch len(actors) {\r\n\tcase 0, 1:\r\n\t\tactorBonus = 0.0"]
[2809.619628, "o", "\r\n\tcase 2:\r\n\t\tactorBonus = 15.0\r\n\tdefault:\r\n\t\tactorBonus = 30.0\r\n"]
[2809.619686, "o", "\t}\r\n\r\n\tenrichedScore := riskScore*(1.0+maxConf) + tagBonus + multiVectorBonus + float64(severityContrib) + actorBonus\r\n"]
[2809.620175, "o", "\u001b[?2004h"]
