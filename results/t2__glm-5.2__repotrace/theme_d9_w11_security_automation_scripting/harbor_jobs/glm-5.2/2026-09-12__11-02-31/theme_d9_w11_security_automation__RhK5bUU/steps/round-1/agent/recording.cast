[7287.877344, "o", "   250\t}\r\n   251\t\r\n   252\tfunc timelineSeverityRank(sev string) int {\r\n   253\t\tswitch sev {\r\n   254\t\tcase \"none\":\r\n   255\t\t\t"]
[7287.877423, "o", "return 0\r\n   256\t\tcase \"low\":\r\n   257\t\t\treturn 1\r\n   258\t\tcase \"medium\":\r\n   259\t\t\treturn 2\r\n   260\t\tcase \"high\":\r\n   261\t\t\treturn 3\r\n   262\t\tcase \"critical\":\r\n   263\t\t\treturn 4\r\n   264\t\tdefault:\r\n"]
[7287.877493, "o", "   265\t\t\treturn -1\r\n   266\t\t}\r\n   267\t}\r\n   268\t\r\n   269\tfunc timelineEscalationIndex(threats []map[string]interface{}) float64 {\r\n   270\t\tn := len(threats)\r\n   271\t\tif n < 2 {\r\n   272\t\t\treturn 0.0\r\n   273\t\t}\r\n   274\t\tordered := make([]map[string]interface{}, len(threats))\r\n   275\t\t"]
[7287.877561, "o", "copy(ordered, threats)\r\n   276\t\tsort.SliceStable(ordered, func(i, j int) bool {\r\n   277\t\t\tti, tj := threatSortTime(ordered[i]), threatSortTime(ordered[j])\r\n   278\t\t\tif !ti.Equal(tj) {\r\n   279\t\t\t\treturn ti.Before(tj)\r\n   280\t\t\t}\r\n   281\t\t\ttta, _ := getString(ordered[i], \"threat_type\")\r\n   282\t\t\tttb, _ := getString(ordered[j], \"threat_type\")\r\n   283\t\t\treturn tta < ttb\r\n   284\t\t})\r\n   285"]
[7287.877625, "o", "\t\r\n   286\t\tpositiveSum := 0.0\r\n   287\t\tfor i := 0; i < len(ordered)-1; i++ {\r\n   288\t\t\trankI := timelineSeverityRank(getStringDefault(ordered[i], \"ioc_severity\"))\r\n   289\t\t\trankJ := timelineSeverityRank(getStringDefault(ordered[i+1], \"ioc_severity\"))\r\n   290\t\t\tif rankI < 0 {\r\n   291\t\t\t\trankI = 0\r\n   292\t\t\t}\r\n   293\t\t\tif rankJ < 0 {"]
[7287.877685, "o", "\r\n   294\t\t\t\trankJ = 0\r\n   295\t\t\t}\r\n   296\t\t\tdelta := rankJ - rankI\r\n   297\t\t\tif delta > 0 {\r\n   298\t\t\t\tpositiveSum += float64(delta)\r\n   299\t\t\t}\r\n   300\t\t}\r\n   301\t\treturn positiveSum / (4.0 * float64(n-1))\r\n   302"]
[7287.877745, "o", "\t}\r\n   303\t\r\n   304\tfunc timelineRiskTrend(threats []map[string]interface{}, startTime time.Time) float64 {\r\n   305\t\tn := len(threats)\r\n   306\t\tif n < 2 {\r\n   307\t\t\treturn 0.0\r\n   308\t\t}\r\n   309\t\txs := make([]float64, n)\r\n"]
[7287.87781, "o", "   310\t\tys := make([]float64, n)\r\n   311\t\tfor i, threat := range threats {\r\n   312\t\t\trefTime := threatSortTime(threat)\r\n   313\t\t\txs[i] = refTime.Sub(startTime).Minutes()\r\n   314\t\t\tys[i], _ = getFloat(threat, \"enriched_risk_score\")\r\n   315\t\t}\r\n   316\t\tsameX := true\r\n   317\t\tfor i := 1; i < n; i++ {\r\n   318\t\t\tif xs[i] != xs[0] {\r\n   319\t\t\t"]
[7287.877874, "o", "\tsameX = false\r\n   320\t\t\t\tbreak\r\n   321\t\t\t}\r\n   322\t\t}\r\n   323\t\tif sameX {\r\n   324\t\t\treturn 0.0\r\n   325\t\t}\r\n"]
[7287.877937, "o", "   326\t\tvar sumX, sumY, sumXY, sumXX2 float64\r\n   327\t\tfor i := 0; i < n; i++ {\r\n   328\t\t\tsumX += xs[i]\r\n   329\t\t\tsumY += ys[i]\r\n   330\t\t\tsumXY += xs[i] * ys[i]\r\n   331\t\t\tsumXX2 += xs[i] * xs[i]\r\n   332\t\t}\r\n   333\t\tdenom := float64(n)*sumXX2 - sumX*sumX\r\n   334\t\tif denom == 0 {\r\n   335\t\t\treturn 0.0\r\n   336\t\t}\r\n   337"]
[7287.877996, "o", "\t\treturn (float64(n)*sumXY - sumX*sumY) / denom\r\n   338\t}\r\n   339\t\r\n   340\tfunc timelineBurstScore(threats []map[string]interface{}) float64 {\r\n   341\t\tn := len(threats)\r\n   342\t\tif n < 2 {\r\n   343\t\t\treturn 0.0\r\n   344\t\t}\r\n   345\t\ttimes := make([]float64, n)\r\n"]
[7287.87806, "o", "   346\t\tfor i, threat := range threats {\r\n   347\t\t\trefTime := threatSortTime(threat)\r\n   348\t\t\ttimes[i] = float64(refTime.Unix()) / 60.0\r\n   349\t\t}\r\n   350\t\tsum := 0.0\r\n   351\t\t"]
[7287.878121, "o", "pairs := 0\r\n   352\t\tfor i := 0; i < n; i++ {\r\n   353\t\t\tfor j := i + 1; j < n; j++ {\r\n   354\t\t\t\tsum += 1.0 / (1.0 + math.Abs(times[i]-times[j]))\r\n   355\t\t\t\tpairs++\r\n   356\t\t\t}\r\n   357\t\t}\r\n   358\t\treturn sum / float64(pairs)\r\n   359\t}\r\n   360\t\r\n"]
