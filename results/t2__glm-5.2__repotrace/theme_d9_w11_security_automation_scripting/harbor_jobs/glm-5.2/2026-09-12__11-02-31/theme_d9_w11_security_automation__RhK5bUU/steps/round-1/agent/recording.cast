[11579.578516, "o", "\u001b[35m\u001b[Kaggregate.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif snap.MeanEnrichedRisk > maxMeanRisk {\r\n\u001b[35m\u001b[Kaggregate.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tmaxMeanRisk = snap.MeanEnrichedRisk\r\n\u001b[35m\u001b[Kaggregate.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[35m\u001b[Kaggregate.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor actor, count := range snap.ActorThreatCounts {\r\n\u001b[35m\u001b[Kaggregate.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tactorCounts[actor] += count\r\n\u001b[35m\u001b[Kaggregate.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[35m\u001b[Kaggregate.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tdominantType := snap.DominantThreatType\r\n\u001b[35m\u001b[Kaggregate.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tdominantTypeCounts[dominantType]++\r\n\u001b[35m\u001b[Kaggregate.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treport.TypeCounts[dominantType] += snap.TotalThreats\r\n\u001b[35m\u001b[Kaggregate.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b["]
