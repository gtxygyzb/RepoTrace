[8955.274895, "i", "sed -n '195,230p' prioritize.go\n"]
[8955.275187, "o", "sed -n '195,230p' prioritize.go\r\n\u001b[?2004l\r"]
[8955.278105, "o", "\tswitch {\r\n\tcase score >= 0.75:\r\n\t\treturn \"critical\"\r\n\tcase score >= 0.50:\r\n\t\treturn \"high\""]
[8955.27819, "o", "\r\n\tcase score >= 0.25:\r\n\t\treturn \"medium\"\r\n\tdefault:\r\n\t\treturn \"low\"\r\n\t}\r\n}\r\n\r\nfunc round4(f float64) float64 {\r\n\treturn math.Round(f*10000) / 10000\r\n}\r\n"]
[8955.278697, "o", "\u001b[?2004h"]
[8955.278757, "o", "root@n30009:/app# "]
