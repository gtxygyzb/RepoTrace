[10465.79524, "o", "\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tGlobalMeanRisk float64 `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"global_mean_risk\"`\r\n\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tTotalThreats   int     `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"total_threats\"`\r\n\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype anomaly\u001b[m\u001b[KMetricResult struct {\r\n\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tValue          json.Number `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"value\"`\r\n\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tBaselineMean   json.Number `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"baseline_mean\"`\r\n"]
[10465.795317, "o", "\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tBaselineStddev json.Number `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"baseline_stddev\"`\r\n"]
[10465.795384, "o", "\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KZScore\u001b[m\u001b[K         json.Number `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"z_score\"`\r\n\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype anomaly\u001b[m\u001b[KMetrics struct {\r\n\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tGlobalMeanRisk anomalyMetricResult `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"global_mean_risk\"`\r\n\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tTotalThreats   anomalyMetricResult `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"total_threats\"`\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype anomaly\u001b[m\u001b[KRecord struct {\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tIndex         int            `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"index\"`\r\n"]
[10465.795453, "o", "\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tMetrics       anomalyMetrics `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"metrics\"`\r\n"]
[10465.795515, "o", "\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KCombinedZ\u001b[m\u001b[K     json.Number    `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"combined_z\"`\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tBaselineCount int            `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"baseline_count\"`\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tDirection     string         `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"direction\"`\r\n"]
[10465.795577, "o", "\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tSeverity      string         `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"severity\"`\r\n\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\trounded\u001b[01;31m\u001b[KCombinedZ\u001b[m\u001b[K float64\r\n"]
[10465.795681, "o", "\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\trounded\u001b[01;31m\u001b[KCombinedZ\u001b[m\u001b[K := \u001b[01;31m\u001b[KroundHalfUp4\u001b[m\u001b[K(combinedZ)\r\n"]
[10465.795764, "o", "\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tBaselineMean:   json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(riskMean)),\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tBaselineStddev: json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(riskStd)),\r\n"]
[10465.795829, "o", "\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\u001b[01;31m\u001b[KZScore\u001b[m\u001b[K:         json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(riskZ)),\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tBaselineMean:   json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(threatMean)),\r\n\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tBaselineStddev: json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(threatStd)),\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\u001b[01;31m\u001b[KZScore\u001b[m\u001b[K:         json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(threatZ)),\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KCombinedZ\u001b[m\u001b[K:        json.Number(\u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(combinedZ)),\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\trounded\u001b[01;31m\u001b[KCombinedZ\u001b[m\u001b[K: rounded\u001b[01;31m\u001b[KCombinedZ\u001b[m\u001b[K,\r\n"]
[10465.795892, "o", "\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif anomalies[a].rounded\u001b[01;31m\u001b[KCombinedZ\u001b[m\u001b[K != anomalies[b].rounded\u001b[01;31m\u001b[KCombinedZ\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn anomalies[a].rounded\u001b[01;31m\u001b[KCombinedZ\u001b[m\u001b[K > anomalies[b].rounded\u001b[01;31m\u001b[KCombinedZ\u001b[m\u001b[K\r\n"]
[10465.795954, "o", "\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KroundHalfUp4\u001b[m\u001b[K(f float64) float64 {\r\n\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[Kformat4\u001b[m\u001b[K(f float64) string {\r\n\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\trounded := \u001b[01;31m\u001b[KroundHalfUp4\u001b[m\u001b[K(f)\r\n"]
