[2861.687567, "o", "    60\tfunc runEnrich(args []string) int {\r\n    61\t\tfs := newFlagSet(\"enrich\")\r\n    62\t\tiocPath := fs.String(\"ioc\", \"\", \"path to IOC database JSON file\")\r\n    63\t\trefTimeStr := fs.String(\"reference-time\", \"\", \"ISO 8601 timestamp used for TTL evaluation\")\r\n    64\t\tminConf := fs.Float64(\"min-confidence\", 0.0, \"minimum base effective confidence\")\r\n    65\t\t"]
[2861.687718, "o", "if !parseFlags(fs, args) {\r\n    66\t\t\treturn 1\r\n    67\t\t}\r\n    68\t\tif !isFlagSet(fs, \"ioc\") || *iocPath == \"\" {\r\n    69\t\t\tfmt.Fprintln(os.Stderr, \"error: --ioc flag is required\")\r\n    70\t\t\treturn 1\r\n    71\t\t}\r\n    72\t\r\n    73\t\thasRef := isFlagSet(fs, \"reference-time\")\r\n    74\t\tvar refTime time.Time\r\n    75\t\tif hasRef {\r\n    76\t\t\tt, err := parseTime(*refTimeStr)\r\n    77\t\t\tif err != nil {\r\n    78\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    79\t\t\t\treturn 1\r\n    80\t\t\t}\r\n    81\t\t\trefTime = t\r\n    82\t\t}\r\n    83\t\r\n    84\t\tiocs, err := loadIOCDB(*iocPath)\r\n    85\t\tif err != nil {\r\n    86\t\t\tif os.IsNotExist(err) {\r\n    87\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[2861.68783, "o", "    88\t\t\t\treturn 1\r\n    89\t\t\t}\r\n    90\t\t\tif _, ok := err.(*json.SyntaxError); ok {\r\n    91\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    92\t\t\t\treturn 2\r\n    93\t\t\t}\r\n    94\t\t\tif _, ok := err.(*json.UnmarshalTypeError); ok {\r\n    95\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    96\t\t\t\treturn 2\r\n    97\t\t\t}\r\n    98\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    99\t\t\treturn 1\r\n   100\t\t}\r\n   101\t\r\n   102\t\tscanner := bufio.NewScanner(os.Stdin)\r\n   103\t\t"]
[2861.687917, "o", "scanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n   104\t\tvar enriched []map[string]interface{}\r\n   105\t\tlineNo := 0\r\n   106\t\tfor scanner.Scan() {\r\n   107\t\t\tlineNo++\r\n   108\t\t\tline := scanner.Text()\r\n   109\t\t\tif line == \"\" {\r\n   110\t\t\t\tcontinue\r\n   111\t\t\t}\r\n   112\t\t\tvar threat map[string]interface{}\r\n   113\t\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n   114\t\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n"]
[2861.688001, "o", "   115\t\t\t\treturn 2\r\n   116\t\t\t}\r\n   117\t\t\tenriched = append(enriched, enrichThreat(threat, iocs, refTime, hasRef, *minConf))\r\n   118\t\t}\r\n   119\t\tif err := scanner.Err(); err != nil {\r\n   120\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   121\t\t\treturn 1\r\n   122\t\t}\r\n   123\t\r\n   124\t\tsortEnrichedThreats(enriched)\r\n   125\t\tw := bufio.NewWriter(os.Stdout)\r\n   126"]
[2861.688098, "o", "\t\tdefer w.Flush()\r\n   127\t\tenc := json.NewEncoder(w)\r\n   128\t\tfor _, t := range enriched {\r\n   129\t\t\tif err := enc.Encode(t); err != nil {\r\n   130\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   131\t\t\t\treturn 1\r\n   132\t\t\t}\r\n   133\t\t}\r\n   134\t\treturn 0\r\n   135\t}\r\n   136\t\r\n"]
