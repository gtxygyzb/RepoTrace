[7734.113067, "o", "\t\treturn \"critical\"\r\n\tdefault:\r\n\t\treturn \"none\"\r\n\t}\r\n}\r\n\r\nfunc threatReferenceTime(threat map[string]interface{}) time.Time {\r\n\tif tt, ok := getString(threat, \"threat_type\"); ok && tt == \"privilege_escalation\" {\r\n\t\tif ts, ok := getString(threat, \"timestamp\"); ok {\r\n\t\t\tif t, err := parseTime(ts); err == nil {\r\n\t\t\t\treturn t\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[7734.113142, "o", "\tif ts, ok := getString(threat, \"first_seen\"); ok {\r\n\t\tif t, err := parseTime(ts); err == nil {\r\n\t\t\treturn t\r\n\t\t}\r\n\t}\r\n\treturn time.Time{}\r\n}\r\n\r\nfunc sortEnrichedThreats(threats []map[string]interface{}) {\r\n\tsort.SliceStable(threats, func(i, j int) bool {\r\n"]
[7734.113256, "o", "\t\ta := threats[i]\r\n\t\tb := threats[j]\r\n\t\tea, _ := getFloat(a, \"enriched_risk_score\")\r\n\t\teb, _ := getFloat(b, \"enriched_risk_score\")\r\n\t\tif ea != eb {\r\n\t\t\treturn ea > eb\r\n\t\t}\r\n\t\tta := threatSortTime(a)\r\n\t\ttb := threatSortTime(b)\r\n\t\tif !ta.Equal(tb) {\r\n\t\t\treturn ta.Before(tb)\r\n\t\t}\r\n\t\ttta, _ := getString(a, \"threat_type\")\r\n\t\tttb, _ := getString(b, \"threat_type\")\r\n\t"]
[7734.113332, "o", "\treturn tta < ttb\r\n\t})\r\n}\r\n\r\nfunc threatSortTime(threat map[string]interface{}) time.Time {\r\n\tif tt, ok := getString(threat, \"threat_type\"); ok && tt == \"privilege_escalation\" {\r\n\t\tif ts, ok := getString(threat, \"timestamp\"); ok {\r\n\t\t\tif t, err := parseTime(ts); err == nil {\r\n\t\t\t\treturn t\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif ts, ok := getString(threat, \"first_seen\"); ok {\r\n\t"]
[7734.113402, "o", "\tif t, err := parseTime(ts); err == nil {\r\n\t\t\treturn t\r\n\t\t}\r\n\t}\r\n\treturn time.Time{}\r\n}\r\n\r\nfunc getString(m map[string]interface{}, key string) (string, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn \"\", false\r\n\t"]
[7734.113474, "o", "}\r\n\ts, ok := v.(string)\r\n\treturn s, ok\r\n}\r\n\r\nfunc getStringSlice(m map[string]interface{}, key string) ([]string, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn nil, false\r\n\t}\r\n\tswitch val := v.(type) {\r\n\tcase []string:\r\n\t\treturn val, true\r\n\tcase []interface{}:\r\n"]
[7734.113546, "o", "\t\tout := make([]string, 0, len(val))\r\n\t\tfor _, e := range val {\r\n\t\t\ts, ok := e.(string)\r\n\t\t\tif !ok {\r\n\t\t\t\treturn nil, false\r\n\t\t\t}\r\n\t\t\tout = append(out, s)\r\n\t\t}\r\n"]
[7734.113618, "o", "\t\treturn out, true\r\n\tdefault:\r\n\t\treturn nil, false\r\n\t}\r\n}\r\n\r\nfunc getFloat(m map[string]interface{}, key string) (float64, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn 0, false\r\n\t}\r\n\tswitch val := v.(type) {\r\n\tcase float64:\r\n\t\treturn val, true\r\n"]
[7734.113688, "o", "\tcase int:\r\n\t\treturn float64(val), true\r\n\tdefault:\r\n\t\treturn 0, false\r\n\t}\r\n}\r\n\r\nfunc getIntSlice(m map[string]interface{}, key string) ([]int, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn nil, false\r\n\t}\r\n\tswitch val := v.(type) {\r\n"]
[7734.113764, "o", "\tcase []int:\r\n\t\treturn val, true\r\n\tcase []interface{}:\r\n\t\tout := make([]int, 0, len(val))\r\n\t\tfor _, e := range val {\r\n\t\t\tswitch n := e.(type) {\r\n\t\t\tcase float64:\r\n\t\t\t\tout = append(out, int(n))\r\n\t\t\tcase int:\r\n\t\t\t\tout = append(out, n)\r\n\t\t\tdefault:\r\n"]
[7734.113829, "o", "\t\t\t\treturn nil, false\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn out, true\r\n\tdefault:\r\n\t\treturn nil, false\r\n\t}\r\n}\r\n\r\nfunc sortedKeys(m map[string]bool) []string {\r\n\tkeys := make([]string, 0, len(m))\r\n"]
