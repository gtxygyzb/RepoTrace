[2874.027155, "o", "   440\tfunc computeFreshness(p processedIOC, refTime time.Time) (float64, float64, bool) {\r\n   441\t\tageHours := refTime.Sub(p.lastUpdated).Hours()\r\n   442\t\tfreshnessFraction := ageHours / float64(p.ttlHours)\r\n   443\t\tif freshnessFraction >= 1.0 {\r\n   444\t\t\treturn 0, 0, false\r\n"]
[2874.02726, "o", "   445\t\t}\r\n   446\t\tfactor := freshnessFactor(freshnessFraction)\r\n   447\t\treturn p.entry.Confidence * factor, factor, true\r\n   448\t}\r\n   449\t\r\n   450\tfunc freshnessFactor(fraction float64) float64 {\r\n   451\t\tswitch {\r\n   452\t\tcase fraction < 0.25:\r\n   453\t\t\treturn 1.0\r\n   454\t\tcase fraction < 0.50:\r\n   455\t\t\treturn 0.9\r\n   456\t\tcase fraction < 0.75:\r\n   457\t\t\treturn 0.7\r\n   458"]
[2874.027334, "o", "\t\tdefault:\r\n   459\t\t\treturn 0.5\r\n   460\t\t}\r\n   461\t}\r\n   462\t\r\n   463\tfunc fieldMultiplier(field string) float64 {\r\n   464\t\tswitch field {\r\n   465\t\tcase \"source_ip\", \"dest_ip\", \"compromised_hosts\", \"user\":\r\n   466\t\t\treturn 1.0\r\n"]
[2874.0274, "o", "   467\t\tcase \"dest_ips\", \"target_users\":\r\n   468\t\t\treturn 0.8\r\n   469\t\tcase \"ports_scanned\":\r\n   470\t\t\treturn 0.6\r\n   471\t\tdefault:\r\n   472\t\t\treturn 0.0\r\n   473\t\t}\r\n   474\t}\r\n   475\t\r\n"]
[2874.027465, "o", "   476\tfunc maxFieldMultiplier(fields []string) float64 {\r\n   477\t\tmax := 0.0\r\n   478\t\tfor _, f := range fields {\r\n   479\t\t\tif m := fieldMultiplier(f); m > max {\r\n   480\t\t\t\tmax = m\r\n   481\t\t\t}\r\n   482\t\t}\r\n   483\t\treturn max\r\n   484\t}\r\n"]
[2874.027529, "o", "   485\t\r\n   486\tfunc tagBonusValue(tag string) float64 {\r\n   487\t\tswitch tag {\r\n   488\t\tcase \"apt\":\r\n   489\t\t\treturn 100.0\r\n   490\t\tcase \"ransomware\":\r\n   491\t\t\treturn 75.0\r\n   492\t\tcase \"botnet\":\r\n   493\t\t\treturn 50.0\r\n   494\t\tcase \"phishing\":\r\n"]
[2874.027588, "o", "   495\t\t\treturn 30.0\r\n   496\t\tcase \"scanner\":\r\n   497\t\t\treturn 25.0\r\n   498\t\tcase \"cryptominer\":\r\n   499\t\t\treturn 20.0\r\n   500\t\tdefault:\r\n   501\t\t\treturn 0.0\r\n"]
[2874.027651, "o", "   502\t\t}\r\n   503\t}\r\n   504\t\r\n   505\tfunc severityWeight(s string) int {\r\n   506\t\tswitch s {\r\n   507\t\tcase \"low\":\r\n   508\t\t\treturn 5\r\n   509\t\tcase \"medium\":\r\n   510\t\t\treturn 10\r\n   511"]
[2874.027712, "o", "\t\tcase \"high\":\r\n   512\t\t\treturn 20\r\n   513\t\tcase \"critical\":\r\n   514\t\t\treturn 40\r\n   515\t\tdefault:\r\n   516\t\t\treturn 0\r\n   517\t\t}\r\n   518\t}\r\n   519\t\r\n   520\t"]
[2874.027775, "o", "func severityFromRank(rank int) string {\r\n   521\t\tswitch rank {\r\n   522\t\tcase 1:\r\n   523\t\t\treturn \"low\"\r\n   524\t\tcase 2:\r\n   525\t\t\treturn \"medium\"\r\n   526\t\tcase 3:\r\n   527\t\t\treturn \"high\"\r\n   528\t\tcase 4:\r\n   529"]
[2874.027838, "o", "\t\t\treturn \"critical\"\r\n   530\t\tdefault:\r\n   531\t\t\treturn \"none\"\r\n   532\t\t}\r\n   533\t}\r\n   534\t\r\n   535\tfunc threatReferenceTime(threat map[string]interface{}) time.Time {\r\n"]
