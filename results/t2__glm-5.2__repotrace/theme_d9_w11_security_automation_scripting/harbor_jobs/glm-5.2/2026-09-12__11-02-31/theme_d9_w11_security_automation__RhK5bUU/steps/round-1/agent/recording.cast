[4568.029448, "o", "printf '{\"threat_type\":\"a\",\"first_seen\":\"2024-01-15T08:00:00Z\",\"ioc_severity\":\"none\",\"enriched_risk_score\":10.0,\"threat_actors\":[]}\\n{\"threat_type\":\"b\",\"first_seen\":\"2024-01-15T08:10:00Z\",\"ioc_severity\":\"critical\",\"enriched_risk_score\":20.0,\"threat_actors\":[\"X\"]}\\n{\"threat_type\":\"c\",\"first_seen\":\"2024-01-15T08:10:00Z\",\"ioc_severity\":\"low\",\"enriched_risk_score\":30.0,\"threat_actors\":[\"Y\",\"X\"]}\\n' | ./secsentinel timeline --bucket-minutes 30 --top-n 2\r\n\u001b[?2004l\r"]
