[7700.31882, "o", "   102\t\tscanner := bufio.NewScanner(os.Stdin)\r\n   103\t\tscanner.Buffer(make([]byte, 1024*1024), 16*1024*1024)\r\n   104\t\tvar enriched []map[string]interface{}\r\n   105\t\tlineNo := 0\r\n   106\t\tfor scanner.Scan() {\r\n   107\t\t\tlineNo++\r\n   108\t\t\tline := scanner.Text()\r\n   109\t\t\tif line == \"\" {\r\n   110\t\t\t\tcontinue\r\n   111\t\t\t}\r\n   112\t\t\tvar threat map[string]interface{}\r\n   113\t\t\tif err := json.Unmarshal([]byte(line), &threat); err != nil {\r\n   114\t\t\t\tfmt.Fprintf(os.Stderr, \"line %d: %v\\n\", lineNo, err)\r\n   115\t\t\t\treturn 2\r\n   116\t\t\t}\r\n   117\t\t\tenriched = append(enriched, enrichThreat(threat, iocs, refTime, hasRef, *minConf))\r\n   118\t\t}\r\n   119\t\tif err := scanner.Err(); err != nil {\r\n"]
