[11586.468785, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/json\"\r\n"]
[11586.468885, "o", "     6\t\t\"fmt\"\r\n     7\t\t\"io\"\r\n     8\t\t\"math\"\r\n     9\t\t\"os\"\r\n"]
[11586.468958, "o", "    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t)\r\n    14\t\r\n    15\ttype anomalyInputSnapshot struct {\r\n    16\t\tGlobalMeanRisk float64 `json:\"global_mean_risk\"`\r\n    17\t\tTotalThreats   int     `json:\"total_threats\"`\r\n    18\t}\r\n    19\t\r\n    20\ttype anomalyMetricResult struct {\r\n    21\t\tValue          json.Number `json:\"value\"`\r\n    22\t\tBaselineMean   json.Number `json:\"baseline_mean\"`\r\n    23\t\tBaselineStddev json.Number `json:\"baseline_stddev\"`\r\n    24\t\tZScore         json.Number `json:\"z_score\"`\r\n    25\t}\r\n    26\t\r\n    27\ttype anomalyMetrics struct {\r\n    28\t\tGlobalMeanRisk anomalyMetricResult `json:\"global_mean_risk\"`\r\n"]
[11586.469048, "o", "    29\t\tTotalThreats   anomalyMetricResult `json:\"total_threats\"`\r\n    30\t}\r\n    31\t\r\n    32\ttype anomalyRecord struct {\r\n    33\t\tIndex         int            `json:\"index\"`\r\n    34\t\tMetrics       anomalyMetrics `json:\"metrics\"`\r\n"]
[11586.469114, "o", "    35\t\tCombinedZ     json.Number    `json:\"combined_z\"`\r\n    36\t\tBaselineCount int            `json:\"baseline_count\"`\r\n    37\t\tDirection     string         `json:\"direction\"`\r\n    38\t\tSeverity      string         `json:\"severity\"`\r\n    39\t\r\n    40\t\troundedCombinedZ float64\r\n    41\t}"]
[11586.469176, "o", "\r\n    42\t\r\n    43\tfunc runAnomaly(args []string) int {\r\n    44\t\tfs := newFlagSet(\"anomaly\")\r\n    45\t\twindow := fs.Int(\"window\", 5, \"baseline window size\")\r\n    46\t\tthreshold := fs.Float64(\"threshold\", 2.0, \"combined z-score anomaly threshold\")\r\n    47\t\tif !parseFlags(fs, args) {\r\n    48\t\t\treturn 1\r\n    49\t\t}\r\n    50\t\r\n    51\t\tif *window < 2 {\r\n"]
[11586.469297, "o", "    52\t\t\tfmt.Fprintln(os.Stderr, \"error: --window must be at least 2\")\r\n    53\t\t\treturn 1\r\n    54\t\t}\r\n    55\t\r\n    56\t\tvar snapshots []anomalyInputSnapshot\r\n    57\t\treader := bufio.NewReader(os.Stdin)\r\n    58\t\tfor {\r\n"]
[11586.469363, "o", "    59\t\t\tline, err := reader.ReadString('\\n')\r\n    60\t\t\ttrimmed := strings.TrimSpace(line)\r\n    61\t\t\tif trimmed == \"\" {\r\n    62\t\t\t\tif err == io.EOF {\r\n    63\t\t\t\t\tbreak\r\n    64\t\t\t\t}\r\n    65\t\t\t\tcontinue\r\n    66"]
[11586.469432, "o", "\t\t\t}\r\n    67\t\r\n    68\t\t\tvar snap anomalyInputSnapshot\r\n    69\t\t\tif jerr := json.Unmarshal([]byte(trimmed), &snap); jerr != nil {\r\n    70\t\t\t\tfmt.Fprintln(os.Stderr, \"error: malformed JSON input:\", jerr)\r\n    71\t\t\t\treturn 2\r\n    72\t"]
[11586.469497, "o", "\t\t}\r\n    73\t\t\tsnapshots = append(snapshots, snap)\r\n    74\t\r\n    75\t\t\tif err == io.EOF {\r\n"]
[11586.469566, "o", "    76\t\t\t\tbreak\r\n    77\t\t\t}\r\n    78\t\t}\r\n    79\t\r\n    80\t\tif len(snapshots) < 3 {\r\n    81\t\t\tfmt.Fprintln(os.Stderr, \"error: requires at least 3 valid JSON lines on stdin\")\r\n    82\t\t\treturn 1\r\n    83\t\t}\r\n    84\t\r\n    85\t\trisks := make([]float64, len(snapshots))\r\n    86\t\tthreats := make([]float64, len(snapshots))\r\n    87\t\tfor i, snap := range snapshots {"]
[11586.469629, "o", "\r\n    88\t\t\trisks[i] = snap.GlobalMeanRisk\r\n    89\t\t\tthreats[i] = float64(snap.TotalThreats)\r\n    90\t\t}\r\n    91\t\r\n    92\t\tvar anomalies []anomalyRecord\r\n"]
[11586.469692, "o", "    93\t\tfor i := 0; i < len(snapshots); i++ {\r\n    94\t\t\tstart := i - *window\r\n    95\t\t\tif start < 0 {\r\n    96\t\t\t\tstart = 0\r\n    97\t\t\t}\r\n"]
[11586.469757, "o", "    98\t\t\tbaselineCount := i - start\r\n    99\t\t\tif baselineCount < 2 {\r\n   100\t\t\t\tcontinue\r\n   101\t\t\t}\r\n   102\t\r\n   103\t\t\triskMean, riskStd := baselineStats(risks[start:i])\r\n   104\t\t\tthreatMean, threatStd := baselineStats(threats[start:i])\r\n   105\t\r\n"]
[11586.469819, "o", "   106\t\t\triskZ := zScore(risks[i], riskMean, riskStd)\r\n   107\t\t\tthreatZ := zScore(threats[i], threatMean, threatStd)\r\n   108\t\t\tcombinedZ := math.Sqrt(riskZ*riskZ + threatZ*threatZ)\r\n   109\t\t\troundedCombinedZ := roundHalfUp4(combinedZ)\r\n   110\t\r\n   111\t\t\tif combinedZ < *threshold {\r\n   112\t\t\t\tcontinue\r\n   113\t\t\t}\r\n"]
[11586.469888, "o", "   114\t\r\n   115\t\t\tdirection := \"mixed\"\r\n   116\t\t\tif riskZ >= 0 && threatZ >= 0 {\r\n   117\t\t\t\tdirection = \"above\"\r\n   118\t\t\t} else if riskZ <= 0 && threatZ <= 0 {\r\n   119\t\t\t\tdirection = \"below\"\r\n   120\t\t\t}\r\n   121\t\r\n   122\t\t\t"]
[11586.469953, "o", "severity := \"low\"\r\n   123\t\t\tif combinedZ >= 4.0 {\r\n   124\t\t\t\tseverity = \"extreme\"\r\n   125\t\t\t} else if combinedZ >= 3.0 {\r\n   126\t\t\t\tseverity = \"high\"\r\n   127\t\t\t} else if combinedZ >= 2.0 {\r\n   128\t\t\t\tseverity = \"moderate\"\r\n   129\t\t\t}\r\n   130\t\r\n   131\t\t\tanomalies = append(anomalies, anomalyRecord{\r\n"]
[11586.470016, "o", "   132\t\t\t\tIndex: i,\r\n   133\t\t\t\tMetrics: anomalyMetrics{\r\n   134\t\t\t\t\tGlobalMeanRisk: anomalyMetricResult{\r\n   135\t\t\t\t\t\tValue:          json.Number(formatRiskValue(risks[i])),\r\n   136\t\t\t\t\t\tBaselineMean:   json.Number(format4(riskMean)),\r\n   137\t\t\t\t\t\tBaselineStddev: json.Number(format4(riskStd)),\r\n   138\t\t\t\t\t\tZScore:         json.Number(format4(riskZ)),\r\n   139\t\t\t\t\t},"]
[11586.470084, "o", "\r\n   140\t\t\t\t\tTotalThreats: anomalyMetricResult{\r\n   141\t\t\t\t\t\tValue:          json.Number(strconv.FormatInt(int64(threats[i]), 10)),\r\n   142\t\t\t\t\t\tBaselineMean:   json.Number(format4(threatMean)),\r\n   143\t\t\t\t\t\tBaselineStddev: json.Number(format4(threatStd)),\r\n   144\t\t\t\t\t\tZScore:         json.Number(format4(threatZ)),\r\n   145\t\t\t\t\t},\r\n   146\t"]
[11586.470147, "o", "\t\t\t},\r\n   147\t\t\t\tCombinedZ:        json.Number(format4(combinedZ)),\r\n   148\t\t\t\tBaselineCount:    baselineCount,\r\n   149\t\t\t\tDirection:        direction,\r\n   150\t\t\t\tSeverity:         severity,\r\n   151\t\t\t\troundedCombinedZ: roundedCombinedZ,\r\n   152\t\t\t})\r\n   153\t\t}\r\n"]
[11586.470223, "o", "   154\t\r\n   155\t\tsort.SliceStable(anomalies, func(a, b int) bool {\r\n   156\t\t\tif anomalies[a].roundedCombinedZ != anomalies[b].roundedCombinedZ {\r\n   157\t\t\t\treturn anomalies[a].roundedCombinedZ > anomalies[b].roundedCombinedZ\r\n   158\t\t\t}\r\n   159\t\t\treturn anomalies[a].Index < anomalies[b].Index\r\n   160\t\t})\r\n   161\t\r\n"]
[11586.470291, "o", "   162\t\tencoder := json.NewEncoder(os.Stdout)\r\n   163\t\tencoder.SetEscapeHTML(false)\r\n   164\t\tfor _, rec := range anomalies {\r\n   165\t\t\tif err := encoder.Encode(rec); err != nil {\r\n   166\t\t\t\tfmt.Fprintln(os.Stderr, \"error: failed to write anomaly record:\", err)\r\n   167\t\t\t\treturn 1\r\n   168\t\t\t}\r\n   169\t\t}\r\n   170\t\r\n   171\t\treturn 0\r\n   172\t}\r\n"]
[11586.470379, "o", "   173\t\r\n   174\tfunc baselineStats(values []float64) (float64, float64) {\r\n   175\t\tn := len(values)\r\n   176\t\tif n == 0 {\r\n   177\t\t\treturn 0, 0\r\n   178\t\t}\r\n   179\t\r\n   180\t\tsum := 0.0\r\n"]
[11586.470896, "o", "\u001b[?2004h"]
[11586.470954, "o", "root@n30009:/app# "]
