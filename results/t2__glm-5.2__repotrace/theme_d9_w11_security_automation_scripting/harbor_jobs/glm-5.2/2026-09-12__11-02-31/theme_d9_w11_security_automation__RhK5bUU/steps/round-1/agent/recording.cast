[11600.373456, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n"]
[11600.373536, "o", "     4\t\t\"bufio\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"math\"\r\n     8\t\t\"os\"\r\n     9\t\t\"strconv\"\r\n    10\t)\r\n    11\t\r\n    12\ttype forecastInputSnapshot struct {\r\n    13\t\tGlobalMeanRisk float64 `json:\"global_mean_risk\"`\r\n    14\t\tTotalThreats   int     `json:\"total_threats\"`\r\n    15\t}\r\n    16\t\r\n    17\ttype forecastMetricResult struct {\r\n"]
[11600.373613, "o", "    18\t\tSlope       json.Number   `json:\"slope\"`\r\n    19\t\tIntercept   json.Number   `json:\"intercept\"`\r\n    20\t\tTrend       string        `json:\"trend\"`\r\n    21\t\tLastValue   json.Number   `json:\"last_value\"`\r\n    22\t\tPredictions []json.Number `json:\"predictions\"`\r\n    23\t}\r\n    24\t\r\n    25\ttype forecastOutput struct {\r\n    26\t\tInputCount   int                             `json:\"input_count\"`\r\n    27\t\tMetrics      map[string]forecastMetricResult `json:\"metrics\"`\r\n"]
[11600.373697, "o", "    28\t\tOverallTrend string                          `json:\"overall_trend\"`\r\n    29\t\tAlertLevel   string                          `json:\"alert_level\"`\r\n    30\t}\r\n    31\t\r\n    32\tfunc runForecast(args []string) int {\r\n    33\t\tfs := newFlagSet(\"forecast\")\r\n    34\t\tsteps := fs.Int(\"steps\", 3, \"number of future steps to predict\")\r\n    35\t\tif !parseFlags(fs, args) {\r\n    36\t\t\treturn 1\r\n    37\t\t}\r\n"]
[11600.373761, "o", "    38\t\tif *steps < 1 {\r\n    39\t\t\tfmt.Fprintln(os.Stderr, \"error: --steps must be at least 1\")\r\n    40\t\t\treturn 1\r\n    41\t\t}\r\n    42\t\r\n    43\t\tvar snapshots []forecastInputSnapshot\r\n    44\t\tscanner := bufio.NewScanner(os.Stdin)\r\n    45\t\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n    46\t\tfor scanner.Scan() {\r\n    47\t"]
[11600.37382, "o", "\t\tline := scanner.Text()\r\n    48\t\t\tif len(line) == 0 {\r\n    49\t\t\t\tcontinue\r\n    50\t\t\t}\r\n    51\t\t\tvar snap forecastInputSnapshot\r\n    52\t\t\tif err := json.Unmarshal([]byte(line), &snap); err != nil {\r\n    53\t\t\t\tfmt.Fprintf(os.Stderr, \"error: malformed JSON input: %s\\n\", err)\r\n"]
[11600.373883, "o", "    54\t\t\t\treturn 2\r\n    55\t\t\t}\r\n    56\t\t\tsnapshots = append(snapshots, snap)\r\n    57\t\t}\r\n    58\t\tif err := scanner.Err(); err != nil {\r\n    59\t\t\tfmt.Fprintf(os.Stderr, \"error: reading input: %s\\n\", err)\r\n    60\t\t\treturn 1\r\n    61\t\t}\r\n    62\t\tif len(snapshots) < 3 {\r\n    63\t\t\tfmt.Fprintln(os.Stderr, \"error: at least 3 valid input snapshots are required\")\r\n"]
[11600.373947, "o", "    64\t\t\treturn 1\r\n    65\t\t}\r\n    66\t\r\n    67\t\trisks := make([]float64, len(snapshots))\r\n    68\t\tthreats := make([]float64, len(snapshots))\r\n    69\t\tfor i, snap := range snapshots {\r\n    70\t\t\trisks[i] = snap.GlobalMeanRisk\r\n    71\t\t\tthreats[i] = float64(snap.TotalThreats)\r\n    72\t\t}\r\n"]
[11600.374004, "o", "    73\t\r\n    74\t\triskSlope, riskIntercept := olsLine(0, risks)\r\n    75\t\tthreatSlope, threatIntercept := olsLine(0, threats)\r\n    76\t\r\n    77\t\triskPredictions := predictLine(riskSlope, riskIntercept, len(snapshots), *steps)\r\n    78\t\tthreatPredictions := predictLine(threatSlope, threatIntercept, len(snapshots), *steps)\r\n    79\t\r\n    80\t\triskTrend := trendFromSlope(riskSlope)"]
[11600.374061, "o", "\r\n    81\t\tthreatTrend := trendFromSlope(threatSlope)\r\n    82\t\r\n    83\t\tlast := snapshots[len(snapshots)-1]\r\n    84\t\tmetrics := map[string]forecastMetricResult{\r\n    85\t\t\t\"global_mean_risk\": {\r\n    86\t\t\t\tSlope:       json.Number(format4(riskSlope)),\r\n    87\t\t\t\tIntercept:   json.Number(format4(riskIntercept)),\r\n    88\t\t\t\tTrend:       riskTrend,\r\n"]
[11600.374125, "o", "    89\t\t\t\tLastValue:   json.Number(formatRiskValue(last.GlobalMeanRisk)),\r\n    90\t\t\t\tPredictions: roundAll4(riskPredictions),\r\n    91\t\t\t},\r\n    92\t\t\t\"total_threats\": {\r\n    93\t\t\t\tSlope:       json.Number(format4(threatSlope)),\r\n    94\t\t\t\tIntercept:   json.Number(format4(threatIntercept)),\r\n    95\t\t\t\tTrend:       threatTrend,\r\n    96\t\t\t\tLastValue:   json.Number(strconv.Itoa(last.TotalThreats)),\r\n    97\t\t\t\tPredictions: roundAll4(threatPredictions),\r\n    98\t\t\t},\r\n"]
[11600.374189, "o", "    99\t\t}\r\n   100\t\r\n   101\t\tout := forecastOutput{\r\n   102\t\t\tInputCount:   len(snapshots),\r\n   103\t\t\tMetrics:      metrics,\r\n"]
[11600.374282, "o", "   104\t\t\tOverallTrend: overallTrend(riskTrend, threatTrend),\r\n   105\t\t\tAlertLevel:   alertLevelFromSlopes(risks, threats, riskSlope, threatSlope),\r\n   106\t\t}\r\n   107\t\r\n   108\t\tencoded, err := json.Marshal(out)\r\n   109\t\tif err != nil {\r\n   110\t\t\tfmt.Fprintln(os.Stderr, \"error: encoding forecast output:\", err)\r\n   111\t\t\treturn 1\r\n   112\t\t}\r\n   113\t\tfmt.Println(string(encoded))\r\n   114\t\treturn 0\r\n   115\t}\r\n   116\t\r\n   117\tfunc olsLine(startIndex int, values []float64) (slope, intercept float64) {\r\n   118\t"]
[11600.374353, "o", "\tn := len(values)\r\n   119\t\tif n == 0 {\r\n   120\t\t\treturn 0, 0\r\n   121\t\t}\r\n   122\t\tvar sumX, sumY, sumXY, sumX2 float64\r\n"]
[11600.374414, "o", "   123\t\tfor i, y := range values {\r\n   124\t\t\tx := float64(startIndex + i)\r\n   125\t\t\tsumX += x\r\n   126\t\t\tsumY += y\r\n   127\t\t\tsumXY += x * y\r\n   128\t\t\tsumX2 += x * x\r\n   129\t\t}\r\n   130\t\r\n   131\t\tdenom := float64(n)*sumX2 - sumX*sumX\r\n   132\t\tif denom == 0 {\r\n   133\t\t\tslope = 0\r\n   134\t\t\tintercept = values[0]\r\n"]
[11600.374476, "o", "   135\t\t\treturn\r\n   136\t\t}\r\n   137\t\tslope = (float64(n)*sumXY - sumX*sumY) / denom\r\n   138\t\tintercept = (sumY - slope*sumX) / float64(n)\r\n   139\t\treturn\r\n   140\t}\r\n"]
