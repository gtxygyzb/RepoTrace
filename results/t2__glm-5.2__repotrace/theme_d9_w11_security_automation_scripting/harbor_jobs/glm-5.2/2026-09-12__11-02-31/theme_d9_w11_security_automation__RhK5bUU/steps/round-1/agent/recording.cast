[4826.492319, "o", "   162\tfunc sortEvents(events []Event) {\r\n   163\t\tsort.SliceStable(events, func(i, j int) bool {\r\n   164\t\t\tti, errI := parseTime(events[i].Timestamp)\r\n   165\t\t\ttj, errJ := parseTime(events[j].Timestamp)\r\n   166\t\t\tif errI == nil && errJ == nil {\r\n   167\t\t\t\tif ti.Before(tj) {\r\n   168\t\t\t\t\treturn true\r\n   169\t\t\t\t}\r\n   170\t\t\t"]
[4826.492386, "o", "\tif tj.Before(ti) {\r\n   171\t\t\t\t\treturn false\r\n   172\t\t\t\t}\r\n   173\t\t\t\treturn events[i].Timestamp < events[j].Timestamp\r\n   174\t\t\t}\r\n   175\t\t\treturn events[i].Timestamp < events[j].Timestamp\r\n   176\t"]
[4826.492455, "o", "\t})\r\n   177\t}\r\n   178\t\r\n   179\tfunc eventTime(e Event) (time.Time, bool) {\r\n   180\t\tt, err := parseTime(e.Timestamp)\r\n   181\t\treturn t, err == nil\r\n   182\t}\r\n   183\t\r\n   184\tfunc detectThreats(events []Event) []Threat {\r\n   185\t\tsortEvents(events)\r\n   186\t\tvar threats []Threat\r\n   187\t\tthreats = append(threats, detectBruteForce(events)...)\r\n   188\t\tthreats = append(threats, detectPortScan(events)...)\r\n   189\t\tthreats = append(threats, detectDataExfiltration(events)...)\r\n"]
[4826.492516, "o", "   190\t\tthreats = append(threats, detectPrivilegeEscalation(events)...)\r\n   191\t\tthreats = append(threats, detectLateralMovement(events)...)\r\n   192\t\tthreats = append(threats, detectDNSTunneling(events)...)\r\n   193\t\tsortThreats(threats)\r\n   194\t\treturn threats\r\n   195\t}\r\n   196\t\r\n   197\tfunc sortThreats(threats []Threat) {\r\n   198\t\tsort.SliceStable(threats, func(i, j int) bool {\r\n   199\t\t\tif threats[i].RiskScore != threats[j].RiskScore {\r\n"]
[4826.492618, "o", "   200\t\t\t\treturn threats[i].RiskScore > threats[j].RiskScore\r\n   201\t\t\t}\r\n   202\t\t\tif !threats[i].firstTime.Equal(threats[j].firstTime) {\r\n   203\t\t\t\treturn threats[i].firstTime.Before(threats[j].firstTime)\r\n   204\t\t\t}\r\n   205\t\t\treturn threats[i].ThreatType < threats[j].ThreatType\r\n   206\t\t})\r\n   207\t}\r\n   208\t\r\n   209\tfunc detectBruteForce(events []Event) []Threat {\r\n   210\t\tbyIP := make(map[string][]Event)\r\n   211\t\tfor _, e := range events {\r\n   212\t\t\tif e.EventType == \"auth_failure\" {\r\n   213\t\t\t\tbyIP[e.SourceIP] = append(byIP[e.SourceIP], e)\r\n   214\t\t\t}\r\n   215"]
[4826.492681, "o", "\t\t}\r\n   216\t\r\n   217\t\tvar threats []Threat\r\n   218\t\tfor ip, evs := range byIP {\r\n   219\t\t\tfor i := 0; i < len(evs); i++ {\r\n   220\t\t\t\tstart, ok := eventTime(evs[i])\r\n   221\t\t\t\tif !ok {\r\n   222\t\t\t\t\tcontinue\r\n   223\t\t\t\t}\r\n   224\t\t\t\tvar window []Event\r\n"]
[4826.492744, "o", "   225\t\t\t\tfor j := i; j < len(evs); j++ {\r\n   226\t\t\t\t\tt, ok := eventTime(evs[j])\r\n   227\t\t\t\t\tif !ok {\r\n   228\t\t\t\t\t\tcontinue\r\n   229\t\t\t\t\t}\r\n   230\t\t\t\t\tif t.Sub(start) <= 60*time.Second {\r\n   231\t\t\t\t\t\twindow = append(window, evs[j])\r\n"]
[4826.492802, "o", "   232\t\t\t\t\t} else {\r\n   233\t\t\t\t\t\tbreak\r\n   234\t\t\t\t\t}\r\n   235\t\t\t\t}\r\n   236\t\t\t\tif len(window) >= 5 {\r\n   237\t\t\t\t\tusers := make([]string, 0, len(window))\r\n   238\t\t\t\t\tfor _, e := range window {\r\n   239\t\t\t\t\t"]
[4826.492862, "o", "\tusers = append(users, e.User)\r\n   240\t\t\t\t\t}\r\n   241\t\t\t\t\tusers = uniqueSortedStrings(users)\r\n   242\t\t\t\t\trisk := float64(len(window)) * 5.0\r\n   243\t\t\t\t\tif len(users) > 3 {\r\n"]
[4826.492923, "o", "   244\t\t\t\t\t\trisk = float64(len(window)) * 10.0\r\n   245\t\t\t\t\t}\r\n   246\t\t\t\t\tlast, ok := eventTime(window[len(window)-1])\r\n   247\t\t\t\t\tif !ok {\r\n   248\t\t\t\t\t\tlast = start\r\n   249\t\t\t\t\t}\r\n   250\t\t\t\t\tthreats = append(threats, Threat{\r\n   251\t\t\t\t\t\tThreatType:  \"brute_force\",\r\n   252"]
[4826.492989, "o", "\t\t\t\t\t\tSourceIP:    ip,\r\n   253\t\t\t\t\t\tCount:       len(window),\r\n   254\t\t\t\t\t\tFirstSeen:   window[0].Timestamp,\r\n   255\t\t\t\t\t\tLastSeen:    window[len(window)-1].Timestamp,\r\n   256\t\t\t\t\t\tTargetUsers: users,\r\n   257\t\t\t\t\t\tRiskScore:   risk,\r\n   258\t\t\t\t\t\tfirstTime:   start,\r\n"]
[4826.493054, "o", "   259\t\t\t\t\t\tlastTime:    last,\r\n   260\t\t\t\t\t})\r\n   261\t\t\t\t\tbreak\r\n   262\t\t\t\t}\r\n   263\t\t\t}\r\n   264\t\t}\r\n   265\t\treturn threats\r\n   266\t}\r\n   267\t\r\n   268\tfunc detectPortScan(events []Event) []Threat {"]
[4826.493115, "o", "\r\n   269\t\tbyPair := make(map[string][]Event)\r\n   270\t\tfor _, e := range events {\r\n   271\t\t\tif e.EventType == \"connection\" || e.EventType == \"port_scan\" {\r\n   272\t\t\t\tkey := e.SourceIP + \"|\" + e.DestIP\r\n   273\t\t\t\tbyPair[key] = append(byPair[key], e)\r\n   274\t\t\t}\r\n   275\t\t}\r\n"]
