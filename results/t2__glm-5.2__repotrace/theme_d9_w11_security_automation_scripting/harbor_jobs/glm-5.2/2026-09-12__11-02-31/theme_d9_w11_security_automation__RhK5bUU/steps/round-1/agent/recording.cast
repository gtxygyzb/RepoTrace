[1556.157627, "i", "  Port  int `json:\"port\"`\n    Count int `json:\"count\"`\n}\n\ntype SeverityWindow struct {\n    WindowStart string  `json:\"window_start\"`\n    WindowEnd   string  `json:\"window_end\"`\n    AvgSeverity float64 `json:\"avg_severity\"`\n}\n\nfunc runSummarize(args []string) int {\n    fs := newFlagSet(\"summarize\")\n    format := fs.String(\"format\", \"json\", \"output format (text|json)\")\n    if !parseFlags(fs, args) {\n        return 1\n    }\n    if *format != \"json\" && *format != \"text\" {\n        fmt.Fprintln(os.Stderr, \"invalid format\")\n        return 1\n    }\n\n    events, err := readEvents()\n    summary := buildSummary(events)\n    if *format == \"text\" {\n        printTextSummary(summary)\n    } else {\n        printJSONSummary(summary)\n    }\n    if err != nil {\n        fmt.Fprintln(os.Stderr, err)\n        return 2\n    }\n    return 0\n}\n\nfunc buildSummary(events []Event) Summary {\n    s := Summary{\n        TotalEvents: len(events),\n        BySeverity:  make(map[string]int),\n        ByAction:    make(map[string]int),\n        ByEventTyp"]
