[1970.486761, "o", "\t        if col.Max != nil && fv > *col.Max {\r\n   136\t            return false, \"value out of range for column \" + col.Name + \": \" + val\r\n   137\t        }\r\n   138\t    }\r\n   139\t\r\n   140\t    for _, col := range schema.Columns {\r\n   141\t        if col.Pattern == \"\" || col.Type != \"string\" {\r\n   142\t            continue\r\n   143\t        }\r\n   144\t"]
[1970.486822, "o", "        val := get(col)\r\n   145\t        if val == \"\" {\r\n   146\t            continue\r\n   147\t        }\r\n   148\t        if !col.pattern.MatchString(val) {\r\n   149\t            return false, \"value does not match pattern for column \" + col.Name + \": \" + val\r\n   150\t        }\r\n   151\t    }\r\n   152\t\r\n   153"]
[1970.486887, "o", "\t    return true, \"\"\r\n   154\t}\r\n   155\t\r\n   156\tfunc ValidateRows(schema *Schema, header []string, rows [][]string) ([][]string, []RejectedRow, error) {\r\n   157\t    if err := validateSchemaHeader(schema, header); err != nil {\r\n   158\t        return nil, nil, err\r\n   159\t    }\r\n   160\t\r\n   161\t    type validRow struct {\r\n   162\t        index int\r\n"]
[1970.486943, "o", "   163\t        row   []string\r\n   164\t    }\r\n   165\t    var valid []validRow\r\n   166\t    var rejected []RejectedRow\r\n   167\t\r\n   168\t    for i, row := range rows {\r\n   169\t        ok, reason := validateRow(schema, header, row)\r\n   170\t        if !ok {\r\n"]
