[2821.286425, "i", "SONFile(outputPath, out)\n}\n\ntype keyedRow struct {\n\tkey string\n\trow []string\n}\n\nfunc buildKeyedRows(ds *Dataset, keys []string) map[string]keyedRow {\n\tidxs := make([]int, len(keys))\n\tfor i, k := range keys {\n\t\tidxs[i] = indexOf(ds.Header, k)\n\t}\n\tout := map[string]keyedRow{}\n\tfor _, row := range ds.Rows {\n\t\tparts := make([]string, len(keys))\n\t\tfor i, idx := range idxs {\n\t\t\tif idx < len(row) {\n\t\t\t\tparts[i] = row[idx]\n\t\t\t} else {\n\t\t\t\tparts[i] = \"\"\n\t\t\t}\n\t\t}\n\t\tk := strings.Join(parts, \"\\x00\")\n\t\tif _, exists := out[k]; !exists {\n\t\t\tout[k] = keyedRow{key: k, row: row}\n\t\t}\n\t}\n\treturn out\n}\n\nfunc diffColumns(header []string, left, right []string, keySet, ignoreSet map[string]struct{}, tolerance float64) []string {\n\tdiff := []string{}\n\tfor i, col := range header {\n\t\tif _, isKey := keySet[col]; isKey {\n\t\t\tcontinue\n\t\t}\n\t\tif _, ignored := ignoreSet[col]; ignored {\n\t\t\tcontinue\n\t\t}\n\t\tlv := cellAt(left, i)\n\t\trv := cellAt(right, i)\n\t\tif !equalWithTolerance(lv, rv, tolerance) {\n\t\t\tdiff = append(diff, col)\n\t\t}\n\t}\n\treturn diff\n}"]
[2821.286482, "o", ",\r\n\t\t\t\tRow:  rowMap(header, lrow),\r\n\t\t\t})\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tdiff := diffColumns(header, lrow, rrow, keySet, ignoreSet, tolerance)\r\n\t\tif len(diff) > 0 {\r\n\t\t\tmodified++\r\n\t\t\tchanges = append(changes, compareChange{\r\n\t\t\t\tType:  \"modified\",\r\n\t\t\t\tKey:   key"]
[2821.286582, "i", "\n\nfunc equalWithTolerance(a, b string, tolerance float64) bool {\n\taf, aerr := strconv.ParseFloat(a, 64)\n\tbf, berr := strconv.ParseFloat(b, 64)\n\tif aerr == nil && berr == nil {\n\t\treturn math.Abs(af-bf) <= tolerance\n\t}\n\treturn a == b\n}\n\nfunc keyMap(keys []string, row []string) map[string]string {\n\tm := map[string]string{}\n\tfor _, k := range keys {\n\t\tidx := indexOf(keys, k)\n\t\tif idx >= 0 && idx < len(row) {\n\t\t\tm[k] = row[idx]\n\t\t} else {\n\t\t\tm[k] = \"\"\n\t\t}\n\t}\n\treturn m\n}\n\nfunc rowMap(header []string, row []string) map[string]string {\n\tm := map[string]string{}\n\tfor i, h := range header {\n\t\tif i < len(row) {\n\t\t\tm[h] = row[i]\n\t\t} else {\n\t\t\tm[h] = \"\"\n\t\t}\n\t}\n\treturn m\n}\n\nfunc joinKey(keys []string, m map[string]string) string {\n\tparts := make([]string, len(keys))\n\tfor i, k := range keys {\n\t\tparts[i] = m[k]\n\t}\n\treturn strings.Join(parts, \"\\x00\")\n}\n\nfunc changeTypeOrder(t string) int {\n\tswitch t {\n\tcase \"added\":\n\t\treturn 0\n\tcase \"removed\":\n\t\treturn 1\n\tcase \"modified\":\n\t\treturn 2\n\t}\n\treturn 3\n}\n\nfunc splitCSVList(s string)"]
