[1909.475452, "o", "package main\r\n\r\nimport (\r\n    \"fmt\"\r\n    \"regexp\"\r\n"]
[1909.475539, "o", "    \"sort\"\r\n    \"strconv\"\r\n    \"strings\"\r\n    \"time\"\r\n)\r\n\r\ntype ColumnSchema struct {\r\n    Name     string   `json:\"name\"`\r\n    Type     string   `json:\"type\"`\r\n"]
[1909.475556, "o", "    Required bool     `json:\"required\"`\r\n    Unique   bool     `json:\"unique\"`\r\n"]
[1909.475631, "o", "    Min      *float64 `json:\"min\"`\r\n    Max      *float64 `json:\"max\"`\r\n    Pattern  string   `json:\"pattern\"`\r\n    pattern  *regexp.Regexp\r\n}\r\n\r\ntype Schema struct {\r\n    Columns    []ColumnSchema `json:\"columns\"`\r\n    PrimaryKey []string       `json:\"primary_key\"`\r\n}\r\n\r\ntype RejectedRow struct {\r\n    Row    []string\r\n    Reason string\r\n}\r\n\r\n"]
[1909.475646, "o", "func LoadSchema(path string) (*Schema, error) {\r\n    var schema Schema\r\n"]
[1909.475718, "o", "    if err := loadJSON(path, &schema); err != nil {\r\n        return nil, err\r\n    }\r\n    for i, col := range schema.Columns {\r\n        if col.Pattern != \"\" {\r\n            re, err := regexp.Compile(col.Pattern)\r\n            if err != nil {\r\n                return nil, fmt.Errorf(\"ERROR: invalid pattern: %s\", col.Pattern)\r\n            }\r\n            schema.Columns[i].pattern = re\r\n        }\r\n    }\r\n    return &schema, nil\r\n"]
[1909.475733, "o", "}\r\n\r\nfunc headerIndex(header []string, name string) int {\r\n    for i, h := range header {\r\n        if h == name {\r\n"]
[1909.475837, "o", "            return i\r\n        }\r\n    }\r\n    return -1\r\n}\r\n\r\nfunc validateSchemaHeader(schema *Schema, header []string) error {\r\n    if len(schema.PrimaryKey) == 0 {\r\n        return fmt.Errorf(\"ERROR: invalid schema: primary_key is required\")\r\n    }\r\n    for _, col := range schema.Columns {\r\n        if headerIndex(header, col.Name) == -1 {\r\n            return fmt.Errorf(\"ERROR: invalid schema: column %s not found in header\", col.Name)\r\n        }\r\n    }\r\n    for _, pk := range schema.PrimaryKey {\r\n        if headerIndex(header, pk) == -1 {\r\n            return fmt.Errorf(\"ERROR: invalid schema: primary key column %s not found in header\", pk)\r\n        }\r\n    }\r\n    return nil\r\n}\r\n"]
[1909.475854, "o", "\r\nfunc parseSchemaValue(col ColumnSchema, value string) (bool, string) {\r\n    switch col.Type {\r\n"]
[1909.475942, "o", "    case \"int\":\r\n        if _, err := strconv.ParseInt(value, 10, 64); err != nil {\r\n            return false, \"invalid value for column \" + col.Name + \": \" + value\r\n        }\r\n    case \"float\":\r\n        if _, err := strconv.ParseFloat(value, 64); err != nil {\r\n            return false, \"invalid value for column \" + col.Name + \": \" + value\r\n        }\r\n    case \"datetime\":\r\n        if _, err := time.Parse(time.RFC3339, value); err != nil {\r\n            return false, \"invalid value for column \" + col.Name + \": \" + value\r\n        }\r\n    case \"string\":\r\n        // no additional type check\r\n    default:\r\n        return false, \"invalid type for column \" + col.Name + \": \" + col.Type\r\n    }\r\n    return true, \"\"\r\n"]
[1909.475958, "o", "}\r\n\r\nfunc validateRow(schema *Schema, header []string, row []string) (bool, string) {\r\n    get := func(col ColumnSchema) string {\r\n"]
[1909.476028, "o", "        idx := headerIndex(header, col.Name)\r\n        if idx == -1 || idx >= len(row) {\r\n            return \"\"\r\n        }\r\n        return row[idx]\r\n    }\r\n\r\n    for _, col := range schema.Columns {\r\n        val := get(col)\r\n        if col.Required && val == \"\" {\r\n            return false, \"missing required column: \" + col.Name\r\n        }\r\n        if val != \"\" {\r\n"]
[1909.476046, "o", "            ok, reason := parseSchemaValue(col, val)\r\n            if !ok {\r\n                return false, reason\r\n            }\r\n"]
[1909.476058, "o", "        }\r\n    }\r\n\r\n"]
[1909.476147, "o", "    for _, col := range schema.Columns {\r\n        if (col.Min == nil && col.Max == nil) || (col.Type != \"int\" && col.Type != \"float\") {\r\n            continue\r\n        }\r\n        val := get(col)\r\n        if val == \"\" {\r\n            continue\r\n        }\r\n        fv, err := strconv.ParseFloat(val, 64)\r\n        if err != nil {\r\n            continue\r\n        }\r\n        if col.Min != nil && fv < *col.Min {\r\n            return false, \"value out of range for column \" + col.Name + \": \" + val\r\n        }\r\n        if col.Max != nil && fv > *col.Max {\r\n            return false, \"value out of range for column \" + col.Name + \": \" + val\r\n        }\r\n    }\r\n\r\n"]
[1909.476163, "o", "    for _, col := range schema.Columns {\r\n        if col.Pattern == \"\" || col.Type != \"string\" {\r\n"]
[1909.476232, "o", "            continue\r\n        }\r\n        val := get(col)\r\n        if val == \"\" {\r\n            continue\r\n        }\r\n        if !col.pattern.MatchString(val) {\r\n            return false, \"value does not match pattern for column \" + col.Name + \": \" + val\r\n        }\r\n    }\r\n\r\n    return true, \"\"\r\n}\r\n\r\n"]
[1909.476248, "o", "func ValidateRows(schema *Schema, header []string, rows [][]string) ([][]string, []RejectedRow, error) {\r\n    if err := validateSchemaHeader(schema, header); err != nil {\r\n        return nil, nil, err\r\n    }\r\n"]
[1909.476316, "o", "\r\n    type validRow struct {\r\n        index int\r\n        row   []string\r\n    }\r\n    var valid []validRow\r\n    var rejected []RejectedRow\r\n\r\n    for i, row := range rows {\r\n        ok, reason := validateRow(schema, header, row)\r\n        if !ok {\r\n            rejected = append(rejected, RejectedRow{Row: row, Reason: reason})\r\n            continue\r\n        }\r\n        valid = append(valid, validRow{index: i, row: row})\r\n    }\r\n"]
[1909.476334, "o", "\r\n    seen := make(map[string]map[string]bool)\r\n    for _, col := range schema.Columns {\r\n"]
[1909.476413, "o", "        if col.Unique {\r\n            seen[col.Name] = make(map[string]bool)\r\n        }\r\n    }\r\n\r\n    var finalValid [][]string\r\n    for _, vr := range valid {\r\n        row := vr.row\r\n        duplicate := false\r\n        var reason string\r\n        for _, col := range schema.Columns {\r\n            if !col.Unique {\r\n                continue\r\n            }\r\n            idx := headerIndex(header, col.Name)\r\n            val := \"\"\r\n            if idx >= 0 && idx < len(row) {\r\n"]
[1909.476429, "o", "                val = row[idx]\r\n            }\r\n            if seen[col.Name][val] {\r\n                duplicate = true\r\n"]
[1909.476497, "o", "                reason = \"duplicate value for unique column: \" + col.Name\r\n                break\r\n            }\r\n        }\r\n        if duplicate {\r\n            rejected = append(rejected, RejectedRow{Row: row, Reason: reason})\r\n            continue\r\n        }\r\n        for _, col := range schema.Columns {\r\n            if !col.Unique {\r\n"]
[1909.47651, "o", "                continue\r\n            }\r\n            idx := headerIndex(header, col.Name)\r\n            val := \"\"\r\n"]
[1909.476602, "o", "            if idx >= 0 && idx < len(row) {\r\n                val = row[idx]\r\n            }\r\n            seen[col.Name][val] = true\r\n        }\r\n        finalValid = append(finalValid, row)\r\n    }\r\n\r\n    sort.SliceStable(finalValid, func(i, j int) bool {\r\n        return lessByPrimaryKey(schema, header, finalValid[i], finalValid[j])\r\n    })\r\n\r\n    return finalValid, rejected, nil\r\n}\r\n\r\nfunc lessByPrimaryKey(schema *Schema, header []string, a, b []string) bool {\r\n    for _, pk := range schema.PrimaryKey {\r\n        idx := headerIndex(header, pk)\r\n        if idx == -1 {\r\n            continue\r\n        }\r\n        av := \"\"\r\n"]
[1909.476618, "o", "        bv := \"\"\r\n        if idx < len(a) {\r\n"]
[1909.476688, "o", "            av = a[idx]\r\n        }\r\n        if idx < len(b) {\r\n            bv = b[idx]\r\n        }\r\n        var colType string\r\n        for _, col := range schema.Columns {\r\n            if col.Name == pk {\r\n                colType = col.Type\r\n                break\r\n            }\r\n        }\r\n        cmp := compareTyped(av, bv, colType)\r\n        if cmp < 0 {\r\n            return true\r\n        }\r\n        if cmp > 0 {\r\n"]
[1909.476704, "o", "            return false\r\n        }\r\n    }\r\n    return false\r\n}\r\n\r\n"]
[1909.476773, "o", "func compareTyped(a, b, colType string) int {\r\n    switch colType {\r\n    case \"int\", \"float\":\r\n        af, aok := strconv.ParseFloat(a, 64)\r\n        bf, bok := strconv.ParseFloat(b, 64)\r\n        if aok == nil && bok == nil {\r\n            if af < bf {\r\n                return -1\r\n            }\r\n            if af > bf {\r\n                return 1\r\n            }\r\n            return 0"]
[1909.476788, "o", "\r\n        }\r\n    case \"datetime\":\r\n"]
[1909.476855, "o", "        at, aok := time.Parse(time.RFC3339, a)\r\n        bt, bok := time.Parse(time.RFC3339, b)\r\n        if aok == nil && bok == nil {\r\n            if at.Before(bt) {\r\n                return -1\r\n"]
