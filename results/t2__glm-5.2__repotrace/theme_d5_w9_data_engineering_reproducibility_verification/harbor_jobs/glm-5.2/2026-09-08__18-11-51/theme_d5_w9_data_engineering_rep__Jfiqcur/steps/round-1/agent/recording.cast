[1521.168354, "o", "        if _, err := time.Parse(time.RFC3339, value); err != nil {\r\n\u001b[?2004l\r"]
[1521.168408, "o", "\u001b[?2004h> "]
[1521.168628, "o", "            return false, \"invalid value for column \" + col.Name + \": \" + value\r\n\u001b[?2004l\r"]
[1521.168687, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r "]
[1521.168744, "o", "\u001b[?2004h> "]
[1521.168798, "o", "    case \"string\":\r\n\u001b[?2004l\r"]
[1521.168853, "o", "\u001b[?2004h> "]
[1521.168932, "o", "        // no additional type check\r\n\u001b[?2004l\r"]
[1521.168987, "o", "\u001b[?2004h> "]
[1521.169041, "o", "    default:\r\n\u001b[?2004l\r \u001b[?2004h> "]
[1521.169266, "o", "        return false, \"invalid type for column \" + col.Name + \": \" + col.Type\r\n\u001b[?2004l\r"]
[1521.169325, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.169404, "o", "    return true, \"\"\r\n\u001b[?2004l\r"]
[1521.169458, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\rTy\u001b[?2004h> \r\n\u001b[?2004l\rp"]
[1521.169527, "o", "\u001b[?2004h> "]
[1521.169766, "o", "func validateRow(schema *Schema, header []string, row []string) (bool, string) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.169911, "o", "    get := func(col ColumnSchema) string {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.169981, "o", "> "]
[1521.170074, "o", "        idx := headerIndex(header, col.Name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.170218, "o", "        if idx == -1 || idx >= len(row) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.170303, "o", ">             return \"\"\r\n\u001b[?2004l\r\r\n"]
[1521.170381, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r   \u001b[?2004h> "]
[1521.170458, "o", "        return row[idx]\r\n\u001b[?2004l\r"]
[1521.170555, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.170714, "o", "    for _, col := range schema.Columns {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.170792, "o", "        val := get(col)\r\n\u001b[?2004l\r"]
[1521.170871, "o", "\u001b[?2004h> "]
[1521.17095, "o", "        if col.Required && val == \"\" {\r\n\u001b[?2004l\r"]
[1521.171031, "o", "\u001b[?2004h> "]
[1521.171173, "o", "            return false, \"missing required column: \" + col.Name\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.171257, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.171339, "o", "        if val != \"\" {\r\n\u001b[?2004l\r"]
[1521.171419, "o", "\u001b[?2004h> "]
[1521.171538, "o", "            ok, reason := parseSchemaValue(col, val)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.171623, "o", ">             if !ok {\r\n\u001b[?2004l\r"]
[1521.171704, "o", "\u001b[?2004h> "]
[1521.171782, "o", "                return false, reason\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.17186, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.171938, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1521.172016, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r-\u001b[?2004h> "]
[1521.172143, "o", "    for _, col := range schema.Columns {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.17247, "o", "        if (col.Min == nil && col.Max == nil) || (col.Type != \"int\" && col.Type != \"float\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.172587, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.172673, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.172753, "o", "        val := get(col)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.172836, "o", "        if val == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.172916, "o", "            continue\r\n\u001b[?2004l\r"]
[1521.172998, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.173148, "o", "        fv, err := strconv.ParseFloat(val, 64)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.173248, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.173338, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.173417, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.173548, "o", "        if col.Min != nil && fv < *col.Min {\r\n\u001b[?2004l\r"]
[1521.173607, "o", "\u001b[?2004h> "]
[1521.173831, "o", "            return false, \"value out of range for column \" + col.Name + \": \" + val\r\n\u001b[?2004l\r"]
[1521.173885, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1521.173944, "o", "\u001b[?2004h> "]
[1521.174022, "o", "        if col.Max != nil && fv > *col.Max {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.174103, "o", "> "]
[1521.174237, "o", "            return false, \"value out of range for column \" + col.Name + \": \" + val\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.174315, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.174381, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.174464, "o", "    for _, col := range schema.Columns {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.174613, "o", "        if col.Pattern == \"\" || col.Type != \"string\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.174701, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.174783, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.174864, "o", "        val := get(col)\r\n\u001b[?2004l\r\u001b[?2004h>         if val == \"\" {\r\n\u001b[?2004l\r"]
[1521.174945, "o", "\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.175021, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.175102, "o", "        if !col.pattern.MatchString(val) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.175157, "o", "> "]
[1521.175314, "o", "            return false, \"value does not match pattern for column \" + col.Name + \": \" + val\r\n\u001b[?2004l\r"]
[1521.175371, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.175426, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.17548, "o", ">     return true, \"\"\r\n\u001b[?2004l\r"]
[1521.17556, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.17579, "o", "func ValidateRows(schema *Schema, header []string, rows [][]string) ([][]string, []RejectedRow, error) {\r\n\u001b[?2004l\r"]
[1521.175846, "o", "\u001b[?2004h> "]
[1521.175956, "o", "    if err := validateSchemaHeader(schema, header); err != nil {\r\n\u001b[?2004l\r"]
[1521.17601, "o", "\u001b[?2004h> "]
[1521.176059, "o", "        return nil, nil, err\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.176114, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.176169, "o", "> "]
[1521.176223, "o", "    type validRow struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.17628, "o", "        index int\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.176332, "o", "        row   []string\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.176388, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.176439, "o", "    var valid []validRow\r\n\u001b[?2004l\r"]
[1521.176517, "o", "\u001b[?2004h> "]
[1521.176575, "o", "    var rejected []RejectedRow\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.176653, "o", "    for i, row := range rows {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.176709, "o", "> "]
[1521.176787, "o", "        ok, reason := validateRow(schema, header, row)\r\n\u001b[?2004l\r"]
[1521.176843, "o", "\u001b[?2004h>         if !ok {\r\n\u001b[?2004l\r"]
[1521.176903, "o", "\u001b[?2004h> "]
[1521.177036, "o", "            rejected = append(rejected, RejectedRow{Row: row, Reason: reason})\r\n\u001b[?2004l\r"]
[1521.17709, "o", "\u001b[?2004h>             continue\r\n\u001b[?2004l\r"]
[1521.177146, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1521.1772, "o", "\u001b[?2004h> "]
[1521.177306, "o", "        valid = append(valid, validRow{index: i, row: row})\r\n\u001b[?2004l\r"]
[1521.177362, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1521.177418, "o", "\u001b[?2004h> "]
[1521.177482, "o", "    seen := make(map[string]map[string]bool)\r\n\u001b[?2004l\r"]
[1521.17756, "o", "\u001b[?2004h> "]
[1521.177618, "o", "    for _, col := range schema.Columns {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.177678, "o", "        if col.Unique {\r\n\u001b[?2004l\r"]
[1521.177732, "o", "\u001b[?2004h> "]
[1521.177804, "o", "            seen[col.Name] = make(map[string]bool)\r\n\u001b[?2004l\r"]
[1521.177859, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.177914, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1521.177969, "o", "\u001b[?2004h> "]
[1521.178024, "o", "    var finalValid [][]string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.178087, "o", "    for _, vr := range valid {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.178141, "o", "> "]
[1521.178196, "o", "        row := vr.row\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.178259, "o", "        duplicate := false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.178323, "o", "        var reason string\r\n\u001b[?2004l\r"]
[1521.178378, "o", "\u001b[?2004h> "]
[1521.17844, "o", "        for _, col := range schema.Columns {\r\n\u001b[?2004l\r"]
[1521.178515, "o", "\u001b[?2004h> "]
[1521.178598, "o", "            if !col.Unique {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.178656, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[1521.17871, "o", "\u001b[?2004h> "]
[1521.178804, "o", "            idx := headerIndex(header, col.Name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.17886, "o", ">             val := \"\"\r\n\u001b[?2004l\r"]
[1521.178914, "o", "\u001b[?2004h> "]
[1521.179005, "o", "            if idx >= 0 && idx < len(row) {\r\n\u001b[?2004l\r"]
[1521.17906, "o", "\u001b[?2004h> "]
[1521.179114, "o", "                val = row[idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.179169, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.179252, "o", "            if seen[col.Name][val] {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.179316, "o", "> "]
[1521.179375, "o", "                duplicate = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.179537, "o", "                reason = \"duplicate value for unique column: \" + col.Name\r\n\u001b[?2004l\r"]
[1521.179594, "o", "\u001b[?2004h>                 break\r\n\u001b[?2004l\r"]
[1521.179649, "o", "\u001b[?2004h> "]
[1521.179704, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1521.17977, "o", "\u001b[?2004h>         if duplicate {\r\n\u001b[?2004l\r"]
[1521.179825, "o", "\u001b[?2004h> "]
[1521.179974, "o", "            rejected = append(rejected, RejectedRow{Row: row, Reason: reason})\r\n\u001b[?2004l\r"]
[1521.180029, "o", "\u001b[?2004h> "]
[1521.180083, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.180137, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.180222, "o", "        for _, col := range schema.Columns {\r\n\u001b[?2004l\r"]
[1521.180277, "o", "\u001b[?2004h> "]
[1521.180331, "o", "            if !col.Unique {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.180387, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.180441, "o", ">             }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.180506, "o", "> "]
[1521.180581, "o", "            idx := headerIndex(header, col.Name)\r\n\u001b[?2004l\r"]
[1521.180636, "o", "\u001b[?2004h> "]
[1521.180691, "o", "            val := \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.180783, "o", "            if idx >= 0 && idx < len(row) {\r\n\u001b[?2004l\r"]
[1521.180837, "o", "\u001b[?2004h> "]
[1521.180897, "o", "                val = row[idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.180953, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.181048, "o", "            seen[col.Name][val] = true\r\n\u001b[?2004l\r"]
[1521.181103, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.181224, "o", "        finalValid = append(finalValid, row)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.181278, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1521.181333, "o", "\u001b[?2004h> "]
[1521.181422, "o", "    sort.SliceStable(finalValid, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[1521.181476, "o", "\u001b[?2004h> "]
[1521.18162, "o", "        return lessByPrimaryKey(schema, header, finalValid[i], finalValid[j])\r\n\u001b[?2004l\r"]
[1521.181676, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1521.18173, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1521.181793, "o", "    return finalValid, rejected, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.181848, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.182029, "o", "func lessByPrimaryKey(schema *Schema, header []string, a, b []string) bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.182084, "o", "> "]
[1521.182142, "o", "    for _, pk := range schema.PrimaryKey {\r\n\u001b[?2004l\r"]
[1521.182211, "o", "\u001b[?2004h> "]
[1521.182267, "o", "        idx := headerIndex(header, pk)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.182325, "o", "        if idx == -1 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.18238, "o", ">             continue\r\n\u001b[?2004l\r"]
[1521.182436, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1521.182535, "o", "\u001b[?2004h>         av := \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.182618, "o", "        bv := \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.182702, "o", "        if idx < len(a) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.182763, "o", "            av = a[idx]\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1521.182821, "o", "\u001b[?2004h> "]
[1521.182878, "o", "        if idx < len(b) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.182942, "o", "            bv = b[idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.182997, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1521.183053, "o", "        var colType string\r\n\u001b[?2004l\r\u001b[?2004h"]
[1521.183107, "o", "> "]
[1521.183166, "o", "        for _, col := range schema.Columns {\r\n\u001b[?2004l\r"]
