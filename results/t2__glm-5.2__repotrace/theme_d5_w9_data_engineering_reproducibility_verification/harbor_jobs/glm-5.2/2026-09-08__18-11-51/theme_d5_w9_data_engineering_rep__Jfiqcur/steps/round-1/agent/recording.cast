[1909.481448, "o", "\r\nfunc (p *exprParser) parseRelational() (exprNode, error) {\r\nleft, err := p.parseAdditive()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nfor p.peek().typ == \"op\" && (p.peek().val == \">\" || p.peek().val == \">=\" || p.peek().val == \"<\" || p.peek().val == \"<=\") {\r\nop := p.next().val\r\nright, err := p.parseAdditive()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nleft = &binaryNode{op: op, left: left, right: right}\r\n}\r\nreturn left, nil"]
[1909.481546, "o", "\r\n}\r\n\r\nfunc (p *exprParser) parseAdditive() (exprNode, error) {\r\nleft, err := p.parseMultiplicative()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nfor p.peek().typ == \"op\" && (p.peek().val == \"+\" || p.peek().val == \"-\") {\r\nop := p.next().val\r\nright, err := p.parseMultiplicative()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nleft = &binaryNode{op: op, left: left, right: right}\r\n}\r\nreturn left, nil\r\n}\r\n\r\n"]
[1909.481607, "o", "func (p *exprParser) parseMultiplicative() (exprNode, error) {\r\nleft, err := p.parseUnary()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nfor p.peek().typ == \"op\" && (p.peek().val == \"*\" || p.peek().val == \"/\" || p.peek().val == \"%\") {\r\nop := p.next().val\r\nright, err := p.parseUnary()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nleft = &binaryNode{op: op, left: left, right: right}\r\n}\r\nreturn left, nil\r\n"]
[1909.48167, "o", "}\r\n\r\nfunc (p *exprParser) parseUnary() (exprNode, error) {\r\nif p.peek().typ == \"op\" && p.peek().val == \"-\" {\r\np.next()\r\nchild, err := p.parseUnary()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nreturn &unaryNode{op: \"-\", child: child}, nil\r\n}\r\nreturn p.parsePrimary()\r\n}\r\n\r\nfunc (p *exprParser) parsePrimary() (exprNode, error) {\r\nt := p.peek()\r\n"]
[1909.481754, "o", "if t.typ == \"number\" {\r\np.next()\r\nf, err := strconv.ParseFloat(t.val, 64)\r\nif err != nil {\r\nreturn nil, fmt.Errorf(\"invalid number %q\", t.val)\r\n}\r\nreturn numberNode(f), nil\r\n}\r\nif t.typ == \"ident\" {\r\np.next()\r\nif p.peek().typ == \"op\" && p.peek().val == \"(\" {\r\np.next()\r\nvar args []exprNode\r\nif p.peek().typ != \"op\" || p.peek().val != \")\" {\r\nfor {\r\narg, err := p.parseOr()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nargs = append(args, arg)\r\n"]
