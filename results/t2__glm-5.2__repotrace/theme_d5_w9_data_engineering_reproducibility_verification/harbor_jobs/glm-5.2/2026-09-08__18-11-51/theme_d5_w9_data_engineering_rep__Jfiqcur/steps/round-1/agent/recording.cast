[2512.413342, "i", "cat > stats.go <<'EOF'\npackage main\n\nimport (\n\t\"math\"\n\t\"sort\"\n)\n\nfunc sortedFloat64s(vals []float64) []float64 {\n\tout := make([]float64, len(vals))\n\tcopy(out, vals)\n\tsort.Float64s(out)\n\treturn out\n}\n\nfunc percentileSorted(sorted []float64, p float64) float64 {\n\tn := len(sorted)\n\tif n == 0 {\n\t\treturn math.NaN()\n\t}\n\tif n == 1 {\n\t\treturn sorted[0]\n\t}\n\tidx := p / 100 * float64(n-1)\n\tlower := int(math.Floor(idx))\n\tupper := int(math.Ceil(idx))\n\tif lower < 0 {\n\t\tlower = 0\n\t}\n\tif upper >= n {\n\t\tupper = n - 1\n\t}\n\tif lower == upper {\n\t\treturn sorted[lower]\n\t}\n\tfrac := idx - float64(lower)\n\treturn sorted[lower] + frac*(sorted[upper]-sorted[lower])\n}\n\nfunc meanFloat64s(vals []float64) float64 {\n\tif len(vals) == 0 {\n\t\treturn math.NaN()\n\t}\n\tsum := 0.0\n\tfor _, v := range vals {\n\t\tsum += v\n\t}\n\treturn sum / float64(len(vals))\n}\n\nfunc populationStddevFloat64s(vals []float64, mean float64) float64 {\n\tif len(vals) == 0 {\n\t\treturn math.NaN()\n\t}\n\tsumSq := 0.0\n\tfor _, v := range vals {\n\t\tsumSq += (v - mean) * (v - mean)\n\t}\n\treturn "]
[2512.413377, "i", "math.Sqrt(sumSq / float64(len(vals)))\n}\n\nfunc sampleStddevFloat64s(vals []float64, mean float64) float64 {\n\tif len(vals) < 2 {\n\t\treturn 0\n\t}\n\tsumSq := 0.0\n\tfor _, v := range vals {\n\t\tsumSq += (v - mean) * (v - mean)\n\t}\n\treturn math.Sqrt(sumSq / float64(len(vals)-1))\n}\n\nfunc minFloat64s(sorted []float64) float64 {\n\tif len(sorted) == 0 {\n\t\treturn math.NaN()\n\t}\n\treturn sorted[0]\n}\n\nfunc maxFloat64s(sorted []float64) float64 {\n\tif len(sorted) == 0 {\n\t\treturn math.NaN()\n\t}\n\treturn sorted[len(sorted)-1]\n}\nEOF\n"]
