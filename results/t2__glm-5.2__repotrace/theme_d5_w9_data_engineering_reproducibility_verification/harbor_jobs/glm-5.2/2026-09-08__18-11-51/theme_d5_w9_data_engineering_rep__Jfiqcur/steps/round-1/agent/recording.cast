[1909.471075, "o", "package main\r\n\r\nimport (\r\n    \"bytes\"\r\n    \"crypto/sha256\"\r\n"]
[1909.471156, "o", "    \"encoding/csv\"\r\n    \"encoding/hex\"\r\n    \"encoding/json\"\r\n    \"fmt\"\r\n    \"os\"\r\n"]
[1909.471174, "o", "    \"path/filepath\"\r\n)\r\n\r\ntype fileNotFoundError struct {\r\n    path string\r\n}\r\n\r\nfunc (e *fileNotFoundError) Error() string {\r\n    return \"ERROR: file not found: \" + e.path\r\n}\r\n\r\nfunc newFileNotFoundError(path string) error {\r\n    return &fileNotFoundError{path: path}\r\n}\r\n\r\n"]
[1909.471258, "o", "func isNotFoundError(err error) bool {\r\n    if err == nil {\r\n        return false\r\n    }\r\n    if _, ok := err.(*fileNotFoundError); ok {\r\n        return true\r\n    }\r\n    return os.IsNotExist(err)\r\n}\r\n\r\ntype Dataset struct {\r\n    Header []string\r\n    Rows   [][]string\r\n}\r\n\r\n"]
[1909.471274, "o", "func ReadCSV(path string) (*Dataset, error) {\r\n    f, err := os.Open(path)\r\n    if err != nil {\r\n"]
[1909.47136, "o", "        if os.IsNotExist(err) {\r\n            return nil, newFileNotFoundError(path)\r\n        }\r\n        return nil, err\r\n    }\r\n    defer f.Close()\r\n\r\n    r := csv.NewReader(f)\r\n    r.FieldsPerRecord = -1\r\n    records, err := r.ReadAll()\r\n    if err != nil {\r\n        return nil, fmt.Errorf(\"ERROR: invalid CSV: %s: %v\", path, err)\r\n    }\r\n    if len(records) == 0 {\r\n        return &Dataset{Header: nil, Rows: nil}, nil\r\n    }\r\n    return &Dataset{Header: records[0], Rows: records[1:]}, nil\r\n"]
[1909.471389, "o", "}\r\n\r\nfunc encodeCSV(header []string, rows [][]string) ([]byte, error) {\r\n    var buf bytes.Buffer\r\n    w := csv.NewWriter(&buf)\r\n"]
[1909.471465, "o", "    if header != nil {\r\n        if err := w.Write(header); err != nil {\r\n            return nil, err\r\n        }\r\n    }\r\n    for _, row := range rows {\r\n        if err := w.Write(row); err != nil {\r\n            return nil, err\r\n        }\r\n    }\r\n    w.Flush()\r\n    return buf.Bytes(), w.Error()\r\n}\r\n"]
[1909.47148, "o", "\r\nfunc writeBytes(path string, data []byte) error {\r\n    dir := filepath.Dir(path)\r\n    if dir != \"\" && dir != \".\" {\r\n        if err := os.MkdirAll(dir, 0755); err != nil {\r\n"]
[1909.471568, "o", "            return err\r\n        }\r\n    }\r\n    return os.WriteFile(path, data, 0644)\r\n}\r\n\r\nfunc WriteCSV(path string, header []string, rows [][]string) error {\r\n    data, err := encodeCSV(header, rows)\r\n    if err != nil {\r\n        return err\r\n    }\r\n    return writeBytes(path, data)\r\n}\r\n\r\nfunc WriteCSVWithChecksum(path string, header []string, rows [][]string) error {\r\n    data, err := encodeCSV(header, rows)\r\n    if err != nil {"]
[1909.471583, "o", "\r\n        return err\r\n    }"]
[1909.471658, "o", "\r\n    if err := writeBytes(path, data); err != nil {\r\n        return err\r\n    }\r\n    sum := sha256.Sum256(data)\r\n    return os.WriteFile(path+\".sha256\", []byte(hex.EncodeToString(sum[:])+\"\\n\"), 0644)\r\n}\r\n\r\nfunc ComputeFileHash(path string) (string, error) {\r\n    data, err := os.ReadFile(path)\r\n    if err != nil {\r\n        if os.IsNotExist(err) {\r\n            return \"\", newFileNotFoundError(path)\r\n        }\r\n        return \"\", err\r\n"]
[1909.471675, "o", "    }\r\n    sum := sha256.Sum256(data)\r\n    return hex.EncodeToString(sum[:]), nil\r\n}\r\n"]
[1909.471748, "o", "\r\nfunc loadJSON(path string, v interface{}) error {\r\n    f, err := os.Open(path)\r\n    if err != nil {\r\n        if os.IsNotExist(err) {\r\n            return newFileNotFoundError(path)\r\n        }\r\n        return err\r\n    }\r\n    defer f.Close()\r\n    dec := json.NewDecoder(f)\r\n    if err := dec.Decode(v); err != nil {\r\n        return fmt.Errorf(\"ERROR: malformed JSON: %s\", path)\r\n    }\r\n    return nil\r\n}\r\n"]
