[1977.644024, "o", "   109\tfunc parseExpr(s string) (exprNode, error) {\r\n   110\ttokens, err := tokenizeExpr(s)\r\n   111\tif err != nil {\r\n   112\treturn nil, err\r\n   113\t}\r\n   114\tp := &exprParser{tokens: tokens, expr: s}\r\n   115\tnode, err := p.parseOr()\r\n"]
[1977.644119, "o", "   116\tif err != nil {\r\n   117\treturn nil, err\r\n   118\t}\r\n   119\tif p.peek().typ != \"eof\" {\r\n   120\treturn nil, fmt.Errorf(\"unexpected token %q\", p.peek().val)\r\n   121\t}\r\n   122\treturn node, nil\r\n   123\t}\r\n   124\t\r\n   125\tfunc (p *exprParser) peek() exprToken {\r\n   126\treturn p.tokens[p.pos]\r\n   127\t}\r\n   128\t\r\n   129\tfunc (p *exprParser) next() exprToken {\r\n   130\tt := p.tokens[p.pos]\r\n   131\tp.pos++\r\n   132\treturn t\r\n   133\t}\r\n   134\t\r\n   135\tfunc (p *exprParser) parseOr() (exprNode, error) {\r\n"]
[1977.644198, "o", "   136\tleft, err := p.parseAnd()\r\n   137\tif err != nil {\r\n   138\treturn nil, err\r\n   139\t}\r\n   140\tfor p.peek().typ == \"op\" && p.peek().val == \"||\" {\r\n   141\tp.next()\r\n   142\tright, err := p.parseAnd()\r\n   143\tif err != nil {\r\n   144\treturn nil, err\r\n   145\t}\r\n   146\tleft = &binaryNode{op: \"||\", left: left, right: right}\r\n   147\t}\r\n   148\treturn left, nil\r\n"]
[1977.644266, "o", "   149\t}\r\n   150\t\r\n   151\tfunc (p *exprParser) parseAnd() (exprNode, error) {\r\n   152\tleft, err := p.parseEquality()\r\n   153\tif err != nil {\r\n   154\treturn nil, err\r\n   155\t}\r\n   156\tfor p.peek().typ == \"op\" && p.peek().val == \"&&\" {\r\n   157\tp.next()\r\n   158\tright, err := p.parseEquality()\r\n   159\tif err != nil {\r\n   160\treturn nil, err\r\n   161\t}\r\n"]
[1977.644327, "o", "   162\tleft = &binaryNode{op: \"&&\", left: left, right: right}\r\n   163\t}\r\n   164\treturn left, nil\r\n   165\t}\r\n   166\t\r\n   167\tfunc (p *exprParser) parseEquality() (exprNode, error) {\r\n   168\tleft, err := p.parseRelational()\r\n   169\tif err != nil {\r\n   170\treturn nil, err\r\n   171\t}\r\n"]
[1977.644388, "o", "   172\tfor p.peek().typ == \"op\" && (p.peek().val == \"==\" || p.peek().val == \"!=\") {\r\n   173\top := p.next().val\r\n   174\tright, err := p.parseRelational()\r\n   175\tif err != nil {\r\n   176\treturn nil, err\r\n   177\t}\r\n   178\tleft = &binaryNode{op: op, left: left, right: right}\r\n   179\t}\r\n   180\treturn left, nil\r\n   181\t}\r\n"]
[1977.644451, "o", "   182\t\r\n   183\tfunc (p *exprParser) parseRelational() (exprNode, error) {\r\n   184\tleft, err := p.parseAdditive()\r\n   185\tif err != nil {\r\n   186\treturn nil, err\r\n   187\t}\r\n   188\tfor p.peek().typ == \"op\" && (p.peek().val == \">\" || p.peek().val == \">=\" || p.peek().val == \"<\" || p.peek().val == \"<=\") {\r\n   189\top := p.next().val\r\n"]
[1977.644539, "o", "   190\tright, err := p.parseAdditive()\r\n   191\tif err != nil {\r\n   192\treturn nil, err\r\n   193\t}\r\n   194\tleft = &binaryNode{op: op, left: left, right: right}\r\n   195\t}\r\n   196\treturn left, nil\r\n   197\t}\r\n   198\t\r\n   199\tfunc (p *exprParser) parseAdditive() (exprNode, error) {\r\n   200\tleft, err := p.parseMultiplicative()\r\n   201\tif err != nil {\r\n"]
