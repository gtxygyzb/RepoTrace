[1977.926609, "o", "   429\tcase \"sqrt\":\r\n   430\tif vals[0] < 0 {\r\n   431\treturn math.NaN(), nil\r\n   432\t}\r\n   433\treturn math.Sqrt(vals[0]), nil\r\n   434\tcase \"ceil\":\r\n   435\treturn math.Ceil(vals[0]), nil\r\n   436\tcase \"floor\":\r\n   437\treturn math.Floor(vals[0]), nil\r\n   438\tcase \"round\":\r\n   439\tif math.IsNaN(vals[1]) || vals[1] < 0 || vals[1] != math.Floor(vals[1]) {\r\n   440\treturn 0, fmt.Errorf(\"round requires non-negative integer n\")\r\n   441\t}\r\n   442\tn := int(vals[1])\r\n   443\treturn roundHalfAway(vals[0], n), nil\r\n   444\t"]
