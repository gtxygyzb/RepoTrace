[1977.322473, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t    \"fmt\"\r\n     5\t    \"regexp\"\r\n"]
[1977.322592, "o", "     6\t    \"sort\"\r\n     7\t    \"strconv\"\r\n     8\t    \"strings\"\r\n     9\t    \"time\"\r\n    10\t)\r\n    11\t\r\n    12\ttype ColumnSchema struct {\r\n    13\t    Name     string   `json:\"name\"`\r\n    14\t    Type     string   `json:\"type\"`\r\n    15\t    Required bool     `json:\"required\"`\r\n    16\t    Unique   bool     `json:\"unique\"`\r\n    17\t    Min      *float64 `json:\"min\"`\r\n    18\t    Max      *float64 `json:\"max\"`\r\n"]
[1977.32267, "o", "    19\t    Pattern  string   `json:\"pattern\"`\r\n    20\t    pattern  *regexp.Regexp\r\n    21\t}\r\n    22\t\r\n    23\ttype Schema struct {\r\n    24\t    Columns    []ColumnSchema `json:\"columns\"`\r\n    25\t    PrimaryKey []string       `json:\"primary_key\"`\r\n    26\t}\r\n    27\t\r\n    28\ttype RejectedRow struct {\r\n    29\t    Row    []string\r\n    30\t    Reason string\r\n    31\t}\r\n    32\t\r\n"]
[1977.322737, "o", "    33\tfunc LoadSchema(path string) (*Schema, error) {\r\n    34\t    var schema Schema\r\n    35\t    if err := loadJSON(path, &schema); err != nil {\r\n    36\t        return nil, err\r\n    37\t    }\r\n    38\t    for i, col := range schema.Columns {\r\n    39\t        if col.Pattern != \"\" {\r\n    40\t            re, err := regexp.Compile(col.Pattern)\r\n    41\t            if err != nil {\r\n    42"]
[1977.3228, "o", "\t                return nil, fmt.Errorf(\"ERROR: invalid pattern: %s\", col.Pattern)\r\n    43\t            }\r\n    44\t            schema.Columns[i].pattern = re\r\n    45\t        }\r\n    46\t    }\r\n    47\t    return &schema, nil\r\n    48\t}\r\n    49\t\r\n    50\tfunc headerIndex(header []string, name string) int {\r\n"]
[1977.322861, "o", "    51\t    for i, h := range header {\r\n    52\t        if h == name {\r\n    53\t            return i\r\n    54\t        }\r\n    55\t    }\r\n    56\t    return -1\r\n    57\t}\r\n    58\t\r\n    59\tfunc validateSchemaHeader(schema *Schema, header []string) error {\r\n    60\t    if len(schema.PrimaryKey) == 0 {\r\n"]
[1977.322939, "o", "    61\t        return fmt.Errorf(\"ERROR: invalid schema: primary_key is required\")\r\n    62\t    }\r\n    63\t    for _, col := range schema.Columns {\r\n    64\t        if headerIndex(header, col.Name) == -1 {\r\n    65\t            return fmt.Errorf(\"ERROR: invalid schema: column %s not found in header\", col.Name)\r\n    66\t        }\r\n    67\t    }\r\n    68\t    for _, pk := range schema.PrimaryKey {\r\n    69\t        if headerIndex(header, pk) == -1 {\r\n    70\t            return fmt.Errorf(\"ERROR: invalid schema: primary key column %s not found in header\", pk)\r\n    71\t        }\r\n    72\t    }\r\n    73\t    return nil\r\n    74\t}\r\n"]
[1977.322996, "o", "    75\t\r\n    76\tfunc parseSchemaValue(col ColumnSchema, value string) (bool, string) {\r\n    77\t    switch col.Type {\r\n    78\t    case \"int\":\r\n    79\t        if _, err := strconv.ParseInt(value, 10, 64); err != nil {\r\n    80\t            return false, \"invalid value for column \" + col.Name + \": \" + value\r\n    81\t        }\r\n    82\t    case \"float\":\r\n"]
[1977.323059, "o", "    83\t        if _, err := strconv.ParseFloat(value, 64); err != nil {\r\n    84\t            return false, \"invalid value for column \" + col.Name + \": \" + value\r\n    85\t        }\r\n    86\t    case \"datetime\":\r\n    87\t        if _, err := time.Parse(time.RFC3339, value); err != nil {\r\n    88\t            return false, \"invalid value for column \" + col.Name + \": \" + value\r\n    89\t        }\r\n    90\t    case \"string\":\r\n    91\t        // no additional type check\r\n    92\t"]
[1977.323116, "o", "    default:\r\n    93\t        return false, \"invalid type for column \" + col.Name + \": \" + col.Type\r\n    94\t    }\r\n    95\t    return true, \"\"\r\n    96\t}\r\n    97\t\r\n    98\tfunc validateRow(schema *Schema, header []string, row []string) (bool, string) {\r\n    99\t    get := func(col ColumnSchema) string {\r\n   100\t"]
[1977.323173, "o", "        idx := headerIndex(header, col.Name)\r\n   101\t        if idx == -1 || idx >= len(row) {\r\n   102\t            return \"\"\r\n   103\t        }\r\n   104\t        return row[idx]\r\n   105\t    }\r\n   106\t\r\n   107\t    for _, col := range schema.Columns {\r\n"]
[1977.32323, "o", "   108\t        val := get(col)\r\n   109\t        if col.Required && val == \"\" {\r\n   110\t            return false, \"missing required column: \" + col.Name\r\n   111\t        }\r\n   112\t        if val != \"\" {\r\n   113\t            ok, reason := parseSchemaValue(col, val)\r\n   114\t            if !ok {\r\n   115\t                return false, reason\r\n   116\t            }\r\n"]
[1977.323284, "o", "   117\t        }\r\n   118\t    }\r\n   119\t\r\n   120\t    for _, col := range schema.Columns {\r\n"]
