[1917.520131, "o", "\r\nfunc (p *exprParser) parseAnd() (exprNode, error) {\r\nleft, err := p.parseEquality()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nfor p.peek().typ == \"op\" && p.peek().val == \"&&\" {\r\np.next()\r\nright, err := p.parseEquality()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\n"]
