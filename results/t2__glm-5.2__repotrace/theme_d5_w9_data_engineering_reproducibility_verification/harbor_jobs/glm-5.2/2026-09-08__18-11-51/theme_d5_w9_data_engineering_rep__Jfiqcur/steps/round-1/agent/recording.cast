[1977.926101, "o", "\tif l > 0 || r > 0 {\r\n   350\treturn 1, nil\r\n   351\t}\r\n   352\treturn 0, nil\r\n   353\tcase \"&&\":\r\n   354\tif l > 0 && r > 0 {\r\n   355\treturn 1, nil\r\n   356\t}\r\n   357\treturn 0, nil\r\n   358\tcase \"==\":\r\n   359\tif math.IsNaN(l) || math.IsNaN(r) {\r\n   360\treturn 0, nil\r\n   361\t}\r\n   362\tif l == r {\r\n   363\treturn 1, nil\r\n"]
