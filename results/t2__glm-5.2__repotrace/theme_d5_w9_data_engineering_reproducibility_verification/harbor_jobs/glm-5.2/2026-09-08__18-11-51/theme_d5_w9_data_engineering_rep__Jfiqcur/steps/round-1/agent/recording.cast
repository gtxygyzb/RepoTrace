[1987.029757, "o", "    34\t    var schema Schema\r\n    35\t    if err := loadJSON(path, &schema); err != nil {\r\n    36\t        return nil, err\r\n    37\t    }\r\n    38\t    for i, col := range schema.Columns {\r\n    39\t        if col.Pattern != \"\" {\r\n    40\t            re, err := regexp.Compile(col.Pattern)\r\n    41\t            if err != nil {\r\n    42\t                return nil, fmt.Errorf(\"ERROR: invalid pattern: %s\", col.Pattern)\r\n    43\t            }\r\n    44\t            schema.Columns[i].pattern = re\r\n    45\t        }\r\n    46\t    }\r\n"]
[1987.029821, "o", "    47\t    return &schema, nil\r\n    48\t}\r\n    49\t\r\n    50\tfunc headerIndex(header []string, name string) int {\r\n    51\t    for i, h := range header {\r\n    52\t        if h == name {\r\n    53\t            return i\r\n    54\t        }\r\n    55\t    }\r\n    56\t    return -1\r\n    57\t}\r\n    58\t\r\n    59\tfunc validateSchemaHeader(schema *Schema, header []string) error {\r\n    60\t    if len(schema.PrimaryKey) == 0 {\r\n    61\t        return fmt.Errorf(\"ERROR: invalid schema: primary_key is required\")\r\n    62\t    }\r\n    63\t    for _, col := range schema.Columns {\r\n    64\t        if headerIndex(header, col.Name) == -1 {\r\n"]
[1987.029884, "o", "    65\t            return fmt.Errorf(\"ERROR: invalid schema: column %s not found in header\", col.Name)\r\n    66\t        }\r\n    67\t    }\r\n    68\t    for _, pk := range schema.PrimaryKey {\r\n    69\t        if headerIndex(header, pk) == -1 {\r\n    70\t            return fmt.Errorf(\"ERROR: invalid schema: primary key column %s not found in header\", pk)\r\n    71\t        }\r\n    72\t    }\r\n    73\t    return nil\r\n    74"]
[1987.029999, "o", "\t}\r\n    75\t\r\n    76\tfunc parseSchemaValue(col ColumnSchema, value string) (bool, string) {\r\n    77\t    switch col.Type {\r\n    78\t    case \"int\":\r\n    79\t        if _, err := strconv.ParseInt(value, 10, 64); err != nil {\r\n    80\t            return false, \"invalid value for column \" + col.Name + \": \" + value\r\n"]
