[2821.285864, "i", "cat > compare.go <<'EOF'\npackage main\n\nimport (\n\t\"fmt\"\n\t\"math\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n)\n\ntype compareChange struct {\n\tType string                 `json:\"type\"`\n\tKey  map[string]string      `json:\"key\"`\n\tRow  map[string]string      `json:\"row,omitempty\"`\n\tLeft map[string]string      `json:\"left,omitempty\"`\n\tRight map[string]string     `json:\"right,omitempty\"`\n\tDiff []string               `json:\"diff,omitempty\"`\n}\n\ntype compareOutput struct {\n\tSummary compareSummary `json:\"summary\"`\n\tChanges []compareChange `json:\"changes\"`\n}\n\ntype compareSummary struct {\n\tLeftRows   int `json:\"left_rows\"`\n\tRightRows  int `json:\"right_rows\"`\n\tAdded      int `json:\"added\"`\n\tRemoved    int `json:\"removed\"`\n\tModified   int `json:\"modified\"`\n\tUnchanged  int `json:\"unchanged\"`\n}\n\nfunc runCompare(leftPath, rightPath, keyArg, outputPath string, tolerance float64, ignoreCols []string) error {\n\tleft, err := ReadCSV(leftPath)\n\tif err != nil {\n\t\treturn err\n\t}\n\tright, err := ReadCSV(rightPath)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif !s"]
[2821.286122, "i", "ameStrings(left.Header, right.Header) {\n\t\treturn fmt.Errorf(\"ERROR: schema mismatch: headers differ\")\n\t}\n\theader := left.Header\n\tkeys := splitCSVList(keyArg)\n\tfor _, k := range keys {\n\t\tif indexOf(header, k) < 0 {\n\t\t\treturn fmt.Errorf(\"ERROR: invalid key: column %s not found\", k)\n\t\t}\n\t}\n\tfor _, c := range ignoreCols {\n\t\tif indexOf(header, c) < 0 {\n\t\t\treturn fmt.Errorf(\"ERROR: invalid ignore: column %s not found\", c)\n\t\t}\n\t}\n\n\tignoreSet := map[string]struct{}{}\n\tfor _, c := range ignoreCols {\n\t\tignoreSet[c] = struct{}{}\n\t}\n\tkeySet := map[string]struct{}{}\n\tfor _, k := range keys {\n\t\tkeySet[k] = struct{}{}\n\t}\n\n\tleftRows := buildKeyedRows(left, keys)\n\trightRows := buildKeyedRows(right, keys)\n\n\tadded, removed, modified, unchanged := 0, 0, 0, 0\n\tchanges := []compareChange{}\n\n\tfor k, rrow := range rightRows {\n\t\tif _, ok := leftRows[k]; !ok {\n\t\t\tadded++\n\t\t\tchanges = append(changes, compareChange{\n\t\t\t\tType: \"added\",\n\t\t\t\tKey:  keyMap(keys, rrow),\n\t\t\t\tRow:  rowMap(header, rrow),\n\t\t\t})\n\t\t}\n\t}\n\tfor k, lrow := range leftRo"]
[2821.286288, "i", "ws {\n\t\trrow, ok := rightRows[k]\n\t\tif !ok {\n\t\t\tremoved++\n\t\t\tchanges = append(changes, compareChange{\n\t\t\t\tType: \"removed\",\n\t\t\t\tKey:  keyMap(keys, lrow),\n\t\t\t\tRow:  rowMap(header, lrow),\n\t\t\t})\n\t\t\tcontinue\n\t\t}\n\t\tdiff := diffColumns(header, lrow, rrow, keySet, ignoreSet, tolerance)\n\t\tif len(diff) > 0 {\n\t\t\tmodified++\n\t\t\tchanges = append(changes, compareChange{\n\t\t\t\tType:  \"modified\",\n\t\t\t\tKey:   keyMap(keys, lrow),\n\t\t\t\tLeft:  rowMap(header, lrow),\n\t\t\t\tRight: rowMap(header, rrow),\n\t\t\t\tDiff:  diff,\n\t\t\t})\n\t\t} else {\n\t\t\tunchanged++\n\t\t}\n\t}\n\n\tsort.SliceStable(changes, func(i, j int) bool {\n\t\tti := changeTypeOrder(changes[i].Type)\n\t\ttj := changeTypeOrder(changes[j].Type)\n\t\tif ti != tj {\n\t\t\treturn ti < tj\n\t\t}\n\t\treturn joinKey(keys, changes[i].Key) < joinKey(keys, changes[j].Key)\n\t})\n\n\tout := compareOutput{\n\t\tSummary: compareSummary{\n\t\t\tLeftRows:  len(left.Rows),\n\t\t\tRightRows: len(right.Rows),\n\t\t\tAdded:     added,\n\t\t\tRemoved:   removed,\n\t\t\tModified:  modified,\n\t\t\tUnchanged: unchanged,\n\t\t},\n\t\tChanges: changes,\n\t}\n\treturn writeJ"]
