[1917.520598, "o", "p.next()\r\nf, err := strconv.ParseFloat(t.val, 64)\r\nif err != nil {\r\nreturn nil, fmt.Errorf(\"invalid number %q\", t.val)\r\n}\r\nreturn numberNode(f), nil\r\n}\r\nif t.typ == \"ident\" {\r\np.next()\r\nif p.peek().typ == \"op\" && p.peek().val == \"(\" {\r\np.next()\r\nvar args []exprNode\r\nif p.peek().typ != \"op\" || p.peek().val != \")\" {\r\nfor {\r\narg, err := p.parseOr()\r\nif err != nil {\r\nreturn nil, err\r\n"]
