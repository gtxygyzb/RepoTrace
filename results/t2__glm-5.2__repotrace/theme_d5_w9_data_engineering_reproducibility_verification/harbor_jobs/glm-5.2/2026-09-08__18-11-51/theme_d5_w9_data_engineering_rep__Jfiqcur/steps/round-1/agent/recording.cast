[1521.249468, "o", "            if col.Name == pk {\r\n\u001b[?2004l\r\u001b[?2004h>                 colType = col.Type\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         cmp := compareTyped(av, bv, colType)\r\n\u001b[?2004l\r\u001b[?2004h>         if cmp < 0 {\r\n\u001b[?2004l\r\u001b[?2004h>             return true\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         if cmp > 0 {\r\n\u001b[?2004l\r\u001b[?2004h>             return false\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return false\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func compareTyped(a, b, colType string) int {\r\n\u001b[?2004l\r\u001b[?2004h>     switch colType {\r\n\u001b[?2004l\r\u001b[?2004h>     case \"int\", \"float\":\r\n\u001b[?2004l\r\u001b[?2004h>         af, aok := strconv.ParseFloat(a, 64)\r\n\u001b[?2004l\r\u001b[?2004h>         bf, bok := strconv.ParseFloat(b, 64)\r\n\u001b[?2004l\r\u001b[?2004h>         if aok == nil && bok == nil {\r\n\u001b[?2004l\r\u001b[?2004h>             if af < bf {\r\n\u001b[?2004l\r\u001b[?2004h>                 return -"]
