[1917.519887, "o", "if c == ',' {\r\ntokens = append(tokens, exprToken{\"comma\", \",\"})\r\ni++\r\ncontinue\r\n}\r\nreturn nil, fmt.Errorf(\"unexpected character %q\", c)\r\n}\r\ntokens = append(tokens, exprToken{\"eof\", \"\"})\r\nreturn tokens, nil\r\n}\r\n\r\nfunc parseExpr(s string) (exprNode, error) {\r\n"]
[1917.51993, "o", "tokens, err := tokenizeExpr(s)\r\nif err != nil {\r\nreturn nil, err\r\n}\r\np := &exprParser{tokens: tokens, expr: s}\r\nnode, err := p.parseOr()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nif p.peek().typ != \"eof\" {\r\nreturn nil, fmt.Errorf(\"unexpected token %q\", p.peek().val)\r\n"]
[1917.520012, "o", "}\r\nreturn node, nil\r\n}\r\n\r\nfunc (p *exprParser) peek() exprToken {\r\nreturn p.tokens[p.pos]\r\n}\r\n\r\nfunc (p *exprParser) next() exprToken {\r\nt := p.tokens[p.pos]\r\np.pos++\r\nreturn t\r\n}\r\n\r\nfunc (p *exprParser) parseOr() (exprNode, error) {\r\nleft, err := p.parseAnd()\r\nif err != nil {\r\n"]
