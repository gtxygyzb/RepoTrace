[1909.481883, "o", "}\r\np.next()\r\nreturn p.validateFunc(t.val, args)\r\n}\r\nreturn columnNode(t.val), nil\r\n}\r\nif t.typ == \"op\" && t.val == \"(\" {\r\np.next()\r\nnode, err := p.parseOr()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nif p.peek().typ != \"op\" || p.peek().val != \")\" {\r\nreturn nil, fmt.Errorf(\"expected )\")\r\n}\r\np.next()\r\nreturn node, nil\r\n"]
[1909.481945, "o", "}\r\nreturn nil, fmt.Errorf(\"unexpected token %q\", t.val)\r\n}\r\n\r\nfunc (p *exprParser) validateFunc(name string, args []exprNode) (exprNode, error) {\r\nswitch name {\r\ncase \"abs\", \"sqrt\", \"ceil\", \"floor\", \"log\":\r\nif len(args) != 1 {\r\nreturn nil, fmt.Errorf(\"%s expects 1 argument\", name)\r\n}\r\ncase \"round\", \"pow\", \"min\", \"max\", \"coalesce\":\r\nif len(args) != 2 {\r\n"]
[1909.482002, "o", "return nil, fmt.Errorf(\"%s expects 2 arguments\", name)\r\n}\r\ncase \"if\", \"clamp\":\r\nif len(args) != 3 {\r\nreturn nil, fmt.Errorf(\"%s expects 3 arguments\", name)\r\n}\r\ndefault:\r\nreturn nil, fmt.Errorf(\"unknown function %s\", name)\r\n}\r\nreturn &funcNode{name: name, args: args}, nil\r\n}\r\n"]
