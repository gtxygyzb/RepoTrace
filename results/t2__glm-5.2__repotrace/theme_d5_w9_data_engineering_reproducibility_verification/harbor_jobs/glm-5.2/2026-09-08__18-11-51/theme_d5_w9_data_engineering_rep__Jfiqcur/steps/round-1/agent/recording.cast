[1917.520256, "o", "right, err := p.parseRelational()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nleft = &binaryNode{op: op, left: left, right: right}\r\n}\r\nreturn left, nil\r\n"]
[1917.520339, "o", "}\r\n\r\nfunc (p *exprParser) parseRelational() (exprNode, error) {\r\nleft, err := p.parseAdditive()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nfor p.peek().typ == \"op\" && (p.peek().val == \">\" || p.peek().val == \">=\" || p.peek().val == \"<\" || p.peek().val == \"<=\") {\r\nop := p.next().val\r\nright, err := p.parseAdditive()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nleft = &binaryNode{op: op, left: left, right: right}\r\n}\r\nreturn left, nil\r\n}\r\n\r\nfunc (p *exprParser) parseAdditive() (exprNode, error) {\r\nleft, err := p.parseMultiplicative()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nfor p.peek().typ == \"op\" && (p.peek().val == \"+\" || p.peek().val == \"-\") {\r\nop := p.next().val\r\nright, err := p.parseMultiplicative()\r\n"]
