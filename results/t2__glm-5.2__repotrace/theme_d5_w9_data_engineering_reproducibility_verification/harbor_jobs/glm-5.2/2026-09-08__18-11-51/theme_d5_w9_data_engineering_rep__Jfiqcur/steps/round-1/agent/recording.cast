[1977.926222, "o", "   374\tcase \">\", \">=\", \"<\", \"<=\":\r\n   375\tif math.IsNaN(l) || math.IsNaN(r) {\r\n   376\treturn 0, nil\r\n   377\t}\r\n   378\tswitch n.op {\r\n   379\tcase \">\":\r\n   380\tif l > r {\r\n   381\treturn 1, nil\r\n   382\t}\r\n   383\tcase \">=\":\r\n   384\tif l >= r {\r\n"]
