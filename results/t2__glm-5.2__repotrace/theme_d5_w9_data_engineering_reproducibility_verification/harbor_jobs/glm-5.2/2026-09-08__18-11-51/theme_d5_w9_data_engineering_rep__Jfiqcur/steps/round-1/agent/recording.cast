[1909.477468, "o", "sed -n '1,320p' expr.go\r\n\u001b[?2004l\r"]
[1909.480399, "o", "package main\r\n\r\nimport (\r\n\"fmt\"\r\n"]
[1909.480414, "o", "\"math\"\r\n\"strconv\"\r\n\"strings\"\r\n"]
[1909.480503, "o", ")\r\n"]
[1909.480521, "o", "\r\ntype exprToken struct {\r\ntyp string\r\nval string\r\n}\r\n\r\ntype exprParser struct {\r\ntokens []exprToken\r\npos    int\r\nexpr   string\r\n}\r\n\r\ntype exprNode interface {\r\neval(env map[string]float64) (float64, error)\r\n}\r\n\r\ntype numberNode float64\r\n\r\n"]
[1909.480602, "o", "type columnNode string\r\n\r\ntype unaryNode struct {\r\nop   string\r\nchild exprNode\r\n}\r\n\r\ntype binaryNode struct {\r\nop       string\r\nleft     exprNode\r\nright    exprNode"]
[1909.480623, "o", "\r\n"]
[1909.480694, "o", "}\r\n\r\ntype funcNode struct {\r\nname string\r\nargs []exprNode\r\n}\r\n\r\n"]
[1909.48071, "o", "func tokenizeExpr(s string) ([]exprToken, error) {\r\nvar tokens []exprToken\r\ni := 0\r\n"]
[1909.480781, "o", "for i < len(s) {\r\nc := s[i]\r\nif c == ' ' || c == '\\t' || c == '\\n' || c == '\\r' {\r\ni++\r\ncontinue\r\n}\r\nif c >= '0' && c <= '9' || (c == '.' && i+1 < len(s) && s[i+1] >= '0' && s[i+1] <= '9') {\r\nstart := i\r\nfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\r\ni++\r\n}\r\nif i < len(s) && s[i] == '.' {\r\ni++\r\nfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\r\ni++\r\n}\r\n}"]
[1909.480795, "o", "\r\nif i < len(s) && (s[i] == 'e' || s[i] == 'E') {\r\ni++\r\n"]
