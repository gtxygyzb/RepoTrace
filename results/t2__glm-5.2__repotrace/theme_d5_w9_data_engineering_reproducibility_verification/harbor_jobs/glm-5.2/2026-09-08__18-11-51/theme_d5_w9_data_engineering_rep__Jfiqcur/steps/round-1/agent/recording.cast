[2821.286703, "i", " []string {\n\tif s == \"\" {\n\t\treturn nil\n\t}\n\tparts := strings.Split(s, \",\")\n\tout := make([]string, 0, len(parts))\n\tfor _, p := range parts {\n\t\tout = append(out, p)\n\t}\n\treturn out\n}\n\nfunc sameStrings(a, b []string) bool {\n\tif len(a) != len(b) {\n\t\treturn false\n\t}\n\tfor i := range a {\n\t\tif a[i] != b[i] {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc indexOf(slice []string, s string) int {\n\tfor i, v := range slice {\n\t\tif v == s {\n\t\t\treturn i\n\t\t}\n\t}\n\treturn -1\n}\n\nfunc cellAt(row []string, i int) string {\n\tif i < len(row) {\n\t\treturn row[i]\n\t}\n\treturn \"\"\n}\nEOF\n"]
