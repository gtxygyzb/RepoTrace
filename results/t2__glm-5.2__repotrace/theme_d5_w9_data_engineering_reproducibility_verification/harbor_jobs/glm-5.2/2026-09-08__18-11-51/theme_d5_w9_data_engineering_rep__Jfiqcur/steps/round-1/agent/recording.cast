[3083.123468, "i", "        return transformEncode(ds, step)\r    case \"rollup\":\r        return transformRollup(ds, step)\r    case \"detect\":\r        return transformDetect(ds, step)\r    case \"bin\":\r        return transformBin(ds, step)\r    case \"hash\":\r        return transformHash(ds, step)\r    default:\r        return nil, fmt.Errorf(\"ERROR: invalid recipe: unknown op %s\", op)\r    }\r}\r\rfunc validateColumns(ds *Dataset, cols []string) error {\r    for _, c := range cols {\r        if indexOf(ds.Header, c) < 0 {\r            return fmt.Errorf(\"ERROR: invalid recipe: column %s not found\", c)\r        }\r    }\r    return nil\r}\r\rfunc evalExpressionRow(expr exprNode, header []string, row []string) (float64, error) {\r    env := make(map[string]float64, len(header))\r    for i, col := range header {\r        if i < len(row) {\r            env[col] = parseNumberOrNaN(row[i])\r        } else {\r            env[col] = math.NaN()\r        }\r    }\r    return expr.eval(env)\r}\r\rfunc transformDerive(ds *Dataset, step map[string]interface{}) (*Dataset, erro"]
