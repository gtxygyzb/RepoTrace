	sort.SliceStable(changes, func(i, j int) bool {
		ti := changeTypeOrder(changes[i].Type)
		tj := changeTypeOrder(changes[j].Type)
		if ti != tj {
			return ti < tj
		}
		return joinKey(keys, changes[i].Key) < joinKey(keys, changes[j].Key)
	})

	out := compareOutput{
		Summary: compareSummary{
			LeftRows:  len(left.Rows),
			RightRows: len(right.Rows),
			Added:     added,
			Removed:   removed,
			Modified:  modified,
			Unchanged: unchanged,
		},
		Changes: changes,
	}
	return writeJSONFile(outputPath, out)
}

type keyedRow struct {
	key string
	row []string
}

func buildKeyedRows(ds *Dataset, keys []string) map[string]keyedRow {
	idxs := make([]int, len(keys))
	for i, k := range keys {
		idxs[i] = indexOf(ds.Header, k)
	}
	out := map[string]keyedRow{}
	for _, row := range ds.Rows {
		parts := make([]string, len(keys))
		for i, idx := range idxs {
			if idx < len(row) {
				parts[i] = row[idx]
			} else {
				parts[i] = ""
			}
		}
		k := strings.Join(parts, "\x00")
		if _, exists := out[k]; !exists {
			out[k] = keyedRow{key: k, row: row}
		}
	}
	return out
}

func diffColumns(header []string, left, right []string, keySet, ignoreSet map[string]struct{}, tolerance float64) []string {
	diff := []string{}
	for i, col := range header {
		if _, isKey := keySet[col]; isKey {
			continue
		}
		if _, ignored := ignoreSet[col]; ignored {
			continue
		}
		lv := cellAt(left, i)
		rv := cellAt(right, i)
		if !equalWithTolerance(lv, rv, tolerance) {
			diff = append(diff, col)
		}
	}
	return diff
}

