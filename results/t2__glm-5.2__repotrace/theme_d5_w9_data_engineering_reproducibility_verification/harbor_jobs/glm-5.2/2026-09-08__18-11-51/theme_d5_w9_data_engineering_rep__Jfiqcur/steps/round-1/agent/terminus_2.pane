func validateColumns(ds *Dataset, cols []string) error {
    for _, c := range cols {
        if indexOf(ds.Header, c) < 0 {
            return fmt.Errorf("ERROR: invalid recipe: column %s not found", c)
        }
    }
    return nil
}

func evalExpressionRow(expr exprNode, header []string, row []string) (float64, error) {
    env := make(map[string]float64, len(header))
    for i, col := range header {
        if i < len(row) {
            env[col] = parseNumberOrNaN(row[i])
        } else {
            env[col] = math.NaN()
        }
    }
    return expr.eval(env)
}

func transformDerive(ds *Dataset, step map[string]interface{}) (*Dataset, error) {
    col := recipeString(step, "column")
    exprStr := recipeString(step, "expression")
    if col == "" || exprStr == "" {
        return nil, fmt.Errorf("ERROR: invalid recipe: derive requires column and expression")
    }
    expr, err := parseExpr(exprStr)
    if err != nil {
        return nil, fmt.Errorf("ERROR: invalid recipe: %v", err)
    }
    header := append([]string(nil), ds.Header...)
    idx := indexOf(header, col)
    if idx < 0 {
        idx = len(header)
        header = append(header, col)
    }
    rows := make([][]string, len(ds.Rows))
    for i, row := range ds.Rows {
        v, err := evalExpressionRow(expr, ds.Header, row)
        if err != nil {
            return nil, fmt.Errorf("ERROR: invalid recipe: %v", err)
        }
        out := append([]string(nil), row...)
        for len(out) < len(header) {
            out = append(out, "")
        }
        out[idx] = formatFloat(v)
        rows[i] = out
    }
    return &Dataset{Header: header, Rows: rows}, nil
}

func transformFill(ds *Dataset, step map[string]interface{}) (*Dataset, error) {
    cols := recipeStringList(step, "columns")
    if len(cols) == 0 {
        cols = ds.Header
    }
    if err := validateColumns(ds, cols); err != nil {
        return nil, err
    }
    strategy := recipeString(step, "strategy")
    switch strategy {
    case "constant":
        value := recipeString(step, "value")
        rows := make([][]string, len(ds.Rows))
        for i, row := range ds.Rows {
            out := append([]string(nil), row...)
            for _, c := range cols {
                idx := indexOf(ds.Header, c)
                if idx >= 0 && (idx >= len(out) || out[idx] == "") {
                    for len(out) <= idx {
                        out = append(out, "")
                    }
                    out[idx] = value
                }
            }
            rows[i] = out
        }
        return &Dataset{Header: ds.Header, Rows: rows}, nil
    case "linear":
        return fillLinear(ds, cols)
    default:
        return nil, fmt.Erro[?2004h> 