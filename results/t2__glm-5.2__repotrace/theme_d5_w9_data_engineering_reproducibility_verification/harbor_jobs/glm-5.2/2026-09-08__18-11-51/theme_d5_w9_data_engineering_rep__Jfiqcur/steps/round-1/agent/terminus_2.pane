            ds, err := applyTransform(current, step)
            if err != nil {
                return err
            }
            current = ds
            if out, _ := step["output"].(string); out != "" {
                if err := WriteCSV(out, current.Header, current.Rows); err != nil {
                    return err
                }
            }
        }
    }
    if output != "" && current != nil {
        return WriteCSV(output, current.Header, current.Rows)
    }
    return nil
}

func recipeString(step map[string]interface{}, key string) string {
    if v, ok := step[key]; ok {
        if s, ok := v.(string); ok {
            return s
        }
    }
    return ""
}

func recipeStringList(step map[string]interface{}, key string) []string {
    if v, ok := step[key]; ok {
        switch t := v.(type) {
        case []interface{}:
            out := make([]string, 0, len(t))
            for _, x := range t {
                if s, ok := x.(string); ok {
                    out = append(out, s)
                }
            }
            return out
        case []string:
            return t
        case string:
            return splitCSVList(t)
        }
    }
    return nil
}

func recipeBool(step map[string]interface{}, key string, def bool) bool {
    if v, ok := step[key]; ok {
        if b, ok := v.(bool); ok {
            return b
        }
    }
    return def
}

func recipeFloat(step map[string]interface{}, key string, def float64) float64 {
