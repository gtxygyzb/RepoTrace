    45	func tokenizeExpr(s string) ([]exprToken, error) {
    46	var tokens []exprToken
    47	i := 0
    48	for i < len(s) {
    49	c := s[i]
    50	if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
    51	i++
    52	continue
    53	}
    54	if c >= '0' && c <= '9' || (c == '.' && i+1 < len(s) && s[i+1] >= '0' && s[i+1] <= '9') {
    55	start := i
    56	for i < len(s) && s[i] >= '0' && s[i] <= '9' {
    57	i++
    58	}
    59	if i < len(s) && s[i] == '.' {
    60	i++
    61	for i < len(s) && s[i] >= '0' && s[i] <= '9' {
    62	i++
    63	}
    64	}
    65	if i < len(s) && (s[i] == 'e' || s[i] == 'E') {
    66	i++
    67	if i < len(s) && (s[i] == '+' || s[i] == '-') {
    68	i++
    69	}
    70	for i < len(s) && s[i] >= '0' && s[i] <= '9' {
    71	i++
    72	}
    73	}
    74	tokens = append(tokens, exprToken{"number", s[start:i]})
    75	continue
    76	}
    77	if c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c == '_' {
    78	start := i
    79	for i < len(s) && (s[i] >= 'A' && s[i] <= 'Z' || s[i] >= 'a' && s[i] <= 'z' || s[i] >= '0' && s[i] <= '9' || s[i] == '_') {
    80	i++
    81	}
    82	tokens = append(tokens, exprToken{"ident", s[start:i]})
    83	continue
    84	}
    85	if i+1 < len(s) {
    86	two := s[i : i+2]
    87	if two == "||" || two == "&&" || two == "==" || two == "!=" || two == ">=" || two == "<=" {
    88	tokens = append(tokens, exprToken{"op", two})
    89	i += 2
    90	continue
    91	}
    92	}
    93	if strings.IndexByte("+-*/%<>()!=", c) >= 0 {
    94	tokens = append(tokens, exprToken{"op", string(c)})
    95	i++
    96	continue
    97	}
    98	if c == ',' {
    99	tokens = append(tokens, exprToken{"comma", ","})
   100	i++
   101	continue
   102	}
   103	return nil, fmt.Errorf("unexpected character %q", c)
   104	}
   105	tokens = append(tokens, exprToken{"eof", ""})
   106	return tokens, nil
   107	}
   108	
   109	func parseExpr(s string) (exprNode, error) {
   110	tokens, err := tokenizeExpr(s)
   111	if err != nil {
   112	return nil, err
   113	}
   114	p := &exprParser{tokens: tokens, expr: s}
   115	node, err := p.parseOr()
   116	if err != nil {
   117	return nil, err
   118	}
   119	if p.peek().typ != "eof" {
   120	return nil, fmt.Errorf("unexpected token %q", p.peek().val)
   121	}
   122	return node, nil
   123	}
   124	
   125	func (p *exprParser) peek() exprToken {
   126	return p.tokens[p.pos]
   127	}
   128	
   129	func (p *exprParser) next() exprToken {
   130	t := p.tokens[p.pos]
   131	p.pos++
   132	return t
   133	}
   134	
   135	func (p *exprParser) parseOr() (exprNode, error) {
   136	left, err := p.parseAnd()
   137	if err != nil {
   138	return nil, err
   139	}
   140	for p.peek().typ == "op" && p.peek().val == "||" {
   141	p.next()
   142	right, err := p.parseAnd()
   143	if err != nil {
   144	return nil, err
   145	}
   146	left = &binaryNode{op: "||", left: left, right: right}
   147	}
   148	return left, nil
   149	}
   150	
   151	func (p *exprParser) parseAnd() (exprNode, error) {
   152	left, err := p.parseEquality()
   153	if err != nil {
   154	return nil, err
   155	}
   156	for p.peek().typ == "op" && p.peek().val == "&&" {
   157	p.next()
   158	right, err := p.parseEquality()
   159	if err != nil {
   160	return nil, err
   161	}
   162	left = &binaryNode{op: "&&", left: left, right: right}
   163	}
   164	return left, nil
   165	}
   166	
   167	func (p *exprParser) parseEquality() (exprNode, error) {
   168	left, err := p.parseRelational()
   169	if err != nil {
   170	return nil, err
   171	}
   172	for p.peek().typ == "op" && (p.peek().val == "==" || p.peek().val == "!=") {
   173	op := p.next().val
   174	right, err := p.parseRelational()
   175	if err != nil {
   176	return nil, err
   177	}
   178	left = &binaryNode{op: op, left: left, right: right}
   179	}
   180	return left, nil
   181	}
   182	
   183	func (p *exprParser) parseRelational() (exprNode, error) {
   184	left, err := p.parseAdditive()
   185	if err != nil {
   186	return nil, err
   187	}
   188	for p.peek().typ == "op" && (p.peek().val == ">" || p.peek().val == ">=" || p.peek().val == "<" || p.peek().val == "<=") {
   189	op := p.next().val
   190	right, err := p.parseAdditive()
   191	if err != nil {
   192	return nil, err
   193	}
   194	left = &binaryNode{op: op, left: left, right: right}
   195	}
   196	return left, nil
   197	}
   198	
   199	func (p *exprParser) parseAdditive() (exprNode, error) {
   200	left, err := p.parseMultiplicative()
   201	if err != nil {
   202	return nil, err
   203	}
   204	for p.peek().typ == "op" && (p.peek().val == "+" || p.peek().val == "-") {
   205	op := p.next().val
   206	right, err := p.parseMultiplicative()
   207	if err != nil {
   208	return nil, err
   209	}
   210	left = &binaryNode{op: op, left: left, right: right}
   211	}
   212	return left, nil
   213	}
   214	
   215	func (p *exprParser) parseMultiplicative() (exprNode, error) {
   216	left, err := p.parseUnary()
   217	if err != nil {
   218	return nil, err
   219	}
   220	for p.peek().typ == "op" && (p.peek().val == "*" || p.peek().val == "/" || p.peek().val == "%") {
   221	op := p.next().val
   222	right, err := p.parseUnary()
   223	if err != nil {
   224	return nil, err
   225	}
   226	left = &binaryNode{op: op, left: left, right: right}
   227	}
   228	return left, nil
   229	}
   230	
   231	func (p *exprParser) parseUnary() (exprNode, error) {
   232	if p.peek().typ == "op" && p.peek().val == "-" {
   233	p.next()
   234	child, err := p.parseUnary()
   235	if err != nil {
   236	return nil, err
   237	}
   238	return &unaryNode{op: "-", child: child}, nil
   239	}
   240	return p.parsePrimary()
   241	}
   242	
   243	func (p *exprParser) parsePrimary() (exprNode, error) {
   244	t := p.peek()
   245	if t.typ == "number" {
   246	p.next()
   247	f, err := strconv.ParseFloat(t.val, 64)
   248	if err != nil {
   249	return nil, fmt.Errorf("invalid number %q", t.val)
   250	}
   251	return numberNode(f), nil
   252	}
   253	if t.typ == "ident" {
   254	p.next()
   255	if p.peek().typ == "op" && p.peek().val == "(" {
   256	p.next()
   257	var args []exprNode
   258	if p.peek().typ != "op" || p.peek().val != ")" {
   259	for {
   260	arg, err := p.parseOr()
   261	if err != nil {
   262	return nil, err
   263	}
   264	args = append(args, arg)
   265	if p.peek().typ == "comma" {
   266	p.next()
   267	continue
   268	}
   269	break
   270	}
   271	}
   272	if p.peek().typ != "op" || p.peek().val != ")" {
   273	return nil, fmt.Errorf("expected ) in function call")
   274	}
   275	p.next()
   276	return p.validateFunc(t.val, args)
   277	}
   278	return columnNode(t.val), nil
   279	}
   280	if t.typ == "op" && t.val == "(" {
   281	p.next()
   282	node, err := p.parseOr()
   283	if err != nil {
   284	return nil, err
   285	}
   286	if p.peek().typ != "op" || p.peek().val != ")" {
   287	return nil, fmt.Errorf("expected )")
   288	}
   289	p.next()
   290	return node, nil
   291	}
   292	return nil, fmt.Errorf("unexpected token %q", t.val)
   293	}
   294	
   295	func (p *exprParser) validateFunc(name string, args []exprNode) (exprNode, error) {
   296	switch name {
   297	case "abs", "sqrt", "ceil", "floor", "log":
   298	if len(args) != 1 {
   299	return nil, fmt.Errorf("%s expects 1 argument", name)
   300	}
   301	case "round", "pow", "min", "max", "coalesce":
   302	if len(args) != 2 {
   303	return nil, fmt.Errorf("%s expects 2 arguments", name)
   304	}
   305	case "if", "clamp":
   306	if len(args) != 3 {
   307	return nil, fmt.Errorf("%s expects 3 arguments", name)
   308	}
   309	default:
   310	return nil, fmt.Errorf("unknown function %s", name)
   311	}
   312	return &funcNode{name: name, args: args}, nil
   313	}
   314	
   315	func (n numberNode) eval(env map[string]float64) (float64, error) {
   316	return float64(n), nil
   317	}
   318	
   319	func (n columnNode) eval(env map[string]float64) (float64, error) {
   320	v, ok := env[string(n)]
   321	if !ok {
   322	return 0, fmt.Errorf("column %s not found", string(n))
   323	}
   324	return v, nil
   325	}
   326	
   327	func (n *unaryNode) eval(env map[string]float64) (float64, error) {
   328	v, err := n.child.eval(env)
   329	if err != nil {
   330	return 0, err
   331	}
   332	if math.IsNaN(v) {
   333	return math.NaN(), nil
   334	}
   335	return -v, nil
   336	}
   337	
   338	func (n *binaryNode) eval(env map[string]float64) (float64, error) {
   339	l, err := n.left.eval(env)
   340	if err != nil {
   341	return 0, err
   342	}
   343	r, err := n.right.eval(env)
   344	if err != nil {
   345	return 0, err
   346	}
   347	switch n.op {
   348	case "||":
   349	if l > 0 || r > 0 {
   350	return 1, nil
   351	}
   352	return 0, nil
   353	case "&&":
   354	if l > 0 && r > 0 {
   355	return 1, nil
   356	}
   357	return 0, nil
   358	case "==":
   359	if math.IsNaN(l) || math.IsNaN(r) {
   360	return 0, nil
   361	}
   362	if l == r {
   363	return 1, nil
   364	}
   365	return 0, nil
   366	case "!=":
   367	if math.IsNaN(l) || math.IsNaN(r) {
   368	return 0, nil
   369	}
   370	if l != r {
   371	return 1, nil
   372	}
   373	return 0, nil
   374	case ">", ">=", "<", "<=":
   375	if math.IsNaN(l) || math.IsNaN(r) {
   376	return 0, nil
   377	}
   378	switch n.op {
   379	case ">":
   380	if l > r {
   381	return 1, nil
   382	}
   383	case ">=":
   384	if l >= r {
   385	return 1, nil
   386	}
   387	case "<":
   388	if l < r {
   389	return 1, nil
   390	}
   391	case "<=":
   392	if l <= r {
   393	return 1, nil
   394	}
   395	}
   396	return 0, nil
   397	case "+":
   398	return l + r, nil
   399	case "-":
   400	return l - r, nil
   401	case "*":
   402	return l * r, nil
   403	case "/":
   404	if r == 0 {
   405	return math.NaN(), nil
   406	}
   407	return l / r, nil
   408	case "%":
   409	if r == 0 {
   410	return math.NaN(), nil
   411	}
   412	return math.Mod(l, r), nil
   413	}
   414	return 0, fmt.Errorf("unknown operator %s", n.op)
   415	}
   416	
   417	func (n *funcNode) eval(env map[string]float64) (float64, error) {
   418	vals := make([]float64, len(n.args))
   419	for i, arg := range n.args {
   420	v, err := arg.eval(env)
   421	if err != nil {
   422	return 0, err
   423	}
   424	vals[i] = v
   425	}
   426	switch n.name {
   427	case "abs":
   428	return math.Abs(vals[0]), nil
   429	case "sqrt":
   430	if vals[0] < 0 {
   431	return math.NaN(), nil
   432	}
   433	return math.Sqrt(vals[0]), nil
   434	case "ceil":
   435	return math.Ceil(vals[0]), nil
   436	case "floor":
   437	return math.Floor(vals[0]), nil
   438	case "round":
   439	if math.IsNaN(vals[1]) || vals[1] < 0 || vals[1] != math.Floor(vals[1]) {
   440	return 0, fmt.Errorf("round requires non-negative integer n")
   441	}
   442	n := int(vals[1])
   443	return roundHalfAway(vals[0], n), nil
   444	case "pow":
   445	return math.Pow(vals[0], vals[1]), nil
   446	case "log":
   447	if vals[0] <= 0 {
   448	return math.NaN(), nil
   449	}
   450	return math.Log(vals[0]), nil
   451	case "min":
   452	if math.IsNaN(vals[0]) || math.IsNaN(vals[1]) {
   453	return math.NaN(), nil
   454	}
   455	return math.Min(vals[0], vals[1]), nil
   456	case "max":
   457	if math.IsNaN(vals[0]) || math.IsNaN(vals[1]) {
   458	return math.NaN(), nil
   459	}
   460	return math.Max(vals[0], vals[1]), nil
   461	case "if":
   462	if vals[0] > 0 {
   463	return vals[1], nil
   464	}
   465	return vals[2], nil
   466	case "clamp":
   467	if math.IsNaN(vals[0]) {
   468	return math.NaN(), nil
   469	}
   470	if vals[0] < vals[1] {
   471	return vals[1], nil
   472	}
   473	if vals[0] > vals[2] {
   474	return vals[2], nil
   475	}
   476	return vals[0], nil
   477	case "coalesce":
   478	if !math.IsNaN(vals[0]) {
   479	return vals[0], nil
   480	}
   481	return vals[1], nil
   482	}
   483	return 0, fmt.Errorf("unknown function %s", n.name)
   484	}
   485	
   486	func roundHalfAway(x float64, n int) float64 {
   487	if math.IsNaN(x) {
   488	return math.NaN()
   489	}
   490	pow := math.Pow(10, float64(n))
   491	scaled := x * pow
   492	if scaled >= 0 {
   493	return math.Floor(scaled+0.5) / pow
   494	}
   495	return math.Ceil(scaled-0.5) / pow
   496	}
   497	
   498	func formatFloat(f float64) string {
   499	if math.IsNaN(f) {
   500	return "NaN"
   501	}
   502	if f == 0 {
   503	return "0"
   504	}
   505	return strconv.FormatFloat(f, 'f', -1, 64)
   506	}
   507	
   508	func parseNumberOrNaN(s string) float64 {
   509	if s == "" {
   510	return math.NaN()
   511	}
   512	f, err := strconv.ParseFloat(s, 64)
   513	if err != nil {
   514	return math.NaN()
   515	}
   516	return f
   517	}
