type ColumnSchema struct {
    Name     string   `json:"name"`
    Type     string   `json:"type"`
    Required bool     `json:"required"`
    Unique   bool     `json:"unique"`
    Min      *float64 `json:"min"`
    Max      *float64 `json:"max"`
    Pattern  string   `json:"pattern"`
    pattern  *regexp.Regexp
}

type Schema struct {
    Columns    []ColumnSchema `json:"columns"`
    PrimaryKey []string       `json:"primary_key"`
}

type RejectedRow struct {
    Row    []string
    Reason string
}

func LoadSchema(path string) (*Schema, error) {
    var schema Schema
    if err := loadJSON(path, &schema); err != nil {
        return nil, err
    }
    for i, col := range schema.Columns {
        if col.Pattern != "" {
            re, err := regexp.Compile(col.Pattern)
            if err != nil {
                return nil, fmt.Errorf("ERROR: invalid pattern: %s", col.Pattern)
            }
            schema.Columns[i].pattern = re
        }
    }
    return &schema, nil
}

func headerIndex(header []string, name string) int {
    for i, h := range header {
        if h == name {
            return i
        }
    }
    return -1
}

func validateSchemaHeader(schema *Schema, header []string) error {
    if len(schema.PrimaryKey) == 0 {
        return fmt.Errorf("ERROR: invalid schema: primary_key is required")
    }
    for _, col := range schema.Columns {
        if headerIndex(header, col.Name) == -1 {
            return fmt.Errorf("ERROR: invalid schema: column %s not found in header", col.Name)
        }
    }
    for _, pk := range schema.PrimaryKey {
        if headerIndex(header, pk) == -1 {
            return fmt.Errorf("ERROR: invalid schema: primary key column %s not found in header", pk)
        }
    }
    return nil
}

func parseSchemaValue(col ColumnSchema, value string) (bool, string) {
    switch col.Type {
    case "int":
        if _, err := strconv.ParseInt(value, 10, 64); err != nil {
            return false, "invalid value for column " + col.Name + ": " + value
        }
    case "float":
        if _, err := strconv.ParseFloat(value, 64); err != nil {
            return false, "invalid value for column " + col.Name + ": " + value
        }
    case "datetime":
        if _, err := time.Parse(time.RFC3339, value); err != nil {
            return false, "invalid value for column " + col.Name + ": " + value
        }
    case "string":
        // no additional type check
    default:
        return false, "invalid type for column " + col.Name + ": " + col.Type
    }
    return true, ""
}

func validateRow(schema *Schema, header []string, row []string) (bool, string) {
    get := func(col ColumnSchema) string {
        idx := headerIndex(header, col.Name)
        if idx == -1 || idx >= len(row) {
            return ""
        }
        return row[idx]
    }

    for _, col := range schema.Columns {
        val := get(col)
        if col.Required && val == "" {
            return false, "missing required column: " + col.Name
        }
        if val != "" {
            ok, reason := parseSchemaValue(col, val)
            if !ok {
                return false, reason
            }
        }
    }

    for _, col := range schema.Columns {
        if (col.Min == nil && col.Max == nil) || (col.Type != "int" && col.Type != "float") {
            continue
        }
        val := get(col)
        if val == "" {
            continue
        }
        fv, err := strconv.ParseFloat(val, 64)
        if err != nil {
            continue
        }
        if col.Min != nil && fv < *col.Min {
            return false, "value out of range for column " + col.Name + ": " + val
        }
        if col.Max != nil && fv > *col.Max {
            return false, "value out of range for column " + col.Name + ": " + val
        }
    }

    for _, col := range schema.Columns {
        if col.Pattern == "" || col.Type != "string" {
            continue
        }
        val := get(col)
        if val == "" {
            continue
        }
        if !col.pattern.MatchString(val) {
            return false, "value does not match pattern for column " + col.Name + ": " + val
        }
    }

    return true, ""
}

func ValidateRows(schema *Schema, header []string, rows [][]string) ([][]string, []RejectedRow, error) {
    if err := validateSchemaHeader(schema, header); err != nil {
        return nil, nil, err
    }

    type validRow struct {
        index int
        row   []string
    }
    var valid []validRow
    var rejected []RejectedRow

    for i, row := range rows {
        ok, reason := validateRow(schema, header, row)
        if !ok {
            rejected = append(rejected, RejectedRow{Row: row, Reason: reason})
            continue
        }
        valid = append(valid, validRow{index: i, row: row})
    }

    seen := make(map[string]map[string]bool)
    for _, col := range schema.Columns {
        if col.Unique {
            seen[col.Name] = make(map[string]bool)
        }
    }

    var finalValid [][]string
    for _, vr := range valid {
        row := vr.row
        duplicate := false
        var reason string
        for _, col := range schema.Columns {
            if !col.Unique {
                continue
            }
            idx := headerIndex(header, col.Name)
            val := ""
            if idx >= 0 && idx < len(row) {
                val = row[idx]
            }
            if seen[col.Name][val] {
                duplicate = true
                reason = "duplicate value for unique column: " + col.Name
                break
            }
        }
        if duplicate {
            rejected = append(rejected, RejectedRow{Row: row, Reason: reason})
            continue
        }
        for _, col := range schema.Columns {
            if !col.Unique {
                continue
            }
            idx := headerIndex(header, col.Name)
            val := ""
            if idx >= 0 && idx < len(row) {
                val = row[idx]
            }
            seen[col.Name][val] = true
        }
        finalValid = append(finalValid, row)
    }

    sort.SliceStable(finalValid, func(i, j int) bool {
        return lessByPrimaryKey(schema, header, finalValid[i], finalValid[j])
    })

    return finalValid, rejected, nil
}

func lessByPrimaryKey(schema *Schema, header []string, a, b []string) bool {
    for _, pk := range schema.PrimaryKey {
        idx := headerIndex(header, pk)
        if idx == -1 {
            continue
        }
        av := ""
        bv := ""
        if idx < len(a) {
            av = a[idx]
        }
        if idx < len(b) {
            bv = b[idx]
        }
        var colType string
        for _, col := range schema.Columns {
            if col.Name == pk {
                colType = col.Type
                break
            }
        }
        cmp := compareTyped(av, bv, colType)
        if cmp < 0 {
            return true
        }
        if cmp > 0 {
            return false
        }
    }
    return false
}

func compareTyped(a, b, colType string) int {
