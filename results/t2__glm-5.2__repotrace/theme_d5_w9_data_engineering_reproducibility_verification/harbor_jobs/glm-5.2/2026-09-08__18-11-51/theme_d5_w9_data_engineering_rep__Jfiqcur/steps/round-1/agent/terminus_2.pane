		m["skewness"] = jsonRawNull()
		m["kurtosis"] = jsonRawNull()
		m["histogram"] = []interface{}{}
		return
	}
	sorted := sortedFloat64s(vals)
	mn := sorted[0]
	mx := sorted[len(sorted)-1]
	mean := meanFloat64s(vals)
	stddev := p[?2004h> package main
