[?2004lpackage main

import (
    "bytes"
    "crypto/sha256"
    "encoding/csv"
    "encoding/hex"
    "encoding/json"
    "fmt"
    "os"
    "path/filepath"
)

type fileNotFoundError struct {
    path string
}

func (e *fileNotFoundError) Error() string {
    return "ERROR: file not found: " + e.path
}

func newFileNotFoundError(path string) error {
    return &fileNotFoundError{path: path}
}

func isNotFoundError(err error) bool {
    if err == nil {
        return false
    }
    if _, ok := err.(*fileNotFoundError); ok {
        return true
    }
    return os.IsNotExist(err)
}

type Dataset struct {
    Header []string
    Rows   [][]string
}

func ReadCSV(path string) (*Dataset, error) {
    f, err := os.Open(path)
    if err != nil {
        if os.IsNotExist(err) {
            return nil, newFileNotFoundError(path)
        }
        return nil, err
    }
    defer f.Close()

    r := csv.NewReader(f)
    r.FieldsPerRecord = -1
    records, err := r.ReadAll()
    if err != nil {
        return nil, fmt.Errorf("ERROR: invalid CSV: %s: %v", path, err)
    }
    if len(records) == 0 {
        return &Dataset{Header: nil, Rows: nil}, nil
    }
    return &Dataset{Header: records[0], Rows: records[1:]}, nil
}

func encodeCSV(header []string, rows [][]string) ([]byte, error) {
    var buf bytes.Buffer
    w := csv.NewWriter(&buf)
    if header != nil {
        if err := w.Write(header); err != nil {
            return nil, err
        }
    }
    for _, row := range rows {
        if err := w.Write(row); err != nil {
            return nil, err
        }
    }
    w.Flush()
    return buf.Bytes(), w.Error()
}

func writeBytes(path string, data []byte) error {
    dir := filepath.Dir(path)
    if dir != "" && dir != "." {
        if err := os.MkdirAll(dir, 0755); err != nil {
            return err
        }
    }
    return os.WriteFile(path, data, 0644)
}

func WriteCSV(path string, header []string, rows [][]string) error {
    data, err := encodeCSV(header, rows)
    if err != nil {
        return err
    }
    return writeBytes(path, data)
}

func WriteCSVWithChecksum(path string, header []string, rows [][]string) error {
    data, err := encodeCSV(header, rows)
    if err != nil {
        return err
    }
    if err := writeBytes(path, data); err != nil {
        return err
    }
    sum := sha256.Sum256(data)
    return os.WriteFile(path+".sha256", []byte(hex.EncodeToString(sum[:])+"\n"), 0644)
}

func ComputeFileHash(path string) (string, error) {
    data, err := os.ReadFile(path)
    if err != nil {
        if os.IsNotExist(err) {
            return "", newFileNotFoundError(path)
        }
        return "", err
    }
    sum := sha256.Sum256(data)
    return hex.EncodeToString(sum[:]), nil
}

func loadJSON(path string, v interface{}) error {
    f, err := os.Open(path)
    if err != nil {
        if os.IsNotExist(err) {
            return newFileNotFoundError(path)
        }
        return err
    }
    defer f.Close()
    dec := json.NewDecoder(f)
    if err := dec.Decode(v); err != nil {
        return fmt.Errorf("ERROR: malformed JSON: %s", path)
    }
    return nil
}
