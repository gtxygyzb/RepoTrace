    59	func validateSchemaHeader(schema *Schema, header []string) error {
    60	    if len(schema.PrimaryKey) == 0 {
    61	        return fmt.Errorf("ERROR: invalid schema: primary_key is required")
    62	    }
    63	    for _, col := range schema.Columns {
    64	        if headerIndex(header, col.Name) == -1 {
    65	            return fmt.Errorf("ERROR: invalid schema: column %s not found in header", col.Name)
    66	        }
    67	    }
    68	    for _, pk := range schema.PrimaryKey {
    69	        if headerIndex(header, pk) == -1 {
    70	            return fmt.Errorf("ERROR: invalid schema: primary key column %s not found in header", pk)
    71	        }
    72	    }
    73	    return nil
    74	}
    75	
    76	func parseSchemaValue(col ColumnSchema, value string) (bool, string) {
    77	    switch col.Type {
    78	    case "int":
    79	        if _, err := strconv.ParseInt(value, 10, 64); err != nil {
    80	            return false, "invalid value for column " + col.Name + ": " + value
    81	        }
    82	    case "float":
    83	        if _, err := strconv.ParseFloat(value, 64); err != nil {
    84	            return false, "invalid value for column " + col.Name + ": " + value
    85	        }
    86	    case "datetime":
    87	        if _, err := time.Parse(time.RFC3339, value); err != nil {
    88	            return false, "invalid value for column " + col.Name + ": " + value
    89	        }
    90	    case "string":
    91	        // no additional type check
    92	    default:
    93	        return false, "invalid type for column " + col.Name + ": " + col.Type
    94	    }
    95	    return true, ""
    96	}
    97	
    98	func validateRow(schema *Schema, header []string, row []string) (bool, string) {
    99	    get := func(col ColumnSchema) string {
   100	        idx := headerIndex(header, col.Name)
   101	        if idx == -1 || idx >= len(row) {
   102	            return ""
   103	        }
   104	        return row[idx]
   105	    }
   106	
   107	    for _, col := range schema.Columns {
   108	        val := get(col)
   109	        if col.Required && val == "" {
   110	            return false, "missing required column: " + col.Name
   111	        }
   112	        if val != "" {
   113	            ok, reason := parseSchemaValue(col, val)
   114	            if !ok {
   115	                return false, reason
   116	            }
   117	        }
   118	    }
   119	
   120	    for _, col := range schema.Columns {
   121	        if (col.Min == nil && col.Max == nil) || (col.Type != "int" && col.Type != "float") {
   122	            continue
   123	        }
   124	        val := get(col)
   125	        if val == "" {
   126	            continue
   127	        }
   128	        fv, err := strconv.ParseFloat(val, 64)
   129	        if err != nil {
   130	            continue
   131	        }
   132	        if col.Min != nil && fv < *col.Min {
   133	            return false, "value out of range for column " + col.Name + ": " + val
   134	        }
   135	        if col.Max != nil && fv > *col.Max {
   136	            return false, "value out of range for column " + col.Name + ": " + val
   137	        }
   138	    }
   139	
   140	    for _, col := range schema.Columns {
   141	        if col.Pattern == "" || col.Type != "string" {
   142	            continue
   143	        }
   144	        val := get(col)
   145	        if val == "" {
   146	            continue
   147	        }
   148	        if !col.pattern.MatchString(val) {
   149	            return false, "value does not match pattern for column " + col.Name + ": " + val
   150	        }
   151	    }
   152	
   153	    return true, ""
   154	}
   155	
   156	func ValidateRows(schema *Schema, header []string, rows [][]string) ([][]string, []RejectedRow, error) {
   157	    if err := validateSchemaHeader(schema, header); err != nil {
   158	        return nil, nil, err
   159	    }
   160	
   161	    type validRow struct {
   162	        index int
   163	        row   []string
   164	    }
   165	    var valid []validRow
   166	    var rejected []RejectedRow
   167	
   168	    for i, row := range rows {
   169	        ok, reason := validateRow(schema, header, row)
   170	        if !ok {
   171	            rejected = append(rejected, RejectedRow{Row: row, Reason: reason})
   172	            continue
   173	        }
   174	        valid = append(valid, validRow{index: i, row: row})
   175	    }
   176	
   177	    seen := make(map[string]map[string]bool)
   178	    for _, col := range schema.Columns {
   179	        if col.Unique {
   180	            seen[col.Name] = make(map[string]bool)
   181	        }
   182	    }
   183	
   184	    var finalValid [][]string
   185	    for _, vr := range valid {
   186	        row := vr.row
   187	        duplicate := false
   188	        var reason string
   189	        for _, col := range schema.Columns {
   190	            if !col.Unique {
   191	                continue
   192	            }
   193	            idx := headerIndex(header, col.Name)
   194	            val := ""
   195	            if idx >= 0 && idx < len(row) {
   196	                val = row[idx]
   197	            }
   198	            if seen[col.Name][val] {
   199	                duplicate = true
   200	                reason = "duplicate value for unique column: " + col.Name
   201	                break
   202	            }
   203	        }
   204	        if duplicate {
   205	            rejected = append(rejected, RejectedRow{Row: row, Reason: reason})
   206	            continue
   207	        }
   208	        for _, col := range schema.Columns {
   209	            if !col.Unique {
   210	                continue
   211	            }
   212	            idx := headerIndex(header, col.Name)
   213	            val := ""
   214	            if idx >= 0 && idx < len(row) {
   215	                val = row[idx]
   216	            }
   217	            seen[col.Name][val] = true
   218	        }
   219	        finalValid = append(finalValid, row)
   220	    }
   221	
   222	    sort.SliceStable(finalValid, func(i, j int) bool {
   223	        return lessByPrimaryKey(schema, header, finalValid[i], finalValid[j])
   224	    })
   225	
   226	    return finalValid, rejected, nil
   227	}
   228	
   229	func lessByPrimaryKey(schema *Schema, header []string, a, b []string) bool {
   230	    for _, pk := range schema.PrimaryKey {
   231	        idx := headerIndex(header, pk)
   232	        if idx == -1 {
   233	            continue
   234	        }
   235	        av := ""
   236	        bv := ""
   237	        if idx < len(a) {
   238	            av = a[idx]
   239	        }
   240	        if idx < len(b) {
   241	            bv = b[idx]
   242	        }
   243	        var colType string
   244	        for _, col := range schema.Columns {
   245	            if col.Name == pk {
   246	                colType = col.Type
   247	                break
   248	            }
   249	        }
   250	        cmp := compareTyped(av, bv, colType)
   251	        if cmp < 0 {
   252	            return true
   253	        }
   254	        if cmp > 0 {
   255	            return false
   256	        }
   257	    }
   258	    return false
   259	}
   260	
   261	func compareTyped(a, b, colType string) int {
   262	    switch colType {
   263	    case "int", "float":
   264	        af, aok := strconv.ParseFloat(a, 64)
   265	        bf, bok := strconv.ParseFloat(b, 64)
   266	        if aok == nil && bok == nil {
   267	            if af < bf {
   268	                return -1
   269	            }
   270	            if af > bf {
   271	                return 1
   272	            }
   273	            return 0
   274	        }
   275	    case "datetime":
   276	        at, aok := time.Parse(time.RFC3339, a)
   277	        bt, bok := time.Parse(time.RFC3339, b)
   278	        if aok == nil && bok == nil {
   279	            if at.Before(bt) {
   280	                return -1
   281	            }
   282	            if at.After(bt) {
   283	                return 1
   284	            }
   285	            return 0
   286	        }
   287	    }
   288	    return strings.Compare(a, b)
   289	}
