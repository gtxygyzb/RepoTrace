	return &profileOutput{
		RowCount:     rowCount,
		Columns:      columns,
		Correlations: correlations,
	}
}

func inferProfileType(values []string) string {
	if len(values) == 0 {
		return "string"
	}
	allInt := true
	for _, s := range values {
		if _, err := strconv.ParseInt(s, 10, 64); err != nil {
			allInt = false
			break
		}
	}
	if allInt {
		return "int"
	}
	allFloat := true
	for _, s := range values {
		if _, err := strconv.ParseFloat(s, 64); err != nil {
			allFloat = false
			break
		}
	}
	if allFloat {
		return "float"
	}
	allTime := true
	for _, s := range values {
		if _, err := time.Parse(time.RFC3339, s); err != nil {
			allTime = false
			break
		}
	}
	if allTime {
		return "datetime"
	}
	return "string"
}

func buildColumnProfile(name, colType string, nonEmpty []string, ints []int64, floats []float64, times []time.Time, rowCount int) map[string]interface{} {
	count := len(nonEmpty)
	unique := countUniqueStrings(nonEmpty)
	m := map[string]interface{}{
		"name":       name,
		"type":       colType,
		"count":      count,
		"null_count": rowCount - count,
		"unique":     unique,
	}
	switch colType {
	case "int":
		addNumericProfile(m, colType, floats, count)
		if count == 0 {
			m["mode"] = jsonRawNull()
		} else {
			mode, ok := modeInt(ints)
			if ok {
				m["mode"] = jsonRawInt64(mode)
			} else {
				m["mode"] = jsonRawNull()
			}
		}
	case "float":
		addNumericProfile(m, colType, floats, count)
		if count == 0 {
			m["mode"] = jsonRawNull()
		} else {
			mode, ok := modeFloat(floats)
			if ok {
				m["mode"] = jsonRawFloat64(mode)
			} else {
				m["mode"] = jsonRawNull()
			}
		}
	case "string":
		addStringProfile(m, nonEmpty)
	case "datetime":
		addDatetimeProfile(m, times)
	}
	return m
}

func addNumericProfile(m map[string]interface{}, colType string, vals []float64, count int) {
