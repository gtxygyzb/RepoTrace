func parseExpr(s string) (exprNode, error) {
	tokens, err := tokenizeExpr(s)
	if err != nil {
		return nil, err
	}
	p := &exprParser{tokens: tokens, expr: s}
	node, err := p.parseOr()
	if err != nil {
		return nil, err
	}
	if p.peek().typ != "eof" {
		return nil, fmt.Errorf("unexpected token %q", p.peek().val)
	}
	return node, nil
}

func (p *exprParser) peek() exprToken {
	return p.tokens[p.pos]
}

func (p *exprParser) next() exprToken {
	t := p.tokens[p.pos]
	p.pos++
	return t
}

func (p *exprParser) parseOr() (exprNode, error) {
	left, err := p.parseAnd()
	if err != nil {
		return nil, err
	}
	for p.peek().typ == "op" && p.peek().val == "||" {
		p.next()
		right, err := p.parseAnd()
		if err != nil {
			return nil, err
		}
		left = &binaryNode{op: "||", left: left, right: right}
	}
	return left, nil
}

func (p *exprParser) parseAnd() (exprNode, error) {
	left, err := p.parseEquality()
	if err != nil {
		return nil, err
	}
	for p.peek().typ == "op" && p.peek().val == "&&" {
		p.next()
		right, err := p.parseEquality()
		if err != nil {
			return nil, err
		}
		left = &binaryNode{op: "&&", left: left, right: right}
	}
	return left, nil
}

func (p *exprParser) parseEquality() (exprNode, error) {
	left, err := p.parseRelational()
	if err != nil {
		return nil, err
	}
	for p.peek().typ == "op" && (p.peek().val == "==" || p.peek().val == "!=") {
		op := p.next().val
		right, err := p.parseRelational()
		if err != nil {
			return nil, err
		}
		left = &binaryNode{op: op, left: left, right: right}
	}
	return left, nil
}

func (p *exprParser) parseRelational() (exprNode, error) {
	left, err := p.parseAdditive()
	if err != nil {
		return nil, err
	}
	for p.peek().typ == "op" && (p.peek().val == ">" || p.peek().val == ">=" || p.peek().val == "<" || p.peek().val == "<=") {
		op := p.next().val
		right, err := p.parseAdditive()
		if err != nil {
			return nil, err
		}
		left = &binaryNode{op: op, left: left, right: right}
	}
	return left, nil
}

