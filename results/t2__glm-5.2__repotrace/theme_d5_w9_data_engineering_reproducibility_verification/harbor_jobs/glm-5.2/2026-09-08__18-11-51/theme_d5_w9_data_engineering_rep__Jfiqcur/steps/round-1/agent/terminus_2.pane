   229	func lessByPrimaryKey(schema *Schema, header []string, a, b []string) bool {
   230	    for _, pk := range schema.PrimaryKey {
   231	        idx := headerIndex(header, pk)
   232	        if idx == -1 {
   233	            continue
   234	        }
   235	        av := ""
   236	        bv := ""
   237	        if idx < len(a) {
   238	            av = a[idx]
   239	        }
   240	        if idx < len(b) {
   241	            bv = b[idx]
   242	        }
   243	        var colType string
   244	        for _, col := range schema.Columns {
   245	            if col.Name == pk {
   246	                colType = col.Type
   247	                break
   248	            }
   249	        }
   250	        cmp := compareTyped(av, bv, colType)
   251	        if cmp < 0 {
   252	            return true
   253	        }
   254	        if cmp > 0 {
   255	            return false
   256	        }
   257	    }
   258	    return false
   259	}
   260	
   261	func compareTyped(a, b, colType string) int {
   262	    switch colType {
   263	    case "int", "float":
   264	        af, aok := strconv.ParseFloat(a, 64)
   265	        bf, bok := strconv.ParseFloat(b, 64)
   266	        if aok == nil && bok == nil {
   267	            if af < bf {
   268	                return -1
   269	            }
   270	            if af > bf {
   271	                return 1
   272	            }
   273	            return 0
   274	        }
   275	    case "datetime":
   276	        at, aok := time.Parse(time.RFC3339, a)
   277	        bt, bok := time.Parse(time.RFC3339, b)
   278	        if aok == nil && bok == nil {
   279	            if at.Before(bt) {
   280	                return -1
   281	            }
   282	            if at.After(bt) {
   283	                return 1
   284	            }
   285	            return 0
   286	        }
   287	    }
   288	    return strings.Compare(a, b)
   289	}
