func (p *exprParser) parseOr() (exprNode, error) {
left, err := p.parseAnd()
if err != nil {
return nil, err
}
for p.peek().typ == "op" && p.peek().val == "||" {
p.next()
right, err := p.parseAnd()
if err != nil {
return nil, err
}
left = &binaryNode{op: "||", left: left, right: right}
}
return left, nil
}

func (p *exprParser) parseAnd() (exprNode, error) {
left, err := p.parseEquality()
if err != nil {
return nil, err
}
for p.peek().typ == "op" && p.peek().val == "&&" {
p.next()
right, err := p.parseEquality()
if err != nil {
return nil, err
}
left = &binaryNode{op: "&&", left: left, right: right}
}
return left, nil
}

func (p *exprParser) parseEquality() (exprNode, error) {
left, err := p.parseRelational()
if err != nil {
return nil, err
}
for p.peek().typ == "op" && (p.peek().val == "==" || p.peek().val == "!=") {
op := p.next().val
right, err := p.parseRelational()
if err != nil {
return nil, err
}
left = &binaryNode{op: op, left: left, right: right}
}
return left, nil
}

func (p *exprParser) parseRelational() (exprNode, error) {
left, err := p.parseAdditive()
if err != nil {
return nil, err
}
for p.peek().typ == "op" && (p.peek().val == ">" || p.peek().val == ">=" || p.peek().val == "<" || p.peek().val == "<=") {
op := p.next().val
right, err := p.parseAdditive()
if err != nil {
return nil, err
}
left = &binaryNode{op: op, left: left, right: right}
}
return left, nil
}

func (p *exprParser) parseAdditive() (exprNode, error) {
left, err := p.parseMultiplicative()
if err != nil {
return nil, err
}
for p.peek().typ == "op" && (p.peek().val == "+" || p.peek().val == "-") {
op := p.next().val
right, err := p.parseMultiplicative()
if err != nil {
return nil, err
}
left = &binaryNode{op: op, left: left, right: right}
}
return left, nil
}

func (p *exprParser) parseMultiplicative() (exprNode, error) {
left, err := p.parseUnary()
if err != nil {
return nil, err
}
for p.peek().typ == "op" && (p.peek().val == "*" || p.peek().val == "/" || p.peek().val == "%") {
op := p.next().val
right, err := p.parseUnary()
if err != nil {
return nil, err
}
left = &binaryNode{op: op, left: left, right: right}
}
return left, nil
}

func (p *exprParser) parseUnary() (exprNode, error) {
if p.peek().typ == "op" && p.peek().val == "-" {
p.next()
child, err := p.parseUnary()
