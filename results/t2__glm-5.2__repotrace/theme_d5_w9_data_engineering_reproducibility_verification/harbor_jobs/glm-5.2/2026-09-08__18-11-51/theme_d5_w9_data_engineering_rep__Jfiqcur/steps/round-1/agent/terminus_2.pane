func tokenizeExpr(s string) ([]exprToken, error) {
var tokens []exprToken
i := 0
for i < len(s) {
c := s[i]
if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
i++
continue
}
if c >= '0' && c <= '9' || (c == '.' && i+1 < len(s) && s[i+1] >= '0' && s[i+1] <= '9') {
start := i
for i < len(s) && s[i] >= '0' && s[i] <= '9' {
i++
}
if i < len(s) && s[i] == '.' {
i++
for i < len(s) && s[i] >= '0' && s[i] <= '9' {
i++
}
}
if i < len(s) && (s[i] == 'e' || s[i] == 'E') {
i++
if i < len(s) && (s[i] == '+' || s[i] == '-') {
i++
}
for i < len(s) && s[i] >= '0' && s[i] <= '9' {
i++
}
}
tokens = append(tokens, exprToken{"number", s[start:i]})
continue
}
if c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c == '_' {
start := i
for i < len(s) && (s[i] >= 'A' && s[i] <= 'Z' || s[i] >= 'a' && s[i] <= 'z' || s[i] >= '0' && s[i] <= '9' || s[i] == '_') {
i++
}
tokens = append(tokens, exprToken{"ident", s[start:i]})
continue
}
if i+1 < len(s) {
two := s[i : i+2]
if two == "||" || two == "&&" || two == "==" || two == "!=" || two == ">=" || two == "<=" {
tokens = append(tokens, exprToken{"op", two})
i += 2
continue
}
}
if strings.IndexByte("+-*/%<>()!=", c) >= 0 {
tokens = append(tokens, exprToken{"op", string(c)})
i++
continue
}
if c == ',' {
tokens = append(tokens, exprToken{"comma", ","})
i++
continue
}
return nil, fmt.Errorf("unexpected character %q", c)
}
tokens = append(tokens, exprToken{"eof", ""})
return tokens, nil
}

func parseExpr(s string) (exprNode, error) {
tokens, err := tokenizeExpr(s)
if err != nil {
return nil, err
}
p := &exprParser{tokens: tokens, expr: s}
node, err := p.parseOr()
if err != nil {
return nil, err
}
if p.peek().typ != "eof" {
return nil, fmt.Errorf("unexpected token %q", p.peek().val)
}
return node, nil
}

func (p *exprParser) peek() exprToken {
return p.tokens[p.pos]
}

func (p *exprParser) next() exprToken {
t := p.tokens[p.pos]
p.pos++
return t
}

func (p *exprParser) parseOr() (exprNode, error) {
left, err := p.parseAnd()
if err != nil {
return nil, err
}
for p.peek().typ == "op" && p.peek().val == "||" {
p.next()
right, err := p.parseAnd()
if err != nil {
return nil, err
}
left = &binaryNode{op: "||", left: left, right: right}
}
return left, nil
}

func (p *exprParser) parseAnd() (exprNode, error) {
left, err := p.parseEquality()
if err != nil {
return nil, err
}
for p.peek().typ == "op" && p.peek().val == "&&" {
p.next()
right, err := p.parseEquality()
if err != nil {
return nil, err
}
left = &binaryNode{op: "&&", left: left, right: right}
}
return left, nil
}

func (p *exprParser) parseEquality() (exprNode, error) {
left, err := p.parseRelational()
if err != nil {
return nil, err
}
for p.peek().typ == "op" && (p.peek().val == "==" || p.peek().val == "!=") {
op := p.next().val
right, err := p.parseRelational()
if err != nil {
return nil, err
}
left = &binaryNode{op: op, left: left, right: right}
}
return left, nil
}

func (p *exprParser) parseRelational() (exprNode, error) {
left, err := p.parseAdditive()
if err != nil {
return nil, err
}
for p.peek().typ == "op" && (p.peek().val == ">" || p.peek().val == ">=" || p.peek().val == "<" || p.peek().val == "<=") {
op := p.next().val
right, err := p.parseAdditive()
if err != nil {
return nil, err
}
left = &binaryNode{op: op, left: left, right: right}
}
return left, nil
}

func (p *exprParser) parseAdditive() (exprNode, error) {
left, err := p.parseMultiplicative()
if err != nil {
return nil, err
}
for p.peek().typ == "op" && (p.peek().val == "+" || p.peek().val == "-") {
op := p.next().val
right, err := p.parseMultiplicative()
if err != nil {
return nil, err
}
left = &binaryNode{op: op, left: left, right: right}
}
return left, nil
}

func (p *exprParser) parseMultiplicative() (exprNode, error) {
left, err := p.parseUnary()
if err != nil {
return nil, err
}
for p.peek().typ == "op" && (p.peek().val == "*" || p.peek().val == "/" || p.peek().val == "%") {
op := p.next().val
right, err := p.parseUnary()
if err != nil {
return nil, err
}
left = &binaryNode{op: op, left: left, right: right}
}
return left, nil
}

func (p *exprParser) parseUnary() (exprNode, error) {
if p.peek().typ == "op" && p.peek().val == "-" {
p.next()
child, err := p.parseUnary()
if err != nil {
return nil, err
}
return &unaryNode{op: "-", child: child}, nil
}
return p.parsePrimary()
}

func (p *exprParser) parsePrimary() (exprNode, error) {
t := p.peek()
if t.typ == "number" {
p.next()
f, err := strconv.ParseFloat(t.val, 64)
if err != nil {
return nil, fmt.Errorf("invalid number %q", t.val)
}
return numberNode(f), nil
}
if t.typ == "ident" {
p.next()
if p.peek().typ == "op" && p.peek().val == "(" {
p.next()
var args []exprNode
if p.peek().typ != "op" || p.peek().val != ")" {
for {
arg, err := p.parseOr()
if err != nil {
return nil, err
}
args = append(args, arg)
if p.peek().typ == "comma" {
p.next()
continue
}
break
}
}
if p.peek().typ != "op" || p.peek().val != ")" {
return nil, fmt.Errorf("expected ) in function call")
}
p.next()
return p.validateFunc(t.val, args)
}
return columnNode(t.val), nil
}
if t.typ == "op" && t.val == "(" {
p.next()
node, err := p.parseOr()
if err != nil {
return nil, err
}
if p.peek().typ != "op" || p.peek().val != ")" {
return nil, fmt.Errorf("expected )")
}
p.next()
return node, nil
}
return nil, fmt.Errorf("unexpected token %q", t.val)
}

func (p *exprParser) validateFunc(name string, args []exprNode) (exprNode, error) {
switch name {
case "abs", "sqrt", "ceil", "floor", "log":
if len(args) != 1 {
return nil, fmt.Errorf("%s expects 1 argument", name)
}
case "round", "pow", "min", "max", "coalesce":
if len(args) != 2 {
return nil, fmt.Errorf("%s expects 2 arguments", name)
}
case "if", "clamp":
if len(args) != 3 {
return nil, fmt.Errorf("%s expects 3 arguments", name)
}
default:
return nil, fmt.Errorf("unknown function %s", name)
}
return &funcNode{name: name, args: args}, nil
}

