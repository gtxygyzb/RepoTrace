range aggs {\n        total = append(total, aggregateValue(ds.Rows, ds.Header, a))\n    }\n    rows = append(rows, total)\n    return &Dataset{Header: header, Rows: rows}, nil\n}\n\nfunc transformDetect(ds *Dataset, step map[string]interface{}) (*Dataset, error) {\n    col := recipeString(step, "column")\n    if col == "" {\n        return nil, fmt.Errorf("ERROR: invalid recipe: detect requires column")\n    }\n    idx := indexOf(ds.Header, col)\n    if idx < 0 {\n        return nil, fmt.Errorf("ERROR: invalid recipe: column %s not found", col)\n    }\n    method := recipeString(step, "method")\n    as := recipeString(step, "as")\n    if as == "" {\n        return nil, fmt.Errorf("ERROR: invalid recipe: detect requires as")\n    }\n    factor := recipeFloat(step, "factor", 1.5)\n    nums := []float64{}\n    for _, row := range ds.Rows {\n        s := cellAt(row, idx)\n        if s != "" {\n            if f, err := strconv.ParseFloat(s, 64); err == nil {\n                nums = append(nums, f)\n            }\n        }\n    }\n    sortedNums := sortedFloat64s(nums)\n    header := append([]string(nil), ds.Header...)\n    header = append(header, as)\n    rows := make([][]string, len(ds.Rows))\n    for i, row := range ds.Rows {\n        out := append([]string(nil), row...)\n        for len(out) < len(header) {\n            out = append(out, "")\n        }\n        s := cellAt(row, idx)\n        if s == "" {\n            out[len(header)-1] = "0"\n            rows[i] = out\n            continue\n        }\n        f, err := strconv.ParseFloat(s, 64)\n        if err != nil {\n            out[len(header)-1] = "0"\n            rows[i] = out\n            continue\n        }\n        out[len(header)-1] = detectOutlier(method, f, sortedNums, factor)\n        rows[i] = out\n    }\n    return &Dataset{Header: header, Rows: rows}, nil\n}\n\nfunc detectOutlier(method string, v float64, sorted []float64, factor float64) string {\n    switch method {\n    case "iqr":\n        if len(sorted) < 2 {\n            return "0"\n        }\n        q1 := percentileSorted(sorted, 25)\n        q3 := percentileSorted(sorted, 75)\n        iqr := q3 - q1\n        if v < q1-factor*iqr || v > q3+factor*iqr {\n            return "1"\n        }\n        return "0"\n    case "zscore":\n        if len(sorted) == 0 {\n            return "0"\n        }\n        mean := meanFloat64s(sorted)\n        sd := populationStddevFloat64s(sorted, mean)\n        if sd == 0 {\n            return "0"\n        }\n        if math.Abs(v-mean)/sd > factor {\n            return "1"\n        }\n        return "0"\n    case "mad":\n        if len(sorted) == 0 {\n            return "0"\n        }\n        med := percentileSorted(sorted, 50)\n        devs := make([]float64, len(sorted))\n        for i, x := range sorted {\n            devs[i] = math.Abs(x - med)\n        }\n        mad := percentileSorted(sortedFloat64s(devs), 50)\n        if mad == 0 {\n            if v == med {\n                return "0"\n            }\n            return "1"\n        }\n        mz := 0.6745 * (v - med) / mad\n        if math.Abs(mz) > factor {\n            return "1"\n        }\n        return "0"\n    default:\n        return "0"\n    }\n}\n\nfunc transformBin(ds *Dataset, step map[string]interface{}) (*Dataset, error) {\n    col := recipeString(step, "column")\n    if col == "" {\n        return nil, fmt.Errorf("ERROR: invalid recipe: bin requires column")\n    }\n    idx := indexOf(ds.Header, col)\n    if idx < 0 {\n        return nil, fmt.Errorf("ERROR: invalid recipe: column %s not found", col)\n    }\n    method := recipeString(step, "method")\n    bins := recipeInt(step, "bins", 0)\n    if bins <= 0 {\n        return nil, fmt.Errorf("ERROR: invalid recipe: bins must be positive")\n    }\n    as := recipeString(step, "as")\n    if as == "" {\n        return nil, fmt.Errorf("ERROR: invalid recipe: bin requires as")\n    }\n    nums := []float64{}\n    for _, row := range ds.Rows {\n        s := cellAt(row, idx)\n        if s != "" {\n            if f, err := strconv.ParseFloat(s, 64); err == nil {\n                nums = append(nums, f)\n            }\n        }\n    }\n    sortedNums := sortedFloat64s(nums)\n    header := append([]string(nil), ds.Header...)\n    header = append(header, as)\n    rows := make([][]string, len(ds.Rows))\n    for i, row := range ds.Rows {\n        out := append([]string(nil), row...)\n        for len(out) < len(header) {\n            out = append(out, "")\n        }\n        s := cellAt(row, idx)\n        if s == "" {\n            out[len(header)-1] = ""\n            rows[i] = out\n            continue\n        }\n        f, err := strconv.ParseFloat(s, 64)\n        if err != nil {\n            out[len(header)-1] = ""\n            rows[i] = out\n            continue\n        }\n        out[len(header)-1] = binLabel(method, f, sortedNums, bins)\n        rows[i] = out\n    }\n    return &Dataset{Header: header, Rows: rows}, nil\n}\n\nfunc binLabel(method string, v float64, sorted []float64, bins int) string {\n    if len(sorted) == 0 {\n        return ""\n    }\n    mn := sorted[0]\n    mx := sorted[len(sorted)-1]\n    if mx == mn {\n        return "[" + strconv.FormatFloat(mn, \'f\', -1, 64) + "," + strconv.FormatFloat(mx, \'f\', -1, 64) + "]"\n    }\n    switch method {\n    case "width":\n        w := (mx - mn) / float64(bins)\n        i := int(math.Floor((v - mn) / w))\n        if i < 0 {\n            i = 0\n        }\n        if i > bins-1 {\n            i = bins - 1\n        }\n        low := mn + float64(i)*w\n        high := mn + float64(i+1)*w\n        if i == bins-1 {\n            high = mx\n        }\n        return formatBinLabel(low, high, i == bins-1)\n    case "quantile":\n        bounds := make([]float64, bins+1)\n        for j := 0; j <= bins; j++ {\n            bounds[j] = percentileSorted(sorted, float64(j*100)/float64(bins))\n        }\n        i := 0\n        for j := 0; j < bins; j++ {\n            if v >= bounds[j] {\n                i = j\n            }\n        }\n        if v < bounds[0] {\n            i = 0\n        }\n        if v >= bounds[bins] {\n            i = bins - 1\n        }\n        low := bounds[i]\n        high := bounds[i+1]\n        if i == bins-1 {\n            high = mx\n        }\n        return formatBinLabel(low, high, i == bins-1)\n    default:\n        return ""\n    }\n}\n\nfunc formatBinLabel(low, high float64, last bool) string {\n    ls := strconv.FormatFloat(low, \'f\', -1, 64)\n    hs := strconv.FormatFloat(high, \'f\', -1, 64)\n    if last {\n        return "[" + ls + "," + hs + "]"\n    }\n    return "[" + ls + "," + hs + ")"\n}\n\nfunc transformHash(ds *Dataset, step map[string]interface{}) (*Dataset, error) {\n    cols := recipeStringList(step, "columns")\n    if len(cols) == 0 {\n        cols = ds.Header\n    }\n    if err := validateColumns(ds, cols); err != nil {\n        return nil, err\n    }\n    as := recipeString(step, "as")\n    if as == "" {\n        return nil, fmt.Errorf("ERROR: invalid recipe: hash requires as")\n    }\n    idxs := make([]int, len(cols))\n    for i, c := range cols {\n        idxs[i] = indexOf(ds.Header, c)\n    }\n    header := append([]string(nil), ds.Header...)\n    header = append(header, as)\n    rows := make([][]string, len(ds.Rows))\n    for i, row := range ds.Rows {\n        out := append([]string(nil), row...)\n        for len(out) < len(header) {\n            out = append(out, "")\n        }\n        var sb strings.Builder\n        for j, idx := range idxs {\n            if j > 0 {\n                sb.WriteByte(0)\n            }\n            sb.WriteString(cellAt(row, idx))\n        }\n        sum := sha256.Sum256([]byte(sb.String()))\n        out[len(header)-1] = hex.EncodeToString(sum[:])\n        rows[i] = out\n    }\n    return &Dataset{Header: header, Rows: rows}, nil\n}\n\nfunc groupKey(header, cols []string, row []string) string {\n    idxs := make([]int, len(cols))\n    for i, c := r