(col ColumnSchema, value string) (bool, string) {\n    switch col.Type {\n    case "int":\n        if _, err := strconv.ParseInt(value, 10, 64); err != nil {\n            return false, "invalid value for column " + col.Name + ": " + value\n        }\n    case "float":\n        if _, err := strconv.ParseFloat(value, 64); err != nil {\n            return false, "invalid value for column " + col.Name + ": " + value\n        }\n    case "datetime":\n        if _, err := time.Parse(time.RFC3339, value); err != nil {\n            return false, "invalid value for column " + col.Name + ": " + value\n        }\n    case "string":\n        // no additional type check\n    default:\n        return false, "invalid type for column " + col.Name + ": " + col.Type\n    }\n    return true, ""\n}\n\nfunc validateRow(schema *Schema, header []string, row []string) (bool, string) {\n    get := func(col ColumnSchema) string {\n        idx := headerIndex(header, col.Name)\n        if idx == -1 || idx >= len(row) {\n            return ""\n        }\n        return row[idx]\n    }\n\n    for _, col := range schema.Columns {\n        val := get(col)\n        if col.Required && val == "" {\n            return false, "missing required column: " + col.Name\n        }\n        if val != "" {\n            ok, reason := parseSchemaValue(col, val)\n            if !ok {\n                return false, reason\n            }\n        }\n    }\n\n    for _, col := range schema.Columns {\n        if (col.Min == nil && col.Max == nil) || (col.Type != "int" && col.Type != "float") {\n            continue\n        }\n        val := get(col)\n        if val == "" {\n            continue\n        }\n        fv, err := strconv.ParseFloat(val, 64)\n        if err != nil {\n            continue\n        }\n        if col.Min != nil && fv < *col.Min {\n            return false, "value out of range for column " + col.Name + ": " + val\n        }\n        if col.Max != nil && fv > *col.Max {\n            return false, "value out of range for column " + col.Name + ": " + val\n        }\n    }\n\n    for _, col := range schema.Columns {\n        if col.Pattern == "" || col.Type != "string" {\n            continue\n        }\n        val := get(col)\n        if val == "" {\n            continue\n        }\n        if !col.pattern.MatchString(val) {\n            return false, "value does not match pattern for column " + col.Name + ": " + val\n        }\n    }\n\n    return true, ""\n}\n\nfunc ValidateRows(schema *Schema, header []string, rows [][]string) ([][]string, []RejectedRow, error) {\n    if err := validateSchemaHeader(schema, header); err != nil {\n        return nil, nil, err\n    }\n\n    type validRow struct {\n        index int\n        row   []string\n    }\n    var valid []validRow\n    var rejected []RejectedRow\n\n    for i, row := range rows {\n        ok, reason := validateRow(schema, header, row)\n        if !ok {\n            rejected = append(rejected, RejectedRow{Row: row, Reason: reason})\n            continue\n        }\n        valid = append(valid, validRow{index: i, row: row})\n    }\n\n    seen := make(map[string]map[string]bool)\n    for _, col := range schema.Columns {\n        if col.Unique {\n            seen[col.Name] = make(map[string]bool)\n        }\n    }\n\n    var finalValid [][]string\n    for _, vr := range valid {\n        row := vr.row\n        duplicate := false\n        var reason string\n        for _, col := range schema.Columns {\n            if !col.Unique {\n                continue\n            }\n            idx := headerIndex(header, col.Name)\n            val := ""\n            if idx >= 0 && idx < len(row) {\n                val = row[idx]\n            }\n            if seen[col.Name][val] {\n                duplicate = true\n                reason = "duplicate value for unique column: " + col.Name\n                break\n            }\n        }\n        if duplicate {\n            rejected = append(rejected, RejectedRow{Row