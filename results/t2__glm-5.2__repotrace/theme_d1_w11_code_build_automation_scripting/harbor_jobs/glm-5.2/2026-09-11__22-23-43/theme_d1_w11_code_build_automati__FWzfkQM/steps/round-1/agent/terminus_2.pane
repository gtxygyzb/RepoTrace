   135	# Run tests for a single package
   136	test_package() {
   137	    local pkg_name="$1"
   138	    local profile="${2:-release}"
   139	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
   140	        log_error "Invalid profile: $profile"
   141	        return 1
   142	    fi
   143	    local pkg_dir
   144	    pkg_dir=$(get_package_dir "$pkg_name")
   145	
   146	    parse_manifest "$pkg_name"
   147	    local test_cmd="${MANIFEST_test_command:-make test}"
   148	    case "$test_cmd" in
   149	        *make*) test_cmd="$test_cmd BUILD_DIR=build/${profile}" ;;
   150	    esac
   151	
   152	    if ! setup_build_env "$pkg_name" "$profile"; then
   153	        log_error "[$pkg_name] Failed to set up build environment"
   154	        return 1
   155	    fi
   156	
   157	    log_info "[$pkg_name] Running tests..."
   158	    if ! (cd "$pkg_dir" && BUILD_DIR="build/${profile}" eval "$test_cmd" 2>&1); then
   159	        log_error "[$pkg_name] Tests failed"
   160	        return 1
   161	    fi
   162	
   163	    log_info "[$pkg_name] Tests passed"
   164	    return 0
   165	}
