     1	#!/bin/bash
     2	# Build report generator for ForgeKit
     3	
     4	generate_report() {
     5	    echo "========================================="
     6	    echo "  ForgeKit Build Report"
     7	    echo "========================================="
     8	    echo "  Date: $(date '+%Y-%m-%d %H:%M:%S')"
     9	    echo "========================================="
    10	    echo ""
    11	
    12	    local width=${#PACKAGE}
    13	    local pkg_name
    14	    for pkg_name in $(list_package_names); do
    15	        if (( ${#pkg_name} > width )); then
    16	            width=${#pkg_name}
    17	        fi
    18	    done
    19	
    20	    printf "%-${width}s  %-10s  %-10s  %-8s  %s\n" \
    21	        "PACKAGE" "VERSION" "TYPE" "STATUS" "CACHED"
    22	    printf "%-${width}s  %-10s  %-10s  %-8s  %s\n" \
    23	        "-------" "-------" "----" "------" "------"
    24	
    25	    for pkg_name in $(list_package_names); do
    26	        parse_manifest "$pkg_name"
    27	        local version="${MANIFEST_version:-?}"
    28	        local type="${MANIFEST_type:-?}"
    29	        local pkg_dir
    30	        pkg_dir=$(get_package_dir "$pkg_name")
    31	
    32	        local status="pending"
    33	        if [[ -d "$pkg_dir/build/release" ]] || [[ -d "$pkg_dir/build/debug" ]]; then
    34	            status="built"
    35	        fi
    36	
    37	        local cached="no"
    38	        if is_cache_valid "$pkg_name" release 2>/dev/null || is_cache_valid "$pkg_name" debug 2>/dev/null; then
    39	            cached="yes"
    40	        fi
    41	
    42	        printf "%-${width}s  %-10s  %-10s  %-8s  %s\n" \
    43	            "$pkg_name" "$version" "$type" "$status" "$cached"
    44	    done
    45	
    46	    echo ""
    47	    echo "Total packages: $(list_package_names | wc -w)"
    48	}
