[?2004l     1	#!/bin/bash
     2	# Build cache management for ForgeKit
     3	#
     4	# Uses timestamp-based caching: each package records a "last built"
     5	# timestamp; a rebuild is triggered when source files are newer or
     6	# when a transitive dependency has been rebuilt more recently.
     7	#
     8	# Cache stamps are profile-namespaced so debug and release builds do
     9	# not interfere with each other.
    10	
    11	FORGE_CACHE_DIR="${FORGE_ROOT}/.forge_cache"
    12	
    13	init_cache() {
    14	    mkdir -p "$FORGE_CACHE_DIR"
    15	}
    16	
    17	_forge_cache_profile() {
    18	    local profile="${1:-release}"
    19	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
    20	        profile="release"
    21	    fi
    22	    echo "$profile"
    23	}
    24	
    25	# Newest mtime among all files under a package's src/ directory
    26	get_src_mtime() {
    27	    local pkg_name="$1"
    28	    local pkg_dir
    29	    pkg_dir=$(get_package_dir "$pkg_name")
    30	
    31	    local latest=0
    32	    local mtime
    33	    while IFS= read -r -d '' file; do
    34	        mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)
    35	        if (( mtime > latest )); then
    36	            latest=$mtime
    37	        fi
    38	    done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)
    39	
    40	    # Also check Makefile
    41	    if [[ -f "$pkg_dir/Makefile" ]]; then
    42	        mtime=$(stat -c %Y "$pkg_dir/Makefile" 2>/dev/null || echo 0)
    43	        if (( mtime > latest )); then
    44	            latest=$mtime
    45	        fi
    46	    fi
    47	
    48	    echo "$latest"
    49	}
    50	
    51	# Check whether the cached build is still valid.
    52	#
    53	# A package is invalid if:
    54	#   - it has no cache stamp
    55	#   - its own sources/Makefile are newer than its cache stamp
    56	#   - any transitive dependency has no cache stamp
    57	#   - any transitive dependency has a cache stamp newer than this package's
    58	is_cache_valid() {
    59	    local pkg_name="$1"
    60	    local profile
    61	    profile=$(_forge_cache_profile "${2:-release}")
    62	    init_cache
    63	    local cache_file="$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"
    64	
    65	    if [[ ! -f "$cache_file" ]]; then
    66	        return 1  # No cache -> rebuild
    67	    fi
    68	
    69	    local cached_time
    70	    cached_time=$(cat "$cache_file" 2>/dev/null || echo 0)
    71	    if [[ ! "$cached_time" =~ ^[0-9]+$ ]]; then
    72	        return 1
    73	    fi
    74	
    75	    local src_mtime
    76	    src_mtime=$(get_src_mtime "$pkg_name")
    77	
    78	    if (( src_mtime > cached_time )); then
    79	        return 1  # Source newer than cache -> rebuild
    80	    fi
    81	
    82	    # Invalidate when transitive dependencies were rebuilt more recently.
    83	    local deps
    84	    deps=$(get_all_deps "$pkg_name") || return 1
    85	    local dep dep_cache_file dep_time
    86	    for dep in $deps; do
    87	        [[ -z "$dep" ]] && continue
    88	        dep_cache_file="$FORGE_CACHE_DIR/${dep}-${profile}.stamp"
    89	        if [[ ! -f "$dep_cache_file" ]]; then
    90	            return 1
    91	        fi
    92	        dep_time=$(cat "$dep_cache_file" 2>/dev/null || echo 0)
    93	        if [[ ! "$dep_time" =~ ^[0-9]+$ ]]; then
    94	            return 1
    95	        fi
    96	        if (( dep_time > cached_time )); then
    97	            return 1
    98	        fi
    99	    done
   100	
   101	    return 0  # Cache is valid
   102	}
   103	
   104	# Record the current time as the build timestamp for a package
   105	update_cache() {
   106	    local pkg_name="$1"
   107	    local profile
   108	    profile=$(_forge_cache_profile "${2:-release}")
   109	    init_cache
   110	    date +%s > "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"
   111	}
   112	
   113	# Remove cache entry for a package
   114	invalidate_cache() {
   115	    local pkg_name="$1"
   116	    local profile
   117	    profile=$(_forge_cache_profile "${2:-release}")
   118	    rm -f "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"
   119	}
   120	
   121	# Wipe cache entries.  With a profile argument, only that profile is
   122	# removed.  Without an argument, all cache entries are removed.
   123	clean_cache() {
   124	    local profile
   125	    profile=$(_forge_cache_profile "${1:-}")
   126	    init_cache
   127	    if [[ -n "$1" ]]; then
   128	        rm -f "$FORGE_CACHE_DIR"/*-${profile}.stamp
   129	    else
   130	        rm -rf "$FORGE_CACHE_DIR"
   131	    fi
   132	}
