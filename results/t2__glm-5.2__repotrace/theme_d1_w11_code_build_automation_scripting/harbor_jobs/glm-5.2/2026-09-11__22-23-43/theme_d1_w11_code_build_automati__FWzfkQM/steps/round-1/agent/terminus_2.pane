   141	    for pkg in $order; do
   142	        build_package "$pkg" "$profile" || return 1
   143	    done
   144	}
   145	
   146	test_package_chain() {
   147	    local target="$1" profile="${2:-release}"
   148	    local order pkg
   149	    order=$(resolve_deps_for "$target") || return 1
   150	    for pkg in $order; do
   151	        test_package "$pkg" "$profile" || return 1
   152	    done
   153	}
   154	
   155	# Build a single target and its dependency chain with optional parallelism.
   156	build_packages_for_target() {
   157	    local target="$1" jobs="${2:-1}" profile="${3:-release}"
   158	    local order
   159	    order=$(resolve_deps_for "$target") || return 1
   160	    _run_parallel_build "$order" "$jobs" "$profile"
   161	}
   162	
   163	# Build all packages with optional parallelism.
   164	build_all_packages() {
   165	    local jobs="${1:-1}" profile="${2:-release}"
   166	    local order
   167	    order=$(resolve_build_order) || return 1
   168	    _run_parallel_build "$order" "$jobs" "$profile"
   169	}
   170	
   171	# Internal: schedule packages in dependency order with up to N workers.
   172	# Each package's output is buffered and printed under a header when it
   173	# finishes.  Existing concurrent builds continue on failure, but no new
   174	# packages are started after a failure.
   175	_run_parallel_build() {
   176	    local order="$1" jobs="${2:-1}" profile="${3:-release}"
   177	    jobs=$(( jobs < 1 ? 1 : jobs ))
   178	
   179	    declare -A remaining_deps state failed_pkg
   180	    declare -A active_pids
   181	    local pkg dep deps_str dep_count
   182	
   183	    for pkg in $order; do
   184	        deps_str="${DEP_MAP[$pkg]:-}"
   185	        dep_count=0
   186	        if [[ -n "$deps_str" ]]; then
   187	            local IFS=','
   188	            for dep in $deps_str; do
   189	                dep="${dep// /}"
   190	                [[ -z "$dep" ]] && continue
   191	                dep_count=$(( dep_count + 1 ))
   192	            done
   193	        fi
   194	        remaining_deps[$pkg]=$dep_count
   195	        state[$pkg]=pending
   196	    done
   197	
   198	    local total=0
   199	    for pkg in $order; do total=$(( total + 1 )); done
   200	    local finished=0 active=0 failed=0
   201	
   202	    local tmpdir
   203	    tmpdir=$(mktemp -d)
   204	
   205	    while (( finished < total )); do
   206	        # Launch ready packages up to the concurrency limit.
   207	        # After a failure, do not start any new packages; allow
   208	        # already-running jobs to complete.
   209	        if (( ! failed )); then
   210	            for pkg in $order; do
   211	                if (( active >= jobs )); then
   212	                    break
   213	                fi
   214	                if [[ "${state[$pkg]}" == "pending" ]] && (( remaining_deps[$pkg] == 0 )); then
   215	                    state[$pkg]=running
   216	                    active=$(( active + 1 ))
   217	                    (
   218	                        {
   219	                            build_package "$pkg" "$profile"
   220	                            echo "__FORGE_BUILD_RC__$?"
   221	                        } > "$tmpdir/$pkg.out" 2>&1
   222	                    ) &
   223	                    active_pids[$!]="$pkg"
   224	                fi
   225	            done
   226	        fi
   227	
   228	        if (( active == 0 )); then
   229	            # Nothing is running and nothing can be started; remaining
   230	            # packages are blocked by failed dependencies.
   231	            break
   232	        fi
   233	
   234	        # Wait for at least one background job to finish, then reap all
   235	        # completed jobs.  This avoids reading buffered output files
   236	        # before their subshell has finished writing.
   237	        wait -n 2>/dev/null || true
   238	
   239	        local completed=0
