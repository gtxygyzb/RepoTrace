    26	_forge_graph_dfs() {
    27	    local node="$1"
    28	
    29	    if [[ -z "${DEP_MAP[$node]+_}" ]]; then
    30	        log_error "Unknown package in dependency graph: $node"
    31	        return 1
    32	    fi
    33	
    34	    case "${_state[$node]:-}" in
    35	        done)
    36	            return 0
    37	            ;;
    38	        visiting)
    39	            local cycle="" in_cycle=0 p
    40	            for p in "${_path[@]}"; do
    41	                if [[ "$p" == "$node" ]]; then
    42	                    in_cycle=1
    43	                fi
    44	                if (( in_cycle )); then
    45	                    cycle="$cycle $p"
    46	                fi
    47	            done
    48	            cycle="$cycle $node"
    49	            cycle="${cycle# }"
    50	            log_error "Circular dependency detected: $(echo "$cycle" | sed 's/ / -> /g')"
    51	            return 1
    52	            ;;
