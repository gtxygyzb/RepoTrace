[?2004l     1	#!/bin/bash
     2	# ForgeKit - Legacy Build Automation System
     3	# Main CLI entry point
     4	
     5	FORGE_ROOT="$(cd "$(dirname "$0")" && pwd)"
     6	export FORGE_ROOT
     7	
     8	# Source library modules
     9	source "$FORGE_ROOT/lib/common.sh"
    10	source "$FORGE_ROOT/lib/manifest.sh"
    11	source "$FORGE_ROOT/lib/depgraph.sh"
    12	source "$FORGE_ROOT/lib/builder.sh"
    13	source "$FORGE_ROOT/lib/cache.sh"
    14	source "$FORGE_ROOT/lib/artifact.sh"
    15	source "$FORGE_ROOT/lib/reporter.sh"
    16	source "$FORGE_ROOT/lib/configgen.sh"
    17	
    18	# Load global config
    19	if [[ -f "$FORGE_ROOT/config/forge.conf" ]]; then
    20	    source "$FORGE_ROOT/config/forge.conf"
    21	fi
    22	
    23	usage() {
    24	    cat <<'EOF'
    25	Usage: forge <command> [options]
    26	
    27	Commands:
    28	  build [--all|--package NAME] [-j N] [--profile debug|release]
    29	  test  [--all|--package NAME] [--profile debug|release]
    30	  list
    31	  deps  NAME
    32	  report
    33	  config generate ENV
    34	  artifact pack NAME [--profile debug|release]
    35	  clean [--all|--package NAME] [--profile debug|release]
    36	  graph [--reverse NAME]
    37	EOF
    38	}
    39	
    40	validate_profile() {
    41	    local profile="${1:-release}"
    42	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
    43	        log_error "Invalid profile: $profile (expected debug or release)"
    44	        return 1
    45	    fi
    46	    return 0
    47	}
    48	
    49	cmd_build() {
    50	    local target="" pkg="" jobs=1 profile="release"
    51	    while [[ $# -gt 0 ]]; do
    52	        case "$1" in
    53	            --all) target="all" ;;
    54	            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;
    55	            -j) if [[ $# -lt 2 ]]; then usage; return 1; fi; jobs="$2"; shift ;;
    56	            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
    57	            *) usage; return 1 ;;
    58	        esac
    59	        shift
    60	    done
    61	
    62	    validate_profile "$profile" || return 1
    63	    if [[ ! "$jobs" =~ ^[0-9]+$ ]] || (( jobs < 1 )); then
    64	        log_error "Invalid job count: $jobs (expected N >= 1)"
    65	        return 1
    66	    fi
    67	
    68	    if [[ "$target" == "package" ]]; then
    69	        build_packages_for_target "$pkg" "$jobs" "$profile"
    70	    elif [[ "$target" == "all" ]]; then
    71	        build_all_packages "$jobs" "$profile"
    72	    else
    73	        usage
    74	        return 1
    75	    fi
    76	}
    77	
    78	cmd_test() {
    79	    local target="" pkg="" profile="release"
    80	    while [[ $# -gt 0 ]]; do
    81	        case "$1" in
    82	            --all) target="all" ;;
    83	            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;
    84	            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
    85	            *) usage; return 1 ;;
    86	        esac
    87	        shift
    88	    done
    89	
    90	    validate_profile "$profile" || return 1
    91	    if [[ ! "$jobs" =~ ^[0-9]+$ ]] || (( jobs < 1 )); then
    92	        log_error "Invalid job count: $jobs (expected N >= 1)"
    93	        return 1
    94	    fi
    95	
    96	    if [[ "$target" == "package" ]]; then
    97	        test_package_chain "$pkg" "$profile"
    98	    elif [[ "$target" == "all" ]]; then
    99	        local order pkg_name
   100	        order=$(resolve_build_order) || return 1
   101	        build_all_packages 1 "$profile" || return 1
   102	        for pkg_name in $order; do
   103	            test_package "$pkg_name" "$profile" || return 1
   104	        done
   105	    else
   106	        usage
   107	        return 1
   108	    fi
   109	}
   110	
   111	cmd_list() {
   112	    list_packages
   113	}
   114	
   115	cmd_deps() {
   116	    if [[ $# -lt 1 ]]; then usage; return 1; fi
   117	    show_dep_tree "$1"
   118	}
   119	
   120	cmd_report() {
   121	    generate_report
   122	}
   123	
   124	cmd_config() {
   125	    if [[ $# -lt 2 || "$1" != "generate" ]]; then usage; return 1; fi
   126	    generate_config "$2"
   127	}
   128	
   129	cmd_artifact() {
   130	    if [[ $# -lt 2 || "$1" != "pack" ]]; then usage; return 1; fi
   131	    local pkg="$2" profile="release"
   132	    shift 2
   133	    while [[ $# -gt 0 ]]; do
   134	        case "$1" in
   135	            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
   136	            *) usage; return 1 ;;
   137	        esac
   138	        shift
   139	    done
   140	    validate_profile "$profile" || return 1
   141	    pack_artifact "$pkg" "$profile"
   142	}
   143	
   144	cmd_clean() {
   145	    local target="" pkg="" profile="release"
   146	    while [[ $# -gt 0 ]]; do
   147	        case "$1" in
   148	            --all) target="all" ;;
   149	            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;
   150	            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
   151	            *) usage; return 1 ;;
   152	        esac
   153	        shift
   154	    done
   155	
   156	    validate_profile "$profile" || return 1
   157	
   158	    if [[ "$target" == "all" ]]; then
   159	        for pkg_name in $(list_package_names); do
   160	            clean_package "$pkg_name" "$profile"
   161	        done
   162	        clean_cache "$profile"
   163	        log_info "All packages cleaned ($profile)"
   164	    elif [[ "$target" == "package" ]]; then
   165	        clean_package "$pkg" "$profile"
   166	        invalidate_cache "$pkg" "$profile"
   167	    else
   168	        usage
   169	        return 1
   170	    fi
   171	}
   172	
   173	cmd_graph() {
   174	    local reverse=""
   175	    while [[ $# -gt 0 ]]; do
   176	        case "$1" in
   177	            --reverse) if [[ $# -lt 2 ]]; then log_error "--reverse requires a package name"; return 1; fi; reverse="$2"; shift ;;
   178	            *) usage; return 1 ;;
   179	        esac
   180	        shift
   181	    done
   182	
   183	    if [[ -n "$reverse" ]]; then
   184	        print_reverse_graph "$reverse"
   185	    else
   186	        print_graph
   187	    fi
   188	}
   189	
   190	# Main dispatch
   191	if [[ $# -lt 1 ]]; then
   192	    usage
   193	    exit 1
   194	fi
   195	
   196	command="$1"
   197	shift
   198	
   199	case "$command" in
   200	    build)    cmd_build "$@" ;;
   201	    test)     cmd_test "$@" ;;
   202	    list)     cmd_list ;;
   203	    deps)     cmd_deps "$@" ;;
   204	    report)   cmd_report ;;
   205	    config)   cmd_config "$@" ;;
   206	    artifact) cmd_artifact "$@" ;;
   207	    clean)    cmd_clean "$@" ;;
   208	    graph)    cmd_graph "$@" ;;
   209	    *)        usage; exit 1 ;;
   210	esac
