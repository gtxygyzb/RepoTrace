[?2004l# Newest mtime among all files under a package's src/ directory
get_src_mtime() {
    local pkg_name="$1"
    local pkg_dir
    pkg_dir=$(get_package_dir "$pkg_name")

    local latest=0
    local mtime
    while IFS= read -r -d '' file; do
        mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)
        if (( mtime > latest )); then
            latest=$mtime
        fi
    done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)

    # Also check Makefile
    if [[ -f "$pkg_dir/Makefile" ]]; then
        mtime=$(stat -c %Y "$pkg_dir/Makefile" 2>/dev/null || echo 0)
        if (( mtime > latest )); then
            latest=$mtime
        fi
    fi

    # Manifest changes (version, deps, build command, etc.) must invalidate cache.
    if [[ -f "$pkg_dir/package.forge" ]]; then
        mtime=$(stat -c %Y "$pkg_dir/package.forge" 2>/dev/null || echo 0)
        if (( mtime > latest )); then
            latest=$mtime
        fi
    fi

update_cache() {
    local pkg_name="$1"
    local profile
    profile=$(_forge_cache_profile "${2:-release}")
    init_cache
    date +%s > "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"
}

# Remove cache entry for a package.  When a profile is supplied, only that
# profile's stamp is removed.  Without a profile, all profile stamps for the
# package are invalidated.
invalidate_cache() {
    local pkg_name="$1"
    local profile
    if [[ -n "${2:-}" ]]; then
        profile=$(_forge_cache_profile "$2")
        rm -f "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"
    else
        rm -f "$FORGE_CACHE_DIR/${pkg_name}-"*.stamp
    fi
}

# Wipe cache entries.  With a profile argument, only that profile is
# Clean build artifacts for a package.  When a profile is supplied, only
# build/<profile>/ is removed and other profiles are left intact.  When no
# profile is supplied, the entire build/ directory is removed, matching the
# existing clean behavior.  Object files associated with the selected scope
# are also removed.
clean_package() {
    local name="$1"
    local profile="${2:-}"
    if [[ -n "$profile" && "$profile" != "debug" && "$profile" != "release" ]]; then
        log_error "Invalid profile: $profile"
        return 1
    fi
    local pkg_dir
    pkg_dir=$(get_package_dir "$name")

    if [[ -z "$profile" ]]; then
        if [[ -d "$pkg_dir/build" ]]; then
            rm -rf "$pkg_dir/build"
            log_info "Cleaned $name (all profiles)"
        fi
        find "$pkg_dir/src" -name "*.o" -delete 2>/dev/null || true
        return 0
    fi

    if [[ -d "$pkg_dir/build/$profile" ]]; then
        rm -rf "$pkg_dir/build/$profile"
        log_info "Cleaned $name ($profile)"
    fi
    if [[ -d "$pkg_dir/build" ]] && [[ -z "$(find "$pkg_dir/build" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
        rmdir "$pkg_dir/build" 2>/dev/null || true
    fi

    # Remove object files for the selected profile.  Makefile builds store
    # objects under build/<profile>; this also handles legacy src-based *.o
    # layouts that encode the profile in the filename or path.
    find "$pkg_dir/src" -name "*.${profile}.o" -delete 2>/dev/null || true
    find "$pkg_dir/src" -path "*/$profile/*" -name "*.o" -delete 2>/dev/null || true
}
cmd_clean() {
    local target="" pkg="" profile=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) target="all" ;;
            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;
            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
            *) usage; return 1 ;;
        esac
        shift
    done

    if [[ -n "$profile" ]]; then
        validate_profile "$profile" || return 1
    fi

    if [[ "$target" == "all" ]]; then
        for pkg_name in $(list_package_names); do
            clean_package "$pkg_name" "$profile"
        done
        clean_cache "$profile"
        if [[ -n "$profile" ]]; then
            log_info "All packages cleaned ($profile)"
        else
            log_info "All packages cleaned (all profiles)"
        fi
    elif [[ "$target" == "package" ]]; then
        clean_package "$pkg" "$profile"
        invalidate_cache "$pkg" "$profile"
    else
        usage
        return 1
    fi
}

