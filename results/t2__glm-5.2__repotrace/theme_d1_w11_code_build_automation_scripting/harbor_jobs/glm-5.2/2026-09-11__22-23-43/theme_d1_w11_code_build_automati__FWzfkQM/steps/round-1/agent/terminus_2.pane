   185	# Build a single target and its dependency chain with optional parallelism.
   186	build_packages_for_target() {
   187	    local target="$1" jobs="${2:-1}" profile="${3:-release}"
   188	    local order
   189	    order=$(resolve_deps_for "$target") || return 1
   190	    _run_parallel_build "$order" "$jobs" "$profile"
   191	}
   192	
   193	# Build all packages with optional parallelism.
   194	build_all_packages() {
   195	    local jobs="${1:-1}" profile="${2:-release}"
   196	    local order
   197	    order=$(resolve_build_order) || return 1
   198	    _run_parallel_build "$order" "$jobs" "$profile"
   199	}
   200	
   201	# Internal: schedule packages in dependency order with up to N workers.
   202	# Each package's output is buffered and printed under a header when it
   203	# finishes.  Existing concurrent builds continue on failure, but no new
   204	# packages are started after a failure.
   205	_run_parallel_build() {
   206	    local order="$1" jobs="${2:-1}" profile="${3:-release}"
   207	    jobs=$(( jobs < 1 ? 1 : jobs ))
   208	
   209	    declare -A remaining_deps state failed_pkg
   210	    declare -A active_pids
   211	    local pkg dep deps_str dep_count dep_array
   212	
   213	    for pkg in $order; do
   214	        deps_str="${DEP_MAP[$pkg]:-}"
   215	        dep_count=0
   216	        if [[ -n "$deps_str" ]]; then
   217	            IFS=',' read -ra dep_array <<< "$deps_str"
   218	            for dep in "${dep_array[@]}"; do
   219	                dep="${dep// /}"
   220	                [[ -z "$dep" ]] && continue
   221	                dep_count=$(( dep_count + 1 ))
   222	            done
   223	        fi
   224	        remaining_deps[$pkg]=$dep_count
   225	        state[$pkg]=pending
   226	    done
   227	
   228	    local total=0
   229	    for pkg in $order; do total=$(( total + 1 )); done
   230	    local finished=0 active=0 failed=0
   231	
   232	    local tmpdir
   233	    tmpdir=$(mktemp -d)
   234	
   235	    while (( finished < total )); do
   236	        # Launch ready packages up to the concurrency limit.
   237	        # After a failure, do not start any new packages; allow
   238	        # already-running jobs to complete.
   239	        if (( ! failed )); then
   240	            for pkg in $order; do
   241	                if (( active >= jobs )); then
   242	                    break
   243	                fi
   244	                if [[ "${state[$pkg]}" == "pending" ]] && (( remaining_deps[$pkg] == 0 )); then
   245	                    state[$pkg]=running
   246	                    active=$(( active + 1 ))
   247	                    (
   248	                        {
   249	                            build_package "$pkg" "$profile"
   250	                            echo "__FORGE_BUILD_RC__$?"
   251	                        } > "$tmpdir/$pkg.out" 2>&1
   252	                    ) &
   253	                    active_pids[$!]="$pkg"
   254	                fi
   255	            done
   256	        fi
   257	
   258	        if (( active == 0 )); then
   259	            break
   260	        fi
   261	
   262	        wait -n 2>/dev/null || true
   263	
   264	        local completed=0
   265	        for pid in "${!active_pids[@]}"; do
   266	            if ! kill -0 "$pid" 2>/dev/null; then
   267	                wait "$pid" 2>/dev/null || true
   268	                pkg="${active_pids[$pid]}"
   269	                unset "active_pids[$pid]"
   270	                active=$(( active - 1 ))
   271	                finished=$(( finished + 1 ))
   272	                completed=$(( completed + 1 ))
   273	
   274	                local rc
   275	                rc=$(grep -m1 '__FORGE_BUILD_RC__' "$tmpdir/$pkg.out" | sed 's/.*__FORGE_BUILD_RC__//')
   276	                rc="${rc:-1}"
   277	
   278	                echo "=== [$pkg] ==="
   279	                grep -v '__FORGE_BUILD_RC__' "$tmpdir/$pkg.out"
   280	
   281	                if (( rc == 0 )); then
   282	                    state[$pkg]=done
   283	
   284	                    local dependent dep_deps dep_dep dep_arr
   285	                    for dependent in $order; do
   286	                        if [[ "${state[$dependent]}" == "pending" ]]; then
   287	                            dep_deps="${DEP_MAP[$dependent]:-}"
   288	                            if [[ -n "$dep_deps" ]]; then
   289	                                IFS=',' read -ra dep_arr <<< "$dep_deps"
   290	                                for dep_dep in "${dep_arr[@]}"; do
   291	                                    dep_dep="${dep_dep// /}"
   292	                                    [[ -z "$dep_dep" ]] && continue
   293	                                    if [[ "$dep_dep" == "$pkg" ]]; then
   294	                                        remaining_deps[$dependent]=$(( remaining_deps[$dependent] - 1 ))
   295	                                    fi
   296	                                done
   297	                            fi
   298	                        fi
   299	                    done
   300	                else
   301	                    state[$pkg]=failed
   302	                    failed_pkg[$pkg]=1
   303	                    failed=1
   304	                fi
   305	            fi
   306	        done
   307	
   308	        if (( completed == 0 )); then
   309	            sleep 0.05
   310	        fi
   311	    done
   312	
   313	    rm -rf "$tmpdir"
   314	
   315	    local failures=""
   316	    for pkg in $order; do
   317	        if [[ -n "${failed_pkg[$pkg]:-}" ]]; then
   318	            failures="$failures $pkg"
   319	        fi
   320	    done
   321	
   322	    if [[ -n "$failures" ]]; then
   323	        failures="${failures# }"
   324	        log_error "Build failed for: $failures"
   325	        return 1
   326	    fi
   327	
   328	    return 0
   329	}
