#!/bin/bash
# ForgeKit Internal Test Suite
#
# Tests for the forge build automation system itself.
# Run with: bash tests/run_tests.sh

FORGE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export FORGE_ROOT

source "$FORGE_ROOT/lib/common.sh"
source "$FORGE_ROOT/lib/manifest.sh"
source "$FORGE_ROOT/lib/depgraph.sh"
source "$FORGE_ROOT/lib/builder.sh"
source "$FORGE_ROOT/lib/cache.sh"
source "$FORGE_ROOT/lib/artifact.sh"
source "$FORGE_ROOT/lib/reporter.sh"
source "$FORGE_ROOT/lib/configgen.sh"

TOTAL=0
PASSED=0
FAILED=0

assert_eq() {
    local desc="$1" expected="$2" actual="$3"
    ((TOTAL++))
    if [[ "$expected" == "$actual" ]]; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc"
        echo "    expected: '$expected'"
        echo "    actual:   '$actual'"
        ((FAILED++))
    fi
}

assert_contains() {
    local desc="$1" haystack="$2" needle="$3"
    ((TOTAL++))
    if [[ "$haystack" == *"$needle"* ]]; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc"
        echo "    expected to contain: '$needle'"
        echo "    in: '$haystack'"
        ((FAILED++))
    fi
}

assert_not_contains() {
    local desc="$1" haystack="$2" needle="$3"
    ((TOTAL++))
    if [[ "$haystack" != *"$needle"* ]]; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc"
        echo "    expected NOT to contain: '$needle'"
        echo "    in: '$haystack'"
        ((FAILED++))
    fi
}

assert_exit_zero() {
    local desc="$1"
    shift
    ((TOTAL++))
    if "$@" > /dev/null 2>&1; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc (exit code: $?)"
        ((FAILED++))
    fi
}

assert_exit_nonzero() {
    local desc="$1"
    shift
    ((TOTAL++))
    if "$@" > /dev/null 2>&1; then
        echo "  FAIL: $desc (expected failure but got success)"
        ((FAILED++))
    else
        echo "  PASS: $desc"
        ((PASSED++))
    fi
}

# ==================================================================
echo ""
echo "=== Manifest Parser Tests ==="

parse_manifest "libbase"
assert_eq "libbase name" "libbase" "${MANIFEST_name:-}"
assert_eq "libbase version" "1.0.0" "${MANIFEST_version:-}"
assert_eq "libbase type" "library" "${MANIFEST_type:-}"
assert_eq "libbase has no deps" "" "${MANIFEST_deps:-}"

parse_manifest "libcrypto"
assert_eq "libcrypto deps" "libbase" "${MANIFEST_deps:-}"

parse_manifest "svc-auth"
assert_eq "svc-auth type" "service" "${MANIFEST_type:-}"
assert_eq "svc-auth deps" "libcrypto,libstore" "${MANIFEST_deps:-}"

# TODO: Test manifest with multi-line continuation values (backslash)
# TODO: Test error handling for missing manifest file
# TODO: Test manifest with inline comments after values

# ==================================================================
echo ""
echo "=== Dependency Graph Tests ==="

order=$(resolve_build_order)
pkg_count=$(echo "$order" | wc -w)
assert_eq "build order has 8 packages" "8" "$pkg_count"

# libbase must come before everything that depends on it
assert_contains "order contains libbase" "$order" "libbase"
assert_contains "order contains svc-scheduler" "$order" "svc-scheduler"

# Verify libbase precedes libcrypto in the output
libbase_pos=0; libcrypto_pos=0; i=0
for pkg in $order; do
    ((i++))
    [[ "$pkg" == "libbase" ]] && libbase_pos=$i
    [[ "$pkg" == "libcrypto" ]] && libcrypto_pos=$i
done
assert_eq "libbase before libcrypto" "1" "$(( libbase_pos < libcrypto_pos ? 1 : 0 ))"

# resolve_deps_for
deps_for_auth=$(resolve_deps_for "svc-auth")
assert_contains "svc-auth deps include libcrypto" "$deps_for_auth" "libcrypto"
assert_contains "svc-auth deps include itself" "$deps_for_auth" "svc-auth"

# TODO: Test circular dependency detection
# TODO: Test resolve_deps_for with package that has no dependencies
# TODO: Test handling of unknown/missing dependency names in manifest

# ==================================================================
echo ""
echo "=== Cache Tests ==="

clean_cache
assert_exit_nonzero "cache invalid for unbuilt pkg" is_cache_valid "libbase"

update_cache "libbase"
assert_exit_zero "cache valid after update" is_cache_valid "libbase"

# TODO: Test transitive cache invalidation (dep rebuilt -> consumer invalidated)
# TODO: Test cache invalidation after source file modification
# TODO: Test clean_cache removes all stamps

# ==================================================================
echo ""
echo "=== Reporter Tests ==="

report_out=$(generate_report)
assert_contains "report has header" "$report_out" "ForgeKit Build Report"
assert_contains "report lists libbase" "$report_out" "libbase"

# TODO: Test that long package names are displayed without truncation
# TODO: Test report shows correct build status

# ==================================================================
echo ""
echo "=== Config Generator Tests ==="

# Simple substitution
generate_config "staging" > /dev/null 2>&1
if [[ -f "$FORGE_ROOT/generated/deploy.yaml" ]]; then
    deploy_out=$(cat "$FORGE_ROOT/generated/deploy.yaml")
    assert_contains "deploy config has env" "$deploy_out" "staging"
    assert_contains "deploy config has host" "$deploy_out" "staging.internal"
else
    echo "  FAIL: deploy.yaml not generated"
    ((TOTAL++)); ((FAILED++))
fi

# TODO: Test nested variable substitution (e.g. ${REGION_${ENV}})
# TODO: Test generation for production environment
# TODO: Test with missing environment config file

# ==================================================================
echo ""
echo "=== Artifact Tests ==="

# Need to build first
(cd "$FORGE_ROOT/packages/libbase" && make clean > /dev/null 2>&1 && make > /dev/null 2>&1)
result=$(pack_artifact "libbase" 2>/dev/null)
assert_contains "artifact path returned" "$result" "libbase-1.0.0.tar.gz"

# TODO: Test artifact includes dependency metadata (deps.manifest)
# TODO: Test artifact for package with no build output
# TODO: Test artifact versioning matches manifest

# Clean up
rm -rf "$FORGE_ROOT/artifacts" "$FORGE_ROOT/generated"
rm -rf "$FORGE_ROOT/packages/libbase/build"
clean_cache

# ==================================================================
echo ""
echo "=== Summary ==="
echo "Total: $TOTAL | Passed: $PASSED | Failed: $FAILED"
if [[ $FAILED -gt 0 ]]; then
    exit 1
fi
exit 0
[?2004hroot@n30009:/app# nl -ba lib/manifest.sh | sed -n '1,220p'
[?2004l     1	#!/bin/bash
     2	# Manifest parser for .forge package files
     3	#
     4	# Format:
     5	#   [section]
     6	#   key = value
     7	#   # comments
     8	#   key = long value \
     9	#         continued on next line
    10	#
    11	# All parsed values are exported as MANIFEST_<key>=<value>
    12	
    13	parse_manifest() {
    14	    local pkg_name="$1"
    15	    local manifest_file
    16	    manifest_file=$(get_package_manifest "$pkg_name")
    17	
    18	    if [[ ! -f "$manifest_file" ]]; then
    19	        log_error "Manifest not found: $manifest_file"
    20	        return 1
    21	    fi
    22	
    23	    # Clear previous manifest data
    24	    local var
    25	    for var in $(compgen -v MANIFEST_); do
    26	        unset "$var"
    27	    done
    28	
    29	    local current_section=""
    30	    local line key value
    31	
    32	    while IFS= read -r line || [[ -n "$line" ]]; do
    33	        # Skip empty lines and comments
    34	        [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    35	        [[ "$line" =~ ^[[:space:]]*# ]] && continue
    36	
    37	        # Section header
    38	        if [[ "$line" =~ ^\[([a-zA-Z_][a-zA-Z0-9_]*)\] ]]; then
    39	            current_section="${BASH_REMATCH[1]}"
    40	            continue
    41	        fi
    42	
    43	        # Key = value pair
    44	        if [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then
    45	            key="${BASH_REMATCH[1]}"
    46	            value="${BASH_REMATCH[2]}"
    47	
    48	            # Trim trailing whitespace from value
    49	            value="${value%"${value##*[![:space:]]}"}"
    50	
    51	            # BUG: Does not handle backslash line continuation.
    52	            # If the value ends with '\', the next line(s) should be
    53	            # appended (minus the backslash). Currently, the trailing
    54	            # backslash is kept and continuation lines are ignored.
    55	
    56	            export "MANIFEST_${key}=${value}"
    57	        fi
    58	    done < "$manifest_file"
    59	}
    60	
    61	# Convenience: parse and return a single value
    62	get_manifest_value() {
    63	    local pkg_name="$1"
    64	    local key="$2"
    65	    parse_manifest "$pkg_name"
    66	    local var="MANIFEST_${key}"
    67	    echo "${!var:-}"
    68	}
