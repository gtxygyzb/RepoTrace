[?2004l     1	#!/bin/bash
     2	# Artifact packaging for ForgeKit
     3	
     4	pack_artifact() {
     5	    local pkg_name="$1"
     6	    local pkg_dir
     7	    pkg_dir=$(get_package_dir "$pkg_name")
     8	
     9	    parse_manifest "$pkg_name"
    10	    local version="${MANIFEST_version:-0.0.0}"
    11	
    12	    local build_dir="$pkg_dir/build"
    13	    if [[ ! -d "$build_dir" ]]; then
    14	        log_error "Build directory not found for $pkg_name. Run 'forge build' first."
    15	        return 1
    16	    fi
    17	
    18	    local artifact_dir="$FORGE_ROOT/artifacts"
    19	    mkdir -p "$artifact_dir"
    20	
    21	    local artifact_name="${pkg_name}-${version}.tar.gz"
    22	
    23	    # Generate dependency metadata inside the packaged build directory.
    24	    # Direct dependencies only, as <dep_name>=<dep_version> per line.
    25	    local deps_manifest="$build_dir/deps.manifest"
    26	    : > "$deps_manifest"
    27	
    28	    local deps="${MANIFEST_deps:-}"
    29	    if [[ -n "$deps" ]]; then
    30	        local IFS=','
    31	        local dep dep_version
    32	        for dep in $deps; do
    33	            dep="${dep// /}"
    34	            [[ -z "$dep" ]] && continue
    35	            dep_version=$(get_manifest_value "$dep" "version") || return 1
    36	            printf '%s=%s\n' "$dep" "$dep_version" >> "$deps_manifest"
    37	        done
    38	    fi
    39	
    40	    tar -czf "$artifact_dir/$artifact_name" \
    41	        -C "$pkg_dir" \
    42	        build/ 2>/dev/null
    43	
    44	    if [[ $? -ne 0 ]]; then
    45	        log_error "Failed to create artifact for $pkg_name"
    46	        return 1
    47	    fi
    48	
    49	    log_info "Packed artifact: $artifact_name -> $artifact_dir/$artifact_name"
    50	    echo "$artifact_dir/$artifact_name"
    51	}
