assert_contains "svc-auth deps include transitive libbase" "$deps_for_auth" "libbase"
assert_contains "svc-auth deps include itself" "$deps_for_auth" "svc-auth"
assert_eq "svc-auth chain has 4 packages" "4" "$(echo "$deps_for_auth" | wc -w)"

assert_eq "libbase no-dependency chain" "libbase" "$(resolve_deps_for libbase)"

all_deps=$(get_all_deps svc-scheduler)
assert_contains "all deps includes libbase" "$all_deps" "libbase"
assert_contains "all deps includes libcrypto" "$all_deps" "libcrypto"
assert_contains "all deps includes libnet" "$all_deps" "libnet"
assert_contains "all deps includes libstore" "$all_deps" "libstore"
assert_not_contains "all deps excludes package itself" "$all_deps" "svc-scheduler"

