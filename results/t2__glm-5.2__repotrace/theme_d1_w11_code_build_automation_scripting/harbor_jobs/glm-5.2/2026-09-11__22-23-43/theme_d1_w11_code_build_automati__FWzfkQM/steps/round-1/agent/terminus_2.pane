[?2004l     1	#!/bin/bash
     2	# Build executor for ForgeKit
     3	#
     4	# Builds packages by running their Makefile in the correct environment.
     5	
     6	# Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.
     7	# Includes include and library paths for the full transitive dependency
     8	# closure, not just direct dependencies.
     9	setup_build_env() {
    10	    local pkg_name="$1"
    11	    parse_manifest "$pkg_name"
    12	
    13	    local cflags=""
    14	    local ldflags=""
    15	    local libs=""
    16	    local deps
    17	
    18	    deps=$(get_all_deps "$pkg_name") || return 1
    19	
    20	    declare -A seen
    21	    local dep dep_dir
    22	    for dep in $deps; do
    23	        [[ -z "$dep" ]] && continue
    24	        [[ -n "${seen[$dep]:-}" ]] && continue
    25	        seen[$dep]=1
    26	
    27	        dep_dir=$(get_package_dir "$dep")
    28	        cflags="$cflags -I${dep_dir}/src"
    29	        ldflags="$ldflags -L${dep_dir}/build"
    30	
    31	        # For services linking against libraries
    32	        parse_manifest "$dep"
    33	        if [[ "${MANIFEST_type:-}" == "library" ]]; then
    34	            libs="$libs ${dep_dir}/build/${dep}.a"
    35	        fi
    36	    done
    37	
    38	    export FORGE_CFLAGS="$cflags"
    39	    export FORGE_LDFLAGS="$ldflags"
    40	    export FORGE_LIBS="$libs"
    41	}
    42	
    43	# Build a single package
    44	build_package() {
    45	    local pkg_name="$1"
    46	    local pkg_dir
    47	    pkg_dir=$(get_package_dir "$pkg_name")
    48	
    49	    if [[ ! -d "$pkg_dir" ]]; then
    50	        log_error "Package directory not found: $pkg_dir"
    51	        return 1
    52	    fi
    53	
    54	    # Check cache
    55	    if is_cache_valid "$pkg_name" 2>/dev/null; then
    56	        log_info "[$pkg_name] Up to date (cached)"
    57	        return 0
    58	    fi
    59	
    60	    log_info "[$pkg_name] Building..."
    61	
    62	    # Parse manifest for build command
    63	    parse_manifest "$pkg_name"
    64	    local build_cmd="${MANIFEST_command:-make}"
    65	
    66	    # Set up build environment
    67	    if ! setup_build_env "$pkg_name"; then
    68	        log_error "[$pkg_name] Failed to set up build environment"
    69	        return 1
    70	    fi
    71	
    72	    # Execute build
    73	    if ! (cd "$pkg_dir" && eval "$build_cmd" 2>&1); then
    74	        log_error "[$pkg_name] Build failed"
    75	        return 1
    76	    fi
    77	
    78	    # Update cache
    79	    update_cache "$pkg_name"
    80	
    81	    log_info "[$pkg_name] Build successful"
    82	    return 0
    83	}
    84	
    85	# Run tests for a single package
    86	test_package() {
    87	    local pkg_name="$1"
    88	    local pkg_dir
    89	    pkg_dir=$(get_package_dir "$pkg_name")
    90	
    91	    parse_manifest "$pkg_name"
    92	    local test_cmd="${MANIFEST_test_command:-make test}"
    93	
    94	    if ! setup_build_env "$pkg_name"; then
    95	        log_error "[$pkg_name] Failed to set up build environment"
    96	        return 1
    97	    fi
    98	
    99	    log_info "[$pkg_name] Running tests..."
   100	    if ! (cd "$pkg_dir" && eval "$test_cmd" 2>&1); then
   101	        log_error "[$pkg_name] Tests failed"
   102	        return 1
   103	    fi
   104	
   105	    log_info "[$pkg_name] Tests passed"
   106	    return 0
   107	}
