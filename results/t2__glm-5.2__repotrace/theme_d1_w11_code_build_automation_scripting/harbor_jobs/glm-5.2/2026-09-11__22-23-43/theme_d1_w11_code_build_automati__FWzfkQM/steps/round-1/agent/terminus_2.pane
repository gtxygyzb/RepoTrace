name = libbase
version = 1.0.0
type = library

[deps]

[build]
command = make
test_command = make test
output = build/libbase.a

[meta]
description = Core utility functions used across the monorepo
tags = core,utils,foundation
[package]
name = libcrypto
version = 1.2.0
type = library

[deps]
deps = libbase

[build]
command = make
test_command = make test
output = build/libcrypto.a

[meta]
description = Cryptographic primitives for signing and verification
tags = crypto,security,hashing
[package]
name = libnet
version = 1.1.0
type = library

[deps]
deps = libbase

[build]
command = make
test_command = make test
output = build/libnet.a

[meta]
description = Network protocol helpers and socket utilities
tags = network,protocol,io
[package]
name = libstore
version = 1.3.0
type = library

[deps]
deps = libbase,libcrypto

[build]
command = make
test_command = make test
output = build/libstore.a

[meta]
description = Persistent key-value store \
    with integrity verification \
    and crash recovery support
tags = storage,persistence,\
    kv,transactions
[package]
name = svc-auth
version = 2.0.1
type = service

[deps]
deps = libcrypto,libstore

[build]
command = make
test_command = make test
output = build/svc-auth

[meta]
description = Authentication and authorization service
tags = auth,security,service
[package]
name = svc-gateway
version = 2.1.0
type = service

[deps]
deps = libnet,libcrypto

[build]
command = make
test_command = make test
output = build/svc-gateway

[meta]
description = API gateway and request router
tags = gateway,routing,service
[package]
name = svc-worker
version = 1.5.0
type = service

[deps]
deps = libstore,libnet

[build]
command = make
test_command = make test
output = build/svc-worker

[meta]
description = Background task worker service
tags = worker,jobs,service
[package]
name = svc-scheduler
version = 1.0.0
type = service

[deps]
deps = libstore,libnet,libcrypto

[build]
command = make
test_command = make test
output = build/svc-scheduler

[meta]
description = Distributed task scheduling and orchestration service
tags = scheduler,orchestration,service
