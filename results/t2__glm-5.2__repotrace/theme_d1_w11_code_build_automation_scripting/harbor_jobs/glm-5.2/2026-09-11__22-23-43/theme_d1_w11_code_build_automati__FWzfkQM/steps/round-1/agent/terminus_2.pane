[?2004l     1	#!/bin/bash
     2	# ForgeKit Internal Test Suite
     3	#
     4	# Tests for the forge build automation system itself.
     5	# Run with: bash tests/run_tests.sh
     6	
     7	FORGE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
     8	export FORGE_ROOT
     9	
    10	source "$FORGE_ROOT/lib/common.sh"
    11	source "$FORGE_ROOT/lib/manifest.sh"
    12	source "$FORGE_ROOT/lib/depgraph.sh"
    13	source "$FORGE_ROOT/lib/builder.sh"
    14	source "$FORGE_ROOT/lib/cache.sh"
    15	source "$FORGE_ROOT/lib/artifact.sh"
    16	source "$FORGE_ROOT/lib/reporter.sh"
    17	source "$FORGE_ROOT/lib/configgen.sh"
    18	
    19	TOTAL=0
    20	PASSED=0
    21	FAILED=0
    22	
    23	assert_eq() {
    24	    local desc="$1" expected="$2" actual="$3"
    25	    ((TOTAL++))
    26	    if [[ "$expected" == "$actual" ]]; then
    27	        echo "  PASS: $desc"
    28	        ((PASSED++))
    29	    else
    30	        echo "  FAIL: $desc"
    31	        echo "    expected: '$expected'"
    32	        echo "    actual:   '$actual'"
    33	        ((FAILED++))
    34	    fi
    35	}
    36	
    37	assert_contains() {
    38	    local desc="$1" haystack="$2" needle="$3"
    39	    ((TOTAL++))
    40	    if [[ "$haystack" == *"$needle"* ]]; then
    41	        echo "  PASS: $desc"
    42	        ((PASSED++))
    43	    else
    44	        echo "  FAIL: $desc"
    45	        echo "    expected to contain: '$needle'"
    46	        echo "    in: '$haystack'"
    47	        ((FAILED++))
    48	    fi
    49	}
    50	
    51	assert_not_contains() {
    52	    local desc="$1" haystack="$2" needle="$3"
    53	    ((TOTAL++))
    54	    if [[ "$haystack" != *"$needle"* ]]; then
    55	        echo "  PASS: $desc"
    56	        ((PASSED++))
    57	    else
    58	        echo "  FAIL: $desc"
    59	        echo "    expected NOT to contain: '$needle'"
    60	        echo "    in: '$haystack'"
    61	        ((FAILED++))
    62	    fi
    63	}
    64	
    65	assert_exit_zero() {
    66	    local desc="$1"
    67	    shift
    68	    ((TOTAL++))
    69	    if "$@" > /dev/null 2>&1; then
    70	        echo "  PASS: $desc"
    71	        ((PASSED++))
    72	    else
    73	        echo "  FAIL: $desc (exit code: $?)"
    74	        ((FAILED++))
    75	    fi
    76	}
    77	
    78	assert_exit_nonzero() {
    79	    local desc="$1"
    80	    shift
    81	    ((TOTAL++))
    82	    if "$@" > /dev/null 2>&1; then
    83	        echo "  FAIL: $desc (expected failure but got success)"
    84	        ((FAILED++))
    85	    else
    86	        echo "  PASS: $desc"
    87	        ((PASSED++))
    88	    fi
    89	}
    90	
    91	# ==================================================================
    92	echo ""
    93	echo "=== Manifest Parser Tests ==="
    94	
    95	parse_manifest "libbase"
    96	assert_eq "libbase name" "libbase" "${MANIFEST_name:-}"
    97	assert_eq "libbase version" "1.0.0" "${MANIFEST_version:-}"
    98	assert_eq "libbase type" "library" "${MANIFEST_type:-}"
    99	assert_eq "libbase has no deps" "" "${MANIFEST_deps:-}"
   100	
   101	parse_manifest "libcrypto"
   102	assert_eq "libcrypto deps" "libbase" "${MANIFEST_deps:-}"
   103	
   104	parse_manifest "svc-auth"
   105	assert_eq "svc-auth type" "service" "${MANIFEST_type:-}"
   106	assert_eq "svc-auth deps" "libcrypto,libstore" "${MANIFEST_deps:-}"
   107	
   108	# TODO: Test manifest with multi-line continuation values (backslash)
   109	# TODO: Test error handling for missing manifest file
   110	# TODO: Test manifest with inline comments after values
   111	
   112	# ==================================================================
   113	echo ""
   114	echo "=== Dependency Graph Tests ==="
   115	
   116	order=$(resolve_build_order)
   117	pkg_count=$(echo "$order" | wc -w)
   118	assert_eq "build order has 8 packages" "8" "$pkg_count"
   119	
   120	# libbase must come before everything that depends on it
   121	assert_contains "order contains libbase" "$order" "libbase"
   122	assert_contains "order contains svc-scheduler" "$order" "svc-scheduler"
   123	
   124	# Verify libbase precedes libcrypto in the output
   125	libbase_pos=0; libcrypto_pos=0; i=0
   126	for pkg in $order; do
   127	    ((i++))
   128	    [[ "$pkg" == "libbase" ]] && libbase_pos=$i
   129	    [[ "$pkg" == "libcrypto" ]] && libcrypto_pos=$i
   130	done
   131	assert_eq "libbase before libcrypto" "1" "$(( libbase_pos < libcrypto_pos ? 1 : 0 ))"
   132	
   133	# resolve_deps_for
   134	deps_for_auth=$(resolve_deps_for "svc-auth")
   135	assert_contains "svc-auth deps include libcrypto" "$deps_for_auth" "libcrypto"
   136	assert_contains "svc-auth deps include itself" "$deps_for_auth" "svc-auth"
   137	
   138	# TODO: Test circular dependency detection
   139	# TODO: Test resolve_deps_for with package that has no dependencies
   140	# TODO: Test handling of unknown/missing dependency names in manifest
   141	
   142	# ==================================================================
   143	echo ""
   144	echo "=== Cache Tests ==="
   145	
   146	clean_cache
   147	assert_exit_nonzero "cache invalid for unbuilt pkg" is_cache_valid "libbase"
   148	
   149	update_cache "libbase"
   150	assert_exit_zero "cache valid after update" is_cache_valid "libbase"
   151	
   152	# TODO: Test transitive cache invalidation (dep rebuilt -> consumer invalidated)
   153	# TODO: Test cache invalidation after source file modification
   154	# TODO: Test clean_cache removes all stamps
   155	
   156	# ==================================================================
   157	echo ""
   158	echo "=== Reporter Tests ==="
