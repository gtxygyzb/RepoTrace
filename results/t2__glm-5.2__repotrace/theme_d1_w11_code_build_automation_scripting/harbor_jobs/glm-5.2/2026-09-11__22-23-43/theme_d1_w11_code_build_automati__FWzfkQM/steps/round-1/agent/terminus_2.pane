result=$(pack_artifact libbase 2>/dev/null)
assert_contains "libbase artifact path returned" "$result" "libbase-1.0.0-release.tar.gz"
assert_contains "artifact version matches manifest" "$result" "libbase-${libbase_version}-release.tar.gz"

tmp_extract=$(mktemp -d)
tar -xzf "$result" -C "$tmp_extract"
assert_exit_zero "libbase deps.manifest exists" test -f "$tmp_extract/build/release/deps.manifest"
assert_eq "libbase deps.manifest empty" "" "$(cat "$tmp_extract/build/release/deps.manifest")"
rm -rf "$tmp_extract"

libcrypto_version=$(get_manifest_value libcrypto version)
result=$(pack_artifact libcrypto 2>/dev/null)
