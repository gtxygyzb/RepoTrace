[?2004l[?2004hroot@n30009:/app# cat > lib/artifact.sh <<'EOF'
[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Artifact packaging for ForgeKit
[?2004l[?2004h> 
[?2004l[?2004h> pack_artifact() {
[?2004l[?2004h>     local pkg_name="$1"
[?2004l[?2004h>     local pkg_dir
[?2004l[?2004h>     pkg_dir=$(get_package_dir "$pkg_name")
[?2004l[?2004h> 
[?2004l[?2004h>     parse_manifest "$pkg_name"
[?2004l[?2004h>     local version="${MANIFEST_version:-0.0.0}"
[?2004l[?2004h> 
[?2004l[?2004h>     local build_dir="$pkg_dir/build"
[?2004l[?2004h>     if [[ ! -d "$build_dir" ]]; then
[?2004l[?2004h>         log_error "Build directory not found for $pkg_name. Run 'forge build' first."
[?2004l[?2004h>         return 1
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     local artifact_dir="$FORGE_ROOT/artifacts"
[?2004l[?2004h>     mkdir -p "$artifact_dir"
[?2004l[?2004h> 
[?2004l[?2004h>     local artifact_name="${pkg_name}-${version}.tar.gz"
[?2004l[?2004h> 
[?2004l[?2004h>     # Generate dependency metadata inside the packaged build directory.
[?2004l[?2004h>     # Direct dependencies only, as <dep_name>=<dep_version> per line.
[?2004l[?2004h>     local deps_manifest="$build_dir/deps.manifest"
[?2004l[?2004h>     : > "$deps_manifest"
[?2004l[?2004h> 
[?2004l[?2004h>     local deps="${MANIFEST_deps:-}"
[?2004l[?2004h>     if [[ -n "$deps" ]]; then
[?2004l[?2004h>         local IFS=','
[?2004l[?2004h>         local dep dep_version
[?2004l[?2004h>         for dep in $deps; do
[?2004l[?2004h>             dep="${dep// /}"
[?2004l[?2004h>             [[ -z "$dep" ]] && continue
[?2004l[?2004h>             dep_version=$(get_manifest_value "$dep" "version") || return 1
[?2004l[?2004h>             printf '%s=%s\n' "$dep" "$dep_version" >> "$deps_manifest"
[?2004l[?2004h>         done
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     tar -czf "$artifact_dir/$artifact_name" \
[?2004l[?2004h>         -C "$pkg_dir" \
[?2004l[?2004h>         build/ 2>/dev/null
[?2004l[?2004h> 
[?2004l[?2004h>     if [[ $? -ne 0 ]]; then
[?2004l[?2004h>         log_error "Failed to create artifact for $pkg_name"
[?2004l[?2004h>         return 1
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     log_info "Packed artifact: $artifact_name -> $artifact_dir/$artifact_name"
[?2004l[?2004h>     echo "$artifact_dir/$artifact_name"
[?2004l[?2004h> }
[?2004l[?2004h> EOF
[?2004l[?2004hroot@n30009:/app# cat > lib/configgen.sh <<'EOF'
[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Deployment config generator for ForgeKit
[?2004l[?2004h> #
[?2004l[?2004h> # Processes template files (*.tpl) by substituting ${VAR} references
[?2004l[?2004h> # with values from environment-specific config files and built-in vars.
[?2004l[?2004h> 
[?2004l[?2004h> # Resolve ${VAR} references iteratively, including nested references such
[?2004l[?2004h> # as ${REGION_${ENV}}.  Flat references are resolved first, then the
[?2004l[?2004h> # process repeats until no further substitution occurs or the maximum
[?2004l[?2004h> # depth is reached.  Unknown references are left unchanged.
[?2004l[?2004h> _config_resolve_vars() {
[?2004l[?2004h>     local content="$1"
[?2004l[?2004h>     local max_depth=100
[?2004l[?2004h>     local depth=0
[?2004l[?2004h>     local prev
[?2004l[?2004h>     local var_name
[?2004l[?2004h> 
[?2004l[?2004h>     while (( depth < max_depth )); do
[?2004l[?2004h>         prev="$content"
[?2004l[?2004h>         for var_name in "${!config_vars[@]}"; do
[?2004l[?2004h>             content="${content//\$\{${var_name}\}/${config_vars[$var_name]}}"
[?2004l[?2004h>         done
[?2004l[?2004h>         [[ "$content" == "$prev" ]] && break
[?2004l[?2004h>         ((depth++))
[?2004l[?2004h>     done
[?2004l[?2004h> 
[?2004l[?2004h>     printf '%s' "$content"
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> generate_config() {
[?2004l[?2004h>     local env="$1"
[?2004l[?2004h>     local template_dir="$FORGE_ROOT/templates"
[?2004l[?2004h> 
[?2004l[?2004h>     if [[ ! -d "$template_dir" ]]; then
[?2004l[?2004h>         log_error "Templates directory not found: $template_dir"
[?2004l[?2004h>         return 1
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     # Build variable map -----------------------------------------------
[?2004l[?2004h>     declare -A config_vars
[?2004l[?2004h>     config_vars[ENV]="$env"
[?2004l[?2004h>     config_vars[FORGE_ROOT]="$FORGE_ROOT"
[?2004l[?2004h>     config_vars[TIMESTAMP]="$(date -u +%Y%m%dT%H%M%SZ)"
[?2004l[?2004h> 
[?2004l[?2004h>     # Load environment-specific config if it exists
[?2004l[?2004h>     local env_conf="$FORGE_ROOT/config/${env}.conf"
[?2004l[?2004h>     if [[ -f "$env_conf" ]]; then
[?2004l[?2004h>         local key value
[?2004l[?2004h>         while IFS='=' read -r key value; do
[?2004l[?2004h>             [[ "$key" =~ ^[[:space:]]*# ]] && continue
[?2004l[?2004h>             [[ -z "$key" ]] && continue
[?2004l[?2004h>             key=$(echo "$key" | tr -d '[:space:]')
[?2004l[?2004h>             value=$(echo "$value" | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')
[?2004l[?2004h>             config_vars[$key]="$value"
[?2004l[?2004h>         done < "$env_conf"
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     # Inject per-package version variables
[?2004l[?2004h>     local pkg_name safe_name
[?2004l[?2004h>     for pkg_name in $(list_package_names); do
[?2004l[?2004h>         parse_manifest "$pkg_name"
[?2004l[?2004h>         safe_name="${pkg_name//-/_}"
[?2004l[?2004h>         config_vars["VERSION_${safe_name}"]="${MANIFEST_version:-0.0.0}"
[?2004l[?2004h>     done
[?2004l[?2004h> 
[?2004l[?2004h>     # Process each template file ---------------------------------------
[?2004l[?2004h>     mkdir -p "$FORGE_ROOT/generated"
[?2004l[?2004h> 
[?2004l[?2004h>     local tpl outname outfile content
[?2004l[?2004h>     for tpl in "$template_dir"/*.tpl; do
[?2004l[?2004h>         [[ -f "$tpl" ]] || continue
[?2004l[?2004h>         outname=$(basename "$tpl" .tpl)
[?2004l[?2004h>         outfile="$FORGE_ROOT/generated/${outname}"
[?2004l[?2004h> 
[?2004l[?2004h>         content=$(cat "$tpl")
[?2004l[?2004h>         content=$(_config_resolve_vars "$content")
[?2004l[?2004h> 
[?2004l[?2004h>         echo "$content" > "$outfile"
[?2004l[?2004h>         log_info "Generated config: $outfile"
[?2004l[?2004h>     done
[?2004l[?2004h> }
[?2004l[?2004h> EOF
[?2004l[?2004hroot@n30009:/app# cat > lib/reporter.sh <<'EOF'
[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Build report generator for ForgeKit
[?2004l[?2004h> 
[?2004l[?2004h> generate_report() {
[?2004l[?2004h>     echo "========================================="
[?2004l[?2004h>     echo "  ForgeKit Build Report"
[?2004l[?2004h>     echo "========================================="
