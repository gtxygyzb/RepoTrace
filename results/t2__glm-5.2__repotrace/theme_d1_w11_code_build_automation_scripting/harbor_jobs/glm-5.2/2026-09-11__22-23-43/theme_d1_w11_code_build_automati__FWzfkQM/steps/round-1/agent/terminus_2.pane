[?2004l[?2004hroot@n30009:/app# cat > lib/cache.sh <<'EOF'
[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Build cache management for ForgeKit
[?2004l[?2004h> #
[?2004l[?2004h> # Uses timestamp-based caching: each package records a "last built"
[?2004l[?2004h> # timestamp; a rebuild is triggered when source files are newer or
[?2004l[?2004h> # when a transitive dependency has been rebuilt more recently.
[?2004l[?2004h> 
[?2004l[?2004h> FORGE_CACHE_DIR="${FORGE_ROOT}/.forge_cache"
[?2004l[?2004h> 
[?2004l[?2004h> init_cache() {
[?2004l[?2004h>     mkdir -p "$FORGE_CACHE_DIR"
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Newest mtime among all files under a package's src/ directory
[?2004l[?2004h> get_src_mtime() {
[?2004l[?2004h>     local pkg_name="$1"
[?2004l[?2004h>     local pkg_dir
[?2004l[?2004h>     pkg_dir=$(get_package_dir "$pkg_name")
[?2004l[?2004h> 
[?2004l[?2004h>     local latest=0
[?2004l[?2004h>     local mtime
[?2004l[?2004h>     while IFS= read -r -d '' file; do
[?2004l[?2004h>         mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)
[?2004l[?2004h>         if (( mtime > latest )); then
[?2004l[?2004h>             latest=$mtime
[?2004l[?2004h>         fi
[?2004l[?2004h>     done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)
[?2004l[?2004h> 
[?2004l[?2004h>     # Also check Makefile
[?2004l[?2004h>     if [[ -f "$pkg_dir/Makefile" ]]; then
[?2004l[?2004h>         mtime=$(stat -c %Y "$pkg_dir/Makefile" 2>/dev/null || echo 0)
[?2004l[?2004h>         if (( mtime > latest )); then
[?2004l[?2004h>             latest=$mtime
[?2004l[?2004h>         fi
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     echo "$latest"
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Check whether the cached build is still valid.
[?2004l[?2004h> #
[?2004l[?2004h> # A package is invalid if:
[?2004l[?2004h> #   - it has no cache stamp
[?2004l[?2004h> #   - its own sources/Makefile are newer than its cache stamp
[?2004l[?2004h> #   - any transitive dependency has no cache stamp
[?2004l[?2004h> #   - any transitive dependency has a cache stamp newer than this package's
[?2004l[?2004h> is_cache_valid() {
[?2004l[?2004h>     local pkg_name="$1"
[?2004l[?2004h>     init_cache
[?2004l[?2004h>     local cache_file="$FORGE_CACHE_DIR/${pkg_name}.stamp"
[?2004l[?2004h> 
[?2004l[?2004h>     if [[ ! -f "$cache_file" ]]; then
[?2004l[?2004h>         return 1  # No cache -> rebuild
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     local cached_time
[?2004l[?2004h>     cached_time=$(cat "$cache_file" 2>/dev/null || echo 0)
[?2004l[?2004h>     if [[ ! "$cached_time" =~ ^[0-9]+$ ]]; then
[?2004l[?2004h>         return 1
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     local src_mtime
[?2004l[?2004h>     src_mtime=$(get_src_mtime "$pkg_name")
[?2004l[?2004h> 
[?2004l[?2004h>     if (( src_mtime > cached_time )); then
[?2004l[?2004h>         return 1  # Source newer than cache -> rebuild
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     # Invalidate when transitive dependencies were rebuilt more recently.
[?2004l[?2004h>     local deps
[?2004l[?2004h>     deps=$(get_all_deps "$pkg_name") || return 1
[?2004l[?2004h>     local dep dep_cache_file dep_time
[?2004l[?2004h>     for dep in $deps; do
[?2004l[?2004h>         [[ -z "$dep" ]] && continue
[?2004l[?2004h>         dep_cache_file="$FORGE_CACHE_DIR/${dep}.stamp"
[?2004l[?2004h>         if [[ ! -f "$dep_cache_file" ]]; then
[?2004l[?2004h>             return 1
[?2004l[?2004h>         fi
[?2004l[?2004h>         dep_time=$(cat "$dep_cache_file" 2>/dev/null || echo 0)
[?2004l[?2004h>         if [[ ! "$dep_time" =~ ^[0-9]+$ ]]; then
[?2004l[?2004h>             return 1
[?2004l[?2004h>         fi
[?2004l[?2004h>         if (( dep_time > cached_time )); then
[?2004l[?2004h>             return 1
[?2004l[?2004h>         fi
[?2004l[?2004h>     done
[?2004l[?2004h> 
[?2004l[?2004h>     return 0  # Cache is valid
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Record the current time as the build timestamp for a package
[?2004l[?2004h> update_cache() {
[?2004l[?2004h>     local pkg_name="$1"
[?2004l[?2004h>     init_cache
[?2004l[?2004h>     date +%s > "$FORGE_CACHE_DIR/${pkg_name}.stamp"
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Remove cache entry for a package
[?2004l[?2004h> invalidate_cache() {
[?2004l[?2004h>     local pkg_name="$1"
[?2004l[?2004h>     rm -f "$FORGE_CACHE_DIR/${pkg_name}.stamp"
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Wipe the entire cache directory
[?2004l[?2004h> clean_cache() {
[?2004l[?2004h>     rm -rf "$FORGE_CACHE_DIR"
[?2004l[?2004h> }
[?2004l[?2004h> EOF
[?2004l[?2004hroot@n30009:/app# cat > lib/builder.sh <<'EOF'
[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Build executor for ForgeKit
[?2004l[?2004h> #
[?2004l[?2004h> # Builds packages by running their Makefile in the correct environment.
[?2004l[?2004h> 
[?2004l[?2004h> # Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.
[?2004l[?2004h> # Includes include and library paths for the full transitive dependency
[?2004l[?2004h> # closure, not just direct dependencies.
[?2004l[?2004h> setup_build_env() {
[?2004l[?2004h>     local pkg_name="$1"
[?2004l[?2004h>     parse_manifest "$pkg_name"
[?2004l[?2004h> 
[?2004l[?2004h>     local cflags=""
[?2004l[?2004h>     local ldflags=""
[?2004l[?2004h>     local libs=""
[?2004l[?2004h>     local deps
[?2004l[?2004h> 
[?2004l[?2004h>     deps=$(get_all_deps "$pkg_name") || return 1
[?2004l[?2004h> 
[?2004l[?2004h>     declare -A seen
[?2004l[?2004h>     local dep dep_dir
[?2004l[?2004h>     for dep in $deps; do
[?2004l[?2004h>         [[ -z "$dep" ]] && continue
[?2004l[?2004h>         [[ -n "${seen[$dep]:-}" ]] && continue
[?2004l[?2004h>         seen[$dep]=1
[?2004l[?2004h> 
[?2004l[?2004h>         dep_dir=$(get_package_dir "$dep")
[?2004l[?2004h>         cflags="$cflags -I${dep_dir}/src"
[?2004l[?2004h>         ldflags="$ldflags -L${dep_dir}/build"
[?2004l[?2004h> 
[?2004l[?2004h>         # For services linking against libraries
[?2004l[?2004h>         parse_manifest "$dep"
[?2004l[?2004h>         if [[ "${MANIFEST_type:-}" == "library" ]]; then
[?2004l[?2004h>             libs="$libs ${dep_dir}/build/${dep}.a"
[?2004l[?2004h>         fi
[?2004l[?2004h>     done
[?2004l[?2004h> 
[?2004l[?2004h>     export FORGE_CFLAGS="$cflags"
[?2004l[?2004h>     export FORGE_LDFLAGS="$ldflags"
[?2004l[?2004h>     export FORGE_LIBS="$libs"
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Build a single package
[?2004l[?2004h> build_package() {
[?2004l[?2004h>     local pkg_name="$1"
[?2004l[?2004h>     local pkg_dir
[?2004l[?2004h>     pkg_dir=$(get_package_dir "$pkg_name")
[?2004l[?2004h> 
[?2004l[?2004h>     if [[ ! -d "$pkg_dir" ]]; then
[?2004l[?2004h>         log_error "Package directory not found: $pkg_dir"
[?2004l[?2004h>         return 1
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     # Check cache
[?2004l[?2004h>     if is_cache_valid "$pkg_name" 2>/dev/null; then
[?2004l[?2004h>         log_info "[$pkg_name] Up to date (cached)"
[?2004l[?2004h>         return 0
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     log_info "[$pkg_name] Building..."
[?2004l[?2004h> 
[?2004l[?2004h>     # Parse manifest for build command
[?2004l[?2004h>     parse_manifest "$pkg_name"
[?2004l[?2004h>     local build_cmd="${MANIFEST_command:-make}"
[?2004l[?2004h> 
[?2004l[?2004h>     # Set up build environment
[?2004l[?2004h>     if ! setup_build_env "$pkg_name"; then
[?2004l[?2004h>         log_error "[$pkg_name] Failed to set up build environment"
[?2004l[?2004h>         return 1
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     # Execute build
[?2004l[?2004h>     if ! (cd "$pkg_dir" && eval "$build_cmd" 2>&1); then
[?2004l[?2004h>         log_error "[$pkg_name] Build failed"
[?2004l[?2004h>         return 1
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     # Update cache
[?2004l[?2004h>     update_cache "$pkg_name"
[?2004l[?2004h> 
[?2004l[?2004h>     log_info "[$pkg_name] Build successful"
[?2004l[?2004h>     return 0
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Run tests for a single package
[?2004l[?2004h> test_package() {
[?2004l[?2004h>     local pkg_name="$1"
[?2004l[?2004h>     local pkg_dir
[?2004l[?2004h>     pkg_dir=$(get_package_dir "$pkg_name")
[?2004l[?2004h> 
[?2004l[?2004h>     parse_manifest "$pkg_name"
[?2004l[?2004h>     local test_cmd="${MANIFEST_test_command:-make test}"
[?2004l[?2004h> 
[?2004l[?2004h>     if ! setup_build_env "$pkg_name"; then
[?2004l[?2004h>         log_error "[$pkg_name] Failed to set up build environment"
[?2004l[?2004h>         return 1
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     log_info "[$pkg_name] Running tests..."
[?2004l[?2004h>     if ! (cd "$pkg_dir" && eval "$test_cmd" 2>&1); then
[?2004l[?2004h>         log_error "[$pkg_name] Tests failed"
[?2004l[?2004h>         return 1
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     log_info "[$pkg_name] Tests passed"
[?2004l[?2004h>     return 0
[?2004l[?2004h> }
