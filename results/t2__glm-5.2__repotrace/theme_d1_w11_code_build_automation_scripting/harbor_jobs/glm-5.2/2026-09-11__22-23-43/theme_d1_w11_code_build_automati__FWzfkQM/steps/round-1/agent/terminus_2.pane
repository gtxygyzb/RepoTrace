[?2004l [?2004h>     fi
[?2004l[?2004h>     local pkg_dir
[?2004l[?2004h>     pkg_dir=$(get_package_dir "$name")
[?2004l[?2004h>     if [[ -d "$pkg_dir/build/$profile" ]]; then
[?2004l[?2004h>         rm -rf "$pkg_dir/build/$profile"
[?2004l[?2004h>         log_info "Cleaned $name ($profile)"
[?2004l[?2004h>     fi
