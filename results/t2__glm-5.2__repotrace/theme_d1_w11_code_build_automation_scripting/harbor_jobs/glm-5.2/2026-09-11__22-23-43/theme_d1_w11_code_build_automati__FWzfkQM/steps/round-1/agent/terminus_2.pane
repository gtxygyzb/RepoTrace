    51	cmd_build() {
    52	    local target="" pkg="" jobs=1 profile="release"
    53	    while [[ $# -gt 0 ]]; do
    54	        case "$1" in
    55	            --all) target="all" ;;
    56	            --changed) target="changed" ;;
    57	            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;
    58	            -j) if [[ $# -lt 2 ]]; then usage; return 1; fi; jobs="$2"; shift ;;
    59	            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
    60	            *) usage; return 1 ;;
    61	        esac
    62	        shift
    63	    done
    64	
    65	    validate_profile "$profile" || return 1
    66	    if [[ ! "$jobs" =~ ^[0-9]+$ ]] || (( jobs < 1 )); then
    67	        log_error "Invalid job count: $jobs (expected N >= 1)"
    68	        return 1
    69	    fi
    70	
    71	    if [[ "$target" == "package" ]]; then
    72	        build_packages_for_target "$pkg" "$jobs" "$profile"
    73	    elif [[ "$target" == "all" ]]; then
    74	        build_all_packages "$jobs" "$profile"
    75	    elif [[ "$target" == "changed" ]]; then
    76	        build_changed_packages "$jobs" "$profile"
    77	    else
    78	        usage
    79	        return 1
    80	    fi
    81	}
