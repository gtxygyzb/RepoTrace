   819	
   820	# Build only packages affected by changes for the given profile.
   821	build_changed_packages() {
   822	    local jobs="${1:-1}" profile="${2:-release}"
   823	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
   824	        log_error "Invalid profile: $profile"
   825	        return 1
   826	    fi
   827	
   828	    build_dep_map
   829	
   830	    local changed
   831	    changed=$(get_changed_packages "$profile") || return 1
   832	    if [[ -z "$changed" ]]; then
   833	        echo "Everything up to date."
   834	        return 0
   835	    fi
   836	
   837	    local affected
   838	    affected=$(get_affected_packages $changed) || return 1
   839	    if [[ -z "$affected" ]]; then
   840	        echo "Everything up to date."
   841	        return 0
   842	    fi
   843	
   844	    local order
   845	    order=$(forge_topo_order $affected) || return 1
   846	
   847	    # Force selected packages to rebuild and re-link, even if their own
   848	    # sources are unchanged.  Removing the artifact ensures Make re-creates
   849	    # it; invalidating the cache ensures build_package does not skip it.
   850	    local pkg pkg_dir artifact_dir artifact
   851	    for pkg in $order; do
   852	        invalidate_cache "$pkg" "$profile"
   853	        pkg_dir=$(get_package_dir "$pkg")
   854	        artifact_dir="$pkg_dir/build/$profile"
   855	        mkdir -p "$artifact_dir"
   856	        parse_manifest "$pkg"
   857	        if [[ "${MANIFEST_type:-}" == "library" ]]; then
   858	            artifact="$artifact_dir/${pkg}.a"
   859	        else
   860	            artifact="$artifact_dir/${pkg}"
   861	        fi
   862	        [[ -f "$artifact" ]] && rm -f "$artifact"
   863	    done
   864	
   865	    _run_parallel_build "$order" "$jobs" "$profile"
   866	}
   867	
   868	# Subset-safe parallel build scheduler.
   869	# Dependencies outside the provided order are treated as already satisfied.
   870	_run_parallel_build() {
   871	    local order="$1" jobs="${2:-1}" profile="${3:-release}"
   872	    jobs=$(( jobs < 1 ? 1 : jobs ))
   873	
   874	    declare -A in_order remaining_deps done_pkg failed_pkg active_pids
   875	    local pkg dep deps_str dep_count dep_array
   876	
   877	    for pkg in $order; do
   878	        in_order[$pkg]=1
   879	    done
