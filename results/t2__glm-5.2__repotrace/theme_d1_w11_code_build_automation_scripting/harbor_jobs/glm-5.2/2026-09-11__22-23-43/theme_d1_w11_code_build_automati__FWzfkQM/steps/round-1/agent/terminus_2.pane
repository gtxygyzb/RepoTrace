   193	
   194	cmd_clean() {
   195	    local target="" pkg="" profile=""
   196	    while [[ $# -gt 0 ]]; do
   197	        case "$1" in
   198	            --all) target="all" ;;
   199	            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;
   200	            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
