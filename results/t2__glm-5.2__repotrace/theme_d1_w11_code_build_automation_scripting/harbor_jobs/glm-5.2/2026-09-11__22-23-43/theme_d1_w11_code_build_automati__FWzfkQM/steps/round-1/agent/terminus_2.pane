   292	# -------------------------------------------------------------------
   293	# Round 4: impact analysis and dependency path queries.
   294	# -------------------------------------------------------------------
   295	
   296	# Return the affected set for one or more changed packages.
   297	# Includes the changed packages and all transitive reverse dependents.
   298	get_affected_packages() {
   299	    if [[ -z "${DEP_MAP[*]+_}" ]]; then
   300	        build_dep_map
   301	    fi
   302	
   303	    declare -A seen
   304	    local result=""
   305	    local target rev r
   306	
   307	    for target in "$@"; do
   308	        if [[ -z "${DEP_MAP[$target]+_}" ]]; then
   309	            log_error "Unknown package: $target"
   310	            return 1
   311	        fi
   312	        if [[ -z "${seen[$target]:-}" ]]; then
   313	            seen[$target]=1
   314	            result="$result $target"
   315	        fi
   316	        rev=$(get_all_reverse_deps "$target") || return 1
   317	        for r in $rev; do
   318	            [[ -z "$r" ]] && continue
   319	            if [[ -z "${seen[$r]:-}" ]]; then
   320	                seen[$r]=1
   321	                result="$result $r"
   322	            fi
   323	        done
   324	    done
   325	
   326	    echo "${result# }"
   327	}
