#include "base.h"
#include <string.h>

int base_version(void) {
    return 100;
}

const char *base_name(void) {
    return "libbase";
}

unsigned long base_hash(const char *s) {
    unsigned long h = 5381;
    int c;
    while ((c = (unsigned char)*s++))
        h = h * 33 + (unsigned long)c;
    return h;
}

int base_clamp(int value, int lo, int hi) {
    if (value < lo) return lo;
    if (value > hi) return hi;
    return value;
}
