    20	TOTAL=0
    21	PASSED=0
    22	FAILED=0
    23	
    24	assert_eq() {
    25	    local desc="$1" expected="$2" actual="$3"
    26	    ((TOTAL++))
    27	    if [[ "$expected" == "$actual" ]]; then
    28	        echo "  PASS: $desc"
    29	        ((PASSED++))
    30	    else
    31	        echo "  FAIL: $desc"
    32	        echo "    expected: '$expected'"
    33	        echo "    actual:   '$actual'"
    34	        ((FAILED++))
    35	    fi
    36	}
    37	
    38	assert_contains() {
    39	    local desc="$1" haystack="$2" needle="$3"
    40	    ((TOTAL++))
    41	    if [[ "$haystack" == *"$needle"* ]]; then
    42	        echo "  PASS: $desc"
    43	        ((PASSED++))
    44	    else
    45	        echo "  FAIL: $desc"
    46	        echo "    expected to contain: '$needle'"
    47	        echo "    in: '$haystack'"
    48	        ((FAILED++))
    49	    fi
    50	}
    51	
    52	assert_not_contains() {
    53	    local desc="$1" haystack="$2" needle="$3"
    54	    ((TOTAL++))
    55	    if [[ "$haystack" != *"$needle"* ]]; then
    56	        echo "  PASS: $desc"
    57	        ((PASSED++))
    58	    else
    59	        echo "  FAIL: $desc"
    60	        echo "    expected NOT to contain: '$needle'"
    61	        echo "    in: '$haystack'"
    62	        ((FAILED++))
    63	    fi
    64	}
    65	
    66	assert_exit_zero() {
    67	    local desc="$1"
    68	    shift
    69	    ((TOTAL++))
    70	    if "$@" > /dev/null 2>&1; then
    71	        echo "  PASS: $desc"
    72	        ((PASSED++))
    73	    else
    74	        echo "  FAIL: $desc (exit code: $?)"
    75	        ((FAILED++))
    76	    fi
    77	}
    78	
    79	assert_exit_nonzero() {
    80	    local desc="$1"
    81	    shift
    82	    ((TOTAL++))
    83	    if "$@" > /dev/null 2>&1; then
    84	        echo "  FAIL: $desc (expected failure but got success)"
    85	        ((FAILED++))
    86	    else
    87	        echo "  PASS: $desc"
    88	        ((PASSED++))
    89	    fi
    90	}
    91	
    92	assert_grep() {
    93	    local desc="$1" text="$2" pattern="$3"
