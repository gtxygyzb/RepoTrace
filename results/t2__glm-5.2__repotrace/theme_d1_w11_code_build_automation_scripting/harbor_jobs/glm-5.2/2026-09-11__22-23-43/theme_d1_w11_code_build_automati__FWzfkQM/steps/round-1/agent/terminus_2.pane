     2	# Build executor for ForgeKit
     3	#
     4	# Builds packages by running their Makefile in the correct environment.
     5	
     6	# Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.
     7	# Includes include and library paths for the full transitive dependency
     8	# closure, not just direct dependencies.
     9	#
    10	# Usage: setup_build_env PKG [PROFILE]
    11	setup_build_env() {
    12	    local pkg_name="$1"
    13	    local profile="${2:-release}"
    14	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
    15	        log_error "Invalid profile: $profile"
    16	        return 1
    17	    fi
    18	    parse_manifest "$pkg_name"
    19	
    20	    local cflags=""
    21	    local ldflags=""
    22	    local libs=""
    23	    local deps
    24	
    25	    deps=$(get_all_deps "$pkg_name") || return 1
    26	
    27	    declare -A seen
    28	    local dep dep_dir
    29	    for dep in $deps; do
    30	        [[ -z "$dep" ]] && continue
    31	        [[ -n "${seen[$dep]:-}" ]] && continue
    32	        seen[$dep]=1
    33	
    34	        dep_dir=$(get_package_dir "$dep")
    35	        cflags="$cflags -I${dep_dir}/src"
    36	        ldflags="$ldflags -L${dep_dir}/build/${profile}"
    37	
    38	        # For services linking against libraries
    39	        parse_manifest "$dep"
    40	        if [[ "${MANIFEST_type:-}" == "library" ]]; then
    41	            libs="$libs ${dep_dir}/build/${profile}/${dep}.a"
    42	        fi
    43	    done
    44	
    45	    case "$profile" in
    46	        debug)   cflags="$cflags -g -O0 -DDEBUG" ;;
    47	        release) cflags="$cflags -O2 -DNDEBUG -s" ;;
    48	    esac
    49	
    50	    export FORGE_CFLAGS="$cflags"
    51	    export FORGE_LDFLAGS="$ldflags"
    52	    export FORGE_LIBS="$libs"
    53	}
    54	
