    40	            current_section="${BASH_REMATCH[1]}"
    41	            continue
    42	        fi
    43	
    44	        # Key = value pair
    45	        if [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then
    46	            key="${BASH_REMATCH[1]}"
    47	            value="${BASH_REMATCH[2]}"
    48	
    49	            # Strip inline comments preceded by whitespace.  A '#' inside a
    50	            # value without preceding whitespace is preserved.
    51	            if [[ "$value" =~ ^[[:space:]]*# ]]; then
    52	                value=""
    53	            elif [[ "$value" =~ [[:space:]]# ]]; then
    54	                value="${value%%[[:space:]]#*}"
    55	            fi
    56	
    57	            # Trim trailing whitespace from value
    58	            value="${value%"${value##*[![:space:]]}"}"
    59	
    60	            # Handle backslash line continuation.  A trailing backslash joins
    61	            # the next line; the backslash and leading whitespace on the
    62	            # continuation line are stripped.
    63	            while [[ "$value" == *\\ ]]; do
    64	                value="${value%\\}"
    65	                if IFS= read -r next_line || [[ -n "$next_line" ]]; then
    66	                    # Strip leading and trailing whitespace from continuation
    67	                    # lines before joining.
    68	                    next_line="${next_line#"${next_line%%[![:space:]]*}"}"
    69	                    next_line="${next_line%"${next_line##*[![:space:]]}"}"
    70	                    value="$value$next_line"
    71	                else
    72	                    break
    73	                fi
    74	            done
    75	
    76	            export "MANIFEST_${key}=${value}"
    77	            if [[ "$current_section" == "targets" ]]; then
    78	                target_name="${key}"
    79	                export "MANIFEST_TARGET_${target_name}=${value}"
    80	            elif [[ "$current_section" == "hooks" ]]; then
    81	                hook_name="${key}"
    82	                export "MANIFEST_HOOK_${hook_name}=${value}"
    83	            fi
    84	        fi
    85	    done < "$manifest_file"
    86	}
