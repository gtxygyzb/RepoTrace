[?2004lecho ""
echo "=== Builder Tests ==="

build_dep_map
setup_build_env svc-scheduler
cflags="$FORGE_CFLAGS"
ldflags="$FORGE_LDFLAGS"
libs="$FORGE_LIBS"

assert_contains "cflags includes direct libstore" "$cflags" "-I$FORGE_ROOT/packages/libstore/src"
assert_contains "cflags includes direct libnet" "$cflags" "-I$FORGE_ROOT/packages/libnet/src"
assert_contains "cflags includes direct libcrypto" "$cflags" "-I$FORGE_ROOT/packages/libcrypto/src"
assert_contains "cflags includes transitive libbase" "$cflags" "-I$FORGE_ROOT/packages/libbase/src"
assert_contains "ldflags includes transitive libbase" "$ldflags" "-L$FORGE_ROOT/packages/libbase/build"
assert_contains "libs includes direct libstore" "$libs" "libstore.a"
assert_contains "libs includes transitive libbase" "$libs" "libbase.a"
assert_contains "libs includes direct libcrypto" "$libs" "libcrypto.a"

setup_build_env svc-auth
auth_cflags="$FORGE_CFLAGS"
assert_contains "svc-auth cflags includes transitive libbase" "$auth_cflags" "-I$FORGE_ROOT/packages/libbase/src"
assert_contains "svc-auth cflags includes libcrypto" "$auth_cflags" "-I$FORGE_ROOT/packages/libcrypto/src"
assert_contains "svc-auth cflags includes libstore" "$auth_cflags" "-I$FORGE_ROOT/packages/libstore/src"

clean_cache
clean_package libbase
assert_exit_zero "build libbase" build_package libbase
assert_exit_zero "cache valid after build" is_cache_valid libbase
assert_exit_zero "cached build skips rebuild" build_package libbase
clean_package libbase
clean_cache

# ==================================================================
echo ""
echo "=== Artifact Tests ==="

for pkg in $(list_package_names); do clean_package "$pkg"; done
clean_cache
rm -rf "$FORGE_ROOT/artifacts"

build_chain() {
    local target="$1" pkg
    for pkg in $(resolve_deps_for "$target"); do
        if ! build_package "$pkg" > /dev/null 2>&1; then
            return 1
        fi
    done
    return 0
}

assert_exit_zero "build libcrypto chain" build_chain libcrypto

libbase_version=$(get_manifest_value libbase version)
result=$(pack_artifact libbase 2>/dev/null)
assert_contains "libbase artifact path returned" "$result" "libbase-1.0.0.tar.gz"
assert_contains "artifact version matches manifest" "$result" "libbase-${libbase_version}.tar.gz"

tmp_extract=$(mktemp -d)
tar -xzf "$result" -C "$tmp_extract"
assert_exit_zero "libbase deps.manifest exists" test -f "$tmp_extract/build/deps.manifest"
