     2	# ForgeKit - Legacy Build Automation System
     3	# Main CLI entry point
     4	
     5	FORGE_ROOT="$(cd "$(dirname "$0")" && pwd)"
     6	export FORGE_ROOT
     7	
     8	# Source library modules
     9	source "$FORGE_ROOT/lib/common.sh"
    10	source "$FORGE_ROOT/lib/manifest.sh"
    11	source "$FORGE_ROOT/lib/depgraph.sh"
    12	source "$FORGE_ROOT/lib/builder.sh"
    13	source "$FORGE_ROOT/lib/cache.sh"
    14	source "$FORGE_ROOT/lib/artifact.sh"
    15	source "$FORGE_ROOT/lib/reporter.sh"
    16	source "$FORGE_ROOT/lib/configgen.sh"
    17	
    18	# Load global config
    19	if [[ -f "$FORGE_ROOT/config/forge.conf" ]]; then
    20	    source "$FORGE_ROOT/config/forge.conf"
    21	fi
    22	
    23	usage() {
    24	    cat <<'EOF'
    25	Usage: forge <command> [options]
    26	
    27	Commands:
    28	  build [--all|--package NAME]  Build packages
    29	  test  [--all|--package NAME]  Run package tests
    30	  list                          List all packages
    31	  deps  NAME                    Show dependency tree for a package
    32	  report                        Generate build report
    33	  config generate ENV           Generate deployment configs from templates
    34	  artifact pack NAME            Package build artifact
    35	  clean [--all|--package NAME]  Clean build artifacts
    36	EOF
    37	    exit 1
    38	}
    39	
    40	cmd_build() {
    41	    if [[ $# -lt 1 ]]; then usage; fi
    42	    local target="$1"
    43	    if [[ "$target" == "--all" ]]; then
    44	        local order
    45	        order=$(resolve_build_order)
    46	        if [[ $? -ne 0 ]]; then
    47	            log_error "Failed to resolve build order"
    48	            return 1
    49	        fi
    50	        for pkg in $order; do
    51	            build_package "$pkg"
    52	            if [[ $? -ne 0 ]]; then
    53	                log_error "Build failed for $pkg"
    54	                return 1
    55	            fi
    56	        done
    57	        log_info "All packages built successfully"
    58	    elif [[ "$target" == "--package" ]]; then
    59	        if [[ $# -lt 2 ]]; then usage; fi
    60	        local name="$2"
    61	        local order
    62	        order=$(resolve_deps_for "$name")
    63	        if [[ $? -ne 0 ]]; then
    64	            log_error "Failed to resolve dependencies for $name"
    65	            return 1
    66	        fi
    67	        for pkg in $order; do
    68	            build_package "$pkg"
    69	            if [[ $? -ne 0 ]]; then
    70	                log_error "Build failed for $pkg"
    71	                return 1
    72	            fi
    73	        done
    74	    else
    75	        usage
    76	    fi
    77	}
    78	
    79	cmd_test() {
    80	    if [[ $# -lt 1 ]]; then usage; fi
    81	    local target="$1"
    82	    local failed=0
    83	    if [[ "$target" == "--all" ]]; then
    84	        local order
    85	        order=$(resolve_build_order)
    86	        for pkg in $order; do
    87	            if ! test_package "$pkg"; then
    88	                log_warn "Tests failed for $pkg"
    89	                ((failed++))
    90	            fi
    91	        done
