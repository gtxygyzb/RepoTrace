    60	        log_error "Invalid profile: $profile"
    61	        return 1
    62	    fi
    63	    local pkg_dir
    64	    pkg_dir=$(get_package_dir "$pkg_name")
    65	
    66	    if [[ ! -d "$pkg_dir" ]]; then
    67	        log_error "Package directory not found: $pkg_dir"
    68	        return 1
    69	    fi
    70	
    71	    # Check cache
    72	    if is_cache_valid "$pkg_name" "$profile" 2>/dev/null; then
    73	        log_info "[$pkg_name] Up to date (cached)"
    74	        return 0
    75	    fi
    76	
    77	    log_info "[$pkg_name] Building..."
    78	
    79	    # Parse manifest for build command
    80	    parse_manifest "$pkg_name"
    81	    local build_cmd="${MANIFEST_command:-make}"
    82	    case "$build_cmd" in
    83	        *make*) build_cmd="$build_cmd BUILD_DIR=build/${profile}" ;;
    84	    esac
    85	
    86	    # Set up build environment
    87	    if ! setup_build_env "$pkg_name" "$profile"; then
    88	        log_error "[$pkg_name] Failed to set up build environment"
    89	        return 1
    90	    fi
    91	
    92	    # Execute build
    93	    if ! (cd "$pkg_dir" && BUILD_DIR="build/${profile}" eval "$build_cmd" 2>&1); then
    94	        log_error "[$pkg_name] Build failed"
    95	        return 1
    96	    fi
    97	
    98	    # Update cache
    99	    update_cache "$pkg_name" "$profile"
   100	
