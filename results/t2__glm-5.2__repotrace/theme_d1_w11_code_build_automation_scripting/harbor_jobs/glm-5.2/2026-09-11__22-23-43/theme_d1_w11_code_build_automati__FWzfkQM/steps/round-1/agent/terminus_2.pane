    26	
    27	Commands:
    28	  build [--all|--package NAME|--changed] [-j N] [--profile debug|release]
    29	  test  [--all|--package NAME] [--profile debug|release]
    30	  list
    31	  deps  NAME
    32	  deps  --why NAME NAME
    33	  impact NAME
    34	  report
    35	  config generate ENV
    36	  artifact pack NAME [--profile debug|release]
    37	  clean [--all|--package NAME] [--profile debug|release]
    38	  graph [--reverse NAME]
    39	EOF
    40	}
    41	
    42	validate_profile() {
    43	    local profile="${1:-release}"
    44	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
    45	        log_error "Invalid profile: $profile (expected debug or release)"
    46	        return 1
    47	    fi
    48	    return 0
