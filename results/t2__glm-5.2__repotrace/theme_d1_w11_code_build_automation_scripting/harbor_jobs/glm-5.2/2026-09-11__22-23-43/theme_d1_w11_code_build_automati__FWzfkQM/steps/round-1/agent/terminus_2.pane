[?2004l[?2004h> 
[?2004l[?2004h>     local deps="${DEP_MAP[$name]:-}"
[?2004l[?2004h>     if [[ -n "$deps" ]]; then
[?2004l[?2004h>         local IFS=','
[?2004l[?2004h>         for dep in $deps; do
[?2004l[?2004h>             dep="${dep// /}"
[?2004l[?2004h>             [[ -z "$dep" ]] && continue
[?2004l[?2004h>             show_dep_tree "$dep" $((indent + 1)) "$seen" || true
[?2004l[?2004h>         done
[?2004l[?2004h>     fi
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Return all transitive dependencies (not including the package itself)
[?2004l[?2004h> get_all_deps() {
[?2004l[?2004h>     local name="$1"
[?2004l[?2004h>     if [[ -z "${DEP_MAP[*]+_}" ]]; then
[?2004l[?2004h>         build_dep_map
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     declare -A _seen
[?2004l[?2004h>     local _result=""
[?2004l[?2004h> 
[?2004l[?2004h>     _collect_deps() {
[?2004l[?2004h>         local node="$1"
[?2004l[?2004h>         local deps="${DEP_MAP[$node]:-}"
[?2004l[?2004h>         if [[ -n "$deps" ]]; then
[?2004l[?2004h>             local IFS=','
[?2004l[?2004h>             for dep in $deps; do
[?2004l[?2004h>                 dep="${dep// /}"
[?2004l[?2004h>                 [[ -z "$dep" ]] && continue
[?2004l[?2004h>                 if [[ -z "${_seen[$dep]:-}" ]]; then
[?2004l[?2004h>                     _seen[$dep]=1
[?2004l[?2004h>                     _result="$_result $dep"
[?2004l[?2004h>                     _collect_deps "$dep"
[?2004l[?2004h>                 fi
[?2004l[?2004h>             done
[?2004l[?2004h>         fi
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     _collect_deps "$name"
[?2004l[?2004h>     echo "$_result"
[?2004l[?2004h> }
