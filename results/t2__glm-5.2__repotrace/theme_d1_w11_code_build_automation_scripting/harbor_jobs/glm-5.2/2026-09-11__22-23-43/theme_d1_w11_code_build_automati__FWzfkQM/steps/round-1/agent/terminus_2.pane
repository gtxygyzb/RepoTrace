   167	_test_package_chain() {
   168	    local target="$1" profile="$2"
   169	    local order pkg
   170	    order=$(resolve_deps_for "$target") || return 1
   171	    for pkg in $order; do
   172	        build_package "$pkg" "$profile" || return 1
   173	    done
   174	}
