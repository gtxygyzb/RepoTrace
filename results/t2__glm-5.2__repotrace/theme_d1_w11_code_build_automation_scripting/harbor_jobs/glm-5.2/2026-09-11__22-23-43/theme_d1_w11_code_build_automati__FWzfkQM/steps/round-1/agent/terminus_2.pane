[?2004l     1	#!/bin/bash
     2	# Manifest parser for .forge package files
     3	#
     4	# Format:
     5	#   [section]
     6	#   key = value
     7	#   # comments
     8	#   key = long value \
     9	#         continued on next line
    10	#
    11	# All parsed values are exported as MANIFEST_<key>=<value>
    12	
    13	parse_manifest() {
    14	    local pkg_name="$1"
    15	    local manifest_file
    16	    manifest_file=$(get_package_manifest "$pkg_name")
    17	
    18	    if [[ ! -f "$manifest_file" ]]; then
    19	        log_error "Manifest not found: $manifest_file"
    20	        return 1
    21	    fi
    22	
    23	    # Clear previous manifest data
    24	    local var
    25	    for var in $(compgen -v MANIFEST_ 2>/dev/null || true); do
    26	        unset "$var"
    27	    done
    28	
    29	    local current_section=""
    30	    local line key value next_line
    31	
    32	    while IFS= read -r line || [[ -n "$line" ]]; do
    33	        # Skip empty lines and full-line comments
    34	        [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    35	        [[ "$line" =~ ^[[:space:]]*# ]] && continue
    36	
    37	        # Section header
    38	        if [[ "$line" =~ ^\[([a-zA-Z_][a-zA-Z0-9_]*)\] ]]; then
    39	            current_section="${BASH_REMATCH[1]}"
    40	            continue
    41	        fi
    42	
    43	        # Key = value pair
    44	        if [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then
    45	            key="${BASH_REMATCH[1]}"
    46	            value="${BASH_REMATCH[2]}"
    47	
    48	            # Strip inline comments preceded by whitespace.  A '#' inside a
    49	            # value without preceding whitespace is preserved.
    50	            if [[ "$value" =~ ^[[:space:]]*# ]]; then
    51	                value=""
    52	            elif [[ "$value" =~ [[:space:]]# ]]; then
    53	                value="${value%%[[:space:]]#*}"
    54	            fi
    55	
    56	            # Trim trailing whitespace from value
    57	            value="${value%"${value##*[![:space:]]}"}"
    58	
    59	            # Handle backslash line continuation.  A trailing backslash joins
    60	            # the next line; the backslash and leading whitespace on the
    61	            # continuation line are stripped.
    62	            while [[ "$value" == *\\ ]]; do
    63	                value="${value%\\}"
    64	                if IFS= read -r next_line || [[ -n "$next_line" ]]; then
    65	                    # Strip leading and trailing whitespace from continuation
    66	                    # lines before joining.
    67	                    next_line="${next_line#"${next_line%%[![:space:]]*}"}"
    68	                    next_line="${next_line%"${next_line##*[![:space:]]}"}"
    69	                    value="$value$next_line"
    70	                else
    71	                    break
    72	                fi
    73	            done
    74	
    75	            export "MANIFEST_${key}=${value}"
    76	        fi
    77	    done < "$manifest_file"
    78	}
    79	
    80	# Convenience: parse and return a single value
    81	get_manifest_value() {
    82	    local pkg_name="$1"
    83	    local key="$2"
    84	    if ! parse_manifest "$pkg_name"; then
    85	        return 1
    86	    fi
    87	    local var="MANIFEST_${key}"
    88	    echo "${!var:-}"
    89	}
