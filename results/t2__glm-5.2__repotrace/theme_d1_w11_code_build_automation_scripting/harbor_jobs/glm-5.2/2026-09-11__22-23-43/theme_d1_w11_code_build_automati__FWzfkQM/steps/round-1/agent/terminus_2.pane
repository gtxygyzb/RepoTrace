[?2004l#!/bin/bash
# ForgeKit - Legacy Build Automation System
# Main CLI entry point

FORGE_ROOT="$(cd "$(dirname "$0")" && pwd)"
export FORGE_ROOT

# Source library modules
source "$FORGE_ROOT/lib/common.sh"
source "$FORGE_ROOT/lib/manifest.sh"
source "$FORGE_ROOT/lib/depgraph.sh"
source "$FORGE_ROOT/lib/builder.sh"
source "$FORGE_ROOT/lib/cache.sh"
source "$FORGE_ROOT/lib/artifact.sh"
source "$FORGE_ROOT/lib/reporter.sh"
source "$FORGE_ROOT/lib/configgen.sh"
source "$FORGE_ROOT/lib/journal.sh"

# Load global config
if [[ -f "$FORGE_ROOT/config/forge.conf" ]]; then
    source "$FORGE_ROOT/config/forge.conf"
fi

usage() {
    cat <<'EOF'
Usage: forge <command> [options]

Commands:
  build [--all|--package NAME|--changed] [-j N] [--profile debug|release]
  test  [--all|--package NAME] [--profile debug|release]
  list
  deps  NAME
  deps  --why NAME NAME
  impact NAME
  report
  config generate ENV
  artifact pack NAME [--profile debug|release]
  clean [--all|--package NAME] [--profile debug|release]
  graph [--reverse NAME]
EOF
}

validate_profile() {
    local profile="${1:-release}"
    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
        log_error "Invalid profile: $profile (expected debug or release)"
        return 1
    fi
    return 0
}

cmd_build() {
    local target="" pkg="" jobs=1 profile="release"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) target="all" ;;
            --changed) target="changed" ;;
            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;
            -j) if [[ $# -lt 2 ]]; then usage; return 1; fi; jobs="$2"; shift ;;
            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
            *) usage; return 1 ;;
        esac
        shift
    done

    validate_profile "$profile" || return 1
    if [[ ! "$jobs" =~ ^[0-9]+$ ]] || (( jobs < 1 )); then
        log_error "Invalid job count: $jobs (expected N >= 1)"
        return 1
    fi

    if [[ "$target" == "package" ]]; then
        build_packages_for_target "$pkg" "$jobs" "$profile"
    elif [[ "$target" == "all" ]]; then
        build_all_packages "$jobs" "$profile"
    elif [[ "$target" == "changed" ]]; then
        build_changed_packages "$jobs" "$profile"
    else
        usage
        return 1
    fi
}

cmd_test() {
    local target="" pkg="" profile="release"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) target="all" ;;
            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;
            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
            *) usage; return 1 ;;
        esac
        shift
    done

    validate_profile "$profile" || return 1
    if [[ ! "$jobs" =~ ^[0-9]+$ ]] || (( jobs < 1 )); then
        log_error "Invalid job count: $jobs (expected N >= 1)"
        return 1
    fi

    if [[ "$target" == "package" ]]; then
        test_package_chain "$pkg" "$profile"
    elif [[ "$target" == "all" ]]; then
        local order pkg_name
        order=$(resolve_build_order) || return 1
        build_all_packages 1 "$profile" || return 1
        for pkg_name in $order; do
            test_package "$pkg_name" "$profile" || return 1
        done
    else
        usage
        return 1
    fi
}

cmd_list() {
    list_packages
}

cmd_deps() {
    if [[ $# -lt 1 ]]; then usage; return 1; fi
    if [[ "$1" == "--why" ]]; then
        if [[ $# -lt 3 ]]; then usage; return 1; fi
        shortest_dep_path "$2" "$3"
        return $?
    fi
    show_dep_tree "$1"
}

cmd_impact() {
    if [[ $# -lt 1 ]]; then usage; return 1; fi
    impact_package "$1"
}

cmd_cache() {
    if [[ $# -lt 1 ]]; then
        usage
        return 1
    fi

    case "$1" in
        status)
            shift
            cache_status "$@"
            ;;
        get_src_hash|get-src-hash)
            shift
            if [[ $# -lt 1 ]]; then
                usage
                return 1
            fi
            get_src_hash "$@"
            ;;
        *)
            usage
            return 1
            ;;
    esac
}

cmd_journal() {
    if [[ $# -gt 0 && "$1" == "clear" ]]; then
        journal_clear
        return $?
    fi
    journal_query "$@"
}

cmd_report() {
    generate_report
}

cmd_config() {
    if [[ $# -lt 2 || "$1" != "generate" ]]; then usage; return 1; fi
    generate_config "$2"
}

cmd_artifact() {
    if [[ $# -lt 2 || "$1" != "pack" ]]; then usage; return 1; fi
    local pkg="$2" profile="release"
    shift 2
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
            *) usage; return 1 ;;
        esac
        shift
    done
    validate_profile "$profile" || return 1
    pack_artifact "$pkg" "$profile"
}

cmd_clean() {
    local target="" pkg="" profile=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) target="all" ;;
            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;
            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
            *) usage; return 1 ;;
        esac
        shift
    done

    if [[ -n "$profile" ]]; then
        validate_profile "$profile" || return 1
    fi

    if [[ "$target" == "all" ]]; then
        for pkg_name in $(list_package_names); do
            clean_package "$pkg_name" "$profile"
        done
        clean_cache "$profile"
        if [[ -n "$profile" ]]; then
            log_info "All packages cleaned ($profile)"
        else
            log_info "All packages cleaned (all profiles)"
        fi
    elif [[ "$target" == "package" ]]; then
[?2004hroot@n30009:/app# sed -n '1,260p' lib/manifest.sh
[?2004l#!/bin/bash
# Manifest parser for .forge package files
#
# Format:
#   [section]
#   key = value
#   # comments
#   key = long value \
#         continued on next line
#
# All parsed values are exported as MANIFEST_<key>=<value>

parse_manifest() {
    local pkg_name="$1"
    local manifest_file
    manifest_file=$(get_package_manifest "$pkg_name")

    if [[ ! -f "$manifest_file" ]]; then
        log_error "Manifest not found: $manifest_file"
        return 1
    fi

    # Clear previous manifest data
    local var
    for var in $(compgen -v MANIFEST_ 2>/dev/null || true); do
        unset "$var"
    done

    local current_section=""
    local line key value next_line

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Skip empty lines and full-line comments
        [[ "$line" =~ ^[[:space:]]*$ ]] && continue
        [[ "$line" =~ ^[[:space:]]*# ]] && continue

        # Section header
        if [[ "$line" =~ ^\[([a-zA-Z_][a-zA-Z0-9_]*)\] ]]; then
            current_section="${BASH_REMATCH[1]}"
            continue
        fi

        # Key = value pair
        if [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then
            key="${BASH_REMATCH[1]}"
            value="${BASH_REMATCH[2]}"

            # Strip inline comments preceded by whitespace.  A '#' inside a
            # value without preceding whitespace is preserved.
            if [[ "$value" =~ ^[[:space:]]*# ]]; then
                value=""
            elif [[ "$value" =~ [[:space:]]# ]]; then
                value="${value%%[[:space:]]#*}"
            fi

            # Trim trailing whitespace from value
            value="${value%"${value##*[![:space:]]}"}"

            # Handle backslash line continuation.  A trailing backslash joins
            # the next line; the backslash and leading whitespace on the
            # continuation line are stripped.
            while [[ "$value" == *\\ ]]; do
                value="${value%\\}"
                if IFS= read -r next_line || [[ -n "$next_line" ]]; then
                    # Strip leading and trailing whitespace from continuation
                    # lines before joining.
                    next_line="${next_line#"${next_line%%[![:space:]]*}"}"
                    next_line="${next_line%"${next_line##*[![:space:]]}"}"
                    value="$value$next_line"
                else
                    break
                fi
            done

            export "MANIFEST_${key}=${value}"
        fi
    done < "$manifest_file"
}

# Convenience: parse and return a single value
get_manifest_value() {
    local pkg_name="$1"
    local key="$2"
    if ! parse_manifest "$pkg_name"; then
        return 1
    fi
    local var="MANIFEST_${key}"
    echo "${!var:-}"
}
