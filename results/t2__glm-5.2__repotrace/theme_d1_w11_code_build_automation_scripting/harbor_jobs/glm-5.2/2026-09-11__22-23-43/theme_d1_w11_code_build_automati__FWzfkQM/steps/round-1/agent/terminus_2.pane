   365	# Internal: schedule packages in dependency order with up to N workers.
   366	# Each package's output is buffered and printed under a header when it
   367	# finishes.  Existing concurrent builds continue on failure, but no new
   368	# packages are started after a failure.
   369	_run_parallel_build() {
   370	    local order="$1" jobs="${2:-1}" profile="${3:-release}"
   371	    jobs=$(( jobs < 1 ? 1 : jobs ))
   372	
   373	    declare -A remaining_deps state failed_pkg
   374	    declare -A active_pids
   375	    local pkg dep deps_str dep_count
   376	
   377	    for pkg in $order; do
   378	        deps_str="${DEP_MAP[$pkg]:-}"
   379	        dep_count=0
   380	        if [[ -n "$deps_str" ]]; then
   381	            local IFS=','
   382	            for dep in $deps_str; do
   383	                dep="${dep// /}"
   384	                [[ -z "$dep" ]] && continue
   385	                dep_count=$(( dep_count + 1 ))
   386	            done
   387	        fi
   388	        remaining_deps[$pkg]=$dep_count
   389	        state[$pkg]=pending
   390	    done
   391	
   392	    local total=0
   393	    for pkg in $order; do total=$(( total + 1 )); done
   394	    local finished=0 active=0 failed=0
   395	
   396	    local tmpdir
   397	    tmpdir=$(mktemp -d)
   398	
   399	    while (( finished < total )); do
   400	        # Launch ready packages up to the concurrency limit.
   401	        # After a failure, do not start any new packages; allow
   402	        # already-running jobs to complete.
   403	        if (( ! failed )); then
   404	            for pkg in $order; do
   405	                if (( active >= jobs )); then
   406	                    break
   407	                fi
   408	                if [[ "${state[$pkg]}" == "pending" ]] && (( remaining_deps[$pkg] == 0 )); then
   409	                    state[$pkg]=running
   410	                    active=$(( active + 1 ))
   411	                    (
   412	                        {
   413	                            build_package "$pkg" "$profile"
   414	                            echo "__FORGE_BUILD_RC__$?"
   415	                        } > "$tmpdir/$pkg.out" 2>&1
   416	                    ) &
   417	                    active_pids[$!]="$pkg"
   418	                fi
   419	            done
   420	        fi
   421	
   422	        if (( active == 0 )); then
   423	            # Nothing is running and nothing can be started; remaining
   424	            # packages are blocked by failed dependencies.
   425	            break
   426	        fi
   427	
   428	        # Wait for at least one background job to finish, then reap all
   429	        # completed jobs.  This avoids reading buffered output files
   430	        # before their subshell has finished writing.
   431	        wait -n 2>/dev/null || true
   432	
   433	        local completed=0
   434	        for pid in "${!active_pids[@]}"; do
   435	            if ! kill -0 "$pid" 2>/dev/null; then
   436	                wait "$pid" 2>/dev/null || true
   437	                pkg="${active_pids[$pid]}"
   438	                unset "active_pids[$pid]"
   439	                active=$(( active - 1 ))
   440	                finished=$(( finished + 1 ))
   441	                completed=$(( completed + 1 ))
   442	
   443	                local rc
   444	                rc=$(grep -m1 '__FORGE_BUILD_RC__' "$tmpdir/$pkg.out" | sed 's/.*__FORGE_BUILD_RC__//')
   445	                rc="${rc:-1}"
   446	
   447	                echo "=== [$pkg] ==="
   448	                grep -v '__FORGE_BUILD_RC__' "$tmpdir/$pkg.out"
   449	
   450	                if (( rc == 0 )); then
   451	                    state[$pkg]=done
   452	
   453	                    local dependent dep_deps dep_dep
   454	                    for dependent in $order; do
   455	                        if [[ "${state[$dependent]}" == "pending" ]]; then
   456	                            dep_deps="${DEP_MAP[$dependent]:-}"
   457	                            if [[ -n "$dep_deps" ]]; then
   458	                                local IFS=','
   459	                                for dep_dep in $dep_deps; do
   460	                                    dep_dep="${dep_dep// /}"
   461	                                    [[ -z "$dep_dep" ]] && continue
   462	                                    if [[ "$dep_dep" == "$pkg" ]]; then
   463	                                        remaining_deps[$dependent]=$(( remaining_deps[$dependent] - 1 ))
   464	                                    fi
   465	                                done
   466	                            fi
   467	                        fi
   468	                    done
   469	                else
   470	                    state[$pkg]=failed
   471	                    failed_pkg[$pkg]=1
   472	                    failed=1
   473	                fi
   474	            fi
   475	        done
   476	
   477	        if (( completed == 0 )); then
   478	            sleep 0.05
   479	        fi
   480	    done
   481	
   482	    rm -rf "$tmpdir"
   483	
   484	    local failures=""
   485	    for pkg in $order; do
   486	        if [[ -n "${failed_pkg[$pkg]:-}" ]]; then
   487	            failures="$failures $pkg"
   488	        fi
   489	    done
   490	
   491	    if [[ -n "$failures" ]]; then
