$(TARGET): $(OBJECTS)
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ $^

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -I$(SRC_DIR) -c -o $@ $<

test: all
	@echo "svc-scheduler: all tests passed"

clean:
	rm -rf $(BUILD_DIR)
	find $(SRC_DIR) -name '*.o' -delete 2>/dev/null || true
===== packages/svc-scheduler/package.forge =====
[package]
name = svc-scheduler
version = 1.0.0
type = service

[deps]
deps = libstore,libnet,libcrypto

[build]
command = make
test_command = make test
output = build/svc-scheduler

[meta]
description = Distributed task scheduling and orchestration service
tags = scheduler,orchestration,service
===== packages/svc-scheduler/src/main.c =====
#include <stdio.h>

int main(void) {
    printf("svc-scheduler v1.0.0 starting\n");
    printf("  scheduler: ready\n");
    return 0;
}
===== packages/svc-worker/Makefile =====
CC      ?= gcc
CFLAGS  ?= -Wall -Wextra -O2
CFLAGS  += $(FORGE_CFLAGS)

SRC_DIR   = src
BUILD_DIR = build

SOURCES = $(wildcard $(SRC_DIR)/*.c)
OBJECTS = $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SOURCES))
TARGET  = $(BUILD_DIR)/svc-worker

.PHONY: all test clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ $^

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -I$(SRC_DIR) -c -o $@ $<

test: all
	@echo "svc-worker: all tests passed"

clean:
	rm -rf $(BUILD_DIR)
	find $(SRC_DIR) -name '*.o' -delete 2>/dev/null || true
