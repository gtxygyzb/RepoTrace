   123	            --builds-only)
   124	                builds_only=true
   125	                ;;
   126	            *)
   127	                log_error "Unknown journal option: $1"
   128	                return 1
   129	                ;;
   130	        esac
   131	        shift
   132	    done
   133	
   134	    if [[ ! -f "$FORGE_JOURNAL_FILE" ]]; then
   135	        echo "No build events recorded."
   136	        return 0
   137	    fi
   138	
   139	    if [[ ! "$last" =~ ^[0-9]+$ ]] || (( last < 0 )); then
