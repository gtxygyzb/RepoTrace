    26	    ((TOTAL++))
    27	    if [[ "$expected" == "$actual" ]]; then
    28	        echo "  PASS: $desc"
    29	        ((PASSED++))
    30	    else
    31	        echo "  FAIL: $desc"
    32	        echo "    expected: '$expected'"
    33	        echo "    actual:   '$actual'"
    34	        ((FAILED++))
    35	    fi
    36	}
    37	
    38	assert_contains() {
