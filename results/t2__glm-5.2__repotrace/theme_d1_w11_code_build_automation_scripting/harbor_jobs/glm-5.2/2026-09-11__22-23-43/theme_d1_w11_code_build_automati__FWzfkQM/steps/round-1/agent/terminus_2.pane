[?2004hroot@n30009:/app# nl -ba lib/builder.sh
[?2004l     1	#!/bin/bash
     2	# Build executor for ForgeKit
     3	#
     4	# Builds packages by running their Makefile in the correct environment.
     5	
     6	# Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.
     7	# BUG: Only sets up paths for *direct* dependencies.
     8	#      Transitive dependency include/lib paths are not added.
     9	#      Currently harmless because no header exposes transitive types,
    10	#      but will break as soon as a public header includes a transitive
    11	#      dependency header.
    12	setup_build_env() {
    13	    local pkg_name="$1"
    14	    parse_manifest "$pkg_name"
    15	
    16	    local cflags=""
    17	    local ldflags=""
    18	    local libs=""
    19	    local deps="${MANIFEST_deps:-}"
    20	
    21	    if [[ -n "$deps" ]]; then
    22	        local IFS=','
    23	        for dep in $deps; do
    24	            dep="${dep// /}"
    25	            [[ -z "$dep" ]] && continue
    26	            local dep_dir
    27	            dep_dir=$(get_package_dir "$dep")
    28	            cflags="$cflags -I${dep_dir}/src"
    29	            ldflags="$ldflags -L${dep_dir}/build"
    30	            # For services linking against libraries
    31	            parse_manifest "$dep"
    32	            if [[ "${MANIFEST_type:-}" == "library" ]]; then
    33	                local libname="${dep#lib}"
    34	                libs="$libs ${dep_dir}/build/${dep}.a"
    35	            fi
    36	        done
    37	    fi
    38	
    39	    export FORGE_CFLAGS="$cflags"
    40	    export FORGE_LDFLAGS="$ldflags"
    41	    export FORGE_LIBS="$libs"
    42	}
    43	
    44	# Build a single package
    45	build_package() {
    46	    local pkg_name="$1"
    47	    local pkg_dir
    48	    pkg_dir=$(get_package_dir "$pkg_name")
    49	
    50	    if [[ ! -d "$pkg_dir" ]]; then
    51	        log_error "Package directory not found: $pkg_dir"
    52	        return 1
    53	    fi
    54	
    55	    # Check cache
    56	    if is_cache_valid "$pkg_name" 2>/dev/null; then
    57	        log_info "[$pkg_name] Up to date (cached)"
    58	        return 0
    59	    fi
    60	
    61	    log_info "[$pkg_name] Building..."
    62	
    63	    # Parse manifest for build command
    64	    parse_manifest "$pkg_name"
    65	    local build_cmd="${MANIFEST_command:-make}"
    66	
    67	    # Set up build environment
    68	    setup_build_env "$pkg_name"
    69	
    70	    # Execute build
    71	    if ! (cd "$pkg_dir" && eval "$build_cmd" 2>&1); then
    72	        log_error "[$pkg_name] Build failed"
    73	        return 1
    74	    fi
    75	
    76	    # Update cache
    77	    update_cache "$pkg_name"
    78	
    79	    log_info "[$pkg_name] Build successful"
    80	    return 0
    81	}
    82	
    83	# Run tests for a single package
    84	test_package() {
    85	    local pkg_name="$1"
    86	    local pkg_dir
    87	    pkg_dir=$(get_package_dir "$pkg_name")
    88	
    89	    parse_manifest "$pkg_name"
    90	    local test_cmd="${MANIFEST_test_command:-make test}"
    91	
    92	    setup_build_env "$pkg_name"
    93	
    94	    log_info "[$pkg_name] Running tests..."
    95	    if ! (cd "$pkg_dir" && eval "$test_cmd" 2>&1); then
    96	        log_error "[$pkg_name] Tests failed"
    97	        return 1
    98	    fi
    99	
   100	    log_info "[$pkg_name] Tests passed"
   101	    return 0
   102	}
[?2004hroot@n30009:/app# nl -ba lib/artifact.sh
[?2004l     1	#!/bin/bash
     2	# Artifact packaging for ForgeKit
     3	#
     4	# Packs a package's build output into a distributable tarball.
     5	
     6	pack_artifact() {
     7	    local pkg_name="$1"
     8	    local pkg_dir
     9	    pkg_dir=$(get_package_dir "$pkg_name")
    10	
    11	    parse_manifest "$pkg_name"
    12	    local version="${MANIFEST_version:-0.0.0}"
    13	
    14	    local build_dir="$pkg_dir/build"
    15	    if [[ ! -d "$build_dir" ]]; then
    16	        log_error "Build directory not found for $pkg_name. Run 'forge build' first."
    17	        return 1
    18	    fi
    19	
    20	    local artifact_dir="$FORGE_ROOT/artifacts"
    21	    mkdir -p "$artifact_dir"
    22	
    23	    local artifact_name="${pkg_name}-${version}.tar.gz"
    24	
    25	    # BUG: The tarball only contains build/ output.
    26	    # It should also include a deps.manifest file listing the direct
    27	    # dependencies and their versions so downstream deployment tooling
    28	    # can verify compatibility.  Currently there is no such metadata,
    29	    # making it impossible to check whether two artifacts were built
    30	    # against compatible dependency versions.
    31	
    32	    tar -czf "$artifact_dir/$artifact_name" \
    33	        -C "$pkg_dir" \
    34	        build/ 2>/dev/null
    35	
    36	    if [[ $? -ne 0 ]]; then
    37	        log_error "Failed to create artifact for $pkg_name"
    38	        return 1
    39	    fi
    40	
    41	    log_info "Packed artifact: $artifact_name -> $artifact_dir/$artifact_name"
    42	    echo "$artifact_dir/$artifact_name"
    43	}
