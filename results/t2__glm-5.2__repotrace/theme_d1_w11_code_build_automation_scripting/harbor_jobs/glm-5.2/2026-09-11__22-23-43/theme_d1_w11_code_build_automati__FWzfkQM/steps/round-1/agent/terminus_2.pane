     2	# Build event journal for ForgeKit.
     3	#
     4	# Appends structured JSON-lines events for build actions and provides
     5	# query/clear helpers for `forge journal` and `forge report`.
     6	
     7	FORGE_JOURNAL_DIR="${FORGE_ROOT}/.forge_journal"
     8	FORGE_JOURNAL_FILE="${FORGE_JOURNAL_DIR}/events.jsonl"
     9	
    10	journal_dir() {
    11	    echo "$FORGE_JOURNAL_DIR"
    12	}
    13	
    14	journal_file() {
    15	    echo "$FORGE_JOURNAL_FILE"
    16	}
    17	
    18	init_journal() {
    19	    mkdir -p "$FORGE_JOURNAL_DIR"
    20	}
    21	
    22	# Escape a string for JSON.  Backslash first, then double quotes and
    23	# control characters.  Bash metadata is not expected to contain quotes or
    24	# backslashes, but this keeps the journal robust.
    25	journal_json_escape() {
    26	    local s="$1"
    27	    s="${s//\\/\\\\}"
    28	    s="${s//\"/\\\"}"
    29	    s="${s//$'\\t'/\\t}"
    30	    s="${s//$'\\n'/\\n}"
    31	    s="${s//$'\\r'/\\r}"
    32	    printf '%s' "$s"
    33	}
    34	
    35	# Append a single JSON event.  Fields:
    36	# timestamp event package profile duration_ms cache_hit trigger
    37	journal_append_event() {
    38	    local event="$1" pkg="$2" profile="${3:-release}" duration_ms="${4:-0}" cache_hit="${5:-false}" trigger="${6:-manual}"
    39	    init_journal
    40	    local ts
    41	    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    42	    local pkg_esc
    43	    pkg_esc="$(journal_json_escape "$pkg")"
    44	    local line
    45	    line="{\"timestamp\":\"${ts}\",\"event\":\"${event}\",\"package\":\"${pkg_esc}\",\"profile\":\"${profile}\",\"duration_ms\":${duration_ms},\"cache_hit\":${cache_hit},\"trigger\":\"${trigger}\"}"
    46	    (
    47	        flock 9
    48	        printf '%s\n' "$line" >> "$FORGE_JOURNAL_FILE"
    49	    ) 9>>"$FORGE_JOURNAL_DIR/.lock"
    50	}
    51	
    52	# Determine the trigger for an actual build.  Priority order:
