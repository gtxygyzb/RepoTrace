     2	# Common utilities for ForgeKit
     3	
     4	log_info() {
     5	    echo "[FORGE INFO] $*" >&2
     6	}
     7	
     8	log_warn() {
     9	    echo "[FORGE WARN] $*" >&2
    10	}
    11	
    12	log_error() {
    13	    echo "[FORGE ERROR] $*" >&2
    14	}
    15	
    16	# Get the absolute path to a package directory
    17	get_package_dir() {
    18	    local name="$1"
    19	    echo "$FORGE_ROOT/packages/$name"
    20	}
    21	
    22	# Get the absolute path to a package manifest
    23	get_package_manifest() {
    24	    local name="$1"
    25	    echo "$FORGE_ROOT/packages/$name/package.forge"
    26	}
    27	
    28	# List all package names (directories under packages/ with a manifest)
    29	list_package_names() {
    30	    local pkg_dir
    31	    for pkg_dir in "$FORGE_ROOT/packages"/*/; do
    32	        if [[ -f "$pkg_dir/package.forge" ]]; then
    33	            basename "$pkg_dir"
    34	        fi
    35	    done
    36	}
    37	
    38	# Display formatted package listing
    39	list_packages() {
    40	    local name version type deps
    41	    printf "%-25s %-10s %-10s %s\n" "NAME" "VERSION" "TYPE" "DEPENDENCIES"
    42	    printf "%-25s %-10s %-10s %s\n" "----" "-------" "----" "------------"
    43	    for pkg_name in $(list_package_names); do
    44	        parse_manifest "$pkg_name"
    45	        name="${MANIFEST_name:-$pkg_name}"
    46	        version="${MANIFEST_version:-unknown}"
    47	        type="${MANIFEST_type:-unknown}"
    48	        deps="${MANIFEST_deps:-none}"
    49	        printf "%-25s %-10s %-10s %s\n" "$name" "$version" "$type" "$deps"
    50	    done
    51	}
    52	
    53	# Clean build artifacts for a package.  A profile argument scopes the
    54	# cleanup to build/<profile>; without it, release is cleaned.  Object
    55	# files under src are removed for the selected profile's build tree.
    56	clean_package() {
    57	    local name="$1"
    58	    local profile
    59	    profile="${2:-release}"
    60	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
    61	        log_error "Invalid profile: $profile"
    62	        return 1
    63	    fi
    64	    local pkg_dir
    65	    pkg_dir=$(get_package_dir "$name")
    66	    if [[ -d "$pkg_dir/build/$profile" ]]; then
    67	        rm -rf "$pkg_dir/build/$profile"
    68	        log_info "Cleaned $name ($profile)"
    69	    fi
    70	    if [[ -d "$pkg_dir/build" ]] && [[ -z "$(find "$pkg_dir/build" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
    71	        rmdir "$pkg_dir/build" 2>/dev/null || true
    72	    fi
    73	    find "$pkg_dir/src" -name "*.o" -delete 2>/dev/null || true
    74	}
