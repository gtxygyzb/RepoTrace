     2	# ForgeKit - Legacy Build Automation System
     3	# Main CLI entry point
     4	
     5	FORGE_ROOT="$(cd "$(dirname "$0")" && pwd)"
     6	export FORGE_ROOT
     7	
     8	# Source library modules
     9	source "$FORGE_ROOT/lib/common.sh"
    10	source "$FORGE_ROOT/lib/manifest.sh"
    11	source "$FORGE_ROOT/lib/depgraph.sh"
    12	source "$FORGE_ROOT/lib/builder.sh"
    13	source "$FORGE_ROOT/lib/cache.sh"
    14	source "$FORGE_ROOT/lib/artifact.sh"
    15	source "$FORGE_ROOT/lib/reporter.sh"
    16	source "$FORGE_ROOT/lib/configgen.sh"
    17	source "$FORGE_ROOT/lib/journal.sh"
    18	
    19	# Load global config
    20	if [[ -f "$FORGE_ROOT/config/forge.conf" ]]; then
    21	    source "$FORGE_ROOT/config/forge.conf"
    22	fi
    23	
    24	usage() {
    25	    cat <<'EOF'
    26	Usage: forge <command> [options]
    27	
    28	Commands:
    29	  build [--all|--package NAME|--changed] [-j N] [--profile debug|release]
    30	  test  [--all|--package NAME] [--profile debug|release]
    31	  list
    32	  deps  NAME
    33	  deps  --why NAME NAME
    34	  impact NAME
    35	  report
    36	  config generate ENV
    37	  artifact pack NAME [--profile debug|release]
    38	  clean [--all|--package NAME] [--profile debug|release]
    39	  graph [--reverse NAME]
    40	EOF
    41	}
    42	
    43	validate_profile() {
    44	    local profile="${1:-release}"
    45	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
    46	        log_error "Invalid profile: $profile (expected debug or release)"
    47	        return 1
    48	    fi
    49	    return 0
    50	}
    51	
    52	cmd_build() {
    53	    local target="" pkg="" jobs=1 profile="release"
    54	    while [[ $# -gt 0 ]]; do
    55	        case "$1" in
    56	            --all) target="all" ;;
    57	            --changed) target="changed" ;;
    58	            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;
    59	            -j) if [[ $# -lt 2 ]]; then usage; return 1; fi; jobs="$2"; shift ;;
    60	            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
    61	            *) usage; return 1 ;;
    62	        esac
    63	        shift
    64	    done
    65	
    66	    validate_profile "$profile" || return 1
