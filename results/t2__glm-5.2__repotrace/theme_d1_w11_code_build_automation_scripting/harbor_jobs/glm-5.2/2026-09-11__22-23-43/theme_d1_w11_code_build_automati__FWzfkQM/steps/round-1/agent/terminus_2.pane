    39	    local hashes="" hash
    40	    local file
    41	
    42	    while IFS= read -r -d '' file; do
    43	        hash=$(_file_sha256 "$file")
    44	        [[ -n "$hash" ]] && hashes+="$hash\n"
    45	    done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)
    46	
    47	    hash=$(_file_sha256 "$pkg_dir/Makefile")
    48	    [[ -n "$hash" ]] && hashes+="$hash\n"
