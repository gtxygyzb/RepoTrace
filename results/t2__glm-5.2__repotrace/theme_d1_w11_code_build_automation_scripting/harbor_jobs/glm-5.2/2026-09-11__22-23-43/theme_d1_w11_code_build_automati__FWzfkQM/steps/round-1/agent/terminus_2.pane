[?2004l[?2004h> #   - it has no cache stamp
[?2004l[?2004h> #   - its own sources/Makefile are newer than its cache stamp
[?2004l[?2004h> #   - any transitive dependency has no cache stamp
[?2004l[?2004h> #   - any transitive dependency has a cache stamp newer than this package's
[?2004ll[?2004h> is_cache_valid() {
[?2004l[?2004h>     local pkg_name="$1"
