    71	    local cache_file="$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"
    72	
    73	    if [[ ! -f "$cache_file" ]]; then
    74	        return 1  # No cache -> rebuild
    75	    fi
    76	
    77	    local cached_time
    78	    cached_time=$(cat "$cache_file" 2>/dev/null || echo 0)
    79	    if [[ ! "$cached_time" =~ ^[0-9]+$ ]]; then
    80	        return 1
    81	    fi
    82	
    83	    local src_mtime
    84	    src_mtime=$(get_src_mtime "$pkg_name")
    85	
    86	    if (( src_mtime > cached_time )); then
    87	        return 1  # Source newer than cache -> rebuild
