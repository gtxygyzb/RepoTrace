[?2004l[?2004h>         fi
[?2004l[?2004h>     done
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Display formatted package listing
[?2004lg"[?2004h> list_packages() {
[?2004l[?2004h>     local name version type deps
[?2004l[?2004h>     printf "%-25s %-10s %-10s %s\\n" "NAME" "VERSION" "TYPE" "DEPENDENCIES"
[?2004l[?2004h>     printf "%-25s %-10s %-10s %s\\n" "----" "-------" "----" "------------"
[?2004l[?2004h>     for pkg_name in $(list_package_names); do
