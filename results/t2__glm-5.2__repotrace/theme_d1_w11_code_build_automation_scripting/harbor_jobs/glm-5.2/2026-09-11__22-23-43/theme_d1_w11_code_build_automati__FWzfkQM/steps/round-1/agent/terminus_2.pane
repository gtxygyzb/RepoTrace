    55	# Build a single package
    56	build_package() {
    57	    local pkg_name="$1"
    58	    local profile="${2:-release}"
    59	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
    60	        log_error "Invalid profile: $profile"
    61	        return 1
    62	    fi
    63	    local pkg_dir
    64	    pkg_dir=$(get_package_dir "$pkg_name")
    65	
    66	    if [[ ! -d "$pkg_dir" ]]; then
    67	        log_error "Package directory not found: $pkg_dir"
    68	        return 1
    69	    fi
    70	
    71	    # Check cache
    72	    if is_cache_valid "$pkg_name" "$profile" 2>/dev/null; then
    73	        log_info "[$pkg_name] Up to date (cached)"
    74	        journal_append_event "build_skip" "$pkg_name" "$profile" 0 true manual
    75	        return 0
    76	    fi
    77	
    78	    local trigger
    79	    trigger="$(journal_build_trigger "$pkg_name" "$profile")"
    80	    journal_append_event "build_start" "$pkg_name" "$profile" 0 false "$trigger"
    81	
    82	    local start_ms end_ms duration_ms=0
    83	    start_ms="$(date +%s%3N 2>/dev/null)"
    84	    if [[ ! "$start_ms" =~ ^[0-9]+$ ]]; then
    85	        start_ms=$(( $(date +%s) * 1000 ))
    86	    fi
    87	
    88	    log_info "[$pkg_name] Building..."
    89	
    90	    # Parse manifest for build command
    91	    parse_manifest "$pkg_name"
    92	    local build_cmd="${MANIFEST_command:-make}"
    93	    case "$build_cmd" in
    94	        *make*) build_cmd="$build_cmd BUILD_DIR=build/${profile}" ;;
    95	    esac
    96	
    97	    # Set up build environment
    98	    if ! setup_build_env "$pkg_name" "$profile"; then
    99	        log_error "[$pkg_name] Failed to set up build environment"
   100	        end_ms="$(date +%s%3N 2>/dev/null)"
   101	        if [[ ! "$end_ms" =~ ^[0-9]+$ ]]; then
   102	            end_ms=$(( $(date +%s) * 1000 ))
   103	        fi
   104	        duration_ms=$(( end_ms - start_ms ))
   105	        journal_append_event "build_fail" "$pkg_name" "$profile" "$duration_ms" false "$trigger"
   106	        return 1
   107	    fi
   108	
   109	    # Execute build
   110	    if ! (cd "$pkg_dir" && BUILD_DIR="build/${profile}" eval "$build_cmd" 2>&1); then
   111	        log_error "[$pkg_name] Build failed"
   112	        end_ms="$(date +%s%3N 2>/dev/null)"
   113	        if [[ ! "$end_ms" =~ ^[0-9]+$ ]]; then
   114	            end_ms=$(( $(date +%s) * 1000 ))
   115	        fi
   116	        duration_ms=$(( end_ms - start_ms ))
   117	        journal_append_event "build_fail" "$pkg_name" "$profile" "$duration_ms" false "$trigger"
   118	        return 1
   119	    fi
   120	
   121	    # Update cache
   122	    update_cache "$pkg_name" "$profile"
   123	
   124	    end_ms="$(date +%s%3N 2>/dev/null)"
   125	    if [[ ! "$end_ms" =~ ^[0-9]+$ ]]; then
   126	        end_ms=$(( $(date +%s) * 1000 ))
   127	    fi
   128	    duration_ms=$(( end_ms - start_ms ))
   129	    journal_append_event "build_complete" "$pkg_name" "$profile" "$duration_ms" false "$trigger"
   130	
   131	    log_info "[$pkg_name] Build successful"
   132	    return 0
   133	}
