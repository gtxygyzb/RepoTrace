    94	        log_error "[$pkg_name] Build failed"
    95	        return 1
    96	    fi
    97	
    98	    # Update cache
    99	    update_cache "$pkg_name" "$profile"
   100	
   101	    log_info "[$pkg_name] Build successful"
   102	    return 0
   103	}
