    with integrity verification \
    and crash recovery support
tags = storage,persistence,\
    kv,transactions
===== packages/libstore/src/store.c =====
#include "store.h"
#include <string.h>

static unsigned int _bucket(const char *key) {
    unsigned long h = 5381;
    int c;
    while ((c = (unsigned char)*key++))
        h = h * 33 + (unsigned long)c;
    return (unsigned int)(h % STORE_MAX_ENTRIES);
}

void store_init(store_t *s) {
    memset(s, 0, sizeof(*s));
}

int store_put(store_t *s, const char *key, const char *value) {
    unsigned int idx = _bucket(key);
    unsigned int start = idx;
    do {
        if (!s->entries[idx].occupied ||
            strcmp(s->entries[idx].key, key) == 0) {
            strncpy(s->entries[idx].key, key, STORE_KEY_LEN - 1);
            s->entries[idx].key[STORE_KEY_LEN - 1] = '\0';
            strncpy(s->entries[idx].value, value, STORE_VAL_LEN - 1);
            s->entries[idx].value[STORE_VAL_LEN - 1] = '\0';
            if (!s->entries[idx].occupied) {
                s->entries[idx].occupied = 1;
                s->count++;
            }
            return 0;
        }
        idx = (idx + 1) % STORE_MAX_ENTRIES;
    } while (idx != start);
    return -1; /* full */
}

const char *store_get(store_t *s, const char *key) {
    unsigned int idx = _bucket(key);
    unsigned int start = idx;
    do {
        if (!s->entries[idx].occupied) return NULL;
        if (strcmp(s->entries[idx].key, key) == 0)
            return s->entries[idx].value;
        idx = (idx + 1) % STORE_MAX_ENTRIES;
    } while (idx != start);
    return NULL;
}

int store_delete(store_t *s, const char *key) {
    unsigned int idx = _bucket(key);
    unsigned int start = idx;
    do {
        if (!s->entries[idx].occupied) return -1;
        if (strcmp(s->entries[idx].key, key) == 0) {
            s->entries[idx].occupied = 0;
            s->count--;
            return 0;
        }
        idx = (idx + 1) % STORE_MAX_ENTRIES;
    } while (idx != start);
    return -1;
}

int store_count(store_t *s) {
    return s->count;
}
===== packages/libstore/src/store.h =====
#ifndef STORE_H
#define STORE_H

#define STORE_MAX_ENTRIES 256
#define STORE_KEY_LEN     64
#define STORE_VAL_LEN     256

typedef struct {
    char key[STORE_KEY_LEN];
    char value[STORE_VAL_LEN];
    int  occupied;
} store_entry_t;

typedef struct {
    store_entry_t entries[STORE_MAX_ENTRIES];
    int count;
} store_t;

void store_init(store_t *s);
int  store_put(store_t *s, const char *key, const char *value);
const char *store_get(store_t *s, const char *key);
int  store_delete(store_t *s, const char *key);
int  store_count(store_t *s);

#endif /* STORE_H */
