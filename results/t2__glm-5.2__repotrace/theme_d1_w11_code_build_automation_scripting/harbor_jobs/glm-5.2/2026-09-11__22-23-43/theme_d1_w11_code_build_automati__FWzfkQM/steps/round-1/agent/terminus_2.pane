   270	                                    fi
   271	                                done
   272	                            fi
   273	                        fi
   274	                    done
   275	                else
   276	                    state[$pkg]=failed
   277	                    failed_pkg[$pkg]=1
   278	                    failed=1
   279	                fi
   280	            fi
