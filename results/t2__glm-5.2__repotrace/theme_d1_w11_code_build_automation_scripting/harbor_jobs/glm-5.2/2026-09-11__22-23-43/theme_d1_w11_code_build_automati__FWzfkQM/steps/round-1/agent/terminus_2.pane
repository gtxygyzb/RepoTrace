     2	# ForgeKit Internal Test Suite
     3	#
     4	# Tests for the forge build automation system itself.
     5	# Run with: bash tests/run_tests.sh
     6	
     7	FORGE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
     8	export FORGE_ROOT
     9	
    10	source "$FORGE_ROOT/lib/common.sh"
    11	source "$FORGE_ROOT/lib/manifest.sh"
    12	source "$FORGE_ROOT/lib/depgraph.sh"
    13	source "$FORGE_ROOT/lib/builder.sh"
    14	source "$FORGE_ROOT/lib/cache.sh"
    15	source "$FORGE_ROOT/lib/artifact.sh"
