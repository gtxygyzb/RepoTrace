   108	                if [[ $# -lt 2 ]]; then
   109	                    log_error "--package requires a name"
   110	                    return 1
   111	                fi
   112	                pkg_filter="$2"
   113	                shift
   114	                ;;
   115	            --profile)
   116	                if [[ $# -lt 2 ]]; then
   117	                    log_error "--profile requires a name"
   118	                    return 1
   119	                fi
   120	                profile_filter="$2"
   121	                shift
