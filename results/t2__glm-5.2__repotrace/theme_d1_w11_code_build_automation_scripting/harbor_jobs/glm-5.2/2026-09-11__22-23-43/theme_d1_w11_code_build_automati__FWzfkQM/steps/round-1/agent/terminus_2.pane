    19	TOTAL=0
    20	PASSED=0
    21	FAILED=0
    22	
    23	assert_eq() {
    24	    local desc="$1" expected="$2" actual="$3"
    25	    ((TOTAL++))
    26	    if [[ "$expected" == "$actual" ]]; then
    27	        echo "  PASS: $desc"
    28	        ((PASSED++))
    29	    else
    30	        echo "  FAIL: $desc"
    31	        echo "    expected: '$expected'"
    32	        echo "    actual:   '$actual'"
    33	        ((FAILED++))
    34	    fi
    35	}
    36	
    37	assert_contains() {
    38	    local desc="$1" haystack="$2" needle="$3"
    39	    ((TOTAL++))
    40	    if [[ "$haystack" == *"$needle"* ]]; then
    41	        echo "  PASS: $desc"
    42	        ((PASSED++))
    43	    else
    44	        echo "  FAIL: $desc"
    45	        echo "    expected to contain: '$needle'"
    46	        echo "    in: '$haystack'"
    47	        ((FAILED++))
    48	    fi
    49	}
    50	
    51	assert_not_contains() {
    52	    local desc="$1" haystack="$2" needle="$3"
    53	    ((TOTAL++))
    54	    if [[ "$haystack" != *"$needle"* ]]; then
    55	        echo "  PASS: $desc"
    56	        ((PASSED++))
    57	    else
    58	        echo "  FAIL: $desc"
    59	        echo "    expected NOT to contain: '$needle'"
    60	        echo "    in: '$haystack'"
    61	        ((FAILED++))
    62	    fi
    63	}
    64	
    65	assert_exit_zero() {
    66	    local desc="$1"
    67	    shift
    68	    ((TOTAL++))
    69	    if "$@" > /dev/null 2>&1; then
    70	        echo "  PASS: $desc"
    71	        ((PASSED++))
    72	    else
    73	        echo "  FAIL: $desc (exit code: $?)"
    74	        ((FAILED++))
    75	    fi
    76	}
    77	
    78	assert_exit_nonzero() {
    79	    local desc="$1"
    80	    shift
    81	    ((TOTAL++))
    82	    if "$@" > /dev/null 2>&1; then
    83	        echo "  FAIL: $desc (expected failure but got success)"
    84	        ((FAILED++))
    85	    else
    86	        echo "  PASS: $desc"
    87	        ((PASSED++))
    88	    fi
    89	}
