[?2004l#!/bin/bash
# ForgeKit Internal Test Suite
#
# Tests for the forge build automation system itself.
# Run with: bash tests/run_tests.sh

FORGE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export FORGE_ROOT

source "$FORGE_ROOT/lib/common.sh"
source "$FORGE_ROOT/lib/manifest.sh"
source "$FORGE_ROOT/lib/depgraph.sh"
source "$FORGE_ROOT/lib/builder.sh"
source "$FORGE_ROOT/lib/cache.sh"
source "$FORGE_ROOT/lib/artifact.sh"
source "$FORGE_ROOT/lib/reporter.sh"
source "$FORGE_ROOT/lib/configgen.sh"

TOTAL=0
PASSED=0
FAILED=0

assert_eq() {
    local desc="$1" expected="$2" actual="$3"
    ((TOTAL++))
    if [[ "$expected" == "$actual" ]]; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc"
        echo "    expected: '$expected'"
        echo "    actual:   '$actual'"
        ((FAILED++))
    fi
}

assert_contains() {
    local desc="$1" haystack="$2" needle="$3"
    ((TOTAL++))
    if [[ "$haystack" == *"$needle"* ]]; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc"
        echo "    expected to contain: '$needle'"
        echo "    in: '$haystack'"
        ((FAILED++))
    fi
}

assert_not_contains() {
    local desc="$1" haystack="$2" needle="$3"
    ((TOTAL++))
    if [[ "$haystack" != *"$needle"* ]]; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc"
        echo "    expected NOT to contain: '$needle'"
        echo "    in: '$haystack'"
        ((FAILED++))
    fi
}

assert_exit_zero() {
    local desc="$1"
    shift
    ((TOTAL++))
    if "$@" > /dev/null 2>&1; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc (exit code: $?)"
        ((FAILED++))
    fi
}

assert_exit_nonzero() {
    local desc="$1"
    shift
    ((TOTAL++))
    if "$@" > /dev/null 2>&1; then
        echo "  FAIL: $desc (expected failure but got success)"
        ((FAILED++))
    else
        echo "  PASS: $desc"
        ((PASSED++))
    fi
}

assert_grep() {
    local desc="$1" text="$2" pattern="$3"
    ((TOTAL++))
    if echo "$text" | grep -q "$pattern"; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc"
        echo "    expected to match: '$pattern'"
        echo "    in: '$text'"
        ((FAILED++))
    fi
}

with_forge_root() {
    local root="$1"
    shift
    FORGE_ROOT="$root" "$@"
}

# ==================================================================
echo ""
echo "=== Manifest Parser Tests ==="

parse_manifest "libbase"
assert_eq "libbase name" "libbase" "${MANIFEST_name:-}"
assert_eq "libbase version" "1.0.0" "${MANIFEST_version:-}"
assert_eq "libbase type" "library" "${MANIFEST_type:-}"
assert_eq "libbase has no deps" "" "${MANIFEST_deps:-}"

[?2004hroot@n30009:/app# sed -n '120,260p' tests/run_tests.sh
[?2004l
parse_manifest "libcrypto"
assert_eq "libcrypto deps" "libbase" "${MANIFEST_deps:-}"

parse_manifest "svc-auth"
assert_eq "svc-auth type" "service" "${MANIFEST_type:-}"
assert_eq "svc-auth deps" "libcrypto,libstore" "${MANIFEST_deps:-}"

assert_exit_nonzero "missing manifest errors" parse_manifest no-such-package

tmp_manifest_root=$(mktemp -d)
mkdir -p "$tmp_manifest_root/packages/pkg-cont"
cat > "$tmp_manifest_root/packages/pkg-cont/package.forge" <<'MANIFEST'
[package]
name = pkg-cont
version = 1.0.0
type = library

description = first part \
              second part
tags = one,two,three
notes = value # inline comment
empty =
MANIFEST

with_forge_root "$tmp_manifest_root" parse_manifest "pkg-cont"
assert_eq "continuation name" "pkg-cont" "${MANIFEST_name:-}"
assert_eq "continuation version" "1.0.0" "${MANIFEST_version:-}"
assert_eq "continuation joined value" "first part second part" "${MANIFEST_description:-}"
assert_eq "continuation preserves normal value" "one,two,three" "${MANIFEST_tags:-}"
assert_eq "inline comment stripped" "value" "${MANIFEST_notes:-}"
assert_eq "empty value parsed" "" "${MANIFEST_empty:-}"
rm -rf "$tmp_manifest_root"

# ==================================================================
echo ""
echo "=== Dependency Graph Tests ==="

build_dep_map
order=$(resolve_build_order)
pkg_count=$(echo "$order" | wc -w)
assert_eq "build order has 8 packages" "8" "$pkg_count"

assert_contains "order contains libbase" "$order" "libbase"
assert_contains "order contains svc-scheduler" "$order" "svc-scheduler"

position() {
    local target="$1" i=0
    for pkg in $order; do
        ((i++))
        [[ "$pkg" == "$target" ]] && { echo "$i"; return; }
    done
    echo 0
}

libbase_pos=$(position libbase)
libcrypto_pos=$(position libcrypto)
libstore_pos=$(position libstore)
libnet_pos=$(position libnet)
svc_auth_pos=$(position svc-auth)
svc_scheduler_pos=$(position svc-scheduler)

assert_eq "libbase before libcrypto" "1" "$(( libbase_pos < libcrypto_pos ? 1 : 0 ))"
assert_eq "libbase before libstore" "1" "$(( libbase_pos < libstore_pos ? 1 : 0 ))"
assert_eq "libcrypto before libstore" "1" "$(( libcrypto_pos < libstore_pos ? 1 : 0 ))"
assert_eq "libbase before libnet" "1" "$(( libbase_pos < libnet_pos ? 1 : 0 ))"
assert_eq "libstore before svc-auth" "1" "$(( libstore_pos < svc_auth_pos ? 1 : 0 ))"
assert_eq "libnet before svc-scheduler" "1" "$(( libnet_pos < svc_scheduler_pos ? 1 : 0 ))"

deps_for_auth=$(resolve_deps_for "svc-auth")
assert_contains "svc-auth deps include libcrypto" "$deps_for_auth" "libcrypto"
assert_contains "svc-auth deps include libstore" "$deps_for_auth" "libstore"
assert_contains "svc-auth deps include transitive libbase" "$deps_for_auth" "libbase"
assert_contains "svc-auth deps include itself" "$deps_for_auth" "svc-auth"
assert_eq "svc-auth chain has 4 packages" "4" "$(echo "$deps_for_auth" | wc -w)"

assert_eq "libbase no-dependency chain" "libbase" "$(resolve_deps_for libbase)"

all_deps=$(get_all_deps svc-scheduler)
assert_contains "all deps includes libbase" "$all_deps" "libbase"
assert_contains "all deps includes libcrypto" "$all_deps" "libcrypto"
assert_contains "all deps includes libnet" "$all_deps" "libnet"
assert_contains "all deps includes libstore" "$all_deps" "libstore"
assert_not_contains "all deps excludes package itself" "$all_deps" "svc-scheduler"

# Cycle detection
tmp_cycle_root=$(mktemp -d)
mkdir -p "$tmp_cycle_root/packages/cyc-a" "$tmp_cycle_root/packages/cyc-b"
cat > "$tmp_cycle_root/packages/cyc-a/package.forge" <<'MANIFEST'
[package]
name = cyc-a
version = 1.0.0
type = library

[deps]
deps = cyc-b
MANIFEST
cat > "$tmp_cycle_root/packages/cyc-b/package.forge" <<'MANIFEST'
[package]
name = cyc-b
version = 1.0.0
type = library

[deps]
deps = cyc-a
MANIFEST

cycle_err=$(with_forge_root "$tmp_cycle_root" resolve_build_order 2>&1 >/dev/null) || true
assert_contains "cycle error mentions cyc-a" "$cycle_err" "cyc-a"
assert_contains "cycle error mentions cyc-b" "$cycle_err" "cyc-b"
assert_contains "cycle error says circular" "$cycle_err" "Circular dependency detected"
assert_exit_nonzero "resolve_deps_for cycle fails" with_forge_root "$tmp_cycle_root" resolve_deps_for cyc-a
rm -rf "$tmp_cycle_root"

# Unknown dependency
tmp_unknown_root=$(mktemp -d)
mkdir -p "$tmp_unknown_root/packages/pkg-x"
cat > "$tmp_unknown_root/packages/pkg-x/package.forge" <<'MANIFEST'
[package]
name = pkg-x
version = 1.0.0
type = library

[deps]
deps = missing-dep
MANIFEST

unknown_err=$(with_forge_root "$tmp_unknown_root" resolve_build_order 2>&1 >/dev/null) || true
assert_contains "unknown dep error names missing package" "$unknown_err" "missing-dep"
assert_exit_nonzero "resolve_deps_for unknown dep fails" with_forge_root "$tmp_unknown_root" resolve_deps_for pkg-x
rm -rf "$tmp_unknown_root"

# Reset dep map after temporary root tests
build_dep_map

# ==================================================================
echo ""
echo "=== Cache Tests ==="

clean_cache
assert_exit_nonzero "cache invalid for unbuilt pkg" is_cache_valid libbase
