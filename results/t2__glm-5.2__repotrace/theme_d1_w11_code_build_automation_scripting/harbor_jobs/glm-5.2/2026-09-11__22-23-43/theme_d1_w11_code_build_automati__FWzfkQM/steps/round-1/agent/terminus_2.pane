   226	    done
   227	
   228	    local total=0
   229	    for pkg in $order; do total=$(( total + 1 )); done
   230	    local finished=0 active=0 failed=0
   231	
   232	    local tmpdir
   233	    tmpdir=$(mktemp -d)
   234	
