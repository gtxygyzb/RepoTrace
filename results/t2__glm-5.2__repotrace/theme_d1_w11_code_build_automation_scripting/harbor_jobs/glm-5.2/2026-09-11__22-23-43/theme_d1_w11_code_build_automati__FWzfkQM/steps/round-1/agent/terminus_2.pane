    16	# Get the absolute path to a package directory
    17	get_package_dir() {
    18	    local name="$1"
    19	    echo "$FORGE_ROOT/packages/$name"
    20	}
    21	
    22	# Get the absolute path to a package manifest
    23	get_package_manifest() {
    24	    local name="$1"
    25	    echo "$FORGE_ROOT/packages/$name/package.forge"
    26	}
    27	
    28	# List all package names (directories under packages/ with a manifest)
    29	list_package_names() {
    30	    local pkg_dir
    31	    for pkg_dir in "$FORGE_ROOT/packages"/*/; do
    32	        if [[ -f "$pkg_dir/package.forge" ]]; then
    33	            basename "$pkg_dir"
    34	        fi
    35	    done
    36	}
    37	
    38	# Display formatted package listing
    39	list_packages() {
    40	    local name version type deps
    41	    printf "%-25s %-10s %-10s %s\n" "NAME" "VERSION" "TYPE" "DEPENDENCIES"
    42	    printf "%-25s %-10s %-10s %s\n" "----" "-------" "----" "------------"
    43	    for pkg_name in $(list_package_names); do
    44	        parse_manifest "$pkg_name"
    45	        name="${MANIFEST_name:-$pkg_name}"
    46	        version="${MANIFEST_version:-unknown}"
    47	        type="${MANIFEST_type:-unknown}"
    48	        deps="${MANIFEST_deps:-none}"
    49	        printf "%-25s %-10s %-10s %s\n" "$name" "$version" "$type" "$deps"
    50	    done
    51	}
    52	
    53	# Clean build artifacts for a package.  When a profile is supplied, only
    54	# build/<profile>/ is removed and other profiles are left intact.  When no
    55	# profile is supplied, the entire build/ directory is removed, matching the
    56	# existing clean behavior.  Object files associated with the selected scope
    57	# are also removed.
    58	clean_package() {
    59	    local name="$1"
    60	    local profile="${2:-}"
    61	    if [[ -n "$profile" && "$profile" != "debug" && "$profile" != "release" ]]; then
    62	        log_error "Invalid profile: $profile"
    63	        return 1
    64	    fi
    65	    local pkg_dir
    66	    pkg_dir=$(get_package_dir "$name")
    67	
    68	    if [[ -z "$profile" ]]; then
    69	        if [[ -d "$pkg_dir/build" ]]; then
    70	            rm -rf "$pkg_dir/build"
    71	            log_info "Cleaned $name (all profiles)"
    72	        fi
    73	        find "$pkg_dir/src" -name "*.o" -delete 2>/dev/null || true
    74	        return 0
    75	    fi
    76	
    77	    if [[ -d "$pkg_dir/build/$profile" ]]; then
    78	        rm -rf "$pkg_dir/build/$profile"
    79	        log_info "Cleaned $name ($profile)"
    80	    fi
    81	    if [[ -d "$pkg_dir/build" ]] && [[ -z "$(find "$pkg_dir/build" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
    82	        rmdir "$pkg_dir/build" 2>/dev/null || true
    83	    fi
    84	
    85	    # Remove object files for the selected profile.  Makefile builds store
    86	    # objects under build/<profile>; this also handles legacy src-based *.o
    87	    # layouts that encode the profile in the filename or path.
    88	    find "$pkg_dir/src" -name "*.${profile}.o" -delete 2>/dev/null || true
    89	    find "$pkg_dir/src" -path "*/$profile/*" -name "*.o" -delete 2>/dev/null || true
    90	}
