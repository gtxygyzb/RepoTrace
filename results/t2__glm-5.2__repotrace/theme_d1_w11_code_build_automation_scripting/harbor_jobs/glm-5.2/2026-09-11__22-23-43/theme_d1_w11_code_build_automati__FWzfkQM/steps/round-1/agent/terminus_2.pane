    test)     cmd_test "$@" ;;
    list)     cmd_list ;;
    deps)     cmd_deps "$@" ;;
    report)   cmd_report ;;
    config)   cmd_config "$@" ;;
    artifact) cmd_artifact "$@" ;;
    clean)    cmd_clean "$@" ;;
    graph)    cmd_graph "$@" ;;
    *)        usage; exit 1 ;;
esac
