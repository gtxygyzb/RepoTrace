cmd_list() {
    list_packages
}

cmd_deps() {
    if [[ $# -lt 1 ]]; then usage; return 1; fi
    if [[ "$1" == "--why" ]]; then
        if [[ $# -lt 3 ]]; then usage; return 1; fi
        shortest_dep_path "$2" "$3"
        return $?
    fi
    show_dep_tree "$1"
}

cmd_impact() {
    if [[ $# -lt 1 ]]; then usage; return 1; fi
    impact_package "$1"
}

cmd_report() {
    generate_report
}

cmd_config() {
    if [[ $# -lt 2 || "$1" != "generate" ]]; then usage; return 1; fi
    generate_config "$2"
}

cmd_artifact() {
    if [[ $# -lt 2 || "$1" != "pack" ]]; then usage; return 1; fi
[?2004hroot@n30009:/app# sed -n '196,225p' forge
[?2004l    while [[ $# -gt 0 ]]; do
        case "$1" in
            --reverse) if [[ $# -lt 2 ]]; then log_error "--reverse requires a package name"; return 1; fi; reverse="$2"; shift ;;
            *) usage; return 1 ;;
        esac
        shift
    done

    if [[ -n "$reverse" ]]; then
        print_reverse_graph "$reverse"
    else
        print_graph
    fi
}

# Main dispatch
if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

command="$1"
shift

case "$command" in
    build)    cmd_build "$@" ;;
    test)     cmd_test "$@" ;;
    list)     cmd_list ;;
    deps)     cmd_deps "$@" ;;
    report)   cmd_report ;;
[?2004hroot@n30009:/app# sed -n '225,240p' forge
[?2004l    report)   cmd_report ;;
    config)   cmd_config "$@" ;;
    artifact) cmd_artifact "$@" ;;
    clean)    cmd_clean "$@" ;;
    graph)    cmd_graph "$@" ;;
    *)        usage; exit 1 ;;
esac
