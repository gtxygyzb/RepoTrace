   134	    return 0
   135	}
   136	
   137	_test_package_chain() {
   138	    local target="$1" profile="$2"
   139	    local order pkg
   140	    order=$(resolve_deps_for "$target") || return 1
   141	    for pkg in $order; do
   142	        build_package "$pkg" "$profile" || return 1
   143	    done
   144	}
