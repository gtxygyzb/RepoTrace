    36	# timestamp event package profile duration_ms cache_hit trigger
    37	journal_append_event() {
    38	    local event="$1" pkg="$2" profile="${3:-release}" duration_ms="${4:-0}" cache_hit="${5:-false}" trigger="${6:-manual}"
    39	    init_journal
    40	    local ts
    41	    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    42	    local pkg_esc
    43	    pkg_esc="$(journal_json_escape "$pkg")"
    44	    local line
    45	    line="{\"timestamp\":\"${ts}\",\"event\":\"${event}\",\"package\":\"${pkg_esc}\",\"profile\":\"${profile}\",\"duration_ms\":${duration_ms},\"cache_hit\":${cache_hit},\"trigger\":\"${trigger}\"}"
    46	    (
    47	        flock 9
    48	        printf '%s\n' "$line" >> "$FORGE_JOURNAL_FILE"
    49	    ) 9>>"$FORGE_JOURNAL_DIR/.lock"
    50	}
    51	
    52	# Determine the trigger for an actual build.  Priority order:
    53	# no_cache -> source_changed -> dep_changed -> manual.
    54	journal_build_trigger() {
    55	    local pkg="$1" profile="${2:-release}"
    56	    local cache_file="$FORGE_CACHE_DIR/${pkg}-${profile}.hash"
    57	    if [[ ! -f "$cache_file" ]]; then
    58	        echo "no_cache"
    59	        return 0
    60	    fi
    61	
    62	    local own_hash stored_hash
    63	    own_hash="$(compute_source_hash "$pkg" "$profile" 2>/dev/null)"
    64	    stored_hash="$(_stored_own_hash "$cache_file" 2>/dev/null)"
    65	    if [[ -z "$stored_hash" || "$own_hash" != "$stored_hash" ]]; then
    66	        echo "source_changed"
    67	        return 0
    68	    fi
    69	
    70	    local deps dep dep_hash stored_dep_hash
    71	    deps="$(get_all_deps "$pkg" 2>/dev/null)" || deps=""
    72	    for dep in $deps; do
    73	        [[ -z "$dep" ]] && continue
    74	        dep_hash="$(compute_source_hash "$dep" "$profile" 2>/dev/null)"
    75	        stored_dep_hash="$(_stored_dep_hash "$cache_file" "$dep" 2>/dev/null)"
    76	        if [[ -z "$stored_dep_hash" || "$dep_hash" != "$stored_dep_hash" ]]; then
    77	            echo "dep_changed"
    78	            return 0
    79	        fi
    80	    done
    81	
    82	    echo "manual"
    83	}
    84	
    85	# Print recent journal events with filters.
    86	journal_query() {
    87	    local last=50 pkg_filter="" profile_filter="" builds_only=false
    88	    while [[ $# -gt 0 ]]; do
    89	        case "$1" in
    90	            --last)
    91	                if [[ $# -lt 2 ]]; then
    92	                    log_error "--last requires a number"
    93	                    return 1
    94	                fi
    95	                last="$2"
    96	                shift
    97	                ;;
    98	            --package)
    99	                if [[ $# -lt 2 ]]; then
   100	                    log_error "--package requires a name"
   101	                    return 1
   102	                fi
   103	                pkg_filter="$2"
   104	                shift
   105	                ;;
   106	            --profile)
   107	                if [[ $# -lt 2 ]]; then
   108	                    log_error "--profile requires a name"
   109	                    return 1
   110	                fi
   111	                profile_filter="$2"
   112	                shift
   113	                ;;
   114	            --builds-only)
   115	                builds_only=true
   116	                ;;
   117	            *)
   118	                log_error "Unknown journal option: $1"
   119	                return 1
   120	                ;;
   121	        esac
   122	        shift
   123	    done
   124	
   125	    if [[ ! -f "$FORGE_JOURNAL_FILE" ]]; then
   126	        echo "No build events recorded."
   127	        return 0
   128	    fi
   129	
   130	    if [[ ! "$last" =~ ^[0-9]+$ ]] || (( last < 0 )); then
   131	        log_error "Invalid --last value: $last"
   132	        return 1
   133	    fi
   134	
   135	    local line event pkg profile duration_ms cache_hit detail
   136	    local printed=0
   137	    while IFS= read -r line; do
   138	        [[ -z "$line" ]] && continue
   139	        event="$(journal_field "$line" event)"
   140	        pkg="$(journal_field "$line" package)"
   141	        profile="$(journal_field "$line" profile)"
   142	
   143	        [[ -n "$pkg_filter" && "$pkg" != "$pkg_filter" ]] && continue
   144	        [[ -n "$profile_filter" && "$profile" != "$profile_filter" ]] && continue
   145	        if [[ "$builds_only" == true ]]; then
   146	            [[ "$event" != "build_complete" && "$event" != "build_fail" ]] && continue
   147	        fi
   148	
   149	        duration_ms="$(journal_field "$line" duration_ms)"
   150	        cache_hit="$(journal_field "$line" cache_hit)"
   151	        if [[ "$event" == "build_skip" || "$cache_hit" == "true" ]]; then
   152	            detail="(cached)"
   153	        else
   154	            detail="${duration_ms}ms"
   155	        fi
   156	
   157	        printf '%s  %-13s %-16s %s  %s\n' \
   158	            "$(journal_field "$line" timestamp)" "$event" "$pkg" "$profile" "$detail"
   159	        printed=$(( printed + 1 ))
   160	    done < <(tail -n "$last" "$FORGE_JOURNAL_FILE" 2>/dev/null)
   161	
   162	    if (( printed == 0 )); then
   163	        echo "No build events recorded."
   164	        return 0
   165	    fi
   166	}
   167	
   168	# Extract a field from a JSON object line.  This intentionally uses simple
   169	# text parsing to avoid depending on jq.
   170	journal_field() {
   171	    local json="$1" field="$2"
   172	    local value
   173	    value="$(printf '%s' "$json" | sed -n -E \
   174	        -e "s/.*\"${field}\":\"([^\"]*)\".*/\1/p" \
   175	        -e "s/.*\"${field}\":([^,}]*).*/\1/p")"
   176	    echo "$value"
   177	}
   178	
   179	# Truncate the journal file but keep the audit directory.
   180	journal_clear() {
   181	    init_journal
   182	    : > "$FORGE_JOURNAL_FILE"
   183	    [[ -f "$FORGE_JOURNAL_FILE" ]] || touch "$FORGE_JOURNAL_FILE"
   184	    log_info "Cleared build event journal"
   185	}
   186	
   187	# Return the duration_ms of the most recent build_complete/build_fail for
   188	# a package, or empty string if none exists.
   189	journal_last_build_duration() {
   190	    local pkg="$1"
   191	    [[ -f "$FORGE_JOURNAL_FILE" ]] || return 0
   192	    local line duration=""
   193	    while IFS= read -r line; do
   194	        [[ -z "$line" ]] && continue
   195	        local event pkg_field
   196	        event="$(journal_field "$line" event)"
   197	        pkg_field="$(journal_field "$line" package)"
   198	        if [[ "$pkg_field" == "$pkg" ]] && [[ "$event" == "build_complete" || "$event" == "build_fail" ]]; then
   199	            duration="$(journal_field "$line" duration_ms)"
   200	        fi
   201	    done < "$FORGE_JOURNAL_FILE"
   202	    echo "$duration"
   203	}
