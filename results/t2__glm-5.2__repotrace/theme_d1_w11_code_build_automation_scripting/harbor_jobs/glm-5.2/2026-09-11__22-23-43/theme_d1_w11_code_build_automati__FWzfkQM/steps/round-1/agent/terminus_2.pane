    28	    s="${s//\"/\\\"}"
    29	    s="${s//$'\\t'/\\t}"
    30	    s="${s//$'\\n'/\\n}"
    31	    s="${s//$'\\r'/\\r}"
    32	    printf '%s' "$s"
    33	}
