    53	# Clean build artifacts for a package.  When a profile is supplied, only
    54	# build/<profile>/ is removed and other profiles are left intact.  When no
    55	# profile is supplied, the entire build/ directory is removed, matching the
    56	# existing clean behavior.  Object files associated with the selected scope
    57	# are also removed.
    58	clean_package() {
