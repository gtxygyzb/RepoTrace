   236	        shift
   237	    done
   238	
   239	    if [[ -n "$reverse" ]]; then
   240	        print_reverse_graph "$reverse"
   241	    else
   242	        print_graph
   243	    fi
   244	}
   245	
   246	# Main dispatch
   247	if [[ $# -lt 1 ]]; then
   248	    usage
   249	    exit 1
   250	fi
   251	
   252	command="$1"
   253	shift
   254	
   255	case "$command" in
