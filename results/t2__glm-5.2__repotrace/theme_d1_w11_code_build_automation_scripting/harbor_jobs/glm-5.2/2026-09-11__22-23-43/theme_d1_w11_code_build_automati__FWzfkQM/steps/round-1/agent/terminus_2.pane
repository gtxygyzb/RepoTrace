   365	# Internal: schedule packages in dependency order with up to N workers.
   366	# Each package's output is buffered and printed under a header when it
   367	# finishes.  Existing concurrent builds continue on failure, but no new
   368	# packages are started after a failure.
   369	_run_parallel_build() {
   370	    local order="$1" jobs="${2:-1}" profile="${3:-release}"
   371	    jobs=$(( jobs < 1 ? 1 : jobs ))
   372	
   373	    declare -A remaining_deps state failed_pkg
   374	    declare -A active_pids
   375	    local pkg dep deps_str dep_count
   376	
   377	    for pkg in $order; do
   378	        deps_str="${DEP_MAP[$pkg]:-}"
   379	        dep_count=0
   380	        if [[ -n "$deps_str" ]]; then
   381	            local IFS=','
   382	            for dep in $deps_str; do
   383	                dep="${dep// /}"
   384	                [[ -z "$dep" ]] && continue
   385	                dep_count=$(( dep_count + 1 ))
   386	            done
   387	        fi
   388	        remaining_deps[$pkg]=$dep_count
   389	        state[$pkg]=pending
