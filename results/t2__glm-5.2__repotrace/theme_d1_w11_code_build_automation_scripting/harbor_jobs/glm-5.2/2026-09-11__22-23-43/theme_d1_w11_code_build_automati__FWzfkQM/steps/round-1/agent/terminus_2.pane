   715	# Internal: schedule packages in dependency order with up to N workers.
   716	# Each package's output is buffered and printed under a header when it
   717	# finishes.  Existing concurrent builds continue on failure, but no new
   718	# packages are started after a failure.
   719	_run_parallel_build() {
   720	    local order="$1" jobs="${2:-1}" profile="${3:-release}"
   721	    jobs=$(( jobs < 1 ? 1 : jobs ))
   722	
   723	    declare -A remaining_deps done_pkg failed_pkg
   724	    local pkg dep deps_str dep_count
   725	    for pkg in $order; do
   726	        deps_str="${DEP_MAP[$pkg]:-}"
   727	        dep_count=0
   728	        if [[ -n "$deps_str" ]]; then
   729	            local IFS=','
   730	            for dep in $deps_str; do
   731	                dep="${dep// /}"
   732	                [[ -z "$dep" ]] && continue
   733	                dep_count=$(( dep_count + 1 ))
   734	            done
   735	        fi
   736	        remaining_deps[$pkg]=$dep_count
   737	        done_pkg[$pkg]=0
   738	    done
   739	
   740	    local active=0 finished=0 total=0
   741	    for pkg in $order; do total=$(( total + 1 )); done
   742	
   743	    local tmpdir
   744	    tmpdir=$(mktemp -d)
   745	    trap 'rm -rf "$tmpdir"' RETURN
   746	
   747	    while (( finished < total )); do
   748	        local started=0
   749	        for pkg in $order; do
   750	            if (( done_pkg[$pkg] == 0 )) && (( remaining_deps[$pkg] == 0 )); then
   751	                if (( active >= jobs )); then
   752	                    break
   753	                fi
   754	
   755	                done_pkg[$pkg]=1
   756	                active=$(( active + 1 ))
   757	                started=$(( started + 1 ))
   758	
   759	                (
   760	                    {
   761	                        build_package "$pkg" "$profile"
   762	                        echo "__FORGE_BUILD_RC__$?"
   763	                    } > "$tmpdir/$pkg.out" 2>&1
   764	                ) &
   765	
   766	                if (( active >= jobs )); then
   767	                    break
   768	                fi
   769	            fi
   770	        done
   771	
   772	        if (( active == 0 )); then
   773	            if (( started == 0 )); then
   774	                break
   775	            fi
   776	        fi
   777	
   778	        wait -n 2>/dev/null || wait
   779	        active=$(( active - 1 ))
   780	
