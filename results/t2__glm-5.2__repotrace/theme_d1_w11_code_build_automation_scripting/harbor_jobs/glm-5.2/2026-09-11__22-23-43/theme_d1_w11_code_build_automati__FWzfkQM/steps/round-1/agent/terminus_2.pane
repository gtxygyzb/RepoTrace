    local _result=""

    _collect_deps() {
        local node="$1"
        local deps="${DEP_MAP[$node]:-}"
        if [[ -n "$deps" ]]; then
            local IFS=','
            for dep in $deps; do
                dep="${dep// /}"
                [[ -z "$dep" ]] && continue
                if [[ -z "${_seen[$dep]:-}" ]]; then
                    _seen[$dep]=1
                    _result="$_result $dep"
                    _collect_deps "$dep"
                fi
            done
        fi
    }

    _collect_deps "$name"
    echo "${_result# }"
}

