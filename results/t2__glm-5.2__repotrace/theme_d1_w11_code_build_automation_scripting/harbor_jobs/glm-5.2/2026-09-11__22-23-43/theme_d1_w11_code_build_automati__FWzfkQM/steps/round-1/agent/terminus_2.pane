     2	# Build executor for ForgeKit
     3	#
     4	# Builds packages by running their Makefile in the correct environment.
     5	
     6	# Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.
     7	# Includes include and library paths for the full transitive dependency
     8	# closure, not just direct dependencies.
     9	setup_build_env() {
    10	    local pkg_name="$1"
    11	    parse_manifest "$pkg_name"
    12	
    13	    local cflags=""
    14	    local ldflags=""
    15	    local libs=""
    16	    local deps
    17	
    18	    deps=$(get_all_deps "$pkg_name") || return 1
    19	
    20	    declare -A seen
    21	    local dep dep_dir
    22	    for dep in $deps; do
    23	        [[ -z "$dep" ]] && continue
    24	        [[ -n "${seen[$dep]:-}" ]] && continue
    25	        seen[$dep]=1
    26	
    27	        dep_dir=$(get_package_dir "$dep")
    28	        cflags="$cflags -I${dep_dir}/src"
    29	        ldflags="$ldflags -L${dep_dir}/build"
    30	
    31	        # For services linking against libraries
    32	        parse_manifest "$dep"
    33	        if [[ "${MANIFEST_type:-}" == "library" ]]; then
    34	            libs="$libs ${dep_dir}/build/${dep}.a"
    35	        fi
    36	    done
    37	
    38	    export FORGE_CFLAGS="$cflags"
    39	    export FORGE_LDFLAGS="$ldflags"
    40	    export FORGE_LIBS="$libs"
    41	}
