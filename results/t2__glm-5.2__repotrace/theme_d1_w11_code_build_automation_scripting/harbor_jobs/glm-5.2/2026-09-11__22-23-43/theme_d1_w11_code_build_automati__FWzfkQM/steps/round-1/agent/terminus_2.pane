    58	        echo "  FAIL: $desc"
    59	        echo "    expected NOT to contain: '$needle'"
    60	        echo "    in: '$haystack'"
    61	        ((FAILED++))
    62	    fi
    63	}
    64	
    65	assert_exit_zero() {
