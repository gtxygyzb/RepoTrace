   298	get_affected_packages() {
   299	    if [[ -z "${DEP_MAP[*]+_}" ]]; then
   300	        build_dep_map
   301	    fi
   302	
   303	    declare -A seen
   304	    local result=""
   305	    local target rev r
   306	
   307	    for target in "$@"; do
   308	        if [[ -z "${DEP_MAP[$target]+_}" ]]; then
   309	            log_error "Unknown package: $target"
   310	            return 1
   311	        fi
   312	        if [[ -z "${seen[$target]:-}" ]]; then
   313	            seen[$target]=1
   314	            result="$result $target"
   315	        fi
   316	        rev=$(get_all_reverse_deps "$target") || return 1
   317	        for r in $rev; do
   318	            [[ -z "$r" ]] && continue
   319	            if [[ -z "${seen[$r]:-}" ]]; then
   320	                seen[$r]=1
   321	                result="$result $r"
   322	            fi
   323	        done
   324	    done
   325	
   326	    echo "${result# }"
   327	}
   328	
   329	# Topologically sort a subset of packages.
   330	# Dependencies outside the subset are considered already satisfied.
   331	# Ties are broken by direct dependency count, then package name, which
   332	# produces stable, human-friendly output matching the documented examples.
   333	forge_topo_order() {
   334	    if [[ -z "${DEP_MAP[*]+_}" ]]; then
   335	        build_dep_map
   336	    fi
   337	
   338	    declare -A in_set done_pkg remaining_deps
   339	    local pkg deps deps_str dep dep_count dep_array
   340	
   341	    for pkg in "$@"; do
   342	        if [[ -z "${DEP_MAP[$pkg]+_}" ]]; then
   343	            log_error "Unknown package: $pkg"
   344	            return 1
   345	        fi
   346	        in_set[$pkg]=1
   347	    done
   348	
   349	    for pkg in "$@"; do
   350	        deps_str="${DEP_MAP[$pkg]:-}"
   351	        dep_count=0
   352	        if [[ -n "$deps_str" ]]; then
   353	            IFS=',' read -ra dep_array <<< "$deps_str"
   354	            for dep in "${dep_array[@]}"; do
   355	                dep="${dep// /}"
   356	                [[ -z "$dep" ]] && continue
   357	                if [[ -n "${in_set[$dep]:-}" ]]; then
   358	                    dep_count=$(( dep_count + 1 ))
   359	                fi
   360	            done
