   331	test_package_chain() {
   332	    local target="$1" profile="$2"
   333	    local order pkg
   334	    order=$(resolve_deps_for "$target") || return 1
   335	    for pkg in $order; do
   336	        build_package "$pkg" "$profile" || return 1
   337	    done
   338	}
