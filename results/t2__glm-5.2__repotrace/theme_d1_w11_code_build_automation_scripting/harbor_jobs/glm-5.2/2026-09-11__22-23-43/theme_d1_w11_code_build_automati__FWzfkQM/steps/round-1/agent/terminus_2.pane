     6	}
     7	
     8	log_warn() {
     9	    echo "[FORGE WARN] $*" >&2
    10	}
    11	
    12	log_error() {
    13	    echo "[FORGE ERROR] $*" >&2
    14	}
    15	
    16	# Get the absolute path to a package directory
    17	get_package_dir() {
    18	    local name="$1"
    19	    echo "$FORGE_ROOT/packages/$name"
    20	}
    21	
    22	# Get the absolute path to a package manifest
    23	get_package_manifest() {
    24	    local name="$1"
    25	    echo "$FORGE_ROOT/packages/$name/package.forge"
    26	}
    27	
    28	# List all package names (directories under packages/ with a manifest)
    29	list_package_names() {
    30	    local pkg_dir
    31	    for pkg_dir in "$FORGE_ROOT/packages"/*/; do
    32	        if [[ -f "$pkg_dir/package.forge" ]]; then
    33	            basename "$pkg_dir"
    34	        fi
    35	    done
    36	}
    37	
    38	# Display formatted package listing
    39	list_packages() {
    40	    local name version type deps
    41	    printf "%-25s %-10s %-10s %s\n" "NAME" "VERSION" "TYPE" "DEPENDENCIES"
    42	    printf "%-25s %-10s %-10s %s\n" "----" "-------" "----" "------------"
    43	    for pkg_name in $(list_package_names); do
    44	        parse_manifest "$pkg_name"
    45	        name="${MANIFEST_name:-$pkg_name}"
    46	        version="${MANIFEST_version:-unknown}"
    47	        type="${MANIFEST_type:-unknown}"
    48	        deps="${MANIFEST_deps:-none}"
    49	        printf "%-25s %-10s %-10s %s\n" "$name" "$version" "$type" "$deps"
    50	    done
    51	}
    52	
    53	# Clean build artifacts for a package
    54	clean_package() {
    55	    local name="$1"
    56	    local pkg_dir
    57	    pkg_dir=$(get_package_dir "$name")
    58	    if [[ -d "$pkg_dir/build" ]]; then
    59	        rm -rf "$pkg_dir/build"
    60	        log_info "Cleaned $name"
    61	    fi
    62	    find "$pkg_dir/src" -name "*.o" -delete 2>/dev/null || true
    63	}
[?2004hroot@n30009:/app# nl -ba lib/depgraph.sh | sed -n '1,260p'
[?2004l     1	#!/bin/bash
     2	# Dependency graph resolution for ForgeKit
     3	#
     4	# Provides topological-sort-based build ordering and
     5	# dependency tree queries.
     6	
     7	# Build an associative array mapping package -> comma-separated deps
     8	build_dep_map() {
     9	    declare -gA DEP_MAP
    10	    # Reset
    11	    for k in "${!DEP_MAP[@]}"; do unset "DEP_MAP[$k]"; done
    12	
    13	    local pkg_name deps_str
    14	    for pkg_name in $(list_package_names); do
    15	        parse_manifest "$pkg_name"
    16	        deps_str="${MANIFEST_deps:-}"
    17	        DEP_MAP[$pkg_name]="$deps_str"
    18	    done
    19	}
    20	
    21	# -------------------------------------------------------------------
    22	# Topological sort via DFS
    23	#
    24	# BUG: The visited flag is only set AFTER recursing into children.
    25	#      If there is a cycle (A -> B -> A), the function will recurse
    26	#      forever because neither A nor B is marked visited when the
    27	#      cycle is re-entered.  There is no "currently visiting" state
    28	#      that would allow the algorithm to detect the back-edge.
    29	# -------------------------------------------------------------------
    30	resolve_build_order() {
    31	    build_dep_map
    32	
    33	    declare -A _visited
    34	    local _order=""
    35	
    36	    _topo_visit() {
    37	        local node="$1"
    38	
    39	        # Already finished
    40	        [[ "${_visited[$node]:-}" == "done" ]] && return 0
    41	
    42	        # Recurse into dependencies first
    43	        local deps="${DEP_MAP[$node]:-}"
    44	        if [[ -n "$deps" ]]; then
    45	            local IFS=','
    46	            for dep in $deps; do
    47	                dep="${dep// /}"
    48	                [[ -z "$dep" ]] && continue
    49	                _topo_visit "$dep"
    50	            done
    51	        fi
    52	
    53	        _visited[$node]="done"
    54	        _order="$_order $node"
    55	    }
    56	
    57	    for pkg in $(list_package_names); do
    58	        _topo_visit "$pkg"
    59	    done
    60	
    61	    echo "$_order"
    62	}
    63	
    64	# Resolve the build chain for a single target (inclusive)
    65	resolve_deps_for() {
    66	    local target="$1"
    67	    build_dep_map
    68	
    69	    declare -A _visited
    70	    local _order=""
    71	
    72	    _dep_visit() {
    73	        local node="$1"
    74	        [[ "${_visited[$node]:-}" == "done" ]] && return 0
    75	
    76	        local deps="${DEP_MAP[$node]:-}"
    77	        if [[ -n "$deps" ]]; then
    78	            local IFS=','
    79	            for dep in $deps; do
    80	                dep="${dep// /}"
    81	                [[ -z "$dep" ]] && continue
    82	                _dep_visit "$dep"
    83	            done
    84	        fi
    85	
    86	        _visited[$node]="done"
    87	        _order="$_order $node"
    88	    }
    89	
    90	    _dep_visit "$target"
    91	    echo "$_order"
    92	}
    93	
    94	# Pretty-print the dependency tree (recursive, indented)
    95	show_dep_tree() {
    96	    local name="$1"
    97	    local indent="${2:-0}"
    98	
    99	    # Ensure the dep map exists
   100	    if [[ -z "${DEP_MAP[*]+_}" ]]; then
   101	        build_dep_map
   102	    fi
   103	
   104	    local prefix=""
   105	    for ((i = 0; i < indent; i++)); do prefix="$prefix  "; done
   106	
   107	    echo "${prefix}${name}"
   108	
   109	    local deps="${DEP_MAP[$name]:-}"
   110	    if [[ -n "$deps" ]]; then
   111	        local IFS=','
   112	        for dep in $deps; do
   113	            dep="${dep// /}"
   114	            [[ -z "$dep" ]] && continue
   115	            show_dep_tree "$dep" $((indent + 1))
   116	        done
   117	    fi
   118	}
   119	
   120	# Return all transitive dependencies (not including the package itself)
   121	get_all_deps() {
   122	    local name="$1"
   123	    if [[ -z "${DEP_MAP[*]+_}" ]]; then
   124	        build_dep_map
   125	    fi
   126	
   127	    declare -A _seen
   128	    local _result=""
   129	
   130	    _collect_deps() {
   131	        local node="$1"
   132	        local deps="${DEP_MAP[$node]:-}"
   133	        if [[ -n "$deps" ]]; then
   134	            local IFS=','
   135	            for dep in $deps; do
   136	                dep="${dep// /}"
   137	                [[ -z "$dep" ]] && continue
   138	                if [[ -z "${_seen[$dep]:-}" ]]; then
   139	                    _seen[$dep]=1
   140	                    _result="$_result $dep"
   141	                    _collect_deps "$dep"
   142	                fi
   143	            done
   144	        fi
   145	    }
   146	
   147	    _collect_deps "$name"
   148	    echo "$_result"
   149	}
[?2004hroot@n30009:/app# nl -ba lib/cache.sh | sed -n '1,220p'
[?2004l     1	#!/bin/bash
     2	# Build cache management for ForgeKit
     3	#
     4	# Uses timestamp-based caching: each package records a "last built"
     5	# timestamp; a rebuild is triggered when source files are newer.
     6	
     7	FORGE_CACHE_DIR="${FORGE_ROOT}/.forge_cache"
     8	
     9	init_cache() {
    10	    mkdir -p "$FORGE_CACHE_DIR"
    11	}
    12	
    13	# Newest mtime among all files under a package's src/ directory
    14	get_src_mtime() {
    15	    local pkg_name="$1"
    16	    local pkg_dir
    17	    pkg_dir=$(get_package_dir "$pkg_name")
    18	
    19	    local latest=0
    20	    local mtime
    21	    while IFS= read -r -d '' file; do
    22	        mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)
    23	        if (( mtime > latest )); then
    24	            latest=$mtime
    25	        fi
    26	    done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)
    27	
    28	    # Also check Makefile
    29	    if [[ -f "$pkg_dir/Makefile" ]]; then
    30	        mtime=$(stat -c %Y "$pkg_dir/Makefile" 2>/dev/null || echo 0)
    31	        if (( mtime > latest )); then
    32	            latest=$mtime
    33	        fi
    34	    fi
    35	
    36	    echo "$latest"
    37	}
    38	
    39	# Check whether the cached build is still valid.
    40	#
    41	# BUG: Only compares the package's own source timestamps against its
    42	#      cached build timestamp.  It does NOT check whether any of the
    43	#      package's transitive dependencies have been rebuilt more
    44	#      recently.  This means that modifying libbase and rebuilding it
    45	#      will NOT trigger a rebuild of libcrypto (which depends on
    46	#      libbase) during an incremental build.
    47	is_cache_valid() {
    48	    local pkg_name="$1"
    49	    init_cache
    50	    local cache_file="$FORGE_CACHE_DIR/${pkg_name}.stamp"
    51	
    52	    if [[ ! -f "$cache_file" ]]; then
    53	        return 1  # No cache -> rebuild
    54	    fi
    55	
    56	    local cached_time
    57	    cached_time=$(cat "$cache_file")
    58	
    59	    local src_mtime
    60	    src_mtime=$(get_src_mtime "$pkg_name")
    61	
    62	    if (( src_mtime > cached_time )); then
    63	        return 1  # Source newer than cache -> rebuild
    64	    fi
    65	
    66	    return 0  # Cache is valid
    67	}
    68	
    69	# Record the current time as the build timestamp for a package
    70	update_cache() {
    71	    local pkg_name="$1"
    72	    init_cache
    73	    date +%s > "$FORGE_CACHE_DIR/${pkg_name}.stamp"
    74	}
    75	
    76	# Remove cache entry for a package
    77	invalidate_cache() {
    78	    local pkg_name="$1"
    79	    rm -f "$FORGE_CACHE_DIR/${pkg_name}.stamp"
    80	}
    81	
    82	# Wipe the entire cache directory
    83	clean_cache() {
    84	    rm -rf "$FORGE_CACHE_DIR"
    85	}
