[?2004l     1	#!/bin/bash
     2	# Build cache management for ForgeKit
     3	#
     4	# Content-addressable cache: each package records a SHA256 source hash
     5	# and the source hashes of all transitive dependencies at build time.
     6	# Cache stamps are profile-namespaced so debug and release builds do
     7	# not interfere with each other.
     8	
     9	FORGE_CACHE_DIR="${FORGE_ROOT}/.forge_cache"
    10	
    11	init_cache() {
    12	    mkdir -p "$FORGE_CACHE_DIR"
    13	}
    14	
    15	_forge_cache_profile() {
    16	    local profile="${1:-release}"
    17	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
    18	        profile="release"
    19	    fi
    20	    echo "$profile"
    21	}
    22	
    23	# Compute the SHA256 hash of a single file, or empty string if missing.
    24	_file_sha256() {
    25	    local file="$1"
    26	    if [[ -f "$file" ]]; then
    27	        sha256sum "$file" | awk '{print $1}'
    28	    fi
    29	}
    30	
    31	# Compute the source hash for a package:
    32	# SHA256(sorted concatenation of SHA256 hashes of all files in src/
    33	# + Makefile + package.forge).
    34	compute_source_hash() {
    35	    local pkg_name="$1"
    36	    local pkg_dir
    37	    pkg_dir=$(get_package_dir "$pkg_name")
    38	
    39	    local hashes="" hash
    40	    local file
    41	
    42	    while IFS= read -r -d '' file; do
    43	        hash=$(_file_sha256 "$file")
    44	        [[ -n "$hash" ]] && hashes+="$hash\n"
    45	    done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)
    46	
    47	    hash=$(_file_sha256 "$pkg_dir/Makefile")
    48	    [[ -n "$hash" ]] && hashes+="$hash\n"
    49	    hash=$(_file_sha256 "$pkg_dir/package.forge")
    50	    [[ -n "$hash" ]] && hashes+="$hash\n"
    51	
    52	    if [[ -z "$hashes" ]]; then
    53	        # No source files: hash the empty string for stability.
    54	        printf '%s\n' "" | sha256sum | awk '{print $1}'
    55	        return 0
    56	    fi
    57	
    58	    printf '%b' "$hashes" | LC_ALL=C sort | sha256sum | awk '{print $1}'
    59	}
    60	
    61	# Return the stored own source hash from a cache stamp, or empty string.
    62	_stored_own_hash() {
    63	    local cache_file="$1"
    64	    [[ -f "$cache_file" ]] || return 0
    65	    head -n 1 "$cache_file" 2>/dev/null | awk '{print $1}'
    66	}
    67	
    68	# Return the stored hash for a dependency from a cache stamp, or empty string.
    69	_stored_dep_hash() {
    70	    local cache_file="$1" dep="$2"
    71	    [[ -f "$cache_file" ]] || return 0
    72	    awk -v dep="$dep" '
    73	        BEGIN { FS=":" }
    74	        NR > 1 && $1 == dep { print $2; exit }
    75	    ' "$cache_file" 2>/dev/null
    76	}
    77	
    78	# Check whether the cached build is still valid.
    79	#
    80	# A build is valid when:
    81	#   - it has a .hash cache stamp
    82	#   - the package's current source hash matches the stored own hash
    83	#   - every transitive dependency's current source hash matches the hash
    84	#     recorded when this package was last built
    85	is_cache_valid() {
    86	    local pkg_name="$1"
    87	    local profile
    88	    profile=$(_forge_cache_profile "${2:-release}")
    89	    init_cache
    90	    local cache_file="$FORGE_CACHE_DIR/${pkg_name}-${profile}.hash"
    91	
    92	    if [[ ! -f "$cache_file" ]]; then
    93	        return 1  # No cache -> rebuild
    94	    fi
    95	
    96	    local own_hash stored_hash
    97	    own_hash=$(compute_source_hash "$pkg_name")
    98	    stored_hash=$(_stored_own_hash "$cache_file")
    99	    if [[ -z "$stored_hash" || "$own_hash" != "$stored_hash" ]]; then
   100	        return 1
   101	    fi
   102	
   103	    local deps
   104	    deps=$(get_all_deps "$pkg_name") || return 1
   105	    local dep dep_hash stored_dep_hash
   106	    for dep in $deps; do
   107	        [[ -z "$dep" ]] && continue
   108	        dep_hash=$(compute_source_hash "$dep")
   109	        stored_dep_hash=$(_stored_dep_hash "$cache_file" "$dep")
   110	        if [[ -z "$stored_dep_hash" || "$dep_hash" != "$stored_dep_hash" ]]; then
   111	            return 1
   112	        fi
   113	    done
   114	
   115	    return 0
   116	}
   117	
   118	# Record the current source hash and all transitive dependency hashes.
   119	update_cache() {
   120	    local pkg_name="$1"
   121	    local profile
   122	    profile=$(_forge_cache_profile "${2:-release}")
   123	    init_cache
   124	    local cache_file="$FORGE_CACHE_DIR/${pkg_name}-${profile}.hash"
   125	
   126	    # Replace old timestamp stamps if present.
   127	    rm -f "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"
   128	
   129	    local own_hash deps dep dep_hash
   130	    own_hash=$(compute_source_hash "$pkg_name")
   131	    {
   132	        echo "$own_hash"
   133	        deps=$(get_all_deps "$pkg_name") || deps=""
   134	        for dep in $deps; do
   135	            [[ -z "$dep" ]] && continue
   136	            dep_hash=$(compute_source_hash "$dep")
   137	            echo "${dep}:${dep_hash}"
   138	        done
   139	    } > "$cache_file"
   140	}
   141	
   142	# Remove cache entry for a package.  When a profile is supplied, only that
   143	# profile's stamp is removed.  Without a profile, all profile stamps for the
   144	# package are invalidated.
   145	invalidate_cache() {
   146	    local pkg_name="$1"
   147	    local profile
   148	    if [[ -n "${2:-}" ]]; then
   149	        profile=$(_forge_cache_profile "$2")
   150	        rm -f "$FORGE_CACHE_DIR/${pkg_name}-${profile}.hash"
   151	        rm -f "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"
   152	    else
   153	        rm -f "$FORGE_CACHE_DIR/${pkg_name}-"*.hash
   154	        rm -f "$FORGE_CACHE_DIR/${pkg_name}-"*.stamp
   155	    fi
   156	}
   157	
   158	# Wipe cache entries.  With a profile argument, only that profile is
   159	# removed.  Without an argument, all cache entries are removed.
   160	clean_cache() {
   161	    local profile
   162	    profile=$(_forge_cache_profile "${1:-}")
   163	    init_cache
   164	    if [[ -n "$1" ]]; then
   165	        rm -f "$FORGE_CACHE_DIR"/*-${profile}.hash
   166	        rm -f "$FORGE_CACHE_DIR"/*-${profile}.stamp
   167	    else
   168	        rm -rf "$FORGE_CACHE_DIR"
   169	    fi
   170	}
   171	
   172	# -------------------------------------------------------------------
   173	# Round 4/5: selective rebuild support.
   174	# -------------------------------------------------------------------
   175	
   176	# Return space-separated packages whose cache is invalid for PROFILE.
   177	# This captures packages with changed source/Makefile/manifest as well as
   178	# packages whose dependency source hashes changed.
   179	get_changed_packages() {
   180	    local profile
   181	    profile=$(_forge_cache_profile "${1:-release}")
   182	    init_cache
   183	    build_dep_map
   184	
   185	    local pkg changed=""
   186	    for pkg in $(list_package_names); do
   187	        if ! is_cache_valid "$pkg" "$profile" 2>/dev/null; then
   188	            changed="$changed $pkg"
   189	        fi
   190	    done
   191	
   192	    echo "${changed# }"
   193	}
   194	
   195	# -------------------------------------------------------------------
   196	# Round 5: cache status command.
   197	# -------------------------------------------------------------------
   198	
   199	# Print a per-package cache status summary.
   200	# Statuses:
   201	#   cached (<first 8 chars of hash>...)
   202	#   stale (src changed)
   203	#   stale (dep NAME changed)
   204	#   no cache
   205	cache_status() {
   206	    local pkg_filter="" profile
   207	    profile="release"
   208	
   209	    while [[ $# -gt 0 ]]; do
   210	        case "$1" in
   211	            --package)
   212	                if [[ $# -lt 2 ]]; then
   213	                    log_error "--package requires a package name"
   214	                    return 1
   215	                fi
   216	                pkg_filter="$2"
   217	                shift
   218	                ;;
   219	            --profile)
   220	                if [[ $# -lt 2 ]]; then
   221	                    log_error "--profile requires a profile name"
   222	                    return 1
   223	                fi
   224	                profile="$2"
   225	                shift
   226	                ;;
   227	            *)
   228	                log_error "Unknown cache status option: $1"
   229	                return 1
   230	                ;;
   231	        esac
   232	        shift
   233	    done
   234	
   235	    profile=$(_forge_cache_profile "$profile")
   236	    init_cache
   237	    build_dep_map
   238	
   239	    printf "%-20s %-10s %s\n" "PACKAGE" "PROFILE" "STATUS"
   240	    printf "%-20s %-10s %s\n" "-------" "-------" "------"
   241	
   242	    local pkg cache_file own_hash stored_hash status deps dep dep_hash stored_dep_hash first_changed
   243	    for pkg in $(list_package_names); do
   244	        if [[ -n "$pkg_filter" && "$pkg" != "$pkg_filter" ]]; then
   245	            continue
   246	        fi
   247	
   248	        cache_file="$FORGE_CACHE_DIR/${pkg}-${profile}.hash"
   249	        if [[ ! -f "$cache_file" ]]; then
   250	            status="no cache"
   251	            printf "%-20s %-10s %s\n" "$pkg" "$profile" "$status"
   252	            continue
   253	        fi
   254	
   255	        own_hash=$(compute_source_hash "$pkg")
   256	        stored_hash=$(_stored_own_hash "$cache_file")
   257	        if [[ -z "$stored_hash" || "$own_hash" != "$stored_hash" ]]; then
   258	            status="stale (src changed)"
   259	            printf "%-20s %-10s %s\n" "$pkg" "$profile" "$status"
   260	            continue
