[?2004l     1	#!/bin/bash
     2	# Artifact packaging for ForgeKit
     3	
     4	pack_artifact() {
     5	    local pkg_name="$1"
     6	    local profile="${2:-release}"
     7	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
     8	        log_error "Invalid profile: $profile"
     9	        return 1
    10	    fi
    11	    local pkg_dir
    12	    pkg_dir=$(get_package_dir "$pkg_name")
    13	
    14	    parse_manifest "$pkg_name"
    15	    local version="${MANIFEST_version:-0.0.0}"
    16	
    17	    local build_dir="$pkg_dir/build/$profile"
    18	    if [[ ! -d "$build_dir" ]]; then
    19	        log_error "Build directory not found for $pkg_name ($profile). Run 'forge build' first."
    20	        return 1
    21	    fi
    22	
    23	    local artifact_dir="$FORGE_ROOT/artifacts"
    24	    mkdir -p "$artifact_dir"
    25	
    26	    local artifact_name="${pkg_name}-${version}-${profile}.tar.gz"
    27	
    28	    # Generate dependency metadata inside the packaged build directory.
    29	    # Direct dependencies only, as <dep_name>=<dep_version> per line.
    30	    local deps_manifest="$build_dir/deps.manifest"
    31	    : > "$deps_manifest"
    32	
    33	    local deps="${MANIFEST_deps:-}"
    34	    if [[ -n "$deps" ]]; then
    35	        local IFS=','
    36	        local dep dep_version
    37	        for dep in $deps; do
    38	            dep="${dep// /}"
    39	            [[ -z "$dep" ]] && continue
    40	            dep_version=$(get_manifest_value "$dep" "version") || return 1
    41	            printf '%s=%s\n' "$dep" "$dep_version" >> "$deps_manifest"
    42	        done
    43	    fi
    44	
    45	    tar -czf "$artifact_dir/$artifact_name"         -C "$pkg_dir"         "build/$profile/" 2>/dev/null
    46	
    47	    if [[ $? -ne 0 ]]; then
    48	        log_error "Failed to create artifact for $pkg_name"
    49	        return 1
    50	    fi
    51	
    52	    log_info "Packed artifact: $artifact_name -> $artifact_dir/$artifact_name"
    53	    echo "$artifact_dir/$artifact_name"
    54	}
