[?2004l     1	#!/bin/bash
     2	# Artifact packaging for ForgeKit
     3	
     4	pack_artifact() {
     5	    local pkg_name="$1"
     6	    local pkg_dir
     7	    pkg_dir=$(get_package_dir "$pkg_name")
     8	
     9	    parse_manifest "$pkg_name"
    10	    local version="${MANIFEST_version:-0.0.0}"
    11	
    12	    local build_dir="$pkg_dir/build"
    13	    if [[ ! -d "$build_dir" ]]; then
    14	        log_error "Build directory not found for $pkg_name. Run 'forge build' first."
    15	        return 1
    16	    fi
    17	
    18	    local artifact_dir="$FORGE_ROOT/artifacts"
    19	    mkdir -p "$artifact_dir"
    20	
    21	    local artifact_name="${pkg_name}-${version}.tar.gz"
    22	
    23	    # Generate dependency metadata inside the packaged build directory.
    24	    # Direct dependencies only, as <dep_name>=<dep_version> per line.
    25	    local deps_manifest="$build_dir/deps.manifest"
    26	    : > "$deps_manifest"
    27	
    28	    local deps="${MANIFEST_deps:-}"
    29	    if [[ -n "$deps" ]]; then
    30	        local IFS=','
    31	        local dep dep_version
    32	        for dep in $deps; do
    33	            dep="${dep// /}"
    34	            [[ -z "$dep" ]] && continue
    35	            dep_version=$(get_manifest_value "$dep" "version") || return 1
    36	            printf '%s=%s\n' "$dep" "$dep_version" >> "$deps_manifest"
    37	        done
    38	    fi
    39	
    40	    tar -czf "$artifact_dir/$artifact_name" \
    41	        -C "$pkg_dir" \
    42	        build/ 2>/dev/null
    43	
    44	    if [[ $? -ne 0 ]]; then
    45	        log_error "Failed to create artifact for $pkg_name"
    46	        return 1
    47	    fi
    48	
    49	    log_info "Packed artifact: $artifact_name -> $artifact_dir/$artifact_name"
    50	    echo "$artifact_dir/$artifact_name"
    51	}
     1	#!/bin/bash
     2	# Common utilities for ForgeKit
     3	
     4	log_info() {
     5	    echo "[FORGE INFO] $*" >&2
     6	}
     7	
     8	log_warn() {
     9	    echo "[FORGE WARN] $*" >&2
    10	}
    11	
    12	log_error() {
    13	    echo "[FORGE ERROR] $*" >&2
    14	}
    15	
    16	# Get the absolute path to a package directory
    17	get_package_dir() {
    18	    local name="$1"
    19	    echo "$FORGE_ROOT/packages/$name"
    20	}
    21	
    22	# Get the absolute path to a package manifest
    23	get_package_manifest() {
    24	    local name="$1"
    25	    echo "$FORGE_ROOT/packages/$name/package.forge"
    26	}
    27	
    28	# List all package names (directories under packages/ with a manifest)
    29	list_package_names() {
    30	    local pkg_dir
    31	    for pkg_dir in "$FORGE_ROOT/packages"/*/; do
    32	        if [[ -f "$pkg_dir/package.forge" ]]; then
    33	            basename "$pkg_dir"
    34	        fi
    35	    done
    36	}
    37	
    38	# Display formatted package listing
    39	list_packages() {
    40	    local name version type deps
    41	    printf "%-25s %-10s %-10s %s\n" "NAME" "VERSION" "TYPE" "DEPENDENCIES"
    42	    printf "%-25s %-10s %-10s %s\n" "----" "-------" "----" "------------"
    43	    for pkg_name in $(list_package_names); do
    44	        parse_manifest "$pkg_name"
    45	        name="${MANIFEST_name:-$pkg_name}"
    46	        version="${MANIFEST_version:-unknown}"
    47	        type="${MANIFEST_type:-unknown}"
    48	        deps="${MANIFEST_deps:-none}"
    49	        printf "%-25s %-10s %-10s %s\n" "$name" "$version" "$type" "$deps"
    50	    done
    51	}
    52	
    53	# Clean build artifacts for a package
    54	clean_package() {
    55	    local name="$1"
    56	    local pkg_dir
    57	    pkg_dir=$(get_package_dir "$name")
    58	    if [[ -d "$pkg_dir/build" ]]; then
    59	        rm -rf "$pkg_dir/build"
    60	        log_info "Cleaned $name"
    61	    fi
    62	    find "$pkg_dir/src" -name "*.o" -delete 2>/dev/null || true
    63	}
     1	#!/bin/bash
     2	# Manifest parser for .forge package files
     3	#
     4	# Format:
     5	#   [section]
     6	#   key = value
     7	#   # comments
     8	#   key = long value \
     9	#         continued on next line
    10	#
    11	# All parsed values are exported as MANIFEST_<key>=<value>
    12	
    13	parse_manifest() {
    14	    local pkg_name="$1"
    15	    local manifest_file
    16	    manifest_file=$(get_package_manifest "$pkg_name")
    17	
    18	    if [[ ! -f "$manifest_file" ]]; then
    19	        log_error "Manifest not found: $manifest_file"
    20	        return 1
    21	    fi
    22	
    23	    # Clear previous manifest data
    24	    local var
    25	    for var in $(compgen -v MANIFEST_ 2>/dev/null || true); do
    26	        unset "$var"
    27	    done
    28	
    29	    local current_section=""
    30	    local line key value next_line
    31	
    32	    while IFS= read -r line || [[ -n "$line" ]]; do
    33	        # Skip empty lines and full-line comments
    34	        [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    35	        [[ "$line" =~ ^[[:space:]]*# ]] && continue
    36	
    37	        # Section header
    38	        if [[ "$line" =~ ^\[([a-zA-Z_][a-zA-Z0-9_]*)\] ]]; then
    39	            current_section="${BASH_REMATCH[1]}"
    40	            continue
    41	        fi
    42	
    43	        # Key = value pair
    44	        if [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then
    45	            key="${BASH_REMATCH[1]}"
    46	            value="${BASH_REMATCH[2]}"
    47	
    48	            # Strip inline comments preceded by whitespace.  A '#' inside a
    49	            # value without preceding whitespace is preserved.
    50	            if [[ "$value" =~ ^[[:space:]]*# ]]; then
    51	                value=""
    52	            elif [[ "$value" =~ [[:space:]]# ]]; then
    53	                value="${value%%[[:space:]]#*}"
    54	            fi
    55	
    56	            # Trim trailing whitespace from value
    57	            value="${value%"${value##*[![:space:]]}"}"
    58	
    59	            # Handle backslash line continuation.  A trailing backslash joins
    60	            # the next line; the backslash and leading whitespace on the
    61	            # continuation line are stripped.
    62	            while [[ "$value" == *\\ ]]; do
    63	                value="${value%\\}"
    64	                if IFS= read -r next_line || [[ -n "$next_line" ]]; then
    65	                    # Strip leading and trailing whitespace from continuation
    66	                    # lines before joining.
    67	                    next_line="${next_line#"${next_line%%[![:space:]]*}"}"
    68	                    next_line="${next_line%"${next_line##*[![:space:]]}"}"
    69	                    value="$value$next_line"
    70	                else
    71	                    break
    72	                fi
    73	            done
    74	
    75	            export "MANIFEST_${key}=${value}"
    76	        fi
    77	    done < "$manifest_file"
    78	}
    79	
    80	# Convenience: parse and return a single value
    81	get_manifest_value() {
    82	    local pkg_name="$1"
    83	    local key="$2"
    84	    if ! parse_manifest "$pkg_name"; then
    85	        return 1
    86	    fi
    87	    local var="MANIFEST_${key}"
    88	    echo "${!var:-}"
    89	}
