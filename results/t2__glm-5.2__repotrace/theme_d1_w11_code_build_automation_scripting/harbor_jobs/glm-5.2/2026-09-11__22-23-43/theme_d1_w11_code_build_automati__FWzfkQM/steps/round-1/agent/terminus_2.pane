#!/bin/bash
# Common utilities for ForgeKit

log_info() {
    echo "[FORGE INFO] $*"
}

log_warn() {
    echo "[FORGE WARN] $*" >&2
}

log_error() {
    echo "[FORGE ERROR] $*" >&2
}

# Get the absolute path to a package directory
get_package_dir() {
    local name="$1"
    echo "$FORGE_ROOT/packages/$name"
}

# Get the absolute path to a package manifest
get_package_manifest() {
    local name="$1"
    echo "$FORGE_ROOT/packages/$name/package.forge"
}

# List all package names (directories under packages/ with a manifest)
list_package_names() {
    local pkg_dir
    for pkg_dir in "$FORGE_ROOT/packages"/*/; do
        if [[ -f "$pkg_dir/package.forge" ]]; then
            basename "$pkg_dir"
        fi
    done
}

# Display formatted package listing
list_packages() {
    local name version type deps
    printf "%-25s %-10s %-10s %s\n" "NAME" "VERSION" "TYPE" "DEPENDENCIES"
    printf "%-25s %-10s %-10s %s\n" "----" "-------" "----" "------------"
    for pkg_name in $(list_package_names); do
        parse_manifest "$pkg_name"
        name="${MANIFEST_name:-$pkg_name}"
        version="${MANIFEST_version:-unknown}"
        type="${MANIFEST_type:-unknown}"
        deps="${MANIFEST_deps:-none}"
        printf "%-25s %-10s %-10s %s\n" "$name" "$version" "$type" "$deps"
    done
}

# Clean build artifacts for a package
clean_package() {
    local name="$1"
    local pkg_dir
    pkg_dir=$(get_package_dir "$name")
    if [[ -d "$pkg_dir/build" ]]; then
        rm -rf "$pkg_dir/build"
        log_info "Cleaned $name"
    fi
    find "$pkg_dir/src" -name "*.o" -delete 2>/dev/null || true
}
===== lib/depgraph.sh =====
#!/bin/bash
# Dependency graph resolution for ForgeKit
#
# Provides topological-sort-based build ordering and
# dependency tree queries.

# Build an associative array mapping package -> comma-separated deps
build_dep_map() {
    declare -gA DEP_MAP
    # Reset
    for k in "${!DEP_MAP[@]}"; do unset "DEP_MAP[$k]"; done

    local pkg_name deps_str
    for pkg_name in $(list_package_names); do
        parse_manifest "$pkg_name"
        deps_str="${MANIFEST_deps:-}"
        DEP_MAP[$pkg_name]="$deps_str"
    done
}

# -------------------------------------------------------------------
# Topological sort via DFS
#
# BUG: The visited flag is only set AFTER recursing into children.
#      If there is a cycle (A -> B -> A), the function will recurse
#      forever because neither A nor B is marked visited when the
#      cycle is re-entered.  There is no "currently visiting" state
#      that would allow the algorithm to detect the back-edge.
# -------------------------------------------------------------------
resolve_build_order() {
    build_dep_map

    declare -A _visited
    local _order=""

    _topo_visit() {
        local node="$1"

        # Already finished
        [[ "${_visited[$node]:-}" == "done" ]] && return 0

        # Recurse into dependencies first
        local deps="${DEP_MAP[$node]:-}"
        if [[ -n "$deps" ]]; then
            local IFS=','
            for dep in $deps; do
                dep="${dep// /}"
                [[ -z "$dep" ]] && continue
                _topo_visit "$dep"
            done
        fi

        _visited[$node]="done"
        _order="$_order $node"
    }

    for pkg in $(list_package_names); do
        _topo_visit "$pkg"
    done

    echo "$_order"
}

# Resolve the build chain for a single target (inclusive)
resolve_deps_for() {
    local target="$1"
    build_dep_map

    declare -A _visited
    local _order=""

    _dep_visit() {
        local node="$1"
        [[ "${_visited[$node]:-}" == "done" ]] && return 0

        local deps="${DEP_MAP[$node]:-}"
        if [[ -n "$deps" ]]; then
            local IFS=','
            for dep in $deps; do
                dep="${dep// /}"
                [[ -z "$dep" ]] && continue
                _dep_visit "$dep"
            done
        fi

        _visited[$node]="done"
        _order="$_order $node"
    }

    _dep_visit "$target"
    echo "$_order"
}

# Pretty-print the dependency tree (recursive, indented)
show_dep_tree() {
    local name="$1"
    local indent="${2:-0}"

    # Ensure the dep map exists
    if [[ -z "${DEP_MAP[*]+_}" ]]; then
        build_dep_map
    fi

    local prefix=""
    for ((i = 0; i < indent; i++)); do prefix="$prefix  "; done

    echo "${prefix}${name}"

    local deps="${DEP_MAP[$name]:-}"
    if [[ -n "$deps" ]]; then
        local IFS=','
        for dep in $deps; do
            dep="${dep// /}"
            [[ -z "$dep" ]] && continue
            show_dep_tree "$dep" $((indent + 1))
        done
    fi
}

# Return all transitive dependencies (not including the package itself)
get_all_deps() {
    local name="$1"
    if [[ -z "${DEP_MAP[*]+_}" ]]; then
        build_dep_map
    fi

    declare -A _seen
    local _result=""

    _collect_deps() {
        local node="$1"
        local deps="${DEP_MAP[$node]:-}"
        if [[ -n "$deps" ]]; then
            local IFS=','
            for dep in $deps; do
                dep="${dep// /}"
                [[ -z "$dep" ]] && continue
                if [[ -z "${_seen[$dep]:-}" ]]; then
                    _seen[$dep]=1
                    _result="$_result $dep"
                    _collect_deps "$dep"
                fi
            done
        fi
    }

    _collect_deps "$name"
    echo "$_result"
}
===== lib/cache.sh =====
#!/bin/bash
# Build cache management for ForgeKit
#
# Uses timestamp-based caching: each package records a "last built"
# timestamp; a rebuild is triggered when source files are newer.

FORGE_CACHE_DIR="${FORGE_ROOT}/.forge_cache"

init_cache() {
    mkdir -p "$FORGE_CACHE_DIR"
}

# Newest mtime among all files under a package's src/ directory
get_src_mtime() {
    local pkg_name="$1"
    local pkg_dir
    pkg_dir=$(get_package_dir "$pkg_name")

    local latest=0
    local mtime
    while IFS= read -r -d '' file; do
        mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)
        if (( mtime > latest )); then
            latest=$mtime
        fi
    done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)

    # Also check Makefile
    if [[ -f "$pkg_dir/Makefile" ]]; then
        mtime=$(stat -c %Y "$pkg_dir/Makefile" 2>/dev/null || echo 0)
        if (( mtime > latest )); then
            latest=$mtime
        fi
    fi

    echo "$latest"
}

# Check whether the cached build is still valid.
#
# BUG: Only compares the package's own source timestamps against its
#      cached build timestamp.  It does NOT check whether any of the
#      package's transitive dependencies have been rebuilt more
#      recently.  This means that modifying libbase and rebuilding it
#      will NOT trigger a rebuild of libcrypto (which depends on
#      libbase) during an incremental build.
is_cache_valid() {
    local pkg_name="$1"
    init_cache
    local cache_file="$FORGE_CACHE_DIR/${pkg_name}.stamp"

    if [[ ! -f "$cache_file" ]]; then
        return 1  # No cache -> rebuild
    fi

    local cached_time
    cached_time=$(cat "$cache_file")

    local src_mtime
    src_mtime=$(get_src_mtime "$pkg_name")

    if (( src_mtime > cached_time )); then
        return 1  # Source newer than cache -> rebuild
    fi

    return 0  # Cache is valid
}

# Record the current time as the build timestamp for a package
update_cache() {
    local pkg_name="$1"
    init_cache
    date +%s > "$FORGE_CACHE_DIR/${pkg_name}.stamp"
}

# Remove cache entry for a package
invalidate_cache() {
    local pkg_name="$1"
    rm -f "$FORGE_CACHE_DIR/${pkg_name}.stamp"
}

# Wipe the entire cache directory
clean_cache() {
    rm -rf "$FORGE_CACHE_DIR"
}
===== lib/builder.sh =====
#!/bin/bash
# Build executor for ForgeKit
#
# Builds packages by running their Makefile in the correct environment.

# Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.
# BUG: Only sets up paths for *direct* dependencies.
#      Transitive dependency include/lib paths are not added.
#      Currently harmless because no header exposes transitive types,
#      but will break as soon as a public header includes a transitive
#      dependency header.
setup_build_env() {
    local pkg_name="$1"
    parse_manifest "$pkg_name"

    local cflags=""
    local ldflags=""
    local libs=""
    local deps="${MANIFEST_deps:-}"

    if [[ -n "$deps" ]]; then
        local IFS=','
        for dep in $deps; do
            dep="${dep// /}"
            [[ -z "$dep" ]] && continue
            local dep_dir
            dep_dir=$(get_package_dir "$dep")
            cflags="$cflags -I${dep_dir}/src"
            ldflags="$ldflags -L${dep_dir}/build"
            # For services linking against libraries
            parse_manifest "$dep"
            if [[ "${MANIFEST_type:-}" == "library" ]]; then
                local libname="${dep#lib}"
                libs="$libs ${dep_dir}/build/${dep}.a"
            fi
        done
    fi

    export FORGE_CFLAGS="$cflags"
    export FORGE_LDFLAGS="$ldflags"
    export FORGE_LIBS="$libs"
}

# Build a single package
build_package() {
    local pkg_name="$1"
    local pkg_dir
    pkg_dir=$(get_package_dir "$pkg_name")

    if [[ ! -d "$pkg_dir" ]]; then
        log_error "Package directory not found: $pkg_dir"
        return 1
    fi

    # Check cache
    if is_cache_valid "$pkg_name" 2>/dev/null; then
        log_info "[$pkg_name] Up to date (cached)"
        return 0
    fi

    log_info "[$pkg_name] Building..."

    # Parse manifest for build command
    parse_manifest "$pkg_name"
    local build_cmd="${MANIFEST_command:-make}"

    # Set up build environment
    setup_build_env "$pkg_name"

    # Execute build
    if ! (cd "$pkg_dir" && eval "$build_cmd" 2>&1); then
        log_error "[$pkg_name] Build failed"
        return 1
    fi

    # Update cache
    update_cache "$pkg_name"

    log_info "[$pkg_name] Build successful"
    return 0
}

# Run tests for a single package
test_package() {
    local pkg_name="$1"
    local pkg_dir
    pkg_dir=$(get_package_dir "$pkg_name")

    parse_manifest "$pkg_name"
    local test_cmd="${MANIFEST_test_command:-make test}"

    setup_build_env "$pkg_name"

    log_info "[$pkg_name] Running tests..."
    if ! (cd "$pkg_dir" && eval "$test_cmd" 2>&1); then
        log_error "[$pkg_name] Tests failed"
        return 1
    fi

    log_info "[$pkg_name] Tests passed"
    return 0
}
===== lib/artifact.sh =====
#!/bin/bash
# Artifact packaging for ForgeKit
#
# Packs a package's build output into a distributable tarball.

pack_artifact() {
    local pkg_name="$1"
    local pkg_dir
    pkg_dir=$(get_package_dir "$pkg_name")

    parse_manifest "$pkg_name"
    local version="${MANIFEST_version:-0.0.0}"

    local build_dir="$pkg_dir/build"
    if [[ ! -d "$build_dir" ]]; then
        log_error "Build directory not found for $pkg_name. Run 'forge build' first."
        return 1
    fi

    local artifact_dir="$FORGE_ROOT/artifacts"
    mkdir -p "$artifact_dir"

    local artifact_name="${pkg_name}-${version}.tar.gz"

    # BUG: The tarball only contains build/ output.
    # It should also include a deps.manifest file listing the direct
    # dependencies and their versions so downstream deployment tooling
    # can verify compatibility.  Currently there is no such metadata,
    # making it impossible to check whether two artifacts were built
    # against compatible dependency versions.

    tar -czf "$artifact_dir/$artifact_name" \
        -C "$pkg_dir" \
        build/ 2>/dev/null

    if [[ $? -ne 0 ]]; then
        log_error "Failed to create artifact for $pkg_name"
        return 1
    fi

    log_info "Packed artifact: $artifact_name -> $artifact_dir/$artifact_name"
    echo "$artifact_dir/$artifact_name"
}
===== lib/configgen.sh =====
#!/bin/bash
# Deployment config generator for ForgeKit
#
# Processes template files (*.tpl) by substituting ${VAR} references
# with values from environment-specific config files and built-in vars.

generate_config() {
    local env="$1"
    local template_dir="$FORGE_ROOT/templates"

    if [[ ! -d "$template_dir" ]]; then
        log_error "Templates directory not found: $template_dir"
        return 1
    fi

    # Build variable map -----------------------------------------------
    declare -A config_vars
    config_vars[ENV]="$env"
    config_vars[FORGE_ROOT]="$FORGE_ROOT"
    config_vars[TIMESTAMP]="$(date -u +%Y%m%dT%H%M%SZ)"

    # Load environment-specific config if it exists
    local env_conf="$FORGE_ROOT/config/${env}.conf"
    if [[ -f "$env_conf" ]]; then
        local key value
        while IFS='=' read -r key value; do
            [[ "$key" =~ ^[[:space:]]*# ]] && continue
            [[ -z "$key" ]] && continue
            key=$(echo "$key" | tr -d '[:space:]')
            value=$(echo "$value" | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')
            config_vars[$key]="$value"
        done < "$env_conf"
    fi

    # Inject per-package version variables
    for pkg_name in $(list_package_names); do
        parse_manifest "$pkg_name"
        local safe_name="${pkg_name//-/_}"
        config_vars["VERSION_${safe_name}"]="${MANIFEST_version:-0.0.0}"
    done

    # Process each template file ---------------------------------------
    mkdir -p "$FORGE_ROOT/generated"

    for tpl in "$template_dir"/*.tpl; do
        [[ -f "$tpl" ]] || continue
        local outname
        outname=$(basename "$tpl" .tpl)
        local outfile="$FORGE_ROOT/generated/${outname}"

        local content
        content=$(cat "$tpl")

        # Simple single-pass variable substitution.
        #
        # BUG: Only resolves flat ${VAR} references.  Nested patterns
        # such as ${REGION_${ENV}} are not handled — the inner ${ENV}
        # is never expanded first, so the entire token is left as-is.
        # A correct implementation would iteratively (or recursively)
        # resolve inner references before resolving the outer one.
        for var_name in "${!config_vars[@]}"; do
            content="${content//\$\{${var_name}\}/${config_vars[$var_name]}}"
        done

        echo "$content" > "$outfile"
        log_info "Generated config: $outfile"
    done
}
===== lib/reporter.sh =====
#!/bin/bash
# Build report generator for ForgeKit

generate_report() {
    echo "========================================="
    echo "  ForgeKit Build Report"
    echo "========================================="
    echo "  Date: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "========================================="
    echo ""

    # BUG: The "%-12s" format specifier silently truncates any package
    # name longer than 12 characters.  For example "svc-scheduler"
    # (13 chars) is printed as "svc-schedule" in the report.  Package
    # names should be displayed in full with proper column alignment.

    printf "%-12s  %-10s  %-10s  %-8s  %s\n" \
        "PACKAGE" "VERSION" "TYPE" "STATUS" "CACHED"
    printf "%-12s  %-10s  %-10s  %-8s  %s\n" \
        "-------" "-------" "----" "------" "------"

    for pkg_name in $(list_package_names); do
        parse_manifest "$pkg_name"
        local version="${MANIFEST_version:-?}"
        local type="${MANIFEST_type:-?}"
        local pkg_dir
        pkg_dir=$(get_package_dir "$pkg_name")

        local status="pending"
        if [[ -d "$pkg_dir/build" ]]; then
            status="built"
        fi

        local cached="no"
        if is_cache_valid "$pkg_name" 2>/dev/null; then
            cached="yes"
        fi

        printf "%-12s  %-10s  %-10s  %-8s  %s\n" \
            "$pkg_name" "$version" "$type" "$status" "$cached"
    done

    echo ""
    echo "Total packages: $(list_package_names | wc -w)"
}
