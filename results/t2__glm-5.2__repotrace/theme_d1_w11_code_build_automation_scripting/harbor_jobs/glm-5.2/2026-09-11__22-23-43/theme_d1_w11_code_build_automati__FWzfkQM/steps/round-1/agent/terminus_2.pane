{
  "environment": "${ENV}",
  "monitor": {
    "interval_sec": 30,
    "endpoints": [
      { "name": "auth",      "url": "http://${DEPLOY_HOST}:${DEPLOY_PORT}/health" },
      { "name": "gateway",   "url": "http://${DEPLOY_HOST}:${DEPLOY_PORT}/status" },
      { "name": "worker",    "url": "http://${DEPLOY_HOST}:${WORKER_PORT_${ENV}}/ping" },
      { "name": "scheduler", "url": "http://${DEPLOY_HOST}:${DEPLOY_PORT}/heartbeat" }
    ],
    "alert_channel": "${ALERT_CHANNEL}"
  }
}
