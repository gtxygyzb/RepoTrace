[?2004l     1	#!/bin/bash
     2	# Build cache management for ForgeKit
     3	#
     4	# Uses timestamp-based caching: each package records a "last built"
     5	# timestamp; a rebuild is triggered when source files are newer or
     6	# when a transitive dependency has been rebuilt more recently.
     7	
     8	FORGE_CACHE_DIR="${FORGE_ROOT}/.forge_cache"
     9	
    10	init_cache() {
    11	    mkdir -p "$FORGE_CACHE_DIR"
    12	}
    13	
    14	# Newest mtime among all files under a package's src/ directory
    15	get_src_mtime() {
    16	    local pkg_name="$1"
    17	    local pkg_dir
    18	    pkg_dir=$(get_package_dir "$pkg_name")
    19	
    20	    local latest=0
    21	    local mtime
    22	    while IFS= read -r -d '' file; do
    23	        mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)
    24	        if (( mtime > latest )); then
    25	            latest=$mtime
    26	        fi
    27	    done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)
    28	
    29	    # Also check Makefile
    30	    if [[ -f "$pkg_dir/Makefile" ]]; then
    31	        mtime=$(stat -c %Y "$pkg_dir/Makefile" 2>/dev/null || echo 0)
    32	        if (( mtime > latest )); then
    33	            latest=$mtime
    34	        fi
    35	    fi
    36	
    37	    echo "$latest"
    38	}
    39	
    40	# Check whether the cached build is still valid.
    41	#
    42	# A package is invalid if:
    43	#   - it has no cache stamp
    44	#   - its own sources/Makefile are newer than its cache stamp
    45	#   - any transitive dependency has no cache stamp
    46	#   - any transitive dependency has a cache stamp newer than this package's
    47	is_cache_valid() {
    48	    local pkg_name="$1"
    49	    init_cache
    50	    local cache_file="$FORGE_CACHE_DIR/${pkg_name}.stamp"
    51	
    52	    if [[ ! -f "$cache_file" ]]; then
    53	        return 1  # No cache -> rebuild
    54	    fi
    55	
    56	    local cached_time
    57	    cached_time=$(cat "$cache_file" 2>/dev/null || echo 0)
    58	    if [[ ! "$cached_time" =~ ^[0-9]+$ ]]; then
    59	        return 1
    60	    fi
    61	
    62	    local src_mtime
    63	    src_mtime=$(get_src_mtime "$pkg_name")
    64	
    65	    if (( src_mtime > cached_time )); then
    66	        return 1  # Source newer than cache -> rebuild
    67	    fi
    68	
    69	    # Invalidate when transitive dependencies were rebuilt more recently.
    70	    local deps
    71	    deps=$(get_all_deps "$pkg_name") || return 1
    72	    local dep dep_cache_file dep_time
    73	    for dep in $deps; do
    74	        [[ -z "$dep" ]] && continue
    75	        dep_cache_file="$FORGE_CACHE_DIR/${dep}.stamp"
    76	        if [[ ! -f "$dep_cache_file" ]]; then
    77	            return 1
    78	        fi
    79	        dep_time=$(cat "$dep_cache_file" 2>/dev/null || echo 0)
    80	        if [[ ! "$dep_time" =~ ^[0-9]+$ ]]; then
    81	            return 1
    82	        fi
    83	        if (( dep_time > cached_time )); then
    84	            return 1
    85	        fi
    86	    done
    87	
    88	    return 0  # Cache is valid
    89	}
    90	
    91	# Record the current time as the build timestamp for a package
    92	update_cache() {
    93	    local pkg_name="$1"
    94	    init_cache
    95	    date +%s > "$FORGE_CACHE_DIR/${pkg_name}.stamp"
    96	}
    97	
    98	# Remove cache entry for a package
    99	invalidate_cache() {
   100	    local pkg_name="$1"
   101	    rm -f "$FORGE_CACHE_DIR/${pkg_name}.stamp"
   102	}
   103	
   104	# Wipe the entire cache directory
   105	clean_cache() {
   106	    rm -rf "$FORGE_CACHE_DIR"
   107	}
     1	#!/bin/bash
     2	# Dependency graph resolution for ForgeKit
     3	#
     4	# Provides topological-sort-based build ordering and
     5	# dependency tree queries.
     6	
     7	# Build an associative array mapping package -> comma-separated deps
     8	build_dep_map() {
     9	    declare -gA DEP_MAP
    10	    # Reset
    11	    local k
    12	    for k in "${!DEP_MAP[@]}"; do unset "DEP_MAP[$k]"; done
    13	
    14	    local pkg_name deps_str
    15	    for pkg_name in $(list_package_names); do
    16	        parse_manifest "$pkg_name"
    17	        deps_str="${MANIFEST_deps:-}"
    18	        DEP_MAP[$pkg_name]="$deps_str"
    19	    done
    20	}
    21	
    22	# Shared DFS helper.  Callers must declare local:
    23	#   declare -A _state
    24	#   declare -a _path
    25	#   local _order=""
    26	_forge_graph_dfs() {
    27	    local node="$1"
    28	
    29	    if [[ -z "${DEP_MAP[$node]+_}" ]]; then
    30	        log_error "Unknown package in dependency graph: $node"
    31	        return 1
    32	    fi
    33	
    34	    case "${_state[$node]:-}" in
    35	        done)
    36	            return 0
    37	            ;;
    38	        visiting)
    39	            local cycle="" in_cycle=0 p
    40	            for p in "${_path[@]}"; do
    41	                if [[ "$p" == "$node" ]]; then
    42	                    in_cycle=1
    43	                fi
    44	                if (( in_cycle )); then
    45	                    cycle="$cycle $p"
    46	                fi
    47	            done
    48	            cycle="$cycle $node"
    49	            cycle="${cycle# }"
    50	            log_error "Circular dependency detected: $(echo "$cycle" | sed 's/ / -> /g')"
    51	            return 1
    52	            ;;
    53	    esac
    54	
    55	    _state[$node]=visiting
    56	    _path+=("$node")
    57	
    58	    local deps="${DEP_MAP[$node]:-}"
    59	    if [[ -n "$deps" ]]; then
    60	        local IFS=','
    61	        for dep in $deps; do
    62	            dep="${dep// /}"
    63	            [[ -z "$dep" ]] && continue
    64	            if ! _forge_graph_dfs "$dep"; then
    65	                return 1
    66	            fi
    67	        done
    68	    fi
    69	
    70	    _state[$node]=done
    71	    _order="$_order $node"
    72	
    73	    if ((${#_path[@]} > 0)); then
    74	        _path=("${_path[@]:0:${#_path[@]}-1}")
    75	    fi
    76	    return 0
    77	}
    78	
    79	# -------------------------------------------------------------------
    80	# Topological sort via DFS with cycle detection.
    81	# -------------------------------------------------------------------
    82	resolve_build_order() {
    83	    build_dep_map
    84	
    85	    declare -A _state
    86	    declare -a _path
    87	    local _order=""
    88	
    89	    for pkg in $(list_package_names); do
    90	        if ! _forge_graph_dfs "$pkg"; then
    91	            return 1
    92	        fi
    93	    done
    94	
    95	    echo "${_order# }"
    96	}
    97	
    98	# Resolve the build chain for a single target (inclusive)
    99	resolve_deps_for() {
   100	    local target="$1"
   101	    build_dep_map
   102	
   103	    if [[ -z "${DEP_MAP[$target]+_}" ]]; then
   104	        log_error "Unknown package: $target"
   105	        return 1
   106	    fi
   107	
   108	    declare -A _state
   109	    declare -a _path
   110	    local _order=""
   111	
   112	    if ! _forge_graph_dfs "$target"; then
   113	        return 1
   114	    fi
   115	
   116	    echo "${_order# }"
   117	}
   118	
   119	# Pretty-print the dependency tree (recursive, indented)
   120	show_dep_tree() {
   121	    local name="$1"
   122	    local indent="${2:-0}"
   123	    local seen="${3:-}"
   124	
   125	    # Ensure the dep map exists
   126	    if [[ -z "${DEP_MAP[*]+_}" ]]; then
   127	        build_dep_map
   128	    fi
   129	
   130	    if [[ " $seen " == *" $name "* ]]; then
   131	        local prefix=""
   132	        local i
   133	        for ((i = 0; i < indent; i++)); do prefix="$prefix  "; done
   134	        echo "${prefix}${name} (cycle)"
   135	        log_warn "Circular dependency detected at $name"
   136	        return 1
   137	    fi
   138	    seen="$seen $name"
   139	
   140	    local prefix=""
   141	    for ((i = 0; i < indent; i++)); do prefix="$prefix  "; done
   142	
   143	    echo "${prefix}${name}"
   144	
   145	    local deps="${DEP_MAP[$name]:-}"
   146	    if [[ -n "$deps" ]]; then
   147	        local IFS=','
   148	        for dep in $deps; do
   149	            dep="${dep// /}"
   150	            [[ -z "$dep" ]] && continue
   151	            show_dep_tree "$dep" $((indent + 1)) "$seen" || true
   152	        done
   153	    fi
   154	}
   155	
   156	# Return all transitive dependencies (not including the package itself)
   157	get_all_deps() {
   158	    local name="$1"
   159	    if [[ -z "${DEP_MAP[*]+_}" ]]; then
   160	        build_dep_map
   161	    fi
   162	
   163	    declare -A _seen
   164	    local _result=""
   165	
   166	    _collect_deps() {
   167	        local node="$1"
   168	        local deps="${DEP_MAP[$node]:-}"
   169	        if [[ -n "$deps" ]]; then
   170	            local IFS=','
   171	            for dep in $deps; do
   172	                dep="${dep// /}"
   173	                [[ -z "$dep" ]] && continue
   174	                if [[ -z "${_seen[$dep]:-}" ]]; then
   175	                    _seen[$dep]=1
   176	                    _result="$_result $dep"
   177	                    _collect_deps "$dep"
   178	                fi
   179	            done
   180	        fi
   181	    }
   182	
   183	    _collect_deps "$name"
   184	    echo "${_result# }"
   185	}
