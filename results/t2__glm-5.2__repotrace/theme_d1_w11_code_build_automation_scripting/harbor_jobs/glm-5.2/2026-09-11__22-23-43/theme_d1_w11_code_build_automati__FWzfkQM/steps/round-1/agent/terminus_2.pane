===== packages/libcrypto/src/crypto.c =====
#include "crypto.h"
#include <string.h>

static unsigned long _hash(const char *s) {
    unsigned long h = 5381;
    int c;
    while ((c = (unsigned char)*s++))
        h = h * 33 + (unsigned long)c;
    return h;
}

unsigned long crypto_sign(const char *data, const char *key) {
    return _hash(data) ^ _hash(key);
}

int crypto_verify(const char *data, const char *key, unsigned long sig) {
    return crypto_sign(data, key) == sig;
}

unsigned long crypto_hmac(const char *msg, const char *secret) {
    unsigned long inner = _hash(msg) ^ 0x36363636UL;
    unsigned long outer = _hash(secret) ^ 0x5c5c5c5cUL;
    return inner ^ outer;
}
