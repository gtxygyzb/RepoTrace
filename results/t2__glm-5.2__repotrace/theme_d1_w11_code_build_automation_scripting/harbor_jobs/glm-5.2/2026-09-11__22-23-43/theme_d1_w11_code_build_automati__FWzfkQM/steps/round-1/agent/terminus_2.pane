    11	init_cache() {
    12	    mkdir -p "$FORGE_CACHE_DIR"
    13	}
    14	
    15	_forge_cache_profile() {
    16	    local profile="${1:-release}"
    17	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
    18	        profile="release"
    19	    fi
    20	    echo "$profile"
    21	}
    22	
    23	# Compute the SHA256 hash of a single file, or empty string if missing.
    24	_file_sha256() {
    25	    local file="$1"
    26	    if [[ -f "$file" ]]; then
    27	        sha256sum "$file" | awk '{print $1}'
    28	    fi
    29	}
    30	
    31	# Compute the source hash for a package:
    32	# SHA256(sorted concatenation of SHA256 hashes of all files in src/
    33	# + Makefile + package.forge).
    34	compute_source_hash() {
    35	    local pkg_name="$1"
    36	    local pkg_dir
    37	    pkg_dir=$(get_package_dir "$pkg_name")
    38	
    39	    local hashes="" hash
    40	    local file
    41	
    42	    while IFS= read -r -d '' file; do
    43	        hash=$(_file_sha256 "$file")
    44	        [[ -n "$hash" ]] && hashes+="$hash\n"
    45	    done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)
    46	
    47	    hash=$(_file_sha256 "$pkg_dir/Makefile")
    48	    [[ -n "$hash" ]] && hashes+="$hash\n"
    49	    hash=$(_file_sha256 "$pkg_dir/package.forge")
    50	    [[ -n "$hash" ]] && hashes+="$hash\n"
    51	
    52	    if [[ -z "$hashes" ]]; then
    53	        # No source files: hash the empty string for stability.
    54	        printf '%s\n' "" | sha256sum | awk '{print $1}'
