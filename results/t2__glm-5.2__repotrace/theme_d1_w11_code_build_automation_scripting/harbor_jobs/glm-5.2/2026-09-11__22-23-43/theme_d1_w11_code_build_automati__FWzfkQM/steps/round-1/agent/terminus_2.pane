   170	
   171	# Internal: schedule packages in dependency order with up to N workers.
   172	# Each package's output is buffered and printed under a header when it
   173	# finishes.  Existing concurrent builds continue on failure, but no new
   174	# packages are started after a failure.
   175	_run_parallel_build() {
   176	    local order="$1" jobs="${2:-1}" profile="${3:-release}"
   177	    jobs=$(( jobs < 1 ? 1 : jobs ))
   178	
   179	    declare -A remaining_deps state failed_pkg
   180	    declare -A active_pids
   181	    local pkg dep deps_str dep_count dep_array
   182	
   183	    for pkg in $order; do
   184	        deps_str="${DEP_MAP[$pkg]:-}"
   185	        dep_count=0
   186	        if [[ -n "$deps_str" ]]; then
   187	            IFS=',' read -ra dep_array <<< "$deps_str"
   188	            for dep in "${dep_array[@]}"; do
   189	                dep="${dep// /}"
   190	                [[ -z "$dep" ]] && continue
   191	                dep_count=$(( dep_count + 1 ))
   192	            done
   193	        fi
   194	        remaining_deps[$pkg]=$dep_count
   195	        state[$pkg]=pending
   196	    done
   197	
   198	    local total=0
   199	    for pkg in $order; do total=$(( total + 1 )); done
   200	    local finished=0 active=0 failed=0
   201	
   202	    local tmpdir
   203	    tmpdir=$(mktemp -d)
   204	
   205	    while (( finished < total )); do
   206	        # Launch ready packages up to the concurrency limit.
   207	        # After a failure, do not start any new packages; allow
   208	        # already-running jobs to complete.
   209	        if (( ! failed )); then
   210	            for pkg in $order; do
   211	                if (( active >= jobs )); then
   212	                    break
   213	                fi
   214	                if [[ "${state[$pkg]}" == "pending" ]] && (( remaining_deps[$pkg] == 0 )); then
   215	                    state[$pkg]=running
   216	                    active=$(( active + 1 ))
   217	                    (
   218	                        {
   219	                            build_package "$pkg" "$profile"
   220	                            echo "__FORGE_BUILD_RC__$?"
   221	                        } > "$tmpdir/$pkg.out" 2>&1
   222	                    ) &
   223	                    active_pids[$!]="$pkg"
   224	                fi
   225	            done
   226	        fi
   227	
   228	        if (( active == 0 )); then
   229	            break
   230	        fi
   231	
   232	        wait -n 2>/dev/null || true
   233	
   234	        local completed=0
   235	        for pid in "${!active_pids[@]}"; do
   236	            if ! kill -0 "$pid" 2>/dev/null; then
   237	                wait "$pid" 2>/dev/null || true
   238	                pkg="${active_pids[$pid]}"
   239	                unset "active_pids[$pid]"
   240	                active=$(( active - 1 ))
   241	                finished=$(( finished + 1 ))
   242	                completed=$(( completed + 1 ))
   243	
   244	                local rc
   245	                rc=$(grep -m1 '__FORGE_BUILD_RC__' "$tmpdir/$pkg.out" | sed 's/.*__FORGE_BUILD_RC__//')
   246	                rc="${rc:-1}"
   247	
   248	                echo "=== [$pkg] ==="
   249	                grep -v '__FORGE_BUILD_RC__' "$tmpdir/$pkg.out"
   250	
   251	                if (( rc == 0 )); then
   252	                    state[$pkg]=done
   253	
   254	                    local dependent dep_deps dep_dep dep_arr
   255	                    for dependent in $order; do
   256	                        if [[ "${state[$dependent]}" == "pending" ]]; then
   257	                            dep_deps="${DEP_MAP[$dependent]:-}"
   258	                            if [[ -n "$dep_deps" ]]; then
   259	                                IFS=',' read -ra dep_arr <<< "$dep_deps"
   260	                                for dep_dep in "${dep_arr[@]}"; do
   261	                                    dep_dep="${dep_dep// /}"
   262	                                    [[ -z "$dep_dep" ]] && continue
   263	                                    if [[ "$dep_dep" == "$pkg" ]]; then
   264	                                        remaining_deps[$dependent]=$(( remaining_deps[$dependent] - 1 ))
   265	                                    fi
   266	                                done
   267	                            fi
   268	                        fi
   269	                    done
   270	                else
   271	                    state[$pkg]=failed
   272	                    failed_pkg[$pkg]=1
   273	                    failed=1
   274	                fi
   275	            fi
   276	        done
   277	
   278	        if (( completed == 0 )); then
   279	            sleep 0.05
   280	        fi
   281	    done
   282	
   283	    rm -rf "$tmpdir"
   284	
   285	    local failures=""
   286	    for pkg in $order; do
   287	        if [[ -n "${failed_pkg[$pkg]:-}" ]]; then
   288	            failures="$failures $pkg"
   289	        fi
   290	    done
   291	
   292	    if [[ -n "$failures" ]]; then
   293	        failures="${failures# }"
   294	        log_error "Build failed for: $failures"
   295	        return 1
   296	    fi
   297	
   298	    return 0
   299	}
