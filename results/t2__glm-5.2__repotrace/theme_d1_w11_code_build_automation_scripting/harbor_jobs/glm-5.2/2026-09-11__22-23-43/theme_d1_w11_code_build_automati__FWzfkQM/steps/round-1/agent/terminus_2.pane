     2	# Common utilities for ForgeKit
     3	
     4	log_info() {
     5	    echo "[FORGE INFO] $*" >&2
     6	}
     7	
     8	log_warn() {
     9	    echo "[FORGE WARN] $*" >&2
    10	}
    11	
    12	log_error() {
    13	    echo "[FORGE ERROR] $*" >&2
