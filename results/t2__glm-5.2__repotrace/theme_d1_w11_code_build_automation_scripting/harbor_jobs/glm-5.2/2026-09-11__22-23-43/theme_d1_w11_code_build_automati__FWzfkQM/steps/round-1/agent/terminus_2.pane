# ForgeKit Internal Test Suite
#
# Tests for the forge build automation system itself.
# Run with: bash tests/run_tests.sh

FORGE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export FORGE_ROOT

source "$FORGE_ROOT/lib/common.sh"
source "$FORGE_ROOT/lib/manifest.sh"
source "$FORGE_ROOT/lib/depgraph.sh"
source "$FORGE_ROOT/lib/builder.sh"
source "$FORGE_ROOT/lib/cache.sh"
source "$FORGE_ROOT/lib/artifact.sh"
source "$FORGE_ROOT/lib/reporter.sh"
source "$FORGE_ROOT/lib/configgen.sh"

TOTAL=0
PASSED=0
FAILED=0

assert_eq() {
    local desc="$1" expected="$2" actual="$3"
    ((TOTAL++))
    if [[ "$expected" == "$actual" ]]; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc"
        echo "    expected: '$expected'"
        echo "    actual:   '$actual'"
        ((FAILED++))
    fi
}

assert_contains() {
    local desc="$1" haystack="$2" needle="$3"
    ((TOTAL++))
    if [[ "$haystack" == *"$needle"* ]]; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc"
        echo "    expected to contain: '$needle'"
        echo "    in: '$haystack'"
        ((FAILED++))
    fi
}

assert_not_contains() {
    local desc="$1" haystack="$2" needle="$3"
    ((TOTAL++))
    if [[ "$haystack" != *"$needle"* ]]; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc"
        echo "    expected NOT to contain: '$needle'"
        echo "    in: '$haystack'"
        ((FAILED++))
    fi
}

assert_exit_zero() {
    local desc="$1"
    shift
    ((TOTAL++))
    if "$@" > /dev/null 2>&1; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc (exit code: $?)"
        ((FAILED++))
    fi
}

assert_exit_nonzero() {
    local desc="$1"
    shift
    ((TOTAL++))
    if "$@" > /dev/null 2>&1; then
        echo "  FAIL: $desc (expected failure but got success)"
        ((FAILED++))
    else
        echo "  PASS: $desc"
        ((PASSED++))
    fi
}

assert_grep() {
    local desc="$1" text="$2" pattern="$3"
    ((TOTAL++))
    if echo "$text" | grep -q "$pattern"; then
        echo "  PASS: $desc"
        ((PASSED++))
    else
        echo "  FAIL: $desc"
        echo "    expected to match: '$pattern'"
        echo "    in: '$text'"
        ((FAILED++))
    fi
}

with_forge_root() {
    local root="$1"
    shift
    FORGE_ROOT="$root" "$@"
}

# ==================================================================
echo ""
echo "=== Manifest Parser Tests ==="

parse_manifest "libbase"
assert_eq "libbase name" "libbase" "${MANIFEST_name:-}"
assert_eq "libbase version" "1.0.0" "${MANIFEST_version:-}"
assert_eq "libbase type" "library" "${MANIFEST_type:-}"
assert_eq "libbase has no deps" "" "${MANIFEST_deps:-}"

parse_manifest "libcrypto"
assert_eq "libcrypto deps" "libbase" "${MANIFEST_deps:-}"

parse_manifest "svc-auth"
assert_eq "svc-auth type" "service" "${MANIFEST_type:-}"
assert_eq "svc-auth deps" "libcrypto,libstore" "${MANIFEST_deps:-}"

assert_exit_nonzero "missing manifest errors" parse_manifest no-such-package

tmp_manifest_root=$(mktemp -d)
mkdir -p "$tmp_manifest_root/packages/pkg-cont"
cat > "$tmp_manifest_root/packages/pkg-cont/package.forge" <<'MANIFEST'
[package]
name = pkg-cont
version = 1.0.0
type = library

description = first part \
              second part
tags = one,two,three
notes = value # inline comment
empty =
MANIFEST

with_forge_root "$tmp_manifest_root" parse_manifest "pkg-cont"
assert_eq "continuation name" "pkg-cont" "${MANIFEST_name:-}"
assert_eq "continuation version" "1.0.0" "${MANIFEST_version:-}"
assert_eq "continuation joined value" "first part second part" "${MANIFEST_description:-}"
assert_eq "continuation preserves normal value" "one,two,three" "${MANIFEST_tags:-}"
assert_eq "inline comment stripped" "value" "${MANIFEST_notes:-}"
assert_eq "empty value parsed" "" "${MANIFEST_empty:-}"
rm -rf "$tmp_manifest_root"

# ==================================================================
echo ""
echo "=== Dependency Graph Tests ==="

build_dep_map
order=$(resolve_build_order)
pkg_count=$(echo "$order" | wc -w)
assert_eq "build order has 8 packages" "8" "$pkg_count"

assert_contains "order contains libbase" "$order" "libbase"
assert_contains "order contains svc-scheduler" "$order" "svc-scheduler"

position() {
    local target="$1" i=0
    for pkg in $order; do
        ((i++))
        [[ "$pkg" == "$target" ]] && { echo "$i"; return; }
    done
