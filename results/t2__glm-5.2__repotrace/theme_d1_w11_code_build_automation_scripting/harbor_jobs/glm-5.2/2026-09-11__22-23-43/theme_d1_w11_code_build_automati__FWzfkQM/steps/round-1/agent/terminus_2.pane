   195	# -------------------------------------------------------------------
   196	# Round 5: cache status command.
   197	# -------------------------------------------------------------------
   198	
   199	# Print a per-package cache status summary.
   200	# Statuses:
   201	#   cached (<first 8 chars of hash>...)
   202	#   stale (src changed)
   203	#   stale (dep NAME changed)
   204	#   no cache
   205	cache_status() {
   206	    local pkg_filter="" profile
   207	    profile="release"
   208	
   209	    while [[ $# -gt 0 ]]; do
   210	        case "$1" in
   211	            --package)
   212	                if [[ $# -lt 2 ]]; then
   213	                    log_error "--package requires a package name"
   214	                    return 1
   215	                fi
   216	                pkg_filter="$2"
   217	                shift
   218	                ;;
   219	            --profile)
   220	                if [[ $# -lt 2 ]]; then
   221	                    log_error "--profile requires a profile name"
   222	                    return 1
   223	                fi
   224	                profile="$2"
   225	                shift
   226	                ;;
   227	            *)
   228	                log_error "Unknown cache status option: $1"
   229	                return 1
   230	                ;;
   231	        esac
   232	        shift
   233	    done
   234	
   235	    profile=$(_forge_cache_profile "$profile")
   236	    init_cache
   237	    build_dep_map
   238	
   239	    printf "%-20s %-10s %s\n" "PACKAGE" "PROFILE" "STATUS"
   240	    printf "%-20s %-10s %s\n" "-------" "-------" "------"
   241	
   242	    local pkg cache_file own_hash stored_hash status deps dep dep_hash stored_dep_hash first_changed
   243	    for pkg in $(list_package_names); do
   244	        if [[ -n "$pkg_filter" && "$pkg" != "$pkg_filter" ]]; then
   245	            continue
   246	        fi
   247	
   248	        cache_file="$FORGE_CACHE_DIR/${pkg}-${profile}.hash"
   249	        if [[ ! -f "$cache_file" ]]; then
   250	            status="no cache"
   251	            printf "%-20s %-10s %s\n" "$pkg" "$profile" "$status"
   252	            continue
   253	        fi
   254	
   255	        own_hash=$(compute_source_hash "$pkg")
   256	        stored_hash=$(_stored_own_hash "$cache_file")
   257	        if [[ -z "$stored_hash" || "$own_hash" != "$stored_hash" ]]; then
   258	            status="stale (src changed)"
   259	            printf "%-20s %-10s %s\n" "$pkg" "$profile" "$status"
   260	            continue
   261	        fi
   262	
   263	        deps=$(get_all_deps "$pkg") || deps=""
   264	        first_changed=""
   265	        for dep in $deps; do
   266	            [[ -z "$dep" ]] && continue
   267	            dep_hash=$(compute_source_hash "$dep")
   268	            stored_dep_hash=$(_stored_dep_hash "$cache_file" "$dep")
   269	            if [[ -z "$stored_dep_hash" || "$dep_hash" != "$stored_dep_hash" ]]; then
   270	                first_changed="$dep"
   271	                break
   272	            fi
   273	        done
   274	
   275	        if [[ -n "$first_changed" ]]; then
   276	            status="stale (dep $first_changed changed)"
   277	            printf "%-20s %-10s %s\n" "$pkg" "$profile" "$status"
   278	        else
   279	            status="cached (${own_hash:0:8}...)"
   280	            printf "%-20s %-10s %s\n" "$pkg" "$profile" "$status"
   281	        fi
   282	    done
   283	}
