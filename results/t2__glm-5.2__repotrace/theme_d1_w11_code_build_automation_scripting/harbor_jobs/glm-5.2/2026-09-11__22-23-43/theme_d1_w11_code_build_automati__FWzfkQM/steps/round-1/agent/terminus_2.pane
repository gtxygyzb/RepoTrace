#ifndef BASE_H
#define BASE_H

int base_version(void);
const char *base_name(void);
unsigned long base_hash(const char *s);
int base_clamp(int value, int lo, int hi);

#endif /* BASE_H */
packages/libbase/src/base.c
#include "base.h"
#include <string.h>

int base_version(void) {
    return 100;
}

const char *base_name(void) {
    return "libbase";
}

unsigned long base_hash(const char *s) {
    unsigned long h = 5381;
    int c;
    while ((c = (unsigned char)*s++))
        h = h * 33 + (unsigned long)c;
    return h;
}

int base_clamp(int value, int lo, int hi) {
    if (value < lo) return lo;
    if (value > hi) return hi;
    return value;
}
packages/libbase/src/libbase.c
packages/libbase/package.forge
[package]
name = libbase
version = 1.0.0
type = library

[deps]

[build]
command = make
test_command = make test
output = build/libbase.a

[meta]
description = Core utility functions used across the monorepo
tags = core,utils,foundation
packages/libbase/Makefile
CC      ?= gcc
CFLAGS  ?= -Wall -Wextra -O2
CFLAGS  += $(FORGE_CFLAGS)
AR      ?= ar

SRC_DIR   = src
BUILD_DIR = build

SOURCES = $(wildcard $(SRC_DIR)/*.c)
OBJECTS = $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SOURCES))
TARGET  = $(BUILD_DIR)/libbase.a

.PHONY: all test clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	@mkdir -p $(BUILD_DIR)
	$(AR) rcs $@ $^

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -I$(SRC_DIR) -c -o $@ $<

test: all
	@echo "libbase: all tests passed"

clean:
	rm -rf $(BUILD_DIR)
	find $(SRC_DIR) -name '*.o' -delete 2>/dev/null || true
