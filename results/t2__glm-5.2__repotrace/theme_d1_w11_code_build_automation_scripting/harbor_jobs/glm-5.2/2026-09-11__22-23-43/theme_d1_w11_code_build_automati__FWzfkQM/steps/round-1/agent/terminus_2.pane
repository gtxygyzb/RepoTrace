assert_contains "order contains svc-scheduler" "$order" "svc-scheduler"

position() {
    local target="$1" i=0
    for pkg in $order; do
        ((i++))
        [[ "$pkg" == "$target" ]] && { echo "$i"; return; }
    done
    echo 0
}

libbase_pos=$(position libbase)
libcrypto_pos=$(position libcrypto)
libstore_pos=$(position libstore)
libnet_pos=$(position libnet)
svc_auth_pos=$(position svc-auth)
svc_scheduler_pos=$(position svc-scheduler)

assert_eq "libbase before libcrypto" "1" "$(( libbase_pos < libcrypto_pos ? 1 : 0 ))"
assert_eq "libbase before libstore" "1" "$(( libbase_pos < libstore_pos ? 1 : 0 ))"
assert_eq "libcrypto before libstore" "1" "$(( libcrypto_pos < libstore_pos ? 1 : 0 ))"
assert_eq "libbase before libnet" "1" "$(( libbase_pos < libnet_pos ? 1 : 0 ))"
assert_eq "libstore before svc-auth" "1" "$(( libstore_pos < svc_auth_pos ? 1 : 0 ))"
assert_eq "libnet before svc-scheduler" "1" "$(( libnet_pos < svc_scheduler_pos ? 1 : 0 ))"

deps_for_auth=$(resolve_deps_for "svc-auth")
assert_contains "svc-auth deps include libcrypto" "$deps_for_auth" "libcrypto"
assert_contains "svc-auth deps include libstore" "$deps_for_auth" "libstore"
assert_contains "svc-auth deps include transitive libbase" "$deps_for_auth" "libbase"
assert_contains "svc-auth deps include itself" "$deps_for_auth" "svc-auth"
assert_eq "svc-auth chain has 4 packages" "4" "$(echo "$deps_for_auth" | wc -w)"

assert_eq "libbase no-dependency chain" "libbase" "$(resolve_deps_for libbase)"

all_deps=$(get_all_deps svc-scheduler)
assert_contains "all deps includes libbase" "$all_deps" "libbase"
assert_contains "all deps includes libcrypto" "$all_deps" "libcrypto"
assert_contains "all deps includes libnet" "$all_deps" "libnet"
assert_contains "all deps includes libstore" "$all_deps" "libstore"
assert_not_contains "all deps excludes package itself" "$all_deps" "svc-scheduler"

# Cycle detection
tmp_cycle_root=$(mktemp -d)
mkdir -p "$tmp_cycle_root/packages/cyc-a" "$tmp_cycle_root/packages/cyc-b"
cat > "$tmp_cycle_root/packages/cyc-a/package.forge" <<'MANIFEST'
[package]
name = cyc-a
version = 1.0.0
type = library

[deps]
deps = cyc-b
MANIFEST
cat > "$tmp_cycle_root/packages/cyc-b/package.forge" <<'MANIFEST'
[package]
name = cyc-b
version = 1.0.0
type = library

[deps]
deps = cyc-a
MANIFEST

cycle_err=$(with_forge_root "$tmp_cycle_root" resolve_build_order 2>&1 >/dev/null) || true
assert_contains "cycle error mentions cyc-a" "$cycle_err" "cyc-a"
assert_contains "cycle error mentions cyc-b" "$cycle_err" "cyc-b"
assert_contains "cycle error says circular" "$cycle_err" "Circular dependency detected"
assert_exit_nonzero "resolve_deps_for cycle fails" with_forge_root "$tmp_cycle_root" resolve_deps_for cyc-a
rm -rf "$tmp_cycle_root"

# Unknown dependency
tmp_unknown_root=$(mktemp -d)
mkdir -p "$tmp_unknown_root/packages/pkg-x"
cat > "$tmp_unknown_root/packages/pkg-x/package.forge" <<'MANIFEST'
