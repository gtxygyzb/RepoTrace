   211	        for pkg_name in $(list_package_names); do
   212	            clean_package "$pkg_name" "$profile"
   213	        done
   214	        clean_cache "$profile"
   215	        if [[ -n "$profile" ]]; then
   216	            log_info "All packages cleaned ($profile)"
   217	        else
   218	            log_info "All packages cleaned (all profiles)"
   219	        fi
   220	    elif [[ "$target" == "package" ]]; then
   221	        clean_package "$pkg" "$profile"
   222	        invalidate_cache "$pkg" "$profile"
   223	    else
   224	        usage
   225	        return 1
   226	    fi
   227	}
   228	
   229	cmd_graph() {
   230	    local reverse=""
   231	    while [[ $# -gt 0 ]]; do
   232	        case "$1" in
   233	            --reverse) if [[ $# -lt 2 ]]; then log_error "--reverse requires a package name"; return 1; fi; reverse="$2"; shift ;;
   234	            *) usage; return 1 ;;
