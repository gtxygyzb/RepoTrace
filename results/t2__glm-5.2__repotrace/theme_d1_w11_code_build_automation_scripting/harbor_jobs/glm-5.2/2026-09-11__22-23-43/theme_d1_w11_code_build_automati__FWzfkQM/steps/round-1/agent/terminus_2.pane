   146	    local pkg="$2" profile="release"
   147	    shift 2
   148	    while [[ $# -gt 0 ]]; do
   149	        case "$1" in
   150	            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
   151	            *) usage; return 1 ;;
   152	        esac
   153	        shift
   154	    done
   155	    validate_profile "$profile" || return 1
   156	    pack_artifact "$pkg" "$profile"
   157	}
   158	
   159	cmd_clean() {
   160	    local target="" pkg="" profile=""
   161	    while [[ $# -gt 0 ]]; do
   162	        case "$1" in
   163	            --all) target="all" ;;
   164	            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;
   165	            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;
   166	            *) usage; return 1 ;;
