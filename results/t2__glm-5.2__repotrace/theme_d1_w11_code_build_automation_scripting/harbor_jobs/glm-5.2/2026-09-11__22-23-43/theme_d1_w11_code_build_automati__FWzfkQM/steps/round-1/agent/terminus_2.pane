   259	                    local dependent dep_deps dep_dep
   260	                    for dependent in $order; do
   261	                        if [[ "${state[$dependent]}" == "pending" ]]; then
   262	                            dep_deps="${DEP_MAP[$dependent]:-}"
   263	                            if [[ -n "$dep_deps" ]]; then
   264	                                local IFS=','
   265	                                for dep_dep in $dep_deps; do
