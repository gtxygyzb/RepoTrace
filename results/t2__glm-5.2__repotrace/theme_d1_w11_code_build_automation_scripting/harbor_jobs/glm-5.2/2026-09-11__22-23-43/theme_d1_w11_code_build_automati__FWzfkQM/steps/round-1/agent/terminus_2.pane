[?2004l     1	#!/bin/bash
     2	# Build cache management for ForgeKit
     3	#
     4	# Uses timestamp-based caching: each package records a "last built"
     5	# timestamp; a rebuild is triggered when source files are newer or
     6	# when a transitive dependency has been rebuilt more recently.
     7	#
     8	# Cache stamps are profile-namespaced so debug and release builds do
     9	# not interfere with each other.
    10	
    11	FORGE_CACHE_DIR="${FORGE_ROOT}/.forge_cache"
    12	
    13	init_cache() {
    14	    mkdir -p "$FORGE_CACHE_DIR"
    15	}
    16	
    17	_forge_cache_profile() {
    18	    local profile="${1:-release}"
    19	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
    20	        profile="release"
    21	    fi
    22	    echo "$profile"
    23	}
    24	
    25	# Newest mtime among all files under a package's src/ directory
    26	get_src_mtime() {
    27	    local pkg_name="$1"
    28	    local pkg_dir
    29	    pkg_dir=$(get_package_dir "$pkg_name")
    30	
    31	    local latest=0
    32	    local mtime
    33	    while IFS= read -r -d '' file; do
    34	        mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)
    35	        if (( mtime > latest )); then
    36	            latest=$mtime
    37	        fi
    38	    done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)
    39	
    40	    # Also check Makefile
    41	    if [[ -f "$pkg_dir/Makefile" ]]; then
    42	        mtime=$(stat -c %Y "$pkg_dir/Makefile" 2>/dev/null || echo 0)
    43	        if (( mtime > latest )); then
    44	            latest=$mtime
    45	        fi
    46	    fi
    47	
    48	    # Manifest changes (version, deps, build command, etc.) must invalidate cache.
    49	    if [[ -f "$pkg_dir/package.forge" ]]; then
    50	        mtime=$(stat -c %Y "$pkg_dir/package.forge" 2>/dev/null || echo 0)
    51	        if (( mtime > latest )); then
    52	            latest=$mtime
    53	        fi
    54	    fi
    55	
    56	    echo "$latest"
    57	}
    58	
    59	# Check whether the cached build is still valid.
    60	#
    61	# A package is invalid if:
    62	#   - it has no cache stamp
    63	#   - its own sources/Makefile are newer than its cache stamp
    64	#   - any transitive dependency has no cache stamp
    65	#   - any transitive dependency has a cache stamp newer than this package's
    66	is_cache_valid() {
    67	    local pkg_name="$1"
    68	    local profile
    69	    profile=$(_forge_cache_profile "${2:-release}")
    70	    init_cache
    71	    local cache_file="$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"
    72	
    73	    if [[ ! -f "$cache_file" ]]; then
    74	        return 1  # No cache -> rebuild
    75	    fi
    76	
    77	    local cached_time
    78	    cached_time=$(cat "$cache_file" 2>/dev/null || echo 0)
    79	    if [[ ! "$cached_time" =~ ^[0-9]+$ ]]; then
    80	        return 1
    81	    fi
    82	
    83	    local src_mtime
    84	    src_mtime=$(get_src_mtime "$pkg_name")
    85	
    86	    if (( src_mtime > cached_time )); then
    87	        return 1  # Source newer than cache -> rebuild
    88	    fi
    89	
    90	    # Invalidate when transitive dependencies were rebuilt more recently.
    91	    local deps
    92	    deps=$(get_all_deps "$pkg_name") || return 1
    93	    local dep dep_cache_file dep_time
    94	    for dep in $deps; do
    95	        [[ -z "$dep" ]] && continue
    96	        dep_cache_file="$FORGE_CACHE_DIR/${dep}-${profile}.stamp"
    97	        if [[ ! -f "$dep_cache_file" ]]; then
    98	            return 1
    99	        fi
   100	        dep_time=$(cat "$dep_cache_file" 2>/dev/null || echo 0)
   101	        if [[ ! "$dep_time" =~ ^[0-9]+$ ]]; then
   102	            return 1
   103	        fi
   104	        if (( dep_time > cached_time )); then
   105	            return 1
   106	        fi
   107	    done
   108	
   109	    return 0  # Cache is valid
   110	}
   111	
   112	# Record the current time as the build timestamp for a package
   113	update_cache() {
   114	    local pkg_name="$1"
   115	    local profile
   116	    profile=$(_forge_cache_profile "${2:-release}")
   117	    init_cache
   118	    date +%s > "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"
   119	}
   120	
   121	# Remove cache entry for a package.  When a profile is supplied, only that
   122	# profile's stamp is removed.  Without a profile, all profile stamps for the
   123	# package are invalidated.
   124	invalidate_cache() {
   125	    local pkg_name="$1"
   126	    local profile
   127	    if [[ -n "${2:-}" ]]; then
   128	        profile=$(_forge_cache_profile "$2")
   129	        rm -f "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"
   130	    else
   131	        rm -f "$FORGE_CACHE_DIR/${pkg_name}-"*.stamp
   132	    fi
   133	}
   134	
   135	# Wipe cache entries.  With a profile argument, only that profile is
   136	# removed.  Without an argument, all cache entries are removed.
   137	clean_cache() {
   138	    local profile
   139	    profile=$(_forge_cache_profile "${1:-}")
   140	    init_cache
   141	    if [[ -n "$1" ]]; then
   142	        rm -f "$FORGE_CACHE_DIR"/*-${profile}.stamp
   143	    else
   144	        rm -rf "$FORGE_CACHE_DIR"
   145	    fi
   146	}
[?2004hroot@n30009:/app# nl -ba lib/builder.sh | sed -n '1,360p'
[?2004l     1	#!/bin/bash
     2	# Build executor for ForgeKit
     3	#
     4	# Builds packages by running their Makefile in the correct environment.
     5	
     6	# Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.
     7	# Includes include and library paths for the full transitive dependency
     8	# closure, not just direct dependencies.
     9	#
    10	# Usage: setup_build_env PKG [PROFILE]
    11	setup_build_env() {
    12	    local pkg_name="$1"
    13	    local profile="${2:-release}"
    14	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
    15	        log_error "Invalid profile: $profile"
    16	        return 1
    17	    fi
    18	    parse_manifest "$pkg_name"
    19	
    20	    local cflags=""
    21	    local ldflags=""
    22	    local libs=""
    23	    local deps
    24	
    25	    deps=$(get_all_deps "$pkg_name") || return 1
    26	
    27	    declare -A seen
    28	    local dep dep_dir
    29	    for dep in $deps; do
    30	        [[ -z "$dep" ]] && continue
    31	        [[ -n "${seen[$dep]:-}" ]] && continue
    32	        seen[$dep]=1
    33	
    34	        dep_dir=$(get_package_dir "$dep")
    35	        cflags="$cflags -I${dep_dir}/src"
    36	        ldflags="$ldflags -L${dep_dir}/build/${profile}"
    37	
    38	        # For services linking against libraries
    39	        parse_manifest "$dep"
    40	        if [[ "${MANIFEST_type:-}" == "library" ]]; then
    41	            libs="$libs ${dep_dir}/build/${profile}/${dep}.a"
    42	        fi
    43	    done
    44	
    45	    case "$profile" in
    46	        debug)   cflags="$cflags -g -O0 -DDEBUG" ;;
    47	        release) cflags="$cflags -O2 -DNDEBUG -s" ;;
    48	    esac
    49	
    50	    export FORGE_CFLAGS="$cflags"
    51	    export FORGE_LDFLAGS="$ldflags"
    52	    export FORGE_LIBS="$libs"
    53	}
    54	
    55	# Build a single package
    56	build_package() {
    57	    local pkg_name="$1"
    58	    local profile="${2:-release}"
    59	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
    60	        log_error "Invalid profile: $profile"
    61	        return 1
    62	    fi
    63	    local pkg_dir
    64	    pkg_dir=$(get_package_dir "$pkg_name")
    65	
    66	    if [[ ! -d "$pkg_dir" ]]; then
    67	        log_error "Package directory not found: $pkg_dir"
    68	        return 1
    69	    fi
    70	
    71	    # Check cache
    72	    if is_cache_valid "$pkg_name" "$profile" 2>/dev/null; then
    73	        log_info "[$pkg_name] Up to date (cached)"
    74	        return 0
    75	    fi
    76	
    77	    log_info "[$pkg_name] Building..."
    78	
    79	    # Parse manifest for build command
    80	    parse_manifest "$pkg_name"
    81	    local build_cmd="${MANIFEST_command:-make}"
    82	    case "$build_cmd" in
    83	        *make*) build_cmd="$build_cmd BUILD_DIR=build/${profile}" ;;
    84	    esac
    85	
    86	    # Set up build environment
    87	    if ! setup_build_env "$pkg_name" "$profile"; then
    88	        log_error "[$pkg_name] Failed to set up build environment"
    89	        return 1
    90	    fi
    91	
    92	    # Execute build
    93	    if ! (cd "$pkg_dir" && BUILD_DIR="build/${profile}" eval "$build_cmd" 2>&1); then
    94	        log_error "[$pkg_name] Build failed"
    95	        return 1
    96	    fi
    97	
    98	    # Update cache
    99	    update_cache "$pkg_name" "$profile"
   100	
   101	    log_info "[$pkg_name] Build successful"
   102	    return 0
   103	}
   104	
   105	# Run tests for a single package
   106	test_package() {
   107	    local pkg_name="$1"
   108	    local profile="${2:-release}"
   109	    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
   110	        log_error "Invalid profile: $profile"
   111	        return 1
   112	    fi
   113	    local pkg_dir
   114	    pkg_dir=$(get_package_dir "$pkg_name")
   115	
   116	    parse_manifest "$pkg_name"
   117	    local test_cmd="${MANIFEST_test_command:-make test}"
   118	    case "$test_cmd" in
   119	        *make*) test_cmd="$test_cmd BUILD_DIR=build/${profile}" ;;
   120	    esac
   121	
   122	    if ! setup_build_env "$pkg_name" "$profile"; then
   123	        log_error "[$pkg_name] Failed to set up build environment"
   124	        return 1
   125	    fi
   126	
   127	    log_info "[$pkg_name] Running tests..."
   128	    if ! (cd "$pkg_dir" && BUILD_DIR="build/${profile}" eval "$test_cmd" 2>&1); then
   129	        log_error "[$pkg_name] Tests failed"
   130	        return 1
   131	    fi
   132	
   133	    log_info "[$pkg_name] Tests passed"
   134	    return 0
   135	}
   136	
   137	_test_package_chain() {
   138	    local target="$1" profile="$2"
   139	    local order pkg
   140	    order=$(resolve_deps_for "$target") || return 1
   141	    for pkg in $order; do
   142	        build_package "$pkg" "$profile" || return 1
   143	    done
   144	}
   145	
   146	test_package_chain() {
   147	    local target="$1" profile="${2:-release}"
   148	    local order pkg
   149	    order=$(resolve_deps_for "$target") || return 1
   150	    for pkg in $order; do
   151	        test_package "$pkg" "$profile" || return 1
   152	    done
   153	}
   154	
   155	# Build a single target and its dependency chain with optional parallelism.
   156	build_packages_for_target() {
   157	    local target="$1" jobs="${2:-1}" profile="${3:-release}"
   158	    local order
   159	    order=$(resolve_deps_for "$target") || return 1
   160	    _run_parallel_build "$order" "$jobs" "$profile"
