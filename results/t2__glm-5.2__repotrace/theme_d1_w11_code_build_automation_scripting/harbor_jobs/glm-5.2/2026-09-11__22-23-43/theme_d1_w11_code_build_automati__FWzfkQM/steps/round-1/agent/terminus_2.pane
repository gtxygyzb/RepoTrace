   168	        shift
   169	    done
   170	
   171	    if [[ -n "$profile" ]]; then
   172	        validate_profile "$profile" || return 1
   173	    fi
   174	
   175	    if [[ "$target" == "all" ]]; then
   176	        for pkg_name in $(list_package_names); do
   177	            clean_package "$pkg_name" "$profile"
   178	        done
   179	        clean_cache "$profile"
   180	        if [[ -n "$profile" ]]; then
   181	            log_info "All packages cleaned ($profile)"
   182	        else
   183	            log_info "All packages cleaned (all profiles)"
   184	        fi
   185	    elif [[ "$target" == "package" ]]; then
   186	        clean_package "$pkg" "$profile"
   187	        invalidate_cache "$pkg" "$profile"
   188	    else
   189	        usage
   190	        return 1
   191	    fi
   192	}
   193	
   194	cmd_graph() {
   195	    local reverse=""
   196	    while [[ $# -gt 0 ]]; do
   197	        case "$1" in
   198	            --reverse) if [[ $# -lt 2 ]]; then log_error "--reverse requires a package name"; return 1; fi; reverse="$2"; shift ;;
   199	            *) usage; return 1 ;;
