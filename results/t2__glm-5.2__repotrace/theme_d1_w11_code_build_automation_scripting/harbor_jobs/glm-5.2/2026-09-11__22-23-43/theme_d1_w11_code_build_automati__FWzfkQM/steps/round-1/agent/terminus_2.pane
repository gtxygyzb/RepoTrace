[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Build cache management for ForgeKit
[?2004l[?2004h> #
[?2004l[?2004h> # Content-addressable cache: each package records a SHA256 source hash
[?2004l[?2004h> # and the source hashes of all transitive dependencies at build time.
[?2004l[?2004h> # Cache stamps are profile-namespaced so debug and release builds do
[?2004l[?2004h> # not interfere with each other.
[?2004l[?2004h> 
[?2004l[?2004h> FORGE_CACHE_DIR="${FORGE_ROOT}/.forge_cache"
[?2004l[?2004h> 
[?2004l[?2004h> init_cache() {
[?2004l[?2004h>     mkdir -p "$FORGE_CACHE_DIR"
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> _forge_cache_profile() {
[?2004l[?2004h>     local profile="${1:-release}"
[?2004l[?2004h>     if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
[?2004l[?2004h>         profile="release"
[?2004l[?2004h>     fi
[?2004l[?2004h>     echo "$profile"
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Compute the SHA256 hash of a single file, or empty string if missing.
[?2004l[?2004h> _file_sha256() {
[?2004l[?2004h>     local file="$1"
[?2004l[?2004h>     if [[ -f "$file" ]]; then
[?2004l[?2004h>         sha256sum "$file" | awk '{print $1}'
[?2004l[?2004h>     fi
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Compute the source hash for a package:
[?2004l[?2004h> # SHA256(sorted concatenation of SHA256 hashes of all files in src/
[?2004l[?2004h> # + Makefile + package.forge).
[?2004l[?2004h> compute_source_hash() {
[?2004l[?2004h>     local pkg_name="$1"
[?2004l[?2004h>     local pkg_dir
[?2004l[?2004h>     pkg_dir=$(get_package_dir "$pkg_name")
[?2004l[?2004h> 
[?2004l[?2004h>     local hashes="" hash
[?2004l[?2004h>     local file
[?2004l[?2004h> 
[?2004l[?2004h>     while IFS= read -r -d '' file; do
[?2004l[?2004h>         hash=$(_file_sha256 "$file")
[?2004l[?2004h>         [[ -n "$hash" ]] && hashes+="$hash\n"
[?2004l[?2004h>     done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)
[?2004l[?2004h> 
[?2004l[?2004h>     hash=$(_file_sha256 "$pkg_dir/Makefile")
[?2004l[?2004h>     [[ -n "$hash" ]] && hashes+="$hash\n"
[?2004l[?2004h>     hash=$(_file_sha256 "$pkg_dir/package.forge")
[?2004l[?2004h>     [[ -n "$hash" ]] && hashes+="$hash\n"
[?2004l[?2004h> 
[?2004l[?2004h>     if [[ -z "$hashes" ]]; then
[?2004l[?2004h>         # No source files: hash the empty string for stability.
[?2004l[?2004h>         printf '%s\n' "" | sha256sum | awk '{print $1}'
[?2004l[?2004h>         return 0
[?2004l[?2004h>     fi
[?2004l[?2004h> 
[?2004l[?2004h>     printf '%b' "$hashes" | sort | sha256sum | awk '{print $1}'
