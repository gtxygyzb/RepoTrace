   234	        echo "  "$pkg";"
   235	    done
   236	
   237	    local deps dep
   238	    for pkg in "${!DEP_MAP[@]}"; do
   239	        deps="${DEP_MAP[$pkg]:-}"
   240	        if [[ -n "$deps" ]]; then
   241	            local IFS=','
   242	            for dep in $deps; do
   243	                dep="${dep// /}"
   244	                [[ -z "$dep" ]] && continue
   245	                echo "  "$pkg" -> "$dep";"
   246	            done
   247	        fi
   248	    done
   249	    echo "}"
   250	}
   251	
   252	print_reverse_graph() {
   253	    local target="$1"
   254	    build_dep_map
   255	
   256	    if [[ -z "${DEP_MAP[$target]+_}" ]]; then
   257	        log_error "Unknown package: $target"
   258	        return 1
   259	    fi
   260	
   261	    declare -A included=([$target]=1)
   262	    local rev
   263	    rev=$(get_all_reverse_deps "$target") || return 1
   264	    local pkg
   265	    for pkg in $rev; do
   266	        included[$pkg]=1
   267	    done
   268	
   269	    echo "digraph forgekit {"
   270	    echo "  rankdir=LR;"
   271	    for pkg in "${!included[@]}"; do
   272	        echo "  "$pkg";"
   273	    done
   274	
   275	    local deps dep
   276	    for pkg in "${!included[@]}"; do
   277	        deps="${DEP_MAP[$pkg]:-}"
   278	        if [[ -n "$deps" ]]; then
   279	            local IFS=','
   280	            for dep in $deps; do
   281	                dep="${dep// /}"
   282	                [[ -z "$dep" ]] && continue
   283	                if [[ -n "${included[$dep]:-}" ]]; then
   284	                    echo "  "$pkg" -> "$dep";"
   285	                fi
   286	            done
   287	        fi
   288	    done
   289	    echo "}"
   290	}
