[?2004l     1	#!/bin/bash
     2	# Dependency graph resolution for ForgeKit
     3	#
     4	# Provides topological-sort-based build ordering and
     5	# dependency tree queries.
     6	
     7	# Build an associative array mapping package -> comma-separated deps
     8	build_dep_map() {
     9	    declare -gA DEP_MAP
    10	    # Reset
    11	    local k
    12	    for k in "${!DEP_MAP[@]}"; do unset "DEP_MAP[$k]"; done
    13	
    14	    local pkg_name deps_str
    15	    for pkg_name in $(list_package_names); do
    16	        parse_manifest "$pkg_name"
    17	        deps_str="${MANIFEST_deps:-}"
    18	        DEP_MAP[$pkg_name]="$deps_str"
    19	    done
    20	}
    21	
    22	# Shared DFS helper.  Callers must declare local:
    23	#   declare -A _state
    24	#   declare -a _path
    25	#   local _order=""
    26	_forge_graph_dfs() {
    27	    local node="$1"
    28	
    29	    if [[ -z "${DEP_MAP[$node]+_}" ]]; then
    30	        log_error "Unknown package in dependency graph: $node"
    31	        return 1
    32	    fi
    33	
    34	    case "${_state[$node]:-}" in
    35	        done)
    36	            return 0
    37	            ;;
    38	        visiting)
    39	            local cycle="" in_cycle=0 p
    40	            for p in "${_path[@]}"; do
    41	                if [[ "$p" == "$node" ]]; then
    42	                    in_cycle=1
    43	                fi
    44	                if (( in_cycle )); then
    45	                    cycle="$cycle $p"
    46	                fi
    47	            done
    48	            cycle="$cycle $node"
    49	            cycle="${cycle# }"
    50	            log_error "Circular dependency detected: $(echo "$cycle" | sed 's/ / -> /g')"
    51	            return 1
    52	            ;;
    53	    esac
    54	
    55	    _state[$node]=visiting
    56	    _path+=("$node")
    57	
    58	    local deps="${DEP_MAP[$node]:-}"
    59	    if [[ -n "$deps" ]]; then
    60	        local IFS=','
    61	        for dep in $deps; do
    62	            dep="${dep// /}"
    63	            [[ -z "$dep" ]] && continue
    64	            if ! _forge_graph_dfs "$dep"; then
    65	                return 1
    66	            fi
    67	        done
    68	    fi
    69	
    70	    _state[$node]=done
    71	    _order="$_order $node"
    72	
    73	    if ((${#_path[@]} > 0)); then
    74	        _path=("${_path[@]:0:${#_path[@]}-1}")
    75	    fi
    76	    return 0
    77	}
    78	
    79	# -------------------------------------------------------------------
    80	# Topological sort via DFS with cycle detection.
    81	# -------------------------------------------------------------------
    82	resolve_build_order() {
    83	    build_dep_map
    84	
    85	    declare -A _state
    86	    declare -a _path
    87	    local _order=""
    88	
    89	    for pkg in $(list_package_names); do
    90	        if ! _forge_graph_dfs "$pkg"; then
    91	            return 1
    92	        fi
    93	    done
    94	
    95	    echo "${_order# }"
    96	}
    97	
    98	# Resolve the build chain for a single target (inclusive)
    99	resolve_deps_for() {
   100	    local target="$1"
   101	    build_dep_map
   102	
   103	    if [[ -z "${DEP_MAP[$target]+_}" ]]; then
   104	        log_error "Unknown package: $target"
   105	        return 1
   106	    fi
   107	
   108	    declare -A _state
   109	    declare -a _path
   110	    local _order=""
   111	
   112	    if ! _forge_graph_dfs "$target"; then
   113	        return 1
   114	    fi
   115	
   116	    echo "${_order# }"
   117	}
   118	
   119	# Pretty-print the dependency tree (recursive, indented)
   120	show_dep_tree() {
   121	    local name="$1"
   122	    local indent="${2:-0}"
   123	    local seen="${3:-}"
   124	
   125	    # Ensure the dep map exists
   126	    if [[ -z "${DEP_MAP[*]+_}" ]]; then
   127	        build_dep_map
   128	    fi
   129	
   130	    if [[ " $seen " == *" $name "* ]]; then
   131	        local prefix=""
   132	        local i
   133	        for ((i = 0; i < indent; i++)); do prefix="$prefix  "; done
   134	        echo "${prefix}${name} (cycle)"
   135	        log_warn "Circular dependency detected at $name"
   136	        return 1
   137	    fi
   138	    seen="$seen $name"
   139	
   140	    local prefix=""
   141	    for ((i = 0; i < indent; i++)); do prefix="$prefix  "; done
   142	
   143	    echo "${prefix}${name}"
   144	
   145	    local deps="${DEP_MAP[$name]:-}"
   146	    if [[ -n "$deps" ]]; then
   147	        local IFS=','
   148	        for dep in $deps; do
   149	            dep="${dep// /}"
   150	            [[ -z "$dep" ]] && continue
   151	            show_dep_tree "$dep" $((indent + 1)) "$seen" || true
   152	        done
   153	    fi
   154	}
   155	
   156	# Return all transitive dependencies (not including the package itself)
   157	get_all_deps() {
   158	    local name="$1"
   159	    if [[ -z "${DEP_MAP[*]+_}" ]]; then
   160	        build_dep_map
   161	    fi
   162	
   163	    declare -A _seen
   164	    local _result=""
   165	
   166	    _collect_deps() {
   167	        local node="$1"
   168	        local deps="${DEP_MAP[$node]:-}"
   169	        if [[ -n "$deps" ]]; then
   170	            local IFS=','
   171	            for dep in $deps; do
   172	                dep="${dep// /}"
   173	                [[ -z "$dep" ]] && continue
   174	                if [[ -z "${_seen[$dep]:-}" ]]; then
   175	                    _seen[$dep]=1
   176	                    _result="$_result $dep"
   177	                    _collect_deps "$dep"
   178	                fi
   179	            done
   180	        fi
   181	    }
   182	
   183	    _collect_deps "$name"
   184	    echo "${_result# }"
   185	}
