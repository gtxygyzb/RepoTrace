===== templates/deploy.yaml.tpl =====
# Deployment Configuration
# Generated by ForgeKit config generator

environment: ${ENV}
region: ${REGION_${ENV}}

services:
  auth:
    host: ${DEPLOY_HOST}
    port: ${DEPLOY_PORT}
    version: ${VERSION_svc_auth}
  gateway:
    host: ${DEPLOY_HOST}
    port: ${DEPLOY_PORT}
    version: ${VERSION_svc_gateway}
  worker:
    host: ${DEPLOY_HOST}
    port: ${WORKER_PORT_${ENV}}
    version: ${VERSION_svc_worker}
  scheduler:
    host: ${DEPLOY_HOST}
    port: ${DEPLOY_PORT}
    version: ${VERSION_svc_scheduler}

database:
  host: ${DB_HOST_${ENV}}
  port: 5432
  name: ${DB_NAME_${ENV}}
