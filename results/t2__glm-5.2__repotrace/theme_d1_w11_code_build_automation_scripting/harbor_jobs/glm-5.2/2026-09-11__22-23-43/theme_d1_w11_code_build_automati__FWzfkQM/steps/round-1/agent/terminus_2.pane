[?2004l     1	#!/bin/bash
     2	# Artifact packaging for ForgeKit
     3	#
     4	# Packs a package's build output into a distributable tarball.
     5	
     6	pack_artifact() {
     7	    local pkg_name="$1"
     8	    local pkg_dir
     9	    pkg_dir=$(get_package_dir "$pkg_name")
    10	
    11	    parse_manifest "$pkg_name"
    12	    local version="${MANIFEST_version:-0.0.0}"
    13	
    14	    local build_dir="$pkg_dir/build"
    15	    if [[ ! -d "$build_dir" ]]; then
    16	        log_error "Build directory not found for $pkg_name. Run 'forge build' first."
    17	        return 1
    18	    fi
    19	
    20	    local artifact_dir="$FORGE_ROOT/artifacts"
    21	    mkdir -p "$artifact_dir"
    22	
    23	    local artifact_name="${pkg_name}-${version}.tar.gz"
    24	
    25	    # BUG: The tarball only contains build/ output.
    26	    # It should also include a deps.manifest file listing the direct
    27	    # dependencies and their versions so downstream deployment tooling
    28	    # can verify compatibility.  Currently there is no such metadata,
    29	    # making it impossible to check whether two artifacts were built
    30	    # against compatible dependency versions.
    31	
    32	    tar -czf "$artifact_dir/$artifact_name" \
    33	        -C "$pkg_dir" \
    34	        build/ 2>/dev/null
    35	
    36	    if [[ $? -ne 0 ]]; then
    37	        log_error "Failed to create artifact for $pkg_name"
    38	        return 1
    39	    fi
    40	
    41	    log_info "Packed artifact: $artifact_name -> $artifact_dir/$artifact_name"
    42	    echo "$artifact_dir/$artifact_name"
    43	}
[?2004hroot@n30009:/app# nl -ba lib/configgen.sh | sed -n '1,260p'
[?2004l     1	#!/bin/bash
     2	# Deployment config generator for ForgeKit
     3	#
     4	# Processes template files (*.tpl) by substituting ${VAR} references
     5	# with values from environment-specific config files and built-in vars.
     6	
     7	generate_config() {
     8	    local env="$1"
     9	    local template_dir="$FORGE_ROOT/templates"
    10	
    11	    if [[ ! -d "$template_dir" ]]; then
    12	        log_error "Templates directory not found: $template_dir"
    13	        return 1
    14	    fi
    15	
    16	    # Build variable map -----------------------------------------------
    17	    declare -A config_vars
    18	    config_vars[ENV]="$env"
    19	    config_vars[FORGE_ROOT]="$FORGE_ROOT"
    20	    config_vars[TIMESTAMP]="$(date -u +%Y%m%dT%H%M%SZ)"
    21	
    22	    # Load environment-specific config if it exists
    23	    local env_conf="$FORGE_ROOT/config/${env}.conf"
    24	    if [[ -f "$env_conf" ]]; then
    25	        local key value
    26	        while IFS='=' read -r key value; do
    27	            [[ "$key" =~ ^[[:space:]]*# ]] && continue
    28	            [[ -z "$key" ]] && continue
    29	            key=$(echo "$key" | tr -d '[:space:]')
    30	            value=$(echo "$value" | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')
    31	            config_vars[$key]="$value"
    32	        done < "$env_conf"
    33	    fi
    34	
    35	    # Inject per-package version variables
    36	    for pkg_name in $(list_package_names); do
    37	        parse_manifest "$pkg_name"
    38	        local safe_name="${pkg_name//-/_}"
    39	        config_vars["VERSION_${safe_name}"]="${MANIFEST_version:-0.0.0}"
    40	    done
    41	
    42	    # Process each template file ---------------------------------------
    43	    mkdir -p "$FORGE_ROOT/generated"
    44	
    45	    for tpl in "$template_dir"/*.tpl; do
    46	        [[ -f "$tpl" ]] || continue
    47	        local outname
    48	        outname=$(basename "$tpl" .tpl)
    49	        local outfile="$FORGE_ROOT/generated/${outname}"
    50	
    51	        local content
    52	        content=$(cat "$tpl")
    53	
    54	        # Simple single-pass variable substitution.
    55	        #
    56	        # BUG: Only resolves flat ${VAR} references.  Nested patterns
    57	        # such as ${REGION_${ENV}} are not handled — the inner ${ENV}
    58	        # is never expanded first, so the entire token is left as-is.
    59	        # A correct implementation would iteratively (or recursively)
    60	        # resolve inner references before resolving the outer one.
    61	        for var_name in "${!config_vars[@]}"; do
    62	            content="${content//\$\{${var_name}\}/${config_vars[$var_name]}}"
    63	        done
    64	
    65	        echo "$content" > "$outfile"
    66	        log_info "Generated config: $outfile"
    67	    done
    68	}
[?2004hroot@n30009:/app# nl -ba lib/reporter.sh | sed -n '1,220p'
[?2004l     1	#!/bin/bash
     2	# Build report generator for ForgeKit
     3	
     4	generate_report() {
     5	    echo "========================================="
     6	    echo "  ForgeKit Build Report"
     7	    echo "========================================="
     8	    echo "  Date: $(date '+%Y-%m-%d %H:%M:%S')"
     9	    echo "========================================="
    10	    echo ""
    11	
    12	    # BUG: The "%-12s" format specifier silently truncates any package
    13	    # name longer than 12 characters.  For example "svc-scheduler"
    14	    # (13 chars) is printed as "svc-schedule" in the report.  Package
    15	    # names should be displayed in full with proper column alignment.
    16	
    17	    printf "%-12s  %-10s  %-10s  %-8s  %s\n" \
    18	        "PACKAGE" "VERSION" "TYPE" "STATUS" "CACHED"
    19	    printf "%-12s  %-10s  %-10s  %-8s  %s\n" \
    20	        "-------" "-------" "----" "------" "------"
    21	
    22	    for pkg_name in $(list_package_names); do
    23	        parse_manifest "$pkg_name"
    24	        local version="${MANIFEST_version:-?}"
    25	        local type="${MANIFEST_type:-?}"
    26	        local pkg_dir
    27	        pkg_dir=$(get_package_dir "$pkg_name")
    28	
    29	        local status="pending"
    30	        if [[ -d "$pkg_dir/build" ]]; then
    31	            status="built"
    32	        fi
    33	
    34	        local cached="no"
    35	        if is_cache_valid "$pkg_name" 2>/dev/null; then
    36	            cached="yes"
    37	        fi
    38	
    39	        printf "%-12s  %-10s  %-10s  %-8s  %s\n" \
    40	            "$pkg_name" "$version" "$type" "$status" "$cached"
    41	    done
    42	
    43	    echo ""
    44	    echo "Total packages: $(list_package_names | wc -w)"
    45	}
