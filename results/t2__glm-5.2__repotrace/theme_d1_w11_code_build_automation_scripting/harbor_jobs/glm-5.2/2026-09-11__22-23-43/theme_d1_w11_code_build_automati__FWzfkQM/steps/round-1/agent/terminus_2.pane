[?2004l     1	#!/bin/bash
     2	# Dependency graph resolution for ForgeKit
     3	#
     4	# Provides topological-sort-based build ordering and
     5	# dependency tree queries.
     6	
     7	# Build an associative array mapping package -> comma-separated deps
     8	build_dep_map() {
     9	    declare -gA DEP_MAP
    10	    # Reset
    11	    local k
    12	    for k in "${!DEP_MAP[@]}"; do unset "DEP_MAP[$k]"; done
    13	
    14	    local pkg_name deps_str
    15	    for pkg_name in $(list_package_names); do
    16	        parse_manifest "$pkg_name"
    17	        deps_str="${MANIFEST_deps:-}"
    18	        DEP_MAP[$pkg_name]="$deps_str"
    19	    done
    20	}
    21	
    22	# Shared DFS helper.  Callers must declare local:
    23	#   declare -A _state
    24	#   declare -a _path
    25	#   local _order=""
    26	_forge_graph_dfs() {
    27	    local node="$1"
    28	
    29	    if [[ -z "${DEP_MAP[$node]+_}" ]]; then
    30	        log_error "Unknown package in dependency graph: $node"
    31	        return 1
    32	    fi
    33	
    34	    case "${_state[$node]:-}" in
    35	        done)
    36	            return 0
    37	            ;;
    38	        visiting)
    39	            local cycle="" in_cycle=0 p
    40	            for p in "${_path[@]}"; do
    41	                if [[ "$p" == "$node" ]]; then
    42	                    in_cycle=1
    43	                fi
    44	                if (( in_cycle )); then
    45	                    cycle="$cycle $p"
    46	                fi
    47	            done
    48	            cycle="$cycle $node"
    49	            cycle="${cycle# }"
    50	            log_error "Circular dependency detected: $(echo "$cycle" | sed 's/ / -> /g')"
    51	            return 1
    52	            ;;
    53	    esac
    54	
    55	    _state[$node]=visiting
    56	    _path+=("$node")
    57	
    58	    local deps="${DEP_MAP[$node]:-}"
    59	    if [[ -n "$deps" ]]; then
    60	        local IFS=','
    61	        for dep in $deps; do
    62	            dep="${dep// /}"
    63	            [[ -z "$dep" ]] && continue
    64	            if ! _forge_graph_dfs "$dep"; then
    65	                return 1
    66	            fi
    67	        done
    68	    fi
    69	
    70	    _state[$node]=done
    71	    _order="$_order $node"
    72	
    73	    if ((${#_path[@]} > 0)); then
    74	        _path=("${_path[@]:0:${#_path[@]}-1}")
    75	    fi
    76	    return 0
    77	}
    78	
    79	# -------------------------------------------------------------------
    80	# Topological sort via DFS with cycle detection.
    81	# -------------------------------------------------------------------
    82	resolve_build_order() {
    83	    build_dep_map
    84	
    85	    declare -A _state
    86	    declare -a _path
    87	    local _order=""
    88	
    89	    for pkg in $(list_package_names); do
    90	        if ! _forge_graph_dfs "$pkg"; then
    91	            return 1
    92	        fi
    93	    done
    94	
    95	    echo "${_order# }"
    96	}
    97	
    98	# Resolve the build chain for a single target (inclusive)
    99	resolve_deps_for() {
   100	    local target="$1"
   101	    build_dep_map
   102	
   103	    if [[ -z "${DEP_MAP[$target]+_}" ]]; then
   104	        log_error "Unknown package: $target"
   105	        return 1
   106	    fi
   107	
   108	    declare -A _state
   109	    declare -a _path
   110	    local _order=""
   111	
   112	    if ! _forge_graph_dfs "$target"; then
   113	        return 1
   114	    fi
   115	
   116	    echo "${_order# }"
   117	}
   118	
   119	# Pretty-print the dependency tree (recursive, indented)
   120	show_dep_tree() {
   121	    local name="$1"
   122	    local indent="${2:-0}"
   123	    local seen="${3:-}"
   124	
   125	    # Ensure the dep map exists
   126	    if [[ -z "${DEP_MAP[*]+_}" ]]; then
   127	        build_dep_map
   128	    fi
   129	
   130	    parse_manifest "$name"
   131	    local indent_str=""
   132	    local i
   133	    for (( i=0; i<indent; i++ )); do
   134	        indent_str+="  "
   135	    done
   136	
   137	    echo "${indent_str}${name} (${MANIFEST_version:-?}, ${MANIFEST_type:-?})"
   138	
   139	    # Detect cycles in the tree printer
   140	    if [[ "$seen" == *"|$name|"* ]]; then
   141	        echo "${indent_str}  [cycle detected at $name]"
   142	        return 0
   143	    fi
   144	    seen="$seen|$name|"
   145	
   146	    local deps="${DEP_MAP[$name]:-}"
   147	    if [[ -n "$deps" ]]; then
   148	        local IFS=','
   149	        local dep
   150	        for dep in $deps; do
   151	            dep="${dep// /}"
   152	            [[ -z "$dep" ]] && continue
   153	            show_dep_tree "$dep" $((indent + 1)) "$seen" || true
   154	        done
   155	    fi
   156	}
   157	
   158	# Return all transitive dependencies (not including the package itself)
   159	get_all_deps() {
   160	    local name="$1"
   161	    if [[ -z "${DEP_MAP[*]+_}" ]]; then
   162	        build_dep_map
   163	    fi
   164	
   165	    declare -A _seen
   166	    local _result=""
   167	
   168	    _collect_deps() {
   169	        local node="$1"
   170	        local deps="${DEP_MAP[$node]:-}"
   171	        if [[ -n "$deps" ]]; then
   172	            local IFS=','
   173	            for dep in $deps; do
   174	                dep="${dep// /}"
   175	                [[ -z "$dep" ]] && continue
   176	                if [[ -z "${_seen[$dep]:-}" ]]; then
   177	                    _seen[$dep]=1
   178	                    _result="$_result $dep"
   179	                    _collect_deps "$dep"
   180	                fi
   181	            done
   182	        fi
   183	    }
   184	
   185	    _collect_deps "$name"
   186	    echo "${_result# }"
   187	}
   188	
   189	# Return all packages that transitively depend on the named package.
   190	get_all_reverse_deps() {
   191	    local target="$1"
   192	    if [[ -z "${DEP_MAP[*]+_}" ]]; then
   193	        build_dep_map
   194	    fi
   195	
   196	    if [[ -z "${DEP_MAP[$target]+_}" ]]; then
   197	        log_error "Unknown package: $target"
   198	        return 1
   199	    fi
   200	
   201	    declare -A _seen
   202	    local _result=""
   203	
   204	    _collect_reverse() {
   205	        local node="$1"
   206	        local dep deps
   207	        for dep in "${!DEP_MAP[@]}"; do
   208	            deps="${DEP_MAP[$dep]}"
   209	            local IFS=','
   210	            local d
   211	            for d in $deps; do
   212	                d="${d// /}"
   213	                [[ -z "$d" ]] && continue
   214	                if [[ "$d" == "$node" && -z "${_seen[$dep]:-}" ]]; then
   215	                    _seen[$dep]=1
   216	                    _result="$_result $dep"
   217	                    _collect_reverse "$dep"
   218	                fi
   219	            done
   220	        done
   221	    }
   222	
   223	    _collect_reverse "$target"
   224	    echo "${_result# }"
   225	}
   226	
   227	print_graph() {
   228	    build_dep_map
   229	
   230	    echo "digraph forgekit {"
   231	    echo "  rankdir=LR;"
   232	    local pkg
   233	    for pkg in "${!DEP_MAP[@]}"; do
   234	        echo "  "$pkg";"
   235	    done
   236	
   237	    local deps dep
   238	    for pkg in "${!DEP_MAP[@]}"; do
   239	        deps="${DEP_MAP[$pkg]:-}"
   240	        if [[ -n "$deps" ]]; then
   241	            local IFS=','
   242	            for dep in $deps; do
   243	                dep="${dep// /}"
   244	                [[ -z "$dep" ]] && continue
   245	                echo "  "$pkg" -> "$dep";"
   246	            done
   247	        fi
   248	    done
   249	    echo "}"
   250	}
   251	
   252	print_reverse_graph() {
   253	    local target="$1"
   254	    build_dep_map
   255	
   256	    if [[ -z "${DEP_MAP[$target]+_}" ]]; then
   257	        log_error "Unknown package: $target"
   258	        return 1
   259	    fi
   260	
   261	    declare -A included=([$target]=1)
   262	    local rev
   263	    rev=$(get_all_reverse_deps "$target") || return 1
   264	    local pkg
   265	    for pkg in $rev; do
   266	        included[$pkg]=1
   267	    done
   268	
   269	    echo "digraph forgekit {"
   270	    echo "  rankdir=LR;"
