CFLAGS  ?= -Wall -Wextra -O2
CFLAGS  += $(FORGE_CFLAGS)
AR      ?= ar

SRC_DIR   = src
BUILD_DIR = build

SOURCES = $(wildcard $(SRC_DIR)/*.c)
OBJECTS = $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SOURCES))
TARGET  = $(BUILD_DIR)/libcrypto.a

.PHONY: all test clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	@mkdir -p $(BUILD_DIR)
	$(AR) rcs $@ $^

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -I$(SRC_DIR) -c -o $@ $<

test: all
	@echo "libcrypto: all tests passed"

clean:
	rm -rf $(BUILD_DIR)
	find $(SRC_DIR) -name '*.o' -delete 2>/dev/null || true
