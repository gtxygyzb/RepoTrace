    95	    if echo "$text" | grep -q "$pattern"; then
    96	        echo "  PASS: $desc"
    97	        ((PASSED++))
    98	    else
    99	        echo "  FAIL: $desc"
   100	        echo "    expected to match: '$pattern'"
   101	        echo "    in: '$text'"
   102	        ((FAILED++))
   103	    fi
   104	}
