[?2004l[?2004h>         name="${MANIFEST_name:-$pkg_name}"
[?2004l[?2004h>         version="${MANIFEST_version:-unknown}"
[?2004l[?2004h>         type="${MANIFEST_type:-unknown}"
[?2004l[?2004h>         deps="${MANIFEST_deps:-none}"
[?2004l[?2004h>         printf "%-25s %-10s %-10s %s\\n" "$name" "$version" "$type" "$deps"
[?2004l[?2004h>     done
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Clean build artifacts for a package.  A profile argument scopes the
[?2004l[?2004h> # cleanup to build/<profile>; without it, release is cleaned.  Object
[?2004l[?2004h> # files under src are removed for the selected profile's build tree.
[?2004l[?2004h> clean_package() {
[?2004l "[?2004h>     local name="$1"
[?2004l[?2004h>     local profile
[?2004l[?2004h>     profile="${2:-release}"
[?2004l[?2004h>     if [[ "$profile" != "debug" && "$profile" != "release" ]]; then
