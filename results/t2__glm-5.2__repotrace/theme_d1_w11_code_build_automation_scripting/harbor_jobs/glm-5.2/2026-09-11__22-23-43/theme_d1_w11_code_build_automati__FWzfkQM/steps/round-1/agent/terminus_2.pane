===== packages/libnet/src/net.c =====
#include "net.h"
#include <string.h>
#include <stdio.h>

int net_default_port(void) {
    return 8080;
}

const char *net_encode_msg(const char *msg, char *buf, int buflen) {
    int len = (int)strlen(msg);
    if (len + 8 > buflen) return NULL;
    snprintf(buf, (size_t)buflen, "MSG:%04d:%s", len, msg);
    return buf;
}

int net_parse_header(const char *raw, char *method, char *path,
                     int mlen, int plen) {
    /* Minimal HTTP-ish header parser: "METHOD /path ..." */
    const char *sp1 = strchr(raw, ' ');
    if (!sp1) return -1;
    int ml = (int)(sp1 - raw);
    if (ml >= mlen) ml = mlen - 1;
    memcpy(method, raw, (size_t)ml);
    method[ml] = '\0';

    sp1++;
    const char *sp2 = strchr(sp1, ' ');
    int pl = sp2 ? (int)(sp2 - sp1) : (int)strlen(sp1);
    if (pl >= plen) pl = plen - 1;
    memcpy(path, sp1, (size_t)pl);
    path[pl] = '\0';

    return 0;
}
