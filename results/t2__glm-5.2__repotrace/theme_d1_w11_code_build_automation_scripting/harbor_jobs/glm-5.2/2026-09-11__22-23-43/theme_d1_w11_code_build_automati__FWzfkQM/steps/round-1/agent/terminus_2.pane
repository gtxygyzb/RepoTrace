[?2004l[?2004h>     else
[?2004l[?2004h>         rm -rf "$FORGE_CACHE_DIR"
[?2004l[?2004h>     fi
[?2004l[?2004h> }
[?2004l[?2004h> ''')
[?2004l[?2004h> Path('lib/common.sh').write_text('''#!/bin/bash
[?2004l[?2004h> # Common utilities for ForgeKit
[?2004l[?2004h> 
[?2004le[?2004h> log_info() {
