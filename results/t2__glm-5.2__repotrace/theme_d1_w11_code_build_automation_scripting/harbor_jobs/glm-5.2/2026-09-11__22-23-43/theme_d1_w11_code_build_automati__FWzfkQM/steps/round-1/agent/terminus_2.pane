assert_eq "libstore before svc-auth" "1" "$(( libstore_pos < svc_auth_pos ? 1 : 0 ))"
assert_eq "libnet before svc-scheduler" "1" "$(( libnet_pos < svc_scheduler_pos ? 1 : 0 ))"

