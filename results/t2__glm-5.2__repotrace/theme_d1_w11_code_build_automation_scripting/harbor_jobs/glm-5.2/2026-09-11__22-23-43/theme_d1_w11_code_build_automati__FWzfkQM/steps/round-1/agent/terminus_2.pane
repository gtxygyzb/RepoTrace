   165	# Internal: schedule packages in dependency order with up to N workers.
   166	# Each package's output is buffered and printed under a header when it
   167	# finishes.  Existing concurrent builds continue on failure, but no new
   168	# packages are started after a failure.
   169	_run_parallel_build() {
   170	    local order="$1" jobs="${2:-1}" profile="${3:-release}"
   171	    jobs=$(( jobs < 1 ? 1 : jobs ))
   172	
   173	    declare -A remaining_deps state failed_pkg
   174	    declare -A active_pids
   175	    local pkg dep deps_str dep_count
   176	
   177	    for pkg in $order; do
   178	        deps_str="${DEP_MAP[$pkg]:-}"
   179	        dep_count=0
   180	        if [[ -n "$deps_str" ]]; then
   181	            local IFS=','
   182	            for dep in $deps_str; do
   183	                dep="${dep// /}"
   184	                [[ -z "$dep" ]] && continue
   185	                dep_count=$(( dep_count + 1 ))
   186	            done
   187	        fi
   188	        remaining_deps[$pkg]=$dep_count
   189	        state[$pkg]=pending
   190	    done
