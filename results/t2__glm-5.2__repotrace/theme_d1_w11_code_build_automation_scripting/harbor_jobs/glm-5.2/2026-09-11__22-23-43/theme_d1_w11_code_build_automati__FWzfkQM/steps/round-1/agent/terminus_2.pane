     8	# Source library modules
     9	source "$FORGE_ROOT/lib/common.sh"
    10	source "$FORGE_ROOT/lib/manifest.sh"
    11	source "$FORGE_ROOT/lib/depgraph.sh"
    12	source "$FORGE_ROOT/lib/builder.sh"
