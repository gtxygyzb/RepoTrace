[880.775428, "o", "\u001b[?2004h"]
[880.775499, "o", "> "]
[880.77558, "o", "    local env=\"$1\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[880.775853, "o", "    local template_dir=\"$FORGE_ROOT/templates\"\r\n\u001b[?2004l\r"]
[880.775919, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[880.775985, "o", "\u001b[?2004h> "]
[880.776195, "o", "    if [[ ! -d \"$template_dir\" ]]; then\r\n\u001b[?2004l\r"]
[880.776262, "o", "\u001b[?2004h> "]
[880.776626, "o", "        log_error \"Templates directory not found: $template_dir\"\r\n\u001b[?2004l\r"]
[880.776695, "o", "\u001b[?2004h> "]
[880.776779, "o", "        return 1\r\n\u001b[?2004l\r"]
[880.776846, "o", "\u001b[?2004h> "]
[880.776913, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[880.776979, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[880.777399, "o", "    # Build variable map -----------------------------------------------\r\n\u001b[?2004l\r"]
[880.777466, "o", "\u001b[?2004h> "]
[880.777623, "o", "    declare -A config_vars\r\n\u001b[?2004l\r"]
[880.77769, "o", "\u001b[?2004h> "]
[880.777837, "o", "    config_vars[ENV]=\"$env\"\r\n\u001b[?2004l\r"]
[880.777893, "o", "\u001b[?2004h> "]
[880.778141, "o", "    config_vars[FORGE_ROOT]=\"$FORGE_ROOT\"\r\n\u001b[?2004l\r"]
[880.778209, "o", "\u001b[?2004h> "]
[880.778509, "o", "    config_vars[TIMESTAMP]=\"$(date -u +%Y%m%dT%H%M%SZ)\"\r\n\u001b[?2004l\r"]
[880.778586, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[880.778656, "o", "\u001b[?2004h> "]
[880.778924, "o", "    # Load environment-specific config if it exists\r\n\u001b[?2004l\r"]
[880.778991, "o", "\u001b[?2004h> "]
[880.779267, "o", "    local env_conf=\"$FORGE_ROOT/config/${env}.conf\"\r\n\u001b[?2004l\r"]
[880.779335, "o", "\u001b[?2004h> "]
[880.779512, "o", "    if [[ -f \"$env_conf\" ]]; then\r\n\u001b[?2004l\r"]
[880.77959, "o", "\u001b[?2004h> "]
[880.779715, "o", "        local key value\r\n\u001b[?2004l\r"]
[880.779788, "o", "\u001b[?2004h> "]
[880.780025, "o", "        while IFS='=' read -r key value; do\r\n\u001b[?2004l\r"]
[880.780092, "o", "\u001b[?2004h> "]
[880.780389, "o", "            [[ \"$key\" =~ ^[[:space:]]*# ]] && continue\r\n\u001b[?2004l\r"]
[880.780456, "o", "\u001b[?2004h> "]
[880.780685, "o", "            [[ -z \"$key\" ]] && continue\r\n\u001b[?2004l\r"]
[880.780755, "o", "\u001b[?2004h> "]
[880.781023, "o", "            key=$(echo \"$key\" | tr -d '[:space:]')\r\n\u001b[?2004l\r"]
[880.781091, "o", "\u001b[?2004h> "]
[880.781576, "o", "            value=$(echo \"$value\" | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')\r\n\u001b[?2004l\r"]
[880.781645, "o", "\u001b[?2004h> "]
[880.781854, "o", "            config_vars[$key]=\"$value\"\r\n\u001b[?2004l\r"]
[880.781921, "o", "\u001b[?2004h> "]
[880.782059, "o", "        done < \"$env_conf\"\r\n\u001b[?2004l\r"]
[880.782127, "o", "\u001b[?2004h> "]
[880.782193, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[880.782259, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[880.782509, "o", "    # Inject per-package version variables\r\n\u001b[?2004l\r"]
[880.782585, "o", "\u001b[?2004h> "]
[880.782749, "o", "    local pkg_name safe_name\r\n\u001b[?2004l\r"]
[880.782815, "o", "\u001b[?2004h> "]
[880.783058, "o", "    for pkg_name in $(list_package_names); do\r\n\u001b[?2004l\r"]
[880.783124, "o", "\u001b[?2004h> "]
[880.783308, "o", "        parse_manifest \"$pkg_name\"\r\n\u001b[?2004l\r"]
[880.783376, "o", "\u001b[?2004h> "]
[880.783575, "o", "        safe_name=\"${pkg_name//-/_}\"\r\n\u001b[?2004l\r"]
[880.783643, "o", "\u001b[?2004h> "]
[880.784045, "o", "        config_vars[\"VERSION_${safe_name}\"]=\"${MANIFEST_version:-0.0.0}\"\r\n\u001b[?2004l\r"]
[880.784111, "o", "\u001b[?2004h> "]
[880.784176, "o", "    done\r\n\u001b[?2004l\r\u001b[?2004h"]
[880.784244, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[880.784311, "o", "> "]
[880.784688, "o", "    # Process each template file ---------------------------------------\r\n\u001b[?2004l\r"]
[880.784759, "o", "\u001b[?2004h> "]
[880.784952, "o", "    mkdir -p \"$FORGE_ROOT/generated\"\r\n\u001b[?2004l\r"]
[880.785018, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[880.785085, "o", "\u001b[?2004h> "]
[880.785278, "o", "    local tpl outname outfile content\r\n\u001b[?2004l\r"]
[880.785346, "o", "\u001b[?2004h> "]
[880.785576, "o", "    for tpl in \"$template_dir\"/*.tpl; do\r\n\u001b[?2004l\r"]
[880.785647, "o", "\u001b[?2004h> "]
[880.785835, "o", "        [[ -f \"$tpl\" ]] || continue\r\n\u001b[?2004l\r"]
[880.785902, "o", "\u001b[?2004h> "]
[880.786117, "o", "        outname=$(basename \"$tpl\" .tpl)\r\n\u001b[?2004l\r"]
[880.786182, "o", "\u001b[?2004h> "]
[880.786348, "o", "        outfile=\"$FORGE_ROOT/generated/${outname}\"\r\n\u001b[?2004l\r"]
[880.786414, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[880.786539, "o", "        content=$(cat \"$tpl\")\r\n\u001b[?2004l\r"]
[880.786643, "o", "\u001b[?2004h> "]
[880.786777, "o", "        content=$(_config_resolve_vars \"$content\")\r\n\u001b[?2004l\r"]
[880.786847, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[880.786998, "o", "        echo \"$content\" > \"$outfile\"\r\n\u001b[?2004l\r"]
[880.787064, "o", "\u001b[?2004h> "]
[880.78721, "o", "        log_info \"Generated config: $outfile\"\r\n\u001b[?2004l\r"]
[880.787278, "o", "\u001b[?2004h>     done\r\n\u001b[?2004l\r"]
[880.787345, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[880.787411, "o", "> EOF\r\n\u001b[?2004l\r"]
[880.79038, "o", "\u001b[?2004hroot@n30009:/app# "]
[881.059133, "i", "cat > lib/reporter.sh <<'EOF'\n#!/bin/bash\n# Build report generator for ForgeKit\n\ngenerate_report() {\n    echo \"=========================================\"\n    echo \"  ForgeKit Build Report\"\n    echo \"=========================================\"\n    echo \"  Date: $(date '+%Y-%m-%d %H:%M:%S')\"\n    echo \"=========================================\"\n    echo \"\"\n\n    local width=${#PACKAGE}\n    local pkg_name\n    for pkg_name in $(list_package_names); do\n        if (( ${#pkg_name} > width )); then\n            width=${#pkg_name}\n        fi\n    done\n\n    printf \"%-${width}s  %-10s  %-10s  %-8s  %s\\n\" \\\n        \"PACKAGE\" \"VERSION\" \"TYPE\" \"STATUS\" \"CACHED\"\n    printf \"%-${width}s  %-10s  %-10s  %-8s  %s\\n\" \\\n        \"-------\" \"-------\" \"----\" \"------\" \"------\"\n\n    for pkg_name in $(list_package_names); do\n        parse_manifest \"$pkg_name\"\n        local version=\"${MANIFEST_version:-?}\"\n        local type=\"${MANIFEST_type:-?}\"\n        local pkg_dir\n        pkg_dir=$(get_package_dir \"$pkg_name\")\n\n        local status=\"pendi"]
[881.059222, "i", "ng\"\n        if [[ -d \"$pkg_dir/build\" ]]; then\n            status=\"built\"\n        fi\n\n        local cached=\"no\"\n        if is_cache_valid \"$pkg_name\" 2>/dev/null; then\n            cached=\"yes\"\n        fi\n\n        printf \"%-${width}s  %-10s  %-10s  %-8s  %s\\n\" \\\n            \"$pkg_name\" \"$version\" \"$type\" \"$status\" \"$cached\"\n    done\n\n    echo \"\"\n    echo \"Total packages: $(list_package_names | wc -w)\"\n}\nEOF\n"]
[881.059477, "o", "cat > lib/reporter.sh <<'EOF'\r\n\u001b[?2004l\r"]
[881.059655, "o", "\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r"]
[881.059732, "o", "\u001b[?2004h> "]
[881.059921, "o", "# Build report generator for ForgeKit\r\n\u001b[?2004l\r"]
[881.05999, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[881.060058, "o", "\u001b[?2004h> "]
[881.060151, "o", "generate_report() {\r\n\u001b[?2004l\r"]
[881.060218, "o", "\u001b[?2004h> "]
[881.060512, "o", "    echo \"=========================================\"\r\n\u001b[?2004l\r"]
[881.060615, "o", "\u001b[?2004h> "]
[881.060774, "o", "    echo \"  ForgeKit Build Report\"\r\n\u001b[?2004l\r"]
[881.060842, "o", "\u001b[?2004h> "]
[881.061123, "o", "    echo \"=========================================\"\r\n\u001b[?2004l\r"]
[881.06119, "o", "\u001b[?2004h> "]
[881.061485, "o", "    echo \"  Date: $(date '+%Y-%m-%d %H:%M:%S')\"\r\n\u001b[?2004l\r"]
[881.061584, "o", "\u001b[?2004h> "]
[881.06187, "o", "    echo \"=========================================\"\r\n\u001b[?2004l\r"]
[881.061938, "o", "\u001b[?2004h> "]
[881.062012, "o", "    echo \"\"\r\n\u001b[?2004l\r"]
[881.062079, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[881.062148, "o", "> "]
[881.062273, "o", "    local width=${#PACKAGE}\r\n\u001b[?2004l\r"]
[881.062339, "o", "\u001b[?2004h> "]
[881.062435, "o", "    local pkg_name\r\n\u001b[?2004l\r"]
[881.062501, "o", "\u001b[?2004h> "]
[881.062764, "o", "    for pkg_name in $(list_package_names); do\r\n\u001b[?2004l\r"]
[881.062832, "o", "\u001b[?2004h> "]
[881.063067, "o", "        if (( ${#pkg_name} > width )); then\r\n\u001b[?2004l\r"]
[881.063133, "o", "\u001b[?2004h> "]
[881.063294, "o", "            width=${#pkg_name}\r\n\u001b[?2004l\r"]
[881.063361, "o", "\u001b[?2004h> "]
[881.063435, "o", "        fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.063501, "o", "> "]
[881.063576, "o", "    done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.063644, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.063947, "o", "    printf \"%-${width}s  %-10s  %-10s  %-8s  %s\\n\" \\\r\n\u001b[?2004l\r"]
[881.064012, "o", "\u001b[?2004h> "]
[881.064299, "o", "        \"PACKAGE\" \"VERSION\" \"TYPE\" \"STATUS\" \"CACHED\"\r\n\u001b[?2004l\r"]
[881.064364, "o", "\u001b[?2004h> "]
[881.064669, "o", "    printf \"%-${width}s  %-10s  %-10s  %-8s  %s\\n\" \\\r\n\u001b[?2004l\r"]
[881.064745, "o", "\u001b[?2004h> "]
[881.065034, "o", "        \"-------\" \"-------\" \"----\" \"------\" \"------\"\r\n\u001b[?2004l\r"]
[881.0651, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[881.065164, "o", "\u001b[?2004h> "]
[881.065404, "o", "    for pkg_name in $(list_package_names); do\r\n\u001b[?2004l\r"]
[881.06547, "o", "\u001b[?2004h> "]
[881.065667, "o", "        parse_manifest \"$pkg_name\"\r\n\u001b[?2004l\r"]
[881.065733, "o", "\u001b[?2004h> "]
[881.065987, "o", "        local version=\"${MANIFEST_version:-?}\"\r\n\u001b[?2004l\r"]
[881.066054, "o", "\u001b[?2004h> "]
[881.066269, "o", "        local type=\"${MANIFEST_type:-?}\"\r\n\u001b[?2004l\r"]
[881.066334, "o", "\u001b[?2004h> "]
[881.06645, "o", "        local pkg_dir\r\n\u001b[?2004l\r"]
[881.066518, "o", "\u001b[?2004h> "]
[881.066782, "o", "        pkg_dir=$(get_package_dir \"$pkg_name\")\r\n\u001b[?2004l\r"]
[881.066849, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[881.066913, "o", "\u001b[?2004h> "]
[881.067067, "o", "        local status=\"pending\"\r\n\u001b[?2004l\r"]
[881.067134, "o", "\u001b[?2004h> "]
[881.067365, "o", "        if [[ -d \"$pkg_dir/build\" ]]; then\r\n\u001b[?2004l\r"]
[881.067432, "o", "\u001b[?2004h> "]
[881.067587, "o", "            status=\"built\"\r\n\u001b[?2004l\r"]
[881.067655, "o", "\u001b[?2004h> "]
[881.067721, "o", "        fi\r\n\u001b[?2004l\r"]
[881.067788, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[881.067855, "o", "\u001b[?2004h> "]
[881.067981, "o", "        local cached=\"no\"\r\n\u001b[?2004l\r"]
[881.068046, "o", "\u001b[?2004h> "]
[881.068347, "o", "        if is_cache_valid \"$pkg_name\" 2>/dev/null; then\r\n\u001b[?2004l\r"]
[881.068411, "o", "\u001b[?2004h> "]
[881.068545, "o", "            cached=\"yes\"\r\n\u001b[?2004l\r"]
[881.068634, "o", "\u001b[?2004h> "]
[881.068693, "o", "        fi\r\n\u001b[?2004l\r"]
[881.068758, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[881.068822, "o", "> "]
[881.069112, "o", "        printf \"%-${width}s  %-10s  %-10s  %-8s  %s\\n\" \\\r\n\u001b[?2004l\r"]
[881.06918, "o", "\u001b[?2004h> "]
[881.069446, "o", "            \"$pkg_name\" \"$version\" \"$type\" \"$status\" \"$cached\"\r\n\u001b[?2004l\r"]
[881.069514, "o", "\u001b[?2004h> "]
[881.069589, "o", "    done\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[881.069657, "o", "\u001b[?2004h> "]
[881.069722, "o", "    echo \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.069998, "o", "    echo \"Total packages: $(list_package_names | wc -w)\"\r\n\u001b[?2004l\r"]
[881.070065, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[881.070132, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
