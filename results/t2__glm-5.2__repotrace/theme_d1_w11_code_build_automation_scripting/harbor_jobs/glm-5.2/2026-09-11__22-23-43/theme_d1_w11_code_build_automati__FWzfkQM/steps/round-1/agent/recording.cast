[194.963255, "o", "     1\t#!/bin/bash\r\n     2\t# Build executor for ForgeKit\r\n     3\t#\r\n"]
[194.963396, "o", "     4\t# Builds packages by running their Makefile in the correct environment.\r\n     5\t\r\n     6\t# Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.\r\n     7\t# BUG: Only sets up paths for *direct* dependencies.\r\n     8\t#      Transitive dependency include/lib paths are not added.\r\n     9\t#      Currently harmless because no header exposes transitive types,\r\n    10\t#      but will break as soon as a public header includes a transitive\r\n    11\t#      dependency header.\r\n    12\tsetup_build_env() {\r\n    13\t    local pkg_name=\"$1\"\r\n    14\t    parse_manifest \"$pkg_name\"\r\n    15\t\r\n    16\t    local cflags=\"\"\r\n    17\t    local ldflags=\"\"\r\n    18\t    local libs=\"\"\r\n    19\t    local deps=\"${MANIFEST_deps:-}\"\r\n    20\t\r\n    21\t    if [[ -n \"$deps\" ]]; then\r\n    22\t        local IFS=','\r\n    23\t        for dep in $deps; do\r\n    24\t            dep=\"${dep// /}\"\r\n    25\t            [[ -z \"$dep\" ]] && continue\r\n    26\t            local dep_dir\r\n"]
[194.963546, "o", "    27\t            dep_dir=$(get_package_dir \"$dep\")\r\n    28\t            cflags=\"$cflags -I${dep_dir}/src\"\r\n    29\t            ldflags=\"$ldflags -L${dep_dir}/build\"\r\n    30\t            # For services linking against libraries\r\n    31\t            parse_manifest \"$dep\"\r\n    32\t            if [[ \"${MANIFEST_type:-}\" == \"library\" ]]; then\r\n    33\t                local libname=\"${dep#lib}\"\r\n    34\t                libs=\"$libs ${dep_dir}/build/${dep}.a\"\r\n    35\t            fi\r\n    36\t        done\r\n    37\t    fi\r\n    38\t\r\n    39\t    export FORGE_CFLAGS=\"$cflags\"\r\n    40\t    export FORGE_LDFLAGS=\"$ldflags\"\r\n    41\t    export FORGE_LIBS=\"$libs\"\r\n    42\t}\r\n    43\t\r\n    44\t# Build a single package\r\n    45\tbuild_package() {\r\n    46\t    local pkg_name=\"$1\"\r\n    47\t    local pkg_dir\r\n    48\t    pkg_dir=$(get_package_dir \"$pkg_name\")\r\n"]
[194.963684, "o", "    49\t\r\n    50\t    if [[ ! -d \"$pkg_dir\" ]]; then\r\n    51\t        log_error \"Package directory not found: $pkg_dir\"\r\n    52\t        return 1\r\n    53\t    fi\r\n    54\t\r\n    55\t    # Check cache\r\n    56\t    if is_cache_valid \"$pkg_name\" 2>/dev/null; then\r\n    57\t        log_info \"[$pkg_name] Up to date (cached)\"\r\n    58\t        return 0\r\n    59\t    fi\r\n    60\t\r\n    61\t    log_info \"[$pkg_name] Building...\"\r\n    62\t\r\n    63\t    # Parse manifest for build command\r\n    64\t    parse_manifest \"$pkg_name\"\r\n    65\t    local build_cmd=\"${MANIFEST_command:-make}\"\r\n    66\t\r\n"]
[194.963743, "o", "    67\t    # Set up build environment\r\n    68\t    setup_build_env \"$pkg_name\"\r\n    69\t\r\n    70\t    # Execute build\r\n    71\t    if ! (cd \"$pkg_dir\" && eval \"$build_cmd\" 2>&1); then\r\n    72\t        log_error \"[$pkg_name] Build failed\"\r\n    73\t        return 1\r\n    74\t    fi\r\n    75\t\r\n"]
[194.963888, "o", "    76\t    # Update cache\r\n    77\t    update_cache \"$pkg_name\"\r\n    78\t\r\n    79\t    log_info \"[$pkg_name] Build successful\"\r\n    80\t    return 0\r\n    81\t}\r\n    82\t\r\n    83\t# Run tests for a single package\r\n    84\ttest_package() {\r\n    85\t    local pkg_name=\"$1\"\r\n    86\t    local pkg_dir\r\n    87\t    pkg_dir=$(get_package_dir \"$pkg_name\")\r\n    88\t\r\n    89\t    parse_manifest \"$pkg_name\"\r\n    90\t    local test_cmd=\"${MANIFEST_test_command:-make test}\"\r\n    91\t\r\n    92\t    setup_build_env \"$pkg_name\"\r\n    93\t\r\n    94\t    log_info \"[$pkg_name] Running tests...\"\r\n    95\t    if ! (cd \"$pkg_dir\" && eval \"$test_cmd\" 2>&1); then\r\n    96\t        log_error \"[$pkg_name] Tests failed\"\r\n    97\t        return 1\r\n    98\t    fi\r\n    99\t\r\n   100\t    log_info \"[$pkg_name] Tests passed\"\r\n"]
[194.964012, "o", "   101\t    return 0\r\n   102\t}\r\n"]
