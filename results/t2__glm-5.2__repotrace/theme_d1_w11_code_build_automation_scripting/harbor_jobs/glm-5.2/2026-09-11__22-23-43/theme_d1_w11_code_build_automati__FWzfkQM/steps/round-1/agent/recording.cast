[879.713256, "o", "    declare -a _path\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.713347, "o", "> "]
[879.713442, "o", "    local _order=\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.713636, "o", "    for pkg in $(list_package_names); do\r\n\u001b[?2004l\r"]
[879.713729, "o", "\u001b[?2004h> "]
[879.713852, "o", "        if ! _forge_graph_dfs \"$pkg\"; then\r\n\u001b[?2004l\r"]
[879.713953, "o", "\u001b[?2004h> "]
[879.714042, "o", "            return 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.714142, "o", "        fi\r\n\u001b[?2004l\r\u001b[?2004h>     done\r\n\u001b[?2004l\r"]
[879.71424, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[879.714298, "o", "\u001b[?2004h>     echo \"$_order\"\r\n\u001b[?2004l\r"]
[879.714421, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[879.714519, "o", "> "]
[879.714689, "o", "# Resolve the build chain for a single target (inclusive)\r\n\u001b[?2004l\r"]
[879.714799, "o", "\u001b[?2004h> "]
[879.714899, "o", "resolve_deps_for() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.715011, "o", "    local target=\"$1\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.715114, "o", "    build_dep_map\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.715234, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.715355, "o", "    if [[ -z \"${DEP_MAP[$target]+_}\" ]]; then\r\n\u001b[?2004l\r"]
[879.715451, "o", "\u001b[?2004h> "]
[879.71559, "o", "        log_error \"Unknown package: $target\"\r\n\u001b[?2004l\r"]
[879.715715, "o", "\u001b[?2004h>         return 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.715826, "o", ">     fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[879.715958, "o", "> "]
[879.716092, "o", "    declare -A _state\r\n\u001b[?2004l\r\u001b[?2004h>     declare -a _path\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.716225, "o", "> "]
[879.716331, "o", "    local _order=\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.716449, "o", "    if ! _forge_graph_dfs \"$target\"; then\r\n\u001b[?2004l\r"]
[879.716544, "o", "\u001b[?2004h>         return 1\r\n\u001b[?2004l\r"]
[879.716674, "o", "\u001b[?2004h>     fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[879.716765, "o", "\u001b[?2004h> "]
[879.716857, "o", "    echo \"$_order\"\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.716949, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.717163, "o", "# Pretty-print the dependency tree (recursive, indented)\r\n\u001b[?2004l\r"]
[879.717256, "o", "\u001b[?2004h> "]
[879.717349, "o", "show_dep_tree() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.717448, "o", "    local name=\"$1\"\r\n\u001b[?2004l\r"]
[879.717561, "o", "\u001b[?2004h> "]
[879.717679, "o", "    local indent=\"${2:-0}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.71777, "o", "    local seen=\"${3:-}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[879.717861, "o", "\u001b[?2004h> "]
[879.717971, "o", "    # Ensure the dep map exists\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.718148, "o", "    if [[ -z \"${DEP_MAP[*]+_}\" ]]; then\r\n\u001b[?2004l\r"]
[879.71824, "o", "\u001b[?2004h> "]
[879.718339, "o", "        build_dep_map\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.718436, "o", ">     fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.718625, "o", "    if [[ \" $seen \" == *\" $name \"* ]]; then\r\n\u001b[?2004l\r"]
[879.718716, "o", "\u001b[?2004h> "]
[879.718808, "o", "        local prefix=\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.718893, "o", "        local i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.71915, "o", "        for ((i = 0; i < indent; i++)); do prefix=\"$prefix  \"; done\r\n\u001b[?2004l\r"]
[879.719229, "o", "\u001b[?2004h> "]
[879.719322, "o", "        echo \"${prefix}${name} (cycle)\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.719481, "o", "        log_warn \"Circular dependency detected at $name\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.719569, "o", ">         return 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.71965, "o", ">     fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.719726, "o", "    seen=\"$seen $name\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[879.719808, "o", "\u001b[?2004h> "]
[879.719895, "o", "    local prefix=\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.720035, "o", "    for ((i = 0; i < indent; i++)); do prefix=\"$prefix  \"; done\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.720118, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.720204, "o", "    echo \"${prefix}${name}\"\r\n\u001b[?2004l\r"]
[879.720253, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.720347, "o", "    local deps=\"${DEP_MAP[$name]:-}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.720453, "o", "    if [[ -n \"$deps\" ]]; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.720535, "o", ">         local IFS=','\r\n\u001b[?2004l\r"]
[879.720623, "o", "\u001b[?2004h> "]
[879.720706, "o", "        for dep in $deps; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.720817, "o", "            dep=\"${dep// /}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.720913, "o", "            [[ -z \"$dep\" ]] && continue\r\n\u001b[?2004l\r"]
[879.721001, "o", "\u001b[?2004h> "]
[879.721124, "o", "            show_dep_tree \"$dep\" $((indent + 1)) \"$seen\" || true\r\n\u001b[?2004l\r"]
[879.721203, "o", "\u001b[?2004h>         done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.721287, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.721367, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.721537, "o", "# Return all transitive dependencies (not including the package itself)\r\n\u001b[?2004l\r"]
[879.721629, "o", "\u001b[?2004h> get_all_deps() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.721711, "o", ">     local name=\"$1\"\r\n\u001b[?2004l\r"]
[879.721794, "o", "\u001b[?2004h> "]
[879.721894, "o", "    if [[ -z \"${DEP_MAP[*]+_}\" ]]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.721982, "o", "        build_dep_map\r\n\u001b[?2004l\r"]
[879.722033, "o", "\u001b[?2004h>     fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.722071, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.722203, "o", "    declare -A _seen\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.722286, "o", "    local _result=\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.722364, "o", "    _collect_deps() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.72245, "o", "        local node=\"$1\"\r\n\u001b[?2004l\r"]
[879.722527, "o", "\u001b[?2004h> "]
[879.722612, "o", "        local deps=\"${DEP_MAP[$node]:-}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.722728, "o", "        if [[ -n \"$deps\" ]]; then\r\n\u001b[?2004l\r"]
[879.783041, "o", "\u001b[?2004h>             local IFS=','\r\n\u001b[?2004l\r\u001b[?2004h>             for dep in $deps; do\r\n\u001b[?2004l\r\u001b[?2004h>                 dep=\"${dep// /}\"\r\n\u001b[?2004l\r\u001b[?2004h>                 [[ -z \"$dep\" ]] && continue\r\n\u001b[?2004l\r\u001b[?2004h>                 if [[ -z \"${_seen[$dep]:-}\" ]]; then\r\n\u001b[?2004l\r\u001b[?2004h>                     _seen[$dep]=1\r\n\u001b[?2004l\r\u001b[?2004h>                     _result=\"$_result $dep\"\r\n\u001b[?2004l\r\u001b[?2004h>                     _collect_deps \"$dep\"\r\n\u001b[?2004l\r\u001b[?2004h>                 fi\r\n\u001b[?2004l\r\u001b[?2004h>             done\r\n\u001b[?2004l\r\u001b[?2004h>         fi\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     _collect_deps \"$name\"\r\n\u001b[?2004l\r\u001b[?2004h>     echo \"$_result\"\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[879.784003, "o", "\u001b[?2004h"]
[879.784109, "o", "root@n30009:/app# "]
[879.968937, "i", "cat > lib/cache.sh <<'EOF'\n#!/bin/bash\n# Build cache management for ForgeKit\n#\n# Uses timestamp-based caching: each package records a \"last built\"\n# timestamp; a rebuild is triggered when source files are newer or\n# when a transitive dependency has been rebuilt more recently.\n\nFORGE_CACHE_DIR=\"${FORGE_ROOT}/.forge_cache\"\n\ninit_cache() {\n    mkdir -p \"$FORGE_CACHE_DIR\"\n}\n\n# Newest mtime among all files under a package's src/ directory\nget_src_mtime() {\n    local pkg_name=\"$1\"\n    local pkg_dir\n    pkg_dir=$(get_package_dir \"$pkg_name\")\n\n    local latest=0\n    local mtime\n    while IFS= read -r -d '' file; do\n        mtime=$(stat -c %Y \"$file\" 2>/dev/null || echo 0)\n        if (( mtime > latest )); then\n            latest=$mtime\n        fi\n    done < <(find \"$pkg_dir/src\" -type f -print0 2>/dev/null)\n\n    # Also check Makefile\n    if [[ -f \"$pkg_dir/Makefile\" ]]; then\n        mtime=$(stat -c %Y \"$pkg_dir/Makefile\" 2>/dev/null || echo 0)\n        if (( mtime > latest )); then\n            latest=$mtime\n        fi\n"]
[879.969248, "i", "    fi\n\n    echo \"$latest\"\n}\n\n# Check whether the cached build is still valid.\n#\n# A package is invalid if:\n#   - it has no cache stamp\n#   - its own sources/Makefile are newer than its cache stamp\n#   - any transitive dependency has no cache stamp\n#   - any transitive dependency has a cache stamp newer than this package's\nis_cache_valid() {\n    local pkg_name=\"$1\"\n    init_cache\n    local cache_file=\"$FORGE_CACHE_DIR/${pkg_name}.stamp\"\n\n    if [[ ! -f \"$cache_file\" ]]; then\n        return 1  # No cache -> rebuild\n    fi\n\n    local cached_time\n    cached_time=$(cat \"$cache_file\" 2>/dev/null || echo 0)\n    if [[ ! \"$cached_time\" =~ ^[0-9]+$ ]]; then\n        return 1\n    fi\n\n    local src_mtime\n    src_mtime=$(get_src_mtime \"$pkg_name\")\n\n    if (( src_mtime > cached_time )); then\n        return 1  # Source newer than cache -> rebuild\n    fi\n\n    # Invalidate when transitive dependencies were rebuilt more recently.\n    local deps\n    deps=$(get_all_deps \"$pkg_name\") || return 1\n    local dep dep_cache_file dep_t"]
[879.969353, "o", "cat > lib/cache.sh <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.969465, "i", "ime\n    for dep in $deps; do\n        [[ -z \"$dep\" ]] && continue\n        dep_cache_file=\"$FORGE_CACHE_DIR/${dep}.stamp\"\n        if [[ ! -f \"$dep_cache_file\" ]]; then\n            return 1\n        fi\n        dep_time=$(cat \"$dep_cache_file\" 2>/dev/null || echo 0)\n        if [[ ! \"$dep_time\" =~ ^[0-9]+$ ]]; then\n            return 1\n        fi\n        if (( dep_time > cached_time )); then\n            return 1\n        fi\n    done\n\n    return 0  # Cache is valid\n}\n\n# Record the current time as the build timestamp for a package\nupdate_cache() {\n    local pkg_name=\"$1\"\n    init_cache\n    date +%s > \"$FORGE_CACHE_DIR/${pkg_name}.stamp\"\n}\n\n# Remove cache entry for a package\ninvalidate_cache() {\n    local pkg_name=\"$1\"\n    rm -f \"$FORGE_CACHE_DIR/${pkg_name}.stamp\"\n}\n\n# Wipe the entire cache directory\nclean_cache() {\n    rm -rf \"$FORGE_CACHE_DIR\"\n}\nEOF\n"]
[879.969542, "o", "#!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> "]
