[203.306674, "i", "for f in packages/*/package.forge; do echo \"===== $f =====\"; cat \"$f\"; done\n"]
[203.307227, "o", "for f in packages/*/package.forge; do echo \"===== $f =====\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[203.307643, "o", "===== packages/libbase/package.forge =====\r\n"]
[203.310039, "o", "[package]\r\nname = libbase\r\nversion = 1.0.0\r\ntype = library\r\n\r\n[deps]\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/libbase.a\r\n\r\n[meta]\r\ndescription = Core utility functions used across the monorepo\r\ntags = core,utils,foundation\r\n"]
[203.310363, "o", "===== packages/libcrypto/package.forge =====\r\n"]
[203.312431, "o", "[package]\r\nname = libcrypto\r\nversion = 1.2.0\r\ntype = library\r\n\r\n[deps]\r\ndeps = libbase\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/libcrypto.a\r\n\r\n[meta]\r\ndescription = Cryptographic primitives for signing and verification\r\ntags = crypto,security,hashing\r\n"]
[203.312752, "o", "===== packages/libnet/package.forge =====\r\n"]
[203.314718, "o", "[package]\r\nname = libnet\r\nversion = 1.1.0\r\ntype = library\r\n\r\n[deps]\r\ndeps = libbase\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/libnet.a\r\n\r\n[meta]\r\ndescription = Network protocol helpers and socket utilities\r\ntags = network,protocol,io\r\n"]
[203.31502, "o", "===== packages/libstore/package.forge =====\r\n"]
[203.316943, "o", "[package]\r\nname = libstore\r\nversion = 1.3.0\r\ntype = library\r\n\r\n[deps]\r\ndeps = libbase,libcrypto\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/libstore.a\r\n\r\n[meta]\r\ndescription = Persistent key-value store \\\r\n    with integrity verification \\\r\n    and crash recovery support\r\ntags = storage,persistence,\\\r\n    kv,transactions\r\n"]
[203.317329, "o", "===== packages/svc-auth/package.forge =====\r\n"]
[203.319363, "o", "[package]\r\nname = svc-auth\r\nversion = 2.0.1\r\ntype = service\r\n\r\n[deps]\r\ndeps = libcrypto,libstore\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/svc-auth\r\n\r\n[meta]\r\ndescription = Authentication and authorization service\r\ntags = auth,security,service\r\n"]
[203.319712, "o", "===== packages/svc-gateway/package.forge =====\r\n"]
[203.321631, "o", "[package]\r\nname = svc-gateway\r\nversion = 2.1.0\r\ntype = service\r\n\r\n[deps]\r\ndeps = libnet,libcrypto\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/svc-gateway\r\n\r\n[meta]\r\ndescription = API gateway and request router\r\ntags = gateway,routing,service\r\n"]
[203.321961, "o", "===== packages/svc-scheduler/package.forge =====\r\n"]
[203.324152, "o", "[package]\r\nname = svc-scheduler\r\nversion = 1.0.0\r\ntype = service\r\n\r\n[deps]\r\ndeps = libstore,libnet,libcrypto\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/svc-scheduler\r\n\r\n[meta]\r\ndescription = Distributed task scheduling and orchestration service\r\ntags = scheduler,orchestration,service\r\n"]
[203.324467, "o", "===== packages/svc-worker/package.forge =====\r\n"]
[203.326578, "o", "[package]\r\nname = svc-worker\r\nversion = 1.5.0\r\ntype = service\r\n\r\n[deps]\r\ndeps = libstore,libnet\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/svc-worker\r\n\r\n[meta]\r\ndescription = Background task worker service\r\ntags = worker,jobs,service\r\n"]
