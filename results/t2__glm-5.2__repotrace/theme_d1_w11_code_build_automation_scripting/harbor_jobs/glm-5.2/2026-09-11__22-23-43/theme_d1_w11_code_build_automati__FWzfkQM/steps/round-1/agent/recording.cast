[1402.210225, "o", "ackslash line continuation.  A trailing backslash joins\r\n            # the next line; the backslash and leading whitespace on the\r\n            # continuation "]
[1402.210318, "o", "line are stripped.\r\n            while [[ \"$value\" == *\\\\ ]]; do\r\n                value=\"${"]
