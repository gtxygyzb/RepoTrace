[879.394952, "o", "e%\\\\}\"\r\n                if IFS= read -r next_line || [[ -n \"$next_line\" ]]; then\r\n            "]
[879.395095, "o", "        next_line=\"${next_line#\"${next_line##*[![:space:]]}\"}\"\r\n                    next_line=\"${next_line%\"${next_line##*[![:space:]]}\"}\"\r\n                    value=\"$value$next_line\"\r\n                else\r\n                    break\r\n       "]
[879.395195, "o", "         fi\r\n            done\r\n\r\n            export \"MANIFEST_${key}=${value}\"\r\n        fi\r\n    done < \"$manifest_file\"\r\n}\r\n\r\n# Convenience"]
[879.395316, "o", ": parse and return a single value\r\nget_manifest_value() {\r\n    local pkg_name=\"$1\"\r\n  "]
[879.395422, "o", "  local key=\"$2\"\r\n    if ! parse_manifest \"$pkg_name\"; then\r\n        return 1\r\n    fi\r\n    local var=\"MANIFEST_${key}\"\r\n    echo \"${!var:-}\"\r\n}\r\nEOF\r\n\u001b[?2004h"]
