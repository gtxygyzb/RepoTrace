[879.979794, "o", "    init_cache\r\n\u001b[?2004l\r"]
[879.979849, "o", "\u001b[?2004h> "]
[879.980131, "o", "    local cache_file=\"$FORGE_CACHE_DIR/${pkg_name}.stamp\"\r\n\u001b[?2004l\r"]
[879.980187, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[879.980242, "o", "\u001b[?2004h> "]
[879.98042, "o", "    if [[ ! -f \"$cache_file\" ]]; then\r\n\u001b[?2004l\r"]
[879.980475, "o", "\u001b[?2004h> "]
[879.980684, "o", "        return 1  # No cache -> rebuild\r\n\u001b[?2004l\r"]
[879.980742, "o", "\u001b[?2004h> "]
[879.980799, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[879.980854, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[879.980978, "o", "    local cached_time\r\n\u001b[?2004l\r"]
[879.981034, "o", "\u001b[?2004h> "]
[879.981317, "o", "    cached_time=$(cat \"$cache_file\" 2>/dev/null || echo 0)\r\n\u001b[?2004l\r"]
[879.981375, "o", "\u001b[?2004h> "]
[879.981616, "o", "    if [[ ! \"$cached_time\" =~ ^[0-9]+$ ]]; then\r\n\u001b[?2004l\r"]
[879.981674, "o", "\u001b[?2004h> "]
[879.981752, "o", "        return 1\r\n\u001b[?2004l\r"]
[879.981807, "o", "\u001b[?2004h> "]
[879.981864, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.981929, "o", "> \r\n\u001b[?2004l\r"]
[879.981989, "o", "\u001b[?2004h> "]
[879.982054, "o", "    local src_mtime\r\n\u001b[?2004l\r"]
[879.98211, "o", "\u001b[?2004h> "]
[879.982318, "o", "    src_mtime=$(get_src_mtime \"$pkg_name\")\r\n\u001b[?2004l\r"]
[879.982374, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[879.982447, "o", "\u001b[?2004h> "]
[879.982661, "o", "    if (( src_mtime > cached_time )); then\r\n\u001b[?2004l\r"]
[879.982724, "o", "\u001b[?2004h> "]
[879.982971, "o", "        return 1  # Source newer than cache -> rebuild\r\n\u001b[?2004l\r"]
[879.983028, "o", "\u001b[?2004h> "]
[879.983085, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[879.983141, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[879.98352, "o", "    # Invalidate when transitive dependencies were rebuilt more recently.\r\n\u001b[?2004l\r"]
[879.983595, "o", "\u001b[?2004h> "]
[879.983656, "o", "    local deps\r\n\u001b[?2004l\r"]
[879.983712, "o", "\u001b[?2004h> "]
[879.983951, "o", "    deps=$(get_all_deps \"$pkg_name\") || return 1\r\n\u001b[?2004l\r"]
[879.984006, "o", "\u001b[?2004h> "]
[879.984188, "o", "    local dep dep_cache_file dep_time\r\n\u001b[?2004l\r"]
[879.984243, "o", "\u001b[?2004h> "]
[879.98436, "o", "    for dep in $deps; do\r\n\u001b[?2004l\r"]
[879.984416, "o", "\u001b[?2004h> "]
[879.984603, "o", "        [[ -z \"$dep\" ]] && continue\r\n\u001b[?2004l\r"]
[879.984661, "o", "\u001b[?2004h> "]
[879.984922, "o", "        dep_cache_file=\"$FORGE_CACHE_DIR/${dep}.stamp\"\r\n\u001b[?2004l\r"]
[879.984978, "o", "\u001b[?2004h> "]
[879.985197, "o", "        if [[ ! -f \"$dep_cache_file\" ]]; then\r\n\u001b[?2004l\r"]
[879.985253, "o", "\u001b[?2004h> "]
[879.985347, "o", "            return 1\r\n\u001b[?2004l\r"]
[879.985403, "o", "\u001b[?2004h> "]
[879.985456, "o", "        fi\r\n\u001b[?2004l\r"]
[879.985511, "o", "\u001b[?2004h> "]
[879.985835, "o", "        dep_time=$(cat \"$dep_cache_file\" 2>/dev/null || echo 0)\r\n\u001b[?2004l\r"]
[879.985891, "o", "\u001b[?2004h> "]
[879.986124, "o", "        if [[ ! \"$dep_time\" =~ ^[0-9]+$ ]]; then\r\n\u001b[?2004l\r"]
[879.986179, "o", "\u001b[?2004h> "]
[879.986278, "o", "            return 1\r\n\u001b[?2004l\r"]
[879.986333, "o", "\u001b[?2004h> "]
[879.986384, "o", "        fi\r\n\u001b[?2004l\r"]
[879.98644, "o", "\u001b[?2004h> "]
[879.986676, "o", "        if (( dep_time > cached_time )); then\r\n\u001b[?2004l\r"]
[879.986734, "o", "\u001b[?2004h> "]
[879.986827, "o", "            return 1\r\n\u001b[?2004l\r"]
[879.986881, "o", "\u001b[?2004h> "]
[879.986948, "o", "        fi\r\n\u001b[?2004l\r"]
[879.987004, "o", "\u001b[?2004h> "]
[879.98706, "o", "    done\r\n\u001b[?2004l\r\u001b[?2004h"]
[879.98712, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.987283, "o", "    return 0  # Cache is valid\r\n\u001b[?2004l\r"]
[879.987352, "o", "\u001b[?2004h> "]
[879.987412, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[879.987471, "o", "> "]
[879.987772, "o", "# Record the current time as the build timestamp for a package\r\n\u001b[?2004l\r"]
[879.987834, "o", "\u001b[?2004h> "]
[879.987907, "o", "update_cache() {\r\n\u001b[?2004l\r"]
[879.987964, "o", "\u001b[?2004h> "]
[879.988074, "o", "    local pkg_name=\"$1\"\r\n\u001b[?2004l\r"]
[879.988134, "o", "\u001b[?2004h> "]
[879.988202, "o", "    init_cache\r\n\u001b[?2004l\r"]
[879.988258, "o", "\u001b[?2004h> "]
[879.988503, "o", "    date +%s > \"$FORGE_CACHE_DIR/${pkg_name}.stamp\"\r\n\u001b[?2004l\r"]
[879.988575, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[879.988632, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.988778, "o", "# Remove cache entry for a package\r\n\u001b[?2004l\r"]
[879.988834, "o", "\u001b[?2004h> "]
[879.988895, "o", "invalidate_cache() {\r\n\u001b[?2004l\r"]
[879.988955, "o", "\u001b[?2004h> "]
[879.989028, "o", "    local pkg_name=\"$1\"\r\n\u001b[?2004l\r"]
[879.989083, "o", "\u001b[?2004h> "]
[879.989244, "o", "    rm -f \"$FORGE_CACHE_DIR/${pkg_name}.stamp\"\r\n\u001b[?2004l\r"]
[879.989299, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[879.989358, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.989502, "o", "# Wipe the entire cache directory\r\n\u001b[?2004l\r"]
[879.989569, "o", "\u001b[?2004h> "]
[879.989635, "o", "clean_cache() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.989769, "o", "    rm -rf \"$FORGE_CACHE_DIR\"\r\n\u001b[?2004l\r"]
[879.989823, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[879.989879, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[879.992817, "o", "\u001b[?2004hroot@n30009:/app# "]
[880.238612, "i", "cat > lib/builder.sh <<'EOF'\n#!/bin/bash\n# Build executor for ForgeKit\n#\n# Builds packages by running their Makefile in the correct environment.\n\n# Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.\n# Includes include and library paths for the full transitive dependency\n# closure, not just direct dependencies.\nsetup_build_env() {\n    local pkg_name=\"$1\"\n    parse_manifest \"$pkg_name\"\n\n    local cflags=\"\"\n    local ldflags=\"\"\n    local libs=\"\"\n    local deps\n\n    deps=$(get_all_deps \"$pkg_name\") || return 1\n\n    declare -A seen\n    local dep dep_dir\n    for dep in $deps; do\n        [[ -z \"$dep\" ]] && continue\n        [[ -n \"${seen[$dep]:-}\" ]] && continue\n        seen[$dep]=1\n\n        dep_dir=$(get_package_dir \"$dep\")\n        cflags=\"$cflags -I${dep_dir}/src\"\n        ldflags=\"$ldflags -L${dep_dir}/build\"\n\n        # For services linking against libraries\n        parse_manifest \"$dep\"\n        if [[ \"${MANIFEST_type:-}\" == \"library\" ]]; then\n            libs=\"$libs ${dep_dir}/build/${dep}.a\"\n        fi\n    done\n\n"]
[880.23886, "i", "    export FORGE_CFLAGS=\"$cflags\"\n    export FORGE_LDFLAGS=\"$ldflags\"\n    export FORGE_LIBS=\"$libs\"\n}\n\n# Build a single package\nbuild_package() {\n    local pkg_name=\"$1\"\n    local pkg_dir\n    pkg_dir=$(get_package_dir \"$pkg_name\")\n\n    if [[ ! -d \"$pkg_dir\" ]]; then\n        log_error \"Package directory not found: $pkg_dir\"\n        return 1\n    fi\n\n    # Check cache\n    if is_cache_valid \"$pkg_name\" 2>/dev/null; then\n        log_info \"[$pkg_name] Up to date (cached)\"\n        return 0\n    fi\n\n    log_info \"[$pkg_name] Building...\"\n\n    # Parse manifest for build command\n    parse_manifest \"$pkg_name\"\n    local build_cmd=\"${MANIFEST_command:-make}\"\n\n    # Set up build environment\n    if ! setup_build_env \"$pkg_name\"; then\n        log_error \"[$pkg_name] Failed to set up build environment\"\n        return 1\n    fi\n\n    # Execute build\n    if ! (cd \"$pkg_dir\" && eval \"$build_cmd\" 2>&1); then\n        log_error \"[$pkg_name] Build failed\"\n        return 1\n    fi\n\n    # Update cache\n    update_cache \"$pkg_name\"\n\n    log"]
[880.238893, "o", "cat > lib/builder.sh <<'EOF'\r\n\u001b[?2004l\r"]
[880.238998, "i", "_info \"[$pkg_name] Build successful\"\n    return 0\n}\n\n# Run tests for a single package\ntest_package() {\n    local pkg_name=\"$1\"\n    local pkg_dir\n    pkg_dir=$(get_package_dir \"$pkg_name\")\n\n    parse_manifest \"$pkg_name\"\n    local test_cmd=\"${MANIFEST_test_command:-make test}\"\n\n    if ! setup_build_env \"$pkg_name\"; then\n        log_error \"[$pkg_name] Failed to set up build environment\"\n        return 1\n    fi\n\n    log_info \"[$pkg_name] Running tests...\"\n    if ! (cd \"$pkg_dir\" && eval \"$test_cmd\" 2>&1); then\n        log_error \"[$pkg_name] Tests failed\"\n        return 1\n    fi\n\n    log_info \"[$pkg_name] Tests passed\"\n    return 0\n}\nEOF\n"]
[880.239025, "o", "\u001b[?2004h"]
