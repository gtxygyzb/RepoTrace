[880.254864, "o", "\u001b[?2004h> "]
[880.254924, "o", "    local pkg_dir\r\n\u001b[?2004l\r"]
[880.254979, "o", "\u001b[?2004h> "]
[880.255139, "o", "    pkg_dir=$(get_package_dir \"$pkg_name\")\r\n\u001b[?2004l\r"]
