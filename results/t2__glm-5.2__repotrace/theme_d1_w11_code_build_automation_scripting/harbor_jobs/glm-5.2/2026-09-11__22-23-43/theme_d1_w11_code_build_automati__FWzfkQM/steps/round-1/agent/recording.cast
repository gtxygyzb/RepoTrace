[1402.213024, "o", "\u001b[?2004h> "]
[1402.213114, "o", "parse_manifest() {\r\n\u001b[?2004l\r"]
[1402.213181, "o", "\u001b[?2004h> "]
[1402.213305, "o", "    local pkg_name=\"$1\"\r\n\u001b[?2004l\r"]
[1402.213372, "o", "\u001b[?2004h> "]
[1402.213495, "o", "    local manifest_file\r\n\u001b[?2004l\r"]
[1402.213579, "o", "\u001b[?2004h> "]
[1402.213872, "o", "    manifest_file=$(get_package_manifest \"$pkg_name\")\r\n\u001b[?2004l\r"]
[1402.213941, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1402.214006, "o", "\u001b[?2004h> "]
[1402.214212, "o", "    if [[ ! -f \"$manifest_file\" ]]; then\r\n\u001b[?2004l\r"]
[1402.214281, "o", "\u001b[?2004h> "]
[1402.214583, "o", "        log_error \"Manifest not found: $manifest_file\"\r\n\u001b[?2004l\r"]
[1402.214653, "o", "\u001b[?2004h> "]
[1402.214741, "o", "        return 1\r\n\u001b[?2004l\r"]
[1402.214807, "o", "\u001b[?2004h> "]
[1402.214874, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1402.214943, "o", "\u001b[?2004h> "]
[1402.215139, "o", "    # Clear previous manifest data\r\n\u001b[?2004l\r"]
[1402.215205, "o", "\u001b[?2004h> "]
[1402.215279, "o", "    local var\r\n\u001b[?2004l\r"]
[1402.215345, "o", "\u001b[?2004h> "]
[1402.215711, "o", "    for var in $(compgen -v MANIFEST_ 2>/dev/null || true); do\r\n\u001b[?2004l\r"]
[1402.215778, "o", "\u001b[?2004h> "]
[1402.215887, "o", "        unset \"$var\"\r\n\u001b[?2004l\r"]
[1402.215955, "o", "\u001b[?2004h> "]
[1402.216022, "o", "    done\r\n\u001b[?2004l\r\u001b[?2004h"]
[1402.216094, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1402.216269, "o", "    local current_section=\"\"\r\n\u001b[?2004l\r"]
[1402.216335, "o", "\u001b[?2004h> "]
[1402.216521, "o", "    local line key value next_line\r\n\u001b[?2004l\r"]
[1402.216644, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1402.216938, "o", "    while IFS= read -r line || [[ -n \"$line\" ]]; do\r\n\u001b[?2004l\r"]
[1402.217022, "o", "\u001b[?2004h> "]
[1402.217268, "o", "        # Skip empty lines and full-line comments\r\n\u001b[?2004l\r"]
[1402.217336, "o", "\u001b[?2004h> "]
[1402.217635, "o", "        [[ \"$line\" =~ ^[[:space:]]*$ ]] && continue\r\n\u001b[?2004l\r"]
[1402.217702, "o", "\u001b[?2004h> "]
[1402.217983, "o", "        [[ \"$line\" =~ ^[[:space:]]*# ]] && continue\r\n\u001b[?2004l\r"]
[1402.21805, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1402.218117, "o", "\u001b[?2004h> "]
[1402.218244, "o", "        # Section header\r\n\u001b[?2004l\r"]
[1402.218311, "o", "\u001b[?2004h> "]
[1402.218674, "o", "        if [[ \"$line\" =~ ^\\[([a-zA-Z_][a-zA-Z0-9_]*)\\] ]]; then\r\n\u001b[?2004l\r"]
[1402.218744, "o", "\u001b[?2004h> "]
[1402.219008, "o", "            current_section=\"${BASH_REMATCH[1]}\"\r\n\u001b[?2004l\r"]
[1402.219076, "o", "\u001b[?2004h> "]
[1402.219193, "o", "            continue\r\n\u001b[?2004l\r"]
[1402.219261, "o", "\u001b[?2004h> "]
[1402.219333, "o", "        fi\r\n\u001b[?2004l\r"]
[1402.2194, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1402.219466, "o", "> "]
[1402.219593, "o", "        # Key = value pair\r\n\u001b[?2004l\r"]
[1402.21966, "o", "\u001b[?2004h> "]
[1402.220141, "o", "        if [[ \"$line\" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then\r\n\u001b[?2004l\r"]
[1402.220208, "o", "\u001b[?2004h> "]
[1402.220376, "o", "            key=\"${BASH_REMATCH[1]}\"\r\n\u001b[?2004l\r"]
[1402.220448, "o", "\u001b[?2004h> "]
[1402.220633, "o", "            value=\"${BASH_REMATCH[2]}\"\r\n\u001b[?2004l\r"]
[1402.220705, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1402.220773, "o", "> "]
[1402.221114, "o", "            # Strip inline comments preceded by whitespace.  A '#' inside a\r\n\u001b[?2004l\r"]
[1402.221182, "o", "\u001b[?2004h> "]
[1402.221478, "o", "            # value without preceding whitespace is preserved.\r\n\u001b[?2004l\r"]
[1402.221547, "o", "\u001b[?2004h> "]
[1402.221809, "o", "            if [[ \"$value\" =~ ^[[:space:]]*# ]]; then\r\n\u001b[?2004l\r"]
[1402.221879, "o", "\u001b[?2004h> "]
[1402.221989, "o", "                value=\"\"\r\n\u001b[?2004l\r"]
[1402.222056, "o", "\u001b[?2004h> "]
[1402.222302, "o", "            elif [[ \"$value\" =~ [[:space:]]# ]]; then\r\n\u001b[?2004l\r"]
[1402.222369, "o", "\u001b[?2004h> "]
[1402.2226, "o", "                value=\"${value%%[[:space:]]#*}\"\r\n\u001b[?2004l\r"]
[1402.22267, "o", "\u001b[?2004h> "]
[1402.222741, "o", "            fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[1402.222806, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1402.223076, "o", "            # Trim trailing whitespace from value\r\n\u001b[?2004l\r"]
[1402.223142, "o", "\u001b[?2004h> "]
[1402.223396, "o", "            value=\"${value%\"${value##*[![:space:]]}\"}\"\r\n\u001b[?2004l\r"]
[1402.223463, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1402.223529, "o", "> "]
[1402.223923, "o", "            # Handle backslash line continuation.  A trailing backslash joins\r\n\u001b[?2004l\r"]
[1402.223989, "o", "\u001b[?2004h> "]
[1402.224334, "o", "            # the next line; the backslash and leading whitespace on the\r\n\u001b[?2004l\r"]
[1402.224401, "o", "\u001b[?2004h> "]
[1402.224628, "o", "            # continuation line are stripped.\r\n\u001b[?2004l\r"]
[1402.224697, "o", "\u001b[?2004h> "]
[1402.224897, "o", "            while [[ \"$value\" == *\\\\ ]]; do\r\n\u001b[?2004l\r"]
[1402.224963, "o", "\u001b[?2004h> "]
[1402.225124, "o", "                value=\"${value%\\\\}\"\r\n\u001b[?2004l\r"]
[1402.22519, "o", "\u001b[?2004h> "]
[1402.225534, "o", "                if IFS= read -r next_line || [[ -n \"$next_line\" ]]; then\r\n\u001b[?2004l\r"]
[1402.225619, "o", "\u001b[?2004h> "]
[1402.225966, "o", "                    next_line=\"${next_line#\"${next_line##*[![:space:]]}\"}\"\r\n\u001b[?2004l\r"]
[1402.226035, "o", "\u001b[?2004h> "]
[1402.226395, "o", "                    next_line=\"${next_line%\"${next_line##*[![:space:]]}\"}\"\r\n\u001b[?2004l\r"]
[1402.226467, "o", "\u001b[?2004h> "]
[1402.226681, "o", "                    value=\"$value$next_line\"\r\n\u001b[?2004l\r"]
[1402.22675, "o", "\u001b[?2004h> "]
[1402.226838, "o", "                else\r\n\u001b[?2004l\r"]
[1402.226905, "o", "\u001b[?2004h> "]
[1402.227016, "o", "                    break\r\n\u001b[?2004l\r"]
[1402.227084, "o", "\u001b[?2004h> "]
[1402.227161, "o", "                fi\r\n\u001b[?2004l\r"]
[1402.227227, "o", "\u001b[?2004h> "]
[1402.227296, "o", "            done\r\n\u001b[?2004l\r"]
[1402.227361, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1402.227427, "o", "> "]
[1402.22764, "o", "            export \"MANIFEST_${key}=${value}\"\r\n\u001b[?2004l\r"]
[1402.227708, "o", "\u001b[?2004h> "]
[1402.227778, "o", "        fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1402.227936, "o", "    done < \"$manifest_file\"\r\n\u001b[?2004l\r"]
[1402.228003, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1402.228069, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1402.228135, "o", "> "]
[1402.228331, "o", "# Convenience: parse and return a single value\r\n\u001b[?2004l\r"]
[1402.2284, "o", "\u001b[?2004h> "]
[1402.228498, "o", "get_manifest_value() {\r\n\u001b[?2004l\r"]
[1402.228578, "o", "\u001b[?2004h> "]
[1402.228702, "o", "    local pkg_name=\"$1\"\r\n\u001b[?2004l\r"]
[1402.228769, "o", "\u001b[?2004h> "]
[1402.228853, "o", "    local key=\"$2\"\r\n\u001b[?2004l\r"]
[1402.228919, "o", "\u001b[?2004h> "]
[1402.229117, "o", "    if ! parse_manifest \"$pkg_name\"; then\r\n\u001b[?2004l\r"]
[1402.229184, "o", "\u001b[?2004h> "]
[1402.229256, "o", "        return 1\r\n\u001b[?2004l\r"]
[1402.229321, "o", "\u001b[?2004h>     fi\r\n\u001b[?2004l\r"]
[1402.229386, "o", "\u001b[?2004h> "]
[1402.229581, "o", "    local var=\"MANIFEST_${key}\"\r\n\u001b[?2004l\r"]
[1402.229649, "o", "\u001b[?2004h> "]
[1402.229735, "o", "    echo \"${!var:-}\"\r\n\u001b[?2004l\r"]
[1402.229801, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1402.229867, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1402.232706, "o", "\u001b[?2004hroot@n30009:/app# "]
[1403.036911, "i", "cat > tests/run_tests.sh <<'EOF'\r#!/bin/bash\r# ForgeKit Internal Test Suite\r#\r# Tests for the forge build automation system itself.\r# Run with: bash tests/run_tests.sh\r\rFORGE_ROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\rexport FORGE_ROOT\r\rsource \"$FORGE_ROOT/lib/common.sh\"\rsource \"$FORGE_ROOT/lib/manifest.sh\"\rsource \"$FORGE_ROOT/lib/depgraph.sh\"\rsource \"$FORGE_ROOT/lib/builder.sh\"\rsource \"$FORGE_ROOT/lib/cache.sh\"\rsource \"$FORGE_ROOT/lib/artifact.sh\"\rsource \"$FORGE_ROOT/lib/reporter.sh\"\rsource \"$FORGE_ROOT/lib/configgen.sh\"\r\rTOTAL=0\rPASSED=0\rFAILED=0\r\rassert_eq() {\r    local desc=\"$1\" expected=\"$2\" actual=\"$3\"\r    ((TOTAL++))\r    if [[ \"$expected\" == \"$actual\" ]]; then\r        echo \"  PASS: $desc\"\r        ((PASSED++))\r    else\r        echo \"  FAIL: $desc\"\r        echo \"    expected: '$expected'\"\r        echo \"    actual:   '$actual'\"\r        ((FAILED++))\r    fi\r}\r\rassert_contains() {\r    local desc=\"$1\" haystack=\"$2\" needle=\"$3\"\r    ((TOTAL++))\r    if [[ \"$haystack\" == *\"$needle\"* ]]; then\r        echo \"  PASS: $"]
[1403.037204, "i", "desc\"\r        ((PASSED++))\r    else\r        echo \"  FAIL: $desc\"\r        echo \"    expected to contain: '$needle'\"\r        echo \"    in: '$haystack'\"\r        ((FAILED++))\r    fi\r}\r\rassert_not_contains() {\r    local desc=\"$1\" haystack=\"$2\" needle=\"$3\"\r    ((TOTAL++))\r    if [[ \"$haystack\" != *\"$needle\"* ]]; then\r        echo \"  PASS: $desc\"\r        ((PASSED++))\r    else\r        echo \"  FAIL: $desc\"\r        echo \"    expected NOT to contain: '$needle'\"\r        echo \"    in: '$haystack'\"\r        ((FAILED++))\r    fi\r}\r\rassert_exit_zero() {\r    local desc=\"$1\"\r    shift\r    ((TOTAL++))\r    if \"$@\" > /dev/null 2>&1; then\r        echo \"  PASS: $desc\"\r        ((PASSED++))\r    else\r        echo \"  FAIL: $desc (exit code: $?)\"\r        ((FAILED++))\r    fi\r}\r\rassert_exit_nonzero() {\r    local desc=\"$1\"\r    shift\r    ((TOTAL++))\r    if \"$@\" > /dev/null 2>&1; then\r        echo \"  FAIL: $desc (expected failure but got success)\"\r        ((FAILED++))\r    else\r        echo \"  PASS: $desc\"\r        ((PASSED++))\r    fi\r}\r\rassert_"]
[1403.037242, "o", "cat > tests/run_tests.sh <<'EOF'\r\n\u001b[?2004l\r"]
[1403.037377, "i", "grep() {\r    local desc=\"$1\" text=\"$2\" pattern=\"$3\"\r    ((TOTAL++))\r    if echo \"$text\" | grep -q \"$pattern\"; then\r        echo \"  PASS: $desc\"\r        ((PASSED++))\r    else\r        echo \"  FAIL: $desc\"\r        echo \"    expected to match: '$pattern'\"\r        echo \"    in: '$text'\"\r        ((FAILED++))\r    fi\r}\r\rwith_forge_root() {\r    local root=\"$1\"\r    shift\r    FORGE_ROOT=\"$root\" \"$@\"\r}\r\r# ==================================================================\recho \"\"\recho \"=== Manifest Parser Tests ===\"\r\rparse_manifest \"libbase\"\rassert_eq \"libbase name\" \"libbase\" \"${MANIFEST_name:-}\"\rassert_eq \"libbase version\" \"1.0.0\" \"${MANIFEST_version:-}\"\rassert_eq \"libbase type\" \"library\" \"${MANIFEST_type:-}\"\rassert_eq \"libbase has no deps\" \"\" \"${MANIFEST_deps:-}\"\r\rparse_manifest \"libcrypto\"\rassert_eq \"libcrypto deps\" \"libbase\" \"${MANIFEST_deps:-}\"\r\rparse_manifest \"svc-auth\"\rassert_eq \"svc-auth type\" \"service\" \"${MANIFEST_type:-}\"\rassert_eq \"svc-auth deps\" \"libcrypto,libstore\" \"${MANIFEST_deps:-}\"\r\rassert_exit_nonzero \"m"]
[1403.037452, "o", "desc\"\r\n        ((PASSED++))\r\n    else\r\n        echo \"  FAIL: $desc\"\r\n        echo \"    expected to contain: '$needle'\"\r\n        echo \"    in: '$haystack'\"\r\n        ((FAILED++))\r\n    fi\r\n}\r\n\r\nassert_not_contains() {\r\n    local desc=\"$1\" haystack="]
[1403.037543, "i", "issing manifest errors\" parse_manifest no-such-package\r\rtmp_manifest_root=$(mktemp -d)\rmkdir -p \"$tmp_manifest_root/packages/pkg-cont\"\rcat > \"$tmp_manifest_root/packages/pkg-cont/package.forge\" <<'MANIFEST'\r[package]\rname = pkg-cont\rversion = 1.0.0\rtype = library\r\rdescription = first part \\\r              second part\rtags = one,two,three\rnotes = value # inline comment\rempty =\rMANIFEST\r\rwith_forge_root \"$tmp_manifest_root\" parse_manifest \"pkg-cont\"\rassert_eq \"continuation name\" \"pkg-cont\" \"${MANIFEST_name:-}\"\rassert_eq \"continuation version\" \"1.0.0\" \"${MANIFEST_version:-}\"\rassert_eq \"continuation joined value\" \"first part second part\" \"${MANIFEST_description:-}\"\rassert_eq \"continuation preserves normal value\" \"one,two,three\" \"${MANIFEST_tags:-}\"\rassert_eq \"inline comment stripped\" \"value\" \"${MANIFEST_notes:-}\"\rassert_eq \"empty value parsed\" \"\" \"${MANIFEST_empty:-}\"\rrm -rf \"$tmp_manifest_root\"\r\r# ==================================================================\recho \"\"\recho \"=== Dependency Graph Tests ===\"\r\rbui"]
