[174.188715, "o", "sed -n '1,240p' forge\r\n\u001b[?2004l\r"]
[174.191624, "o", "#!/bin/bash\r\n# ForgeKit - Legacy Build Automation System\r\n# Main CLI entry point\r\n\r\nFORGE_ROOT=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\r\nexport FORGE_ROOT\r\n"]
[174.191731, "o", "\r\n# Source library modules\r\nsource \"$FORGE_ROOT/lib/common.sh\"\r\nsource \"$FORGE_ROOT/lib/manifest.sh\"\r\nsource \"$FORGE_ROOT/lib/depgraph.sh\"\r\nsource \"$FORGE_ROOT/lib/builder.sh\"\r\nsource \"$FORGE_ROOT/lib/cache.sh\"\r\nsource \"$FORGE_ROOT/lib/artifact.sh\"\r\nsource \"$FORGE_ROOT/lib/reporter.sh\"\r\nsource \"$FORGE_ROOT/lib/configgen.sh\"\r\n\r\n# Load global config\r\nif [[ -f \"$FORGE_ROOT/config/forge.conf\" ]]; then\r\n    source \"$FORGE_ROOT/config/forge.conf\"\r\nfi\r\n\r\nusage() {\r\n    cat <<'EOF'\r\nUsage: forge <command> [options]\r\n"]
[174.191808, "o", "\r\nCommands:\r\n  build [--all|--package NAME]  Build packages\r\n  test  [--all|--package NAME]  Run package tests\r\n  list                          List all packages\r\n  deps  NAME                    Show dependency tree for a package\r\n  report                        Generate build report\r\n  config generate ENV           Generate deployment configs from templates\r\n  artifact pack NAME            Package build artifact\r\n  clean [--all|--package NAME]  Clean build artifacts\r\nEOF\r\n    exit 1\r\n}\r\n\r\ncmd_build() {\r\n    if [[ $# -lt 1 ]]; then usage; fi\r\n    local target=\"$1\"\r\n    if [[ \"$target\" == \"--all\" ]]; then\r\n        local order\r\n"]
[174.191877, "o", "        order=$(resolve_build_order)\r\n        if [[ $? -ne 0 ]]; then\r\n            log_error \"Failed to resolve build order\"\r\n            return 1\r\n        fi\r\n        for pkg in $order; do\r\n            build_package \"$pkg\"\r\n            if [[ $? -ne 0 ]]; then\r\n                log_error \"Build failed for $pkg\"\r\n                return 1\r\n            fi\r\n        done\r\n        log_info \"All packages built successfully\"\r\n"]
[174.19196, "o", "    elif [[ \"$target\" == \"--package\" ]]; then\r\n        if [[ $# -lt 2 ]]; then usage; fi\r\n        local name=\"$2\"\r\n        local order\r\n        order=$(resolve_deps_for \"$name\")\r\n        if [[ $? -ne 0 ]]; then\r\n            log_error \"Failed to resolve dependencies for $name\"\r\n            return 1\r\n        fi\r\n        for pkg in $order; do\r\n            build_package \"$pkg\"\r\n            if [[ $? -ne 0 ]]; then\r\n                log_error \"Build failed for $pkg\"\r\n                return 1\r\n            fi\r\n        done\r\n    else\r\n"]
[174.192025, "o", "        usage\r\n    fi\r\n}\r\n\r\ncmd_test() {\r\n    if [[ $# -lt 1 ]]; then usage; fi\r\n    local target=\"$1\"\r\n    local failed=0\r\n    if [[ \"$target\" == \"--all\" ]]; then\r\n        local order\r\n        order=$(resolve_build_order)\r\n"]
[174.192089, "o", "        for pkg in $order; do\r\n            if ! test_package \"$pkg\"; then\r\n                log_warn \"Tests failed for $pkg\"\r\n                ((failed++))\r\n            fi\r\n        done\r\n    elif [[ \"$target\" == \"--package\" ]]; then\r\n        if [[ $# -lt 2 ]]; then usage; fi\r\n        local name=\"$2\"\r\n        if ! test_package \"$name\"; then\r\n            ((failed++))\r\n        fi\r\n    else\r\n        usage\r\n    fi\r\n"]
[174.192151, "o", "    if [[ $failed -gt 0 ]]; then\r\n        log_error \"$failed package(s) had test failures\"\r\n        return 1\r\n    fi\r\n    log_info \"All tests passed\"\r\n}\r\n\r\ncmd_list() {\r\n    list_packages\r\n}\r\n\r\ncmd_deps() {\r\n    if [[ $# -lt 1 ]]; then usage; fi\r\n"]
[174.192201, "o", "    show_dep_tree \"$1\" 0\r\n}\r\n\r\ncmd_report() {\r\n    generate_report\r\n}\r\n\r\ncmd_config() {\r\n    if [[ $# -lt 2 || \"$1\" != \"generate\" ]]; then usage; fi\r\n    generate_config \"$2\"\r\n"]
[174.192287, "o", "}\r\n\r\ncmd_artifact() {\r\n    if [[ $# -lt 2 || \"$1\" != \"pack\" ]]; then usage; fi\r\n    pack_artifact \"$2\"\r\n}\r\n\r\ncmd_clean() {\r\n    if [[ $# -lt 1 ]]; then usage; fi\r\n    local target=\"$1\"\r\n    if [[ \"$target\" == \"--all\" ]]; then\r\n        for pkg_name in $(list_package_names); do\r\n            clean_package \"$pkg_name\"\r\n        done\r\n        clean_cache\r\n        log_info \"All packages cleaned\"\r\n    elif [[ \"$target\" == \"--package\" ]]; then\r\n"]
[174.192329, "o", "        if [[ $# -lt 2 ]]; then usage; fi\r\n        clean_package \"$2\"\r\n    else\r\n        usage\r\n    fi\r\n}\r\n\r\n# Main dispatch\r\nif [[ $# -lt 1 ]]; then\r\n    usage\r\n"]
[174.192423, "o", "fi\r\n\r\ncommand=\"$1\"\r\nshift\r\n\r\ncase \"$command\" in\r\n    build)    cmd_build \"$@\" ;;\r\n    test)     cmd_test \"$@\" ;;\r\n    list)     cmd_list ;;\r\n    deps)     cmd_deps \"$@\" ;;\r\n    report)   cmd_report ;;\r\n    config)   cmd_config \"$@\" ;;\r\n    artifact) cmd_artifact \"$@\" ;;\r\n    clean)    cmd_clean \"$@\" ;;\r\n    *)        usage ;;\r\nesac\r\n"]
[174.192891, "o", "\u001b[?2004h"]
[174.192949, "o", "root@n30009:/app# "]
[174.453057, "i", "for f in lib/manifest.sh lib/common.sh lib/depgraph.sh lib/cache.sh lib/builder.sh lib/artifact.sh lib/configgen.sh lib/reporter.sh; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\n"]
[174.454291, "o", "for f in lib/manifest.sh lib/common.sh lib/depgraph.sh lib/cache.sh lib/builder.sh lib/artifact.sh lib/configgen.sh lib/reporter.sh; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[174.454475, "o", "===== lib/manifest.sh =====\r\n"]
[174.457225, "o", "#!/bin/bash\r\n# Manifest parser for .forge package files\r\n#\r\n# Format:\r\n#   [section]\r\n#   key = value\r\n#   # comments\r\n"]
[174.457309, "o", "#   key = long value \\\r\n#         continued on next line\r\n#\r\n# All parsed values are exported as MANIFEST_<key>=<value>\r\n\r\nparse_manifest() {\r\n    local pkg_name=\"$1\"\r\n    local manifest_file\r\n    manifest_file=$(get_package_manifest \"$pkg_name\")\r\n\r\n    if [[ ! -f \"$manifest_file\" ]]; then\r\n        log_error \"Manifest not found: $manifest_file\"\r\n        return 1\r\n    fi\r\n\r\n    # Clear previous manifest data\r\n"]
[174.457351, "o", "    local var\r\n    for var in $(compgen -v MANIFEST_); do\r\n        unset \"$var\"\r\n    done\r\n\r\n    local current_section=\"\"\r\n    local line key value\r\n\r\n    while IFS= read -r line || [[ -n \"$line\" ]]; do\r\n"]
[174.457464, "o", "        # Skip empty lines and comments\r\n        [[ \"$line\" =~ ^[[:space:]]*$ ]] && continue\r\n        [[ \"$line\" =~ ^[[:space:]]*# ]] && continue\r\n\r\n        # Section header\r\n        if [[ \"$line\" =~ ^\\[([a-zA-Z_][a-zA-Z0-9_]*)\\] ]]; then\r\n            current_section=\"${BASH_REMATCH[1]}\"\r\n            continue\r\n        fi\r\n\r\n        # Key = value pair\r\n        if [[ \"$line\" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then\r\n            key=\"${BASH_REMATCH[1]}\"\r\n            value=\"${BASH_REMATCH[2]}\"\r\n\r\n            # Trim trailing whitespace from value\r\n            value=\"${value%\"${value##*[![:space:]]}\"}\"\r\n\r\n            # BUG: Does not handle backslash line continuation.\r\n            # If the value ends with '\\', the next line(s) should be\r\n            # appended (minus the backslash). Currently, the trailing\r\n            # backslash is kept and continuation lines are ignored.\r\n\r\n"]
[174.457536, "o", "            export \"MANIFEST_${key}=${value}\"\r\n        fi\r\n    done < \"$manifest_file\"\r\n}\r\n\r\n# Convenience: parse and return a single value\r\nget_manifest_value() {\r\n    local pkg_name=\"$1\"\r\n    local key=\"$2\"\r\n    parse_manifest \"$pkg_name\"\r\n    local var=\"MANIFEST_${key}\"\r\n    echo \"${!var:-}\"\r\n}\r\n"]
[174.457974, "o", "===== lib/common.sh =====\r\n"]
[174.460621, "o", "#!/bin/bash\r\n# Common utilities for ForgeKit\r\n\r\nlog_info() {\r\n    echo \"[FORGE INFO] $*\"\r\n}\r\n\r\nlog_warn() {\r\n    echo \"[FORGE WARN] $*\" >&2\r\n"]
[174.460656, "o", "}\r\n\r\nlog_error() {\r\n    echo \"[FORGE ERROR] $*\" >&2\r\n}\r\n\r\n# Get the absolute path to a package directory\r\nget_package_dir() {\r\n"]
[174.460742, "o", "    local name=\"$1\"\r\n    echo \"$FORGE_ROOT/packages/$name\"\r\n}\r\n\r\n# Get the absolute path to a package manifest\r\nget_package_manifest() {\r\n    local name=\"$1\"\r\n    echo \"$FORGE_ROOT/packages/$name/package.forge\"\r\n}\r\n\r\n# List all package names (directories under packages/ with a manifest)\r\nlist_package_names() {\r\n    local pkg_dir\r\n    for pkg_dir in \"$FORGE_ROOT/packages\"/*/; do\r\n        if [[ -f \"$pkg_dir/package.forge\" ]]; then\r\n            basename \"$pkg_dir\"\r\n        fi\r\n"]
[174.460806, "o", "    done\r\n}\r\n\r\n# Display formatted package listing\r\nlist_packages() {\r\n    local name version type deps\r\n    printf \"%-25s %-10s %-10s %s\\n\" \"NAME\" \"VERSION\" \"TYPE\" \"DEPENDENCIES\"\r\n    printf \"%-25s %-10s %-10s %s\\n\" \"----\" \"-------\" \"----\" \"------------\"\r\n    for pkg_name in $(list_package_names); do\r\n        parse_manifest \"$pkg_name\"\r\n        name=\"${MANIFEST_name:-$pkg_name}\"\r\n        version=\"${MANIFEST_version:-unknown}\"\r\n        type=\"${MANIFEST_type:-unknown}\"\r\n        deps=\"${MANIFEST_deps:-none}\"\r\n"]
[174.460866, "o", "        printf \"%-25s %-10s %-10s %s\\n\" \"$name\" \"$version\" \"$type\" \"$deps\"\r\n    done\r\n}\r\n\r\n# Clean build artifacts for a package\r\nclean_package() {\r\n    local name=\"$1\"\r\n    local pkg_dir\r\n    pkg_dir=$(get_package_dir \"$name\")\r\n    if [[ -d \"$pkg_dir/build\" ]]; then\r\n        rm -rf \"$pkg_dir/build\"\r\n        log_info \"Cleaned $name\"\r\n    fi\r\n"]
[174.460933, "o", "    find \"$pkg_dir/src\" -name \"*.o\" -delete 2>/dev/null || true\r\n}\r\n"]
[174.461284, "o", "===== lib/depgraph.sh =====\r\n"]
[174.463912, "o", "#!/bin/bash\r\n# Dependency graph resolution for ForgeKit\r\n#\r\n# Provides topological-sort-based build ordering and\r\n# dependency tree queries.\r\n\r\n# Build an associative array mapping package -> comma-separated deps\r\n"]
[174.463984, "o", "build_dep_map() {\r\n    declare -gA DEP_MAP\r\n    # Reset\r\n    for k in \"${!DEP_MAP[@]}\"; do unset \"DEP_MAP[$k]\"; done\r\n\r\n    local pkg_name deps_str\r\n    for pkg_name in $(list_package_names); do\r\n        parse_manifest \"$pkg_name\"\r\n        deps_str=\"${MANIFEST_deps:-}\"\r\n        DEP_MAP[$pkg_name]=\"$deps_str\"\r\n    done\r\n}\r\n\r\n# -------------------------------------------------------------------\r\n# Topological sort via DFS\r\n#\r\n"]
[174.464054, "o", "# BUG: The visited flag is only set AFTER recursing into children.\r\n#      If there is a cycle (A -> B -> A), the function will recurse\r\n#      forever because neither A nor B is marked visited when the\r\n#      cycle is re-entered.  There is no \"currently visiting\" state\r\n#      that would allow the algorithm to detect the back-edge.\r\n# -------------------------------------------------------------------\r\nresolve_build_order() {\r\n    build_dep_map\r\n\r\n    declare -A _visited\r\n    local _order=\"\"\r\n\r\n    _topo_visit() {\r\n        local node=\"$1\"\r\n"]
[174.464118, "o", "\r\n        # Already finished\r\n        [[ \"${_visited[$node]:-}\" == \"done\" ]] && return 0\r\n\r\n        # Recurse into dependencies first\r\n        local deps=\"${DEP_MAP[$node]:-}\"\r\n        if [[ -n \"$deps\" ]]; then\r\n            local IFS=','\r\n            for dep in $deps; do\r\n                dep=\"${dep// /}\"\r\n                [[ -z \"$dep\" ]] && continue\r\n                _topo_visit \"$dep\"\r\n            done\r\n"]
[174.464178, "o", "        fi\r\n\r\n        _visited[$node]=\"done\"\r\n        _order=\"$_order $node\"\r\n    }\r\n\r\n    for pkg in $(list_package_names); do\r\n        _topo_visit \"$pkg\"\r\n    done\r\n\r\n    echo \"$_order\"\r\n}\r\n\r\n# Resolve the build chain for a single target (inclusive)\r\n"]
[174.464281, "o", "resolve_deps_for() {\r\n    local target=\"$1\"\r\n    build_dep_map\r\n\r\n    declare -A _visited\r\n    local _order=\"\"\r\n\r\n    _dep_visit() {\r\n        local node=\"$1\"\r\n        [[ \"${_visited[$node]:-}\" == \"done\" ]] && return 0\r\n\r\n        local deps=\"${DEP_MAP[$node]:-}\"\r\n        if [[ -n \"$deps\" ]]; then\r\n            local IFS=','\r\n            for dep in $deps; do\r\n                dep=\"${dep// /}\"\r\n                [[ -z \"$dep\" ]] && continue\r\n                _dep_visit \"$dep\"\r\n            done\r\n        fi\r\n\r\n        _visited[$node]=\"done\"\r\n        _order=\"$_order $node\"\r\n"]
[174.464351, "o", "    }\r\n\r\n    _dep_visit \"$target\"\r\n    echo \"$_order\"\r\n}\r\n\r\n# Pretty-print the dependency tree (recursive, indented)\r\nshow_dep_tree() {\r\n    local name=\"$1\"\r\n    local indent=\"${2:-0}\"\r\n\r\n    # Ensure the dep map exists\r\n    if [[ -z \"${DEP_MAP[*]+_}\" ]]; then\r\n        build_dep_map\r\n"]
[174.46443, "o", "    fi\r\n\r\n    local prefix=\"\"\r\n    for ((i = 0; i < indent; i++)); do prefix=\"$prefix  \"; done\r\n\r\n    echo \"${prefix}${name}\"\r\n\r\n    local deps=\"${DEP_MAP[$name]:-}\"\r\n    if [[ -n \"$deps\" ]]; then\r\n        local IFS=','\r\n        for dep in $deps; do\r\n            dep=\"${dep// /}\"\r\n            [[ -z \"$dep\" ]] && continue\r\n            show_dep_tree \"$dep\" $((indent + 1))\r\n        done\r\n    fi\r\n}\r\n\r\n"]
[174.464494, "o", "# Return all transitive dependencies (not including the package itself)\r\nget_all_deps() {\r\n    local name=\"$1\"\r\n    if [[ -z \"${DEP_MAP[*]+_}\" ]]; then\r\n        build_dep_map\r\n    fi\r\n\r\n    declare -A _seen\r\n    local _result=\"\"\r\n\r\n    _collect_deps() {\r\n        local node=\"$1\"\r\n        local deps=\"${DEP_MAP[$node]:-}\"\r\n"]
[174.464608, "o", "        if [[ -n \"$deps\" ]]; then\r\n            local IFS=','\r\n            for dep in $deps; do\r\n                dep=\"${dep// /}\"\r\n                [[ -z \"$dep\" ]] && continue\r\n                if [[ -z \"${_seen[$dep]:-}\" ]]; then\r\n                    _seen[$dep]=1\r\n                    _result=\"$_result $dep\"\r\n                    _collect_deps \"$dep\"\r\n                fi\r\n            done\r\n        fi\r\n    }\r\n\r\n    _collect_deps \"$name\"\r\n    echo \"$_result\"\r\n}\r\n"]
[174.464971, "o", "===== lib/cache.sh =====\r\n"]
[174.467613, "o", "#!/bin/bash\r\n# Build cache management for ForgeKit\r\n#\r\n# Uses timestamp-based caching: each package records a \"last built\"\r\n# timestamp; a rebuild is triggered when source files are newer.\r\n"]
[174.46768, "o", "\r\nFORGE_CACHE_DIR=\"${FORGE_ROOT}/.forge_cache\"\r\n\r\ninit_cache() {\r\n    mkdir -p \"$FORGE_CACHE_DIR\"\r\n}\r\n\r\n# Newest mtime among all files under a package's src/ directory\r\nget_src_mtime() {\r\n    local pkg_name=\"$1\"\r\n    local pkg_dir\r\n    pkg_dir=$(get_package_dir \"$pkg_name\")\r\n\r\n    local latest=0\r\n    local mtime\r\n"]
[174.467756, "o", "    while IFS= read -r -d '' file; do\r\n        mtime=$(stat -c %Y \"$file\" 2>/dev/null || echo 0)\r\n        if (( mtime > latest )); then\r\n            latest=$mtime\r\n        fi\r\n    done < <(find \"$pkg_dir/src\" -type f -print0 2>/dev/null)\r\n\r\n    # Also check Makefile\r\n    if [[ -f \"$pkg_dir/Makefile\" ]]; then\r\n        mtime=$(stat -c %Y \"$pkg_dir/Makefile\" 2>/dev/null || echo 0)\r\n        if (( mtime > latest )); then\r\n            latest=$mtime\r\n        fi\r\n    fi\r\n\r\n"]
[174.467817, "o", "    echo \"$latest\"\r\n}\r\n\r\n# Check whether the cached build is still valid.\r\n#\r\n# BUG: Only compares the package's own source timestamps against its\r\n#      cached build timestamp.  It does NOT check whether any of the\r\n#      package's transitive dependencies have been rebuilt more\r\n#      recently.  This means that modifying libbase and rebuilding it\r\n#      will NOT trigger a rebuild of libcrypto (which depends on\r\n"]
[174.467875, "o", "#      libbase) during an incremental build.\r\nis_cache_valid() {\r\n    local pkg_name=\"$1\"\r\n    init_cache\r\n    local cache_file=\"$FORGE_CACHE_DIR/${pkg_name}.stamp\"\r\n\r\n    if [[ ! -f \"$cache_file\" ]]; then\r\n        return 1  # No cache -> rebuild\r\n    fi\r\n\r\n    local cached_time\r\n    cached_time=$(cat \"$cache_file\")\r\n\r\n"]
[174.467935, "o", "    local src_mtime\r\n    src_mtime=$(get_src_mtime \"$pkg_name\")\r\n\r\n    if (( src_mtime > cached_time )); then\r\n        return 1  # Source newer than cache -> rebuild\r\n    fi\r\n\r\n    return 0  # Cache is valid\r\n}\r\n\r\n# Record the current time as the build timestamp for a package\r\nupdate_cache() {\r\n    local pkg_name=\"$1\"\r\n"]
[174.468003, "o", "    init_cache\r\n    date +%s > \"$FORGE_CACHE_DIR/${pkg_name}.stamp\"\r\n}\r\n\r\n# Remove cache entry for a package\r\ninvalidate_cache() {\r\n    local pkg_name=\"$1\"\r\n    rm -f \"$FORGE_CACHE_DIR/${pkg_name}.stamp\"\r\n}\r\n\r\n# Wipe the entire cache directory\r\nclean_cache() {\r\n    rm -rf \"$FORGE_CACHE_DIR\"\r\n}"]
[174.468066, "o", "\r\n"]
[174.468404, "o", "===== lib/builder.sh =====\r\n"]
[174.470879, "o", "#!/bin/bash\r\n# Build executor for ForgeKit\r\n#\r\n# Builds packages by running their Makefile in the correct environment.\r\n\r\n"]
[174.47091, "o", "# Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.\r\n# BUG: Only sets up paths for *direct* dependencies.\r\n#      Transitive dependency include/lib paths are not added.\r\n#      Currently harmless because no header exposes transitive types,\r\n#      but will break as soon as a public header includes a transitive\r\n#      dependency header.\r\nsetup_build_env() {\r\n    local pkg_name=\"$1\"\r\n"]
[174.470942, "o", "    parse_manifest \"$pkg_name\"\r\n\r\n    local cflags=\"\"\r\n    local ldflags=\"\"\r\n    local libs=\"\"\r\n    local deps=\"${MANIFEST_deps:-}\"\r\n\r\n"]
[174.471128, "o", "    if [[ -n \"$deps\" ]]; then\r\n        local IFS=','\r\n        for dep in $deps; do\r\n            dep=\"${dep// /}\"\r\n            [[ -z \"$dep\" ]] && continue\r\n            local dep_dir\r\n"]
[174.471193, "o", "            dep_dir=$(get_package_dir \"$dep\")\r\n            cflags=\"$cflags -I${dep_dir}/src\"\r\n            ldflags=\"$ldflags -L${dep_dir}/build\"\r\n            # For services linking against libraries\r\n            parse_manifest \"$dep\"\r\n            if [[ \"${MANIFEST_type:-}\" == \"library\" ]]; then\r\n                local libname=\"${dep#lib}\"\r\n                libs=\"$libs ${dep_dir}/build/${dep}.a\"\r\n            fi\r\n        done\r\n    fi\r\n\r\n    export FORGE_CFLAGS=\"$cflags\"\r\n    export FORGE_LDFLAGS=\"$ldflags\"\r\n    export FORGE_LIBS=\"$libs\"\r\n}\r\n\r\n# Build a single package\r\nbuild_package() {\r\n    local pkg_name=\"$1\"\r\n    local pkg_dir\r\n    pkg_dir=$(get_package_dir \"$pkg_name\")\r\n\r\n    if [[ ! -d \"$pkg_dir\" ]]; then\r\n        log_error \"Package directory not found: $pkg_dir\"\r\n        return 1\r\n    fi\r\n\r\n    # Check cache\r\n    if is_cache_valid \"$pkg_name\" 2>/dev/null; then\r\n        log_info \"[$pkg_name] Up to date (cached)\"\r\n        return 0\r\n    fi\r\n\r\n    log_info \"[$pkg_name] Building...\"\r\n\r\n    # Parse manifest for bui"]
[174.471268, "o", "ld command\r\n    parse_manifest \"$pkg_name\"\r\n    local build_cmd=\"${MANIFEST_command:-make}\"\r\n\r\n    # Set up build environment\r\n    setup_build_env \"$pkg_name\"\r\n\r\n    # Execute build\r\n    if ! (cd \"$pkg_dir\" && eval \"$build_cmd\" 2>&1); then\r\n        log_error \"[$pkg_name] Build failed\"\r\n        return 1\r\n    fi\r\n\r\n    # Update cache\r\n    update_cache \"$pkg_name\"\r\n\r\n    log_info \"[$pkg_name] Build successful\"\r\n    return 0\r\n}\r\n\r\n# Run tests for a single package\r\ntest_package() {\r\n    local pkg_name=\"$1\"\r\n    local pkg_dir\r\n    pkg_dir=$(get_package_dir \"$pkg_name\")\r\n\r\n    parse_manifest \"$pkg_name\"\r\n    local test_cmd=\"${MANIFEST_test_command:-make test}\"\r\n\r\n"]
[174.471328, "o", "    setup_build_env \"$pkg_name\"\r\n\r\n    log_info \"[$pkg_name] Running tests...\"\r\n    if ! (cd \"$pkg_dir\" && eval \"$test_cmd\" 2>&1); then\r\n        log_error \"[$pkg_name] Tests failed\"\r\n        return 1\r\n    fi\r\n\r\n    log_info \"[$pkg_name] Tests passed\"\r\n    return 0\r\n}\r\n"]
[174.471709, "o", "===== lib/artifact.sh =====\r\n"]
[174.474292, "o", "#!/bin/bash\r\n# Artifact packaging for ForgeKit\r\n#\r\n# Packs a package's build output into a distributable tarball.\r\n\r\npack_artifact() {\r\n    local pkg_name=\"$1\"\r\n    local pkg_dir\r\n    pkg_dir=$(get_package_dir \"$pkg_name\")\r\n\r\n    parse_manifest \"$pkg_name\"\r\n    local version=\"${MANIFEST_version:-0.0.0}\"\r\n\r\n"]
[174.474428, "o", "    local build_dir=\"$pkg_dir/build\"\r\n    if [[ ! -d \"$build_dir\" ]]; then\r\n        log_error \"Build directory not found for $pkg_name. Run 'forge build' first.\"\r\n        return 1\r\n    fi\r\n\r\n    local artifact_dir=\"$FORGE_ROOT/artifacts\"\r\n    mkdir -p \"$artifact_dir\"\r\n\r\n    local artifact_name=\"${pkg_name}-${version}.tar.gz\"\r\n\r\n    # BUG: The tarball only contains build/ output.\r\n    # It should also include a deps.manifest file listing the direct\r\n    # dependencies and their versions so downstream deployment tooling\r\n    # can verify compatibility.  Currently there is no such metadata,\r\n    # making it impossible to check whether two artifacts were built\r\n    # against compatible dependency versions.\r\n\r\n    tar -czf \"$artifact_dir/$artifact_name\" \\\r\n        -C \"$pkg_dir\" \\\r\n        build/ 2>/dev/null\r\n\r\n    if [[ $? -ne 0 ]]; then\r\n        log_error \"Failed to create artifact for $pkg_name\"\r\n        return 1\r\n    fi\r\n\r\n    log_info \"Packed artifact: $artifact_name -> $artifact_dir/$artifact_name\"\r\n    echo "]
[174.474532, "o", "\"$artifact_dir/$artifact_name\"\r\n}\r\n"]
[174.474796, "o", "===== lib/configgen.sh =====\r\n"]
[174.477324, "o", "#!/bin/bash\r\n# Deployment config generator for ForgeKit\r\n#\r\n# Processes template files (*.tpl) by substituting ${VAR} references\r\n# with values from environment-specific config files and built-in vars.\r\n\r\n"]
[174.477415, "o", "generate_config() {\r\n    local env=\"$1\"\r\n    local template_dir=\"$FORGE_ROOT/templates\"\r\n\r\n    if [[ ! -d \"$template_dir\" ]]; then\r\n        log_error \"Templates directory not found: $template_dir\"\r\n        return 1\r\n    fi\r\n\r\n    # Build variable map -----------------------------------------------\r\n    declare -A config_vars\r\n    config_vars[ENV]=\"$env\"\r\n    config_vars[FORGE_ROOT]=\"$FORGE_ROOT\"\r\n    config_vars[TIMESTAMP]=\"$(date -u +%Y%m%dT%H%M%SZ)\"\r\n\r\n    # Load environment-specific config if it exists\r\n    local env_conf=\"$FORGE_ROOT/config/${env}.conf\"\r\n    if [[ -f \"$env_conf\" ]]; then\r\n        local key value\r\n"]
[174.477492, "o", "        while IFS='=' read -r key value; do\r\n            [[ \"$key\" =~ ^[[:space:]]*# ]] && continue\r\n            [[ -z \"$key\" ]] && continue\r\n            key=$(echo \"$key\" | tr -d '[:space:]')\r\n            value=$(echo \"$value\" | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')\r\n            config_vars[$key]=\"$value\"\r\n        done < \"$env_conf\"\r\n    fi\r\n\r\n    # Inject per-package version variables\r\n    for pkg_name in $(list_package_names); do\r\n        parse_manifest \"$pkg_name\"\r\n        local safe_name=\"${pkg_name//-/_}\"\r\n        config_vars[\"VERSION_${safe_name}\"]=\"${MANIFEST_version:-0.0.0}\"\r\n    done\r\n\r\n    # Process each template file ---------------------------------------\r\n"]
[174.477588, "o", "    mkdir -p \"$FORGE_ROOT/generated\"\r\n\r\n    for tpl in \"$template_dir\"/*.tpl; do\r\n        [[ -f \"$tpl\" ]] || continue\r\n        local outname\r\n        outname=$(basename \"$tpl\" .tpl)\r\n        local outfile=\"$FORGE_ROOT/generated/${outname}\"\r\n\r\n        local content\r\n        content=$(cat \"$tpl\")\r\n\r\n        # Simple single-pass variable substitution.\r\n        #\r\n        # BUG: Only resolves flat ${VAR} references.  Nested patterns\r\n        # such as ${REGION_${ENV}} are not handled — the inner ${ENV}\r\n        # is never expanded first, so the entire token is left as-is.\r\n"]
[174.477654, "o", "        # A correct implementation would iteratively (or recursively)\r\n        # resolve inner references before resolving the outer one.\r\n        for var_name in \"${!config_vars[@]}\"; do\r\n            content=\"${content//\\$\\{${var_name}\\}/${config_vars[$var_name]}}\"\r\n        done\r\n\r\n        echo \"$content\" > \"$outfile\"\r\n        log_info \"Generated config: $outfile\"\r\n    done\r\n}\r\n"]
[174.478032, "o", "===== lib/reporter.sh =====\r\n"]
[174.481375, "o", "#!/bin/bash\r\n# Build report generator for ForgeKit\r\n\r\ngenerate_report() {\r\n    echo \"=========================================\"\r\n    echo \"  ForgeKit Build Report\"\r\n"]
[174.48146, "o", "    echo \"=========================================\"\r\n    echo \"  Date: $(date '+%Y-%m-%d %H:%M:%S')\"\r\n    echo \"=========================================\"\r\n    echo \"\"\r\n\r\n    # BUG: The \"%-12s\" format specifier silently truncates any package\r\n    # name longer than 12 characters.  For example \"svc-scheduler\"\r\n    # (13 chars) is printed as \"svc-schedule\" in the report.  Package\r\n    # names should be displayed in full with proper column alignment.\r\n\r\n    printf \"%-12s  %-10s  %-10s  %-8s  %s\\n\" \\\r\n        \"PACKAGE\" \"VERSION\" \"TYPE\" \"STATUS\" \"CACHED\"\r\n    printf \"%-12s  %-10s  %-10s  %-8s  %s\\n\" \\\r\n        \"-------\" \"-------\" \"----\" \"------\" \"------\"\r\n\r\n"]
[174.481524, "o", "    for pkg_name in $(list_package_names); do\r\n        parse_manifest \"$pkg_name\"\r\n        local version=\"${MANIFEST_version:-?}\"\r\n        local type=\"${MANIFEST_type:-?}\"\r\n        local pkg_dir\r\n        pkg_dir=$(get_package_dir \"$pkg_name\")\r\n"]
[174.481603, "o", "\r\n        local status=\"pending\"\r\n        if [[ -d \"$pkg_dir/build\" ]]; then\r\n            status=\"built\"\r\n        fi\r\n\r\n        local cached=\"no\"\r\n        if is_cache_valid \"$pkg_name\" 2>/dev/null; then\r\n            cached=\"yes\"\r\n        fi\r\n\r\n        printf \"%-12s  %-10s  %-10s  %-8s  %s\\n\" \\\r\n            \"$pkg_name\" \"$version\" \"$type\" \"$status\" \"$cached\"\r\n    done\r\n\r\n    echo \"\"\r\n    echo \"Total packages: $(list_package_names | wc -w)\"\r\n}\r\n"]
[174.482162, "o", "\u001b[?2004h"]
[174.482219, "o", "root@n30009:/app# "]
[174.730862, "i", "echo \"===== tests =====\"; sed -n '1,260p' tests/run_tests.sh\n"]
[174.731306, "o", "echo \"===== tests =====\"; sed -n '1,260p' tests/run_tests.sh\r\n"]
[174.731413, "o", "\u001b[?2004l\r===== tests =====\r\n"]
[174.73416, "o", "#!/bin/bash\r\n# ForgeKit Internal Test Suite\r\n#\r\n# Tests for the forge build automation system itself.\r\n# Run with: bash tests/run_tests.sh\r\n\r\n"]
[174.734248, "o", "FORGE_ROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\r\nexport FORGE_ROOT\r\n\r\nsource \"$FORGE_ROOT/lib/common.sh\"\r\nsource \"$FORGE_ROOT/lib/manifest.sh\"\r\nsource \"$FORGE_ROOT/lib/depgraph.sh\"\r\nsource \"$FORGE_ROOT/lib/builder.sh\"\r\nsource \"$FORGE_ROOT/lib/cache.sh\"\r\nsource \"$FORGE_ROOT/lib/artifact.sh\"\r\nsource \"$FORGE_ROOT/lib/reporter.sh\"\r\nsource \"$FORGE_ROOT/lib/configgen.sh\"\r\n\r\nTOTAL=0\r\nPASSED=0\r\nFAILED=0\r\n\r\n"]
[174.734317, "o", "assert_eq() {\r\n    local desc=\"$1\" expected=\"$2\" actual=\"$3\"\r\n    ((TOTAL++))\r\n    if [[ \"$expected\" == \"$actual\" ]]; then\r\n        echo \"  PASS: $desc\"\r\n        ((PASSED++))\r\n    else\r\n"]
[174.734392, "o", "        echo \"  FAIL: $desc\"\r\n        echo \"    expected: '$expected'\"\r\n        echo \"    actual:   '$actual'\"\r\n        ((FAILED++))\r\n    fi\r\n}\r\n\r\nassert_contains() {\r\n    local desc=\"$1\" haystack=\"$2\" needle=\"$3\"\r\n    ((TOTAL++))\r\n    if [[ \"$haystack\" == *\"$needle\"* ]]; then\r\n        echo \"  PASS: $desc\"\r\n        ((PASSED++))\r\n    else\r\n        echo \"  FAIL: $desc\"\r\n        echo \"    expected to contain: '$needle'\"\r\n        echo \"    in: '$haystack'\"\r\n        ((FAILED++))\r\n    fi\r\n}\r\n\r\n"]
[174.734462, "o", "assert_not_contains() {\r\n    local desc=\"$1\" haystack=\"$2\" needle=\"$3\"\r\n    ((TOTAL++))\r\n    if [[ \"$haystack\" != *\"$needle\"* ]]; then\r\n        echo \"  PASS: $desc\"\r\n        ((PASSED++))\r\n    else\r\n        echo \"  FAIL: $desc\"\r\n        echo \"    expected NOT to contain: '$needle'\"\r\n        echo \"    in: '$haystack'\"\r\n        ((FAILED++))\r\n    fi\r\n}\r\n\r\nassert_exit_zero() {\r\n"]
[174.734522, "o", "    local desc=\"$1\"\r\n    shift\r\n    ((TOTAL++))\r\n    if \"$@\" > /dev/null 2>&1; then\r\n        echo \"  PASS: $desc\"\r\n        ((PASSED++))\r\n    else\r\n        echo \"  FAIL: $desc (exit code: $?)\"\r\n        ((FAILED++))\r\n    fi\r\n}\r\n\r\nassert_exit_nonzero() {\r\n    local desc=\"$1\"\r\n    shift\r\n"]
[174.734619, "o", "    ((TOTAL++))\r\n    if \"$@\" > /dev/null 2>&1; then\r\n        echo \"  FAIL: $desc (expected failure but got success)\"\r\n        ((FAILED++))\r\n    else\r\n        echo \"  PASS: $desc\"\r\n        ((PASSED++))\r\n    fi\r\n}\r\n\r\n# ==================================================================\r\necho \"\"\r\necho \"=== Manifest Parser Tests ===\"\r\n\r\nparse_manifest \"libbase\"\r\nassert_eq \"libbase name\" \"libbase\" \"${MANIFEST_name:-}\"\r\n"]
[174.734685, "o", "assert_eq \"libbase version\" \"1.0.0\" \"${MANIFEST_version:-}\"\r\nassert_eq \"libbase type\" \"library\" \"${MANIFEST_type:-}\"\r\nassert_eq \"libbase has no deps\" \"\" \"${MANIFEST_deps:-}\"\r\n\r\nparse_manifest \"libcrypto\"\r\nassert_eq \"libcrypto deps\" \"libbase\" \"${MANIFEST_deps:-}\"\r\n\r\nparse_manifest \"svc-auth\"\r\nassert_eq \"svc-auth type\" \"service\" \"${MANIFEST_type:-}\"\r\nassert_eq \"svc-auth deps\" \"libcrypto,libstore\" \"${MANIFEST_deps:-}\"\r\n\r\n# TODO: Test manifest with multi-line continuation values (backslash)\r\n# TODO: Test error handling for missing manifest file\r\n# TODO: Test manifest with inline comments after values"]
[174.73475, "o", "\r\n\r\n# ==================================================================\r\necho \"\"\r\necho \"=== Dependency Graph Tests ===\"\r\n\r\norder=$(resolve_build_order)\r\npkg_count=$(echo \"$order\" | wc -w)\r\nassert_eq \"build order has 8 packages\" \"8\" \"$pkg_count\"\r\n\r\n# libbase must come before everything that depends on it\r\nassert_contains \"order contains libbase\" \"$order\" \"libbase\"\r\nassert_contains \"order contains svc-scheduler\" \"$order\" \"svc-scheduler\"\r\n\r\n# Verify libbase precedes libcrypto in the output\r\nlibbase_pos=0; libcrypto_pos=0; i=0\r\n"]
[174.734808, "o", "for pkg in $order; do\r\n    ((i++))\r\n    [[ \"$pkg\" == \"libbase\" ]] && libbase_pos=$i\r\n    [[ \"$pkg\" == \"libcrypto\" ]] && libcrypto_pos=$i\r\ndone\r\nassert_eq \"libbase before libcrypto\" \"1\" \"$(( libbase_pos < libcrypto_pos ? 1 : 0 ))\"\r\n\r\n# resolve_deps_for\r\ndeps_for_auth=$(resolve_deps_for \"svc-auth\")\r\nassert_contains \"svc-auth deps include libcrypto\" \"$deps_for_auth\" \"libcrypto\"\r\nassert_contains \"svc-auth deps include itself\" \"$deps_for_auth\" \"svc-auth\"\r\n\r\n"]
[174.73488, "o", "# TODO: Test circular dependency detection\r\n# TODO: Test resolve_deps_for with package that has no dependencies\r\n# TODO: Test handling of unknown/missing dependency names in manifest\r\n\r\n# ==================================================================\r\necho \"\"\r\necho \"=== Cache Tests ===\"\r\n\r\nclean_cache\r\nassert_exit_nonzero \"cache invalid for unbuilt pkg\" is_cache_valid \"libbase\"\r\n\r\nupdate_cache \"libbase\"\r\nassert_exit_zero \"cache valid after update\" is_cache_valid \"libbase\"\r\n\r\n# TODO: Test transitive cache invalidation (dep rebuilt -> consumer invalidated)\r\n"]
[174.73498, "o", "# TODO: Test cache invalidation after source file modification\r\n# TODO: Test clean_cache removes all stamps\r\n\r\n# ==================================================================\r\necho \"\"\r\necho \"=== Reporter Tests ===\"\r\n\r\nreport_out=$(generate_report)\r\nassert_contains \"report has header\" \"$report_out\" \"ForgeKit Build Report\"\r\nassert_contains \"report lists libbase\" \"$report_out\" \"libbase\"\r\n\r\n# TODO: Test that long package names are displayed without truncation\r\n# TODO: Test report shows correct build status\r\n\r\n# ==================================================================\r\necho \"\"\r\necho \"=== Config Generator Tests ===\"\r\n\r\n# Simple substitution\r\ngenerate_config \"staging\" > /dev/null 2>&1\r\nif [[ -f \"$FORGE_ROOT/generated/deploy.yaml\" ]]; then\r\n    deploy_out=$(cat \"$FORGE_ROOT/generated/deploy.yaml\")\r\n"]
[174.735049, "o", "    assert_contains \"deploy config has env\" \"$deploy_out\" \"staging\"\r\n    assert_contains \"deploy config has host\" \"$deploy_out\" \"staging.internal\"\r\nelse\r\n    echo \"  FAIL: deploy.yaml not generated\"\r\n    ((TOTAL++)); ((FAILED++))\r\nfi\r\n\r\n# TODO: Test nested variable substitution (e.g. ${REGION_${ENV}})\r\n# TODO: Test generation for production environment\r\n# TODO: Test with missing environment config file\r\n\r\n# ==================================================================\r\necho \"\"\r\n"]
[174.735115, "o", "echo \"=== Artifact Tests ===\"\r\n\r\n# Need to build first\r\n(cd \"$FORGE_ROOT/packages/libbase\" && make clean > /dev/null 2>&1 && make > /dev/null 2>&1)\r\nresult=$(pack_artifact \"libbase\" 2>/dev/null)\r\nassert_contains \"artifact path returned\" \"$result\" \"libbase-1.0.0.tar.gz\"\r\n\r\n# TODO: Test artifact includes dependency metadata (deps.manifest)\r\n# TODO: Test artifact for package with no build output\r\n# TODO: Test artifact versioning matches manifest\r\n\r\n# Clean up\r\nrm -rf \"$FORGE_ROOT/artifacts\" \"$FORGE_ROOT/generated\"\r\nrm -rf \"$FORGE_ROOT/packages/libbase/build\"\r\n"]
[174.735172, "o", "clean_cache\r\n\r\n# ==================================================================\r\necho \"\"\r\necho \"=== Summary ===\"\r\necho \"Total: $TOTAL | Passed: $PASSED | Failed: $FAILED\"\r\nif [[ $FAILED -gt 0 ]]; then\r\n    exit 1\r\nfi\r\nexit 0\r\n"]
[174.735658, "o", "\u001b[?2004h"]
[174.735724, "o", "root@n30009:/app# "]
[180.81618, "i", "nl -ba lib/manifest.sh | sed -n '1,220p'\n"]
[180.816605, "o", "nl -ba lib/manifest.sh | sed -n '1,220p'"]
[180.816703, "o", "\r\n\u001b[?2004l\r"]
[180.820485, "o", "     1\t#!/bin/bash\r\n     2\t# Manifest parser for .forge package files\r\n     3\t#\r\n     4\t# Format:\r\n     5\t#   [section]\r\n     6\t#   key = value\r\n     7\t#   # comments\r\n     8\t"]
[180.820583, "o", "#   key = long value \\\r\n     9\t#         continued on next line\r\n    10\t#\r\n    11\t# All parsed values are exported as MANIFEST_<key>=<value>\r\n    12\t\r\n    13\tparse_manifest() {\r\n    14\t    local pkg_name=\"$1\"\r\n    15\t    local manifest_file\r\n    16\t    manifest_file=$(get_package_manifest \"$pkg_name\")\r\n    17\t\r\n    18\t    if [[ ! -f \"$manifest_file\" ]]; then\r\n"]
[180.820678, "o", "    19\t        log_error \"Manifest not found: $manifest_file\"\r\n    20\t        return 1\r\n    21\t    fi\r\n    22\t\r\n    23\t    # Clear previous manifest data\r\n    24\t    local var\r\n    25\t    for var in $(compgen -v MANIFEST_); do\r\n    26\t        unset \"$var\"\r\n    27\t    done\r\n    28\t\r\n    29\t    local current_section=\"\"\r\n    30\t    local line key value\r\n    31\t\r\n"]
[180.820743, "o", "    32\t    while IFS= read -r line || [[ -n \"$line\" ]]; do\r\n    33\t        # Skip empty lines and comments\r\n    34\t        [[ \"$line\" =~ ^[[:space:]]*$ ]] && continue\r\n    35\t        [[ \"$line\" =~ ^[[:space:]]*# ]] && continue\r\n    36\t\r\n    37\t        # Section header\r\n    38\t        if [[ \"$line\" =~ ^\\[([a-zA-Z_][a-zA-Z0-9_]*)\\] ]]; then\r\n    39\t            current_section=\"${BASH_REMATCH[1]}\"\r\n    40\t            continue\r\n    41"]
[180.820808, "o", "\t        fi\r\n    42\t\r\n    43\t        # Key = value pair\r\n    44\t        if [[ \"$line\" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then\r\n    45\t            key=\"${BASH_REMATCH[1]}\"\r\n    46\t            value=\"${BASH_REMATCH[2]}\"\r\n    47\t\r\n    48\t            # Trim trailing whitespace from value\r\n    49\t            value=\"${value%\"${value##*[![:space:]]}\"}\"\r\n    50\t\r\n"]
[180.820869, "o", "    51\t            # BUG: Does not handle backslash line continuation.\r\n    52\t            # If the value ends with '\\', the next line(s) should be\r\n    53\t            # appended (minus the backslash). Currently, the trailing\r\n    54\t            # backslash is kept and continuation lines are ignored.\r\n    55\t\r\n    56\t            export \"MANIFEST_${key}=${value}\"\r\n    57\t        fi\r\n    58\t    done < \"$manifest_file\"\r\n"]
[180.820933, "o", "    59\t}\r\n    60\t\r\n    61\t# Convenience: parse and return a single value\r\n    62\tget_manifest_value() {\r\n    63\t    local pkg_name=\"$1\"\r\n    64\t    local key=\"$2\"\r\n    65\t    parse_manifest \"$pkg_name\"\r\n    66\t    local var=\"MANIFEST_${key}\"\r\n    67\t    echo \"${!var:-}\"\r\n    68"]
[180.82099, "o", "\t}\r\n"]
[180.821483, "o", "\u001b[?2004h"]
[180.821539, "o", "root@n30009:/app# "]
[181.067147, "i", "nl -ba lib/common.sh | sed -n '1,220p'\n"]
[181.067516, "o", "nl -ba lib/common.sh | sed -n '1,220p'\r\n\u001b[?2004l\r"]
[181.071676, "o", "     1\t#!/bin/bash\r\n     2\t# Common utilities for ForgeKit\r\n     3\t\r\n"]
[181.071708, "o", "     4\tlog_info() {\r\n     5\t    echo \"[FORGE INFO] $*\"\r\n     6\t}\r\n     7\t\r\n"]
[181.071875, "o", "     8\tlog_warn() {\r\n     9\t    echo \"[FORGE WARN] $*\" >&2\r\n    10\t}\r\n    11\t\r\n    12\tlog_error() {\r\n    13\t    echo \"[FORGE ERROR] $*\" >&2\r\n    14\t}\r\n    15\t\r\n    16\t# Get the absolute path to a package directory\r\n    17\tget_package_dir() {\r\n    18\t    local name=\"$1\"\r\n    19\t    echo \"$FORGE_ROOT/packages/$name\"\r\n    20\t}\r\n    21\t\r\n    22\t# Get the absolute path to a package manifest\r\n    23\tget_package_manifest() {\r\n    24\t    local name=\"$1\"\r\n    25\t    echo \"$FORGE_ROOT/packages/$name/package.forge\""]
[181.071965, "o", "\r\n    26\t}\r\n    27\t\r\n    28\t# List all package names (directories under packages/ with a manifest)\r\n    29\tlist_package_names() {\r\n    30\t    local pkg_dir\r\n    31\t    for pkg_dir in \"$FORGE_ROOT/packages\"/*/; do\r\n    32\t        if [[ -f \"$pkg_dir/package.forge\" ]]; then\r\n    33\t            basename \"$pkg_dir\"\r\n    34\t        fi\r\n"]
[181.072042, "o", "    35\t    done\r\n    36\t}\r\n    37\t\r\n    38\t# Display formatted package listing\r\n    39\tlist_packages() {\r\n    40\t    local name version type deps\r\n    41\t    printf \"%-25s %-10s %-10s %s\\n\" \"NAME\" \"VERSION\" \"TYPE\" \"DEPENDENCIES\"\r\n    42\t    printf \"%-25s %-10s %-10s %s\\n\" \"----\" \"-------\" \"----\" \"------------\"\r\n"]
[181.072106, "o", "    43\t    for pkg_name in $(list_package_names); do\r\n    44\t        parse_manifest \"$pkg_name\"\r\n    45\t        name=\"${MANIFEST_name:-$pkg_name}\"\r\n    46\t        version=\"${MANIFEST_version:-unknown}\"\r\n    47\t        type=\"${MANIFEST_type:-unknown}\"\r\n    48\t        deps=\"${MANIFEST_deps:-none}\"\r\n"]
[181.072171, "o", "    49\t        printf \"%-25s %-10s %-10s %s\\n\" \"$name\" \"$version\" \"$type\" \"$deps\"\r\n    50\t    done\r\n    51\t}\r\n    52\t\r\n    53\t# Clean build artifacts for a package\r\n    54\tclean_package() {\r\n    55\t    local name=\"$1\"\r\n"]
[181.07223, "o", "    56\t    local pkg_dir\r\n    57\t    pkg_dir=$(get_package_dir \"$name\")\r\n    58\t    if [[ -d \"$pkg_dir/build\" ]]; then\r\n    59\t        rm -rf \"$pkg_dir/build\"\r\n    60\t        log_info \"Cleaned $name\"\r\n    61\t    fi\r\n"]
[181.072293, "o", "    62\t    find \"$pkg_dir/src\" -name \"*.o\" -delete 2>/dev/null || true\r\n    63\t}\r\n"]
[181.072907, "o", "\u001b[?2004h"]
[181.072971, "o", "root@n30009:/app# "]
[181.343219, "i", "nl -ba lib/depgraph.sh | sed -n '1,260p'\n"]
[181.343537, "o", "nl -ba lib/depgraph.sh | sed -n '1,260p'\r\n"]
[181.343646, "o", "\u001b[?2004l\r"]
[181.347037, "o", "     1\t#!/bin/bash\r\n     2\t# Dependency graph resolution for ForgeKit\r\n"]
[181.347054, "o", "     3\t#\r\n     4\t# Provides topological-sort-based build ordering and\r\n     5\t# dependency tree queries.\r\n"]
[181.347154, "o", "     6\t\r\n     7\t# Build an associative array mapping package -> comma-separated deps\r\n     8\tbuild_dep_map() {\r\n     9\t    declare -gA DEP_MAP\r\n    10\t    # Reset\r\n    11\t    for k in \"${!DEP_MAP[@]}\"; do unset \"DEP_MAP[$k]\"; done\r\n    12\t\r\n    13\t    local pkg_name deps_str\r\n    14\t    for pkg_name in $(list_package_names); do\r\n    15\t        parse_manifest \"$pkg_name\"\r\n    16\t        deps_str=\"${MANIFEST_deps:-}\"\r\n    17\t        DEP_MAP[$pkg_name]=\"$deps_str\"\r\n    18\t    done\r\n    19\t}\r\n    20\t\r\n"]
[181.347212, "o", "    21\t# -------------------------------------------------------------------\r\n    22\t# Topological sort via DFS\r\n    23"]
[181.347268, "o", "\t#\r\n    24\t# BUG: The visited flag is only set AFTER recursing into children.\r\n    25\t#      If there is a cycle (A -> B -> A), the function will recurse\r\n    26\t#      forever because neither A nor B is marked visited when the\r\n    27\t#      cycle is re-entered.  There is no \"currently visiting\" state\r\n    28\t#      that would allow the algorithm to detect the back-edge.\r\n    29\t# -------------------------------------------------------------------\r\n    30\tresolve_build_order() {\r\n    31\t    build_dep_map\r\n"]
[181.34732, "o", "    32\t\r\n    33\t    declare -A _visited\r\n    34\t    local _order=\"\"\r\n    35\t\r\n    36\t    _topo_visit() {\r\n    37\t        local node=\"$1\"\r\n    38\t\r\n    39\t        # Already finished\r\n    40\t        [[ \"${_visited[$node]:-}\" == \"done\" ]] && return 0\r\n"]
[181.347369, "o", "    41\t\r\n    42\t        # Recurse into dependencies first\r\n    43\t        local deps=\"${DEP_MAP[$node]:-}\"\r\n    44\t        if [[ -n \"$deps\" ]]; then\r\n    45\t            local IFS=','\r\n    46\t            for dep in $deps; do\r\n    47\t                dep=\"${dep// /}\"\r\n    48\t                [[ -z \"$dep\" ]] && continue"]
[181.347433, "o", "\r\n    49\t                _topo_visit \"$dep\"\r\n    50\t            done\r\n    51\t        fi\r\n    52\t\r\n    53\t        _visited[$node]=\"done\"\r\n    54\t        _order=\"$_order $node\"\r\n"]
[181.347448, "o", "    55\t    }\r\n    56\t\r\n    57\t    for pkg in $(list_package_names); do\r\n    58\t        _topo_visit \"$pkg\"\r\n    59\t    done\r\n    60\t\r\n    61\t    echo \"$_order\"\r\n    62\t}\r\n    63\t\r\n    64\t# Resolve the build chain for a single target (inclusive)\r\n    65\tresolve_deps_for() {\r\n"]
[181.347517, "o", "    66\t    local target=\"$1\"\r\n"]
[181.347601, "o", "    67\t    build_dep_map\r\n    68\t\r\n    69\t    declare -A _visited\r\n    70\t    local _order=\"\"\r\n    71\t\r\n    72\t    _dep_visit() {\r\n    73\t        local node=\"$1\"\r\n    74\t        [[ \"${_visited[$node]:-}\" == \"done\" ]] && return 0\r\n    75\t\r\n    76\t        local deps=\"${DEP_MAP[$node]:-}\"\r\n    77\t        if [[ -n \"$deps\" ]]; then\r\n    78\t            local IFS=','\r\n"]
[181.347618, "o", "    79\t            for dep in $deps; do\r\n    80\t                dep=\"${dep// /}\"\r\n    81\t                [[ -z \"$dep\" ]] && continue\r\n    82\t                _dep_visit \"$dep\"\r\n    83\t            done\r\n    84\t        fi\r\n    85\t\r\n    86\t        _visited[$node]=\"done\"\r\n    87\t        _order=\"$_order $node\"\r\n    88\t    }\r\n    89\t\r\n    90\t    _dep_visit \"$target\""]
[181.34763, "o", "\r\n"]
[181.347717, "o", "    91\t    echo \"$_order\"\r\n    92\t}\r\n    93\t\r\n    94\t# Pretty-print the dependency tree (recursive, indented)\r\n    95\tshow_dep_tree() {\r\n    96\t    local name=\"$1\"\r\n    97\t    local indent=\"${2:-0}\"\r\n    98\t\r\n    99\t    # Ensure the dep map exists\r\n   100\t    if [[ -z \"${DEP_MAP[*]+_}\" ]]; then\r\n   101\t        build_dep_map\r\n   102\t    fi\r\n   103\t\r\n   104\t    local prefix=\"\"\r\n"]
[181.34773, "o", "   105\t    for ((i = 0; i < indent; i++)); do prefix=\"$prefix  \"; done\r\n   106\t\r\n   107"]
[181.347796, "o", "\t    echo \"${prefix}${name}\"\r\n   108\t\r\n   109\t    local deps=\"${DEP_MAP[$name]:-}\"\r\n   110\t    if [[ -n \"$deps\" ]]; then\r\n   111\t        local IFS=','\r\n   112\t        for dep in $deps; do\r\n   113\t            dep=\"${dep// /}\"\r\n   114\t            [[ -z \"$dep\" ]] && continue\r\n   115\t            show_dep_tree \"$dep\" $((indent + 1))\r\n   116\t        done\r\n   117\t    fi\r\n"]
[181.347849, "o", "   118\t}\r\n   119\t\r\n   120\t# Return all transitive dependencies (not including the package itself)\r\n   121\tget_all_deps() {\r\n   122\t    local name=\"$1\"\r\n   123\t    if [[ -z \"${DEP_MAP[*]+_}\" ]]; then\r\n   124\t        build_dep_map\r\n   125\t    fi\r\n   126\t\r\n"]
[181.347862, "o", "   127\t    declare -A _seen\r\n"]
[181.347936, "o", "   128\t    local _result=\"\"\r\n   129\t\r\n   130\t    _collect_deps() {\r\n   131\t        local node=\"$1\"\r\n"]
[181.347976, "o", "   132\t        local deps=\"${DEP_MAP[$node]:-}\"\r\n   133\t        if [[ -n \"$deps\" ]]; then\r\n   134\t            local IFS=','\r\n   135\t            for dep in $deps; do\r\n   136\t                dep=\"${dep// /}\"\r\n   137\t                [[ -z \"$dep\" ]] && continue\r\n   138\t                if [[ -z \"${_seen[$dep]:-}\" ]]; then\r\n   139\t                    _seen[$dep]=1\r\n   140\t                    _result=\"$_result $dep\"\r\n   141\t                    _collect_deps \"$dep\"\r\n   142\t                fi\r\n"]
[181.348024, "o", "   143\t            done\r\n   144\t        fi\r\n   145\t    }\r\n   146\t\r\n   147\t    _collect_deps \"$name\"\r\n   148\t    echo \"$_result\"\r\n"]
[181.348088, "o", "   149\t}\r\n"]
[181.348517, "o", "\u001b[?2004h"]
[181.348587, "o", "root@n30009:/app# "]
[181.612622, "i", "nl -ba lib/cache.sh | sed -n '1,220p'\n"]
[181.612991, "o", "nl -ba lib/cache.sh | sed -n '1,220p'\r\n\u001b[?2004l\r"]
[181.616784, "o", "     1\t#!/bin/bash\r\n     2\t# Build cache management for ForgeKit\r\n     3\t#\r\n     4\t# Uses timestamp-based caching: each package records a \"last built\"\r\n     5\t# timestamp; a rebuild is triggered when source files are newer.\r\n     6\t\r\n     7\t"]
[181.616883, "o", "FORGE_CACHE_DIR=\"${FORGE_ROOT}/.forge_cache\"\r\n     8\t\r\n     9\tinit_cache() {\r\n    10\t    mkdir -p \"$FORGE_CACHE_DIR\"\r\n    11\t}\r\n    12\t\r\n    13\t# Newest mtime among all files under a package's src/ directory\r\n    14\tget_src_mtime() {\r\n    15\t    local pkg_name=\"$1\"\r\n    16\t    local pkg_dir\r\n    17\t    pkg_dir=$(get_package_dir \"$pkg_name\")\r\n    18\t\r\n    19\t    local latest=0\r\n    20\t    local mtime\r\n    21\t"]
[181.616953, "o", "    while IFS= read -r -d '' file; do\r\n    22\t        mtime=$(stat -c %Y \"$file\" 2>/dev/null || echo 0)\r\n    23\t        if (( mtime > latest )); then\r\n    24\t            latest=$mtime\r\n    25\t        fi\r\n    26\t"]
[181.617035, "o", "    done < <(find \"$pkg_dir/src\" -type f -print0 2>/dev/null)\r\n    27\t\r\n    28\t    # Also check Makefile\r\n    29\t    if [[ -f \"$pkg_dir/Makefile\" ]]; then\r\n    30\t        mtime=$(stat -c %Y \"$pkg_dir/Makefile\" 2>/dev/null || echo 0)\r\n    31\t        if (( mtime > latest )); then\r\n    32\t            latest=$mtime\r\n    33\t        fi\r\n    34\t    fi\r\n    35\t\r\n    36\t    echo \"$latest\"\r\n    37\t}\r\n    38\t\r\n    39\t# Check whether the cached build is still valid.\r\n    40\t#\r\n    41\t# BUG: Only compares the package's own source timestamps against its\r\n    42"]
[181.617123, "o", "\t#      cached build timestamp.  It does NOT check whether any of the\r\n    43\t#      package's transitive dependencies have been rebuilt more\r\n    44\t#      recently.  This means that modifying libbase and rebuilding it\r\n    45\t#      will NOT trigger a rebuild of libcrypto (which depends on\r\n    46\t#      libbase) during an incremental build.\r\n    47\tis_cache_valid() {\r\n    48\t    local pkg_name=\"$1\"\r\n    49\t    init_cache\r\n    50\t    local cache_file=\"$FORGE_CACHE_DIR/${pkg_name}.stamp\"\r\n    51\t\r\n    52\t    if [[ ! -f \"$cache_file\" ]]; then\r\n    53\t        return 1  # No cache -> rebuild\r\n    54\t    fi\r\n    55\t\r\n"]
[181.617184, "o", "    56\t    local cached_time\r\n    57\t    cached_time=$(cat \"$cache_file\")\r\n    58\t\r\n    59\t    local src_mtime\r\n    60\t    src_mtime=$(get_src_mtime \"$pkg_name\")\r\n    61\t\r\n    62\t    if (( src_mtime > cached_time )); then\r\n    63\t        return 1  # Source newer than cache -> rebuild\r\n    64\t    fi\r\n"]
[181.617244, "o", "    65\t\r\n    66\t    return 0  # Cache is valid\r\n    67\t}\r\n    68\t\r\n    69\t# Record the current time as the build timestamp for a package\r\n    70\tupdate_cache() {\r\n    71\t    local pkg_name=\"$1\"\r\n    72\t    init_cache\r\n    73"]
[181.617304, "o", "\t    date +%s > \"$FORGE_CACHE_DIR/${pkg_name}.stamp\"\r\n    74\t}\r\n    75\t\r\n    76\t# Remove cache entry for a package\r\n    77\tinvalidate_cache() {\r\n    78\t    local pkg_name=\"$1\"\r\n    79\t    rm -f \"$FORGE_CACHE_DIR/${pkg_name}.stamp\"\r\n    80\t}\r\n    81\t\r\n"]
[181.617372, "o", "    82\t# Wipe the entire cache directory\r\n    83\tclean_cache() {\r\n    84\t    rm -rf \"$FORGE_CACHE_DIR\"\r\n    85\t}\r\n"]
[181.617886, "o", "\u001b[?2004h"]
[181.617964, "o", "root@n30009:/app# "]
