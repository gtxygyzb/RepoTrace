[1403.298064, "o", "rm -rf \"$FORGE_ROOT/artifacts\" \"$FORGE_ROOT/generated\" \"$FORGE_ROOT/.forge_cache\"\r\n\u001b[?2004l\r"]
[1403.300432, "o", "\u001b[?2004h"]
[1403.300492, "o", "root@n30009:/app# "]
[1403.300844, "o", "for pkg in $(list_package_names); do clean_package \"$pkg\"; done\r\n\u001b[?2004l\r"]
[1403.301783, "o", "bash: list_package_names: command not found\r\n"]
[1403.302227, "o", "\u001b[?2004h"]
[1403.302284, "o", "root@n30009:/app# \r\n\u001b[?2004l\r"]
[1403.302341, "o", "\u001b[?2004hroot@n30009:/app# "]
[1403.302506, "o", "if [[ $FAILED -gt 0 ]]; then\r\n\u001b[?2004l\r"]
[1403.30257, "o", "\u001b[?2004h"]
[1403.302627, "o", "> "]
[1403.302683, "o", "    exit 1\r\n\u001b[?2004l\r"]
[1403.302739, "o", "\u001b[?2004h> "]
[1403.302798, "o", "fi\r\n\u001b[?2004l\r"]
[1403.302853, "o", "\u001b[?2004hroot@n30009:/app# "]
[1403.302913, "o", "exit 0\r\n\u001b[?2004l\r"]
[1403.302968, "o", "exit\r\n"]
