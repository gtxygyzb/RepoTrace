[263.201009, "o", "   121\tassert_contains \"order contains libbase\" \"$order\" \"libbase\"\r\n   122\tassert_contains \"order contains svc-scheduler\" \"$order\" \"svc-scheduler\"\r\n   123\t\r\n"]
[263.20117, "o", "   124\t# Verify libbase precedes libcrypto in the output\r\n   125\tlibbase_pos=0; libcrypto_pos=0; i=0\r\n   126\tfor pkg in $order; do\r\n   127\t    ((i++))\r\n   128\t    [[ \"$pkg\" == \"libbase\" ]] && libbase_pos=$i\r\n   129\t    [[ \"$pkg\" == \"libcrypto\" ]] && libcrypto_pos=$i\r\n   130\tdone\r\n   131\tassert_eq \"libbase before libcrypto\" \"1\" \"$(( libbase_pos < libcrypto_pos ? 1 : 0 ))\"\r\n   132\t\r\n   133\t# resolve_deps_for\r\n   134\tdeps_for_auth=$(resolve_deps_for \"svc-auth\")\r\n   135\tassert_contains \"svc-auth deps include libcrypto\" \"$deps_for_auth\" \"libcrypto\"\r\n   136\tassert_contains \"svc-auth deps include itself\" \"$deps_for_auth\" \"svc-auth\"\r\n   137\t\r\n   138\t# TODO: Test circular dependency detection\r\n   139\t# TODO: Test resolve_deps_for with package that has no dependencies\r\n   140\t# TODO: Test handling of unknown/missing dependency names in manifest\r\n   141\t\r\n   142\t# ==================================================================\r\n"]
[263.201303, "o", "   143\techo \"\"\r\n   144\techo \"=== Cache Tests ===\"\r\n   145\t\r\n   146\tclean_cache\r\n   147\tassert_exit_nonzero \"cache invalid for unbuilt pkg\" is_cache_valid \"libbase\"\r\n   148\t\r\n   149\tupdate_cache \"libbase\"\r\n   150\tassert_exit_zero \"cache valid after update\" is_cache_valid \"libbase\"\r\n"]
[263.201416, "o", "   151\t\r\n   152\t# TODO: Test transitive cache invalidation (dep rebuilt -> consumer invalidated)\r\n   153\t# TODO: Test cache invalidation after source file modification\r\n   154\t# TODO: Test clean_cache removes all stamps\r\n   155\t\r\n   156\t# ==================================================================\r\n   157\techo \"\"\r\n   158\techo \"=== Reporter Tests ===\"\r\n   159\t\r\n   160\treport_out=$(generate_report)\r\n   161\tassert_contains \"report has header\" \"$report_out\" \"ForgeKit Build Report\"\r\n   162\tassert_contains \"report lists libbase\" \"$report_out\" \"libbase\"\r\n   163\t\r\n   164\t# TODO: Test that long package names are displayed without truncation\r\n   165\t# TODO: Test report shows correct build status\r\n   166\t\r\n   167\t# ==================================================================\r\n   168\techo \"\"\r\n   169\techo \"=== Config Generator Tests ===\"\r\n   170\t\r\n   171\t# Simple substitution\r\n   172\tgenerate_config \"staging\" > /dev/null 2>&1\r\n   173\tif [[ -f \"$FORGE_ROOT/generated/deploy.yaml\" ]]; then\r\n   174\t    deploy_out"]
[263.201541, "o", "=$(cat \"$FORGE_ROOT/generated/deploy.yaml\")\r\n   175\t    assert_contains \"deploy config has env\" \"$deploy_out\" \"staging\"\r\n   176\t    assert_contains \"deploy config has host\" \"$deploy_out\" \"staging.internal\"\r\n   177\telse\r\n   178\t    echo \"  FAIL: deploy.yaml not generated\"\r\n   179\t    ((TOTAL++)); ((FAILED++))\r\n   180\tfi\r\n   181\t\r\n   182\t# TODO: Test nested variable substitution (e.g. ${REGION_${ENV}})\r\n   183\t# TODO: Test generation for production environment\r\n"]
[263.201683, "o", "   184\t# TODO: Test with missing environment config file\r\n   185\t\r\n   186\t# ==================================================================\r\n   187\techo \"\"\r\n   188\techo \"=== Artifact Tests ===\"\r\n   189\t\r\n   190\t# Need to build first\r\n   191\t(cd \"$FORGE_ROOT/packages/libbase\" && make clean > /dev/null 2>&1 && make > /dev/null 2>&1)\r\n   192\tresult=$(pack_artifact \"libbase\" 2>/dev/null)\r\n   193\tassert_contains \"artifact path returned\" \"$result\" \"libbase-1.0.0.tar.gz\"\r\n   194\t\r\n   195\t# TODO: Test artifact includes dependency metadata (deps.manifest)\r\n   196\t# TODO: Test artifact for package with no build output\r\n   197\t# TODO: Test artifact versioning matches manifest\r\n   198\t\r\n   199\t# Clean up\r\n   200\trm -rf \"$FORGE_ROOT/artifacts\" \"$FORGE_ROOT/generated\"\r\n   201\trm -rf \"$FORGE_ROOT/packages/libbase/build\"\r\n   202\tclean_cache\r\n   203\t\r\n   204\t# ==================================================================\r\n   205\techo \"\"\r\n   206\techo \"=== Summary ===\"\r\n   207\techo \"Total: $TOTAL | Passed: $PASSED | Fai"]
[263.201806, "o", "led: $FAILED\"\r\n   208\tif [[ $FAILED -gt 0 ]]; then\r\n   209\t    exit 1\r\n   210\tfi\r\n   211\texit 0\r\n"]
