[218.616764, "o", "     1\t#!/bin/bash\r\n     2\t# Artifact packaging for ForgeKit\r\n     3\t#\r\n     4\t# Packs a package's build output into a distributable tarball.\r\n     5\t\r\n"]
[218.616834, "o", "     6\tpack_artifact() {\r\n     7\t    local pkg_name=\"$1\"\r\n     8\t    local pkg_dir\r\n     9\t    pkg_dir=$(get_package_dir \"$pkg_name\")\r\n    10\t\r\n    11\t    parse_manifest \"$pkg_name\"\r\n    12\t    local version=\"${MANIFEST_version:-0.0.0}\"\r\n    13\t\r\n    14\t    local build_dir=\"$pkg_dir/build\"\r\n"]
[218.617003, "o", "    15\t    if [[ ! -d \"$build_dir\" ]]; then\r\n    16\t        log_error \"Build directory not found for $pkg_name. Run 'forge build' first.\"\r\n    17\t        return 1\r\n    18\t    fi\r\n    19\t\r\n    20\t    local artifact_dir=\"$FORGE_ROOT/artifacts\"\r\n    21\t    mkdir -p \"$artifact_dir\"\r\n    22\t\r\n    23\t    local artifact_name=\"${pkg_name}-${version}.tar.gz\"\r\n    24\t\r\n    25\t    # BUG: The tarball only contains build/ output.\r\n    26\t    # It should also include a deps.manifest file listing the direct\r\n    27\t    # dependencies and their versions so downstream deployment tooling\r\n    28\t    # can verify compatibility.  Currently there is no such metadata,\r\n    29\t    # making it impossible to check whether two artifacts were built\r\n    30\t    # against compatible dependency versions.\r\n    31\t\r\n    32\t    tar -czf \"$artifact_dir/$artifact_name\" \\\r\n    33\t        -C \"$pkg_dir\" \\\r\n    34\t        build/ 2>/dev/null\r\n    35\t\r\n    36\t    if [[ $? -ne 0 ]]; then\r\n    37\t        log_error \"Failed to create artifact for $pkg_n"]
[218.617118, "o", "ame\"\r\n    38\t        return 1\r\n    39\t    fi\r\n    40\t\r\n    41\t    log_info \"Packed artifact: $artifact_name -> $artifact_dir/$artifact_name\"\r\n    42\t    echo \"$artifact_dir/$artifact_name\"\r\n    43\t}\r\n"]
