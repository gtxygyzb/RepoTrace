[892.857186, "o", "\r\n=== Manifest Parser Tests ===\r\n"]
[892.866218, "o", "  PASS: libbase name\r\n"]
[892.866319, "o", "  PASS: libbase version\r\n"]
[892.866408, "o", "  PASS: libbase type\r\n"]
[892.866494, "o", "  PASS: libbase has no deps\r\n"]
[892.875136, "o", "  PASS: libcrypto deps\r\n"]
[892.883124, "o", "  PASS: svc-auth type\r\n"]
[892.883204, "o", "  PASS: svc-auth deps\r\n"]
[892.883266, "o", "\r\n=== Dependency Graph Tests ===\r\n"]
[893.004976, "o", "  PASS: build order has 8 packages\r\n"]
[893.005165, "o", "  PASS: order contains libbase\r\n  PASS: order contains svc-scheduler\r\n"]
[893.005544, "o", "  PASS: libbase before libcrypto\r\n"]
[893.100083, "o", "  PASS: svc-auth deps include libcrypto\r\n"]
[893.100237, "o", "  PASS: svc-auth deps include itself\r\n\r\n=== Cache Tests ===\r\n"]
[893.106401, "o", "  PASS: cache invalid for unbuilt pkg\r\n"]
[893.236943, "o", "  PASS: cache valid after update\r\n"]
[893.237098, "o", "\r\n=== Reporter Tests ===\r\n"]
[893.54379, "o", "  PASS: report has header\r\n"]
[893.54398, "o", "  PASS: report lists libbase\r\n\r\n"]
[893.544065, "o", "=== Config Generator Tests ===\r\n"]
[893.893635, "o", "  PASS: deploy config has env\r\n"]
[893.893865, "o", "  PASS: deploy config has host\r\n\r\n"]
[893.893943, "o", "=== Artifact Tests ===\r\n"]
[894.01627, "o", "  PASS: artifact path returned\r\n"]
[894.024164, "o", "\r\n=== Summary ===\r\n"]
[894.024238, "o", "Total: 20 | Passed: 20 | Failed: 0\r\n"]
[894.024953, "o", "\u001b[?2004h"]
