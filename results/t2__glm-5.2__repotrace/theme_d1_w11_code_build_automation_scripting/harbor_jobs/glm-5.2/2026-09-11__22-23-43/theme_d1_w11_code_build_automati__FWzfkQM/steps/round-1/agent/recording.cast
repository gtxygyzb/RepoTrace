[187.292718, "o", "    37\t        local node=\"$1\"\r\n    38\t\r\n    39\t        # Already finished\r\n    40\t        [[ \"${_visited[$node]:-}\" == \"done\" ]] && return 0\r\n    41\t\r\n    42\t        # Recurse into dependencies first\r\n    43\t        local deps=\"${DEP_MAP[$node]:-}\"\r\n    44\t        if [[ -n \"$deps\" ]]; then\r\n    45\t            local IFS=','\r\n    46\t            for dep in $deps; do\r\n    47\t                dep=\"${dep// /}\"\r\n"]
[187.29278, "o", "    48\t                [[ -z \"$dep\" ]] && continue\r\n    49\t                _topo_visit \"$dep\"\r\n    50\t            done\r\n    51\t        fi\r\n    52\t\r\n    53\t        _visited[$node]=\"done\"\r\n    54\t        _order=\"$_order $node\"\r\n    55\t    }\r\n"]
[187.29284, "o", "    56\t\r\n    57\t    for pkg in $(list_package_names); do\r\n    58\t        _topo_visit \"$pkg\"\r\n    59\t    done\r\n    60\t\r\n    61\t    echo \"$_order\"\r\n    62\t}\r\n    63\t\r\n    64\t# Resolve the build chain for a single target (inclusive)\r\n    65\tresolve_deps_for() {\r\n"]
[187.292904, "o", "    66\t    local target=\"$1\"\r\n    67\t    build_dep_map\r\n    68\t\r\n    69\t    declare -A _visited\r\n    70\t    local _order=\"\"\r\n    71\t\r\n    72\t    _dep_visit() {\r\n    73\t        local node=\"$1\"\r\n    74\t        [[ \"${_visited[$node]:-}\" == \"done\" ]] && return 0\r\n    75\t\r\n    76\t        local deps=\"${DEP_MAP[$node]:-}\"\r\n    77"]
[187.292968, "o", "\t        if [[ -n \"$deps\" ]]; then\r\n    78\t            local IFS=','\r\n    79\t            for dep in $deps; do\r\n    80\t                dep=\"${dep// /}\"\r\n    81\t                [[ -z \"$dep\" ]] && continue\r\n    82\t                _dep_visit \"$dep\"\r\n    83\t            done\r\n    84\t        fi\r\n    85\t\r\n"]
[187.293051, "o", "    86\t        _visited[$node]=\"done\"\r\n    87\t        _order=\"$_order $node\"\r\n    88\t    }\r\n    89\t\r\n    90\t    _dep_visit \"$target\"\r\n    91\t    echo \"$_order\"\r\n    92\t}\r\n    93\t\r\n    94\t# Pretty-print the dependency tree (recursive, indented)\r\n    95\tshow_dep_tree() {\r\n    96\t    local name=\"$1\"\r\n    97\t    local indent=\"${2:-0}\"\r\n    98\t\r\n"]
[187.293115, "o", "    99\t    # Ensure the dep map exists\r\n   100\t    if [[ -z \"${DEP_MAP[*]+_}\" ]]; then\r\n   101\t        build_dep_map\r\n   102\t    fi\r\n   103\t\r\n   104\t    local prefix=\"\"\r\n   105\t    for ((i = 0; i < indent; i++)); do prefix=\"$prefix  \"; done\r\n   106\t\r\n   107\t    echo \"${prefix}${name}\"\r\n   108\t\r\n"]
[187.293184, "o", "   109\t    local deps=\"${DEP_MAP[$name]:-}\"\r\n   110\t    if [[ -n \"$deps\" ]]; then\r\n   111\t        local IFS=','\r\n   112\t        for dep in $deps; do\r\n   113\t            dep=\"${dep// /}\"\r\n   114\t            [[ -z \"$dep\" ]] && continue\r\n   115\t            show_dep_tree \"$dep\" $((indent + 1))\r\n"]
[187.29325, "o", "   116\t        done\r\n   117\t    fi\r\n   118\t}\r\n   119\t\r\n   120\t# Return all transitive dependencies (not including the package itself)\r\n   121\tget_all_deps() {\r\n   122\t    local name=\"$1\"\r\n   123\t    if [[ -z \"${DEP_MAP[*]+_}\" ]]; then\r\n   124\t        build_dep_map\r\n   125\t    fi\r\n   126\t\r\n   127\t    declare -A _seen\r\n   128\t    local _result=\"\"\r\n   129\t\r\n   130\t    _collect_deps() {\r\n"]
[187.293317, "o", "   131\t        local node=\"$1\"\r\n   132\t        local deps=\"${DEP_MAP[$node]:-}\"\r\n   133\t        if [[ -n \"$deps\" ]]; then\r\n   134\t            local IFS=','\r\n   135\t            for dep in $deps; do\r\n   136\t                dep=\"${dep// /}\"\r\n   137\t                [[ -z \"$dep\" ]] && continue\r\n   138\t                if [[ -z \"${_seen[$dep]:-}\" ]]; then\r\n   139\t                    _seen[$dep]=1\r\n"]
[187.293384, "o", "   140\t                    _result=\"$_result $dep\"\r\n   141\t                    _collect_deps \"$dep\"\r\n   142\t                fi\r\n   143\t            done\r\n   144\t        fi\r\n   145\t    }\r\n"]
[187.293459, "o", "   146\t\r\n   147\t    _collect_deps \"$name\"\r\n   148\t    echo \"$_result\"\r\n   149\t}\r\n"]
