[168.561313, "o", "./packages/libbase/Makefile\r\n./packages/libbase/package.forge\r\n./packages/libcrypto/Makefile\r\n./packages/libcrypto/package.forge\r\n./packages/libnet/Makefile\r\n./packages/libnet/package.forge\r\n./packages/libstore/Makefile\r\n./packages/libstore/package.forge\r\n./packages/svc-auth/Makefile\r\n./packages/svc-auth/package.forge\r\n./packages/svc-gateway/Makefile\r\n./packages/svc-gateway/package.forge\r\n./packages/svc-scheduler/Makefile\r\n./packages/svc-scheduler/package.forge\r\n./packages/svc-worker/Makefile\r\n./packages/svc-worker/package.forge\r\n./templates/deploy.yaml.tpl\r\n./templates/monitor.json.tpl\r\n./tests/run_tests.sh\r\n"]
