[195.866487, "o", "     1\t[package]\r\n     2\tname = svc-worker\r\n     3\tversion = 1.5.0\r\n     4\ttype = service\r\n     5\t\r\n"]
[195.866606, "o", "     6\t[deps]\r\n     7\tdeps = libstore,libnet\r\n     8\t\r\n     9\t[build]\r\n    10\tcommand = make\r\n    11\ttest_command = make test\r\n    12\toutput = build/svc-worker\r\n    13\t\r\n    14\t[meta]\r\n    15\tdescription = Background task worker service\r\n    16\ttags = worker,jobs,service\r\n"]
[195.866879, "o", "===== templates/deploy.yaml.tpl =====\r\n"]
[195.868915, "o", "     1\t# Deployment Configuration\r\n     2\t# Generated by ForgeKit config generator\r\n     3\t\r\n     4\tenvironment: ${ENV}\r\n     5"]
[195.869023, "o", "\tregion: ${REGION_${ENV}}\r\n     6\t\r\n     7\tservices:\r\n     8\t  auth:\r\n     9\t    host: ${DEPLOY_HOST}\r\n    10\t    port: ${DEPLOY_PORT}\r\n    11\t    version: ${VERSION_svc_auth}\r\n    12\t  gateway:\r\n    13\t    host: ${DEPLOY_HOST}\r\n    14\t    port: ${DEPLOY_PORT}\r\n    15\t    version: ${VERSION_svc_gateway}\r\n    16\t  worker:\r\n    17\t    host: ${DEPLOY_HOST}\r\n    18\t    port: ${WORKER_PORT_${ENV}}\r\n    19\t    version: ${VERSION_svc_worker}\r\n    20\t  scheduler:\r\n"]
[195.869128, "o", "    21\t    host: ${DEPLOY_HOST}\r\n    22\t    port: ${DEPLOY_PORT}\r\n    23\t    version: ${VERSION_svc_scheduler}\r\n    24\t\r\n    25\tdatabase:\r\n    26\t  host: ${DB_HOST_${ENV}}\r\n    27\t  port: 5432\r\n    28\t  name: ${DB_NAME_${ENV}}\r\n"]
[195.869381, "o", "===== templates/monitor.json.tpl =====\r\n"]
[195.871364, "o", "     1\t{\r\n     2\t  \"environment\": \"${ENV}\",\r\n     3\t  \"monitor\": {\r\n     4\t    \"interval_sec\": 30,\r\n"]
[195.871465, "o", "     5\t    \"endpoints\": [\r\n     6\t      { \"name\": \"auth\",      \"url\": \"http://${DEPLOY_HOST}:${DEPLOY_PORT}/health\" },\r\n     7\t      { \"name\": \"gateway\",   \"url\": \"http://${DEPLOY_HOST}:${DEPLOY_PORT}/status\" },\r\n     8\t      { \"name\": \"worker\",    \"url\": \"http://${DEPLOY_HOST}:${WORKER_PORT_${ENV}}/ping\" },\r\n     9\t      { \"name\": \"scheduler\", \"url\": \"http://${DEPLOY_HOST}:${DEPLOY_PORT}/heartbeat\" }\r\n    10\t    ],\r\n    11\t    \"alert_channel\": \"${ALERT_CHANNEL}\"\r\n    12\t  }\r\n    13\t}\r\n"]
[195.871739, "o", "===== config/forge.conf =====\r\n"]
[195.873888, "o", "     1\t# ForgeKit Global Configuration\r\n     2\tFORGE_CACHE_ENABLED=true\r\n     3\tFORGE_LOG_LEVEL=info\r\n     4\tFORGE_PARALLEL=false\r\n"]
[195.873998, "o", "     5\tFORGE_ARTIFACT_DIR=artifacts\r\n     6\tFORGE_PACKAGES_DIR=packages\r\n"]
[195.874213, "o", "===== config/production.conf =====\r\n"]
[195.876342, "o", "     1\t# Production environment configuration\r\n     2\tDEPLOY_HOST=prod.internal\r\n     3\tDEPLOY_PORT=443\r\n     4\tREGION_staging=us-west-2\r\n     5\t"]
[195.876442, "o", "REGION_production=us-east-1\r\n     6\tDB_HOST_staging=db-staging.internal\r\n     7\tDB_HOST_production=db-prod.internal\r\n     8\tDB_NAME_staging=forgekit_staging\r\n     9\tDB_NAME_production=forgekit_prod\r\n    10\tWORKER_PORT_staging=9090\r\n    11\tWORKER_PORT_production=9443\r\n    12\tALERT_CHANNEL=ops-production\r\n"]
[195.876723, "o", "===== config/staging.conf =====\r\n"]
[195.878634, "o", "     1\t# Staging environment configuration\r\n     2\tDEPLOY_HOST=staging.internal\r\n     3\tDEPLOY_PORT=8080\r\n     4\tREGION_staging=us-west-2\r\n     5\tREGION_production=us-east-1\r\n     6"]
[195.878733, "o", "\tDB_HOST_staging=db-staging.internal\r\n     7\tDB_HOST_production=db-prod.internal\r\n     8\tDB_NAME_staging=forgekit_staging\r\n     9\tDB_NAME_production=forgekit_prod\r\n    10\tWORKER_PORT_staging=9090\r\n    11\tWORKER_PORT_production=9443\r\n    12\tALERT_CHANNEL=ops-staging\r\n"]
[195.87906, "o", "\u001b[?2004h"]
[195.879083, "o", "root@n30009:/app# "]
[202.485071, "i", "nl -ba lib/builder.sh\n"]
[202.485321, "o", "nl -ba lib/builder.sh\r\n\u001b[?2004l\r"]
[202.487703, "o", "     1\t#!/bin/bash\r\n     2\t# Build executor for ForgeKit\r\n     3\t#\r\n     4\t# Builds packages by running their Makefile in the correct environment.\r\n     5\t\r\n     6\t# Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.\r\n     7"]
[202.487876, "o", "\t# BUG: Only sets up paths for *direct* dependencies.\r\n     8\t#      Transitive dependency include/lib paths are not added.\r\n     9\t#      Currently harmless because no header exposes transitive types,\r\n    10\t#      but will break as soon as a public header includes a transitive\r\n    11\t#      dependency header.\r\n    12\tsetup_build_env() {\r\n    13\t    local pkg_name=\"$1\"\r\n"]
[202.488091, "o", "    14\t    parse_manifest \"$pkg_name\"\r\n    15\t\r\n    16\t    local cflags=\"\"\r\n    17\t    local ldflags=\"\"\r\n    18\t    local libs=\"\"\r\n    19\t    local deps=\"${MANIFEST_deps:-}\"\r\n    20\t\r\n    21\t    if [[ -n \"$deps\" ]]; then\r\n    22\t        local IFS=','\r\n    23\t        for dep in $deps; do\r\n    24\t            dep=\"${dep// /}\"\r\n    25\t            [[ -z \"$dep\" ]] && continue\r\n    26\t            local dep_dir\r\n    27\t            dep_dir=$(get_package_dir \"$dep\")\r\n    28\t            cflags=\"$cflags -I${dep_dir}/src\"\r\n    29\t            ldflags=\"$ldflags -L${dep_dir}/build\"\r\n    30\t            # For services linking against libraries\r\n    31\t            parse_manifest \"$dep\"\r\n    32\t            if [[ \"${MANIFEST_type:-}\" == \"library\" ]]; then\r\n    33\t                local libname=\"${dep#lib}\"\r\n    34\t                libs=\"$libs ${dep_dir}/build/${dep}.a\"\r\n    35\t            fi\r\n    36\t        done\r\n    37\t    fi\r\n    38\t\r\n    39\t    export FORGE_CFLAGS=\"$cflags\"\r\n"]
[202.488249, "o", "    40\t    export FORGE_LDFLAGS=\"$ldflags\"\r\n    41\t    export FORGE_LIBS=\"$libs\"\r\n    42\t}\r\n    43\t\r\n    44\t# Build a single package\r\n    45\tbuild_package() {\r\n    46\t    local pkg_name=\"$1\"\r\n    47\t    local pkg_dir\r\n    48\t    pkg_dir=$(get_package_dir \"$pkg_name\")\r\n    49\t\r\n    50\t    if [[ ! -d \"$pkg_dir\" ]]; then\r\n    51\t        log_error \"Package directory not found: $pkg_dir\"\r\n    52\t        return 1\r\n    53\t    fi\r\n    54\t\r\n    55\t    # Check cache\r\n    56\t    if is_cache_valid \"$pkg_name\" 2>/dev/null; then\r\n    57\t        log_info \"[$pkg_name] Up to date (cached)\"\r\n    58\t        return 0\r\n    59\t    fi\r\n    60\t\r\n    61"]
[202.488398, "o", "\t    log_info \"[$pkg_name] Building...\"\r\n    62\t\r\n    63\t    # Parse manifest for build command\r\n    64\t    parse_manifest \"$pkg_name\"\r\n    65\t    local build_cmd=\"${MANIFEST_command:-make}\"\r\n    66\t\r\n    67\t    # Set up build environment\r\n    68\t    setup_build_env \"$pkg_name\"\r\n    69\t\r\n    70\t    # Execute build\r\n    71\t    if ! (cd \"$pkg_dir\" && eval \"$build_cmd\" 2>&1); then\r\n    72\t        log_error \"[$pkg_name] Build failed\"\r\n    73\t        return 1\r\n    74\t    fi\r\n    75\t\r\n    76\t    # Update cache\r\n"]
[202.488508, "o", "    77\t    update_cache \"$pkg_name\"\r\n    78\t\r\n    79\t    log_info \"[$pkg_name] Build successful\"\r\n    80\t    return 0\r\n    81\t}\r\n    82\t\r\n    83\t# Run tests for a single package\r\n    84\ttest_package() {\r\n    85\t    local pkg_name=\"$1\"\r\n"]
[202.488664, "o", "    86\t    local pkg_dir\r\n    87\t    pkg_dir=$(get_package_dir \"$pkg_name\")\r\n    88\t\r\n    89\t    parse_manifest \"$pkg_name\"\r\n    90\t    local test_cmd=\"${MANIFEST_test_command:-make test}\"\r\n    91\t\r\n    92\t    setup_build_env \"$pkg_name\"\r\n    93\t\r\n    94\t    log_info \"[$pkg_name] Running tests...\"\r\n    95\t    if ! (cd \"$pkg_dir\" && eval \"$test_cmd\" 2>&1); then\r\n"]
[202.488774, "o", "    96\t        log_error \"[$pkg_name] Tests failed\"\r\n    97\t        return 1\r\n    98\t    fi\r\n    99\t\r\n   100\t    log_info \"[$pkg_name] Tests passed\"\r\n   101\t    return 0\r\n   102\t}\r\n"]
[202.489156, "o", "\u001b[?2004h"]
[202.489252, "o", "root@n30009:/app# "]
[202.75358, "i", "nl -ba lib/artifact.sh\n"]
[202.753829, "o", "nl -ba lib/artifact.sh\r\n\u001b[?2004l\r"]
[202.755988, "o", "     1\t#!/bin/bash\r\n     2\t# Artifact packaging for ForgeKit\r\n     3\t#\r\n     4\t# Packs a package's build output into a distributable tarball.\r\n     5\t\r\n     6\tpack_artifact() {\r\n     7\t    local pkg_name=\"$1\"\r\n"]
[202.756121, "o", "     8\t    local pkg_dir\r\n     9\t    pkg_dir=$(get_package_dir \"$pkg_name\")\r\n    10\t\r\n    11\t    parse_manifest \"$pkg_name\"\r\n    12\t    local version=\"${MANIFEST_version:-0.0.0}\"\r\n    13\t\r\n    14\t    local build_dir=\"$pkg_dir/build\"\r\n    15\t    if [[ ! -d \"$build_dir\" ]]; then\r\n    16\t        log_error \"Build directory not found for $pkg_name. Run 'forge build' first.\"\r\n    17\t        return 1\r\n    18\t    fi\r\n    19\t\r\n    20\t    local artifact_dir=\"$FORGE_ROOT/artifacts\"\r\n    21\t    mkdir -p \"$artifact_dir\"\r\n    22\t\r\n    23\t    local artifact_name=\"${pkg_name}-${version}.tar.gz\"\r\n    24\t\r\n    25\t    # BUG: The tarball only contains build/ output.\r\n    26"]
[202.756255, "o", "\t    # It should also include a deps.manifest file listing the direct\r\n    27\t    # dependencies and their versions so downstream deployment tooling\r\n    28\t    # can verify compatibility.  Currently there is no such metadata,\r\n    29\t    # making it impossible to check whether two artifacts were built\r\n    30\t    # against compatible dependency versions.\r\n    31\t\r\n    32\t    tar -czf \"$artifact_dir/$artifact_name\" \\\r\n    33\t        -C \"$pkg_dir\" \\\r\n    34\t        build/ 2>/dev/null\r\n    35\t\r\n    36\t    if [[ $? -ne 0 ]]; then\r\n    37\t        log_error \"Failed to create artifact for $pkg_name\"\r\n    38\t        return 1\r\n    39\t    fi\r\n    40\t\r\n    41\t    log_info \"Packed artifact: $artifact_name -> $artifact_dir/$artifact_name\"\r\n    42\t    echo \"$artifact_dir/$artifact_name\"\r\n    43\t}\r\n"]
[202.756643, "o", "\u001b[?2004h"]
[202.756747, "o", "root@n30009:/app# "]
[203.019035, "i", "nl -ba tests/run_tests.sh\n"]
[203.019288, "o", "nl -ba tests/run_tests.sh\r\n\u001b[?2004l\r"]
[203.021493, "o", "     1\t#!/bin/bash\r\n     2\t# ForgeKit Internal Test Suite\r\n     3\t#\r\n     4\t# Tests for the forge build automation system itself.\r\n     5\t# Run with: bash tests/run_tests.sh\r\n     6\t\r\n"]
[203.02168, "o", "     7\tFORGE_ROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\r\n     8\texport FORGE_ROOT\r\n     9\t\r\n    10\tsource \"$FORGE_ROOT/lib/common.sh\"\r\n    11\tsource \"$FORGE_ROOT/lib/manifest.sh\"\r\n    12\tsource \"$FORGE_ROOT/lib/depgraph.sh\"\r\n    13\tsource \"$FORGE_ROOT/lib/builder.sh\"\r\n    14\tsource \"$FORGE_ROOT/lib/cache.sh\"\r\n    15\tsource \"$FORGE_ROOT/lib/artifact.sh\"\r\n    16\tsource \"$FORGE_ROOT/lib/reporter.sh\"\r\n    17\tsource \"$FORGE_ROOT/lib/configgen.sh\"\r\n    18\t\r\n    19\tTOTAL=0\r\n    20\tPASSED=0\r\n    21\tFAILED=0\r\n    22\t\r\n    23\tassert_eq() {\r\n    24\t    local desc=\"$1\" expected=\"$2\" actual=\"$3\"\r\n    25\t    ((TOTAL++))\r\n    26\t    if [[ \"$expected\" == \"$actual\" ]]; then\r\n    27\t        echo \"  PASS: $desc\"\r\n    28\t        ((PASSED++))\r\n    29\t    else\r\n    30\t        echo \"  FAIL: $desc\"\r\n"]
[203.021746, "o", "    31\t        echo \"    expected: '$expected'\"\r\n    32\t        echo \"    actual:   '$actual'\"\r\n    33\t        ((FAILED++))\r\n    34\t    fi\r\n    35\t}\r\n    36\t\r\n    37\tassert_contains() {\r\n    38\t    local desc=\"$1\" haystack=\"$2\" needle=\"$3\"\r\n    39\t    ((TOTAL++))\r\n"]
[203.021911, "o", "    40\t    if [[ \"$haystack\" == *\"$needle\"* ]]; then\r\n    41\t        echo \"  PASS: $desc\"\r\n    42\t        ((PASSED++))\r\n    43\t    else\r\n    44\t        echo \"  FAIL: $desc\"\r\n    45\t        echo \"    expected to contain: '$needle'\"\r\n    46\t        echo \"    in: '$haystack'\"\r\n    47\t        ((FAILED++))\r\n    48\t    fi\r\n    49\t}\r\n    50\t\r\n    51\tassert_not_contains() {\r\n    52\t    local desc=\"$1\" haystack=\"$2\" needle=\"$3\"\r\n    53\t    ((TOTAL++))\r\n    54\t    if [[ \"$haystack\" != *\"$needle\"* ]]; then\r\n    55\t        echo \"  PASS: $desc\"\r\n    56\t        ((PASSED++))\r\n    57\t    else\r\n    58\t        echo \"  FAIL: $desc\"\r\n    59\t        echo \"    expected NOT to contain: '$needle'\"\r\n    60\t        echo \"    in: '$haystack'\"\r\n    61\t        ((FAILED++))\r\n    62\t    fi\r\n"]
[203.022015, "o", "    63\t}\r\n    64\t\r\n    65\tassert_exit_zero() {\r\n    66\t    local desc=\"$1\"\r\n    67\t    shift\r\n    68\t    ((TOTAL++))\r\n    69\t    if \"$@\" > /dev/null 2>&1; then\r\n    70\t        echo \"  PASS: $desc\"\r\n    71\t        ((PASSED++))\r\n    72\t    else\r\n    73\t        echo \"  FAIL: $desc (exit code: $?)\"\r\n    74\t        ((FAILED++))\r\n    75\t    fi\r\n    76\t}\r\n"]
[203.022121, "o", "    77\t\r\n    78\tassert_exit_nonzero() {\r\n    79\t    local desc=\"$1\"\r\n    80\t    shift\r\n    81\t    ((TOTAL++))\r\n    82\t    if \"$@\" > /dev/null 2>&1; then\r\n    83\t        echo \"  FAIL: $desc (expected failure but got success)\"\r\n    84\t        ((FAILED++))\r\n    85\t    else\r\n    86\t        echo \"  PASS: $desc\"\r\n    87\t        ((PASSED++))\r\n    88\t    fi\r\n    89\t}\r\n    90\t\r\n    91\t# ==================================================================\r\n"]
[203.022243, "o", "    92\techo \"\"\r\n    93\techo \"=== Manifest Parser Tests ===\"\r\n    94\t\r\n    95\tparse_manifest \"libbase\"\r\n    96\tassert_eq \"libbase name\" \"libbase\" \"${MANIFEST_name:-}\"\r\n    97\tassert_eq \"libbase version\" \"1.0.0\" \"${MANIFEST_version:-}\"\r\n    98\tassert_eq \"libbase type\" \"library\" \"${MANIFEST_type:-}\"\r\n"]
[203.022351, "o", "    99\tassert_eq \"libbase has no deps\" \"\" \"${MANIFEST_deps:-}\"\r\n   100\t\r\n   101\tparse_manifest \"libcrypto\"\r\n   102\tassert_eq \"libcrypto deps\" \"libbase\" \"${MANIFEST_deps:-}\"\r\n   103\t\r\n   104\tparse_manifest \"svc-auth\"\r\n   105\tassert_eq \"svc-auth type\" \"service\" \"${MANIFEST_type:-}\"\r\n   106\tassert_eq \"svc-auth deps\" \"libcrypto,libstore\" \"${MANIFEST_deps:-}\"\r\n   107\t\r\n   108\t# TODO: Test manifest with multi-line continuation values (backslash)\r\n   109\t# TODO: Test error handling for missing manifest file\r\n   110\t# TODO: Test manifest with inline comments after values\r\n   111\t\r\n   112\t# ==================================================================\r\n   113\techo \"\"\r\n   114\techo \"=== Dependency Graph Tests ===\"\r\n   115\t\r\n   116\torder=$(resolve_build_order)\r\n   117\t"]
[203.022456, "o", "pkg_count=$(echo \"$order\" | wc -w)\r\n   118\tassert_eq \"build order has 8 packages\" \"8\" \"$pkg_count\"\r\n   119\t\r\n   120\t# libbase must come before everything that depends on it\r\n   121\tassert_contains \"order contains libbase\" \"$order\" \"libbase\"\r\n   122\tassert_contains \"order contains svc-scheduler\" \"$order\" \"svc-scheduler\"\r\n   123\t\r\n   124\t# Verify libbase precedes libcrypto in the output\r\n   125\tlibbase_pos=0; libcrypto_pos=0; i=0\r\n   126\tfor pkg in $order; do\r\n   127\t    ((i++))\r\n   128\t    [[ \"$pkg\" == \"libbase\" ]] && libbase_pos=$i\r\n   129\t    [[ \"$pkg\" == \"libcrypto\" ]] && libcrypto_pos=$i\r\n   130\tdone\r\n   131\tassert_eq \"libbase before libcrypto\" \"1\" \"$(( libbase_pos < libcrypto_pos ? 1 : 0 ))\"\r\n   132\t\r\n   133\t# resolve_deps_for\r\n   134\tdeps_for_auth=$(resolve_deps_for \"svc-auth\")\r\n   135\tassert_contains \"svc-auth deps include libcrypto\" \"$deps_for_auth\" \"libcrypto\"\r\n   136\tassert_contains \"svc-auth deps include itself\" \"$deps_for_auth\" \"svc-auth\"\r\n   137\t\r\n   138\t# TODO: Test circular dependency detection\r"]
[203.022577, "o", "\n   139\t# TODO: Test resolve_deps_for with package that has no dependencies\r\n   140\t# TODO: Test handling of unknown/missing dependency names in manifest\r\n   141\t\r\n   142\t# ==================================================================\r\n   143\techo \"\"\r\n   144\techo \"=== Cache Tests ===\"\r\n   145\t\r\n   146\tclean_cache\r\n   147\tassert_exit_nonzero \"cache invalid for unbuilt pkg\" is_cache_valid \"libbase\"\r\n   148\t\r\n   149\tupdate_cache \"libbase\"\r\n   150\tassert_exit_zero \"cache valid after update\" is_cache_valid \"libbase\"\r\n   151\t\r\n   152\t# TODO: Test transitive cache invalidation (dep rebuilt -> consumer invalidated)\r\n   153\t# TODO: Test cache invalidation after source file modification\r\n   154\t# TODO: Test clean_cache removes all stamps\r\n   155\t\r\n"]
[203.02268, "o", "   156\t# ==================================================================\r\n   157\techo \"\"\r\n   158\techo \"=== Reporter Tests ===\"\r\n   159\t\r\n   160\treport_out=$(generate_report)\r\n   161\tassert_contains \"report has header\" \"$report_out\" \"ForgeKit Build Report\"\r\n   162\tassert_contains \"report lists libbase\" \"$report_out\" \"libbase\"\r\n   163\t\r\n   164\t# TODO: Test that long package names are displayed without truncation\r\n   165\t# TODO: Test report shows correct build status\r\n   166\t\r\n   167\t# ==================================================================\r\n   168\techo \"\"\r\n   169\techo \"=== Config Generator Tests ===\"\r\n   170\t\r\n   171\t# Simple substitution\r\n   172\tgenerate_config \"staging\" > /dev/null 2>&1\r\n"]
[203.022792, "o", "   173\tif [[ -f \"$FORGE_ROOT/generated/deploy.yaml\" ]]; then\r\n   174\t    deploy_out=$(cat \"$FORGE_ROOT/generated/deploy.yaml\")\r\n   175\t    assert_contains \"deploy config has env\" \"$deploy_out\" \"staging\"\r\n   176\t    assert_contains \"deploy config has host\" \"$deploy_out\" \"staging.internal\"\r\n   177\telse\r\n   178\t    echo \"  FAIL: deploy.yaml not generated\"\r\n   179\t    ((TOTAL++)); ((FAILED++))\r\n   180\tfi\r\n   181\t\r\n   182\t# TODO: Test nested variable substitution (e.g. ${REGION_${ENV}})\r\n   183\t# TODO: Test generation for production environment\r\n   184\t# TODO: Test with missing environment config file\r\n   185\t\r\n   186\t# ==================================================================\r\n   187\techo \"\"\r\n"]
[203.022912, "o", "   188\techo \"=== Artifact Tests ===\"\r\n   189\t\r\n   190\t# Need to build first\r\n   191\t(cd \"$FORGE_ROOT/packages/libbase\" && make clean > /dev/null 2>&1 && make > /dev/null 2>&1)\r\n   192\tresult=$(pack_artifact \"libbase\" 2>/dev/null)\r\n   193\tassert_contains \"artifact path returned\" \"$result\" \"libbase-1.0.0.tar.gz\"\r\n   194\t\r\n   195\t# TODO: Test artifact includes dependency metadata (deps.manifest)\r\n   196\t# TODO: Test artifact for package with no build output\r\n"]
[203.02301, "o", "   197\t# TODO: Test artifact versioning matches manifest\r\n   198\t\r\n   199\t# Clean up\r\n   200\trm -rf \"$FORGE_ROOT/artifacts\" \"$FORGE_ROOT/generated\"\r\n   201\trm -rf \"$FORGE_ROOT/packages/libbase/build\"\r\n   202\tclean_cache\r\n   203\t\r\n   204\t# ==================================================================\r\n   205\techo \"\"\r\n   206\techo \"=== Summary ===\"\r\n   207\techo \"Total: $TOTAL | Passed: $PASSED | Failed: $FAILED\"\r\n   208\tif [[ $FAILED -gt 0 ]]; then\r\n   209\t    exit 1\r\n   210\tfi\r\n   211\texit 0\r\n"]
