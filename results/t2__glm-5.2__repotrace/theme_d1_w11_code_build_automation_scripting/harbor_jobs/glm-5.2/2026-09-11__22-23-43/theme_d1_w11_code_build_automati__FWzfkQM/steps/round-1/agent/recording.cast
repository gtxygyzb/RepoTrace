[195.845848, "i", "for f in packages/*/package.forge templates/*.tpl config/*.conf; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[195.84659, "o", "for f in packages/*/package.forge templates/*.tpl config/*.conf; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[195.847148, "o", "===== packages/libbase/package.forge =====\r\n"]
[195.849497, "o", "     1\t[package]\r\n     2\tname = libbase\r\n     3\tversion = 1.0.0\r\n     4\ttype = library\r\n     5\t\r\n     6\t[deps]\r\n"]
[195.849654, "o", "     7\t\r\n     8\t[build]\r\n     9\tcommand = make\r\n    10\ttest_command = make test\r\n    11\toutput = build/libbase.a\r\n    12\t\r\n    13\t[meta]\r\n    14\tdescription = Core utility functions used across the monorepo\r\n    15\ttags = core,utils,foundation\r\n"]
[195.849979, "o", "===== packages/libcrypto/package.forge =====\r\n"]
[195.852155, "o", "     1\t[package]\r\n     2\tname = libcrypto\r\n     3\tversion = 1.2.0\r\n     4\ttype = library\r\n     5\t\r\n"]
[195.852277, "o", "     6\t[deps]\r\n     7\tdeps = libbase\r\n     8\t\r\n     9\t[build]\r\n    10\tcommand = make\r\n    11\ttest_command = make test\r\n    12\toutput = build/libcrypto.a\r\n    13\t\r\n    14\t[meta]\r\n    15\tdescription = Cryptographic primitives for signing and verification\r\n    16\ttags = crypto,security,hashing\r\n"]
