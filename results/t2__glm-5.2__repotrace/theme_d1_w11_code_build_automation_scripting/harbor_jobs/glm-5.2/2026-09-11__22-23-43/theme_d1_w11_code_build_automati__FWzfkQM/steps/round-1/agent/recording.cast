[1403.03801, "i", "l_deps\" \"svc-scheduler\"\r\r# Cycle detection\rtmp_cycle_root=$(mktemp -d)\rmkdir -p \"$tmp_cycle_root/packages/cyc-a\" \"$tmp_cycle_root/packages/cyc-b\"\rcat > \"$tmp_cycle_root/packages/cyc-a/package.forge\" <<'MANIFEST'\r[package]\rname = cyc-a\rversion = 1.0.0\rtype = library\r\r[deps]\rdeps = cyc-b\rMANIFEST\rcat > \"$tmp_cycle_root/packages/cyc-b/package.forge\" <<'MANIFEST'\r[package]\rname = cyc-b\rversion = 1.0.0\rtype = library\r\r[deps]\rdeps = cyc-a\rMANIFEST\r\rcycle_err=$(with_forge_root \"$tmp_cycle_root\" resolve_build_order 2>&1 >/dev/null) || true\rassert_contains \"cycle error mentions cyc-a\" \"$cycle_err\" \"cyc-a\"\rassert_contains \"cycle error mentions cyc-b\" \"$cycle_err\" \"cyc-b\"\rassert_contains \"cycle error says circular\" \"$cycle_err\" \"Circular dependency detected\"\rassert_exit_nonzero \"resolve_deps_for cycle fails\" with_forge_root \"$tmp_cycle_root\" resolve_deps_for cyc-a\rrm -rf \"$tmp_cycle_root\"\r\r# Unknown dependency\rtmp_unknown_root=$(mktemp -d)\rmkdir -p \"$tmp_unknown_root/packages/pkg-x\"\rcat > \"$tmp_unknown_root/packages/pkg"]
