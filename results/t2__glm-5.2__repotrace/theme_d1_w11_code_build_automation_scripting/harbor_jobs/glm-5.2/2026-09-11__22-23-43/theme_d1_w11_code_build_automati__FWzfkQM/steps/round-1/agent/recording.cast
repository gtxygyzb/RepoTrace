[539.401135, "o", "===== templates/deploy.yaml.tpl =====\r\n"]
[539.402584, "o", "# Deployment Configuration\r\n# Generated by ForgeKit config generator\r\n\r\nenvironment: ${ENV}\r\nregion: ${REGION_${ENV}}\r\n\r\nservices:\r\n  auth:\r\n    host: ${DEPLOY_HOST}\r\n    port: ${DEPLOY_PORT}\r\n    version: ${VERSION_svc_auth}"]
[539.402682, "o", "\r\n  gateway:\r\n    host: ${DEPLOY_HOST}\r\n    port: ${DEPLOY_PORT}\r\n    version: ${VERSION_svc_gateway}\r\n  worker:\r\n    host: ${DEPLOY_HOST}\r\n    port: ${WORKER_PORT_${ENV}}\r\n    version: ${VERSION_svc_worker}\r\n  scheduler:\r\n    host: ${DEPLOY_HOST}\r\n    port: ${DEPLOY_PORT}\r\n    version: ${VERSION_svc_scheduler}\r\n\r\ndatabase:\r\n  host: ${DB_HOST_${ENV}}\r\n  port: 5432\r\n  name: ${DB_NAME_${ENV}}\r\n"]
[539.402897, "o", "===== templates/monitor.json.tpl =====\r\n"]
[539.405442, "o", "{\r\n  \"environment\": \"${ENV}\",\r\n  \"monitor\": {\r\n    \"interval_sec\": 30,\r\n    \"endpoints\": [\r\n      { \"name\": \"auth\",      \"url\": \"http://${DEPLOY_HOST}:${DEPLOY_PORT}/health\" },\r\n"]
[539.405539, "o", "      { \"name\": \"gateway\",   \"url\": \"http://${DEPLOY_HOST}:${DEPLOY_PORT}/status\" },\r\n      { \"name\": \"worker\",    \"url\": \"http://${DEPLOY_HOST}:${WORKER_PORT_${ENV}}/ping\" },\r\n      { \"name\": \"scheduler\", \"url\": \"http://${DEPLOY_HOST}:${DEPLOY_PORT}/heartbeat\" }\r\n    ],\r\n    \"alert_channel\": \"${ALERT_CHANNEL}\"\r\n  }\r\n}\r\n"]
[539.405969, "o", "\u001b[?2004h"]
[539.406064, "o", "root@n30009:/app# "]
[879.394139, "i", "cat > lib/manifest.sh <<'EOF'\n#!/bin/bash\n# Manifest parser for .forge package files\n#\n# Format:\n#   [section]\n#   key = value\n#   # comments\n#   key = long value \\\n#         continued on next line\n#\n# All parsed values are exported as MANIFEST_<key>=<value>\n\nparse_manifest() {\n    local pkg_name=\"$1\"\n    local manifest_file\n    manifest_file=$(get_package_manifest \"$pkg_name\")\n\n    if [[ ! -f \"$manifest_file\" ]]; then\n        log_error \"Manifest not found: $manifest_file\"\n        return 1\n    fi\n\n    # Clear previous manifest data\n    local var\n    for var in $(compgen -v MANIFEST_ 2>/dev/null || true); do\n        unset \"$var\"\n    done\n\n    local current_section=\"\"\n    local line key value next_line\n\n    while IFS= read -r line || [[ -n \"$line\" ]]; do\n        # Skip empty lines and comments\n        [[ \"$line\" =~ ^[[:space:]]*$ ]] && continue\n        [[ \"$line\" =~ ^[[:space:]]*# ]] && continue\n\n        # Section header\n        if [[ \"$line\" =~ ^\\[([a-zA-Z_][a-zA-Z0-9_]*)\\] ]]; then\n            current_section"]
[879.394447, "i", "=\"${BASH_REMATCH[1]}\"\n            continue\n        fi\n\n        # Key = value pair\n        if [[ \"$line\" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then\n            key=\"${BASH_REMATCH[1]}\"\n            value=\"${BASH_REMATCH[2]}\"\n\n            # Trim trailing whitespace from value\n            value=\"${value%\"${value##*[![:space:]]}\"}\"\n\n            # Handle backslash line continuation.  A trailing backslash joins\n            # the next line; the backslash and leading whitespace on the\n            # continuation line are stripped.\n            while [[ \"$value\" == *\\\\ ]]; do\n                value=\"${value%\\\\}\"\n                if IFS= read -r next_line || [[ -n \"$next_line\" ]]; then\n                    next_line=\"${next_line#\"${next_line##*[![:space:]]}\"}\"\n                    next_line=\"${next_line%\"${next_line##*[![:space:]]}\"}\"\n                    value=\"$value$next_line\"\n                else\n                    break\n                fi\n            done\n\n            export \"MANIFEST_"]
[879.394649, "o", "cat > lib/manifest.sh <<'EOF'\r\n\u001b[?2004l\r=\"${BASH_REMATCH[1]}\"\r\n            continue\r\n        fi\r\n\r\n        # Key = value pair\r\n        if [[ \"$line\" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then\r\n            key=\"${BASH_REMATCH[1]}\"\r\n            value=\"${BASH_REMATCH[2]}\"\r\n\r\n            # Trim trailing whitespa"]
[879.394788, "i", "${key}=${value}\"\n        fi\n    done < \"$manifest_file\"\n}\n\n# Convenience: parse and return a single value\nget_manifest_value() {\n    local pkg_name=\"$1\"\n    local key=\"$2\"\n    if ! parse_manifest \"$pkg_name\"; then\n        return 1\n    fi\n    local var=\"MANIFEST_${key}\"\n    echo \"${!var:-}\"\n}\nEOF\n"]
