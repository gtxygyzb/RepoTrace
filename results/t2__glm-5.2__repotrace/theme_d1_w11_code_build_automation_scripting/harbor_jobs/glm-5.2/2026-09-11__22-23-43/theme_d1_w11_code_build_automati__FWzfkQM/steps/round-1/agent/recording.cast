[1403.038714, "i", "===================================\recho \"\"\recho \"=== Artifact Tests ===\"\r\rfor pkg in $(list_package_names); do clean_package \"$pkg\"; done\rclean_cache\rrm -rf \"$FORGE_ROOT/artifacts\"\r\rbuild_chain() {\r    local target=\"$1\" pkg\r    for pkg in $(resolve_deps_for \"$target\"); do\r        if ! build_package \"$pkg\" > /dev/null 2>&1; then\r            return 1\r        fi\r    done\r    return 0\r}\r\rassert_exit_zero \"build libcrypto chain\" build_chain libcrypto\r\rlibbase_version=$(get_manifest_value libbase version)\rresult=$(pack_artifact libbase 2>/dev/null)\rassert_contains \"libbase artifact path returned\" \"$result\" \"libbase-1.0.0.tar.gz\"\rassert_contains \"artifact version matches manifest\" \"$result\" \"libbase-${libbase_version}.tar.gz\"\r\rtmp_extract=$(mktemp -d)\rtar -xzf \"$result\" -C \"$tmp_extract\"\rassert_exit_zero \"libbase deps.manifest exists\" test -f \"$tmp_extract/build/deps.manifest\"\rassert_eq \"libbase deps.manifest empty\" \"\" \"$(cat \"$tmp_extract/build/deps.manifest\")\"\rrm -rf \"$tmp_extract\"\r\rlibcrypto_version=$(get_manife"]
