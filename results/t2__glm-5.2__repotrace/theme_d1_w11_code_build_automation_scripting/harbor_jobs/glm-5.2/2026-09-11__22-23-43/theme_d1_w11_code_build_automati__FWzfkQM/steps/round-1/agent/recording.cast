[1403.037726, "i", "ld_dep_map\rorder=$(resolve_build_order)\rpkg_count=$(echo \"$order\" | wc -w)\rassert_eq \"build order has 8 packages\" \"8\" \"$pkg_count\"\r\rassert_contains \"order contains libbase\" \"$order\" \"libbase\"\rassert_contains \"order contains svc-scheduler\" \"$order\" \"svc-scheduler\"\r\rposition() {\r    local target=\"$1\" i=0\r    for pkg in $order; do\r        ((i++))\r        [[ \"$pkg\" == \"$target\" ]] && { echo \"$i\"; return; }\r    done\r    echo 0\r}\r\rlibbase_pos=$(position libbase)\rlibcrypto_pos=$(position libcrypto)\rlibstore_pos=$(position libstore)\rlibnet_pos=$(position libnet)\rsvc_auth_pos=$(position svc-auth)\rsvc_scheduler_pos=$(position svc-scheduler)\r\rassert_eq \"libbase before libcrypto\" \"1\" \"$(( libbase_pos < libcrypto_pos ? 1 : 0 ))\"\rassert_eq \"libbase before libstore\" \"1\" \"$(( libbase_pos < libstore_pos ? 1 : 0 ))\"\rassert_eq \"libcrypto before libstore\" \"1\" \"$(( libcrypto_pos < libstore_pos ? 1 : 0 ))\"\rassert_eq \"libbase before libnet\" \"1\" \"$(( libbase_pos < libnet_pos ? 1 : 0 ))\"\rassert_eq \"libstore before svc-auth\" \"1\" \"$(( "]
