[262.629262, "o", "===== packages/libbase/package.forge =====\r\n"]
[262.630107, "o", "[package]\r\nname = libbase\r\nversion = 1.0.0\r\ntype = library\r\n\r\n[deps]\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/libbase.a\r\n\r\n[meta]\r\ndescription = Core utility functions used across the monorepo\r\ntags = core,utils,foundation\r\n"]
[262.630274, "o", "===== packages/libcrypto/package.forge =====\r\n"]
[262.632268, "o", "[package]\r\nname = libcrypto\r\nversion = 1.2.0\r\ntype = library\r\n\r\n[deps]\r\ndeps = libbase\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/libcrypto.a\r\n\r\n[meta]\r\ndescription = Cryptographic primitives for signing and verification\r\ntags = crypto,security,hashing\r\n"]
[262.632593, "o", "===== packages/libnet/package.forge =====\r\n"]
[262.634517, "o", "[package]\r\nname = libnet\r\nversion = 1.1.0\r\ntype = library\r\n\r\n[deps]\r\ndeps = libbase\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/libnet.a\r\n\r\n[meta]\r\ndescription = Network protocol helpers and socket utilities\r\ntags = network,protocol,io\r\n"]
[262.634823, "o", "===== packages/libstore/package.forge =====\r\n"]
[262.63706, "o", "[package]\r\nname = libstore\r\nversion = 1.3.0\r\ntype = library\r\n\r\n[deps]\r\ndeps = libbase,libcrypto\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/libstore.a\r\n\r\n[meta]\r\ndescription = Persistent key-value store \\\r\n"]
[262.637183, "o", "    with integrity verification \\\r\n    and crash recovery support\r\ntags = storage,persistence,\\\r\n    kv,transactions\r\n"]
[262.637481, "o", "===== packages/svc-auth/package.forge =====\r\n"]
[262.639453, "o", "[package]\r\nname = svc-auth\r\nversion = 2.0.1\r\ntype = service\r\n\r\n[deps]\r\ndeps = libcrypto,libstore\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/svc-auth\r\n\r\n[meta]\r\ndescription = Authentication and authorization service\r\ntags = auth,security,service\r\n"]
[262.639767, "o", "===== packages/svc-gateway/package.forge =====\r\n"]
[262.641768, "o", "[package]\r\nname = svc-gateway\r\nversion = 2.1.0\r\ntype = service\r\n\r\n[deps]\r\ndeps = libnet,libcrypto\r\n\r\n[build]\r\ncommand = make\r\ntest_command = make test\r\noutput = build/svc-gateway\r\n\r\n[meta]\r\ndescription = API gateway and request router\r\ntags = gateway,routing,service\r\n"]
