[1403.204685, "o", "\u001b[?2004h> "]
[1403.204762, "o", "            return 1\r\n\u001b[?2004l\r"]
[1403.204818, "o", "\u001b[?2004h> "]
[1403.204873, "o", "        fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
