[539.388003, "o", "\t@echo \"libstore: all tests passed\"\r\n\r\nclean:\r\n\trm -rf $(BUILD_DIR)\r\n\tfind $(SRC_DIR) -name '*.o' -delete 2>/dev/null || true\r\n"]
