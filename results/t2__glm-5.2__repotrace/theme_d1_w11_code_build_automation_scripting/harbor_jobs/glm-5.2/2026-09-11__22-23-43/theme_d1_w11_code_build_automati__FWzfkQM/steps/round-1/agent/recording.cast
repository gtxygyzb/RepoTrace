[203.578517, "o", "\u001b[?2004l\r"]
[203.57877, "o", "===== templates/deploy.yaml.tpl =====\r\n"]
[203.580915, "o", "# Deployment Configuration\r\n# Generated by ForgeKit config generator\r\n\r\nenvironment: ${ENV}\r\nregion: ${REGION_${ENV}}\r\n\r\nservices:\r\n  auth:\r\n    host: ${DEPLOY_HOST}\r\n    port: ${DEPLOY_PORT}\r\n    version: ${VERSION_svc_auth}\r\n  gateway:\r\n    host: ${DEPLOY_HOST}\r\n    port: ${DEPLOY_PORT}\r\n    version: ${VERSION_svc_gateway}\r\n  worker:\r\n    host: ${DEPLOY_HOST}\r\n    port: ${WORKER_PORT_${ENV}}\r\n    version: ${VERSION_svc_worker}\r\n  scheduler:\r\n    host: ${DEPLOY_HOST}\r\n    port: ${DEPLOY_PORT}\r\n    version: ${VERSION_svc_scheduler}\r\n\r\ndatabase:\r\n  host: ${DB_HOST_${ENV}}\r\n  port: 5432\r\n  name: ${DB_NAME_${ENV}}\r\n"]
[203.581245, "o", "===== templates/monitor.json.tpl =====\r\n"]
[203.583249, "o", "{\r\n  \"environment\": \"${ENV}\",\r\n  \"monitor\": {\r\n    \"interval_sec\": 30,\r\n    \"endpoints\": [\r\n      { \"name\": \"auth\",      \"url\": \"http://${DEPLOY_HOST}:${DEPLOY_PORT}/health\" },\r\n      { \"name\": \"gateway\",   \"url\": \"http://${DEPLOY_HOST}:${DEPLOY_PORT}/status\" },\r\n      { \"name\": \"worker\",    \"url\": \"http://${DEPLOY_HOST}:${WORKER_PORT_${ENV}}/ping\" },\r\n      { \"name\": \"scheduler\", \"url\": \"http://${DEPLOY_HOST}:${DEPLOY_PORT}/heartbeat\" }\r\n    ],\r\n    \"alert_channel\": \"${ALERT_CHANNEL}\"\r\n  }\r\n}\r\n"]
[203.583563, "o", "===== config/forge.conf =====\r\n"]
[203.585524, "o", "# ForgeKit Global Configuration\r\nFORGE_CACHE_ENABLED=true\r\nFORGE_LOG_LEVEL=info\r\nFORGE_PARALLEL=false\r\nFORGE_ARTIFACT_DIR=artifacts\r\nFORGE_PACKAGES_DIR=packages\r\n"]
[203.585868, "o", "===== config/production.conf =====\r\n"]
[203.587834, "o", "# Production environment configuration\r\nDEPLOY_HOST=prod.internal\r\nDEPLOY_PORT=443\r\nREGION_staging=us-west-2\r\nREGION_production=us-east-1\r\nDB_HOST_staging=db-staging.internal\r\nDB_HOST_production=db-prod.internal\r\nDB_NAME_staging=forgekit_staging\r\nDB_NAME_production=forgekit_prod\r\nWORKER_PORT_staging=9090\r\nWORKER_PORT_production=9443\r\nALERT_CHANNEL=ops-production\r\n"]
[203.588129, "o", "===== config/staging.conf =====\r\n"]
[203.590092, "o", "# Staging environment configuration\r\nDEPLOY_HOST=staging.internal\r\nDEPLOY_PORT=8080\r\nREGION_staging=us-west-2\r\nREGION_production=us-east-1\r\nDB_HOST_staging=db-staging.internal\r\nDB_HOST_production=db-prod.internal\r\nDB_NAME_staging=forgekit_staging\r\nDB_NAME_production=forgekit_prod\r\nWORKER_PORT_staging=9090\r\nWORKER_PORT_production=9443\r\nALERT_CHANNEL=ops-staging\r\n"]
