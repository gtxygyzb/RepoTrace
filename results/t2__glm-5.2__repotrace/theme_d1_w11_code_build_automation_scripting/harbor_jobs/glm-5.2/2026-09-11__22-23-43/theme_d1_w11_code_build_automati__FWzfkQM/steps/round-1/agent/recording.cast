[1403.052249, "o", "\u001b[?2004h> "]
[1403.052316, "o", "    else\r\n\u001b[?2004l\r"]
[1403.052374, "o", "\u001b[?2004h> "]
[1403.05258, "o", "        echo \"  FAIL: $desc\"\r\n\u001b[?2004l\r"]
[1403.052637, "o", "\u001b[?2004h> "]
[1403.053016, "o", "        echo \"    expected NOT to contain: '$needle'\"\r\n\u001b[?2004l\r"]
[1403.053072, "o", "\u001b[?2004h> "]
[1403.053306, "o", "        echo \"    in: '$haystack'\"\r\n\u001b[?2004l\r"]
[1403.053358, "o", "\u001b[?2004h> "]
[1403.053512, "o", "        ((FAILED++))\r\n\u001b[?2004l\r"]
[1403.053569, "o", "\u001b[?2004h> "]
[1403.053641, "o", "    fi\r\n\u001b[?2004l\r"]
[1403.053699, "o", "\u001b[?2004h> }\r\n"]
[1403.053756, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1403.053812, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.053867, "o", "> "]
[1403.053977, "o", "assert_exit_zero() {\r\n\u001b[?2004l\r"]
[1403.054043, "o", "\u001b[?2004h> "]
[1403.054189, "o", "    local desc=\"$1\"\r\n\u001b[?2004l\r"]
[1403.054246, "o", "\u001b[?2004h> "]
[1403.054316, "o", "    shift\r\n\u001b[?2004l\r"]
[1403.054373, "o", "\u001b[?2004h> "]
[1403.054484, "o", "    ((TOTAL++))\r\n\u001b[?2004l\r"]
[1403.054539, "o", "\u001b[?2004h> "]
[1403.054796, "o", "    if \"$@\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[1403.054854, "o", "\u001b[?2004h> "]
[1403.055054, "o", "        echo \"  PASS: $desc\"\r\n\u001b[?2004l\r"]
[1403.05511, "o", "\u001b[?2004h> "]
[1403.055252, "o", "        ((PASSED++))\r\n\u001b[?2004l\r"]
[1403.055298, "o", "\u001b[?2004h> "]
[1403.055385, "o", "    else\r\n\u001b[?2004l\r"]
[1403.055443, "o", "\u001b[?2004h> "]
[1403.083261, "o", "        echo \"  FAIL: $desc (exit code: $?)\"\r\n\u001b[?2004l\r"]
[1403.083343, "o", "\u001b[?2004h> "]
[1403.083476, "o", "        ((FAILED++))\r\n\u001b[?2004l\r"]
[1403.083532, "o", "\u001b[?2004h> "]
[1403.083618, "o", "    fi\r\n\u001b[?2004l\r"]
[1403.083675, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1403.083733, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1403.083793, "o", "\u001b[?2004h> "]
[1403.083954, "o", "assert_exit_nonzero() {\r\n\u001b[?2004l\r"]
[1403.084009, "o", "\u001b[?2004h> "]
[1403.084152, "o", "    local desc=\"$1\"\r\n\u001b[?2004l\r"]
[1403.084208, "o", "\u001b[?2004h> "]
[1403.084285, "o", "    shift\r\n\u001b[?2004l\r"]
[1403.084339, "o", "\u001b[?2004h> "]
[1403.084448, "o", "    ((TOTAL++))\r\n\u001b[?2004l\r"]
[1403.084509, "o", "\u001b[?2004h> "]
[1403.084761, "o", "    if \"$@\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[1403.084819, "o", "\u001b[?2004h> "]
[1403.085237, "o", "        echo \"  FAIL: $desc (expected failure but got success)\"\r\n\u001b[?2004l\r"]
[1403.085293, "o", "\u001b[?2004h> "]
[1403.085446, "o", "        ((FAILED++))\r\n\u001b[?2004l\r"]
[1403.085501, "o", "\u001b[?2004h> "]
[1403.085582, "o", "    else\r\n\u001b[?2004l\r"]
[1403.085639, "o", "\u001b[?2004h> "]
[1403.085838, "o", "        echo \"  PASS: $desc\"\r\n\u001b[?2004l\r"]
[1403.085894, "o", "\u001b[?2004h> "]
[1403.086041, "o", "        ((PASSED++))\r\n\u001b[?2004l\r"]
[1403.086097, "o", "\u001b[?2004h> "]
[1403.086151, "o", "    fi\r\n\u001b[?2004l\r"]
[1403.086208, "o", "\u001b[?2004h> }\r\n"]
[1403.086268, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1403.086327, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1403.086462, "o", "assert_grep() {\r\n\u001b[?2004l\r"]
[1403.086516, "o", "\u001b[?2004h> "]
[1403.086809, "o", "    local desc=\"$1\" text=\"$2\" pattern=\"$3\"\r\n\u001b[?2004l\r"]
[1403.086865, "o", "\u001b[?2004h> "]
[1403.086981, "o", "    ((TOTAL++))\r\n\u001b[?2004l\r"]
[1403.087037, "o", "\u001b[?2004h> "]
[1403.087359, "o", "    if echo \"$text\" | grep -q \"$pattern\"; then\r\n\u001b[?2004l\r"]
[1403.087427, "o", "\u001b[?2004h> "]
[1403.087626, "o", "        echo \"  PASS: $desc\"\r\n\u001b[?2004l\r"]
[1403.087678, "o", "\u001b[?2004h> "]
[1403.087828, "o", "        ((PASSED++))\r\n\u001b[?2004l\r"]
[1403.087883, "o", "\u001b[?2004h> "]
[1403.087963, "o", "    else\r\n\u001b[?2004l\r"]
[1403.08802, "o", "\u001b[?2004h> "]
[1403.088228, "o", "        echo \"  FAIL: $desc\"\r\n\u001b[?2004l\r"]
[1403.088284, "o", "\u001b[?2004h> "]
[1403.088626, "o", "        echo \"    expected to match: '$pattern'\"\r\n\u001b[?2004l\r"]
[1403.088686, "o", "\u001b[?2004h> "]
[1403.088901, "o", "        echo \"    in: '$text'\"\r\n\u001b[?2004l\r"]
[1403.088958, "o", "\u001b[?2004h> "]
[1403.089109, "o", "        ((FAILED++))\r\n\u001b[?2004l\r"]
[1403.089169, "o", "\u001b[?2004h> "]
[1403.08923, "o", "    fi\r\n\u001b[?2004l\r"]
[1403.089286, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1403.08934, "o", "\u001b[?2004h> \r\n"]
[1403.089397, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1403.089457, "o", "> "]
[1403.089564, "o", "with_forge_root() {\r\n\u001b[?2004l\r"]
[1403.089626, "o", "\u001b[?2004h> "]
[1403.089775, "o", "    local root=\"$1\"\r\n\u001b[?2004l\r"]
[1403.08983, "o", "\u001b[?2004h> "]
[1403.089902, "o", "    shift\r\n\u001b[?2004l\r"]
[1403.089956, "o", "\u001b[?2004h> "]
[1403.090158, "o", "    FORGE_ROOT=\"$root\" \"$@\"\r\n\u001b[?2004l\r"]
[1403.090214, "o", "\u001b[?2004h> }\r\n"]
[1403.090271, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1403.090331, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1403.090818, "o", "# ==================================================================\r\n\u001b[?2004l\r"]
[1403.090875, "o", "\u001b[?2004h> "]
[1403.090939, "o", "echo \"\"\r\n\u001b[?2004l\r"]
[1403.090995, "o", "\u001b[?2004h> "]
[1403.091249, "o", "echo \"=== Manifest Parser Tests ===\"\r\n\u001b[?2004l\r"]
[1403.091305, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1403.091361, "o", "\u001b[?2004h> "]
[1403.09154, "o", "parse_manifest \"libbase\"\r\n\u001b[?2004l\r"]
[1403.091604, "o", "\u001b[?2004h> "]
[1403.091978, "o", "assert_eq \"libbase name\" \"libbase\" \"${MANIFEST_name:-}\"\r\n\u001b[?2004l\r"]
[1403.092036, "o", "\u001b[?2004h> "]
[1403.092443, "o", "assert_eq \"libbase version\" \"1.0.0\" \"${MANIFEST_version:-}\"\r\n\u001b[?2004l\r"]
[1403.092499, "o", "\u001b[?2004h> "]
[1403.092885, "o", "assert_eq \"libbase type\" \"library\" \"${MANIFEST_type:-}\"\r\n\u001b[?2004l\r"]
[1403.092941, "o", "\u001b[?2004h> "]
[1403.093317, "o", "assert_eq \"libbase has no deps\" \"\" \"${MANIFEST_deps:-}\"\r\n\u001b[?2004l\r"]
[1403.093373, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1403.093428, "o", "\u001b[?2004h> "]
[1403.093632, "o", "parse_manifest \"libcrypto\"\r\n\u001b[?2004l\r"]
[1403.093686, "o", "\u001b[?2004h> "]
[1403.094085, "o", "assert_eq \"libcrypto deps\" \"libbase\" \"${MANIFEST_deps:-}\"\r\n\u001b[?2004l\r"]
[1403.094141, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1403.094197, "o", "\u001b[?2004h> "]
[1403.094382, "o", "parse_manifest \"svc-auth\"\r\n\u001b[?2004l\r"]
[1403.094442, "o", "\u001b[?2004h> "]
[1403.09484, "o", "assert_eq \"svc-auth type\" \"service\" \"${MANIFEST_type:-}\"\r\n\u001b[?2004l\r"]
[1403.094896, "o", "\u001b[?2004h> "]
[1403.095349, "o", "assert_eq \"svc-auth deps\" \"libcrypto,libstore\" \"${MANIFEST_deps:-}\"\r\n\u001b[?2004l\r"]
[1403.095404, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1403.09546, "o", "\u001b[?2004h> "]
[1403.095992, "o", "assert_exit_nonzero \"missing manifest errors\" parse_manifest no-such-package\r\n\u001b[?2004l\r"]
[1403.096048, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1403.09611, "o", "\u001b[?2004h> "]
[1403.09633, "o", "tmp_manifest_root=$(mktemp -d)\r\n\u001b[?2004l\r"]
[1403.096387, "o", "\u001b[?2004h> "]
[1403.096719, "o", "mkdir -p \"$tmp_manifest_root/packages/pkg-cont\"\r\n\u001b[?2004l\r"]
[1403.096775, "o", "\u001b[?2004h> "]
[1403.097252, "o", "cat > \"$tmp_manifest_root/packages/pkg-cont/package.forge\" <<'MANIFEST'\r\n\u001b[?2004l\r"]
[1403.097309, "o", "\u001b[?2004h> "]
[1403.097385, "o", "[package]\r\n\u001b[?2004l\r"]
[1403.097441, "o", "\u001b[?2004h> "]
[1403.097564, "o", "name = pkg-cont\r\n\u001b[?2004l\r"]
[1403.09761, "o", "\u001b[?2004h> "]
[1403.097745, "o", "version = 1.0.0\r\n\u001b[?2004l\r"]
[1403.097802, "o", "\u001b[?2004h> "]
[1403.097904, "o", "type = library\r\n\u001b[?2004l\r"]
[1403.09795, "o", "\u001b[?2004h> \r\n"]
[1403.098017, "o", "\u001b[?2004l\r"]
[1403.098074, "o", "\u001b[?2004h> "]
[1403.098207, "o", "description = first part \\\r\n\u001b[?2004l\r"]
[1403.098264, "o", "\u001b[?2004h> "]
[1403.098394, "o", "              second part\r\n\u001b[?2004l\r"]
[1403.098451, "o", "\u001b[?2004h> "]
[1403.098563, "o", "tags = one,two,three\r\n\u001b[?2004l\r"]
[1403.098619, "o", "\u001b[?2004h> "]
[1403.098783, "o", "notes = value # inline comment\r\n\u001b[?2004l\r"]
[1403.098838, "o", "\u001b[?2004h> "]
[1403.098905, "o", "empty =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1403.098968, "o", "MANIFEST\r\n\u001b[?2004l\r"]
[1403.099025, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.099081, "o", "> "]
[1403.099439, "o", "with_forge_root \"$tmp_manifest_root\" parse_manifest \"pkg-cont\"\r\n\u001b[?2004l\r"]
[1403.099496, "o", "\u001b[?2004h> "]
[1403.099826, "o", "assert_eq \"continuation name\" \"pkg-cont\" \"${MANIFEST_name:-}\"\r\n\u001b[?2004l\r"]
[1403.099882, "o", "\u001b[?2004h> "]
[1403.100249, "o", "assert_eq \"continuation version\" \"1.0.0\" \"${MANIFEST_version:-}\"\r\n\u001b[?2004l\r"]
[1403.100305, "o", "\u001b[?2004h> "]
[1403.100811, "o", "assert_eq \"continuation joined value\" \"first part second part\" \"${MANIFEST_description:-}\"\r\n\u001b[?2004l\r"]
[1403.100869, "o", "\u001b[?2004h> "]
[1403.10137, "o", "assert_eq \"continuation preserves normal value\" \"one,two,three\" \"${MANIFEST_tags:-}\"\r\n\u001b[?2004l\r"]
[1403.101428, "o", "\u001b[?2004h> "]
[1403.101792, "o", "assert_eq \"inline comment stripped\" \"value\" \"${MANIFEST_notes:-}\"\r\n\u001b[?2004l\r"]
[1403.101848, "o", "\u001b[?2004h> "]
[1403.102171, "o", "assert_eq \"empty value parsed\" \"\" \"${MANIFEST_empty:-}\"\r\n\u001b[?2004l\r"]
[1403.102229, "o", "\u001b[?2004h> "]
[1403.102377, "o", "rm -rf \"$tmp_manifest_root\"\r\n\u001b[?2004l\r"]
[1403.102432, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1403.10249, "o", "\u001b[?2004h> "]
[1403.10288, "o", "# ==================================================================\r\n\u001b[?2004l\r"]
[1403.102936, "o", "\u001b[?2004h> "]
[1403.102997, "o", "echo \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1403.103243, "o", "echo \"=== Dependency Graph Tests ===\"\r\n\u001b[?2004l\r"]
[1403.1033, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.103355, "o", "> "]
[1403.103415, "o", "build_dep_map\r\n\u001b[?2004l\r"]
[1403.103476, "o", "\u001b[?2004h> "]
[1403.103638, "o", "order=$(resolve_build_order)\r\n\u001b[?2004l\r"]
[1403.103694, "o", "\u001b[?2004h> "]
[1403.103894, "o", "pkg_count=$(echo \"$order\" | wc -w)\r\n\u001b[?2004l\r"]
[1403.103951, "o", "\u001b[?2004h> "]
[1403.104284, "o", "assert_eq \"build order has 8 packages\" \"8\" \"$pkg_count\"\r\n\u001b[?2004l\r"]
[1403.104342, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.104397, "o", "> "]
[1403.1047, "o", "assert_contains \"order contains libbase\" \"$order\" \"libbase\"\r\n\u001b[?2004l\r"]
[1403.104755, "o", "\u001b[?2004h> "]
[1403.105118, "o", "assert_contains \"order contains svc-scheduler\" \"$order\" \"svc-scheduler\"\r\n\u001b[?2004l\r"]
[1403.105175, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.10523, "o", "> "]
[1403.105281, "o", "position() {\r\n\u001b[?2004l\r"]
[1403.105337, "o", "\u001b[?2004h> "]
[1403.105486, "o", "    local target=\"$1\" i=0\r\n\u001b[?2004l\r"]
[1403.105541, "o", "\u001b[?2004h> "]
[1403.105672, "o", "    for pkg in $order; do\r\n\u001b[?2004l\r"]
[1403.105727, "o", "\u001b[?2004h> "]
[1403.10581, "o", "        ((i++))\r\n\u001b[?2004l\r"]
[1403.105865, "o", "\u001b[?2004h> "]
[1403.106216, "o", "        [[ \"$pkg\" == \"$target\" ]] && { echo \"$i\"; return; }\r\n\u001b[?2004l\r"]
[1403.106272, "o", "\u001b[?2004h> "]
[1403.106339, "o", "    done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1403.106416, "o", "    echo 0\r\n\u001b[?2004l\r"]
[1403.106472, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1403.106532, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.106595, "o", "> "]
[1403.106751, "o", "libbase_pos=$(position libbase)\r\n\u001b[?2004l\r"]
[1403.106807, "o", "\u001b[?2004h> "]
[1403.106997, "o", "libcrypto_pos=$(position libcrypto)\r\n\u001b[?2004l\r"]
[1403.107053, "o", "\u001b[?2004h> "]
[1403.10725, "o", "libstore_pos=$(position libstore)\r\n\u001b[?2004l\r"]
[1403.107305, "o", "\u001b[?2004h> "]
[1403.107452, "o", "libnet_pos=$(position libnet)\r\n\u001b[?2004l\r"]
[1403.107507, "o", "\u001b[?2004h> "]
[1403.107696, "o", "svc_auth_pos=$(position svc-auth)\r\n\u001b[?2004l\r"]
[1403.107754, "o", "\u001b[?2004h> "]
[1403.108003, "o", "svc_scheduler_pos=$(position svc-scheduler)\r\n\u001b[?2004l\r"]
[1403.108059, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.108114, "o", "> "]
[1403.108623, "o", "assert_eq \"libbase before libcrypto\" \"1\" \"$(( libbase_pos < libcrypto_pos ? 1 : 0 ))\"\r\n\u001b[?2004l\r"]
[1403.10868, "o", "\u001b[?2004h> "]
[1403.108957, "o", "assert_eq \"libbase before libstore\" \"1\" \"$(( libbase_pos < libstore_pos ? 1 : 0 ))\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.109013, "o", "> "]
[1403.109312, "o", "assert_eq \"libcrypto before libstore\" \"1\" \"$(( libcrypto_pos < libstore_pos ? 1 : 0 ))\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.109369, "o", "> "]
[1403.109625, "o", "assert_eq \"libbase before libnet\" \"1\" \"$(( libbase_pos < libnet_pos ? 1 : 0 ))\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.109681, "o", "> "]
[1403.109961, "o", "assert_eq \"libstore before svc-auth\" \"1\" \"$(( libstore_pos < svc_auth_pos ? 1 : 0 ))\"\r\n\u001b[?2004l\r"]
[1403.110018, "o", "\u001b[?2004h> "]
[1403.110324, "o", "assert_eq \"libnet before svc-scheduler\" \"1\" \"$(( libnet_pos < svc_scheduler_pos ? 1 : 0 ))\"\r\n\u001b[?2004l\r"]
[1403.110381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1403.110543, "o", "deps_for_auth=$(resolve_deps_for \"svc-auth\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.110605, "o", "> "]
[1403.11085, "o", "assert_contains \"svc-auth deps include libcrypto\" \"$deps_for_auth\" \"libcrypto\"\r\n\u001b[?2004l\r"]
[1403.110906, "o", "\u001b[?2004h> "]
[1403.111153, "o", "assert_contains \"svc-auth deps include libstore\" \"$deps_for_auth\" \"libstore\"\r\n\u001b[?2004l\r"]
[1403.11121, "o", "\u001b[?2004h> "]
[1403.111511, "o", "assert_contains \"svc-auth deps include transitive libbase\" \"$deps_for_auth\" \"libbase\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.111575, "o", "> "]
[1403.111809, "o", "assert_contains \"svc-auth deps include itself\" \"$deps_for_auth\" \"svc-auth\"\r\n\u001b[?2004l\r"]
[1403.111864, "o", "\u001b[?2004h> "]
[1403.112128, "o", "assert_eq \"svc-auth chain has 4 packages\" \"4\" \"$(echo \"$deps_for_auth\" | wc -w)\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1403.112184, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
