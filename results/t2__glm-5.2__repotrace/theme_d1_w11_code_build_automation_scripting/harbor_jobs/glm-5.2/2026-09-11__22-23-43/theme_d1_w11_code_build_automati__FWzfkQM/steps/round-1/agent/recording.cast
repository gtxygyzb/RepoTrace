[880.514827, "i", "cat > lib/artifact.sh <<'EOF'\n#!/bin/bash\n# Artifact packaging for ForgeKit\n\npack_artifact() {\n    local pkg_name=\"$1\"\n    local pkg_dir\n    pkg_dir=$(get_package_dir \"$pkg_name\")\n\n    parse_manifest \"$pkg_name\"\n    local version=\"${MANIFEST_version:-0.0.0}\"\n\n    local build_dir=\"$pkg_dir/build\"\n    if [[ ! -d \"$build_dir\" ]]; then\n        log_error \"Build directory not found for $pkg_name. Run 'forge build' first.\"\n        return 1\n    fi\n\n    local artifact_dir=\"$FORGE_ROOT/artifacts\"\n    mkdir -p \"$artifact_dir\"\n\n    local artifact_name=\"${pkg_name}-${version}.tar.gz\"\n\n    # Generate dependency metadata inside the packaged build directory.\n    # Direct dependencies only, as <dep_name>=<dep_version> per line.\n    local deps_manifest=\"$build_dir/deps.manifest\"\n    : > \"$deps_manifest\"\n\n    local deps=\"${MANIFEST_deps:-}\"\n    if [[ -n \"$deps\" ]]; then\n        local IFS=','\n        local dep dep_version\n        for dep in $deps; do\n            dep=\"${dep// /}\"\n            [[ -z \"$dep\" ]] && continue\n          "]
[880.515086, "i", "  dep_version=$(get_manifest_value \"$dep\" \"version\") || return 1\n            printf '%s=%s\\n' \"$dep\" \"$dep_version\" >> \"$deps_manifest\"\n        done\n    fi\n\n    tar -czf \"$artifact_dir/$artifact_name\" \\\n        -C \"$pkg_dir\" \\\n        build/ 2>/dev/null\n\n    if [[ $? -ne 0 ]]; then\n        log_error \"Failed to create artifact for $pkg_name\"\n        return 1\n    fi\n\n    log_info \"Packed artifact: $artifact_name -> $artifact_dir/$artifact_name\"\n    echo \"$artifact_dir/$artifact_name\"\n}\nEOF\n"]
