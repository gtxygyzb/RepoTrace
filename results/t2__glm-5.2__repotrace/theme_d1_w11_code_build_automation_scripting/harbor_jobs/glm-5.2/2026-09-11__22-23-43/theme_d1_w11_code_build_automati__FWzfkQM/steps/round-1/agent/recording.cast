[1402.209313, "i", "cat > lib/manifest.sh <<'EOF'\n#!/bin/bash\n# Manifest parser for .forge package files\n#\n# Format:\n#   [section]\n#   key = value\n#   # comments\n#   key = long value \\\n#         continued on next line\n#\n# All parsed values are exported as MANIFEST_<key>=<value>\n\nparse_manifest() {\n    local pkg_name=\"$1\"\n    local manifest_file\n    manifest_file=$(get_package_manifest \"$pkg_name\")\n\n    if [[ ! -f \"$manifest_file\" ]]; then\n        log_error \"Manifest not found: $manifest_file\"\n        return 1\n    fi\n\n    # Clear previous manifest data\n    local var\n    for var in $(compgen -v MANIFEST_ 2>/dev/null || true); do\n        unset \"$var\"\n    done\n\n    local current_section=\"\"\n    local line key value next_line\n\n    while IFS= read -r line || [[ -n \"$line\" ]]; do\n        # Skip empty lines and full-line comments\n        [[ \"$line\" =~ ^[[:space:]]*$ ]] && continue\n        [[ \"$line\" =~ ^[[:space:]]*# ]] && continue\n\n        # Section header\n        if [[ \"$line\" =~ ^\\[([a-zA-Z_][a-zA-Z0-9_]*)\\] ]]; then\n            curre"]
[1402.209652, "i", "nt_section=\"${BASH_REMATCH[1]}\"\n            continue\n        fi\n\n        # Key = value pair\n        if [[ \"$line\" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then\n            key=\"${BASH_REMATCH[1]}\"\n            value=\"${BASH_REMATCH[2]}\"\n\n            # Strip inline comments preceded by whitespace.  A '#' inside a\n            # value without preceding whitespace is preserved.\n            if [[ \"$value\" =~ ^[[:space:]]*# ]]; then\n                value=\"\"\n            elif [[ \"$value\" =~ [[:space:]]# ]]; then\n                value=\"${value%%[[:space:]]#*}\"\n            fi\n\n            # Trim trailing whitespace from value\n            value=\"${value%\"${value##*[![:space:]]}\"}\"\n\n            # Handle backslash line continuation.  A trailing backslash joins\n            # the next line; the backslash and leading whitespace on the\n            # continuation line are stripped.\n            while [[ \"$value\" == *\\\\ ]]; do\n                value=\"${value%\\\\}\"\n                if IFS= read -r nex"]
[1402.209752, "o", "cat > lib/manifest.sh <<'EOF'\r\n\u001b[?2004l\r"]
[1402.209846, "i", "t_line || [[ -n \"$next_line\" ]]; then\n                    next_line=\"${next_line#\"${next_line##*[![:space:]]}\"}\"\n                    next_line=\"${next_line%\"${next_line##*[![:space:]]}\"}\"\n                    value=\"$value$next_line\"\n                else\n                    break\n                fi\n            done\n\n            export \"MANIFEST_${key}=${value}\"\n        fi\n    done < \"$manifest_file\"\n}\n\n# Convenience: parse and return a single value\nget_manifest_value() {\n    local pkg_name=\"$1\"\n    local key=\"$2\"\n    if ! parse_manifest \"$pkg_name\"; then\n        return 1\n    fi\n    local var=\"MANIFEST_${key}\"\n    echo \"${!var:-}\"\n}\nEOF\n"]
