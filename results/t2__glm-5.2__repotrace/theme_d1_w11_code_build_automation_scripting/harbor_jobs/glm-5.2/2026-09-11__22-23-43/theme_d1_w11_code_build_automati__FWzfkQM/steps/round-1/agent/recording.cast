[879.976337, "o", "        mtime=$(stat -c %Y \"$pkg_dir/Makefile\" 2>/dev/null || echo 0)\r\n\u001b[?2004l\r"]
[879.97643, "o", "\u001b[?2004h"]
[879.976517, "o", "> "]
[879.976626, "o", "        if (( mtime > latest )); then\r\n\u001b[?2004l\r"]
[879.976715, "o", "\u001b[?2004h"]
