[1403.121872, "o", "\r\n\u001b[?2004l\ra\u001b[?2004h> "]
[1403.121975, "o", "# Source modification invalidates cache\r\n\u001b[?2004l\rf\u001b[?2004h"]
[1403.122031, "o", "> "]
[1403.122086, "o", "update_cache \"libbase\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1403.122236, "o", "find \"$FORGE_ROOT/packages/libbase/src\" -type f -exec touch {} +\r\n\u001b[?2004l\r\u001b[?2004h> "]
