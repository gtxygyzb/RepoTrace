[539.3752, "o", "===== packages/libbase/Makefile =====\r\n"]
[539.378151, "o", "CC      ?= gcc\r\nCFLAGS  ?= -Wall -Wextra -O2\r\nCFLAGS  += $(FORGE_CFLAGS)\r\nAR      ?= ar\r\n\r\nSRC_DIR   = src\r\nBUILD_DIR = build\r\n\r\n"]
[539.378277, "o", "SOURCES = $(wildcard $(SRC_DIR)/*.c)\r\nOBJECTS = $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SOURCES))\r\nTARGET  = $(BUILD_DIR)/libbase.a\r\n\r\n.PHONY: all test clean\r\n\r\nall: $(TARGET)\r\n\r\n$(TARGET): $(OBJECTS)\r\n\t@mkdir -p $(BUILD_DIR)\r\n\t$(AR) rcs $@ $^\r\n\r\n$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c\r\n\t@mkdir -p $(BUILD_DIR)\r\n\t$(CC) $(CFLAGS) -I$(SRC_DIR) -c -o $@ $<\r\n\r\ntest: all\r\n\t@echo \"libbase: all tests passed\"\r\n\r\nclean:\r\n\trm -rf $(BUILD_DIR)\r\n\tfind $(SRC_DIR) -name '*.o' -delete 2>/dev/null || true\r\n"]
[539.378729, "o", "===== packages/libcrypto/Makefile =====\r\n"]
[539.38144, "o", "CC      ?= gcc\r\nCFLAGS  ?= -Wall -Wextra -O2\r\nCFLAGS  += $(FORGE_CFLAGS)\r\nAR      ?= ar\r\n\r\nSRC_DIR   = src\r\n"]
