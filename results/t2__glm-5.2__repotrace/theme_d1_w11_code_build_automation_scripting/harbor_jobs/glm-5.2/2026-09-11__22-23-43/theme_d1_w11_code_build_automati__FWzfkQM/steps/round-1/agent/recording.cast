[880.767821, "i", "cat > lib/configgen.sh <<'EOF'\n#!/bin/bash\n# Deployment config generator for ForgeKit\n#\n# Processes template files (*.tpl) by substituting ${VAR} references\n# with values from environment-specific config files and built-in vars.\n\n# Resolve ${VAR} references iteratively, including nested references such\n# as ${REGION_${ENV}}.  Flat references are resolved first, then the\n# process repeats until no further substitution occurs or the maximum\n# depth is reached.  Unknown references are left unchanged.\n_config_resolve_vars() {\n    local content=\"$1\"\n    local max_depth=100\n    local depth=0\n    local prev\n    local var_name\n\n    while (( depth < max_depth )); do\n        prev=\"$content\"\n        for var_name in \"${!config_vars[@]}\"; do\n            content=\"${content//\\$\\{${var_name}\\}/${config_vars[$var_name]}}\"\n        done\n        [[ \"$content\" == \"$prev\" ]] && break\n        ((depth++))\n    done\n\n    printf '%s' \"$content\"\n}\n\ngenerate_config() {\n    local env=\"$1\"\n    local template_dir=\"$FORGE_ROOT/templates\"\n\n  "]
[880.768093, "i", "  if [[ ! -d \"$template_dir\" ]]; then\n        log_error \"Templates directory not found: $template_dir\"\n        return 1\n    fi\n\n    # Build variable map -----------------------------------------------\n    declare -A config_vars\n    config_vars[ENV]=\"$env\"\n    config_vars[FORGE_ROOT]=\"$FORGE_ROOT\"\n    config_vars[TIMESTAMP]=\"$(date -u +%Y%m%dT%H%M%SZ)\"\n\n    # Load environment-specific config if it exists\n    local env_conf=\"$FORGE_ROOT/config/${env}.conf\"\n    if [[ -f \"$env_conf\" ]]; then\n        local key value\n        while IFS='=' read -r key value; do\n            [[ \"$key\" =~ ^[[:space:]]*# ]] && continue\n            [[ -z \"$key\" ]] && continue\n            key=$(echo \"$key\" | tr -d '[:space:]')\n            value=$(echo \"$value\" | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')\n            config_vars[$key]=\"$value\"\n        done < \"$env_conf\"\n    fi\n\n    # Inject per-package version variables\n    local pkg_name safe_name\n    for pkg_name in $(list_package_names); do\n        parse_manifest \"$pkg_name\"\n   "]
[880.768128, "o", "cat > lib/configgen.sh <<'EOF'\r\n\u001b[?2004l\r"]
[880.768253, "i", "     safe_name=\"${pkg_name//-/_}\"\n        config_vars[\"VERSION_${safe_name}\"]=\"${MANIFEST_version:-0.0.0}\"\n    done\n\n    # Process each template file ---------------------------------------\n    mkdir -p \"$FORGE_ROOT/generated\"\n\n    local tpl outname outfile content\n    for tpl in \"$template_dir\"/*.tpl; do\n        [[ -f \"$tpl\" ]] || continue\n        outname=$(basename \"$tpl\" .tpl)\n        outfile=\"$FORGE_ROOT/generated/${outname}\"\n\n        content=$(cat \"$tpl\")\n        content=$(_config_resolve_vars \"$content\")\n\n        echo \"$content\" > \"$outfile\"\n        log_info \"Generated config: $outfile\"\n    done\n}\nEOF\n"]
