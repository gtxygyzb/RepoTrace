[879.97714, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[879.977258, "o", "    echo \"$latest\"\r\n\u001b[?2004l\r"]
[879.977335, "o", "\u001b[?2004h"]
[879.977419, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
