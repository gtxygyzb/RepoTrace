[195.85465, "o", "     1\t[package]\r\n     2\tname = libnet\r\n     3\tversion = 1.1.0\r\n     4\ttype = library\r\n     5\t\r\n"]
[195.854764, "o", "     6\t[deps]\r\n     7\tdeps = libbase\r\n     8\t\r\n     9\t[build]\r\n    10\tcommand = make\r\n    11\ttest_command = make test\r\n    12\toutput = build/libnet.a\r\n    13\t\r\n    14\t[meta]\r\n    15\tdescription = Network protocol helpers and socket utilities\r\n    16\ttags = network,protocol,io\r\n"]
[195.855071, "o", "===== packages/libstore/package.forge =====\r\n"]
[195.857154, "o", "     1\t[package]\r\n     2\tname = libstore\r\n     3\tversion = 1.3.0\r\n     4\ttype = library\r\n     5\t\r\n"]
[195.85726, "o", "     6\t[deps]\r\n     7\tdeps = libbase,libcrypto\r\n     8\t\r\n     9\t[build]\r\n    10\tcommand = make\r\n    11\ttest_command = make test\r\n    12\toutput = build/libstore.a\r\n    13\t\r\n    14\t[meta]\r\n    15\tdescription = Persistent key-value store \\\r\n    16\t    with integrity verification \\\r\n"]
[195.857357, "o", "    17\t    and crash recovery support\r\n    18\ttags = storage,persistence,\\\r\n    19\t    kv,transactions\r\n"]
[195.857634, "o", "===== packages/svc-auth/package.forge =====\r\n"]
[195.859505, "o", "     1\t[package]\r\n     2\tname = svc-auth\r\n     3\tversion = 2.0.1\r\n     4\ttype = service\r\n     5\t\r\n     6\t[deps]\r\n     7\tdeps = libcrypto,libstore\r\n"]
[195.859641, "o", "     8\t\r\n     9\t[build]\r\n    10\tcommand = make\r\n    11\ttest_command = make test\r\n    12\toutput = build/svc-auth\r\n    13\t\r\n    14\t[meta]\r\n    15\tdescription = Authentication and authorization service\r\n    16\ttags = auth,security,service\r\n"]
[195.859893, "o", "===== packages/svc-gateway/package.forge =====\r\n"]
[195.861884, "o", "     1\t[package]\r\n     2\tname = svc-gateway\r\n     3\tversion = 2.1.0\r\n     4\ttype = service\r\n     5\t"]
[195.861996, "o", "\r\n     6\t[deps]\r\n     7\tdeps = libnet,libcrypto\r\n     8\t\r\n     9\t[build]\r\n    10\tcommand = make\r\n    11\ttest_command = make test\r\n    12\toutput = build/svc-gateway\r\n    13\t\r\n    14\t[meta]\r\n    15\tdescription = API gateway and request router\r\n    16\ttags = gateway,routing,service\r\n"]
[195.862279, "o", "===== packages/svc-scheduler/package.forge =====\r\n"]
[195.864247, "o", "     1\t[package]\r\n     2\tname = svc-scheduler\r\n     3\tversion = 1.0.0\r\n     4\ttype = service\r\n"]
[195.864356, "o", "     5\t\r\n     6\t[deps]\r\n     7\tdeps = libstore,libnet,libcrypto\r\n     8\t\r\n     9\t[build]\r\n    10\tcommand = make\r\n    11\ttest_command = make test\r\n    12\toutput = build/svc-scheduler\r\n    13\t\r\n    14\t[meta]\r\n    15\tdescription = Distributed task scheduling and orchestration service\r\n    16\ttags = scheduler,orchestration,service\r\n"]
