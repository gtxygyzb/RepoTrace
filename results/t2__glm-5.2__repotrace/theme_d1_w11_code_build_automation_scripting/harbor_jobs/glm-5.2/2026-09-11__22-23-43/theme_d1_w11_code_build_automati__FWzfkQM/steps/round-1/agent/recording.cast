[904.978366, "i", "for f in packages/*/Makefile; do echo \"===== $f =====\"; sed -n '1,80p' \"$f\"; done\n"]
[904.978987, "o", "for f in packages/*/Makefile; do echo \"===== $f =====\"; sed -n '1,80p' \"$f\"; done\r\n\u001b[?2004l\r"]
[904.979406, "o", "===== packages/libbase/Makefile =====\r\n"]
[904.982413, "o", "CC      ?= gcc\r\nCFLAGS  ?= -Wall -Wextra -O2\r\nCFLAGS  += $(FORGE_CFLAGS)\r\nAR      ?= ar\r\n\r\nSRC_DIR   = src\r\n"]
[904.982489, "o", "BUILD_DIR = build\r\n\r\nSOURCES = $(wildcard $(SRC_DIR)/*.c)\r\nOBJECTS = $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SOURCES))\r\nTARGET  = $(BUILD_DIR)/libbase.a\r\n\r\n.PHONY: all test clean\r\n\r\nall: $(TARGET)\r\n\r\n$(TARGET): $(OBJECTS)\r\n\t@mkdir -p $(BUILD_DIR)\r\n\t$(AR) rcs $@ $^\r\n\r\n$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c\r\n"]
[904.982569, "o", "\t@mkdir -p $(BUILD_DIR)\r\n\t$(CC) $(CFLAGS) -I$(SRC_DIR) -c -o $@ $<\r\n\r\ntest: all\r\n\t@echo \"libbase: all tests passed\"\r\n\r\nclean:\r\n\trm -rf $(BUILD_DIR)\r\n\tfind $(SRC_DIR) -name '*.o' -delete 2>/dev/null || true\r\n"]
[904.98303, "o", "===== packages/libcrypto/Makefile =====\r\n"]
[904.985848, "o", "CC      ?= gcc\r\nCFLAGS  ?= -Wall -Wextra -O2\r\nCFLAGS  += $(FORGE_CFLAGS)\r\nAR      ?= ar\r\n\r\nSRC_DIR   = src\r\n"]
