[1403.122539, "o", "clean_cache\r\n\u001b[?2004l\r(\u001b[?2004h> \r\n\u001b[?2004l\rg"]
[1403.122603, "o", "\u001b[?2004h> "]
[1403.122676, "o", "# Transitive cache invalidation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1403.12275, "o", "update_cache \"libbase\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
