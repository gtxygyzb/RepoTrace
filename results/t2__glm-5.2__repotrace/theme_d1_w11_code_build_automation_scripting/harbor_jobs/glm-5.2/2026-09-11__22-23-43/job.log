Sending keys: ['cat >> lib/builder.sh <<\'EOF\'\n\n# -------------------------------------------------------------------\n# Round 4: selective rebuild support.\n# -------------------------------------------------------------------\n\n# Build only packages affected by changes for the given profile.\nbuild_changed_packages() {\n    local jobs="${1:-1}" profile="${2:-release}"\n    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then\n        log_error "Invalid profile: $profile"\n        return 1\n    fi\n\n    build_dep_map\n\n    local changed\n    changed=$(get_changed_packages "$profile") || return 1\n    if [[ -z "$changed" ]]; then\n        echo "Everything up to date."\n        return 0\n    fi\n\n    local affected\n    affected=$(get_affected_packages $changed) || return 1\n    if [[ -z "$affected" ]]; then\n        echo "Everything up to date."\n        return 0\n    fi\n\n    local order\n    order=$(forge_topo_order $affected) || return 1\n\n    # Force selected packages to rebuild and re-link, even if their own\n    # sources are unchanged.  Removing the artifact ensures Make re-creates\n    # it; invalidating the cache ensures build_package does not skip it.\n    local pkg pkg_dir artifact_dir artifact\n    for pkg in $order; do\n        invalidate_cache "$pkg" "$profile"\n        pkg_dir=$(get_package_dir "$pkg")\n        artifact_dir="$pkg_dir/build/$profile"\n        mkdir -p "$artifact_dir"\n        parse_manifest "$pkg"\n        if [[ "${MANIFEST_type:-}" == "library" ]]; then\n            artifact="$artifact_dir/${pkg}.a"\n        else\n            artifact="$artifact_dir/${pkg}"\n        fi\n        [[ -f "$artifact" ]] && rm -f "$artifact"\n    done\n\n    _run_parallel_build "$order" "$jobs" "$profile"\n}\n\n# Subset-safe parallel build scheduler.\n# Dependencies outside the provided order are treated as already satisfied.\n_run_parallel_build() {\n    local order="$1" jobs="${2:-1}" profile="${3:-release}"\n    jobs=$(( jobs < 1 ? 1 : jobs ))\n\n    declare -A in_order remaining_deps done_pkg failed_pkg active_pids\n    local pkg dep deps_str dep_count dep_array\n\n    for pkg in $order; do\n        in_order[$pkg]=1\n    done\n\n    for pkg in $order; do\n        deps_str="${DEP_MAP[$pkg]:-}"\n        dep_count=0\n        if [[ -n "$deps_str" ]]; then\n            IFS=\',\' read -ra dep_array <<< "$deps_str"\n            for dep in "${dep_array[@]}"; do\n                dep="${dep// /}"\n                [[ -z "$dep" ]] && continue\n                if [[ -n "${in_order[$dep]:-}" ]]; then\n                    dep_count=$(( dep_count + 1 ))\n                fi\n            done\n        fi\n        remaining_deps[$pkg]=$dep_count\n        done_pkg[$pkg]=0\n    done\n\n    local total=0 finished=0 active=0 failed=0\n    for pkg in $order; do total=$(( total + 1 )); done\n\n    local tmpdir\n    tmpdir=$(mktemp -d)\n    trap \'rm -rf "$tmpdir"\' RETURN\n\n    while (( finished < total )); do\n        if (( ! failed )); then\n            for pkg in $order; do\n                if (( active >= jobs )); then\n                    break\n                fi\n                if [[ "${done_pkg[$pkg]:-}" == "0" ]] && (( remaining_deps[$pkg] == 0 )); then\n                    done_pkg[$pkg]=1\n                    active=$(( active + 1 ))\n                    (\n                        {\n                            build_package "$pkg" "$profile"\n                            echo "__FORGE_BUILD_RC__$?"\n                        } > "$tmpdir/$pkg.out" 2>&1\n                    ) &\n                    active_pids[$!]="$pkg"\n                fi\n            done\n        fi\n\n        if (( active == 0 )); then\n            break\n        fi\n\n        wait -n 2>/dev/null || wait\n\n        local pid output_pkg rc dependent dep_dep\n        for pid in "${!active_pids[@]}"; do\n            if ! kill -0 "$pid" 2>/dev/null; then\n                wait "$pid" 2>/dev/null || true\n                output_pkg="${active_pids[$pid]}"\n                unset "active_pids[$pid]"\n                active=$(( active - 1 ))\n                finished=$(( finished + 1 ))\n\n                rc=$(grep -m1 \'__FORGE_BUILD_RC__\' "$tmpdir/$output_pkg.out" | sed \'s/.*__FORGE_BUILD_RC__//\')\n                rc="${rc:-1}"\n\n                echo "=== [$output_pkg] ==="\n                grep -v \'__FORGE_BUILD_RC__\' "$tmpdir/$output_pkg.out"\n\n                if (( rc != 0 )); then\n                    failed_pkg[$output_pkg]=1\n                    failed=1\n                else\n                    done_pkg[$output_pkg]=2\n                    for dependent in $order; do\n                        if [[ "${done_pkg[$dependent]:-}" != "2" ]]; then\n                            deps_str="${DEP_MAP[$dependent]:-}"\n                            if [[ -n "$deps_str" ]]; then\n                                IFS=\',\' read -ra dep_array <<< "$deps_str"\n                                for dep_dep in "${dep_array[@]}"; do\n                                    dep_dep="${dep_dep// /}"\n                                    [[ -z "$dep_dep" ]] && continue\n                                    if [[ "$dep_dep" == "$output_pkg" ]]; then\n                                        remaining_deps[$dependent]=$(( remaining_deps[$dependent] - 1 ))\n                                    fi\n                                done\n                            fi\n                        fi\n                    done\n                fi\n            fi\n        done\n    done\n\n    rm -rf "$tmpdir"\n\n    local failures=""\n    for pkg in $order; do\n        if [[ -n "${failed_pkg[$pkg]:-}" ]]; then\n            failures="$failures $pkg"\n        fi\n    done\n\n    if [[ -n "$failures" ]]; then\n        failures="${failures# }"\n        log_error "Build failed for: $failures"\n        return 1\n    fi\n\n    return 0\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
