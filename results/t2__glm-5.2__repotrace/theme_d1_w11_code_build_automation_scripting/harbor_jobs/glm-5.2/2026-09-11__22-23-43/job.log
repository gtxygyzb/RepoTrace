(( active == 0 )); then\n            break\n        fi\n\n        wait -n 2>/dev/null || true\n\n        local completed=0\n        for pid in "${!active_pids[@]}"; do\n            if ! kill -0 "$pid" 2>/dev/null; then\n                wait "$pid" 2>/dev/null || true\n                pkg="${active_pids[$pid]}"\n                unset "active_pids[$pid]"\n                active=$(( active - 1 ))\n                finished=$(( finished + 1 ))\n                completed=$(( completed + 1 ))\n\n                local rc\n                rc=$(grep -m1 \'__FORGE_BUILD_RC__\' "$tmpdir/$pkg.out" | sed \'s/.*__FORGE_BUILD_RC__//\')\n                rc="${rc:-1}"\n\n                echo "=== [$pkg] ==="\n                grep -v \'__FORGE_BUILD_RC__\' "$tmpdir/$pkg.out"\n\n                if (( rc == 0 )); then\n                    state[$pkg]=done\n\n                    local dependent dep_deps dep_dep dep_arr\n                    for dependent in $order; do\n                        if [[ "${state[$dependent]}" == "pending" ]]; then\n                            dep_deps="${DEP_MAP[$dependent]:-}"\n                            if [[ -n "$dep_deps" ]]; then\n                                IFS=\',\' read -ra dep_arr <<< "$dep_deps"\n                                for dep_dep in "${dep_arr[@]}"; do\n                                    dep_dep="${dep_dep// /}"\n                                    [[ -z "$dep_dep" ]] && continue\n                                    if [[ "$dep_dep" == "$pkg" ]]; then\n                                        remaining_deps[$dependent]=$(( remaining_deps[$dependent] - 1 ))\n                                    fi\n                                done\n                            fi\n                        fi\n                    done\n                else\n                    state[$pkg]=failed\n                    failed_pkg[$pkg]=1\n                    failed=1\n                fi\n            fi\n        done\n\n        if (( completed == 0 )); then