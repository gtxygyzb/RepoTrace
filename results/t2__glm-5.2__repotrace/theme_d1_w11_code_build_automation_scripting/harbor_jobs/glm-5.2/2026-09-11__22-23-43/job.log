Sending keys: ['cat > lib/journal.sh <<\'EOF\'\n#!/bin/bash\n# Build event journal for ForgeKit.\n#\n# Appends structured JSON-lines events for build actions and provides\n# query/clear helpers for `forge journal` and `forge report`.\n\nFORGE_JOURNAL_DIR="${FORGE_ROOT}/.forge_journal"\nFORGE_JOURNAL_FILE="${FORGE_JOURNAL_DIR}/events.jsonl"\n\njournal_dir() {\n    echo "$FORGE_JOURNAL_DIR"\n}\n\njournal_file() {\n    echo "$FORGE_JOURNAL_FILE"\n}\n\ninit_journal() {\n    mkdir -p "$FORGE_JOURNAL_DIR"\n}\n\n# Escape a string for JSON.  Backslash first, then double quotes and\n# control characters.  Bash metadata is not expected to contain quotes or\n# backslashes, but this keeps the journal robust.\njournal_json_escape() {\n    local s="$1"\n    s="${s//\\\\/\\\\\\\\}"\n    s="${s//\\"/\\\\\\"}"\n    s="${s//$\'\\\\t\'/\\\\t}"\n    s="${s//$\'\\\\n\'/\\\\n}"\n    s="${s//$\'\\\\r\'/\\\\r}"\n    printf \'%s\' "$s"\n}\n\n# Append a single JSON event.  Fields:\n# timestamp event package profile duration_ms cache_hit trigger\njournal_append_event() {\n    local event="$1" pkg="$2" profile="${3:-release}" duration_ms="${4:-0}" cache_hit="${5:-false}" trigger="${6:-manual}"\n    init_journal\n    local ts\n    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"\n    local pkg_esc\n    pkg_esc="$(journal_json_escape "$pkg")"\n    local line\n    line="{\\"timestamp\\":\\"${ts}\\",\\"event\\":\\"${event}\\",\\"package\\":\\"${pkg_esc}\\",\\"profile\\":\\"${profile}\\",\\"duration_ms\\":${duration_ms},\\"cache_hit\\":${cache_hit},\\"trigger\\":\\"${trigger}\\"}"\n    {\n        flock 9\n        printf \'%s\\n\' "$line" >> "$FORGE_JOURNAL_FILE"\n    } 9>"$FORGE_JOURNAL_DIR/.lock"\n}\n\n# Determine the trigger for an actual build.  Priority order:\n# no_cache -> source_changed -> dep_changed -> manual.\njournal_build_trigger() {\n    local pkg="$1" profile="${2:-release}"\n    local cache_file="$FORGE_CACHE_DIR/${pkg}-${profile}.hash"\n    if [[ ! -f "$cache_file" ]]; then\n        echo "no_cache"\n        return 0\n    fi\n\n    local own_hash stored_hash\n    own_hash="$(compute_source_hash "$pkg" 2>/dev/null)"\n    stored_hash="$(_stored_own_hash "$cache_file" 2>/dev/null)"\n    if [[ -z "$stored_hash" || "$own_hash" != "$stored_hash" ]]; then\n        echo "source_changed"\n        return 0\n    fi\n\n    local deps dep dep_hash stored_dep_hash\n    deps="$(get_all_deps "$pkg" 2>/dev/null)" || deps=""\n    for dep in $deps; do\n        [[ -z "$dep" ]] && continue\n        dep_hash="$(compute_source_hash "$dep" 2>/dev/null)"\n        stored_dep_hash="$(_stored_dep_hash "$cache_file" "$dep" 2>/dev/null)"\n        if [[ -z "$stored_dep_hash" || "$dep_hash" != "$stored_dep_hash" ]]; then\n            echo "dep_changed"\n            return 0\n        fi\n    done\n\n    echo "manual"\n}\n\n# Print recent journal events with filters.\njournal_query() {\n    local last=50 pkg_filter="" profile_filter="" builds_only=false\n    while [[ $# -gt 0 ]]; do\n        case "$1" in\n            --last)\n                if [[ $# -lt 2 ]]; then\n                    log_error "--last requires a number"\n                    return 1\n                fi\n                last="$2"\n                shift\n                ;;\n            --package)\n                if [[ $# -lt 2 ]]; then\n                    log_error "--package requires a name"\n                    return 1\n                fi\n                pkg_filter="$2"\n                shift\n                ;;\n            --profile)\n                if [[ $# -lt 2 ]]; then\n                    log_error "--profile requires a name"\n                    return 1\n                fi\n                profile_filter="$2"\n                shift\n                ;;\n            --builds-only)\n                builds_only=true\n                ;;\n            *)\n                log_error "Unknown journal option: $1"\n                return 1\n                ;;\n        esac\n        shift\n    done\n\n    if [[ ! -f "$FORGE_JOURNAL_FILE" ]]; then\n        echo "No build events recorded."\n        return 0\n    fi\n\n    if [[ ! "$last" =~ ^[0-9]+$ ]] || (( last < 0 )); then\n        log_error "Invalid --last value: $last"\n        return 1\n    fi\n\n    local line event pkg profile duration_ms cache_hit detail\n    local printed=0\n    while IFS= read -r line; do\n        [[ -z "$line" ]] && continue\n        event="$(journal_field "$line" event)"\n        pkg="$(journal_field "$line" package)"\n        profile="$(journal_field "$line" profile)"\n\n        [[ -n "$pkg_filter" && "$pkg" != "$pkg_filter" ]] && continue\n        [[ -n "$profile_filter" && "$profile" != "$profile_filter" ]] && continue\n        if [[ "$builds_only" == true ]]; then\n            [[ "$event" != "build_complete" && "$event" != "build_fail" ]] && continue\n        fi\n\n        duration_ms="$(journal_field "$line" duration_ms)"\n        cache_hit="$(journal_field "$line" cache_hit)"\n        if [[ "$event" == "build_skip" || "$cache_hit" == "true" ]]; then\n            detail="(cached)"\n        else\n            detail="${duration_ms}ms"\n        fi\n\n        printf \'%s  %-13s %-16s %s  %s\\n\' \\\n            "$(journal_field "$line" timestamp)" "$event" "$pkg" "$profile" "$detail"\n        printed=$(( printed + 1 ))\n    done < <(tail -n "$last" "$FORGE_JOURNAL_FILE" 2>/dev/null)\n\n    if (( printed == 0 )); then\n        echo "No build events recorded."\n        return 0\n    fi\n}\n\n# Extract a field from a JSON object line.  This intentionally uses simple\n# text parsing to avoid depending on jq.\njournal_field() {\n    local json="$1" field="$2"\n    local value\n    value="$(printf \'%s\' "$json" | sed -n -E \\\n        -e "s/.*\\"${field}\\":\\"([^\\"]*)\\".*/\\1/p" \\\n        -e "s/.*\\"${field}\\":([^,}]*).*/\\1/p")"\n    echo "$value"\n}\n\n# Truncate the journal file but keep the audit directory.\njournal_clear() {\n    init_journal\n    : > "$FORGE_JOURNAL_FILE"\n    log_info "Cleared build event journal"\n}\n\n# Return the duration_ms of the most recent build_complete/build_fail for\n# a package, or empty string if none exists.\njournal_last_build_duration() {\n    local pkg="$1"\n    [[ -f "$FORGE_JOURNAL_FILE" ]] || return 0\n    local line duration=""\n    while IFS= read -r line; do\n        [[ -z "$line" ]] && continue\n        local event pkg_field\n        event="$(journal_field "$line" event)"\n        pkg_field="$(journal_field "$line" package)"\n        if [[ "$pkg_field" == "$pkg" ]] && [[ "$event" == "build_complete" || "$event" == "build_fail" ]]; then\n            duration="$(journal_field "$line" duration_ms)"\n        fi\n    done < "$FORGE_JOURNAL_FILE"\n    echo "$duration"\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
