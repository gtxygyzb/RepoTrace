Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\n\n# Patch lib/cache.sh: include package.forge in source mtime and support all-profile invalidation.\np = Path("lib/cache.sh")\ns = p.read_text()\n\nold = \'\'\'    # Also check Makefile\n    if [[ -f "$pkg_dir/Makefile" ]]; then\n        mtime=$(stat -c %Y "$pkg_dir/Makefile" 2>/dev/null || echo 0)\n        if (( mtime > latest )); then\n            latest=$mtime\n        fi\n    fi\n\n    echo "$latest"\'\'\'\nnew = \'\'\'    # Also check Makefile\n    if [[ -f "$pkg_dir/Makefile" ]]; then\n        mtime=$(stat -c %Y "$pkg_dir/Makefile" 2>/dev/null || echo 0)\n        if (( mtime > latest )); then\n            latest=$mtime\n        fi\n    fi\n\n    # Manifest changes (version, deps, build command, etc.) must invalidate cache.\n    if [[ -f "$pkg_dir/package.forge" ]]; then\n        mtime=$(stat -c %Y "$pkg_dir/package.forge" 2>/dev/null || echo 0)\n        if (( mtime > latest )); then\n            latest=$mtime\n        fi\n    fi\n\n    echo "$latest"\'\'\'\nif old not in s:\n    raise SystemExit("cache.sh get_src_mtime block not found")\ns = s.replace(old, new)\n\nold = \'\'\'# Remove cache entry for a package\ninvalidate_cache() {\n    local pkg_name="$1"\n    local profile\n    profile=$(_forge_cache_profile "${2:-release}")\n    rm -f "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"\n}\'\'\'\nnew = \'\'\'# Remove cache entry for a package.  When a profile is supplied, only that\n# profile\'s stamp is removed.  Without a profile, all profile stamps for the\n# package are invalidated.\ninvalidate_cache() {\n    local pkg_name="$1"\n    local profile\n    if [[ -n "${2:-}" ]]; then\n        profile=$(_forge_cache_profile "$2")\n        rm -f "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"\n    else\n        rm -f "$FORGE_CACHE_DIR/${pkg_name}-"*.stamp\n    fi\n}\'\'\'\nif old not in s:\n    raise SystemExit("cache.sh invalidate_cache block not found")\ns = s.replace(old, new)\np.write_text(s)\n\n# Patch lib/common.sh: clean_package respects optional profile scope.\np = Path("lib/common.sh")\ns = p.read_text()\nold = \'\'\'# Clean build artifacts for a package.  A profile argument scopes the\n# cleanup to build/<profile>; without it, release is cleaned.  Object\n# files under src are removed for the selected profile\'s build tree.\nclean_package() {\n    local name="$1"\n    local profile\n    profile="${2:-release}"\n    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then\n        log_error "Invalid profile: $profile"\n        return 1\n    fi\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$name")\n    if [[ -d "$pkg_dir/build/$profile" ]]; then\n        rm -rf "$pkg_dir/build/$profile"\n        log_info "Cleaned $name ($profile)"\n    fi\n    if [[ -d "$pkg_dir/build" ]] && [[ -z "$(find "$pkg_dir/build" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then\n        rmdir "$pkg_dir/build" 2>/dev/null || true\n    fi\n    find "$pkg_dir/src" -name "*.o" -delete 2>/dev/null || true\n}\'\'\'\nnew = \'\'\'# Clean build artifacts for a package.  When a profile is supplied, only\n# build/<profile>/ is removed and other profiles are left intact.  When no\n# profile is supplied, the entire build/ directory is removed, matching the\n# existing clean behavior.  Object files associated with the selected scope\n# are also removed.\nclean_package() {\n    local name="$1"\n    local profile="${2:-}"\n    if [[ -n "$profile" && "$profile" != "debug" && "$profile" != "release" ]]; then\n        log_error "Invalid profile: $profile"\n        return 1\n    fi\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$name")\n\n    if [[ -z "$profile" ]]; then\n        if [[ -d "$pkg_dir/build" ]]; then\n            rm -rf "$pkg_dir/build"\n            log_info "Cleaned $name (all profiles)"\n        fi\n        find "$pkg_dir/src" -name "*.o" -delete 2>/dev/null || true\n        return 0\n    fi\n\n    if [[ -d "$pkg_dir/build/$profile" ]]; then\n        rm -rf "$pkg_dir/build/$profile"\n        log_info "Cleaned $name ($profile)"\n    fi\n    if [[ -d "$pkg_dir/build" ]] && [[ -z "$(find "$pkg_dir/build" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then\n        rmdir "$pkg_dir/build" 2>/dev/null || true\n    fi\n\n    # Remove object files for the selected profile.  Makefile builds store\n    # objects under build/<profile>; this also handles legacy src-based *.o\n    # layouts that encode the profile in the filename or path.\n    find "$pkg_dir/src" -name "*.${profile}.o" -delete 2>/dev/null || true\n    find "$pkg_dir/src" -path "*/$profile/*" -name "*.o" -delete 2>/dev/null || true\n}\'\'\'\nif old not in s:\n    raise SystemExit("common.sh clean_package block not found")\ns = s.replace(old, new)\np.write_text(s)\n\n# Patch forge: cmd_clean should default to no profile and only scope when --profile is supplied.\np = Path("forge")\ns = p.read_text()\nold = \'\'\'cmd_clean() {\n    local target="" pkg="" profile="release"\n    while [[ $# -gt 0 ]]; do\n        case "$1" in\n            --all) target="all" ;;\n            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;\n            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;\n            *) usage; return 1 ;;\n        esac\n        shift\n    done\n\n    validate_profile "$profile" || return 1\n\n    if [[ "$target" == "all" ]]; then\n        for pkg_name in $(list_package_names); do\n            clean_package "$pkg_name" "$profile"\n        done\n        clean_cache "$profile"\n        log_info "All packages cleaned ($profile)"\n    elif [[ "$target" == "package" ]]; then\n        clean_package "$pkg" "$profile"\n        invalidate_cache "$pkg" "$profile"\n    else\n        usage\n        return 1\n    fi\n}\'\'\'\nnew = \'\'\'cmd_clean() {\n    local target="" pkg="" profile=""\n    while [[ $# -gt 0 ]]; do\n        case "$1" in\n            --all) target="all" ;;\n            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;\n            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;\n            *) usage; return 1 ;;\n        esac\n        shift\n    done\n\n    if [[ -n "$profile" ]]; then\n        validate_profile "$profile" || return 1\n    fi\n\n    if [[ "$target" == "all" ]]; then\n        for pkg_name in $(list_package_names); do\n            clean_package "$pkg_name" "$profile"\n        done\n        clean_cache "$profile"\n        if [[ -n "$profile" ]]; then\n            log_info "All packages cleaned ($profile)"\n        else\n            log_info "All packages cleaned (all profiles)"\n        fi\n    elif [[ "$target" == "package" ]]; then\n        clean_package "$pkg" "$profile"\n        invalidate_cache "$pkg" "$profile"\n    else\n        usage\n        return 1\n    fi\n}\'\'\'\nif old not in s:\n    raise SystemExit("forge cmd_clean block not found")\ns = s.replace(old, new)\np.write_text(s)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
