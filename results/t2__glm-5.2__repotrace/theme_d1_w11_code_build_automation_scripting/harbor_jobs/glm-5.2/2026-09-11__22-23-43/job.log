 "${MANIFEST_tags:-}"\nassert_eq "inline comment stripped" "value" "${MANIFEST_notes:-}"\nassert_eq "empty value parsed" "" "${MANIFEST_empty:-}"\nrm -rf "$tmp_manifest_root"\n\n# ==================================================================\necho ""\necho "=== Dependency Graph Tests ==="\n\nbuild_dep_map\norder=$(resolve_build_order)\npkg_count=$(echo "$order" | wc -w)\nassert_eq "build order has 8 packages" "8" "$pkg_count"\n\nassert_contains "order contains libbase" "$order" "libbase"\nassert_contains "order contains svc-scheduler" "$order" "svc-scheduler"\n\nposition() {\n    local target="$1" i=0\n    for pkg in $order; do\n        ((i++))\n        [[ "$pkg" == "$target" ]] && { echo "$i"; return; }\n    done\n    echo 0\n}\n\nlibbase_pos=$(position libbase)\nlibcrypto_pos=$(position libcrypto)\nlibstore_pos=$(position libstore)\nlibnet_pos=$(position libnet)\nsvc_auth_pos=$(position svc-auth)\nsvc_scheduler_pos=$(position svc-scheduler)\n\nassert_eq "libbase before libcrypto" "1" "$(( libbase_pos < libcrypto_pos ? 1 : 0 ))"\nassert_eq "libbase before libstore" "1" "$(( libbase_pos < libstore_pos ? 1 : 0 ))"\nassert_eq "libcrypto before libstore" "1" "$(( libcrypto_pos < libstore_pos ? 1 : 0 ))"\nassert_eq "libbase before libnet" "1" "$(( libbase_pos < libnet_pos ? 1 : 0 ))"\nassert_eq "libstore before svc-auth" "1" "$(( libstore_pos < svc_auth_pos ? 1 : 0 ))"\nassert_eq "libnet before svc-scheduler" "1" "$(( libnet_pos < svc_scheduler_pos ? 1 : 0 ))"\n\ndeps_for_auth=$(resolve_deps_for "svc-auth")\nassert_contains "svc-auth deps include libcrypto" "$deps_for_auth" "libcrypto"\nassert_contains "svc-auth deps include libstore" "$deps_for_auth" "libstore"\nassert_contains "svc-auth deps include transitive libbase" "$deps_for_auth" "libbase"\nassert_contains "svc-auth deps include itself" "$deps_for_auth" "svc-auth"\nassert_eq "svc-auth chain has 4 packages" "4" "$(echo "$deps_for_auth" | wc -w)"\n\nassert_eq "libbase no-dependency chain" "libbase" "$(resolve_deps_for libbase)"\n\nall_deps=$(get_all_deps svc-scheduler)\nassert_contains "all deps includes libbase" "$all_deps" "libbase"\nassert_contains "all deps includes libcrypto" "$all_deps" "libcrypto"\nassert_contains "all deps includes libnet" "$all_deps" "libnet"\nassert_contains "all deps includes libstore" "$all_deps" "libstore"\nassert_not_contains "all deps excludes package itself" "$all_deps" "svc-scheduler"\n\n# Cycle detection\ntmp_cycle_root=$(mktemp -d)\nmkdir -p "$tmp_cycle_root/packages/cyc-a" "$tmp_cycle_root/packages/cyc-b"\ncat > "$tmp_cycle_root/packages/cyc-a/package.forge" <<\'MANIFEST\'\n[package]\nname = cyc-a\nversion = 1.0.0\ntype = library\n\n[deps]\ndeps = cyc-b\nMANIFEST\ncat > "$tmp_cycle_root/packages/cyc-b/package.forge" <<\'MANIFEST\'\n[package]\nname = cyc-b\nversion = 1.0.0\ntype = library\n\n[deps]\ndeps = cyc-a\nMANIFEST\n\ncycle_err=$(with_forge_root "$tmp_cycle_root" resolve_build_order 2>&1 >/dev/null) || true\nassert_contains "cycle error mentions cyc-a" "$cycle_err" "cyc-a"\nassert_contains "cycle error mentions cyc-b" "$cycle_err" "cyc-b"\nassert_contains "cycle error says circular" "$cycle_err" "Circular dependency detected"\nassert_exit_nonzero "resolve_deps_for cycle fails" with_forge_root "$tmp_cycle_root" resolve_deps_for cyc-a\nrm -rf "$tmp_cycle_root"\n\n# Unknown dependency\ntmp_unknown_root=$(mktemp -d)\nmkdir -p "$tmp_unknown_root/packages/pkg-x"\ncat > "$tmp_unknown_root/packages/pkg-x/package.forge" <<\'MANIFEST\'\n[package]\nname = pkg-x\nversion = 1.0.0\ntype = library\n\n[deps]\ndeps = missing-dep\nMANIFEST\n\nunknown_err=$(with_forge_root "$tmp_unknown_root" resolve_build_order 2>&1 >/dev/null) || true\nassert_contains "unknown dep error names missing package" "$unknown_err" "missing-dep"\nassert_exit_nonzero "resolve_deps_for unknown dep fails" with_forge_root "$tmp_unknown_root" resolve_deps_for pkg-x\nrm -rf "$tmp_unknown_root"\n\n# Reset dep map after temporary root tests\nbuild_dep_map\n\n# ==================================================================\necho ""\necho "=== Cache Tests ==="\n\nclean_cache\nassert_exit_nonzero "cache invalid for unbuilt pkg" is_cache_valid libbase\n\nupdate_cache "libbase"\nassert_exit_zero "cache valid after update" is_cache_valid libbase\n\n# Source modification invalidates cache.  Cache stamps are second-granular,\n# so advance time before touching sources.\nupdate_cache "libbase"\nsleep 1\nfind "$FORGE_ROOT/packages/libbase/src" -type f -exec touch {} +\nassert_exit_nonzero "cache invalid after source modification" is_cache_valid libbase\nclean_cache\n\n# Transitive cache invalidation\nupdate_cache "libbase"\nupdate_cache "libcrypto"\nassert_exit_zero "libcrypto valid when dependency older" is_cache_valid libcrypto\ncrypto_stamp=$(cat "$FORGE_CACHE_DIR/libcrypto.stamp")\necho $((crypto_stamp + 5)) > "$FORGE_CACHE_DIR/libbase.stamp"\nassert_exit_nonzero "libcrypto invalid when dependency rebuilt" is_cache_valid libcrypto\nclean_cache\n\n# Cache cleanup removes stamps\nupdate_cache "libbase"\nclean_cache\nassert_exit_nonzero "cache invalid after clean_cache" is_cache_valid libbase\n\n# Temporary package source timestamp test\ntmp_cache_root=$(mktemp -d)\nmkdir -p "$tmp_cache_root/packages/pkg-cache/src"\ncat > "$tmp_cache_root/packages/pkg-cache/package.forge" <<\'MANIFEST\'\n[package]\nname = pkg-cache\nversion = 1.0.0\ntype = library\nMANIFEST\ncat > "$tmp_cache_root/packages/pkg-cache/Makefile" <<\'MAKEFILE\'\nall:\n\t@mkdir -p build\n\t@true\nclean:\n\trm -rf build\nMAKEFILE\necho \'int main(void) { return 0; }\' > "$tmp_cache_root/packages/pkg-cache/src/main.c"\n\nassert_exit_nonzero "temp cache invalid before build" with_forge_root "$tmp_cache_root" is_cache_valid pkg-cache\nwith_forge_root "$tmp_cache_root" update_cache pkg-cache\nassert_exit_zero "temp cache valid after update" with_forge_root "$tmp_cache_root" is_cache_valid pkg-cache\nsleep 1\ntouch "$tmp_cache_root/packages/pkg-cache/src/main.c"\nassert_exit_nonzero "temp cache invalid after source touch" with_forge_root "$tmp_cache_root" is_cache_valid pkg-cache\nrm -rf "$tmp_cache_root"\nclean_cache\n\n# ==================================================================\necho ""\necho "=== Builder Tests ==="\n\nbuild_dep_map\nsetup_build_env svc-scheduler\ncflags="$FORGE_CFLAGS"\nldflags="$FORGE_LDFLAGS"\nlibs="$FORGE_LIBS"\n\nassert_contains "cflags includes direct libstore" "$cflags" "-I$FORGE_ROOT/packages/libstore/src"\nassert_contains "cflags includes direct libnet" "$cflags" "-I$FORGE_ROOT/packages/libnet/src"\nassert_contains "cflags includes direct libcrypto" "$cflags" "-I$FORGE_ROOT/packages/libcrypto/src"\nassert_contains "cflags includes transitive libbase" "$cflags" "-I$FORGE_ROOT/packages/libbase/src"\nassert_contains "ldflags includes transitive libbase" "$ldflags" "-L$FORGE_ROOT/packages/libbase/build"\nassert_contains "libs includes direct libstore" "$libs" "libstore.a"\nassert_contains "libs includes transitive libbase" "$libs" "libbase.a"\nassert_contains "libs includes direct libcrypto" "$libs" "libcrypto.a"\n\nsetup_build_env svc-auth\nauth_cflags="$FORGE_CFLAGS"\nassert_contains "svc-auth cflags includes transitive libbase" "$auth_cflags" "-I$FORGE_ROOT/packages/libbase/src"\nassert_contains "svc-auth cflags includes libcrypto" "$auth_cflags" "-I$FORGE_ROOT/packages/libcrypto/src"\nassert_contains "svc-auth cflags includes libstore" "$auth_cflags" "-I$FORGE_ROOT/packages/libstore/src"\n\nclean_cache\nclean_package libbase\nassert_exit_zero "build libbase" build_package libbase\nassert_exit_zero "cache valid after build" is_cache_valid libbase\nassert_exit_zero "cached build skips rebuild" build_package libbase\nclean_package libbase\nclean_cache\n\n# ==================================================================\necho ""\necho "=== Artifact Tests ==="\n\nfor pkg in $(list_package_names); do clean_package "$pkg"; done\nclean_cache\nrm -rf "$FORGE_ROOT/artifacts"\n\nbuild_chain() {\n    local target="$1" pkg\n    for pkg in $(resolve_deps_for "$target"); do\n        if ! build_package "$pkg" > /dev/null 2>&1; then\n            return 1\n        fi\n    done\n    return 0\n}\n\nassert_exit_zero "build libcrypto chain" build_chain libcrypto\n\nlibbase_version=$(get_manifest_value libbase version)\nresult=$(pack_artifact libbase 2>/dev/null)\nassert_contains "libbase artifact path returned" "$result" "libbase-1.0.0.tar.gz"\nassert_contains "artifact version matches manifest" "$result" "libbase-${libbase_version}.tar.gz"\n\ntmp_extract=$(mktemp -d)\ntar -xzf "$result" -C "$tmp_extract"\nassert_exit_zero "libbase deps.manifest exists" test -f "$tmp_extract/build/deps.manifest"\nassert_eq "libbase deps.manifest empty" "" "$(cat "$tmp_extract/build/deps.manifest")"\nrm -rf "$tmp_extract"\n\nlibcrypto_version=$(get_manifest_value libcrypto version)\nresult=$(pack_artifact libcrypto 2>/dev/null)\nassert_contains "libcrypto artifact path returned" "$result" "libcrypto-1.2.0.tar.gz"\nassert_contains "libcrypto artifact version matches manifest" "$result" "libcrypto-${libcrypto_version}.tar.gz"\n\ntmp_extract=$(mktemp -d)\ntar -xzf "$result" -C "$tmp_extract"\nassert_exit_zero "libcrypto deps.manifest exists" test -f "$tmp_extract/build/deps.manifest"\nassert_contains "libcrypto deps.manifest has libbase version" "$(cat "$tmp_extract/build/deps.manifest")" "libbase=1.0.0"\nassert_eq "libcrypto deps.manifest has one line" "1" "$(wc -l < "$tmp_extract/build/deps.manifest")"\nrm -rf "$tmp_extract"\n\nassert_exit_nonzero "artifact fails without build dir" pack_artifact svc-gateway\n\nfor pkg in $(list_package_names); do clean_package "$pkg"; done\nrm -rf "$FORGE_ROOT/artifacts"\nclean_cache\n\n# ==================================================================\necho ""\necho "=== Config Generator Tests ==="\n\nrm -rf "$FORGE_ROOT/generated"\nassert_exit_zero "generate staging config" generate_config staging\n\ndeploy_out=$(cat "$FORGE_ROOT/generated/deploy.yaml")\nmonitor_out=$(cat "$FORGE_ROOT/generated/monitor.json")\nassert_contains "deploy config has env" "$deploy_out" "environment: staging"\nassert_contains "deploy config has host" "$deploy_out" "staging.internal"\nassert_contains "nested region staging resolved" "$deploy_out" "region: us-west-2"\nassert_contains "nested worker port staging resolved" "$deploy_out" "port: 9090"\nassert_contains "nested db host staging resolved" "$deploy_out" "host: db-staging.internal"\nassert_contains "nested db name staging resolved" "$deploy_out" "name: forgekit_staging"\nassert_not_contains "deploy config has no unresolved refs" "$deploy_out" \'${\'\nassert_contains "monitor nested worker port resolved" "$monitor_out" ":9090"\nassert_not_contains "monitor config has no unresolved refs" "$monitor_out" \'${\'\n\nassert_exit_zero "generate production config" generate_config production\ndeploy_prod=$(cat "$FORGE_ROOT/generated/deploy.yaml")\nmonitor_prod=$(cat "$FORGE_ROOT/generated/monitor.json")\nassert_contains "production deploy host" "$deploy_prod" "prod.internal"\nassert_contains "nested region production resolved" "$deploy_prod" "region: us-east-1"\nassert_contains "nested worker port production resolved" "$deploy_prod" "port: 9443"\nassert_contains "nested db name production resolved" "$deploy_prod" "name: forgekit_prod"\nassert_contains "production alert channel" "$monitor_prod" "ops-production"\nassert_not_contains "production deploy has no unresolved refs" "$deploy_prod" \'${\'\n\nassert_exit_zero "missing environment config still generates" generate_config badenv\ndeploy_bad=$(cat "$FORGE_ROOT/generated/deploy.yaml")\nassert_contains "missing env uses ENV value" "$deploy_bad" "environment: badenv"\nassert_contains "missing env leaves unknown refs" "$deploy_bad" \'${DEPLOY_HOST}\'\n\ncat > "$FORGE_ROOT/templates/_tmp_nested.tpl" <<\'NESTED_TPL\'\nregion=${REGION_${ENV}}\nport=${WORKER_PORT_${ENV}}\nNESTED_TPL\nassert_exit_zero "generate config with temporary nested template" generate_config staging\ntmp_nested=$(cat "$FORGE_ROOT/generated/_tmp_nested")\nassert_grep "temporary nested region resolved" "$tmp_nested" \'^region=us-west-2$\'\nassert_grep "temporary nested port resolved" "$tmp_nested" \'^port=9090$\'\nrm -f "$FORGE_ROOT/templates/_tmp_nested.tpl" "$FORGE_ROOT/generated/_tmp_nested"\nrm -rf "$FORGE_ROOT/generated"\n\n# ==================================================================\necho ""\necho "=== Reporter Tests ==="\n\nclean_cache\nfor pkg in $(list_package_names); do clean_package "$pkg"; done\n\nreport_out=$(generate_report)\nassert_contains "report has header" "$report_out" "ForgeKit Build Report"\nassert_contains "report lists libbase" "$report_out" "libbase"\nassert_grep "long package name not truncated" "$report_out" \'^svc-scheduler \'\nassert_grep "svc-gateway aligned" "$report_out" \'^svc-gateway \'\nassert_contains "report shows pending status" "$report_out" "pending"\n\nupdate_cache libbase\nreport_out=$(generate_report)\nassert_contains "report shows cached yes" "$report_out" "yes"\nclean_cache\n\n# ==================================================================\necho ""\necho "=== Summary ==="\necho "Total: $TOTAL | Passed: $PASSED | Failed: $FAILED"\n\n# Final cleanup\nrm -rf "$FORGE_ROOT/artifacts" "$FORGE_ROOT/generated" "$FORGE_ROOT/.forge_cache"\nfor pkg in $(list_package_names); do clean_package "$pkg"; done\n\nif [[ $FAILED -gt 0 ]]; then\n    exit 1\nfi\nexit 0\nTESTSUITE_EOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
