Sending keys: ['cat > lib/manifest.sh <<\'EOF\'\n#!/bin/bash\n# Manifest parser for .forge package files\n#\n# Format:\n#   [section]\n#   key = value\n#   # comments\n#   key = long value \\\n#         continued on next line\n#\n# All parsed values are exported as MANIFEST_<key>=<value>\n\nparse_manifest() {\n    local pkg_name="$1"\n    local manifest_file\n    manifest_file=$(get_package_manifest "$pkg_name")\n\n    if [[ ! -f "$manifest_file" ]]; then\n        log_error "Manifest not found: $manifest_file"\n        return 1\n    fi\n\n    # Clear previous manifest data\n    local var\n    for var in $(compgen -v MANIFEST_ 2>/dev/null || true); do\n        unset "$var"\n    done\n\n    local current_section=""\n    local line key value next_line\n\n    while IFS= read -r line || [[ -n "$line" ]]; do\n        # Skip empty lines and comments\n        [[ "$line" =~ ^[[:space:]]*$ ]] && continue\n        [[ "$line" =~ ^[[:space:]]*# ]] && continue\n\n        # Section header\n        if [[ "$line" =~ ^\\[([a-zA-Z_][a-zA-Z0-9_]*)\\] ]]; then\n            current_section="${BASH_REMATCH[1]}"\n            continue\n        fi\n\n        # Key = value pair\n        if [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then\n            key="${BASH_REMATCH[1]}"\n            value="${BASH_REMATCH[2]}"\n\n            # Trim trailing whitespace from value\n            value="${value%"${value##*[![:space:]]}"}"\n\n            # Handle backslash line continuation.  A trailing backslash joins\n            # the next line; the backslash and leading whitespace on the\n            # continuation line are stripped.\n            while [[ "$value" == *\\\\ ]]; do\n                value="${value%\\\\}"\n                if IFS= read -r next_line || [[ -n "$next_line" ]]; then\n                    next_line="${next_line#"${next_line##*[![:space:]]}"}"\n                    next_line="${next_line%"${next_line##*[![:space:]]}"}"\n                    value="$value$next_line"\n                else\n                    break\n                fi\n            done\n\n            export "MANIFEST_${key}=${value}"\n        fi\n    done < "$manifest_file"\n}\n\n# Convenience: parse and return a single value\nget_manifest_value() {\n    local pkg_name="$1"\n    local key="$2"\n    if ! parse_manifest "$pkg_name"; then\n        return 1\n    fi\n    local var="MANIFEST_${key}"\n    echo "${!var:-}"\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > lib/depgraph.sh <<\'EOF\'\n#!/bin/bash\n# Dependency graph resolution for ForgeKit\n#\n# Provides topological-sort-based build ordering and\n# dependency tree queries.\n\n# Build an associative array mapping package -> comma-separated deps\nbuild_dep_map() {\n    declare -gA DEP_MAP\n    # Reset\n    local k\n    for k in "${!DEP_MAP[@]}"; do unset "DEP_MAP[$k]"; done\n\n    local pkg_name deps_str\n    for pkg_name in $(list_package_names); do\n        parse_manifest "$pkg_name"\n        deps_str="${MANIFEST_deps:-}"\n        DEP_MAP[$pkg_name]="$deps_str"\n    done\n}\n\n# Shared DFS helper.  Callers must declare local:\n#   declare -A _state\n#   declare -a _path\n#   local _order=""\n_forge_graph_dfs() {\n    local node="$1"\n\n    if [[ -z "${DEP_MAP[$node]+_}" ]]; then\n        log_error "Unknown package in dependency graph: $node"\n        return 1\n    fi\n\n    case "${_state[$node]:-}" in\n        done)\n            return 0\n            ;;\n        visiting)\n            local cycle="" in_cycle=0 p\n            for p in "${_path[@]}"; do\n                if [[ "$p" == "$node" ]]; then\n                    in_cycle=1\n                fi\n                if (( in_cycle )); then\n                    cycle="$cycle $p"\n                fi\n            done\n            cycle="$cycle $node"\n            cycle="${cycle# }"\n            log_error "Circular dependency detected: $(echo "$cycle" | sed \'s/ / -> /g\')"\n            return 1\n            ;;\n    esac\n\n    _state[$node]=visiting\n    _path+=("$node")\n\n    local deps="${DEP_MAP[$node]:-}"\n    if [[ -n "$deps" ]]; then\n        local IFS=\',\'\n        for dep in $deps; do\n            dep="${dep// /}"\n            [[ -z "$dep" ]] && continue\n            if ! _forge_graph_dfs "$dep"; then\n                return 1\n            fi\n        done\n    fi\n\n    _state[$node]=done\n    _order="$_order $node"\n\n    if ((${#_path[@]} > 0)); then\n        _path=("${_path[@]:0:${#_path[@]}-1}")\n    fi\n    return 0\n}\n\n# -------------------------------------------------------------------\n# Topological sort via DFS with cycle detection.\n# -------------------------------------------------------------------\nresolve_build_order() {\n    build_dep_map\n\n    declare -A _state\n    declare -a _path\n    local _order=""\n\n    for pkg in $(list_package_names); do\n        if ! _forge_graph_dfs "$pkg"; then\n            return 1\n        fi\n    done\n\n    echo "$_order"\n}\n\n# Resolve the build chain for a single target (inclusive)\nresolve_deps_for() {\n    local target="$1"\n    build_dep_map\n\n    if [[ -z "${DEP_MAP[$target]+_}" ]]; then\n        log_error "Unknown package: $target"\n        return 1\n    fi\n\n    declare -A _state\n    declare -a _path\n    local _order=""\n\n    if ! _forge_graph_dfs "$target"; then\n        return 1\n    fi\n\n    echo "$_order"\n}\n\n# Pretty-print the dependency tree (recursive, indented)\nshow_dep_tree() {\n    local name="$1"\n    local indent="${2:-0}"\n    local seen="${3:-}"\n\n    # Ensure the dep map exists\n    if [[ -z "${DEP_MAP[*]+_}" ]]; then\n        build_dep_map\n    fi\n\n    if [[ " $seen " == *" $name "* ]]; then\n        local prefix=""\n        local i\n        for ((i = 0; i < indent; i++)); do prefix="$prefix  "; done\n        echo "${prefix}${name} (cycle)"\n        log_warn "Circular dependency detected at $name"\n        return 1\n    fi\n    seen="$seen $name"\n\n    local prefix=""\n    for ((i = 0; i < indent; i++)); do prefix="$prefix  "; done\n\n    echo "${prefix}${name}"\n\n    local deps="${DEP_MAP[$name]:-}"\n    if [[ -n "$deps" ]]; then\n        local IFS=\',\'\n        for dep in $deps; do\n            dep="${dep// /}"\n            [[ -z "$dep" ]] && continue\n            show_dep_tree "$dep" $((indent + 1)) "$seen" || true\n        done\n    fi\n}\n\n# Return all transitive dependencies (not including the package itself)\nget_all_deps() {\n    local name="$1"\n    if [[ -z "${DEP_MAP[*]+_}" ]]; then\n        build_dep_map\n    fi\n\n    declare -A _seen\n    local _result=""\n\n    _collect_deps() {\n        local node="$1"\n        local deps="${DEP_MAP[$node]:-}"\n        if [[ -n "$deps" ]]; then\n            local IFS=\',\'\n            for dep in $deps; do\n                dep="${dep// /}"\n                [[ -z "$dep" ]] && continue\n                if [[ -z "${_seen[$dep]:-}" ]]; then\n                    _seen[$dep]=1\n                    _result="$_result $dep"\n                    _collect_deps "$dep"\n                fi\n            done\n        fi\n    }\n\n    _collect_deps "$name"\n    echo "$_result"\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > lib/cache.sh <<\'EOF\'\n#!/bin/bash\n# Build cache management for ForgeKit\n#\n# Uses timestamp-based caching: each package records a "last built"\n# timestamp; a rebuild is triggered when source files are newer or\n# when a transitive dependency has been rebuilt more recently.\n\nFORGE_CACHE_DIR="${FORGE_ROOT}/.forge_cache"\n\ninit_cache() {\n    mkdir -p "$FORGE_CACHE_DIR"\n}\n\n# Newest mtime among all files under a package\'s src/ directory\nget_src_mtime() {\n    local pkg_name="$1"\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$pkg_name")\n\n    local latest=0\n    local mtime\n    while IFS= read -r -d \'\' file; do\n        mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)\n        if (( mtime > latest )); then\n            latest=$mtime\n        fi\n    done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)\n\n    # Also check Makefile\n    if [[ -f "$pkg_dir/Makefile" ]]; then\n        mtime=$(stat -c %Y "$pkg_dir/Makefile" 2>/dev/null || echo 0)\n        if (( mtime > latest )); then\n            latest=$mtime\n        fi\n    fi\n\n    echo "$latest"\n}\n\n# Check whether the cached build is still valid.\n#\n# A package is invalid if:\n#   - it has no cache stamp\n#   - its own sources/Makefile are newer than its cache stamp\n#   - any transitive dependency has no cache stamp\n#   - any transitive dependency has a cache stamp newer than this package\'s\nis_cache_valid() {\n    local pkg_name="$1"\n    init_cache\n    local cache_file="$FORGE_CACHE_DIR/${pkg_name}.stamp"\n\n    if [[ ! -f "$cache_file" ]]; then\n        return 1  # No cache -> rebuild\n    fi\n\n    local cached_time\n    cached_time=$(cat "$cache_file" 2>/dev/null || echo 0)\n    if [[ ! "$cached_time" =~ ^[0-9]+$ ]]; then\n        return 1\n    fi\n\n    local src_mtime\n    src_mtime=$(get_src_mtime "$pkg_name")\n\n    if (( src_mtime > cached_time )); then\n        return 1  # Source newer than cache -> rebuild\n    fi\n\n    # Invalidate when transitive dependencies were rebuilt more recently.\n    local deps\n    deps=$(get_all_deps "$pkg_name") || return 1\n    local dep dep_cache_file dep_time\n    for dep in $deps; do\n        [[ -z "$dep" ]] && continue\n        dep_cache_file="$FORGE_CACHE_DIR/${dep}.stamp"\n        if [[ ! -f "$dep_cache_file" ]]; then\n            return 1\n        fi\n        dep_time=$(cat "$dep_cache_file" 2>/dev/null || echo 0)\n        if [[ ! "$dep_time" =~ ^[0-9]+$ ]]; then\n            return 1\n        fi\n        if (( dep_time > cached_time )); then\n            return 1\n        fi\n    done\n\n    return 0  # Cache is valid\n}\n\n# Record the current time as the build timestamp for a package\nupdate_cache() {\n    local pkg_name="$1"\n    init_cache\n    date +%s > "$FORGE_CACHE_DIR/${pkg_name}.stamp"\n}\n\n# Remove cache entry for a package\ninvalidate_cache() {\n    local pkg_name="$1"\n    rm -f "$FORGE_CACHE_DIR/${pkg_name}.stamp"\n}\n\n# Wipe the entire cache directory\nclean_cache() {\n    rm -rf "$FORGE_CACHE_DIR"\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > lib/builder.sh <<\'EOF\'\n#!/bin/bash\n# Build executor for ForgeKit\n#\n# Builds packages by running their Makefile in the correct environment.\n\n# Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.\n# Includes include and library paths for the full transitive dependency\n# closure, not just direct dependencies.\nsetup_build_env() {\n    local pkg_name="$1"\n    parse_manifest "$pkg_name"\n\n    local cflags=""\n    local ldflags=""\n    local libs=""\n    local deps\n\n    deps=$(get_all_deps "$pkg_name") || return 1\n\n    declare -A seen\n    local dep dep_dir\n    for dep in $deps; do\n        [[ -z "$dep" ]] && continue\n        [[ -n "${seen[$dep]:-}" ]] && continue\n        seen[$dep]=1\n\n        dep_dir=$(get_package_dir "$dep")\n        cflags="$cflags -I${dep_dir}/src"\n        ldflags="$ldflags -L${dep_dir}/build"\n\n        # For services linking against libraries\n        parse_manifest "$dep"\n        if [[ "${MANIFEST_type:-}" == "library" ]]; then\n            libs="$libs ${dep_dir}/build/${dep}.a"\n        fi\n    done\n\n    export FORGE_CFLAGS="$cflags"\n    export FORGE_LDFLAGS="$ldflags"\n    export FORGE_LIBS="$libs"\n}\n\n# Build a single package\nbuild_package() {\n    local pkg_name="$1"\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$pkg_name")\n\n    if [[ ! -d "$pkg_dir" ]]; then\n        log_error "Package directory not found: $pkg_dir"\n        return 1\n    fi\n\n    # Check cache\n    if is_cache_valid "$pkg_name" 2>/dev/null; then\n        log_info "[$pkg_name] Up to date (cached)"\n        return 0\n    fi\n\n    log_info "[$pkg_name] Building..."\n\n    # Parse manifest for build command\n    parse_manifest "$pkg_name"\n    local build_cmd="${MANIFEST_command:-make}"\n\n    # Set up build environment\n    if ! setup_build_env "$pkg_name"; then\n        log_error "[$pkg_name] Failed to set up build environment"\n        return 1\n    fi\n\n    # Execute build\n    if ! (cd "$pkg_dir" && eval "$build_cmd" 2>&1); then\n        log_error "[$pkg_name] Build failed"\n        return 1\n    fi\n\n    # Update cache\n    update_cache "$pkg_name"\n\n    log_info "[$pkg_name] Build successful"\n    return 0\n}\n\n# Run tests for a single package\ntest_package() {\n    local pkg_name="$1"\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$pkg_name")\n\n    parse_manifest "$pkg_name"\n    local test_cmd="${MANIFEST_test_command:-make test}"\n\n    if ! setup_build_env "$pkg_name"; then\n        log_error "[$pkg_name] Failed to set up build environment"\n        return 1\n    fi\n\n    log_info "[$pkg_name] Running tests..."\n    if ! (cd "$pkg_dir" && eval "$test_cmd" 2>&1); then\n        log_error "[$pkg_name] Tests failed"\n        return 1\n    fi\n\n    log_info "[$pkg_name] Tests passed"\n    return 0\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > lib/artifact.sh <<\'EOF\'\n#!/bin/bash\n# Artifact packaging for ForgeKit\n\npack_artifact() {\n    local pkg_name="$1"\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$pkg_name")\n\n    parse_manifest "$pkg_name"\n    local version="${MANIFEST_version:-0.0.0}"\n\n    local build_dir="$pkg_dir/build"\n    if [[ ! -d "$build_dir" ]]; then\n        log_error "Build directory not found for $pkg_name. Run \'forge build\' first."\n        return 1\n    fi\n\n    local artifact_dir="$FORGE_ROOT/artifacts"\n    mkdir -p "$artifact_dir"\n\n    local artifact_name="${pkg_name}-${version}.tar.gz"\n\n    # Generate dependency metadata inside the packaged build directory.\n    # Direct dependencies only, as <dep_name>=<dep_version> per line.\n    local deps_manifest="$build_dir/deps.manifest"\n    : > "$deps_manifest"\n\n    local deps="${MANIFEST_deps:-}"\n    if [[ -n "$deps" ]]; then\n        local IFS=\',\'\n        local dep dep_version\n        for dep in $deps; do\n            dep="${dep// /}"\n            [[ -z "$dep" ]] && continue\n            dep_version=$(get_manifest_value "$dep" "version") || return 1\n            printf \'%s=%s\\n\' "$dep" "$dep_version" >> "$deps_manifest"\n        done\n    fi\n\n    tar -czf "$artifact_dir/$artifact_name" \\\n        -C "$pkg_dir" \\\n        build/ 2>/dev/null\n\n    if [[ $? -ne 0 ]]; then\n        log_error "Failed to create artifact for $pkg_name"\n        return 1\n    fi\n\n    log_info "Packed artifact: $artifact_name -> $artifact_dir/$artifact_name"\n    echo "$artifact_dir/$artifact_name"\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > lib/configgen.sh <<\'EOF\'\n#!/bin/bash\n# Deployment config generator for ForgeKit\n#\n# Processes template files (*.tpl) by substituting ${VAR} references\n# with values from environment-specific config files and built-in vars.\n\n# Resolve ${VAR} references iteratively, including nested references such\n# as ${REGION_${ENV}}.  Flat references are resolved first, then the\n# process repeats until no further substitution occurs or the maximum\n# depth is reached.  Unknown references are left unchanged.\n_config_resolve_vars() {\n    local content="$1"\n    local max_depth=100\n    local depth=0\n    local prev\n    local var_name\n\n    while (( depth < max_depth )); do\n        prev="$content"\n        for var_name in "${!config_vars[@]}"; do\n            content="${content//\\$\\{${var_name}\\}/${config_vars[$var_name]}}"\n        done\n        [[ "$content" == "$prev" ]] && break\n        ((depth++))\n    done\n\n    printf \'%s\' "$content"\n}\n\ngenerate_config() {\n    local env="$1"\n    local template_dir="$FORGE_ROOT/templates"\n\n    if [[ ! -d "$template_dir" ]]; then\n        log_error "Templates directory not found: $template_dir"\n        return 1\n    fi\n\n    # Build variable map -----------------------------------------------\n    declare -A config_vars\n    config_vars[ENV]="$env"\n    config_vars[FORGE_ROOT]="$FORGE_ROOT"\n    config_vars[TIMESTAMP]="$(date -u +%Y%m%dT%H%M%SZ)"\n\n    # Load environment-specific config if it exists\n    local env_conf="$FORGE_ROOT/config/${env}.conf"\n    if [[ -f "$env_conf" ]]; then\n        local key value\n        while IFS=\'=\' read -r key value; do\n            [[ "$key" =~ ^[[:space:]]*# ]] && continue\n            [[ -z "$key" ]] && continue\n            key=$(echo "$key" | tr -d \'[:space:]\')\n            value=$(echo "$value" | sed \'s/^[[:space:]]*//\' | sed \'s/[[:space:]]*$//\')\n            config_vars[$key]="$value"\n        done < "$env_conf"\n    fi\n\n    # Inject per-package version variables\n    local pkg_name safe_name\n    for pkg_name in $(list_package_names); do\n        parse_manifest "$pkg_name"\n        safe_name="${pkg_name//-/_}"\n        config_vars["VERSION_${safe_name}"]="${MANIFEST_version:-0.0.0}"\n    done\n\n    # Process each template file ---------------------------------------\n    mkdir -p "$FORGE_ROOT/generated"\n\n    local tpl outname outfile content\n    for tpl in "$template_dir"/*.tpl; do\n        [[ -f "$tpl" ]] || continue\n        outname=$(basename "$tpl" .tpl)\n        outfile="$FORGE_ROOT/generated/${outname}"\n\n        content=$(cat "$tpl")\n        content=$(_config_resolve_vars "$content")\n\n        echo "$content" > "$outfile"\n        log_info "Generated config: $outfile"\n    done\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
