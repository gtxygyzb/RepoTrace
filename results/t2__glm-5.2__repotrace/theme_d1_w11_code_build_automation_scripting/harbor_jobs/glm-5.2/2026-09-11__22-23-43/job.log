dep in "${dep_array[@]}"; do\n                dep="${dep// /}"\n                [[ -z "$dep" ]] && continue\n                if [[ -n "${in_set[$dep]:-}" ]]; then\n                    dep_count=$(( dep_count + 1 ))\n                fi\n            done\n        fi\n        remaining_deps[$pkg]=$dep_count\n        done_pkg[$pkg]=0\n    done\n\n    local order=""\n    local remaining_count=$#\n    local best best_key dep_total key dependent dep_dep\n\n    while (( remaining_count > 0 )); do\n        best=""\n        best_key=""\n        for pkg in "$@"; do\n            if [[ "${done_pkg[$pkg]:-}" == "0" ]] && (( remaining_deps[$pkg] == 0 )); then\n                deps_str="${DEP_MAP[$pkg]:-}"\n                dep_total=0\n                if [[ -n "$deps_str" ]]; then\n                    IFS=\',\' read -ra dep_array <<< "$deps_str"\n                    for dep in "${dep_array[@]}"; do\n                        dep="${dep// /}"\n                        [[ -z "$dep" ]] && continue\n                        dep_total=$(( dep_total + 1 ))\n                    done\n                fi\n                key=$(printf \'%020d_%s\' "$dep_total" "$pkg")\n                if [[ -z "$best" || "$key" < "$best_key" ]]; then\n                    best="$pkg"\n                    best_key="$key"\n                fi\n            fi\n        done\n\n        if [[ -z "$best" ]]; then\n            log_error "Circular dependency detected in selected package set"\n            return 1\n        fi\n\n        done_pkg[$best]=1\n        order="$order $best"\n        remaining_count=$(( remaining_count - 1 ))\n\n        for dependent in "$@"; do\n            if [[ "${done_pkg[$dependent]:-}" == "0" ]] && (( remaining_deps[$dependent] > 0 )); then\n                deps_str="${DEP_MAP[$dependent]:-}"\n                if [[ -n "$deps_str" ]]; then\n                    IFS=\',\' read -ra dep_array <<< "$deps_str"\n                    for dep_dep in "${dep_array[@]}"; do\n                        dep_dep="${dep_dep// /}"\n                        [[ -z "$dep_dep" ]] && continue\n                        if [[ "$dep_dep" == "$best" ]]; then\n                            remaining_deps[$dependent]=$(( remaining_deps[$dependent] - 1 ))\n                        fi\n                    done\n                fi\n            fi\n        done\n    done\n\n    echo "${order# }"\n}\n\n# Print all packages that would be rebuilt if PACKAGE changed.\n# Output is topologically sorted and includes PACKAGE itself.\nimpact_package() {\n    local target="$1"\n    if [[ -z "${DEP_MAP[*]+_}" ]]; then\n        build_dep_map\n    fi\n\n    if [[ -z "${DEP_MAP[$target]+_}" ]]; then\n        log_error "Unknown package: $target"\n        return 1\n    fi\n\n    local affected\n    affected=$(get_affected_packages "$target") || return 1\n    forge_topo_order $affected\n}\n\n# Print the shortest dependency path from PKG1 to PKG2.\n# If no path exists, print a message and exit 0.\nshortest_dep_path() {\n    local src="$1" dst="$2"\n    if [[ -z "${DEP_MAP[*]+_}" ]]; then\n        build_dep_map\n    fi\n\n    if [[ -z "${DEP_MAP[$src]+_}" ]]; then\n        log_error "Unknown package: $src"\n        return 1\n    fi\n    if [[ -z "${DEP_MAP[$dst]+_}" ]]; then\n        log_error "Unknown package: $dst"\n        return 1\n    fi\n\n    if [[ "$src" == "$dst" ]]; then\n        echo "$src"\n        return 0\n    fi\n\n    declare -A seen prev\n    local queue=("$src")\n    seen[$src]=1\n\n    while (( ${#queue[@]} > 0 )); do\n        local next_queue=()\n        local node deps dep_array d\n        for node in "${queue[@]}"; do\n            deps="${DEP_MAP[$node]:-}"\n            if [[ -n "$deps" ]]; then\n                IFS=\',\' read -ra dep_array <<< "$deps"\n                for d in "${dep_array[@]}"; do\n                    d="${d// /}"\n                    [[ -z "$d" ]] && continue\n                    if [[ -z "${seen[$d]:-}" ]]; then\n                        seen[$d]=1\n                        prev[$d]="$node"\n                        if [[ "$d" == "$dst" ]]; then\n                            local path=("$dst")\n                            local cur="$dst"\n                            while [[ -n "${prev[$cur]:-}" ]]; do\n                                cur="${prev[$cur]}"\n                                path=("$cur" "${path[@]}")\n                            done\n                            local result=""\n                            local p\n                            for p in "${path[@]}"; do\n                                result="$result -> $p"\n                            done\n                            echo "${result# -> }"\n                            return 0\n                        fi\n                        next_queue+=("$d")\n                    fi\n                done\n            fi\n        done\n        queue=("${next_queue[@]}")\n    done\n\n    echo "No dependency path from $src to $dst."\n    return 0\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
