uild_fail" "$pkg_name" "$profile" 0 false "$trigger"\n        return 1\n    fi\n\n    local build_cmd="${MANIFEST_build_command:-make}"\n    case "$build_cmd" in\n        *make*) build_cmd="$build_cmd BUILD_DIR=build/${profile}" ;;\n    esac\n\n    log_info "[$pkg_name] Building..."\n    if ! (cd "$pkg_dir" && BUILD_DIR="build/${profile}" eval "$build_cmd" 2>&1); then\n        log_error "[$pkg_name] Build failed"\n        journal_append_event "build_fail" "$pkg_name" "$profile" 0 false "$trigger"\n        return 1\n    fi\n\n    update_cache "$pkg_name" "$profile"\n\n    end_ms="$(date +%s%3N 2>/dev/null)"\n    if [[ ! "$end_ms" =~ ^[0-9]+$ ]]; then\n        end_ms=$(( $(date +%s) * 1000 ))\n    fi\n    duration_ms=$(( end_ms - start_ms ))\n    journal_append_event "build_complete" "$pkg_name" "$profile" "$duration_ms" false "$trigger"\n\n    if ! run_hook "$pkg_name" post_build "$profile"; then\n        log_warn "[$pkg_name] post_build hook failed; continuing"\n    fi\n\n    log_info "[$pkg_name] Build successful"\n    return 0\n\'\'\'\nif old not in s:\n    raise SystemExit(\'build_package snippet not found\')\ns = s.replace(old, new)\n\nold = \'\'\'    if ! setup_build_env "$pkg_name" "$profile"; then\n        log_error "[$pkg_name] Failed to set up build environment"\n        return 1\n    fi\n\n    log_info "[$pkg_name] Running tests..."\n    if ! (cd "$pkg_dir" && BUILD_DIR="build/${profile}" eval "$test_cmd" 2>&1); then\n        log_error "[$pkg_name] Tests failed"\n        return 1\n    fi\n\n    log_info "[$pkg_name] Tests passed"\n    return 0\n\'\'\'\nnew = \'\'\'    if ! setup_build_env "$pkg_name" "$profile"; then\n        log_error "[$pkg_name] Failed to set up build environment"\n        return 1\n    fi\n\n    if ! run_hook "$pkg_name" pre_test "$profile"; then\n        log_error "[$pkg_name] pre_test hook failed"\n        return 1\n    fi\n\n    log_info "[$pkg_name] Running tests..."\n    if ! (cd "$pkg_dir" && BUILD_DIR="build/${profile}" eval "$test_cmd" 2>&1); then\n        log_error "[$pkg_name] Tests failed"\n        return 1\n    fi\n\n    if ! run_hook "$pkg_name" post_test "$profile"; then\n        log_warn "[$pkg_name] post_test hook failed; continuing"\n    fi\n\n    log_info "[$pkg_name] Tests passed"\n    return 0\n\'\'\'\nif old not in s:\n    raise SystemExit(\'test_package snippet not found\')\ns = s.replace(old, new)\n\nappend = r\'\'\'\n\n# ==================================================================\n# Lifecycle hooks and custom targets\n# ==================================================================\n\n# Run a lifecycle hook for a package.  Returns 0 if the hook is not\n# configured or its script is missing; returns the script\'s exit status\n# otherwise.  Callers are responsible for interpreting failures.\nrun_hook() {\n    local pkg_name="$1" hook="$2" profile="${3:-release}"\n    parse_manifest "$pkg_name"\n    local script="${MANIFEST_HOOK_${hook}:-}"\n    [[ -z "$script" ]] && return 0\n\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$pkg_name")\n    local script_path="$pkg_dir/$script"\n    if [[ ! -f "$script_path" ]]; then\n        return 0\n    fi\n\n    if ! setup_build_env "$pkg_name" "$profile"; then\n        log_error "[$pkg_name] Failed to set up hook environment"\n        return 1\n    fi\n\n    local start_ms end_ms duration_ms rc\n    start_ms="$(date +%s%3N 2>/dev/null)"\n    if [[ ! "$start_ms" =~ ^[0-9]+$ ]]; then\n        start_ms=$(( $(date +%s) * 1000 ))\n    fi\n\n    (cd "$pkg_dir" && bash "$script_path" 2>&1)\n    rc=$?\n\n    end_ms="$(date +%s%3N 2>/dev/null)"\n    if [[ ! "$end_ms" =~ ^[0-9]+$ ]]; then\n        end_ms=$(( $(date +%s) * 1000 ))\n    fi\n    duration_ms=$(( end_ms - start_ms ))\n    journal_append_event "hook_run" "$pkg_name" "$profile" "$duration_ms" false manual hook "$hook"\n    return $rc\n}\n\n# Run a custom target for a single package.  Packages that do not define\n# the target are silently skipped.  Returns non-zero if the target script\n# is missing or exits non-zero.\nrun_target_in_pkg() {\n    local pkg_name="$1" target="$2" profile="${3:-release}"\n    parse_manifest "$pkg_name"\n    local script="${MANIFEST_TARGET_${target}:-}"\n    [[ -z "$script" ]] && return 0\n\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$pkg_name")\n    local script_path="$pkg_dir/$script"\n    if [[ ! -f "$script_path" ]]; then\n        log_error "[$pkg_name] Target script not found: $script"\n        return 1\n    fi\n\n    if ! setup_build_env "$pkg_name" "$profile"; then\n        log_error "[$pkg_name] Failed to set up target environment"\n        return 1\n    fi\n\n    echo "=== [$pkg_name:$target] ==="\n    local start_ms end_ms duration_ms rc\n    start_ms="$(date +%s%3N 2>/dev/null)"\n    if [[ ! "$start_ms" =~ ^[0-9]+$ ]]; then\n        start_ms=$(( $(date +%s) * 1000 ))\n    fi\n\n    (cd "$pkg_dir" && bash "$script_path" 2>&1)\n    rc=$?\n\n    end_ms="$(date +%s%3N 2>/dev/null)"\n    if [[ ! "$end_ms" =~ ^[0-9]+$ ]]; then\n        end_ms=$(( $(date +%s) * 1000 ))\n    fi\n    duration_ms=$(( end_ms - start_ms ))\n    journal_append_event "target_run" "$pkg_name" "$profile" "$duration_ms" false manual target "$target"\n    if [[ $rc -ne 0 ]]; then\n        log_error "[$pkg_name] Target \'$target\' failed"\n        return 1\n    fi\n    return 0\n}\n\n# Run a custom target for every package that defines it, in dependency\n# order.\nrun_target_all() {\n    local target="$1" profile="${2:-release}"\n    local order pkg\n    order=$(resolve_build_order) || return 1\n    for pkg in $order; do\n        if ! run_target_in_pkg "$pkg" "$target" "$profile"; then\n            return 1\n        fi\n    done\n    return 0\n}\n\n# Run a custom target for one package after running the same target for\n# all dependencies that define it.\nrun_target_for_package() {\n    local target="$1" pkg_name="$2" profile="${3:-release}"\n    local order pkg\n    order=$(resolve_deps_for "$pkg_name") || return 1\n    for pkg in $order; do\n        if ! run_target_in_pkg "$pkg" "$target" "$profile"; then\n            return 1\n        fi\n    done\n    return 0\n}\n\ncmd_run() {\n    local target="" pkg="" profile="release" mode=""\n    if [[ $# -lt 1 ]]; then\n        usage\n        return 1\n    fi\n    target="$1"\n    shift\n    while [[ $# -gt 0 ]]; do\n        case "$1" in\n            --all) mode="all" ;;\n            --package) mode="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;\n            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;\n            *) usage; return 1 ;;\n        esac\n        shift\n    done\n\n    validate_profile "$profile" || return 1\n    if [[ -z "$mode" ]]; then\n        usage\n        return 1\n    fi\n\n    if [[ "$mode" == "all" ]]; then\n        run_target_all "$target" "$profile"\n    else\n        run_target_for_package "$target" "$pkg" "$profile"\n    fi\n}\n\n_list_hooks_for_package() {\n    local pkg_name="$1"\n    parse_manifest "$pkg_name"\n    local hook script found=false\n    for hook in pre_build post_build pre_test post_test; do\n        script="${MANIFEST_HOOK_${hook}:-}"\n        if [[ -n "$script" ]]; then\n            printf \'%-12s %-11s %s\\n\' "$pkg_name" "$hook" "$script"\n            found=true\n        fi\n    done\n    [[ "$found" == true ]]\n}\n\ncmd_hooks() {\n    local pkg=""\n    while [[ $# -gt 0 ]]; do\n        case "$1" in\n            --package) if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;\n            *) usage; return 1 ;;\n        esac\n        shift\n    done\n\n    if [[ -n "$pkg" ]]; then\n        if ! _list_hooks_for_package "$pkg"; then\n            echo "No hooks configured."\n        fi\n        return 0\n    fi\n\n    local pkg_name any=false\n    for pkg_name in $(list_package_names); do\n        if _list_hooks_for_package "$pkg_name"; then\n            any=true\n        fi\n    done\n    if [[ "$any" != true ]]; then\n        echo "No hooks configured."\n    fi\n}\n\n_list_targets_for_package() {\n    local pkg_name="$1"\n    parse_manifest "$pkg_name"\n    local var name script found=false\n    for var in $(compgen -v MANIFEST_TARGET_ 2>/dev/null | sort); do\n        name="${var#MANIFEST_TARGET_}"\n        script="${!var:-}"\n        if [[ -n "$script" ]]; then\n            printf \'%-12s %-11s %s\\n\' "$pkg_name" "$name" "$script"\n            found=true\n        fi\n    done\n    [[ "$found" == true ]]\n}\n\ncmd_targets() {\n    local pkg=""\n    while [[ $# -gt 0 ]]; do\n        case "$1" in\n            --package) if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;\n            *) usage; return 1 ;;\n        esac\n        shift\n    done\n\n    if [[ -n "$pkg" ]]; then\n        if ! _list_targets_for_package "$pkg"; then\n            echo "No targets configured."\n        fi\n        return 0\n    fi\n\n    local pkg_name any=false\n    for pkg_name in $(list_package_names); do\n        if _list_targets_for_package "$pkg_name"; then\n            any=true\n        fi\n    done\n    if [[ "$any" != true ]]; then\n        echo "No targets configured."\n    fi\n}\n\'\'\'\nif append not in s:\n    s = s.rstrip() + append\np.write_text(s)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
