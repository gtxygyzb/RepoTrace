Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\n\np = Path(\'lib/builder.sh\')\ns = p.read_text()\n\nstart = s.index(\'# Build a single package\')\nend = s.index(\'# Run tests for a single package\')\n\nnew_func = r\'\'\'# Build a single package\nbuild_package() {\n    local pkg_name="$1"\n    local profile="${2:-release}"\n    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then\n        log_error "Invalid profile: $profile"\n        return 1\n    fi\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$pkg_name")\n\n    if [[ ! -d "$pkg_dir" ]]; then\n        log_error "Package directory not found: $pkg_dir"\n        return 1\n    fi\n\n    # Check cache\n    if is_cache_valid "$pkg_name" "$profile" 2>/dev/null; then\n        log_info "[$pkg_name] Up to date (cached)"\n        journal_append_event "build_skip" "$pkg_name" "$profile" 0 true manual\n        return 0\n    fi\n\n    local trigger\n    trigger="$(journal_build_trigger "$pkg_name" "$profile")"\n    journal_append_event "build_start" "$pkg_name" "$profile" 0 false "$trigger"\n\n    local start_ms end_ms duration_ms=0\n    start_ms="$(date +%s%3N 2>/dev/null)"\n    if [[ ! "$start_ms" =~ ^[0-9]+$ ]]; then\n        start_ms=$(( $(date +%s) * 1000 ))\n    fi\n\n    log_info "[$pkg_name] Building..."\n\n    # Parse manifest for build command\n    parse_manifest "$pkg_name"\n    local build_cmd="${MANIFEST_command:-make}"\n    case "$build_cmd" in\n        *make*) build_cmd="$build_cmd BUILD_DIR=build/${profile}" ;;\n    esac\n\n    # Set up build environment\n    if ! setup_build_env "$pkg_name" "$profile"; then\n        log_error "[$pkg_name] Failed to set up build environment"\n        end_ms="$(date +%s%3N 2>/dev/null)"\n        if [[ ! "$end_ms" =~ ^[0-9]+$ ]]; then\n            end_ms=$(( $(date +%s) * 1000 ))\n        fi\n        duration_ms=$(( end_ms - start_ms ))\n        journal_append_event "build_fail" "$pkg_name" "$profile" "$duration_ms" false "$trigger"\n        return 1\n    fi\n\n    # Execute build\n    if ! (cd "$pkg_dir" && BUILD_DIR="build/${profile}" eval "$build_cmd" 2>&1); then\n        log_error "[$pkg_name] Build failed"\n        end_ms="$(date +%s%3N 2>/dev/null)"\n        if [[ ! "$end_ms" =~ ^[0-9]+$ ]]; then\n            end_ms=$(( $(date +%s) * 1000 ))\n        fi\n        duration_ms=$(( end_ms - start_ms ))\n        journal_append_event "build_fail" "$pkg_name" "$profile" "$duration_ms" false "$trigger"\n        return 1\n    fi\n\n    # Update cache\n    update_cache "$pkg_name" "$profile"\n\n    end_ms="$(date +%s%3N 2>/dev/null)"\n    if [[ ! "$end_ms" =~ ^[0-9]+$ ]]; then\n        end_ms=$(( $(date +%s) * 1000 ))\n    fi\n    duration_ms=$(( end_ms - start_ms ))\n    journal_append_event "build_complete" "$pkg_name" "$profile" "$duration_ms" false "$trigger"\n\n    log_info "[$pkg_name] Build successful"\n    return 0\n}\n\n\'\'\'\n\ns = s[:start] + new_func + s[end:]\np.write_text(s)\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > lib/reporter.sh <<\'EOF\'\n#!/bin/bash\n# Report generation for ForgeKit\n\ngenerate_report() {\n    echo ""\n    echo "ForgeKit Build Report"\n    echo ""\n\n    local width=${#PACKAGE}\n    local pkg_name\n    for pkg_name in $(list_package_names); do\n        if (( ${#pkg_name} > width )); then\n            width=${#pkg_name}\n        fi\n    done\n\n    printf "%-${width}s  %-10s  %-10s  %-8s  %-6s  %s\\n" \\\n        "PACKAGE" "VERSION" "TYPE" "STATUS" "CACHED" "LAST BUILD"\n    printf "%-${width}s  %-10s  %-10s  %-8s  %-6s  %s\\n" \\\n        "-------" "-------" "----" "------" "------" "----------"\n\n    for pkg_name in $(list_package_names); do\n        parse_manifest "$pkg_name"\n        local version="${MANIFEST_version:-?}"\n        local type="${MANIFEST_type:-?}"\n        local pkg_dir\n        pkg_dir=$(get_package_dir "$pkg_name")\n\n        local status="pending"\n        if [[ -d "$pkg_dir/build/release" ]] || [[ -d "$pkg_dir/build/debug" ]]; then\n            status="built"\n        fi\n\n        local cached="no"\n        if is_cache_valid "$pkg_name" release 2>/dev/null || is_cache_valid "$pkg_name" debug 2>/dev/null; then\n            cached="yes"\n        fi\n\n        local last_build_duration\n        last_build_duration="$(journal_last_build_duration "$pkg_name" 2>/dev/null)"\n        local last_build="-"\n        if [[ -n "$last_build_duration" ]]; then\n            last_build="${last_build_duration}ms"\n        fi\n\n        printf "%-${width}s  %-10s  %-10s  %-8s  %-6s  %s\\n" \\\n            "$pkg_name" "$version" "$type" "$status" "$cached" "$last_build"\n    done\n\n    echo ""\n    echo "Total packages: $(list_package_names | wc -w)"\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
