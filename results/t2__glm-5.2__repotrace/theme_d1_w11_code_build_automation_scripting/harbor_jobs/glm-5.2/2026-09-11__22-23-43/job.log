Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\n\nPath(\'forge\').write_text(\'\'\'#!/bin/bash\n# ForgeKit - Legacy Build Automation System\n# Main CLI entry point\n\nFORGE_ROOT="$(cd "$(dirname "$0")" && pwd)"\nexport FORGE_ROOT\n\n# Source library modules\nsource "$FORGE_ROOT/lib/common.sh"\nsource "$FORGE_ROOT/lib/manifest.sh"\nsource "$FORGE_ROOT/lib/depgraph.sh"\nsource "$FORGE_ROOT/lib/builder.sh"\nsource "$FORGE_ROOT/lib/cache.sh"\nsource "$FORGE_ROOT/lib/artifact.sh"\nsource "$FORGE_ROOT/lib/reporter.sh"\nsource "$FORGE_ROOT/lib/configgen.sh"\n\n# Load global config\nif [[ -f "$FORGE_ROOT/config/forge.conf" ]]; then\n    source "$FORGE_ROOT/config/forge.conf"\nfi\n\nusage() {\n    cat <<\'EOF\'\nUsage: forge <command> [options]\n\nCommands:\n  build [--all|--package NAME] [-j N] [--profile debug|release]\n  test  [--all|--package NAME] [--profile debug|release]\n  list\n  deps  NAME\n  report\n  config generate ENV\n  artifact pack NAME [--profile debug|release]\n  clean [--all|--package NAME] [--profile debug|release]\n  graph [--reverse NAME]\nEOF\n}\n\nvalidate_profile() {\n    local profile="${1:-release}"\n    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then\n        log_error "Invalid profile: $profile (expected debug or release)"\n        return 1\n    fi\n    return 0\n}\n\ncmd_build() {\n    local target="" pkg="" jobs=1 profile="release"\n    while [[ $# -gt 0 ]]; do\n        case "$1" in\n            --all) target="all" ;;\n            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;\n            -j) if [[ $# -lt 2 ]]; then usage; return 1; fi; jobs="$2"; shift ;;\n            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;\n            *) usage; return 1 ;;\n        esac\n        shift\n    done\n\n    validate_profile "$profile" || return 1\n\n    if [[ "$target" == "package" ]]; then\n        build_packages_for_target "$pkg" "$jobs" "$profile"\n    elif [[ "$target" == "all" ]]; then\n        build_all_packages "$jobs" "$profile"\n    else\n        usage\n        return 1\n    fi\n}\n\ncmd_test() {\n    local target="" pkg="" profile="release"\n    while [[ $# -gt 0 ]]; do\n        case "$1" in\n            --all) target="all" ;;\n            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;\n            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;\n            *) usage; return 1 ;;\n        esac\n        shift\n    done\n\n    validate_profile "$profile" || return 1\n\n    if [[ "$target" == "package" ]]; then\n        test_package_chain "$pkg" "$profile"\n    elif [[ "$target" == "all" ]]; then\n        local order pkg_name\n        order=$(resolve_build_order) || return 1\n        for pkg_name in $order; do\n            test_package "$pkg_name" "$profile" || return 1\n        done\n    else\n        usage\n        return 1\n    fi\n}\n\ncmd_list() {\n    list_packages\n}\n\ncmd_deps() {\n    if [[ $# -lt 1 ]]; then usage; return 1; fi\n    show_dep_tree "$1"\n}\n\ncmd_report() {\n    generate_report\n}\n\ncmd_config() {\n    if [[ $# -lt 2 || "$1" != "generate" ]]; then usage; return 1; fi\n    generate_config "$2"\n}\n\ncmd_artifact() {\n    if [[ $# -lt 2 || "$1" != "pack" ]]; then usage; return 1; fi\n    local pkg="$2" profile="release"\n    shift 2\n    while [[ $# -gt 0 ]]; do\n        case "$1" in\n            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;\n            *) usage; return 1 ;;\n        esac\n        shift\n    done\n    validate_profile "$profile" || return 1\n    pack_artifact "$pkg" "$profile"\n}\n\ncmd_clean() {\n    local target="" pkg="" profile="release"\n    while [[ $# -gt 0 ]]; do\n        case "$1" in\n            --all) target="all" ;;\n            --package) target="package"; if [[ $# -lt 2 ]]; then usage; return 1; fi; pkg="$2"; shift ;;\n            --profile) if [[ $# -lt 2 ]]; then usage; return 1; fi; profile="$2"; shift ;;\n            *) usage; return 1 ;;\n        esac\n        shift\n    done\n\n    validate_profile "$profile" || return 1\n\n    if [[ "$target" == "all" ]]; then\n        for pkg_name in $(list_package_names); do\n            clean_package "$pkg_name" "$profile"\n        done\n        clean_cache "$profile"\n        log_info "All packages cleaned ($profile)"\n    elif [[ "$target" == "package" ]]; then\n        clean_package "$pkg" "$profile"\n        invalidate_cache "$pkg" "$profile"\n    else\n        usage\n        return 1\n    fi\n}\n\ncmd_graph() {\n    local reverse=""\n    while [[ $# -gt 0 ]]; do\n        case "$1" in\n            --reverse) if [[ $# -lt 2 ]]; then log_error "--reverse requires a package name"; return 1; fi; reverse="$2"; shift ;;\n            *) usage; return 1 ;;\n        esac\n        shift\n    done\n\n    if [[ -n "$reverse" ]]; then\n        print_reverse_graph "$reverse"\n    else\n        print_graph\n    fi\n}\n\n# Main dispatch\nif [[ $# -lt 1 ]]; then\n    usage\n    exit 1\nfi\n\ncommand="$1"\nshift\n\ncase "$command" in\n    build)    cmd_build "$@" ;;\n    test)     cmd_test "$@" ;;\n    list)     cmd_list ;;\n    deps)     cmd_deps "$@" ;;\n    report)   cmd_report ;;\n    config)   cmd_config "$@" ;;\n    artifact) cmd_artifact "$@" ;;\n    clean)    cmd_clean "$@" ;;\n    graph)    cmd_graph "$@" ;;\n    *)        usage; exit 1 ;;\nesac\n\'\'\')\nPath(\'lib/cache.sh\').write_text(\'\'\'#!/bin/bash\n# Build cache management for ForgeKit\n#\n# Uses timestamp-based caching: each package records a "last built"\n# timestamp; a rebuild is triggered when source files are newer or\n# when a transitive dependency has been rebuilt more recently.\n#\n# Cache stamps are profile-namespaced so debug and release builds do\n# not interfere with each other.\n\nFORGE_CACHE_DIR="${FORGE_ROOT}/.forge_cache"\n\ninit_cache() {\n    mkdir -p "$FORGE_CACHE_DIR"\n}\n\n_forge_cache_profile() {\n    local profile="${1:-release}"\n    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then\n        profile="release"\n    fi\n    echo "$profile"\n}\n\n# Newest mtime among all files under a package\'s src/ directory\nget_src_mtime() {\n    local pkg_name="$1"\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$pkg_name")\n\n    local latest=0\n    local mtime\n    while IFS= read -r -d \'\' file; do\n        mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)\n        if (( mtime > latest )); then\n            latest=$mtime\n        fi\n    done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)\n\n    # Also check Makefile\n    if [[ -f "$pkg_dir/Makefile" ]]; then\n        mtime=$(stat -c %Y "$pkg_dir/Makefile" 2>/dev/null || echo 0)\n        if (( mtime > latest )); then\n            latest=$mtime\n        fi\n    fi\n\n    echo "$latest"\n}\n\n# Check whether the cached build is still valid.\n#\n# A package is invalid if:\n#   - it has no cache stamp\n#   - its own sources/Makefile are newer than its cache stamp\n#   - any transitive dependency has no cache stamp\n#   - any transitive dependency has a cache stamp newer than this package\'s\nis_cache_valid() {\n    local pkg_name="$1"\n    local profile\n    profile=$(_forge_cache_profile "${2:-release}")\n    init_cache\n    local cache_file="$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"\n\n    if [[ ! -f "$cache_file" ]]; then\n        return 1  # No cache -> rebuild\n    fi\n\n    local cached_time\n    cached_time=$(cat "$cache_file" 2>/dev/null || echo 0)\n    if [[ ! "$cached_time" =~ ^[0-9]+$ ]]; then\n        return 1\n    fi\n\n    local src_mtime\n    src_mtime=$(get_src_mtime "$pkg_name")\n\n    if (( src_mtime > cached_time )); then\n        return 1  # Source newer than cache -> rebuild\n    fi\n\n    # Invalidate when transitive dependencies were rebuilt more recently.\n    local deps\n    deps=$(get_all_deps "$pkg_name") || return 1\n    local dep dep_cache_file dep_time\n    for dep in $deps; do\n        [[ -z "$dep" ]] && continue\n        dep_cache_file="$FORGE_CACHE_DIR/${dep}-${profile}.stamp"\n        if [[ ! -f "$dep_cache_file" ]]; then\n            return 1\n        fi\n        dep_time=$(cat "$dep_cache_file" 2>/dev/null || echo 0)\n        if [[ ! "$dep_time" =~ ^[0-9]+$ ]]; then\n            return 1\n        fi\n        if (( dep_time > cached_time )); then\n            return 1\n        fi\n    done\n\n    return 0  # Cache is valid\n}\n\n# Record the current time as the build timestamp for a package\nupdate_cache() {\n    local pkg_name="$1"\n    local profile\n    profile=$(_forge_cache_profile "${2:-release}")\n    init_cache\n    date +%s > "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"\n}\n\n# Remove cache entry for a package\ninvalidate_cache() {\n    local pkg_name="$1"\n    local profile\n    profile=$(_forge_cache_profile "${2:-release}")\n    rm -f "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"\n}\n\n# Wipe cache entries.  With a profile argument, only that profile is\n# removed.  Without an argument, all cache entries are removed.\nclean_cache() {\n    local profile\n    profile=$(_forge_cache_profile "${1:-}")\n    init_cache\n    if [[ -n "$1" ]]; then\n        rm -f "$FORGE_CACHE_DIR"/*-${profile}.stamp\n    else\n        rm -rf "$FORGE_CACHE_DIR"\n    fi\n}\n\'\'\')\nPath(\'lib/common.sh\').write_text(\'\'\'#!/bin/bash\n# Common utilities for ForgeKit\n\nlog_info() {\n    echo "[FORGE INFO] $*" >&2\n}\n\nlog_warn() {\n    echo "[FORGE WARN] $*" >&2\n}\n\nlog_error() {\n    echo "[FORGE ERROR] $*" >&2\n}\n\n# Get the absolute path to a package directory\nget_package_dir() {\n    local name="$1"\n    echo "$FORGE_ROOT/packages/$name"\n}\n\n# Get the absolute path to a package manifest\nget_package_manifest() {\n    local name="$1"\n    echo "$FORGE_ROOT/packages/$name/package.forge"\n}\n\n# List all package names (directories under packages/ with a manifest)\nlist_package_names() {\n    local pkg_dir\n    for pkg_dir in "$FORGE_ROOT/packages"/*/; do\n        if [[ -f "$pkg_dir/package.forge" ]]; then\n            basename "$pkg_dir"\n        fi\n    done\n}\n\n# Display formatted package listing\nlist_packages() {\n    local name version type deps\n    printf "%-25s %-10s %-10s %s\\\\n" "NAME" "VERSION" "TYPE" "DEPENDENCIES"\n    printf "%-25s %-10s %-10s %s\\\\n" "----" "-------" "----" "------------"\n    for pkg_name in $(list_package_names); do\n        parse_manifest "$pkg_name"\n        name="${MANIFEST_name:-$pkg_name}"\n        version="${MANIFEST_version:-unknown}"\n        type="${MANIFEST_type:-unknown}"\n        deps="${MANIFEST_deps:-none}"\n        printf "%-25s %-10s %-10s %s\\\\n" "$name" "$version" "$type" "$deps"\n    done\n}\n\n# Clean build artifacts for a package.  A profile argument scopes the\n# cleanup to build/<profile>; without it, release is cleaned.  Object\n# files under src are removed for the selected profile\'s build tree.\nclean_package() {\n    local name="$1"\n    local profile\n    profile="${2:-release}"\n    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then\n        log_error "Invalid profile: $profile"\n        return 1\n    fi\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$name")\n    if [[ -d "$pkg_dir/build/$profile" ]]; then\n        rm -rf "$pkg_dir/build/$profile"\n        log_info "Cleaned $name ($profile)"\n    fi\n    find "$pkg_dir/src" -name "*.o" -delete 2>/dev/null || true\n}\n\'\'\')\nPath(\'lib/builder.sh\').write_text(\'\'\'#!/bin/bash\n# Build executor for ForgeKit\n#\n# Builds packages by running their Makefile in the correct environment.\n\n# Set up FORGE_CFLAGS / FORGE_LDFLAGS for a package.\n# Includes include and library paths for the full transitive dependency\n# closure, not just direct dependencies.\n#\n# Usage: setup_build_env PKG [PROFILE]\nsetup_build_env() {\n    local pkg_name="$1"\n    local profile="${2:-release}"\n    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then\n        log_error "Invalid profile: $profile"\n        return 1\n    fi\n    parse_manifest "$pkg_name"\n\n    local cflags=""\n    local ldflags=""\n    local libs=""\n    local deps\n\n    deps=$(get_all_deps "$pkg_name") || return 1\n\n    declare -A seen\n    local dep dep_dir\n    for dep in $deps; do\n        [[ -z "$dep" ]] && continue\n        [[ -n "${seen[$dep]:-}" ]] && continue\n        seen[$dep]=1\n\n        dep_dir=$(get_package_dir "$dep")\n        cflags="$cflags -I${dep_dir}/src"\n        ldflags="$ldflags -L${dep_dir}/build/${profile}"\n\n        # For services linking against libraries\n        parse_manifest "$dep"\n        if [[ "${MANIFEST_type:-}" == "library" ]]; then\n            libs="$libs ${dep_dir}/build/${profile}/${dep}.a"\n        fi\n    done\n\n    case "$profile" in\n        debug)   cflags="$cflags -g -O0 -DDEBUG" ;;\n        release) cflags="$cflags -O2 -DNDEBUG -s" ;;\n    esac\n\n    export FORGE_CFLAGS="$cflags"\n    export FORGE_LDFLAGS="$ldflags"\n    export FORGE_LIBS="$libs"\n}\n\n# Build a single package\nbuild_package() {\n    local pkg_name="$1"\n    local profile="${2:-release}"\n    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then\n        log_error "Invalid profile: $profile"\n        return 1\n    fi\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$pkg_name")\n\n    if [[ ! -d "$pkg_dir" ]]; then\n        log_error "Package directory not found: $pkg_dir"\n        return 1\n    fi\n\n    # Check cache\n    if is_cache_valid "$pkg_name" "$profile" 2>/dev/null; then\n        log_info "[$pkg_name] Up to date (cached)"\n        return 0\n    fi\n\n    log_info "[$pkg_name] Building..."\n\n    # Parse manifest for build command\n    parse_manifest "$pkg_name"\n    local build_cmd="${MANIFEST_command:-make}"\n\n    # Set up build environment\n    if ! setup_build_env "$pkg_name" "$profile"; then\n        log_error "[$pkg_name] Failed to set up build environment"\n        return 1\n    fi\n\n    # Execute build\n    if ! (cd "$pkg_dir" && BUILD_DIR="build/${profile}" eval "$build_cmd" 2>&1); then\n        log_error "[$pkg_name] Build failed"\n        return 1\n    fi\n\n    # Update cache\n    update_cache "$pkg_name" "$profile"\n\n    log_info "[$pkg_name] Build successful"\n    return 0\n}\n\n# Run tests for a single package\ntest_package() {\n    local pkg_name="$1"\n    local profile="${2:-release}"\n    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then\n        log_error "Invalid profile: $profile"\n        return 1\n    fi\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$pkg_name")\n\n    parse_manifest "$pkg_name"\n    local test_cmd="${MANIFEST_test_command:-make test}"\n\n    if ! setup_build_env "$pkg_name" "$profile"; then\n        log_error "[$pkg_name] Failed to set up build environment"\n        return 1\n    fi\n\n    log_info "[$pkg_name] Running tests..."\n    if ! (cd "$pkg_dir" && BUILD_DIR="build/${profile}" eval "$test_cmd" 2>&1); then\n        log_error "[$pkg_name] Tests failed"\n        return 1\n    fi\n\n    log_info "[$pkg_name] Tests passed"\n    return 0\n}\n\n_test_package_chain() {\n    local target="$1" profile="$2"\n    local order pkg\n    order=$(resolve_deps_for "$target") || return 1\n    for pkg in $order; do\n        build_package "$pkg" "$profile" || return 1\n    done\n}\n\ntest_package_chain() {\n    local target="$1" profile="${2:-release}"\n    local order pkg\n    order=$(resolve_deps_for "$target") || return 1\n    for pkg in $order; do\n        test_package "$pkg" "$profile" || return 1\n    done\n}\n\n# Build a single target and its dependency chain with optional parallelism.\nbuild_packages_for_target() {\n    local target="$1" jobs="${2:-1}" profile="${3:-release}"\n    local order\n    order=$(resolve_deps_for "$target") || return 1\n    _run_parallel_build "$order" "$jobs" "$profile"\n}\n\n# Build all packages with optional parallelism.\nbuild_all_packages() {\n    local jobs="${1:-1}" profile="${2:-release}"\n    local order\n    order=$(resolve_build_order) || return 1\n    _run_parallel_build "$order" "$jobs" "$profile"\n}\n\n# Internal: schedule packages in dependency order with up to N workers.\n# Each package\'s output is buffered and printed under a header when it\n# finishes.  Existing concurrent builds continue on failure, but no new\n# packages are started after a failure.\n_run_parallel_build() {\n    local order="$1" jobs="${2:-1}" profile="${3:-release}"\n    jobs=$(( jobs < 1 ? 1 : jobs ))\n\n    declare -A remaining_deps done_pkg failed_pkg\n    local pkg dep deps_str dep_count\n    for pkg in $order; do\n        deps_str="${DEP_MAP[$pkg]:-}"\n        dep_count=0\n        if [[ -n "$deps_str" ]]; then\n            local IFS=\',\'\n            for dep in $deps_str; do\n                dep="${dep// /}"\n                [[ -z "$dep" ]] && continue\n                dep_count=$(( dep_count + 1 ))\n            done\n        fi\n        remaining_deps[$pkg]=$dep_count\n        done_pkg[$pkg]=0\n    done\n\n    local active=0 finished=0 total=0\n    for pkg in $order; do total=$(( total + 1 )); done\n\n    local tmpdir\n    tmpdir=$(mktemp -d)\n    trap \'rm -rf "$tmpdir"\' RETURN\n\n    while (( finished < total )); do\n        local started=0\n        for pkg in $order; do\n            if (( done_pkg[$pkg] == 0 )) && (( remaining_deps[$pkg] == 0 )); then\n                if (( active >= jobs )); then\n                    break\n                fi\n\n                done_pkg[$pkg]=1\n                active=$(( active + 1 ))\n                started=$(( started + 1 ))\n\n                (\n                    {\n                        build_package "$pkg" "$profile"\n                        echo "__FORGE_BUILD_RC__$?"\n                    } > "$tmpdir/$pkg.out" 2>&1\n                ) &\n\n                if (( active >= jobs )); then\n                    break\n                fi\n            fi\n        done\n\n        if (( active == 0 )); then\n            if (( started == 0 )); then\n                break\n            fi\n        fi\n\n        wait -n 2>/dev/null || wait\n        active=$(( active - 1 ))\n\n        local output_pkg rc\n        for output_pkg in $order; do\n            if [[ -f "$tmpdir/$output_pkg.out" ]] && [[ ! -f "$tmpdir/$output_pkg.done" ]]; then\n                touch "$tmpdir/$output_pkg.done"\n                finished=$(( finished + 1 ))\n\n                rc=$(grep -m1 \'__FORGE_BUILD_RC__\' "$tmpdir/$output_pkg.out" | sed \'s/.*__FORGE_BUILD_RC__//\')\n                rc="${rc:-1}"\n                grep -v \'__FORGE_BUILD_RC__\' "$tmpdir/$output_pkg.out" > "$tmpdir/$output_pkg.clean"\n\n                echo "=== [$output_pkg] ==="\n                cat "$tmpdir/$output_pkg.clean"\n\n                if (( rc != 0 )); then\n                    failed_pkg[$output_pkg]=1\n                else\n                    done_pkg[$output_pkg]=2\n                    deps_str="${DEP_MAP[$output_pkg]:-}"\n                    if [[ -n "$deps_str" ]]; then\n                        local IFS=\',\'\n                        for dep in $deps_str; do\n                            dep="${dep// /}"\n                            [[ -z "$dep" ]] && continue\n                        done\n                    fi\n\n                    local dependent dep_deps dep_dep\n                    for dependent in $order; do\n                        if (( done_pkg[$dependent] == 0 )); then\n                            dep_deps="${DEP_MAP[$dependent]:-}"\n                            if [[ -n "$dep_deps" ]]; then\n                                local IFS=\',\'\n                                for dep_dep in $dep_deps; do\n                                    dep_dep="${dep_dep// /}"\n                                    [[ -z "$dep_dep" ]] && continue\n                                    if [[ "$dep_dep" == "$output_pkg" ]]; then\n                                        remaining_deps[$dependent]=$(( remaining_deps[$dependent] - 1 ))\n                                    fi\n                                done\n                            fi\n                        fi\n                    done\n                fi\n            fi\n        done\n    done\n\n    rm -rf "$tmpdir"\n\n    local failures=""\n    for pkg in $order; do\n        if [[ -n "${failed_pkg[$pkg]:-}" ]]; then\n            failures="$failures $pkg"\n        fi\n    done\n\n    if [[ -n "$failures" ]]; then\n        failures="${failures# }"\n        log_error "Build failed for: $failures"\n        return 1\n    fi\n\n    return 0\n}\n\'\'\')\nPath(\'lib/depgraph.sh\').write_text(\'\'\'#!/bin/bash\n# Dependency graph resolution for ForgeKit\n#\n# Provides topological-sort-based build ordering and\n# dependency tree queries.\n\n# Build an associative array mapping package -> comma-separated deps\nbuild_dep_map() {\n    declare -gA DEP_MAP\n    # Reset\n    local k\n    for k in "${!DEP_MAP[@]}"; do unset "DEP_MAP[$k]"; done\n\n    local pkg_name deps_str\n    for pkg_name in $(list_package_names); do\n        parse_manifest "$pkg_name"\n        deps_str="${MANIFEST_deps:-}"\n        DEP_MAP[$pkg_name]="$deps_str"\n    done\n}\n\n# Shared DFS helper.  Callers must declare local:\n#   declare -A _state\n#   declare -a _path\n#   local _order=""\n_forge_graph_dfs() {\n    local node="$1"\n\n    if [[ -z "${DEP_MAP[$node]+_}" ]]; then\n        log_error "Unknown package in dependency graph: $node"\n        return 1\n    fi\n\n    case "${_state[$node]:-}" in\n        done)\n            return 0\n            ;;\n        visiting)\n            local cycle="" in_cycle=0 p\n            for p in "${_path[@]}"; do\n                if [[ "$p" == "$node" ]]; then\n                    in_cycle=1\n                fi\n                if (( in_cycle )); then\n                    cycle="$cycle $p"\n                fi\n            done\n            cycle="$cycle $node"\n            cycle="${cycle# }"\n            log_error "Circular dependency detected: $(echo "$cycle" | sed \'s/ / -> /g\')"\n            return 1\n            ;;\n    esac\n\n    _state[$node]=visiting\n    _path+=("$node")\n\n    local deps="${DEP_MAP[$node]:-}"\n    if [[ -n "$deps" ]]; then\n        local IFS=\',\'\n        for dep in $deps; do\n            dep="${dep// /}"\n            [[ -z "$dep" ]] && continue\n            if ! _forge_graph_dfs "$dep"; then\n                return 1\n            fi\n        done\n    fi\n\n    _state[$node]=done\n    _order="$_order $node"\n\n    if ((${#_path[@]} > 0)); then\n        _path=("${_path[@]:0:${#_path[@]}-1}")\n    fi\n    return 0\n}\n\n# -------------------------------------------------------------------\n# Topological sort via DFS with cycle detection.\n# -------------------------------------------------------------------\nresolve_build_order() {\n    build_dep_map\n\n    declare -A _state\n    declare -a _path\n    local _order=""\n\n    for pkg in $(list_package_names); do\n        if ! _forge_graph_dfs "$pkg"; then\n            return 1\n        fi\n    done\n\n    echo "${_order# }"\n}\n\n# Resolve the build chain for a single target (inclusive)\nresolve_deps_for() {\n    local target="$1"\n    build_dep_map\n\n    if [[ -z "${DEP_MAP[$target]+_}" ]]; then\n        log_error "Unknown package: $target"\n        return 1\n    fi\n\n    declare -A _state\n    declare -a _path\n    local _order=""\n\n    if ! _forge_graph_dfs "$target"; then\n        return 1\n    fi\n\n    echo "${_order# }"\n}\n\n# Pretty-print the dependency tree (recursive, indented)\nshow_dep_tree() {\n    local name="$1"\n    local indent="${2:-0}"\n    local seen="${3:-}"\n\n    # Ensure the dep map exists\n    if [[ -z "${DEP_MAP[*]+_}" ]]; then\n        build_dep_map\n    fi\n\n    parse_manifest "$name"\n    local indent_str=""\n    local i\n    for (( i=0; i<indent; i++ )); do\n        indent_str+="  "\n    done\n\n    echo "${indent_str}${name} (${MANIFEST_version:-?}, ${MANIFEST_type:-?})"\n\n    # Detect cycles in the tree printer\n    if [[ "$seen" == *"|$name|"* ]]; then\n        echo "${indent_str}  [cycle detected at $name]"\n        return 0\n    fi\n    seen="$seen|$name|"\n\n    local deps="${DEP_MAP[$name]:-}"\n    if [[ -n "$deps" ]]; then\n        local IFS=\',\'\n        local dep\n        for dep in $deps; do\n            dep="${dep// /}"\n            [[ -z "$dep" ]] && continue\n            show_dep_tree "$dep" $((indent + 1)) "$seen" || true\n        done\n    fi\n}\n\n# Return all transitive dependencies (not including the package itself)\nget_all_deps() {\n    local name="$1"\n    if [[ -z "${DEP_MAP[*]+_}" ]]; then\n        build_dep_map\n    fi\n\n    declare -A _seen\n    local _result=""\n\n    _collect_deps() {\n        local node="$1"\n        local deps="${DEP_MAP[$node]:-}"\n        if [[ -n "$deps" ]]; then\n            local IFS=\',\'\n            for dep in $deps; do\n                dep="${dep// /}"\n                [[ -z "$dep" ]] && continue\n                if [[ -z "${_seen[$dep]:-}" ]]; then\n                    _seen[$dep]=1\n                    _result="$_result $dep"\n                    _collect_deps "$dep"\n                fi\n            done\n        fi\n    }\n\n    _collect_deps "$name"\n    echo "${_result# }"\n}\n\n# Return all packages that transitively depend on the named package.\nget_all_reverse_deps() {\n    local target="$1"\n    if [[ -z "${DEP_MAP[*]+_}" ]]; then\n        build_dep_map\n    fi\n\n    if [[ -z "${DEP_MAP[$target]+_}" ]]; then\n        log_error "Unknown package: $target"\n        return 1\n    fi\n\n    declare -A _seen\n    local _result=""\n\n    _collect_reverse() {\n        local node="$1"\n        local dep deps\n        for dep in "${!DEP_MAP[@]}"; do\n            deps="${DEP_MAP[$dep]}"\n            local IFS=\',\'\n            local d\n            for d in $deps; do\n                d="${d// /}"\n                [[ -z "$d" ]] && continue\n                if [[ "$d" == "$node" && -z "${_seen[$dep]:-}" ]]; then\n                    _seen[$dep]=1\n                    _result="$_result $dep"\n                    _collect_reverse "$dep"\n                fi\n            done\n        done\n    }\n\n    _collect_reverse "$target"\n    echo "${_result# }"\n}\n\nprint_graph() {\n    build_dep_map\n\n    echo "digraph forgekit {"\n    echo "  rankdir=LR;"\n    local pkg\n    for pkg in "${!DEP_MAP[@]}"; do\n        echo "  \\"$pkg\\";"\n    done\n\n    local deps dep\n    for pkg in "${!DEP_MAP[@]}"; do\n        deps="${DEP_MAP[$pkg]:-}"\n        if [[ -n "$deps" ]]; then\n            local IFS=\',\'\n            for dep in $deps; do\n                dep="${dep// /}"\n                [[ -z "$dep" ]] && continue\n                echo "  \\"$pkg\\" -> \\"$dep\\";"\n            done\n        fi\n    done\n    echo "}"\n}\n\nprint_reverse_graph() {\n    local target="$1"\n    build_dep_map\n\n    if [[ -z "${DEP_MAP[$target]+_}" ]]; then\n        log_error "Unknown package: $target"\n        return 1\n    fi\n\n    declare -A included=([$target]=1)\n    local rev\n    rev=$(get_all_reverse_deps "$target") || return 1\n    local pkg\n    for pkg in $rev; do\n        included[$pkg]=1\n    done\n\n    echo "digraph forgekit {"\n    echo "  rankdir=LR;"\n    for pkg in "${!included[@]}"; do\n        echo "  \\"$pkg\\";"\n    done\n\n    local deps dep\n    for pkg in "${!included[@]}"; do\n        deps="${DEP_MAP[$pkg]:-}"\n        if [[ -n "$deps" ]]; then\n            local IFS=\',\'\n            for dep in $deps; do\n                dep="${dep// /}"\n                [[ -z "$dep" ]] && continue\n                if [[ -n "${included[$dep]:-}" ]]; then\n                    echo "  \\"$pkg\\" -> \\"$dep\\";"\n                fi\n            done\n        fi\n    done\n    echo "}"\n}\n\'\'\')\nPath(\'lib/artifact.sh\').write_text(\'\'\'#!/bin/bash\n# Artifact packaging for ForgeKit\n\npack_artifact() {\n    local pkg_name="$1"\n    local profile="${2:-release}"\n    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then\n        log_error "Invalid profile: $profile"\n        return 1\n    fi\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$pkg_name")\n\n    parse_manifest "$pkg_name"\n    local version="${MANIFEST_version:-0.0.0}"\n\n    local build_dir="$pkg_dir/build/$profile"\n    if [[ ! -d "$build_dir" ]]; then\n        log_error "Build directory not found for $pkg_name ($profile). Run \'forge build\' first."\n        return 1\n    fi\n\n    local artifact_dir="$FORGE_ROOT/artifacts"\n    mkdir -p "$artifact_dir"\n\n    local artifact_name="${pkg_name}-${version}-${profile}.tar.gz"\n\n    # Generate dependency metadata inside the packaged build directory.\n    # Direct dependencies only, as <dep_name>=<dep_version> per line.\n    local deps_manifest="$build_dir/deps.manifest"\n    : > "$deps_manifest"\n\n    local deps="${MANIFEST_deps:-}"\n    if [[ -n "$deps" ]]; then\n        local IFS=\',\'\n        local dep dep_version\n        for dep in $deps; do\n            dep="${dep// /}"\n            [[ -z "$dep" ]] && continue\n            dep_version=$(get_manifest_value "$dep" "version") || return 1\n            printf \'%s=%s\\\\n\' "$dep" "$dep_version" >> "$deps_manifest"\n        done\n    fi\n\n    tar -czf "$artifact_dir/$artifact_name" \\\n        -C "$pkg_dir" \\\n        "build/$profile/" 2>/dev/null\n\n    if [[ $? -ne 0 ]]; then\n        log_error "Failed to create artifact for $pkg_name"\n        return 1\n    fi\n\n    log_info "Packed artifact: $artifact_name -> $artifact_dir/$artifact_name"\n    echo "$artifact_dir/$artifact_name"\n}\n\'\'\')\nPY\nchmod +x forge\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
