Sending keys: ['cat > lib/cache.sh <<\'EOF\'\n#!/bin/bash\n# Build cache management for ForgeKit\n#\n# Content-addressable cache: each package records a SHA256 source hash\n# and the source hashes of all transitive dependencies at build time.\n# Cache stamps are profile-namespaced so debug and release builds do\n# not interfere with each other.\n\nFORGE_CACHE_DIR="${FORGE_ROOT}/.forge_cache"\n\ninit_cache() {\n    mkdir -p "$FORGE_CACHE_DIR"\n}\n\n_forge_cache_profile() {\n    local profile="${1:-release}"\n    if [[ "$profile" != "debug" && "$profile" != "release" ]]; then\n        profile="release"\n    fi\n    echo "$profile"\n}\n\n# Compute the SHA256 hash of a single file, or empty string if missing.\n_file_sha256() {\n    local file="$1"\n    if [[ -f "$file" ]]; then\n        sha256sum "$file" | awk \'{print $1}\'\n    fi\n}\n\n# Compute the source hash for a package:\n# SHA256(sorted concatenation of SHA256 hashes of all files in src/\n# + Makefile + package.forge).\ncompute_source_hash() {\n    local pkg_name="$1"\n    local pkg_dir\n    pkg_dir=$(get_package_dir "$pkg_name")\n\n    local hashes="" hash\n    local file\n\n    while IFS= read -r -d \'\' file; do\n        hash=$(_file_sha256 "$file")\n        [[ -n "$hash" ]] && hashes+="$hash\\n"\n    done < <(find "$pkg_dir/src" -type f -print0 2>/dev/null)\n\n    hash=$(_file_sha256 "$pkg_dir/Makefile")\n    [[ -n "$hash" ]] && hashes+="$hash\\n"\n    hash=$(_file_sha256 "$pkg_dir/package.forge")\n    [[ -n "$hash" ]] && hashes+="$hash\\n"\n\n    if [[ -z "$hashes" ]]; then\n        # No source files: hash the empty string for stability.\n        printf \'%s\\n\' "" | sha256sum | awk \'{print $1}\'\n        return 0\n    fi\n\n    printf \'%b\' "$hashes" | sort | sha256sum | awk \'{print $1}\'\n}\n\n# Return the stored own source hash from a cache stamp, or empty string.\n_stored_own_hash() {\n    local cache_file="$1"\n    [[ -f "$cache_file" ]] || return 0\n    head -n 1 "$cache_file" 2>/dev/null | awk \'{print $1}\'\n}\n\n# Return the stored hash for a dependency from a cache stamp, or empty string.\n_stored_dep_hash() {\n    local cache_file="$1" dep="$2"\n    [[ -f "$cache_file" ]] || return 0\n    awk -v dep="$dep" \'\n        NR > 1 && $1 == dep ":" { print $2; exit }\n    \' "$cache_file" 2>/dev/null\n}\n\n# Check whether the cached build is still valid.\n#\n# A build is valid when:\n#   - it has a .hash cache stamp\n#   - the package\'s current source hash matches the stored own hash\n#   - every transitive dependency\'s current source hash matches the hash\n#     recorded when this package was last built\nis_cache_valid() {\n    local pkg_name="$1"\n    local profile\n    profile=$(_forge_cache_profile "${2:-release}")\n    init_cache\n    local cache_file="$FORGE_CACHE_DIR/${pkg_name}-${profile}.hash"\n\n    if [[ ! -f "$cache_file" ]]; then\n        return 1  # No cache -> rebuild\n    fi\n\n    local own_hash stored_hash\n    own_hash=$(compute_source_hash "$pkg_name")\n    stored_hash=$(_stored_own_hash "$cache_file")\n    if [[ -z "$stored_hash" || "$own_hash" != "$stored_hash" ]]; then\n        return 1\n    fi\n\n    local deps\n    deps=$(get_all_deps "$pkg_name") || return 1\n    local dep dep_hash stored_dep_hash\n    for dep in $deps; do\n        [[ -z "$dep" ]] && continue\n        dep_hash=$(compute_source_hash "$dep")\n        stored_dep_hash=$(_stored_dep_hash "$cache_file" "$dep")\n        if [[ -z "$stored_dep_hash" || "$dep_hash" != "$stored_dep_hash" ]]; then\n            return 1\n        fi\n    done\n\n    return 0\n}\n\n# Record the current source hash and all transitive dependency hashes.\nupdate_cache() {\n    local pkg_name="$1"\n    local profile\n    profile=$(_forge_cache_profile "${2:-release}")\n    init_cache\n    local cache_file="$FORGE_CACHE_DIR/${pkg_name}-${profile}.hash"\n\n    # Replace old timestamp stamps if present.\n    rm -f "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"\n\n    local own_hash deps dep dep_hash\n    own_hash=$(compute_source_hash "$pkg_name")\n    {\n        echo "$own_hash"\n        deps=$(get_all_deps "$pkg_name") || deps=""\n        for dep in $deps; do\n            [[ -z "$dep" ]] && continue\n            dep_hash=$(compute_source_hash "$dep")\n            echo "${dep}:${dep_hash}"\n        done\n    } > "$cache_file"\n}\n\n# Remove cache entry for a package.  When a profile is supplied, only that\n# profile\'s stamp is removed.  Without a profile, all profile stamps for the\n# package are invalidated.\ninvalidate_cache() {\n    local pkg_name="$1"\n    local profile\n    if [[ -n "${2:-}" ]]; then\n        profile=$(_forge_cache_profile "$2")\n        rm -f "$FORGE_CACHE_DIR/${pkg_name}-${profile}.hash"\n        rm -f "$FORGE_CACHE_DIR/${pkg_name}-${profile}.stamp"\n    else\n        rm -f "$FORGE_CACHE_DIR/${pkg_name}-"*.hash\n        rm -f "$FORGE_CACHE_DIR/${pkg_name}-"*.stamp\n    fi\n}\n\n# Wipe cache entries.  With a profile argument, only that profile is\n# removed.  Without an argument, all cache entries are removed.\nclean_cache() {\n    local profile\n    profile=$(_forge_cache_profile "${1:-}")\n    init_cache\n    if [[ -n "$1" ]]; then\n        rm -f "$FORGE_CACHE_DIR"/*-${profile}.hash\n        rm -f "$FORGE_CACHE_DIR"/*-${profile}.stamp\n    else\n        rm -rf "$FORGE_CACHE_DIR"\n    fi\n}\n\n# -------------------------------------------------------------------\n# Round 4/5: selective rebuild support.\n# -------------------------------------------------------------------\n\n# Return space-separated packages whose cache is invalid for PROFILE.\n# This captures packages with changed source/Makefile/manifest as well as\n# packages whose dependency source hashes changed.\nget_changed_packages() {\n    local profile\n    profile=$(_forge_cache_profile "${1:-release}")\n    init_cache\n    build_dep_map\n\n    local pkg changed=""\n    for pkg in $(list_package_names); do\n        if ! is_cache_valid "$pkg" "$profile" 2>/dev/null; then\n            changed="$changed $pkg"\n        fi\n    done\n\n    echo "${changed# }"\n}\n\n# -------------------------------------------------------------------\n# Round 5: cache status command.\n# -------------------------------------------------------------------\n\n# Print a per-package cache status summary.\n# Statuses:\n#   cached (<first 8 chars of hash>...)\n#   stale (src changed)\n#   stale (dep NAME changed)\n#   no cache\ncache_status() {\n    local pkg_filter="" profile\n    profile="release"\n\n    while [[ $# -gt 0 ]]; do\n        case "$1" in\n            --package)\n                if [[ $# -lt 2 ]]; then\n                    log_error "--package requires a package name"\n                    return 1\n                fi\n                pkg_filter="$2"\n                shift\n                ;;\n            --profile)\n                if [[ $# -lt 2 ]]; then\n                    log_error "--profile requires a profile name"\n                    return 1\n                fi\n                profile="$2"\n                shift\n                ;;\n            *)\n                log_error "Unknown cache status option: $1"\n                return 1\n                ;;\n        esac\n        shift\n    done\n\n    profile=$(_forge_cache_profile "$profile")\n    init_cache\n    build_dep_map\n\n    printf "%-20s %-10s %s\\n" "PACKAGE" "PROFILE" "STATUS"\n    printf "%-20s %-10s %s\\n" "-------" "-------" "------"\n\n    local pkg cache_file own_hash stored_hash status deps dep dep_hash stored_dep_hash first_changed\n    for pkg in $(list_package_names); do\n        if [[ -n "$pkg_filter" && "$pkg" != "$pkg_filter" ]]; then\n            continue\n        fi\n\n        cache_file="$FORGE_CACHE_DIR/${pkg}-${profile}.hash"\n        if [[ ! -f "$cache_file" ]]; then\n            status="no cache"\n            printf "%-20s %-10s %s\\n" "$pkg" "$profile" "$status"\n            continue\n        fi\n\n        own_hash=$(compute_source_hash "$pkg")\n        stored_hash=$(_stored_own_hash "$cache_file")\n        if [[ -z "$stored_hash" || "$own_hash" != "$stored_hash" ]]; then\n            status="stale (src changed)"\n            printf "%-20s %-10s %s\\n" "$pkg" "$profile" "$status"\n            continue\n        fi\n\n        deps=$(get_all_deps "$pkg") || deps=""\n        first_changed=""\n        for dep in $deps; do\n            [[ -z "$dep" ]] && continue\n            dep_hash=$(compute_source_hash "$dep")\n            stored_dep_hash=$(_stored_dep_hash "$cache_file" "$dep")\n            if [[ -z "$stored_dep_hash" || "$dep_hash" != "$stored_dep_hash" ]]; then\n                first_changed="$dep"\n                break\n            fi\n        done\n\n        if [[ -n "$first_changed" ]]; then\n            status="stale (dep $first_changed changed)"\n            printf "%-20s %-10s %s\\n" "$pkg" "$profile" "$status"\n        else\n            status="cached (${own_hash:0:8}...)"\n            printf "%-20s %-10s %s\\n" "$pkg" "$profile" "$status"\n        fi\n    done\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
