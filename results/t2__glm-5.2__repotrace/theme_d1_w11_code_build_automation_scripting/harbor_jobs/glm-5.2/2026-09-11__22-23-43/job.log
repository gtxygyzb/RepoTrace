Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\n\n# Patch tests for profile-specific cache stamps and artifact names.\np = Path(\'tests/run_tests.sh\')\ns = p.read_text()\ns = s.replace(\'crypto_stamp=$(cat "$FORGE_CACHE_DIR/libcrypto.stamp")\', \'crypto_stamp=$(cat "$FORGE_CACHE_DIR/libcrypto-release.stamp")\')\ns = s.replace(\'echo $((crypto_stamp + 5)) > "$FORGE_CACHE_DIR/libbase.stamp"\', \'echo $((crypto_stamp + 5)) > "$FORGE_CACHE_DIR/libbase-release.stamp"\')\ns = s.replace(\'assert_exit_nonzero "libcrypto invalid when dependency rebuilt" is_cache_valid libcrypto\', \'assert_exit_nonzero "libcrypto invalid when dependency rebuilt" is_cache_valid libcrypto release\')\ns = s.replace(\'assert_contains "artifact version matches manifest" "$result" "libbase-${libbase_version}.tar.gz"\', \'assert_contains "artifact version matches manifest" "$result" "libbase-${libbase_version}-release.tar.gz"\')\ns = s.replace(\'assert_contains "libcrypto artifact version matches manifest" "$result" "libcrypto-${libcrypto_version}.tar.gz"\', \'assert_contains "libcrypto artifact version matches manifest" "$result" "libcrypto-${libcrypto_version}-release.tar.gz"\')\np.write_text(s)\n\n# Patch builder: robust parallel scheduler and test chain builds first.\np = Path(\'lib/builder.sh\')\ns = p.read_text()\nstart = s.index(\'_run_parallel_build()\')\nend = s.index(\'test_package_chain()\')\nnew_scheduler = r\'\'\'_run_parallel_build() {\n    local order="$1" jobs="${2:-1}" profile="${3:-release}"\n    jobs=$(( jobs < 1 ? 1 : jobs ))\n\n    declare -A remaining_deps state failed_pkg\n    declare -A active_pids\n    local pkg dep deps_str dep_count\n\n    for pkg in $order; do\n        deps_str="${DEP_MAP[$pkg]:-}"\n        dep_count=0\n        if [[ -n "$deps_str" ]]; then\n            local IFS=\',\'\n            for dep in $deps_str; do\n                dep="${dep// /}"\n                [[ -z "$dep" ]] && continue\n                dep_count=$(( dep_count + 1 ))\n            done\n        fi\n        remaining_deps[$pkg]=$dep_count\n        state[$pkg]=pending\n    done\n\n    local total=0\n    for pkg in $order; do total=$(( total + 1 )); done\n    local finished=0 active=0 failed=0\n\n    local tmpdir\n    tmpdir=$(mktemp -d)\n\n    while (( finished < total )); do\n        # Launch ready packages up to the concurrency limit.\n        # After a failure, do not start any new packages; allow\n        # already-running jobs to complete.\n        if (( ! failed )); then\n            for pkg in $order; do\n                if (( active >= jobs )); then\n                    break\n                fi\n                if [[ "${state[$pkg]}" == "pending" ]] && (( remaining_deps[$pkg] == 0 )); then\n                    state[$pkg]=running\n                    active=$(( active + 1 ))\n                    (\n                        {\n                            build_package "$pkg" "$profile"\n                            echo "__FORGE_BUILD_RC__$?"\n                        } > "$tmpdir/$pkg.out" 2>&1\n                    ) &\n                    active_pids[$!]="$pkg"\n                fi\n            done\n        fi\n\n        if (( active == 0 )); then\n            # Nothing is running and nothing can be started; remaining\n            # packages are blocked by failed dependencies.\n            break\n        fi\n\n        # Wait for at least one background job to finish, then reap all\n        # completed jobs.  This avoids reading buffered output files\n        # before their subshell has finished writing.\n        wait -n 2>/dev/null || true\n\n        local completed=0\n        for pid in "${!active_pids[@]}"; do\n            if ! kill -0 "$pid" 2>/dev/null; then\n                wait "$pid" 2>/dev/null || true\n                pkg="${active_pids[$pid]}"\n                unset "active_pids[$pid]"\n                active=$(( active - 1 ))\n                finished=$(( finished + 1 ))\n                completed=$(( completed + 1 ))\n\n                local rc\n                rc=$(grep -m1 \'__FORGE_BUILD_RC__\' "$tmpdir/$pkg.out" | sed \'s/.*__FORGE_BUILD_RC__//\')\n                rc="${rc:-1}"\n\n                echo "=== [$pkg] ==="\n                grep -v \'__FORGE_BUILD_RC__\' "$tmpdir/$pkg.out"\n\n                if (( rc == 0 )); then\n                    state[$pkg]=done\n\n                    local dependent dep_deps dep_dep\n                    for dependent in $order; do\n                        if [[ "${state[$dependent]}" == "pending" ]]; then\n                            dep_deps="${DEP_MAP[$dependent]:-}"\n                            if [[ -n "$dep_deps" ]]; then\n                                local IFS=\',\'\n                                for dep_dep in $dep_deps; do\n                                    dep_dep="${dep_dep// /}"\n                                    [[ -z "$dep_dep" ]] && continue\n                                    if [[ "$dep_dep" == "$pkg" ]]; then\n                                        remaining_deps[$dependent]=$(( remaining_deps[$dependent] - 1 ))\n                                    fi\n                                done\n                            fi\n                        fi\n                    done\n                else\n                    state[$pkg]=failed\n                    failed_pkg[$pkg]=1\n                    failed=1\n                fi\n            fi\n        done\n\n        if (( completed == 0 )); then\n            sleep 0.05\n        fi\n    done\n\n    rm -rf "$tmpdir"\n\n    local failures=""\n    for pkg in $order; do\n        if [[ -n "${failed_pkg[$pkg]:-}" ]]; then\n            failures="$failures $pkg"\n        fi\n    done\n\n    if [[ -n "$failures" ]]; then\n        failures="${failures# }"\n        log_error "Build failed for: $failures"\n        return 1\n    fi\n\n    return 0\n}\n\n\'\'\'\nnew_test_chain = r\'\'\'test_package_chain() {\n    local target="$1" profile="${2:-release}"\n    local order pkg\n    order=$(resolve_deps_for "$target") || return 1\n    for pkg in $order; do\n        build_package "$pkg" "$profile" || return 1\n    done\n    for pkg in $order; do\n        test_package "$pkg" "$profile" || return 1\n    done\n}\n\n\'\'\'\ns = s[:start] + new_scheduler + new_test_chain + s[end:]\np.write_text(s)\n\n# Patch forge: cmd_test --all builds first.\np = Path(\'forge\')\ns = p.read_text()\ns = s.replace(\'local order pkg_name\\n        order=$(resolve_build_order) || return 1\\n        for pkg_name in $order; do\\n            test_package "$pkg_name" "$profile" || return 1\\n        done\', \'local order pkg_name\\n        order=$(resolve_build_order) || return 1\\n        build_all_packages 1 "$profile" || return 1\\n        for pkg_name in $order; do\\n            test_package "$pkg_name" "$profile" || return 1\\n        done\')\n# Validate jobs in cmd_build.\ns = s.replace(\'validate_profile "$profile" || return 1\\n\\n    if [[ "$target" == "package" ]]; then\', \'validate_profile "$profile" || return 1\\n    if [[ ! "$jobs" =~ ^[0-9]+$ ]] || (( jobs < 1 )); then\\n        log_error "Invalid job count: $jobs (expected N >= 1)"\\n        return 1\\n    fi\\n\\n    if [[ "$target" == "package" ]]; then\')\np.write_text(s)\n\n# Patch depgraph: print graph nodes in package list order.\np = Path(\'lib/depgraph.sh\')\ns = p.read_text()\ns = s.replace(\'local pkg\\n    for pkg in "${!DEP_MAP[@]}"; do\\n        echo "  \\\\"$pkg\\\\";"\\n    done\\n\\n    local deps dep\\n    for pkg in "${!DEP_MAP[@]}"; do\', \'local pkg\\n    for pkg in $(list_package_names); do\\n        echo "  \\\\"$pkg\\\\";"\\n    done\\n\\n    local deps dep\\n    for pkg in $(list_package_names); do\')\np.write_text(s)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
