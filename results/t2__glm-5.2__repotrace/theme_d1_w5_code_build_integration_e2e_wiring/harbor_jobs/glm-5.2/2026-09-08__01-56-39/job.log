ng]*TargetConfig, target string) error {\n    if _, ok := targetMap[target]; !ok {\n        failDepsJSON(fmt.Sprintf("target %q does not exist", target))\n        return nil\n    }\n\n    directSet := map[string]bool{}\n    for _, dep := range uniqueStrings(targetMap[target].Dependencies) {\n        directSet[dep] = true\n    }\n    direct := sortedKeys(directSet)\n\n    transitiveSet := map[string]bool{}\n    collectTransitiveDeps(targetMap, target, transitiveSet)\n    delete(transitiveSet, target)\n    transitive := sortedKeys(transitiveSet)\n\n    reverseSet := map[string]bool{}\n    for _, t := range cfg.Targets {\n        if t.Name == target {\n            continue\n        }\n        seen := map[string]bool{}\n        if dependsOnTransitive(targetMap, t.Name, target, seen) {\n            reverseSet[t.Name] = true\n        }\n    }\n    reverse := sortedKeys(reverseSet)\n\n    return emitJSON(map[string]interface{}{\n        "target":          target,\n        "direct_deps":     direct,\n        "transitive_deps": transitive,\n        "reverse_deps":    reverse,\n    })\n}\n\nfunc runDepsWhy(cfg *Config, targetMap map[string]*TargetConfig, from, to string) error {\n    if _, ok := targetMap[from]; !ok {\n        failDepsJSON(fmt.Sprintf("target %q does not exist", from))\n        return nil\n    }\n    if _, ok := targetMap[to]; !ok {\n        failDepsJSON(fmt.Sprintf("target %q does not exist", to))\n        return nil\n    }\n\n    paths := allDependencyPaths(targetMap, from, to)\n    sortPaths(paths)\n    return emitJSON(map[string]interface{}{\n        "from":  from,\n        "to":    to,\n        "paths": paths,\n    })\n}\n\nfunc runDepsAffected(cfg *Config, targetMap map[string]*TargetConfig, files []string, plan bool) error {\n    fileSet := map[string]bool{}\n    for _, f := range files {\n        fileSet[f] = true\n    }\n\n    affectedSet := map[string]bool{}\n    directAffected := map[string]bool{}\n    for i := range cfg.Targets {\n        t := &cfg.Targets[i]\n        for _, input := range t.Inputs {\n            if fileSet[input] {\n                affectedSet[t.Name] = true\n                directAffected[t.Name] = true\n                break\n            }\n        }\n    }\n\n    queue := sortedKeys(affectedSet)\n    for len(queue) > 0 {\n        name := queue[0]\n        queue = queue[1:]\n        for _, t := range cfg.Targets {\n            if affectedSet[t.Name] {\n                continue\n            }\n            for _, dep := range uniqueStrings(t.Dependencies) {\n                if dep == name {\n                    affectedSet[t.Name] = true\n                    queue = append(queue, t.Name)\n                    break\n                }\n            }\n        }\n    }\n\n    if len(affectedSet) == 0 {\n        if plan {\n            return emitJSON(map[string]interface{}{"rebuild_plan": []interface{}{}})\n        }\n        return emitJSON(map[string]interface{}{"rebuild_order": []interface{}{}})\n    }\n\n    if plan {\n        layers := buildRebuildLayers(targetMap, affectedSet, directAffected)\n        return emitJSON(map[string]interface{}{"rebuild_plan": layers})\n    }\n\n    order := topologicalOrderSubset(cfg, affectedSet)\n    entries := []map[string]interface{}{}\n    for _, name := range order {\n        entries = append(entries, map[string]interface{}{\n            "target": name,\n            "direct": directAffected[name],\n        })\n    }\n    return emitJSON(map[string]interface{}{"rebuild_order": entries})\n}\n\nfunc collectTransitiveDeps(targetMap map[string]*TargetConfig, name string, seen map[string]bool) {\n    for _, dep := range uniqueStrings(targetMap[name].Dependencies) {\n        if !seen[dep] {\n            seen[dep] = true\n            collectTransitiveDeps(targetMap, dep, seen)\n        }\n    }\n}\n\nfunc dependsOnTransitive(targetMap map[string]*TargetConfig, name, target string, seen map[string]bool) bool {\n    if seen[name] {\n        return false\n    }\n    seen[name] = true\n    for _, dep := range uniqueStrings(targetMap[name].Dependencies) {\n        if dep == target {\n            return true\n        }\n        if dependsOnTransitive(targetMap, dep, target, seen) {\n            return true\n        }\n    }\n    return false\n}\n\nfunc allDependencyPaths(targetMap map[string]*TargetConfig, from, to string) [][]string {\n    var paths [][]string\n    var current []string\n    visited := map[string]bool{}\n\n    var dfs func(node string)\n    dfs = func(node string) {\n        if visited[node] {\n            return\n        }\n        current = append(current, node)\n        visited[node] = true\n\n        if node == to && len(current) > 1 {\n            path := make([]string, len(current))\n            copy(path, current)\n            paths = append(paths, path)\n        } else if node != to {\n            for _, dep := range uniqueStrings(targetMap[node].Dependencies) {\n                dfs(dep)\n            }\n        }\n\n        current = current[:len(current)-1]\n        delete(visited, node)\n    }\n    dfs(from)\n    return paths\n}\n\nfunc sortPaths(paths [][]string) {\n    sort.Slice(paths, func(i, j int) bool {\n        if len(paths[i]) != len(paths[j]) {\n            return len(paths[i]) < len(paths[j])\n        }\n        for k := 0; k < len(paths[i]) && k < len(paths[j]); k++ {\n            if paths[i][k] != paths[j][k] {\n                return paths[i][k] < paths[j][k]\n            }\n        }\n        return false\n    })\n}\n\nfunc topologicalOrderSubset(cfg *Config, subset map[string]bool) []string {\n    indeg := map[string]int{}\n    for name := range subset {\n        indeg[name] = 0\n    }\n    for _, t := range cfg.Targets {\n        if !subset[t.Name] {\n            continue\n        }\n        for _, dep := range uniqueStrings(t.Dependencies) {\n            if subset[dep] {\n                indeg[t.Name]++\n            }\n        }\n    }\n\n    queue := []string{}\n    for name := range subset {\n        if indeg[name] == 0 {\n            queue = append(queue, name)\n        }\n    }\n    sort.Strings(queue)\n\n    order := []string{}\n    for len(queue) > 0 {\n        name := queue[0]\n        queue = queue[1:]\n        order = append(order, name)\n\n        for _, t := range cfg.Targets {\n            if !subset[t.Name] {\n                continue\n            }\n            for _, dep := range uniqueStrings(t.Dependencies) {\n                if dep == name {\n                    indeg[t.Name]--\n                    if indeg[t.Name] == 0 {\n                        queue = append(queue, t.Name)\n                    }\n                    break\n                }\n            }\n        }\n        sort.Strings(queue)\n    }\n    return order\n}\n\nfunc buildRebuildLayers(targetMap map[string]*TargetConfig, affected map[string]bool, direct map[string]bool) [][]map[string]interface{} {\n    layer := map[string]int{}\n\n    var resolve func(name string) int\n    resolve = func(name string) int {\n        if l, ok := layer[name]; ok {\n            return l\n        }\n        maxDepLayer := -1\n        for _, dep := range uniqueStrings(targetMap[name].Dependencies) {\n            if affected[dep] {\n                depLayer := resolve(dep)\n                if depLayer > maxDepLayer {\n                    maxDepLayer = depLayer\n                }\n            }\n        }\n        layer[name] = maxDepLayer + 1\n        return layer[name]\n    }\n\n    for name := range affected {\n        resolve(name)\n    }\n\n    maxLayer := 0\n    for _, l := range layer {\n        if l > maxLayer {\n            maxLayer = l\n        }\n    }\n\n    layers := make([][]map[string]interface{}, maxLayer+1)\n    for l := 0; l <= maxLayer; l++ {\n        names := []string{}\n        for name, ll := range layer {\n            if ll == l {\n                names = append(names, name)\n            }\n        }\n        sort.Strings(names)\n        for _, name := range names {\n            layers[l] = append(layers[l], map[string]interface{}{\n                "target": name,\n                "direct": direct[name],\n            })\n        }\n    }\n    return layers\n}\n\nfunc sortedKeys(m map[string]bool) []string {\n    keys := []string{}\n    for k := range m {\n        keys = append(keys, k)\n    }\n    sort.Strings(keys)\n    return keys\n}\n\nfunc emitJSON(v interface{}) error {\n    return json.NewEncoder(os.Stdout).Encode(v)\n}\n\nfunc failDepsJSON(msg string) {\n    json.NewEncoder(os.Stdout).Encode(map[string]string{"error": msg})\n    os.Exit(1)\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
