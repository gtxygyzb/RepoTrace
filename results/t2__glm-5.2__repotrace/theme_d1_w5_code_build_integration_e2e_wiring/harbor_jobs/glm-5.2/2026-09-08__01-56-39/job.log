ep].names...), name),\n\\t\\t\\tweight: dp[dep].weight + durationByName[name],\n\\t\\t\\t}\n\\t\\t\\tif betterBuildPath(cand, best) {\n\\t\\t\\t\\tbest = cand\n\\t\\t\\t}\n\\t\\t}\n\\t\\tdp[name] = best\n\\t}\n\n\\tvar best buildPath\n\\tfor _, name := range order {\n\\t\\tp := dp[name]\n\\t\\tif best.names == nil || betterBuildPath(p, best) {\n\\t\\t\\tbest = p\n\\t\\t}\n\\t}\n\n\\treturn &BuildProfile{CriticalPath: best.names, CriticalPathMS: best.weight}\n}\n\nfunc betterBuildPath(a, b buildPath) bool {\n\\tif a.weight != b.weight {\n\\t\\treturn a.weight > b.weight\n\\t}\n\\tif len(a.names) != len(b.names) {\n\\t\\treturn len(a.names) > len(b.names)\n\\t}\n\\tfor i := 0; i < len(a.names); i++ {\n\\t\\tif a.names[i] != b.names[i] {\n\\t\\t\\treturn a.names[i] < b.names[i]\n\\t\\t}\n\\t}\n\\treturn false\n}\n\nfunc (e *buildExecutor) execute(t *TargetConfig) execResult {\'\'\'\n)\n\np.write_text(s)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
