   569	func allDependenciesComplete(name string, targetMap map[string]*TargetConfig, requested map[string]bool, status map[string]string) bool {
   570		for _, dep := range targetMap[name].Dependencies {
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '571,700p'
[?2004l   571			if !requested[dep] {
   572				continue
   573			}
   574			s := status[dep]
   575			if s != "built" && s != "cached" {
   576				return false
   577			}
   578		}
   579		return true
   580	}
   581	
   582	func markSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {
   583		for _, dependent := range reverseDeps[name] {
   584			if status[dependent] == "" {
   585				status[dependent] = "skipped"
   586				durations[dependent] = 0
   587				*completed++
   588				markSkipped(reverseDeps, status, durations, completed, dependent)
   589			}
   590		}
   591	}
