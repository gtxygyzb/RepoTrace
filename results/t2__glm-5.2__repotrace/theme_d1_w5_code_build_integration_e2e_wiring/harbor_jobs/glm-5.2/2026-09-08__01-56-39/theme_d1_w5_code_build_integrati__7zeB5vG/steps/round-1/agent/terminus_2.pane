   798	func allDependenciesComplete(name string, targetMap map[string]*TargetConfig, requested map[string]bool, status map[string]string) bool {
   799		for _, dep := range targetMap[name].Dependencies {
   800			if !requested[dep] {
   801				continue
   802			}
   803			s := status[dep]
   804			if s != "built" && s != "cached" {
   805				return false
   806			}
   807		}
   808		return true
   809	}
