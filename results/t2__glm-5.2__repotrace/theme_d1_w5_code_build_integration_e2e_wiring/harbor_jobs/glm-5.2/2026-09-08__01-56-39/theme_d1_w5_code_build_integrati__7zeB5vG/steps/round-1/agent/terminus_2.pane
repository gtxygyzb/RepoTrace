   637	func parseVarOverrides(vars []string) (map[string]string, error) {
   638		m := make(map[string]string)
   639		for _, v := range vars {
   640			idx := strings.Index(v, "=")
   641			if idx == -1 {
   642				return nil, fmt.Errorf("invalid --var %q, expected key=value", v)
   643			}
   644			key := v[:idx]
   645			if key == "" {
   646				return nil, fmt.Errorf("invalid --var %q, empty key", v)
   647			}
   648			m[key] = v[idx+1:]
   649		}
   650		return m, nil
   651	}
