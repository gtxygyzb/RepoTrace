   538	func parseVarOverrides(vars []string) (map[string]string, error) {
   539		m := make(map[string]string)
   540		for _, v := range vars {
   541			idx := strings.Index(v, "=")
   542			if idx == -1 {
   543				return nil, fmt.Errorf("invalid --var %q, expected key=value", v)
   544			}
   545			key := v[:idx]
   546			if key == "" {
   547				return nil, fmt.Errorf("invalid --var %q, empty key", v)
   548			}
   549			m[key] = v[idx+1:]
   550		}
   551		return m, nil
   552	}
   553	
   554	func expandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {
   555		var b strings.Builder
   556		i := 0
   557		for i < len(s) {
   558			if i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {
   559				end := strings.Index(s[i:], "}")
   560				if end == -1 {
   561					return "", fmt.Errorf("unterminated variable reference in %q", s)
   562				}
   563				name := s[i+2 : i+end]
   564				if name == "" {
   565					return "", fmt.Errorf("empty variable reference in %q", s)
   566				}
   567				if visiting[name] {
   568					return "", fmt.Errorf("variable cycle detected: %q", name)
   569				}
   570				val, ok := vars[name]
   571				if !ok {
   572					return "", fmt.Errorf("unresolved variable %q", name)
   573				}
   574				visiting[name] = true
   575				expanded, err := expandString(val, vars, visiting)
   576				if err != nil {
   577					return "", err
   578				}
   579				delete(visiting, name)
   580				b.WriteString(expanded)
