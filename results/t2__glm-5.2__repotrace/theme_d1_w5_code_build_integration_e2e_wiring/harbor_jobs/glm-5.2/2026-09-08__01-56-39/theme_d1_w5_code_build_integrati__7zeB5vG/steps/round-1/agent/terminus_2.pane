   989	func markSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {
   990		for _, dependent := range reverseDeps[name] {
   991			switch status[dependent] {
   992			case "", "cancelled":
   993				wasCancelled := status[dependent] == "cancelled"
   994				status[dependent] = "skipped"
   995				durations[dependent] = 0
   996				if !wasCancelled {
   997					*completed++
   998				}
   999				markSkipped(reverseDeps, status, durations, completed, dependent)
  1000			}
  1001		}
  1002	}
  1003	
  1004	type buildPath struct {
  1005		names  []string
  1006		weight int64
  1007	}
  1008	
  1009	func computeBuildProfile(targets []BuildTargetReport, cfg *Config, targetMap map[string]*TargetConfig) *BuildProfile {
  1010		durationByName := map[string]int64{}
  1011		successful := map[string]bool{}
  1012		hasBuilt := false
  1013		for _, t := range targets {
  1014			switch t.Status {
  1015			case "built":
  1016				successful[t.Name] = true
  1017				durationByName[t.Name] = t.DurationMS
  1018				hasBuilt = true
  1019			case "cached":
  1020				successful[t.Name] = true
  1021				durationByName[t.Name] = 0
  1022			}
  1023		}
  1024	
  1025		if len(successful) == 0 || !hasBuilt {
  1026			return &BuildProfile{CriticalPath: []string{}, CriticalPathMS: 0}
  1027		}
  1028	
  1029		deps := map[string][]string{}
  1030		for name := range successful {
  1031			t, ok := targetMap[name]
  1032			if !ok {
  1033				continue
  1034			}
  1035			for _, dep := range uniqueStrings(t.Dependencies) {
  1036				if successful[dep] {
  1037					deps[name] = append(deps[name], dep)
  1038				}
  1039			}
  1040			sort.Strings(deps[name])
  1041		}
  1042	
  1043		order := []string{}
  1044		seen := map[string]bool{}
  1045		var visit func(string)
  1046		visit = func(n string) {
  1047			if seen[n] {
  1048				return
  1049			}
  1050			seen[n] = true
  1051			for _, dep := range deps[n] {
  1052				visit(dep)
  1053			}
  1054			order = append(order, n)
  1055		}
  1056		for _, t := range cfg.Targets {
  1057			if successful[t.Name] {
  1058				visit(t.Name)
  1059			}
  1060		}
  1061	
  1062		dp := map[string]buildPath{}
  1063		for _, name := range order {
  1064			best := buildPath{names: []string{name}, weight: durationByName[name]}
  1065			for _, dep := range deps[name] {
  1066				cand := buildPath{
  1067					names:  append(append([]string{}, dp[dep].names...), name),
  1068					weight: dp[dep].weight + durationByName[name],
  1069				}
  1070				if betterBuildPath(cand, best) {
  1071					best = cand
  1072				}
  1073			}
  1074			dp[name] = best
  1075		}
  1076	
  1077		var best buildPath
  1078		for _, name := range order {
  1079			p := dp[name]
  1080			if best.names == nil || betterBuildPath(p, best) {
  1081				best = p
  1082			}
  1083		}
  1084	
  1085		return &BuildProfile{CriticalPath: best.names, CriticalPathMS: best.weight}
  1086	}
  1087	
  1088	func betterBuildPath(a, b buildPath) bool {
  1089		if a.weight != b.weight {
  1090			return a.weight > b.weight
  1091		}
  1092		if len(a.names) != len(b.names) {
  1093			return len(a.names) > len(b.names)
  1094		}
  1095		for i := 0; i < len(a.names); i++ {
  1096			if a.names[i] != b.names[i] {
  1097				return a.names[i] < b.names[i]
  1098			}
  1099		}
  1100		return false
  1101	}
