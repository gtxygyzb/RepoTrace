   931	func writeCacheEntry(cacheDir string, entry CacheEntry) error {
   932		if err := os.MkdirAll(cacheDir, 0755); err != nil {
   933			return err
   934		}
   935		data, err := json.MarshalIndent(entry, "", "  ")
   936		if err != nil {
   937			return err
   938		}
   939		return os.WriteFile(filepath.Join(cacheDir, entry.CacheKey+".json"), data, 0644)
   940	}
