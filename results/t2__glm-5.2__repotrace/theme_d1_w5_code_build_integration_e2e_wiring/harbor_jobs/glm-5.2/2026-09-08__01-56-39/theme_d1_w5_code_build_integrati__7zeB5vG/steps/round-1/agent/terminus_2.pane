   593	func (e *buildExecutor) execute(t *TargetConfig) execResult {
   594		start := time.Now()
   595		key, err := computeCacheKey(t, e.configDir)
   596		if err != nil {
   597			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   598		}
   599	
   600		if !e.noCache {
   601			valid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)
   602			if err != nil {
   603				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   604			}
   605			if valid {
   606				return execResult{name: t.Name, status: "cached", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   607			}
   608		}
   609	
   610		timeout := t.Timeout
   611		if timeout <= 0 {
   612			timeout = 300
   613		}
   614	
   615		var stdout, stderr bytes.Buffer
   616		cmd := exec.Command("sh", "-c", t.Command)
   617		cmd.Dir = e.configDir
   618		cmd.Env = mergedEnv(t.Env)
   619		cmd.Stdout = &stdout
   620		cmd.Stderr = &stderr
   621		cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
   622	
   623		if err := cmd.Start(); err != nil {
   624			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   625		}
   626	
   627		waitCh := make(chan error, 1)
   628		go func() {
   629			waitCh <- cmd.Wait()
   630		}()
   631	
   632		var runErr error
   633		select {
   634		case <-time.After(time.Duration(timeout) * time.Second):
   635			if cmd.Process != nil {
   636				_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
   637			}
   638			<-waitCh
   639			runErr = fmt.Errorf("target %q timed out after %ds", t.Name, timeout)
   640		case err := <-waitCh:
   641			if err != nil {
   642				runErr = err
   643			}
   644		}
   645	
   646		elapsed := time.Since(start).Milliseconds()
   647		if runErr != nil {
   648			if stderr.Len() > 0 {
   649				fmt.Fprintf(os.Stderr, "target %q stderr:\n%s", t.Name, stderr.String())
   650			}
   651			return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
   652		}
   653	
   654		entry := CacheEntry{
   655			CacheKey:   key,
   656			TargetName: t.Name,
   657			Timestamp:  time.Now().UTC().Format(time.RFC3339),
   658			Outputs:    t.Outputs,
   659		}
   660		if err := writeCacheEntry(e.cacheDir, entry); err != nil {
   661			fmt.Fprintln(os.Stderr, err)
   662			return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
   663		}
   664		return execResult{name: t.Name, status: "built", durationMS: elapsed, cacheKey: key}
   665	}
   666	
   667	func computeCacheKey(t *TargetConfig, configDir string) (string, error) {
   668		h := sha256.New()
   669		if _, err := io.WriteString(h, t.Command); err != nil {
   670			return "", err
   671		}
   672	
   673		envKeys := make([]string, 0, len(t.Env))
   674		for k := range t.Env {
   675			envKeys = append(envKeys, k)
   676		}
   677		sort.Strings(envKeys)
   678		for _, k := range envKeys {
   679			if _, err := io.WriteString(h, k+"="+t.Env[k]); err != nil {
   680				return "", err
   681			}
   682		}
   683	
   684		inputPaths := make([]string, len(t.Inputs))
   685		copy(inputPaths, t.Inputs)
   686		sort.Strings(inputPaths)
   687		for _, p := range inputPaths {
   688			contentHash, err := hashFile(resolvePath(configDir, p))
   689			if err != nil {
   690				contentHash = hashBytes(nil)
   691			}
   692			if _, err := io.WriteString(h, contentHash); err != nil {
   693				return "", err
   694			}
   695		}
   696		return hex.EncodeToString(h.Sum(nil)), nil
   697	}
