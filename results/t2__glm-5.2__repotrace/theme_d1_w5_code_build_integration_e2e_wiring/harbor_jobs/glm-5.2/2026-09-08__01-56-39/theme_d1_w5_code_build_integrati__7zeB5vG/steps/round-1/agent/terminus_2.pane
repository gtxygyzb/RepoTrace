   658	func selectTargets(cfg *Config, targetMap map[string]*TargetConfig, targetsFlag string) (map[string]bool, error) {
   659		if strings.TrimSpace(targetsFlag) == "" {
   660			requested := map[string]bool{}
   661			for _, t := range cfg.Targets {
   662				requested[t.Name] = true
   663			}
   664			return requested, nil
   665		}
   666	
   667		requested := map[string]bool{}
   668		for _, part := range strings.Split(targetsFlag, ",") {
   669			name := strings.TrimSpace(part)
   670			if _, ok := targetMap[name]; !ok {
   671				return nil, fmt.Errorf("target %q not found", name)
   672			}
   673			var visit func(string)
   674			visit = func(n string) {
   675				if requested[n] {
   676					return
   677				}
   678				requested[n] = true
   679				for _, dep := range targetMap[n].Dependencies {
   680					visit(dep)
   681				}
   682			}
   683			visit(name)
   684		}
   685		return requested, nil
   686	}
   687	
   688	func topologicalOrder(cfg *Config, requested map[string]bool) []string {
   689		indeg := map[string]int{}
   690		for _, t := range cfg.Targets {
   691			if !requested[t.Name] {
   692				continue
   693			}
   694			count := 0
   695			for _, dep := range uniqueStrings(t.Dependencies) {
   696				if requested[dep] {
   697					count++
   698				}
   699			}
   700			indeg[t.Name] = count
   701		}
   702	
   703		queue := []string{}
   704		for _, t := range cfg.Targets {
   705			if requested[t.Name] && indeg[t.Name] == 0 {
   706				queue = append(queue, t.Name)
   707			}
   708		}
   709	
   710		order := []string{}
   711		for len(queue) > 0 {
   712			name := queue[0]
   713			queue = queue[1:]
   714			order = append(order, name)
   715			for _, t := range cfg.Targets {
   716				if !requested[t.Name] {
   717					continue
   718				}
   719				for _, dep := range uniqueStrings(t.Dependencies) {
   720					if dep == name {
   721						indeg[t.Name]--
   722						if indeg[t.Name] == 0 {
   723							queue = append(queue, t.Name)
   724						}
   725						break
   726					}
   727				}
   728			}
   729		}
   730		return order
   731	}
   732	
   733	func buildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {
   734		reverse := map[string][]string{}
   735		for _, t := range cfg.Targets {
   736			if !requested[t.Name] {
   737				continue
   738			}
   739			for _, dep := range uniqueStrings(t.Dependencies) {
   740				if requested[dep] {
   741					reverse[dep] = append(reverse[dep], t.Name)
   742				}
   743			}
   744		}
   745		return reverse
   746	}
   747	
   748	func allDependenciesComplete(name string, targetMap map[string]*TargetConfig, requested map[string]bool, status map[string]string) bool {
   749		for _, dep := range targetMap[name].Dependencies {
   750			if !requested[dep] {
   751				continue
   752			}
   753			s := status[dep]
   754			if s != "built" && s != "cached" {
   755				return false
   756			}
   757		}
   758		return true
   759	}
   760	
   761	func markSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {
   762		for _, dependent := range reverseDeps[name] {
   763			if status[dependent] == "" {
   764				status[dependent] = "skipped"
   765				durations[dependent] = 0
   766				*completed++
   767				markSkipped(reverseDeps, status, durations, completed, dependent)
   768			}
   769		}
   770	}
