   652	func selectTargets(cfg *Config, targetMap map[string]*TargetConfig, targetsFlag string) (map[string]bool, error) {
   653		if strings.TrimSpace(targetsFlag) == "" {
   654			requested := map[string]bool{}
   655			for _, t := range cfg.Targets {
   656				requested[t.Name] = true
   657			}
   658			return requested, nil
   659		}
   660	
   661		requested := map[string]bool{}
   662		for _, part := range strings.Split(targetsFlag, ",") {
   663			name := strings.TrimSpace(part)
   664			if _, ok := targetMap[name]; !ok {
   665				return nil, fmt.Errorf("target %q not found", name)
   666			}
   667			var visit func(string)
   668			visit = func(n string) {
   669				if requested[n] {
   670					return
   671				}
   672				requested[n] = true
   673				for _, dep := range targetMap[n].Dependencies {
   674					visit(dep)
   675				}
   676			}
   677			visit(name)
   678		}
   679		return requested, nil
   680	}
   681	
   682	func topologicalOrder(cfg *Config, requested map[string]bool) []string {
   683		indeg := map[string]int{}
   684		for _, t := range cfg.Targets {
   685			if !requested[t.Name] {
   686				continue
   687			}
   688			count := 0
   689			for _, dep := range uniqueStrings(t.Dependencies) {
   690				if requested[dep] {
   691					count++
   692				}
   693			}
   694			indeg[t.Name] = count
   695		}
   696	
   697		queue := []string{}
   698		for _, t := range cfg.Targets {
   699			if requested[t.Name] && indeg[t.Name] == 0 {
   700				queue = append(queue, t.Name)
   701			}
   702		}
   703	
   704		order := []string{}
   705		for len(queue) > 0 {
   706			name := queue[0]
   707			queue = queue[1:]
   708			order = append(order, name)
   709			for _, t := range cfg.Targets {
   710				if !requested[t.Name] {
   711					continue
   712				}
   713				for _, dep := range uniqueStrings(t.Dependencies) {
   714					if dep == name {
   715						indeg[t.Name]--
   716						if indeg[t.Name] == 0 {
   717							queue = append(queue, t.Name)
   718						}
   719						break
   720					}
   721				}
   722			}
   723		}
   724		return order
   725	}
   726	
   727	func buildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {
   728		reverse := map[string][]string{}
   729		for _, t := range cfg.Targets {
   730			if !requested[t.Name] {
   731				continue
   732			}
   733			for _, dep := range uniqueStrings(t.Dependencies) {
   734				if requested[dep] {
   735					reverse[dep] = append(reverse[dep], t.Name)
   736				}
   737			}
   738		}
   739		return reverse
   740	}
   741	
   742	func allDependenciesComplete(name string, targetMap map[string]*TargetConfig, requested map[string]bool, status map[string]string) bool {
   743		for _, dep := range targetMap[name].Dependencies {
   744			if !requested[dep] {
   745				continue
   746			}
   747			s := status[dep]
   748			if s != "built" && s != "cached" {
   749				return false
   750			}
   751		}
   752		return true
   753	}
   754	
   755	func markSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {
   756		for _, dependent := range reverseDeps[name] {
   757			if status[dependent] == "" {
   758				status[dependent] = "skipped"
   759				durations[dependent] = 0
   760				*completed++
   761				markSkipped(reverseDeps, status, durations, completed, dependent)
   762			}
   763		}
   764	}
   765	
   766	func (e *buildExecutor) execute(t *TargetConfig) execResult {
   767		start := time.Now()
   768		key, err := computeCacheKey(t, e.configDir)
   769		if err != nil {
   770			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   771		}
   772	
   773		if !e.noCache {
   774			valid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)
   775			if err != nil {
   776				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   777			}
   778			if valid {
   779				return execResult{name: t.Name, status: "cached", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   780			}
   781		}
   782	
   783		timeout := t.Timeout
   784		if timeout <= 0 {
   785			timeout = 300
   786		}
   787	
   788		var stdout, stderr bytes.Buffer
   789		cmd := exec.Command("sh", "-c", t.Command)
   790		cmd.Dir = e.configDir
   791		cmd.Env = mergedEnv(t.Env)
   792		cmd.Stdout = &stdout
   793		cmd.Stderr = &stderr
   794		cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
   795	
   796		if err := cmd.Start(); err != nil {
   797			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   798		}
   799	
   800		waitCh := make(chan error, 1)
   801		go func() {
   802			waitCh <- cmd.Wait()
   803		}()
   804	
   805		var runErr error
   806		select {
   807		case <-time.After(time.Duration(timeout) * time.Second):
   808			if cmd.Process != nil {
   809				_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
   810			}
   811			<-waitCh
   812			runErr = fmt.Errorf("target %q timed out after %ds", t.Name, timeout)
   813		case err := <-waitCh:
   814			if err != nil {
   815				runErr = err
   816			}
   817		}
   818	
   819		elapsed := time.Since(start).Milliseconds()
   820		if runErr != nil {
   821			if stderr.Len() > 0 {
   822				fmt.Fprintf(os.Stderr, "target %q stderr:\n%s", t.Name, stderr.String())
   823			}
   824			return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
   825		}
   826	
   827		entry := CacheEntry{
   828			CacheKey:   key,
   829			TargetName: t.Name,
   830			Timestamp:  time.Now().UTC().Format(time.RFC3339),
   831			Outputs:    t.Outputs,
   832		}
   833		if err := writeCacheEntry(e.cacheDir, entry); err != nil {
   834			fmt.Fprintln(os.Stderr, err)
   835			return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
   836		}
   837		return execResult{name: t.Name, status: "built", durationMS: elapsed, cacheKey: key}
   838	}
   839	
   840	func computeCacheKey(t *TargetConfig, configDir string) (string, error) {
   841		h := sha256.New()
   842		if _, err := io.WriteString(h, t.Command); err != nil {
   843			return "", err
   844		}
   845	
   846		envKeys := make([]string, 0, len(t.Env))
   847		for k := range t.Env {
   848			envKeys = append(envKeys, k)
   849		}
   850		sort.Strings(envKeys)
   851		for _, k := range envKeys {
   852			if _, err := io.WriteString(h, k+"="+t.Env[k]); err != nil {
   853				return "", err
   854			}
   855		}
   856	
   857		inputPaths := make([]string, len(t.Inputs))
   858		copy(inputPaths, t.Inputs)
   859		sort.Strings(inputPaths)
   860		for _, p := range inputPaths {
   861			contentHash, err := hashFile(resolvePath(configDir, p))
   862			if err != nil {
   863				contentHash = hashBytes(nil)
   864			}
   865			if _, err := io.WriteString(h, contentHash); err != nil {
   866				return "", err
   867			}
   868		}
   869		return hex.EncodeToString(h.Sum(nil)), nil
   870	}
   871	
   872	func mergedEnv(env map[string]string) []string {
   873		out := map[string]string{}
   874		for _, kv := range os.Environ() {
   875			parts := strings.SplitN(kv, "=", 2)
   876			if len(parts) == 2 {
   877				out[parts[0]] = parts[1]
   878			} else {
   879				out[parts[0]] = ""
   880			}
   881		}
   882		for k, v := range env {
   883			out[k] = v
   884		}
   885		result := make([]string, 0, len(out))
   886		for k, v := range out {
   887			result = append(result, k+"="+v)
   888		}
   889		sort.Strings(result)
   890		return result
   891	}
