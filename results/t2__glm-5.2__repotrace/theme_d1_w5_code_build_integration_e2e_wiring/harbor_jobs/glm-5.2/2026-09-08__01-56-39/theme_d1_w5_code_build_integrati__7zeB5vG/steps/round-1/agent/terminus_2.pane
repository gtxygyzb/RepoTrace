   656	func selectTargets(cfg *Config, targetMap map[string]*TargetConfig, targetsFlag string) (map[string]bool, error) {
   657		if strings.TrimSpace(targetsFlag) == "" {
   658			requested := map[string]bool{}
   659			for _, t := range cfg.Targets {
   660				requested[t.Name] = true
   661			}
   662			return requested, nil
   663		}
   664	
   665		requested := map[string]bool{}
   666		for _, part := range strings.Split(targetsFlag, ",") {
   667			name := strings.TrimSpace(part)
   668			if _, ok := targetMap[name]; !ok {
   669				return nil, fmt.Errorf("target %q not found", name)
   670			}
   671			var visit func(string)
   672			visit = func(n string) {
   673				if requested[n] {
   674					return
   675				}
   676				requested[n] = true
   677				for _, dep := range targetMap[n].Dependencies {
   678					visit(dep)
   679				}
   680			}
   681			visit(name)
   682		}
   683		return requested, nil
   684	}
