   235	func runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string, vars []string, keepGoing bool, profile bool) error {
   236		cfg, configDir, err := loadConfig(configPath, vars)
   237		if err != nil {
   238			return err
   239		}
   240		targetMap, err := validateConfig(cfg)
   241		if err != nil {
   242			return err
   243		}
   244		requested, err := selectTargets(cfg, targetMap, targetsFlag)
   245		if err != nil {
   246			return err
   247		}
   248		order := topologicalOrder(cfg, requested)
   249		reverseDeps := buildReverseDeps(cfg, requested)
   250	
   251		cacheKeys := make(map[string]string)
   252		for i := range cfg.Targets {
   253			t := &cfg.Targets[i]
   254			if !requested[t.Name] {
   255				continue
   256			}
   257			key, err := computeCacheKey(t, configDir)
   258			if err != nil {
   259				return err
   260			}
   261			cacheKeys[t.Name] = key
   262		}
   263	
   264		executor := &buildExecutor{
   265			config:    cfg,
   266			configDir: configDir,
   267			cacheDir:  filepath.Join(configDir, ".buildctl-cache"),
   268			noCache:   noCache,
   269		}
   270	
   271		status := make(map[string]string)
   272		durations := make(map[string]int64)
   273		completed := 0
   274		total := len(requested)
   275		readyCh := make(chan *TargetConfig, total+1)
   276		resultCh := make(chan execResult, total+1)
   277	
   278		var mu sync.Mutex
   279		started := make(map[string]bool)
   280		cancelled := false
   281	
   282		var wg sync.WaitGroup
   283		for i := 0; i < parallel; i++ {
   284			wg.Add(1)
   285			go func() {
   286				defer wg.Done()
   287				for t := range readyCh {
   288					mu.Lock()
   289					if cancelled {
   290						mu.Unlock()
   291						continue
   292					}
   293					started[t.Name] = true
   294					mu.Unlock()
   295					res := executor.execute(t)
   296					if res.status == "failed" && !keepGoing {
   297						mu.Lock()
   298						cancelled = true
   299						mu.Unlock()
   300					}
   301					resultCh <- res
   302				}
   303			}()
   304		}
   305	
   306		buildStart := time.Now()
   307		for i := range cfg.Targets {
   308			t := &cfg.Targets[i]
   309			if requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {
   310				readyCh <- t
   311			}
   312		}
   313	
   314		for completed < total {
   315			res := <-resultCh
   316			status[res.name] = res.status
   317			durations[res.name] = res.durationMS
   318			if res.cacheKey != "" {
   319				cacheKeys[res.name] = res.cacheKey
   320			}
   321			completed++
   322	
   323			if res.status == "built" || res.status == "cached" {
   324				mu.Lock()
   325				canSchedule := !cancelled
   326				mu.Unlock()
   327				if canSchedule {
   328					for _, dependent := range reverseDeps[res.name] {
   329						if allDependenciesComplete(dependent, targetMap, requested, status) {
   330							readyCh <- targetMap[dependent]
   331						}
   332					}
   333				}
   334				continue
   335			}
   336	
   337			if res.status == "failed" {
   338				markSkipped(reverseDeps, status, durations, &completed, res.name)
   339				if !keepGoing {
   340					mu.Lock()
   341					cancelled = true
   342					for i := range cfg.Targets {
   343						t := &cfg.Targets[i]
   344						if !requested[t.Name] {
   345							continue
   346						}
   347						if status[t.Name] == "" && !started[t.Name] {
   348							status[t.Name] = "cancelled"
   349							durations[t.Name] = 0
   350							completed++
   351						}
   352					}
   353					mu.Unlock()
   354				}
   355				continue
   356			}
   357		}
   358	
   359		close(readyCh)
   360		wg.Wait()
   361	
   362		report := BuildReport{Pipeline: cfg.Pipeline.Name, Targets: []BuildTargetReport{}}
   363		for _, name := range order {
   364			st := status[name]
   365			if st == "" {
   366				if keepGoing {
   367					st = "skipped"
   368				} else {
   369					st = "cancelled"
   370				}
   371			}
   372			report.Targets = append(report.Targets, BuildTargetReport{
   373				Name:       name,
   374				Status:     st,
   375				Cached:     st == "cached",
   376				DurationMS: durations[name],
   377				CacheKey:   cacheKeys[name],
   378			})
   379		}
   380	
   381		summary := BuildSummary{Total: len(report.Targets)}
   382		for _, t := range report.Targets {
   383			switch t.Status {
   384			case "built":
   385				summary.Built++
   386			case "cached":
   387				summary.Cached++
   388			case "failed":
   389				summary.Failed++
   390			case "skipped":
   391				summary.Skipped++
   392			case "cancelled":
   393				summary.Cancelled++
   394			}
   395		}
   396		summary.DurationMS = time.Since(buildStart).Milliseconds()
   397		report.Summary = summary
   398	
   399		if profile {
   400			report.Profile = computeBuildProfile(report.Targets, cfg, targetMap)
   401		}
   402	
   403		data, err := json.MarshalIndent(report, "", "  ")
   404		if err != nil {
   405			return err
   406		}
   407		fmt.Println(string(data))
   408		if reportPath != "" {
   409			if err := os.WriteFile(reportPath, data, 0644); err != nil {
   410				return err
   411			}
   412		}
   413		if summary.Failed > 0 {
   414			return fmt.Errorf("build failed")
   415		}
   416		return nil
   417	}
   418	
   419	func runGraph(configPath string, vars []string) error {
   420		cfg, _, err := loadConfig(configPath, vars)
   421		if err != nil {
   422			return err
   423		}
   424		if _, err := validateConfig(cfg); err != nil {
   425			return err
   426		}
   427		fmt.Printf("digraph %s {\n", strconv.Quote(cfg.Pipeline.Name))
   428		for _, t := range cfg.Targets {
   429			if len(uniqueStrings(t.Dependencies)) == 0 {
   430				fmt.Printf("  %s;\n", strconv.Quote(t.Name))
   431			}
   432		}
   433		for _, t := range cfg.Targets {
   434			for _, dep := range uniqueStrings(t.Dependencies) {
   435				fmt.Printf("  %s -> %s;\n", strconv.Quote(t.Name), strconv.Quote(dep))
   436			}
   437		}
   438		fmt.Println("}")
   439		return nil
   440	}
