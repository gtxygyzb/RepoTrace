   811	func markSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {
   812		for _, dependent := range reverseDeps[name] {
   813			switch status[dependent] {
   814			case "", "cancelled":
   815				wasCancelled := status[dependent] == "cancelled"
