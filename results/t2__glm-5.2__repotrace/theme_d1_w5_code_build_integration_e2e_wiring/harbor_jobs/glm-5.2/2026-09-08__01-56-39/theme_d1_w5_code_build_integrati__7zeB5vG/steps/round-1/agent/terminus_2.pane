   482	func (l *configLoader) loadFile(absPath string, isRoot bool) error {
   483		for _, p := range l.importStack {
   484			if p == absPath {
   485				chain := append([]string{}, l.importStack...)
   486				chain = append(chain, absPath)
   487				return fmt.Errorf("circular import detected: %s", strings.Join(chain, " -> "))
   488			}
   489		}
   490		l.importStack = append(l.importStack, absPath)
   491		defer func() { l.importStack = l.importStack[:len(l.importStack)-1] }()
   492	
   493		var fileCfg Config
   494		if _, err := toml.DecodeFile(absPath, &fileCfg); err != nil {
   495			return err
   496		}
   497	
   498		if isRoot {
   499			l.pipelineName = fileCfg.Pipeline.Name
   500			l.rootImports = fileCfg.Pipeline.Imports
   501		}
   502	
   503		for k, v := range fileCfg.Variables {
   504			if _, exists := l.variables[k]; !exists {
   505				l.variables[k] = v
   506			}
   507		}
   508	
   509		for _, imp := range fileCfg.Pipeline.Imports {
   510			expanded, err := expandString(imp, l.variables, make(map[string]bool))
   511			if err != nil {
   512				return err
   513			}
   514			importPath := expanded
   515			if !filepath.IsAbs(importPath) {
   516				importPath = filepath.Join(filepath.Dir(absPath), importPath)
   517			}
   518			importAbs, err := filepath.Abs(importPath)
   519			if err != nil {
   520				return err
   521			}
   522			if err := l.loadFile(importAbs, false); err != nil {
   523				return err
   524			}
   525		}
   526	
   527		for _, t := range fileCfg.Targets {
   528			if l.targetNames[t.Name] {
   529				return fmt.Errorf("duplicate target name %q", t.Name)
   530			}
   531			l.targetNames[t.Name] = true
   532			l.targets = append(l.targets, t)
   533		}
   534	
   535		return nil
   536	}
