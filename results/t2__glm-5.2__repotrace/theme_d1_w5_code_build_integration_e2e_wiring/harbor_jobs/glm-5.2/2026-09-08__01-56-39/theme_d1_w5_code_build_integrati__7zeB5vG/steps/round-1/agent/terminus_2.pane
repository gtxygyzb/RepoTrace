   435		var stack []string
   436		var dfs func(name string) error
   437		dfs = func(name string) error {
   438			states[name] = 1
   439			stack = append(stack, name)
   440			for _, dep := range targetMap[name].Dependencies {
   441				if states[dep] == 1 {
   442					idx := 0
   443					for i, s := range stack {
   444						if s == dep {
   445							idx = i
   446							break
   447						}
   448					}
   449					cycle := append([]string{}, stack[idx:]...)
   450					cycle = append(cycle, dep)
   451					return fmt.Errorf("cycle detected: %s", strings.Join(cycle, " -> "))
   452				}
   453				if states[dep] == 0 {
   454					if err := dfs(dep); err != nil {
   455						return err
   456					}
   457				}
   458			}
   459			stack = stack[:len(stack)-1]
   460			states[name] = 2
   461			return nil
   462		}
   463	
   464		names := make([]string, 0, len(targetMap))
   465		for n := range targetMap {
   466			names = append(names, n)
   467		}
   468		sort.Strings(names)
   469		for _, n := range names {
   470			if states[n] == 0 {
   471				if err := dfs(n); err != nil {
   472					return nil, err
   473				}
   474			}
   475		}
   476		return targetMap, nil
   477	}
   478	
   479	func selectTargets(cfg *Config, targetMap map[string]*TargetConfig, targetsFlag string) (map[string]bool, error) {
   480		if strings.TrimSpace(targetsFlag) == "" {
   481			requested := map[string]bool{}
   482			for _, t := range cfg.Targets {
   483				requested[t.Name] = true
   484			}
   485			return requested, nil
   486		}
   487	
   488		requested := map[string]bool{}
   489		for _, part := range strings.Split(targetsFlag, ",") {
   490			name := strings.TrimSpace(part)
   491			if _, ok := targetMap[name]; !ok {
   492				return nil, fmt.Errorf("target %q not found", name)
   493			}
   494			var visit func(string)
   495			visit = func(n string) {
   496				if requested[n] {
   497					return
   498				}
   499				requested[n] = true
   500				for _, dep := range targetMap[n].Dependencies {
   501					visit(dep)
   502				}
   503			}
   504			visit(name)
   505		}
   506		return requested, nil
   507	}
   508	
   509	func topologicalOrder(cfg *Config, requested map[string]bool) []string {
   510		indeg := map[string]int{}
   511		for _, t := range cfg.Targets {
   512			if !requested[t.Name] {
   513				continue
   514			}
   515			count := 0
   516			for _, dep := range uniqueStrings(t.Dependencies) {
   517				if requested[dep] {
   518					count++
   519				}
   520			}
   521			indeg[t.Name] = count
   522		}
   523	
   524		queue := []string{}
   525		for _, t := range cfg.Targets {
   526			if requested[t.Name] && indeg[t.Name] == 0 {
   527				queue = append(queue, t.Name)
   528			}
   529		}
   530	
   531		order := []string{}
   532		for len(queue) > 0 {
   533			name := queue[0]
   534			queue = queue[1:]
   535			order = append(order, name)
   536			for _, t := range cfg.Targets {
   537				if !requested[t.Name] {
   538					continue
   539				}
   540				for _, dep := range uniqueStrings(t.Dependencies) {
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '541,760p'
[?2004l   541					if dep == name {
   542						indeg[t.Name]--
   543						if indeg[t.Name] == 0 {
   544							queue = append(queue, t.Name)
   545						}
   546						break
   547					}
   548				}
   549			}
   550		}
   551		return order
   552	}
   553	
   554	func buildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {
   555		reverse := map[string][]string{}
   556		for _, t := range cfg.Targets {
   557			if !requested[t.Name] {
   558				continue
   559			}
   560			for _, dep := range uniqueStrings(t.Dependencies) {
   561				if requested[dep] {
   562					reverse[dep] = append(reverse[dep], t.Name)
   563				}
   564			}
   565		}
   566		return reverse
   567	}
   568	
   569	func allDependenciesComplete(name string, targetMap map[string]*TargetConfig, requested map[string]bool, status map[string]string) bool {
   570		for _, dep := range targetMap[name].Dependencies {
   571			if !requested[dep] {
   572				continue
   573			}
   574			s := status[dep]
   575			if s != "built" && s != "cached" {
   576				return false
   577			}
   578		}
   579		return true
   580	}
   581	
   582	func markSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {
   583		for _, dependent := range reverseDeps[name] {
   584			if status[dependent] == "" {
   585				status[dependent] = "skipped"
   586				durations[dependent] = 0
   587				*completed++
   588				markSkipped(reverseDeps, status, durations, completed, dependent)
   589			}
   590		}
   591	}
   592	
   593	func (e *buildExecutor) execute(t *TargetConfig) execResult {
   594		start := time.Now()
   595		key, err := computeCacheKey(t, e.configDir)
   596		if err != nil {
   597			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   598		}
   599	
   600		if !e.noCache {
   601			valid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)
   602			if err != nil {
   603				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   604			}
   605			if valid {
   606				return execResult{name: t.Name, status: "cached", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   607			}
   608		}
   609	
   610		timeout := t.Timeout
   611		if timeout <= 0 {
   612			timeout = 300
   613		}
   614	
   615		var stdout, stderr bytes.Buffer
   616		cmd := exec.Command("sh", "-c", t.Command)
   617		cmd.Dir = e.configDir
   618		cmd.Env = mergedEnv(t.Env)
   619		cmd.Stdout = &stdout
   620		cmd.Stderr = &stderr
   621		cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
   622	
   623		if err := cmd.Start(); err != nil {
   624			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   625		}
   626	
   627		waitCh := make(chan error, 1)
   628		go func() {
   629			waitCh <- cmd.Wait()
   630		}()
   631	
   632		var runErr error
   633		select {
   634		case <-time.After(time.Duration(timeout) * time.Second):
   635			if cmd.Process != nil {
   636				_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
   637			}
   638			<-waitCh
   639			runErr = fmt.Errorf("target %q timed out after %ds", t.Name, timeout)
   640		case err := <-waitCh:
   641			if err != nil {
   642				runErr = err
   643			}
   644		}
   645	
   646		elapsed := time.Since(start).Milliseconds()
   647		if runErr != nil {
   648			if stderr.Len() > 0 {
   649				fmt.Fprintf(os.Stderr, "target %q stderr:\n%s", t.Name, stderr.String())
   650			}
   651			return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
   652		}
   653	
   654		entry := CacheEntry{
   655			CacheKey:   key,
   656			TargetName: t.Name,
   657			Timestamp:  time.Now().UTC().Format(time.RFC3339),
   658			Outputs:    t.Outputs,
   659		}
   660		if err := writeCacheEntry(e.cacheDir, entry); err != nil {
   661			fmt.Fprintln(os.Stderr, err)
   662			return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
   663		}
   664		return execResult{name: t.Name, status: "built", durationMS: elapsed, cacheKey: key}
   665	}
   666	
   667	func computeCacheKey(t *TargetConfig, configDir string) (string, error) {
   668		h := sha256.New()
   669		if _, err := io.WriteString(h, t.Command); err != nil {
   670			return "", err
   671		}
   672	
   673		envKeys := make([]string, 0, len(t.Env))
   674		for k := range t.Env {
   675			envKeys = append(envKeys, k)
   676		}
   677		sort.Strings(envKeys)
   678		for _, k := range envKeys {
   679			if _, err := io.WriteString(h, k+"="+t.Env[k]); err != nil {
   680				return "", err
   681			}
   682		}
   683	
   684		inputPaths := make([]string, len(t.Inputs))
   685		copy(inputPaths, t.Inputs)
   686		sort.Strings(inputPaths)
   687		for _, p := range inputPaths {
   688			contentHash, err := hashFile(resolvePath(configDir, p))
   689			if err != nil {
   690				contentHash = hashBytes(nil)
   691			}
   692			if _, err := io.WriteString(h, contentHash); err != nil {
   693				return "", err
   694			}
   695		}
   696		return hex.EncodeToString(h.Sum(nil)), nil
   697	}
   698	
   699	func mergedEnv(env map[string]string) []string {
   700		out := map[string]string{}
   701		for _, kv := range os.Environ() {
   702			parts := strings.SplitN(kv, "=", 2)
   703			if len(parts) == 2 {
   704				out[parts[0]] = parts[1]
   705			} else {
   706				out[parts[0]] = ""
   707			}
   708		}
   709		for k, v := range env {
   710			out[k] = v
   711		}
   712		result := make([]string, 0, len(out))
   713		for k, v := range out {
   714			result = append(result, k+"="+v)
   715		}
   716		sort.Strings(result)
   717		return result
   718	}
   719	
   720	func cacheValid(cacheDir, key string, outputs []string, configDir string) (bool, CacheEntry, error) {
   721		entry, ok, err := readCacheEntry(cacheDir, key)
   722		if err != nil {
   723			return false, CacheEntry{}, err
   724		}
   725		if !ok {
   726			return false, CacheEntry{}, nil
   727		}
   728		for _, out := range outputs {
   729			if !fileExists(resolvePath(configDir, out)) {
   730				return false, CacheEntry{}, nil
   731			}
   732		}
   733		return true, entry, nil
   734	}
   735	
   736	func readCacheEntry(cacheDir, key string) (CacheEntry, bool, error) {
   737		path := filepath.Join(cacheDir, key+".json")
   738		data, err := os.ReadFile(path)
   739		if os.IsNotExist(err) {
   740			return CacheEntry{}, false, nil
   741		}
   742		if err != nil {
   743			return CacheEntry{}, false, err
   744		}
   745		var entry CacheEntry
   746		if err := json.Unmarshal(data, &entry); err != nil {
   747			return CacheEntry{}, false, nil
   748		}
   749		if entry.CacheKey != "" && entry.CacheKey != key {
   750			return CacheEntry{}, false, nil
   751		}
   752		if entry.CacheKey == "" {
   753			entry.CacheKey = key
   754		}
   755		return entry, true, nil
   756	}
