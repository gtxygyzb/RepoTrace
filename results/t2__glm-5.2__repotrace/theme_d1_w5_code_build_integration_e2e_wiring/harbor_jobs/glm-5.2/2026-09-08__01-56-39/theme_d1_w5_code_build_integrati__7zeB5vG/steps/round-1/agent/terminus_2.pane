func matrixCombinations(matrix map[string][]string, include []map[string]string, exclude []map[string]string) ([]map[string]string, error) {
	keys := make([]string, 0, len(matrix))
	for k := range matrix {
		keys = append(keys, k)
	}
	sort.Strings(keys)

	for _, inc := range include {
		if len(inc) != len(matrix) {
			return nil, fmt.Errorf("matrix_include entry must specify exactly the same keys as matrix")
		}
		for k := range inc {
			if _, ok := matrix[k]; !ok {
				return nil, fmt.Errorf("matrix_include entry must specify exactly the same keys as matrix")
			}
		}
	}

	var product []map[string]string
	if len(keys) == 0 {
		product = []map[string]string{{}}
	} else {
		product = []map[string]string{{}}
		for _, key := range keys {
			var next []map[string]string
			for _, combo := range product {
				for _, val := range matrix[key] {
					c := make(map[string]string, len(combo)+1)
					for k, v := range combo {
						c[k] = v
					}
					c[key] = val
					next = append(next, c)
				}
			}
			product = next
		}
	}

	for _, inc := range include {
		dup := false
		for _, combo := range product {
			if mapEqual(combo, inc) {
				dup = true
				break
			}
		}
		if !dup {
			product = append(product, inc)
		}
	}

	filtered := make([]map[string]string, 0, len(product))
	for _, combo := range product {
		if !matrixExcluded(combo, exclude) {
			filtered = append(filtered, combo)
		}
	}
	return filtered, nil
}

func mapEqual(a, b map[string]string) bool {
	if len(a) != len(b) {
		return false
	}
	for k, v := range a {
		if w, ok := b[k]; !ok || v != w {
			return false
		}
	}
	return true
}

func matrixExcluded(combo map[string]string, excludes []map[string]string) bool {
	for _, excl := range excludes {
		match := true
		for k, v := range excl {
			cv, ok := combo[k]
			if !ok || cv != v {
				match = false
				break
			}
		}
		if match {
			return true
		}
	}
	return false
}

func substituteMatrixVars(s string, combo map[string]string) string {
	var b strings.Builder
	i := 0
	for i < len(s) {
		if i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {
			end := strings.Index(s[i:], "}")
			if end == -1 {
				b.WriteByte(s[i])
				i++
				continue
			}
			name := s[i+2 : i+end]
			if val, ok := combo[name]; ok {
				b.WriteString(val)
				i += end + 1
				continue
			}
		}
		b.WriteByte(s[i])
		i++
	}
	return b.String()
}

func substituteMatrixSlice(slice []string, combo map[string]string) []string {
	out := make([]string, len(slice))
	for i, s := range slice {
		out[i] = substituteMatrixVars(s, combo)
	}
	return out
}

func substituteMatrixEnv(env map[string]string, combo map[string]string) map[string]string {
	if env == nil {
		return nil
	}
	out := make(map[string]string, len(env))
	for k, v := range env {
		out[k] = substituteMatrixVars(v, combo)
	}
	return out
}
