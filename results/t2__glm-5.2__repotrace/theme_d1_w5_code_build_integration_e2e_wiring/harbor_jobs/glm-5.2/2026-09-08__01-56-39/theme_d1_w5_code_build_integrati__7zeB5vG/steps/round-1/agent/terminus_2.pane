   776	
   777	func buildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {
   778		reverse := map[string][]string{}
   779		for _, t := range cfg.Targets {
   780			if !requested[t.Name] {
   781				continue
   782			}
   783			for _, dep := range uniqueStrings(t.Dependencies) {
   784				if requested[dep] {
   785					reverse[dep] = append(reverse[dep], t.Name)
   786				}
   787			}
   788		}
   789		return reverse
   790	}
