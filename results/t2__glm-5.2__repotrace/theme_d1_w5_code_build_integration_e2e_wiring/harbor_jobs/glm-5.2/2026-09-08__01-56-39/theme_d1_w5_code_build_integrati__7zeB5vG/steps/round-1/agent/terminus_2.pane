   920			return CacheEntry{}, false, nil
   921		}
   922		if entry.CacheKey != "" && entry.CacheKey != key {
   923			return CacheEntry{}, false, nil
   924		}
   925		if entry.CacheKey == "" {
   926			entry.CacheKey = key
   927		}
   928		return entry, true, nil
   929	}
