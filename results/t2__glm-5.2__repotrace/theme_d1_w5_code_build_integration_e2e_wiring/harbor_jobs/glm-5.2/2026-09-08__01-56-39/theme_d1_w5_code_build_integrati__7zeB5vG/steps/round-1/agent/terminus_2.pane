[?2004l	for _, dependent := range reverseDeps[name] {
		if status[dependent] == "" {
			status[dependent] = "skipped"
			durations[dependent] = 0
			*completed++
			markSkipped(reverseDeps, status, durations, completed, dependent)
		}
	}
}

func (e *buildExecutor) execute(t *TargetConfig) execResult {
	start := time.Now()
	key, err := computeCacheKey(t, e.configDir)
	if err != nil {
		return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
	}

	if !e.noCache {
		valid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)
		if err != nil {
			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
		}
		if valid {
			return execResult{name: t.Name, status: "cached", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}
		}
	}

	timeout := t.Timeout
	if timeout <= 0 {
		timeout = 300
	}
	deadline := time.Now().Add(time.Duration(timeout) * time.Second)

	baseEnv := mergedEnv(t.Env)
	preEnv := append([]string(nil), baseEnv...)

	for _, hook := range t.PreBuild {
		stdout, err := e.runCommand(t, hook, preEnv, deadline)
		if err != nil {
			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
		}
		preEnv = mergeHookExports(preEnv, parseHookExports(stdout))
	}

	mainEnv := preEnv
	if _, err := e.runCommand(t, t.Command, mainEnv, deadline); err != nil {
		return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
	}

	postEnv := append([]string(nil), baseEnv...)
	for _, hook := range t.PostBuild {
		stdout, err := e.runCommand(t, hook, postEnv, deadline)
		if err != nil {
			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
		}
		postEnv = mergeHookExports(postEnv, parseHookExports(stdout))
	}

	elapsed := time.Since(start).Milliseconds()
	entry := CacheEntry{
		CacheKey:   key,
		TargetName: t.Name,
		Timestamp:  time.Now().UTC().Format(time.RFC3339),
		Outputs:    t.Outputs,
	}
	if err := writeCacheEntry(e.cacheDir, entry); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
	}
	return execResult{name: t.Name, status: "built", durationMS: elapsed, cacheKey: key}
}

func (e *buildExecutor) runCommand(t *TargetConfig, command string, env []string, deadline time.Time) (string, error) {
	if strings.TrimSpace(command) == "" {
		return "", nil
	}
	remaining := time.Until(deadline)
	if remaining <= 0 {
		return "", fmt.Errorf("target %q timed out after %ds", t.Name, t.Timeout)
	}

	var stdout, stderr bytes.Buffer
	ctx, cancel := context.WithTimeout(context.Background(), remaining)
	defer cancel()
	cmd := exec.CommandContext(ctx, "sh", "-c", command)
	cmd.Dir = e.configDir
	cmd.Env = env
	cmd.Stdout = &stdout
	cmd.Stderr = &stderr
	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}

	if err := cmd.Start(); err != nil {
		return "", err
	}

	waitCh := make(chan error, 1)
	go func() {
		waitCh <- cmd.Wait()
	}()

	select {
	case <-ctx.Done():
		if cmd.Process != nil {
			_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
		}
		<-waitCh
		return "", fmt.Errorf("target %q timed out after %ds", t.Name, t.Timeout)
	case err := <-waitCh:
		if err != nil {
			if stderr.Len() > 0 {
				fmt.Fprintf(os.Stderr, "target %q stderr:\n%s", t.Name, stderr.String())
			}
			return "", err
		}
	}
	return stdout.String(), nil
}

func computeCacheKey(t *TargetConfig, configDir string) (string, error) {
	h := sha256.New()
	if _, err := io.WriteString(h, t.Command); err != nil {
		return "", err
	}

	for _, hook := range t.PreBuild {
		if _, err := io.WriteString(h, hook); err != nil {
			return "", err
		}
	}
	for _, hook := range t.PostBuild {
		if _, err := io.WriteString(h, hook); err != nil {
			return "", err
		}
	}

	deps := make([]string, len(t.Dependencies))
	copy(deps, t.Dependencies)
	sort.Strings(deps)
	for _, d := range deps {
		if _, err := io.WriteString(h, "dep:"+d); err != nil {
			return "", err
		}
	}

	outputs := make([]string, len(t.Outputs))
	copy(outputs, t.Outputs)
	sort.Strings(outputs)
	for _, p := range outputs {
		if _, err := io.WriteString(h, "out:"+p); err != nil {
			return "", err
		}
	}

	envKeys := make([]string, 0, len(t.Env))
	for k := range t.Env {
		envKeys = append(envKeys, k)
	}
	sort.Strings(envKeys)
	for _, k := range envKeys {
		if _, err := io.WriteString(h, k+"="+t.Env[k]); err != nil {
			return "", err
		}
	}

	inputPaths := make([]string, len(t.Inputs))
	copy(inputPaths, t.Inputs)
	sort.Strings(inputPaths)
	for _, p := range inputPaths {
		contentHash, err := hashFile(resolvePath(configDir, p))
		if err != nil {
			contentHash = hashBytes(nil)
		}
		if _, err := io.WriteString(h, contentHash); err != nil {
			return "", err
		}
	}
	return hex.EncodeToString(h.Sum(nil)), nil
}

func mergedEnv(env map[string]string) []string {
	out := map[string]string{}
	for _, kv := range os.Environ() {
		parts := strings.SplitN(kv, "=", 2)
		if len(parts) == 2 {
			out[parts[0]] = parts[1]
		} else {
			out[parts[0]] = ""
		}
	}
	for k, v := range env {
		out[k] = v
	}
	result := make([]string, 0, len(out))
	for k, v := range out {
		result = append(result, k+"="+v)
	}
	sort.Strings(result)
	return result
}

var hookExportRe = regexp.MustCompile(`^BUILDCTL_ENV:([A-Za-z_][A-Za-z0-9_]*)=(.*)$`)

func parseHookExports(stdout string) map[string]string {
	exports := map[string]string{}
	for _, line := range strings.Split(stdout, "\n") {
		m := hookExportRe.FindStringSubmatch(line)
		if len(m) == 3 {
			exports[m[1]] = m[2]
		}
	}
	return exports
}

func mergeHookExports(env []string, exports map[string]string) []string {
	if len(exports) == 0 {
		return env
	}
	out := make(map[string]string, len(env)+len(exports))
	for _, kv := range env {
		parts := strings.SplitN(kv, "=", 2)
		if len(parts) == 2 {
			out[parts[0]] = parts[1]
		} else {
			out[parts[0]] = ""
		}
	}
	for k, v := range exports {
		out[k] = v
	}
	result := make([]string, 0, len(out))
	for k, v := range out {
		result = append(result, k+"="+v)
	}
	sort.Strings(result)
	return result
}

func cacheValid(cacheDir, key string, outputs []string, configDir string) (bool, CacheEntry, error) {
	entry, ok, err := readCacheEntry(cacheDir, key)
	if err != nil {
		return false, CacheEntry{}, err
	}
	if !ok {
		return false, CacheEntry{}, nil
	}
	for _, out := range outputs {
		if !fileExists(resolvePath(configDir, out)) {
			return false, CacheEntry{}, nil
		}
	}
	return true, entry, nil
}

func readCacheEntry(cacheDir, key string) (CacheEntry, bool, error) {
	path := filepath.Join(cacheDir, key+".json")
	data, err := os.ReadFile(path)
	if os.IsNotExist(err) {
		return CacheEntry{}, false, nil
	}
	if err != nil {
		return CacheEntry{}, false, err
	}
	var entry CacheEntry
	if err := json.Unmarshal(data, &entry); err != nil {
		return CacheEntry{}, false, nil
	}
	if entry.CacheKey != "" && entry.CacheKey != key {
		return CacheEntry{}, false, nil
	}
	if entry.CacheKey == "" {
		entry.CacheKey = key
	}
	return entry, true, nil
}

func writeCacheEntry(cacheDir string, entry CacheEntry) error {
	if err := os.MkdirAll(cacheDir, 0755); err != nil {
		return err
	}
	data, err := json.MarshalIndent(entry, "", "  ")
	if err != nil {
		return err
	}
	return os.WriteFile(filepath.Join(cacheDir, entry.CacheKey+".json"), data, 0644)
}

func hashFile(path string) (string, error) {
	f, err := os.Open(path)
	if err != nil {
		return "", err
	}
	defer f.Close()
	h := sha256.New()
	if _, err := io.Copy(h, f); err != nil {
		return "", err
	}
	return hex.EncodeToString(h.Sum(nil)), nil
}

func hashBytes(b []byte) string {
	s := sha256.Sum256(b)
	return hex.EncodeToString(s[:])
}

func resolvePath(base, p string) string {
	if filepath.IsAbs(p) {
		return p
	}
	return filepath.Join(base, p)
}

func fileExists(path string) bool {
	_, err := os.Stat(path)
	return err == nil
}

func uniqueStrings(in []string) []string {
	seen := map[string]bool{}
	out := []string{}
	for _, s := range in {
		if !seen[s] {
			seen[s] = true
			out = append(out, s)
		}
	}
	return out
}
