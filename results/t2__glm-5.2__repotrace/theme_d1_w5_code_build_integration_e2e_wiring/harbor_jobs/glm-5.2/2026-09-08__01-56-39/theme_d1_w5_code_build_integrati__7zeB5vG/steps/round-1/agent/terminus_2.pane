   942	func hashFile(path string) (string, error) {
   943		f, err := os.Open(path)
   944		if err != nil {
   945			return "", err
   946		}
   947		defer f.Close()
   948		h := sha256.New()
   949		if _, err := io.Copy(h, f); err != nil {
   950			return "", err
   951		}
   952		return hex.EncodeToString(h.Sum(nil)), nil
   953	}
   954	
   955	func hashBytes(b []byte) string {
   956		s := sha256.Sum256(b)
   957		return hex.EncodeToString(s[:])
   958	}
   959	
   960	func resolvePath(base, p string) string {
   961		if filepath.IsAbs(p) {
   962			return p
   963		}
   964		return filepath.Join(base, p)
   965	}
   966	
   967	func fileExists(path string) bool {
   968		_, err := os.Stat(path)
   969		return err == nil
   970	}
   971	
   972	func uniqueStrings(in []string) []string {
   973		seen := map[string]bool{}
   974		out := []string{}
   975		for _, s := range in {
   976			if !seen[s] {
   977				seen[s] = true
   978				out = append(out, s)
   979			}
   980		}
   981		return out
   982	}
