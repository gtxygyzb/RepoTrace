   642	func validateConfig(cfg *Config) (map[string]*TargetConfig, error) {
   643		targetMap := map[string]*TargetConfig{}
   644		for i := range cfg.Targets {
   645			t := &cfg.Targets[i]
   646			if t.Name == "" {
   647				return nil, fmt.Errorf("target name is empty")
   648			}
   649			if _, ok := targetMap[t.Name]; ok {
   650				return nil, fmt.Errorf("duplicate target name %q", t.Name)
   651			}
   652			targetMap[t.Name] = t
   653		}
   654	
   655		for _, t := range targetMap {
   656			for _, dep := range t.Dependencies {
   657				if _, ok := targetMap[dep]; !ok {
   658					return nil, fmt.Errorf("target %q depends on missing target %q", t.Name, dep)
   659				}
   660			}
   661		}
   662	
   663		states := map[string]int{}
   664		var stack []string
   665		var dfs func(name string) error
   666		dfs = func(name string) error {
   667			states[name] = 1
   668			stack = append(stack, name)
   669			for _, dep := range targetMap[name].Dependencies {
   670				if states[dep] == 1 {
   671					idx := 0
   672					for i, s := range stack {
   673						if s == dep {
   674							idx = i
   675							break
   676						}
   677					}
   678					cycle := append([]string{}, stack[idx:]...)
   679					cycle = append(cycle, dep)
   680					return fmt.Errorf("cycle detected: %s", strings.Join(cycle, " -> "))
   681				}
   682				if states[dep] == 0 {
   683					if err := dfs(dep); err != nil {
   684						return err
   685					}
   686				}
   687			}
   688			stack = stack[:len(stack)-1]
   689			states[name] = 2
   690			return nil
   691		}
   692	
   693		names := make([]string, 0, len(targetMap))
   694		for n := range targetMap {
   695			names = append(names, n)
   696		}
   697		sort.Strings(names)
   698		for _, n := range names {
   699			if states[n] == 0 {
   700				if err := dfs(n); err != nil {
   701					return nil, err
   702				}
   703			}
   704		}
   705		return targetMap, nil
   706	}
