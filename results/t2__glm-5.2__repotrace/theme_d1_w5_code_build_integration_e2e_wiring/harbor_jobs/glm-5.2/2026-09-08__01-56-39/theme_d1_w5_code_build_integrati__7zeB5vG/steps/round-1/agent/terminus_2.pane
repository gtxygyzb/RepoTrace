   732	
   733	func buildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {
   734		reverse := map[string][]string{}
   735		for _, t := range cfg.Targets {
   736			if !requested[t.Name] {
   737				continue
   738			}
   739			for _, dep := range uniqueStrings(t.Dependencies) {
   740				if requested[dep] {
   741					reverse[dep] = append(reverse[dep], t.Name)
   742				}
   743			}
   744		}
   745		return reverse
   746	}
   747	
   748	func allDependenciesComplete(name string, targetMap map[string]*TargetConfig, requested map[string]bool, status map[string]string) bool {
   749		for _, dep := range targetMap[name].Dependencies {
   750			if !requested[dep] {
   751				continue
   752			}
   753			s := status[dep]
   754			if s != "built" && s != "cached" {
   755				return false
   756			}
   757		}
   758		return true
   759	}
   760	
   761	func markSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {
   762		for _, dependent := range reverseDeps[name] {
   763			if status[dependent] == "" {
   764				status[dependent] = "skipped"
   765				durations[dependent] = 0
   766				*completed++
   767				markSkipped(reverseDeps, status, durations, completed, dependent)
   768			}
   769		}
   770	}
