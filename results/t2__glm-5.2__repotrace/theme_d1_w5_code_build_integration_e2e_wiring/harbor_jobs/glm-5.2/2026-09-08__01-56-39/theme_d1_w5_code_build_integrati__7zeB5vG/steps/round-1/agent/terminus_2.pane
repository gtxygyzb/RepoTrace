   531	func parseVarOverrides(vars []string) (map[string]string, error) {
   532		m := make(map[string]string)
   533		for _, v := range vars {
   534			idx := strings.Index(v, "=")
   535			if idx == -1 {
   536				return nil, fmt.Errorf("invalid --var %q, expected key=value", v)
   537			}
   538			key := v[:idx]
   539			if key == "" {
   540				return nil, fmt.Errorf("invalid --var %q, empty key", v)
   541			}
   542			m[key] = v[idx+1:]
   543		}
   544		return m, nil
   545	}
