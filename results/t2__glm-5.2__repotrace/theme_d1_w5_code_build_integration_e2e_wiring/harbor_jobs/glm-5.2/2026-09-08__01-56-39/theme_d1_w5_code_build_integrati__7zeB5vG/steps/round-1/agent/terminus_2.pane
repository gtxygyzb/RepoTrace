	CacheKey string `json:"cache_key,omitempty"`
	CachedAt string `json:"cached_at,omitempty"`
}

type StatusReport struct {
	Targets []StatusTarget `json:"targets"`
}

type execResult struct {
	name       string
	status     string
	cached     bool
	durationMS int64
	cacheKey   string
}

type buildExecutor struct {
	config    *Config
	configDir string
	cacheDir  string
	noCache   bool
}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: buildctl <command> [flags]")
		os.Exit(1)
	}
	switch os.Args[1] {
	case "build":
		runBuildCommand(os.Args[2:])
	case "graph":
		runGraphCommand(os.Args[2:])
	case "clean":
		runCleanCommand(os.Args[2:])
	case "status":
		runStatusCommand(os.Args[2:])
	default:
		fmt.Fprintf(os.Stderr, "unknown command %q\n", os.Args[1])
		os.Exit(1)
	}
}

func runBuildCommand(args []string) {
	fs := flag.NewFlagSet("build", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	configPath := fs.String("config", "", "path to TOML pipeline file")
	targetsFlag := fs.String("targets", "", "comma-separated target names")
	parallel := fs.Int("parallel", runtime.NumCPU(), "max concurrent target executions")
	noCache := fs.Bool("no-cache", false, "skip all cache lookups")
	reportPath := fs.String("report", "", "also write JSON report to this file")
	if err := fs.Parse(args); err != nil {
		os.Exit(1)
	}
	if *configPath == "" {
		fmt.Fprintln(os.Stderr, "error: --config is required")
		os.Exit(1)
	}
	if *parallel < 1 {
		fmt.Fprintln(os.Stderr, "error: --parallel must be at least 1")
		os.Exit(1)
	}
	if err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func runGraphCommand(args []string) {
	fs := flag.NewFlagSet("graph", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	configPath := fs.String("config", "", "path to TOML pipeline file")
	if err := fs.Parse(args); err != nil {
		os.Exit(1)
	}
	if *configPath == "" {
		fmt.Fprintln(os.Stderr, "error: --config is required")
		os.Exit(1)
	}
	if err := runGraph(*configPath); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

