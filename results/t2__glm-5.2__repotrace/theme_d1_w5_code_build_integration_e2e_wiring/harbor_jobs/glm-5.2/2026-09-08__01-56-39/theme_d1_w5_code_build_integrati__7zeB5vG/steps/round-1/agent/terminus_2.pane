   100	func main() {
   101		if len(os.Args) < 2 {
   102			fmt.Fprintln(os.Stderr, "usage: buildctl <command> [flags]")
   103			os.Exit(1)
   104		}
   105		switch os.Args[1] {
   106		case "build":
   107			runBuildCommand(os.Args[2:])
   108		case "graph":
   109			runGraphCommand(os.Args[2:])
   110		case "clean":
   111			runCleanCommand(os.Args[2:])
   112		case "status":
   113			runStatusCommand(os.Args[2:])
   114		default:
   115			fmt.Fprintf(os.Stderr, "unknown command %q\n", os.Args[1])
   116			os.Exit(1)
   117		}
   118	}
