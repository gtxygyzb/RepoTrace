   590	func validateConfig(cfg *Config) (map[string]*TargetConfig, error) {
   591		targetMap := map[string]*TargetConfig{}
   592		for i := range cfg.Targets {
   593			t := &cfg.Targets[i]
   594			if t.Name == "" {
   595				return nil, fmt.Errorf("target name is empty")
   596			}
   597			if _, ok := targetMap[t.Name]; ok {
   598				return nil, fmt.Errorf("duplicate target name %q", t.Name)
   599			}
   600			targetMap[t.Name] = t
   601		}
   602	
   603		for _, t := range targetMap {
   604			for _, dep := range t.Dependencies {
   605				if _, ok := targetMap[dep]; !ok {
   606					return nil, fmt.Errorf("target %q depends on missing target %q", t.Name, dep)
   607				}
   608			}
   609		}
   610	
   611		states := map[string]int{}
   612		var stack []string
   613		var dfs func(name string) error
   614		dfs = func(name string) error {
   615			states[name] = 1
   616			stack = append(stack, name)
   617			for _, dep := range targetMap[name].Dependencies {
   618				if states[dep] == 1 {
   619					idx := 0
   620					for i, s := range stack {
   621						if s == dep {
   622							idx = i
   623							break
   624						}
   625					}
   626					cycle := append([]string{}, stack[idx:]...)
   627					cycle = append(cycle, dep)
   628					return fmt.Errorf("cycle detected: %s", strings.Join(cycle, " -> "))
   629				}
   630				if states[dep] == 0 {
   631					if err := dfs(dep); err != nil {
   632						return err
   633					}
   634				}
   635			}
   636			stack = stack[:len(stack)-1]
   637			states[name] = 2
   638			return nil
   639		}
   640	
   641		names := make([]string, 0, len(targetMap))
   642		for n := range targetMap {
   643			names = append(names, n)
   644		}
   645		sort.Strings(names)
   646		for _, n := range names {
   647			if states[n] == 0 {
   648				if err := dfs(n); err != nil {
   649					return nil, err
   650				}
   651			}
   652		}
   653		return targetMap, nil
   654	}
