   543	type configLoader struct {
   544		pipelineName string
   545		rootImports  []string
   546		variables    map[string]string
   547		targets      []TargetConfig
   548		targetNames  map[string]bool
   549		importStack  []string
   550	}
   551	
   552	func (l *configLoader) loadFile(absPath string, isRoot bool) error {
   553		for _, p := range l.importStack {
   554			if p == absPath {
   555				chain := append([]string{}, l.importStack...)
   556				chain = append(chain, absPath)
   557				return fmt.Errorf("circular import detected: %s", strings.Join(chain, " -> "))
   558			}
   559		}
   560		l.importStack = append(l.importStack, absPath)
   561		defer func() { l.importStack = l.importStack[:len(l.importStack)-1] }()
   562	
   563		var fileCfg Config
   564		if _, err := toml.DecodeFile(absPath, &fileCfg); err != nil {
   565			return err
   566		}
   567	
   568		if isRoot {
   569			l.pipelineName = fileCfg.Pipeline.Name
   570			l.rootImports = fileCfg.Pipeline.Imports
   571		}
   572	
   573		for k, v := range fileCfg.Variables {
   574			if _, exists := l.variables[k]; !exists {
   575				l.variables[k] = v
   576			}
   577		}
   578	
   579		for _, imp := range fileCfg.Pipeline.Imports {
   580			expanded, err := expandString(imp, l.variables, make(map[string]bool))
   581			if err != nil {
   582				return err
   583			}
   584			importPath := expanded
   585			if !filepath.IsAbs(importPath) {
   586				importPath = filepath.Join(filepath.Dir(absPath), importPath)
   587			}
   588			importAbs, err := filepath.Abs(importPath)
   589			if err != nil {
   590				return err
   591			}
   592			if err := l.loadFile(importAbs, false); err != nil {
   593				return err
   594			}
   595		}
   596	
   597		for _, t := range fileCfg.Targets {
   598			l.targets = append(l.targets, t)
   599		}
   600	
   601		return nil
   602	}
   603	
   604	func parseVarOverrides(vars []string) (map[string]string, error) {
   605		m := make(map[string]string)
   606		for _, v := range vars {
   607			idx := strings.Index(v, "=")
   608			if idx == -1 {
   609				return nil, fmt.Errorf("invalid --var %q, expected key=value", v)
   610			}
   611			key := v[:idx]
   612			if key == "" {
   613				return nil, fmt.Errorf("invalid --var %q, empty key", v)
   614			}
   615			m[key] = v[idx+1:]
   616		}
   617		return m, nil
   618	}
   619	
   620	func expandMatrixTargets(targets *[]TargetConfig) error {
   621		expanded := make([]TargetConfig, 0, len(*targets))
   622		for _, t := range *targets {
   623			if len(t.Matrix) == 0 && len(t.MatrixInclude) == 0 && len(t.MatrixExclude) == 0 {
   624				expanded = append(expanded, t)
   625				continue
   626			}
   627			combos, err := matrixCombinations(t.Matrix, t.MatrixInclude, t.MatrixExclude)
   628			if err != nil {
   629				return err
   630			}
   631			for _, combo := range combos {
   632				copy := t
   633				copy.Name = substituteMatrixVars(t.Name, combo)
   634				copy.Command = substituteMatrixVars(t.Command, combo)
   635				copy.Dependencies = substituteMatrixSlice(t.Dependencies, combo)
   636				copy.Inputs = substituteMatrixSlice(t.Inputs, combo)
   637				copy.Outputs = substituteMatrixSlice(t.Outputs, combo)
   638				copy.Env = substituteMatrixEnv(t.Env, combo)
   639				copy.PreBuild = substituteMatrixSlice(t.PreBuild, combo)
   640				copy.PostBuild = substituteMatrixSlice(t.PostBuild, combo)
   641				copy.Matrix = nil
   642				copy.MatrixInclude = nil
   643				copy.MatrixExclude = nil
   644				expanded = append(expanded, copy)
   645			}
   646		}
   647		*targets = expanded
   648		return nil
   649	}
   650	
   651	func matrixCombinations(matrix map[string][]string, include []map[string]string, exclude []map[string]string) ([]map[string]string, error) {
   652		keys := make([]string, 0, len(matrix))
   653		for k := range matrix {
   654			keys = append(keys, k)
   655		}
   656		sort.Strings(keys)
   657	
   658		for _, inc := range include {
   659			if len(inc) != len(matrix) {
   660				return nil, fmt.Errorf("matrix_include entry must specify exactly the same keys as matrix")
   661			}
   662			for k := range inc {
   663				if _, ok := matrix[k]; !ok {
   664					return nil, fmt.Errorf("matrix_include entry must specify exactly the same keys as matrix")
   665				}
   666			}
   667		}
   668	
   669		var product []map[string]string
   670		if len(keys) == 0 {
   671			product = []map[string]string{{}}
   672		} else {
   673			product = []map[string]string{{}}
   674			for _, key := range keys {
   675				var next []map[string]string
   676				for _, combo := range product {
   677					for _, val := range matrix[key] {
   678						c := make(map[string]string, len(combo)+1)
   679						for k, v := range combo {
   680							c[k] = v
   681						}
   682						c[key] = val
   683						next = append(next, c)
   684					}
   685				}
   686				product = next
   687			}
   688		}
   689	
   690		for _, inc := range include {
   691			dup := false
   692			for _, combo := range product {
   693				if mapEqual(combo, inc) {
   694					dup = true
   695					break
   696				}
   697			}
   698			if !dup {
   699				product = append(product, inc)
   700			}
   701		}
   702	
   703		filtered := make([]map[string]string, 0, len(product))
   704		for _, combo := range product {
   705			if !matrixExcluded(combo, exclude) {
   706				filtered = append(filtered, combo)
   707			}
   708		}
   709		return filtered, nil
   710	}
   711	
   712	func mapEqual(a, b map[string]string) bool {
   713		if len(a) != len(b) {
   714			return false
   715		}
   716		for k, v := range a {
   717			if w, ok := b[k]; !ok || v != w {
   718				return false
   719			}
   720		}
   721		return true
   722	}
   723	
   724	func matrixExcluded(combo map[string]string, excludes []map[string]string) bool {
   725		for _, excl := range excludes {
   726			match := true
   727			for k, v := range excl {
   728				cv, ok := combo[k]
   729				if !ok || cv != v {
   730					match = false
   731					break
   732				}
   733			}
   734			if match {
   735				return true
   736			}
   737		}
   738		return false
   739	}
   740	
   741	func substituteMatrixVars(s string, combo map[string]string) string {
   742		var b strings.Builder
   743		i := 0
   744		for i < len(s) {
   745			if i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {
   746				end := strings.Index(s[i:], "}")
   747				if end == -1 {
   748					b.WriteByte(s[i])
   749					i++
   750					continue
   751				}
   752				name := s[i+2 : i+end]
   753				if val, ok := combo[name]; ok {
   754					b.WriteString(val)
   755					i += end + 1
   756					continue
   757				}
   758			}
   759			b.WriteByte(s[i])
   760			i++
   761		}
   762		return b.String()
   763	}
   764	
   765	func substituteMatrixSlice(slice []string, combo map[string]string) []string {
   766		out := make([]string, len(slice))
   767		for i, s := range slice {
   768			out[i] = substituteMatrixVars(s, combo)
   769		}
   770		return out
   771	}
   772	
   773	func substituteMatrixEnv(env map[string]string, combo map[string]string) map[string]string {
   774		if env == nil {
   775			return nil
   776		}
   777		out := make(map[string]string, len(env))
   778		for k, v := range env {
   779			out[k] = substituteMatrixVars(v, combo)
   780		}
   781		return out
   782	}
   783	
   784	func expandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {
   785		var b strings.Builder
   786		i := 0
   787		for i < len(s) {
   788			if i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {
   789				end := strings.Index(s[i:], "}")
   790				if end == -1 {
   791					return "", fmt.Errorf("unterminated variable reference in %q", s)
   792				}
   793				name := s[i+2 : i+end]
   794				if name == "" {
   795					return "", fmt.Errorf("empty variable reference in %q", s)
   796				}
   797				if visiting[name] {
   798					return "", fmt.Errorf("variable cycle detected: %q", name)
   799				}
   800				val, ok := vars[name]
   801				if !ok {
   802					return "", fmt.Errorf("unresolved variable %q", name)
   803				}
   804				visiting[name] = true
   805				expanded, err := expandString(val, vars, visiting)
   806				if err != nil {
   807					return "", err
   808				}
   809				delete(visiting, name)
   810				b.WriteString(expanded)
   811				i += end + 1
   812			} else {
   813				b.WriteByte(s[i])
   814				i++
   815			}
   816		}
   817		return b.String(), nil
   818	}
   819	
   820	func validateConfig(cfg *Config) (map[string]*TargetConfig, error) {
   821		targetMap := map[string]*TargetConfig{}
   822		for i := range cfg.Targets {
   823			t := &cfg.Targets[i]
   824			if t.Name == "" {
   825				return nil, fmt.Errorf("target name is empty")
   826			}
   827			if _, ok := targetMap[t.Name]; ok {
   828				return nil, fmt.Errorf("duplicate target name %q", t.Name)
   829			}
   830			targetMap[t.Name] = t
   831		}
   832	
   833		for _, t := range targetMap {
   834			for _, dep := range t.Dependencies {
   835				if _, ok := targetMap[dep]; !ok {
   836					return nil, fmt.Errorf("target %q depends on missing target %q", t.Name, dep)
   837				}
   838			}
   839		}
   840	
   841		states := map[string]int{}
   842		var stack []string
   843		var dfs func(name string) error
   844		dfs = func(name string) error {
   845			states[name] = 1
   846			stack = append(stack, name)
   847			for _, dep := range targetMap[name].Dependencies {
   848				if states[dep] == 1 {
   849					idx := 0
   850					for i, s := range stack {
   851						if s == dep {
   852							idx = i
   853							break
   854						}
   855					}
   856					cycle := append([]string{}, stack[idx:]...)
   857					cycle = append(cycle, dep)
   858					return fmt.Errorf("cycle detected: %s", strings.Join(cycle, " -> "))
   859				}
   860				if states[dep] == 0 {
   861					if err := dfs(dep); err != nil {
   862						return err
   863					}
   864				}
   865			}
   866			stack = stack[:len(stack)-1]
   867			states[name] = 2
   868			return nil
   869		}
   870	
   871		names := make([]string, 0, len(targetMap))
   872		for n := range targetMap {
   873			names = append(names, n)
   874		}
   875		sort.Strings(names)
   876		for _, n := range names {
   877			if states[n] == 0 {
   878				if err := dfs(n); err != nil {
   879					return nil, err
   880				}
   881			}
   882		}
   883		return targetMap, nil
   884	}
