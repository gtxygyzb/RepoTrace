   223			fmt.Fprintln(os.Stderr, "error: --config is required")
   224			os.Exit(1)
   225		}
   226		if err := runStatus(*configPath, []string(vars)); err != nil {
   227			fmt.Fprintln(os.Stderr, err)
   228			os.Exit(1)
   229		}
   230	}
