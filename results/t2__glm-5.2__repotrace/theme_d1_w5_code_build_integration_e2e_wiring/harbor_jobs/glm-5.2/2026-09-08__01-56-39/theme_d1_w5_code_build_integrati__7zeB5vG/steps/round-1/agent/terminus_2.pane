   232	func runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string, vars []string, keepGoing bool, profile bool) error {
   233		cfg, configDir, err := loadConfig(configPath, vars)
   234		if err != nil {
   235			return err
   236		}
   237		targetMap, err := validateConfig(cfg)
   238		if err != nil {
   239			return err
   240		}
   241		requested, err := selectTargets(cfg, targetMap, targetsFlag)
   242		if err != nil {
   243			return err
   244		}
   245		order := topologicalOrder(cfg, requested)
   246		reverseDeps := buildReverseDeps(cfg, requested)
   247	
   248		cacheKeys := make(map[string]string)
   249		for i := range cfg.Targets {
   250			t := &cfg.Targets[i]
   251			if !requested[t.Name] {
   252				continue
   253			}
   254			key, err := computeCacheKey(t, configDir)
   255			if err != nil {
   256				return err
   257			}
   258			cacheKeys[t.Name] = key
   259		}
   260	
   261		executor := &buildExecutor{
   262			config:    cfg,
   263			configDir: configDir,
   264			cacheDir:  filepath.Join(configDir, ".buildctl-cache"),
   265			noCache:   noCache,
   266		}
   267	
   268		status := make(map[string]string)
   269		durations := make(map[string]int64)
   270		completed := 0
   271		total := len(requested)
   272		readyCh := make(chan *TargetConfig, total+1)
   273		resultCh := make(chan execResult, total+1)
   274	
   275		var mu sync.Mutex
   276		started := make(map[string]bool)
   277		cancelled := false
   278	
   279		var wg sync.WaitGroup
   280		for i := 0; i < parallel; i++ {
   281			wg.Add(1)
   282			go func() {
   283				defer wg.Done()
   284				for t := range readyCh {
   285					mu.Lock()
   286					if cancelled {
   287						mu.Unlock()
   288						continue
   289					}
   290					started[t.Name] = true
   291					mu.Unlock()
   292					res := executor.execute(t)
   293					if res.status == "failed" && !keepGoing {
   294						mu.Lock()
   295						cancelled = true
   296						mu.Unlock()
   297					}
   298					resultCh <- res
   299				}
   300			}()
   301		}
   302	
   303		buildStart := time.Now()
   304		for i := range cfg.Targets {
   305			t := &cfg.Targets[i]
   306			if requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {
   307				readyCh <- t
   308			}
   309		}
   310	
   311		for completed < total {
   312			res := <-resultCh
   313			status[res.name] = res.status
   314			durations[res.name] = res.durationMS
   315			if res.cacheKey != "" {
   316				cacheKeys[res.name] = res.cacheKey
   317			}
   318			completed++
   319	
   320			if res.status == "built" || res.status == "cached" {
   321				mu.Lock()
   322				canSchedule := !cancelled
   323				mu.Unlock()
   324				if canSchedule {
   325					for _, dependent := range reverseDeps[res.name] {
   326						if allDependenciesComplete(dependent, targetMap, requested, status) {
   327							readyCh <- targetMap[dependent]
   328						}
   329					}
   330				}
   331				continue
   332			}
   333	
   334			if res.status == "failed" {
   335				markSkipped(reverseDeps, status, durations, &completed, res.name)
   336				if !keepGoing {
   337					mu.Lock()
   338					cancelled = true
   339					for i := range cfg.Targets {
   340						t := &cfg.Targets[i]
   341						if !requested[t.Name] {
   342							continue
   343						}
   344						if status[t.Name] == "" && !started[t.Name] {
   345							status[t.Name] = "cancelled"
   346							durations[t.Name] = 0
   347							completed++
   348						}
   349					}
   350					mu.Unlock()
   351				}
   352				continue
   353			}
   354		}
   355	
   356		close(readyCh)
   357		wg.Wait()
   358	
   359		report := BuildReport{Pipeline: cfg.Pipeline.Name, Targets: []BuildTargetReport{}}
   360		for _, name := range order {
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '361,540p'
[?2004l   361			st := status[name]
   362			if st == "" {
   363				if keepGoing {
   364					st = "skipped"
   365				} else {
   366					st = "cancelled"
   367				}
   368			}
   369			report.Targets = append(report.Targets, BuildTargetReport{
   370				Name:       name,
   371				Status:     st,
   372				Cached:     st == "cached",
   373				DurationMS: durations[name],
   374				CacheKey:   cacheKeys[name],
   375			})
   376		}
   377	
   378		summary := BuildSummary{Total: len(report.Targets)}
   379		for _, t := range report.Targets {
   380			switch t.Status {
   381			case "built":
   382				summary.Built++
   383			case "cached":
   384				summary.Cached++
   385			case "failed":
   386				summary.Failed++
   387			case "skipped":
   388				summary.Skipped++
   389			case "cancelled":
   390				summary.Cancelled++
   391			}
   392		}
   393		summary.DurationMS = time.Since(buildStart).Milliseconds()
   394		report.Summary = summary
   395	
   396		if profile {
   397			report.Profile = computeBuildProfile(report.Targets, cfg, targetMap)
   398		}
   399	
   400		data, err := json.MarshalIndent(report, "", "  ")
   401		if err != nil {
   402			return err
   403		}
   404		fmt.Println(string(data))
   405		if reportPath != "" {
   406			if err := os.WriteFile(reportPath, data, 0644); err != nil {
   407				return err
   408			}
   409		}
   410		if summary.Failed > 0 {
   411			return fmt.Errorf("build failed")
   412		}
   413		return nil
   414	}
