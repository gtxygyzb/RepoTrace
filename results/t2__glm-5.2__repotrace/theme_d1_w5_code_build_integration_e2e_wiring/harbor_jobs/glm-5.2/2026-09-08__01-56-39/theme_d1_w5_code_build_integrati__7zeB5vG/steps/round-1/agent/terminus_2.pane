   108	func runDepsTarget(cfg *Config, targetMap map[string]*TargetConfig, target string) error {
   109		if _, ok := targetMap[target]; !ok {
   110			failDepsJSON(fmt.Sprintf("target %q does not exist", target))
   111			return nil
   112		}
   113	
   114		directSet := map[string]bool{}
   115		for _, dep := range uniqueStrings(targetMap[target].Dependencies) {
   116			directSet[dep] = true
   117		}
   118		direct := sortedKeys(directSet)
   119	
   120		transitiveSet := map[string]bool{}
   121		collectTransitiveDeps(targetMap, target, transitiveSet)
   122		delete(transitiveSet, target)
   123		transitive := sortedKeys(transitiveSet)
   124	
   125		reverseSet := map[string]bool{}
   126		for _, t := range cfg.Targets {
   127			if t.Name == target {
   128				continue
   129			}
   130			seen := map[string]bool{}
   131			if dependsOnTransitive(targetMap, t.Name, target, seen) {
   132				reverseSet[t.Name] = true
   133			}
   134		}
   135		reverse := sortedKeys(reverseSet)
   136	
   137		return emitJSON(map[string]interface{}{
   138			"target":          target,
   139			"direct_deps":     direct,
   140			"transitive_deps": transitive,
   141			"reverse_deps":    reverse,
   142		})
   143	}
   144	
   145	func runDepsWhy(cfg *Config, targetMap map[string]*TargetConfig, from, to string) error {
   146		if _, ok := targetMap[from]; !ok {
   147			failDepsJSON(fmt.Sprintf("target %q does not exist", from))
   148			return nil
   149		}
   150		if _, ok := targetMap[to]; !ok {
   151			failDepsJSON(fmt.Sprintf("target %q does not exist", to))
   152			return nil
   153		}
   154	
   155		paths := allDependencyPaths(targetMap, from, to)
   156		sortPaths(paths)
   157		return emitJSON(map[string]interface{}{
   158			"from":  from,
   159			"to":    to,
   160			"paths": paths,
   161		})
   162	}
