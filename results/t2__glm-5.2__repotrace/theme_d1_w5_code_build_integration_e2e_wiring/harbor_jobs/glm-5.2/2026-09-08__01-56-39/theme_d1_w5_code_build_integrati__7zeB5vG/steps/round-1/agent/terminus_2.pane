\t}

\tif !e.noCache {
\t\tvalid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)
\t\tif err != nil {
\t\t\treturn execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
\t\t}
\t\tif valid {
\t\t\treturn execResult{name: t.Name, status: "cached", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}
\t\t}
\t}

\ttimeout := t.Timeout
\tif timeout <= 0 {
\t\ttimeout = 300
\t}

\tvar stdout, stderr bytes.Buffer
\tcmd := exec.Command("sh", "-c", t.Command)
\tcmd.Dir = e.configDir
\tcmd.Env = mergedEnv(t.Env)
\tcmd.Stdout = &stdout
\tcmd.Stderr = &stderr
\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}

\tif err := cmd.Start(); err != nil {
\t\treturn execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
\t}

\twaitCh := make(chan error, 1)
\tgo func() {
\t\twaitCh <- cmd.Wait()
