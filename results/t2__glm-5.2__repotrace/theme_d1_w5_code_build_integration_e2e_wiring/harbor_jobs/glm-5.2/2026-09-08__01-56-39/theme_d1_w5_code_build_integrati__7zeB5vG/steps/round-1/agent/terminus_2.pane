  1165	func (e *buildExecutor) runCommand(t *TargetConfig, command string, env []string, deadline time.Time) (string, error) {
  1166		if strings.TrimSpace(command) == "" {
  1167			return "", nil
  1168		}
  1169		remaining := time.Until(deadline)
  1170		if remaining <= 0 {
  1171			return "", fmt.Errorf("target %q timed out after %ds", t.Name, t.Timeout)
  1172		}
  1173	
  1174		var stdout, stderr bytes.Buffer
  1175		ctx, cancel := context.WithTimeout(context.Background(), remaining)
  1176		defer cancel()
  1177		cmd := exec.CommandContext(ctx, "sh", "-c", command)
  1178		cmd.Dir = e.configDir
  1179		cmd.Env = env
  1180		cmd.Stdout = &stdout
  1181		cmd.Stderr = &stderr
  1182		cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
  1183	
  1184		if err := cmd.Start(); err != nil {
  1185			return "", err
  1186		}
  1187	
  1188		waitCh := make(chan error, 1)
  1189		go func() {
  1190			waitCh <- cmd.Wait()
  1191		}()
  1192	
  1193		select {
  1194		case <-ctx.Done():
  1195			if cmd.Process != nil {
  1196				_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
  1197			}
  1198			<-waitCh
  1199			return "", fmt.Errorf("target %q timed out after %ds", t.Name, t.Timeout)
  1200		case err := <-waitCh:
  1201			if err != nil {
  1202				if stderr.Len() > 0 {
  1203					fmt.Fprintf(os.Stderr, "target %q stderr:\n%s", t.Name, stderr.String())
  1204				}
  1205				return "", err
  1206			}
  1207		}
  1208		return stdout.String(), nil
  1209	}
