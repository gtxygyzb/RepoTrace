   961	func buildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {
   962		reverse := map[string][]string{}
   963		for _, t := range cfg.Targets {
   964			if !requested[t.Name] {
   965				continue
   966			}
   967			for _, dep := range uniqueStrings(t.Dependencies) {
   968				if requested[dep] {
   969					reverse[dep] = append(reverse[dep], t.Name)
   970				}
   971			}
   972		}
   973		return reverse
   974	}
