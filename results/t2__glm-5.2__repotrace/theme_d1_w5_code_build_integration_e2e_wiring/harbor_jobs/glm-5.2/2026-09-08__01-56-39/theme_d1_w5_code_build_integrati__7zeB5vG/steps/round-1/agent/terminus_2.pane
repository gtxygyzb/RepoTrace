   720	func cacheValid(cacheDir, key string, outputs []string, configDir string) (bool, CacheEntry, error) {
   721		entry, ok, err := readCacheEntry(cacheDir, key)
   722		if err != nil {
   723			return false, CacheEntry{}, err
   724		}
   725		if !ok {
   726			return false, CacheEntry{}, nil
   727		}
   728		for _, out := range outputs {
   729			if !fileExists(resolvePath(configDir, out)) {
   730				return false, CacheEntry{}, nil
   731			}
   732		}
   733		return true, entry, nil
   734	}
   735	
   736	func readCacheEntry(cacheDir, key string) (CacheEntry, bool, error) {
   737		path := filepath.Join(cacheDir, key+".json")
   738		data, err := os.ReadFile(path)
   739		if os.IsNotExist(err) {
   740			return CacheEntry{}, false, nil
   741		}
   742		if err != nil {
   743			return CacheEntry{}, false, err
   744		}
   745		var entry CacheEntry
   746		if err := json.Unmarshal(data, &entry); err != nil {
   747			return CacheEntry{}, false, nil
   748		}
   749		if entry.CacheKey != "" && entry.CacheKey != key {
   750			return CacheEntry{}, false, nil
   751		}
   752		if entry.CacheKey == "" {
   753			entry.CacheKey = key
   754		}
   755		return entry, true, nil
   756	}
   757	
   758	func writeCacheEntry(cacheDir string, entry CacheEntry) error {
   759		if err := os.MkdirAll(cacheDir, 0755); err != nil {
   760			return err
   761		}
   762		data, err := json.MarshalIndent(entry, "", "  ")
   763		if err != nil {
   764			return err
   765		}
   766		return os.WriteFile(filepath.Join(cacheDir, entry.CacheKey+".json"), data, 0644)
   767	}
   768	
   769	func hashFile(path string) (string, error) {
   770		f, err := os.Open(path)
   771		if err != nil {
   772			return "", err
   773		}
   774		defer f.Close()
   775		h := sha256.New()
   776		if _, err := io.Copy(h, f); err != nil {
   777			return "", err
   778		}
   779		return hex.EncodeToString(h.Sum(nil)), nil
   780	}
   781	
   782	func hashBytes(b []byte) string {
   783		s := sha256.Sum256(b)
   784		return hex.EncodeToString(s[:])
   785	}
   786	
   787	func resolvePath(base, p string) string {
   788		if filepath.IsAbs(p) {
   789			return p
   790		}
   791		return filepath.Join(base, p)
   792	}
   793	
   794	func fileExists(path string) bool {
   795		_, err := os.Stat(path)
   796		return err == nil
   797	}
   798	
   799	func uniqueStrings(in []string) []string {
   800		seen := map[string]bool{}
   801		out := []string{}
   802		for _, s := range in {
   803			if !seen[s] {
   804				seen[s] = true
   805				out = append(out, s)
   806			}
   807		}
   808		return out
   809	}
