[?2004l   479	func selectTargets(cfg *Config, targetMap map[string]*TargetConfig, targetsFlag string) (map[string]bool, error) {
   480		if strings.TrimSpace(targetsFlag) == "" {
   481			requested := map[string]bool{}
   482			for _, t := range cfg.Targets {
   483				requested[t.Name] = true
   484			}
   485			return requested, nil
   486		}
   487	
   488		requested := map[string]bool{}
   489		for _, part := range strings.Split(targetsFlag, ",") {
   490			name := strings.TrimSpace(part)
   491			if _, ok := targetMap[name]; !ok {
   492				return nil, fmt.Errorf("target %q not found", name)
   493			}
   494			var visit func(string)
   495			visit = func(n string) {
   496				if requested[n] {
   497					return
   498				}
   499				requested[n] = true
   500				for _, dep := range targetMap[n].Dependencies {
   501					visit(dep)
   502				}
   503			}
   504			visit(name)
   505		}
   506		return requested, nil
   507	}
