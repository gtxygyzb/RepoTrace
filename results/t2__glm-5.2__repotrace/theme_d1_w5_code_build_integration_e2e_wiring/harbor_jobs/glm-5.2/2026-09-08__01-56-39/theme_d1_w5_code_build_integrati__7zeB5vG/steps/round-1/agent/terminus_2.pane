   826	func (e *buildExecutor) execute(t *TargetConfig) execResult {
   827		start := time.Now()
   828		key, err := computeCacheKey(t, e.configDir)
   829		if err != nil {
   830			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   831		}
   832	
   833		if !e.noCache {
   834			valid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)
   835			if err != nil {
   836				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   837			}
   838			if valid {
   839				return execResult{name: t.Name, status: "cached", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   840			}
   841		}
   842	
   843		timeout := t.Timeout
   844		if timeout <= 0 {
   845			timeout = 300
   846		}
   847		deadline := time.Now().Add(time.Duration(timeout) * time.Second)
   848	
   849		baseEnv := mergedEnv(t.Env)
   850		preEnv := append([]string(nil), baseEnv...)
   851	
   852		for _, hook := range t.PreBuild {
   853			stdout, err := e.runCommand(t, hook, preEnv, deadline)
   854			if err != nil {
   855				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   856			}
   857			preEnv = mergeHookExports(preEnv, parseHookExports(stdout))
   858		}
   859	
   860		mainEnv := preEnv
   861		if _, err := e.runCommand(t, t.Command, mainEnv, deadline); err != nil {
   862			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   863		}
   864	
   865		postEnv := append([]string(nil), baseEnv...)
   866		for _, hook := range t.PostBuild {
   867			stdout, err := e.runCommand(t, hook, postEnv, deadline)
   868			if err != nil {
   869				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   870			}
   871			postEnv = mergeHookExports(postEnv, parseHookExports(stdout))
   872		}
   873	
   874		elapsed := time.Since(start).Milliseconds()
   875		entry := CacheEntry{
   876			CacheKey:   key,
   877			TargetName: t.Name,
   878			Timestamp:  time.Now().UTC().Format(time.RFC3339),
   879			Outputs:    t.Outputs,
   880		}
   881		if err := writeCacheEntry(e.cacheDir, entry); err != nil {
   882			fmt.Fprintln(os.Stderr, err)
   883			return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
   884		}
   885		return execResult{name: t.Name, status: "built", durationMS: elapsed, cacheKey: key}
   886	}
