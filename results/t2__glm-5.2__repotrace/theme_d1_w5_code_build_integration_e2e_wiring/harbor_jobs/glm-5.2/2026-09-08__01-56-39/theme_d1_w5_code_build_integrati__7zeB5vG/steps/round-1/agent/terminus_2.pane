   682	func topologicalOrder(cfg *Config, requested map[string]bool) []string {
   683		indeg := map[string]int{}
   684		for _, t := range cfg.Targets {
   685			if !requested[t.Name] {
   686				continue
   687			}
   688			count := 0
   689			for _, dep := range uniqueStrings(t.Dependencies) {
   690				if requested[dep] {
   691					count++
   692				}
   693			}
   694			indeg[t.Name] = count
   695		}
   696	
   697		queue := []string{}
   698		for _, t := range cfg.Targets {
   699			if requested[t.Name] && indeg[t.Name] == 0 {
   700				queue = append(queue, t.Name)
   701			}
   702		}
   703	
   704		order := []string{}
   705		for len(queue) > 0 {
   706			name := queue[0]
   707			queue = queue[1:]
   708			order = append(order, name)
   709			for _, t := range cfg.Targets {
   710				if !requested[t.Name] {
   711					continue
   712				}
   713				for _, dep := range uniqueStrings(t.Dependencies) {
   714					if dep == name {
   715						indeg[t.Name]--
   716						if indeg[t.Name] == 0 {
   717							queue = append(queue, t.Name)
   718						}
   719						break
   720					}
   721				}
   722			}
   723		}
   724		return order
   725	}
