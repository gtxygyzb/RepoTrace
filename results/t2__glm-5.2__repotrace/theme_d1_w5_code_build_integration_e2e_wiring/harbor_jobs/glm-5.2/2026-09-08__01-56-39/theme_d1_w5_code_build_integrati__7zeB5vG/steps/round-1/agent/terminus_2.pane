   976	func allDependenciesComplete(name string, targetMap map[string]*TargetConfig, requested map[string]bool, status map[string]string) bool {
   977		for _, dep := range targetMap[name].Dependencies {
   978			if !requested[dep] {
   979				continue
   980			}
   981			s := status[dep]
   982			if s != "built" && s != "cached" {
   983				return false
   984			}
   985		}
   986		return true
   987	}
