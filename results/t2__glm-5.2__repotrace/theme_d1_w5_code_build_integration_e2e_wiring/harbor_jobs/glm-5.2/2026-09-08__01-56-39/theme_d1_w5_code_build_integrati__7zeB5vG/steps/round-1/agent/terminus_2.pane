   766	func (e *buildExecutor) execute(t *TargetConfig) execResult {
   767		start := time.Now()
   768		key, err := computeCacheKey(t, e.configDir)
   769		if err != nil {
   770			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   771		}
   772	
   773		if !e.noCache {
   774			valid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)
   775			if err != nil {
   776				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   777			}
   778			if valid {
   779				return execResult{name: t.Name, status: "cached", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   780			}
   781		}
   782	
   783		timeout := t.Timeout
   784		if timeout <= 0 {
   785			timeout = 300
   786		}
   787	
   788		var stdout, stderr bytes.Buffer
   789		cmd := exec.Command("sh", "-c", t.Command)
   790		cmd.Dir = e.configDir
   791		cmd.Env = mergedEnv(t.Env)
   792		cmd.Stdout = &stdout
   793		cmd.Stderr = &stderr
   794		cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
   795	
   796		if err := cmd.Start(); err != nil {
   797			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   798		}
   799	
   800		waitCh := make(chan error, 1)
   801		go func() {
   802			waitCh <- cmd.Wait()
   803		}()
   804	
   805		var runErr error
   806		select {
   807		case <-time.After(time.Duration(timeout) * time.Second):
   808			if cmd.Process != nil {
   809				_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
   810			}
   811			<-waitCh
   812			runErr = fmt.Errorf("target %q timed out after %ds", t.Name, timeout)
   813		case err := <-waitCh:
   814			if err != nil {
   815				runErr = err
   816			}
   817		}
   818	
   819		elapsed := time.Since(start).Milliseconds()
   820		if runErr != nil {
   821			if stderr.Len() > 0 {
   822				fmt.Fprintf(os.Stderr, "target %q stderr:\n%s", t.Name, stderr.String())
   823			}
   824			return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
   825		}
   826	
   827		entry := CacheEntry{
   828			CacheKey:   key,
   829			TargetName: t.Name,
   830			Timestamp:  time.Now().UTC().Format(time.RFC3339),
   831			Outputs:    t.Outputs,
   832		}
   833		if err := writeCacheEntry(e.cacheDir, entry); err != nil {
   834			fmt.Fprintln(os.Stderr, err)
   835			return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
   836		}
   837		return execResult{name: t.Name, status: "built", durationMS: elapsed, cacheKey: key}
   838	}
