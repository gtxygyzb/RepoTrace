   792	func allDependenciesComplete(name string, targetMap map[string]*TargetConfig, requested map[string]bool, status map[string]string) bool {
   793		for _, dep := range targetMap[name].Dependencies {
   794			if !requested[dep] {
   795				continue
   796			}
   797			s := status[dep]
   798			if s != "built" && s != "cached" {
   799				return false
   800			}
   801		}
   802		return true
   803	}
