   547	func expandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {
   548		var b strings.Builder
   549		i := 0
   550		for i < len(s) {
   551			if i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {
   552				end := strings.Index(s[i:], "}")
   553				if end == -1 {
   554					return "", fmt.Errorf("unterminated variable reference in %q", s)
   555				}
   556				name := s[i+2 : i+end]
   557				if name == "" {
   558					return "", fmt.Errorf("empty variable reference in %q", s)
   559				}
   560				if visiting[name] {
