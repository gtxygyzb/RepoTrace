   416	func runGraph(configPath string, vars []string) error {
   417		cfg, _, err := loadConfig(configPath, vars)
   418		if err != nil {
   419			return err
   420		}
   421		if _, err := validateConfig(cfg); err != nil {
   422			return err
   423		}
   424		fmt.Printf("digraph %s {\n", strconv.Quote(cfg.Pipeline.Name))
   425		for _, t := range cfg.Targets {
   426			if len(uniqueStrings(t.Dependencies)) == 0 {
   427				fmt.Printf("  %s;\n", strconv.Quote(t.Name))
   428			}
   429		}
   430		for _, t := range cfg.Targets {
   431			for _, dep := range uniqueStrings(t.Dependencies) {
   432				fmt.Printf("  %s -> %s;\n", strconv.Quote(t.Name), strconv.Quote(dep))
   433			}
   434		}
   435		fmt.Println("}")
   436		return nil
   437	}
   438	
   439	func runClean(configPath string, vars []string) error {
   440		abs, err := filepath.Abs(configPath)
   441		if err != nil {
   442			return err
   443		}
   444		cacheDir := filepath.Join(filepath.Dir(abs), ".buildctl-cache")
   445		return os.RemoveAll(cacheDir)
   446	}
   447	
   448	func runStatus(configPath string, vars []string) error {
   449		cfg, configDir, err := loadConfig(configPath, vars)
   450		if err != nil {
   451			return err
   452		}
   453		if _, err := validateConfig(cfg); err != nil {
   454			return err
   455		}
   456		cacheDir := filepath.Join(configDir, ".buildctl-cache")
   457		report := StatusReport{Targets: []StatusTarget{}}
   458		for i := range cfg.Targets {
   459			t := &cfg.Targets[i]
   460			key, err := computeCacheKey(t, configDir)
   461			if err != nil {
   462				return err
   463			}
   464			valid, entry, err := cacheValid(cacheDir, key, t.Outputs, configDir)
   465			if err != nil {
   466				return err
   467			}
   468			st := StatusTarget{Name: t.Name, Cached: valid}
   469			if valid {
   470				st.CacheKey = key
   471				st.CachedAt = entry.Timestamp
   472			}
   473			report.Targets = append(report.Targets, st)
   474		}
   475		data, err := json.MarshalIndent(report, "", "  ")
   476		if err != nil {
   477			return err
   478		}
   479		fmt.Println(string(data))
   480		return nil
   481	}
   482	
   483	func loadConfig(path string, varOverrides []string) (*Config, string, error) {
   484		abs, err := filepath.Abs(path)
   485		if err != nil {
   486			return nil, "", err
   487		}
   488		overrides, err := parseVarOverrides(varOverrides)
   489		if err != nil {
   490			return nil, "", err
   491		}
   492		loader := &configLoader{
   493			variables:   make(map[string]string),
   494			targetNames: make(map[string]bool),
   495		}
   496		for k, v := range overrides {
   497			loader.variables[k] = v
   498		}
   499		if err := loader.loadFile(abs, true); err != nil {
   500			return nil, "", err
   501		}
   502		for i := range loader.targets {
   503			t := &loader.targets[i]
   504			expanded, err := expandString(t.Command, loader.variables, make(map[string]bool))
   505			if err != nil {
   506				return nil, "", err
   507			}
   508			t.Command = expanded
   509			for j, p := range t.Inputs {
   510				expanded, err := expandString(p, loader.variables, make(map[string]bool))
   511				if err != nil {
   512					return nil, "", err
   513				}
   514				t.Inputs[j] = expanded
   515			}
   516			for j, p := range t.Outputs {
   517				expanded, err := expandString(p, loader.variables, make(map[string]bool))
   518				if err != nil {
   519					return nil, "", err
   520				}
   521				t.Outputs[j] = expanded
   522			}
   523			t.Dependencies = uniqueStrings(t.Dependencies)
   524			if t.Timeout <= 0 {
   525				t.Timeout = 300
   526			}
   527		}
   528		cfg := &Config{
   529			Pipeline:  PipelineConfig{Name: loader.pipelineName, Imports: loader.rootImports},
   530			Targets:   loader.targets,
   531			Variables: loader.variables,
   532		}
   533		return cfg, filepath.Dir(abs), nil
   534	}
   535	
   536	type configLoader struct {
   537		pipelineName string
   538		rootImports  []string
   539		variables    map[string]string
   540		targets      []TargetConfig
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '541,760p'
[?2004l   541		targetNames  map[string]bool
   542		importStack  []string
   543	}
   544	
   545	func (l *configLoader) loadFile(absPath string, isRoot bool) error {
   546		for _, p := range l.importStack {
   547			if p == absPath {
   548				chain := append([]string{}, l.importStack...)
   549				chain = append(chain, absPath)
   550				return fmt.Errorf("circular import detected: %s", strings.Join(chain, " -> "))
   551			}
   552		}
   553		l.importStack = append(l.importStack, absPath)
   554		defer func() { l.importStack = l.importStack[:len(l.importStack)-1] }()
   555	
   556		var fileCfg Config
   557		if _, err := toml.DecodeFile(absPath, &fileCfg); err != nil {
   558			return err
   559		}
   560	
   561		if isRoot {
   562			l.pipelineName = fileCfg.Pipeline.Name
   563			l.rootImports = fileCfg.Pipeline.Imports
   564		}
   565	
   566		for k, v := range fileCfg.Variables {
   567			if _, exists := l.variables[k]; !exists {
   568				l.variables[k] = v
   569			}
   570		}
   571	
   572		for _, imp := range fileCfg.Pipeline.Imports {
   573			expanded, err := expandString(imp, l.variables, make(map[string]bool))
   574			if err != nil {
   575				return err
   576			}
   577			importPath := expanded
   578			if !filepath.IsAbs(importPath) {
   579				importPath = filepath.Join(filepath.Dir(absPath), importPath)
   580			}
   581			importAbs, err := filepath.Abs(importPath)
   582			if err != nil {
   583				return err
   584			}
   585			if err := l.loadFile(importAbs, false); err != nil {
   586				return err
   587			}
   588		}
   589	
   590		for _, t := range fileCfg.Targets {
   591			if l.targetNames[t.Name] {
   592				return fmt.Errorf("duplicate target name %q", t.Name)
   593			}
   594			l.targetNames[t.Name] = true
   595			l.targets = append(l.targets, t)
   596		}
   597	
   598		return nil
   599	}
   600	
   601	func parseVarOverrides(vars []string) (map[string]string, error) {
   602		m := make(map[string]string)
   603		for _, v := range vars {
   604			idx := strings.Index(v, "=")
   605			if idx == -1 {
   606				return nil, fmt.Errorf("invalid --var %q, expected key=value", v)
   607			}
   608			key := v[:idx]
   609			if key == "" {
   610				return nil, fmt.Errorf("invalid --var %q, empty key", v)
   611			}
   612			m[key] = v[idx+1:]
   613		}
   614		return m, nil
   615	}
   616	
   617	func expandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {
   618		var b strings.Builder
   619		i := 0
   620		for i < len(s) {
   621			if i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {
   622				end := strings.Index(s[i:], "}")
   623				if end == -1 {
   624					return "", fmt.Errorf("unterminated variable reference in %q", s)
   625				}
   626				name := s[i+2 : i+end]
   627				if name == "" {
   628					return "", fmt.Errorf("empty variable reference in %q", s)
   629				}
   630				if visiting[name] {
   631					return "", fmt.Errorf("variable cycle detected: %q", name)
   632				}
   633				val, ok := vars[name]
   634				if !ok {
   635					return "", fmt.Errorf("unresolved variable %q", name)
   636				}
   637				visiting[name] = true
   638				expanded, err := expandString(val, vars, visiting)
   639				if err != nil {
   640					return "", err
   641				}
   642				delete(visiting, name)
   643				b.WriteString(expanded)
   644				i += end + 1
   645			} else {
   646				b.WriteByte(s[i])
   647				i++
   648			}
   649		}
   650		return b.String(), nil
   651	}
   652	
   653	func validateConfig(cfg *Config) (map[string]*TargetConfig, error) {
   654		targetMap := map[string]*TargetConfig{}
   655		for i := range cfg.Targets {
   656			t := &cfg.Targets[i]
   657			if t.Name == "" {
   658				return nil, fmt.Errorf("target name is empty")
   659			}
   660			if _, ok := targetMap[t.Name]; ok {
   661				return nil, fmt.Errorf("duplicate target name %q", t.Name)
   662			}
   663			targetMap[t.Name] = t
   664		}
   665	
   666		for _, t := range targetMap {
   667			for _, dep := range t.Dependencies {
   668				if _, ok := targetMap[dep]; !ok {
   669					return nil, fmt.Errorf("target %q depends on missing target %q", t.Name, dep)
   670				}
   671			}
   672		}
   673	
   674		states := map[string]int{}
   675		var stack []string
   676		var dfs func(name string) error
   677		dfs = func(name string) error {
   678			states[name] = 1
   679			stack = append(stack, name)
   680			for _, dep := range targetMap[name].Dependencies {
   681				if states[dep] == 1 {
   682					idx := 0
   683					for i, s := range stack {
   684						if s == dep {
   685							idx = i
   686							break
   687						}
   688					}
   689					cycle := append([]string{}, stack[idx:]...)
   690					cycle = append(cycle, dep)
   691					return fmt.Errorf("cycle detected: %s", strings.Join(cycle, " -> "))
   692				}
   693				if states[dep] == 0 {
   694					if err := dfs(dep); err != nil {
   695						return err
   696					}
   697				}
   698			}
   699			stack = stack[:len(stack)-1]
   700			states[name] = 2
   701			return nil
   702		}
   703	
   704		names := make([]string, 0, len(targetMap))
   705		for n := range targetMap {
   706			names = append(names, n)
   707		}
   708		sort.Strings(names)
   709		for _, n := range names {
   710			if states[n] == 0 {
   711				if err := dfs(n); err != nil {
   712					return nil, err
   713				}
   714			}
   715		}
   716		return targetMap, nil
   717	}
   718	
   719	func selectTargets(cfg *Config, targetMap map[string]*TargetConfig, targetsFlag string) (map[string]bool, error) {
   720		if strings.TrimSpace(targetsFlag) == "" {
   721			requested := map[string]bool{}
   722			for _, t := range cfg.Targets {
   723				requested[t.Name] = true
   724			}
   725			return requested, nil
   726		}
   727	
   728		requested := map[string]bool{}
   729		for _, part := range strings.Split(targetsFlag, ",") {
   730			name := strings.TrimSpace(part)
   731			if _, ok := targetMap[name]; !ok {
   732				return nil, fmt.Errorf("target %q not found", name)
   733			}
   734			var visit func(string)
   735			visit = func(n string) {
   736				if requested[n] {
   737					return
   738				}
   739				requested[n] = true
   740				for _, dep := range targetMap[n].Dependencies {
   741					visit(dep)
   742				}
   743			}
   744			visit(name)
   745		}
   746		return requested, nil
   747	}
