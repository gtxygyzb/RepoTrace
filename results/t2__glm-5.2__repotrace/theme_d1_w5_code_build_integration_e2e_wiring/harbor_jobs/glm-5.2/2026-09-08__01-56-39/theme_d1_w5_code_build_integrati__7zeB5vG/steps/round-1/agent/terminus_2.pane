   699	func mergedEnv(env map[string]string) []string {
   700		out := map[string]string{}
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '700,809p'
[?2004l   700		out := map[string]string{}
   701		for _, kv := range os.Environ() {
   702			parts := strings.SplitN(kv, "=", 2)
   703			if len(parts) == 2 {
   704				out[parts[0]] = parts[1]
   705			} else {
   706				out[parts[0]] = ""
   707			}
   708		}
   709		for k, v := range env {
   710			out[k] = v
   711		}
   712		result := make([]string, 0, len(out))
   713		for k, v := range out {
   714			result = append(result, k+"="+v)
   715		}
   716		sort.Strings(result)
   717		return result
   718	}
