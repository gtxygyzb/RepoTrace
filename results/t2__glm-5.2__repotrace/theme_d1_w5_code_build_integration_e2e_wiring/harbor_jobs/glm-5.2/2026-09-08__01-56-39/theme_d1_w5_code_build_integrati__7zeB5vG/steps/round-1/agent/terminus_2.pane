   400		data, err := json.MarshalIndent(report, "", "  ")
   401		if err != nil {
   402			return err
   403		}
   404		fmt.Println(string(data))
   405		if reportPath != "" {
   406			if err := os.WriteFile(reportPath, data, 0644); err != nil {
   407				return err
   408			}
   409		}
   410		if summary.Failed > 0 {
   411			return fmt.Errorf("build failed")
   412		}
   413		return nil
   414	}
