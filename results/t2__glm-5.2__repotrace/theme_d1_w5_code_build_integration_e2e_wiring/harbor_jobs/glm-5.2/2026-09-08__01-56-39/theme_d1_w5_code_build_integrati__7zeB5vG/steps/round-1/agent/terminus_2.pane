  1152	func (e *buildExecutor) runTargetAttempt(t *TargetConfig, deadline time.Time) error {
  1153		baseEnv := mergedEnv(t.Env)
  1154		preEnv := append([]string(nil), baseEnv...)
  1155	
  1156		for _, hook := range t.PreBuild {
  1157			stdout, err := e.runCommand(t, hook, preEnv, deadline)
  1158			if err != nil {
  1159				return err
  1160			}
  1161			preEnv = mergeHookExports(preEnv, parseHookExports(stdout))
  1162		}
  1163	
  1164		mainEnv := preEnv
  1165		if _, err := e.runCommand(t, t.Command, mainEnv, deadline); err != nil {
  1166			return err
  1167		}
  1168	
  1169		postEnv := append([]string(nil), baseEnv...)
  1170		for _, hook := range t.PostBuild {
  1171			stdout, err := e.runCommand(t, hook, postEnv, deadline)
  1172			if err != nil {
  1173				return err
  1174			}
  1175			postEnv = mergeHookExports(postEnv, parseHookExports(stdout))
  1176		}
  1177	
  1178		return nil
  1179	}
