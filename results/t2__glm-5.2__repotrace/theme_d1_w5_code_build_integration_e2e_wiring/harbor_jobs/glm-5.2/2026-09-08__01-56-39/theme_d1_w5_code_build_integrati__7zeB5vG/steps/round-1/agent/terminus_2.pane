   413	func validateConfig(cfg *Config) (map[string]*TargetConfig, error) {
   414		targetMap := map[string]*TargetConfig{}
   415		for i := range cfg.Targets {
   416			t := &cfg.Targets[i]
   417			if t.Name == "" {
   418				return nil, fmt.Errorf("target name is empty")
