   196	func runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string) error {
   197		cfg, configDir, err := loadConfig(configPath)
   198		if err != nil {
   199			return err
   200		}
   201		targetMap, err := validateConfig(cfg)
   202		if err != nil {
   203			return err
   204		}
   205		requested, err := selectTargets(cfg, targetMap, targetsFlag)
   206		if err != nil {
   207			return err
   208		}
   209		order := topologicalOrder(cfg, requested)
   210		reverseDeps := buildReverseDeps(cfg, requested)
   211	
   212		cacheKeys := make(map[string]string)
   213		for i := range cfg.Targets {
   214			t := &cfg.Targets[i]
   215			if !requested[t.Name] {
   216				continue
   217			}
   218			key, err := computeCacheKey(t, configDir)
   219			if err != nil {
   220				return err
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '220,410p'
[?2004l   220				return err
   221			}
   222			cacheKeys[t.Name] = key
   223		}
   224	
   225		executor := &buildExecutor{
   226			config:    cfg,
   227			configDir: configDir,
   228			cacheDir:  filepath.Join(configDir, ".buildctl-cache"),
   229			noCache:   noCache,
   230		}
   231	
   232		status := make(map[string]string)
   233		durations := make(map[string]int64)
   234		completed := 0
   235		total := len(requested)
   236		readyCh := make(chan *TargetConfig, total+1)
   237		resultCh := make(chan execResult, total+1)
   238	
   239		var wg sync.WaitGroup
   240		for i := 0; i < parallel; i++ {
   241			wg.Add(1)
   242			go func() {
   243				defer wg.Done()
   244				for t := range readyCh {
   245					resultCh <- executor.execute(t)
   246				}
   247			}()
   248		}
   249	
   250		buildStart := time.Now()
   251		for i := range cfg.Targets {
   252			t := &cfg.Targets[i]
   253			if requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {
   254				readyCh <- t
   255			}
   256		}
   257	
   258		for completed < total {
   259			res := <-resultCh
   260			status[res.name] = res.status
   261			durations[res.name] = res.durationMS
   262			if res.cacheKey != "" {
   263				cacheKeys[res.name] = res.cacheKey
   264			}
   265			completed++
   266	
   267			if res.status == "built" || res.status == "cached" {
   268				for _, dependent := range reverseDeps[res.name] {
   269					if allDependenciesComplete(dependent, targetMap, requested, status) {
   270						readyCh <- targetMap[dependent]
   271					}
   272				}
   273			} else {
   274				markSkipped(reverseDeps, status, durations, &completed, res.name)
   275			}
   276		}
   277	
   278		close(readyCh)
   279		wg.Wait()
   280	
   281		report := BuildReport{Pipeline: cfg.Pipeline.Name, Targets: []BuildTargetReport{}}
   282		for _, name := range order {
   283			st := status[name]
   284			if st == "" {
   285				st = "skipped"
   286			}
   287			report.Targets = append(report.Targets, BuildTargetReport{
   288				Name:       name,
   289				Status:     st,
   290				Cached:     st == "cached",
   291				DurationMS: durations[name],
   292				CacheKey:   cacheKeys[name],
   293			})
   294		}
   295	
   296		summary := BuildSummary{Total: len(report.Targets)}
   297		for _, t := range report.Targets {
   298			switch t.Status {
   299			case "built":
   300				summary.Built++
   301			case "cached":
   302				summary.Cached++
   303			case "failed":
   304				summary.Failed++
   305			case "skipped":
   306				summary.Skipped++
   307			}
   308		}
   309		summary.DurationMS = time.Since(buildStart).Milliseconds()
   310		report.Summary = summary
   311	
   312		data, err := json.MarshalIndent(report, "", "  ")
   313		if err != nil {
   314			return err
   315		}
   316		fmt.Println(string(data))
   317		if reportPath != "" {
   318			if err := os.WriteFile(reportPath, data, 0644); err != nil {
   319				return err
   320			}
   321		}
   322		if summary.Failed > 0 {
   323			return fmt.Errorf("build failed")
   324		}
   325		return nil
   326	}
