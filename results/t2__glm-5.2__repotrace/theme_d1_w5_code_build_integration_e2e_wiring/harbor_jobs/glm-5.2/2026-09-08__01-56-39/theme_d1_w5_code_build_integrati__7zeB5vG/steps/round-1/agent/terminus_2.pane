			copy := t
			copy.Name = substituteMatrixVars(t.Name, combo)
			copy.Command = substituteMatrixVars(t.Command, combo)
			copy.Dependencies = substituteMatrixSlice(t.Dependencies, combo)
			copy.Inputs = substituteMatrixSlice(t.Inputs, combo)
			copy.Outputs = substituteMatrixSlice(t.Outputs, combo)
			copy.Env = substituteMatrixEnv(t.Env, combo)
			copy.PreBuild = substituteMatrixSlice(t.PreBuild, combo)
			copy.PostBuild = substituteMatrixSlice(t.PostBuild, combo)
			copy.Matrix = nil
			copy.MatrixInclude = nil
			copy.MatrixExclude = nil
			expanded = append(expanded, copy)
		}
	}
	*targets = expanded
	return nil
}

