  1125	func betterBuildPath(a, b buildPath) bool {
  1126		if a.weight != b.weight {
  1127			return a.weight > b.weight
  1128		}
  1129		if len(a.names) != len(b.names) {
  1130			return len(a.names) > len(b.names)
  1131		}
  1132		for i := 0; i < len(a.names); i++ {
  1133			if a.names[i] != b.names[i] {
  1134				return a.names[i] < b.names[i]
  1135			}
  1136		}
  1137		return false
  1138	}
