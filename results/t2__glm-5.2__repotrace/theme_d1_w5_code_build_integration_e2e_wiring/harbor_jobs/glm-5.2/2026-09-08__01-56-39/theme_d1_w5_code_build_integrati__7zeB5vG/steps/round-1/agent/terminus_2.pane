[?2004l   260			visited[node] = true
   261	
   262			if node == to && len(current) > 1 {
   263				path := make([]string, len(current))
   264				copy(path, current)
   265				paths = append(paths, path)
   266			} else if node != to {
   267				for _, dep := range uniqueStrings(targetMap[node].Dependencies) {
   268					dfs(dep)
   269				}
   270			}
   271	
   272			current = current[:len(current)-1]
   273			delete(visited, node)
   274		}
   275		dfs(from)
   276		return paths
   277	}
   278	
   279	func sortPaths(paths [][]string) {
   280		sort.Slice(paths, func(i, j int) bool {
   281			if len(paths[i]) != len(paths[j]) {
   282				return len(paths[i]) < len(paths[j])
   283			}
   284			for k := 0; k < len(paths[i]) && k < len(paths[j]); k++ {
   285				if paths[i][k] != paths[j][k] {
   286					return paths[i][k] < paths[j][k]
   287				}
   288			}
   289			return false
   290		})
   291	}
   292	
   293	func topologicalOrderSubset(cfg *Config, subset map[string]bool) []string {
   294		indeg := map[string]int{}
   295		for name := range subset {
   296			indeg[name] = 0
   297		}
   298		for _, t := range cfg.Targets {
   299			if !subset[t.Name] {
   300				continue
   301			}
   302			for _, dep := range uniqueStrings(t.Dependencies) {
   303				if subset[dep] {
   304					indeg[t.Name]++
   305				}
   306			}
   307		}
   308	
   309		queue := []string{}
   310		for name := range subset {
   311			if indeg[name] == 0 {
   312				queue = append(queue, name)
   313			}
   314		}
   315		sort.Strings(queue)
   316	
   317		order := []string{}
   318		for len(queue) > 0 {
   319			name := queue[0]
   320			queue = queue[1:]
