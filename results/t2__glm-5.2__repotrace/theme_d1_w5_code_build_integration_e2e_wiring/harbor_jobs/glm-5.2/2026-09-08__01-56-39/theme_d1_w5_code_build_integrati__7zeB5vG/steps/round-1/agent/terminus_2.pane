   685	
   686	func topologicalOrder(cfg *Config, requested map[string]bool) []string {
   687		indeg := map[string]int{}
   688		for _, t := range cfg.Targets {
   689			if !requested[t.Name] {
   690				continue
   691			}
   692			count := 0
   693			for _, dep := range uniqueStrings(t.Dependencies) {
   694				if requested[dep] {
   695					count++
   696				}
   697			}
   698			indeg[t.Name] = count
   699		}
   700	
   701		queue := []string{}
   702		for _, t := range cfg.Targets {
   703			if requested[t.Name] && indeg[t.Name] == 0 {
   704				queue = append(queue, t.Name)
   705			}
   706		}
   707	
   708		order := []string{}
   709		for len(queue) > 0 {
   710			name := queue[0]
   711			queue = queue[1:]
   712			order = append(order, name)
   713			for _, t := range cfg.Targets {
   714				if !requested[t.Name] {
   715					continue
   716				}
   717				for _, dep := range uniqueStrings(t.Dependencies) {
   718					if dep == name {
   719						indeg[t.Name]--
   720						if indeg[t.Name] == 0 {
   721							queue = append(queue, t.Name)
   722						}
   723						break
   724					}
   725				}
   726			}
   727		}
   728		return order
   729	}
   730	
   731	func buildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {
   732		reverse := map[string][]string{}
   733		for _, t := range cfg.Targets {
   734			if !requested[t.Name] {
   735				continue
   736			}
   737			for _, dep := range uniqueStrings(t.Dependencies) {
   738				if requested[dep] {
   739					reverse[dep] = append(reverse[dep], t.Name)
   740				}
   741			}
   742		}
   743		return reverse
   744	}
