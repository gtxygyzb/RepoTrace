func runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string, vars []string) error {
	cfg, configDir, err := loadConfig(configPath, vars)
	if err != nil {
		return err
	}
	targetMap, err := validateConfig(cfg)
	if err != nil {
		return err
	}
	requested, err := selectTargets(cfg, targetMap, targetsFlag)
	if err != nil {
		return err
	}
	order := topologicalOrder(cfg, requested)
	reverseDeps := buildReverseDeps(cfg, requested)

	cacheKeys := make(map[string]string)
	for i := range cfg.Targets {
		t := &cfg.Targets[i]
		if !requested[t.Name] {
			continue
		}
		key, err := computeCacheKey(t, configDir)
		if err != nil {
			return err
		}
		cacheKeys[t.Name] = key
	}

	executor := &buildExecutor{
		config:    cfg,
		configDir: configDir,
		cacheDir:  filepath.Join(configDir, ".buildctl-cache"),
		noCache:   noCache,
	}

	status := make(map[string]string)
	durations := make(map[string]int64)
	completed := 0
	total := len(requested)
	readyCh := make(chan *TargetConfig, total+1)
	resultCh := make(chan execResult, total+1)

	var wg sync.WaitGroup
	for i := 0; i < parallel; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			for t := range readyCh {
				resultCh <- executor.execute(t)
			}
		}()
	}

	buildStart := time.Now()
	for i := range cfg.Targets {
		t := &cfg.Targets[i]
		if requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {
			readyCh <- t
		}
	}

	for completed < total {
		res := <-resultCh
		status[res.name] = res.status
		durations[res.name] = res.durationMS
		if res.cacheKey != "" {
			cacheKeys[res.name] = res.cacheKey
		}
		completed++

		if res.status == "built" || res.status == "cached" {
			for _, dependent := range reverseDeps[res.name] {
				if allDependenciesComplete(dependent, targetMap, requested, status) {
					readyCh <- targetMap[dependent]
				}
			}
		} else {
			markSkipped(reverseDeps, status, durations, &completed, res.name)
		}
	}

	close(readyCh)
	wg.Wait()

	report := BuildReport{Pipeline: cfg.Pipeline.Name, Targets: []BuildTargetReport{}}
	for _, name := range order {
		st := status[name]
		if st == "" {
			st = "skipped"
		}
		report.Targets = append(report.Targets, BuildTargetReport{
			Name:       name,
			Status:     st,
			Cached:     st == "cached",
			DurationMS: durations[name],
			CacheKey:   cacheKeys[name],
		})
	}

	summary := BuildSummary{Total: len(report.Targets)}
	for _, t := range report.Targets {
		switch t.Status {
		case "built":
			summary.Built++
		case "cached":
			summary.Cached++
		case "failed":
			summary.Failed++
		case "skipped":
			summary.Skipped++
		}
	}
	summary.DurationMS = time.Since(buildStart).Milliseconds()
	report.Summary = summary

	data, err := json.MarshalIndent(report, "", "  ")
	if err != nil {
		return err
	}
	fmt.Println(string(data))
	if reportPath != "" {
		if err := os.WriteFile(reportPath, data, 0644); err != nil {
			return err
		}
	}
	if summary.Failed > 0 {
		return fmt.Errorf("build failed")
	}
	return nil
}

func runGraph(configPath string, vars []string) error {
	cfg, _, err := loadConfig(configPath, vars)
	if err != nil {
		return err
	}
	if _, err := validateConfig(cfg); err != nil {
		return err
	}
	fmt.Printf("digraph %s {\n", strconv.Quote(cfg.Pipeline.Name))
	for _, t := range cfg.Targets {
		if len(uniqueStrings(t.Dependencies)) == 0 {
			fmt.Printf("  %s;\n", strconv.Quote(t.Name))
		}
	}
	for _, t := range cfg.Targets {
		for _, dep := range uniqueStrings(t.Dependencies) {
			fmt.Printf("  %s -> %s;\n", strconv.Quote(t.Name), strconv.Quote(dep))
		}
	}
	fmt.Println("}")
	return nil
}

func runClean(configPath string, vars []string) error {
	abs, err := filepath.Abs(configPath)
	if err != nil {
		return err
	}
	cacheDir := filepath.Join(filepath.Dir(abs), ".buildctl-cache")
	return os.RemoveAll(cacheDir)
}

func runStatus(configPath string, vars []string) error {
	cfg, configDir, err := loadConfig(configPath, vars)
	if err != nil {
		return err
	}
	if _, err := validateConfig(cfg); err != nil {
		return err
	}
	cacheDir := filepath.Join(configDir, ".buildctl-cache")
	report := StatusReport{Targets: []StatusTarget{}}
	for i := range cfg.Targets {
		t := &cfg.Targets[i]
		key, err := computeCacheKey(t, configDir)
		if err != nil {
			return err
		}
		valid, entry, err := cacheValid(cacheDir, key, t.Outputs, configDir)
		if err != nil {
			return err
		}
		st := StatusTarget{Name: t.Name, Cached: valid}
		if valid {
			st.CacheKey = key
			st.CachedAt = entry.Timestamp
		}
		report.Targets = append(report.Targets, st)
	}
	data, err := json.MarshalIndent(report, "", "  ")
	if err != nil {
		return err
	}
	fmt.Println(string(data))
	return nil
}

func loadConfig(path string, varOverrides []string) (*Config, string, error) {
	abs, err := filepath.Abs(path)
	if err != nil {
		return nil, "", err
	}
	overrides, err := parseVarOverrides(varOverrides)
	if err != nil {
		return nil, "", err
	}
	loader := &configLoader{
		variables:   make(map[string]string),
		targetNames: make(map[string]bool),
	}
	for k, v := range overrides {
		loader.variables[k] = v
	}
	if err := loader.loadFile(abs, true); err != nil {
		return nil, "", err
	}
	for i := range loader.targets {
		t := &loader.targets[i]
		expanded, err := expandString(t.Command, loader.variables, make(map[string]bool))
		if err != nil {
			return nil, "", err
		}
		t.Command = expanded
		for j, p := range t.Inputs {
			expanded, err := expandString(p, loader.variables, make(map[string]bool))
			if err != nil {
				return nil, "", err
			}
			t.Inputs[j] = expanded
		}
		for j, p := range t.Outputs {
			expanded, err := expandString(p, loader.variables, make(map[string]bool))
			if err != nil {
				return nil, "", err
			}
			t.Outputs[j] = expanded
		}
		t.Dependencies = uniqueStrings(t.Dependencies)
		if t.Timeout <= 0 {
			t.Timeout = 300
		}
	}
	cfg := &Config{
		Pipeline:  PipelineConfig{Name: loader.pipelineName, Imports: loader.rootImports},
		Targets:   loader.targets,
		Variables: loader.variables,
	}
	return cfg, filepath.Dir(abs), nil
}

type configLoader struct {
	pipelineName string
	rootImports  []string
	variables    map[string]string
	targets      []TargetConfig
	targetNames  map[string]bool
	importStack  []string
}

func (l *configLoader) loadFile(absPath string, isRoot bool) error {
	for _, p := range l.importStack {
		if p == absPath {
			chain := append([]string{}, l.importStack...)
			chain = append(chain, absPath)
			return fmt.Errorf("circular import detected: %s", strings.Join(chain, " -> "))
		}
	}
	l.importStack = append(l.importStack, absPath)
	defer func() { l.importStack = l.importStack[:len(l.importStack)-1] }()

	var fileCfg Config
	if _, err := toml.DecodeFile(absPath, &fileCfg); err != nil {
		return err
	}

	if isRoot {
		l.pipelineName = fileCfg.Pipeline.Name
		l.rootImports = fileCfg.Pipeline.Imports
	}

	for k, v := range fileCfg.Variables {
		if _, exists := l.variables[k]; !exists {
			l.variables[k] = v
		}
	}

	for _, imp := range fileCfg.Pipeline.Imports {
		expanded, err := expandString(imp, l.variables, make(map[string]bool))
		if err != nil {
			return err
		}
		importPath := expanded
		if !filepath.IsAbs(importPath) {
			importPath = filepath.Join(filepath.Dir(absPath), importPath)
		}
		importAbs, err := filepath.Abs(importPath)
		if err != nil {
			return err
[?2004hroot@n30009:/app# sed -n '520,900p' main.go
[?2004l			return err
		}
		if err := l.loadFile(importAbs, false); err != nil {
			return err
		}
	}

	for _, t := range fileCfg.Targets {
		if l.targetNames[t.Name] {
			return fmt.Errorf("duplicate target name %q", t.Name)
		}
		l.targetNames[t.Name] = true
		l.targets = append(l.targets, t)
	}

	return nil
}

func parseVarOverrides(vars []string) (map[string]string, error) {
	m := make(map[string]string)
	for _, v := range vars {
		idx := strings.Index(v, "=")
		if idx == -1 {
			return nil, fmt.Errorf("invalid --var %q, expected key=value", v)
		}
		key := v[:idx]
		if key == "" {
			return nil, fmt.Errorf("invalid --var %q, empty key", v)
		}
		m[key] = v[idx+1:]
	}
	return m, nil
}

func expandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {
	var b strings.Builder
	i := 0
	for i < len(s) {
		if i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {
			end := strings.Index(s[i:], "}")
			if end == -1 {
				return "", fmt.Errorf("unterminated variable reference in %q", s)
			}
			name := s[i+2 : i+end]
			if name == "" {
				return "", fmt.Errorf("empty variable reference in %q", s)
			}
			if visiting[name] {
				return "", fmt.Errorf("variable cycle detected: %q", name)
			}
			val, ok := vars[name]
			if !ok {
				return "", fmt.Errorf("unresolved variable %q", name)
			}
			visiting[name] = true
			expanded, err := expandString(val, vars, visiting)
			if err != nil {
				return "", err
			}
			delete(visiting, name)
			b.WriteString(expanded)
			i += end + 1
		} else {
			b.WriteByte(s[i])
			i++
		}
	}
	return b.String(), nil
}

func validateConfig(cfg *Config) (map[string]*TargetConfig, error) {
	targetMap := map[string]*TargetConfig{}
	for i := range cfg.Targets {
		t := &cfg.Targets[i]
		if t.Name == "" {
			return nil, fmt.Errorf("target name is empty")
		}
		if _, ok := targetMap[t.Name]; ok {
			return nil, fmt.Errorf("duplicate target name %q", t.Name)
		}
		targetMap[t.Name] = t
	}

	for _, t := range targetMap {
		for _, dep := range t.Dependencies {
			if _, ok := targetMap[dep]; !ok {
				return nil, fmt.Errorf("target %q depends on missing target %q", t.Name, dep)
			}
		}
	}

	states := map[string]int{}
	var stack []string
	var dfs func(name string) error
	dfs = func(name string) error {
		states[name] = 1
		stack = append(stack, name)
		for _, dep := range targetMap[name].Dependencies {
			if states[dep] == 1 {
				idx := 0
				for i, s := range stack {
					if s == dep {
						idx = i
						break
					}
				}
				cycle := append([]string{}, stack[idx:]...)
				cycle = append(cycle, dep)
				return fmt.Errorf("cycle detected: %s", strings.Join(cycle, " -> "))
			}
			if states[dep] == 0 {
				if err := dfs(dep); err != nil {
					return err
				}
			}
		}
		stack = stack[:len(stack)-1]
		states[name] = 2
		return nil
	}

	names := make([]string, 0, len(targetMap))
	for n := range targetMap {
		names = append(names, n)
	}
	sort.Strings(names)
	for _, n := range names {
		if states[n] == 0 {
			if err := dfs(n); err != nil {
				return nil, err
			}
		}
	}
	return targetMap, nil
}

func selectTargets(cfg *Config, targetMap map[string]*TargetConfig, targetsFlag string) (map[string]bool, error) {
	if strings.TrimSpace(targetsFlag) == "" {
		requested := map[string]bool{}
		for _, t := range cfg.Targets {
			requested[t.Name] = true
		}
		return requested, nil
	}

	requested := map[string]bool{}
	for _, part := range strings.Split(targetsFlag, ",") {
		name := strings.TrimSpace(part)
		if _, ok := targetMap[name]; !ok {
			return nil, fmt.Errorf("target %q not found", name)
		}
		var visit func(string)
		visit = func(n string) {
			if requested[n] {
				return
			}
			requested[n] = true
			for _, dep := range targetMap[n].Dependencies {
				visit(dep)
			}
		}
		visit(name)
	}
	return requested, nil
}

func topologicalOrder(cfg *Config, requested map[string]bool) []string {
	indeg := map[string]int{}
	for _, t := range cfg.Targets {
		if !requested[t.Name] {
			continue
		}
		count := 0
		for _, dep := range uniqueStrings(t.Dependencies) {
			if requested[dep] {
				count++
			}
		}
		indeg[t.Name] = count
	}

	queue := []string{}
	for _, t := range cfg.Targets {
		if requested[t.Name] && indeg[t.Name] == 0 {
			queue = append(queue, t.Name)
		}
	}

	order := []string{}
	for len(queue) > 0 {
		name := queue[0]
		queue = queue[1:]
		order = append(order, name)
		for _, t := range cfg.Targets {
			if !requested[t.Name] {
				continue
			}
			for _, dep := range uniqueStrings(t.Dependencies) {
				if dep == name {
					indeg[t.Name]--
					if indeg[t.Name] == 0 {
						queue = append(queue, t.Name)
					}
					break
				}
			}
		}
	}
	return order
}

func buildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {
	reverse := map[string][]string{}
	for _, t := range cfg.Targets {
		if !requested[t.Name] {
			continue
		}
		for _, dep := range uniqueStrings(t.Dependencies) {
			if requested[dep] {
				reverse[dep] = append(reverse[dep], t.Name)
			}
		}
	}
	return reverse
}

func allDependenciesComplete(name string, targetMap map[string]*TargetConfig, requested map[string]bool, status map[string]string) bool {
	for _, dep := range targetMap[name].Dependencies {
		if !requested[dep] {
			continue
		}
		s := status[dep]
		if s != "built" && s != "cached" {
			return false
		}
	}
	return true
}

func markSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {
	for _, dependent := range reverseDeps[name] {
		if status[dependent] == "" {
			status[dependent] = "skipped"
			durations[dependent] = 0
			*completed++
			markSkipped(reverseDeps, status, durations, completed, dependent)
		}
	}
}

func (e *buildExecutor) execute(t *TargetConfig) execResult {
	start := time.Now()
	key, err := computeCacheKey(t, e.configDir)
	if err != nil {
		return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
	}

	if !e.noCache {
		valid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)
		if err != nil {
			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
		}
		if valid {
			return execResult{name: t.Name, status: "cached", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}
		}
	}

	timeout := t.Timeout
	if timeout <= 0 {
		timeout = 300
	}
	deadline := time.Now().Add(time.Duration(timeout) * time.Second)

	baseEnv := mergedEnv(t.Env)
	preEnv := append([]string(nil), baseEnv...)

	for _, hook := range t.PreBuild {
		stdout, err := e.runCommand(t, hook, preEnv, deadline)
		if err != nil {
			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
		}
		preEnv = mergeHookExports(preEnv, parseHookExports(stdout))
	}

	mainEnv := preEnv
	if _, err := e.runCommand(t, t.Command, mainEnv, deadline); err != nil {
		return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
	}

	postEnv := append([]string(nil), baseEnv...)
	for _, hook := range t.PostBuild {
		stdout, err := e.runCommand(t, hook, postEnv, deadline)
		if err != nil {
			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
		}
		postEnv = mergeHookExports(postEnv, parseHookExports(stdout))
	}

	elapsed := time.Since(start).Milliseconds()
	entry := CacheEntry{
		CacheKey:   key,
		TargetName: t.Name,
		Timestamp:  time.Now().UTC().Format(time.RFC3339),
		Outputs:    t.Outputs,
	}
	if err := writeCacheEntry(e.cacheDir, entry); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
	}
	return execResult{name: t.Name, status: "built", durationMS: elapsed, cacheKey: key}
}

func (e *buildExecutor) runCommand(t *TargetConfig, command string, env []string, deadline time.Time) (string, error) {
	if strings.TrimSpace(command) == "" {
		return "", nil
	}
	remaining := time.Until(deadline)
	if remaining <= 0 {
		return "", fmt.Errorf("target %q timed out after %ds", t.Name, t.Timeout)
	}

	var stdout, stderr bytes.Buffer
	ctx, cancel := context.WithTimeout(context.Background(), remaining)
	defer cancel()
	cmd := exec.CommandContext(ctx, "sh", "-c", command)
	cmd.Dir = e.configDir
	cmd.Env = env
	cmd.Stdout = &stdout
	cmd.Stderr = &stderr
	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}

	if err := cmd.Start(); err != nil {
		return "", err
	}

	waitCh := make(chan error, 1)
	go func() {
		waitCh <- cmd.Wait()
	}()

	select {
	case <-ctx.Done():
		if cmd.Process != nil {
			_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
		}
		<-waitCh
		return "", fmt.Errorf("target %q timed out after %ds", t.Name, t.Timeout)
	case err := <-waitCh:
		if err != nil {
			if stderr.Len() > 0 {
				fmt.Fprintf(os.Stderr, "target %q stderr:\n%s", t.Name, stderr.String())
			}
			return "", err
		}
	}
	return stdout.String(), nil
}

func computeCacheKey(t *TargetConfig, configDir string) (string, error) {
	h := sha256.New()
	if _, err := io.WriteString(h, t.Command); err != nil {
		return "", err
	}

	for _, hook := range t.PreBuild {
		if _, err := io.WriteString(h, hook); err != nil {
			return "", err
		}
	}
	for _, hook := range t.PostBuild {
		if _, err := io.WriteString(h, hook); err != nil {
			return "", err
		}
	}

	deps := make([]string, len(t.Dependencies))
	copy(deps, t.Dependencies)
	sort.Strings(deps)
	for _, d := range deps {
		if _, err := io.WriteString(h, "dep:"+d); err != nil {
			return "", err
