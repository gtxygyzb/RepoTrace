   888	func (e *buildExecutor) runCommand(t *TargetConfig, command string, env []string, deadline time.Time) (string, error) {
   889		if strings.TrimSpace(command) == "" {
   890			return "", nil
   891		}
   892		remaining := time.Until(deadline)
   893		if remaining <= 0 {
   894			return "", fmt.Errorf("target %q timed out after %ds", t.Name, t.Timeout)
   895		}
   896	
   897		var stdout, stderr bytes.Buffer
   898		ctx, cancel := context.WithTimeout(context.Background(), remaining)
   899		defer cancel()
   900		cmd := exec.CommandContext(ctx, "sh", "-c", command)
   901		cmd.Dir = e.configDir
   902		cmd.Env = env
   903		cmd.Stdout = &stdout
   904		cmd.Stderr = &stderr
   905		cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
   906	
   907		if err := cmd.Start(); err != nil {
   908			return "", err
   909		}
   910	
   911		waitCh := make(chan error, 1)
   912		go func() {
   913			waitCh <- cmd.Wait()
   914		}()
   915	
   916		select {
   917		case <-ctx.Done():
   918			if cmd.Process != nil {
   919				_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
   920			}
