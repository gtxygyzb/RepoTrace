   236		readyCh := make(chan *TargetConfig, total+1)
   237		resultCh := make(chan execResult, total+1)
   238	
   239		var wg sync.WaitGroup
   240		for i := 0; i < parallel; i++ {
   241			wg.Add(1)
   242			go func() {
   243				defer wg.Done()
   244				for t := range readyCh {
   245					resultCh <- executor.execute(t)
   246				}
   247			}()
   248		}
   249	
   250		buildStart := time.Now()
   251		for i := range cfg.Targets {
   252			t := &cfg.Targets[i]
   253			if requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {
   254				readyCh <- t
   255			}
   256		}
   257	
   258		for completed < total {
   259			res := <-resultCh
   260			status[res.name] = res.status
   261			durations[res.name] = res.durationMS
   262			if res.cacheKey != "" {
   263				cacheKeys[res.name] = res.cacheKey
   264			}
   265			completed++
   266	
   267			if res.status == "built" || res.status == "cached" {
   268				for _, dependent := range reverseDeps[res.name] {
   269					if allDependenciesComplete(dependent, targetMap, requested, status) {
   270						readyCh <- targetMap[dependent]
   271					}
   272				}
   273			} else {
   274				markSkipped(reverseDeps, status, durations, &completed, res.name)
   275			}
   276		}
   277	
   278		close(readyCh)
   279		wg.Wait()
   280	
   281		report := BuildReport{Pipeline: cfg.Pipeline.Name, Targets: []BuildTargetReport{}}
   282		for _, name := range order {
