[?2004l   520			}
   521		}
   522	
   523		for _, t := range fileCfg.Targets {
   524			if l.targetNames[t.Name] {
   525				return fmt.Errorf("duplicate target name %q", t.Name)
   526			}
   527			l.targetNames[t.Name] = true
   528			l.targets = append(l.targets, t)
   529		}
   530	
   531		return nil
   532	}
   533	
   534	func parseVarOverrides(vars []string) (map[string]string, error) {
   535		m := make(map[string]string)
   536		for _, v := range vars {
   537			idx := strings.Index(v, "=")
   538			if idx == -1 {
   539				return nil, fmt.Errorf("invalid --var %q, expected key=value", v)
   540			}
   541			key := v[:idx]
   542			if key == "" {
   543				return nil, fmt.Errorf("invalid --var %q, empty key", v)
   544			}
   545			m[key] = v[idx+1:]
   546		}
   547		return m, nil
   548	}
   549	
   550	func expandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {
   551		var b strings.Builder
   552		i := 0
   553		for i < len(s) {
   554			if i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {
   555				end := strings.Index(s[i:], "}")
   556				if end == -1 {
   557					return "", fmt.Errorf("unterminated variable reference in %q", s)
   558				}
   559				name := s[i+2 : i+end]
   560				if name == "" {
   561					return "", fmt.Errorf("empty variable reference in %q", s)
   562				}
   563				if visiting[name] {
   564					return "", fmt.Errorf("variable cycle detected: %q", name)
   565				}
   566				val, ok := vars[name]
   567				if !ok {
   568					return "", fmt.Errorf("unresolved variable %q", name)
   569				}
   570				visiting[name] = true
   571				expanded, err := expandString(val, vars, visiting)
   572				if err != nil {
   573					return "", err
   574				}
   575				delete(visiting, name)
   576				b.WriteString(expanded)
   577				i += end + 1
   578			} else {
   579				b.WriteByte(s[i])
   580				i++
   581			}
   582		}
   583		return b.String(), nil
   584	}
   585	
   586	func validateConfig(cfg *Config) (map[string]*TargetConfig, error) {
   587		targetMap := map[string]*TargetConfig{}
   588		for i := range cfg.Targets {
   589			t := &cfg.Targets[i]
   590			if t.Name == "" {
   591				return nil, fmt.Errorf("target name is empty")
   592			}
   593			if _, ok := targetMap[t.Name]; ok {
   594				return nil, fmt.Errorf("duplicate target name %q", t.Name)
   595			}
   596			targetMap[t.Name] = t
   597		}
   598	
   599		for _, t := range targetMap {
   600			for _, dep := range t.Dependencies {
   601				if _, ok := targetMap[dep]; !ok {
   602					return nil, fmt.Errorf("target %q depends on missing target %q", t.Name, dep)
   603				}
   604			}
   605		}
   606	
   607		states := map[string]int{}
   608		var stack []string
   609		var dfs func(name string) error
   610		dfs = func(name string) error {
   611			states[name] = 1
   612			stack = append(stack, name)
   613			for _, dep := range targetMap[name].Dependencies {
   614				if states[dep] == 1 {
   615					idx := 0
   616					for i, s := range stack {
   617						if s == dep {
   618							idx = i
   619							break
   620						}
   621					}
   622					cycle := append([]string{}, stack[idx:]...)
   623					cycle = append(cycle, dep)
   624					return fmt.Errorf("cycle detected: %s", strings.Join(cycle, " -> "))
   625				}
   626				if states[dep] == 0 {
   627					if err := dfs(dep); err != nil {
   628						return err
   629					}
   630				}
   631			}
   632			stack = stack[:len(stack)-1]
   633			states[name] = 2
   634			return nil
   635		}
   636	
   637		names := make([]string, 0, len(targetMap))
   638		for n := range targetMap {
   639			names = append(names, n)
   640		}
   641		sort.Strings(names)
   642		for _, n := range names {
   643			if states[n] == 0 {
   644				if err := dfs(n); err != nil {
   645					return nil, err
   646				}
   647			}
   648		}
   649		return targetMap, nil
   650	}
