[?2004l   225	func runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string, vars []string, keepGoing bool) error {
   226		cfg, configDir, err := loadConfig(configPath, vars)
   227		if err != nil {
   228			return err
   229		}
   230		targetMap, err := validateConfig(cfg)
   231		if err != nil {
   232			return err
   233		}
   234		requested, err := selectTargets(cfg, targetMap, targetsFlag)
   235		if err != nil {
   236			return err
   237		}
   238		order := topologicalOrder(cfg, requested)
   239		reverseDeps := buildReverseDeps(cfg, requested)
   240	
   241		cacheKeys := make(map[string]string)
   242		for i := range cfg.Targets {
   243			t := &cfg.Targets[i]
   244			if !requested[t.Name] {
   245				continue
   246			}
   247			key, err := computeCacheKey(t, configDir)
   248			if err != nil {
   249				return err
   250			}
   251			cacheKeys[t.Name] = key
   252		}
   253	
   254		executor := &buildExecutor{
   255			config:    cfg,
   256			configDir: configDir,
   257			cacheDir:  filepath.Join(configDir, ".buildctl-cache"),
   258			noCache:   noCache,
   259		}
   260	
   261		status := make(map[string]string)
   262		durations := make(map[string]int64)
   263		completed := 0
   264		total := len(requested)
   265		readyCh := make(chan *TargetConfig, total+1)
   266		resultCh := make(chan execResult, total+1)
   267	
   268		var mu sync.Mutex
   269		started := make(map[string]bool)
   270		cancelled := false
   271	
   272		var wg sync.WaitGroup
   273		for i := 0; i < parallel; i++ {
   274			wg.Add(1)
   275			go func() {
   276				defer wg.Done()
   277				for t := range readyCh {
   278					mu.Lock()
   279					if cancelled {
   280						mu.Unlock()
   281						continue
   282					}
   283					started[t.Name] = true
   284					mu.Unlock()
   285					res := executor.execute(t)
   286					if res.status == "failed" && !keepGoing {
   287						mu.Lock()
   288						cancelled = true
   289						mu.Unlock()
   290					}
   291					resultCh <- res
   292				}
   293			}()
   294		}
   295	
   296		buildStart := time.Now()
   297		for i := range cfg.Targets {
   298			t := &cfg.Targets[i]
   299			if requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {
   300				readyCh <- t
   301			}
   302		}
   303	
   304		for completed < total {
   305			res := <-resultCh
   306			status[res.name] = res.status
   307			durations[res.name] = res.durationMS
   308			if res.cacheKey != "" {
   309				cacheKeys[res.name] = res.cacheKey
   310			}
   311			completed++
   312	
   313			if res.status == "built" || res.status == "cached" {
   314				mu.Lock()
   315				canSchedule := !cancelled
   316				mu.Unlock()
   317				if canSchedule {
   318					for _, dependent := range reverseDeps[res.name] {
   319						if allDependenciesComplete(dependent, targetMap, requested, status) {
   320							readyCh <- targetMap[dependent]
   321						}
   322					}
   323				}
   324				continue
   325			}
   326	
   327			if res.status == "failed" {
   328				markSkipped(reverseDeps, status, durations, &completed, res.name)
   329				if !keepGoing {
   330					mu.Lock()
   331					cancelled = true
   332					for i := range cfg.Targets {
   333						t := &cfg.Targets[i]
   334						if !requested[t.Name] {
   335							continue
   336						}
   337						if status[t.Name] == "" && !started[t.Name] {
   338							status[t.Name] = "cancelled"
   339							durations[t.Name] = 0
   340							completed++
   341						}
   342					}
   343					mu.Unlock()
   344				}
   345				continue
   346			}
   347		}
   348	
   349		close(readyCh)
   350		wg.Wait()
   351	
   352		report := BuildReport{Pipeline: cfg.Pipeline.Name, Targets: []BuildTargetReport{}}
   353		for _, name := range order {
   354			st := status[name]
   355			if st == "" {
   356				if keepGoing {
   357					st = "skipped"
   358				} else {
   359					st = "cancelled"
   360				}
   361			}
   362			report.Targets = append(report.Targets, BuildTargetReport{
   363				Name:       name,
   364				Status:     st,
   365				Cached:     st == "cached",
   366				DurationMS: durations[name],
   367				CacheKey:   cacheKeys[name],
   368			})
   369		}
   370	
   371		summary := BuildSummary{Total: len(report.Targets)}
   372		for _, t := range report.Targets {
   373			switch t.Status {
   374			case "built":
   375				summary.Built++
   376			case "cached":
   377				summary.Cached++
   378			case "failed":
   379				summary.Failed++
   380			case "skipped":
   381				summary.Skipped++
   382			case "cancelled":
   383				summary.Cancelled++
   384			}
   385		}
   386		summary.DurationMS = time.Since(buildStart).Milliseconds()
   387		report.Summary = summary
   388	
   389		data, err := json.MarshalIndent(report, "", "  ")
   390		if err != nil {
   391			return err
   392		}
   393		fmt.Println(string(data))
   394		if reportPath != "" {
   395			if err := os.WriteFile(reportPath, data, 0644); err != nil {
   396				return err
   397			}
   398		}
   399		if summary.Failed > 0 {
   400			return fmt.Errorf("build failed")
   401		}
   402		return nil
   403	}
