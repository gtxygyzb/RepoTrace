   120	func runBuildCommand(args []string) {
   121		fs := flag.NewFlagSet("build", flag.ContinueOnError)
   122		fs.SetOutput(os.Stderr)
   123		configPath := fs.String("config", "", "path to TOML pipeline file")
   124		targetsFlag := fs.String("targets", "", "comma-separated target names")
   125		parallel := fs.Int("parallel", runtime.NumCPU(), "max concurrent target executions")
   126		noCache := fs.Bool("no-cache", false, "skip all cache lookups")
   127		reportPath := fs.String("report", "", "also write JSON report to this file")
   128		if err := fs.Parse(args); err != nil {
   129			os.Exit(1)
   130		}
   131		if *configPath == "" {
   132			fmt.Fprintln(os.Stderr, "error: --config is required")
   133			os.Exit(1)
   134		}
   135		if *parallel < 1 {
   136			fmt.Fprintln(os.Stderr, "error: --parallel must be at least 1")
   137			os.Exit(1)
   138		}
   139		if err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath); err != nil {
   140			fmt.Fprintln(os.Stderr, err)
   141			os.Exit(1)
   142		}
   143	}
