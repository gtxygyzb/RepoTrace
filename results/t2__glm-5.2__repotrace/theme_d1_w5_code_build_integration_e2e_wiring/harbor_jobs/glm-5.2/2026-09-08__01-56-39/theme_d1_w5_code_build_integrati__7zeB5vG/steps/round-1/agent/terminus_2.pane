type stringSliceFlag []string

func (s *stringSliceFlag) String() string {
	return strings.Join(*s, ",")
}

func (s *stringSliceFlag) Set(value string) error {
	*s = append(*s, value)
	return nil
}

type PipelineConfig struct {
	Name    string   `toml:"name"`
	Imports []string `toml:"imports"`
}

type TargetConfig struct {
	Name         string            `toml:"name"`
	Command      string            `toml:"command"`
	Dependencies []string          `toml:"dependencies"`
	Inputs       []string          `toml:"inputs"`
	Outputs      []string          `toml:"outputs"`
	Env          map[string]string `toml:"env"`
	Timeout      int               `toml:"timeout"`
}

type Config struct {
	Pipeline  PipelineConfig    `toml:"pipeline"`
	Targets   []TargetConfig    `toml:"targets"`
	Variables map[string]string `toml:"variables"`
}

type CacheEntry struct {
	CacheKey   string   `json:"cache_key"`
	TargetName string   `json:"target_name"`
	Timestamp  string   `json:"timestamp"`
	Outputs    []string `json:"outputs"`
}

type BuildTargetReport struct {
	Name       string `json:"name"`
	Status     string `json:"status"`
	Cached     bool   `json:"cached"`
	DurationMS int64  `json:"duration_ms"`
	CacheKey   string `json:"cache_key"`
}

type BuildReport struct {
	Pipeline string              `json:"pipeline"`
	Targets  []BuildTargetReport `json:"targets"`
	Summary  BuildSummary        `json:"summary"`
}

type BuildSummary struct {
	Total      int   `json:"total"`
	Built      int   `json:"built"`
	Cached     int   `json:"cached"`
	Failed     int   `json:"failed"`
	Skipped    int   `json:"skipped"`
	DurationMS int64 `json:"duration_ms"`
}

type StatusTarget struct {
	Name     string `json:"name"`
	Cached   bool   `json:"cached"`
	CacheKey string `json:"cache_key,omitempty"`
	CachedAt string `json:"cached_at,omitempty"`
}

type StatusReport struct {
	Targets []StatusTarget `json:"targets"`
}

type execResult struct {
	name       string
	status     string
	cached     bool
	durationMS int64
	cacheKey   string
}

type buildExecutor struct {
	config    *Config
	configDir string
	cacheDir  string
	noCache   bool
}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: buildctl <command> [flags]")
		os.Exit(1)
	}
	switch os.Args[1] {
	case "build":
		runBuildCommand(os.Args[2:])
	case "graph":
		runGraphCommand(os.Args[2:])
	case "clean":
		runCleanCommand(os.Args[2:])
	case "status":
		runStatusCommand(os.Args[2:])
	default:
		fmt.Fprintf(os.Stderr, "unknown command %q\n", os.Args[1])
		os.Exit(1)
	}
}

func runBuildCommand(args []string) {
	fs := flag.NewFlagSet("build", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	configPath := fs.String("config", "", "path to TOML pipeline file")
	targetsFlag := fs.String("targets", "", "comma-separated target names")
	parallel := fs.Int("parallel", runtime.NumCPU(), "max concurrent target executions")
	noCache := fs.Bool("no-cache", false, "skip all cache lookups")
	reportPath := fs.String("report", "", "also write JSON report to this file")
[?2004hroot@n30009:/app# sed -n '380,470p' main.go
[?2004l
func runStatus(configPath string, vars []string) error {
	cfg, configDir, err := loadConfig(configPath, vars)
	if err != nil {
		return err
	}
	if _, err := validateConfig(cfg); err != nil {
		return err
	}
	cacheDir := filepath.Join(configDir, ".buildctl-cache")
	report := StatusReport{Targets: []StatusTarget{}}
	for i := range cfg.Targets {
		t := &cfg.Targets[i]
		key, err := computeCacheKey(t, configDir)
		if err != nil {
			return err
		}
		valid, entry, err := cacheValid(cacheDir, key, t.Outputs, configDir)
		if err != nil {
			return err
		}
		st := StatusTarget{Name: t.Name, Cached: valid}
		if valid {
			st.CacheKey = key
			st.CachedAt = entry.Timestamp
		}
		report.Targets = append(report.Targets, st)
	}
	data, err := json.MarshalIndent(report, "", "  ")
	if err != nil {
		return err
	}
	fmt.Println(string(data))
	return nil
}

func loadConfig(path string, varOverrides []string) (*Config, string, error) {
	abs, err := filepath.Abs(path)
	if err != nil {
		return nil, "", err
	}
	overrides, err := parseVarOverrides(varOverrides)
	if err != nil {
		return nil, "", err
	}
	loader := &configLoader{
		variables:   make(map[string]string),
		targetNames: make(map[string]bool),
	}
	for k, v := range overrides {
		loader.variables[k] = v
	}
	if err := loader.loadFile(abs, true); err != nil {
		return nil, "", err
	}
	for i := range loader.targets {
		t := &loader.targets[i]
		expanded, err := expandString(t.Command, loader.variables, make(map[string]bool))
		if err != nil {
			return nil, "", err
		}
		t.Command = expanded
		for j, p := range t.Inputs {
			expanded, err := expandString(p, loader.variables, make(map[string]bool))
			if err != nil {
				return nil, "", err
			}
			t.Inputs[j] = expanded
		}
		for j, p := range t.Outputs {
			expanded, err := expandString(p, loader.variables, make(map[string]bool))
			if err != nil {
				return nil, "", err
			}
			t.Outputs[j] = expanded
		}
		t.Dependencies = uniqueStrings(t.Dependencies)
		if t.Timeout <= 0 {
			t.Timeout = 300
		}
	}
	cfg := &Config{
		Pipeline:  PipelineConfig{Name: loader.pipelineName, Imports: loader.rootImports},
		Targets:   loader.targets,
		Variables: loader.variables,
	}
	return cfg, filepath.Dir(abs), nil
}

