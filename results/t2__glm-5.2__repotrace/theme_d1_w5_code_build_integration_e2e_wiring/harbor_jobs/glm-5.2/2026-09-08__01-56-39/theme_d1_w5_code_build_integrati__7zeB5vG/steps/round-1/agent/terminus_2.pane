[?2004l   738	func topologicalOrder(cfg *Config, requested map[string]bool) []string {
   739		indeg := map[string]int{}
   740		for _, t := range cfg.Targets {
   741			if !requested[t.Name] {
   742				continue
   743			}
   744			count := 0
   745			for _, dep := range uniqueStrings(t.Dependencies) {
   746				if requested[dep] {
   747					count++
   748				}
   749			}
   750			indeg[t.Name] = count
   751		}
   752	
   753		queue := []string{}
   754		for _, t := range cfg.Targets {
   755			if requested[t.Name] && indeg[t.Name] == 0 {
   756				queue = append(queue, t.Name)
   757			}
   758		}
   759	
   760		order := []string{}
   761		for len(queue) > 0 {
   762			name := queue[0]
   763			queue = queue[1:]
   764			order = append(order, name)
   765			for _, t := range cfg.Targets {
   766				if !requested[t.Name] {
   767					continue
   768				}
   769				for _, dep := range uniqueStrings(t.Dependencies) {
   770					if dep == name {
   771						indeg[t.Name]--
   772						if indeg[t.Name] == 0 {
   773							queue = append(queue, t.Name)
   774						}
   775						break
   776					}
   777				}
   778			}
   779		}
   780		return order
   781	}
