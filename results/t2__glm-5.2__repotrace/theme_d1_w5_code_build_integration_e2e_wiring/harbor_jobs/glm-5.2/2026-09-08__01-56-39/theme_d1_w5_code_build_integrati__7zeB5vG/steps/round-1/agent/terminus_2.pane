   383				st.CachedAt = entry.Timestamp
   384			}
   385			report.Targets = append(report.Targets, st)
   386		}
   387		data, err := json.MarshalIndent(report, "", "  ")
   388		if err != nil {
   389			return err
   390		}
   391		fmt.Println(string(data))
