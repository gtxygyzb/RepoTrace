  1144			stdout, err := e.runCommand(t, hook, postEnv, deadline)
  1145			if err != nil {
  1146				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
  1147			}
  1148			postEnv = mergeHookExports(postEnv, parseHookExports(stdout))
