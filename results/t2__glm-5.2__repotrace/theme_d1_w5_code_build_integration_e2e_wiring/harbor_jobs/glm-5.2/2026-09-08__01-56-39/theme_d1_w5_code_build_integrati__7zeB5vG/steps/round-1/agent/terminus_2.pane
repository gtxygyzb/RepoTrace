   395	func loadConfig(path string) (*Config, string, error) {
   396		abs, err := filepath.Abs(path)
   397		if err != nil {
   398			return nil, "", err
   399		}
   400		var cfg Config
   401		if _, err := toml.DecodeFile(path, &cfg); err != nil {
   402			return nil, "", err
   403		}
   404		for i := range cfg.Targets {
   405			cfg.Targets[i].Dependencies = uniqueStrings(cfg.Targets[i].Dependencies)
   406			if cfg.Targets[i].Timeout <= 0 {
   407				cfg.Targets[i].Timeout = 300
   408			}
   409		}
   410		return &cfg, filepath.Dir(abs), nil
   411	}
