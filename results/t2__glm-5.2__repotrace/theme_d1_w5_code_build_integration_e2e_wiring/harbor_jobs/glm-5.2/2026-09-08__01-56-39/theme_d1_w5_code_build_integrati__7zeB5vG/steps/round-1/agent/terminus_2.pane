   381	func runStatus(configPath string, vars []string) error {
   382		cfg, configDir, err := loadConfig(configPath, vars)
   383		if err != nil {
   384			return err
   385		}
   386		if _, err := validateConfig(cfg); err != nil {
   387			return err
   388		}
   389		cacheDir := filepath.Join(configDir, ".buildctl-cache")
   390		report := StatusReport{Targets: []StatusTarget{}}
   391		for i := range cfg.Targets {
   392			t := &cfg.Targets[i]
   393			key, err := computeCacheKey(t, configDir)
   394			if err != nil {
   395				return err
   396			}
   397			valid, entry, err := cacheValid(cacheDir, key, t.Outputs, configDir)
   398			if err != nil {
   399				return err
   400			}
   401			st := StatusTarget{Name: t.Name, Cached: valid}
   402			if valid {
   403				st.CacheKey = key
   404				st.CachedAt = entry.Timestamp
   405			}
   406			report.Targets = append(report.Targets, st)
   407		}
   408		data, err := json.MarshalIndent(report, "", "  ")
   409		if err != nil {
   410			return err
   411		}
   412		fmt.Println(string(data))
   413		return nil
   414	}
