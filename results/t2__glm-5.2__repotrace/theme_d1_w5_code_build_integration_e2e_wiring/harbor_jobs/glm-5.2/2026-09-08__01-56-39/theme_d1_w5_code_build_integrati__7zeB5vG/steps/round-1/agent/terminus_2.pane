func expandMatrixTargets(targets *[]TargetConfig) error {
	expanded := make([]TargetConfig, 0, len(*targets))
	for _, t := range *targets {
		if len(t.Matrix) == 0 && len(t.MatrixInclude) == 0 && len(t.MatrixExclude) == 0 {
			expanded = append(expanded, t)
			continue
		}
		combos, err := matrixCombinations(t.Matrix, t.MatrixInclude, t.MatrixExclude)
