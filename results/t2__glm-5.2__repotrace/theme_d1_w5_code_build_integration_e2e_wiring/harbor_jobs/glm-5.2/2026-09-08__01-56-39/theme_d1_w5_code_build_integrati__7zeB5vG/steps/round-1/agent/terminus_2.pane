   416	func loadConfig(path string, varOverrides []string) (*Config, string, error) {
   417		abs, err := filepath.Abs(path)
   418		if err != nil {
   419			return nil, "", err
   420		}
   421		overrides, err := parseVarOverrides(varOverrides)
   422		if err != nil {
   423			return nil, "", err
   424		}
   425		loader := &configLoader{
   426			variables:   make(map[string]string),
   427			targetNames: make(map[string]bool),
   428		}
   429		for k, v := range overrides {
   430			loader.variables[k] = v
   431		}
   432		if err := loader.loadFile(abs, true); err != nil {
   433			return nil, "", err
   434		}
   435		for i := range loader.targets {
   436			t := &loader.targets[i]
   437			expanded, err := expandString(t.Command, loader.variables, make(map[string]bool))
   438			if err != nil {
   439				return nil, "", err
   440			}
   441			t.Command = expanded
   442			for j, p := range t.Inputs {
   443				expanded, err := expandString(p, loader.variables, make(map[string]bool))
   444				if err != nil {
   445					return nil, "", err
   446				}
   447				t.Inputs[j] = expanded
   448			}
   449			for j, p := range t.Outputs {
   450				expanded, err := expandString(p, loader.variables, make(map[string]bool))
   451				if err != nil {
   452					return nil, "", err
   453				}
   454				t.Outputs[j] = expanded
   455			}
   456			t.Dependencies = uniqueStrings(t.Dependencies)
   457			if t.Timeout <= 0 {
   458				t.Timeout = 300
   459			}
   460		}
   461		cfg := &Config{
   462			Pipeline:  PipelineConfig{Name: loader.pipelineName, Imports: loader.rootImports},
   463			Targets:   loader.targets,
   464			Variables: loader.variables,
   465		}
   466		return cfg, filepath.Dir(abs), nil
   467	}
