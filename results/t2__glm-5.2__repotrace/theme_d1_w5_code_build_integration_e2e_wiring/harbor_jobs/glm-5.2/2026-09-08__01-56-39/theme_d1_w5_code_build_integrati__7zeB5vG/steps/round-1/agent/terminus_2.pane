   370				Name:       name,
   371				Status:     st,
   372				Cached:     st == "cached",
   373				DurationMS: durations[name],
   374				CacheKey:   cacheKeys[name],
   375			})
   376		}
   377	
   378		summary := BuildSummary{Total: len(report.Targets)}
   379		for _, t := range report.Targets {
   380			switch t.Status {
   381			case "built":
   382				summary.Built++
   383			case "cached":
   384				summary.Cached++
   385			case "failed":
   386				summary.Failed++
   387			case "skipped":
   388				summary.Skipped++
   389			case "cancelled":
   390				summary.Cancelled++
   391			}
   392		}
   393		summary.DurationMS = time.Since(buildStart).Milliseconds()
