   222	
   223	func runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string, vars []string) error {
   224		cfg, configDir, err := loadConfig(configPath, vars)
   225		if err != nil {
   226			return err
   227		}
   228		targetMap, err := validateConfig(cfg)
   229		if err != nil {
   230			return err
   231		}
   232		requested, err := selectTargets(cfg, targetMap, targetsFlag)
   233		if err != nil {
   234			return err
   235		}
   236		order := topologicalOrder(cfg, requested)
   237		reverseDeps := buildReverseDeps(cfg, requested)
   238	
   239		cacheKeys := make(map[string]string)
   240		for i := range cfg.Targets {
   241			t := &cfg.Targets[i]
   242			if !requested[t.Name] {
   243				continue
   244			}
   245			key, err := computeCacheKey(t, configDir)
   246			if err != nil {
   247				return err
   248			}
   249			cacheKeys[t.Name] = key
   250		}
   251	
   252		executor := &buildExecutor{
   253			config:    cfg,
   254			configDir: configDir,
   255			cacheDir:  filepath.Join(configDir, ".buildctl-cache"),
   256			noCache:   noCache,
   257		}
   258	
   259		status := make(map[string]string)
   260		durations := make(map[string]int64)
   261		completed := 0
   262		total := len(requested)
   263		readyCh := make(chan *TargetConfig, total+1)
   264		resultCh := make(chan execResult, total+1)
   265	
   266		var wg sync.WaitGroup
   267		for i := 0; i < parallel; i++ {
   268			wg.Add(1)
   269			go func() {
   270				defer wg.Done()
   271				for t := range readyCh {
   272					resultCh <- executor.execute(t)
   273				}
   274			}()
   275		}
   276	
   277		buildStart := time.Now()
   278		for i := range cfg.Targets {
   279			t := &cfg.Targets[i]
   280			if requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {
   281				readyCh <- t
   282			}
   283		}
   284	
   285		for completed < total {
   286			res := <-resultCh
   287			status[res.name] = res.status
   288			durations[res.name] = res.durationMS
   289			if res.cacheKey != "" {
   290				cacheKeys[res.name] = res.cacheKey
   291			}
   292			completed++
   293	
   294			if res.status == "built" || res.status == "cached" {
   295				for _, dependent := range reverseDeps[res.name] {
   296					if allDependenciesComplete(dependent, targetMap, requested, status) {
   297						readyCh <- targetMap[dependent]
   298					}
   299				}
   300			} else {
   301				markSkipped(reverseDeps, status, durations, &completed, res.name)
   302			}
   303		}
   304	
   305		close(readyCh)
   306		wg.Wait()
   307	
   308		report := BuildReport{Pipeline: cfg.Pipeline.Name, Targets: []BuildTargetReport{}}
   309		for _, name := range order {
   310			st := status[name]
   311			if st == "" {
   312				st = "skipped"
   313			}
   314			report.Targets = append(report.Targets, BuildTargetReport{
   315				Name:       name,
   316				Status:     st,
   317				Cached:     st == "cached",
   318				DurationMS: durations[name],
   319				CacheKey:   cacheKeys[name],
   320			})
   321		}
   322	
   323		summary := BuildSummary{Total: len(report.Targets)}
   324		for _, t := range report.Targets {
   325			switch t.Status {
   326			case "built":
   327				summary.Built++
   328			case "cached":
   329				summary.Cached++
   330			case "failed":
   331				summary.Failed++
   332			case "skipped":
   333				summary.Skipped++
   334			}
   335		}
   336		summary.DurationMS = time.Since(buildStart).Milliseconds()
   337		report.Summary = summary
   338	
   339		data, err := json.MarshalIndent(report, "", "  ")
   340		if err != nil {
   341			return err
   342		}
   343		fmt.Println(string(data))
   344		if reportPath != "" {
   345			if err := os.WriteFile(reportPath, data, 0644); err != nil {
   346				return err
   347			}
   348		}
   349		if summary.Failed > 0 {
   350			return fmt.Errorf("build failed")
   351		}
   352		return nil
   353	}
