   480				chain = append(chain, absPath)
   481				return fmt.Errorf("circular import detected: %s", strings.Join(chain, " -> "))
   482			}
   483		}
   484		l.importStack = append(l.importStack, absPath)
   485		defer func() { l.importStack = l.importStack[:len(l.importStack)-1] }()
   486	
   487		var fileCfg Config
   488		if _, err := toml.DecodeFile(absPath, &fileCfg); err != nil {
   489			return err
   490		}
   491	
   492		if isRoot {
   493			l.pipelineName = fileCfg.Pipeline.Name
   494		}
   495	
   496		for k, v := range fileCfg.Variables {
   497			if _, exists := l.variables[k]; !exists {
   498				l.variables[k] = v
   499			}
   500		}
   501	
   502		for _, imp := range fileCfg.Pipeline.Imports {
   503			expanded, err := expandString(imp, l.variables, make(map[string]bool))
   504			if err != nil {
   505				return err
   506			}
   507			importPath := expanded
   508			if !filepath.IsAbs(importPath) {
   509				importPath = filepath.Join(filepath.Dir(absPath), importPath)
   510			}
   511			importAbs, err := filepath.Abs(importPath)
   512			if err != nil {
   513				return err
   514			}
   515			if err := l.loadFile(importAbs, false); err != nil {
   516				return err
   517			}
   518		}
   519	
   520		for _, t := range fileCfg.Targets {
   521			if l.targetNames[t.Name] {
   522				return fmt.Errorf("duplicate target name %q", t.Name)
   523			}
   524			l.targetNames[t.Name] = true
   525			l.targets = append(l.targets, t)
   526		}
   527	
   528		return nil
   529	}
