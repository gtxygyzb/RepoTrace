   342	func buildRebuildLayers(targetMap map[string]*TargetConfig, affected map[string]bool, direct map[string]bool) [][]map[string]interface{} {
   343		layer := map[string]int{}
   344	
   345		var resolve func(name string) int
   346		resolve = func(name string) int {
   347			if l, ok := layer[name]; ok {
   348				return l
   349			}
   350			maxDepLayer := -1
   351			for _, dep := range uniqueStrings(targetMap[name].Dependencies) {
   352				if affected[dep] {
   353					depLayer := resolve(dep)
   354					if depLayer > maxDepLayer {
   355						maxDepLayer = depLayer
   356					}
   357				}
   358			}
   359			layer[name] = maxDepLayer + 1
   360			return layer[name]
   361		}
   362	
   363		for name := range affected {
   364			resolve(name)
   365		}
   366	
   367		maxLayer := 0
   368		for _, l := range layer {
   369			if l > maxLayer {
   370				maxLayer = l
   371			}
   372		}
   373	
   374		layers := make([][]map[string]interface{}, maxLayer+1)
   375		for l := 0; l <= maxLayer; l++ {
   376			names := []string{}
   377			for name, ll := range layer {
   378				if ll == l {
   379					names = append(names, name)
   380				}
   381			}
   382			sort.Strings(names)
   383			for _, name := range names {
   384				layers[l] = append(layers[l], map[string]interface{}{
   385					"target": name,
   386					"direct": direct[name],
   387				})
   388			}
   389		}
   390		return layers
   391	}
