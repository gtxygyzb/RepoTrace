	if *configPath == "" {
		fmt.Fprintln(os.Stderr, "error: --config is required")
		os.Exit(1)
	}
[?2004hroot@n30009:/app# sed -n '180,410p' main.go
[?2004l	}
	if err := runGraph(*configPath, []string(vars)); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

