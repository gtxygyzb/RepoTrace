   509	func topologicalOrder(cfg *Config, requested map[string]bool) []string {
   510		indeg := map[string]int{}
   511		for _, t := range cfg.Targets {
   512			if !requested[t.Name] {
   513				continue
   514			}
   515			count := 0
   516			for _, dep := range uniqueStrings(t.Dependencies) {
   517				if requested[dep] {
   518					count++
   519				}
   520			}
   521			indeg[t.Name] = count
   522		}
   523	
   524		queue := []string{}
   525		for _, t := range cfg.Targets {
   526			if requested[t.Name] && indeg[t.Name] == 0 {
   527				queue = append(queue, t.Name)
   528			}
   529		}
   530	
   531		order := []string{}
   532		for len(queue) > 0 {
   533			name := queue[0]
   534			queue = queue[1:]
   535			order = append(order, name)
   536			for _, t := range cfg.Targets {
   537				if !requested[t.Name] {
   538					continue
   539				}
   540				for _, dep := range uniqueStrings(t.Dependencies) {
   541					if dep == name {
   542						indeg[t.Name]--
   543						if indeg[t.Name] == 0 {
   544							queue = append(queue, t.Name)
   545						}
   546						break
   547					}
   548				}
   549			}
   550		}
   551		return order
   552	}
   553	
   554	func buildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {
   555		reverse := map[string][]string{}
   556		for _, t := range cfg.Targets {
   557			if !requested[t.Name] {
   558				continue
   559			}
   560			for _, dep := range uniqueStrings(t.Dependencies) {
   561				if requested[dep] {
   562					reverse[dep] = append(reverse[dep], t.Name)
   563				}
   564			}
   565		}
   566		return reverse
   567	}
