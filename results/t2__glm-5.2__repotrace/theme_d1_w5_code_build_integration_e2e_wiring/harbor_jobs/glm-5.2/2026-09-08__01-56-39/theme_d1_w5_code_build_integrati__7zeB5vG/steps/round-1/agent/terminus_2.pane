   652	func selectTargets(cfg *Config, targetMap map[string]*TargetConfig, targetsFlag string) (map[string]bool, error) {
   653		if strings.TrimSpace(targetsFlag) == "" {
   654			requested := map[string]bool{}
   655			for _, t := range cfg.Targets {
   656				requested[t.Name] = true
   657			}
   658			return requested, nil
   659		}
   660	
   661		requested := map[string]bool{}
   662		for _, part := range strings.Split(targetsFlag, ",") {
   663			name := strings.TrimSpace(part)
   664			if _, ok := targetMap[name]; !ok {
   665				return nil, fmt.Errorf("target %q not found", name)
   666			}
   667			var visit func(string)
   668			visit = func(n string) {
   669				if requested[n] {
   670					return
   671				}
   672				requested[n] = true
   673				for _, dep := range targetMap[n].Dependencies {
   674					visit(dep)
   675				}
   676			}
   677			visit(name)
   678		}
   679		return requested, nil
   680	}
