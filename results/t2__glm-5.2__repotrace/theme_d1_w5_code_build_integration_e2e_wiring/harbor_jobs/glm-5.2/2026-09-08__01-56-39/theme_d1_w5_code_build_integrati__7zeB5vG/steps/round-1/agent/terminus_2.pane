   554	func buildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {
   555		reverse := map[string][]string{}
   556		for _, t := range cfg.Targets {
   557			if !requested[t.Name] {
   558				continue
   559			}
   560			for _, dep := range uniqueStrings(t.Dependencies) {
   561				if requested[dep] {
   562					reverse[dep] = append(reverse[dep], t.Name)
   563				}
   564			}
   565		}
