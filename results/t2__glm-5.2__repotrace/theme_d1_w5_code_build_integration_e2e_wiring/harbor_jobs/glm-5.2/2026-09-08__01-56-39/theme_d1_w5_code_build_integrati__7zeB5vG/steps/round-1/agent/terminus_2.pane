[?2004l   617	func expandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {
   618		var b strings.Builder
   619		i := 0
   620		for i < len(s) {
   621			if i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {
   622				end := strings.Index(s[i:], "}")
   623				if end == -1 {
   624					return "", fmt.Errorf("unterminated variable reference in %q", s)
   625				}
   626				name := s[i+2 : i+end]
   627				if name == "" {
   628					return "", fmt.Errorf("empty variable reference in %q", s)
   629				}
   630				if visiting[name] {
   631					return "", fmt.Errorf("variable cycle detected: %q", name)
   632				}
   633				val, ok := vars[name]
   634				if !ok {
   635					return "", fmt.Errorf("unresolved variable %q", name)
   636				}
   637				visiting[name] = true
   638				expanded, err := expandString(val, vars, visiting)
   639				if err != nil {
   640					return "", err
   641				}
   642				delete(visiting, name)
   643				b.WriteString(expanded)
   644				i += end + 1
   645			} else {
   646				b.WriteByte(s[i])
   647				i++
   648			}
   649		}
   650		return b.String(), nil
   651	}
