    75		}
    76	}
    77	
    78	func runDeps(configPath string, vars []string, args []string, why, affected, plan bool) error {
    79		cfg, _, err := loadConfig(configPath, vars)
    80		if err != nil {
    81			return err
    82		}
    83		targetMap, err := validateConfig(cfg)
    84		if err != nil {
    85			return err
    86		}
    87	
    88		if affected {
    89			if len(args) == 0 {
    90				return fmt.Errorf("--affected requires at least one FILE")
    91			}
    92			return runDepsAffected(cfg, targetMap, args, plan)
    93		}
    94	
    95		if why {
    96			if len(args) != 2 {
    97				return fmt.Errorf("--why requires exactly two target names: FROM TO")
    98			}
    99			return runDepsWhy(cfg, targetMap, args[0], args[1])
   100		}
   101	
   102		if len(args) != 1 {
   103			return fmt.Errorf("deps requires exactly one target name")
   104		}
   105		return runDepsTarget(cfg, targetMap, args[0])
   106	}
   107	
   108	func runDepsTarget(cfg *Config, targetMap map[string]*TargetConfig, target string) error {
   109		if _, ok := targetMap[target]; !ok {
   110			failDepsJSON(fmt.Sprintf("target %q does not exist", target))
   111			return nil
   112		}
   113	
   114		directSet := map[string]bool{}
   115		for _, dep := range uniqueStrings(targetMap[target].Dependencies) {
   116			directSet[dep] = true
   117		}
   118		direct := sortedKeys(directSet)
   119	
   120		transitiveSet := map[string]bool{}
   121		collectTransitiveDeps(targetMap, target, transitiveSet)
   122		delete(transitiveSet, target)
   123		transitive := sortedKeys(transitiveSet)
   124	
   125		reverseSet := map[string]bool{}
   126		for _, t := range cfg.Targets {
   127			if t.Name == target {
   128				continue
   129			}
   130			seen := map[string]bool{}
   131			if dependsOnTransitive(targetMap, t.Name, target, seen) {
   132				reverseSet[t.Name] = true
   133			}
   134		}
   135		reverse := sortedKeys(reverseSet)
   136	
   137		return emitJSON(map[string]interface{}{
   138			"target":          target,
   139			"direct_deps":     direct,
   140			"transitive_deps": transitive,
   141			"reverse_deps":    reverse,
   142		})
   143	}
   144	
   145	func runDepsWhy(cfg *Config, targetMap map[string]*TargetConfig, from, to string) error {
   146		if _, ok := targetMap[from]; !ok {
   147			failDepsJSON(fmt.Sprintf("target %q does not exist", from))
   148			return nil
   149		}
   150		if _, ok := targetMap[to]; !ok {
   151			failDepsJSON(fmt.Sprintf("target %q does not exist", to))
   152			return nil
   153		}
   154	
   155		paths := allDependencyPaths(targetMap, from, to)
   156		sortPaths(paths)
   157		return emitJSON(map[string]interface{}{
   158			"from":  from,
   159			"to":    to,
   160			"paths": paths,
   161		})
   162	}
   163	
   164	func runDepsAffected(cfg *Config, targetMap map[string]*TargetConfig, files []string, plan bool) error {
   165		fileSet := map[string]bool{}
   166		for _, f := range files {
   167			fileSet[f] = true
   168		}
   169	
   170		affectedSet := map[string]bool{}
   171		directAffected := map[string]bool{}
   172		for i := range cfg.Targets {
   173			t := &cfg.Targets[i]
   174			for _, input := range t.Inputs {
   175				if fileSet[input] {
   176					affectedSet[t.Name] = true
   177					directAffected[t.Name] = true
   178					break
   179				}
   180			}
   181		}
   182	
   183		queue := sortedKeys(affectedSet)
   184		for len(queue) > 0 {
   185			name := queue[0]
   186			queue = queue[1:]
   187			for _, t := range cfg.Targets {
   188				if affectedSet[t.Name] {
   189					continue
   190				}
   191				for _, dep := range uniqueStrings(t.Dependencies) {
   192					if dep == name {
   193						affectedSet[t.Name] = true
   194						queue = append(queue, t.Name)
   195						break
   196					}
   197				}
   198			}
   199		}
   200	
   201		if len(affectedSet) == 0 {
   202			if plan {
   203				return emitJSON(map[string]interface{}{"rebuild_plan": []interface{}{}})
   204			}
   205			return emitJSON(map[string]interface{}{"rebuild_order": []interface{}{}})
   206		}
   207	
   208		if plan {
   209			layers := buildRebuildLayers(targetMap, affectedSet, directAffected)
   210			return emitJSON(map[string]interface{}{"rebuild_plan": layers})
   211		}
   212	
   213		order := topologicalOrderSubset(cfg, affectedSet)
   214		entries := []map[string]interface{}{}
   215		for _, name := range order {
   216			entries = append(entries, map[string]interface{}{
   217				"target": name,
   218				"direct": directAffected[name],
   219			})
   220		}
   221		return emitJSON(map[string]interface{}{"rebuild_order": entries})
   222	}
   223	
   224	func collectTransitiveDeps(targetMap map[string]*TargetConfig, name string, seen map[string]bool) {
   225		for _, dep := range uniqueStrings(targetMap[name].Dependencies) {
   226			if !seen[dep] {
   227				seen[dep] = true
   228				collectTransitiveDeps(targetMap, dep, seen)
   229			}
   230		}
   231	}
   232	
   233	func dependsOnTransitive(targetMap map[string]*TargetConfig, name, target string, seen map[string]bool) bool {
   234		if seen[name] {
   235			return false
   236		}
   237		seen[name] = true
   238		for _, dep := range uniqueStrings(targetMap[name].Dependencies) {
   239			if dep == target {
   240				return true
   241			}
   242			if dependsOnTransitive(targetMap, dep, target, seen) {
   243				return true
   244			}
   245		}
   246		return false
   247	}
