   279	func sortPaths(paths [][]string) {
   280		sort.Slice(paths, func(i, j int) bool {
   281			if len(paths[i]) != len(paths[j]) {
   282				return len(paths[i]) < len(paths[j])
   283			}
   284			for k := 0; k < len(paths[i]) && k < len(paths[j]); k++ {
   285				if paths[i][k] != paths[j][k] {
   286					return paths[i][k] < paths[j][k]
   287				}
   288			}
   289			return false
   290		})
   291	}
   292	
   293	func topologicalOrderSubset(cfg *Config, subset map[string]bool) []string {
   294		indeg := map[string]int{}
   295		for name := range subset {
   296			indeg[name] = 0
   297		}
   298		for _, t := range cfg.Targets {
   299			if !subset[t.Name] {
   300				continue
   301			}
   302			for _, dep := range uniqueStrings(t.Dependencies) {
   303				if subset[dep] {
   304					indeg[t.Name]++
   305				}
   306			}
   307		}
   308	
   309		queue := []string{}
   310		for name := range subset {
   311			if indeg[name] == 0 {
   312				queue = append(queue, name)
   313			}
   314		}
   315		sort.Strings(queue)
   316	
   317		order := []string{}
   318		for len(queue) > 0 {
   319			name := queue[0]
   320			queue = queue[1:]
   321			order = append(order, name)
   322	
   323			for _, t := range cfg.Targets {
   324				if !subset[t.Name] {
   325					continue
   326				}
   327				for _, dep := range uniqueStrings(t.Dependencies) {
   328					if dep == name {
   329						indeg[t.Name]--
   330						if indeg[t.Name] == 0 {
   331							queue = append(queue, t.Name)
   332						}
   333						break
   334					}
   335				}
   336			}
   337			sort.Strings(queue)
   338		}
   339		return order
   340	}
   341	
   342	func buildRebuildLayers(targetMap map[string]*TargetConfig, affected map[string]bool, direct map[string]bool) [][]map[string]interface{} {
   343		layer := map[string]int{}
   344	
   345		var resolve func(name string) int
   346		resolve = func(name string) int {
   347			if l, ok := layer[name]; ok {
   348				return l
   349			}
   350			maxDepLayer := -1
   351			for _, dep := range uniqueStrings(targetMap[name].Dependencies) {
   352				if affected[dep] {
   353					depLayer := resolve(dep)
   354					if depLayer > maxDepLayer {
   355						maxDepLayer = depLayer
   356					}
   357				}
   358			}
   359			layer[name] = maxDepLayer + 1
   360			return layer[name]
   361		}
   362	
   363		for name := range affected {
   364			resolve(name)
   365		}
   366	
   367		maxLayer := 0
   368		for _, l := range layer {
   369			if l > maxLayer {
   370				maxLayer = l
   371			}
   372		}
   373	
   374		layers := make([][]map[string]interface{}, maxLayer+1)
   375		for l := 0; l <= maxLayer; l++ {
   376			names := []string{}
   377			for name, ll := range layer {
   378				if ll == l {
   379					names = append(names, name)
   380				}
   381			}
   382			sort.Strings(names)
   383			for _, name := range names {
   384				layers[l] = append(layers[l], map[string]interface{}{
   385					"target": name,
   386					"direct": direct[name],
   387				})
   388			}
   389		}
   390		return layers
   391	}
   392	
   393	func sortedKeys(m map[string]bool) []string {
   394		keys := []string{}
   395		for k := range m {
   396			keys = append(keys, k)
   397		}
   398		sort.Strings(keys)
   399		return keys
   400	}
   401	
   402	func emitJSON(v interface{}) error {
   403		return json.NewEncoder(os.Stdout).Encode(v)
   404	}
   405	
   406	func failDepsJSON(msg string) {
   407		json.NewEncoder(os.Stdout).Encode(map[string]string{"error": msg})
   408		os.Exit(1)
   409	}
