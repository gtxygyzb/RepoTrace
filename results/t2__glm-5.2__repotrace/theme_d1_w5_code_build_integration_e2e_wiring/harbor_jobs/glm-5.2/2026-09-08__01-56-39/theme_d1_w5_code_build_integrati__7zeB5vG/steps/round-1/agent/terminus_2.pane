   770	func (e *buildExecutor) execute(t *TargetConfig) execResult {
   771		start := time.Now()
   772		key, err := computeCacheKey(t, e.configDir)
   773		if err != nil {
   774			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   775		}
   776	
   777		if !e.noCache {
   778			valid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)
   779			if err != nil {
   780				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   781			}
   782			if valid {
   783				return execResult{name: t.Name, status: "cached", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   784			}
   785		}
   786	
   787		timeout := t.Timeout
   788		if timeout <= 0 {
   789			timeout = 300
   790		}
   791		deadline := time.Now().Add(time.Duration(timeout) * time.Second)
   792	
   793		baseEnv := mergedEnv(t.Env)
   794		preEnv := append([]string(nil), baseEnv...)
   795	
   796		for _, hook := range t.PreBuild {
   797			if err := e.runHook(t, hook, preEnv, deadline); err != nil {
   798				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   799			}
   800			preEnv = mergeHookExports(preEnv, hookExportsFromOutput(t, hook))
   801		}
   802	
   803		mainEnv := preEnv
   804		if err := e.runHook(t, t.Command, mainEnv, deadline); err != nil {
   805			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   806		}
   807	
   808		postEnv := append([]string(nil), baseEnv...)
   809		for _, hook := range t.PostBuild {
   810			if err := e.runHook(t, hook, postEnv, deadline); err != nil {
   811				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   812			}
   813			postEnv = mergeHookExports(postEnv, hookExportsFromOutput(t, hook))
   814		}
   815	
   816		elapsed := time.Since(start).Milliseconds()
   817		entry := CacheEntry{
   818			CacheKey:   key,
   819			TargetName: t.Name,
   820			Timestamp:  time.Now().UTC().Format(time.RFC3339),
   821			Outputs:    t.Outputs,
   822		}
   823		if err := writeCacheEntry(e.cacheDir, entry); err != nil {
   824			fmt.Fprintln(os.Stderr, err)
   825			return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
   826		}
   827		return execResult{name: t.Name, status: "built", durationMS: elapsed, cacheKey: key}
   828	}
   829	
   830	func (e *buildExecutor) runHook(t *TargetConfig, command string, env []string, deadline time.Time) error {
   831		if strings.TrimSpace(command) == "" {
   832			return nil
   833		}
   834		remaining := time.Until(deadline)
   835		if remaining <= 0 {
   836			return fmt.Errorf("target %q timed out after %ds", t.Name, t.Timeout)
   837		}
   838	
   839		var stdout, stderr bytes.Buffer
   840		ctx, cancel := context.WithTimeout(context.Background(), remaining)
   841		defer cancel()
   842		cmd := exec.CommandContext(ctx, "sh", "-c", command)
   843		cmd.Dir = e.configDir
   844		cmd.Env = env
   845		cmd.Stdout = &stdout
   846		cmd.Stderr = &stderr
   847		cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
   848	
   849		if err := cmd.Start(); err != nil {
   850			return err
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '850,945p'
[?2004l   850			return err
   851		}
   852		waitCh := make(chan error, 1)
   853		go func() {
   854			waitCh <- cmd.Wait()
   855		}()
   856	
   857		select {
   858		case <-time.After(time.Until(deadline)):
   859			if cmd.Process != nil {
   860				_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
   861			}
   862			<-waitCh
   863			return fmt.Errorf("target %q timed out after %ds", t.Name, t.Timeout)
   864		case err := <-waitCh:
   865			if err != nil {
   866				if stderr.Len() > 0 {
   867					fmt.Fprintf(os.Stderr, "target %q stderr:\n%s", t.Name, stderr.String())
   868				}
   869				return err
   870			}
   871		}
   872		return nil
   873	}
   874	
   875	func computeCacheKey(t *TargetConfig, configDir string) (string, error) {
   876		h := sha256.New()
   877		if _, err := io.WriteString(h, t.Command); err != nil {
   878			return "", err
   879		}
   880	
   881		for _, hook := range t.PreBuild {
   882			if _, err := io.WriteString(h, hook); err != nil {
   883				return "", err
   884			}
   885		}
   886		for _, hook := range t.PostBuild {
   887			if _, err := io.WriteString(h, hook); err != nil {
   888				return "", err
   889			}
   890		}
   891	
   892		deps := make([]string, len(t.Dependencies))
   893		copy(deps, t.Dependencies)
   894		sort.Strings(deps)
   895		for _, d := range deps {
   896			if _, err := io.WriteString(h, "dep:"+d); err != nil {
   897				return "", err
   898			}
   899		}
   900	
   901		outputs := make([]string, len(t.Outputs))
   902		copy(outputs, t.Outputs)
   903		sort.Strings(outputs)
   904		for _, p := range outputs {
   905			if _, err := io.WriteString(h, "out:"+p); err != nil {
   906				return "", err
   907			}
   908		}
   909	
   910		envKeys := make([]string, 0, len(t.Env))
   911		for k := range t.Env {
   912			envKeys = append(envKeys, k)
   913		}
