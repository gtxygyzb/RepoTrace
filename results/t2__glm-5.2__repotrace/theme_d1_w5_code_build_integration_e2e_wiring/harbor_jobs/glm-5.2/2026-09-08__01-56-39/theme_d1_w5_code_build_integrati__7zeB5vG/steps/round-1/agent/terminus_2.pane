   772	func (e *buildExecutor) execute(t *TargetConfig) execResult {
   773		start := time.Now()
   774		key, err := computeCacheKey(t, e.configDir)
   775		if err != nil {
   776			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   777		}
   778	
   779		if !e.noCache {
   780			valid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)
   781			if err != nil {
   782				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   783			}
   784			if valid {
   785				return execResult{name: t.Name, status: "cached", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   786			}
   787		}
   788	
   789		timeout := t.Timeout
   790		if timeout <= 0 {
   791			timeout = 300
   792		}
   793		deadline := time.Now().Add(time.Duration(timeout) * time.Second)
   794	
   795		baseEnv := mergedEnv(t.Env)
   796		preEnv := append([]string(nil), baseEnv...)
   797	
   798		for _, hook := range t.PreBuild {
   799			stdout, err := e.runCommand(t, hook, preEnv, deadline)
   800			if err != nil {
   801				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   802			}
   803			preEnv = mergeHookExports(preEnv, parseHookExports(stdout))
   804		}
   805	
   806		mainEnv := preEnv
   807		if _, err := e.runCommand(t, t.Command, mainEnv, deadline); err != nil {
   808			return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   809		}
   810	
   811		postEnv := append([]string(nil), baseEnv...)
   812		for _, hook := range t.PostBuild {
   813			stdout, err := e.runCommand(t, hook, postEnv, deadline)
   814			if err != nil {
   815				return execResult{name: t.Name, status: "failed", durationMS: time.Since(start).Milliseconds(), cacheKey: key}
   816			}
   817			postEnv = mergeHookExports(postEnv, parseHookExports(stdout))
   818		}
   819	
   820		elapsed := time.Since(start).Milliseconds()
   821		entry := CacheEntry{
   822			CacheKey:   key,
   823			TargetName: t.Name,
   824			Timestamp:  time.Now().UTC().Format(time.RFC3339),
   825			Outputs:    t.Outputs,
   826		}
   827		if err := writeCacheEntry(e.cacheDir, entry); err != nil {
   828			fmt.Fprintln(os.Stderr, err)
   829			return execResult{name: t.Name, status: "failed", durationMS: elapsed, cacheKey: key}
   830		}
   831		return execResult{name: t.Name, status: "built", durationMS: elapsed, cacheKey: key}
   832	}
   833	
   834	func (e *buildExecutor) runCommand(t *TargetConfig, command string, env []string, deadline time.Time) (string, error) {
   835		if strings.TrimSpace(command) == "" {
   836			return "", nil
   837		}
   838		remaining := time.Until(deadline)
   839		if remaining <= 0 {
   840			return "", fmt.Errorf("target %q timed out after %ds", t.Name, t.Timeout)
