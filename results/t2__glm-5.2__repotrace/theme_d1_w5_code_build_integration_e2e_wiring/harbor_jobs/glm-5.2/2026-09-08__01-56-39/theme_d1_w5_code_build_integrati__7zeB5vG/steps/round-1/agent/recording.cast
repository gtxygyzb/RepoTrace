[8080.008657, "o", "\u001b[?2004h> "]
[8080.009202, "o", "s = re.sub(r'(cacheKey\\s+string\\n)(\\s+)\\}', r'\\1\\tattempts  int\\n\\2}', s)\r\n\u001b[?2004l\r"]
[8080.009277, "o", "\u001b[?2004h> "]
[8080.009322, "o", "\r\n\u001b[?2004l\r"]
[8080.009338, "o", "\u001b[?2004h"]
[8080.009404, "o", "> "]
[8080.009609, "o", "# Add halt channel to buildExecutor.\r\n\u001b[?2004l\r"]
[8080.009669, "o", "\u001b[?2004h> "]
[8080.01019, "o", "s = re.sub(r'(noCache\\s+bool\\n)(\\s+)\\}', r'\\1\\thaltCh chan struct{}\\n\\2}', s)\r\n\u001b[?2004l\r"]
[8080.010265, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.010321, "o", "\u001b[?2004h> "]
[8080.010662, "o", "# Inherit retry explicitly in matrix expansion.\r\n\u001b[?2004l\r"]
[8080.01076, "o", "\u001b[?2004h> "]
[8080.011583, "o", "s = re.sub(r'(copy\\.PostBuild = substituteMatrixSlice\\(t\\.PostBuild, combo\\)\\n)', r'\\1\\t\\tcopy.Retry = t.Retry\\n', s)\r\n\u001b[?2004l\r"]
[8080.01162, "o", "\u001b[?2004h"]
[8080.01165, "o", "> \r\n\u001b[?2004l\r"]
[8080.011676, "o", "\u001b[?2004h"]
[8080.011702, "o", "> "]
[8080.012008, "o", "# Validate negative retry in validateConfig.\r\n\u001b[?2004l\r"]
[8080.01204, "o", "\u001b[?2004h"]
[8080.012064, "o", "> "]
[8080.013203, "o", "s = re.sub(r'(targetMap\\[t.Name\\] = t\\n)', r'\\1\\t\\tif t.Retry < 0 {\\n\\t\\t\\treturn nil, fmt.Errorf(\"target %q has invalid retry count %d\", t.Name, t.Retry)\\n\\t\\t}\\n', s)\r\n\u001b[?2004l\r"]
[8080.013241, "o", "\u001b[?2004h"]
[8080.013269, "o", "> \r\n\u001b[?2004l\r"]
[8080.013317, "o", "\u001b[?2004h"]
[8080.013343, "o", "> "]
[8080.013546, "o", "# Track attempts in runBuild.\r\n\u001b[?2004l\r"]
[8080.013592, "o", "\u001b[?2004h"]
[8080.01362, "o", "> "]
[8080.014348, "o", "s = re.sub(r'(durations := make\\(map\\[string\\]int64\\)\\n)', r'\\1\\tattempts := make(map[string]int)\\n', s)\r\n\u001b[?2004l\r"]
[8080.014385, "o", "\u001b[?2004h> "]
[8080.01495, "o", "s = re.sub(r'(cancelled := false\\n)', r'\\1\\tvar cancelOnce sync.Once\\n', s)\r\n\u001b[?2004l\r"]
[8080.01503, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.015088, "o", "\u001b[?2004h> "]
[8080.015326, "o", "# Add haltCh to executor instance.\r\n\u001b[?2004l\r"]
[8080.015387, "o", "\u001b[?2004h> "]
[8080.016021, "o", "s = re.sub(r'(noCache:\\s+noCache,\\n)(\\s+)\\}', r'\\1\\t\\thaltCh:    make(chan struct{}),\\n\\2}', s)\r\n\u001b[?2004l\r"]
[8080.016085, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.01614, "o", "\u001b[?2004h> "]
[8080.016401, "o", "# Record attempts from execResult.\r\n\u001b[?2004l\r"]
[8080.016463, "o", "\u001b[?2004h> "]
[8080.017334, "o", "s = re.sub(r'(durations\\[res.name\\] = res.durationMS\\n)(\\s+if res.cacheKey)', r'\\1\\t\\tattempts[res.name] = res.attempts\\n\\2', s)\r\n\u001b[?2004l\r"]
[8080.017398, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.017455, "o", "\u001b[?2004h"]
[8080.017512, "o", "> "]
[8080.017827, "o", "# Add attempts:0 to not-started cancelled targets.\r\n\u001b[?2004l\r"]
[8080.017885, "o", "\u001b[?2004h> "]
[8080.018591, "o", "s = re.sub(r'(durations\\[t.Name\\] = 0\\n)(\\s+completed\\+\\+)', r'\\1\\t\\t\\t\\tattempts[t.Name] = 0\\n\\2', s)\r\n\u001b[?2004l\r"]
[8080.018654, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.018711, "o", "\u001b[?2004h> "]
[8080.019142, "o", "# Insert cancelled result handling and close haltCh on failure.\r\n\u001b[?2004l\r"]
[8080.019203, "o", "\u001b[?2004h> "]
[8080.019305, "o", "s = re.sub(\r\n"]
[8080.019361, "o", "\u001b[?2004l\r"]
[8080.019406, "o", "\u001b[?2004h> "]
[8080.020762, "o", "    r'if res.status == \"failed\" \\{\\n\\s+markSkipped\\(reverseDeps, status, durations, &completed, res.name\\)\\n\\s+if !keepGoing \\{\\n\\s+mu.Lock\\(\\)\\n\\s+cancelled = true\\n\\s+for i := range cfg.Targets \\{',\r\n\u001b[?2004l\r"]
[8080.020832, "o", "\u001b[?2004h> "]
[8080.021015, "o", "    '''if res.status == \"cancelled\" {\r\n\u001b[?2004l\r"]
[8080.021112, "o", "\u001b[?2004h> "]
[8080.021493, "o", "        markSkipped(reverseDeps, status, durations, &completed, res.name)\r\n\u001b[?2004l\r"]
[8080.021568, "o", "\u001b[?2004h> "]
[8080.021664, "o", "        if !keepGoing {\r\n\u001b[?2004l\r"]
[8080.021719, "o", "\u001b[?2004h> "]
[8080.02184, "o", "            mu.Lock()\r\n\u001b[?2004l\r"]
[8080.021897, "o", "\u001b[?2004h> "]
[8080.022028, "o", "            cancelled = true\r\n\u001b[?2004l\r"]
[8080.022084, "o", "\u001b[?2004h> "]
[8080.022417, "o", "            cancelOnce.Do(func() { close(executor.haltCh) })\r\n\u001b[?2004l\r"]
[8080.022475, "o", "\u001b[?2004h> "]
[8080.022675, "o", "            for i := range cfg.Targets {\r\n\u001b[?2004l\r"]
[8080.022736, "o", "\u001b[?2004h> "]
[8080.022942, "o", "                t := &cfg.Targets[i]\r\n\u001b[?2004l\r"]
[8080.022997, "o", "\u001b[?2004h> "]
[8080.023193, "o", "                if !requested[t.Name] {\r\n\u001b[?2004l\r"]
[8080.023267, "o", "\u001b[?2004h> "]
[8080.023412, "o", "                    continue\r\n\u001b[?2004l\r"]
[8080.023467, "o", "\u001b[?2004h> "]
[8080.023547, "o", "                }\r\n\u001b[?2004l\r"]
[8080.023602, "o", "\u001b[?2004h> "]
[8080.023914, "o", "                if status[t.Name] == \"\" && !started[t.Name] {\r\n\u001b[?2004l\r"]
[8080.023969, "o", "\u001b[?2004h> "]
[8080.024211, "o", "                    status[t.Name] = \"cancelled\"\r\n\u001b[?2004l\r"]
[8080.024279, "o", "\u001b[?2004h> "]
[8080.024491, "o", "                    durations[t.Name] = 0\r\n\u001b[?2004l\r"]
[8080.024546, "o", "\u001b[?2004h> "]
[8080.024705, "o", "                    attempts[t.Name] = 0\r\n\u001b[?2004l\r"]
[8080.02476, "o", "\u001b[?2004h> "]
[8080.024878, "o", "                    completed++\r\n\u001b[?2004l\r"]
[8080.024931, "o", "\u001b[?2004h> "]
[8080.024994, "o", "                }\r\n\u001b[?2004l\r"]
[8080.02505, "o", "\u001b[?2004h> "]
[8080.025105, "o", "            }\r\n\u001b[?2004l\r"]
[8080.025171, "o", "\u001b[?2004h> "]
[8080.02525, "o", "            mu.Unlock()\r\n\u001b[?2004l\r"]
[8080.025317, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[8080.025383, "o", "\u001b[?2004h> "]
[8080.025443, "o", "        continue\r\n\u001b[?2004l\r"]
[8080.025498, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[8080.025562, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.025617, "o", "\u001b[?2004h> "]
[8080.02573, "o", "    if res.status == \"failed\" {\r\n\u001b[?2004l\r"]
[8080.025784, "o", "\u001b[?2004h> "]
[8080.026074, "o", "        markSkipped(reverseDeps, status, durations, &completed, res.name)\r\n\u001b[?2004l\r"]
[8080.026128, "o", "\u001b[?2004h> "]
[8080.026214, "o", "        if !keepGoing {\r\n\u001b[?2004l\r"]
[8080.026274, "o", "\u001b[?2004h> "]
[8080.02635, "o", "            mu.Lock()\r\n\u001b[?2004l\r"]
[8080.026405, "o", "\u001b[?2004h> "]
[8080.026514, "o", "            cancelled = true\r\n\u001b[?2004l\r"]
[8080.026568, "o", "\u001b[?2004h> "]
[8080.026802, "o", "            cancelOnce.Do(func() { close(executor.haltCh) })\r\n\u001b[?2004l\r"]
[8080.026857, "o", "\u001b[?2004h> "]
[8080.027032, "o", "            for i := range cfg.Targets {''',\r\n\u001b[?2004l\r"]
[8080.027086, "o", "\u001b[?2004h>     s,\r\n\u001b[?2004l\r"]
[8080.027155, "o", "\u001b[?2004h> "]
[8080.02722, "o", "    count=1\r\n\u001b[?2004l\r\u001b[?2004h"]
[8080.027292, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.027346, "o", "\u001b[?2004h> "]
[8080.027509, "o", "# Add Attempts to build report entries.\r\n\u001b[?2004l\r"]
[8080.027568, "o", "\u001b[?2004h> "]
[8080.027989, "o", "s = re.sub(r'(CacheKey:\\s+cacheKeys\\[name\\],\\n)(\\s+)\\)', r'\\1\\t\\t\\tAttempts:   attempts[name],\\n\\2)', s)\r\n\u001b[?2004l\r"]
[8080.028045, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[8080.028102, "o", "> "]
[8080.028345, "o", "# Replace execute with retry-aware implementation plus helpers.\r\n\u001b[?2004l\r"]
[8080.028419, "o", "\u001b[?2004h> "]
[8080.028538, "o", "lines = s.splitlines(keepends=True)\r\n\u001b[?2004l\r"]
[8080.028596, "o", "\u001b[?2004h> "]
[8080.029111, "o", "start = next(i for i, line in enumerate(lines) if line.startswith('func (e *buildExecutor) execute(t *TargetConfig) execResult {'))\r\n\u001b[?2004l\r"]
[8080.029183, "o", "\u001b[?2004h> "]
[8080.029654, "o", "end = next(i for i, line in enumerate(lines[start:], start) if line.startswith('func (e *buildExecutor) runCommand('))\r\n\u001b[?2004l\r"]
[8080.029712, "o", "\u001b[?2004h> "]
[8080.029912, "o", "new_code = '''func (e *buildExecutor) halted() bool {\r\n\u001b[?2004l\r"]
[8080.029946, "o", "\u001b[?2004h> "]
[8080.030044, "o", "\\tif e.haltCh == nil {\r\n\u001b[?2004l\r"]
[8080.030075, "o", "\u001b[?2004h> "]
[8080.030156, "o", "\\t\\treturn false\r\n\u001b[?2004l\r"]
[8080.030186, "o", "\u001b[?2004h> "]
[8080.030214, "o", "\\t}\r\n\u001b[?2004l\r"]
[8080.030248, "o", "\u001b[?2004h"]
[8080.030275, "o", "> "]
[8080.030303, "o", "\\tselect {\r\n"]
[8080.030319, "o", "\u001b[?2004l\r"]
[8080.030349, "o", "\u001b[?2004h> "]
[8080.030442, "o", "\\tcase <-e.haltCh:\r\n\u001b[?2004l\r"]
[8080.030472, "o", "\u001b[?2004h> "]
[8080.030554, "o", "\\t\\treturn true\r\n\u001b[?2004l\r"]
[8080.030582, "o", "\u001b[?2004h> "]
[8080.03064, "o", "\\tdefault:\r\n\u001b[?2004l\r"]
[8080.030668, "o", "\u001b[?2004h> "]
[8080.030753, "o", "\\t\\treturn false\r\n\u001b[?2004l\r"]
[8080.030782, "o", "\u001b[?2004h> "]
[8080.030809, "o", "\\t}\r\n\u001b[?2004l\r"]
[8080.030838, "o", "\u001b[?2004h"]
[8080.030867, "o", "> }\r\n\u001b[?2004l\r"]
[8080.030988, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[8080.031291, "o", "func (e *buildExecutor) runTargetAttempt(t *TargetConfig, deadline time.Time) error {\r\n\u001b[?2004l\r"]
[8080.031364, "o", "\u001b[?2004h> "]
[8080.031422, "o", "\\tbaseEnv := mergedEnv(t.Env)\r\n\u001b[?2004l\r"]
[8080.03148, "o", "\u001b[?2004h> "]
[8080.031543, "o", "\\tpreEnv := append([]string(nil), baseEnv...)\r\n\u001b[?2004l\r"]
[8080.031597, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.031651, "o", "\u001b[?2004h> "]
[8080.031698, "o", "\\tfor _, hook := range t.PreBuild {\r\n\u001b[?2004l\r"]
[8080.031748, "o", "\u001b[?2004h> "]
[8080.03189, "o", "\\t\\tstdout, err := e.runCommand(t, hook, preEnv, deadline)\r\n\u001b[?2004l\r"]
[8080.031946, "o", "\u001b[?2004h> "]
[8080.032, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[8080.032054, "o", "\u001b[?2004h> "]
[8080.032109, "o", "\\t\\t\\treturn err\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[8080.032163, "o", "\u001b[?2004h> "]
[8080.032284, "o", "\\t\\tpreEnv = mergeHookExports(preEnv, parseHookExports(stdout))\r\n\u001b[?2004l\r"]
[8080.032343, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.032396, "o", "\u001b[?2004h> "]
[8080.032454, "o", "\\tmainEnv := preEnv\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8080.032659, "o", "\\tif _, err := e.runCommand(t, t.Command, mainEnv, deadline); err != nil {\r\n\u001b[?2004l\r"]
[8080.032717, "o", "\u001b[?2004h> \\t\\treturn err\r\n\u001b[?2004l\r"]
[8080.032772, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[8080.032825, "o", "> \r\n\u001b[?2004l\r"]
[8080.032871, "o", "\u001b[?2004h> "]
[8080.032947, "o", "\\tpostEnv := append([]string(nil), baseEnv...)\r\n\u001b[?2004l\r"]
[8080.032999, "o", "\u001b[?2004h> "]
[8080.033073, "o", "\\tfor _, hook := range t.PostBuild {\r\n\u001b[?2004l\r"]
[8080.033124, "o", "\u001b[?2004h> "]
[8080.033265, "o", "\\t\\tstdout, err := e.runCommand(t, hook, postEnv, deadline)\r\n\u001b[?2004l\r"]
[8080.033322, "o", "\u001b[?2004h> "]
[8080.033377, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[8080.033431, "o", "\u001b[?2004h> "]
[8080.033486, "o", "\\t\\t\\treturn err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8080.033529, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8080.033671, "o", "\\t\\tpostEnv = mergeHookExports(postEnv, parseHookExports(stdout))\r\n\u001b[?2004l\r"]
[8080.03373, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.033784, "o", "\u001b[?2004h> "]
[8080.033803, "o", "\\treturn nil\r\n\u001b[?2004l\r"]
[8080.033872, "o", "\u001b[?2004h> "]
[8080.033924, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[8080.033976, "o", "> "]
[8080.034064, "o", "func (e *buildExecutor) execute(t *TargetConfig) execResult {\r\n\u001b[?2004l\r"]
[8080.034118, "o", "\u001b[?2004h> "]
[8080.034173, "o", "\\tstart := time.Now()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8080.03431, "o", "\\tkey, err := computeCacheKey(t, e.configDir)\r\n\u001b[?2004l\r"]
[8080.03437, "o", "\u001b[?2004h> "]
[8080.034421, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[8080.034475, "o", "\u001b[?2004h> "]
[8080.034754, "o", "\\t\\treturn execResult{name: t.Name, status: \"failed\", attempts: 0, durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[?2004l\r\u001b[?2004h"]
[8080.034817, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.034871, "o", "\u001b[?2004h> "]
[8080.034925, "o", "\\tif !e.noCache {\r\n\u001b[?2004l\r"]
[8080.03498, "o", "\u001b[?2004h> "]
[8080.035116, "o", "\\t\\tvalid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)\r\n\u001b[?2004l\r"]
[8080.035174, "o", "\u001b[?2004h> "]
[8080.035233, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[8080.03529, "o", "\u001b[?2004h> "]
[8080.035583, "o", "\\t\\t\\treturn execResult{name: t.Name, status: \"failed\", attempts: 0, durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8080.03565, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8080.035709, "o", "\\t\\tif valid {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8080.036083, "o", "\\t\\t\\treturn execResult{name: t.Name, status: \"cached\", cached: true, attempts: 1, durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[?2004l\r"]
[8080.036139, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[8080.036192, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.036262, "o", "\u001b[?2004h> "]
[8080.036318, "o", "\\ttimeout := t.Timeout\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8080.036383, "o", "\\tif timeout <= 0 {\r\n\u001b[?2004l\r"]
[8080.036441, "o", "\u001b[?2004h> "]
[8080.036495, "o", "\\t\\ttimeout = 300\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[8080.036555, "o", "\u001b[?2004h> "]
[8080.036706, "o", "\\tdeadline := time.Now().Add(time.Duration(timeout) * time.Second)\r\n\u001b[?2004l\r"]
[8080.036761, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[8080.036844, "o", "\\tmaxAttempts := t.Retry\r\n\u001b[?2004l\r\u001b[?2004h"]
[8080.036916, "o", "> "]
