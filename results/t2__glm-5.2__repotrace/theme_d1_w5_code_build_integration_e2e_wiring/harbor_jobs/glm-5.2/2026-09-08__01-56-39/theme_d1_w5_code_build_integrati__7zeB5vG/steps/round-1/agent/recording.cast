[1091.945802, "o", "os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1091.945902, "o", "> \u0007}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1091.945999, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1091.946081, "o", "> "]
