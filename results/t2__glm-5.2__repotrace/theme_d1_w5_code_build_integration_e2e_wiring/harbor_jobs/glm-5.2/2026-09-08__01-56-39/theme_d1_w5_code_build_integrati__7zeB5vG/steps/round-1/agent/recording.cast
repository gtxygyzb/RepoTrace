[1970.045763, "o", "   120\tfunc runBuildCommand(args []string) {\r\n   121\t\tfs := flag.NewFlagSet(\"build\", flag.ContinueOnError)\r\n   122\t\tfs.SetOutput(os.Stderr)\r\n   123\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   124\t\ttargetsFlag := fs.String(\"targets\", \"\", \"comma-separated target names\")\r\n   125\t\tparallel := fs.Int(\"parallel\", runtime.NumCPU(), \"max concurrent target executions\")\r\n"]
[1970.045882, "o", "   126\t\tnoCache := fs.Bool(\"no-cache\", false, \"skip all cache lookups\")\r\n   127\t\treportPath := fs.String(\"report\", \"\", \"also write JSON report to this file\")\r\n   128\t\tif err := fs.Parse(args); err != nil {\r\n   129\t\t\tos.Exit(1)\r\n   130\t\t}\r\n   131\t\tif *configPath == \"\" {\r\n   132\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n   133\t\t\tos.Exit(1)\r\n   134\t\t}\r\n   135\t\tif *parallel < 1 {\r\n   136\t\t\tfmt.Fprintln(os.Stderr, \"error: --parallel must be at least 1\")\r\n   137\t\t\tos.Exit(1)\r\n   138\t\t}\r\n   139\t\tif err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath); err != nil {\r\n   140\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   141\t\t"]
[1970.045958, "o", "\tos.Exit(1)\r\n   142\t\t}\r\n   143\t}\r\n   144\t\r\n   145\tfunc runGraphCommand(args []string) {\r\n   146\t\tfs := flag.NewFlagSet(\"graph\", flag.ContinueOnError)\r\n   147\t\tfs.SetOutput(os.Stderr)\r\n   148\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   149\t\tif err := fs.Parse(args); err != nil {\r\n   150\t\t\tos.Exit(1)\r\n   151\t\t}\r\n"]
[1970.046023, "o", "   152\t\tif *configPath == \"\" {\r\n   153\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n   154\t\t\tos.Exit(1)\r\n   155\t\t}\r\n   156\t\tif err := runGraph(*configPath); err != nil {\r\n   157\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   158\t\t\tos.Exit(1)\r\n   159\t\t}\r\n   160\t}\r\n"]
[1970.046088, "o", "   161\t\r\n   162\tfunc runCleanCommand(args []string) {\r\n   163\t\tfs := flag.NewFlagSet(\"clean\", flag.ContinueOnError)\r\n   164\t\tfs.SetOutput(os.Stderr)\r\n   165\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   166\t\tif err := fs.Parse(args); err != nil {\r\n   167\t\t\tos.Exit(1)\r\n   168\t\t}\r\n   169\t\tif *configPath == \"\" {\r\n   170\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n"]
