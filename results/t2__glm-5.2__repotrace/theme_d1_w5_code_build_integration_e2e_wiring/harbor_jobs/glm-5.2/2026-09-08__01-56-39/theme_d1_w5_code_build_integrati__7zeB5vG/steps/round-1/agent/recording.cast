[7157.868173, "o", "\t\treturn execResult{name: t.Name, status: \"built\", durationMS: elapsed, cacheKey: key}\r\n   996\t}\r\n   997\t\r\n   998\tfunc (e *buildExecutor) runCommand(t *TargetConfig, command string, env []string, deadline time.Time) (string, error) {\r\n   999\t\tif strings.TrimSpace(command) == \"\" {\r\n  1000\t\t\treturn \"\", nil\r\n  1001\t\t}\r\n  1002\t\tremaining := time.Until(deadline)\r\n"]
[7157.868246, "o", "  1003\t\tif remaining <= 0 {\r\n  1004\t\t\treturn \"\", fmt.Errorf(\"target %q timed out after %ds\", t.Name, t.Timeout)\r\n  1005\t\t}\r\n  1006\t\r\n  1007\t\tvar stdout, stderr bytes.Buffer\r\n  1008\t\tctx, cancel := context.WithTimeout(context.Background(), remaining)\r\n  1009\t\tdefer cancel()\r\n  1010\t\tcmd := exec.CommandContext(ctx, \"sh\", \"-c\", command)\r\n  1011\t\tcmd.Dir = e.configDir\r\n"]
[7157.868311, "o", "  1012\t\tcmd.Env = env\r\n  1013\t\tcmd.Stdout = &stdout\r\n  1014\t\tcmd.Stderr = &stderr\r\n  1015\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\r\n  1016\t\r\n  1017\t\tif err := cmd.Start(); err != nil {\r\n  1018\t\t\treturn \"\", err\r\n  1019\t\t}\r\n  1020\t\r\n  1021\t\twaitCh := make(chan error, 1)\r\n  1022\t\t"]
[7157.86837, "o", "go func() {\r\n  1023\t\t\twaitCh <- cmd.Wait()\r\n  1024\t\t}()\r\n  1025\t\r\n  1026\t\tselect {\r\n  1027\t\tcase <-ctx.Done():\r\n  1028\t\t\tif cmd.Process != nil {\r\n  1029\t\t\t\t_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\r\n  1030\t\t\t}\r\n  1031\t\t\t<-waitCh\r\n"]
[7157.868428, "o", "  1032\t\t\treturn \"\", fmt.Errorf(\"target %q timed out after %ds\", t.Name, t.Timeout)\r\n  1033\t\tcase err := <-waitCh:\r\n  1034\t\t\tif err != nil {\r\n  1035\t\t\t\tif stderr.Len() > 0 {\r\n  1036\t\t\t\t\tfmt.Fprintf(os.Stderr, \"target %q stderr:\\n%s\", t.Name, stderr.String())\r\n  1037\t\t\t\t}\r\n"]
[7157.868505, "o", "  1038\t\t\t\treturn \"\", err\r\n  1039\t\t\t}\r\n  1040\t\t}\r\n  1041\t\treturn stdout.String(), nil\r\n  1042\t}\r\n  1043\t\r\n  1044\tfunc computeCacheKey(t *TargetConfig, configDir string) (string, error) {\r\n  1045\t\th := sha256.New()\r\n  1046\t\tif _, err := io.WriteString(h, t.Command); err != nil {\r\n  1047\t\t\treturn \"\", err\r\n  1048\t\t}\r\n  1049\t\r\n"]
[7157.868567, "o", "  1050\t\tfor _, hook := range t.PreBuild {\r\n  1051\t\t\tif _, err := io.WriteString(h, hook); err != nil {\r\n  1052\t\t\t\treturn \"\", err\r\n  1053\t\t\t}\r\n  1054\t\t}\r\n  1055\t\tfor _, hook := range t.PostBuild {\r\n  1056\t\t\tif _, err := io.WriteString(h, hook); err != nil {\r\n  1057\t\t\t\treturn \"\", err\r\n  1058\t\t\t}\r\n  1059\t\t}\r\n  1060\t\r\n"]
[7157.868622, "o", "  1061\t\tdeps := make([]string, len(t.Dependencies))\r\n  1062\t\tcopy(deps, t.Dependencies)\r\n  1063\t\tsort.Strings(deps)\r\n  1064\t\tfor _, d := range deps {\r\n  1065\t\t\tif _, err := io.WriteString(h, \"dep:\"+d); err != nil {\r\n  1066\t\t\t\treturn \"\", err\r\n  1067\t\t\t}\r\n  1068\t\t}\r\n"]
[7157.868684, "o", "  1069\t\r\n  1070\t\toutputs := make([]string, len(t.Outputs))\r\n  1071\t\tcopy(outputs, t.Outputs)\r\n  1072\t\tsort.Strings(outputs)\r\n  1073\t\tfor _, p := range outputs {\r\n  1074\t\t\tif _, err := io.WriteString(h, \"out:\"+p); err != nil {\r\n  1075\t\t\t\treturn \"\", err\r\n  1076\t\t\t}\r\n"]
[7157.868739, "o", "  1077\t\t}\r\n  1078\t\r\n  1079\t\tenvKeys := make([]string, 0, len(t.Env))\r\n  1080\t\tfor k := range t.Env {\r\n  1081\t\t\tenvKeys = append(envKeys, k)\r\n  1082\t\t}\r\n  1083\t\tsort.Strings(envKeys)\r\n  1084\t\tfor _, k := range envKeys {\r\n"]
[7157.8688, "o", "  1085\t\t\tif _, err := io.WriteString(h, k+\"=\"+t.Env[k]); err != nil {\r\n  1086\t\t\t\treturn \"\", err\r\n  1087\t\t\t}\r\n  1088\t\t}\r\n  1089\t\r\n  1090\t\tinputPaths := make([]string, len(t.Inputs))\r\n  1091\t\tcopy(inputPaths, t.Inputs)\r\n  1092\t\tsort.Strings(inputPaths)\r\n"]
