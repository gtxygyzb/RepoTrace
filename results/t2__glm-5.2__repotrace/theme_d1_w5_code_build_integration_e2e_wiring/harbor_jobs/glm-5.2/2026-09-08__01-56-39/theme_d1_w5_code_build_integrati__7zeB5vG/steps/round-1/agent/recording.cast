[4494.795455, "o", "\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(s *stringSliceFlag) String() string {\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(s *stringSliceFlag) Set(value string) error {\r\n"]
[4494.795548, "o", "\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[Kmain() {\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunBuildCommand(args []string) {\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunGraphCommand(args []string) {\r\n\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunCleanCommand(args []string) {\r\n\u001b[32m\u001b[K202\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunStatusCommand(args []string) {\r\n\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string, vars []string) error {\r\n"]
[4494.795628, "o", "\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunGraph(configPath string, vars []string) error {\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunClean(configPath string, vars []string) error {\r\n\u001b[32m\u001b[K385\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunStatus(configPath string, vars []string) error {\r\n\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KloadConfig(path string, varOverrides []string) (*Config, string, error) {\r\n"]
[4494.795695, "o", "\u001b[32m\u001b[K482\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(l *configLoader) loadFile(absPath string, isRoot bool) error {\r\n\u001b[32m\u001b[K538\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KparseVarOverrides(vars []string) (map[string]string, error) {\r\n\u001b[32m\u001b[K554\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KexpandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {\r\n\u001b[32m\u001b[K590\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KvalidateConfig(cfg *Config) (map[string]*TargetConfig, error) {\r\n\u001b[32m\u001b[K656\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KselectTargets(cfg *Config, targetMap map[string]*TargetConfig, targetsFlag string) (map[string]bool, error) {\r\n\u001b[32m\u001b[K686\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KtopologicalOrder(cfg *Config, requested map[string]bool) []string {\r\n\u001b[32m\u001b[K731\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KbuildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {\r\n"]
[4494.79581, "o", "\u001b[32m\u001b[K746\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KallDependenciesComplete(name string, targetMap map[string]*TargetConfig, requested map[string]bool, status map[string]string) bool {\r\n\u001b[32m\u001b[K759\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KmarkSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {\r\n\u001b[32m\u001b[K770\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(e *buildExecutor) execute(t *TargetConfig) execResult {\r\n\u001b[32m\u001b[K832\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(e *buildExecutor) runCommand(t *TargetConfig, command string, env []string, deadline time.Time) (string, error) {\r\n\u001b[32m\u001b[K878\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KcomputeCacheKey(t *TargetConfig, configDir string) (string, error) {\r\n\u001b[32m\u001b[K939\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KmergedEnv(env map[string]string) []string {\r\n\u001b[32m\u001b[K962\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KparseHookExports(stdout string) map[string]string {\r\n\u001b[32m\u001b[K973\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31"]
[4494.795874, "o", "m\u001b[Kfunc \u001b[m\u001b[KmergeHookExports(env []string, exports map[string]string) []string {\r\n\u001b[32m\u001b[K997\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KcacheValid(cacheDir, key string, outputs []string, configDir string) (bool, CacheEntry, error) {\r\n\u001b[32m\u001b[K1013\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KreadCacheEntry(cacheDir, key string) (CacheEntry, bool, error) {\r\n\u001b[32m\u001b[K1035\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KwriteCacheEntry(cacheDir string, entry CacheEntry) error {\r\n\u001b[32m\u001b[K1046\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KhashFile(path string) (string, error) {\r\n\u001b[32m\u001b[K1059\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KhashBytes(b []byte) string {\r\n\u001b[32m\u001b[K1064\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KresolvePath(base, p string) string {\r\n\u001b[32m\u001b[K1071\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KfileExists(path string) bool {\r\n\u001b[32m\u001b[K1076\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KuniqueStrings(in []string) []string {\r\n"]
