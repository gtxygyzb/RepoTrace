[4510.464563, "o", "   111\t\tconfig    *Config\r\n   112\t\tconfigDir string\r\n   113\t\tcacheDir  string\r\n   114\t\tnoCache   bool\r\n   115\t}\r\n   116\t\r\n   117\tfunc main() {\r\n   118\t\tif len(os.Args) < 2 {\r\n   119\t\t\tfmt.Fprintln(os.Stderr, \"usage: buildctl <command> [flags]\")\r\n   120\t\t\tos.Exit(1)\r\n"]
