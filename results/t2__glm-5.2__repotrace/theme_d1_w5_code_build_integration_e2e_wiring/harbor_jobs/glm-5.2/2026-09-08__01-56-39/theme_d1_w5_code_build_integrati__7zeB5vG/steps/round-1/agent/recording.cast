[7084.56748, "o", "   483\tfunc loadConfig(path string, varOverrides []string) (*Config, string, error) {\r\n   484\t\tabs, err := filepath.Abs(path)\r\n   485\t\tif err != nil {\r\n   486\t\t\treturn nil, \"\", err\r\n   487\t\t}\r\n   488\t\toverrides, err := parseVarOverrides(varOverrides)\r\n"]
[7084.567571, "o", "   489\t\tif err != nil {\r\n   490\t\t\treturn nil, \"\", err\r\n   491\t\t}\r\n   492\t\tloader := &configLoader{\r\n   493\t\t\tvariables:   make(map[string]string),\r\n   494\t\t\ttargetNames: make(map[string]bool),\r\n   495\t\t}\r\n   496\t\tfor k, v := range overrides {\r\n   497\t\t\tloader.variables[k] = v\r\n   498\t\t}\r\n   499\t\tif err := loader.loadFile(abs, true); err != nil {\r\n   500\t\t"]
[7084.567642, "o", "\treturn nil, \"\", err\r\n   501\t\t}\r\n   502\t\tfor i := range loader.targets {\r\n   503\t\t\tt := &loader.targets[i]\r\n   504\t\t\texpanded, err := expandString(t.Command, loader.variables, make(map[string]bool))\r\n   505\t\t\tif err != nil {\r\n   506\t\t\t\treturn nil, \"\", err\r\n   507\t\t\t}\r\n   508\t\t\tt.Command = expanded\r\n   509\t\t\tfor j, p := range t.Inputs {\r\n"]
[7084.567703, "o", "   510\t\t\t\texpanded, err := expandString(p, loader.variables, make(map[string]bool))\r\n   511\t\t\t\tif err != nil {\r\n   512\t\t\t\t\treturn nil, \"\", err\r\n   513\t\t\t\t}\r\n   514\t\t\t\tt.Inputs[j] = expanded\r\n   515\t\t\t}\r\n   516\t\t\tfor j, p := range t.Outputs {\r\n   517\t\t\t\texpanded, err := expandString(p, loader.variables, make(map[string]bool))\r\n   518\t\t\t\tif err != nil {\r\n"]
[7084.567773, "o", "   519\t\t\t\t\treturn nil, \"\", err\r\n   520\t\t\t\t}\r\n   521\t\t\t\tt.Outputs[j] = expanded\r\n   522\t\t\t}\r\n   523\t\t\tt.Dependencies = uniqueStrings(t.Dependencies)\r\n"]
[7084.567834, "o", "   524\t\t\tif t.Timeout <= 0 {\r\n   525\t\t\t\tt.Timeout = 300\r\n   526\t\t\t}\r\n   527\t\t}\r\n   528\t\tcfg := &Config{\r\n   529\t\t\tPipeline:  PipelineConfig{Name: loader.pipelineName, Imports: loader.rootImports},\r\n   530\t\t\tTargets:   loader.targets,\r\n   531\t\t\tVariables: loader.variables,\r\n   532\t\t}\r\n   533\t\treturn cfg, filepath.Dir(abs), nil\r\n   534\t}\r\n   535\t\r\n"]
[7084.567891, "o", "   536\ttype configLoader struct {\r\n   537\t\tpipelineName string\r\n   538\t\trootImports  []string\r\n   539\t\tvariables    map[string]string\r\n   540\t\ttargets      []TargetConfig\r\n   541\t\ttargetNames  map[string]bool\r\n   542\t\t"]
[7084.56795, "o", "importStack  []string\r\n   543\t}\r\n   544\t\r\n   545\tfunc (l *configLoader) loadFile(absPath string, isRoot bool) error {\r\n   546\t\tfor _, p := range l.importStack {\r\n   547\t\t\tif p == absPath {\r\n   548\t\t\t\tchain := append([]string{}, l.importStack...)\r\n   549\t\t\t\tchain = append(chain, absPath)\r\n"]
[7084.568007, "o", "   550\t\t\t\treturn fmt.Errorf(\"circular import detected: %s\", strings.Join(chain, \" -> \"))\r\n   551\t\t\t}\r\n   552\t\t}\r\n   553\t\tl.importStack = append(l.importStack, absPath)\r\n   554\t\tdefer func() { l.importStack = l.importStack[:len(l.importStack)-1] }()\r\n   555\t\r\n   556\t\tvar fileCfg Config\r\n   557\t\tif _, err := toml.DecodeFile(absPath, &fileCfg); err != nil {\r\n"]
[7084.568066, "o", "   558\t\t\treturn err\r\n   559\t\t}\r\n   560\t\r\n   561\t\tif isRoot {\r\n   562\t\t\tl.pipelineName = fileCfg.Pipeline.Name\r\n   563\t\t\tl.rootImports = fileCfg.Pipeline.Imports\r\n   564\t\t}\r\n   565\t\r\n"]
[7084.568125, "o", "   566\t\tfor k, v := range fileCfg.Variables {\r\n   567\t\t\tif _, exists := l.variables[k]; !exists {\r\n   568\t\t\t\tl.variables[k] = v\r\n   569\t\t\t}\r\n   570\t\t}\r\n   571\t\r\n   572\t\tfor _, imp := range fileCfg.Pipeline.Imports {\r\n   573\t\t\texpanded, err := expandString(imp, l.variables, make(map[string]bool))\r\n   574\t\t\tif err != nil {\r\n   575\t\t\t\t"]
[7084.56818, "o", "return err\r\n   576\t\t\t}\r\n   577\t\t\timportPath := expanded\r\n   578\t\t\tif !filepath.IsAbs(importPath) {\r\n   579\t\t\t\timportPath = filepath.Join(filepath.Dir(absPath), importPath)\r\n   580\t\t\t}\r\n   581\t\t\timportAbs, err := filepath.Abs(importPath)\r\n   582\t\t\tif err != nil {\r\n   583"]
[7084.56826, "o", "\t\t\t\treturn err\r\n   584\t\t\t}\r\n   585\t\t\tif err := l.loadFile(importAbs, false); err != nil {\r\n   586\t\t\t\treturn err\r\n   587\t\t\t}\r\n   588\t\t}\r\n   589\t\r\n   590\t\tfor _, t := range fileCfg.Targets {\r\n   591\t\t\tif l.targetNames[t.Name] {\r\n   592\t\t\t\treturn fmt.Errorf(\"duplicate target name %q\", t.Name)\r\n"]
[7084.568316, "o", "   593\t\t\t}\r\n   594\t\t\tl.targetNames[t.Name] = true\r\n   595\t\t\tl.targets = append(l.targets, t)\r\n   596\t\t}\r\n   597\t\r\n   598\t\treturn nil\r\n   599\t}\r\n"]
[7084.568385, "o", "   600\t\r\n   601\tfunc parseVarOverrides(vars []string) (map[string]string, error) {\r\n   602\t\tm := make(map[string]string)\r\n   603\t\tfor _, v := range vars {\r\n   604\t\t\tidx := strings.Index(v, \"=\")\r\n   605\t\t\tif idx == -1 {\r\n   606\t\t\t\treturn nil, fmt.Errorf(\"invalid --var %q, expected key=value\", v)\r\n   607\t\t\t}\r\n   608\t\t\tkey := v[:idx]\r\n   609\t\t\tif key == \"\" {\r\n   610\t\t\t\treturn nil, fmt.Errorf(\"invalid --var %q, empty key\", v)\r\n"]
[7084.568447, "o", "   611\t\t\t}\r\n   612\t\t\tm[key] = v[idx+1:]\r\n   613\t\t}\r\n   614\t\treturn m, nil\r\n   615\t}\r\n   616\t\r\n"]
