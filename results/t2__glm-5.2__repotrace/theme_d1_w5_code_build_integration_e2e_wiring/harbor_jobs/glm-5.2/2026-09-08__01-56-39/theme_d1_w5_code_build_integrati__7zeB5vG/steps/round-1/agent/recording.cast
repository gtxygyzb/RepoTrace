[7056.236071, "o", "\t\t\tif states[dep] == 0 {\r\n\t\t\t\tif err := dfs(dep); err != nil {\r\n\t\t\t\t\treturn err\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tstack = stack[:len(stack)-1]\r\n\t\tstates[name] = 2\r\n\t\t"]
[7056.236082, "o", "return nil\r\n"]
