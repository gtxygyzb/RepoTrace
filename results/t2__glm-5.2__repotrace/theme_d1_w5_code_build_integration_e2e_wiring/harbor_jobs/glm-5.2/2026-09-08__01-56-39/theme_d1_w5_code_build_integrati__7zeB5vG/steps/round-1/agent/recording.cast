[1944.3623, "o", "cat pipeline.toml\r\n\u001b[?2004l\r"]
[1944.364582, "o", "[pipeline]\r\nname = \"sample-project\"\r\n\r\n[[targets]]\r\nname = \"compile-lib\"\r\ncommand = \"gcc -c -o build/lib.o src/lib.c\"\r\ninputs = [\"src/lib.c\", \"src/lib.h\"]\r\noutputs = [\"build/lib.o\"]\r\ndependencies = []\r\n\r\n[[targets]]\r\nname = \"compile-main\"\r\ncommand = \"gcc -c -o build/main.o src/main.c\"\r\ninputs = [\"src/main.c\", \"src/lib.h\"]\r\noutputs = [\"build/main.o\"]\r\ndependencies = []\r\n\r\n[[targets]]\r\nname = \"link\"\r\ncommand = \"gcc -o build/app build/lib.o build/main.o\"\r\ninputs = [\"build/lib.o\", \"build/main.o\"]\r\noutputs = [\"build/app\"]\r\ndependencies = [\"compile-lib\", \"compile-main\"]\r\n\r\n[[targets]]\r\nname = \"test\"\r\ncommand = \"./build/app --self-test\"\r\ninputs = [\"build/app\"]\r\noutputs = []\r\ndependencies = [\"link\"]\r\n"]
