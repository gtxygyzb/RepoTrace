[8776.309299, "o", "\r\n   280\t\ttotal := len(requested)\r\n   281\t\treadyCh := make(chan *TargetConfig, total+1)\r\n   282\t\tresultCh := make(chan execResult, total+1)\r\n   283\t\r\n   284\t\tvar mu sync.Mutex\r\n   285\t\tstarted := make(map[string]bool)\r\n   286\t\tcancelled := false\r\n   287\t\tvar cancelOnce sync.Once\r\n   288\t\r\n   289\t\tvar wg sync.WaitGroup\r\n   290\t\tfor i := 0; i < parallel; i++ {\r\n   291\t\t\twg.Add(1)\r\n   292\t\t\tgo func() {\r\n   293\t\t\t\tdefer wg.Done()\r\n   294\t\t\t\tfor t := range readyCh {\r\n   295\t\t\t\t\tmu.Lock()\r\n"]
