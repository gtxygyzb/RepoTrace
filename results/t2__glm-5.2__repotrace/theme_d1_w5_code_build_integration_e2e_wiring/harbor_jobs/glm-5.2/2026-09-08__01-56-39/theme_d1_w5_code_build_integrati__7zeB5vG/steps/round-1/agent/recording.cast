[7056.236509, "o", "\t\t}\r\n\t\tindeg[t.Name] = count\r\n\t}\r\n\r\n\tqueue := []string{}\r\n\tfor _, t := range cfg.Targets {\r\n\t\tif requested[t.Name] && indeg[t.Name] == 0 {\r\n\t\t\tqueue = append(queue, t.Name)\r\n\t\t}\r\n\t}\r\n\r\n"]
[7056.236558, "o", "\torder := []string{}\r\n\tfor len(queue) > 0 {\r\n\t\tname := queue[0]\r\n\t\tqueue = queue[1:]\r\n\t\torder = append(order, name)\r\n\t\tfor _, t := range cfg.Targets {\r\n\t"]
