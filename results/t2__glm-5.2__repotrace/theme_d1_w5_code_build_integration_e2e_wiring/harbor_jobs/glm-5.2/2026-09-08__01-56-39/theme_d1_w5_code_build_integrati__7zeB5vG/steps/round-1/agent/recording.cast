[7609.837017, "o", "\tfiltered = append(filtered, combo)\r\n   707\t\t\t}\r\n   708\t\t}\r\n   709\t\treturn filtered, nil\r\n   710\t}\r\n   711\t\r\n   712\tfunc mapEqual(a, b map[string]string) bool {\r\n   713\t\tif len(a) != len(b) {\r\n   714\t\t\treturn false\r\n   715\t\t}\r\n   716\t\tfor k, v := range a {\r\n   717\t\t\tif w, ok := b[k]; !ok || v != w {\r\n"]
[7609.83708, "o", "   718\t\t\t\treturn false\r\n   719\t\t\t}\r\n   720\t\t}\r\n   721\t\treturn true\r\n   722\t}\r\n   723\t\r\n   724\tfunc matrixExcluded(combo map[string]string, excludes []map[string]string) bool {\r\n   725\t\tfor _, excl := range excludes {\r\n   726\t\t\tmatch := true\r\n   727\t\t\tfor k, v := range excl {\r\n"]
[7609.837136, "o", "   728\t\t\t\tcv, ok := combo[k]\r\n   729\t\t\t\tif !ok || cv != v {\r\n   730\t\t\t\t\tmatch = false\r\n   731\t\t\t\t\tbreak\r\n   732\t\t\t\t}\r\n   733\t\t\t}\r\n   734\t\t\tif match {\r\n   735\t\t\t\treturn true\r\n"]
