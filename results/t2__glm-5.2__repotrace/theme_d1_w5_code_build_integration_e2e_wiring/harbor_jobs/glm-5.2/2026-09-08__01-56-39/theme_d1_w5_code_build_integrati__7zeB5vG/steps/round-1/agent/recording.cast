[2491.815998, "o", "\u001b[?2004h> "]
[2491.816148, "o", "\\t\\tvariables:   make(map[string]string),\r\n\u001b[?2004l\r"]
[2491.816202, "o", "\u001b[?2004h> "]
[2491.816347, "o", "\\t\\ttargetNames: make(map[string]bool),\r\n\u001b[?2004l\r"]
[2491.816403, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2491.816457, "o", "\u001b[?2004h> "]
[2491.816569, "o", "\\tfor k, v := range overrides {\r\n\u001b[?2004l\r"]
[2491.816622, "o", "\u001b[?2004h> "]
[2491.816724, "o", "\\t\\tloader.variables[k] = v\r\n\u001b[?2004l\r"]
[2491.816778, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2491.816836, "o", "\u001b[?2004h> "]
[2491.817032, "o", "\\tif err := loader.loadFile(abs, true); err != nil {\r\n\u001b[?2004l\r"]
[2491.826377, "o", "\u001b[?2004h> \\t\\treturn nil, \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\tfor i := range loader.targets {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tt := &loader.targets[i]\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\texpanded, err := expandString(t.Command, loader.variables, make(map[string]bool))\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\treturn nil, \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tt.Command = expanded\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tfor j, p := range t.Inputs {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\texpanded, err := expandString(p, loader.variables, make(map[string]bool))\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\treturn nil, \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tt.Inputs[j] = expanded\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tfor j, p := range t.Outputs {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\texpanded, err := expandString(p, loader.variables, make(map[string]bool))\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\treturn nil, \"\", err\r\n\u001b[?2004l\r\u001b"]
[2491.826482, "o", "[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tt.Outputs[j] = expanded\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.826545, "o", "\\t\\tt.Dependencies = uniqueStrings(t.Dependencies)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.82661, "o", "\\t\\tif t.Timeout <= 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.826689, "o", "\\t\\t\\tt.Timeout = 300\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.826747, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2491.826803, "o", "\u001b[?2004h> "]
[2491.826858, "o", "\\tcfg := &Config{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.826992, "o", "\\t\\tPipeline: PipelineConfig{Name: loader.pipelineName},\r\n\u001b[?2004l\r"]
[2491.827046, "o", "\u001b[?2004h> "]
[2491.827105, "o", "\\t\\tTargets:  loader.targets,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.827159, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.82726, "o", "\\treturn cfg, filepath.Dir(abs), nil\r\n\u001b[?2004l\r"]
[2491.827318, "o", "\u001b[?2004h> }'''\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2491.827373, "o", "\u001b[?2004h> s = re.sub(\r\n\u001b[?2004l\r"]
[2491.827427, "o", "\u001b[?2004h> "]
[2491.82757, "o", "    r'func loadConfig\\(path string\\).*?(?=\\nfunc validateConfig)',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.827652, "o", "    new_load + '\\n\\n',\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.827706, "o", ">     s,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.82777, "o", "    flags=re.DOTALL\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.827824, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2491.827878, "o", "\u001b[?2004h> "]
[2491.827961, "o", "# Add helper functions before validateConfig\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.828016, "o", "> "]
[2491.828082, "o", "helpers = '''type configLoader struct {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.828136, "o", "> "]
[2491.82819, "o", "\\tpipelineName string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.828273, "o", "\\tvariables    map[string]string\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.828328, "o", "> "]
[2491.828386, "o", "\\ttargets      []TargetConfig\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.828468, "o", "\\ttargetNames  map[string]bool\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.828522, "o", "> "]
[2491.828579, "o", "\\timportStack  []string\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2491.828634, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.828814, "o", "func (l *configLoader) loadFile(absPath string, isRoot bool) error {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.828868, "o", "> "]
[2491.828932, "o", "\\tfor _, p := range l.importStack {\r\n\u001b[?2004l\r"]
[2491.82899, "o", "\u001b[?2004h> "]
[2491.829044, "o", "\\t\\tif p == absPath {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.829156, "o", "\\t\\t\\tchain := append([]string{}, l.importStack...)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.829273, "o", "\\t\\t\\tchain = append(chain, absPath)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.829328, "o", "> "]
[2491.829499, "o", "\\t\\t\\treturn fmt.Errorf(\"circular import detected: %s\", strings.Join(chain, \" -> \"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.829565, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2491.829618, "o", "\u001b[?2004h> "]
[2491.829718, "o", "\\tl.importStack = append(l.importStack, absPath)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.829916, "o", "\\tdefer func() { l.importStack = l.importStack[:len(l.importStack)-1] }()\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.829969, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.830026, "o", "\\tvar fileCfg Config\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.830196, "o", "\\tif _, err := toml.DecodeFile(absPath, &fileCfg); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.830266, "o", "\\t\\treturn err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.830333, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.830392, "o", "\\tif isRoot {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.830519, "o", "\\t\\tl.pipelineName = fileCfg.Pipeline.Name\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.830573, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2491.830627, "o", "\u001b[?2004h> "]
[2491.830702, "o", "\\tfor k, v := range fileCfg.Variables {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.830836, "o", "\\t\\tif _, exists := l.variables[k]; !exists {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.83089, "o", "> "]
[2491.830944, "o", "\\t\\t\\tl.variables[k] = v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.830998, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.831055, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.831166, "o", "\\tfor _, imp := range fileCfg.Pipeline.Imports {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.83122, "o", "> "]
[2491.831371, "o", "\\t\\texpanded, err := expandString(imp, l.variables, make(map[string]bool))\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.831426, "o", "> "]
[2491.831479, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.831533, "o", "\\t\\t\\treturn err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.831586, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.831642, "o", "\\t\\timportPath := expanded\r\n\u001b[?2004l\r"]
[2491.831702, "o", "\u001b[?2004h> "]
[2491.831768, "o", "\\t\\tif !filepath.IsAbs(importPath) {\r\n\u001b[?2004l\r"]
[2491.831809, "o", "\u001b[?2004h> "]
[2491.831961, "o", "\\t\\t\\timportPath = filepath.Join(filepath.Dir(absPath), importPath)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.832016, "o", "> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.83215, "o", "\\t\\timportAbs, err := filepath.Abs(importPath)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.832204, "o", "> "]
[2491.832265, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.832319, "o", "\\t\\t\\treturn err\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[2491.832373, "o", "\u001b[?2004h> "]
[2491.832494, "o", "\\t\\tif err := l.loadFile(importAbs, false); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.83256, "o", "\\t\\t\\treturn err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.832625, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.832679, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.832798, "o", "\\tfor _, t := range fileCfg.Targets {\r\n\u001b[?2004l\r"]
[2491.832852, "o", "\u001b[?2004h> "]
[2491.83291, "o", "\\t\\tif l.targetNames[t.Name] {\r\n\u001b[?2004l\r"]
[2491.832963, "o", "\u001b[?2004h> "]
[2491.833097, "o", "\\t\\t\\treturn fmt.Errorf(\"duplicate target name %q\", t.Name)\r\n\u001b[?2004l\r"]
[2491.833151, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.833267, "o", "\\t\\tl.targetNames[t.Name] = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.833391, "o", "\\t\\tl.targets = append(l.targets, t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.833446, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2491.833512, "o", "\u001b[?2004h> \\treturn nil\r\n\u001b[?2004l\r"]
[2491.833567, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.833632, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.833795, "o", "func parseVarOverrides(vars []string) (map[string]string, error) {\r\n\u001b[?2004l\r"]
[2491.833849, "o", "\u001b[?2004h> "]
[2491.833905, "o", "\\tm := make(map[string]string)\r\n\u001b[?2004l\r"]
[2491.833959, "o", "\u001b[?2004h> "]
[2491.834021, "o", "\\tfor _, v := range vars {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.834122, "o", "\\t\\tidx := strings.Index(v, \"=\")\r\n\u001b[?2004l\r"]
[2491.834176, "o", "\u001b[?2004h> "]
[2491.834239, "o", "\\t\\tif idx == -1 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.834423, "o", "\\t\\t\\treturn nil, fmt.Errorf(\"invalid --var %q, expected key=value\", v)\r\n\u001b[?2004l\r"]
[2491.834479, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.834531, "o", "> "]
[2491.834585, "o", "\\t\\tkey := v[:idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.834644, "o", "\\t\\tif key == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.834828, "o", "\\t\\t\\treturn nil, fmt.Errorf(\"invalid --var %q, empty key\", v)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.834882, "o", "> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.834961, "o", "\\t\\tm[key] = v[idx+1:]\r\n\u001b[?2004l\r"]
[2491.835015, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.835073, "o", "\\treturn m, nil\r\n\u001b[?2004l\r"]
[2491.835126, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2491.835179, "o", "\u001b[?2004h> "]
[2491.835425, "o", "func expandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.83548, "o", "> "]
[2491.835541, "o", "\\tvar b strings.Builder\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.835596, "o", "\\ti := 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.835649, "o", "\\tfor i < len(s) {\r\n\u001b[?2004l\r"]
[2491.835702, "o", "\u001b[?2004h> "]
[2491.835821, "o", "\\t\\tif i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {\r\n\u001b[?2004l\r"]
[2491.835875, "o", "\u001b[?2004h> "]
[2491.835955, "o", "\\t\\t\\tend := strings.Index(s[i:], \"}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.836009, "o", "> "]
[2491.836077, "o", "\\t\\t\\tif end == -1 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.836275, "o", "\\t\\t\\t\\treturn \"\", fmt.Errorf(\"unterminated variable reference in %q\", s)\r\n\u001b[?2004l\r"]
[2491.836332, "o", "\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.836392, "o", "> "]
[2491.836456, "o", "\\t\\t\\tname := s[i+2 : i+end]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.836519, "o", "\\t\\t\\tif name == \"\" {\r\n\u001b[?2004l\r"]
[2491.836574, "o", "\u001b[?2004h> "]
[2491.836723, "o", "\\t\\t\\t\\treturn \"\", fmt.Errorf(\"empty variable reference in %q\", s)\r\n\u001b[?2004l\r"]
[2491.836777, "o", "\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.83683, "o", "> "]
[2491.836892, "o", "\\t\\t\\tif visiting[name] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.837074, "o", "\\t\\t\\t\\treturn \"\", fmt.Errorf(\"variable cycle detected: %q\", name)\r\n\u001b[?2004l\r"]
[2491.837129, "o", "\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.837182, "o", "> "]
[2491.837255, "o", "\\t\\t\\tval, ok := vars[name]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.837321, "o", "\\t\\t\\tif !ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.837375, "o", "> "]
[2491.837528, "o", "\\t\\t\\t\\treturn \"\", fmt.Errorf(\"unresolved variable %q\", name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.837619, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.837696, "o", "\\t\\t\\tvisiting[name] = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.837858, "o", "\\t\\t\\texpanded, err := expandString(val, vars, visiting)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.837939, "o", "\\t\\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.838039, "o", "\\t\\t\\t\\treturn \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.838129, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[2491.838239, "o", "\u001b[?2004h> \\t\\t\\tdelete(visiting, name)\r\n\u001b[?2004l\r"]
[2491.838332, "o", "\u001b[?2004h> "]
[2491.838398, "o", "\\t\\t\\tb.WriteString(expanded)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\ti += end + 1\r\n\u001b[?2004l\r"]
[2491.838453, "o", "\u001b[?2004h> \\t\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.838528, "o", "\\t\\t\\tb.WriteByte(s[i])\r\n\u001b[?2004l\r"]
[2491.838581, "o", "\u001b[?2004h> \\t\\t\\ti++\r\n\u001b[?2004l\r"]
[2491.838635, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[2491.838689, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.83877, "o", "\\treturn b.String(), nil\r\n\u001b[?2004l\r"]
