[3675.837698, "o", "   132\t\r\n   133\tfunc runBuildCommand(args []string) {\r\n   134\t\tfs := flag.NewFlagSet(\"build\", flag.ContinueOnError)\r\n   135\t\tfs.SetOutput(os.Stderr)\r\n   136\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   137\t\ttargetsFlag := fs.String(\"targets\", \"\", \"comma-separated target names\")\r\n   138\t\tparallel := fs.Int(\"parallel\", runtime.NumCPU(), \"max concurrent target executions\")\r\n"]
[3675.837764, "o", "   139\t\tnoCache := fs.Bool(\"no-cache\", false, \"skip all cache lookups\")\r\n   140\t\treportPath := fs.String(\"report\", \"\", \"also write JSON report to this file\")\r\n"]
[3675.837826, "o", "   141\t\tvar vars stringSliceFlag\r\n   142\t\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n   143\t\tif err := fs.Parse(args); err != nil {\r\n   144\t\t\tos.Exit(1)\r\n   145\t\t}\r\n   146\t\tif *configPath == \"\" {\r\n   147\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n   148\t\t\tos.Exit(1)\r\n   149\t\t}\r\n   150\t\tif *parallel < 1 {\r\n   151\t\t\tfmt.Fprintln(os.Stderr, \"error: --parallel must be at least 1\")\r\n   152\t\t\tos.Exit(1)\r\n   153\t\t}\r\n"]
[3675.837886, "o", "   154\t\tif err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath, []string(vars)); err != nil {\r\n   155\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   156\t\t\tos.Exit(1)\r\n   157\t\t}\r\n   158\t}\r\n   159\t\r\n   160\tfunc runGraphCommand(args []string) {\r\n   161\t\tfs := flag.NewFlagSet(\"graph\", flag.ContinueOnError)\r\n"]
[3675.83795, "o", "   162\t\tfs.SetOutput(os.Stderr)\r\n   163\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   164\t\tvar vars stringSliceFlag\r\n   165\t\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n   166\t\tif err := fs.Parse(args); err != nil {\r\n   167\t\t\tos.Exit(1)\r\n   168\t\t}\r\n"]
[3675.838015, "o", "   169\t\tif *configPath == \"\" {\r\n   170\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n   171\t\t\tos.Exit(1)\r\n   172\t\t}\r\n   173\t\tif err := runGraph(*configPath, []string(vars)); err != nil {\r\n   174\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   175\t\t\tos.Exit(1)\r\n"]
