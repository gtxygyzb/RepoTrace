[4510.724072, "o", "\tvisit = func(n string) {\r\n   673\t\t\t\tif requested[n] {\r\n   674\t\t\t\t\treturn\r\n   675\t\t\t\t}\r\n   676\t\t\t\trequested[n] = true\r\n   677\t\t\t\tfor _, dep := range targetMap[n].Dependencies {\r\n   678\t\t\t\t\tvisit(dep)\r\n   679\t\t\t\t}\r\n   680\t\t\t"]
[4510.724129, "o", "}\r\n   681\t\t\tvisit(name)\r\n   682\t\t}\r\n   683\t\treturn requested, nil\r\n   684\t}\r\n   685\t\r\n   686\tfunc topologicalOrder(cfg *Config, requested map[string]bool) []string {\r\n   687\t\tindeg := map[string]int{}\r\n   688\t\tfor _, t := range cfg.Targets {\r\n   689\t\t\tif !requested[t.Name] {\r\n   690"]
[4510.724188, "o", "\t\t\t\tcontinue\r\n   691\t\t\t}\r\n   692\t\t\tcount := 0\r\n   693\t\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n   694\t\t\t\tif requested[dep] {\r\n   695\t\t\t\t\tcount++\r\n   696\t\t\t\t}\r\n   697\t\t\t}\r\n"]
