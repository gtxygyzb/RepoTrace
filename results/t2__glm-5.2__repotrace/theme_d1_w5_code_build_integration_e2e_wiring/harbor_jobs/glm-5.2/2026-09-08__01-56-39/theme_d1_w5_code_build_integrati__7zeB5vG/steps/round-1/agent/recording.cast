[7062.912401, "o", "\t\tCachedAt string `json:\"cached_at,omitempty\"`\r\n   103\t}\r\n   104\t\r\n   105\ttype StatusReport struct {\r\n   106\t\tTargets []StatusTarget `json:\"targets\"`\r\n   107\t}\r\n   108\t\r\n   109\ttype execResult struct {\r\n   110\t\tname       string\r\n   111\t\tstatus     string\r\n   112\t\tcached     bool\r\n   113\t\tdurationMS int64\r\n   114\t\tcacheKey   string\r\n   115\t}\r\n   116\t\r\n   117\ttype buildExecutor struct {\r\n   118\t\tconfig    *Config\r\n   119\t\tconfigDir string\r\n   120\t\tcacheDir  string\r\n   121\t\tnoCache   bool\r\n   122\t}\r\n   123\t\r\n   124\tfunc main() {\r\n   125\t\tif len(os.Args) < 2 {\r\n   126\t\t\tfmt.Fprintln(os.Stderr, \"usage: buildctl <command> [flags]\")\r\n   127\t\t\tos.Exit(1)\r\n   128\t\t}\r\n   129\t\tswitch os.Args[1] {\r\n   130\t\tcase \"build\":\r\n"]
