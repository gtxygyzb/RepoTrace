[6615.461474, "o", "targetMap := map[string]*TargetConfig{}\r\n   644\t\tfor i := range cfg.Targets {\r\n   645\t\t\tt := &cfg.Targets[i]\r\n   646\t\t\tif t.Name == \"\" {\r\n   647\t\t\t\treturn nil, fmt.Errorf(\"target name is empty\")\r\n   648\t\t\t}\r\n   649\t\t\tif _, ok := targetMap[t.Name]; ok {\r\n   650\t\t\t\treturn nil, fmt.Errorf(\"duplicate target name %q\", t.Name)\r\n   651\t\t\t}\r\n   652\t\t\ttargetMap[t.Name] = t\r\n"]
