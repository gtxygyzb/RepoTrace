[1943.77209, "o", "\t}\r\n\r\n\tbuildStart := time.Now()\r\n\tfor i := range cfg.Targets {\r\n\t\tt := &cfg.Targets[i]\r\n\t\tif requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {\r\n\t\t\treadyCh <- t\r\n\t\t}\r\n\t}\r\n\r\n\tfor completed < total {\r\n\t\tres := <-resultCh\r\n"]
