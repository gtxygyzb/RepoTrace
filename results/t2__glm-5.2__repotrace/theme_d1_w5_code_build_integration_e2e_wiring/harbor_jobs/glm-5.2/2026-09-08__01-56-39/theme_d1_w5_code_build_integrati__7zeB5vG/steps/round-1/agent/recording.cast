[7055.660146, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n"]
[7055.660312, "o", "\t\"context\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"runtime\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\t\"syscall\"\r\n\t\"time\"\r\n\r\n"]
[7055.660372, "o", "\t\"github.com/BurntSushi/toml\"\r\n)\r\n\r\ntype stringSliceFlag []string\r\n\r\nfunc (s *stringSliceFlag) String() string {\r\n\treturn strings.Join(*s, \",\")\r\n}\r\n\r\nfunc (s *stringSliceFlag) Set(value string) error {\r\n\t*s = append(*s, value)\r\n\treturn nil\r\n"]
[7055.660386, "o", "}\r\n\r\ntype PipelineConfig struct {\r\n\tName    string   `toml:\"name\"`\r\n\t"]
[7055.660465, "o", "Imports []string `toml:\"imports\"`\r\n}\r\n\r\ntype TargetConfig struct {\r\n\tName         string            `toml:\"name\"`\r\n\tCommand      string            `toml:\"command\"`\r\n\tDependencies []string          `toml:\"dependencies\"`\r\n\tInputs       []string          `toml:\"inputs\"`\r\n\tOutputs      []string          `toml:\"outputs\"`\r\n\tEnv          map[string]string `toml:\"env\"`\r\n\tPreBuild     []string          `toml:\"pre_build\"`\r\n\tPostBuild    []string          `toml:\"post_build\"`\r\n\tTimeout      int               `toml:\"timeout\"`\r\n}\r\n\r\ntype Config struct {\r\n"]
[7055.660481, "o", "\tPipeline  PipelineConfig    `toml:\"pipeline\"`\r\n\tTargets   []TargetConfig    `toml:\"targets\"`\r\n\tVariables map[string]string `toml:\"variables\"`\r\n}\r\n\r\ntype CacheEntry struct {\r\n"]
[7055.660551, "o", "\tCacheKey   string   `json:\"cache_key\"`\r\n\tTargetName string   `json:\"target_name\"`\r\n"]
[7055.660564, "o", "\tTimestamp  string   `json:\"timestamp\"`\r\n"]
[7055.660626, "o", "\tOutputs    []string `json:\"outputs\"`\r\n}\r\n\r\ntype BuildTargetReport struct {\r\n\tName       string `json:\"name\"`\r\n\tStatus     string `json:\"status\"`\r\n\tCached     bool   `json:\"cached\"`\r\n\tDurationMS int64  `json:\"duration_ms\"`\r\n\t"]
[7055.660638, "o", "CacheKey   string `json:\"cache_key\"`\r\n}\r\n\r\n"]
[7055.660705, "o", "type BuildReport struct {\r\n\tPipeline string              `json:\"pipeline\"`\r\n\tTargets  []BuildTargetReport `json:\"targets\"`\r\n\tSummary  BuildSummary        `json:\"summary\"`\r\n\tProfile  *BuildProfile       `json:\"profile,omitempty\"`\r\n}\r\n\r\ntype BuildProfile struct {\r\n\tCriticalPath   []string `json:\"critical_path\"`\r\n\tCriticalPathMS int64    `json:\"critical_path_ms\"`\r\n}\r\n\r\ntype BuildSummary struct {\r\n\tTotal      int   `json:\"total\"`\r\n"]
[7055.660756, "o", "\tBuilt      int   `json:\"built\"`\r\n\t"]
[7055.66077, "o", "Cached     int   `json:\"cached\"`\r\n\tFailed     int   `json:\"failed\"`\r\n\tSkipped    int   `json:\"skipped\"`\r\n\tCancelled  int   `json:\"cancelled\"`\r\n\tDurationMS int64 `json:\"duration_ms\"`\r\n}\r\n\r\ntype StatusTarget struct {\r\n"]
[7055.66083, "o", "\tName     string `json:\"name\"`\r\n\tCached   bool   `json:\"cached\"`\r\n\tCacheKey string `json:\"cache_key,omitempty\"`\r\n\tCachedAt string `json:\"cached_at,omitempty\"`\r\n}\r\n\r\ntype StatusReport struct {\r\n\tTargets []StatusTarget `json:\"targets\"`\r\n}\r\n\r\ntype execResult struct {\r\n\tname       string\r\n\tstatus     string\r\n"]
[7055.660842, "o", "\tcached     bool\r\n\t"]
[7055.660905, "o", "durationMS int64\r\n"]
[7055.660919, "o", "\tcacheKey   string\r\n}\r\n\r\ntype buildExecutor struct {\r\n\tconfig    *Config\r\n\tconfigDir string\r\n\tcacheDir  string\r\n\tnoCache   bool\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: buildctl <command> [flags]\")\r\n"]
[7055.660981, "o", "\t\tos.Exit(1)\r\n\t}\r\n\tswitch os.Args[1] {\r\n\tcase \"build\":\r\n\t\trunBuildCommand(os.Args[2:])\r\n\tcase \"graph\":\r\n\t\trunGraphCommand(os.Args[2:])\r\n\tcase \"clean\":\r\n\t\trunCleanCommand(os.Args[2:])\r\n\tcase \"status\":\r\n\t\trunStatusCommand(os.Args[2:])\r\n\tcase \"deps\":\r\n"]
[7055.660994, "o", "\t\trunDepsCommand(os.Args[2:])\r\n"]
[7055.661057, "o", "\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command %q\\n\", os.Args[1])\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc runBuildCommand(args []string) {\r\n\tfs := flag.NewFlagSet(\"build\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n"]
[7055.66107, "o", "\ttargetsFlag := fs.String(\"targets\", \"\", \"comma-separated target names\")\r\n"]
[7055.66113, "o", "\tparallel := fs.Int(\"parallel\", runtime.NumCPU(), \"max concurrent target executions\")\r\n\tnoCache := fs.Bool(\"no-cache\", false, \"skip all cache lookups\")\r\n\treportPath := fs.String(\"report\", \"\", \"also write JSON report to this file\")\r\n\tkeepGoing := fs.Bool(\"keep-going\", false, \"continue building independent targets after failures (default fail-fast)\")\r\n\tprofile := fs.Bool(\"profile\", false, \"include build profile with critical path in JSON report\")\r\n\tvar vars stringSliceFlag\r\n\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n\tif err := fs.Parse(args); err != nil {\r\n"]
[7055.661143, "o", "\t\tos.Exit(1)\r\n\t}\r\n\tif *configPath == \"\" {\r\n"]
[7055.661212, "o", "\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif *parallel < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --parallel must be at least 1\")\r\n"]
[7055.661231, "o", "\t\tos.Exit(1)\r\n\t}\r\n\tif err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath, []string(vars), *keepGoing, *profile); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc runGraphCommand(args []string) {\r\n"]
[7055.661297, "o", "\tfs := flag.NewFlagSet(\"graph\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n\tvar vars stringSliceFlag\r\n\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif *configPath == \"\" {\r\n\t\t"]
[7055.661346, "o", "fmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n\t\tos.Exit(1)\r\n"]
[7055.661359, "o", "\t}\r\n\tif err := runGraph(*configPath, []string(vars)); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\n"]
[7055.661425, "o", "func runCleanCommand(args []string) {\r\n\tfs := flag.NewFlagSet(\"clean\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n\tvar vars stringSliceFlag\r\n\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif *configPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n"]
[7055.661439, "o", "\t\tos.Exit(1)\r\n\t}\r\n"]
[7055.661453, "o", "\tif err := runClean(*configPath, []string(vars)); err != nil {\r\n"]
[7055.661536, "o", "\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc runStatusCommand(args []string) {\r\n\tfs := flag.NewFlagSet(\"status\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n\tvar vars stringSliceFlag\r\n\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tos.Exit(1)\r\n"]
[7055.662287, "o", "\u001b[?2004hroot@n30009:/app# "]
[7055.9477, "i", "sed -n '220,520p' main.go\n"]
[7055.94795, "o", "sed -n '220,520p' main.go\r\n\u001b[?2004l\r"]
[7055.950796, "o", "\t\tos.Exit(1)\r\n\t}\r\n\tif *configPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n\t\tos.Exit(1)\r\n"]
[7055.950874, "o", "\t}\r\n\tif err := runStatus(*configPath, []string(vars)); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string, vars []string, keepGoing bool, profile bool) error {\r\n\tcfg, configDir, err := loadConfig(configPath, vars)\r\n\tif err != nil {\r\n\t\treturn err\r\n"]
[7055.950957, "o", "\t}\r\n\ttargetMap, err := validateConfig(cfg)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\trequested, err := selectTargets(cfg, targetMap, targetsFlag)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\torder := topologicalOrder(cfg, requested)\r\n\treverseDeps := buildReverseDeps(cfg, requested)\r\n\r\n\tcacheKeys := make(map[string]string)\r\n\tfor i := range cfg.Targets {\r\n\t\tt := &cfg.Targets[i]\r\n"]
[7055.95102, "o", "\t\tif !requested[t.Name] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tkey, err := computeCacheKey(t, configDir)\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n"]
[7055.951077, "o", "\t\tcacheKeys[t.Name] = key\r\n\t}\r\n\r\n\texecutor := &buildExecutor{\r\n\t\tconfig:    cfg,\r\n\t\tconfigDir: configDir,\r\n"]
[7055.951134, "o", "\t\tcacheDir:  filepath.Join(configDir, \".buildctl-cache\"),\r\n\t\tnoCache:   noCache,\r\n\t}\r\n\r\n\tstatus := make(map[string]string)\r\n\tdurations := make(map[string]int64)\r\n\tcompleted := 0\r\n\ttotal := len(requested)\r\n"]
[7055.95119, "o", "\treadyCh := make(chan *TargetConfig, total+1)\r\n\tresultCh := make(chan execResult, total+1)\r\n\r\n\tvar mu sync.Mutex\r\n\tstarted := make(map[string]bool)\r\n\tcancelled := false\r\n\r\n"]
[7055.951283, "o", "\tvar wg sync.WaitGroup\r\n\tfor i := 0; i < parallel; i++ {\r\n\t\twg.Add(1)\r\n\t\tgo func() {\r\n\t\t\tdefer wg.Done()\r\n\t\t\tfor t := range readyCh {\r\n\t\t\t\tmu.Lock()\r\n\t\t\t\tif cancelled {\r\n"]
[7055.951341, "o", "\t\t\t\t\tmu.Unlock()\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tstarted[t.Name] = true\r\n\t\t\t\tmu.Unlock()\r\n\t\t\t\tres := executor.execute(t)\r\n\t\t\t\tif res.status == \"failed\" && !keepGoing {\r\n\t\t\t\t\tmu.Lock()\r\n"]
[7055.951396, "o", "\t\t\t\t\tcancelled = true\r\n\t\t\t\t\tmu.Unlock()\r\n\t\t\t\t}\r\n\t\t\t\tresultCh <- res\r\n\t\t\t}\r\n"]
[7055.951452, "o", "\t\t}()\r\n\t}\r\n\r\n\tbuildStart := time.Now()\r\n\tfor i := range cfg.Targets {\r\n\t\tt := &cfg.Targets[i]\r\n\t\tif requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {\r\n\t\t\treadyCh <- t\r\n\t\t}\r\n"]
[7055.951512, "o", "\t}\r\n\r\n\tfor completed < total {\r\n\t\tres := <-resultCh\r\n\t\tstatus[res.name] = res.status\r\n\t\tdurations[res.name] = res.durationMS\r\n"]
[7055.951568, "o", "\t\tif res.cacheKey != \"\" {\r\n\t\t\tcacheKeys[res.name] = res.cacheKey\r\n\t\t}\r\n\t\tcompleted++\r\n\r\n\t\tif res.status == \"built\" || res.status == \"cached\" {\r\n\t\t\tmu.Lock()\r\n\t\t\t"]
[7055.951623, "o", "canSchedule := !cancelled\r\n\t\t\tmu.Unlock()\r\n\t\t\tif canSchedule {\r\n\t\t\t\tfor _, dependent := range reverseDeps[res.name] {\r\n"]
[7055.951677, "o", "\t\t\t\t\tif allDependenciesComplete(dependent, targetMap, requested, status) {\r\n\t\t\t\t\t\treadyCh <- targetMap[dependent]\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tcontinue\r\n"]
[7055.951733, "o", "\t\t}\r\n\r\n\t\tif res.status == \"failed\" {\r\n\t\t\tmarkSkipped(reverseDeps, status, durations, &completed, res.name)\r\n\t\t\tif !keepGoing {\r\n\t\t\t\tmu.Lock()\r\n"]
[7055.951788, "o", "\t\t\t\tcancelled = true\r\n\t\t\t\tfor i := range cfg.Targets {\r\n\t\t\t\t\tt := &cfg.Targets[i]\r\n\t\t\t\t\tif !requested[t.Name] {\r\n\t\t\t\t\t\tcontinue\r\n"]
[7055.951843, "o", "\t\t\t\t\t}\r\n\t\t\t\t\tif status[t.Name] == \"\" && !started[t.Name] {\r\n\t\t\t\t\t\tstatus[t.Name] = \"cancelled\"\r\n\t\t\t\t\t\tdurations[t.Name] = 0\r\n\t\t\t\t\t\tcompleted++\r\n"]
[7055.951897, "o", "\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tmu.Unlock()\r\n\t\t\t}\r\n\t\t\tcontinue\r\n"]
[7055.952002, "o", "\t\t}\r\n\t}\r\n\r\n\tclose(readyCh)\r\n\twg.Wait()\r\n\r\n\treport := BuildReport{Pipeline: cfg.Pipeline.Name, Targets: []BuildTargetReport{}}\r\n\tfor _, name := range order {\r\n\t\tst := status[name]\r\n\t\tif st == \"\" {\r\n\t\t\tif keepGoing {\r\n"]
[7055.95213, "o", "\t\t\t\tst = \"skipped\"\r\n\t\t\t} else {\r\n\t\t\t\tst = \"cancelled\"\r\n\t\t\t}\r\n\t\t}\r\n\t\treport.Targets = append(report.Targets, BuildTargetReport{\r\n\t\t\tName:       name,\r\n\t\t\tStatus:     st,\r\n\t\t\tCached:     st == \"cached\",\r\n\t\t\tDurationMS: durations[name],\r\n\t\t\tCacheKey:   cacheKeys[name],\r\n\t\t})\r\n\t}\r\n\r\n\tsummary := BuildSummary{Total: len(report.Targets)}\r\n\tfor _, t := range report.Targets {\r\n"]
[7055.952199, "o", "\t\tswitch t.Status {\r\n\t\tcase \"built\":\r\n\t\t\tsummary.Built++\r\n\t\tcase \"cached\":\r\n\t\t\tsummary.Cached++\r\n\t\tcase \"failed\":\r\n\t\t\tsummary.Failed++\r\n\t\tcase \"skipped\":\r\n"]
[7055.952284, "o", "\t\t\tsummary.Skipped++\r\n\t\tcase \"cancelled\":\r\n\t\t\tsummary.Cancelled++\r\n\t\t}\r\n\t}\r\n\tsummary.DurationMS = time.Since(buildStart).Milliseconds()\r\n"]
