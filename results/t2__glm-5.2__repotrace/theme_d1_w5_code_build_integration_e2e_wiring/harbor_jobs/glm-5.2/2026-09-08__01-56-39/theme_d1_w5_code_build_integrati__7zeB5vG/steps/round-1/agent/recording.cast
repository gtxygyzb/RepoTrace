[8096.64731, "o", "\r\n    92\ttype BuildSummary struct {\r\n    93\t\tTotal      int   `json:\"total\"`\r\n    94\t\tBuilt      int   `json:\"built\"`\r\n    95\t\tCached     int   `json:\"cached\"`\r\n    96\t\tFailed     int   `json:\"failed\"`\r\n    97\t\tSkipped    int   `json:\"skipped\"`\r\n    98\t\tCancelled  int   `json:\"cancelled\"`\r\n    99\t\tDurationMS int64 `json:\"duration_ms\"`\r\n   100\t}\r\n   101\t\r\n"]
