[5688.054192, "o", "\tCached     bool   `json:\"cached\"`\r\n    72\t\tDurationMS int64  `json:\"duration_ms\"`\r\n    73\t\tCacheKey   string `json:\"cache_key\"`\r\n    74\t}\r\n    75\t\r\n    76\ttype BuildReport struct {\r\n    77\t\tPipeline string              `json:\"pipeline\"`\r\n    78\t\tTargets  []BuildTargetReport `json:\"targets\"`\r\n    79\t\tSummary  BuildSummary        `json:\"summary\"`\r\n    80\t}\r\n    81\t\r\n    82\ttype BuildSummary struct {\r\n    83\t\tTotal      int   `json:\"total\"`\r\n    84\t\tBuilt      int   `json:\"built\"`\r\n    85\t\tCached     int   `json:\"cached\"`\r\n    86\t\tFailed     int   `json:\"failed\"`\r\n    87\t\tSkipped    int   `json:\"skipped\"`\r\n    88\t\tDurationMS int64 `json:\"duration_ms\"`\r\n    89\t}\r\n    90\t\r\n    91\ttype StatusTarget struct {\r\n    92\t\tName     string `json:\"name\"`\r\n    93\t\tCached   bool   `json:\"cached\"`\r\n    94\t\tCacheKey string `json:\"cache_key,omitempty\"`\r\n    95\t\tCachedAt string `json:\"cached_at,omitempty\"`\r\n    96\t}\r\n    97\t\r\n    98\ttype StatusReport struct {\r\n    99\t\tTargets []StatusTarget `json:\"targets\"`\r\n   100\t}\r\n   101\t\r\n "]
[5688.05429, "o", "  102\ttype execResult struct {\r\n   103\t\tname       string\r\n   104\t\tstatus     string\r\n   105\t\tcached     bool\r\n   106\t\tdurationMS int64\r\n   107\t\tcacheKey   string\r\n   108\t}\r\n   109\t\r\n   110\ttype buildExecutor struct {\r\n   111\t\tconfig    *Config\r\n   112\t\tconfigDir string\r\n   113\t\tcacheDir  string\r\n   114\t\tnoCache   bool\r\n   115\t}\r\n   116\t\r\n   117\tfunc main() {\r\n   118\t\tif len(os.Args) < 2 {\r\n   119\t\t\tfmt.Fprintln(os.Stderr, \"usage: buildctl <command> [flags]\")\r\n   120\t\t\tos.Exit(1)\r\n   121\t\t}\r\n   122\t\tswitch os.Args[1] {\r\n   123\t\tcase \"build\":\r\n   124\t\t\trunBuildCommand(os.Args[2:])\r\n   125\t\tcase \"graph\":\r\n   126\t\t\trunGraphCommand(os.Args[2:])\r\n   127\t\tcase \"clean\":\r\n"]
[5688.054367, "o", "   128\t\t\trunCleanCommand(os.Args[2:])\r\n   129\t\tcase \"status\":\r\n   130\t\t\trunStatusCommand(os.Args[2:])\r\n   131\t\tcase \"deps\":\r\n   132\t\t\trunDepsCommand(os.Args[2:])\r\n   133\t\tdefault:\r\n   134\t\t\tfmt.Fprintf(os.Stderr, \"unknown command %q\\n\", os.Args[1])\r\n   135\t\t\tos.Exit(1)\r\n   136\t\t}\r\n   137\t}\r\n"]
[5688.054428, "o", "   138\t\r\n   139\tfunc runBuildCommand(args []string) {\r\n   140\t\tfs := flag.NewFlagSet(\"build\", flag.ContinueOnError)\r\n   141\t\tfs.SetOutput(os.Stderr)\r\n   142\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   143\t\ttargetsFlag := fs.String(\"targets\", \"\", \"comma-separated target names\")\r\n   144\t\tparallel := fs.Int(\"parallel\", runtime.NumCPU(), \"max concurrent target executions\")\r\n"]
[5688.054489, "o", "   145\t\tnoCache := fs.Bool(\"no-cache\", false, \"skip all cache lookups\")\r\n   146\t\treportPath := fs.String(\"report\", \"\", \"also write JSON report to this file\")\r\n   147\t\tvar vars stringSliceFlag\r\n   148\t\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n   149\t\tif err := fs.Parse(args); err != nil {\r\n   150\t\t\tos.Exit(1)\r\n   151\t\t}\r\n   152\t\t"]
[5688.054549, "o", "if *configPath == \"\" {\r\n   153\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n   154\t\t\tos.Exit(1)\r\n   155\t\t}\r\n   156\t\tif *parallel < 1 {\r\n   157\t\t\tfmt.Fprintln(os.Stderr, \"error: --parallel must be at least 1\")\r\n   158\t\t\tos.Exit(1)\r\n   159\t\t}\r\n   160\t\tif err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath, []string(vars)); err != nil {\r\n   161\t\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[5688.054613, "o", "   162\t\t\tos.Exit(1)\r\n   163\t\t}\r\n   164\t}\r\n   165\t\r\n   166\tfunc runGraphCommand(args []string) {\r\n   167\t\tfs := flag.NewFlagSet(\"graph\", flag.ContinueOnError)\r\n   168\t\tfs.SetOutput(os.Stderr)\r\n   169\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   170\t\tvar vars stringSliceFlag\r\n"]
