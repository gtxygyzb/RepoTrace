[7651.056601, "o", "  1113\t\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1114\t\t\t}\r\n  1115\t\t\tif valid {\r\n  1116\t\t\t\treturn execResult{name: t.Name, status: \"cached\", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1117\t\t\t}\r\n  1118\t\t}\r\n  1119\t\r\n  1120\t\ttimeout := t.Timeout\r\n  1121\t\tif timeout <= 0 {\r\n  1122\t\t\ttimeout = 300\r\n  1123\t\t}\r\n  1124\t\tdeadline := time.Now().Add(time.Duration(timeout) * time.Second)\r\n  1125\t\r\n"]
