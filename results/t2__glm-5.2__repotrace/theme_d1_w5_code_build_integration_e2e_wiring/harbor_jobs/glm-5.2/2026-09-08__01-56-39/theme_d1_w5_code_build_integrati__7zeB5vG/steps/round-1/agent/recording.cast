[6222.04993, "o", "   805\tfunc markSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {\r\n   806\t\tfor _, dependent := range reverseDeps[name] {\r\n   807\t\t\tswitch status[dependent] {\r\n   808\t\t\tcase \"\", \"cancelled\":\r\n   809\t\t\t\twasCancelled := status[dependent] == \"cancelled\"\r\n   810"]
[6222.050027, "o", "\t\t\t\tstatus[dependent] = \"skipped\"\r\n   811\t\t\t\tdurations[dependent] = 0\r\n   812\t\t\t\tif !wasCancelled {\r\n   813\t\t\t\t\t*completed++\r\n   814\t\t\t\t}\r\n   815\t\t\t\tmarkSkipped(reverseDeps, status, durations, completed, dependent)\r\n   816\t\t\t}\r\n   817\t\t}\r\n   818\t}\r\n"]
