[7632.477115, "o", "   235\tfunc runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string, vars []string, keepGoing bool, profile bool) error {\r\n   236\t\tcfg, configDir, err := loadConfig(configPath, vars)\r\n   237\t\tif err != nil {\r\n   238\t\t\treturn err\r\n"]
[7632.477293, "o", "   239\t\t}\r\n   240\t\ttargetMap, err := validateConfig(cfg)\r\n   241\t\tif err != nil {\r\n   242\t\t\treturn err\r\n   243\t\t}\r\n   244\t\trequested, err := selectTargets(cfg, targetMap, targetsFlag)\r\n   245\t\tif err != nil {\r\n   246\t\t\treturn err\r\n   247\t\t}\r\n   248\t\torder := topologicalOrder(cfg, requested)\r\n   249\t\treverseDeps := buildReverseDeps(cfg, requested)\r\n   250\t\r\n   251\t\tcacheKeys := make(map[string]string)\r\n   252\t\tfor i := range cfg.Targets {\r\n   253\t\t\tt := &cfg.Targets[i]\r\n   254\t\t\tif !requested[t.Name] {\r\n   255\t\t\t\tcontinue\r\n   256\t\t\t}\r\n   257\t\t\tkey, err := computeCacheKey(t, configDir)\r\n"]
[7632.477374, "o", "   258\t\t\tif err != nil {\r\n   259\t\t\t\treturn err\r\n   260\t\t\t}\r\n   261\t\t\tcacheKeys[t.Name] = key\r\n   262\t\t}\r\n   263\t\r\n   264\t\texecutor := &buildExecutor{\r\n   265\t\t\tconfig:    cfg,\r\n"]
[7632.477448, "o", "   266\t\t\tconfigDir: configDir,\r\n   267\t\t\tcacheDir:  filepath.Join(configDir, \".buildctl-cache\"),\r\n   268\t\t\tnoCache:   noCache,\r\n   269\t\t}\r\n   270\t\r\n   271\t\tstatus := make(map[string]string)\r\n   272\t\tdurations := make(map[string]int64)\r\n   273\t\tcompleted := 0\r\n"]
[7632.477513, "o", "   274\t\ttotal := len(requested)\r\n   275\t\treadyCh := make(chan *TargetConfig, total+1)\r\n   276\t\tresultCh := make(chan execResult, total+1)\r\n   277\t\r\n   278\t\tvar mu sync.Mutex\r\n   279\t\tstarted := make(map[string]bool)\r\n   280\t\tcancelled := false\r\n"]
[7632.477577, "o", "   281\t\r\n   282\t\tvar wg sync.WaitGroup\r\n   283\t\tfor i := 0; i < parallel; i++ {\r\n   284\t\t\twg.Add(1)\r\n   285\t\t\tgo func() {\r\n   286\t\t\t\tdefer wg.Done()\r\n   287\t\t\t\t"]
[7632.477639, "o", "for t := range readyCh {\r\n   288\t\t\t\t\tmu.Lock()\r\n   289\t\t\t\t\tif cancelled {\r\n   290\t\t\t\t\t\tmu.Unlock()\r\n   291\t\t\t\t\t\tcontinue\r\n   292\t\t\t\t\t}\r\n"]
[7632.4777, "o", "   293\t\t\t\t\tstarted[t.Name] = true\r\n   294\t\t\t\t\tmu.Unlock()\r\n   295\t\t\t\t\tres := executor.execute(t)\r\n   296\t\t\t\t\tif res.status == \"failed\" && !keepGoing {\r\n   297\t\t\t\t\t\tmu.Lock()\r\n"]
[7632.477759, "o", "   298\t\t\t\t\t\tcancelled = true\r\n   299\t\t\t\t\t\tmu.Unlock()\r\n   300\t\t\t\t\t}\r\n   301\t\t\t\t\tresultCh <- res\r\n   302\t\t\t\t}\r\n   303\t\t\t}()\r\n"]
[7632.477825, "o", "   304\t\t}\r\n   305\t\r\n   306\t\tbuildStart := time.Now()\r\n   307\t\tfor i := range cfg.Targets {\r\n   308\t\t\tt := &cfg.Targets[i]\r\n   309\t\t\tif requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {\r\n"]
[7632.477898, "o", "   310\t\t\t\treadyCh <- t\r\n   311\t\t\t}\r\n   312\t\t}\r\n   313\t\r\n"]
[7632.477965, "o", "   314\t\tfor completed < total {\r\n   315\t\t\tres := <-resultCh\r\n   316\t\t\tstatus[res.name] = res.status\r\n   317\t\t\tdurations[res.name] = res.durationMS\r\n   318\t\t\tif res.cacheKey != \"\" {\r\n   319\t\t\t\tcacheKeys[res.name] = res.cacheKey\r\n   320\t\t\t}\r\n   321\t\t\tcompleted++\r\n   322\t\r\n   323\t\t\tif res.status == \"built\" || res.status == \"cached\" {\r\n   324\t\t\t\tmu.Lock()\r\n   325\t\t\t\tcanSchedule := !cancelled\r\n"]
[7632.478034, "o", "   326\t\t\t\tmu.Unlock()\r\n   327\t\t\t\tif canSchedule {\r\n   328\t\t\t\t\tfor _, dependent := range reverseDeps[res.name] {\r\n   329\t\t\t\t\t\tif allDependenciesComplete(dependent, targetMap, requested, status) {\r\n   330\t\t\t\t\t\t\treadyCh <- targetMap[dependent]\r\n   331\t\t\t\t\t\t}\r\n"]
[7632.478094, "o", "   332\t\t\t\t\t}\r\n   333\t\t\t\t}\r\n   334\t\t\t\tcontinue\r\n   335\t\t\t}\r\n   336\t\r\n   337\t\t\tif res.status == \"failed\" {\r\n"]
[7632.478157, "o", "   338\t\t\t\tmarkSkipped(reverseDeps, status, durations, &completed, res.name)\r\n   339\t\t\t\tif !keepGoing {\r\n   340\t\t\t\t\tmu.Lock()\r\n   341\t\t\t\t\tcancelled = true\r\n   342\t\t\t\t\tfor i := range cfg.Targets {\r\n"]
[7632.47822, "o", "   343\t\t\t\t\t\tt := &cfg.Targets[i]\r\n   344\t\t\t\t\t\tif !requested[t.Name] {\r\n   345\t\t\t\t\t\t\tcontinue\r\n   346\t\t\t\t\t\t}\r\n   347\t\t\t\t\t\tif status[t.Name] == \"\" && !started[t.Name] {\r\n"]
[7632.478292, "o", "   348\t\t\t\t\t\t\tstatus[t.Name] = \"cancelled\"\r\n   349\t\t\t\t\t\t\tdurations[t.Name] = 0\r\n   350\t\t\t\t\t\t\tcompleted++\r\n   351\t\t\t\t\t\t}\r\n"]
[7632.478369, "o", "   352\t\t\t\t\t}\r\n   353\t\t\t\t\tmu.Unlock()\r\n   354\t\t\t\t}\r\n   355\t\t\t\tcontinue\r\n   356\t\t\t}\r\n   357\t\t}\r\n   358\t\r\n   359\t\tclose(readyCh)\r\n"]
[7632.478431, "o", "   360\t\twg.Wait()\r\n   361\t\r\n   362\t\treport := BuildReport{Pipeline: cfg.Pipeline.Name, Targets: []BuildTargetReport{}}\r\n   363\t\tfor _, name := range order {\r\n   364\t\t\tst := status[name]\r\n   365\t\t\tif st == \"\" {\r\n   366\t\t\t\tif keepGoing {\r\n   367"]
[7632.478493, "o", "\t\t\t\t\tst = \"skipped\"\r\n   368\t\t\t\t} else {\r\n   369\t\t\t\t\tst = \"cancelled\"\r\n   370\t\t\t\t}\r\n   371\t\t"]
[7632.478554, "o", "\t}\r\n   372\t\t\treport.Targets = append(report.Targets, BuildTargetReport{\r\n   373\t\t\t\tName:       name,\r\n   374\t\t"]
[7632.478617, "o", "\t\tStatus:     st,\r\n   375\t\t\t\tCached:     st == \"cached\",\r\n   376\t\t\t\tDurationMS: durations[name],\r\n   377\t\t\t\tCacheKey:   cacheKeys[name],\r\n   378\t\t\t})\r\n   379\t"]
[7632.478676, "o", "\t}\r\n"]
[7632.478758, "o", "   380\t\r\n   381\t\tsummary := BuildSummary{Total: len(report.Targets)}\r\n   382\t\tfor _, t := range report.Targets {\r\n   383\t\t\tswitch t.Status {\r\n   384\t\t\tcase \"built\":\r\n   385\t\t\t\tsummary.Built++\r\n   386\t\t\tcase \"cached\":\r\n   387\t\t\t\tsummary.Cached++\r\n   388\t\t\tcase \"failed\":\r\n   389\t\t\t\tsummary.Failed++\r\n   390\t\t\tcase \"skipped\":\r\n   391\t\t\t\tsummary.Skipped++\r\n   392\t\t\tcase \"cancelled\":\r\n   393\t\t\t\tsummary.Cancelled++\r\n"]
