[4518.357973, "o", "   117\tfunc main() {\r\n   118\t\tif len(os.Args) < 2 {\r\n   119\t\t\tfmt.Fprintln(os.Stderr, \"usage: buildctl <command> [flags]\")\r\n   120\t\t\tos.Exit(1)\r\n   121\t\t}\r\n   122\t\tswitch os.Args[1] {\r\n   123\t\tcase \"build\":\r\n   124\t\t\trunBuildCommand(os.Args[2:])\r\n   125\t\tcase \"graph\":\r\n   126\t\t\trunGraphCommand(os.Args[2:])\r\n   127\t\tcase \"clean\":\r\n   128\t\t\trunCleanCommand(os.Args[2:])\r\n   129\t\tcase \"status\":\r\n   130\t\t\trunStatusCommand(os.Args[2:])\r\n   131\t\tdefault:\r\n   132\t\t\tfmt.Fprintf(os.Stderr, \"unknown command %q\\n\", os.Args[1])\r\n   133\t\t\tos.Exit(1)\r\n   134\t\t}\r\n   135\t}\r\n   136\t\r\n   137\tfunc runBuildCommand(args []string) {\r\n   138\t\tfs := flag.NewFlagSet(\"build\", flag.ContinueOnError)\r\n   139\t\tfs.SetOutput(os.Stderr)\r\n   140\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   141\t\ttargetsFlag := fs.String(\"targets\", \"\", \"comma-separated target names\")\r\n   142\t\tparallel := fs.Int(\"parallel\", runtime.NumCPU(), \"max concurrent target executions\")\r\n   143\t\tnoCache := fs.Bool(\"no-cache\", false, \"skip all ca"]
[4518.358044, "o", "che lookups\")\r\n   144\t\treportPath := fs.String(\"report\", \"\", \"also write JSON report to this file\")\r\n   145\t\tvar vars stringSliceFlag\r\n   146\t\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n   147\t\tif err := fs.Parse(args); err != nil {\r\n   148\t\t\tos.Exit(1)\r\n   149\t\t}\r\n   150\t\tif *configPath == \"\" {\r\n   151\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n   152\t\t\tos.Exit(1)\r\n   153\t\t}\r\n   154\t\tif *parallel < 1 {\r\n   155\t\t\tfmt.Fprintln(os.Stderr, \"error: --parallel must be at least 1\")\r\n   156\t\t\tos.Exit(1)\r\n   157\t\t}\r\n   158\t\tif err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath, []string(vars)); err != nil {\r\n   159\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   160\t\t\tos.Exit(1)\r\n"]
