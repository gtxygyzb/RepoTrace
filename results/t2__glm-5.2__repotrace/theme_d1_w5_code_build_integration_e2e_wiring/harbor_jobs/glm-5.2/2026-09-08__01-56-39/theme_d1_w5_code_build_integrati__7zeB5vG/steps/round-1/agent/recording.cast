[5515.723596, "o", "    \"target\": \"app\",\r\n\u001b[?2004l\r"]
[5515.72366, "o", "\u001b[?2004h> "]
[5515.723864, "o", "    \"direct_deps\": [\"mid1\", \"mid2\"],\r\n\u001b[?2004l\r"]
[5515.723918, "o", "\u001b[?2004h> "]
[5515.724244, "o", "    \"transitive_deps\": [\"lib1\", \"lib2\", \"mid1\", \"mid2\"],\r\n\u001b[?2004l\r"]
[5515.724296, "o", "\u001b[?2004h> "]
[5515.724471, "o", "    \"reverse_deps\": [\"test\"],\r\n\u001b[?2004l\r"]
[5515.724528, "o", "\u001b[?2004h> "]
[5515.724585, "o", "}, basic\r\n\u001b[?2004l\r"]
[5515.724638, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5515.724688, "o", "\u001b[?2004h> "]
[5515.725047, "o", "why1 = run([\"deps\", \"--config\", cfg, \"--why\", \"app\", \"lib1\"])\r\n\u001b[?2004l\r"]
[5515.725111, "o", "\u001b[?2004h> "]
[5515.725204, "o", "assert why1 == {\r\n\u001b[?2004l\r"]
[5515.725276, "o", "\u001b[?2004h> "]
[5515.725383, "o", "    \"from\": \"app\",\r\n\u001b[?2004l\r"]
[5515.725437, "o", "\u001b[?2004h> "]
[5515.72554, "o", "    \"to\": \"lib1\",\r\n\u001b[?2004l\r"]
[5515.725604, "o", "\u001b[?2004h> "]
[5515.725971, "o", "    \"paths\": [[\"app\", \"mid1\", \"lib1\"], [\"app\", \"mid2\", \"lib1\"]],\r\n\u001b[?2004l\r"]
[5515.726037, "o", "\u001b[?2004h> "]
[5515.726101, "o", "}, why1\r\n\u001b[?2004l\r"]
[5515.72616, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5515.726214, "o", "\u001b[?2004h> "]
[5515.726598, "o", "why2 = run([\"deps\", \"--config\", cfg, \"--why\", \"app\", \"lib2\"])\r\n\u001b[?2004l\r"]
[5515.726656, "o", "\u001b[?2004h> "]
[5515.726992, "o", "assert why2[\"paths\"] == [[\"app\", \"mid1\", \"lib2\"]], why2\r\n\u001b[?2004l\r"]
[5515.727056, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5515.727111, "o", "\u001b[?2004h"]
[5515.727177, "o", "> "]
[5515.727486, "o", "why3 = run([\"deps\", \"--config\", cfg, \"--why\", \"app\", \"test\"])\r\n\u001b[?2004l\r"]
[5515.727543, "o", "\u001b[?2004h> "]
[5515.727726, "o", "assert why3[\"paths\"] == [], why3\r\n\u001b[?2004l\r"]
[5515.727789, "o", "\u001b[?2004h> "]
[5515.727844, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5515.728208, "o", "affected = run([\"deps\", \"--config\", cfg, \"--affected\", \"a.txt\"])\r\n\u001b[?2004l\r"]
[5515.72827, "o", "\u001b[?2004h> "]
[5515.728875, "o", "assert [e[\"target\"] for e in affected[\"rebuild_order\"]] == [\"lib1\", \"mid1\", \"mid2\", \"app\", \"test\"], affected\r\n\u001b[?2004l\r"]
[5515.728944, "o", "\u001b[?2004h> "]
[5515.72952, "o", "assert [e[\"direct\"] for e in affected[\"rebuild_order\"]] == [True, False, False, False, False], affected\r\n\u001b[?2004l\r"]
[5515.729582, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5515.729634, "o", "\u001b[?2004h> "]
[5515.730037, "o", "plan = run([\"deps\", \"--config\", cfg, \"--affected\", \"a.txt\", \"--plan\"])\r\n\u001b[?2004l\r"]
[5515.730091, "o", "\u001b[?2004h> "]
[5515.730837, "o", "assert [[e[\"target\"] for e in layer] for layer in plan[\"rebuild_plan\"]] == [[\"lib1\"], [\"mid1\", \"mid2\"], [\"app\"], [\"test\"]], plan\r\n\u001b[?2004l\r"]
[5515.730896, "o", "\u001b[?2004h> "]
[5515.73133, "o", "assert all(e[\"direct\"] == (e[\"target\"] == \"lib1\") for layer in plan[\"rebuild_plan\"] for e in layer), plan\r\n\u001b[?2004l\r"]
[5515.731388, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5515.731444, "o", "> "]
[5515.731717, "o", "affected2 = run([\"deps\", \"--config\", cfg, \"--affected\", \"a.txt\", \"c.txt\"])\r\n\u001b[?2004l\r"]
[5515.731772, "o", "\u001b[?2004h> "]
[5515.732205, "o", "assert [e[\"target\"] for e in affected2[\"rebuild_order\"]] == [\"lib1\", \"mid1\", \"mid2\", \"app\", \"test\"], affected2\r\n\u001b[?2004l\r"]
[5515.732275, "o", "\u001b[?2004h> "]
[5515.732675, "o", "assert [e[\"direct\"] for e in affected2[\"rebuild_order\"]] == [True, False, False, True, False], affected2\r\n\u001b[?2004l\r"]
[5515.732731, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5515.732785, "o", "\u001b[?2004h> "]
[5515.733024, "o", "unknown = run([\"deps\", \"--config\", cfg, \"--affected\", \"missing\"])\r\n\u001b[?2004l\r"]
[5515.733079, "o", "\u001b[?2004h> "]
[5515.733274, "o", "assert unknown == {\"rebuild_order\": []}, unknown\r\n\u001b[?2004l\r"]
[5515.73333, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5515.733383, "o", "> "]
[5515.733614, "o", "missing = run([\"deps\", \"--config\", cfg, \"nope\"], expect_exit=1)\r\n\u001b[?2004l\r"]
[5515.733669, "o", "\u001b[?2004h> "]
[5515.733943, "o", "assert missing == {\"error\": \"target \\\"nope\\\" does not exist\"}, missing\r\n\u001b[?2004l\r"]
[5515.733997, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5515.734051, "o", "> "]
[5515.734377, "o", "missing_why = run([\"deps\", \"--config\", cfg, \"--why\", \"app\", \"nope\"], expect_exit=1)\r\n\u001b[?2004l\r"]
[5515.734433, "o", "\u001b[?2004h> "]
[5515.734741, "o", "assert missing_why == {\"error\": \"target \\\"nope\\\" does not exist\"}, missing_why\r\n\u001b[?2004l\r"]
[5515.734796, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5515.734849, "o", "> "]
