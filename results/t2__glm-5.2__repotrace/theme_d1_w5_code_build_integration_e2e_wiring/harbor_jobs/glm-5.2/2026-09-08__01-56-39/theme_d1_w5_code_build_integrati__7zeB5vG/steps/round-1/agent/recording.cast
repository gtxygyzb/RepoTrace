[3657.25175, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"flag\""]
[3657.251857, "o", "\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"runtime\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\t\"syscall\"\r\n\t\"time\"\r\n\r\n\t\"github.com/BurntSushi/toml\"\r\n)\r\n\r\ntype stringSliceFlag []string\r\n\r\n"]
[3657.251925, "o", "func (s *stringSliceFlag) String() string {\r\n\treturn strings.Join(*s, \",\")\r\n}\r\n\r\nfunc (s *stringSliceFlag) Set(value string) error {\r\n\t*s = append(*s, value)\r\n\treturn nil\r\n}\r\n\r\ntype PipelineConfig struct {\r\n\tName    string   `toml:\"name\"`\r\n\tImports []string `toml:\"imports\"`\r\n}\r\n\r\n"]
[3657.252, "o", "type TargetConfig struct {\r\n\tName         string            `toml:\"name\"`\r\n\tCommand      string            `toml:\"command\"`\r\n\tDependencies []string          `toml:\"dependencies\"`\r\n\tInputs       []string          `toml:\"inputs\"`\r\n\tOutputs      []string          `toml:\"outputs\"`\r\n"]
[3657.252064, "o", "\tEnv          map[string]string `toml:\"env\"`\r\n\tTimeout      int               `toml:\"timeout\"`\r\n}\r\n\r\ntype Config struct {\r\n\tPipeline  PipelineConfig    `toml:\"pipeline\"`\r\n\tTargets   []TargetConfig    `toml:\"targets\"`\r\n\tVariables map[string]string `toml:\"variables\"`\r\n}\r\n\r\ntype CacheEntry struct {\r\n\tCacheKey   string   `json:\"cache_key\"`\r\n\tTargetName string   `json:\"target_name\"`\r\n\tTimestamp  string   `json:\"timestamp\"`\r\n\tOutputs    []string `json:\"outputs\"`\r\n}\r\n\r\ntype BuildTargetReport struct {\r\n\tName       string `json:\"name\"`\r\n"]
[3657.252126, "o", "\tStatus     string `json:\"status\"`\r\n\tCached     bool   `json:\"cached\"`\r\n\tDurationMS int64  `json:\"duration_ms\"`\r\n\tCacheKey   string `json:\"cache_key\"`\r\n}\r\n\r\ntype BuildReport struct {\r\n\tPipeline string              `json:\"pipeline\"`\r\n\tTargets  []BuildTargetReport `json:\"targets\"`\r\n\tSummary  BuildSummary        `json:\"summary\"`\r\n}\r\n\r\n"]
[3657.252186, "o", "type BuildSummary struct {\r\n\tTotal      int   `json:\"total\"`\r\n\tBuilt      int   `json:\"built\"`\r\n\tCached     int   `json:\"cached\"`\r\n\tFailed     int   `json:\"failed\"`\r\n\tSkipped    int   `json:\"skipped\"`\r\n\tDurationMS int64 `json:\"duration_ms\"`\r\n}\r\n\r\ntype StatusTarget struct {\r\n\tName     string `json:\"name\"`\r\n\t"]
[3657.252295, "o", "Cached   bool   `json:\"cached\"`\r\n\tCacheKey string `json:\"cache_key,omitempty\"`\r\n\tCachedAt string `json:\"cached_at,omitempty\"`\r\n}\r\n\r\ntype StatusReport struct {\r\n\tTargets []StatusTarget `json:\"targets\"`\r\n}\r\n\r\ntype execResult struct {\r\n\tname       string\r\n\tstatus     string\r\n\tcached     bool\r\n\tdurationMS int64\r\n\tcacheKey   string\r\n}\r\n"]
[3657.252362, "o", "\r\ntype buildExecutor struct {\r\n\tconfig    *Config\r\n\tconfigDir string\r\n\tcacheDir  string\r\n\tnoCache   bool\r\n"]
[3657.252424, "o", "}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: buildctl <command> [flags]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tswitch os.Args[1] {\r\n\tcase \"build\":\r\n\t\trunBuildCommand(os.Args[2:])\r\n\tcase \"graph\":\r\n\t\trunGraphCommand(os.Args[2:])\r\n\tcase \"clean\":\r\n\t\trunCleanCommand(os.Args[2:])\r\n\tcase \"status\":\r\n\t"]
[3657.252495, "o", "\trunStatusCommand(os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command %q\\n\", os.Args[1])\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc runBuildCommand(args []string) {\r\n\tfs := flag.NewFlagSet(\"build\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n"]
[3657.252555, "o", "\ttargetsFlag := fs.String(\"targets\", \"\", \"comma-separated target names\")\r\n\tparallel := fs.Int(\"parallel\", runtime.NumCPU(), \"max concurrent target executions\")\r\n\tnoCache := fs.Bool(\"no-cache\", false, \"skip all cache lookups\")\r\n\treportPath := fs.String(\"report\", \"\", \"also write JSON report to this file\")\r\n"]
[3657.253181, "o", "\u001b[?2004h"]
[3657.25325, "o", "root@n30009:/app# "]
