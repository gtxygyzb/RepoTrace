[1951.985063, "o", "\t\treadyCh := make(chan *TargetConfig, total+1)\r\n   237\t\tresultCh := make(chan execResult, total+1)\r\n   238\t\r\n   239\t\tvar wg sync.WaitGroup\r\n"]
[1951.9851, "o", "   240\t\tfor i := 0; i < parallel; i++ {\r\n   241\t\t\twg.Add(1)\r\n   242\t\t\tgo func() {\r\n   243\t\t\t\tdefer wg.Done()\r\n   244\t\t\t\tfor t := range readyCh {\r\n   245\t\t\t\t\tresultCh <- executor.execute(t)\r\n   246\t\t\t\t}\r\n   247\t\t\t}()\r\n   248"]
[1951.985135, "o", "\t\t}\r\n   249\t\r\n   250\t\tbuildStart := time.Now()\r\n   251\t\tfor i := range cfg.Targets {\r\n   252\t\t\tt := &cfg.Targets[i]\r\n   253\t\t\tif requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {\r\n"]
[1951.985171, "o", "   254\t\t\t\treadyCh <- t\r\n   255\t\t\t}\r\n   256\t\t}\r\n   257\t\r\n   258\t\tfor completed < total {\r\n   259\t\t\tres := <-resultCh\r\n"]
[1951.985217, "o", "   260\t\t\tstatus[res.name] = res.status\r\n   261\t\t\tdurations[res.name] = res.durationMS\r\n   262\t\t\tif res.cacheKey != \"\" {\r\n   263\t\t\t\tcacheKeys[res.name] = res.cacheKey\r\n   264\t\t\t}\r\n   265\t\t\tcompleted++\r\n"]
[1951.985257, "o", "   266\t\r\n   267\t\t\tif res.status == \"built\" || res.status == \"cached\" {\r\n   268\t"]
[1951.985265, "o", "\t\t\tfor _, dependent := range reverseDeps[res.name] {"]
