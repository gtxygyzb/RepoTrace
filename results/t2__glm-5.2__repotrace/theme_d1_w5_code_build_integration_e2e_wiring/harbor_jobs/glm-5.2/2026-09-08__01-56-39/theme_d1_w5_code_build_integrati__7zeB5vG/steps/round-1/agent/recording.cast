[3667.75999, "o", "\tif os.IsNotExist(err) {\r\n   913\t\t\treturn CacheEntry{}, false, nil\r\n   914\t\t}\r\n   915\t\tif err != nil {\r\n   916\t\t\treturn CacheEntry{}, false, err\r\n   917\t\t}\r\n   918\t\tvar entry CacheEntry\r\n   919\t\tif err := json.Unmarshal(data, &entry); err != nil {\r\n   920\t\t\treturn CacheEntry{}, false, nil\r\n   921\t\t}\r\n   922\t\tif entry.CacheKey != \"\" && entry.CacheKey != key {\r\n   923\t\t\treturn CacheEntry{}, false, nil\r\n   924\t\t}\r\n"]
[3667.760057, "o", "   925\t\tif entry.CacheKey == \"\" {\r\n   926\t\t\tentry.CacheKey = key\r\n   927\t\t}\r\n   928\t\treturn entry, true, nil\r\n   929\t}\r\n   930\t\r\n   931\tfunc writeCacheEntry(cacheDir string, entry CacheEntry) error {\r\n   932\t\tif err := os.MkdirAll(cacheDir, 0755); err != nil {\r\n   933\t\t\treturn err\r\n   934\t\t}\r\n   935\t\tdata, err := json.MarshalIndent(entry, \"\", \"  \")\r\n   936\t\tif err != nil {\r\n"]
[3667.760122, "o", "   937\t\t\treturn err\r\n   938\t\t}\r\n   939\t\treturn os.WriteFile(filepath.Join(cacheDir, entry.CacheKey+\".json\"), data, 0644)\r\n   940\t}\r\n   941\t\r\n   942\tfunc hashFile(path string) (string, error) {\r\n   943\t\tf, err := os.Open(path)\r\n   944\t\tif err != nil {\r\n   945\t\t\treturn \"\", err\r\n   946\t\t}\r\n   947\t\tdefer f.Close()\r\n   948\t\th := sha256.New()\r\n   949\t\t"]
[3667.760188, "o", "if _, err := io.Copy(h, f); err != nil {\r\n   950\t\t\treturn \"\", err\r\n   951\t\t}\r\n   952\t\treturn hex.EncodeToString(h.Sum(nil)), nil\r\n   953\t}\r\n   954\t\r\n   955\tfunc hashBytes(b []byte) string {\r\n   956\t\ts := sha256.Sum256(b)\r\n   957\t\treturn hex.EncodeToString(s[:])\r\n   958\t}\r\n   959\t\r\n"]
