[8080.00623, "o", "# Add Retry field to TargetConfig.\r\n\u001b[?2004l\r"]
[8080.00629, "o", "\u001b[?2004h"]
[8080.006346, "o", "> "]
[8080.007015, "o", "s = re.sub(r'(Timeout\\s+int\\s+`toml:\"timeout\"`\\n)(\\s+Matrix)', r'\\1\\tRetry int `toml:\"retry\"`\\n\\2', s)\r\n\u001b[?2004l\r"]
[8080.007076, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8080.007131, "o", "\u001b[?2004h> "]
[8080.007416, "o", "# Add Attempts to BuildTargetReport.\r\n\u001b[?2004l\r"]
[8080.007478, "o", "\u001b[?2004h> "]
[8080.008247, "o", "s = re.sub(r'(CacheKey\\s+string\\s+`json:\"cache_key\"`\\n)(\\s+)\\}', r'\\1\\tAttempts int `json:\"attempts\"`\\n\\2}', s)\r\n\u001b[?2004l\r"]
[8080.008311, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
