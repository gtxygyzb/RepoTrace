[1943.493885, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"os/exec\"\r\n"]
[1943.494016, "o", "\t\"path/filepath\"\r\n\t\"runtime\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\t\"syscall\"\r\n\t\"time\"\r\n\r\n\t\"github.com/BurntSushi/toml\"\r\n)\r\n\r\ntype PipelineConfig struct {\r\n\tName string `toml:\"name\"`\r\n}\r\n\r\ntype TargetConfig struct {\r\n\tName         string            `toml:\"name\"`\r\n\tCommand      string            `toml:\"command\"`\r\n\tDependencies []string          `toml:\"dependencies\"`\r\n\tInputs       []string          `toml:\"inputs\"`\r\n\tOutputs      []string          `toml:\"outputs\"`\r\n\tEnv          map[string]string `toml:\"env\"`\r\n\tTimeout      int               `toml:\"timeout\"`\r\n}\r\n"]
[1943.494141, "o", "\r\ntype Config struct {\r\n\tPipeline PipelineConfig `toml:\"pipeline\"`\r\n\tTargets  []TargetConfig `toml:\"targets\"`\r\n}\r\n\r\ntype CacheEntry struct {\r\n\tCacheKey   string   `json:\"cache_key\"`\r\n\tTargetName string   `json:\"target_name\"`\r\n\tTimestamp  string   `json:\"timestamp\"`\r\n\tOutputs    []string `json:\"outputs\"`\r\n}\r\n\r\ntype BuildTargetReport struct {\r\n\tName       string `json:\"name\"`\r\n\tStatus     string `json:\"status\"`\r\n\tCached     bool   `json:\"cached\"`\r\n\tDurationMS int64  `json:\"duration_ms\"`\r\n\tCacheKey   string `json:\"cache_key\"`\r\n}\r\n\r\n"]
[1943.494248, "o", "type BuildReport struct {\r\n\tPipeline string              `json:\"pipeline\"`\r\n\tTargets  []BuildTargetReport `json:\"targets\"`\r\n\tSummary  BuildSummary        `json:\"summary\"`\r\n}\r\n\r\ntype BuildSummary struct {\r\n\tTotal      int   `json:\"total\"`\r\n\tBuilt      int   `json:\"built\"`\r\n\tCached     int   `json:\"cached\"`\r\n\tFailed     int   `json:\"failed\"`\r\n\tSkipped    int   `json:\"skipped\"`\r\n\tDurationMS int64 `json:\"duration_ms\"`\r\n}\r\n\r\ntype StatusTarget struct {\r\n\t"]
[1943.494323, "o", "Name     string `json:\"name\"`\r\n\tCached   bool   `json:\"cached\"`\r\n\tCacheKey string `json:\"cache_key,omitempty\"`\r\n\tCachedAt string `json:\"cached_at,omitempty\"`\r\n}\r\n\r\ntype StatusReport struct {\r\n\tTargets []StatusTarget `json:\"targets\"`\r\n}\r\n\r\ntype execResult struct {\r\n\tname       string\r\n\tstatus     string\r\n\tcached     bool\r\n\tdurationMS int64\r\n\tcacheKey   string\r\n}\r\n\r\n"]
[1943.494412, "o", "type buildExecutor struct {\r\n\tconfig    *Config\r\n\tconfigDir string\r\n\tcacheDir  string\r\n\tnoCache   bool\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: buildctl <command> [flags]\")\r\n\t\tos.Exit(1)\r\n"]
[1943.49448, "o", "\t}\r\n\tswitch os.Args[1] {\r\n\tcase \"build\":\r\n\t\trunBuildCommand(os.Args[2:])\r\n\tcase \"graph\":\r\n\t\trunGraphCommand(os.Args[2:])\r\n\tcase \"clean\":\r\n\t\trunCleanCommand(os.Args[2:])\r\n\tcase \"status\":\r\n\t\trunStatusCommand(os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command %q\\n\", os.Args[1])\r\n\t\tos.Exit(1)\r\n"]
[1943.494579, "o", "\t}\r\n}\r\n\r\nfunc runBuildCommand(args []string) {\r\n\tfs := flag.NewFlagSet(\"build\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n"]
[1943.494647, "o", "\ttargetsFlag := fs.String(\"targets\", \"\", \"comma-separated target names\")\r\n\tparallel := fs.Int(\"parallel\", runtime.NumCPU(), \"max concurrent target executions\")\r\n\tnoCache := fs.Bool(\"no-cache\", false, \"skip all cache lookups\")\r\n\treportPath := fs.String(\"report\", \"\", \"also write JSON report to this file\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif *configPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif *parallel < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --parallel must be at least 1\")\r\n\t\tos.Exit(1)\r\n"]
[1943.494732, "o", "\t}\r\n\tif err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[1943.494801, "o", "}\r\n\r\nfunc runGraphCommand(args []string) {\r\n\tfs := flag.NewFlagSet(\"graph\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif *configPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif err := runGraph(*configPath); err != nil {\r\n\t\t"]
[1943.494868, "o", "fmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc runCleanCommand(args []string) {\r\n\tfs := flag.NewFlagSet(\"clean\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif *configPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n"]
[1943.494938, "o", "\t\tos.Exit(1)\r\n\t}\r\n\tif err := runClean(*configPath); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc runStatusCommand(args []string) {\r\n\tfs := flag.NewFlagSet(\"status\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n"]
[1943.495009, "o", "\tif err := fs.Parse(args); err != nil {\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif *configPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif err := runStatus(*configPath); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[1943.495115, "o", "}\r\n\r\nfunc runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string) error {\r\n\tcfg, configDir, err := loadConfig(configPath)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\ttargetMap, err := validateConfig(cfg)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\trequested, err := selectTargets(cfg, targetMap, targetsFlag)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\torder := topologicalOrder(cfg, requested)\r\n"]
[1943.495218, "o", "\treverseDeps := buildReverseDeps(cfg, requested)\r\n\r\n\tcacheKeys := make(map[string]string)\r\n\tfor i := range cfg.Targets {\r\n\t\tt := &cfg.Targets[i]\r\n\t\tif !requested[t.Name] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tkey, err := computeCacheKey(t, configDir)\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n"]
[1943.495922, "o", "\u001b[?2004h"]
[1943.495988, "o", "root@n30009:/app# "]
[1943.768678, "i", "sed -n '221,520p' main.go\n"]
[1943.768933, "o", "sed -n '221,520p' main.go\r\n"]
[1943.769025, "o", "\u001b[?2004l\r"]
[1943.771874, "o", "\t\t}\r\n\t\tcacheKeys[t.Name] = key\r\n\t}\r\n\r\n\texecutor := &buildExecutor{\r\n\t\tconfig:    cfg,\r\n"]
[1943.771947, "o", "\t\tconfigDir: configDir,\r\n\t\tcacheDir:  filepath.Join(configDir, \".buildctl-cache\"),\r\n\t\tnoCache:   noCache,\r\n\t}\r\n\r\n\tstatus := make(map[string]string)\r\n\tdurations := make(map[string]int64)\r\n\tcompleted := 0\r\n\ttotal := len(requested)\r\n\treadyCh := make(chan *TargetConfig, total+1)\r\n\tresultCh := make(chan execResult, total+1)\r\n"]
