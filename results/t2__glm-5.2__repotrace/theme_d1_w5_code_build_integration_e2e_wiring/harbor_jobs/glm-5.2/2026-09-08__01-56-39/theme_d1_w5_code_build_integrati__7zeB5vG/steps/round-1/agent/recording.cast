[7094.743431, "o", "   483\tfunc loadConfig(path string, varOverrides []string) (*Config, string, error) {\r\n   484\t\tabs, err := filepath.Abs(path)\r\n   485\t\tif err != nil {\r\n   486\t\t\treturn nil, \"\", err\r\n   487\t\t}\r\n   488\t\toverrides, err := parseVarOverrides(varOverrides)\r\n   489\t\tif err != nil {\r\n   490\t\t\treturn nil, \"\", err\r\n   491\t\t}\r\n"]
