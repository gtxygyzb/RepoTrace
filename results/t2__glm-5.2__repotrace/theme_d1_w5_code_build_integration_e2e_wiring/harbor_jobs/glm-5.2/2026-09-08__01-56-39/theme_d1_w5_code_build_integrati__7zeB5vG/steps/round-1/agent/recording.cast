[4511.023629, "o", "   420\tfunc loadConfig(path string, varOverrides []string) (*Config, string, error) {\r\n   421\t\tabs, err := filepath.Abs(path)\r\n   422\t\tif err != nil {\r\n   423\t\t\treturn nil, \"\", err\r\n"]
[4511.023713, "o", "   424\t\t}\r\n   425\t\toverrides, err := parseVarOverrides(varOverrides)\r\n   426\t\tif err != nil {\r\n   427\t\t\treturn nil, \"\", err\r\n   428\t\t}\r\n   429\t\tloader := &configLoader{\r\n   430\t\t\tvariables:   make(map[string]string),\r\n   431\t\t\ttargetNames: make(map[string]bool),\r\n   432\t\t}\r\n   433\t\tfor k, v := range overrides {\r\n   434\t\t\tloader.variables[k] = v\r\n   435\t\t}\r\n   436\t\t"]
[4511.023777, "o", "if err := loader.loadFile(abs, true); err != nil {\r\n   437\t\t\treturn nil, \"\", err\r\n   438\t\t}\r\n   439\t\tfor i := range loader.targets {\r\n   440\t\t\tt := &loader.targets[i]\r\n   441\t\t\texpanded, err := expandString(t.Command, loader.variables, make(map[string]bool))\r\n   442\t\t\tif err != nil {\r\n   443\t\t\t\treturn nil, \"\", err\r\n"]
[4511.023859, "o", "   444\t\t\t}\r\n   445\t\t\tt.Command = expanded\r\n   446\t\t\tfor j, p := range t.Inputs {\r\n   447\t\t\t\texpanded, err := expandString(p, loader.variables, make(map[string]bool))\r\n   448\t\t\t\tif err != nil {\r\n   449\t\t\t\t\treturn nil, \"\", err\r\n   450\t\t"]
[4511.02406, "o", "\t\t}\r\n   451\t\t\t\tt.Inputs[j] = expanded\r\n   452\t\t\t}\r\n   453\t\t\tfor j, p := range t.Outputs {\r\n   454\t\t\t\texpanded, err := expandString(p, loader.variables, make(map[string]bool))\r\n   455\t\t\t\tif err != nil {\r\n   456\t\t\t\t\treturn nil, \"\", err\r\n   457\t\t\t\t}\r\n   458\t\t\t\tt.Outputs[j] = expanded\r\n   459\t\t\t}\r\n   460\t\t\tt.Dependencies = uniqueStrings(t.Dependencies)\r\n"]
[4511.024159, "o", "   461\t\t\tif t.Timeout <= 0 {\r\n   462\t\t\t\tt.Timeout = 300\r\n   463\t\t\t}\r\n   464\t\t}\r\n   465\t\tcfg := &Config{\r\n   466\t\t\tPipeline:  PipelineConfig{Name: loader.pipelineName, Imports: loader.rootImports},\r\n   467\t\t\tTargets:   loader.targets,\r\n   468\t\t\tVariables: loader.variables,\r\n   469\t\t}\r\n   470\t\treturn cfg, filepath.Dir(abs), nil\r\n   471\t}\r\n   472\t\r\n   473\ttype configLoader struct {\r\n   474\t\tpipelineName string\r\n   475\t\trootImports  []string\r\n   476\t\tvariables    map[string]string\r\n   477\t\ttargets      []TargetConfig\r\n   478\t\ttargetNames  map[string]bool\r\n   479\t\timportStack  []string\r\n   480\t}\r\n   481\t\r\n   482\tfunc (l *configLoader) loadFile(absPath string, isRoot bool) error {\r\n   483\t\tfor _, p := range l.importStack {\r\n   484\t\t\tif p == absPath {\r\n   485\t\t\t\tchain := append([]string{}, l.importStack...)\r\n   486\t\t\t\tchain = append(chain, absPath)\r\n   487\t\t\t\treturn fmt.Errorf(\"circular import detected: %s\", strings.Join(chain, \" -> \"))\r\n   488\t\t\t}\r\n   489\t\t}\r\n   490\t\tl.importStack = append(l.importStack, absPath)\r\n"]
[4511.024269, "o", "   491\t\tdefer func() { l.importStack = l.importStack[:len(l.importStack)-1] }()\r\n   492\t\r\n   493\t\tvar fileCfg Config\r\n   494\t\tif _, err := toml.DecodeFile(absPath, &fileCfg); err != nil {\r\n   495\t\t\treturn err\r\n   496\t\t}\r\n   497\t\r\n   498\t\tif isRoot {\r\n   499\t\t\tl.pipelineName = fileCfg.Pipeline.Name\r\n   500\t\t\tl.rootImports = fileCfg.Pipeline.Imports\r\n   501\t\t}\r\n   502\t\r\n   503\t\tfor k, v := range fileCfg.Variables {\r\n   504\t\t\tif _, exists := l.variables[k]; !exists {\r\n   505\t\t\t\tl.variables[k] = v\r\n   506\t\t\t}\r\n   507\t\t}\r\n   508"]
[4511.024343, "o", "\t\r\n   509\t\tfor _, imp := range fileCfg.Pipeline.Imports {\r\n   510\t\t\texpanded, err := expandString(imp, l.variables, make(map[string]bool))\r\n   511\t\t\tif err != nil {\r\n   512\t\t\t\treturn err\r\n   513\t\t\t}\r\n   514\t\t\timportPath := expanded\r\n   515\t\t\tif !filepath.IsAbs(importPath) {\r\n   516\t\t\t\timportPath = filepath.Join(filepath.Dir(absPath), importPath)\r\n"]
[4511.024422, "o", "   517\t\t\t}\r\n   518\t\t\timportAbs, err := filepath.Abs(importPath)\r\n   519\t\t\tif err != nil {\r\n   520\t\t\t\treturn err\r\n   521\t\t\t}\r\n   522\t\t\tif err := l.loadFile(importAbs, false); err != nil {\r\n   523\t\t\t\treturn err\r\n   524\t\t\t}\r\n   525\t\t}\r\n   526\t\r\n   527\t\tfor _, t := range fileCfg.Targets {\r\n   528"]
[4511.024482, "o", "\t\t\tif l.targetNames[t.Name] {\r\n   529\t\t\t\treturn fmt.Errorf(\"duplicate target name %q\", t.Name)\r\n   530\t\t\t}\r\n   531\t\t\tl.targetNames[t.Name] = true\r\n   532\t\t\tl.targets = append(l.targets, t)\r\n   533\t\t}\r\n   534\t\r\n   535\t\t"]
[4511.024544, "o", "return nil\r\n   536\t}\r\n   537\t\r\n   538\tfunc parseVarOverrides(vars []string) (map[string]string, error) {\r\n   539\t\tm := make(map[string]string)\r\n   540\t\tfor _, v := range vars {\r\n   541\t\t\tidx := strings.Index(v, \"=\")\r\n   542\t\t\tif idx == -1 {\r\n   543\t\t\t\treturn nil, fmt.Errorf(\"invalid --var %q, expected key=value\", v)\r\n   544\t\t\t}\r\n   545\t\t"]
[4511.024602, "o", "\tkey := v[:idx]\r\n   546\t\t\tif key == \"\" {\r\n   547\t\t\t\treturn nil, fmt.Errorf(\"invalid --var %q, empty key\", v)\r\n   548\t\t\t}\r\n   549\t\t\tm[key] = v[idx+1:]\r\n   550\t\t}\r\n   551\t\treturn m, nil\r\n   552\t}\r\n   553\t\r\n"]
[4511.02466, "o", "   554\tfunc expandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {\r\n   555\t\tvar b strings.Builder\r\n   556\t\ti := 0\r\n   557\t\tfor i < len(s) {\r\n   558\t\t\tif i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {\r\n   559\t\t\t\tend := strings.Index(s[i:], \"}\")\r\n   560\t\t\t\tif end == -1 {\r\n   561\t\t\t\t\treturn \"\", fmt.Errorf(\"unterminated variable reference in %q\", s)\r\n"]
[4511.024722, "o", "   562\t\t\t\t}\r\n   563\t\t\t\tname := s[i+2 : i+end]\r\n   564\t\t\t\tif name == \"\" {\r\n   565\t\t\t\t\treturn \"\", fmt.Errorf(\"empty variable reference in %q\", s)\r\n   566\t\t\t\t}\r\n   567\t\t\t\tif visiting[name] {\r\n   568\t\t\t\t\treturn \"\", fmt.Errorf(\"variable cycle detected: %q\", name)\r\n   569\t\t"]
[4511.024779, "o", "\t\t}\r\n   570\t\t\t\tval, ok := vars[name]\r\n   571\t\t\t\tif !ok {\r\n   572\t\t\t\t\treturn \"\", fmt.Errorf(\"unresolved variable %q\", name)\r\n   573\t\t\t\t}\r\n   574\t\t\t\t"]
[4511.024837, "o", "visiting[name] = true\r\n   575\t\t\t\texpanded, err := expandString(val, vars, visiting)\r\n   576\t\t\t\tif err != nil {\r\n   577\t\t\t\t\treturn \"\", err\r\n   578\t\t\t\t}\r\n   579\t\t\t\tdelete(visiting, name)\r\n   580\t\t\t\tb.WriteString(expanded)\r\n"]
