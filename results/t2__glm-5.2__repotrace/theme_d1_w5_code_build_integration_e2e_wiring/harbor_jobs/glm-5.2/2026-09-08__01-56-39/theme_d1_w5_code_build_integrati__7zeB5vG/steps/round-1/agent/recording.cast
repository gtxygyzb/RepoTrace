[3912.637398, "o", "func (e *buildExecutor) execute(t *TargetConfig) execResult {\r\n\tstart := time.Now()\r\n\tkey, err := computeCacheKey(t, e.configDir)\r\n\tif err != nil {\r\n"]
[3912.637478, "o", "\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\t}\r\n\r\n\tif !e.noCache {\r\n\t\tvalid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)\r\n\t\tif err != nil {\r\n\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\t\t}\r\n\t\tif valid {"]
[3912.637559, "o", "\r\n\t\t\treturn execResult{name: t.Name, status: \"cached\", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\t\t}\r\n\t}\r\n\r\n\ttimeout := t.Timeout\r\n\tif timeout <= 0 {\r\n\t\ttimeout = 300\r\n"]
[3912.637621, "o", "\t}\r\n\tdeadline := time.Now().Add(time.Duration(timeout) * time.Second)\r\n\r\n\tbaseEnv := mergedEnv(t.Env)\r\n\tpreEnv := append([]string(nil), baseEnv...)\r\n\r\n\tfor _, hook := range t.PreBuild {\r\n\t\t"]
[3912.63768, "o", "stdout, err := e.runCommand(t, hook, preEnv, deadline)\r\n\t\tif err != nil {\r\n\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\t\t}\r\n\t\tpreEnv = mergeHookExports(preEnv, parseHookExports(stdout))\r\n\t}\r\n\r\n"]
[3912.63774, "o", "\tmainEnv := preEnv\r\n\tif _, err := e.runCommand(t, t.Command, mainEnv, deadline); err != nil {\r\n\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\t}\r\n\r\n\tpostEnv := append([]string(nil), baseEnv...)\r\n"]
[3912.637801, "o", "\tfor _, hook := range t.PostBuild {\r\n\t\tstdout, err := e.runCommand(t, hook, postEnv, deadline)\r\n\t\tif err != nil {\r\n\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\t\t}\r\n"]
[3912.637859, "o", "\t\tpostEnv = mergeHookExports(postEnv, parseHookExports(stdout))\r\n\t}\r\n\r\n\telapsed := time.Since(start).Milliseconds()\r\n\tentry := CacheEntry{\r\n\t\tCacheKey:   key,\r\n"]
[3912.637923, "o", "\t\tTargetName: t.Name,\r\n\t\tTimestamp:  time.Now().UTC().Format(time.RFC3339),\r\n\t\tOutputs:    t.Outputs,\r\n\t}\r\n\tif err := writeCacheEntry(e.cacheDir, entry); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[3912.637983, "o", "\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: elapsed, cacheKey: key}\r\n\t}\r\n\treturn execResult{name: t.Name, status: \"built\", durationMS: elapsed, cacheKey: key}\r\n}\r\n\r\n"]
[3912.638047, "o", "func (e *buildExecutor) runCommand(t *TargetConfig, command string, env []string, deadline time.Time) (string, error) {\r\n\tif strings.TrimSpace(command) == \"\" {\r\n\t\treturn \"\", nil\r\n\t}\r\n\tremaining := time.Until(deadline)\r\n\tif remaining <= 0 {\r\n\t\t"]
[3912.638108, "o", "return \"\", fmt.Errorf(\"target %q timed out after %ds\", t.Name, t.Timeout)\r\n\t}\r\n\r\n\tvar stdout, stderr bytes.Buffer\r\n\tctx, cancel := context.WithTimeout(context.Background(), remaining)\r\n\tdefer cancel()\r\n\tcmd := exec.CommandContext(ctx, \"sh\", \"-c\", command)\r\n\t"]
[3912.638174, "o", "cmd.Dir = e.configDir\r\n\tcmd.Env = env\r\n\tcmd.Stdout = &stdout\r\n\tcmd.Stderr = &stderr\r\n"]
[3912.638246, "o", "\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\r\n\r\n"]
