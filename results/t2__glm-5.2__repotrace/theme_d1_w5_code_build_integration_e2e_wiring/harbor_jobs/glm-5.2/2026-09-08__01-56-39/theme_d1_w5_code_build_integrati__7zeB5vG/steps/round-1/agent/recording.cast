[3676.659177, "o", "   755\tfunc markSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {\r\n   756\t\tfor _, dependent := range reverseDeps[name] {\r\n   757\t\t\tif status[dependent] == \"\" {\r\n   758\t\t\t\tstatus[dependent] = \"skipped\"\r\n   759\t\t\t\tdurations[dependent] = 0\r\n   760\t\t\t\t*completed++\r\n"]
[3676.65926, "o", "   761\t\t\t\tmarkSkipped(reverseDeps, status, durations, completed, dependent)\r\n   762\t\t\t}\r\n   763\t\t}\r\n   764\t}\r\n   765\t\r\n   766\tfunc (e *buildExecutor) execute(t *TargetConfig) execResult {\r\n   767\t\tstart := time.Now()\r\n"]
[3676.659322, "o", "   768\t\tkey, err := computeCacheKey(t, e.configDir)\r\n   769\t\tif err != nil {\r\n   770\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n   771\t\t}\r\n   772\t\r\n   773\t\tif !e.noCache {\r\n"]
[3676.659383, "o", "   774\t\t\tvalid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)\r\n   775\t\t\tif err != nil {\r\n   776\t\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n   777\t\t\t}\r\n   778\t\t\tif valid {\r\n"]
[3676.659445, "o", "   779\t\t\t\treturn execResult{name: t.Name, status: \"cached\", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n   780\t\t\t}\r\n   781\t\t}\r\n   782\t\r\n   783\t\ttimeout := t.Timeout\r\n"]
[3676.659502, "o", "   784\t\tif timeout <= 0 {\r\n   785\t\t\ttimeout = 300\r\n   786\t\t}\r\n   787\t\r\n   788\t\tvar stdout, stderr bytes.Buffer\r\n"]
[3676.659563, "o", "   789\t\tcmd := exec.Command(\"sh\", \"-c\", t.Command)\r\n   790\t\tcmd.Dir = e.configDir\r\n   791\t\tcmd.Env = mergedEnv(t.Env)\r\n   792\t\tcmd.Stdout = &stdout\r\n   793\t\tcmd.Stderr = &stderr\r\n   794\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\r\n"]
[3676.659619, "o", "   795\t\r\n   796\t\tif err := cmd.Start(); err != nil {\r\n   797\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n   798\t\t}\r\n   799\t\r\n"]
[3676.659679, "o", "   800\t\twaitCh := make(chan error, 1)\r\n   801\t\tgo func() {\r\n   802\t\t\twaitCh <- cmd.Wait()\r\n   803\t\t}()\r\n   804\t\r\n   805\t\tvar runErr error\r\n"]
[3676.659741, "o", "   806\t\tselect {\r\n   807\t\tcase <-time.After(time.Duration(timeout) * time.Second):\r\n   808\t\t\tif cmd.Process != nil {\r\n   809\t\t\t\t_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\r\n   810\t\t\t}\r\n   811\t\t\t<-waitCh\r\n"]
[3676.659801, "o", "   812\t\t\trunErr = fmt.Errorf(\"target %q timed out after %ds\", t.Name, timeout)\r\n   813\t\tcase err := <-waitCh:\r\n   814\t\t\tif err != nil {\r\n   815\t\t\t\trunErr = err\r\n   816\t\t\t}\r\n   817\t\t}\r\n"]
[3676.659859, "o", "   818\t\r\n   819\t\telapsed := time.Since(start).Milliseconds()\r\n   820\t\tif runErr != nil {\r\n   821\t\t\tif stderr.Len() > 0 {\r\n   822\t\t\t\tfmt.Fprintf(os.Stderr, \"target %q stderr:\\n%s\", t.Name, stderr.String())\r\n"]
[3676.659915, "o", "   823\t\t\t}\r\n   824\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: elapsed, cacheKey: key}\r\n   825\t\t}\r\n   826\t\r\n   827\t\tentry := CacheEntry{\r\n"]
[3676.659975, "o", "   828\t\t\tCacheKey:   key,\r\n   829\t\t\tTargetName: t.Name,\r\n   830\t\t\tTimestamp:  time.Now().UTC().Format(time.RFC3339),\r\n   831\t\t\tOutputs:    t.Outputs,\r\n   832\t\t}\r\n"]
[3676.660034, "o", "   833\t\tif err := writeCacheEntry(e.cacheDir, entry); err != nil {\r\n   834\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   835\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: elapsed, cacheKey: key}\r\n   836\t\t}\r\n   837\t\treturn execResult{name: t.Name, status: \"built\", durationMS: elapsed, cacheKey: key}\r\n   838\t}\r\n"]
[3676.660096, "o", "   839\t\r\n   840\tfunc computeCacheKey(t *TargetConfig, configDir string) (string, error) {\r\n"]
