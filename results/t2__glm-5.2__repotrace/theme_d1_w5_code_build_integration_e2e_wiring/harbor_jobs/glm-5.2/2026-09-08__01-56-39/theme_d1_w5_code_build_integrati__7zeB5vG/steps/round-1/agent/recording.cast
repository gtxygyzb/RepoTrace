[3676.658867, "o", "\tfunc buildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {\r\n   728\t\treverse := map[string][]string{}\r\n   729\t\tfor _, t := range cfg.Targets {\r\n   730\t\t\tif !requested[t.Name] {\r\n   731\t\t\t\tcontinue\r\n   732\t\t\t}\r\n   733"]
