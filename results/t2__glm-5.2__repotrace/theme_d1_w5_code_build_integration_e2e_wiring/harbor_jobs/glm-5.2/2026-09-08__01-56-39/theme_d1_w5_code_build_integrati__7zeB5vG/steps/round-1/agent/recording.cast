[6538.143803, "o", "\r\n\tstatus := make(map[string]string)\r\n\tdurations := make(map[string]int64)\r\n\tcompleted := 0\r\n\ttotal := len(requested)\r\n\treadyCh := make(chan *TargetConfig, total+1)\r\n\tresultCh := make(chan execResult, total+1)\r\n"]
[6538.143926, "o", "\r\n\tvar mu sync.Mutex\r\n\tstarted := make(map[string]bool)\r\n\tcancelled := false\r\n\r\n\tvar wg sync.WaitGroup\r\n\tfor i := 0; i < parallel; i++ {\r\n\t\twg.Add(1)\r\n\t\tgo func() {\r\n\t\t\tdefer wg.Done()\r\n\t\t\tfor t := range readyCh {\r\n\t\t\t\tmu.Lock()\r\n\t\t\t\tif cancelled {\r\n\t\t\t\t\tmu.Unlock()\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tstarted[t.Name] = true\r\n\t\t\t\tmu.Unlock()\r\n\t\t\t\tres := executor.execute(t)\r\n"]
[6538.144015, "o", "\t\t\t\tif res.status == \"failed\" && !keepGoing {\r\n\t\t\t\t\tmu.Lock()\r\n\t\t\t\t\tcancelled = true\r\n\t\t\t\t\tmu.Unlock()\r\n\t\t\t\t}\r\n\t\t\t\tresultCh <- res\r\n\t\t\t}"]
[6538.144078, "o", "\r\n\t\t}()\r\n\t}\r\n\r\n\tbuildStart := time.Now()\r\n\tfor i := range cfg.Targets {\r\n\t\tt := &cfg.Targets[i]\r\n\t\tif requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {\r\n\t\t\treadyCh <- t\r\n\t\t}\r\n\t}\r\n\r\n\tfor completed < total {\r\n\t\tres := <-resultCh\r\n\t\tstatus[res.name] = res.status\r\n\t\tdurations[res.name] = res.durationMS\r\n\t\tif res.cacheKey != \"\" {\r\n"]
[6538.14414, "o", "\t\t\tcacheKeys[res.name] = res.cacheKey\r\n\t\t}\r\n\t\tcompleted++\r\n\r\n\t\tif res.status == \"built\" || res.status == \"cached\" {\r\n\t\t\tmu.Lock()\r\n\t\t\tcanSchedule := !cancelled\r\n\t\t\tmu.Unlock()\r\n\t\t\tif canSchedule {\r\n\t\t\t\tfor _, dependent := range reverseDeps[res.name] {\r\n\t\t\t\t\tif allDependenciesComplete(dependent, targetMap, requested, status) {\r\n"]
[6538.144201, "o", "\t\t\t\t\t\treadyCh <- targetMap[dependent]\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tif res.status == \"failed\" {\r\n\t\t\tmarkSkipped(reverseDeps, status, durations, &completed, res.name)\r\n\t\t\tif !keepGoing {\r\n"]
[6538.144294, "o", "\t\t\t\tmu.Lock()\r\n\t\t\t\tcancelled = true\r\n\t\t\t\tfor i := range cfg.Targets {\r\n\t\t\t\t\tt := &cfg.Targets[i]\r\n\t\t\t\t\tif !requested[t.Name] {\r\n\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n\t"]
[6538.144361, "o", "\t\t\t\tif status[t.Name] == \"\" && !started[t.Name] {\r\n\t\t\t\t\t\tstatus[t.Name] = \"cancelled\"\r\n\t\t\t\t\t\tdurations[t.Name] = 0\r\n\t\t\t\t\t\tcompleted++\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tmu.Unlock()\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t}\r\n\r\n\tclose(readyCh)\r\n\twg.Wait()\r\n\r\n"]
[6538.144423, "o", "\treport := BuildReport{Pipeline: cfg.Pipeline.Name, Targets: []BuildTargetReport{}}\r\n\tfor _, name := range order {\r\n\t\tst := status[name]\r\n\t\tif st == \"\" {\r\n\t\t\tif keepGoing {\r\n\t\t\t\tst = \"skipped\"\r\n\t\t\t} else {\r\n\t\t\t\tst = \"cancelled\"\r\n\t\t\t}\r\n\t\t}\r\n"]
[6538.144484, "o", "\t\treport.Targets = append(report.Targets, BuildTargetReport{\r\n\t\t\tName:       name,\r\n\t\t\tStatus:     st,\r\n\t\t\tCached:     st == \"cached\",\r\n\t\t\tDurationMS: durations[name],\r\n\t\t\tCacheKey:   cacheKeys[name],\r\n\t\t})\r\n\t}\r\n\r\n\tsummary := BuildSummary{Total: len(report.Targets)}\r\n"]
[6538.14455, "o", "\tfor _, t := range report.Targets {\r\n\t\tswitch t.Status {\r\n\t\tcase \"built\":\r\n\t\t\tsummary.Built++\r\n\t\tcase \"cached\":\r\n\t\t\tsummary.Cached++\r\n\t\tcase \"failed\":\r\n\t\t\tsummary.Failed++\r\n\t\tcase \"skipped\":\r\n"]
[6538.144627, "o", "\t\t\tsummary.Skipped++\r\n\t\tcase \"cancelled\":\r\n\t\t\tsummary.Cancelled++\r\n\t\t}\r\n\t}\r\n\tsummary.DurationMS = time.Since(buildStart).Milliseconds()\r\n\treport.Summary = summary\r\n\r\n\tdata, err := json.MarshalIndent(report, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n"]
[6538.144704, "o", "\tfmt.Println(string(data))\r\n\tif reportPath != \"\" {\r\n\t\tif err := os.WriteFile(reportPath, data, 0644); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\tif summary.Failed > 0 {\r\n\t\treturn fmt.Errorf(\"build failed\")\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n"]
[6538.144784, "o", "func runGraph(configPath string, vars []string) error {\r\n\tcfg, _, err := loadConfig(configPath, vars)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif _, err := validateConfig(cfg); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tfmt.Printf(\"digraph %s {\\n\", strconv.Quote(cfg.Pipeline.Name))\r\n\tfor _, t := range cfg.Targets {\r\n\t\tif len(uniqueStrings(t.Dependencies)) == 0 {\r\n\t\t\tfmt.Printf(\"  %s;\\n\", strconv.Quote(t.Name))\r\n\t\t}\r\n\t}\r\n\tfor _, t := range cfg.Targets {\r\n\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n\t\t\t"]
