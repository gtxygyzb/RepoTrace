[7157.867927, "o", "   958\t\r\n   959\t\tbaseEnv := mergedEnv(t.Env)\r\n   960\t\tpreEnv := append([]string(nil), baseEnv...)\r\n   961\t\r\n   962\t\tfor _, hook := range t.PreBuild {\r\n   963\t\t\tstdout, err := e.runCommand(t, hook, preEnv, deadline)\r\n   964\t\t\tif err != nil {\r\n   965\t\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n   966\t\t\t}\r\n   967\t\t\tpreEnv = mergeHookExports(preEnv, parseHookExports(stdout))\r\n   968\t\t}\r\n   969\t\r\n"]
