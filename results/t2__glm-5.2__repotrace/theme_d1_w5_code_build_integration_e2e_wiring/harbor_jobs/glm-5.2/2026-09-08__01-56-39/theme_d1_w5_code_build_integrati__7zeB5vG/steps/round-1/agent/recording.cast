[6615.461623, "o", "   664\t\tvar stack []string\r\n   665\t\tvar dfs func(name string) error\r\n   666\t\tdfs = func(name string) error {\r\n   667\t\t\tstates[name] = 1\r\n   668\t\t\tstack = append(stack, name)\r\n"]
[6615.461688, "o", "   669\t\t\tfor _, dep := range targetMap[name].Dependencies {\r\n   670\t\t\t\tif states[dep] == 1 {\r\n   671\t\t\t\t\tidx := 0\r\n   672\t\t\t\t\tfor i, s := range stack {\r\n   673\t\t\t\t\t\tif s == dep {\r\n   674\t\t\t\t\t\t\tidx = i\r\n   675\t\t\t\t\t\t\tbreak\r\n   676\t\t\t\t\t\t}\r\n   677\t\t\t\t\t}\r\n   678\t\t\t\t\tcycle := append([]string{}, stack[idx:]...)\r\n"]
[6615.461754, "o", "   679\t\t\t\t\tcycle = append(cycle, dep)\r\n   680\t\t\t\t\treturn fmt.Errorf(\"cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n   681\t\t\t\t}\r\n   682\t\t\t\tif states[dep] == 0 {\r\n   683\t\t\t\t\tif err := dfs(dep); err != nil {\r\n   684\t\t\t\t\t\treturn err\r\n   685\t\t\t\t\t}\r\n   686\t\t\t\t}\r\n   687\t\t\t}\r\n   688\t\t\tstack = stack[:len(stack)-1]\r\n   689\t\t\tstates[name] = 2\r\n   690\t\t\treturn nil\r\n   691"]
[6615.46181, "o", "\t\t}\r\n   692\t\r\n   693\t\tnames := make([]string, 0, len(targetMap))\r\n   694\t\tfor n := range targetMap {\r\n   695\t\t\tnames = append(names, n)\r\n   696\t\t}\r\n   697\t\tsort.Strings(names)\r\n   698\t\tfor _, n := range names {\r\n   699"]
[6615.461866, "o", "\t\t\tif states[n] == 0 {\r\n   700\t\t\t\tif err := dfs(n); err != nil {\r\n   701\t\t\t\t\treturn nil, err\r\n   702\t\t\t\t}\r\n   703\t\t\t}\r\n   704\t\t}\r\n   705\t\treturn targetMap, nil\r\n"]
[6615.461927, "o", "   706\t}\r\n   707\t\r\n   708\tfunc selectTargets(cfg *Config, targetMap map[string]*TargetConfig, targetsFlag string) (map[string]bool, error) {\r\n   709\t\tif strings.TrimSpace(targetsFlag) == \"\" {\r\n   710\t\t\trequested := map[string]bool{}\r\n   711\t\t\tfor _, t := range cfg.Targets {\r\n   712\t\t\t\trequested[t.Name] = true\r\n   713\t\t\t}\r\n   714\t\t\treturn requested, nil\r\n   715\t\t}\r\n   716"]
[6615.461988, "o", "\t\r\n   717\t\trequested := map[string]bool{}\r\n   718\t\tfor _, part := range strings.Split(targetsFlag, \",\") {\r\n   719\t\t\tname := strings.TrimSpace(part)\r\n   720\t\t\tif _, ok := targetMap[name]; !ok {\r\n   721\t\t\t\treturn nil, fmt.Errorf(\"target %q not found\", name)\r\n   722\t\t\t}\r\n   723\t\t\tvar visit func(string)\r\n   724\t\t\tvisit = func(n string) {\r\n"]
[6615.462045, "o", "   725\t\t\t\tif requested[n] {\r\n   726\t\t\t\t\treturn\r\n   727\t\t\t\t}\r\n   728\t\t\t\trequested[n] = true\r\n   729\t\t\t\tfor _, dep := range targetMap[n].Dependencies {\r\n   730\t\t\t\t\tvisit(dep)\r\n   731\t\t\t\t}\r\n"]
[6615.462102, "o", "   732\t\t\t}\r\n   733\t\t\tvisit(name)\r\n   734\t\t}\r\n   735\t\treturn requested, nil\r\n   736\t}\r\n   737\t\r\n   738\tfunc topologicalOrder(cfg *Config, requested map[string]bool) []string {\r\n   739\t\t"]
[6615.462157, "o", "indeg := map[string]int{}\r\n   740\t\tfor _, t := range cfg.Targets {\r\n   741\t\t\tif !requested[t.Name] {\r\n   742\t\t\t\tcontinue\r\n   743\t\t\t}\r\n   744\t\t\tcount := 0\r\n   745\t"]
[6615.462212, "o", "\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n   746\t\t\t\tif requested[dep] {\r\n   747\t\t\t\t\tcount++\r\n   748\t\t\t\t}\r\n   749\t\t\t}\r\n"]
