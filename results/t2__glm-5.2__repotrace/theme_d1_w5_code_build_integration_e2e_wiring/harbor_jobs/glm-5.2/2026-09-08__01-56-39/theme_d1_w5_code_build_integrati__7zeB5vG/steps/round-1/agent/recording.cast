[8096.647127, "o", "type BuildTargetReport struct {\r\n    73\t\tName       string `json:\"name\"`\r\n    74\t\tStatus     string `json:\"status\"`\r\n    75\t\tCached     bool   `json:\"cached\"`\r\n    76\t\tDurationMS int64  `json:\"duration_ms\"`\r\n    77\t\tCacheKey   string `json:\"cache_key\"`\r\n    78\t}\r\n    79\t\r\n    80\ttype BuildReport struct {\r\n    81\t\tPipeline string              `json:\"pipeline\"`\r\n    82\t\tTargets  []BuildTargetReport `json:\"targets\"`\r\n"]
