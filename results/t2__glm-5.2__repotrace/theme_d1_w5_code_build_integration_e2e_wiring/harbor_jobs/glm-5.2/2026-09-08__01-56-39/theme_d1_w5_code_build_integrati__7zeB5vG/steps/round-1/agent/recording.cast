[4510.723954, "o", "\t\t}\r\n   653\t\treturn targetMap, nil\r\n   654\t}\r\n   655\t\r\n   656\tfunc selectTargets(cfg *Config, targetMap map[string]*TargetConfig, targetsFlag string) (map[string]bool, error) {\r\n   657\t\tif strings.TrimSpace(targetsFlag) == \"\" {\r\n   658\t\t\trequested := map[string]bool{}\r\n   659\t\t\tfor _, t := range cfg.Targets {\r\n   660\t\t\t\trequested[t.Name] = true\r\n   661\t\t\t}\r\n"]
