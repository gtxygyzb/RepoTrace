[6578.720853, "o", "   106\t\tcached     bool\r\n   107\t\tdurationMS int64\r\n   108\t\tcacheKey   string\r\n   109\t}\r\n   110\t\r\n   111\ttype buildExecutor struct {\r\n   112\t\tconfig    *Config\r\n   113\t\tconfigDir string\r\n   114\t\tcacheDir  string\r\n   115\t\tnoCache   bool\r\n   116\t}\r\n   117\t\r\n   118\tfunc main() {\r\n"]
[6578.720927, "o", "   119\t\tif len(os.Args) < 2 {\r\n   120\t\t\tfmt.Fprintln(os.Stderr, \"usage: buildctl <command> [flags]\")\r\n   121\t\t\tos.Exit(1)\r\n   122\t\t}\r\n   123\t\tswitch os.Args[1] {\r\n   124\t\tcase \"build\":\r\n   125\t\t\trunBuildCommand(os.Args[2:])\r\n   126\t\tcase \"graph\":\r\n   127\t\t\trunGraphCommand(os.Args[2:])\r\n   128\t\tcase \"clean\":\r\n"]
[6578.720987, "o", "   129\t\t\trunCleanCommand(os.Args[2:])\r\n   130\t\tcase \"status\":\r\n   131\t\t\trunStatusCommand(os.Args[2:])\r\n   132\t\tcase \"deps\":\r\n   133\t\t\trunDepsCommand(os.Args[2:])\r\n   134\t\tdefault:\r\n   135\t\t\tfmt.Fprintf(os.Stderr, \"unknown command %q\\n\", os.Args[1])\r\n   136\t\t\tos.Exit(1)\r\n"]
[6578.721045, "o", "   137\t\t}\r\n   138\t}\r\n   139\t\r\n   140\tfunc runBuildCommand(args []string) {\r\n   141\t\tfs := flag.NewFlagSet(\"build\", flag.ContinueOnError)\r\n   142\t\tfs.SetOutput(os.Stderr)\r\n   143\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   144\t\ttargetsFlag := fs.String(\"targets\", \"\", \"comma-separated target names\")\r\n   145\t\tparallel := fs.Int(\"parallel\", runtime.NumCPU(), \"max concurrent target executions\")\r\n"]
[6578.721103, "o", "   146\t\tnoCache := fs.Bool(\"no-cache\", false, \"skip all cache lookups\")\r\n   147\t\treportPath := fs.String(\"report\", \"\", \"also write JSON report to this file\")\r\n   148\t\tkeepGoing := fs.Bool(\"keep-going\", false, \"continue building independent targets after failures (default fail-fast)\")\r\n   149\t\tvar vars stringSliceFlag\r\n   150\t\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n   151\t\tif err := fs.Parse(args); err != nil {\r\n"]
[6578.721159, "o", "   152\t\t\tos.Exit(1)\r\n   153\t\t}\r\n   154\t\tif *configPath == \"\" {\r\n   155\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n   156\t\t\tos.Exit(1)\r\n   157\t\t}\r\n   158\t\tif *parallel < 1 {\r\n   159"]
[6578.72122, "o", "\t\t\tfmt.Fprintln(os.Stderr, \"error: --parallel must be at least 1\")\r\n   160\t\t\tos.Exit(1)\r\n   161\t\t}\r\n   162\t\tif err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath, []string(vars), *keepGoing); err != nil {\r\n   163\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   164\t\t\tos.Exit(1)\r\n   165\t\t}\r\n   166\t}\r\n   167\t\r\n"]
[6578.721294, "o", "   168\tfunc runGraphCommand(args []string) {\r\n   169\t\tfs := flag.NewFlagSet(\"graph\", flag.ContinueOnError)\r\n   170\t\tfs.SetOutput(os.Stderr)\r\n   171\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   172\t\tvar vars stringSliceFlag\r\n   173\t\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n   174\t\tif err := fs.Parse(args); err != nil {\r\n   175\t\t\tos.Exit(1)\r\n   176\t\t}\r\n   177\t\t"]
