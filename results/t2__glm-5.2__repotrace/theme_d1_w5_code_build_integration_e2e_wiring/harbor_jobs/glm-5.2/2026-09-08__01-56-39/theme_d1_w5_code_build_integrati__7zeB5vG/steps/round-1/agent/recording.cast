[3796.36154, "o", "'''func computeCacheKey(t *TargetConfig, configDir string) (string, error) {''',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.36177, "o", "'''func (e *buildExecutor) runHook(t *TargetConfig, command string, env []string, deadline time.Time) error {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.361859, "o", "\\tif strings.TrimSpace(command) == \"\" {\r\n\u001b[?2004l\r"]
[3796.361913, "o", "\u001b[?2004h> "]
[3796.361937, "o", "\\t\\treturn nil\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[3796.362004, "o", "\u001b[?2004h> "]
[3796.36202, "o", "\\tremaining := time.Until(deadline)\r\n\u001b[?2004l\r"]
[3796.362085, "o", "\u001b[?2004h> "]
[3796.362138, "o", "\\tif remaining <= 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.362249, "o", "\\t\\treturn fmt.Errorf(\"target %q timed out after %ds\", t.Name, t.Timeout)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.362307, "o", "\\t}\r\n\u001b[?2004l\r"]
[3796.362361, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.362415, "o", "\\tvar stdout, stderr bytes.Buffer\r\n\u001b[?2004l\r"]
[3796.362439, "o", "\u001b[?2004h> "]
[3796.36253, "o", "\\tctx, cancel := context.WithTimeout(context.Background(), remaining)\r\n\u001b[?2004l\r"]
[3796.362581, "o", "\u001b[?2004h> "]
[3796.362634, "o", "\\tdefer cancel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.362713, "o", "\\tcmd := exec.CommandContext(ctx, \"sh\", \"-c\", command)\r\n\u001b[?2004l\r"]
[3796.362766, "o", "\u001b[?2004h> "]
[3796.362818, "o", "\\tcmd.Dir = e.configDir\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.362872, "o", "\\tcmd.Env = env\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.362925, "o", "\\tcmd.Stdout = &stdout\r\n\u001b[?2004l\r"]
[3796.362978, "o", "\u001b[?2004h> "]
[3796.36303, "o", "\\tcmd.Stderr = &stderr\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.363083, "o", "\\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\r\n\u001b[?2004l\r"]
[3796.363133, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3796.363177, "o", "\u001b[?2004h> "]
[3796.363239, "o", "\\tif err := cmd.Start(); err != nil {\r\n\u001b[?2004l\r"]
[3796.363295, "o", "\u001b[?2004h> \\t\\treturn err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.36335, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.3634, "o", "\\twaitCh := make(chan error, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.363453, "o", "\\tgo func() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.363502, "o", "\\t\\twaitCh <- cmd.Wait()\r\n\u001b[?2004l\r"]
[3796.363554, "o", "\u001b[?2004h> \\t}()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.363609, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \\tselect {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.363681, "o", "\\tcase <-time.After(time.Until(deadline)):\r\n\u001b[?2004l\r"]
[3796.363731, "o", "\u001b[?2004h> "]
[3796.363784, "o", "\\t\\tif cmd.Process != nil {\r\n\u001b[?2004l\r"]
[3796.363838, "o", "\u001b[?2004h> "]
[3796.363882, "o", "\\t\\t\\t_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\r\n\u001b[?2004l\r"]
[3796.36393, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.363983, "o", "\\t\\t<-waitCh\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.364122, "o", "\\t\\treturn fmt.Errorf(\"target %q timed out after %ds\", t.Name, t.Timeout)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.364185, "o", "\\tcase err := <-waitCh:\r\n\u001b[?2004l\r"]
[3796.426428, "o", "\u001b[?2004h> "]
[3796.426557, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tif stderr.Len() > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t\\tfmt.Fprintf(os.Stderr, \"target %q stderr:\\\\n%s\", t.Name, stderr.String())\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\treturn err\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\treturn nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func computeCacheKey(t *TargetConfig, configDir string) (string, error) {'''\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Replace computeCacheKey\r\n\u001b[?2004l\r\u001b[?2004h> old_cache = '''func computeCacheKey(t *TargetConfig, configDir string) (string, error) {\r\n\u001b[?2004l\r\u001b[?2004h> \\th := sha256.New()\r\n\u001b[?2004l\r\u001b[?2004h> \\tif _, err := io.WriteString(h, t.Command); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\treturn \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \\tenvKeys := make([]string, 0, len(t.Env))\r\n\u001b[?2004l\r\u001b[?2004h> \\tfor k := range t.Env {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tenvKeys = append(envKeys, k)\r\n\u001b[?2"]
[3796.426632, "o", "004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\tsort.Strings(envKeys)\r\n\u001b[?2004l\r\u001b[?2004h> \\tfor _, k := range envKeys {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tif _, err := io.WriteString(h, k+\"=\"+t.Env[k]); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\treturn \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \\tinputPaths := make([]string, len(t.Inputs))\r\n\u001b[?2004l\r\u001b[?2004h> \\tcopy(inputPaths, t.Inputs)\r\n\u001b[?2004l\r\u001b[?2004h> \\tsort.Strings(inputPaths)\r\n\u001b[?2004l\r\u001b[?2004h> \\tfor _, p := range inputPaths {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tcontentHash, err := hashFile(resolvePath(configDir, p))\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tcontentHash = hashBytes(nil)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tif _, err := io.WriteString(h, contentHash); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\treturn \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\treturn hex.EncodeToString(h.Sum(nil)), nil\r\n\u001b[?2004l\r\u001b[?2004h> }'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.426904, "o", "new_cache = '''func computeCacheKey(t *TargetConfig, configDir string) (string, error) {\r\n\u001b[?2004l\r"]
