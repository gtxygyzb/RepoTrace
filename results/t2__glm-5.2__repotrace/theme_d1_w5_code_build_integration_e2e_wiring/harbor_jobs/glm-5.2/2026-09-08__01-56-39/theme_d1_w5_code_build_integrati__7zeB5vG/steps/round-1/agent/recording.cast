[4761.030355, "o", "func collectTransitiveDeps(targetMap map[string]*TargetConfig, name string, seen map[string]bool) {\r\n\u001b[?2004l\r"]
[4761.030424, "o", "\u001b[?2004h> "]
[4761.030903, "o", "    for _, dep := range uniqueStrings(targetMap[name].Dependencies) {\r\n\u001b[?2004l\r"]
[4761.030963, "o", "\u001b[?2004h> "]
[4761.031144, "o", "        if !seen[dep] {\r\n\u001b[?2004l\r"]
[4761.031208, "o", "\u001b[?2004h> "]
[4761.031404, "o", "            seen[dep] = true\r\n\u001b[?2004l\r"]
[4761.031464, "o", "\u001b[?2004h> "]
[4761.031842, "o", "            collectTransitiveDeps(targetMap, dep, seen)\r\n\u001b[?2004l\r"]
[4761.031905, "o", "\u001b[?2004h> "]
[4761.031977, "o", "        }\r\n\u001b[?2004l\r"]
[4761.032034, "o", "\u001b[?2004h> "]
[4761.032099, "o", "    }\r\n\u001b[?2004l\r"]
[4761.032158, "o", "\u001b[?2004h> "]
[4761.032192, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.032336, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.033061, "o", "func dependsOnTransitive(targetMap map[string]*TargetConfig, name, target string, seen map[string]bool) bool {\r\n\u001b[?2004l\r"]
[4761.033147, "o", "\u001b[?2004h> "]
[4761.033252, "o", "    if seen[name] {\r\n\u001b[?2004l\r"]
[4761.033318, "o", "\u001b[?2004h> "]
[4761.033463, "o", "        return false\r\n\u001b[?2004l\r"]
[4761.03353, "o", "\u001b[?2004h> "]
[4761.033594, "o", "    }\r\n\u001b[?2004l\r"]
[4761.033648, "o", "\u001b[?2004h> "]
[4761.033799, "o", "    seen[name] = true\r\n\u001b[?2004l\r"]
[4761.033858, "o", "\u001b[?2004h> "]
[4761.034365, "o", "    for _, dep := range uniqueStrings(targetMap[name].Dependencies) {\r\n\u001b[?2004l\r"]
[4761.034422, "o", "\u001b[?2004h> "]
[4761.034612, "o", "        if dep == target {\r\n\u001b[?2004l\r"]
[4761.034675, "o", "\u001b[?2004h> "]
[4761.034837, "o", "            return true\r\n\u001b[?2004l\r"]
[4761.034899, "o", "\u001b[?2004h> "]
[4761.035001, "o", "        }\r\n\u001b[?2004l\r"]
[4761.035104, "o", "\u001b[?2004h> "]
[4761.035486, "o", "        if dependsOnTransitive(targetMap, dep, target, seen) {\r\n\u001b[?2004l\r"]
[4761.035543, "o", "\u001b[?2004h> "]
[4761.035696, "o", "            return true\r\n\u001b[?2004l\r"]
[4761.03575, "o", "\u001b[?2004h"]
[4761.035809, "o", "> "]
[4761.035862, "o", "        }\r\n\u001b[?2004l\r"]
[4761.035922, "o", "\u001b[?2004h> "]
[4761.035989, "o", "    }\r\n\u001b[?2004l\r"]
[4761.036042, "o", "\u001b[?2004h> "]
[4761.036123, "o", "    return false\r\n\u001b[?2004l\r"]
[4761.036184, "o", "\u001b[?2004h> }\r\n"]
[4761.036264, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
