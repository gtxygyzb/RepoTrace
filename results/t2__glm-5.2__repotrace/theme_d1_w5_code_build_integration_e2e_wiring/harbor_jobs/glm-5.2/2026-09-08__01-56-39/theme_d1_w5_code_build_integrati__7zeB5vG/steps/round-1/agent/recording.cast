[3796.359863, "o", "\u001b[?2004h"]
[3796.359916, "o", "> \\t\\t} else {\r\n\u001b[?2004l\r"]
[3796.359967, "o", "\u001b[?2004h> "]
[3796.360021, "o", "\\t\\t\\tout[parts[0]] = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.360075, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[3796.360124, "o", "> \\t}\r\n"]
[3796.360175, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3796.36027, "o", "\\tfor k, v := range exports {\r\n\u001b[?2004l\r"]
[3796.360288, "o", "\u001b[?2004h> "]
[3796.360356, "o", "\\t\\tout[k] = v\r\n\u001b[?2004l\r\u001b[?2004h"]
[3796.360407, "o", "> \\t}\r\n"]
[3796.360457, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3796.360565, "o", "\\tresult := make([]string, 0, len(out))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.360644, "o", "\\tfor k, v := range out {\r\n\u001b[?2004l\r"]
[3796.360698, "o", "\u001b[?2004h> "]
