[7644.38822, "o", "  1107\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1108\t\t}\r\n  1109\t\r\n  1110\t\tif !e.noCache {\r\n  1111\t\t\tvalid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)\r\n  1112\t\t\tif err != nil {\r\n"]
[7644.388324, "o", "  1113\t\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1114\t\t\t}\r\n  1115\t\t\tif valid {\r\n  1116\t\t\t\treturn execResult{name: t.Name, status: \"cached\", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1117\t\t\t}\r\n  1118\t\t}\r\n  1119\t\r\n  1120\t\ttimeout := t.Timeout\r\n  1121\t\tif timeout <= 0 {\r\n  1122\t\t\ttimeout = 300\r\n  1123\t\t}\r\n  1124\t\tdeadline := time.Now().Add(time.Duration(timeout) * time.Second)\r\n  1125\t\r\n  1126\t\tbaseEnv := mergedEnv(t.Env)\r\n  1127\t\tpreEnv := append([]string(nil), baseEnv...)\r\n  1128\t\r\n  1129\t\tfor _, hook := range t.PreBuild {\r\n  1130\t\t\tstdout, err := e.runCommand(t, hook, preEnv, deadline)\r\n  1131\t\t\tif err != nil {\r\n  1132\t\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1133\t\t\t}\r\n  1134\t\t"]
[7644.388386, "o", "\tpreEnv = mergeHookExports(preEnv, parseHookExports(stdout))\r\n  1135\t\t}\r\n  1136\t\r\n  1137\t\tmainEnv := preEnv\r\n  1138\t\tif _, err := e.runCommand(t, t.Command, mainEnv, deadline); err != nil {\r\n  1139\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1140\t\t}\r\n  1141\t\r\n  1142\t\tpostEnv := append([]string(nil), baseEnv...)\r\n  1143\t\tfor _, hook := range t.PostBuild {\r\n  1144\t\t\tstdout, err := e.runCommand(t, hook, postEnv, deadline)\r\n  1145\t\t\tif err != nil {\r\n  1146\t\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1147\t\t\t}\r\n"]
