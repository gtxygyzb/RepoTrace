[6538.72401, "o", "\t\t\tfor _, dep := range uniqueStrings(targetMap[node].Dependencies) {\r\n\t\t\t\tdfs(dep)\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tcurrent = current[:len(current)-1]\r\n\t\tdelete(visited, node)\r\n\t}\r\n\tdfs(from)\r\n\treturn paths\r\n}\r\n\r\nfunc sortPaths(paths [][]string) {\r\n\tsort.Slice(paths, func(i, j int) bool {\r\n\t\tif len(paths[i]) != len(paths[j]) {\r\n\t\t\treturn len(paths[i]) < len(paths[j])\r\n"]
[6538.724081, "o", "\t\t}\r\n\t\tfor k := 0; k < len(paths[i]) && k < len(paths[j]); k++ {\r\n\t\t\tif paths[i][k] != paths[j][k] {\r\n\t\t\t\treturn paths[i][k] < paths[j][k]\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn false\r\n\t})\r\n}\r\n\r\nfunc topologicalOrderSubset(cfg *Config, subset map[string]bool) []string {\r\n\tindeg := map[string]int{}\r\n\tfor name := range subset {\r\n"]
[6538.724142, "o", "\t\tindeg[name] = 0\r\n\t}\r\n\tfor _, t := range cfg.Targets {\r\n\t\tif !subset[t.Name] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n\t\t\tif subset[dep] {\r\n\t\t\t\tindeg[t.Name]++\r\n\t\t\t}\r\n\t\t}\r\n"]
[6538.7242, "o", "\t}\r\n\r\n\tqueue := []string{}\r\n\tfor name := range subset {\r\n\t\tif indeg[name] == 0 {\r\n\t\t\tqueue = append(queue, name)\r\n\t\t}\r\n\t}\r\n\tsort.Strings(queue)\r\n\r\n\torder := []string{}\r\n"]
[6538.724275, "o", "\tfor len(queue) > 0 {\r\n\t\tname := queue[0]\r\n\t\tqueue = queue[1:]\r\n\t\torder = append(order, name)\r\n\r\n\t\tfor _, t := range cfg.Targets {\r\n\t\t\tif !subset[t.Name] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n\t\t\t\t"]
[6538.724339, "o", "if dep == name {\r\n\t\t\t\t\tindeg[t.Name]--\r\n\t\t\t\t\tif indeg[t.Name] == 0 {\r\n\t\t\t\t\t\tqueue = append(queue, t.Name)\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[6538.724413, "o", "\t\t}\r\n\t\tsort.Strings(queue)\r\n\t}\r\n\treturn order\r\n}\r\n\r\nfunc buildRebuildLayers(targetMap map[string]*TargetConfig, affected map[string]bool, direct map[string]bool) [][]map[string]interface{} {\r\n\tlayer := map[string]int{}\r\n\r\n\tvar resolve func(name string) int\r\n\tresolve = func(name string) int {\r\n\t\tif l, ok := layer[name]; ok {\r\n\t\t\treturn l\r\n"]
[6538.72447, "o", "\t\t}\r\n\t\tmaxDepLayer := -1\r\n\t\tfor _, dep := range uniqueStrings(targetMap[name].Dependencies) {\r\n\t\t\tif affected[dep] {\r\n\t\t\t\tdepLayer := resolve(dep)\r\n\t\t\t\tif depLayer > maxDepLayer {\r\n\t\t\t\t\tmaxDepLayer = depLayer\r\n\t\t\t\t}\r\n"]
[6538.724529, "o", "\t\t\t}\r\n\t\t}\r\n\t\tlayer[name] = maxDepLayer + 1\r\n\t\treturn layer[name]\r\n\t}\r\n\r\n\tfor name := range affected {\r\n\t\tresolve(name)\r\n\t}\r\n\r\n"]
[6538.724584, "o", "\tmaxLayer := 0\r\n\tfor _, l := range layer {\r\n\t\tif l > maxLayer {\r\n\t\t\tmaxLayer = l\r\n\t\t}\r\n\t}\r\n\r\n\tlayers := make([][]map[string]interface{}, maxLayer+1)\r\n\tfor l := 0; l <= maxLayer; l++ {\r\n\t\tnames := []string{}\r\n\t\tfor name, ll := range layer {\r\n\t\t\tif ll == l {\r\n"]
[6538.724646, "o", "\t\t\t\tnames = append(names, name)\r\n\t\t\t}\r\n\t\t}\r\n\t\tsort.Strings(names)\r\n\t\tfor _, name := range names {\r\n\t\t\tlayers[l] = append(layers[l], map[string]interface{}{\r\n\t\t\t\t\"target\": name,\r\n\t\t\t\t\"direct\": direct[name],\r\n\t\t\t})\r\n\t\t}\r\n"]
[6538.724701, "o", "\t}\r\n\treturn layers\r\n}\r\n\r\nfunc sortedKeys(m map[string]bool) []string {\r\n\tkeys := []string{}\r\n\tfor k := range m {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n\tsort.Strings(keys)\r\n\treturn keys\r\n"]
[6538.724761, "o", "}\r\n\r\nfunc emitJSON(v interface{}) error {\r\n\treturn json.NewEncoder(os.Stdout).Encode(v)\r\n}\r\n\r\nfunc failDepsJSON(msg string) {\r\n\tjson.NewEncoder(os.Stdout).Encode(map[string]string{\"error\": msg})\r\n\tos.Exit(1)\r\n}\r\n"]
