[6817.028029, "o", "\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tProfile  *\u001b[01;31m\u001b[KBuildProfile\u001b[m\u001b[K       `json:\"\u001b[01;31m\u001b[Kprofile\u001b[m\u001b[K,omitempty\"`\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktype \u001b[01;31m\u001b[KBuildProfile\u001b[m\u001b[K struct {\r\n"]
[6817.028125, "o", "\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kprofile\u001b[m\u001b[K := fs.Bool(\"\u001b[01;31m\u001b[Kprofile\u001b[m\u001b[K\", false, \"include build \u001b[01;31m\u001b[Kprofile\u001b[m\u001b[K with critical path in JSON report\")\r\n\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath, []string(vars), *keepGoing, *\u001b[01;31m\u001b[Kprofile\u001b[m\u001b[K); err != nil {\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string, vars []string, keepGoing bool, \u001b[01;31m\u001b[Kprofile\u001b[m\u001b[K bool) error {\r\n\u001b[32m\u001b[K396\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif \u001b[01;31m\u001b[Kprofile\u001b[m\u001b[K {\r\n"]
[6817.028269, "o", "\u001b[32m\u001b[K397\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treport.Profile = \u001b[01;31m\u001b[KcomputeBuildProfile\u001b[m\u001b[K(report.Targets, cfg, targetMap)\r\n"]
[6817.028325, "o", "\u001b[32m\u001b[K842\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcomputeBuildProfile\u001b[m\u001b[K(targets []BuildTargetReport, cfg *Config, targetMap map[string]*TargetConfig) *\u001b[01;31m\u001b[KBuildProfile\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K859\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn &\u001b[01;31m\u001b[KBuildProfile\u001b[m\u001b[K{CriticalPath: []string{}, CriticalPathMS: 0}\r\n\u001b[32m\u001b[K918\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn &\u001b[01;31m\u001b[KBuildProfile\u001b[m\u001b[K{CriticalPath: best.names, CriticalPathMS: best.weight}\r\n"]
