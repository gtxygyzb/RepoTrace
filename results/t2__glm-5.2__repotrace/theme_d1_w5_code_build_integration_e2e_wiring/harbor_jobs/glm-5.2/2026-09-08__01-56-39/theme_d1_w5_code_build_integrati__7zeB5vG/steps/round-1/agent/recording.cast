[7440.584781, "o", "nl -ba main.go | sed -n '936,1104p'\r\n\u001b[?2004l\r"]
[7440.589171, "o", "   936\t\t}\r\n   937\t\r\n   938\t\torder := []string{}\r\n   939\t\tfor len(queue) > 0 {\r\n   940\t\t\tname := queue[0]\r\n   941\t\t\tqueue = queue[1:]\r\n   942\t"]
[7440.589347, "o", "\t\torder = append(order, name)\r\n   943\t\t\tfor _, t := range cfg.Targets {\r\n   944\t\t\t\tif !requested[t.Name] {\r\n   945\t\t\t\t\tcontinue\r\n   946\t\t\t\t}\r\n   947\t\t\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n   948\t\t\t\t\tif dep == name {\r\n   949\t\t\t\t\t\tindeg[t.Name]--\r\n   950\t\t\t\t\t\tif indeg[t.Name] == 0 {\r\n   951\t\t\t\t\t\t\tqueue = append(queue, t.Name)\r\n   952\t\t\t\t\t\t}\r\n   953\t\t\t\t\t\tbreak\r\n"]
[7440.589431, "o", "   954\t\t\t\t\t}\r\n   955\t\t\t\t}\r\n   956\t\t\t}\r\n   957\t\t}\r\n"]
[7440.589495, "o", "   958\t\treturn order\r\n   959\t}\r\n   960\t\r\n   961\tfunc buildReverseDeps(cfg *Config, requested map[string]bool) map[string][]string {\r\n   962\t\treverse := map[string][]string{}\r\n   963\t\tfor _, t := range cfg.Targets {\r\n   964\t\t\tif !requested[t.Name] {\r\n"]
[7440.589563, "o", "   965\t\t\t\tcontinue\r\n   966\t\t\t}\r\n   967\t\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n   968\t\t\t\tif requested[dep] {\r\n   969\t\t\t\t\treverse[dep] = append(reverse[dep], t.Name)\r\n   970\t\t\t\t}\r\n   971\t\t\t}\r\n"]
[7440.589626, "o", "   972\t\t}\r\n   973\t\treturn reverse\r\n   974\t}\r\n   975\t\r\n   976\tfunc allDependenciesComplete(name string, targetMap map[string]*TargetConfig, requested map[string]bool, status map[string]string) bool {\r\n   977\t\tfor _, dep := range targetMap[name].Dependencies {\r\n   978\t\t\tif !requested[dep] {\r\n   979\t\t\t\tcontinue\r\n   980\t\t\t}\r\n   981"]
[7440.589696, "o", "\t\t\ts := status[dep]\r\n   982\t\t\t"]
[7440.589753, "o", "if s != \"built\" && s != \"cached\" {\r\n   983\t\t\t\treturn false\r\n   984\t\t\t}\r\n   985\t\t}\r\n   986\t\treturn true\r\n   987\t}\r\n"]
[7440.589814, "o", "   988\t\r\n   989\tfunc markSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {\r\n   990\t\tfor _, dependent := range reverseDeps[name] {\r\n   991\t\t\tswitch status[dependent] {\r\n   992\t\t\tcase \"\", \"cancelled\":\r\n   993\t\t\t\twasCancelled := status[dependent] == \"cancelled\"\r\n"]
[7440.589875, "o", "   994\t\t\t\tstatus[dependent] = \"skipped\"\r\n   995\t\t\t\tdurations[dependent] = 0\r\n   996\t\t\t\tif !wasCancelled {\r\n   997\t\t\t\t\t*completed++\r\n   998\t\t\t\t}\r\n"]
[7440.589936, "o", "   999\t\t\t\tmarkSkipped(reverseDeps, status, durations, completed, dependent)\r\n  1000\t\t\t}\r\n  1001\t\t}\r\n  1002\t}\r\n  1003\t\r\n  1004\ttype buildPath struct {\r\n  1005\t\tnames  []string\r\n"]
[7440.590014, "o", "  1006\t\tweight int64\r\n  1007\t}\r\n  1008\t\r\n  1009\tfunc computeBuildProfile(targets []BuildTargetReport, cfg *Config, targetMap map[string]*TargetConfig) *BuildProfile {\r\n  1010\t\tdurationByName := map[string]int64{}\r\n  1011\t\tsuccessful := map[string]bool{}\r\n  1012\t\thasBuilt := false\r\n  1013\t\tfor _, t := range targets {\r\n  1014\t"]
[7440.590071, "o", "\t\tswitch t.Status {\r\n  1015\t\t\tcase \"built\":\r\n  1016\t\t\t\tsuccessful[t.Name] = true\r\n  1017\t\t\t\tdurationByName[t.Name] = t.DurationMS\r\n  1018\t\t\t\thasBuilt = true\r\n"]
[7440.59013, "o", "  1019\t\t\tcase \"cached\":\r\n  1020\t\t\t\tsuccessful[t.Name] = true\r\n  1021\t\t\t\tdurationByName[t.Name] = 0\r\n  1022\t\t\t}\r\n  1023\t\t}\r\n"]
[7440.590191, "o", "  1024\t\r\n  1025\t\tif len(successful) == 0 || !hasBuilt {\r\n  1026\t\t\treturn &BuildProfile{CriticalPath: []string{}, CriticalPathMS: 0}\r\n  1027\t\t}\r\n  1028\t\r\n  1029\t\tdeps := map[string][]string{}\r\n  1030"]
[7440.590272, "o", "\t\tfor name := range successful {\r\n  1031\t\t\tt, ok := targetMap[name]\r\n  1032\t\t\tif !ok {\r\n  1033\t\t\t\tcontinue\r\n  1034\t\t\t}\r\n  1035\t\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n"]
[7440.590337, "o", "  1036\t\t\t\tif successful[dep] {\r\n  1037\t\t\t\t\tdeps[name] = append(deps[name], dep)\r\n  1038\t\t\t\t}\r\n  1039\t\t\t}\r\n  1040\t\t\tsort.Strings(deps[name])\r\n  1041\t\t}\r\n"]
[7440.590397, "o", "  1042\t\r\n  1043\t\torder := []string{}\r\n  1044\t\tseen := map[string]bool{}\r\n  1045\t\tvar visit func(string)\r\n  1046\t\tvisit = func(n string) {\r\n  1047\t\t\tif seen[n] {\r\n"]
[7440.590458, "o", "  1048\t\t\t\treturn\r\n  1049\t\t\t}\r\n  1050\t\t\tseen[n] = true\r\n  1051\t\t\tfor _, dep := range deps[n] {\r\n  1052\t\t\t\tvisit(dep)\r\n"]
[7440.590518, "o", "  1053\t\t\t}\r\n  1054\t\t\torder = append(order, n)\r\n  1055\t\t}\r\n  1056\t\tfor _, t := range cfg.Targets {\r\n  1057\t\t\tif successful[t.Name] {\r\n"]
[7440.590597, "o", "  1058\t\t\t\tvisit(t.Name)\r\n  1059\t\t\t}\r\n  1060\t\t}\r\n  1061\t\r\n  1062\t\tdp := map[string]buildPath{}\r\n  1063\t\tfor _, name := range order {\r\n  1064\t\t\tbest := buildPath{names: []string{name}, weight: durationByName[name]}\r\n  1065\t\t\tfor _, dep := range deps[name] {\r\n  1066"]
[7440.590664, "o", "\t\t\t\tcand := buildPath{\r\n  1067\t\t\t\t\tnames:  append(append([]string{}, dp[dep].names...), name),\r\n  1068\t\t\t\t\tweight: dp[dep].weight + durationByName[name],\r\n"]
[7440.590727, "o", "  1069\t\t\t\t}\r\n  1070\t\t\t\tif betterBuildPath(cand, best) {\r\n  1071\t\t\t\t\tbest = cand\r\n  1072\t\t\t\t}\r\n  1073\t\t\t}\r\n  1074\t\t\tdp[name] = best\r\n  1075\t\t}\r\n  1076\t\r\n  1077\t\tvar best buildPath\r\n"]
[7440.590787, "o", "  1078\t\tfor _, name := range order {\r\n  1079\t\t\tp := dp[name]\r\n  1080\t\t\tif best.names == nil || betterBuildPath(p, best) {\r\n  1081\t\t\t\tbest = p\r\n  1082\t\t\t}\r\n"]
[7440.590845, "o", "  1083\t\t}\r\n  1084\t\r\n  1085\t\treturn &BuildProfile{CriticalPath: best.names, CriticalPathMS: best.weight}\r\n  1086\t}\r\n  1087\t\r\n  1088\tfunc betterBuildPath(a, b buildPath) bool {\r\n"]
[7440.590918, "o", "  1089\t\tif a.weight != b.weight {\r\n  1090\t\t\treturn a.weight > b.weight\r\n  1091\t\t}\r\n  1092\t\tif len(a.names) != len(b.names) {\r\n  1093\t\t\treturn len(a.names) > len(b.names)\r\n  1094\t\t}\r\n  1095\t\tfor i := 0; i < len(a.names); i++ {\r\n"]
[7440.590978, "o", "  1096\t\t\tif a.names[i] != b.names[i] {\r\n  1097\t\t\t\treturn a.names[i] < b.names[i]\r\n  1098\t\t\t}\r\n  1099\t\t}\r\n  1100\t\treturn false\r\n"]
[7440.591036, "o", "  1101\t}\r\n  1102\t\r\n  1103\tfunc (e *buildExecutor) execute(t *TargetConfig) execResult {\r\n  1104\t\tstart := time.Now()\r\n"]
