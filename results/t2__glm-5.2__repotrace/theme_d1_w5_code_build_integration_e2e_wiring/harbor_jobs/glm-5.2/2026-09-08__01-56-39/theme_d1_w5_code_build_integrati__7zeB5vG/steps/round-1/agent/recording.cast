[3675.557598, "o", "\r\n    24\t\r\n    25\ttype stringSliceFlag []string\r\n    26\t\r\n    27\tfunc (s *stringSliceFlag) String() string {\r\n    28\t\treturn strings.Join(*s, \",\")\r\n    29\t}\r\n    30\t\r\n    31\tfunc (s *stringSliceFlag) Set(value string) error {\r\n    32\t\t*s = append(*s, value)\r\n    33\t\treturn nil\r\n    34\t}\r\n    35\t\r\n    36\ttype PipelineConfig struct {\r\n    37\t\tName    string   `toml:\"name\"`\r\n    38\t\tImports []string `toml:\"imports\"`\r\n    39\t}"]
[3675.55767, "o", "\r\n    40\t\r\n    41\ttype TargetConfig struct {\r\n    42\t\tName         string            `toml:\"name\"`\r\n    43\t\tCommand      string            `toml:\"command\"`\r\n    44\t\tDependencies []string          `toml:\"dependencies\"`\r\n    45\t\tInputs       []string          `toml:\"inputs\"`\r\n"]
