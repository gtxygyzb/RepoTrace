[4760.953221, "o", "\u001b[?2004h> "]
[4760.953307, "o", "    }\r\n\u001b[?2004l\r"]
[4760.953363, "o", "\u001b[?2004h> "]
[4760.953551, "o", "    if *configPath == \"\" {\r\n\u001b[?2004l\r"]
[4760.953605, "o", "\u001b[?2004h> "]
[4760.954043, "o", "        fmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n\u001b[?2004l\r"]
[4760.954106, "o", "\u001b[?2004h> "]
[4760.954253, "o", "        os.Exit(1)\r\n\u001b[?2004l\r"]
[4760.954314, "o", "\u001b[?2004h> "]
[4760.954377, "o", "    }\r\n\u001b[?2004l\r"]
[4760.954431, "o", "\u001b[?2004h> "]
[4760.954631, "o", "    if *plan && !*affected {\r\n\u001b[?2004l\r"]
[4760.954685, "o", "\u001b[?2004h> "]
[4760.955152, "o", "        fmt.Fprintln(os.Stderr, \"error: --plan requires --affected\")\r\n\u001b[?2004l\r"]
[4760.955215, "o", "\u001b[?2004h> "]
[4760.955374, "o", "        os.Exit(1)\r\n\u001b[?2004l\r"]
[4760.955428, "o", "\u001b[?2004h"]
[4760.955487, "o", ">     }\r\n"]
[4760.955541, "o", "\u001b[?2004l\r\u001b[?2004h"]
[4760.9556, "o", "> "]
[4760.956242, "o", "    if err := runDeps(*configPath, []string(vars), fs.Args(), *why, *affected, *plan); err != nil {\r\n\u001b[?2004l\r"]
[4760.956311, "o", "\u001b[?2004h> "]
[4760.956561, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r"]
[4760.95663, "o", "\u001b[?2004h> "]
[4760.956758, "o", "        os.Exit(1)\r\n\u001b[?2004l\r"]
[4760.956824, "o", "\u001b[?2004h> "]
[4760.95688, "o", "    }\r\n\u001b[?2004l\r"]
[4760.956933, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4760.956996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4760.957051, "o", "s\u001b[?2004h> "]
[4760.957725, "o", "func runDeps(configPath string, vars []string, args []string, why, affected, plan bool) error {\r\n\u001b[?2004l\r"]
[4760.957789, "o", "\u001b[?2004h> "]
[4760.958106, "o", "    cfg, _, err := loadConfig(configPath, vars)\r\n\u001b[?2004l\r"]
[4760.958169, "o", "\u001b[?2004h> "]
[4760.958323, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[4760.958386, "o", "\u001b[?2004h> "]
[4760.958523, "o", "        return err\r\n\u001b[?2004l\r"]
[4760.958586, "o", "\u001b[?2004h> "]
[4760.958638, "o", "    }\r\n\u001b[?2004l\r"]
[4760.958702, "o", "\u001b[?2004h> "]
[4760.958976, "o", "    targetMap, err := validateConfig(cfg)\r\n\u001b[?2004l\r"]
[4760.959031, "o", "\u001b[?2004h> "]
[4760.959184, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[4760.959254, "o", "\u001b[?2004h> "]
[4760.959402, "o", "        return err\r\n\u001b[?2004l\r"]
[4760.959465, "o", "\u001b[?2004h> "]
[4760.959522, "o", "    }\r\n\u001b[?2004l\r"]
[4760.959582, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri"]
[4760.959646, "o", "\u001b[?2004h> "]
[4760.959744, "o", "    if affected {\r\n\u001b[?2004l\r"]
[4760.959806, "o", "\u001b[?2004h> "]
[4760.960005, "o", "        if len(args) == 0 {\r\n\u001b[?2004l\r"]
[4760.960058, "o", "\u001b[?2004h> "]
[4760.960501, "o", "            return fmt.Errorf(\"--affected requires at least one FILE\")\r\n\u001b[?2004l\r"]
[4760.960563, "o", "\u001b[?2004h> "]
[4760.960622, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4760.96065, "o", "> "]
[4760.960985, "o", "        return runDepsAffected(cfg, targetMap, args, plan)\r\n\u001b[?2004l\r"]
[4760.961066, "o", "\u001b[?2004h"]
[4760.961132, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[4760.961188, "o", "> "]
[4760.961263, "o", "    if why {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4760.961322, "o", "> "]
[4760.961425, "o", "        if len(args) != 2 {\r\n\u001b[?2004l\r"]
[4760.961481, "o", "\u001b[?2004h> "]
[4760.961916, "o", "            return fmt.Errorf(\"--why requires exactly two target names: FROM TO\")\r\n\u001b[?2004l\r"]
[4760.961976, "o", "\u001b[?2004h> "]
[4760.962031, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4760.962084, "o", "> "]
[4760.962394, "o", "        return runDepsWhy(cfg, targetMap, args[0], args[1])\r\n\u001b[?2004l\r"]
[4760.962463, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4760.962518, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4760.962574, "o", "\u001b[?2004h> "]
[4760.962694, "o", "    if len(args) != 1 {\r\n\u001b[?2004l\r"]
[4760.962748, "o", "\u001b[?2004h> "]
[4760.963139, "o", "        return fmt.Errorf(\"deps requires exactly one target name\")\r\n\u001b[?2004l\r"]
[4760.963199, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4760.963295, "o", "\u001b[?2004h> "]
[4760.96355, "o", "    return runDepsTarget(cfg, targetMap, args[0])\r\n\u001b[?2004l\r"]
[4760.963607, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4760.963661, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4760.963715, "o", "\u001b[?2004h> "]
[4760.964192, "o", "func runDepsTarget(cfg *Config, targetMap map[string]*TargetConfig, target string) error {\r\n\u001b[?2004l\r"]
[4760.964275, "o", "\u001b[?2004h> "]
[4760.964473, "o", "    if _, ok := targetMap[target]; !ok {\r\n\u001b[?2004l\r"]
[4760.964528, "o", "\u001b[?2004h> "]
[4760.96489, "o", "        failDepsJSON(fmt.Sprintf(\"target %q does not exist\", target))\r\n\u001b[?2004l\r"]
[4760.964947, "o", "\u001b[?2004h> "]
[4760.965031, "o", "        return nil\r\n\u001b[?2004l\r"]
[4760.965085, "o", "\u001b[?2004h> "]
[4760.96514, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4760.965193, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4760.965412, "o", "    directSet := map[string]bool{}\r\n\u001b[?2004l\r"]
[4760.965469, "o", "\u001b[?2004h> "]
[4760.965867, "o", "    for _, dep := range uniqueStrings(targetMap[target].Dependencies) {\r\n\u001b[?2004l\r"]
[4760.965923, "o", "\u001b[?2004h> "]
[4760.966067, "o", "        directSet[dep] = true\r\n\u001b[?2004l\r"]
[4760.966121, "o", "\u001b[?2004h> "]
[4760.966175, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4760.966376, "o", "    direct := sortedKeys(directSet)\r\n\u001b[?2004l\r"]
[4760.966435, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4760.96649, "o", "\u001b[?2004h> "]
[4760.966673, "o", "    transitiveSet := map[string]bool{}\r\n\u001b[?2004l\r"]
[4760.966728, "o", "\u001b[?2004h> "]
[4760.967018, "o", "    collectTransitiveDeps(targetMap, target, transitiveSet)\r\n\u001b[?2004l\r"]
[4760.967074, "o", "\u001b[?2004h> "]
[4760.967253, "o", "    delete(transitiveSet, target)\r\n\u001b[?2004l\r"]
[4760.967308, "o", "\u001b[?2004h> "]
[4760.96753, "o", "    transitive := sortedKeys(transitiveSet)\r\n\u001b[?2004l\r"]
[4760.967584, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4760.967639, "o", "\u001b[?2004h> "]
[4760.967803, "o", "    reverseSet := map[string]bool{}\r\n\u001b[?2004l\r"]
[4760.967857, "o", "\u001b[?2004h> "]
[4760.968045, "o", "    for _, t := range cfg.Targets {\r\n\u001b[?2004l\r"]
[4760.9681, "o", "\u001b[?2004h> "]
[4760.968247, "o", "        if t.Name == target {\r\n\u001b[?2004l\r"]
[4760.968336, "o", "\u001b[?2004h"]
[4760.968393, "o", "> "]
[4760.968446, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4760.968508, "o", "        }\r\n\u001b[?2004l\r"]
[4760.968562, "o", "\u001b[?2004h> "]
[4760.968728, "o", "        seen := map[string]bool{}\r\n\u001b[?2004l\r"]
[4760.968782, "o", "\u001b[?2004h> "]
[4760.969159, "o", "        if dependsOnTransitive(targetMap, t.Name, target, seen) {\r\n\u001b[?2004l\r"]
[4760.969215, "o", "\u001b[?2004h> "]
[4760.969422, "o", "            reverseSet[t.Name] = true\r\n\u001b[?2004l\r"]
[4760.969476, "o", "\u001b[?2004h> "]
[4760.969529, "o", "        }\r\n\u001b[?2004l\r"]
[4760.969583, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4760.969657, "o", "\u001b[?2004h> "]
[4760.969841, "o", "    reverse := sortedKeys(reverseSet)\r\n\u001b[?2004l\r"]
[4760.969895, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4760.969949, "o", "\u001b[?2004h> "]
[4760.970172, "o", "    return emitJSON(map[string]interface{}{\r\n\u001b[?2004l\r"]
[4760.970254, "o", "\u001b[?2004h> "]
[4760.970396, "o", "        \"target\":          target,\r\n\u001b[?2004l\r"]
[4760.970452, "o", "\u001b[?2004h> "]
[4760.970554, "o", "        \"direct_deps\":     direct,\r\n\u001b[?2004l\r"]
[4760.970607, "o", "\u001b[?2004h> "]
[4760.970725, "o", "        \"transitive_deps\": transitive,\r\n\u001b[?2004l\r"]
[4760.970781, "o", "\u001b[?2004h> "]
[4760.970888, "o", "        \"reverse_deps\":    reverse,\r\n\u001b[?2004l\r"]
[4760.970943, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
[4760.970998, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\rt\u001b[?2004h> "]
[4760.971053, "o", "\r\n\u001b[?2004l\rh\u001b[?2004h> "]
[4760.971394, "o", "func runDepsWhy(cfg *Config, targetMap map[string]*TargetConfig, from, to string) error {\r\n\u001b[?2004l\r"]
[4760.971452, "o", "\u001b[?2004h> "]
[4760.971571, "o", "    if _, ok := targetMap[from]; !ok {\r\n\u001b[?2004l\r"]
[4760.971633, "o", "\u001b[?2004h> "]
[4760.971853, "o", "        failDepsJSON(fmt.Sprintf(\"target %q does not exist\", from))\r\n\u001b[?2004l\r"]
[4760.971911, "o", "\u001b[?2004h> "]
[4760.971963, "o", "        return nil\r\n\u001b[?2004l\r"]
[4760.972016, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4760.972071, "o", "\u001b[?2004h> "]
[4760.97218, "o", "    if _, ok := targetMap[to]; !ok {\r\n\u001b[?2004l\r"]
[4760.972245, "o", "\u001b[?2004h> "]
[4760.972493, "o", "        failDepsJSON(fmt.Sprintf(\"target %q does not exist\", to))\r\n\u001b[?2004l\r"]
[4760.972546, "o", "\u001b[?2004h> "]
[4760.972597, "o", "        return nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[4760.97265, "o", ">     }\r\n\u001b[?2004l\r"]
[4760.972703, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[4760.972901, "o", "    paths := allDependencyPaths(targetMap, from, to)\r\n\u001b[?2004l\r"]
[4760.972955, "o", "\u001b[?2004h> "]
[4760.973013, "o", "    sortPaths(paths)\r\n\u001b[?2004l\r"]
[4760.973065, "o", "\u001b[?2004h> "]
[4760.973205, "o", "    return emitJSON(map[string]interface{}{\r\n\u001b[?2004l\r"]
[4760.97327, "o", "\u001b[?2004h> "]
[4760.973333, "o", "        \"from\":  from,\r\n\u001b[?2004l\r"]
[4760.973386, "o", "\u001b[?2004h> "]
[4760.973453, "o", "        \"to\":    to,\r\n\u001b[?2004l\r"]
[4760.973506, "o", "\u001b[?2004h> "]
[4760.973575, "o", "        \"paths\": paths,\r\n\u001b[?2004l\r"]
[4760.973628, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
[4760.973682, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4760.973735, "o", "\r\n\u001b[?2004l\r \u001b[?2004h> "]
[4760.974133, "o", "func runDepsAffected(cfg *Config, targetMap map[string]*TargetConfig, files []string, plan bool) error {\r\n\u001b[?2004l\r"]
[4760.974186, "o", "\u001b[?2004h> "]
[4760.974305, "o", "    fileSet := map[string]bool{}\r\n\u001b[?2004l\r"]
[4760.974366, "o", "\u001b[?2004h> "]
[4760.974459, "o", "    for _, f := range files {\r\n\u001b[?2004l\r"]
[4760.974519, "o", "\u001b[?2004h> "]
[4760.974582, "o", "        fileSet[f] = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4760.974636, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4760.974732, "o", "> \r\n\u001b[?2004l\rS\u001b[?2004h> "]
[4760.97483, "o", "    affectedSet := map[string]bool{}\r\n\u001b[?2004l\r"]
[4760.974885, "o", "\u001b[?2004h> "]
[4760.975013, "o", "    directAffected := map[string]bool{}\r\n\u001b[?2004l\r"]
[4760.975078, "o", "\u001b[?2004h> "]
[4760.975181, "o", "    for i := range cfg.Targets {\r\n\u001b[?2004l\r"]
[4760.97527, "o", "\u001b[?2004h> "]
[4760.975342, "o", "        t := &cfg.Targets[i]\r\n\u001b[?2004l\r"]
[4760.975406, "o", "\u001b[?2004h> "]
[4760.975569, "o", "        for _, input := range t.Inputs {\r\n\u001b[?2004l\r"]
[4760.975634, "o", "\u001b[?2004h> "]
[4760.975769, "o", "            if fileSet[input] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4760.976002, "o", "                affectedSet[t.Name] = true\r\n\u001b[?2004l\r"]
[4760.976081, "o", "\u001b[?2004h> "]
[4760.976266, "o", "                directAffected[t.Name] = true\r\n\u001b[?2004l\r"]
[4760.976332, "o", "\u001b[?2004h> "]
[4760.976445, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h"]
[4760.976508, "o", "> "]
[4760.976534, "o", "            }\r\n\u001b[?2004l\r"]
[4760.976613, "o", "\u001b[?2004h> "]
[4760.976689, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4760.976752, "o", "    }\r\n\u001b[?2004l\r="]
[4760.976814, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[4760.976877, "o", "> "]
[4760.97699, "o", "    queue := sortedKeys(affectedSet)\r\n\u001b[?2004l\r"]
[4760.977044, "o", "\u001b[?2004h> "]
[4760.977148, "o", "    for len(queue) > 0 {\r\n\u001b[?2004l\r \u001b[?2004h"]
[4760.977211, "o", "> "]
[4760.977288, "o", "        name := queue[0]\r\n\u001b[?2004l\r {\r\n\u001b[?2004h"]
[4760.977349, "o", "> "]
[4760.977407, "o", "        queue = queue[1:]\r\n\u001b[?2004l\r"]
[4760.977468, "o", "\u001b[?2004h> "]
[4760.977605, "o", "        for _, t := range cfg.Targets {\r\n\u001b[?2004l\r"]
[4760.977667, "o", "\u001b[?2004h> "]
[4760.977772, "o", "            if affectedSet[t.Name] {\r\n\u001b[?2004l\r"]
[4760.977832, "o", "\u001b[?2004h> "]
[4760.977904, "o", "                continue\r\n\u001b[?2004l\r "]
[4760.977964, "o", "\u001b[?2004h> "]
[4760.978016, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4760.978285, "o", "            for _, dep := range uniqueStrings(t.Dependencies) {\r\n\u001b[?2004l\r"]
[4760.978347, "o", "\u001b[?2004h> "]
[4760.978468, "o", "                if dep == name {\r\n\u001b[?2004l\r"]
[4760.978528, "o", "\u001b[?2004h> "]
[4760.978672, "o", "                    affectedSet[t.Name] = true\r\n\u001b[?2004l\r"]
[4760.978736, "o", "\u001b[?2004h> "]
[4760.9789, "o", "                    queue = append(queue, t.Name)\r\n\u001b[?2004l\r"]
[4760.978961, "o", "\u001b[?2004h> "]
[4760.979038, "o", "                    break\r\n\u001b[?2004l\r"]
[4760.979099, "o", "\u001b[?2004h> "]
[4760.979174, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4760.97925, "o", "            }\r\n\u001b[?2004l\r"]
[4760.979341, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4761.026374, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4761.026573, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if len(affectedSet) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         if plan {\r\n\u001b[?2004l\r\u001b[?2004h>             return emitJSON(map[string]interface{}{\"rebuild_plan\": []interface{}{}})\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         return emitJSON(map[string]interface{}{\"rebuild_order\": []interface{}{}})\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if plan {\r\n\u001b[?2004l\r\u001b[?2004h>         layers := buildRebuildLayers(targetMap, affectedSet, directAffected)\r\n\u001b[?2004l\r\u001b[?2004h>         return emitJSON(map[string]interface{}{\"rebuild_plan\": layers})\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.026935, "o", "    order := topologicalOrderSubset(cfg, affectedSet)\r\n\u001b[?2004l\r"]
[4761.027002, "o", "\u001b[?2004h> "]
[4761.027298, "o", "    entries := []map[string]interface{}{}\r\n\u001b[?2004l\r"]
[4761.027363, "o", "\u001b[?2004h> "]
[4761.027585, "o", "    for _, name := range order {\r\n\u001b[?2004l\r"]
[4761.027642, "o", "\u001b[?2004h> "]
[4761.02804, "o", "        entries = append(entries, map[string]interface{}{\r\n\u001b[?2004l\r"]
[4761.028109, "o", "\u001b[?2004h> "]
[4761.0283, "o", "            \"target\": name,\r\n\u001b[?2004l\r"]
[4761.028359, "o", "\u001b[?2004h> "]
[4761.028666, "o", "            \"direct\": directAffected[name],\r\n\u001b[?2004l\r"]
[4761.02872, "o", "\u001b[?2004h> "]
[4761.028798, "o", "        })\r\n\u001b[?2004l\r"]
[4761.028867, "o", "\u001b[?2004h> "]
[4761.028929, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.028986, "o", "> "]
[4761.029454, "o", "    return emitJSON(map[string]interface{}{\"rebuild_order\": entries})\r\n\u001b[?2004l\r"]
[4761.029534, "o", "\u001b[?2004h> }"]
[4761.029616, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
