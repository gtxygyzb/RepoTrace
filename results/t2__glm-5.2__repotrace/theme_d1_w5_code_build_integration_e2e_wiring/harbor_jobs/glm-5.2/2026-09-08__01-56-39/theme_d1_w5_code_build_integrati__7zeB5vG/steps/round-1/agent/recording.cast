[3436.129145, "o", "   416\tfunc loadConfig(path string, varOverrides []string) (*Config, string, error) {\r\n   417\t\tabs, err := filepath.Abs(path)\r\n   418\t\tif err != nil {\r\n   419\t\t\treturn nil, \"\", err\r\n   420\t\t}\r\n   421\t\toverrides, err := parseVarOverrides(varOverrides)\r\n   422\t\tif err != nil {\r\n   423\t\t\treturn nil, \"\", err\r\n   424\t\t}\r\n   425\t\tloader := &configLoader{\r\n   426\t\t\tvariables:   make(map[string]string),\r\n   427\t\t\ttargetNames: make(map[string]bool),\r\n   428\t\t}\r\n   429\t\tfor k, v := range overrides {\r\n   430\t\t\tloader.variables[k] = v\r\n   431\t\t}"]
[3436.129384, "o", "\r\n   432\t\tif err := loader.loadFile(abs, true); err != nil {\r\n   433\t\t\treturn nil, \"\", err\r\n   434\t\t}\r\n   435\t\tfor i := range loader.targets {\r\n   436\t\t\tt := &loader.targets[i]\r\n   437\t\t\texpanded, err := expandString(t.Command, loader.variables, make(map[string]bool))\r\n   438\t\t\tif err != nil {\r\n   439\t\t\t\treturn nil, \"\", err\r\n   440\t\t\t}\r\n   441\t\t\tt.Command = expanded\r\n   442\t\t\tfor j, p := range t.Inputs {\r\n   443\t\t\t\texpanded, err := expandString(p, loader.variables, make(map[string]bool))\r\n   444\t\t\t\tif err != nil {\r\n   445\t\t\t\t\treturn nil, \"\", err\r\n   446\t\t\t\t}\r\n   447\t\t\t\tt.Inputs[j] = expanded\r\n   448\t\t\t}\r\n   449\t\t\tfor j, p := range t.Outputs {\r\n   450\t\t\t\texpanded, err := expandString(p, loader.variables, make(map[string]bool))\r\n   451\t\t\t\tif err != nil {\r\n   452\t\t\t\t\treturn nil, \"\", err\r\n   453\t\t\t\t}\r\n   454\t\t\t\tt.Outputs[j] = expanded\r\n   455\t\t\t}\r\n   456\t\t\tt.Dependencies = uniqueStrings(t.Dependencies)\r\n   457\t\t\tif t.Timeout <= 0 {\r\n   458\t\t\t\tt.Timeout = 300\r\n   459\t\t\t}\r\n   460\t\t}\r\n   461\t\tcfg := &Config{\r\n   462"]
[3436.129478, "o", "\t\t\tPipeline:  PipelineConfig{Name: loader.pipelineName, Imports: loader.rootImports},\r\n   463\t\t\tTargets:   loader.targets,\r\n   464\t\t\tVariables: loader.variables,\r\n   465\t\t}\r\n   466\t\treturn cfg, filepath.Dir(abs), nil\r\n   467\t}\r\n   468\t\r\n   469\ttype configLoader struct {\r\n   470\t\tpipelineName string\r\n   471\t\trootImports  []string\r\n   472\t\tvariables    map[string]string\r\n   473\t\ttargets      []TargetConfig\r\n   474\t\ttargetNames  map[string]bool\r\n   475\t\timportStack  []string\r\n   476\t}\r\n   477\t\r\n   478\tfunc (l *configLoader) loadFile(absPath string, isRoot bool) error {\r\n   479\t\tfor _, p := range l.importStack {\r\n   480\t\t\tif p == absPath {\r\n   481\t\t\t\tchain := append([]string{}, l.importStack...)\r\n   482\t\t\t\tchain = append(chain, absPath)\r\n   483\t\t\t\treturn fmt.Errorf(\"circular import detected: %s\", strings.Join(chain, \" -> \"))\r\n   484\t\t\t}\r\n   485\t\t}\r\n   486\t\tl.importStack = append(l.importStack, absPath)\r\n   487\t\tdefer func() { l.importStack = l.importStack[:len(l.importStack)-1] }()\r\n   488\t\r\n   489\t\tvar fileCfg C"]
[3436.129546, "o", "onfig\r\n   490\t\tif _, err := toml.DecodeFile(absPath, &fileCfg); err != nil {\r\n   491\t\t\treturn err\r\n   492\t\t}\r\n   493\t\r\n   494\t\tif isRoot {\r\n   495\t\t\tl.pipelineName = fileCfg.Pipeline.Name\r\n   496\t\t\tl.rootImports = fileCfg.Pipeline.Imports\r\n   497\t\t}\r\n   498\t\r\n   499\t\tfor k, v := range fileCfg.Variables {\r\n   500\t\t\tif _, exists := l.variables[k]; !exists {\r\n   501\t\t\t\tl.variables[k] = v\r\n   502\t\t\t}\r\n   503\t\t}\r\n   504\t\r\n   505\t\tfor _, imp := range fileCfg.Pipeline.Imports {\r\n"]
