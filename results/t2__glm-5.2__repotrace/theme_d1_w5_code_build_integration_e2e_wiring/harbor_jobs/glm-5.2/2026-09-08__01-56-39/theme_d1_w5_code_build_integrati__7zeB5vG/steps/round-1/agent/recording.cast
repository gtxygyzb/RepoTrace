[7056.236991, "o", "\t\t}\r\n\t}\r\n}\r\n\r\ntype buildPath struct {\r\n\tnames  []string\r\n\tweight int64\r\n}\r\n\r\nfunc computeBuildProfile(targets []BuildTargetReport, cfg *Config, targetMap map[string]*TargetConfig) *BuildProfile {\r\n\tdurationByName := map[string]int64{}\r\n\tsuccessful := map[string]bool{}\r\n\thasBuilt := false"]
