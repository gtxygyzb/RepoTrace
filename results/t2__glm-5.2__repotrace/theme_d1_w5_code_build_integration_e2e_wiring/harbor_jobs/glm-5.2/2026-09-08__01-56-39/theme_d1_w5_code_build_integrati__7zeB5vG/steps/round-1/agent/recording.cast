[5430.630996, "i", "python3 -c 'from pathlib import Path; Path(\"/tmp/deps_test.toml\").write_text(\"\"\"[[targets]]\\nname = \"lib1\"\\ninputs = [\"a.txt\"]\\ndependencies = []\\n\\n[[targets]]\\nname = \"lib2\"\\ninputs = [\"b.txt\"]\\ndependencies = []\\n\\n[[targets]]\\nname = \"mid1\"\\ndependencies = [\"lib1\", \"lib2\"]\\n\\n[[targets]]\\nname = \"mid2\"\\ndependencies = [\"lib1\"]\\n\\n[[targets]]\\nname = \"app\"\\ninputs = [\"c.txt\"]\\ndependencies = [\"mid1\", \"mid2\"]\\n\\n[[targets]]\\nname = \"test\"\\ndependencies = [\"app\"]\\n\"\"\")'\n"]
[5430.726445, "o", "python3 -c 'from pathlib import Path; Path(\"/tmp/deps_test.toml\").write_text(\"\"\"[[targets]]\\nname = \"lib1\"\\ninputs = [\"a.txt\"]\\ndependencies = []\\n\\n[[targets]]\\nname = \"lib2\"\\ninputs = [\"b.txt\"]\\ndependencies = []\\n\\n[[targets]]\\nname = \"mid1\"\\ndependencies = [\"lib1\", \"lib2\"]\\n\\n[[targets]]\\nname = \"mid2\"\\ndependencies = [\"lib1\"]\\n\\n[[targets]]\\nname = \"app\"\\ninputs = [\"c.txt\"]\\ndependencies = [\"mid1\", \"mid2\"]\\n\\n[[targets]]\\nname = \"test\"\\ndependencies = [\"app\"]\\n\"\"\")'\r\n"]
[5431.254065, "i", "python3 -c 'import json, subprocess, sys\\ndef run(args, expect_exit=0):\\n    p = subprocess.run([\"go\", \"run\", \".\"] + args, capture_output=True, text=True)\\n    if p.returncode != expect_exit:\\n        print(\"unexpected exit\", p.returncode, \"for\", args, file=sys.stderr)\\n        print(\"stdout:\", p.stdout, file=sys.stderr)\\n        print(\"stderr:\", p.stderr, file=sys.stderr)\\n        sys.exit(1)\\n    if p.stdout.strip() == \"\":\\n        return None\\n    return json.loads(p.stdout)\\n\\ncfg = \"/tmp/deps_test.toml\"\\n\\nbasic = run([\"deps\", \"--config\", cfg, \"app\"])\\nassert basic == {\\n    \"target\": \"app\",\\n    \"direct_deps\": [\"mid1\", \"mid2\"],\\n    \"transitive_deps\": [\"lib1\", \"lib2\", \"mid1\", \"mid2\"],\\n    \"reverse_deps\": [\"test\"],\\n}, basic\\n\\nwhy1 = run([\"deps\", \"--config\", cfg, \"--why\", \"app\", \"lib1\"])\\nassert why1 == {\\n    \"from\": \"app\",\\n    \"to\": \"lib1\",\\n    \"paths\": [[\"app\", \"mid1\", \"lib1\"], [\"app\", \"mid2\", \"lib1\"]],\\n}, why1\\n\\nwhy2 = run([\"deps\", \"--config\", cfg, \"--why\", \"app\", \"lib2\"])\\nassert why2[\"paths\"]"]
