[4761.036911, "o", "func allDependencyPaths(targetMap map[string]*TargetConfig, from, to string) [][]string {\r\n\u001b[?2004l\r"]
[4761.036977, "o", "\u001b[?2004h> "]
[4761.037109, "o", "    var paths [][]string\r\n\u001b[?2004l\r"]
[4761.037159, "o", "\u001b[?2004h> "]
[4761.037319, "o", "    var current []string\r\n\u001b[?2004l\r"]
[4761.037382, "o", "\u001b[?2004h> "]
[4761.03757, "o", "    visited := map[string]bool{}\r\n\u001b[?2004l\r"]
[4761.037635, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4761.037699, "o", "\u001b[?2004h> "]
[4761.037848, "o", "    var dfs func(node string)\r\n\u001b[?2004l\r"]
[4761.03791, "o", "\u001b[?2004h> "]
[4761.038074, "o", "    dfs = func(node string) {\r\n\u001b[?2004l\r"]
[4761.038135, "o", "\u001b[?2004h> "]
[4761.038296, "o", "        if visited[node] {\r\n\u001b[?2004l\r"]
[4761.038355, "o", "\u001b[?2004h> "]
[4761.038455, "o", "            return\r\n\u001b[?2004l\r"]
[4761.038508, "o", "\u001b[?2004h> "]
[4761.038573, "o", "        }\r\n\u001b[?2004l\r"]
[4761.038632, "o", "\u001b[?2004h> "]
[4761.038852, "o", "        current = append(current, node)\r\n\u001b[?2004l\r"]
[4761.038898, "o", "\u001b[?2004h> "]
[4761.039075, "o", "        visited[node] = true\r\n\u001b[?2004l\r"]
[4761.039129, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4761.039178, "o", "\u001b[?2004h> "]
[4761.039441, "o", "        if node == to && len(current) > 1 {\r\n\u001b[?2004l\r"]
[4761.039488, "o", "\u001b[?2004h> "]
[4761.039792, "o", "            path := make([]string, len(current))\r\n\u001b[?2004l\r"]
[4761.039836, "o", "\u001b[?2004h> "]
[4761.040029, "o", "            copy(path, current)\r\n\u001b[?2004l\r"]
[4761.040083, "o", "\u001b[?2004h> "]
[4761.040325, "o", "            paths = append(paths, path)\r\n\u001b[?2004l\r"]
[4761.040388, "o", "\u001b[?2004h> "]
[4761.040564, "o", "        } else if node != to {\r\n\u001b[?2004l\r"]
[4761.040626, "o", "\u001b[?2004h> "]
[4761.04107, "o", "            for _, dep := range uniqueStrings(targetMap[node].Dependencies) {\r\n\u001b[?2004l\r"]
[4761.041136, "o", "\u001b[?2004h> "]
[4761.041291, "o", "                dfs(dep)\r\n\u001b[?2004l\r"]
[4761.041348, "o", "\u001b[?2004h> "]
[4761.041429, "o", "            }\r\n\u001b[?2004l\r"]
[4761.041478, "o", "\u001b[?2004h> "]
[4761.041548, "o", "        }\r\n\u001b[?2004l\r"]
[4761.0416, "o", "\u001b[?2004h> \r\n"]
[4761.041658, "o", "\u001b[?2004l\r\u001b[?2004h"]
[4761.041716, "o", "> "]
[4761.04191, "o", "        current = current[:len(current)-1]\r\n\u001b[?2004l\r"]
[4761.041956, "o", "\u001b[?2004h> "]
[4761.04215, "o", "        delete(visited, node)\r\n\u001b[?2004l\r"]
[4761.042218, "o", "\u001b[?2004h>     }\r\n"]
[4761.042276, "o", "\u001b[?2004l\r\u001b[?2004h"]
[4761.042357, "o", "> "]
[4761.042412, "o", "    dfs(from)\r\n\u001b[?2004l\r"]
[4761.042465, "o", "\u001b[?2004h> "]
[4761.042551, "o", "    return paths\r\n\u001b[?2004l\r"]
[4761.042606, "o", "\u001b[?2004h> "]
[4761.04266, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.042714, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.042767, "o", "> "]
[4761.042937, "o", "func sortPaths(paths [][]string) {\r\n\u001b[?2004l\r"]
[4761.043, "o", "\u001b[?2004h> "]
[4761.043252, "o", "    sort.Slice(paths, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[4761.043307, "o", "\u001b[?2004h> "]
[4761.043556, "o", "        if len(paths[i]) != len(paths[j]) {\r\n\u001b[?2004l\r"]
[4761.043611, "o", "\u001b[?2004h> "]
[4761.043782, "o", "            return len(paths[i]) < len(paths[j])\r\n\u001b[?2004l\r"]
[4761.04384, "o", "\u001b[?2004h> "]
[4761.043894, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.044156, "o", "        for k := 0; k < len(paths[i]) && k < len(paths[j]); k++ {\r\n\u001b[?2004l\r"]
[4761.04421, "o", "\u001b[?2004h> "]
[4761.04437, "o", "            if paths[i][k] != paths[j][k] {\r\n\u001b[?2004l\r"]
[4761.044428, "o", "\u001b[?2004h> "]
[4761.044604, "o", "                return paths[i][k] < paths[j][k]\r\n\u001b[?2004l\r"]
[4761.044657, "o", "\u001b[?2004h> "]
[4761.044707, "o", "            }\r\n\u001b[?2004l\r"]
[4761.04476, "o", "\u001b[?2004h> "]
[4761.044814, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.044896, "o", "        return false\r\n\u001b[?2004l\r"]
[4761.04495, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
[4761.045003, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4761.045057, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.045111, "o", "> "]
[4761.045373, "o", "func topologicalOrderSubset(cfg *Config, subset map[string]bool) []string {\r\n\u001b[?2004l\r"]
[4761.045428, "o", "\u001b[?2004h> "]
[4761.045528, "o", "    indeg := map[string]int{}\r\n\u001b[?2004l\r"]
[4761.045582, "o", "\u001b[?2004h> "]
[4761.04568, "o", "    for name := range subset {\r\n\u001b[?2004l\r"]
[4761.045751, "o", "\u001b[?2004h> "]
[4761.045827, "o", "        indeg[name] = 0\r\n\u001b[?2004l\r"]
[4761.04588, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4761.045933, "o", "\u001b[?2004h> "]
[4761.046064, "o", "    for _, t := range cfg.Targets {\r\n\u001b[?2004l\r"]
[4761.046117, "o", "\u001b[?2004h> "]
[4761.046213, "o", "        if !subset[t.Name] {\r\n\u001b[?2004l\r"]
[4761.046299, "o", "\u001b[?2004h> "]
[4761.046344, "o", "            continue\r\n\u001b[?2004l\r"]
[4761.046397, "o", "\u001b[?2004h> "]
[4761.046471, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.046678, "o", "        for _, dep := range uniqueStrings(t.Dependencies) {\r\n\u001b[?2004l\r"]
[4761.046732, "o", "\u001b[?2004h> "]
[4761.046826, "o", "            if subset[dep] {\r\n\u001b[?2004l\r"]
[4761.046892, "o", "\u001b[?2004h> "]
[4761.046988, "o", "                indeg[t.Name]++\r\n\u001b[?2004l\r"]
[4761.047042, "o", "\u001b[?2004h> "]
[4761.047096, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.047153, "o", "        }\r\n\u001b[?2004l\r"]
[4761.047216, "o", "\u001b[?2004h> "]
[4761.04728, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.047333, "o", "> "]
[4761.047394, "o", "    queue := []string{}\r\n\u001b[?2004l\r"]
[4761.047447, "o", "\u001b[?2004h> "]
[4761.047551, "o", "    for name := range subset {\r\n\u001b[?2004l\r"]
[4761.047605, "o", "\u001b[?2004h> "]
[4761.047704, "o", "        if indeg[name] == 0 {\r\n\u001b[?2004l\r"]
[4761.047758, "o", "\u001b[?2004h> "]
[4761.047887, "o", "            queue = append(queue, name)\r\n\u001b[?2004l\r"]
[4761.04794, "o", "\u001b[?2004h> "]
[4761.047994, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.048048, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.048101, "o", "> "]
[4761.048164, "o", "    sort.Strings(queue)\r\n\u001b[?2004l\r"]
[4761.048219, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.048349, "o", "    order := []string{}\r\n\u001b[?2004l\r"]
[4761.048403, "o", "\u001b[?2004h> "]
[4761.048485, "o", "    for len(queue) > 0 {\r\n\u001b[?2004l\r"]
[4761.048537, "o", "\u001b[?2004h> "]
[4761.048616, "o", "        name := queue[0]\r\n\u001b[?2004l\r"]
[4761.04867, "o", "\u001b[?2004h> "]
[4761.048758, "o", "        queue = queue[1:]\r\n\u001b[?2004l\r"]
[4761.048812, "o", "\u001b[?2004h> "]
[4761.048926, "o", "        order = append(order, name)\r\n\u001b[?2004l\r"]
[4761.04898, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.049008, "o", "> "]
[4761.049181, "o", "        for _, t := range cfg.Targets {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.049325, "o", "            if !subset[t.Name] {\r\n\u001b[?2004l\r"]
[4761.049383, "o", "\u001b[?2004h> "]
[4761.049454, "o", "                continue\r\n\u001b[?2004l\r"]
[4761.049507, "o", "\u001b[?2004h> "]
[4761.049563, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.049616, "o", "> "]
[4761.049834, "o", "            for _, dep := range uniqueStrings(t.Dependencies) {\r\n\u001b[?2004l\r"]
[4761.049887, "o", "\u001b[?2004h> "]
[4761.049996, "o", "                if dep == name {\r\n\u001b[?2004l\r"]
[4761.050049, "o", "\u001b[?2004h> "]
[4761.050174, "o", "                    indeg[t.Name]--\r\n\u001b[?2004l\r"]
[4761.050237, "o", "\u001b[?2004h> "]
[4761.050387, "o", "                    if indeg[t.Name] == 0 {\r\n\u001b[?2004l\r"]
[4761.05044, "o", "\u001b[?2004h> "]
[4761.050632, "o", "                        queue = append(queue, t.Name)\r\n\u001b[?2004l\r"]
[4761.050685, "o", "\u001b[?2004h> "]
[4761.050765, "o", "                    }\r\n\u001b[?2004l\r"]
[4761.050818, "o", "\u001b[?2004h> "]
[4761.050907, "o", "                    break\r\n\u001b[?2004l\r"]
[4761.050964, "o", "\u001b[?2004h> "]
[4761.051025, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.051078, "o", "> "]
[4761.051131, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.051191, "o", "        }\r\n\u001b[?2004l\r"]
[4761.051253, "o", "\u001b[?2004h> "]
[4761.051349, "o", "        sort.Strings(queue)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.051408, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.051462, "o", "> "]
[4761.051516, "o", "    return order\r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.051578, "o", "> }\r\n\u001b[?2004l\r"]
[4761.05163, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.052147, "o", "func buildRebuildLayers(targetMap map[string]*TargetConfig, affected map[string]bool, direct map[string]bool) [][]map[string]interface{} {\r\n\u001b[?2004l\r"]
[4761.052213, "o", "\u001b[?2004h> "]
[4761.052316, "o", "    layer := map[string]int{}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.052378, "o", "> \r\n\u001b[?2004l\r"]
[4761.052432, "o", "\u001b[?2004h> "]
[4761.052573, "o", "    var resolve func(name string) int\r\n\u001b[?2004l\r"]
[4761.052628, "o", "\u001b[?2004h> "]
[4761.052758, "o", "    resolve = func(name string) int {\r\n\u001b[?2004l\r"]
[4761.052812, "o", "\u001b[?2004h> "]
[4761.052938, "o", "        if l, ok := layer[name]; ok {\r\n\u001b[?2004l\r"]
[4761.052991, "o", "\u001b[?2004h> "]
[4761.05306, "o", "            return l\r\n\u001b[?2004l\r"]
[4761.053113, "o", "\u001b[?2004h> "]
[4761.053167, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.053283, "o", "        maxDepLayer := -1\r\n\u001b[?2004l\r"]
[4761.053337, "o", "\u001b[?2004h> "]
[4761.053592, "o", "        for _, dep := range uniqueStrings(targetMap[name].Dependencies) {\r\n\u001b[?2004l\r"]
[4761.053645, "o", "\u001b[?2004h> "]
[4761.053747, "o", "            if affected[dep] {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4761.0538, "o", "> "]
[4761.053883, "o", "                depLayer := resolve(dep)\r\n\u001b[?2004l\r"]
[4761.053948, "o", "\u001b[?2004h> "]
[4761.054036, "o", "                if depLayer > maxDepLayer {\r\n\u001b[?2004l\r"]
[4761.054089, "o", "\u001b[?2004h> "]
[4761.054177, "o", "                    maxDepLayer = depLayer\r\n\u001b[?2004l\r"]
[4761.054236, "o", "\u001b[?2004h> "]
[4761.054307, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[4761.054364, "o", "\u001b[?2004h> "]
[4761.054417, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.054512, "o", "        layer[name] = maxDepLayer + 1\r\n\u001b[?2004l\r"]
[4761.054566, "o", "\u001b[?2004h> "]
[4761.054613, "o", "        return layer[name]\r\n\u001b[?2004l\r"]
[4761.054666, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4761.054719, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4761.054806, "o", "    for name := range affected {\r\n\u001b[?2004l\r"]
[4761.054859, "o", "\u001b[?2004h> "]
