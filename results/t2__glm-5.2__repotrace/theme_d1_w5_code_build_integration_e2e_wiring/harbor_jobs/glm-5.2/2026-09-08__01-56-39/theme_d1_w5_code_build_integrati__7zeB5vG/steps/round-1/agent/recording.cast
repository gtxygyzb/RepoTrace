[6817.983479, "o", "\t\t\tsummary.Failed++\r\n\t\tcase \"skipped\":\r\n\t\t\tsummary.Skipped++\r\n\t\tcase \"cancelled\":\r\n\t\t\tsummary.Cancelled++\r\n\t\t}\r\n\t}\r\n"]
