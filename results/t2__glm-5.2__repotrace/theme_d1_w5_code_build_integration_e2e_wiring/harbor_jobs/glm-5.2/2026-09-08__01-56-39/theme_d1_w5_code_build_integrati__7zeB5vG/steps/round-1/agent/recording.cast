[7247.119644, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('main.go')\ns = p.read_text()\nold = '''type TargetConfig struct {\n\\tName         string            `toml:\"name\"`\n\\tCommand      string            `toml:\"command\"`\n\\tDependencies []string          `toml:\"dependencies\"`\n\\tInputs       []string          `toml:\"inputs\"`\n\\tOutputs      []string          `toml:\"outputs\"`\n\\tEnv          map[string]string `toml:\"env\"`\n\\tPreBuild     []string          `toml:\"pre_build\"`\n\\tPostBuild    []string          `toml:\"post_build\"`\n\\tTimeout      int               `toml:\"timeout\"`\n}'''\nnew = '''type TargetConfig struct {\n\\tName          string            `toml:\"name\"`\n\\tCommand       string            `toml:\"command\"`\n\\tDependencies  []string          `toml:\"dependencies\"`\n\\tInputs        []string          `toml:\"inputs\"`\n\\tOutputs       []string          `toml:\"outputs\"`\n\\tEnv           map[string]string `toml:\"env\"`\n\\tPreBuild      []string          `toml:\"pre_build\"`\n\\tPostBuild     []string          `toml:\"post_build\"`\n\\tTim"]
