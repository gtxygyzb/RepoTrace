[1091.943638, "o", "fmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n\u001b[?2004l\r"]
[1091.943663, "o", "\u001b[?2004h"]
[1091.943835, "o", "> "]
[1091.94394, "o", "\u0007\r\ngo.mod         go.sum         main.go        pipeline.toml  \r\n> os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1091.944041, "o", "\u0007}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1091.944143, "o", "\u0007"]
[1091.94426, "o", "if *parallel < 1 {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007"]
[1091.944366, "o", "\r\ngo.mod         go.sum         main.go        pipeline.toml  \r\n> "]
[1091.9445, "o", "fmt.Fprintln(os.Stderr, \"error: --parallel must be at least 1\")\r\n\u001b[?2004l\r"]
[1091.944612, "o", "\u001b[?2004h> "]
[1091.944718, "o", "\u0007\r\ngo.mod         go.sum         main.go        pipeline.toml  \r\n> "]
[1091.944825, "o", "os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1091.944926, "o", "\u0007}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1091.945026, "o", "\u0007"]
[1091.945267, "o", "if err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath); err != nil {\r\n\u001b[?2004l\r"]
[1091.945399, "o", "\u001b[?2004h> \u0007\r\ngo.mod         go.sum         main.go        pipeline.toml  \r\n> "]
