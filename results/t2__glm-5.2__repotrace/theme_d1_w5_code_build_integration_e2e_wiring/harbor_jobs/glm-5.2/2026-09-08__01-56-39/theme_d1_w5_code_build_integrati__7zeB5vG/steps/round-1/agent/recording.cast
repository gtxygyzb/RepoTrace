[4518.357082, "o", "\r\n    23\t\r\n    24\t\t\"github.com/BurntSushi/toml\"\r\n    25\t)\r\n    26\t\r\n    27\ttype stringSliceFlag []string\r\n    28\t\r\n    29\tfunc (s *stringSliceFlag) String() string {\r\n    30\t\treturn strings.Join(*s, \",\")\r\n    31\t}\r\n    32\t\r\n"]
[4518.357147, "o", "    33\tfunc (s *stringSliceFlag) Set(value string) error {\r\n    34\t\t*s = append(*s, value)\r\n    35\t\treturn nil\r\n    36\t}\r\n    37\t\r\n    38\ttype PipelineConfig struct {\r\n    39\t\tName    string   `toml:\"name\"`\r\n    40\t\tImports []string `toml:\"imports\"`\r\n    41\t}\r\n    42\t\r\n"]
[4518.357208, "o", "    43\ttype TargetConfig struct {\r\n    44\t\tName         string            `toml:\"name\"`\r\n    45\t\tCommand      string            `toml:\"command\"`\r\n    46\t\tDependencies []string          `toml:\"dependencies\"`\r\n    47\t\tInputs       []string          `toml:\"inputs\"`\r\n    48\t\tOutputs      []string          `toml:\"outputs\"`\r\n    49\t\tEnv          map[string]string `toml:\"env\"`\r\n    50\t\tPreBuild     []string          `toml:\"pre_build\"`\r\n    51"]
[4518.357291, "o", "\t\tPostBuild    []string          `toml:\"post_build\"`\r\n    52\t\tTimeout      int               `toml:\"timeout\"`\r\n    53\t}\r\n    54\t\r\n    55\ttype Config struct {\r\n    56\t\tPipeline  PipelineConfig    `toml:\"pipeline\"`\r\n    57\t\tTargets   []TargetConfig    `toml:\"targets\"`\r\n    58\t\tVariables map[string]string `toml:\"variables\"`\r\n    59\t}\r\n"]
[4518.357352, "o", "    60\t\r\n    61\ttype CacheEntry struct {\r\n    62\t\tCacheKey   string   `json:\"cache_key\"`\r\n    63\t\tTargetName string   `json:\"target_name\"`\r\n    64\t\tTimestamp  string   `json:\"timestamp\"`\r\n    65\t\tOutputs    []string `json:\"outputs\"`\r\n    66\t}\r\n    67\t\r\n    68\ttype BuildTargetReport struct {\r\n"]
[4518.357414, "o", "    69\t\tName       string `json:\"name\"`\r\n    70\t\tStatus     string `json:\"status\"`\r\n    71\t\tCached     bool   `json:\"cached\"`\r\n    72\t\tDurationMS int64  `json:\"duration_ms\"`\r\n    73\t\tCacheKey   string `json:\"cache_key\"`\r\n    74\t}\r\n    75\t\r\n    76\ttype BuildReport struct {\r\n    77\t\t"]
[4518.35747, "o", "Pipeline string              `json:\"pipeline\"`\r\n    78\t\tTargets  []BuildTargetReport `json:\"targets\"`\r\n    79\t\tSummary  BuildSummary        `json:\"summary\"`\r\n    80\t}\r\n    81\t\r\n    82\ttype BuildSummary struct {\r\n    83\t\tTotal      int   `json:\"total\"`\r\n    84\t\tBuilt      int   `json:\"built\"`\r\n    85\t"]
[4518.357502, "o", "\tCached     int   `json:\"cached\"`\r\n    86\t\tFailed     int   `json:\"failed\"`\r\n    87\t\tSkipped    int   `json:\"skipped\"`\r\n    88\t\tDurationMS int64 `json:\"duration_ms\"`\r\n    89\t}\r\n"]
