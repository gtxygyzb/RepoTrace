[6615.147763, "o", "   532\t}\r\n   533\t\r\n   534\tfunc (l *configLoader) loadFile(absPath string, isRoot bool) error {\r\n   535\t\tfor _, p := range l.importStack {\r\n   536\t\t\tif p == absPath {\r\n   537\t\t\t\tchain := append([]string{}, l.importStack...)\r\n   538\t\t\t\tchain = append(chain, absPath)\r\n"]
[6615.147829, "o", "   539\t\t\t\treturn fmt.Errorf(\"circular import detected: %s\", strings.Join(chain, \" -> \"))\r\n   540\t\t\t}\r\n   541\t\t}\r\n   542\t\tl.importStack = append(l.importStack, absPath)\r\n   543\t\tdefer func() { l.importStack = l.importStack[:len(l.importStack)-1] }()\r\n   544\t\r\n   545\t\tvar fileCfg Config\r\n   546\t\tif _, err := toml.DecodeFile(absPath, &fileCfg); err != nil {\r\n   547\t\t\treturn err\r\n   548\t\t}\r\n   549\t\r\n"]
[6615.147889, "o", "   550\t\tif isRoot {\r\n   551\t\t\tl.pipelineName = fileCfg.Pipeline.Name\r\n   552\t\t\tl.rootImports = fileCfg.Pipeline.Imports\r\n   553\t\t}\r\n   554\t\r\n   555\t\tfor k, v := range fileCfg.Variables {\r\n   556\t\t\tif _, exists := l.variables[k]; !exists {\r\n   557\t\t\t\tl.variables[k] = v\r\n"]
[6615.147953, "o", "   558\t\t\t}\r\n   559\t\t}\r\n   560\t\r\n   561\t\tfor _, imp := range fileCfg.Pipeline.Imports {\r\n   562\t\t\texpanded, err := expandString(imp, l.variables, make(map[string]bool))\r\n   563\t"]
[6615.148014, "o", "\t\tif err != nil {\r\n   564\t\t\t\treturn err\r\n   565\t\t\t}\r\n   566\t\t\timportPath := expanded\r\n   567\t\t\tif !filepath.IsAbs(importPath) {\r\n   568\t\t\t\timportPath = filepath.Join(filepath.Dir(absPath), importPath)\r\n   569\t\t\t}\r\n   570\t\t\timportAbs, err := filepath.Abs(importPath)\r\n   571\t\t\tif err != nil {\r\n   572\t\t\t\treturn err\r\n   573\t\t\t}\r\n"]
[6615.148071, "o", "   574\t\t\tif err := l.loadFile(importAbs, false); err != nil {\r\n   575\t\t\t\treturn err\r\n   576\t\t\t}\r\n   577\t\t}\r\n   578\t\r\n   579\t\tfor _, t := range fileCfg.Targets {\r\n   580\t\t\tif l.targetNames[t.Name] {\r\n   581\t\t\t\treturn fmt.Errorf(\"duplicate target name %q\", t.Name)\r\n   582\t\t\t}\r\n   583\t\t\tl.targetNames[t.Name] = true\r\n   584"]
[6615.148132, "o", "\t\t\tl.targets = append(l.targets, t)\r\n   585\t\t}\r\n   586\t\r\n   587\t\treturn nil\r\n   588\t}\r\n   589\t\r\n   590\tfunc parseVarOverrides(vars []string) (map[string]string, error) {\r\n   591\t\tm := make(map[string]string)\r\n"]
[6615.148192, "o", "   592\t\tfor _, v := range vars {\r\n   593\t\t\tidx := strings.Index(v, \"=\")\r\n   594\t\t\tif idx == -1 {\r\n   595\t\t\t\treturn nil, fmt.Errorf(\"invalid --var %q, expected key=value\", v)\r\n   596\t\t\t}\r\n   597\t\t\tkey := v[:idx]\r\n   598\t\t\tif key == \"\" {\r\n   599\t\t\t\treturn nil, fmt.Errorf(\"invalid --var %q, empty key\", v)\r\n   600\t\t\t}\r\n"]
[6615.148288, "o", "   601\t\t\tm[key] = v[idx+1:]\r\n   602\t\t}\r\n   603\t\treturn m, nil\r\n   604\t}\r\n   605\t\r\n   606\tfunc expandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {\r\n   607\t\tvar b strings.Builder\r\n   608\t\ti := 0\r\n   609\t\tfor i < len(s) {\r\n   610\t\t\tif i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {\r\n   611\t\t\t\tend := strings.Index(s[i:], \"}\")\r\n   612\t\t\t\tif end == -1 {\r\n   613\t\t\t\t\t"]
[6615.148351, "o", "return \"\", fmt.Errorf(\"unterminated variable reference in %q\", s)\r\n   614\t\t\t\t}\r\n   615\t\t\t\tname := s[i+2 : i+end]\r\n   616\t\t\t\tif name == \"\" {\r\n   617\t\t\t\t\treturn \"\", fmt.Errorf(\"empty variable reference in %q\", s)\r\n   618\t\t\t\t}\r\n   619\t\t\t\tif visiting[name] {\r\n   620\t\t\t\t\treturn \"\", fmt.Errorf(\"variable cycle detected: %q\", name)\r\n"]
[6615.148413, "o", "   621\t\t\t\t}\r\n   622\t\t\t\tval, ok := vars[name]\r\n   623\t\t\t\tif !ok {\r\n   624\t\t\t\t\treturn \"\", fmt.Errorf(\"unresolved variable %q\", name)\r\n   625\t\t\t\t}\r\n   626\t\t\t\tvisiting[name] = true\r\n   627\t\t\t\texpanded, err := expandString(val, vars, visiting)\r\n   628\t\t\t\tif err != nil {\r\n   629\t\t\t\t\treturn \"\", err\r\n   630\t\t\t\t}\r\n   631\t\t\t\tdelete(visiting, name)\r\n"]
[6615.14847, "o", "   632\t\t\t\tb.WriteString(expanded)\r\n   633\t\t\t\ti += end + 1\r\n   634\t\t\t} else {\r\n   635\t\t\t\tb.WriteByte(s[i])\r\n   636\t\t\t\ti++\r\n   637\t\t\t}\r\n   638\t\t}\r\n   639\t\treturn b.String(), nil\r\n   640\t}\r\n"]
