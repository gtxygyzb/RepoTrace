[7056.535993, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc runDepsCommand(args []string) {\r\n\tconfigPath := \"\"\r\n\twhy := false\r\n\taffected := false\r\n\tplan := false\r\n\tvar vars stringSliceFlag\r\n\tpositional := []string{}\r\n\r\n\ti := 0\r\n\tfor i < len(args) {\r\n\t\targ := args[i]\r\n\t\tswitch {\r\n\t\tcase arg == \"--config\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t"]
[7056.536093, "o", "\tfmt.Fprintln(os.Stderr, \"error: --config requires a value\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tconfigPath = args[i+1]\r\n\t\t\ti += 2\r\n\t\tcase strings.HasPrefix(arg, \"--config=\"):\r\n\t\t\tconfigPath = arg[len(\"--config=\"):]\r\n\t\t\ti++\r\n\t\tcase arg == \"--var\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --var requires a value\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tif err := vars.Set(args[i+1]); err != nil {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ti += 2\r\n\t\tcase strings.HasPrefix(arg, \"--var=\"):\r\n\t\t"]
[7056.536172, "o", "\tif err := vars.Set(arg[len(\"--var=\"):]); err != nil {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ti++\r\n\t\tcase arg == \"--why\":\r\n\t\t\twhy = true\r\n\t\t\ti++\r\n\t\tcase arg == \"--affected\":\r\n\t\t\taffected = true\r\n\t\t\ti++\r\n\t\t"]
[7056.536288, "o", "case arg == \"--plan\":\r\n\t\t\tplan = true\r\n\t\t\ti++\r\n\t\tdefault:\r\n\t\t\tpositional = append(positional, arg)\r\n\t\t\ti++\r\n\t\t}\r\n\t}\r\n\r\n\tif configPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif plan && !affected {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --plan requires --affected\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif err := runDeps(configPath, []string(vars), positional, why, affected, plan); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n"]
[7056.536359, "o", "\r\nfunc runDeps(configPath string, vars []string, args []string, why, affected, plan bool) error {\r\n\tcfg, _, err := loadConfig(configPath, vars)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\ttargetMap, err := validateConfig(cfg)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n\tif affected {\r\n\t\tif len(args) == 0 {\r\n\t\t\treturn fmt.Errorf(\"--affected requires at least one FILE\")\r\n\t\t}\r\n\t\treturn runDepsAffected(cfg, targetMap, args, plan)\r\n\t}\r\n\r\n\tif why {\r\n\t\tif len(args) != 2 {\r\n\t\t\treturn fmt.Errorf(\"--why requires exactly two target names: FROM TO\")\r\n\t\t}\r\n\t\treturn runDepsWhy(cfg, targetMa"]
[7056.536424, "o", "p, args[0], args[1])\r\n\t}\r\n\r\n\tif len(args) != 1 {\r\n\t\treturn fmt.Errorf(\"deps requires exactly one target name\")\r\n\t}\r\n\treturn runDepsTarget(cfg, targetMap, args[0])\r\n}\r\n\r\nfunc runDepsTarget(cfg *Config, targetMap map[string]*TargetConfig, target string) error {\r\n\tif _, ok := targetMap[target]; !ok {\r\n\t\tfailDepsJSON(fmt.Sprintf(\"target %q does not exist\", target))\r\n\t\treturn nil\r\n\t}\r\n\r\n\tdirectSet := map[string]bool{}\r\n\tfor _, dep := range uniqueStrings(targetMap[target].Dependencies) {\r\n\t\tdirectSet[dep] = true\r\n\t}\r\n\tdirect := sortedKeys(directSet)\r\n\r\n\ttransitiveSet := map[string]bool{}\r\n\tcollectTransitiveDeps(targetMap, target, transitiveSet)\r\n\tdelete(transitiveSet, target)\r\n"]
[7056.536486, "o", "\ttransitive := sortedKeys(transitiveSet)\r\n\r\n\treverseSet := map[string]bool{}\r\n\tfor _, t := range cfg.Targets {\r\n\t\tif t.Name == target {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tseen := map[string]bool{}\r\n\t\tif dependsOnTransitive(targetMap, t.Name, target, seen) {\r\n\t\t\treverseSet[t.Name] = true\r\n\t\t}\r\n\t}\r\n\treverse := sortedKeys(reverseSet)\r\n\r\n\treturn emitJSON(map[string]interface{}{\r\n\t\t\"target\":          target,\r\n\t\t\"direct_deps\":     direct,\r\n\t\t\"transitive_deps\": transitive,\r\n\t\t\"reverse_deps\":    reverse,\r\n\t})\r\n}\r\n\r\nfunc runDepsWhy(cfg *Config, targetMap map[string]*TargetConfig, from, to string) error {\r\n\tif _, ok := targetMap[from]; !ok {\r\n\t"]
[7056.536563, "o", "\tfailDepsJSON(fmt.Sprintf(\"target %q does not exist\", from))\r\n\t\treturn nil\r\n\t}\r\n\tif _, ok := targetMap[to]; !ok {\r\n\t\tfailDepsJSON(fmt.Sprintf(\"target %q does not exist\", to))\r\n\t\treturn nil\r\n\t}\r\n\r\n\tpaths := allDependencyPaths(targetMap, from, to)\r\n\tsortPaths(paths)\r\n\treturn emitJSON(map[string]interface{}{\r\n\t\t\"from\":  from,\r\n\t\t\"to\":    to,\r\n\t\t\"paths\": paths,\r\n\t})\r\n}\r\n\r\nfunc runDepsAffected(cfg *Config, targetMap map[string]*TargetConfig, files []string, plan bool) error {\r\n\tfileSet := map[string]bool{}\r\n\tfor _, f := range files {\r\n\t\tfileSet[f] = true\r\n\t}\r\n\r\n\taffectedSet := map[string]bool{}\r\n\tdirectAffected := map[string]bool{}\r\n\tfor i := range cfg.Targets {\r\n\t\tt := &cfg.Targets[i]\r\n\t\tfor _, input := range t.Inputs {\r\n\t\t\tif fileSet[input] {\r\n\t\t\t\taffectedSet[t.Name] = true\r\n\t\t\t\tdirectAffected[t.Name] = true\r\n\t"]
[7056.536642, "o", "\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tqueue := sortedKeys(affectedSet)\r\n\tfor len(queue) > 0 {\r\n\t\tname := queue[0]\r\n\t\tqueue = queue[1:]\r\n\t\tfor _, t := range cfg.Targets {\r\n\t\t\tif affectedSet[t.Name] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n\t\t\t\tif dep == name {\r\n\t\t\t\t\taffectedSet[t.Name] = true\r\n\t\t\t\t\tqueue = append(queue, t.Name)\r\n\t\t\t\t\tbreak\r\n\t\t\t"]
[7056.53671, "o", "\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif len(affectedSet) == 0 {\r\n\t\tif plan {\r\n\t\t\treturn emitJSON(map[string]interface{}{\"rebuild_plan\": []interface{}{}})\r\n\t\t}\r\n\t\treturn emitJSON(map[string]interface{}{\"rebuild_order\": []interface{}{}})\r\n\t}\r\n\r\n\tif plan {\r\n\t\tlayers := buildRebuildLayers(targetMap, affectedSet, directAffected)\r\n\t\treturn emitJSON(map[string]interface{}{\"rebuild_plan\": layers})\r\n\t}\r\n\r\n\torder := topologicalOrderSubset(cfg, affectedSet)\r\n\tentries := []map[string]interface{}{}\r\n\tfor _, name := range order {\r\n\t\tentries = append(entries, map[string]interface{}{\r\n\t\t\t\"target\": name,\r\n\t\t\t\"direct\": directAffected[name],\r\n\t\t})\r\n\t}\r\n\treturn emitJSON(map[string]interface{}{\"rebuild_order\": entries})\r\n}\r\n\r\nfunc collectTransitiveDeps(targetMap map[string]*TargetConfig, name string, seen map[string]bool) {\r\n\tfor _, dep := range uniqueStrings(targetMap[name].Dependencies) {\r\n\t\t"]
[7056.536776, "o", "if !seen[dep] {\r\n\t\t\tseen[dep] = true\r\n\t\t\tcollectTransitiveDeps(targetMap, dep, seen)\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc dependsOnTransitive(targetMap map[string]*TargetConfig, name, target string, seen map[string]bool) bool {\r\n\tif seen[name] {\r\n\t\treturn false\r\n\t}\r\n\tseen[name] = true\r\n\tfor _, dep := range uniqueStrings(targetMap[name].Dependencies) {\r\n\t\tif dep == target {\r\n\t\t\treturn true\r\n\t\t}\r\n\t\tif dependsOnTransitive(targetMap, dep, target, seen) {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\n"]
[7056.536838, "o", "func allDependencyPaths(targetMap map[string]*TargetConfig, from, to string) [][]string {\r\n\tpaths := [][]string{}\r\n\tvar current []string\r\n\tvisited := map[string]bool{}\r\n\r\n\tvar dfs func(node string)\r\n\tdfs = func(node string) {\r\n\t\tif visited[node] {\r\n\t\t\treturn\r\n\t\t}\r\n\t\tcurrent = append(current, node)\r\n\t\tvisited[node] = true\r\n\r\n\t\tif node == to && len(current) > 1 {\r\n\t\t\tpath := make([]string, len(current))\r\n\t\t\tcopy(path, current)\r\n\t\t\tpaths = append(paths, path)\r\n\t\t} else if node != to {\r\n"]
[7056.5369, "o", "\t\t\tfor _, dep := range uniqueStrings(targetMap[node].Dependencies) {\r\n\t\t\t\tdfs(dep)\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tcurrent = current[:len(current)-1]\r\n\t\tdelete(visited, node)\r\n\t}\r\n\tdfs(from)\r\n\treturn paths\r\n}\r\n\r\nfunc sortPaths(paths [][]string) {\r\n\tsort.Slice(paths, func(i, j int) bool {\r\n\t\tif len(paths[i]) != len(paths[j]) {\r\n\t\t\treturn len(paths[i]) < len(paths[j])\r\n\t\t"]
[7056.537022, "o", "}\r\n\t\tfor k := 0; k < len(paths[i]) && k < len(paths[j]); k++ {\r\n\t\t\tif paths[i][k] != paths[j][k] {\r\n\t\t\t\treturn paths[i][k] < paths[j][k]\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn false\r\n\t})\r\n}\r\n\r\nfunc topologicalOrderSubset(cfg *Config, subset map[string]bool) []string {\r\n\tindeg := map[string]int{}\r\n\tfor name := range subset {\r\n\t\tindeg[name] = 0\r\n\t}\r\n\tfor _, t := range cfg.Targets {\r\n\t\tif !subset[t.Name] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n\t\t\tif subset[dep] {\r\n\t\t\t\tindeg[t.Name]++\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tqueue := []string{}\r\n\tfor name := range subset {\r\n\t\tif indeg[name] == 0 {\r\n\t\t\tqueue = append(queue, name)\r\n\t\t}\r\n\t}\r\n\tsort.Strings(queue)\r\n\r\n\torder := []string{}\r\n\tfor len(queue) > 0 {\r\n\t\tname := queue[0]\r\n\t\tqueue = queue[1:]\r\n\t\torder = append(order, name)\r\n\r\n\t\tfor _, t := range cfg.Targets {\r\n\t\t\tif !subset[t.Name] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n\t\t"]
[7056.537087, "o", "\t\tif dep == name {\r\n\t\t\t\t\tindeg[t.Name]--\r\n\t\t\t\t\tif indeg[t.Name] == 0 {\r\n\t\t\t\t\t\tqueue = append(queue, t.Name)\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tsort.Strings(queue)\r\n\t}\r\n\treturn order\r\n}\r\n\r\n"]
[7056.537151, "o", "func buildRebuildLayers(targetMap map[string]*TargetConfig, affected map[string]bool, direct map[string]bool) [][]map[string]interface{} {\r\n\tlayer := map[string]int{}\r\n\r\n\tvar resolve func(name string) int\r\n\tresolve = func(name string) int {\r\n\t\tif l, ok := layer[name]; ok {\r\n\t\t\treturn l\r\n\t\t}\r\n\t\tmaxDepLayer := -1\r\n\t\tfor _, dep := range uniqueStrings(targetMap[name].Dependencies) {\r\n\t\t\tif affected[dep] {\r\n\t\t\t\tdepLayer := resolve(dep)\r\n\t\t\t\tif depLayer > maxDepLayer {\r\n\t\t\t\t\tmaxDepLayer = depLayer\r\n\t\t\t\t}"]
[7056.537209, "o", "\r\n\t\t\t}\r\n\t\t}\r\n\t\tlayer[name] = maxDepLayer + 1\r\n\t\treturn layer[name]\r\n\t}\r\n\r\n\tfor name := range affected {\r\n\t\tresolve(name)\r\n\t}\r\n\r\n\tmaxLayer := 0\r\n\tfor _, l := range layer {\r\n\t\tif l > maxLayer {\r\n\t\t\tmaxLayer = l\r\n\t\t}\r\n\t}\r\n\r\n\tlayers := make([][]map[string]interface{}, maxLayer+1)\r\n\tfor l := 0; l <= maxLayer; l++ {\r\n\t\tnames := []string{}\r\n\t\t"]
[7056.537282, "o", "for name, ll := range layer {\r\n\t\t\tif ll == l {\r\n\t\t\t\tnames = append(names, name)\r\n\t\t\t}\r\n\t\t}\r\n\t\tsort.Strings(names)\r\n\t\tfor _, name := range names {\r\n\t\t\tlayers[l] = append(layers[l], map[string]interface{}{\r\n\t\t\t\t\"target\": name,\r\n\t\t\t\t\"direct\": direct[name],\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn layers\r\n}\r\n\r\nfunc sortedKeys(m map[string]bool) []string {\r\n\tkeys := []string{}\r\n\tfor k := range m {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n\tsort.Strings(keys)\r\n\treturn keys"]
[7056.537343, "o", "\r\n}\r\n\r\nfunc emitJSON(v interface{}) error {\r\n\treturn json.NewEncoder(os.Stdout).Encode(v)\r\n}\r\n\r\nfunc failDepsJSON(msg string) {\r\n\tjson.NewEncoder(os.Stdout).Encode(map[string]string{\"error\": msg})\r\n\tos.Exit(1)\r\n}\r\n"]
