[4543.108485, "o", "   686\tfunc topologicalOrder(cfg *Config, requested map[string]bool) []string {\r\n   687\t\tindeg := map[string]int{}\r\n   688\t\tfor _, t := range cfg.Targets {\r\n   689\t\t\tif !requested[t.Name] {\r\n"]
[4543.108586, "o", "   690\t\t\t\tcontinue\r\n   691\t\t\t}\r\n   692\t\t\tcount := 0\r\n   693\t\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n   694\t\t\t\tif requested[dep] {\r\n   695\t\t\t\t\tcount++\r\n   696\t\t\t\t}\r\n   697\t\t\t}\r\n   698\t\t\tindeg[t.Name] = count\r\n   699\t\t}\r\n   700\t\r\n   701\t\tqueue := []string{}\r\n   702\t\tfor _, t := range cfg.Targets {\r\n"]
[4543.108662, "o", "   703\t\t\tif requested[t.Name] && indeg[t.Name] == 0 {\r\n   704\t\t\t\tqueue = append(queue, t.Name)\r\n   705\t\t\t}\r\n   706\t\t}\r\n   707\t\r\n   708\t\torder := []string{}\r\n   709\t\tfor len(queue) > 0 {\r\n   710\t\t\tname := queue[0]\r\n   711"]
[4543.108738, "o", "\t\t\tqueue = queue[1:]\r\n   712\t\t\torder = append(order, name)\r\n   713\t\t\tfor _, t := range cfg.Targets {\r\n   714\t\t\t\tif !requested[t.Name] {\r\n   715\t\t\t\t\tcontinue\r\n   716\t\t\t\t}\r\n   717\t\t\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n"]
[4543.108793, "o", "   718\t\t\t\t\tif dep == name {\r\n   719\t\t\t\t\t\tindeg[t.Name]--\r\n   720\t\t\t\t\t\tif indeg[t.Name] == 0 {\r\n   721\t\t\t\t\t\t\tqueue = append(queue, t.Name)\r\n"]
[4543.108845, "o", "   722\t\t\t\t\t\t}\r\n   723\t\t\t\t\t\tbreak\r\n   724\t\t\t\t\t}\r\n   725\t\t\t\t}\r\n"]
[4543.108897, "o", "   726\t\t\t}\r\n   727\t\t}\r\n   728\t\treturn order\r\n   729\t}\r\n   730\t\r\n"]
