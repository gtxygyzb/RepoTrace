[7332.847015, "o", "}\r\n\u001b[?2004l\r"]
[7332.84707, "o", "\u001b[?2004h> "]
[7332.84715, "o", "\u0007"]
[7332.847397, "o", "out := make(map[string]string, len(env))\r\n\u001b[?2004l\r"]
