[2053.611669, "o", "}\r\n   574\t\t\ts := status[dep]\r\n   575\t\t\tif s != \"built\" && s != \"cached\" {\r\n   576\t\t\t\treturn false\r\n   577\t\t\t}\r\n   578\t\t}\r\n   579\t\treturn true\r\n   580\t}\r\n   581\t\r\n   582\tfunc markSkipped(reverseDeps map[string][]string, status map[string]string, durations map[string]int64, completed *int, name string) {\r\n   583\t\tfor _, dependent := range reverseDeps[name] {\r\n   584\t\t\tif status[dependent] == \"\" {\r\n   585\t\t\t\tstatus[dependent] = \"skipped\"\r\n   586\t\t\t\tdurations[dependent] = 0\r\n   587\t\t\t\t*completed++\r\n   588\t\t\t\tmarkSkipped(reverseDeps, status, durations, completed, dependent)\r\n   589\t\t\t}\r\n   590\t\t}\r\n   591\t}\r\n   592\t\r\n   593\tfunc (e *buildExecutor) execute(t *TargetConfig) execResult {\r\n   594\t\tstart := time.Now()\r\n   595\t\tkey, err := computeCacheKey(t, e.configDir)\r\n   596\t\tif err != nil {\r\n   597\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n   598\t\t}\r\n   599\t\r\n   600\t\tif !e.noCache {\r\n"]
