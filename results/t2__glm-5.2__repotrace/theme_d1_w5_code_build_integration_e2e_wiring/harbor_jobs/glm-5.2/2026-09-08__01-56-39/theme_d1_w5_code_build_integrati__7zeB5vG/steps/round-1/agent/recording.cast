[1987.268973, "o", "    86\t\tname       string\r\n    87\t\tstatus     string\r\n    88\t\tcached     bool\r\n    89\t\tdurationMS int64\r\n    90\t\tcacheKey   string\r\n    91\t}\r\n    92\t\r\n    93\ttype buildExecutor struct {\r\n    94\t\tconfig    *Config\r\n    95\t\tconfigDir string\r\n    96\t\tcacheDir  string\r\n    97\t\tnoCache   bool\r\n    98\t}\r\n    99\t\r\n   100\tfunc main() {\r\n   101\t\tif len(os.Args) < 2 {\r\n   102\t\t\tfmt.Fprintln(os.Stderr, \"usage: buildctl <command> [flags]\")\r\n   103\t\t\tos.Exit(1)\r\n   104\t\t}\r\n   105\t\tswitch os.Args[1] {\r\n   106\t\tcase \"build\":\r\n   107\t\t\trunBuildCommand(os.Args[2:])"]
