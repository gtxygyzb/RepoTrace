[1971.440755, "o", "func uniqueStrings(in []string) []string {\r\n   800\t\tseen := map[string]bool{}\r\n   801\t\tout := []string{}\r\n   802\t\tfor _, s := range in {\r\n   803\t\t\tif !seen[s] {\r\n   804\t\t\t\tseen[s] = true\r\n   805\t\t\t\tout = append(out, s)\r\n   806\t\t\t}\r\n   807\t\t}\r\n   808\t\treturn out\r\n   809\t}\r\n"]
