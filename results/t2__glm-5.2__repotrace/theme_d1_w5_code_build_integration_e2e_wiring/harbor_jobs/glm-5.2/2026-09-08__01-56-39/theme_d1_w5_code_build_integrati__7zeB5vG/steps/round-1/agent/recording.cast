[7633.072096, "o", "  1103\tfunc (e *buildExecutor) execute(t *TargetConfig) execResult {\r\n  1104\t\tstart := time.Now()\r\n  1105\t\tkey, err := computeCacheKey(t, e.configDir)\r\n  1106\t\tif err != nil {\r\n  1107\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n"]
[7633.072219, "o", "  1108\t\t}\r\n  1109\t\r\n  1110\t\tif !e.noCache {\r\n  1111\t\t\tvalid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)\r\n  1112\t\t\tif err != nil {\r\n  1113\t\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1114\t\t\t}\r\n  1115\t\t\tif valid {\r\n  1116\t\t\t\treturn execResult{name: t.Name, status: \"cached\", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1117\t\t\t}\r\n  1118\t\t}\r\n  1119\t\r\n  1120\t\ttimeout := t.Timeout\r\n  1121\t\tif timeout <= 0 {\r\n  1122\t\t\ttimeout = 300\r\n  1123\t\t}\r\n  1124\t\tdeadline := time.Now().Add(time.Duration(timeout) * time.Second)\r\n  1125\t\r\n"]
[7633.072291, "o", "  1126\t\tbaseEnv := mergedEnv(t.Env)\r\n  1127\t\tpreEnv := append([]string(nil), baseEnv...)\r\n  1128\t\r\n  1129\t\tfor _, hook := range t.PreBuild {\r\n  1130\t\t\tstdout, err := e.runCommand(t, hook, preEnv, deadline)\r\n  1131\t\t\tif err != nil {\r\n  1132\t\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1133\t\t\t}\r\n  1134\t\t\tpreEnv = mergeHookExports(preEnv, parseHookExports(stdout))\r\n"]
[7633.072345, "o", "  1135\t\t}\r\n  1136\t\r\n  1137\t\tmainEnv := preEnv\r\n  1138\t\tif _, err := e.runCommand(t, t.Command, mainEnv, deadline); err != nil {\r\n  1139\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1140\t\t}\r\n"]
[7633.07241, "o", "  1141\t\r\n  1142\t\tpostEnv := append([]string(nil), baseEnv...)\r\n  1143\t\tfor _, hook := range t.PostBuild {\r\n  1144\t\t\tstdout, err := e.runCommand(t, hook, postEnv, deadline)\r\n  1145\t\t\tif err != nil {\r\n  1146\t\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n  1147\t\t\t}\r\n  1148\t\t\tpostEnv = mergeHookExports(postEnv, parseHookExports(stdout))\r\n  1149"]
[7633.072469, "o", "\t\t}\r\n  1150\t\r\n  1151\t\telapsed := time.Since(start).Milliseconds()\r\n  1152\t\tentry := CacheEntry{\r\n  1153\t\t\tCacheKey:   key,\r\n  1154\t\t\tTargetName: t.Name,\r\n  1155\t\t\tTimestamp:  time.Now().UTC().Format(time.RFC3339),\r\n  1156\t\t\tOutputs:    t.Outputs,\r\n"]
[7633.072519, "o", "  1157\t\t}\r\n  1158\t\tif err := writeCacheEntry(e.cacheDir, entry); err != nil {\r\n  1159\t\t\tfmt.Fprintln(os.Stderr, err)\r\n  1160\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: elapsed, cacheKey: key}\r\n  1161\t\t}\r\n  1162\t\treturn execResult{name: t.Name, status: \"built\", durationMS: elapsed, cacheKey: key}\r\n  1163\t}\r\n  1164"]
[7633.072569, "o", "\t\r\n  1165\tfunc (e *buildExecutor) runCommand(t *TargetConfig, command string, env []string, deadline time.Time) (string, error) {\r\n  1166\t\tif strings.TrimSpace(command) == \"\" {\r\n  1167\t\t\treturn \"\", nil\r\n  1168\t\t}\r\n  1169\t\tremaining := time.Until(deadline)\r\n  1170\t\tif remaining <= 0 {\r\n"]
[7633.072619, "o", "  1171\t\t\treturn \"\", fmt.Errorf(\"target %q timed out after %ds\", t.Name, t.Timeout)\r\n  1172\t\t}\r\n  1173\t\r\n  1174\t\tvar stdout, stderr bytes.Buffer\r\n  1175\t\tctx, cancel := context.WithTimeout(context.Background(), remaining)\r\n  1176\t\tdefer cancel()\r\n  1177\t\tcmd := exec.CommandContext(ctx, \"sh\", \"-c\", command)\r\n"]
[7633.072668, "o", "  1178\t\tcmd.Dir = e.configDir\r\n  1179\t\tcmd.Env = env\r\n  1180\t\tcmd.Stdout = &stdout\r\n  1181\t\tcmd.Stderr = &stderr\r\n  1182\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\r\n  1183\t\r\n  1184\t\tif err := cmd.Start(); err != nil {\r\n"]
[7633.072719, "o", "  1185\t\t\treturn \"\", err\r\n  1186\t\t}\r\n  1187\t\r\n  1188\t\twaitCh := make(chan error, 1)\r\n  1189\t\tgo func() {\r\n  1190\t\t\twaitCh <- cmd.Wait()\r\n  1191\t\t}()\r\n  1192\t\r\n  1193\t\tselect {\r\n  1194\t"]
[7633.072771, "o", "\tcase <-ctx.Done():\r\n  1195\t\t\tif cmd.Process != nil {\r\n  1196\t\t\t\t_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\r\n  1197\t\t\t}\r\n  1198\t\t\t<-waitCh\r\n  1199\t\t\treturn \"\", fmt.Errorf(\"target %q timed out after %ds\", t.Name, t.Timeout)\r\n  1200\t\tcase err := <-waitCh:\r\n"]
[7633.072819, "o", "  1201\t\t\tif err != nil {\r\n  1202\t\t\t\tif stderr.Len() > 0 {\r\n  1203\t\t\t\t\tfmt.Fprintf(os.Stderr, \"target %q stderr:\\n%s\", t.Name, stderr.String())\r\n  1204\t\t\t\t}\r\n"]
[7633.072871, "o", "  1205\t\t\t\treturn \"\", err\r\n  1206\t\t\t}\r\n  1207\t\t}\r\n  1208\t\treturn stdout.String(), nil\r\n  1209\t}\r\n  1210\t\r\n"]
