[6570.784016, "o", "\tcacheDir:  filepath.Join(configDir, \".buildctl-cache\"),\r\n   258\t\t\tnoCache:   noCache,\r\n   259\t\t}\r\n   260\t\r\n   261\t\tstatus := make(map[string]string)\r\n   262\t\tdurations := make(map[string]int64)\r\n   263"]
[6570.784137, "o", "\t\tcompleted := 0\r\n   264\t\ttotal := len(requested)\r\n   265\t\treadyCh := make(chan *TargetConfig, total+1)\r\n   266\t\tresultCh := make(chan execResult, total+1)\r\n   267\t\r\n   268\t\tvar mu sync.Mutex\r\n   269\t\tstarted := make(map[string]bool)\r\n   270\t\tcancelled := false\r\n   271\t\r\n   272\t\tvar wg sync.WaitGroup\r\n   273\t\tfor i := 0; i < parallel; i++ {\r\n   274\t\t\twg.Add(1)\r\n   275\t\t\tgo func() {\r\n   276\t\t\t\tdefer wg.Done()\r\n   277\t\t\t\tfor t := range readyCh {\r\n   278\t\t\t\t\tmu.Lock()\r\n   279\t\t\t\t\tif cancelled {\r\n   280\t\t\t\t\t\tmu.Unlock()\r\n   281\t\t\t\t\t\tcontinue\r\n   282\t\t\t\t\t}\r\n   283\t"]
[6570.7842, "o", "\t\t\t\tstarted[t.Name] = true\r\n   284\t\t\t\t\tmu.Unlock()\r\n   285\t\t\t\t\tres := executor.execute(t)\r\n   286\t\t\t\t\tif res.status == \"failed\" && !keepGoing {\r\n   287\t\t\t\t\t\tmu.Lock()\r\n   288\t\t\t\t\t\tcancelled = true\r\n   289\t\t\t\t\t\tmu.Unlock()\r\n"]
[6570.784284, "o", "   290\t\t\t\t\t}\r\n   291\t\t\t\t\tresultCh <- res\r\n   292\t\t\t\t}\r\n   293\t\t\t}()\r\n   294\t\t}\r\n   295\t\r\n   296\t\tbuildStart := time.Now()\r\n"]
[6570.784346, "o", "   297\t\tfor i := range cfg.Targets {\r\n   298\t\t\tt := &cfg.Targets[i]\r\n   299\t\t\tif requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {\r\n   300\t\t\t\treadyCh <- t\r\n   301\t\t\t}\r\n   302\t\t}\r\n   303\t\r\n   304\t\tfor completed < total {\r\n   305\t\t\tres := <-resultCh\r\n   306\t\t\tstatus[res.name] = res.status\r\n"]
[6570.784373, "o", "   307\t\t\tdurations[res.name] = res.durationMS\r\n   308\t\t\tif res.cacheKey != \"\" {\r\n   309\t\t\t\tcacheKeys[res.name] = res.cacheKey\r\n"]
[6570.784399, "o", "   310\t\t\t}\r\n   311\t\t\tcompleted++\r\n   312\t\r\n"]
[6570.784423, "o", "   313\t\t\tif res.status == \"built\" || res.status == \"cached\" {\r\n   314\t\t\t\tmu.Lock()\r\n   315\t\t\t\tcanSchedule := !cancelled\r\n"]
[6570.784445, "o", "   316\t\t\t\tmu.Unlock()\r\n   317\t\t\t\tif canSchedule {\r\n   318\t\t\t\t\tfor _, dependent := range reverseDeps[res.name] {\r\n"]
[6570.784592, "o", "   319\t\t\t\t\t\tif allDependenciesComplete(dependent, targetMap, requested, status) {\r\n   320\t\t\t\t\t\t\treadyCh <- targetMap[dependent]\r\n   321\t\t\t\t\t"]
[6570.784662, "o", "\t}\r\n   322\t\t\t\t\t}\r\n   323\t\t\t\t}\r\n   324\t\t\t\tcontinue\r\n   325\t\t\t}\r\n   326\t\r\n   327\t\t\tif res.status == \"failed\" {\r\n   328\t\t\t\tmarkSkipped(reverseDeps, status, durations, &completed, res.name)\r\n   329\t\t\t\tif !keepGoing {\r\n   330\t\t\t\t\tmu.Lock()\r\n   331\t\t\t\t\tcancelled = true\r\n   332\t\t\t\t\tfor i := range cfg.Targets {\r\n   333\t\t\t\t\t\tt := &cfg.Targets[i]\r\n   334\t\t\t\t\t\tif !requested[t.Name] {\r\n   335\t\t\t\t\t\t\tcontinue\r\n   336\t\t\t\t\t\t}\r\n   337\t\t\t\t\t\tif status[t.Name] == \"\" && !started[t.Name] {\r\n   338\t\t\t\t\t\t\tstatus[t.Name] = \"cancelled\"\r\n   339\t\t\t\t\t\t\tdurations[t.Name] = 0\r\n   340\t\t\t\t\t\t\tcompleted++\r\n   341\t\t\t\t\t\t}\r\n   342\t\t\t\t"]
[6570.784756, "o", "\t}\r\n   343\t\t\t\t\tmu.Unlock()\r\n   344\t\t\t\t}\r\n   345\t\t\t\tcontinue\r\n   346\t\t\t}\r\n   347\t\t}\r\n   348\t\r\n   349\t\tclose(readyCh)\r\n   350\t\twg.Wait()\r\n   351\t\r\n   352\t\treport := BuildReport{Pipeline: cfg.Pipeline.Name, Targets: []BuildTargetReport{}}\r\n   353"]
[6570.784843, "o", "\t\tfor _, name := range order {\r\n   354\t\t\tst := status[name]\r\n   355\t\t\tif st == \"\" {\r\n   356\t\t\t\tif keepGoing {\r\n   357\t\t\t\t\tst = \"skipped\"\r\n   358\t\t\t\t} else {\r\n   359\t\t\t\t\tst = \"cancelled\"\r\n   360\t\t\t\t}\r\n   361\t\t\t}\r\n   362\t\t\treport.Targets = append(report.Targets, BuildTargetReport{\r\n   363\t\t\t\tName:       name,\r\n   364\t\t\t\tStatus:     st,\r\n   365\t\t\t\tCached:     st == \"cached\",\r\n   366\t\t\t\tDurationMS: durations[name],\r\n"]
