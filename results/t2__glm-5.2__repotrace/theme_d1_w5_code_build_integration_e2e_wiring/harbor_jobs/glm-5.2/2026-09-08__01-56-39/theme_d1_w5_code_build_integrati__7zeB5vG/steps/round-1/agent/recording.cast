[3796.333422, "o", "\u001b[?2004h> "]
[3796.333967, "o", "\\t\\treturn execResult{name: t.Name, status: \"failed\", durationMS: elapsed, cacheKey: key}\r\n\u001b[?2004l\r"]
[3796.334029, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[3796.334085, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3796.334137, "o", "\u001b[?2004h"]
[3796.33416, "o", "> "]
[3796.334277, "o", "\\tentry := CacheEntry{\r\n\u001b[?2004l\r"]
[3796.334334, "o", "\u001b[?2004h"]
[3796.334387, "o", "> "]
[3796.334455, "o", "\\t\\tCacheKey:   key,\r\n\u001b[?2004l\r"]
[3796.334509, "o", "\u001b[?2004h> "]
[3796.33465, "o", "\\t\\tTargetName: t.Name,\r\n\u001b[?2004l\r"]
[3796.334674, "o", "\u001b[?2004h"]
[3796.334741, "o", "> "]
[3796.335052, "o", "\\t\\tTimestamp:  time.Now().UTC().Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[3796.33511, "o", "\u001b[?2004h> "]
[3796.33526, "o", "\\t\\tOutputs:    t.Outputs,\r\n\u001b[?2004l\r"]
[3796.335318, "o", "\u001b[?2004h> "]
[3796.335375, "o", "\\t}\r\n\u001b[?2004l\r"]
[3796.335428, "o", "\u001b[?2004h> "]
[3796.335784, "o", "\\tif err := writeCacheEntry(e.cacheDir, entry); err != nil {\r\n\u001b[?2004l\r"]
[3796.335845, "o", "\u001b[?2004h> "]
[3796.336023, "o", "\\t\\tfmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r"]
[3796.33608, "o", "\u001b[?2004h> "]
[3796.336629, "o", "\\t\\treturn execResult{name: t.Name, status: \"failed\", durationMS: elapsed, cacheKey: key}\r\n\u001b[?2004l\r"]
[3796.336704, "o", "\u001b[?2004h> "]
[3796.336761, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.337295, "o", "\\treturn execResult{name: t.Name, status: \"built\", durationMS: elapsed, cacheKey: key}\r\n\u001b[?2004l\r"]
[3796.337358, "o", "\u001b[?2004h> }'''\r\n\u001b[?2004l\r"]
[3796.337413, "o", "\u001b[?2004h> "]
[3796.337923, "o", "new_execute = '''func (e *buildExecutor) execute(t *TargetConfig) execResult {\r\n\u001b[?2004l\r"]
[3796.337984, "o", "\u001b[?2004h> "]
[3796.338086, "o", "\\tstart := time.Now()\r\n\u001b[?2004l\r"]
[3796.338142, "o", "\u001b[?2004h> "]
[3796.338428, "o", "\\tkey, err := computeCacheKey(t, e.configDir)\r\n\u001b[?2004l\r"]
[3796.338489, "o", "\u001b[?2004h> "]
[3796.338575, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[3796.338631, "o", "\u001b[?2004h> "]
[3796.339313, "o", "\\t\\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[?2004l\r"]
[3796.339376, "o", "\u001b[?2004h> \\t}"]
[3796.339433, "o", "\r\n\u001b[?2004l\r"]
[3796.339488, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3796.339541, "o", "\u001b[?2004h> "]
[3796.339598, "o", "\\tif !e.noCache {\r\n\u001b[?2004l\r"]
[3796.339652, "o", "\u001b[?2004h> "]
[3796.34009, "o", "\\t\\tvalid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)\r\n\u001b[?2004l\r"]
[3796.34015, "o", "\u001b[?2004h> "]
[3796.340237, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[3796.340294, "o", "\u001b[?2004h> "]
[3796.340886, "o", "\\t\\t\\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[?2004l\r"]
[3796.340951, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[3796.341006, "o", "\u001b[?2004h> "]
[3796.341069, "o", "\\t\\tif valid {\r\n"]
[3796.34112, "o", "\u001b[?2004l\r"]
[3796.341174, "o", "\u001b[?2004h> "]
[3796.341819, "o", "\\t\\t\\treturn execResult{name: t.Name, status: \"cached\", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[?2004l\r"]
[3796.341879, "o", "\u001b[?2004h> \\t\\t}\r\n"]
[3796.341933, "o", "\u001b[?2004l\r"]
[3796.341987, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[3796.342041, "o", "> \r\n\u001b[?2004l\r"]
[3796.342093, "o", "\u001b[?2004h> "]
[3796.34217, "o", "\\ttimeout := t.Timeout\r\n\u001b[?2004l\r"]
[3796.342228, "o", "\u001b[?2004h> "]
[3796.34234, "o", "\\tif timeout <= 0 {\r\n\u001b[?2004l\r"]
[3796.342396, "o", "\u001b[?2004h> "]
[3796.342496, "o", "\\t\\ttimeout = 300\r\n\u001b[?2004l\r"]
[3796.342549, "o", "\u001b[?2004h"]
[3796.342604, "o", "> \\t}\r\n\u001b[?2004l\r"]
[3796.342659, "o", "\u001b[?2004h> "]
[3796.342969, "o", "\\tdeadline := time.Now().Add(time.Duration(timeout) * time.Second)\r\n\u001b[?2004l\r"]
[3796.34303, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[3796.343086, "o", "> "]
[3796.343229, "o", "\\tbaseEnv := mergedEnv(t.Env)\r\n\u001b[?2004l\r"]
[3796.343288, "o", "\u001b[?2004h> "]
[3796.343527, "o", "\\tpreEnv := append([]string(nil), baseEnv...)\r\n\u001b[?2004l\r"]
[3796.343585, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[3796.343636, "o", "> "]
[3796.343822, "o", "\\tfor _, hook := range t.PreBuild {\r\n\u001b[?2004l\r"]
[3796.343878, "o", "\u001b[?2004h> "]
[3796.344275, "o", "\\t\\tif err := e.runHook(t, hook, preEnv, deadline); err != nil {\r\n\u001b[?2004l\r"]
[3796.344335, "o", "\u001b[?2004h> "]
[3796.344908, "o", "\\t\\t\\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[?2004l\r"]
[3796.344971, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[3796.345026, "o", "\u001b[?2004h> "]
[3796.345404, "o", "\\t\\tpreEnv = mergeHookExports(preEnv, hookExportsFromOutput(t, hook))\r\n\u001b[?2004l\r"]
[3796.345465, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[3796.345517, "o", "\u001b[?2004h"]
[3796.345572, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[3796.345662, "o", "\\tmainEnv := preEnv\r\n\u001b[?2004l\r"]
[3796.345718, "o", "\u001b[?2004h> "]
[3796.346092, "o", "\\tif err := e.runHook(t, t.Command, mainEnv, deadline); err != nil {\r\n\u001b[?2004l\r"]
[3796.34615, "o", "\u001b[?2004h> "]
[3796.346798, "o", "\\t\\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[?2004l\r"]
[3796.346861, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[3796.346917, "o", "\u001b[?2004h"]
[3796.346972, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.347193, "o", "\\tpostEnv := append([]string(nil), baseEnv...)\r\n\u001b[?2004l\r"]
[3796.347261, "o", "\u001b[?2004h> "]
[3796.347443, "o", "\\tfor _, hook := range t.PostBuild {\r\n\u001b[?2004l\r"]
[3796.347501, "o", "\u001b[?2004h> "]
[3796.347839, "o", "\\t\\tif err := e.runHook(t, hook, postEnv, deadline); err != nil {\r\n\u001b[?2004l\r"]
[3796.347898, "o", "\u001b[?2004h> "]
[3796.348513, "o", "\\t\\t\\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[?2004l\r"]
[3796.348577, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[3796.348627, "o", "\u001b[?2004h"]
[3796.348679, "o", "> "]
[3796.349025, "o", "\\t\\tpostEnv = mergeHookExports(postEnv, hookExportsFromOutput(t, hook))\r\n\u001b[?2004l\r"]
[3796.349087, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[3796.349112, "o", "\u001b[?2004h> \r\n"]
[3796.349177, "o", "\u001b[?2004l\rg\u001b[?2004h> "]
[3796.349417, "o", "\\telapsed := time.Since(start).Milliseconds()\r\n\u001b[?2004l\r"]
[3796.349477, "o", "\u001b[?2004h> "]
[3796.349575, "o", "\\tentry := CacheEntry{\r\n\u001b[?2004l\r"]
[3796.349593, "o", "\u001b[?2004h"]
[3796.349663, "o", "> "]
[3796.349723, "o", "\\t\\tCacheKey:   key,\r\n\u001b[?2004l\r"]
[3796.349778, "o", "\u001b[?2004h> "]
[3796.349893, "o", "\\t\\tTargetName: t.Name,\r\n\u001b[?2004l\r"]
[3796.349948, "o", "\u001b[?2004h> "]
[3796.350232, "o", "\\t\\tTimestamp:  time.Now().UTC().Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[3796.350291, "o", "\u001b[?2004h> "]
[3796.350381, "o", "\\t\\tOutputs:    t.Outputs,\r\n\u001b[?2004l\r"]
[3796.350432, "o", "\u001b[?2004h"]
[3796.350487, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.350674, "o", "\\tif err := writeCacheEntry(e.cacheDir, entry); err != nil {\r\n\u001b[?2004l\r"]
[3796.350732, "o", "\u001b[?2004h> "]
[3796.350821, "o", "\\t\\tfmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r"]
[3796.350876, "o", "\u001b[?2004h> "]
[3796.351158, "o", "\\t\\treturn execResult{name: t.Name, status: \"failed\", durationMS: elapsed, cacheKey: key}\r\n\u001b[?2004l\r"]
[3796.351218, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[3796.351275, "o", "> "]
[3796.351541, "o", "\\treturn execResult{name: t.Name, status: \"built\", durationMS: elapsed, cacheKey: key}\r\n\u001b[?2004l\r"]
[3796.351604, "o", "\u001b[?2004h> "]
[3796.351656, "o", "}'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.351767, "o", "s = s.replace(old_execute, new_execute)\r\n\u001b[?2004l\r"]
[3796.35182, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[3796.351871, "o", "\u001b[?2004h> "]
[3796.351951, "o", "# Add hook helpers after mergedEnv\r\n\u001b[?2004l\r"]
[3796.352001, "o", "\u001b[?2004h> "]
[3796.352205, "o", "old_merged = '''func mergedEnv(env map[string]string) []string {\r\n\u001b[?2004l\r"]
[3796.352232, "o", "\u001b[?2004h> "]
[3796.352341, "o", "\\tout := map[string]string{}\r\n\u001b[?2004l\r"]
[3796.352397, "o", "\u001b[?2004h> "]
[3796.352508, "o", "\\tfor _, kv := range os.Environ() {\r\n\u001b[?2004l\r"]
[3796.352559, "o", "\u001b[?2004h> "]
[3796.35269, "o", "\\t\\tparts := strings.SplitN(kv, \"=\", 2)\r\n\u001b[?2004l\r"]
[3796.352744, "o", "\u001b[?2004h> "]
[3796.3528, "o", "\\t\\tif len(parts) == 2 {\r\n\u001b[?2004l\r"]
[3796.352853, "o", "\u001b[?2004h> "]
[3796.352947, "o", "\\t\\t\\tout[parts[0]] = parts[1]\r\n\u001b[?2004l\r"]
[3796.353001, "o", "\u001b[?2004h> "]
[3796.353045, "o", "\\t\\t} else {\r\n\u001b[?2004l\r"]
[3796.353093, "o", "\u001b[?2004h> "]
[3796.353184, "o", "\\t\\t\\tout[parts[0]] = \"\"\r\n\u001b[?2004l\r"]
[3796.353234, "o", "\u001b[?2004h> "]
[3796.353286, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[3796.35334, "o", "\u001b[?2004h> "]
[3796.353417, "o", "\\tfor k, v := range env {\r\n\u001b[?2004l\r"]
[3796.353468, "o", "\u001b[?2004h"]
[3796.353521, "o", "> "]
[3796.353573, "o", "\\t\\tout[k] = v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.353627, "o", "\\t}\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[3796.353727, "o", "\\tresult := make([]string, 0, len(out))\r\n\u001b[?2004l\r"]
[3796.353781, "o", "\u001b[?2004h"]
[3796.353834, "o", "> "]
[3796.353887, "o", "\\tfor k, v := range out {\r\n\u001b[?2004l\r"]
[3796.353939, "o", "\u001b[?2004h> "]
[3796.354005, "o", "\\t\\tresult = append(result, k+\"=\"+v)\r\n\u001b[?2004l\r"]
[3796.354057, "o", "\u001b[?2004h"]
[3796.354112, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.354169, "o", "\\tsort.Strings(result)\r\n\u001b[?2004l\r"]
[3796.354212, "o", "\u001b[?2004h"]
[3796.354274, "o", "> "]
[3796.354318, "o", "\\treturn result\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.354334, "o", "}'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.354592, "o", "new_merged = '''func mergedEnv(env map[string]string) []string {\r\n\u001b[?2004l\r"]
[3796.354652, "o", "\u001b[?2004h> "]
[3796.354722, "o", "\\tout := map[string]string{}\r\n\u001b[?2004l\r"]
[3796.354776, "o", "\u001b[?2004h> "]
[3796.354891, "o", "\\tfor _, kv := range os.Environ() {\r\n\u001b[?2004l\r"]
[3796.354947, "o", "\u001b[?2004h> "]
[3796.355074, "o", "\\t\\tparts := strings.SplitN(kv, \"=\", 2)\r\n\u001b[?2004l\r"]
[3796.355128, "o", "\u001b[?2004h> "]
[3796.355192, "o", "\\t\\tif len(parts) == 2 {\r\n\u001b[?2004l\r"]
[3796.355256, "o", "\u001b[?2004h"]
[3796.355313, "o", "> "]
[3796.355365, "o", "\\t\\t\\tout[parts[0]] = parts[1]\r\n\u001b[?2004l\r"]
[3796.355409, "o", "\u001b[?2004h> "]
[3796.355426, "o", "\\t\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[3796.355494, "o", "> "]
[3796.355547, "o", "\\t\\t\\tout[parts[0]] = \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[3796.355563, "o", "> "]
[3796.355632, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[3796.355681, "o", "\u001b[?2004h"]
[3796.35573, "o", "> "]
[3796.355782, "o", "\\tfor k, v := range env {\r\n\u001b[?2004l\r"]
[3796.355837, "o", "\u001b[?2004h> \\t\\tout[k] = v\r\n\u001b[?2004l\r"]
[3796.35589, "o", "\u001b[?2004h"]
[3796.355942, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.356055, "o", "\\tresult := make([]string, 0, len(out))\r\n\u001b[?2004l\r"]
[3796.35611, "o", "\u001b[?2004h> "]
[3796.356173, "o", "\\tfor k, v := range out {\r\n\u001b[?2004l\r"]
[3796.356228, "o", "\u001b[?2004h> "]
[3796.356344, "o", "\\t\\tresult = append(result, k+\"=\"+v)\r\n\u001b[?2004l\r"]
[3796.356398, "o", "\u001b[?2004h> "]
[3796.35645, "o", "\\t}\r\n\u001b[?2004l\re\u001b[?2004h> "]
[3796.356502, "o", "\\tsort.Strings(result)\r\n\u001b[?2004l\r"]
[3796.356552, "o", "\u001b[?2004h"]
[3796.356604, "o", "> "]
[3796.356661, "o", "\\treturn result\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3796.356714, "o", "\u001b[?2004h> "]
[3796.357037, "o", "var hookExportRe = regexp.MustCompile(`^BUILDCTL_ENV:([A-Za-z_][A-Za-z0-9_]*)=(.*)$`)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3796.357103, "o", "> \r\n\u001b[?2004l\rp\u001b[?2004h> "]
[3796.357311, "o", "func parseHookExports(stdout string) map[string]string {\r\n\u001b[?2004l\r"]
[3796.357369, "o", "\u001b[?2004h> "]
[3796.357461, "o", "\\texports := map[string]string{}\r\n\u001b[?2004l\r"]
[3796.357531, "o", "\u001b[?2004h> "]
[3796.357711, "o", "\\tfor _, line := range strings.Split(stdout, \"\\\\n\") {\r\n\u001b[?2004l\r"]
[3796.357767, "o", "\u001b[?2004h> "]
[3796.357914, "o", "\\t\\tm := hookExportRe.FindStringSubmatch(line)\r\n\u001b[?2004l\r"]
[3796.357966, "o", "\u001b[?2004h> "]
[3796.358017, "o", "\\t\\tif len(m) == 3 {\r\n\u001b[?2004l\r"]
[3796.358071, "o", "\u001b[?2004h> "]
[3796.358149, "o", "\\t\\t\\texports[m[1]] = m[2]\r\n\u001b[?2004l\r"]
[3796.358202, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r)"]
[3796.358256, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\rs"]
[3796.358304, "o", "\u001b[?2004h"]
[3796.358358, "o", "> "]
[3796.358412, "o", "\\treturn exports\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.358465, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3796.358519, "o", "\u001b[?2004h> "]
[3796.358735, "o", "func mergeHookExports(env []string, exports map[string]string) []string {\r\n\u001b[?2004l\r"]
[3796.358791, "o", "\u001b[?2004h> "]
[3796.358848, "o", "\\tif len(exports) == 0 {\r\n\u001b[?2004l\r"]
[3796.358865, "o", "\u001b[?2004h> "]
[3796.358933, "o", "\\t\\treturn env\r\n\u001b[?2004l\r"]
[3796.358984, "o", "\u001b[?2004h> "]
[3796.359034, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3796.35921, "o", "\\tout := make(map[string]string, len(env)+len(exports))\r\n\u001b[?2004l\r"]
[3796.359267, "o", "\u001b[?2004h> "]
[3796.359369, "o", "\\tfor _, kv := range env {\r\n\u001b[?2004l\r"]
[3796.359423, "o", "\u001b[?2004h> "]
[3796.359549, "o", "\\t\\tparts := strings.SplitN(kv, \"=\", 2)\r\n\u001b[?2004l\r"]
[3796.359601, "o", "\u001b[?2004h> "]
