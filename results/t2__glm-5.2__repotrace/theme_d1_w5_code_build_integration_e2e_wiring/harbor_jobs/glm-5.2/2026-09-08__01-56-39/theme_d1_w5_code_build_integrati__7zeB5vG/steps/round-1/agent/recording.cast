[6818.266454, "o", "\t\t\twasCancelled := status[dependent] == \"cancelled\"\r\n\t\t\tstatus[dependent] = \"skipped\"\r\n\t\t\tdurations[dependent] = 0\r\n\t\t\tif !wasCancelled {\r\n\t\t\t\t*completed++\r\n"]
[6818.266552, "o", "\t\t\t}\r\n\t\t\tmarkSkipped(reverseDeps, status, durations, completed, dependent)\r\n\t\t}\r\n\t}\r\n}\r\n\r\ntype buildPath struct {\r\n\tnames  []string\r\n\tweight int64\r\n}\r\n\r\nfunc computeBuildProfile(targets []BuildTargetReport, cfg *Config, targetMap map[string]*TargetConfig) *BuildProfile {\r\n\tdurationByName := map[string]int64{}\r\n\tsuccessful := map[string]bool{}\r\n\thasBuilt := false\r\n\tfor _, t := range targets {\r\n\t\t"]
[6818.266621, "o", "switch t.Status {\r\n\t\tcase \"built\":\r\n\t\t\tsuccessful[t.Name] = true\r\n\t\t\tdurationByName[t.Name] = t.DurationMS\r\n\t\t\thasBuilt = true\r\n\t\tcase \"cached\":\r\n\t\t\tsuccessful[t.Name] = true\r\n\t\t\tdurationByName[t.Name] = 0\r\n\t\t}\r\n\t"]
[6818.266685, "o", "}\r\n\r\n\tif len(successful) == 0 || !hasBuilt {\r\n\t\treturn &BuildProfile{CriticalPath: []string{}, CriticalPathMS: 0}\r\n\t}\r\n\r\n\tdeps := map[string][]string{}\r\n\tfor name := range successful {\r\n\t\tt, ok := targetMap[name]\r\n\t\tif !ok {\r\n"]
[6818.266767, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n\t\t\tif successful[dep] {\r\n\t\t\t\tdeps[name] = append(deps[name], dep)\r\n\t\t\t}\r\n\t\t}\r\n\t"]
[6818.266826, "o", "\tsort.Strings(deps[name])\r\n\t}\r\n\r\n\torder := []string{}\r\n\tseen := map[string]bool{}\r\n\tvar visit func(string)\r\n\tvisit = func(n string) {\r\n\t\tif seen[n] {\r\n\t\t\treturn\r\n\t\t}\r\n\t\tseen[n] = true\r\n\t\tfor _, dep := range deps[n] {\r\n\t\t\tvisit(dep)\r\n\t\t}\r\n\t\torder = append(order, n)\r\n"]
[6818.266896, "o", "\t}\r\n\tfor _, t := range cfg.Targets {\r\n\t\tif successful[t.Name] {\r\n\t\t\tvisit(t.Name)\r\n\t\t}\r\n\t}\r\n\r\n\tdp := map[string]buildPath{}\r\n\tfor _, name := range order {\r\n\t\tbest := buildPath{names: []string{name}, weight: durationByName[name]}\r\n"]
[6818.266955, "o", "\t\tfor _, dep := range deps[name] {\r\n\t\t\tcand := buildPath{\r\n\t\t\t\tnames:  append(append([]string{}, dp[dep].names...), name),\r\n\t\t\t\tweight: dp[dep].weight + durationByName[name],\r\n\t\t\t}\r\n\t\t\tif betterBuildPath(cand, best) {\r\n\t\t\t\tbest = cand\r\n\t\t\t}\r\n\t\t}\r\n\t\tdp[name] = best"]
[6818.267013, "o", "\r\n\t}\r\n\r\n\tvar best buildPath\r\n"]
