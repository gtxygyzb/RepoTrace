[3684.328079, "o", "\u001b[32m\u001b[K840\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc computeCacheKey\u001b[m\u001b[K(t *TargetConfig, configDir string) (string, error) {\r\n\u001b[32m\u001b[K841\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\th := sha256.New()\r\n\u001b[32m\u001b[K842\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif _, err := io.WriteString(h, t.Command); err != nil {\r\n\u001b[32m\u001b[K843\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn \"\", err\r\n"]
[3684.328164, "o", "\u001b[32m\u001b[K844\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K845\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K846\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tenvKeys := make([]string, 0, len(t.Env))\r\n\u001b[32m\u001b[K847\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k := range t.Env {\r\n\u001b[32m\u001b[K848\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tenvKeys = append(envKeys, k)\r\n\u001b[32m\u001b[K849\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K850\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tsort.Strings(envKeys)\r\n\u001b[32m\u001b[K851\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, k := range envKeys {\r\n\u001b[32m\u001b[K852\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif _, err := io.WriteString(h, k+\"=\"+t.Env[k]); err != nil {\r\n"]
[3684.328248, "o", "\u001b[32m\u001b[K853\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn \"\", err\r\n\u001b[32m\u001b[K854\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K855\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K856\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[3684.328315, "o", "\r\n\u001b[32m\u001b[K857\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tinputPaths := make([]string, len(t.Inputs))\r\n\u001b[32m\u001b[K858\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcopy(inputPaths, t.Inputs)\r\n\u001b[32m\u001b[K859\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tsort.Strings(inputPaths)\r\n\u001b[32m\u001b[K860\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, p := range inputPaths {\r\n\u001b[32m\u001b[K861\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcontentHash, err := hashFile(resolvePath(configDir, p))\r\n\u001b[32m\u001b[K862\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err != nil {\r\n"]
[3684.328384, "o", "\u001b[32m\u001b[K863\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tcontentHash = hashBytes(nil)\r\n\u001b[32m\u001b[K864\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K865\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif _, err := io.WriteString(h, contentHash); err != nil {\r\n\u001b[32m\u001b[K866\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn \"\", err\r\n\u001b[32m\u001b[K867\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n"]
[3684.328452, "o", "\u001b[32m\u001b[K868\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K869\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn hex.EncodeToString(h.Sum(nil)), nil\r\n\u001b[32m\u001b[K870\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K871\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K872\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc mergedEnv(env map[string]string) []string {\r\n\u001b[32m\u001b[K873\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tout := map[string]string{}\r\n\u001b[32m\u001b[K874\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, kv := range os.Environ() {\r\n\u001b[32m\u001b[K875\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tparts := strings.SplitN(kv, \"=\", 2)\r\n"]
