[3676.94161, "o", "   840\tfunc computeCacheKey(t *TargetConfig, configDir string) (string, error) {\r\n   841\t\th := sha256.New()\r\n   842\t\tif _, err := io.WriteString(h, t.Command); err != nil {\r\n   843\t\t\treturn \"\", err\r\n   844\t\t}\r\n   845\t\r\n"]
[3676.941689, "o", "   846\t\tenvKeys := make([]string, 0, len(t.Env))\r\n   847\t\tfor k := range t.Env {\r\n   848\t\t\tenvKeys = append(envKeys, k)\r\n   849\t\t}\r\n   850\t\tsort.Strings(envKeys)\r\n   851\t\tfor _, k := range envKeys {\r\n   852\t\t\tif _, err := io.WriteString(h, k+\"=\"+t.Env[k]); err != nil {\r\n   853\t\t\t\treturn \"\", err\r\n   854\t\t\t}\r\n   855\t\t}\r\n   856\t\r\n   857\t"]
[3676.941766, "o", "\tinputPaths := make([]string, len(t.Inputs))\r\n   858\t\tcopy(inputPaths, t.Inputs)\r\n   859\t\tsort.Strings(inputPaths)\r\n   860\t\tfor _, p := range inputPaths {\r\n   861\t\t\tcontentHash, err := hashFile(resolvePath(configDir, p))\r\n   862\t\t\tif err != nil {\r\n   863\t\t\t\tcontentHash = hashBytes(nil)\r\n"]
[3676.941832, "o", "   864\t\t\t}\r\n   865\t\t\tif _, err := io.WriteString(h, contentHash); err != nil {\r\n   866\t\t\t\treturn \"\", err\r\n   867\t\t\t}\r\n   868\t\t}\r\n   869\t\treturn hex.EncodeToString(h.Sum(nil)), nil\r\n   870\t}\r\n   871\t\r\n   872\tfunc mergedEnv(env map[string]string) []string {\r\n   873\t\tout := map[string]string{}\r\n   874\t\tfor _, kv := range os.Environ() {\r\n   875\t\t\tparts := strings.SplitN(kv, \"=\", 2)\r\n   876\t\t\tif len(parts) == 2 {\r\n   877\t\t\t\tout[parts[0]] = parts[1]\r\n   878\t\t\t} else {\r\n   879\t\t\t\tout[parts[0]] = \"\"\r\n"]
[3676.941892, "o", "   880\t\t\t}\r\n   881\t\t}\r\n   882\t\tfor k, v := range env {\r\n   883\t\t\tout[k] = v\r\n   884\t\t}\r\n   885\t\tresult := make([]string, 0, len(out))\r\n   886\t\tfor k, v := range out {\r\n   887\t\t\tresult = append(result, k+\"=\"+v)\r\n   888\t\t}"]
[3676.941956, "o", "\r\n   889\t\tsort.Strings(result)\r\n   890\t\treturn result\r\n   891\t}\r\n   892\t\r\n   893\tfunc cacheValid(cacheDir, key string, outputs []string, configDir string) (bool, CacheEntry, error) {\r\n   894\t\tentry, ok, err := readCacheEntry(cacheDir, key)\r\n   895\t\tif err != nil {\r\n   896\t\t\treturn false, CacheEntry{}, err\r\n"]
[3676.942013, "o", "   897\t\t}\r\n   898\t\tif !ok {\r\n   899\t\t\treturn false, CacheEntry{}, nil\r\n   900\t\t}\r\n   901\t\tfor _, out := range outputs {\r\n   902\t\t\tif !fileExists(resolvePath(configDir, out)) {\r\n   903\t\t\t\treturn false, CacheEntry{}, nil\r\n"]
[3676.942068, "o", "   904\t\t\t}\r\n   905\t\t}\r\n"]
