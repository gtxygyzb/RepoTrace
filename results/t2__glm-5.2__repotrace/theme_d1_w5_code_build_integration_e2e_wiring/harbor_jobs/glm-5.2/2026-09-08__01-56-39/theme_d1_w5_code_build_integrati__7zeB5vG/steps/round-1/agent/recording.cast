[1971.440175, "o", "if err != nil {\r\n   723\t\t\treturn false, CacheEntry{}, err\r\n   724\t\t}\r\n   725\t\tif !ok {\r\n   726\t\t\treturn false, CacheEntry{}, nil\r\n   727\t\t}\r\n   728\t\tfor _, out := range outputs {\r\n   729\t\t\tif !fileExists(resolvePath(configDir, out)) {\r\n   730\t\t\t\treturn false, CacheEntry{}, nil\r\n   731\t\t\t}\r\n   732\t\t}\r\n   733\t\treturn true, entry, nil\r\n   734\t}\r\n   735\t\r\n   736\tfunc readCacheEntry(cacheDir, key string) (CacheEntry, bool, error) {\r\n   737\t\tpath := filepath.Join(cacheDir, key+\".json\")\r\n"]
