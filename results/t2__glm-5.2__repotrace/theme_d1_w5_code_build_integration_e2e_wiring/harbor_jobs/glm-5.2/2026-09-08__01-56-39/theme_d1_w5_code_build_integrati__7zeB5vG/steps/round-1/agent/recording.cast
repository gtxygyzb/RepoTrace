[4510.464747, "o", "   136\t\r\n   137\tfunc runBuildCommand(args []string) {\r\n   138\t\tfs := flag.NewFlagSet(\"build\", flag.ContinueOnError)\r\n   139\t\tfs.SetOutput(os.Stderr)\r\n   140\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   141\t\ttargetsFlag := fs.String(\"targets\", \"\", \"comma-separated target names\")\r\n   142\t\tparallel := fs.Int(\"parallel\", runtime.NumCPU(), \"max concurrent target executions\")\r\n   143\t\tnoCache := fs.Bool(\"no-cache\", false, \"skip all cache lookups\")\r\n   144"]
[4510.464816, "o", "\t\treportPath := fs.String(\"report\", \"\", \"also write JSON report to this file\")\r\n   145\t\tvar vars stringSliceFlag\r\n   146\t\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n   147\t\tif err := fs.Parse(args); err != nil {\r\n   148\t\t\tos.Exit(1)\r\n   149\t\t}\r\n   150\t\tif *configPath == \"\" {\r\n   151\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")"]
