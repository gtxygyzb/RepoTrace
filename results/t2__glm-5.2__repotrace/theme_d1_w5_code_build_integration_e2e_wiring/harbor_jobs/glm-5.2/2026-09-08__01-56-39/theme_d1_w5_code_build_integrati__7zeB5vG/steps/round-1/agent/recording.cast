[6614.872558, "o", "\tif err != nil {\r\n   479\t\t\treturn nil, \"\", err\r\n   480\t\t}\r\n   481\t\tloader := &configLoader{\r\n   482\t\t\tvariables:   make(map[string]string),\r\n   483\t\t\ttargetNames: make(map[string]bool),\r\n   484\t\t}\r\n   485\t\tfor k, v := range overrides {\r\n   486\t\t\tloader.variables[k] = v\r\n   487\t\t}\r\n   488"]
[6614.87262, "o", "\t\tif err := loader.loadFile(abs, true); err != nil {\r\n   489\t\t\treturn nil, \"\", err\r\n   490\t\t}\r\n   491\t\tfor i := range loader.targets {\r\n   492\t\t\tt := &loader.targets[i]\r\n   493\t\t\texpanded, err := expandString(t.Command, loader.variables, make(map[string]bool))\r\n   494\t\t\tif err != nil {\r\n   495\t\t\t\treturn nil, \"\", err\r\n   496\t\t\t}\r\n   497"]
[6614.872688, "o", "\t\t\tt.Command = expanded\r\n   498\t\t\tfor j, p := range t.Inputs {\r\n   499\t\t\t\texpanded, err := expandString(p, loader.variables, make(map[string]bool))\r\n   500\t\t\t\tif err != nil {\r\n   501\t\t\t\t\treturn nil, \"\", err\r\n   502\t\t\t\t}\r\n   503\t\t\t\tt.Inputs[j] = expanded\r\n   504\t\t\t}\r\n   505\t\t\tfor j, p := range t.Outputs {\r\n   506\t\t\t\texpanded, err := expandString(p, loader.variables, make(map[string]bool))\r\n"]
