[8872.370782, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('main.go')\nlines = p.read_text().splitlines()\nout = []\ni = 0\nwhile i < len(lines):\n    out.append(lines[i])\n    if (\n        i + 4 < len(lines)\n        and 'res := executor.execute(t)' in lines[i]\n        and 'if res.status == \"failed\" && !keepGoing {' in lines[i+1]\n        and 'mu.Lock()' in lines[i+2]\n        and 'cancelled = true' in lines[i+3]\n        and 'mu.Unlock()' in lines[i+4]\n    ):\n        indent = lines[i+5][:len(lines[i+5])-len(lines[i+5].lstrip())] if lines[i+5].strip() == '}' else '\\t\\t\\t\\t'\n        out.append(indent + 'mu.Lock()')\n        out.append(indent + 'cancelled = true')\n        out.append(indent + 'mu.Unlock()')\n        out.append(indent + 'cancelOnce.Do(func() { close(executor.haltCh) })')\n        i += 5\n    else:\n        i += 1\np.write_text('\\n'.join(out) + '\\n')\nPY\n"]
