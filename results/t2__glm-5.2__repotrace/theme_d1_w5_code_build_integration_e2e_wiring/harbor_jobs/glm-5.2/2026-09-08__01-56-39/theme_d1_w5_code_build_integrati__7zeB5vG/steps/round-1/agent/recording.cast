[6061.529189, "o", "   223\t}\r\n   224\t\r\n   225\tfunc runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string, vars []string, keepGoing bool) error {\r\n   226\t\tcfg, configDir, err := loadConfig(configPath, vars)\r\n   227\t\tif err != nil {\r\n   228\t\t\treturn err\r\n   229\t\t}\r\n   230\t\ttargetMap, err := validateConfig(cfg)\r\n   231\t\tif err != nil {\r\n   232\t"]
[6061.529484, "o", "\t\treturn err\r\n   233\t\t}\r\n   234\t\trequested, err := selectTargets(cfg, targetMap, targetsFlag)\r\n   235\t\tif err != nil {\r\n   236\t\t\treturn err\r\n   237\t\t}\r\n   238\t\torder := topologicalOrder(cfg, requested)\r\n   239\t\treverseDeps := buildReverseDeps(cfg, requested)\r\n   240\t\r\n   241\t\tcacheKeys := make(map[string]string)\r\n   242\t\tfor i := range cfg.Targets {\r\n   243\t\t\tt := &cfg.Targets[i]\r\n   244\t\t\tif !requested[t.Name] {\r\n   245\t\t\t\tcontinue\r\n   246\t\t\t}\r\n   247\t\t\tkey, err := computeCacheKey(t, configDir)\r\n   248\t\t\tif err != nil {\r\n   249\t\t\t\treturn err\r\n   250\t\t\t}\r\n   251\t\t\tcacheKeys[t.Name] = key\r\n   252\t\t}\r\n   253\t\r\n   254\t\texecutor := &buildExecutor{\r\n   255\t\t\tconfig:    cfg,\r\n   256\t\t\tconfigDir: configDir,\r\n   257\t\t\tcacheDir:  filepath.Join(configDir, \".buildctl-cache\"),\r\n   258\t\t\tnoCache:   noCache,\r\n   259\t\t}\r\n   260\t\r\n   261\t\tstatus := make(map[string]string)\r\n   262\t\tdurations := make(map[string]int64)\r\n   263\t\tcompleted := 0\r\n   264\t\ttotal := len(requested)\r\n   265\t\treadyCh := make(chan *TargetConfig, total+1)"]
[6061.529544, "o", "\r\n   266\t\tresultCh := make(chan execResult, total+1)\r\n   267\t\r\n   268\t\tvar mu sync.Mutex\r\n   269\t\tstarted := make(map[string]bool)\r\n   270\t\tcancelled := false\r\n   271\t\r\n   272\t\tvar wg sync.WaitGroup\r\n   273\t\tfor i := 0; i < parallel; i++ {\r\n   274\t\t\twg.Add(1)\r\n   275\t\t\tgo func() {\r\n   276\t\t\t\tdefer wg.Done()\r\n   277\t\t\t\tfor t := range readyCh {\r\n   278\t\t\t\t\tmu.Lock()\r\n   279\t\t\t\t\tif cancelled {\r\n   280\t\t\t\t\t\tmu.Unlock()\r\n   281\t\t\t\t\t\tcontinue\r\n   282\t\t\t\t\t}\r\n   283\t\t\t\t\tstarted[t.Name] = true\r\n"]
[6061.529772, "o", "   284\t\t\t\t\tmu.Unlock()\r\n   285\t\t\t\t\tresultCh <- executor.execute(t)\r\n   286\t\t\t\t}\r\n   287\t\t\t}()\r\n   288\t\t}\r\n   289\t\r\n   290\t\tbuildStart := time.Now()\r\n   291\t\tfor i := range cfg.Targets {\r\n   292\t\t\tt := &cfg.Targets[i]\r\n   293\t\t\tif requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {\r\n   294\t\t\t\treadyCh <- t\r\n   295\t\t\t}\r\n   296\t\t}\r\n   297\t\r\n   298\t\tfor completed < total {\r\n   299\t\t\tres := <-resultCh\r\n   300\t\t\tstatus[res.name] = res.status\r\n   301\t\t\tdurations[res.name] = res.durationMS\r\n   302\t\t\tif res.cacheKey != \"\" {\r\n   303\t\t\t\tcacheKeys[res.name] = res.cacheKey\r\n   304\t\t\t}\r\n   305\t\t\tcompleted++\r\n   306\t\r\n   307\t\t\tif res.status == \"built\" || res.status == \"cached\" {\r\n   308\t\t\t\tmu.Lock()\r\n   309\t\t\t\tcanSchedule := !cancelled\r\n   310\t\t\t\tmu.Unlock()\r\n   311\t\t\t\tif canSchedule {\r\n   312\t\t\t\t\tfor _, dependent := range reverseDeps[res.name] {\r\n   313\t\t\t\t\t\tif allDependenciesComplete(dependent, targetMap, requested, status) {\r\n   314\t\t\t\t\t\t\treadyCh <- targetMap[dependent]\r\n"]
[6061.529846, "o", "   315\t\t\t\t\t\t}\r\n   316\t\t\t\t\t}\r\n   317\t\t\t\t}\r\n   318\t\t\t\tcontinue\r\n   319\t\t\t}\r\n   320\t\r\n   321\t\t\tif res.status == \"failed\" {\r\n   322\t\t\t\tmarkSkipped(reverseDeps, status, durations, &completed, res.name)\r\n   323\t\t\t\tif !keepGoing {\r\n   324\t\t\t\t\tmu.Lock()\r\n   325\t\t\t\t\tcancelled = true\r\n"]
[6061.529917, "o", "   326\t\t\t\t\tfor i := range cfg.Targets {\r\n   327\t\t\t\t\t\tt := &cfg.Targets[i]\r\n   328\t\t\t\t\t\tif !requested[t.Name] {\r\n   329\t\t\t\t\t\t\tcontinue\r\n   330\t\t\t\t\t\t}\r\n   331\t\t\t\t\t\tif status[t.Name] == \"\" && !started[t.Name] {\r\n   332\t\t\t\t\t\t\tstatus[t.Name] = \"cancelled\"\r\n   333\t\t\t\t\t\t\tdurations[t.Name] = 0\r\n   334\t\t\t\t\t\t\tcompleted++\r\n   335\t\t\t\t\t\t}\r\n"]
[6061.529974, "o", "   336\t\t\t\t\t}\r\n   337\t\t\t\t\tmu.Unlock()\r\n   338\t\t\t\t}\r\n   339\t\t\t\tcontinue\r\n   340\t\t\t}\r\n"]
