[8916.28364, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('main.go')\nlines = p.read_text().splitlines()\nout = []\ni = 0\nwhile i < len(lines):\n    if 'res := executor.execute(t)' in lines[i]:\n        j = i + 1\n        while j < len(lines) and 'resultCh <- res' not in lines[j]:\n            j += 1\n        if j < len(lines):\n            indent = lines[i][:len(lines[i]) - len(lines[i].lstrip())]\n            out.append(indent + 'res := executor.execute(t)')\n            out.append(indent + 'if res.status == \"failed\" && !keepGoing {')\n            out.append(indent + '\\tmu.Lock()')\n            out.append(indent + '\\tcancelled = true')\n            out.append(indent + '\\tmu.Unlock()')\n            out.append(indent + '\\tcancelOnce.Do(func() { close(executor.haltCh) })')\n            out.append(indent + '}')\n            i = j\n            continue\n    out.append(lines[i])\n    i += 1\np.write_text('\\n'.join(out) + '\\n')\nPY\n"]
