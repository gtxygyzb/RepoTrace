[7644.096092, "o", "   235\tfunc runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string, vars []string, keepGoing bool, profile bool) error {\r\n   236\t\tcfg, configDir, err := loadConfig(configPath, vars)\r\n   237\t\tif err != nil {\r\n   238\t\t\treturn err\r\n   239\t\t}\r\n   240"]
[7644.096203, "o", "\t\ttargetMap, err := validateConfig(cfg)\r\n   241\t\tif err != nil {\r\n   242\t\t\treturn err\r\n   243\t\t}\r\n   244\t\trequested, err := selectTargets(cfg, targetMap, targetsFlag)\r\n   245\t\tif err != nil {\r\n   246\t\t\treturn err\r\n   247\t\t}\r\n   248\t\torder := topologicalOrder(cfg, requested)\r\n   249\t\treverseDeps := buildReverseDeps(cfg, requested)\r\n   250\t\r\n   251\t\tcacheKeys := make(map[string]string)\r\n   252\t\tfor i := range cfg.Targets {\r\n   253\t\t\tt := &cfg.Targets[i]\r\n   254\t\t\tif !requested[t.Name] {\r\n   255\t\t\t\tcontinue\r\n   256\t\t\t}\r\n"]
[7644.096288, "o", "   257\t\t\tkey, err := computeCacheKey(t, configDir)\r\n   258\t\t\tif err != nil {\r\n   259\t\t\t\treturn err\r\n   260\t\t\t}\r\n   261\t\t\tcacheKeys[t.Name] = key\r\n   262\t\t}\r\n   263\t\r\n   264\t\texecutor := &buildExecutor{\r\n   265\t\t\tconfig:    cfg,\r\n"]
[7644.096355, "o", "   266\t\t\tconfigDir: configDir,\r\n   267\t\t\tcacheDir:  filepath.Join(configDir, \".buildctl-cache\"),\r\n   268\t\t\tnoCache:   noCache,\r\n   269\t\t}\r\n   270\t\r\n   271\t\tstatus := make(map[string]string)\r\n   272\t\tdurations := make(map[string]int64)\r\n   273\t\tcompleted := 0\r\n   274\t\ttotal := len(requested)"]
[7644.096417, "o", "\r\n   275\t\treadyCh := make(chan *TargetConfig, total+1)\r\n   276\t\tresultCh := make(chan execResult, total+1)\r\n   277\t\r\n   278\t\tvar mu sync.Mutex\r\n   279\t\tstarted := make(map[string]bool)\r\n   280\t\tcancelled := false\r\n   281\t\r\n   282\t\tvar wg sync.WaitGroup\r\n   283\t\tfor i := 0; i < parallel; i++ {\r\n"]
[7644.096519, "o", "   284\t\t\twg.Add(1)\r\n   285\t\t\tgo func() {\r\n   286\t\t\t\tdefer wg.Done()\r\n   287\t\t\t\tfor t := range readyCh {\r\n   288\t\t\t\t\tmu.Lock()\r\n   289\t\t\t\t\tif cancelled {\r\n   290\t\t\t\t\t\tmu.Unlock()\r\n   291\t\t\t\t\t\tcontinue\r\n   292\t\t\t\t\t}\r\n   293\t\t\t\t\tstarted[t.Name] = true\r\n   294\t\t\t\t\tmu.Unlock()\r\n   295\t\t\t\t\tres := executor.execute(t)\r\n   296\t\t\t\t\tif res.status == \"failed\" && !keepGoing {\r\n"]
