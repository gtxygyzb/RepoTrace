[3812.443671, "o", "\u001b[32m\u001b[K770\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (e *buildExecutor) execute\u001b[m\u001b[K(t *TargetConfig) execResult {\r\n\u001b[32m\u001b[K771\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tstart := time.Now()\r\n\u001b[32m\u001b[K772\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tkey, err := computeCacheKey(t, e.configDir)\r\n\u001b[32m\u001b[K773\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K774\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n"]
[3812.443794, "o", "\u001b[32m\u001b[K775\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K776\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K777\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif !e.noCache {\r\n\u001b[32m\u001b[K778\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tvalid, _, err := cacheValid(e.cacheDir, key, t.Outputs, e.configDir)\r\n\u001b[32m\u001b[K779\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err != nil {\r\n\u001b[32m\u001b[K780\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[32m\u001b[K781\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K782\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif valid {\r\n\u001b[32m\u001b[K783\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn execResult{name: t.Name, status: \"cached\", cached: true, durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[32m\u001b[K784\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K785\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K786\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K787\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ttimeout := t.Timeout\r\n\u001b[32m\u001b[K788\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif timeout <= 0 {\r\n\u001b[32m\u001b[K789\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\ttimeout = 300\r\n\u001b[32m\u001b[K790\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K791\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdeadline := time.Now().Add"]
[3812.443877, "o", "(time.Duration(timeout) * time.Second)\r\n\u001b[32m\u001b[K792\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K793\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tbaseEnv := mergedEnv(t.Env)\r\n\u001b[32m\u001b[K794\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tpreEnv := append([]string(nil), baseEnv...)\r\n\u001b[32m\u001b[K795\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K796\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, hook := range t.PreBuild {\r\n\u001b[32m\u001b[K797\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err := e.runHook(t, hook, preEnv, deadline); err != nil {\r\n\u001b[32m\u001b[K798\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[32m\u001b[K799\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n"]
[3812.443947, "o", "\u001b[32m\u001b[K800\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tpreEnv = mergeHookExports(preEnv, hookExportsFromOutput(t, hook))\r\n\u001b[32m\u001b[K801\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K802\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K803\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmainEnv := preEnv\r\n\u001b[32m\u001b[K804\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := e.runHook(t, t.Command, mainEnv, deadline); err != nil {\r\n\u001b[32m\u001b[K805\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[32m\u001b[K806\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K807\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K808\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tpostEnv := append([]string(nil), baseEnv...)\r\n\u001b[32m\u001b[K809\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, hook := range t.PostBuild {\r\n\u001b[32m\u001b[K810\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err := e.runHook(t, hook, postEnv, deadline); err != nil {\r\n\u001b[32m\u001b[K811\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn execResult{name: t.Name, status: \"failed\", durationMS: time.Since(start).Milliseconds(), cacheKey: key}\r\n\u001b[32m\u001b[K812\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K813\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t"]
