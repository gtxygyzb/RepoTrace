[4518.930415, "o", "   687\t\tindeg := map[string]int{}\r\n   688\t\tfor _, t := range cfg.Targets {\r\n   689\t\t\tif !requested[t.Name] {\r\n   690\t\t\t\tcontinue\r\n   691\t\t\t}\r\n   692\t\t\tcount := 0\r\n   693\t\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n   694\t\t\t\tif requested[dep] {\r\n   695\t\t\t\t\tcount++\r\n   696\t\t\t\t}\r\n   697\t\t\t}\r\n   698\t\t\tindeg[t.Name] = count\r\n   699\t\t}\r\n   700\t\r\n   701\t\tqueue := []string{}\r\n   702\t\tfor _, t := range cfg.Targets {\r\n"]
