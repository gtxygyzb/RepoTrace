[6608.173903, "o", "\t\r\n    11\tfunc runDepsCommand(args []string) {\r\n    12\t\tconfigPath := \"\"\r\n    13\t\twhy := false\r\n    14\t\taffected := false\r\n    15\t\tplan := false\r\n    16\t\tvar vars stringSliceFlag\r\n    17\t\tpositional := []string{}\r\n    18\t\r\n    19\t\ti := 0\r\n    20\t\tfor i < len(args) {\r\n    21\t\t\targ := args[i]\r\n    22\t\t\tswitch {\r\n    23\t\t\tcase arg == \"--config\":\r\n    24\t\t\t\tif i+1 >= len(args) {\r\n    25\t\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --config requires a value\")\r\n    26\t\t\t\t\tos.Exit(1)\r\n    27\t\t\t\t}\r\n    28\t\t\t\tconfigPath = args[i+1]\r\n    29\t\t\t\ti += 2\r\n    30\t\t\tcase strings.HasPrefix(arg, \"--config=\"):\r\n    31\t\t\t\tconfigPath = arg[len(\"--config=\"):]\r\n    32\t\t\t\ti++\r\n"]
[6608.174045, "o", "    33\t\t\tcase arg == \"--var\":\r\n    34\t\t\t\tif i+1 >= len(args) {\r\n    35\t\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --var requires a value\")\r\n    36\t\t\t\t\tos.Exit(1)\r\n    37\t\t\t\t}\r\n    38\t\t\t\tif err := vars.Set(args[i+1]); err != nil {\r\n    39\t\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    40\t\t\t\t\tos.Exit(1)\r\n    41\t\t\t\t}\r\n    42\t\t\t\ti += 2\r\n    43\t\t\tcase strings.HasPrefix(arg, \"--var=\"):\r\n    44\t\t\t\tif err := vars.Set(arg[len(\"--var=\"):]); err != nil {\r\n    45\t\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    46\t\t\t\t\tos.Exit(1)\r\n    47\t\t\t\t}\r\n    48\t\t\t\ti++\r\n    49\t\t\tcase arg == \"--why\":\r\n    50\t\t\t\twhy = true\r\n    51\t\t\t\ti++\r\n    52\t\t\tcase arg == \"--affected\":\r\n    53\t\t\t\taffected = true\r\n    54"]
[6608.174173, "o", "\t\t\t\ti++\r\n    55\t\t\tcase arg == \"--plan\":\r\n    56\t\t\t\tplan = true\r\n    57\t\t\t\ti++\r\n    58\t\t\tdefault:\r\n    59\t\t\t\tpositional = append(positional, arg)\r\n    60\t\t\t\ti++\r\n    61\t\t\t}\r\n    62\t\t}\r\n    63\t\r\n    64\t\tif configPath == \"\" {\r\n    65\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n    66\t\t\tos.Exit(1)\r\n    67\t\t}\r\n    68\t\tif plan && !affected {\r\n    69\t\t\tfmt.Fprintln(os.Stderr, \"error: --plan requires --affected\")\r\n    70\t\t\t"]
[6608.174312, "o", "os.Exit(1)\r\n    71\t\t}\r\n    72\t\tif err := runDeps(configPath, []string(vars), positional, why, affected, plan); err != nil {\r\n    73\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    74\t\t\tos.Exit(1)\r\n    75\t\t}\r\n    76\t}\r\n    77\t\r\n    78\tfunc runDeps(configPath string, vars []string, args []string, why, affected, plan bool) error {\r\n    79\t\tcfg, _, err := loadConfig(configPath, vars)\r\n    80\t\tif err != nil {\r\n    81\t\t\treturn err\r\n    82\t\t}\r\n    83\t\ttargetMap, err := validateConfig(cfg)\r\n    84\t\tif err != nil {\r\n    85\t\t\treturn err\r\n    86\t\t}\r\n    87\t\r\n"]
[6608.17443, "o", "    88\t\tif affected {\r\n    89\t\t\tif len(args) == 0 {\r\n    90\t\t\t\treturn fmt.Errorf(\"--affected requires at least one FILE\")\r\n    91\t\t\t}\r\n    92\t\t\treturn runDepsAffected(cfg, targetMap, args, plan)\r\n    93\t\t}\r\n    94\t\r\n    95\t\tif why {\r\n    96\t\t\tif len(args) != 2 {\r\n    97\t\t\t\treturn fmt.Errorf(\"--why requires exactly two target names: FROM TO\")\r\n    98\t\t\t}\r\n    99\t\t\treturn runDepsWhy(cfg, targetMap, args[0], args[1])\r\n   100\t\t}\r\n   101\t\r\n   102\t\tif len(args) != 1 {\r\n   103\t\t\t"]
