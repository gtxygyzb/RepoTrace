[1971.440498, "o", "\t\t}\r\n   766\t\treturn os.WriteFile(filepath.Join(cacheDir, entry.CacheKey+\".json\"), data, 0644)\r\n   767\t}\r\n   768\t\r\n   769\tfunc hashFile(path string) (string, error) {\r\n   770\t\tf, err := os.Open(path)\r\n   771\t\tif err != nil {\r\n   772\t\t\treturn \"\", err\r\n   773\t\t}\r\n   774\t\tdefer f.Close()\r\n   775\t\th := sha256.New()\r\n   776\t\tif _, err := io.Copy(h, f); err != nil {\r\n   777\t\t\treturn \"\", err\r\n   778\t\t}\r\n"]
