[1994.784195, "o", "   333\t\tif _, err := validateConfig(cfg); err != nil {\r\n   334\t\t\treturn err\r\n   335\t\t}\r\n   336\t\tfmt.Printf(\"digraph %s {\\n\", strconv.Quote(cfg.Pipeline.Name))\r\n   337\t\tfor _, t := range cfg.Targets {\r\n   338\t\t\tif len(uniqueStrings(t.Dependencies)) == 0 {\r\n   339\t\t\t\tfmt.Printf(\"  %s;\\n\", strconv.Quote(t.Name))\r\n   340\t\t\t}\r\n   341\t\t}\r\n   342\t\tfor _, t := range cfg.Targets {\r\n   343\t\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n   344\t\t\t\tfmt.Printf(\"  %s -> %s;\\n\", strconv.Quote(t.Name), strconv.Quote(dep))\r\n   345\t\t\t}\r\n   346\t\t}\r\n   347\t\tfmt.Println(\"}\")\r\n   348\t\treturn nil\r\n   349"]
[1994.784319, "o", "\t}\r\n   350\t\r\n   351\tfunc runClean(configPath string) error {\r\n   352\t\tabs, err := filepath.Abs(configPath)\r\n   353\t\tif err != nil {\r\n   354\t\t\treturn err\r\n   355\t\t}\r\n   356\t\tcacheDir := filepath.Join(filepath.Dir(abs), \".buildctl-cache\")\r\n   357\t\treturn os.RemoveAll(cacheDir)\r\n   358"]
[1994.784393, "o", "\t}\r\n   359\t\r\n   360\tfunc runStatus(configPath string) error {\r\n   361\t\tcfg, configDir, err := loadConfig(configPath)\r\n   362\t\tif err != nil {\r\n   363\t\t\treturn err\r\n   364\t\t}\r\n   365\t\tif _, err := validateConfig(cfg); err != nil {\r\n   366\t\t\treturn err\r\n   367\t\t}\r\n   368\t\tcacheDir := filepath.Join(configDir, \".buildctl-cache\")\r\n   369\t\treport := StatusReport{Targets: []StatusTarget{}}\r\n   370\t\tfor i := range cfg.Targets {\r\n   371\t\t\tt := &cfg.Targets[i]\r\n   372\t\t\tkey, err := computeCacheKey(t, configDir)\r\n   373\t\t\tif err != nil {\r\n"]
[1994.78446, "o", "   374\t\t\t\treturn err\r\n   375\t\t\t}\r\n   376\t\t\tvalid, entry, err := cacheValid(cacheDir, key, t.Outputs, configDir)\r\n   377\t\t\tif err != nil {\r\n   378\t\t\t\treturn err\r\n   379\t\t\t}\r\n   380\t\t\tst := StatusTarget{Name: t.Name, Cached: valid}\r\n"]
