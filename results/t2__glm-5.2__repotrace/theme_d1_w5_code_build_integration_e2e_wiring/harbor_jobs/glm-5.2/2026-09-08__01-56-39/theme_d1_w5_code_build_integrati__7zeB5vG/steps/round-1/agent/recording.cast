[1995.064522, "o", "   395\tfunc loadConfig(path string) (*Config, string, error) {\r\n   396\t\tabs, err := filepath.Abs(path)\r\n   397\t\tif err != nil {\r\n   398\t\t\treturn nil, \"\", err\r\n   399\t\t}\r\n   400\t\tvar cfg Config\r\n   401\t\tif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\n"]
[1995.064667, "o", "   402\t\t\treturn nil, \"\", err\r\n   403\t\t}\r\n   404\t\tfor i := range cfg.Targets {\r\n   405\t\t\tcfg.Targets[i].Dependencies = uniqueStrings(cfg.Targets[i].Dependencies)\r\n   406\t\t\tif cfg.Targets[i].Timeout <= 0 {\r\n   407\t\t\t\tcfg.Targets[i].Timeout = 300\r\n   408\t\t\t}\r\n   409\t\t}\r\n   410\t\treturn &cfg, filepath.Dir(abs), nil\r\n   411\t}\r\n   412\t\r\n   413\tfunc validateConfig(cfg *Config) (map[string]*TargetConfig, error) {\r\n   414\t\ttargetMap := map[string]*TargetConfig{}\r\n   415\t\tfor i := range cfg.Targets {\r\n   416\t\t\tt := &cfg.Targets[i]\r\n   417\t\t\tif t.Name == \"\" {\r\n"]
[1995.064756, "o", "   418\t\t\t\treturn nil, fmt.Errorf(\"target name is empty\")\r\n   419\t\t\t}\r\n   420\t\t\tif _, ok := targetMap[t.Name]; ok {\r\n   421\t\t\t\treturn nil, fmt.Errorf(\"duplicate target name %q\", t.Name)\r\n   422\t\t\t}\r\n   423\t\t\ttargetMap[t.Name] = t\r\n   424\t\t}\r\n   425\t\r\n   426\t\tfor _, t := range targetMap {\r\n   427\t\t\tfor _, dep := range t.Dependencies {\r\n   428\t\t\t\tif _, ok := targetMap[dep]; !ok {\r\n   429\t\t\t\t\treturn nil, fmt.Errorf(\"target %q depends on missing target %q\", t.Name, dep)\r\n"]
