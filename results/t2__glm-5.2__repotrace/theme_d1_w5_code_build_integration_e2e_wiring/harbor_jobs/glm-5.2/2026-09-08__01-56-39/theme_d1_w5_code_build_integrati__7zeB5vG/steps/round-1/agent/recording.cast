[7084.848833, "o", "   617\tfunc expandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {\r\n   618\t\tvar b strings.Builder\r\n   619\t\ti := 0\r\n   620\t"]
[7084.848848, "o", "\tfor i < len(s) {\r\n   621\t\t\tif i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {\r\n"]
[7084.848907, "o", "   622\t\t\t\tend := strings.Index(s[i:], \"}\")\r\n"]
[7084.848927, "o", "   623\t\t\t\tif end == -1 {\r\n   624\t\t\t\t\treturn \"\", fmt.Errorf(\"unterminated variable reference in %q\", s)\r\n   625\t\t\t\t}\r\n   626\t\t\t\tname := s[i+2 : i+end]\r\n   627\t\t\t\tif name == \"\" {\r\n   628\t\t\t\t\treturn \"\", fmt.Errorf(\"empty variable reference in %q\", s)\r\n   629\t\t\t\t}\r\n   630\t\t\t"]
[7084.849045, "o", "\tif visiting[name] {\r\n   631\t\t\t\t\treturn \"\", fmt.Errorf(\"variable cycle detected: %q\", name)\r\n   632\t\t\t\t}\r\n   633\t\t\t\tval, ok := vars[name]\r\n   634\t\t\t\tif !ok {\r\n   635\t\t\t\t\treturn \"\", fmt.Errorf(\"unresolved variable %q\", name)\r\n   636\t\t\t\t}\r\n   637\t\t\t\tvisiting[name] = true\r\n   638\t\t\t\texpanded, err := expandString(val, vars, visiting)\r\n   639\t\t\t\tif err != nil {\r\n   640\t\t\t\t\treturn \"\", err\r\n   641\t\t\t\t}\r\n   642\t\t\t\tdelete(visiting, name)\r\n   643\t\t\t\tb.WriteString(expanded)\r\n   644\t\t\t\ti += end + 1\r\n   645\t\t\t} else {\r\n   646\t\t\t\tb.WriteByte(s[i])\r\n   647\t\t\t\ti++\r\n   648\t\t\t}\r\n"]
[7084.849057, "o", "   649\t\t}\r\n   650\t\treturn b.String(), nil\r\n   651\t"]
[7084.849128, "o", "}\r\n   652\t\r\n   653\tfunc validateConfig(cfg *Config) (map[string]*TargetConfig, error) {\r\n   654\t\ttargetMap := map[string]*TargetConfig{}\r\n   655\t\tfor i := range cfg.Targets {\r\n   656\t\t\tt := &cfg.Targets[i]\r\n   657\t\t\tif t.Name == \"\" {\r\n   658\t\t\t\treturn nil, fmt.Errorf(\"target name is empty\")\r\n"]
[7084.849141, "o", "   659\t\t\t}\r\n   660\t\t\tif _, ok := targetMap[t.Name]; ok {\r\n"]
[7084.849208, "o", "   661\t\t\t\treturn nil, fmt.Errorf(\"duplicate target name %q\", t.Name)\r\n   662\t\t\t}\r\n   663\t\t\ttargetMap[t.Name] = t\r\n   664\t\t}\r\n   665\t\r\n   666\t\tfor _, t := range targetMap {\r\n   667\t\t\tfor _, dep := range t.Dependencies {\r\n   668\t\t\t\tif _, ok := targetMap[dep]; !ok {\r\n   669\t\t\t\t\treturn nil, fmt.Errorf(\"target %q depends on missing target %q\", t.Name, dep)\r\n"]
[7084.849221, "o", "   670\t\t\t\t}\r\n   671\t\t\t}\r\n"]
[7084.849308, "o", "   672\t\t}\r\n   673\t\r\n"]
[7084.849323, "o", "   674\t\tstates := map[string]int{}\r\n   675\t\tvar stack []string\r\n   676\t\tvar dfs func(name string) error\r\n   677\t\tdfs = func(name string) error {\r\n   678\t\t\tstates[name] = 1\r\n   679\t\t\tstack = append(stack, name)\r\n   680\t\t\tfor _, dep := range targetMap[name].Dependencies {\r\n   681\t\t\t\tif states[dep] == 1 {\r\n   682\t\t\t\t\tidx := 0\r\n   683\t\t\t\t\tfor i, s := range stack {\r\n   684\t\t\t\t\t\tif s == dep {\r\n   685\t\t\t\t\t\t\tidx = i\r\n   686\t\t\t\t\t\t\tbreak\r\n"]
[7084.849389, "o", "   687\t\t\t\t\t\t}\r\n   688\t\t\t\t\t}\r\n   689\t\t\t\t\tcycle := append([]string{}, stack[idx:]...)\r\n   690\t\t\t\t\tcycle = append(cycle, dep)\r\n   691\t\t\t\t\treturn fmt.Errorf(\"cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n   692\t\t\t\t}\r\n   693\t\t\t\tif states[dep] == 0 {\r\n"]
[7084.849401, "o", "   694\t\t\t\t\tif err := dfs(dep); err != nil {\r\n"]
[7084.849461, "o", "   695\t\t\t\t\t\treturn err\r\n   696\t\t\t\t\t}\r\n   697\t\t\t\t}\r\n   698\t\t\t}\r\n   699\t\t\tstack = stack[:len(stack)-1]\r\n   700\t\t\tstates[name] = 2\r\n   701\t\t\treturn nil\r\n   702\t\t}\r\n   703\t\r\n   704"]
[7084.849476, "o", "\t\tnames := make([]string, 0, len(targetMap))\r\n   705\t\tfor n := range targetMap {\r\n"]
[7084.849541, "o", "   706\t\t\tnames = append(names, n)\r\n   707\t\t"]
[7084.849556, "o", "}\r\n   708\t\tsort.Strings(names)\r\n   709\t\tfor _, n := range names {\r\n   710\t\t\tif states[n] == 0 {\r\n   711\t\t\t\tif err := dfs(n); err != nil {\r\n   712\t\t\t\t\treturn nil, err\r\n   713\t\t\t\t}\r\n   714\t\t\t}\r\n"]
[7084.849623, "o", "   715\t\t}\r\n   716\t\treturn targetMap, nil\r\n   717\t}\r\n   718\t\r\n"]
