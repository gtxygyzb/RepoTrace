[6538.426119, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n)\r\n"]
[6538.426251, "o", "\r\nfunc runDepsCommand(args []string) {\r\n\tconfigPath := \"\"\r\n\twhy := false\r\n\taffected := false\r\n\tplan := false\r\n\tvar vars stringSliceFlag\r\n\tpositional := []string{}\r\n\r\n\ti := 0\r\n\tfor i < len(args) {\r\n\t\targ := args[i]\r\n\t\tswitch {\r\n\t\tcase arg == \"--config\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --config requires a value\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tconfigPath = args[i+1]\r\n"]
[6538.426306, "o", "\t\t\ti += 2\r\n\t\tcase strings.HasPrefix(arg, \"--config=\"):\r\n\t\t\tconfigPath = arg[len(\"--config=\"):]\r\n\t\t\ti++\r\n\t\tcase arg == \"--var\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --var requires a value\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n"]
[6538.426348, "o", "\t\t\tif err := vars.Set(args[i+1]); err != nil {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ti += 2\r\n\t\tcase strings.HasPrefix(arg, \"--var=\"):\r\n\t\t\tif err := vars.Set(arg[len(\"--var=\"):]); err != nil {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[6538.426389, "o", "\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ti++\r\n\t\tcase arg == \"--why\":\r\n\t\t\twhy = true\r\n\t\t\ti++\r\n"]
[6538.426429, "o", "\t\tcase arg == \"--affected\":\r\n\t\t\taffected = true\r\n\t\t\ti++\r\n\t\tcase arg == \"--plan\":\r\n\t\t\tplan = true\r\n"]
[6538.426468, "o", "\t\t\ti++\r\n\t\tdefault:\r\n\t\t\tpositional = append(positional, arg)\r\n\t\t\ti++\r\n\t\t}\r\n\t}\r\n\r\n\tif configPath == \"\" {\r\n"]
[6538.426505, "o", "\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif plan && !affected {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --plan requires --affected\")\r\n\t\tos.Exit(1)\r\n"]
[6538.426543, "o", "\t}\r\n\tif err := runDeps(configPath, []string(vars), positional, why, affected, plan); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n"]
[6538.426581, "o", "\r\nfunc runDeps(configPath string, vars []string, args []string, why, affected, plan bool) error {\r\n\tcfg, _, err := loadConfig(configPath, vars)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\ttargetMap, err := validateConfig(cfg)\r\n"]
[6538.426619, "o", "\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n\tif affected {\r\n\t\tif len(args) == 0 {\r\n\t\t\treturn fmt.Errorf(\"--affected requires at least one FILE\")\r\n\t\t}\r\n"]
[6538.426658, "o", "\t\treturn runDepsAffected(cfg, targetMap, args, plan)\r\n\t}\r\n\r\n\tif why {\r\n\t\tif len(args) != 2 {\r\n\t\t\treturn fmt.Errorf(\"--why requires exactly two target names: FROM TO\")\r\n\t\t}\r\n"]
[6538.426696, "o", "\t\treturn runDepsWhy(cfg, targetMap, args[0], args[1])\r\n\t}\r\n\r\n\tif len(args) != 1 {\r\n\t\treturn fmt.Errorf(\"deps requires exactly one target name\")\r\n\t}\r\n\treturn runDepsTarget(cfg, targetMap, args[0])\r\n}\r\n"]
[6538.426734, "o", "\r\nfunc runDepsTarget(cfg *Config, targetMap map[string]*TargetConfig, target string) error {\r\n\tif _, ok := targetMap[target]; !ok {\r\n\t\tfailDepsJSON(fmt.Sprintf(\"target %q does not exist\", target))\r\n\t\treturn nil\r\n\t}\r\n\r\n"]
[6538.426773, "o", "\tdirectSet := map[string]bool{}\r\n\tfor _, dep := range uniqueStrings(targetMap[target].Dependencies) {\r\n\t\tdirectSet[dep] = true\r\n\t}\r\n\tdirect := sortedKeys(directSet)\r\n\r\n\ttransitiveSet := map[string]bool{}\r\n"]
[6538.426812, "o", "\tcollectTransitiveDeps(targetMap, target, transitiveSet)\r\n\tdelete(transitiveSet, target)\r\n\ttransitive := sortedKeys(transitiveSet)\r\n\r\n\treverseSet := map[string]bool{}\r\n\tfor _, t := range cfg.Targets {\r\n\t\tif t.Name == target {\r\n"]
[6538.42685, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tseen := map[string]bool{}\r\n\t\tif dependsOnTransitive(targetMap, t.Name, target, seen) {\r\n\t\t\treverseSet[t.Name] = true\r\n\t\t}\r\n\t}\r\n"]
[6538.426887, "o", "\treverse := sortedKeys(reverseSet)\r\n\r\n\treturn emitJSON(map[string]interface{}{\r\n\t\t\"target\":          target,\r\n\t\t\"direct_deps\":     direct,\r\n"]
[6538.426924, "o", "\t\t\"transitive_deps\": transitive,\r\n\t\t\"reverse_deps\":    reverse,\r\n\t})\r\n}\r\n\r\nfunc runDepsWhy(cfg *Config, targetMap map[string]*TargetConfig, from, to string) error {\r\n\tif _, ok := targetMap[from]; !ok {\r\n\t\tfailDepsJSON(fmt.Sprintf(\"target %q does not exist\", from))\r\n"]
[6538.426966, "o", "\t\treturn nil\r\n\t}\r\n\tif _, ok := targetMap[to]; !ok {\r\n\t\tfailDepsJSON(fmt.Sprintf(\"target %q does not exist\", to))\r\n\t\treturn nil\r\n\t}\r\n"]
[6538.427005, "o", "\r\n\tpaths := allDependencyPaths(targetMap, from, to)\r\n\tsortPaths(paths)\r\n\treturn emitJSON(map[string]interface{}{\r\n\t\t\"from\":  from,\r\n\t\t\"to\":    to,\r\n\t\t\"paths\": paths,\r\n"]
[6538.427043, "o", "\t})\r\n}\r\n\r\nfunc runDepsAffected(cfg *Config, targetMap map[string]*TargetConfig, files []string, plan bool) error {\r\n\tfileSet := map[string]bool{}\r\n\tfor _, f := range files {\r\n\t\tfileSet[f] = true\r\n\t}\r\n\r\n"]
[6538.427081, "o", "\taffectedSet := map[string]bool{}\r\n\tdirectAffected := map[string]bool{}\r\n\tfor i := range cfg.Targets {\r\n\t\tt := &cfg.Targets[i]\r\n\t\tfor _, input := range t.Inputs {\r\n\t\t\tif fileSet[input] {\r\n"]
[6538.427117, "o", "\t\t\t\taffectedSet[t.Name] = true\r\n\t\t\t\tdirectAffected[t.Name] = true\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[6538.427155, "o", "\tqueue := sortedKeys(affectedSet)\r\n\tfor len(queue) > 0 {\r\n\t\tname := queue[0]\r\n\t\tqueue = queue[1:]\r\n\t\tfor _, t := range cfg.Targets {\r\n\t\t\tif affectedSet[t.Name] {\r\n"]
[6538.427193, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tfor _, dep := range uniqueStrings(t.Dependencies) {\r\n\t\t\t\tif dep == name {\r\n\t\t\t\t\taffectedSet[t.Name] = true\r\n\t\t\t\t\tqueue = append(queue, t.Name)\r\n"]
[6538.427238, "o", "\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t"]
[6538.427278, "o", "if len(affectedSet) == 0 {\r\n\t\tif plan {\r\n\t\t\treturn emitJSON(map[string]interface{}{\"rebuild_plan\": []interface{}{}})\r\n"]
[6538.427317, "o", "\t\t}\r\n\t\treturn emitJSON(map[string]interface{}{\"rebuild_order\": []interface{}{}})\r\n\t}\r\n\r\n\tif plan {\r\n\t\tlayers := buildRebuildLayers(targetMap, affectedSet, directAffected)\r\n\t\treturn emitJSON(map[string]interface{}{\"rebuild_plan\": layers})\r\n\t}\r\n"]
[6538.427356, "o", "\r\n\torder := topologicalOrderSubset(cfg, affectedSet)\r\n\tentries := []map[string]interface{}{}\r\n\tfor _, name := range order {\r\n\t\tentries = append(entries, map[string]interface{}{\r\n\t\t\t\"target\": name,\r\n\t\t"]
[6538.427395, "o", "\t\"direct\": directAffected[name],\r\n\t\t})\r\n\t}\r\n\treturn emitJSON(map[string]interface{}{\"rebuild_order\": entries})\r\n}\r\n\r\nfunc collectTransitiveDeps(targetMap map[string]*TargetConfig, name string, seen map[string]bool) {\r\n\tfor _, dep := range uniqueStrings(targetMap[name].Dependencies) {\r\n"]
[6538.427432, "o", "\t\tif !seen[dep] {\r\n\t\t\tseen[dep] = true\r\n\t\t\tcollectTransitiveDeps(targetMap, dep, seen)\r\n\t\t}\r\n\t}\r\n}\r\n"]
[6538.427472, "o", "\r\nfunc dependsOnTransitive(targetMap map[string]*TargetConfig, name, target string, seen map[string]bool) bool {\r\n\tif seen[name] {\r\n\t\treturn false\r\n\t}\r\n\tseen[name] = true\r\n"]
[6538.427512, "o", "\tfor _, dep := range uniqueStrings(targetMap[name].Dependencies) {\r\n\t\tif dep == target {\r\n\t\t\treturn true\r\n\t\t}\r\n\t\tif dependsOnTransitive(targetMap, dep, target, seen) {\r\n\t\t\treturn true\r\n\t\t}\r\n"]
[6538.427552, "o", "\t}\r\n\treturn false\r\n}\r\n\r\nfunc allDependencyPaths(targetMap map[string]*TargetConfig, from, to string) [][]string {\r\n\tpaths := [][]string{}\r\n\tvar current []string\r\n\tvisited := map[string]bool{}\r\n"]
[6538.427589, "o", "\r\n\tvar dfs func(node string)\r\n\tdfs = func(node string) {\r\n\t\tif visited[node] {\r\n\t\t\treturn\r\n\t\t}\r\n\t"]
[6538.427625, "o", "\tcurrent = append(current, node)\r\n\t\tvisited[node] = true\r\n"]
