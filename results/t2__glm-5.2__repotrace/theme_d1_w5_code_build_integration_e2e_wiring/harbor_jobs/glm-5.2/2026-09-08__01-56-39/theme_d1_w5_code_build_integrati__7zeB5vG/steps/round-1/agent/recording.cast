[5197.887213, "i", "gs) {\n\\t\\t\\t\\tfmt.Fprintln(os.Stderr, \"error: --var requires a value\")\n\\t\\t\\t\\tos.Exit(1)\n\\t\\t\\t}\n\\t\\t\\tif err := vars.Set(args[i+1]); err != nil {\n\\t\\t\\t\\tfmt.Fprintln(os.Stderr, err)\n\\t\\t\\t\\tos.Exit(1)\n\\t\\t\\t}\n\\t\\t\\ti += 2\n\\t\\tcase strings.HasPrefix(arg, \"--var=\"):\n\\t\\t\\tif err := vars.Set(arg[len(\"--var=\"):]); err != nil {\n\\t\\t\\t\\tfmt.Fprintln(os.Stderr, err)\n\\t\\t\\t\\tos.Exit(1)\n\\t\\t\\t}\n\\t\\t\\ti++\n\\t\\tcase arg == \"--why\":\n\\t\\t\\twhy = true\n\\t\\t\\ti++\n\\t\\tcase arg == \"--affected\":\n\\t\\t\\taffected = true\n\\t\\t\\ti++\n\\t\\tcase arg == \"--plan\":\n\\t\\t\\tplan = true\n\\t\\t\\ti++\n\\t\\tdefault:\n\\t\\t\\tpositional = append(positional, arg)\n\\t\\t\\ti++\n\\t\\t}\n\\t}\n\n\\tif configPath == \"\" {\n\\t\\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\n\\t\\tos.Exit(1)\n\\t}\n\\tif *plan && !*affected {\n\\t\\tfmt.Fprintln(os.Stderr, \"error: --plan requires --affected\")\n\\t\\tos.Exit(1)\n\\t}\n\\tif err := runDeps(configPath, []string(vars), positional, why, affected, plan); err != nil {\n\\t\\tfmt.Fprintln(os.Stderr, err)\n\\t\\tos.Exit(1)\n\\t}\n}\n'''\ns = s[:star"]
