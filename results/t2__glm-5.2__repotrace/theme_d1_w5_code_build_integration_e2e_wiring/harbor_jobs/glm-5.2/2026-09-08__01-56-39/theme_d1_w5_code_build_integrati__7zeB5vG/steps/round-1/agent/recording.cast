[6614.872323, "o", "\t}\r\n   445\t\tcacheDir := filepath.Join(configDir, \".buildctl-cache\")\r\n   446\t\treport := StatusReport{Targets: []StatusTarget{}}\r\n   447\t\tfor i := range cfg.Targets {\r\n   448\t\t\tt := &cfg.Targets[i]\r\n   449\t\t\tkey, err := computeCacheKey(t, configDir)\r\n   450\t\t\tif err != nil {\r\n   451\t\t\t\treturn err\r\n"]
