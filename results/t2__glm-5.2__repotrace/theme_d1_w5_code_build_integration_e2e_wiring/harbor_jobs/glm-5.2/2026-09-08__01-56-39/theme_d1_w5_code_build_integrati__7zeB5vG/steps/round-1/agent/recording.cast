[1970.046212, "o", "\r\n   181\t\tfs.SetOutput(os.Stderr)\r\n   182\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   183\t\tif err := fs.Parse(args); err != nil {\r\n   184\t\t\tos.Exit(1)\r\n   185\t\t}\r\n   186\t\tif *configPath == \"\" {\r\n   187\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n"]
[1970.046339, "o", "   188\t\t\tos.Exit(1)\r\n   189\t\t}\r\n   190\t\tif err := runStatus(*configPath); err != nil {\r\n   191\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   192\t\t\tos.Exit(1)\r\n   193\t\t}\r\n   194\t}\r\n   195\t\r\n   196\tfunc runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string) error {\r\n   197\t\tcfg, configDir, err := loadConfig(configPath)\r\n   198\t\tif err != nil {\r\n   199\t\t\treturn err\r\n   200\t\t}\r\n   201\t\ttargetMap, err := validateConfig(cfg)\r\n   202\t\tif err != nil {\r\n   203\t\t\treturn err\r\n"]
