[1994.503525, "o", "   286\t\t\t}\r\n   287\t\t\treport.Targets = append(report.Targets, BuildTargetReport{\r\n   288\t\t\t\tName:       name,\r\n   289\t\t\t\tStatus:     st,\r\n   290\t\t\t\tCached:     st == \"cached\",\r\n   291\t\t\t\tDurationMS: durations[name],\r\n   292\t\t\t\tCacheKey:   cacheKeys[name],\r\n   293\t\t\t})\r\n   294\t\t}\r\n   295\t\r\n   296\t\tsummary := BuildSummary{Total: len(report.Targets)}\r\n   297\t\tfor _, t := range report.Targets {\r\n   298\t\t\tswitch t.Status {\r\n   299\t\t\tcase \"built\":\r\n   300\t\t\t\tsummary.Built++\r\n   301\t\t\tcase \"cached\":\r\n   302\t\t\t\tsummary.Cached++\r\n   303\t\t\tcase \"failed\":\r\n   304\t\t\t\tsummary.Failed++\r\n   305\t\t\tcase \"skipped\":\r\n   306\t\t\t\tsummary.Skipped++\r\n   307\t\t\t}\r\n   308\t\t}\r\n   309\t\tsummary.DurationMS = time.Since(buildStart).Milliseconds()\r\n   310\t\treport.Summary = summary\r\n   311\t\r\n   312\t\tdata, err := json.MarshalIndent(report, \"\", \"  \")\r\n"]
