[4494.209753, "o", "\r\n\tvar wg sync.WaitGroup\r\n\tfor i := 0; i < parallel; i++ {\r\n\t\twg.Add(1)\r\n\t\tgo func() {\r\n\t\t\tdefer wg.Done()\r\n\t\t\tfor t := range readyCh {\r\n\t\t\t\t"]
