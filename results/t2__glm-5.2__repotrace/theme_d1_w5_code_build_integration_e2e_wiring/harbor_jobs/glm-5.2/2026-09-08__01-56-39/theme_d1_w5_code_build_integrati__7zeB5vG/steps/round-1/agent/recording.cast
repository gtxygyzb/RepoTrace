[8167.5136, "o", "   269\t\t\tconfig:    cfg,\r\n   270\t\t\tconfigDir: configDir,\r\n   271\t\t\tcacheDir:  filepath.Join(configDir, \".buildctl-cache\"),\r\n   272\t\t\tnoCache:   noCache,\r\n   273\t\t\thaltCh:    make(chan struct{}),\r\n   274\t"]
[8167.513788, "o", "\t}\r\n   275\t\r\n   276\t\tstatus := make(map[string]string)\r\n   277\t\tdurations := make(map[string]int64)\r\n   278\t\tattempts := make(map[string]int)\r\n   279\t\tcompleted := 0\r\n   280\t\ttotal := len(requested)\r\n   281\t\treadyCh := make(chan *TargetConfig, total+1)\r\n   282\t\tresultCh := make(chan execResult, total+1)\r\n   283\t\r\n   284\t\tvar mu sync.Mutex\r\n   285\t\tstarted := make(map[string]bool)\r\n   286\t\tcancelled := false\r\n   287\t\tvar cancelOnce sync.Once\r\n   288\t\r\n   289\t\tvar wg sync.WaitGroup\r\n   290\t\tfor i := 0; i < parallel; i++ {\r\n   291\t\t\twg.Add(1)\r\n   292\t\t\tgo func() {\r\n   293\t\t\t\tdefer wg.Done()\r\n   294\t\t\t\tfor t := range readyCh {\r\n   295\t\t\t\t\tmu.Lock()\r\n   296\t\t\t\t\tif cancelled {\r\n   297\t\t\t\t\t\tmu.Unlock()\r\n   298\t\t\t\t\t\tcontinue\r\n   299\t\t\t\t\t"]
[8167.513871, "o", "}\r\n   300\t\t\t\t\tstarted[t.Name] = true\r\n   301\t\t\t\t\tmu.Unlock()\r\n   302\t\t\t\t\tres := executor.execute(t)\r\n   303\t\t\t\t\tif res.status == \"failed\" && !keepGoing {\r\n   304\t\t\t\t\t\tmu.Lock()\r\n   305\t\t\t\t\t\tcancelled = true\r\n   306\t\t\t\t\t\tmu.Unlock()\r\n"]
[8167.513942, "o", "   307\t\t\t\t\t}\r\n   308\t\t\t\t\tresultCh <- res\r\n   309\t\t\t\t}\r\n   310\t\t\t}()\r\n   311\t\t}\r\n   312\t\r\n   313\t\tbuildStart := time.Now()\r\n   314\t\tfor i := range cfg.Targets {\r\n   315\t\t\tt := &cfg.Targets[i]\r\n   316\t\t\tif requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {\r\n"]
[8167.514011, "o", "   317\t\t\t\treadyCh <- t\r\n   318\t\t\t}\r\n   319\t\t}\r\n   320\t\r\n   321\t\tfor completed < total {\r\n   322\t\t\tres := <-resultCh\r\n   323\t\t\tstatus[res.name] = res.status\r\n   324\t\t\tdurations[res.name] = res.durationMS\r\n   325\t\t\tattempts[res.name] = res.attempts\r\n"]
[8167.514091, "o", "   326\t\t\tif res.cacheKey != \"\" {\r\n   327\t\t\t\tcacheKeys[res.name] = res.cacheKey\r\n   328\t\t\t}\r\n   329\t\t\tcompleted++\r\n   330\t\r\n   331\t\t\tif res.status == \"built\" || res.status == \"cached\" {\r\n   332\t\t\t\tmu.Lock()\r\n   333\t\t\t\tcanSchedule := !cancelled\r\n   334\t\t\t\tmu.Unlock()\r\n   335\t\t\t\tif canSchedule {\r\n   336\t\t\t\t\tfor _, dependent := range reverseDeps[res.name] {\r\n"]
[8167.514165, "o", "   337\t\t\t\t\t\tif allDependenciesComplete(dependent, targetMap, requested, status) {\r\n   338\t\t\t\t\t\t\treadyCh <- targetMap[dependent]\r\n   339\t\t\t\t\t\t}\r\n   340\t\t\t\t\t}\r\n   341\t\t\t\t}\r\n   342\t\t\t\tcontinue\r\n   343\t\t\t}\r\n   344\t\r\n   345\t\t\tif res.status == \"cancelled\" {\r\n   346\t\t\t\t"]
[8167.514271, "o", "markSkipped(reverseDeps, status, durations, &completed, res.name)\r\n   347\t\t\t\tif !keepGoing {\r\n   348\t\t\t\t\tmu.Lock()\r\n   349\t\t\t\t\tcancelled = true\r\n   350\t\t\t\t\tcancelOnce.Do(func() { close(executor.haltCh) })\r\n   351\t\t\t\t\tfor i := range cfg.Targets {\r\n   352\t\t\t\t\t\tt := &cfg.Targets[i]\r\n   353\t\t\t\t\t\tif !requested[t.Name] {\r\n   354\t\t\t\t\t\t\tcontinue\r\n   355\t\t\t\t\t\t}\r\n   356\t\t\t\t\t\tif status[t.Name] == \"\" && !started[t.Name] {\r\n   357\t\t\t\t\t\t\tstatus[t.Name] = \"cancelled\""]
[8167.514376, "o", "\r\n   358\t\t\t\t\t\t\tdurations[t.Name] = 0\r\n   359\t\t\t\t\t\t\tattempts[t.Name] = 0\r\n   360\t\t\t\t\t\t\tcompleted++\r\n   361\t\t\t\t\t\t}\r\n   362\t\t\t\t\t}\r\n   363\t\t\t\t\tmu.Unlock()\r\n   364\t\t\t\t}\r\n   365\t\t\t\tcontinue\r\n   366\t\t\t}\r\n   367\t\r\n   368\t\t\tif res.status == \"failed\" {\r\n   369\t\t\t\tmarkSkipped(reverseDeps, status, durations, &completed, res.name)\r\n"]
[8167.514456, "o", "   370\t\t\t\tif !keepGoing {\r\n   371\t\t\t\t\tmu.Lock()\r\n   372\t\t\t\t\tcancelled = true\r\n   373\t\t\t\t\tcancelOnce.Do(func() { close(executor.haltCh) })\r\n   374\t\t\t\t\tfor i := range cfg.Targets {\r\n   375\t\t\t\t\t\tt := &cfg.Targets[i]\r\n   376\t\t\t\t\t\tif !requested[t.Name] {\r\n   377\t\t\t\t\t\t\tcontinue\r\n   378\t\t\t\t\t\t}\r\n"]
[8167.514531, "o", "   379\t\t\t\t\t\tif status[t.Name] == \"\" && !started[t.Name] {\r\n   380\t\t\t\t\t\t\tstatus[t.Name] = \"cancelled\"\r\n   381\t\t\t\t\t\t\tdurations[t.Name] = 0\r\n   382\t\t\t\t\t\t\tattempts[t.Name] = 0\r\n   383\t\t\t\t\t\t\tcompleted++\r\n   384\t\t\t\t\t\t}\r\n   385\t\t\t\t\t}\r\n   386\t\t\t\t\tmu.Unlock()\r\n   387\t\t\t\t}\r\n   388\t\t\t\tcontinue\r\n"]
[8167.514596, "o", "   389\t\t\t}\r\n   390\t\t}\r\n"]
