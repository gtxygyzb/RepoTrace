[7609.274014, "o", "    12\t\t\"os\"\r\n    13\t\t\"os/exec\"\r\n    14\t\t\"path/filepath\"\r\n    15\t\t\"regexp\"\r\n    16\t\t\"runtime\"\r\n    17\t\t\"sort\"\r\n    18\t\t\"strconv\"\r\n    19\t\t\"strings\"\r\n    20\t\t\"sync\"\r\n    21\t\t\"syscall\"\r\n    22\t\t\"time\"\r\n    23\t\r\n    24\t\t\"github.com/BurntSushi/toml\"\r\n    25\t)\r\n    26\t\r\n    27\ttype stringSliceFlag []string\r\n    28\t\r\n    29\tfunc (s *stringSliceFlag) String() string {\r\n    30\t\treturn strings.Join(*s, \",\")\r\n    31\t}\r\n    32\t\r\n    33\tfunc (s *stringSliceFlag) Set(value string) error {\r\n    34\t\t*s = append(*s, value)\r\n    35\t\treturn nil\r\n    36\t}\r\n    37\t\r\n    38\ttype PipelineConfig struct {\r\n    39\t\t"]
[7609.274101, "o", "Name    string   `toml:\"name\"`\r\n    40\t\tImports []string `toml:\"imports\"`\r\n    41\t}\r\n    42\t\r\n    43\ttype TargetConfig struct {\r\n    44\t\tName          string              `toml:\"name\"`\r\n    45\t\tCommand       string              `toml:\"command\"`\r\n    46\t\tDependencies  []string            `toml:\"dependencies\"`\r\n    47\t\tInputs        []string            `toml:\"inputs\"`\r\n    48\t\tOutputs       []string            `toml:\"outputs\"`\r\n    49\t\tEnv           map[string]string   `toml:\"env\"`\r\n    50\t\tPreBuild      []string            `toml:\"pre_build\"`\r\n    51\t\tPostBuild     []string            `toml:\"post_build\"`\r\n"]
[7609.274164, "o", "    52\t\tTimeout       int                 `toml:\"timeout\"`\r\n    53\t\tMatrix        map[string][]string `toml:\"matrix\"`\r\n    54\t\tMatrixInclude []map[string]string `toml:\"matrix_include\"`\r\n    55\t\tMatrixExclude []map[string]string `toml:\"matrix_exclude\"`\r\n    56\t}\r\n    57\t\r\n    58\ttype Config struct {\r\n"]
[7609.274333, "o", "    59\t\tPipeline  PipelineConfig    `toml:\"pipeline\"`\r\n    60\t\tTargets   []TargetConfig    `toml:\"targets\"`\r\n    61\t\tVariables map[string]string `toml:\"variables\"`\r\n    62\t}\r\n    63\t\r\n    64\ttype CacheEntry struct {\r\n    65\t\tCacheKey   string   `json:\"cache_key\"`\r\n    66\t\tTargetName string   `json:\"target_name\"`\r\n    67\t\tTimestamp  string   `json:\"timestamp\"`\r\n    68\t\tOutputs    []string `json:\"outputs\"`\r\n    69\t}\r\n    70\t\r\n    71\ttype BuildTargetReport struct {\r\n    72\t\tName       string `json:\"name\"`\r\n    73\t\tStatus     string `json:\"status\"`\r\n    74\t\tCached     bool   `json:\"cached\"`\r\n    75\t\tDurationMS int64  `json:\"duration_ms\"`\r\n    76\t\tCacheKey   string `json:\"cache_key\"`\r\n    77\t}\r\n    78\t\r\n    79\ttype BuildReport struct {\r\n    80\t\tPipeline string              `json:\"pipeline\"`\r\n    81\t\tTargets  []BuildTargetReport `json:\"targets\"`\r\n"]
[7609.274419, "o", "    82\t\tSummary  BuildSummary        `json:\"summary\"`\r\n    83\t\tProfile  *BuildProfile       `json:\"profile,omitempty\"`\r\n    84\t}\r\n    85\t\r\n    86\ttype BuildProfile struct {\r\n    87\t\tCriticalPath   []string `json:\"critical_path\"`\r\n    88\t\tCriticalPathMS int64    `json:\"critical_path_ms\"`\r\n"]
[7609.274485, "o", "    89\t}\r\n    90\t\r\n    91\ttype BuildSummary struct {\r\n    92\t\tTotal      int   `json:\"total\"`\r\n    93\t\tBuilt      int   `json:\"built\"`\r\n    94\t\tCached     int   `json:\"cached\"`\r\n    95\t\tFailed     int   `json:\"failed\"`\r\n    96\t\tSkipped    int   `json:\"skipped\"`\r\n    97\t\tCancelled  int   `json:\"cancelled\"`\r\n    98\t\tDurationMS int64 `json:\"duration_ms\"`\r\n    99\t}\r\n   100\t\r\n   101\ttype StatusTarget struct {\r\n   102\t\tName     string `json:\"name\"`\r\n   103\t\tCached   bool   `json:\"cached\"`\r\n"]
[7609.274543, "o", "   104\t\tCacheKey string `json:\"cache_key,omitempty\"`\r\n   105\t\tCachedAt string `json:\"cached_at,omitempty\"`\r\n   106\t}\r\n   107\t\r\n   108\ttype StatusReport struct {\r\n   109\t\tTargets []StatusTarget `json:\"targets\"`\r\n   110\t}\r\n   111\t\r\n   112\ttype execResult struct {\r\n   113"]
[7609.274606, "o", "\t\tname       string\r\n   114\t\tstatus     string\r\n   115\t\tcached     bool\r\n   116\t\tdurationMS int64\r\n   117\t\tcacheKey   string\r\n   118\t}\r\n   119\t\r\n   120\ttype buildExecutor struct {\r\n   121\t\tconfig    *Config\r\n"]
[7609.274667, "o", "   122\t\tconfigDir string\r\n   123\t\tcacheDir  string\r\n   124\t\tnoCache   bool\r\n   125\t}\r\n   126\t\r\n   127\tfunc main() {\r\n   128\t\tif len(os.Args) < 2 {\r\n   129\t\t\tfmt.Fprintln(os.Stderr, \"usage: buildctl <command> [flags]\")\r\n   130"]
[7609.274724, "o", "\t\t\tos.Exit(1)\r\n   131\t\t}\r\n   132\t\tswitch os.Args[1] {\r\n   133\t\tcase \"build\":\r\n   134\t\t\trunBuildCommand(os.Args[2:])\r\n   135\t\tcase \"graph\":\r\n   136\t\t\trunGraphCommand(os.Args[2:])\r\n"]
[7609.27478, "o", "   137\t\tcase \"clean\":\r\n   138\t\t\trunCleanCommand(os.Args[2:])\r\n   139\t\tcase \"status\":\r\n   140\t\t\trunStatusCommand(os.Args[2:])\r\n   141\t\tcase \"deps\":\r\n   142\t\t\trunDepsCommand(os.Args[2:])\r\n   143\t\tdefault:\r\n"]
[7609.274843, "o", "   144\t\t\tfmt.Fprintf(os.Stderr, \"unknown command %q\\n\", os.Args[1])\r\n   145\t\t\tos.Exit(1)\r\n   146\t\t}\r\n   147\t}\r\n   148\t\r\n   149\tfunc runBuildCommand(args []string) {\r\n   150\t\tfs := flag.NewFlagSet(\"build\", flag.ContinueOnError)\r\n   151\t\tfs.SetOutput(os.Stderr)\r\n   152\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   153\t\ttargetsFlag := fs.String(\"targets\", \"\", \"comma-separated target names\")\r\n   154\t\tparallel := fs.Int(\"parallel\", runtime.NumCPU(), \"max concurrent target executions\")\r\n"]
[7609.274909, "o", "   155\t\tnoCache := fs.Bool(\"no-cache\", false, \"skip all cache lookups\")\r\n   156\t\treportPath := fs.String(\"report\", \"\", \"also write JSON report to this file\")\r\n   157\t\tkeepGoing := fs.Bool(\"keep-going\", false, \"continue building independent targets after failures (default fail-fast)\")\r\n   158\t\tprofile := fs.Bool(\"profile\", false, \"include build profile with critical path in JSON report\")\r\n   159"]
[7609.274978, "o", "\t\tvar vars stringSliceFlag\r\n   160\t\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n   161\t\tif err := fs.Parse(args); err != nil {\r\n   162\t\t\tos.Exit(1)\r\n   163\t\t}\r\n   164\t\tif *configPath == \"\" {\r\n   165\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n   166\t\t\tos.Exit(1)\r\n   167\t\t}\r\n   168\t\tif *parallel < 1 {\r\n   169\t\t\tfmt.Fprintln(os.Stderr, \"error: --parallel must be at least 1\")\r\n   170\t\t\tos.Exit(1)\r\n   171\t\t}\r\n   172\t\tif err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath, []string(vars), *keepGoing, *profile); err != nil {\r\n   173\t\t\tfmt.Fprintln(os.Stderr, err)"]
[7609.275042, "o", "\r\n   174\t\t\tos.Exit(1)\r\n   175\t\t}\r\n   176\t}\r\n   177\t\r\n   178\tfunc runGraphCommand(args []string) {\r\n   179\t\tfs := flag.NewFlagSet(\"graph\", flag.ContinueOnError)\r\n   180\t\tfs.SetOutput(os.Stderr)\r\n   181\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   182\t\tvar vars stringSliceFlag\r\n"]
[7609.275131, "o", "   183\t\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n   184\t\tif err := fs.Parse(args); err != nil {\r\n   185\t\t\tos.Exit(1)\r\n   186\t\t}\r\n   187\t\tif *configPath == \"\" {\r\n   188\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n   189\t\t\tos.Exit(1)\r\n   190\t\t}\r\n   191\t\tif err := runGraph(*configPath, []string(vars)); err != nil {\r\n   192\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   193\t\t\tos.Exit(1)\r\n   194\t\t}\r\n   195\t}\r\n"]
[7609.275192, "o", "   196\t\r\n   197\tfunc runCleanCommand(args []string) {\r\n   198\t\tfs := flag.NewFlagSet(\"clean\", flag.ContinueOnError)\r\n   199\t\tfs.SetOutput(os.Stderr)\r\n   200\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   201\t\tvar vars stringSliceFlag\r\n   202\t\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n   203\t\tif err := fs.Parse(args); err != nil {\r\n"]
[7609.275273, "o", "   204\t\t\tos.Exit(1)\r\n   205\t\t}\r\n   206\t\tif *configPath == \"\" {\r\n   207\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n   208\t\t\tos.Exit(1)\r\n   209\t\t}\r\n   210\t\tif err := runClean(*configPath, []string(vars)); err != nil {\r\n   211\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   212\t\t\tos.Exit(1)\r\n   213\t\t}\r\n"]
[7609.275332, "o", "   214\t}\r\n   215\t\r\n   216\tfunc runStatusCommand(args []string) {\r\n   217\t\tfs := flag.NewFlagSet(\"status\", flag.ContinueOnError)\r\n   218\t\tfs.SetOutput(os.Stderr)\r\n   219\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   220\t\tvar vars stringSliceFlag\r\n"]
