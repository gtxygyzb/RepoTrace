[6571.359468, "o", "   192\t\t\t\t\tif dep == name {\r\n   193\t\t\t\t\t\taffectedSet[t.Name] = true\r\n   194\t\t\t\t\t\tqueue = append(queue, t.Name)\r\n   195\t\t\t\t\t\tbreak\r\n   196\t\t\t\t\t"]
