[5426.369362, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n"]
[5426.369452, "o", "\t\"fmt\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc runDepsCommand(args []string) {\r\n\tconfigPath := \"\"\r\n\twhy := false\r\n\taffected := false\r\n\tplan := false\r\n\tvar vars stringSliceFlag\r\n\tpositional := []string{}\r\n\r\n\ti := 0\r\n\tfor i < len(args) {\r\n\t"]
[5426.369522, "o", "\targ := args[i]\r\n\t\tswitch {\r\n\t\tcase arg == \"--config\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --config requires a value\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tconfigPath = args[i+1]\r\n\t\t\ti += 2\r\n\t\tcase strings.HasPrefix(arg, \"--config=\"):\r\n\t"]
[5426.369588, "o", "\t\tconfigPath = arg[len(\"--config=\"):]\r\n\t\t\ti++\r\n\t\tcase arg == \"--var\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --var requires a value\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tif err := vars.Set(args[i+1]); err != nil {\r\n"]
[5426.369644, "o", "\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ti += 2\r\n\t\tcase strings.HasPrefix(arg, \"--var=\"):\r\n\t\t\tif err := vars.Set(arg[len(\"--var=\"):]); err != nil {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ti++\r\n\t"]
[5426.369702, "o", "\tcase arg == \"--why\":\r\n\t\t\twhy = true\r\n\t\t\ti++\r\n\t\tcase arg == \"--affected\":\r\n\t\t\taffected = true\r\n\t\t\ti++\r\n\t\tcase arg == \"--plan\":\r\n\t\t\tplan = true\r\n\t"]
[5426.369759, "o", "\t\ti++\r\n\t\tdefault:\r\n\t\t\tpositional = append(positional, arg)\r\n\t\t\ti++\r\n\t\t}\r\n\t}\r\n\r\n\tif configPath == \"\" {\r\n"]
[5426.369827, "o", "\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif plan && !affected {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --plan requires --affected\")\r\n\t\tos.Exit(1)\r\n"]
