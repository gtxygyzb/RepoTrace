[6548.225135, "o", "epGoing bool) error {\r\n\tcfg, configDir, err := loadConfig(configPath, vars)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\ttargetMap, err := validateConfig(cfg)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\trequested, err := selectTargets(cfg, targetMap, targetsFlag)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\torder := topologicalOrder(cfg, requested)\r\n\treverseDeps := buildReverseDeps(cfg, requested)\r\n\r\n\tcacheKeys := make(map[string]string)\r\n\tfor i := range cfg.Targets {\r\n\t\tt := &cfg.Targets[i]\r\n\t\tif !requested[t.Name] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tkey, err := computeCacheKey(t, configDir)\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n"]
[6548.225211, "o", "\t\tcacheKeys[t.Name] = key\r\n\t}\r\n\r\n\texecutor := &buildExecutor{\r\n\t\tconfig:    cfg,\r\n\t\tconfigDir: configDir,\r\n\t\tcacheDir:  filepath.Join(configDir, \".buildctl-cache\"),\r\n\t\tnoCache:   noCache,\r\n\t}\r\n\r\n\tstatus := make(map[string]string)\r\n\tdurations := make(map[string]int64)\r\n\tcompleted := 0\r\n"]
[6548.22534, "o", "\ttotal := len(requested)\r\n\treadyCh := make(chan *TargetConfig, total+1)\r\n\tresultCh := make(chan execResult, total+1)\r\n\r\n\tvar mu sync.Mutex\r\n\tstarted := make(map[string]bool)\r\n\tcancelled := false\r\n\r\n\tvar wg sync.WaitGroup\r\n\tfor i := 0; i < parallel; i++ {\r\n\t\twg.Add(1)\r\n\t\tgo func() {\r\n\t\t\tdefer wg.Done()\r\n\t\t\tfor t := range readyCh {\r\n\t\t\t\tmu.Lock()\r\n\t\t\t\tif cancelled {\r\n\t\t\t\t\tmu.Unlock()\r\n"]
[6548.225405, "o", "\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tstarted[t.Name] = true\r\n\t\t\t\tmu.Unlock()\r\n\t\t\t\tres := executor.execute(t)\r\n\t\t\t\tif res.status == \"failed\" && !keepGoing {\r\n\t\t\t\t\tmu.Lock()\r\n\t\t\t\t\tcancelled = true\r\n\t\t\t\t\tmu.Unlock()\r\n"]
[6548.22547, "o", "\t\t\t\t}\r\n\t\t\t\tresultCh <- res\r\n\t\t\t}\r\n\t\t}()\r\n\t}\r\n\r\n\tbuildStart := time.Now()\r\n"]
[6548.225532, "o", "\tfor i := range cfg.Targets {\r\n\t\tt := &cfg.Targets[i]\r\n\t\tif requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {\r\n\t\t\treadyCh <- t\r\n\t\t}\r\n\t}\r\n\r\n"]
[6548.225587, "o", "\tfor completed < total {\r\n\t\tres := <-resultCh\r\n\t\tstatus[res.name] = res.status\r\n\t\tdurations[res.name] = res.durationMS\r\n\t\tif res.cacheKey != \"\" {\r\n\t\t\tcacheKeys[res.name] = res.cacheKey\r\n"]
[6548.225644, "o", "\t\t}\r\n\t\tcompleted++\r\n\r\n\t\tif res.status == \"built\" || res.status == \"cached\" {\r\n\t\t\tmu.Lock()\r\n\t\t\tcanSchedule := !cancelled\r\n\t\t\tmu.Unlock()\r\n\t\t\tif canSchedule {\r\n"]
[6548.2257, "o", "\t\t\t\tfor _, dependent := range reverseDeps[res.name] {\r\n\t\t\t\t\tif allDependenciesComplete(dependent, targetMap, requested, status) {\r\n\t\t\t\t\t\treadyCh <- targetMap[dependent]\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[6548.225755, "o", "\r\n\t\tif res.status == \"failed\" {\r\n\t\t\tmarkSkipped(reverseDeps, status, durations, &completed, res.name)\r\n\t\t\tif !keepGoing {\r\n\t\t\t\tmu.Lock()\r\n\t\t\t\tcancelled = true\r\n"]
[6548.225836, "o", "\t\t\t\tfor i := range cfg.Targets {\r\n\t\t\t\t\tt := &cfg.Targets[i]\r\n\t\t\t\t\tif !requested[t.Name] {\r\n\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif status[t.Name] == \"\" && !started[t.Name] {\r\n\t\t\t\t\t\tstatus[t.Name] = \"cancelled\"\r\n\t\t\t\t\t\tdurations[t.Name] = 0\r\n\t\t\t\t\t\tcompleted++\r\n\t\t\t\t\t}\r\n"]
[6548.225894, "o", "\t\t\t\t}\r\n\t\t\t\tmu.Unlock()\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t}\r\n\r\n\tclose(readyCh)\r\n\twg.Wait()\r\n"]
[6548.225951, "o", "\r\n\treport := BuildReport{Pipeline: cfg.Pipeline.Name, Targets: []BuildTargetReport{}}\r\n\tfor _, name := range order {\r\n\t\tst := status[name]\r\n\t\tif st == \"\" {\r\n\t\t\tif keepGoing {\r\n\t\t\t\tst = \"skipped\"\r\n\t\t\t} else {\r\n\t"]
[6548.226006, "o", "\t\t\tst = \"cancelled\"\r\n\t\t\t}\r\n\t\t}\r\n\t\treport.Targets = append(report.Targets, BuildTargetReport{\r\n\t\t\tName:       name,\r\n\t\t\tStatus:     st,\r\n\t\t\tCached:     st == \"cached\",\r\n\t\t\tDurationMS: durations[name],\r\n\t\t\tCacheKey:   cacheKeys[name],\r\n"]
[6548.226062, "o", "\t\t})\r\n\t}\r\n\r\n\tsummary := BuildSummary{Total: len(report.Targets)}\r\n\tfor _, t := range report.Targets {\r\n\t\tswitch t.Status {\r\n\t\tcase \"built\":\r\n\t\t\tsummary.Built++\r\n\t\tcase \"cached\":\r\n"]
[6548.226116, "o", "\t\t\tsummary.Cached++\r\n\t\tcase \"failed\":\r\n\t\t\tsummary.Failed++\r\n\t\tcase \"skipped\":\r\n\t\t\tsummary.Skipped++\r\n\t\tcase \"cancelled\":\r\n\t\t\tsummary.Cancelled++\r\n\t\t}\r\n\t}\r\n"]
