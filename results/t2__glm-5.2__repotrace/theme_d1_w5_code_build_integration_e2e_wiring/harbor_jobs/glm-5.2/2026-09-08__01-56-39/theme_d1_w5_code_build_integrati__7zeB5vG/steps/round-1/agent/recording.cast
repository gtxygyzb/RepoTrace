[7633.34949, "o", "  1215\t\t}\r\n  1216\t\r\n  1217\t\tfor _, hook := range t.PreBuild {\r\n  1218\t\t\tif _, err := io.WriteString(h, hook); err != nil {\r\n  1219\t\t\t\treturn \"\", err\r\n  1220\t\t\t}\r\n  1221\t\t}\r\n  1222\t\tfor _, hook := range t.PostBuild {\r\n  1223\t\t\tif _, err := io.WriteString(h, hook); err != nil {\r\n  1224\t\t\t\treturn \"\", err\r\n  1225\t\t\t}\r\n  1226\t\t}\r\n  1227\t\r\n  1228\t\tdeps := make([]string, len(t.Dependencies))\r\n  1229\t\tcopy(deps, t.Dependencies)\r\n  1230\t\tsort.Strings(deps)\r\n"]
