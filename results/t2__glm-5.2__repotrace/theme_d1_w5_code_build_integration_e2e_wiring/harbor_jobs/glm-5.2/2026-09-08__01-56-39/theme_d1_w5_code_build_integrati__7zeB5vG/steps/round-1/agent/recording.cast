[3729.508481, "o", "   469\ttype configLoader struct {\r\n   470\t\tpipelineName string\r\n   471\t\trootImports  []string\r\n   472\t\tvariables    map[string]string\r\n   473\t\ttargets      []TargetConfig\r\n   474\t\ttargetNames  map[string]bool\r\n   475\t\timportStack  []string\r\n   476\t}\r\n"]
[3729.508584, "o", "   477\t\r\n   478\tfunc (l *configLoader) loadFile(absPath string, isRoot bool) error {\r\n   479\t\tfor _, p := range l.importStack {\r\n   480\t\t\tif p == absPath {\r\n   481\t\t\t\tchain := append([]string{}, l.importStack...)\r\n   482\t\t\t\tchain = append(chain, absPath)\r\n   483\t\t\t\treturn fmt.Errorf(\"circular import detected: %s\", strings.Join(chain, \" -> \"))\r\n   484\t\t\t}\r\n   485\t\t}\r\n   486\t\tl.importStack = append(l.importStack, absPath)\r\n   487\t\tdefer func() { l.importStack = l.importStack[:len(l.importStack)-1] }()\r\n   488\t\r\n   489\t\tvar fileCfg Config\r\n   490\t\tif _, err := toml.DecodeFile(absPath, &fileCfg); err != nil {\r\n"]
[3729.508656, "o", "   491\t\t\treturn err\r\n   492\t\t}\r\n   493\t\r\n   494\t\tif isRoot {\r\n   495\t\t\tl.pipelineName = fileCfg.Pipeline.Name\r\n   496\t\t\tl.rootImports = fileCfg.Pipeline.Imports\r\n   497\t\t}\r\n   498\t\r\n   499\t\tfor k, v := range fileCfg.Variables {\r\n   500\t\t\tif _, exists := l.variables[k]; !exists {\r\n"]
[3729.508718, "o", "   501\t\t\t\tl.variables[k] = v\r\n   502\t\t\t}\r\n   503\t\t}\r\n   504\t\r\n   505\t\tfor _, imp := range fileCfg.Pipeline.Imports {\r\n   506\t\t\texpanded, err := expandString(imp, l.variables, make(map[string]bool))\r\n   507\t\t\tif err != nil {\r\n   508\t\t\t\treturn err\r\n"]
[3729.508778, "o", "   509\t\t\t}\r\n   510\t\t\timportPath := expanded\r\n   511\t\t\tif !filepath.IsAbs(importPath) {\r\n   512\t\t\t\timportPath = filepath.Join(filepath.Dir(absPath), importPath)\r\n   513\t\t\t}\r\n   514\t\t\timportAbs, err := filepath.Abs(importPath)\r\n   515\t\t\tif err != nil {\r\n   516\t\t\t\treturn err\r\n   517\t\t\t}\r\n"]
[3729.508856, "o", "   518\t\t\tif err := l.loadFile(importAbs, false); err != nil {\r\n   519\t\t\t\treturn err\r\n   520\t\t\t}\r\n   521\t\t}\r\n   522\t\r\n   523\t\tfor _, t := range fileCfg.Targets {\r\n   524\t\t\tif l.targetNames[t.Name] {\r\n   525\t\t\t\treturn fmt.Errorf(\"duplicate target name %q\", t.Name)\r\n   526\t\t\t}\r\n   527"]
[3729.508921, "o", "\t\t\tl.targetNames[t.Name] = true\r\n   528\t\t\tl.targets = append(l.targets, t)\r\n   529\t\t}\r\n   530\t\r\n   531\t\treturn nil\r\n   532\t}\r\n   533\t\r\n   534\tfunc parseVarOverrides(vars []string) (map[string]string, error) {\r\n   535\t\tm := make(map[string]string)\r\n"]
[3729.508983, "o", "   536\t\tfor _, v := range vars {\r\n   537\t\t\tidx := strings.Index(v, \"=\")\r\n   538\t\t\tif idx == -1 {\r\n   539\t\t\t\treturn nil, fmt.Errorf(\"invalid --var %q, expected key=value\", v)\r\n   540\t\t\t}\r\n   541\t\t\tkey := v[:idx]\r\n   542\t\t\tif key == \"\" {\r\n   543\t\t\t\treturn nil, fmt.Errorf(\"invalid --var %q, empty key\", v)\r\n"]
[3729.50904, "o", "   544\t\t\t}\r\n   545\t\t\tm[key] = v[idx+1:]\r\n   546\t\t}\r\n   547\t\treturn m, nil\r\n   548\t}\r\n   549\t\r\n   550\tfunc expandString(s string, vars map[string]string, visiting map[string]bool) (string, error) {\r\n   551\t\tvar b strings.Builder\r\n"]
[3729.509101, "o", "   552\t\ti := 0\r\n   553\t\tfor i < len(s) {\r\n   554\t\t\tif i+1 < len(s) && s[i] == '$' && s[i+1] == '{' {\r\n   555\t\t\t\tend := strings.Index(s[i:], \"}\")\r\n   556\t\t\t\tif end == -1 {\r\n   557\t\t\t\t\treturn \"\", fmt.Errorf(\"unterminated variable reference in %q\", s)\r\n   558\t\t\t\t}\r\n   559\t\t\t\tname := s[i+2 : i+end]\r\n   560\t\t"]
[3729.509163, "o", "\t\tif name == \"\" {\r\n   561\t\t\t\t\treturn \"\", fmt.Errorf(\"empty variable reference in %q\", s)\r\n   562\t\t\t\t}\r\n   563\t\t\t\tif visiting[name] {\r\n   564\t\t\t\t\treturn \"\", fmt.Errorf(\"variable cycle detected: %q\", name)\r\n   565\t\t\t\t}\r\n   566\t\t\t\tval, ok := vars[name]\r\n"]
[3729.509221, "o", "   567\t\t\t\tif !ok {\r\n   568\t\t\t\t\treturn \"\", fmt.Errorf(\"unresolved variable %q\", name)\r\n   569\t\t\t\t}\r\n   570\t\t\t\tvisiting[name] = true\r\n   571\t\t\t\texpanded, err := expandString(val, vars, visiting)\r\n   572\t\t\t\tif err != nil {\r\n   573\t\t\t\t\treturn \"\", err\r\n"]
[3729.509321, "o", "   574\t\t\t\t}\r\n   575\t\t\t\tdelete(visiting, name)\r\n   576\t\t\t\tb.WriteString(expanded)\r\n   577\t\t\t\ti += end + 1\r\n   578\t\t\t} else {\r\n   579\t\t\t\tb.WriteByte(s[i])\r\n   580\t\t\t\ti++\r\n   581\t\t\t}\r\n   582\t\t}\r\n   583\t\treturn b.String(), nil\r\n"]
[3729.509376, "o", "   584\t}\r\n   585\t\r\n   586\tfunc validateConfig(cfg *Config) (map[string]*TargetConfig, error) {\r\n"]
