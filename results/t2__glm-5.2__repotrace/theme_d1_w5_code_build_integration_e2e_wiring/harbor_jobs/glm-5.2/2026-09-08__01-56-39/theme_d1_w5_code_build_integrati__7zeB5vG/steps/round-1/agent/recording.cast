[7070.125259, "o", "   125\t\tif len(os.Args) < 2 {\r\n   126\t\t\tfmt.Fprintln(os.Stderr, \"usage: buildctl <command> [flags]\")\r\n   127\t\t\tos.Exit(1)\r\n   128\t\t}\r\n   129\t\tswitch os.Args[1] {\r\n   130\t\tcase \"build\":\r\n   131\t\t\trunBuildCommand(os.Args[2:])\r\n   132\t\tcase \"graph\":\r\n   133\t\t\trunGraphCommand(os.Args[2:])\r\n   134\t\tcase \"clean\":\r\n   135\t\t\trunCleanCommand(os.Args[2:])\r\n   136\t\tcase \"status\":\r\n"]
[7070.125335, "o", "   137\t\t\trunStatusCommand(os.Args[2:])\r\n   138\t\tcase \"deps\":\r\n   139\t\t\trunDepsCommand(os.Args[2:])\r\n   140\t\tdefault:\r\n   141\t\t\tfmt.Fprintf(os.Stderr, \"unknown command %q\\n\", os.Args[1])\r\n   142\t\t\tos.Exit(1)\r\n   143\t\t}\r\n   144\t}\r\n   145\t\r\n   146\tfunc runBuildCommand(args []string) {\r\n   147\t\tfs := flag.NewFlagSet(\"build\", flag.ContinueOnError)\r\n   148\t\tfs.SetOutput(os.Stderr)\r\n   149"]
[7070.125414, "o", "\t\tconfigPath := fs.String(\"config\", \"\", \"path to TOML pipeline file\")\r\n   150\t\ttargetsFlag := fs.String(\"targets\", \"\", \"comma-separated target names\")\r\n   151\t\tparallel := fs.Int(\"parallel\", runtime.NumCPU(), \"max concurrent target executions\")\r\n   152\t\tnoCache := fs.Bool(\"no-cache\", false, \"skip all cache lookups\")\r\n   153\t\treportPath := fs.String(\"report\", \"\", \"also write JSON report to this file\")\r\n   154\t\tkeepGoing := fs.Bool(\"keep-going\", false, \"continue building independent targets after failures (default fail-fast)\")\r\n   155\t\tprofile := fs.Bool(\"profile\", false, \"include build profile with critical path in JSON report\")\r\n   156\t\tvar vars stringSliceFlag\r\n   157\t\tfs.Var(&vars, \"var\", \"variable override key=value (repeatable)\")\r\n   158\t\tif err := fs.Parse(args); err != nil {\r\n   159\t\t\tos.Exit(1)\r\n   160"]
[7070.125483, "o", "\t\t}\r\n   161\t\tif *configPath == \"\" {\r\n   162\t\t\tfmt.Fprintln(os.Stderr, \"error: --config is required\")\r\n   163\t\t\tos.Exit(1)\r\n   164\t\t}\r\n   165\t\tif *parallel < 1 {\r\n   166\t\t\tfmt.Fprintln(os.Stderr, \"error: --parallel must be at least 1\")\r\n   167\t\t\tos.Exit(1)\r\n   168\t\t}\r\n   169\t\tif err := runBuild(*configPath, *targetsFlag, *parallel, *noCache, *reportPath, []string(vars), *keepGoing, *profile); err != nil {\r\n   170"]
