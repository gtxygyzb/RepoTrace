[3667.760365, "o", "\treturn filepath.Join(base, p)\r\n   965\t}\r\n   966\t\r\n   967\tfunc fileExists(path string) bool {\r\n   968\t\t_, err := os.Stat(path)\r\n   969\t\treturn err == nil\r\n   970\t}\r\n   971\t\r\n   972\tfunc uniqueStrings(in []string) []string {\r\n   973\t\tseen := map[string]bool{}\r\n   974\t\tout := []string{}\r\n   975\t\tfor _, s := range in {\r\n"]
