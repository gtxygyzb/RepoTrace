[7157.576142, "o", "   232\tfunc runBuild(configPath, targetsFlag string, parallel int, noCache bool, reportPath string, vars []string, keepGoing bool, profile bool) error {\r\n   233\t\tcfg, configDir, err := loadConfig(configPath, vars)\r\n   234\t\tif err != nil {\r\n   235\t\t\treturn err\r\n   236\t\t}\r\n   237\t\ttargetMap, err := validateConfig(cfg)\r\n   238\t\tif err != nil {\r\n"]
[7157.57628, "o", "   239\t\t\treturn err\r\n   240\t\t}\r\n   241\t\trequested, err := selectTargets(cfg, targetMap, targetsFlag)\r\n   242\t\tif err != nil {\r\n   243\t\t\treturn err\r\n   244\t\t}\r\n   245\t\torder := topologicalOrder(cfg, requested)\r\n   246\t\treverseDeps := buildReverseDeps(cfg, requested)\r\n   247\t\r\n   248\t\tcacheKeys := make(map[string]string)\r\n   249\t\tfor i := range cfg.Targets {\r\n   250\t\t\tt := &cfg.Targets[i]\r\n   251\t\t\tif !requested[t.Name] {\r\n   252\t\t\t\tcontinue\r\n   253\t\t\t}\r\n   254\t\t\tkey, err := computeCacheKey(t, configDir)\r\n   255"]
[7157.576357, "o", "\t\t\tif err != nil {\r\n   256\t\t\t\treturn err\r\n   257\t\t\t}\r\n   258\t\t\tcacheKeys[t.Name] = key\r\n   259\t\t}\r\n   260\t\r\n   261\t\texecutor := &buildExecutor{\r\n   262\t\t\tconfig:    cfg,\r\n   263\t\t\tconfigDir: configDir,\r\n   264\t\t\tcacheDir:  filepath.Join(configDir, \".buildctl-cache\"),\r\n   265\t"]
[7157.576421, "o", "\t\tnoCache:   noCache,\r\n   266\t\t}\r\n   267\t\r\n   268\t\tstatus := make(map[string]string)\r\n   269\t\tdurations := make(map[string]int64)\r\n   270\t\tcompleted := 0\r\n   271\t\ttotal := len(requested)\r\n   272\t\treadyCh := make(chan *TargetConfig, total+1)\r\n   273\t\t"]
[7157.57648, "o", "resultCh := make(chan execResult, total+1)\r\n   274\t\r\n   275\t\tvar mu sync.Mutex\r\n   276\t\tstarted := make(map[string]bool)\r\n   277\t\tcancelled := false\r\n   278\t\r\n   279\t\tvar wg sync.WaitGroup\r\n   280\t\tfor i := 0; i < parallel; i++ {\r\n"]
[7157.576537, "o", "   281\t\t\twg.Add(1)\r\n   282\t\t\tgo func() {\r\n   283\t\t\t\tdefer wg.Done()\r\n   284\t\t\t\tfor t := range readyCh {\r\n   285\t\t\t\t\tmu.Lock()\r\n   286\t\t\t\t\tif cancelled {\r\n   287\t\t\t\t\t\tmu.Unlock()\r\n   288\t\t\t"]
[7157.576597, "o", "\t\t\tcontinue\r\n   289\t\t\t\t\t}\r\n   290\t\t\t\t\tstarted[t.Name] = true\r\n   291\t\t\t\t\tmu.Unlock()\r\n   292\t\t\t\t\tres := executor.execute(t)\r\n   293\t\t\t\t\tif res.status == \"failed\" && !keepGoing {\r\n   294\t\t\t\t\t\t"]
[7157.57666, "o", "mu.Lock()\r\n   295\t\t\t\t\t\tcancelled = true\r\n   296\t\t\t\t\t\tmu.Unlock()\r\n   297\t\t\t\t\t}\r\n   298\t\t\t\t\tresultCh <- res\r\n   299\t\t\t\t}\r\n   300\t\t\t}()\r\n   301\t\t}\r\n"]
[7157.576717, "o", "   302\t\r\n   303\t\tbuildStart := time.Now()\r\n   304\t\tfor i := range cfg.Targets {\r\n   305\t\t\tt := &cfg.Targets[i]\r\n   306\t\t\tif requested[t.Name] && len(uniqueStrings(t.Dependencies)) == 0 {\r\n   307\t\t\t\treadyCh <- t\r\n"]
[7157.576777, "o", "   308\t\t\t}\r\n   309\t\t}\r\n   310\t\r\n   311\t\tfor completed < total {\r\n   312\t\t\tres := <-resultCh\r\n   313\t\t\tstatus[res.name] = res.status\r\n   314\t\t\tdurations[res.name] = res.durationMS\r\n   315\t\t\tif res.cacheKey != \"\" {\r\n"]
[7157.576835, "o", "   316\t\t\t\tcacheKeys[res.name] = res.cacheKey\r\n   317\t\t\t}\r\n   318\t\t\tcompleted++\r\n   319\t\r\n   320\t\t\tif res.status == \"built\" || res.status == \"cached\" {\r\n   321\t\t\t\tmu.Lock()\r\n   322\t\t\t\tcanSchedule := !cancelled\r\n   323"]
[7157.5769, "o", "\t\t\t\tmu.Unlock()\r\n   324\t\t\t\tif canSchedule {\r\n   325\t\t\t\t\tfor _, dependent := range reverseDeps[res.name] {\r\n   326\t\t\t\t\t\tif allDependenciesComplete(dependent, targetMap, requested, status) {\r\n   327\t\t\t\t\t\t\treadyCh <- targetMap[dependent]\r\n   328\t\t\t\t\t\t}\r\n   329\t\t\t\t\t"]
[7157.576958, "o", "}\r\n   330\t\t\t\t}\r\n   331\t\t\t\tcontinue\r\n   332\t\t\t}\r\n   333\t\r\n   334\t\t\tif res.status == \"failed\" {\r\n   335\t\t\t\tmarkSkipped(reverseDeps, status, durations, &completed, res.name)\r\n   336\t\t\t\tif !keepGoing {\r\n"]
