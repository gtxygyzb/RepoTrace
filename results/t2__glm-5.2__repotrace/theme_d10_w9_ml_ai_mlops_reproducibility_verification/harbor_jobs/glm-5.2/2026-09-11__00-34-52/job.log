        }\n        if e.CheckpointHash == "" {\n            result.Errors = append(result.Errors, fmt.Sprintf("empty checkpoint_hash for experiment: %s", e.ID))\n        }\n    }\n\n    for _, e := range exps {\n        if e.ID == "" {\n            continue\n        }\n        for _, p := range e.Parents {\n            if _, ok := idSet[p]; !ok {\n                result.Errors = append(result.Errors, fmt.Sprintf("parent reference unresolved: %s -> %s", e.ID, p))\n            }\n        }\n    }\n\n    times := make(map[string]time.Time)\n    for _, e := range exps {\n        if e.ID == "" {\n            continue\n        }\n        if e.Timestamp == "" {\n            result.Errors = append(result.Errors, fmt.Sprintf("missing timestamp for experiment: %s", e.ID))\n            continue\n        }\n        t, err := time.Parse(time.RFC3339, e.Timestamp)\n        if err != nil {\n            result.Errors = append(result.Errors, fmt.Sprintf("invalid timestamp for experiment: %s", e.ID))\n        } else {\n            times[e.ID] = t\n        }\n    }\n\n    if len(result.Errors) == 0 {\n        if cycle := detectCycle(exps); cycle != nil {\n            result.Errors = append(result.Errors, fmt.Sprintf("cycle detected involving: %s", strings.Join(cycle, ", ")))\n        }\n    }\n\n    if len(result.Errors) == 0 {\n        for _, e := range exps {\n            childTime, ok := times[e.ID]\n            if !ok {\n                continue\n            }\n            for _, p := range e.Parents {\n                parentTime, ok := times[p]\n                if !ok {\n                    continue\n                }\n                if !childTime.After(parentTime) {\n                    result.Errors = append(result.Errors, fmt.Sprintf("timestamp violation: %s (%s) has parent %s (%s)", e.ID, childTime.Format("2006-01-02"), p, parentTime.Format("2006-01-02")))\n                }\n            }\n        }\n    }\n\n    if len(result.Errors) > 0 {\n        result.Valid = false\n        result.TopologicalOrder = nil\n        return result\n    }\n\n    children := make(map[string][]string)\n    for _, e := range exps {\n        for _, p := range e.Parents {\n            children[p] = append(children[p], e.ID)\n        }\n    }\n\n    roots := make([]string, 0)\n    leaves := make([]string, 0)\n    for _, e := range exps {\n        if len(e.Parents) == 0 {\n            roots = append(roots, e.ID)\n        }\n        if len(children[e.ID]) == 0 {\n            leaves = append(leaves, e.ID)\n        }\n    }\n\n    visited := make(map[string]bool)\n    var post []string\n    var dfs func(id string)\n    dfs = func(id string) {\n        visited[id] = true\n        for _, child := range children[id] {\n            if !visited[child] {\n                dfs(child)\n            }\n        }\n        post = append(post, id)\n    }\n    for _, e := range exps {\n        if !visited[e.ID] {\n            dfs(e.ID)\n        }\n    }\n    topo := make([]string, len(post))\n    for i := range post {\n        topo[i] = post[len(post)-1-i]\n    }\n\n    maxDepth := 0\n    var depthDFS func(id string, depth int)\n    depthDFS = func(id string, depth int) {\n        if depth > maxDepth {\n            maxDepth = depth\n        }\n        for _, child := range children[id] {\n            depthDFS(child, depth+1)\n        }\n    }\n    for _, r := range roots {\n        depthDFS(r, 1)\n    }\n\n    result.NumExperiments = len(exps)\n    result.NumRoots = len(roots)\n    result.NumLeaves = len(leaves)\n    result.MaxDepth = maxDepth\n    result.TopologicalOrder = topo\n    return result\n}\n\nfunc detectCycle(exps []Experiment) []string {\n    adj := make(map[string][]string)\n    for _, e := range exps {\n        for _, p := range e.Parents {\n            adj[p] = append(adj[p], e.ID)\n        }\n    }\n\n    state := make(map[string]int)\n    var stack []string\n    var cycle []string\n\n    var dfs func(id string) bool\n    dfs = func(id string) bool {\n        state[id] = 1\n        stack = append(stack, id)\n        for _, child := range adj[id] {\n            if state[child] == 1 {\n                idx := -1\n                for i := len(stack) - 1; i >= 0; i-- {\n                    if stack[i] == child {\n                        idx = i\n                        break\n                    }\n                }\n                if idx >= 0 {\n                    cycle = append([]string{}, stack[idx:]...)\n                    return true\n                }\n            }\n            if state[child] == 0 {\n                if dfs(child) {\n                    return true\n                }\n            }\n        }\n        stack = stack[:len(stack)-1]\n        state[id] = 2\n        return false\n    }\n\n    for _, e := range exps {\n        if state[e.ID] == 0 {\n            if dfs(e.ID) {\n                return cycle\n            }\n        }\n    }\n    return nil\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
