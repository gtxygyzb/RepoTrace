Sending keys: ["python3 - <<'PY'\nimport struct, hashlib, json, os\n\ndef tensor_bytes(name, dtype, shape, values):\n    name_b = name.encode()\n    b = struct.pack('<I', len(name_b)) + name_b + bytes([dtype]) + struct.pack('<I', len(shape))\n    for s in shape:\n        b += struct.pack('<I', s)\n    if dtype == 0:  # float32\n        b += b''.join(struct.pack('<f', float(v)) for v in values)\n    elif dtype == 1:  # float64\n        b += b''.join(struct.pack('<d', float(v)) for v in values)\n    elif dtype == 2:  # int32\n        b += b''.join(struct.pack('<i', int(round(v))) for v in values)\n    elif dtype == 3:  # int64\n        b += b''.join(struct.pack('<q', int(round(v))) for v in values)\n    else:\n        raise ValueError(dtype)\n    return b\n\ndef write_checkpoint(path, tensors, meta=None):\n    if meta is None:\n        meta = {}\n    meta_b = json.dumps(meta).encode()\n    body = b'MLCK' + struct.pack('<I', 1) + struct.pack('<I', len(tensors)) + struct.pack('<I', len(meta_b)) + meta_b\n    for t in tensors:\n        body += tensor_bytes(t['name'], t['dtype'], t['shape'], t['values'])\n    footer = hashlib.sha256(body).digest()\n    with open(path, 'wb') as f:\n        f.write(body + footer)\n\nwrite_checkpoint('/tmp/cp1.mlck', [{'name':'w','dtype':0,'shape':[2,2],'values':[1.0,2.0,3.0,4.0]}])\nwrite_checkpoint('/tmp/cp2.mlck', [{'name':'w','dtype':0,'shape':[2,2],'values':[1.0,2.0000001,3.0,5.0]}])\nwrite_checkpoint('/tmp/cp3.mlck', [{'name':'w','dtype':0,'shape':[4],'values':[1.0,2.0,3.0,4.0]}])\nprint('created checkpoints')\nPY\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
