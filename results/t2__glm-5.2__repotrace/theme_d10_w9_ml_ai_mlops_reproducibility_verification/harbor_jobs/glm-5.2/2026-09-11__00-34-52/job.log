result.Errors, "missing required field: environment.seed")\n        result.Errors = append(result.Errors, "missing required field: environment.deterministic")\n        result.Warnings = append(result.Warnings, "optional field \'environment.gpu_id\' missing")\n        result.Warnings = append(result.Warnings, "optional field \'environment.cuda_version\' missing")\n    } else {\n        pythonVersion, ok := environment["python_version"].(string)\n        if !ok || pythonVersion == "" {\n            result.Errors = append(result.Errors, "missing required field: environment.python_version")\n        } else if !pythonVersionRegex.MatchString(pythonVersion) {\n            result.Errors = append(result.Errors, "invalid python_version format")\n        }\n\n        seed, ok := environment["seed"]\n        if !ok {\n            result.Errors = append(result.Errors, "missing required field: environment.seed")\n        } else if !isNonNegativeInt(seed) {\n            result.Errors = append(result.Errors, "invalid environment.seed")\n        }\n\n        if _, ok := environment["deterministic"].(bool); !ok {\n            result.Errors = append(result.Errors, "missing required field: environment.deterministic")\n        }\n\n        if _, ok := environment["gpu_id"].(string); !ok {\n            result.Warnings = append(result.Warnings, "optional field \'environment.gpu_id\' missing")\n        }\n        if _, ok := environment["cuda_version"].(string); !ok {\n            result.Warnings = append(result.Warnings, "optional field \'environment.cuda_version\' missing")\n        }\n    }\n\n    deps, ok := root["dependencies"].([]map[string]interface{})\n    if !ok {\n        result.Errors = append(result.Errors, "missing required field: dependencies")\n    } else {\n        for i, dep := range deps {\n            name, nameOk := dep["name"].(string)\n            version, versionOk := dep["version"].(string)\n            if !nameOk || name == "" {\n                result.Errors = append(result.Errors, fmt.Sprintf("invalid dependency at index %d: missing name", i))\n            }\n            if !versionOk || version == "" {\n                result.Errors = append(result.Errors, fmt.Sprintf("invalid dependency at index %d: missing version", i))\n            }\n        }\n    }\n\n    if outputs == nil {\n        result.Errors = append(result.Errors, "missing required field: outputs.checkpoint_path")\n        result.Errors = append(result.Errors, "missing required field: outputs.metrics")\n    } else {\n        checkpointPath, ok := outputs["checkpoint_path"].(string)\n        if !ok || checkpointPath == "" {\n            result.Errors = append(result.Errors, "missing required field: outputs.checkpoint_path")\n        }\n\n        metrics := getTable(outputs, "metrics")\n        if metrics == nil {\n            result.Errors = append(result.Errors, "missing required field: outputs.metrics")\n        } else if !hasNumericField(metrics) {\n            result.Errors = append(result.Errors, "outputs.metrics must contain at least one numeric field")\n        }\n    }\n\n    git := getTable(root, "git")\n    if git == nil {\n        result.Warnings = append(result.Warnings, "optional field \'git.commit\' missing")\n        result.Warnings = append(result.Warnings, "optional field \'git.branch\' missing")\n    } else {\n        if _, ok := git["commit"].(string); !ok {\n            result.Warnings = append(result.Warnings, "optional field \'git.commit\' missing")\n        }\n        if _, ok := git["branch"].(string); !ok {\n            result.Warnings = append(result.Warnings, "optional field \'git.branch\' missing")\n        }\n    }\n\n    if len(result.Errors) > 0 {\n        result.Valid = false\n        result.Warnings = nil\n    }\n    if result.Valid && len(result.Warnings) == 0 {\n        result.Warnings = []string{}\n    }\n\n    return result\n}\n\nvar pythonVersionRegex = regexp.MustCompile(`^\\d+\\.\\d+\\.\\d+$`)\n\nfunc getTable(root map[string]interface{}, key string) map[string]interface{} {\n    v, ok := root[key]\n    if !ok {\n        return nil\n    }\n    m, ok := v.(map[string]interface{})\n    if !ok {\n        return nil\n    }\n    return m\n}\n\nfunc isNonNegativeInt(v interface{}) bool {\n    switch x := v.(type) {\n    case int:\n        return x >= 0\n    case int64:\n        return x >= 0\n    case float64:\n        return x == float64(int64(x)) && x >= 0\n    default:\n        return false\n    }\n}\n\nfunc hasNumericField(m map[string]interface{}) bool {\n    for _, v := range m {\n        switch v.(type) {\n        case int, int64, float64:\n            return true\n        }\n    }\n    return false\n}\n\nfunc parseTOML(data string) (map[string]interface{}, error) {\n    root := map[string]interface{}{}\n    var current map[string]interface{} = root\n    var currentArray []map[string]interface{}\n\n    lines := strings.Split(data, "\\n")\n    for lineNum, raw := range lines {\n        line := strings.TrimSpace(raw)\n        if line == "" || strings.HasPrefix(line, "#") {\n            continue\n        }\n\n        if strings.HasPrefix(line, "[[") && strings.HasSuffix(line, "]]")) {\n            key := strings.TrimSpace(line[2 : len(line)-2])\n            parts := strings.Split(key, ".")\n            parent := root\n            for i := 0; i < len(parts)-1; i++ {\n                p := strings.TrimSpace(parts[i])\n                next, ok := parent[p]\n                if !ok {\n                    next = map[string]interface{}{}\n                    parent[p] = next\n                }\n                parent, ok = next.(map[string]interface{})\n                if !ok {\n                    return nil, fmt.Errorf("line %d: invalid array table path", lineNum+1)\n                }\n            }\n            last := strings.TrimSpace(parts[len(parts)-1])\n            arr, ok := parent[last].([]map[string]interface{})\n            if !ok {\n                arr = []map[string]interface{}