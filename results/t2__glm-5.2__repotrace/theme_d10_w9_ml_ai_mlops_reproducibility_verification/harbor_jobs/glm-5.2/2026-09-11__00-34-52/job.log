Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\n\npath = Path(\'internal/drift/drift.go\')\ns = path.read_text()\n\n# Add TopK field to Result.\ns = s.replace(\n\'\'\'type Result struct {\n        NumSnapshots       int            `json:"num_snapshots"`\n        NumAnalyzedTensors int            `json:"num_analyzed_tensors"`\n        SkippedTensors     []string       `json:"skipped_tensors"`\n        Tensors            []TensorResult `json:"tensors"`\n        OverallConvergence string         `json:"overall_convergence"`\n}\'\'\',\n\'\'\'type Result struct {\n        NumSnapshots       int            `json:"num_snapshots"`\n        NumAnalyzedTensors int            `json:"num_analyzed_tensors"`\n        SkippedTensors     []string       `json:"skipped_tensors"`\n        Tensors            []TensorResult `json:"tensors"`\n        OverallConvergence string         `json:"overall_convergence"`\n        TopK               *int           `json:"top_k,omitempty"`\n}\'\'\'\n)\n\n# Replace stability score formula.\ns = s.replace(\n\'\'\'                  mean := meanFloat64(steps)\n                  max := maxFloat64(steps)\n                  convergence := classifyConvergence(steps)\n                  stability := 1.0\n                  if steps[0] != 0 {\n                          stability = 1.0 - steps[len(steps)-1]/steps[0]\n                          if stability < 0 {\n                                  stability = 0\n                          } else if stability > 1 {\n                                  stability = 1\n                          }\n                  }\'\'\',\n\'\'\'                  mean := meanFloat64(steps)\n                  max := maxFloat64(steps)\n                  convergence := classifyConvergence(steps)\n                  stability := 1.0\n                  if max != 0 {\n                          stability = 1.0 - steps[len(steps)-1]/max\n                          if stability < 0 {\n                                  stability = 0\n                          } else if stability > 1 {\n                                  stability = 1\n                          }\n                  }\'\'\'\n)\n\n# Replace final sorting/return block to support top-k.\ns = s.replace(\n\'\'\'        sort.Strings(skipped)\n        sort.Slice(tensors, func(i, j int) bool {\n                return tensors[i].Name < tensors[j].Name\n        })\n\n        return &Result{\n                NumSnapshots:       len(files),\n                NumAnalyzedTensors: len(tensors),\n                SkippedTensors:     skipped,\n                Tensors:            tensors,\n                OverallConvergence: overall,\n        }, nil\n}\'\'\',\n\'\'\'        sort.Strings(skipped)\n        sort.Slice(tensors, func(i, j int) bool {\n                return tensors[i].Name < tensors[j].Name\n        })\n\n        result := &Result{\n                NumSnapshots:       len(files),\n                NumAnalyzedTensors: len(tensors),\n                SkippedTensors:     skipped,\n                Tensors:            tensors,\n                OverallConvergence: overall,\n        }\n        applyTopK(result, topK)\n        return result, nil\n}\n\n// Analyze remains available for callers that do not need a top-k restriction.\nfunc Analyze(files []string) (*Result, error) {\n        return AnalyzeWithTopK(files, 0)\n}\n\n// AnalyzeWithTopK analyzes drift and optionally restricts the returned tensor\n// list to the N tensors with the lowest stability scores. When topK > 0 the\n// result includes a top_k field set to the requested N, even if fewer tensors\n// are returned.\nfunc AnalyzeWithTopK(files []string, topK int) (*Result, error) {\n        return analyzeWithTopK(files, topK)\n}\n\nfunc analyzeWithTopK(files []string, topK int) (*Result, error) {\n        if len(files) < 2 {\n                return nil, fmt.Errorf("at least 2 input files required")\n        }\n\n        cps := make([]*mlck.Checkpoint, len(files))\n        for i, f := range files {\n                cp, err := mlck.ParseFile(f)\n                if err != nil {\n                        return nil, fmt.Errorf("file %s: %v", f, err)\n                }\n                cps[i] = cp\n        }\n\n        var allNames []string\n        seen := map[string]bool{}\n        for _, cp := range cps {\n                for _, t := range cp.Tensors {\n                        if !seen[t.Name] {\n                                seen[t.Name] = true\n                                allNames = append(allNames, t.Name)\n                        }\n                }\n        }\n        sort.Strings(allNames)\n\n        skipped := []string{}\n        tensors := []TensorResult{}\n        converging := 0\n        diverging := 0\n\n        for _, name := range allNames {\n                ok := true\n                var shape []uint32\n                for _, cp := range cps {\n                        t, exists := tensorByName(cp, name)\n                        if !exists {\n                                ok = false\n                                break\n                        }\n                        if shape == nil {\n                                shape = t.Shape\n                        } else if !shapesEqual(shape, t.Shape) {\n                                ok = false\n                                break\n                        }\n                }\n                if !ok {\n                        skipped = append(skipped, name)\n                        continue\n                }\n\n                steps := make([]float64, len(cps)-1)\n                for i := 0; i < len(steps); i++ {\n                        v1, err := tensorData(cps[i], name)\n                        if err != nil {\n                                return nil, err\n                        }\n                        v2, err := tensorData(cps[i+1], name)\n                        if err != nil {\n                                return nil, err\n                        }\n                        n := len(v1)\n                        if n == 0 {\n                                steps[i] = 0\n                                continue\n                        }\n                        var sum float64\n                        for j := 0; j < n; j++ {\n                                sum += math.Abs(v1[j] - v2[j])\n                        }\n                        steps[i] = sum / float64(n)\n                }\n\n                mean := meanFloat64(steps)\n                max := maxFloat64(steps)\n                convergence := classifyConvergence(steps)\n                stability := 1.0\n                if max != 0 {\n                        stability = 1.0 - steps[len(steps)-1]/max\n                        if stability < 0 {\n                                stability = 0\n                        } else if stability > 1 {\n                                stability = 1\n                        }\n                }\n\n                tensors = append(tensors, TensorResult{\n                        Name:           name,\n                        StepChanges:    steps,\n                        MeanChange:     mean,\n                        MaxChange:      max,\n                        Convergence:    convergence,\n                        StabilityScore: stability,\n                })\n\n                if convergence == "converging" {\n                        converging++\n                } else if convergence == "diverging" {\n                        diverging++\n                }\n        }\n\n        overall := "mixed"\n        if converging > len(tensors)/2 {\n                overall = "converging"\n        } else if diverging > len(tensors)/2 {\n                overall = "diverging"\n        }\n\n        sort.Strings(skipped)\n        sort.Slice(tensors, func(i, j int) bool {\n                return tensors[i].Name < tensors[j].Name\n        })\n\n        result := &Result{\n                NumSnapshots:       len(files),\n                NumAnalyzedTensors: len(tensors),\n                SkippedTensors:     skipped,\n                Tensors:            tensors,\n                OverallConvergence: overall,\n        }\n        applyTopK(result, topK)\n        return result, nil\n}\n\nfunc applyTopK(result *Result, topK int) {\n        if topK <= 0 {\n                return\n        }\n        requested := topK\n        sort.SliceStable(result.Tensors, func(i, j int) bool {\n                return result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore\n        })\n        if requested < len(result.Tensors) {\n                result.Tensors = result.Tensors[:requested]\n        }\n        result.TopK = &requested\n}\'\'\'\n)\n\n# Replace classifyConvergence logic.\ns = s.replace(\n\'\'\'func classifyConvergence(steps []float64) string {\n        if len(steps) <= 1 {\n                return "converging"\n        }\n        decreasing := true\n        increasing := true\n        for i := 1; i < len(steps); i++ {\n                if steps[i] >= steps[i-1] {\n                        decreasing = false\n                }\n                if steps[i] <= steps[i-1] {\n                        increasing = false\n                }\n        }\n        if decreasing {\n                return "converging"\n        }\n        if increasing {\n                return "diverging"\n        }\n        return "oscillating"\n}\'\'\',\n\'\'\'func classifyConvergence(steps []float64) string {\n        if len(steps) <= 1 {\n                return "converging"\n        }\n        nonIncreasing := true\n        nonDecreasing := true\n        hasIncrease := false\n        for i := 1; i < len(steps); i++ {\n                if steps[i] > steps[i-1] {\n                        nonIncreasing = false\n                        hasIncrease = true\n                }\n                if steps[i] < steps[i-1] {\n                        nonDecreasing = false\n                }\n        }\n        if nonIncreasing {\n                return "converging"\n        }\n        if nonDecreasing && hasIncrease {\n                return "diverging"\n        }\n        return "oscillating"\n}\'\'\'\n)\n\n# Remove duplicate original Analyze function by replacing its signature with delegation.\ns = s.replace(\n\'\'\'func Analyze(files []string) (*Result, error) {\n        if len(files) < 2 {\n                return nil, fmt.Errorf("at least 2 input files required")\n        }\n\n        cps := make([]*mlck.Checkpoint, len(files))\n        for i, f := range files {\n                cp, err := mlck.ParseFile(f)\n                if err != nil {\n                        return nil, fmt.Errorf("file %s: %v", f, err)\n                }\n                cps[i] = cp\n        }\n\n        var allNames []string\n        seen := map[string]bool{}\n        for _, cp := range cps {\n                for _, t := range cp.Tensors {\n                        if !seen[t.Name] {\n                                seen[t.Name] = true\n                                allNames = append(allNames, t.Name)\n                        }\n                }\n        }\n        sort.Strings(allNames)\n\n        skipped := []string{}\n        tensors := []TensorResult{}\n        converging := 0\n        diverging := 0\n\n        for _, name := range allNames {\n                ok := true\n                var shape []uint32\n                for _, cp := range cps {\n                        t, exists := tensorByName(cp, name)\n                        if !exists {\n                                ok = false\n                                break\n                        }\n                        if shape == nil {\n                                shape = t.Shape\n                        } else if !shapesEqual(shape, t.Shape) {\n                                ok = false\n                                break\n                        }\n                }\n                if !ok {\n                        skipped = append(skipped, name)\n                        continue\n                }\n\n                steps := make([]float64, len(cps)-1)\n                for i := 0; i < len(steps); i++ {\n                        v1, err := tensorData(cps[i], name)\n                        if err != nil {\n                                return nil, err\n                        }\n                        v2, err := tensorData(cps[i+1], name)\n                        if err != nil {\n                                return nil, err\n                        }\n                        n := len(v1)\n                        if n == 0 {\n                                steps[i] = 0\n                                continue\n                        }\n                        var sum float64\n                        for j := 0; j < n; j++ {\n                                sum += math.Abs(v1[j] - v2[j])\n                        }\n                        steps[i] = sum / float64(n)\n                }\n\n                mean := meanFloat64(steps)\n                max := maxFloat64(steps)\n                convergence := classifyConvergence(steps)\n                stability := 1.0\n                if max != 0 {\n                        stability = 1.0 - steps[len(steps)-1]/max\n                        if stability < 0 {\n                                stability = 0\n                        } else if stability > 1 {\n                                stability = 1\n                        }\n                }\n\n                tensors = append(tensors, TensorResult{\n                        Name:           name,\n                        StepChanges:    steps,\n                        MeanChange:     mean,\n                        MaxChange:      max,\n                        Convergence:    convergence,\n                        StabilityScore: stability,\n                })\n\n                if convergence == "converging" {\n                        converging++\n                } else if convergence == "diverging" {\n                        diverging++\n                }\n        }\n\n        overall := "mixed"\n        if converging > len(tensors)/2 {\n                overall = "converging"\n        } else if diverging > len(tensors)/2 {\n                overall = "diverging"\n        }\n\n        sort.Strings(skipped)\n        sort.Slice(tensors, func(i, j int) bool {\n                return tensors[i].Name < tensors[j].Name\n        })\n\n        result := &Result{\n                NumSnapshots:       len(files),\n                NumAnalyzedTensors: len(tensors),\n                SkippedTensors:     skipped,\n                Tensors:            tensors,\n                OverallConvergence: overall,\n        }\n        applyTopK(result, topK)\n        return result, nil\n}\'\'\',\n\'\'\'\n\'\'\'\n)\n\npath.write_text(s)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
