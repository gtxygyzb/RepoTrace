Sending keys: ['cat > internal/report/report.go <<\'EOF\'\npackage report\n\nimport (\n    "fmt"\n    "strings"\n    "time"\n\n    "repro-verify/internal/compare"\n    "repro-verify/internal/lineage"\n    "repro-verify/internal/manifest"\n    "repro-verify/internal/mlck"\n)\n\ntype ManifestPart struct {\n    Valid bool `json:"valid"`\n    Warnings []string `json:"warnings,omitempty"`\n    Errors []string `json:"errors,omitempty"`\n}\n\ntype CheckpointPart struct {\n    Valid bool `json:"valid"`\n    NumTensors int `json:"num_tensors"`\n    FileChecksum string `json:"file_checksum"`\n    Error string `json:"error,omitempty"`\n}\n\ntype ComparisonPart struct {\n    Match bool `json:"match"`\n    Summary string `json:"summary,omitempty"`\n    Error string `json:"error,omitempty"`\n}\n\ntype LineagePart struct {\n    Valid bool `json:"valid"`\n    Depth int `json:"depth"`\n    Error string `json:"error,omitempty"`\n}\n\ntype Report struct {\n    ReportVersion string `json:"report_version"`\n    Timestamp string `json:"timestamp"`\n    Manifest ManifestPart `json:"manifest"`\n    Checkpoint *CheckpointPart `json:"checkpoint,omitempty"`\n    Comparison *ComparisonPart `json:"comparison,omitempty"`\n    Lineage *LineagePart `json:"lineage,omitempty"`\n    OverallReproducible bool `json:"overall_reproducible"`\n    Issues []string `json:"issues"`\n}\n\nfunc Generate(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {\n    issues := []string{}\n    rep := &Report{\n        ReportVersion: "1.0",\n        Timestamp: time.Now().Format(time.RFC3339),\n        Issues: issues,\n    }\n\n    man := manifest.Validate(manifestPath)\n    rep.Manifest = ManifestPart{\n        Valid: man.Valid,\n        Warnings: man.Warnings,\n        Errors: man.Errors,\n    }\n    if !man.Valid {\n        issues = append(issues, fmt.Sprintf("Manifest validation failed: %s", strings.Join(man.Errors, "; ")))\n    }\n\n    checkpointValid := true\n    if checkpointPath != "" {\n        cp, err := mlck.ParseFile(checkpointPath)\n        if err != nil {\n            checkpointValid = false\n            rep.Checkpoint = &CheckpointPart{\n                Valid: false,\n                Error: err.Error(),\n            }\n            issues = append(issues, fmt.Sprintf("Checkpoint verification failed: %v", err))\n        } else {\n            rep.Checkpoint = &CheckpointPart{\n                Valid: true,\n                NumTensors: len(cp.Tensors),\n                FileChecksum: cp.FileChecksum,\n            }\n        }\n    }\n\n    comparisonMatch := true\n    if checkpointPath != "" && comparePath != "" {\n        c1, err := mlck.ParseFile(checkpointPath)\n        if err != nil {\n            comparisonMatch = false\n            rep.Comparison = &ComparisonPart{\n                Match: false,\n                Error: fmt.Sprintf("checkpoint parse failed: %v", err),\n            }\n            issues = append(issues, fmt.Sprintf("Comparison failed: %v", err))\n        } else {\n            c2, err := mlck.ParseFile(comparePath)\n            if err != nil {\n                comparisonMatch = false\n                rep.Comparison = &ComparisonPart{\n                    Match: false,\n                    Error: fmt.Sprintf("compare checkpoint parse failed: %v", err),\n                }\n                issues = append(issues, fmt.Sprintf("Comparison failed: %v", err))\n            } else {\n                res, err := compare.Compare(c1, c2, "strict", 1e-7, 1e-5)\n                if err != nil {\n                    comparisonMatch = false\n                    rep.Comparison = &ComparisonPart{\n                        Match: false,\n                        Error: err.Error(),\n                    }\n                    issues = append(issues, fmt.Sprintf("Comparison failed: %v", err))\n                } else {\n                    differ := 0\n                    total := len(res.TensorResults)\n                    for _, tr := range res.TensorResults {\n                        if !tr.Match {\n                            differ++\n                        }\n                    }\n                    rep.Comparison = &ComparisonPart{\n                        Match: res.Match,\n                        Summary: fmt.Sprintf("%d/%d tensors differ", differ, total),\n                    }\n                    if !res.Match {\n                        comparisonMatch = false\n                        if differ > 0 {\n                            issues = append(issues, fmt.Sprintf("Tensor comparison failed: %d tensors differ beyond tolerance", differ))\n                        } else {\n                            issues = append(issues, "Tensor comparison failed: missing tensors or shape mismatch")\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    lineageValid := true\n    if lineagePath != "" {\n        lin := lineage.Audit(lineagePath)\n        if lin.Valid {\n            rep.Lineage = &LineagePart{\n                Valid: true,\n                Depth: lin.MaxDepth,\n            }\n        } else {\n            lineageValid = false\n            rep.Lineage = &LineagePart{\n                Valid: false,\n                Error: strings.Join(lin.Errors, "; "),\n            }\n            issues = append(issues, fmt.Sprintf("Lineage audit failed: %s", strings.Join(lin.Errors, "; ")))\n        }\n    }\n\n    overall := man.Valid && checkpointValid && comparisonMatch && lineageValid\n    rep.OverallReproducible = overall\n    rep.Issues = issues\n\n    if overall {\n        return rep, 0\n    }\n    return rep, 1\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
