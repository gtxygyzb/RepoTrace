g, dtype)\n                if err != nil {\n                    return nil, err\n                }\n                tensor = mlck.Tensor{\n                    Name: name,\n                    Dtype: dtype,\n                    Shape: shape,\n                    Data: data,\n                }\n                resolution = "averaged"\n            }\n        } else {\n            tensor = occs[0].tensor\n        }\n\n        outTensors = append(outTensors, tensor)\n        tensorSources = append(tensorSources, TensorSource{\n            Name: name,\n            Sources: sources,\n            Resolution: resolution,\n        })\n    }\n\n    if err := mlck.WriteFile(output, metadata, outTensors); err != nil {\n        return nil, err\n    }\n\n    return &Result{\n        OutputFile: output,\n        NumInputFiles: len(files),\n        TotalTensors: len(outTensors),\n        ConflictsResolved: conflicts,\n        ConflictStrategy: strategy,\n        TensorSources: tensorSources,\n    }, nil\n}\n\nfunc shapesEqual(a, b []uint32) bool {\n    if len(a) != len(b) {\n        return false\n    }\n    for i := range a {\n        if a[i] != b[i] {\n            return false\n        }\n    }\n    return true\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
