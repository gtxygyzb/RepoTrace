Sending keys: ['cat > cmd/gen-test/main.go <<\'EOF\'\npackage main\n\nimport (\n        "encoding/binary"\n        "math"\n\n        "repro-verify/internal/mlck"\n)\n\nfunc float32Data(vals []float32) []byte {\n        b := make([]byte, 4*len(vals))\n        for i, v := range vals {\n                binary.LittleEndian.PutUint32(b[4*i:4*i+4], math.Float32bits(v))\n        }\n        return b\n}\n\nfunc main() {\n        // Tensor a: step changes are exactly equal (1, 1, 1) -> converging.\n        // Tensor b: step changes near-zero first then large (0, 10, 20) -> diverging,\n        //           stability should not be 1 despite zero first step.\n        // Tensor c: step changes decreasing (3, 2, 1) -> converging.\n        checkpoints := []struct {\n                path    string\n                aValues []float32\n                bValues []float32\n                cValues []float32\n        }{\n                {"a0.ckpt", []float32{0, 1, 2}, []float32{0, 0.0001, 0.0001}, []float32{0, 0, 0}},\n                {"a1.ckpt", []float32{1, 2, 3}, []float32{0, 0.0001, 10.0001}, []float32{3, 3, 3}},\n                {"a2.ckpt", []float32{2, 3, 4}, []float32{0, 0.0002, 30.0002}, []float32{6, 6, 6}},\n                {"a3.ckpt", []float32{3, 4, 5}, []float32{0, 0.0003, 60.0003}, []float32{9, 9, 9}},\n        }\n\n        for _, cp := range checkpoints {\n                tensors := []mlck.Tensor{\n                        {Name: "a", Dtype: uint8(mlck.Float32), Shape: []uint32{3}, Data: float32Data(cp.aValues)},\n                        {Name: "b", Dtype: uint8(mlck.Float32), Shape: []uint32{3}, Data: float32Data(cp.bValues)},\n                        {Name: "c", Dtype: uint8(mlck.Float32), Shape: []uint32{3}, Data: float32Data(cp.cValues)},\n                }\n                if err := mlck.WriteFile(cp.path, map[string]interface{}{"step": cp.path}, tensors); err != nil {\n                        panic(err)\n                }\n        }\n}\nEOF\n'] min_timeout_sec: 0.1 max_ti