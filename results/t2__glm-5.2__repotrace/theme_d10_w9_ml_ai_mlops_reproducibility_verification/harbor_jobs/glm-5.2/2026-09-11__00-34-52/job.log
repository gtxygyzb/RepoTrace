il\n}\n\nfunc tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {\n    for _, t := range cp.Tensors {\n        if t.Name == name {\n            return t, true\n        }\n    }\n    return mlck.Tensor{}, false\n}\n\nfunc shapesEqual(a, b []uint32) bool {\n    if len(a) != len(b) {\n        return false\n    }\n    for i := range a {\n        if a[i] != b[i] {\n            return false\n        }\n    }\n    return true\n}\n\nfunc meanFloat64(xs []float64) float64 {\n    if len(xs) == 0 {\n        return 0\n    }\n    var sum float64\n    for _, x := range xs {\n        sum += x\n    }\n    return sum / float64(len(xs))\n}\n\nfunc maxFloat64(xs []float64) float64 {\n    if len(xs) == 0 {\n        return 0\n    }\n    m := xs[0]\n    for _, x := range xs[1:] {\n        if x > m {\n            m = x\n        }\n    }\n    return m\n}\n\nfunc classifyConvergence(steps []float64) string {\n    if len(steps) <= 1 {\n        return "converging"\n    }\n    decreasing := true\n    increasing := true\n    for i := 1; i < len(steps); i++ {\n        if steps[i] >= steps[i-1] {\n            decreasing = false\n        }\n        if steps[i] <= steps[i-1] {\n            increasing = false\n        }\n    }\n    if decreasing {\n        return "converging"\n    }\n    if increasing {\n        return "diverging"\n    }\n    return "oscillating"\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
