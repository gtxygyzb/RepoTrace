Sending keys: ['python3 - <<\'PY\'\nimport re\nfrom pathlib import Path\n\np = Path(\'internal/drift/drift.go\')\ns = p.read_text()\n\ns = re.sub(\n    r\'type Result struct \\{.*?\\n\\}\',\n    \'\'\'type Result struct {\n        NumSnapshots       int            `json:"num_snapshots"`\n        NumAnalyzedTensors int            `json:"num_analyzed_tensors"`\n        SkippedTensors     []string       `json:"skipped_tensors"`\n        Tensors            []TensorResult `json:"tensors"`\n        OverallConvergence string         `json:"overall_convergence"`\n        TopK               *int           `json:"top_k,omitempty"`\n}\'\'\',\n    s,\n    flags=re.S,\n)\n\nnew_analyze = \'\'\'// Analyze remains available for callers that do not need a top-k restriction.\nfunc Analyze(files []string) (*Result, error) {\n        return AnalyzeWithTopK(files, 0)\n}\n\n// AnalyzeWithTopK analyzes drift and optionally restricts the returned tensor\n// list to the N tensors with the lowest stability scores. When topK > 0 the\n// result includes a top_k field set to the requested N, even if fewer tensors\n// are returned.\nfunc AnalyzeWithTopK(files []string, topK int) (*Result, error) {\n        if len(files) < 2 {\n                return nil, fmt.Errorf("at least 2 input files required")\n        }\n\n        cps := make([]*mlck.Checkpoint, len(files))\n        for i, f := range files {\n                cp, err := mlck.ParseFile(f)\n                if err != nil {\n                        return nil, fmt.Errorf("file %s: %v", f, err)\n                }\n                cps[i] = cp\n        }\n\n        var allNames []string\n        seen := map[string]bool{}\n        for _, cp := range cps {\n                for _, t := range cp.Tensors {\n                        if !seen[t.Name] {\n                                seen[t.Name] = true\n                                allNames = append(allNames, t.Name)\n                        }\n                }\n        }\n        sort.Strings(allNames)\n\n        skipped := []string{}\n        tensors := []TensorResult{}\n        converging := 0\n        diverging := 0\n\n        for _, name := range allNames {\n                ok := true\n                var shape []uint32\n                for _, cp := range cps {\n                        t, exists := tensorByName(cp, name)\n                        if !exists {\n                                ok = false\n                                break\n                        }\n                        if shape == nil {\n                                shape = t.Shape\n                        } else if !shapesEqual(shape, t.Shape) {\n                                ok = false\n                                break\n                        }\n                }\n                if !ok {\n                        skipped = append(skipped, name)\n                        continue\n                }\n\n                steps := make([]float64, len(cps)-1)\n                for i := 0; i < len(steps); i++ {\n                        v1, err := tensorData(cps[i], name)\n                        if err != nil {\n                                return nil, err\n                        }\n                        v2, err := tensorData(cps[i+1], name)\n                        if err != nil {\n                                return nil, err\n                        }\n                        n := len(v1)\n                        if n == 0 {\n                                steps[i] = 0\n                                continue\n                        }\n                        var sum float64\n                        for j := 0; j < n; j++ {\n                                sum += math.Abs(v1[j] - v2[j])\n                        }\n                        steps[i] = sum / float64(n)\n                }\n\n                mean := meanFloat64(steps)\n                max := maxFloat64(steps)\n                convergence := classifyConvergence(steps)\n                stability := 1.0\n                if max != 0 {\n                        stability = 1.0 - steps[len(steps)-1]/max\n                        if stability < 0 {\n                                stability = 0\n                        } else if stability > 1 {\n                                stability = 1\n                        }\n                }\n\n                tensors = append(tensors, TensorResult{\n                        Name:           name,\n                        StepChanges:    steps,\n                        MeanChange:     mean,\n                        MaxChange:      max,\n                        Convergence:    convergence,\n                        StabilityScore: stability,\n                })\n\n                if convergence == "converging" {\n                        converging++\n                } else if convergence == "diverging" {\n                        diverging++\n                }\n        }\n\n        overall := "mixed"\n        if converging > len(tensors)/2 {\n                overall = "converging"\n        } else if diverging > len(tensors)/2 {\n                overall = "diverging"\n        }\n\n        sort.Strings(skipped)\n        sort.Slice(tensors, func(i, j int) bool {\n                return tensors[i].Name < tensors[j].Name\n        })\n\n        result := &Result{\n                NumSnapshots:       len(files),\n                NumAnalyzedTensors: len(tensors),\n                SkippedTensors:     skipped,\n                Tensors:            tensors,\n                OverallConvergence: overall,\n        }\n        applyTopK(result, topK)\n        return result, nil\n}\n\nfunc applyTopK(result *Result, topK int) {\n        if topK <= 0 {\n                return\n        }\n\n        requested := topK\n        sort.SliceStable(result.Tensors, func(i, j int) bool {\n                if result.Tensors[i].StabilityScore != result.Tensors[j].StabilityScore {\n                        return result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore\n                }\n                return result.Tensors[i].Name < result.Tensors[j].Name\n        })\n        if requested < len(result.Tensors) {\n                result.Tensors = result.Tensors[:requested]\n        }\n        result.TopK = &requested\n}\'\'\'\n\ns = re.sub(\n    r\'func Analyze\\(files \\[\\]string\\) \\(\\*Result, error\\) \\{.*?\\n\\}\\n\\nfunc tensorByName\',\n    new_analyze + \'\\n\\nfunc tensorByName\',\n    s,\n    flags=re.S,\n)\n\nnew_classify = \'\'\'func classifyConvergence(steps []float64) string {\n        if len(steps) <= 1 {\n                return "converging"\n        }\n        nonIncreasing := true\n        nonDecreasing := true\n        hasIncrease := false\n        for i := 1; i < len(steps); i++ {\n                if steps[i] > steps[i-1] {\n                        nonIncreasing = false\n                        hasIncrease = true\n                }\n                if steps[i] < steps[i-1] {\n                        nonDecreasing = false\n                }\n        }\n        if nonIncreasing {\n                return "converging"\n        }\n        if nonDecreasing && hasIncrease {\n                return "diverging"\n        }\n        return "oscillating"\n}\'\'\'\n\ns = re.sub(\n    r\'func classifyConvergence\\(steps \\[\\]float64\\) string \\{.*?\\n\\}\',\n    new_classify,\n    s,\n    flags=re.S,\n)\n\np.write_text(s)\n\np = Path(\'internal/app/app.go\')\ns = p.read_text()\n\nnew_run = \'\'\'func runDriftAnalysis(args []string) int {\n        fs := flag.NewFlagSet("drift-analysis", flag.ContinueOnError)\n        fs.SetOutput(io.Discard)\n\n        topK := fs.Int("top-k", 0, "number of tensors with the lowest stability scores to include")\n\n        pos, err := parseMixedArgs(fs, args)\n        if err != nil {\n                outputJSON(map[string]interface{}{"error": err.Error()})\n                return 1\n        }\n        if len(pos) < 2 {\n                outputJSON(map[string]interface{}{"error": "usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]"})\n                return 1\n        }\n        if *topK < 0 {\n                outputJSON(map[string]interface{}{"error": "--top-k must be non-negative"})\n                return 1\n        }\n\n        res, err := drift.AnalyzeWithTopK(pos, *topK)\n        if err != nil {\n                outputJSON(map[string]interface{}{"error": err.Error()})\n                return 1\n        }\n        outputJSON(res)\n        return 0\n}\'\'\'\n\ns = re.sub(\n    r\'func runDriftAnalysis\\(args \\[\\]string\\) int \\{.*?\\n\\}\\n\\nfunc parseMixedArgs\',\n    new_run + \'\\n\\nfunc parseMixedArgs\',\n    s,\n    flags=re.S,\n)\np.write_text(s)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
