import struct, json, hashlib, os, subprocess, sys

def write_mlck(path, metadata, tensors, bad_footer=False):
    meta = json.dumps(metadata).encode()
    body = b'MLCK' + struct.pack('<III', 1, len(tensors), len(meta)) + meta
    for name, dtype, shape, data in tensors:
        nb = name.encode()
        body += struct.pack('<I', len(nb)) + nb
        body += struct.pack('<B', dtype)
        body += struct.pack('<I', len(shape))
        for s in shape:
            body += struct.pack('<I', s)
        body += data
    footer = hashlib.sha256(body).digest()
    if bad_footer:
        footer = b'\x00' * 32
    with open(path, 'wb') as f:
        f.write(body + footer)

def f32(vals):
    return b''.join(struct.pack('<f', v) for v in vals)
def f64(vals):
    return b''.join(struct.pack('<d', v) for v in vals)

write_mlck('/tmp/cp1.bin', {'name':'test','framework':'pytorch','seed':42}, [('conv1.weight',0,[2,2],f32([1,2,3,4])),('fc.weight',1,[2,2],f64([1,2,3,4]))])
write_mlck('/tmp/cp2.bin', {'name':'test','framework':'pytorch','seed':42}, [('conv1.weight',0,[2,2],f32([1,2,3,4])),('fc.weight',1,[2,2],f64([1,2,3,4]))])
write_mlck('/tmp/cp3.bin', {'name':'test','framework':'pytorch','seed':42}, [('conv1.weight',0,[2,2],f32([1,2,3,4])),('extra',2,[2],struct.pack('<ii',5,6))])
write_mlck('/tmp/bad.bin', {'name':'bad'}, [('conv1.weight',0,[2,2],f32([1,2,3,4]))], bad_footer=True)
write_mlck('/tmp/d1.bin', {'name':'drift'}, [('conv1.weight',0,[2,2],f32([0,0,0,0]))])
write_mlck('/tmp/d2.bin', {'name':'drift'}, [('conv1.weight',0,[2,2],f32([0.1,0.1,0.1,0.1]))])
write_mlck('/tmp/d3.bin', {'name':'drift'}, [('conv1.weight',0,[2,2],f32([0.12,0.12,0.12,0.12]))])

manifest = '''[experiment]
name = "test-exp"
timestamp = "2024-01-15T10:30:00Z"

[environment]
python_version = "3.11.2"
seed = 42
deterministic = true
gpu_id = "cuda0"

[[dependencies]]
name = "torch"
version = "2.1.0"

[outputs]
checkpoint_path = "cp1.bin"

[outputs.metrics]
accuracy = 0.95
'''
open('/tmp/manifest.toml','w').write(manifest)
open('/tmp/badmanifest.toml','w').write('not valid toml =\n')
lineage = {"experiments":[{"id":"exp-001","name":"base","parents":[],"checkpoint_hash":"abc","timestamp":"2024-01-10T08:00:00Z"},{"id":"exp-002","name":"fine","parents":["exp-001"],"checkpoint_hash":"def","timestamp":"2024-01-12T14:00:00Z"}]}
open('/tmp/lineage.json','w').write(json.dumps(lineage, indent=2))
badlineage = {"experiments":[{"id":"a","parents":["b"],"checkpoint_hash":"","timestamp":"2024-01-01T00:00:00Z"},{"id":"b","parents":["a"],"checkpoint_hash":"x","timestamp":"2024-01-02T00:00:00Z"}]}
open('/tmp/badlineage.json','w').write(json.dumps(badlineage, indent=2))

def run(args):
    p = subprocess.run(['./repro-verify'] + args, text=True, capture_output=True)
    print('CMD:', ' '.join(args))
    print(p.stdout)
    if p.stderr:
        print('STDERR:', p.stderr.strip())
    print('EXIT:', p.returncode)
    print('-' * 60)
    return p.returncode

run(['verify-checkpoint', '/tmp/cp1.bin'])
run(['verify-checkpoint', '/tmp/bad.bin'])
run(['compare-outputs', '/tmp/cp1.bin', '/tmp/cp2.bin', '--mode', 'strict'])
run(['compare-outputs', '/tmp/cp1.bin', '/tmp/cp3.bin', '--mode', 'strict'])
run(['validate-manifest', '/tmp/manifest.toml'])
run(['validate-manifest', '/tmp/badmanifest.toml'])
run(['audit-lineage', '/tmp/lineage.json'])
run(['audit-lineage', '/tmp/badlineage.json'])
run(['merge-checkpoints', '/tmp/merged.bin', '/tmp/cp1.bin', '/tmp/cp3.bin', '--conflict', 'first'])
run(['verify-checkpoint', '/tmp/merged.bin'])
run(['drift-analysis', '/tmp/d1.bin', '/tmp/d2.bin', '/tmp/d3.bin'])
run(['generate-report', '/tmp/manifest.toml', '--checkpoint', '/tmp/cp1.bin', '--compare', '/tmp/cp2.bin', '--lineage', '/tmp/lineage.json'])
PY
