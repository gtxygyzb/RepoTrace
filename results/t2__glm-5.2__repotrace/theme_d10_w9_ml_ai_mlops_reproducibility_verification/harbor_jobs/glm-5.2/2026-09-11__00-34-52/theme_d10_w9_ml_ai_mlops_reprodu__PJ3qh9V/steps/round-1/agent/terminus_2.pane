    41	
    42	func Compare(c1, c2 *mlck.Checkpoint, mode string, atol, rtol float64, histogram bool) (*Result, error) {
    43		if mode != "strict" && mode != "relaxed" {
    44			return nil, fmt.Errorf("invalid mode %q", mode)
    45		}
    46	
    47		result := &Result{
    48			Match:            true,
    49			Mode:             mode,
    50			Atol:             atol,
    51			Rtol:             rtol,
    52			HistogramEnabled: histogram,
    53			TensorResults:    []TensorResult{},
    54			MissingInFile1:   []string{},
    55			MissingInFile2:   []string{},
    56		}
    57	
    58		map2 := make(map[string]mlck.Tensor)
    59		for _, t := range c2.Tensors {
    60			map2[t.Name] = t
    61		}
    62		map1 := make(map[string]mlck.Tensor)
    63		for _, t := range c1.Tensors {
    64			map1[t.Name] = t
    65		}
    66	
    67		for _, t1 := range c1.Tensors {
    68			t2, ok := map2[t1.Name]
    69			if !ok {
    70				result.MissingInFile2 = append(result.MissingInFile2, t1.Name)
    71				continue
    72			}
    73			tr := compareTensors(t1, t2, mode, atol, rtol, histogram)
    74			result.TensorResults = append(result.TensorResults, tr)
    75			if !tr.Match {
    76				result.Match = false
    77			}
    78		}
    79	
    80		for _, t := range c2.Tensors {
    81			if _, ok := map1[t.Name]; !ok {
    82				result.MissingInFile1 = append(result.MissingInFile1, t.Name)
    83			}
    84		}
    85	
    86		if len(result.MissingInFile1) > 0 || len(result.MissingInFile2) > 0 {
    87			result.Match = false
    88		}
    89	
    90		return result, nil
    91	}
    92	
