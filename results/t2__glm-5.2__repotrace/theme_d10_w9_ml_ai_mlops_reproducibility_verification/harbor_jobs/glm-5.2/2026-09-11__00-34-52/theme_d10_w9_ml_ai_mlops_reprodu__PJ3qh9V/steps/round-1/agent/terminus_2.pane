   164	func runGenerateReport(args []string) int {
   165		fs := flag.NewFlagSet("generate-report", flag.ContinueOnError)
   166		fs.SetOutput(io.Discard)
   167		checkpoint := fs.String("checkpoint", "", "checkpoint file to verify")
   168		comparePath := fs.String("compare", "", "second checkpoint to compare")
   169		lineagePath := fs.String("lineage", "", "lineage file to audit")
   170	
   171		pos, err := parseMixedArgs(fs, args)
   172		if err != nil {
   173			outputJSON(map[string]interface{}{"error": err.Error()})
   174			return 1
   175		}
   176		if len(pos) != 1 {
   177			outputJSON(map[string]interface{}{"error": "usage: repro-verify generate-report <manifest.toml> [flags]"})
   178			return 1
   179		}
   180	
   181		for _, p := range []string{pos[0], *checkpoint, *comparePath, *lineagePath} {
   182			if p == "" {
   183				continue
   184			}
   185			if _, err := os.ReadFile(p); err != nil {
   186				outputJSON(map[string]interface{}{"error": err.Error()})
   187				return 1
   188			}
   189		}
   190	
   191		rep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)
   192		outputJSON(rep)
   193		return code
   194	}
