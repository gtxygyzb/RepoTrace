[?2004hroot@n30009:/app# sed -n '1,240p' internal/drift/drift.go
[?2004lpackage drift

import (
	"fmt"
	"math"
	"sort"

	"repro-verify/internal/mlck"
)

type TensorResult struct {
	Name           string    `json:"name"`
	StepChanges    []float64 `json:"step_changes"`
	MeanChange     float64   `json:"mean_change"`
	MaxChange      float64   `json:"max_change"`
	Convergence    string    `json:"convergence"`
	StabilityScore float64   `json:"stability_score"`
}

type Result struct {
	NumSnapshots       int            `json:"num_snapshots"`
	NumAnalyzedTensors int            `json:"num_analyzed_tensors"`
	SkippedTensors     []string       `json:"skipped_tensors"`
	Tensors            []TensorResult `json:"tensors"`
	OverallConvergence string         `json:"overall_convergence"`
	TopK               *int           `json:"top_k,omitempty"`
}

// Analyze remains available for callers that do not need a top-k restriction.
func Analyze(files []string) (*Result, error) {
	return AnalyzeWithTopK(files, nil)
}

// AnalyzeWithTopK analyzes drift and optionally restricts the returned tensor
// list to the N tensors with the lowest stability scores. When topK > 0 the
// result includes a top_k field set to the requested N, even if fewer tensors
// are returned.
func AnalyzeWithTopK(files []string, topK *int) (*Result, error) {
	if len(files) < 2 {
		return nil, fmt.Errorf("at least 2 input files required")
	}

	cps := make([]*mlck.Checkpoint, len(files))
	for i, f := range files {
		cp, err := mlck.ParseFile(f)
		if err != nil {
			return nil, fmt.Errorf("file %s: %v", f, err)
		}
		cps[i] = cp
	}

	var allNames []string
	seen := map[string]bool{}
	for _, cp := range cps {
		for _, t := range cp.Tensors {
			if !seen[t.Name] {
				seen[t.Name] = true
				allNames = append(allNames, t.Name)
			}
		}
	}
	sort.Strings(allNames)

	skipped := []string{}
	tensors := []TensorResult{}
	converging := 0
	diverging := 0

	for _, name := range allNames {
		ok := true
		var shape []uint32
		for _, cp := range cps {
			t, exists := tensorByName(cp, name)
			if !exists {
				ok = false
				break
			}
			if shape == nil {
				shape = t.Shape
			} else if !shapesEqual(shape, t.Shape) {
				ok = false
				break
			}
		}
		if !ok {
			skipped = append(skipped, name)
			continue
		}

		steps := make([]float64, len(cps)-1)
		for i := 0; i < len(steps); i++ {
			v1, err := tensorData(cps[i], name)
			if err != nil {
				return nil, err
			}
			v2, err := tensorData(cps[i+1], name)
			if err != nil {
				return nil, err
			}
			n := len(v1)
			if n == 0 {
				steps[i] = 0
				continue
			}
			var sum float64
			for j := 0; j < n; j++ {
				sum += math.Abs(v1[j] - v2[j])
			}
			steps[i] = sum / float64(n)
		}

		mean := meanFloat64(steps)
		max := maxFloat64(steps)
		convergence := classifyConvergence(steps)
		stability := 1.0
		if max != 0 {
			stability = 1.0 - steps[len(steps)-1]/max
			if stability < 0 {
				stability = 0
			} else if stability > 1 {
				stability = 1
			}
		}

		tensors = append(tensors, TensorResult{
			Name:           name,
			StepChanges:    steps,
			MeanChange:     mean,
			MaxChange:      max,
			Convergence:    convergence,
			StabilityScore: stability,
		})

		if convergence == "converging" {
			converging++
		} else if convergence == "diverging" {
			diverging++
		}
	}

	overall := "mixed"
	if converging > len(tensors)/2 {
		overall = "converging"
	} else if diverging > len(tensors)/2 {
		overall = "diverging"
	}

	sort.Strings(skipped)
	sort.Slice(tensors, func(i, j int) bool {
		return tensors[i].Name < tensors[j].Name
	})

	result := &Result{
		NumSnapshots:       len(files),
		NumAnalyzedTensors: len(tensors),
		SkippedTensors:     skipped,
		Tensors:            tensors,
		OverallConvergence: overall,
	}
	applyTopK(result, topK)
	return result, nil
}

func applyTopK(result *Result, topK *int) {
	if topK == nil {
		return
	}

	requested := *topK
	sort.SliceStable(result.Tensors, func(i, j int) bool {
		if result.Tensors[i].StabilityScore != result.Tensors[j].StabilityScore {
			return result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore
		}
		return result.Tensors[i].Name < result.Tensors[j].Name
	})
	if requested < len(result.Tensors) {
		result.Tensors = result.Tensors[:requested]
	}
	result.TopK = &requested
}

func tensorData(cp *mlck.Checkpoint, name string) ([]float64, error) {
	t, ok := tensorByName(cp, name)
	if !ok {
		return nil, fmt.Errorf("tensor %s not found", name)
	}
	return t.Float64Values()
}

func tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {
	for _, t := range cp.Tensors {
		if t.Name == name {
			return t, true
		}
	}
	return mlck.Tensor{}, false
}

func shapesEqual(a, b []uint32) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func meanFloat64(xs []float64) float64 {
	if len(xs) == 0 {
		return 0
	}
	var sum float64
	for _, x := range xs {
		sum += x
	}
	return sum / float64(len(xs))
}

func maxFloat64(xs []float64) float64 {
	if len(xs) == 0 {
		return 0
	}
	m := xs[0]
	for _, x := range xs[1:] {
		if x > m {
			m = x
		}
	}
	return m
}

func classifyConvergence(steps []float64) string {
	if len(steps) <= 1 {
		return "converging"
	}
	nonIncreasing := true
	nonDecreasing := true
[?2004hroot@n30009:/app# sed -n '1,320p' internal/app/app.go
[?2004lpackage app

import (
	"encoding/json"
	"flag"
	"fmt"
	"io"
	"os"
	"strings"

	"repro-verify/internal/compare"
	"repro-verify/internal/drift"
	"repro-verify/internal/lineage"
	"repro-verify/internal/manifest"
	"repro-verify/internal/merge"
	"repro-verify/internal/mlck"
	"repro-verify/internal/report"
)

func Run() int {
	if len(os.Args) < 2 {
		outputJSON(map[string]interface{}{"error": "no subcommand provided"})
		return 1
	}

	switch os.Args[1] {
	case "verify-checkpoint":
		return runVerifyCheckpoint(os.Args[2:])
	case "compare-outputs":
		return runCompareOutputs(os.Args[2:])
	case "validate-manifest":
		return runValidateManifest(os.Args[2:])
	case "audit-lineage":
		return runAuditLineage(os.Args[2:])
	case "generate-report":
		return runGenerateReport(os.Args[2:])
	case "merge-checkpoints":
		return runMergeCheckpoints(os.Args[2:])
	case "drift-analysis":
		return runDriftAnalysis(os.Args[2:])
	default:
		outputJSON(map[string]interface{}{"error": fmt.Sprintf("unknown subcommand: %s", os.Args[1])})
		return 1
	}
}

func runVerifyCheckpoint(args []string) int {
	if len(args) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify verify-checkpoint <file>"})
		return 1
	}

	if _, err := os.ReadFile(args[0]); err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}

	cp, err := mlck.ParseFile(args[0])
	if err != nil {
		outputJSON(map[string]interface{}{
			"valid": false,
			"error": err.Error(),
		})
		return 1
	}

	metadata := cp.Metadata
	if metadata == nil {
		metadata = map[string]interface{}{}
	}
	tensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))
	for _, t := range cp.Tensors {
		tensors = append(tensors, t.Info())
	}

	outputJSON(map[string]interface{}{
		"valid":          true,
		"format_version": int(cp.Version),
		"num_tensors":    len(cp.Tensors),
		"metadata":       metadata,
		"tensors":        tensors,
		"file_checksum":  cp.FileChecksum,
	})
	return 0
}

func runCompareOutputs(args []string) int {
	fs := flag.NewFlagSet("compare-outputs", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	atol := fs.Float64("atol", 1e-7, "absolute tolerance")
	rtol := fs.Float64("rtol", 1e-5, "relative tolerance")
	mode := fs.String("mode", "strict", "comparison mode")
	histogram := fs.Bool("histogram", false, "include diff histograms")

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) != 2 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify compare-outputs <file1> <file2> [flags]"})
		return 1
	}

	c1, err := mlck.ParseFile(pos[0])
	if err != nil {
		outputJSON(map[string]interface{}{"error": fmt.Sprintf("file1: %v", err)})
		return 1
	}

	c2, err := mlck.ParseFile(pos[1])
	if err != nil {
		outputJSON(map[string]interface{}{"error": fmt.Sprintf("file2: %v", err)})
		return 1
	}

	res, err := compare.Compare(c1, c2, *mode, *atol, *rtol, *histogram)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}

	outputJSON(res)
	if res.Match {
		return 0
	}
	return 1
}

func runValidateManifest(args []string) int {
	if len(args) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify validate-manifest <file.toml>"})
		return 1
	}
	if _, err := os.ReadFile(args[0]); err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	res := manifest.Validate(args[0])
	outputJSON(res)
	if res.Valid {
		return 0
	}
	return 1
}

func runAuditLineage(args []string) int {
	if len(args) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify audit-lineage <file.json>"})
		return 1
	}
	if _, err := os.ReadFile(args[0]); err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	res := lineage.Audit(args[0])
	outputJSON(res)
	if res.Valid {
		return 0
	}
	return 1
}

func runGenerateReport(args []string) int {
	fs := flag.NewFlagSet("generate-report", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	checkpoint := fs.String("checkpoint", "", "checkpoint file to verify")
	comparePath := fs.String("compare", "", "second checkpoint to compare")
	lineagePath := fs.String("lineage", "", "lineage file to audit")

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify generate-report <manifest.toml> [flags]"})
		return 1
	}

	for _, p := range []string{pos[0], *checkpoint, *comparePath, *lineagePath} {
		if p == "" {
			continue
		}
		if _, err := os.ReadFile(p); err != nil {
			outputJSON(map[string]interface{}{"error": err.Error()})
			return 1
		}
	}

	rep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)
	outputJSON(rep)
	return code
}

func runMergeCheckpoints(args []string) int {
	fs := flag.NewFlagSet("merge-checkpoints", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	conflict := fs.String("conflict", "first", "conflict strategy")

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) < 3 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]"})
		return 1
	}

	res, err := merge.Merge(pos[0], pos[1:], *conflict)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	outputJSON(res)
	return 0
}

func runDriftAnalysis(args []string) int {
	fs := flag.NewFlagSet("drift-analysis", flag.ContinueOnError)
	fs.SetOutput(io.Discard)

	topK := fs.Int("top-k", 0, "number of tensors with the lowest stability scores to include")

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) < 2 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]"})
		return 1
	}

	var topKPtr *int
	fs.Visit(func(f *flag.Flag) {
		if f.Name == "top-k" {
			v := *topK
			topKPtr = &v
		}
	})
	if topKPtr != nil && *topKPtr < 0 {
		outputJSON(map[string]interface{}{"error": "--top-k must be non-negative"})
		return 1
	}

	res, err := drift.AnalyzeWithTopK(pos, topKPtr)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	outputJSON(res)
	return 0
}

func parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {
	var positional []string
	var flagArgs []string

	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			positional = append(positional, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if strings.Contains(arg, "=") {
				flagArgs = append(flagArgs, arg)
				continue
			}
			if isBoolFlag(fs, arg) {
				flagArgs = append(flagArgs, arg+"=true")
				continue
			}
			if i+1 >= len(args) {
				return nil, fmt.Errorf("flag %s requires a value", arg)
			}
			flagArgs = append(flagArgs, arg+"="+args[i+1])
			i++
		} else {
			positional = append(positional, arg)
		}
	}

	if err := fs.Parse(flagArgs); err != nil {
		return nil, err
	}
	return positional, nil
}

func isBoolFlag(fs *flag.FlagSet, arg string) bool {
	name := strings.TrimPrefix(arg, "--")
	if i := strings.IndexByte(name, '='); i >= 0 {
		name = name[:i]
	}
	f := fs.Lookup(name)
	if f == nil {
		return false
	}
	type boolFlag interface {
		IsBoolFlag() bool
	}
	bf, ok := f.Value.(boolFlag)
	return ok && bf.IsBoolFlag()
}

func outputJSON(v interface{}) {
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	enc.SetEscapeHTML(false)
	_ = enc.Encode(v)
}
