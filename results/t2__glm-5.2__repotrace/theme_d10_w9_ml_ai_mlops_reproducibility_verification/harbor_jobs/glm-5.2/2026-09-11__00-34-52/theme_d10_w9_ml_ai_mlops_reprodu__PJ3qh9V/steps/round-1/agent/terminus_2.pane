   230	
   231	func Build(metadata map[string]interface{}, tensors []Tensor) ([]byte, error) {
   232		metaRaw, err := json.Marshal(metadata)
   233		if err != nil {
   234			return nil, fmt.Errorf("failed to marshal metadata: %v", err)
   235		}
   236	
   237		var buf bytes.Buffer
   238		header := make([]byte, HeaderSize)
   239		copy(header[0:4], Magic)
   240		binary.LittleEndian.PutUint32(header[4:8], Version)
   241		binary.LittleEndian.PutUint32(header[8:12], uint32(len(tensors)))
   242		binary.LittleEndian.PutUint32(header[12:16], uint32(len(metaRaw)))
   243		buf.Write(header)
   244		buf.Write(metaRaw)
   245	
   246		for _, t := range tensors {
   247			nameBytes := []byte(t.Name)
   248			if err := binary.Write(&buf, binary.LittleEndian, uint32(len(nameBytes))); err != nil {
   249				return nil, err
   250			}
   251			buf.Write(nameBytes)
   252			buf.WriteByte(t.Dtype)
   253			if err := binary.Write(&buf, binary.LittleEndian, uint32(len(t.Shape))); err != nil {
   254				return nil, err
   255			}
   256			for _, s := range t.Shape {
   257				if err := binary.Write(&buf, binary.LittleEndian, s); err != nil {
   258					return nil, err
   259				}
   260			}
   261			expected := Product(t.Shape) * int64(DtypeSize(t.Dtype))
   262			if int64(len(t.Data)) != expected {
   263				return nil, fmt.Errorf("tensor %s data length %d does not match shape %v and dtype %s", t.Name, len(t.Data), t.Shape, DtypeName(t.Dtype))
   264			}
   265			buf.Write(t.Data)
   266		}
   267	
   268		sum := sha256.Sum256(buf.Bytes())
   269		buf.Write(sum[:])
   270		return buf.Bytes(), nil
   271	}
   272	
   273	func WriteFile(path string, metadata map[string]interface{}, tensors []Tensor) error {
   274		data, err := Build(metadata, tensors)
   275		if err != nil {
   276			return err
   277		}
   278		return os.WriteFile(path, data, 0644)
   279	}
   280	
   281	func (t Tensor) Float64Values() ([]float64, error) {
   282		size := DtypeSize(t.Dtype)
   283		if size == 0 {
   284			return nil, fmt.Errorf("invalid dtype %d", t.Dtype)
   285		}
   286		n := len(t.Data) / size
   287		if len(t.Data)%size != 0 {
   288			return nil, fmt.Errorf("tensor %s data length not multiple of dtype size", t.Name)
   289		}
   290		vals := make([]float64, n)
   291		for i := 0; i < n; i++ {
   292			start := i * size
   293			switch Dtype(t.Dtype) {
   294			case Float32:
   295				bits := binary.LittleEndian.Uint32(t.Data[start : start+4])
   296				vals[i] = float64(math.Float32frombits(bits))
   297			case Float64:
   298				bits := binary.LittleEndian.Uint64(t.Data[start : start+8])
   299				vals[i] = math.Float64frombits(bits)
   300			case Int32:
   301				vals[i] = float64(int32(binary.LittleEndian.Uint32(t.Data[start : start+4])))
   302			case Int64:
   303				vals[i] = float64(int64(binary.LittleEndian.Uint64(t.Data[start : start+8])))
   304			default:
   305				return nil, fmt.Errorf("invalid dtype %d", t.Dtype)
   306			}
   307		}
   308		return vals, nil
   309	}
   310	
   311	func EncodeFloat64Values(vals []float64, dtype uint8) ([]byte, error) {
   312		var buf bytes.Buffer
   313		switch Dtype(dtype) {
   314		case Float32:
   315			for _, v := range vals {
   316				if err := binary.Write(&buf, binary.LittleEndian, math.Float32bits(float32(v))); err != nil {
   317					return nil, err
   318				}
   319			}
   320		case Float64:
   321			for _, v := range vals {
   322				if err := binary.Write(&buf, binary.LittleEndian, math.Float64bits(v)); err != nil {
   323					return nil, err
   324				}
   325			}
   326		case Int32:
   327			for _, v := range vals {
   328				if err := binary.Write(&buf, binary.LittleEndian, int32(math.Round(v))); err != nil {
   329					return nil, err
   330				}
   331			}
   332		case Int64:
   333			for _, v := range vals {
   334				if err := binary.Write(&buf, binary.LittleEndian, int64(math.Round(v))); err != nil {
   335					return nil, err
   336				}
   337			}
   338		default:
   339			return nil, fmt.Errorf("invalid dtype %d", dtype)
   340		}
