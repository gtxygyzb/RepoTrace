    19	
    20	func Run() int {
    21		if len(os.Args) < 2 {
    22			outputJSON(map[string]interface{}{"error": "no subcommand provided"})
    23			return 1
    24		}
    25	
    26		switch os.Args[1] {
    27		case "verify-checkpoint":
    28			return runVerifyCheckpoint(os.Args[2:])
    29		case "compare-outputs":
    30			return runCompareOutputs(os.Args[2:])
    31		case "validate-manifest":
    32			return runValidateManifest(os.Args[2:])
    33		case "audit-lineage":
    34			return runAuditLineage(os.Args[2:])
    35		case "generate-report":
    36			return runGenerateReport(os.Args[2:])
    37		case "merge-checkpoints":
    38			return runMergeCheckpoints(os.Args[2:])
    39		case "drift-analysis":
    40			return runDriftAnalysis(os.Args[2:])
    41		default:
    42			outputJSON(map[string]interface{}{"error": fmt.Sprintf("unknown subcommand: %s", os.Args[1])})
    43			return 1
    44		}
    45	}
    46	
    47	func runVerifyCheckpoint(args []string) int {
    48		if len(args) != 1 {
    49			outputJSON(map[string]interface{}{"error": "usage: repro-verify verify-checkpoint <file>"})
    50			return 1
    51		}
    52	
    53		if _, err := os.ReadFile(args[0]); err != nil {
    54			outputJSON(map[string]interface{}{"error": err.Error()})
    55			return 1
    56		}
    57	
    58		cp, err := mlck.ParseFile(args[0])
    59		if err != nil {
    60			outputJSON(map[string]interface{}{
    61				"valid": false,
    62				"error": err.Error(),
    63			})
    64			return 1
    65		}
    66	
    67		metadata := cp.Metadata
    68		if metadata == nil {
    69			metadata = map[string]interface{}{}
    70		}
    71		tensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))
    72		for _, t := range cp.Tensors {
    73			tensors = append(tensors, t.Info())
    74		}
    75	
    76		outputJSON(map[string]interface{}{
    77			"valid":          true,
    78			"format_version": int(cp.Version),
    79			"num_tensors":    len(cp.Tensors),
    80			"metadata":       metadata,
    81			"tensors":        tensors,
    82			"file_checksum":  cp.FileChecksum,
    83		})
    84		return 0
    85	}
    86	
    87	func runCompareOutputs(args []string) int {
    88		fs := flag.NewFlagSet("compare-outputs", flag.ContinueOnError)
    89		fs.SetOutput(io.Discard)
    90		atol := fs.Float64("atol", 1e-7, "absolute tolerance")
    91		rtol := fs.Float64("rtol", 1e-5, "relative tolerance")
    92		mode := fs.String("mode", "strict", "comparison mode")
    93	
    94		pos, err := parseMixedArgs(fs, args)
    95		if err != nil {
    96			outputJSON(map[string]interface{}{"error": err.Error()})
    97			return 1
    98		}
    99		if len(pos) != 2 {
   100			outputJSON(map[string]interface{}{"error": "usage: repro-verify compare-outputs <file1> <file2> [flags]"})
   101			return 1
   102		}
   103	
   104		c1, err := mlck.ParseFile(pos[0])
   105		if err != nil {
   106			outputJSON(map[string]interface{}{"error": fmt.Sprintf("file1: %v", err)})
   107			return 1
   108		}
   109	
   110		c2, err := mlck.ParseFile(pos[1])
   111		if err != nil {
   112			outputJSON(map[string]interface{}{"error": fmt.Sprintf("file2: %v", err)})
   113			return 1
   114		}
   115	
   116		res, err := compare.Compare(c1, c2, *mode, *atol, *rtol)
   117		if err != nil {
   118			outputJSON(map[string]interface{}{"error": err.Error()})
   119			return 1
   120		}
   121	
   122		outputJSON(res)
   123		if res.Match {
   124			return 0
   125		}
   126		return 1
   127	}
