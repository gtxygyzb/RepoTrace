    29	// Analyze remains available for callers that do not need a top-k restriction.
    30	func Analyze(files []string) (*Result, error) {
    31		return AnalyzeWithTopK(files, 0)
    32	}
    33	
    34	// AnalyzeWithTopK analyzes drift and optionally restricts the returned tensor
    35	// list to the N tensors with the lowest stability scores. When topK > 0 the
    36	// result includes a top_k field set to the requested N, even if fewer tensors
    37	// are returned.
    38	func AnalyzeWithTopK(files []string, topK int) (*Result, error) {
    39		if len(files) < 2 {
    40			return nil, fmt.Errorf("at least 2 input files required")
    41		}
    42	
    43		cps := make([]*mlck.Checkpoint, len(files))
    44		for i, f := range files {
    45			cp, err := mlck.ParseFile(f)
    46			if err != nil {
    47				return nil, fmt.Errorf("file %s: %v", f, err)
    48			}
    49			cps[i] = cp
    50		}
    51	
    52		var allNames []string
    53		seen := map[string]bool{}
    54		for _, cp := range cps {
    55			for _, t := range cp.Tensors {
    56				if !seen[t.Name] {
    57					seen[t.Name] = true
    58					allNames = append(allNames, t.Name)
    59				}
    60			}
    61		}
    62		sort.Strings(allNames)
    63	
    64		skipped := []string{}
    65		tensors := []TensorResult{}
    66		converging := 0
    67		diverging := 0
    68	
    69		for _, name := range allNames {
    70			ok := true
    71			var shape []uint32
    72			for _, cp := range cps {
    73				t, exists := tensorByName(cp, name)
    74				if !exists {
    75					ok = false
    76					break
    77				}
    78				if shape == nil {
    79					shape = t.Shape
    80				} else if !shapesEqual(shape, t.Shape) {
    81					ok = false
    82					break
    83				}
    84			}
    85			if !ok {
    86				skipped = append(skipped, name)
    87				continue
    88			}
    89	
    90			steps := make([]float64, len(cps)-1)
    91			for i := 0; i < len(steps); i++ {
    92				v1, err := tensorData(cps[i], name)
    93				if err != nil {
    94					return nil, err
    95				}
    96				v2, err := tensorData(cps[i+1], name)
    97				if err != nil {
    98					return nil, err
    99				}
   100				n := len(v1)
   101				if n == 0 {
   102					steps[i] = 0
   103					continue
   104				}
   105				var sum float64
   106				for j := 0; j < n; j++ {
   107					sum += math.Abs(v1[j] - v2[j])
   108				}
   109				steps[i] = sum / float64(n)
   110			}
   111	
   112			mean := meanFloat64(steps)
   113			max := maxFloat64(steps)
   114			convergence := classifyConvergence(steps)
   115			stability := 1.0
   116			if max != 0 {
   117				stability = 1.0 - steps[len(steps)-1]/max
   118				if stability < 0 {
   119					stability = 0
   120				} else if stability > 1 {
   121					stability = 1
   122				}
   123			}
   124	
   125			tensors = append(tensors, TensorResult{
   126				Name:           name,
   127				StepChanges:    steps,
   128				MeanChange:     mean,
   129				MaxChange:      max,
   130				Convergence:    convergence,
   131				StabilityScore: stability,
   132			})
   133	
   134			if convergence == "converging" {
   135				converging++
   136			} else if convergence == "diverging" {
   137				diverging++
   138			}
   139		}
   140	
   141		overall := "mixed"
   142		if converging > len(tensors)/2 {
   143			overall = "converging"
   144		} else if diverging > len(tensors)/2 {
   145			overall = "diverging"
   146		}
   147	
   148		sort.Strings(skipped)
   149		sort.Slice(tensors, func(i, j int) bool {
   150			return tensors[i].Name < tensors[j].Name
   151		})
   152	
   153		result := &Result{
   154			NumSnapshots:       len(files),
   155			NumAnalyzedTensors: len(tensors),
   156			SkippedTensors:     skipped,
   157			Tensors:            tensors,
   158			OverallConvergence: overall,
   159		}
   160		applyTopK(result, topK)
   161		return result, nil
   162	}
   163	
   164	func applyTopK(result *Result, topK int) {
   165		if topK <= 0 {
   166			return
   167		}
   168	
   169		requested := topK
   170		sort.SliceStable(result.Tensors, func(i, j int) bool {
   171			if result.Tensors[i].StabilityScore != result.Tensors[j].StabilityScore {
   172				return result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore
   173			}
   174			return result.Tensors[i].Name < result.Tensors[j].Name
   175		})
   176		if requested < len(result.Tensors) {
   177			result.Tensors = result.Tensors[:requested]
   178		}
   179		result.TopK = &requested
   180	}
