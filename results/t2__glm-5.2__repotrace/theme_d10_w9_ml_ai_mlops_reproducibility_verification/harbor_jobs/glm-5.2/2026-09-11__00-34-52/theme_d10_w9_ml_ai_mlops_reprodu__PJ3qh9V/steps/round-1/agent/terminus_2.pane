[?2004l     1	package drift
     2	
     3	import (
     4		"fmt"
     5		"math"
     6	
     7		"repro-verify/internal/mlck"
     8	)
     9	
    10	type TensorResult struct {
    11		Name           string    `json:"name"`
    12		StepChanges    []float64 `json:"step_changes"`
    13		MeanChange     float64   `json:"mean_change"`
    14		MaxChange      float64   `json:"max_change"`
    15		Convergence    string    `json:"convergence"`
    16		StabilityScore float64   `json:"stability_score"`
    17	}
    18	
    19	type Result struct {
    20		NumSnapshots       int            `json:"num_snapshots"`
    21		NumAnalyzedTensors int            `json:"num_analyzed_tensors"`
    22		SkippedTensors     []string       `json:"skipped_tensors"`
    23		Tensors            []TensorResult `json:"tensors"`
    24		OverallConvergence string         `json:"overall_convergence"`
    25	}
    26	
    27	func Analyze(files []string) (*Result, error) {
    28		if len(files) < 2 {
    29			return nil, fmt.Errorf("at least 2 input files required")
    30		}
    31	
    32		cps := make([]*mlck.Checkpoint, len(files))
    33		for i, f := range files {
    34			cp, err := mlck.ParseFile(f)
    35			if err != nil {
    36				return nil, fmt.Errorf("file %s: %v", f, err)
    37			}
    38			cps[i] = cp
    39		}
    40	
    41		var allNames []string
    42		seen := map[string]bool{}
    43		for _, cp := range cps {
    44			for _, t := range cp.Tensors {
    45				if !seen[t.Name] {
    46					seen[t.Name] = true
    47					allNames = append(allNames, t.Name)
    48				}
    49			}
    50		}
    51	
    52		skipped := []string{}
    53		tensors := []TensorResult{}
    54		converging := 0
    55		diverging := 0
    56	
    57		for _, name := range allNames {
    58			ok := true
    59			var shape []uint32
    60			for _, cp := range cps {
    61				t, exists := tensorByName(cp, name)
    62				if !exists {
    63					ok = false
    64					break
    65				}
    66				if shape == nil {
    67					shape = t.Shape
    68				} else if !shapesEqual(shape, t.Shape) {
    69					ok = false
    70					break
    71				}
    72			}
    73			if !ok {
    74				skipped = append(skipped, name)
    75				continue
    76			}
    77	
    78			steps := make([]float64, len(cps)-1)
    79			for i := 0; i < len(cps)-1; i++ {
    80				t1, _ := tensorByName(cps[i], name)
    81				t2, _ := tensorByName(cps[i+1], name)
    82				v1, err := t1.Float64Values()
    83				if err != nil {
    84					return nil, err
    85				}
    86				v2, err := t2.Float64Values()
    87				if err != nil {
    88					return nil, err
    89				}
    90				n := len(v1)
    91				if n == 0 {
    92					steps[i] = 0
    93					continue
    94				}
    95				var sum float64
    96				for j := 0; j < n; j++ {
    97					sum += math.Abs(v1[j] - v2[j])
    98				}
    99				steps[i] = sum / float64(n)
   100			}
   101	
   102			mean := meanFloat64(steps)
   103			max := maxFloat64(steps)
   104			convergence := classifyConvergence(steps)
   105			stability := 1.0
   106			if steps[0] != 0 {
   107				stability = 1.0 - steps[len(steps)-1]/steps[0]
   108				if stability < 0 {
   109					stability = 0
   110				} else if stability > 1 {
   111					stability = 1
   112				}
   113			}
   114	
   115			tensors = append(tensors, TensorResult{
   116				Name:           name,
   117				StepChanges:    steps,
   118				MeanChange:     mean,
   119				MaxChange:      max,
   120				Convergence:    convergence,
   121				StabilityScore: stability,
   122			})
   123	
   124			if convergence == "converging" {
   125				converging++
   126			} else if convergence == "diverging" {
   127				diverging++
   128			}
   129		}
   130	
   131		overall := "mixed"
   132		if converging > len(tensors)/2 {
   133			overall = "converging"
   134		} else if diverging > len(tensors)/2 {
   135			overall = "diverging"
   136		}
   137	
   138		return &Result{
   139			NumSnapshots:       len(files),
   140			NumAnalyzedTensors: len(tensors),
   141			SkippedTensors:     skipped,
   142			Tensors:            tensors,
   143			OverallConvergence: overall,
   144		}, nil
   145	}
   146	
   147	func tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {
   148		for _, t := range cp.Tensors {
   149			if t.Name == name {
   150				return t, true
   151			}
   152		}
   153		return mlck.Tensor{}, false
   154	}
   155	
   156	func shapesEqual(a, b []uint32) bool {
   157		if len(a) != len(b) {
   158			return false
   159		}
   160		for i := range a {
   161			if a[i] != b[i] {
   162				return false
   163			}
   164		}
   165		return true
   166	}
   167	
   168	func meanFloat64(xs []float64) float64 {
   169		if len(xs) == 0 {
   170			return 0
   171		}
   172		var sum float64
   173		for _, x := range xs {
   174			sum += x
   175		}
   176		return sum / float64(len(xs))
   177	}
   178	
   179	func maxFloat64(xs []float64) float64 {
   180		if len(xs) == 0 {
   181			return 0
   182		}
   183		m := xs[0]
   184		for _, x := range xs[1:] {
   185			if x > m {
   186				m = x
   187			}
   188		}
   189		return m
   190	}
   191	
   192	func classifyConvergence(steps []float64) string {
   193		if len(steps) <= 1 {
   194			return "converging"
   195		}
   196		decreasing := true
   197		increasing := true
   198		for i := 1; i < len(steps); i++ {
   199			if steps[i] >= steps[i-1] {
   200				decreasing = false
   201			}
   202			if steps[i] <= steps[i-1] {
   203				increasing = false
   204			}
   205		}
   206		if decreasing {
   207			return "converging"
   208		}
   209		if increasing {
   210			return "diverging"
   211		}
   212		return "oscillating"
   213	}
[?2004hroot@n30009:/app# nl -ba internal/lineage/lineage.go | sed -n '1,260p'
[?2004l     1	package lineage
     2	
     3	import (
     4		"encoding/json"
     5		"fmt"
     6		"os"
     7		"strings"
     8		"time"
     9	)
    10	
    11	type Experiment struct {
    12		ID             string   `json:"id"`
    13		Name           string   `json:"name"`
    14		Parents        []string `json:"parents"`
    15		CheckpointHash string   `json:"checkpoint_hash"`
    16		Timestamp      string   `json:"timestamp"`
    17	}
    18	
    19	type Input struct {
    20		Experiments []Experiment `json:"experiments"`
    21	}
    22	
    23	type Result struct {
    24		Valid            bool     `json:"valid"`
    25		NumExperiments   int      `json:"num_experiments"`
    26		NumRoots         int      `json:"num_roots"`
    27		NumLeaves        int      `json:"num_leaves"`
    28		MaxDepth         int      `json:"max_depth"`
    29		TopologicalOrder []string `json:"topological_order"`
    30		Errors           []string `json:"errors,omitempty"`
    31	}
    32	
    33	func Audit(path string) *Result {
    34		data, err := os.ReadFile(path)
    35		if err != nil {
    36			return &Result{
    37				Valid:  false,
    38				Errors: []string{fmt.Sprintf("failed to read lineage file: %v", err)},
    39			}
    40		}
    41	
    42		var in Input
    43		if err := json.Unmarshal(data, &in); err != nil {
    44			return &Result{
    45				Valid:  false,
    46				Errors: []string{fmt.Sprintf("failed to parse lineage JSON: %v", err)},
    47			}
    48		}
    49	
    50		exps := in.Experiments
    51		result := &Result{
    52			Valid:            true,
    53			Errors:           []string{},
    54			TopologicalOrder: []string{},
    55		}
    56	
    57		if len(exps) == 0 {
    58			result.TopologicalOrder = []string{}
    59			return result
    60		}
    61	
    62		idSet := make(map[string]int)
    63		ids := make([]string, 0, len(exps))
    64		for i, e := range exps {
    65			if e.ID == "" {
    66				result.Errors = append(result.Errors, fmt.Sprintf("experiment at index %d missing id", i))
    67				continue
    68			}
    69			if _, ok := idSet[e.ID]; ok {
    70				result.Errors = append(result.Errors, fmt.Sprintf("duplicate id: %s", e.ID))
    71			} else {
    72				idSet[e.ID] = i
    73				ids = append(ids, e.ID)
    74			}
    75			if e.CheckpointHash == "" {
    76				result.Errors = append(result.Errors, fmt.Sprintf("empty checkpoint_hash for experiment: %s", e.ID))
    77			}
    78		}
    79	
    80		for _, e := range exps {
    81			if e.ID == "" {
    82				continue
    83			}
    84			for _, p := range e.Parents {
    85				if _, ok := idSet[p]; !ok {
    86					result.Errors = append(result.Errors, fmt.Sprintf("parent reference unresolved: %s -> %s", e.ID, p))
    87				}
    88			}
    89		}
    90	
    91		times := make(map[string]time.Time)
    92		for _, e := range exps {
    93			if e.ID == "" {
    94				continue
    95			}
    96			if e.Timestamp == "" {
    97				result.Errors = append(result.Errors, fmt.Sprintf("missing timestamp for experiment: %s", e.ID))
    98				continue
    99			}
   100			t, err := time.Parse(time.RFC3339, e.Timestamp)
   101			if err != nil {
   102				result.Errors = append(result.Errors, fmt.Sprintf("invalid timestamp for experiment: %s", e.ID))
   103			} else {
   104				times[e.ID] = t
   105			}
   106		}
   107	
   108		if len(result.Errors) == 0 {
   109			if cycle := detectCycle(exps); cycle != nil {
   110				result.Errors = append(result.Errors, fmt.Sprintf("cycle detected involving: %s", strings.Join(cycle, ", ")))
   111			}
   112		}
   113	
   114		if len(result.Errors) == 0 {
   115			for _, e := range exps {
   116				childTime, ok := times[e.ID]
   117				if !ok {
   118					continue
   119				}
   120				for _, p := range e.Parents {
   121					parentTime, ok := times[p]
   122					if !ok {
   123						continue
   124					}
   125					if !childTime.After(parentTime) {
   126						result.Errors = append(result.Errors, fmt.Sprintf("timestamp violation: %s (%s) has parent %s (%s)", e.ID, childTime.Format("2006-01-02"), p, parentTime.Format("2006-01-02")))
   127					}
   128				}
   129			}
   130		}
   131	
   132		if len(result.Errors) > 0 {
   133			result.Valid = false
   134			result.TopologicalOrder = nil
   135			return result
   136		}
   137	
   138		children := make(map[string][]string)
   139		for _, e := range exps {
   140			for _, p := range e.Parents {
   141				children[p] = append(children[p], e.ID)
   142			}
   143		}
   144	
   145		roots := make([]string, 0)
   146		leaves := make([]string, 0)
   147		for _, e := range exps {
   148			if len(e.Parents) == 0 {
   149				roots = append(roots, e.ID)
   150			}
   151			if len(children[e.ID]) == 0 {
   152				leaves = append(leaves, e.ID)
   153			}
   154		}
   155	
   156		visited := make(map[string]bool)
   157		var post []string
   158		var dfs func(id string)
   159		dfs = func(id string) {
   160			visited[id] = true
   161			for _, child := range children[id] {
   162				if !visited[child] {
   163					dfs(child)
   164				}
   165			}
   166			post = append(post, id)
   167		}
   168		for _, e := range exps {
   169			if !visited[e.ID] {
   170				dfs(e.ID)
   171			}
   172		}
   173		topo := make([]string, len(post))
   174		for i := range post {
   175			topo[i] = post[len(post)-1-i]
   176		}
   177	
   178		maxDepth := 0
   179		var depthDFS func(id string, depth int)
   180		depthDFS = func(id string, depth int) {
   181			if depth > maxDepth {
   182				maxDepth = depth
   183			}
   184			for _, child := range children[id] {
   185				depthDFS(child, depth+1)
   186			}
   187		}
   188		for _, r := range roots {
   189			depthDFS(r, 1)
   190		}
   191	
   192		result.NumExperiments = len(exps)
   193		result.NumRoots = len(roots)
   194		result.NumLeaves = len(leaves)
   195		result.MaxDepth = maxDepth
   196		result.TopologicalOrder = topo
   197		return result
   198	}
   199	
   200	func detectCycle(exps []Experiment) []string {
   201		adj := make(map[string][]string)
   202		for _, e := range exps {
   203			for _, p := range e.Parents {
   204				adj[p] = append(adj[p], e.ID)
   205			}
   206		}
   207	
   208		state := make(map[string]int)
   209		var stack []string
   210		var cycle []string
   211	
   212		var dfs func(id string) bool
   213		dfs = func(id string) bool {
   214			state[id] = 1
   215			stack = append(stack, id)
   216			for _, child := range adj[id] {
   217				if state[child] == 1 {
   218					idx := -1
   219					for i := len(stack) - 1; i >= 0; i-- {
   220						if stack[i] == child {
   221							idx = i
   222							break
   223						}
   224					}
   225					if idx >= 0 {
   226						cycle = append([]string{}, stack[idx:]...)
   227						return true
   228					}
   229				}
   230				if state[child] == 0 {
   231					if dfs(child) {
   232						return true
   233					}
   234				}
   235			}
   236			stack = stack[:len(stack)-1]
   237			state[id] = 2
   238			return false
   239		}
   240	
   241		for _, e := range exps {
   242			if state[e.ID] == 0 {
   243				if dfs(e.ID) {
   244					return cycle
   245				}
   246			}
   247		}
   248		return nil
   249	}
