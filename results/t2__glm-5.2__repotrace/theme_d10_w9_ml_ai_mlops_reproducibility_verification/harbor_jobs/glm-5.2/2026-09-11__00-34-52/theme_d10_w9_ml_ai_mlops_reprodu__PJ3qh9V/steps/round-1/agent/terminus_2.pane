    87	func runCompareOutputs(args []string) int {
    88		fs := flag.NewFlagSet("compare-outputs", flag.ContinueOnError)
    89		fs.SetOutput(io.Discard)
    90		atol := fs.Float64("atol", 1e-7, "absolute tolerance")
    91		rtol := fs.Float64("rtol", 1e-5, "relative tolerance")
    92		mode := fs.String("mode", "strict", "comparison mode")
    93		histogram := fs.Bool("histogram", false, "include diff histograms")
    94	
    95		pos, err := parseMixedArgs(fs, args)
    96		if err != nil {
    97			outputJSON(map[string]interface{}{"error": err.Error()})
    98			return 1
    99		}
   100		if len(pos) != 2 {
   101			outputJSON(map[string]interface{}{"error": "usage: repro-verify compare-outputs <file1> <file2> [flags]"})
   102			return 1
   103		}
   104	
   105		c1, err := mlck.ParseFile(pos[0])
   106		if err != nil {
   107			outputJSON(map[string]interface{}{"error": fmt.Sprintf("file1: %v", err)})
   108			return 1
   109		}
   110	
   111		c2, err := mlck.ParseFile(pos[1])
   112		if err != nil {
   113			outputJSON(map[string]interface{}{"error": fmt.Sprintf("file2: %v", err)})
   114			return 1
   115		}
   116	
   117		res, err := compare.Compare(c1, c2, *mode, *atol, *rtol, *histogram)
   118		if err != nil {
   119			outputJSON(map[string]interface{}{"error": err.Error()})
   120			return 1
   121		}
   122	
   123		outputJSON(res)
   124		if res.Match {
   125			return 0
   126		}
   127		return 1
   128	}
