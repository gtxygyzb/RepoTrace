# Update applyTopK signature and body.
s = re.sub(
    r'func applyTopK\(result \*Result, topK int\) \{.*?\n\}',
    '''func applyTopK(result *Result, topK *int) {
\tif topK == nil {
\t\treturn
\t}

\trequested := *topK
\tsort.SliceStable(result.Tensors, func(i, j int) bool {
\t\tif result.Tensors[i].StabilityScore != result.Tensors[j].StabilityScore {
\t\t\treturn result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore
\t\t}
\t\treturn result.Tensors[i].Name < result.Tensors[j].Name
\t})
\tif requested < len(result.Tensors) {
\t\tresult.Tensors = result.Tensors[:requested]
\t}
\tresult.TopK = &requested
}''',
    s,
    count=1,
    flags=re.S,
)

p.write_text(s)

p = Path('internal/app/app.go')
s = p.read_text()
s = re.sub(
    r'func runDriftAnalysis\(args \[\]string\) int \{.*?\n\}\n\nfunc parseMixedArgs',
    '''func runDriftAnalysis(args []string) int {
\tfs := flag.NewFlagSet("drift-analysis", flag.ContinueOnError)
\tfs.SetOutput(io.Discard)

\ttopK := fs.Int("top-k", 0, "number of tensors with the lowest stability scores to include")

\tpos, err := parseMixedArgs(fs, args)
\tif err != nil {
\t\toutputJSON(map[string]interface{}{"error": err.Error()})
\t\treturn 1
\t}
\tif len(pos) < 2 {
\t\toutputJSON(map[string]interface{}{"error": "usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]"})
\t\treturn 1
\t}

\tvar topKPtr *int
\tfs.Visit(func(f *flag.Flag) {
\t\tif f.Name == "top-k" {
\t\t\tv := *topK
\t\t\ttopKPtr = &v
\t\t}
\t})
\tif topKPtr != nil && *topKPtr < 0 {
\t\toutputJSON(map[string]interface{}{"error": "--top-k must be non-negative"})
\t\treturn 1
\t}

\tres, err := drift.AnalyzeWithTopK(pos, topKPtr)
\tif err != nil {
\t\toutputJSON(map[string]interface{}{"error": err.Error()})
\t\treturn 1
\t}
\toutputJSON(res)
\treturn 0
}

func parseMixedArgs''',
    s,
    count=1,
    flags=re.S,
)
p.write_text(s)
