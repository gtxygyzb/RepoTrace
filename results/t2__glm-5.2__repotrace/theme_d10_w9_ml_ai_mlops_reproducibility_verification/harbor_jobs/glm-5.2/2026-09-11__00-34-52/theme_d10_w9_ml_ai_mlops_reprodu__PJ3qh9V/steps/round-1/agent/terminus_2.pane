[?2004lfunc parseTOML(data string) (map[string]interface{}, error) {
	root := map[string]interface{}{}
	var current map[string]interface{} = root
	var currentArray []map[string]interface{}

	lines := strings.Split(data, "\n")
	for lineNum, raw := range lines {
		line := strings.TrimSpace(stripInlineComment(raw))
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}

		if strings.HasPrefix(line, "[[") && strings.HasSuffix(line, "]]") {
			key := strings.TrimSpace(line[2 : len(line)-2])
			parts := strings.Split(key, ".")
			parent := root
			for i := 0; i < len(parts)-1; i++ {
				p := strings.TrimSpace(parts[i])
				next, ok := parent[p]
				if !ok {
					next = map[string]interface{}{}
					parent[p] = next
				}
				parent, ok = next.(map[string]interface{})
				if !ok {
					return nil, fmt.Errorf("line %d: invalid array table path", lineNum+1)
				}
			}
			last := strings.TrimSpace(parts[len(parts)-1])
			arr, ok := parent[last].([]map[string]interface{})
			if !ok {
				arr = []map[string]interface{}{}
			}
			item := map[string]interface{}{}
			arr = append(arr, item)
			parent[last] = arr
			current = item
			currentArray = arr
			continue
		}

		if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
			key := strings.TrimSpace(line[1 : len(line)-1])
			parts := strings.Split(key, ".")
			parent := root
			for i := 0; i < len(parts)-1; i++ {
				p := strings.TrimSpace(parts[i])
				next, ok := parent[p]
				if !ok {
					next = map[string]interface{}{}
					parent[p] = next
				}
				parent, ok = next.(map[string]interface{})
				if !ok {
					return nil, fmt.Errorf("line %d: invalid table path", lineNum+1)
				}
			}
			last := strings.TrimSpace(parts[len(parts)-1])
			tbl, ok := parent[last].(map[string]interface{})
			if !ok {
				tbl = map[string]interface{}{}
				parent[last] = tbl
			}
			current = tbl
			currentArray = nil
			continue
		}

		eq := strings.Index(line, "=")
		if eq < 0 {
			return nil, fmt.Errorf("line %d: expected key = value", lineNum+1)
		}
		keyPath := strings.Split(strings.TrimSpace(line[:eq]), ".")
		valueStr := strings.TrimSpace(line[eq+1:])
		value, err := parseTOMLValue(valueStr)
		if err != nil {
			return nil, fmt.Errorf("line %d: %v", lineNum+1, err)
		}
		_ = currentArray

		parent := current
		for i := 0; i < len(keyPath)-1; i++ {
			part := strings.TrimSpace(keyPath[i])
			if part == "" {
				return nil, fmt.Errorf("line %d: invalid key", lineNum+1)
			}
			next, ok := parent[part]
			if !ok {
				next = map[string]interface{}{}
				parent[part] = next
				parent = next.(map[string]interface{})
			} else {
				parent, ok = next.(map[string]interface{})
				if !ok {
					return nil, fmt.Errorf("line %d: invalid key path", lineNum+1)
				}
			}
		}
		lastKey := strings.TrimSpace(keyPath[len(keyPath)-1])
		if lastKey == "" {
			return nil, fmt.Errorf("line %d: invalid key", lineNum+1)
		}
		parent[lastKey] = value
	}

	return root, nil
}

func stripInlineComment(line string) string {
	var quote byte
	depth := 0
	for i := 0; i < len(line); i++ {
		c := line[i]
		if quote != 0 {
			if c == quote {
				quote = 0
			}
			continue
		}
		switch c {
		case 34, 39:
			quote = c
		case '[', '{':
			depth++
		case ']', '}':
			if depth > 0 {
				depth--
			}
		case '#':
			if depth == 0 {
				return line[:i]
			}
		}
	}
	return line
}

func parseTOMLValue(s string) (interface{}, error) {
	if s == "true" {
		return true, nil
	}
	if s == "false" {
		return false, nil
	}
	if len(s) >= 2 && (s[0] == '"' && s[len(s)-1] == '"' || s[0] == '\'' && s[len(s)-1] == '\'') {
		return s[1 : len(s)-1], nil
	}
