   152	var pythonVersionRegex = regexp.MustCompile(`^\d+\.\d+\.\d+$`)
   153	
   154	func getTable(root map[string]interface{}, key string) map[string]interface{} {
   155		v, ok := root[key]
   156		if !ok {
   157			return nil
   158		}
   159		m, ok := v.(map[string]interface{})
   160		if !ok {
   161			return nil
   162		}
   163		return m
   164	}
   165	
   166	func isNonNegativeInt(v interface{}) bool {
   167		switch x := v.(type) {
   168		case int:
   169			return x >= 0
   170		case int64:
   171			return x >= 0
   172		case float64:
   173			return x == float64(int64(x)) && x >= 0
   174		default:
   175			return false
   176		}
   177	}
   178	
   179	func hasNumericField(m map[string]interface{}) bool {
   180		for _, v := range m {
   181			switch v.(type) {
   182			case int, int64, float64:
   183				return true
   184			}
   185		}
   186		return false
   187	}
   188	
   189	func parseTOML(data string) (map[string]interface{}, error) {
   190		root := map[string]interface{}{}
   191		var current map[string]interface{} = root
   192		var currentArray []map[string]interface{}
   193	
   194		lines := strings.Split(data, "\n")
   195		for lineNum, raw := range lines {
   196			line := strings.TrimSpace(raw)
   197			if line == "" || strings.HasPrefix(line, "#") {
   198				continue
   199			}
   200	
   201			if strings.HasPrefix(line, "[[") && strings.HasSuffix(line, "]]") {
   202				key := strings.TrimSpace(line[2 : len(line)-2])
   203				parts := strings.Split(key, ".")
   204				parent := root
   205				for i := 0; i < len(parts)-1; i++ {
   206					p := strings.TrimSpace(parts[i])
   207					next, ok := parent[p]
   208					if !ok {
   209						next = map[string]interface{}{}
   210						parent[p] = next
   211					}
   212					parent, ok = next.(map[string]interface{})
   213					if !ok {
   214						return nil, fmt.Errorf("line %d: invalid array table path", lineNum+1)
   215					}
   216				}
   217				last := strings.TrimSpace(parts[len(parts)-1])
   218				arr, ok := parent[last].([]map[string]interface{})
   219				if !ok {
   220					arr = []map[string]interface{}{}
   221				}
   222				item := map[string]interface{}{}
   223				arr = append(arr, item)
   224				parent[last] = arr
   225				current = item
   226				currentArray = arr
   227				continue
   228			}
   229	
   230			if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
   231				key := strings.TrimSpace(line[1 : len(line)-1])
   232				parts := strings.Split(key, ".")
   233				parent := root
   234				for i := 0; i < len(parts)-1; i++ {
   235					p := strings.TrimSpace(parts[i])
   236					next, ok := parent[p]
   237					if !ok {
   238						next = map[string]interface{}{}
   239						parent[p] = next
   240					}
   241					parent, ok = next.(map[string]interface{})
   242					if !ok {
   243						return nil, fmt.Errorf("line %d: invalid table path", lineNum+1)
   244					}
   245				}
   246				last := strings.TrimSpace(parts[len(parts)-1])
   247				tbl, ok := parent[last].(map[string]interface{})
   248				if !ok {
   249					tbl = map[string]interface{}{}
   250					parent[last] = tbl
   251				}
   252				current = tbl
   253				currentArray = nil
   254				continue
   255			}
   256	
   257			eq := strings.Index(line, "=")
   258			if eq < 0 {
   259				return nil, fmt.Errorf("line %d: expected key = value", lineNum+1)
   260			}
