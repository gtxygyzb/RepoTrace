   227	func classifyConvergence(steps []float64) string {
   228		if len(steps) <= 1 {
   229			return "converging"
   230		}
   231		nonIncreasing := true
   232		nonDecreasing := true
   233		hasIncrease := false
   234		for i := 1; i < len(steps); i++ {
   235			if steps[i] > steps[i-1] {
   236				nonIncreasing = false
   237				hasIncrease = true
   238			}
   239			if steps[i] < steps[i-1] {
   240				nonDecreasing = false
   241			}
   242		}
   243		if nonIncreasing {
   244			return "converging"
   245		}
   246		if nonDecreasing && hasIncrease {
   247			return "diverging"
   248		}
   249		return "oscillating"
   250	}
