[?2004lpython3 - <<'PY'
import struct, json, hashlib

def write_mlck(path, metadata, tensors, bad_footer=False):
    meta = json.dumps(metadata).encode()
    body = b'MLCK' + struct.pack('<III', 1, len(tensors), len(meta)) + meta
    for name, dtype, shape, data in tensors:
        nb = name.encode()
        body += struct.pack('<I', len(nb)) + nb
        body += struct.pack('<B', dtype)
        body += struct.pack('<I', len(shape))
        for s in shape:
            body += struct.pack('<I', s)
        body += data
    footer = hashlib.sha256(body).digest()
    if bad_footer:
        footer = b'\x00' * 32
    with open(path, 'wb') as f:
        f.write(body + footer)

def f32(vals):
    return b''.join(struct.pack('<f', v) for v in vals)
def f64(vals):
    return b''.join(struct.pack('<d', v) for v in vals)

write_mlck('/tmp/cp1.bin', {'name':'test','framework':'pytorch','seed':42}, [('conv1.weight',0,[2,2],f32([1,2,3,4])),('fc.weight',1,[2,2],f64([1,2,3,4]))])
write_mlck('/tmp/cp2.bin', {'name':'test','framework':'pytorch','seed':42}, [('conv1.weight',0,[2,2],f32([1,2,3,4])),('fc.weight',1,[2,2],f64([1,2,3,4]))])
write_mlck('/tmp/cp3.bin', {'name':'test','framework':'pytorch','seed':42}, [('conv1.weight',0,[2,2],f32([1,2,3,4])),('extra',2,[2],struct.pack('<ii',5,6))])
write_mlck('/tmp/bad.bin', {'name':'bad'}, [('conv1.weight',0,[2,2],f32([1,2,3,4]))], bad_footer=True)
open('/tmp/badmanifest.toml','w').write('not valid toml =
')
open('/tmp/badlineage.json','w').write(json.dumps({"experiments":[{"id":"a","parents":["b"],"checkpoint_hash":"","timestamp":"2024-01-01T00:00:00Z"},{"id":"b","parents":["a"],"checkpoint_hash":"x","timestamp":"2024-01-02T00:00:00Z"}]}))
