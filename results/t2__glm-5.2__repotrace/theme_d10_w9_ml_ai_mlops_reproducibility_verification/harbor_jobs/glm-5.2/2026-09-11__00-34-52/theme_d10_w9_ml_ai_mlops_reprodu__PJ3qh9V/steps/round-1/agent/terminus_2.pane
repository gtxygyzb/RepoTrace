    75			if !ok {
    76				skipped = append(skipped, name)
    77				continue
    78			}
    79	
    80			steps := make([]float64, len(cps)-1)
    81			for i := 0; i < len(cps)-1; i++ {
    82				t1, _ := tensorByName(cps[i], name)
    83				t2, _ := tensorByName(cps[i+1], name)
    84				v1, err := t1.Float64Values()
    85				if err != nil {
    86					return nil, err
    87				}
    88				v2, err := t2.Float64Values()
    89				if err != nil {
    90					return nil, err
    91				}
    92				n := len(v1)
    93				if n == 0 {
    94					steps[i] = 0
    95					continue
    96				}
    97				var sum float64
    98				for j := 0; j < n; j++ {
    99					sum += math.Abs(v1[j] - v2[j])
   100				}
   101				steps[i] = sum / float64(n)
   102			}
   103	
   104			mean := meanFloat64(steps)
   105			max := maxFloat64(steps)
   106			convergence := classifyConvergence(steps)
   107			stability := 1.0
   108			if steps[0] != 0 {
   109				stability = 1.0 - steps[len(steps)-1]/steps[0]
   110				if stability < 0 {
   111					stability = 0
   112				} else if stability > 1 {
   113					stability = 1
   114				}
   115			}
   116	
   117			tensors = append(tensors, TensorResult{
   118				Name:           name,
   119				StepChanges:    steps,
   120				MeanChange:     mean,
   121				MaxChange:      max,
   122				Convergence:    convergence,
   123				StabilityScore: stability,
   124			})
   125	
   126			if convergence == "converging" {
   127				converging++
   128			} else if convergence == "diverging" {
   129				diverging++
   130			}
   131		}
   132	
   133		overall := "mixed"
   134		if converging > len(tensors)/2 {
   135			overall = "converging"
   136		} else if diverging > len(tensors)/2 {
   137			overall = "diverging"
   138		}
   139	
   140		sort.Strings(skipped)
   141		sort.Slice(tensors, func(i, j int) bool {
   142			return tensors[i].Name < tensors[j].Name
   143		})
   144	
   145		return &Result{
   146			NumSnapshots:       len(files),
   147			NumAnalyzedTensors: len(tensors),
   148			SkippedTensors:     skipped,
   149			Tensors:            tensors,
   150			OverallConvergence: overall,
   151		}, nil
   152	}
   153	
   154	func tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {
   155		for _, t := range cp.Tensors {
   156			if t.Name == name {
   157				return t, true
   158			}
   159		}
   160		return mlck.Tensor{}, false
   161	}
   162	
   163	func shapesEqual(a, b []uint32) bool {
   164		if len(a) != len(b) {
   165			return false
   166		}
   167		for i := range a {
   168			if a[i] != b[i] {
   169				return false
   170			}
   171		}
   172		return true
   173	}
   174	
   175	func meanFloat64(xs []float64) float64 {
   176		if len(xs) == 0 {
   177			return 0
   178		}
   179		var sum float64
   180		for _, x := range xs {
   181			sum += x
   182		}
   183		return sum / float64(len(xs))
   184	}
   185	
   186	func maxFloat64(xs []float64) float64 {
   187		if len(xs) == 0 {
   188			return 0
   189		}
   190		m := xs[0]
   191		for _, x := range xs[1:] {
   192			if x > m {
   193				m = x
   194			}
   195		}
   196		return m
   197	}
   198	
   199	func classifyConvergence(steps []float64) string {
   200		if len(steps) <= 1 {
   201			return "converging"
   202		}
   203		decreasing := true
   204		increasing := true
   205		for i := 1; i < len(steps); i++ {
   206			if steps[i] >= steps[i-1] {
   207				decreasing = false
   208			}
   209			if steps[i] <= steps[i-1] {
   210				increasing = false
   211			}
   212		}
   213		if decreasing {
   214			return "converging"
   215		}
   216		if increasing {
   217			return "diverging"
   218		}
   219		return "oscillating"
   220	}
