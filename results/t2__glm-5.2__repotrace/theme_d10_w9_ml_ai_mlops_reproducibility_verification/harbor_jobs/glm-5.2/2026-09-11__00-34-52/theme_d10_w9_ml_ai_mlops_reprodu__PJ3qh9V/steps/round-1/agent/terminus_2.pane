     2	
     3	import (
     4		"fmt"
     5		"math"
     6		"sort"
     7	
     8		"repro-verify/internal/mlck"
     9	)
    10	
    11	type TensorResult struct {
    12		Name           string    `json:"name"`
    13		StepChanges    []float64 `json:"step_changes"`
    14		MeanChange     float64   `json:"mean_change"`
    15		MaxChange      float64   `json:"max_change"`
    16		Convergence    string    `json:"convergence"`
    17		StabilityScore float64   `json:"stability_score"`
    18	}
    19	
    20	type Result struct {
    21		NumSnapshots       int            `json:"num_snapshots"`
    22		NumAnalyzedTensors int            `json:"num_analyzed_tensors"`
    23		SkippedTensors     []string       `json:"skipped_tensors"`
    24		Tensors            []TensorResult `json:"tensors"`
    25		OverallConvergence string         `json:"overall_convergence"`
    26	}
    27	
    28	func Analyze(files []string) (*Result, error) {
    29		if len(files) < 2 {
    30			return nil, fmt.Errorf("at least 2 input files required")
    31		}
    32	
    33		cps := make([]*mlck.Checkpoint, len(files))
    34		for i, f := range files {
    35			cp, err := mlck.ParseFile(f)
    36			if err != nil {
    37				return nil, fmt.Errorf("file %s: %v", f, err)
    38			}
    39			cps[i] = cp
    40		}
    41	
    42		var allNames []string
    43		seen := map[string]bool{}
    44		for _, cp := range cps {
    45			for _, t := range cp.Tensors {
    46				if !seen[t.Name] {
    47					seen[t.Name] = true
    48					allNames = append(allNames, t.Name)
    49				}
    50			}
    51		}
    52		sort.Strings(allNames)
    53	
    54		skipped := []string{}
    55		tensors := []TensorResult{}
    56		converging := 0
    57		diverging := 0
    58	
    59		for _, name := range allNames {
    60			ok := true
    61			var shape []uint32
    62			for _, cp := range cps {
    63				t, exists := tensorByName(cp, name)
    64				if !exists {
    65					ok = false
    66					break
    67				}
    68				if shape == nil {
    69					shape = t.Shape
    70				} else if !shapesEqual(shape, t.Shape) {
    71					ok = false
    72					break
    73				}
    74			}
    75			if !ok {
    76				skipped = append(skipped, name)
    77				continue
    78			}
    79	
    80			steps := make([]float64, len(cps)-1)
    81			for i := 0; i < len(cps)-1; i++ {
    82				t1, _ := tensorByName(cps[i], name)
    83				t2, _ := tensorByName(cps[i+1], name)
    84				v1, err := t1.Float64Values()
    85				if err != nil {
    86					return nil, err
    87				}
    88				v2, err := t2.Float64Values()
    89				if err != nil {
    90					return nil, err
    91				}
    92				n := len(v1)
    93				if n == 0 {
    94					steps[i] = 0
    95					continue
    96				}
    97				var sum float64
    98				for j := 0; j < n; j++ {
    99					sum += math.Abs(v1[j] - v2[j])
   100				}
   101				steps[i] = sum / float64(n)
   102			}
   103	
   104			mean := meanFloat64(steps)
   105			max := maxFloat64(steps)
   106			convergence := classifyConvergence(steps)
   107			stability := 1.0
   108			if steps[0] != 0 {
   109				stability = 1.0 - steps[len(steps)-1]/steps[0]
   110				if stability < 0 {
   111					stability = 0
   112				} else if stability > 1 {
   113					stability = 1
   114				}
   115			}
   116	
   117			tensors = append(tensors, TensorResult{
   118				Name:           name,
   119				StepChanges:    steps,
   120				MeanChange:     mean,
   121				MaxChange:      max,
   122				Convergence:    convergence,
   123				StabilityScore: stability,
   124			})
   125	
   126			if convergence == "converging" {
   127				converging++
   128			} else if convergence == "diverging" {
   129				diverging++
   130			}
   131		}
   132	
   133		overall := "mixed"
   134		if converging > len(tensors)/2 {
   135			overall = "converging"
   136		} else if diverging > len(tensors)/2 {
   137			overall = "diverging"
   138		}
   139	
   140		sort.Strings(skipped)
   141		sort.Slice(tensors, func(i, j int) bool {
   142			return tensors[i].Name < tensors[j].Name
   143		})
   144	
   145		return &Result{
   146			NumSnapshots:       len(files),
   147			NumAnalyzedTensors: len(tensors),
   148			SkippedTensors:     skipped,
   149			Tensors:            tensors,
   150			OverallConvergence: overall,
