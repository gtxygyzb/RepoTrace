     9	
    10	type TensorResult struct {
    11		Name          string  `json:"name"`
    12		Match         bool    `json:"match"`
    13		MaxAbsDiff    float64 `json:"max_abs_diff"`
    14		MaxRelDiff    float64 `json:"max_rel_diff"`
    15		NumMismatches int     `json:"num_mismatches"`
    16		TotalElements int     `json:"total_elements"`
    17	}
    18	
    19	type Result struct {
    20		Match          bool           `json:"match"`
    21		Mode           string         `json:"mode"`
    22		Atol           float64        `json:"atol"`
    23		Rtol           float64        `json:"rtol"`
    24		TensorResults  []TensorResult `json:"tensor_results"`
    25		MissingInFile1 []string       `json:"missing_in_file1"`
    26		MissingInFile2 []string       `json:"missing_in_file2"`
    27		Error          string         `json:"error,omitempty"`
    28	}
    29	
    30	func Compare(c1, c2 *mlck.Checkpoint, mode string, atol, rtol float64) (*Result, error) {
    31		if mode != "strict" && mode != "relaxed" {
    32			return nil, fmt.Errorf("invalid mode %q", mode)
    33		}
    34	
    35		result := &Result{
    36			Match:          true,
    37			Mode:           mode,
    38			Atol:           atol,
    39			Rtol:           rtol,
    40			TensorResults:  []TensorResult{},
    41			MissingInFile1: []string{},
    42			MissingInFile2: []string{},
    43		}
    44	
    45		map2 := make(map[string]mlck.Tensor)
    46		for _, t := range c2.Tensors {
    47			map2[t.Name] = t
    48		}
    49		map1 := make(map[string]mlck.Tensor)
    50		for _, t := range c1.Tensors {
    51			map1[t.Name] = t
    52		}
    53	
    54		for _, t1 := range c1.Tensors {
    55			t2, ok := map2[t1.Name]
    56			if !ok {
    57				result.MissingInFile2 = append(result.MissingInFile2, t1.Name)
    58				continue
    59			}
    60			tr := compareTensors(t1, t2, mode, atol, rtol)
    61			result.TensorResults = append(result.TensorResults, tr)
    62			if !tr.Match {
    63				result.Match = false
    64			}
    65		}
    66	
    67		for _, t := range c2.Tensors {
    68			if _, ok := map1[t.Name]; !ok {
    69				result.MissingInFile1 = append(result.MissingInFile1, t.Name)
    70			}
    71		}
    72	
    73		if len(result.MissingInFile1) > 0 || len(result.MissingInFile2) > 0 {
    74			result.Match = false
    75		}
    76	
    77		return result, nil
    78	}
    79	
    80	func compareTensors(t1, t2 mlck.Tensor, mode string, atol, rtol float64) TensorResult {
    81		total := int(mlck.Product(t1.Shape))
    82		tr := TensorResult{
    83			Name:          t1.Name,
    84			Match:         true,
    85			MaxAbsDiff:    0,
    86			MaxRelDiff:    0,
    87			NumMismatches: 0,
    88			TotalElements: total,
    89		}
    90	
    91		if !shapesEqual(t1.Shape, t2.Shape) {
    92			tr.Match = false
    93			tr.NumMismatches = total
    94			return tr
    95		}
    96	
    97		if total == 0 {
    98			return tr
    99		}
   100	
   101		vals1, err := t1.Float64Values()
   102		if err != nil {
   103			tr.Match = false
   104			tr.NumMismatches = total
   105			return tr
   106		}
   107		vals2, err := t2.Float64Values()
   108		if err != nil {
   109			tr.Match = false
   110			tr.NumMismatches = total
   111			return tr
   112		}
   113	
   114		threshold := int(math.Floor(float64(total) * 0.001))
   115		for i := 0; i < total; i++ {
   116			a := vals1[i]
   117			b := vals2[i]
   118			diff := math.Abs(a - b)
   119			if diff > tr.MaxAbsDiff {
   120				tr.MaxAbsDiff = diff
   121			}
   122			var rel float64
   123			if math.Abs(b) > 0 {
   124				rel = diff / math.Abs(b)
   125			} else if diff > 0 {
   126				rel = diff
   127			}
   128			if rel > tr.MaxRelDiff {
   129				tr.MaxRelDiff = rel
   130			}
   131			if diff > atol+rtol*math.Abs(b) {
   132				tr.NumMismatches++
   133			}
   134		}
   135	
   136		switch mode {
   137		case "strict":
   138			tr.Match = tr.NumMismatches == 0
   139		case "relaxed":
   140			tr.Match = tr.NumMismatches <= threshold
   141		}
   142	
   143		return tr
   144	}
   145	
   146	func shapesEqual(a, b []uint32) bool {
   147		if len(a) != len(b) {
   148			return false
   149		}
   150		for i := range a {
   151			if a[i] != b[i] {
   152				return false
   153			}
   154		}
   155		return true
   156	}
