import (
	"bytes"
	"crypto/sha256"
	"encoding/binary"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"math"
	"os"
)

const (
	Magic      = "MLCK"
	Version    = 1
	HeaderSize = 16
	FooterSize = 32
)

type Dtype uint8

const (
	Float32 Dtype = 0
	Float64 Dtype = 1
	Int32   Dtype = 2
	Int64   Dtype = 3
)

func (d Dtype) Valid() bool {
	return d == Float32 || d == Float64 || d == Int32 || d == Int64
}

func (d Dtype) Name() string {
	switch d {
	case Float32:
		return "float32"
	case Float64:
		return "float64"
	case Int32:
		return "int32"
	case Int64:
		return "int64"
	default:
		return "unknown"
	}
}

func (d Dtype) Size() int {
	switch d {
	case Float32, Int32:
		return 4
	case Float64, Int64:
		return 8
	default:
		return 0
	}
}

func DtypeName(dtype uint8) string {
	return Dtype(dtype).Name()
}

func DtypeSize(dtype uint8) int {
	return Dtype(dtype).Size()
}

func Product(shape []uint32) int64 {
	p := int64(1)
	for _, s := range shape {
		p *= int64(s)
	}
	return p
}

