    19	
    20	func Run() int {
    21		if len(os.Args) < 2 {
    22			outputJSON(map[string]interface{}{"error": "no subcommand provided"})
    23			return 1
    24		}
    25	
    26		switch os.Args[1] {
    27		case "verify-checkpoint":
    28			return runVerifyCheckpoint(os.Args[2:])
    29		case "compare-outputs":
    30			return runCompareOutputs(os.Args[2:])
    31		case "validate-manifest":
    32			return runValidateManifest(os.Args[2:])
    33		case "audit-lineage":
    34			return runAuditLineage(os.Args[2:])
    35		case "generate-report":
    36			return runGenerateReport(os.Args[2:])
    37		case "merge-checkpoints":
    38			return runMergeCheckpoints(os.Args[2:])
    39		case "drift-analysis":
    40			return runDriftAnalysis(os.Args[2:])
    41		default:
    42			outputJSON(map[string]interface{}{"error": fmt.Sprintf("unknown subcommand: %s", os.Args[1])})
    43			return 1
    44		}
    45	}
    46	
    47	func runVerifyCheckpoint(args []string) int {
    48		if len(args) != 1 {
    49			outputJSON(map[string]interface{}{"error": "usage: repro-verify verify-checkpoint <file>"})
    50			return 1
    51		}
    52	
    53		if _, err := os.ReadFile(args[0]); err != nil {
    54			outputJSON(map[string]interface{}{"error": err.Error()})
    55			return 1
    56		}
    57	
    58		cp, err := mlck.ParseFile(args[0])
    59		if err != nil {
    60			outputJSON(map[string]interface{}{
    61				"valid": false,
    62				"error": err.Error(),
    63			})
    64			return 1
    65		}
    66	
    67		metadata := cp.Metadata
    68		if metadata == nil {
    69			metadata = map[string]interface{}{}
    70		}
    71		tensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))
    72		for _, t := range cp.Tensors {
    73			tensors = append(tensors, t.Info())
    74		}
    75	
    76		outputJSON(map[string]interface{}{
    77			"valid":          true,
    78			"format_version": int(cp.Version),
    79			"num_tensors":    len(cp.Tensors),
    80			"metadata":       metadata,
    81			"tensors":        tensors,
    82			"file_checksum":  cp.FileChecksum,
    83		})
    84		return 0
    85	}
    86	
    87	func runCompareOutputs(args []string) int {
    88		fs := flag.NewFlagSet("compare-outputs", flag.ContinueOnError)
    89		fs.SetOutput(io.Discard)
    90		atol := fs.Float64("atol", 1e-7, "absolute tolerance")
    91		rtol := fs.Float64("rtol", 1e-5, "relative tolerance")
    92		mode := fs.String("mode", "strict", "comparison mode")
    93	
    94		pos, err := parseMixedArgs(fs, args)
    95		if err != nil {
    96			outputJSON(map[string]interface{}{"error": err.Error()})
    97			return 1
    98		}
    99		if len(pos) != 2 {
   100			outputJSON(map[string]interface{}{"error": "usage: repro-verify compare-outputs <file1> <file2> [flags]"})
   101			return 1
   102		}
   103	
   104		c1, err := mlck.ParseFile(pos[0])
   105		if err != nil {
   106			outputJSON(map[string]interface{}{"error": fmt.Sprintf("file1: %v", err)})
   107			return 1
   108		}
   109	
   110		c2, err := mlck.ParseFile(pos[1])
   111		if err != nil {
   112			outputJSON(map[string]interface{}{"error": fmt.Sprintf("file2: %v", err)})
   113			return 1
   114		}
   115	
   116		res, err := compare.Compare(c1, c2, *mode, *atol, *rtol)
   117		if err != nil {
   118			outputJSON(map[string]interface{}{"error": err.Error()})
   119			return 1
   120		}
   121	
   122		outputJSON(res)
   123		if res.Match {
   124			return 0
   125		}
   126		return 1
   127	}
   128	
   129	func runValidateManifest(args []string) int {
   130		if len(args) != 1 {
   131			outputJSON(map[string]interface{}{"error": "usage: repro-verify validate-manifest <file.toml>"})
   132			return 1
   133		}
   134		if _, err := os.ReadFile(args[0]); err != nil {
   135			outputJSON(map[string]interface{}{"error": err.Error()})
   136			return 1
   137		}
   138		res := manifest.Validate(args[0])
   139		outputJSON(res)
   140		if res.Valid {
   141			return 0
   142		}
   143		return 1
   144	}
   145	
   146	func runAuditLineage(args []string) int {
   147		if len(args) != 1 {
   148			outputJSON(map[string]interface{}{"error": "usage: repro-verify audit-lineage <file.json>"})
   149			return 1
   150		}
   151		if _, err := os.ReadFile(args[0]); err != nil {
   152			outputJSON(map[string]interface{}{"error": err.Error()})
   153			return 1
   154		}
   155		res := lineage.Audit(args[0])
   156		outputJSON(res)
   157		if res.Valid {
   158			return 0
   159		}
   160		return 1
   161	}
   162	
   163	func runGenerateReport(args []string) int {
   164		fs := flag.NewFlagSet("generate-report", flag.ContinueOnError)
   165		fs.SetOutput(io.Discard)
   166		checkpoint := fs.String("checkpoint", "", "checkpoint file to verify")
   167		comparePath := fs.String("compare", "", "second checkpoint to compare")
   168		lineagePath := fs.String("lineage", "", "lineage file to audit")
   169	
   170		pos, err := parseMixedArgs(fs, args)
   171		if err != nil {
   172			outputJSON(map[string]interface{}{"error": err.Error()})
   173			return 1
   174		}
   175		if len(pos) != 1 {
   176			outputJSON(map[string]interface{}{"error": "usage: repro-verify generate-report <manifest.toml> [flags]"})
   177			return 1
   178		}
   179	
   180		for _, p := range []string{pos[0], *checkpoint, *comparePath, *lineagePath} {
   181			if p == "" {
   182				continue
   183			}
   184			if _, err := os.ReadFile(p); err != nil {
   185				outputJSON(map[string]interface{}{"error": err.Error()})
   186				return 1
   187			}
   188		}
   189	
   190		rep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)
   191		outputJSON(rep)
   192		return code
   193	}
   194	
   195	func runMergeCheckpoints(args []string) int {
   196		fs := flag.NewFlagSet("merge-checkpoints", flag.ContinueOnError)
   197		fs.SetOutput(io.Discard)
   198		conflict := fs.String("conflict", "first", "conflict strategy")
   199	
   200		pos, err := parseMixedArgs(fs, args)
   201		if err != nil {
   202			outputJSON(map[string]interface{}{"error": err.Error()})
   203			return 1
   204		}
   205		if len(pos) < 3 {
   206			outputJSON(map[string]interface{}{"error": "usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]"})
   207			return 1
   208		}
   209	
   210		res, err := merge.Merge(pos[0], pos[1:], *conflict)
   211		if err != nil {
   212			outputJSON(map[string]interface{}{"error": err.Error()})
   213			return 1
   214		}
   215		outputJSON(res)
   216		return 0
   217	}
   218	
   219	func runDriftAnalysis(args []string) int {
   220		fs := flag.NewFlagSet("drift-analysis", flag.ContinueOnError)
   221		fs.SetOutput(io.Discard)
   222	
   223		pos, err := parseMixedArgs(fs, args)
   224		if err != nil {
   225			outputJSON(map[string]interface{}{"error": err.Error()})
   226			return 1
   227		}
   228		if len(pos) < 2 {
   229			outputJSON(map[string]interface{}{"error": "usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]"})
   230			return 1
   231		}
   232	
   233		res, err := drift.Analyze(pos)
   234		if err != nil {
   235			outputJSON(map[string]interface{}{"error": err.Error()})
   236			return 1
   237		}
   238		outputJSON(res)
   239		return 0
   240	}
   241	
   242	func parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {
   243		var positional []string
   244		var flagArgs []string
   245	
   246		for i := 0; i < len(args); i++ {
   247			arg := args[i]
   248			if arg == "--" {
   249				positional = append(positional, args[i+1:]...)
   250				break
   251			}
   252			if strings.HasPrefix(arg, "--") {
   253				if strings.Contains(arg, "=") {
   254					flagArgs = append(flagArgs, arg)
   255					continue
   256				}
   257				if i+1 >= len(args) {
   258					return nil, fmt.Errorf("flag %s requires a value", arg)
   259				}
   260				flagArgs = append(flagArgs, arg+"="+args[i+1])
   261				i++
   262			} else {
   263				positional = append(positional, arg)
   264			}
   265		}
   266	
   267		if err := fs.Parse(flagArgs); err != nil {
   268			return nil, err
   269		}
   270		return positional, nil
   271	}
   272	
   273	func outputJSON(v interface{}) {
   274		enc := json.NewEncoder(os.Stdout)
   275		enc.SetIndent("", "  ")
   276		_ = enc.Encode(v)
   277	}
