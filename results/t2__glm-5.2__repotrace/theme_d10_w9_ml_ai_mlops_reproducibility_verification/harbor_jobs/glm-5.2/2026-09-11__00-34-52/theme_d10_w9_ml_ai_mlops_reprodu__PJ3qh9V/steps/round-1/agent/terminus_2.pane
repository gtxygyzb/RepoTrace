   139		preceding := data[:len(data)-FooterSize]
   140		footer := data[len(data)-FooterSize:]
   141		sum := sha256.Sum256(preceding)
   142		fileChecksum := hex.EncodeToString(sum[:])
   143		if hex.EncodeToString(footer) != fileChecksum {
   144			return nil, fmt.Errorf("checksum mismatch")
   145		}
   146	
   147		metaRaw := data[HeaderSize : HeaderSize+int(metaLen)]
   148		var metadata map[string]interface{}
   149		if metaLen > 0 {
   150			if err := json.Unmarshal(metaRaw, &metadata); err != nil {
   151				return nil, fmt.Errorf("invalid metadata JSON: %v", err)
   152			}
   153		} else {
   154			metadata = map[string]interface{}{}
   155		}
   156	
   157		offset := HeaderSize + int(metaLen)
   158		tensors := make([]Tensor, 0, numTensors)
   159	
   160		for i := uint32(0); i < numTensors; i++ {
   161			if offset+4 > len(preceding) {
   162				return nil, fmt.Errorf("truncated tensor name length")
   163			}
   164			nameLen := binary.LittleEndian.Uint32(data[offset : offset+4])
   165			offset += 4
