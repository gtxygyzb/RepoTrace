[?2004l     1	package app
     2	
     3	import (
     4		"encoding/json"
     5		"flag"
     6		"fmt"
     7		"os"
     8		"strings"
     9	
    10		"repro-verify/internal/compare"
    11		"repro-verify/internal/drift"
    12		"repro-verify/internal/lineage"
    13		"repro-verify/internal/manifest"
    14		"repro-verify/internal/merge"
    15		"repro-verify/internal/mlck"
    16		"repro-verify/internal/report"
    17	)
    18	
    19	func Run() int {
    20		if len(os.Args) < 2 {
    21			outputJSON(map[string]interface{}{"error": "no subcommand provided"})
    22			return 1
    23		}
    24	
    25		switch os.Args[1] {
    26		case "verify-checkpoint":
    27			return runVerifyCheckpoint(os.Args[2:])
    28		case "compare-outputs":
    29			return runCompareOutputs(os.Args[2:])
    30		case "validate-manifest":
    31			return runValidateManifest(os.Args[2:])
    32		case "audit-lineage":
    33			return runAuditLineage(os.Args[2:])
    34		case "generate-report":
    35			return runGenerateReport(os.Args[2:])
    36		case "merge-checkpoints":
    37			return runMergeCheckpoints(os.Args[2:])
    38		case "drift-analysis":
    39			return runDriftAnalysis(os.Args[2:])
    40		default:
    41			outputJSON(map[string]interface{}{"error": fmt.Sprintf("unknown subcommand: %s", os.Args[1])})
    42			return 1
    43		}
    44	}
    45	
    46	func runVerifyCheckpoint(args []string) int {
    47		if len(args) != 1 {
    48			outputJSON(map[string]interface{}{"error": "usage: repro-verify verify-checkpoint <file>"})
    49			return 1
    50		}
    51	
    52		cp, err := mlck.ParseFile(args[0])
    53		if err != nil {
    54			outputJSON(map[string]interface{}{
    55				"valid": false,
    56				"error": err.Error(),
    57			})
    58			return 1
    59		}
    60	
    61		metadata := cp.Metadata
    62		if metadata == nil {
    63			metadata = map[string]interface{}{}
    64		}
    65		tensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))
    66		for _, t := range cp.Tensors {
    67			tensors = append(tensors, t.Info())
    68		}
    69	
    70		outputJSON(map[string]interface{}{
    71			"valid":          true,
    72			"format_version": int(cp.Version),
    73			"num_tensors":    len(cp.Tensors),
    74			"metadata":       metadata,
    75			"tensors":        tensors,
    76			"file_checksum":  cp.FileChecksum,
    77		})
    78		return 0
    79	}
    80	
    81	func runCompareOutputs(args []string) int {
    82		fs := flag.NewFlagSet("compare-outputs", flag.ContinueOnError)
    83		fs.SetOutput(os.Stderr)
    84		atol := fs.Float64("atol", 1e-7, "absolute tolerance")
    85		rtol := fs.Float64("rtol", 1e-5, "relative tolerance")
    86		mode := fs.String("mode", "strict", "comparison mode")
    87	
    88		pos, err := parseMixedArgs(fs, args)
    89		if err != nil {
    90			outputJSON(map[string]interface{}{"error": err.Error()})
    91			return 1
    92		}
    93		if len(pos) != 2 {
    94			outputJSON(map[string]interface{}{"error": "usage: repro-verify compare-outputs <file1> <file2> [flags]"})
    95			return 1
    96		}
    97	
    98		c1, err := mlck.ParseFile(pos[0])
    99		if err != nil {
   100			outputJSON(map[string]interface{}{
   101				"match":            false,
   102				"mode":             *mode,
   103				"atol":             *atol,
   104				"rtol":             *rtol,
   105				"tensor_results":   []interface{}{},
   106				"missing_in_file1": []string{},
   107				"missing_in_file2": []string{},
   108				"error":            fmt.Sprintf("file1: %v", err),
   109			})
   110			return 1
   111		}
   112	
   113		c2, err := mlck.ParseFile(pos[1])
   114		if err != nil {
   115			outputJSON(map[string]interface{}{
   116				"match":            false,
   117				"mode":             *mode,
   118				"atol":             *atol,
   119				"rtol":             *rtol,
   120				"tensor_results":   []interface{}{},
   121				"missing_in_file1": []string{},
   122				"missing_in_file2": []string{},
   123				"error":            fmt.Sprintf("file2: %v", err),
   124			})
   125			return 1
   126		}
   127	
   128		res, err := compare.Compare(c1, c2, *mode, *atol, *rtol)
   129		if err != nil {
   130			outputJSON(map[string]interface{}{
   131				"match":            false,
   132				"mode":             *mode,
   133				"atol":             *atol,
   134				"rtol":             *rtol,
   135				"tensor_results":   []interface{}{},
   136				"missing_in_file1": []string{},
   137				"missing_in_file2": []string{},
   138				"error":            err.Error(),
   139			})
   140			return 1
   141		}
   142	
   143		outputJSON(res)
   144		if res.Match {
   145			return 0
   146		}
   147		return 1
   148	}
   149	
   150	func runValidateManifest(args []string) int {
   151		if len(args) != 1 {
   152			outputJSON(map[string]interface{}{"error": "usage: repro-verify validate-manifest <file.toml>"})
   153			return 1
   154		}
   155		res := manifest.Validate(args[0])
   156		outputJSON(res)
   157		if res.Valid {
   158			return 0
   159		}
   160		return 1
   161	}
   162	
   163	func runAuditLineage(args []string) int {
   164		if len(args) != 1 {
   165			outputJSON(map[string]interface{}{"error": "usage: repro-verify audit-lineage <file.json>"})
   166			return 1
   167		}
   168		res := lineage.Audit(args[0])
   169		outputJSON(res)
   170		if res.Valid {
   171			return 0
   172		}
   173		return 1
   174	}
   175	
   176	func runGenerateReport(args []string) int {
   177		fs := flag.NewFlagSet("generate-report", flag.ContinueOnError)
   178		fs.SetOutput(os.Stderr)
   179		checkpoint := fs.String("checkpoint", "", "checkpoint file to verify")
   180		comparePath := fs.String("compare", "", "second checkpoint to compare")
   181		lineagePath := fs.String("lineage", "", "lineage file to audit")
   182	
   183		pos, err := parseMixedArgs(fs, args)
   184		if err != nil {
   185			outputJSON(map[string]interface{}{"error": err.Error()})
   186			return 1
   187		}
   188		if len(pos) != 1 {
   189			outputJSON(map[string]interface{}{"error": "usage: repro-verify generate-report <manifest.toml> [flags]"})
   190			return 1
   191		}
   192	
   193		rep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)
   194		outputJSON(rep)
   195		return code
   196	}
   197	
   198	func runMergeCheckpoints(args []string) int {
   199		fs := flag.NewFlagSet("merge-checkpoints", flag.ContinueOnError)
   200		fs.SetOutput(os.Stderr)
   201		conflict := fs.String("conflict", "first", "conflict strategy")
   202	
   203		pos, err := parseMixedArgs(fs, args)
   204		if err != nil {
   205			outputJSON(map[string]interface{}{"error": err.Error()})
   206			return 1
   207		}
   208		if len(pos) < 3 {
   209			outputJSON(map[string]interface{}{"error": "usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]"})
   210			return 1
   211		}
   212	
   213		res, err := merge.Merge(pos[0], pos[1:], *conflict)
   214		if err != nil {
   215			outputJSON(map[string]interface{}{"error": err.Error()})
   216			return 1
   217		}
   218		outputJSON(res)
   219		return 0
   220	}
   221	
   222	func runDriftAnalysis(args []string) int {
   223		fs := flag.NewFlagSet("drift-analysis", flag.ContinueOnError)
   224		fs.SetOutput(os.Stderr)
   225	
   226		pos, err := parseMixedArgs(fs, args)
   227		if err != nil {
   228			outputJSON(map[string]interface{}{"error": err.Error()})
   229			return 1
   230		}
   231		if len(pos) < 2 {
   232			outputJSON(map[string]interface{}{"error": "usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]"})
   233			return 1
   234		}
   235	
   236		res, err := drift.Analyze(pos)
   237		if err != nil {
   238			outputJSON(map[string]interface{}{"error": err.Error()})
   239			return 1
   240		}
   241		outputJSON(res)
   242		return 0
   243	}
   244	
   245	func parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {
   246		var positional []string
   247		var flagArgs []string
   248	
   249		for i := 0; i < len(args); i++ {
   250			arg := args[i]
   251			if arg == "--" {
   252				positional = append(positional, args[i+1:]...)
   253				break
   254			}
   255			if strings.HasPrefix(arg, "--") {
   256				if strings.Contains(arg, "=") {
   257					flagArgs = append(flagArgs, arg)
   258					continue
   259				}
   260				if i+1 >= len(args) {
   261					return nil, fmt.Errorf("flag %s requires a value", arg)
   262				}
   263				flagArgs = append(flagArgs, arg+"="+args[i+1])
   264				i++
   265			} else {
   266				positional = append(positional, arg)
   267			}
   268		}
   269	
   270		if err := fs.Parse(flagArgs); err != nil {
   271			return nil, err
   272		}
   273		return positional, nil
   274	}
   275	
   276	func outputJSON(v interface{}) {
   277		enc := json.NewEncoder(os.Stdout)
   278		enc.SetIndent("", "  ")
   279		_ = enc.Encode(v)
   280	}
