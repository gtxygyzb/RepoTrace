   199	func shapesEqual(a, b []uint32) bool {
   200		if len(a) != len(b) {
   201			return false
   202		}
   203		for i := range a {
   204			if a[i] != b[i] {
   205				return false
   206			}
   207		}
   208		return true
   209	}
