[?2004lpackage report

import (
	"fmt"
	"strings"
	"time"

	"repro-verify/internal/compare"
	"repro-verify/internal/lineage"
	"repro-verify/internal/manifest"
	"repro-verify/internal/mlck"
)

type ManifestPart struct {
	Valid    bool     `json:"valid"`
	Warnings []string `json:"warnings,omitempty"`
	Errors   []string `json:"errors,omitempty"`
}

type CheckpointPart struct {
	Valid        bool   `json:"valid"`
	NumTensors   int    `json:"num_tensors"`
	FileChecksum string `json:"file_checksum"`
	Error        string `json:"error,omitempty"`
}

type ComparisonPart struct {
	Match   bool   `json:"match"`
	Summary string `json:"summary,omitempty"`
	Error   string `json:"error,omitempty"`
}

type LineagePart struct {
	Valid bool   `json:"valid"`
	Depth int    `json:"depth"`
	Error string `json:"error,omitempty"`
}

type Report struct {
	ReportVersion       string          `json:"report_version"`
	Timestamp           string          `json:"timestamp"`
	Manifest            ManifestPart    `json:"manifest"`
	Checkpoint          *CheckpointPart `json:"checkpoint,omitempty"`
	Comparison          *ComparisonPart `json:"comparison,omitempty"`
	Lineage             *LineagePart    `json:"lineage,omitempty"`
	OverallReproducible bool            `json:"overall_reproducible"`
	Issues              []string        `json:"issues"`
}

func Generate(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {
	issues := []string{}
	rep := &Report{
		ReportVersion: "1.0",
		Timestamp:     time.Now().Format(time.RFC3339),
		Issues:        issues,
	}

	man := manifest.Validate(manifestPath)
	rep.Manifest = ManifestPart{
		Valid:    man.Valid,
		Warnings: man.Warnings,
		Errors:   man.Errors,
	}
	if !man.Valid {
		issues = append(issues, fmt.Sprintf("Manifest validation failed: %s", strings.Join(man.Errors, "; ")))
	}

	checkpointValid := true
	if checkpointPath != "" {
		cp, err := mlck.ParseFile(checkpointPath)
		if err != nil {
			checkpointValid = false
			rep.Checkpoint = &CheckpointPart{
				Valid: false,
				Error: err.Error(),
			}
			issues = append(issues, fmt.Sprintf("Checkpoint verification failed: %v", err))
		} else {
			rep.Checkpoint = &CheckpointPart{
				Valid:        true,
				NumTensors:   len(cp.Tensors),
				FileChecksum: cp.FileChecksum,
			}
		}
	}

	comparisonMatch := true
	if checkpointPath != "" && comparePath != "" {
		c1, err := mlck.ParseFile(checkpointPath)
		if err != nil {
			comparisonMatch = false
			rep.Comparison = &ComparisonPart{
				Match: false,
				Error: fmt.Sprintf("checkpoint parse failed: %v", err),
			}
			issues = append(issues, fmt.Sprintf("Comparison failed: %v", err))
		} else {
			c2, err := mlck.ParseFile(comparePath)
			if err != nil {
				comparisonMatch = false
				rep.Comparison = &ComparisonPart{
					Match: false,
					Error: fmt.Sprintf("compare checkpoint parse failed: %v", err),
				}
				issues = append(issues, fmt.Sprintf("Comparison failed: %v", err))
			} else {
				res, err := compare.Compare(c1, c2, "strict", 1e-7, 1e-5)
				if err != nil {
					comparisonMatch = false
					rep.Comparison = &ComparisonPart{
						Match: false,
						Error: err.Error(),
					}
					issues = append(issues, fmt.Sprintf("Comparison failed: %v", err))
				} else {
					differ := 0
					total := len(res.TensorResults)
					for _, tr := range res.TensorResults {
						if !tr.Match {
							differ++
						}
					}
					rep.Comparison = &ComparisonPart{
						Match:   res.Match,
						Summary: fmt.Sprintf("%d/%d tensors differ", differ, total),
					}
					if !res.Match {
						comparisonMatch = false
						if differ > 0 {
							issues = append(issues, fmt.Sprintf("Tensor comparison failed: %d tensors differ beyond tolerance", differ))
						} else {
							issues = append(issues, "Tensor comparison failed: missing tensors or shape mismatch")
						}
					}
				}
			}
		}
	}

	lineageValid := true
	if lineagePath != "" {
		lin := lineage.Audit(lineagePath)
		if lin.Valid {
			rep.Lineage = &LineagePart{
				Valid: true,
				Depth: lin.MaxDepth,
			}
		} else {
			lineageValid = false
			rep.Lineage = &LineagePart{
				Valid: false,
				Error: strings.Join(lin.Errors, "; "),
			}
			issues = append(issues, fmt.Sprintf("Lineage audit failed: %s", strings.Join(lin.Errors, "; ")))
		}
	}

	overall := man.Valid && checkpointValid && comparisonMatch && lineageValid
	rep.OverallReproducible = overall
	rep.Issues = issues

	if overall {
		return rep, 0
	}
	return rep, 1
}
[?2004hroot@n30009:/app# sed -n '1,260p' internal/drift/drift.go
[?2004lpackage drift

import (
	"fmt"
	"math"

	"repro-verify/internal/mlck"
)

type TensorResult struct {
	Name           string    `json:"name"`
	StepChanges    []float64 `json:"step_changes"`
	MeanChange     float64   `json:"mean_change"`
	MaxChange      float64   `json:"max_change"`
	Convergence    string    `json:"convergence"`
	StabilityScore float64   `json:"stability_score"`
}

type Result struct {
	NumSnapshots       int            `json:"num_snapshots"`
	NumAnalyzedTensors int            `json:"num_analyzed_tensors"`
	SkippedTensors     []string       `json:"skipped_tensors"`
	Tensors            []TensorResult `json:"tensors"`
	OverallConvergence string         `json:"overall_convergence"`
}

func Analyze(files []string) (*Result, error) {
	if len(files) < 2 {
		return nil, fmt.Errorf("at least 2 input files required")
	}

	cps := make([]*mlck.Checkpoint, len(files))
	for i, f := range files {
		cp, err := mlck.ParseFile(f)
		if err != nil {
			return nil, fmt.Errorf("file %s: %v", f, err)
		}
		cps[i] = cp
	}

	var allNames []string
	seen := map[string]bool{}
	for _, cp := range cps {
		for _, t := range cp.Tensors {
			if !seen[t.Name] {
				seen[t.Name] = true
				allNames = append(allNames, t.Name)
			}
		}
	}

	skipped := []string{}
	tensors := []TensorResult{}
	converging := 0
	diverging := 0

	for _, name := range allNames {
		ok := true
		var shape []uint32
		for _, cp := range cps {
			t, exists := tensorByName(cp, name)
			if !exists {
				ok = false
				break
			}
			if shape == nil {
				shape = t.Shape
			} else if !shapesEqual(shape, t.Shape) {
				ok = false
				break
			}
		}
		if !ok {
			skipped = append(skipped, name)
			continue
		}

		steps := make([]float64, len(cps)-1)
		for i := 0; i < len(cps)-1; i++ {
			t1, _ := tensorByName(cps[i], name)
			t2, _ := tensorByName(cps[i+1], name)
			v1, err := t1.Float64Values()
			if err != nil {
				return nil, err
			}
			v2, err := t2.Float64Values()
			if err != nil {
				return nil, err
			}
			n := len(v1)
			if n == 0 {
				steps[i] = 0
				continue
			}
			var sum float64
			for j := 0; j < n; j++ {
				sum += math.Abs(v1[j] - v2[j])
			}
			steps[i] = sum / float64(n)
		}

		mean := meanFloat64(steps)
		max := maxFloat64(steps)
		convergence := classifyConvergence(steps)
		stability := 1.0
		if steps[0] != 0 {
			stability = 1.0 - steps[len(steps)-1]/steps[0]
			if stability < 0 {
				stability = 0
			} else if stability > 1 {
				stability = 1
			}
		}

		tensors = append(tensors, TensorResult{
			Name:           name,
			StepChanges:    steps,
			MeanChange:     mean,
			MaxChange:      max,
			Convergence:    convergence,
			StabilityScore: stability,
		})

		if convergence == "converging" {
			converging++
		} else if convergence == "diverging" {
			diverging++
		}
	}

	overall := "mixed"
	if converging > len(tensors)/2 {
		overall = "converging"
	} else if diverging > len(tensors)/2 {
		overall = "diverging"
	}

	return &Result{
		NumSnapshots:       len(files),
		NumAnalyzedTensors: len(tensors),
		SkippedTensors:     skipped,
		Tensors:            tensors,
		OverallConvergence: overall,
	}, nil
}

func tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {
	for _, t := range cp.Tensors {
		if t.Name == name {
			return t, true
		}
	}
	return mlck.Tensor{}, false
}

func shapesEqual(a, b []uint32) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func meanFloat64(xs []float64) float64 {
	if len(xs) == 0 {
		return 0
	}
	var sum float64
	for _, x := range xs {
		sum += x
	}
	return sum / float64(len(xs))
}

func maxFloat64(xs []float64) float64 {
	if len(xs) == 0 {
		return 0
	}
	m := xs[0]
	for _, x := range xs[1:] {
		if x > m {
			m = x
		}
	}
	return m
}

func classifyConvergence(steps []float64) string {
	if len(steps) <= 1 {
		return "converging"
	}
	decreasing := true
	increasing := true
	for i := 1; i < len(steps); i++ {
		if steps[i] >= steps[i-1] {
			decreasing = false
		}
		if steps[i] <= steps[i-1] {
			increasing = false
		}
	}
	if decreasing {
		return "converging"
	}
	if increasing {
		return "diverging"
	}
	return "oscillating"
}
