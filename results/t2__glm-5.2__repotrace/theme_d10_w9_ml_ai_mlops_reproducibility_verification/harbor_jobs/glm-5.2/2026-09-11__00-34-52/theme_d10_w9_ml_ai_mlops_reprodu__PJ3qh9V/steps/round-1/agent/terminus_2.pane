    13	
    14	const (
    15		Magic      = "MLCK"
    16		Version    = 1
    17		HeaderSize = 16
    18		FooterSize = 32
    19	)
    20	
    21	type Dtype uint8
    22	
    23	const (
    24		Float32 Dtype = 0
    25		Float64 Dtype = 1
    26		Int32   Dtype = 2
    27		Int64   Dtype = 3
    28	)
    29	
    30	func (d Dtype) Valid() bool {
    31		return d == Float32 || d == Float64 || d == Int32 || d == Int64
    32	}
    33	
    34	func (d Dtype) Name() string {
    35		switch d {
    36		case Float32:
    37			return "float32"
    38		case Float64:
    39			return "float64"
    40		case Int32:
    41			return "int32"
    42		case Int64:
    43			return "int64"
    44		default:
    45			return "unknown"
    46		}
    47	}
    48	
    49	func (d Dtype) Size() int {
    50		switch d {
    51		case Float32, Int32:
    52			return 4
    53		case Float64, Int64:
    54			return 8
    55		default:
    56			return 0
    57		}
    58	}
    59	
    60	func DtypeName(dtype uint8) string {
    61		return Dtype(dtype).Name()
    62	}
    63	
    64	func DtypeSize(dtype uint8) int {
    65		return Dtype(dtype).Size()
    66	}
    67	
    68	func Product(shape []uint32) int64 {
    69		p := int64(1)
    70		for _, s := range shape {
    71			p *= int64(s)
    72		}
    73		return p
    74	}
    75	
    76	type Tensor struct {
    77		Name     string
    78		Dtype    uint8
    79		Shape    []uint32
    80		Data     []byte
    81		Checksum string
    82	}
    83	
    84	type TensorInfo struct {
    85		Name     string   `json:"name"`
    86		Dtype    string   `json:"dtype"`
    87		Shape    []uint32 `json:"shape"`
    88		Checksum string   `json:"checksum"`
    89	}
    90	
    91	func (t Tensor) Info() TensorInfo {
    92		return TensorInfo{
    93			Name:     t.Name,
    94			Dtype:    DtypeName(t.Dtype),
    95			Shape:    t.Shape,
    96			Checksum: t.Checksum,
    97		}
    98	}
    99	
   100	type Checkpoint struct {
   101		Version      uint32
   102		NumTensors   uint32
   103		Metadata     map[string]interface{}
   104		MetadataRaw  []byte
   105		Tensors      []Tensor
   106		FileChecksum string
   107		FilePath     string
   108	}
   109	
   110	func ParseFile(path string) (*Checkpoint, error) {
   111		data, err := os.ReadFile(path)
   112		if err != nil {
   113			return nil, err
   114		}
   115		return Parse(data, path)
   116	}
   117	
   118	func Parse(data []byte, path string) (*Checkpoint, error) {
   119		if len(data) < HeaderSize+FooterSize {
   120			return nil, fmt.Errorf("file too small")
   121		}
   122	
   123		if string(data[0:4]) != Magic {
   124			return nil, fmt.Errorf("bad magic")
   125		}
   126	
   127		version := binary.LittleEndian.Uint32(data[4:8])
   128		if version != Version {
   129			return nil, fmt.Errorf("unsupported version %d", version)
   130		}
   131	
   132		numTensors := binary.LittleEndian.Uint32(data[8:12])
