[?2004lpackage lineage

import (
	"encoding/json"
	"fmt"
	"os"
	"strings"
	"time"
)

type Experiment struct {
	ID             string   `json:"id"`
	Name           string   `json:"name"`
	Parents        []string `json:"parents"`
	CheckpointHash string   `json:"checkpoint_hash"`
	Timestamp      string   `json:"timestamp"`
}

type Input struct {
	Experiments []Experiment `json:"experiments"`
}

type Result struct {
	Valid            bool     `json:"valid"`
	NumExperiments   int      `json:"num_experiments"`
	NumRoots         int      `json:"num_roots"`
	NumLeaves        int      `json:"num_leaves"`
	MaxDepth         int      `json:"max_depth"`
	TopologicalOrder []string `json:"topological_order"`
	Errors           []string `json:"errors,omitempty"`
}

func Audit(path string) *Result {
	data, err := os.ReadFile(path)
	if err != nil {
		return &Result{
			Valid:  false,
			Errors: []string{fmt.Sprintf("failed to read lineage file: %v", err)},
		}
	}

	var in Input
	if err := json.Unmarshal(data, &in); err != nil {
		return &Result{
			Valid:  false,
			Errors: []string{fmt.Sprintf("failed to parse lineage JSON: %v", err)},
		}
	}

	exps := in.Experiments
	result := &Result{
		Valid:            true,
		Errors:           []string{},
		TopologicalOrder: []string{},
	}

	if len(exps) == 0 {
		result.TopologicalOrder = []string{}
		return result
	}

	idSet := make(map[string]int)
	ids := make([]string, 0, len(exps))
	for i, e := range exps {
		if e.ID == "" {
			result.Errors = append(result.Errors, fmt.Sprintf("experiment at index %d missing id", i))
			continue
		}
		if _, ok := idSet[e.ID]; ok {
			result.Errors = append(result.Errors, fmt.Sprintf("duplicate id: %s", e.ID))
		} else {
			idSet[e.ID] = i
			ids = append(ids, e.ID)
		}
		if e.CheckpointHash == "" {
			result.Errors = append(result.Errors, fmt.Sprintf("empty checkpoint_hash for experiment: %s", e.ID))
		}
	}

	for _, e := range exps {
		if e.ID == "" {
			continue
		}
		for _, p := range e.Parents {
			if _, ok := idSet[p]; !ok {
				result.Errors = append(result.Errors, fmt.Sprintf("parent reference unresolved: %s -> %s", e.ID, p))
			}
		}
	}

	times := make(map[string]time.Time)
	for _, e := range exps {
		if e.ID == "" {
			continue
		}
		if e.Timestamp == "" {
			result.Errors = append(result.Errors, fmt.Sprintf("missing timestamp for experiment: %s", e.ID))
			continue
		}
		t, err := time.Parse(time.RFC3339, e.Timestamp)
		if err != nil {
			result.Errors = append(result.Errors, fmt.Sprintf("invalid timestamp for experiment: %s", e.ID))
		} else {
			times[e.ID] = t
		}
	}

	if len(result.Errors) == 0 {
		if cycle := detectCycle(exps); cycle != nil {
			result.Errors = append(result.Errors, fmt.Sprintf("cycle detected involving: %s", strings.Join(cycle, ", ")))
		}
	}

	if len(result.Errors) == 0 {
		for _, e := range exps {
			childTime, ok := times[e.ID]
			if !ok {
				continue
			}
			for _, p := range e.Parents {
				parentTime, ok := times[p]
				if !ok {
					continue
				}
				if !childTime.After(parentTime) {
					result.Errors = append(result.Errors, fmt.Sprintf("timestamp violation: %s (%s) has parent %s (%s)", e.ID, childTime.Format("2006-01-02"), p, parentTime.Format("2006-01-02")))
				}
			}
		}
	}

	if len(result.Errors) > 0 {
		result.Valid = false
		result.TopologicalOrder = nil
		return result
	}

	children := make(map[string][]string)
	for _, e := range exps {
		for _, p := range e.Parents {
			children[p] = append(children[p], e.ID)
		}
	}

	roots := make([]string, 0)
	leaves := make([]string, 0)
	for _, e := range exps {
		if len(e.Parents) == 0 {
			roots = append(roots, e.ID)
		}
		if len(children[e.ID]) == 0 {
			leaves = append(leaves, e.ID)
		}
	}

	visited := make(map[string]bool)
	var post []string
	var dfs func(id string)
	dfs = func(id string) {
		visited[id] = true
		for _, child := range children[id] {
			if !visited[child] {
				dfs(child)
			}
		}
		post = append(post, id)
	}
	for _, e := range exps {
		if !visited[e.ID] {
			dfs(e.ID)
		}
	}
	topo := make([]string, len(post))
	for i := range post {
		topo[i] = post[len(post)-1-i]
	}

	maxDepth := 0
	var depthDFS func(id string, depth int)
	depthDFS = func(id string, depth int) {
		if depth > maxDepth {
			maxDepth = depth
		}
		for _, child := range children[id] {
			depthDFS(child, depth+1)
		}
	}
	for _, r := range roots {
		depthDFS(r, 1)
	}

	result.NumExperiments = len(exps)
	result.NumRoots = len(roots)
	result.NumLeaves = len(leaves)
	result.MaxDepth = maxDepth
	result.TopologicalOrder = topo
	return result
}

func detectCycle(exps []Experiment) []string {
	adj := make(map[string][]string)
	for _, e := range exps {
		for _, p := range e.Parents {
			adj[p] = append(adj[p], e.ID)
		}
	}

	state := make(map[string]int)
	var stack []string
	var cycle []string

	var dfs func(id string) bool
	dfs = func(id string) bool {
		state[id] = 1
		stack = append(stack, id)
		for _, child := range adj[id] {
			if state[child] == 1 {
				idx := -1
				for i := len(stack) - 1; i >= 0; i-- {
					if stack[i] == child {
						idx = i
						break
					}
				}
				if idx >= 0 {
					cycle = append([]string{}, stack[idx:]...)
					return true
				}
			}
			if state[child] == 0 {
				if dfs(child) {
					return true
				}
			}
		}
		stack = stack[:len(stack)-1]
		state[id] = 2
		return false
	}

	for _, e := range exps {
		if state[e.ID] == 0 {
			if dfs(e.ID) {
				return cycle
			}
		}
	}
	return nil
}
[?2004hroot@n30009:/app# sed -n '1,320p' internal/compare/compare.go
[?2004lpackage compare

import (
	"fmt"
	"math"

	"repro-verify/internal/mlck"
)

type TensorResult struct {
	Name          string  `json:"name"`
	Match         bool    `json:"match"`
	MaxAbsDiff    float64 `json:"max_abs_diff"`
	MaxRelDiff    float64 `json:"max_rel_diff"`
	NumMismatches int     `json:"num_mismatches"`
	TotalElements int     `json:"total_elements"`
}

type Result struct {
	Match          bool           `json:"match"`
	Mode           string         `json:"mode"`
	Atol           float64        `json:"atol"`
	Rtol           float64        `json:"rtol"`
	TensorResults  []TensorResult `json:"tensor_results"`
	MissingInFile1 []string       `json:"missing_in_file1"`
	MissingInFile2 []string       `json:"missing_in_file2"`
	Error          string         `json:"error,omitempty"`
}

func Compare(c1, c2 *mlck.Checkpoint, mode string, atol, rtol float64) (*Result, error) {
	if mode != "strict" && mode != "relaxed" {
		return nil, fmt.Errorf("invalid mode %q", mode)
	}

	result := &Result{
		Match:          true,
		Mode:           mode,
		Atol:           atol,
		Rtol:           rtol,
		TensorResults:  []TensorResult{},
		MissingInFile1: []string{},
		MissingInFile2: []string{},
	}

	map2 := make(map[string]mlck.Tensor)
	for _, t := range c2.Tensors {
		map2[t.Name] = t
	}
	map1 := make(map[string]mlck.Tensor)
	for _, t := range c1.Tensors {
		map1[t.Name] = t
	}

	for _, t1 := range c1.Tensors {
		t2, ok := map2[t1.Name]
		if !ok {
			result.MissingInFile2 = append(result.MissingInFile2, t1.Name)
			continue
		}
		tr := compareTensors(t1, t2, mode, atol, rtol)
		result.TensorResults = append(result.TensorResults, tr)
		if !tr.Match {
			result.Match = false
		}
	}

	for _, t := range c2.Tensors {
		if _, ok := map1[t.Name]; !ok {
			result.MissingInFile1 = append(result.MissingInFile1, t.Name)
		}
	}

	if len(result.MissingInFile1) > 0 || len(result.MissingInFile2) > 0 {
		result.Match = false
	}

	return result, nil
}

func compareTensors(t1, t2 mlck.Tensor, mode string, atol, rtol float64) TensorResult {
	total := int(mlck.Product(t1.Shape))
	tr := TensorResult{
		Name:          t1.Name,
		Match:         true,
		MaxAbsDiff:    0,
		MaxRelDiff:    0,
		NumMismatches: 0,
		TotalElements: total,
	}

	if !shapesEqual(t1.Shape, t2.Shape) {
		tr.Match = false
		tr.NumMismatches = total
		return tr
	}

	if total == 0 {
		return tr
	}

	vals1, err := t1.Float64Values()
	if err != nil {
		tr.Match = false
		tr.NumMismatches = total
		return tr
	}
	vals2, err := t2.Float64Values()
	if err != nil {
		tr.Match = false
		tr.NumMismatches = total
		return tr
	}

	threshold := int(math.Floor(float64(total) * 0.001))
	for i := 0; i < total; i++ {
		a := vals1[i]
		b := vals2[i]
		diff := math.Abs(a - b)
		if diff > tr.MaxAbsDiff {
			tr.MaxAbsDiff = diff
		}
		var rel float64
		if math.Abs(b) > 0 {
			rel = diff / math.Abs(b)
		} else if diff > 0 {
			rel = diff
		}
		if rel > tr.MaxRelDiff {
			tr.MaxRelDiff = rel
		}
		if diff > atol+rtol*math.Abs(b) {
			tr.NumMismatches++
		}
	}

	switch mode {
	case "strict":
		tr.Match = tr.NumMismatches == 0
	case "relaxed":
		tr.Match = tr.NumMismatches <= threshold
	}

	return tr
}

func shapesEqual(a, b []uint32) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}
[?2004hroot@n30009:/app# sed -n '1,360p' internal/app/app.go
[?2004lpackage app

import (
	"encoding/json"
	"flag"
	"fmt"
	"io"
	"os"
	"strings"

	"repro-verify/internal/compare"
	"repro-verify/internal/drift"
	"repro-verify/internal/lineage"
	"repro-verify/internal/manifest"
	"repro-verify/internal/merge"
	"repro-verify/internal/mlck"
	"repro-verify/internal/report"
)

func Run() int {
	if len(os.Args) < 2 {
		outputJSON(map[string]interface{}{"error": "no subcommand provided"})
		return 1
	}

	switch os.Args[1] {
	case "verify-checkpoint":
		return runVerifyCheckpoint(os.Args[2:])
	case "compare-outputs":
		return runCompareOutputs(os.Args[2:])
	case "validate-manifest":
		return runValidateManifest(os.Args[2:])
	case "audit-lineage":
		return runAuditLineage(os.Args[2:])
	case "generate-report":
		return runGenerateReport(os.Args[2:])
	case "merge-checkpoints":
		return runMergeCheckpoints(os.Args[2:])
	case "drift-analysis":
		return runDriftAnalysis(os.Args[2:])
	default:
		outputJSON(map[string]interface{}{"error": fmt.Sprintf("unknown subcommand: %s", os.Args[1])})
		return 1
	}
}

func runVerifyCheckpoint(args []string) int {
	if len(args) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify verify-checkpoint <file>"})
		return 1
	}

	if _, err := os.ReadFile(args[0]); err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}

	cp, err := mlck.ParseFile(args[0])
	if err != nil {
		outputJSON(map[string]interface{}{
			"valid": false,
			"error": err.Error(),
		})
		return 1
	}

	metadata := cp.Metadata
	if metadata == nil {
		metadata = map[string]interface{}{}
	}
	tensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))
	for _, t := range cp.Tensors {
		tensors = append(tensors, t.Info())
	}

	outputJSON(map[string]interface{}{
		"valid":          true,
		"format_version": int(cp.Version),
		"num_tensors":    len(cp.Tensors),
		"metadata":       metadata,
		"tensors":        tensors,
		"file_checksum":  cp.FileChecksum,
	})
	return 0
}

func runCompareOutputs(args []string) int {
	fs := flag.NewFlagSet("compare-outputs", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	atol := fs.Float64("atol", 1e-7, "absolute tolerance")
	rtol := fs.Float64("rtol", 1e-5, "relative tolerance")
	mode := fs.String("mode", "strict", "comparison mode")

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) != 2 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify compare-outputs <file1> <file2> [flags]"})
		return 1
	}

	c1, err := mlck.ParseFile(pos[0])
	if err != nil {
		outputJSON(map[string]interface{}{"error": fmt.Sprintf("file1: %v", err)})
		return 1
	}

	c2, err := mlck.ParseFile(pos[1])
	if err != nil {
		outputJSON(map[string]interface{}{"error": fmt.Sprintf("file2: %v", err)})
		return 1
	}

	res, err := compare.Compare(c1, c2, *mode, *atol, *rtol)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}

	outputJSON(res)
	if res.Match {
		return 0
	}
	return 1
}

func runValidateManifest(args []string) int {
	if len(args) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify validate-manifest <file.toml>"})
		return 1
	}
	if _, err := os.ReadFile(args[0]); err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	res := manifest.Validate(args[0])
	outputJSON(res)
	if res.Valid {
		return 0
	}
	return 1
}

func runAuditLineage(args []string) int {
	if len(args) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify audit-lineage <file.json>"})
		return 1
	}
	if _, err := os.ReadFile(args[0]); err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	res := lineage.Audit(args[0])
	outputJSON(res)
	if res.Valid {
		return 0
	}
	return 1
}

func runGenerateReport(args []string) int {
	fs := flag.NewFlagSet("generate-report", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	checkpoint := fs.String("checkpoint", "", "checkpoint file to verify")
	comparePath := fs.String("compare", "", "second checkpoint to compare")
	lineagePath := fs.String("lineage", "", "lineage file to audit")

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify generate-report <manifest.toml> [flags]"})
		return 1
	}

	for _, p := range []string{pos[0], *checkpoint, *comparePath, *lineagePath} {
		if p == "" {
			continue
		}
		if _, err := os.ReadFile(p); err != nil {
			outputJSON(map[string]interface{}{"error": err.Error()})
			return 1
		}
	}

	rep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)
	outputJSON(rep)
	return code
}

func runMergeCheckpoints(args []string) int {
	fs := flag.NewFlagSet("merge-checkpoints", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	conflict := fs.String("conflict", "first", "conflict strategy")

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) < 3 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]"})
		return 1
	}

	res, err := merge.Merge(pos[0], pos[1:], *conflict)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	outputJSON(res)
	return 0
}

func runDriftAnalysis(args []string) int {
	fs := flag.NewFlagSet("drift-analysis", flag.ContinueOnError)
	fs.SetOutput(io.Discard)

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) < 2 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]"})
		return 1
	}

	res, err := drift.Analyze(pos)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	outputJSON(res)
	return 0
}

func parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {
	var positional []string
	var flagArgs []string

	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			positional = append(positional, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if strings.Contains(arg, "=") {
				flagArgs = append(flagArgs, arg)
				continue
			}
			if i+1 >= len(args) {
				return nil, fmt.Errorf("flag %s requires a value", arg)
			}
			flagArgs = append(flagArgs, arg+"="+args[i+1])
			i++
		} else {
			positional = append(positional, arg)
		}
	}

	if err := fs.Parse(flagArgs); err != nil {
		return nil, err
	}
	return positional, nil
}

func outputJSON(v interface{}) {
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	_ = enc.Encode(v)
}
