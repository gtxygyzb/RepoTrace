   211	func meanFloat64(xs []float64) float64 {
   212		if len(xs) == 0 {
   213			return 0
   214		}
   215		var sum float64
   216		for _, x := range xs {
   217			sum += x
   218		}
   219		return sum / float64(len(xs))
   220	}
   221	
   222	func maxFloat64(xs []float64) float64 {
   223		if len(xs) == 0 {
   224			return 0
   225		}
   226		m := xs[0]
   227		for _, x := range xs[1:] {
   228			if x > m {
   229				m = x
   230			}
   231		}
   232		return m
   233	}
