    12		"repro-verify/internal/drift"
    13		"repro-verify/internal/lineage"
    14		"repro-verify/internal/manifest"
    15		"repro-verify/internal/merge"
    16		"repro-verify/internal/mlck"
    17		"repro-verify/internal/report"
    18	)
    19	
    20	func Run() int {
    21		if len(os.Args) < 2 {
    22			outputJSON(map[string]interface{}{"error": "no subcommand provided"})
    23			return 1
    24		}
    25	
    26		switch os.Args[1] {
    27		case "verify-checkpoint":
    28			return runVerifyCheckpoint(os.Args[2:])
    29		case "compare-outputs":
    30			return runCompareOutputs(os.Args[2:])
    31		case "validate-manifest":
    32			return runValidateManifest(os.Args[2:])
    33		case "audit-lineage":
    34			return runAuditLineage(os.Args[2:])
    35		case "generate-report":
    36			return runGenerateReport(os.Args[2:])
    37		case "merge-checkpoints":
    38			return runMergeCheckpoints(os.Args[2:])
    39		case "drift-analysis":
    40			return runDriftAnalysis(os.Args[2:])
    41		default:
    42			outputJSON(map[string]interface{}{"error": fmt.Sprintf("unknown subcommand: %s", os.Args[1])})
    43			return 1
    44		}
    45	}
    46	
    47	func runVerifyCheckpoint(args []string) int {
    48		if len(args) != 1 {
    49			outputJSON(map[string]interface{}{"error": "usage: repro-verify verify-checkpoint <file>"})
    50			return 1
    51		}
    52	
    53		if _, err := os.ReadFile(args[0]); err != nil {
    54			outputJSON(map[string]interface{}{"error": err.Error()})
    55			return 1
    56		}
    57	
    58		cp, err := mlck.ParseFile(args[0])
    59		if err != nil {
    60			outputJSON(map[string]interface{}{
    61				"valid": false,
    62				"error": err.Error(),
    63			})
    64			return 1
    65		}
    66	
    67		metadata := cp.Metadata
    68		if metadata == nil {
    69			metadata = map[string]interface{}{}
    70		}
    71		tensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))
    72		for _, t := range cp.Tensors {
    73			tensors = append(tensors, t.Info())
    74		}
    75	
    76		outputJSON(map[string]interface{}{
    77			"valid":          true,
    78			"format_version": int(cp.Version),
    79			"num_tensors":    len(cp.Tensors),
    80			"metadata":       metadata,
    81			"tensors":        tensors,
    82			"file_checksum":  cp.FileChecksum,
    83		})
    84		return 0
    85	}
    86	
    87	func runCompareOutputs(args []string) int {
    88		fs := flag.NewFlagSet("compare-outputs", flag.ContinueOnError)
    89		fs.SetOutput(io.Discard)
    90		atol := fs.Float64("atol", 1e-7, "absolute tolerance")
    91		rtol := fs.Float64("rtol", 1e-5, "relative tolerance")
    92		mode := fs.String("mode", "strict", "comparison mode")
    93		histogram := fs.Bool("histogram", false, "include diff histograms")
    94	
    95		pos, err := parseMixedArgs(fs, args)
    96		if err != nil {
    97			outputJSON(map[string]interface{}{"error": err.Error()})
    98			return 1
    99		}
   100		if len(pos) != 2 {
   101			outputJSON(map[string]interface{}{"error": "usage: repro-verify compare-outputs <file1> <file2> [flags]"})
   102			return 1
   103		}
   104	
   105		c1, err := mlck.ParseFile(pos[0])
   106		if err != nil {
   107			outputJSON(map[string]interface{}{"error": fmt.Sprintf("file1: %v", err)})
   108			return 1
   109		}
   110	
   111		c2, err := mlck.ParseFile(pos[1])
   112		if err != nil {
   113			outputJSON(map[string]interface{}{"error": fmt.Sprintf("file2: %v", err)})
   114			return 1
   115		}
   116	
   117		res, err := compare.Compare(c1, c2, *mode, *atol, *rtol, *histogram)
   118		if err != nil {
   119			outputJSON(map[string]interface{}{"error": err.Error()})
   120			return 1
   121		}
   122	
   123		outputJSON(res)
   124		if res.Match {
   125			return 0
   126		}
   127		return 1
   128	}
   129	
   130	func runValidateManifest(args []string) int {
   131		if len(args) != 1 {
   132			outputJSON(map[string]interface{}{"error": "usage: repro-verify validate-manifest <file.toml>"})
   133			return 1
   134		}
   135		if _, err := os.ReadFile(args[0]); err != nil {
   136			outputJSON(map[string]interface{}{"error": err.Error()})
   137			return 1
   138		}
   139		res := manifest.Validate(args[0])
   140		outputJSON(res)
   141		if res.Valid {
   142			return 0
   143		}
   144		return 1
   145	}
   146	
   147	func runAuditLineage(args []string) int {
   148		if len(args) != 1 {
   149			outputJSON(map[string]interface{}{"error": "usage: repro-verify audit-lineage <file.json>"})
   150			return 1
   151		}
   152		if _, err := os.ReadFile(args[0]); err != nil {
   153			outputJSON(map[string]interface{}{"error": err.Error()})
   154			return 1
   155		}
   156		res := lineage.Audit(args[0])
   157		outputJSON(res)
   158		if res.Valid {
   159			return 0
   160		}
   161		return 1
   162	}
   163	
   164	func runGenerateReport(args []string) int {
   165		fs := flag.NewFlagSet("generate-report", flag.ContinueOnError)
   166		fs.SetOutput(io.Discard)
   167		checkpoint := fs.String("checkpoint", "", "checkpoint file to verify")
   168		comparePath := fs.String("compare", "", "second checkpoint to compare")
   169		lineagePath := fs.String("lineage", "", "lineage file to audit")
   170	
   171		pos, err := parseMixedArgs(fs, args)
   172		if err != nil {
   173			outputJSON(map[string]interface{}{"error": err.Error()})
   174			return 1
   175		}
   176		if len(pos) != 1 {
   177			outputJSON(map[string]interface{}{"error": "usage: repro-verify generate-report <manifest.toml> [flags]"})
   178			return 1
   179		}
   180	
   181		for _, p := range []string{pos[0], *checkpoint, *comparePath, *lineagePath} {
   182			if p == "" {
   183				continue
   184			}
   185			if _, err := os.ReadFile(p); err != nil {
   186				outputJSON(map[string]interface{}{"error": err.Error()})
   187				return 1
   188			}
   189		}
   190	
   191		rep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)
   192		outputJSON(rep)
   193		return code
   194	}
   195	
   196	func runMergeCheckpoints(args []string) int {
   197		fs := flag.NewFlagSet("merge-checkpoints", flag.ContinueOnError)
   198		fs.SetOutput(io.Discard)
   199		conflict := fs.String("conflict", "first", "conflict strategy")
   200	
   201		pos, err := parseMixedArgs(fs, args)
   202		if err != nil {
   203			outputJSON(map[string]interface{}{"error": err.Error()})
   204			return 1
   205		}
   206		if len(pos) < 3 {
   207			outputJSON(map[string]interface{}{"error": "usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]"})
   208			return 1
   209		}
