   208	}
   209	
   210	func tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {
   211		for _, t := range cp.Tensors {
   212			if t.Name == name {
   213				return t, true
   214			}
   215		}
   216		return mlck.Tensor{}, false
   217	}
   218	
   219	func shapesEqual(a, b []uint32) bool {
   220		if len(a) != len(b) {
   221			return false
   222		}
   223		for i := range a {
   224			if a[i] != b[i] {
   225				return false
   226			}
   227		}
   228		return true
   229	}
   230	
   231	func meanFloat64(xs []float64) float64 {
   232		if len(xs) == 0 {
   233			return 0
   234		}
   235		var sum float64
   236		for _, x := range xs {
   237			sum += x
   238		}
   239		return sum / float64(len(xs))
   240	}
