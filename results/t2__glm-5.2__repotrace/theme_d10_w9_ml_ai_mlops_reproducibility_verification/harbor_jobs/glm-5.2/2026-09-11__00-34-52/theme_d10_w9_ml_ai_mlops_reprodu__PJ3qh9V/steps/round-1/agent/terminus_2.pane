    37	}
    38	
    39	type Report struct {
    40		ReportVersion       string          `json:"report_version"`
    41		Timestamp           string          `json:"timestamp"`
    42		Manifest            ManifestPart    `json:"manifest"`
    43		Checkpoint          *CheckpointPart `json:"checkpoint,omitempty"`
    44		Comparison          *ComparisonPart `json:"comparison,omitempty"`
    45		Lineage             *LineagePart    `json:"lineage,omitempty"`
    46		OverallReproducible bool            `json:"overall_reproducible"`
    47		Issues              []string        `json:"issues"`
    48	}
    49	
    50	func Generate(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {
    51		issues := []string{}
    52		rep := &Report{
    53			ReportVersion: "1.0",
    54			Timestamp:     time.Now().Format(time.RFC3339),
    55			Issues:        issues,
    56		}
    57	
    58		man := manifest.Validate(manifestPath)
    59		rep.Manifest = ManifestPart{
    60			Valid:    man.Valid,
    61			Warnings: man.Warnings,
    62			Errors:   man.Errors,
    63		}
    64		if !man.Valid {
    65			issues = append(issues, fmt.Sprintf("Manifest validation failed: %s", strings.Join(man.Errors, "; ")))
    66		}
    67	
    68		checkpointValid := true
    69		if checkpointPath != "" {
    70			cp, err := mlck.ParseFile(checkpointPath)
    71			if err != nil {
    72				checkpointValid = false
    73				rep.Checkpoint = &CheckpointPart{
    74					Valid: false,
    75					Error: err.Error(),
    76				}
    77				issues = append(issues, fmt.Sprintf("Checkpoint verification failed: %v", err))
    78			} else {
    79				rep.Checkpoint = &CheckpointPart{
    80					Valid:        true,
    81					NumTensors:   len(cp.Tensors),
    82					FileChecksum: cp.FileChecksum,
    83				}
    84			}
    85		}
    86	
    87		comparisonMatch := true
    88		if checkpointPath != "" && comparePath != "" {
    89			c1, err := mlck.ParseFile(checkpointPath)
    90			if err != nil {
    91				comparisonMatch = false
    92				rep.Comparison = &ComparisonPart{
    93					Match: false,
    94					Error: fmt.Sprintf("checkpoint parse failed: %v", err),
    95				}
    96				issues = append(issues, fmt.Sprintf("Comparison failed: %v", err))
    97			} else {
    98				c2, err := mlck.ParseFile(comparePath)
    99				if err != nil {
   100					comparisonMatch = false
   101					rep.Comparison = &ComparisonPart{
   102						Match: false,
   103						Error: fmt.Sprintf("compare checkpoint parse failed: %v", err),
   104					}
   105					issues = append(issues, fmt.Sprintf("Comparison failed: %v", err))
   106				} else {
   107					res, err := compare.Compare(c1, c2, "strict", 1e-7, 1e-5)
   108					if err != nil {
   109						comparisonMatch = false
   110						rep.Comparison = &ComparisonPart{
   111							Match: false,
   112							Error: err.Error(),
   113						}
   114						issues = append(issues, fmt.Sprintf("Comparison failed: %v", err))
   115					} else {
   116						differ := 0
   117						total := len(res.TensorResults)
   118						for _, tr := range res.TensorResults {
   119							if !tr.Match {
   120								differ++
   121							}
   122						}
   123						missing := len(res.MissingInFile1) + len(res.MissingInFile2)
   124						summary := fmt.Sprintf("%d/%d tensors differ", differ, total)
   125						if missing > 0 {
   126							summary = fmt.Sprintf("%s, %d tensors missing", summary, missing)
   127						}
   128						rep.Comparison = &ComparisonPart{
   129							Match:   res.Match,
   130							Summary: summary,
   131						}
   132						if !res.Match {
   133							comparisonMatch = false
   134							issues = append(issues, fmt.Sprintf("Tensor comparison failed: %s", summary))
   135						}
   136					}
   137				}
   138			}
   139		}
   140	
   141		lineageValid := true
   142		if lineagePath != "" {
   143			lin := lineage.Audit(lineagePath)
   144			if lin.Valid {
   145				rep.Lineage = &LineagePart{
   146					Valid: true,
   147					Depth: lin.MaxDepth,
   148				}
   149			} else {
   150				lineageValid = false
   151				rep.Lineage = &LineagePart{
   152					Valid:  false,
   153					Errors: lin.Errors,
   154				}
   155				issues = append(issues, fmt.Sprintf("Lineage audit failed: %s", strings.Join(lin.Errors, "; ")))
   156			}
   157		}
   158	
   159		overall := man.Valid && checkpointValid && comparisonMatch && lineageValid
   160		rep.OverallReproducible = overall
   161		rep.Issues = issues
   162	
   163		if overall {
   164			return rep, 0
   165		}
   166		return rep, 1
   167	}
