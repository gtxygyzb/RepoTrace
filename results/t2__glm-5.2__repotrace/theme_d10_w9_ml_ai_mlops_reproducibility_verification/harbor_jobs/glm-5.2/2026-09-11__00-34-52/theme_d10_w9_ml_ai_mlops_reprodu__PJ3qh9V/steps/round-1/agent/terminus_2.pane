   291			for _, p := range parts {
   292				v, err := parseTOMLValue(strings.TrimSpace(p))
   293				if err != nil {
   294					return nil, err
   295				}
   296				arr = append(arr, v)
   297			}
   298			return arr, nil
   299		}
