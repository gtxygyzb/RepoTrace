    42	func Compare(c1, c2 *mlck.Checkpoint, mode string, atol, rtol float64, histogram bool) (*Result, error) {
    43		if mode != "strict" && mode != "relaxed" {
    44			return nil, fmt.Errorf("invalid mode %q", mode)
    45		}
    46	
    47		result := &Result{
    48			Match:            true,
    49			Mode:             mode,
    50			Atol:             atol,
    51			Rtol:             rtol,
    52			HistogramEnabled: histogram,
    53			TensorResults:    []TensorResult{},
    54			MissingInFile1:   []string{},
    55			MissingInFile2:   []string{},
    56		}
    57	
    58		map2 := make(map[string]mlck.Tensor)
    59		for _, t := range c2.Tensors {
    60			map2[t.Name] = t
    61		}
    62		map1 := make(map[string]mlck.Tensor)
    63		for _, t := range c1.Tensors {
    64			map1[t.Name] = t
    65		}
    66	
    67		for _, t1 := range c1.Tensors {
    68			t2, ok := map2[t1.Name]
    69			if !ok {
    70				result.MissingInFile2 = append(result.MissingInFile2, t1.Name)
    71				continue
    72			}
    73			tr := compareTensors(t1, t2, mode, atol, rtol, histogram)
    74			result.TensorResults = append(result.TensorResults, tr)
    75			if !tr.Match {
    76				result.Match = false
    77			}
    78		}
    79	
    80		for _, t := range c2.Tensors {
    81			if _, ok := map1[t.Name]; !ok {
    82				result.MissingInFile1 = append(result.MissingInFile1, t.Name)
    83			}
    84		}
    85	
    86		if len(result.MissingInFile1) > 0 || len(result.MissingInFile2) > 0 {
    87			result.Match = false
    88		}
    89	
    90		return result, nil
    91	}
    92	
    93	func compareTensors(t1, t2 mlck.Tensor, mode string, atol, rtol float64, histogram bool) TensorResult {
    94		total := int(mlck.Product(t1.Shape))
    95	
    96		tr := TensorResult{
    97			Name:          t1.Name,
    98			Match:         true,
    99			MaxAbsDiff:    0,
   100			MaxRelDiff:    0,
   101			NumMismatches: 0,
   102			TotalElements: total,
   103		}
   104	
   105		if !shapesEqual(t1.Shape, t2.Shape) {
   106			tr.Match = false
   107			tr.ShapeMismatch = true
   108			tr.NumMismatches = total
   109			return tr
   110		}
   111	
   112		if total == 0 {
   113			if histogram {
   114				tr.DiffHistogram = &DiffHistogram{}
   115			}
   116			return tr
   117		}
   118	
   119		vals1, err := t1.Float64Values()
   120		if err != nil {
   121			tr.Match = false
   122			tr.NumMismatches = total
   123			return tr
   124		}
   125		vals2, err := t2.Float64Values()
   126		if err != nil {
   127			tr.Match = false
   128			tr.NumMismatches = total
   129			return tr
   130		}
   131	
   132		var hist DiffHistogram
   133		threshold := int(math.Floor(float64(total) * 0.001))
   134		for i := 0; i < total; i++ {
   135			a := vals1[i]
   136			b := vals2[i]
   137			diff := math.Abs(a - b)
   138			if diff > tr.MaxAbsDiff {
   139				tr.MaxAbsDiff = diff
   140			}
   141			var rel float64
   142			if math.Abs(b) > 0 {
   143				rel = diff / math.Abs(b)
   144			} else if diff > 0 {
   145				rel = diff
   146			}
   147			if rel > tr.MaxRelDiff {
   148				tr.MaxRelDiff = rel
   149			}
   150			if diff > atol+rtol*math.Abs(b) {
   151				tr.NumMismatches++
   152			}
   153	
   154			switch {
   155			case diff == 0:
   156				hist.Exact++
   157			case diff < 1e-7:
   158				hist.Less1e7++
   159			case diff < 1e-5:
   160				hist.Less1e5++
   161			case diff < 1e-3:
   162				hist.Less1e3++
   163			case diff < 1:
   164				hist.Less1++
   165			default:
   166				hist.Geq1++
   167			}
   168		}
   169	
   170		if histogram {
   171			tr.DiffHistogram = &hist
   172		}
   173	
   174		switch mode {
   175		case "strict":
   176			tr.Match = tr.NumMismatches == 0
   177		case "relaxed":
   178			tr.Match = tr.NumMismatches <= threshold
   179		}
   180	
