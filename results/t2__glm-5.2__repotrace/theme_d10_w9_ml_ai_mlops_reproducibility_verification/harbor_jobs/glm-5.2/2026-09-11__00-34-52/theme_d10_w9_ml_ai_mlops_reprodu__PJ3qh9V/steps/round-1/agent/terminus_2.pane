   123			} else if !hasNumericField(metrics) {
   124				result.Errors = append(result.Errors, "outputs.metrics must contain at least one numeric field")
   125			}
   126		}
   127	
   128		git := getTable(root, "git")
   129		if git == nil {
   130			result.Warnings = append(result.Warnings, "optional field 'git.commit' missing")
   131			result.Warnings = append(result.Warnings, "optional field 'git.branch' missing")
   132		} else {
   133			if _, ok := git["commit"].(string); !ok {
   134				result.Warnings = append(result.Warnings, "optional field 'git.commit' missing")
   135			}
   136			if _, ok := git["branch"].(string); !ok {
   137				result.Warnings = append(result.Warnings, "optional field 'git.branch' missing")
   138			}
   139		}
   140	
   141		if len(result.Errors) > 0 {
   142			result.Valid = false
   143			result.Warnings = nil
   144		}
   145		if result.Valid && len(result.Warnings) == 0 {
   146			result.Warnings = []string{}
   147		}
   148	
   149		return result
   150	}
