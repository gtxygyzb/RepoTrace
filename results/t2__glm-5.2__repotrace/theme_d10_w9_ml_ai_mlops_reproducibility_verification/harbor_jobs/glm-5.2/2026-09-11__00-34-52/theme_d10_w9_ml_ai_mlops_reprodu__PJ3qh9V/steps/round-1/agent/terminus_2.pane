   243	func parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {
   244		var positional []string
   245		var flagArgs []string
   246	
   247		for i := 0; i < len(args); i++ {
   248			arg := args[i]
   249			if arg == "--" {
   250				positional = append(positional, args[i+1:]...)
   251				break
   252			}
   253			if strings.HasPrefix(arg, "--") {
   254				if strings.Contains(arg, "=") {
   255					flagArgs = append(flagArgs, arg)
   256					continue
   257				}
   258				if isBoolFlag(fs, arg) {
   259					flagArgs = append(flagArgs, arg+"=true")
   260					continue
   261				}
   262				if i+1 >= len(args) {
   263					return nil, fmt.Errorf("flag %s requires a value", arg)
   264				}
   265				flagArgs = append(flagArgs, arg+"="+args[i+1])
   266				i++
   267			} else {
   268				positional = append(positional, arg)
   269			}
   270		}
   271	
   272		if err := fs.Parse(flagArgs); err != nil {
   273			return nil, err
   274		}
   275		return positional, nil
   276	}
   277	
   278	func isBoolFlag(fs *flag.FlagSet, arg string) bool {
   279		name := strings.TrimPrefix(arg, "--")
   280		if i := strings.IndexByte(name, '='); i >= 0 {
   281			name = name[:i]
   282		}
   283		f := fs.Lookup(name)
   284		if f == nil {
   285			return false
   286		}
   287		type boolFlag interface {
   288			IsBoolFlag() bool
   289		}
   290		bf, ok := f.Value.(boolFlag)
   291		return ok && bf.IsBoolFlag()
   292	}
