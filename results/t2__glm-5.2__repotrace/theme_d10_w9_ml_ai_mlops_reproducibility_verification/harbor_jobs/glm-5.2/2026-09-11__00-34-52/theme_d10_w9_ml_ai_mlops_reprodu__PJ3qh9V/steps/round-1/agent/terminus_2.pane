   166	func isNonNegativeInt(v interface{}) bool {
   167		switch x := v.(type) {
   168		case int:
   169			return x >= 0
   170		case int64:
   171			return x >= 0
   172		case float64:
   173			return x == float64(int64(x)) && x >= 0
   174		default:
   175			return false
   176		}
   177	}
