    79			} else if !isNonNegativeInt(seed) {
    80				result.Errors = append(result.Errors, "invalid environment.seed")
    81			}
    82	
    83			if _, ok := environment["deterministic"].(bool); !ok {
    84				result.Errors = append(result.Errors, "missing required field: environment.deterministic")
    85			}
    86	
    87			if _, ok := environment["gpu_id"].(string); !ok {
    88				result.Warnings = append(result.Warnings, "optional field 'environment.gpu_id' missing")
    89			}
    90			if _, ok := environment["cuda_version"].(string); !ok {
    91				result.Warnings = append(result.Warnings, "optional field 'environment.cuda_version' missing")
    92			}
    93		}
    94	
    95		deps, ok := root["dependencies"].([]map[string]interface{})
    96		if !ok {
    97			result.Errors = append(result.Errors, "missing required field: dependencies")
    98		} else {
    99			for i, dep := range deps {
   100				name, nameOk := dep["name"].(string)
   101				version, versionOk := dep["version"].(string)
