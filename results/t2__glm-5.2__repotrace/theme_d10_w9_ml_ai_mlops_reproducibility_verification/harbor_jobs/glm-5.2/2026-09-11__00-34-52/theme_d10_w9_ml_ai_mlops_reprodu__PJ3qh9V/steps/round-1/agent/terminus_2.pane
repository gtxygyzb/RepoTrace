[?2004lpackage manifest

import (
	"fmt"
	"os"
	"regexp"
	"strconv"
	"strings"
	"time"
)

type Result struct {
	Valid    bool     `json:"valid"`
	Warnings []string `json:"warnings,omitempty"`
	Errors   []string `json:"errors,omitempty"`
}

func Validate(path string) *Result {
	data, err := os.ReadFile(path)
	if err != nil {
		return &Result{
			Valid:  false,
			Errors: []string{fmt.Sprintf("failed to read manifest: %v", err)},
		}
	}

	root, err := parseTOML(string(data))
	if err != nil {
		return &Result{
			Valid:  false,
			Errors: []string{fmt.Sprintf("failed to parse manifest: %v", err)},
		}
	}

	result := &Result{
		Valid:    true,
		Warnings: []string{},
		Errors:   []string{},
	}

	experiment := getTable(root, "experiment")
	environment := getTable(root, "environment")
	outputs := getTable(root, "outputs")

	if experiment == nil {
		result.Errors = append(result.Errors, "missing required field: experiment.name")
		result.Errors = append(result.Errors, "missing required field: experiment.timestamp")
	} else {
		name, ok := experiment["name"].(string)
		if !ok || name == "" {
			result.Errors = append(result.Errors, "missing required field: experiment.name")
		}

		timestamp, ok := experiment["timestamp"].(string)
		if !ok || timestamp == "" {
			result.Errors = append(result.Errors, "missing required field: experiment.timestamp")
		} else if _, err := time.Parse(time.RFC3339, timestamp); err != nil {
			result.Errors = append(result.Errors, "invalid timestamp format")
		}
	}

	if environment == nil {
		result.Errors = append(result.Errors, "missing required field: environment.python_version")
		result.Errors = append(result.Errors, "missing required field: environment.seed")
		result.Errors = append(result.Errors, "missing required field: environment.deterministic")
		result.Warnings = append(result.Warnings, "optional field 'environment.gpu_id' missing")
		result.Warnings = append(result.Warnings, "optional field 'environment.cuda_version' missing")
	} else {
		pythonVersion, ok := environment["python_version"].(string)
		if !ok || pythonVersion == "" {
			result.Errors = append(result.Errors, "missing required field: environment.python_version")
		} else if !pythonVersionRegex.MatchString(pythonVersion) {
			result.Errors = append(result.Errors, "invalid python_version format")
		}

		seed, ok := environment["seed"]
		if !ok {
			result.Errors = append(result.Errors, "missing required field: environment.seed")
		} else if !isNonNegativeInt(seed) {
			result.Errors = append(result.Errors, "invalid environment.seed")
		}

		if _, ok := environment["deterministic"].(bool); !ok {
			result.Errors = append(result.Errors, "missing required field: environment.deterministic")
		}

		if _, ok := environment["gpu_id"].(string); !ok {
			result.Warnings = append(result.Warnings, "optional field 'environment.gpu_id' missing")
		}
		if _, ok := environment["cuda_version"].(string); !ok {
			result.Warnings = append(result.Warnings, "optional field 'environment.cuda_version' missing")
		}
	}

	deps, ok := root["dependencies"].([]map[string]interface{})
	if !ok {
		result.Errors = append(result.Errors, "missing required field: dependencies")
	} else {
		for i, dep := range deps {
			name, nameOk := dep["name"].(string)
			version, versionOk := dep["version"].(string)
			if !nameOk || name == "" {
				result.Errors = append(result.Errors, fmt.Sprintf("invalid dependency at index %d: missing name", i))
			}
			if !versionOk || version == "" {
				result.Errors = append(result.Errors, fmt.Sprintf("invalid dependency at index %d: missing version", i))
			}
		}
	}

	if outputs == nil {
		result.Errors = append(result.Errors, "missing required field: outputs.checkpoint_path")
		result.Errors = append(result.Errors, "missing required field: outputs.metrics")
	} else {
		checkpointPath, ok := outputs["checkpoint_path"].(string)
		if !ok || checkpointPath == "" {
			result.Errors = append(result.Errors, "missing required field: outputs.checkpoint_path")
		}

		metrics := getTable(outputs, "metrics")
		if metrics == nil {
			result.Errors = append(result.Errors, "missing required field: outputs.metrics")
		} else if !hasNumericField(metrics) {
			result.Errors = append(result.Errors, "outputs.metrics must contain at least one numeric field")
		}
	}

	git := getTable(root, "git")
	if git == nil {
		result.Warnings = append(result.Warnings, "optional field 'git.commit' missing")
		result.Warnings = append(result.Warnings, "optional field 'git.branch' missing")
	} else {
		if _, ok := git["commit"].(string); !ok {
			result.Warnings = append(result.Warnings, "optional field 'git.commit' missing")
		}
		if _, ok := git["branch"].(string); !ok {
			result.Warnings = append(result.Warnings, "optional field 'git.branch' missing")
		}
	}

	if len(result.Errors) > 0 {
		result.Valid = false
		result.Warnings = nil
	}
	if result.Valid && len(result.Warnings) == 0 {
		result.Warnings = []string{}
	}

	return result
}

var pythonVersionRegex = regexp.MustCompile(`^\d+\.\d+\.\d+$`)

func getTable(root map[string]interface{}, key string) map[string]interface{} {
	v, ok := root[key]
	if !ok {
		return nil
	}
	m, ok := v.(map[string]interface{})
	if !ok {
		return nil
	}
	return m
}

func isNonNegativeInt(v interface{}) bool {
	switch x := v.(type) {
	case int:
		return x >= 0
	case int64:
		return x >= 0
	case float64:
		return x == float64(int64(x)) && x >= 0
	default:
		return false
	}
}

func hasNumericField(m map[string]interface{}) bool {
	for _, v := range m {
		switch v.(type) {
		case int, int64, float64:
			return true
		}
	}
	return false
}

func parseTOML(data string) (map[string]interface{}, error) {
	root := map[string]interface{}{}
	var current map[string]interface{} = root
	var currentArray []map[string]interface{}

	lines := strings.Split(data, "\n")
	for lineNum, raw := range lines {
		line := strings.TrimSpace(raw)
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}

		if strings.HasPrefix(line, "[[") && strings.HasSuffix(line, "]]") {
			key := strings.TrimSpace(line[2 : len(line)-2])
			parts := strings.Split(key, ".")
			parent := root
			for i := 0; i < len(parts)-1; i++ {
				p := strings.TrimSpace(parts[i])
				next, ok := parent[p]
				if !ok {
					next = map[string]interface{}{}
					parent[p] = next
				}
				parent, ok = next.(map[string]interface{})
				if !ok {
					return nil, fmt.Errorf("line %d: invalid array table path", lineNum+1)
				}
			}
			last := strings.TrimSpace(parts[len(parts)-1])
			arr, ok := parent[last].([]map[string]interface{})
			if !ok {
				arr = []map[string]interface{}{}
			}
			item := map[string]interface{}{}
			arr = append(arr, item)
			parent[last] = arr
			current = item
			currentArray = arr
			continue
		}

		if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
			key := strings.TrimSpace(line[1 : len(line)-1])
			parts := strings.Split(key, ".")
			parent := root
			for i := 0; i < len(parts)-1; i++ {
				p := strings.TrimSpace(parts[i])
				next, ok := parent[p]
				if !ok {
					next = map[string]interface{}{}
					parent[p] = next
				}
				parent, ok = next.(map[string]interface{})
				if !ok {
					return nil, fmt.Errorf("line %d: invalid table path", lineNum+1)
				}
			}
			last := strings.TrimSpace(parts[len(parts)-1])
			tbl, ok := parent[last].(map[string]interface{})
			if !ok {
				tbl = map[string]interface{}{}
				parent[last] = tbl
			}
			current = tbl
			currentArray = nil
			continue
		}

		eq := strings.Index(line, "=")
		if eq < 0 {
			return nil, fmt.Errorf("line %d: expected key = value", lineNum+1)
		}
[?2004hroot@n30009:/app# sed -n '1,320p' internal/app/app.go
[?2004lpackage app

import (
	"encoding/json"
	"flag"
	"fmt"
	"os"
	"strings"

	"repro-verify/internal/compare"
	"repro-verify/internal/drift"
	"repro-verify/internal/lineage"
	"repro-verify/internal/manifest"
	"repro-verify/internal/merge"
	"repro-verify/internal/mlck"
	"repro-verify/internal/report"
)

func Run() int {
	if len(os.Args) < 2 {
		outputJSON(map[string]interface{}{"error": "no subcommand provided"})
		return 1
	}

	switch os.Args[1] {
	case "verify-checkpoint":
		return runVerifyCheckpoint(os.Args[2:])
	case "compare-outputs":
		return runCompareOutputs(os.Args[2:])
	case "validate-manifest":
		return runValidateManifest(os.Args[2:])
	case "audit-lineage":
		return runAuditLineage(os.Args[2:])
	case "generate-report":
		return runGenerateReport(os.Args[2:])
	case "merge-checkpoints":
		return runMergeCheckpoints(os.Args[2:])
	case "drift-analysis":
		return runDriftAnalysis(os.Args[2:])
	default:
		outputJSON(map[string]interface{}{"error": fmt.Sprintf("unknown subcommand: %s", os.Args[1])})
		return 1
	}
}

func runVerifyCheckpoint(args []string) int {
	if len(args) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify verify-checkpoint <file>"})
		return 1
	}

	cp, err := mlck.ParseFile(args[0])
	if err != nil {
		outputJSON(map[string]interface{}{
			"valid": false,
			"error": err.Error(),
		})
		return 1
	}

	metadata := cp.Metadata
	if metadata == nil {
		metadata = map[string]interface{}{}
	}
	tensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))
	for _, t := range cp.Tensors {
		tensors = append(tensors, t.Info())
	}

	outputJSON(map[string]interface{}{
		"valid":          true,
		"format_version": int(cp.Version),
		"num_tensors":    len(cp.Tensors),
		"metadata":       metadata,
		"tensors":        tensors,
		"file_checksum":  cp.FileChecksum,
	})
	return 0
}

func runCompareOutputs(args []string) int {
	fs := flag.NewFlagSet("compare-outputs", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	atol := fs.Float64("atol", 1e-7, "absolute tolerance")
	rtol := fs.Float64("rtol", 1e-5, "relative tolerance")
	mode := fs.String("mode", "strict", "comparison mode")

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) != 2 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify compare-outputs <file1> <file2> [flags]"})
		return 1
	}

	c1, err := mlck.ParseFile(pos[0])
	if err != nil {
		outputJSON(map[string]interface{}{
			"match":            false,
			"mode":             *mode,
			"atol":             *atol,
			"rtol":             *rtol,
			"tensor_results":   []interface{}{},
			"missing_in_file1": []string{},
			"missing_in_file2": []string{},
			"error":            fmt.Sprintf("file1: %v", err),
		})
		return 1
	}

	c2, err := mlck.ParseFile(pos[1])
	if err != nil {
		outputJSON(map[string]interface{}{
			"match":            false,
			"mode":             *mode,
			"atol":             *atol,
			"rtol":             *rtol,
			"tensor_results":   []interface{}{},
			"missing_in_file1": []string{},
			"missing_in_file2": []string{},
			"error":            fmt.Sprintf("file2: %v", err),
		})
		return 1
	}

	res, err := compare.Compare(c1, c2, *mode, *atol, *rtol)
	if err != nil {
		outputJSON(map[string]interface{}{
			"match":            false,
			"mode":             *mode,
			"atol":             *atol,
			"rtol":             *rtol,
			"tensor_results":   []interface{}{},
			"missing_in_file1": []string{},
			"missing_in_file2": []string{},
			"error":            err.Error(),
		})
		return 1
	}

	outputJSON(res)
	if res.Match {
		return 0
	}
	return 1
}

func runValidateManifest(args []string) int {
	if len(args) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify validate-manifest <file.toml>"})
		return 1
	}
	res := manifest.Validate(args[0])
	outputJSON(res)
	if res.Valid {
		return 0
	}
	return 1
}

func runAuditLineage(args []string) int {
	if len(args) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify audit-lineage <file.json>"})
		return 1
	}
	res := lineage.Audit(args[0])
	outputJSON(res)
	if res.Valid {
		return 0
	}
	return 1
}

func runGenerateReport(args []string) int {
	fs := flag.NewFlagSet("generate-report", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	checkpoint := fs.String("checkpoint", "", "checkpoint file to verify")
	comparePath := fs.String("compare", "", "second checkpoint to compare")
	lineagePath := fs.String("lineage", "", "lineage file to audit")

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify generate-report <manifest.toml> [flags]"})
		return 1
	}

	rep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)
	outputJSON(rep)
	return code
}

func runMergeCheckpoints(args []string) int {
	fs := flag.NewFlagSet("merge-checkpoints", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	conflict := fs.String("conflict", "first", "conflict strategy")

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) < 3 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]"})
		return 1
	}

	res, err := merge.Merge(pos[0], pos[1:], *conflict)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	outputJSON(res)
	return 0
}

func runDriftAnalysis(args []string) int {
	fs := flag.NewFlagSet("drift-analysis", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) < 2 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]"})
		return 1
	}

	res, err := drift.Analyze(pos)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	outputJSON(res)
	return 0
}

func parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {
	var positional []string
	var flagArgs []string

	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			positional = append(positional, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if strings.Contains(arg, "=") {
				flagArgs = append(flagArgs, arg)
				continue
			}
			if i+1 >= len(args) {
				return nil, fmt.Errorf("flag %s requires a value", arg)
			}
			flagArgs = append(flagArgs, arg+"="+args[i+1])
			i++
		} else {
			positional = append(positional, arg)
		}
	}

	if err := fs.Parse(flagArgs); err != nil {
		return nil, err
	}
	return positional, nil
}

func outputJSON(v interface{}) {
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	_ = enc.Encode(v)
}
