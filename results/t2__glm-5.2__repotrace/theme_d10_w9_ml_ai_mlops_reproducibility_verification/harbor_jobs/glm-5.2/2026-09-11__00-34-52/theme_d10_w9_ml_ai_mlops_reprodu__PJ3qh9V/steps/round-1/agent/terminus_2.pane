			result.Errors = append(result.Errors, fmt.Sprintf("cycle detected involving: %s", strings.Join(cycle, ", ")))
		}
	}

	if len(result.Errors) == 0 {
		for _, e := range exps {
			childTime, ok := times[e.ID]
			if !ok {
				continue
			}
			for _, p := range e.Parents {
