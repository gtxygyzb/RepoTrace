   204				parent := root
   205				for i := 0; i < len(parts)-1; i++ {
   206					p := strings.TrimSpace(parts[i])
   207					next, ok := parent[p]
   208					if !ok {
   209						next = map[string]interface{}{}
   210						parent[p] = next
   211					}
   212					parent, ok = next.(map[string]interface{})
   213					if !ok {
   214						return nil, fmt.Errorf("line %d: invalid array table path", lineNum+1)
   215					}
   216				}
   217				last := strings.TrimSpace(parts[len(parts)-1])
   218				arr, ok := parent[last].([]map[string]interface{})
   219				if !ok {
   220					arr = []map[string]interface{}{}
   221				}
   222				item := map[string]interface{}{}
   223				arr = append(arr, item)
   224				parent[last] = arr
   225				current = item
   226				currentArray = arr
   227				continue
   228			}
   229	
   230			if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
   231				key := strings.TrimSpace(line[1 : len(line)-1])
   232				parts := strings.Split(key, ".")
   233				parent := root
   234				for i := 0; i < len(parts)-1; i++ {
   235					p := strings.TrimSpace(parts[i])
   236					next, ok := parent[p]
   237					if !ok {
   238						next = map[string]interface{}{}
   239						parent[p] = next
   240					}
   241					parent, ok = next.(map[string]interface{})
   242					if !ok {
   243						return nil, fmt.Errorf("line %d: invalid table path", lineNum+1)
   244					}
   245				}
   246				last := strings.TrimSpace(parts[len(parts)-1])
   247				tbl, ok := parent[last].(map[string]interface{})
   248				if !ok {
   249					tbl = map[string]interface{}{}
   250					parent[last] = tbl
   251				}
   252				current = tbl
   253				currentArray = nil
   254				continue
   255			}
   256	
   257			eq := strings.Index(line, "=")
   258			if eq < 0 {
   259				return nil, fmt.Errorf("line %d: expected key = value", lineNum+1)
   260			}
   261			key := strings.TrimSpace(line[:eq])
   262			valueStr := strings.TrimSpace(line[eq+1:])
   263			value, err := parseTOMLValue(valueStr)
   264			if err != nil {
   265				return nil, fmt.Errorf("line %d: %v", lineNum+1, err)
   266			}
   267			_ = currentArray
   268			current[key] = value
   269		}
   270	
   271		return root, nil
   272	}
   273	
   274	func parseTOMLValue(s string) (interface{}, error) {
   275		if s == "true" {
   276			return true, nil
   277		}
   278		if s == "false" {
   279			return false, nil
   280		}
   281		if len(s) >= 2 && (s[0] == '"' && s[len(s)-1] == '"' || s[0] == '\'' && s[len(s)-1] == '\'') {
   282			return s[1 : len(s)-1], nil
   283		}
   284		if strings.HasPrefix(s, "[") && strings.HasSuffix(s, "]") {
   285			inner := strings.TrimSpace(s[1 : len(s)-1])
   286			if inner == "" {
   287				return []interface{}{}, nil
   288			}
   289			parts := splitArrayElements(inner)
   290			arr := make([]interface{}, 0, len(parts))
   291			for _, p := range parts {
   292				v, err := parseTOMLValue(strings.TrimSpace(p))
   293				if err != nil {
   294					return nil, err
   295				}
   296				arr = append(arr, v)
   297			}
   298			return arr, nil
   299		}
   300		if strings.HasPrefix(s, "{") && strings.HasSuffix(s, "}") {
   301			inner := strings.TrimSpace(s[1 : len(s)-1])
   302			m := map[string]interface{}{}
   303			if inner == "" {
   304				return m, nil
   305			}
   306			parts := splitArrayElements(inner)
   307			for _, p := range parts {
   308				kv := strings.SplitN(p, "=", 2)
   309				if len(kv) != 2 {
   310					return nil, fmt.Errorf("invalid inline table entry: %s", p)
   311				}
   312				k := strings.TrimSpace(kv[0])
   313				v, err := parseTOMLValue(strings.TrimSpace(kv[1]))
   314				if err != nil {
   315					return nil, err
   316				}
   317				m[k] = v
   318			}
   319			return m, nil
   320		}
   321		if i, err := strconv.ParseInt(s, 10, 64); err == nil {
   322			return i, nil
   323		}
   324		if f, err := strconv.ParseFloat(s, 64); err == nil {
   325			return f, nil
   326		}
   327		return nil, fmt.Errorf("invalid value: %s", s)
   328	}
   329	
   330	func splitArrayElements(s string) []string {
   331		var parts []string
   332		depth := 0
   333		quote := byte(0)
   334		start := 0
   335		for i := 0; i < len(s); i++ {
   336			c := s[i]
   337			if quote != 0 {
   338				if c == quote {
   339					quote = 0
   340				}
   341				continue
   342			}
   343			if c == '"' || c == '\'' {
   344				quote = c
   345				continue
   346			}
   347			if c == '[' || c == '{' {
   348				depth++
   349			} else if c == ']' || c == '}' {
   350				depth--
   351			} else if c == ',' && depth == 0 {
   352				parts = append(parts, s[start:i])
   353				start = i + 1
   354			}
   355		}
   356		parts = append(parts, s[start:])
   357		return parts
   358	}
