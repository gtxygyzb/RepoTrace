   163	func runGenerateReport(args []string) int {
   164		fs := flag.NewFlagSet("generate-report", flag.ContinueOnError)
   165		fs.SetOutput(io.Discard)
   166		checkpoint := fs.String("checkpoint", "", "checkpoint file to verify")
   167		comparePath := fs.String("compare", "", "second checkpoint to compare")
   168		lineagePath := fs.String("lineage", "", "lineage file to audit")
   169	
   170		pos, err := parseMixedArgs(fs, args)
   171		if err != nil {
   172			outputJSON(map[string]interface{}{"error": err.Error()})
   173			return 1
   174		}
   175		if len(pos) != 1 {
   176			outputJSON(map[string]interface{}{"error": "usage: repro-verify generate-report <manifest.toml> [flags]"})
   177			return 1
   178		}
   179	
   180		for _, p := range []string{pos[0], *checkpoint, *comparePath, *lineagePath} {
   181			if p == "" {
   182				continue
   183			}
   184			if _, err := os.ReadFile(p); err != nil {
   185				outputJSON(map[string]interface{}{"error": err.Error()})
   186				return 1
   187			}
   188		}
   189	
   190		rep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)
   191		outputJSON(rep)
   192		return code
   193	}
   194	
   195	func runMergeCheckpoints(args []string) int {
   196		fs := flag.NewFlagSet("merge-checkpoints", flag.ContinueOnError)
   197		fs.SetOutput(io.Discard)
   198		conflict := fs.String("conflict", "first", "conflict strategy")
   199	
   200		pos, err := parseMixedArgs(fs, args)
   201		if err != nil {
   202			outputJSON(map[string]interface{}{"error": err.Error()})
   203			return 1
   204		}
   205		if len(pos) < 3 {
   206			outputJSON(map[string]interface{}{"error": "usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]"})
   207			return 1
   208		}
   209	
   210		res, err := merge.Merge(pos[0], pos[1:], *conflict)
   211		if err != nil {
   212			outputJSON(map[string]interface{}{"error": err.Error()})
   213			return 1
   214		}
   215		outputJSON(res)
   216		return 0
   217	}
   218	
   219	func runDriftAnalysis(args []string) int {
   220		fs := flag.NewFlagSet("drift-analysis", flag.ContinueOnError)
   221		fs.SetOutput(io.Discard)
