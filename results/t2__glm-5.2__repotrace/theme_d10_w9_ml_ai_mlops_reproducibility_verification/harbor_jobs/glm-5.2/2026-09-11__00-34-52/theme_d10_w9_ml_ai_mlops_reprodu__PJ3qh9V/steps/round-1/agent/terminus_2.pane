   121							}
   122						}
   123						rep.Comparison = &ComparisonPart{
   124							Match:   res.Match,
   125							Summary: fmt.Sprintf("%d/%d tensors differ", differ, total),
   126						}
   127						if !res.Match {
   128							comparisonMatch = false
   129							if differ > 0 {
   130								issues = append(issues, fmt.Sprintf("Tensor comparison failed: %d tensors differ beyond tolerance", differ))
   131							} else {
   132								issues = append(issues, "Tensor comparison failed: missing tensors or shape mismatch")
   133							}
   134						}
   135					}
   136				}
   137			}
   138		}
   139	
   140		lineageValid := true
   141		if lineagePath != "" {
   142			lin := lineage.Audit(lineagePath)
   143			if lin.Valid {
   144				rep.Lineage = &LineagePart{
   145					Valid: true,
   146					Depth: lin.MaxDepth,
   147				}
   148			} else {
   149				lineageValid = false
   150				rep.Lineage = &LineagePart{
   151					Valid: false,
   152					Error: strings.Join(lin.Errors, "; "),
   153				}
   154				issues = append(issues, fmt.Sprintf("Lineage audit failed: %s", strings.Join(lin.Errors, "; ")))
   155			}
   156		}
   157	
   158		overall := man.Valid && checkpointValid && comparisonMatch && lineageValid
   159		rep.OverallReproducible = overall
   160		rep.Issues = issues
   161	
   162		if overall {
   163			return rep, 0
   164		}
   165		return rep, 1
   166	}
