   184	func applyTopK(result *Result, topK *int) {
   185		if topK == nil {
   186			return
   187		}
   188	
   189		requested := *topK
   190		sort.SliceStable(result.Tensors, func(i, j int) bool {
   191			if result.Tensors[i].StabilityScore != result.Tensors[j].StabilityScore {
   192				return result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore
   193			}
   194			return result.Tensors[i].Name < result.Tensors[j].Name
   195		})
   196		if requested < len(result.Tensors) {
   197			result.Tensors = result.Tensors[:requested]
   198		}
   199		result.TopK = &requested
   200	}
