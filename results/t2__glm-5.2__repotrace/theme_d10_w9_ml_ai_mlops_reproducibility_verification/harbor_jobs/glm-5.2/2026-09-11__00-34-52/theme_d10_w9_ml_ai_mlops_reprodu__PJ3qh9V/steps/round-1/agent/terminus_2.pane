// Analyze remains available for callers that do not need a top-k restriction.
func Analyze(files []string) (*Result, error) {
        return AnalyzeWithTopK(files, 0)
}

// AnalyzeWithTopK analyzes drift and optionally restricts the returned tensor
// list to the N tensors with the lowest stability scores. When topK > 0 the
// result includes a top_k field set to the requested N, even if fewer tensors
// are returned.
func AnalyzeWithTopK(files []string, topK int) (*Result, error) {
        return analyzeWithTopK(files, topK)
}

