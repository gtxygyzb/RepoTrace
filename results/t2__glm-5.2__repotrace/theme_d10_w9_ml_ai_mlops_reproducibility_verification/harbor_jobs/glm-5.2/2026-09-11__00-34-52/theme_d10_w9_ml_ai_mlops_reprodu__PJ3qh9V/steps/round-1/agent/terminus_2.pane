   220	func runDriftAnalysis(args []string) int {
   221		fs := flag.NewFlagSet("drift-analysis", flag.ContinueOnError)
   222		fs.SetOutput(io.Discard)
   223	
   224		topK := fs.Int("top-k", 0, "number of tensors with the lowest stability scores to include")
   225	
   226		pos, err := parseMixedArgs(fs, args)
   227		if err != nil {
   228			outputJSON(map[string]interface{}{"error": err.Error()})
   229			return 1
   230		}
   231		if len(pos) < 2 {
   232			outputJSON(map[string]interface{}{"error": "usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]"})
   233			return 1
   234		}
   235	
   236		var topKPtr *int
   237		fs.Visit(func(f *flag.Flag) {
   238			if f.Name == "top-k" {
   239				v := *topK
   240				topKPtr = &v
   241			}
   242		})
   243		if topKPtr != nil && *topKPtr < 0 {
   244			outputJSON(map[string]interface{}{"error": "--top-k must be non-negative"})
   245			return 1
   246		}
   247	
   248		res, err := drift.AnalyzeWithTopK(pos, topKPtr)
   249		if err != nil {
   250			outputJSON(map[string]interface{}{"error": err.Error()})
   251			return 1
   252		}
   253		outputJSON(res)
   254		return 0
   255	}
   256	
   257	func parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {
   258		var positional []string
   259		var flagArgs []string
   260	
   261		for i := 0; i < len(args); i++ {
   262			arg := args[i]
   263			if arg == "--" {
   264				positional = append(positional, args[i+1:]...)
   265				break
   266			}
   267			if strings.HasPrefix(arg, "--") {
   268				if strings.Contains(arg, "=") {
   269					flagArgs = append(flagArgs, arg)
   270					continue
   271				}
   272				if isBoolFlag(fs, arg) {
   273					flagArgs = append(flagArgs, arg+"=true")
   274					continue
   275				}
   276				if i+1 >= len(args) {
   277					return nil, fmt.Errorf("flag %s requires a value", arg)
   278				}
   279				flagArgs = append(flagArgs, arg+"="+args[i+1])
   280				i++
   281			} else {
   282				positional = append(positional, arg)
   283			}
   284		}
   285	
   286		if err := fs.Parse(flagArgs); err != nil {
   287			return nil, err
   288		}
   289		return positional, nil
   290	}
   291	
   292	func isBoolFlag(fs *flag.FlagSet, arg string) bool {
   293		name := strings.TrimPrefix(arg, "--")
   294		if i := strings.IndexByte(name, '='); i >= 0 {
   295			name = name[:i]
   296		}
   297		f := fs.Lookup(name)
   298		if f == nil {
   299			return false
   300		}
   301		type boolFlag interface {
   302			IsBoolFlag() bool
   303		}
   304		bf, ok := f.Value.(boolFlag)
   305		return ok && bf.IsBoolFlag()
   306	}
   307	
   308	func outputJSON(v interface{}) {
   309		enc := json.NewEncoder(os.Stdout)
   310		enc.SetIndent("", "  ")
   311		enc.SetEscapeHTML(false)
   312		_ = enc.Encode(v)
   313	}
