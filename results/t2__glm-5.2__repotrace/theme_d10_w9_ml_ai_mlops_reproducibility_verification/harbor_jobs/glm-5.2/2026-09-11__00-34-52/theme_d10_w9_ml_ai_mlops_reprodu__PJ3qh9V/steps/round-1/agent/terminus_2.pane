	"encoding/json"
	"flag"
	"fmt"
	"io"
	"os"
	"strings"

	"repro-verify/internal/compare"
	"repro-verify/internal/drift"
	"repro-verify/internal/lineage"
	"repro-verify/internal/manifest"
	"repro-verify/internal/merge"
	"repro-verify/internal/mlck"
	"repro-verify/internal/report"
)

func Run() int {
	if len(os.Args) < 2 {
		outputJSON(map[string]interface{}{"error": "no subcommand provided"})
		return 1
	}

	switch os.Args[1] {
	case "verify-checkpoint":
		return runVerifyCheckpoint(os.Args[2:])
	case "compare-outputs":
		return runCompareOutputs(os.Args[2:])
	case "validate-manifest":
		return runValidateManifest(os.Args[2:])
	case "audit-lineage":
		return runAuditLineage(os.Args[2:])
	case "generate-report":
		return runGenerateReport(os.Args[2:])
	case "merge-checkpoints":
		return runMergeCheckpoints(os.Args[2:])
	case "drift-analysis":
		return runDriftAnalysis(os.Args[2:])
	default:
		outputJSON(map[string]interface{}{"error": fmt.Sprintf("unknown subcommand: %s", os.Args[1])})
		return 1
	}
}

func runVerifyCheckpoint(args []string) int {
	if len(args) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify verify-checkpoint <file>"})
		return 1
	}

	if _, err := os.ReadFile(args[0]); err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}

	cp, err := mlck.ParseFile(args[0])
	if err != nil {
		outputJSON(map[string]interface{}{
			"valid": false,
			"error": err.Error(),
		})
		return 1
	}

	metadata := cp.Metadata
	if metadata == nil {
		metadata = map[string]interface{}{}
	}
	tensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))
	for _, t := range cp.Tensors {
		tensors = append(tensors, t.Info())
	}

	outputJSON(map[string]interface{}{
		"valid":          true,
		"format_version": int(cp.Version),
		"num_tensors":    len(cp.Tensors),
		"metadata":       metadata,
		"tensors":        tensors,
		"file_checksum":  cp.FileChecksum,
	})
	return 0
}

func runCompareOutputs(args []string) int {
	fs := flag.NewFlagSet("compare-outputs", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	atol := fs.Float64("atol", 1e-7, "absolute tolerance")
	rtol := fs.Float64("rtol", 1e-5, "relative tolerance")
	mode := fs.String("mode", "strict", "comparison mode")
	histogram := fs.Bool("histogram", false, "include diff histograms")

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) != 2 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify compare-outputs <file1> <file2> [flags]"})
		return 1
	}

	c1, err := mlck.ParseFile(pos[0])
	if err != nil {
		outputJSON(map[string]interface{}{"error": fmt.Sprintf("file1: %v", err)})
		return 1
	}

	c2, err := mlck.ParseFile(pos[1])
	if err != nil {
		outputJSON(map[string]interface{}{"error": fmt.Sprintf("file2: %v", err)})
		return 1
	}

	res, err := compare.Compare(c1, c2, *mode, *atol, *rtol, *histogram)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}

	outputJSON(res)
	if res.Match {
		return 0
	}
	return 1
}

func runValidateManifest(args []string) int {
	if len(args) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify validate-manifest <file.toml>"})
		return 1
	}
	if _, err := os.ReadFile(args[0]); err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	res := manifest.Validate(args[0])
	outputJSON(res)
	if res.Valid {
		return 0
	}
	return 1
}

func runAuditLineage(args []string) int {
	if len(args) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify audit-lineage <file.json>"})
		return 1
	}
	if _, err := os.ReadFile(args[0]); err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	res := lineage.Audit(args[0])
	outputJSON(res)
	if res.Valid {
		return 0
	}
	return 1
}

func runGenerateReport(args []string) int {
	fs := flag.NewFlagSet("generate-report", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	checkpoint := fs.String("checkpoint", "", "checkpoint file to verify")
	comparePath := fs.String("compare", "", "second checkpoint to compare")
	lineagePath := fs.String("lineage", "", "lineage file to audit")

	pos, err := parseMixedArgs(fs, args)
	if err != nil {
		outputJSON(map[string]interface{}{"error": err.Error()})
		return 1
	}
	if len(pos) != 1 {
		outputJSON(map[string]interface{}{"error": "usage: repro-verify generate-report <manifest.toml> [flags]"})
		return 1
	}

	for _, p := range []string{pos[0], *checkpoint, *comparePath, *lineagePath} {
		if p == "" {
			continue
		}
		if _, err := os.ReadFile(p); err != nil {
			outputJSON(map[string]interface{}{"error": err.Error()})
			return 1
		}
	}

[?2004hroot@n30009:/app# sed -n '1,180p' internal/report/report.go
[?2004lpackage report

import (
	"fmt"
	"strings"
	"time"

	"repro-verify/internal/compare"
	"repro-verify/internal/lineage"
	"repro-verify/internal/manifest"
	"repro-verify/internal/mlck"
)

type ManifestPart struct {
	Valid    bool     `json:"valid"`
	Warnings []string `json:"warnings,omitempty"`
	Errors   []string `json:"errors,omitempty"`
}

type CheckpointPart struct {
	Valid        bool   `json:"valid"`
	NumTensors   int    `json:"num_tensors"`
	FileChecksum string `json:"file_checksum"`
	Error        string `json:"error,omitempty"`
}

type ComparisonPart struct {
	Match   bool   `json:"match"`
	Summary string `json:"summary,omitempty"`
	Error   string `json:"error,omitempty"`
}

type LineagePart struct {
	Valid  bool     `json:"valid"`
	Depth  int      `json:"depth"`
	Errors []string `json:"errors,omitempty"`
}

type Report struct {
	ReportVersion       string          `json:"report_version"`
	Timestamp           string          `json:"timestamp"`
	Manifest            ManifestPart    `json:"manifest"`
	Checkpoint          *CheckpointPart `json:"checkpoint,omitempty"`
	Comparison          *ComparisonPart `json:"comparison,omitempty"`
	Lineage             *LineagePart    `json:"lineage,omitempty"`
	OverallReproducible bool            `json:"overall_reproducible"`
	Issues              []string        `json:"issues"`
}

func Generate(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {
	issues := []string{}
	rep := &Report{
		ReportVersion: "1.0",
		Timestamp:     time.Now().Format(time.RFC3339),
		Issues:        issues,
	}

	man := manifest.Validate(manifestPath)
	rep.Manifest = ManifestPart{
		Valid:    man.Valid,
		Warnings: man.Warnings,
		Errors:   man.Errors,
	}
	if !man.Valid {
		issues = append(issues, fmt.Sprintf("Manifest validation failed: %s", strings.Join(man.Errors, "; ")))
	}

	checkpointValid := true
	if checkpointPath != "" {
		cp, err := mlck.ParseFile(checkpointPath)
		if err != nil {
			checkpointValid = false
			rep.Checkpoint = &CheckpointPart{
				Valid: false,
				Error: err.Error(),
			}
			issues = append(issues, fmt.Sprintf("Checkpoint verification failed: %v", err))
		} else {
			rep.Checkpoint = &CheckpointPart{
				Valid:        true,
				NumTensors:   len(cp.Tensors),
				FileChecksum: cp.FileChecksum,
			}
		}
	}

	comparisonMatch := true
	if checkpointPath != "" && comparePath != "" {
		c1, err := mlck.ParseFile(checkpointPath)
		if err != nil {
			comparisonMatch = false
			rep.Comparison = &ComparisonPart{
				Match: false,
				Error: fmt.Sprintf("checkpoint parse failed: %v", err),
			}
			issues = append(issues, fmt.Sprintf("Comparison failed: %v", err))
		} else {
			c2, err := mlck.ParseFile(comparePath)
			if err != nil {
				comparisonMatch = false
				rep.Comparison = &ComparisonPart{
					Match: false,
					Error: fmt.Sprintf("compare checkpoint parse failed: %v", err),
				}
				issues = append(issues, fmt.Sprintf("Comparison failed: %v", err))
			} else {
				res, err := compare.Compare(c1, c2, "strict", 1e-7, 1e-5, false)
				if err != nil {
					comparisonMatch = false
					rep.Comparison = &ComparisonPart{
						Match: false,
						Error: err.Error(),
					}
					issues = append(issues, fmt.Sprintf("Comparison failed: %v", err))
				} else {
					differ := 0
					total := len(res.TensorResults)
					for _, tr := range res.TensorResults {
						if !tr.Match {
							differ++
						}
					}
					missing := len(res.MissingInFile1) + len(res.MissingInFile2)
					summary := fmt.Sprintf("%d/%d tensors differ", differ, total)
					if missing > 0 {
						summary = fmt.Sprintf("%s, %d tensors missing", summary, missing)
					}
					rep.Comparison = &ComparisonPart{
						Match:   res.Match,
						Summary: summary,
					}
					if !res.Match {
						comparisonMatch = false
						issues = append(issues, fmt.Sprintf("Tensor comparison failed: %s", summary))
					}
				}
			}
		}
	}

	lineageValid := true
	if lineagePath != "" {
		lin := lineage.Audit(lineagePath)
		if lin.Valid {
			rep.Lineage = &LineagePart{
				Valid: true,
				Depth: lin.MaxDepth,
			}
		} else {
			lineageValid = false
			rep.Lineage = &LineagePart{
				Valid:  false,
				Errors: lin.Errors,
			}
			issues = append(issues, fmt.Sprintf("Lineage audit failed: %s", strings.Join(lin.Errors, "; ")))
		}
	}

	overall := man.Valid && checkpointValid && comparisonMatch && lineageValid
	rep.OverallReproducible = overall
	rep.Issues = issues

	if overall {
		return rep, 0
	}
	return rep, 1
}
