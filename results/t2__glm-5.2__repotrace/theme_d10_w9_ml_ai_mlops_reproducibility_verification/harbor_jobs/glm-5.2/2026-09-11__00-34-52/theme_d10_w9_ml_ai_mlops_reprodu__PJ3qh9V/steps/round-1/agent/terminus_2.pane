    51				result.Errors = append(result.Errors, "missing required field: experiment.name")
    52			}
    53	
    54			timestamp, ok := experiment["timestamp"].(string)
    55			if !ok || timestamp == "" {
    56				result.Errors = append(result.Errors, "missing required field: experiment.timestamp")
    57			} else if _, err := time.Parse(time.RFC3339, timestamp); err != nil {
    58				result.Errors = append(result.Errors, "invalid timestamp format")
    59			}
    60		}
    61	
    62		if environment == nil {
    63			result.Errors = append(result.Errors, "missing required field: environment.python_version")
    64			result.Errors = append(result.Errors, "missing required field: environment.seed")
    65			result.Errors = append(result.Errors, "missing required field: environment.deterministic")
    66			result.Warnings = append(result.Warnings, "optional field 'environment.gpu_id' missing")
    67			result.Warnings = append(result.Warnings, "optional field 'environment.cuda_version' missing")
    68		} else {
