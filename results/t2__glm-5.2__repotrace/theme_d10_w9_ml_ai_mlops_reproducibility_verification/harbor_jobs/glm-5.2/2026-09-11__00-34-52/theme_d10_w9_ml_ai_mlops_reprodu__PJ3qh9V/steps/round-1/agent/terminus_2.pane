// AnalyzeWithTopK analyzes drift and optionally restricts the returned tensor
// list to the N tensors with the lowest stability scores. When topK > 0 the
// result includes a top_k field set to the requested N, even if fewer tensors
// are returned. When threshold is non-nil, each tensor result includes a
// drifting field, and the top-level result includes drift_threshold and
// num_drifting_tensors. The count reflects all analyzed tensors, not just those
// returned after top-k filtering.
func AnalyzeWithTopK(files []string, topK *int, threshold *float64) (*Result, error) {
'''
