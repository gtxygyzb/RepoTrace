   164	func runGenerateReport(args []string) int {
   165		fs := flag.NewFlagSet("generate-report", flag.ContinueOnError)
   166		fs.SetOutput(io.Discard)
   167		checkpoint := fs.String("checkpoint", "", "checkpoint file to verify")
   168		comparePath := fs.String("compare", "", "second checkpoint to compare")
   169		lineagePath := fs.String("lineage", "", "lineage file to audit")
   170	
   171		pos, err := parseMixedArgs(fs, args)
   172		if err != nil {
   173			outputJSON(map[string]interface{}{"error": err.Error()})
   174			return 1
   175		}
   176		if len(pos) != 1 {
   177			outputJSON(map[string]interface{}{"error": "usage: repro-verify generate-report <manifest.toml> [flags]"})
   178			return 1
   179		}
   180	
   181		for _, p := range []string{pos[0], *checkpoint, *comparePath, *lineagePath} {
   182			if p == "" {
   183				continue
   184			}
   185			if _, err := os.ReadFile(p); err != nil {
   186				outputJSON(map[string]interface{}{"error": err.Error()})
   187				return 1
   188			}
   189		}
   190	
   191		rep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)
   192		outputJSON(rep)
   193		return code
   194	}
   195	
   196	func runMergeCheckpoints(args []string) int {
   197		fs := flag.NewFlagSet("merge-checkpoints", flag.ContinueOnError)
   198		fs.SetOutput(io.Discard)
   199		conflict := fs.String("conflict", "first", "conflict strategy")
   200	
   201		pos, err := parseMixedArgs(fs, args)
   202		if err != nil {
   203			outputJSON(map[string]interface{}{"error": err.Error()})
   204			return 1
   205		}
   206		if len(pos) < 3 {
   207			outputJSON(map[string]interface{}{"error": "usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]"})
   208			return 1
   209		}
   210	
   211		res, err := merge.Merge(pos[0], pos[1:], *conflict)
   212		if err != nil {
   213			outputJSON(map[string]interface{}{"error": err.Error()})
   214			return 1
   215		}
   216		outputJSON(res)
   217		return 0
   218	}
   219	
   220	func runDriftAnalysis(args []string) int {
   221		fs := flag.NewFlagSet("drift-analysis", flag.ContinueOnError)
   222		fs.SetOutput(io.Discard)
   223	
   224		topK := fs.Int("top-k", 0, "number of tensors with the lowest stability scores to include")
   225		threshold := fs.Float64("threshold", 0, "max change threshold above which a tensor is considered drifting")
   226	
   227		pos, err := parseMixedArgs(fs, args)
   228		if err != nil {
   229			outputJSON(map[string]interface{}{"error": err.Error()})
   230			return 1
   231		}
   232		if len(pos) < 2 {
   233			outputJSON(map[string]interface{}{"error": "usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]"})
   234			return 1
   235		}
   236	
   237		var topKPtr *int
   238		var thresholdPtr *float64
   239		fs.Visit(func(f *flag.Flag) {
   240			if f.Name == "top-k" {
   241				v := *topK
   242				topKPtr = &v
   243			}
   244			if f.Name == "threshold" {
   245				v := *threshold
   246				thresholdPtr = &v
   247			}
   248		})
   249		if topKPtr != nil && *topKPtr < 0 {
   250			outputJSON(map[string]interface{}{"error": "--top-k must be non-negative"})
   251			return 1
   252		}
   253	
   254		res, err := drift.AnalyzeWithTopK(pos, topKPtr, thresholdPtr)
   255		if err != nil {
   256			outputJSON(map[string]interface{}{"error": err.Error()})
   257			return 1
   258		}
   259		outputJSON(res)
   260		return 0
