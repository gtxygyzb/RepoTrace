[5588.058157, "o", "\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"timestamp violation: %s (%s) has parent %s (%s)\", e.ID, childTime.Format(\"2006-01-02\"), p, parentTime.Format(\"2006-01-02\")))\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif len(result.Errors) > 0 {\r\n\t\tresult.Valid = false\r\n\t\tresult.TopologicalOrder = nil\r\n\t\treturn result\r\n\t}\r\n\r\n\tchildren := make(map[string][]string)\r\n\tfor _, e := range exps {\r\n\t\tfor _, p := range e.Parents {\r\n\t\t\tchildren[p] = append(children[p], e.ID)\r\n\t\t}\r\n\t}\r\n\r\n"]
[5588.058274, "o", "\troots := make([]string, 0)\r\n\tleaves := make([]string, 0)\r\n\tfor _, e := range exps {\r\n\t\tif len(e.Parents) == 0 {\r\n\t\t\troots = append(roots, e.ID)\r\n\t\t}\r\n\t\tif len(children[e.ID]) == 0 {\r\n\t\t\tleaves = append(leaves, e.ID)\r\n\t\t}\r\n\t}\r\n\r\n\tvisited := make(map[string]bool)\r\n\tvar post []string\r\n\tvar dfs func(id string)\r\n\tdfs = func(id string) {\r\n\t\tvisited[id] = true\r\n"]
[5588.05834, "o", "\t\tfor _, child := range children[id] {\r\n\t\t\tif !visited[child] {\r\n\t\t\t\tdfs(child)\r\n\t\t\t}\r\n\t\t}\r\n\t\tpost = append(post, id)\r\n\t}\r\n\tfor _, e := range exps {\r\n\t\tif !visited[e.ID] {\r\n\t\t\tdfs(e.ID)\r\n\t"]
[5588.058411, "o", "\t}\r\n\t}\r\n\ttopo := make([]string, len(post))\r\n\tfor i := range post {\r\n\t\ttopo[i] = post[len(post)-1-i]\r\n\t}\r\n\r\n\tmaxDepth := 0\r\n\tvar depthDFS func(id string, depth int)\r\n\tdepthDFS = func(id string, depth int) {\r\n\t\tif depth > maxDepth {\r\n"]
[5588.058471, "o", "\t\t\tmaxDepth = depth\r\n\t\t}\r\n\t\tfor _, child := range children[id] {\r\n\t\t\tdepthDFS(child, depth+1)\r\n\t\t}\r\n\t}\r\n\tfor _, r := range roots {\r\n\t\tdepthDFS(r, 1)\r\n\t}\r\n\r\n\tresult.NumExperiments = len(exps)\r\n\tresult.NumRoots = len(roots)\r\n\tresult.NumLeaves = len(leaves)"]
[5588.058534, "o", "\r\n\tresult.MaxDepth = maxDepth\r\n\tresult.TopologicalOrder = topo\r\n\treturn result\r\n}\r\n\r\nfunc detectCycle(exps []Experiment) []string {\r\n\tadj := make(map[string][]string)\r\n\tfor _, e := range exps {\r\n\t\tfor _, p := range e.Parents {\r\n\t\t"]
[5588.058593, "o", "\tadj[p] = append(adj[p], e.ID)\r\n\t\t}\r\n\t}\r\n\r\n\tstate := make(map[string]int)\r\n\tvar stack []string\r\n\tvar cycle []string\r\n\r\n\tvar dfs func(id string) bool\r\n\tdfs = func(id string) bool {\r\n\t\tstate[id] = 1\r\n\t\tstack = append(stack, id)\r\n"]
[5588.058662, "o", "\t\tfor _, child := range adj[id] {\r\n\t\t\tif state[child] == 1 {\r\n\t\t\t\tidx := -1\r\n\t\t\t\tfor i := len(stack) - 1; i >= 0; i-- {\r\n\t\t\t\t\tif stack[i] == child {\r\n\t\t\t\t\t\tidx = i\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tif idx >= 0 {\r\n"]
[5588.058728, "o", "\t\t\t\t\tcycle = append([]string{}, stack[idx:]...)\r\n\t\t\t\t\treturn true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif state[child] == 0 {\r\n\t\t\t\tif dfs(child) {\r\n\t\t\t\t"]
[5588.058787, "o", "\treturn true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tstack = stack[:len(stack)-1]\r\n\t\tstate[id] = 2\r\n\t\treturn false\r\n\t}\r\n\r\n"]
