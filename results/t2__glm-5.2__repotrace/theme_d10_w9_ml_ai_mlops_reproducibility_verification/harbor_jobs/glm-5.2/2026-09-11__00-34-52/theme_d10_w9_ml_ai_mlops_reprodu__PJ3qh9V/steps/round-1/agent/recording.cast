[5484.944442, "i", "cat > tmp_gen_checkpoints/main.go <<'EOF'\npackage main\n\nimport (\n\t\"os\"\n\n\t\"repro-verify/internal/mlck\"\n)\n\nfunc mustData(vals []float64) []byte {\n\tb, err := mlck.EncodeFloat64Values(vals, uint8(mlck.Float64))\n\tif err != nil {\n\t\tpanic(err)\n\t}\n\treturn b\n}\n\nfunc main() {\n\ttensors1 := []mlck.Tensor{\n\t\t{Name: \"a\", Dtype: uint8(mlck.Float64), Shape: []uint32{2}, Data: mustData([]float64{0, 0})},\n\t\t{Name: \"b\", Dtype: uint8(mlck.Float64), Shape: []uint32{2}, Data: mustData([]float64{10, 10})},\n\t}\n\ttensors2 := []mlck.Tensor{\n\t\t{Name: \"a\", Dtype: uint8(mlck.Float64), Shape: []uint32{2}, Data: mustData([]float64{1, 1})},\n\t\t{Name: \"b\", Dtype: uint8(mlck.Float64), Shape: []uint32{2}, Data: mustData([]float64{20, 20})},\n\t}\n\n\tfor name, ts := range map[string][]mlck.Tensor{\"cp1.mlck\": tensors1, \"cp2.mlck\": tensors2} {\n\t\tb, err := mlck.Build(map[string]interface{}{}, ts)\n\t\tif err != nil {\n\t\t\tpanic(err)\n\t\t}\n\t\tif err := os.WriteFile(name, b, 0644); err != nil {\n\t\t\tpanic(err)\n\t\t}\n\t}\n}\nEOF\n"]
