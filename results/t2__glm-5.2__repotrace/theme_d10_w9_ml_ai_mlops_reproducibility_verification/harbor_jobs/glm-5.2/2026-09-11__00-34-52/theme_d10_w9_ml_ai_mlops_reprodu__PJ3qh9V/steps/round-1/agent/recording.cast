[4026.512437, "o", "\u001b[35m\u001b[K./internal/merge/merge.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\u001b[01;31m\u001b[KShape\u001b[m\u001b[K: shape,\r\n"]
[4026.512547, "o", "\u001b[35m\u001b[K./internal/report/report.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tres, err := compare.\u001b[01;31m\u001b[KCompare\u001b[m\u001b[K(c1, c2, \"strict\", 1e-7, 1e-5)\r\n"]
[4026.512662, "o", "\u001b[35m\u001b[K./internal/mlck/checkpoint.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KShape\u001b[m\u001b[K    []uint32\r\n\u001b[35m\u001b[K./internal/mlck/checkpoint.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KShape\u001b[m\u001b[K    []uint32 `json:\"shape\"`\r\n"]
[4026.512727, "o", "\u001b[35m\u001b[K./internal/mlck/checkpoint.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KShape\u001b[m\u001b[K:    t.\u001b[01;31m\u001b[KShape\u001b[m\u001b[K,\r\n\u001b[35m\u001b[K./internal/mlck/checkpoint.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K210\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KShape\u001b[m\u001b[K:    shape,\r\n"]
[4026.512784, "o", "\u001b[35m\u001b[K./internal/mlck/checkpoint.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif err := binary.Write(&buf, binary.LittleEndian, uint32(len(t.\u001b[01;31m\u001b[KShape\u001b[m\u001b[K))); err != nil {\r\n\u001b[35m\u001b[K./internal/mlck/checkpoint.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, s := range t.\u001b[01;31m\u001b[KShape\u001b[m\u001b[K {\r\n\u001b[35m\u001b[K./internal/mlck/checkpoint.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\texpected := Product(t.\u001b[01;31m\u001b[KShape\u001b[m\u001b[K) * int64(DtypeSize(t.Dtype))\r\n"]
[4026.512848, "o", "\u001b[35m\u001b[K./internal/mlck/checkpoint.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn nil, fmt.Errorf(\"tensor %s data length %d does not match shape %v and dtype %s\", t.Name, len(t.Data), t.\u001b[01;31m\u001b[KShape\u001b[m\u001b[K, DtypeName(t.Dtype))\r\n"]
