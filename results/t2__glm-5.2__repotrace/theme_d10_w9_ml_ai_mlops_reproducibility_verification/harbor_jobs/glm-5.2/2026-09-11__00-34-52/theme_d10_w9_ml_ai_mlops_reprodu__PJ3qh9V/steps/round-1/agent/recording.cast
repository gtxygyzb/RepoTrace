[1434.373512, "o", "\u001b[?2004hroot@n30009:/app# "]
[1434.373778, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1434.373878, "o", "import struct, json, hashlib\r\n\u001b[?2004l\r"]
[1434.373943, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1434.374003, "o", "\u001b[?2004h> "]
[1434.374351, "o", "def write_mlck(path, metadata, tensors, bad_footer=False):\r\n\u001b[?2004l\r"]
[1434.374448, "o", "\u001b[?2004h> "]
[1434.37464, "o", "    meta = json.dumps(metadata).encode()\r\n\u001b[?2004l\r"]
[1434.374721, "o", "\u001b[?2004h> "]
[1434.375121, "o", "    body = b'MLCK' + struct.pack('<III', 1, len(tensors), len(meta)) + meta\r\n\u001b[?2004l\r"]
[1434.3752, "o", "\u001b[?2004h> "]
[1434.375457, "o", "    for name, dtype, shape, data in tensors:\r\n\u001b[?2004l\r"]
[1434.37552, "o", "\u001b[?2004h> "]
[1434.375668, "o", "        nb = name.encode()\r\n\u001b[?2004l\r"]
[1434.375724, "o", "\u001b[?2004h> "]
[1434.375993, "o", "        body += struct.pack('<I', len(nb)) + nb\r\n\u001b[?2004l\r"]
[1434.376057, "o", "\u001b[?2004h> "]
[1434.3763, "o", "        body += struct.pack('<B', dtype)\r\n\u001b[?2004l\r"]
[1434.376359, "o", "\u001b[?2004h> "]
[1434.37661, "o", "        body += struct.pack('<I', len(shape))\r\n\u001b[?2004l\r"]
[1434.376674, "o", "\u001b[?2004h> "]
[1434.376816, "o", "        for s in shape:\r\n\u001b[?2004l\r"]
[1434.376873, "o", "\u001b[?2004h> "]
[1434.377099, "o", "            body += struct.pack('<I', s)\r\n\u001b[?2004l\r"]
[1434.377159, "o", "\u001b[?2004h> "]
[1434.377289, "o", "        body += data\r\n\u001b[?2004l\r"]
[1434.377348, "o", "\u001b[?2004h> "]
[1434.377591, "o", "    footer = hashlib.sha256(body).digest()\r\n\u001b[?2004l\r"]
[1434.377661, "o", "\u001b[?2004h> "]
[1434.377805, "o", "    if bad_footer:\r\n\u001b[?2004l\r"]
[1434.377862, "o", "\u001b[?2004h> "]
[1434.378033, "o", "        footer = b'\\x00' * 32\r\n\u001b[?2004l\r"]
[1434.37809, "o", "\u001b[?2004h> "]
[1434.378288, "o", "    with open(path, 'wb') as f:\r\n\u001b[?2004l\r"]
[1434.378344, "o", "\u001b[?2004h> "]
[1434.378517, "o", "        f.write(body + footer)\r\n\u001b[?2004l\r"]
[1434.378574, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1434.378635, "o", "\u001b[?2004h> "]
[1434.378724, "o", "def f32(vals):\r\n\u001b[?2004l\r"]
[1434.37878, "o", "\u001b[?2004h> "]
[1434.379092, "o", "    return b''.join(struct.pack('<f', v) for v in vals)\r\n\u001b[?2004l\r"]
[1434.379148, "o", "\u001b[?2004h> "]
[1434.379247, "o", "def f64(vals):\r\n\u001b[?2004l\r"]
[1434.379312, "o", "\u001b[?2004h> "]
[1434.379619, "o", "    return b''.join(struct.pack('<d', v) for v in vals)\r\n\u001b[?2004l\r"]
[1434.37967, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1434.379735, "o", "\u001b[?2004h> "]
[1434.380623, "o", "write_mlck('/tmp/cp1.bin', {'name':'test','framework':'pytorch','seed':42}, [('conv1.weight',0,[2,2],f32([1,2,3,4])),('fc.weight',1,[2,2],f64([1,2,3,4]))])\r\n\u001b[?2004l\r"]
[1434.380693, "o", "\u001b[?2004h> "]
[1434.381579, "o", "write_mlck('/tmp/cp2.bin', {'name':'test','framework':'pytorch','seed':42}, [('conv1.weight',0,[2,2],f32([1,2,3,4])),('fc.weight',1,[2,2],f64([1,2,3,4]))])\r\n\u001b[?2004l\r"]
[1434.381632, "o", "\u001b[?2004h> "]
[1434.382528, "o", "write_mlck('/tmp/cp3.bin', {'name':'test','framework':'pytorch','seed':42}, [('conv1.weight',0,[2,2],f32([1,2,3,4])),('extra',2,[2],struct.pack('<ii',5,6))])\r\n\u001b[?2004l\r"]
[1434.38259, "o", "\u001b[?2004h> "]
[1434.383154, "o", "write_mlck('/tmp/bad.bin', {'name':'bad'}, [('conv1.weight',0,[2,2],f32([1,2,3,4]))], bad_footer=True)\r\n\u001b[?2004l\r"]
[1434.383217, "o", "\u001b[?2004h> "]
[1434.383525, "o", "open('/tmp/badmanifest.toml','w').write('not valid toml =\r\n\u001b[?2004l\r"]
[1434.383583, "o", "\u001b[?2004h> ')\r\n\u001b[?2004l\r"]
[1434.383639, "o", "\u001b[?2004h> "]
