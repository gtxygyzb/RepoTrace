[3744.743161, "o", "\t\t}\r\n    86\t\t\t\tv2, err := t2.Float64Values()\r\n    87\t\t\t\tif err != nil {\r\n    88\t\t\t\t\treturn nil, err\r\n    89\t\t\t\t}\r\n    90\t\t\t\tn := len(v1)\r\n    91\t\t"]
[3744.743237, "o", "\t\tif n == 0 {\r\n    92\t\t\t\t\tsteps[i] = 0\r\n    93\t\t\t\t\tcontinue\r\n    94\t\t\t\t}\r\n    95\t\t\t\tvar sum float64\r\n    96\t\t\t\tfor j := 0; j < n; j++ {\r\n    97\t\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n    98\t\t\t\t}\r\n    99\t\t\t\tsteps[i] = sum / float64(n)\r\n   100\t\t\t}\r\n   101\t\r\n   102\t\t\tmean := meanFloat64(steps)\r\n"]
[3744.743296, "o", "   103\t\t\tmax := maxFloat64(steps)\r\n   104\t\t\tconvergence := classifyConvergence(steps)\r\n   105\t\t\tstability := 1.0\r\n   106\t\t\tif steps[0] != 0 {\r\n   107\t\t\t\tstability = 1.0 - steps[len(steps)-1]/steps[0]\r\n   108\t\t\t\tif stability < 0 {\r\n   109\t\t\t\t\tstability = 0\r\n"]
[3744.743356, "o", "   110\t\t\t\t} else if stability > 1 {\r\n   111\t\t\t\t\tstability = 1\r\n   112\t\t\t\t}\r\n   113\t\t\t}\r\n   114\t\r\n   115\t\t\ttensors = append(tensors, TensorResult{\r\n   116\t\t\t\tName:           name,\r\n   117\t\t\t\tStepChanges:    steps,\r\n"]
