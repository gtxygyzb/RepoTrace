[1425.770381, "i", "python3 - <<'PY'\nimport struct, json, hashlib\n\ndef write_mlck(path, metadata, tensors, bad_footer=False):\n    meta = json.dumps(metadata).encode()\n    body = b'MLCK' + struct.pack('<III', 1, len(tensors), len(meta)) + meta\n    for name, dtype, shape, data in tensors:\n        nb = name.encode()\n        body += struct.pack('<I', len(nb)) + nb\n        body += struct.pack('<B', dtype)\n        body += struct.pack('<I', len(shape))\n        for s in shape:\n            body += struct.pack('<I', s)\n        body += data\n    footer = hashlib.sha256(body).digest()\n    if bad_footer:\n        footer = b'\\x00' * 32\n    with open(path, 'wb') as f:\n        f.write(body + footer)\n\ndef f32(vals):\n    return b''.join(struct.pack('<f', v) for v in vals)\ndef f64(vals):\n    return b''.join(struct.pack('<d', v) for v in vals)\n\nwrite_mlck('/tmp/cp1.bin', {'name':'test','framework':'pytorch','seed':42}, [('conv1.weight',0,[2,2],f32([1,2,3,4])),('fc.weight',1,[2,2],f64([1,2,3,4]))])\nwrite_mlck('/tmp/cp2.bin', {'name':'test','framework'"]
