[2635.491917, "o", "package manifest\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"regexp\"\r\n"]
[2635.491994, "o", "\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\ntype Result struct {\r\n\tValid    bool     `json:\"valid\"`\r\n\tWarnings []string `json:\"warnings,omitempty\"`\r\n\tErrors   []string `json:\"errors,omitempty\"`\r\n}\r\n\r\nfunc Validate(path string) *Result {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn &Result{\r\n\t\t\tValid:  false,\r\n"]
[2635.492069, "o", "\t\t\tErrors: []string{fmt.Sprintf(\"failed to read manifest: %v\", err)},\r\n\t\t}\r\n\t}\r\n\r\n\troot, err := parseTOML(string(data))\r\n\t"]
[2635.492136, "o", "if err != nil {\r\n\t\treturn &Result{\r\n\t\t\tValid:  false,\r\n\t\t\tErrors: []string{fmt.Sprintf(\"failed to parse manifest: %v\", err)},\r\n\t\t}\r\n\t}\r\n\r\n\tresult := &Result{\r\n\t\tValid:    true,\r\n\t\tWarnings: []string{},\r\n\t\tErrors:   []string{},\r\n\t}\r\n\r\n\texperiment := getTable(root, \"experiment\")\r\n\tenvironment := getTable(root, \"environment\")\r\n\toutputs := getTable(root, \"outputs\")\r\n"]
[2635.492201, "o", "\r\n\tif experiment == nil {\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: experiment.name\")\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: experiment.timestamp\")\r\n\t} else {\r\n"]
[2635.492301, "o", "\t\tname, ok := experiment[\"name\"].(string)\r\n\t\tif !ok || name == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: experiment.name\")\r\n\t\t}\r\n\r\n\t\ttimestamp, ok := experiment[\"timestamp\"].(string)\r\n\t\tif !ok || timestamp == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: experiment.timestamp\")\r\n\t\t} else if _, err := time.Parse(time.RFC3339, timestamp); err != nil {\r\n\t\t\tresult.Errors = append(result.Errors, \"invalid timestamp format\")\r\n\t\t}\r\n\t}\r\n\r\n\tif environment == nil {\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: environment.python_version\")\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: environment.seed\")\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: environment.deterministic\")\r\n\t\tresult.Warnings = append(result.Warnings, \"optional field 'environment.gpu_id' missing\")\r\n\t\tresult.Warnings = append(result.Warnings, \"optional field 'environment.cuda_version' missing\")\r\n"]
[2635.492371, "o", "\t} else {\r\n\t\tpythonVersion, ok := environment[\"python_version\"].(string)\r\n\t\tif !ok || pythonVersion == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: environment.python_version\")\r\n"]
[2635.492437, "o", "\t\t} else if !pythonVersionRegex.MatchString(pythonVersion) {\r\n\t\t\tresult.Errors = append(result.Errors, \"invalid python_version format\")\r\n\t\t}\r\n\r\n\t\tseed, ok := environment[\"seed\"]\r\n\t\tif !ok {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: environment.seed\")\r\n\t\t} else if !isNonNegativeInt(seed) {\r\n\t\t\tresult.Errors = append(result.Errors, \"invalid environment.seed\")\r\n\t\t}\r\n\r\n\t\tif _, ok := environment[\"deterministic\"].(bool); !ok {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: environment.deterministic\")\r\n\t\t}\r\n\r\n\t\tif _, ok := environment[\"gpu_id\"].(string); !ok {\r\n\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'environment.gpu_id' missing\")\r\n\t\t}\r\n"]
[2635.492508, "o", "\t\tif _, ok := environment[\"cuda_version\"].(string); !ok {\r\n\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'environment.cuda_version' missing\")\r\n\t\t}\r\n\t}\r\n\r\n"]
[2635.492568, "o", "\tdeps, ok := root[\"dependencies\"].([]map[string]interface{})\r\n\tif !ok {\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: dependencies\")\r\n\t} else {\r\n\t\tfor i, dep := range deps {\r\n\t\t\tname, nameOk := dep[\"name\"].(string)\r\n\t\t\tversion, versionOk := dep[\"version\"].(string)\r\n\t\t\tif !nameOk || name == \"\" {\r\n\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"invalid dependency at index %d: missing name\", i))\r\n\t\t\t}\r\n\t\t\tif !versionOk || version == \"\" {\r\n\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"invalid dependency at index %d: missing version\", i))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[2635.492634, "o", "\tif outputs == nil {\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: outputs.checkpoint_path\")\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: outputs.metrics\")\r\n\t} else {\r\n\t\t"]
[2635.492691, "o", "checkpointPath, ok := outputs[\"checkpoint_path\"].(string)\r\n\t\tif !ok || checkpointPath == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: outputs.checkpoint_path\")\r\n\t\t}\r\n\r\n\t\tmetrics := getTable(outputs, \"metrics\")\r\n\t\tif metrics == nil {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: outputs.metrics\")\r\n\t\t} else if !hasNumericField(metrics) {\r\n\t\t\tresult.Errors = append(result.Errors, \"outputs.metrics must contain at least one numeric field\")\r\n\t\t}\r\n\t}\r\n"]
[2635.492757, "o", "\r\n\tgit := getTable(root, \"git\")\r\n\tif git == nil {\r\n\t\tresult.Warnings = append(result.Warnings, \"optional field 'git.commit' missing\")\r\n\t\tresult.Warnings = append(result.Warnings, \"optional field 'git.branch' missing\")\r\n\t} else {\r\n\t"]
[2635.492819, "o", "\tif _, ok := git[\"commit\"].(string); !ok {\r\n\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'git.commit' missing\")\r\n\t\t}\r\n\t\tif _, ok := git[\"branch\"].(string); !ok {\r\n\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'git.branch' missing\")\r\n\t\t}\r\n\t}\r\n\r\n\tif len(result.Errors) > 0 {\r\n\t"]
[2635.492884, "o", "\tresult.Valid = false\r\n\t\tresult.Warnings = nil\r\n\t}\r\n\tif result.Valid && len(result.Warnings) == 0 {\r\n\t\tresult.Warnings = []string{}\r\n\t}\r\n\r\n\treturn result\r\n}\r\n\r\nvar pythonVersionRegex = regexp.MustCompile(`^\\d+\\.\\d+\\.\\d+$`)\r\n\r\nfunc getTable(root map[string]interface{}, key string) map[string]interface{} {\r\n\tv, ok := root[key]\r\n\tif !ok {\r\n\t\treturn nil\r\n\t}\r\n\tm, ok := v.(map[string]interface{})\r\n\tif !ok {\r\n"]
[2635.492949, "o", "\t\treturn nil\r\n\t}\r\n\treturn m\r\n}\r\n\r\n"]
[2635.493011, "o", "func isNonNegativeInt(v interface{}) bool {\r\n\tswitch x := v.(type) {\r\n\tcase int:\r\n\t\treturn x >= 0\r\n\tcase int64:\r\n\t\treturn x >= 0\r\n\tcase float64:\r\n\t\treturn x == float64(int64(x)) && x >= 0\r\n\tdefault:\r\n\t\treturn false\r\n\t}\r\n}\r\n\r\nfunc hasNumericField(m map[string]interface{}) bool {\r\n\tfor _, v := range m {\r\n\t\tswitch v.(type) {\r\n"]
[2635.493074, "o", "\t\tcase int, int64, float64:\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc parseTOML(data string) (map[string]interface{}, error) {\r\n"]
[2635.493137, "o", "\troot := map[string]interface{}{}\r\n\tvar current map[string]interface{} = root\r\n\tvar currentArray []map[string]interface{}\r\n\r\n\tlines := strings.Split(data, \"\\n\")\r\n\tfor lineNum, raw := range lines {\r\n\t\tline := strings.TrimSpace(raw)\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tif strings.HasPrefix(line, \"[[\") && strings.HasSuffix(line, \"]]\") {\r\n\t\t\tkey := strings.TrimSpace(line[2 : len(line)-2])\r\n\t\t\tparts := strings.Split(key, \".\")\r\n\t\t\tparent := root\r\n\t"]
[2635.493194, "o", "\t\tfor i := 0; i < len(parts)-1; i++ {\r\n\t\t\t\tp := strings.TrimSpace(parts[i])\r\n\t\t\t\tnext, ok := parent[p]\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\tnext = map[string]interface{}{}\r\n\t\t\t\t\tparent[p] = next\r\n\t\t\t\t}\r\n\t\t\t\t"]
[2635.493265, "o", "parent, ok = next.(map[string]interface{})\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid array table path\", lineNum+1)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tlast := strings.TrimSpace(parts[len(parts)-1])\r\n\t\t\tarr, ok := parent[last].([]map[string]interface{})\r\n\t\t\tif !ok {\r\n\t\t\t\tarr = []map[string]interface{}{}\r\n\t\t\t}\r\n\t\t"]
[2635.493323, "o", "\titem := map[string]interface{}{}\r\n\t\t\tarr = append(arr, item)\r\n\t\t\tparent[last] = arr\r\n\t\t\tcurrent = item\r\n\t\t\tcurrentArray = arr\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n"]
[2635.493381, "o", "\t\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\r\n\t\t\tkey := strings.TrimSpace(line[1 : len(line)-1])\r\n\t\t\tparts := strings.Split(key, \".\")\r\n\t\t\tparent := root\r\n\t\t\tfor i := 0; i < len(parts)-1; i++ {\r\n\t\t\t\tp := strings.TrimSpace(parts[i])\r\n\t\t\t\tnext, ok := parent[p]\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\tnext = map[string]interface{}{}\r\n"]
[2635.493438, "o", "\t\t\t\t\tparent[p] = next\r\n\t\t\t\t}\r\n\t\t\t\tparent, ok = next.(map[string]interface{})\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid table path\", lineNum+1)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tlast := strings.TrimSpace(parts[len(parts)-1])\r\n"]
[2635.493497, "o", "\t\t\ttbl, ok := parent[last].(map[string]interface{})\r\n\t\t\tif !ok {\r\n\t\t\t\ttbl = map[string]interface{}{}\r\n\t\t\t\tparent[last] = tbl\r\n\t\t\t}\r\n\t\t\tcurrent = tbl\r\n\t\t\tcurrentArray = nil\r\n\t\t\tcontinue\r\n\t\t"]
[2635.493554, "o", "}\r\n\r\n\t\teq := strings.Index(line, \"=\")\r\n\t\tif eq < 0 {\r\n\t\t\treturn nil, fmt.Errorf(\"line %d: expected key = value\", lineNum+1)\r\n\t\t}\r\n"]
