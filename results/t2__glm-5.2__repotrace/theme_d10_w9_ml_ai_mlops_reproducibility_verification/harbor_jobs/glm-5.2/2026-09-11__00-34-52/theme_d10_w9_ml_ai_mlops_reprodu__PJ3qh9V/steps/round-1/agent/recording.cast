[3231.082351, "o", "package manifest\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"regexp\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\n"]
[3231.08244, "o", "type Result struct {\r\n\tValid    bool     `json:\"valid\"`\r\n\tWarnings []string `json:\"warnings,omitempty\"`\r\n\tErrors   []string `json:\"errors,omitempty\"`\r\n}\r\n\r\nfunc Validate(path string) *Result {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn &Result{\r\n\t\t\tValid:  false,\r\n\t\t\tErrors: []string{fmt.Sprintf(\"failed to read manifest: %v\", err)},\r\n\t\t}\r\n\t}\r\n\r\n"]
[3231.082522, "o", "\troot, err := parseTOML(string(data))\r\n\tif err != nil {\r\n\t\treturn &Result{\r\n\t\t\tValid:  false,\r\n\t\t\tErrors: []string{fmt.Sprintf(\"failed to parse manifest: %v\", err)},\r\n\t\t}\r\n\t}\r\n\r\n\tresult := &Result{\r\n\t\tValid:    true,\r\n\t\tWarnings: []string{},\r\n\t\tErrors:   []string{},\r\n"]
[3231.082604, "o", "\t}\r\n\r\n\texperiment := getTable(root, \"experiment\")\r\n\tenvironment := getTable(root, \"environment\")\r\n\toutputs := getTable(root, \"outputs\")\r\n\r\n\tif experiment == nil {\r\n\t"]
[3231.082676, "o", "\tresult.Errors = append(result.Errors, \"missing required field: experiment.name\")\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: experiment.timestamp\")\r\n\t} else {\r\n\t\tname, ok := experiment[\"name\"].(string)\r\n\t\tif !ok || name == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: experiment.name\")\r\n\t\t}\r\n\r\n\t\ttimestamp, ok := experiment[\"timestamp\"].(string)\r\n\t\tif !ok || timestamp == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: experiment.timestamp\")\r\n\t\t} else if _, err := time.Parse(time.RFC3339, timestamp); err != nil {\r\n\t\t\tresult.Errors = append(result.Errors, \"invalid timestamp format\")\r\n\t\t}\r\n\t}\r\n\r\n"]
[3231.082756, "o", "\tif environment == nil {\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: environment.python_version\")\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: environment.seed\")\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: environment.deterministic\")\r\n\t\tresult.Warnings = append(result.Warnings, \"optional field 'environment.gpu_id' missing\")\r\n\t\tresult.Warnings = append(result.Warnings, \"optional field 'environment.cuda_version' missing\")\r\n\t} else {\r\n\t\tpythonVersion, ok := environment[\"python_version\"].(string)\r\n\t\tif !ok || pythonVersion == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: environment.python_version\")\r\n\t\t} else if !pythonVersionRegex.MatchString(pythonVersion) {\r\n\t\t\tresult.Errors = append(result.Errors, \"invalid python_version format\")\r\n\t\t}\r\n"]
[3231.082827, "o", "\r\n\t\tseed, ok := environment[\"seed\"]\r\n\t\tif !ok {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: environment.seed\")\r\n\t\t} else if !isNonNegativeInt(seed) {\r\n\t\t\tresult.Errors = append(result.Errors, \"invalid environment.seed\")\r\n\t\t}\r\n\r\n\t\tif _, ok := environment[\"deterministic\"].(bool); !ok {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: environment.deterministic\")\r\n"]
[3231.082907, "o", "\t\t}\r\n\r\n\t\tif _, ok := environment[\"gpu_id\"].(string); !ok {\r\n\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'environment.gpu_id' missing\")\r\n\t\t}\r\n\t\tif _, ok := environment[\"cuda_version\"].(string); !ok {\r\n\t\t\t"]
[3231.082982, "o", "result.Warnings = append(result.Warnings, \"optional field 'environment.cuda_version' missing\")\r\n\t\t}\r\n\t}\r\n\r\n\tdeps, ok := root[\"dependencies\"].([]map[string]interface{})\r\n\tif !ok {\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: dependencies\")\r\n\t} else {\r\n\t\tfor i, dep := range deps {\r\n\t\t\tname, nameOk := dep[\"name\"].(string)\r\n\t\t\tversion, versionOk := dep[\"version\"].(string)\r\n\t\t\tif !nameOk || name == \"\" {\r\n\t\t\t\t"]
[3231.083057, "o", "result.Errors = append(result.Errors, fmt.Sprintf(\"invalid dependency at index %d: missing name\", i))\r\n\t\t\t}\r\n\t\t\tif !versionOk || version == \"\" {\r\n\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"invalid dependency at index %d: missing version\", i))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif outputs == nil {\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: outputs.checkpoint_path\")\r\n\t\tresult.Errors = append(result.Errors, \"missing required field: outputs.metrics\")\r\n\t} else {\r\n\t\tcheckpointPath, ok := outputs[\"checkpoint_path\"].(string)\r\n\t\tif !ok || checkpointPath == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, \"missing required field: outputs.checkpoint_path\")\r\n\t\t}\r\n\r\n\t"]
[3231.083131, "o", "\tmetrics := getTable(outputs, \"metrics\")\r\n"]
