[527.250111, "o", "\u001b[?2004h> "]
[527.250169, "o", "    }\r\n\u001b[?2004l\r"]
[527.250232, "o", "\u001b[?2004h> "]
[527.250296, "o", "    return p\r\n\u001b[?2004l\r"]
[527.250324, "o", "\u001b[?2004h"]
[527.250388, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.250442, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
