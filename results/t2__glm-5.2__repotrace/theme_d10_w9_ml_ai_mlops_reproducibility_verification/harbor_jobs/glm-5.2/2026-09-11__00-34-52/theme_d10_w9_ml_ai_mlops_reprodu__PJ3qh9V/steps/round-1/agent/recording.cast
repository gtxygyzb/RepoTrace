[5447.885893, "o", "package mlck\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n"]
[5447.885958, "o", "\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n)\r\n\r\nconst (\r\n\tMagic      = \"MLCK\"\r\n\tVersion    = 1\r\n\tHeaderSize = 16\r\n"]
[5447.886017, "o", "\tFooterSize = 32\r\n)\r\n\r\ntype Dtype uint8\r\n\r\nconst (\r\n\tFloat32 Dtype = 0\r\n\tFloat64 Dtype = 1\r\n\tInt32   Dtype = 2\r\n\tInt64   Dtype = 3\r\n)\r\n\r\nfunc (d Dtype) Valid() bool {\r\n"]
[5447.886088, "o", "\treturn d == Float32 || d == Float64 || d == Int32 || d == Int64\r\n}\r\n\r\nfunc (d Dtype) Name() string {\r\n\tswitch d {\r\n\tcase Float32:\r\n\t\treturn \"float32\"\r\n\tcase Float64:\r\n\t"]
[5447.88615, "o", "\treturn \"float64\"\r\n\tcase Int32:\r\n\t\treturn \"int32\"\r\n\tcase Int64:\r\n\t\treturn \"int64\"\r\n\tdefault:\r\n\t\treturn \"unknown\"\r\n\t}\r\n}\r\n\r\nfunc (d Dtype) Size() int {\r\n\tswitch d {\r\n\tcase Float32, Int32:\r\n\t\treturn 4\r\n\tcase Float64, Int64:\r\n\t\treturn 8\r\n\tdefault:"]
[5447.886211, "o", "\r\n\t\treturn 0\r\n\t}\r\n}\r\n\r\nfunc DtypeName(dtype uint8) string {\r\n\treturn Dtype(dtype).Name()\r\n}\r\n\r\nfunc DtypeSize(dtype uint8) int {\r\n\treturn Dtype(dtype).Size()\r\n}\r\n\r\n"]
[5447.886278, "o", "func Product(shape []uint32) int64 {\r\n\tp := int64(1)\r\n\tfor _, s := range shape {\r\n\t\tp *= int64(s)\r\n\t}\r\n\treturn p\r\n}\r\n\r\ntype Tensor struct {\r\n\tName     string\r\n"]
[5447.886336, "o", "\tDtype    uint8\r\n\tShape    []uint32\r\n\tData     []byte\r\n\tChecksum string\r\n}\r\n\r\ntype TensorInfo struct {\r\n\tName     string   `json:\"name\"`\r\n\tDtype    string   `json:\"dtype\"`\r\n"]
[5447.886393, "o", "\tShape    []uint32 `json:\"shape\"`\r\n\tChecksum string   `json:\"checksum\"`\r\n}\r\n\r\nfunc (t Tensor) Info() TensorInfo {\r\n\treturn TensorInfo{\r\n\t\tName:     t.Name,\r\n\t\tDtype:    DtypeName(t.Dtype),\r\n\t\tShape:    t.Shape,\r\n"]
[5447.88645, "o", "\t\tChecksum: t.Checksum,\r\n\t}\r\n}\r\n\r\ntype Checkpoint struct {\r\n\tVersion      uint32\r\n\tNumTensors   uint32\r\n\tMetadata     map[string]interface{}\r\n\tMetadataRaw  []byte\r\n\tTensors      []Tensor\r\n"]
[5447.886511, "o", "\tFileChecksum string\r\n\tFilePath     string\r\n}\r\n\r\nfunc ParseFile(path string) (*Checkpoint, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn Parse(data, path)\r\n}\r\n\r\n"]
[5447.88657, "o", "func Parse(data []byte, path string) (*Checkpoint, error) {\r\n\tif len(data) < HeaderSize+FooterSize {\r\n\t\treturn nil, fmt.Errorf(\"file too small\")\r\n"]
[5447.887037, "o", "\u001b[?2004h"]
[5447.887091, "o", "root@n30009:/app# "]
