[1761.788092, "o", "  },\r\n  \"lineage\": {\r\n    \"valid\": true,\r\n    \"depth\": 2\r\n  },\r\n  \"overall_reproducible\": true,\r\n  \"issues\": []\r\n}\r\n\r\nEXIT: 0\r\n------------------------------------------------------------\r\n"]
