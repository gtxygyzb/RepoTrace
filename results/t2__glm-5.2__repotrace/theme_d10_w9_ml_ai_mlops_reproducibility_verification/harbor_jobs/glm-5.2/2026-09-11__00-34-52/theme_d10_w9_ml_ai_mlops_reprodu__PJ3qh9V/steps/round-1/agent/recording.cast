[4648.034694, "o", "   168\t\t\tif a[i] != b[i] {\r\n   169\t\t\t\treturn false\r\n   170\t\t\t}\r\n   171\t\t}\r\n   172\t\treturn true\r\n   173\t}\r\n   174\t\r\n   175\tfunc meanFloat64(xs []float64) float64 {\r\n   176\t\tif len(xs) == 0 {\r\n   177\t\t\treturn 0\r\n   178\t\t}\r\n"]
[4648.034762, "o", "   179\t\tvar sum float64\r\n   180\t\tfor _, x := range xs {\r\n   181\t\t\tsum += x\r\n   182\t\t}\r\n   183\t\treturn sum / float64(len(xs))\r\n   184\t}\r\n   185\t\r\n   186\tfunc maxFloat64(xs []float64) float64 {\r\n   187\t\tif len(xs) == 0 {\r\n   188\t\t\treturn 0\r\n   189\t\t}\r\n"]
[4648.034844, "o", "   190\t\tm := xs[0]\r\n   191\t\tfor _, x := range xs[1:] {\r\n   192\t\t\tif x > m {\r\n   193\t\t\t\tm = x\r\n   194\t\t\t}\r\n   195\t\t}\r\n   196\t\treturn m\r\n   197\t}\r\n   198\t\r\n   199\tfunc classifyConvergence(steps []float64) string {\r\n   200\t\tif len(steps) <= 1 {\r\n   201\t\t\treturn \"converging\"\r\n"]
