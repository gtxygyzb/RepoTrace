[5467.492369, "o", "\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KVersion\u001b[m\u001b[K    = 1\r\n"]
[5467.492473, "o", "\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KHeaderSize\u001b[m\u001b[K = 16\r\n"]
