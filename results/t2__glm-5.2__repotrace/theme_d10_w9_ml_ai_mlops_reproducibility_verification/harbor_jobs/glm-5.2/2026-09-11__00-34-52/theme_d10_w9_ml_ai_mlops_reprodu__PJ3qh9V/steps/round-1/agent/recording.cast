[1659.970061, "o", "\u001b[?2004h> "]
[1659.970168, "o", "    print('-' * 60)\r\n\u001b[?2004l\r"]
[1659.970243, "o", "\u001b[?2004h> "]
[1659.970371, "o", "    return p.returncode\r\n\u001b[?2004l\r"]
