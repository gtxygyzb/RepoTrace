[4131.795408, "i", "\ttr.NumMismatches = total\n\t\treturn tr\n\t}\n\tvals2, err := t2.Float64Values()\n\tif err != nil {\n\t\ttr.Match = false\n\t\ttr.NumMismatches = total\n\t\treturn tr\n\t}\n\n\tvar hist DiffHistogram\n\tthreshold := int(math.Floor(float64(total) * 0.001))\n\tfor i := 0; i < total; i++ {\n\t\ta := vals1[i]\n\t\tb := vals2[i]\n\t\tdiff := math.Abs(a - b)\n\t\tif diff > tr.MaxAbsDiff {\n\t\t\ttr.MaxAbsDiff = diff\n\t\t}\n\t\tvar rel float64\n\t\tif math.Abs(b) > 0 {\n\t\t\trel = diff / math.Abs(b)\n\t\t} else if diff > 0 {\n\t\t\trel = diff\n\t\t}\n\t\tif rel > tr.MaxRelDiff {\n\t\t\ttr.MaxRelDiff = rel\n\t\t}\n\t\tif diff > atol+rtol*math.Abs(b) {\n\t\t\ttr.NumMismatches++\n\t\t}\n\n\t\tswitch {\n\t\tcase diff == 0:\n\t\t\thist.Exact++\n\t\tcase diff < 1e-7:\n\t\t\thist.Less1e7++\n\t\tcase diff < 1e-5:\n\t\t\thist.Less1e5++\n\t\tcase diff < 1e-3:\n\t\t\thist.Less1e3++\n\t\tcase diff < 1:\n\t\t\thist.Less1++\n\t\tdefault:\n\t\t\thist.Geq1++\n\t\t}\n\t}\n\n\tif histogram {\n\t\ttr.DiffHistogram = &hist\n\t}\n\n\tswitch mode {\n\tcase \"strict\":\n\t\ttr.Match = tr.NumMismatches == 0\n\tcase \"relaxed\":\n\t\ttr.Match = tr.NumMismatches <= threshold\n\t}\n\n\treturn tr\n}\n\nfunc"]
