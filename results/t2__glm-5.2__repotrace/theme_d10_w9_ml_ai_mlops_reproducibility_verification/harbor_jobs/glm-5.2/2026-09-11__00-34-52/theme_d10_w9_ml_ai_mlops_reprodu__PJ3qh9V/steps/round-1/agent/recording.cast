[4723.519124, "o", "\u001b[?2004h> "]
[4723.519421, "o", "                NumSnapshots:       len(files),\r\n\u001b[?2004l\r"]
[4723.519489, "o", "\u001b[?2004h> "]
[4723.519781, "o", "                NumAnalyzedTensors: len(tensors),\r\n\u001b[?2004l\r"]
[4723.519847, "o", "\u001b[?2004h> "]
[4723.520115, "o", "                SkippedTensors:     skipped,\r\n\u001b[?2004l\r"]
[4723.520181, "o", "\u001b[?2004h> "]
[4723.520444, "o", "                Tensors:            tensors,\r\n\u001b[?2004l\r"]
[4723.520511, "o", "\u001b[?2004h> "]
[4723.520769, "o", "                OverallConvergence: overall,\r\n\u001b[?2004l\r"]
[4723.520835, "o", "\u001b[?2004h> "]
[4723.520909, "o", "        }, nil\r\n\u001b[?2004l\r"]
[4723.520975, "o", "\u001b[?2004h> "]
[4723.521046, "o", "}''',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.521177, "o", "'''        sort.Strings(skipped)\r\n\u001b[?2004l\r"]
[4723.521254, "o", "\u001b[?2004h> "]
[4723.52142, "o", "        sort.Slice(tensors, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[4723.521487, "o", "\u001b[?2004h> "]
[4723.52169, "o", "                return tensors[i].Name < tensors[j].Name\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.521755, "o", ">         })\r\n\u001b[?2004l\r"]
[4723.52182, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[4723.521947, "o", "        result := &Result{\r\n\u001b[?2004l\r"]
[4723.522012, "o", "\u001b[?2004h> "]
[4723.522175, "o", "                NumSnapshots:       len(files),\r\n\u001b[?2004l\r"]
[4723.522259, "o", "\u001b[?2004h> "]
[4723.522414, "o", "                NumAnalyzedTensors: len(tensors),\r\n\u001b[?2004l\r"]
[4723.522481, "o", "\u001b[?2004h> "]
[4723.522628, "o", "                SkippedTensors:     skipped,\r\n\u001b[?2004l\r"]
[4723.522696, "o", "\u001b[?2004h> "]
[4723.522861, "o", "                Tensors:            tensors,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.522925, "o", "> "]
[4723.523063, "o", "                OverallConvergence: overall,\r\n\u001b[?2004l\r"]
[4723.523129, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r "]
[4723.523194, "o", "\u001b[?2004h> "]
[4723.523308, "o", "        applyTopK(result, topK)\r\n\u001b[?2004l\r"]
[4723.523373, "o", "\u001b[?2004h> "]
[4723.523458, "o", "        return result, nil\r\n\u001b[?2004l\r"]
[4723.523523, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r "]
[4723.523589, "o", "\u001b[?2004h> "]
[4723.523892, "o", "// Analyze remains available for callers that do not need a top-k restriction.\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.523959, "o", "> "]
[4723.52412, "o", "func Analyze(files []string) (*Result, error) {\r\n\u001b[?2004l\r"]
[4723.524186, "o", "\u001b[?2004h> "]
[4723.524335, "o", "        return AnalyzeWithTopK(files, 0)\r\n\u001b[?2004l\r"]
[4723.5244, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ri"]
[4723.524465, "o", "\u001b[?2004h> "]
[4723.524769, "o", "// AnalyzeWithTopK analyzes drift and optionally restricts the returned tensor\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.524836, "o", "> "]
[4723.525111, "o", "// list to the N tensors with the lowest stability scores. When topK > 0 the\r\n\u001b[?2004l\r"]
[4723.525176, "o", "\u001b[?2004h> "]
[4723.525469, "o", "// result includes a top_k field set to the requested N, even if fewer tensors\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.525537, "o", "> "]
[4723.525601, "o", "// are returned.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.52588, "o", "func AnalyzeWithTopK(files []string, topK int) (*Result, error) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.525944, "o", "> "]
[4723.52609, "o", "        return analyzeWithTopK(files, topK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.526156, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ra"]
[4723.526239, "o", "\u001b[?2004h> "]
[4723.526459, "o", "func analyzeWithTopK(files []string, topK int) (*Result, error) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.526524, "o", "> "]
[4723.526604, "o", "        if len(files) < 2 {\r\n\u001b[?2004l\r"]
[4723.52667, "o", "\u001b[?2004h> "]
[4723.526953, "o", "                return nil, fmt.Errorf(\"at least 2 input files required\")\r\n\u001b[?2004l\r"]
[4723.527018, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4723.527092, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[4723.527311, "o", "        cps := make([]*mlck.Checkpoint, len(files))\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.527376, "o", "> "]
[4723.527487, "o", "        for i, f := range files {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.527553, "o", "> "]
[4723.527707, "o", "                cp, err := mlck.ParseFile(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.527774, "o", "> "]
[4723.52787, "o", "                if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.527937, "o", "> "]
[4723.528209, "o", "                        return nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.528285, "o", "> "]
[4723.528361, "o", "                }\r\n\u001b[?2004l\r"]
[4723.528426, "o", "\u001b[?2004h> "]
[4723.52849, "o", "                cps[i] = cp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.528565, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4723.52863, "o", " \u001b[?2004h> "]
[4723.528745, "o", "        var allNames []string\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.528811, "o", "> "]
[4723.528918, "o", "        seen := map[string]bool{}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.528984, "o", "> "]
[4723.529077, "o", "        for _, cp := range cps {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.529143, "o", "> "]
[4723.52931, "o", "                for _, t := range cp.Tensors {\r\n\u001b[?2004l\r"]
[4723.529382, "o", "\u001b[?2004h> "]
[4723.52954, "o", "                        if !seen[t.Name] {\r\n\u001b[?2004l\r"]
[4723.529606, "o", "\u001b[?2004h> "]
[4723.52979, "o", "                                seen[t.Name] = true\r\n\u001b[?2004l\r"]
[4723.529857, "o", "\u001b[?2004h> "]
[4723.530105, "o", "                                allNames = append(allNames, t.Name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.530171, "o", "> "]
[4723.530244, "o", "                        }\r\n\u001b[?2004l\re"]
[4723.569898, "o", "\u001b[?2004h> "]
[4723.570047, "o", "                }\r\n\u001b[?2004l\r"]
[4723.570115, "o", "\u001b[?2004h> "]
[4723.570185, "o", "        }\r\n\u001b[?2004l\r"]
[4723.570259, "o", "\u001b[?2004h> "]
[4723.570467, "o", "        sort.Strings(allNames)\r\n\u001b[?2004l\r"]
[4723.570534, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4723.570599, "o", "\u001b[?2004h> "]
[4723.570791, "o", "        skipped := []string{}\r\n\u001b[?2004l\r"]
[4723.570858, "o", "\u001b[?2004h> "]
[4723.571099, "o", "        tensors := []TensorResult{}\r\n\u001b[?2004l\r"]
[4723.571166, "o", "\u001b[?2004h> "]
[4723.571325, "o", "        converging := 0\r\n\u001b[?2004l\r"]
[4723.571403, "o", "\u001b[?2004h> "]
[4723.571556, "o", "        diverging := 0\r\n\u001b[?2004l\r"]
[4723.571623, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4723.571691, "o", "\u001b[?2004h> "]
[4723.571943, "o", "        for _, name := range allNames {\r\n\u001b[?2004l\r"]
[4723.57201, "o", "\u001b[?2004h> "]
[4723.572185, "o", "                ok := true\r\n\u001b[?2004l\r"]
[4723.572258, "o", "\u001b[?2004h> "]
[4723.57249, "o", "                var shape []uint32\r\n\u001b[?2004l\r"]
[4723.572556, "o", "\u001b[?2004h> "]
[4723.572824, "o", "                for _, cp := range cps {\r\n\u001b[?2004l\r"]
[4723.572891, "o", "\u001b[?2004h> "]
[4723.573288, "o", "                        t, exists := tensorByName(cp, name)\r\n\u001b[?2004l\r"]
[4723.573354, "o", "\u001b[?2004h> "]
[4723.5736, "o", "                        if !exists {\r\n\u001b[?2004l\r"]
[4723.573667, "o", "\u001b[?2004h> "]
[4723.573949, "o", "                                ok = false\r\n\u001b[?2004l\r"]
[4723.574017, "o", "\u001b[?2004h> "]
[4723.574274, "o", "                                break\r\n\u001b[?2004l\r"]
[4723.57434, "o", "\u001b[?2004h> "]
[4723.574506, "o", "                        }\r\n\u001b[?2004l\r"]
[4723.574575, "o", "\u001b[?2004h> "]
[4723.57485, "o", "                        if shape == nil {\r\n\u001b[?2004l\r"]
[4723.574917, "o", "\u001b[?2004h> "]
[4723.575239, "o", "                                shape = t.Shape\r\n\u001b[?2004l\r"]
[4723.575309, "o", "\u001b[?2004h> "]
[4723.575727, "o", "                        } else if !shapesEqual(shape, t.Shape) {\r\n\u001b[?2004l\r"]
[4723.575795, "o", "\u001b[?2004h> "]
[4723.576079, "o", "                                ok = false\r\n\u001b[?2004l\r"]
[4723.576147, "o", "\u001b[?2004h> "]
[4723.576442, "o", "                                break\r\n\u001b[?2004l\r"]
[4723.57651, "o", "\u001b[?2004h> "]
[4723.57668, "o", "                        }\r\n\u001b[?2004l\r"]
[4723.576746, "o", "\u001b[?2004h> "]
[4723.576874, "o", "                }\r\n\u001b[?2004l\r"]
[4723.576941, "o", "\u001b[?2004h> "]
[4723.577107, "o", "                if !ok {\r\n\u001b[?2004l\r"]
[4723.577174, "o", "\u001b[?2004h> "]
[4723.577549, "o", "                        skipped = append(skipped, name)\r\n\u001b[?2004l\r"]
[4723.577617, "o", "\u001b[?2004h> "]
[4723.577832, "o", "                        continue\r\n\u001b[?2004l\r"]
[4723.577899, "o", "\u001b[?2004h> "]
[4723.578021, "o", "                }\r\n\u001b[?2004l\r"]
[4723.578089, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4723.578156, "o", "\u001b[?2004h> "]
[4723.578521, "o", "                steps := make([]float64, len(cps)-1)\r\n\u001b[?2004l\r"]
[4723.578589, "o", "\u001b[?2004h> "]
[4723.578911, "o", "                for i := 0; i < len(steps); i++ {\r\n\u001b[?2004l\r"]
[4723.578978, "o", "\u001b[?2004h> "]
[4723.579383, "o", "                        v1, err := tensorData(cps[i], name)\r\n\u001b[?2004l\r"]
[4723.579453, "o", "\u001b[?2004h> "]
[4723.579761, "o", "                        if err != nil {\r\n\u001b[?2004l\r"]
[4723.579827, "o", "\u001b[?2004h> "]
[4723.580143, "o", "                                return nil, err\r\n\u001b[?2004l\r"]
[4723.580212, "o", "\u001b[?2004h> "]
[4723.580382, "o", "                        }\r\n\u001b[?2004l\r"]
[4723.580451, "o", "\u001b[?2004h> "]
[4723.580858, "o", "                        v2, err := tensorData(cps[i+1], name)\r\n\u001b[?2004l\r"]
[4723.580925, "o", "\u001b[?2004h> "]
[4723.581182, "o", "                        if err != nil {\r\n\u001b[?2004l\r"]
[4723.581256, "o", "\u001b[?2004h> "]
[4723.581565, "o", "                                return nil, err\r\n\u001b[?2004l\r"]
[4723.581631, "o", "\u001b[?2004h> "]
[4723.581798, "o", "                        }\r\n\u001b[?2004l\r"]
[4723.581867, "o", "\u001b[?2004h> "]
[4723.582106, "o", "                        n := len(v1)\r\n\u001b[?2004l\r"]
[4723.582175, "o", "\u001b[?2004h> "]
[4723.582422, "o", "                        if n == 0 {\r\n\u001b[?2004l\r"]
[4723.582487, "o", "\u001b[?2004h> "]
[4723.582781, "o", "                                steps[i] = 0\r\n\u001b[?2004l\r"]
[4723.582846, "o", "\u001b[?2004h> "]
[4723.583123, "o", "                                continue\r\n\u001b[?2004l\r"]
[4723.58319, "o", "\u001b[?2004h> "]
[4723.583367, "o", "                        }\r\n\u001b[?2004l\r"]
[4723.583443, "o", "\u001b[?2004h> "]
[4723.583712, "o", "                        var sum float64\r\n\u001b[?2004l\r"]
[4723.583777, "o", "\u001b[?2004h> "]
[4723.58409, "o", "                        for j := 0; j < n; j++ {\r\n\u001b[?2004l\r"]
[4723.584157, "o", "\u001b[?2004h> "]
[4723.584523, "o", "                                sum += math.Abs(v1[j] - v2[j])\r\n\u001b[?2004l\r"]
[4723.58459, "o", "\u001b[?2004h> "]
[4723.584718, "o", "                        }\r\n\u001b[?2004l\r"]
[4723.584784, "o", "\u001b[?2004h> "]
[4723.585088, "o", "                        steps[i] = sum / float64(n)\r\n\u001b[?2004l\r"]
[4723.585154, "o", "\u001b[?2004h> "]
[4723.585247, "o", "                }\r\n\u001b[?2004l\r"]
[4723.585318, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.585574, "o", "                mean := meanFloat64(steps)\r\n\u001b[?2004l\r"]
[4723.58564, "o", "\u001b[?2004h> "]
[4723.585872, "o", "                max := maxFloat64(steps)\r\n\u001b[?2004l\r"]
[4723.58594, "o", "\u001b[?2004h> "]
[4723.586234, "o", "                convergence := classifyConvergence(steps)\r\n\u001b[?2004l\r"]
[4723.586302, "o", "\u001b[?2004h> "]
[4723.586468, "o", "                stability := 1.0\r\n\u001b[?2004l\r"]
[4723.586535, "o", "\u001b[?2004h> "]
[4723.586676, "o", "                if max != 0 {\r\n\u001b[?2004l\r"]
[4723.586742, "o", "\u001b[?2004h> "]
[4723.587118, "o", "                        stability = 1.0 - steps[len(steps)-1]/max\r\n\u001b[?2004l\r"]
[4723.587187, "o", "\u001b[?2004h> "]
[4723.587398, "o", "                        if stability < 0 {\r\n\u001b[?2004l\r"]
[4723.587466, "o", "\u001b[?2004h> "]
[4723.587726, "o", "                                stability = 0\r\n\u001b[?2004l\r"]
[4723.587793, "o", "\u001b[?2004h> "]
[4723.588078, "o", "                        } else if stability > 1 {\r\n\u001b[?2004l\r"]
[4723.588146, "o", "\u001b[?2004h> "]
[4723.588401, "o", "                                stability = 1\r\n\u001b[?2004l\r"]
[4723.588471, "o", "\u001b[?2004h> "]
[4723.58858, "o", "                        }\r\n\u001b[?2004l\r"]
[4723.588646, "o", "\u001b[?2004h> "]
[4723.588726, "o", "                }\r\n\u001b[?2004l\r"]
[4723.588795, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.588861, "o", "> "]
[4723.589106, "o", "                tensors = append(tensors, TensorResult{\r\n\u001b[?2004l\r"]
[4723.589172, "o", "\u001b[?2004h> "]
[4723.589403, "o", "                        Name:           name,\r\n\u001b[?2004l\r"]
[4723.589469, "o", "\u001b[?2004h> "]
[4723.589715, "o", "                        StepChanges:    steps,\r\n\u001b[?2004l\r"]
[4723.589781, "o", "\u001b[?2004h> "]
[4723.590017, "o", "                        MeanChange:     mean,\r\n\u001b[?2004l\r"]
[4723.590084, "o", "\u001b[?2004h> "]
[4723.590334, "o", "                        MaxChange:      max,\r\n\u001b[?2004l\r"]
[4723.590403, "o", "\u001b[?2004h> "]
[4723.590657, "o", "                        Convergence:    convergence,\r\n\u001b[?2004l\r"]
[4723.590725, "o", "\u001b[?2004h> "]
[4723.591006, "o", "                        StabilityScore: stability,\r\n\u001b[?2004l\r"]
[4723.591074, "o", "\u001b[?2004h> "]
[4723.591168, "o", "                })\r\n\u001b[?2004l\r"]
[4723.591243, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.591309, "o", "> "]
[4723.591566, "o", "                if convergence == \"converging\" {\r\n\u001b[?2004l\r"]
[4723.591633, "o", "\u001b[?2004h> "]
[4723.591816, "o", "                        converging++\r\n\u001b[?2004l\r"]
[4723.591884, "o", "\u001b[?2004h> "]
[4723.592196, "o", "                } else if convergence == \"diverging\" {\r\n\u001b[?2004l\r"]
[4723.592269, "o", "\u001b[?2004h> "]
[4723.592453, "o", "                        diverging++\r\n\u001b[?2004l\r"]
[4723.592518, "o", "\u001b[?2004h> "]
[4723.592601, "o", "                }\r\n\u001b[?2004l\r"]
[4723.59267, "o", "\u001b[?2004h> "]
[4723.592739, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4723.592803, "o", "\u001b[?2004h> "]
[4723.592935, "o", "        overall := \"mixed\"\r\n\u001b[?2004l\r"]
[4723.593002, "o", "\u001b[?2004h> "]
[4723.593234, "o", "        if converging > len(tensors)/2 {\r\n\u001b[?2004l\r"]
[4723.5933, "o", "\u001b[?2004h> "]
[4723.593501, "o", "                overall = \"converging\"\r\n\u001b[?2004l\r"]
[4723.593567, "o", "\u001b[?2004h> "]
[4723.593796, "o", "        } else if diverging > len(tensors)/2 {\r\n\u001b[?2004l\r"]
[4723.593864, "o", "\u001b[?2004h> "]
[4723.594037, "o", "                overall = \"diverging\"\r\n\u001b[?2004l\r"]
[4723.594105, "o", "\u001b[?2004h> "]
[4723.594171, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4723.594246, "o", "\u001b[?2004h> "]
[4723.594398, "o", "        sort.Strings(skipped)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.594466, "o", "> "]
[4723.594612, "o", "        sort.Slice(tensors, func(i, j int) bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.594678, "o", "> "]
[4723.594863, "o", "                return tensors[i].Name < tensors[j].Name\r\n\u001b[?2004l\r"]
[4723.59493, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[4723.594996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.595119, "o", "        result := &Result{\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.595189, "o", "> "]
[4723.595341, "o", "                NumSnapshots:       len(files),\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.595407, "o", "> "]
[4723.59556, "o", "                NumAnalyzedTensors: len(tensors),\r\n\u001b[?2004l\r"]
[4723.595625, "o", "\u001b[?2004h> "]
[4723.595767, "o", "                SkippedTensors:     skipped,\r\n\u001b[?2004l\r"]
[4723.595833, "o", "\u001b[?2004h> "]
[4723.595977, "o", "                Tensors:            tensors,\r\n\u001b[?2004l\r"]
[4723.596043, "o", "\u001b[?2004h> "]
[4723.596188, "o", "                OverallConvergence: overall,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.596261, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.596325, "o", "> "]
[4723.596415, "o", "        applyTopK(result, topK)\r\n\u001b[?2004l\r"]
[4723.596481, "o", "\u001b[?2004h> "]
[4723.59655, "o", "        return result, nil\r\n\u001b[?2004l\r"]
[4723.596614, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r "]
[4723.596679, "o", "\u001b[?2004h> "]
[4723.596815, "o", "func applyTopK(result *Result, topK int) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.596881, "o", "> "]
[4723.596943, "o", "        if topK <= 0 {\r\n\u001b[?2004l\r"]
[4723.597008, "o", "\u001b[?2004h> "]
[4723.597079, "o", "                return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.597136, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.597205, "o", "> "]
[4723.597269, "o", "        requested := topK\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.597339, "o", "> "]
[4723.597539, "o", "        sort.SliceStable(result.Tensors, func(i, j int) bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.597605, "o", "> "]
[4723.597923, "o", "                return result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.59799, "o", ">         })\r\n\u001b[?2004l\r"]
[4723.598055, "o", "\u001b[?2004h> "]
[4723.598207, "o", "        if requested < len(result.Tensors) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.598287, "o", "> "]
[4723.598488, "o", "                result.Tensors = result.Tensors[:requested]\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.598556, "o", ">         }\r\n\u001b[?2004l\r"]
[4723.598622, "o", "\u001b[?2004h> "]
[4723.598716, "o", "        result.TopK = &requested\r\n\u001b[?2004l\r"]
[4723.598783, "o", "\u001b[?2004h> }'''\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.59885, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[4723.598918, "o", "> "]
[4723.599014, "o", "# Replace classifyConvergence logic.\r\n\u001b[?2004l\r"]
[4723.59908, "o", "\u001b[?2004h> "]
[4723.599147, "o", "s = s.replace(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.59935, "o", "'''func classifyConvergence(steps []float64) string {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.599416, "o", "> "]
[4723.599491, "o", "        if len(steps) <= 1 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.599556, "o", "> "]
[4723.599656, "o", "                return \"converging\"\r\n\u001b[?2004l\r"]
[4723.599721, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4723.599785, "o", "\u001b[?2004h> "]
[4723.599869, "o", "        decreasing := true\r\n\u001b[?2004l\r"]
[4723.599934, "o", "\u001b[?2004h> "]
[4723.600013, "o", "        increasing := true\r\n\u001b[?2004l\r"]
[4723.600077, "o", "\u001b[?2004h> "]
[4723.600211, "o", "        for i := 1; i < len(steps); i++ {\r\n\u001b[?2004l\r"]
[4723.600288, "o", "\u001b[?2004h> "]
[4723.600418, "o", "                if steps[i] >= steps[i-1] {\r\n\u001b[?2004l\r"]
[4723.600483, "o", "\u001b[?2004h> "]
[4723.600617, "o", "                        decreasing = false\r\n\u001b[?2004l\r"]
[4723.600683, "o", "\u001b[?2004h> "]
[4723.600749, "o", "                }\r\n\u001b[?2004l\r \u001b[?2004h> "]
[4723.600918, "o", "                if steps[i] <= steps[i-1] {\r\n\u001b[?2004l\r"]
[4723.600985, "o", "\u001b[?2004h> "]
[4723.601123, "o", "                        increasing = false\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.601191, "o", "> "]
[4723.601264, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.601331, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.601434, "o", "        if decreasing {\r\n\u001b[?2004l\r"]
[4723.601499, "o", "\u001b[?2004h> "]
[4723.601606, "o", "                return \"converging\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.601671, "o", ">         }\r\n\u001b[?2004l\rt"]
[4723.601735, "o", "\u001b[?2004h> "]
[4723.601797, "o", "        if increasing {\r\n\u001b[?2004l\r"]
[4723.601863, "o", "\u001b[?2004h> "]
[4723.601964, "o", "                return \"diverging\"\r\n\u001b[?2004l\r"]
[4723.60203, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4723.602095, "o", "\u001b[?2004h> "]
[4723.602183, "o", "        return \"oscillating\"\r\n\u001b[?2004l\r"]
[4723.602263, "o", "\u001b[?2004h> }''',\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.602329, "o", "> "]
[4723.602492, "o", "'''func classifyConvergence(steps []float64) string {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.602557, "o", "> "]
[4723.602636, "o", "        if len(steps) <= 1 {\r\n\u001b[?2004l\r"]
[4723.602702, "o", "\u001b[?2004h> "]
[4723.602817, "o", "                return \"converging\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.602884, "o", ">         }\r\n\u001b[?2004l\r"]
[4723.602948, "o", "\u001b[?2004h> "]
[4723.603032, "o", "        nonIncreasing := true\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.603097, "o", "> "]
[4723.603174, "o", "        nonDecreasing := true\r\n\u001b[?2004l\r"]
[4723.603247, "o", "\u001b[?2004h> "]
[4723.60333, "o", "        hasIncrease := false\r\n\u001b[?2004l\r"]
[4723.603397, "o", "\u001b[?2004h> "]
[4723.603524, "o", "        for i := 1; i < len(steps); i++ {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.60359, "o", "> "]
[4723.60373, "o", "                if steps[i] > steps[i-1] {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.603797, "o", "> "]
[4723.60394, "o", "                        nonIncreasing = false\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.604004, "o", "> "]
[4723.604131, "o", "                        hasIncrease = true\r\n\u001b[?2004l\r"]
[4723.6042, "o", "\u001b[?2004h> "]
[4723.604272, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.60445, "o", "                if steps[i] < steps[i-1] {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.604515, "o", "> "]
[4723.604606, "o", "                        nonDecreasing = false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.604671, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.60474, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.604824, "o", "        if nonIncreasing {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.604934, "o", "                return \"converging\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.605009, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.605123, "o", "        if nonDecreasing && hasIncrease {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.605255, "o", "                return \"diverging\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.605321, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.605391, "o", "        return \"oscillating\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.605457, "o", "}'''\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[4723.605521, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.605753, "o", "# Remove duplicate original Analyze function by replacing its signature with delegation.\r\n\u001b[?2004l\r"]
[4723.605821, "o", "\u001b[?2004h> s = s.replace(\r\n\u001b[?2004l\r"]
[4723.605886, "o", "\u001b[?2004h> "]
[4723.605984, "o", "'''func Analyze(files []string) (*Result, error) {\r\n\u001b[?2004l\r"]
[4723.606049, "o", "\u001b[?2004h> "]
[4723.606113, "o", "        if len(files) < 2 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.606315, "o", "                return nil, fmt.Errorf(\"at least 2 input files required\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.606395, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[4723.606554, "o", "        cps := make([]*mlck.Checkpoint, len(files))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.606668, "o", "        for i, f := range files {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.606807, "o", "                cp, err := mlck.ParseFile(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.606903, "o", "                if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.607049, "o", "                        return nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.607102, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.607175, "o", "                cps[i] = cp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.60725, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.607314, "o", "        var allNames []string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.607397, "o", "        seen := map[string]bool{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.607478, "o", "        for _, cp := range cps {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.607584, "o", "                for _, t := range cp.Tensors {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.607683, "o", "                        if !seen[t.Name] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.607797, "o", "                                seen[t.Name] = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.607936, "o", "                                allNames = append(allNames, t.Name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.608004, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.608077, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4723.608143, "o", "\u001b[?2004h> "]
[4723.60821, "o", "        sort.Strings(allNames)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.608285, "o", "        skipped := []string{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.608356, "o", "        tensors := []TensorResult{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.608422, "o", "        converging := 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.608489, "o", "        diverging := 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4723.608554, "o", "\u001b[?2004h> "]
[4723.608622, "o", "        for _, name := range allNames {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.608697, "o", "                ok := true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.608758, "o", "                var shape []uint32\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.608855, "o", "                for _, cp := range cps {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.608988, "o", "                        t, exists := tensorByName(cp, name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.609076, "o", "                        if !exists {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.609173, "o", "                                ok = false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.609266, "o", "                                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.609333, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.669944, "o", "                        if shape == nil {\r\n\u001b[?2004l\r\u001b[?2004h>                                 shape = t.Shape\r\n\u001b[?2004l\r\u001b[?2004h>                         } else if !shapesEqual(shape, t.Shape) {\r\n\u001b[?2004l\r\u001b[?2004h>                                 ok = false\r\n\u001b[?2004l\r\u001b[?2004h>                                 break\r\n\u001b[?2004l\r\u001b[?2004h>                         }\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h>                 if !ok {\r\n\u001b[?2004l\r\u001b[?2004h>                         skipped = append(skipped, name)\r\n\u001b[?2004l\r\u001b[?2004h>                         continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4723.670031, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[4723.6701, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4723.67042, "o", "                steps := make([]float64, len(cps)-1)\r\n\u001b[?2004l\r"]
[4723.670487, "o", "\u001b[?2004h> "]
[4723.670755, "o", "                for i := 0; i < len(steps); i++ {\r\n\u001b[?2004l\r"]
[4723.670821, "o", "\u001b[?2004h> "]
[4723.671154, "o", "                        v1, err := tensorData(cps[i], name)\r\n\u001b[?2004l\r"]
[4723.671222, "o", "\u001b[?2004h> "]
[4723.671445, "o", "                        if err != nil {\r\n\u001b[?2004l\r"]
[4723.671512, "o", "\u001b[?2004h> "]
[4723.671771, "o", "                                return nil, err\r\n\u001b[?2004l\r"]
[4723.67184, "o", "\u001b[?2004h> "]
[4723.671991, "o", "                        }\r\n\u001b[?2004l\r"]
[4723.672059, "o", "\u001b[?2004h> "]
[4723.672403, "o", "                        v2, err := tensorData(cps[i+1], name)\r\n\u001b[?2004l\r"]
[4723.672472, "o", "\u001b[?2004h> "]
[4723.672684, "o", "                        if err != nil {\r\n\u001b[?2004l\r"]
[4723.672751, "o", "\u001b[?2004h> "]
[4723.673014, "o", "                                return nil, err\r\n\u001b[?2004l\r"]
[4723.673082, "o", "\u001b[?2004h> "]
[4723.673221, "o", "                        }\r\n\u001b[?2004l\r"]
[4723.673294, "o", "\u001b[?2004h> "]
[4723.673491, "o", "                        n := len(v1)\r\n\u001b[?2004l\r"]
[4723.67356, "o", "\u001b[?2004h> "]
[4723.673757, "o", "                        if n == 0 {\r\n\u001b[?2004l\r"]
[4723.673825, "o", "\u001b[?2004h> "]
[4723.674066, "o", "                                steps[i] = 0\r\n\u001b[?2004l\r"]
[4723.674133, "o", "\u001b[?2004h> "]
[4723.674361, "o", "                                continue\r\n\u001b[?2004l\r"]
[4723.674429, "o", "\u001b[?2004h> "]
[4723.674567, "o", "                        }\r\n\u001b[?2004l\r"]
[4723.674636, "o", "\u001b[?2004h> "]
[4723.674852, "o", "                        var sum float64\r\n\u001b[?2004l\r"]
[4723.67492, "o", "\u001b[?2004h> "]
[4723.675183, "o", "                        for j := 0; j < n; j++ {\r\n\u001b[?2004l\r"]
[4723.675259, "o", "\u001b[?2004h> "]
[4723.675603, "o", "                                sum += math.Abs(v1[j] - v2[j])\r\n\u001b[?2004l\r"]
[4723.675671, "o", "\u001b[?2004h> "]
[4723.675811, "o", "                        }\r\n\u001b[?2004l\r"]
[4723.675877, "o", "\u001b[?2004h> "]
[4723.676157, "o", "                        steps[i] = sum / float64(n)\r\n\u001b[?2004l\r"]
[4723.676223, "o", "\u001b[?2004h> "]
[4723.676333, "o", "                }\r\n\u001b[?2004l\r"]
[4723.676399, "o", "\u001b[?2004h"]
[4723.676465, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4723.676532, "o", "> "]
[4723.676731, "o", "                mean := meanFloat64(steps)\r\n\u001b[?2004l\r"]
[4723.676796, "o", "\u001b[?2004h> "]
[4723.677023, "o", "                max := maxFloat64(steps)\r\n\u001b[?2004l\r"]
[4723.677093, "o", "\u001b[?2004h> "]
[4723.677418, "o", "                convergence := classifyConvergence(steps)\r\n\u001b[?2004l\r"]
[4723.677485, "o", "\u001b[?2004h> "]
[4723.677664, "o", "                stability := 1.0\r\n\u001b[?2004l\r"]
[4723.677732, "o", "\u001b[?2004h> "]
[4723.677894, "o", "                if max != 0 {\r\n\u001b[?2004l\r"]
[4723.677963, "o", "\u001b[?2004h> "]
[4723.678331, "o", "                        stability = 1.0 - steps[len(steps)-1]/max\r\n\u001b[?2004l\r"]
[4723.678401, "o", "\u001b[?2004h> "]
[4723.678634, "o", "                        if stability < 0 {\r\n\u001b[?2004l\r"]
[4723.6787, "o", "\u001b[?2004h> "]
