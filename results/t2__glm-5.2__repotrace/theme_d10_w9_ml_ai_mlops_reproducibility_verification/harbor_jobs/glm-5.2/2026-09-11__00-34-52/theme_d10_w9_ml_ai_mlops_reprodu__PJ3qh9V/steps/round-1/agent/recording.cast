[4026.780149, "o", "nl -ba internal/compare/compare.go | sed -n '1,240p'\r\n\u001b[?2004l\r"]
[4026.78369, "o", "     1\tpackage compare\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t"]
[4026.783782, "o", "\t\"math\"\r\n     6\t\r\n     7\t\t\"repro-verify/internal/mlck\"\r\n     8\t)\r\n     9\t\r\n    10\ttype TensorResult struct {\r\n    11\t\tName          string  `json:\"name\"`\r\n    12\t\tMatch         bool    `json:\"match\"`\r\n    13\t\tMaxAbsDiff    float64 `json:\"max_abs_diff\"`\r\n    14\t\tMaxRelDiff    float64 `json:\"max_rel_diff\"`\r\n    15\t\tNumMismatches int     `json:\"num_mismatches\"`\r\n    16\t\tTotalElements int     `json:\"total_elements\"`\r\n    17\t}\r\n    18\t\r\n"]
[4026.78386, "o", "    19\ttype Result struct {\r\n    20\t\tMatch          bool           `json:\"match\"`\r\n    21\t\tMode           string         `json:\"mode\"`\r\n    22\t\tAtol           float64        `json:\"atol\"`\r\n    23\t\tRtol           float64        `json:\"rtol\"`\r\n    24\t\tTensorResults  []TensorResult `json:\"tensor_results\"`\r\n    25\t\tMissingInFile1 []string       `json:\"missing_in_file1\"`\r\n    26\t\tMissingInFile2 []string       `json:\"missing_in_file2\"`\r\n    27\t\tError          string         `json:\"error,omitempty\"`\r\n"]
[4026.783924, "o", "    28\t}\r\n    29\t\r\n    30\tfunc Compare(c1, c2 *mlck.Checkpoint, mode string, atol, rtol float64) (*Result, error) {\r\n    31\t\tif mode != \"strict\" && mode != \"relaxed\" {\r\n    32\t\t\treturn nil, fmt.Errorf(\"invalid mode %q\", mode)\r\n    33\t\t}\r\n    34\t\r\n    35\t\tresult := &Result{\r\n    36\t\t\tMatch:          true,\r\n"]
[4026.784039, "o", "    37\t\t\tMode:           mode,\r\n    38\t\t\tAtol:           atol,\r\n    39\t\t\tRtol:           rtol,\r\n    40\t\t\tTensorResults:  []TensorResult{},\r\n    41\t\t\tMissingInFile1: []string{},\r\n    42\t\t\tMissingInFile2: []string{},\r\n    43\t\t}\r\n    44\t\r\n    45\t\tmap2 := make(map[string]mlck.Tensor)\r\n    46\t\tfor _, t := range c2.Tensors {\r\n    47\t\t\tmap2[t.Name] = t\r\n    48\t\t}\r\n    49\t\tmap1 := make(map[string]mlck.Tensor)\r\n    50\t\tfor _, t := range c1.Tensors {\r\n    51\t\t\tmap1[t.Name] = t\r\n    52\t\t}\r\n"]
[4026.784103, "o", "    53\t\r\n    54\t\tfor _, t1 := range c1.Tensors {\r\n    55\t\t\tt2, ok := map2[t1.Name]\r\n    56\t\t\tif !ok {\r\n    57\t\t\t\tresult.MissingInFile2 = append(result.MissingInFile2, t1.Name)\r\n    58\t\t\t\tcontinue\r\n    59\t\t\t}\r\n    60\t\t\ttr := compareTensors(t1, t2, mode, atol, rtol)\r\n    61\t"]
[4026.784166, "o", "\t\tresult.TensorResults = append(result.TensorResults, tr)\r\n    62\t\t\tif !tr.Match {\r\n    63\t\t\t\tresult.Match = false\r\n    64\t\t\t}\r\n    65\t\t}\r\n    66\t\r\n    67\t\tfor _, t := range c2.Tensors {\r\n    68\t\t\tif _, ok := map1[t.Name]; !ok {\r\n    69\t\t\t\tresult.MissingInFile1 = append(result.MissingInFile1, t.Name)\r\n    70\t\t\t}\r\n    71"]
[4026.784223, "o", "\t\t}\r\n    72\t\r\n    73\t\tif len(result.MissingInFile1) > 0 || len(result.MissingInFile2) > 0 {\r\n    74\t\t\tresult.Match = false\r\n    75\t\t}\r\n    76\t\r\n    77\t\treturn result, nil\r\n    78\t}\r\n    79\t\r\n"]
[4026.784312, "o", "    80\tfunc compareTensors(t1, t2 mlck.Tensor, mode string, atol, rtol float64) TensorResult {\r\n    81\t\ttotal := int(mlck.Product(t1.Shape))\r\n    82\t\ttr := TensorResult{\r\n    83\t\t\tName:          t1.Name,\r\n    84\t\t\tMatch:         true,\r\n    85\t\t\tMaxAbsDiff:    0,\r\n    86\t\t\tMaxRelDiff:    0,\r\n    87\t\t\tNumMismatches: 0,\r\n"]
[4026.784373, "o", "    88\t\t\tTotalElements: total,\r\n    89\t\t}\r\n    90\t\r\n    91\t\tif !shapesEqual(t1.Shape, t2.Shape) {\r\n    92\t\t\ttr.Match = false\r\n    93\t\t\ttr.NumMismatches = total\r\n"]
[4026.78443, "o", "    94\t\t\treturn tr\r\n    95\t\t}\r\n    96\t\r\n    97\t\tif total == 0 {\r\n    98\t\t\treturn tr\r\n    99\t\t}\r\n   100\t\r\n   101\t\tvals1, err := t1.Float64Values()\r\n"]
[4026.784492, "o", "   102\t\tif err != nil {\r\n   103\t\t\ttr.Match = false\r\n   104\t\t\ttr.NumMismatches = total\r\n   105\t\t\treturn tr\r\n   106\t\t}\r\n   107\t\tvals2, err := t2.Float64Values()\r\n   108\t\tif err != nil {\r\n   109\t\t\ttr.Match = false\r\n   110\t"]
[4026.784565, "o", "\t\ttr.NumMismatches = total\r\n   111\t\t\treturn tr\r\n   112\t\t}\r\n   113\t\r\n   114\t\tthreshold := int(math.Floor(float64(total) * 0.001))\r\n   115\t\tfor i := 0; i < total; i++ {\r\n   116\t\t\ta := vals1[i]\r\n   117\t\t\tb := vals2[i]\r\n   118\t\t\tdiff := math.Abs(a - b)\r\n   119\t\t\tif diff > tr.MaxAbsDiff {\r\n   120\t\t\t"]
[4026.78463, "o", "\ttr.MaxAbsDiff = diff\r\n   121\t\t\t}\r\n   122\t\t\tvar rel float64\r\n   123\t\t\tif math.Abs(b) > 0 {\r\n   124\t\t\t\trel = diff / math.Abs(b)\r\n   125\t\t\t} else if diff > 0 {\r\n   126\t\t\t\trel = diff\r\n   127\t\t\t}\r\n   128\t\t\tif rel > tr.MaxRelDiff {\r\n   129\t\t\t\ttr.MaxRelDiff = rel\r\n"]
[4026.784693, "o", "   130\t\t\t}\r\n   131\t\t\tif diff > atol+rtol*math.Abs(b) {\r\n   132\t\t\t\ttr.NumMismatches++\r\n   133\t\t\t}\r\n   134\t\t}\r\n   135\t\r\n   136\t\tswitch mode {\r\n   137\t\tcase \"strict\":\r\n   138"]
[4026.784753, "o", "\t\t\ttr.Match = tr.NumMismatches == 0\r\n   139\t\tcase \"relaxed\":\r\n   140\t\t\ttr.Match = tr.NumMismatches <= threshold\r\n   141\t\t}\r\n   142\t\r\n   143\t\treturn tr\r\n   144\t}\r\n   145\t\r\n"]
[4026.78481, "o", "   146\tfunc shapesEqual(a, b []uint32) bool {\r\n   147\t\tif len(a) != len(b) {\r\n   148\t\t\treturn false\r\n   149\t\t}\r\n   150\t\tfor i := range a {\r\n   151\t\t\tif a[i] != b[i] {\r\n   152\t\t\t\treturn false\r\n   153\t\t\t}\r\n   154\t"]
[4026.78487, "o", "\t}\r\n   155\t\treturn true\r\n   156\t}\r\n"]
[4026.785368, "o", "\u001b[?2004h"]
