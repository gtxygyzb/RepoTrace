[5209.532364, "o", "grep: ./repro-verify: binary file matches\r\n./internal/app/app.go:39:\tcase \"drift-analysis\":\r\n./internal/app/app.go:221:\tfs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\r\n./internal/app/app.go:224:\ttopK := fs.Int(\"top-k\", 0, \"number of tensors with the lowest stability scores to include\")\r\n./internal/app/app.go:232:\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\r\n./internal/app/app.go:238:\t\tif f.Name == \"top-k\" {\r\n./internal/app/app.go:244:\t\toutputJSON(map[string]interface{}{\"error\": \"--top-k must be non-negative\"})\r\n./internal/app/app.go:248:\tres, err := drift.AnalyzeWithTopK(pos, topKPtr)\r\n./internal/drift/drift.go:26:\tTopK               *int           `json:\"top_k,omitempty\"`\r\n./internal/drift/drift.go:29:// Analyze remains available for callers that do not need a top-k restriction.\r\n./internal/drift/drift.go:31:\treturn AnalyzeWithTopK(files, nil)\r\n./internal/drift/drift.go:34:// AnalyzeWithTopK analyzes drift and optionall"]
