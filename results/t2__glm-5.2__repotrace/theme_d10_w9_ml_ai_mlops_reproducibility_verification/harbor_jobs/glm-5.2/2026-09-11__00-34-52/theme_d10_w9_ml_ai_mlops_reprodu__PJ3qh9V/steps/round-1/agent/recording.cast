[5935.478167, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/drift/drift.go')\ns = p.read_text()\nold = '''\\t\\tmean := meanFloat64(steps)\n\\t\\tmax := maxFloat64(steps)\n\\t\\tconvergence := classifyConvergence(steps)\n\\t\\tstability := 1.0\n\\t\\tif max != 0 {\n\\t\\t\\tstability = 1.0 - steps[len(steps)-1]/max\n\\t\\t\\tif stability < 0 {\n\\t\\t\\t\\tstability = 0\n\\t\\t\\t} else if stability > 1 {\n\\t\\t\\t\\tstability = 1\n\\t\\t\\t}\n\\t\\t}\n'''\nnew = '''\\t\\tmean := meanFloat64(steps)\n\\t\\tmax := maxFloat64(steps)\n\\t\\tconvergence := classifyConvergence(steps)\n\\t\\tstability := 1.0\n\\t\\tif mean != 0 {\n\\t\\t\\tstability = 1.0 - steps[len(steps)-1]/mean\n\\t\\t\\tif stability < 0 {\n\\t\\t\\t\\tstability = 0\n\\t\\t\\t} else if stability > 1 {\n\\t\\t\\t\\tstability = 1\n\\t\\t\\t}\n\\t\\t}\n'''\nif old not in s:\n    raise SystemExit('stability block not found')\ns = s.replace(old, new)\nold_func = '''func classifyConvergence(steps []float64) string {\n\\tif len(steps) <= 1 {\n\\t\\treturn \"converging\"\n\\t}\n\\tnonIncreasing := true\n\\tnonDecreasing := true\n\\thasIncrease := false\n\\tfor "]
[5935.478469, "i", "i := 1; i < len(steps); i++ {\n\\t\\tif steps[i] > steps[i-1] {\n\\t\\t\\tnonIncreasing = false\n\\t\\t\\thasIncrease = true\n\\t\\t}\n\\t\\tif steps[i] < steps[i-1] {\n\\t\\t\\tnonDecreasing = false\n\\t\\t}\n\\t}\n\\tif nonIncreasing {\n\\t\\treturn \"converging\"\n\\t}\n\\tif nonDecreasing && hasIncrease {\n\\t\\treturn \"diverging\"\n\\t}\n\\treturn \"oscillating\"\n}\n'''\nnew_func = '''func classifyConvergence(steps []float64) string {\n\\tif len(steps) <= 1 {\n\\t\\treturn \"converging\"\n\\t}\n\\tnonIncreasing := true\n\\tnonDecreasing := true\n\\thasIncrease := false\n\\tallEqualNonZero := steps[0] != 0\n\\tfor i := 1; i < len(steps); i++ {\n\\t\\tif steps[i] > steps[i-1] {\n\\t\\t\\tnonIncreasing = false\n\\t\\t\\thasIncrease = true\n\\t\\t}\n\\t\\tif steps[i] < steps[i-1] {\n\\t\\t\\tnonDecreasing = false\n\\t\\t}\n\\t\\tif steps[i] != steps[i-1] || steps[i] == 0 {\n\\t\\t\\tallEqualNonZero = false\n\\t\\t}\n\\t}\n\\tif allEqualNonZero {\n\\t\\treturn \"stable\"\n\\t}\n\\tif nonIncreasing {\n\\t\\treturn \"converging\"\n\\t}\n\\tif nonDecreasing && hasIncrease {\n\\t\\treturn \"diverging\"\n\\t}\n\\treturn \"oscillating\"\n}\n'''\nif o"]
