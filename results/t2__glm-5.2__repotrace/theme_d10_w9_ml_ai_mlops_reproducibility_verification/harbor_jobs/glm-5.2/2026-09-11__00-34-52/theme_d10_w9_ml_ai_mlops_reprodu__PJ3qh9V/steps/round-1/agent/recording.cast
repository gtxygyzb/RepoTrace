[436.886847, "i", "e(sum[:])\n\treturn buf.Bytes(), nil\n}\n\nfunc WriteFile(path string, metadata map[string]interface{}, tensors []Tensor) error {\n\tdata, err := Build(metadata, tensors)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(path, data, 0644)\n}\n\nfunc (t Tensor) Float64Values() ([]float64, error) {\n\tsize := DtypeSize(t.Dtype)\n\tif size == 0 {\n\t\treturn nil, fmt.Errorf(\"invalid dtype %d\", t.Dtype)\n\t}\n\tn := len(t.Data) / size\n\tif len(t.Data)%size != 0 {\n\t\treturn nil, fmt.Errorf(\"tensor %s data length not multiple of dtype size\", t.Name)\n\t}\n\tvals := make([]float64, n)\n\tfor i := 0; i < n; i++ {\n\t\tstart := i * size\n\t\tswitch Dtype(t.Dtype) {\n\t\tcase Float32:\n\t\t\tbits := binary.LittleEndian.Uint32(t.Data[start : start+4])\n\t\t\tvals[i] = float64(math.Float32frombits(bits))\n\t\tcase Float64:\n\t\t\tbits := binary.LittleEndian.Uint64(t.Data[start : start+8])\n\t\t\tvals[i] = math.Float64frombits(bits)\n\t\tcase Int32:\n\t\t\tvals[i] = float64(int32(binary.LittleEndian.Uint32(t.Data[start : start+4])))\n\t\tcase Int64:\n\t\t\tvals[i] = float64(int64(binary."]
