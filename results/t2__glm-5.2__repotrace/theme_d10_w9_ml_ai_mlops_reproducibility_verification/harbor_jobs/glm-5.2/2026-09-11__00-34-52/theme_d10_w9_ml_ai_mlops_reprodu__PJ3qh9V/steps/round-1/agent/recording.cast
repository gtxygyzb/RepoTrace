[3744.742717, "o", "    26\t\r\n    27\tfunc Analyze(files []string) (*Result, error) {\r\n    28\t\tif len(files) < 2 {\r\n    29\t\t\treturn nil, fmt.Errorf(\"at least 2 input files required\")\r\n    30\t\t}\r\n    31\t\r\n    32\t\tcps := make([]*mlck.Checkpoint, len(files))\r\n    33\t\tfor i, f := range files {\r\n    34\t\t\tcp, err := mlck.ParseFile(f)\r\n"]
