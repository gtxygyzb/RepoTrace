[527.275503, "o", "\u001b[?2004h> "]
[527.275854, "o", "func ParseFile(path string) (*Checkpoint, error) {\r\n\u001b[?2004l\r"]
[527.275903, "o", "\u001b[?2004h> "]
[527.276151, "o", "    data, err := os.ReadFile(path)\r\n\u001b[?2004l\r"]
[527.276197, "o", "\u001b[?2004h> "]
[527.276353, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[527.276401, "o", "\u001b[?2004h> "]
[527.276572, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[527.276618, "o", "\u001b[?2004h"]
[527.276664, "o", "> "]
[527.27671, "o", "    }\r\n\u001b[?2004l\r"]
[527.276755, "o", "\u001b[?2004h> "]
[527.276943, "o", "    return Parse(data, path)\r\n\u001b[?2004l\r"]
[527.276988, "o", "\u001b[?2004h> "]
[527.277032, "o", "}\r\n\u001b[?2004l\r"]
[527.277077, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[527.277122, "o", "\u001b[?2004h> "]
[527.277549, "o", "func Parse(data []byte, path string) (*Checkpoint, error) {\r\n\u001b[?2004l\r"]
[527.2776, "o", "\u001b[?2004h> "]
[527.277895, "o", "    if len(data) < HeaderSize+FooterSize {\r\n\u001b[?2004l\r"]
[527.277943, "o", "\u001b[?2004h> "]
[527.278291, "o", "        return nil, fmt.Errorf(\"file too small\")\r\n\u001b[?2004l\r"]
[527.278342, "o", "\u001b[?2004h> "]
[527.27839, "o", "    }\r\n\u001b[?2004l\r"]
[527.278438, "o", "\u001b[?2004h"]
[527.278482, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[527.278527, "o", "> "]
[527.278758, "o", "    if string(data[0:4]) != Magic {\r\n\u001b[?2004l\r"]
[527.278803, "o", "\u001b[?2004h> "]
[527.279108, "o", "        return nil, fmt.Errorf(\"bad magic\")\r\n\u001b[?2004l\r"]
[527.279155, "o", "\u001b[?2004h> "]
[527.2792, "o", "    }\r\n\u001b[?2004l\r"]
[527.279253, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[527.279299, "o", "\u001b[?2004h> "]
[527.279652, "o", "    version := binary.LittleEndian.Uint32(data[4:8])\r\n\u001b[?2004l\r"]
[527.279691, "o", "\u001b[?2004h"]
[527.279727, "o", "> "]
[527.279884, "o", "    if version != Version {\r\n\u001b[?2004l\r"]
[527.279922, "o", "\u001b[?2004h> "]
[527.280371, "o", "        return nil, fmt.Errorf(\"unsupported version %d\", version)\r\n\u001b[?2004l\r"]
[527.28041, "o", "\u001b[?2004h> "]
[527.280463, "o", "    }\r\n\u001b[?2004l\r"]
[527.280499, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[527.280537, "o", "\u001b[?2004h"]
[527.280574, "o", "> "]
[527.280934, "o", "    numTensors := binary.LittleEndian.Uint32(data[8:12])\r\n\u001b[?2004l\r"]
[527.280973, "o", "\u001b[?2004h> "]
[527.28135, "o", "    metaLen := binary.LittleEndian.Uint32(data[12:16])\r\n\u001b[?2004l\r"]
[527.281389, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[527.281426, "o", "\u001b[?2004h"]
[527.281464, "o", "> "]
[527.281815, "o", "    if len(data) < HeaderSize+int(metaLen)+FooterSize {\r\n\u001b[?2004l\r"]
[527.281852, "o", "\u001b[?2004h> "]
[527.2823, "o", "        return nil, fmt.Errorf(\"metadata length exceeds file size\")\r\n\u001b[?2004l\r"]
[527.282341, "o", "\u001b[?2004h> "]
[527.28238, "o", "    }\r\n"]
[527.282416, "o", "\u001b[?2004l\r\u001b[?2004h"]
[527.282454, "o", "> \r\n\u001b[?2004l\r"]
[527.282491, "o", "\u001b[?2004h> "]
[527.282787, "o", "    preceding := data[:len(data)-FooterSize]\r\n\u001b[?2004l\r"]
[527.282826, "o", "\u001b[?2004h> "]
[527.283099, "o", "    footer := data[len(data)-FooterSize:]\r\n\u001b[?2004l\r"]
[527.283136, "o", "\u001b[?2004h"]
[527.283175, "o", "> "]
[527.283413, "o", "    sum := sha256.Sum256(preceding)\r\n\u001b[?2004l\r"]
[527.283453, "o", "\u001b[?2004h> "]
[527.283788, "o", "    fileChecksum := hex.EncodeToString(sum[:])\r\n\u001b[?2004l\r"]
[527.283826, "o", "\u001b[?2004h> "]
[527.284178, "o", "    if hex.EncodeToString(footer) != fileChecksum {\r\n\u001b[?2004l\r"]
[527.284217, "o", "\u001b[?2004h> "]
[527.284561, "o", "        return nil, fmt.Errorf(\"checksum mismatch\")\r\n\u001b[?2004l\r"]
[527.284598, "o", "\u001b[?2004h> "]
[527.284658, "o", "    }\r\n\u001b[?2004l\r"]
[527.284696, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[527.284734, "o", "\u001b[?2004h"]
[527.284766, "o", "> "]
[527.285136, "o", "    metaRaw := data[HeaderSize : HeaderSize+int(metaLen)]\r\n\u001b[?2004l\r"]
[527.285174, "o", "\u001b[?2004h> "]
[527.285462, "o", "    var metadata map[string]interface{}\r\n\u001b[?2004l\r"]
[527.285501, "o", "\u001b[?2004h> "]
[527.28566, "o", "    if metaLen > 0 {\r\n\u001b[?2004l\r"]
[527.285699, "o", "\u001b[?2004h> "]
[527.286158, "o", "        if err := json.Unmarshal(metaRaw, &metadata); err != nil {\r\n\u001b[?2004l\r"]
[527.286197, "o", "\u001b[?2004h> "]
[527.286679, "o", "            return nil, fmt.Errorf(\"invalid metadata JSON: %v\", err)\r\n\u001b[?2004l\r"]
[527.286724, "o", "\u001b[?2004h> "]
[527.286793, "o", "        }\r\n\u001b[?2004l\r"]
[527.286829, "o", "\u001b[?2004h"]
[527.286866, "o", "> "]
[527.286935, "o", "    } else {\r\n\u001b[?2004l\r"]
[527.286973, "o", "\u001b[?2004h> "]
[527.28728, "o", "        metadata = map[string]interface{}{}\r\n\u001b[?2004l\r"]
[527.287325, "o", "\u001b[?2004h> "]
[527.287366, "o", "    }\r\n\u001b[?2004l\r"]
[527.287403, "o", "\u001b[?2004h"]
[527.287441, "o", "> \r\n\u001b[?2004l\r"]
[527.287478, "o", "\u001b[?2004h> "]
[527.287748, "o", "    offset := HeaderSize + int(metaLen)\r\n\u001b[?2004l\r"]
[527.287787, "o", "\u001b[?2004h> "]
[527.288092, "o", "    tensors := make([]Tensor, 0, numTensors)\r\n\u001b[?2004l\r"]
[527.28813, "o", "\u001b[?2004h"]
[527.288169, "o", "> \r\n\u001b[?2004l\r"]
[527.288207, "o", "\u001b[?2004h> "]
[527.288522, "o", "    for i := uint32(0); i < numTensors; i++ {\r\n\u001b[?2004l\r"]
[527.288561, "o", "\u001b[?2004h> "]
[527.288838, "o", "        if offset+4 > len(preceding) {\r\n\u001b[?2004l\r"]
[527.288882, "o", "\u001b[?2004h> "]
[527.289201, "o", "            return nil, fmt.Errorf(\"truncated tensor name length\")\r\n\u001b[?2004l\r"]
[527.289251, "o", "\u001b[?2004h> "]
[527.289291, "o", "        }\r\n\u001b[?2004l\r"]
[527.28933, "o", "\u001b[?2004h> "]
[527.289689, "o", "        nameLen := binary.LittleEndian.Uint32(data[offset : offset+4])\r\n\u001b[?2004l\r"]
[527.289727, "o", "\u001b[?2004h> "]
[527.289816, "o", "        offset += 4\r\n\u001b[?2004l\r"]
[527.289853, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[527.289891, "o", "\u001b[?2004h> "]
[527.29015, "o", "        if offset+int(nameLen) > len(preceding) {\r\n\u001b[?2004l\r"]
[527.290188, "o", "\u001b[?2004h> "]
[527.290445, "o", "            return nil, fmt.Errorf(\"truncated tensor name\")\r\n\u001b[?2004l\r"]
[527.290484, "o", "\u001b[?2004h> "]
[527.290529, "o", "        }\r\n\u001b[?2004l\r"]
[527.290566, "o", "\u001b[?2004h> "]
[527.290839, "o", "        name := string(data[offset : offset+int(nameLen)])\r\n\u001b[?2004l\r"]
[527.290884, "o", "\u001b[?2004h> "]
[527.291014, "o", "        offset += int(nameLen)\r\n\u001b[?2004l\r"]
[527.291059, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[527.291103, "o", "\u001b[?2004h> "]
[527.291278, "o", "        if offset+1 > len(preceding) {\r\n\u001b[?2004l\r"]
[527.291323, "o", "\u001b[?2004h> "]
[527.291577, "o", "            return nil, fmt.Errorf(\"truncated tensor dtype\")\r\n\u001b[?2004l\r"]
[527.291615, "o", "\u001b[?2004h> "]
[527.291654, "o", "        }\r\n\u001b[?2004l\r"]
[527.291692, "o", "\u001b[?2004h> "]
[527.291829, "o", "        dtype := data[offset]\r\n\u001b[?2004l\r"]
[527.291873, "o", "\u001b[?2004h> "]
[527.29195, "o", "        offset += 1\r\n\u001b[?2004l\r"]
[527.291994, "o", "\u001b[?2004h> "]
[527.292143, "o", "        if !Dtype(dtype).Valid() {\r\n\u001b[?2004l\r"]
[527.292188, "o", "\u001b[?2004h> "]
[527.292448, "o", "            return nil, fmt.Errorf(\"invalid dtype %d\", dtype)\r\n\u001b[?2004l\r"]
[527.292493, "o", "\u001b[?2004h> "]
[527.292533, "o", "        }\r\n\u001b[?2004l\r"]
[527.292578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r.\u001b[?2004h"]
[527.292623, "o", "> "]
[527.292781, "o", "        if offset+4 > len(preceding) {\r\n\u001b[?2004l\r"]
[527.292826, "o", "\u001b[?2004h> "]
[527.293076, "o", "            return nil, fmt.Errorf(\"truncated tensor ndim\")\r\n\u001b[?2004l\r"]
[527.293121, "o", "\u001b[?2004h> "]
[527.293166, "o", "        }\r\n\u001b[?2004l\r"]
[527.293204, "o", "\u001b[?2004h> "]
[527.293514, "o", "        ndim := binary.LittleEndian.Uint32(data[offset : offset+4])\r\n\u001b[?2004l\r"]
[527.293557, "o", "\u001b[?2004h> "]
[527.293636, "o", "        offset += 4\r\n\u001b[?2004l\r"]
[527.293681, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[527.293719, "o", "> "]
[527.293869, "o", "        shape := make([]uint32, ndim)\r\n\u001b[?2004l\r"]
[527.293908, "o", "\u001b[?2004h> "]
[527.29414, "o", "        if offset+4*int(ndim) > len(preceding) {\r\n\u001b[?2004l\r"]
[527.294185, "o", "\u001b[?2004h> "]
[527.294427, "o", "            return nil, fmt.Errorf(\"truncated tensor shape\")\r\n\u001b[?2004l\r"]
[527.294472, "o", "\u001b[?2004h> "]
[527.294516, "o", "        }\r\n\u001b[?2004l\r"]
[527.294561, "o", "\u001b[?2004h> "]
[527.294741, "o", "        for j := uint32(0); j < ndim; j++ {\r\n\u001b[?2004l\r"]
[527.294787, "o", "\u001b[?2004h> "]
[527.29511, "o", "            shape[j] = binary.LittleEndian.Uint32(data[offset : offset+4])\r\n\u001b[?2004l\r"]
[527.295154, "o", "\u001b[?2004h> "]
[527.295249, "o", "            offset += 4\r\n\u001b[?2004l\r"]
[527.295288, "o", "\u001b[?2004h> "]
[527.295328, "o", "        }\r\n\u001b[?2004l\r"]
[527.295366, "o", "\u001b[?2004h> "]
[527.295404, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.295574, "o", "        elemSize := DtypeSize(dtype)\r\n\u001b[?2004l\r"]
[527.295611, "o", "\u001b[?2004h> "]
[527.295757, "o", "        numElems := Product(shape)\r\n\u001b[?2004l\r"]
[527.295802, "o", "\u001b[?2004h> "]
[527.296012, "o", "        dataLen := numElems * int64(elemSize)\r\n\u001b[?2004l\r"]
[527.296057, "o", "\u001b[?2004h> "]
[527.296377, "o", "        if dataLen < 0 || offset+int(dataLen) > len(preceding) {\r\n\u001b[?2004l\r"]
[527.296422, "o", "\u001b[?2004h> "]
[527.296692, "o", "            return nil, fmt.Errorf(\"truncated tensor data\")\r\n\u001b[?2004l\r"]
[527.29673, "o", "\u001b[?2004h> "]
[527.296767, "o", "        }\r\n\u001b[?2004l\r"]
[527.296812, "o", "\u001b[?2004h> "]
[527.29706, "o", "        tensorData := data[offset : offset+int(dataLen)]\r\n\u001b[?2004l\r"]
[527.297099, "o", "\u001b[?2004h> "]
[527.297242, "o", "        offset += int(dataLen)\r\n\u001b[?2004l\r"]
[527.297287, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rl"]
[527.297325, "o", "\u001b[?2004h> "]
[527.297505, "o", "        tSum := sha256.Sum256(tensorData)\r\n\u001b[?2004l\r"]
[527.297549, "o", "\u001b[?2004h> "]
[527.297732, "o", "        tensors = append(tensors, Tensor{\r\n\u001b[?2004l\r"]
[527.297776, "o", "\u001b[?2004h> "]
[527.297888, "o", "            Name: name,\r\n\u001b[?2004l\r"]
[527.297927, "o", "\u001b[?2004h> "]
[527.298035, "o", "            Dtype: dtype,\r\n\u001b[?2004l\r"]
[527.298079, "o", "\u001b[?2004h> "]
[527.298203, "o", "            Shape: shape,\r\n\u001b[?2004l\r"]
[527.298257, "o", "\u001b[?2004h> "]
[527.298385, "o", "            Data: tensorData,\r\n\u001b[?2004l\r"]
[527.29843, "o", "\u001b[?2004h> "]
[527.298636, "o", "            Checksum: hex.EncodeToString(tSum[:]),\r\n\u001b[?2004l\r"]
[527.298675, "o", "\u001b[?2004h> "]
[527.298734, "o", "        })\r\n\u001b[?2004l\r"]
[527.298772, "o", "\u001b[?2004h> "]
[527.298817, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.298862, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h"]
[527.2989, "o", "> "]
[527.299031, "o", "    if offset != len(preceding) {\r\n\u001b[?2004l\r"]
[527.299077, "o", "\u001b[?2004h> "]
[527.299298, "o", "        return nil, fmt.Errorf(\"extra data after tensors\")\r\n\u001b[?2004l\r"]
[527.299346, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[527.29939, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[527.299483, "o", "    return &Checkpoint{\r\n\u001b[?2004l\r"]
[527.299529, "o", "\u001b[?2004h> "]
[527.29961, "o", "        Version: version,\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.299656, "o", "> "]
[527.299734, "o", "        NumTensors: numTensors,\r\n\u001b[?2004l\r"]
[527.29978, "o", "\u001b[?2004h> "]
[527.299858, "o", "        Metadata: metadata,\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.299905, "o", "> "]
[527.299997, "o", "        MetadataRaw: metaRaw,\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.300041, "o", "> "]
[527.300106, "o", "        Tensors: tensors,\r\n\u001b[?2004l\r"]
[527.300151, "o", "\u001b[?2004h> "]
[527.30027, "o", "        FileChecksum: fileChecksum,\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.300317, "o", "> "]
[527.300382, "o", "        FilePath: path,\r\n\u001b[?2004l\r "]
[527.300431, "o", "\u001b[?2004h> "]
[527.300475, "o", "    }, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[527.300521, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[527.300798, "o", "func Build(metadata map[string]interface{}, tensors []Tensor) ([]byte, error) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.300844, "o", "> "]
[527.30097, "o", "    metaRaw, err := json.Marshal(metadata)\r\n\u001b[?2004l\r"]
[527.301016, "o", "\u001b[?2004h> "]
[527.301061, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[527.301107, "o", "\u001b[?2004h> "]
[527.301344, "o", "        return nil, fmt.Errorf(\"failed to marshal metadata: %v\", err)\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.301394, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.30144, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.301532, "o", "    var buf bytes.Buffer\r\n\u001b[?2004l\rt\u001b[?2004h"]
[527.301577, "o", "> "]
[527.301691, "o", "    header := make([]byte, HeaderSize)\r\n\u001b[?2004l\r"]
[527.301736, "o", "\u001b[?2004h> "]
[527.301806, "o", "    copy(header[0:4], Magic)\r\n\u001b[?2004l\r"]
[527.301853, "o", "\u001b[?2004h> "]
[527.302023, "o", "    binary.LittleEndian.PutUint32(header[4:8], Version)\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.302068, "o", "> "]
[527.302215, "o", "    binary.LittleEndian.PutUint32(header[8:12], uint32(len(tensors)))\r\n\u001b[?2004l\r"]
[527.302274, "o", "\u001b[?2004h> "]
[527.302416, "o", "    binary.LittleEndian.PutUint32(header[12:16], uint32(len(metaRaw)))\r\n\u001b[?2004l\r"]
[527.302462, "o", "\u001b[?2004h> "]
[527.302509, "o", "    buf.Write(header)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.302576, "o", "    buf.Write(metaRaw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.302621, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.302707, "o", "    for _, t := range tensors {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.302816, "o", "        nameBytes := []byte(t.Name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.302861, "o", "> "]
[527.303069, "o", "        if err := binary.Write(&buf, binary.LittleEndian, uint32(len(nameBytes))); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.303121, "o", "> "]
[527.303167, "o", "            return nil, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.303215, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.303311, "o", "        buf.Write(nameBytes)\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.303356, "o", "> "]
[527.303401, "o", "        buf.WriteByte(t.Dtype)\r\n\u001b[?2004l\r"]
[527.303447, "o", "\u001b[?2004h> "]
[527.303656, "o", "        if err := binary.Write(&buf, binary.LittleEndian, uint32(len(t.Shape))); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.303701, "o", "> "]
[527.303745, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[527.30379, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[527.303835, "o", "\u001b[?2004h> "]
[527.303914, "o", "        for _, s := range t.Shape {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.304123, "o", "            if err := binary.Write(&buf, binary.LittleEndian, s); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.304168, "o", "> "]
[527.304236, "o", "                return nil, err\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.304281, "o", ">             }\r\n\u001b[?2004l\r"]
[527.304327, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[527.304373, "o", "\u001b[?2004h> "]
[527.304522, "o", "        expected := Product(t.Shape) * int64(DtypeSize(t.Dtype))\r\n\u001b[?2004l\r"]
[527.304568, "o", "\u001b[?2004h> "]
[527.304654, "o", "        if int64(len(t.Data)) != expected {\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.304699, "o", "> "]
[527.305032, "o", "            return nil, fmt.Errorf(\"tensor %s data length %d does not match shape %v and dtype %s\", t.Name, len(t.Data), t.Shape, DtypeName(t.Dtype))\r\n\u001b[?2004l\r"]
[527.305078, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[527.305122, "o", "\u001b[?2004h> "]
[527.305167, "o", "        buf.Write(t.Data)\r\n\u001b[?2004l\r"]
[527.305213, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[527.305259, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.305367, "o", "    sum := sha256.Sum256(buf.Bytes())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.305442, "o", "    buf.Write(sum[:])\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.305487, "o", "> "]
[527.305532, "o", "    return buf.Bytes(), nil\r\n\u001b[?2004l\r"]
[527.305576, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.305621, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.305826, "o", "func WriteFile(path string, metadata map[string]interface{}, tensors []Tensor) error {\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.305871, "o", "> "]
[527.305954, "o", "    data, err := Build(metadata, tensors)\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.305999, "o", "> "]
[527.306043, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.306088, "o", "        return err\r\n\u001b[?2004l\r"]
[527.306134, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[527.306178, "o", "\u001b[?2004h> "]
[527.306276, "o", "    return os.WriteFile(path, data, 0644)\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.306321, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[527.306366, "o", "\u001b[?2004h> "]
[527.306488, "o", "func (t Tensor) Float64Values() ([]float64, error) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.306533, "o", "> "]
[527.306578, "o", "    size := DtypeSize(t.Dtype)\r\n\u001b[?2004l\r"]
[527.306623, "o", "\u001b[?2004h> "]
[527.306668, "o", "    if size == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.306827, "o", "        return nil, fmt.Errorf(\"invalid dtype %d\", t.Dtype)\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.306874, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.306919, "o", "> "]
[527.306965, "o", "    n := len(t.Data) / size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.30706, "o", "    if len(t.Data)%size != 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.307105, "o", "> "]
[527.307305, "o", "        return nil, fmt.Errorf(\"tensor %s data length not multiple of dtype size\", t.Name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.307352, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.307396, "o", "> "]
[527.307442, "o", "    vals := make([]float64, n)\r\n\u001b[?2004l\r"]
[527.307487, "o", "\u001b[?2004h> "]
[527.307533, "o", "    for i := 0; i < n; i++ {\r\n\u001b[?2004l\r"]
[527.307578, "o", "\u001b[?2004h> "]
[527.307623, "o", "        start := i * size\r\n\u001b[?2004l\r"]
[527.307667, "o", "\u001b[?2004h> "]
[527.307737, "o", "        switch Dtype(t.Dtype) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.307782, "o", "> "]
[527.307828, "o", "        case Float32:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.308011, "o", "            bits := binary.LittleEndian.Uint32(t.Data[start : start+4])\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.308056, "o", "> "]
[527.308175, "o", "            vals[i] = float64(math.Float32frombits(bits))\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.30822, "o", "> "]
[527.308273, "o", "        case Float64:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.308456, "o", "            bits := binary.LittleEndian.Uint64(t.Data[start : start+8])\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.308503, "o", "> "]
[527.308598, "o", "            vals[i] = math.Float64frombits(bits)\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.308643, "o", "> "]
[527.308688, "o", "        case Int32:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.308911, "o", "            vals[i] = float64(int32(binary.LittleEndian.Uint32(t.Data[start : start+4])))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.308983, "o", "        case Int64:\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.309027, "o", "> "]
[527.309165, "o", "            vals[i] = float64(int64(binary.LittleEndian.Uint64(t.Data[start : start+8])))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.309215, "o", "        default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.309332, "o", "            return nil, fmt.Errorf(\"invalid dtype %d\", t.Dtype)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.309376, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.309426, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.309477, "o", "    return vals, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[527.309526, "o", "\u001b[?2004h> "]
[527.309613, "o", "func EncodeFloat64Values(vals []float64, dtype uint8) ([]byte, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.309663, "o", "    var buf bytes.Buffer\r\n\u001b[?2004l\r"]
[527.309712, "o", "\u001b[?2004h>     switch Dtype(dtype) {\r\n\u001b[?2004l\r"]
[527.309761, "o", "\u001b[?2004h>     case Float32:\r\n\u001b[?2004l\r"]
[527.309786, "o", "\u001b[?2004h> "]
[527.309841, "o", "        for _, v := range vals {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.310022, "o", "            if err := binary.Write(&buf, binary.LittleEndian, math.Float32bits(float32(v))); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.310088, "o", "                return nil, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.310127, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.310165, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.310207, "o", "    case Float64:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.36999, "o", "        for _, v := range vals {\r\n\u001b[?2004l\r"]
[527.370055, "o", "\u001b[?2004h> "]
[527.370621, "o", "            if err := binary.Write(&buf, binary.LittleEndian, math.Float64bits(v)); err != nil {\r\n\u001b[?2004l\r"]
[527.370683, "o", "\u001b[?2004h> "]
[527.370858, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[527.370914, "o", "\u001b[?2004h> "]
[527.370995, "o", "            }\r\n\u001b[?2004l\r"]
[527.37105, "o", "\u001b[?2004h> "]
[527.371111, "o", "        }\r\n\u001b[?2004l\r"]
[527.371168, "o", "\u001b[?2004h> "]
[527.371266, "o", "    case Int32:\r\n\u001b[?2004l\r"]
[527.371329, "o", "\u001b[?2004h> "]
[527.37151, "o", "        for _, v := range vals {\r\n\u001b[?2004l\r"]
[527.371565, "o", "\u001b[?2004h> "]
[527.372105, "o", "            if err := binary.Write(&buf, binary.LittleEndian, int32(math.Round(v))); err != nil {\r\n\u001b[?2004l\r"]
[527.372171, "o", "\u001b[?2004h> "]
[527.372357, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[527.372413, "o", "\u001b[?2004h> "]
[527.372494, "o", "            }\r\n\u001b[?2004l\r"]
[527.37255, "o", "\u001b[?2004h> "]
[527.372609, "o", "        }\r\n\u001b[?2004l\r"]
[527.372664, "o", "\u001b[?2004h> "]
[527.372756, "o", "    case Int64:\r\n\u001b[?2004l\r"]
[527.372812, "o", "\u001b[?2004h> "]
[527.372995, "o", "        for _, v := range vals {\r\n\u001b[?2004l\r"]
[527.373049, "o", "\u001b[?2004h> "]
[527.373604, "o", "            if err := binary.Write(&buf, binary.LittleEndian, int64(math.Round(v))); err != nil {\r\n\u001b[?2004l\r"]
[527.37366, "o", "\u001b[?2004h> "]
[527.37384, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[527.373896, "o", "\u001b[?2004h> "]
[527.373976, "o", "            }\r\n\u001b[?2004l\r"]
[527.374031, "o", "\u001b[?2004h> "]
[527.374091, "o", "        }\r\n\u001b[?2004l\r"]
[527.374147, "o", "\u001b[?2004h> "]
[527.374222, "o", "    default:\r\n\u001b[?2004l\r"]
[527.374301, "o", "\u001b[?2004h> "]
[527.374609, "o", "        return nil, fmt.Errorf(\"invalid dtype %d\", dtype)\r\n\u001b[?2004l\r"]
[527.374664, "o", "\u001b[?2004h> "]
[527.37472, "o", "    }\r\n\u001b[?2004l\r"]
[527.374774, "o", "\u001b[?2004h> "]
[527.374914, "o", "    return buf.Bytes(), nil\r\n\u001b[?2004l\r"]
[527.37497, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[527.375026, "o", "\u001b[?2004h> \r\n"]
[527.375081, "o", "\u001b[?2004l\r\u001b[?2004h"]
[527.375134, "o", "> "]
[527.375377, "o", "func PromoteDtype(a, b uint8) (uint8, error) {\r\n\u001b[?2004l\r"]
[527.375433, "o", "\u001b[?2004h> "]
[527.375529, "o", "    if a == b {\r\n\u001b[?2004l\r"]
[527.375593, "o", "\u001b[?2004h> "]
[527.375723, "o", "        return a, nil\r\n\u001b[?2004l\r"]
[527.375778, "o", "\u001b[?2004h> "]
[527.375836, "o", "    }\r\n\u001b[?2004l\r"]
[527.375892, "o", "\u001b[?2004h> "]
[527.376059, "o", "    rank := func(d uint8) int {\r\n\u001b[?2004l\r"]
[527.376113, "o", "\u001b[?2004h> "]
[527.376272, "o", "        switch Dtype(d) {\r\n\u001b[?2004l\r"]
[527.376329, "o", "\u001b[?2004h> "]
[527.376442, "o", "        case Int32:\r\n\u001b[?2004l\r"]
[527.376505, "o", "\u001b[?2004h> "]
[527.376624, "o", "            return 0\r\n\u001b[?2004l\r"]
[527.37668, "o", "\u001b[?2004h> "]
[527.376792, "o", "        case Int64:\r\n\u001b[?2004l\r"]
[527.376848, "o", "\u001b[?2004h> "]
[527.376968, "o", "            return 1\r\n\u001b[?2004l\r"]
[527.377025, "o", "\u001b[?2004h> "]
[527.377149, "o", "        case Float32:\r\n\u001b[?2004l\r"]
[527.377218, "o", "\u001b[?2004h> "]
[527.377333, "o", "            return 2\r\n\u001b[?2004l\r"]
[527.37739, "o", "\u001b[?2004h> "]
[527.377514, "o", "        case Float64:\r\n\u001b[?2004l\r"]
[527.377571, "o", "\u001b[?2004h> "]
[527.377687, "o", "            return 3\r\n\u001b[?2004l\r"]
[527.377743, "o", "\u001b[?2004h> "]
[527.377841, "o", "        default:\r\n\u001b[?2004l\r"]
[527.377896, "o", "\u001b[?2004h> "]
[527.378021, "o", "            return -1\r\n\u001b[?2004l\r"]
[527.378076, "o", "\u001b[?2004h> "]
[527.378136, "o", "        }\r\n\u001b[?2004l\r"]
[527.37819, "o", "\u001b[?2004h> "]
[527.378253, "o", "    }\r\n\u001b[?2004l\r"]
[527.378308, "o", "\u001b[?2004h> "]
[527.378395, "o", "    ra := rank(a)\r\n\u001b[?2004l\r"]
[527.378449, "o", "\u001b[?2004h> "]
[527.378553, "o", "    rb := rank(b)\r\n\u001b[?2004l\r"]
[527.378608, "o", "\u001b[?2004h> "]
[527.378757, "o", "    if ra < 0 || rb < 0 {\r\n\u001b[?2004l\r"]
[527.378812, "o", "\u001b[?2004h> "]
[527.379221, "o", "        return 0, fmt.Errorf(\"invalid dtype promotion %d and %d\", a, b)\r\n\u001b[?2004l\r"]
