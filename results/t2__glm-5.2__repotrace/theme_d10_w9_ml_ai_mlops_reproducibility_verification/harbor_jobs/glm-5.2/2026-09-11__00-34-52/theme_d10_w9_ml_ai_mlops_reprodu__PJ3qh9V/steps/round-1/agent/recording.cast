[2670.451759, "o", "\"repro-verify/internal/report\"\r\n    17\t)\r\n    18\t\r\n    19\tfunc Run() int {\r\n    20\t\tif len(os.Args) < 2 {\r\n    21\t\t\toutputJSON(map[string]interface{}{\"error\": \"no subcommand provided\"})\r\n    22\t\t\treturn 1\r\n    23\t\t}\r\n    24\t\r\n    25\t\tswitch os.Args[1] {\r\n    26\t\tcase \"verify-checkpoint\":\r\n"]
[2670.451821, "o", "    27\t\t\treturn runVerifyCheckpoint(os.Args[2:])\r\n    28\t\tcase \"compare-outputs\":\r\n    29\t\t\treturn runCompareOutputs(os.Args[2:])\r\n    30\t\tcase \"validate-manifest\":\r\n    31\t\t\treturn runValidateManifest(os.Args[2:])\r\n    32\t\tcase \"audit-lineage\":\r\n    33\t\t\treturn runAuditLineage(os.Args[2:])\r\n    34\t\tcase \"generate-report\":\r\n"]
[2670.451881, "o", "    35\t\t\treturn runGenerateReport(os.Args[2:])\r\n    36\t\tcase \"merge-checkpoints\":\r\n    37\t\t\treturn runMergeCheckpoints(os.Args[2:])\r\n    38\t\tcase \"drift-analysis\":\r\n    39\t\t\treturn runDriftAnalysis(os.Args[2:])\r\n    40\t\tdefault:\r\n    41\t\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"unknown subcommand: %s\", os.Args[1])})\r\n    42\t\t\treturn 1\r\n    43\t\t}\r\n    44\t}\r\n    45\t\r\n"]
[2670.451948, "o", "    46\tfunc runVerifyCheckpoint(args []string) int {\r\n    47\t\tif len(args) != 1 {\r\n    48\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify verify-checkpoint <file>\"})\r\n    49\t\t\treturn 1\r\n    50\t\t}\r\n    51\t\r\n    52\t\tcp, err := mlck.ParseFile(args[0])\r\n    53\t\tif err != nil {\r\n    54\t\t\toutputJSON(map[string]interface{}{\r\n    55\t\t\t\t\"valid\": false,"]
[2670.452008, "o", "\r\n    56\t\t\t\t\"error\": err.Error(),\r\n    57\t\t\t})\r\n    58\t\t\treturn 1\r\n    59\t\t}\r\n    60\t\r\n    61\t\tmetadata := cp.Metadata\r\n"]
[2670.452067, "o", "    62\t\tif metadata == nil {\r\n    63\t\t\tmetadata = map[string]interface{}{}\r\n    64\t\t}\r\n    65\t\ttensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))\r\n    66\t\tfor _, t := range cp.Tensors {\r\n    67\t\t\ttensors = append(tensors, t.Info())\r\n    68\t\t}\r\n    69\t\r\n    70\t\toutputJSON(map[string]interface{}{\r\n    71\t"]
[2670.452131, "o", "\t\t\"valid\":          true,\r\n    72\t\t\t\"format_version\": int(cp.Version),\r\n    73\t\t\t\"num_tensors\":    len(cp.Tensors),\r\n    74\t\t\t\"metadata\":       metadata,\r\n    75\t\t\t\"tensors\":        tensors,\r\n    76\t\t\t\"file_checksum\":  cp.FileChecksum,\r\n    77\t\t})\r\n    78\t\treturn 0\r\n    79\t}\r\n    80\t\r\n    81\tfunc runCompareOutputs(args []string) int {\r\n"]
[2670.452189, "o", "    82\t\tfs := flag.NewFlagSet(\"compare-outputs\", flag.ContinueOnError)\r\n    83\t\tfs.SetOutput(os.Stderr)\r\n    84\t\tatol := fs.Float64(\"atol\", 1e-7, \"absolute tolerance\")\r\n    85\t\trtol := fs.Float64(\"rtol\", 1e-5, \"relative tolerance\")\r\n    86\t\tmode := fs.String(\"mode\", \"strict\", \"comparison mode\")\r\n    87\t\r\n    88\t\tpos, err := parseMixedArgs(fs, args)\r\n    89\t\tif err != nil {\r\n"]
