[3062.164783, "o", "sed -n '189,335p' internal/manifest/manifest.go\r\n\u001b[?2004l\r"]
[3062.167334, "o", "func parseTOML(data string) (map[string]interface{}, error) {\r\n\troot := map[string]interface{}{}\r\n\tvar current map[string]interface{} = root\r\n\tvar currentArray []map[string]interface{}\r\n\r\n\tlines := strings.Split(data, \"\\n\")\r\n"]
[3062.167445, "o", "\tfor lineNum, raw := range lines {\r\n\t\tline := strings.TrimSpace(stripInlineComment(raw))\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tif strings.HasPrefix(line, \"[[\") && strings.HasSuffix(line, \"]]\") {\r\n\t\t\tkey := strings.TrimSpace(line[2 : len(line)-2])\r\n\t\t\tparts := strings.Split(key, \".\")\r\n\t\t\tparent := root\r\n\t\t\tfor i := 0; i < len(parts)-1; i++ {\r\n\t\t\t\tp := strings.TrimSpace(parts[i])\r\n\t\t\t\tnext, ok := parent[p]\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\tnext = map[string]interface{}{}\r\n\t\t\t\t\tparent[p] = next\r\n\t\t\t\t}\r\n"]
[3062.16754, "o", "\t\t\t\tparent, ok = next.(map[string]interface{})\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid array table path\", lineNum+1)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tlast := strings.TrimSpace(parts[len(parts)-1])\r\n\t\t\tarr, ok := parent[last].([]map[string]interface{})\r\n\t\t\tif !ok {\r\n\t\t\t\tarr = []map[string]interface{}{}\r\n\t\t\t}\r\n\t\t\titem := map[string]interface{}{}\r\n\t\t\tarr = append(arr, item)\r\n\t\t\tparent[last] = arr\r\n"]
[3062.167613, "o", "\t\t\tcurrent = item\r\n\t\t\tcurrentArray = arr\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\r\n\t\t\tkey := strings.TrimSpace(line[1 : len(line)-1])\r\n\t\t\tparts := strings.Split(key, \".\")\r\n\t\t\tparent := root\r\n\t\t\tfor i := 0; i < len(parts)-1; i++ {\r\n\t\t\t\tp := strings.TrimSpace(parts[i])\r\n"]
[3062.167681, "o", "\t\t\t\tnext, ok := parent[p]\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\tnext = map[string]interface{}{}\r\n\t\t\t\t\tparent[p] = next\r\n\t\t\t\t}\r\n\t\t\t\tparent, ok = next.(map[string]interface{})\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid table path\", lineNum+1)\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[3062.167751, "o", "\t\t\tlast := strings.TrimSpace(parts[len(parts)-1])\r\n\t\t\ttbl, ok := parent[last].(map[string]interface{})\r\n\t\t\tif !ok {\r\n\t\t\t\ttbl = map[string]interface{}{}\r\n\t\t\t\tparent[last] = tbl\r\n\t\t\t}\r\n\t\t\tcurrent = tbl\r\n\t\t\tcurrentArray = nil\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\teq := strings.Index(line, \"=\")\r\n\t\tif eq < 0 {\r\n\t"]
[3062.167821, "o", "\t\treturn nil, fmt.Errorf(\"line %d: expected key = value\", lineNum+1)\r\n\t\t}\r\n\t\tkeyPath := strings.Split(strings.TrimSpace(line[:eq]), \".\")\r\n\t\tvalueStr := strings.TrimSpace(line[eq+1:])\r\n\t\tvalue, err := parseTOMLValue(valueStr)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"line %d: %v\", lineNum+1, err)\r\n\t\t}\r\n\t\t_ = currentArray\r\n"]
[3062.167895, "o", "\r\n\t\tparent := current\r\n\t\tfor i := 0; i < len(keyPath)-1; i++ {\r\n\t\t\tpart := strings.TrimSpace(keyPath[i])\r\n\t\t\tif part == \"\" {\r\n\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid key\", lineNum+1)\r\n\t\t\t}\r\n\t\t\tnext, ok := parent[part]\r\n\t\t\tif !ok {\r\n\t\t\t\tnext = map[string]interface{}{}\r\n\t\t\t\tparent[part] = next\r\n"]
[3062.16797, "o", "\t\t\t\tparent = next.(map[string]interface{})\r\n\t\t\t} else {\r\n\t\t\t\tparent, ok = next.(map[string]interface{})\r\n\t\t\t\tif !ok {\r\n"]
[3062.168041, "o", "\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid key path\", lineNum+1)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tlastKey := strings.TrimSpace(keyPath[len(keyPath)-1])\r\n\t\tif lastKey == \"\" {\r\n\t\t\treturn nil, fmt.Errorf(\"line %d: invalid key\", lineNum+1)\r\n\t\t}\r\n\t\tparent[lastKey] = value\r\n\t}\r\n\r\n\treturn root, nil\r\n}\r\n\r\nfunc stripInlineComment(line string) string {\r\n\tvar quote byte\r\n\tdepth := 0\r\n\tfor i := 0; i < len(line); i++ {\r\n\t\tc := line[i]\r\n"]
[3062.168117, "o", "\t\tif quote != 0 {\r\n\t\t\tif c == quote {\r\n\t\t\t\tquote = 0\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tswitch c {\r\n\t\tcase 34, 39:\r\n\t\t\tquote = c\r\n\t\tcase '[', '{':\r\n\t\t\tdepth++\r\n\t\tcase ']', '}':\r\n"]
[3062.168191, "o", "\t\t\tif depth > 0 {\r\n\t\t\t\tdepth--\r\n\t\t\t}\r\n\t\tcase '#':\r\n"]
[3062.168297, "o", "\t\t\tif depth == 0 {\r\n\t\t\t\treturn line[:i]\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn line\r\n}\r\n\r\nfunc parseTOMLValue(s string) (interface{}, error) {\r\n\tif s == \"true\" {\r\n\t\treturn true, nil\r\n\t}\r\n\tif s == \"false\" {\r\n\t\treturn false, nil\r\n\t}\r\n\tif len(s) >= 2 && (s[0] == '\"' && s[len(s)-1] == '\"' || s[0] == '\\'' && s[len(s)-1] == '\\'') {\r\n\t\treturn s[1 : len(s)-1], nil\r\n\t}\r\n"]
