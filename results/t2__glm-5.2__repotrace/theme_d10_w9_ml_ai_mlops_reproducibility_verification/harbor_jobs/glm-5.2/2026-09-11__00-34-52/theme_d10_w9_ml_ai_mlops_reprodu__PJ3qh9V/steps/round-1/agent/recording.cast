[1227.980923, "o", "\u001b[?2004h> "]
[1227.981262, "o", "                arr = []map[string]interface{}{}\r\n\u001b[?2004l\r"]
[1227.981318, "o", "\u001b[?2004h> "]
[1227.981421, "o", "            }\r\n\u001b[?2004l\r"]
[1227.981485, "o", "\u001b[?2004h> "]
