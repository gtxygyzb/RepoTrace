[4014.206727, "o", "    58\t\tcp, err := mlck.ParseFile(args[0])\r\n    59\t\tif err != nil {\r\n    60\t\t\toutputJSON(map[string]interface{}{\r\n    61\t\t\t\t\"valid\": false,\r\n    62\t\t\t\t\"error\": err.Error(),\r\n    63\t\t\t})\r\n    64\t\t\treturn 1\r\n    65\t\t}\r\n    66\t\r\n    67\t"]
[4014.206791, "o", "\tmetadata := cp.Metadata\r\n    68\t\tif metadata == nil {\r\n    69\t\t\tmetadata = map[string]interface{}{}\r\n    70\t\t}\r\n    71\t\ttensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))\r\n    72\t\tfor _, t := range cp.Tensors {\r\n    73\t\t\ttensors = append(tensors, t.Info())\r\n    74\t\t}\r\n    75\t\r\n    76\t\toutputJSON(map[string]interface{}{\r\n"]
[4014.206852, "o", "    77\t\t\t\"valid\":          true,\r\n    78\t\t\t\"format_version\": int(cp.Version),\r\n    79\t\t\t\"num_tensors\":    len(cp.Tensors),\r\n    80\t\t\t\"metadata\":       metadata,\r\n    81\t\t\t\"tensors\":        tensors,\r\n    82\t\t\t\"file_checksum\":  cp.FileChecksum,\r\n    83\t\t})\r\n"]
[4014.206917, "o", "    84\t\treturn 0\r\n    85\t}\r\n    86\t\r\n    87\tfunc runCompareOutputs(args []string) int {\r\n    88\t\tfs := flag.NewFlagSet(\"compare-outputs\", flag.ContinueOnError)\r\n    89\t\tfs.SetOutput(io.Discard)\r\n    90\t\tatol := fs.Float64(\"atol\", 1e-7, \"absolute tolerance\")\r\n    91\t\trtol := fs.Float64(\"rtol\", 1e-5, \"relative tolerance\")\r\n    92\t\tmode := fs.String(\"mode\", \"strict\", \"comparison mode\")\r\n    93\t\r\n    94"]
[4014.206981, "o", "\t\tpos, err := parseMixedArgs(fs, args)\r\n    95\t\tif err != nil {\r\n    96\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n    97\t\t\treturn 1\r\n    98\t\t}\r\n    99\t\tif len(pos) != 2 {\r\n"]
