[1227.987194, "o", "\u001b[?2004h> "]
[1227.98733, "o", "                parent[last] = tbl\r\n\u001b[?2004l\r"]
[1227.987388, "o", "\u001b[?2004h> "]
[1227.987435, "o", "            }\r\n\u001b[?2004l\r"]
[1227.987487, "o", "\u001b[?2004h> "]
[1227.98758, "o", "            current = tbl\r\n\u001b[?2004l\r"]
[1227.987635, "o", "\u001b[?2004h> "]
[1227.987748, "o", "            currentArray = nil\r\n\u001b[?2004l\r"]
[1227.987804, "o", "\u001b[?2004h> "]
[1227.987877, "o", "            continue\r\n\u001b[?2004l\r"]
[1227.987932, "o", "\u001b[?2004h> "]
[1227.987987, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1227.988042, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1227.988204, "o", "        eq := strings.Index(line, \"=\")\r\n\u001b[?2004l\r"]
[1227.988267, "o", "\u001b[?2004h> "]
[1227.988335, "o", "        if eq < 0 {\r\n\u001b[?2004l\r"]
[1227.988394, "o", "\u001b[?2004h> "]
[1227.988696, "o", "            return nil, fmt.Errorf(\"line %d: expected key = value\", lineNum+1)\r\n\u001b[?2004l\r"]
[1227.988752, "o", "\u001b[?2004h> "]
[1227.98881, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.989002, "o", "        key := strings.TrimSpace(line[:eq])\r\n\u001b[?2004l\r"]
[1227.989058, "o", "\u001b[?2004h> "]
[1227.989258, "o", "        valueStr := strings.TrimSpace(line[eq+1:])\r\n\u001b[?2004l\r"]
[1227.989324, "o", "\u001b[?2004h> "]
[1227.989492, "o", "        value, err := parseTOMLValue(valueStr)\r\n\u001b[?2004l\r"]
[1227.989549, "o", "\u001b[?2004h> "]
[1227.989635, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[1227.989691, "o", "\u001b[?2004h> "]
