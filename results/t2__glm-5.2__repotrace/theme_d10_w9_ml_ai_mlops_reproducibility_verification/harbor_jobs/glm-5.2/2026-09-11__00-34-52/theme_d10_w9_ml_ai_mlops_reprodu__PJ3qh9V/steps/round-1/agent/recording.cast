[3703.698514, "o", "     1\tpackage report\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"strings\"\r\n"]
[3703.698616, "o", "     6\t\t\"time\"\r\n     7\t\r\n     8\t\t\"repro-verify/internal/compare\"\r\n     9\t\t\"repro-verify/internal/lineage\"\r\n    10\t\t\"repro-verify/internal/manifest\"\r\n    11\t\t\"repro-verify/internal/mlck\"\r\n    12\t)\r\n    13\t\r\n    14\ttype ManifestPart struct {\r\n    15\t\tValid    bool     `json:\"valid\"`\r\n    16\t\tWarnings []string `json:\"warnings,omitempty\"`\r\n    17\t\tErrors   []string `json:\"errors,omitempty\"`\r\n    18\t}\r\n    19\t\r\n"]
[3703.698694, "o", "    20\ttype CheckpointPart struct {\r\n    21\t\tValid        bool   `json:\"valid\"`\r\n    22\t\tNumTensors   int    `json:\"num_tensors\"`\r\n    23\t\tFileChecksum string `json:\"file_checksum\"`\r\n    24\t\tError        string `json:\"error,omitempty\"`\r\n    25\t}\r\n    26\t\r\n    27\ttype ComparisonPart struct {\r\n    28\t\tMatch   bool   `json:\"match\"`\r\n    29\t"]
[3703.698755, "o", "\tSummary string `json:\"summary,omitempty\"`\r\n    30\t\tError   string `json:\"error,omitempty\"`\r\n    31\t}\r\n    32\t\r\n    33\ttype LineagePart struct {\r\n    34\t\tValid bool   `json:\"valid\"`\r\n    35\t\tDepth int    `json:\"depth\"`\r\n    36\t\tError string `json:\"error,omitempty\"`\r\n    37\t}\r\n    38\t\r\n    39\ttype Report struct {\r\n"]
[3703.698822, "o", "    40\t\tReportVersion       string          `json:\"report_version\"`\r\n    41\t\tTimestamp           string          `json:\"timestamp\"`\r\n    42\t\tManifest            ManifestPart    `json:\"manifest\"`\r\n    43\t\tCheckpoint          *CheckpointPart `json:\"checkpoint,omitempty\"`\r\n    44\t\tComparison          *ComparisonPart `json:\"comparison,omitempty\"`\r\n    45\t\tLineage             *LineagePart    `json:\"lineage,omitempty\"`\r\n    46\t\tOverallReproducible bool            `json:\"overall_reproducible\"`\r\n    47\t\tIssues              []string        `json:\"issues\"`\r\n    48\t}\r\n    49\t\r\n"]
[3703.698881, "o", "    50\tfunc Generate(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {\r\n    51\t\tissues := []string{}\r\n    52\t\trep := &Report{\r\n    53\t\t\tReportVersion: \"1.0\",\r\n    54\t\t\tTimestamp:     time.Now().Format(time.RFC3339),\r\n    55\t\t\tIssues:        issues,\r\n    56\t\t}\r\n    57\t"]
[3703.698939, "o", "\r\n    58\t\tman := manifest.Validate(manifestPath)\r\n    59\t\trep.Manifest = ManifestPart{\r\n    60\t\t\tValid:    man.Valid,\r\n    61\t\t\tWarnings: man.Warnings,\r\n    62\t\t\tErrors:   man.Errors,\r\n    63\t\t}\r\n    64\t\tif !man.Valid {\r\n"]
[3703.698996, "o", "    65\t\t\tissues = append(issues, fmt.Sprintf(\"Manifest validation failed: %s\", strings.Join(man.Errors, \"; \")))\r\n    66\t\t}\r\n    67\t\r\n    68\t\tcheckpointValid := true\r\n    69\t\tif checkpointPath != \"\" {\r\n    70\t\t\tcp, err := mlck.ParseFile(checkpointPath)\r\n    71\t\t\tif err != nil {\r\n    72\t\t\t\tcheckpointValid = false\r\n    73\t\t\t\trep.Checkpoint = &CheckpointPart{"]
[3703.699058, "o", "\r\n    74\t\t\t\t\tValid: false,\r\n    75\t\t\t\t\tError: err.Error(),\r\n    76\t\t\t\t}\r\n    77\t\t\t\tissues = append(issues, fmt.Sprintf(\"Checkpoint verification failed: %v\", err))\r\n    78\t\t\t} else {\r\n    79\t\t\t\trep.Checkpoint = &CheckpointPart{\r\n"]
[3703.699119, "o", "    80\t\t\t\t\tValid:        true,\r\n    81\t\t\t\t\tNumTensors:   len(cp.Tensors),\r\n    82\t\t\t\t\tFileChecksum: cp.FileChecksum,\r\n    83\t\t\t\t}\r\n    84\t\t\t}\r\n    85\t\t}\r\n    86\t\r\n    87\t\tcomparisonMatch := true\r\n"]
[3703.699182, "o", "    88\t\tif checkpointPath != \"\" && comparePath != \"\" {\r\n    89\t\t\tc1, err := mlck.ParseFile(checkpointPath)\r\n    90\t\t\tif err != nil {\r\n    91\t\t\t\tcomparisonMatch = false\r\n    92\t\t\t\trep.Comparison = &ComparisonPart{\r\n    93\t\t\t\t\tMatch: false,\r\n    94\t\t\t\t\tError: fmt.Sprintf(\"checkpoint parse failed: %v\", err),\r\n    95\t\t\t\t}\r\n"]
[3703.699301, "o", "    96\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n    97\t\t\t} else {\r\n    98\t\t\t\tc2, err := mlck.ParseFile(comparePath)\r\n    99\t\t\t\tif err != nil {\r\n   100\t\t\t\t\tcomparisonMatch = false\r\n   101\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n   102\t\t\t\t\t\tMatch: false,\r\n   103\t\t\t\t\t\tError: fmt.Sprintf(\"compare checkpoint parse failed: %v\", err),\r\n"]
[3703.699382, "o", "   104\t\t\t\t\t}\r\n   105\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n   106\t\t\t\t} else {\r\n   107\t\t\t\t\tres, err := compare.Compare(c1, c2, \"strict\", 1e-7, 1e-5)\r\n   108\t\t\t\t\tif err != nil {\r\n   109\t\t\t\t\t\tcomparisonMatch = false\r\n   110\t\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n   111\t\t\t\t\t\t\tMatch: false,\r\n   112\t\t\t\t\t\t\tError: err.Error(),\r\n   113\t\t\t\t\t\t}\r\n   114\t\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n   115\t\t\t\t\t} else {\r\n   116\t\t\t\t\t\tdiffer := 0\r\n"]
[3703.699452, "o", "   117\t\t\t\t\t\ttotal := len(res.TensorResults)\r\n   118\t\t\t\t\t\tfor _, tr := range res.TensorResults {\r\n   119\t\t\t\t\t\t\tif !tr.Match {\r\n   120\t\t\t\t\t\t\t\tdiffer++\r\n   121\t\t\t\t"]
[3703.699515, "o", "\t\t\t}\r\n   122\t\t\t\t\t\t}\r\n   123\t\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n   124\t\t\t\t\t\t\tMatch:   res.Match,\r\n   125\t\t\t\t\t\t\tSummary: fmt.Sprintf(\"%d/%d tensors differ\", differ, total),\r\n   126\t\t\t\t\t\t}\r\n   127\t\t\t\t\t\tif !res.Match {\r\n   128\t\t\t\t\t\t\tcomparisonMatch = false\r\n   129\t\t\t\t\t\t\tif differ > 0 {\r\n"]
[3703.699573, "o", "   130\t\t\t\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Tensor comparison failed: %d tensors differ beyond tolerance\", differ))\r\n   131\t\t\t\t\t\t\t} else {\r\n   132\t\t\t\t\t\t\t\tissues = append(issues, \"Tensor comparison failed: missing tensors or shape mismatch\")\r\n   133\t\t\t\t\t\t\t}\r\n   134"]
[3703.699634, "o", "\t\t\t\t\t\t}\r\n   135\t\t\t\t\t}\r\n   136\t\t\t\t}\r\n   137\t\t\t}\r\n   138\t\t}\r\n   139\t\r\n   140\t\tlineageValid := true\r\n   141\t\tif lineagePath != \"\" {\r\n   142\t\t\tlin := lineage.Audit(lineagePath)\r\n   143\t"]
[3703.699693, "o", "\t\tif lin.Valid {\r\n   144\t\t\t\trep.Lineage = &LineagePart{\r\n   145\t\t\t\t\tValid: true,\r\n   146\t\t\t\t\tDepth: lin.MaxDepth,\r\n   147\t\t\t\t}\r\n   148\t\t\t} else {\r\n   149\t\t\t\tlineageValid = false\r\n   150\t\t\t\trep.Lineage = &LineagePart{\r\n   151\t\t\t\t\tValid: false,\r\n   152"]
[3703.699753, "o", "\t\t\t\t\tError: strings.Join(lin.Errors, \"; \"),\r\n   153\t\t\t\t}\r\n   154\t\t\t\tissues = append(issues, fmt.Sprintf(\"Lineage audit failed: %s\", strings.Join(lin.Errors, \"; \")))\r\n   155\t\t\t}\r\n   156\t\t}\r\n   157\t\r\n   158\t\toverall := man.Valid && checkpointValid && comparisonMatch && lineageValid\r\n   159\t\trep.OverallReproducible = overall\r\n"]
[3703.699811, "o", "   160\t\trep.Issues = issues\r\n   161\t\r\n   162\t\tif overall {\r\n   163\t\t\treturn rep, 0\r\n   164\t\t}\r\n   165\t\treturn rep, 1\r\n   166\t}\r\n"]
