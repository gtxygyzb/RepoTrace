[3728.911515, "o", "     1\tpackage drift\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"math\"\r\n     6\t\r\n     7"]
[3728.911545, "o", "\t\t\"repro-verify/internal/mlck\"\r\n     8\t)\r\n     9\t\r\n    10\ttype TensorResult struct {\r\n    11\t\tName           string    `json:\"name\"`\r\n"]
[3728.911708, "o", "    12\t\tStepChanges    []float64 `json:\"step_changes\"`\r\n    13\t\tMeanChange     float64   `json:\"mean_change\"`\r\n    14\t\tMaxChange      float64   `json:\"max_change\"`\r\n    15\t\tConvergence    string    `json:\"convergence\"`\r\n    16\t\tStabilityScore float64   `json:\"stability_score\"`\r\n    17\t}\r\n    18\t\r\n    19\ttype Result struct {\r\n    20\t\tNumSnapshots       int            `json:\"num_snapshots\"`\r\n    21\t\tNumAnalyzedTensors int            `json:\"num_analyzed_tensors\"`\r\n    22\t\tSkippedTensors     []string       `json:\"skipped_tensors\"`\r\n    23\t\tTensors            []TensorResult `json:\"tensors\"`\r\n    24\t\tOverallConvergence string         `json:\"overall_convergence\"`\r\n    25\t}\r\n    26\t\r\n    27\tfunc Analyze(files []string) (*Result, error) {\r\n    28\t\tif len(files) < 2 {\r\n    29\t\t\treturn nil, fmt.Errorf(\"at least 2 input files required\")\r\n    30\t\t}\r\n    31\t\r\n    32\t\tcps := make([]*mlck.Checkpoint, len(files))\r\n"]
[3728.911796, "o", "    33\t\tfor i, f := range files {\r\n    34\t\t\tcp, err := mlck.ParseFile(f)\r\n    35\t\t\tif err != nil {\r\n    36\t\t\t\treturn nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n    37\t\t\t}\r\n"]
[3728.911863, "o", "    38\t\t\tcps[i] = cp\r\n    39\t\t}\r\n    40\t\r\n    41\t\tvar allNames []string\r\n    42\t\tseen := map[string]bool{}\r\n    43\t\tfor _, cp := range cps {\r\n    44\t\t\tfor _, t := range cp.Tensors {\r\n    45\t\t\t\tif !seen[t.Name] {\r\n    46\t\t\t\t\tseen[t.Name] = true\r\n    47\t\t\t\t\tallNames = append(allNames, t.Name)\r\n    48\t\t\t\t}\r\n    49\t\t\t}\r\n    50\t\t}\r\n    51\t\r\n    52\t\tskipped := []string{}\r\n    53\t\ttensors := []TensorResult{}\r\n    54\t\tconverging := 0\r\n    55\t\tdiverging := 0\r\n    56\t\r\n"]
[3728.911923, "o", "    57\t\tfor _, name := range allNames {\r\n    58\t\t\tok := true\r\n    59\t\t\tvar shape []uint32\r\n    60\t\t\tfor _, cp := range cps {\r\n    61\t\t\t\tt, exists := tensorByName(cp, name)\r\n    62\t\t\t\tif !exists {\r\n    63\t\t\t\t\tok = false\r\n    64\t\t\t\t\tbreak\r\n    65\t\t\t\t}\r\n"]
[3728.911991, "o", "    66\t\t\t\tif shape == nil {\r\n    67\t\t\t\t\tshape = t.Shape\r\n    68\t\t\t\t} else if !shapesEqual(shape, t.Shape) {\r\n    69\t\t\t\t\tok = false\r\n    70\t\t\t\t\tbreak\r\n"]
[3728.91205, "o", "    71\t\t\t\t}\r\n    72\t\t\t}\r\n    73\t\t\tif !ok {\r\n    74\t\t\t\tskipped = append(skipped, name)\r\n    75\t\t\t\tcontinue\r\n    76\t\t\t}\r\n    77\t\r\n    78\t\t\tsteps := make([]float64, len(cps)-1)\r\n    79\t\t\tfor i := 0; i < len(cps)-1; i++ {\r\n    80\t\t\t\tt1, _ := tensorByName(cps[i], name)\r\n    81\t\t\t\tt2, _ := tensorByName(cps[i+1], name)\r\n    82\t\t\t\tv1, err := t1.Float64Values()\r\n"]
[3728.912109, "o", "    83\t\t\t\tif err != nil {\r\n    84\t\t\t\t\treturn nil, err\r\n    85\t\t\t\t}\r\n    86\t\t\t\tv2, err := t2.Float64Values()\r\n    87\t\t\t\tif err != nil {\r\n    88\t\t\t\t\treturn nil, err\r\n    89\t\t\t\t}\r\n"]
[3728.91217, "o", "    90\t\t\t\tn := len(v1)\r\n    91\t\t\t\tif n == 0 {\r\n    92\t\t\t\t\tsteps[i] = 0\r\n    93\t\t\t\t\tcontinue\r\n    94\t\t\t\t}\r\n    95\t\t\t\tvar sum float64\r\n"]
[3728.912255, "o", "    96\t\t\t\tfor j := 0; j < n; j++ {\r\n    97\t\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n    98\t\t\t\t}\r\n    99\t\t\t\tsteps[i] = sum / float64(n)\r\n   100\t\t\t}\r\n   101\t\r\n   102\t\t\tmean := meanFloat64(steps)\r\n   103\t\t\tmax := maxFloat64(steps)\r\n"]
[3728.912313, "o", "   104\t\t\tconvergence := classifyConvergence(steps)\r\n   105\t\t\tstability := 1.0\r\n   106\t\t\tif steps[0] != 0 {\r\n   107\t\t\t\tstability = 1.0 - steps[len(steps)-1]/steps[0]\r\n   108\t\t\t\tif stability < 0 {\r\n   109\t\t\t\t\tstability = 0\r\n   110\t\t\t\t} else if stability > 1 {\r\n"]
[3728.912374, "o", "   111\t\t\t\t\tstability = 1\r\n   112\t\t\t\t}\r\n   113\t\t\t}\r\n   114\t\r\n   115\t\t\ttensors = append(tensors, TensorResult{\r\n   116\t\t\t\tName:           name,\r\n   117\t\t\t\tStepChanges:    steps,\r\n   118\t\t\t\tMeanChange:     mean,\r\n   119"]
[3728.912431, "o", "\t\t\t\tMaxChange:      max,\r\n   120\t\t\t\tConvergence:    convergence,\r\n   121\t\t\t\tStabilityScore: stability,\r\n   122\t\t\t})\r\n   123\t\r\n   124\t\t\tif convergence == \"converging\" {\r\n   125\t\t\t\tconverging++\r\n   126\t\t\t} else if convergence == \"diverging\" {\r\n"]
[3728.912486, "o", "   127\t\t\t\tdiverging++\r\n   128\t\t\t}\r\n   129\t\t}\r\n   130\t\r\n   131\t\toverall := \"mixed\"\r\n   132\t\tif converging > len(tensors)/2 {\r\n   133\t\t\toverall = \"converging\"\r\n   134\t\t} else if diverging > len(tensors)/2 {\r\n"]
[3728.912561, "o", "   135\t\t\toverall = \"diverging\"\r\n   136\t\t}\r\n   137\t\r\n   138\t\treturn &Result{\r\n   139\t\t\tNumSnapshots:       len(files),\r\n   140\t\t\tNumAnalyzedTensors: len(tensors),\r\n   141\t\t\tSkippedTensors:     skipped,\r\n   142\t\t\tTensors:            tensors,\r\n   143\t\t\tOverallConvergence: overall,\r\n   144\t\t}, nil\r\n   145\t}\r\n"]
[3728.912623, "o", "   146\t\r\n   147\tfunc tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {\r\n   148\t\tfor _, t := range cp.Tensors {\r\n   149\t\t\tif t.Name == name {\r\n   150\t\t\t\treturn t, true\r\n   151\t\t\t}\r\n   152\t\t}\r\n   153\t"]
[3728.912679, "o", "\treturn mlck.Tensor{}, false\r\n   154\t}\r\n   155\t\r\n   156\tfunc shapesEqual(a, b []uint32) bool {\r\n   157\t\tif len(a) != len(b) {\r\n   158\t\t\treturn false\r\n   159\t\t}\r\n   160\t\tfor i := range a {\r\n   161\t\t\tif a[i] != b[i] {\r\n"]
[3728.912737, "o", "   162\t\t\t\treturn false\r\n   163\t\t\t}\r\n   164\t\t}\r\n   165\t\treturn true\r\n   166\t}\r\n   167\t\r\n   168\tfunc meanFloat64(xs []float64) float64 {\r\n   169"]
[3728.912793, "o", "\t\tif len(xs) == 0 {\r\n   170\t\t\treturn 0\r\n   171\t\t}\r\n   172\t\tvar sum float64\r\n   173\t\tfor _, x := range xs {\r\n   174\t\t\tsum += x\r\n   175\t\t}\r\n   176\t\treturn sum / float64(len(xs))\r\n"]
[3728.912854, "o", "   177\t}\r\n   178\t\r\n   179\tfunc maxFloat64(xs []float64) float64 {\r\n   180\t\tif len(xs) == 0 {\r\n   181\t\t\treturn 0\r\n   182\t\t}\r\n   183\t\tm := xs[0]\r\n   184\t\tfor _, x := range xs[1:] {\r\n   185\t\t\tif x > m {\r\n   186\t\t\t\tm = x\r\n   187\t\t\t}\r\n"]
[3728.912917, "o", "   188\t\t}\r\n   189\t\treturn m\r\n   190\t}\r\n   191\t\r\n   192\tfunc classifyConvergence(steps []float64) string {\r\n   193\t\tif len(steps) <= 1 {\r\n   194\t\t\treturn \"converging\"\r\n   195\t\t}\r\n   196\t\tdecreasing := true\r\n"]
[3728.912984, "o", "   197\t\tincreasing := true\r\n   198\t\tfor i := 1; i < len(steps); i++ {\r\n   199\t\t\tif steps[i] >= steps[i-1] {\r\n   200\t\t\t\tdecreasing = false\r\n   201\t\t\t}\r\n"]
[3728.913048, "o", "   202\t\t\tif steps[i] <= steps[i-1] {\r\n   203\t\t\t\tincreasing = false\r\n   204\t\t\t}\r\n   205\t\t}\r\n   206\t\tif decreasing {\r\n   207\t\t\treturn \"converging\"\r\n   208\t\t}\r\n   209\t\tif increasing {\r\n"]
[3728.913113, "o", "   210\t\t\treturn \"diverging\"\r\n   211\t\t}\r\n   212\t\treturn \"oscillating\"\r\n   213\t}\r\n"]
