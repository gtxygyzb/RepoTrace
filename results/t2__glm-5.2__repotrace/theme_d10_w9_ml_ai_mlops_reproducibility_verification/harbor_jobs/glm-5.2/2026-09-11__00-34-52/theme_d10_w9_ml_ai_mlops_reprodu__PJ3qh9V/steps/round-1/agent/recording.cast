[4655.357683, "o", "\t}, nil\r\n}\r\n\r\nfunc tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {\r\n\tfor _, t := range cp.Tensors {\r\n\t\tif t.Name == name {\r\n\t\t\treturn t, true\r\n\t\t"]
[4655.357782, "o", "}\r\n\t}\r\n\treturn mlck.Tensor{}, false\r\n}\r\n\r\nfunc shapesEqual(a, b []uint32) bool {\r\n\tif len(a) != len(b) {\r\n\t\treturn false\r\n\t}\r\n\tfor i := range a {\r\n\t\tif a[i] != b[i] {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc meanFloat64(xs []float64) float64 {\r\n"]
[4655.357861, "o", "\tif len(xs) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tvar sum float64\r\n\tfor _, x := range xs {\r\n\t\tsum += x\r\n\t}\r\n\treturn sum / float64(len(xs))\r\n}\r\n\r\nfunc maxFloat64(xs []float64) float64 {\r\n\tif len(xs) == 0 {\r\n\t\treturn 0\r\n\t"]
[4655.357934, "o", "}\r\n\tm := xs[0]\r\n\tfor _, x := range xs[1:] {\r\n\t\tif x > m {\r\n\t\t\tm = x\r\n\t\t}\r\n\t}\r\n\treturn m\r\n}\r\n\r\nfunc classifyConvergence(steps []float64) string {\r\n\t"]
[4655.358005, "o", "if len(steps) <= 1 {\r\n\t\treturn \"converging\"\r\n\t}\r\n\tdecreasing := true\r\n\tincreasing := true\r\n\tfor i := 1; i < len(steps); i++ {\r\n\t\tif steps[i] >= steps[i-1] {\r\n\t\t\tdecreasing = false\r\n\t\t}\r\n\t\tif steps[i] <= steps[i-1] {\r\n\t\t\tincreasing = false\r\n\t"]
[4655.358072, "o", "\t}\r\n\t}\r\n\tif decreasing {\r\n\t\treturn \"converging\"\r\n\t}\r\n\tif increasing {\r\n\t\treturn \"diverging\"\r\n\t}\r\n\treturn \"oscillating\"\r\n}\r\n"]
