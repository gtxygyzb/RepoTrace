[4647.764656, "o", "    27\t\r\n    28\tfunc Analyze(files []string) (*Result, error) {\r\n    29\t\tif len(files) < 2 {\r\n    30\t\t\treturn nil, fmt.Errorf(\"at least 2 input files required\")\r\n    31\t\t}\r\n    32\t\r\n    33\t\tcps := make([]*mlck.Checkpoint, len(files))\r\n    34\t\tfor i, f := range files {\r\n    35\t\t\tcp, err := mlck.ParseFile(f)\r\n    36\t\t\tif err != nil {\r\n    37\t\t\t\treturn nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n    38\t\t\t}\r\n    39\t\t\tcps[i] = cp\r\n    40\t\t}\r\n    41\t\r\n    42\t\tvar allNames []string\r\n    43\t\tseen := map[string]bool{}\r\n    44\t\tfor _, cp := range cps {\r\n    45\t\t\tfor _, t := range cp.Tensors {\r\n    46\t\t\t\tif !seen[t.Name] {\r\n"]
[4647.764726, "o", "    47\t\t\t\t\tseen[t.Name] = true\r\n    48\t\t\t\t\tallNames = append(allNames, t.Name)\r\n    49\t\t\t\t}\r\n    50\t\t\t}\r\n    51\t\t}\r\n    52\t\tsort.Strings(allNames)\r\n    53\t\r\n    54\t\tskipped := []string{}\r\n    55\t\ttensors := []TensorResult{}\r\n    56\t\tconverging := 0\r\n    57\t\tdiverging := 0\r\n"]
[4647.764797, "o", "    58\t\r\n    59\t\tfor _, name := range allNames {\r\n    60\t\t\tok := true\r\n    61\t\t\tvar shape []uint32\r\n    62\t\t\tfor _, cp := range cps {\r\n    63\t\t\t\tt, exists := tensorByName(cp, name)\r\n    64\t\t\t\tif !exists {\r\n    65\t\t\t\t\tok = false\r\n    66\t\t\t\t\tbreak\r\n"]
[4647.764865, "o", "    67\t\t\t\t}\r\n    68\t\t\t\tif shape == nil {\r\n    69\t\t\t\t\tshape = t.Shape\r\n    70\t\t\t\t} else if !shapesEqual(shape, t.Shape) {\r\n    71\t\t\t\t\tok = false\r\n    72\t\t\t\t\tbreak\r\n    73\t\t\t\t}\r\n    74\t\t\t}\r\n    75\t\t\tif !ok {\r\n    76\t\t\t\tskipped = append(skipped, name)\r\n    77"]
[4647.764932, "o", "\t\t\t\tcontinue\r\n    78\t\t\t}\r\n    79\t\r\n    80\t\t\tsteps := make([]float64, len(cps)-1)\r\n    81\t\t\tfor i := 0; i < len(cps)-1; i++ {\r\n    82\t\t\t\tt1, _ := tensorByName(cps[i], name)\r\n    83\t\t\t\tt2, _ := tensorByName(cps[i+1], name)\r\n    84\t\t\t\tv1, err := t1.Float64Values()\r\n    85\t\t\t\tif err != nil {\r\n    86\t\t\t\t\treturn nil, err\r\n"]
[4647.765008, "o", "    87\t\t\t\t}\r\n    88\t\t\t\tv2, err := t2.Float64Values()\r\n    89\t\t\t\tif err != nil {\r\n    90\t\t\t\t\treturn nil, err\r\n    91\t\t\t\t}\r\n    92\t\t\t\tn := len(v1)\r\n    93\t\t\t\tif n == 0 {\r\n    94\t\t\t\t\tsteps[i] = 0\r\n    95\t\t\t\t\tcontinue\r\n    96\t\t\t\t}\r\n    97\t\t\t\tvar sum float64\r\n"]
[4647.765076, "o", "    98\t\t\t\tfor j := 0; j < n; j++ {\r\n    99\t\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n   100\t\t\t\t}\r\n   101\t\t\t\tsteps[i] = sum / float64(n)\r\n   102\t\t\t}\r\n   103\t\r\n   104\t\t\tmean := meanFloat64(steps)\r\n   105\t\t\tmax := maxFloat64(steps)\r\n   106\t\t\tconvergence := classifyConvergence(steps)\r\n   107\t\t\tstability := 1.0\r\n"]
[4647.765149, "o", "   108\t\t\tif steps[0] != 0 {\r\n   109\t\t\t\tstability = 1.0 - steps[len(steps)-1]/steps[0]\r\n   110\t\t\t\tif stability < 0 {\r\n   111\t\t\t\t\tstability = 0\r\n   112\t\t\t\t} else if stability > 1 {\r\n   113\t\t\t\t\tstability = 1\r\n   114\t\t\t\t}\r\n   115\t\t\t}\r\n   116\t\r\n   117\t\t"]
