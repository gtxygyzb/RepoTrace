[1652.430934, "o", "\u001b[?2004h> "]
[1652.431145, "o", "    Valid bool `json:\"valid\"`\r\n\u001b[?2004l\r"]
[1652.431205, "o", "\u001b[?2004h> "]
[1652.431553, "o", "    Warnings []string `json:\"warnings,omitempty\"`\r\n\u001b[?2004l\r"]
[1652.431618, "o", "\u001b[?2004h> "]
[1652.431924, "o", "    Errors []string `json:\"errors,omitempty\"`\r\n\u001b[?2004l\r"]
[1652.431988, "o", "\u001b[?2004h> }\r\n"]
[1652.432041, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1652.432095, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.432151, "o", "> "]
[1652.43233, "o", "type CheckpointPart struct {\r\n\u001b[?2004l\r"]
