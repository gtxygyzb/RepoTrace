[3686.12132, "o", "\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tNumAnalyzedTensors int            `json:\"num_analyzed_\u001b[01;31m\u001b[Ktensors\u001b[m\u001b[K\"`\r\n\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tSkippedTensors     []string       `json:\"\u001b[01;31m\u001b[Kskipped\u001b[m\u001b[K_\u001b[01;31m\u001b[Ktensors\u001b[m\u001b[K\"`\r\n\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tTensors            []TensorResult `json:\"\u001b[01;31m\u001b[Ktensors\u001b[m\u001b[K\"`\r\n"]
