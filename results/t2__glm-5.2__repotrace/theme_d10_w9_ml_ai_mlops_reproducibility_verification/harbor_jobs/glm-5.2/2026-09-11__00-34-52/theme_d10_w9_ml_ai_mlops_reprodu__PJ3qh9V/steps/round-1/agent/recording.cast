[4743.552087, "o", "    93\t\t\t\tif n == 0 {\r\n    94\t\t\t\t\tsteps[i] = 0\r\n    95\t\t\t\t\tcontinue\r\n    96\t\t\t\t}\r\n    97\t\t\t\tvar sum float64\r\n    98\t\t\t\tfor j := 0; j < n; j++ {\r\n    99\t\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n   100\t\t\t\t}\r\n   101\t\t\t\tsteps[i] = sum / float64(n)\r\n   102\t\t\t}\r\n   103\t\r\n"]
