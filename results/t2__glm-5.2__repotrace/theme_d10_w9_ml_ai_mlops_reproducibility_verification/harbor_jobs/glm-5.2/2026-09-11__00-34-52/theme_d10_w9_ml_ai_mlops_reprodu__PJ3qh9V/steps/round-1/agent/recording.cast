[1229.091828, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1229.091885, "o", "    for i := 0; i < len(args); i++ {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1229.09195, "o", "        arg := args[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
