[5381.440208, "o", "   130\t\t}\r\n   131\t\r\n   132\t\tnumTensors := binary.LittleEndian.Uint32(data[8:12])\r\n   133\t\tmetaLen := binary.LittleEndian.Uint32(data[12:16])\r\n   134\t\r\n"]
[5381.440381, "o", "   135\t\tif len(data) < HeaderSize+int(metaLen)+FooterSize {\r\n   136\t\t\treturn nil, fmt.Errorf(\"metadata length exceeds file size\")\r\n   137\t\t}\r\n   138\t\r\n   139\t\tpreceding := data[:len(data)-FooterSize]\r\n   140\t\tfooter := data[len(data)-FooterSize:]\r\n   141\t\tsum := sha256.Sum256(preceding)\r\n   142\t\tfileChecksum := hex.EncodeToString(sum[:])\r\n   143\t\tif hex.EncodeToString(footer) != fileChecksum {\r\n   144\t\t\treturn nil, fmt.Errorf(\"checksum mismatch\")\r\n   145\t\t}\r\n   146\t\r\n   147\t\tmetaRaw := data[HeaderSize : HeaderSize+int(metaLen)]\r\n   148\t\tvar metadata map[string]interface{}\r\n   149\t\tif metaLen > 0 {\r\n   150\t\t\tif err := json.Unmarshal(metaRaw, &metadata); err != nil {\r\n   151\t\t\t\treturn nil, fmt.Errorf(\"invalid metadata JSON: %v\", err)\r\n   152\t\t\t}\r\n   153\t\t} else {\r\n   154\t\t\tmetadata = map[string]interface{}{}\r\n   155\t\t}\r\n   156\t\r\n   157\t\toffset := HeaderSize + int(metaLen)\r\n   158\t\ttensors := make([]Tensor, 0, numTensors)\r\n   159"]
[5381.440469, "o", "\t\r\n   160\t\tfor i := uint32(0); i < numTensors; i++ {\r\n   161\t\t\tif offset+4 > len(preceding) {\r\n   162\t\t\t\treturn nil, fmt.Errorf(\"truncated tensor name length\")\r\n   163\t\t\t}\r\n   164\t\t\tnameLen := binary.LittleEndian.Uint32(data[offset : offset+4])\r\n   165\t\t\toffset += 4\r\n   166\t\r\n   167\t\t\tif offset+int(nameLen) > len(preceding) {\r\n   168\t\t\t\treturn nil, fmt.Errorf(\"truncated tensor name\")\r\n   169\t\t\t}\r\n"]
[5381.440545, "o", "   170\t\t\tname := string(data[offset : offset+int(nameLen)])\r\n   171\t\t\toffset += int(nameLen)\r\n   172\t\r\n   173\t\t\tif offset+1 > len(preceding) {\r\n   174\t\t\t\treturn nil, fmt.Errorf(\"truncated tensor dtype\")\r\n   175\t\t\t}\r\n   176\t\t\tdtype := data[offset]\r\n   177\t\t\toffset += 1\r\n   178\t\t\tif !Dtype(dtype).Valid() {\r\n   179\t\t\t\treturn nil, fmt.Errorf(\"invalid dtype %d\", dtype)\r\n"]
[5381.440626, "o", "   180\t\t\t}\r\n   181\t\r\n   182\t\t\tif offset+4 > len(preceding) {\r\n   183\t\t\t\treturn nil, fmt.Errorf(\"truncated tensor ndim\")\r\n   184\t\t\t}\r\n   185\t\t\tndim := binary.LittleEndian.Uint32(data[offset : offset+4])\r\n   186\t\t\toffset += 4\r\n   187\t\r\n   188\t\t\tshape := make([]uint32, ndim)\r\n   189\t\t\tif offset+4*int(ndim) > len(preceding) {\r\n"]
[5381.440704, "o", "   190\t\t\t\treturn nil, fmt.Errorf(\"truncated tensor shape\")\r\n   191\t\t\t}\r\n   192\t\t\tfor j := uint32(0); j < ndim; j++ {\r\n   193\t\t\t\tshape[j] = binary.LittleEndian.Uint32(data[offset : offset+4])\r\n   194\t\t\t\toffset += 4\r\n   195\t\t\t}\r\n   196\t\r\n   197\t\t\telemSize := DtypeSize(dtype)\r\n   198\t\t\tnumElems := Product(shape)\r\n   199\t\t\tdataLen := numElems * int64(elemSize)\r\n   200\t\t\tif dataLen < 0 || offset+int(dataLen) > len(preceding) {\r\n"]
[5381.440787, "o", "   201\t\t\t\treturn nil, fmt.Errorf(\"truncated tensor data\")\r\n   202\t\t\t}\r\n   203\t\t\ttensorData := data[offset : offset+int(dataLen)]\r\n   204\t\t\toffset += int(dataLen)\r\n   205\t\r\n   206\t\t\ttSum := sha256.Sum256(tensorData)\r\n   207\t\t\ttensors = append(tensors, Tensor{\r\n   208\t\t\t\tName:     name,\r\n   209\t\t\t\tDtype:    dtype,\r\n   210\t\t\t\tShape:    shape,\r\n   211\t\t\t\tData:     tensorData,\r\n"]
[5381.440859, "o", "   212\t\t\t\tChecksum: hex.EncodeToString(tSum[:]),\r\n   213\t\t\t})\r\n   214\t\t}\r\n   215\t\r\n   216\t\tif offset != len(preceding) {\r\n   217\t\t\treturn nil, fmt.Errorf(\"extra data after tensors\")\r\n   218\t\t}\r\n   219\t\r\n   220\t\treturn &Checkpoint{\r\n   221\t\t\tVersion:      version,\r\n   222\t\t\tNumTensors:   numTensors,\r\n"]
[5381.440942, "o", "   223\t\t\tMetadata:     metadata,\r\n   224\t\t\tMetadataRaw:  metaRaw,\r\n   225\t\t\tTensors:      tensors,\r\n   226\t\t\tFileChecksum: fileChecksum,\r\n   227\t\t\tFilePath:     path,\r\n"]
[5381.441021, "o", "   228\t\t}, nil\r\n   229\t}\r\n   230\t\r\n   231\tfunc Build(metadata map[string]interface{}, tensors []Tensor) ([]byte, error) {\r\n   232\t\tmetaRaw, err := json.Marshal(metadata)\r\n   233\t\tif err != nil {\r\n   234\t\t\treturn nil, fmt.Errorf(\"failed to marshal metadata: %v\", err)\r\n   235\t\t}\r\n   236\t\r\n   237\t\tvar buf bytes.Buffer\r\n   238\t\theader := make([]byte, HeaderSize)\r\n   239\t\tcopy(header[0:4], Magic)\r\n   240\t\tbinary.LittleEndian.PutUint32(header[4:8], Version)\r\n"]
