[5047.504582, "o", "sed -n '1,120p' internal/mlck/checkpoint.go\r\n\u001b[?2004l\r"]
[5047.507605, "o", "package mlck\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n"]
[5047.507635, "o", "\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n)\r\n\r\nconst (\r\n"]
[5047.50785, "o", "\tMagic      = \"MLCK\"\r\n\tVersion    = 1\r\n\tHeaderSize = 16\r\n\tFooterSize = 32\r\n)\r\n\r\ntype Dtype uint8\r\n\r\nconst (\r\n\tFloat32 Dtype = 0\r\n\tFloat64 Dtype = 1\r\n\tInt32   Dtype = 2\r\n\tInt64   Dtype = 3\r\n)\r\n\r\nfunc (d Dtype) Valid() bool {\r\n\treturn d == Float32 || d == Float64 || d == Int32 || d == Int64\r\n}\r\n\r\nfunc (d Dtype) Name() string {\r\n\tswitch d {\r\n\tcase Float32:\r\n\t\treturn \"float32\"\r\n\tcase Float64:\r\n\t\treturn \"float64\"\r\n\tcase Int32:\r\n\t\t"]
[5047.507957, "o", "return \"int32\"\r\n\tcase Int64:\r\n\t\treturn \"int64\"\r\n\tdefault:\r\n"]
[5047.508054, "o", "\t\treturn \"unknown\"\r\n\t}\r\n}\r\n\r\nfunc (d Dtype) Size() int {\r\n\tswitch d {\r\n\tcase Float32, Int32:\r\n\t\treturn 4\r\n\tcase Float64, Int64:\r\n\t\treturn 8\r\n\tdefault:\r\n\t\treturn 0\r\n"]
[5047.508144, "o", "\t}\r\n}\r\n\r\nfunc DtypeName(dtype uint8) string {\r\n\treturn Dtype(dtype).Name()\r\n}\r\n\r\nfunc DtypeSize(dtype uint8) int {\r\n\treturn Dtype(dtype).Size()\r\n}\r\n\r\nfunc Product(shape []uint32) int64 {\r\n\tp := int64(1)\r\n"]
[5047.508241, "o", "\tfor _, s := range shape {\r\n\t\tp *= int64(s)\r\n\t}\r\n\treturn p\r\n}\r\n\r\ntype Tensor struct {\r\n\tName     string\r\n\tDtype    uint8\r\n\tShape    []uint32\r\n\tData     []byte\r\n"]
[5047.508331, "o", "\tChecksum string\r\n}\r\n\r\ntype TensorInfo struct {\r\n\tName     string   `json:\"name\"`\r\n\tDtype    string   `json:\"dtype\"`\r\n\tShape    []uint32 `json:\"shape\"`\r\n\tChecksum string   `json:\"checksum\"`\r\n}\r\n\r\n"]
[5047.508422, "o", "func (t Tensor) Info() TensorInfo {\r\n\treturn TensorInfo{\r\n\t\tName:     t.Name,\r\n\t\tDtype:    DtypeName(t.Dtype),\r\n\t\tShape:    t.Shape,\r\n\t\tChecksum: t.Checksum,\r\n\t}\r\n}\r\n\r\ntype Checkpoint struct {\r\n\tVersion      uint32\r\n\t"]
[5047.508512, "o", "NumTensors   uint32\r\n\tMetadata     map[string]interface{}\r\n\tMetadataRaw  []byte\r\n\tTensors      []Tensor\r\n\tFileChecksum string\r\n\tFilePath     string\r\n}\r\n\r\nfunc ParseFile(path string) (*Checkpoint, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn Parse(data, path)\r\n}\r\n\r\nfunc Parse(data []byte, path string) (*Checkpoint, error) {\r\n\tif len(data) < HeaderSize+FooterSize {"]
[5047.508602, "o", "\r\n\t\treturn nil, fmt.Errorf(\"file too small\")\r\n"]
[5047.509159, "o", "\u001b[?2004h"]
[5047.509264, "o", "root@n30009:/app# "]
[5047.780785, "i", "sed -n '120,270p' internal/mlck/checkpoint.go\n"]
[5047.781129, "o", "sed -n '120,270p' internal/mlck/checkpoint.go\r\n\u001b[?2004l\r"]
[5047.784072, "o", "\t\treturn nil, fmt.Errorf(\"file too small\")\r\n\t}\r\n\r\n\tif string(data[0:4]) != Magic {\r\n\t\treturn nil, fmt.Errorf(\"bad magic\")\r\n"]
[5047.784144, "o", "\t}\r\n\r\n\tversion := binary.LittleEndian.Uint32(data[4:8])\r\n\tif version != Version {\r\n\t\treturn nil, fmt.Errorf(\"unsupported version %d\", version)\r\n\t}\r\n\r\n\tnumTensors := binary.LittleEndian.Uint32(data[8:12])\r\n\tmetaLen := binary.LittleEndian.Uint32(data[12:16])\r\n\r\n\tif len(data) < HeaderSize+int(metaLen)+FooterSize {\r\n\t\treturn nil, fmt.Errorf(\"metadata length exceeds file size\")\r\n"]
[5047.784214, "o", "\t}\r\n\r\n\tpreceding := data[:len(data)-FooterSize]\r\n\tfooter := data[len(data)-FooterSize:]\r\n\tsum := sha256.Sum256(preceding)\r\n\tfileChecksum := hex.EncodeToString(sum[:])\r\n\tif hex.EncodeToString(footer) != fileChecksum {\r\n\t\treturn nil, fmt.Errorf(\"checksum mismatch\")\r\n\t}\r\n\r\n\tmetaRaw := data[HeaderSize : HeaderSize+int(metaLen)]\r\n"]
[5047.784316, "o", "\tvar metadata map[string]interface{}\r\n\tif metaLen > 0 {\r\n\t\tif err := json.Unmarshal(metaRaw, &metadata); err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"invalid metadata JSON: %v\", err)\r\n\t\t}\r\n\t} else {\r\n\t\tmetadata = map[string]interface{}{}\r\n\t}\r\n\r\n\toffset := HeaderSize + int(metaLen)\r\n\ttensors := make([]Tensor, 0, numTensors)\r\n\r\n\tfor i := uint32(0); i < numTensors; i++ {\r\n\t\tif offset+4 > len(preceding) {\r\n\t\t\treturn nil, fmt.Errorf(\"truncated tensor name length\")\r\n"]
[5047.784378, "o", "\t\t}\r\n\t\tnameLen := binary.LittleEndian.Uint32(data[offset : offset+4])\r\n\t\toffset += 4\r\n\r\n\t\tif offset+int(nameLen) > len(preceding) {\r\n\t\t\treturn nil, fmt.Errorf(\"truncated tensor name\")\r\n\t\t}\r\n\t\tname := string(data[offset : offset+int(nameLen)])\r\n\t"]
[5047.784441, "o", "\toffset += int(nameLen)\r\n\r\n\t\tif offset+1 > len(preceding) {\r\n\t\t\treturn nil, fmt.Errorf(\"truncated tensor dtype\")\r\n\t\t}\r\n\t\tdtype := data[offset]\r\n\t\toffset += 1\r\n\t\tif !Dtype(dtype).Valid() {\r\n\t\t\treturn nil, fmt.Errorf(\"invalid dtype %d\", dtype)\r\n"]
[5047.784502, "o", "\t\t}\r\n\r\n\t\tif offset+4 > len(preceding) {\r\n\t\t\treturn nil, fmt.Errorf(\"truncated tensor ndim\")\r\n\t\t}\r\n\t\tndim := binary.LittleEndian.Uint32(data[offset : offset+4])\r\n\t\toffset += 4\r\n\r\n\t\tshape := make([]uint32, ndim)\r\n\t\tif offset+4*int(ndim) > len(preceding) {\r\n"]
[5047.784564, "o", "\t\t\treturn nil, fmt.Errorf(\"truncated tensor shape\")\r\n\t\t}\r\n\t\tfor j := uint32(0); j < ndim; j++ {\r\n\t\t\tshape[j] = binary.LittleEndian.Uint32(data[offset : offset+4])\r\n\t\t\toffset += 4\r\n\t\t}\r\n\r\n\t\telemSize := DtypeSize(dtype)\r\n\t\tnumElems := Product(shape)\r\n"]
[5047.78464, "o", "\t\tdataLen := numElems * int64(elemSize)\r\n\t\tif dataLen < 0 || offset+int(dataLen) > len(preceding) {\r\n\t\t\treturn nil, fmt.Errorf(\"truncated tensor data\")\r\n\t\t}\r\n\t\ttensorData := data[offset : offset+int(dataLen)]\r\n\t\toffset += int(dataLen)\r\n\r\n\t\ttSum := sha256.Sum256(tensorData)\r\n\t\ttensors = append(tensors, Tensor{\r\n\t\t\tName:     name,\r\n"]
[5047.784701, "o", "\t\t\tDtype:    dtype,\r\n\t\t\tShape:    shape,\r\n\t\t\tData:     tensorData,\r\n\t\t\tChecksum: hex.EncodeToString(tSum[:]),\r\n\t\t})\r\n\t}\r\n\r\n\tif offset != len(preceding) {\r\n\t\treturn nil, fmt.Errorf(\"extra data after tensors\")\r\n"]
[5047.78476, "o", "\t}\r\n\r\n\treturn &Checkpoint{\r\n\t\tVersion:      version,\r\n\t\tNumTensors:   numTensors,\r\n\t\tMetadata:     metadata,\r\n\t\tMetadataRaw:  metaRaw,\r\n\t\tTensors:      tensors,\r\n\t\tFileChecksum: fileChecksum,\r\n\t\tFilePath:     path,\r\n"]
[5047.784823, "o", "\t}, nil\r\n}\r\n\r\nfunc Build(metadata map[string]interface{}, tensors []Tensor) ([]byte, error) {\r\n\tmetaRaw, err := json.Marshal(metadata)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to marshal metadata: %v\", err)\r\n\t}\r\n\r\n"]
[5047.784887, "o", "\tvar buf bytes.Buffer\r\n\theader := make([]byte, HeaderSize)\r\n\tcopy(header[0:4], Magic)\r\n\tbinary.LittleEndian.PutUint32(header[4:8], Version)\r\n\tbinary.LittleEndian.PutUint32(header[8:12], uint32(len(tensors)))\r\n\tbinary.LittleEndian.PutUint32(header[12:16], uint32(len(metaRaw)))\r\n\tbuf.Write(header)\r\n\tbuf.Write(metaRaw)\r\n\r\n\tfor _, t := range tensors {\r\n\t\tnameBytes := []byte(t.Name)\r\n"]
[5047.784949, "o", "\t\tif err := binary.Write(&buf, binary.LittleEndian, uint32(len(nameBytes))); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(nameBytes)\r\n\t\tbuf.WriteByte(t.Dtype)\r\n\t\tif err := binary.Write(&buf, binary.LittleEndian, uint32(len(t.Shape))); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n"]
[5047.78501, "o", "\t\tfor _, s := range t.Shape {\r\n\t\t\tif err := binary.Write(&buf, binary.LittleEndian, s); err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t}\r\n\t\texpected := Product(t.Shape) * int64(DtypeSize(t.Dtype))\r\n\t\tif int64(len(t.Data)) != expected {\r\n"]
[5047.785071, "o", "\t\t\treturn nil, fmt.Errorf(\"tensor %s data length %d does not match shape %v and dtype %s\", t.Name, len(t.Data), t.Shape, DtypeName(t.Dtype))\r\n\t\t}\r\n\t\tbuf.Write(t.Data)\r\n\t}\r\n\r\n\tsum := sha256.Sum256(buf.Bytes())\r\n\tbuf.Write(sum[:])\r\n\treturn buf.Bytes(), nil\r\n"]
[5047.78559, "o", "\u001b[?2004h"]
[5047.785648, "o", "root@n30009:/app# "]
[5060.889068, "i", "sed -n '1,115p' internal/mlck/checkpoint.go\n"]
[5060.889483, "o", "sed -n '1,115p' internal/mlck/checkpoint.go\r\n\u001b[?2004l\r"]
[5060.892358, "o", "package mlck\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"crypto/sha256\"\r\n"]
[5060.892393, "o", "\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n)\r\n\r\nconst (\r\n"]
[5060.892555, "o", "\tMagic      = \"MLCK\"\r\n\tVersion    = 1\r\n\tHeaderSize = 16\r\n\tFooterSize = 32\r\n)\r\n\r\ntype Dtype uint8\r\n\r\nconst (\r\n\tFloat32 Dtype = 0\r\n\tFloat64 Dtype = 1\r\n\tInt32   Dtype = 2\r\n\tInt64   Dtype = 3\r\n)\r\n\r\nfunc (d Dtype) Valid() bool {\r\n\treturn d == Float32 || d == Float64 || d == Int32 || d == Int64\r\n}\r\n\r\nfunc (d Dtype) Name() string {\r\n\tswitch d {\r\n\tcase Float32:\r\n\t\treturn \"float32\"\r\n\tcase Float64:\r\n\t\treturn \"float64\"\r\n\tcase Int32:\r\n\t\treturn \"int32\"\r\n\tcase Int64:\r\n\t\treturn \"int64\"\r\n\tdefault:\r\n"]
[5060.892662, "o", "\t\treturn \"unknown\"\r\n\t}\r\n}\r\n\r\nfunc (d Dtype) Size() int {\r\n\tswitch d {\r\n\tcase Float32, Int32:\r\n\t\treturn 4\r\n\tcase Float64, Int64:\r\n\t\treturn 8\r\n\tdefault:\r\n\t\treturn 0\r\n\t}\r\n}\r\n\r\nfunc DtypeName(dtype uint8) string {\r\n\treturn Dtype(dtype).Name()\r\n}\r\n\r\nfunc DtypeSize(dtype uint8) int {\r\n\treturn Dtype(dtype).Size()\r\n"]
[5060.892771, "o", "}\r\n\r\nfunc Product(shape []uint32) int64 {\r\n\tp := int64(1)\r\n\tfor _, s := range shape {\r\n\t\tp *= int64(s)\r\n\t}\r\n\t"]
[5060.892843, "o", "return p\r\n}\r\n\r\ntype Tensor struct {\r\n\tName     string\r\n\tDtype    uint8\r\n\tShape    []uint32\r\n\tData     []byte\r\n\tChecksum string\r\n}\r\n\r\ntype TensorInfo struct {\r\n\tName     string   `json:\"name\"`\r\n\tDtype    string   `json:\"dtype\"`\r\n\tShape    []uint32 `json:\"shape\"`\r\n\tChecksum string   `json:\"checksum\"`\r\n}\r\n\r\nfunc (t Tensor) Info() TensorInfo {\r\n\treturn TensorInfo{\r\n\t"]
[5060.892905, "o", "\tName:     t.Name,\r\n\t\tDtype:    DtypeName(t.Dtype),\r\n\t\tShape:    t.Shape,\r\n\t\tChecksum: t.Checksum,\r\n\t}\r\n}\r\n\r\ntype Checkpoint struct {\r\n\tVersion      uint32\r\n\tNumTensors   uint32\r\n\tMetadata     map[string]interface{}\r\n\tMetadataRaw  []byte\r\n\tTensors      []Tensor\r\n\tFileChecksum string\r\n\tFilePath     string\r\n}\r\n\r\n"]
[5060.892963, "o", "func ParseFile(path string) (*Checkpoint, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn Parse(data, path)\r\n"]
[5060.893502, "o", "\u001b[?2004h"]
[5060.893564, "o", "root@n30009:/app# "]
[5061.165449, "i", "sed -n '271,285p' internal/mlck/checkpoint.go\n"]
[5061.165787, "o", "sed -n '271,285p' internal/mlck/checkpoint.go\r\n"]
[5061.165864, "o", "\u001b[?2004l\r"]
[5061.168594, "o", "}\r\n\r\nfunc WriteFile(path string, metadata map[string]interface{}, tensors []Tensor) error {\r\n\tdata, err := Build(metadata, tensors)\r\n\tif err != nil {\r\n"]
[5061.16871, "o", "\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(path, data, 0644)\r\n}\r\n\r\nfunc (t Tensor) Float64Values() ([]float64, error) {\r\n"]
[5061.1688, "o", "\tsize := DtypeSize(t.Dtype)\r\n\tif size == 0 {\r\n\t\treturn nil, fmt.Errorf(\"invalid dtype %d\", t.Dtype)\r\n\t}\r\n"]
[5061.169125, "o", "\u001b[?2004h"]
[5061.169196, "o", "root@n30009:/app# "]
