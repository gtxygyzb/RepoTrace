[4855.657991, "i", "t()\n\nnew_run = '''func runDriftAnalysis(args []string) int {\n        fs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\n        fs.SetOutput(io.Discard)\n\n        topK := fs.Int(\"top-k\", 0, \"number of tensors with the lowest stability scores to include\")\n\n        pos, err := parseMixedArgs(fs, args)\n        if err != nil {\n                outputJSON(map[string]interface{}{\"error\": err.Error()})\n                return 1\n        }\n        if len(pos) < 2 {\n                outputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\n                return 1\n        }\n        if *topK < 0 {\n                outputJSON(map[string]interface{}{\"error\": \"--top-k must be non-negative\"})\n                return 1\n        }\n\n        res, err := drift.AnalyzeWithTopK(pos, *topK)\n        if err != nil {\n                outputJSON(map[string]interface{}{\"error\": err.Error()})\n                return 1\n        }\n        outputJSON(res)\n        return 0\n}'''\n\ns "]
