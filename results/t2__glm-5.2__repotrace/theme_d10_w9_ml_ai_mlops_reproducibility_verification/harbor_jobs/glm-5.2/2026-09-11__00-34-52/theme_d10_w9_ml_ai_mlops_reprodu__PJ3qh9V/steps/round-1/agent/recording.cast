[4904.960073, "o", "   172\t\t\t\treturn result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore\r\n   173\t\t\t}\r\n   174\t\t\treturn result.Tensors[i].Name < result.Tensors[j].Name\r\n   175\t\t})\r\n   176\t\tif requested < len(result.Tensors) {\r\n   177\t\t\tresult.Tensors = result.Tensors[:requested]\r\n   178\t\t}\r\n   179\t\tresult.TopK = &requested\r\n   180\t}\r\n   181\t\r\n   182\tfunc tensorData(cp *mlck.Checkpoint, name string) ([]float64, error) {\r\n   183\t\tt, ok := tensorByName(cp, name)\r\n   184\t\tif !ok {\r\n"]
