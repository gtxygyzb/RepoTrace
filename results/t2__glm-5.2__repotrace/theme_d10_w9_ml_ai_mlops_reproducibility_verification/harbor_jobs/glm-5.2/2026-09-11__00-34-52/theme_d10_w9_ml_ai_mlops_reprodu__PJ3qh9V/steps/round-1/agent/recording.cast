[4039.584485, "o", "    57\t\t\t\tresult.MissingInFile2 = append(result.MissingInFile2, t1.Name)\r\n    58\t\t\t\tcontinue\r\n    59\t\t\t}\r\n    60\t\t\ttr := compareTensors(t1, t2, mode, atol, rtol)\r\n    61\t\t\tresult.TensorResults = append(result.TensorResults, tr)\r\n    62\t\t\tif !tr.Match {\r\n    63\t\t\t\tresult.Match = false\r\n    64\t\t\t}\r\n    65\t\t}\r\n    66\t\r\n    67\t\tfor _, t := range c2.Tensors {\r\n    68\t\t\tif _, ok := map1[t.Name]; !ok {\r\n    69\t\t\t\tresult.MissingInFile1 = append(result.MissingInFile1, t.Name)\r\n    70\t\t\t}\r\n    71\t\t}\r\n    72\t\r\n"]
[4039.584571, "o", "    73\t\tif len(result.MissingInFile1) > 0 || len(result.MissingInFile2) > 0 {\r\n    74\t\t\tresult.Match = false\r\n    75\t\t}\r\n    76\t\r\n    77\t\treturn result, nil\r\n    78\t}\r\n    79\t\r\n    80\tfunc compareTensors(t1, t2 mlck.Tensor, mode string, atol, rtol float64) TensorResult {\r\n    81\t\ttotal := int(mlck.Product(t1.Shape))\r\n    82\t\ttr := TensorResult{\r\n    83\t\t\tName:          t1.Name,\r\n    84\t\t\tMatch:         true,\r\n    85\t\t\tMaxAbsDiff:    0,\r\n"]
[4039.584648, "o", "    86\t\t\tMaxRelDiff:    0,\r\n    87\t\t\tNumMismatches: 0,\r\n    88\t\t\tTotalElements: total,\r\n    89\t\t}\r\n    90\t\r\n    91\t\tif !shapesEqual(t1.Shape, t2.Shape) {\r\n    92\t\t\ttr.Match = false\r\n    93\t\t\ttr.NumMismatches = total\r\n    94\t\t\treturn tr\r\n    95\t\t}\r\n    96\t\r\n    97\t\tif total == 0 {\r\n    98\t\t\treturn tr\r\n"]
[4039.584725, "o", "    99\t\t}\r\n   100\t\r\n   101\t\tvals1, err := t1.Float64Values()\r\n   102\t\tif err != nil {\r\n   103\t\t\ttr.Match = false\r\n   104\t\t\ttr.NumMismatches = total\r\n   105\t\t\treturn tr\r\n   106\t\t}\r\n   107\t\tvals2, err := t2.Float64Values()\r\n   108\t\tif err != nil {\r\n   109\t\t\ttr.Match = false\r\n   110\t\t\ttr.NumMismatches = total\r\n"]
[4039.584809, "o", "   111\t\t\treturn tr\r\n   112\t\t}\r\n   113\t\r\n   114\t\tthreshold := int(math.Floor(float64(total) * 0.001))\r\n   115\t\tfor i := 0; i < total; i++ {\r\n   116\t\t\ta := vals1[i]\r\n   117\t\t\tb := vals2[i]\r\n   118\t\t\tdiff := math.Abs(a - b)\r\n   119\t\t\tif diff > tr.MaxAbsDiff {\r\n   120\t\t\t\ttr.MaxAbsDiff = diff\r\n   121\t\t\t}\r\n   122\t\t\tvar rel float64\r\n   123\t\t\t"]
[4039.584878, "o", "if math.Abs(b) > 0 {\r\n   124\t\t\t\trel = diff / math.Abs(b)\r\n   125\t\t\t} else if diff > 0 {\r\n   126\t\t\t\trel = diff\r\n   127\t\t\t}\r\n   128\t\t\tif rel > tr.MaxRelDiff {\r\n   129\t\t\t\ttr.MaxRelDiff = rel\r\n   130\t\t\t}\r\n   131\t\t\tif diff > atol+rtol*math.Abs(b) {\r\n"]
[4039.584963, "o", "   132\t\t\t\ttr.NumMismatches++\r\n   133\t\t\t}\r\n   134\t\t}\r\n   135\t\r\n   136\t\tswitch mode {\r\n   137\t\tcase \"strict\":\r\n   138\t\t\ttr.Match = tr.NumMismatches == 0\r\n   139\t\tcase \"relaxed\":\r\n   140\t\t\ttr.Match = tr.NumMismatches <= threshold\r\n   141\t\t}\r\n   142\t\r\n   143\t\treturn tr\r\n   144\t}\r\n   145\t\r\n"]
[4039.585042, "o", "   146\tfunc shapesEqual(a, b []uint32) bool {\r\n   147\t\tif len(a) != len(b) {\r\n   148\t\t\treturn false\r\n   149\t\t}\r\n   150\t\tfor i := range a {\r\n   151\t\t\tif a[i] != b[i] {\r\n   152\t\t\t\treturn false\r\n   153\t\t\t}\r\n   154\t\t}\r\n   155\t\treturn true\r\n   156\t}\r\n"]
