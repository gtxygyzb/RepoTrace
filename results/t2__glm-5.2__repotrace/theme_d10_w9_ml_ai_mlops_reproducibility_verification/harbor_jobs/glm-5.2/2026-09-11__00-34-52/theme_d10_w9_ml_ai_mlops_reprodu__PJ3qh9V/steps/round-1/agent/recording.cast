[1229.06986, "o", "\u001b[?2004l\r\u001b[?2004h>     tensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))\r\n\u001b[?2004l\r\u001b[?2004h>     for _, t := range cp.Tensors {\r\n\u001b[?2004l\r\u001b[?2004h>         tensors = append(tensors, t.Info())\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     outputJSON(map[string]interface{}{\r\n\u001b[?2004l\r\u001b[?2004h>         \"valid\": true,\r\n\u001b[?2004l\r\u001b[?2004h>         \"format_version\": int(cp.Version),\r\n\u001b[?2004l\r\u001b[?2004h>         \"num_tensors\": len(cp.Tensors),\r\n\u001b[?2004l\r\u001b[?2004h>         \"metadata\": metadata,\r\n\u001b[?2004l\r\u001b[?2004h>         \"tensors\": tensors,\r\n\u001b[?2004l\r\u001b[?2004h>         \"file_checksum\": cp.FileChecksum,\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h>     return 0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func runCompareOutputs(args []string) int {\r\n\u001b[?2004l\r\u001b[?2004h>     fs := flag.NewFlagSet(\"compare-outputs\", flag.ContinueOnError)\r\n\u001b[?2004l\r\u001b[?2004h>     fs.SetOutput(os.Stderr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1229.070161, "o", "    atol := fs.Float64(\"atol\", 1e-7, \"absolute tolerance\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1229.070234, "o", "> "]
[1229.070504, "o", "    rtol := fs.Float64(\"rtol\", 1e-5, \"relative tolerance\")\r\n\u001b[?2004l\r"]
