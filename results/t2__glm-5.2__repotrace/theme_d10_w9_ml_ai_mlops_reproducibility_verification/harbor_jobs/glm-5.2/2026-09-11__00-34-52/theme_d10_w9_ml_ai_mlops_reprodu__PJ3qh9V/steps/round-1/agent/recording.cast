[2643.606408, "o", "func runValidateManifest(args []string) int {\r\n   151\t\tif len(args) != 1 {\r\n   152\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify validate-manifest <file.toml>\"})\r\n   153\t\t\treturn 1\r\n   154\t\t}\r\n   155\t\tres := manifest.Validate(args[0])\r\n   156\t\toutputJSON(res)\r\n   157\t\tif res.Valid {\r\n   158\t\t\treturn 0\r\n   159\t\t}\r\n   160\t\treturn 1\r\n   161\t}\r\n   162"]
