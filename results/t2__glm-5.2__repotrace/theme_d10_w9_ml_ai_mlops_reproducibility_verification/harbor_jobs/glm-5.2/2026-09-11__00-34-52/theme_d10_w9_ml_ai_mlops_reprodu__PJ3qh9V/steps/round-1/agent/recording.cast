[3662.434273, "i", "sed -n '1,260p' internal/report/report.go\n"]
[3662.434603, "o", "sed -n '1,260p' internal/report/report.go\r\n\u001b[?2004l\r"]
[3662.437381, "o", "package report\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n"]
[3662.437452, "o", "\t\"repro-verify/internal/compare\"\r\n\t\"repro-verify/internal/lineage\"\r\n\t\"repro-verify/internal/manifest\"\r\n\t\"repro-verify/internal/mlck\"\r\n)\r\n\r\ntype ManifestPart struct {\r\n\tValid    bool     `json:\"valid\"`\r\n\tWarnings []string `json:\"warnings,omitempty\"`\r\n\tErrors   []string `json:\"errors,omitempty\"`\r\n}\r\n\r\n"]
[3662.437525, "o", "type CheckpointPart struct {\r\n\tValid        bool   `json:\"valid\"`\r\n\tNumTensors   int    `json:\"num_tensors\"`\r\n\tFileChecksum string `json:\"file_checksum\"`\r\n\tError        string `json:\"error,omitempty\"`\r\n}\r\n\r\ntype ComparisonPart struct {\r\n\tMatch   bool   `json:\"match\"`\r\n\tSummary string `json:\"summary,omitempty\"`\r\n\tError   string `json:\"error,omitempty\"`\r\n}\r\n\r\n"]
[3662.437588, "o", "type LineagePart struct {\r\n\tValid bool   `json:\"valid\"`\r\n\tDepth int    `json:\"depth\"`\r\n\tError string `json:\"error,omitempty\"`\r\n}\r\n\r\ntype Report struct {\r\n\tReportVersion       string          `json:\"report_version\"`\r\n\tTimestamp           string          `json:\"timestamp\"`\r\n\tManifest            ManifestPart    `json:\"manifest\"`\r\n\tCheckpoint          *CheckpointPart `json:\"checkpoint,omitempty\"`\r\n\tComparison          *ComparisonPart `json:\"comparison,omitempty\"`\r\n\t"]
[3662.437667, "o", "Lineage             *LineagePart    `json:\"lineage,omitempty\"`\r\n\tOverallReproducible bool            `json:\"overall_reproducible\"`\r\n\tIssues              []string        `json:\"issues\"`\r\n}\r\n\r\nfunc Generate(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {\r\n\tissues := []string{}\r\n\trep := &Report{\r\n\t\tReportVersion: \"1.0\",\r\n\t\tTimestamp:     time.Now().Format(time.RFC3339),\r\n\t\tIssues:        issues,\r\n\t}\r\n\r\n"]
[3662.437704, "o", "\tman := manifest.Validate(manifestPath)\r\n\trep.Manifest = ManifestPart{\r\n\t\tValid:    man.Valid,\r\n\t\tWarnings: man.Warnings,\r\n\t\tErrors:   man.Errors,\r\n\t}\r\n\tif !man.Valid {\r\n"]
[3662.437834, "o", "\t\tissues = append(issues, fmt.Sprintf(\"Manifest validation failed: %s\", strings.Join(man.Errors, \"; \")))\r\n\t}\r\n\r\n\tcheckpointValid := true\r\n\tif checkpointPath != \"\" {\r\n\t\tcp, err := mlck.ParseFile(checkpointPath)\r\n\t\tif err != nil {\r\n\t\t\tcheckpointValid = false\r\n\t\t\trep.Checkpoint = &CheckpointPart{\r\n\t\t\t\tValid: false,\r\n\t\t\t\tError: err.Error(),\r\n\t\t\t}\r\n\t\t\tissues = append(issues, fmt.Sprintf(\"Checkpoint verification failed: %v\", err))\r\n\t\t} else {\r\n\t\t\trep.Checkpoint = &CheckpointPart{\r\n\t\t\t\tValid:        true,\r\n\t\t\t\tNumTensors:   len(cp.Tensors),\r\n\t\t\t\tFileChecksum: cp.FileChecksum,\r\n\t\t\t}\r\n"]
[3662.437893, "o", "\t\t}\r\n\t}\r\n\r\n\tcomparisonMatch := true\r\n\tif checkpointPath != \"\" && comparePath != \"\" {\r\n\t\tc1, err := mlck.ParseFile(checkpointPath)\r\n\t\tif err != nil {\r\n\t\t\tcomparisonMatch = false\r\n"]
[3662.437957, "o", "\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\tMatch: false,\r\n\t\t\t\tError: fmt.Sprintf(\"checkpoint parse failed: %v\", err),\r\n\t\t\t}\r\n\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\t\t} else {\r\n\t\t\tc2, err := mlck.ParseFile(comparePath)\r\n\t\t\tif err != nil {\r\n\t\t\t\tcomparisonMatch = false\r\n"]
[3662.438015, "o", "\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\t\tMatch: false,\r\n\t\t\t\t\tError: fmt.Sprintf(\"compare checkpoint parse failed: %v\", err),\r\n\t\t\t\t}\r\n\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\t\t\t} else {\r\n\t\t\t\tres, err := compare.Compare(c1, c2, \"strict\", 1e-7, 1e-5)\r\n\t\t\t\tif err != nil {\r\n"]
[3662.438072, "o", "\t\t\t\t\tcomparisonMatch = false\r\n\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\t\t\tMatch: false,\r\n\t\t\t\t\t\tError: err.Error(),\r\n\t\t\t\t\t}\r\n\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\t\t\t\t} else {\r\n\t\t\t\t\tdiffer := 0\r\n"]
[3662.438129, "o", "\t\t\t\t\ttotal := len(res.TensorResults)\r\n\t\t\t\t\tfor _, tr := range res.TensorResults {\r\n\t\t\t\t\t\tif !tr.Match {\r\n\t\t\t\t\t\t\tdiffer++\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n"]
[3662.438184, "o", "\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\t\t\tMatch:   res.Match,\r\n\t\t\t\t\t\tSummary: fmt.Sprintf(\"%d/%d tensors differ\", differ, total),\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif !res.Match {\r\n\t\t\t\t\t\tcomparisonMatch = false\r\n\t\t\t\t\t\tif differ > 0 {\r\n\t\t\t\t\t\t\t"]
[3662.438248, "o", "issues = append(issues, fmt.Sprintf(\"Tensor comparison failed: %d tensors differ beyond tolerance\", differ))\r\n\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\tissues = append(issues, \"Tensor comparison failed: missing tensors or shape mismatch\")\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n"]
[3662.438316, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tlineageValid := true\r\n\tif lineagePath != \"\" {\r\n\t\tlin := lineage.Audit(lineagePath)\r\n\t\tif lin.Valid {\r\n\t\t\trep.Lineage = &LineagePart{\r\n"]
[3662.438373, "o", "\t\t\t\tValid: true,\r\n\t\t\t\tDepth: lin.MaxDepth,\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t\tlineageValid = false\r\n\t\t\trep.Lineage = &LineagePart{\r\n\t\t\t\tValid: false,\r\n\t\t\t\tError: strings.Join(lin.Errors, \"; \"),\r\n"]
[3662.438433, "o", "\t\t\t}\r\n\t\t\tissues = append(issues, fmt.Sprintf(\"Lineage audit failed: %s\", strings.Join(lin.Errors, \"; \")))\r\n\t\t}\r\n\t}\r\n\r\n\toverall := man.Valid && checkpointValid && comparisonMatch && lineageValid\r\n\trep.OverallReproducible = overall\r\n\trep.Issues = issues\r\n\r\n\tif overall {\r\n\t\treturn rep, 0\r\n\t}"]
[3662.438495, "o", "\r\n\treturn rep, 1\r\n}\r\n"]
[3662.438912, "o", "\u001b[?2004h"]
[3662.43898, "o", "root@n30009:/app# "]
[3662.711826, "i", "sed -n '1,260p' internal/drift/drift.go\n"]
[3662.712137, "o", "sed -n '1,260p' internal/drift/drift.go\r\n\u001b[?2004l\r"]
[3662.714902, "o", "package drift\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
[3662.715011, "o", "\r\n\t\"repro-verify/internal/mlck\"\r\n)\r\n\r\ntype TensorResult struct {\r\n\tName           string    `json:\"name\"`\r\n\tStepChanges    []float64 `json:\"step_changes\"`\r\n"]
[3662.71508, "o", "\tMeanChange     float64   `json:\"mean_change\"`\r\n\tMaxChange      float64   `json:\"max_change\"`\r\n\tConvergence    string    `json:\"convergence\"`\r\n\tStabilityScore float64   `json:\"stability_score\"`\r\n}\r\n\r\ntype Result struct {\r\n\tNumSnapshots       int            `json:\"num_snapshots\"`\r\n\tNumAnalyzedTensors int            `json:\"num_analyzed_tensors\"`\r\n\tSkippedTensors     []string       `json:\"skipped_tensors\"`\r\n\tTensors            []TensorResult `json:\"tensors\"`\r\n\tOverallConvergence string         `json:\"overall_convergence\"`\r\n}\r\n\r\nfunc Analyze(files []string) (*Result, error) {\r\n\tif len(files) < 2 {\r\n\t\treturn nil, fmt.Errorf(\"at least 2 input files required\")\r\n\t}\r\n\r\n\tcps := make([]*mlck.Checkpoint, len(files))\r\n\tfor i, f := range files {\r\n\t\tcp, err := mlck.ParseFile(f)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n\t\t}\r\n"]
[3662.715158, "o", "\t\tcps[i] = cp\r\n\t}\r\n\r\n\tvar allNames []string\r\n\tseen := map[string]bool{}\r\n\tfor _, cp := range cps {\r\n\t\tfor _, t := range cp.Tensors {\r\n\t\t\tif !seen[t.Name] {\r\n\t\t\t\tseen[t.Name] = true\r\n\t\t\t\tallNames = append(allNames, t.Name)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[3662.715247, "o", "\tskipped := []string{}\r\n\ttensors := []TensorResult{}\r\n\tconverging := 0\r\n\tdiverging := 0\r\n\r\n\tfor _, name := range allNames {\r\n\t\tok := true\r\n\t\tvar shape []uint32\r\n\t\tfor _, cp := range cps {\r\n\t\t\tt, exists := tensorByName(cp, name)\r\n\t\t\tif !exists {\r\n\t\t\t"]
[3662.715307, "o", "\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\tif shape == nil {\r\n\t\t\t\tshape = t.Shape\r\n"]
[3662.715366, "o", "\t\t\t} else if !shapesEqual(shape, t.Shape) {\r\n\t\t\t\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif !ok {\r\n\t\t\tskipped = append(skipped, name)\r\n\t\t\tcontinue\r\n\t"]
[3662.71543, "o", "\t}\r\n\r\n\t\tsteps := make([]float64, len(cps)-1)\r\n\t\tfor i := 0; i < len(cps)-1; i++ {\r\n\t\t\tt1, _ := tensorByName(cps[i], name)\r\n\t\t\tt2, _ := tensorByName(cps[i+1], name)\r\n\t\t\tv1, err := t1.Float64Values()\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n"]
[3662.715491, "o", "\t\t\t}\r\n\t\t\tv2, err := t2.Float64Values()\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tn := len(v1)\r\n\t\t\tif n == 0 {\r\n\t\t\t\tsteps[i] = 0\r\n"]
[3662.715547, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvar sum float64\r\n\t\t\tfor j := 0; j < n; j++ {\r\n\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n\t\t\t}\r\n\t\t\tsteps[i] = sum / float64(n)\r\n\t\t}\r\n"]
[3662.715608, "o", "\r\n\t\tmean := meanFloat64(steps)\r\n\t\tmax := maxFloat64(steps)\r\n\t\tconvergence := classifyConvergence(steps)\r\n\t\tstability := 1.0\r\n\t\tif steps[0] != 0 {\r\n\t\t\tstability = 1.0 - steps[len(steps)-1]/steps[0]\r\n\t\t\tif stability < 0 {"]
[3662.715664, "o", "\r\n\t\t\t\tstability = 0\r\n\t\t\t} else if stability > 1 {\r\n\t\t\t\tstability = 1\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\ttensors = append(tensors, TensorResult{\r\n\t\t\tName:           name,\r\n\t\t\tStepChanges:    steps,\r\n"]
[3662.715725, "o", "\t\t\tMeanChange:     mean,\r\n\t\t\tMaxChange:      max,\r\n\t\t\tConvergence:    convergence,\r\n\t\t\tStabilityScore: stability,\r\n\t\t})\r\n\r\n\t\tif convergence == \"converging\" {\r\n\t\t\tconverging++\r\n\t\t} else if convergence == \"diverging\" {\r\n"]
[3662.715787, "o", "\t\t\tdiverging++\r\n\t\t}\r\n\t}\r\n\r\n\toverall := \"mixed\"\r\n\tif converging > len(tensors)/2 {\r\n\t\toverall = \"converging\"\r\n\t} else if diverging > len(tensors)/2 {\r\n\t\toverall = \"diverging\"\r\n\t}\r\n\r\n\treturn &Result{\r\n\t"]
[3662.715845, "o", "\tNumSnapshots:       len(files),\r\n\t\tNumAnalyzedTensors: len(tensors),\r\n\t\tSkippedTensors:     skipped,\r\n\t\tTensors:            tensors,\r\n\t\tOverallConvergence: overall,\r\n\t}, nil\r\n}\r\n\r\nfunc tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {\r\n\t"]
[3662.715902, "o", "for _, t := range cp.Tensors {\r\n\t\tif t.Name == name {\r\n\t\t\treturn t, true\r\n\t\t}\r\n\t}\r\n\treturn mlck.Tensor{}, false\r\n}\r\n\r\nfunc shapesEqual(a, b []uint32) bool {\r\n\tif len(a) != len(b) {\r\n\t\treturn false\r\n"]
[3662.715957, "o", "\t}\r\n\tfor i := range a {\r\n\t\tif a[i] != b[i] {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc meanFloat64(xs []float64) float64 {\r\n"]
[3662.716019, "o", "\tif len(xs) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tvar sum float64\r\n\tfor _, x := range xs {\r\n\t\tsum += x\r\n\t}\r\n\treturn sum / float64(len(xs))\r\n}\r\n\r\nfunc maxFloat64(xs []float64) float64 {\r\n\tif len(xs) == 0 {\r\n\t\treturn 0\r\n\t}\r\n"]
[3662.716074, "o", "\tm := xs[0]\r\n\tfor _, x := range xs[1:] {\r\n\t\tif x > m {\r\n\t\t\tm = x\r\n\t\t}\r\n\t}\r\n\treturn m\r\n}\r\n"]
[3662.716132, "o", "\r\nfunc classifyConvergence(steps []float64) string {\r\n\tif len(steps) <= 1 {\r\n\t\treturn \"converging\"\r\n\t}\r\n\tdecreasing := true\r\n\tincreasing := true\r\n\tfor i := 1; i < len(steps); i++ {\r\n\t\tif steps[i] >= steps[i-1] {\r\n\t\t\tdecreasing = false\r\n\t\t}\r\n"]
[3662.716189, "o", "\t\tif steps[i] <= steps[i-1] {\r\n\t\t\tincreasing = false\r\n\t\t}\r\n\t}\r\n\tif decreasing {\r\n\t\treturn \"converging\"\r\n\t}\r\n\tif increasing {\r\n\t\treturn \"diverging\"\r\n\t}\r\n"]
[3662.716272, "o", "\treturn \"oscillating\"\r\n}\r\n"]
[3662.716683, "o", "\u001b[?2004h"]
[3662.716739, "o", "root@n30009:/app# "]
[3662.9985, "i", "sed -n '1,260p' internal/lineage/lineage.go\n"]
[3662.99885, "o", "sed -n '1,260p' internal/lineage/lineage.go\r\n\u001b[?2004l\r"]
[3663.001681, "o", "package lineage\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[3663.001753, "o", "\t\"os\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\ntype Experiment struct {\r\n\tID             string   `json:\"id\"`\r\n\tName           string   `json:\"name\"`\r\n\tParents        []string `json:\"parents\"`\r\n\tCheckpointHash string   `json:\"checkpoint_hash\"`\r\n\tTimestamp      string   `json:\"timestamp\"`\r\n}\r\n\r\ntype Input struct {\r\n\tExperiments []Experiment `json:\"experiments\"`\r\n"]
[3663.001822, "o", "}\r\n\r\ntype Result struct {\r\n\tValid            bool     `json:\"valid\"`\r\n\tNumExperiments   int      `json:\"num_experiments\"`\r\n\tNumRoots         int      `json:\"num_roots\"`\r\n\tNumLeaves        int      `json:\"num_leaves\"`\r\n\tMaxDepth         int      `json:\"max_depth\"`\r\n\tTopologicalOrder []string `json:\"topological_order\"`\r\n\tErrors           []string `json:\"errors,omitempty\"`\r\n}\r\n\r\nfunc Audit(path string) *Result {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn &Result{"]
[3663.001909, "o", "\r\n\t\t\tValid:  false,\r\n\t\t\tErrors: []string{fmt.Sprintf(\"failed to read lineage file: %v\", err)},\r\n\t\t}\r\n\t}\r\n\r\n\tvar in Input\r\n\tif err := json.Unmarshal(data, &in); err != nil {\r\n\t\treturn &Result{\r\n"]
[3663.001976, "o", "\t\t\tValid:  false,\r\n\t\t\tErrors: []string{fmt.Sprintf(\"failed to parse lineage JSON: %v\", err)},\r\n\t\t}\r\n\t}\r\n\r\n\texps := in.Experiments\r\n\tresult := &Result{\r\n\t\tValid:            true,\r\n\t\tErrors:           []string{},\r\n\t\tTopologicalOrder: []string{},\r\n\t}\r\n\r\n\tif len(exps) == 0 {\r\n\t\tresult.TopologicalOrder = []string{}\r\n\t\treturn result\r\n\t}\r\n\r\n"]
[3663.002036, "o", "\tidSet := make(map[string]int)\r\n\tids := make([]string, 0, len(exps))\r\n\tfor i, e := range exps {\r\n\t\tif e.ID == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"experiment at index %d missing id\", i))\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif _, ok := idSet[e.ID]; ok {\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"duplicate id: %s\", e.ID))\r\n"]
[3663.002093, "o", "\t\t} else {\r\n\t\t\tidSet[e.ID] = i\r\n\t\t\tids = append(ids, e.ID)\r\n\t\t}\r\n\t\tif e.CheckpointHash == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"empty checkpoint_hash for experiment: %s\", e.ID))\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, e := range exps {\r\n\t\t"]
[3663.002151, "o", "if e.ID == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfor _, p := range e.Parents {\r\n\t\t\tif _, ok := idSet[p]; !ok {\r\n\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"parent reference unresolved: %s -> %s\", e.ID, p))\r\n\t\t\t}\r\n\t\t}\r\n\t}"]
[3663.002215, "o", "\r\n\r\n\ttimes := make(map[string]time.Time)\r\n\tfor _, e := range exps {\r\n\t\tif e.ID == \"\" {\r\n\t\t\tcontinue\r\n"]
[3663.002321, "o", "\t\t}\r\n\t\tif e.Timestamp == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"missing timestamp for experiment: %s\", e.ID))\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tt, err := time.Parse(time.RFC3339, e.Timestamp)\r\n\t\tif err != nil {\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"invalid timestamp for experiment: %s\", e.ID))\r\n\t\t} else {\r\n\t\t\ttimes[e.ID] = t\r\n\t\t}\r\n\t}\r\n\r\n\tif len(result.Errors) == 0 {\r\n\t\tif cycle := detectCycle(exps); cycle != nil {\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"cycle detected involving: %s\", strings.Join(cycle, \", \")))\r\n\t\t}\r\n\t}\r\n\r\n"]
[3663.002384, "o", "\tif len(result.Errors) == 0 {\r\n\t\tfor _, e := range exps {\r\n\t\t\tchildTime, ok := times[e.ID]\r\n\t\t\tif !ok {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tfor _, p := range e.Parents {\r\n\t\t\t\tparentTime, ok := times[p]\r\n\t\t\t\tif !ok {\r\n\t"]
[3663.002447, "o", "\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tif !childTime.After(parentTime) {\r\n\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"timestamp violation: %s (%s) has parent %s (%s)\", e.ID, childTime.Format(\"2006-01-02\"), p, parentTime.Format(\"2006-01-02\")))\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[3663.002508, "o", "\tif len(result.Errors) > 0 {\r\n\t\tresult.Valid = false\r\n\t\tresult.TopologicalOrder = nil\r\n\t\treturn result\r\n\t}\r\n\r\n\tchildren := make(map[string][]string)\r\n\tfor _, e := range exps {\r\n\t\tfor _, p := range e.Parents {\r\n\t\t\tchildren[p] = append(children[p], e.ID)\r\n"]
[3663.00257, "o", "\t\t}\r\n\t}\r\n\r\n\troots := make([]string, 0)\r\n\tleaves := make([]string, 0)\r\n\tfor _, e := range exps {\r\n\t\tif len(e.Parents) == 0 {\r\n\t\t\troots = append(roots, e.ID)\r\n\t\t}\r\n\t\tif len(children[e.ID]) == 0 {\r\n\t"]
[3663.002629, "o", "\t\tleaves = append(leaves, e.ID)\r\n\t\t}\r\n\t}\r\n\r\n\tvisited := make(map[string]bool)\r\n\tvar post []string\r\n\tvar dfs func(id string)\r\n\tdfs = func(id string) {\r\n\t\tvisited[id] = true\r\n\t\tfor _, child := range children[id] {\r\n\t"]
[3663.002692, "o", "\t\tif !visited[child] {\r\n\t\t\t\tdfs(child)\r\n\t\t\t}\r\n\t\t}\r\n\t\tpost = append(post, id)\r\n"]
[3663.002752, "o", "\t}\r\n\tfor _, e := range exps {\r\n\t\tif !visited[e.ID] {\r\n\t\t\tdfs(e.ID)\r\n\t\t}\r\n\t}\r\n\ttopo := make([]string, len(post))\r\n\tfor i := range post {\r\n\t\ttopo[i] = post[len(post)-1-i]\r\n\t}\r\n\r\n\tmaxDepth := 0\r\n\tvar depthDFS func(id string, depth int)"]
[3663.002816, "o", "\r\n\tdepthDFS = func(id string, depth int) {\r\n\t\tif depth > maxDepth {\r\n\t\t\tmaxDepth = depth\r\n\t\t}\r\n\t\tfor _, child := range children[id] {\r\n\t\t\tdepthDFS(child, depth+1)\r\n\t\t}\r\n\t}\r\n\tfor _, r := range roots {\r\n"]
[3663.002876, "o", "\t\tdepthDFS(r, 1)\r\n\t}\r\n\r\n\tresult.NumExperiments = len(exps)\r\n\tresult.NumRoots = len(roots)\r\n\tresult.NumLeaves = len(leaves)\r\n\tresult.MaxDepth = maxDepth\r\n\tresult.TopologicalOrder = topo\r\n\treturn result\r\n"]
[3663.002932, "o", "}\r\n\r\nfunc detectCycle(exps []Experiment) []string {\r\n\tadj := make(map[string][]string)\r\n\tfor _, e := range exps {\r\n\t\tfor _, p := range e.Parents {\r\n\t\t\tadj[p] = append(adj[p], e.ID)\r\n\t\t}\r\n\t}\r\n\r\n\tstate := make(map[string]int)\r\n"]
[3663.002998, "o", "\tvar stack []string\r\n\tvar cycle []string\r\n\r\n\tvar dfs func(id string) bool\r\n\tdfs = func(id string) bool {\r\n\t\tstate[id] = 1\r\n\t\tstack = append(stack, id)\r\n"]
[3663.00306, "o", "\t\tfor _, child := range adj[id] {\r\n\t\t\tif state[child] == 1 {\r\n\t\t\t\tidx := -1\r\n\t\t\t\tfor i := len(stack) - 1; i >= 0; i-- {\r\n\t\t\t\t\tif stack[i] == child {\r\n\t\t\t\t\t\tidx = i\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t}\r\n"]
[3663.003117, "o", "\t\t\t\t}\r\n\t\t\t\tif idx >= 0 {\r\n\t\t\t\t\tcycle = append([]string{}, stack[idx:]...)\r\n\t\t\t\t\treturn true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif state[child] == 0 {\r\n\t\t\t\tif dfs(child) {\r\n\t\t\t\t\treturn true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\t"]
[3663.003171, "o", "stack = stack[:len(stack)-1]\r\n\t\tstate[id] = 2\r\n\t\treturn false\r\n\t}\r\n\r\n\tfor _, e := range exps {\r\n\t\tif state[e.ID] == 0 {\r\n"]
[3663.003247, "o", "\t\t\tif dfs(e.ID) {\r\n\t\t\t\treturn cycle\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n"]
[3663.003694, "o", "\u001b[?2004h"]
[3663.003755, "o", "root@n30009:/app# "]
[3663.267292, "i", "sed -n '1,260p' internal/compare/compare.go\n"]
[3663.267675, "o", "sed -n '1,260p' internal/compare/compare.go\r\n\u001b[?2004l\r"]
[3663.27044, "o", "package compare\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
[3663.270511, "o", "\r\n\t\"repro-verify/internal/mlck\"\r\n)\r\n\r\ntype TensorResult struct {\r\n\tName          string  `json:\"name\"`\r\n\tMatch         bool    `json:\"match\"`\r\n\tMaxAbsDiff    float64 `json:\"max_abs_diff\"`\r\n\tMaxRelDiff    float64 `json:\"max_rel_diff\"`\r\n\tNumMismatches int     `json:\"num_mismatches\"`\r\n\tTotalElements int     `json:\"total_elements\"`\r\n}\r\n\r\ntype Result struct {\r\n"]
[3663.270587, "o", "\tMatch          bool           `json:\"match\"`\r\n\tMode           string         `json:\"mode\"`\r\n\tAtol           float64        `json:\"atol\"`\r\n\tRtol           float64        `json:\"rtol\"`\r\n\tTensorResults  []TensorResult `json:\"tensor_results\"`\r\n\tMissingInFile1 []string       `json:\"missing_in_file1\"`\r\n\tMissingInFile2 []string       `json:\"missing_in_file2\"`\r\n\tError          string         `json:\"error,omitempty\"`\r\n}\r\n\r\nfunc Compare(c1, c2 *mlck.Checkpoint, mode string, atol, rtol float64) (*Result, error) {\r\n"]
[3663.27065, "o", "\tif mode != \"strict\" && mode != \"relaxed\" {\r\n\t\treturn nil, fmt.Errorf(\"invalid mode %q\", mode)\r\n\t}\r\n\r\n\tresult := &Result{\r\n\t\tMatch:          true,\r\n\t\tMode:           mode,\r\n\t\tAtol:           atol,\r\n\t\tRtol:           rtol,\r\n\t\tTensorResults:  []TensorResult{},\r\n\t\tMissingInFile1: []string{},\r\n\t"]
[3663.270713, "o", "\tMissingInFile2: []string{},\r\n\t}\r\n\r\n\tmap2 := make(map[string]mlck.Tensor)\r\n\tfor _, t := range c2.Tensors {\r\n\t\tmap2[t.Name] = t\r\n\t}\r\n\tmap1 := make(map[string]mlck.Tensor)\r\n\tfor _, t := range c1.Tensors {\r\n\t\t"]
[3663.270772, "o", "map1[t.Name] = t\r\n\t}\r\n\r\n\tfor _, t1 := range c1.Tensors {\r\n\t\tt2, ok := map2[t1.Name]\r\n\t\tif !ok {\r\n\t\t\tresult.MissingInFile2 = append(result.MissingInFile2, t1.Name)\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\ttr := compareTensors(t1, t2, mode, atol, rtol)\r\n\t\t"]
[3663.270832, "o", "result.TensorResults = append(result.TensorResults, tr)\r\n\t\tif !tr.Match {\r\n\t\t\tresult.Match = false\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, t := range c2.Tensors {\r\n\t\tif _, ok := map1[t.Name]; !ok {\r\n\t\t\tresult.MissingInFile1 = append(result.MissingInFile1, t.Name)\r\n"]
[3663.27089, "o", "\t\t}\r\n\t}\r\n\r\n\tif len(result.MissingInFile1) > 0 || len(result.MissingInFile2) > 0 {\r\n\t\tresult.Match = false\r\n\t}\r\n\r\n\treturn result, nil\r\n}\r\n\r\nfunc compareTensors(t1, t2 mlck.Tensor, mode string, atol, rtol float64) TensorResult {\r\n"]
[3663.270951, "o", "\ttotal := int(mlck.Product(t1.Shape))\r\n\ttr := TensorResult{\r\n\t\tName:          t1.Name,\r\n\t\tMatch:         true,\r\n\t\tMaxAbsDiff:    0,\r\n\t\tMaxRelDiff:    0,\r\n\t\tNumMismatches: 0,\r\n\t\tTotalElements: total,\r\n\t}\r\n"]
[3663.271013, "o", "\r\n\tif !shapesEqual(t1.Shape, t2.Shape) {\r\n\t\ttr.Match = false\r\n\t\ttr.NumMismatches = total\r\n\t\treturn tr\r\n\t}\r\n\r\n\tif total == 0 {\r\n\t\treturn tr\r\n\t}\r\n\r\n"]
[3663.27107, "o", "\tvals1, err := t1.Float64Values()\r\n\tif err != nil {\r\n\t\ttr.Match = false\r\n\t\ttr.NumMismatches = total\r\n\t\treturn tr\r\n\t}\r\n\tvals2, err := t2.Float64Values()\r\n\tif err != nil {\r\n\t\ttr.Match = false\r\n"]
[3663.271131, "o", "\t\ttr.NumMismatches = total\r\n\t\treturn tr\r\n\t}\r\n\r\n\tthreshold := int(math.Floor(float64(total) * 0.001))\r\n\tfor i := 0; i < total; i++ {\r\n\t\ta := vals1[i]\r\n\t\tb := vals2[i]\r\n\t\tdiff := math.Abs(a - b)\r\n\t\tif diff > tr.MaxAbsDiff {\r\n"]
[3663.271187, "o", "\t\t\ttr.MaxAbsDiff = diff\r\n\t\t}\r\n\t\tvar rel float64\r\n\t\tif math.Abs(b) > 0 {\r\n\t\t\trel = diff / math.Abs(b)\r\n\t\t} else if diff > 0 {\r\n\t\t\trel = diff\r\n\t\t}\r\n\t\tif rel > tr.MaxRelDiff {\r\n\t"]
[3663.271276, "o", "\t\ttr.MaxRelDiff = rel\r\n\t\t}\r\n\t\tif diff > atol+rtol*math.Abs(b) {\r\n\t\t\ttr.NumMismatches++\r\n\t\t}\r\n\t}\r\n\r\n\tswitch mode {\r\n\tcase \"strict\":\r\n\t\ttr.Match = tr.NumMismatches == 0\r\n\tcase \"relaxed\":\r\n\t\ttr.Match = tr.NumMismatches <= threshold\r\n\t}\r\n"]
[3663.271334, "o", "\r\n\treturn tr\r\n}\r\n\r\nfunc shapesEqual(a, b []uint32) bool {\r\n\tif len(a) != len(b) {\r\n\t\treturn false\r\n\t}\r\n\tfor i := range a {\r\n\t\tif a[i] != b[i] {\r\n\t\t\t"]
[3663.271389, "o", "return false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n"]
[3663.271817, "o", "\u001b[?2004h"]
[3663.271873, "o", "root@n30009:/app# "]
[3670.041706, "i", "sed -n '1,320p' internal/report/report.go\n"]
[3670.042045, "o", "sed -n '1,320p' internal/report/report.go\r\n\u001b[?2004l\r"]
[3670.044983, "o", "package report\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"strings\"\r\n\t\"time\"\r\n"]
[3670.045061, "o", "\r\n\t\"repro-verify/internal/compare\"\r\n\t\"repro-verify/internal/lineage\"\r\n\t\"repro-verify/internal/manifest\"\r\n\t\"repro-verify/internal/mlck\"\r\n)\r\n\r\ntype ManifestPart struct {\r\n\tValid    bool     `json:\"valid\"`\r\n\tWarnings []string `json:\"warnings,omitempty\"`\r\n\tErrors   []string `json:\"errors,omitempty\"`\r\n}\r\n\r\ntype CheckpointPart struct {\r\n\tValid        bool   `json:\"valid\"`\r\n\tNumTensors   int    `json:\"num_tensors\"`\r\n"]
[3670.045134, "o", "\tFileChecksum string `json:\"file_checksum\"`\r\n\tError        string `json:\"error,omitempty\"`\r\n}\r\n\r\ntype ComparisonPart struct {\r\n\tMatch   bool   `json:\"match\"`\r\n\tSummary string `json:\"summary,omitempty\"`\r\n\tError   string `json:\"error,omitempty\"`\r\n}\r\n\r\ntype LineagePart struct {\r\n\tValid bool   `json:\"valid\"`\r\n\tDepth int    `json:\"depth\"`\r\n\tError string `json:\"error,omitempty\"`\r\n}\r\n"]
[3670.045197, "o", "\r\ntype Report struct {\r\n\tReportVersion       string          `json:\"report_version\"`\r\n\tTimestamp           string          `json:\"timestamp\"`\r\n\tManifest            ManifestPart    `json:\"manifest\"`\r\n\tCheckpoint          *CheckpointPart `json:\"checkpoint,omitempty\"`\r\n\tComparison          *ComparisonPart `json:\"comparison,omitempty\"`\r\n\tLineage             *LineagePart    `json:\"lineage,omitempty\"`\r\n\tOverallReproducible bool            `json:\"overall_reproducible\"`\r\n\tIssues              []string        `json:\"issues\"`\r\n"]
[3670.045286, "o", "}\r\n\r\nfunc Generate(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {\r\n\tissues := []string{}\r\n\trep := &Report{\r\n\t\tReportVersion: \"1.0\",\r\n\t\tTimestamp:     time.Now().Format(time.RFC3339),\r\n\t\tIssues:        issues,\r\n\t}\r\n\r\n\tman := manifest.Validate(manifestPath)\r\n\trep.Manifest = ManifestPart{\r\n\t\tValid:    man.Valid,\r\n\t\t"]
[3670.045406, "o", "Warnings: man.Warnings,\r\n\t\tErrors:   man.Errors,\r\n\t}\r\n\tif !man.Valid {\r\n\t\tissues = append(issues, fmt.Sprintf(\"Manifest validation failed: %s\", strings.Join(man.Errors, \"; \")))\r\n\t}\r\n\r\n\tcheckpointValid := true\r\n\tif checkpointPath != \"\" {\r\n\t\tcp, err := mlck.ParseFile(checkpointPath)\r\n\t\tif err != nil {\r\n\t\t\tcheckpointValid = false\r\n\t\t\trep.Checkpoint = &CheckpointPart{\r\n\t\t\t\tValid: false,\r\n\t\t\t\tError: err.Error(),\r\n\t\t\t}\r\n\t\t\tissues = append(issues, fmt.Sprintf(\"Checkpoint verification failed: %v\", err))\r\n\t\t} else {\r\n\t\t\trep.Checkpoint = &CheckpointPart{\r\n"]
[3670.045467, "o", "\t\t\t\tValid:        true,\r\n\t\t\t\tNumTensors:   len(cp.Tensors),\r\n\t\t\t\tFileChecksum: cp.FileChecksum,\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tcomparisonMatch := true\r\n\tif checkpointPath != \"\" && comparePath != \"\" {\r\n\t\tc1, err := mlck.ParseFile(checkpointPath)\r\n"]
[3670.045528, "o", "\t\tif err != nil {\r\n\t\t\tcomparisonMatch = false\r\n\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\tMatch: false,\r\n\t\t\t\tError: fmt.Sprintf(\"checkpoint parse failed: %v\", err),\r\n\t\t\t}\r\n\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\t\t} else {\r\n"]
[3670.045587, "o", "\t\t\tc2, err := mlck.ParseFile(comparePath)\r\n\t\t\tif err != nil {\r\n\t\t\t\tcomparisonMatch = false\r\n\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\t\tMatch: false,\r\n\t\t\t\t\tError: fmt.Sprintf(\"compare checkpoint parse failed: %v\", err),\r\n\t\t\t\t}\r\n"]
[3670.045643, "o", "\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\t\t\t} else {\r\n\t\t\t\tres, err := compare.Compare(c1, c2, \"strict\", 1e-7, 1e-5)\r\n\t\t\t\tif err != nil {\r\n\t\t\t\t\tcomparisonMatch = false\r\n\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\t\t\tMatch: false,\r\n"]
[3670.0457, "o", "\t\t\t\t\t\tError: err.Error(),\r\n\t\t\t\t\t}\r\n\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\t\t\t\t} else {\r\n\t\t\t\t\tdiffer := 0\r\n\t\t\t\t\ttotal := len(res.TensorResults)\r\n\t\t\t\t\tfor _, tr := range res.TensorResults {\r\n\t\t\t\t\t\tif !tr.Match {\r\n"]
[3670.04576, "o", "\t\t\t\t\t\t\tdiffer++\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\t\t\tMatch:   res.Match,\r\n\t\t\t\t\t\tSummary: fmt.Sprintf(\"%d/%d tensors differ\", differ, total),\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif !res.Match {\r\n"]
[3670.045819, "o", "\t\t\t\t\t\tcomparisonMatch = false\r\n\t\t\t\t\t\tif differ > 0 {\r\n\t\t\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Tensor comparison failed: %d tensors differ beyond tolerance\", differ))\r\n\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\tissues = append(issues, \"Tensor comparison failed: missing tensors or shape mismatch\")\r\n\t\t\t\t\t\t}\r\n"]
[3670.045884, "o", "\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[3670.045941, "o", "\r\n\tlineageValid := true\r\n\tif lineagePath != \"\" {\r\n\t\tlin := lineage.Audit(lineagePath)\r\n\t\tif lin.Valid {\r\n\t\t\trep.Lineage = &LineagePart{\r\n\t\t\t\tValid: true,\r\n\t\t\t\tDepth: lin.MaxDepth,\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t\tlineageValid = false\r\n\t\t\trep.Lineage = &LineagePart{\r\n\t"]
[3670.045999, "o", "\t\t\tValid: false,\r\n\t\t\t\tError: strings.Join(lin.Errors, \"; \"),\r\n\t\t\t}\r\n\t\t\tissues = append(issues, fmt.Sprintf(\"Lineage audit failed: %s\", strings.Join(lin.Errors, \"; \")))\r\n\t\t}\r\n\t}\r\n\r\n\toverall := man.Valid && checkpointValid && comparisonMatch && lineageValid\r\n"]
[3670.046065, "o", "\trep.OverallReproducible = overall\r\n\trep.Issues = issues\r\n\r\n\tif overall {\r\n\t\treturn rep, 0\r\n\t}\r\n\treturn rep, 1\r\n}\r\n"]
[3670.046541, "o", "\u001b[?2004h"]
