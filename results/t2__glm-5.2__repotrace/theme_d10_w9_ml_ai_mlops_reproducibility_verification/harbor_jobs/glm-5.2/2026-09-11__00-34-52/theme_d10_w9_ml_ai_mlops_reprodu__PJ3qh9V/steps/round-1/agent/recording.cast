[5588.332383, "o", "package app\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"strings\"\r\n\r\n"]
[5588.332496, "o", "\t\"repro-verify/internal/compare\"\r\n\t\"repro-verify/internal/drift\"\r\n\t\"repro-verify/internal/lineage\"\r\n\t\"repro-verify/internal/manifest\"\r\n\t\"repro-verify/internal/merge\"\r\n\t\"repro-verify/internal/mlck\"\r\n\t\"repro-verify/internal/report\"\r\n)\r\n\r\nfunc Run() int {\r\n\tif len(os.Args) < 2 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"no subcommand provided\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"verify-checkpoint\":\r\n\t\treturn runVerifyCheckpoint(os.Args[2:])\r\n\tcase \"compare-outputs\":\r\n\t\treturn runCompareOutputs(os.Args[2:])\r\n\tcase \"validate-manifest\":\r\n\t\treturn runValidateManifest(os.Args[2:])\r\n\tcase \"audit-lineage\":\r\n\t\treturn runAuditLineage(os.Args[2:])"]
[5588.332581, "o", "\r\n\tcase \"generate-report\":\r\n\t\treturn runGenerateReport(os.Args[2:])\r\n\tcase \"merge-checkpoints\":\r\n\t\treturn runMergeCheckpoints(os.Args[2:])\r\n\tcase \"drift-analysis\":\r\n\t\treturn runDriftAnalysis(os.Args[2:])\r\n\tdefault:\r\n\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"unknown subcommand: %s\", os.Args[1])})\r\n\t\treturn 1\r\n\t}\r\n}\r\n\r\nfunc runVerifyCheckpoint(args []string) int {\r\n\tif len(args) != 1 {\r\n"]
[5588.332645, "o", "\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify verify-checkpoint <file>\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tif _, err := os.ReadFile(args[0]); err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tcp, err := mlck.ParseFile(args[0])\r\n\t"]
[5588.332705, "o", "if err != nil {\r\n\t\toutputJSON(map[string]interface{}{\r\n\t\t\t\"valid\": false,\r\n\t\t\t\"error\": err.Error(),\r\n\t\t})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tmetadata := cp.Metadata\r\n\tif metadata == nil {\r\n\t"]
[5588.332765, "o", "\tmetadata = map[string]interface{}{}\r\n\t}\r\n\ttensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))\r\n\tfor _, t := range cp.Tensors {\r\n\t\ttensors = append(tensors, t.Info())\r\n\t}\r\n\r\n\toutputJSON(map[string]interface{}{\r\n\t\t\"valid\":          true,\r\n\t\t\"format_version\": int(cp.Version),\r\n\t\t\"num_tensors\":    len(cp.Tensors),\r\n"]
[5588.33283, "o", "\t\t\"metadata\":       metadata,\r\n\t\t\"tensors\":        tensors,\r\n\t\t\"file_checksum\":  cp.FileChecksum,\r\n\t})\r\n\treturn 0\r\n}\r\n\r\nfunc runCompareOutputs(args []string) int {\r\n\tfs := flag.NewFlagSet(\"compare-outputs\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tatol := fs.Float64(\"atol\", 1e-7, \"absolute tolerance\")\r\n\trtol := fs.Float64(\"rtol\", 1e-5, \"relative tolerance\")\r\n"]
[5588.332889, "o", "\tmode := fs.String(\"mode\", \"strict\", \"comparison mode\")\r\n\thistogram := fs.Bool(\"histogram\", false, \"include diff histograms\")\r\n\r\n\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tif len(pos) != 2 {\r\n"]
[5588.332946, "o", "\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify compare-outputs <file1> <file2> [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tc1, err := mlck.ParseFile(pos[0])\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"file1: %v\", err)})\r\n\t\treturn 1\r\n\t}\r\n\r\n"]
[5588.333004, "o", "\tc2, err := mlck.ParseFile(pos[1])\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"file2: %v\", err)})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tres, err := compare.Compare(c1, c2, *mode, *atol, *rtol, *histogram)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t"]
[5588.33306, "o", "\treturn 1\r\n\t}\r\n\r\n\toutputJSON(res)\r\n\tif res.Match {\r\n\t\treturn 0\r\n\t}\r\n\treturn 1\r\n}\r\n\r\nfunc runValidateManifest(args []string) int {\r\n"]
[5588.333117, "o", "\tif len(args) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify validate-manifest <file.toml>\"})\r\n\t\treturn 1\r\n\t}\r\n\tif _, err := os.ReadFile(args[0]); err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tres := manifest.Validate(args[0])\r\n"]
[5588.333177, "o", "\toutputJSON(res)\r\n\tif res.Valid {\r\n\t\treturn 0\r\n\t}\r\n\treturn 1\r\n}\r\n\r\nfunc runAuditLineage(args []string) int {\r\n\tif len(args) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify audit-lineage <file.json>\"})\r\n\t\treturn 1\r\n\t}"]
[5588.333252, "o", "\r\n\tif _, err := os.ReadFile(args[0]); err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tres := lineage.Audit(args[0])\r\n\toutputJSON(res)\r\n\tif res.Valid {\r\n\t\treturn 0\r\n\t}\r\n\treturn 1\r\n"]
[5588.333312, "o", "}\r\n\r\nfunc runGenerateReport(args []string) int {\r\n\tfs := flag.NewFlagSet(\"generate-report\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tcheckpoint := fs.String(\"checkpoint\", \"\", \"checkpoint file to verify\")\r\n\tcomparePath := fs.String(\"compare\", \"\", \"second checkpoint to compare\")\r\n"]
[5588.333374, "o", "\tlineagePath := fs.String(\"lineage\", \"\", \"lineage file to audit\")\r\n\r\n\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tif len(pos) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify generate-report <manifest.toml> [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n"]
[5588.33343, "o", "\r\n\tfor _, p := range []string{pos[0], *checkpoint, *comparePath, *lineagePath} {\r\n\t\tif p == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif _, err := os.ReadFile(p); err != nil {\r\n\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\t\treturn 1\r\n"]
[5588.333487, "o", "\t\t}\r\n\t}\r\n\r\n"]
[5588.333953, "o", "\u001b[?2004h"]
[5588.334008, "o", "root@n30009:/app# "]
[5588.619774, "i", "sed -n '1,180p' internal/report/report.go\n"]
