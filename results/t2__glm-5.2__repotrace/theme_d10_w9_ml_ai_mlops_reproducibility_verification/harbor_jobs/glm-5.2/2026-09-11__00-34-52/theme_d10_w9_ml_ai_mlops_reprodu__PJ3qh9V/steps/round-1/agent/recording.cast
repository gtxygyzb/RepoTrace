[731.61568, "i", "cat > internal/compare/compare.go <<'EOF'\npackage compare\n\nimport (\n    \"fmt\"\n    \"math\"\n\n    \"repro-verify/internal/mlck\"\n)\n\ntype TensorResult struct {\n    Name string `json:\"name\"`\n    Match bool `json:\"match\"`\n    MaxAbsDiff float64 `json:\"max_abs_diff\"`\n    MaxRelDiff float64 `json:\"max_rel_diff\"`\n    NumMismatches int `json:\"num_mismatches\"`\n    TotalElements int `json:\"total_elements\"`\n}\n\ntype Result struct {\n    Match bool `json:\"match\"`\n    Mode string `json:\"mode\"`\n    Atol float64 `json:\"atol\"`\n    Rtol float64 `json:\"rtol\"`\n    TensorResults []TensorResult `json:\"tensor_results\"`\n    MissingInFile1 []string `json:\"missing_in_file1\"`\n    MissingInFile2 []string `json:\"missing_in_file2\"`\n    Error string `json:\"error,omitempty\"`\n}\n\nfunc Compare(c1, c2 *mlck.Checkpoint, mode string, atol, rtol float64) (*Result, error) {\n    if mode != \"strict\" && mode != \"relaxed\" {\n        return nil, fmt.Errorf(\"invalid mode %q\", mode)\n    }\n\n    result := &Result{\n        Match: true,\n        Mode: mode,\n        A"]
[731.615766, "i", "tol: atol,\n        Rtol: rtol,\n        TensorResults: []TensorResult{},\n        MissingInFile1: []string{},\n        MissingInFile2: []string{},\n    }\n\n    map2 := make(map[string]mlck.Tensor)\n    for _, t := range c2.Tensors {\n        map2[t.Name] = t\n    }\n    map1 := make(map[string]mlck.Tensor)\n    for _, t := range c1.Tensors {\n        map1[t.Name] = t\n    }\n\n    for _, t1 := range c1.Tensors {\n        t2, ok := map2[t1.Name]\n        if !ok {\n            result.MissingInFile2 = append(result.MissingInFile2, t1.Name)\n            continue\n        }\n        tr := compareTensors(t1, t2, mode, atol, rtol)\n        result.TensorResults = append(result.TensorResults, tr)\n        if !tr.Match {\n            result.Match = false\n        }\n    }\n\n    for _, t := range c2.Tensors {\n        if _, ok := map1[t.Name]; !ok {\n            result.MissingInFile1 = append(result.MissingInFile1, t.Name)\n        }\n    }\n\n    if len(result.MissingInFile1) > 0 || len(result.MissingInFile2) > 0 {\n        result.Match = false\n    }\n"]
[731.616037, "i", "\n    return result, nil\n}\n\nfunc compareTensors(t1, t2 mlck.Tensor, mode string, atol, rtol float64) TensorResult {\n    total := int(mlck.Product(t1.Shape))\n    tr := TensorResult{\n        Name: t1.Name,\n        Match: true,\n        MaxAbsDiff: 0,\n        MaxRelDiff: 0,\n        NumMismatches: 0,\n        TotalElements: total,\n    }\n\n    if !shapesEqual(t1.Shape, t2.Shape) {\n        tr.Match = false\n        tr.NumMismatches = total\n        return tr\n    }\n\n    if total == 0 {\n        return tr\n    }\n\n    vals1, err := t1.Float64Values()\n    if err != nil {\n        tr.Match = false\n        tr.NumMismatches = total\n        return tr\n    }\n    vals2, err := t2.Float64Values()\n    if err != nil {\n        tr.Match = false\n        tr.NumMismatches = total\n        return tr\n    }\n\n    threshold := int(math.Floor(float64(total) * 0.001))\n    for i := 0; i < total; i++ {\n        a := vals1[i]\n        b := vals2[i]\n        diff := math.Abs(a - b)\n        if diff > tr.MaxAbsDiff {\n            tr.MaxAbsDiff = diff\n        }"]
[731.616113, "o", "cat > internal/compare/compare.go <<'EOF'\r\n\u001b[?2004l\r"]
[731.616191, "i", "\n        var rel float64\n        if math.Abs(b) > 0 {\n            rel = diff / math.Abs(b)\n        } else if diff > 0 {\n            rel = diff\n        }\n        if rel > tr.MaxRelDiff {\n            tr.MaxRelDiff = rel\n        }\n        if diff > atol+rtol*math.Abs(b) {\n            tr.NumMismatches++\n        }\n    }\n\n    switch mode {\n    case \"strict\":\n        tr.Match = tr.NumMismatches == 0\n    case \"relaxed\":\n        tr.Match = tr.NumMismatches <= threshold\n    }\n\n    return tr\n}\n\nfunc shapesEqual(a, b []uint32) bool {\n    if len(a) != len(b) {\n        return false\n    }\n    for i := range a {\n        if a[i] != b[i] {\n            return false\n        }\n    }\n    return true\n}\nEOF\n"]
