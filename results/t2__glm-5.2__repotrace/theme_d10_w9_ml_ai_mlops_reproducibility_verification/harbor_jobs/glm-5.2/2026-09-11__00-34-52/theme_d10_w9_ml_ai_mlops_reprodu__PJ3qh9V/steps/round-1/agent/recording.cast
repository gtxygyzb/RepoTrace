[1768.678846, "o", "\u001b[32m\u001b[K1\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCMD:\u001b[m\u001b[K verify-checkpoint /tmp/cp1.bin\r\n"]
[1768.678926, "o", "\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KEXIT:\u001b[m\u001b[K 0\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCMD:\u001b[m\u001b[K verify-checkpoint /tmp/bad.bin\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KEXIT:\u001b[m\u001b[K 1\r\n\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCMD:\u001b[m\u001b[K compare-outputs /tmp/cp1.bin /tmp/cp2.bin --mode strict\r\n"]
[1768.678997, "o", "\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KEXIT:\u001b[m\u001b[K 0\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCMD:\u001b[m\u001b[K compare-outputs /tmp/cp1.bin /tmp/cp3.bin --mode strict\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KEXIT:\u001b[m\u001b[K 1\r\n\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCMD:\u001b[m\u001b[K validate-manifest /tmp/manifest.toml\r\n\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KEXIT:\u001b[m\u001b[K 0\r\n\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCMD:\u001b[m\u001b[K validate-manifest /tmp/badmanifest.toml\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KEXIT:\u001b[m\u001b[K 1\r\n\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCMD:\u001b[m\u001b[K audit-lineage /tmp/lineage.json\r\n"]
[1768.679067, "o", "\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KEXIT:\u001b[m\u001b[K 0\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCMD:\u001b[m\u001b[K audit-lineage /tmp/badlineage.json\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KEXIT:\u001b[m\u001b[K 1\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCMD:\u001b[m\u001b[K merge-checkpoints /tmp/merged.bin /tmp/cp1.bin /tmp/cp3.bin --conflict first\r\n\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KEXIT:\u001b[m\u001b[K 0\r\n\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCMD:\u001b[m\u001b[K verify-checkpoint /tmp/merged.bin\r\n"]
[1768.679179, "o", "\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KEXIT:\u001b[m\u001b[K 0\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCMD:\u001b[m\u001b[K drift-analysis /tmp/d1.bin /tmp/d2.bin /tmp/d3.bin\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KEXIT:\u001b[m\u001b[K 0\r\n\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KCMD:\u001b[m\u001b[K generate-report /tmp/manifest.toml --checkpoint /tmp/cp1.bin --compare /tmp/cp2.bin --lineage /tmp/lineage.json\r\n\u001b[32m\u001b[K282\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KEXIT:\u001b[m\u001b[K 0\r\n"]
