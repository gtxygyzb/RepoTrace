[3662.161849, "o", "find . -type f -name '*.go' | sort\r\n\u001b[?2004l\r"]
[3662.166116, "o", "./cmd/repro-verify/main.go\r\n./internal/app/app.go\r\n./internal/compare/compare.go\r\n./internal/drift/drift.go\r\n./internal/lineage/lineage.go\r\n./internal/manifest/manifest.go\r\n./internal/merge/merge.go"]
[3662.166182, "o", "\r\n./internal/mlck/checkpoint.go\r\n./internal/report/report.go\r\n./main.go\r\n"]
[3662.166614, "o", "\u001b[?2004h"]
