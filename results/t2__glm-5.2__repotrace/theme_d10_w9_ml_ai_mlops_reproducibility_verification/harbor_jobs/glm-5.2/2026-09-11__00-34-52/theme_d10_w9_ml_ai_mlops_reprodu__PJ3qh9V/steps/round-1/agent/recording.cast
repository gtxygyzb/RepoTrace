[527.24943, "o", "func Product(shape []uint32) int64 {\r\n\u001b[?2004l\r"]
[527.249482, "o", "\u001b[?2004h> "]
[527.249606, "o", "    p := int64(1)\r\n\u001b[?2004l\r"]
[527.24966, "o", "\u001b[?2004h> "]
[527.249866, "o", "    for _, s := range shape {\r\n\u001b[?2004l\r"]
[527.249919, "o", "\u001b[?2004h> "]
