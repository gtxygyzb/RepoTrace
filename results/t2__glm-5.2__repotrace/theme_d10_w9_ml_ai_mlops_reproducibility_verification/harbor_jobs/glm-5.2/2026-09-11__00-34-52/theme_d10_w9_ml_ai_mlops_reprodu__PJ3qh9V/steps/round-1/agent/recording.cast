[3772.600108, "o", "   103\t\t\tmax := maxFloat64(steps)\r\n   104\t\t\tconvergence := classifyConvergence(steps)\r\n   105\t\t\tstability := 1.0\r\n   106\t\t\tif steps[0] != 0 {\r\n   107\t\t\t\tstability = 1.0 - steps[len(steps)-1]/steps[0]\r\n   108\t\t\t\tif stability < 0 {\r\n   109\t\t\t\t\tstability = 0\r\n   110\t\t\t\t} else if stability > 1 {\r\n   111\t\t\t\t\tstability = 1\r\n"]
[3772.600179, "o", "   112\t\t\t\t}\r\n   113\t\t\t}\r\n   114\t\r\n   115\t\t\ttensors = append(tensors, TensorResult{\r\n   116\t\t\t\tName:           name,\r\n   117\t\t\t\tStepChanges:    steps,\r\n"]
[3772.600255, "o", "   118\t\t\t\tMeanChange:     mean,\r\n   119\t\t\t\tMaxChange:      max,\r\n   120\t\t\t\tConvergence:    convergence,\r\n   121\t\t\t\tStabilityScore: stability,\r\n   122\t\t\t})\r\n   123\t\r\n   124\t\t\tif convergence == \"converging\" {\r\n"]
[3772.60034, "o", "   125\t\t\t\tconverging++\r\n   126\t\t\t} else if convergence == \"diverging\" {\r\n   127\t\t\t\tdiverging++\r\n   128\t\t\t}\r\n   129\t\t}\r\n   130\t\r\n   131\t\toverall := \"mixed\"\r\n"]
[3772.600398, "o", "   132\t\tif converging > len(tensors)/2 {\r\n   133\t\t\toverall = \"converging\"\r\n   134\t\t} else if diverging > len(tensors)/2 {\r\n   135\t\t\toverall = \"diverging\"\r\n"]
