[5572.229078, "o", "     1\tpackage app\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n"]
[5572.229156, "o", "     5\t\t\"flag\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"io\"\r\n     8\t\t\"os\"\r\n     9\t\t\"strings\"\r\n    10\t\r\n    11\t\t\"repro-verify/internal/compare\"\r\n    12\t\t\"repro-verify/internal/drift\"\r\n    13\t\t\"repro-verify/internal/lineage\"\r\n    14\t\t\"repro-verify/internal/manifest\"\r\n    15\t\t\"repro-verify/internal/merge\"\r\n    16\t\t\"repro-verify/internal/mlck\"\r\n    17"]
[5572.229255, "o", "\t\t\"repro-verify/internal/report\"\r\n    18\t)\r\n    19\t\r\n    20\tfunc Run() int {\r\n    21\t\tif len(os.Args) < 2 {\r\n    22\t\t\toutputJSON(map[string]interface{}{\"error\": \"no subcommand provided\"})\r\n    23\t\t\treturn 1\r\n    24\t\t}\r\n    25\t\r\n    26\t\tswitch os.Args[1] {\r\n    27\t\tcase \"verify-checkpoint\":\r\n"]
[5572.229318, "o", "    28\t\t\treturn runVerifyCheckpoint(os.Args[2:])\r\n    29\t\tcase \"compare-outputs\":\r\n    30\t\t\treturn runCompareOutputs(os.Args[2:])\r\n    31\t\tcase \"validate-manifest\":\r\n    32\t\t\treturn runValidateManifest(os.Args[2:])\r\n    33\t\tcase \"audit-lineage\":\r\n    34\t\t\treturn runAuditLineage(os.Args[2:])\r\n    35\t\tcase \"generate-report\":\r\n    36\t\t\treturn runGenerateReport(os.Args[2:])\r\n"]
[5572.229376, "o", "    37\t\tcase \"merge-checkpoints\":\r\n    38\t\t\treturn runMergeCheckpoints(os.Args[2:])\r\n    39\t\tcase \"drift-analysis\":\r\n    40\t\t\treturn runDriftAnalysis(os.Args[2:])\r\n    41\t\tdefault:\r\n    42\t\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"unknown subcommand: %s\", os.Args[1])})\r\n    43\t\t\treturn 1\r\n    44\t\t}\r\n"]
[5572.229436, "o", "    45\t}\r\n    46\t\r\n    47\tfunc runVerifyCheckpoint(args []string) int {\r\n    48\t\tif len(args) != 1 {\r\n    49\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify verify-checkpoint <file>\"})\r\n    50\t\t\treturn 1\r\n    51\t\t}\r\n    52"]
[5572.229497, "o", "\t\r\n    53\t\tif _, err := os.ReadFile(args[0]); err != nil {\r\n    54\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n    55\t\t\treturn 1\r\n    56\t\t}\r\n    57\t\r\n    58\t\tcp, err := mlck.ParseFile(args[0])\r\n    59\t\tif err != nil {\r\n    60\t\t\toutputJSON(map[string]interface{}{\r\n"]
[5572.229554, "o", "    61\t\t\t\t\"valid\": false,\r\n    62\t\t\t\t\"error\": err.Error(),\r\n    63\t\t\t})\r\n    64\t\t\treturn 1\r\n    65\t\t}\r\n    66\t\r\n    67\t\tmetadata := cp.Metadata\r\n    68\t\tif metadata == nil {\r\n    69\t\t"]
[5572.229616, "o", "\tmetadata = map[string]interface{}{}\r\n    70\t\t}\r\n    71\t\ttensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))\r\n    72\t\tfor _, t := range cp.Tensors {\r\n    73\t\t\ttensors = append(tensors, t.Info())\r\n    74\t\t}\r\n    75\t\r\n    76\t\toutputJSON(map[string]interface{}{\r\n    77\t"]
[5572.229679, "o", "\t\t\"valid\":          true,\r\n    78\t\t\t\"format_version\": int(cp.Version),\r\n    79\t\t\t\"num_tensors\":    len(cp.Tensors),\r\n    80\t\t\t\"metadata\":       metadata,\r\n    81\t\t\t\"tensors\":        tensors,\r\n    82\t\t\t\"file_checksum\":  cp.FileChecksum,\r\n    83\t\t})\r\n    84\t\treturn 0\r\n    85\t}\r\n    86\t\r\n    87\t"]
[5572.229742, "o", "func runCompareOutputs(args []string) int {\r\n    88\t\tfs := flag.NewFlagSet(\"compare-outputs\", flag.ContinueOnError)\r\n    89\t\tfs.SetOutput(io.Discard)\r\n    90\t\tatol := fs.Float64(\"atol\", 1e-7, \"absolute tolerance\")\r\n    91\t\t"]
[5572.2298, "o", "rtol := fs.Float64(\"rtol\", 1e-5, \"relative tolerance\")\r\n    92\t\tmode := fs.String(\"mode\", \"strict\", \"comparison mode\")\r\n    93\t\thistogram := fs.Bool(\"histogram\", false, \"include diff histograms\")\r\n    94\t\r\n    95\t\tpos, err := parseMixedArgs(fs, args)\r\n    96\t\tif err != nil {\r\n    97\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n    98\t\t\treturn 1\r\n    99\t\t}\r\n   100\t\tif len(pos) != 2 {\r\n   101\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify compare-outputs <file1> <file2> [flags]\"})\r\n"]
[5572.229862, "o", "   102\t\t\treturn 1\r\n   103\t\t}\r\n   104\t\r\n   105\t\tc1, err := mlck.ParseFile(pos[0])\r\n   106\t\tif err != nil {\r\n   107\t\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"file1: %v\", err)})\r\n   108\t\t\treturn 1\r\n   109\t\t}\r\n   110\t\r\n   111\t\tc2, err := mlck.ParseFile(pos[1])\r\n"]
[5572.229922, "o", "   112\t\tif err != nil {\r\n   113\t\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"file2: %v\", err)})\r\n   114\t\t\treturn 1\r\n   115\t\t}\r\n   116\t\r\n   117\t\tres, err := compare.Compare(c1, c2, *mode, *atol, *rtol, *histogram)\r\n   118\t\tif err != nil {\r\n   119\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   120\t\t\treturn 1\r\n"]
[5572.229988, "o", "   121\t\t}\r\n   122\t\r\n   123\t\toutputJSON(res)\r\n   124\t\tif res.Match {\r\n"]
[5572.23005, "o", "   125\t\t\treturn 0\r\n   126\t\t}\r\n   127\t\treturn 1\r\n   128\t}\r\n   129\t\r\n   130\tfunc runValidateManifest(args []string) int {\r\n   131\t\tif len(args) != 1 {\r\n   132\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify validate-manifest <file.toml>\"})\r\n   133\t\t\treturn 1\r\n   134\t\t}\r\n"]
[5572.230115, "o", "   135\t\tif _, err := os.ReadFile(args[0]); err != nil {\r\n   136\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   137\t\t\treturn 1\r\n   138\t\t}\r\n   139\t\tres := manifest.Validate(args[0])\r\n   140\t\toutputJSON(res)\r\n   141\t\tif res.Valid {\r\n   142\t\t\treturn 0\r\n   143\t\t}\r\n   144\t\treturn 1\r\n   145\t}\r\n"]
[5572.230182, "o", "   146\t\r\n   147\tfunc runAuditLineage(args []string) int {\r\n   148\t\tif len(args) != 1 {\r\n   149\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify audit-lineage <file.json>\"})\r\n   150\t\t\treturn 1\r\n   151\t\t}\r\n   152\t\tif _, err := os.ReadFile(args[0]); err != nil {\r\n   153\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   154\t\t\treturn 1\r\n   155\t\t}\r\n   156\t\tres := lineage.Audit(args[0])\r\n"]
[5572.230255, "o", "   157\t\toutputJSON(res)\r\n   158\t\tif res.Valid {\r\n   159\t\t\treturn 0\r\n   160\t\t}\r\n   161\t\treturn 1\r\n   162\t}\r\n   163\t\r\n   164\tfunc runGenerateReport(args []string) int {\r\n   165\t\tfs := flag.NewFlagSet(\"generate-report\", flag.ContinueOnError)\r\n   166\t\tfs.SetOutput(io.Discard)\r\n"]
[5572.230314, "o", "   167\t\tcheckpoint := fs.String(\"checkpoint\", \"\", \"checkpoint file to verify\")\r\n   168\t\tcomparePath := fs.String(\"compare\", \"\", \"second checkpoint to compare\")\r\n   169\t\tlineagePath := fs.String(\"lineage\", \"\", \"lineage file to audit\")\r\n   170\t\r\n   171\t\tpos, err := parseMixedArgs(fs, args)\r\n   172\t\tif err != nil {\r\n   173\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   174\t\t\treturn 1\r\n"]
[5572.230375, "o", "   175\t\t}\r\n   176\t\tif len(pos) != 1 {\r\n   177\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify generate-report <manifest.toml> [flags]\"})\r\n   178\t\t\treturn 1\r\n   179\t\t}\r\n   180\t\r\n   181\t\tfor _, p := range []string{pos[0], *checkpoint, *comparePath, *lineagePath} {\r\n   182\t\t\tif p == \"\" {\r\n"]
[5572.230431, "o", "   183\t\t\t\tcontinue\r\n   184\t\t\t}\r\n   185\t\t\tif _, err := os.ReadFile(p); err != nil {\r\n   186\t\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   187\t\t\t\treturn 1\r\n   188\t\t\t}\r\n   189\t\t}\r\n   190\t\r\n   191\t"]
[5572.230507, "o", "\trep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)\r\n   192\t\toutputJSON(rep)\r\n   193\t\treturn code\r\n   194\t}\r\n   195\t\r\n   196\tfunc runMergeCheckpoints(args []string) int {\r\n   197\t\tfs := flag.NewFlagSet(\"merge-checkpoints\", flag.ContinueOnError)\r\n   198\t\tfs.SetOutput(io.Discard)\r\n   199\t\tconflict := fs.String(\"conflict\", \"first\", \"conflict strategy\")\r\n   200\t\r\n   201\t\tpos, err := parseMixedArgs(fs, args)\r\n   202\t\tif err != nil {\r\n   203\t\t"]
[5572.23057, "o", "\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   204\t\t\treturn 1\r\n   205\t\t}\r\n   206\t\tif len(pos) < 3 {\r\n   207\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]\"})\r\n   208\t\t\treturn 1\r\n   209\t\t}\r\n   210\t\r\n   211\t\tres, err := merge.Merge(pos[0], pos[1:], *conflict)\r\n"]
[5572.230629, "o", "   212\t\tif err != nil {\r\n   213\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   214\t\t\treturn 1\r\n   215\t\t}\r\n   216\t\toutputJSON(res)\r\n   217\t\treturn 0\r\n   218\t}\r\n   219\t\r\n   220\tfunc runDriftAnalysis(args []string) int {\r\n"]
[5572.230687, "o", "   221\t\tfs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\r\n   222\t\tfs.SetOutput(io.Discard)\r\n   223\t\r\n   224\t\ttopK := fs.Int(\"top-k\", 0, \"number of tensors with the lowest stability scores to include\")\r\n   225\t\tthreshold := fs.Float64(\"threshold\", 0, \"max change threshold above which a tensor is considered drifting\")\r\n   226\t\r\n   227\t\tpos, err := parseMixedArgs(fs, args)\r\n   228\t\tif err != nil {\r\n"]
[5572.230755, "o", "   229\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   230\t\t\treturn 1\r\n   231\t\t}\r\n   232\t\tif len(pos) < 2 {\r\n   233\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\r\n   234\t\t\treturn 1\r\n   235\t\t}\r\n"]
[5572.230822, "o", "   236\t\r\n   237\t\tvar topKPtr *int\r\n   238\t\tvar thresholdPtr *float64\r\n   239\t\tfs.Visit(func(f *flag.Flag) {\r\n   240\t\t\tif f.Name == \"top-k\" {\r\n   241\t\t\t\tv := *topK\r\n   242\t\t\t\ttopKPtr = &v\r\n   243\t\t\t}\r\n   244\t\t\tif f.Name == \"threshold\" {\r\n"]
[5572.230885, "o", "   245\t\t\t\tv := *threshold\r\n   246\t\t\t\tthresholdPtr = &v\r\n   247\t\t\t}\r\n   248\t\t})\r\n   249\t\tif topKPtr != nil && *topKPtr < 0 {\r\n   250\t\t\toutputJSON(map[string]interface{}{\"error\": \"--top-k must be non-negative\"})\r\n   251\t\t\treturn 1\r\n   252\t\t}\r\n   253\t\r\n   254\t"]
[5572.230946, "o", "\tres, err := drift.AnalyzeWithTopK(pos, topKPtr, thresholdPtr)\r\n   255\t\tif err != nil {\r\n   256\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   257\t\t\treturn 1\r\n   258\t\t}\r\n   259\t\toutputJSON(res)\r\n   260\t\treturn 0\r\n"]
