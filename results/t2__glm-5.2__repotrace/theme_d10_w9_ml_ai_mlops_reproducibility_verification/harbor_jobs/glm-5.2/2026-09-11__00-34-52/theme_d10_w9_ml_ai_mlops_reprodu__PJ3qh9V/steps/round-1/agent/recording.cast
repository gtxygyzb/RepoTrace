[5571.949687, "o", "\t\t\troots = append(roots, e.ID)\r\n   150\t\t\t}\r\n   151\t\t\tif len(children[e.ID]) == 0 {\r\n   152\t\t\t\tleaves = append(leaves, e.ID)\r\n   153\t\t\t}\r\n   154\t\t}\r\n   155\t\r\n   156\t\tvisited := make(map[string]bool)\r\n   157\t\tvar post []string\r\n   158\t\tvar dfs func(id string)\r\n   159"]
[5571.94973, "o", "\t\tdfs = func(id string) {\r\n   160\t\t\tvisited[id] = true\r\n   161\t\t\tfor _, child := range children[id] {\r\n   162\t\t\t\tif !visited[child] {\r\n   163\t\t\t\t\tdfs(child)\r\n"]
[5571.949813, "o", "   164\t\t\t\t}\r\n   165\t\t\t}\r\n   166\t\t\tpost = append(post, id)\r\n   167\t\t}\r\n   168\t\tfor _, e := range exps {\r\n   169\t\t\tif !visited[e.ID] {\r\n   170\t\t\t\tdfs(e.ID)\r\n   171\t\t\t}\r\n   172\t\t}\r\n   173\t\ttopo := make([]string, len(post))\r\n   174\t\tfor i := range post {\r\n   175\t\t\ttopo[i] = post[len(post)-1-i]\r\n   176\t\t}\r\n"]
[5571.94987, "o", "   177\t\r\n   178\t\tmaxDepth := 0\r\n   179\t\tvar depthDFS func(id string, depth int)\r\n   180\t\tdepthDFS = func(id string, depth int) {\r\n   181\t\t\tif depth > maxDepth {\r\n   182\t\t\t\tmaxDepth = depth\r\n   183\t\t\t}\r\n   184\t\t\tfor _, child := range children[id] {\r\n"]
[5571.949926, "o", "   185\t\t\t\tdepthDFS(child, depth+1)\r\n   186\t\t\t}\r\n   187\t\t}\r\n   188\t\tfor _, r := range roots {\r\n   189\t\t\tdepthDFS(r, 1)\r\n   190\t\t}\r\n   191\t\r\n   192\t\tresult.NumExperiments = len(exps)\r\n"]
[5571.949986, "o", "   193\t\tresult.NumRoots = len(roots)\r\n   194\t\tresult.NumLeaves = len(leaves)\r\n   195\t\tresult.MaxDepth = maxDepth\r\n   196\t\tresult.TopologicalOrder = topo\r\n   197\t\treturn result\r\n   198\t}\r\n   199\t\r\n"]
[5571.950044, "o", "   200\tfunc detectCycle(exps []Experiment) []string {\r\n   201\t\tadj := make(map[string][]string)\r\n   202\t\tfor _, e := range exps {\r\n   203\t\t\tfor _, p := range e.Parents {\r\n   204\t\t\t\tadj[p] = append(adj[p], e.ID)\r\n   205\t\t\t}\r\n   206\t\t}\r\n   207\t\r\n   208\t\tstate := make(map[string]int)\r\n   209\t\tvar stack []string\r\n"]
[5571.950107, "o", "   210\t\tvar cycle []string\r\n   211\t\r\n   212\t\tvar dfs func(id string) bool\r\n   213\t\tdfs = func(id string) bool {\r\n   214\t\t\tstate[id] = 1\r\n   215\t\t\tstack = append(stack, id)\r\n   216\t\t\tfor _, child := range adj[id] {\r\n   217\t\t\t\tif state[child] == 1 {\r\n"]
[5571.950163, "o", "   218\t\t\t\t\tidx := -1\r\n   219\t\t\t\t\tfor i := len(stack) - 1; i >= 0; i-- {\r\n   220\t\t\t\t\t\tif stack[i] == child {\r\n   221\t\t\t\t\t\t\tidx = i\r\n   222\t\t\t\t\t\t\tbreak\r\n   223\t\t\t\t\t\t}\r\n"]
[5571.950219, "o", "   224\t\t\t\t\t}\r\n   225\t\t\t\t\tif idx >= 0 {\r\n   226\t\t\t\t\t\tcycle = append([]string{}, stack[idx:]...)\r\n   227\t\t\t\t\t\treturn true\r\n   228\t\t\t\t\t}\r\n   229\t\t\t\t}\r\n   230\t\t\t\tif state[child] == 0 {\r\n   231\t\t\t"]
[5571.950295, "o", "\t\tif dfs(child) {\r\n   232\t\t\t\t\t\treturn true\r\n   233\t\t\t\t\t}\r\n   234\t\t\t\t}\r\n   235\t\t\t}\r\n"]
[5571.950353, "o", "   236\t\t\tstack = stack[:len(stack)-1]\r\n   237\t\t\tstate[id] = 2\r\n   238\t\t\treturn false\r\n   239\t\t}\r\n   240\t\r\n"]
