[4743.552701, "o", "   175\tfunc meanFloat64(xs []float64) float64 {\r\n   176\t\tif len(xs) == 0 {\r\n   177\t\t\treturn 0\r\n   178\t\t}\r\n   179\t\tvar sum float64\r\n   180\t\tfor _, x := range xs {\r\n   181\t\t\tsum += x\r\n   182\t\t}\r\n   183\t\treturn sum / float64(len(xs))\r\n   184\t"]
[4743.552774, "o", "}\r\n   185\t\r\n   186\tfunc maxFloat64(xs []float64) float64 {\r\n   187\t\tif len(xs) == 0 {\r\n   188\t\t\treturn 0\r\n   189\t\t}\r\n   190\t\tm := xs[0]\r\n   191\t\tfor _, x := range xs[1:] {\r\n   192\t\t\tif x > m {\r\n   193\t\t\t\tm = x\r\n   194\t\t\t}\r\n"]
[4743.552847, "o", "   195\t\t}\r\n   196\t\treturn m\r\n   197\t}\r\n   198\t\r\n   199\tfunc classifyConvergence(steps []float64) string {\r\n   200\t\tif len(steps) <= 1 {\r\n   201\t\t\treturn \"converging\"\r\n   202\t\t}\r\n   203\t\tdecreasing := true\r\n   204\t"]
[4743.552922, "o", "\tincreasing := true\r\n   205\t\tfor i := 1; i < len(steps); i++ {\r\n   206\t\t\tif steps[i] >= steps[i-1] {\r\n   207\t\t\t\tdecreasing = false\r\n   208\t\t\t}\r\n   209\t\t\tif steps[i] <= steps[i-1] {\r\n   210\t\t\t\tincreasing = false\r\n   211\t\t\t}\r\n   212\t\t}\r\n   213\t\tif decreasing {\r\n   214\t\t\treturn \"converging\"\r\n   215"]
