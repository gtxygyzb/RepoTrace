[5860.313074, "o", "\t\tif stability < 0 {\r\n   125\t\t\t\t\tstability = 0\r\n   126\t\t\t\t} else if stability > 1 {\r\n   127\t\t\t\t\tstability = 1\r\n   128\t\t\t\t}\r\n"]
