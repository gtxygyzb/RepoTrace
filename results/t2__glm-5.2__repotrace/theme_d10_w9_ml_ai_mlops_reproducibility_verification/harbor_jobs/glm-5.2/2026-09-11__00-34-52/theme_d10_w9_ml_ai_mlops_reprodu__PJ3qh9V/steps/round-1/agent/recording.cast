[1652.434129, "o", "\u001b[?2004h> "]
[1652.434354, "o", "    Match bool `json:\"match\"`\r\n\u001b[?2004l\r"]
[1652.434411, "o", "\u001b[?2004h> "]
[1652.434718, "o", "    Summary string `json:\"summary,omitempty\"`\r\n\u001b[?2004l\r"]
[1652.434772, "o", "\u001b[?2004h> "]
[1652.435056, "o", "    Error string `json:\"error,omitempty\"`\r\n\u001b[?2004l\r"]
[1652.435122, "o", "\u001b[?2004h> "]
[1652.435176, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1652.435234, "o", "\u001b[?2004h"]
[1652.43531, "o", "> "]
[1652.43543, "o", "type LineagePart struct {\r\n\u001b[?2004l\r"]
[1652.435485, "o", "\u001b[?2004h> "]
[1652.435692, "o", "    Valid bool `json:\"valid\"`\r\n\u001b[?2004l\r"]
[1652.435755, "o", "\u001b[?2004h> "]
[1652.435951, "o", "    Depth int `json:\"depth\"`\r\n\u001b[?2004l\r"]
[1652.436012, "o", "\u001b[?2004h> "]
[1652.436306, "o", "    Error string `json:\"error,omitempty\"`\r\n\u001b[?2004l\r"]
[1652.436363, "o", "\u001b[?2004h> }\r\n"]
[1652.436419, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1652.436474, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.43653, "o", "> "]
[1652.436652, "o", "type Report struct {\r\n\u001b[?2004l\r"]
[1652.436713, "o", "\u001b[?2004h> "]
[1652.437045, "o", "    ReportVersion string `json:\"report_version\"`\r\n\u001b[?2004l\r"]
[1652.437101, "o", "\u001b[?2004h> "]
[1652.437382, "o", "    Timestamp string `json:\"timestamp\"`\r\n\u001b[?2004l\r"]
[1652.437439, "o", "\u001b[?2004h> "]
[1652.437737, "o", "    Manifest ManifestPart `json:\"manifest\"`\r\n\u001b[?2004l\r"]
[1652.437795, "o", "\u001b[?2004h> "]
[1652.438203, "o", "    Checkpoint *CheckpointPart `json:\"checkpoint,omitempty\"`\r\n\u001b[?2004l\r"]
[1652.438265, "o", "\u001b[?2004h> "]
[1652.438674, "o", "    Comparison *ComparisonPart `json:\"comparison,omitempty\"`\r\n\u001b[?2004l\r"]
[1652.438739, "o", "\u001b[?2004h> "]
[1652.439087, "o", "    Lineage *LineagePart `json:\"lineage,omitempty\"`\r\n\u001b[?2004l\r"]
[1652.439141, "o", "\u001b[?2004h> "]
[1652.439548, "o", "    OverallReproducible bool `json:\"overall_reproducible\"`\r\n\u001b[?2004l\r"]
[1652.439577, "o", "\u001b[?2004h"]
[1652.439651, "o", "> "]
[1652.439843, "o", "    Issues []string `json:\"issues\"`\r\n\u001b[?2004l\r"]
[1652.43991, "o", "\u001b[?2004h> }\r\n"]
[1652.439967, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1652.440023, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1652.440078, "o", "> "]
[1652.440667, "o", "func Generate(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {\r\n\u001b[?2004l\r"]
[1652.440733, "o", "\u001b[?2004h> "]
[1652.440868, "o", "    issues := []string{}\r\n\u001b[?2004l\r"]
[1652.440925, "o", "\u001b[?2004h> "]
[1652.44104, "o", "    rep := &Report{\r\n\u001b[?2004l\r"]
[1652.441095, "o", "\u001b[?2004h> "]
[1652.441275, "o", "        ReportVersion: \"1.0\",\r\n\u001b[?2004l\r"]
[1652.441331, "o", "\u001b[?2004h> "]
[1652.441642, "o", "        Timestamp: time.Now().Format(time.RFC3339),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.441697, "o", "> "]
[1652.441812, "o", "        Issues: issues,\r\n\u001b[?2004l\r"]
[1652.441867, "o", "\u001b[?2004h> "]
[1652.441924, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.441979, "o", "> \r\n\u001b[?2004l\r"]
[1652.442033, "o", "\u001b[?2004h> "]
[1652.442271, "o", "    man := manifest.Validate(manifestPath)\r\n\u001b[?2004l\r"]
[1652.442327, "o", "\u001b[?2004h> "]
[1652.442514, "o", "    rep.Manifest = ManifestPart{\r\n\u001b[?2004l\r"]
[1652.442569, "o", "\u001b[?2004h> "]
[1652.442716, "o", "        Valid: man.Valid,\r\n\u001b[?2004l\r"]
[1652.442769, "o", "\u001b[?2004h> "]
[1652.442953, "o", "        Warnings: man.Warnings,\r\n\u001b[?2004l\r"]
[1652.443007, "o", "\u001b[?2004h> "]
[1652.443165, "o", "        Errors: man.Errors,\r\n\u001b[?2004l\r"]
[1652.443219, "o", "\u001b[?2004h> "]
[1652.443297, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.443353, "o", "> "]
[1652.443435, "o", "    if !man.Valid {\r\n\u001b[?2004l\r"]
[1652.443491, "o", "\u001b[?2004h> "]
[1652.444105, "o", "        issues = append(issues, fmt.Sprintf(\"Manifest validation failed: %s\", strings.Join(man.Errors, \"; \")))\r\n\u001b[?2004l\r"]
[1652.444154, "o", "\u001b[?2004h> "]
[1652.444211, "o", "    }\r\n\u001b[?2004l\r"]
[1652.444275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1652.444341, "o", "\u001b[?2004h> "]
[1652.444493, "o", "    checkpointValid := true\r\n\u001b[?2004l\r"]
[1652.444546, "o", "\u001b[?2004h> "]
[1652.444718, "o", "    if checkpointPath != \"\" {\r\n\u001b[?2004l\r"]
[1652.444772, "o", "\u001b[?2004h> "]
[1652.444984, "o", "        cp, err := mlck.ParseFile(checkpointPath)\r\n\u001b[?2004l\r"]
[1652.44504, "o", "\u001b[?2004h> "]
[1652.445113, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[1652.445168, "o", "\u001b[?2004h> "]
[1652.445298, "o", "            checkpointValid = false\r\n\u001b[?2004l\r"]
[1652.445355, "o", "\u001b[?2004h> "]
[1652.445502, "o", "            rep.Checkpoint = &CheckpointPart{\r\n\u001b[?2004l\r"]
[1652.445557, "o", "\u001b[?2004h> "]
[1652.445653, "o", "                Valid: false,\r\n\u001b[?2004l\r"]
[1652.445709, "o", "\u001b[?2004h> "]
[1652.445825, "o", "                Error: err.Error(),\r\n\u001b[?2004l\r"]
[1652.445881, "o", "\u001b[?2004h> "]
[1652.445938, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.445994, "o", "> "]
[1652.469938, "o", "            issues = append(issues, fmt.Sprintf(\"Checkpoint verification failed: %v\", err))\r\n\u001b[?2004l\r"]
[1652.469998, "o", "\u001b[?2004h> "]
[1652.470097, "o", "        } else {\r\n\u001b[?2004l\r"]
[1652.470152, "o", "\u001b[?2004h> "]
[1652.470423, "o", "            rep.Checkpoint = &CheckpointPart{\r\n\u001b[?2004l\r"]
[1652.470479, "o", "\u001b[?2004h> "]
[1652.470641, "o", "                Valid: true,\r\n\u001b[?2004l\r"]
[1652.470696, "o", "\u001b[?2004h> "]
[1652.470948, "o", "                NumTensors: len(cp.Tensors),\r\n\u001b[?2004l\r"]
[1652.471003, "o", "\u001b[?2004h> "]
[1652.471276, "o", "                FileChecksum: cp.FileChecksum,\r\n\u001b[?2004l\r"]
[1652.471334, "o", "\u001b[?2004h> "]
[1652.471411, "o", "            }\r\n\u001b[?2004l\r"]
[1652.471477, "o", "\u001b[?2004h> "]
[1652.471531, "o", "        }\r\n\u001b[?2004l\r"]
[1652.471586, "o", "\u001b[?2004h> "]
[1652.471641, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.471695, "o", "> \r\n\u001b[?2004l\r"]
[1652.47175, "o", "\u001b[?2004h> "]
[1652.471895, "o", "    comparisonMatch := true\r\n\u001b[?2004l\r"]
[1652.47195, "o", "\u001b[?2004h> "]
[1652.472242, "o", "    if checkpointPath != \"\" && comparePath != \"\" {\r\n\u001b[?2004l\r"]
[1652.472305, "o", "\u001b[?2004h> "]
[1652.47258, "o", "        c1, err := mlck.ParseFile(checkpointPath)\r\n\u001b[?2004l\r"]
[1652.472634, "o", "\u001b[?2004h> "]
[1652.472772, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[1652.472856, "o", "\u001b[?2004h"]
[1652.472944, "o", "> "]
[1652.473029, "o", "            comparisonMatch = false\r\n\u001b[?2004l\r"]
[1652.473086, "o", "\u001b[?2004h> "]
[1652.473352, "o", "            rep.Comparison = &ComparisonPart{\r\n\u001b[?2004l\r"]
[1652.473412, "o", "\u001b[?2004h> "]
[1652.473581, "o", "                Match: false,\r\n\u001b[?2004l\r"]
[1652.473636, "o", "\u001b[?2004h> "]
[1652.474037, "o", "                Error: fmt.Sprintf(\"checkpoint parse failed: %v\", err),\r\n\u001b[?2004l\r"]
[1652.474086, "o", "\u001b[?2004h> "]
[1652.474178, "o", "            }\r\n\u001b[?2004l\r"]
[1652.474244, "o", "\u001b[?2004h> "]
[1652.474681, "o", "            issues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\u001b[?2004l\r"]
[1652.474746, "o", "\u001b[?2004h> "]
[1652.47484, "o", "        } else {\r\n\u001b[?2004l\r"]
[1652.474896, "o", "\u001b[?2004h> "]
[1652.475178, "o", "            c2, err := mlck.ParseFile(comparePath)\r\n\u001b[?2004l\r"]
[1652.475249, "o", "\u001b[?2004h> "]
[1652.475402, "o", "            if err != nil {\r\n\u001b[?2004l\r"]
[1652.475457, "o", "\u001b[?2004h> "]
[1652.475684, "o", "                comparisonMatch = false\r\n\u001b[?2004l\r"]
[1652.47574, "o", "\u001b[?2004h> "]
[1652.476018, "o", "                rep.Comparison = &ComparisonPart{\r\n\u001b[?2004l\r"]
[1652.476072, "o", "\u001b[?2004h> "]
[1652.476269, "o", "                    Match: false,\r\n\u001b[?2004l\r"]
[1652.476317, "o", "\u001b[?2004h"]
[1652.476341, "o", "> "]
[1652.4768, "o", "                    Error: fmt.Sprintf(\"compare checkpoint parse failed: %v\", err),\r\n\u001b[?2004l\r"]
[1652.476857, "o", "\u001b[?2004h> "]
[1652.476961, "o", "                }\r\n\u001b[?2004l\r"]
[1652.477016, "o", "\u001b[?2004h> "]
[1652.477486, "o", "                issues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\u001b[?2004l\r"]
[1652.47754, "o", "\u001b[?2004h> "]
[1652.477666, "o", "            } else {\r\n\u001b[?2004l\r"]
[1652.477722, "o", "\u001b[?2004h> "]
[1652.478135, "o", "                res, err := compare.Compare(c1, c2, \"strict\", 1e-7, 1e-5)\r\n\u001b[?2004l\r"]
[1652.478192, "o", "\u001b[?2004h> "]
[1652.47838, "o", "                if err != nil {\r\n\u001b[?2004l\r"]
[1652.478437, "o", "\u001b[?2004h> "]
[1652.47868, "o", "                    comparisonMatch = false\r\n\u001b[?2004l\r"]
[1652.478736, "o", "\u001b[?2004h> "]
[1652.479037, "o", "                    rep.Comparison = &ComparisonPart{\r\n\u001b[?2004l\r"]
[1652.479092, "o", "\u001b[?2004h> "]
[1652.479317, "o", "                        Match: false,\r\n\u001b[?2004l\r"]
[1652.479387, "o", "\u001b[?2004h> "]
[1652.479647, "o", "                        Error: err.Error(),\r\n\u001b[?2004l\r"]
[1652.479717, "o", "\u001b[?2004h> "]
[1652.479833, "o", "                    }\r\n\u001b[?2004l\r"]
[1652.479888, "o", "\u001b[?2004h> "]
[1652.480381, "o", "                    issues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\u001b[?2004l\r"]
[1652.480438, "o", "\u001b[?2004h> "]
[1652.480577, "o", "                } else {\r\n\u001b[?2004l\r"]
[1652.480633, "o", "\u001b[?2004h> "]
[1652.480812, "o", "                    differ := 0\r\n\u001b[?2004l\r"]
[1652.480868, "o", "\u001b[?2004h> "]
[1652.481155, "o", "                    total := len(res.TensorResults)\r\n\u001b[?2004l\r"]
[1652.48121, "o", "\u001b[?2004h> "]
[1652.481546, "o", "                    for _, tr := range res.TensorResults {\r\n\u001b[?2004l\r"]
[1652.481606, "o", "\u001b[?2004h"]
[1652.481661, "o", "> "]
[1652.48182, "o", "                        if !tr.Match {\r\n\u001b[?2004l\r"]
[1652.481874, "o", "\u001b[?2004h> "]
[1652.482083, "o", "                            differ++\r\n\u001b[?2004l\r"]
[1652.482138, "o", "\u001b[?2004h> "]
[1652.482291, "o", "                        }\r\n\u001b[?2004l\r"]
[1652.48235, "o", "\u001b[?2004h> "]
[1652.482471, "o", "                    }\r\n\u001b[?2004l\r"]
[1652.482527, "o", "\u001b[?2004h> "]
[1652.482826, "o", "                    rep.Comparison = &ComparisonPart{\r\n\u001b[?2004l\r"]
[1652.482882, "o", "\u001b[?2004h> "]
[1652.483115, "o", "                        Match: res.Match,\r\n\u001b[?2004l\r"]
[1652.48317, "o", "\u001b[?2004h> "]
[1652.48365, "o", "                        Summary: fmt.Sprintf(\"%d/%d tensors differ\", differ, total),\r\n\u001b[?2004l\r"]
[1652.483711, "o", "\u001b[?2004h> "]
[1652.483828, "o", "                    }\r\n\u001b[?2004l\r"]
[1652.483883, "o", "\u001b[?2004h> "]
[1652.484087, "o", "                    if !res.Match {\r\n\u001b[?2004l\r"]
[1652.484142, "o", "\u001b[?2004h> "]
[1652.484418, "o", "                        comparisonMatch = false\r\n\u001b[?2004l\r"]
[1652.484445, "o", "\u001b[?2004h"]
[1652.484519, "o", "> "]
[1652.484694, "o", "                        if differ > 0 {\r\n\u001b[?2004l\r"]
[1652.484756, "o", "\u001b[?2004h> "]
[1652.485517, "o", "                            issues = append(issues, fmt.Sprintf(\"Tensor comparison failed: %d tensors differ beyond tolerance\", differ))\r\n\u001b[?2004l\r"]
[1652.485546, "o", "\u001b[?2004h"]
[1652.485624, "o", "> "]
[1652.485759, "o", "                        } else {\r\n\u001b[?2004l\r"]
[1652.485816, "o", "\u001b[?2004h> "]
[1652.486455, "o", "                            issues = append(issues, \"Tensor comparison failed: missing tensors or shape mismatch\")\r\n\u001b[?2004l\r"]
[1652.486517, "o", "\u001b[?2004h"]
[1652.486573, "o", "> "]
[1652.486657, "o", "                        }\r\n\u001b[?2004l\r"]
[1652.486712, "o", "\u001b[?2004h> "]
[1652.486836, "o", "                    }\r\n\u001b[?2004l\r"]
[1652.486912, "o", "\u001b[?2004h> "]
[1652.486967, "o", "                }\r\n\u001b[?2004l\r"]
[1652.487022, "o", "\u001b[?2004h> "]
[1652.487082, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.487135, "o", "        }\r\n\u001b[?2004l\r"]
