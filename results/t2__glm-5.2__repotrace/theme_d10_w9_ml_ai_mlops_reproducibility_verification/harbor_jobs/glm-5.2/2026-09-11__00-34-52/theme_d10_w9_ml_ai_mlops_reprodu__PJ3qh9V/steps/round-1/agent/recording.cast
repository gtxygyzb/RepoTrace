[527.272307, "o", "\u001b[?2004h"]
[527.272345, "o", "> "]
[527.27248, "o", "        Name: t.Name,\r\n\u001b[?2004l\r"]
[527.272519, "o", "\u001b[?2004h"]
[527.272556, "o", "> "]
[527.272777, "o", "        Dtype: DtypeName(t.Dtype),\r\n\u001b[?2004l\r"]
[527.272815, "o", "\u001b[?2004h"]
[527.272852, "o", "> "]
[527.272997, "o", "        Shape: t.Shape,\r\n\u001b[?2004l\r"]
[527.273035, "o", "\u001b[?2004h"]
[527.273073, "o", "> "]
[527.273273, "o", "        Checksum: t.Checksum,\r\n\u001b[?2004l\r"]
[527.273311, "o", "\u001b[?2004h"]
[527.273348, "o", "> "]
[527.273386, "o", "    }\r\n\u001b[?2004l\r"]
[527.273423, "o", "\u001b[?2004h> "]
[527.273459, "o", "}\r\n\u001b[?2004l\r"]
[527.273496, "o", "\u001b[?2004h"]
[527.273534, "o", "> \r\n\u001b[?2004l\r"]
[527.273571, "o", "\u001b[?2004h> "]
[527.273741, "o", "type Checkpoint struct {\r\n\u001b[?2004l\r"]
[527.273788, "o", "\u001b[?2004h> "]
