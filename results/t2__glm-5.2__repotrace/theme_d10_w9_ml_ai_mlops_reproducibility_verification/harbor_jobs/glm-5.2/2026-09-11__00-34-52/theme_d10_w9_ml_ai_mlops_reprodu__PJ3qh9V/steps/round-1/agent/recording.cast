[436.886967, "i", "LittleEndian.Uint64(t.Data[start : start+8])))\n\t\tdefault:\n\t\t\treturn nil, fmt.Errorf(\"invalid dtype %d\", t.Dtype)\n\t\t}\n\t}\n\treturn vals, nil\n}\n\nfunc EncodeFloat64Values(vals []float64, dtype uint8) ([]byte, error) {\n\tvar buf bytes.Buffer\n\tswitch Dtype(dtype) {\n\tcase Float32:\n\t\tfor _, v := range vals {\n\t\t\tif err := binary.Write(&buf, binary.LittleEndian, math.Float32bits(float32(v))); err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t}\n\tcase Float64:\n\t\tfor _, v := range vals {\n\t\t\tif err := binary.Write(&buf, binary.LittleEndian, math.Float64bits(v)); err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t}\n\tcase Int32:\n\t\tfor _, v := range vals {\n\t\t\tif err := binary.Write(&buf, binary.LittleEndian, int32(math.Round(v))); err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t}\n\tcase Int64:\n\t\tfor _, v := range vals {\n\t\t\tif err := binary.Write(&buf, binary.LittleEndian, int64(math.Round(v))); err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t}\n\tdefault:\n\t\treturn nil, fmt.Errorf(\"invalid dtype %d\", dtype)\n\t}\n\treturn buf.Bytes(), nil\n}\n\nfunc PromoteDtype(a, b uint8) "]
