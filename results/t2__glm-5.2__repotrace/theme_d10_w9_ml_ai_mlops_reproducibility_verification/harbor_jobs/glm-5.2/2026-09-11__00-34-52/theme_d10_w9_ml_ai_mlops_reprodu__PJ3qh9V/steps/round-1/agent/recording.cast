[4039.583996, "o", "     1\tpackage compare\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"math\"\r\n     6\t\r\n     7\t\t\"repro-verify/internal/mlck\"\r\n     8\t)\r\n     9\t\r\n    10\ttype TensorResult struct {\r\n    11\t\tName          string  `json:\"name\"`\r\n    12\t\tMatch         bool    `json:\"match\"`\r\n    13\t\tMaxAbsDiff    float64 `json:\"max_abs_diff\"`\r\n    14\t\tMaxRelDiff    float64 `json:\"max_rel_diff\"`"]
[4039.584187, "o", "\r\n    15\t\tNumMismatches int     `json:\"num_mismatches\"`\r\n    16\t\tTotalElements int     `json:\"total_elements\"`\r\n    17\t}\r\n    18\t\r\n    19\ttype Result struct {\r\n    20\t\tMatch          bool           `json:\"match\"`\r\n    21\t\tMode           string         `json:\"mode\"`\r\n    22\t\tAtol           float64        `json:\"atol\"`\r\n    23\t\tRtol           float64        `json:\"rtol\"`\r\n    24\t\tTensorResults  []TensorResult `json:\"tensor_results\"`\r\n    25\t\tMissingInFile1 []string       `json:\"missing_in_file1\"`\r\n    26\t\tMissingInFile2 []string       `json:\"missing_in_file2\"`\r\n    27\t\tError          string         `json:\"error,omitempty\"`\r\n    28\t}\r\n    29\t\r\n    30\tfunc Compare(c1, c2 *mlck.Checkpoint, mode string, atol, rtol float64) (*Result, error) {\r\n    31\t\tif mode != \"strict\" && mode != \"relaxed\" {\r\n    32\t\t\treturn nil, fmt.Errorf(\"invalid mode %q\", mode)\r\n    33\t\t}\r\n    34\t\r\n    35\t\tresult := &Result{\r\n    36\t\t\tMatch:          true,\r\n    37\t\t\tMode:           mode,\r\n    38\t\t\tAtol:           atol,\r\n    39\t\t\tRtol:         "]
[4039.584319, "o", "  rtol,\r\n    40\t\t\tTensorResults:  []TensorResult{},\r\n    41\t\t\tMissingInFile1: []string{},\r\n    42\t\t\tMissingInFile2: []string{},\r\n    43\t\t}\r\n    44\t\r\n    45\t\tmap2 := make(map[string]mlck.Tensor)\r\n    46\t\tfor _, t := range c2.Tensors {\r\n    47\t\t\tmap2[t.Name] = t\r\n    48\t\t}\r\n    49\t\tmap1 := make(map[string]mlck.Tensor)\r\n    50\t\tfor _, t := range c1.Tensors {\r\n    51\t\t\tmap1[t.Name] = t\r\n"]
