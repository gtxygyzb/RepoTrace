[2643.605749, "o", "metadata = map[string]interface{}{}\r\n    64\t\t}\r\n    65\t\ttensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))\r\n    66\t\tfor _, t := range cp.Tensors {\r\n    67\t\t\ttensors = append(tensors, t.Info())\r\n    68\t\t}\r\n    69\t\r\n    70\t\toutputJSON(map[string]interface{}{\r\n    71\t"]
[2643.605806, "o", "\t\t\"valid\":          true,\r\n    72\t\t\t\"format_version\": int(cp.Version),\r\n    73\t\t\t\"num_tensors\":    len(cp.Tensors),\r\n    74\t\t\t\"metadata\":       metadata,\r\n    75\t\t\t\"tensors\":        tensors,\r\n    76\t\t\t\"file_checksum\":  cp.FileChecksum,\r\n    77\t\t})\r\n    78\t\treturn 0\r\n    79\t}\r\n"]
[2643.605865, "o", "    80\t\r\n    81\tfunc runCompareOutputs(args []string) int {\r\n    82\t\tfs := flag.NewFlagSet(\"compare-outputs\", flag.ContinueOnError)\r\n    83\t\tfs.SetOutput(os.Stderr)\r\n    84\t\tatol := fs.Float64(\"atol\", 1e-7, \"absolute tolerance\")\r\n    85\t\trtol := fs.Float64(\"rtol\", 1e-5, \"relative tolerance\")\r\n    86\t\tmode := fs.String(\"mode\", \"strict\", \"comparison mode\")\r\n    87\t\r\n"]
