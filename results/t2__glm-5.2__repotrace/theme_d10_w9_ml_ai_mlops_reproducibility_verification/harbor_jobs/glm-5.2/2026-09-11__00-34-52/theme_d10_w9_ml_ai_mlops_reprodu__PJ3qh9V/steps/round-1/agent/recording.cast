[1229.071849, "o", "\u001b[?2004h> "]
[1229.071905, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1229.072028, "o", "    if len(pos) != 2 {\r\n\u001b[?2004l\r"]
[1229.072094, "o", "\u001b[?2004h> "]
[1229.072664, "o", "        outputJSON(map[string]interface{}{\"error\": \"usage: repro-verify compare-outputs <file1> <file2> [flags]\"})\r\n\u001b[?2004l\r"]
