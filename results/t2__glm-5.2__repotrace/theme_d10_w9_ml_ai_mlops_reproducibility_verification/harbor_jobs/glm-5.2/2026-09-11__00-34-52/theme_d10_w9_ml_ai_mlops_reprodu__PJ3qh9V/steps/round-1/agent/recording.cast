[5392.835783, "o", "     1\tpackage mlck\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n"]
[5392.835882, "o", "     5\t\t\"crypto/sha256\"\r\n     6\t\t\"encoding/binary\"\r\n     7\t\t\"encoding/hex\"\r\n     8\t\t\"encoding/json\"\r\n     9\t\t\"fmt\"\r\n    10\t\t\"math\"\r\n    11\t\t\"os\"\r\n    12\t)\r\n    13\t\r\n"]
[5392.83598, "o", "    14\tconst (\r\n    15\t\tMagic      = \"MLCK\"\r\n    16\t\tVersion    = 1\r\n    17\t\tHeaderSize = 16\r\n    18\t\tFooterSize = 32\r\n    19\t)\r\n    20\t\r\n    21\ttype Dtype uint8\r\n    22\t\r\n    23\tconst (\r\n    24\t\tFloat32 Dtype = 0\r\n"]
[5392.836075, "o", "    25\t\tFloat64 Dtype = 1\r\n    26\t\tInt32   Dtype = 2\r\n    27\t\tInt64   Dtype = 3\r\n    28\t)\r\n    29\t\r\n    30\tfunc (d Dtype) Valid() bool {\r\n    31\t\treturn d == Float32 || d == Float64 || d == Int32 || d == Int64\r\n    32\t}\r\n    33\t\r\n    34\tfunc (d Dtype) Name() string {\r\n    35\t\tswitch d {\r\n    36\t\tcase Float32:\r\n    37\t\t\t"]
[5392.836124, "o", "return \"float32\"\r\n    38\t\tcase Float64:\r\n    39\t\t\treturn \"float64\"\r\n    40\t\tcase Int32:\r\n    41\t\t\treturn \"int32\"\r\n    42\t\tcase Int64:\r\n    43\t\t\treturn \"int64\"\r\n    44\t\tdefault:\r\n    45\t\t\treturn \"unknown\"\r\n    46\t\t}\r\n    47\t}\r\n    48\t\r\n"]
[5392.836249, "o", "    49\tfunc (d Dtype) Size() int {\r\n    50\t\tswitch d {\r\n    51\t\tcase Float32, Int32:\r\n    52\t\t\treturn 4\r\n    53\t\tcase Float64, Int64:\r\n    54\t\t\treturn 8\r\n    55\t\tdefault:\r\n    56\t\t\treturn 0\r\n    57\t\t"]
[5392.836345, "o", "}\r\n    58\t}\r\n    59\t\r\n    60\tfunc DtypeName(dtype uint8) string {\r\n    61\t\treturn Dtype(dtype).Name()\r\n    62\t}\r\n    63\t\r\n    64\tfunc DtypeSize(dtype uint8) int {\r\n    65\t\treturn Dtype(dtype).Size()\r\n    66\t}\r\n    67\t\r\n    68\tfunc Product(shape []uint32) int64 {\r\n    69\t\tp := int64(1)\r\n    70\t\tfor _, s := range shape {\r\n    71\t\t\tp *= int64(s)\r\n    72\t\t}\r\n    73\t\treturn p\r\n    74\t}\r\n    75\t\r\n    76\ttype Tensor struct {\r\n"]
[5392.83644, "o", "    77\t\tName     string\r\n    78\t\tDtype    uint8\r\n    79\t\tShape    []uint32\r\n    80\t\tData     []byte\r\n    81\t\tChecksum string\r\n    82\t}\r\n    83\t\r\n    84\ttype TensorInfo struct {\r\n    85\t\tName     string   `json:\"name\"`\r\n    86\t\tDtype    string   `json:\"dtype\"`\r\n    87\t\tShape    []uint32 `json:\"shape\"`\r\n    88\t\tChecksum string   `json:\"checksum\"`\r\n"]
[5392.836529, "o", "    89\t}\r\n    90\t\r\n    91\tfunc (t Tensor) Info() TensorInfo {\r\n    92\t\treturn TensorInfo{\r\n    93\t\t\tName:     t.Name,\r\n    94\t\t\tDtype:    DtypeName(t.Dtype),\r\n    95\t\t\tShape:    t.Shape,\r\n    96\t\t\tChecksum: t.Checksum,\r\n    97\t\t}\r\n    98\t}\r\n    99\t\r\n   100\ttype Checkpoint struct {\r\n   101\t\tVersion      uint32\r\n   102\t"]
[5392.836619, "o", "\tNumTensors   uint32\r\n   103\t\tMetadata     map[string]interface{}\r\n   104\t\tMetadataRaw  []byte\r\n   105\t\tTensors      []Tensor\r\n   106\t\tFileChecksum string\r\n   107\t\tFilePath     string\r\n   108\t}\r\n   109\t\r\n   110\tfunc ParseFile(path string) (*Checkpoint, error) {\r\n   111\t\tdata, err := os.ReadFile(path)\r\n   112\t\tif err != nil {\r\n   113\t\t\treturn nil, err\r\n   114\t\t"]
[5392.836709, "o", "}\r\n   115\t\treturn Parse(data, path)\r\n   116\t}\r\n   117\t\r\n   118\tfunc Parse(data []byte, path string) (*Checkpoint, error) {\r\n   119\t\tif len(data) < HeaderSize+FooterSize {\r\n   120\t\t\treturn nil, fmt.Errorf(\"file too small\")\r\n   121\t\t}\r\n   122\t\r\n   123\t\tif string(data[0:4]) != Magic {\r\n   124\t\t\treturn nil, fmt.Errorf(\"bad magic\")\r\n   125\t\t}\r\n   126\t\r\n   127\t\tversion := binary.LittleEndian.Uint32(data[4:8])\r\n"]
[5392.836797, "o", "   128\t\tif version != Version {\r\n   129\t\t\treturn nil, fmt.Errorf(\"unsupported version %d\", version)\r\n   130\t\t}\r\n"]
