[4020.136672, "o", "     1\tpackage app\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"flag\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"io\"\r\n"]
[4020.136794, "o", "     8\t\t\"os\"\r\n     9\t\t\"strings\"\r\n    10\t\r\n    11\t\t\"repro-verify/internal/compare\"\r\n    12\t\t\"repro-verify/internal/drift\"\r\n    13\t\t\"repro-verify/internal/lineage\"\r\n    14\t\t\"repro-verify/internal/manifest\"\r\n    15\t\t\"repro-verify/internal/merge\"\r\n    16\t\t\"repro-verify/internal/mlck\"\r\n    17\t\t\"repro-verify/internal/report\"\r\n    18\t)\r\n    19\t\r\n    20\tfunc Run() int {\r\n    21\t\tif len(os.Args) < 2 {\r\n    22\t\t\toutputJSON(map[string]interface{}{\"error\": \"no subcommand provided\"})\r\n    23\t\t\treturn 1\r\n    24\t\t"]
[4020.136889, "o", "}\r\n    25\t\r\n    26\t\tswitch os.Args[1] {\r\n    27\t\tcase \"verify-checkpoint\":\r\n    28\t\t\treturn runVerifyCheckpoint(os.Args[2:])\r\n    29\t\tcase \"compare-outputs\":\r\n    30\t\t\treturn runCompareOutputs(os.Args[2:])\r\n    31\t\tcase \"validate-manifest\":\r\n    32\t\t\treturn runValidateManifest(os.Args[2:])\r\n    33\t\tcase \"audit-lineage\":\r\n    34\t\t\treturn runAuditLineage(os.Args[2:])\r\n    35\t\tcase \"generate-report\":\r\n"]
[4020.136959, "o", "    36\t\t\treturn runGenerateReport(os.Args[2:])\r\n    37\t\tcase \"merge-checkpoints\":\r\n    38\t\t\treturn runMergeCheckpoints(os.Args[2:])\r\n    39\t\tcase \"drift-analysis\":\r\n    40\t\t\treturn runDriftAnalysis(os.Args[2:])\r\n    41\t\tdefault:\r\n    42\t\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"unknown subcommand: %s\", os.Args[1])})\r\n    43\t\t\treturn 1\r\n    44\t\t}\r\n    45\t"]
[4020.137033, "o", "}\r\n    46\t\r\n    47\tfunc runVerifyCheckpoint(args []string) int {\r\n    48\t\tif len(args) != 1 {\r\n    49\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify verify-checkpoint <file>\"})\r\n    50\t\t\treturn 1\r\n    51\t\t}\r\n    52\t\r\n    53\t\tif _, err := os.ReadFile(args[0]); err != nil {\r\n    54\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n"]
[4020.137119, "o", "    55\t\t\treturn 1\r\n    56\t\t}\r\n    57\t\r\n    58\t\tcp, err := mlck.ParseFile(args[0])\r\n    59\t\tif err != nil {\r\n"]
[4020.137181, "o", "    60\t\t\toutputJSON(map[string]interface{}{\r\n    61\t\t\t\t\"valid\": false,\r\n    62\t\t\t\t\"error\": err.Error(),\r\n    63\t\t\t})\r\n    64\t\t\treturn 1\r\n    65\t\t}\r\n    66\t\r\n    67\t\tmetadata := cp.Metadata\r\n    68\t\tif metadata == nil {\r\n    69\t\t\tmetadata = map[string]interface{}{}\r\n    70\t\t}\r\n    71\t\ttensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))\r\n    72\t\tfor _, t := range cp.Tensors {\r\n    73\t\t\ttensors = append(tensors, t.Info())\r\n    74\t\t}\r\n"]
[4020.137285, "o", "    75\t\r\n    76\t\toutputJSON(map[string]interface{}{\r\n    77\t\t\t\"valid\":          true,\r\n    78\t\t\t\"format_version\": int(cp.Version),\r\n    79\t\t\t\"num_tensors\":    len(cp.Tensors),\r\n    80\t\t\t\"metadata\":       metadata,\r\n    81\t\t\t\"tensors\":        tensors,\r\n    82\t\t\t\"file_checksum\":  cp.FileChecksum,\r\n    83\t\t})\r\n    84\t\treturn 0\r\n    85"]
[4020.137347, "o", "\t}\r\n    86\t\r\n    87\tfunc runCompareOutputs(args []string) int {\r\n    88\t\tfs := flag.NewFlagSet(\"compare-outputs\", flag.ContinueOnError)\r\n    89\t\tfs.SetOutput(io.Discard)\r\n    90\t\tatol := fs.Float64(\"atol\", 1e-7, \"absolute tolerance\")\r\n    91\t\trtol := fs.Float64(\"rtol\", 1e-5, \"relative tolerance\")\r\n    92\t\tmode := fs.String(\"mode\", \"strict\", \"comparison mode\")\r\n    93\t\r\n    94\t\tpos, err := parseMixedArgs(fs, args)\r\n    95\t\tif err != nil {\r\n"]
