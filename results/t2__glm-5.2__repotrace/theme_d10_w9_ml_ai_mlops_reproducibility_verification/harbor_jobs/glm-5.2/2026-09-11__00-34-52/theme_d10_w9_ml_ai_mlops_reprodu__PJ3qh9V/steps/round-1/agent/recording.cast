[5846.340497, "o", "package drift\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"sort\"\r\n"]
[5846.34057, "o", "\r\n\t\"repro-verify/internal/mlck\"\r\n)\r\n\r\ntype TensorResult struct {\r\n\tName           string    `json:\"name\"`\r\n\tStepChanges    []float64 `json:\"step_changes\"`\r\n\tMeanChange     float64   `json:\"mean_change\"`\r\n\tMaxChange      float64   `json:\"max_change\"`\r\n\tConvergence    string    `json:\"convergence\"`\r\n\tStabilityScore float64   `json:\"stability_score\"`\r\n\tDrifting       *bool     `json:\"drifting,omitempty\"`\r\n}\r\n\r\n"]
[5846.340653, "o", "type Result struct {\r\n\tNumSnapshots       int            `json:\"num_snapshots\"`\r\n\tNumAnalyzedTensors int            `json:\"num_analyzed_tensors\"`\r\n\tSkippedTensors     []string       `json:\"skipped_tensors\"`\r\n\tTensors            []TensorResult `json:\"tensors\"`\r\n\tOverallConvergence string         `json:\"overall_convergence\"`\r\n\tTopK               *int           `json:\"top_k,omitempty\"`\r\n\tDriftThreshold     *float64       `json:\"drift_threshold,omitempty\"`\r\n\tNumDriftingTensors *int           `json:\"num_drifting_tensors,omitempty\"`\r\n}\r\n\r\n// Analyze remains available for callers that do not need a top-k restriction.\r\nfunc Analyze(files []string) (*Result, error) {\r\n"]
[5846.340723, "o", "\treturn AnalyzeWithTopK(files, nil, nil)\r\n}\r\n\r\n// AnalyzeWithTopK analyzes drift and optionally restricts the returned tensor\r\n// list to the N tensors with the lowest stability scores. When topK > 0 the\r\n// result includes a top_k field set to the requested N, even if fewer tensors\r\n// are returned. When threshold is non-nil, each tensor result includes a\r\n// drifting field, and the top-level result includes drift_threshold and\r\n// num_drifting_tensors. The count reflects all analyzed tensors, not just those\r\n// returned after top-k filtering.\r\nfunc AnalyzeWithTopK(files []string, topK *int, threshold *float64) (*Result, error) {\r\n\tif len(files) < 2 {\r\n\t\treturn nil, fmt.Errorf(\"at least 2 input files required\")\r\n"]
[5846.340798, "o", "\t}\r\n\r\n\tcps := make([]*mlck.Checkpoint, len(files))\r\n\tfor i, f := range files {\r\n\t\tcp, err := mlck.ParseFile(f)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n\t\t}\r\n\t\tcps[i] = cp\r\n\t}\r\n\r\n\tvar allNames []string\r\n\tseen := map[string]bool{}\r\n"]
[5846.340866, "o", "\tfor _, cp := range cps {\r\n\t\tfor _, t := range cp.Tensors {\r\n\t\t\tif !seen[t.Name] {\r\n\t\t\t\tseen[t.Name] = true\r\n\t\t\t\tallNames = append(allNames, t.Name)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tsort.Strings(allNames)\r\n\r\n\tskipped := []string{}\r\n\ttensors := []TensorResult{}\r\n\t"]
[5846.340927, "o", "converging := 0\r\n\tdiverging := 0\r\n\r\n\tfor _, name := range allNames {\r\n\t\tok := true\r\n\t\tvar shape []uint32\r\n\t\tfor _, cp := range cps {\r\n\t\t\tt, exists := tensorByName(cp, name)\r\n\t\t\tif !exists {\r\n\t"]
[5846.340998, "o", "\t\t\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\tif shape == nil {\r\n\t\t\t\tshape = t.Shape\r\n\t\t\t} else if !shapesEqual(shape, t.Shape) {\r\n\t\t\t\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif !ok {\r\n\t\t\tskipped = append(skipped, name)\r\n\t\t\tcontinue\r\n\t"]
[5846.341055, "o", "\t}\r\n\r\n\t\tsteps := make([]float64, len(cps)-1)\r\n\t\tfor i := 0; i < len(steps); i++ {\r\n\t\t\tv1, err := tensorData(cps[i], name)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tv2, err := tensorData(cps[i+1], name)\r\n"]
[5846.341135, "o", "\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tn := len(v1)\r\n\t\t\tif n == 0 {\r\n\t\t\t\tsteps[i] = 0\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvar sum float64\r\n\t\t\tfor j := 0; j < n; j++ {\r\n\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n\t\t\t}\r\n\t"]
[5846.341203, "o", "\t\tsteps[i] = sum / float64(n)\r\n\t\t}\r\n\r\n\t\tmean := meanFloat64(steps)\r\n\t\tmax := maxFloat64(steps)\r\n\t\tconvergence := classifyConvergence(steps)\r\n\t\tstability := 1.0\r\n\t\tif max != 0 {\r\n\t\t\tstability = 1.0 - steps[len(steps)-1]/max\r\n\t\t\tif stability < 0 {\r\n"]
[5846.341292, "o", "\t\t\t\tstability = 0\r\n\t\t\t} else if stability > 1 {\r\n\t\t\t\tstability = 1\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\ttensors = append(tensors, TensorResult{\r\n\t\t\tName:           name,\r\n\t\t\tStepChanges:    steps,\r\n"]
[5846.341354, "o", "\t\t\tMeanChange:     mean,\r\n\t\t\tMaxChange:      max,\r\n\t\t\tConvergence:    convergence,\r\n\t\t\tStabilityScore: stability,\r\n\t\t})\r\n\r\n\t\tif convergence == \"converging\" {\r\n\t\t\tconverging++\r\n\t\t} else if convergence == \"diverging\" {\r\n\t\t\tdiverging++\r\n\t\t}\r\n\t}\r\n\r\n\toverall := \"mixed\"\r\n\tif converging > len(tensors)/2 {\r\n\t\toverall = \"converging\"\r\n\t"]
[5846.341427, "o", "} else if diverging > len(tensors)/2 {\r\n\t\toverall = \"diverging\"\r\n\t}\r\n\r\n\tsort.Strings(skipped)\r\n\tsort.Slice(tensors, func(i, j int) bool {\r\n\t\treturn tensors[i].Name < tensors[j].Name\r\n\t})\r\n\r\n\tresult := &Result{\r\n\t\tNumSnapshots:       len(files),\r\n\t\tNumAnalyzedTensors: len(tensors),\r\n"]
[5846.341502, "o", "\t\tSkippedTensors:     skipped,\r\n\t\tTensors:            tensors,\r\n\t\tOverallConvergence: overall,\r\n\t}\r\n\r\n\tif threshold != nil {\r\n\t\tnumDrifting := 0\r\n\t\tfor i := range result.Tensors {\r\n"]
[5846.341576, "o", "\t\t\tdrifting := result.Tensors[i].MaxChange > *threshold\r\n\t\t\tresult.Tensors[i].Drifting = &drifting\r\n\t\t\tif drifting {\r\n\t\t\t\tnumDrifting++\r\n\t\t\t}\r\n\t\t}\r\n\t\tresult.DriftThreshold = threshold\r\n\t\tresult.NumDriftingTensors = &numDrifting\r\n\t}\r\n\r\n\tapplyTopK(result, topK)\r\n\treturn result, nil\r\n}\r\n\r\nfunc applyTopK(result *Result, topK *int) {\r\n\tif topK == nil {\r\n\t\treturn\r\n\t}\r\n\r\n\trequested := *topK\r\n"]
[5846.341651, "o", "\tsort.SliceStable(result.Tensors, func(i, j int) bool {\r\n\t\tif result.Tensors[i].StabilityScore != result.Tensors[j].StabilityScore {\r\n\t\t\treturn result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore\r\n\t\t}\r\n\t\treturn result.Tensors[i].Name < result.Tensors[j].Name\r\n\t})\r\n\tif requested < len(result.Tensors) {\r\n\t\tresult.Tensors = result.Tensors[:requested]\r\n\t}\r\n\tresult.TopK = &requested\r\n}\r\n"]
[5846.34172, "o", "\r\nfunc tensorData(cp *mlck.Checkpoint, name string) ([]float64, error) {\r\n\tt, ok := tensorByName(cp, name)\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"tensor %s not found\", name)\r\n\t}\r\n"]
[5846.341801, "o", "\treturn t.Float64Values()\r\n}\r\n\r\nfunc tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {\r\n\tfor _, t := range cp.Tensors {\r\n\t\tif t.Name == name {\r\n\t\t\treturn t, true\r\n\t\t}\r\n\t}\r\n\treturn mlck.Tensor{}, false\r\n}\r\n\r\nfunc shapesEqual(a, b []uint32) bool {\r\n\tif len(a) != len(b) {\r\n\t\treturn false\r\n\t}\r\n\tfor i := range a {\r\n\t\tif a[i] != b[i] {\r\n\t\t\treturn false\r\n\t\t}\r\n"]
[5846.34187, "o", "\t}\r\n\treturn true\r\n}\r\n\r\nfunc meanFloat64(xs []float64) float64 {\r\n\tif len(xs) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tvar sum float64\r\n\tfor _, x := range xs {\r\n\t\tsum += x\r\n\t}\r\n\treturn sum / float64(len(xs))\r\n"]
[5846.341938, "o", "}\r\n\r\nfunc maxFloat64(xs []float64) float64 {\r\n\tif len(xs) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tm := xs[0]\r\n"]
[5846.342005, "o", "\tfor _, x := range xs[1:] {\r\n\t\tif x > m {\r\n\t\t\tm = x\r\n\t\t}\r\n\t}\r\n\treturn m\r\n}\r\n\r\nfunc classifyConvergence(steps []float64) string {\r\n\tif len(steps) <= 1 {\r\n\t\treturn \"converging\"\r\n\t}\r\n\tnonIncreasing := true\r\n\tnonDecreasing := true\r\n\thasIncrease := false\r\n\tfor i := 1; i < len(steps); i++ {\r\n\t\tif steps[i] > steps[i-1] {\r\n\t\t\tnonIncreasing = false\r\n"]
[5846.342081, "o", "\t\t\thasIncrease = true\r\n\t\t}\r\n\t\tif steps[i] < steps[i-1] {\r\n\t\t\tnonDecreasing = false\r\n\t\t}\r\n\t}\r\n\tif nonIncreasing {\r\n\t\treturn \"converging\"\r\n\t}\r\n\tif nonDecreasing && hasIncrease {\r\n\t\treturn \"diverging\"\r\n\t}\r\n\treturn \"oscillating\"\r\n}\r\n"]
[5846.342616, "o", "\u001b[?2004h"]
[5846.342676, "o", "root@n30009:/app# "]
