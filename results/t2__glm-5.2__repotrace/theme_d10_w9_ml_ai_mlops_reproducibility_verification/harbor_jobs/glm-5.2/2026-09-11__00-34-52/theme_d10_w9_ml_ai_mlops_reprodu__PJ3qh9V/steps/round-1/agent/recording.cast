[3744.743655, "o", "\r\n   150\t\t\t\treturn t, true\r\n   151\t\t\t}\r\n   152\t\t}\r\n   153\t\treturn mlck.Tensor{}, false\r\n   154\t}\r\n   155\t\r\n   156\tfunc shapesEqual(a, b []uint32) bool {\r\n   157\t\tif len(a) != len(b) {\r\n   158\t\t\treturn false\r\n"]
[3744.743712, "o", "   159\t\t}\r\n   160\t\tfor i := range a {\r\n   161\t\t\tif a[i] != b[i] {\r\n   162\t\t\t\treturn false\r\n   163\t\t\t}\r\n   164\t\t}\r\n   165\t\treturn true\r\n   166"]
[3744.743775, "o", "\t}\r\n   167\t\r\n   168\tfunc meanFloat64(xs []float64) float64 {\r\n   169\t\tif len(xs) == 0 {\r\n   170\t\t\treturn 0\r\n   171\t\t}\r\n   172\t\tvar sum float64\r\n   173\t\tfor _, x := range xs {\r\n   174\t\t\tsum += x\r\n   175\t"]
[3744.74384, "o", "\t}\r\n   176\t\treturn sum / float64(len(xs))\r\n   177\t}\r\n   178\t\r\n   179\tfunc maxFloat64(xs []float64) float64 {\r\n   180\t\tif len(xs) == 0 {\r\n   181\t\t\treturn 0\r\n   182\t\t}\r\n   183\t\tm := xs[0]\r\n   184\t\tfor _, x := range xs[1:] {\r\n"]
[3744.743899, "o", "   185\t\t\tif x > m {\r\n   186\t\t\t\tm = x\r\n   187\t\t\t}\r\n   188\t\t}\r\n   189\t\treturn m\r\n   190\t}\r\n   191\t\r\n   192\tfunc classifyConvergence(steps []float64) string {\r\n"]
[3744.743957, "o", "   193\t\tif len(steps) <= 1 {\r\n   194\t\t\treturn \"converging\"\r\n   195\t\t}\r\n   196\t\tdecreasing := true\r\n   197\t\tincreasing := true\r\n   198\t\tfor i := 1; i < len(steps); i++ {\r\n   199\t\t\tif steps[i] >= steps[i-1] {\r\n"]
[3744.744017, "o", "   200\t\t\t\tdecreasing = false\r\n   201\t\t\t}\r\n   202\t\t\tif steps[i] <= steps[i-1] {\r\n   203\t\t\t\tincreasing = false\r\n   204\t\t\t}\r\n   205\t\t}\r\n   206\t\tif decreasing {\r\n   207\t\t\treturn \"converging\"\r\n   208\t\t}\r\n   209\t"]
