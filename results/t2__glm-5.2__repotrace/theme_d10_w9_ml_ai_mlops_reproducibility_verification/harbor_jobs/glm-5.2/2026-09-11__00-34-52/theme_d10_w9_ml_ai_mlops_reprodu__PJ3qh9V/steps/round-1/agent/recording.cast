[3739.175157, "o", "\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tresult.\u001b[01;31m\u001b[KMissing\u001b[m\u001b[KInFile2 = append(result.\u001b[01;31m\u001b[KMissing\u001b[m\u001b[KInFile2, t1.Name)\r\n\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KTensorResult\u001b[m\u001b[Ks = append(result.\u001b[01;31m\u001b[KTensorResult\u001b[m\u001b[Ks, tr)\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tresult.\u001b[01;31m\u001b[KMissing\u001b[m\u001b[KInFile1 = append(result.\u001b[01;31m\u001b[KMissing\u001b[m\u001b[KInFile1, t.Name)\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif len(result.\u001b[01;31m\u001b[KMissing\u001b[m\u001b[KInFile1) > 0 || len(result.\u001b[01;31m\u001b[KMissing\u001b[m\u001b[KInFile2) > 0 {\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KcompareTensors(t1, t2 mlck.Tensor, mode string, atol, rtol float64) \u001b[01;31m\u001b[KTensorResult\u001b[m\u001b[K {\r\n"]
