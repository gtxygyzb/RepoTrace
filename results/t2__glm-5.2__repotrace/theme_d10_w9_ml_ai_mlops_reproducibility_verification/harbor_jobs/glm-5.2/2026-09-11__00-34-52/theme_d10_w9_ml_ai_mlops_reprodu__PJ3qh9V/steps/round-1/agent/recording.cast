[5022.969848, "o", "\u001b[?2004h> \\t\\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\treturn 1\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \\tvar topKPtr *int\r\n\u001b[?2004l\r\u001b[?2004h> \\tfs.Visit(func(f *flag.Flag) {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tif f.Name == \"top-k\" {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tv := *topK\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\ttopKPtr = &v\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t})\r\n\u001b[?2004l\r\u001b[?2004h> \\tif topKPtr != nil && *topKPtr < 0 {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\toutputJSON(map[string]interface{}{\"error\": \"--top-k must be non-negative\"})\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\treturn 1\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \\tres, err := drift.AnalyzeWithTopK(pos, topKPtr)\r\n\u001b[?2004l\r\u001b[?2004h> \\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\treturn 1\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\toutputJSON(res)\r\n\u001b[?2004l\r\u001b[?2004h> \\treturn "]
[5022.969956, "o", "0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func parseMixedArgs''',\r\n\u001b[?2004l\r\u001b[?2004h>     s,\r\n\u001b[?2004l\r\u001b[?2004h>     count=1,\r\n\u001b[?2004l\r\u001b[?2004h>     flags=re.S,\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
