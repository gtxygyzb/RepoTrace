[4432.945493, "o", "   220\t\treturn &Checkpoint{\r\n   221\t\t\tVersion:      version,\r\n   222\t\t\tNumTensors:   numTensors,\r\n   223\t\t\tMetadata:     metadata,\r\n   224\t\t\tMetadataRaw:  metaRaw,\r\n   225\t\t\tTensors:      tensors,\r\n   226\t\t\tFileChecksum: fileChecksum,\r\n   227\t\t"]
[4432.945633, "o", "\tFilePath:     path,\r\n   228\t\t}, nil\r\n   229\t}\r\n   230\t\r\n   231\tfunc Build(metadata map[string]interface{}, tensors []Tensor) ([]byte, error) {\r\n   232\t\tmetaRaw, err := json.Marshal(metadata)\r\n   233\t\tif err != nil {\r\n   234\t\t\treturn nil, fmt.Errorf(\"failed to marshal metadata: %v\", err)\r\n   235\t\t}\r\n   236\t\r\n   237\t\tvar buf bytes.Buffer\r\n   238\t\theader := make([]byte, HeaderSize)\r\n   239\t\tcopy(header[0:4], Magic)\r\n   240\t\tbinary.LittleEndian.PutUint32(header[4:8], Version)\r\n   241\t\tbinary.LittleEndian.PutUint32(header[8:12], uint32(len(tensors)))\r\n   242\t\tbinary.LittleEndian.PutUint32(header[12:16], uint32(len(metaRaw)))\r\n   243\t\tbuf.Write(header)\r\n   244\t\tbuf.Write(metaRaw)\r\n   245\t\r\n"]
[4432.945721, "o", "   246\t\tfor _, t := range tensors {\r\n   247\t\t\tnameBytes := []byte(t.Name)\r\n   248\t\t\tif err := binary.Write(&buf, binary.LittleEndian, uint32(len(nameBytes))); err != nil {\r\n   249\t\t\t\treturn nil, err\r\n   250\t\t\t}\r\n   251\t\t\tbuf.Write(nameBytes)\r\n   252\t\t\tbuf.WriteByte(t.Dtype)\r\n   253\t\t\tif err := binary.Write(&buf, binary.LittleEndian, uint32(len(t.Shape))); err != nil {\r\n   254\t\t\t\treturn nil, err\r\n   255\t\t\t}\r\n   256\t\t\tfor _, s := range t.Shape {\r\n   257"]
[4432.945798, "o", "\t\t\t\tif err := binary.Write(&buf, binary.LittleEndian, s); err != nil {\r\n   258\t\t\t\t\treturn nil, err\r\n   259\t\t\t\t}\r\n   260\t\t\t}\r\n   261\t\t\texpected := Product(t.Shape) * int64(DtypeSize(t.Dtype))\r\n   262\t\t\tif int64(len(t.Data)) != expected {\r\n   263\t\t\t\treturn nil, fmt.Errorf(\"tensor %s data length %d does not match shape %v and dtype %s\", t.Name, len(t.Data), t.Shape, DtypeName(t.Dtype))\r\n   264\t\t\t}\r\n"]
[4432.945871, "o", "   265\t\t\tbuf.Write(t.Data)\r\n   266\t\t}\r\n   267\t\r\n   268\t\tsum := sha256.Sum256(buf.Bytes())\r\n   269\t\tbuf.Write(sum[:])\r\n   270\t\treturn buf.Bytes(), nil\r\n   271\t}\r\n   272\t\r\n   273\tfunc WriteFile(path string, metadata map[string]interface{}, tensors []Tensor) error {\r\n   274\t\tdata, err := Build(metadata, tensors)\r\n"]
[4432.945941, "o", "   275\t\tif err != nil {\r\n   276\t\t\treturn err\r\n   277\t\t}\r\n   278\t\treturn os.WriteFile(path, data, 0644)\r\n   279\t}\r\n   280\t\r\n   281\tfunc (t Tensor) Float64Values() ([]float64, error) {\r\n   282\t\tsize := DtypeSize(t.Dtype)\r\n   283\t\tif size == 0 {\r\n   284\t\t\treturn nil, fmt.Errorf(\"invalid dtype %d\", t.Dtype)\r\n   285\t\t}\r\n"]
[4432.946016, "o", "   286\t\tn := len(t.Data) / size\r\n   287\t\tif len(t.Data)%size != 0 {\r\n   288\t\t\treturn nil, fmt.Errorf(\"tensor %s data length not multiple of dtype size\", t.Name)\r\n   289\t\t}\r\n   290\t\tvals := make([]float64, n)\r\n   291\t\tfor i := 0; i < n; i++ {\r\n   292\t\t\tstart := i * size\r\n   293\t\t\tswitch Dtype(t.Dtype) {\r\n   294\t\t\tcase Float32:\r\n   295\t\t\t\tbits := binary.LittleEndian.Uint32(t.Data[start : start+4])\r\n"]
[4432.946084, "o", "   296\t\t\t\tvals[i] = float64(math.Float32frombits(bits))\r\n   297\t\t\tcase Float64:\r\n   298\t\t\t\tbits := binary.LittleEndian.Uint64(t.Data[start : start+8])\r\n   299\t\t\t\tvals[i] = math.Float64frombits(bits)\r\n   300\t\t\tcase Int32:\r\n   301\t\t\t\tvals[i] = float64(int32(binary.LittleEndian.Uint32(t.Data[start : start+4])))\r\n   302\t\t\tcase Int64:\r\n   303\t\t\t\tvals[i] = float64(int64(binary.LittleEndian.Uint64(t.Data[start : start+8])))\r\n   304\t\t\tdefault:\r\n"]
[4432.946166, "o", "   305\t\t\t\treturn nil, fmt.Errorf(\"invalid dtype %d\", t.Dtype)\r\n   306\t\t\t}\r\n   307\t\t}\r\n   308\t\treturn vals, nil\r\n   309\t}\r\n   310\t\r\n   311\tfunc EncodeFloat64Values(vals []float64, dtype uint8) ([]byte, error) {\r\n   312\t\tvar buf bytes.Buffer\r\n   313\t\tswitch Dtype(dtype) {\r\n   314\t\tcase Float32:\r\n   315\t\t\tfor _, v := range vals {\r\n   316\t\t\t\tif err := binary.Write(&buf, binary.LittleEndian, math.Float32bits(float32(v))); err != nil {\r\n"]
[4432.946275, "o", "   317\t\t\t\t\treturn nil, err\r\n   318\t\t\t\t}\r\n   319\t\t\t}\r\n   320\t\tcase Float64:\r\n   321\t\t\tfor _, v := range vals {\r\n   322\t\t\t\tif err := binary.Write(&buf, binary.LittleEndian, math.Float64bits(v)); err != nil {\r\n   323\t\t\t\t\treturn nil, err\r\n   324\t\t\t\t}\r\n   325\t\t\t}\r\n   326\t\tcase Int32:\r\n   327\t\t\tfor _, v := range vals {\r\n   328\t\t\t\tif err := binary.Write(&buf, binary.LittleEndian, int32(math.Round(v))); err != nil {\r\n"]
[4432.946348, "o", "   329\t\t\t\t\treturn nil, err\r\n   330\t\t\t\t}\r\n   331\t\t\t}\r\n   332\t\tcase Int64:\r\n   333\t\t\tfor _, v := range vals {\r\n   334\t\t\t\tif err := binary.Write(&buf, binary.LittleEndian, int64(math.Round(v))); err != nil {\r\n   335\t\t\t\t\treturn nil, err\r\n   336\t\t\t\t}\r\n   337\t\t\t}\r\n   338\t\tdefault:\r\n"]
[4432.946414, "o", "   339\t\t\treturn nil, fmt.Errorf(\"invalid dtype %d\", dtype)\r\n   340\t\t}\r\n"]
