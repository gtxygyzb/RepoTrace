[3268.135484, "o", "type CheckpointPart struct {\r\n\tValid        bool   `json:\"valid\"`\r\n\tNumTensors   int    `json:\"num_tensors\"`\r\n\tFileChecksum string `json:\"file_checksum\"`\r\n\tError        string `json:\"error,omitempty\"`\r\n}\r\n\r\ntype ComparisonPart struct {\r\n\tMatch   bool   `json:\"match\"`\r\n\tSummary string `json:\"summary,omitempty\"`\r\n\tError   string `json:\"error,omitempty\"`\r\n}\r\n\r\ntype LineagePart struct {\r\n\tValid bool   `json:\"valid\"`\r\n\tDepth int    `json:\"depth\"`\r\n\tError string `json:\"error,omitempty\"`\r\n}\r\n\r\ntype Report struct {\r\n\tReportVersion       string          `json:\"report_version\"`\r\n\tTimestamp           string          `json:\"timestamp\"`\r\n\tManifest            ManifestPart    `json:\"manifest\"`\r\n\tCheckpoint          *CheckpointPart `json:\"checkpoint,omitempty\"`\r\n\tComparison          *ComparisonPart `json:\"comparison,omitempty\"`\r\n\tLineage             *LineagePart    `json:\"lineage,omitempty\"`\r\n\tOverallReproducible bool            `json:\"overall_reproducible\"`\r\n\tIssues              []string        `json:\"issues\"`\r\n}\r\n\r\nfunc Ge"]
[3268.135582, "o", "nerate(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {\r\n\tissues := []string{}\r\n\trep := &Report{\r\n\t\tReportVersion: \"1.0\",\r\n\t\tTimestamp:     time.Now().Format(time.RFC3339),\r\n\t\tIssues:        issues,\r\n\t}\r\n\r\n\tman := manifest.Validate(manifestPath)\r\n\trep.Manifest = ManifestPart{\r\n\t\tValid:    man.Valid,\r\n\t\tWarnings: man.Warnings,\r\n\t\tErrors:   man.Errors,\r\n\t}\r\n\tif !man.Valid {\r\n\t\tissues = append(issues, fmt.Sprintf(\"Manifest validation failed: %s\", strings.Join(man.Errors, \"; \")))\r\n\t}\r\n\r\n\tcheckpointValid := true\r\n\tif checkpointPath != \"\" {\r\n\t\tcp, err := mlck.ParseFile(checkpointPath)\r\n\t\tif err != nil {"]
[3268.135658, "o", "\r\n\t\t\tcheckpointValid = false\r\n\t\t\trep.Checkpoint = &CheckpointPart{\r\n\t\t\t\tValid: false,\r\n\t\t\t\tError: err.Error(),\r\n\t\t\t}\r\n\t\t\tissues = append(issues, fmt.Sprintf(\"Checkpoint verification failed: %v\", err))\r\n\t\t} else {\r\n\t\t\trep.Checkpoint = &CheckpointPart{\r\n\t\t\t\tValid:        true,\r\n\t\t\t\tNumTensors:   len(cp.Tensors),\r\n"]
[3268.135727, "o", "\t\t\t\tFileChecksum: cp.FileChecksum,\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tcomparisonMatch := true\r\n\tif checkpointPath != \"\" && comparePath != \"\" {\r\n\t\tc1, err := mlck.ParseFile(checkpointPath)\r\n\t\tif err != nil {\r\n\t\t\tcomparisonMatch = false\r\n\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\tMatch: false,\r\n"]
[3268.135803, "o", "\t\t\t\tError: fmt.Sprintf(\"checkpoint parse failed: %v\", err),\r\n\t\t\t}\r\n\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\t\t} else {\r\n\t\t\tc2, err := mlck.ParseFile(comparePath)\r\n\t\t\tif err != nil {\r\n"]
[3268.135874, "o", "\t\t\t\tcomparisonMatch = false\r\n\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\t\tMatch: false,\r\n\t\t\t\t\tError: fmt.Sprintf(\"compare checkpoint parse failed: %v\", err),\r\n\t\t\t\t}\r\n\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\t\t\t} else {\r\n\t\t\t\tres, err := compare.Compare(c1, c2, \"strict\", 1e-7, 1e-5)\r\n\t\t\t\tif err != nil {\r\n\t\t\t\t\tcomparisonMatch = false\r\n\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\t\t\tMatch: false,\r\n\t\t\t\t\t\tError: err.Error(),\r\n\t\t\t\t\t}\r\n\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))"]
