[3935.097633, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path(\"internal/report/report.go\")\nlines = p.read_text().splitlines(keepends=True)\n\nnew_block = \"\"\"\\t\\t\\t\\t\\tdiffer := 0\n\\t\\t\\t\\t\\ttotal := len(res.TensorResults)\n\\t\\t\\t\\t\\tfor _, tr := range res.TensorResults {\n\\t\\t\\t\\t\\t\\tif !tr.Match {\n\\t\\t\\t\\t\\t\\t\\tdiffer++\n\\t\\t\\t\\t\\t\\t}\n\\t\\t\\t\\t\\t}\n\\t\\t\\t\\t\\tmissing := len(res.MissingInFile1) + len(res.MissingInFile2)\n\\t\\t\\t\\t\\tsummary := fmt.Sprintf(\"%d/%d tensors differ\", differ, total)\n\\t\\t\\t\\t\\tif missing > 0 {\n\\t\\t\\t\\t\\t\\tsummary = fmt.Sprintf(\"%s, %d tensors missing\", summary, missing)\n\\t\\t\\t\\t\\t}\n\\t\\t\\t\\t\\trep.Comparison = &ComparisonPart{\n\\t\\t\\t\\t\\t\\tMatch:   res.Match,\n\\t\\t\\t\\t\\t\\tSummary: summary,\n\\t\\t\\t\\t\\t}\n\\t\\t\\t\\t\\tif !res.Match {\n\\t\\t\\t\\t\\t\\tcomparisonMatch = false\n\\t\\t\\t\\t\\t\\tissues = append(issues, fmt.Sprintf(\"Tensor comparison failed: %s\", summary))\n\\t\\t\\t\\t\\t}\n\"\"\"\n\n# Replace 1-indexed lines 116-134 with the new block.\nlines[115:134] = [new_block]\np.write_text(\"\".join(lines))\nPY\n"]
