[4412.45035, "o", "     1\tpackage mlck\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"crypto/sha256\"\r\n     6\t\t\"encoding/binary\"\r\n     7\t\t\"encoding/hex\"\r\n     8\t\t\"encoding/json\"\r\n     9\t\t\"fmt\"\r\n    10\t\t\"math\"\r\n    11\t\t\"os\"\r\n    12\t)\r\n    13\t\r\n    14\tconst (\r\n    15\t\tMagic      = \"MLCK\"\r\n    16\t\tVersion    = 1\r\n    17\t\tHeaderSize = 16\r\n    18\t\tFooterSize = 32\r\n    19\t)\r\n    20\t\r\n    21\ttype Dtype uint8\r\n"]
