[962.566518, "o", "cat > internal/lineage/lineage.go <<'EOF'\r\n\u001b[?2004l\roots := make([]string, 0)\r\n    leaves := m"]
[962.566626, "i", "ld, depth+1)\n        }\n    }\n    for _, r := range roots {\n        depthDFS(r, 1)\n    }\n\n    result.NumExperiments = len(exps)\n    result.NumRoots = len(roots)\n    result.NumLeaves = len(leaves)\n    result.MaxDepth = maxDepth\n    result.TopologicalOrder = topo\n    return result\n}\n\nfunc detectCycle(exps []Experiment) []string {\n    adj := make(map[string][]string)\n    for _, e := range exps {\n        for _, p := range e.Parents {\n            adj[p] = append(adj[p], e.ID)\n        }\n    }\n\n    state := make(map[string]int)\n    var stack []string\n    var cycle []string\n\n    var dfs func(id string) bool\n    dfs = func(id string) bool {\n        state[id] = 1\n        stack = append(stack, id)\n        for _, child := range adj[id] {\n            if state[child] == 1 {\n                idx := -1\n                for i := len(stack) - 1; i >= 0; i-- {\n                    if stack[i] == child {\n                        idx = i\n                        break\n                    }\n                }\n                if idx >= 0 "]
[962.566685, "o", "\u001b[?2004h> "]
[962.566747, "i", "{\n                    cycle = append([]string{}, stack[idx:]...)\n                    return true\n                }\n            }\n            if state[child] == 0 {\n                if dfs(child) {\n                    return true\n                }\n            }\n        }\n        stack = stack[:len(stack)-1]\n        state[id] = 2\n        return false\n    }\n\n    for _, e := range exps {\n        if state[e.ID] == 0 {\n            if dfs(e.ID) {\n                return cycle\n            }\n        }\n    }\n    return nil\n}\nEOF\n"]
