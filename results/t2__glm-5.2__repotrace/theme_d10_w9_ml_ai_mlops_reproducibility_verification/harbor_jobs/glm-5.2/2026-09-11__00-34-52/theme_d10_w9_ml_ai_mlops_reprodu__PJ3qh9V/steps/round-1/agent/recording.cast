[4263.921679, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('internal/app/app.go')\ns = p.read_text()\n\nold = '''func parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {\n\\tvar positional []string\n\\tvar flagArgs []string\n\n\\tfor i := 0; i < len(args); i++ {\n\\t\\targ := args[i]\n\\t\\tif arg == \"--\" {\n\\t\\t\\tpositional = append(positional, args[i+1:]...)\n\\t\\t\\tbreak\n\\t\\t}\n\\t\\tif strings.HasPrefix(arg, \"--\") {\n\\t\\t\\tif strings.Contains(arg, \"=\") {\n\\t\\t\\t\\tflagArgs = append(flagArgs, arg)\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}\n\\t\\t\\tif i+1 >= len(args) {\n\\t\\t\\t\\treturn nil, fmt.Errorf(\"flag %s requires a value\", arg)\n\\t\\t\\t}\n\\t\\t\\tflagArgs = append(flagArgs, arg+\"=\"+args[i+1])\n\\t\\t\\ti++\n\\t\\t} else {\n\\t\\t\\tpositional = append(positional, arg)\n\\t\\t}\n\\t}\n\n\\tif err := fs.Parse(flagArgs); err != nil {\n\\t\\treturn nil, err\n\\t}\n\\treturn positional, nil\n}\n'''\n\nnew = '''func parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {\n\\tvar positional []string\n\\tvar flagArgs []string\n\n\\tfor i := 0; i < len(args); i++ {\n\\t\\targ :="]
[4263.922016, "i", " args[i]\n\\t\\tif arg == \"--\" {\n\\t\\t\\tpositional = append(positional, args[i+1:]...)\n\\t\\t\\tbreak\n\\t\\t}\n\\t\\tif strings.HasPrefix(arg, \"--\") {\n\\t\\t\\tif strings.Contains(arg, \"=\") {\n\\t\\t\\t\\tflagArgs = append(flagArgs, arg)\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}\n\\t\\t\\tif isBoolFlag(fs, arg) {\n\\t\\t\\t\\tflagArgs = append(flagArgs, arg+\"=true\")\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}\n\\t\\t\\tif i+1 >= len(args) {\n\\t\\t\\t\\treturn nil, fmt.Errorf(\"flag %s requires a value\", arg)\n\\t\\t\\t}\n\\t\\t\\tflagArgs = append(flagArgs, arg+\"=\"+args[i+1])\n\\t\\t\\ti++\n\\t\\t} else {\n\\t\\t\\tpositional = append(positional, arg)\n\\t\\t}\n\\t}\n\n\\tif err := fs.Parse(flagArgs); err != nil {\n\\t\\treturn nil, err\n\\t}\n\\treturn positional, nil\n}\n\nfunc isBoolFlag(fs *flag.FlagSet, arg string) bool {\n\\tname := strings.TrimPrefix(arg, \"--\")\n\\tif i := strings.IndexByte(name, '='); i >= 0 {\n\\t\\tname = name[:i]\n\\t}\n\\tf := fs.Lookup(name)\n\\tif f == nil {\n\\t\\treturn false\n\\t}\n\\ttype boolFlag interface {\n\\t\\tIsBoolFlag() bool\n\\t}\n\\tbf, ok := f.Value.(boolFlag)\n\\treturn ok && bf.IsBoolFlag()\n}\n'''\n\n"]
[4263.922106, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[4263.922195, "i", "if old not in s:\n    raise SystemExit('parseMixedArgs block not found')\ns = s.replace(old, new)\np.write_text(s)\nPY\n"]
