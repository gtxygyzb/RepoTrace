[5447.881463, "o", "\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \u001b[01;31m\u001b[KFloat32\u001b[m\u001b[K, \u001b[01;31m\u001b[KInt32\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \u001b[01;31m\u001b[KFloat64\u001b[m\u001b[K, \u001b[01;31m\u001b[KInt64\u001b[m\u001b[K:\r\n"]
[5447.881522, "o", "\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype Tensor\u001b[m\u001b[K struct {\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype Tensor\u001b[m\u001b[KInfo struct {\r\n"]
[5447.881617, "o", "\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype Checkpoint\u001b[m\u001b[K struct {\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KVersion\u001b[m\u001b[K      uint32\r\n"]
[5447.881671, "o", "\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif len(data) < \u001b[01;31m\u001b[KHeaderSize\u001b[m\u001b[K+FooterSize {\r\n\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif string(data[0:4]) != \u001b[01;31m\u001b[KMagic\u001b[m\u001b[K {\r\n"]
[5447.881729, "o", "\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif version != \u001b[01;31m\u001b[KVersion\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif len(data) < \u001b[01;31m\u001b[KHeaderSize\u001b[m\u001b[K+int(metaLen)+FooterSize {\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmetaRaw := data[\u001b[01;31m\u001b[KHeaderSize\u001b[m\u001b[K : \u001b[01;31m\u001b[KHeaderSize\u001b[m\u001b[K+int(metaLen)]\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\toffset := \u001b[01;31m\u001b[KHeaderSize\u001b[m\u001b[K + int(metaLen)\r\n"]
[5447.8818, "o", "\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KVersion\u001b[m\u001b[K:      version,\r\n"]
[5447.881871, "o", "\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc Build\u001b[m\u001b[K(metadata map[string]interface{}, tensors []Tensor) ([]byte, error) {\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\theader := make([]byte, \u001b[01;31m\u001b[KHeaderSize\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcopy(header[0:4], \u001b[01;31m\u001b[KMagic\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tbinary.LittleEndian.PutUint32(header[4:8], \u001b[01;31m\u001b[KVersion\u001b[m\u001b[K)\r\n"]
[5447.881929, "o", "\u001b[32m\u001b[K281\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (t Tensor) \u001b[01;31m\u001b[KFloat64\u001b[m\u001b[KValues() ([]float64, error) {\r\n\u001b[32m\u001b[K294\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \u001b[01;31m\u001b[KFloat32\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tvals[i] = float64(math.\u001b[01;31m\u001b[KFloat32\u001b[m\u001b[Kfrombits(bits))\r\n"]
[5447.881985, "o", "\u001b[32m\u001b[K297\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \u001b[01;31m\u001b[KFloat64\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K299\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tvals[i] = math.\u001b[01;31m\u001b[KFloat64\u001b[m\u001b[Kfrombits(bits)\r\n\u001b[32m\u001b[K300\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \u001b[01;31m\u001b[KInt32\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \u001b[01;31m\u001b[KInt64\u001b[m\u001b[K:\r\n"]
[5447.88213, "o", "\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc EncodeFloat64Values\u001b[m\u001b[K(vals []float64, dtype uint8) ([]byte, error) {\r\n\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \u001b[01;31m\u001b[KFloat32\u001b[m\u001b[K:\r\n"]
[5447.882191, "o", "\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif err := binary.Write(&buf, binary.LittleEndian, math.\u001b[01;31m\u001b[KFloat32\u001b[m\u001b[Kbits(float32(v))); err != nil {\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \u001b[01;31m\u001b[KFloat64\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif err := binary.Write(&buf, binary.LittleEndian, math.\u001b[01;31m\u001b[KFloat64\u001b[m\u001b[Kbits(v)); err != nil {\r\n\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \u001b[01;31m\u001b[KInt32\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \u001b[01;31m\u001b[KInt64\u001b[m\u001b[K:\r\n"]
[5447.882267, "o", "\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \u001b[01;31m\u001b[KInt32\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K352\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \u001b[01;31m\u001b[KInt64\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \u001b[01;31m\u001b[KFloat32\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \u001b[01;31m\u001b[KFloat64\u001b[m\u001b[K:\r\n"]
