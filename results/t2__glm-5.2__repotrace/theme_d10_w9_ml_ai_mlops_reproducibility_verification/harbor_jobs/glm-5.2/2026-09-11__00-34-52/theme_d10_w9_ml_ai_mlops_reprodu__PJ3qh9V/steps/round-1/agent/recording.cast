[5214.598619, "i", "sed -n '1,240p' internal/drift/drift.go\n"]
[5214.598967, "o", "sed -n '1,240p' internal/drift/drift.go\r\n\u001b[?2004l\r"]
[5214.602005, "o", "package drift\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"sort\"\r\n\r\n\t\"repro-verify/internal/mlck\"\r\n)\r\n\r\n"]
[5214.602103, "o", "type TensorResult struct {\r\n\tName           string    `json:\"name\"`\r\n\tStepChanges    []float64 `json:\"step_changes\"`\r\n\tMeanChange     float64   `json:\"mean_change\"`\r\n\tMaxChange      float64   `json:\"max_change\"`\r\n\tConvergence    string    `json:\"convergence\"`\r\n\tStabilityScore float64   `json:\"stability_score\"`\r\n}\r\n\r\ntype Result struct {\r\n\tNumSnapshots       int            `json:\"num_snapshots\"`\r\n\tNumAnalyzedTensors int            `json:\"num_analyzed_tensors\"`\r\n\tSkippedTensors     []string       `json:\"skipped_tensors\"`\r\n\tTensors            []TensorResult `json:\"tensors\"`\r\n\tOverallConvergence string         `json:\"overall_convergence\"`\r\n\tTopK               *int           `json:\"top_k,omitempty\"`\r\n}\r\n\r\n"]
[5214.602178, "o", "// Analyze remains available for callers that do not need a top-k restriction.\r\nfunc Analyze(files []string) (*Result, error) {\r\n\treturn AnalyzeWithTopK(files, nil)\r\n}\r\n\r\n// AnalyzeWithTopK analyzes drift and optionally restricts the returned tensor\r\n// list to the N tensors with the lowest stability scores. When topK > 0 the\r\n// result includes a top_k field set to the requested N, even if fewer tensors\r\n// are returned.\r\nfunc AnalyzeWithTopK(files []string, topK *int) (*Result, error) {\r\n\tif len(files) < 2 {\r\n\t\treturn nil, fmt.Errorf(\"at least 2 input files required\")\r\n\t}\r\n"]
[5214.60231, "o", "\r\n\tcps := make([]*mlck.Checkpoint, len(files))\r\n\tfor i, f := range files {\r\n\t\tcp, err := mlck.ParseFile(f)\r\n"]
[5214.602378, "o", "\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n\t\t}\r\n\t\tcps[i] = cp\r\n\t}\r\n\r\n\tvar allNames []string\r\n\tseen := map[string]bool{}\r\n\tfor _, cp := range cps {\r\n\t\tfor _, t := range cp.Tensors {\r\n\t\t\tif !seen[t.Name] {\r\n\t\t\t\tseen[t.Name] = true\r\n\t\t\t\tallNames = append(allNames, t.Name)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tsort.Strings(allNames)\r\n\r\n\tskipped := []string{}\r\n\ttensors := []TensorResult{}\r\n\tconverging := 0\r\n"]
[5214.602448, "o", "\tdiverging := 0\r\n\r\n\tfor _, name := range allNames {\r\n\t\tok := true\r\n\t\tvar shape []uint32\r\n\t\tfor _, cp := range cps {\r\n\t\t\tt, exists := tensorByName(cp, name)\r\n\t\t\tif !exists {\r\n\t\t\t\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\tif shape == nil {\r\n\t\t\t\tshape = t.Shape\r\n\t\t\t"]
[5214.602513, "o", "} else if !shapesEqual(shape, t.Shape) {\r\n\t\t\t\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif !ok {\r\n\t\t\tskipped = append(skipped, name)\r\n\t\t\tcontinue\r\n\t\t}"]
[5214.60257, "o", "\r\n\r\n\t\tsteps := make([]float64, len(cps)-1)\r\n\t\tfor i := 0; i < len(steps); i++ {\r\n\t\t\tv1, err := tensorData(cps[i], name)\r\n\t"]
[5214.602633, "o", "\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tv2, err := tensorData(cps[i+1], name)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tn := len(v1)\r\n\t\t\tif n == 0 {\r\n\t"]
[5214.602723, "o", "\t\t\tsteps[i] = 0\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvar sum float64\r\n\t\t\tfor j := 0; j < n; j++ {\r\n\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n\t\t\t}\r\n"]
[5214.602786, "o", "\t\t\tsteps[i] = sum / float64(n)\r\n\t\t}\r\n\r\n\t\tmean := meanFloat64(steps)\r\n\t\tmax := maxFloat64(steps)\r\n\t\tconvergence := classifyConvergence(steps)\r\n\t\tstability := 1.0\r\n\t\tif max != 0 {\r\n\t\t\tstability = 1.0 - steps[len(steps)-1]/max\r\n\t\t\tif stability < 0 {\r\n\t\t\t\tstability = 0\r\n\t\t\t} else if stability > 1 {\r\n\t\t\t\tstability = 1\r\n"]
[5214.602874, "o", "\t\t\t}\r\n\t\t}\r\n\r\n\t\ttensors = append(tensors, TensorResult{\r\n\t\t\tName:           name,\r\n\t\t\tStepChanges:    steps,\r\n\t\t\tMeanChange:     mean,\r\n\t\t\tMaxChange:      max,\r\n\t\t\tConvergence:    convergence,\r\n\t\t\tStabilityScore: stability,\r\n"]
[5214.602941, "o", "\t\t})\r\n\r\n\t\tif convergence == \"converging\" {\r\n\t\t\tconverging++\r\n\t\t} else if convergence == \"diverging\" {\r\n\t\t\tdiverging++\r\n\t\t}\r\n\t}\r\n\r\n\toverall := \"mixed\"\r\n\tif converging > len(tensors)/2 {\r\n\t\toverall = \"converging\"\r\n\t} else if diverging > len(tensors)/2 {\r\n\t\toverall = \"diverging\"\r\n"]
[5214.603003, "o", "\t}\r\n\r\n\tsort.Strings(skipped)\r\n\tsort.Slice(tensors, func(i, j int) bool {\r\n"]
[5214.603066, "o", "\t\treturn tensors[i].Name < tensors[j].Name\r\n\t})\r\n\r\n\tresult := &Result{\r\n\t\tNumSnapshots:       len(files),\r\n\t\tNumAnalyzedTensors: len(tensors),\r\n\t\tSkippedTensors:     skipped,\r\n\t\tTensors:            tensors,\r\n\t\tOverallConvergence: overall,\r\n\t}\r\n\tapplyTopK(result, topK)\r\n\treturn result, nil\r\n}\r\n\r\nfunc applyTopK(result *Result, topK *int) {\r\n\tif topK == nil {\r\n\t\treturn\r\n\t}\r\n"]
[5214.603135, "o", "\r\n\trequested := *topK\r\n\tsort.SliceStable(result.Tensors, func(i, j int) bool {\r\n\t\tif result.Tensors[i].StabilityScore != result.Tensors[j].StabilityScore {\r\n\t\t\treturn result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore\r\n\t\t}\r\n\t\treturn result.Tensors[i].Name < result.Tensors[j].Name\r\n\t})\r\n\tif requested < len(result.Tensors) {\r\n\t\tresult.Tensors = result.Tensors[:requested]\r\n\t}\r\n"]
[5214.603197, "o", "\tresult.TopK = &requested\r\n}\r\n\r\nfunc tensorData(cp *mlck.Checkpoint, name string) ([]float64, error) {\r\n\tt, ok := tensorByName(cp, name)\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"tensor %s not found\", name)\r\n\t}\r\n\treturn t.Float64Values()\r\n}\r\n\r\n"]
[5214.603275, "o", "func tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {\r\n\tfor _, t := range cp.Tensors {\r\n\t\tif t.Name == name {\r\n\t\t\treturn t, true\r\n\t\t}\r\n\t}\r\n\t"]
[5214.603306, "o", "return mlck.Tensor{}, false\r\n}\r\n\r\nfunc shapesEqual(a, b []uint32) bool {\r\n\tif len(a) != len(b) {\r\n\t\treturn false\r\n"]
[5214.603385, "o", "\t}\r\n\tfor i := range a {\r\n\t\tif a[i] != b[i] {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc meanFloat64(xs []float64) float64 {\r\n\tif len(xs) == 0 {\r\n"]
[5214.603442, "o", "\t\treturn 0\r\n\t}\r\n\tvar sum float64\r\n\tfor _, x := range xs {\r\n\t\tsum += x\r\n\t}\r\n\treturn sum / float64(len(xs))\r\n}\r\n\r\nfunc maxFloat64(xs []float64) float64 {\r\n"]
[5214.603502, "o", "\tif len(xs) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tm := xs[0]\r\n\tfor _, x := range xs[1:] {\r\n\t\tif x > m {\r\n\t\t\tm = x\r\n\t\t}\r\n\t}\r\n\treturn m\r\n}\r\n\r\nfunc classifyConvergence(steps []float64) string {\r\n"]
[5214.603558, "o", "\tif len(steps) <= 1 {\r\n\t\treturn \"converging\"\r\n\t}\r\n\tnonIncreasing := true\r\n\tnonDecreasing := true\r\n"]
[5214.604075, "o", "\u001b[?2004h"]
[5214.604132, "o", "root@n30009:/app# "]
[5214.883864, "i", "sed -n '1,320p' internal/app/app.go\n"]
[5214.884166, "o", "sed -n '1,320p' internal/app/app.go\r\n\u001b[?2004l\r"]
[5214.886999, "o", "package app\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"strings\"\r\n\r\n\t\"repro-verify/internal/compare\"\r\n\t\"repro-verify/internal/drift\"\r\n\t\"repro-verify/internal/lineage\"\r\n"]
[5214.887122, "o", "\t\"repro-verify/internal/manifest\"\r\n\t\"repro-verify/internal/merge\"\r\n\t\"repro-verify/internal/mlck\"\r\n\t\"repro-verify/internal/report\"\r\n)\r\n\r\n"]
[5214.887195, "o", "func Run() int {\r\n\tif len(os.Args) < 2 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"no subcommand provided\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"verify-checkpoint\":\r\n\t\treturn runVerifyCheckpoint(os.Args[2:])\r\n\tcase \"compare-outputs\":\r\n\t\treturn runCompareOutputs(os.Args[2:])\r\n\tcase \"validate-manifest\":\r\n\t\treturn runValidateManifest(os.Args[2:])\r\n\tcase \"audit-lineage\":\r\n\t\treturn runAuditLineage(os.Args[2:])\r\n\tcase \"generate-report\":\r\n\t\treturn runGenerateReport(os.Args[2:])\r\n\tcase \"merge-checkpoints\":\r\n\t\treturn runMergeCheckpoints(os.Args[2:])\r\n\tcase \"drift-analysis\":\r\n\t\treturn runDriftAnalysis(os.Args[2:])\r\n\tdefault:\r\n\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"unknown subcommand: %s\", os.Args[1])})\r\n\t\treturn 1\r\n\t}\r\n}\r\n\r\nfunc runVerifyCheckpoint(args []string) int {\r\n\tif len(args) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify verify-checkpoint <file>\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n"]
[5214.887312, "o", "\tif _, err := os.ReadFile(args[0]); err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tcp, err := mlck.ParseFile(args[0])\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\r\n\t\t\t\"valid\": false,\r\n\t\t\t\"error\": err.Error(),\r\n\t\t})\r\n\t"]
[5214.887383, "o", "\treturn 1\r\n\t}\r\n\r\n\tmetadata := cp.Metadata\r\n\tif metadata == nil {\r\n\t\tmetadata = map[string]interface{}{}\r\n\t}\r\n\ttensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))\r\n\tfor _, t := range cp.Tensors {\r\n\t\ttensors = append(tensors, t.Info())\r\n\t}\r\n\r\n\toutputJSON(map[string]interface{}{\r\n\t\t\"valid\":          true,\r\n\t\t\"format_version\": int(cp.Version),\r\n"]
[5214.887446, "o", "\t\t\"num_tensors\":    len(cp.Tensors),\r\n\t\t\"metadata\":       metadata,\r\n"]
[5214.887527, "o", "\t\t\"tensors\":        tensors,\r\n\t\t\"file_checksum\":  cp.FileChecksum,\r\n\t})\r\n\treturn 0\r\n}\r\n\r\nfunc runCompareOutputs(args []string) int {\r\n\tfs := flag.NewFlagSet(\"compare-outputs\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tatol := fs.Float64(\"atol\", 1e-7, \"absolute tolerance\")\r\n\trtol := fs.Float64(\"rtol\", 1e-5, \"relative tolerance\")\r\n\tmode := fs.String(\"mode\", \"strict\", \"comparison mode\")\r\n"]
[5214.887594, "o", "\thistogram := fs.Bool(\"histogram\", false, \"include diff histograms\")\r\n\r\n\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tif len(pos) != 2 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify compare-outputs <file1> <file2> [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n"]
[5214.887663, "o", "\r\n\tc1, err := mlck.ParseFile(pos[0])\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"file1: %v\", err)})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tc2, err := mlck.ParseFile(pos[1])\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"file2: %v\", err)})\r\n\t\treturn 1\r\n\t}\r\n\r\n"]
[5214.887727, "o", "\tres, err := compare.Compare(c1, c2, *mode, *atol, *rtol, *histogram)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\r\n\toutputJSON(res)\r\n\tif res.Match {\r\n\t\treturn 0\r\n\t}\r\n"]
[5214.887794, "o", "\treturn 1\r\n}\r\n\r\nfunc runValidateManifest(args []string) int {\r\n\tif len(args) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify validate-manifest <file.toml>\"})\r\n\t\treturn 1\r\n\t}\r\n\tif _, err := os.ReadFile(args[0]); err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tres := manifest.Validate(args[0])\r\n"]
[5214.887889, "o", "\toutputJSON(res)\r\n\tif res.Valid {\r\n\t\treturn 0\r\n\t}\r\n\treturn 1\r\n}\r\n\r\nfunc runAuditLineage(args []string) int {\r\n\tif len(args) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify audit-lineage <file.json>\"})\r\n"]
[5214.887951, "o", "\t\treturn 1\r\n\t}\r\n\tif _, err := os.ReadFile(args[0]); err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tres := lineage.Audit(args[0])\r\n\toutputJSON(res)\r\n\tif res.Valid {\r\n\t\treturn 0\r\n\t}\r\n\treturn 1\r\n}\r\n\r\nfunc runGenerateReport(args []string) int {\r\n\tfs := flag.NewFlagSet(\"generate-report\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n"]
[5214.888018, "o", "\tcheckpoint := fs.String(\"checkpoint\", \"\", \"checkpoint file to verify\")\r\n\tcomparePath := fs.String(\"compare\", \"\", \"second checkpoint to compare\")\r\n\tlineagePath := fs.String(\"lineage\", \"\", \"lineage file to audit\")\r\n\r\n\t"]
[5214.888052, "o", "pos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tif len(pos) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify generate-report <manifest.toml> [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tfor _, p := range []string{pos[0], *checkpoint, *comparePath, *lineagePath} {\r\n\t"]
[5214.88814, "o", "\tif p == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif _, err := os.ReadFile(p); err != nil {\r\n\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\t\treturn 1\r\n\t\t}\r\n\t}\r\n\r\n\trep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)\r\n\toutputJSON(rep)\r\n\treturn code\r\n}\r\n\r\nfunc runMergeCheckpoints(args []string) int {\r\n"]
[5214.888206, "o", "\tfs := flag.NewFlagSet(\"merge-checkpoints\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tconflict := fs.String(\"conflict\", \"first\", \"conflict strategy\")\r\n\r\n\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tif len(pos) < 3 {\r\n"]
[5214.888282, "o", "\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tres, err := merge.Merge(pos[0], pos[1:], *conflict)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\toutputJSON(res)\r\n\treturn 0\r\n}\r\n"]
[5214.888352, "o", "\r\nfunc runDriftAnalysis(args []string) int {\r\n\tfs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\r\n\ttopK := fs.Int(\"top-k\", 0, \"number of tensors with the lowest stability scores to include\")\r\n\r\n\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tif len(pos) < 2 {\r\n\t"]
[5214.888418, "o", "\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tvar topKPtr *int\r\n\tfs.Visit(func(f *flag.Flag) {\r\n\t\tif f.Name == \"top-k\" {\r\n\t\t\tv := *topK\r\n\t\t\ttopKPtr = &v\r\n\t\t}\r\n\t})\r\n"]
[5214.888483, "o", "\tif topKPtr != nil && *topKPtr < 0 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"--top-k must be non-negative\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tres, err := drift.AnalyzeWithTopK(pos, topKPtr)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n"]
[5214.888553, "o", "\toutputJSON(res)\r\n\treturn 0\r\n}\r\n\r\nfunc parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {\r\n\tvar positional []string\r\n\tvar flagArgs []string\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tif arg == \"--\" {\r\n\t\t\tpositional = append(positional, args[i+1:]...)\r\n\t\t\tbreak\r\n"]
[5214.888619, "o", "\t\t}\r\n\t\tif strings.HasPrefix(arg, \"--\") {\r\n\t\t\tif strings.Contains(arg, \"=\") {\r\n\t\t\t\tflagArgs = append(flagArgs, arg)\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif isBoolFlag(fs, arg) {\r\n\t\t\t\tflagArgs = append(flagArgs, arg+\"=true\")\r\n\t\t\t\tcontinue\r\n\t\t"]
[5214.888685, "o", "\t}\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn nil, fmt.Errorf(\"flag %s requires a value\", arg)\r\n\t\t\t}\r\n\t\t\tflagArgs = append(flagArgs, arg+\"=\"+args[i+1])\r\n\t\t\ti++\r\n\t\t} else {\r\n\t\t\tpositional = append(positional, arg)\r\n\t\t}\r\n\t}\r\n"]
[5214.888748, "o", "\r\n\tif err := fs.Parse(flagArgs); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn positional, nil\r\n}\r\n\r\nfunc isBoolFlag(fs *flag.FlagSet, arg string) bool {\r\n\tname := strings.TrimPrefix(arg, \"--\")\r\n\tif i := strings.IndexByte(name, '='); i >= 0 {\r\n"]
[5214.888807, "o", "\t\tname = name[:i]\r\n\t}\r\n\tf := fs.Lookup(name)\r\n\tif f == nil {\r\n\t\treturn false\r\n\t}\r\n\ttype boolFlag interface {\r\n\t\tIsBoolFlag() bool\r\n\t}\r\n\tbf, ok := f.Value.(boolFlag)"]
[5214.888867, "o", "\r\n\treturn ok && bf.IsBoolFlag()\r\n}\r\n\r\nfunc outputJSON(v interface{}) {\r\n\tenc := json.NewEncoder(os.Stdout)\r\n\tenc.SetIndent(\"\", \"  \")\r\n\tenc.SetEscapeHTML(false)\r\n\t_ = enc.Encode(v)\r\n}\r\n"]
