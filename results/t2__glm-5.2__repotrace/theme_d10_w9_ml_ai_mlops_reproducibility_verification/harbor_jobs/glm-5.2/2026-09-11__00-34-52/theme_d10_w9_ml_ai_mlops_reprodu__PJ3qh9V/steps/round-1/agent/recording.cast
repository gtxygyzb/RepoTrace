[4627.769072, "o", "\tfunc Analyze(files []string) (*Result, error) {\r\n    29\t\tif len(files) < 2 {\r\n    30\t\t\treturn nil, fmt.Errorf(\"at least 2 input files required\")\r\n    31\t\t}\r\n    32\t\r\n    33\t\tcps := make([]*mlck.Checkpoint, len(files))\r\n    34\t\tfor i, f := range files {\r\n    35\t\t\tcp, err := mlck.ParseFile(f)\r\n    36\t\t\tif err != nil {\r\n    37\t\t\t\treturn nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n    38\t\t\t}\r\n    39\t\t\tcps[i] = cp\r\n    40\t\t}\r\n    41\t\r\n    42\t\tvar allNames []string\r\n    43\t\tseen := map[string]bool{}\r\n    44\t\tfor _, cp := range cps {\r\n"]
[4627.7692, "o", "    45\t\t\tfor _, t := range cp.Tensors {\r\n    46\t\t\t\tif !seen[t.Name] {\r\n    47\t\t\t\t\tseen[t.Name] = true\r\n    48\t\t\t\t\tallNames = append(allNames, t.Name)\r\n    49\t\t\t\t}\r\n    50\t\t\t}\r\n    51\t\t}\r\n    52\t\tsort.Strings(allNames)\r\n    53\t\r\n    54\t\tskipped := []string{}\r\n    55\t\ttensors := []TensorResult{}\r\n    56\t\tconverging := 0\r\n    57\t\tdiverging := 0\r\n    58\t\r\n    59\t\tfor _, name := range allNames {\r\n    60\t\t\tok := true\r\n    61\t\t\tvar shape []uint32\r\n"]
[4627.769305, "o", "    62\t\t\tfor _, cp := range cps {\r\n    63\t\t\t\tt, exists := tensorByName(cp, name)\r\n    64\t\t\t\tif !exists {\r\n    65\t\t\t\t\tok = false\r\n    66\t\t\t\t\tbreak\r\n    67\t\t\t\t}\r\n    68\t\t\t\tif shape == nil {\r\n    69\t\t\t\t\tshape = t.Shape\r\n    70\t\t\t\t} else if !shapesEqual(shape, t.Shape) {\r\n    71\t\t\t\t\tok = false\r\n    72\t\t\t\t\tbreak\r\n    73\t\t\t\t}\r\n"]
[4627.769384, "o", "    74\t\t\t}\r\n    75\t\t\tif !ok {\r\n    76\t\t\t\tskipped = append(skipped, name)\r\n    77\t\t\t\tcontinue\r\n    78\t\t\t}\r\n"]
[4627.769456, "o", "    79\t\r\n    80\t\t\tsteps := make([]float64, len(cps)-1)\r\n    81\t\t\tfor i := 0; i < len(cps)-1; i++ {\r\n    82\t\t\t\tt1, _ := tensorByName(cps[i], name)\r\n    83\t\t\t\tt2, _ := tensorByName(cps[i+1], name)\r\n    84\t\t\t\tv1, err := t1.Float64Values()\r\n    85\t\t\t\tif err != nil {\r\n    86\t\t\t\t\treturn nil, err\r\n    87\t\t\t\t}\r\n    88\t\t\t\tv2, err := t2.Float64Values()\r\n    89\t\t\t\tif err != nil {\r\n    90\t\t\t\t\treturn nil, err\r\n    91\t\t\t\t}\r\n    92\t\t\t\tn := len(v1)\r\n    93\t\t\t\tif n == 0 {\r\n    94\t\t\t\t\tsteps[i] = 0\r\n"]
[4627.769522, "o", "    95\t\t\t\t\tcontinue\r\n    96\t\t\t\t}\r\n    97\t\t\t\tvar sum float64\r\n    98\t\t\t\tfor j := 0; j < n; j++ {\r\n    99\t\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n   100\t\t\t\t}\r\n   101\t\t\t\tsteps[i] = sum / float64(n)\r\n   102\t\t\t}\r\n"]
[4627.769594, "o", "   103\t\r\n   104\t\t\tmean := meanFloat64(steps)\r\n   105\t\t\tmax := maxFloat64(steps)\r\n   106\t\t\tconvergence := classifyConvergence(steps)\r\n   107\t\t\tstability := 1.0\r\n   108\t\t\tif steps[0] != 0 {\r\n   109\t\t\t\tstability = 1.0 - steps[len(steps)-1]/steps[0]\r\n   110\t\t\t\tif stability < 0 {\r\n   111\t\t\t\t\tstability = 0\r\n   112\t\t\t\t} else if stability > 1 {\r\n   113\t\t\t\t\t"]
[4627.769669, "o", "stability = 1\r\n   114\t\t\t\t}\r\n   115\t\t\t}\r\n   116\t\r\n   117\t\t\ttensors = append(tensors, TensorResult{\r\n   118\t\t\t\tName:           name,\r\n   119\t\t\t\tStepChanges:    steps,\r\n   120\t\t\t\tMeanChange:     mean,\r\n   121\t\t\t\tMaxChange:      max,\r\n   122\t\t\t\t"]
[4627.769735, "o", "Convergence:    convergence,\r\n   123\t\t\t\tStabilityScore: stability,\r\n   124\t\t\t})\r\n   125\t\r\n   126\t\t\tif convergence == \"converging\" {\r\n   127\t\t\t\tconverging++\r\n   128\t\t\t} else if convergence == \"diverging\" {\r\n   129\t\t\t\tdiverging++\r\n   130\t\t\t}\r\n   131\t\t}\r\n   132\t\r\n"]
[4627.769803, "o", "   133\t\toverall := \"mixed\"\r\n   134\t\tif converging > len(tensors)/2 {\r\n   135\t\t\toverall = \"converging\"\r\n   136\t\t} else if diverging > len(tensors)/2 {\r\n   137\t\t\toverall = \"diverging\"\r\n   138\t\t}\r\n   139\t\r\n   140\t\tsort.Strings(skipped)\r\n   141\t\tsort.Slice(tensors, func(i, j int) bool {\r\n   142\t\t\treturn tensors[i].Name < tensors[j].Name\r\n"]
[4627.769871, "o", "   143\t\t})\r\n   144\t\r\n   145\t\treturn &Result{\r\n   146\t\t\tNumSnapshots:       len(files),\r\n   147\t\t\tNumAnalyzedTensors: len(tensors),\r\n   148\t\t\tSkippedTensors:     skipped,\r\n   149\t\t\tTensors:            tensors,\r\n   150\t\t\tOverallConvergence: overall,\r\n   151\t\t}, nil\r\n   152\t}\r\n"]
[4627.769942, "o", "   153\t\r\n   154\tfunc tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {\r\n   155\t\tfor _, t := range cp.Tensors {\r\n   156\t\t\tif t.Name == name {\r\n   157\t\t\t\treturn t, true\r\n   158\t\t\t}\r\n   159\t\t}\r\n   160\t\treturn mlck.Tensor{}, false\r\n   161\t}\r\n   162\t\r\n   163\tfunc shapesEqual(a, b []uint32) bool {"]
[4627.770013, "o", "\r\n   164\t\tif len(a) != len(b) {\r\n   165\t\t\treturn false\r\n   166\t\t}\r\n   167\t\tfor i := range a {\r\n   168\t\t\tif a[i] != b[i] {\r\n   169\t\t\t\treturn false\r\n   170\t\t\t}\r\n   171\t\t}\r\n   172\t\treturn true\r\n   173\t}\r\n   174\t\r\n"]
[4627.770085, "o", "   175\tfunc meanFloat64(xs []float64) float64 {\r\n   176\t\tif len(xs) == 0 {\r\n   177\t\t\treturn 0\r\n   178\t\t}\r\n   179\t\tvar sum float64\r\n   180\t\tfor _, x := range xs {\r\n   181\t\t\tsum += x\r\n   182\t\t}\r\n   183\t\treturn sum / float64(len(xs))\r\n   184"]
[4627.770152, "o", "\t}\r\n   185\t\r\n   186\tfunc maxFloat64(xs []float64) float64 {\r\n   187\t\tif len(xs) == 0 {\r\n   188\t\t\treturn 0\r\n   189\t\t}\r\n   190\t\tm := xs[0]\r\n   191\t\tfor _, x := range xs[1:] {\r\n   192\t\t\tif x > m {\r\n"]
[4627.770218, "o", "   193\t\t\t\tm = x\r\n   194\t\t\t}\r\n   195\t\t}\r\n   196\t\treturn m\r\n   197\t}\r\n   198\t\r\n   199\tfunc classifyConvergence(steps []float64) string {\r\n   200\t\tif len(steps) <= 1 {\r\n   201\t\t\treturn \"converging\"\r\n   202\t\t}\r\n"]
[4627.77031, "o", "   203\t\tdecreasing := true\r\n   204\t\tincreasing := true\r\n   205\t\tfor i := 1; i < len(steps); i++ {\r\n   206\t\t\tif steps[i] >= steps[i-1] {\r\n   207\t\t\t\tdecreasing = false\r\n   208\t\t\t}\r\n   209\t\t\tif steps[i] <= steps[i-1] {\r\n   210\t\t\t\tincreasing = false\r\n   211\t\t\t}\r\n   212\t\t}\r\n   213\t\tif decreasing {\r\n   214\t\t\treturn \"converging\"\r\n"]
[4627.770383, "o", "   215\t\t}\r\n   216\t\tif increasing {\r\n   217\t\t\treturn \"diverging\"\r\n   218\t\t}\r\n   219\t\treturn \"oscillating\"\r\n   220\t}\r\n"]
