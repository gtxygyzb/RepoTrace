[4743.552565, "o", "\tfor _, t := range cp.Tensors {\r\n   156\t\t\tif t.Name == name {\r\n   157\t\t\t\treturn t, true\r\n   158\t\t\t}\r\n   159\t\t}\r\n   160\t\treturn mlck.Tensor{}, false\r\n   161\t}\r\n   162\t\r\n   163\tfunc shapesEqual(a, b []uint32) bool {\r\n   164\t\tif len(a) != len(b) {\r\n   165\t\t\treturn false\r\n"]
