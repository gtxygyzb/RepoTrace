[3334.090913, "o", "\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc Audit\u001b[m\u001b[K(path string) *Result {\r\n"]
[3334.091046, "o", "\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tdata, err := \u001b[01;31m\u001b[Kos.ReadFile\u001b[m\u001b[K(path)\r\n"]
