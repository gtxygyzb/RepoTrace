[1228.459548, "i", "cat > internal/drift/drift.go <<'EOF'\npackage drift\n\nimport (\n    \"fmt\"\n    \"math\"\n\n    \"repro-verify/internal/mlck\"\n)\n\ntype TensorResult struct {\n    Name string `json:\"name\"`\n    StepChanges []float64 `json:\"step_changes\"`\n    MeanChange float64 `json:\"mean_change\"`\n    MaxChange float64 `json:\"max_change\"`\n    Convergence string `json:\"convergence\"`\n    StabilityScore float64 `json:\"stability_score\"`\n}\n\ntype Result struct {\n    NumSnapshots int `json:\"num_snapshots\"`\n    NumAnalyzedTensors int `json:\"num_analyzed_tensors\"`\n    SkippedTensors []string `json:\"skipped_tensors\"`\n    Tensors []TensorResult `json:\"tensors\"`\n    OverallConvergence string `json:\"overall_convergence\"`\n}\n\nfunc Analyze(files []string) (*Result, error) {\n    if len(files) < 2 {\n        return nil, fmt.Errorf(\"at least 2 input files required\")\n    }\n\n    cps := make([]*mlck.Checkpoint, len(files))\n    for i, f := range files {\n        cp, err := mlck.ParseFile(f)\n        if err != nil {\n            return nil, fmt.Errorf(\"file %s: %v\","]
[1228.459734, "i", " f, err)\n        }\n        cps[i] = cp\n    }\n\n    var allNames []string\n    seen := map[string]bool{}\n    for _, cp := range cps {\n        for _, t := range cp.Tensors {\n            if !seen[t.Name] {\n                seen[t.Name] = true\n                allNames = append(allNames, t.Name)\n            }\n        }\n    }\n\n    skipped := []string{}\n    tensors := []TensorResult{}\n    converging := 0\n    diverging := 0\n\n    for _, name := range allNames {\n        ok := true\n        var shape []uint32\n        for _, cp := range cps {\n            t, exists := tensorByName(cp, name)\n            if !exists {\n                ok = false\n                break\n            }\n            if shape == nil {\n                shape = t.Shape\n            } else if !shapesEqual(shape, t.Shape) {\n                ok = false\n                break\n            }\n        }\n        if !ok {\n            skipped = append(skipped, name)\n            continue\n        }\n\n        steps := make([]float64, len(cps)-1)\n        for i := 0; i < len(c"]
[1228.459813, "i", "ps)-1; i++ {\n            t1 := tensorByName(cps[i], name)\n            t2 := tensorByName(cps[i+1], name)\n            v1, err := t1.Float64Values()\n            if err != nil {\n                return nil, err\n            }\n            v2, err := t2.Float64Values()\n            if err != nil {\n                return nil, err\n            }\n            n := len(v1)\n            if n == 0 {\n                steps[i] = 0\n                continue\n            }\n            var sum float64\n            for j := 0; j < n; j++ {\n                sum += math.Abs(v1[j] - v2[j])\n            }\n            steps[i] = sum / float64(n)\n        }\n\n        mean := meanFloat64(steps)\n        max := maxFloat64(steps)\n        convergence := classifyConvergence(steps)\n        stability := 1.0\n        if steps[0] != 0 {\n            stability = 1.0 - steps[len(steps)-1]/steps[0]\n            if stability < 0 {\n                stability = 0\n            } else if stability > 1 {\n                stability = 1\n            }\n        }\n\n        te"]
[1228.459878, "o", "cat > internal/drift/drift.go <<'EOF'\r\n\u001b[?2004l\r"]
[1228.45995, "i", "nsors = append(tensors, TensorResult{\n            Name: name,\n            StepChanges: steps,\n            MeanChange: mean,\n            MaxChange: max,\n            Convergence: convergence,\n            StabilityScore: stability,\n        })\n\n        if convergence == \"converging\" {\n            converging++\n        } else if convergence == \"diverging\" {\n            diverging++\n        }\n    }\n\n    overall := \"mixed\"\n    if converging > len(tensors)/2 {\n        overall = \"converging\"\n    } else if diverging > len(tensors)/2 {\n        overall = \"diverging\"\n    }\n\n    return &Result{\n        NumSnapshots: len(files),\n        NumAnalyzedTensors: len(tensors),\n        SkippedTensors: skipped,\n        Tensors: tensors,\n        OverallConvergence: overall,\n    }, nil\n}\n\nfunc tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {\n    for _, t := range cp.Tensors {\n        if t.Name == name {\n            return t, true\n        }\n    }\n    return mlck.Tensor{}, false\n}\n\nfunc shapesEqual(a, b []uint32) bool "]
[1228.460008, "o", "\u001b[?2004h> "]
[1228.460068, "i", "{\n    if len(a) != len(b) {\n        return false\n    }\n    for i := range a {\n        if a[i] != b[i] {\n            return false\n        }\n    }\n    return true\n}\n\nfunc meanFloat64(xs []float64) float64 {\n    if len(xs) == 0 {\n        return 0\n    }\n    var sum float64\n    for _, x := range xs {\n        sum += x\n    }\n    return sum / float64(len(xs))\n}\n\nfunc maxFloat64(xs []float64) float64 {\n    if len(xs) == 0 {\n        return 0\n    }\n    m := xs[0]\n    for _, x := range xs[1:] {\n        if x > m {\n            m = x\n        }\n    }\n    return m\n}\n\nfunc classifyConvergence(steps []float64) string {\n    if len(steps) <= 1 {\n        return \"converging\"\n    }\n    decreasing := true\n    increasing := true\n    for i := 1; i < len(steps); i++ {\n        if steps[i] >= steps[i-1] {\n            decreasing = false\n        }\n        if steps[i] <= steps[i-1] {\n            increasing = false\n        }\n    }\n    if decreasing {\n        return \"converging\"\n    }\n    if increasing {\n        return \"diverging\"\n    }\n    re"]
[1228.460125, "o", "package drift\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.460185, "i", "turn \"oscillating\"\n}\nEOF\n"]
