[4376.378261, "o", "     1\tpackage mlck\r\n     2\t\r\n     3\timport (\r\n"]
[4376.378329, "o", "     4\t\t\"bytes\"\r\n     5\t\t\"crypto/sha256\"\r\n     6\t\t\"encoding/binary\"\r\n     7\t\t\"encoding/hex\"\r\n     8\t\t\"encoding/json\"\r\n     9\t\t\"fmt\"\r\n    10\t\t\"math\"\r\n    11\t\t\"os\"\r\n    12\t)\r\n"]
[4376.378392, "o", "    13\t\r\n    14\tconst (\r\n    15\t\tMagic      = \"MLCK\"\r\n    16\t\tVersion    = 1\r\n    17\t\tHeaderSize = 16\r\n    18\t\tFooterSize = 32\r\n    19\t)\r\n    20\t\r\n    21\ttype Dtype uint8\r\n    22\t\r\n"]
[4376.378451, "o", "    23\tconst (\r\n    24\t\tFloat32 Dtype = 0\r\n    25\t\tFloat64 Dtype = 1\r\n    26\t\tInt32   Dtype = 2\r\n    27\t\tInt64   Dtype = 3\r\n    28\t)\r\n    29\t\r\n    30\tfunc (d Dtype) Valid() bool {"]
[4376.378508, "o", "\r\n    31\t\treturn d == Float32 || d == Float64 || d == Int32 || d == Int64\r\n    32\t}\r\n    33\t\r\n    34\tfunc (d Dtype) Name() string {\r\n    35\t\tswitch d {\r\n    36\t\tcase Float32:\r\n    37\t\t\treturn \"float32\"\r\n"]
[4376.378566, "o", "    38\t\tcase Float64:\r\n    39\t\t\treturn \"float64\"\r\n    40\t\tcase Int32:\r\n    41\t\t\treturn \"int32\"\r\n    42\t\tcase Int64:\r\n    43\t\t\treturn \"int64\"\r\n    44\t\tdefault:\r\n    45\t\t\treturn \"unknown\"\r\n    46"]
[4376.378623, "o", "\t\t}\r\n    47\t}\r\n    48\t\r\n    49\tfunc (d Dtype) Size() int {\r\n    50\t\tswitch d {\r\n    51\t\tcase Float32, Int32:\r\n    52\t\t\treturn 4\r\n    53\t\tcase Float64, Int64:\r\n"]
[4376.378688, "o", "    54\t\t\treturn 8\r\n    55\t\tdefault:\r\n    56\t\t\treturn 0\r\n    57\t\t}\r\n    58\t}\r\n    59\t\r\n    60\tfunc DtypeName(dtype uint8) string {\r\n    61\t\treturn Dtype(dtype).Name()\r\n    62\t}\r\n    63"]
[4376.378749, "o", "\t\r\n    64\tfunc DtypeSize(dtype uint8) int {\r\n    65\t\treturn Dtype(dtype).Size()\r\n    66\t}\r\n    67\t\r\n    68\tfunc Product(shape []uint32) int64 {\r\n    69\t\tp := int64(1)\r\n    70\t\tfor _, s := range shape {\r\n    71\t\t\tp *= int64(s)\r\n"]
[4376.378812, "o", "    72\t\t}\r\n    73\t\treturn p\r\n    74\t}\r\n    75\t\r\n    76\ttype Tensor struct {\r\n    77\t\tName     string\r\n    78\t\tDtype    uint8\r\n    79\t\tShape    []uint32\r\n"]
[4376.378878, "o", "    80\t\tData     []byte\r\n    81\t\tChecksum string\r\n    82\t}\r\n    83\t\r\n    84\ttype TensorInfo struct {\r\n    85\t\tName     string   `json:\"name\"`\r\n    86\t\tDtype    string   `json:\"dtype\"`\r\n    87\t\tShape    []uint32 `json:\"shape\"`\r\n    88\t\tChecksum string   `json:\"checksum\"`\r\n"]
[4376.378942, "o", "    89\t}\r\n    90\t\r\n    91\tfunc (t Tensor) Info() TensorInfo {\r\n    92\t\treturn TensorInfo{\r\n    93\t\t\tName:     t.Name,\r\n    94\t\t\tDtype:    DtypeName(t.Dtype),\r\n    95\t\t\tShape:    t.Shape,\r\n    96\t\t\tChecksum: t.Checksum,\r\n    97\t\t}\r\n"]
[4376.379002, "o", "    98\t}\r\n    99\t\r\n   100\ttype Checkpoint struct {\r\n   101\t\tVersion      uint32\r\n   102\t\tNumTensors   uint32\r\n   103\t\tMetadata     map[string]interface{}\r\n   104\t\tMetadataRaw  []byte\r\n   105\t\tTensors      []Tensor\r\n   106"]
[4376.379064, "o", "\t\tFileChecksum string\r\n   107\t\tFilePath     string\r\n   108\t}\r\n   109\t\r\n   110\tfunc ParseFile(path string) (*Checkpoint, error) {\r\n   111\t\tdata, err := os.ReadFile(path)\r\n   112\t\tif err != nil {\r\n   113\t\t\treturn nil, err\r\n"]
[4376.379122, "o", "   114\t\t}\r\n   115\t\treturn Parse(data, path)\r\n   116\t}\r\n   117\t\r\n   118\tfunc Parse(data []byte, path string) (*Checkpoint, error) {\r\n   119\t\tif len(data) < HeaderSize+FooterSize {\r\n   120\t\t\treturn nil, fmt.Errorf(\"file too small\")\r\n   121\t\t}\r\n   122"]
[4376.379183, "o", "\t\r\n   123\t\tif string(data[0:4]) != Magic {\r\n   124\t\t\treturn nil, fmt.Errorf(\"bad magic\")\r\n   125\t\t}\r\n   126\t\r\n   127\t\tversion := binary.LittleEndian.Uint32(data[4:8])\r\n   128\t\tif version != Version {\r\n   129\t\t\treturn nil, fmt.Errorf(\"unsupported version %d\", version)\r\n"]
[4376.379269, "o", "   130\t\t}\r\n   131\t\r\n   132\t\tnumTensors := binary.LittleEndian.Uint32(data[8:12])\r\n   133\t\tmetaLen := binary.LittleEndian.Uint32(data[12:16])\r\n   134\t\r\n   135\t\tif len(data) < HeaderSize+int(metaLen)+FooterSize {\r\n   136\t\t\treturn nil, fmt.Errorf(\"metadata length exceeds file size\")\r\n   137\t\t}\r\n   138\t\r\n   139\t\tpreceding := data[:len(data)-FooterSize]\r\n   140\t\tfooter := data[len(data)-FooterSize:]\r\n   141\t\tsum := sha256.Sum256(preceding)\r\n   142\t\t"]
[4376.379332, "o", "fileChecksum := hex.EncodeToString(sum[:])\r\n   143\t\tif hex.EncodeToString(footer) != fileChecksum {\r\n   144\t\t\treturn nil, fmt.Errorf(\"checksum mismatch\")\r\n   145\t\t}\r\n   146\t\r\n   147\t\tmetaRaw := data[HeaderSize : HeaderSize+int(metaLen)]\r\n   148\t\tvar metadata map[string]interface{}\r\n   149\t\tif metaLen > 0 {\r\n   150\t\t\tif err := json.Unmarshal(metaRaw, &metadata); err != nil {\r\n   151"]
[4376.379398, "o", "\t\t\t\treturn nil, fmt.Errorf(\"invalid metadata JSON: %v\", err)\r\n   152\t\t\t}\r\n   153\t\t} else {\r\n   154\t\t\tmetadata = map[string]interface{}{}\r\n   155\t\t}\r\n   156\t\r\n   157\t\toffset := HeaderSize + int(metaLen)\r\n   158\t\ttensors := make([]Tensor, 0, numTensors)\r\n"]
[4376.379459, "o", "   159\t\r\n   160\t\tfor i := uint32(0); i < numTensors; i++ {\r\n   161\t\t\tif offset+4 > len(preceding) {\r\n   162\t\t\t\treturn nil, fmt.Errorf(\"truncated tensor name length\")\r\n   163\t\t\t}\r\n   164\t\t\tnameLen := binary.LittleEndian.Uint32(data[offset : offset+4])\r\n"]
[4376.37952, "o", "   165\t\t\toffset += 4\r\n   166\t\r\n   167\t\t\tif offset+int(nameLen) > len(preceding) {\r\n   168\t\t\t\treturn nil, fmt.Errorf(\"truncated tensor name\")\r\n   169\t\t\t}\r\n   170\t\t\tname := string(data[offset : offset+int(nameLen)])\r\n   171\t\t\toffset += int(nameLen)\r\n   172\t\r\n"]
[4376.379581, "o", "   173\t\t\tif offset+1 > len(preceding) {\r\n   174\t\t\t\treturn nil, fmt.Errorf(\"truncated tensor dtype\")\r\n   175\t\t\t}\r\n   176\t\t\tdtype := data[offset]\r\n   177\t\t\toffset += 1\r\n   178\t\t\tif !Dtype(dtype).Valid() {\r\n   179\t\t\t\treturn nil, fmt.Errorf(\"invalid dtype %d\", dtype)\r\n   180\t\t\t}\r\n   181\t\r\n"]
[4376.379641, "o", "   182\t\t\tif offset+4 > len(preceding) {\r\n   183\t\t\t\treturn nil, fmt.Errorf(\"truncated tensor ndim\")\r\n   184\t\t\t}\r\n   185\t\t\tndim := binary.LittleEndian.Uint32(data[offset : offset+4])\r\n   186\t\t\toffset += 4\r\n   187\t\r\n   188\t\t\tshape := make([]uint32, ndim)\r\n"]
[4376.3797, "o", "   189\t\t\tif offset+4*int(ndim) > len(preceding) {\r\n   190\t\t\t\treturn nil, fmt.Errorf(\"truncated tensor shape\")\r\n   191\t\t\t}\r\n   192\t\t\tfor j := uint32(0); j < ndim; j++ {\r\n   193\t\t\t\tshape[j] = binary.LittleEndian.Uint32(data[offset : offset+4])\r\n   194\t\t\t\toffset += 4\r\n   195\t\t\t}\r\n   196\t\r\n   197\t\t\telemSize := DtypeSize(dtype)\r\n   198\t"]
[4376.379764, "o", "\t\tnumElems := Product(shape)\r\n   199\t\t\tdataLen := numElems * int64(elemSize)\r\n   200\t\t\tif dataLen < 0 || offset+int(dataLen) > len(preceding) {\r\n   201\t\t\t\treturn nil, fmt.Errorf(\"truncated tensor data\")\r\n   202\t\t\t}\r\n"]
[4376.379824, "o", "   203\t\t\ttensorData := data[offset : offset+int(dataLen)]\r\n   204\t\t\toffset += int(dataLen)\r\n   205\t\r\n   206\t\t\ttSum := sha256.Sum256(tensorData)\r\n   207\t\t\ttensors = append(tensors, Tensor{\r\n   208\t\t\t\tName:     name,\r\n   209\t\t\t\tDtype:    dtype,\r\n   210\t\t\t\tShape:    shape,\r\n   211\t\t\t\tData:     tensorData,\r\n   212\t\t\t\tChecksum: hex.EncodeToString(tSum[:]),\r\n   213\t\t\t})\r\n   214\t\t}\r\n"]
[4376.379883, "o", "   215\t\r\n   216\t\tif offset != len(preceding) {\r\n   217\t\t\treturn nil, fmt.Errorf(\"extra data after tensors\")\r\n   218\t\t}\r\n   219\t\r\n   220\t\treturn &Checkpoint{\r\n"]
