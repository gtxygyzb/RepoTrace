[2643.048372, "o", "\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kvalidate-manifest\u001b[m\u001b[K\":\r\n"]
[2643.048512, "o", "\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kmerge-checkpoints\u001b[m\u001b[K\":\r\n"]
[2643.048649, "o", "\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kdrift-analysis\u001b[m\u001b[K\":\r\n"]
[2643.048707, "o", "\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunVerifyCheckpoint(args []string) int {\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify \u001b[01;31m\u001b[Kverify-checkpoint\u001b[m\u001b[K <file>\"})\r\n"]
[2643.048794, "o", "\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunCompareOutputs(args []string) int {\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs := \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.NewFlagSet(\"\u001b[01;31m\u001b[Kcompare-outputs\u001b[m\u001b[K\", \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.ContinueOnError)\r\n"]
[2643.048856, "o", "\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs.SetOutput(\u001b[01;31m\u001b[Kos.Stderr\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify \u001b[01;31m\u001b[Kcompare-outputs\u001b[m\u001b[K <file1> <file2> [\u001b[01;31m\u001b[Kflag\u001b[m\u001b[Ks]\"})\r\n"]
[2643.048918, "o", "\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunValidateManifest(args []string) int {\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify \u001b[01;31m\u001b[Kvalidate-manifest\u001b[m\u001b[K <file.toml>\"})\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunAuditLineage(args []string) int {\r\n\u001b[32m\u001b[K176\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunGenerateReport(args []string) int {\r\n\u001b[32m\u001b[K177\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs := \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.NewFlagSet(\"generate-report\", \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.ContinueOnError)\r\n"]
[2643.048993, "o", "\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs.SetOutput(\u001b[01;31m\u001b[Kos.Stderr\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify generate-report <manifest.toml> [\u001b[01;31m\u001b[Kflag\u001b[m\u001b[Ks]\"})\r\n"]
[2643.049055, "o", "\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunMergeCheckpoints(args []string) int {\r\n\u001b[32m\u001b[K199\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs := \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.NewFlagSet(\"\u001b[01;31m\u001b[Kmerge-checkpoints\u001b[m\u001b[K\", \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.ContinueOnError)\r\n\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs.SetOutput(\u001b[01;31m\u001b[Kos.Stderr\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify \u001b[01;31m\u001b[Kmerge-checkpoints\u001b[m\u001b[K <output> <file1> <file2> ... [\u001b[01;31m\u001b[Kflag\u001b[m\u001b[Ks]\"})\r\n\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunDriftAnalysis(args []string) int {\r\n\u001b[32m\u001b[K223\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs := \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.NewFlagSet(\"\u001b[01;31m\u001b[Kdrift-analysis\u001b[m\u001b[K\", \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.ContinueOnError)\r\n\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs.SetOutput(\u001b[01;31m\u001b[Kos.Stderr\u001b[m\u001b[K)\r\n"]
[2643.049118, "o", "\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify \u001b[01;31m\u001b[Kdrift-analysis\u001b[m\u001b[K <file1> <file2> <file3> ... [\u001b[01;31m\u001b[Kflag\u001b[m\u001b[Ks]\"})\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KparseMixedArgs(fs *\u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.FlagSet, args []string) ([]string, error) {\r\n"]
[2643.049176, "o", "\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar \u001b[01;31m\u001b[Kflag\u001b[m\u001b[KArgs []string\r\n\u001b[32m\u001b[K257\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[Kflag\u001b[m\u001b[KArgs = append(\u001b[01;31m\u001b[Kflag\u001b[m\u001b[KArgs, arg)\r\n\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn nil, fmt.Errorf(\"\u001b[01;31m\u001b[Kflag\u001b[m\u001b[K %s requires a value\", arg)\r\n\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kflag\u001b[m\u001b[KArgs = append(\u001b[01;31m\u001b[Kflag\u001b[m\u001b[KArgs, arg+\"=\"+args[i+1])\r\n\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif err := fs.Parse(\u001b[01;31m\u001b[Kflag\u001b[m\u001b[KArgs); err != nil {\r\n\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KoutputJSON(v interface{}) {\r\n"]
