[2643.607075, "o", "   249\t\tfor i := 0; i < len(args); i++ {\r\n   250\t\t\targ := args[i]\r\n   251\t\t\tif arg == \"--\" {\r\n   252\t\t\t\tpositional = append(positional, args[i+1:]...)\r\n   253\t\t\t\tbreak\r\n   254\t\t\t}\r\n"]
[2643.607157, "o", "   255\t\t\tif strings.HasPrefix(arg, \"--\") {\r\n   256\t\t\t\tif strings.Contains(arg, \"=\") {\r\n   257\t\t\t\t\tflagArgs = append(flagArgs, arg)\r\n   258\t\t\t\t\tcontinue\r\n   259\t\t\t\t}\r\n   260\t\t\t\tif i+1 >= len(args) {\r\n   261\t\t\t\t\treturn nil, fmt.Errorf(\"flag %s requires a value\", arg)\r\n   262\t\t\t\t}\r\n   263\t\t\t\tflagArgs = append(flagArgs, arg+\"=\"+args[i+1])\r\n   264\t\t\t\ti++\r\n   265\t\t\t} else {\r\n"]
[2643.607213, "o", "   266\t\t\t\tpositional = append(positional, arg)\r\n   267\t\t\t}\r\n   268\t\t}\r\n   269\t\r\n   270\t\tif err := fs.Parse(flagArgs); err != nil {\r\n   271\t\t\treturn nil, err\r\n   272\t\t}\r\n   273\t\t"]
[2643.607285, "o", "return positional, nil\r\n   274\t}\r\n   275\t\r\n   276\tfunc outputJSON(v interface{}) {\r\n   277\t\tenc := json.NewEncoder(os.Stdout)\r\n   278\t\tenc.SetIndent(\"\", \"  \")\r\n   279\t\t_ = enc.Encode(v)\r\n   280\t}\r\n"]
