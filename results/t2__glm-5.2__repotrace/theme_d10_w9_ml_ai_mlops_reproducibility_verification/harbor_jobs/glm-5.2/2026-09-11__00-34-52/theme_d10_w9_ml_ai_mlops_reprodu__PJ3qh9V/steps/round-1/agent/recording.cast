[5860.313401, "o", "   162\t\t\tSkippedTensors:     skipped,\r\n   163\t\t\tTensors:            tensors,\r\n   164\t\t\tOverallConvergence: overall,\r\n   165\t\t}\r\n   166\t\r\n   167\t\tif threshold != nil {\r\n   168\t\t\tnumDrifting := 0\r\n   169\t\t\tfor i := range result.Tensors {\r\n   170\t\t\t\tdrifting := result.Tensors[i].MaxChange > *threshold\r\n"]
[5860.313462, "o", "   171\t\t\t\tresult.Tensors[i].Drifting = &drifting\r\n   172\t\t\t\tif drifting {\r\n   173\t\t\t\t\tnumDrifting++\r\n   174\t\t\t\t}\r\n   175\t\t\t}\r\n   176\t\t\tresult.DriftThreshold = threshold\r\n   177\t\t\tresult.NumDriftingTensors = &numDrifting\r\n   178\t\t}\r\n"]
[5860.313526, "o", "   179\t\r\n   180\t\tapplyTopK(result, topK)\r\n   181\t\treturn result, nil\r\n   182\t}\r\n   183\t\r\n   184\tfunc applyTopK(result *Result, topK *int) {\r\n   185\t\tif topK == nil {\r\n   186\t\t\treturn\r\n   187\t\t}\r\n   188\t"]
[5860.313585, "o", "\r\n   189\t\trequested := *topK\r\n   190\t\tsort.SliceStable(result.Tensors, func(i, j int) bool {\r\n   191\t\t\tif result.Tensors[i].StabilityScore != result.Tensors[j].StabilityScore {\r\n   192\t\t\t\treturn result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore\r\n   193\t\t\t}\r\n"]
[5860.313646, "o", "   194\t\t\treturn result.Tensors[i].Name < result.Tensors[j].Name\r\n   195\t\t})\r\n   196\t\tif requested < len(result.Tensors) {\r\n   197\t\t\tresult.Tensors = result.Tensors[:requested]\r\n   198\t\t}\r\n   199\t\tresult.TopK = &requested\r\n   200\t}\r\n   201\t\r\n"]
