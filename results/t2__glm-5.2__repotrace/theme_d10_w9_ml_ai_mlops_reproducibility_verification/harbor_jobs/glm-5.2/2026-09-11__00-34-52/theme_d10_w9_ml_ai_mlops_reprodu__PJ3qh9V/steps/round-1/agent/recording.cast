[5850.974929, "o", "   232\t\tif len(xs) == 0 {\r\n   233\t\t\treturn 0\r\n   234\t\t}\r\n   235\t\tvar sum float64\r\n   236\t\tfor _, x := range xs {\r\n   237\t\t\tsum += x\r\n   238\t\t}\r\n   239\t\treturn sum / float64(len(xs))\r\n   240\t}\r\n   241\t\r\n   242\tfunc maxFloat64(xs []float64) float64 {\r\n   243\t\tif len(xs) == 0 {\r\n   244\t\t\treturn 0\r\n   245\t\t}\r\n   246\t\tm := xs[0]\r\n   247\t\tfor _, x := range xs[1:] {\r\n   248\t\t"]
[5850.975001, "o", "\tif x > m {\r\n   249\t\t\t\tm = x\r\n   250\t\t\t}\r\n   251\t\t}\r\n   252\t\treturn m\r\n   253\t}\r\n   254\t\r\n   255\tfunc classifyConvergence(steps []float64) string {\r\n   256\t\tif len(steps) <= 1 {\r\n   257\t\t\treturn \"converging\"\r\n   258\t\t}\r\n"]
[5850.975064, "o", "   259\t\tnonIncreasing := true\r\n   260\t\tnonDecreasing := true\r\n   261\t\thasIncrease := false\r\n   262\t\tfor i := 1; i < len(steps); i++ {\r\n   263\t\t\tif steps[i] > steps[i-1] {\r\n   264\t\t\t\tnonIncreasing = false\r\n   265\t\t\t\thasIncrease = true\r\n   266\t\t\t}\r\n"]
