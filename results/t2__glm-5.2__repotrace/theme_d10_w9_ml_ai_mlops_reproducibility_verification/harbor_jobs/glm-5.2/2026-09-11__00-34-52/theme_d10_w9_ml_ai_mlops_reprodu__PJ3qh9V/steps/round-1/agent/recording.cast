[3670.30186, "i", "sed -n '1,320p' internal/drift/drift.go\n"]
[3670.302159, "o", "sed -n '1,320p' internal/drift/drift.go\r\n\u001b[?2004l\r"]
[3670.304908, "o", "package drift\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\r\n"]
[3670.304939, "o", "\t\"repro-verify/internal/mlck\"\r\n)\r\n\r\ntype TensorResult struct {\r\n\tName           string    `json:\"name\"`\r\n"]
[3670.305032, "o", "\tStepChanges    []float64 `json:\"step_changes\"`\r\n\tMeanChange     float64   `json:\"mean_change\"`\r\n\tMaxChange      float64   `json:\"max_change\"`\r\n\tConvergence    string    `json:\"convergence\"`\r\n\tStabilityScore float64   `json:\"stability_score\"`\r\n}\r\n\r\ntype Result struct {\r\n\tNumSnapshots       int            `json:\"num_snapshots\"`\r\n\tNumAnalyzedTensors int            `json:\"num_analyzed_tensors\"`\r\n\tSkippedTensors     []string       `json:\"skipped_tensors\"`\r\n\tTensors            []TensorResult `json:\"tensors\"`\r\n\tOverallConvergence string         `json:\"overall_convergence\"`\r\n}\r\n\r\nfunc Analyze(files []string) (*Result, error) {\r\n\tif len(files) < 2 {\r\n"]
[3670.305106, "o", "\t\treturn nil, fmt.Errorf(\"at least 2 input files required\")\r\n\t}\r\n\r\n\tcps := make([]*mlck.Checkpoint, len(files))\r\n\tfor i, f := range files {\r\n\t\tcp, err := mlck.ParseFile(f)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n\t\t}\r\n\t\tcps[i] = cp\r\n\t}\r\n"]
[3670.305166, "o", "\r\n\tvar allNames []string\r\n\tseen := map[string]bool{}\r\n\tfor _, cp := range cps {\r\n\t\tfor _, t := range cp.Tensors {\r\n\t\t\tif !seen[t.Name] {\r\n\t\t\t\tseen[t.Name] = true\r\n\t\t\t\tallNames = append(allNames, t.Name)\r\n\t\t\t}\r\n\t"]
[3670.305247, "o", "\t}\r\n\t}\r\n\r\n\tskipped := []string{}\r\n\ttensors := []TensorResult{}\r\n\tconverging := 0\r\n\tdiverging := 0\r\n\r\n\tfor _, name := range allNames {\r\n\t\tok := true\r\n\t\tvar shape []uint32\r\n\t\t"]
[3670.30531, "o", "for _, cp := range cps {\r\n\t\t\tt, exists := tensorByName(cp, name)\r\n\t\t\tif !exists {\r\n\t\t\t\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\tif shape == nil {\r\n\t\t\t\tshape = t.Shape\r\n\t\t\t} else if !shapesEqual(shape, t.Shape) {\r\n\t\t"]
[3670.305367, "o", "\t\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif !ok {\r\n\t\t\tskipped = append(skipped, name)\r\n\t\t\tcontinue\r\n"]
[3670.30543, "o", "\t\t}\r\n\r\n\t\tsteps := make([]float64, len(cps)-1)\r\n\t\tfor i := 0; i < len(cps)-1; i++ {\r\n\t\t\tt1, _ := tensorByName(cps[i], name)\r\n\t\t\tt2, _ := tensorByName(cps[i+1], name)\r\n\t\t\tv1, err := t1.Float64Values()\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n"]
[3670.305492, "o", "\t\t\tv2, err := t2.Float64Values()\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tn := len(v1)\r\n\t\t\tif n == 0 {\r\n\t\t\t\tsteps[i] = 0\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
[3670.30555, "o", "\t\t\tvar sum float64\r\n\t\t\tfor j := 0; j < n; j++ {\r\n\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n\t\t\t}\r\n\t\t\tsteps[i] = sum / float64(n)\r\n\t\t}\r\n\r\n\t\tmean := meanFloat64(steps)\r\n\t\tmax := maxFloat64(steps)\r\n"]
[3670.305607, "o", "\t\tconvergence := classifyConvergence(steps)\r\n\t\tstability := 1.0\r\n\t\tif steps[0] != 0 {\r\n\t\t\tstability = 1.0 - steps[len(steps)-1]/steps[0]\r\n\t\t\tif stability < 0 {\r\n\t\t\t\tstability = 0\r\n\t\t\t} else if stability > 1 {\r\n\t"]
[3670.305675, "o", "\t\t\tstability = 1\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\ttensors = append(tensors, TensorResult{\r\n\t\t\tName:           name,\r\n\t\t\tStepChanges:    steps,\r\n\t\t\tMeanChange:     mean,\r\n\t\t\tMaxChange:      max,\r\n"]
[3670.305732, "o", "\t\t\tConvergence:    convergence,\r\n\t\t\tStabilityScore: stability,\r\n\t\t})\r\n\r\n\t\tif convergence == \"converging\" {\r\n\t\t\tconverging++\r\n\t\t} else if convergence == \"diverging\" {\r\n\t\t\tdiverging++\r\n\t\t}\r\n\t}\r\n"]
[3670.305789, "o", "\r\n\toverall := \"mixed\"\r\n\tif converging > len(tensors)/2 {\r\n\t\toverall = \"converging\"\r\n\t} else if diverging > len(tensors)/2 {\r\n\t\toverall = \"diverging\"\r\n\t}\r\n\r\n\treturn &Result{\r\n\t\tNumSnapshots:       len(files),\r\n\t\tNumAnalyzedTensors: len(tensors),\r\n"]
[3670.305845, "o", "\t\tSkippedTensors:     skipped,\r\n\t\tTensors:            tensors,\r\n\t\tOverallConvergence: overall,\r\n\t}, nil\r\n}\r\n\r\nfunc tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {\r\n\tfor _, t := range cp.Tensors {\r\n\t\tif t.Name == name {\r\n\t\t\treturn t, true\r\n"]
[3670.305909, "o", "\t\t}\r\n\t}\r\n\treturn mlck.Tensor{}, false\r\n}\r\n\r\nfunc shapesEqual(a, b []uint32) bool {\r\n\tif len(a) != len(b) {\r\n\t\treturn false\r\n\t}\r\n\tfor i := range a {\r\n"]
[3670.305965, "o", "\t\tif a[i] != b[i] {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc meanFloat64(xs []float64) float64 {\r\n\tif len(xs) == 0 {\r\n\t\treturn 0\r\n"]
[3670.306021, "o", "\t}\r\n\tvar sum float64\r\n\tfor _, x := range xs {\r\n\t\tsum += x\r\n\t}\r\n\treturn sum / float64(len(xs))\r\n}\r\n\r\nfunc maxFloat64(xs []float64) float64 {\r\n"]
[3670.306085, "o", "\tif len(xs) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tm := xs[0]\r\n\tfor _, x := range xs[1:] {\r\n\t\tif x > m {\r\n\t\t\tm = x\r\n\t\t}\r\n"]
[3670.306149, "o", "\t}\r\n\treturn m\r\n}\r\n\r\nfunc classifyConvergence(steps []float64) string {\r\n\tif len(steps) <= 1 {\r\n\t\treturn \"converging\"\r\n\t}\r\n\tdecreasing := true\r\n\tincreasing := true\r\n\tfor i := 1; i < len(steps); i++ {\r\n\t\tif steps[i] >= steps[i-1] {\r\n\t\t\tdecreasing = false\r\n\t\t}\r\n\t\tif steps[i] <= steps[i-1] {\r\n\t"]
[3670.306207, "o", "\t\tincreasing = false\r\n\t\t}\r\n\t}\r\n\tif decreasing {\r\n\t\treturn \"converging\"\r\n\t}\r\n\tif increasing {\r\n"]
[3670.306274, "o", "\t\treturn \"diverging\"\r\n\t}\r\n\treturn \"oscillating\"\r\n}\r\n"]
[3670.306691, "o", "\u001b[?2004h"]
[3670.306747, "o", "root@n30009:/app# "]
[3670.578565, "i", "sed -n '1,320p' internal/lineage/lineage.go\n"]
[3670.578897, "o", "sed -n '1,320p' internal/lineage/lineage.go\r\n\u001b[?2004l\r"]
[3670.581636, "o", "package lineage\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t"]
[3670.581707, "o", "\"strings\"\r\n\t\"time\"\r\n)\r\n\r\ntype Experiment struct {\r\n\tID             string   `json:\"id\"`\r\n\tName           string   `json:\"name\"`\r\n\tParents        []string `json:\"parents\"`\r\n\tCheckpointHash string   `json:\"checkpoint_hash\"`\r\n\tTimestamp      string   `json:\"timestamp\"`\r\n}\r\n\r\ntype Input struct {\r\n\tExperiments []Experiment `json:\"experiments\"`\r\n"]
[3670.581794, "o", "}\r\n\r\ntype Result struct {\r\n\tValid            bool     `json:\"valid\"`\r\n\tNumExperiments   int      `json:\"num_experiments\"`\r\n\tNumRoots         int      `json:\"num_roots\"`\r\n\tNumLeaves        int      `json:\"num_leaves\"`\r\n\tMaxDepth         int      `json:\"max_depth\"`\r\n\tTopologicalOrder []string `json:\"topological_order\"`"]
[3670.581855, "o", "\r\n\tErrors           []string `json:\"errors,omitempty\"`\r\n}\r\n\r\nfunc Audit(path string) *Result {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn &Result{\r\n\t\t\tValid:  false,\r\n\t\t\tErrors: []string{fmt.Sprintf(\"failed to read lineage file: %v\", err)},\r\n\t\t}\r\n\t}\r\n\r\n\tvar in Input\r\n\tif err := json.Unmarshal(data, &in); err != nil {\r\n\t\treturn &Result{\r\n"]
[3670.581915, "o", "\t\t\tValid:  false,\r\n\t\t\tErrors: []string{fmt.Sprintf(\"failed to parse lineage JSON: %v\", err)},\r\n\t\t}\r\n\t}\r\n\r\n\texps := in.Experiments\r\n\tresult := &Result{\r\n\t\tValid:            true,\r\n\t\tErrors:           []string{},\r\n\t\tTopologicalOrder: []string{},\r\n"]
[3670.581977, "o", "\t}\r\n\r\n\tif len(exps) == 0 {\r\n\t\tresult.TopologicalOrder = []string{}\r\n\t\treturn result\r\n\t}\r\n\r\n\tidSet := make(map[string]int)\r\n\tids := make([]string, 0, len(exps))\r\n\tfor i, e := range exps {\r\n\t\tif e.ID == \"\" {\r\n"]
[3670.582036, "o", "\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"experiment at index %d missing id\", i))\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif _, ok := idSet[e.ID]; ok {\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"duplicate id: %s\", e.ID))\r\n\t\t} else {\r\n\t\t\tidSet[e.ID] = i\r\n\t\t\tids = append(ids, e.ID)\r\n\t\t}\r\n"]
[3670.582099, "o", "\t\tif e.CheckpointHash == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"empty checkpoint_hash for experiment: %s\", e.ID))\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, e := range exps {\r\n\t\tif e.ID == \"\" {\r\n\t\t\tcontinue\r\n\t\t}"]
[3670.582159, "o", "\r\n\t\tfor _, p := range e.Parents {\r\n\t\t\tif _, ok := idSet[p]; !ok {\r\n\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"parent reference unresolved: %s -> %s\", e.ID, p))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\ttimes := make(map[string]time.Time)\r\n"]
[3670.582215, "o", "\tfor _, e := range exps {\r\n\t\tif e.ID == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif e.Timestamp == \"\" {\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"missing timestamp for experiment: %s\", e.ID))\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tt, err := time.Parse(time.RFC3339, e.Timestamp)\r\n\t"]
[3670.582308, "o", "\tif err != nil {\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"invalid timestamp for experiment: %s\", e.ID))\r\n\t\t} else {\r\n\t\t\ttimes[e.ID] = t\r\n\t\t}\r\n\t}\r\n\r\n\tif len(result.Errors) == 0 {\r\n\t\tif cycle := detectCycle(exps); cycle != nil {\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"cycle detected involving: %s\", strings.Join(cycle, \", \")))\r\n\t\t}\r\n\t}\r\n"]
[3670.582372, "o", "\r\n\tif len(result.Errors) == 0 {\r\n\t\tfor _, e := range exps {\r\n\t\t\tchildTime, ok := times[e.ID]\r\n"]
[3670.582431, "o", "\t\t\tif !ok {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tfor _, p := range e.Parents {\r\n\t\t\t\tparentTime, ok := times[p]\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tif !childTime.After(parentTime) {\r\n\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"timestamp violation: %s (%s) has parent %s (%s)\", e.ID, childTime.Format(\"2006-01-02\"), p, parentTime.Format(\"2006-01-02\")))\r\n\t\t\t\t}\r\n"]
[3670.582487, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif len(result.Errors) > 0 {\r\n\t\tresult.Valid = false\r\n\t\tresult.TopologicalOrder = nil\r\n\t\treturn result\r\n"]
[3670.58255, "o", "\t}\r\n\r\n\tchildren := make(map[string][]string)\r\n\tfor _, e := range exps {\r\n\t\tfor _, p := range e.Parents {\r\n\t\t\tchildren[p] = append(children[p], e.ID)\r\n\t\t}\r\n\t}\r\n\r\n\troots := make([]string, 0)\r\n\tleaves := make([]string, 0)\r\n\tfor _, e := range exps {\r\n\t\tif len(e.Parents) == 0 {\r\n"]
[3670.582612, "o", "\t\t\troots = append(roots, e.ID)\r\n\t\t}\r\n\t\tif len(children[e.ID]) == 0 {\r\n\t\t\tleaves = append(leaves, e.ID)\r\n\t\t}\r\n\t}\r\n\r\n\tvisited := make(map[string]bool)\r\n\tvar post []string\r\n"]
[3670.582673, "o", "\tvar dfs func(id string)\r\n\tdfs = func(id string) {\r\n\t\tvisited[id] = true\r\n\t\tfor _, child := range children[id] {\r\n\t\t\tif !visited[child] {\r\n\t\t\t\tdfs(child)\r\n\t\t\t}\r\n\t\t}\r\n\t\tpost = append(post, id)\r\n\t}\r\n"]
[3670.582735, "o", "\tfor _, e := range exps {\r\n\t\tif !visited[e.ID] {\r\n\t\t\tdfs(e.ID)\r\n\t\t}\r\n\t}\r\n\ttopo := make([]string, len(post))\r\n\tfor i := range post {\r\n\t\ttopo[i] = post[len(post)-1-i]\r\n\t}\r\n\r\n"]
[3670.582797, "o", "\tmaxDepth := 0\r\n\tvar depthDFS func(id string, depth int)\r\n\tdepthDFS = func(id string, depth int) {\r\n\t\tif depth > maxDepth {\r\n\t\t\tmaxDepth = depth\r\n\t\t}\r\n\t\tfor _, child := range children[id] {\r\n\t\t\tdepthDFS(child, depth+1)\r\n\t\t}\r\n"]
[3670.582863, "o", "\t}\r\n\tfor _, r := range roots {\r\n\t\tdepthDFS(r, 1)\r\n\t}\r\n\r\n\tresult.NumExperiments = len(exps)\r\n"]
[3670.582923, "o", "\tresult.NumRoots = len(roots)\r\n\tresult.NumLeaves = len(leaves)\r\n\tresult.MaxDepth = maxDepth\r\n\tresult.TopologicalOrder = topo\r\n\treturn result\r\n}\r\n\r\nfunc detectCycle(exps []Experiment) []string {\r\n\tadj := make(map[string][]string)\r\n\tfor _, e := range exps {\r\n\t\tfor _, p := range e.Parents {\r\n\t\t\tadj[p] = append(adj[p], e.ID)\r\n\t\t}\r\n\t}\r\n\r\n"]
[3670.582983, "o", "\tstate := make(map[string]int)\r\n\tvar stack []string\r\n\tvar cycle []string\r\n\r\n\tvar dfs func(id string) bool\r\n\tdfs = func(id string) bool {\r\n\t\tstate[id] = 1\r\n\t\tstack = append(stack, id)\r\n\t\tfor _, child := range adj[id] {\r\n\t\t"]
[3670.583038, "o", "\tif state[child] == 1 {\r\n\t\t\t\tidx := -1\r\n\t\t\t\tfor i := len(stack) - 1; i >= 0; i-- {\r\n\t\t\t\t\tif stack[i] == child {\r\n\t\t\t\t\t\tidx = i\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t"]
[3670.583094, "o", "\t\t\tif idx >= 0 {\r\n\t\t\t\t\tcycle = append([]string{}, stack[idx:]...)\r\n\t\t\t\t\treturn true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif state[child] == 0 {\r\n\t\t\t\tif dfs(child) {\r\n"]
[3670.583154, "o", "\t\t\t\t\treturn true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tstack = stack[:len(stack)-1]\r\n\t\tstate[id] = 2\r\n\t\treturn false\r\n\t}\r\n\r\n\t"]
[3670.583213, "o", "for _, e := range exps {\r\n\t\tif state[e.ID] == 0 {\r\n\t\t\tif dfs(e.ID) {\r\n\t\t\t\treturn cycle\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n"]
[3670.583284, "o", "}\r\n"]
[3670.583689, "o", "\u001b[?2004h"]
[3670.583762, "o", "root@n30009:/app# "]
[3670.864425, "i", "sed -n '1,320p' internal/compare/compare.go\n"]
[3670.86474, "o", "sed -n '1,320p' internal/compare/compare.go\r\n\u001b[?2004l\r"]
[3670.86742, "o", "package compare\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
[3670.867485, "o", "\r\n\t\"repro-verify/internal/mlck\"\r\n)\r\n\r\ntype TensorResult struct {\r\n\tName          string  `json:\"name\"`\r\n"]
[3670.86755, "o", "\tMatch         bool    `json:\"match\"`\r\n\tMaxAbsDiff    float64 `json:\"max_abs_diff\"`\r\n\tMaxRelDiff    float64 `json:\"max_rel_diff\"`\r\n\tNumMismatches int     `json:\"num_mismatches\"`\r\n\tTotalElements int     `json:\"total_elements\"`\r\n}\r\n\r\ntype Result struct {\r\n\tMatch          bool           `json:\"match\"`\r\n\tMode           string         `json:\"mode\"`\r\n\tAtol           float64        `json:\"atol\"`\r\n\tRtol           float64        `json:\"rtol\"`\r\n\tTensorResults  []TensorResult `json:\"tensor_results\"`\r\n\tMissingInFile1 []string       `json:\"missing_in_file1\"`\r\n\tMissingInFile2 []string       `json:\"missing_in_file2\"`\r\n"]
[3670.867617, "o", "\tError          string         `json:\"error,omitempty\"`\r\n}\r\n\r\nfunc Compare(c1, c2 *mlck.Checkpoint, mode string, atol, rtol float64) (*Result, error) {\r\n\tif mode != \"strict\" && mode != \"relaxed\" {\r\n\t\treturn nil, fmt.Errorf(\"invalid mode %q\", mode)\r\n\t}\r\n\r\n\tresult := &Result{\r\n\t\tMatch:          true,\r\n\t\tMode:           mode,\r\n\t\tAtol:           atol,\r\n"]
[3670.867676, "o", "\t\tRtol:           rtol,\r\n\t\tTensorResults:  []TensorResult{},\r\n\t\tMissingInFile1: []string{},\r\n\t\tMissingInFile2: []string{},\r\n\t}\r\n\r\n\tmap2 := make(map[string]mlck.Tensor)\r\n\tfor _, t := range c2.Tensors {\r\n\t\tmap2[t.Name] = t\r\n\t}\r\n\tmap1 := make(map[string]mlck.Tensor)"]
[3670.867738, "o", "\r\n\tfor _, t := range c1.Tensors {\r\n\t\tmap1[t.Name] = t\r\n\t}\r\n\r\n\tfor _, t1 := range c1.Tensors {\r\n\t\tt2, ok := map2[t1.Name]\r\n\t\tif !ok {\r\n\t\t\tresult.MissingInFile2 = append(result.MissingInFile2, t1.Name)\r\n\t"]
[3670.867795, "o", "\t\tcontinue\r\n\t\t}\r\n\t\ttr := compareTensors(t1, t2, mode, atol, rtol)\r\n\t\tresult.TensorResults = append(result.TensorResults, tr)\r\n\t\tif !tr.Match {\r\n\t\t\tresult.Match = false\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, t := range c2.Tensors {\r\n"]
[3670.867854, "o", "\t\tif _, ok := map1[t.Name]; !ok {\r\n\t\t\tresult.MissingInFile1 = append(result.MissingInFile1, t.Name)\r\n\t\t}\r\n\t}\r\n\r\n\tif len(result.MissingInFile1) > 0 || len(result.MissingInFile2) > 0 {\r\n\t\tresult.Match = false\r\n\t}\r\n\r\n"]
[3670.867922, "o", "\treturn result, nil\r\n}\r\n\r\nfunc compareTensors(t1, t2 mlck.Tensor, mode string, atol, rtol float64) TensorResult {\r\n\ttotal := int(mlck.Product(t1.Shape))\r\n\ttr := TensorResult{\r\n\t\tName:          t1.Name,\r\n\t\tMatch:         true,\r\n\t\tMaxAbsDiff:    0,\r\n\t\tMaxRelDiff:    0,\r\n\t\tNumMismatches: 0,\r\n\t\tTotalElements: total,\r\n"]
[3670.867981, "o", "\t}\r\n\r\n\tif !shapesEqual(t1.Shape, t2.Shape) {\r\n\t\ttr.Match = false\r\n\t\ttr.NumMismatches = total\r\n\t\treturn tr\r\n\t}\r\n\r\n\tif total == 0 {\r\n\t\treturn tr\r\n\t}\r\n"]
[3670.868038, "o", "\r\n\tvals1, err := t1.Float64Values()\r\n\tif err != nil {\r\n\t\ttr.Match = false\r\n\t\ttr.NumMismatches = total\r\n\t\treturn tr\r\n\t}\r\n\tvals2, err := t2.Float64Values()\r\n\tif err != nil {\r\n\t\ttr.Match = false\r\n"]
[3670.868093, "o", "\t\ttr.NumMismatches = total\r\n\t\treturn tr\r\n\t}\r\n\r\n\tthreshold := int(math.Floor(float64(total) * 0.001))\r\n\tfor i := 0; i < total; i++ {\r\n\t\ta := vals1[i]\r\n\t\tb := vals2[i]\r\n\t\tdiff := math.Abs(a - b)\r\n"]
[3670.868152, "o", "\t\tif diff > tr.MaxAbsDiff {\r\n\t\t\ttr.MaxAbsDiff = diff\r\n\t\t}\r\n\t\tvar rel float64\r\n\t\tif math.Abs(b) > 0 {\r\n\t\t\trel = diff / math.Abs(b)\r\n\t\t} else if diff > 0 {\r\n"]
[3670.868216, "o", "\t\t\trel = diff\r\n\t\t}\r\n\t\tif rel > tr.MaxRelDiff {\r\n\t\t\ttr.MaxRelDiff = rel\r\n\t\t}\r\n"]
[3670.86831, "o", "\t\tif diff > atol+rtol*math.Abs(b) {\r\n\t\t\ttr.NumMismatches++\r\n\t\t}\r\n\t}\r\n\r\n\tswitch mode {\r\n\tcase \"strict\":\r\n\t\ttr.Match = tr.NumMismatches == 0\r\n\tcase \"relaxed\":\r\n\t\ttr.Match = tr.NumMismatches <= threshold\r\n\t}\r\n\r\n\treturn tr\r\n}\r\n\r\nfunc shapesEqual(a, b []uint32) bool {\r\n\tif len(a) != len(b) {\r\n\t\treturn false\r\n\t}\r\n\tfor i := range a {\r\n"]
[3670.868366, "o", "\t\tif a[i] != b[i] {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n"]
[3670.868873, "o", "\u001b[?2004h"]
[3670.86893, "o", "root@n30009:/app# "]
[3671.114658, "i", "sed -n '1,360p' internal/app/app.go\n"]
[3671.11495, "o", "sed -n '1,360p' internal/app/app.go\r\n\u001b[?2004l\r"]
[3671.117757, "o", "package app\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n"]
[3671.117839, "o", "\t\"io\"\r\n\t\"os\"\r\n\t\"strings\"\r\n\r\n\t\"repro-verify/internal/compare\"\r\n\t\"repro-verify/internal/drift\"\r\n\t\"repro-verify/internal/lineage\"\r\n\t\"repro-verify/internal/manifest\"\r\n\t\"repro-verify/internal/merge\"\r\n\t\"repro-verify/internal/mlck\"\r\n\t\"repro-verify/internal/report\"\r\n)\r\n\r\nfunc Run() int {\r\n"]
[3671.117909, "o", "\tif len(os.Args) < 2 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"no subcommand provided\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"verify-checkpoint\":\r\n\t\treturn runVerifyCheckpoint(os.Args[2:])\r\n\tcase \"compare-outputs\":\r\n\t\treturn runCompareOutputs(os.Args[2:])\r\n\tcase \"validate-manifest\":\r\n"]
[3671.117973, "o", "\t\treturn runValidateManifest(os.Args[2:])\r\n\tcase \"audit-lineage\":\r\n\t\treturn runAuditLineage(os.Args[2:])\r\n\tcase \"generate-report\":\r\n\t\treturn runGenerateReport(os.Args[2:])\r\n\tcase \"merge-checkpoints\":\r\n\t\treturn runMergeCheckpoints(os.Args[2:])\r\n\tcase \"drift-analysis\":\r\n\t\treturn runDriftAnalysis(os.Args[2:])\r\n"]
[3671.118036, "o", "\tdefault:\r\n\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"unknown subcommand: %s\", os.Args[1])})\r\n\t\treturn 1\r\n\t}\r\n}\r\n\r\nfunc runVerifyCheckpoint(args []string) int {\r\n\tif len(args) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify verify-checkpoint <file>\"})\r\n\t\treturn 1\r\n\t"]
[3671.118097, "o", "}\r\n\r\n\tif _, err := os.ReadFile(args[0]); err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tcp, err := mlck.ParseFile(args[0])\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\r\n\t\t\t\"valid\": false,\r\n"]
[3671.118157, "o", "\t\t\t\"error\": err.Error(),\r\n\t\t})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tmetadata := cp.Metadata\r\n\tif metadata == nil {\r\n\t\tmetadata = map[string]interface{}{}\r\n\t}\r\n\ttensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))\r\n\t"]
[3671.118218, "o", "for _, t := range cp.Tensors {\r\n\t\ttensors = append(tensors, t.Info())\r\n\t}\r\n\r\n\toutputJSON(map[string]interface{}{\r\n\t\t\"valid\":          true,\r\n\t\t\"format_version\": int(cp.Version),\r\n\t\t\"num_tensors\":    len(cp.Tensors),\r\n\t\t\"metadata\":       metadata,\r\n"]
[3671.118308, "o", "\t\t\"tensors\":        tensors,\r\n\t\t\"file_checksum\":  cp.FileChecksum,\r\n\t})\r\n\treturn 0\r\n}\r\n\r\nfunc runCompareOutputs(args []string) int {\r\n\tfs := flag.NewFlagSet(\"compare-outputs\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tatol := fs.Float64(\"atol\", 1e-7, \"absolute tolerance\")\r\n\trtol := fs.Float64(\"rtol\", 1e-5, \"relative tolerance\")\r\n\tmode := fs.String(\"mode\", \"strict\", \"comparison mode\")\r\n\r\n"]
[3671.11837, "o", "\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tif len(pos) != 2 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify compare-outputs <file1> <file2> [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n"]
[3671.118434, "o", "\tc1, err := mlck.ParseFile(pos[0])\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"file1: %v\", err)})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tc2, err := mlck.ParseFile(pos[1])\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"file2: %v\", err)})\r\n\t\treturn 1\r\n"]
[3671.118496, "o", "\t}\r\n\r\n\tres, err := compare.Compare(c1, c2, *mode, *atol, *rtol)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\r\n\toutputJSON(res)\r\n\tif res.Match {\r\n\t\treturn 0\r\n\t}"]
[3671.118558, "o", "\r\n\treturn 1\r\n}\r\n\r\nfunc runValidateManifest(args []string) int {\r\n\tif len(args) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify validate-manifest <file.toml>\"})\r\n\t\treturn 1\r\n\t}\r\n\tif _, err := os.ReadFile(args[0]); err != nil {\r\n\t"]
[3671.118616, "o", "\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tres := manifest.Validate(args[0])\r\n\toutputJSON(res)\r\n\tif res.Valid {\r\n\t\treturn 0\r\n\t}\r\n\treturn 1\r\n}\r\n\r\n"]
[3671.118676, "o", "func runAuditLineage(args []string) int {\r\n\tif len(args) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify audit-lineage <file.json>\"})\r\n\t\treturn 1\r\n\t}\r\n\tif _, err := os.ReadFile(args[0]); err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n"]
[3671.118737, "o", "\t}\r\n\tres := lineage.Audit(args[0])\r\n\toutputJSON(res)\r\n\tif res.Valid {\r\n\t\treturn 0\r\n\t}\r\n\treturn 1\r\n}\r\n\r\n"]
[3671.118798, "o", "func runGenerateReport(args []string) int {\r\n\tfs := flag.NewFlagSet(\"generate-report\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tcheckpoint := fs.String(\"checkpoint\", \"\", \"checkpoint file to verify\")\r\n\tcomparePath := fs.String(\"compare\", \"\", \"second checkpoint to compare\")\r\n\tlineagePath := fs.String(\"lineage\", \"\", \"lineage file to audit\")\r\n\r\n\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n"]
[3671.118866, "o", "\t\treturn 1\r\n\t}\r\n\tif len(pos) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify generate-report <manifest.toml> [flags]\"})\r\n\t\treturn 1\r\n\t}"]
[3671.118928, "o", "\r\n\r\n\tfor _, p := range []string{pos[0], *checkpoint, *comparePath, *lineagePath} {\r\n\t\tif p == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif _, err := os.ReadFile(p); err != nil {\r\n\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\t\treturn 1\r\n\t\t}\r\n\t}\r\n\r\n\trep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)\r\n\toutputJSON(rep)\r\n\treturn code\r\n}\r\n"]
[3671.118992, "o", "\r\nfunc runMergeCheckpoints(args []string) int {\r\n\tfs := flag.NewFlagSet(\"merge-checkpoints\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tconflict := fs.String(\"conflict\", \"first\", \"conflict strategy\")\r\n\r\n\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n"]
[3671.119058, "o", "\t\treturn 1\r\n\t}\r\n\tif len(pos) < 3 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n"]
[3671.119119, "o", "\r\n\tres, err := merge.Merge(pos[0], pos[1:], *conflict)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\toutputJSON(res)\r\n\treturn 0\r\n}\r\n\r\nfunc runDriftAnalysis(args []string) int {\r\n\tfs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\r\n\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n"]
[3671.119183, "o", "\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tif len(pos) < 2 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tres, err := drift.Analyze(pos)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n"]
[3671.119258, "o", "\t\treturn 1\r\n\t}\r\n\toutputJSON(res)\r\n\treturn 0\r\n}\r\n\r\nfunc parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {\r\n\tvar positional []string"]
[3671.119318, "o", "\r\n\tvar flagArgs []string\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tif arg == \"--\" {\r\n\t\t\tpositional = append(positional, args[i+1:]...)\r\n\t\t\tbreak\r\n\t\t}\r\n\t\tif strings.HasPrefix(arg, \"--\") {\r\n\t\t\tif strings.Contains(arg, \"=\") {\r\n\t\t\t\tflagArgs = append(flagArgs, arg)\r\n\t\t\t\tcontinue\r\n"]
[3671.119378, "o", "\t\t\t}\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn nil, fmt.Errorf(\"flag %s requires a value\", arg)\r\n\t\t\t}\r\n\t\t\tflagArgs = append(flagArgs, arg+\"=\"+args[i+1])\r\n\t\t\ti++\r\n\t\t} else {\r\n\t\t\tpositional = append(positional, arg)\r\n\t\t}\r\n"]
[3671.119436, "o", "\t}\r\n\r\n\tif err := fs.Parse(flagArgs); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn positional, nil\r\n}\r\n\r\nfunc outputJSON(v interface{}) {\r\n\tenc := json.NewEncoder(os.Stdout)\r\n"]
[3671.119495, "o", "\tenc.SetIndent(\"\", \"  \")\r\n\t_ = enc.Encode(v)\r\n}\r\n"]
[3671.119915, "o", "\u001b[?2004h"]
[3671.11997, "o", "root@n30009:/app# "]
[3678.002412, "i", "nl -ba internal/report/report.go | sed -n '1,260p'\n"]
[3678.002806, "o", "nl -ba internal/report/report.go | sed -n '1,260p'\r\n\u001b[?2004l\r"]
[3678.006417, "o", "     1\tpackage report\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"strings\"\r\n"]
[3678.006496, "o", "     6\t\t\"time\"\r\n     7\t\r\n     8\t\t\"repro-verify/internal/compare\"\r\n     9\t\t\"repro-verify/internal/lineage\"\r\n    10\t\t\"repro-verify/internal/manifest\"\r\n    11\t\t\"repro-verify/internal/mlck\"\r\n    12\t)\r\n    13\t\r\n    14\ttype ManifestPart struct {\r\n    15\t\tValid    bool     `json:\"valid\"`\r\n    16\t\tWarnings []string `json:\"warnings,omitempty\"`\r\n    17\t\tErrors   []string `json:\"errors,omitempty\"`\r\n    18\t}\r\n"]
[3678.006573, "o", "    19\t\r\n    20\ttype CheckpointPart struct {\r\n    21\t\tValid        bool   `json:\"valid\"`\r\n    22\t\tNumTensors   int    `json:\"num_tensors\"`\r\n    23\t"]
[3678.006636, "o", "\tFileChecksum string `json:\"file_checksum\"`\r\n    24\t\tError        string `json:\"error,omitempty\"`\r\n    25\t}\r\n    26\t\r\n    27\ttype ComparisonPart struct {\r\n    28\t\tMatch   bool   `json:\"match\"`\r\n    29\t\tSummary string `json:\"summary,omitempty\"`\r\n    30\t\tError   string `json:\"error,omitempty\"`\r\n    31\t}\r\n    32\t\r\n    33\ttype LineagePart struct {\r\n    34\t\tValid bool   `json:\"valid\"`\r\n    35\t\tDepth int    `json:\"depth\"`\r\n    36\t\tError string `json:\"error,omitempty\"`\r\n    37\t}\r\n    38\t\r\n    39\ttype Report struct {\r\n"]
[3678.006703, "o", "    40\t\tReportVersion       string          `json:\"report_version\"`\r\n    41\t\tTimestamp           string          `json:\"timestamp\"`\r\n    42\t\tManifest            ManifestPart    `json:\"manifest\"`\r\n    43\t\tCheckpoint          *CheckpointPart `json:\"checkpoint,omitempty\"`\r\n    44\t\tComparison          *ComparisonPart `json:\"comparison,omitempty\"`\r\n    45\t\tLineage             *LineagePart    `json:\"lineage,omitempty\"`\r\n    46\t\tOverallReproducible bool            `json:\"overall_reproducible\"`\r\n    47\t\tIssues              []string        `json:\"issues\"`\r\n    48\t}\r\n    49\t"]
[3678.006768, "o", "\r\n    50\tfunc Generate(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {\r\n    51\t\tissues := []string{}\r\n    52\t\trep := &Report{\r\n    53\t\t\tReportVersion: \"1.0\",\r\n    54\t\t\tTimestamp:     time.Now().Format(time.RFC3339),\r\n    55\t\t\tIssues:        issues,\r\n    56\t\t}\r\n"]
[3678.006831, "o", "    57\t\r\n    58\t\tman := manifest.Validate(manifestPath)\r\n    59\t\trep.Manifest = ManifestPart{\r\n    60\t\t\tValid:    man.Valid,\r\n    61\t\t\tWarnings: man.Warnings,\r\n    62\t\t\tErrors:   man.Errors,\r\n    63\t\t}\r\n    64\t\tif !man.Valid {\r\n    65\t\t\tissues = append(issues, fmt.Sprintf(\"Manifest validation failed: %s\", strings.Join(man.Errors, \"; \")))\r\n    66\t\t"]
[3678.006889, "o", "}\r\n    67\t\r\n    68\t\tcheckpointValid := true\r\n    69\t\tif checkpointPath != \"\" {\r\n    70\t\t\tcp, err := mlck.ParseFile(checkpointPath)\r\n    71\t\t\tif err != nil {\r\n    72\t\t\t\tcheckpointValid = false\r\n"]
[3678.006951, "o", "    73\t\t\t\trep.Checkpoint = &CheckpointPart{\r\n    74\t\t\t\t\tValid: false,\r\n    75\t\t\t\t\tError: err.Error(),\r\n    76\t\t\t\t}\r\n    77\t\t\t\tissues = append(issues, fmt.Sprintf(\"Checkpoint verification failed: %v\", err))\r\n    78\t\t\t} else {\r\n    79\t\t\t\trep.Checkpoint = &CheckpointPart{\r\n    80\t\t\t\t\tValid:        true,\r\n    81\t\t\t\t\tNumTensors:   len(cp.Tensors),\r\n"]
