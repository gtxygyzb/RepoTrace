[436.887078, "i", "(uint8, error) {\n\tif a == b {\n\t\treturn a, nil\n\t}\n\trank := func(d uint8) int {\n\t\tswitch Dtype(d) {\n\t\tcase Int32:\n\t\t\treturn 0\n\t\tcase Int64:\n\t\t\treturn 1\n\t\tcase Float32:\n\t\t\treturn 2\n\t\tcase Float64:\n\t\t\treturn 3\n\t\tdefault:\n\t\t\treturn -1\n\t\t}\n\t}\n\tra := rank(a)\n\trb := rank(b)\n\tif ra < 0 || rb < 0 {\n\t\treturn 0, fmt.Errorf(\"invalid dtype promotion %d and %d\", a, b)\n\t}\n\tif ra >= rb {\n\t\treturn a, nil\n\t}\n\treturn b, nil\n}\nEOF\n"]
