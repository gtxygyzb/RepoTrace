[5580.212029, "o", "    86\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"parent reference unresolved: %s -> %s\", e.ID, p))\r\n    87\t\t\t\t}\r\n    88\t\t\t}\r\n    89\t\t}\r\n    90\t\r\n    91\t\ttimes := make(map[string]time.Time)\r\n    92\t\tfor _, e := range exps {\r\n    93\t\t\tif e.ID == \"\" {\r\n    94\t\t\t\tcontinue\r\n"]
[5580.212096, "o", "    95\t\t\t}\r\n    96\t\t\tif e.Timestamp == \"\" {\r\n    97\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"missing timestamp for experiment: %s\", e.ID))\r\n    98\t\t\t\tcontinue\r\n    99\t\t\t}\r\n   100\t\t\tt, err := time.Parse(time.RFC3339, e.Timestamp)\r\n   101\t\t\tif err != nil {\r\n"]
[5580.212168, "o", "   102\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"invalid timestamp for experiment: %s\", e.ID))\r\n   103\t\t\t} else {\r\n   104\t\t\t\ttimes[e.ID] = t\r\n   105\t\t\t}\r\n   106\t\t}\r\n   107\t\r\n   108\t\tif len(result.Errors) == 0 {\r\n   109\t\t\tif cycle := detectCycle(exps); cycle != nil {\r\n   110\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"cycle detected involving: %s\", strings.Join(cycle, \", \")))\r\n   111\t\t\t}\r\n   112\t\t}\r\n   113\t\r\n   114\t\tif len(result.Errors) == 0 {\r\n   115\t\t\t"]
[5580.212273, "o", "for _, e := range exps {\r\n   116\t\t\t\tchildTime, ok := times[e.ID]\r\n   117\t\t\t\tif !ok {\r\n   118\t\t\t\t\tcontinue\r\n   119\t\t\t\t}\r\n"]
[5580.212391, "o", "   120\t\t\t\tfor _, p := range e.Parents {\r\n   121\t\t\t\t\tparentTime, ok := times[p]\r\n   122\t\t\t\t\tif !ok {\r\n   123\t\t\t\t\t\tcontinue\r\n   124\t\t\t\t\t}\r\n   125\t\t\t\t\tif !childTime.After(parentTime) {\r\n   126\t\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"timestamp violation: %s (%s) has parent %s (%s)\", e.ID, childTime.Format(\"2006-01-02\"), p, parentTime.Format(\"2006-01-02\")))\r\n   127\t\t\t\t\t}\r\n   128\t\t\t\t}\r\n   129\t\t\t}\r\n   130\t\t}\r\n   131\t\r\n   132\t\tif len(result.Errors) > 0 {\r\n   133\t\t\tresult.Valid = false\r\n   134\t\t\tresult.TopologicalOrder = nil\r\n   135\t\t\treturn result\r\n   136\t\t}\r\n   137\t\r\n   138\t\tchildren := make(map[string][]string)\r\n   139\t\tfor _, e := range exps {\r\n   140\t\t\tfor _, p := range e.Parents {\r\n   141\t\t\t\tchildren[p] = append(children[p], e.ID)\r\n"]
[5580.212461, "o", "   142\t\t\t}\r\n   143\t\t}\r\n   144\t\r\n   145\t\troots := make([]string, 0)\r\n   146\t\tleaves := make([]string, 0)\r\n   147\t\tfor _, e := range exps {\r\n   148\t\t\tif len(e.Parents) == 0 {\r\n   149\t\t\t\troots = append(roots, e.ID)\r\n   150\t\t\t}\r\n   151\t"]
[5580.212523, "o", "\t\tif len(children[e.ID]) == 0 {\r\n   152\t\t\t\tleaves = append(leaves, e.ID)\r\n   153\t\t\t}\r\n   154\t\t}\r\n   155\t\r\n   156\t\tvisited := make(map[string]bool)\r\n   157\t\tvar post []string\r\n   158\t\tvar dfs func(id string)\r\n   159\t\tdfs = func(id string) {\r\n   160"]
[5580.212582, "o", "\t\t\tvisited[id] = true\r\n   161\t\t\tfor _, child := range children[id] {\r\n   162\t\t\t\tif !visited[child] {\r\n   163\t\t\t\t\tdfs(child)\r\n   164\t\t\t\t}\r\n   165\t\t\t}\r\n   166\t\t\tpost = append(post, id)\r\n   167\t\t}\r\n"]
[5580.212653, "o", "   168\t\tfor _, e := range exps {\r\n   169\t\t\tif !visited[e.ID] {\r\n   170\t\t\t\tdfs(e.ID)\r\n   171\t\t\t}\r\n   172\t\t}\r\n   173\t\ttopo := make([]string, len(post))\r\n   174\t\tfor i := range post {\r\n   175\t\t\ttopo[i] = post[len(post)-1-i]\r\n   176\t\t}\r\n"]
[5580.212713, "o", "   177\t\r\n   178\t\tmaxDepth := 0\r\n   179\t\tvar depthDFS func(id string, depth int)\r\n   180\t\tdepthDFS = func(id string, depth int) {\r\n   181\t\t\tif depth > maxDepth {\r\n   182\t\t\t\tmaxDepth = depth\r\n   183\t\t\t}\r\n   184\t\t\tfor _, child := range children[id] {\r\n   185\t\t\t\tdepthDFS(child, depth+1)\r\n   186\t\t\t}\r\n"]
[5580.212775, "o", "   187\t\t}\r\n   188\t\tfor _, r := range roots {\r\n   189\t\t\tdepthDFS(r, 1)\r\n   190\t\t}\r\n   191\t\r\n   192\t\tresult.NumExperiments = len(exps)\r\n   193\t\tresult.NumRoots = len(roots)\r\n   194\t\tresult.NumLeaves = len(leaves)\r\n"]
[5580.212835, "o", "   195\t\tresult.MaxDepth = maxDepth\r\n   196\t\tresult.TopologicalOrder = topo\r\n   197\t\treturn result\r\n   198\t}\r\n   199\t\r\n   200\tfunc detectCycle(exps []Experiment) []string {\r\n   201\t\tadj := make(map[string][]string)\r\n   202\t\tfor _, e := range exps {\r\n   203\t\t\tfor _, p := range e.Parents {\r\n"]
[5580.212895, "o", "   204\t\t\t\tadj[p] = append(adj[p], e.ID)\r\n   205\t\t\t}\r\n   206\t\t}\r\n   207\t\r\n   208\t\tstate := make(map[string]int)\r\n   209\t\tvar stack []string\r\n   210\t\tvar cycle []string\r\n   211\t\r\n"]
[5580.212959, "o", "   212\t\tvar dfs func(id string) bool\r\n   213\t\tdfs = func(id string) bool {\r\n   214\t\t\tstate[id] = 1\r\n   215\t\t\tstack = append(stack, id)\r\n   216\t\t\tfor _, child := range adj[id] {\r\n   217\t\t\t\tif state[child] == 1 {\r\n   218\t\t\t\t\tidx := -1\r\n   219\t\t\t\t\tfor i := len(stack) - 1; i >= 0; i-- {\r\n   220\t\t\t\t\t\tif stack[i] == child {\r\n   221\t\t\t"]
[5580.21302, "o", "\t\t\t\tidx = i\r\n   222\t\t\t\t\t\t\tbreak\r\n   223\t\t\t\t\t\t}\r\n   224\t\t\t\t\t}\r\n   225\t\t\t\t\tif idx >= 0 {\r\n   226\t\t\t\t\t\tcycle = append([]string{}, stack[idx:]...)\r\n   227\t\t\t\t\t\treturn true\r\n"]
[5580.21308, "o", "   228\t\t\t\t\t}\r\n   229\t\t\t\t}\r\n   230\t\t\t\tif state[child] == 0 {\r\n   231\t\t\t\t\tif dfs(child) {\r\n   232\t\t\t\t\t\treturn true\r\n   233\t\t\t\t\t}\r\n   234\t\t\t\t}\r\n"]
[5580.213142, "o", "   235\t\t\t}\r\n   236\t\t\tstack = stack[:len(stack)-1]\r\n   237\t\t\tstate[id] = 2\r\n   238\t\t\treturn false\r\n   239\t\t}\r\n   240\t\r\n   241\t\tfor _, e := range exps {\r\n   242\t\t\tif state[e.ID] == 0 {\r\n"]
[5580.213213, "o", "   243\t\t\t\tif dfs(e.ID) {\r\n   244\t\t\t\t\treturn cycle\r\n   245\t\t\t\t}\r\n   246\t\t\t}\r\n   247\t\t}\r\n   248\t\treturn nil\r\n   249\t}\r\n"]
