[4014.207415, "o", "outputJSON(map[string]interface{}{\"error\": \"usage: repro-verify audit-lineage <file.json>\"})\r\n   149\t\t\treturn 1\r\n   150\t\t}\r\n   151\t\tif _, err := os.ReadFile(args[0]); err != nil {\r\n   152\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   153\t\t\treturn 1\r\n   154\t\t}\r\n   155\t\tres := lineage.Audit(args[0])\r\n   156\t\toutputJSON(res)\r\n   157\t"]
[4014.207479, "o", "\tif res.Valid {\r\n   158\t\t\treturn 0\r\n   159\t\t}\r\n   160\t\treturn 1\r\n   161\t}\r\n   162\t\r\n   163\tfunc runGenerateReport(args []string) int {\r\n   164\t\tfs := flag.NewFlagSet(\"generate-report\", flag.ContinueOnError)\r\n   165\t\tfs.SetOutput(io.Discard)\r\n"]
[4014.207556, "o", "   166\t\tcheckpoint := fs.String(\"checkpoint\", \"\", \"checkpoint file to verify\")\r\n   167\t\tcomparePath := fs.String(\"compare\", \"\", \"second checkpoint to compare\")\r\n   168\t\tlineagePath := fs.String(\"lineage\", \"\", \"lineage file to audit\")\r\n   169\t\r\n   170\t\tpos, err := parseMixedArgs(fs, args)\r\n   171\t\tif err != nil {\r\n   172\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   173\t\t\treturn 1\r\n   174\t\t}\r\n   175\t\tif len(pos) != 1 {\r\n   176\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify generate-report <manifest.toml> [flags]\"})\r\n"]
