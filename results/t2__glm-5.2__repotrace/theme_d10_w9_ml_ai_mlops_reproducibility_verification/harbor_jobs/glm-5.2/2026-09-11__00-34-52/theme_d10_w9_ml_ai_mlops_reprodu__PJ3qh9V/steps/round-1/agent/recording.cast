[3231.361626, "o", "package mlck\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n"]
[3231.36172, "o", "\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n)\r\n\r\nconst (\r\n\tMagic      = \"MLCK\"\r\n\tVersion    = 1\r\n\tHeaderSize = 16\r\n\tFooterSize = 32\r\n)\r\n\r\ntype Dtype uint8\r\n\r\n"]
[3231.361794, "o", "const (\r\n\tFloat32 Dtype = 0\r\n\tFloat64 Dtype = 1\r\n\tInt32   Dtype = 2\r\n\tInt64   Dtype = 3\r\n)\r\n\r\nfunc (d Dtype) Valid() bool {\r\n\treturn d == Float32 || d == Float64 || d == Int32 || d == Int64\r\n}\r\n\r\n"]
[3231.361864, "o", "func (d Dtype) Name() string {\r\n\tswitch d {\r\n\tcase Float32:\r\n\t\treturn \"float32\"\r\n\tcase Float64:\r\n\t\treturn \"float64\"\r\n\tcase Int32:\r\n\t\treturn \"int32\"\r\n\tcase Int64:\r\n\t"]
[3231.361934, "o", "\treturn \"int64\"\r\n\tdefault:\r\n\t\treturn \"unknown\"\r\n\t}\r\n}\r\n\r\nfunc (d Dtype) Size() int {\r\n\t"]
[3231.362003, "o", "switch d {\r\n\tcase Float32, Int32:\r\n\t\treturn 4\r\n\tcase Float64, Int64:\r\n\t\treturn 8\r\n\tdefault:\r\n\t\treturn 0\r\n\t}\r\n}\r\n\r\nfunc DtypeName(dtype uint8) string {\r\n"]
[3231.362073, "o", "\treturn Dtype(dtype).Name()\r\n}\r\n\r\nfunc DtypeSize(dtype uint8) int {\r\n\treturn Dtype(dtype).Size()\r\n}\r\n\r\nfunc Product(shape []uint32) int64 {\r\n\tp := int64(1)\r\n\tfor _, s := range shape {\r\n\t\tp *= int64(s)\r\n\t}\r\n\treturn p\r\n}\r\n"]
[3231.36214, "o", "\r\ntype Tensor struct {\r\n\tName     string\r\n\tDtype    uint8\r\n\tShape    []uint32\r\n\tData     []byte\r\n\tChecksum string\r\n"]
[3231.362217, "o", "}\r\n\r\ntype TensorInfo struct {\r\n\tName     string   `json:\"name\"`\r\n\tDtype    string   `json:\"dtype\"`\r\n\tShape    []uint32 `json:\"shape\"`\r\n\tChecksum string   `json:\"checksum\"`\r\n}\r\n\r\nfunc (t Tensor) Info() TensorInfo {\r\n\treturn TensorInfo{\r\n"]
[3231.362315, "o", "\t\tName:     t.Name,\r\n\t\tDtype:    DtypeName(t.Dtype),\r\n\t\tShape:    t.Shape,\r\n\t\tChecksum: t.Checksum,\r\n\t}\r\n}\r\n\r\ntype Checkpoint struct {\r\n\tVersion      uint32\r\n"]
[3231.362384, "o", "\tNumTensors   uint32\r\n\tMetadata     map[string]interface{}\r\n\tMetadataRaw  []byte\r\n\tTensors      []Tensor\r\n\tFileChecksum string\r\n\tFilePath     string\r\n}\r\n\r\nfunc ParseFile(path string) (*Checkpoint, error) {\r\n\tdata, err := os.ReadFile(path)\r\n"]
[3231.362451, "o", "\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn Parse(data, path)\r\n}\r\n\r\nfunc Parse(data []byte, path string) (*Checkpoint, error) {\r\n\tif len(data) < HeaderSize+FooterSize {\r\n"]
[3231.362517, "o", "\t\treturn nil, fmt.Errorf(\"file too small\")\r\n"]
