[4724.487283, "i", "nt(\"top-k\", 0, \"number of tensors with the lowest stability scores to include\")\n\n        pos, err := parseMixedArgs(fs, args)\n        if err != nil {\n                outputJSON(map[string]interface{}{\"error\": err.Error()})\n                return 1\n        }\n        if len(pos) < 2 {\n                outputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\n                return 1\n        }\n\n        res, err := drift.AnalyzeWithTopK(pos, *topK)\n        if err != nil {\n                outputJSON(map[string]interface{}{\"error\": err.Error()})\n                return 1\n        }\n        outputJSON(res)\n        return 0\n}\n'''\n\nif old not in s:\n    raise SystemExit('pattern not found')\npath.write_text(s.replace(old, new))\nPY\n"]
