[3678.007432, "o", "   130\t\t\t\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Tensor comparison failed: %d tensors differ beyond tolerance\", differ))\r\n   131\t\t\t\t\t\t\t} else {\r\n   132\t\t\t\t\t\t\t\tissues = append(issues, \"Tensor comparison failed: missing tensors or shape mismatch\")\r\n   133\t\t\t\t\t\t\t}\r\n   134\t\t\t\t\t\t}\r\n   135\t\t\t"]
[3678.007488, "o", "\t\t}\r\n   136\t\t\t\t}\r\n   137\t\t\t}\r\n   138\t\t}\r\n   139\t\r\n   140\t\tlineageValid := true\r\n   141\t\tif lineagePath != \"\" {\r\n   142\t\t\t"]
[3678.007548, "o", "lin := lineage.Audit(lineagePath)\r\n   143\t\t\tif lin.Valid {\r\n   144\t\t\t\trep.Lineage = &LineagePart{\r\n   145\t\t\t\t\tValid: true,\r\n   146\t\t\t\t\tDepth: lin.MaxDepth,\r\n   147\t\t\t\t}\r\n   148\t\t\t} else {\r\n   149\t\t\t\tlineageValid = false\r\n"]
