[4868.334145, "o", "     1\tpackage drift\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"math\"\r\n     6\t\t"]
[4868.334279, "o", "\"sort\"\r\n     7\t\r\n     8\t\t\"repro-verify/internal/mlck\"\r\n     9\t)\r\n    10\t\r\n    11\ttype TensorResult struct {\r\n    12\t\tName           string    `json:\"name\"`\r\n    13\t\tStepChanges    []float64 `json:\"step_changes\"`\r\n    14\t\tMeanChange     float64   `json:\"mean_change\"`\r\n    15\t\tMaxChange      float64   `json:\"max_change\"`\r\n    16\t\tConvergence    string    `json:\"convergence\"`\r\n    17\t\tStabilityScore float64   `json:\"stability_score\"`\r\n    18\t}\r\n    19\t\r\n    20\ttype Result struct {\r\n    21\t\tNumSnapshots       int            `json:\"num_snapshots\"`\r\n    22\t\tNumAnalyzedTensors int            `json:\"num_analyzed_tensors\"`\r\n    23\t\tSkippedTensors     []string       `json:\"skipped_tensors\"`\r\n    24\t\tTensors            []TensorResult `json:\"tensors\"`\r\n    25\t\tOverallConvergence string         `json:\"overall_convergence\"`\r\n"]
[4868.33439, "o", "    26\t\tTopK               *int           `json:\"top_k,omitempty\"`\r\n    27\t}\r\n    28\t\r\n    29\t// Analyze remains available for callers that do not need a top-k restriction.\r\n    30\tfunc Analyze(files []string) (*Result, error) {\r\n    31\t\treturn AnalyzeWithTopK(files, 0)\r\n    32\t}\r\n    33\t\r\n    34\t// AnalyzeWithTopK analyzes drift and optionally restricts the returned tensor\r\n    35\t// list to the N tensors with the lowest stability scores. When topK > 0 the\r\n    36\t// result includes a top_k field set to the requested N, even if fewer tensors\r\n    37\t// are returned.\r\n    38\tfunc AnalyzeWithTopK(files []string, topK int) (*Result, error) {\r\n    39\t\tif len(files) < 2 {\r\n    40\t\t\treturn nil, fmt.Errorf(\"at least 2 input files required\")\r\n    41\t\t}\r\n    42\t\r\n    43\t\tcps := make([]*mlck.Checkpoint, len(files))\r\n"]
[4868.334489, "o", "    44\t\tfor i, f := range files {\r\n    45\t\t\tcp, err := mlck.ParseFile(f)\r\n    46\t\t\tif err != nil {\r\n    47\t\t\t\treturn nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n    48\t\t\t}\r\n    49\t\t\tcps[i] = cp\r\n    50\t\t}\r\n    51\t\r\n    52\t\tvar allNames []string\r\n    53\t\tseen := map[string]bool{}\r\n    54\t\tfor _, cp := range cps {\r\n    55\t\t\tfor _, t := range cp.Tensors {\r\n    56\t\t\t\tif !seen[t.Name] {\r\n    57\t\t\t\t\tseen[t.Name] = true\r\n    58\t\t\t\t\tallNames = append(allNames, t.Name)\r\n    59\t\t\t\t}\r\n"]
[4868.334632, "o", "    60\t\t\t}\r\n    61\t\t}\r\n    62\t\tsort.Strings(allNames)\r\n    63\t\r\n    64\t\tskipped := []string{}\r\n    65\t\ttensors := []TensorResult{}\r\n    66\t\tconverging := 0\r\n    67\t\tdiverging := 0\r\n    68\t\r\n    69\t\tfor _, name := range allNames {\r\n    70\t\t\tok := true\r\n    71\t\t\tvar shape []uint32\r\n    72\t\t\tfor _, cp := range cps {\r\n    73\t\t\t\tt, exists := tensorByName(cp, name)\r\n    74\t\t\t\tif !exists {\r\n    75\t\t\t\t\tok = false\r\n    76\t\t\t\t\tbreak\r\n    77\t\t\t\t}\r\n    78\t\t\t\tif shape == nil {\r\n    79\t\t\t\t\tshape = t.Shape\r\n    80\t\t\t\t} else if !shapesEqual(shape, t.Shape) {\r\n    81\t\t\t\t\tok = false\r\n"]
[4868.334729, "o", "    82\t\t\t\t\tbreak\r\n    83\t\t\t\t}\r\n    84\t\t\t}\r\n    85\t\t\tif !ok {\r\n    86\t\t\t\tskipped = append(skipped, name)\r\n    87\t\t\t\tcontinue\r\n    88\t\t\t}\r\n    89\t\r\n    90\t\t\tsteps := make([]float64, len(cps)-1)\r\n    91\t\t\tfor i := 0; i < len(steps); i++ {\r\n    92\t\t\t\tv1, err := tensorData(cps[i], name)\r\n    93\t\t\t\tif err != nil {\r\n    94\t\t\t\t\treturn nil, err\r\n    95\t\t\t\t}\r\n"]
[4868.334819, "o", "    96\t\t\t\tv2, err := tensorData(cps[i+1], name)\r\n    97\t\t\t\tif err != nil {\r\n    98\t\t\t\t\treturn nil, err\r\n    99\t\t\t\t}\r\n   100\t\t\t\tn := len(v1)\r\n   101\t\t\t\tif n == 0 {\r\n   102\t\t\t\t\tsteps[i] = 0\r\n   103\t\t\t\t\tcontinue\r\n   104\t\t\t\t}\r\n   105\t\t\t\tvar sum float64\r\n   106\t\t\t\tfor j := 0; j < n; j++ {\r\n   107\t\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n   108\t\t\t\t}\r\n   109\t\t\t\tsteps[i] = sum / float64(n)\r\n   110"]
[4868.334908, "o", "\t\t\t}\r\n   111\t\r\n   112\t\t\tmean := meanFloat64(steps)\r\n   113\t\t\tmax := maxFloat64(steps)\r\n   114\t\t\tconvergence := classifyConvergence(steps)\r\n   115\t\t\tstability := 1.0\r\n   116\t\t\tif max != 0 {\r\n   117\t\t\t\tstability = 1.0 - steps[len(steps)-1]/max\r\n   118\t\t\t\tif stability < 0 {\r\n   119\t\t\t\t\tstability = 0\r\n   120\t\t\t\t} else if stability > 1 {\r\n   121\t\t\t\t\tstability = 1\r\n   122\t\t\t\t}\r\n"]
[4868.334995, "o", "   123\t\t\t}\r\n   124\t\r\n   125\t\t\ttensors = append(tensors, TensorResult{\r\n   126\t\t\t\tName:           name,\r\n   127\t\t\t\tStepChanges:    steps,\r\n   128\t\t\t\tMeanChange:     mean,\r\n   129\t\t\t\tMaxChange:      max,\r\n   130\t\t\t\tConvergence:    convergence,\r\n   131\t\t\t\tStabilityScore: stability,\r\n   132\t\t\t})\r\n   133\t\r\n"]
[4868.335082, "o", "   134\t\t\tif convergence == \"converging\" {\r\n   135\t\t\t\tconverging++\r\n   136\t\t\t} else if convergence == \"diverging\" {\r\n   137\t\t\t\tdiverging++\r\n   138\t\t\t}\r\n   139\t\t}\r\n   140\t\r\n   141\t\toverall := \"mixed\"\r\n   142\t\tif converging > len(tensors)/2 {\r\n   143\t\t\toverall = \"converging\"\r\n   144\t\t} else if diverging > len(tensors)/2 {\r\n   145\t\t\toverall = \"diverging\"\r\n"]
