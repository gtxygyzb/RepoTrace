[2643.321437, "o", "     1\tpackage manifest\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"os\"\r\n"]
[2643.321512, "o", "     6\t\t\"regexp\"\r\n     7\t\t\"strconv\"\r\n     8\t\t\"strings\"\r\n     9\t\t\"time\"\r\n    10\t)\r\n    11\t\r\n    12\ttype Result struct {\r\n    13\t\tValid    bool     `json:\"valid\"`\r\n    14\t\tWarnings []string `json:\"warnings,omitempty\"`\r\n    15\t\tErrors   []string `json:\"errors,omitempty\"`\r\n    16\t}\r\n    17\t"]
[2643.321583, "o", "\r\n    18\tfunc Validate(path string) *Result {\r\n    19\t\tdata, err := os.ReadFile(path)\r\n    20\t\tif err != nil {\r\n    21\t\t\treturn &Result{\r\n    22\t\t\t\tValid:  false,\r\n    23\t\t\t\tErrors: []string{fmt.Sprintf(\"failed to read manifest: %v\", err)},\r\n    24\t\t\t}\r\n    25\t\t}\r\n    26\t"]
[2643.321642, "o", "\r\n    27\t\troot, err := parseTOML(string(data))\r\n    28\t\tif err != nil {\r\n    29\t\t\treturn &Result{\r\n    30\t\t\t\tValid:  false,\r\n    31\t\t\t\tErrors: []string{fmt.Sprintf(\"failed to parse manifest: %v\", err)},\r\n    32\t\t\t}\r\n    33\t\t}\r\n    34\t\r\n    35\t"]
[2643.321717, "o", "\tresult := &Result{\r\n    36\t\t\tValid:    true,\r\n    37\t\t\tWarnings: []string{},\r\n    38\t\t\tErrors:   []string{},\r\n    39\t\t}\r\n    40\t\r\n    41\t\texperiment := getTable(root, \"experiment\")\r\n    42\t\tenvironment := getTable(root, \"environment\")\r\n    43\t\toutputs := getTable(root, \"outputs\")\r\n"]
[2643.321776, "o", "    44\t\r\n    45\t\tif experiment == nil {\r\n    46\t\t\tresult.Errors = append(result.Errors, \"missing required field: experiment.name\")\r\n    47\t\t\tresult.Errors = append(result.Errors, \"missing required field: experiment.timestamp\")\r\n    48\t\t} else {\r\n    49\t\t\tname, ok := experiment[\"name\"].(string)\r\n    50\t\t\tif !ok || name == \"\" {\r\n    51\t\t\t\tresult.Errors = append(result.Errors, \"missing required field: experiment.name\")"]
[2643.321834, "o", "\r\n    52\t\t\t}\r\n    53\t\r\n    54\t\t\ttimestamp, ok := experiment[\"timestamp\"].(string)\r\n    55\t\t\tif !ok || timestamp == \"\" {\r\n    56\t\t\t\tresult.Errors = append(result.Errors, \"missing required field: experiment.timestamp\")\r\n    57\t\t\t} else if _, err := time.Parse(time.RFC3339, timestamp); err != nil {\r\n    58\t\t\t\tresult.Errors = append(result.Errors, \"invalid timestamp format\")\r\n    59"]
[2643.321894, "o", "\t\t\t}\r\n    60\t\t}\r\n    61\t\r\n    62\t\tif environment == nil {\r\n    63\t\t\tresult.Errors = append(result.Errors, \"missing required field: environment.python_version\")\r\n    64\t\t\tresult.Errors = append(result.Errors, \"missing required field: environment.seed\")\r\n    65\t\t\tresult.Errors = append(result.Errors, \"missing required field: environment.deterministic\")\r\n    66\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'environment.gpu_id' missing\")\r\n    67\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'environment.cuda_version' missing\")\r\n"]
[2643.321956, "o", "    68\t\t} else {\r\n    69\t\t\tpythonVersion, ok := environment[\"python_version\"].(string)\r\n    70\t\t\tif !ok || pythonVersion == \"\" {\r\n    71\t\t\t\tresult.Errors = append(result.Errors, \"missing required field: environment.python_version\")\r\n    72\t\t\t} else if !pythonVersionRegex.MatchString(pythonVersion) {\r\n    73\t\t\t\tresult.Errors = append(result.Errors, \"invalid python_version format\")\r\n    74\t\t\t}\r\n    75\t\r\n    76\t\t\tseed, ok := environment[\"seed\"]\r\n"]
[2643.322024, "o", "    77\t\t\tif !ok {\r\n    78\t\t\t\tresult.Errors = append(result.Errors, \"missing required field: environment.seed\")\r\n    79\t\t\t} else if !isNonNegativeInt(seed) {\r\n    80\t\t\t\tresult.Errors = append(result.Errors, \"invalid environment.seed\")\r\n    81\t\t"]
[2643.322083, "o", "\t}\r\n    82\t\r\n    83\t\t\tif _, ok := environment[\"deterministic\"].(bool); !ok {\r\n    84\t\t\t\tresult.Errors = append(result.Errors, \"missing required field: environment.deterministic\")\r\n    85\t\t\t}\r\n    86\t\r\n    87\t\t\tif _, ok := environment[\"gpu_id\"].(string); !ok {\r\n    88\t\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'environment.gpu_id' missing\")\r\n    89\t\t\t}\r\n    90\t\t\tif _, ok := environment[\"cuda_version\"].(string); !ok {\r\n    91\t\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'environment.cuda_version' missing\")\r\n    92\t\t\t}\r\n"]
[2643.322139, "o", "    93\t\t}\r\n    94\t\r\n    95\t\tdeps, ok := root[\"dependencies\"].([]map[string]interface{})\r\n    96\t\tif !ok {\r\n    97\t\t\tresult.Errors = append(result.Errors, \"missing required field: dependencies\")\r\n    98\t\t} else {\r\n    99\t\t\tfor i, dep := range deps {\r\n   100\t\t\t\tname, nameOk := dep[\"name\"].(string)\r\n   101\t\t\t\tversion, versionOk := dep[\"version\"].(string)\r\n"]
[2643.322198, "o", "   102\t\t\t\tif !nameOk || name == \"\" {\r\n   103\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"invalid dependency at index %d: missing name\", i))\r\n   104\t\t\t\t}\r\n   105\t\t\t\tif !versionOk || version == \"\" {\r\n   106\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"invalid dependency at index %d: missing version\", i))\r\n   107\t\t\t\t}\r\n   108\t\t\t}\r\n   109\t"]
[2643.322288, "o", "\t}\r\n   110\t\r\n   111\t\tif outputs == nil {\r\n   112\t\t\tresult.Errors = append(result.Errors, \"missing required field: outputs.checkpoint_path\")\r\n   113\t\t\tresult.Errors = append(result.Errors, \"missing required field: outputs.metrics\")\r\n   114\t\t} else {\r\n   115\t\t\tcheckpointPath, ok := outputs[\"checkpoint_path\"].(string)\r\n   116\t\t\tif !ok || checkpointPath == \"\" {\r\n   117\t\t\t\tresult.Errors = append(result.Errors, \"missing required field: outputs.checkpoint_path\")\r\n   118\t\t\t}\r\n   119\t\r\n   120\t\t"]
[2643.322346, "o", "\tmetrics := getTable(outputs, \"metrics\")\r\n   121\t\t\tif metrics == nil {\r\n   122\t\t\t\tresult.Errors = append(result.Errors, \"missing required field: outputs.metrics\")\r\n   123\t\t\t} else if !hasNumericField(metrics) {\r\n   124\t\t\t\tresult.Errors = append(result.Errors, \"outputs.metrics must contain at least one numeric field\")\r\n   125\t\t\t}\r\n   126\t\t}\r\n   127\t\r\n   128\t\t"]
[2643.322403, "o", "git := getTable(root, \"git\")\r\n   129\t\tif git == nil {\r\n   130\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'git.commit' missing\")\r\n   131\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'git.branch' missing\")\r\n   132\t\t} else {\r\n   133\t\t\tif _, ok := git[\"commit\"].(string); !ok {\r\n   134\t\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'git.commit' missing\")\r\n   135\t\t\t}\r\n"]
[2643.322465, "o", "   136\t\t\tif _, ok := git[\"branch\"].(string); !ok {\r\n   137\t\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'git.branch' missing\")\r\n   138\t\t\t}\r\n   139\t\t}\r\n   140\t\r\n   141\t\tif len(result.Errors) > 0 {\r\n   142\t\t\tresult.Valid = false\r\n   143\t\t\tresult.Warnings = nil\r\n   144\t\t}\r\n   145\t\tif result.Valid && len(result.Warnings) == 0 {\r\n"]
[2643.32252, "o", "   146\t\t\tresult.Warnings = []string{}\r\n   147\t\t}\r\n   148\t\r\n   149\t\treturn result\r\n   150\t}\r\n   151\t\r\n   152\tvar pythonVersionRegex = regexp.MustCompile(`^\\d+\\.\\d+\\.\\d+$`)\r\n   153\t\r\n"]
[2643.322578, "o", "   154\tfunc getTable(root map[string]interface{}, key string) map[string]interface{} {\r\n   155\t\tv, ok := root[key]\r\n   156\t\tif !ok {\r\n   157\t\t\treturn nil\r\n   158\t\t}\r\n   159\t\tm, ok := v.(map[string]interface{})\r\n   160\t\tif !ok {\r\n   161\t\t\treturn nil\r\n   162\t\t}\r\n"]
[2643.32264, "o", "   163\t\treturn m\r\n   164\t}\r\n   165\t\r\n   166\tfunc isNonNegativeInt(v interface{}) bool {\r\n   167\t\tswitch x := v.(type) {\r\n   168\t\tcase int:\r\n   169\t\t\treturn x >= 0\r\n   170\t\tcase int64:\r\n   171\t\t\treturn x >= 0\r\n   172\t\tcase float64:\r\n   173\t\t\treturn x == float64(int64(x)) && x >= 0\r\n   174\t"]
[2643.322701, "o", "\tdefault:\r\n   175\t\t\treturn false\r\n   176\t\t}\r\n   177\t}\r\n   178\t\r\n   179\tfunc hasNumericField(m map[string]interface{}) bool {\r\n   180\t\tfor _, v := range m {\r\n   181\t\t\tswitch v.(type) {\r\n   182\t\t\t"]
[2643.322758, "o", "case int, int64, float64:\r\n   183\t\t\t\treturn true\r\n   184\t\t\t}\r\n   185\t\t}\r\n   186\t\treturn false\r\n   187\t}\r\n   188\t\r\n   189\tfunc parseTOML(data string) (map[string]interface{}, error) {\r\n   190\t\troot := map[string]interface{}{}\r\n"]
[2643.322814, "o", "   191\t\tvar current map[string]interface{} = root\r\n   192\t\tvar currentArray []map[string]interface{}\r\n   193\t\r\n   194\t\tlines := strings.Split(data, \"\\n\")\r\n   195\t\tfor lineNum, raw := range lines {\r\n   196\t\t\tline := strings.TrimSpace(raw)\r\n   197\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n   198\t\t\t\tcontinue\r\n"]
[2643.322879, "o", "   199\t\t\t}\r\n   200\t\r\n   201\t\t\tif strings.HasPrefix(line, \"[[\") && strings.HasSuffix(line, \"]]\") {\r\n   202\t\t\t\tkey := strings.TrimSpace(line[2 : len(line)-2])\r\n"]
[2643.322937, "o", "   203\t\t\t\tparts := strings.Split(key, \".\")\r\n   204\t\t\t\tparent := root\r\n   205\t\t\t\tfor i := 0; i < len(parts)-1; i++ {\r\n   206\t\t\t\t\tp := strings.TrimSpace(parts[i])\r\n   207\t\t\t\t\tnext, ok := parent[p]\r\n   208\t\t\t\t\tif !ok {\r\n   209\t\t\t\t\t\tnext = map[string]interface{}{}\r\n   210\t\t\t\t\t\tparent[p] = next\r\n   211\t\t\t\t\t}\r\n   212\t\t\t\t\tparent, ok = next.(map[string]interface{})\r\n   213\t\t\t\t\tif !ok {\r\n   214\t\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid array table path\", lineNum+1)\r\n   215\t\t\t"]
[2643.322993, "o", "\t\t}\r\n   216\t\t\t\t}\r\n   217\t\t\t\tlast := strings.TrimSpace(parts[len(parts)-1])\r\n   218\t\t\t\tarr, ok := parent[last].([]map[string]interface{})\r\n   219\t\t\t\tif !ok {\r\n   220\t\t\t\t\tarr = []map[string]interface{}{}\r\n   221\t\t\t\t}\r\n"]
[2643.323054, "o", "   222\t\t\t\titem := map[string]interface{}{}\r\n   223\t\t\t\tarr = append(arr, item)\r\n   224\t\t\t\tparent[last] = arr\r\n   225\t\t\t\tcurrent = item\r\n   226\t\t\t\tcurrentArray = arr\r\n   227\t\t\t\tcontinue\r\n   228\t\t\t}\r\n   229\t\r\n   230\t\t\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\r\n"]
[2643.323129, "o", "   231\t\t\t\tkey := strings.TrimSpace(line[1 : len(line)-1])\r\n   232\t\t\t\tparts := strings.Split(key, \".\")\r\n   233\t\t\t\tparent := root\r\n   234\t\t\t\tfor i := 0; i < len(parts)-1; i++ {\r\n   235\t\t\t\t\tp := strings.TrimSpace(parts[i])\r\n   236\t\t\t\t\tnext, ok := parent[p]\r\n   237\t\t\t\t\tif !ok {\r\n   238\t\t\t\t\t\tnext = map[string]interface{}{}\r\n   239\t\t\t\t\t\tparent[p] = next\r\n   240\t\t\t\t\t}\r\n   241\t\t\t\t\tparent, ok = next.(map[string]interface{})\r\n"]
[2643.323193, "o", "   242\t\t\t\t\tif !ok {\r\n   243\t\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid table path\", lineNum+1)\r\n   244\t\t\t\t\t}\r\n   245\t\t\t\t}\r\n   246\t\t\t\tlast := strings.TrimSpace(parts[len(parts)-1])\r\n   247\t\t\t\ttbl, ok := parent[last].(map[string]interface{})\r\n   248\t\t\t\tif !ok {\r\n   249\t\t\t\t\ttbl = map[string]interface{}{}\r\n   250"]
[2643.32326, "o", "\t\t\t\t\tparent[last] = tbl\r\n   251\t\t\t\t}\r\n   252\t\t\t\tcurrent = tbl\r\n   253\t\t\t\tcurrentArray = nil\r\n   254\t\t\t\tcontinue\r\n   255\t\t\t}\r\n   256\t\r\n   257\t\t\teq := strings.Index(line, \"=\")\r\n"]
[2643.323315, "o", "   258\t\t\tif eq < 0 {\r\n   259\t\t\t\treturn nil, fmt.Errorf(\"line %d: expected key = value\", lineNum+1)\r\n   260\t\t\t}\r\n"]
