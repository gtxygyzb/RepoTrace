[4177.422278, "o", "   253\t\t\tif strings.HasPrefix(arg, \"--\") {\r\n   254\t\t\t\tif strings.Contains(arg, \"=\") {\r\n   255\t\t\t\t\tflagArgs = append(flagArgs, arg)\r\n   256\t\t\t\t\tcontinue\r\n   257\t\t\t\t}\r\n   258\t\t\t\tif i+1 >= len(args) {\r\n   259\t\t\t\t\treturn nil, fmt.Errorf(\"flag %s requires a value\", arg)\r\n   260\t\t\t\t}\r\n   261\t\t\t\tflagArgs = append(flagArgs, arg+\"=\"+args[i+1])\r\n   262\t\t\t\ti++\r\n   263\t\t\t} else {\r\n   264\t\t\t\tpositional = append(positional, arg)\r\n   265\t\t\t}\r\n   266\t\t}\r\n   267\t\r\n   268\t\tif err := fs.Parse(flagArgs); err != nil {\r\n   269\t\t\treturn nil, err\r\n   270\t\t}\r\n   271\t\treturn positional, nil\r\n   272\t}\r\n   273\t\r\n   274\tfunc outputJSON(v interface{}) {\r\n"]
