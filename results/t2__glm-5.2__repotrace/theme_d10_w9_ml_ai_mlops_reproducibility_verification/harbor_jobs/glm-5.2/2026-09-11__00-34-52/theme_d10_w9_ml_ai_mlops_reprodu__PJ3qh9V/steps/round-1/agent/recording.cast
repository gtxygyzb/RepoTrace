[4904.959656, "o", "\t\t} else if stability > 1 {\r\n   121\t\t\t\t\tstability = 1\r\n   122\t\t\t\t}\r\n   123\t\t\t}\r\n   124\t\r\n   125\t\t\ttensors = append(tensors, TensorResult{\r\n   126\t\t\t\tName:           name,\r\n   127\t\t\t\tStepChanges:    steps,\r\n"]
