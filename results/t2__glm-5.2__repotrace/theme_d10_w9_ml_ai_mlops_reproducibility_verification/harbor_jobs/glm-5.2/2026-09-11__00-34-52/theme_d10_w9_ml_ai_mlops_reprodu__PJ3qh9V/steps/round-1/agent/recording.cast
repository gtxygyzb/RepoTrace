[4609.298355, "o", "grep: ./repro-verify: binary file matches\r\n./internal/app/app.go:12:\t\"repro-verify/internal/drift\"\r\n./internal/app/app.go:39:\tcase \"drift-analysis\":\r\n./internal/app/app.go:221:\tfs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\r\n./internal/app/app.go:230:\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})"]
[4609.298501, "o", "\r\n./internal/app/app.go:234:\tres, err := drift.Analyze(pos)\r\n./internal/drift/drift.go:1:package drift\r\n./internal/drift/drift.go:16:\tConvergence    string    `json:\"convergence\"`\r\n./internal/drift/drift.go:17:\tStabilityScore float64   `json:\"stability_score\"`\r\n./internal/drift/drift.go:25:\tOverallConvergence string         `json:\"overall_convergence\"`\r\n./internal/drift/drift.go:106:\t\tconvergence := classifyConvergence(steps)\r\n./internal/drift/drift.go:107:\t\tstability := 1.0\r\n./internal/drift/drift.go:109:\t\t"]
[4609.29857, "o", "\tstability = 1.0 - steps[len(steps)-1]/steps[0]\r\n./internal/drift/drift.go:110:\t\t\tif stability < 0 {\r\n./internal/drift/drift.go:111:\t\t\t\tstability = 0\r\n./internal/drift/drift.go:112:\t\t\t} else if stability > 1 {\r\n./internal/drift/drift.go:113:\t\t\t\tstability = 1\r\n./internal/drift/drift.go:122:\t\t\tConvergence:    convergence,\r\n./internal/drift/drift.go:123:\t\t\tStabilityScore: stability,\r\n./internal/drift/drift.go:126:\t\tif convergence == \"converging\" {\r\n./internal/drift/drift.go:128:\t\t} else if convergence == \"diverging\" {\r\n"]
