[5611.25116, "o", "\r\n    53\t\t\tReportVersion: \"1.0\",\r\n    54\t\t\tTimestamp:     time.Now().Format(time.RFC3339),\r\n    55\t\t\tIssues:        issues,\r\n    56\t\t}\r\n    57\t\r\n    58\t\tman := manifest.Validate(manifestPath)\r\n    59\t\trep.Manifest = ManifestPart{\r\n    60\t"]
[5611.251218, "o", "\t\tValid:    man.Valid,\r\n    61\t\t\tWarnings: man.Warnings,\r\n    62\t\t\tErrors:   man.Errors,\r\n    63\t\t}\r\n    64\t\tif !man.Valid {\r\n    65\t\t\tissues = append(issues, fmt.Sprintf(\"Manifest validation failed: %s\", strings.Join(man.Errors, \"; \")))\r\n    66\t\t}\r\n    67\t\r\n    68"]
[5611.251308, "o", "\t\tcheckpointValid := true\r\n    69\t\tif checkpointPath != \"\" {\r\n    70\t\t\tcp, err := mlck.ParseFile(checkpointPath)\r\n    71\t\t\tif err != nil {\r\n    72\t\t\t\tcheckpointValid = false\r\n    73\t\t\t\trep.Checkpoint = &CheckpointPart{\r\n    74\t\t\t\t\tValid: false,\r\n    75\t\t\t\t\tError: err.Error(),\r\n    76\t\t\t\t}\r\n    77\t\t\t\tissues = append(issues, fmt.Sprintf(\"Checkpoint verification failed: %v\", err))\r\n"]
[5611.251366, "o", "    78\t\t\t} else {\r\n    79\t\t\t\trep.Checkpoint = &CheckpointPart{\r\n    80\t\t\t\t\tValid:        true,\r\n    81\t\t\t\t\tNumTensors:   len(cp.Tensors),\r\n    82\t\t\t\t\tFileChecksum: cp.FileChecksum,\r\n    83\t\t\t\t}\r\n    84\t\t\t}\r\n    85\t\t"]
[5611.251426, "o", "}\r\n    86\t\r\n    87\t\tcomparisonMatch := true\r\n    88\t\tif checkpointPath != \"\" && comparePath != \"\" {\r\n    89\t\t\tc1, err := mlck.ParseFile(checkpointPath)\r\n    90\t\t\tif err != nil {\r\n    91\t\t\t\tcomparisonMatch = false\r\n    92\t\t\t\trep.Comparison = &ComparisonPart{\r\n    93\t\t\t\t\tMatch: false,\r\n"]
[5611.251486, "o", "    94\t\t\t\t\tError: fmt.Sprintf(\"checkpoint parse failed: %v\", err),\r\n    95\t\t\t\t}\r\n    96\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n    97\t\t\t} else {\r\n    98\t\t\t\tc2, err := mlck.ParseFile(comparePath)\r\n    99\t\t\t\tif err != nil {\r\n   100\t\t\t\t\tcomparisonMatch = false\r\n   101\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n   102\t\t\t\t\t\tMatch: false,\r\n   103\t\t\t\t\t\tError: fmt.Sprintf(\"compare checkpoint parse failed: %v\", err),"]
[5611.251552, "o", "\r\n   104\t\t\t\t\t}\r\n   105\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n   106\t\t\t\t} else {\r\n   107\t\t\t\t\tres, err := compare.Compare(c1, c2, \"strict\", 1e-7, 1e-5, false)\r\n   108\t\t\t\t\tif err != nil {\r\n   109\t\t\t\t\t\tcomparisonMatch = false\r\n   110\t\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n   111\t\t\t\t\t\t\tMatch: false,\r\n"]
[5611.251609, "o", "   112\t\t\t\t\t\t\tError: err.Error(),\r\n   113\t\t\t\t\t\t}\r\n   114\t\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n   115\t\t\t\t\t} else {\r\n"]
[5611.251666, "o", "   116\t\t\t\t\t\tdiffer := 0\r\n   117\t\t\t\t\t\ttotal := len(res.TensorResults)\r\n   118\t\t\t\t\t\tfor _, tr := range res.TensorResults {\r\n   119\t\t\t\t\t\t\tif !tr.Match {\r\n   120\t\t\t\t\t\t\t"]
[5611.251724, "o", "\tdiffer++\r\n   121\t\t\t\t\t\t\t}\r\n   122\t\t\t\t\t\t}\r\n   123\t\t\t\t\t\tmissing := len(res.MissingInFile1) + len(res.MissingInFile2)\r\n   124\t\t\t\t\t\tsummary := fmt.Sprintf(\"%d/%d tensors differ\", differ, total)\r\n   125\t\t\t"]
[5611.251782, "o", "\t\t\tif missing > 0 {\r\n   126\t\t\t\t\t\t\tsummary = fmt.Sprintf(\"%s, %d tensors missing\", summary, missing)\r\n   127\t\t\t\t\t\t}\r\n   128\t\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n   129\t\t\t\t\t\t\tMatch:   res.Match,\r\n"]
[5611.251845, "o", "   130\t\t\t\t\t\t\tSummary: summary,\r\n   131\t\t\t\t\t\t}\r\n   132\t\t\t\t\t\tif !res.Match {\r\n   133\t\t\t\t\t\t\tcomparisonMatch = false\r\n   134\t\t\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Tensor comparison failed: %s\", summary))\r\n   135\t\t\t\t\t\t}\r\n"]
[5611.251902, "o", "   136\t\t\t\t\t}\r\n   137\t\t\t\t}\r\n   138\t\t\t}\r\n   139\t\t}\r\n   140\t\r\n   141\t\tlineageValid := true\r\n   142\t\tif lineagePath != \"\" {\r\n   143\t\t\tlin := lineage.Audit(lineagePath)\r\n"]
[5611.251959, "o", "   144\t\t\tif lin.Valid {\r\n   145\t\t\t\trep.Lineage = &LineagePart{\r\n   146\t\t\t\t\tValid: true,\r\n   147\t\t\t\t\tDepth: lin.MaxDepth,\r\n   148\t\t\t\t}\r\n   149\t\t\t} else {\r\n   150\t\t\t\tlineageValid = false\r\n   151\t\t\t\trep.Lineage = &LineagePart{\r\n"]
