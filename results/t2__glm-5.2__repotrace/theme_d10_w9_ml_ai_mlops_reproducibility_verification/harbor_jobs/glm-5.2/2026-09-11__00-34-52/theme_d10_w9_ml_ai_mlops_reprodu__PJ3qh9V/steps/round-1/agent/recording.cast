[5873.369197, "o", "\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t} else if \u001b[01;31m\u001b[Kdiverging\u001b[m\u001b[K > len(tensors)/2 {\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Koverall\u001b[m\u001b[K = \"\u001b[01;31m\u001b[Kdiverging\u001b[m\u001b[K\"\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KOverallConvergence\u001b[m\u001b[K: \u001b[01;31m\u001b[Koverall\u001b[m\u001b[K,\r\n\u001b[32m\u001b[K170\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tdrifting := result.Tensors[i].\u001b[01;31m\u001b[KMaxChange\u001b[m\u001b[K > *threshold\r\n"]
