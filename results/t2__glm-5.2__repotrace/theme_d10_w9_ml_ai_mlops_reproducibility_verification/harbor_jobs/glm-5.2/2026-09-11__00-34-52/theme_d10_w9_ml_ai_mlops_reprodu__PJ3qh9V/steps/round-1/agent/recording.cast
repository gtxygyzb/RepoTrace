[3685.848575, "o", "\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype \u001b[m\u001b[KReport struct {\r\n\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tLineage             *LineagePart    `json:\"\u001b[01;31m\u001b[Klineage\u001b[m\u001b[K,omitempty\"`\r\n"]
[3685.84864, "o", "\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KGenerate(manifestPath, checkpointPath, \u001b[01;31m\u001b[Kcompare\u001b[m\u001b[KPath, \u001b[01;31m\u001b[Klineage\u001b[m\u001b[KPath string) (*Report, int) {\r\n"]
[3685.848698, "o", "\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif checkpointPath != \"\" && \u001b[01;31m\u001b[Kcompare\u001b[m\u001b[KPath != \"\" {\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tc2, err := mlck.ParseFile(\u001b[01;31m\u001b[Kcompare\u001b[m\u001b[KPath)\r\n\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tError: fmt.Sprintf(\"\u001b[01;31m\u001b[Kcompare\u001b[m\u001b[K checkpoint parse failed: %v\", err),\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tres, err := \u001b[01;31m\u001b[Kcompare\u001b[m\u001b[K.Compare(c1, c2, \"strict\", 1e-7, 1e-5)\r\n"]
[3685.848792, "o", "\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\t\u001b[01;31m\u001b[KSummary\u001b[m\u001b[K: fmt.Sprintf(\"%d/%d \u001b[01;31m\u001b[Ktensors\u001b[m\u001b[K differ\", differ, total),\r\n\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Tensor comparison failed: %d \u001b[01;31m\u001b[Ktensors\u001b[m\u001b[K differ beyond tolerance\", differ))\r\n"]
[3685.848852, "o", "\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\t\tissues = append(issues, \"Tensor comparison failed: \u001b[01;31m\u001b[Kmissing\u001b[m\u001b[K \u001b[01;31m\u001b[Ktensors\u001b[m\u001b[K or shape mismatch\")\r\n\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Klineage\u001b[m\u001b[KValid := true\r\n\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif \u001b[01;31m\u001b[Klineage\u001b[m\u001b[KPath != \"\" {\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tlin := \u001b[01;31m\u001b[Klineage\u001b[m\u001b[K.Audit(\u001b[01;31m\u001b[Klineage\u001b[m\u001b[KPath)\r\n\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Klineage\u001b[m\u001b[KValid = false\r\n"]
