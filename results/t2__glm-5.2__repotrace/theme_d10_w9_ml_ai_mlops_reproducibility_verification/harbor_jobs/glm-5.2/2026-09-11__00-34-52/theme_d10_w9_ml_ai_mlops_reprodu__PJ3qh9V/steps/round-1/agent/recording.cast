[3695.9606, "o", "   181\t\t\tif depth > maxDepth {\r\n   182\t\t\t\tmaxDepth = depth\r\n   183\t\t\t}\r\n   184\t\t\tfor _, child := range children[id] {\r\n"]
[3695.960675, "o", "   185\t\t\t\tdepthDFS(child, depth+1)\r\n   186\t\t\t}\r\n   187\t\t}\r\n   188\t\tfor _, r := range roots {\r\n   189\t\t\tdepthDFS(r, 1)\r\n   190\t\t}\r\n   191\t\r\n   192\t\tresult.NumExperiments = len(exps)\r\n   193\t\tresult.NumRoots = len(roots)\r\n   194\t\tresult.NumLeaves = len(leaves)\r\n   195\t\tresult.MaxDepth = maxDepth\r\n"]
[3695.960739, "o", "   196\t\tresult.TopologicalOrder = topo\r\n   197\t\treturn result\r\n   198\t}\r\n   199\t\r\n   200\tfunc detectCycle(exps []Experiment) []string {\r\n   201\t\tadj := make(map[string][]string)\r\n   202\t\tfor _, e := range exps {\r\n   203\t\t\tfor _, p := range e.Parents {\r\n   204\t\t\t\tadj[p] = append(adj[p], e.ID)\r\n   205"]
[3695.960798, "o", "\t\t\t}\r\n   206\t\t}\r\n   207\t\r\n   208\t\tstate := make(map[string]int)\r\n   209\t\tvar stack []string\r\n   210\t\tvar cycle []string\r\n   211\t\r\n   212\t\tvar dfs func(id string) bool\r\n   213\t"]
[3695.960858, "o", "\tdfs = func(id string) bool {\r\n   214\t\t\tstate[id] = 1\r\n   215\t\t\tstack = append(stack, id)\r\n   216\t\t\tfor _, child := range adj[id] {\r\n   217\t\t\t\tif state[child] == 1 {\r\n   218\t\t\t\t\tidx := -1\r\n   219\t\t\t\t\tfor i := len(stack) - 1; i >= 0; i-- {\r\n   220\t\t\t\t\t\tif stack[i] == child {\r\n   221\t\t\t\t\t\t\tidx = i\r\n"]
[3695.960919, "o", "   222\t\t\t\t\t\t\tbreak\r\n   223\t\t\t\t\t\t}\r\n   224\t\t\t\t\t}\r\n   225\t\t\t\t\tif idx >= 0 {\r\n   226\t\t\t\t\t\tcycle = append([]string{}, stack[idx:]...)\r\n   227\t\t\t\t\t\treturn true\r\n"]
[3695.960977, "o", "   228\t\t\t\t\t}\r\n   229\t\t\t\t}\r\n   230\t\t\t\tif state[child] == 0 {\r\n   231\t\t\t\t\tif dfs(child) {\r\n   232\t\t\t\t\t\treturn true\r\n   233\t\t\t\t\t}\r\n   234\t\t\t\t}\r\n   235"]
[3695.961036, "o", "\t\t\t}\r\n   236\t\t\tstack = stack[:len(stack)-1]\r\n   237\t\t\tstate[id] = 2\r\n   238\t\t\treturn false\r\n   239\t\t}\r\n   240\t\r\n   241\t\tfor _, e := range exps {\r\n   242\t\t\tif state[e.ID] == 0 {\r\n   243\t"]
[3695.961113, "o", "\t\t\tif dfs(e.ID) {\r\n   244\t\t\t\t\treturn cycle\r\n   245\t\t\t\t}\r\n   246\t\t\t}\r\n   247\t\t}\r\n   248\t\treturn nil\r\n"]
