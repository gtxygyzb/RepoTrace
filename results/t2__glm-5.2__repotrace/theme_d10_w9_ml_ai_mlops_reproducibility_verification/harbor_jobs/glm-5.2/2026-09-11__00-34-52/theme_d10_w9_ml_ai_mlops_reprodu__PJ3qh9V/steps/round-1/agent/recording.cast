[5588.62313, "o", "package report\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"repro-verify/internal/compare\"\r\n\t\"repro-verify/internal/lineage\"\r\n"]
[5588.623207, "o", "\t\"repro-verify/internal/manifest\"\r\n\t\"repro-verify/internal/mlck\"\r\n)\r\n\r\ntype ManifestPart struct {\r\n\tValid    bool     `json:\"valid\"`\r\n\tWarnings []string `json:\"warnings,omitempty\"`\r\n\tErrors   []string `json:\"errors,omitempty\"`\r\n}\r\n\r\ntype CheckpointPart struct {\r\n\tValid        bool   `json:\"valid\"`\r\n\tNumTensors   int    `json:\"num_tensors\"`\r\n\tFileChecksum string `json:\"file_checksum\"`\r\n\tError        string `json:\"error,omitempty\"`\r\n"]
[5588.623284, "o", "}\r\n\r\ntype ComparisonPart struct {\r\n\tMatch   bool   `json:\"match\"`\r\n"]
[5588.62335, "o", "\tSummary string `json:\"summary,omitempty\"`\r\n\tError   string `json:\"error,omitempty\"`\r\n}\r\n\r\ntype LineagePart struct {\r\n\tValid  bool     `json:\"valid\"`\r\n\tDepth  int      `json:\"depth\"`\r\n\tErrors []string `json:\"errors,omitempty\"`\r\n}\r\n\r\ntype Report struct {\r\n\tReportVersion       string          `json:\"report_version\"`\r\n\tTimestamp           string          `json:\"timestamp\"`\r\n\tManifest            ManifestPart    `json:\"manifest\"`\r\n\tCheckpoint          *CheckpointPart `json:\"checkpoint,omitempty\"`\r\n\tComparison          *ComparisonPart `json:\"comparison,omitempty\"`\r\n\tLineage             *LineagePart    `json:\"lineage,omitempty\"`\r\n\tOverallReproducible bool            `json:\"overall_reproducible\"`\r\n"]
[5588.623412, "o", "\tIssues              []string        `json:\"issues\"`\r\n}\r\n\r\nfunc Generate(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {\r\n\tissues := []string{}\r\n\trep := &Report{\r\n\t\tReportVersion: \"1.0\",\r\n\t\tTimestamp:     time.Now().Format(time.RFC3339),\r\n\t\tIssues:        issues,\r\n\t}\r\n"]
[5588.623472, "o", "\r\n\tman := manifest.Validate(manifestPath)\r\n\trep.Manifest = ManifestPart{\r\n\t\tValid:    man.Valid,\r\n\t\tWarnings: man.Warnings,\r\n\t\tErrors:   man.Errors,\r\n\t}\r\n\tif !man.Valid {\r\n\t"]
[5588.623533, "o", "\tissues = append(issues, fmt.Sprintf(\"Manifest validation failed: %s\", strings.Join(man.Errors, \"; \")))\r\n\t}\r\n\r\n\tcheckpointValid := true\r\n\tif checkpointPath != \"\" {\r\n\t\tcp, err := mlck.ParseFile(checkpointPath)\r\n\t\tif err != nil {\r\n\t\t\tcheckpointValid = false\r\n\t\t\trep.Checkpoint = &CheckpointPart{\r\n"]
[5588.62359, "o", "\t\t\t\tValid: false,\r\n\t\t\t\tError: err.Error(),\r\n\t\t\t}\r\n\t\t\tissues = append(issues, fmt.Sprintf(\"Checkpoint verification failed: %v\", err))\r\n\t\t} else {\r\n\t\t\trep.Checkpoint = &CheckpointPart{\r\n\t\t\t\tValid:        true,\r\n"]
[5588.623648, "o", "\t\t\t\tNumTensors:   len(cp.Tensors),\r\n\t\t\t\tFileChecksum: cp.FileChecksum,\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tcomparisonMatch := true\r\n\tif checkpointPath != \"\" && comparePath != \"\" {\r\n\t\tc1, err := mlck.ParseFile(checkpointPath)\r\n\t\tif err != nil {\r\n"]
[5588.623704, "o", "\t\t\tcomparisonMatch = false\r\n\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\tMatch: false,\r\n\t\t\t\tError: fmt.Sprintf(\"checkpoint parse failed: %v\", err),\r\n\t\t\t}\r\n\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\t\t} else {\r\n\t\t\tc2, err := mlck.ParseFile(comparePath)\r\n"]
[5588.623773, "o", "\t\t\tif err != nil {\r\n\t\t\t\tcomparisonMatch = false\r\n\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\t\tMatch: false,\r\n\t\t\t\t\t"]
[5588.623837, "o", "Error: fmt.Sprintf(\"compare checkpoint parse failed: %v\", err),\r\n\t\t\t\t}\r\n\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\t\t\t} else {\r\n\t\t\t\tres, err := compare.Compare(c1, c2, \"strict\", 1e-7, 1e-5, false)\r\n\t\t\t\tif err != nil {\r\n\t\t\t\t\tcomparisonMatch = false\r\n\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\t\t\tMatch: false,\r\n\t\t\t\t\t\tError: err.Error(),\r\n\t\t\t\t\t}\r\n\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n"]
[5588.623894, "o", "\t\t\t\t} else {\r\n\t\t\t\t\tdiffer := 0\r\n\t\t\t\t\ttotal := len(res.TensorResults)\r\n\t\t\t\t\tfor _, tr := range res.TensorResults {\r\n\t\t\t\t\t\tif !tr.Match {\r\n\t\t\t\t\t\t\tdiffer++\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n"]
[5588.623953, "o", "\t\t\t\t\tmissing := len(res.MissingInFile1) + len(res.MissingInFile2)\r\n\t\t\t\t\tsummary := fmt.Sprintf(\"%d/%d tensors differ\", differ, total)\r\n\t\t\t\t\tif missing > 0 {\r\n\t\t\t\t\t\tsummary = fmt.Sprintf(\"%s, %d tensors missing\", summary, missing)\r\n\t\t\t\t\t}\r\n\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t"]
[5588.624013, "o", "\t\t\t\t\tMatch:   res.Match,\r\n\t\t\t\t\t\tSummary: summary,\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif !res.Match {\r\n\t\t\t\t\t\tcomparisonMatch = false\r\n\t\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Tensor comparison failed: %s\", summary))\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n"]
[5588.624074, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tlineageValid := true\r\n\tif lineagePath != \"\" {\r\n\t\tlin := lineage.Audit(lineagePath)\r\n\t\tif lin.Valid {\r\n\t\t\trep.Lineage = &LineagePart{\r\n\t\t\t\tValid: true,\r\n"]
[5588.624135, "o", "\t\t\t\tDepth: lin.MaxDepth,\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t\tlineageValid = false\r\n\t\t\trep.Lineage = &LineagePart{\r\n\t\t\t\tValid:  false,\r\n\t\t\t\tErrors: lin.Errors,\r\n\t\t\t}\r\n\t\t\t"]
[5588.624195, "o", "issues = append(issues, fmt.Sprintf(\"Lineage audit failed: %s\", strings.Join(lin.Errors, \"; \")))\r\n\t\t}\r\n\t}\r\n\r\n\toverall := man.Valid && checkpointValid && comparisonMatch && lineageValid\r\n\trep.OverallReproducible = overall\r\n\trep.Issues = issues\r\n\r\n\tif overall {\r\n\t\treturn rep, 0\r\n\t}\r\n"]
[5588.624268, "o", "\treturn rep, 1\r\n}\r\n"]
[5588.624701, "o", "\u001b[?2004h"]
[5588.624758, "o", "root@n30009:/app# "]
[5596.776562, "i", "nl -ba internal/lineage/lineage.go | sed -n '1,90p'\n"]
[5596.776977, "o", "nl -ba internal/lineage/lineage.go | sed -n '1,90p'\r\n\u001b[?2004l\r"]
[5596.780753, "o", "     1\tpackage lineage\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n"]
[5596.780854, "o", "     6\t\t\"os\"\r\n     7\t\t\"strings\"\r\n     8\t\t\"time\"\r\n     9\t)\r\n    10\t\r\n    11\ttype Experiment struct {\r\n    12\t\tID             string   `json:\"id\"`\r\n    13\t\tName           string   `json:\"name\"`\r\n    14\t\tParents        []string `json:\"parents\"`\r\n    15\t\tCheckpointHash string   `json:\"checkpoint_hash\"`\r\n    16\t\tTimestamp      string   `json:\"timestamp\"`\r\n    17\t}\r\n    18\t\r\n    19\ttype Input struct {\r\n    20\t\tExperiments []Experiment `json:\"experiments\"`\r\n    21\t}\r\n    22\t\r\n    23\ttype Result struct {\r\n    24\t\tValid            bool     `json:\"valid\"`\r\n    25\t\tNumExperiments   int      `json:\"num_experiments\"`\r\n"]
[5596.780942, "o", "    26\t\tNumRoots         int      `json:\"num_roots\"`\r\n    27\t\tNumLeaves        int      `json:\"num_leaves\"`\r\n    28\t\tMaxDepth         int      `json:\"max_depth\"`\r\n    29\t\tTopologicalOrder []string `json:\"topological_order\"`\r\n    30\t\tErrors           []string `json:\"errors,omitempty\"`\r\n    31\t}\r\n    32\t\r\n    33\tfunc Audit(path string) *Result {\r\n    34\t\tdata, err := os.ReadFile(path)\r\n    35\t\tif err != nil {\r\n    36\t\t\treturn &Result{\r\n"]
[5596.780988, "o", "    37\t\t\t\tValid:  false,\r\n    38\t\t\t\tErrors: []string{fmt.Sprintf(\"failed to read lineage file: %v\", err)},\r\n    39\t\t\t}\r\n    40\t\t}\r\n"]
[5596.781086, "o", "    41\t\r\n    42\t\tvar in Input\r\n    43\t\tif err := json.Unmarshal(data, &in); err != nil {\r\n    44\t\t\treturn &Result{\r\n    45\t\t\t\tValid:  false,\r\n"]
[5596.781163, "o", "    46\t\t\t\tErrors: []string{fmt.Sprintf(\"failed to parse lineage JSON: %v\", err)},\r\n    47\t\t\t}\r\n    48\t\t}\r\n    49\t\r\n    50\t\texps := in.Experiments\r\n    51\t\tresult := &Result{\r\n    52\t\t\tValid:            true,\r\n    53\t\t\tErrors:           []string{},\r\n    54\t\t\tTopologicalOrder: []string{},\r\n    55\t\t}\r\n    56\t\r\n    57\t\tif len(exps) == 0 {\r\n    58\t\t\tresult.TopologicalOrder = []string{}\r\n    59\t\t\t"]
[5596.781266, "o", "return result\r\n    60\t\t}\r\n    61\t\r\n    62\t\tidSet := make(map[string]int)\r\n    63\t\tids := make([]string, 0, len(exps))\r\n    64\t\tfor i, e := range exps {\r\n    65\t\t\tif e.ID == \"\" {\r\n    66\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"experiment at index %d missing id\", i))\r\n    67\t\t\t\tcontinue\r\n    68\t\t\t}\r\n    69\t\t\tif _, ok := idSet[e.ID]; ok {\r\n    70\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"duplicate id: %s\", e.ID))\r\n    71\t\t\t} else {\r\n"]
