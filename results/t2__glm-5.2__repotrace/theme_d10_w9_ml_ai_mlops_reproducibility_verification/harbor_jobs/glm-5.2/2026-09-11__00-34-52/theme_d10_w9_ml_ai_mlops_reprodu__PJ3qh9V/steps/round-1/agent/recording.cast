[3678.861137, "o", "     1\tpackage lineage\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"strings\"\r\n     8\t\t\"time\"\r\n     9\t)\r\n    10\t\r\n"]
[3678.861307, "o", "    11\ttype Experiment struct {\r\n    12\t\tID             string   `json:\"id\"`\r\n    13\t\tName           string   `json:\"name\"`\r\n    14\t\tParents        []string `json:\"parents\"`\r\n    15\t\tCheckpointHash string   `json:\"checkpoint_hash\"`\r\n    16\t\tTimestamp      string   `json:\"timestamp\"`\r\n    17\t}\r\n    18\t\r\n    19\ttype Input struct {\r\n    20\t\tExperiments []Experiment `json:\"experiments\"`\r\n    21\t}\r\n    22\t\r\n    23\ttype Result struct {\r\n    24\t\tValid            bool     `json:\"valid\"`\r\n    25\t\tNumExperiments   int      `json:\"num_experiments\"`\r\n    26\t\tNumRoots         int      `json:\"num_roots\"`\r\n    27\t\tNumLeaves        int      `json:\"num_leaves\"`\r\n    28\t\tMaxDepth         int      `json:\"max_depth\"`\r\n    29\t\tTopologicalOrder []string `json:\"topological_order\"`\r\n    30\t\tErrors           []string `json:\"errors,omitempty\"`\r\n    31\t}\r\n    32\t\r\n    33\tfunc Audit(path string) *Result {\r\n    34\t\tdata, err := os.ReadFile(path)\r\n"]
[3678.8614, "o", "    35\t\tif err != nil {\r\n    36\t\t\treturn &Result{\r\n    37\t\t\t\tValid:  false,\r\n    38\t\t\t\tErrors: []string{fmt.Sprintf(\"failed to read lineage file: %v\", err)},\r\n    39\t\t\t}\r\n    40\t\t}\r\n    41\t\r\n    42\t"]
[3678.861468, "o", "\tvar in Input\r\n    43\t\tif err := json.Unmarshal(data, &in); err != nil {\r\n    44\t\t\treturn &Result{\r\n    45\t\t\t\tValid:  false,\r\n    46\t\t\t\tErrors: []string{fmt.Sprintf(\"failed to parse lineage JSON: %v\", err)},\r\n    47\t\t\t}\r\n    48\t\t}\r\n    49\t\r\n    50\t\texps := in.Experiments\r\n    51\t\tresult := &Result{\r\n    52\t\t\tValid:            true,\r\n    53\t\t\tErrors:           []string{},\r\n    54\t\t\tTopologicalOrder: []string{},\r\n    55\t\t}\r\n"]
[3678.861533, "o", "    56\t\r\n    57\t\tif len(exps) == 0 {\r\n    58\t\t\tresult.TopologicalOrder = []string{}\r\n    59\t\t\treturn result\r\n    60\t\t}\r\n    61\t\r\n    62\t\tidSet := make(map[string]int)\r\n    63\t\tids := make([]string, 0, len(exps))\r\n    64\t\tfor i, e := range exps {\r\n    65\t\t\tif e.ID == \"\" {\r\n    66\t"]
[3678.861595, "o", "\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"experiment at index %d missing id\", i))\r\n    67\t\t\t\tcontinue\r\n    68\t\t\t}\r\n    69\t\t\tif _, ok := idSet[e.ID]; ok {\r\n    70\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"duplicate id: %s\", e.ID))\r\n    71\t\t\t} else {\r\n    72\t\t\t\tidSet[e.ID] = i\r\n    73\t\t\t\tids = append(ids, e.ID)\r\n"]
[3678.861663, "o", "    74\t\t\t}\r\n    75\t\t\tif e.CheckpointHash == \"\" {\r\n    76\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"empty checkpoint_hash for experiment: %s\", e.ID))\r\n    77\t\t\t}\r\n    78\t\t}\r\n"]
[3678.861727, "o", "    79\t\r\n    80\t\tfor _, e := range exps {\r\n    81\t\t\tif e.ID == \"\" {\r\n    82\t\t\t\tcontinue\r\n    83\t\t\t}\r\n    84\t\t\tfor _, p := range e.Parents {\r\n    85\t\t\t\tif _, ok := idSet[p]; !ok {\r\n    86\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"parent reference unresolved: %s -> %s\", e.ID, p))\r\n    87\t\t\t\t}\r\n    88\t\t\t}\r\n    89\t\t}\r\n    90\t\r\n    91\t\ttimes := make(map[string]time.Time)\r\n    92"]
[3678.861789, "o", "\t\tfor _, e := range exps {\r\n    93\t\t\tif e.ID == \"\" {\r\n    94\t\t\t\tcontinue\r\n    95\t\t\t}\r\n    96\t\t\tif e.Timestamp == \"\" {\r\n    97\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"missing timestamp for experiment: %s\", e.ID))\r\n    98\t\t\t\tcontinue\r\n    99\t\t\t}\r\n   100\t\t\tt, err := time.Parse(time.RFC3339, e.Timestamp)\r\n   101\t"]
[3678.861857, "o", "\t\tif err != nil {\r\n   102\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"invalid timestamp for experiment: %s\", e.ID))\r\n   103\t\t\t} else {\r\n   104\t\t\t\ttimes[e.ID] = t\r\n   105\t\t\t}\r\n   106\t\t}\r\n"]
[3678.861921, "o", "   107\t\r\n   108\t\tif len(result.Errors) == 0 {\r\n   109\t\t\tif cycle := detectCycle(exps); cycle != nil {\r\n   110\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"cycle detected involving: %s\", strings.Join(cycle, \", \")))\r\n   111\t\t\t}\r\n   112\t\t}\r\n   113\t\r\n   114\t\tif len(result.Errors) == 0 {\r\n   115\t\t\tfor _, e := range exps {\r\n   116\t\t\t\tchildTime, ok := times[e.ID]\r\n   117\t\t\t\tif !ok {\r\n   118\t\t\t\t\tcontinue\r\n"]
[3678.861987, "o", "   119\t\t\t\t}\r\n   120\t\t\t\tfor _, p := range e.Parents {\r\n   121\t\t\t\t\tparentTime, ok := times[p]\r\n   122\t\t\t\t\tif !ok {\r\n   123\t\t\t\t\t\tcontinue\r\n   124\t\t\t\t\t}\r\n   125\t\t\t\t\tif !childTime.After(parentTime) {\r\n"]
[3678.86205, "o", "   126\t\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"timestamp violation: %s (%s) has parent %s (%s)\", e.ID, childTime.Format(\"2006-01-02\"), p, parentTime.Format(\"2006-01-02\")))\r\n   127\t\t\t\t\t}\r\n   128\t\t\t\t}\r\n   129\t\t\t}\r\n   130\t\t}\r\n   131\t\r\n   132\t\tif len(result.Errors) > 0 {\r\n   133\t\t\tresult.Valid = false\r\n   134\t\t\tresult.TopologicalOrder = nil\r\n   135\t\t\treturn result\r\n   136\t\t"]
[3678.862107, "o", "}\r\n   137\t\r\n   138\t\tchildren := make(map[string][]string)\r\n   139\t\tfor _, e := range exps {\r\n   140\t\t\tfor _, p := range e.Parents {\r\n   141\t\t\t\tchildren[p] = append(children[p], e.ID)\r\n   142\t\t\t}\r\n   143\t\t}\r\n   144\t"]
[3678.862171, "o", "\r\n   145\t\troots := make([]string, 0)\r\n   146\t\tleaves := make([]string, 0)\r\n   147\t\tfor _, e := range exps {\r\n   148\t\t\tif len(e.Parents) == 0 {\r\n   149\t\t\t"]
[3678.862273, "o", "\troots = append(roots, e.ID)\r\n   150\t\t\t}\r\n   151\t\t\tif len(children[e.ID]) == 0 {\r\n   152\t\t\t\tleaves = append(leaves, e.ID)\r\n   153\t\t\t}\r\n   154\t\t}\r\n   155\t\r\n   156\t\tvisited := make(map[string]bool)\r\n   157\t\t"]
[3678.86234, "o", "var post []string\r\n   158\t\tvar dfs func(id string)\r\n   159\t\tdfs = func(id string) {\r\n   160\t\t\tvisited[id] = true\r\n   161\t\t\tfor _, child := range children[id] {\r\n   162\t\t\t\tif !visited[child] {\r\n   163\t\t\t\t\tdfs(child)\r\n   164\t\t\t\t}\r\n   165\t\t\t}\r\n   166\t\t\tpost = append(post, id)\r\n   167\t\t}\r\n   168\t\tfor _, e := range exps {\r\n   169\t\t\tif !visited[e.ID] {\r\n   170\t\t\t\tdfs(e.ID)\r\n   171\t\t\t}\r\n   172\t\t}\r\n   173\t\ttopo := make([]string, len(post))\r\n   174\t\t"]
[3678.862404, "o", "for i := range post {\r\n   175\t\t\ttopo[i] = post[len(post)-1-i]\r\n   176\t\t}\r\n   177\t\r\n   178\t\tmaxDepth := 0\r\n"]
[3678.862467, "o", "   179\t\tvar depthDFS func(id string, depth int)\r\n   180\t\tdepthDFS = func(id string, depth int) {\r\n   181\t\t\tif depth > maxDepth {\r\n   182\t\t\t\tmaxDepth = depth\r\n   183\t\t\t}\r\n   184\t\t\tfor _, child := range children[id] {\r\n   185\t\t\t\tdepthDFS(child, depth+1)\r\n   186\t\t\t}\r\n   187\t\t}\r\n   188\t\tfor _, r := range roots {\r\n   189\t\t\tdepthDFS(r, 1)\r\n   190\t\t}\r\n   191"]
[3678.862524, "o", "\t\r\n   192\t\tresult.NumExperiments = len(exps)\r\n   193\t\tresult.NumRoots = len(roots)\r\n   194\t\tresult.NumLeaves = len(leaves)\r\n   195\t\tresult.MaxDepth = maxDepth\r\n   196\t\tresult.TopologicalOrder = topo\r\n   197\t\treturn result\r\n   198\t}\r\n   199\t"]
[3678.862585, "o", "\r\n   200\tfunc detectCycle(exps []Experiment) []string {\r\n   201\t\tadj := make(map[string][]string)\r\n   202\t\tfor _, e := range exps {\r\n   203\t\t\tfor _, p := range e.Parents {\r\n   204\t\t\t\tadj[p] = append(adj[p], e.ID)\r\n   205\t\t\t}\r\n   206\t\t}\r\n   207\t\r\n"]
[3678.862645, "o", "   208\t\tstate := make(map[string]int)\r\n   209\t\tvar stack []string\r\n   210\t\tvar cycle []string\r\n   211\t\r\n   212\t\tvar dfs func(id string) bool\r\n   213\t\tdfs = func(id string) bool {\r\n   214\t\t\tstate[id] = 1\r\n   215\t\t\tstack = append(stack, id)\r\n"]
[3678.862701, "o", "   216\t\t\tfor _, child := range adj[id] {\r\n   217\t\t\t\tif state[child] == 1 {\r\n   218\t\t\t\t\tidx := -1\r\n   219\t\t\t\t\tfor i := len(stack) - 1; i >= 0; i-- {\r\n   220\t\t\t\t\t\tif stack[i] == child {\r\n   221\t\t\t\t\t\t\tidx = i\r\n   222\t\t\t\t\t\t\tbreak\r\n   223\t\t\t\t\t\t}\r\n   224\t\t\t\t\t}\r\n"]
[3678.862764, "o", "   225\t\t\t\t\tif idx >= 0 {\r\n   226\t\t\t\t\t\tcycle = append([]string{}, stack[idx:]...)\r\n   227\t\t\t\t\t\treturn true\r\n   228\t\t\t\t\t}\r\n   229\t\t\t\t}\r\n   230\t\t\t\tif state[child] == 0 {\r\n"]
[3678.862823, "o", "   231\t\t\t\t\tif dfs(child) {\r\n   232\t\t\t\t\t\treturn true\r\n   233\t\t\t\t\t}\r\n   234\t\t\t\t}\r\n   235\t\t\t}\r\n   236\t\t\tstack = stack[:len(stack)-1]\r\n   237\t\t"]
[3678.862885, "o", "\tstate[id] = 2\r\n   238\t\t\treturn false\r\n   239\t\t}\r\n   240\t\r\n   241\t\tfor _, e := range exps {\r\n   242\t\t\tif state[e.ID] == 0 {\r\n   243\t\t\t\tif dfs(e.ID) {\r\n   244\t\t\t\t\treturn cycle\r\n"]
[3678.86294, "o", "   245\t\t\t\t}\r\n   246\t\t\t}\r\n   247\t\t}\r\n   248\t\treturn nil\r\n   249\t}\r\n"]
