[5447.909558, "o", "sed -n '231,345p' internal/mlck/checkpoint.go\r\n\u001b[?2004l\r"]
[5447.91246, "o", "func Build(metadata map[string]interface{}, tensors []Tensor) ([]byte, error) {\r\n\tmetaRaw, err := json.Marshal(metadata)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"failed to marshal metadata: %v\", err)\r\n\t}\r\n"]
[5447.912502, "o", "\r\n\tvar buf bytes.Buffer\r\n\theader := make([]byte, HeaderSize)\r\n\tcopy(header[0:4], Magic)\r\n\tbinary.LittleEndian.PutUint32(header[4:8], Version)\r\n\tbinary.LittleEndian.PutUint32(header[8:12], uint32(len(tensors)))\r\n\tbinary.LittleEndian.PutUint32(header[12:16], uint32(len(metaRaw)))\r\n\tbuf.Write(header)\r\n"]
[5447.912729, "o", "\tbuf.Write(metaRaw)\r\n\r\n\tfor _, t := range tensors {\r\n\t\tnameBytes := []byte(t.Name)\r\n\t\tif err := binary.Write(&buf, binary.LittleEndian, uint32(len(nameBytes))); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(nameBytes)\r\n\t\tbuf.WriteByte(t.Dtype)\r\n\t\tif err := binary.Write(&buf, binary.LittleEndian, uint32(len(t.Shape))); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tfor _, s := range t.Shape {\r\n\t\t\tif err := binary.Write(&buf, binary.LittleEndian, s); err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t}\r\n\t\texpected := Product(t.Shape) * int64(DtypeSize(t.Dtype))\r\n\t\tif int64(len(t.Data)) != expected {\r\n\t\t\treturn nil, fmt.Errorf(\"tensor %s data length %d does not match shape %v and dtype %s\", t.Name, len(t.Data), t.Shape, DtypeName(t.Dtype))\r\n\t\t}\r\n\t\tbuf.Write(t.Data)\r\n\t}\r\n\r\n\tsum := sha256.Sum256(buf.Bytes())\r\n\tbuf.Write(sum[:])\r\n\treturn buf.Bytes(), nil\r\n}\r\n\r\nfunc WriteFile(path string, metadata map[string]interface{}, tensors []Tensor) error {\r\n\tdata, err := Build(metadata, tensors)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tr"]
[5447.912818, "o", "eturn os.WriteFile(path, data, 0644)\r\n}\r\n\r\nfunc (t Tensor) Float64Values() ([]float64, error) {\r\n\tsize := DtypeSize(t.Dtype)\r\n\tif size == 0 {\r\n\t\treturn nil, fmt.Errorf(\"invalid dtype %d\", t.Dtype)\r\n\t}\r\n\tn := len(t.Data) / size\r\n\tif len(t.Data)%size != 0 {\r\n\t\treturn nil, fmt.Errorf(\"tensor %s data length not multiple of dtype size\", t.Name)\r\n\t}\r\n\tvals := make([]float64, n)\r\n\tfor i := 0; i < n; i++ {\r\n\t\tstart := i * size\r\n\t\tswitch Dtype(t.Dtype) {\r\n\t\tcase Float32:\r\n\t\t\tbits := binary.LittleEndian.Uint32(t.Data[start : start+4])\r\n\t\t\tvals[i] = float64(math.Float32frombits(bits))\r\n\t\tcase Float64:\r\n\t\t\t"]
[5447.912895, "o", "bits := binary.LittleEndian.Uint64(t.Data[start : start+8])\r\n\t\t\tvals[i] = math.Float64frombits(bits)\r\n\t\tcase Int32:\r\n\t\t\tvals[i] = float64(int32(binary.LittleEndian.Uint32(t.Data[start : start+4])))\r\n\t\tcase Int64:\r\n\t\t\tvals[i] = float64(int64(binary.LittleEndian.Uint64(t.Data[start : start+8])))\r\n\t\tdefault:\r\n\t\t\treturn nil, fmt.Errorf(\"invalid dtype %d\", t.Dtype)\r\n\t\t}\r\n\t}\r\n\t"]
[5447.912958, "o", "return vals, nil\r\n}\r\n\r\nfunc EncodeFloat64Values(vals []float64, dtype uint8) ([]byte, error) {\r\n\tvar buf bytes.Buffer\r\n\tswitch Dtype(dtype) {\r\n\tcase Float32:\r\n\t\tfor _, v := range vals {\r\n\t\t\tif err := binary.Write(&buf, binary.LittleEndian, math.Float32bits(float32(v))); err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t}\r\n\tcase Float64:\r\n\t\t"]
[5447.913017, "o", "for _, v := range vals {\r\n\t\t\tif err := binary.Write(&buf, binary.LittleEndian, math.Float64bits(v)); err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t}\r\n\tcase Int32:\r\n\t\tfor _, v := range vals {\r\n\t\t\tif err := binary.Write(&buf, binary.LittleEndian, int32(math.Round(v))); err != nil {\r\n\t\t\t\treturn nil, err\r\n"]
[5447.913082, "o", "\t\t\t}\r\n\t\t}\r\n\tcase Int64:\r\n\t\tfor _, v := range vals {\r\n\t\t\tif err := binary.Write(&buf, binary.LittleEndian, int64(math.Round(v))); err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t}\r\n\tdefault:\r\n\t\t"]
[5447.913141, "o", "return nil, fmt.Errorf(\"invalid dtype %d\", dtype)\r\n\t}\r\n\treturn buf.Bytes(), nil\r\n}\r\n\r\nfunc PromoteDtype(a, b uint8) (uint8, error) {\r\n\tif a == b {\r\n"]
