[1227.99075, "o", "> "]
[1227.990939, "o", "func parseTOMLValue(s string) (interface{}, error) {\r\n\u001b[?2004l\r"]
[1227.990994, "o", "\u001b[?2004h> "]
[1227.99107, "o", "    if s == \"true\" {\r\n\u001b[?2004l\r"]
[1227.991125, "o", "\u001b[?2004h> "]
[1227.991216, "o", "        return true, nil\r\n\u001b[?2004l\r"]
[1227.991279, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1227.991334, "o", "\u001b[?2004h> "]
[1227.991423, "o", "    if s == \"false\" {\r\n\u001b[?2004l\r"]
[1227.991478, "o", "\u001b[?2004h> "]
[1227.991571, "o", "        return false, nil\r\n\u001b[?2004l\r"]
[1227.991631, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1227.991686, "o", "\u001b[?2004h> "]
[1227.992085, "o", "    if len(s) >= 2 && (s[0] == '\"' && s[len(s)-1] == '\"' || s[0] == '\\'' && s[len(s)-1] == '\\'') {\r\n\u001b[?2004l\r"]
[1227.992141, "o", "\u001b[?2004h> "]
[1227.992282, "o", "        return s[1 : len(s)-1], nil\r\n\u001b[?2004l\r"]
[1227.992337, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1227.992384, "o", "\u001b[?2004h> "]
[1227.992656, "o", "    if strings.HasPrefix(s, \"[\") && strings.HasSuffix(s, \"]\")) {\r\n\u001b[?2004l\r"]
[1227.992711, "o", "\u001b[?2004h> "]
[1227.992911, "o", "        inner := strings.TrimSpace(s[1 : len(s)-1])\r\n\u001b[?2004l\r"]
[1227.992967, "o", "\u001b[?2004h> "]
[1227.993055, "o", "        if inner == \"\" {\r\n\u001b[?2004l\r"]
[1227.99311, "o", "\u001b[?2004h> "]
[1227.99326, "o", "            return []interface{}{}, nil\r\n\u001b[?2004l\r"]
[1227.993317, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1227.993373, "o", "\u001b[?2004h> "]
[1227.993468, "o", "        parts := splitArrayElements(inner)\r\n\u001b[?2004l\r"]
[1227.993523, "o", "\u001b[?2004h> "]
[1227.993639, "o", "        arr := make([]interface{}, 0, len(parts))\r\n\u001b[?2004l\r"]
[1227.993692, "o", "\u001b[?2004h> "]
[1227.993765, "o", "        for _, p := range parts {\r\n\u001b[?2004l\r"]
[1227.993819, "o", "\u001b[?2004h> "]
[1227.99396, "o", "            v, err := parseTOMLValue(strings.TrimSpace(p))\r\n\u001b[?2004l\r"]
[1227.994014, "o", "\u001b[?2004h> "]
[1227.99407, "o", "            if err != nil {\r\n\u001b[?2004l\r"]
[1227.994129, "o", "\u001b[?2004h> "]
[1227.99419, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[1227.994253, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[1227.994315, "o", "\u001b[?2004h> "]
[1227.99439, "o", "            arr = append(arr, v)\r\n\u001b[?2004l\r"]
[1227.994444, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1227.994499, "o", "\u001b[?2004h> "]
[1227.994562, "o", "        return arr, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.994621, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.994806, "o", "    if strings.HasPrefix(s, \"{\") && strings.HasSuffix(s, \"}\") {\r\n\u001b[?2004l\r"]
[1227.99486, "o", "\u001b[?2004h> "]
[1227.994981, "o", "        inner := strings.TrimSpace(s[1 : len(s)-1])\r\n\u001b[?2004l\r"]
[1227.995036, "o", "\u001b[?2004h> "]
[1227.995118, "o", "        m := map[string]interface{}{}\r\n\u001b[?2004l\r"]
[1227.995173, "o", "\u001b[?2004h> "]
[1227.995238, "o", "        if inner == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.995326, "o", "            return m, nil\r\n\u001b[?2004l\r"]
[1227.995382, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1227.995439, "o", "\u001b[?2004h> "]
[1227.995538, "o", "        parts := splitArrayElements(inner)\r\n\u001b[?2004l\r"]
[1227.995593, "o", "\u001b[?2004h> "]
[1227.995663, "o", "        for _, p := range parts {\r\n\u001b[?2004l\r"]
[1227.995722, "o", "\u001b[?2004h> "]
[1227.995816, "o", "            kv := strings.SplitN(p, \"=\", 2)\r\n\u001b[?2004l\r"]
[1227.99587, "o", "\u001b[?2004h> "]
[1227.995931, "o", "            if len(kv) != 2 {\r\n\u001b[?2004l\r"]
[1227.995985, "o", "\u001b[?2004h> "]
[1227.996173, "o", "                return nil, fmt.Errorf(\"invalid inline table entry: %s\", p)\r\n\u001b[?2004l\r"]
[1227.996234, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[1227.996292, "o", "\u001b[?2004h> "]
[1227.996398, "o", "            k := strings.TrimSpace(kv[0])\r\n\u001b[?2004l\r"]
[1227.996453, "o", "\u001b[?2004h> "]
[1227.996605, "o", "            v, err := parseTOMLValue(strings.TrimSpace(kv[1]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1227.996659, "o", "> "]
[1227.996711, "o", "            if err != nil {\r\n\u001b[?2004l\r"]
[1227.996767, "o", "\u001b[?2004h> "]
[1227.996833, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[1227.996892, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[1227.996949, "o", "\u001b[?2004h> "]
[1227.997013, "o", "            m[k] = v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.997069, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.997145, "o", "        return m, nil\r\n\u001b[?2004l\r"]
[1227.9972, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1227.997261, "o", "> "]
[1227.997398, "o", "    if i, err := strconv.ParseInt(s, 10, 64); err == nil {\r\n\u001b[?2004l\r"]
[1227.997452, "o", "\u001b[?2004h> "]
[1227.997505, "o", "        return i, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.997559, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.997729, "o", "    if f, err := strconv.ParseFloat(s, 64); err == nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1227.997784, "o", "> "]
[1227.997851, "o", "        return f, nil\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1227.997906, "o", "\u001b[?2004h> "]
[1227.998039, "o", "    return nil, fmt.Errorf(\"invalid value: %s\", s)\r\n\u001b[?2004l\r"]
[1227.998094, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1227.99816, "o", "\u001b[?2004h> "]
[1227.998272, "o", "func splitArrayElements(s string) []string {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1227.998333, "o", "> "]
[1227.998391, "o", "    var parts []string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.998457, "o", "    depth := 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.998528, "o", "    quote := byte(0)\r\n\u001b[?2004l\r"]
[1227.998583, "o", "\u001b[?2004h> "]
[1227.998638, "o", "    start := 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.99873, "o", "    for i := 0; i < len(s); i++ {\r\n\u001b[?2004l\r"]
[1227.998785, "o", "\u001b[?2004h> "]
[1227.998844, "o", "        c := s[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.998907, "o", "        if quote != 0 {\r\n\u001b[?2004l\r"]
[1227.99896, "o", "\u001b[?2004h> "]
[1227.999017, "o", "            if c == quote {\r\n\u001b[?2004l\r"]
[1227.999077, "o", "\u001b[?2004h> "]
[1227.999138, "o", "                quote = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.999192, "o", "            }\r\n\u001b[?2004l\r"]
[1227.999256, "o", "\u001b[?2004h> "]
[1227.999312, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.999367, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.999476, "o", "        if c == '\"' || c == '\\'' {\r\n\u001b[?2004l\r"]
[1227.999531, "o", "\u001b[?2004h> "]
[1227.999586, "o", "            quote = c\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1227.999661, "o", "            continue\r\n\u001b[?2004l\r"]
[1227.999717, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1227.999772, "o", "\u001b[?2004h> "]
[1227.999845, "o", "        if c == '[' || c == '{' {\r\n\u001b[?2004l\r"]
[1227.9999, "o", "\u001b[?2004h> "]
[1227.999959, "o", "            depth++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.000078, "o", "        } else if c == ']' || c == '}' {\r\n\u001b[?2004l\r"]
[1228.000132, "o", "\u001b[?2004h> "]
[1228.000192, "o", "            depth--\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.000322, "o", "        } else if c == ',' && depth == 0 {\r\n\u001b[?2004l\r"]
[1228.000376, "o", "\u001b[?2004h> "]
[1228.000493, "o", "            parts = append(parts, s[start:i])\r\n\u001b[?2004l\r"]
[1228.000548, "o", "\u001b[?2004h> "]
[1228.00061, "o", "            start = i + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.000665, "o", ">         }\r\n\u001b[?2004l\r"]
[1228.000721, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.000777, "o", "> "]
[1228.000853, "o", "    parts = append(parts, s[start:])\r\n\u001b[?2004l\r"]
[1228.000907, "o", "\u001b[?2004h> "]
[1228.000966, "o", "    return parts\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1228.001032, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1228.00385, "o", "\u001b[?2004hroot@n30009:/app# "]
[1228.17096, "i", "cat > internal/merge/merge.go <<'EOF'\npackage merge\n\nimport (\n    \"fmt\"\n    \"path/filepath\"\n\n    \"repro-verify/internal/mlck\"\n)\n\ntype TensorSource struct {\n    Name string `json:\"name\"`\n    Sources []string `json:\"sources\"`\n    Resolution string `json:\"resolution\"`\n}\n\ntype Result struct {\n    OutputFile string `json:\"output_file\"`\n    NumInputFiles int `json:\"num_input_files\"`\n    TotalTensors int `json:\"total_tensors\"`\n    ConflictsResolved int `json:\"conflicts_resolved\"`\n    ConflictStrategy string `json:\"conflict_strategy\"`\n    TensorSources []TensorSource `json:\"tensor_sources\"`\n}\n\nfunc Merge(output string, files []string, strategy string) (*Result, error) {\n    if len(files) < 2 {\n        return nil, fmt.Errorf(\"at least 2 input files required\")\n    }\n    if strategy != \"first\" && strategy != \"last\" && strategy != \"average\" {\n        return nil, fmt.Errorf(\"invalid conflict strategy %q\", strategy)\n    }\n\n    cps := make([]*mlck.Checkpoint, len(files))\n    for i, f := range files {\n        cp, err := mlck"]
[1228.170994, "i", ".ParseFile(f)\n        if err != nil {\n            return nil, fmt.Errorf(\"file %s: %v\", f, err)\n        }\n        cps[i] = cp\n    }\n\n    metadata := map[string]interface{}{}\n    for _, cp := range cps {\n        for k, v := range cp.Metadata {\n            metadata[k] = v\n        }\n    }\n\n    type occurrence struct {\n        fileIdx int\n        tensor mlck.Tensor\n    }\n\n    var order []string\n    occurrences := map[string][]occurrence{}\n    for i, cp := range cps {\n        for _, t := range cp.Tensors {\n            if _, ok := occurrences[t.Name]; !ok {\n                order = append(order, t.Name)\n            }\n            occurrences[t.Name] = append(occurrences[t.Name], occurrence{i, t})\n        }\n    }\n\n    outTensors := make([]mlck.Tensor, 0, len(order))\n    tensorSources := make([]TensorSource, 0, len(order))\n    conflicts := 0\n\n    for _, name := range order {\n        occs := occurrences[name]\n        sources := make([]string, len(occs))\n        for i, occ := range occs {\n            sources[i] = filepat"]
[1228.17118, "i", "h.Base(files[occ.fileIdx])\n        }\n\n        resolution := \"unique\"\n        var tensor mlck.Tensor\n        if len(occs) > 1 {\n            conflicts++\n            switch strategy {\n            case \"first\":\n                tensor = occs[0].tensor\n                resolution = \"first\"\n            case \"last\":\n                tensor = occs[len(occs)-1].tensor\n                resolution = \"last\"\n            case \"average\":\n                shape := occs[0].tensor.Shape\n                for _, occ := range occs[1:] {\n                    if !shapesEqual(shape, occ.tensor.Shape) {\n                        return nil, fmt.Errorf(\"tensor %s shape mismatch for average\", name)\n                    }\n                }\n                dtype := occs[0].tensor.Dtype\n                for _, occ := range occs[1:] {\n                    promoted, err := mlck.PromoteDtype(dtype, occ.tensor.Dtype)\n                    if err != nil {\n                        return nil, err\n                    }\n                    dtype = promoted\n    "]
[1228.171277, "i", "            }\n                n := int(mlck.Product(shape))\n                sums := make([]float64, n)\n                for _, occ := range occs {\n                    vals, err := occ.tensor.Float64Values()\n                    if err != nil {\n                        return nil, err\n                    }\n                    if len(vals) != n {\n                        return nil, fmt.Errorf(\"tensor %s value count mismatch\", name)\n                    }\n                    for i := range sums {\n                        sums[i] += vals[i]\n                    }\n                }\n                avg := make([]float64, n)\n                for i := range sums {\n                    avg[i] = sums[i] / float64(len(occs))\n                }\n                data, err := mlck.EncodeFloat64Values(avg, dtype)\n                if err != nil {\n                    return nil, err\n                }\n                tensor = mlck.Tensor{\n                    Name: name,\n                    Dtype: dtype,\n                    Shape: shape,\n"]
[1228.171346, "o", "cat > internal/merge/merge.go <<'EOF'\r\n\u001b[?2004l\r"]
[1228.171413, "i", "                    Data: data,\n                }\n                resolution = \"averaged\"\n            }\n        } else {\n            tensor = occs[0].tensor\n        }\n\n        outTensors = append(outTensors, tensor)\n        tensorSources = append(tensorSources, TensorSource{\n            Name: name,\n            Sources: sources,\n            Resolution: resolution,\n        })\n    }\n\n    if err := mlck.WriteFile(output, metadata, outTensors); err != nil {\n        return nil, err\n    }\n\n    return &Result{\n        OutputFile: output,\n        NumInputFiles: len(files),\n        TotalTensors: len(outTensors),\n        ConflictsResolved: conflicts,\n        ConflictStrategy: strategy,\n        TensorSources: tensorSources,\n    }, nil\n}\n\nfunc shapesEqual(a, b []uint32) bool {\n    if len(a) != len(b) {\n        return false\n    }\n    for i := range a {\n        if a[i] != b[i] {\n            return false\n        }\n    }\n    return true\n}\nEOF\n"]
