[1375.810599, "i", "cat > /tmp/gen_fixtures.py <<'PY'\nimport struct, json, hashlib, os\n\ndef write_mlck(path, metadata, tensors):\n    meta = json.dumps(metadata).encode()\n    body = b'MLCK' + struct.pack('<III', 1, len(tensors), len(meta)) + meta\n    for name, dtype, shape, data in tensors:\n        nb = name.encode()\n        body += struct.pack('<I', len(nb)) + nb\n        body += struct.pack('<B', dtype)\n        body += struct.pack('<I', len(shape))\n        for s in shape:\n            body += struct.pack('<I', s)\n        body += data\n    footer = hashlib.sha256(body).digest()\n    with open(path, 'wb') as f:\n        f.write(body + footer)\n\ndef f32(vals):\n    return b''.join(struct.pack('<f', v) for v in vals)\ndef f64(vals):\n    return b''.join(struct.pack('<d', v) for v in vals)\n\ntensors1 = [\n    ('conv1.weight', 0, [2,2], f32([1.0,2.0,3.0,4.0])),\n    ('fc.weight', 1, [2,2], f64([1.0,2.0,3.0,4.0])),\n]\ntensors2 = [\n    ('conv1.weight', 0, [2,2], f32([1.0,2.0,3.0,4.0])),\n    ('fc.weight', 1, [2,2], f64([1.0,2.0,3.0,4.0])),\n]\ntensors"]
[1375.810905, "i", "3 = [\n    ('conv1.weight', 0, [2,2], f32([1.0,2.0,3.0,4.0])),\n    ('extra', 2, [2], struct.pack('<ii', 5,6)),\n]\nwrite_mlck('/tmp/cp1.bin', {'name':'test','framework':'pytorch','seed':42}, tensors1)\nwrite_mlck('/tmp/cp2.bin', {'name':'test','framework':'pytorch','seed':42}, tensors2)\nwrite_mlck('/tmp/cp3.bin', {'name':'test','framework':'pytorch','seed':42}, tensors3)\n\n# drift snapshots: conv1.weight changes decreasing\nwrite_mlck('/tmp/d1.bin', {'name':'drift'}, [('conv1.weight',0,[2,2], f32([0.0,0.0,0.0,0.0]))])\nwrite_mlck('/tmp/d2.bin', {'name':'drift'}, [('conv1.weight',0,[2,2], f32([0.1,0.1,0.1,0.1]))])\nwrite_mlck('/tmp/d3.bin', {'name':'drift'}, [('conv1.weight',0,[2,2], f32([0.12,0.12,0.12,0.12]))])\n\nmanifest = '''[experiment]\nname = \"test-exp\"\ntimestamp = \"2024-01-15T10:30:00Z\"\n\n[environment]\npython_version = \"3.11.2\"\nseed = 42\ndeterministic = true\ngpu_id = \"cuda0\"\n\n[[dependencies]]\nname = \"torch\"\nversion = \"2.1.0\"\n\n[outputs]\ncheckpoint_path = \"cp1.bin\"\n\n[outputs.metrics]\naccuracy = 0.95\n'''\nopen('/tmp/"]
