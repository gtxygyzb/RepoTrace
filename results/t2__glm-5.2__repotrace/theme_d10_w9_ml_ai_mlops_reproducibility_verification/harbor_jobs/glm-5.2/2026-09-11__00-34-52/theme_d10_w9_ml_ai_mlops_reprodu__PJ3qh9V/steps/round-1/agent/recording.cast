[5724.415472, "o", "\t\t\t\t\tif !ok {\r\n   125\t\t\t\t\t\tcontinue\r\n   126\t\t\t\t\t}\r\n   127\t\t\t\t\tif childTime.Before(parentTime) {\r\n   128\t\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"timestamp violation: %s (%s) has parent %s (%s)\", e.ID, childTime.Format(\"2006-01-02\"), p, parentTime.Format(\"2006-01-02\")))\r\n   129\t\t\t\t\t}\r\n   130\t\t\t\t}\r\n   131\t\t\t}\r\n   132\t\t}\r\n   133\t\r\n   134\t\tif len(result.Errors) > 0 {\r\n   135\t\t\tresult.Valid = false\r\n   136\t\t\tresult.TopologicalOrder = nil\r\n   137\t\t\treturn result\r\n   138\t\t}\r\n   139\t\r\n   140\t\tchildren := make(map[string][]string)\r\n   141\t\tfor _, e := range exps {\r\n   142\t\t\tfor _, p := range e.Parents {\r\n   143\t\t\t\tchildren[p] = append(children[p], e.ID)\r\n   144\t\t\t}\r\n   145\t\t}\r\n   146\t\r\n   147\t\troots := make([]string, 0)\r\n   148\t\tleaves := make([]string, 0)\r\n   149\t\tfor _, e := range exps {\r\n   150\t\t\tif len(e.Parents) == 0 {\r\n   151\t\t\t\troots = append(roots, e.ID)\r\n   152\t\t\t}\r\n   153\t\t\tif len(children[e.ID]) == 0 {\r\n"]
[5724.415561, "o", "   154\t\t\t\tleaves = append(leaves, e.ID)\r\n   155\t\t\t}\r\n   156\t\t}\r\n   157\t\r\n   158\t\tvisited := make(map[string]bool)\r\n   159\t\tvar post []string\r\n   160\t\tvar dfs func(id string)\r\n   161\t\tdfs = func(id string) {\r\n   162\t\t\tvisited[id] = true\r\n   163\t\t\tfor _, child := range children[id] {\r\n   164\t\t\t\tif !visited[child] {\r\n   165\t\t\t\t\tdfs(child)\r\n"]
[5724.415628, "o", "   166\t\t\t\t}\r\n   167\t\t\t}\r\n   168\t\t\tpost = append(post, id)\r\n   169\t\t}\r\n   170\t\tfor _, e := range exps {\r\n   171\t\t\tif !visited[e.ID] {\r\n   172\t\t\t\tdfs(e.ID)\r\n   173\t\t\t}\r\n   174\t"]
[5724.415689, "o", "\t}\r\n   175\t\ttopo := make([]string, len(post))\r\n   176\t\tfor i := range post {\r\n   177\t\t\ttopo[i] = post[len(post)-1-i]\r\n   178\t\t}\r\n   179\t\r\n   180\t\tdepths := make(map[string]int)\r\n   181\t\tfor _, id := range topo {\r\n"]
[5724.415753, "o", "   182\t\t\tif len(exps[idSet[id]].Parents) == 0 {\r\n   183\t\t\t\tdepths[id] = 1\r\n   184\t\t\t\tcontinue\r\n   185\t\t\t}\r\n   186\t\t\tfor _, p := range exps[idSet[id]].Parents {\r\n   187\t\t\t\tif d := depths[p] + 1; d > depths[id] {\r\n   188\t\t\t\t\tdepths[id] = d\r\n   189\t\t\t\t}\r\n   190\t\t\t}\r\n   191\t\t}\r\n"]
[5724.415812, "o", "   192\t\r\n   193\t\tmaxDepth := 0\r\n   194\t\twidths := make(map[int]int)\r\n   195\t\tfor _, id := range topo {\r\n   196\t\t\td := depths[id]\r\n   197\t\t\tif d > maxDepth {\r\n   198\t\t\t\tmaxDepth = d\r\n"]
[5724.415868, "o", "   199\t\t\t}\r\n   200\t\t\twidths[d]++\r\n   201\t\t}\r\n   202\t\r\n   203\t\tmaxWidth := 0\r\n   204\t\tfor _, w := range widths {\r\n   205\t\t\tif w > maxWidth {\r\n"]
