[5247.604397, "o", "   150\t\t\treturn tensors[i].Name < tensors[j].Name\r\n   151\t\t})\r\n   152\t\r\n   153\t\tresult := &Result{\r\n   154\t\t\tNumSnapshots:       len(files),\r\n   155\t\t\tNumAnalyzedTensors: len(tensors),\r\n   156\t\t\tSkippedTensors:     skipped,\r\n   157\t\t\tTensors:            tensors,\r\n   158\t\t\tOverallConvergence: overall,\r\n"]
