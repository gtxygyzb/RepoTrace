[3686.121484, "o", "\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tseen := \u001b[01;31m\u001b[Kmap\u001b[m\u001b[K[string]bool{}\r\n\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kskipped\u001b[m\u001b[K := []string{}\r\n\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Ktensors\u001b[m\u001b[K := []TensorResult{}\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kskipped\u001b[m\u001b[K = append(\u001b[01;31m\u001b[Kskipped\u001b[m\u001b[K, name)\r\n\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Ktensors\u001b[m\u001b[K = append(\u001b[01;31m\u001b[Ktensors\u001b[m\u001b[K, TensorResult{\r\n\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif converging > len(\u001b[01;31m\u001b[Ktensors\u001b[m\u001b[K)/2 {\r\n\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t} else if diverging > len(\u001b[01;31m\u001b[Ktensors\u001b[m\u001b[K)/2 {\r\n\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tNumAnalyzedTensors: len(\u001b[01;31m\u001b[Ktensors\u001b[m\u001b[K),\r\n\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tSkippedTensors:     \u001b[01;31m\u001b[Kskipped\u001b[m\u001b[K,\r\n"]
