[5278.592813, "o", "\t\t\t\tConvergence:    convergence,\r\n   131\t\t\t\tStabilityScore: stability,\r\n   132\t\t\t})\r\n   133\t\r\n   134\t\t\tif convergence == \"converging\" {\r\n   135\t\t\t\tconverging++\r\n   136\t\t\t} else if convergence == \"diverging\" {\r\n   137\t\t"]
