[5262.701894, "o", "   225\t\r\n   226\t\tpos, err := parseMixedArgs(fs, args)\r\n   227\t\tif err != nil {\r\n   228\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   229\t\t\treturn 1\r\n   230\t\t}\r\n   231\t\tif len(pos) < 2 {\r\n   232\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\r\n   233\t\t\treturn 1\r\n   234\t\t}\r\n   235\t\r\n   236\t\tvar topKPtr *int\r\n   237\t\tfs.Visit(func(f *flag.Flag) {\r\n   238\t"]
[5262.701963, "o", "\t\tif f.Name == \"top-k\" {\r\n   239\t\t\t\tv := *topK\r\n   240\t\t\t\ttopKPtr = &v\r\n   241\t\t\t}\r\n   242\t\t})\r\n   243\t\tif topKPtr != nil && *topKPtr < 0 {\r\n   244\t\t\toutputJSON(map[string]interface{}{\"error\": \"--top-k must be non-negative\"})\r\n   245\t\t\treturn 1\r\n"]
[5262.702027, "o", "   246\t\t}\r\n   247\t\r\n   248\t\tres, err := drift.AnalyzeWithTopK(pos, topKPtr)\r\n   249\t\tif err != nil {\r\n   250\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   251\t\t\treturn 1\r\n   252\t\t}\r\n   253\t\toutputJSON(res)\r\n   254\t\treturn 0\r\n"]
