[4014.207122, "o", "\r\n   112\t\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"file2: %v\", err)})\r\n   113\t\t\treturn 1\r\n   114\t\t}\r\n   115\t\r\n   116\t\tres, err := compare.Compare(c1, c2, *mode, *atol, *rtol)\r\n   117\t\tif err != nil {\r\n   118\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   119\t\t\treturn 1\r\n   120\t\t}\r\n   121\t\r\n   122\t\toutputJSON(res)\r\n"]
