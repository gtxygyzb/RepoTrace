[1228.474055, "o", "\u001b[?2004h"]
[1228.474109, "o", "> "]
[1228.474161, "o", "                ok = false\r\n\u001b[?2004l\r"]
[1228.474216, "o", "\u001b[?2004h> "]
[1228.4743, "o", "                break\r\n\u001b[?2004l\r"]
[1228.474356, "o", "\u001b[?2004h> "]
[1228.474421, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.474476, "o", "> "]
[1228.474564, "o", "            if shape == nil {\r\n\u001b[?2004l\r"]
[1228.474618, "o", "\u001b[?2004h> "]
[1228.474736, "o", "                shape = t.Shape\r\n\u001b[?2004l\r"]
[1228.474792, "o", "\u001b[?2004h> "]
[1228.474994, "o", "            } else if !shapesEqual(shape, t.Shape) {\r\n\u001b[?2004l\r"]
[1228.475049, "o", "\u001b[?2004h> "]
[1228.475144, "o", "                ok = false\r\n\u001b[?2004l\r"]
[1228.475199, "o", "\u001b[?2004h> "]
[1228.475285, "o", "                break\r\n\u001b[?2004l\r"]
[1228.475339, "o", "\u001b[?2004h> "]
[1228.475384, "o", "            }\r\n\u001b[?2004l\r"]
[1228.47544, "o", "\u001b[?2004h> "]
[1228.475494, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.475549, "o", "> "]
[1228.475603, "o", "        if !ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.475658, "o", "> "]
[1228.475808, "o", "            skipped = append(skipped, name)\r\n\u001b[?2004l\r"]
[1228.475863, "o", "\u001b[?2004h> "]
[1228.475935, "o", "            continue\r\n\u001b[?2004l\r"]
[1228.47599, "o", "\u001b[?2004h> "]
[1228.476045, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1228.4761, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1228.4763, "o", "        steps := make([]float64, len(cps)-1)\r\n\u001b[?2004l\r"]
[1228.47636, "o", "\u001b[?2004h> "]
[1228.476514, "o", "        for i := 0; i < len(cps)-1; i++ {\r\n\u001b[?2004l\r"]
[1228.476568, "o", "\u001b[?2004h> "]
[1228.476738, "o", "            t1 := tensorByName(cps[i], name)\r\n\u001b[?2004l\r"]
[1228.476794, "o", "\u001b[?2004h> "]
[1228.476973, "o", "            t2 := tensorByName(cps[i+1], name)\r\n\u001b[?2004l\r"]
[1228.477029, "o", "\u001b[?2004h> "]
[1228.477186, "o", "            v1, err := t1.Float64Values()\r\n\u001b[?2004l\r"]
[1228.477258, "o", "\u001b[?2004h> "]
[1228.477354, "o", "            if err != nil {\r\n\u001b[?2004l\r"]
[1228.47741, "o", "\u001b[?2004h> "]
[1228.477526, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[1228.477582, "o", "\u001b[?2004h> "]
[1228.477633, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.477661, "o", "> "]
[1228.477838, "o", "            v2, err := t2.Float64Values()\r\n\u001b[?2004l\r"]
[1228.477892, "o", "\u001b[?2004h> "]
[1228.477994, "o", "            if err != nil {\r\n\u001b[?2004l\r"]
[1228.478049, "o", "\u001b[?2004h> "]
[1228.478164, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[1228.478219, "o", "\u001b[?2004h> "]
[1228.478279, "o", "            }\r\n\u001b[?2004l\r"]
[1228.478338, "o", "\u001b[?2004h> "]
[1228.478425, "o", "            n := len(v1)\r\n\u001b[?2004l\r"]
[1228.47848, "o", "\u001b[?2004h> "]
[1228.478584, "o", "            if n == 0 {\r\n\u001b[?2004l\r"]
[1228.478639, "o", "\u001b[?2004h> "]
[1228.478746, "o", "                steps[i] = 0\r\n\u001b[?2004l\r"]
[1228.478802, "o", "\u001b[?2004h> "]
[1228.478891, "o", "                continue\r\n\u001b[?2004l\r"]
[1228.478947, "o", "\u001b[?2004h> "]
[1228.479009, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.479064, "o", "> "]
[1228.479146, "o", "            var sum float64\r\n\u001b[?2004l\r"]
[1228.479199, "o", "\u001b[?2004h> "]
[1228.479344, "o", "            for j := 0; j < n; j++ {\r\n\u001b[?2004l\r"]
[1228.479399, "o", "\u001b[?2004h> "]
[1228.479578, "o", "                sum += math.Abs(v1[j] - v2[j])\r\n\u001b[?2004l\r"]
[1228.479633, "o", "\u001b[?2004h> "]
[1228.479691, "o", "            }\r\n\u001b[?2004l\r"]
[1228.479745, "o", "\u001b[?2004h> "]
[1228.479883, "o", "            steps[i] = sum / float64(n)\r\n\u001b[?2004l\r"]
[1228.479937, "o", "\u001b[?2004h> "]
[1228.479993, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1228.480048, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1228.480196, "o", "        mean := meanFloat64(steps)\r\n\u001b[?2004l\r"]
[1228.480259, "o", "\u001b[?2004h> "]
[1228.480381, "o", "        max := maxFloat64(steps)\r\n\u001b[?2004l\r"]
[1228.480437, "o", "\u001b[?2004h> "]
[1228.480626, "o", "        convergence := classifyConvergence(steps)\r\n\u001b[?2004l\r"]
[1228.48068, "o", "\u001b[?2004h> "]
[1228.48077, "o", "        stability := 1.0\r\n\u001b[?2004l\r"]
[1228.480824, "o", "\u001b[?2004h> "]
[1228.480923, "o", "        if steps[0] != 0 {\r\n\u001b[?2004l\r"]
[1228.480978, "o", "\u001b[?2004h> "]
[1228.481203, "o", "            stability = 1.0 - steps[len(steps)-1]/steps[0]\r\n\u001b[?2004l\r"]
[1228.481266, "o", "\u001b[?2004h> "]
[1228.481377, "o", "            if stability < 0 {\r\n\u001b[?2004l\r"]
[1228.481431, "o", "\u001b[?2004h> "]
[1228.481542, "o", "                stability = 0\r\n\u001b[?2004l\r"]
[1228.481597, "o", "\u001b[?2004h> "]
[1228.48174, "o", "            } else if stability > 1 {\r\n\u001b[?2004l\r"]
[1228.481795, "o", "\u001b[?2004h> "]
[1228.481903, "o", "                stability = 1\r\n\u001b[?2004l\r"]
[1228.481957, "o", "\u001b[?2004h> "]
[1228.482022, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.482077, "o", ">         }\r\n\u001b[?2004l\r"]
[1228.482131, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1228.482185, "o", "\u001b[?2004h> "]
[1228.482374, "o", "        tensors = append(tensors, TensorResult{\r\n\u001b[?2004l\r"]
[1228.482429, "o", "\u001b[?2004h> "]
[1228.482514, "o", "            Name: name,\r\n\u001b[?2004l\r"]
[1228.482569, "o", "\u001b[?2004h> "]
[1228.482687, "o", "            StepChanges: steps,\r\n\u001b[?2004l\r"]
[1228.482742, "o", "\u001b[?2004h> "]
[1228.482854, "o", "            MeanChange: mean,\r\n\u001b[?2004l\r"]
[1228.482909, "o", "\u001b[?2004h> "]
[1228.483011, "o", "            MaxChange: max,\r\n\u001b[?2004l\r"]
[1228.483066, "o", "\u001b[?2004h> "]
[1228.483207, "o", "            Convergence: convergence,\r\n\u001b[?2004l\r"]
[1228.48327, "o", "\u001b[?2004h> "]
[1228.483413, "o", "            StabilityScore: stability,\r\n\u001b[?2004l\r"]
[1228.483468, "o", "\u001b[?2004h> "]
[1228.483524, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.483579, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.48375, "o", "        if convergence == \"converging\" {\r\n\u001b[?2004l\r"]
[1228.483806, "o", "\u001b[?2004h> "]
[1228.483899, "o", "            converging++\r\n\u001b[?2004l\r"]
[1228.483954, "o", "\u001b[?2004h> "]
[1228.48413, "o", "        } else if convergence == \"diverging\" {\r\n\u001b[?2004l\r"]
[1228.484185, "o", "\u001b[?2004h> "]
[1228.484277, "o", "            diverging++\r\n\u001b[?2004l\r"]
[1228.484333, "o", "\u001b[?2004h> "]
[1228.4844, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.484454, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1228.484508, "o", "\u001b[?2004h> "]
[1228.484561, "o", "    overall := \"mixed\"\r\n\u001b[?2004l\r"]
[1228.484617, "o", "\u001b[?2004h> "]
[1228.484695, "o", "    if converging > len(tensors)/2 {\r\n\u001b[?2004l\r"]
[1228.484749, "o", "\u001b[?2004h> "]
[1228.484812, "o", "        overall = \"converging\"\r\n\u001b[?2004l\r"]
[1228.484866, "o", "\u001b[?2004h> "]
[1228.484963, "o", "    } else if diverging > len(tensors)/2 {\r\n\u001b[?2004l\r"]
[1228.485018, "o", "\u001b[?2004h> "]
[1228.485078, "o", "        overall = \"diverging\"\r\n\u001b[?2004l\r"]
[1228.485134, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.485189, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.485249, "o", "    return &Result{\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.485305, "o", "> "]
[1228.485373, "o", "        NumSnapshots: len(files),\r\n\u001b[?2004l\r"]
[1228.485428, "o", "\u001b[?2004h> "]
[1228.485522, "o", "        NumAnalyzedTensors: len(tensors),\r\n\u001b[?2004l\r"]
[1228.485577, "o", "\u001b[?2004h> "]
[1228.485648, "o", "        SkippedTensors: skipped,\r\n\u001b[?2004l\r"]
[1228.485704, "o", "\u001b[?2004h> "]
[1228.485761, "o", "        Tensors: tensors,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.485818, "o", "> "]
[1228.485889, "o", "        OverallConvergence: overall,\r\n\u001b[?2004l\r"]
[1228.485944, "o", "\u001b[?2004h>     }, nil\r\n\u001b[?2004l\r"]
[1228.485999, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.486054, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.486262, "o", "func tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {\r\n\u001b[?2004l\r"]
[1228.486318, "o", "\u001b[?2004h> "]
[1228.486403, "o", "    for _, t := range cp.Tensors {\r\n\u001b[?2004l\r"]
[1228.486459, "o", "\u001b[?2004h> "]
[1228.486514, "o", "        if t.Name == name {\r\n\u001b[?2004l\r"]
[1228.486569, "o", "\u001b[?2004h> "]
[1228.486621, "o", "            return t, true\r\n\u001b[?2004l\r"]
[1228.486676, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1228.486732, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1228.486787, "o", "\u001b[?2004h> "]
[1228.48685, "o", "    return mlck.Tensor{}, false\r\n\u001b[?2004l\r"]
[1228.486905, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1228.486964, "o", "\u001b[?2004h> "]
[1228.487059, "o", "func shapesEqual(a, b []uint32) bool {\r\n\u001b[?2004l\r"]
[1228.487114, "o", "\u001b[?2004h> "]
[1228.487166, "o", "    if len(a) != len(b) {\r\n\u001b[?2004l\r"]
[1228.487221, "o", "\u001b[?2004h> "]
[1228.487286, "o", "        return false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.487348, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.487403, "o", "    for i := range a {\r\n\u001b[?2004l\r"]
[1228.487457, "o", "\u001b[?2004h> "]
[1228.487517, "o", "        if a[i] != b[i] {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.487572, "o", "> "]
[1228.487633, "o", "            return false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.487687, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.487741, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.487796, "o", "    return true\r\n\u001b[?2004l\r"]
[1228.48785, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1228.487905, "o", "\u001b[?2004h> "]
[1228.488008, "o", "func meanFloat64(xs []float64) float64 {\r\n\u001b[?2004l\r"]
[1228.488062, "o", "\u001b[?2004h> "]
[1228.488117, "o", "    if len(xs) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.488179, "o", "        return 0\r\n\u001b[?2004l\r"]
[1228.488241, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.48832, "o", "    var sum float64\r\n\u001b[?2004l\r"]
[1228.488374, "o", "\u001b[?2004h> "]
[1228.488424, "o", "    for _, x := range xs {\r\n\u001b[?2004l\r"]
[1228.488479, "o", "\u001b[?2004h> "]
[1228.488534, "o", "        sum += x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.488588, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.488676, "o", "    return sum / float64(len(xs))\r\n\u001b[?2004l\r"]
[1228.488735, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1228.48879, "o", "\u001b[?2004h> "]
[1228.488886, "o", "func maxFloat64(xs []float64) float64 {\r\n\u001b[?2004l\r"]
[1228.48894, "o", "\u001b[?2004h> "]
[1228.488996, "o", "    if len(xs) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.489058, "o", "        return 0\r\n\u001b[?2004l\r"]
[1228.489112, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.489166, "o", ">     m := xs[0]\r\n\u001b[?2004l\r"]
[1228.489234, "o", "\u001b[?2004h> "]
[1228.489303, "o", "    for _, x := range xs[1:] {\r\n\u001b[?2004l\r"]
[1228.489358, "o", "\u001b[?2004h> "]
[1228.489412, "o", "        if x > m {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.489469, "o", "            m = x\r\n\u001b[?2004l\r"]
[1228.489527, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1228.489582, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.489637, "o", ">     return m\r\n\u001b[?2004l\r"]
[1228.489692, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.489747, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.489881, "o", "func classifyConvergence(steps []float64) string {\r\n\u001b[?2004l\r"]
[1228.489936, "o", "\u001b[?2004h> "]
[1228.489999, "o", "    if len(steps) <= 1 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.49009, "o", "        return \"converging\"\r\n\u001b[?2004l\r"]
[1228.490144, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.490198, "o", "> "]
[1228.490271, "o", "    decreasing := true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.490335, "o", "    increasing := true\r\n\u001b[?2004l\r"]
[1228.49039, "o", "\u001b[?2004h> "]
[1228.490471, "o", "    for i := 1; i < len(steps); i++ {\r\n\u001b[?2004l\r"]
[1228.490526, "o", "\u001b[?2004h> "]
[1228.490602, "o", "        if steps[i] >= steps[i-1] {\r\n\u001b[?2004l\r"]
[1228.490657, "o", "\u001b[?2004h> "]
[1228.49072, "o", "            decreasing = false\r\n\u001b[?2004l\r"]
[1228.490774, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1228.490829, "o", "\u001b[?2004h> "]
[1228.490908, "o", "        if steps[i] <= steps[i-1] {\r\n\u001b[?2004l\r"]
[1228.490964, "o", "\u001b[?2004h> "]
[1228.491026, "o", "            increasing = false\r\n\u001b[?2004l\r"]
[1228.49108, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1228.491135, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1228.49119, "o", "\u001b[?2004h> "]
[1228.491253, "o", "    if decreasing {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.491338, "o", "        return \"converging\"\r\n\u001b[?2004l\r"]
[1228.491392, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.491446, "o", "> "]
[1228.491501, "o", "    if increasing {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1228.491584, "o", "        return \"diverging\"\r\n\u001b[?2004l\r"]
[1228.491638, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1228.491693, "o", "> "]
[1228.491743, "o", "    return \"oscillating\"\r\n\u001b[?2004l\r\u001b[?2004h"]
