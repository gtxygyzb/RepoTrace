[4642.263332, "o", "   220\tfunc runDriftAnalysis(args []string) int {\r\n   221\t\tfs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\r\n   222\t\tfs.SetOutput(io.Discard)\r\n   223\t\r\n   224\t\tpos, err := parseMixedArgs(fs, args)\r\n   225\t\tif err != nil {\r\n   226\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   227\t\t\treturn 1\r\n   228\t\t}\r\n   229\t\tif len(pos) < 2 {\r\n   230\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\r\n   231\t\t\treturn 1\r\n   232\t\t}\r\n   233\t\r\n"]
