[4014.207693, "o", "\t\t\tcontinue\r\n   183\t\t\t}\r\n   184\t\t\tif _, err := os.ReadFile(p); err != nil {\r\n   185\t\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   186\t\t\t\treturn 1\r\n   187\t\t\t}\r\n   188\t\t}\r\n   189\t\r\n   190\t\trep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)\r\n   191\t\toutputJSON(rep)\r\n   192\t"]
[4014.207756, "o", "\treturn code\r\n   193\t}\r\n   194\t\r\n   195\tfunc runMergeCheckpoints(args []string) int {\r\n   196\t\tfs := flag.NewFlagSet(\"merge-checkpoints\", flag.ContinueOnError)\r\n   197\t\tfs.SetOutput(io.Discard)\r\n   198\t\tconflict := fs.String(\"conflict\", \"first\", \"conflict strategy\")\r\n   199\t\r\n   200\t\tpos, err := parseMixedArgs(fs, args)\r\n   201\t\tif err != nil {\r\n   202\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   203\t\t\treturn 1\r\n   204\t\t}\r\n   205\t\tif len(pos) < 3 {\r\n"]
[4014.20782, "o", "   206\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]\"})\r\n   207\t\t\treturn 1\r\n   208\t\t}\r\n   209\t\r\n   210\t\tres, err := merge.Merge(pos[0], pos[1:], *conflict)\r\n   211\t\tif err != nil {\r\n   212\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   213\t\t\treturn 1\r\n   214\t"]
[4014.20789, "o", "\t}\r\n   215\t\toutputJSON(res)\r\n   216\t\treturn 0\r\n   217\t}\r\n   218\t\r\n   219\tfunc runDriftAnalysis(args []string) int {\r\n   220\t\tfs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\r\n   221\t\tfs.SetOutput(io.Discard)\r\n   222\t\r\n   223\t\tpos, err := parseMixedArgs(fs, args)\r\n   224\t\tif err != nil {\r\n"]
[4014.207955, "o", "   225\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   226\t\t\treturn 1\r\n   227\t\t}\r\n   228\t\tif len(pos) < 2 {\r\n   229\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\r\n   230\t\t\treturn 1\r\n   231\t\t}\r\n   232\t\r\n   233\t\tres, err := drift.Analyze(pos)\r\n   234"]
[4014.208014, "o", "\t\tif err != nil {\r\n   235\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   236\t\t\treturn 1\r\n   237\t\t}\r\n   238\t\toutputJSON(res)\r\n   239\t\treturn 0\r\n   240\t}\r\n   241\t\r\n"]
[4014.208074, "o", "   242\tfunc parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {\r\n   243\t\tvar positional []string\r\n   244\t\tvar flagArgs []string\r\n   245\t\r\n   246\t\tfor i := 0; i < len(args); i++ {\r\n   247\t\t\targ := args[i]\r\n   248\t\t\tif arg == \"--\" {\r\n   249\t\t\t\tpositional = append(positional, args[i+1:]...)\r\n   250\t\t\t\tbreak\r\n"]
[4014.208138, "o", "   251\t\t\t}\r\n   252\t\t\tif strings.HasPrefix(arg, \"--\") {\r\n   253\t\t\t\tif strings.Contains(arg, \"=\") {\r\n   254\t\t\t\t\tflagArgs = append(flagArgs, arg)\r\n   255\t\t\t\t\tcontinue\r\n   256\t\t\t\t}\r\n   257\t\t\t\tif i+1 >= len(args) {\r\n   258\t\t\t\t\treturn nil, fmt.Errorf(\"flag %s requires a value\", arg)\r\n   259\t"]
[4014.208203, "o", "\t\t\t}\r\n   260\t\t\t\tflagArgs = append(flagArgs, arg+\"=\"+args[i+1])\r\n   261\t\t\t\ti++\r\n   262\t\t\t} else {\r\n   263\t\t\t\tpositional = append(positional, arg)\r\n   264\t\t\t}\r\n   265\t\t}\r\n   266\t\r\n   267\t\tif err := fs.Parse(flagArgs); err != nil {\r\n   268\t\t"]
[4014.208287, "o", "\treturn nil, err\r\n   269\t\t}\r\n   270\t\treturn positional, nil\r\n   271\t}\r\n   272\t\r\n   273\tfunc outputJSON(v interface{}) {\r\n   274\t\tenc := json.NewEncoder(os.Stdout)\r\n   275\t\tenc.SetIndent(\"\", \"  \")\r\n   276\t\t_ = enc.Encode(v)\r\n   277\t}\r\n"]
