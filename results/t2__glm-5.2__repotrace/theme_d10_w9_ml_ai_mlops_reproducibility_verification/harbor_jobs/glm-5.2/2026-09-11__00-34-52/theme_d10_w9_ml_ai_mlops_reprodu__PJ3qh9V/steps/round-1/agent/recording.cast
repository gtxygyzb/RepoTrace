[5241.73579, "o", "   253\t\toutputJSON(res)\r\n   254\t\treturn 0\r\n   255\t}\r\n   256\t\r\n   257\tfunc parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {\r\n   258\t\tvar positional []string\r\n   259\t\tvar flagArgs []string\r\n   260\t\r\n   261\t\tfor i := 0; i < len(args); i++ {\r\n"]
[5241.735847, "o", "   262\t\t\targ := args[i]\r\n   263\t\t\tif arg == \"--\" {\r\n   264\t\t\t\tpositional = append(positional, args[i+1:]...)\r\n   265\t\t\t\tbreak\r\n   266\t\t\t}\r\n   267\t\t\tif strings.HasPrefix(arg, \"--\") {\r\n   268\t\t\t\tif strings.Contains(arg, \"=\") {\r\n   269\t\t\t\t\tflagArgs = append(flagArgs, arg)\r\n"]
[5241.735906, "o", "   270\t\t\t\t\tcontinue\r\n   271\t\t\t\t}\r\n   272\t\t\t\tif isBoolFlag(fs, arg) {\r\n   273\t\t\t\t\tflagArgs = append(flagArgs, arg+\"=true\")\r\n   274\t\t\t\t\tcontinue\r\n   275\t\t\t\t}\r\n   276\t\t\t\tif i+1 >= len(args) {\r\n   277\t\t\t"]
[5241.73597, "o", "\t\treturn nil, fmt.Errorf(\"flag %s requires a value\", arg)\r\n   278\t\t\t\t}\r\n   279\t\t\t\tflagArgs = append(flagArgs, arg+\"=\"+args[i+1])\r\n   280\t\t\t\ti++\r\n   281\t\t\t} else {\r\n   282\t\t\t\tpositional = append(positional, arg)\r\n   283\t\t\t}\r\n   284\t\t}\r\n   285\t\r\n"]
[5241.736035, "o", "   286\t\tif err := fs.Parse(flagArgs); err != nil {\r\n   287\t\t\treturn nil, err\r\n   288\t\t}\r\n   289\t\treturn positional, nil\r\n   290\t}\r\n   291\t\r\n   292\tfunc isBoolFlag(fs *flag.FlagSet, arg string) bool {\r\n   293\t\tname := strings.TrimPrefix(arg, \"--\")\r\n   294\t\tif i := strings.IndexByte(name, '='); i >= 0 {\r\n   295\t\t\tname = name[:i]\r\n"]
[5241.736106, "o", "   296\t\t}\r\n   297\t\tf := fs.Lookup(name)\r\n   298\t\tif f == nil {\r\n   299\t\t\treturn false\r\n   300\t\t}\r\n   301\t\ttype boolFlag interface {\r\n   302\t\t\tIsBoolFlag() bool\r\n   303\t\t}\r\n   304\t\tbf, ok := f.Value.(boolFlag)\r\n"]
[5241.736165, "o", "   305\t\treturn ok && bf.IsBoolFlag()\r\n   306\t}\r\n   307\t\r\n   308\tfunc outputJSON(v interface{}) {\r\n   309\t\tenc := json.NewEncoder(os.Stdout)\r\n   310\t\tenc.SetIndent(\"\", \"  \")\r\n   311\t\tenc.SetEscapeHTML(false)\r\n   312\t\t_ = enc.Encode(v)\r\n   313\t}\r\n"]
