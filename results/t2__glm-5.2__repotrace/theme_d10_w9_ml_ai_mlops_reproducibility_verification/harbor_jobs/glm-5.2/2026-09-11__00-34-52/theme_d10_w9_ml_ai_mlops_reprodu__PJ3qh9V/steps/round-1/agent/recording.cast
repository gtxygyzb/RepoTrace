[4655.085343, "o", "\t}\r\n\r\n\tcps := make([]*mlck.Checkpoint, len(files))\r\n\tfor i, f := range files {\r\n\t\tcp, err := mlck.ParseFile(f)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n\t\t}\r\n\t\tcps[i] = cp\r\n\t}\r\n\r\n\tvar allNames []string\r\n\tseen := map[string]bool{}\r\n\tfor _, cp := range cps {\r\n\t\tfor _, t := range cp.Tensors {\r\n\t\t\tif !seen[t.Name] {\r\n\t\t\t\tseen[t.Name] = true\r\n\t\t\t\tallNames = append(allNames, t.Name)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tsort.Strings(allNames)\r\n\r\n"]
[4655.085413, "o", "\tskipped := []string{}\r\n\ttensors := []TensorResult{}\r\n\tconverging := 0\r\n\tdiverging := 0\r\n\r\n\tfor _, name := range allNames {\r\n\t\tok := true\r\n\t\tvar shape []uint32\r\n\t\tfor _, cp := range cps {\r\n\t\t\tt, exists := tensorByName(cp, name)\r\n\t\t\tif !exists {\r\n\t\t\t\tok = false\r\n"]
[4655.085532, "o", "\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\tif shape == nil {\r\n\t\t\t\tshape = t.Shape\r\n\t\t\t} else if !shapesEqual(shape, t.Shape) {\r\n\t\t\t\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif !ok {\r\n\t\t\tskipped = append(skipped, name)\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tsteps := make([]float64, len(cps)-1)\r\n\t\tfor i := 0; i < len(cps)-1; i++ {\r\n\t\t\tt1, _ := tensorByName(cps[i], name)\r\n\t\t\tt2, _ := tensorByName(cps[i+1], name)\r\n\t\t\tv1, err := t1.Float64Values()\r\n"]
[4655.085603, "o", "\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tv2, err := t2.Float64Values()\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tn := len(v1)\r\n\t\t\tif n == 0 {\r\n\t\t\t\t"]
[4655.085671, "o", "steps[i] = 0\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvar sum float64\r\n\t\t\tfor j := 0; j < n; j++ {\r\n\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n\t\t\t}\r\n\t\t\tsteps[i] = sum / float64(n)\r\n\t\t}\r\n\r\n\t\tmean := meanFloat64(steps)\r\n\t\tmax := maxFloat64(steps)\r\n\t\t"]
[4655.085737, "o", "convergence := classifyConvergence(steps)\r\n\t\tstability := 1.0\r\n\t\tif steps[0] != 0 {\r\n\t\t\tstability = 1.0 - steps[len(steps)-1]/steps[0]\r\n\t\t\tif stability < 0 {\r\n\t\t\t\tstability = 0\r\n\t\t\t} else if stability > 1 {\r\n"]
[4655.085813, "o", "\t\t\t\tstability = 1\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\ttensors = append(tensors, TensorResult{\r\n\t\t\tName:           name,\r\n\t\t\tStepChanges:    steps,\r\n\t\t\tMeanChange:     mean,\r\n\t\t\tMaxChange:      max,\r\n\t\t\tConvergence:    convergence,\r\n\t"]
[4655.08588, "o", "\t\tStabilityScore: stability,\r\n\t\t})\r\n\r\n\t\tif convergence == \"converging\" {\r\n\t\t\tconverging++\r\n\t\t} else if convergence == \"diverging\" {\r\n\t\t\tdiverging++\r\n\t\t}\r\n\t}\r\n\r\n\toverall := \"mixed\"\r\n"]
[4655.085949, "o", "\tif converging > len(tensors)/2 {\r\n\t\toverall = \"converging\"\r\n\t} else if diverging > len(tensors)/2 {\r\n\t\toverall = \"diverging\"\r\n\t}\r\n\r\n\tsort.Strings(skipped)\r\n\tsort.Slice(tensors, func(i, j int) bool {\r\n\t\treturn tensors[i].Name < tensors[j].Name\r\n"]
[4655.086017, "o", "\t})\r\n\r\n\treturn &Result{\r\n\t\tNumSnapshots:       len(files),\r\n\t\tNumAnalyzedTensors: len(tensors),\r\n\t\tSkippedTensors:     skipped,\r\n\t\tTensors:            tensors,\r\n\t\tOverallConvergence: overall,\r\n"]
