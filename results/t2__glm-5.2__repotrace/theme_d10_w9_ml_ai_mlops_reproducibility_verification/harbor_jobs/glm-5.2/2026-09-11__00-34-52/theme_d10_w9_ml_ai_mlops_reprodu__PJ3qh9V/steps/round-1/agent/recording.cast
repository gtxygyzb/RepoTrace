[4855.661404, "o", "s = re.sub(\r\n\u001b[?2004l\r"]
[4855.661477, "o", "\u001b[?2004h> "]
[4855.661758, "o", "    r'type Result struct \\{.*?\\n\\}',\r\n\u001b[?2004l\r"]
[4855.661826, "o", "\u001b[?2004h> "]
[4855.662014, "o", "    '''type Result struct {\r\n\u001b[?2004l\r"]
[4855.662081, "o", "\u001b[?2004h> "]
[4855.66254, "o", "        NumSnapshots       int            `json:\"num_snapshots\"`\r\n\u001b[?2004l\r"]
[4855.662606, "o", "\u001b[?2004h> "]
[4855.663073, "o", "        NumAnalyzedTensors int            `json:\"num_analyzed_tensors\"`\r\n\u001b[?2004l\r"]
[4855.663149, "o", "\u001b[?2004h> "]
[4855.663608, "o", "        SkippedTensors     []string       `json:\"skipped_tensors\"`\r\n\u001b[?2004l\r"]
[4855.663675, "o", "\u001b[?2004h> "]
[4855.664057, "o", "        Tensors            []TensorResult `json:\"tensors\"`\r\n\u001b[?2004l\r"]
[4855.66414, "o", "\u001b[?2004h"]
[4855.664212, "o", "> "]
[4855.664598, "o", "        OverallConvergence string         `json:\"overall_convergence\"`\r\n\u001b[?2004l\r"]
[4855.664669, "o", "\u001b[?2004h> "]
[4855.665119, "o", "        TopK               *int           `json:\"top_k,omitempty\"`\r\n\u001b[?2004l\r"]
[4855.665186, "o", "\u001b[?2004h> "]
[4855.665265, "o", "}''',\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.665334, "o", ">     s,\r\n"]
[4855.6654, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4855.66553, "o", "    flags=re.S,\r\n\u001b[?2004l\r"]
[4855.665595, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[4855.665672, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4855.665738, "o", "\u001b[?2004h> "]
[4855.666383, "o", "new_analyze = '''// Analyze remains available for callers that do not need a top-k restriction.\r\n\u001b[?2004l\r"]
[4855.666451, "o", "\u001b[?2004h> "]
[4855.666772, "o", "func Analyze(files []string) (*Result, error) {\r\n\u001b[?2004l\r"]
[4855.66684, "o", "\u001b[?2004h> "]
[4855.667112, "o", "        return AnalyzeWithTopK(files, 0)\r\n\u001b[?2004l\r"]
[4855.66718, "o", "\u001b[?2004h> }\r\n"]
[4855.667255, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4855.667323, "o", "\u001b[?2004h> "]
[4855.667847, "o", "// AnalyzeWithTopK analyzes drift and optionally restricts the returned tensor\r\n\u001b[?2004l\r"]
[4855.667915, "o", "\u001b[?2004h> "]
[4855.668434, "o", "// list to the N tensors with the lowest stability scores. When topK > 0 the\r\n\u001b[?2004l\r"]
[4855.668503, "o", "\u001b[?2004h> "]
[4855.669034, "o", "// result includes a top_k field set to the requested N, even if fewer tensors\r\n\u001b[?2004l\r"]
[4855.669101, "o", "\u001b[?2004h> "]
[4855.669203, "o", "// are returned.\r\n\u001b[?2004l\r"]
[4855.669288, "o", "\u001b[?2004h> "]
[4855.669729, "o", "func AnalyzeWithTopK(files []string, topK int) (*Result, error) {\r\n\u001b[?2004l\r"]
[4855.669796, "o", "\u001b[?2004h> "]
[4855.669985, "o", "        if len(files) < 2 {\r\n\u001b[?2004l\r"]
[4855.670051, "o", "\u001b[?2004h> "]
[4855.670542, "o", "                return nil, fmt.Errorf(\"at least 2 input files required\")\r\n\u001b[?2004l\r"]
[4855.670609, "o", "\u001b[?2004h> "]
[4855.670674, "o", "        }\r\n\u001b[?2004l\r"]
[4855.67074, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4855.670808, "o", "\u001b[?2004h> "]
[4855.671148, "o", "        cps := make([]*mlck.Checkpoint, len(files))\r\n\u001b[?2004l\r"]
[4855.671214, "o", "\u001b[?2004h> "]
[4855.671447, "o", "        for i, f := range files {\r\n\u001b[?2004l\r"]
[4855.671515, "o", "\u001b[?2004h> "]
[4855.671811, "o", "                cp, err := mlck.ParseFile(f)\r\n\u001b[?2004l\r"]
[4855.671879, "o", "\u001b[?2004h> "]
[4855.672094, "o", "                if err != nil {\r\n\u001b[?2004l\r"]
[4855.672161, "o", "\u001b[?2004h> "]
[4855.672633, "o", "                        return nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n\u001b[?2004l\r"]
[4855.672703, "o", "\u001b[?2004h> "]
[4855.672776, "o", "                }\r\n\u001b[?2004l\r"]
[4855.672843, "o", "\u001b[?2004h> "]
[4855.672982, "o", "                cps[i] = cp\r\n\u001b[?2004l\r"]
[4855.673048, "o", "\u001b[?2004h> "]
[4855.673113, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4855.673179, "o", "\u001b[?2004h> "]
[4855.673349, "o", "        var allNames []string\r\n\u001b[?2004l\r"]
[4855.673416, "o", "\u001b[?2004h> "]
[4855.673595, "o", "        seen := map[string]bool{}\r\n\u001b[?2004l\r"]
[4855.673661, "o", "\u001b[?2004h> "]
[4855.673839, "o", "        for _, cp := range cps {\r\n\u001b[?2004l\r"]
[4855.673906, "o", "\u001b[?2004h> "]
[4855.674132, "o", "                for _, t := range cp.Tensors {\r\n\u001b[?2004l\r"]
[4855.674198, "o", "\u001b[?2004h> "]
[4855.674427, "o", "                        if !seen[t.Name] {\r\n\u001b[?2004l\r"]
[4855.674493, "o", "\u001b[?2004h> "]
[4855.674784, "o", "                                seen[t.Name] = true\r\n\u001b[?2004l\r"]
[4855.67485, "o", "\u001b[?2004h> "]
[4855.675247, "o", "                                allNames = append(allNames, t.Name)\r\n\u001b[?2004l\r"]
[4855.675315, "o", "\u001b[?2004h> "]
[4855.675426, "o", "                        }\r\n\u001b[?2004l\r"]
[4855.675494, "o", "\u001b[?2004h> "]
[4855.675563, "o", "                }\r\n\u001b[?2004l\r"]
[4855.675629, "o", "\u001b[?2004h> "]
[4855.675693, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.675758, "o", "> "]
[4855.675909, "o", "        sort.Strings(allNames)\r\n\u001b[?2004l\r"]
[4855.675976, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.67604, "o", "> "]
[4855.676156, "o", "        skipped := []string{}\r\n\u001b[?2004l\r"]
[4855.676223, "o", "\u001b[?2004h> "]
[4855.676414, "o", "        tensors := []TensorResult{}\r\n\u001b[?2004l\r"]
[4855.676482, "o", "\u001b[?2004h> "]
[4855.676583, "o", "        converging := 0\r\n\u001b[?2004l\r"]
[4855.67665, "o", "\u001b[?2004h> "]
[4855.67677, "o", "        diverging := 0\r\n\u001b[?2004l\r"]
[4855.676841, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.676908, "o", "> "]
[4855.67707, "o", "        for _, name := range allNames {\r\n\u001b[?2004l\r"]
[4855.677135, "o", "\u001b[?2004h> "]
[4855.677287, "o", "                ok := true\r\n\u001b[?2004l\r"]
[4855.677355, "o", "\u001b[?2004h> "]
[4855.677552, "o", "                var shape []uint32\r\n\u001b[?2004l\r"]
[4855.677619, "o", "\u001b[?2004h> "]
[4855.677847, "o", "                for _, cp := range cps {\r\n\u001b[?2004l\r"]
[4855.677915, "o", "\u001b[?2004h> "]
[4855.678267, "o", "                        t, exists := tensorByName(cp, name)\r\n\u001b[?2004l\r"]
[4855.678334, "o", "\u001b[?2004h> "]
[4855.678534, "o", "                        if !exists {\r\n\u001b[?2004l\r"]
[4855.678603, "o", "\u001b[?2004h> "]
[4855.678842, "o", "                                ok = false\r\n\u001b[?2004l\r"]
[4855.678911, "o", "\u001b[?2004h> "]
[4855.679116, "o", "                                break\r\n\u001b[?2004l\r"]
[4855.679183, "o", "\u001b[?2004h> "]
[4855.679314, "o", "                        }\r\n\u001b[?2004l\r"]
[4855.67938, "o", "\u001b[?2004h> "]
[4855.67961, "o", "                        if shape == nil {\r\n\u001b[?2004l\r"]
[4855.679677, "o", "\u001b[?2004h> "]
[4855.679917, "o", "                                shape = t.Shape\r\n\u001b[?2004l\r"]
[4855.679983, "o", "\u001b[?2004h> "]
[4855.680362, "o", "                        } else if !shapesEqual(shape, t.Shape) {\r\n\u001b[?2004l\r"]
[4855.680431, "o", "\u001b[?2004h> "]
[4855.680624, "o", "                                ok = false\r\n\u001b[?2004l\r"]
[4855.6807, "o", "\u001b[?2004h> "]
[4855.680904, "o", "                                break\r\n\u001b[?2004l\r"]
[4855.680973, "o", "\u001b[?2004h> "]
[4855.681106, "o", "                        }\r\n\u001b[?2004l\r"]
[4855.681173, "o", "\u001b[?2004h> "]
[4855.681254, "o", "                }\r\n\u001b[?2004l\r"]
[4855.681325, "o", "\u001b[?2004h> "]
[4855.681447, "o", "                if !ok {\r\n\u001b[?2004l\r"]
[4855.681515, "o", "\u001b[?2004h> "]
[4855.681855, "o", "                        skipped = append(skipped, name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.681911, "o", "> "]
[4855.682081, "o", "                        continue\r\n\u001b[?2004l\r"]
[4855.682147, "o", "\u001b[?2004h> "]
[4855.682252, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.682318, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.682607, "o", "                steps := make([]float64, len(cps)-1)\r\n\u001b[?2004l\r"]
[4855.682674, "o", "\u001b[?2004h> "]
[4855.682953, "o", "                for i := 0; i < len(steps); i++ {\r\n\u001b[?2004l\r"]
[4855.683021, "o", "\u001b[?2004h> "]
[4855.683281, "o", "                        v1, err := tensorData(cps[i], name)\r\n\u001b[?2004l\r"]
[4855.683347, "o", "\u001b[?2004h> "]
[4855.683469, "o", "                        if err != nil {\r\n\u001b[?2004l\r"]
[4855.683535, "o", "\u001b[?2004h> "]
[4855.683681, "o", "                                return nil, err\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.683748, "o", "> "]
[4855.683811, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.683878, "o", "> "]
[4855.684089, "o", "                        v2, err := tensorData(cps[i+1], name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.684155, "o", "> "]
[4855.684275, "o", "                        if err != nil {\r\n\u001b[?2004l\r"]
[4855.684353, "o", "\u001b[?2004h> "]
[4855.684498, "o", "                                return nil, err\r\n\u001b[?2004l\r"]
[4855.684564, "o", "\u001b[?2004h> "]
[4855.684631, "o", "                        }\r\n\u001b[?2004l\r"]
[4855.684699, "o", "\u001b[?2004h> "]
[4855.68482, "o", "                        n := len(v1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.684886, "o", "> "]
[4855.68499, "o", "                        if n == 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.685056, "o", "> "]
[4855.685184, "o", "                                steps[i] = 0\r\n\u001b[?2004l\r"]
[4855.685264, "o", "\u001b[?2004h> "]
[4855.685387, "o", "                                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.685453, "o", "> "]
[4855.685515, "o", "                        }\r\n\u001b[?2004l\r"]
[4855.685581, "o", "\u001b[?2004h> "]
[4855.685716, "o", "                        var sum float64\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.68579, "o", "> "]
[4855.685945, "o", "                        for j := 0; j < n; j++ {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.686013, "o", "> "]
[4855.686219, "o", "                                sum += math.Abs(v1[j] - v2[j])\r\n\u001b[?2004l\r"]
[4855.686303, "o", "\u001b[?2004h> "]
[4855.686376, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.686598, "o", "                        steps[i] = sum / float64(n)\r\n\u001b[?2004l\r"]
[4855.686666, "o", "\u001b[?2004h> "]
[4855.686734, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r "]
[4855.686801, "o", "\u001b[?2004h> "]
[4855.686943, "o", "                mean := meanFloat64(steps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.687011, "o", "> "]
[4855.687133, "o", "                max := maxFloat64(steps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.687199, "o", "> "]
[4855.687396, "o", "                convergence := classifyConvergence(steps)\r\n\u001b[?2004l\r"]
[4855.687463, "o", "\u001b[?2004h> "]
[4855.687562, "o", "                stability := 1.0\r\n\u001b[?2004l\r"]
[4855.687629, "o", "\u001b[?2004h> "]
[4855.687717, "o", "                if max != 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.687783, "o", "> "]
[4855.688015, "o", "                        stability = 1.0 - steps[len(steps)-1]/max\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.688082, "o", "> "]
[4855.688208, "o", "                        if stability < 0 {\r\n\u001b[?2004l\r"]
[4855.688289, "o", "\u001b[?2004h> "]
[4855.688423, "o", "                                stability = 0\r\n\u001b[?2004l\r"]
[4855.688488, "o", "\u001b[?2004h> "]
[4855.688655, "o", "                        } else if stability > 1 {\r\n\u001b[?2004l\r"]
[4855.688722, "o", "\u001b[?2004h> "]
[4855.688876, "o", "                                stability = 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.688945, "o", "> "]
[4855.689013, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.68908, "o", "> "]
[4855.689145, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.689211, "o", "> "]
[4855.689399, "o", "                tensors = append(tensors, TensorResult{\r\n\u001b[?2004l\r"]
[4855.689465, "o", "\u001b[?2004h> "]
[4855.689608, "o", "                        Name:           name,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.689674, "o", "> "]
[4855.689771, "o", "                        StepChanges:    steps,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.689838, "o", "> "]
[4855.689931, "o", "                        MeanChange:     mean,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.69, "o", "> "]
[4855.690089, "o", "                        MaxChange:      max,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.690156, "o", "> "]
[4855.690274, "o", "                        Convergence:    convergence,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.690339, "o", "> "]
[4855.690448, "o", "                        StabilityScore: stability,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.690513, "o", ">                 })\r\n\u001b[?2004l\r"]
[4855.690578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.690735, "o", "                if convergence == \"converging\" {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.6908, "o", "> "]
[4855.69087, "o", "                        converging++\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.690935, "o", "> "]
[4855.691056, "o", "                } else if convergence == \"diverging\" {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.691121, "o", "> "]
[4855.691189, "o", "                        diverging++\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.69126, "o", ">                 }\r\n\u001b[?2004l\r"]
[4855.691326, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4855.691392, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.691478, "o", "        overall := \"mixed\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.691544, "o", "> "]
[4855.691624, "o", "        if converging > len(tensors)/2 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.691688, "o", "> "]
[4855.691764, "o", "                overall = \"converging\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.691829, "o", "> "]
[4855.691927, "o", "        } else if diverging > len(tensors)/2 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.691995, "o", "> "]
[4855.692066, "o", "                overall = \"diverging\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.692133, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.692196, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.692278, "o", "        sort.Strings(skipped)\r\n\u001b[?2004l\r"]
[4855.692344, "o", "\u001b[?2004h> "]
[4855.692453, "o", "        sort.Slice(tensors, func(i, j int) bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.692518, "o", "> "]
[4855.692644, "o", "                return tensors[i].Name < tensors[j].Name\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.692709, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.692774, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.69285, "o", "        result := &Result{\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.692915, "o", "> "]
[4855.693017, "o", "                NumSnapshots:       len(files),\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.693081, "o", "> "]
[4855.693188, "o", "                NumAnalyzedTensors: len(tensors),\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.693267, "o", "> "]
[4855.693352, "o", "                SkippedTensors:     skipped,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.693417, "o", "> "]
[4855.693511, "o", "                Tensors:            tensors,\r\n\u001b[?2004l\r\u001b[?2004h"]
[4855.693576, "o", "> "]
[4855.693645, "o", "                OverallConvergence: overall,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.693711, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.693769, "o", "        applyTopK(result, topK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.693841, "o", "        return result, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.693906, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.69399, "o", "func applyTopK(result *Result, topK int) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.694056, "o", "        if topK <= 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.694119, "o", "                return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.694185, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.694264, "o", "        requested := topK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.694397, "o", "        sort.SliceStable(result.Tensors, func(i, j int) bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.694582, "o", "                if result.Tensors[i].StabilityScore != result.Tensors[j].StabilityScore {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.69479, "o", "                        return result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.694861, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.694999, "o", "                return result.Tensors[i].Name < result.Tensors[j].Name\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.695067, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.695149, "o", "        if requested < len(result.Tensors) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.695288, "o", "                result.Tensors = result.Tensors[:requested]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.695358, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.695436, "o", "        result.TopK = &requested\r\n\u001b[?2004l\r\u001b[?2004h> }'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.695504, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> s = re.sub(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.695701, "o", "    r'func Analyze\\(files \\[\\]string\\) \\(\\*Result, error\\) \\{.*?\\n\\}\\n\\nfunc tensorByName',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.695806, "o", "    new_analyze + '\\n\\nfunc tensorByName',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.695871, "o", "    s,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.695936, "o", "    flags=re.S,\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.696089, "o", "new_classify = '''func classifyConvergence(steps []float64) string {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.696166, "o", "        if len(steps) <= 1 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.696259, "o", "                return \"converging\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.696326, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.696398, "o", "        nonIncreasing := true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.696466, "o", "        nonDecreasing := true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.696537, "o", "        hasIncrease := false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.696637, "o", "        for i := 1; i < len(steps); i++ {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.696741, "o", "                if steps[i] > steps[i-1] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.69685, "o", "                        nonIncreasing = false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.696952, "o", "                        hasIncrease = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697023, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697113, "o", "                if steps[i] < steps[i-1] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697221, "o", "                        nonDecreasing = false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697302, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697367, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697433, "o", "        if nonIncreasing {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697488, "o", "                return \"converging\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697558, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697626, "o", "        if nonDecreasing && hasIncrease {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697713, "o", "                return \"diverging\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697779, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697857, "o", "        return \"oscillating\"\r\n\u001b[?2004l\r\u001b[?2004h> }'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.697923, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> s = re.sub(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.698079, "o", "    r'func classifyConvergence\\(steps \\[\\]float64\\) string \\{.*?\\n\\}',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.698144, "o", "    new_classify,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.698211, "o", "    s,\r\n\u001b[?2004l\r\u001b[?2004h>     flags=re.S,\r\n\u001b[?2004l\r"]
[4855.698287, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.698353, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.698433, "o", "p = Path('internal/app/app.go')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.698505, "o", "s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.698636, "o", "new_run = '''func runDriftAnalysis(args []string) int {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.69879, "o", "        fs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.698879, "o", "        fs.SetOutput(io.Discard)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4855.698947, "o", "\u001b[?2004h> "]
[4855.69911, "o", "        topK := fs.Int(\"top-k\", 0, \"number of tensors with the lowest stability scores to include\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4855.699176, "o", "\u001b[?2004h> "]
[4855.699253, "o", "        pos, err := parseMixedArgs(fs, args)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.699331, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.699464, "o", "                outputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.699536, "o", "                return 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.699601, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.699669, "o", "        if len(pos) < 2 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.699918, "o", "                outputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.699988, "o", "                return 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.700051, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.700118, "o", "        if *topK < 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.700292, "o", "                outputJSON(map[string]interface{}{\"error\": \"--top-k must be non-negative\"})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.700361, "o", "                return 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.700425, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.700547, "o", "        res, err := drift.AnalyzeWithTopK(pos, *topK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.700612, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.700773, "o", "                outputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.700844, "o", "                return 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.70091, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.700977, "o", "        outputJSON(res)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.701043, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h> }'''\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4855.701108, "o", "\u001b[?2004h> s = re.sub(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.701288, "o", "    r'func runDriftAnalysis\\(args \\[\\]string\\) int \\{.*?\\n\\}\\n\\nfunc parseMixedArgs',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.701389, "o", "    new_run + '\\n\\nfunc parseMixedArgs',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.701455, "o", "    s,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4855.70152, "o", "    flags=re.S,\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> "]
