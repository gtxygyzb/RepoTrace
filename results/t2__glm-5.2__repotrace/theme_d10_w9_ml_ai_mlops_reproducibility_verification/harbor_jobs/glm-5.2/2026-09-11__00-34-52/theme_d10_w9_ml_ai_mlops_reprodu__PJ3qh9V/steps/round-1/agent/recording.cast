[4389.365582, "o", "     5\t\t\"crypto/sha256\"\r\n     6\t\t\"encoding/binary\"\r\n     7\t\t\"encoding/hex\"\r\n     8\t\t\"encoding/json\"\r\n     9\t\t\"fmt\"\r\n    10\t\t\"math\"\r\n    11\t\t\"os\"\r\n    12\t)\r\n    13\t\r\n    14\tconst (\r\n    15\t\tMagic      = \"MLCK\"\r\n    16\t\tVersion    = 1\r\n    17\t\tHeaderSize = 16\r\n    18\t\tFooterSize = 32\r\n"]
[4389.365656, "o", "    19\t)\r\n    20\t\r\n    21\ttype Dtype uint8\r\n    22\t\r\n    23\tconst (\r\n    24\t\tFloat32 Dtype = 0\r\n    25\t\tFloat64 Dtype = 1\r\n    26\t\tInt32   Dtype = 2\r\n    27\t\tInt64   Dtype = 3\r\n"]
