[1659.969856, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def run(args):\r\n\u001b[?2004l\r\u001b[?2004h>     p = subprocess.run(['./repro-verify'] + args, text=True, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h>     print('CMD:', ' '.join(args))\r\n\u001b[?2004l\r\u001b[?2004h>     print(p.stdout)\r\n\u001b[?2004l\r\u001b[?2004h>     if p.stderr:\r\n\u001b[?2004l\r\u001b[?2004h>         print('STDERR:', p.stderr.strip())\r\n\u001b[?2004l\r\u001b[?2004h> "]
