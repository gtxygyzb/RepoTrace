[3292.933519, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('internal/app/app.go')\ns = path.read_text()\n\nold_verify = '''func runVerifyCheckpoint(args []string) int {\n\\tif len(args) != 1 {\n\\t\\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify verify-checkpoint <file>\"})\n\\t\\treturn 1\n\\t}\n\n\\tcp, err := mlck.ParseFile(args[0])\n\\tif err != nil {\n\\t\\toutputJSON(map[string]interface{}{\n\\t\\t\\t\"valid\": false,\n\\t\\t\\t\"error\": err.Error(),\n\\t\\t})\n\\t\\treturn 1\n\\t}\n'''\n\nnew_verify = '''func runVerifyCheckpoint(args []string) int {\n\\tif len(args) != 1 {\n\\t\\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify verify-checkpoint <file>\"})\n\\t\\treturn 1\n\\t}\n\n\\tif _, err := os.ReadFile(args[0]); err != nil {\n\\t\\toutputJSON(map[string]interface{}{\"error\": err.Error()})\n\\t\\treturn 1\n\\t}\n\n\\tcp, err := mlck.ParseFile(args[0])\n\\tif err != nil {\n\\t\\toutputJSON(map[string]interface{}{\n\\t\\t\\t\"valid\": false,\n\\t\\t\\t\"error\": err.Error(),\n\\t\\t})\n\\t\\treturn 1\n\\t}\n'''\n\nold_validate = '''func runValidateManifest(args []stri"]
[3292.933803, "i", "ng) int {\n\\tif len(args) != 1 {\n\\t\\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify validate-manifest <file.toml>\"})\n\\t\\treturn 1\n\\t}\n\\tres := manifest.Validate(args[0])\n\\toutputJSON(res)\n\\tif res.Valid {\n\\t\\treturn 0\n\\t}\n\\treturn 1\n}\n'''\n\nnew_validate = '''func runValidateManifest(args []string) int {\n\\tif len(args) != 1 {\n\\t\\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify validate-manifest <file.toml>\"})\n\\t\\treturn 1\n\\t}\n\\tif _, err := os.ReadFile(args[0]); err != nil {\n\\t\\toutputJSON(map[string]interface{}{\"error\": err.Error()})\n\\t\\treturn 1\n\\t}\n\\tres := manifest.Validate(args[0])\n\\toutputJSON(res)\n\\tif res.Valid {\n\\t\\treturn 0\n\\t}\n\\treturn 1\n}\n'''\n\nif old_verify not in s:\n    print('verify block not found')\nelse:\n    s = s.replace(old_verify, new_verify)\n\nif old_validate not in s:\n    print('validate block not found')\nelse:\n    s = s.replace(old_validate, new_validate)\n\npath.write_text(s)\nPY\n"]
