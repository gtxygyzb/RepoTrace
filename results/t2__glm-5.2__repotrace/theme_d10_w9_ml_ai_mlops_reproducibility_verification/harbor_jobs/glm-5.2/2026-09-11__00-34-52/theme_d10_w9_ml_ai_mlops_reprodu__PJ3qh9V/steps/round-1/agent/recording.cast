[3661.879311, "o", "ls -la\r\n\u001b[?2004l\r"]
[3661.88261, "o", "total 3072\r\n"]
[3661.882702, "o", "drwxr-xr-x  1 root root    4096 Sep 10 17:37 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x  1 root root    4096 Sep 10 17:37 \u001b[01;34m..\u001b[0m\r\ndrwxr-xr-x  3 root root    4096 Sep 10 16:44 \u001b[01;34mcmd\u001b[0m\r\n"]
