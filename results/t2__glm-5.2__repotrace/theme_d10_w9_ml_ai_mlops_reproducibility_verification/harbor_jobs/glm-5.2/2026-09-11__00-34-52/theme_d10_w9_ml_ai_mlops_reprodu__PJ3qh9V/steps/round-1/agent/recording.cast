[5945.84046, "o", "\t\t\tif stability < 0 {\r\n   125\t\t\t\t\tstability = 0\r\n   126\t\t\t\t} else if stability > 1 {\r\n   127\t\t\t\t\tstability = 1\r\n   128\t\t\t\t}\r\n   129\t\t\t}\r\n   130\t\r\n   131\t\t\ttensors = append(tensors, TensorResult{\r\n   132\t\t\t\tName:           name,\r\n   133\t\t\t\tStepChanges:    steps,\r\n   134\t\t\t\tMeanChange:     mean,\r\n   135\t\t\t\tMaxChange:      max,\r\n   136\t\t\t\tConvergence:    convergence,\r\n   137\t\t\t\tStabilityScore: stability,\r\n   138\t\t\t})\r\n   139\t\r\n   140\t\t\tif convergence == \"converging\" {\r\n   141\t\t\t\tconverging++\r\n   142\t\t\t} else if convergence == \"diverging\" {"]
