[4221.599832, "o", "     8\t)\r\n     9\t\r\n    10\ttype DiffHistogram struct {\r\n    11\t\tExact   int `json:\"exact\"`\r\n    12\t\tLess1e7 int `json:\"<1e-7\"`\r\n    13\t\tLess1e5 int `json:\"<1e-5\"`\r\n    14\t\tLess1e3 int `json:\"<1e-3\"`\r\n    15\t\tLess1   int `json:\"<1\"`\r\n    16\t\tGeq1    int `json:\">=1\"`\r\n    17\t}\r\n    18\t\r\n    19\ttype TensorResult struct {\r\n    20\t\t"]
[4221.599911, "o", "Name          string         `json:\"name\"`\r\n    21\t\tMatch         bool           `json:\"match\"`\r\n    22\t\tMaxAbsDiff    float64        `json:\"max_abs_diff\"`\r\n    23\t\tMaxRelDiff    float64        `json:\"max_rel_diff\"`\r\n    24\t\tNumMismatches int            `json:\"num_mismatches\"`\r\n    25\t\tTotalElements int            `json:\"total_elements\"`\r\n"]
[4221.599978, "o", "    26\t\tShapeMismatch bool           `json:\"shape_mismatch\"`\r\n    27\t\tDiffHistogram *DiffHistogram `json:\"diff_histogram,omitempty\"`\r\n    28\t}\r\n    29\t\r\n    30\ttype Result struct {\r\n    31\t\tMatch            bool           `json:\"match\"`\r\n    32\t\tMode             string         `json:\"mode\"`\r\n    33\t\tAtol             float64        `json:\"atol\"`\r\n    34\t\tRtol             float64        `json:\"rtol\"`\r\n    35\t\tHistogramEnabled bool           `json:\"histogram_enabled,omitempty\"`\r\n    36\t\tTensorResults    []TensorResult `json:\"tensor_results\"`\r\n"]
[4221.600046, "o", "    37\t\tMissingInFile1   []string       `json:\"missing_in_file1\"`\r\n    38\t\tMissingInFile2   []string       `json:\"missing_in_file2\"`\r\n    39\t\tError            string         `json:\"error,omitempty\"`\r\n    40\t}\r\n    41\t\r\n    42\tfunc Compare(c1, c2 *mlck.Checkpoint, mode string, atol, rtol float64, histogram bool) (*Result, error) {\r\n    43\t\tif mode != \"strict\" && mode != \"relaxed\" {\r\n    44\t\t\treturn nil, fmt.Errorf(\"invalid mode %q\", mode)\r\n    45\t\t}\r\n    46\t\r\n    47\t\tresult := &Result{\r\n    48\t\t\tMatch:            true,\r\n"]
[4221.600112, "o", "    49\t\t\tMode:             mode,\r\n    50\t\t\tAtol:             atol,\r\n    51\t\t\tRtol:             rtol,\r\n    52\t\t\tHistogramEnabled: histogram,\r\n    53\t\t\tTensorResults:    []TensorResult{},\r\n    54\t\t\tMissingInFile1:   []string{},\r\n"]
[4221.600263, "o", "    55\t\t\tMissingInFile2:   []string{},\r\n    56\t\t}\r\n    57\t\r\n    58\t\tmap2 := make(map[string]mlck.Tensor)\r\n    59\t\tfor _, t := range c2.Tensors {\r\n    60\t\t\tmap2[t.Name] = t\r\n    61\t\t}\r\n    62\t\tmap1 := make(map[string]mlck.Tensor)\r\n    63\t\tfor _, t := range c1.Tensors {\r\n    64\t\t\tmap1[t.Name] = t\r\n    65\t\t}\r\n    66\t\r\n    67\t\tfor _, t1 := range c1.Tensors {\r\n    68\t\t\tt2, ok := map2[t1.Name]\r\n    69\t\t\tif !ok {\r\n    70\t\t\t\tresult.MissingInFile2 = append(result.MissingInFile2, t1.Name)\r\n    71\t\t\t\tcontinue\r\n    72\t\t\t}\r\n    73\t\t\ttr := compareTensors(t1, t2, mode, atol, rtol, histogram)\r\n    74"]
[4221.600361, "o", "\t\t\tresult.TensorResults = append(result.TensorResults, tr)\r\n    75\t\t\tif !tr.Match {\r\n    76\t\t\t\tresult.Match = false\r\n    77\t\t\t}\r\n    78\t\t}\r\n    79\t\r\n    80\t\tfor _, t := range c2.Tensors {\r\n    81\t\t\tif _, ok := map1[t.Name]; !ok {\r\n    82\t\t\t\tresult.MissingInFile1 = append(result.MissingInFile1, t.Name)\r\n    83\t\t\t}\r\n    84\t\t}\r\n    85\t\r\n    86\t\tif len(result.MissingInFile1) > 0 || len(result.MissingInFile2) > 0 {\r\n    87\t\t\tresult.Match = false\r\n    88\t\t}\r\n    89\t\r\n    90\t\treturn result, nil\r\n    91\t}"]
[4221.60046, "o", "\r\n    92\t\r\n    93\tfunc compareTensors(t1, t2 mlck.Tensor, mode string, atol, rtol float64, histogram bool) TensorResult {\r\n    94\t\ttotal := int(mlck.Product(t1.Shape))\r\n    95\t\r\n    96\t\ttr := TensorResult{\r\n    97\t\t\tName:          t1.Name,\r\n    98\t\t\tMatch:         true,\r\n    99\t\t\tMaxAbsDiff:    0,\r\n   100\t\t\tMaxRelDiff:    0,\r\n   101\t\t\tNumMismatches: 0,\r\n   102\t\t\tTotalElements: total,\r\n   103\t\t}\r\n   104\t\r\n"]
[4221.600538, "o", "   105\t\tif !shapesEqual(t1.Shape, t2.Shape) {\r\n   106\t\t\ttr.Match = false\r\n   107\t\t\ttr.ShapeMismatch = true\r\n   108\t\t\ttr.NumMismatches = total\r\n   109\t\t\treturn tr\r\n   110\t\t}\r\n   111\t\r\n   112\t\tif total == 0 {\r\n   113\t\t\tif histogram {\r\n"]
[4221.600597, "o", "   114\t\t\t\ttr.DiffHistogram = &DiffHistogram{}\r\n   115\t\t\t}\r\n   116\t\t\treturn tr\r\n   117\t\t}\r\n   118\t\r\n   119\t\tvals1, err := t1.Float64Values()\r\n   120\t\tif err != nil {\r\n   121\t\t\ttr.Match = false\r\n   122\t"]
[4221.600656, "o", "\t\ttr.NumMismatches = total\r\n   123\t\t\treturn tr\r\n   124\t\t}\r\n   125\t\tvals2, err := t2.Float64Values()\r\n   126\t\tif err != nil {\r\n   127\t\t\ttr.Match = false\r\n   128\t\t\ttr.NumMismatches = total\r\n   129\t\t\treturn tr\r\n   130\t\t}\r\n"]
[4221.60072, "o", "   131\t\r\n   132\t\tvar hist DiffHistogram\r\n   133\t\tthreshold := int(math.Floor(float64(total) * 0.001))\r\n   134\t\tfor i := 0; i < total; i++ {\r\n   135\t\t\ta := vals1[i]\r\n   136\t\t\tb := vals2[i]\r\n   137\t\t\tdiff := math.Abs(a - b)\r\n   138\t\t\tif diff > tr.MaxAbsDiff {\r\n"]
[4221.600778, "o", "   139\t\t\t\ttr.MaxAbsDiff = diff\r\n   140\t\t\t}\r\n   141\t\t\tvar rel float64\r\n   142\t\t\tif math.Abs(b) > 0 {\r\n   143\t\t\t\trel = diff / math.Abs(b)\r\n   144\t\t\t} else if diff > 0 {\r\n   145\t\t\t\trel = diff\r\n   146\t\t\t}\r\n"]
[4221.600837, "o", "   147\t\t\tif rel > tr.MaxRelDiff {\r\n   148\t\t\t\ttr.MaxRelDiff = rel\r\n   149\t\t\t}\r\n   150\t\t\tif diff > atol+rtol*math.Abs(b) {\r\n   151\t\t\t\ttr.NumMismatches++\r\n   152\t\t\t}\r\n   153\t\r\n   154\t\t\tswitch {\r\n   155\t\t\tcase diff == 0:\r\n   156\t\t\t\t"]
[4221.600893, "o", "hist.Exact++\r\n   157\t\t\tcase diff < 1e-7:\r\n   158\t\t\t\thist.Less1e7++\r\n   159\t\t\tcase diff < 1e-5:\r\n   160\t\t\t\thist.Less1e5++\r\n   161\t\t\tcase diff < 1e-3:\r\n   162\t\t\t\thist.Less1e3++\r\n   163\t\t\tcase diff < 1:\r\n   164\t\t"]
[4221.600949, "o", "\t\thist.Less1++\r\n   165\t\t\tdefault:\r\n   166\t\t\t\thist.Geq1++\r\n   167\t\t\t}\r\n   168\t\t}\r\n   169\t\r\n   170\t\tif histogram {\r\n   171\t\t\ttr.DiffHistogram = &hist\r\n"]
[4221.601005, "o", "   172\t\t}\r\n   173\t\r\n   174\t\tswitch mode {\r\n   175\t\tcase \"strict\":\r\n   176\t\t\ttr.Match = tr.NumMismatches == 0\r\n   177\t\tcase \"relaxed\":\r\n   178\t\t\ttr.Match = tr.NumMismatches <= threshold\r\n"]
