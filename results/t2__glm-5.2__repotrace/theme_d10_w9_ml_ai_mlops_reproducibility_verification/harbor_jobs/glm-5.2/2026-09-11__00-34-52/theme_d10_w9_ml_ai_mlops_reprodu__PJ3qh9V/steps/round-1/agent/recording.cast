[1227.98181, "o", "\u001b[?2004h> "]
[1227.981998, "o", "            arr = append(arr, item)\r\n\u001b[?2004l\r"]
[1227.982052, "o", "\u001b[?2004h> "]
[1227.982166, "o", "            parent[last] = arr\r\n\u001b[?2004l\r"]
[1227.98222, "o", "\u001b[?2004h> "]
[1227.982332, "o", "            current = item\r\n\u001b[?2004l\r"]
[1227.982389, "o", "\u001b[?2004h> "]
[1227.982497, "o", "            currentArray = arr\r\n\u001b[?2004l\r"]
[1227.982553, "o", "\u001b[?2004h> "]
[1227.982625, "o", "            continue\r\n\u001b[?2004l\r"]
[1227.98268, "o", "\u001b[?2004h> "]
[1227.982734, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1227.982792, "o", "\u001b[?2004h> "]
[1227.983097, "o", "        if strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\")) {\r\n\u001b[?2004l\r"]
[1227.983152, "o", "\u001b[?2004h> "]
[1227.983389, "o", "            key := strings.TrimSpace(line[1 : len(line)-1])\r\n\u001b[?2004l\r"]
[1227.983444, "o", "\u001b[?2004h> "]
[1227.983612, "o", "            parts := strings.Split(key, \".\")\r\n\u001b[?2004l\r"]
[1227.983667, "o", "\u001b[?2004h> "]
[1227.983765, "o", "            parent := root\r\n\u001b[?2004l\r"]
[1227.983821, "o", "\u001b[?2004h> "]
[1227.984002, "o", "            for i := 0; i < len(parts)-1; i++ {\r\n\u001b[?2004l\r"]
[1227.984058, "o", "\u001b[?2004h> "]
[1227.984246, "o", "                p := strings.TrimSpace(parts[i])\r\n\u001b[?2004l\r"]
[1227.984301, "o", "\u001b[?2004h> "]
[1227.984458, "o", "                next, ok := parent[p]\r\n\u001b[?2004l\r"]
[1227.984514, "o", "\u001b[?2004h> "]
[1227.98461, "o", "                if !ok {\r\n\u001b[?2004l\r"]
[1227.984665, "o", "\u001b[?2004h> "]
[1227.984861, "o", "                    next = map[string]interface{}{}\r\n\u001b[?2004l\r"]
[1227.984916, "o", "\u001b[?2004h> "]
[1227.985055, "o", "                    parent[p] = next\r\n\u001b[?2004l\r"]
[1227.98511, "o", "\u001b[?2004h> "]
[1227.985171, "o", "                }\r\n\u001b[?2004l\r"]
[1227.985234, "o", "\u001b[?2004h> "]
[1227.985456, "o", "                parent, ok = next.(map[string]interface{})\r\n\u001b[?2004l\r"]
[1227.985512, "o", "\u001b[?2004h> "]
[1227.985602, "o", "                if !ok {\r\n\u001b[?2004l\r"]
[1227.985658, "o", "\u001b[?2004h> "]
[1227.985983, "o", "                    return nil, fmt.Errorf(\"line %d: invalid table path\", lineNum+1)\r\n\u001b[?2004l\r"]
[1227.986038, "o", "\u001b[?2004h> "]
[1227.986102, "o", "                }\r\n\u001b[?2004l\r"]
[1227.986158, "o", "\u001b[?2004h> "]
[1227.986217, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1227.986289, "o", "> "]
[1227.986486, "o", "            last := strings.TrimSpace(parts[len(parts)-1])\r\n\u001b[?2004l\r"]
[1227.986541, "o", "\u001b[?2004h> "]
[1227.986775, "o", "            tbl, ok := parent[last].(map[string]interface{})\r\n\u001b[?2004l\r"]
[1227.98683, "o", "\u001b[?2004h> "]
[1227.986903, "o", "            if !ok {\r\n\u001b[?2004l\r"]
[1227.986959, "o", "\u001b[?2004h> "]
