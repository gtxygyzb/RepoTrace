[3744.742842, "o", "    45\t\t\t\tif !seen[t.Name] {\r\n    46\t\t\t\t\tseen[t.Name] = true\r\n    47\t\t\t\t\tallNames = append(allNames, t.Name)\r\n    48\t\t\t\t}\r\n    49\t\t\t}\r\n    50\t\t}\r\n    51\t\r\n    52\t\tskipped := []string{}\r\n"]
[3744.742903, "o", "    53\t\ttensors := []TensorResult{}\r\n    54\t\tconverging := 0\r\n    55\t\tdiverging := 0\r\n    56\t\r\n    57\t\tfor _, name := range allNames {\r\n    58\t\t\tok := true\r\n    59\t\t\tvar shape []uint32\r\n    60\t\t\tfor _, cp := range cps {\r\n    61"]
[3744.742964, "o", "\t\t\t\tt, exists := tensorByName(cp, name)\r\n    62\t\t\t\tif !exists {\r\n    63\t\t\t\t\tok = false\r\n    64\t\t\t\t\tbreak\r\n    65\t\t\t\t}\r\n    66\t\t\t\tif shape == nil {\r\n    67\t\t\t\t\tshape = t.Shape\r\n    68\t\t\t\t} else if !shapesEqual(shape, t.Shape) {\r\n    69\t\t"]
