[5860.03988, "o", "     1\tpackage drift\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"math\"\r\n     6\t\t"]
[5860.039959, "o", "\"sort\"\r\n     7\t\r\n     8\t\t\"repro-verify/internal/mlck\"\r\n     9\t)\r\n    10\t\r\n    11\ttype TensorResult struct {\r\n    12\t\tName           string    `json:\"name\"`\r\n    13\t\tStepChanges    []float64 `json:\"step_changes\"`\r\n    14\t\tMeanChange     float64   `json:\"mean_change\"`\r\n    15\t\tMaxChange      float64   `json:\"max_change\"`\r\n    16\t\tConvergence    string    `json:\"convergence\"`\r\n"]
[5860.040046, "o", "    17\t\tStabilityScore float64   `json:\"stability_score\"`\r\n    18\t\tDrifting       *bool     `json:\"drifting,omitempty\"`\r\n    19\t}\r\n    20\t\r\n    21\ttype Result struct {\r\n    22\t\tNumSnapshots       int            `json:\"num_snapshots\"`\r\n    23\t\tNumAnalyzedTensors int            `json:\"num_analyzed_tensors\"`\r\n"]
[5860.040129, "o", "    24\t\tSkippedTensors     []string       `json:\"skipped_tensors\"`\r\n    25\t\tTensors            []TensorResult `json:\"tensors\"`\r\n    26\t\tOverallConvergence string         `json:\"overall_convergence\"`\r\n    27\t\tTopK               *int           `json:\"top_k,omitempty\"`\r\n    28\t\tDriftThreshold     *float64       `json:\"drift_threshold,omitempty\"`\r\n    29\t\tNumDriftingTensors *int           `json:\"num_drifting_tensors,omitempty\"`\r\n    30\t}\r\n    31\t\r\n    32\t// Analyze remains available for callers that do not need a top-k restriction.\r\n    33\tfunc Analyze(files []string) (*Result, error) {\r\n    34\t\treturn AnalyzeWithTopK(files, nil, nil)\r\n    35\t}\r\n"]
[5860.040211, "o", "    36\t\r\n    37\t// AnalyzeWithTopK analyzes drift and optionally restricts the returned tensor\r\n    38\t// list to the N tensors with the lowest stability scores. When topK > 0 the\r\n    39\t// result includes a top_k field set to the requested N, even if fewer tensors\r\n    40\t// are returned. When threshold is non-nil, each tensor result includes a\r\n    41\t// drifting field, and the top-level result includes drift_threshold and\r\n    42\t// num_drifting_tensors. The count reflects all analyzed tensors, not just those\r\n    43\t// returned after top-k filtering.\r\n    44\tfunc AnalyzeWithTopK(files []string, topK *int, threshold *float64) (*Result, error) {\r\n    45\t\tif len(files) < 2 {\r\n    46\t\t\treturn nil, fmt.Errorf(\"at least 2 input files required\")\r\n    47\t\t}\r\n    48\t\r\n    49\t\tcps := make([]*mlck.Checkpoint, len(files))\r\n    50\t\tfor i, f := range files {\r\n    51\t\t\tcp, err := mlck.ParseFile(f)\r\n"]
[5860.040323, "o", "    52\t\t\tif err != nil {\r\n    53\t\t\t\treturn nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n    54\t\t\t}\r\n    55\t\t\tcps[i] = cp\r\n    56\t\t}\r\n    57\t\r\n    58\t\tvar allNames []string\r\n    59\t\tseen := map[string]bool{}\r\n    60\t\tfor _, cp := range cps {\r\n    61\t\t\tfor _, t := range cp.Tensors {\r\n    62\t\t\t\tif !seen[t.Name] {\r\n    63\t\t\t\t\tseen[t.Name] = true\r\n    64\t\t\t\t\tallNames = append(allNames, t.Name)\r\n    65\t\t\t\t}\r\n    66\t\t\t}\r\n    67\t\t}"]
[5860.040383, "o", "\r\n    68\t\tsort.Strings(allNames)\r\n    69\t\r\n    70\t\tskipped := []string{}\r\n    71\t\ttensors := []TensorResult{}\r\n    72\t\tconverging := 0\r\n    73\t\tdiverging := 0\r\n    74\t\r\n    75\t\tfor _, name := range allNames {\r\n    76\t\t"]
[5860.040459, "o", "\tok := true\r\n    77\t\t\tvar shape []uint32\r\n    78\t\t\tfor _, cp := range cps {\r\n    79\t\t\t\tt, exists := tensorByName(cp, name)\r\n    80\t\t\t\tif !exists {\r\n    81\t\t\t\t\tok = false\r\n    82\t\t\t\t\tbreak\r\n    83\t\t\t\t}\r\n    84\t\t\t\tif shape == nil {\r\n    85\t\t\t\t\tshape = t.Shape\r\n    86\t\t\t\t} else if !shapesEqual(shape, t.Shape) {\r\n    87\t\t\t\t\t"]
[5860.040529, "o", "ok = false\r\n    88\t\t\t\t\tbreak\r\n    89\t\t\t\t}\r\n    90\t\t\t}\r\n    91\t\t\tif !ok {\r\n    92\t\t\t\tskipped = append(skipped, name)\r\n    93\t\t\t\tcontinue\r\n    94\t\t\t}\r\n    95\t\r\n    96\t\t"]
[5860.040601, "o", "\tsteps := make([]float64, len(cps)-1)\r\n    97\t\t\tfor i := 0; i < len(steps); i++ {\r\n    98\t\t\t\tv1, err := tensorData(cps[i], name)\r\n    99\t\t\t\tif err != nil {\r\n   100\t\t\t\t\treturn nil, err\r\n   101\t\t\t\t}\r\n   102\t\t\t\tv2, err := tensorData(cps[i+1], name)\r\n   103\t\t\t\tif err != nil {\r\n   104\t\t\t\t\treturn nil, err\r\n   105\t\t\t\t}\r\n   106\t\t\t\tn := len(v1)\r\n   107\t\t\t\tif n == 0 {\r\n"]
[5860.040673, "o", "   108\t\t\t\t\tsteps[i] = 0\r\n   109\t\t\t\t\tcontinue\r\n   110\t\t\t\t}\r\n   111\t\t\t\tvar sum float64\r\n   112\t\t\t\tfor j := 0; j < n; j++ {\r\n   113\t\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n   114\t\t\t\t}\r\n   115\t\t\t\tsteps[i] = sum / float64(n)\r\n   116\t\t\t}\r\n   117\t\r\n   118\t\t\tmean := meanFloat64(steps)\r\n"]
[5860.040746, "o", "   119\t\t\tmax := maxFloat64(steps)\r\n   120\t\t\tconvergence := classifyConvergence(steps)\r\n"]
