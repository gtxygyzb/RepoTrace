[2945.412666, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\npath = Path('internal/manifest/manifest.go')\ns = path.read_text()\n\nstart = s.index('func parseTOML(')\nend = s.index('func parseTOMLValue', start)\n\nnew = '''func parseTOML(data string) (map[string]interface{}, error) {\n\\troot := map[string]interface{}{}\n\\tvar current map[string]interface{} = root\n\\tvar currentArray []map[string]interface{}\n\n\\tlines := strings.Split(data, \"\\\\n\")\n\\tfor lineNum, raw := range lines {\n\\t\\tline := strings.TrimSpace(stripInlineComment(raw))\n\\t\\tif line == \"\" || strings.HasPrefix(line, \"#\") {\n\\t\\t\\tcontinue\n\\t\\t}\n\n\\t\\tif strings.HasPrefix(line, \"[[\") && strings.HasSuffix(line, \"]]\\\") {\n\\t\\t\\tkey := strings.TrimSpace(line[2 : len(line)-2])\n\\t\\t\\tparts := strings.Split(key, \".\")\n\\t\\t\\tparent := root\n\\t\\t\\tfor i := 0; i < len(parts)-1; i++ {\n\\t\\t\\t\\tp := strings.TrimSpace(parts[i])\n\\t\\t\\t\\tnext, ok := parent[p]\n\\t\\t\\t\\tif !ok {\n\\t\\t\\t\\t\\tnext = map[string]interface{}{}\n\\t\\t\\t\\t\\tparent[p] = next\n\\t\\t\\t\\t}\n\\t\\t\\t\\tparent, ok = next.(map[string]in"]
[2945.412956, "i", "terface{})\n\\t\\t\\t\\tif !ok {\n\\t\\t\\t\\t\\treturn nil, fmt.Errorf(\"line %d: invalid array table path\", lineNum+1)\n\\t\\t\\t\\t}\n\\t\\t\\t}\n\\t\\t\\tlast := strings.TrimSpace(parts[len(parts)-1])\n\\t\\t\\tarr, ok := parent[last].([]map[string]interface{})\n\\t\\t\\tif !ok {\n\\t\\t\\t\\tarr = []map[string]interface{}{}\n\\t\\t\\t}\n\\t\\t\\titem := map[string]interface{}{}\n\\t\\t\\tarr = append(arr, item)\n\\t\\t\\tparent[last] = arr\n\\t\\t\\tcurrent = item\n\\t\\t\\tcurrentArray = arr\n\\t\\t\\tcontinue\n\\t\\t}\n\n\\t\\tif strings.HasPrefix(line, \"[\") && strings.HasSuffix(line, \"]\") {\n\\t\\t\\tkey := strings.TrimSpace(line[1 : len(line)-1])\n\\t\\t\\tparts := strings.Split(key, \".\")\n\\t\\t\\tparent := root\n\\t\\t\\tfor i := 0; i < len(parts)-1; i++ {\n\\t\\t\\t\\tp := strings.TrimSpace(parts[i])\n\\t\\t\\t\\tnext, ok := parent[p]\n\\t\\t\\t\\tif !ok {\n\\t\\t\\t\\t\\tnext = map[string]interface{}{}\n\\t\\t\\t\\t\\tparent[p] = next\n\\t\\t\\t\\t}\n\\t\\t\\t\\tparent, ok = next.(map[string]interface{})\n\\t\\t\\t\\tif !ok {\n\\t\\t\\t\\t\\treturn nil, fmt.Errorf(\"line %d: invalid table path\", lineNum+1)\n\\t\\t\\t\\t}\n\\t\\t\\t}\n\\t\\t\\tl"]
[2945.41299, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[2945.413124, "i", "ast := strings.TrimSpace(parts[len(parts)-1])\n\\t\\t\\ttbl, ok := parent[last].(map[string]interface{})\n\\t\\t\\tif !ok {\n\\t\\t\\t\\ttbl = map[string]interface{}{}\n\\t\\t\\t\\tparent[last] = tbl\n\\t\\t\\t}\n\\t\\t\\tcurrent = tbl\n\\t\\t\\tcurrentArray = nil\n\\t\\t\\tcontinue\n\\t\\t}\n\n\\t\\teq := strings.Index(line, \"=\")\n\\t\\tif eq < 0 {\n\\t\\t\\treturn nil, fmt.Errorf(\"line %d: expected key = value\", lineNum+1)\n\\t\\t}\n\\t\\tkeyPath := strings.Split(strings.TrimSpace(line[:eq]), \".\")\n\\t\\tvalueStr := strings.TrimSpace(line[eq+1:])\n\\t\\tvalue, err := parseTOMLValue(valueStr)\n\\t\\tif err != nil {\n\\t\\t\\treturn nil, fmt.Errorf(\"line %d: %v\", lineNum+1, err)\n\\t\\t}\n\\t\\t_ = currentArray\n\n\\t\\tparent := current\n\\t\\tfor i := 0; i < len(keyPath)-1; i++ {\n\\t\\t\\tpart := strings.TrimSpace(keyPath[i])\n\\t\\t\\tif part == \"\" {\n\\t\\t\\t\\treturn nil, fmt.Errorf(\"line %d: invalid key\", lineNum+1)\n\\t\\t\\t}\n\\t\\t\\tnext, ok := parent[part]\n\\t\\t\\tif !ok {\n\\t\\t\\t\\tnext = map[string]interface{}{}\n\\t\\t\\t\\tparent[part] = next\n\\t\\t\\t\\tparent = next.(map[string]interface{})\n\\t\\t\\t} el"]
[2945.413148, "o", "> "]
[2945.41333, "i", "se {\n\\t\\t\\t\\tparent, ok = next.(map[string]interface{})\n\\t\\t\\t\\tif !ok {\n\\t\\t\\t\\t\\treturn nil, fmt.Errorf(\"line %d: invalid key path\", lineNum+1)\n\\t\\t\\t\\t}\n\\t\\t\\t}\n\\t\\t}\n\\t\\tlastKey := strings.TrimSpace(keyPath[len(keyPath)-1])\n\\t\\tif lastKey == \"\" {\n\\t\\t\\treturn nil, fmt.Errorf(\"line %d: invalid key\", lineNum+1)\n\\t\\t}\n\\t\\tparent[lastKey] = value\n\\t}\n\n\\treturn root, nil\n}\n\nfunc stripInlineComment(line string) string {\n\\tvar quote byte\n\\tdepth := 0\n\\tfor i := 0; i < len(line); i++ {\n\\t\\tc := line[i]\n\\t\\tif quote != 0 {\n\\t\\t\\tif c == quote {\n\\t\\t\\t\\tquote = 0\n\\t\\t\\t}\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tswitch c {\n\\t\\tcase '\"', '\\'':\n\\t\\t\\tquote = c\n\\t\\tcase '[', '{':\n\\t\\t\\tdepth++\n\\t\\tcase ']', '}':\n\\t\\t\\tif depth > 0 {\n\\t\\t\\t\\tdepth--\n\\t\\t\\t}\n\\t\\tcase '#':\n\\t\\t\\tif depth == 0 {\n\\t\\t\\t\\treturn line[:i]\n\\t\\t\\t}\n\\t\\t}\n\\t}\n\\treturn line\n}\n\n'''\n\ns = s[:start] + new + s[end:]\npath.write_text(s)\nPY\n"]
