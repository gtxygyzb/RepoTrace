[4309.105961, "o", "   244\t\tvar positional []string\r\n   245\t\tvar flagArgs []string\r\n   246\t\r\n   247\t\tfor i := 0; i < len(args); i++ {\r\n   248\t\t\targ := args[i]\r\n   249\t\t\tif arg == \"--\" {\r\n   250\t\t\t\tpositional = append(positional, args[i+1:]...)\r\n"]
[4309.106025, "o", "   251\t\t\t\tbreak\r\n   252\t\t\t}\r\n   253\t\t\tif strings.HasPrefix(arg, \"--\") {\r\n   254\t\t\t\tif strings.Contains(arg, \"=\") {\r\n   255\t\t\t\t\tflagArgs = append(flagArgs, arg)\r\n   256\t\t\t\t\tcontinue\r\n   257\t\t\t\t}\r\n   258\t\t\t\tif isBoolFlag(fs, arg) {\r\n   259\t\t\t\t\t"]
[4309.106088, "o", "flagArgs = append(flagArgs, arg+\"=true\")\r\n   260\t\t\t\t\tcontinue\r\n   261\t\t\t\t}\r\n   262\t\t\t\tif i+1 >= len(args) {\r\n   263\t\t\t\t\treturn nil, fmt.Errorf(\"flag %s requires a value\", arg)\r\n   264\t\t\t\t}\r\n   265\t\t\t\tflagArgs = append(flagArgs, arg+\"=\"+args[i+1])\r\n"]
[4309.106155, "o", "   266\t\t\t\ti++\r\n   267\t\t\t} else {\r\n   268\t\t\t\tpositional = append(positional, arg)\r\n   269\t\t\t}\r\n   270\t\t}\r\n   271\t\r\n   272\t\tif err := fs.Parse(flagArgs); err != nil {\r\n   273\t\t\treturn nil, err\r\n   274\t\t}\r\n   275\t\treturn positional, nil\r\n   276\t}\r\n   277\t\r\n   278"]
[4309.106223, "o", "\tfunc isBoolFlag(fs *flag.FlagSet, arg string) bool {\r\n   279\t\tname := strings.TrimPrefix(arg, \"--\")\r\n   280\t\tif i := strings.IndexByte(name, '='); i >= 0 {\r\n   281\t\t\tname = name[:i]\r\n   282\t\t}\r\n   283\t\tf := fs.Lookup(name)\r\n   284\t\tif f == nil {\r\n"]
[4309.106294, "o", "   285\t\t\treturn false\r\n   286\t\t}\r\n   287\t\ttype boolFlag interface {\r\n   288\t\t\tIsBoolFlag() bool\r\n   289\t\t}\r\n   290\t\tbf, ok := f.Value.(boolFlag)\r\n   291\t\treturn ok && bf.IsBoolFlag()\r\n   292\t}\r\n"]
