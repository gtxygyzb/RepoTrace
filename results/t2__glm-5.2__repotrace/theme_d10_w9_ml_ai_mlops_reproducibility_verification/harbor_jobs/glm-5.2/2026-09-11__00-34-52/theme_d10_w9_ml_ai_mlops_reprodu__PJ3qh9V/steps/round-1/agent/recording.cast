[4280.189795, "o", "    17\t}\r\n    18\t\r\n    19\ttype TensorResult struct {\r\n    20\t\tName          string         `json:\"name\"`\r\n    21\t\tMatch         bool           `json:\"match\"`\r\n    22\t\tMaxAbsDiff    float64        `json:\"max_abs_diff\"`\r\n    23\t\tMaxRelDiff    float64        `json:\"max_rel_diff\"`\r\n    24\t\tNumMismatches int            `json:\"num_mismatches\"`\r\n    25\t\tTotalElements int            `json:\"total_elements\"`\r\n    26\t\tShapeMismatch bool           `json:\"shape_mismatch\"`\r\n    27\t\tDiffHistogram *DiffHistogram `json:\"diff_histogram,omitempty\"`\r\n    28\t}\r\n    29\t\r\n    30\ttype Result struct {\r\n"]
[4280.189863, "o", "    31\t\tMatch            bool           `json:\"match\"`\r\n    32\t\tMode             string         `json:\"mode\"`\r\n    33\t\tAtol             float64        `json:\"atol\"`\r\n    34\t\tRtol             float64        `json:\"rtol\"`\r\n    35\t\tHistogramEnabled bool           `json:\"histogram_enabled,omitempty\"`\r\n    36\t\tTensorResults    []TensorResult `json:\"tensor_results\"`\r\n    37\t\tMissingInFile1   []string       `json:\"missing_in_file1\"`\r\n    38\t\tMissingInFile2   []string       `json:\"missing_in_file2\"`\r\n    39\t\tError            string         `json:\"error,omitempty\"`\r\n    40\t}\r\n"]
[4280.189979, "o", "    41\t\r\n    42\tfunc Compare(c1, c2 *mlck.Checkpoint, mode string, atol, rtol float64, histogram bool) (*Result, error) {\r\n    43\t\tif mode != \"strict\" && mode != \"relaxed\" {\r\n    44\t\t\treturn nil, fmt.Errorf(\"invalid mode %q\", mode)\r\n    45\t\t}\r\n    46\t\r\n    47\t\tresult := &Result{\r\n    48\t\t\tMatch:            true,\r\n    49\t\t\tMode:             mode,\r\n    50\t\t\tAtol:             atol,\r\n    51\t\t\tRtol:             rtol,\r\n    52\t\t\tHistogramEnabled: histogram,\r\n    53\t\t\tTensorResults:    []TensorResult{},\r\n    54\t\t\tMissingInFile1:   []string{},\r\n    55\t\t\tMissingInFile2:   []string{},\r\n    56\t\t}\r\n"]
[4280.190048, "o", "    57\t\r\n    58\t\tmap2 := make(map[string]mlck.Tensor)\r\n    59\t\tfor _, t := range c2.Tensors {\r\n    60\t\t\tmap2[t.Name] = t\r\n    61\t\t}\r\n    62\t\tmap1 := make(map[string]mlck.Tensor)\r\n    63\t\tfor _, t := range c1.Tensors {\r\n    64\t\t\tmap1[t.Name] = t\r\n    65\t\t}\r\n"]
[4280.190108, "o", "    66\t\r\n    67\t\tfor _, t1 := range c1.Tensors {\r\n    68\t\t\tt2, ok := map2[t1.Name]\r\n    69\t\t\tif !ok {\r\n    70\t\t\t\tresult.MissingInFile2 = append(result.MissingInFile2, t1.Name)\r\n    71\t\t\t\tcontinue\r\n    72\t\t\t}\r\n    73\t\t\ttr := compareTensors(t1, t2, mode, atol, rtol, histogram)\r\n"]
[4280.190169, "o", "    74\t\t\tresult.TensorResults = append(result.TensorResults, tr)\r\n    75\t\t\tif !tr.Match {\r\n    76\t\t\t\tresult.Match = false\r\n    77\t\t\t}\r\n    78\t\t}\r\n    79\t\r\n    80\t\tfor _, t := range c2.Tensors {\r\n    81\t\t\tif _, ok := map1[t.Name]; !ok {\r\n    82\t\t\t\tresult.MissingInFile1 = append(result.MissingInFile1, t.Name)\r\n    83\t\t\t}\r\n    84\t\t}\r\n"]
[4280.190271, "o", "    85\t\r\n    86\t\tif len(result.MissingInFile1) > 0 || len(result.MissingInFile2) > 0 {\r\n    87\t\t\tresult.Match = false\r\n    88\t\t}\r\n    89\t\r\n    90\t\treturn result, nil\r\n    91\t}\r\n    92\t\r\n    93\tfunc compareTensors(t1, t2 mlck.Tensor, mode string, atol, rtol float64, histogram bool) TensorResult {\r\n    94\t\ttotal := int(mlck.Product(t1.Shape))\r\n"]
[4280.190365, "o", "    95\t\r\n    96\t\ttr := TensorResult{\r\n    97\t\t\tName:          t1.Name,\r\n    98\t\t\tMatch:         true,\r\n    99\t\t\tMaxAbsDiff:    0,\r\n   100\t\t\tMaxRelDiff:    0,\r\n   101\t\t\tNumMismatches: 0,\r\n   102\t\t\tTotalElements: total,\r\n   103\t\t}\r\n   104\t\r\n   105\t\tif !shapesEqual(t1.Shape, t2.Shape) {\r\n   106\t\t\ttr.Match = false\r\n   107\t\t\ttr.ShapeMismatch = true\r\n   108\t\t\ttr.NumMismatches = total\r\n   109\t\t\treturn tr\r\n"]
[4280.19045, "o", "   110\t\t}\r\n   111\t\r\n   112\t\tif total == 0 {\r\n   113\t\t\tif histogram {\r\n   114\t\t\t\ttr.DiffHistogram = &DiffHistogram{}\r\n   115\t\t\t}\r\n   116\t\t\treturn tr\r\n   117\t\t}\r\n   118\t\r\n   119\t\tvals1, err := t1.Float64Values()\r\n   120\t\tif err != nil {\r\n"]
