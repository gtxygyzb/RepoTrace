[4613.923606, "i", "sed -n '1,240p' internal/drift/drift.go\n"]
[4613.924025, "o", "sed -n '1,240p' internal/drift/drift.go\r\n\u001b[?2004l\r"]
[4613.927051, "o", "package drift\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"sort\"\r\n\r\n"]
[4613.927191, "o", "\t\"repro-verify/internal/mlck\"\r\n)\r\n\r\ntype TensorResult struct {\r\n\tName           string    `json:\"name\"`\r\n\tStepChanges    []float64 `json:\"step_changes\"`\r\n\tMeanChange     float64   `json:\"mean_change\"`\r\n\tMaxChange      float64   `json:\"max_change\"`\r\n"]
[4613.927324, "o", "\tConvergence    string    `json:\"convergence\"`\r\n\tStabilityScore float64   `json:\"stability_score\"`\r\n}\r\n\r\ntype Result struct {\r\n\tNumSnapshots       int            `json:\"num_snapshots\"`\r\n\tNumAnalyzedTensors int            `json:\"num_analyzed_tensors\"`\r\n\tSkippedTensors     []string       `json:\"skipped_tensors\"`\r\n\tTensors            []TensorResult `json:\"tensors\"`\r\n\tOverallConvergence string         `json:\"overall_convergence\"`\r\n}\r\n\r\nfunc Analyze(files []string) (*Result, error) {\r\n\tif len(files) < 2 {\r\n\t\treturn nil, fmt.Errorf(\"at least 2 input files required\")\r\n\t}\r\n\r\n\tcps := make([]*mlck.Checkpoint, len(files))\r\n\tfor i, f := range files {\r\n\t\tcp, err := mlck.ParseFile(f)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n\t\t}\r\n\t\tcps[i] = cp\r\n\t}\r\n\r\n\tvar allNames []string\r\n\tseen := map[string]bool{}\r\n\tfor _, cp := range cps {\r\n\t\tfor _, t := range cp.Tensors {\r\n\t\t\tif !seen[t.Name] {\r\n\t\t\t\tseen[t.Name] = true\r\n\t\t\t\tallNames = append(allNames, t.Name)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tsort.Strings(allNames)\r\n\r\n\tskip"]
[4613.927402, "o", "ped := []string{}\r\n\ttensors := []TensorResult{}\r\n\tconverging := 0\r\n\tdiverging := 0\r\n\r\n\tfor _, name := range allNames {\r\n\t\tok := true\r\n\t\tvar shape []uint32\r\n\t\tfor _, cp := range cps {\r\n\t\t\tt, exists := tensorByName(cp, name)\r\n\t\t\tif !exists {\r\n\t\t\t\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\tif shape == nil {\r\n\t\t\t\tshape = t.Shape\r\n\t\t\t} else if !shapesEqual(shape, t.Shape) {\r\n"]
[4613.927466, "o", "\t\t\t\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif !ok {\r\n\t\t\tskipped = append(skipped, name)\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tsteps := make([]float64, len(cps)-1)\r\n\t\tfor i := 0; i < len(cps)-1; i++ {\r\n\t\t\tt1, _ := tensorByName(cps[i], name)\r\n"]
[4613.927525, "o", "\t\t\tt2, _ := tensorByName(cps[i+1], name)\r\n\t\t\tv1, err := t1.Float64Values()\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tv2, err := t2.Float64Values()\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tn := len(v1)\r\n"]
[4613.927583, "o", "\t\t\tif n == 0 {\r\n\t\t\t\tsteps[i] = 0\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvar sum float64\r\n\t\t\tfor j := 0; j < n; j++ {\r\n\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n\t\t\t}\r\n\t\t\tsteps[i] = sum / float64(n)\r\n\t\t}\r\n"]
[4613.92764, "o", "\r\n\t\tmean := meanFloat64(steps)\r\n\t\tmax := maxFloat64(steps)\r\n\t\tconvergence := classifyConvergence(steps)\r\n\t\tstability := 1.0\r\n\t\tif steps[0] != 0 {\r\n\t\t\tstability = 1.0 - steps[len(steps)-1]/steps[0]\r\n\t\t\tif stability < 0 {\r\n\t\t\t\tstability = 0\r\n\t\t\t} else if stability > 1 {\r\n\t\t\t\tstability = 1\r\n"]
[4613.927705, "o", "\t\t\t}\r\n\t\t}\r\n\r\n\t\ttensors = append(tensors, TensorResult{\r\n\t\t\tName:           name,\r\n\t\t\tStepChanges:    steps,\r\n\t\t\tMeanChange:     mean,\r\n\t\t\tMaxChange:      max,\r\n\t\t\tConvergence:    convergence,\r\n\t\t\tStabilityScore: stability,\r\n\t\t})\r\n\r\n"]
[4613.927768, "o", "\t\tif convergence == \"converging\" {\r\n\t\t\tconverging++\r\n\t\t} else if convergence == \"diverging\" {\r\n\t\t\tdiverging++\r\n\t\t}\r\n\t}\r\n\r\n\toverall := \"mixed\"\r\n\tif converging > len(tensors)/2 {\r\n\t\toverall = \"converging\"\r\n\t} else if diverging > len(tensors)/2 {\r\n"]
[4613.927824, "o", "\t\toverall = \"diverging\"\r\n\t}\r\n\r\n\tsort.Strings(skipped)\r\n\tsort.Slice(tensors, func(i, j int) bool {\r\n\t\treturn tensors[i].Name < tensors[j].Name\r\n\t})\r\n\r\n\treturn &Result{\r\n\t\tNumSnapshots:       len(files),\r\n"]
[4613.927886, "o", "\t\tNumAnalyzedTensors: len(tensors),\r\n\t\tSkippedTensors:     skipped,\r\n\t\tTensors:            tensors,\r\n\t\tOverallConvergence: overall,\r\n\t}, nil\r\n}\r\n\r\nfunc tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {\r\n\tfor _, t := range cp.Tensors {\r\n\t\tif t.Name == name {\r\n\t\t\treturn t, true\r\n\t\t}\r\n"]
[4613.927949, "o", "\t}\r\n\treturn mlck.Tensor{}, false\r\n}\r\n\r\nfunc shapesEqual(a, b []uint32) bool {\r\n\tif len(a) != len(b) {\r\n\t\treturn false\r\n\t}\r\n\tfor i := range a {\r\n\t\tif a[i] != b[i] {\r\n\t\t\treturn false\r\n\t\t}\r\n"]
[4613.928004, "o", "\t}\r\n\treturn true\r\n}\r\n\r\nfunc meanFloat64(xs []float64) float64 {\r\n\tif len(xs) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tvar sum float64\r\n\tfor _, x := range xs {\r\n\t\tsum += x\r\n"]
[4613.928066, "o", "\t}\r\n\treturn sum / float64(len(xs))\r\n}\r\n\r\nfunc maxFloat64(xs []float64) float64 {\r\n\tif len(xs) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tm := xs[0]\r\n\tfor _, x := range xs[1:] {\r\n\t\tif x > m {\r\n"]
[4613.928126, "o", "\t\t\tm = x\r\n\t\t}\r\n\t}\r\n\treturn m\r\n}\r\n\r\nfunc classifyConvergence(steps []float64) string {\r\n\tif len(steps) <= 1 {\r\n\t\treturn \"converging\"\r\n\t}\r\n\tdecreasing := true\r\n\tincreasing := true\r\n"]
[4613.928185, "o", "\tfor i := 1; i < len(steps); i++ {\r\n\t\tif steps[i] >= steps[i-1] {\r\n\t\t\tdecreasing = false\r\n\t\t}\r\n\t\tif steps[i] <= steps[i-1] {\r\n\t\t\tincreasing = false\r\n\t\t}\r\n\t}\r\n\tif decreasing {\r\n\t\treturn \"converging\"\r\n\t}\r\n"]
[4613.928274, "o", "\tif increasing {\r\n\t\treturn \"diverging\"\r\n\t}\r\n\treturn \"oscillating\"\r\n}\r\n"]
