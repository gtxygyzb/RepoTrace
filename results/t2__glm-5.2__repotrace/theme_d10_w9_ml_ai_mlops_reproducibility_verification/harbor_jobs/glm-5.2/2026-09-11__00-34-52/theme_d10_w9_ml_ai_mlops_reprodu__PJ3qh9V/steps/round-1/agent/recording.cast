[4131.794625, "i", "cat > internal/compare/compare.go <<'EOF'\npackage compare\n\nimport (\n\t\"fmt\"\n\t\"math\"\n\n\t\"repro-verify/internal/mlck\"\n)\n\ntype DiffHistogram struct {\n\tExact   int `json:\"exact\"`\n\tLess1e7 int `json:\"<1e-7\"`\n\tLess1e5 int `json:\"<1e-5\"`\n\tLess1e3 int `json:\"<1e-3\"`\n\tLess1   int `json:\"<1\"`\n\tGeq1    int `json:\">=1\"`\n}\n\ntype TensorResult struct {\n\tName          string        `json:\"name\"`\n\tMatch         bool          `json:\"match\"`\n\tMaxAbsDiff    float64       `json:\"max_abs_diff\"`\n\tMaxRelDiff    float64       `json:\"max_rel_diff\"`\n\tNumMismatches int           `json:\"num_mismatches\"`\n\tTotalElements int           `json:\"total_elements\"`\n\tShapeMismatch bool          `json:\"shape_mismatch\"`\n\tDiffHistogram *DiffHistogram `json:\"diff_histogram,omitempty\"`\n}\n\ntype Result struct {\n\tMatch          bool           `json:\"match\"`\n\tMode           string         `json:\"mode\"`\n\tAtol           float64        `json:\"atol\"`\n\tRtol           float64        `json:\"rtol\"`\n\tHistogramEnabled bool         `json:\"histogram_enabled,omitempty\"`\n\t"]
[4131.794988, "i", "TensorResults  []TensorResult `json:\"tensor_results\"`\n\tMissingInFile1 []string       `json:\"missing_in_file1\"`\n\tMissingInFile2 []string       `json:\"missing_in_file2\"`\n\tError          string         `json:\"error,omitempty\"`\n}\n\nfunc Compare(c1, c2 *mlck.Checkpoint, mode string, atol, rtol float64, histogram bool) (*Result, error) {\n\tif mode != \"strict\" && mode != \"relaxed\" {\n\t\treturn nil, fmt.Errorf(\"invalid mode %q\", mode)\n\t}\n\n\tresult := &Result{\n\t\tMatch:            true,\n\t\tMode:             mode,\n\t\tAtol:             atol,\n\t\tRtol:             rtol,\n\t\tHistogramEnabled: histogram,\n\t\tTensorResults:    []TensorResult{},\n\t\tMissingInFile1:   []string{},\n\t\tMissingInFile2:   []string{},\n\t}\n\n\tmap2 := make(map[string]mlck.Tensor)\n\tfor _, t := range c2.Tensors {\n\t\tmap2[t.Name] = t\n\t}\n\tmap1 := make(map[string]mlck.Tensor)\n\tfor _, t := range c1.Tensors {\n\t\tmap1[t.Name] = t\n\t}\n\n\tfor _, t1 := range c1.Tensors {\n\t\tt2, ok := map2[t1.Name]\n\t\tif !ok {\n\t\t\tresult.MissingInFile2 = append(result.MissingInFile2, t1.Name)\n\t\t\tcontinue"]
[4131.795131, "o", "cat > internal/compare/compare.go <<'EOF'\r\n\u001b[?2004l\rTensorResults  []TensorResult `json:\"tensor_results\"`\r\n\tMissingInFile1 []string       `json:\"missing_in_file1\"`\r\n\tMissingInFile2 []string       `json:\"missing_in_file2\"`\r\n\tError          string         `json:\"error,omitempty\"`\r\n}\r\n\r\nfunc Compare(c1, "]
[4131.795257, "i", "\n\t\t}\n\t\ttr := compareTensors(t1, t2, mode, atol, rtol, histogram)\n\t\tresult.TensorResults = append(result.TensorResults, tr)\n\t\tif !tr.Match {\n\t\t\tresult.Match = false\n\t\t}\n\t}\n\n\tfor _, t := range c2.Tensors {\n\t\tif _, ok := map1[t.Name]; !ok {\n\t\t\tresult.MissingInFile1 = append(result.MissingInFile1, t.Name)\n\t\t}\n\t}\n\n\tif len(result.MissingInFile1) > 0 || len(result.MissingInFile2) > 0 {\n\t\tresult.Match = false\n\t}\n\n\treturn result, nil\n}\n\nfunc compareTensors(t1, t2 mlck.Tensor, mode string, atol, rtol float64, histogram bool) TensorResult {\n\ttotal := int(mlck.Product(t1.Shape))\n\n\ttr := TensorResult{\n\t\tName:          t1.Name,\n\t\tMatch:         true,\n\t\tMaxAbsDiff:    0,\n\t\tMaxRelDiff:    0,\n\t\tNumMismatches: 0,\n\t\tTotalElements: total,\n\t}\n\n\tif !shapesEqual(t1.Shape, t2.Shape) {\n\t\ttr.Match = false\n\t\ttr.ShapeMismatch = true\n\t\ttr.NumMismatches = total\n\t\treturn tr\n\t}\n\n\tif total == 0 {\n\t\tif histogram {\n\t\t\ttr.DiffHistogram = &DiffHistogram{}\n\t\t}\n\t\treturn tr\n\t}\n\n\tvals1, err := t1.Float64Values()\n\tif err != nil {\n\t\ttr.Match = false\n\t"]
