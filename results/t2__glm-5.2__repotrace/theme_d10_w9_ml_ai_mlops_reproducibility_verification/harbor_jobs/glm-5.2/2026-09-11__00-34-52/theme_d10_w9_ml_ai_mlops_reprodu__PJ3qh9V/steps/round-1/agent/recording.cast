[3875.047937, "o", "\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KErrors\u001b[m\u001b[K   []string `json:\"errors,omitempty\"`\r\n"]
[3875.04812, "o", "\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktype \u001b[01;31m\u001b[KComparisonPart\u001b[m\u001b[K struct {\r\n"]
[3875.048216, "o", "\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KSummary\u001b[m\u001b[K string `json:\"summary,omitempty\"`\r\n"]
[3875.048345, "o", "\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktype \u001b[01;31m\u001b[KLineagePart\u001b[m\u001b[K struct {\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KErrors\u001b[m\u001b[K []string `json:\"errors,omitempty\"`\r\n"]
[3875.048409, "o", "\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tComparison          *\u001b[01;31m\u001b[KComparisonPart\u001b[m\u001b[K `json:\"comparison,omitempty\"`\r\n\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tLineage             *\u001b[01;31m\u001b[KLineagePart\u001b[m\u001b[K    `json:\"lineage,omitempty\"`\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KErrors\u001b[m\u001b[K:   man.\u001b[01;31m\u001b[KErrors\u001b[m\u001b[K,\r\n"]
[3875.048486, "o", "\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tissues = append(issues, fmt.Sprintf(\"Manifest validation failed: %s\", strings.Join(man.\u001b[01;31m\u001b[KErrors\u001b[m\u001b[K, \"; \")))\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\trep.Comparison = &\u001b[01;31m\u001b[KComparisonPart\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\trep.Comparison = &\u001b[01;31m\u001b[KComparisonPart\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\trep.Comparison = &\u001b[01;31m\u001b[KComparisonPart\u001b[m\u001b[K{\r\n"]
[3875.04855, "o", "\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\trep.Comparison = &\u001b[01;31m\u001b[KComparisonPart\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\t\u001b[01;31m\u001b[KSummary\u001b[m\u001b[K: fmt.Sprintf(\"%d/%d tensors differ\", differ, total),\r\n"]
[3875.048614, "o", "\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\t\tissues = append(issues, \"Tensor comparison failed: \u001b[01;31m\u001b[Kmissing\u001b[m\u001b[K tensors or shape mismatch\")\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\trep.Lineage = &\u001b[01;31m\u001b[KLineagePart\u001b[m\u001b[K{\r\n"]
[3875.048675, "o", "\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\trep.Lineage = &\u001b[01;31m\u001b[KLineagePart\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[KErrors\u001b[m\u001b[K: lin.\u001b[01;31m\u001b[KErrors\u001b[m\u001b[K,\r\n"]
[3875.048786, "o", "\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tissues = append(issues, fmt.Sprintf(\"\u001b[01;31m\u001b[KLineage audit failed\u001b[m\u001b[K: %s\", strings.Join(lin.\u001b[01;31m\u001b[KErrors\u001b[m\u001b[K, \"; \")))\r\n"]
