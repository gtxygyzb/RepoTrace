[3334.623722, "o", "grep -n \"func Generate\\|manifest.Validate\\|mlck.ParseFile\\|os.ReadFile\\|ReadFile\\|open\" internal/report/report.go\r\n\u001b[?2004l\r"]
[3334.627392, "o", "\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc Generate\u001b[m\u001b[K(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {\r\n"]
[3334.627501, "o", "\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tman := \u001b[01;31m\u001b[Kmanifest.Validate\u001b[m\u001b[K(manifestPath)\r\n"]
[3334.62761, "o", "\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcp, err := \u001b[01;31m\u001b[Kmlck.ParseFile\u001b[m\u001b[K(checkpointPath)\r\n"]
[3334.627677, "o", "\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tc1, err := \u001b[01;31m\u001b[Kmlck.ParseFile\u001b[m\u001b[K(checkpointPath)\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tc2, err := \u001b[01;31m\u001b[Kmlck.ParseFile\u001b[m\u001b[K(comparePath)\r\n"]
[3334.628185, "o", "\u001b[?2004h"]
[3334.628286, "o", "root@n30009:/app# "]
[3334.898352, "i", "sed -n '1,120p' internal/report/report.go\n"]
[3334.898677, "o", "sed -n '1,120p' internal/report/report.go\r\n\u001b[?2004l\r"]
[3334.90152, "o", "package report\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"strings\"\r\n"]
[3334.901588, "o", "\t\"time\"\r\n\r\n\t\"repro-verify/internal/compare\"\r\n\t\"repro-verify/internal/lineage\"\r\n\t\"repro-verify/internal/manifest\"\r\n\t\"repro-verify/internal/mlck\"\r\n)\r\n\r\ntype ManifestPart struct {\r\n\tValid    bool     `json:\"valid\"`\r\n\tWarnings []string `json:\"warnings,omitempty\"`\r\n\tErrors   []string `json:\"errors,omitempty\"`\r\n}\r\n"]
[3334.901663, "o", "\r\ntype CheckpointPart struct {\r\n\tValid        bool   `json:\"valid\"`\r\n\tNumTensors   int    `json:\"num_tensors\"`\r\n\tFileChecksum string `json:\"file_checksum\"`\r\n\tError        string `json:\"error,omitempty\"`\r\n}\r\n"]
[3334.901725, "o", "\r\ntype ComparisonPart struct {\r\n\tMatch   bool   `json:\"match\"`\r\n\tSummary string `json:\"summary,omitempty\"`\r\n\tError   string `json:\"error,omitempty\"`\r\n}\r\n\r\ntype LineagePart struct {\r\n\tValid bool   `json:\"valid\"`\r\n\tDepth int    `json:\"depth\"`\r\n\tError string `json:\"error,omitempty\"`\r\n}\r\n\r\ntype Report struct {\r\n\tReportVersion       string          `json:\"report_version\"`\r\n\tTimestamp           string          `json:\"timestamp\"`\r\n\tManifest            ManifestPart    `json:\"manifest\"`\r\n\t"]
[3334.90179, "o", "Checkpoint          *CheckpointPart `json:\"checkpoint,omitempty\"`\r\n\tComparison          *ComparisonPart `json:\"comparison,omitempty\"`\r\n\tLineage             *LineagePart    `json:\"lineage,omitempty\"`\r\n\tOverallReproducible bool            `json:\"overall_reproducible\"`\r\n\tIssues              []string        `json:\"issues\"`\r\n}\r\n\r\nfunc Generate(manifestPath, checkpointPath, comparePath, lineagePath string) (*Report, int) {\r\n\tissues := []string{}\r\n\trep := &Report{\r\n"]
[3334.901856, "o", "\t\tReportVersion: \"1.0\",\r\n\t\tTimestamp:     time.Now().Format(time.RFC3339),\r\n\t\tIssues:        issues,\r\n\t}\r\n\r\n\tman := manifest.Validate(manifestPath)\r\n\trep.Manifest = ManifestPart{\r\n\t\tValid:    man.Valid,\r\n\t\tWarnings: man.Warnings,\r\n\t\tErrors:   man.Errors,\r\n"]
[3334.901916, "o", "\t}\r\n\tif !man.Valid {\r\n\t\tissues = append(issues, fmt.Sprintf(\"Manifest validation failed: %s\", strings.Join(man.Errors, \"; \")))\r\n\t}\r\n\r\n\tcheckpointValid := true\r\n\tif checkpointPath != \"\" {\r\n\t\tcp, err := mlck.ParseFile(checkpointPath)\r\n\t\tif err != nil {\r\n\t\t\tcheckpointValid = false\r\n\t"]
[3334.901976, "o", "\t\trep.Checkpoint = &CheckpointPart{\r\n\t\t\t\tValid: false,\r\n\t\t\t\tError: err.Error(),\r\n\t\t\t}\r\n\t\t\tissues = append(issues, fmt.Sprintf(\"Checkpoint verification failed: %v\", err))\r\n\t\t} else {\r\n\t\t\trep.Checkpoint = &CheckpointPart{\r\n\t\t\t\tValid:        true,\r\n\t\t\t\t"]
[3334.902035, "o", "NumTensors:   len(cp.Tensors),\r\n\t\t\t\tFileChecksum: cp.FileChecksum,\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tcomparisonMatch := true\r\n\tif checkpointPath != \"\" && comparePath != \"\" {\r\n\t\tc1, err := mlck.ParseFile(checkpointPath)\r\n\t\tif err != nil {\r\n\t\t\tcomparisonMatch = false\r\n"]
[3334.90209, "o", "\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\tMatch: false,\r\n\t\t\t\tError: fmt.Sprintf(\"checkpoint parse failed: %v\", err),\r\n\t\t\t}\r\n\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n"]
[3334.902146, "o", "\t\t} else {\r\n\t\t\tc2, err := mlck.ParseFile(comparePath)\r\n\t\t\tif err != nil {\r\n\t\t\t\tcomparisonMatch = false\r\n\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t\t\t\t\tMatch: false,\r\n"]
[3334.902203, "o", "\t\t\t\t\tError: fmt.Sprintf(\"compare checkpoint parse failed: %v\", err),\r\n\t\t\t\t}\r\n\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\t\t\t} else {\r\n\t\t\t\tres, err := compare.Compare(c1, c2, \"strict\", 1e-7, 1e-5)\r\n\t\t\t\tif err != nil {\r\n\t\t\t\t\tcomparisonMatch = false\r\n\t\t\t\t\trep.Comparison = &ComparisonPart{\r\n\t"]
[3334.902336, "o", "\t\t\t\t\tMatch: false,\r\n\t\t\t\t\t\tError: err.Error(),\r\n\t\t\t\t\t}\r\n\t\t\t\t\tissues = append(issues, fmt.Sprintf(\"Comparison failed: %v\", err))\r\n\t\t\t\t} else {\r\n\t\t\t\t\tdiffer := 0\r\n\t\t\t\t\ttotal := len(res.TensorResults)\r\n\t\t\t\t\tfor _, tr := range res.TensorResults {\r\n\t\t\t\t\t\tif !tr.Match {\r\n\t\t\t\t\t\t\tdiffer++\r\n"]
[3334.902767, "o", "\u001b[?2004h"]
[3334.902827, "o", "root@n30009:/app# "]
[3335.173441, "i", "./repro-verify audit-lineage /tmp/nonexistent.json > /tmp/audit_missing_stdout.txt 2>/tmp/audit_missing_stderr.txt; echo \"exit=$?\"; echo \"STDOUT:\"; cat /tmp/audit_missing_stdout.txt; echo \"STDERR:\"; cat /tmp/audit_missing_stderr.txt\n"]
