[4026.512015, "o", "\u001b[35m\u001b[K./internal/compare/compare.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\ttr := \u001b[01;31m\u001b[KcompareTensors\u001b[m\u001b[K(t1, t2, mode, atol, rtol)\r\n\u001b[35m\u001b[K./internal/compare/compare.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcompareTensors\u001b[m\u001b[K(t1, t2 mlck.Tensor, mode string, atol, rtol float64) TensorResult {\r\n"]
[4026.512074, "o", "\u001b[35m\u001b[K./internal/compare/compare.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\ttotal := int(mlck.Product(t1.\u001b[01;31m\u001b[KShape\u001b[m\u001b[K))\r\n\u001b[35m\u001b[K./internal/compare/compare.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif !shapesEqual(t1.\u001b[01;31m\u001b[KShape\u001b[m\u001b[K, t2.\u001b[01;31m\u001b[KShape\u001b[m\u001b[K) {\r\n"]
