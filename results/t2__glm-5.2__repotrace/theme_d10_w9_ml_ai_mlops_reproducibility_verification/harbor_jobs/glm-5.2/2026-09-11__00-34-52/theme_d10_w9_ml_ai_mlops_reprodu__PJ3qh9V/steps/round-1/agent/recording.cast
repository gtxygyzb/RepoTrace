[1652.432664, "o", "\u001b[?2004h> "]
[1652.432937, "o", "    NumTensors int `json:\"num_tensors\"`\r\n\u001b[?2004l\r"]
[1652.432992, "o", "\u001b[?2004h> "]
[1652.433321, "o", "    FileChecksum string `json:\"file_checksum\"`\r\n\u001b[?2004l\r"]
[1652.43338, "o", "\u001b[?2004h> "]
[1652.433656, "o", "    Error string `json:\"error,omitempty\"`\r\n\u001b[?2004l\r"]
[1652.433721, "o", "\u001b[?2004h> }"]
[1652.433777, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.433832, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.433888, "o", "> "]
