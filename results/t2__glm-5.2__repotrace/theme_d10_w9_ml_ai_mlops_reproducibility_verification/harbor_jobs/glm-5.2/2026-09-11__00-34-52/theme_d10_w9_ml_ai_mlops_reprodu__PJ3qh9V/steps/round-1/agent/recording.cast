[1227.970153, "o", "    return m\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func isNonNegativeInt(v interface{}) bool {\r\n\u001b[?2004l\r \u001b[?2004h>     switch x := v.(type) {\r\n\u001b[?2004l\r\u001b[?2004h>     case int:\r\n\u001b[?2004l\r \u001b[?2004h>         return x >= 0\r\n\u001b[?2004l\r\u001b[?2004h>     case int64:\r\n\u001b[?2004l\r\u001b[?2004h>         return x >= 0\r\n\u001b[?2004l\r\u001b[?2004h>     case float64:\r\n\u001b[?2004l\r\u001b[?2004h>         return x == float64(int64(x)) && x >= 0\r\n\u001b[?2004l\r\u001b[?2004h>     default:\r\n\u001b[?2004l\r\u001b[?2004h>         return false\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> func hasNumericField(m map[string]interface{}) bool {\r\n\u001b[?2004l\r\u001b[?2004h>     for _, v := range m {\r\n\u001b[?2004l\r\u001b[?2004h>         switch v.(type) {\r\n\u001b[?2004l\r\u001b[?2004h>         case int, int64, float64:\r\n\u001b[?2004l\r\u001b[?2004h>             return true\r\n\u001b[?2004l\r\u001b[?2004h> "]
