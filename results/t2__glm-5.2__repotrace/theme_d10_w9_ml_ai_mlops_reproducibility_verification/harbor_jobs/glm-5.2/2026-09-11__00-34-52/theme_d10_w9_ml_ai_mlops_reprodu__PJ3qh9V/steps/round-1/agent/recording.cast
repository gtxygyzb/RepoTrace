[5406.534423, "o", "package mlck\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"crypto/sha256\"\r\n"]
[5406.534515, "o", "\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n)\r\n\r\nconst (\r\n\tMagic      = \"MLCK\"\r\n\tVersion    = 1\r\n\tHeaderSize = 16\r\n\tFooterSize = 32\r\n)\r\n\r\ntype Dtype uint8\r\n\r\nconst (\r\n\tFloat32 Dtype = 0\r\n\tFloat64 Dtype = 1\r\n\tInt32   Dtype = 2\r\n"]
[5406.534605, "o", "\tInt64   Dtype = 3\r\n)\r\n\r\nfunc (d Dtype) Valid() bool {\r\n\treturn d == Float32 || d == Float64 || d == Int32 || d == Int64\r\n}\r\n\r\nfunc (d Dtype) Name() string {\r\n\tswitch d {\r\n\tcase Float32:\r\n\t\treturn \"float32\"\r\n\tcase Float64:\r\n\t\treturn \"float64\"\r\n\tcase Int32:\r\n\t\treturn \"int32\"\r\n\tcase Int64:"]
[5406.53468, "o", "\r\n\t\treturn \"int64\"\r\n\tdefault:\r\n\t\treturn \"unknown\"\r\n\t}\r\n}\r\n\r\nfunc (d Dtype) Size() int {\r\n\tswitch d {\r\n\tcase Float32, Int32:\r\n\t\treturn 4\r\n\tcase Float64, Int64:\r\n\t\treturn 8\r\n"]
[5406.53475, "o", "\tdefault:\r\n\t\treturn 0\r\n\t}\r\n}\r\n\r\nfunc DtypeName(dtype uint8) string {\r\n\treturn Dtype(dtype).Name()\r\n}\r\n\r\nfunc DtypeSize(dtype uint8) int {\r\n\treturn Dtype(dtype).Size()\r\n}\r\n\r\nfunc Product(shape []uint32) int64 {\r\n\tp := int64(1)\r\n"]
[5406.534816, "o", "\tfor _, s := range shape {\r\n\t\tp *= int64(s)\r\n\t}\r\n\treturn p\r\n}\r\n\r\ntype Tensor struct {\r\n\tName     string\r\n\tDtype    uint8\r\n\tShape    []uint32\r\n\tData     []byte\r\n\tChecksum string\r\n"]
[5406.534883, "o", "}\r\n\r\ntype TensorInfo struct {\r\n\tName     string   `json:\"name\"`\r\n\tDtype    string   `json:\"dtype\"`\r\n\tShape    []uint32 `json:\"shape\"`\r\n\tChecksum string   `json:\"checksum\"`\r\n}\r\n\r\nfunc (t Tensor) Info() TensorInfo {\r\n\treturn TensorInfo{\r\n\t\tName:     t.Name,\r\n\t\tDtype:    DtypeName(t.Dtype),\r\n"]
[5406.534919, "o", "\t\tShape:    t.Shape,\r\n\t\tChecksum: t.Checksum,\r\n\t}\r\n}\r\n\r\ntype Checkpoint struct {\r\n\tVersion      uint32\r\n\t"]
[5406.535014, "o", "NumTensors   uint32\r\n\tMetadata     map[string]interface{}\r\n\tMetadataRaw  []byte\r\n\tTensors      []Tensor\r\n\tFileChecksum string\r\n\tFilePath     string\r\n}\r\n\r\nfunc ParseFile(path string) (*Checkpoint, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn Parse(data, path)\r\n}\r\n\r\nfunc Parse(data []byte, path string) (*Checkpoint, error) {\r\n\tif len(data) < HeaderSize+FooterSize {\r\n"]
[5406.535088, "o", "\t\treturn nil, fmt.Errorf(\"file too small\")\r\n"]
[5406.535557, "o", "\u001b[?2004h"]
[5406.535626, "o", "root@n30009:/app# "]
[5406.808769, "i", "cat > /tmp/gen_checkpoints.go <<'EOF'\npackage main\n\nimport (\n\t\"os\"\n\n\t\"repro-verify/internal/mlck\"\n)\n\nfunc mustData(vals []float64) []byte {\n\tb, err := mlck.EncodeFloat64Values(vals, uint8(mlck.Float64))\n\tif err != nil {\n\t\tpanic(err)\n\t}\n\treturn b\n}\n\nfunc main() {\n\ttensors1 := []mlck.Tensor{\n\t\t{Name: \"a\", Dtype: uint8(mlck.Float64), Shape: []uint32{2}, Data: mustData([]float64{0, 0})},\n\t\t{Name: \"b\", Dtype: uint8(mlck.Float64), Shape: []uint32{2}, Data: mustData([]float64{10, 10})},\n\t}\n\ttensors2 := []mlck.Tensor{\n\t\t{Name: \"a\", Dtype: uint8(mlck.Float64), Shape: []uint32{2}, Data: mustData([]float64{1, 1})},\n\t\t{Name: \"b\", Dtype: uint8(mlck.Float64), Shape: []uint32{2}, Data: mustData([]float64{20, 20})},\n\t}\n\n\tfor name, ts := range map[string][]mlck.Tensor{\"cp1.mlck\": tensors1, \"cp2.mlck\": tensors2} {\n\t\tb, err := mlck.Build(map[string]interface{}{}, ts)\n\t\tif err != nil {\n\t\t\tpanic(err)\n\t\t}\n\t\tif err := os.WriteFile(name, b, 0644); err != nil {\n\t\t\tpanic(err)\n\t\t}\n\t}\n}\nEOF\n"]
