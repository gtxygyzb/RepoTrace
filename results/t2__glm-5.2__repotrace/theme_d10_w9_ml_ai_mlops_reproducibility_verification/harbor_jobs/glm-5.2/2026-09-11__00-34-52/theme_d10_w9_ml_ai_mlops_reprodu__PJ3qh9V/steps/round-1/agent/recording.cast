[2651.51935, "o", "\t\r\n   128\t\tgit := getTable(root, \"git\")\r\n   129\t\tif git == nil {\r\n   130\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'git.commit' missing\")\r\n   131\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'git.branch' missing\")\r\n   132\t\t} else {\r\n   133\t\t\tif _, ok := git[\"commit\"].(string); !ok {\r\n   134\t\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'git.commit' missing\")\r\n   135\t\t\t}\r\n"]
[2651.519409, "o", "   136\t\t\tif _, ok := git[\"branch\"].(string); !ok {\r\n   137\t\t\t\tresult.Warnings = append(result.Warnings, \"optional field 'git.branch' missing\")\r\n   138\t\t\t}\r\n   139\t\t}\r\n   140\t\r\n   141\t\tif len(result.Errors) > 0 {\r\n   142\t\t\tresult.Valid = false\r\n   143\t\t\tresult.Warnings = nil\r\n   144\t\t}\r\n   145\t"]
[2651.519466, "o", "\tif result.Valid && len(result.Warnings) == 0 {\r\n   146\t\t\tresult.Warnings = []string{}\r\n   147\t\t}\r\n   148\t\r\n   149\t\treturn result\r\n   150\t}\r\n   151\t\r\n   152\tvar pythonVersionRegex = regexp.MustCompile(`^\\d+\\.\\d+\\.\\d+$`)\r\n   153\t\r\n   154\t"]
[2651.519541, "o", "func getTable(root map[string]interface{}, key string) map[string]interface{} {\r\n   155\t\tv, ok := root[key]\r\n   156\t\tif !ok {\r\n   157\t\t\treturn nil\r\n   158\t\t}\r\n   159\t\tm, ok := v.(map[string]interface{})\r\n   160\t\tif !ok {\r\n   161\t\t\treturn nil\r\n   162\t\t}\r\n   163\t\treturn m\r\n   164\t}\r\n   165\t"]
[2651.519598, "o", "\r\n   166\tfunc isNonNegativeInt(v interface{}) bool {\r\n   167\t\tswitch x := v.(type) {\r\n   168\t\tcase int:\r\n   169\t\t\treturn x >= 0\r\n   170\t\tcase int64:\r\n   171\t\t\treturn x >= 0\r\n   172\t\tcase float64:\r\n"]
[2651.519656, "o", "   173\t\t\treturn x == float64(int64(x)) && x >= 0\r\n   174\t\tdefault:\r\n   175\t\t\treturn false\r\n   176\t\t}\r\n   177\t}\r\n   178\t\r\n   179\tfunc hasNumericField(m map[string]interface{}) bool {\r\n   180\t\tfor _, v := range m {\r\n   181"]
[2651.519712, "o", "\t\t\tswitch v.(type) {\r\n   182\t\t\tcase int, int64, float64:\r\n   183\t\t\t\treturn true\r\n   184\t\t\t}\r\n   185\t\t}\r\n   186\t\treturn false\r\n   187\t}\r\n   188\t\r\n"]
[2651.519769, "o", "   189\tfunc parseTOML(data string) (map[string]interface{}, error) {\r\n   190\t\troot := map[string]interface{}{}\r\n   191\t\tvar current map[string]interface{} = root\r\n   192\t\tvar currentArray []map[string]interface{}\r\n   193\t\r\n   194\t\tlines := strings.Split(data, \"\\n\")\r\n   195\t\tfor lineNum, raw := range lines {\r\n"]
[2651.519833, "o", "   196\t\t\tline := strings.TrimSpace(raw)\r\n   197\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n   198\t\t\t\tcontinue\r\n   199\t\t\t}\r\n   200\t\r\n   201\t\t\tif strings.HasPrefix(line, \"[[\") && strings.HasSuffix(line, \"]]\") {\r\n   202\t\t\t\tkey := strings.TrimSpace(line[2 : len(line)-2])\r\n   203\t\t\t\tparts := strings.Split(key, \".\")\r\n   204\t\t\t\tparent := root\r\n   205\t\t\t\tfor i := 0; i < len(parts)-1; i++ {\r\n"]
[2651.519889, "o", "   206\t\t\t\t\tp := strings.TrimSpace(parts[i])\r\n   207\t\t\t\t\tnext, ok := parent[p]\r\n   208\t\t\t\t\tif !ok {\r\n   209\t\t\t\t\t\tnext = map[string]interface{}{}\r\n   210\t\t\t\t\t\tparent[p] = next\r\n   211\t\t\t\t\t}\r\n"]
[2651.519948, "o", "   212\t\t\t\t\tparent, ok = next.(map[string]interface{})\r\n   213\t\t\t\t\tif !ok {\r\n   214\t\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid array table path\", lineNum+1)\r\n   215\t\t\t\t\t}\r\n   216\t\t\t\t}\r\n"]
[2651.520008, "o", "   217\t\t\t\tlast := strings.TrimSpace(parts[len(parts)-1])\r\n   218\t\t\t\tarr, ok := parent[last].([]map[string]interface{})\r\n   219\t\t\t\tif !ok {\r\n   220\t\t\t\t\tarr = []map[string]interface{}{}\r\n"]
