[5365.624242, "o", "   220\tfunc runDriftAnalysis(args []string) int {\r\n   221\t\tfs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\r\n   222\t\tfs.SetOutput(io.Discard)\r\n   223\t\r\n"]
[5365.624287, "o", "   224\t\ttopK := fs.Int(\"top-k\", 0, \"number of tensors with the lowest stability scores to include\")\r\n   225\t\tthreshold := fs.Float64(\"threshold\", 0, \"max change threshold above which a tensor is considered drifting\")\r\n   226\t\r\n   227\t\tpos, err := parseMixedArgs(fs, args)\r\n   228\t\tif err != nil {\r\n   229\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   230\t\t\treturn 1\r\n"]
[5365.624408, "o", "   231\t\t}\r\n   232\t\tif len(pos) < 2 {\r\n   233\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\r\n   234\t\t\treturn 1\r\n   235\t\t}\r\n   236\t\r\n   237\t\tvar topKPtr *int\r\n   238\t\tvar thresholdPtr *float64\r\n   239\t\tfs.Visit(func(f *flag.Flag) {\r\n   240\t\t\tif f.Name == \"top-k\" {\r\n   241\t\t\t\tv := *topK\r\n   242\t\t\t\ttopKPtr = &v\r\n   243\t\t\t}\r\n   244\t\t\tif f.Name == \"threshold\" {\r\n   245\t\t\t\tv := *threshold\r\n   246\t\t\t\tthresholdPtr = &v\r\n"]
[5365.624482, "o", "   247\t\t\t}\r\n   248\t\t})\r\n   249\t\tif topKPtr != nil && *topKPtr < 0 {\r\n   250\t\t\toutputJSON(map[string]interface{}{\"error\": \"--top-k must be non-negative\"})\r\n   251\t\t\treturn 1\r\n   252\t\t}\r\n   253\t\r\n   254\t\tres, err := drift.AnalyzeWithTopK(pos, topKPtr, thresholdPtr)\r\n   255\t\tif err != nil {\r\n"]
