[3875.330669, "o", "grep -nE 'sort|allNames|SkippedTensors|Tensors:' internal/drift/drift.go\r\n\u001b[?2004l\r"]
[3875.333607, "o", "\u001b[32m\u001b[K6\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\"\u001b[01;31m\u001b[Ksort\u001b[m\u001b[K\"\r\n"]
