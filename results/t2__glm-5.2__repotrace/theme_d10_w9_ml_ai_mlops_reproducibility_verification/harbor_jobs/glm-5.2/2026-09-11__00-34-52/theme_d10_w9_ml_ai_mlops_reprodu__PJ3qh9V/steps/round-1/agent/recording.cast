[2652.028072, "o", "   222\tfunc runDriftAnalysis(args []string) int {\r\n   223\t\tfs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\r\n   224\t\tfs.SetOutput(os.Stderr)\r\n   225\t\r\n   226\t\tpos, err := parseMixedArgs(fs, args)\r\n   227\t\tif err != nil {\r\n   228\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   229\t\t\treturn 1\r\n   230\t\t}\r\n   231\t\tif len(pos) < 2 {\r\n   232\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\r\n   233\t\t\treturn 1\r\n   234\t\t}\r\n   235\t\r\n   236\t\tres, err := drift.Analyze(pos)\r\n   237\t\tif err != nil {\r\n"]
