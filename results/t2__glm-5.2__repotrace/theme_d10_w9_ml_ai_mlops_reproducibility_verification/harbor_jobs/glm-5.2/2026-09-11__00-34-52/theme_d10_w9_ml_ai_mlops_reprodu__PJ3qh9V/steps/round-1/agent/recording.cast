[5855.207392, "o", "   148\t\tif converging > len(tensors)/2 {\r\n   149\t\t\toverall = \"converging\"\r\n   150\t\t} else if diverging > len(tensors)/2 {\r\n   151\t\t\toverall = \"diverging\"\r\n   152\t\t}\r\n"]
[5855.207451, "o", "   153\t\r\n   154\t\tsort.Strings(skipped)\r\n   155\t\tsort.Slice(tensors, func(i, j int) bool {\r\n   156\t\t\treturn tensors[i].Name < tensors[j].Name\r\n   157\t\t})\r\n   158\t\r\n   159\t\tresult := &Result{\r\n"]
[5855.207511, "o", "   160\t\t\tNumSnapshots:       len(files),\r\n   161\t\t\tNumAnalyzedTensors: len(tensors),\r\n   162\t\t\tSkippedTensors:     skipped,\r\n   163\t\t\tTensors:            tensors,\r\n   164\t\t\tOverallConvergence: overall,\r\n   165\t\t}\r\n"]
[5855.20757, "o", "   166\t\r\n   167\t\tif threshold != nil {\r\n   168\t\t\tnumDrifting := 0\r\n   169\t\t\tfor i := range result.Tensors {\r\n   170\t\t\t\tdrifting := result.Tensors[i].MaxChange > *threshold\r\n   171\t\t\t\tresult.Tensors[i].Drifting = &drifting\r\n"]
[5855.207629, "o", "   172\t\t\t\tif drifting {\r\n   173\t\t\t\t\tnumDrifting++\r\n   174\t\t\t\t}\r\n   175\t\t\t}\r\n   176\t\t\tresult.DriftThreshold = threshold\r\n   177\t\t"]
[5855.207689, "o", "\tresult.NumDriftingTensors = &numDrifting\r\n   178\t\t}\r\n   179\t\r\n   180\t\tapplyTopK(result, topK)\r\n   181\t\treturn result, nil\r\n   182\t}\r\n   183\t\r\n"]
[5855.207745, "o", "   184\tfunc applyTopK(result *Result, topK *int) {\r\n   185\t\tif topK == nil {\r\n   186\t\t\treturn\r\n   187\t\t}\r\n   188\t\r\n   189\t\trequested := *topK\r\n   190\t\tsort.SliceStable(result.Tensors, func(i, j int) bool {"]
[5855.207805, "o", "\r\n   191\t\t\tif result.Tensors[i].StabilityScore != result.Tensors[j].StabilityScore {\r\n   192\t\t\t\treturn result.Tensors[i].StabilityScore < result.Tensors[j].StabilityScore\r\n   193\t\t\t}\r\n   194\t\t\treturn result.Tensors[i].Name < result.Tensors[j].Name\r\n   195\t\t})\r\n"]
[5855.207868, "o", "   196\t\tif requested < len(result.Tensors) {\r\n   197\t\t\tresult.Tensors = result.Tensors[:requested]\r\n   198\t\t}\r\n   199\t\tresult.TopK = &requested\r\n"]
[5855.207929, "o", "   200\t}\r\n   201\t\r\n   202\tfunc tensorData(cp *mlck.Checkpoint, name string) ([]float64, error) {\r\n   203\t\tt, ok := tensorByName(cp, name)\r\n   204\t\tif !ok {\r\n   205\t\t\treturn nil, fmt.Errorf(\"tensor %s not found\", name)\r\n   206\t\t}\r\n   207\t\treturn t.Float64Values()\r\n   208\t}\r\n   209\t\r\n"]
[5855.20799, "o", "   210\tfunc tensorByName(cp *mlck.Checkpoint, name string) (mlck.Tensor, bool) {\r\n   211\t\tfor _, t := range cp.Tensors {\r\n   212\t\t\tif t.Name == name {\r\n   213\t\t\t\treturn t, true\r\n   214\t\t\t}\r\n   215\t\t}\r\n"]
[5855.20805, "o", "   216\t\treturn mlck.Tensor{}, false\r\n   217\t}\r\n   218\t\r\n   219\tfunc shapesEqual(a, b []uint32) bool {\r\n   220\t\tif len(a) != len(b) {\r\n   221\t\t\treturn false\r\n   222\t\t}\r\n"]
[5855.208108, "o", "   223\t\tfor i := range a {\r\n   224\t\t\tif a[i] != b[i] {\r\n   225\t\t\t\treturn false\r\n   226\t\t\t}\r\n   227\t\t}\r\n   228\t\treturn true\r\n   229\t}\r\n   230\t\r\n"]
[5855.208168, "o", "   231\tfunc meanFloat64(xs []float64) float64 {\r\n   232\t\tif len(xs) == 0 {\r\n   233\t\t\treturn 0\r\n   234\t\t}\r\n   235\t\tvar sum float64\r\n"]
[5855.208238, "o", "   236\t\tfor _, x := range xs {\r\n   237\t\t\tsum += x\r\n   238\t\t}\r\n   239\t\treturn sum / float64(len(xs))\r\n   240\t}\r\n"]
