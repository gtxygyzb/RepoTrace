[4027.062555, "o", "\tif len(pos) < 3 {\r\n   206\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]\"})\r\n   207\t\t\treturn 1\r\n   208\t\t}\r\n   209\t\r\n   210\t\tres, err := merge.Merge(pos[0], pos[1:], *conflict)\r\n   211\t\tif err != nil {\r\n   212\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   213\t\t\treturn 1\r\n   214\t\t}\r\n   215\t\toutputJSON(res)\r\n   216\t\treturn 0\r\n   217\t}\r\n   218\t\r\n   219"]
[4027.062614, "o", "\tfunc runDriftAnalysis(args []string) int {\r\n   220\t\tfs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\r\n   221\t\tfs.SetOutput(io.Discard)\r\n   222\t\r\n   223\t\tpos, err := parseMixedArgs(fs, args)\r\n   224\t\tif err != nil {\r\n   225\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n"]
