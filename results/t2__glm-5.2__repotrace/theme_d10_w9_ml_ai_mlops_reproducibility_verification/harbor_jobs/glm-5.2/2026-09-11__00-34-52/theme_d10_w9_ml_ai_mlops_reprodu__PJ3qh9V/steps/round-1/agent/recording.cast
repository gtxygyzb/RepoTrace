[2635.791452, "o", "package app\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n"]
[2635.791533, "o", "\t\"os\"\r\n\t\"strings\"\r\n\r\n\t\"repro-verify/internal/compare\"\r\n\t\"repro-verify/internal/drift\"\r\n\t\"repro-verify/internal/lineage\"\r\n\t\"repro-verify/internal/manifest\"\r\n\t\"repro-verify/internal/merge\"\r\n\t\"repro-verify/internal/mlck\"\r\n\t\"repro-verify/internal/report\"\r\n)\r\n\r\nfunc Run() int {\r\n\tif len(os.Args) < 2 {\r\n"]
[2635.791611, "o", "\t\toutputJSON(map[string]interface{}{\"error\": \"no subcommand provided\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"verify-checkpoint\":\r\n\t\treturn runVerifyCheckpoint(os.Args[2:])\r\n\tcase \"compare-outputs\":\r\n\t\t"]
[2635.791673, "o", "return runCompareOutputs(os.Args[2:])\r\n\tcase \"validate-manifest\":\r\n\t\treturn runValidateManifest(os.Args[2:])\r\n\tcase \"audit-lineage\":\r\n\t\treturn runAuditLineage(os.Args[2:])\r\n\tcase \"generate-report\":\r\n\t\treturn runGenerateReport(os.Args[2:])\r\n\tcase \"merge-checkpoints\":\r\n\t\treturn runMergeCheckpoints(os.Args[2:])\r\n\tcase \"drift-analysis\":\r\n\t\treturn runDriftAnalysis(os.Args[2:])\r\n\tdefault:\r\n\t\toutputJSON(map[string]interface{}{\"error\": fmt.Sprintf(\"unknown subcommand: %s\", os.Args[1])})\r\n\t\treturn 1\r\n\t}\r\n}\r\n"]
[2635.791735, "o", "\r\nfunc runVerifyCheckpoint(args []string) int {\r\n\tif len(args) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify verify-checkpoint <file>\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tcp, err := mlck.ParseFile(args[0])\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\r\n\t\t\t\"valid\": false,\r\n\t\t\t\"error\": err.Error(),\r\n\t"]
[2635.791856, "o", "\t})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tmetadata := cp.Metadata\r\n\tif metadata == nil {\r\n\t\tmetadata = map[string]interface{}{}\r\n\t}\r\n\ttensors := make([]mlck.TensorInfo, 0, len(cp.Tensors))\r\n\tfor _, t := range cp.Tensors {\r\n\t\ttensors = append(tensors, t.Info())\r\n\t}\r\n\r\n\toutputJSON(map[string]interface{}{\r\n\t\t\"valid\":          true,\r\n\t\t\"format_version\": int(cp.Version),\r\n\t\t\"num_tensors\":    len(cp.Tensors),\r\n\t\t\"metadata\":       metadata,\r\n\t\t\"tensors\":        tensors,\r\n\t\t\"file_checksum\":  cp.FileChecksum,\r\n\t})\r\n"]
[2635.791919, "o", "\treturn 0\r\n}\r\n\r\nfunc runCompareOutputs(args []string) int {\r\n\tfs := flag.NewFlagSet(\"compare-outputs\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tatol := fs.Float64(\"atol\", 1e-7, \"absolute tolerance\")\r\n\trtol := fs.Float64(\"rtol\", 1e-5, \"relative tolerance\")\r\n\tmode := fs.String(\"mode\", \"strict\", \"comparison mode\")\r\n\r\n\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\t"]
[2635.79198, "o", "outputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tif len(pos) != 2 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify compare-outputs <file1> <file2> [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tc1, err := mlck.ParseFile(pos[0])\r\n\tif err != nil {\r\n\t"]
[2635.792042, "o", "\toutputJSON(map[string]interface{}{\r\n\t\t\t\"match\":            false,\r\n\t\t\t\"mode\":             *mode,\r\n\t\t\t\"atol\":             *atol,\r\n\t\t\t\"rtol\":             *rtol,\r\n\t\t\t\"tensor_results\":   []interface{}{},\r\n\t\t\t\"missing_in_file1\": []string{},\r\n\t\t\t\"missing_in_file2\": []string{},\r\n\t\t\t\"error\":            fmt.Sprintf(\"file1: %v\", err),\r\n\t\t})"]
[2635.792104, "o", "\r\n\t\treturn 1\r\n\t}\r\n\r\n\tc2, err := mlck.ParseFile(pos[1])\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\r\n\t\t\t\"match\":            false,\r\n\t\t\t\"mode\":             *mode,\r\n"]
[2635.792161, "o", "\t\t\t\"atol\":             *atol,\r\n\t\t\t\"rtol\":             *rtol,\r\n\t\t\t\"tensor_results\":   []interface{}{},\r\n\t\t\t\"missing_in_file1\": []string{},\r\n\t\t\t\"missing_in_file2\": []string{},\r\n\t\t\t\"error\":            fmt.Sprintf(\"file2: %v\", err),\r\n\t\t})\r\n"]
[2635.792219, "o", "\t\treturn 1\r\n\t}\r\n\r\n\tres, err := compare.Compare(c1, c2, *mode, *atol, *rtol)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\r\n\t\t\t\"match\":            false,\r\n\t\t\t\"mode\":             *mode,\r\n\t\t\t\"atol\":             *atol,\r\n\t\t\t\"rtol\":             *rtol,\r\n"]
[2635.792454, "o", "\t\t\t\"tensor_results\":   []interface{}{},\r\n\t\t\t\"missing_in_file1\": []string{},\r\n\t\t\t\"missing_in_file2\": []string{},\r\n\t\t\t\"error\":            err.Error(),\r\n\t\t})\r\n\t\treturn 1\r\n\t}\r\n\r\n\toutputJSON(res)\r\n\tif res.Match {\r\n\t\treturn 0\r\n\t}\r\n\treturn 1\r\n"]
[2635.792549, "o", "}\r\n\r\nfunc runValidateManifest(args []string) int {\r\n\tif len(args) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify validate-manifest <file.toml>\"})\r\n\t\treturn 1\r\n\t}\r\n\tres := manifest.Validate(args[0])\r\n\toutputJSON(res)\r\n\tif res.Valid {\r\n\t\treturn 0\r\n\t}\r\n\treturn 1\r\n}\r\n\r\nfunc runAuditLineage(args []string) int {\r\n\tif len(args) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify audit-lineage <file.json>\"})\r\n\t\treturn 1\r\n\t}\r\n\tres := lineage.Audit(args[0])\r\n\toutputJSON(res)\r\n\tif res.Valid {\r\n\t\treturn 0\r\n\t}\r\n\treturn 1\r\n}\r\n\r\nfunc runGenerateReport(args []string) int {\r\n\tfs := flag.NewFlagSet(\"generate-report\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tcheckpoint := fs.String(\"checkpoint\", \"\", \"checkpoint file to verify\")\r\n\tcomparePath := fs.String(\"compare\", \"\", \"second checkpoint to compare\")\r\n\tlineagePath := fs.String(\"lineage\", \"\", \"lineage file to audit\")\r\n\r\n\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": e"]
[2635.792636, "o", "rr.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tif len(pos) != 1 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify generate-report <manifest.toml> [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\trep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)\r\n\toutputJSON(rep)\r\n\treturn code\r\n}\r\n\r\nfunc runMergeCheckpoints(args []string) int {\r\n\tfs := flag.NewFlagSet(\"merge-checkpoints\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tconflict := fs.String(\"conflict\", \"first\", \"conflict strategy\")\r\n\r\n\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n"]
[2635.792708, "o", "\tif len(pos) < 3 {\r\n\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify merge-checkpoints <output> <file1> <file2> ... [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n"]
[2635.792782, "o", "\r\n\tres, err := merge.Merge(pos[0], pos[1:], *conflict)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\toutputJSON(res)\r\n\treturn 0\r\n}\r\n\r\nfunc runDriftAnalysis(args []string) int {\r\n\tfs := flag.NewFlagSet(\"drift-analysis\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\r\n\tpos, err := parseMixedArgs(fs, args)\r\n\tif err != nil {\r\n\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\tif len(pos) < 2 {\r\n\t\t"]
[2635.792854, "o", "outputJSON(map[string]interface{}{\"error\": \"usage: repro-verify drift-analysis <file1> <file2> <file3> ... [flags]\"})\r\n\t\treturn 1\r\n\t}\r\n\r\n\tres, err := drift.Analyze(pos)\r\n\tif err != nil {\r\n"]
[2635.792912, "o", "\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n\t\treturn 1\r\n\t}\r\n\toutputJSON(res)\r\n\treturn 0\r\n}\r\n\r\nfunc parseMixedArgs(fs *flag.FlagSet, args []string) ([]string, error) {\r\n\tvar positional []string\r\n\tvar flagArgs []string\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tif arg == \"--\" {\r\n\t\t\tpositional = append(positional, args[i+1:]...)\r\n"]
[2635.792973, "o", "\t\t\tbreak\r\n\t\t}\r\n\t\tif strings.HasPrefix(arg, \"--\") {\r\n\t\t\tif strings.Contains(arg, \"=\") {\r\n\t\t\t\tflagArgs = append(flagArgs, arg)\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn nil, fmt.Errorf(\"flag %s requires a value\", arg)\r\n"]
[2635.793034, "o", "\t\t\t}\r\n\t\t\tflagArgs = append(flagArgs, arg+\"=\"+args[i+1])\r\n\t\t\ti++\r\n\t\t} else {\r\n\t\t\tpositional = append(positional, arg)\r\n\t\t}\r\n\t}\r\n\r\n\tif err := fs.Parse(flagArgs); err != nil {\r\n"]
[2635.79309, "o", "\t\treturn nil, err\r\n\t}\r\n\treturn positional, nil\r\n}\r\n\r\nfunc outputJSON(v interface{}) {\r\n\tenc := json.NewEncoder(os.Stdout)\r\n\tenc.SetIndent(\"\", \"  \")\r\n\t_ = enc.Encode(v)\r\n}\r\n"]
