[5241.734601, "o", "    91\t\trtol := fs.Float64(\"rtol\", 1e-5, \"relative tolerance\")\r\n    92\t\tmode := fs.String(\"mode\", \"strict\", \"comparison mode\")\r\n    93\t\thistogram := fs.Bool(\"histogram\", false, \"include diff histograms\")\r\n    94\t\r\n    95\t\tpos, err := parseMixedArgs(fs, args)\r\n    96\t\tif err != nil {\r\n    97\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n    98\t\t\treturn 1\r\n    99\t\t}\r\n   100\t\tif len(pos) != 2 {\r\n   101\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify compare-outputs <file1> <file2> [flags]\"})\r\n"]
