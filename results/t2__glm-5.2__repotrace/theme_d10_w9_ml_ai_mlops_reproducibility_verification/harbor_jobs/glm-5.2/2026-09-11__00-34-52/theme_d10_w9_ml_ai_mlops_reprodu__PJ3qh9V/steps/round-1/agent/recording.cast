[5065.923707, "o", "\r\nconst (\r\n\tMagic      = \"MLCK\"\r\n\tVersion    = 1\r\n\tHeaderSize = 16\r\n\tFooterSize = 32\r\n)\r\n\r\ntype Dtype uint8\r\n\r\nconst (\r\n\tFloat32 Dtype = 0\r\n\tFloat64 Dtype = 1\r\n\tInt32   Dtype = 2\r\n\tInt64   Dtype = 3\r\n)\r\n\r\nfunc (d Dtype) Valid() bool {\r\n\treturn d == Float32 || d == Float64 || d == Int32 || d == Int64\r\n}\r\n\r\nfunc (d Dtype) Name() string {\r\n\tswitch d {\r\n\tcase Float32:\r\n\t\treturn \"float32\"\r\n\tcase Float64:\r\n\t\treturn \"float64\"\r\n\tcase Int32:\r\n\t\treturn \"int32\"\r\n\tcase Int64:\r\n\t\treturn \"int64\"\r\n\tdefault:\r\n\t\treturn \"unknown\"\r\n\t}\r\n}\r\n\r\nfunc (d Dtype) Size() int {\r\n\tswitch d {\r\n"]
[5065.923811, "o", "\tcase Float32, Int32:\r\n\t\treturn 4\r\n\tcase Float64, Int64:\r\n\t\treturn 8\r\n\tdefault:\r\n\t\treturn 0\r\n\t}\r\n}\r\n\r\nfunc DtypeName(dtype uint8) string {\r\n\treturn Dtype(dtype).Name()\r\n}\r\n\r\nfunc DtypeSize(dtype uint8) int {\r\n\treturn Dtype(dtype).Size()\r\n}\r\n\r\nfunc Product(shape []uint32) int64 {\r\n\tp := int64(1)\r\n"]
[5065.923878, "o", "\tfor _, s := range shape {\r\n\t\tp *= int64(s)\r\n\t}\r\n\treturn p\r\n}\r\n\r\ntype Tensor struct {\r\n\tName     string\r\n\tDtype    uint8\r\n\tShape    []uint32\r\n\tData     []byte\r\n\tChecksum string\r\n}\r\n\r\n"]
[5065.923937, "o", "type TensorInfo struct {\r\n\tName     string   `json:\"name\"`\r\n\tDtype    string   `json:\"dtype\"`\r\n\tShape    []uint32 `json:\"shape\"`\r\n\tChecksum string   `json:\"checksum\"`\r\n}\r\n\r\n"]
