[3695.68504, "o", "   110\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"cycle detected involving: %s\", strings.Join(cycle, \", \")))\r\n   111\t\t\t}\r\n   112\t\t}\r\n   113\t\r\n   114\t\tif len(result.Errors) == 0 {\r\n   115\t\t\tfor _, e := range exps {\r\n   116\t\t\t\tchildTime, ok := times[e.ID]\r\n"]
[3695.685096, "o", "   117\t\t\t\tif !ok {\r\n   118\t\t\t\t\tcontinue\r\n   119\t\t\t\t}\r\n   120\t\t\t\tfor _, p := range e.Parents {\r\n   121\t\t\t\t\tparentTime, ok := times[p]\r\n   122\t\t\t\t\tif !ok {\r\n   123\t\t\t\t\t\tcontinue\r\n"]
[3695.685153, "o", "   124\t\t\t\t\t}\r\n   125\t\t\t\t\tif !childTime.After(parentTime) {\r\n   126\t\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"timestamp violation: %s (%s) has parent %s (%s)\", e.ID, childTime.Format(\"2006-01-02\"), p, parentTime.Format(\"2006-01-02\")))\r\n   127\t\t\t\t\t}\r\n   128\t\t\t\t}\r\n   129\t\t\t}\r\n"]
[3695.685214, "o", "   130\t\t}\r\n   131\t\r\n   132\t\tif len(result.Errors) > 0 {\r\n   133\t\t\tresult.Valid = false\r\n   134\t\t\tresult.TopologicalOrder = nil\r\n   135\t\t\treturn result\r\n   136\t\t}\r\n   137\t\r\n   138\t\tchildren := make(map[string][]string)\r\n   139\t\tfor _, e := range exps {"]
[3695.685282, "o", "\r\n   140\t\t\tfor _, p := range e.Parents {\r\n   141\t\t\t\tchildren[p] = append(children[p], e.ID)\r\n   142\t\t\t}\r\n   143\t\t}\r\n   144"]
[3695.685338, "o", "\t\r\n   145\t\troots := make([]string, 0)\r\n   146\t\tleaves := make([]string, 0)\r\n   147\t\tfor _, e := range exps {\r\n   148\t\t\tif len(e.Parents) == 0 {\r\n   149\t\t\t\troots = append(roots, e.ID)\r\n   150\t\t\t}\r\n"]
[3695.685395, "o", "   151\t\t\tif len(children[e.ID]) == 0 {\r\n   152\t\t\t\tleaves = append(leaves, e.ID)\r\n   153\t\t\t}\r\n   154\t\t}\r\n   155\t\r\n   156\t\tvisited := make(map[string]bool)\r\n   157\t\tvar post []string\r\n   158\t\tvar dfs func(id string)\r\n"]
[3695.685457, "o", "   159\t\tdfs = func(id string) {\r\n   160\t\t\tvisited[id] = true\r\n   161\t\t\tfor _, child := range children[id] {\r\n   162\t\t\t\tif !visited[child] {\r\n   163\t\t\t\t\tdfs(child)\r\n   164\t\t\t\t}\r\n   165\t\t\t}\r\n   166\t\t\tpost = append(post, id)\r\n   167"]
[3695.685513, "o", "\t\t}\r\n   168\t\tfor _, e := range exps {\r\n   169\t\t\tif !visited[e.ID] {\r\n   170\t\t\t\tdfs(e.ID)\r\n   171\t\t\t}\r\n   172\t\t}\r\n   173\t\ttopo := make([]string, len(post))\r\n   174\t\tfor i := range post {\r\n   175\t"]
[3695.685568, "o", "\t\ttopo[i] = post[len(post)-1-i]\r\n   176\t\t}\r\n   177\t\r\n   178\t\tmaxDepth := 0\r\n   179\t\tvar depthDFS func(id string, depth int)\r\n   180\t\tdepthDFS = func(id string, depth int) {\r\n"]
