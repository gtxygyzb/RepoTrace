[3847.715726, "o", "     1\tpackage drift\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"math\"\r\n     6\t\t\"sort\"\r\n"]
[3847.71586, "o", "     7\t\r\n     8\t\t\"repro-verify/internal/mlck\"\r\n     9\t)\r\n    10\t\r\n    11\ttype TensorResult struct {\r\n    12\t\tName           string    `json:\"name\"`\r\n    13\t\tStepChanges    []float64 `json:\"step_changes\"`\r\n    14\t\tMeanChange     float64   `json:\"mean_change\"`\r\n    15\t\tMaxChange      float64   `json:\"max_change\"`\r\n    16\t\tConvergence    string    `json:\"convergence\"`\r\n    17\t\tStabilityScore float64   `json:\"stability_score\"`\r\n    18\t}\r\n    19\t\r\n    20\ttype Result struct {\r\n    21\t\tNumSnapshots       int            `json:\"num_snapshots\"`\r\n    22\t\tNumAnalyzedTensors int            `json:\"num_analyzed_tensors\"`\r\n"]
[3847.71594, "o", "    23\t\tSkippedTensors     []string       `json:\"skipped_tensors\"`\r\n    24\t\tTensors            []TensorResult `json:\"tensors\"`\r\n    25\t\tOverallConvergence string         `json:\"overall_convergence\"`\r\n    26\t}\r\n    27\t\r\n    28\tfunc Analyze(files []string) (*Result, error) {\r\n    29\t\tif len(files) < 2 {\r\n    30\t\t\treturn nil, fmt.Errorf(\"at least 2 input files required\")\r\n    31\t\t}\r\n    32\t\r\n    33\t\tcps := make([]*mlck.Checkpoint, len(files))\r\n    34\t\tfor i, f := range files {\r\n    35"]
[3847.716056, "o", "\t\t\tcp, err := mlck.ParseFile(f)\r\n    36\t\t\tif err != nil {\r\n    37\t\t\t\treturn nil, fmt.Errorf(\"file %s: %v\", f, err)\r\n    38\t\t\t}\r\n    39\t\t\tcps[i] = cp\r\n    40\t\t}\r\n    41\t\r\n    42\t\tvar allNames []string\r\n    43\t\tseen := map[string]bool{}\r\n    44\t\tfor _, cp := range cps {\r\n    45\t\t\tfor _, t := range cp.Tensors {\r\n    46\t\t\t\tif !seen[t.Name] {\r\n    47\t\t\t\t\tseen[t.Name] = true\r\n    48\t\t\t\t\tallNames = append(allNames, t.Name)\r\n    49\t\t\t\t}\r\n"]
[3847.716118, "o", "    50\t\t\t}\r\n    51\t\t}\r\n    52\t\tsort.Strings(allNames)\r\n    53\t\r\n    54\t\tskipped := []string{}\r\n    55\t\ttensors := []TensorResult{}\r\n    56\t\tconverging := 0\r\n    57\t\tdiverging := 0\r\n    58\t\r\n"]
[3847.716175, "o", "    59\t\tfor _, name := range allNames {\r\n    60\t\t\tok := true\r\n    61\t\t\tvar shape []uint32\r\n    62\t\t\tfor _, cp := range cps {\r\n    63\t\t\t\tt, exists := tensorByName(cp, name)\r\n    64\t\t\t\tif !exists {\r\n"]
[3847.716247, "o", "    65\t\t\t\t\tok = false\r\n    66\t\t\t\t\tbreak\r\n    67\t\t\t\t}\r\n    68\t\t\t\tif shape == nil {\r\n    69\t\t\t\t\tshape = t.Shape\r\n    70\t\t\t\t} else if !shapesEqual(shape, t.Shape) {\r\n    71\t\t\t\t\tok = false\r\n    72\t\t\t\t\tbreak\r\n    73\t\t\t\t}\r\n"]
[3847.716305, "o", "    74\t\t\t}\r\n    75\t\t\tif !ok {\r\n    76\t\t\t\tskipped = append(skipped, name)\r\n    77\t\t\t\tcontinue\r\n    78\t\t\t}\r\n    79\t\r\n    80\t\t\tsteps := make([]float64, len(cps)-1)\r\n    81\t\t\tfor i := 0; i < len(cps)-1; i++ {\r\n"]
[3847.716361, "o", "    82\t\t\t\tt1, _ := tensorByName(cps[i], name)\r\n    83\t\t\t\tt2, _ := tensorByName(cps[i+1], name)\r\n    84\t\t\t\tv1, err := t1.Float64Values()\r\n    85\t\t\t\tif err != nil {\r\n    86\t\t\t\t\treturn nil, err\r\n    87\t\t\t\t}\r\n"]
[3847.716417, "o", "    88\t\t\t\tv2, err := t2.Float64Values()\r\n    89\t\t\t\tif err != nil {\r\n    90\t\t\t\t\treturn nil, err\r\n    91\t\t\t\t}\r\n    92\t\t\t\tn := len(v1)\r\n    93\t\t\t\tif n == 0 {\r\n"]
[3847.716473, "o", "    94\t\t\t\t\tsteps[i] = 0\r\n    95\t\t\t\t\tcontinue\r\n    96\t\t\t\t}\r\n    97\t\t\t\tvar sum float64\r\n    98\t\t\t\tfor j := 0; j < n; j++ {\r\n    99\t\t\t\t\tsum += math.Abs(v1[j] - v2[j])\r\n   100\t\t\t\t}\r\n   101\t\t\t\tsteps[i] = sum / float64(n)\r\n"]
[3847.71653, "o", "   102\t\t\t}\r\n   103\t\r\n   104\t\t\tmean := meanFloat64(steps)\r\n   105\t\t\tmax := maxFloat64(steps)\r\n   106\t\t\tconvergence := classifyConvergence(steps)\r\n   107\t\t\tstability := 1.0\r\n   108\t\t\tif steps[0] != 0 {\r\n   109\t\t\t\tstability = 1.0 - steps[len(steps)-1]/steps[0]\r\n"]
[3847.716587, "o", "   110\t\t\t\tif stability < 0 {\r\n   111\t\t\t\t\tstability = 0\r\n   112\t\t\t\t} else if stability > 1 {\r\n   113\t\t\t\t\tstability = 1\r\n   114\t\t\t\t}\r\n   115\t\t\t}\r\n   116\t\r\n   117\t\t\ttensors = append(tensors, TensorResult{\r\n   118\t\t"]
[3847.716643, "o", "\t\tName:           name,\r\n   119\t\t\t\tStepChanges:    steps,\r\n   120\t\t\t\tMeanChange:     mean,\r\n   121\t\t\t\tMaxChange:      max,\r\n   122\t\t\t\tConvergence:    convergence,\r\n   123\t\t\t\tStabilityScore: stability,\r\n   124\t\t\t})\r\n   125\t\r\n   126\t\t\tif convergence == \"converging\" {"]
[3847.716706, "o", "\r\n   127\t\t\t\tconverging++\r\n   128\t\t\t} else if convergence == \"diverging\" {\r\n   129\t\t\t\tdiverging++\r\n   130\t\t\t}\r\n   131\t\t}\r\n   132\t\r\n   133\t\toverall := \"mixed\"\r\n   134\t\tif converging > len(tensors)/2 {\r\n   135\t"]
[3847.716766, "o", "\t\toverall = \"converging\"\r\n   136\t\t} else if diverging > len(tensors)/2 {\r\n   137\t\t\toverall = \"diverging\"\r\n   138\t\t}\r\n   139\t\r\n   140\t\tsort.Strings(skipped)\r\n   141\t\tsort.Slice(tensors, func(i, j int) bool {\r\n   142\t\t\treturn tensors[i].Name < tensors[j].Name\r\n"]
[3847.716821, "o", "   143\t\t})\r\n   144\t\r\n   145\t\treturn &Result{\r\n   146\t\t\tNumSnapshots:       len(files),\r\n   147\t\t\tNumAnalyzedTensors: len(tensors),\r\n   148\t\t\tSkippedTensors:     skipped,\r\n   149\t\t\tTensors:            tensors,\r\n   150\t\t\tOverallConvergence: overall,\r\n"]
