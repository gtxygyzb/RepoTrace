[4014.207274, "o", "   127\t}\r\n   128\t\r\n   129\tfunc runValidateManifest(args []string) int {\r\n   130\t\tif len(args) != 1 {\r\n   131\t\t\toutputJSON(map[string]interface{}{\"error\": \"usage: repro-verify validate-manifest <file.toml>\"})\r\n   132\t\t\treturn 1\r\n   133\t\t}\r\n   134\t\tif _, err := os.ReadFile(args[0]); err != nil {\r\n   135\t\t\toutputJSON(map[string]interface{}{\"error\": err.Error()})\r\n   136\t\t\treturn 1\r\n   137\t\t}\r\n   138\t\tres := manifest.Validate(args[0])\r\n   139\t\toutputJSON(res)\r\n   140\t\tif res.Valid {\r\n   141\t\t\treturn 0\r\n"]
