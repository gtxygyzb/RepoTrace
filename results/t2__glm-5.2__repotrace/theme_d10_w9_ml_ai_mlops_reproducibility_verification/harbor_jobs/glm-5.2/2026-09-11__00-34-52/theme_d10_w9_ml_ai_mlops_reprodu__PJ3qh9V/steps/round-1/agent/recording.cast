[5484.381044, "o", "\u001b[?2004l\r"]
[5484.383897, "o", "type Tensor struct {\r\n\tName     string\r\n\tDtype    uint8\r\n\tShape    []uint32\r\n\tData     []byte\r\n\tChecksum string\r\n}\r\n"]
[5484.383932, "o", "\r\ntype TensorInfo struct {\r\n\tName     string   `json:\"name\"`\r\n\tDtype    string   `json:\"dtype\"`\r\n\tShape    []uint32 `json:\"shape\"`\r\n\tChecksum string   `json:\"checksum\"`\r\n}\r\n\r\n"]
[5484.384194, "o", "func (t Tensor) Info() TensorInfo {\r\n\treturn TensorInfo{\r\n\t\tName:     t.Name,\r\n\t\tDtype:    DtypeName(t.Dtype),\r\n\t\tShape:    t.Shape,\r\n\t\tChecksum: t.Checksum,\r\n\t}\r\n}\r\n\r\ntype Checkpoint struct {\r\n\tVersion      uint32\r\n\tNumTensors   uint32\r\n\tMetadata     map[string]interface{}\r\n\tMetadataRaw  []byte\r\n\tTensors      []Tensor\r\n\tFileChecksum string\r\n\tFilePath     string\r\n}\r\n\r\nfunc ParseFile(path string) (*Checkpoint, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn Parse(data, path)\r\n"]
[5484.38489, "o", "\u001b[?2004h"]
[5484.38498, "o", "root@n30009:/app# "]
