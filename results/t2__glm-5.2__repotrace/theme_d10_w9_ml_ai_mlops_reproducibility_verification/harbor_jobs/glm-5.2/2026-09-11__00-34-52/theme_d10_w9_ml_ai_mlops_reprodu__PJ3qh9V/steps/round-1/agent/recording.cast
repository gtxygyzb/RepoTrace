[5610.974927, "o", "   188\t\t\t}\r\n   189\t\t}\r\n   190\t\r\n   191\t\trep, code := report.Generate(pos[0], *checkpoint, *comparePath, *lineagePath)\r\n   192\t\toutputJSON(rep)\r\n   193\t\treturn code\r\n   194\t}\r\n   195\t\r\n   196\tfunc runMergeCheckpoints(args []string) int {\r\n   197\t\tfs := flag.NewFlagSet(\"merge-checkpoints\", flag.ContinueOnError)\r\n   198\t\tfs.SetOutput(io.Discard)\r\n"]
