[3695.684191, "o", "     1\tpackage lineage\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n"]
[3695.684304, "o", "     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"strings\"\r\n     8\t\t\"time\"\r\n     9\t)\r\n    10\t\r\n    11\ttype Experiment struct {\r\n    12\t\tID             string   `json:\"id\"`\r\n    13\t\tName           string   `json:\"name\"`\r\n    14\t\tParents        []string `json:\"parents\"`\r\n    15\t\tCheckpointHash string   `json:\"checkpoint_hash\"`\r\n    16\t\tTimestamp      string   `json:\"timestamp\"`\r\n    17\t}\r\n    18\t\r\n"]
[3695.684375, "o", "    19\ttype Input struct {\r\n    20\t\tExperiments []Experiment `json:\"experiments\"`\r\n    21\t}\r\n    22\t\r\n    23\ttype Result struct {\r\n    24\t\tValid            bool     `json:\"valid\"`\r\n    25\t\tNumExperiments   int      `json:\"num_experiments\"`\r\n    26\t\tNumRoots         int      `json:\"num_roots\"`\r\n    27\t\tNumLeaves        int      `json:\"num_leaves\"`\r\n"]
[3695.684436, "o", "    28\t\tMaxDepth         int      `json:\"max_depth\"`\r\n    29\t\tTopologicalOrder []string `json:\"topological_order\"`\r\n    30\t\tErrors           []string `json:\"errors,omitempty\"`\r\n    31\t}\r\n    32\t\r\n    33\tfunc Audit(path string) *Result {\r\n    34\t\tdata, err := os.ReadFile(path)\r\n    35\t\tif err != nil {\r\n    36\t\t\treturn &Result{\r\n    37\t\t\t\tValid:  false,\r\n    38"]
[3695.684496, "o", "\t\t\t\tErrors: []string{fmt.Sprintf(\"failed to read lineage file: %v\", err)},\r\n    39\t\t\t}\r\n    40\t\t}\r\n    41\t\r\n    42\t\tvar in Input\r\n    43\t\tif err := json.Unmarshal(data, &in); err != nil {\r\n    44\t\t\treturn &Result{\r\n    45\t"]
[3695.684555, "o", "\t\t\tValid:  false,\r\n    46\t\t\t\tErrors: []string{fmt.Sprintf(\"failed to parse lineage JSON: %v\", err)},\r\n    47\t\t\t}\r\n    48\t\t}\r\n    49\t\r\n    50\t\texps := in.Experiments\r\n    51\t\tresult := &Result{\r\n    52\t\t\tValid:            true,\r\n    53\t\t"]
