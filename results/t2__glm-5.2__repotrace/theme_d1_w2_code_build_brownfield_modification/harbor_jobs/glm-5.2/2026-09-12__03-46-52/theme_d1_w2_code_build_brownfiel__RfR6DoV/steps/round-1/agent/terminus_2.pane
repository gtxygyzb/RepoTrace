[?2004l#ifndef MINICC_COMMON_H
#define MINICC_COMMON_H

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <ctype.h>

#define MAX_IDENT_LEN 64
#define MAX_STRING_LEN 1024
#define MAX_TOKENS 4096
#define MAX_LOCALS 256
#define MAX_FUNCTIONS 128
#define MAX_BYTECODE 16384
#define MAX_STACK 1024
#define MAX_CALL_FRAMES 64
#define MAX_GLOBALS 256
#define MAX_AST_NODES 8192
#define MAX_PARAMS 16

typedef enum {
    TOK_NUM, TOK_STRING, TOK_IDENT,
    TOK_PLUS, TOK_MINUS, TOK_STAR, TOK_SLASH, TOK_PERCENT,
    TOK_EQ, TOK_NEQ, TOK_LT, TOK_GT, TOK_LEQ, TOK_GEQ,
    TOK_ASSIGN, TOK_AND, TOK_OR, TOK_NOT,
    TOK_LPAREN, TOK_RPAREN, TOK_LBRACE, TOK_RBRACE,
    TOK_LBRACKET, TOK_RBRACKET,
    TOK_SEMICOLON, TOK_COMMA,
    TOK_IF, TOK_ELSE, TOK_WHILE, TOK_FOR, TOK_RETURN,
    TOK_BREAK, TOK_CONTINUE, TOK_IN, TOK_OF,
    TOK_FN, TOK_LET, TOK_PRINT, TOK_TRUE, TOK_FALSE,
    TOK_DOT,
    TOK_COLON,
    TOK_PLUS_ASSIGN, TOK_MINUS_ASSIGN, TOK_STAR_ASSIGN, TOK_SLASH_ASSIGN, TOK_PERCENT_ASSIGN,
    TOK_EOF, TOK_ERROR
} TokenType;

typedef struct {
    TokenType type;
    char text[MAX_STRING_LEN];
    int line;
    int col;
    union {
        int64_t ival;
        double fval;
    } literal;
} Token;

typedef enum {
    NODE_NUM_LIT, NODE_STR_LIT, NODE_BOOL_LIT,
    NODE_IDENT, NODE_BINOP, NODE_UNARY,
    NODE_CALL, NODE_INDEX,
    NODE_ASSIGN, NODE_LET,
    NODE_IF, NODE_WHILE, NODE_FOR, NODE_FOREACH,
    NODE_RETURN, NODE_BREAK, NODE_CONTINUE,
    NODE_PRINT, NODE_BLOCK, NODE_FUNC,
    NODE_ARRAY_LIT, NODE_MAP_LIT, NODE_FIELD_ACCESS, NODE_FIELD_ASSIGN,
    NODE_EXPR_STMT,
    NODE_COMPOUND_ASSIGN, NODE_INDEX_ASSIGN, NODE_CLOSURE
} NodeType;

typedef enum {
    OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_MOD,
    OP_EQ, OP_NEQ, OP_LT, OP_GT, OP_LEQ, OP_GEQ,
    OP_AND, OP_OR
} BinOp;

typedef enum {
    UNOP_NEG, UNOP_NOT
} UnaryOp;

struct ASTNode;

typedef struct {
    struct ASTNode **items;
    int count;
    int cap;
} NodeList;

typedef struct ASTNode {
    NodeType type;
    int line;
    union {
        int64_t num_val;
        char str_val[MAX_STRING_LEN];
        int bool_val;
        char ident[MAX_IDENT_LEN];
        struct { BinOp op; struct ASTNode *left, *right; } binop;
        struct { UnaryOp op; struct ASTNode *operand; } unary;
        struct { char name[MAX_IDENT_LEN]; NodeList args; } call;
        struct { struct ASTNode *obj; struct ASTNode *index; } index_access;
        struct { char name[MAX_IDENT_LEN]; struct ASTNode *value; } assign;
    struct { char name[MAX_IDENT_LEN]; BinOp op; struct ASTNode *value; } compound_assign;
        struct { char name[MAX_IDENT_LEN]; struct ASTNode *obj; struct ASTNode *index; struct ASTNode *value; } index_assign;
        struct { char name[MAX_IDENT_LEN]; struct ASTNode *init; } let;
        struct { struct ASTNode *cond, *then_b, *else_b; } if_stmt;
        struct { struct ASTNode *cond, *body; } while_stmt;
    struct { struct ASTNode *init, *cond, *step, *body; } for_stmt;
    struct { char var[MAX_IDENT_LEN]; struct ASTNode *arr; struct ASTNode *body; int is_of; } foreach_stmt;
        struct { struct ASTNode *value; } ret;
        struct { struct ASTNode *value; } print;
        struct { NodeList stmts; } block;
        struct { char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } closure;
        struct { char name[MAX_IDENT_LEN]; char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } func;
        struct { NodeList elems; } array_lit;
        struct { NodeList keys; NodeList values; } map_lit;
        struct { struct ASTNode *obj; char field[MAX_IDENT_LEN]; } field_access;
        struct { struct ASTNode *obj; char field[MAX_IDENT_LEN]; struct ASTNode *value; } field_assign;
        struct { struct ASTNode *expr; } expr_stmt;
    } data;
} ASTNode;

typedef enum {
    BC_PUSH_INT, BC_PUSH_STR, BC_PUSH_BOOL,
    BC_LOAD_LOCAL, BC_STORE_LOCAL,
    BC_LOAD_GLOBAL, BC_STORE_GLOBAL,
    BC_ADD, BC_SUB, BC_MUL, BC_DIV, BC_MOD,
    BC_EQ, BC_NEQ, BC_LT, BC_GT, BC_LEQ, BC_GEQ,
    BC_AND, BC_OR, BC_NOT, BC_NEG,
    BC_JUMP, BC_JUMP_FALSE,
    BC_CALL, BC_RET,
    BC_PRINT, BC_POP,
    BC_PUSH_ARRAY, BC_INDEX, BC_INDEX_STORE, BC_ARRAY_PUSH,
    BC_DUP, BC_JUMP_TRUE,
    BC_MAKE_CLOSURE, BC_CALL_VALUE,
    BC_LOAD_CAPTURE, BC_STORE_CAPTURE,
    BC_HALT,
    BC_ARRAY_LEN, BC_ARRAY_GET,
    BC_PUSH_MAP, BC_MAP_GET, BC_MAP_SET, BC_MAP_KEYS, BC_MAP_HAS, BC_MAP_DELETE, BC_MAP_LEN,
    BC_ITER_KEY,
    BC_BREAK, BC_CONTINUE,
    BC_FOREACH_PREP, BC_FOREACH_NEXT
} Opcode;

typedef enum {
    VAL_INT, VAL_STR, VAL_BOOL, VAL_ARRAY, VAL_CLOSURE, VAL_MAP, VAL_NULL
} ValueType;

typedef struct ArrayData {
    struct Value *items;
    int len;
    int cap;
} ArrayData;

typedef struct MapData {
    char **keys;
    struct Value *values;
    int len;
    int cap;
} MapData;

typedef struct Value {
    ValueType type;
    union {
        int64_t ival;
        char *sval;
        int bval;
        ArrayData array;
        MapData *map;
        struct { int func_idx; struct Value *captures; int capture_count; } closure;
    } data;
} Value;

typedef struct {
    Opcode op;
    int64_t operand;
    char *str_operand;
} Instruction;

typedef struct {
    int ip;
    int bp;
    int local_start;
    struct Value *captures;
    int capture_count;
} CallFrame;

void error_at(int line, const char *fmt, ...);

#endif
