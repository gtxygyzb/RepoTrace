    12	
    13	static char peek(Lexer *lex) { return lex->source[lex->pos]; }
    14	
    15	static char advance(Lexer *lex) {
    16	    char c = lex->source[lex->pos++];
    17	    if (c == '\n') { lex->line++; lex->col = 1; } else { lex->col++; }
    18	    return c;
    19	}
    20	
    21	static int is_at_end(Lexer *lex) { return lex->source[lex->pos] == '\0'; }
    22	
    23	static void skip_whitespace(Lexer *lex) {
    24	    while (!is_at_end(lex)) {
    25	        char c = peek(lex);
    26	        if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
    27	            advance(lex);
    28	        } else if (c == '/' && lex->source[lex->pos + 1] == '/') {
    29	            while (!is_at_end(lex) && peek(lex) != '\n') advance(lex);
    30	        } else {
    31	            break;
    32	        }
    33	    }
    34	}
    35	
    36	static Token make_token(Lexer *lex, TokenType type, const char *text) {
    37	    Token t;
    38	    t.type = type;
    39	    strncpy(t.text, text, MAX_STRING_LEN - 1);
    40	    t.text[MAX_STRING_LEN - 1] = '\0';
    41	    t.line = lex->line;
    42	    t.col = lex->col;
    43	    t.literal.ival = 0;
    44	    return t;
    45	}
    46	
    47	static int add_token(Lexer *lex, Token t) {
    48	    if (lex->token_count >= MAX_TOKENS) { error_at(lex->line, "too many tokens"); return -1; }
    49	    lex->tokens[lex->token_count++] = t;
    50	    return 0;
    51	}
    52	
    53	static int lex_number(Lexer *lex) {
    54	    char buf[64]; int i = 0;
    55	    while (!is_at_end(lex) && isdigit(peek(lex))) {
    56	        if (i < 63) buf[i++] = advance(lex); else advance(lex);
    57	    }
    58	    buf[i] = '\0';
    59	    Token t = make_token(lex, TOK_NUM, buf);
    60	    t.literal.ival = strtoll(buf, NULL, 10);
    61	    return add_token(lex, t);
    62	}
    63	
    64	static int lex_string(Lexer *lex) {
    65	    advance(lex);
    66	    char buf[MAX_STRING_LEN]; int i = 0;
    67	    while (!is_at_end(lex) && peek(lex) != '"') {
    68	        char c = advance(lex);
    69	        if (c == '\\' && !is_at_end(lex)) {
    70	            // NOTE: escape sequences are not interpreted here; the backslash
    71	            // is copied literally and the following character is emitted as-is.
    72	            if (i < MAX_STRING_LEN - 1) buf[i++] = c;
    73	            c = advance(lex);
    74	        }
    75	        if (i < MAX_STRING_LEN - 1) buf[i++] = c;
    76	    }
    77	    if (is_at_end(lex)) { error_at(lex->line, "unterminated string"); return -1; }
    78	    advance(lex);
    79	    buf[i] = '\0';
    80	    Token t = make_token(lex, TOK_STRING, buf);
    81	    return add_token(lex, t);
    82	}
    83	
    84	static int lex_ident(Lexer *lex) {
    85	    char buf[MAX_IDENT_LEN]; int i = 0;
    86	    while (!is_at_end(lex) && (isalnum(peek(lex)) || peek(lex) == '_')) {
    87	        if (i < MAX_IDENT_LEN - 1) buf[i++] = advance(lex); else advance(lex);
    88	    }
    89	    buf[i] = '\0';
    90	    TokenType type = TOK_IDENT;
    91	    if      (strcmp(buf, "if") == 0)       type = TOK_IF;
    92	    else if (strcmp(buf, "else") == 0)     type = TOK_ELSE;
    93	    else if (strcmp(buf, "while") == 0)    type = TOK_WHILE;
    94	    else if (strcmp(buf, "return") == 0)   type = TOK_RETURN;
    95	    else if (strcmp(buf, "fn") == 0)       type = TOK_FN;
    96	    else if (strcmp(buf, "let") == 0)      type = TOK_LET;
    97	    else if (strcmp(buf, "print") == 0)    type = TOK_PRINT;
    98	    else if (strcmp(buf, "true") == 0)     type = TOK_TRUE;
    99	    else if (strcmp(buf, "false") == 0)    type = TOK_FALSE;
   100	    Token t = make_token(lex, type, buf);
   101	    return add_token(lex, t);
   102	}
