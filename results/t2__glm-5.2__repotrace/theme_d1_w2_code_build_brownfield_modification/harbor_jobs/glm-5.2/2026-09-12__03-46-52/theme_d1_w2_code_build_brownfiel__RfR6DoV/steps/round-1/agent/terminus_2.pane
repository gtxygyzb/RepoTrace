[?2004lCC = gcc
CFLAGS = -Wall -Wextra -std=c11 -g -D_GNU_SOURCE
SRCS = src/main.c src/lexer.c src/ast.c src/parser.c src/codegen.c src/vm.c
OBJS = $(SRCS:.c=.o)
TARGET = minicc

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^

src/%.o: src/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJS) $(TARGET)

.PHONY: all clean
