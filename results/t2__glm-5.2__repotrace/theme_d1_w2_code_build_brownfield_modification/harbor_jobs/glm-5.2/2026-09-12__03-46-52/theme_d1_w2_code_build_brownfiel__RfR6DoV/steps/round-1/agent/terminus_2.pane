                case ')': type = TOK_RPAREN; break;
                case '{': type = TOK_LBRACE; break;
                case '}': type = TOK_RBRACE; break;
                case '[': type = TOK_LBRACKET; break;
                case ']': type = TOK_RBRACKET; break;
                case ';': type = TOK_SEMICOLON; break;
                case ',': type = TOK_COMMA; break;
                case '!': if (peek(lex)=='='){advance(lex);type=TOK_NEQ;strcpy(buf,"!=");}else{type=TOK_NOT;} break;
                case '=': if (peek(lex)=='='){advance(lex);type=TOK_EQ;strcpy(buf,"==");}else{type=TOK_ASSIGN;} break;
                case '<': if (peek(lex)=='='){advance(lex);type=TOK_LEQ;strcpy(buf,"<=");}else{type=TOK_LT;} break;
                case '>': if (peek(lex)=='='){advance(lex);type=TOK_GEQ;strcpy(buf,">=");}else{type=TOK_GT;} break;
                case '&': if (peek(lex)=='&'){advance(lex);type=TOK_AND;strcpy(buf,"&&");}
                          else{error_at(lex->line,"unexpected character '&'");return -1;} break;
                case '|': if (peek(lex)=='|'){advance(lex);type=TOK_OR;strcpy(buf,"||");}
                          else{error_at(lex->line,"unexpected character '|'");return -1;} break;
