   297	    if (match(p, TOK_WHILE)) {
   298	        int line = prev(p)->line;
   299	        expect(p, TOK_LPAREN, "'('");
   300	        ASTNode *cond = parse_expr(p);
   301	        expect(p, TOK_RPAREN, "')'");
