[?2004l     1	#include "parser.h"
     2	
     3	static Token *current(Parser *p) { return &p->tokens[p->pos]; }
     4	static Token *prev(Parser *p) { return &p->tokens[p->pos - 1]; }
     5	static int check(Parser *p, TokenType t) { return current(p)->type == t; }
     6	
     7	static int match(Parser *p, TokenType t) {
     8	    if (check(p, t)) { p->pos++; return 1; }
     9	    return 0;
    10	}
    11	
    12	static void expect(Parser *p, TokenType t, const char *msg) {
    13	    if (!match(p, t)) {
    14	        error_at(current(p)->line, "expected %s, got '%s'", msg, current(p)->text);
    15	        p->had_error = 1;
    16	    }
    17	}
    18	
    19	static ASTNode *parse_expr(Parser *p);
    20	static ASTNode *parse_stmt(Parser *p);
    21	static ASTNode *parse_block(Parser *p);
    22	static ASTNode *parse_factor(Parser *p);
    23	static ASTNode *parse_term(Parser *p);
    24	static ASTNode *parse_comparison(Parser *p);
    25	static ASTNode *parse_logic_and(Parser *p);
    26	static ASTNode *parse_fn_expr(Parser *p);
    27	
    28	static ASTNode *parse_primary(Parser *p) {
    29	    if (match(p, TOK_NUM)) {
    30	        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;
    31	        n->data.num_val = prev(p)->literal.ival; return n;
    32	    }
    33	    if (match(p, TOK_STRING)) {
    34	        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;
    35	        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return n;
    36	    }
    37	    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {
    38	        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;
    39	        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;
    40	    }
    41	    if (match(p, TOK_IDENT)) {
    42	        char name[MAX_IDENT_LEN];
    43	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\0';
    44	        int line = prev(p)->line;
    45	        if (match(p, TOK_LPAREN)) {
    46	            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;
    47	            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);
    48	            nodelist_init(&n->data.call.args);
    49	            if (!check(p, TOK_RPAREN)) {
    50	                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));
    51	            }
    52	            expect(p, TOK_RPAREN, "')'"); return n;
    53	        }
    54	        if (match(p, TOK_LBRACKET)) {
    55	            ASTNode *idx = parse_expr(p); expect(p, TOK_RBRACKET, "']'");
    56	            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;
    57	            ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;
    58	            strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);
    59	            n->data.index_access.obj = obj; n->data.index_access.index = idx; return n;
    60	        }
    61	        ASTNode *n = ast_alloc(); n->type = NODE_IDENT; n->line = line;
    62	        strncpy(n->data.ident, name, MAX_IDENT_LEN - 1); return n;
    63	    }
    64	    if (match(p, TOK_FN)) {
    65	        return parse_fn_expr(p);
    66	    }
    67	    if (match(p, TOK_LBRACKET)) {
    68	        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;
    69	        nodelist_init(&n->data.array_lit.elems);
    70	        if (!check(p, TOK_RBRACKET)) {
    71	            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));
    72	        }
    73	        expect(p, TOK_RBRACKET, "']'"); return n;
    74	    }
    75	    if (match(p, TOK_LPAREN)) {
    76	        ASTNode *expr = parse_expr(p); expect(p, TOK_RPAREN, "')'"); return expr;
    77	    }
    78	    error_at(current(p)->line, "unexpected token '%s'", current(p)->text);
    79	    p->had_error = 1; p->pos++; return ast_alloc();
    80	}
    81	
    82	static ASTNode *parse_fn_expr(Parser *p) {
    83	    int line = prev(p)->line;
    84	    expect(p, TOK_LPAREN, "'('");
    85	    ASTNode *n = ast_alloc(); n->type = NODE_CLOSURE; n->line = line;
    86	    n->data.closure.param_count = 0;
    87	    if (!check(p, TOK_RPAREN)) {
    88	        do {
    89	            expect(p, TOK_IDENT, "parameter name");
    90	            strncpy(n->data.closure.params[n->data.closure.param_count],
    91	                   prev(p)->text, MAX_IDENT_LEN - 1);
    92	            n->data.closure.param_count++;
    93	        } while (match(p, TOK_COMMA));
    94	    }
    95	    expect(p, TOK_RPAREN, "')'");
    96	    n->data.closure.body = parse_block(p);
    97	    return n;
    98	}
    99	
   100	static ASTNode *parse_unary(Parser *p) {
   101	    if (match(p, TOK_MINUS)) {
   102	        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
   103	        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
   104	        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;
   105	    }
   106	    if (match(p, TOK_NOT)) {
   107	        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
   108	        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
   109	        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;
   110	    }
   111	    return parse_primary(p);
   112	}
   113	
   114	static ASTNode *parse_factor(Parser *p) {
   115	    ASTNode *left = parse_unary(p);
   116	    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {
   117	        int line = prev(p)->line; BinOp op;
   118	        if (prev(p)->type == TOK_STAR) op = OP_MUL;
   119	        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;
   120	        else op = OP_MOD;
   121	        ASTNode *right = parse_unary(p);
   122	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   123	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   124	        left = n;
   125	    }
   126	    return left;
   127	}
   128	
   129	static ASTNode *parse_comparison(Parser *p) {
   130	    ASTNode *left = parse_term(p);
   131	    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||
   132	           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {
   133	        int line = prev(p)->line; BinOp op;
   134	        switch (prev(p)->type) {
   135	            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;
   136	            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;
   137	            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;
   138	            default: op = OP_EQ; break;
   139	        }
   140	        ASTNode *right = parse_term(p);
   141	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   142	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   143	        left = n;
   144	    }
   145	    return left;
   146	}
   147	
   148	static ASTNode *parse_term(Parser *p) {
   149	    ASTNode *left = parse_factor(p);
   150	    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {
   151	        int line = prev(p)->line;
   152	        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;
   153	        ASTNode *right = parse_factor(p);
   154	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   155	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   156	        left = n;
   157	    }
   158	    return left;
   159	}
   160	
   161	static ASTNode *parse_logic_and(Parser *p) {
   162	    ASTNode *left = parse_comparison(p);
   163	    while (match(p, TOK_AND)) {
   164	        int line = prev(p)->line; ASTNode *right = parse_comparison(p);
   165	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   166	        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;
   167	        left = n;
   168	    }
   169	    return left;
   170	}
   171	
   172	static ASTNode *parse_expr(Parser *p) {
   173	    ASTNode *left = parse_logic_and(p);
   174	    while (match(p, TOK_OR)) {
   175	        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);
   176	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   177	        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;
   178	        left = n;
   179	    }
   180	    return left;
   181	}
   182	
   183	static ASTNode *try_parse_assign(Parser *p) {
   184	    if (!check(p, TOK_IDENT)) return NULL;
   185	    int saved = p->pos;
   186	    p->pos++;
   187	    char name[MAX_IDENT_LEN];
   188	    strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   189	    int line = prev(p)->line;
   190	    if (match(p, TOK_LBRACKET)) {
   191	        ASTNode *idx = parse_expr(p);
   192	        expect(p, TOK_RBRACKET, "']'");
   193	        if (check(p, TOK_ASSIGN)) {
   194	            match(p, TOK_ASSIGN);
   195	            ASTNode *val = parse_expr(p);
   196	            ASTNode *n = ast_alloc(); n->type = NODE_INDEX_ASSIGN; n->line = line;
   197	            strncpy(n->data.index_assign.name, name, MAX_IDENT_LEN - 1);
   198	            n->data.index_assign.index = idx;
   199	            n->data.index_assign.value = val;
   200	            return n;
   201	        }
   202	        p->pos = saved;
   203	        return NULL;
   204	    }
   205	    if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||
   206	        check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {
   207	        p->pos = saved; match(p, TOK_IDENT);
   208	        TokenType op_tok = current(p)->type;
   209	        BinOp op = OP_ADD;
   210	        const char *msg = "'='";
   211	        if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = "'+='"; expect(p, TOK_PLUS_ASSIGN, "'+='"); }
   212	        else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = "'-='"; expect(p, TOK_MINUS_ASSIGN, "'-='"); }
   213	        else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = "'*='"; expect(p, TOK_STAR_ASSIGN, "'*='"); }
   214	        else if (op_tok == TOK_SLASH_ASSIGN) { op = OP_DIV; msg = "'/='"; expect(p, TOK_SLASH_ASSIGN, "'/='"); }
   215	        else if (op_tok == TOK_PERCENT_ASSIGN) { op = OP_MOD; msg = "'%='"; expect(p, TOK_PERCENT_ASSIGN, "'%='"); }
   216	        else { expect(p, TOK_ASSIGN, "'='"); }
   217	        ASTNode *val = parse_expr(p);
   218	        if (op_tok == TOK_ASSIGN) {
   219	            ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;
   220	            strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);
   221	            n->data.assign.value = val; return n;
   222	        } else {
   223	            ASTNode *n = ast_alloc(); n->type = NODE_COMPOUND_ASSIGN; n->line = line;
   224	            strncpy(n->data.compound_assign.name, name, MAX_IDENT_LEN - 1);
   225	            n->data.compound_assign.op = op;
   226	            n->data.compound_assign.value = val; return n;
   227	        }
   228	    }
   229	    p->pos = saved; return NULL;
   230	}
