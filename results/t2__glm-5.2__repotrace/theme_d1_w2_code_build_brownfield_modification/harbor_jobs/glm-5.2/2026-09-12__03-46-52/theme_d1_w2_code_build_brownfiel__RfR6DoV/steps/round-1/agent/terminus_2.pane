new = '''            case BC_REST_PARAM: {
                int named = (int)ins->operand;
                CallFrame *frame = &vm->frames[vm->frame_count - 1];
                int arg_count = vm->sp - frame->local_start;
                int extra = arg_count - named;
                if (extra < 0) {
                    while (extra < 0) { push(vm, make_null()); extra++; }
                    arg_count = named;
                    extra = 0;
                }
                Value rest = make_array_cap(extra);
                for (int i = 0; i < extra; i++)
                    rest.data.array.items[i] = vm->stack[frame->local_start + named + i];
                rest.data.array.len = extra;
                vm->sp = frame->local_start + named;
                push(vm, rest);
                break;
            }
'''
