[?2004lstatic ASTNode *parse_postfix(Parser *p, ASTNode *expr) {$
    for (;;) {$
        if (match(p, TOK_DOT)) {$
            int line = prev(p)->line;$
            expect(p, TOK_IDENT, "field name");$
            ASTNode *n = ast_alloc(); n->type = NODE_FIELD_ACCESS; n->line = line;$
            n->data.field_access.obj = expr;$
            strncpy(n->data.field_access.field, prev(p)->text, MAX_IDENT_LEN - 1);$
            n->data.field_access.field[MAX_IDENT_LEN - 1] = '\0';$
            expr = n;$
        } else if (match(p, TOK_LBRACKET)) {$
            int line = prev(p)->line;$
            ASTNode *idx = parse_expr(p);$
            expect(p, TOK_RBRACKET, "']'");$
            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;$
            n->data.index_access.obj = expr;$
            n->data.index_access.index = idx;$
            expr = n;$
        } else {$
            break;$
        }$
    }$
    return expr;$
}$
