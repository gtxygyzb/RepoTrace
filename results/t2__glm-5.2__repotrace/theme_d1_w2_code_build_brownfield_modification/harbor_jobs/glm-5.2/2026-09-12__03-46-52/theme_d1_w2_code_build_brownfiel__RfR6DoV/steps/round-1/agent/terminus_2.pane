    68	static int64_t value_to_int(Value v) {
    69	    if (v.type == VAL_REF) return value_to_int(*v.data.ref);
    70	    switch (v.type) { case VAL_INT: return v.data.ival; case VAL_BOOL: return v.data.bval ? 1 : 0; default: return 0; }
    71	}
    72	
    73	static int value_is_integer_like(Value v) {
    74	    if (v.type == VAL_REF) return value_is_integer_like(*v.data.ref);
    75	    return v.type == VAL_INT || v.type == VAL_BOOL;
    76	}
    77	
    78	static int value_truthy(Value v) {
    79	    if (v.type == VAL_REF) return value_truthy(*v.data.ref);
    80	    switch (v.type) {
    81	        case VAL_INT: return v.data.ival != 0;
    82	        case VAL_BOOL: return v.data.bval;
    83	        case VAL_STR: return v.data.sval && v.data.sval[0] != '\0';
    84	        case VAL_ARRAY: return v.data.array.len > 0;
    85	        case VAL_MAP: return v.data.map && v.data.map->len > 0;
    86	        case VAL_NULL: return 0;
    87	    }
    88	    return 0;
    89	}
    90	
    91	static int values_equal(Value a, Value b) {
    92	    if (a.type == VAL_REF) return values_equal(*a.data.ref, b);
    93	    if (b.type == VAL_REF) return values_equal(a, *b.data.ref);
    94	    if (a.type != b.type) return 0;
    95	    switch (a.type) {
    96	        case VAL_INT: return a.data.ival == b.data.ival;
    97	        case VAL_BOOL: return a.data.bval == b.data.bval;
    98	        case VAL_STR: return strcmp(a.data.sval, b.data.sval) == 0;
    99	        case VAL_NULL: return 1;
   100	        default: return 0;
   101	    }
   102	}
   103	
   104	static const char *value_to_cstr(Value v, char *buf, size_t size) {
   105	    if (v.type == VAL_REF) return value_to_cstr(*v.data.ref, buf, size);
   106	    switch (v.type) {
   107	        case VAL_STR: return v.data.sval;
   108	        case VAL_INT: snprintf(buf, size, "%lld", (long long)v.data.ival); return buf;
   109	        case VAL_BOOL: return v.data.bval ? "true" : "false";
   110	        case VAL_NULL: return "null";
   111	        default: return "";
   112	    }
   113	}
   114	
   115	static const char *value_to_key(Value v, char *buf, size_t size) {
   116	    if (v.type == VAL_STR) return v.data.sval;
   117	    return value_to_cstr(v, buf, size);
   118	}
   119	
   120	static int value_cmp(Value a, Value b) {
   121	    if (a.type == VAL_STR && b.type == VAL_STR)
   122	        return strcmp(a.data.sval, b.data.sval);
   123	    int64_t ia = value_to_int(a), ib = value_to_int(b);
   124	    return ia < ib ? -1 : (ia > ib ? 1 : 0);
   125	}
   126	
   127	static void print_value(Value v) {
   128	    switch (v.type) {
   129	        case VAL_INT: printf("%lld", (long long)v.data.ival); break;
   130	        case VAL_BOOL: printf("%s", v.data.bval ? "true" : "false"); break;
   131	        case VAL_STR: printf("%s", v.data.sval); break;
   132	        case VAL_ARRAY:
   133	            printf("[");
   134	            for (int i = 0; i < v.data.array.len; i++) {
   135	                if (i > 0) printf(", ");
   136	                print_value(v.data.array.items[i]);
   137	            }
   138	            printf("]");
   139	            break;
   140	        case VAL_MAP:
   141	            printf("{");
   142	            for (int i = 0; i < v.data.map->len; i++) {
   143	                if (i > 0) printf(", ");
   144	                printf("%s", v.data.map->keys[i]);
   145	                printf(": ");
   146	                print_value(v.data.map->values[i]);
   147	            }
   148	            printf("}");
   149	            break;
   150	        case VAL_NULL: printf("null"); break;
   151	        case VAL_CLOSURE: printf("<closure>"); break;
   152	        case VAL_REF: print_value(*v.data.ref); break;
   153	    }
   154	}
