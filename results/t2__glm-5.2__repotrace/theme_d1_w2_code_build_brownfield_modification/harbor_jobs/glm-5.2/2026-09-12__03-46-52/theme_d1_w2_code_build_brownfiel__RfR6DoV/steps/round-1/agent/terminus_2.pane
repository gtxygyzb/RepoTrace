   213	static int compile_node(Compiler *c, ASTNode *node);
   214	
   215	static int compile_expr(Compiler *c, ASTNode *node) {
   216	    switch (node->type) {
   217	        case NODE_NUM_LIT:
   218	            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;
   219	        case NODE_STR_LIT: {
   220	            char *s = strdup(node->data.str_val);
   221	            emit(c, BC_PUSH_STR, 0, s); break;
   222	        }
   223	        case NODE_BOOL_LIT:
   224	            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;
   225	        case NODE_IDENT: {
   226	            compile_load(c, node->data.ident);
   227	            break;
   228	        }
   229	        case NODE_BINOP:
   230	            compile_expr(c, node->data.binop.left);
   231	            compile_expr(c, node->data.binop.right);
   232	            switch (node->data.binop.op) {
   233	                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;
   234	                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;
   235	                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
   236	                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
   237	                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
   238	                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;
   239	                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;
   240	                case OP_LT:  emit(c, BC_LT, 0, NULL); break;
   241	                case OP_GT:  emit(c, BC_GT, 0, NULL); break;
   242	                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;
   243	                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;
   244	                case OP_AND: emit(c, BC_AND, 0, NULL); break;
   245	                case OP_OR:  emit(c, BC_OR, 0, NULL); break;
   246	            }
   247	            break;
   248	        case NODE_UNARY:
   249	            compile_expr(c, node->data.unary.operand);
   250	            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);
   251	            else emit(c, BC_NOT, 0, NULL);
   252	            break;
   253	        case NODE_CALL: {
   254	            const char *name = node->data.call.name;
   255	            if (strcmp(name, "len") == 0) {
   256	                if (node->data.call.args.count != 1) { error_at(node->line, "len() expects 1 argument"); return -1; }
   257	                compile_expr(c, node->data.call.args.items[0]);
   258	                emit(c, BC_ARRAY_LEN, 0, NULL);
   259	                break;
   260	            }
   261	            if (strcmp(name, "keys") == 0) {
   262	                if (node->data.call.args.count != 1) { error_at(node->line, "keys() expects 1 argument"); return -1; }
   263	                compile_expr(c, node->data.call.args.items[0]);
   264	                emit(c, BC_MAP_KEYS, 0, NULL);
   265	                break;
   266	            }
   267	            if (strcmp(name, "delete") == 0) {
   268	                if (node->data.call.args.count != 2) { error_at(node->line, "delete() expects 2 arguments"); return -1; }
   269	                compile_expr(c, node->data.call.args.items[0]);
   270	                compile_expr(c, node->data.call.args.items[1]);
   271	                emit(c, BC_MAP_DELETE, 0, NULL);
   272	                break;
   273	            }
   274	            if (strcmp(name, "has") == 0) {
   275	                if (node->data.call.args.count != 2) { error_at(node->line, "has() expects 2 arguments"); return -1; }
   276	                compile_expr(c, node->data.call.args.items[0]);
   277	                compile_expr(c, node->data.call.args.items[1]);
   278	                emit(c, BC_MAP_HAS, 0, NULL);
   279	                break;
   280	            }
   281	            int fi = find_function(c, name);
   282	            if (fi >= 0) {
   283	                for (int i = 0; i < node->data.call.args.count; i++)
   284	                    compile_expr(c, node->data.call.args.items[i]);
   285	                emit(c, BC_CALL, fi, NULL);
   286	            } else {
   287	                for (int i = 0; i < node->data.call.args.count; i++)
   288	                    compile_expr(c, node->data.call.args.items[i]);
   289	                compile_load(c, name);
   290	                emit(c, BC_CALL_VALUE, node->data.call.args.count, NULL);
   291	            }
   292	            break;
   293	        }
   294	        case NODE_CLOSURE: {
   295	            char bound_names[MAX_LOCALS][MAX_IDENT_LEN]; int bound_count = 0;
   296	            for (int i = 0; i < node->data.closure.param_count; i++)
   297	                add_name(bound_names, &bound_count, node->data.closure.params[i]);
   298	            collect_bound_names(node->data.closure.body, bound_names, &bound_count);
   299	            char free_names[MAX_LOCALS][MAX_IDENT_LEN]; int free_count = 0;
   300	            collect_free_names(node->data.closure.body, bound_names, bound_count, free_names, &free_count);
   301	
   302	            char cap_names[MAX_LOCALS][MAX_IDENT_LEN]; int cap_count = 0;
   303	            int cap_slots[MAX_LOCALS];
   304	            for (int i = 0; i < free_count; i++) {
   305	                const char *nm = free_names[i];
   306	                int slot = resolve_local(c, nm);
   307	                if (slot >= 0) {
   308	                    add_name(cap_names, &cap_count, nm);
   309	                    cap_slots[cap_count - 1] = slot;
   310	                    c->locals[slot].is_boxed = 1;
   311	                } else {
   312	                    int cap = resolve_capture(c, nm);
   313	                    if (cap >= 0) {
   314	                        add_name(cap_names, &cap_count, nm);
   315	                        cap_slots[cap_count - 1] = -1 - cap;
   316	                    }
   317	                }
   318	            }
   319	
   320	            if (c->func_count >= MAX_FUNCTIONS) { fprintf(stderr, "too many functions\n"); return -1; }
   321	            FuncInfo *fi = &c->functions[c->func_count];
   322	            snprintf(fi->name, MAX_IDENT_LEN, "__closure_%d", c->func_count);
   323	            fi->param_count = node->data.closure.param_count;
   324	            fi->capture_count = cap_count;
   325	            for (int i = 0; i < cap_count; i++) fi->capture_slots[i] = cap_slots[i];
   326	            int func_idx = c->func_count++;
   327	
   328	            for (int i = 0; i < cap_count; i++) {
   329	                if (cap_slots[i] >= 0) {
   330	                    emit(c, BC_BOX_LOCAL, cap_slots[i], NULL);
   331	                    emit(c, BC_LOAD_LOCAL, cap_slots[i], NULL);
   332	                } else {
   333	                    emit(c, BC_LOAD_CAPTURE_CELL, -1 - cap_slots[i], NULL);
   334	                }
   335	            }
   336	            emit(c, BC_MAKE_CLOSURE, func_idx, NULL);
   337	            int jump_over = emit(c, BC_JUMP, 0, NULL);
   338	
   339	            fi->addr = c->code_count;
   340	
