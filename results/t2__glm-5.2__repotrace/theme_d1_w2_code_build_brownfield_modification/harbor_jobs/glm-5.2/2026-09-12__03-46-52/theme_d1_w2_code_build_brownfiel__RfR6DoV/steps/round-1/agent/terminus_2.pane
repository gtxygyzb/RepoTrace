   408	void parser_init(Parser *p, Token *tokens, int count) {
   409	    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;
   410	}
   411	
   412	ASTNode *parse_program(Parser *p) {
   413	    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;
   414	    nodelist_init(&program->data.block.stmts);
   415	    while (!check(p, TOK_EOF)) {
   416	        ASTNode *stmt = parse_stmt(p);
   417	        if (stmt) nodelist_push(&program->data.block.stmts, stmt);
   418	        if (p->had_error) break;
   419	    }
   420	    return program;
   421	}
