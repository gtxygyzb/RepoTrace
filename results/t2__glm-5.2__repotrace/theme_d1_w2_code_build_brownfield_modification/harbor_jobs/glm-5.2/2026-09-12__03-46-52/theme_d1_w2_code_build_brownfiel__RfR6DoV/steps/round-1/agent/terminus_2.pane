[?2004l#include "codegen.h"

static int emit(Compiler *c, Opcode op, int64_t operand, char *str_op) {
    if (c->code_count >= MAX_BYTECODE) { fprintf(stderr, "bytecode overflow\n"); return -1; }
    Instruction *ins = &c->code[c->code_count];
    ins->op = op; ins->operand = operand; ins->str_operand = str_op;
    return c->code_count++;
}

static int resolve_local(Compiler *c, const char *name) {
    for (int i = c->local_count - 1; i >= 0; i--) {
        if (strcmp(c->locals[i].name, name) == 0) return i;
    }
    return -1;
}

static int add_local(Compiler *c, const char *name) {
    if (c->local_count >= MAX_LOCALS) { fprintf(stderr, "too many local variables\n"); return -1; }
    Local *local = &c->locals[c->local_count];
    strncpy(local->name, name, MAX_IDENT_LEN - 1); local->name[MAX_IDENT_LEN - 1] = '\0';
    local->scope_depth = c->scope_depth;
    return c->local_count++;
}

static int find_function(Compiler *c, const char *name) {
    for (int i = 0; i < c->func_count; i++) {
        if (strcmp(c->functions[i].name, name) == 0) return i;
    }
    return -1;
}

static int is_builtin(const char *name) {
    return strcmp(name, "len") == 0 || strcmp(name, "keys") == 0 ||
           strcmp(name, "delete") == 0 || strcmp(name, "has") == 0;
}

static void compile_store(Compiler *c, const char *name) {
    int slot = resolve_local(c, name);
    if (slot >= 0) emit(c, BC_STORE_LOCAL, slot, NULL);
    else emit(c, BC_STORE_GLOBAL, 0, strdup(name));
}

static void compile_load(Compiler *c, const char *name) {
    int slot = resolve_local(c, name);
    if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);
    else emit(c, BC_LOAD_GLOBAL, 0, strdup(name));
}

#define MAX_LOOP_DEPTH 64
#define MAX_LOOP_JUMPS 256
typedef struct {
    int start;
    int cont;
    int end;
    int breaks[MAX_LOOP_JUMPS];
    int break_count;
    int conts[MAX_LOOP_JUMPS];
    int cont_count;
} LoopCtx;
static LoopCtx loop_stack[MAX_LOOP_DEPTH];
static int loop_depth = 0;

static int compile_node(Compiler *c, ASTNode *node);

static int compile_expr(Compiler *c, ASTNode *node) {
    switch (node->type) {
        case NODE_NUM_LIT:
            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;
        case NODE_STR_LIT: {
            char *s = strdup(node->data.str_val);
            emit(c, BC_PUSH_STR, 0, s); break;
        }
        case NODE_BOOL_LIT:
            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;
        case NODE_IDENT: {
            int slot = resolve_local(c, node->data.ident);
            if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);
            else emit(c, BC_LOAD_GLOBAL, 0, strdup(node->data.ident));
            break;
        }
        case NODE_BINOP:
            compile_expr(c, node->data.binop.left);
            compile_expr(c, node->data.binop.right);
            switch (node->data.binop.op) {
                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;
                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;
                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;
                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;
                case OP_LT:  emit(c, BC_LT, 0, NULL); break;
                case OP_GT:  emit(c, BC_GT, 0, NULL); break;
                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;
                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;
                case OP_AND: emit(c, BC_AND, 0, NULL); break;
                case OP_OR:  emit(c, BC_OR, 0, NULL); break;
            }
            break;
        case NODE_UNARY:
            compile_expr(c, node->data.unary.operand);
            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);
            else emit(c, BC_NOT, 0, NULL);
            break;
        case NODE_CALL: {
            const char *name = node->data.call.name;
            if (strcmp(name, "len") == 0) {
                if (node->data.call.args.count != 1) { error_at(node->line, "len() expects 1 argument"); return -1; }
                compile_expr(c, node->data.call.args.items[0]);
                emit(c, BC_ARRAY_LEN, 0, NULL);
                break;
            }
            if (strcmp(name, "keys") == 0) {
                if (node->data.call.args.count != 1) { error_at(node->line, "keys() expects 1 argument"); return -1; }
                compile_expr(c, node->data.call.args.items[0]);
                emit(c, BC_MAP_KEYS, 0, NULL);
                break;
            }
            if (strcmp(name, "delete") == 0) {
                if (node->data.call.args.count != 2) { error_at(node->line, "delete() expects 2 arguments"); return -1; }
                compile_expr(c, node->data.call.args.items[0]);
                compile_expr(c, node->data.call.args.items[1]);
                emit(c, BC_MAP_DELETE, 0, NULL);
                break;
            }
            if (strcmp(name, "has") == 0) {
                if (node->data.call.args.count != 2) { error_at(node->line, "has() expects 2 arguments"); return -1; }
                compile_expr(c, node->data.call.args.items[0]);
                compile_expr(c, node->data.call.args.items[1]);
                emit(c, BC_MAP_HAS, 0, NULL);
                break;
            }
            int fi = find_function(c, name);
            if (fi < 0) { error_at(node->line, "undefined function '%s'", name); return -1; }
            for (int i = 0; i < node->data.call.args.count; i++)
                compile_expr(c, node->data.call.args.items[i]);
            emit(c, BC_CALL, fi, NULL);
            break;
        }
        case NODE_INDEX:
            compile_expr(c, node->data.index_access.obj);
            compile_expr(c, node->data.index_access.index);
            emit(c, BC_INDEX, 0, NULL); break;
        case NODE_ARRAY_LIT:
            for (int i = 0; i < node->data.array_lit.elems.count; i++)
                compile_expr(c, node->data.array_lit.elems.items[i]);
            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;
        case NODE_MAP_LIT: {
            int count = node->data.map_lit.keys.count;
            for (int i = 0; i < count; i++) {
                compile_expr(c, node->data.map_lit.keys.items[i]);
                compile_expr(c, node->data.map_lit.values.items[i]);
            }
            emit(c, BC_PUSH_MAP, count, NULL); break;
        }
        case NODE_FIELD_ACCESS:
            compile_expr(c, node->data.field_access.obj);
            emit(c, BC_PUSH_STR, 0, strdup(node->data.field_access.field));
            emit(c, BC_MAP_GET, 0, NULL); break;
        default:
            error_at(node->line, "cannot compile expression of type %d", node->type); return -1;
    }
    return 0;
}

static int compile_node(Compiler *c, ASTNode *node) {
    switch (node->type) {
        case NODE_LET: {
            int slot = add_local(c, node->data.let.name);
            if (slot < 0) return -1;
            compile_expr(c, node->data.let.init);
            break;
        }
        case NODE_ASSIGN: {
            compile_expr(c, node->data.assign.value);
            compile_store(c, node->data.assign.name);
            break;
        }
        case NODE_INDEX_ASSIGN: {
            if (node->data.index_assign.obj) {
                compile_expr(c, node->data.index_assign.obj);
                compile_expr(c, node->data.index_assign.index);
                compile_expr(c, node->data.index_assign.value);
                emit(c, BC_INDEX_STORE, 0, NULL);
            } else {
                compile_load(c, node->data.index_assign.name);
                compile_expr(c, node->data.index_assign.index);
                compile_expr(c, node->data.index_assign.value);
                emit(c, BC_INDEX_STORE, 0, NULL);
            }
            break;
        }
        case NODE_FIELD_ASSIGN: {
            compile_expr(c, node->data.field_assign.obj);
            emit(c, BC_PUSH_STR, 0, strdup(node->data.field_assign.field));
            compile_expr(c, node->data.field_assign.value);
            emit(c, BC_MAP_SET, 0, NULL);
            break;
        }
        case NODE_IF: {
            compile_expr(c, node->data.if_stmt.cond);
            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
            compile_node(c, node->data.if_stmt.then_b);
            if (node->data.if_stmt.else_b) {
                int je = emit(c, BC_JUMP, 0, NULL);
                c->code[jf].operand = c->code_count;
                compile_node(c, node->data.if_stmt.else_b);
                c->code[je].operand = c->code_count;
            } else {
                c->code[jf].operand = c->code_count;
            }
            break;
        }
        case NODE_WHILE: {
            int loop_start = c->code_count;
            compile_expr(c, node->data.while_stmt.cond);
            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, "too many nested loops"); return -1; }
            LoopCtx *ctx = &loop_stack[loop_depth++];
            ctx->start = loop_start; ctx->cont = loop_start; ctx->end = -1;
            ctx->break_count = 0; ctx->cont_count = 0;
            compile_node(c, node->data.while_stmt.body);
            emit(c, BC_JUMP, loop_start, NULL);
            int end = c->code_count;
            c->code[jf].operand = end;
            ctx->end = end;
            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;
            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = ctx->cont;
            loop_depth--;
            break;
        }
        case NODE_FOR: {
            int old_lc = c->local_count;
            c->scope_depth++;
            if (node->data.for_stmt.init) compile_node(c, node->data.for_stmt.init);
            int loop_start = c->code_count;
            if (node->data.for_stmt.cond) compile_expr(c, node->data.for_stmt.cond);
            else emit(c, BC_PUSH_BOOL, 1, NULL);
            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, "too many nested loops"); return -1; }
            LoopCtx *ctx = &loop_stack[loop_depth++];
            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;
            ctx->break_count = 0; ctx->cont_count = 0;
            compile_node(c, node->data.for_stmt.body);
            int step_start = c->code_count;
            ctx->cont = step_start;
            if (node->data.for_stmt.step) compile_node(c, node->data.for_stmt.step);
            emit(c, BC_JUMP, loop_start, NULL);
            int end = c->code_count;
            c->code[jf].operand = end;
            ctx->end = end;
            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;
            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = step_start;
            loop_depth--;
            int n = c->local_count - old_lc;
            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
            c->local_count = old_lc;
            c->scope_depth--;
            break;
        }
[?2004hroot@n30009:/app# sed -n '260,620p' src/codegen.c
[?2004l        }
        case NODE_FOREACH: {
            int old_lc = c->local_count;
            c->scope_depth++;
            compile_expr(c, node->data.foreach_stmt.arr);
            int arr_slot = add_local(c, ".forarr");
            emit(c, BC_PUSH_INT, 0, NULL);
            int idx_slot = add_local(c, ".foridx");
            int var_slot = add_local(c, node->data.foreach_stmt.var);
            emit(c, BC_PUSH_INT, 0, NULL);
            int loop_start = c->code_count;
            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
            emit(c, BC_LOAD_LOCAL, arr_slot, NULL);
            emit(c, BC_ARRAY_LEN, 0, NULL);
            emit(c, BC_LT, 0, NULL);
            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, "too many nested loops"); return -1; }
            LoopCtx *ctx = &loop_stack[loop_depth++];
            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;
            ctx->break_count = 0; ctx->cont_count = 0;
            int body_old = c->local_count;
            if (node->data.foreach_stmt.is_of) {
                emit(c, BC_LOAD_LOCAL, arr_slot, NULL);
                emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
                emit(c, BC_INDEX, 0, NULL);
            } else {
                emit(c, BC_LOAD_LOCAL, arr_slot, NULL);
                emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
                emit(c, BC_ITER_KEY, 0, NULL);
            }
            emit(c, BC_STORE_LOCAL, var_slot, NULL);
            compile_node(c, node->data.foreach_stmt.body);
            int n = c->local_count - body_old;
            int cleanup_start = c->code_count;
            ctx->cont = cleanup_start;
            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
            c->local_count = body_old;
            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
            emit(c, BC_PUSH_INT, 1, NULL);
            emit(c, BC_ADD, 0, NULL);
            emit(c, BC_STORE_LOCAL, idx_slot, NULL);
            emit(c, BC_JUMP, loop_start, NULL);
            int break_cleanup = c->code_count;
            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
            int end = c->code_count;
            c->code[jf].operand = end;
            ctx->end = end;
            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = break_cleanup;
            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = ctx->cont;
            loop_depth--;
            int n2 = c->local_count - old_lc;
            for (int i = 0; i < n2; i++) emit(c, BC_POP, 0, NULL);
            c->local_count = old_lc;
            c->scope_depth--;
            break;
        }
        case NODE_BREAK: {
            if (loop_depth <= 0) { error_at(node->line, "break outside loop"); return -1; }
            LoopCtx *ctx = &loop_stack[loop_depth - 1];
            if (ctx->break_count >= MAX_LOOP_JUMPS) { error_at(node->line, "too many break statements"); return -1; }
            ctx->breaks[ctx->break_count++] = emit(c, BC_JUMP, 0, NULL);
            break;
        }
        case NODE_CONTINUE: {
            if (loop_depth <= 0) { error_at(node->line, "continue outside loop"); return -1; }
            LoopCtx *ctx = &loop_stack[loop_depth - 1];
            if (ctx->cont_count >= MAX_LOOP_JUMPS) { error_at(node->line, "too many continue statements"); return -1; }
            ctx->conts[ctx->cont_count++] = emit(c, BC_JUMP, 0, NULL);
            break;
        }
        case NODE_COMPOUND_ASSIGN: {
            compile_load(c, node->data.compound_assign.name);
            compile_expr(c, node->data.compound_assign.value);
            switch (node->data.compound_assign.op) {
                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;
                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;
                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
                default: error_at(node->line, "invalid compound assignment"); return -1;
            }
            compile_store(c, node->data.compound_assign.name);
            break;
        }
        case NODE_RETURN: {
            if (node->data.ret.value) compile_expr(c, node->data.ret.value);
            else emit(c, BC_PUSH_INT, 0, NULL);
            emit(c, BC_RET, 0, NULL);
            break;
        }
        case NODE_PRINT: {
            compile_expr(c, node->data.print.value);
            emit(c, BC_PRINT, 0, NULL);
            break;
        }
        case NODE_BLOCK: {
            int old_lc = c->local_count;
            c->scope_depth++;
            for (int i = 0; i < node->data.block.stmts.count; i++)
                compile_node(c, node->data.block.stmts.items[i]);
            c->scope_depth--;
            {
                int n = c->local_count - old_lc;
                for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
            }
            c->local_count = old_lc;
            break;
        }
        case NODE_FUNC: {
            int jump_over = emit(c, BC_JUMP, 0, NULL);

            if (c->func_count >= MAX_FUNCTIONS) { fprintf(stderr, "too many functions\n"); return -1; }
            FuncInfo *fi = &c->functions[c->func_count];
            strncpy(fi->name, node->data.func.name, MAX_IDENT_LEN - 1);
            fi->addr = c->code_count;
            fi->param_count = node->data.func.param_count;
            c->func_count++;

            int old_lc = c->local_count;
            int old_scope = c->scope_depth;
            int old_inf = c->in_function;
            int old_loop_depth = loop_depth;
            loop_depth = 0;

            c->local_count = 0;
            c->scope_depth = 0;
            c->in_function = 1;
            c->scope_depth++;

            for (int i = 0; i < node->data.func.param_count; i++)
                add_local(c, node->data.func.params[i]);

            compile_node(c, node->data.func.body);

            emit(c, BC_PUSH_INT, 0, NULL);
            emit(c, BC_RET, 0, NULL);

            c->scope_depth = old_scope;
            c->local_count = old_lc;
            c->in_function = old_inf;
            loop_depth = old_loop_depth;

            c->code[jump_over].operand = c->code_count;
            break;
        }
        case NODE_EXPR_STMT: {
            compile_expr(c, node->data.expr_stmt.expr);
            emit(c, BC_POP, 0, NULL);
            break;
        }
        default:
            compile_expr(c, node);
            emit(c, BC_POP, 0, NULL);
            break;
    }
    return 0;
}

void compiler_init(Compiler *c) {
    c->code_count = 0; c->local_count = 0; c->scope_depth = 0;
    c->func_count = 0; c->in_function = 0;
}

int compile(Compiler *c, ASTNode *program) {
    if (compile_node(c, program) < 0) return -1;
    emit(c, BC_HALT, 0, NULL);
    return 0;
}
[?2004hroot@n30009:/app# sed -n '1,260p' src/vm.c
[?2004l#include "vm.h"
#include <string.h>

static void push(VM *vm, Value v) {
    if (vm->sp >= MAX_STACK) { fprintf(stderr, "stack overflow\n"); exit(1); }
    vm->stack[vm->sp++] = v;
}

static Value pop(VM *vm) {
    if (vm->sp <= 0) { fprintf(stderr, "stack underflow\n"); exit(1); }
    return vm->stack[--vm->sp];
}

static Value make_int(int64_t v) { Value val; val.type = VAL_INT; val.data.ival = v; return val; }
static Value make_str(const char *s) { Value val; val.type = VAL_STR; val.data.sval = strdup(s); return val; }
static Value make_bool(int b) { Value val; val.type = VAL_BOOL; val.data.bval = b; return val; }

static Value make_map(void) {
    Value val; val.type = VAL_MAP; val.data.map = malloc(sizeof(MapData));
    val.data.map->keys = NULL; val.data.map->values = NULL; val.data.map->len = 0; val.data.map->cap = 0;
    return val;
}

static int map_find(MapData *m, const char *key) {
    for (int i = 0; i < m->len; i++) if (strcmp(m->keys[i], key) == 0) return i;
    return -1;
}

static void map_set(MapData *m, const char *key, Value v) {
    int i = map_find(m, key);
    if (i >= 0) { m->values[i] = v; return; }
    if (m->len >= m->cap) {
        int cap = m->cap == 0 ? 8 : m->cap * 2;
        m->keys = realloc(m->keys, cap * sizeof(char*));
        m->values = realloc(m->values, cap * sizeof(Value));
        m->cap = cap;
    }
    m->keys[m->len] = strdup(key);
    m->values[m->len] = v;
    m->len++;
}

static int map_delete(MapData *m, const char *key) {
    int i = map_find(m, key);
    if (i < 0) return 0;
    free(m->keys[i]);
    for (int j = i; j < m->len - 1; j++) { m->keys[j] = m->keys[j+1]; m->values[j] = m->values[j+1]; }
    m->len--;
    return 1;
}


static int resolve_global(VM *vm, const char *name) {
    for (int i = 0; i < vm->global_count; i++)
        if (strcmp(vm->global_names[i], name) == 0) return i;
    return -1;
}

static int add_global(VM *vm, const char *name) {
    if (vm->global_count >= MAX_GLOBALS) { fprintf(stderr, "too many globals\n"); return -1; }
    int idx = vm->global_count;
    strncpy(vm->global_names[idx], name, MAX_IDENT_LEN - 1);
    vm->globals[idx].type = VAL_NULL;
    vm->global_count++;
    return idx;
}

static int64_t value_to_int(Value v) {
    switch (v.type) { case VAL_INT: return v.data.ival; case VAL_BOOL: return v.data.bval ? 1 : 0; default: return 0; }
}

static int value_is_integer_like(Value v) {
    return v.type == VAL_INT || v.type == VAL_BOOL;
}

static int value_truthy(Value v) {
    switch (v.type) {
        case VAL_INT: return v.data.ival != 0;
        case VAL_BOOL: return v.data.bval;
        case VAL_STR: return v.data.sval && v.data.sval[0] != '\0';
        case VAL_ARRAY: return v.data.array.len > 0;
        case VAL_MAP: return v.data.map && v.data.map->len > 0;
        case VAL_NULL: return 0;
    }
    return 0;
}

static int values_equal(Value a, Value b) {
    if (a.type != b.type) return 0;
    switch (a.type) {
        case VAL_INT: return a.data.ival == b.data.ival;
        case VAL_BOOL: return a.data.bval == b.data.bval;
        case VAL_STR: return strcmp(a.data.sval, b.data.sval) == 0;
        case VAL_NULL: return 1;
        default: return 0;
    }
}

static const char *value_to_cstr(Value v, char *buf, size_t size) {
    switch (v.type) {
        case VAL_STR: return v.data.sval;
        case VAL_INT: snprintf(buf, size, "%lld", (long long)v.data.ival); return buf;
        case VAL_BOOL: return v.data.bval ? "true" : "false";
        case VAL_NULL: return "null";
        default: return "";
    }
}

static const char *value_to_key(Value v, char *buf, size_t size) {
    if (v.type == VAL_STR) return v.data.sval;
    return value_to_cstr(v, buf, size);
}

static int value_cmp(Value a, Value b) {
    if (a.type == VAL_STR && b.type == VAL_STR)
        return strcmp(a.data.sval, b.data.sval);
    int64_t ia = value_to_int(a), ib = value_to_int(b);
    return ia < ib ? -1 : (ia > ib ? 1 : 0);
}

static void print_value(Value v) {
    switch (v.type) {
        case VAL_INT: printf("%lld", (long long)v.data.ival); break;
        case VAL_BOOL: printf("%s", v.data.bval ? "true" : "false"); break;
        case VAL_STR: printf("%s", v.data.sval); break;
        case VAL_ARRAY:
            printf("[");
            for (int i = 0; i < v.data.array.len; i++) {
                if (i > 0) printf(", ");
                print_value(v.data.array.items[i]);
            }
            printf("]");
            break;
        case VAL_MAP:
            printf("{");
            for (int i = 0; i < v.data.map->len; i++) {
                if (i > 0) printf(", ");
                printf("%s", v.data.map->keys[i]);
                printf(": ");
                print_value(v.data.map->values[i]);
            }
            printf("}");
            break;
        case VAL_NULL: printf("null"); break;
    }
}

void vm_init(VM *vm, Compiler *c) {
    vm->sp = 0; vm->frame_count = 0; vm->global_count = 0;
    vm->code = c->code; vm->code_count = c->code_count;
    vm->functions = c->functions; vm->func_count = c->func_count;
    vm->ip = 0;
}

int vm_run(VM *vm) {
    while (vm->ip < vm->code_count) {
        Instruction *ins = &vm->code[vm->ip++];
        switch (ins->op) {
            case BC_PUSH_INT: push(vm, make_int(ins->operand)); break;
            case BC_PUSH_STR: push(vm, make_str(ins->str_operand)); break;
            case BC_PUSH_BOOL: push(vm, make_bool((int)ins->operand)); break;
            case BC_LOAD_LOCAL: {
                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;
                push(vm, vm->stack[base + (int)ins->operand]);
                break;
            }
            case BC_STORE_LOCAL: {
                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;
                vm->stack[base + (int)ins->operand] = pop(vm);
                break;
            }
            case BC_LOAD_GLOBAL: {
                int idx = resolve_global(vm, ins->str_operand);
                if (idx < 0) { fprintf(stderr, "undefined variable '%s'\n", ins->str_operand); return -1; }
                push(vm, vm->globals[idx]);
                break;
            }
            case BC_STORE_GLOBAL: {
                int idx = resolve_global(vm, ins->str_operand);
                if (idx < 0) idx = add_global(vm, ins->str_operand);
                vm->globals[idx] = pop(vm);
                break;
            }
            case BC_ADD: {
                Value b = pop(vm); Value a = pop(vm);
                if (a.type == VAL_STR || b.type == VAL_STR) {
                    char bufa[64], bufb[64];
                    const char *sa = value_to_cstr(a, bufa, sizeof(bufa));
                    const char *sb = value_to_cstr(b, bufb, sizeof(bufb));
                    char *r = malloc(strlen(sa) + strlen(sb) + 1);
                    strcpy(r, sa); strcat(r, sb);
                    Value v; v.type = VAL_STR; v.data.sval = r; push(vm, v);
                } else { push(vm, make_int(value_to_int(a) + value_to_int(b))); }
                break;
            }
            case BC_SUB: { Value b = pop(vm); Value a = pop(vm);
                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {
                    fprintf(stderr, "operator '-' expects integers\n");
                    return -1;
                }
                push(vm, make_int(value_to_int(a) - value_to_int(b))); break; }
            case BC_MUL: { Value b = pop(vm); Value a = pop(vm);
                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {
                    fprintf(stderr, "operator '*' expects integers\n");
                    return -1;
                }
                push(vm, make_int(value_to_int(a) * value_to_int(b))); break; }
            case BC_DIV: { Value b = pop(vm); Value a = pop(vm);
                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {
                    fprintf(stderr, "operator '/' expects integers\n");
                    return -1;
                }
                if (value_to_int(b) == 0) { fprintf(stderr, "division by zero\n"); return -1; }
                push(vm, make_int(value_to_int(a) / value_to_int(b))); break; }
            case BC_MOD: { Value b = pop(vm); Value a = pop(vm);
                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {
                    fprintf(stderr, "operator '%%' expects integers\n");
                    return -1;
                }
                if (value_to_int(b) == 0) { fprintf(stderr, "modulo by zero\n"); return -1; }
                push(vm, make_int(value_to_int(a) % value_to_int(b))); break; }
            case BC_EQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(values_equal(a, b))); break; }
            case BC_NEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(!values_equal(a, b))); break; }
            case BC_LT: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_cmp(a, b) < 0)); break; }
            case BC_GT: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_cmp(a, b) > 0)); break; }
            case BC_LEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_cmp(a, b) <= 0)); break; }
            case BC_GEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_cmp(a, b) >= 0)); break; }
            case BC_AND: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_truthy(a) && value_truthy(b))); break; }
            case BC_OR: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_truthy(a) || value_truthy(b))); break; }
            case BC_NOT: { Value a = pop(vm); push(vm, make_bool(!value_truthy(a))); break; }
            case BC_NEG: { Value a = pop(vm); push(vm, make_int(-value_to_int(a))); break; }
            case BC_JUMP: vm->ip = (int)ins->operand; break;
            case BC_JUMP_FALSE: { Value cond = pop(vm); if (!value_truthy(cond)) vm->ip = (int)ins->operand; break; }
            case BC_CALL: {
                int fi = (int)ins->operand;
                FuncInfo *func = &vm->functions[fi];
                if (vm->frame_count >= MAX_CALL_FRAMES) { fprintf(stderr, "call stack overflow\n"); return -1; }
                CallFrame *frame = &vm->frames[vm->frame_count++];
                frame->ip = vm->ip;
                frame->bp = vm->sp;
                /* BUG: the callee's local base does not properly account for
                   intermediate return values that earlier nested-call arguments
                   left on the stack. For multi-argument calls that are preceded
