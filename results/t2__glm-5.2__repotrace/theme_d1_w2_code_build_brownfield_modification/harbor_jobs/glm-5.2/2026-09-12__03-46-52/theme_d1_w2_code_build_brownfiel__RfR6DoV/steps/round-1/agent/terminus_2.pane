   161	static ASTNode *try_parse_assign(Parser *p) {
   162	    if (!check(p, TOK_IDENT)) return NULL;
   163	    int saved = p->pos;
   164	    p->pos++;
   165	    if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||
   166	        check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {
   167	        p->pos = saved; match(p, TOK_IDENT);
   168	        char name[MAX_IDENT_LEN];
   169	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   170	        int line = prev(p)->line;
   171	        TokenType op_tok = current(p)->type;
   172	        BinOp op = OP_ADD;
   173	        const char *msg = "'='";
   174	        if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = "'+='"; expect(p, TOK_PLUS_ASSIGN, "'+='"); }
   175	        else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = "'-='"; expect(p, TOK_MINUS_ASSIGN, "'-='"); }
   176	        else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = "'*='"; expect(p, TOK_STAR_ASSIGN, "'*='"); }
   177	        else if (op_tok == TOK_SLASH_ASSIGN) { op = OP_DIV; msg = "'/='"; expect(p, TOK_SLASH_ASSIGN, "'/='"); }
   178	        else if (op_tok == TOK_PERCENT_ASSIGN) { op = OP_MOD; msg = "'%='"; expect(p, TOK_PERCENT_ASSIGN, "'%='"); }
   179	        else { expect(p, TOK_ASSIGN, "'='"); }
   180	        ASTNode *val = parse_expr(p);
[?2004hroot@n30009:/app# nl -ba src/parser.c | sed -n '180,340p'
[?2004l   180	        ASTNode *val = parse_expr(p);
   181	        if (op_tok == TOK_ASSIGN) {
   182	            ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;
   183	            strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);
   184	            n->data.assign.value = val; return n;
   185	        } else {
   186	            ASTNode *n = ast_alloc(); n->type = NODE_COMPOUND_ASSIGN; n->line = line;
   187	            strncpy(n->data.compound_assign.name, name, MAX_IDENT_LEN - 1);
   188	            n->data.compound_assign.op = op;
   189	            n->data.compound_assign.value = val; return n;
   190	        }
   191	    }
   192	    p->pos = saved; return NULL;
   193	}
