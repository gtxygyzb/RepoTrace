    47	        if (c->locals[slot].is_boxed) emit(c, BC_STORE_BOX_LOCAL, slot, NULL);
    48	        else emit(c, BC_STORE_LOCAL, slot, NULL);
    49	        return;
    50	    }
    51	    int cap = resolve_capture(c, name);
    52	    if (cap >= 0) { emit(c, BC_STORE_CAPTURE, cap, NULL); return; }
    53	    emit(c, BC_STORE_GLOBAL, 0, strdup(name));
    54	}
    55	
    56	static void compile_load(Compiler *c, const char *name) {
    57	    int slot = resolve_local(c, name);
    58	    if (slot >= 0) {
    59	        if (c->locals[slot].is_boxed) emit(c, BC_LOAD_BOX_LOCAL, slot, NULL);
    60	        else emit(c, BC_LOAD_LOCAL, slot, NULL);
    61	        return;
    62	    }
    63	    int cap = resolve_capture(c, name);
    64	    if (cap >= 0) { emit(c, BC_LOAD_CAPTURE, cap, NULL); return; }
    65	    emit(c, BC_LOAD_GLOBAL, 0, strdup(name));
    66	}
