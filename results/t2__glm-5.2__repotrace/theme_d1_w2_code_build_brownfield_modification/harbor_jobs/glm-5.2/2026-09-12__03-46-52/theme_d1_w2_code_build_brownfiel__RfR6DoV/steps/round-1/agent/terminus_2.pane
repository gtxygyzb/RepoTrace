    38	static int compile_node(Compiler *c, ASTNode *node);
    39	
    40	static int compile_expr(Compiler *c, ASTNode *node) {
    41	    switch (node->type) {
    42	        case NODE_NUM_LIT:
    43	            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;
    44	        case NODE_STR_LIT: {
    45	            char *s = strdup(node->data.str_val);
    46	            emit(c, BC_PUSH_STR, 0, s); break;
    47	        }
    48	        case NODE_BOOL_LIT:
    49	            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;
    50	        case NODE_IDENT: {
    51	            int slot = resolve_local(c, node->data.ident);
    52	            if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);
    53	            else emit(c, BC_LOAD_GLOBAL, 0, strdup(node->data.ident));
    54	            break;
    55	        }
    56	        case NODE_BINOP:
    57	            compile_expr(c, node->data.binop.left);
    58	            compile_expr(c, node->data.binop.right);
    59	            switch (node->data.binop.op) {
    60	                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;
    61	                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;
    62	                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
    63	                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
    64	                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
    65	                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;
    66	                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;
    67	                case OP_LT:  emit(c, BC_LT, 0, NULL); break;
    68	                case OP_GT:  emit(c, BC_GT, 0, NULL); break;
    69	                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;
    70	                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;
    71	                case OP_AND: emit(c, BC_AND, 0, NULL); break;
    72	                case OP_OR:  emit(c, BC_OR, 0, NULL); break;
    73	            }
    74	            break;
    75	        case NODE_UNARY:
    76	            compile_expr(c, node->data.unary.operand);
    77	            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);
    78	            else emit(c, BC_NOT, 0, NULL);
    79	            break;
    80	        case NODE_CALL: {
    81	            int fi = find_function(c, node->data.call.name);
    82	            if (fi < 0) { error_at(node->line, "undefined function '%s'", node->data.call.name); return -1; }
    83	            for (int i = 0; i < node->data.call.args.count; i++)
    84	                compile_expr(c, node->data.call.args.items[i]);
    85	            emit(c, BC_CALL, fi, NULL);
    86	            break;
    87	        }
    88	        case NODE_INDEX:
    89	            compile_expr(c, node->data.index_access.obj);
    90	            compile_expr(c, node->data.index_access.index);
    91	            emit(c, BC_INDEX, 0, NULL); break;
    92	        case NODE_ARRAY_LIT:
    93	            for (int i = 0; i < node->data.array_lit.elems.count; i++)
    94	                compile_expr(c, node->data.array_lit.elems.items[i]);
    95	            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;
    96	        default:
    97	            error_at(node->line, "cannot compile expression of type %d", node->type); return -1;
    98	    }
    99	    return 0;
   100	}
   101	
   102	static int compile_node(Compiler *c, ASTNode *node) {
   103	    switch (node->type) {
   104	        case NODE_LET: {
   105	            int slot = add_local(c, node->data.let.name);
   106	            if (slot < 0) return -1;
   107	            compile_expr(c, node->data.let.init);
   108	            break;
   109	        }
   110	        case NODE_ASSIGN: {
   111	            compile_expr(c, node->data.assign.value);
   112	            compile_store(c, node->data.assign.name);
   113	            break;
   114	        }
