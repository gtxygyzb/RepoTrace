static int emit(Compiler *c, Opcode op, int64_t operand, char *str_op) {
    if (c->code_count >= MAX_BYTECODE) { fprintf(stderr, "bytecode overflow\n"); return -1; }
    Instruction *ins = &c->code[c->code_count];
    ins->op = op; ins->operand = operand; ins->str_operand = str_op;
    return c->code_count++;
}

static int resolve_local(Compiler *c, const char *name) {
    for (int i = c->local_count - 1; i >= 0; i--) {
        if (strcmp(c->locals[i].name, name) == 0) return i;
    }
    return -1;
}

static int add_local(Compiler *c, const char *name) {
    if (c->local_count >= MAX_LOCALS) { fprintf(stderr, "too many local variables\n"); return -1; }
    Local *local = &c->locals[c->local_count];
    strncpy(local->name, name, MAX_IDENT_LEN - 1); local->name[MAX_IDENT_LEN - 1] = '\0';
    local->scope_depth = c->scope_depth;
    return c->local_count++;
}

static int find_function(Compiler *c, const char *name) {
    for (int i = 0; i < c->func_count; i++) {
        if (strcmp(c->functions[i].name, name) == 0) return i;
    }
    return -1;
}

static void compile_store(Compiler *c, const char *name) {
    int slot = resolve_local(c, name);
    if (slot >= 0) emit(c, BC_STORE_LOCAL, slot, NULL);
    else emit(c, BC_STORE_GLOBAL, 0, strdup(name));
}

static int compile_node(Compiler *c, ASTNode *node);

static int compile_expr(Compiler *c, ASTNode *node) {
    switch (node->type) {
        case NODE_NUM_LIT:
            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;
        case NODE_STR_LIT: {
            char *s = strdup(node->data.str_val);
            emit(c, BC_PUSH_STR, 0, s); break;
        }
        case NODE_BOOL_LIT:
            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;
        case NODE_IDENT: {
            int slot = resolve_local(c, node->data.ident);
            if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);
            else emit(c, BC_LOAD_GLOBAL, 0, strdup(node->data.ident));
            break;
        }
        case NODE_BINOP:
            compile_expr(c, node->data.binop.left);
            compile_expr(c, node->data.binop.right);
            switch (node->data.binop.op) {
                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;
                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;
                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;
                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;
                case OP_LT:  emit(c, BC_LT, 0, NULL); break;
                case OP_GT:  emit(c, BC_GT, 0, NULL); break;
                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;
                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;
                case OP_AND: emit(c, BC_AND, 0, NULL); break;
                case OP_OR:  emit(c, BC_OR, 0, NULL); break;
            }
            break;
        case NODE_UNARY:
            compile_expr(c, node->data.unary.operand);
            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);
            else emit(c, BC_NOT, 0, NULL);
            break;
        case NODE_CALL: {
            int fi = find_function(c, node->data.call.name);
            if (fi < 0) { error_at(node->line, "undefined function '%s'", node->data.call.name); return -1; }
            for (int i = 0; i < node->data.call.args.count; i++)
                compile_expr(c, node->data.call.args.items[i]);
            emit(c, BC_CALL, fi, NULL);
            break;
        }
        case NODE_INDEX:
            compile_expr(c, node->data.index_access.obj);
            compile_expr(c, node->data.index_access.index);
            emit(c, BC_INDEX, 0, NULL); break;
        case NODE_ARRAY_LIT:
            for (int i = 0; i < node->data.array_lit.elems.count; i++)
                compile_expr(c, node->data.array_lit.elems.items[i]);
            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;
        default:
            error_at(node->line, "cannot compile expression of type %d", node->type); return -1;
    }
    return 0;
}

static int compile_node(Compiler *c, ASTNode *node) {
    switch (node->type) {
        case NODE_LET: {
            int slot = add_local(c, node->data.let.name);
            if (slot < 0) return -1;
            compile_expr(c, node->data.let.init);
            break;
        }
        case NODE_ASSIGN: {
            compile_expr(c, node->data.assign.value);
            compile_store(c, node->data.assign.name);
            break;
        }
        case NODE_IF: {
            compile_expr(c, node->data.if_stmt.cond);
            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
            compile_node(c, node->data.if_stmt.then_b);
            if (node->data.if_stmt.else_b) {
                int je = emit(c, BC_JUMP, 0, NULL);
                c->code[jf].operand = c->code_count;
                compile_node(c, node->data.if_stmt.else_b);
                c->code[je].operand = c->code_count;
            } else {
                c->code[jf].operand = c->code_count;
            }
            break;
        }
        case NODE_WHILE: {
            int loop_start = c->code_count;
            compile_expr(c, node->data.while_stmt.cond);
            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
            compile_node(c, node->data.while_stmt.body);
            emit(c, BC_JUMP, loop_start, NULL);
            c->code[jf].operand = c->code_count;
            break;
        }
        case NODE_RETURN: {
            if (node->data.ret.value) compile_expr(c, node->data.ret.value);
            else emit(c, BC_PUSH_INT, 0, NULL);
            emit(c, BC_RET, 0, NULL);
            break;
        }
        case NODE_PRINT: {
            compile_expr(c, node->data.print.value);
            emit(c, BC_PRINT, 0, NULL);
            break;
        }
        case NODE_BLOCK: {
            int old_lc = c->local_count;
            c->scope_depth++;
            for (int i = 0; i < node->data.block.stmts.count; i++)
                compile_node(c, node->data.block.stmts.items[i]);
            c->scope_depth--;
            {
                int n = c->local_count - old_lc;
                for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
            }
            c->local_count = old_lc;
            break;
        }
        case NODE_FUNC: {
            int jump_over = emit(c, BC_JUMP, 0, NULL);

            if (c->func_count >= MAX_FUNCTIONS) { fprintf(stderr, "too many functions\n"); return -1; }
            FuncInfo *fi = &c->functions[c->func_count];
            strncpy(fi->name, node->data.func.name, MAX_IDENT_LEN - 1);
            fi->addr = c->code_count;
            fi->param_count = node->data.func.param_count;
            c->func_count++;

            int old_lc = c->local_count;
            int old_scope = c->scope_depth;
            int old_inf = c->in_function;

            c->local_count = 0;
            c->scope_depth = 0;
            c->in_function = 1;
            c->scope_depth++;

            for (int i = 0; i < node->data.func.param_count; i++)
                add_local(c, node->data.func.params[i]);

            compile_node(c, node->data.func.body);

            emit(c, BC_PUSH_INT, 0, NULL);
            emit(c, BC_RET, 0, NULL);

            c->scope_depth = old_scope;
            c->local_count = old_lc;
            c->in_function = old_inf;

            c->code[jump_over].operand = c->code_count;
            break;
        }
        case NODE_EXPR_STMT: {
            compile_expr(c, node->data.expr_stmt.expr);
            emit(c, BC_POP, 0, NULL);
            break;
        }
        default:
            compile_expr(c, node);
            emit(c, BC_POP, 0, NULL);
            break;
    }
    return 0;
}

void compiler_init(Compiler *c) {
    c->code_count = 0; c->local_count = 0; c->scope_depth = 0;
    c->func_count = 0; c->in_function = 0;
}

int compile(Compiler *c, ASTNode *program) {
    if (compile_node(c, program) < 0) return -1;
    emit(c, BC_HALT, 0, NULL);
    return 0;
}
