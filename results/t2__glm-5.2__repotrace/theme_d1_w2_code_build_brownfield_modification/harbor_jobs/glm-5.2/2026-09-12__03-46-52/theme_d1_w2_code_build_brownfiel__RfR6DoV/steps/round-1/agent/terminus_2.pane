// TODO: Complex interaction - precedence + nested calls + strings combined
fn max(a, b) {
    if (a > b) {
        return a;
    }
    return b;
}

fn min(a, b) {
    if (a < b) {
        return a;
    }
    return b;
}

fn abs(x) {
    if (x < 0) {
        return 0 - x;
    }
    return x;
}

fn clamp(val, lo, hi) {
    return min(max(val, lo), hi);
}

// Test precedence in function results
let x = max(3, 5) + min(10, 2);
print x;

// Comparison with function call results
// max(3,5) + min(10,2) == 7 should be (max(3,5) + min(10,2)) == 7
if (max(3, 5) + min(10, 2) == 7) {
    print 1;
} else {
    print 0;
}

// Nested calls with arithmetic in args
print clamp(15, 0, 10);
print clamp(max(3, 7) + 5, 0, 20);
print abs(min(5, 3) - max(8, 10));

// String concatenation
let greeting = "hello" + " " + "world";
print greeting;

// Mixed expressions
let result = max(abs(0 - 5), abs(0 - 3));
print result;
===== tests/programs/todo_nested_calls.mini
// TODO: Nested function calls as arguments
// When function calls are used as arguments to other function calls,
// the stack frame management must handle the intermediate return values

fn double(x) {
    return x * 2;
}

fn add(a, b) {
    return a + b;
}

fn triple(x) {
    return x * 3;
}

fn sub(a, b) {
    return a - b;
}

// double(add(2, 3)) => double(5) => 10
print double(add(2, 3));

// add(double(3), triple(2)) => add(6, 6) => 12
print add(double(3), triple(2));

// add(add(1, 2), add(3, 4)) => add(3, 7) => 10
print add(add(1, 2), add(3, 4));

// sub(double(add(1, 4)), triple(3)) => sub(double(5), 9) => sub(10, 9) => 1
print sub(double(add(1, 4)), triple(3));

// Three levels: double(double(double(2))) => 16
print double(double(double(2)));
===== tests/programs/todo_precedence.mini
// TODO: Operator precedence for comparison with arithmetic
// These test that comparison operators have LOWER precedence than +/-
// Expected: (3 + 4) == 7 should be true, not 3 + (4 == 7) + ...
let a = 3;
let b = 4;
let c = 7;

// a + b == c  should mean (a + b) == c => true
if (a + b == c) {
    print 1;
} else {
    print 0;
}

// a * 2 + 1 == b + 3  should mean (a*2 + 1) == (b + 3) => 7 == 7 => true
if (a * 2 + 1 == b + 3) {
    print 1;
} else {
    print 0;
}

// 10 - 3 > 5  should mean (10 - 3) > 5 => 7 > 5 => true
if (10 - 3 > 5) {
    print 1;
} else {
    print 0;
}

// 2 + 2 != 5  should mean (2 + 2) != 5 => true
if (2 + 2 != 5) {
    print 1;
} else {
    print 0;
}

// Chained: a + b >= c && c - a <= b  should mean ((a+b) >= c) && ((c-a) <= b)
if (a + b >= c && c - a <= b) {
    print 1;
} else {
    print 0;
}
