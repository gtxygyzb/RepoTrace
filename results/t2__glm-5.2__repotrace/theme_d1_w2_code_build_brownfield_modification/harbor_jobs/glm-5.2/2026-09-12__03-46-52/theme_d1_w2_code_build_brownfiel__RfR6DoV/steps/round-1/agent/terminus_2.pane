   235	                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
   236	                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
   237	                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
   238	                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;
   239	                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;
   240	                case OP_LT:  emit(c, BC_LT, 0, NULL); break;
   241	                case OP_GT:  emit(c, BC_GT, 0, NULL); break;
   242	                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;
   243	                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;
   244	                case OP_AND: emit(c, BC_AND, 0, NULL); break;
   245	                case OP_OR:  emit(c, BC_OR, 0, NULL); break;
   246	            }
   247	            break;
   248	        case NODE_UNARY:
   249	            compile_expr(c, node->data.unary.operand);
   250	            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);
   251	            else emit(c, BC_NOT, 0, NULL);
   252	            break;
