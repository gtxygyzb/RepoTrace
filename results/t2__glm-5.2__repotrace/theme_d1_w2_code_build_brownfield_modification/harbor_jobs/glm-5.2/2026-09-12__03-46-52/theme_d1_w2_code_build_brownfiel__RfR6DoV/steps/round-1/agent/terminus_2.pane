   180	            case BC_RET: {
   181	                Value retval = pop(vm);
   182	                if (vm->frame_count <= 0) { fprintf(stderr, "return outside function\n"); return -1; }
   183	                CallFrame *frame = &vm->frames[--vm->frame_count];
   184	                vm->sp = frame->local_start;
   185	                vm->ip = frame->ip;
   186	                push(vm, retval);
   187	                break;
   188	            }
