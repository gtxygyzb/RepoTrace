   150	static ASTNode *parse_expr(Parser *p) {
   151	    ASTNode *left = parse_logic_and(p);
   152	    while (match(p, TOK_OR)) {
   153	        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);
