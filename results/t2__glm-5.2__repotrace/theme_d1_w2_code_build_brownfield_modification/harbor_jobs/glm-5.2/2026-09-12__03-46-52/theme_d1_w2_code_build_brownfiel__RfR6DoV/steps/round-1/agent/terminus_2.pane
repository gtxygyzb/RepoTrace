   160	static ASTNode *try_parse_assign(Parser *p) {
   161	    if (!check(p, TOK_IDENT)) return NULL;
   162	    int saved = p->pos;
   163	    p->pos++;
   164	    if (check(p, TOK_ASSIGN)) {
   165	        p->pos = saved; match(p, TOK_IDENT);
   166	        char name[MAX_IDENT_LEN];
   167	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   168	        int line = prev(p)->line;
   169	        expect(p, TOK_ASSIGN, "'='");
