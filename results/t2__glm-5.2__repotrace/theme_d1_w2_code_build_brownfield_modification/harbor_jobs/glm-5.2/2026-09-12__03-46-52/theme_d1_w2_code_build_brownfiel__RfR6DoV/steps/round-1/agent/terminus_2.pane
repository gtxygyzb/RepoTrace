[?2004hroot@n30009:/app# sed -n '1,420p' src/parser.c
[?2004l#include "parser.h"

static Token *current(Parser *p) { return &p->tokens[p->pos]; }
static Token *prev(Parser *p) { return &p->tokens[p->pos - 1]; }
static int check(Parser *p, TokenType t) { return current(p)->type == t; }

static int match(Parser *p, TokenType t) {
    if (check(p, t)) { p->pos++; return 1; }
    return 0;
}

static void expect(Parser *p, TokenType t, const char *msg) {
    if (!match(p, t)) {
        error_at(current(p)->line, "expected %s, got '%s'", msg, current(p)->text);
        p->had_error = 1;
    }
}

static ASTNode *parse_expr(Parser *p);
static ASTNode *parse_stmt(Parser *p);
static ASTNode *parse_block(Parser *p);
static ASTNode *parse_factor(Parser *p);
static ASTNode *parse_term(Parser *p);
static ASTNode *parse_comparison(Parser *p);
static ASTNode *parse_logic_and(Parser *p);
static ASTNode *parse_fn_expr(Parser *p);

static ASTNode *parse_primary(Parser *p) {
    if (match(p, TOK_NUM)) {
        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;
        n->data.num_val = prev(p)->literal.ival; return n;
    }
    if (match(p, TOK_STRING)) {
        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;
        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return n;
    }
    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {
        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;
        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;
    }
    if (match(p, TOK_IDENT)) {
        char name[MAX_IDENT_LEN];
        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\0';
        int line = prev(p)->line;
        if (match(p, TOK_LPAREN)) {
            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;
            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);
            nodelist_init(&n->data.call.args);
            if (!check(p, TOK_RPAREN)) {
                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));
            }
            expect(p, TOK_RPAREN, "')'"); return n;
        }
        if (match(p, TOK_LBRACKET)) {
            ASTNode *idx = parse_expr(p); expect(p, TOK_RBRACKET, "']'");
            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;
            ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;
            strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);
            n->data.index_access.obj = obj; n->data.index_access.index = idx; return n;
        }
        ASTNode *n = ast_alloc(); n->type = NODE_IDENT; n->line = line;
        strncpy(n->data.ident, name, MAX_IDENT_LEN - 1); return n;
    }
    if (match(p, TOK_FN)) {
        return parse_fn_expr(p);
    }
    if (match(p, TOK_LBRACKET)) {
        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;
        nodelist_init(&n->data.array_lit.elems);
        if (!check(p, TOK_RBRACKET)) {
            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));
        }
        expect(p, TOK_RBRACKET, "']'"); return n;
    }
    if (match(p, TOK_LPAREN)) {
        ASTNode *expr = parse_expr(p); expect(p, TOK_RPAREN, "')'"); return expr;
    }
    error_at(current(p)->line, "unexpected token '%s'", current(p)->text);
    p->had_error = 1; p->pos++; return ast_alloc();
}

static ASTNode *parse_fn_expr(Parser *p) {
    int line = prev(p)->line;
    expect(p, TOK_LPAREN, "'('");
    ASTNode *n = ast_alloc(); n->type = NODE_CLOSURE; n->line = line;
    n->data.closure.param_count = 0;
    if (!check(p, TOK_RPAREN)) {
        do {
            expect(p, TOK_IDENT, "parameter name");
            strncpy(n->data.closure.params[n->data.closure.param_count],
                   prev(p)->text, MAX_IDENT_LEN - 1);
            n->data.closure.param_count++;
        } while (match(p, TOK_COMMA));
    }
    expect(p, TOK_RPAREN, "')'");
    n->data.closure.body = parse_block(p);
    return n;
}

static ASTNode *parse_unary(Parser *p) {
    if (match(p, TOK_MINUS)) {
        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;
    }
    if (match(p, TOK_NOT)) {
        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;
    }
    return parse_primary(p);
}

static ASTNode *parse_factor(Parser *p) {
    ASTNode *left = parse_unary(p);
    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {
        int line = prev(p)->line; BinOp op;
        if (prev(p)->type == TOK_STAR) op = OP_MUL;
        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;
        else op = OP_MOD;
        ASTNode *right = parse_unary(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *parse_comparison(Parser *p) {
    ASTNode *left = parse_term(p);
    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||
           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {
        int line = prev(p)->line; BinOp op;
        switch (prev(p)->type) {
            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;
            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;
            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;
            default: op = OP_EQ; break;
        }
        ASTNode *right = parse_term(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *parse_term(Parser *p) {
    ASTNode *left = parse_factor(p);
    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {
        int line = prev(p)->line;
        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;
        ASTNode *right = parse_factor(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *parse_logic_and(Parser *p) {
    ASTNode *left = parse_comparison(p);
    while (match(p, TOK_AND)) {
        int line = prev(p)->line; ASTNode *right = parse_comparison(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *parse_expr(Parser *p) {
    ASTNode *left = parse_logic_and(p);
    while (match(p, TOK_OR)) {
        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *try_parse_assign(Parser *p) {
    if (!check(p, TOK_IDENT)) return NULL;
    int saved = p->pos;
    p->pos++;
    char name[MAX_IDENT_LEN];
    strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
    int line = prev(p)->line;
    if (match(p, TOK_LBRACKET)) {
        ASTNode *idx = parse_expr(p);
        expect(p, TOK_RBRACKET, "']'");
        if (check(p, TOK_ASSIGN)) {
            match(p, TOK_ASSIGN);
            ASTNode *val = parse_expr(p);
            ASTNode *n = ast_alloc(); n->type = NODE_INDEX_ASSIGN; n->line = line;
            strncpy(n->data.index_assign.name, name, MAX_IDENT_LEN - 1);
            n->data.index_assign.index = idx;
            n->data.index_assign.value = val;
            return n;
        }
        p->pos = saved;
        return NULL;
    }
    if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||
        check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {
        p->pos = saved; match(p, TOK_IDENT);
        TokenType op_tok = current(p)->type;
        BinOp op = OP_ADD;
        const char *msg = "'='";
        if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = "'+='"; expect(p, TOK_PLUS_ASSIGN, "'+='"); }
        else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = "'-='"; expect(p, TOK_MINUS_ASSIGN, "'-='"); }
        else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = "'*='"; expect(p, TOK_STAR_ASSIGN, "'*='"); }
        else if (op_tok == TOK_SLASH_ASSIGN) { op = OP_DIV; msg = "'/='"; expect(p, TOK_SLASH_ASSIGN, "'/='"); }
        else if (op_tok == TOK_PERCENT_ASSIGN) { op = OP_MOD; msg = "'%='"; expect(p, TOK_PERCENT_ASSIGN, "'%='"); }
        else { expect(p, TOK_ASSIGN, "'='"); }
        ASTNode *val = parse_expr(p);
        if (op_tok == TOK_ASSIGN) {
            ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;
            strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);
            n->data.assign.value = val; return n;
        } else {
            ASTNode *n = ast_alloc(); n->type = NODE_COMPOUND_ASSIGN; n->line = line;
            strncpy(n->data.compound_assign.name, name, MAX_IDENT_LEN - 1);
            n->data.compound_assign.op = op;
            n->data.compound_assign.value = val; return n;
        }
    }
    p->pos = saved; return NULL;
}

static ASTNode *parse_for(Parser *p) {
    int line = prev(p)->line;
    expect(p, TOK_LPAREN, "'('");

    if (check(p, TOK_IDENT) && p->pos + 1 < p->count &&
        (p->tokens[p->pos + 1].type == TOK_IN || p->tokens[p->pos + 1].type == TOK_OF)) {
        char name[MAX_IDENT_LEN];
        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
        match(p, TOK_IDENT);
        int is_of = match(p, TOK_OF);
        if (!is_of) match(p, TOK_IN);
        ASTNode *arr = parse_expr(p);
        expect(p, TOK_RPAREN, "')'");
        ASTNode *body = parse_block(p);
        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;
        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);
        n->data.foreach_stmt.arr = arr;
        n->data.foreach_stmt.body = body;
        n->data.foreach_stmt.is_of = is_of;
        return n;
    }

    ASTNode *init = NULL;
    if (match(p, TOK_LET)) {
        expect(p, TOK_IDENT, "identifier");
        char name[MAX_IDENT_LEN];
        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
        expect(p, TOK_ASSIGN, "'='");
        ASTNode *init_expr = parse_expr(p);
        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;
        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);
        init->data.let.init = init_expr;
    } else if (check(p, TOK_IDENT)) {
        init = try_parse_assign(p);
        if (!init) init = parse_expr(p);
    } else if (!check(p, TOK_SEMICOLON)) {
        init = parse_expr(p);
    }
    expect(p, TOK_SEMICOLON, "';'");

    ASTNode *cond = NULL;
    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);
    expect(p, TOK_SEMICOLON, "';'");

    ASTNode *step = NULL;
    if (!check(p, TOK_RPAREN)) {
        if (check(p, TOK_IDENT)) {
            step = try_parse_assign(p);
        }
        if (!step) step = parse_expr(p);
    }
    expect(p, TOK_RPAREN, "')'");

    ASTNode *body = parse_block(p);
    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;
    n->data.for_stmt.init = init;
    n->data.for_stmt.cond = cond;
    n->data.for_stmt.step = step;
    n->data.for_stmt.body = body;
    return n;
}

static ASTNode *parse_block(Parser *p) {
    expect(p, TOK_LBRACE, "'{'");
    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;
    nodelist_init(&block->data.block.stmts);
    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {
        ASTNode *stmt = parse_stmt(p);
        if (stmt) nodelist_push(&block->data.block.stmts, stmt);
        if (p->had_error) break;
    }
    expect(p, TOK_RBRACE, "'}'");
    return block;
}

static ASTNode *parse_stmt(Parser *p) {
    if (match(p, TOK_LET)) {
        int line = prev(p)->line;
        expect(p, TOK_IDENT, "identifier");
        char name[MAX_IDENT_LEN];
        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
        expect(p, TOK_ASSIGN, "'='");
        ASTNode *init = parse_expr(p);
        expect(p, TOK_SEMICOLON, "';'");
        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;
        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);
        n->data.let.init = init; return n;
    }
    if (match(p, TOK_IF)) {
        int line = prev(p)->line;
        expect(p, TOK_LPAREN, "'('");
        ASTNode *cond = parse_expr(p);
        expect(p, TOK_RPAREN, "')'");
        ASTNode *then_b = parse_block(p);
        ASTNode *else_b = NULL;
        if (match(p, TOK_ELSE)) {
            if (check(p, TOK_IF)) {
                ASTNode *elif = parse_stmt(p);
                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;
                nodelist_init(&else_b->data.block.stmts);
                nodelist_push(&else_b->data.block.stmts, elif);
            } else {
                else_b = parse_block(p);
            }
        }
        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;
        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;
        return n;
    }
    if (match(p, TOK_WHILE)) {
        int line = prev(p)->line;
        expect(p, TOK_LPAREN, "'('");
        ASTNode *cond = parse_expr(p);
        expect(p, TOK_RPAREN, "')'");
        ASTNode *body = parse_block(p);
        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;
        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;
    }
    if (match(p, TOK_RETURN)) {
        int line = prev(p)->line;
        ASTNode *value = NULL;
        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);
        expect(p, TOK_SEMICOLON, "';'");
        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;
        n->data.ret.value = value; return n;
    }
    if (match(p, TOK_FOR)) {
        return parse_for(p);
    }
    if (match(p, TOK_BREAK)) {
        int line = prev(p)->line;
        expect(p, TOK_SEMICOLON, "';'");
        ASTNode *n = ast_alloc(); n->type = NODE_BREAK; n->line = line; return n;
    }
    if (match(p, TOK_CONTINUE)) {
        int line = prev(p)->line;
        expect(p, TOK_SEMICOLON, "';'");
        ASTNode *n = ast_alloc(); n->type = NODE_CONTINUE; n->line = line; return n;
    }
    if (match(p, TOK_PRINT)) {
        int line = prev(p)->line;
        ASTNode *value = parse_expr(p);
        expect(p, TOK_SEMICOLON, "';'");
        ASTNode *n = ast_alloc(); n->type = NODE_PRINT; n->line = line;
        n->data.print.value = value; return n;
    }
    if (match(p, TOK_FN)) {
        int line = prev(p)->line;
        expect(p, TOK_IDENT, "function name");
        char name[MAX_IDENT_LEN];
        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
        expect(p, TOK_LPAREN, "'('");
        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;
        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);
        n->data.func.param_count = 0;
        if (!check(p, TOK_RPAREN)) {
            do {
                expect(p, TOK_IDENT, "parameter name");
                strncpy(n->data.func.params[n->data.func.param_count],
                        prev(p)->text, MAX_IDENT_LEN - 1);
                n->data.func.param_count++;
            } while (match(p, TOK_COMMA));
        }
        expect(p, TOK_RPAREN, "')'");
        n->data.func.body = parse_block(p); return n;
    }
    if (check(p, TOK_IDENT)) {
        ASTNode *a = try_parse_assign(p);
        if (a) { expect(p, TOK_SEMICOLON, "';'"); return a; }
    }
    ASTNode *expr = parse_expr(p);
    expect(p, TOK_SEMICOLON, "';'");
    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;
    n->data.expr_stmt.expr = expr; return n;
}

void parser_init(Parser *p, Token *tokens, int count) {
    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;
}

ASTNode *parse_program(Parser *p) {
    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;
    nodelist_init(&program->data.block.stmts);
    while (!check(p, TOK_EOF)) {
        ASTNode *stmt = parse_stmt(p);
        if (stmt) nodelist_push(&program->data.block.stmts, stmt);
        if (p->had_error) break;
    }
    return program;
[?2004hroot@n30009:/app# sed -n '1,460p' src/codegen.c
[?2004l#include "codegen.h"

static int emit(Compiler *c, Opcode op, int64_t operand, char *str_op) {
    if (c->code_count >= MAX_BYTECODE) { fprintf(stderr, "bytecode overflow\n"); return -1; }
    Instruction *ins = &c->code[c->code_count];
    ins->op = op; ins->operand = operand; ins->str_operand = str_op;
    return c->code_count++;
}

static int resolve_local(Compiler *c, const char *name) {
    for (int i = c->local_count - 1; i >= 0; i--) {
        if (strcmp(c->locals[i].name, name) == 0) return i;
    }
    return -1;
}

static int add_local(Compiler *c, const char *name) {
    if (c->local_count >= MAX_LOCALS) { fprintf(stderr, "too many local variables\n"); return -1; }
    Local *local = &c->locals[c->local_count];
    strncpy(local->name, name, MAX_IDENT_LEN - 1); local->name[MAX_IDENT_LEN - 1] = '\0';
    local->scope_depth = c->scope_depth;
    return c->local_count++;
}

static int find_function(Compiler *c, const char *name) {
    for (int i = 0; i < c->func_count; i++) {
        if (strcmp(c->functions[i].name, name) == 0) return i;
    }
    return -1;
}

static void compile_store(Compiler *c, const char *name) {
    int slot = resolve_local(c, name);
    if (slot >= 0) emit(c, BC_STORE_LOCAL, slot, NULL);
    else emit(c, BC_STORE_GLOBAL, 0, strdup(name));
}

static void compile_load(Compiler *c, const char *name) {
    int slot = resolve_local(c, name);
    if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);
    else emit(c, BC_LOAD_GLOBAL, 0, strdup(name));
}

#define MAX_LOOP_DEPTH 64
#define MAX_LOOP_JUMPS 256
typedef struct {
    int start;
    int cont;
    int end;
    int breaks[MAX_LOOP_JUMPS];
    int break_count;
    int conts[MAX_LOOP_JUMPS];
    int cont_count;
} LoopCtx;
static LoopCtx loop_stack[MAX_LOOP_DEPTH];
static int loop_depth = 0;

static int compile_node(Compiler *c, ASTNode *node);

static int compile_expr(Compiler *c, ASTNode *node) {
    switch (node->type) {
        case NODE_NUM_LIT:
            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;
        case NODE_STR_LIT: {
            char *s = strdup(node->data.str_val);
            emit(c, BC_PUSH_STR, 0, s); break;
        }
        case NODE_BOOL_LIT:
            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;
        case NODE_IDENT: {
            int slot = resolve_local(c, node->data.ident);
            if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);
            else emit(c, BC_LOAD_GLOBAL, 0, strdup(node->data.ident));
            break;
        }
        case NODE_BINOP:
            compile_expr(c, node->data.binop.left);
            compile_expr(c, node->data.binop.right);
            switch (node->data.binop.op) {
                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;
                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;
                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;
                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;
                case OP_LT:  emit(c, BC_LT, 0, NULL); break;
                case OP_GT:  emit(c, BC_GT, 0, NULL); break;
                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;
                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;
                case OP_AND: emit(c, BC_AND, 0, NULL); break;
                case OP_OR:  emit(c, BC_OR, 0, NULL); break;
            }
            break;
        case NODE_UNARY:
            compile_expr(c, node->data.unary.operand);
            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);
            else emit(c, BC_NOT, 0, NULL);
            break;
        case NODE_CALL: {
            int fi = find_function(c, node->data.call.name);
            if (fi < 0) { error_at(node->line, "undefined function '%s'", node->data.call.name); return -1; }
            for (int i = 0; i < node->data.call.args.count; i++)
                compile_expr(c, node->data.call.args.items[i]);
            emit(c, BC_CALL, fi, NULL);
            break;
        }
        case NODE_INDEX:
            compile_expr(c, node->data.index_access.obj);
            compile_expr(c, node->data.index_access.index);
            emit(c, BC_INDEX, 0, NULL); break;
        case NODE_ARRAY_LIT:
            for (int i = 0; i < node->data.array_lit.elems.count; i++)
                compile_expr(c, node->data.array_lit.elems.items[i]);
            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;
        default:
            error_at(node->line, "cannot compile expression of type %d", node->type); return -1;
    }
    return 0;
}

static int compile_node(Compiler *c, ASTNode *node) {
    switch (node->type) {
        case NODE_LET: {
            int slot = add_local(c, node->data.let.name);
            if (slot < 0) return -1;
            compile_expr(c, node->data.let.init);
            break;
        }
        case NODE_ASSIGN: {
            compile_expr(c, node->data.assign.value);
            compile_store(c, node->data.assign.name);
            break;
        }
        case NODE_IF: {
            compile_expr(c, node->data.if_stmt.cond);
            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
            compile_node(c, node->data.if_stmt.then_b);
            if (node->data.if_stmt.else_b) {
                int je = emit(c, BC_JUMP, 0, NULL);
                c->code[jf].operand = c->code_count;
                compile_node(c, node->data.if_stmt.else_b);
                c->code[je].operand = c->code_count;
            } else {
                c->code[jf].operand = c->code_count;
            }
            break;
        }
        case NODE_WHILE: {
            int loop_start = c->code_count;
            compile_expr(c, node->data.while_stmt.cond);
            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, "too many nested loops"); return -1; }
            LoopCtx *ctx = &loop_stack[loop_depth++];
            ctx->start = loop_start; ctx->cont = loop_start; ctx->end = -1;
            ctx->break_count = 0; ctx->cont_count = 0;
            compile_node(c, node->data.while_stmt.body);
            emit(c, BC_JUMP, loop_start, NULL);
            int end = c->code_count;
            c->code[jf].operand = end;
            ctx->end = end;
            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;
            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = ctx->cont;
            loop_depth--;
            break;
        }
        case NODE_FOR: {
            int old_lc = c->local_count;
            c->scope_depth++;
            if (node->data.for_stmt.init) compile_node(c, node->data.for_stmt.init);
            int loop_start = c->code_count;
            if (node->data.for_stmt.cond) compile_expr(c, node->data.for_stmt.cond);
            else emit(c, BC_PUSH_BOOL, 1, NULL);
            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, "too many nested loops"); return -1; }
            LoopCtx *ctx = &loop_stack[loop_depth++];
            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;
            ctx->break_count = 0; ctx->cont_count = 0;
            compile_node(c, node->data.for_stmt.body);
            int step_start = c->code_count;
            ctx->cont = step_start;
            if (node->data.for_stmt.step) compile_node(c, node->data.for_stmt.step);
            emit(c, BC_JUMP, loop_start, NULL);
            int end = c->code_count;
            c->code[jf].operand = end;
            ctx->end = end;
            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;
            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = step_start;
            loop_depth--;
            int n = c->local_count - old_lc;
            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
            c->local_count = old_lc;
            c->scope_depth--;
            break;
        }
        case NODE_FOREACH: {
            int old_lc = c->local_count;
            c->scope_depth++;
            compile_expr(c, node->data.foreach_stmt.arr);
            int arr_slot = add_local(c, ".forarr");
            emit(c, BC_PUSH_INT, 0, NULL);
            int idx_slot = add_local(c, ".foridx");
            int var_slot = add_local(c, node->data.foreach_stmt.var);
            emit(c, BC_PUSH_INT, 0, NULL);
            int loop_start = c->code_count;
            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
            emit(c, BC_LOAD_LOCAL, arr_slot, NULL);
            emit(c, BC_ARRAY_LEN, 0, NULL);
            emit(c, BC_LT, 0, NULL);
            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, "too many nested loops"); return -1; }
            LoopCtx *ctx = &loop_stack[loop_depth++];
            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;
            ctx->break_count = 0; ctx->cont_count = 0;
            int body_old = c->local_count;
            if (node->data.foreach_stmt.is_of) {
                emit(c, BC_LOAD_LOCAL, arr_slot, NULL);
                emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
                emit(c, BC_INDEX, 0, NULL);
            } else {
                emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
            }
            emit(c, BC_STORE_LOCAL, var_slot, NULL);
            compile_node(c, node->data.foreach_stmt.body);
            int n = c->local_count - body_old;
            int cleanup_start = c->code_count;
            ctx->cont = cleanup_start;
            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
            c->local_count = body_old;
            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
            emit(c, BC_PUSH_INT, 1, NULL);
            emit(c, BC_ADD, 0, NULL);
            emit(c, BC_STORE_LOCAL, idx_slot, NULL);
            emit(c, BC_JUMP, loop_start, NULL);
            int break_cleanup = c->code_count;
            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
            int end = c->code_count;
            c->code[jf].operand = end;
            ctx->end = end;
            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = break_cleanup;
            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = ctx->cont;
            loop_depth--;
            int n2 = c->local_count - old_lc;
            for (int i = 0; i < n2; i++) emit(c, BC_POP, 0, NULL);
            c->local_count = old_lc;
            c->scope_depth--;
            break;
        }
        case NODE_BREAK: {
            if (loop_depth <= 0) { error_at(node->line, "break outside loop"); return -1; }
            LoopCtx *ctx = &loop_stack[loop_depth - 1];
            if (ctx->break_count >= MAX_LOOP_JUMPS) { error_at(node->line, "too many break statements"); return -1; }
            ctx->breaks[ctx->break_count++] = emit(c, BC_JUMP, 0, NULL);
            break;
        }
        case NODE_CONTINUE: {
            if (loop_depth <= 0) { error_at(node->line, "continue outside loop"); return -1; }
            LoopCtx *ctx = &loop_stack[loop_depth - 1];
            if (ctx->cont_count >= MAX_LOOP_JUMPS) { error_at(node->line, "too many continue statements"); return -1; }
            ctx->conts[ctx->cont_count++] = emit(c, BC_JUMP, 0, NULL);
            break;
        }
        case NODE_COMPOUND_ASSIGN: {
            compile_load(c, node->data.compound_assign.name);
            compile_expr(c, node->data.compound_assign.value);
            switch (node->data.compound_assign.op) {
                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;
                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;
                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
                default: error_at(node->line, "invalid compound assignment"); return -1;
            }
            compile_store(c, node->data.compound_assign.name);
            break;
        }
        case NODE_RETURN: {
            if (node->data.ret.value) compile_expr(c, node->data.ret.value);
            else emit(c, BC_PUSH_INT, 0, NULL);
            emit(c, BC_RET, 0, NULL);
            break;
        }
        case NODE_PRINT: {
            compile_expr(c, node->data.print.value);
            emit(c, BC_PRINT, 0, NULL);
            break;
        }
        case NODE_BLOCK: {
            int old_lc = c->local_count;
            c->scope_depth++;
            for (int i = 0; i < node->data.block.stmts.count; i++)
                compile_node(c, node->data.block.stmts.items[i]);
            c->scope_depth--;
            {
                int n = c->local_count - old_lc;
                for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
            }
            c->local_count = old_lc;
            break;
        }
        case NODE_FUNC: {
            int jump_over = emit(c, BC_JUMP, 0, NULL);

            if (c->func_count >= MAX_FUNCTIONS) { fprintf(stderr, "too many functions\n"); return -1; }
            FuncInfo *fi = &c->functions[c->func_count];
            strncpy(fi->name, node->data.func.name, MAX_IDENT_LEN - 1);
            fi->addr = c->code_count;
            fi->param_count = node->data.func.param_count;
            c->func_count++;

            int old_lc = c->local_count;
            int old_scope = c->scope_depth;
            int old_inf = c->in_function;
            int old_loop_depth = loop_depth;
            loop_depth = 0;

            c->local_count = 0;
            c->scope_depth = 0;
            c->in_function = 1;
            c->scope_depth++;

            for (int i = 0; i < node->data.func.param_count; i++)
                add_local(c, node->data.func.params[i]);

            compile_node(c, node->data.func.body);

            emit(c, BC_PUSH_INT, 0, NULL);
            emit(c, BC_RET, 0, NULL);

            c->scope_depth = old_scope;
            c->local_count = old_lc;
            c->in_function = old_inf;
            loop_depth = old_loop_depth;

            c->code[jump_over].operand = c->code_count;
            break;
        }
        case NODE_EXPR_STMT: {
            compile_expr(c, node->data.expr_stmt.expr);
            emit(c, BC_POP, 0, NULL);
            break;
        }
        default:
            compile_expr(c, node);
            emit(c, BC_POP, 0, NULL);
            break;
    }
    return 0;
}

void compiler_init(Compiler *c) {
    c->code_count = 0; c->local_count = 0; c->scope_depth = 0;
    c->func_count = 0; c->in_function = 0;
}

int compile(Compiler *c, ASTNode *program) {
    if (compile_node(c, program) < 0) return -1;
    emit(c, BC_HALT, 0, NULL);
    return 0;
}
