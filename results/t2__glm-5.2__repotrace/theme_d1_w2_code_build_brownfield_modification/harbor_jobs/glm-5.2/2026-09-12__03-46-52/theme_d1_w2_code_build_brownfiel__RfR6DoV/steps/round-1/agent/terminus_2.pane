    29	static ASTNode *parse_primary(Parser *p) {
    30	    if (match(p, TOK_NUM)) {
    31	        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;
    32	        n->data.num_val = prev(p)->literal.ival; return n;
    33	    }
    34	    if (match(p, TOK_STRING)) {
    35	        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;
    36	        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return n;
    37	    }
    38	    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {
    39	        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;
    40	        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;
    41	    }
    42	    if (match(p, TOK_IDENT)) {
    43	        char name[MAX_IDENT_LEN];
    44	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\0';
    45	        int line = prev(p)->line;
    46	        if (match(p, TOK_LPAREN)) {
    47	            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;
    48	            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);
    49	            nodelist_init(&n->data.call.args);
    50	            if (!check(p, TOK_RPAREN)) {
    51	                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));
    52	            }
    53	            expect(p, TOK_RPAREN, "')'"); return parse_postfix(p, n);
    54	        }
    55	        ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;
    56	        strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);
    57	        return parse_postfix(p, obj);
    58	    }
    59	    if (match(p, TOK_LBRACE)) {
    60	        int line = prev(p)->line;
    61	        ASTNode *n = ast_alloc(); n->type = NODE_MAP_LIT; n->line = line;
    62	        nodelist_init(&n->data.map_lit.keys);
    63	        nodelist_init(&n->data.map_lit.values);
    64	        if (!check(p, TOK_RBRACE)) {
    65	            do {
    66	                if (!check(p, TOK_STRING)) {
    67	                    error_at(current(p)->line, "map keys must be string literals");
    68	                    p->had_error = 1; p->pos++;
    69	                } else {
    70	                    match(p, TOK_STRING);
    71	                    ASTNode *key = ast_alloc(); key->type = NODE_STR_LIT; key->line = prev(p)->line;
    72	                    strncpy(key->data.str_val, prev(p)->text, MAX_STRING_LEN - 1);
    73	                    expect(p, TOK_COLON, "':'");
    74	                    ASTNode *val = parse_expr(p);
    75	                    nodelist_push(&n->data.map_lit.keys, key);
    76	                    nodelist_push(&n->data.map_lit.values, val);
    77	                }
    78	            } while (match(p, TOK_COMMA));
    79	        }
    80	        expect(p, TOK_RBRACE, "'}'");
    81	        return parse_postfix(p, n);
    82	    }
    83	    if (match(p, TOK_FN)) {
    84	        return parse_postfix(p, parse_fn_expr(p));
    85	    }
    86	    if (match(p, TOK_LBRACKET)) {
    87	        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;
    88	        nodelist_init(&n->data.array_lit.elems);
    89	        if (!check(p, TOK_RBRACKET)) {
    90	            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));
    91	        }
    92	        expect(p, TOK_RBRACKET, "']'"); return parse_postfix(p, n);
    93	    }
    94	    if (match(p, TOK_LPAREN)) {
    95	        ASTNode *expr = parse_expr(p); expect(p, TOK_RPAREN, "')'"); return parse_postfix(p, expr);
    96	    }
    97	    error_at(current(p)->line, "unexpected token '%s'", current(p)->text);
    98	    p->had_error = 1; p->pos++; return ast_alloc();
    99	}
   100	
   101	static ASTNode *parse_fn_expr(Parser *p) {
   102	    int line = prev(p)->line;
   103	    expect(p, TOK_LPAREN, "'('");
   104	    ASTNode *n = ast_alloc(); n->type = NODE_CLOSURE; n->line = line;
   105	    n->data.closure.param_count = 0;
   106	    if (!check(p, TOK_RPAREN)) {
   107	        do {
   108	            expect(p, TOK_IDENT, "parameter name");
   109	            strncpy(n->data.closure.params[n->data.closure.param_count],
   110	                   prev(p)->text, MAX_IDENT_LEN - 1);
   111	            n->data.closure.param_count++;
   112	        } while (match(p, TOK_COMMA));
   113	    }
   114	    expect(p, TOK_RPAREN, "')'");
   115	    n->data.closure.body = parse_block(p);
   116	    return n;
   117	}
   118	
   119	static ASTNode *parse_postfix(Parser *p, ASTNode *expr) {
   120	    for (;;) {
   121	        if (match(p, TOK_DOT)) {
   122	            int line = prev(p)->line;
   123	            expect(p, TOK_IDENT, "field name");
   124	            ASTNode *n = ast_alloc(); n->type = NODE_FIELD_ACCESS; n->line = line;
   125	            n->data.field_access.obj = expr;
   126	            strncpy(n->data.field_access.field, prev(p)->text, MAX_IDENT_LEN - 1);
   127	            n->data.field_access.field[MAX_IDENT_LEN - 1] = '\0';
   128	            expr = n;
   129	        } else if (match(p, TOK_LBRACKET)) {
   130	            int line = prev(p)->line;
   131	            ASTNode *idx = parse_expr(p);
   132	            expect(p, TOK_RBRACKET, "']'");
   133	            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;
   134	            n->data.index_access.obj = expr;
   135	            n->data.index_access.index = idx;
   136	            expr = n;
   137	        } else {
   138	            break;
   139	        }
   140	    }
   141	    return expr;
   142	}
   143	
   144	static ASTNode *parse_unary(Parser *p) {
   145	    if (match(p, TOK_MINUS)) {
   146	        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
   147	        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
   148	        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;
   149	    }
   150	    if (match(p, TOK_NOT)) {
   151	        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
   152	        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
   153	        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;
   154	    }
   155	    return parse_primary(p);
   156	}
   157	
   158	static ASTNode *parse_factor(Parser *p) {
   159	    ASTNode *left = parse_unary(p);
   160	    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {
   161	        int line = prev(p)->line; BinOp op;
   162	        if (prev(p)->type == TOK_STAR) op = OP_MUL;
   163	        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;
   164	        else op = OP_MOD;
   165	        ASTNode *right = parse_unary(p);
   166	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   167	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   168	        left = n;
   169	    }
   170	    return left;
   171	}
   172	
   173	static ASTNode *parse_comparison(Parser *p) {
   174	    ASTNode *left = parse_term(p);
   175	    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||
   176	           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {
   177	        int line = prev(p)->line; BinOp op;
   178	        switch (prev(p)->type) {
   179	            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;
   180	            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;
