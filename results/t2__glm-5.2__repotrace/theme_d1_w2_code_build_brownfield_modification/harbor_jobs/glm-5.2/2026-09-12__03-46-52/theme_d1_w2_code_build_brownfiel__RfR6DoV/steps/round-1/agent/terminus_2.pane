     4	    if (c->code_count >= MAX_BYTECODE) { fprintf(stderr, "bytecode overflow\n"); return -1; }
     5	    Instruction *ins = &c->code[c->code_count];
     6	    ins->op = op; ins->operand = operand; ins->str_operand = str_op;
     7	    return c->code_count++;
