   294	static ASTNode *parse_block(Parser *p) {
   295	    expect(p, TOK_LBRACE, "'{'");
   296	    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;
   297	    nodelist_init(&block->data.block.stmts);
   298	    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {
   299	        ASTNode *stmt = parse_stmt(p);
   300	        if (stmt) nodelist_push(&block->data.block.stmts, stmt);
   301	        if (p->had_error) break;
   302	    }
   303	    expect(p, TOK_RBRACE, "'}'");
   304	    return block;
   305	}
   306	
   307	static ASTNode *parse_stmt(Parser *p) {
   308	    if (match(p, TOK_LET)) {
   309	        int line = prev(p)->line;
   310	        expect(p, TOK_IDENT, "identifier");
   311	        char name[MAX_IDENT_LEN];
   312	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   313	        expect(p, TOK_ASSIGN, "'='");
   314	        ASTNode *init = parse_expr(p);
   315	        expect(p, TOK_SEMICOLON, "';'");
   316	        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;
   317	        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);
   318	        n->data.let.init = init; return n;
   319	    }
   320	    if (match(p, TOK_IF)) {
   321	        int line = prev(p)->line;
   322	        expect(p, TOK_LPAREN, "'('");
   323	        ASTNode *cond = parse_expr(p);
   324	        expect(p, TOK_RPAREN, "')'");
   325	        ASTNode *then_b = parse_block(p);
   326	        ASTNode *else_b = NULL;
   327	        if (match(p, TOK_ELSE)) {
   328	            if (check(p, TOK_IF)) {
   329	                ASTNode *elif = parse_stmt(p);
   330	                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;
   331	                nodelist_init(&else_b->data.block.stmts);
   332	                nodelist_push(&else_b->data.block.stmts, elif);
   333	            } else {
   334	                else_b = parse_block(p);
   335	            }
   336	        }
   337	        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;
   338	        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;
   339	        return n;
   340	    }
   341	    if (match(p, TOK_WHILE)) {
   342	        int line = prev(p)->line;
   343	        expect(p, TOK_LPAREN, "'('");
   344	        ASTNode *cond = parse_expr(p);
   345	        expect(p, TOK_RPAREN, "')'");
   346	        ASTNode *body = parse_block(p);
   347	        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;
   348	        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;
   349	    }
   350	    if (match(p, TOK_RETURN)) {
   351	        int line = prev(p)->line;
   352	        ASTNode *value = NULL;
   353	        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);
   354	        expect(p, TOK_SEMICOLON, "';'");
   355	        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;
   356	        n->data.ret.value = value; return n;
   357	    }
   358	    if (match(p, TOK_FOR)) {
   359	        return parse_for(p);
   360	    }
   361	    if (match(p, TOK_BREAK)) {
   362	        int line = prev(p)->line;
   363	        expect(p, TOK_SEMICOLON, "';'");
   364	        ASTNode *n = ast_alloc(); n->type = NODE_BREAK; n->line = line; return n;
   365	    }
   366	    if (match(p, TOK_CONTINUE)) {
   367	        int line = prev(p)->line;
   368	        expect(p, TOK_SEMICOLON, "';'");
   369	        ASTNode *n = ast_alloc(); n->type = NODE_CONTINUE; n->line = line; return n;
   370	    }
   371	    if (match(p, TOK_PRINT)) {
   372	        int line = prev(p)->line;
   373	        ASTNode *value = parse_expr(p);
   374	        expect(p, TOK_SEMICOLON, "';'");
   375	        ASTNode *n = ast_alloc(); n->type = NODE_PRINT; n->line = line;
   376	        n->data.print.value = value; return n;
   377	    }
   378	    if (match(p, TOK_FN)) {
   379	        int line = prev(p)->line;
   380	        expect(p, TOK_IDENT, "function name");
   381	        char name[MAX_IDENT_LEN];
   382	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   383	        expect(p, TOK_LPAREN, "'('");
   384	        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;
   385	        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);
   386	        n->data.func.param_count = 0;
   387	        if (!check(p, TOK_RPAREN)) {
   388	            do {
   389	                expect(p, TOK_IDENT, "parameter name");
   390	                strncpy(n->data.func.params[n->data.func.param_count],
   391	                        prev(p)->text, MAX_IDENT_LEN - 1);
   392	                n->data.func.param_count++;
   393	            } while (match(p, TOK_COMMA));
   394	        }
   395	        expect(p, TOK_RPAREN, "')'");
   396	        n->data.func.body = parse_block(p); return n;
   397	    }
   398	    if (check(p, TOK_IDENT)) {
   399	        ASTNode *a = try_parse_assign(p);
   400	        if (a) { expect(p, TOK_SEMICOLON, "';'"); return a; }
   401	    }
   402	    ASTNode *expr = parse_expr(p);
   403	    expect(p, TOK_SEMICOLON, "';'");
   404	    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;
   405	    n->data.expr_stmt.expr = expr; return n;
   406	}
