   245	        ASTNode *body = parse_block(p);
   246	        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;
   247	        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);
   248	        n->data.foreach_stmt.arr = arr;
   249	        n->data.foreach_stmt.body = body;
   250	        n->data.foreach_stmt.is_of = is_of;
   251	        return n;
   252	    }
