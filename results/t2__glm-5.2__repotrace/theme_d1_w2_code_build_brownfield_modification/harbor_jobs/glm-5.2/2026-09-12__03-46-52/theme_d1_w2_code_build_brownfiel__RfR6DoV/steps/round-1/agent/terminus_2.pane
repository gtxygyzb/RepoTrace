     3	static ASTNode node_pool[MAX_AST_NODES];
     4	static int node_pool_count = 0;
     5	
     6	ASTNode *ast_alloc(void) {
     7	    if (node_pool_count >= MAX_AST_NODES) { fprintf(stderr, "AST node pool exhausted\n"); exit(1); }
     8	    ASTNode *n = &node_pool[node_pool_count++];
     9	    memset(n, 0, sizeof(ASTNode));
    10	    return n;
    11	}
    12	
    13	void ast_free_all(void) { node_pool_count = 0; }
    14	
    15	void nodelist_init(NodeList *list) { list->items = NULL; list->count = 0; list->cap = 0; }
    16	
    17	void nodelist_push(NodeList *list, ASTNode *node) {
    18	    if (list->count >= list->cap) {
    19	        int new_cap = list->cap == 0 ? 8 : list->cap * 2;
    20	        list->items = realloc(list->items, new_cap * sizeof(ASTNode *));
    21	        list->cap = new_cap;
    22	    }
    23	    list->items[list->count++] = node;
    24	}
