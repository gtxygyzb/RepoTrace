                    cap_slots[cap_count - 1] = slot;
                    c->locals[slot].is_boxed = 1;
                } else {
                    int cap = resolve_capture(c, nm);
                    if (cap >= 0) {
                        add_name(cap_names, &cap_count, nm);
                        cap_slots[cap_count - 1] = -1 - cap;
