   479	void parser_init(Parser *p, Token *tokens, int count) {
   480	    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;
   481	}
   482	
   483	ASTNode *parse_program(Parser *p) {
   484	    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;
   485	    nodelist_init(&program->data.block.stmts);
   486	    while (!check(p, TOK_EOF)) {
   487	        ASTNode *stmt = parse_stmt(p);
   488	        if (stmt) nodelist_push(&program->data.block.stmts, stmt);
   489	        if (p->had_error) break;
   490	    }
   491	    return program;
   492	}
