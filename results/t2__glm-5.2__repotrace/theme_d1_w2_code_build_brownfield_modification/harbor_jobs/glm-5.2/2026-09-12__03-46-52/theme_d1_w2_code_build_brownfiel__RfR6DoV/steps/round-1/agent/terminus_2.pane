   405	void parser_init(Parser *p, Token *tokens, int count) {
   406	    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;
   407	}
   408	
   409	ASTNode *parse_program(Parser *p) {
   410	    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;
   411	    nodelist_init(&program->data.block.stmts);
   412	    while (!check(p, TOK_EOF)) {
   413	        ASTNode *stmt = parse_stmt(p);
   414	        if (stmt) nodelist_push(&program->data.block.stmts, stmt);
   415	        if (p->had_error) break;
   416	    }
   417	    return program;
   418	}
