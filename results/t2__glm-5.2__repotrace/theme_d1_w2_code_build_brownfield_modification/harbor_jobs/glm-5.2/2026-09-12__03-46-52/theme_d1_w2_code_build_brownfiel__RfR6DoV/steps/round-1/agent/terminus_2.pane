    80	void vm_init(VM *vm, Compiler *c) {
    81	    vm->sp = 0; vm->frame_count = 0; vm->global_count = 0;
    82	    vm->code = c->code; vm->code_count = c->code_count;
    83	    vm->functions = c->functions; vm->func_count = c->func_count;
    84	    vm->ip = 0;
    85	}
