   171	            compile_expr(c, node->data.let.init);
   172	            break;
   173	        }
   174	        case NODE_ASSIGN: {
   175	            compile_expr(c, node->data.assign.value);
   176	            compile_store(c, node->data.assign.name);
   177	            break;
   178	        }
   179	        case NODE_INDEX_ASSIGN: {
   180	            if (node->data.index_assign.obj) {
   181	                compile_expr(c, node->data.index_assign.obj);
   182	                compile_expr(c, node->data.index_assign.index);
   183	                compile_expr(c, node->data.index_assign.value);
   184	                emit(c, BC_INDEX_STORE, 0, NULL);
   185	            } else {
   186	                compile_load(c, node->data.index_assign.name);
   187	                compile_expr(c, node->data.index_assign.index);
   188	                compile_expr(c, node->data.index_assign.value);
   189	                emit(c, BC_INDEX_STORE, 0, NULL);
   190	            }
   191	            break;
   192	        }
   193	        case NODE_FIELD_ASSIGN: {
   194	            compile_expr(c, node->data.field_assign.obj);
   195	            emit(c, BC_PUSH_STR, 0, strdup(node->data.field_assign.field));
   196	            compile_expr(c, node->data.field_assign.value);
   197	            emit(c, BC_MAP_SET, 0, NULL);
   198	            break;
   199	        }
   200	        case NODE_IF: {
   201	            compile_expr(c, node->data.if_stmt.cond);
   202	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   203	            compile_node(c, node->data.if_stmt.then_b);
   204	            if (node->data.if_stmt.else_b) {
   205	                int je = emit(c, BC_JUMP, 0, NULL);
   206	                c->code[jf].operand = c->code_count;
   207	                compile_node(c, node->data.if_stmt.else_b);
   208	                c->code[je].operand = c->code_count;
   209	            } else {
   210	                c->code[jf].operand = c->code_count;
   211	            }
   212	            break;
   213	        }
   214	        case NODE_WHILE: {
   215	            int loop_start = c->code_count;
   216	            compile_expr(c, node->data.while_stmt.cond);
   217	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   218	            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, "too many nested loops"); return -1; }
   219	            LoopCtx *ctx = &loop_stack[loop_depth++];
   220	            ctx->start = loop_start; ctx->cont = loop_start; ctx->end = -1;
   221	            ctx->break_count = 0; ctx->cont_count = 0;
   222	            compile_node(c, node->data.while_stmt.body);
   223	            emit(c, BC_JUMP, loop_start, NULL);
   224	            int end = c->code_count;
   225	            c->code[jf].operand = end;
   226	            ctx->end = end;
   227	            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;
   228	            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = ctx->cont;
   229	            loop_depth--;
   230	            break;
   231	        }
   232	        case NODE_FOR: {
   233	            int old_lc = c->local_count;
   234	            c->scope_depth++;
   235	            if (node->data.for_stmt.init) compile_node(c, node->data.for_stmt.init);
   236	            int loop_start = c->code_count;
   237	            if (node->data.for_stmt.cond) compile_expr(c, node->data.for_stmt.cond);
   238	            else emit(c, BC_PUSH_BOOL, 1, NULL);
   239	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   240	            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, "too many nested loops"); return -1; }
   241	            LoopCtx *ctx = &loop_stack[loop_depth++];
   242	            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;
   243	            ctx->break_count = 0; ctx->cont_count = 0;
