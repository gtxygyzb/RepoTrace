    44	#define MAX_LOOP_DEPTH 64
    45	#define MAX_LOOP_JUMPS 256
    46	typedef struct {
    47	    int start;
    48	    int cont;
    49	    int end;
    50	    int breaks[MAX_LOOP_JUMPS];
    51	    int break_count;
    52	    int conts[MAX_LOOP_JUMPS];
    53	    int cont_count;
    54	} LoopCtx;
    55	static LoopCtx loop_stack[MAX_LOOP_DEPTH];
    56	static int loop_depth = 0;
