   199	#define MAX_LOOP_DEPTH 64
   200	#define MAX_LOOP_JUMPS 256
   201	typedef struct {
   202	    int start;
   203	    int cont;
   204	    int end;
   205	    int breaks[MAX_LOOP_JUMPS];
   206	    int break_count;
   207	    int conts[MAX_LOOP_JUMPS];
   208	    int cont_count;
   209	} LoopCtx;
   210	static LoopCtx loop_stack[MAX_LOOP_DEPTH];
   211	static int loop_depth = 0;
