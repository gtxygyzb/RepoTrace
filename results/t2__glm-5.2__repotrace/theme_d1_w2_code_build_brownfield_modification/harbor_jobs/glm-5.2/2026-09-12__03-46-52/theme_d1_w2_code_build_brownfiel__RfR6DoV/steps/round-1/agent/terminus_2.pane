   103	/* NOTE: comparison operators are parsed at a tighter binding than +/-,
   104	   which is buggy: `a + b == c` is parsed as `a + (b == c)` instead of
   105	   `(a + b) == c`. */
   106	static ASTNode *parse_comparison(Parser *p) {
   107	    ASTNode *left = parse_factor(p);
   108	    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||
   109	           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {
   110	        int line = prev(p)->line; BinOp op;
   111	        switch (prev(p)->type) {
   112	            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;
   113	            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;
   114	            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;
   115	            default: op = OP_EQ; break;
   116	        }
   117	        ASTNode *right = parse_factor(p);
   118	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   119	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   120	        left = n;
   121	    }
   122	    return left;
   123	}
   124	
   125	static ASTNode *parse_term(Parser *p) {
   126	    ASTNode *left = parse_comparison(p);
   127	    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {
   128	        int line = prev(p)->line;
   129	        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;
   130	        ASTNode *right = parse_comparison(p);
   131	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   132	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   133	        left = n;
   134	    }
   135	    return left;
   136	}
   137	
   138	static ASTNode *parse_logic_and(Parser *p) {
   139	    ASTNode *left = parse_term(p);
   140	    while (match(p, TOK_AND)) {
   141	        int line = prev(p)->line; ASTNode *right = parse_term(p);
   142	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   143	        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;
   144	        left = n;
   145	    }
   146	    return left;
   147	}
   148	
   149	static ASTNode *parse_expr(Parser *p) {
   150	    ASTNode *left = parse_logic_and(p);
   151	    while (match(p, TOK_OR)) {
   152	        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);
   153	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   154	        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;
   155	        left = n;
   156	    }
   157	    return left;
   158	}
   159	
   160	static ASTNode *try_parse_assign(Parser *p) {
   161	    if (!check(p, TOK_IDENT)) return NULL;
   162	    int saved = p->pos;
   163	    p->pos++;
   164	    if (check(p, TOK_ASSIGN)) {
   165	        p->pos = saved; match(p, TOK_IDENT);
   166	        char name[MAX_IDENT_LEN];
   167	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   168	        int line = prev(p)->line;
   169	        expect(p, TOK_ASSIGN, "'='");
   170	        ASTNode *val = parse_expr(p);
   171	        ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;
   172	        strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);
   173	        n->data.assign.value = val; return n;
   174	    }
   175	    p->pos = saved; return NULL;
   176	}
   177	
   178	static ASTNode *parse_block(Parser *p) {
   179	    expect(p, TOK_LBRACE, "'{'");
   180	    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;
   181	    nodelist_init(&block->data.block.stmts);
   182	    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {
   183	        ASTNode *stmt = parse_stmt(p);
   184	        if (stmt) nodelist_push(&block->data.block.stmts, stmt);
   185	        if (p->had_error) break;
   186	    }
   187	    expect(p, TOK_RBRACE, "'}'");
   188	    return block;
   189	}
   190	
   191	static ASTNode *parse_stmt(Parser *p) {
   192	    if (match(p, TOK_LET)) {
   193	        int line = prev(p)->line;
   194	        expect(p, TOK_IDENT, "identifier");
   195	        char name[MAX_IDENT_LEN];
   196	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   197	        expect(p, TOK_ASSIGN, "'='");
   198	        ASTNode *init = parse_expr(p);
   199	        expect(p, TOK_SEMICOLON, "';'");
   200	        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;
   201	        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);
   202	        n->data.let.init = init; return n;
   203	    }
   204	    if (match(p, TOK_IF)) {
   205	        int line = prev(p)->line;
   206	        expect(p, TOK_LPAREN, "'('");
   207	        ASTNode *cond = parse_expr(p);
   208	        expect(p, TOK_RPAREN, "')'");
   209	        ASTNode *then_b = parse_block(p);
   210	        ASTNode *else_b = NULL;
   211	        if (match(p, TOK_ELSE)) {
   212	            if (check(p, TOK_IF)) {
   213	                ASTNode *elif = parse_stmt(p);
   214	                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;
   215	                nodelist_init(&else_b->data.block.stmts);
   216	                nodelist_push(&else_b->data.block.stmts, elif);
   217	            } else {
   218	                else_b = parse_block(p);
   219	            }
   220	        }
   221	        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;
   222	        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;
   223	        return n;
   224	    }
   225	    if (match(p, TOK_WHILE)) {
   226	        int line = prev(p)->line;
   227	        expect(p, TOK_LPAREN, "'('");
   228	        ASTNode *cond = parse_expr(p);
   229	        expect(p, TOK_RPAREN, "')'");
   230	        ASTNode *body = parse_block(p);
   231	        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;
   232	        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;
   233	    }
   234	    if (match(p, TOK_RETURN)) {
   235	        int line = prev(p)->line;
   236	        ASTNode *value = NULL;
   237	        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);
   238	        expect(p, TOK_SEMICOLON, "';'");
   239	        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;
   240	        n->data.ret.value = value; return n;
   241	    }
   242	    if (match(p, TOK_PRINT)) {
   243	        int line = prev(p)->line;
   244	        ASTNode *value = parse_expr(p);
   245	        expect(p, TOK_SEMICOLON, "';'");
   246	        ASTNode *n = ast_alloc(); n->type = NODE_PRINT; n->line = line;
   247	        n->data.print.value = value; return n;
   248	    }
   249	    if (match(p, TOK_FN)) {
   250	        int line = prev(p)->line;
   251	        expect(p, TOK_IDENT, "function name");
   252	        char name[MAX_IDENT_LEN];
   253	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   254	        expect(p, TOK_LPAREN, "'('");
   255	        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;
   256	        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);
   257	        n->data.func.param_count = 0;
   258	        if (!check(p, TOK_RPAREN)) {
   259	            do {
   260	                expect(p, TOK_IDENT, "parameter name");
   261	                strncpy(n->data.func.params[n->data.func.param_count],
   262	                        prev(p)->text, MAX_IDENT_LEN - 1);
   263	                n->data.func.param_count++;
   264	            } while (match(p, TOK_COMMA));
   265	        }
   266	        expect(p, TOK_RPAREN, "')'");
   267	        n->data.func.body = parse_block(p); return n;
   268	    }
   269	    if (check(p, TOK_IDENT)) {
   270	        ASTNode *a = try_parse_assign(p);
   271	        if (a) { expect(p, TOK_SEMICOLON, "';'"); return a; }
   272	    }
   273	    ASTNode *expr = parse_expr(p);
   274	    expect(p, TOK_SEMICOLON, "';'");
   275	    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;
   276	    n->data.expr_stmt.expr = expr; return n;
   277	}
   278	
   279	void parser_init(Parser *p, Token *tokens, int count) {
   280	    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;
   281	}
   282	
   283	ASTNode *parse_program(Parser *p) {
   284	    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;
   285	    nodelist_init(&program->data.block.stmts);
   286	    while (!check(p, TOK_EOF)) {
   287	        ASTNode *stmt = parse_stmt(p);
   288	        if (stmt) nodelist_push(&program->data.block.stmts, stmt);
   289	        if (p->had_error) break;
   290	    }
   291	    return program;
   292	}
