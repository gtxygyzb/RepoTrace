   104	void lexer_init(Lexer *lex, const char *source) {
   105	    lex->source = source; lex->pos = 0; lex->line = 1; lex->col = 1; lex->token_count = 0;
   106	}
   107	
   108	int lexer_tokenize(Lexer *lex) {
   109	    while (!is_at_end(lex)) {
   110	        skip_whitespace(lex);
   111	        if (is_at_end(lex)) break;
   112	        char c = peek(lex);
   113	        if (isdigit(c)) { if (lex_number(lex) < 0) return -1; }
   114	        else if (c == '"') { if (lex_string(lex) < 0) return -1; }
   115	        else if (isalpha(c) || c == '_') { if (lex_ident(lex) < 0) return -1; }
   116	        else {
   117	            advance(lex);
   118	            char buf[4] = {c, '\0', '\0', '\0'};
   119	            TokenType type = TOK_ERROR;
   120	            switch (c) {
   121	                case '+': type = TOK_PLUS; break;
   122	                case '-': type = TOK_MINUS; break;
   123	                case '*': type = TOK_STAR; break;
   124	                case '/': type = TOK_SLASH; break;
   125	                case '%': type = TOK_PERCENT; break;
   126	                case '(': type = TOK_LPAREN; break;
   127	                case ')': type = TOK_RPAREN; break;
   128	                case '{': type = TOK_LBRACE; break;
   129	                case '}': type = TOK_RBRACE; break;
   130	                case '[': type = TOK_LBRACKET; break;
   131	                case ']': type = TOK_RBRACKET; break;
   132	                case ';': type = TOK_SEMICOLON; break;
   133	                case ',': type = TOK_COMMA; break;
   134	                case '!': if (peek(lex)=='='){advance(lex);type=TOK_NEQ;strcpy(buf,"!=");}else{type=TOK_NOT;} break;
   135	                case '=': if (peek(lex)=='='){advance(lex);type=TOK_EQ;strcpy(buf,"==");}else{type=TOK_ASSIGN;} break;
   136	                case '<': if (peek(lex)=='='){advance(lex);type=TOK_LEQ;strcpy(buf,"<=");}else{type=TOK_LT;} break;
   137	                case '>': if (peek(lex)=='='){advance(lex);type=TOK_GEQ;strcpy(buf,">=");}else{type=TOK_GT;} break;
   138	                case '&': if (peek(lex)=='&'){advance(lex);type=TOK_AND;strcpy(buf,"&&");}
   139	                          else{error_at(lex->line,"unexpected character '&'");return -1;} break;
   140	                case '|': if (peek(lex)=='|'){advance(lex);type=TOK_OR;strcpy(buf,"||");}
   141	                          else{error_at(lex->line,"unexpected character '|'");return -1;} break;
   142	                default: error_at(lex->line, "unexpected character '%c'", c); return -1;
   143	            }
   144	            Token t = make_token(lex, type, buf);
   145	            if (add_token(lex, t) < 0) return -1;
   146	        }
   147	    }
   148	    Token eof = make_token(lex, TOK_EOF, "");
   149	    return add_token(lex, eof);
   150	}
   151	
   152	const char *token_type_name(TokenType t) {
   153	    switch (t) {
   154	        case TOK_NUM: return "NUM"; case TOK_STRING: return "STRING"; case TOK_IDENT: return "IDENT";
   155	        case TOK_PLUS: return "+"; case TOK_MINUS: return "-"; case TOK_STAR: return "*";
   156	        case TOK_SLASH: return "/"; case TOK_PERCENT: return "%";
   157	        case TOK_EQ: return "=="; case TOK_NEQ: return "!=";
   158	        case TOK_LT: return "<"; case TOK_GT: return ">"; case TOK_LEQ: return "<="; case TOK_GEQ: return ">=";
   159	        case TOK_ASSIGN: return "="; case TOK_AND: return "&&"; case TOK_OR: return "||"; case TOK_NOT: return "!";
   160	        case TOK_LPAREN: return "("; case TOK_RPAREN: return ")";
   161	        case TOK_LBRACE: return "{"; case TOK_RBRACE: return "}";
   162	        case TOK_LBRACKET: return "["; case TOK_RBRACKET: return "]";
   163	        case TOK_SEMICOLON: return ";"; case TOK_COMMA: return ",";
   164	        case TOK_IF: return "if"; case TOK_ELSE: return "else"; case TOK_WHILE: return "while";
   165	        case TOK_RETURN: return "return"; case TOK_FN: return "fn"; case TOK_LET: return "let";
   166	        case TOK_PRINT: return "print"; case TOK_TRUE: return "true"; case TOK_FALSE: return "false";
   167	        case TOK_EOF: return "EOF"; case TOK_ERROR: return "ERROR";
   168	        default: return "UNKNOWN";
   169	    }
   170	}
