    73	                    expect(p, TOK_COLON, "':'");
    74	                    ASTNode *val = parse_expr(p);
    75	                    nodelist_push(&n->data.map_lit.keys, key);
    76	                    nodelist_push(&n->data.map_lit.values, val);
    77	                }
    78	            } while (match(p, TOK_COMMA));
    79	        }
    80	        expect(p, TOK_RBRACE, "'}'");
    81	        return parse_postfix(p, n);
    82	    }
    83	    if (match(p, TOK_FN)) {
