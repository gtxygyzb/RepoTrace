[?2004l    41	static int value_truthy(Value v) {
    42	    switch (v.type) {
    43	        case VAL_INT: return v.data.ival != 0;
    44	        case VAL_BOOL: return v.data.bval;
    45	        case VAL_STR: return v.data.sval && v.data.sval[0] != '\0';
    46	        case VAL_ARRAY: return v.data.array.len > 0;
    47	        case VAL_NULL: return 0;
    48	    }
    49	    return 0;
    50	}
    51	
    52	static int values_equal(Value a, Value b) {
    53	    if (a.type != b.type) return 0;
    54	    switch (a.type) {
    55	        case VAL_INT: return a.data.ival == b.data.ival;
    56	        case VAL_BOOL: return a.data.bval == b.data.bval;
    57	        case VAL_STR: return strcmp(a.data.sval, b.data.sval) == 0;
    58	        case VAL_NULL: return 1;
    59	        default: return 0;
    60	    }
    61	}
    62	
    63	static const char *value_to_cstr(Value v, char *buf, size_t size) {
    64	    switch (v.type) {
    65	        case VAL_STR: return v.data.sval;
    66	        case VAL_INT: snprintf(buf, size, "%lld", (long long)v.data.ival); return buf;
    67	        case VAL_BOOL: return v.data.bval ? "true" : "false";
    68	        case VAL_NULL: return "null";
    69	        default: return "";
    70	    }
    71	}
    72	
    73	static int value_cmp(Value a, Value b) {
    74	    if (a.type == VAL_STR && b.type == VAL_STR)
    75	        return strcmp(a.data.sval, b.data.sval);
    76	    int64_t ia = value_to_int(a), ib = value_to_int(b);
    77	    return ia < ib ? -1 : (ia > ib ? 1 : 0);
    78	}
    79	
    80	static void print_value(Value v) {
    81	    switch (v.type) {
    82	        case VAL_INT: printf("%lld", (long long)v.data.ival); break;
    83	        case VAL_BOOL: printf("%s", v.data.bval ? "true" : "false"); break;
    84	        case VAL_STR: printf("%s", v.data.sval); break;
    85	        case VAL_ARRAY:
