     2	
     3	static int emit(Compiler *c, Opcode op, int64_t operand, char *str_op) {
     4	    if (c->code_count >= MAX_BYTECODE) { fprintf(stderr, "bytecode overflow\n"); return -1; }
     5	    Instruction *ins = &c->code[c->code_count];
     6	    ins->op = op; ins->operand = operand; ins->str_operand = str_op;
     7	    return c->code_count++;
     8	}
     9	
    10	static int resolve_local(Compiler *c, const char *name) {
    11	    for (int i = c->local_count - 1; i >= 0; i--) {
    12	        if (strcmp(c->locals[i].name, name) == 0) return i;
    13	    }
    14	    return -1;
    15	}
    16	
    17	static int add_local(Compiler *c, const char *name) {
    18	    if (c->local_count >= MAX_LOCALS) { fprintf(stderr, "too many local variables\n"); return -1; }
    19	    Local *local = &c->locals[c->local_count];
    20	    strncpy(local->name, name, MAX_IDENT_LEN - 1); local->name[MAX_IDENT_LEN - 1] = '\0';
    21	    local->scope_depth = c->scope_depth;
    22	    return c->local_count++;
    23	}
    24	
    25	static int find_function(Compiler *c, const char *name) {
    26	    for (int i = 0; i < c->func_count; i++) {
    27	        if (strcmp(c->functions[i].name, name) == 0) return i;
    28	    }
    29	    return -1;
    30	}
    31	
    32	static void compile_store(Compiler *c, const char *name) {
    33	    int slot = resolve_local(c, name);
    34	    if (slot >= 0) emit(c, BC_STORE_LOCAL, slot, NULL);
    35	    else emit(c, BC_STORE_GLOBAL, 0, strdup(name));
    36	}
    37	
    38	static void compile_load(Compiler *c, const char *name) {
    39	    int slot = resolve_local(c, name);
    40	    if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);
    41	    else emit(c, BC_LOAD_GLOBAL, 0, strdup(name));
    42	}
