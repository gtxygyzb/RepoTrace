   263	static ASTNode *parse_stmt(Parser *p) {
   264	    if (match(p, TOK_LET)) {
   265	        int line = prev(p)->line;
   266	        expect(p, TOK_IDENT, "identifier");
   267	        char name[MAX_IDENT_LEN];
   268	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   269	        expect(p, TOK_ASSIGN, "'='");
   270	        ASTNode *init = parse_expr(p);
   271	        expect(p, TOK_SEMICOLON, "';'");
   272	        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;
   273	        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);
   274	        n->data.let.init = init; return n;
   275	    }
   276	    if (match(p, TOK_IF)) {
