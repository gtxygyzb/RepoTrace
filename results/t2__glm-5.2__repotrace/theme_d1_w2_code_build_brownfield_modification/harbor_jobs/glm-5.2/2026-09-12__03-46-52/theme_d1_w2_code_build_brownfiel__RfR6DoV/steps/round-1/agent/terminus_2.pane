    99	static const char *value_to_cstr(Value v, char *buf, size_t size) {
   100	    switch (v.type) {
   101	        case VAL_STR: return v.data.sval;
   102	        case VAL_INT: snprintf(buf, size, "%lld", (long long)v.data.ival); return buf;
   103	        case VAL_BOOL: return v.data.bval ? "true" : "false";
   104	        case VAL_NULL: return "null";
   105	        default: return "";
   106	    }
