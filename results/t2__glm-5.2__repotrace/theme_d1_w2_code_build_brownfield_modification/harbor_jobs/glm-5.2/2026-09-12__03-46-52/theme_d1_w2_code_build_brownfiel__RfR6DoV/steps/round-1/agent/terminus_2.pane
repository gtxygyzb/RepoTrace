    10	static int resolve_local(Compiler *c, const char *name) {
    11	    for (int i = c->local_count - 1; i >= 0; i--) {
    12	        if (strcmp(c->locals[i].name, name) == 0) return i;
    13	    }
    14	    return -1;
    15	}
