    58	static int compile_node(Compiler *c, ASTNode *node);
    59	
    60	static int compile_expr(Compiler *c, ASTNode *node) {
    61	    switch (node->type) {
    62	        case NODE_NUM_LIT:
    63	            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;
    64	        case NODE_STR_LIT: {
    65	            char *s = strdup(node->data.str_val);
    66	            emit(c, BC_PUSH_STR, 0, s); break;
    67	        }
    68	        case NODE_BOOL_LIT:
    69	            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;
    70	        case NODE_IDENT: {
    71	            int slot = resolve_local(c, node->data.ident);
    72	            if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);
    73	            else emit(c, BC_LOAD_GLOBAL, 0, strdup(node->data.ident));
    74	            break;
    75	        }
    76	        case NODE_BINOP:
    77	            compile_expr(c, node->data.binop.left);
    78	            compile_expr(c, node->data.binop.right);
    79	            switch (node->data.binop.op) {
    80	                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;
    81	                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;
    82	                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
    83	                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
    84	                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
    85	                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;
    86	                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;
    87	                case OP_LT:  emit(c, BC_LT, 0, NULL); break;
    88	                case OP_GT:  emit(c, BC_GT, 0, NULL); break;
    89	                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;
    90	                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;
    91	                case OP_AND: emit(c, BC_AND, 0, NULL); break;
    92	                case OP_OR:  emit(c, BC_OR, 0, NULL); break;
    93	            }
    94	            break;
    95	        case NODE_UNARY:
    96	            compile_expr(c, node->data.unary.operand);
    97	            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);
    98	            else emit(c, BC_NOT, 0, NULL);
    99	            break;
   100	        case NODE_CALL: {
   101	            int fi = find_function(c, node->data.call.name);
   102	            if (fi < 0) { error_at(node->line, "undefined function '%s'", node->data.call.name); return -1; }
   103	            for (int i = 0; i < node->data.call.args.count; i++)
   104	                compile_expr(c, node->data.call.args.items[i]);
   105	            emit(c, BC_CALL, fi, NULL);
   106	            break;
   107	        }
   108	        case NODE_INDEX:
   109	            compile_expr(c, node->data.index_access.obj);
   110	            compile_expr(c, node->data.index_access.index);
   111	            emit(c, BC_INDEX, 0, NULL); break;
   112	        case NODE_ARRAY_LIT:
   113	            for (int i = 0; i < node->data.array_lit.elems.count; i++)
   114	                compile_expr(c, node->data.array_lit.elems.items[i]);
   115	            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;
   116	        default:
   117	            error_at(node->line, "cannot compile expression of type %d", node->type); return -1;
   118	    }
   119	    return 0;
   120	}
