   256	        expect(p, TOK_IDENT, "identifier");
   257	        char name[MAX_IDENT_LEN];
   258	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   259	        expect(p, TOK_ASSIGN, "'='");
   260	        ASTNode *init_expr = parse_expr(p);
