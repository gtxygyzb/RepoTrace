    14	static Value make_int(int64_t v) { Value val; val.type = VAL_INT; val.data.ival = v; return val; }
    15	static Value make_str(const char *s) { Value val; val.type = VAL_STR; val.data.sval = strdup(s); return val; }
    16	static Value make_bool(int b) { Value val; val.type = VAL_BOOL; val.data.bval = b; return val; }
