   113	
   114	static int value_cmp(Value a, Value b) {
   115	    if (a.type == VAL_STR && b.type == VAL_STR)
   116	        return strcmp(a.data.sval, b.data.sval);
   117	    int64_t ia = value_to_int(a), ib = value_to_int(b);
   118	    return ia < ib ? -1 : (ia > ib ? 1 : 0);
   119	}
