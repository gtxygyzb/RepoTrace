[?2004l#include "lexer.h"
#include <stdarg.h>

void error_at(int line, const char *fmt, ...) {
    va_list args;
    va_start(args, fmt);
    fprintf(stderr, "error at line %d: ", line);
    vfprintf(stderr, fmt, args);
    fprintf(stderr, "\n");
    va_end(args);
}

static char peek(Lexer *lex) { return lex->source[lex->pos]; }

static char advance(Lexer *lex) {
    char c = lex->source[lex->pos++];
    if (c == '\n') { lex->line++; lex->col = 1; } else { lex->col++; }
    return c;
}

static int is_at_end(Lexer *lex) { return lex->source[lex->pos] == '\0'; }

static void skip_whitespace(Lexer *lex) {
    while (!is_at_end(lex)) {
        char c = peek(lex);
        if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
            advance(lex);
        } else if (c == '/' && lex->source[lex->pos + 1] == '/') {
            while (!is_at_end(lex) && peek(lex) != '\n') advance(lex);
        } else {
            break;
        }
    }
}

static Token make_token(Lexer *lex, TokenType type, const char *text) {
    Token t;
    t.type = type;
    strncpy(t.text, text, MAX_STRING_LEN - 1);
    t.text[MAX_STRING_LEN - 1] = '\0';
    t.line = lex->line;
    t.col = lex->col;
    t.literal.ival = 0;
    return t;
}

static int add_token(Lexer *lex, Token t) {
    if (lex->token_count >= MAX_TOKENS) { error_at(lex->line, "too many tokens"); return -1; }
    lex->tokens[lex->token_count++] = t;
    return 0;
}

static int lex_number(Lexer *lex) {
    char buf[64]; int i = 0;
    while (!is_at_end(lex) && isdigit(peek(lex))) {
        if (i < 63) buf[i++] = advance(lex); else advance(lex);
    }
    buf[i] = '\0';
    Token t = make_token(lex, TOK_NUM, buf);
    t.literal.ival = strtoll(buf, NULL, 10);
    return add_token(lex, t);
}

static int lex_string(Lexer *lex) {
    advance(lex);
    char buf[MAX_STRING_LEN]; int i = 0;
    while (!is_at_end(lex) && peek(lex) != '"') {
        char c = advance(lex);
        if (c == '\\' && !is_at_end(lex)) {
            // NOTE: escape sequences are not interpreted here; the backslash
            // is copied literally and the following character is emitted as-is.
            if (i < MAX_STRING_LEN - 1) buf[i++] = c;
            c = advance(lex);
        }
        if (i < MAX_STRING_LEN - 1) buf[i++] = c;
    }
    if (is_at_end(lex)) { error_at(lex->line, "unterminated string"); return -1; }
    advance(lex);
    buf[i] = '\0';
    Token t = make_token(lex, TOK_STRING, buf);
    return add_token(lex, t);
}

static int lex_ident(Lexer *lex) {
    char buf[MAX_IDENT_LEN]; int i = 0;
    while (!is_at_end(lex) && (isalnum(peek(lex)) || peek(lex) == '_')) {
        if (i < MAX_IDENT_LEN - 1) buf[i++] = advance(lex); else advance(lex);
    }
    buf[i] = '\0';
    TokenType type = TOK_IDENT;
    if      (strcmp(buf, "if") == 0)       type = TOK_IF;
    else if (strcmp(buf, "else") == 0)     type = TOK_ELSE;
    else if (strcmp(buf, "while") == 0)    type = TOK_WHILE;
    else if (strcmp(buf, "return") == 0)   type = TOK_RETURN;
    else if (strcmp(buf, "fn") == 0)       type = TOK_FN;
    else if (strcmp(buf, "let") == 0)      type = TOK_LET;
    else if (strcmp(buf, "print") == 0)    type = TOK_PRINT;
    else if (strcmp(buf, "true") == 0)     type = TOK_TRUE;
    else if (strcmp(buf, "false") == 0)    type = TOK_FALSE;
    Token t = make_token(lex, type, buf);
    return add_token(lex, t);
}

void lexer_init(Lexer *lex, const char *source) {
    lex->source = source; lex->pos = 0; lex->line = 1; lex->col = 1; lex->token_count = 0;
}

int lexer_tokenize(Lexer *lex) {
    while (!is_at_end(lex)) {
        skip_whitespace(lex);
        if (is_at_end(lex)) break;
        char c = peek(lex);
        if (isdigit(c)) { if (lex_number(lex) < 0) return -1; }
        else if (c == '"') { if (lex_string(lex) < 0) return -1; }
        else if (isalpha(c) || c == '_') { if (lex_ident(lex) < 0) return -1; }
        else {
            advance(lex);
            char buf[4] = {c, '\0', '\0', '\0'};
            TokenType type = TOK_ERROR;
            switch (c) {
                case '+': type = TOK_PLUS; break;
                case '-': type = TOK_MINUS; break;
                case '*': type = TOK_STAR; break;
                case '/': type = TOK_SLASH; break;
                case '%': type = TOK_PERCENT; break;
                case '(': type = TOK_LPAREN; break;
                case ')': type = TOK_RPAREN; break;
                case '{': type = TOK_LBRACE; break;
                case '}': type = TOK_RBRACE; break;
                case '[': type = TOK_LBRACKET; break;
                case ']': type = TOK_RBRACKET; break;
                case ';': type = TOK_SEMICOLON; break;
                case ',': type = TOK_COMMA; break;
                case '!': if (peek(lex)=='='){advance(lex);type=TOK_NEQ;strcpy(buf,"!=");}else{type=TOK_NOT;} break;
                case '=': if (peek(lex)=='='){advance(lex);type=TOK_EQ;strcpy(buf,"==");}else{type=TOK_ASSIGN;} break;
                case '<': if (peek(lex)=='='){advance(lex);type=TOK_LEQ;strcpy(buf,"<=");}else{type=TOK_LT;} break;
                case '>': if (peek(lex)=='='){advance(lex);type=TOK_GEQ;strcpy(buf,">=");}else{type=TOK_GT;} break;
                case '&': if (peek(lex)=='&'){advance(lex);type=TOK_AND;strcpy(buf,"&&");}
                          else{error_at(lex->line,"unexpected character '&'");return -1;} break;
                case '|': if (peek(lex)=='|'){advance(lex);type=TOK_OR;strcpy(buf,"||");}
                          else{error_at(lex->line,"unexpected character '|'");return -1;} break;
                default: error_at(lex->line, "unexpected character '%c'", c); return -1;
            }
            Token t = make_token(lex, type, buf);
            if (add_token(lex, t) < 0) return -1;
        }
    }
    Token eof = make_token(lex, TOK_EOF, "");
    return add_token(lex, eof);
}

const char *token_type_name(TokenType t) {
    switch (t) {
        case TOK_NUM: return "NUM"; case TOK_STRING: return "STRING"; case TOK_IDENT: return "IDENT";
        case TOK_PLUS: return "+"; case TOK_MINUS: return "-"; case TOK_STAR: return "*";
        case TOK_SLASH: return "/"; case TOK_PERCENT: return "%";
        case TOK_EQ: return "=="; case TOK_NEQ: return "!=";
        case TOK_LT: return "<"; case TOK_GT: return ">"; case TOK_LEQ: return "<="; case TOK_GEQ: return ">=";
        case TOK_ASSIGN: return "="; case TOK_AND: return "&&"; case TOK_OR: return "||"; case TOK_NOT: return "!";
        case TOK_LPAREN: return "("; case TOK_RPAREN: return ")";
        case TOK_LBRACE: return "{"; case TOK_RBRACE: return "}";
        case TOK_LBRACKET: return "["; case TOK_RBRACKET: return "]";
        case TOK_SEMICOLON: return ";"; case TOK_COMMA: return ",";
        case TOK_IF: return "if"; case TOK_ELSE: return "else"; case TOK_WHILE: return "while";
        case TOK_RETURN: return "return"; case TOK_FN: return "fn"; case TOK_LET: return "let";
        case TOK_PRINT: return "print"; case TOK_TRUE: return "true"; case TOK_FALSE: return "false";
        case TOK_EOF: return "EOF"; case TOK_ERROR: return "ERROR";
        default: return "UNKNOWN";
    }
}
[?2004hroot@n30009:/app# sed -n '1,260p' src/parser.c
[?2004l#include "parser.h"

static Token *current(Parser *p) { return &p->tokens[p->pos]; }
static Token *prev(Parser *p) { return &p->tokens[p->pos - 1]; }
static int check(Parser *p, TokenType t) { return current(p)->type == t; }

static int match(Parser *p, TokenType t) {
    if (check(p, t)) { p->pos++; return 1; }
    return 0;
}

static void expect(Parser *p, TokenType t, const char *msg) {
    if (!match(p, t)) {
        error_at(current(p)->line, "expected %s, got '%s'", msg, current(p)->text);
        p->had_error = 1;
    }
}

static ASTNode *parse_expr(Parser *p);
static ASTNode *parse_stmt(Parser *p);
static ASTNode *parse_block(Parser *p);

static ASTNode *parse_primary(Parser *p) {
    if (match(p, TOK_NUM)) {
        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;
        n->data.num_val = prev(p)->literal.ival; return n;
    }
    if (match(p, TOK_STRING)) {
        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;
        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return n;
    }
    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {
        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;
        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;
    }
    if (match(p, TOK_IDENT)) {
        char name[MAX_IDENT_LEN];
        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\0';
        int line = prev(p)->line;
        if (match(p, TOK_LPAREN)) {
            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;
            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);
            nodelist_init(&n->data.call.args);
            if (!check(p, TOK_RPAREN)) {
                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));
            }
            expect(p, TOK_RPAREN, "')'"); return n;
        }
        if (match(p, TOK_LBRACKET)) {
            ASTNode *idx = parse_expr(p); expect(p, TOK_RBRACKET, "']'");
            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;
            ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;
            strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);
            n->data.index_access.obj = obj; n->data.index_access.index = idx; return n;
        }
        ASTNode *n = ast_alloc(); n->type = NODE_IDENT; n->line = line;
        strncpy(n->data.ident, name, MAX_IDENT_LEN - 1); return n;
    }
    if (match(p, TOK_LBRACKET)) {
        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;
        nodelist_init(&n->data.array_lit.elems);
        if (!check(p, TOK_RBRACKET)) {
            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));
        }
        expect(p, TOK_RBRACKET, "']'"); return n;
    }
    if (match(p, TOK_LPAREN)) {
        ASTNode *expr = parse_expr(p); expect(p, TOK_RPAREN, "')'"); return expr;
    }
    error_at(current(p)->line, "unexpected token '%s'", current(p)->text);
    p->had_error = 1; p->pos++; return ast_alloc();
}

static ASTNode *parse_unary(Parser *p) {
    if (match(p, TOK_MINUS)) {
        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;
    }
    if (match(p, TOK_NOT)) {
        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;
    }
    return parse_primary(p);
}

static ASTNode *parse_factor(Parser *p) {
    ASTNode *left = parse_unary(p);
    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {
        int line = prev(p)->line; BinOp op;
        if (prev(p)->type == TOK_STAR) op = OP_MUL;
        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;
        else op = OP_MOD;
        ASTNode *right = parse_unary(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

/* NOTE: comparison operators are parsed at a tighter binding than +/-,
   which is buggy: `a + b == c` is parsed as `a + (b == c)` instead of
   `(a + b) == c`. */
static ASTNode *parse_comparison(Parser *p) {
    ASTNode *left = parse_factor(p);
    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||
           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {
        int line = prev(p)->line; BinOp op;
        switch (prev(p)->type) {
            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;
            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;
            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;
            default: op = OP_EQ; break;
        }
        ASTNode *right = parse_factor(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *parse_term(Parser *p) {
    ASTNode *left = parse_comparison(p);
    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {
        int line = prev(p)->line;
        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;
        ASTNode *right = parse_comparison(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *parse_logic_and(Parser *p) {
    ASTNode *left = parse_term(p);
    while (match(p, TOK_AND)) {
        int line = prev(p)->line; ASTNode *right = parse_term(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *parse_expr(Parser *p) {
    ASTNode *left = parse_logic_and(p);
    while (match(p, TOK_OR)) {
        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *try_parse_assign(Parser *p) {
    if (!check(p, TOK_IDENT)) return NULL;
    int saved = p->pos;
    p->pos++;
    if (check(p, TOK_ASSIGN)) {
        p->pos = saved; match(p, TOK_IDENT);
        char name[MAX_IDENT_LEN];
        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
        int line = prev(p)->line;
        expect(p, TOK_ASSIGN, "'='");
        ASTNode *val = parse_expr(p);
        ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;
        strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);
        n->data.assign.value = val; return n;
    }
    p->pos = saved; return NULL;
}

static ASTNode *parse_block(Parser *p) {
    expect(p, TOK_LBRACE, "'{'");
    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;
    nodelist_init(&block->data.block.stmts);
    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {
        ASTNode *stmt = parse_stmt(p);
        if (stmt) nodelist_push(&block->data.block.stmts, stmt);
        if (p->had_error) break;
    }
    expect(p, TOK_RBRACE, "'}'");
    return block;
}

static ASTNode *parse_stmt(Parser *p) {
    if (match(p, TOK_LET)) {
        int line = prev(p)->line;
        expect(p, TOK_IDENT, "identifier");
        char name[MAX_IDENT_LEN];
        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
        expect(p, TOK_ASSIGN, "'='");
        ASTNode *init = parse_expr(p);
        expect(p, TOK_SEMICOLON, "';'");
        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;
        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);
        n->data.let.init = init; return n;
    }
    if (match(p, TOK_IF)) {
        int line = prev(p)->line;
        expect(p, TOK_LPAREN, "'('");
        ASTNode *cond = parse_expr(p);
        expect(p, TOK_RPAREN, "')'");
        ASTNode *then_b = parse_block(p);
        ASTNode *else_b = NULL;
        if (match(p, TOK_ELSE)) {
            if (check(p, TOK_IF)) {
                ASTNode *elif = parse_stmt(p);
                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;
                nodelist_init(&else_b->data.block.stmts);
                nodelist_push(&else_b->data.block.stmts, elif);
            } else {
                else_b = parse_block(p);
            }
        }
        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;
        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;
        return n;
    }
    if (match(p, TOK_WHILE)) {
        int line = prev(p)->line;
        expect(p, TOK_LPAREN, "'('");
        ASTNode *cond = parse_expr(p);
        expect(p, TOK_RPAREN, "')'");
        ASTNode *body = parse_block(p);
        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;
        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;
    }
    if (match(p, TOK_RETURN)) {
        int line = prev(p)->line;
        ASTNode *value = NULL;
        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);
        expect(p, TOK_SEMICOLON, "';'");
