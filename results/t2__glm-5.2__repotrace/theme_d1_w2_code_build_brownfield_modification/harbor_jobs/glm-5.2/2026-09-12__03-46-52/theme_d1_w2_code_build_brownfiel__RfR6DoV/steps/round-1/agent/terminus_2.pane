    68	static int64_t value_to_int(Value v) {
    69	    if (v.type == VAL_REF) return value_to_int(*v.data.ref);
    70	    switch (v.type) { case VAL_INT: return v.data.ival; case VAL_BOOL: return v.data.bval ? 1 : 0; default: return 0; }
    71	}
    72	
    73	static int value_is_integer_like(Value v) {
    74	    if (v.type == VAL_REF) return value_is_integer_like(*v.data.ref);
    75	    return v.type == VAL_INT || v.type == VAL_BOOL;
    76	}
    77	
    78	static int value_truthy(Value v) {
    79	    if (v.type == VAL_REF) return value_truthy(*v.data.ref);
    80	    switch (v.type) {
    81	        case VAL_INT: return v.data.ival != 0;
    82	        case VAL_BOOL: return v.data.bval;
    83	        case VAL_STR: return v.data.sval && v.data.sval[0] != '\0';
    84	        case VAL_ARRAY: return v.data.array.len > 0;
    85	        case VAL_MAP: return v.data.map && v.data.map->len > 0;
    86	        case VAL_NULL: return 0;
    87	    }
    88	    return 0;
    89	}
