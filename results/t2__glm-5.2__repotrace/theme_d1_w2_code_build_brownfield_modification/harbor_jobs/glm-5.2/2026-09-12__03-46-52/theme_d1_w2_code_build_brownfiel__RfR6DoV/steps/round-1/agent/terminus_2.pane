   105	static void collect_free_names(ASTNode *node, char bound[][MAX_IDENT_LEN], int bound_count,
   106	                              char free_names[][MAX_IDENT_LEN], int *free_count) {
   107	    if (!node) return;
   108	    switch (node->type) {
   109	        case NODE_IDENT:
   110	            if (!name_in_list(bound, bound_count, node->data.ident)) add_name(free_names, free_count, node->data.ident);
   111	            break;
   112	        case NODE_ASSIGN:
   113	            collect_free_names(node->data.assign.value, bound, bound_count, free_names, free_count);
   114	            if (!name_in_list(bound, bound_count, node->data.assign.name)) add_name(free_names, free_count, node->data.assign.name);
   115	            break;
   116	        case NODE_COMPOUND_ASSIGN:
   117	            collect_free_names(node->data.compound_assign.value, bound, bound_count, free_names, free_count);
   118	            if (!name_in_list(bound, bound_count, node->data.compound_assign.name)) add_name(free_names, free_count, node->data.compound_assign.name);
   119	            break;
   120	        case NODE_CALL:
   121	            if (!name_in_list(bound, bound_count, node->data.call.name)) add_name(free_names, free_count, node->data.call.name);
   122	            for (int i = 0; i < node->data.call.args.count; i++)
   123	                collect_free_names(node->data.call.args.items[i], bound, bound_count, free_names, free_count);
   124	            break;
   125	        case NODE_BINOP:
   126	            collect_free_names(node->data.binop.left, bound, bound_count, free_names, free_count);
   127	            collect_free_names(node->data.binop.right, bound, bound_count, free_names, free_count);
   128	            break;
   129	        case NODE_UNARY:
   130	            collect_free_names(node->data.unary.operand, bound, bound_count, free_names, free_count);
   131	            break;
   132	        case NODE_INDEX:
   133	            collect_free_names(node->data.index_access.obj, bound, bound_count, free_names, free_count);
   134	            collect_free_names(node->data.index_access.index, bound, bound_count, free_names, free_count);
   135	            break;
   136	        case NODE_INDEX_ASSIGN:
   137	            if (node->data.index_assign.obj) collect_free_names(node->data.index_assign.obj, bound, bound_count, free_names, free_count);
   138	            else if (node->data.index_assign.name[0]) { if (!name_in_list(bound, bound_count, node->data.index_assign.name)) add_name(free_names, free_count, node->data.index_assign.name); }
   139	            collect_free_names(node->data.index_assign.index, bound, bound_count, free_names, free_count);
   140	            collect_free_names(node->data.index_assign.value, bound, bound_count, free_names, free_count);
   141	            break;
   142	        case NODE_FIELD_ACCESS:
   143	            collect_free_names(node->data.field_access.obj, bound, bound_count, free_names, free_count);
   144	            break;
   145	        case NODE_FIELD_ASSIGN:
   146	            collect_free_names(node->data.field_assign.obj, bound, bound_count, free_names, free_count);
   147	            collect_free_names(node->data.field_assign.value, bound, bound_count, free_names, free_count);
   148	            break;
   149	        case NODE_LET:
   150	            collect_free_names(node->data.let.init, bound, bound_count, free_names, free_count);
   151	            break;
   152	        case NODE_BLOCK:
   153	            for (int i = 0; i < node->data.block.stmts.count; i++)
   154	                collect_free_names(node->data.block.stmts.items[i], bound, bound_count, free_names, free_count);
   155	            break;
   156	        case NODE_IF:
   157	            collect_free_names(node->data.if_stmt.cond, bound, bound_count, free_names, free_count);
   158	            collect_free_names(node->data.if_stmt.then_b, bound, bound_count, free_names, free_count);
   159	            collect_free_names(node->data.if_stmt.else_b, bound, bound_count, free_names, free_count);
   160	            break;
   161	        case NODE_WHILE:
   162	            collect_free_names(node->data.while_stmt.cond, bound, bound_count, free_names, free_count);
   163	            collect_free_names(node->data.while_stmt.body, bound, bound_count, free_names, free_count);
   164	            break;
   165	        case NODE_FOR:
   166	            if (node->data.for_stmt.init) collect_free_names(node->data.for_stmt.init, bound, bound_count, free_names, free_count);
   167	            if (node->data.for_stmt.cond) collect_free_names(node->data.for_stmt.cond, bound, bound_count, free_names, free_count);
   168	            if (node->data.for_stmt.step) collect_free_names(node->data.for_stmt.step, bound, bound_count, free_names, free_count);
   169	            collect_free_names(node->data.for_stmt.body, bound, bound_count, free_names, free_count);
   170	            break;
   171	        case NODE_FOREACH:
   172	            collect_free_names(node->data.foreach_stmt.arr, bound, bound_count, free_names, free_count);
   173	            collect_free_names(node->data.foreach_stmt.body, bound, bound_count, free_names, free_count);
   174	            break;
   175	        case NODE_RETURN:
   176	            if (node->data.ret.value) collect_free_names(node->data.ret.value, bound, bound_count, free_names, free_count);
   177	            break;
   178	        case NODE_PRINT:
   179	            collect_free_names(node->data.print.value, bound, bound_count, free_names, free_count);
   180	            break;
   181	        case NODE_EXPR_STMT:
   182	            collect_free_names(node->data.expr_stmt.expr, bound, bound_count, free_names, free_count);
   183	            break;
   184	        case NODE_ARRAY_LIT:
   185	            for (int i = 0; i < node->data.array_lit.elems.count; i++)
   186	                collect_free_names(node->data.array_lit.elems.items[i], bound, bound_count, free_names, free_count);
   187	            break;
   188	        case NODE_MAP_LIT:
   189	            for (int i = 0; i < node->data.map_lit.keys.count; i++) {
   190	                collect_free_names(node->data.map_lit.keys.items[i], bound, bound_count, free_names, free_count);
   191	                collect_free_names(node->data.map_lit.values.items[i], bound, bound_count, free_names, free_count);
   192	            }
   193	            break;
   194	        case NODE_CLOSURE: break;
   195	        default: break;
   196	    }
   197	}
