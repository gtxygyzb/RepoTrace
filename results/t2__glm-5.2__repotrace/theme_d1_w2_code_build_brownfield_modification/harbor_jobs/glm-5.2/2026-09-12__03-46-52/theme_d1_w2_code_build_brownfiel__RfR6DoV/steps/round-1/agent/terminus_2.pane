   191	static ASTNode *parse_for(Parser *p) {
   192	    int line = prev(p)->line;
   193	    expect(p, TOK_LPAREN, "'('");
   194	
   195	    if (check(p, TOK_IDENT) && p->pos + 1 < p->count && p->tokens[p->pos + 1].type == TOK_IN) {
   196	        char name[MAX_IDENT_LEN];
   197	        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   198	        match(p, TOK_IDENT);
   199	        match(p, TOK_IN);
   200	        ASTNode *arr = parse_expr(p);
   201	        expect(p, TOK_RPAREN, "')'");
   202	        ASTNode *body = parse_block(p);
   203	        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;
   204	        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);
   205	        n->data.foreach_stmt.arr = arr;
   206	        n->data.foreach_stmt.body = body;
   207	        return n;
   208	    }
   209	
   210	    ASTNode *init = NULL;
   211	    if (match(p, TOK_LET)) {
   212	        expect(p, TOK_IDENT, "identifier");
   213	        char name[MAX_IDENT_LEN];
   214	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   215	        expect(p, TOK_ASSIGN, "'='");
   216	        ASTNode *init_expr = parse_expr(p);
   217	        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;
   218	        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);
   219	        init->data.let.init = init_expr;
   220	    } else if (check(p, TOK_IDENT)) {
   221	        init = try_parse_assign(p);
   222	        if (!init) init = parse_expr(p);
   223	    } else if (!check(p, TOK_SEMICOLON)) {
   224	        init = parse_expr(p);
   225	    }
   226	    expect(p, TOK_SEMICOLON, "';'");
   227	
   228	    ASTNode *cond = NULL;
   229	    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);
   230	    expect(p, TOK_SEMICOLON, "';'");
   231	
   232	    ASTNode *step = NULL;
   233	    if (!check(p, TOK_RPAREN)) {
   234	        if (check(p, TOK_IDENT)) {
   235	            step = try_parse_assign(p);
   236	        }
   237	        if (!step) step = parse_expr(p);
   238	    }
   239	    expect(p, TOK_RPAREN, "')'");
   240	
   241	    ASTNode *body = parse_block(p);
   242	    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;
   243	    n->data.for_stmt.init = init;
   244	    n->data.for_stmt.cond = cond;
   245	    n->data.for_stmt.step = step;
   246	    n->data.for_stmt.body = body;
   247	    return n;
   248	}
