     4	void error_at(int line, const char *fmt, ...) {
     5	    va_list args;
     6	    va_start(args, fmt);
     7	    fprintf(stderr, "error at line %d: ", line);
     8	    vfprintf(stderr, fmt, args);
     9	    fprintf(stderr, "\n");
    10	    va_end(args);
    11	}
    12	
    13	static char peek(Lexer *lex) { return lex->source[lex->pos]; }
    14	
    15	static char advance(Lexer *lex) {
    16	    char c = lex->source[lex->pos++];
    17	    if (c == '\n') { lex->line++; lex->col = 1; } else { lex->col++; }
    18	    return c;
    19	}
    20	
    21	static int is_at_end(Lexer *lex) { return lex->source[lex->pos] == '\0'; }
    22	
    23	static void skip_whitespace(Lexer *lex) {
    24	    while (!is_at_end(lex)) {
    25	        char c = peek(lex);
    26	        if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
    27	            advance(lex);
    28	        } else if (c == '/' && lex->source[lex->pos + 1] == '/') {
    29	            while (!is_at_end(lex) && peek(lex) != '\n') advance(lex);
    30	        } else {
    31	            break;
    32	        }
    33	    }
    34	}
    35	
    36	static Token make_token(Lexer *lex, TokenType type, const char *text) {
    37	    Token t;
    38	    t.type = type;
    39	    strncpy(t.text, text, MAX_STRING_LEN - 1);
    40	    t.text[MAX_STRING_LEN - 1] = '\0';
    41	    t.line = lex->line;
    42	    t.col = lex->col;
    43	    t.literal.ival = 0;
    44	    return t;
    45	}
    46	
    47	static int add_token(Lexer *lex, Token t) {
    48	    if (lex->token_count >= MAX_TOKENS) { error_at(lex->line, "too many tokens"); return -1; }
    49	    lex->tokens[lex->token_count++] = t;
    50	    return 0;
    51	}
    52	
    53	static int lex_number(Lexer *lex) {
    54	    char buf[64]; int i = 0;
    55	    while (!is_at_end(lex) && isdigit(peek(lex))) {
    56	        if (i < 63) buf[i++] = advance(lex); else advance(lex);
    57	    }
    58	    buf[i] = '\0';
    59	    Token t = make_token(lex, TOK_NUM, buf);
    60	    t.literal.ival = strtoll(buf, NULL, 10);
    61	    return add_token(lex, t);
    62	}
    63	
    64	static int lex_string(Lexer *lex) {
    65	    advance(lex);
    66	    char buf[MAX_STRING_LEN]; int i = 0;
    67	    while (!is_at_end(lex) && peek(lex) != '"') {
    68	        char c = advance(lex);
    69	        if (c == '\\') {
    70	            if (is_at_end(lex)) { error_at(lex->line, "unterminated string"); return -1; }
    71	            char esc = advance(lex);
    72	            switch (esc) {
    73	                case 'n': c = '\n'; break;
    74	                case 't': c = '\t'; break;
    75	                case '\\': c = '\\'; break;
    76	                case '"': c = '"'; break;
    77	                case 'r': c = '\r'; break;
    78	                case '0': c = '\0'; break;
    79	                default: error_at(lex->line, "unknown string escape \\%c", esc); return -1;
    80	            }
    81	        }
    82	        if (i < MAX_STRING_LEN - 1) buf[i++] = c;
    83	    }
    84	    if (is_at_end(lex)) { error_at(lex->line, "unterminated string"); return -1; }
    85	    advance(lex);
    86	    buf[i] = '\0';
    87	    Token t = make_token(lex, TOK_STRING, buf);
    88	    return add_token(lex, t);
    89	}
    90	
    91	static int lex_ident(Lexer *lex) {
    92	    char buf[MAX_IDENT_LEN]; int i = 0;
    93	    while (!is_at_end(lex) && (isalnum(peek(lex)) || peek(lex) == '_')) {
    94	        if (i < MAX_IDENT_LEN - 1) buf[i++] = advance(lex); else advance(lex);
    95	    }
    96	    buf[i] = '\0';
    97	    TokenType type = TOK_IDENT;
    98	    if      (strcmp(buf, "if") == 0)       type = TOK_IF;
    99	    else if (strcmp(buf, "else") == 0)     type = TOK_ELSE;
   100	    else if (strcmp(buf, "while") == 0)    type = TOK_WHILE;
   101	    else if (strcmp(buf, "for") == 0)     type = TOK_FOR;
   102	    else if (strcmp(buf, "break") == 0)   type = TOK_BREAK;
   103	    else if (strcmp(buf, "continue") == 0) type = TOK_CONTINUE;
   104	    else if (strcmp(buf, "in") == 0)      type = TOK_IN;
   105	    else if (strcmp(buf, "of") == 0)      type = TOK_OF;
   106	    else if (strcmp(buf, "return") == 0)   type = TOK_RETURN;
   107	    else if (strcmp(buf, "fn") == 0)       type = TOK_FN;
   108	    else if (strcmp(buf, "let") == 0)      type = TOK_LET;
   109	    else if (strcmp(buf, "print") == 0)    type = TOK_PRINT;
   110	    else if (strcmp(buf, "true") == 0)     type = TOK_TRUE;
   111	    else if (strcmp(buf, "false") == 0)    type = TOK_FALSE;
   112	    else if (strcmp(buf, "throw") == 0)   type = TOK_THROW;
   113	    else if (strcmp(buf, "try") == 0)     type = TOK_TRY;
   114	    else if (strcmp(buf, "catch") == 0)   type = TOK_CATCH;
   115	    Token t = make_token(lex, type, buf);
   116	    return add_token(lex, t);
   117	}
   118	
   119	void lexer_init(Lexer *lex, const char *source) {
   120	    lex->source = source; lex->pos = 0; lex->line = 1; lex->col = 1; lex->token_count = 0;
   121	}
   122	
   123	int lexer_tokenize(Lexer *lex) {
   124	    while (!is_at_end(lex)) {
   125	        skip_whitespace(lex);
   126	        if (is_at_end(lex)) break;
   127	        char c = peek(lex);
   128	        if (isdigit(c)) { if (lex_number(lex) < 0) return -1; }
   129	        else if (c == '"') { if (lex_string(lex) < 0) return -1; }
   130	        else if (isalpha(c) || c == '_') { if (lex_ident(lex) < 0) return -1; }
   131	        else {
   132	            advance(lex);
   133	            char buf[4] = {c, '\0', '\0', '\0'};
   134	            TokenType type = TOK_ERROR;
   135	            switch (c) {
   136	                case '+': if (peek(lex)=='='){advance(lex);type=TOK_PLUS_ASSIGN;strcpy(buf,"+=");}else{type=TOK_PLUS;} break;
   137	                case '-': if (peek(lex)=='='){advance(lex);type=TOK_MINUS_ASSIGN;strcpy(buf,"-=");}else{type=TOK_MINUS;} break;
   138	                case '*': if (peek(lex)=='='){advance(lex);type=TOK_STAR_ASSIGN;strcpy(buf,"*=");}else{type=TOK_STAR;} break;
   139	                case '/': if (peek(lex)=='='){advance(lex);type=TOK_SLASH_ASSIGN;strcpy(buf,"/=");}else{type=TOK_SLASH;} break;
   140	                case '%': if (peek(lex)=='='){advance(lex);type=TOK_PERCENT_ASSIGN;strcpy(buf,"%=");}else{type=TOK_PERCENT;} break;
   141	                case '(': type = TOK_LPAREN; break;
   142	                case ')': type = TOK_RPAREN; break;
   143	                case '{': type = TOK_LBRACE; break;
   144	                case '}': type = TOK_RBRACE; break;
   145	                case '[': type = TOK_LBRACKET; break;
   146	                case ']': type = TOK_RBRACKET; break;
   147	                case ';': type = TOK_SEMICOLON; break;
   148	                case ',': type = TOK_COMMA; break;
   149	            case '.': type = TOK_DOT; break;
   150	            case ':': type = TOK_COLON; break;
   151	                case '!': if (peek(lex)=='='){advance(lex);type=TOK_NEQ;strcpy(buf,"!=");}else{type=TOK_NOT;} break;
   152	                case '=': if (peek(lex)=='='){advance(lex);type=TOK_EQ;strcpy(buf,"==");}else{type=TOK_ASSIGN;} break;
   153	                case '<': if (peek(lex)=='='){advance(lex);type=TOK_LEQ;strcpy(buf,"<=");}else{type=TOK_LT;} break;
   154	                case '>': if (peek(lex)=='='){advance(lex);type=TOK_GEQ;strcpy(buf,">=");}else{type=TOK_GT;} break;
   155	                case '&': if (peek(lex)=='&'){advance(lex);type=TOK_AND;strcpy(buf,"&&");}
   156	                          else{error_at(lex->line,"unexpected character '&'");return -1;} break;
   157	                case '|': if (peek(lex)=='|'){advance(lex);type=TOK_OR;strcpy(buf,"||");}
   158	                          else{error_at(lex->line,"unexpected character '|'");return -1;} break;
   159	                default: error_at(lex->line, "unexpected character '%c'", c); return -1;
   160	            }
   161	            Token t = make_token(lex, type, buf);
   162	            if (add_token(lex, t) < 0) return -1;
   163	        }
   164	    }
   165	    Token eof = make_token(lex, TOK_EOF, "");
   166	    return add_token(lex, eof);
   167	}
   168	
   169	const char *token_type_name(TokenType t) {
   170	    switch (t) {
   171	        case TOK_NUM: return "NUM"; case TOK_STRING: return "STRING"; case TOK_IDENT: return "IDENT";
   172	        case TOK_PLUS: return "+"; case TOK_MINUS: return "-"; case TOK_STAR: return "*";
   173	        case TOK_SLASH: return "/"; case TOK_PERCENT: return "%";
   174	        case TOK_EQ: return "=="; case TOK_NEQ: return "!=";
   175	        case TOK_LT: return "<"; case TOK_GT: return ">"; case TOK_LEQ: return "<="; case TOK_GEQ: return ">=";
   176	        case TOK_ASSIGN: return "="; case TOK_AND: return "&&"; case TOK_OR: return "||"; case TOK_NOT: return "!";
   177	        case TOK_LPAREN: return "("; case TOK_RPAREN: return ")";
   178	        case TOK_LBRACE: return "{"; case TOK_RBRACE: return "}";
   179	        case TOK_LBRACKET: return "["; case TOK_RBRACKET: return "]";
   180	        case TOK_SEMICOLON: return ";"; case TOK_COMMA: return ",";
   181	        case TOK_IF: return "if"; case TOK_ELSE: return "else"; case TOK_WHILE: return "while";
   182	        case TOK_FOR: return "for"; case TOK_BREAK: return "break"; case TOK_CONTINUE: return "continue"; case TOK_IN: return "in"; case TOK_OF: return "of";
   183	        case TOK_RETURN: return "return"; case TOK_FN: return "fn"; case TOK_LET: return "let";
   184	        case TOK_PRINT: return "print"; case TOK_TRUE: return "true"; case TOK_FALSE: return "false";
   185	        case TOK_THROW: return "throw"; case TOK_TRY: return "try"; case TOK_CATCH: return "catch";
   186	        case TOK_PLUS_ASSIGN: return "+="; case TOK_MINUS_ASSIGN: return "-="; case TOK_STAR_ASSIGN: return "*=";
   187	        case TOK_SLASH_ASSIGN: return "/="; case TOK_PERCENT_ASSIGN: return "%=";
   188	        case TOK_EOF: return "EOF"; case TOK_ERROR: return "ERROR";
   189	        default: return "UNKNOWN";
   190	    }
   191	}
