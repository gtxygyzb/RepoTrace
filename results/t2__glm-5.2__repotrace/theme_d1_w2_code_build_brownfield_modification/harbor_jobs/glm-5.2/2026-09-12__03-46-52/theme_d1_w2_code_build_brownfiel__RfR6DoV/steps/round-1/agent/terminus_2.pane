   143	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   144	        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;
   145	        left = n;
   146	    }
   147	    return left;
