   103	static ASTNode *parse_comparison(Parser *p) {
   104	    ASTNode *left = parse_term(p);
   105	    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||
   106	           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {
   107	        int line = prev(p)->line; BinOp op;
   108	        switch (prev(p)->type) {
   109	            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;
   110	            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;
   111	            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;
   112	            default: op = OP_EQ; break;
   113	        }
   114	        ASTNode *right = parse_term(p);
   115	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   116	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   117	        left = n;
   118	    }
   119	    return left;
