    74	static ASTNode *parse_unary(Parser *p) {
    75	    if (match(p, TOK_MINUS)) {
    76	        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
    77	        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
    78	        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;
    79	    }
    80	    if (match(p, TOK_NOT)) {
    81	        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
    82	        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
    83	        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;
    84	    }
    85	    return parse_primary(p);
    86	}
    87	
    88	static ASTNode *parse_factor(Parser *p) {
    89	    ASTNode *left = parse_unary(p);
    90	    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {
    91	        int line = prev(p)->line; BinOp op;
    92	        if (prev(p)->type == TOK_STAR) op = OP_MUL;
    93	        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;
    94	        else op = OP_MOD;
    95	        ASTNode *right = parse_unary(p);
    96	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
    97	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
    98	        left = n;
    99	    }
   100	    return left;
   101	}
   102	
   103	/* NOTE: comparison operators are parsed at a tighter binding than +/-,
   104	   which is buggy: `a + b == c` is parsed as `a + (b == c)` instead of
   105	   `(a + b) == c`. */
   106	static ASTNode *parse_comparison(Parser *p) {
   107	    ASTNode *left = parse_factor(p);
   108	    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||
   109	           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {
   110	        int line = prev(p)->line; BinOp op;
   111	        switch (prev(p)->type) {
   112	            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;
   113	            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;
   114	            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;
   115	            default: op = OP_EQ; break;
   116	        }
   117	        ASTNode *right = parse_factor(p);
   118	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   119	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   120	        left = n;
   121	    }
   122	    return left;
   123	}
   124	
   125	static ASTNode *parse_term(Parser *p) {
   126	    ASTNode *left = parse_comparison(p);
   127	    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {
   128	        int line = prev(p)->line;
   129	        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;
   130	        ASTNode *right = parse_comparison(p);
   131	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   132	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   133	        left = n;
   134	    }
   135	    return left;
   136	}
   137	
   138	static ASTNode *parse_logic_and(Parser *p) {
   139	    ASTNode *left = parse_term(p);
   140	    while (match(p, TOK_AND)) {
   141	        int line = prev(p)->line; ASTNode *right = parse_term(p);
   142	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   143	        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;
   144	        left = n;
   145	    }
   146	    return left;
   147	}
   148	
   149	static ASTNode *parse_expr(Parser *p) {
   150	    ASTNode *left = parse_logic_and(p);
   151	    while (match(p, TOK_OR)) {
   152	        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);
   153	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   154	        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;
   155	        left = n;
   156	    }
   157	    return left;
   158	}
