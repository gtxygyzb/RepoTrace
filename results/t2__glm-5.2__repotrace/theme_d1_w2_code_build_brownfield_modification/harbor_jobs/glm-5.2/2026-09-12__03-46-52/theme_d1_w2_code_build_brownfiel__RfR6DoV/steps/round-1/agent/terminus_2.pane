[?2004l     1	#include "codegen.h"
     2	
     3	static int emit(Compiler *c, Opcode op, int64_t operand, char *str_op) {
     4	    if (c->code_count >= MAX_BYTECODE) { fprintf(stderr, "bytecode overflow\n"); return -1; }
     5	    Instruction *ins = &c->code[c->code_count];
     6	    ins->op = op; ins->operand = operand; ins->str_operand = str_op;
     7	    return c->code_count++;
     8	}
     9	
    10	static int resolve_local(Compiler *c, const char *name) {
    11	    for (int i = c->local_count - 1; i >= 0; i--) {
    12	        if (strcmp(c->locals[i].name, name) == 0) return i;
    13	    }
    14	    return -1;
    15	}
    16	
    17	static int add_local(Compiler *c, const char *name) {
    18	    if (c->local_count >= MAX_LOCALS) { fprintf(stderr, "too many local variables\n"); return -1; }
    19	    Local *local = &c->locals[c->local_count];
    20	    strncpy(local->name, name, MAX_IDENT_LEN - 1); local->name[MAX_IDENT_LEN - 1] = '\0';
    21	    local->scope_depth = c->scope_depth;
    22	    return c->local_count++;
    23	}
    24	
    25	static int find_function(Compiler *c, const char *name) {
    26	    for (int i = 0; i < c->func_count; i++) {
    27	        if (strcmp(c->functions[i].name, name) == 0) return i;
    28	    }
    29	    return -1;
    30	}
    31	
    32	static void compile_store(Compiler *c, const char *name) {
    33	    int slot = resolve_local(c, name);
    34	    if (slot >= 0) emit(c, BC_STORE_LOCAL, slot, NULL);
    35	    else emit(c, BC_STORE_GLOBAL, 0, strdup(name));
    36	}
    37	
    38	static int compile_node(Compiler *c, ASTNode *node);
    39	
    40	static int compile_expr(Compiler *c, ASTNode *node) {
    41	    switch (node->type) {
    42	        case NODE_NUM_LIT:
    43	            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;
    44	        case NODE_STR_LIT: {
    45	            char *s = strdup(node->data.str_val);
    46	            emit(c, BC_PUSH_STR, 0, s); break;
    47	        }
    48	        case NODE_BOOL_LIT:
    49	            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;
    50	        case NODE_IDENT: {
    51	            int slot = resolve_local(c, node->data.ident);
    52	            if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);
    53	            else emit(c, BC_LOAD_GLOBAL, 0, strdup(node->data.ident));
    54	            break;
    55	        }
    56	        case NODE_BINOP:
    57	            compile_expr(c, node->data.binop.left);
    58	            compile_expr(c, node->data.binop.right);
    59	            switch (node->data.binop.op) {
    60	                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;
    61	                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;
    62	                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
    63	                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
    64	                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
    65	                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;
    66	                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;
    67	                case OP_LT:  emit(c, BC_LT, 0, NULL); break;
    68	                case OP_GT:  emit(c, BC_GT, 0, NULL); break;
    69	                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;
    70	                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;
    71	                case OP_AND: emit(c, BC_AND, 0, NULL); break;
    72	                case OP_OR:  emit(c, BC_OR, 0, NULL); break;
    73	            }
    74	            break;
    75	        case NODE_UNARY:
    76	            compile_expr(c, node->data.unary.operand);
    77	            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);
    78	            else emit(c, BC_NOT, 0, NULL);
    79	            break;
    80	        case NODE_CALL: {
    81	            int fi = find_function(c, node->data.call.name);
    82	            if (fi < 0) { error_at(node->line, "undefined function '%s'", node->data.call.name); return -1; }
    83	            for (int i = 0; i < node->data.call.args.count; i++)
    84	                compile_expr(c, node->data.call.args.items[i]);
    85	            emit(c, BC_CALL, fi, NULL);
    86	            break;
    87	        }
    88	        case NODE_INDEX:
    89	            compile_expr(c, node->data.index_access.obj);
    90	            compile_expr(c, node->data.index_access.index);
    91	            emit(c, BC_INDEX, 0, NULL); break;
    92	        case NODE_ARRAY_LIT:
    93	            for (int i = 0; i < node->data.array_lit.elems.count; i++)
    94	                compile_expr(c, node->data.array_lit.elems.items[i]);
    95	            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;
    96	        default:
    97	            error_at(node->line, "cannot compile expression of type %d", node->type); return -1;
    98	    }
    99	    return 0;
   100	}
   101	
   102	static int compile_node(Compiler *c, ASTNode *node) {
   103	    switch (node->type) {
   104	        case NODE_LET: {
   105	            int slot = add_local(c, node->data.let.name);
   106	            if (slot < 0) return -1;
   107	            compile_expr(c, node->data.let.init);
   108	            break;
   109	        }
   110	        case NODE_ASSIGN: {
   111	            compile_expr(c, node->data.assign.value);
   112	            compile_store(c, node->data.assign.name);
   113	            break;
   114	        }
   115	        case NODE_IF: {
   116	            compile_expr(c, node->data.if_stmt.cond);
   117	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   118	            compile_node(c, node->data.if_stmt.then_b);
   119	            if (node->data.if_stmt.else_b) {
   120	                int je = emit(c, BC_JUMP, 0, NULL);
   121	                c->code[jf].operand = c->code_count;
   122	                compile_node(c, node->data.if_stmt.else_b);
   123	                c->code[je].operand = c->code_count;
   124	            } else {
   125	                c->code[jf].operand = c->code_count;
   126	            }
   127	            break;
   128	        }
   129	        case NODE_WHILE: {
   130	            int loop_start = c->code_count;
   131	            compile_expr(c, node->data.while_stmt.cond);
   132	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   133	            compile_node(c, node->data.while_stmt.body);
   134	            emit(c, BC_JUMP, loop_start, NULL);
   135	            c->code[jf].operand = c->code_count;
   136	            break;
   137	        }
   138	        case NODE_RETURN: {
   139	            if (node->data.ret.value) compile_expr(c, node->data.ret.value);
   140	            else emit(c, BC_PUSH_INT, 0, NULL);
   141	            emit(c, BC_RET, 0, NULL);
   142	            break;
   143	        }
   144	        case NODE_PRINT: {
   145	            compile_expr(c, node->data.print.value);
   146	            emit(c, BC_PRINT, 0, NULL);
   147	            break;
   148	        }
   149	        case NODE_BLOCK: {
   150	            int old_lc = c->local_count;
   151	            c->scope_depth++;
   152	            for (int i = 0; i < node->data.block.stmts.count; i++)
   153	                compile_node(c, node->data.block.stmts.items[i]);
   154	            c->scope_depth--;
   155	            {
   156	                int n = c->local_count - old_lc;
   157	                for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
   158	            }
   159	            c->local_count = old_lc;
   160	            break;
   161	        }
   162	        case NODE_FUNC: {
   163	            int jump_over = emit(c, BC_JUMP, 0, NULL);
   164	
   165	            if (c->func_count >= MAX_FUNCTIONS) { fprintf(stderr, "too many functions\n"); return -1; }
   166	            FuncInfo *fi = &c->functions[c->func_count];
   167	            strncpy(fi->name, node->data.func.name, MAX_IDENT_LEN - 1);
   168	            fi->addr = c->code_count;
   169	            fi->param_count = node->data.func.param_count;
   170	            c->func_count++;
   171	
   172	            int old_lc = c->local_count;
   173	            int old_scope = c->scope_depth;
   174	            int old_inf = c->in_function;
   175	
   176	            c->local_count = 0;
   177	            c->scope_depth = 0;
   178	            c->in_function = 1;
   179	            c->scope_depth++;
   180	
   181	            for (int i = 0; i < node->data.func.param_count; i++)
   182	                add_local(c, node->data.func.params[i]);
   183	
   184	            compile_node(c, node->data.func.body);
   185	
   186	            emit(c, BC_PUSH_INT, 0, NULL);
   187	            emit(c, BC_RET, 0, NULL);
   188	
   189	            c->scope_depth = old_scope;
   190	            c->local_count = old_lc;
   191	            c->in_function = old_inf;
   192	
   193	            c->code[jump_over].operand = c->code_count;
   194	            break;
   195	        }
   196	        case NODE_EXPR_STMT: {
   197	            compile_expr(c, node->data.expr_stmt.expr);
   198	            emit(c, BC_POP, 0, NULL);
   199	            break;
   200	        }
   201	        default:
   202	            compile_expr(c, node);
   203	            emit(c, BC_POP, 0, NULL);
   204	            break;
   205	    }
   206	    return 0;
   207	}
   208	
   209	void compiler_init(Compiler *c) {
   210	    c->code_count = 0; c->local_count = 0; c->scope_depth = 0;
   211	    c->func_count = 0; c->in_function = 0;
   212	}
   213	
   214	int compile(Compiler *c, ASTNode *program) {
   215	    if (compile_node(c, program) < 0) return -1;
   216	    emit(c, BC_HALT, 0, NULL);
   217	    return 0;
   218	}
