    18	static Value make_map(void) {
    19	    Value val; val.type = VAL_MAP; val.data.map = malloc(sizeof(MapData));
    20	    val.data.map->keys = NULL; val.data.map->values = NULL; val.data.map->len = 0; val.data.map->cap = 0;
    21	    return val;
    22	}
    23	
    24	static int map_find(MapData *m, const char *key) {
    25	    for (int i = 0; i < m->len; i++) if (strcmp(m->keys[i], key) == 0) return i;
    26	    return -1;
    27	}
    28	
    29	static void map_set(MapData *m, const char *key, Value v) {
    30	    int i = map_find(m, key);
    31	    if (i >= 0) { m->values[i] = v; return; }
    32	    if (m->len >= m->cap) {
    33	        int cap = m->cap == 0 ? 8 : m->cap * 2;
    34	        m->keys = realloc(m->keys, cap * sizeof(char*));
    35	        m->values = realloc(m->values, cap * sizeof(Value));
    36	        m->cap = cap;
    37	    }
    38	    m->keys[m->len] = strdup(key);
    39	    m->values[m->len] = v;
    40	    m->len++;
    41	}
    42	
    43	static int map_delete(MapData *m, const char *key) {
    44	    int i = map_find(m, key);
    45	    if (i < 0) return 0;
    46	    free(m->keys[i]);
    47	    for (int j = i; j < m->len - 1; j++) { m->keys[j] = m->keys[j+1]; m->values[j] = m->values[j+1]; }
    48	    m->len--;
    49	    return 1;
    50	}
