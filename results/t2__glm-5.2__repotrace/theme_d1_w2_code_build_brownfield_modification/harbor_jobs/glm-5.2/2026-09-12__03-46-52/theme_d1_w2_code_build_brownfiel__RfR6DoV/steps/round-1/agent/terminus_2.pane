    return value_to_cstr(v, buf, size);
}

static int value_cmp(Value a, Value b) {
    if (a.type == VAL_STR && b.type == VAL_STR)
        return strcmp(a.data.sval, b.data.sval);
    int64_t ia = value_to_int(a), ib = value_to_int(b);
    return ia < ib ? -1 : (ia > ib ? 1 : 0);
}

static void print_value_fp(FILE *fp, Value v) {
    switch (v.type) {
        case VAL_INT: fprintf(fp, "%lld", (long long)v.data.ival); break;
        case VAL_BOOL: fprintf(fp, "%s", v.data.bval ? "true" : "false"); break;
        case VAL_STR: fprintf(fp, "%s", v.data.sval); break;
        case VAL_ARRAY:
            fprintf(fp, "[");
            for (int i = 0; i < v.data.array.len; i++) {
                if (i > 0) fprintf(fp, ", ");
                print_value_fp(fp, v.data.array.items[i]);
            }
            fprintf(fp, "]");
            break;
        case VAL_MAP:
            fprintf(fp, "{");
            for (int i = 0; i < v.data.map->len; i++) {
                if (i > 0) fprintf(fp, ", ");
                fprintf(fp, "%s", v.data.map->keys[i]);
                fprintf(fp, ": ");
                print_value_fp(fp, v.data.map->values[i]);
            }
            fprintf(fp, "}");
            break;
        case VAL_NULL: fprintf(fp, "null"); break;
        case VAL_CLOSURE: fprintf(fp, "<closure>"); break;
        case VAL_REF: print_value_fp(fp, *v.data.ref); break;
    }
}
static void print_value(Value v) { print_value_fp(stdout, v); }

void vm_init(VM *vm, Compiler *c) {
    vm->sp = 0; vm->frame_count = 0; vm->global_count = 0;
    vm->code = c->code; vm->code_count = c->code_count;
    vm->functions = c->functions; vm->func_count = c->func_count;
    vm->ip = 0;
    vm->handler_count = 0;
}

int vm_run(VM *vm) {
    while (vm->ip < vm->code_count) {
        Instruction *ins = &vm->code[vm->ip++];
        switch (ins->op) {
            case BC_PUSH_INT: push(vm, make_int(ins->operand)); break;
            case BC_PUSH_STR: push(vm, make_str(ins->str_operand)); break;
            case BC_PUSH_BOOL: push(vm, make_bool((int)ins->operand)); break;
            case BC_LOAD_LOCAL: {
                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;
                push(vm, vm->stack[base + (int)ins->operand]);
                break;
