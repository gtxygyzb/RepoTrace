[?2004l   119	static ASTNode *parse_postfix(Parser *p, ASTNode *expr) {
   120	    for (;;) {
   121	        if (match(p, TOK_DOT)) {
   122	            int line = prev(p)->line;
   123	            expect(p, TOK_IDENT, "field or method name");
   124	            char name[MAX_IDENT_LEN];
   125	            strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\0';
   126	            if (check(p, TOK_LPAREN)) {
   127	                match(p, TOK_LPAREN);
   128	                ASTNode *n = ast_alloc(); n->type = NODE_METHOD_CALL; n->line = line;
   129	                n->data.method_call.obj = expr;
   130	                strncpy(n->data.method_call.method, name, MAX_IDENT_LEN - 1);
   131	                n->data.method_call.method[MAX_IDENT_LEN - 1] = '\0';
   132	                nodelist_init(&n->data.method_call.args);
   133	                if (!check(p, TOK_RPAREN)) {
   134	                    do { nodelist_push(&n->data.method_call.args, parse_expr(p)); } while (match(p, TOK_COMMA));
   135	                }
   136	                expect(p, TOK_RPAREN, "')'");
   137	                expr = n;
   138	            } else {
   139	                ASTNode *n = ast_alloc(); n->type = NODE_FIELD_ACCESS; n->line = line;
   140	                n->data.field_access.obj = expr;
   141	                strncpy(n->data.field_access.field, name, MAX_IDENT_LEN - 1);
   142	                n->data.field_access.field[MAX_IDENT_LEN - 1] = '\0';
   143	                expr = n;
   144	            }
   145	        } else if (match(p, TOK_LBRACKET)) {
   146	            int line = prev(p)->line;
   147	            ASTNode *idx = parse_expr(p);
   148	            expect(p, TOK_RBRACKET, "']'");
   149	            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;
   150	            n->data.index_access.obj = expr;
   151	            n->data.index_access.index = idx;
   152	            expr = n;
   153	        } else {
   154	            break;
   155	        }
   156	    }
   157	    return expr;
   158	}
   159	
   160	static ASTNode *parse_unary(Parser *p) {
   161	    if (match(p, TOK_MINUS)) {
   162	        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
   163	        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
   164	        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;
   165	    }
   166	    if (match(p, TOK_NOT)) {
   167	        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
   168	        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
   169	        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;
   170	    }
   171	    return parse_primary(p);
   172	}
   173	
   174	static ASTNode *parse_factor(Parser *p) {
   175	    ASTNode *left = parse_unary(p);
   176	    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {
   177	        int line = prev(p)->line; BinOp op;
   178	        if (prev(p)->type == TOK_STAR) op = OP_MUL;
   179	        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;
   180	        else op = OP_MOD;
   181	        ASTNode *right = parse_unary(p);
   182	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   183	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   184	        left = n;
   185	    }
   186	    return left;
   187	}
   188	
   189	static ASTNode *parse_comparison(Parser *p) {
   190	    ASTNode *left = parse_term(p);
   191	    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||
   192	           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {
   193	        int line = prev(p)->line; BinOp op;
   194	        switch (prev(p)->type) {
   195	            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;
   196	            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;
   197	            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;
   198	            default: op = OP_EQ; break;
   199	        }
   200	        ASTNode *right = parse_term(p);
   201	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   202	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   203	        left = n;
   204	    }
   205	    return left;
   206	}
   207	
   208	static ASTNode *parse_term(Parser *p) {
   209	    ASTNode *left = parse_factor(p);
   210	    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {
   211	        int line = prev(p)->line;
   212	        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;
   213	        ASTNode *right = parse_factor(p);
   214	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   215	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   216	        left = n;
   217	    }
   218	    return left;
   219	}
