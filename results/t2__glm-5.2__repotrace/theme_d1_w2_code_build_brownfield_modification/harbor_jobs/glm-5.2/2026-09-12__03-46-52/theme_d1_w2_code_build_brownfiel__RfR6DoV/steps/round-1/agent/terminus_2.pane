   118	            compile_node(c, node->data.if_stmt.then_b);
   119	            if (node->data.if_stmt.else_b) {
   120	                int je = emit(c, BC_JUMP, 0, NULL);
   121	                c->code[jf].operand = c->code_count;
   122	                compile_node(c, node->data.if_stmt.else_b);
   123	                c->code[je].operand = c->code_count;
   124	            } else {
   125	                c->code[jf].operand = c->code_count;
   126	            }
   127	            break;
   128	        }
   129	        case NODE_WHILE: {
   130	            int loop_start = c->code_count;
   131	            compile_expr(c, node->data.while_stmt.cond);
   132	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   133	            compile_node(c, node->data.while_stmt.body);
   134	            emit(c, BC_JUMP, loop_start, NULL);
   135	            c->code[jf].operand = c->code_count;
   136	            break;
   137	        }
   138	        case NODE_RETURN: {
   139	            if (node->data.ret.value) compile_expr(c, node->data.ret.value);
