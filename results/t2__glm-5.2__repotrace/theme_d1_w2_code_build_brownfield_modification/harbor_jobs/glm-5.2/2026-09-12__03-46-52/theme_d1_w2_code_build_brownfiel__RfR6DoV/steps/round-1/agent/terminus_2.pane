    switch (node->type) {
        case NODE_LET: add_name(names, count, node->data.let.name); break;
        case NODE_BLOCK:
            for (int i = 0; i < node->data.block.stmts.count; i++)
                collect_bound_names(node->data.block.stmts.items[i], names, count);
            break;
        case NODE_IF:
            collect_bound_names(node->data.if_stmt.then_b, names, count);
            collect_bound_names(node->data.if_stmt.else_b, names, count);
            break;
        case NODE_WHILE: collect_bound_names(node->data.while_stmt.body, names, count); break;
        case NODE_FOR:
            if (node->data.for_stmt.init) collect_bound_names(node->data.for_stmt.init, names, count);
            collect_bound_names(node->data.for_stmt.body, names, count);
            break;
        case NODE_FOREACH:
            add_name(names, count, node->data.foreach_stmt.var);
            collect_bound_names(node->data.foreach_stmt.body, names, count);
            break;
        case NODE_FUNC: add_name(names, count, node->data.func.name); break;
        case NODE_CLOSURE: break;
        default: break;
    }
}
static void collect_free_names(ASTNode *node, char bound[][MAX_IDENT_LEN], int bound_count,
                              char free_names[][MAX_IDENT_LEN], int *free_count) {
    if (!node) return;
    switch (node->type) {
        case NODE_IDENT:
            if (!name_in_list(bound, bound_count, node->data.ident)) add_name(free_names, free_count, node->data.ident);
            break;
        case NODE_ASSIGN:
            collect_free_names(node->data.assign.value, bound, bound_count, free_names, free_count);
            if (!name_in_list(bound, bound_count, node->data.assign.name)) add_name(free_names, free_count, node->data.assign.name);
            break;
        case NODE_COMPOUND_ASSIGN:
            collect_free_names(node->data.compound_assign.value, bound, bound_count, free_names, free_count);
            if (!name_in_list(bound, bound_count, node->data.compound_assign.name)) add_name(free_names, free_count, node->data.compound_assign.name);
            break;
        case NODE_CALL:
            if (!name_in_list(bound, bound_count, node->data.call.name)) add_name(free_names, free_count, node->data.call.name);
            for (int i = 0; i < node->data.call.args.count; i++)
                collect_free_names(node->data.call.args.items[i], bound, bound_count, free_names, free_count);
            break;
        case NODE_BINOP:
            collect_free_names(node->data.binop.left, bound, bound_count, free_names, free_count);
            collect_free_names(node->data.binop.right, bound, bound_count, free_names, free_count);
            break;
        case NODE_UNARY:
            collect_free_names(node->data.unary.operand, bound, bound_count, free_names, free_count);
            break;
        case NODE_INDEX:
            collect_free_names(node->data.index_access.obj, bound, bound_count, free_names, free_count);
            collect_free_names(node->data.index_access.index, bound, bound_count, free_names, free_count);
            break;
        case NODE_INDEX_ASSIGN:
            if (node->data.index_assign.obj) collect_free_names(node->data.index_assign.obj, bound, bound_count, free_names, free_count);
            else if (node->data.index_assign.name[0]) { if (!name_in_list(bound, bound_count, node->data.index_assign.name)) add_name(free_names, free_count, node->data.index_assign.name); }
            collect_free_names(node->data.index_assign.index, bound, bound_count, free_names, free_count);
            collect_free_names(node->data.index_assign.value, bound, bound_count, free_names, free_count);
            break;
        case NODE_FIELD_ACCESS:
            collect_free_names(node->data.field_access.obj, bound, bound_count, free_names, free_count);
            break;
        case NODE_METHOD_CALL:
            collect_free_names(node->data.method_call.obj, bound, bound_count, free_names, free_count);
            for (int i = 0; i < node->data.method_call.args.count; i++)
                collect_free_names(node->data.method_call.args.items[i], bound, bound_count, free_names, free_count);
            break;
        case NODE_FIELD_ASSIGN:
            collect_free_names(node->data.field_assign.obj, bound, bound_count, free_names, free_count);
            collect_free_names(node->data.field_assign.value, bound, bound_count, free_names, free_count);
            break;
        case NODE_LET:
            collect_free_names(node->data.let.init, bound, bound_count, free_names, free_count);
            break;
        case NODE_BLOCK:
            for (int i = 0; i < node->data.block.stmts.count; i++)
                collect_free_names(node->data.block.stmts.items[i], bound, bound_count, free_names, free_count);
            break;
        case NODE_IF:
            collect_free_names(node->data.if_stmt.cond, bound, bound_count, free_names, free_count);
            collect_free_names(node->data.if_stmt.then_b, bound, bound_count, free_names, free_count);
            collect_free_names(node->data.if_stmt.else_b, bound, bound_count, free_names, free_count);
            break;
        case NODE_WHILE:
            collect_free_names(node->data.while_stmt.cond, bound, bound_count, free_names, free_count);
            collect_free_names(node->data.while_stmt.body, bound, bound_count, free_names, free_count);
            break;
        case NODE_FOR:
            if (node->data.for_stmt.init) collect_free_names(node->data.for_stmt.init, bound, bound_count, free_names, free_count);
            if (node->data.for_stmt.cond) collect_free_names(node->data.for_stmt.cond, bound, bound_count, free_names, free_count);
            if (node->data.for_stmt.step) collect_free_names(node->data.for_stmt.step, bound, bound_count, free_names, free_count);
            collect_free_names(node->data.for_stmt.body, bound, bound_count, free_names, free_count);
            break;
        case NODE_FOREACH:
            collect_free_names(node->data.foreach_stmt.arr, bound, bound_count, free_names, free_count);
            collect_free_names(node->data.foreach_stmt.body, bound, bound_count, free_names, free_count);
            break;
        case NODE_RETURN:
            if (node->data.ret.value) collect_free_names(node->data.ret.value, bound, bound_count, free_names, free_count);
            break;
        case NODE_PRINT:
            collect_free_names(node->data.print.value, bound, bound_count, free_names, free_count);
            break;
        case NODE_EXPR_STMT:
            collect_free_names(node->data.expr_stmt.expr, bound, bound_count, free_names, free_count);
            break;
        case NODE_ARRAY_LIT:
            for (int i = 0; i < node->data.array_lit.elems.count; i++)
                collect_free_names(node->data.array_lit.elems.items[i], bound, bound_count, free_names, free_count);
            break;
        case NODE_MAP_LIT:
            for (int i = 0; i < node->data.map_lit.keys.count; i++) {
                collect_free_names(node->data.map_lit.keys.items[i], bound, bound_count, free_names, free_count);
                collect_free_names(node->data.map_lit.values.items[i], bound, bound_count, free_names, free_count);
            }
            break;
        case NODE_CLOSURE: break;
        default: break;
