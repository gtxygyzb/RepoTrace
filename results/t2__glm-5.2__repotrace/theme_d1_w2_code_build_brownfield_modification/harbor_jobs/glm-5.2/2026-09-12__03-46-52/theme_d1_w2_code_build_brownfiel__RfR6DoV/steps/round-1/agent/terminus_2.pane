   280	        expect(p, TOK_RPAREN, "')'");
   281	        ASTNode *then_b = parse_block(p);
   282	        ASTNode *else_b = NULL;
   283	        if (match(p, TOK_ELSE)) {
   284	            if (check(p, TOK_IF)) {
   285	                ASTNode *elif = parse_stmt(p);
