        case NODE_FOREACH:
            add_name(names, count, node->data.foreach_stmt.var);
            collect_bound_names(node->data.foreach_stmt.body, names, count);
            break;
        case NODE_FUNC: add_name(names, count, node->data.func.name); break;
        case NODE_CLOSURE: break;
        default: break;
    }
}
static void collect_free_names(ASTNode *node, char bound[][MAX_IDENT_LEN], int bound_count,
                              char free_names[][MAX_IDENT_LEN], int *free_count) {
    if (!node) return;
    switch (node->type) {
        case NODE_IDENT:
            if (!name_in_list(bound, bound_count, node->data.ident)) add_name(free_names, free_count, node->data.ident);
            break;
        case NODE_ASSIGN:
            collect_free_names(node->data.assign.value, bound, bound_count, free_names, free_count);
            if (!name_in_list(bound, bound_count, node->data.assign.name)) add_name(free_names, free_count, node->data.assign.name);
            break;
        case NODE_COMPOUND_ASSIGN:
            collect_free_names(node->data.compound_assign.value, bound, bound_count, free_names, free_count);
            if (!name_in_list(bound, bound_count, node->data.compound_assign.name)) add_name(free_names, free_count, node->data.compound_assign.name);
            break;
        case NODE_CALL:
            if (!name_in_list(bound, bound_count, node->data.call.name)) add_name(free_names, free_count, node->data.call.name);
            for (int i = 0; i < node->data.call.args.count; i++)
                collect_free_names(node->data.call.args.items[i], bound, bound_count, free_names, free_count);
            break;
        case NODE_BINOP:
            collect_free_names(node->data.binop.left, bound, bound_count, free_names, free_count);
            collect_free_names(node->data.binop.right, bound, bound_count, free_names, free_count);
            break;
        case NODE_UNARY:
            collect_free_names(node->data.unary.operand, bound, bound_count, free_names, free_count);
            break;
        case NODE_INDEX:
            collect_free_names(node->data.index_access.obj, bound, bound_count, free_names, free_count);
            collect_free_names(node->data.index_access.index, bound, bound_count, free_names, free_count);
            break;
        case NODE_INDEX_ASSIGN:
            if (node->data.index_assign.obj) collect_free_names(node->data.index_assign.obj, bound, bound_count, free_names, free_count);
            else if (node->data.index_assign.name[0]) { if (!name_in_list(bound, bound_count, node->data.index_assign.name)) add_name(free_names, free_count, node->data.index_assign.name); }
            collect_free_names(node->data.index_assign.index, bound, bound_count, free_names, free_count);
            collect_free_names(node->data.index_assign.value, bound, bound_count, free_names, free_count);
