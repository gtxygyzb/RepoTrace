   195	                arr.data.array.items = malloc(count * sizeof(Value));
   196	                for (int i = count - 1; i >= 0; i--) arr.data.array.items[i] = pop(vm);
   197	                push(vm, arr); break;
   198	            }
   199	            case BC_INDEX: {
   200	                Value idx = pop(vm); Value obj = pop(vm);
   201	                if (obj.type != VAL_ARRAY) { fprintf(stderr, "cannot index non-array\n"); return -1; }
