   372	ASTNode *parse_program(Parser *p) {
   373	    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;
   374	    nodelist_init(&program->data.block.stmts);
   375	    while (!check(p, TOK_EOF)) {
