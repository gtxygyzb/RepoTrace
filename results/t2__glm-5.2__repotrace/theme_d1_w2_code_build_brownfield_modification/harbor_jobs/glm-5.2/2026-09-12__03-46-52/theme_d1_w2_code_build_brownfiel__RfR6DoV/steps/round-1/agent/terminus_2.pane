     9	static char *read_file(const char *path) {
    10	    FILE *f = fopen(path, "r");
    11	    if (!f) { fprintf(stderr, "cannot open file: %s\n", path); return NULL; }
    12	    fseek(f, 0, SEEK_END);
    13	    long size = ftell(f);
    14	    if (size > 0) {
    15	        fseek(f, 0, SEEK_SET);
    16	        char *buf = malloc(size + 1);
    17	        if (!buf) { fclose(f); return NULL; }
    18	        size_t rd = fread(buf, 1, size, f);
    19	        buf[rd] = '\0';
    20	        fclose(f);
    21	        return buf;
    22	    }
    23	    fseek(f, 0, SEEK_SET);
    24	    size_t cap = 4096, len = 0;
    25	    char *buf = malloc(cap);
    26	    if (!buf) { fclose(f); return NULL; }
    27	    size_t rd;
    28	    while ((rd = fread(buf + len, 1, cap - len - 1, f)) > 0) {
    29	        len += rd;
    30	        if (len + 1 >= cap) { cap *= 2; buf = realloc(buf, cap); }
    31	    }
    32	    buf[len] = '\0';
    33	    fclose(f);
    34	    return buf;
    35	}
    36	
    37	int main(int argc, char **argv) {
    38	    if (argc < 2) { fprintf(stderr, "usage: minicc <file.mini>\n"); return 1; }
    39	    char *source = read_file(argv[1]);
    40	    if (!source) return 1;
    41	
    42	    Lexer lex;
    43	    lexer_init(&lex, source);
    44	    if (lexer_tokenize(&lex) < 0) { free(source); return 1; }
    45	
    46	    Parser parser;
    47	    parser_init(&parser, lex.tokens, lex.token_count);
    48	    ASTNode *program = parse_program(&parser);
    49	    if (parser.had_error) { free(source); ast_free_all(); return 1; }
    50	
    51	    Compiler compiler;
    52	    compiler_init(&compiler);
    53	    if (compile(&compiler, program) < 0) { free(source); ast_free_all(); return 1; }
    54	
    55	    VM vm;
    56	    vm_init(&vm, &compiler);
    57	    int result = vm_run(&vm);
    58	
    59	    free(source);
    60	    ast_free_all();
    61	    return result;
    62	}
