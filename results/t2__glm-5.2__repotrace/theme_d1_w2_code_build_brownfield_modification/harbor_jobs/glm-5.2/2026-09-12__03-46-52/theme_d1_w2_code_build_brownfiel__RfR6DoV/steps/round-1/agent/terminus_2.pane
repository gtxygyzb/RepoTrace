   195	static ASTNode *parse_for(Parser *p) {
   196	    int line = prev(p)->line;
   197	    expect(p, TOK_LPAREN, "'('");
   198	
   199	    if (check(p, TOK_IDENT) && p->pos + 1 < p->count && p->tokens[p->pos + 1].type == TOK_IN) {
   200	        char name[MAX_IDENT_LEN];
   201	        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   202	        match(p, TOK_IDENT);
   203	        match(p, TOK_IN);
   204	        ASTNode *arr = parse_expr(p);
   205	        expect(p, TOK_RPAREN, "')'");
   206	        ASTNode *body = parse_block(p);
   207	        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;
   208	        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);
   209	        n->data.foreach_stmt.arr = arr;
   210	        n->data.foreach_stmt.body = body;
   211	        return n;
   212	    }
   213	
   214	    ASTNode *init = NULL;
   215	    if (match(p, TOK_LET)) {
   216	        expect(p, TOK_IDENT, "identifier");
   217	        char name[MAX_IDENT_LEN];
   218	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   219	        expect(p, TOK_ASSIGN, "'='");
   220	        ASTNode *init_expr = parse_expr(p);
   221	        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;
   222	        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);
   223	        init->data.let.init = init_expr;
   224	    } else if (check(p, TOK_IDENT)) {
   225	        init = try_parse_assign(p);
   226	        if (!init) init = parse_expr(p);
   227	    } else if (!check(p, TOK_SEMICOLON)) {
   228	        init = parse_expr(p);
   229	    }
   230	    expect(p, TOK_SEMICOLON, "';'");
   231	
   232	    ASTNode *cond = NULL;
   233	    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);
   234	    expect(p, TOK_SEMICOLON, "';'");
   235	
   236	    ASTNode *step = NULL;
   237	    if (!check(p, TOK_RPAREN)) {
   238	        if (check(p, TOK_IDENT)) {
   239	            step = try_parse_assign(p);
   240	        }
   241	        if (!step) step = parse_expr(p);
   242	    }
   243	    expect(p, TOK_RPAREN, "')'");
   244	
   245	    ASTNode *body = parse_block(p);
   246	    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;
   247	    n->data.for_stmt.init = init;
   248	    n->data.for_stmt.cond = cond;
   249	    n->data.for_stmt.step = step;
   250	    n->data.for_stmt.body = body;
   251	    return n;
   252	}
   253	
   254	static ASTNode *parse_block(Parser *p) {
   255	    expect(p, TOK_LBRACE, "'{'");
   256	    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;
   257	    nodelist_init(&block->data.block.stmts);
   258	    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {
   259	        ASTNode *stmt = parse_stmt(p);
   260	        if (stmt) nodelist_push(&block->data.block.stmts, stmt);
   261	        if (p->had_error) break;
   262	    }
   263	    expect(p, TOK_RBRACE, "'}'");
   264	    return block;
   265	}
   266	
   267	static ASTNode *parse_stmt(Parser *p) {
   268	    if (match(p, TOK_LET)) {
   269	        int line = prev(p)->line;
   270	        expect(p, TOK_IDENT, "identifier");
   271	        char name[MAX_IDENT_LEN];
   272	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   273	        expect(p, TOK_ASSIGN, "'='");
   274	        ASTNode *init = parse_expr(p);
   275	        expect(p, TOK_SEMICOLON, "';'");
   276	        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;
   277	        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);
   278	        n->data.let.init = init; return n;
   279	    }
   280	    if (match(p, TOK_IF)) {
   281	        int line = prev(p)->line;
   282	        expect(p, TOK_LPAREN, "'('");
   283	        ASTNode *cond = parse_expr(p);
   284	        expect(p, TOK_RPAREN, "')'");
   285	        ASTNode *then_b = parse_block(p);
   286	        ASTNode *else_b = NULL;
   287	        if (match(p, TOK_ELSE)) {
   288	            if (check(p, TOK_IF)) {
   289	                ASTNode *elif = parse_stmt(p);
   290	                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;
   291	                nodelist_init(&else_b->data.block.stmts);
   292	                nodelist_push(&else_b->data.block.stmts, elif);
   293	            } else {
   294	                else_b = parse_block(p);
   295	            }
   296	        }
   297	        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;
   298	        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;
   299	        return n;
   300	    }
   301	    if (match(p, TOK_WHILE)) {
   302	        int line = prev(p)->line;
   303	        expect(p, TOK_LPAREN, "'('");
   304	        ASTNode *cond = parse_expr(p);
   305	        expect(p, TOK_RPAREN, "')'");
   306	        ASTNode *body = parse_block(p);
   307	        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;
   308	        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;
   309	    }
   310	    if (match(p, TOK_RETURN)) {
   311	        int line = prev(p)->line;
   312	        ASTNode *value = NULL;
   313	        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);
   314	        expect(p, TOK_SEMICOLON, "';'");
   315	        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;
   316	        n->data.ret.value = value; return n;
   317	    }
   318	    if (match(p, TOK_FOR)) {
   319	        return parse_for(p);
   320	    }
   321	    if (match(p, TOK_BREAK)) {
   322	        int line = prev(p)->line;
   323	        expect(p, TOK_SEMICOLON, "';'");
   324	        ASTNode *n = ast_alloc(); n->type = NODE_BREAK; n->line = line; return n;
   325	    }
   326	    if (match(p, TOK_CONTINUE)) {
   327	        int line = prev(p)->line;
   328	        expect(p, TOK_SEMICOLON, "';'");
   329	        ASTNode *n = ast_alloc(); n->type = NODE_CONTINUE; n->line = line; return n;
   330	    }
   331	    if (match(p, TOK_PRINT)) {
   332	        int line = prev(p)->line;
   333	        ASTNode *value = parse_expr(p);
   334	        expect(p, TOK_SEMICOLON, "';'");
   335	        ASTNode *n = ast_alloc(); n->type = NODE_PRINT; n->line = line;
   336	        n->data.print.value = value; return n;
   337	    }
   338	    if (match(p, TOK_FN)) {
   339	        int line = prev(p)->line;
   340	        expect(p, TOK_IDENT, "function name");
   341	        char name[MAX_IDENT_LEN];
   342	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   343	        expect(p, TOK_LPAREN, "'('");
   344	        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;
   345	        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);
   346	        n->data.func.param_count = 0;
   347	        if (!check(p, TOK_RPAREN)) {
   348	            do {
   349	                expect(p, TOK_IDENT, "parameter name");
   350	                strncpy(n->data.func.params[n->data.func.param_count],
   351	                        prev(p)->text, MAX_IDENT_LEN - 1);
   352	                n->data.func.param_count++;
   353	            } while (match(p, TOK_COMMA));
   354	        }
   355	        expect(p, TOK_RPAREN, "')'");
   356	        n->data.func.body = parse_block(p); return n;
   357	    }
   358	    if (check(p, TOK_IDENT)) {
   359	        ASTNode *a = try_parse_assign(p);
   360	        if (a) { expect(p, TOK_SEMICOLON, "';'"); return a; }
   361	    }
   362	    ASTNode *expr = parse_expr(p);
   363	    expect(p, TOK_SEMICOLON, "';'");
   364	    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;
   365	    n->data.expr_stmt.expr = expr; return n;
   366	}
