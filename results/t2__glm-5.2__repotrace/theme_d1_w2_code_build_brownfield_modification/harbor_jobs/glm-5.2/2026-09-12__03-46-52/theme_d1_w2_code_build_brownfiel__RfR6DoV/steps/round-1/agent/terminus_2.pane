   400	            loop_depth = old_loop_depth;
   401	
   402	            c->code[jump_over].operand = c->code_count;
   403	            break;
   404	        }
   405	        case NODE_EXPR_STMT: {
   406	            compile_expr(c, node->data.expr_stmt.expr);
   407	            emit(c, BC_POP, 0, NULL);
   408	            break;
   409	        }
   410	        default:
   411	            compile_expr(c, node);
   412	            emit(c, BC_POP, 0, NULL);
   413	            break;
   414	    }
   415	    return 0;
   416	}
   417	
   418	void compiler_init(Compiler *c) {
   419	    c->code_count = 0; c->local_count = 0; c->scope_depth = 0;
   420	    c->func_count = 0; c->in_function = 0;
   421	}
   422	
   423	int compile(Compiler *c, ASTNode *program) {
   424	    if (compile_node(c, program) < 0) return -1;
   425	    emit(c, BC_HALT, 0, NULL);
   426	    return 0;
   427	}
