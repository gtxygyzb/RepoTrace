#include "common.h"
#include "codegen.h"

typedef struct {
    Value stack[MAX_STACK];
    int sp;
    CallFrame frames[MAX_CALL_FRAMES];
    int frame_count;
    Value globals[MAX_GLOBALS];
    char global_names[MAX_GLOBALS][MAX_IDENT_LEN];
    int global_count;
    Instruction *code;
    int code_count;
    FuncInfo *functions;
    int func_count;
    int ip;
} VM;

