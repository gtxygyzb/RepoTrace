   201	            emit(c, BC_PUSH_INT, 0, NULL);
   202	            int idx_slot = add_local(c, ".foridx");
   203	            int loop_start = c->code_count;
   204	            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
   205	            emit(c, BC_LOAD_LOCAL, arr_slot, NULL);
   206	            emit(c, BC_ARRAY_LEN, 0, NULL);
   207	            emit(c, BC_LT, 0, NULL);
   208	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   209	            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, "too many nested loops"); return -1; }
   210	            LoopCtx *ctx = &loop_stack[loop_depth++];
   211	            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;
   212	            ctx->break_count = 0; ctx->cont_count = 0;
   213	            int body_old = c->local_count;
   214	            emit(c, BC_LOAD_LOCAL, arr_slot, NULL);
   215	            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
   216	            emit(c, BC_INDEX, 0, NULL);
   217	            int var_slot = add_local(c, node->data.foreach_stmt.var);
   218	            emit(c, BC_STORE_LOCAL, var_slot, NULL);
   219	            compile_node(c, node->data.foreach_stmt.body);
   220	            int n = c->local_count - body_old;
   221	            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
   222	            c->local_count = body_old;
   223	            int inc_start = c->code_count;
   224	            ctx->cont = inc_start;
   225	            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
   226	            emit(c, BC_PUSH_INT, 1, NULL);
   227	            emit(c, BC_ADD, 0, NULL);
   228	            emit(c, BC_STORE_LOCAL, idx_slot, NULL);
   229	            emit(c, BC_JUMP, loop_start, NULL);
   230	            int end = c->code_count;
   231	            c->code[jf].operand = end;
   232	            ctx->end = end;
   233	            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;
   234	            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = inc_start;
   235	            loop_depth--;
   236	            int n2 = c->local_count - old_lc;
   237	            for (int i = 0; i < n2; i++) emit(c, BC_POP, 0, NULL);
   238	            c->local_count = old_lc;
   239	            c->scope_depth--;
   240	            break;
   241	        }
   242	        case NODE_BREAK: {
   243	            if (loop_depth <= 0) { error_at(node->line, "break outside loop"); return -1; }
   244	            LoopCtx *ctx = &loop_stack[loop_depth - 1];
   245	            if (ctx->break_count >= MAX_LOOP_JUMPS) { error_at(node->line, "too many break statements"); return -1; }
   246	            ctx->breaks[ctx->break_count++] = emit(c, BC_JUMP, 0, NULL);
   247	            break;
   248	        }
   249	        case NODE_CONTINUE: {
   250	            if (loop_depth <= 0) { error_at(node->line, "continue outside loop"); return -1; }
   251	            LoopCtx *ctx = &loop_stack[loop_depth - 1];
   252	            if (ctx->cont_count >= MAX_LOOP_JUMPS) { error_at(node->line, "too many continue statements"); return -1; }
   253	            ctx->conts[ctx->cont_count++] = emit(c, BC_JUMP, 0, NULL);
   254	            break;
   255	        }
   256	        case NODE_COMPOUND_ASSIGN: {
   257	            compile_load(c, node->data.compound_assign.name);
   258	            compile_expr(c, node->data.compound_assign.value);
   259	            switch (node->data.compound_assign.op) {
   260	                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;
   261	                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;
   262	                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
   263	                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
   264	                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
   265	                default: error_at(node->line, "invalid compound assignment"); return -1;
   266	            }
   267	            compile_store(c, node->data.compound_assign.name);
   268	            break;
   269	        }
   270	        case NODE_RETURN: {
   271	            if (node->data.ret.value) compile_expr(c, node->data.ret.value);
   272	            else emit(c, BC_PUSH_INT, 0, NULL);
   273	            emit(c, BC_RET, 0, NULL);
   274	            break;
   275	        }
   276	        case NODE_PRINT: {
   277	            compile_expr(c, node->data.print.value);
   278	            emit(c, BC_PRINT, 0, NULL);
   279	            break;
   280	        }
   281	        case NODE_BLOCK: {
   282	            int old_lc = c->local_count;
   283	            c->scope_depth++;
   284	            for (int i = 0; i < node->data.block.stmts.count; i++)
   285	                compile_node(c, node->data.block.stmts.items[i]);
   286	            c->scope_depth--;
   287	            {
   288	                int n = c->local_count - old_lc;
   289	                for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
   290	            }
   291	            c->local_count = old_lc;
   292	            break;
   293	        }
   294	        case NODE_FUNC: {
   295	            int jump_over = emit(c, BC_JUMP, 0, NULL);
   296	
   297	            if (c->func_count >= MAX_FUNCTIONS) { fprintf(stderr, "too many functions\n"); return -1; }
   298	            FuncInfo *fi = &c->functions[c->func_count];
   299	            strncpy(fi->name, node->data.func.name, MAX_IDENT_LEN - 1);
   300	            fi->addr = c->code_count;
   301	            fi->param_count = node->data.func.param_count;
   302	            c->func_count++;
   303	
   304	            int old_lc = c->local_count;
   305	            int old_scope = c->scope_depth;
   306	            int old_inf = c->in_function;
   307	            int old_loop_depth = loop_depth;
   308	            loop_depth = 0;
   309	
   310	            c->local_count = 0;
   311	            c->scope_depth = 0;
   312	            c->in_function = 1;
   313	            c->scope_depth++;
   314	
   315	            for (int i = 0; i < node->data.func.param_count; i++)
   316	                add_local(c, node->data.func.params[i]);
   317	
   318	            compile_node(c, node->data.func.body);
   319	
   320	            emit(c, BC_PUSH_INT, 0, NULL);
   321	            emit(c, BC_RET, 0, NULL);
   322	
   323	            c->scope_depth = old_scope;
   324	            c->local_count = old_lc;
   325	            c->in_function = old_inf;
   326	            loop_depth = old_loop_depth;
   327	
   328	            c->code[jump_over].operand = c->code_count;
   329	            break;
   330	        }
   331	        case NODE_EXPR_STMT: {
   332	            compile_expr(c, node->data.expr_stmt.expr);
   333	            emit(c, BC_POP, 0, NULL);
   334	            break;
   335	        }
   336	        default:
   337	            compile_expr(c, node);
   338	            emit(c, BC_POP, 0, NULL);
   339	            break;
   340	    }
