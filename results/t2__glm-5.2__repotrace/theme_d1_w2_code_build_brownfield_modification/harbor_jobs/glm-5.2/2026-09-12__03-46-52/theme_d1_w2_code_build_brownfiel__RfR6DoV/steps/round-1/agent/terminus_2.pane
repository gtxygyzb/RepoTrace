   344	void compiler_init(Compiler *c) {
   345	    c->code_count = 0; c->local_count = 0; c->scope_depth = 0;
   346	    c->func_count = 0; c->in_function = 0;
   347	}
   348	
   349	int compile(Compiler *c, ASTNode *program) {
   350	    if (compile_node(c, program) < 0) return -1;
   351	    emit(c, BC_HALT, 0, NULL);
   352	    return 0;
   353	}
