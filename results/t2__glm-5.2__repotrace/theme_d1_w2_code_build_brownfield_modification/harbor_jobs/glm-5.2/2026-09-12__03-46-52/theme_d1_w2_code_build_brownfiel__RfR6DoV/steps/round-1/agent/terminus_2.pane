   258	                emit(c, BC_ARRAY_LEN, 0, NULL);
   259	                break;
   260	            }
   261	            if (strcmp(name, "keys") == 0) {
   262	                if (node->data.call.args.count != 1) { error_at(node->line, "keys() expects 1 argument"); return -1; }
   263	                compile_expr(c, node->data.call.args.items[0]);
   264	                emit(c, BC_MAP_KEYS, 0, NULL);
   265	                break;
   266	            }
   267	            if (strcmp(name, "delete") == 0) {
   268	                if (node->data.call.args.count != 2) { error_at(node->line, "delete() expects 2 arguments"); return -1; }
   269	                compile_expr(c, node->data.call.args.items[0]);
   270	                compile_expr(c, node->data.call.args.items[1]);
   271	                emit(c, BC_MAP_DELETE, 0, NULL);
   272	                break;
   273	            }
