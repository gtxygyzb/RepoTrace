   135	                }
   136	                push(vm, make_int(value_to_int(a) * value_to_int(b))); break; }
   137	            case BC_DIV: { Value b = pop(vm); Value a = pop(vm);
   138	                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {
