    37	        char name[MAX_IDENT_LEN];
    38	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\0';
    39	        int line = prev(p)->line;
    40	        if (match(p, TOK_LPAREN)) {
    41	            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;
    42	            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);
    43	            nodelist_init(&n->data.call.args);
