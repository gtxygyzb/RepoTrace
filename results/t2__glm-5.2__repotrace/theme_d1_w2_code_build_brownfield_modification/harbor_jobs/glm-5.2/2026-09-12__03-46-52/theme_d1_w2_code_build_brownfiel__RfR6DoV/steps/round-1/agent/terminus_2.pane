[?2004l#include "parser.h"

static Token *current(Parser *p) { return &p->tokens[p->pos]; }
static Token *prev(Parser *p) { return &p->tokens[p->pos - 1]; }
static int check(Parser *p, TokenType t) { return current(p)->type == t; }

static int match(Parser *p, TokenType t) {
    if (check(p, t)) { p->pos++; return 1; }
    return 0;
}

static void expect(Parser *p, TokenType t, const char *msg) {
    if (!match(p, t)) {
        error_at(current(p)->line, "expected %s, got '%s'", msg, current(p)->text);
        p->had_error = 1;
    }
}

static ASTNode *parse_expr(Parser *p);
static ASTNode *parse_stmt(Parser *p);
static ASTNode *parse_block(Parser *p);
static ASTNode *parse_factor(Parser *p);
static ASTNode *parse_term(Parser *p);
static ASTNode *parse_comparison(Parser *p);
static ASTNode *parse_logic_and(Parser *p);

static ASTNode *parse_primary(Parser *p) {
    if (match(p, TOK_NUM)) {
        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;
        n->data.num_val = prev(p)->literal.ival; return n;
    }
    if (match(p, TOK_STRING)) {
        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;
        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return n;
    }
    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {
        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;
        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;
    }
    if (match(p, TOK_IDENT)) {
        char name[MAX_IDENT_LEN];
        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\0';
        int line = prev(p)->line;
        if (match(p, TOK_LPAREN)) {
            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;
            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);
            nodelist_init(&n->data.call.args);
            if (!check(p, TOK_RPAREN)) {
                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));
            }
            expect(p, TOK_RPAREN, "')'"); return n;
        }
        if (match(p, TOK_LBRACKET)) {
            ASTNode *idx = parse_expr(p); expect(p, TOK_RBRACKET, "']'");
            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;
            ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;
            strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);
            n->data.index_access.obj = obj; n->data.index_access.index = idx; return n;
        }
        ASTNode *n = ast_alloc(); n->type = NODE_IDENT; n->line = line;
        strncpy(n->data.ident, name, MAX_IDENT_LEN - 1); return n;
    }
    if (match(p, TOK_LBRACKET)) {
        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;
        nodelist_init(&n->data.array_lit.elems);
        if (!check(p, TOK_RBRACKET)) {
            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));
        }
        expect(p, TOK_RBRACKET, "']'"); return n;
    }
    if (match(p, TOK_LPAREN)) {
        ASTNode *expr = parse_expr(p); expect(p, TOK_RPAREN, "')'"); return expr;
    }
    error_at(current(p)->line, "unexpected token '%s'", current(p)->text);
    p->had_error = 1; p->pos++; return ast_alloc();
}

static ASTNode *parse_unary(Parser *p) {
    if (match(p, TOK_MINUS)) {
        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;
    }
    if (match(p, TOK_NOT)) {
        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;
    }
    return parse_primary(p);
}

static ASTNode *parse_factor(Parser *p) {
    ASTNode *left = parse_unary(p);
    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {
        int line = prev(p)->line; BinOp op;
        if (prev(p)->type == TOK_STAR) op = OP_MUL;
        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;
        else op = OP_MOD;
        ASTNode *right = parse_unary(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *parse_comparison(Parser *p) {
    ASTNode *left = parse_term(p);
    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||
           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {
        int line = prev(p)->line; BinOp op;
        switch (prev(p)->type) {
            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;
            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;
            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;
            default: op = OP_EQ; break;
        }
        ASTNode *right = parse_term(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *parse_term(Parser *p) {
    ASTNode *left = parse_factor(p);
    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {
        int line = prev(p)->line;
        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;
        ASTNode *right = parse_factor(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *parse_logic_and(Parser *p) {
    ASTNode *left = parse_comparison(p);
    while (match(p, TOK_AND)) {
        int line = prev(p)->line; ASTNode *right = parse_comparison(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *parse_expr(Parser *p) {
    ASTNode *left = parse_logic_and(p);
    while (match(p, TOK_OR)) {
        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);
        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;
        left = n;
    }
    return left;
}

static ASTNode *try_parse_assign(Parser *p) {
    if (!check(p, TOK_IDENT)) return NULL;
    int saved = p->pos;
    p->pos++;
    if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||
        check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {
        p->pos = saved; match(p, TOK_IDENT);
        char name[MAX_IDENT_LEN];
        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
        int line = prev(p)->line;
        TokenType op_tok = current(p)->type;
        BinOp op = OP_ADD;
        const char *msg = "'='";
        if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = "'+='"; expect(p, TOK_PLUS_ASSIGN, "'+='"); }
        else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = "'-='"; expect(p, TOK_MINUS_ASSIGN, "'-='"); }
        else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = "'*='"; expect(p, TOK_STAR_ASSIGN, "'*='"); }
        else if (op_tok == TOK_SLASH_ASSIGN) { op = OP_DIV; msg = "'/='"; expect(p, TOK_SLASH_ASSIGN, "'/='"); }
        else if (op_tok == TOK_PERCENT_ASSIGN) { op = OP_MOD; msg = "'%='"; expect(p, TOK_PERCENT_ASSIGN, "'%='"); }
        else { expect(p, TOK_ASSIGN, "'='"); }
        ASTNode *val = parse_expr(p);
        if (op_tok == TOK_ASSIGN) {
            ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;
            strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);
            n->data.assign.value = val; return n;
        } else {
            ASTNode *n = ast_alloc(); n->type = NODE_COMPOUND_ASSIGN; n->line = line;
            strncpy(n->data.compound_assign.name, name, MAX_IDENT_LEN - 1);
            n->data.compound_assign.op = op;
            n->data.compound_assign.value = val; return n;
        }
    }
    p->pos = saved; return NULL;
}

static ASTNode *parse_for(Parser *p) {
    int line = prev(p)->line;
    expect(p, TOK_LPAREN, "'('");

    if (check(p, TOK_IDENT) && p->pos + 1 < p->count && p->tokens[p->pos + 1].type == TOK_IN) {
        char name[MAX_IDENT_LEN];
        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
        match(p, TOK_IDENT);
        match(p, TOK_IN);
        ASTNode *arr = parse_expr(p);
        expect(p, TOK_RPAREN, "')'");
        ASTNode *body = parse_block(p);
        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;
        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);
        n->data.foreach_stmt.arr = arr;
        n->data.foreach_stmt.body = body;
        return n;
    }

    ASTNode *init = NULL;
    if (match(p, TOK_LET)) {
        expect(p, TOK_IDENT, "identifier");
        char name[MAX_IDENT_LEN];
        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
        expect(p, TOK_ASSIGN, "'='");
        ASTNode *init_expr = parse_expr(p);
        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;
        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);
        init->data.let.init = init_expr;
    } else if (check(p, TOK_IDENT)) {
        init = try_parse_assign(p);
        if (!init) init = parse_expr(p);
    } else if (!check(p, TOK_SEMICOLON)) {
        init = parse_expr(p);
    }
    expect(p, TOK_SEMICOLON, "';'");

    ASTNode *cond = NULL;
    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);
    expect(p, TOK_SEMICOLON, "';'");

    ASTNode *step = NULL;
    if (!check(p, TOK_RPAREN)) {
        if (check(p, TOK_IDENT)) {
            step = try_parse_assign(p);
        }
        if (!step) step = parse_expr(p);
    }
    expect(p, TOK_RPAREN, "')'");

    ASTNode *body = parse_block(p);
    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;
    n->data.for_stmt.init = init;
    n->data.for_stmt.cond = cond;
    n->data.for_stmt.step = step;
    n->data.for_stmt.body = body;
    return n;
}

static ASTNode *parse_block(Parser *p) {
