   140	                    return -1;
   141	                }
   142	                if (value_to_int(b) == 0) { fprintf(stderr, "division by zero\n"); return -1; }
   143	                push(vm, make_int(value_to_int(a) / value_to_int(b))); break; }
   144	            case BC_MOD: { Value b = pop(vm); Value a = pop(vm);
