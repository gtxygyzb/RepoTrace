   182	            ASTNode *n = ast_alloc(); n->type = NODE_COMPOUND_ASSIGN; n->line = line;
   183	            strncpy(n->data.compound_assign.name, name, MAX_IDENT_LEN - 1);
   184	            n->data.compound_assign.op = op;
   185	            n->data.compound_assign.value = val; return n;
   186	        }
   187	    }
   188	    p->pos = saved; return NULL;
   189	}
