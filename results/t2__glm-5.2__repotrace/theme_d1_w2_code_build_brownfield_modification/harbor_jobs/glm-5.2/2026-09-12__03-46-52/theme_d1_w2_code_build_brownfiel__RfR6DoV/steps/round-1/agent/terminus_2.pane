    80	                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;
    81	                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;
    82	                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
    83	                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
    84	                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
    85	                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;
    86	                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;
    87	                case OP_LT:  emit(c, BC_LT, 0, NULL); break;
    88	                case OP_GT:  emit(c, BC_GT, 0, NULL); break;
    89	                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;
    90	                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;
    91	                case OP_AND: emit(c, BC_AND, 0, NULL); break;
    92	                case OP_OR:  emit(c, BC_OR, 0, NULL); break;
    93	            }
    94	            break;
    95	        case NODE_UNARY:
    96	            compile_expr(c, node->data.unary.operand);
    97	            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);
    98	            else emit(c, BC_NOT, 0, NULL);
