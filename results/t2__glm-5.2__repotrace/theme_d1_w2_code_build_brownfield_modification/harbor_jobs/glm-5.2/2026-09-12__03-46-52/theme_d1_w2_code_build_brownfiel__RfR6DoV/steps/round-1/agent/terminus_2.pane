   379	    if (match(p, TOK_LET)) {
   380	        int line = prev(p)->line;
   381	        expect(p, TOK_IDENT, "identifier");
   382	        char name[MAX_IDENT_LEN];
   383	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   384	        expect(p, TOK_ASSIGN, "'='");
   385	        ASTNode *init = parse_expr(p);
   386	        expect(p, TOK_SEMICOLON, "';'");
   387	        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;
   388	        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);
   389	        n->data.let.init = init; return n;
   390	    }
   391	    if (match(p, TOK_IF)) {
   392	        int line = prev(p)->line;
   393	        expect(p, TOK_LPAREN, "'('");
   394	        ASTNode *cond = parse_expr(p);
   395	        expect(p, TOK_RPAREN, "')'");
   396	        ASTNode *then_b = parse_block(p);
   397	        ASTNode *else_b = NULL;
   398	        if (match(p, TOK_ELSE)) {
   399	            if (check(p, TOK_IF)) {
   400	                ASTNode *elif = parse_stmt(p);
   401	                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;
   402	                nodelist_init(&else_b->data.block.stmts);
   403	                nodelist_push(&else_b->data.block.stmts, elif);
   404	            } else {
   405	                else_b = parse_block(p);
   406	            }
   407	        }
   408	        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;
   409	        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;
   410	        return n;
   411	    }
   412	    if (match(p, TOK_WHILE)) {
   413	        int line = prev(p)->line;
   414	        expect(p, TOK_LPAREN, "'('");
   415	        ASTNode *cond = parse_expr(p);
   416	        expect(p, TOK_RPAREN, "')'");
   417	        ASTNode *body = parse_block(p);
   418	        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;
   419	        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;
   420	    }
   421	    if (match(p, TOK_RETURN)) {
   422	        int line = prev(p)->line;
   423	        ASTNode *value = NULL;
   424	        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);
   425	        expect(p, TOK_SEMICOLON, "';'");
   426	        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;
   427	        n->data.ret.value = value; return n;
   428	    }
   429	    if (match(p, TOK_FOR)) {
   430	        return parse_for(p);
   431	    }
   432	    if (match(p, TOK_BREAK)) {
   433	        int line = prev(p)->line;
   434	        expect(p, TOK_SEMICOLON, "';'");
   435	        ASTNode *n = ast_alloc(); n->type = NODE_BREAK; n->line = line; return n;
   436	    }
   437	    if (match(p, TOK_CONTINUE)) {
   438	        int line = prev(p)->line;
   439	        expect(p, TOK_SEMICOLON, "';'");
   440	        ASTNode *n = ast_alloc(); n->type = NODE_CONTINUE; n->line = line; return n;
   441	    }
   442	    if (match(p, TOK_PRINT)) {
   443	        int line = prev(p)->line;
   444	        ASTNode *value = parse_expr(p);
   445	        expect(p, TOK_SEMICOLON, "';'");
   446	        ASTNode *n = ast_alloc(); n->type = NODE_PRINT; n->line = line;
   447	        n->data.print.value = value; return n;
   448	    }
   449	    if (match(p, TOK_FN)) {
   450	        int line = prev(p)->line;
   451	        expect(p, TOK_IDENT, "function name");
   452	        char name[MAX_IDENT_LEN];
   453	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   454	        expect(p, TOK_LPAREN, "'('");
   455	        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;
   456	        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);
   457	        n->data.func.param_count = 0;
   458	        if (!check(p, TOK_RPAREN)) {
   459	            do {
   460	                expect(p, TOK_IDENT, "parameter name");
   461	                strncpy(n->data.func.params[n->data.func.param_count],
   462	                        prev(p)->text, MAX_IDENT_LEN - 1);
   463	                n->data.func.param_count++;
   464	            } while (match(p, TOK_COMMA));
   465	        }
   466	        expect(p, TOK_RPAREN, "')'");
   467	        n->data.func.body = parse_block(p); return n;
   468	    }
   469	    if (check(p, TOK_IDENT)) {
   470	        ASTNode *a = try_parse_assign(p);
   471	        if (a) { expect(p, TOK_SEMICOLON, "';'"); return a; }
   472	    }
   473	    ASTNode *expr = parse_expr(p);
   474	    expect(p, TOK_SEMICOLON, "';'");
   475	    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;
   476	    n->data.expr_stmt.expr = expr; return n;
   477	}
