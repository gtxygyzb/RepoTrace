    52	
    53	static int resolve_global(VM *vm, const char *name) {
    54	    for (int i = 0; i < vm->global_count; i++)
    55	        if (strcmp(vm->global_names[i], name) == 0) return i;
    56	    return -1;
    57	}
    58	
    59	static int add_global(VM *vm, const char *name) {
    60	    if (vm->global_count >= MAX_GLOBALS) { fprintf(stderr, "too many globals\n"); return -1; }
    61	    int idx = vm->global_count;
    62	    strncpy(vm->global_names[idx], name, MAX_IDENT_LEN - 1);
    63	    vm->globals[idx].type = VAL_NULL;
    64	    vm->global_count++;
    65	    return idx;
    66	}
