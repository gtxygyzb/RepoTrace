   232	static ASTNode *parse_for(Parser *p) {
   233	    int line = prev(p)->line;
   234	    expect(p, TOK_LPAREN, "'('");
   235	
   236	    if (check(p, TOK_IDENT) && p->pos + 1 < p->count && p->tokens[p->pos + 1].type == TOK_IN) {
   237	        char name[MAX_IDENT_LEN];
   238	        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   239	        match(p, TOK_IDENT);
   240	        match(p, TOK_IN);
   241	        ASTNode *arr = parse_expr(p);
   242	        expect(p, TOK_RPAREN, "')'");
   243	        ASTNode *body = parse_block(p);
   244	        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;
   245	        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);
   246	        n->data.foreach_stmt.arr = arr;
   247	        n->data.foreach_stmt.body = body;
   248	        return n;
   249	    }
   250	
   251	    ASTNode *init = NULL;
   252	    if (match(p, TOK_LET)) {
   253	        expect(p, TOK_IDENT, "identifier");
   254	        char name[MAX_IDENT_LEN];
   255	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   256	        expect(p, TOK_ASSIGN, "'='");
   257	        ASTNode *init_expr = parse_expr(p);
   258	        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;
   259	        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);
   260	        init->data.let.init = init_expr;
   261	    } else if (check(p, TOK_IDENT)) {
   262	        init = try_parse_assign(p);
   263	        if (!init) init = parse_expr(p);
   264	    } else if (!check(p, TOK_SEMICOLON)) {
   265	        init = parse_expr(p);
   266	    }
   267	    expect(p, TOK_SEMICOLON, "';'");
