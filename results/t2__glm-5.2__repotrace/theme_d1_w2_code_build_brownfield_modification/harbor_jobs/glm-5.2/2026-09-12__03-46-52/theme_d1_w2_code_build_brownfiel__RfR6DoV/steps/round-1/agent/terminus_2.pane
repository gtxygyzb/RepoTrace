    41	    }
    42	    if (match(p, TOK_IDENT)) {
    43	        char name[MAX_IDENT_LEN];
    44	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\0';
    45	        int line = prev(p)->line;
    46	        if (match(p, TOK_LPAREN)) {
    47	            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;
