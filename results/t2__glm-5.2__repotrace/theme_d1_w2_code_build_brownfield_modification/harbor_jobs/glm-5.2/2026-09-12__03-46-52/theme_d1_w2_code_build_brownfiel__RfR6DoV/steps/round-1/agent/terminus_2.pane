    38	static void compile_load(Compiler *c, const char *name) {
    39	    int slot = resolve_local(c, name);
    40	    if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);
    41	    else emit(c, BC_LOAD_GLOBAL, 0, strdup(name));
    42	}
