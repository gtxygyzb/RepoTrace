    60	static int compile_expr(Compiler *c, ASTNode *node) {
    61	    switch (node->type) {
    62	        case NODE_NUM_LIT:
    63	            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;
    64	        case NODE_STR_LIT: {
    65	            char *s = strdup(node->data.str_val);
    66	            emit(c, BC_PUSH_STR, 0, s); break;
