    23	static ASTNode *parse_primary(Parser *p) {
    24	    if (match(p, TOK_NUM)) {
    25	        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;
    26	        n->data.num_val = prev(p)->literal.ival; return n;
    27	    }
    28	    if (match(p, TOK_STRING)) {
    29	        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;
    30	        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return n;
    31	    }
    32	    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {
    33	        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;
    34	        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;
    35	    }
    36	    if (match(p, TOK_IDENT)) {
    37	        char name[MAX_IDENT_LEN];
    38	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\0';
    39	        int line = prev(p)->line;
    40	        if (match(p, TOK_LPAREN)) {
    41	            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;
    42	            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);
    43	            nodelist_init(&n->data.call.args);
    44	            if (!check(p, TOK_RPAREN)) {
    45	                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));
    46	            }
    47	            expect(p, TOK_RPAREN, "')'"); return n;
    48	        }
    49	        if (match(p, TOK_LBRACKET)) {
    50	            ASTNode *idx = parse_expr(p); expect(p, TOK_RBRACKET, "']'");
    51	            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;
    52	            ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;
    53	            strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);
    54	            n->data.index_access.obj = obj; n->data.index_access.index = idx; return n;
    55	        }
    56	        ASTNode *n = ast_alloc(); n->type = NODE_IDENT; n->line = line;
    57	        strncpy(n->data.ident, name, MAX_IDENT_LEN - 1); return n;
    58	    }
    59	    if (match(p, TOK_LBRACKET)) {
    60	        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;
    61	        nodelist_init(&n->data.array_lit.elems);
    62	        if (!check(p, TOK_RBRACKET)) {
    63	            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));
    64	        }
