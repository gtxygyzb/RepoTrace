   287	                nodelist_init(&else_b->data.block.stmts);
   288	                nodelist_push(&else_b->data.block.stmts, elif);
   289	            } else {
   290	                else_b = parse_block(p);
   291	            }
   292	        }
   293	        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;
