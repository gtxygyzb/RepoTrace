[?2004l#include "vm.h"
#include <string.h>

static void push(VM *vm, Value v) {
    if (vm->sp >= MAX_STACK) { fprintf(stderr, "stack overflow\n"); exit(1); }
    vm->stack[vm->sp++] = v;
}

static Value pop(VM *vm) {
    if (vm->sp <= 0) { fprintf(stderr, "stack underflow\n"); exit(1); }
    return vm->stack[--vm->sp];
}

static Value make_int(int64_t v) { Value val; val.type = VAL_INT; val.data.ival = v; return val; }
static Value make_str(const char *s) { Value val; val.type = VAL_STR; val.data.sval = strdup(s); return val; }
static Value make_str_n(const char *s, size_t n) {
    char *buf = malloc(n + 1);
    memcpy(buf, s, n); buf[n] = '\0';
    Value val; val.type = VAL_STR; val.data.sval = buf; return val;
}
static Value make_bool(int b) { Value val; val.type = VAL_BOOL; val.data.bval = b; return val; }

static Value make_map(void) {
    Value val; val.type = VAL_MAP; val.data.map = malloc(sizeof(MapData));
    val.data.map->keys = NULL; val.data.map->values = NULL; val.data.map->len = 0; val.data.map->cap = 0;
    return val;
}

static int map_find(MapData *m, const char *key) {
    for (int i = 0; i < m->len; i++) if (strcmp(m->keys[i], key) == 0) return i;
    return -1;
}

static void map_set(MapData *m, const char *key, Value v) {
    int i = map_find(m, key);
    if (i >= 0) { m->values[i] = v; return; }
    if (m->len >= m->cap) {
        int cap = m->cap == 0 ? 8 : m->cap * 2;
        m->keys = realloc(m->keys, cap * sizeof(char*));
        m->values = realloc(m->values, cap * sizeof(Value));
        m->cap = cap;
    }
    m->keys[m->len] = strdup(key);
    m->values[m->len] = v;
    m->len++;
}

static int map_delete(MapData *m, const char *key) {
    int i = map_find(m, key);
    if (i < 0) return 0;
    free(m->keys[i]);
    for (int j = i; j < m->len - 1; j++) { m->keys[j] = m->keys[j+1]; m->values[j] = m->values[j+1]; }
    m->len--;
    return 1;
}


static int resolve_global(VM *vm, const char *name) {
    for (int i = 0; i < vm->global_count; i++)
        if (strcmp(vm->global_names[i], name) == 0) return i;
    return -1;
}

static int add_global(VM *vm, const char *name) {
    if (vm->global_count >= MAX_GLOBALS) { fprintf(stderr, "too many globals\n"); return -1; }
    int idx = vm->global_count;
    strncpy(vm->global_names[idx], name, MAX_IDENT_LEN - 1);
    vm->globals[idx].type = VAL_NULL;
    vm->global_count++;
    return idx;
}

static int64_t value_to_int(Value v) {
    if (v.type == VAL_REF) return value_to_int(*v.data.ref);
    switch (v.type) { case VAL_INT: return v.data.ival; case VAL_BOOL: return v.data.bval ? 1 : 0; default: return 0; }
}

static int value_is_integer_like(Value v) {
    if (v.type == VAL_REF) return value_is_integer_like(*v.data.ref);
    return v.type == VAL_INT || v.type == VAL_BOOL;
}

static int value_truthy(Value v) {
    if (v.type == VAL_REF) return value_truthy(*v.data.ref);
    switch (v.type) {
        case VAL_INT: return v.data.ival != 0;
        case VAL_BOOL: return v.data.bval;
        case VAL_STR: return v.data.sval && v.data.sval[0] != '\0';
        case VAL_ARRAY: return v.data.array.len > 0;
        case VAL_MAP: return v.data.map && v.data.map->len > 0;
        case VAL_NULL: return 0;
    }
    return 0;
}

static int values_equal(Value a, Value b) {
    if (a.type == VAL_REF) return values_equal(*a.data.ref, b);
    if (b.type == VAL_REF) return values_equal(a, *b.data.ref);
    if (a.type != b.type) return 0;
    switch (a.type) {
        case VAL_INT: return a.data.ival == b.data.ival;
        case VAL_BOOL: return a.data.bval == b.data.bval;
        case VAL_STR: return strcmp(a.data.sval, b.data.sval) == 0;
        case VAL_NULL: return 1;
        default: return 0;
    }
}

static const char *value_to_cstr(Value v, char *buf, size_t size) {
    if (v.type == VAL_REF) return value_to_cstr(*v.data.ref, buf, size);
    switch (v.type) {
        case VAL_STR: return v.data.sval;
        case VAL_INT: snprintf(buf, size, "%lld", (long long)v.data.ival); return buf;
        case VAL_BOOL: return v.data.bval ? "true" : "false";
        case VAL_NULL: return "null";
        default: return "";
    }
}

