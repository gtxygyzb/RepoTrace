   303	static ASTNode *parse_for(Parser *p) {
   304	    int line = prev(p)->line;
   305	    expect(p, TOK_LPAREN, "'('");
   306	
   307	    if (check(p, TOK_IDENT) && p->pos + 1 < p->count &&
   308	        (p->tokens[p->pos + 1].type == TOK_IN || p->tokens[p->pos + 1].type == TOK_OF)) {
   309	        char name[MAX_IDENT_LEN];
   310	        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   311	        match(p, TOK_IDENT);
   312	        int is_of = match(p, TOK_OF);
   313	        if (!is_of) match(p, TOK_IN);
   314	        ASTNode *arr = parse_expr(p);
   315	        expect(p, TOK_RPAREN, "')'");
   316	        ASTNode *body = parse_block(p);
   317	        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;
   318	        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);
   319	        n->data.foreach_stmt.arr = arr;
   320	        n->data.foreach_stmt.body = body;
   321	        n->data.foreach_stmt.is_of = is_of;
   322	        return n;
   323	    }
   324	
   325	    ASTNode *init = NULL;
   326	    if (match(p, TOK_LET)) {
   327	        expect(p, TOK_IDENT, "identifier");
   328	        char name[MAX_IDENT_LEN];
   329	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   330	        expect(p, TOK_ASSIGN, "'='");
   331	        ASTNode *init_expr = parse_expr(p);
   332	        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;
   333	        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);
   334	        init->data.let.init = init_expr;
   335	    } else if (check(p, TOK_IDENT)) {
   336	        init = try_parse_assign(p);
   337	        if (!init) init = parse_expr(p);
   338	    } else if (!check(p, TOK_SEMICOLON)) {
   339	        init = parse_expr(p);
   340	    }
   341	    expect(p, TOK_SEMICOLON, "';'");
   342	
   343	    ASTNode *cond = NULL;
   344	    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);
   345	    expect(p, TOK_SEMICOLON, "';'");
   346	
   347	    ASTNode *step = NULL;
   348	    if (!check(p, TOK_RPAREN)) {
   349	        if (check(p, TOK_IDENT)) {
   350	            step = try_parse_assign(p);
   351	        }
   352	        if (!step) step = parse_expr(p);
   353	    }
   354	    expect(p, TOK_RPAREN, "')'");
   355	
   356	    ASTNode *body = parse_block(p);
   357	    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;
   358	    n->data.for_stmt.init = init;
   359	    n->data.for_stmt.cond = cond;
   360	    n->data.for_stmt.step = step;
   361	    n->data.for_stmt.body = body;
   362	    return n;
   363	}
   364	
   365	static ASTNode *parse_block(Parser *p) {
   366	    expect(p, TOK_LBRACE, "'{'");
   367	    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;
   368	    nodelist_init(&block->data.block.stmts);
   369	    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {
   370	        ASTNode *stmt = parse_stmt(p);
   371	        if (stmt) nodelist_push(&block->data.block.stmts, stmt);
   372	        if (p->had_error) break;
   373	    }
   374	    expect(p, TOK_RBRACE, "'}'");
   375	    return block;
   376	}
   377	
   378	static ASTNode *parse_stmt(Parser *p) {
   379	    if (match(p, TOK_LET)) {
   380	        int line = prev(p)->line;
   381	        expect(p, TOK_IDENT, "identifier");
   382	        char name[MAX_IDENT_LEN];
   383	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   384	        expect(p, TOK_ASSIGN, "'='");
   385	        ASTNode *init = parse_expr(p);
   386	        expect(p, TOK_SEMICOLON, "';'");
   387	        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;
   388	        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);
   389	        n->data.let.init = init; return n;
   390	    }
