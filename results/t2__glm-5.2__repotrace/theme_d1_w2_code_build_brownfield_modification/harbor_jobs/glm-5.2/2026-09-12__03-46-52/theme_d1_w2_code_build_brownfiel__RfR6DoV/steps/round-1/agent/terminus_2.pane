[?2004l     1	#include "vm.h"
     2	#include <string.h>
     3	
     4	static void push(VM *vm, Value v) {
     5	    if (vm->sp >= MAX_STACK) { fprintf(stderr, "stack overflow\n"); exit(1); }
     6	    vm->stack[vm->sp++] = v;
     7	}
     8	
     9	static Value pop(VM *vm) {
    10	    if (vm->sp <= 0) { fprintf(stderr, "stack underflow\n"); exit(1); }
    11	    return vm->stack[--vm->sp];
    12	}
    13	
    14	static Value make_int(int64_t v) { Value val; val.type = VAL_INT; val.data.ival = v; return val; }
    15	static Value make_str(const char *s) { Value val; val.type = VAL_STR; val.data.sval = strdup(s); return val; }
    16	static Value make_bool(int b) { Value val; val.type = VAL_BOOL; val.data.bval = b; return val; }
    17	
    18	static int resolve_global(VM *vm, const char *name) {
    19	    for (int i = 0; i < vm->global_count; i++)
    20	        if (strcmp(vm->global_names[i], name) == 0) return i;
    21	    return -1;
    22	}
    23	
    24	static int add_global(VM *vm, const char *name) {
    25	    if (vm->global_count >= MAX_GLOBALS) { fprintf(stderr, "too many globals\n"); return -1; }
    26	    int idx = vm->global_count;
    27	    strncpy(vm->global_names[idx], name, MAX_IDENT_LEN - 1);
    28	    vm->globals[idx].type = VAL_NULL;
    29	    vm->global_count++;
    30	    return idx;
    31	}
    32	
    33	static int64_t value_to_int(Value v) {
    34	    switch (v.type) { case VAL_INT: return v.data.ival; case VAL_BOOL: return v.data.bval ? 1 : 0; default: return 0; }
    35	}
    36	
    37	static int value_is_integer_like(Value v) {
    38	    return v.type == VAL_INT || v.type == VAL_BOOL;
    39	}
    40	
    41	static int value_truthy(Value v) {
    42	    switch (v.type) {
    43	        case VAL_INT: return v.data.ival != 0;
    44	        case VAL_BOOL: return v.data.bval;
    45	        case VAL_STR: return v.data.sval && v.data.sval[0] != '\0';
    46	        case VAL_ARRAY: return v.data.array.len > 0;
    47	        case VAL_NULL: return 0;
    48	    }
    49	    return 0;
    50	}
    51	
    52	static int values_equal(Value a, Value b) {
    53	    if (a.type != b.type) return 0;
    54	    switch (a.type) {
    55	        case VAL_INT: return a.data.ival == b.data.ival;
    56	        case VAL_BOOL: return a.data.bval == b.data.bval;
    57	        case VAL_STR: return strcmp(a.data.sval, b.data.sval) == 0;
    58	        case VAL_NULL: return 1;
    59	        default: return 0;
    60	    }
    61	}
    62	
    63	static void print_value(Value v) {
    64	    switch (v.type) {
    65	        case VAL_INT: printf("%lld", (long long)v.data.ival); break;
    66	        case VAL_BOOL: printf("%s", v.data.bval ? "true" : "false"); break;
    67	        case VAL_STR: printf("%s", v.data.sval); break;
    68	        case VAL_ARRAY:
    69	            printf("[");
    70	            for (int i = 0; i < v.data.array.len; i++) {
    71	                if (i > 0) printf(", ");
    72	                print_value(v.data.array.items[i]);
    73	            }
    74	            printf("]");
    75	            break;
    76	        case VAL_NULL: printf("null"); break;
    77	    }
    78	}
    79	
    80	void vm_init(VM *vm, Compiler *c) {
    81	    vm->sp = 0; vm->frame_count = 0; vm->global_count = 0;
    82	    vm->code = c->code; vm->code_count = c->code_count;
    83	    vm->functions = c->functions; vm->func_count = c->func_count;
    84	    vm->ip = 0;
    85	}
    86	
    87	int vm_run(VM *vm) {
    88	    while (vm->ip < vm->code_count) {
    89	        Instruction *ins = &vm->code[vm->ip++];
    90	        switch (ins->op) {
    91	            case BC_PUSH_INT: push(vm, make_int(ins->operand)); break;
    92	            case BC_PUSH_STR: push(vm, make_str(ins->str_operand)); break;
    93	            case BC_PUSH_BOOL: push(vm, make_bool((int)ins->operand)); break;
    94	            case BC_LOAD_LOCAL: {
    95	                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;
    96	                push(vm, vm->stack[base + (int)ins->operand]);
    97	                break;
    98	            }
    99	            case BC_STORE_LOCAL: {
   100	                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;
   101	                vm->stack[base + (int)ins->operand] = pop(vm);
   102	                break;
   103	            }
   104	            case BC_LOAD_GLOBAL: {
   105	                int idx = resolve_global(vm, ins->str_operand);
