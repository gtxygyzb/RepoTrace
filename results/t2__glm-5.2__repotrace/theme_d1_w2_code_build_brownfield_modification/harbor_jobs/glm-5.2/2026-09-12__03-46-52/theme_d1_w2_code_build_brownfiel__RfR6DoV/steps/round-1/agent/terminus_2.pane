   122	static ASTNode *parse_term(Parser *p) {
   123	    ASTNode *left = parse_factor(p);
   124	    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {
   125	        int line = prev(p)->line;
   126	        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;
   127	        ASTNode *right = parse_factor(p);
   128	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   129	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   130	        left = n;
   131	    }
   132	    return left;
   133	}
   134	
   135	static ASTNode *parse_logic_and(Parser *p) {
   136	    ASTNode *left = parse_term(p);
   137	    while (match(p, TOK_AND)) {
   138	        int line = prev(p)->line; ASTNode *right = parse_term(p);
   139	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   140	        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;
   141	        left = n;
   142	    }
   143	    return left;
   144	}
   145	
   146	static ASTNode *parse_expr(Parser *p) {
   147	    ASTNode *left = parse_logic_and(p);
   148	    while (match(p, TOK_OR)) {
   149	        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);
   150	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   151	        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;
   152	        left = n;
   153	    }
   154	    return left;
   155	}
