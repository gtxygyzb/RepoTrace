    91	static int values_equal(Value a, Value b) {
    92	    if (a.type == VAL_REF) return values_equal(*a.data.ref, b);
    93	    if (b.type == VAL_REF) return values_equal(a, *b.data.ref);
    94	    if (a.type != b.type) return 0;
    95	    switch (a.type) {
    96	        case VAL_INT: return a.data.ival == b.data.ival;
    97	        case VAL_BOOL: return a.data.bval == b.data.bval;
    98	        case VAL_STR: return strcmp(a.data.sval, b.data.sval) == 0;
    99	        case VAL_NULL: return 1;
   100	        default: return 0;
   101	    }
   102	}
   103	
   104	static const char *value_to_cstr(Value v, char *buf, size_t size) {
   105	    if (v.type == VAL_REF) return value_to_cstr(*v.data.ref, buf, size);
   106	    switch (v.type) {
   107	        case VAL_STR: return v.data.sval;
   108	        case VAL_INT: snprintf(buf, size, "%lld", (long long)v.data.ival); return buf;
   109	        case VAL_BOOL: return v.data.bval ? "true" : "false";
   110	        case VAL_NULL: return "null";
   111	        default: return "";
   112	    }
   113	}
   114	
   115	static const char *value_to_key(Value v, char *buf, size_t size) {
   116	    if (v.type == VAL_STR) return v.data.sval;
   117	    return value_to_cstr(v, buf, size);
   118	}
