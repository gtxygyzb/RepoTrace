   109	    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||
   110	           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {
   111	        int line = prev(p)->line; BinOp op;
   112	        switch (prev(p)->type) {
   113	            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;
   114	            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;
   115	            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;
   116	            default: op = OP_EQ; break;
   117	        }
   118	        ASTNode *right = parse_term(p);
   119	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   120	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   121	        left = n;
   122	    }
   123	    return left;
   124	}
   125	
   126	static ASTNode *parse_term(Parser *p) {
   127	    ASTNode *left = parse_factor(p);
   128	    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {
   129	        int line = prev(p)->line;
   130	        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;
   131	        ASTNode *right = parse_factor(p);
   132	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   133	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   134	        left = n;
   135	    }
   136	    return left;
   137	}
   138	
   139	static ASTNode *parse_logic_and(Parser *p) {
   140	    ASTNode *left = parse_comparison(p);
   141	    while (match(p, TOK_AND)) {
   142	        int line = prev(p)->line; ASTNode *right = parse_comparison(p);
   143	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   144	        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;
   145	        left = n;
   146	    }
   147	    return left;
   148	}
   149	
   150	static ASTNode *parse_expr(Parser *p) {
   151	    ASTNode *left = parse_logic_and(p);
   152	    while (match(p, TOK_OR)) {
   153	        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);
   154	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   155	        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;
   156	        left = n;
   157	    }
   158	    return left;
   159	}
