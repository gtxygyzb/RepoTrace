    69	            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;
    70	        case NODE_IDENT: {
    71	            int slot = resolve_local(c, node->data.ident);
    72	            if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);
    73	            else emit(c, BC_LOAD_GLOBAL, 0, strdup(node->data.ident));
    74	            break;
    75	        }
    76	        case NODE_BINOP:
    77	            compile_expr(c, node->data.binop.left);
    78	            compile_expr(c, node->data.binop.right);
    79	            switch (node->data.binop.op) {
    80	                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;
    81	                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;
    82	                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;
    83	                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;
    84	                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;
    85	                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;
    86	                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;
    87	                case OP_LT:  emit(c, BC_LT, 0, NULL); break;
    88	                case OP_GT:  emit(c, BC_GT, 0, NULL); break;
    89	                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;
    90	                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;
    91	                case OP_AND: emit(c, BC_AND, 0, NULL); break;
    92	                case OP_OR:  emit(c, BC_OR, 0, NULL); break;
    93	            }
    94	            break;
    95	        case NODE_UNARY:
    96	            compile_expr(c, node->data.unary.operand);
    97	            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);
    98	            else emit(c, BC_NOT, 0, NULL);
    99	            break;
   100	        case NODE_CALL: {
   101	            int fi = find_function(c, node->data.call.name);
   102	            if (fi < 0) { error_at(node->line, "undefined function '%s'", node->data.call.name); return -1; }
   103	            for (int i = 0; i < node->data.call.args.count; i++)
   104	                compile_expr(c, node->data.call.args.items[i]);
   105	            emit(c, BC_CALL, fi, NULL);
   106	            break;
   107	        }
   108	        case NODE_INDEX:
   109	            compile_expr(c, node->data.index_access.obj);
   110	            compile_expr(c, node->data.index_access.index);
   111	            emit(c, BC_INDEX, 0, NULL); break;
   112	        case NODE_ARRAY_LIT:
   113	            for (int i = 0; i < node->data.array_lit.elems.count; i++)
   114	                compile_expr(c, node->data.array_lit.elems.items[i]);
   115	            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;
   116	        default:
   117	            error_at(node->line, "cannot compile expression of type %d", node->type); return -1;
   118	    }
   119	    return 0;
   120	}
   121	
   122	static int compile_node(Compiler *c, ASTNode *node) {
   123	    switch (node->type) {
   124	        case NODE_LET: {
   125	            int slot = add_local(c, node->data.let.name);
   126	            if (slot < 0) return -1;
   127	            compile_expr(c, node->data.let.init);
   128	            break;
   129	        }
   130	        case NODE_ASSIGN: {
   131	            compile_expr(c, node->data.assign.value);
   132	            compile_store(c, node->data.assign.name);
   133	            break;
   134	        }
   135	        case NODE_IF: {
   136	            compile_expr(c, node->data.if_stmt.cond);
   137	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   138	            compile_node(c, node->data.if_stmt.then_b);
   139	            if (node->data.if_stmt.else_b) {
   140	                int je = emit(c, BC_JUMP, 0, NULL);
   141	                c->code[jf].operand = c->code_count;
   142	                compile_node(c, node->data.if_stmt.else_b);
   143	                c->code[je].operand = c->code_count;
   144	            } else {
   145	                c->code[jf].operand = c->code_count;
   146	            }
   147	            break;
   148	        }
   149	        case NODE_WHILE: {
   150	            int loop_start = c->code_count;
   151	            compile_expr(c, node->data.while_stmt.cond);
   152	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   153	            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, "too many nested loops"); return -1; }
   154	            LoopCtx *ctx = &loop_stack[loop_depth++];
   155	            ctx->start = loop_start; ctx->cont = loop_start; ctx->end = -1;
   156	            ctx->break_count = 0; ctx->cont_count = 0;
   157	            compile_node(c, node->data.while_stmt.body);
   158	            emit(c, BC_JUMP, loop_start, NULL);
   159	            int end = c->code_count;
   160	            c->code[jf].operand = end;
   161	            ctx->end = end;
   162	            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;
   163	            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = ctx->cont;
   164	            loop_depth--;
   165	            break;
   166	        }
   167	        case NODE_FOR: {
   168	            int old_lc = c->local_count;
   169	            c->scope_depth++;
   170	            if (node->data.for_stmt.init) compile_node(c, node->data.for_stmt.init);
   171	            int loop_start = c->code_count;
   172	            if (node->data.for_stmt.cond) compile_expr(c, node->data.for_stmt.cond);
   173	            else emit(c, BC_PUSH_BOOL, 1, NULL);
   174	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   175	            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, "too many nested loops"); return -1; }
   176	            LoopCtx *ctx = &loop_stack[loop_depth++];
   177	            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;
   178	            ctx->break_count = 0; ctx->cont_count = 0;
   179	            compile_node(c, node->data.for_stmt.body);
   180	            int step_start = c->code_count;
   181	            ctx->cont = step_start;
   182	            if (node->data.for_stmt.step) compile_node(c, node->data.for_stmt.step);
   183	            emit(c, BC_JUMP, loop_start, NULL);
   184	            int end = c->code_count;
   185	            c->code[jf].operand = end;
   186	            ctx->end = end;
   187	            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;
   188	            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = step_start;
   189	            loop_depth--;
   190	            int n = c->local_count - old_lc;
   191	            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
   192	            c->local_count = old_lc;
   193	            c->scope_depth--;
   194	            break;
   195	        }
   196	        case NODE_FOREACH: {
   197	            int old_lc = c->local_count;
   198	            c->scope_depth++;
   199	            compile_expr(c, node->data.foreach_stmt.arr);
   200	            int arr_slot = add_local(c, ".forarr");
   201	            emit(c, BC_PUSH_INT, 0, NULL);
   202	            int idx_slot = add_local(c, ".foridx");
   203	            int var_slot = add_local(c, node->data.foreach_stmt.var);
   204	            emit(c, BC_PUSH_INT, 0, NULL);
   205	            int loop_start = c->code_count;
   206	            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
   207	            emit(c, BC_LOAD_LOCAL, arr_slot, NULL);
   208	            emit(c, BC_ARRAY_LEN, 0, NULL);
   209	            emit(c, BC_LT, 0, NULL);
   210	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   211	            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, "too many nested loops"); return -1; }
   212	            LoopCtx *ctx = &loop_stack[loop_depth++];
   213	            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;
   214	            ctx->break_count = 0; ctx->cont_count = 0;
   215	            int body_old = c->local_count;
   216	            if (node->data.foreach_stmt.is_of) {
   217	                emit(c, BC_LOAD_LOCAL, arr_slot, NULL);
   218	                emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
   219	                emit(c, BC_INDEX, 0, NULL);
   220	            } else {
   221	                emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
   222	            }
   223	            emit(c, BC_STORE_LOCAL, var_slot, NULL);
   224	            compile_node(c, node->data.foreach_stmt.body);
   225	            int n = c->local_count - body_old;
   226	            int cleanup_start = c->code_count;
   227	            ctx->cont = cleanup_start;
   228	            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
   229	            c->local_count = body_old;
   230	            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);
   231	            emit(c, BC_PUSH_INT, 1, NULL);
   232	            emit(c, BC_ADD, 0, NULL);
   233	            emit(c, BC_STORE_LOCAL, idx_slot, NULL);
   234	            emit(c, BC_JUMP, loop_start, NULL);
   235	            int break_cleanup = c->code_count;
   236	            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
   237	            int end = c->code_count;
   238	            c->code[jf].operand = end;
   239	            ctx->end = end;
   240	            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = break_cleanup;
   241	            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = ctx->cont;
   242	            loop_depth--;
   243	            int n2 = c->local_count - old_lc;
   244	            for (int i = 0; i < n2; i++) emit(c, BC_POP, 0, NULL);
   245	            c->local_count = old_lc;
   246	            c->scope_depth--;
   247	            break;
   248	        }
   249	        case NODE_BREAK: {
   250	            if (loop_depth <= 0) { error_at(node->line, "break outside loop"); return -1; }
   251	            LoopCtx *ctx = &loop_stack[loop_depth - 1];
   252	            if (ctx->break_count >= MAX_LOOP_JUMPS) { error_at(node->line, "too many break statements"); return -1; }
   253	            ctx->breaks[ctx->break_count++] = emit(c, BC_JUMP, 0, NULL);
   254	            break;
   255	        }
   256	        case NODE_CONTINUE: {
   257	            if (loop_depth <= 0) { error_at(node->line, "continue outside loop"); return -1; }
   258	            LoopCtx *ctx = &loop_stack[loop_depth - 1];
   259	            if (ctx->cont_count >= MAX_LOOP_JUMPS) { error_at(node->line, "too many continue statements"); return -1; }
   260	            ctx->conts[ctx->cont_count++] = emit(c, BC_JUMP, 0, NULL);
