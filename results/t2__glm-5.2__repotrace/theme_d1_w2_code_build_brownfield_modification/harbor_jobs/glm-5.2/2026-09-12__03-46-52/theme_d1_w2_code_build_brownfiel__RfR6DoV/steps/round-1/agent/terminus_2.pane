   354	        }
   355	        expect(p, TOK_RPAREN, "')'");
   356	        n->data.func.body = parse_block(p); return n;
   357	    }
   358	    if (check(p, TOK_IDENT)) {
   359	        ASTNode *a = try_parse_assign(p);
   360	        if (a) { expect(p, TOK_SEMICOLON, "';'"); return a; }
   361	    }
   362	    ASTNode *expr = parse_expr(p);
   363	    expect(p, TOK_SEMICOLON, "';'");
   364	    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;
   365	    n->data.expr_stmt.expr = expr; return n;
   366	}
   367	
   368	void parser_init(Parser *p, Token *tokens, int count) {
   369	    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;
   370	}
   371	
   372	ASTNode *parse_program(Parser *p) {
   373	    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;
   374	    nodelist_init(&program->data.block.stmts);
   375	    while (!check(p, TOK_EOF)) {
   376	        ASTNode *stmt = parse_stmt(p);
   377	        if (stmt) nodelist_push(&program->data.block.stmts, stmt);
   378	        if (p->had_error) break;
   379	    }
   380	    return program;
   381	}
