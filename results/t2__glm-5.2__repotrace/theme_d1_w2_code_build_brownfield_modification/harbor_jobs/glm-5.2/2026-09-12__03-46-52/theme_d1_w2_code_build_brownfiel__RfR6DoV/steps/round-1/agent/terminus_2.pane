new = '''        case NODE_LET_DESTRUCT: {
            int init_slot = add_local(c, ".destr");
            if (init_slot < 0) return -1;
            compile_expr(c, node->data.let_destruct.init);
            if (node->data.let_destruct.is_array) {
                int n = node->data.let_destruct.names.count;
                for (int i = 0; i < n; i++) {
                    int slot = add_local(c, node->data.let_destruct.names.items[i]->data.ident);
                    if (slot < 0) return -1;
                    emit(c, BC_PICK, i, NULL);
                    emit(c, BC_PUSH_INT, i, NULL);
                    emit(c, BC_ARRAY_GET_OR_NULL, 0, NULL);
                }
                if (node->data.let_destruct.rest_name[0]) {
                    int slot = add_local(c, node->data.let_destruct.rest_name);
                    if (slot < 0) return -1;
                    emit(c, BC_PICK, n, NULL);
                    emit(c, BC_PUSH_INT, n, NULL);
                    emit(c, BC_ARRAY_SLICE, 0, NULL);
                }
            } else {
                int n = node->data.let_destruct.names.count;
                for (int i = 0; i < n; i++) {
                    const char *field = node->data.let_destruct.names.items[i]->data.ident;
                    int slot = add_local(c, field);
                    if (slot < 0) return -1;
                    emit(c, BC_PICK, i, NULL);
                    emit(c, BC_PUSH_STR, 0, strdup(field));
                    emit(c, BC_MAP_GET_OR_NULL, 0, NULL);
                }
            }
            break;
        }
'''
if old not in s:
    print('LET_DESTRUCT block not found')
else:
    s = s.replace(old, new)
p.write_text(s)
