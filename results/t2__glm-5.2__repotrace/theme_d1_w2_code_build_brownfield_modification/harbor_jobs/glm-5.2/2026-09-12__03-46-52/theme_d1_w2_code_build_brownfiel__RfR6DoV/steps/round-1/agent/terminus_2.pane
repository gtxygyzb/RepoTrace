     4	void error_at(int line, const char *fmt, ...) {
     5	    va_list args;
     6	    va_start(args, fmt);
     7	    fprintf(stderr, "error at line %d: ", line);
     8	    vfprintf(stderr, fmt, args);
     9	    fprintf(stderr, "\n");
    10	    va_end(args);
    11	}
    12	
    13	static char peek(Lexer *lex) { return lex->source[lex->pos]; }
    14	
    15	static char advance(Lexer *lex) {
    16	    char c = lex->source[lex->pos++];
    17	    if (c == '\n') { lex->line++; lex->col = 1; } else { lex->col++; }
    18	    return c;
    19	}
    20	
    21	static int is_at_end(Lexer *lex) { return lex->source[lex->pos] == '\0'; }
    22	
    23	static void skip_whitespace(Lexer *lex) {
    24	    while (!is_at_end(lex)) {
    25	        char c = peek(lex);
    26	        if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
    27	            advance(lex);
    28	        } else if (c == '/' && lex->source[lex->pos + 1] == '/') {
    29	            while (!is_at_end(lex) && peek(lex) != '\n') advance(lex);
    30	        } else {
    31	            break;
    32	        }
    33	    }
    34	}
    35	
    36	static Token make_token(Lexer *lex, TokenType type, const char *text) {
    37	    Token t;
    38	    t.type = type;
    39	    strncpy(t.text, text, MAX_STRING_LEN - 1);
    40	    t.text[MAX_STRING_LEN - 1] = '\0';
    41	    t.line = lex->line;
    42	    t.col = lex->col;
    43	    t.literal.ival = 0;
    44	    return t;
    45	}
    46	
    47	static int add_token(Lexer *lex, Token t) {
    48	    if (lex->token_count >= MAX_TOKENS) { error_at(lex->line, "too many tokens"); return -1; }
    49	    lex->tokens[lex->token_count++] = t;
    50	    return 0;
    51	}
    52	
    53	static int lex_number(Lexer *lex) {
    54	    char buf[64]; int i = 0;
    55	    while (!is_at_end(lex) && isdigit(peek(lex))) {
    56	        if (i < 63) buf[i++] = advance(lex); else advance(lex);
    57	    }
    58	    buf[i] = '\0';
    59	    Token t = make_token(lex, TOK_NUM, buf);
    60	    t.literal.ival = strtoll(buf, NULL, 10);
    61	    return add_token(lex, t);
    62	}
    63	
    64	static int lex_string(Lexer *lex) {
    65	    advance(lex);
    66	    char buf[MAX_STRING_LEN]; int i = 0;
    67	    while (!is_at_end(lex) && peek(lex) != '"') {
    68	        char c = advance(lex);
    69	        if (c == '\\') {
    70	            if (is_at_end(lex)) { error_at(lex->line, "unterminated string"); return -1; }
    71	            char esc = advance(lex);
    72	            switch (esc) {
    73	                case 'n': c = '\n'; break;
    74	                case 't': c = '\t'; break;
    75	                case '\\': c = '\\'; break;
    76	                case '"': c = '"'; break;
    77	                case 'r': c = '\r'; break;
    78	                case '0': c = '\0'; break;
    79	                default: error_at(lex->line, "unknown string escape \\%c", esc); return -1;
    80	            }
    81	        }
    82	        if (i < MAX_STRING_LEN - 1) buf[i++] = c;
    83	    }
    84	    if (is_at_end(lex)) { error_at(lex->line, "unterminated string"); return -1; }
    85	    advance(lex);
    86	    buf[i] = '\0';
    87	    Token t = make_token(lex, TOK_STRING, buf);
    88	    return add_token(lex, t);
    89	}
    90	
    91	static int lex_ident(Lexer *lex) {
    92	    char buf[MAX_IDENT_LEN]; int i = 0;
    93	    while (!is_at_end(lex) && (isalnum(peek(lex)) || peek(lex) == '_')) {
    94	        if (i < MAX_IDENT_LEN - 1) buf[i++] = advance(lex); else advance(lex);
    95	    }
    96	    buf[i] = '\0';
    97	    TokenType type = TOK_IDENT;
    98	    if      (strcmp(buf, "if") == 0)       type = TOK_IF;
    99	    else if (strcmp(buf, "else") == 0)     type = TOK_ELSE;
   100	    else if (strcmp(buf, "while") == 0)    type = TOK_WHILE;
   101	    else if (strcmp(buf, "for") == 0)     type = TOK_FOR;
   102	    else if (strcmp(buf, "break") == 0)   type = TOK_BREAK;
   103	    else if (strcmp(buf, "continue") == 0) type = TOK_CONTINUE;
   104	    else if (strcmp(buf, "in") == 0)      type = TOK_IN;
   105	    else if (strcmp(buf, "of") == 0)      type = TOK_OF;
   106	    else if (strcmp(buf, "return") == 0)   type = TOK_RETURN;
   107	    else if (strcmp(buf, "fn") == 0)       type = TOK_FN;
   108	    else if (strcmp(buf, "let") == 0)      type = TOK_LET;
   109	    else if (strcmp(buf, "print") == 0)    type = TOK_PRINT;
   110	    else if (strcmp(buf, "true") == 0)     type = TOK_TRUE;
   111	    else if (strcmp(buf, "false") == 0)    type = TOK_FALSE;
   112	    Token t = make_token(lex, type, buf);
   113	    return add_token(lex, t);
   114	}
   115	
   116	void lexer_init(Lexer *lex, const char *source) {
   117	    lex->source = source; lex->pos = 0; lex->line = 1; lex->col = 1; lex->token_count = 0;
   118	}
   119	
   120	int lexer_tokenize(Lexer *lex) {
   121	    while (!is_at_end(lex)) {
   122	        skip_whitespace(lex);
   123	        if (is_at_end(lex)) break;
   124	        char c = peek(lex);
   125	        if (isdigit(c)) { if (lex_number(lex) < 0) return -1; }
   126	        else if (c == '"') { if (lex_string(lex) < 0) return -1; }
   127	        else if (isalpha(c) || c == '_') { if (lex_ident(lex) < 0) return -1; }
   128	        else {
   129	            advance(lex);
   130	            char buf[4] = {c, '\0', '\0', '\0'};
   131	            TokenType type = TOK_ERROR;
   132	            switch (c) {
   133	                case '+': if (peek(lex)=='='){advance(lex);type=TOK_PLUS_ASSIGN;strcpy(buf,"+=");}else{type=TOK_PLUS;} break;
   134	                case '-': if (peek(lex)=='='){advance(lex);type=TOK_MINUS_ASSIGN;strcpy(buf,"-=");}else{type=TOK_MINUS;} break;
   135	                case '*': if (peek(lex)=='='){advance(lex);type=TOK_STAR_ASSIGN;strcpy(buf,"*=");}else{type=TOK_STAR;} break;
   136	                case '/': if (peek(lex)=='='){advance(lex);type=TOK_SLASH_ASSIGN;strcpy(buf,"/=");}else{type=TOK_SLASH;} break;
   137	                case '%': if (peek(lex)=='='){advance(lex);type=TOK_PERCENT_ASSIGN;strcpy(buf,"%=");}else{type=TOK_PERCENT;} break;
   138	                case '(': type = TOK_LPAREN; break;
   139	                case ')': type = TOK_RPAREN; break;
   140	                case '{': type = TOK_LBRACE; break;
   141	                case '}': type = TOK_RBRACE; break;
   142	                case '[': type = TOK_LBRACKET; break;
   143	                case ']': type = TOK_RBRACKET; break;
   144	                case ';': type = TOK_SEMICOLON; break;
   145	                case ',': type = TOK_COMMA; break;
   146	                case '!': if (peek(lex)=='='){advance(lex);type=TOK_NEQ;strcpy(buf,"!=");}else{type=TOK_NOT;} break;
   147	                case '=': if (peek(lex)=='='){advance(lex);type=TOK_EQ;strcpy(buf,"==");}else{type=TOK_ASSIGN;} break;
   148	                case '<': if (peek(lex)=='='){advance(lex);type=TOK_LEQ;strcpy(buf,"<=");}else{type=TOK_LT;} break;
   149	                case '>': if (peek(lex)=='='){advance(lex);type=TOK_GEQ;strcpy(buf,">=");}else{type=TOK_GT;} break;
   150	                case '&': if (peek(lex)=='&'){advance(lex);type=TOK_AND;strcpy(buf,"&&");}
   151	                          else{error_at(lex->line,"unexpected character '&'");return -1;} break;
   152	                case '|': if (peek(lex)=='|'){advance(lex);type=TOK_OR;strcpy(buf,"||");}
   153	                          else{error_at(lex->line,"unexpected character '|'");return -1;} break;
   154	                default: error_at(lex->line, "unexpected character '%c'", c); return -1;
   155	            }
   156	            Token t = make_token(lex, type, buf);
   157	            if (add_token(lex, t) < 0) return -1;
   158	        }
   159	    }
   160	    Token eof = make_token(lex, TOK_EOF, "");
   161	    return add_token(lex, eof);
   162	}
