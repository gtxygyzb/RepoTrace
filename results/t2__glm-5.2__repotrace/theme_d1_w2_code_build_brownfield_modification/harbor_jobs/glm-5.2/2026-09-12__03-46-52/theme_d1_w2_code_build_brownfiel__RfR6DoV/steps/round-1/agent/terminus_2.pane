    29	        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;
    30	        n->data.num_val = prev(p)->literal.ival; return n;
    31	    }
    32	    if (match(p, TOK_STRING)) {
    33	        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;
    34	        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return n;
    35	    }
    36	    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {
    37	        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;
    38	        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;
    39	    }
    40	    if (match(p, TOK_IDENT)) {
    41	        char name[MAX_IDENT_LEN];
    42	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\0';
    43	        int line = prev(p)->line;
    44	        if (match(p, TOK_LPAREN)) {
    45	            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;
    46	            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);
    47	            nodelist_init(&n->data.call.args);
    48	            if (!check(p, TOK_RPAREN)) {
    49	                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));
    50	            }
    51	            expect(p, TOK_RPAREN, "')'"); return n;
    52	        }
    53	        if (match(p, TOK_LBRACKET)) {
    54	            ASTNode *idx = parse_expr(p); expect(p, TOK_RBRACKET, "']'");
    55	            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;
    56	            ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;
    57	            strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);
    58	            n->data.index_access.obj = obj; n->data.index_access.index = idx; return n;
    59	        }
    60	        ASTNode *n = ast_alloc(); n->type = NODE_IDENT; n->line = line;
    61	        strncpy(n->data.ident, name, MAX_IDENT_LEN - 1); return n;
    62	    }
    63	    if (match(p, TOK_LBRACKET)) {
    64	        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;
    65	        nodelist_init(&n->data.array_lit.elems);
    66	        if (!check(p, TOK_RBRACKET)) {
    67	            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));
    68	        }
    69	        expect(p, TOK_RBRACKET, "']'"); return n;
    70	    }
    71	    if (match(p, TOK_LPAREN)) {
    72	        ASTNode *expr = parse_expr(p); expect(p, TOK_RPAREN, "')'"); return expr;
    73	    }
    74	    error_at(current(p)->line, "unexpected token '%s'", current(p)->text);
    75	    p->had_error = 1; p->pos++; return ast_alloc();
