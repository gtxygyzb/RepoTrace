   121	static void print_value(Value v) {
   122	    switch (v.type) {
   123	        case VAL_INT: printf("%lld", (long long)v.data.ival); break;
   124	        case VAL_BOOL: printf("%s", v.data.bval ? "true" : "false"); break;
   125	        case VAL_STR: printf("%s", v.data.sval); break;
   126	        case VAL_ARRAY:
   127	            printf("[");
   128	            for (int i = 0; i < v.data.array.len; i++) {
   129	                if (i > 0) printf(", ");
   130	                print_value(v.data.array.items[i]);
   131	            }
   132	            printf("]");
   133	            break;
   134	        case VAL_MAP:
   135	            printf("{");
   136	            for (int i = 0; i < v.data.map->len; i++) {
   137	                if (i > 0) printf(", ");
   138	                printf("%s", v.data.map->keys[i]);
   139	                printf(": ");
   140	                print_value(v.data.map->values[i]);
   141	            }
   142	            printf("}");
   143	            break;
   144	        case VAL_NULL: printf("null"); break;
   145	    }
   146	}
