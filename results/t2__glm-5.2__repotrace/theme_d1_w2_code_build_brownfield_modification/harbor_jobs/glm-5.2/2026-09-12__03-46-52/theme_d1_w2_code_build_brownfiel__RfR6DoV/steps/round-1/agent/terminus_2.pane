   156	void vm_init(VM *vm, Compiler *c) {
   157	    vm->sp = 0; vm->frame_count = 0; vm->global_count = 0;
   158	    vm->code = c->code; vm->code_count = c->code_count;
   159	    vm->functions = c->functions; vm->func_count = c->func_count;
   160	    vm->ip = 0;
   161	}
   162	
   163	int vm_run(VM *vm) {
   164	    while (vm->ip < vm->code_count) {
   165	        Instruction *ins = &vm->code[vm->ip++];
   166	        switch (ins->op) {
   167	            case BC_PUSH_INT: push(vm, make_int(ins->operand)); break;
   168	            case BC_PUSH_STR: push(vm, make_str(ins->str_operand)); break;
   169	            case BC_PUSH_BOOL: push(vm, make_bool((int)ins->operand)); break;
   170	            case BC_LOAD_LOCAL: {
   171	                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;
   172	                push(vm, vm->stack[base + (int)ins->operand]);
   173	                break;
   174	            }
   175	            case BC_STORE_LOCAL: {
   176	                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;
   177	                vm->stack[base + (int)ins->operand] = pop(vm);
   178	                break;
   179	            }
   180	            case BC_LOAD_GLOBAL: {
   181	                int idx = resolve_global(vm, ins->str_operand);
   182	                if (idx < 0) { fprintf(stderr, "undefined variable '%s'\n", ins->str_operand); return -1; }
   183	                push(vm, vm->globals[idx]);
   184	                break;
   185	            }
   186	            case BC_STORE_GLOBAL: {
   187	                int idx = resolve_global(vm, ins->str_operand);
   188	                if (idx < 0) idx = add_global(vm, ins->str_operand);
   189	                vm->globals[idx] = pop(vm);
   190	                break;
   191	            }
   192	            case BC_ADD: {
   193	                Value b = pop(vm); Value a = pop(vm);
   194	                if (a.type == VAL_STR || b.type == VAL_STR) {
   195	                    char bufa[64], bufb[64];
   196	                    const char *sa = value_to_cstr(a, bufa, sizeof(bufa));
   197	                    const char *sb = value_to_cstr(b, bufb, sizeof(bufb));
   198	                    char *r = malloc(strlen(sa) + strlen(sb) + 1);
   199	                    strcpy(r, sa); strcat(r, sb);
   200	                    Value v; v.type = VAL_STR; v.data.sval = r; push(vm, v);
   201	                } else { push(vm, make_int(value_to_int(a) + value_to_int(b))); }
   202	                break;
   203	            }
   204	            case BC_SUB: { Value b = pop(vm); Value a = pop(vm);
   205	                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {
   206	                    fprintf(stderr, "operator '-' expects integers\n");
   207	                    return -1;
   208	                }
   209	                push(vm, make_int(value_to_int(a) - value_to_int(b))); break; }
   210	            case BC_MUL: { Value b = pop(vm); Value a = pop(vm);
   211	                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {
   212	                    fprintf(stderr, "operator '*' expects integers\n");
   213	                    return -1;
