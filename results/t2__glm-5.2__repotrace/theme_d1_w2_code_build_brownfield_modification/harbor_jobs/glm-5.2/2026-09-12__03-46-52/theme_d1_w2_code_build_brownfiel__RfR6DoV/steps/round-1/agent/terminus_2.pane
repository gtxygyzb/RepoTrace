[?2004l     1	#include "parser.h"
     2	
     3	static Token *current(Parser *p) { return &p->tokens[p->pos]; }
     4	static Token *prev(Parser *p) { return &p->tokens[p->pos - 1]; }
     5	static int check(Parser *p, TokenType t) { return current(p)->type == t; }
     6	
     7	static int match(Parser *p, TokenType t) {
     8	    if (check(p, t)) { p->pos++; return 1; }
     9	    return 0;
    10	}
    11	
    12	static void expect(Parser *p, TokenType t, const char *msg) {
    13	    if (!match(p, t)) {
    14	        error_at(current(p)->line, "expected %s, got '%s'", msg, current(p)->text);
    15	        p->had_error = 1;
    16	    }
    17	}
    18	
    19	static ASTNode *parse_expr(Parser *p);
    20	static ASTNode *parse_stmt(Parser *p);
    21	static ASTNode *parse_block(Parser *p);
    22	static ASTNode *parse_factor(Parser *p);
    23	static ASTNode *parse_term(Parser *p);
    24	static ASTNode *parse_comparison(Parser *p);
    25	static ASTNode *parse_logic_and(Parser *p);
    26	static ASTNode *parse_fn_expr(Parser *p);
    27	static ASTNode *parse_postfix(Parser *p, ASTNode *expr);
    28	
    29	static ASTNode *parse_primary(Parser *p) {
    30	    if (match(p, TOK_NUM)) {
    31	        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;
    32	        n->data.num_val = prev(p)->literal.ival; return n;
    33	    }
    34	    if (match(p, TOK_STRING)) {
    35	        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;
    36	        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return parse_postfix(p, n);
    37	    }
    38	    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {
    39	        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;
    40	        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;
    41	    }
    42	    if (match(p, TOK_IDENT)) {
    43	        char name[MAX_IDENT_LEN];
    44	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\0';
    45	        int line = prev(p)->line;
    46	        if (match(p, TOK_LPAREN)) {
    47	            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;
    48	            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);
    49	            nodelist_init(&n->data.call.args);
    50	            if (!check(p, TOK_RPAREN)) {
    51	                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));
    52	            }
    53	            expect(p, TOK_RPAREN, "')'"); return parse_postfix(p, n);
    54	        }
    55	        ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;
    56	        strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);
    57	        return parse_postfix(p, obj);
    58	    }
    59	    if (match(p, TOK_LBRACE)) {
    60	        int line = prev(p)->line;
    61	        ASTNode *n = ast_alloc(); n->type = NODE_MAP_LIT; n->line = line;
    62	        nodelist_init(&n->data.map_lit.keys);
    63	        nodelist_init(&n->data.map_lit.values);
    64	        if (!check(p, TOK_RBRACE)) {
    65	            do {
    66	                if (!check(p, TOK_STRING)) {
    67	                    error_at(current(p)->line, "map keys must be string literals");
    68	                    p->had_error = 1; p->pos++;
    69	                } else {
    70	                    match(p, TOK_STRING);
    71	                    ASTNode *key = ast_alloc(); key->type = NODE_STR_LIT; key->line = prev(p)->line;
    72	                    strncpy(key->data.str_val, prev(p)->text, MAX_STRING_LEN - 1);
    73	                    expect(p, TOK_COLON, "':'");
    74	                    ASTNode *val = parse_expr(p);
    75	                    nodelist_push(&n->data.map_lit.keys, key);
    76	                    nodelist_push(&n->data.map_lit.values, val);
    77	                }
    78	            } while (match(p, TOK_COMMA));
    79	        }
    80	        expect(p, TOK_RBRACE, "'}'");
    81	        return parse_postfix(p, n);
    82	    }
    83	    if (match(p, TOK_FN)) {
    84	        return parse_postfix(p, parse_fn_expr(p));
    85	    }
    86	    if (match(p, TOK_LBRACKET)) {
    87	        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;
    88	        nodelist_init(&n->data.array_lit.elems);
    89	        if (!check(p, TOK_RBRACKET)) {
    90	            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));
    91	        }
    92	        expect(p, TOK_RBRACKET, "']'"); return parse_postfix(p, n);
    93	    }
    94	    if (match(p, TOK_LPAREN)) {
    95	        ASTNode *expr = parse_expr(p); expect(p, TOK_RPAREN, "')'"); return parse_postfix(p, expr);
    96	    }
    97	    error_at(current(p)->line, "unexpected token '%s'", current(p)->text);
    98	    p->had_error = 1; p->pos++; return ast_alloc();
    99	}
   100	
   101	static ASTNode *parse_fn_expr(Parser *p) {
   102	    int line = prev(p)->line;
   103	    expect(p, TOK_LPAREN, "'('");
   104	    ASTNode *n = ast_alloc(); n->type = NODE_CLOSURE; n->line = line;
   105	    n->data.closure.param_count = 0;
   106	    if (!check(p, TOK_RPAREN)) {
   107	        do {
   108	            expect(p, TOK_IDENT, "parameter name");
   109	            strncpy(n->data.closure.params[n->data.closure.param_count],
   110	                   prev(p)->text, MAX_IDENT_LEN - 1);
   111	            n->data.closure.param_count++;
   112	        } while (match(p, TOK_COMMA));
   113	    }
   114	    expect(p, TOK_RPAREN, "')'");
   115	    n->data.closure.body = parse_block(p);
   116	    return n;
   117	}
   118	
   119	static ASTNode *parse_postfix(Parser *p, ASTNode *expr) {
   120	    for (;;) {
   121	        if (match(p, TOK_DOT)) {
   122	            int line = prev(p)->line;
   123	            expect(p, TOK_IDENT, "field or method name");
   124	            char name[MAX_IDENT_LEN];
   125	            strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\0';
   126	            if (check(p, TOK_LPAREN)) {
   127	                match(p, TOK_LPAREN);
   128	                ASTNode *n = ast_alloc(); n->type = NODE_METHOD_CALL; n->line = line;
   129	                n->data.method_call.obj = expr;
   130	                strncpy(n->data.method_call.method, name, MAX_IDENT_LEN - 1);
   131	                n->data.method_call.method[MAX_IDENT_LEN - 1] = '\0';
   132	                nodelist_init(&n->data.method_call.args);
   133	                if (!check(p, TOK_RPAREN)) {
   134	                    do { nodelist_push(&n->data.method_call.args, parse_expr(p)); } while (match(p, TOK_COMMA));
   135	                }
   136	                expect(p, TOK_RPAREN, "')'");
   137	                expr = n;
   138	            } else {
   139	                ASTNode *n = ast_alloc(); n->type = NODE_FIELD_ACCESS; n->line = line;
   140	                n->data.field_access.obj = expr;
   141	                strncpy(n->data.field_access.field, name, MAX_IDENT_LEN - 1);
   142	                n->data.field_access.field[MAX_IDENT_LEN - 1] = '\0';
   143	                expr = n;
   144	            }
   145	        } else if (match(p, TOK_LBRACKET)) {
   146	            int line = prev(p)->line;
   147	            ASTNode *idx = parse_expr(p);
   148	            expect(p, TOK_RBRACKET, "']'");
   149	            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;
   150	            n->data.index_access.obj = expr;
   151	            n->data.index_access.index = idx;
   152	            expr = n;
   153	        } else {
   154	            break;
   155	        }
   156	    }
   157	    return expr;
   158	}
   159	
   160	static ASTNode *parse_unary(Parser *p) {
   161	    if (match(p, TOK_MINUS)) {
   162	        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
   163	        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
   164	        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;
   165	    }
   166	    if (match(p, TOK_NOT)) {
   167	        int line = prev(p)->line; ASTNode *operand = parse_unary(p);
   168	        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;
   169	        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;
   170	    }
   171	    return parse_primary(p);
   172	}
   173	
   174	static ASTNode *parse_factor(Parser *p) {
   175	    ASTNode *left = parse_unary(p);
   176	    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {
   177	        int line = prev(p)->line; BinOp op;
   178	        if (prev(p)->type == TOK_STAR) op = OP_MUL;
   179	        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;
   180	        else op = OP_MOD;
   181	        ASTNode *right = parse_unary(p);
   182	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   183	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   184	        left = n;
   185	    }
   186	    return left;
   187	}
   188	
   189	static ASTNode *parse_comparison(Parser *p) {
   190	    ASTNode *left = parse_term(p);
   191	    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||
   192	           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {
   193	        int line = prev(p)->line; BinOp op;
   194	        switch (prev(p)->type) {
   195	            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;
   196	            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;
   197	            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;
   198	            default: op = OP_EQ; break;
   199	        }
   200	        ASTNode *right = parse_term(p);
   201	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   202	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   203	        left = n;
   204	    }
   205	    return left;
   206	}
   207	
   208	static ASTNode *parse_term(Parser *p) {
   209	    ASTNode *left = parse_factor(p);
   210	    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {
   211	        int line = prev(p)->line;
   212	        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;
   213	        ASTNode *right = parse_factor(p);
   214	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   215	        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;
   216	        left = n;
   217	    }
   218	    return left;
   219	}
   220	
   221	static ASTNode *parse_logic_and(Parser *p) {
   222	    ASTNode *left = parse_comparison(p);
   223	    while (match(p, TOK_AND)) {
   224	        int line = prev(p)->line; ASTNode *right = parse_comparison(p);
   225	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   226	        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;
   227	        left = n;
   228	    }
   229	    return left;
   230	}
   231	
   232	static ASTNode *parse_expr(Parser *p) {
   233	    ASTNode *left = parse_logic_and(p);
   234	    while (match(p, TOK_OR)) {
   235	        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);
   236	        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;
   237	        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;
   238	        left = n;
   239	    }
   240	    return left;
   241	}
   242	
   243	static ASTNode *try_parse_assign(Parser *p) {
   244	    if (!check(p, TOK_IDENT)) return NULL;
   245	    int saved = p->pos;
   246	    int line = current(p)->line;
   247	    ASTNode *target = parse_expr(p);
   248	    if (target && (target->type == NODE_FIELD_ACCESS || target->type == NODE_INDEX)) {
   249	        if (check(p, TOK_ASSIGN)) {
   250	            match(p, TOK_ASSIGN);
   251	            ASTNode *val = parse_expr(p);
   252	            if (target->type == NODE_FIELD_ACCESS) {
   253	                ASTNode *n = ast_alloc(); n->type = NODE_FIELD_ASSIGN; n->line = line;
   254	                n->data.field_assign.obj = target->data.field_access.obj;
   255	                strncpy(n->data.field_assign.field, target->data.field_access.field, MAX_IDENT_LEN - 1);
   256	                n->data.field_assign.field[MAX_IDENT_LEN - 1] = '\0';
   257	                n->data.field_assign.value = val;
   258	                return n;
   259	            } else {
   260	                ASTNode *n = ast_alloc(); n->type = NODE_INDEX_ASSIGN; n->line = line;
   261	                n->data.index_assign.name[0] = '\0';
   262	                n->data.index_assign.obj = target->data.index_access.obj;
   263	                n->data.index_assign.index = target->data.index_access.index;
   264	                n->data.index_assign.value = val;
   265	                return n;
   266	            }
   267	        }
   268	    }
   269	    p->pos = saved;
   270	    if (check(p, TOK_IDENT)) {
   271	        p->pos++;
   272	        char name[MAX_IDENT_LEN];
   273	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   274	        line = prev(p)->line;
   275	        if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||
   276	            check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {
   277	            p->pos = saved; match(p, TOK_IDENT);
   278	            TokenType op_tok = current(p)->type;
   279	            BinOp op = OP_ADD;
   280	            const char *msg = "'='";
   281	            if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = "'+='"; expect(p, TOK_PLUS_ASSIGN, "'+='"); }
   282	            else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = "'-='"; expect(p, TOK_MINUS_ASSIGN, "'-='"); }
   283	            else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = "'*='"; expect(p, TOK_STAR_ASSIGN, "'*='"); }
   284	            else if (op_tok == TOK_SLASH_ASSIGN) { op = OP_DIV; msg = "'/='"; expect(p, TOK_SLASH_ASSIGN, "'/='"); }
   285	            else if (op_tok == TOK_PERCENT_ASSIGN) { op = OP_MOD; msg = "'%='"; expect(p, TOK_PERCENT_ASSIGN, "'%='"); }
   286	            else { expect(p, TOK_ASSIGN, "'='"); }
   287	            ASTNode *val = parse_expr(p);
   288	            if (op_tok == TOK_ASSIGN) {
   289	                ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;
   290	                strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);
   291	                n->data.assign.value = val; return n;
   292	            } else {
   293	                ASTNode *n = ast_alloc(); n->type = NODE_COMPOUND_ASSIGN; n->line = line;
   294	                strncpy(n->data.compound_assign.name, name, MAX_IDENT_LEN - 1);
   295	                n->data.compound_assign.op = op;
   296	                n->data.compound_assign.value = val; return n;
   297	            }
   298	        }
   299	    }
   300	    p->pos = saved; return NULL;
   301	}
   302	
   303	static ASTNode *parse_for(Parser *p) {
   304	    int line = prev(p)->line;
   305	    expect(p, TOK_LPAREN, "'('");
   306	
   307	    if (check(p, TOK_IDENT) && p->pos + 1 < p->count &&
   308	        (p->tokens[p->pos + 1].type == TOK_IN || p->tokens[p->pos + 1].type == TOK_OF)) {
   309	        char name[MAX_IDENT_LEN];
   310	        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   311	        match(p, TOK_IDENT);
   312	        int is_of = match(p, TOK_OF);
   313	        if (!is_of) match(p, TOK_IN);
   314	        ASTNode *arr = parse_expr(p);
   315	        expect(p, TOK_RPAREN, "')'");
   316	        ASTNode *body = parse_block(p);
   317	        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;
   318	        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);
   319	        n->data.foreach_stmt.arr = arr;
   320	        n->data.foreach_stmt.body = body;
   321	        n->data.foreach_stmt.is_of = is_of;
   322	        return n;
   323	    }
   324	
   325	    ASTNode *init = NULL;
   326	    if (match(p, TOK_LET)) {
   327	        expect(p, TOK_IDENT, "identifier");
   328	        char name[MAX_IDENT_LEN];
   329	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   330	        expect(p, TOK_ASSIGN, "'='");
   331	        ASTNode *init_expr = parse_expr(p);
   332	        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;
   333	        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);
   334	        init->data.let.init = init_expr;
   335	    } else if (check(p, TOK_IDENT)) {
   336	        init = try_parse_assign(p);
   337	        if (!init) init = parse_expr(p);
   338	    } else if (!check(p, TOK_SEMICOLON)) {
   339	        init = parse_expr(p);
   340	    }
   341	    expect(p, TOK_SEMICOLON, "';'");
   342	
   343	    ASTNode *cond = NULL;
   344	    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);
   345	    expect(p, TOK_SEMICOLON, "';'");
   346	
   347	    ASTNode *step = NULL;
   348	    if (!check(p, TOK_RPAREN)) {
   349	        if (check(p, TOK_IDENT)) {
   350	            step = try_parse_assign(p);
   351	        }
   352	        if (!step) step = parse_expr(p);
   353	    }
   354	    expect(p, TOK_RPAREN, "')'");
   355	
   356	    ASTNode *body = parse_block(p);
   357	    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;
   358	    n->data.for_stmt.init = init;
   359	    n->data.for_stmt.cond = cond;
   360	    n->data.for_stmt.step = step;
   361	    n->data.for_stmt.body = body;
   362	    return n;
   363	}
   364	
   365	static ASTNode *parse_block(Parser *p) {
   366	    expect(p, TOK_LBRACE, "'{'");
   367	    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;
   368	    nodelist_init(&block->data.block.stmts);
   369	    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {
   370	        ASTNode *stmt = parse_stmt(p);
   371	        if (stmt) nodelist_push(&block->data.block.stmts, stmt);
   372	        if (p->had_error) break;
   373	    }
   374	    expect(p, TOK_RBRACE, "'}'");
   375	    return block;
   376	}
   377	
   378	static ASTNode *parse_stmt(Parser *p) {
   379	    if (match(p, TOK_LET)) {
   380	        int line = prev(p)->line;
   381	        expect(p, TOK_IDENT, "identifier");
   382	        char name[MAX_IDENT_LEN];
   383	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   384	        expect(p, TOK_ASSIGN, "'='");
   385	        ASTNode *init = parse_expr(p);
   386	        expect(p, TOK_SEMICOLON, "';'");
   387	        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;
   388	        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);
   389	        n->data.let.init = init; return n;
   390	    }
   391	    if (match(p, TOK_IF)) {
   392	        int line = prev(p)->line;
   393	        expect(p, TOK_LPAREN, "'('");
   394	        ASTNode *cond = parse_expr(p);
   395	        expect(p, TOK_RPAREN, "')'");
   396	        ASTNode *then_b = parse_block(p);
   397	        ASTNode *else_b = NULL;
   398	        if (match(p, TOK_ELSE)) {
   399	            if (check(p, TOK_IF)) {
   400	                ASTNode *elif = parse_stmt(p);
   401	                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;
   402	                nodelist_init(&else_b->data.block.stmts);
   403	                nodelist_push(&else_b->data.block.stmts, elif);
   404	            } else {
   405	                else_b = parse_block(p);
   406	            }
   407	        }
   408	        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;
   409	        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;
   410	        return n;
   411	    }
   412	    if (match(p, TOK_WHILE)) {
   413	        int line = prev(p)->line;
   414	        expect(p, TOK_LPAREN, "'('");
   415	        ASTNode *cond = parse_expr(p);
   416	        expect(p, TOK_RPAREN, "')'");
   417	        ASTNode *body = parse_block(p);
   418	        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;
   419	        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;
   420	    }
