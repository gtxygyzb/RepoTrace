   195	static ASTNode *parse_for(Parser *p) {
   196	    int line = prev(p)->line;
   197	    expect(p, TOK_LPAREN, "'('");
   198	
   199	    if (check(p, TOK_IDENT) && p->pos + 1 < p->count && p->tokens[p->pos + 1].type == TOK_IN) {
   200	        char name[MAX_IDENT_LEN];
   201	        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   202	        match(p, TOK_IDENT);
   203	        match(p, TOK_IN);
   204	        ASTNode *arr = parse_expr(p);
   205	        expect(p, TOK_RPAREN, "')'");
   206	        ASTNode *body = parse_block(p);
   207	        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;
   208	        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);
   209	        n->data.foreach_stmt.arr = arr;
   210	        n->data.foreach_stmt.body = body;
   211	        return n;
   212	    }
   213	
   214	    ASTNode *init = NULL;
   215	    if (match(p, TOK_LET)) {
   216	        expect(p, TOK_IDENT, "identifier");
   217	        char name[MAX_IDENT_LEN];
   218	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   219	        expect(p, TOK_ASSIGN, "'='");
   220	        ASTNode *init_expr = parse_expr(p);
   221	        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;
   222	        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);
   223	        init->data.let.init = init_expr;
   224	    } else if (check(p, TOK_IDENT)) {
   225	        init = try_parse_assign(p);
   226	        if (!init) init = parse_expr(p);
   227	    } else if (!check(p, TOK_SEMICOLON)) {
   228	        init = parse_expr(p);
   229	    }
   230	    expect(p, TOK_SEMICOLON, "';'");
   231	
   232	    ASTNode *cond = NULL;
   233	    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);
   234	    expect(p, TOK_SEMICOLON, "';'");
   235	
   236	    ASTNode *step = NULL;
   237	    if (!check(p, TOK_RPAREN)) {
   238	        if (check(p, TOK_IDENT)) {
   239	            step = try_parse_assign(p);
   240	        }
   241	        if (!step) step = parse_expr(p);
   242	    }
   243	    expect(p, TOK_RPAREN, "')'");
   244	
   245	    ASTNode *body = parse_block(p);
   246	    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;
   247	    n->data.for_stmt.init = init;
   248	    n->data.for_stmt.cond = cond;
   249	    n->data.for_stmt.step = step;
   250	    n->data.for_stmt.body = body;
   251	    return n;
   252	}
