   152	            case BC_NEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(!values_equal(a, b))); break; }
   153	            case BC_LT: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_to_int(a) < value_to_int(b))); break; }
   154	            case BC_GT: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_to_int(a) > value_to_int(b))); break; }
   155	            case BC_LEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_to_int(a) <= value_to_int(b))); break; }
