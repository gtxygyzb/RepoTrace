   157	static ASTNode *try_parse_assign(Parser *p) {
   158	    if (!check(p, TOK_IDENT)) return NULL;
   159	    int saved = p->pos;
   160	    p->pos++;
   161	    if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||
   162	        check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {
   163	        p->pos = saved; match(p, TOK_IDENT);
   164	        char name[MAX_IDENT_LEN];
   165	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   166	        int line = prev(p)->line;
   167	        TokenType op_tok = current(p)->type;
   168	        BinOp op = OP_ADD;
   169	        const char *msg = "'='";
   170	        if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = "'+='"; expect(p, TOK_PLUS_ASSIGN, "'+='"); }
   171	        else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = "'-='"; expect(p, TOK_MINUS_ASSIGN, "'-='"); }
   172	        else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = "'*='"; expect(p, TOK_STAR_ASSIGN, "'*='"); }
   173	        else if (op_tok == TOK_SLASH_ASSIGN) { op = OP_DIV; msg = "'/='"; expect(p, TOK_SLASH_ASSIGN, "'/='"); }
   174	        else if (op_tok == TOK_PERCENT_ASSIGN) { op = OP_MOD; msg = "'%='"; expect(p, TOK_PERCENT_ASSIGN, "'%='"); }
   175	        else { expect(p, TOK_ASSIGN, "'='"); }
   176	        ASTNode *val = parse_expr(p);
   177	        if (op_tok == TOK_ASSIGN) {
   178	            ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;
   179	            strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);
   180	            n->data.assign.value = val; return n;
[?2004hroot@n30009:/app# nl -ba src/parser.c | sed -n '180,320p'
[?2004l   180	            n->data.assign.value = val; return n;
