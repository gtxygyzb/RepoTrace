#define MINICC_CODEGEN_H

#include "common.h"
#include "ast.h"

typedef struct {
    char name[MAX_IDENT_LEN];
    int scope_depth;
    int is_boxed;
} Local;

typedef struct {
    char name[MAX_IDENT_LEN];
    int addr;
    int param_count;
    int capture_count;
    int capture_slots[MAX_LOCALS];
} FuncInfo;

typedef struct {
    char name[MAX_IDENT_LEN];
} CaptureInfo;

typedef struct {
    Instruction code[MAX_BYTECODE];
    int code_count;
    Local locals[MAX_LOCALS];
    int local_count;
    int scope_depth;
    FuncInfo functions[MAX_FUNCTIONS];
    int func_count;
    int in_function;
    CaptureInfo captures[MAX_LOCALS];
    int capture_count;
} Compiler;

void compiler_init(Compiler *c);
int compile(Compiler *c, ASTNode *program);

