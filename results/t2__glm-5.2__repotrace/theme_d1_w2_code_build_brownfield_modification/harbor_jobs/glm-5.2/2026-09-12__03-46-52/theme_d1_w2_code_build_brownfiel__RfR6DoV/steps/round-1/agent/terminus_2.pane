   303	        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;
   304	        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;
   305	    }
   306	    if (match(p, TOK_RETURN)) {
   307	        int line = prev(p)->line;
   308	        ASTNode *value = NULL;
   309	        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);
   310	        expect(p, TOK_SEMICOLON, "';'");
   311	        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;
   312	        n->data.ret.value = value; return n;
   313	    }
   314	    if (match(p, TOK_FOR)) {
   315	        return parse_for(p);
   316	    }
   317	    if (match(p, TOK_BREAK)) {
   318	        int line = prev(p)->line;
