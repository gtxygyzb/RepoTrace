   120	static int value_cmp(Value a, Value b) {
   121	    if (a.type == VAL_STR && b.type == VAL_STR)
   122	        return strcmp(a.data.sval, b.data.sval);
   123	    int64_t ia = value_to_int(a), ib = value_to_int(b);
   124	    return ia < ib ? -1 : (ia > ib ? 1 : 0);
   125	}
