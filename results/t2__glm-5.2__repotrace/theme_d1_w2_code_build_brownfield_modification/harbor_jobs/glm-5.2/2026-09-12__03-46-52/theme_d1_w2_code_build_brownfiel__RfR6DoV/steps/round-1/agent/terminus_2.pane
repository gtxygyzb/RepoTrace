[?2004l   100	}
   101	
   102	static int compile_node(Compiler *c, ASTNode *node) {
   103	    switch (node->type) {
   104	        case NODE_LET: {
   105	            int slot = add_local(c, node->data.let.name);
   106	            if (slot < 0) return -1;
   107	            compile_expr(c, node->data.let.init);
   108	            break;
   109	        }
   110	        case NODE_ASSIGN: {
   111	            compile_expr(c, node->data.assign.value);
   112	            compile_store(c, node->data.assign.name);
   113	            break;
   114	        }
   115	        case NODE_IF: {
   116	            compile_expr(c, node->data.if_stmt.cond);
   117	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   118	            compile_node(c, node->data.if_stmt.then_b);
   119	            if (node->data.if_stmt.else_b) {
   120	                int je = emit(c, BC_JUMP, 0, NULL);
   121	                c->code[jf].operand = c->code_count;
   122	                compile_node(c, node->data.if_stmt.else_b);
   123	                c->code[je].operand = c->code_count;
   124	            } else {
   125	                c->code[jf].operand = c->code_count;
   126	            }
   127	            break;
   128	        }
   129	        case NODE_WHILE: {
   130	            int loop_start = c->code_count;
   131	            compile_expr(c, node->data.while_stmt.cond);
   132	            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);
   133	            compile_node(c, node->data.while_stmt.body);
   134	            emit(c, BC_JUMP, loop_start, NULL);
   135	            c->code[jf].operand = c->code_count;
   136	            break;
   137	        }
   138	        case NODE_RETURN: {
   139	            if (node->data.ret.value) compile_expr(c, node->data.ret.value);
   140	            else emit(c, BC_PUSH_INT, 0, NULL);
   141	            emit(c, BC_RET, 0, NULL);
   142	            break;
   143	        }
   144	        case NODE_PRINT: {
   145	            compile_expr(c, node->data.print.value);
   146	            emit(c, BC_PRINT, 0, NULL);
   147	            break;
   148	        }
   149	        case NODE_BLOCK: {
   150	            int old_lc = c->local_count;
   151	            c->scope_depth++;
   152	            for (int i = 0; i < node->data.block.stmts.count; i++)
   153	                compile_node(c, node->data.block.stmts.items[i]);
   154	            c->scope_depth--;
   155	            {
   156	                int n = c->local_count - old_lc;
   157	                for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);
   158	            }
   159	            c->local_count = old_lc;
   160	            break;
   161	        }
   162	        case NODE_FUNC: {
   163	            int jump_over = emit(c, BC_JUMP, 0, NULL);
   164	
   165	            if (c->func_count >= MAX_FUNCTIONS) { fprintf(stderr, "too many functions\n"); return -1; }
   166	            FuncInfo *fi = &c->functions[c->func_count];
   167	            strncpy(fi->name, node->data.func.name, MAX_IDENT_LEN - 1);
   168	            fi->addr = c->code_count;
   169	            fi->param_count = node->data.func.param_count;
   170	            c->func_count++;
   171	
   172	            int old_lc = c->local_count;
   173	            int old_scope = c->scope_depth;
   174	            int old_inf = c->in_function;
   175	
   176	            c->local_count = 0;
   177	            c->scope_depth = 0;
   178	            c->in_function = 1;
   179	            c->scope_depth++;
   180	
   181	            for (int i = 0; i < node->data.func.param_count; i++)
   182	                add_local(c, node->data.func.params[i]);
   183	
   184	            compile_node(c, node->data.func.body);
   185	
   186	            emit(c, BC_PUSH_INT, 0, NULL);
   187	            emit(c, BC_RET, 0, NULL);
   188	
   189	            c->scope_depth = old_scope;
   190	            c->local_count = old_lc;
   191	            c->in_function = old_inf;
   192	
   193	            c->code[jump_over].operand = c->code_count;
   194	            break;
   195	        }
   196	        case NODE_EXPR_STMT: {
   197	            compile_expr(c, node->data.expr_stmt.expr);
   198	            emit(c, BC_POP, 0, NULL);
   199	            break;
   200	        }
   201	        default:
   202	            compile_expr(c, node);
   203	            emit(c, BC_POP, 0, NULL);
   204	            break;
   205	    }
   206	    return 0;
   207	}
   208	
   209	void compiler_init(Compiler *c) {
   210	    c->code_count = 0; c->local_count = 0; c->scope_depth = 0;
   211	    c->func_count = 0; c->in_function = 0;
   212	}
   213	
   214	int compile(Compiler *c, ASTNode *program) {
   215	    if (compile_node(c, program) < 0) return -1;
   216	    emit(c, BC_HALT, 0, NULL);
   217	    return 0;
   218	}
