[?2004hroot@n30009:/app# sed -n '378,478p' src/parser.c
[?2004lstatic ASTNode *parse_stmt(Parser *p) {
    if (match(p, TOK_LET)) {
        int line = prev(p)->line;
        expect(p, TOK_IDENT, "identifier");
        char name[MAX_IDENT_LEN];
        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
        expect(p, TOK_ASSIGN, "'='");
        ASTNode *init = parse_expr(p);
        expect(p, TOK_SEMICOLON, "';'");
        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;
        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);
        n->data.let.init = init; return n;
    }
    if (match(p, TOK_IF)) {
        int line = prev(p)->line;
        expect(p, TOK_LPAREN, "'('");
        ASTNode *cond = parse_expr(p);
        expect(p, TOK_RPAREN, "')'");
        ASTNode *then_b = parse_block(p);
        ASTNode *else_b = NULL;
        if (match(p, TOK_ELSE)) {
            if (check(p, TOK_IF)) {
                ASTNode *elif = parse_stmt(p);
                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;
                nodelist_init(&else_b->data.block.stmts);
                nodelist_push(&else_b->data.block.stmts, elif);
            } else {
                else_b = parse_block(p);
            }
        }
        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;
        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;
        return n;
    }
    if (match(p, TOK_WHILE)) {
        int line = prev(p)->line;
        expect(p, TOK_LPAREN, "'('");
        ASTNode *cond = parse_expr(p);
        expect(p, TOK_RPAREN, "')'");
        ASTNode *body = parse_block(p);
        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;
        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;
    }
    if (match(p, TOK_RETURN)) {
        int line = prev(p)->line;
        ASTNode *value = NULL;
        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);
        expect(p, TOK_SEMICOLON, "';'");
        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;
        n->data.ret.value = value; return n;
    }
    if (match(p, TOK_FOR)) {
        return parse_for(p);
    }
    if (match(p, TOK_BREAK)) {
        int line = prev(p)->line;
        expect(p, TOK_SEMICOLON, "';'");
        ASTNode *n = ast_alloc(); n->type = NODE_BREAK; n->line = line; return n;
    }
    if (match(p, TOK_CONTINUE)) {
        int line = prev(p)->line;
        expect(p, TOK_SEMICOLON, "';'");
        ASTNode *n = ast_alloc(); n->type = NODE_CONTINUE; n->line = line; return n;
    }
    if (match(p, TOK_PRINT)) {
        int line = prev(p)->line;
        ASTNode *value = parse_expr(p);
        expect(p, TOK_SEMICOLON, "';'");
        ASTNode *n = ast_alloc(); n->type = NODE_PRINT; n->line = line;
        n->data.print.value = value; return n;
    }
    if (match(p, TOK_FN)) {
        int line = prev(p)->line;
        expect(p, TOK_IDENT, "function name");
        char name[MAX_IDENT_LEN];
        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
        expect(p, TOK_LPAREN, "'('");
        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;
        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);
        n->data.func.param_count = 0;
        if (!check(p, TOK_RPAREN)) {
            do {
                expect(p, TOK_IDENT, "parameter name");
                strncpy(n->data.func.params[n->data.func.param_count],
                        prev(p)->text, MAX_IDENT_LEN - 1);
                n->data.func.param_count++;
            } while (match(p, TOK_COMMA));
        }
        expect(p, TOK_RPAREN, "')'");
        n->data.func.body = parse_block(p); return n;
    }
    if (check(p, TOK_IDENT)) {
        ASTNode *a = try_parse_assign(p);
        if (a) { expect(p, TOK_SEMICOLON, "';'"); return a; }
    }
    ASTNode *expr = parse_expr(p);
    expect(p, TOK_SEMICOLON, "';'");
    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;
    n->data.expr_stmt.expr = expr; return n;
}

