   155	int vm_run(VM *vm) {
   156	    while (vm->ip < vm->code_count) {
   157	        Instruction *ins = &vm->code[vm->ip++];
   158	        switch (ins->op) {
   159	            case BC_PUSH_INT: push(vm, make_int(ins->operand)); break;
   160	            case BC_PUSH_STR: push(vm, make_str(ins->str_operand)); break;
   161	            case BC_PUSH_BOOL: push(vm, make_bool((int)ins->operand)); break;
   162	            case BC_LOAD_LOCAL: {
   163	                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;
   164	                push(vm, vm->stack[base + (int)ins->operand]);
   165	                break;
   166	            }
   167	            case BC_STORE_LOCAL: {
   168	                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;
   169	                vm->stack[base + (int)ins->operand] = pop(vm);
   170	                break;
   171	            }
   172	            case BC_LOAD_GLOBAL: {
   173	                int idx = resolve_global(vm, ins->str_operand);
   174	                if (idx < 0) { fprintf(stderr, "undefined variable '%s'\n", ins->str_operand); return -1; }
   175	                push(vm, vm->globals[idx]);
   176	                break;
   177	            }
   178	            case BC_STORE_GLOBAL: {
   179	                int idx = resolve_global(vm, ins->str_operand);
   180	                if (idx < 0) idx = add_global(vm, ins->str_operand);
   181	                vm->globals[idx] = pop(vm);
   182	                break;
   183	            }
   184	            case BC_ADD: {
   185	                Value b = pop(vm); Value a = pop(vm);
   186	                if (a.type == VAL_STR || b.type == VAL_STR) {
   187	                    char bufa[64], bufb[64];
   188	                    const char *sa = value_to_cstr(a, bufa, sizeof(bufa));
   189	                    const char *sb = value_to_cstr(b, bufb, sizeof(bufb));
   190	                    char *r = malloc(strlen(sa) + strlen(sb) + 1);
   191	                    strcpy(r, sa); strcat(r, sb);
   192	                    Value v; v.type = VAL_STR; v.data.sval = r; push(vm, v);
   193	                } else { push(vm, make_int(value_to_int(a) + value_to_int(b))); }
   194	                break;
   195	            }
   196	            case BC_SUB: { Value b = pop(vm); Value a = pop(vm);
   197	                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {
   198	                    fprintf(stderr, "operator '-' expects integers\n");
   199	                    return -1;
