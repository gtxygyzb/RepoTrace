   276	            step = try_parse_assign(p);
   277	        }
   278	        if (!step) step = parse_expr(p);
   279	    }
   280	    expect(p, TOK_RPAREN, "')'");
   281	
   282	    ASTNode *body = parse_block(p);
   283	    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;
   284	    n->data.for_stmt.init = init;
   285	    n->data.for_stmt.cond = cond;
   286	    n->data.for_stmt.step = step;
   287	    n->data.for_stmt.body = body;
   288	    return n;
   289	}
   290	
   291	static ASTNode *parse_block(Parser *p) {
   292	    expect(p, TOK_LBRACE, "'{'");
   293	    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;
   294	    nodelist_init(&block->data.block.stmts);
   295	    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {
   296	        ASTNode *stmt = parse_stmt(p);
   297	        if (stmt) nodelist_push(&block->data.block.stmts, stmt);
   298	        if (p->had_error) break;
   299	    }
   300	    expect(p, TOK_RBRACE, "'}'");
   301	    return block;
   302	}
   303	
   304	static ASTNode *parse_stmt(Parser *p) {
   305	    if (match(p, TOK_LET)) {
   306	        int line = prev(p)->line;
   307	        expect(p, TOK_IDENT, "identifier");
   308	        char name[MAX_IDENT_LEN];
   309	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   310	        expect(p, TOK_ASSIGN, "'='");
   311	        ASTNode *init = parse_expr(p);
   312	        expect(p, TOK_SEMICOLON, "';'");
   313	        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;
   314	        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);
   315	        n->data.let.init = init; return n;
   316	    }
   317	    if (match(p, TOK_IF)) {
   318	        int line = prev(p)->line;
   319	        expect(p, TOK_LPAREN, "'('");
   320	        ASTNode *cond = parse_expr(p);
   321	        expect(p, TOK_RPAREN, "')'");
   322	        ASTNode *then_b = parse_block(p);
   323	        ASTNode *else_b = NULL;
   324	        if (match(p, TOK_ELSE)) {
   325	            if (check(p, TOK_IF)) {
   326	                ASTNode *elif = parse_stmt(p);
   327	                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;
   328	                nodelist_init(&else_b->data.block.stmts);
   329	                nodelist_push(&else_b->data.block.stmts, elif);
   330	            } else {
   331	                else_b = parse_block(p);
   332	            }
   333	        }
   334	        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;
   335	        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;
   336	        return n;
   337	    }
   338	    if (match(p, TOK_WHILE)) {
   339	        int line = prev(p)->line;
   340	        expect(p, TOK_LPAREN, "'('");
   341	        ASTNode *cond = parse_expr(p);
   342	        expect(p, TOK_RPAREN, "')'");
   343	        ASTNode *body = parse_block(p);
   344	        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;
   345	        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;
   346	    }
   347	    if (match(p, TOK_RETURN)) {
   348	        int line = prev(p)->line;
   349	        ASTNode *value = NULL;
   350	        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);
   351	        expect(p, TOK_SEMICOLON, "';'");
   352	        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;
   353	        n->data.ret.value = value; return n;
   354	    }
   355	    if (match(p, TOK_FOR)) {
   356	        return parse_for(p);
   357	    }
   358	    if (match(p, TOK_BREAK)) {
   359	        int line = prev(p)->line;
   360	        expect(p, TOK_SEMICOLON, "';'");
   361	        ASTNode *n = ast_alloc(); n->type = NODE_BREAK; n->line = line; return n;
   362	    }
   363	    if (match(p, TOK_CONTINUE)) {
   364	        int line = prev(p)->line;
   365	        expect(p, TOK_SEMICOLON, "';'");
   366	        ASTNode *n = ast_alloc(); n->type = NODE_CONTINUE; n->line = line; return n;
   367	    }
   368	    if (match(p, TOK_PRINT)) {
   369	        int line = prev(p)->line;
   370	        ASTNode *value = parse_expr(p);
   371	        expect(p, TOK_SEMICOLON, "';'");
   372	        ASTNode *n = ast_alloc(); n->type = NODE_PRINT; n->line = line;
   373	        n->data.print.value = value; return n;
   374	    }
   375	    if (match(p, TOK_FN)) {
   376	        int line = prev(p)->line;
   377	        expect(p, TOK_IDENT, "function name");
   378	        char name[MAX_IDENT_LEN];
   379	        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\0';
   380	        expect(p, TOK_LPAREN, "'('");
   381	        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;
   382	        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);
   383	        n->data.func.param_count = 0;
   384	        if (!check(p, TOK_RPAREN)) {
   385	            do {
   386	                expect(p, TOK_IDENT, "parameter name");
   387	                strncpy(n->data.func.params[n->data.func.param_count],
   388	                        prev(p)->text, MAX_IDENT_LEN - 1);
   389	                n->data.func.param_count++;
   390	            } while (match(p, TOK_COMMA));
   391	        }
   392	        expect(p, TOK_RPAREN, "')'");
   393	        n->data.func.body = parse_block(p); return n;
   394	    }
   395	    if (check(p, TOK_IDENT)) {
   396	        ASTNode *a = try_parse_assign(p);
   397	        if (a) { expect(p, TOK_SEMICOLON, "';'"); return a; }
   398	    }
   399	    ASTNode *expr = parse_expr(p);
   400	    expect(p, TOK_SEMICOLON, "';'");
   401	    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;
   402	    n->data.expr_stmt.expr = expr; return n;
   403	}
