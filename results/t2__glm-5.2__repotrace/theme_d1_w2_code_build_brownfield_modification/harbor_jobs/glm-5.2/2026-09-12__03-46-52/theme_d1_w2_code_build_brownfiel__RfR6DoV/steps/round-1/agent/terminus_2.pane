   250	static ASTNode *parse_block(Parser *p) {
   251	    expect(p, TOK_LBRACE, "'{'");
   252	    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;
   253	    nodelist_init(&block->data.block.stmts);
   254	    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {
   255	        ASTNode *stmt = parse_stmt(p);
   256	        if (stmt) nodelist_push(&block->data.block.stmts, stmt);
   257	        if (p->had_error) break;
   258	    }
   259	    expect(p, TOK_RBRACE, "'}'");
   260	    return block;
   261	}
