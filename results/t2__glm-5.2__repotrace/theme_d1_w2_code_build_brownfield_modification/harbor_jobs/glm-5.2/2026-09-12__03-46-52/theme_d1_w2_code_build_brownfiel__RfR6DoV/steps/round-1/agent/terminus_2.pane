                else push(vm, make_int(0));
                break;
            }
            case BC_ARRAY_GET: {
                Value idx = pop(vm); Value arr = pop(vm);
                if (arr.type == VAL_MAP) {
                    char buf[64]; const char *key = value_to_key(idx, buf, sizeof(buf));
                    int i = map_find(arr.data.map, key);
                    if (i < 0) { fprintf(stderr, "key not found: %s\n", key); return -1; }
                    push(vm, arr.data.map->values[i]);
                } else if (arr.type == VAL_ARRAY) {
                    int i = (int)value_to_int(idx);
                    if (i < 0 || i >= arr.data.array.len) { fprintf(stderr, "index out of bounds: %d\n", i); return -1; }
                    push(vm, arr.data.array.items[i]);
                } else { fprintf(stderr, "cannot index non-array/map\n"); return -1; }
                break;
            }
            case BC_INDEX_STORE: {
                Value val = pop(vm); Value idx = pop(vm); Value obj = pop(vm);
                if (obj.type == VAL_MAP) {
                    char buf[64]; const char *key = value_to_key(idx, buf, sizeof(buf));
                    map_set(obj.data.map, key, val);
                } else if (obj.type == VAL_ARRAY) {
                    int i = (int)value_to_int(idx);
                    if (i < 0 || i >= obj.data.array.len) { fprintf(stderr, "index out of bounds: %d\n", i); return -1; }
                    obj.data.array.items[i] = val;
                } else { fprintf(stderr, "cannot index assign non-array/map\n"); return -1; }
                break;
            }
            case BC_PUSH_MAP: {
                int count = (int)ins->operand;
                Value mv = make_map();
                for (int i = 0; i < count; i++) {
                    Value val = pop(vm);
                    Value keyv = pop(vm);
                    char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));
                    map_set(mv.data.map, key, val);
                }
                push(vm, mv); break;
            }
            case BC_MAP_GET: {
                Value keyv = pop(vm); Value obj = pop(vm);
                if (obj.type != VAL_MAP) { fprintf(stderr, "cannot get field of non-map\n"); return -1; }
                char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));
                int i = map_find(obj.data.map, key);
                if (i < 0) { fprintf(stderr, "key not found: %s\n", key); return -1; }
                push(vm, obj.data.map->values[i]); break;
            }
            case BC_MAP_SET: {
                Value val = pop(vm); Value keyv = pop(vm); Value obj = pop(vm);
                if (obj.type != VAL_MAP) { fprintf(stderr, "cannot set field on non-map\n"); return -1; }
                char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));
                map_set(obj.data.map, key, val); break;
            }
            case BC_MAP_KEYS: {
                Value obj = pop(vm);
                if (obj.type != VAL_MAP) { fprintf(stderr, "keys() expects a map\n"); return -1; }
                Value arr; arr.type = VAL_ARRAY; arr.data.array.len = obj.data.map->len;
                arr.data.array.items = malloc(obj.data.map->len * sizeof(Value));
                for (int i = 0; i < obj.data.map->len; i++) arr.data.array.items[i] = make_str(obj.data.map->keys[i]);
                push(vm, arr); break;
            }
            case BC_MAP_HAS: {
                Value keyv = pop(vm); Value obj = pop(vm);
                if (obj.type != VAL_MAP) { fprintf(stderr, "has() expects a map\n"); return -1; }
                char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));
                push(vm, make_bool(map_find(obj.data.map, key) >= 0)); break;
            }
            case BC_MAP_DELETE: {
                Value keyv = pop(vm); Value obj = pop(vm);
                if (obj.type != VAL_MAP) { fprintf(stderr, "delete() expects a map\n"); return -1; }
                char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));
                push(vm, make_bool(map_delete(obj.data.map, key))); break;
            }
            case BC_MAP_LEN: {
                Value obj = pop(vm);
                if (obj.type != VAL_MAP) push(vm, make_int(0));
                else push(vm, make_int(obj.data.map ? obj.data.map->len : 0));
                break;
            }
            case BC_ITER_KEY: {
                Value idx = pop(vm); Value arr = pop(vm);
                if (arr.type == VAL_MAP) {
                    int i = (int)value_to_int(idx);
                    if (i < 0 || i >= arr.data.map->len) { fprintf(stderr, "map index out of bounds: %d\n", i); return -1; }
                    push(vm, make_str(arr.data.map->keys[i]));
                } else {
                    push(vm, idx);
                }
                break;
            }
            case BC_HALT: return 0;
            default: fprintf(stderr, "unknown opcode %d\n", ins->op); return -1;
        }
    }
    return 0;
}
