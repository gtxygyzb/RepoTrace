[7721.095423, "o", " 22\t}\r\n    23\t\r\n    24\tstatic int map_find(MapData *m, const char *key) {\r\n    25\t    for (int i = 0; i < m->len; i++) if (strcmp(m->keys[i], key) == 0) return i;\r\n    26\t    return -1;\r\n    27\t}\r\n    28\t\r\n    29\tstatic void map_set(MapData *m, const char *key, Value v) {\r\n    30\t    int i = map_find(m, key);\r\n    31\t    if (i >= 0) { m->values[i] = v; return; }\r\n    32\t    if (m->len >= m->cap) {\r\n    33\t        int cap = m->cap == 0 ? 8 : m->cap * 2;\r\n    34\t        m->keys = realloc(m->keys, cap * sizeof(char*));\r\n    35\t        m->values = realloc(m->values, cap * sizeof(Value));\r\n    36\t        m->cap = cap;\r\n    37\t    }\r\n    38\t    m->keys[m->len] = strdup(key);\r\n    39\t    m->values[m->len] = v;\r\n    40\t    m->len++;\r\n    41\t}\r\n    42\t\r\n    43\tstatic int map_delete(MapData *m, const char *key) {\r\n    44\t    int i = map_find(m, key);\r\n    45\t    if (i < 0) return 0;\r\n    46\t    free(m->keys[i]);\r\n    47\t    for (int j = i; j < m->len - 1; j++) { m->keys[j] = m->keys[j+1]; m->values[j] = m->values[j+1];"]
[7721.095504, "o", " }\r\n    48\t    m->len--;\r\n    49\t    return 1;\r\n    50\t}\r\n    51\t\r\n    52\t\r\n    53\tstatic int resolve_global(VM *vm, const char *name) {\r\n    54\t    for (int i = 0; i < vm->global_count; i++)\r\n    55\t        if (strcmp(vm->global_names[i], name) == 0) return i;\r\n    56\t    return -1;\r\n    57\t}\r\n    58\t\r\n    59\tstatic int add_global(VM *vm, const char *name) {\r\n    60\t    if (vm->global_count >= MAX_GLOBALS) { fprintf(stderr, \"too many globals\\n\"); return -1; }\r\n    61\t    int idx = vm->global_count;\r\n    62\t    strncpy(vm->global_names[idx], name, MAX_IDENT_LEN - 1);\r\n    63\t    vm->globals[idx].type = VAL_NULL;\r\n    64\t    vm->global_count++;\r\n    65\t    return idx;\r\n    66\t}\r\n    67\t\r\n    68\tstatic int64_t value_to_int(Value v) {\r\n    69\t    if (v.type == VAL_REF) return value_to_int(*v.data.ref);\r\n    70\t    switch (v.type) { case VAL_INT: return v.data.ival; case VAL_BOOL: return v.data.bval ? 1 : 0; default: return 0; }\r\n    71\t}\r\n    72\t\r\n    73\tstatic int value_is_integer_like(Value v) {\r\n    74\t    if"]
[7721.095571, "o", " (v.type == VAL_REF) return value_is_integer_like(*v.data.ref);\r\n    75\t    return v.type == VAL_INT || v.type == VAL_BOOL;\r\n    76\t}\r\n    77\t\r\n    78\tstatic int value_truthy(Value v) {\r\n    79\t    if (v.type == VAL_REF) return value_truthy(*v.data.ref);\r\n    80\t    switch (v.type) {\r\n    81\t        case VAL_INT: return v.data.ival != 0;\r\n    82\t        case VAL_BOOL: return v.data.bval;\r\n    83\t        case VAL_STR: return v.data.sval && v.data.sval[0] != '\\0';\r\n    84\t        case VAL_ARRAY: return v.data.array.len > 0;\r\n    85\t        case VAL_MAP: return v.data.map && v.data.map->len > 0;\r\n    86\t        case VAL_NULL: return 0;\r\n    87\t    }\r\n    88\t    return 0;\r\n    89\t}\r\n    90\t\r\n    91\tstatic int values_equal(Value a, Value b) {\r\n    92\t    if (a.type == VAL_REF) return values_equal(*a.data.ref, b);\r\n    93\t    if (b.type == VAL_REF) return values_equal(a, *b.data.ref);\r\n    94\t    if (a.type != b.type) return 0;\r\n    95\t    switch (a.type) {\r\n    96\t        case VAL_INT: return a.data.ival == b.data"]
[7721.095638, "o", ".ival;\r\n    97\t        case VAL_BOOL: return a.data.bval == b.data.bval;\r\n    98\t        case VAL_STR: return strcmp(a.data.sval, b.data.sval) == 0;\r\n    99\t        case VAL_NULL: return 1;\r\n   100\t        default: return 0;\r\n   101\t    }\r\n   102\t}\r\n   103\t\r\n   104\tstatic const char *value_to_cstr(Value v, char *buf, size_t size) {\r\n   105\t    if (v.type == VAL_REF) return value_to_cstr(*v.data.ref, buf, size);\r\n   106\t    switch (v.type) {\r\n   107\t        case VAL_STR: return v.data.sval;\r\n   108\t        case VAL_INT: snprintf(buf, size, \"%lld\", (long long)v.data.ival); return buf;\r\n   109\t        case VAL_BOOL: return v.data.bval ? \"true\" : \"false\";\r\n   110\t        case VAL_NULL: return \"null\";\r\n   111\t        default: return \"\";\r\n   112\t    }\r\n   113\t}\r\n   114\t\r\n   115\tstatic const char *value_to_key(Value v, char *buf, size_t size) {\r\n   116\t    if (v.type == VAL_STR) return v.data.sval;\r\n   117\t    return value_to_cstr(v, buf, size);\r\n   118\t}\r\n   119\t\r\n   120\tstatic int value_cmp(Value a, Value b) {\r\n  "]
