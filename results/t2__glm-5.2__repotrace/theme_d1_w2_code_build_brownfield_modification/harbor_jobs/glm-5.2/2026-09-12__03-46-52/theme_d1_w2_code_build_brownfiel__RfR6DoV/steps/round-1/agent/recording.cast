[9805.857263, "o", "    85\t    int line;\r\n    86\t    union {\r\n    87\t        int64_t num_val;\r\n    88\t        char str_val[MAX_STRING_LEN];\r\n    89\t        int bool_val;\r\n    90\t        char ident[MAX_IDENT_LEN];\r\n    91\t        struct { BinOp op; struct ASTNode *left, *right; } binop;\r\n    92\t        struct { UnaryOp op; struct ASTNode *operand; } unary;\r\n    93\t        struct { char name[MAX_IDENT_LEN]; NodeList args; } call;\r\n    94\t        struct { struct ASTNode *obj; struct ASTNode *index; } index_access;\r\n    95\t        struct { char name[MAX_IDENT_LEN]; struct ASTNode *value; } assign;\r\n    96\t    struct { char name[MAX_IDENT_LEN]; BinOp op; struct ASTNode *value; } compound_assign;\r\n    97\t        struct { char name[MAX_IDENT_LEN]; struct ASTNode *obj; struct ASTNode *index; struct ASTNode *value; } index_assign;\r\n    98\t        struct { char name[MAX_IDENT_LEN]; struct ASTNode *init; } let;\r\n    99\t        struct { struct ASTNode *cond, *then_b, *else_b; } if_stmt;\r\n   100\t        struct { struct ASTNode *cond, *body; "]
[9805.857355, "o", "} while_stmt;\r\n   101\t    struct { struct ASTNode *init, *cond, *step, *body; } for_stmt;\r\n   102\t    struct { char var[MAX_IDENT_LEN]; struct ASTNode *arr; struct ASTNode *body; int is_of; } foreach_stmt;\r\n   103\t        struct { struct ASTNode *value; } ret;\r\n   104\t        struct { struct ASTNode *value; } print;\r\n   105\t        struct { NodeList stmts; } block;\r\n   106\t        struct { char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } closure;\r\n   107\t        struct { char name[MAX_IDENT_LEN]; char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } func;\r\n   108\t        struct { NodeList elems; } array_lit;\r\n   109\t        struct { NodeList keys; NodeList values; } map_lit;\r\n   110\t"]
