[8268.747803, "o", "static int compile_node(Compiler *c, ASTNode *node) {\r\n    switch (node->type) {\r\n        case NODE_LET: {\r\n            int slot = add_local(c, node->data.let.name);\r\n            if (slot < 0) return -1;\r\n            compile_expr(c, node->data.let.init);\r\n            break;\r\n        }"]
[8268.747938, "o", "\r\n        case NODE_ASSIGN: {\r\n            compile_expr(c, node->data.assign.value);\r\n            compile_store(c, node->data.assign.name);\r\n            break;\r\n        }\r\n        case NODE_INDEX_ASSIGN: {\r\n            if (node->data.index_assign.obj) {\r\n                compile_expr(c, node->data.index_assign.obj);\r\n                compile_expr(c, node->data.index_assign.index);\r\n                compile_expr(c, node->data.index_assign.value);\r\n                emit(c, BC_INDEX_STORE, 0, NULL);\r\n"]
[8268.748019, "o", "            } else {\r\n                compile_load(c, node->data.index_assign.name);\r\n                compile_expr(c, node->data.index_assign.index);\r\n                compile_expr(c, node->data.index_assign.value);\r\n                emit(c, BC_INDEX_STORE, 0, NULL);\r\n            }\r\n            break;\r\n        }\r\n        case NODE_FIELD_ASSIGN: {\r\n            compile_expr(c, node->data.field_assign.obj);\r\n            emit(c, BC_PUSH_STR, 0, strdup(node->data.field_assign.field));\r\n            compile_expr(c, node->data.field_assign.value);\r\n            emit(c, BC_MAP_SET, 0, NULL);\r\n            break;\r\n        }\r\n        case NODE_IF: {\r\n            compile_expr(c, node->data.if_stmt.cond);\r\n            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n            compile_node(c, node->data.if_stmt.then_b);\r\n            if (node->data.if_stmt.else_b) {\r\n                int je = emit(c, BC_JUMP, 0, NULL);\r\n                c->code[jf].operand = c->code_count;\r\n                compile_node(c, node->data.if_stmt.else_b);\r"]
[8268.748092, "o", "\n                c->code[je].operand = c->code_count;\r\n            } else {\r\n                c->code[jf].operand = c->code_count;\r\n            }\r\n            break;\r\n        }\r\n        case NODE_WHILE: {\r\n            int loop_start = c->code_count;\r\n            compile_expr(c, node->data.while_stmt.cond);\r\n            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n            ctx->start = loop_start; ctx->cont = loop_start; ctx->end = -1;\r\n            ctx->break_count = 0; ctx->cont_count = 0;\r\n            compile_node(c, node->data.while_stmt.body);\r\n            emit(c, BC_JUMP, loop_start, NULL);\r\n            int end = c->code_count;\r\n            c->code[jf].operand = end;\r\n            ctx->end = end;\r\n            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;\r\n            for (int i = 0; i < ctx->cont_count; i++) c"]
[8268.748159, "o", "->code[ctx->conts[i]].operand = ctx->cont;\r\n            loop_depth--;\r\n            break;\r\n        }\r\n        case NODE_FOR: {\r\n            int old_lc = c->local_count;\r\n            c->scope_depth++;\r\n            if (node->data.for_stmt.init) compile_node(c, node->data.for_stmt.init);\r\n            int loop_start = c->code_count;\r\n"]
[8268.748251, "o", "            if (node->data.for_stmt.cond) compile_expr(c, node->data.for_stmt.cond);\r\n            else emit(c, BC_PUSH_BOOL, 1, NULL);\r\n            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\r\n            ctx->break_count = 0; ctx->cont_count = 0;\r\n            compile_node(c, node->data.for_stmt.body);\r\n            int step_start = c->code_count;\r\n            ctx->cont = step_start;\r\n            if (node->data.for_stmt.step) compile_node(c, node->data.for_stmt.step);\r\n            emit(c, BC_JUMP, loop_start, NULL);\r\n            int end = c->code_count;\r\n            c->code[jf].operand = end;\r\n            ctx->end = end;\r\n            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;\r\n            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->co"]
[8268.748322, "o", "nts[i]].operand = step_start;\r\n            loop_depth--;\r\n            int n = c->local_count - old_lc;\r\n            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n            c->local_count = old_lc;\r\n            c->scope_depth--;\r\n            break;\r\n        }\r\n        case NODE_FOREACH: {\r\n            int old_lc = c->local_count;\r\n            c->scope_depth++;\r\n            compile_expr(c, node->data.foreach_stmt.arr);\r\n            int arr_slot = add_local(c, \".forarr\");\r\n            emit(c, BC_PUSH_INT, 0, NULL);\r\n            int idx_slot = add_local(c, \".foridx\");\r\n"]
[8268.748398, "o", "            int var_slot = add_local(c, node->data.foreach_stmt.var);\r\n            emit(c, BC_PUSH_INT, 0, NULL);\r\n            int loop_start = c->code_count;\r\n            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n            emit(c, BC_LOAD_LOCAL, arr_slot, NULL);\r\n            emit(c, BC_ARRAY_LEN, 0, NULL);\r\n            emit(c, BC_LT, 0, NULL);\r\n            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\r\n"]
[8268.748489, "o", "            ctx->break_count = 0; ctx->cont_count = 0;\r\n            int body_old = c->local_count;\r\n            if (node->data.foreach_stmt.is_of) {\r\n                emit(c, BC_LOAD_LOCAL, arr_slot, NULL);\r\n                emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n                emit(c, BC_INDEX, 0, NULL);\r\n            } else {\r\n                emit(c, BC_LOAD_LOCAL, arr_slot, NULL);\r\n                emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n                emit(c, BC_ITER_KEY, 0, NULL);\r\n            }\r\n            emit(c, BC_STORE_LOCAL, var_slot, NULL);\r\n            compile_node(c, node->data.foreach_stmt.body);\r\n            int n = c->local_count - body_old;\r\n            int cleanup_start = c->code_count;\r\n            ctx->cont = cleanup_start;\r\n            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n            c->local_count = body_old;\r\n            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n            emit(c, BC_PUSH_INT, 1, NULL);\r\n"]
[8268.748555, "o", "            emit(c, BC_ADD, 0, NULL);\r\n            emit(c, BC_STORE_LOCAL, idx_slot, NULL);\r\n            emit(c, BC_JUMP, loop_start, NULL);\r\n            int break_cleanup = c->code_count;\r\n            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n            int end = c->code_count;\r\n            c->code[jf].operand = end;\r\n            ctx->end = end;\r\n            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = break_cleanup;\r\n            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = ctx->cont;\r\n            loop_depth--;\r\n"]
[8268.748623, "o", "            int n2 = c->local_count - old_lc;\r\n            for (int i = 0; i < n2; i++) emit(c, BC_POP, 0, NULL);\r\n            c->local_count = old_lc;\r\n            c->scope_depth--;\r\n            break;\r\n        }\r\n        case NODE_BREAK: {\r\n            if (loop_depth <= 0) { error_at(node->line, \"break outside loop\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth - 1];\r\n            if (ctx->break_count >= MAX_LOOP_JUMPS) { error_at(node->line, \"too many break statements\"); return -1; }\r\n            ctx->breaks[ctx->break_count++] = emit(c, BC_JUMP, 0, NULL);\r\n            break;\r\n"]
[8268.748687, "o", "        }\r\n        case NODE_CONTINUE: {\r\n            if (loop_depth <= 0) { error_at(node->line, \"continue outside loop\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth - 1];\r\n            if (ctx->cont_count >= MAX_LOOP_JUMPS) { error_at(node->line, \"too many continue statements\"); return -1; }\r\n            ctx->conts[ctx->cont_count++] = emit(c, BC_JUMP, 0, NULL);\r\n            break;\r\n        }\r\n        case NODE_COMPOUND_ASSIGN: {\r\n            compile_load(c, node->data.compound_assign.name);\r\n            compile_expr(c, node->data.compound_assign.value);\r\n"]
[8268.748751, "o", "            switch (node->data.compound_assign.op) {\r\n                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;\r\n                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;\r\n                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;\r\n                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;\r\n                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;\r\n                default: error_at(node->line, \"invalid compound assignment\"); return -1;\r\n            }\r\n            compile_store(c, node->data.compound_assign.name);\r\n            break;\r\n        }\r\n        case NODE_RETURN: {\r\n            if (node->data.ret.value) compile_expr(c, node->data.ret.value);\r\n            else emit(c, BC_PUSH_INT, 0, NULL);\r\n"]
[8268.748819, "o", "            emit(c, BC_RET, 0, NULL);\r\n            break;\r\n        }\r\n        case NODE_PRINT: {\r\n            compile_expr(c, node->data.print.value);\r\n            emit(c, BC_PRINT, 0, NULL);\r\n"]
[8268.748899, "o", "            break;\r\n        }\r\n        case NODE_BLOCK: {\r\n            int old_lc = c->local_count;\r\n            c->scope_depth++;\r\n            for (int i = 0; i < node->data.block.stmts.count; i++)\r\n                compile_node(c, node->data.block.stmts.items[i]);\r\n            c->scope_depth--;\r\n            {\r\n                int n = c->local_count - old_lc;\r\n                for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n            }\r\n            c->local_count = old_lc;\r\n            break;\r\n        }\r\n        case NODE_FUNC: {\r\n            int jump_over = emit(c, BC_JUMP, 0, NULL);\r\n\r\n            if (c->func_count >= MAX_FUNCTIONS) { fprintf(stderr, \"too many functions\\n\"); return -1; }\r\n            FuncInfo *fi = &c->functions[c->func_count];\r\n            strncpy(fi->name, node->data.func.name, MAX_IDENT_LEN - 1);\r\n            fi->addr = c->code_count;\r\n            fi->param_count = node->data.func.param_count;\r\n"]
[8268.748966, "o", "            c->func_count++;\r\n\r\n            int old_lc = c->local_count;\r\n            int old_scope = c->scope_depth;\r\n            int old_inf = c->in_function;\r\n            int old_loop_depth = loop_depth;\r\n            int old_cap_count = c->capture_count;\r\n            CaptureInfo old_captures[MAX_LOCALS];\r\n            memcpy(old_captures, c->captures, sizeof(old_captures));\r\n            Local old_locals[MAX_LOCALS];\r\n            memcpy(old_locals, c->locals, sizeof(old_locals));\r\n            loop_depth = 0;\r\n\r\n            c->local_count = 0;\r\n            c->scope_depth = 0;\r\n            c->in_function = 1;\r\n"]
[8268.749033, "o", "            c->scope_depth++;\r\n            c->capture_count = 0;\r\n\r\n            for (int i = 0; i < node->data.func.param_count; i++)\r\n                add_local(c, node->data.func.params[i]);\r\n\r\n            compile_node(c, node->data.func.body);\r\n\r\n            emit(c, BC_PUSH_INT, 0, NULL);\r\n            emit(c, BC_RET, 0, NULL);\r\n\r\n"]
[8268.749142, "o", "            c->scope_depth = old_scope;\r\n            c->local_count = old_lc;\r\n            c->in_function = old_inf;\r\n            loop_depth = old_loop_depth;\r\n            c->capture_count = old_cap_count;\r\n            memcpy(c->captures, old_captures, sizeof(old_captures));\r\n            memcpy(c->locals, old_locals, sizeof(old_locals));\r\n\r\n            c->code[jump_over].operand = c->code_count;\r\n            break;\r\n        }\r\n        case NODE_EXPR_STMT: {\r\n            compile_expr(c, node->data.expr_stmt.expr);\r\n            emit(c, BC_POP, 0, NULL);\r\n            break;\r\n        }\r\n        default:\r\n            compile_expr(c, node);\r\n            emit(c, BC_POP, 0, NULL);\r\n            break;\r\n    }\r\n    return 0;\r\n}\r\n"]
[8268.749233, "o", "\r\nvoid compiler_init(Compiler *c) {\r\n    c->code_count = 0; c->local_count = 0; c->scope_depth = 0;\r\n    c->func_count = 0; c->in_function = 0; c->capture_count = 0;\r\n}\r\n\r\nint compile(Compiler *c, ASTNode *program) {\r\n    if (compile_node(c, program) < 0) return -1;\r\n    emit(c, BC_HALT, 0, NULL);\r\n    return 0;\r\n}\r\n"]
[8268.749761, "o", "\u001b[?2004h"]
[8268.74984, "o", "root@n30009:/app# "]
[8273.926715, "i", "sed -n '50,115p' src/common.h\n"]
[8273.926934, "o", "sed -n '50,115p' src/common.h\r\n\u001b[?2004l\r"]
[8273.929845, "o", "typedef enum {\r\n    NODE_NUM_LIT, NODE_STR_LIT, NODE_BOOL_LIT,\r\n    NODE_IDENT, NODE_BINOP, NODE_UNARY,\r\n    NODE_CALL, NODE_INDEX,\r\n    NODE_ASSIGN, NODE_LET,\r\n    NODE_IF, NODE_WHILE, NODE_FOR, NODE_FOREACH,\r\n    NODE_RETURN, NODE_BREAK, NODE_CONTINUE,\r\n    NODE_PRINT, NODE_BLOCK, NODE_FUNC,\r\n    NODE_ARRAY_LIT, NODE_MAP_LIT, NODE_FIELD_ACCESS, NODE_FIELD_ASSIGN,\r\n    NODE_EXPR_STMT,\r\n    NODE_COMPOUND_ASSIGN, NODE_INDEX_ASSIGN, NODE_CLOSURE, NODE_METHOD_CALL\r\n"]
[8273.930003, "o", "} NodeType;\r\n\r\ntypedef enum {\r\n    OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_MOD,\r\n    OP_EQ, OP_NEQ, OP_LT, OP_GT, OP_LEQ, OP_GEQ,\r\n    OP_AND, OP_OR\r\n} BinOp;\r\n\r\ntypedef enum {\r\n    UNOP_NEG, UNOP_NOT\r\n} UnaryOp;\r\n\r\nstruct ASTNode;\r\n\r\ntypedef struct {\r\n    struct ASTNode **items;\r\n    int count;\r\n    int cap;\r\n} NodeList;\r\n\r\ntypedef struct ASTNode {\r\n    NodeType type;\r\n    int line;\r\n    union {\r\n        int64_t num_val;\r\n        char str_val[MAX_STRING_LEN];\r\n        int bool_val;\r\n        char ident[MAX_IDENT_LEN];\r\n        struct { BinOp op; struct ASTNode *left, *right; } binop;\r\n        struct { UnaryOp op; struct ASTNode *operand; } unary;\r\n        struct { char name[MAX_IDENT_LEN]; NodeList args; } call;\r\n        struct { struct ASTNode *obj; struct ASTNode *index; } index_access;\r\n        struct { char name[MAX_IDENT_LEN]; struct ASTNode *value; } assign;\r\n"]
[8273.930105, "o", "    struct { char name[MAX_IDENT_LEN]; BinOp op; struct ASTNode *value; } compound_assign;\r\n        struct { char name[MAX_IDENT_LEN]; struct ASTNode *obj; struct ASTNode *index; struct ASTNode *value; } index_assign;\r\n        struct { char name[MAX_IDENT_LEN]; struct ASTNode *init; } let;\r\n        struct { struct ASTNode *cond, *then_b, *else_b; } if_stmt;\r\n        struct { struct ASTNode *cond, *body; } while_stmt;\r\n    struct { struct ASTNode *init, *cond, *step, *body; } for_stmt;\r\n    struct { char var[MAX_IDENT_LEN]; struct ASTNode *arr; struct ASTNode *body; int is_of; } foreach_stmt;\r\n        struct { struct ASTNode *value; } ret;\r\n        struct { struct ASTNode *value; } print;\r\n        struct { NodeList stmts; } block;\r\n        struct { char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } closure;\r\n        struct { char name[MAX_IDENT_LEN]; char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } func;\r\n        struct { NodeList elems; } array_lit"]
[8273.930264, "o", ";\r\n        struct { NodeList keys; NodeList values; } map_lit;\r\n        struct { struct ASTNode *obj; char field[MAX_IDENT_LEN]; } field_access;\r\n        struct { struct ASTNode *obj; char field[MAX_IDENT_LEN]; struct ASTNode *value; } field_assign;\r\n        struct { struct ASTNode *obj; char method[MAX_IDENT_LEN]; NodeList args; } method_call;\r\n        struct { struct ASTNode *expr; } expr_stmt;\r\n    } data;\r\n} ASTNode;\r\n\r\ntypedef enum {\r\n"]
