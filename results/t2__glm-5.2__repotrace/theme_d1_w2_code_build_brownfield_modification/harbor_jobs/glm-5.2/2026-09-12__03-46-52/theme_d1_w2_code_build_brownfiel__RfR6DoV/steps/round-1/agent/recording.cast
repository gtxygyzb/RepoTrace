[5999.87313, "o", " BC_ADD, BC_SUB, BC_MUL, BC_DIV, BC_MOD,\r\n    BC_EQ, BC_NEQ, BC_LT, BC_GT, BC_LEQ, BC_GEQ,\r\n    BC_AND, BC_OR, BC_NOT, BC_NEG,\r\n    BC_JUMP, BC_JUMP_FALSE,\r\n    BC_CALL, BC_RET,\r\n    BC_PRINT, BC_POP,\r\n    BC_PUSH_ARRAY, BC_INDEX, BC_INDEX_STORE, BC_ARRAY_PUSH,\r\n    BC_DUP, BC_JUMP_TRUE,\r\n    BC_MAKE_CLOSURE, BC_CALL_VALUE,\r\n    BC_LOAD_CAPTURE, BC_STORE_CAPTURE,\r\n    BC_HALT,\r\n    BC_ARRAY_LEN, BC_ARRAY_GET,\r\n    BC_PUSH_MAP, BC_MAP_GET, BC_MAP_SET, BC_MAP_KEYS, BC_MAP_HAS, BC_MAP_DELETE, BC_MAP_LEN,\r\n    BC_ITER_KEY,\r\n    BC_BREAK, BC_CONTINUE,\r\n    BC_FOREACH_PREP, BC_FOREACH_NEXT\r\n} Opcode;\r\n\r\ntypedef enum {\r\n    VAL_INT, VAL_STR, VAL_BOOL, VAL_ARRAY, VAL_CLOSURE, VAL_MAP, VAL_NULL\r\n} ValueType;\r\n\r\ntypedef struct ArrayData {\r\n    struct Value *items;\r\n    int len;\r\n    int cap;\r\n} ArrayData;\r\n\r\ntypedef struct MapData {\r\n    char **keys;\r\n    struct Value *values;\r\n    int len;\r\n    int cap;\r\n} MapData;\r\n\r\ntypedef struct Value {\r\n    ValueType type;\r\n    union {\r\n        int64_t ival;\r\n        char *sval;\r"]
