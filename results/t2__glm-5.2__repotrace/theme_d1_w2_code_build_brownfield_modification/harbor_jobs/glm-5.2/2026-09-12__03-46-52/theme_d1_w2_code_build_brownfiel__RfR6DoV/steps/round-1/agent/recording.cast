[9837.82365, "o", "   119\tstatic ASTNode *parse_postfix(Parser *p, ASTNode *expr) {\r\n   120\t    for (;;) {\r\n   121\t        if (match(p, TOK_DOT)) {\r\n   122\t            int line = prev(p)->line;\r\n   123\t            expect(p, TOK_IDENT, \"field or method name\");\r\n   124\t            char name[MAX_IDENT_LEN];\r\n   125"]
[9837.823756, "o", "\t            strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\\0';\r\n   126\t            if (check(p, TOK_LPAREN)) {\r\n   127\t                match(p, TOK_LPAREN);\r\n   128\t                ASTNode *n = ast_alloc(); n->type = NODE_METHOD_CALL; n->line = line;\r\n   129\t                n->data.method_call.obj = expr;\r\n   130\t                strncpy(n->data.method_call.method, name, MAX_IDENT_LEN - 1);\r\n   131\t                n->data.method_call.method[MAX_IDENT_LEN - 1] = '\\0';\r\n   132\t                nodelist_init(&n->data.method_call.args);\r\n   133\t                if (!check(p, TOK_RPAREN)) {\r\n   134\t                    do { nodelist_push(&n->data.method_call.args, parse_expr(p)); } while (match(p, TOK_COMMA));\r\n   135\t                }\r\n"]
[9837.82383, "o", "   136\t                expect(p, TOK_RPAREN, \"')'\");\r\n   137\t                expr = n;\r\n   138\t            } else {\r\n   139\t                ASTNode *n = ast_alloc(); n->type = NODE_FIELD_ACCESS; n->line = line;\r\n   140\t                n->data.field_access.obj = expr;\r\n   141\t                strncpy(n->data.field_access.field, name, MAX_IDENT_LEN - 1);\r\n   142\t                n->data.field_access.field[MAX_IDENT_LEN - 1] = '\\0';\r\n   143\t                expr = n;\r\n   144\t            }\r\n   145\t        } else if (match(p, TOK_LBRACKET)) {\r\n   146\t            int line = prev(p)->line;\r\n   147"]
[9837.823901, "o", "\t            ASTNode *idx = parse_expr(p);\r\n   148\t            expect(p, TOK_RBRACKET, \"']'\");\r\n   149\t            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;\r\n   150\t            n->data.index_access.obj = expr;\r\n   151\t            n->data.index_access.index = idx;\r\n   152\t            expr = n;\r\n   153\t        } else {\r\n   154\t            break;\r\n   155\t        }\r\n   156\t    }\r\n"]
[9837.823968, "o", "   157\t    return expr;\r\n   158\t}\r\n   159\t\r\n   160\tstatic ASTNode *parse_unary(Parser *p) {\r\n   161\t    if (match(p, TOK_MINUS)) {\r\n   162\t        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n   163\t        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n   164\t        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;\r\n   165\t    }\r\n   166\t    if (match(p, TOK_NOT)) {\r\n"]
[9837.824036, "o", "   167\t        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n   168\t        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n   169\t        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;\r\n   170\t    }\r\n   171\t    return parse_primary(p);\r\n   172\t}\r\n   173\t\r\n   174\tstatic ASTNode *parse_factor(Parser *p) {\r\n   175\t    ASTNode *left = parse_unary(p);\r\n   176\t    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {\r\n"]
[9837.8241, "o", "   177\t        int line = prev(p)->line; BinOp op;\r\n   178\t        if (prev(p)->type == TOK_STAR) op = OP_MUL;\r\n   179\t        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;\r\n   180\t        else op = OP_MOD;\r\n   181\t        ASTNode *right = parse_unary(p);\r\n   182\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   183\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   184\t        left = n;\r\n   185\t    }"]
[9837.824163, "o", "\r\n   186\t    return left;\r\n   187\t}\r\n   188\t\r\n   189\tstatic ASTNode *parse_comparison(Parser *p) {\r\n   190\t    ASTNode *left = parse_term(p);\r\n   191\t    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||\r\n   192\t           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {\r\n   193\t        int line = prev(p)->line; BinOp op;\r\n"]
[9837.824269, "o", "   194\t        switch (prev(p)->type) {\r\n   195\t            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;\r\n   196\t            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;\r\n   197\t            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;\r\n   198\t            default: op = OP_EQ; break;\r\n   199\t        }\r\n   200\t        ASTNode *right = parse_term(p);\r\n   201\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   202\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   203\t        left = n;\r\n   204\t    }\r\n   205\t    return left;\r\n   206\t}\r\n   207\t\r\n   208\tstatic ASTNode *parse_term(Parser *p) {\r\n"]
[9837.824341, "o", "   209\t    ASTNode *left = parse_factor(p);\r\n   210\t    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {\r\n   211\t        int line = prev(p)->line;\r\n   212\t        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;\r\n   213\t        ASTNode *right = parse_factor(p);\r\n"]
[9837.824419, "o", "   214\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   215\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   216\t        left = n;\r\n   217\t    }\r\n   218\t    return left;\r\n   219\t}\r\n   220\t\r\n   221\tstatic ASTNode *parse_logic_and(Parser *p) {\r\n   222\t    ASTNode *left = parse_comparison(p);\r\n   223\t    while (match(p, TOK_AND)) {\r\n"]
[9837.824486, "o", "   224\t        int line = prev(p)->line; ASTNode *right = parse_comparison(p);\r\n   225\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   226\t        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;\r\n   227\t        left = n;\r\n   228\t    }\r\n   229\t    return left;\r\n   230\t}\r\n   231\t\r\n   232\tstatic ASTNode *parse_expr(Parser *p) {\r\n   233\t    ASTNode *left = parse_logic_and(p);\r\n   234\t    while (match(p, TOK_OR)) {\r\n   235\t        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);\r\n   236\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   237\t        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;\r\n   238\t        left = n;\r\n   239"]
[9837.824555, "o", "\t    }\r\n   240\t    return left;\r\n   241\t}\r\n   242\t\r\n"]
