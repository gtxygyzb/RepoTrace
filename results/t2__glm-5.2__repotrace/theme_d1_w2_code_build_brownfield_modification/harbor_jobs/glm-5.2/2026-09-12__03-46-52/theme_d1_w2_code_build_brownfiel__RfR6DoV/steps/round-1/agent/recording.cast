[1909.164059, "o", "     7\t    if (node_pool_count >= MAX_AST_NODES) { fprintf(stderr, \"AST node pool exhausted\\n\"); exit(1); }\r\n     8\t    ASTNode *n = &node_pool[node_pool_count++];\r\n     9\t    memset(n, 0, sizeof(ASTNode));\r\n    10\t    return n;\r\n    11\t}\r\n    12\t\r\n    13\tvoid ast_free_all(void) { node_pool_count = 0; }\r\n    14\t\r\n    15\tvoid nodelist_init(NodeList *list) { list->items = NULL; list->count = 0; list->cap = 0; }\r\n    16\t\r\n    17\tvoid nodelist_push(NodeList *list, ASTNode *node) {\r\n    18\t    if (list->count >= list->cap) {\r\n    19\t        int new_cap = list->cap == 0 ? 8 : list->cap * 2;\r\n    20\t        list->items = realloc(list->items, new_cap * sizeof(ASTNode *));\r\n"]
[1909.164147, "o", "    21\t        list->cap = new_cap;\r\n    22\t    }\r\n    23\t    list->items[list->count++] = node;\r\n    24\t}\r\n"]
