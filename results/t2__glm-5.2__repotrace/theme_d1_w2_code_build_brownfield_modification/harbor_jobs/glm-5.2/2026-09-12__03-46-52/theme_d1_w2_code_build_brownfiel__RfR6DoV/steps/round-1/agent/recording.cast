[9826.339132, "o", "\t\r\n   174\tstatic ASTNode *parse_factor(Parser *p) {\r\n   175\t    ASTNode *left = parse_unary(p);\r\n   176\t    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {\r\n   177\t        int line = prev(p)->line; BinOp op;\r\n   178\t        if (prev(p)->type == TOK_STAR) op = OP_MUL;\r\n   179\t        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;\r\n   180\t        else op = OP_MOD;\r\n   181\t        ASTNode *right = parse_unary(p);\r\n   182\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n"]
[9826.339214, "o", "   183\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   184\t        left = n;\r\n   185\t    }\r\n   186\t    return left;\r\n   187\t}\r\n   188\t\r\n   189\tstatic ASTNode *parse_comparison(Parser *p) {\r\n   190\t    ASTNode *left = parse_term(p);\r\n   191\t    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||\r\n   192\t           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {\r\n   193\t        int line = prev(p)->line; BinOp op;\r\n"]
[9826.339278, "o", "   194\t        switch (prev(p)->type) {\r\n   195\t            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;\r\n   196\t            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;\r\n   197\t            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;\r\n   198\t            default: op = OP_EQ; break;\r\n   199\t        }\r\n   200"]
[9826.339346, "o", "\t        ASTNode *right = parse_term(p);\r\n   201\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   202\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   203\t        left = n;\r\n   204\t    }\r\n   205\t    return left;\r\n   206\t}\r\n   207\t\r\n   208\tstatic ASTNode *parse_term(Parser *p) {\r\n   209\t    ASTNode *left = parse_factor(p);\r\n   210\t    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {\r\n"]
[9826.339417, "o", "   211\t        int line = prev(p)->line;\r\n   212\t        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;\r\n   213\t        ASTNode *right = parse_factor(p);\r\n   214\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   215\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   216\t        left = n;\r\n   217\t    }\r\n   218\t    return left;\r\n   219\t}\r\n   220\t\r\n"]
