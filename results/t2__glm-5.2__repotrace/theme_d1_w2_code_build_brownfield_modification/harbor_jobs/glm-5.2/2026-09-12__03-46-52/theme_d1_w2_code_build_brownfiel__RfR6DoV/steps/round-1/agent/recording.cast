[3866.087766, "o", "#ifndef MINICC_AST_H\r\n#define MINICC_AST_H\r\n\r\n#include \"common.h\"\r\n\r\nASTNode *ast_alloc(void);\r\nvoid ast_free_all(void);\r\nvoid nodelist_init(NodeList *list);\r\nvoid nodelist_push(NodeList *list, ASTNode *node);\r\n"]
[3866.087811, "o", "\r\n#endif\r\n"]
[3866.088321, "o", "\u001b[?2004h"]
