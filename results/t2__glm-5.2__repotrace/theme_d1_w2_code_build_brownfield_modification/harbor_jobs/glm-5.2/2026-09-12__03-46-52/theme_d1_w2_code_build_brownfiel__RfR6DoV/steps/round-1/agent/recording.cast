[7639.233407, "o", "    50\t    }\r\n    51\t    int cap = resolve_capture(c, name);\r\n    52\t    if (cap >= 0) { emit(c, BC_STORE_CAPTURE, cap, NULL); return; }\r\n    53\t    emit(c, BC_STORE_GLOBAL, 0, strdup(name));\r\n    54\t}\r\n    55\t\r\n    56\tstatic void compile_load(Compiler *c, const char *name) {\r\n    57\t    int slot = resolve_local(c, name);\r\n    58\t    if (slot >= 0) {\r\n    59\t        if (c->locals[slot].is_boxed) emit(c, BC_LOAD_BOX_LOCAL, slot, NULL);\r\n    60\t        else emit(c, BC_LOAD_LOCAL, slot, NULL);\r\n    61\t        return;\r\n    62\t    }\r\n    63\t    int cap = resolve_capture(c, name);\r\n"]
