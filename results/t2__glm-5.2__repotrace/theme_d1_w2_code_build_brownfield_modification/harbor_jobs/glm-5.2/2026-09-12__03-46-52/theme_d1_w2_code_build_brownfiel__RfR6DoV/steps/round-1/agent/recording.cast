[5999.580643, "o", "            case BC_MAP_HAS: {\r\n                Value keyv = pop(vm); Value obj = pop(vm);\r\n                if (obj.type != VAL_MAP) { fprintf(stderr, \"has() expects a map\\n\"); return -1; }\r\n                char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));\r\n                push(vm, make_bool(map_find(obj.data.map, key) >= 0)); break;\r\n"]
