[6439.738011, "o", "     1\t#include \"parser.h\"\r\n     2\t\r\n     3\tstatic Token *current(Parser *p) { return &p->tokens[p->pos]; }\r\n"]
[6439.738101, "o", "     4\tstatic Token *prev(Parser *p) { return &p->tokens[p->pos - 1]; }\r\n     5\tstatic int check(Parser *p, TokenType t) { return current(p)->type == t; }\r\n     6\t\r\n     7\tstatic int match(Parser *p, TokenType t) {\r\n     8\t    if (check(p, t)) { p->pos++; return 1; }\r\n     9\t    return 0;\r\n    10\t}\r\n    11\t\r\n    12\tstatic void expect(Parser *p, TokenType t, const char *msg) {\r\n    13\t"]
[6439.738183, "o", "    if (!match(p, t)) {\r\n    14\t        error_at(current(p)->line, \"expected %s, got '%s'\", msg, current(p)->text);\r\n    15\t        p->had_error = 1;\r\n    16\t    }\r\n    17\t}\r\n    18\t\r\n    19\tstatic ASTNode *parse_expr(Parser *p);\r\n    20\tstatic ASTNode *parse_stmt(Parser *p);\r\n    21\tstatic ASTNode *parse_block(Parser *p);\r\n"]
[6439.738263, "o", "    22\tstatic ASTNode *parse_factor(Parser *p);\r\n    23\tstatic ASTNode *parse_term(Parser *p);\r\n    24\tstatic ASTNode *parse_comparison(Parser *p);\r\n    25\tstatic ASTNode *parse_logic_and(Parser *p);\r\n    26\tstatic ASTNode *parse_fn_expr(Parser *p);\r\n    27\tstatic ASTNode *parse_postfix(Parser *p, ASTNode *expr);\r\n"]
[6439.738327, "o", "    28\t\r\n    29\tstatic ASTNode *parse_primary(Parser *p) {\r\n    30\t    if (match(p, TOK_NUM)) {\r\n    31\t        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;\r\n    32\t        n->data.num_val = prev(p)->literal.ival; return n;\r\n    33\t    }\r\n"]
[6439.73839, "o", "    34\t    if (match(p, TOK_STRING)) {\r\n    35\t        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;\r\n    36\t        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return n;\r\n    37\t    }\r\n    38\t    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {\r\n    39\t        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;\r\n"]
[6439.738454, "o", "    40\t        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;\r\n    41\t    }\r\n    42\t    if (match(p, TOK_IDENT)) {\r\n    43\t        char name[MAX_IDENT_LEN];\r\n    44\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\\0';\r\n    45\t        int line = prev(p)->line;\r\n    46"]
[6439.738521, "o", "\t        if (match(p, TOK_LPAREN)) {\r\n    47\t            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;\r\n    48\t            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);\r\n    49\t            nodelist_init(&n->data.call.args);\r\n    50\t            if (!check(p, TOK_RPAREN)) {\r\n    51\t                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));\r\n    52\t            }\r\n"]
[6439.738582, "o", "    53\t            expect(p, TOK_RPAREN, \"')'\"); return parse_postfix(p, n);\r\n    54\t        }\r\n    55\t        ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;\r\n    56\t        strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);\r\n    57\t        return parse_postfix(p, obj);\r\n    58\t    }\r\n"]
[6439.738648, "o", "    59\t    if (match(p, TOK_LBRACE)) {\r\n    60\t        int line = prev(p)->line;\r\n"]
