[5299.476866, "o", "   100\tstatic ASTNode *parse_unary(Parser *p) {\r\n   101\t    if (match(p, TOK_MINUS)) {\r\n   102\t        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n   103\t        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n   104\t        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;\r\n   105\t    }\r\n   106\t    if (match(p, TOK_NOT)) {\r\n   107\t        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n   108\t        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n   109\t        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;\r\n   110\t    }\r\n   111\t    return parse_primary(p);\r\n   112\t}\r\n   113\t"]
[5299.476949, "o", "\r\n   114\tstatic ASTNode *parse_factor(Parser *p) {\r\n   115\t    ASTNode *left = parse_unary(p);\r\n   116\t    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {\r\n   117\t        int line = prev(p)->line; BinOp op;\r\n   118\t        if (prev(p)->type == TOK_STAR) op = OP_MUL;\r\n   119\t        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;\r\n   120\t        else op = OP_MOD;\r\n   121\t        ASTNode *right = parse_unary(p);\r\n   122\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n"]
