[7979.290906, "o", "   119\tstatic ASTNode *parse_postfix(Parser *p, ASTNode *expr) {\r\n   120\t    for (;;) {\r\n   121\t        if (match(p, TOK_DOT)) {\r\n   122\t            int line = prev(p)->line;\r\n   123\t            expect(p, TOK_IDENT, \"field name\");\r\n   124\t            ASTNode *n = ast_alloc(); n->type = NODE_FIELD_ACCESS; n->line = line;\r\n   125\t            n->data.field_access.obj = expr;\r\n   126\t            strncpy(n->data.field_access.field, prev(p)->text, MAX_IDENT_LEN - 1);\r\n   127\t            n->data.field_access.field[MAX_IDENT_LEN - 1] = '\\0';\r\n   128\t            expr = n;\r\n"]
[7979.291102, "o", "   129\t        } else if (match(p, TOK_LBRACKET)) {\r\n   130\t            int line = prev(p)->line;\r\n   131\t            ASTNode *idx = parse_expr(p);\r\n   132\t            expect(p, TOK_RBRACKET, \"']'\");\r\n   133\t            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;\r\n   134\t            n->data.index_access.obj = expr;\r\n   135\t            n->data.index_access.index = idx;\r\n   136\t            expr = n;\r\n   137\t        } else {\r\n   138\t            break;\r\n   139\t        }\r\n   140\t    }\r\n   141\t    return expr;\r\n   142\t}\r\n   143\t\r\n   144\tstatic ASTNode *parse_unary(Parser *p) {\r\n   145\t    if (match(p, TOK_MINUS)) {\r\n   146\t        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n   147\t        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n   148\t        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;\r\n   149\t    }\r\n   150\t    if (match(p, TOK_NOT)) {\r\n   151\t        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n   152\t      "]
