[9925.864636, "o", "\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        Instruction *ins = &vm->code[vm->ip++];\r\n\u001b[32m\u001b[K173\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        switch (ins->op) {\r\n\u001b[32m\u001b[K174\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            case BC_PUSH_INT: push(vm, make_int(ins->operand)); break;\r\n\u001b[32m\u001b[K175\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            case BC_PUSH_STR: push(vm, make_str(ins->str_operand)); break;\r\n\u001b[32m\u001b[K176\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            case BC_PUSH_BOOL: push(vm, make_bool((int)ins->operand)); break;\r\n"]
