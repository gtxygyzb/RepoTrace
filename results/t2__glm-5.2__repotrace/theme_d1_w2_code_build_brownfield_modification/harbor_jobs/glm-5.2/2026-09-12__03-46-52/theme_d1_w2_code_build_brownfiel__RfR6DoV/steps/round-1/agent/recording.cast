[10997.816135, "o", "\u001b[?2004h> "]
[10997.816326, "o", "                frame->bp = vm->sp;\r\n\u001b[?2004l\r"]
[10997.816351, "o", "\u001b[?2004h"]
[10997.81656, "o", "> "]
