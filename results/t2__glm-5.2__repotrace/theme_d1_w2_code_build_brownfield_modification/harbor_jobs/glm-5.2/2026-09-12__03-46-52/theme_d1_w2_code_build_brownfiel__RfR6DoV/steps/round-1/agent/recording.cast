[5755.825382, "o", "\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic ASTNode *\u001b[01;31m\u001b[Ktry_parse_assign\u001b[m\u001b[K(Parser *p) {\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!check(p, TOK_IDENT)) return NULL;\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int saved = p->pos;\r\n"]
[5755.825535, "o", "\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int line = current(p)->line;\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *target = parse_expr(p);\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (target && (target->type == NODE_FIELD_ACCESS || target->type == NODE_INDEX)) {\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (check(p, TOK_ASSIGN)) {\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            match(p, TOK_ASSIGN);\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            ASTNode *val = parse_expr(p);\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (target->type == NODE_FIELD_ACCESS) {\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                ASTNode *n = ast_alloc(); n->type = NODE_FIELD_ASSIGN; n->line = line;\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                n->data.field_assign.obj = target->data.field_access.obj;\r\n\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                strncpy(n->data.field_assign.field, target->data.field_access.field, MAX_IDENT_LEN - 1);\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                n->data.field_assign.field[MAX_IDENT_LEN - 1] = '\\0';\r\n\u001b[3"]
[5755.825628, "o", "2m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                n->data.field_assign.value = val;\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                return n;\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            } else {\r\n\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                ASTNode *n = ast_alloc(); n->type = NODE_INDEX_ASSIGN; n->line = line;\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                n->data.index_assign.name[0] = '\\0';\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                n->data.index_assign.obj = target->data.index_access.obj;\r\n\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                n->data.index_assign.index = target->data.index_access.index;\r\n\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                n->data.index_assign.value = val;\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                return n;\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p->pos = saved;\r\n\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (check(p, TOK_IDENT)) {\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b["]
[5755.825705, "o", "36m\u001b[K-\u001b[m\u001b[K        p->pos++;\r\n\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        char name[MAX_IDENT_LEN];\r\n\u001b[32m\u001b[K257\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        line = prev(p)->line;\r\n\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||\r\n\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {\r\n\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            p->pos = saved; match(p, TOK_IDENT);\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            TokenType op_tok = current(p)->type;\r\n\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            BinOp op = OP_ADD;\r\n\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            const char *msg = \"'='\";\r\n\u001b[32m\u001b[K265\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = \"'+='\"; expect(p, TOK_PLUS_ASSIGN, \"'+='\"); }\r\n\u001b[32m\u001b[K266\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K     "]
[5755.825787, "o", "       else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = \"'-='\"; expect(p, TOK_MINUS_ASSIGN, \"'-='\"); }\r\n\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = \"'*='\"; expect(p, TOK_STAR_ASSIGN, \"'*='\"); }\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        init = \u001b[01;31m\u001b[Ktry_parse_assign\u001b[m\u001b[K(p);\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (!init) init = parse_expr(p);\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else if (!check(p, TOK_SEMICOLON)) {\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        init = parse_expr(p);\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K327\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *cond = NULL;\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);\r\n\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K331\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *step ="]
[5755.825862, "o", " NULL;\r\n\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!check(p, TOK_RPAREN)) {\r\n\u001b[32m\u001b[K333\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (check(p, TOK_IDENT)) {\r\n\u001b[32m\u001b[K334\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            step = \u001b[01;31m\u001b[Ktry_parse_assign\u001b[m\u001b[K(p);\r\n\u001b[32m\u001b[K335\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (!step) step = parse_expr(p);\r\n\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K338\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_RPAREN, \"')'\");\r\n\u001b[32m\u001b[K339\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K340\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *body = parse_block(p);\r\n\u001b[32m\u001b[K341\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;\r\n\u001b[32m\u001b[K342\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.for_stmt.init = init;\r\n\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.for_stmt.cond = cond;\r\n\u001b[32m\u001b[K344\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.for_stmt.step = step;\r\n\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.for_stmt.body = body;\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return n;\r\n\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K"]
[5755.825938, "o", "\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K349\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic ASTNode *parse_block(Parser *p) {\r\n\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_LBRACE, \"'{'\");\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;\r\n\u001b[32m\u001b[K352\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    nodelist_init(&block->data.block.stmts);\r\n\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {\r\n\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *stmt = parse_stmt(p);\r\n\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (stmt) nodelist_push(&block->data.block.stmts, stmt);\r\n\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (p->had_error) break;\r\n"]
[5755.826018, "o", "\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_RBRACE, \"'}'\");\r\n\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return block;\r\n\u001b[32m\u001b[K360\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K361\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic ASTNode *parse_stmt(Parser *p) {\r\n\u001b[32m\u001b[K363\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_LET)) {\r\n\u001b[32m\u001b[K364\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int line = prev(p)->line;\r\n\u001b[32m\u001b[K365\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_IDENT, \"identifier\");\r\n\u001b[32m\u001b[K366\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        char name[MAX_IDENT_LEN];\r\n\u001b[32m\u001b[K367\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_ASSIGN, \"'='\");\r\n\u001b[32m\u001b[K369\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *init = parse_expr(p);\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[32m\u001b[K371\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;\r\n\u001b[32m\u001b[K372\u001b"]
[5755.826094, "o", "[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);\r\n\u001b[32m\u001b[K373\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.let.init = init; return n;\r\n\u001b[32m\u001b[K374\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K454\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        ASTNode *a = \u001b[01;31m\u001b[Ktry_parse_assign\u001b[m\u001b[K(p);\r\n\u001b[32m\u001b[K455\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (a) { expect(p, TOK_SEMICOLON, \"';'\"); return a; }\r\n\u001b[32m\u001b[K456\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K457\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *expr = parse_expr(p);\r\n\u001b[32m\u001b[K458\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_SEMICOLON, \"';'\");\r\n"]
[5755.826166, "o", "\u001b[32m\u001b[K459\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;\r\n\u001b[32m\u001b[K460\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.expr_stmt.expr = expr; return n;\r\n\u001b[32m\u001b[K461\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K462\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K463\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid parser_init(Parser *p, Token *tokens, int count) {\r\n\u001b[32m\u001b[K464\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;\r\n\u001b[32m\u001b[K465\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K466\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K467\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KASTNode *parse_program(Parser *p) {\r\n\u001b[32m\u001b[K468\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;\r\n\u001b[32m\u001b[K469\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    nodelist_init(&program->data.block.stmts);\r\n"]
