[8191.52801, "o", "#include \"ast.h\"\r\n\r\nstatic ASTNode node_pool[MAX_AST_NODES];\r\nstatic int node_pool_count = 0;\r\n\r\nASTNode *ast_alloc(void) {\r\n    if (node_pool_count >= MAX_AST_NODES) { fprintf(stderr, \"AST node pool exhausted\\n\"); exit(1); }\r\n    ASTNode *n = &node_pool[node_pool_count++];\r\n    memset(n, 0, sizeof(ASTNode));\r\n    return n;\r\n}\r\n\r\nvoid ast_free_all(void) { node_pool_count = 0; }\r\n\r\nvoid nodelist_init(NodeList *list) { list->items = NULL; list->count = 0; list->cap = 0; }\r\n\r\nvoid nodelist_push(NodeList *list, ASTNode *node) {\r\n    if (list->count >= list->cap) {\r\n        int new_cap = list->cap == 0 ? 8 : list->cap * 2;\r\n        list->items = realloc(list->items, new_cap * sizeof(ASTNode *));\r\n        list->cap = new_cap;\r\n    }\r\n    list->items[list->count++] = node;\r\n}\r\n"]
