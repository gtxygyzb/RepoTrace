[391.531246, "o", "   238\t        expect(p, TOK_SEMICOLON, \"';'\");\r\n   239\t        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;\r\n   240\t        n->data.ret.value = value; return n;\r\n   241\t    }\r\n   242\t    if (match(p, TOK_PRINT)) {\r\n   243\t        int line = prev(p)->line;\r\n   244\t        ASTNode *value = parse_expr(p);\r\n   245\t        expect(p, TOK_SEMICOLON, \"';'\");\r\n   246\t        ASTNode *n = ast_alloc(); n->type = NODE_PRINT; n->line = line;\r\n   247\t        n->data.print.value = value; return n;\r\n   248\t    }\r\n   249\t    if (match(p, TOK_FN)) {\r\n   250\t        int line = prev(p)->line;\r\n   251\t        expect(p, TOK_IDENT, \"function name\");\r\n   252\t        char name[MAX_IDENT_LEN];\r\n   253\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n   254\t        expect(p, TOK_LPAREN, \"'('\");\r\n   255\t        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;\r\n   256\t        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);\r\n   257"]
[391.531326, "o", "\t        n->data.func.param_count = 0;\r\n   258\t        if (!check(p, TOK_RPAREN)) {\r\n   259\t            do {\r\n   260\t                expect(p, TOK_IDENT, \"parameter name\");\r\n   261\t                strncpy(n->data.func.params[n->data.func.param_count],\r\n   262\t                        prev(p)->text, MAX_IDENT_LEN - 1);\r\n   263\t                n->data.func.param_count++;\r\n   264\t            } while (match(p, TOK_COMMA));\r\n   265\t        }\r\n   266\t        expect(p, TOK_RPAREN, \"')'\");\r\n   267\t        n->data.func.body = parse_block(p); return n;\r\n"]
