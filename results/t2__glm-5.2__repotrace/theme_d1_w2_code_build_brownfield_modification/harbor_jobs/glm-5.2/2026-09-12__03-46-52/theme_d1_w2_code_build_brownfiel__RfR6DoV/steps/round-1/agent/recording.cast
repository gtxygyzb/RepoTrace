[5351.228742, "o", "\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    return \u001b[01;31m\u001b[Kparse_primary\u001b[m\u001b[K(p);\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic ASTNode *\u001b[01;31m\u001b[Kparse_factor\u001b[m\u001b[K(Parser *p) {\r\n\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    ASTNode *left = \u001b[01;31m\u001b[Kparse_factor\u001b[m\u001b[K(p);\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        ASTNode *right = \u001b[01;31m\u001b[Kparse_factor\u001b[m\u001b[K(p);\r\n"]
[5351.228905, "o", "\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic ASTNode *\u001b[01;31m\u001b[Ktry_parse_assign\u001b[m\u001b[K(Parser *p) {\r\n\u001b[32m\u001b[K196\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            ASTNode *n = ast_alloc(); n->type = \u001b[01;31m\u001b[KNODE_INDEX\u001b[m\u001b[K_ASSIGN; n->line = line;\r\n"]
[5351.228969, "o", "\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic ASTNode *\u001b[01;31m\u001b[Kparse_for\u001b[m\u001b[K(Parser *p) {\r\n"]
[5351.229029, "o", "\u001b[32m\u001b[K265\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        init = \u001b[01;31m\u001b[Ktry_parse_assign\u001b[m\u001b[K(p);\r\n\u001b[32m\u001b[K279\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            step = \u001b[01;31m\u001b[Ktry_parse_assign\u001b[m\u001b[K(p);\r\n"]
[5351.229092, "o", "\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        return \u001b[01;31m\u001b[Kparse_for\u001b[m\u001b[K(p);\r\n\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        ASTNode *a = \u001b[01;31m\u001b[Ktry_parse_assign\u001b[m\u001b[K(p);\r\n"]
