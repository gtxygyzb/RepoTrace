[1559.984279, "o", "\u001b[?2004hroot@n30009:/app# "]
[1560.849111, "i", "cat > /tmp/newfeatures.mini <<'EOF'\nfn add(a, b) { return a + b; }\nlet s = 0;\nfor (let i = 0; i < 5; i += 1) {\n    s += i;\n}\nprint s;\nfor (let i = 0; i < 10; i += 1) {\n    if (i == 3) { continue; }\n    if (i == 6) { break; }\n    print i;\n}\nlet arr = [10, 20, 30];\nlet total = 0;\nfor (x in arr) {\n    total += x;\n}\nprint total;\nlet found = 0;\nlet n = 0;\nwhile (n < 10) {\n    n += 1;\n    for (y in [1,2,3]) {\n        if (y == 2) { break; }\n        found += y;\n    }\n    if (n == 2) { break; }\n}\nprint found;\nprint n;\nlet str = \"a\";\nstr += \"b\";\nstr += \"c\";\nprint str;\nlet mul = 2;\nmul *= 5;\nprint mul;\nlet sub = 10;\nsub -= 4;\nprint sub;\nlet div = 20;\ndiv /= 4;\nprint div;\nlet mod = 17;\nmod %= 5;\nprint mod;\nprint 1 + 2 == 3;\nprint 1 + 2 != 4;\nEOF\n./minicc /tmp/newfeatures.mini\n"]
[1560.849503, "o", "cat > /tmp/newfeatures.mini <<'EOF'\r\n\u001b[?2004l\r"]
