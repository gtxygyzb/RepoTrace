[6440.320373, "o", "    89\t        struct { BinOp op; struct ASTNode *left, *right; } binop;\r\n    90\t        struct { UnaryOp op; struct ASTNode *operand; } unary;\r\n    91\t        struct { char name[MAX_IDENT_LEN]; NodeList args; } call;\r\n    92\t        struct { struct ASTNode *obj; struct ASTNode *index; } index_access;\r\n    93\t        struct { char name[MAX_IDENT_LEN]; struct ASTNode *value; } assign;\r\n    94\t    struct { char name[MAX_IDENT_LEN]; BinOp op; struct ASTNode *value; } compound_assign;\r\n    95\t        struct { char name[MAX_IDENT_LEN]; struct ASTNode *obj; struct ASTNode *index; struct ASTNode *value; } index_assign;\r\n    96\t        struct { char name[MAX_IDENT_LEN]; struct ASTNode *init; } let;\r\n    97\t        struct { struct ASTNode *cond, *then_b, *else_b; } if_stmt;\r\n    98\t        struct { struct ASTNode *cond, *body; } while_stmt;\r\n    99\t    struct { struct ASTNode *init, *cond, *step, *body; } for_stmt;\r\n   100\t    struct { char var[MAX_IDENT_LEN]; struct ASTNode *arr; struct ASTNode *body; int is_of; } fo"]
[6440.320456, "o", "reach_stmt;\r\n   101\t        struct { struct ASTNode *value; } ret;\r\n   102\t        struct { struct ASTNode *value; } print;\r\n   103\t        struct { NodeList stmts; } block;\r\n   104\t        struct { char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } closure;\r\n   105\t        struct { char name[MAX_IDENT_LEN]; char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } func;\r\n   106\t        struct { NodeList elems; } array_lit;\r\n   107\t        struct { NodeList keys; NodeList values; } map_lit;\r\n   108\t        struct { struct ASTNode *obj; char field[MAX_IDENT_LEN]; } field_access;\r\n   109\t        struct { struct ASTNode *obj; char field[MAX_IDENT_LEN]; struct ASTNode *value; } field_assign;\r\n   110\t        struct { struct ASTNode *expr; } expr_stmt;\r\n   111\t    } data;\r\n   112\t} ASTNode;\r\n"]
