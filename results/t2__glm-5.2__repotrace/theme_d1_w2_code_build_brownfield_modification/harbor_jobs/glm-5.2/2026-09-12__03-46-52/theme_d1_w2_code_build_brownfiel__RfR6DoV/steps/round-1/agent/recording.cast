[7610.077078, "o", "    80\t    if (!node) return;\r\n    81\t    switch (node->type) {\r\n    82\t        case NODE_LET: add_name(names, count, node->data.let.name); break;\r\n    83\t        case NODE_BLOCK:\r\n    84\t            for (int i = 0; i < node->data.block.stmts.count; i++)\r\n    85\t                collect_bound_names(node->data.block.stmts.items[i], names, count);\r\n    86\t            break;\r\n"]
