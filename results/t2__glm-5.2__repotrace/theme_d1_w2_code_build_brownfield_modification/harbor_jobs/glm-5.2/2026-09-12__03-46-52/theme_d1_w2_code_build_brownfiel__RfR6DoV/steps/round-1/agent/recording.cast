[8630.170733, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\ndef repl(path, old, new, count=1):\n    p = Path(path)\n    s = p.read_text()\n    if old not in s:\n        raise SystemExit(f\"pattern not found in {path}: {old[:80]}\")\n    p.write_text(s.replace(old, new, count))\n\n# common.h: constants, tokens, AST nodes, opcodes\nrepl('src/common.h', \"#define MAX_PARAMS 16\\n\", \"#define MAX_PARAMS 16\\n#define MAX_TRY_HANDLERS 64\\n\")\nrepl('src/common.h', \"TOK_TRUE, TOK_FALSE,\\n\", \"TOK_TRUE, TOK_FALSE, TOK_THROW, TOK_TRY, TOK_CATCH,\\n\")\nrepl('src/common.h', \"NODE_COMPOUND_ASSIGN, NODE_INDEX_ASSIGN, NODE_CLOSURE, NODE_METHOD_CALL\\n} NodeType;\",\n            \"NODE_COMPOUND_ASSIGN, NODE_INDEX_ASSIGN, NODE_CLOSURE, NODE_METHOD_CALL,\\n    NODE_THROW, NODE_TRY\\n} NodeType;\")\nrepl('src/common.h', \"        struct { struct ASTNode *expr; } expr_stmt;\\n    } data;\",\n            \"        struct { struct ASTNode *expr; } expr_stmt;\\n        struct { struct ASTNode *expr; } throw;\\n        struct { struct ASTNode *try_body; char catch_var[MAX_IDENT_LEN"]
