[11233.441051, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include \"lexer.h\"\r\n#include \"parser.h\"\r\n#include \"codegen.h\"\r\n#include \"vm.h\"\r\n\r\nstatic char *read_file(const char *path) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) { fprintf(stderr, \"cannot open file: %s\\n\", path); return NULL; }\r\n    fseek(f, 0, SEEK_END);\r\n    long size = ftell(f);\r\n    if (size > 0) {\r\n        fseek(f, 0, SEEK_SET);\r\n        char *buf = malloc(size + 1);\r\n        if (!buf) { fclose(f); return NULL; }\r\n        size_t rd = fread(buf, 1, size, f);\r\n        buf[rd] = '\\0';\r\n        fclose(f);\r\n        return buf;\r\n    }\r\n    fseek(f, 0, SEEK_SET);\r\n    size_t cap = 4096, len = 0;\r\n    char *buf = malloc(cap);\r\n    if (!buf) { fclose(f); return NULL; }\r\n    size_t rd;\r\n    while ((rd = fread(buf + len, 1, cap - len - 1, f)) > 0) {\r\n        len += rd;\r\n        if (len + 1 >= cap) { cap *= 2; buf = realloc(buf, cap); }\r\n    }\r\n    buf[len] = '\\0';\r\n    fclose(f);\r\n    return buf;\r\n}\r\n\r\n"]
[11233.441351, "o", "int main(int argc, char **argv) {\r\n    if (argc < 2) { fprintf(stderr, \"usage: minicc <file.mini>\\n\"); return 1; }\r\n    char *source = read_file(argv[1]);\r\n    if (!source) return 1;\r\n\r\n    Lexer lex;\r\n    lexer_init(&lex, source);\r\n    if (lexer_tokenize(&lex) < 0) { free(source); return 1; }\r\n\r\n    Parser parser;\r\n    parser_init(&parser, lex.tokens, lex.token_count);\r\n    ASTNode *program = parse_program(&parser);\r\n    if (parser.had_error) { free(source); ast_free_all(); return 1; }\r\n\r\n    Compiler compiler;\r\n    compiler_init(&compiler);\r\n    if (compile(&compiler, program) < 0) { free(source); ast_free_all(); return 1; }\r\n\r\n    VM vm;\r\n    vm_init(&vm, &compiler);\r\n    int result = vm_run(&vm);\r\n\r\n    free(source);\r\n    ast_free_all();\r\n    return result;\r\n}\r\n"]
[11233.441578, "o", "\u001b[?2004h"]
[11233.441674, "o", "root@n30009:/app# "]
[11240.424192, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/main.c')\ns = p.read_text()\nold = '''    if (compile(&compiler, program) < 0) { free(source); ast_free_all(); return 1; }\n\n    VM vm;\n'''\nnew = '''    if (compile(&compiler, program) < 0) { free(source); ast_free_all(); return 1; }\n\n    if (getenv(\"MINICC_DUMP\")) {\n        for (int i = 0; i < compiler.code_count; i++) {\n            Instruction *ins = &compiler.code[i];\n            fprintf(stderr, \"%04d %d %lld %s\\\\n\", i, (int)ins->op, (long long)ins->operand, ins->str_operand ? ins->str_operand : \"\");\n        }\n    }\n\n    VM vm;\n'''\ns = s.replace(old, new)\np.write_text(s)\nPY\n"]
