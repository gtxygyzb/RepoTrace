[10997.834273, "o", "# Insert new opcode implementations before BC_PRINT\r\n\u001b[?2004l\r"]
[10997.834336, "o", "\u001b[?2004h> "]
[10997.834678, "o", "insert = '''            case BC_PUSH_NULL: push(vm, make_null()); break;\r\n\u001b[?2004l\r"]
[10997.834744, "o", "\u001b[?2004h> "]
[10997.834924, "o", "            case BC_ARRAY_GET_OR_NULL: {\r\n\u001b[?2004l\r"]
[10997.834987, "o", "\u001b[?2004h> "]
[10997.835281, "o", "                Value idx = pop(vm); Value arr = pop(vm);\r\n\u001b[?2004l\r"]
[10997.835344, "o", "\u001b[?2004h> "]
[10997.835523, "o", "                if (arr.type == VAL_ARRAY) {\r\n\u001b[?2004l\r"]
[10997.835584, "o", "\u001b[?2004h> "]
[10997.835836, "o", "                    int i = (int)value_to_int(idx);\r\n\u001b[?2004l\r"]
[10997.835892, "o", "\u001b[?2004h> "]
[10997.83628, "o", "                    if (i < 0 || i >= arr.data.array.len) push(vm, make_null());\r\n\u001b[?2004l\r"]
[10997.836341, "o", "\u001b[?2004h> "]
[10997.836608, "o", "                    else push(vm, arr.data.array.items[i]);\r\n\u001b[?2004l\r"]
[10997.836695, "o", "\u001b[?2004h> "]
[10997.8369, "o", "                } else if (arr.type == VAL_MAP) {\r\n\u001b[?2004l\r"]
[10997.83696, "o", "\u001b[?2004h> "]
[10997.837384, "o", "                    char buf[64]; const char *key = value_to_key(idx, buf, sizeof(buf));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10997.837613, "o", "                    int i = map_find(arr.data.map, key);\r\n\u001b[?2004l\r"]
[10997.837669, "o", "\u001b[?2004h> "]
[10997.837854, "o", "                    if (i < 0) push(vm, make_null());\r\n\u001b[?2004l\r"]
[10997.837911, "o", "\u001b[?2004h> "]
[10997.838089, "o", "                    else push(vm, arr.data.map->values[i]);\r\n\u001b[?2004l\r"]
[10997.838152, "o", "\u001b[?2004h> "]
[10997.8383, "o", "                } else { push(vm, make_null()); }\r\n\u001b[?2004l\r"]
[10997.838363, "o", "\u001b[?2004h> "]
[10997.838427, "o", "                break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10997.838494, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10997.838647, "o", "            case BC_MAP_GET_OR_NULL: {\r\n\u001b[?2004l\r"]
[10997.838708, "o", "\u001b[?2004h> "]
[10997.83884, "o", "                Value keyv = pop(vm); Value obj = pop(vm);\r\n\u001b[?2004l\r\u001b[?2004h"]
[10997.83891, "o", "> "]
[10997.838976, "o", "                if (obj.type == VAL_MAP) {\r\n\u001b[?2004l\r"]
[10997.839036, "o", "\u001b[?2004h> "]
[10997.839247, "o", "                    char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));\r\n\u001b[?2004l\r"]
[10997.839313, "o", "\u001b[?2004h> "]
[10997.839425, "o", "                    int i = map_find(obj.data.map, key);\r\n\u001b[?2004l\r"]
[10997.83948, "o", "\u001b[?2004h> "]
[10997.839596, "o", "                    if (i < 0) push(vm, make_null());\r\n\u001b[?2004l\r"]
