[2019.144478, "o", "\r\n    34\t    switch (v.type) { case VAL_INT: return v.data.ival; case VAL_BOOL: return v.data.bval ? 1 : 0; default: return 0; }\r\n    35\t}\r\n    36\t\r\n    37\tstatic int value_is_integer_like(Value v) {\r\n    38\t    return v.type == VAL_INT || v.type == VAL_BOOL;\r\n    39\t}\r\n    40\t\r\n    41\tstatic int value_truthy(Value v) {\r\n    42\t    switch (v.type) {\r\n    43\t        case VAL_INT: return v.data.ival != 0;\r\n    44\t        case VAL_BOOL: return v.data.bval;\r\n    45\t        case VAL_STR: return v.data.sval && v.data.sval[0] != '\\0';\r\n    46\t        case VAL_ARRAY: return v.data.array.len > 0;\r\n    47\t        case VAL_NULL: return 0;\r\n    48\t    }\r\n    49\t    return 0;\r\n    50\t}\r\n    51\t\r\n    52\tstatic int values_equal(Value a, Value b) {\r\n    53\t    if (a.type != b.type) return 0;\r\n    54\t    switch (a.type) {\r\n    55\t        case VAL_INT: return a.data.ival == b.data.ival;\r\n    56\t        case VAL_BOOL: return a.data.bval == b.data.bval;\r\n    57\t        case VAL_STR: return strcmp(a.data.sval, b.data.sval) == 0;\r"]
[2019.144587, "o", "\n    58\t        case VAL_NULL: return 1;\r\n    59\t        default: return 0;\r\n    60\t    }\r\n    61\t}\r\n    62\t\r\n    63\tstatic void print_value(Value v) {\r\n    64\t    switch (v.type) {\r\n    65\t        case VAL_INT: printf(\"%lld\", (long long)v.data.ival); break;\r\n    66\t        case VAL_BOOL: printf(\"%s\", v.data.bval ? \"true\" : \"false\"); break;\r\n    67\t        case VAL_STR: printf(\"%s\", v.data.sval); break;\r\n    68\t        case VAL_ARRAY:\r\n    69\t            printf(\"[\");\r\n    70\t            for (int i = 0; i < v.data.array.len; i++) {\r\n    71\t                if (i > 0) printf(\", \");\r\n    72\t                print_value(v.data.array.items[i]);\r\n    73\t            }\r\n    74\t            printf(\"]\");\r\n    75\t            break;\r\n    76\t        case VAL_NULL: printf(\"null\"); break;\r\n"]
