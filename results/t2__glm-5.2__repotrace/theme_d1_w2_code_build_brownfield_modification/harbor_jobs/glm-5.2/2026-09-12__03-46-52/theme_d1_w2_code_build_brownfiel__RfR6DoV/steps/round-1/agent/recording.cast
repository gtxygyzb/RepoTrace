[7586.293036, "o", "src/ast.c\r\nsrc/ast.h\r\nsrc/ast.o\r\nsrc/codegen.c\r\nsrc/codegen.h\r\nsrc/codegen.o\r\nsrc/common.h\r\nsrc/lexer.c\r\nsrc/lexer.h\r\nsrc/lexer.o\r\nsrc/main.c\r\nsrc/main.o\r\nsrc/parser.c\r\nsrc/parser.h\r\nsrc/parser.o\r\n"]
