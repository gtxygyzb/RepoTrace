[7691.747175, "o", "    TokenType type;\r\n    char text[MAX_STRING_LEN];\r\n    int line;\r\n    int col;\r\n    union {\r\n        int64_t ival;\r\n        double fval;\r\n    } literal;\r\n} Token;\r\n\r\ntypedef enum {\r\n"]
[7691.747292, "o", "    NODE_NUM_LIT, NODE_STR_LIT, NODE_BOOL_LIT,\r\n    NODE_IDENT, NODE_BINOP, NODE_UNARY,\r\n    NODE_CALL, NODE_INDEX,\r\n    NODE_ASSIGN, NODE_LET,\r\n    NODE_IF, NODE_WHILE, NODE_FOR, NODE_FOREACH,\r\n    NODE_RETURN, NODE_BREAK, NODE_CONTINUE,\r\n    NODE_PRINT, NODE_BLOCK, NODE_FUNC,\r\n    NODE_ARRAY_LIT, NODE_MAP_LIT, NODE_FIELD_ACCESS, NODE_FIELD_ASSIGN,\r\n    NODE_EXPR_STMT,\r\n    NODE_COMPOUND_ASSIGN, NODE_INDEX_ASSIGN, NODE_CLOSURE\r\n} NodeType;\r\n\r\ntypedef enum {\r\n    OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_MOD,\r\n    OP_EQ, OP_NEQ, OP_LT, OP_GT, OP_LEQ, OP_GEQ,\r\n    OP_AND, OP_OR\r\n} BinOp;\r\n\r\n"]
[7691.747353, "o", "typedef enum {\r\n    UNOP_NEG, UNOP_NOT\r\n} UnaryOp;\r\n\r\nstruct ASTNode;\r\n\r\ntypedef struct {\r\n    struct ASTNode **items;\r\n    int count;\r\n    int cap;\r\n} NodeList;\r\n\r\ntypedef struct ASTNode {\r\n    NodeType type;\r\n    int line;\r\n"]
[7691.747433, "o", "    union {\r\n        int64_t num_val;\r\n        char str_val[MAX_STRING_LEN];\r\n        int bool_val;\r\n        char ident[MAX_IDENT_LEN];\r\n        struct { BinOp op; struct ASTNode *left, *right; } binop;\r\n        struct { UnaryOp op; struct ASTNode *operand; } unary;\r\n        struct { char name[MAX_IDENT_LEN]; NodeList args; } call;\r\n        struct { struct ASTNode *obj; struct ASTNode *index; } index_access;\r\n        struct { char name[MAX_IDENT_LEN]; struct ASTNode *value; } assign;\r\n    struct { char name[MAX_IDENT_LEN]; BinOp op; struct ASTNode *value; } compound_assign;\r\n"]
[7691.747495, "o", "        struct { char name[MAX_IDENT_LEN]; struct ASTNode *obj; struct ASTNode *index; struct ASTNode *value; } index_assign;\r\n        struct { char name[MAX_IDENT_LEN]; struct ASTNode *init; } let;\r\n        struct { struct ASTNode *cond, *then_b, *else_b; } if_stmt;\r\n        struct { struct ASTNode *cond, *body; } while_stmt;\r\n    struct { struct ASTNode *init, *cond, *step, *body; } for_stmt;\r\n    struct { char var[MAX_IDENT_LEN]; struct ASTNode *arr; struct ASTNode *body; int is_of; } foreach_stmt;\r\n        struct { struct ASTNode *value; } ret;\r\n        struct { struct ASTNode *value; } print;\r\n        struct { NodeList stmts; } block;\r\n        struct { char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } closure;\r\n        struct { char name[MAX_IDENT_LEN]; char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } func;\r\n        struct { NodeList elems; } array_lit;\r\n        struct { NodeList keys; NodeList values; } map_lit;\r\n"]
[7691.747553, "o", "        struct { struct ASTNode *obj; char field[MAX_IDENT_LEN]; } field_access;\r\n        struct { struct ASTNode *obj; char field[MAX_IDENT_LEN]; struct ASTNode *value; } field_assign;\r\n        struct { struct ASTNode *expr; } expr_stmt;\r\n    } data;\r\n} ASTNode;\r\n"]
