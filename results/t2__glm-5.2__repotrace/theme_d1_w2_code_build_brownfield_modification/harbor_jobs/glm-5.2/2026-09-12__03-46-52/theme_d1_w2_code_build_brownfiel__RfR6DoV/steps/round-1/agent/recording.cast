[5287.263646, "o", "     1\t#include \"parser.h\"\r\n     2\t\r\n     3\tstatic Token *current(Parser *p) { return &p->tokens[p->pos]; }\r\n     4\tstatic Token *prev(Parser *p) { return &p->tokens[p->pos - 1]; }\r\n     5\tstatic int check(Parser *p, TokenType t) { return current(p)->type == t; }\r\n     6\t\r\n     7\t"]
[5287.263778, "o", "static int match(Parser *p, TokenType t) {\r\n     8\t    if (check(p, t)) { p->pos++; return 1; }\r\n     9\t    return 0;\r\n    10\t}\r\n    11\t\r\n    12\tstatic void expect(Parser *p, TokenType t, const char *msg) {\r\n    13\t    if (!match(p, t)) {\r\n    14\t        error_at(current(p)->line, \"expected %s, got '%s'\", msg, current(p)->text);\r\n    15\t        p->had_error = 1;\r\n    16\t    }\r\n    17\t}\r\n    18\t\r\n    19\tstatic ASTNode *parse_expr(Parser *p);\r\n    20\tstatic ASTNode *parse_stmt(Parser *p);\r\n    21\tstatic ASTNode *parse_block(Parser *p);\r\n    22\tstatic ASTNode *parse_factor(Parser *p);\r\n    23\tstatic ASTNode *parse_term(Parser *p);\r\n    24\tstatic ASTNode *parse_comparison(Parser *p);\r\n    25\tstatic ASTNode *parse_logic_and(Parser *p);\r\n    26\tstatic ASTNode *parse_fn_expr(Parser *p);\r\n    27\t\r\n    28\tstatic ASTNode *parse_primary(Parser *p) {\r\n    29\t    if (match(p, TOK_NUM)) {\r\n"]
[5287.263857, "o", "    30\t        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;\r\n    31\t        n->data.num_val = prev(p)->literal.ival; return n;\r\n    32\t    }\r\n    33\t    if (match(p, TOK_STRING)) {\r\n    34\t        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;\r\n    35\t        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return n;\r\n    36\t    }\r\n    37\t    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {\r\n    38\t        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;\r\n    39\t        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;\r\n    40\t    }\r\n"]
