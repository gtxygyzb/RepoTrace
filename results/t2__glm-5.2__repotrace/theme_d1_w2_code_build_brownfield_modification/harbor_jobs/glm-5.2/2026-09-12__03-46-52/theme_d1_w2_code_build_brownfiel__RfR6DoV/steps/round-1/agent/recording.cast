[7702.638552, "o", "static int compile_node(Compiler *c, ASTNode *node) {\r\n    switch (node->type) {\r\n        case NODE_LET: {\r\n            int slot = add_local(c, node->data.let.name);\r\n            if (slot < 0) return -1;\r\n            compile_expr(c, node->data.let.init);\r\n            break;\r\n        }\r\n        case NODE_ASSIGN: {\r\n            compile_expr(c, node->data.assign.value);\r\n            compile_store(c, node->data.assign.name);\r\n            break;\r\n        }\r\n        case NODE_INDEX_ASSIGN: {\r\n"]
