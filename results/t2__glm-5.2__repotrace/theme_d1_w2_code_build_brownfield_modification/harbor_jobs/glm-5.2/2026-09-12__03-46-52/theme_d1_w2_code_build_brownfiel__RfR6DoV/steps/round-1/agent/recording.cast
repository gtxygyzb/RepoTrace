[1923.935042, "o", "\t\r\n    92\tstatic ASTNode *parse_factor(Parser *p) {\r\n    93\t    ASTNode *left = parse_unary(p);\r\n    94\t    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {\r\n    95\t        int line = prev(p)->line; BinOp op;\r\n    96\t        if (prev(p)->type == TOK_STAR) op = OP_MUL;\r\n    97\t        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;\r\n    98\t        else op = OP_MOD;\r\n    99\t        ASTNode *right = parse_unary(p);\r\n   100\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n"]
