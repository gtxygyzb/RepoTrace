[7749.403542, "o", "\u001b[32m\u001b[K418\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    map_set(mv.data.map, key, val);\r\n\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                }\r\n\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                push(vm, mv); break;\r\n\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n"]
[7749.403709, "o", "\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case \u001b[01;31m\u001b[KBC_MAP_GET\u001b[m\u001b[K: {\r\n\u001b[32m\u001b[K424\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                Value keyv = pop(vm); Value obj = pop(vm);\r\n\u001b[32m\u001b[K425\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (obj.type != VAL_MAP) { fprintf(stderr, \"cannot get field of non-map\\n\"); return -1; }\r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));\r\n\u001b[32m\u001b[K427\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int i = map_find(obj.data.map, key);\r\n\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (i < 0) { fprintf(stderr, \"key not found: %s\\n\", key); return -1; }\r\n\u001b[32m\u001b[K429\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                push(vm, obj.data.map->values[i]); break;\r\n\u001b[32m\u001b[K430\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K431\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            case BC_MAP_SET: {\r\n\u001b[32m\u001b[K432\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                Value val = pop(vm); Value keyv = pop(vm); Value obj = pop(vm);\r\n\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (obj.type != VAL_MAP)"]
[7749.403788, "o", " { fprintf(stderr, \"cannot set field on non-map\\n\"); return -1; }\r\n\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));\r\n\u001b[32m\u001b[K435\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                map_set(obj.data.map, key, val); break;\r\n"]
