[9925.206592, "o", "            if (check(p, TOK_LPAREN)) {\r\n                match(p, TOK_LPAREN);\r\n                ASTNode *n = ast_alloc(); n->type = NODE_METHOD_CALL; n->line = line;\r\n                n->data.method_call.obj = expr;\r\n                strncpy(n->data.method_call.method, name, MAX_IDENT_LEN - 1);\r\n                n->data.method_call.method[MAX_IDENT_LEN - 1] = '\\0';\r\n                nodelist_init(&n->data.method_call.args);\r\n                if (!check(p, TOK_RPAREN)) {\r\n"]
