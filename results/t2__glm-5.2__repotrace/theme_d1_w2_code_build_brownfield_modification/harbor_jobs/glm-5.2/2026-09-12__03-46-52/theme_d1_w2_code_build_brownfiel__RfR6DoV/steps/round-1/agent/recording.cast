[10872.973393, "o", "\r\n    ASTNode *body = parse_block(p);\r\n    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;\r\n    n->data.for_stmt.init = init;\r\n    n->data.for_stmt.cond = cond;\r\n    n->data.for_stmt.step = step;\r\n    n->data.for_stmt.body = body;\r\n    return n;\r\n}\r\n\r\nstatic ASTNode *parse_block(Parser *p) {\r\n    expect(p, TOK_LBRACE, \"'{'\");\r\n    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;\r\n    nodelist_init(&block->data.block.stmts);\r\n    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {\r\n        ASTNode *stmt = parse_stmt(p);\r\n        if (stmt) nodelist_push(&block->data.block.stmts, stmt);\r\n        if (p->had_error) break;\r\n    }\r\n    expect(p, TOK_RBRACE, \"'}'\");\r\n    return block;\r\n}\r\n\r\n\r\nstatic ASTNode *parse_expr(Parser *p);\r\nstatic ASTNode *parse_pattern(Parser *p) {\r\n    int line = current(p)->line;\r\n    ASTNode *n = ast_alloc();\r\n    n->type = NODE_LET_DESTRUCT; n->line = line;\r\n    nodelist_init(&n->data.let_destruct.names);\r\n    n->data.let_destruct.is_re"]
[10872.973572, "o", "st = NULL;\r\n    n->data.let_destruct.rest_name[0] = '\\0';\r\n    n->data.let_destruct.is_array = 0;\r\n    if (match(p, TOK_LBRACKET)) {\r\n        n->data.let_destruct.is_array = 1;\r\n        if (!check(p, TOK_RBRACKET)) {\r\n            do {\r\n                if (match(p, TOK_DOTDOT)) {\r\n                    expect(p, TOK_IDENT, \"rest variable name\");\r\n                    strncpy(n->data.let_destruct.rest_name, prev(p)->text, MAX_IDENT_LEN - 1);\r\n                    n->data.let_destruct.rest_name[MAX_IDENT_LEN - 1] = '\\0';\r\n                    break;\r\n                }\r\n                expect(p, TOK_IDENT, \"variable name\");\r\n                ASTNode *name = ast_alloc(); name->type = NODE_IDENT; name->line = prev(p)->line;\r\n                strncpy(name->data.ident, prev(p)->text, MAX_IDENT_LEN - 1);\r\n                name->data.ident[MAX_IDENT_LEN - 1] = '\\0';\r\n                nodelist_push(&n->data.let_destruct.names, name);\r\n            } while (match(p, TOK_COMMA));\r\n        }\r\n        expect(p, TOK_RBRACKET, \"']'\");\r"]
[10872.973682, "o", "\n    } else {\r\n        expect(p, TOK_LBRACE, \"'{'\");\r\n        if (!check(p, TOK_RBRACE)) {\r\n            do {\r\n                expect(p, TOK_IDENT, \"field name\");\r\n                ASTNode *name = ast_alloc(); name->type = NODE_IDENT; name->line = prev(p)->line;\r\n                strncpy(name->data.ident, prev(p)->text, MAX_IDENT_LEN - 1);\r\n                name->data.ident[MAX_IDENT_LEN - 1] = '\\0';\r\n                nodelist_push(&n->data.let_destruct.names, name);\r\n            } while (match(p, TOK_COMMA));\r\n        }\r\n        expect(p, TOK_RBRACE, \"'}'\");\r\n    }\r\n    return n;\r\n}\r\n\r\nstatic ASTNode *parse_stmt(Parser *p) {\r\n    if (match(p, TOK_LET)) {\r\n        int line = prev(p)->line;\r\n        if (check(p, TOK_LBRACKET) || check(p, TOK_LBRACE)) {\r\n            ASTNode *n = parse_pattern(p);\r\n            expect(p, TOK_ASSIGN, \"'='\");\r\n            ASTNode *init = parse_expr(p);\r\n            expect(p, TOK_SEMICOLON, \"';'\");\r\n            n->line = line;\r\n"]
[10872.973788, "o", "\u001b[?2004h"]
