[7609.183039, "o", "} Token;\r\n    49\t\r\n    50\ttypedef enum {\r\n    51\t    NODE_NUM_LIT, NODE_STR_LIT, NODE_BOOL_LIT,\r\n    52\t    NODE_IDENT, NODE_BINOP, NODE_UNARY,\r\n    53\t    NODE_CALL, NODE_INDEX,\r\n    54\t    NODE_ASSIGN, NODE_LET,\r\n    55\t    NODE_IF, NODE_WHILE, NODE_FOR, NODE_FOREACH,\r\n    56\t    NODE_RETURN, NODE_BREAK, NODE_CONTINUE,\r\n    57\t    NODE_PRINT, NODE_BLOCK, NODE_FUNC,\r\n    58\t    NODE_ARRAY_LIT, NODE_MAP_LIT, NODE_FIELD_ACCESS, NODE_FIELD_ASSIGN,\r\n    59\t    NODE_EXPR_STMT,\r\n    60\t    NODE_COMPOUND_ASSIGN, NODE_INDEX_ASSIGN, NODE_CLOSURE\r\n    61\t} NodeType;\r\n    62\t"]
