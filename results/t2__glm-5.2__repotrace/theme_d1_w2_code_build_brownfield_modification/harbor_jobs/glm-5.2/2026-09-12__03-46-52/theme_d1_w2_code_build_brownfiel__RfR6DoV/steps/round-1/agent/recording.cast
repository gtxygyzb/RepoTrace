[1286.343485, "o", "     9\tstatic Value pop(VM *vm) {\r\n    10\t    if (vm->sp <= 0) { fprintf(stderr, \"stack underflow\\n\"); exit(1); }\r\n    11\t    return vm->stack[--vm->sp];\r\n    12\t}\r\n    13\t\r\n    14\tstatic Value make_int(int64_t v) { Value val; val.type = VAL_INT; val.data.ival = v; return val; }\r\n    15\tstatic Value make_str(const char *s) { Value val; val.type = VAL_STR; val.data.sval = strdup(s); return val; }\r\n    16\tstatic Value make_bool(int b) { Value val; val.type = VAL_BOOL; val.data.bval = b; return val; }\r\n    17\t\r\n    18\tstatic int resolve_global(VM *vm, const char *name) {\r\n    19\t    for (int i = 0; i < vm->global_count; i++)\r\n    20\t        if (strcmp(vm->global_names[i], name) == 0) return i;\r\n    21\t    return -1;\r\n    22\t}\r\n    23\t\r\n    24\tstatic int add_global(VM *vm, const char *name) {\r\n"]
[1286.343559, "o", "    25\t    if (vm->global_count >= MAX_GLOBALS) { fprintf(stderr, \"too many globals\\n\"); return -1; }\r\n    26\t    int idx = vm->global_count;\r\n    27\t    strncpy(vm->global_names[idx], name, MAX_IDENT_LEN - 1);\r\n    28\t    vm->globals[idx].type = VAL_NULL;\r\n    29\t    vm->global_count++;\r\n    30\t    return idx;\r\n    31\t}\r\n    32\t\r\n    33\tstatic int64_t value_to_int(Value v) {\r\n    34\t    switch (v.type) { case VAL_INT: return v.data.ival; case VAL_BOOL: return v.data.bval ? 1 : 0; default: return 0; }\r\n    35\t}\r\n    36\t\r\n"]
[1286.343621, "o", "    37\tstatic int value_is_integer_like(Value v) {\r\n    38\t    return v.type == VAL_INT || v.type == VAL_BOOL;\r\n    39\t}\r\n    40\t\r\n    41\tstatic int value_truthy(Value v) {\r\n    42\t    switch (v.type) {\r\n    43\t        case VAL_INT: return v.data.ival != 0;\r\n    44\t        case VAL_BOOL: return v.data.bval;\r\n    45\t"]
[1286.343741, "o", "        case VAL_STR: return v.data.sval && v.data.sval[0] != '\\0';\r\n    46\t        case VAL_ARRAY: return v.data.array.len > 0;\r\n    47\t        case VAL_NULL: return 0;\r\n    48\t    }\r\n    49\t    return 0;\r\n    50\t}\r\n    51\t\r\n    52\tstatic int values_equal(Value a, Value b) {\r\n    53\t    if (a.type != b.type) return 0;\r\n    54\t    switch (a.type) {\r\n    55\t        case VAL_INT: return a.data.ival == b.data.ival;\r\n    56\t        case VAL_BOOL: return a.data.bval == b.data.bval;\r\n    57\t        case VAL_STR: return strcmp(a.data.sval, b.data.sval) == 0;\r\n    58\t        case VAL_NULL: return 1;\r\n    59\t        default: return 0;\r\n    60\t    }\r\n    61\t}\r\n    62\t\r\n    63\tstatic void print_value(Value v) {\r\n    64\t    switch (v.type) {\r\n    65\t"]
[1286.343804, "o", "        case VAL_INT: printf(\"%lld\", (long long)v.data.ival); break;\r\n    66\t        case VAL_BOOL: printf(\"%s\", v.data.bval ? \"true\" : \"false\"); break;\r\n    67\t        case VAL_STR: printf(\"%s\", v.data.sval); break;\r\n    68\t        case VAL_ARRAY:\r\n    69\t            printf(\"[\");\r\n    70\t            for (int i = 0; i < v.data.array.len; i++) {\r\n    71\t                if (i > 0) printf(\", \");\r\n    72\t                print_value(v.data.array.items[i]);\r\n    73\t            }\r\n    74\t            printf(\"]\");\r\n"]
[1286.343864, "o", "    75\t            break;\r\n    76\t        case VAL_NULL: printf(\"null\"); break;\r\n    77\t    }\r\n    78\t}\r\n    79\t\r\n    80\tvoid vm_init(VM *vm, Compiler *c) {\r\n    81\t    vm->sp = 0; vm->frame_count = 0; vm->global_count = 0;\r\n    82\t    vm->code = c->code; vm->code_count = c->code_count;\r\n    83\t"]
[1286.34393, "o", "    vm->functions = c->functions; vm->func_count = c->func_count;\r\n    84\t    vm->ip = 0;\r\n    85\t}\r\n    86\t\r\n    87\tint vm_run(VM *vm) {\r\n    88\t    while (vm->ip < vm->code_count) {\r\n    89\t        Instruction *ins = &vm->code[vm->ip++];\r\n    90\t        switch (ins->op) {\r\n    91\t            case BC_PUSH_INT: push(vm, make_int(ins->operand)); break;\r\n    92\t            case BC_PUSH_STR: push(vm, make_str(ins->str_operand)); break;\r\n"]
