[10997.81394, "o", "\u001b[?2004h> "]
[10997.814444, "o", "                if (fi < 0) { fprintf(stderr, \"cannot call non-function value\\\\n\"); return -1; }\r\n\u001b[?2004l\r"]
[10997.814507, "o", "\u001b[?2004h> "]
[10997.814761, "o", "                FuncInfo *func = &vm->functions[fi];\r\n\u001b[?2004l\r"]
[10997.814824, "o", "\u001b[?2004h> "]
[10997.815455, "o", "                if (vm->frame_count >= MAX_CALL_FRAMES) { fprintf(stderr, \"call stack overflow\\\\n\"); return -1; }\r\n\u001b[?2004l\r"]
[10997.815517, "o", "\u001b[?2004h> "]
[10997.815858, "o", "                CallFrame *frame = &vm->frames[vm->frame_count++];\r\n\u001b[?2004l\r"]
[10997.815922, "o", "\u001b[?2004h> "]
