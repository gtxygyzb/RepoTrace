[7609.182831, "o", "typedef enum {\r\n    23\t    TOK_NUM, TOK_STRING, TOK_IDENT,\r\n    24\t    TOK_PLUS, TOK_MINUS, TOK_STAR, TOK_SLASH, TOK_PERCENT,\r\n    25\t    TOK_EQ, TOK_NEQ, TOK_LT, TOK_GT, TOK_LEQ, TOK_GEQ,\r\n    26\t    TOK_ASSIGN, TOK_AND, TOK_OR, TOK_NOT,\r\n    27\t    TOK_LPAREN, TOK_RPAREN, TOK_LBRACE, TOK_RBRACE,\r\n    28\t    TOK_LBRACKET, TOK_RBRACKET,\r\n    29\t    TOK_SEMICOLON, TOK_COMMA,\r\n    30\t    TOK_IF, TOK_ELSE, TOK_WHILE, TOK_FOR, TOK_RETURN,\r\n    31\t    TOK_BREAK, TOK_CONTINUE, TOK_IN, TOK_OF,\r\n    32\t    TOK_FN, TOK_LET, TOK_PRINT, TOK_TRUE, TOK_FALSE,\r\n"]
[7609.182902, "o", "    33\t    TOK_DOT,\r\n    34\t    TOK_COLON,\r\n    35\t    TOK_PLUS_ASSIGN, TOK_MINUS_ASSIGN, TOK_STAR_ASSIGN, TOK_SLASH_ASSIGN, TOK_PERCENT_ASSIGN,\r\n    36\t    TOK_EOF, TOK_ERROR\r\n    37\t} TokenType;\r\n    38\t\r\n    39\ttypedef struct {\r\n    40\t    TokenType type;\r\n    41\t    char text[MAX_STRING_LEN];\r\n    42\t    int line;\r\n"]
