[391.234154, "o", "   149\tstatic ASTNode *parse_expr(Parser *p) {\r\n   150\t    ASTNode *left = parse_logic_and(p);\r\n   151\t    while (match(p, TOK_OR)) {\r\n   152\t        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);\r\n   153\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   154\t        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;\r\n   155\t        left = n;\r\n   156\t    }\r\n   157\t    return left;\r\n   158\t}\r\n   159\t\r\n   160\tstatic ASTNode *try_parse_assign(Parser *p) {\r\n   161\t    if (!check(p, TOK_IDENT)) return NULL;\r\n   162\t    int saved = p->pos;\r\n   163\t    p->pos++;\r\n   164\t    if (check(p, TOK_ASSIGN)) {\r\n   165\t        p->pos = saved; match(p, TOK_IDENT);\r\n   166\t        char name[MAX_IDENT_LEN];\r\n   167\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n   168\t        int line = prev(p)->line;\r\n   169\t        expect(p, TOK_ASSIGN, \"'='\");\r\n   170\t        ASTNode *val = parse_expr(p);\r\n"]
[391.234269, "o", "   171\t        ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;\r\n   172\t        strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);\r\n   173\t        n->data.assign.value = val; return n;\r\n   174\t    }\r\n   175\t    p->pos = saved; return NULL;\r\n   176\t}\r\n   177\t\r\n   178\tstatic ASTNode *parse_block(Parser *p) {\r\n   179\t    expect(p, TOK_LBRACE, \"'{'\");\r\n   180\t    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;\r\n   181\t    nodelist_init(&block->data.block.stmts);\r\n   182\t    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {\r\n   183\t        ASTNode *stmt = parse_stmt(p);\r\n   184\t        if (stmt) nodelist_push(&block->data.block.stmts, stmt);\r\n   185\t        if (p->had_error) break;\r\n   186"]
[391.234344, "o", "\t    }\r\n   187\t    expect(p, TOK_RBRACE, \"'}'\");\r\n   188\t    return block;\r\n   189\t}\r\n   190\t\r\n   191\tstatic ASTNode *parse_stmt(Parser *p) {\r\n   192\t    if (match(p, TOK_LET)) {\r\n   193\t        int line = prev(p)->line;\r\n   194\t        expect(p, TOK_IDENT, \"identifier\");\r\n   195\t        char name[MAX_IDENT_LEN];\r\n   196\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n"]
[391.234482, "o", "   197\t        expect(p, TOK_ASSIGN, \"'='\");\r\n   198\t        ASTNode *init = parse_expr(p);\r\n   199\t        expect(p, TOK_SEMICOLON, \"';'\");\r\n   200\t        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;\r\n   201\t        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);\r\n   202\t        n->data.let.init = init; return n;\r\n   203\t    }\r\n"]
[391.234553, "o", "   204\t    if (match(p, TOK_IF)) {\r\n   205\t        int line = prev(p)->line;\r\n   206\t        expect(p, TOK_LPAREN, \"'('\");\r\n   207\t        ASTNode *cond = parse_expr(p);\r\n   208\t        expect(p, TOK_RPAREN, \"')'\");\r\n   209\t        ASTNode *then_b = parse_block(p);\r\n   210\t        ASTNode *else_b = NULL;\r\n"]
