[9944.32875, "o", "sed -n '29,100p' src/parser.c\r\n"]
[9944.328847, "o", "\u001b[?2004l\r"]
[9944.331875, "o", "static ASTNode *parse_primary(Parser *p) {\r\n    if (match(p, TOK_NUM)) {\r\n        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;\r\n        n->data.num_val = prev(p)->literal.ival; return n;\r\n    }\r\n    if (match(p, TOK_STRING)) {\r\n        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;\r\n        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return parse_postfix(p, n);\r\n"]
[9944.331947, "o", "    }\r\n    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;\r\n        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;\r\n    }\r\n    if (match(p, TOK_IDENT)) {\r\n        char name[MAX_IDENT_LEN];\r\n        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\\0';\r\n        int line = prev(p)->line;\r\n        if (match(p, TOK_LPAREN)) {\r\n            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;\r\n            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);\r\n            nodelist_init(&n->data.call.args);\r\n            if (!check(p, TOK_RPAREN)) {\r\n"]
[9944.332005, "o", "                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));\r\n            }\r\n            expect(p, TOK_RPAREN, \"')'\"); return parse_postfix(p, n);\r\n        }\r\n        ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;\r\n        strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);\r\n        return parse_postfix(p, obj);\r\n    }\r\n    if (match(p, TOK_LBRACE)) {\r\n        int line = prev(p)->line;"]
[9944.33206, "o", "\r\n        ASTNode *n = ast_alloc(); n->type = NODE_MAP_LIT; n->line = line;\r\n        nodelist_init(&n->data.map_lit.keys);\r\n        nodelist_init(&n->data.map_lit.values);\r\n        if (!check(p, TOK_RBRACE)) {\r\n            do {\r\n                if (!check(p, TOK_STRING)) {\r\n                    error_at(current(p)->line, \"map keys must be string literals\");\r\n                    p->had_error = 1; p->pos++;\r\n"]
[9944.332113, "o", "                } else {\r\n                    match(p, TOK_STRING);\r\n                    ASTNode *key = ast_alloc(); key->type = NODE_STR_LIT; key->line = prev(p)->line;\r\n                    strncpy(key->data.str_val, prev(p)->text, MAX_STRING_LEN - 1);\r\n                    expect(p, TOK_COLON, \"':'\");\r\n                    ASTNode *val = parse_expr(p);\r\n                    nodelist_push(&n->data.map_lit.keys, key);\r\n                    nodelist_push(&n->data.map_lit.values, val);\r\n                }\r\n"]
[9944.332168, "o", "            } while (match(p, TOK_COMMA));\r\n        }\r\n        expect(p, TOK_RBRACE, \"'}'\");\r\n        return parse_postfix(p, n);\r\n    }\r\n    if (match(p, TOK_FN)) {\r\n        return parse_postfix(p, parse_fn_expr(p));\r\n    }\r\n    if (match(p, TOK_LBRACKET)) {\r\n        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;\r\n        nodelist_init(&n->data.array_lit.elems);\r\n        if (!check(p, TOK_RBRACKET)) {\r\n            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));\r\n"]
[9944.332261, "o", "        }\r\n        expect(p, TOK_RBRACKET, \"']'\"); return parse_postfix(p, n);\r\n    }\r\n    if (match(p, TOK_LPAREN)) {\r\n        ASTNode *expr = parse_expr(p); expect(p, TOK_RPAREN, \"')'\"); return parse_postfix(p, expr);\r\n    }\r\n    error_at(current(p)->line, \"unexpected token '%s'\", current(p)->text);\r\n    p->had_error = 1; p->pos++; return ast_alloc();\r\n}\r\n\r\n"]
[9944.332854, "o", "\u001b[?2004h"]
[9944.332915, "o", "root@n30009:/app# "]
[9944.627282, "i", "grep -n -A20 -B10 \"case '.':\" src/lexer.c\n"]
[9944.627642, "o", "grep -n -A20 -B10 \"case '.':\" src/lexer.c\r\n\u001b[?2004l\r"]
[9944.630869, "o", "\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic int lex_string(Lexer *lex) {\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    advance(lex);\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    char buf[MAX_STRING_LEN]; int i = 0;\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (!is_at_end(lex) && peek(lex) != '\"') {\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        char c = advance(lex);\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (c == '\\\\') {\r\n"]
[9944.630994, "o", "\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (is_at_end(lex)) { error_at(lex->line, \"unterminated string\"); return -1; }\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            char esc = advance(lex);\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            switch (esc) {\r\n"]
[9944.63108, "o", "\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase 'n':\u001b[m\u001b[K c = '\\n'; break;\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase 't':\u001b[m\u001b[K c = '\\t'; break;\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                case '\\\\': c = '\\\\'; break;\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '\"':\u001b[m\u001b[K c = '\"'; break;\r\n\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase 'r':\u001b[m\u001b[K c = '\\r'; break;\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '0':\u001b[m\u001b[K c = '\\0'; break;\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                default: error_at(lex->line, \"unknown string escape \\\\%c\", esc); return -1;\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n"]
[9944.63115, "o", "\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (i < MAX_STRING_LEN - 1) buf[i++] = c;\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (is_at_end(lex)) { error_at(lex->line, \"unterminated string\"); return -1; }\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    advance(lex);\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    buf[i] = '\\0';\r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Token t = make_token(lex, TOK_STRING, buf);\r\n\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return add_token(lex, t);\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic int lex_ident(Lexer *lex) {\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    char buf[MAX_IDENT_LEN]; int i = 0;\r\n\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (!is_at_end(lex) && (isalnum(peek(lex)) || peek(lex) == '_')) {\r\n"]
[9944.631241, "o", "\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (i < MAX_IDENT_LEN - 1) buf[i++] = advance(lex); else advance(lex);\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    buf[i] = '\\0';\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    TokenType type = TOK_IDENT;\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if      (strcmp(buf, \"if\") == 0)       type = TOK_IF;\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (is_at_end(lex)) break;\r\n\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        char c = peek(lex);\r\n\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (isdigit(c)) { if (lex_number(lex) < 0) return -1; }\r\n\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        else if (c == '\"') { if (lex_string(lex) < 0) return -1; }\r\n\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        else if (isalpha(c) || c == '_') { if (lex_ident(lex) < 0) return -1; }\r\n\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        else {\r\n"]
[9944.631312, "o", "\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            advance(lex);\r\n\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            char buf[4] = {c, '\\0', '\\0', '\\0'};\r\n\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            TokenType type = TOK_ERROR;\r\n\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            switch (c) {\r\n\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '+':\u001b[m\u001b[K if (peek(lex)=='='){advance(lex);type=TOK_PLUS_ASSIGN;strcpy(buf,\"+=\");}else{type=TOK_PLUS;} break;\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '-':\u001b[m\u001b[K if (peek(lex)=='='){advance(lex);type=TOK_MINUS_ASSIGN;strcpy(buf,\"-=\");}else{type=TOK_MINUS;} break;\r\n\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '*':\u001b[m\u001b[K if (peek(lex)=='='){advance(lex);type=TOK_STAR_ASSIGN;strcpy(buf,\"*=\");}else{type=TOK_STAR;} break;\r\n\u001b[32m\u001b[K139\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '/':\u001b[m\u001b[K if (peek(lex)=='='){advance(lex);type=TOK_SLASH_ASSIGN;strcpy(buf,\"/=\");}else{type=TOK_SLASH;} break;\r\n\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            "]
[9944.63138, "o", "    \u001b[01;31m\u001b[Kcase '%':\u001b[m\u001b[K if (peek(lex)=='='){advance(lex);type=TOK_PERCENT_ASSIGN;strcpy(buf,\"%=\");}else{type=TOK_PERCENT;} break;\r\n\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '(':\u001b[m\u001b[K type = TOK_LPAREN; break;\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase ')':\u001b[m\u001b[K type = TOK_RPAREN; break;\r\n\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '{':\u001b[m\u001b[K type = TOK_LBRACE; break;\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '}':\u001b[m\u001b[K type = TOK_RBRACE; break;\r\n\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '[':\u001b[m\u001b[K type = TOK_LBRACKET; break;\r\n\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase ']':\u001b[m\u001b[K type = TOK_RBRACKET; break;\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase ';':\u001b[m\u001b[K type = TOK_SEMICOLON; break;\r\n"]
[9944.631446, "o", "\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase ',':\u001b[m\u001b[K type = TOK_COMMA; break;\r\n\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kcase '.':\u001b[m\u001b[K type = TOK_DOT; break;\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kcase ':':\u001b[m\u001b[K type = TOK_COLON; break;\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '!':\u001b[m\u001b[K if (peek(lex)=='='){advance(lex);type=TOK_NEQ;strcpy(buf,\"!=\");}else{type=TOK_NOT;} break;\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '=':\u001b[m\u001b[K if (peek(lex)=='='){advance(lex);type=TOK_EQ;strcpy(buf,\"==\");}else{type=TOK_ASSIGN;} break;\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '<':\u001b[m\u001b[K if (peek(lex)=='='){advance(lex);type=TOK_LEQ;strcpy(buf,\"<=\");}else{type=TOK_LT;} break;\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '>':\u001b[m\u001b[K if (peek(lex)=='='){advance(lex);type=TOK_GEQ;strcpy(buf,\">=\");}else{type=TOK_GT;} break;\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase"]
[9944.631513, "o", " '&':\u001b[m\u001b[K if (peek(lex)=='&'){advance(lex);type=TOK_AND;strcpy(buf,\"&&\");}\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                          else{error_at(lex->line,\"unexpected character '&'\");return -1;} break;\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kcase '|':\u001b[m\u001b[K if (peek(lex)=='|'){advance(lex);type=TOK_OR;strcpy(buf,\"||\");}\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                          else{error_at(lex->line,\"unexpected character '|'\");return -1;} break;\r\n\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                default: error_at(lex->line, \"unexpected character '%c'\", c); return -1;\r\n\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            Token t = make_token(lex, type, buf);\r\n\u001b[32m\u001b[K162\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (add_token(lex, t) < 0) return -1;\r\n"]
[9944.63159, "o", "\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Token eof = make_token(lex, TOK_EOF, \"\");\r\n\u001b[32m\u001b[K166\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return add_token(lex, eof);\r\n\u001b[32m\u001b[K167\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kconst char *token_type_name(TokenType t) {\r\n\u001b[32m\u001b[K170\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    switch (t) {\r\n\u001b[32m\u001b[K171\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case TOK_NUM: return \"NUM\"; case TOK_STRING: return \"STRING\"; case TOK_IDENT: return \"IDENT\";\r\n\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case TOK_PLUS: return \"+\"; case TOK_MINUS: return \"-\"; case TOK_STAR: return \"*\";\r\n\u001b[32m\u001b[K173\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case TOK_SLASH: return \"/\"; case TOK_PERCENT: return \"%\";\r\n\u001b[32m\u001b[K174\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case TOK_EQ: return \"==\"; case TOK_NEQ: return \"!=\";\r\n\u001b[32m\u001b[K175\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case TOK_LT: return \"<\"; case TOK_GT: return \">\"; case TOK_LEQ: return \"<=\"; case TOK_GEQ: return \">=\";\r\n\u001b[32m\u001b["]
[9944.631676, "o", "K176\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case TOK_ASSIGN: return \"=\"; case TOK_AND: return \"&&\"; case TOK_OR: return \"||\"; case TOK_NOT: return \"!\";\r\n\u001b[32m\u001b[K177\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case TOK_LPAREN: return \"(\"; case TOK_RPAREN: return \")\";\r\n"]
