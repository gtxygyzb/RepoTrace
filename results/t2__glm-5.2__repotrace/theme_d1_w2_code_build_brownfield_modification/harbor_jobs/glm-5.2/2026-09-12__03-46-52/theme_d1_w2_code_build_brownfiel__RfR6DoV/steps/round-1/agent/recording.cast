[10880.666901, "o", "                ASTNode *name = ast_alloc(); name->type = NODE_IDENT; name->line = prev(p)->line;\r\n                strncpy(name->data.ident, prev(p)->text, MAX_IDENT_LEN - 1);\r\n                name->data.ident[MAX_IDENT_LEN - 1] = '\\0';\r\n                nodelist_push(&n->data.let_destruct.names, name);\r\n            } while (match(p, TOK_COMMA));\r\n        }\r\n        expect(p, TOK_RBRACKET, \"']'\");\r\n    } else {\r\n        expect(p, TOK_LBRACE, \"'{'\");\r\n        if (!check(p, TOK_RBRACE)) {\r\n            do {\r\n                expect(p, TOK_IDENT, \"field name\");\r\n                ASTNode *name = ast_alloc(); name->type = NODE_IDENT; name->line = prev(p)->line;\r\n                strncpy(name->data.ident, prev(p)->text, MAX_IDENT_LEN - 1);\r\n                name->data.ident[MAX_IDENT_LEN - 1] = '\\0';\r\n                nodelist_push(&n->data.let_destruct.names, name);\r\n            } while (match(p, TOK_COMMA));\r\n        }\r\n        expect(p, TOK_RBRACE, \"'}'\");\r\n    }\r\n    return n;\r\n}\r\n\r\nstatic ASTNode *parse_stmt(Parser *"]
[10880.666968, "o", "p) {\r\n    if (match(p, TOK_LET)) {\r\n        int line = prev(p)->line;\r\n        if (check(p, TOK_LBRACKET) || check(p, TOK_LBRACE)) {\r\n            ASTNode *n = parse_pattern(p);\r\n            expect(p, TOK_ASSIGN, \"'='\");\r\n            ASTNode *init = parse_expr(p);\r\n            expect(p, TOK_SEMICOLON, \"';'\");\r\n            n->line = line;\r\n"]
