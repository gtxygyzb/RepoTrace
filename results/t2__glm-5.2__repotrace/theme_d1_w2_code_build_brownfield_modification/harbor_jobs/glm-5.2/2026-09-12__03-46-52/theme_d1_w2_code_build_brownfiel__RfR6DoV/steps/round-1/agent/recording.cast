[8638.046821, "o", "\u001b[?2004l\r"]
[8638.050797, "o", "$\r\nstatic int lex_ident(Lexer *lex) {$\r\n    char buf[MAX_IDENT_LEN]; int i = 0;$\r\n    while (!is_at_end(lex) && (isalnum(peek(lex)) || peek(lex) == '_')) {$\r\n        if (i < MAX_IDENT_LEN - 1) buf[i++] = advance(lex); else advance(lex);$\r\n    }$\r\n    buf[i] = '\\0';$\r\n    TokenType type = TOK_IDENT;$\r\n    if      (strcmp(buf, \"if\") == 0)       type = TOK_IF;$\r\n    else if (strcmp(buf, \"else\") == 0)     type = TOK_ELSE;$\r\n    else if (strcmp(buf, \"while\") == 0)    type = TOK_WHILE;$\r\n    else if (strcmp(buf, \"for\") == 0)     type = TOK_FOR;$\r\n    else if (strcmp(buf, \"break\") == 0)   type = TOK_BREAK;$\r\n    else if (strcmp(buf, \"continue\") == 0) type = TOK_CONTINUE;$\r\n    else if (strcmp(buf, \"in\") == 0)      type = TOK_IN;$\r\n    else if (strcmp(buf, \"of\") == 0)      type = TOK_OF;$\r\n    else if (strcmp(buf, \"return\") == 0)   type = TOK_RETURN;$\r\n    else if (strcmp(buf, \"fn\") == 0)       type = TOK_FN;$\r\n    else if (strcmp(buf, \"let\") == 0)      type = TOK_LET;$\r\n    else if (strcmp(buf, \"print\") == 0)    typ"]
[8638.050842, "o", "e = TOK_PRINT;$\r\n    else if (strcmp(buf, \"true\") == 0)     type = TOK_TRUE;$\r\n    else if (strcmp(buf, \"false\") == 0)    type = TOK_FALSE;$\r\n    Token t = make_token(lex, type, buf);$\r\n    return add_token(lex, t);$\r\n}$\r\n$\r\n"]
