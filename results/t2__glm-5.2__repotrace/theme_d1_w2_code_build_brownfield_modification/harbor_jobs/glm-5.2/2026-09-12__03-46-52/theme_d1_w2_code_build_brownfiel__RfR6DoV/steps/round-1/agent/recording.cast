[7593.531785, "o", "#include \"parser.h\"\r\n\r\nstatic Token *current(Parser *p) { return &p->tokens[p->pos]; }\r\nstatic Token *prev(Parser *p) { return &p->tokens[p->pos - 1]; }\r\nstatic int check(Parser *p, TokenType t) { return current(p)->type == t; }\r\n\r\nstatic int match(Parser *p, TokenType t) {\r\n    if (check(p, t)) { p->pos++; return 1; }\r\n    return 0;\r\n}\r\n\r\n"]
[7593.531927, "o", "static void expect(Parser *p, TokenType t, const char *msg) {\r\n    if (!match(p, t)) {\r\n        error_at(current(p)->line, \"expected %s, got '%s'\", msg, current(p)->text);\r\n        p->had_error = 1;\r\n    }\r\n}\r\n\r\nstatic ASTNode *parse_expr(Parser *p);\r\nstatic ASTNode *parse_stmt(Parser *p);\r\nstatic ASTNode *parse_block(Parser *p);\r\nstatic ASTNode *parse_factor(Parser *p);\r\nstatic ASTNode *parse_term(Parser *p);\r\nstatic ASTNode *parse_comparison(Parser *p);\r\nstatic ASTNode *parse_logic_and(Parser *p);\r\nstatic ASTNode *parse_fn_expr(Parser *p);\r\nstatic ASTNode *parse_postfix(Parser *p, ASTNode *expr);\r\n\r\nstatic ASTNode *parse_primary(Parser *p) {\r\n    if (match(p, TOK_NUM)) {\r\n        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;\r\n        n->data.num_val = prev(p)->literal.ival; return n;\r\n    }\r\n    if (match(p, TOK_STRING)) {\r\n        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;\r\n        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); retu"]
[7593.532012, "o", "rn n;\r\n    }\r\n    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;\r\n        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;\r\n    }\r\n    if (match(p, TOK_IDENT)) {\r\n        char name[MAX_IDENT_LEN];\r\n        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\\0';\r\n        int line = prev(p)->line;\r\n        if (match(p, TOK_LPAREN)) {\r\n            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;\r\n            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);\r\n            nodelist_init(&n->data.call.args);\r\n            if (!check(p, TOK_RPAREN)) {\r\n"]
[7593.532094, "o", "                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));\r\n            }\r\n            expect(p, TOK_RPAREN, \"')'\"); return parse_postfix(p, n);\r\n        }\r\n        ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;\r\n        strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);\r\n        return parse_postfix(p, obj);\r\n    }\r\n    if (match(p, TOK_LBRACE)) {\r\n        int line = prev(p)->line;\r\n        ASTNode *n = ast_alloc(); n->type = NODE_MAP_LIT; n->line = line;\r\n        nodelist_init(&n->data.map_lit.keys);\r\n        nodelist_init(&n->data.map_lit.values);\r\n        if (!check(p, TOK_RBRACE)) {\r\n            do {\r\n                if (!check(p, TOK_STRING)) {\r\n                    error_at(current(p)->line, \"map keys must be string literals\");\r\n                    p->had_error = 1; p->pos++;\r\n                } else {\r\n                    match(p, TOK_STRING);\r\n                    ASTNode *key = ast_alloc(); key->type = NODE_STR_LIT; key->line = prev(p)->"]
[7593.532163, "o", "line;\r\n                    strncpy(key->data.str_val, prev(p)->text, MAX_STRING_LEN - 1);\r\n                    expect(p, TOK_COLON, \"':'\");\r\n                    ASTNode *val = parse_expr(p);\r\n                    nodelist_push(&n->data.map_lit.keys, key);\r\n                    nodelist_push(&n->data.map_lit.values, val);\r\n                }\r\n            } while (match(p, TOK_COMMA));\r\n        }\r\n        expect(p, TOK_RBRACE, \"'}'\");\r\n        return parse_postfix(p, n);\r\n    }\r\n    if (match(p, TOK_FN)) {\r\n        return parse_postfix(p, parse_fn_expr(p));\r\n    }\r\n    if (match(p, TOK_LBRACKET)) {\r\n        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;\r\n        nodelist_init(&n->data.array_lit.elems);\r\n        if (!check(p, TOK_RBRACKET)) {\r\n"]
[7593.53226, "o", "            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));\r\n        }\r\n        expect(p, TOK_RBRACKET, \"']'\"); return parse_postfix(p, n);\r\n    }\r\n    if (match(p, TOK_LPAREN)) {\r\n        ASTNode *expr = parse_expr(p); expect(p, TOK_RPAREN, \"')'\"); return parse_postfix(p, expr);\r\n    }\r\n    error_at(current(p)->line, \"unexpected token '%s'\", current(p)->text);\r\n    p->had_error = 1; p->pos++; return ast_alloc();\r\n}\r\n\r\nstatic ASTNode *parse_fn_expr(Parser *p) {\r\n    int line = prev(p)->line;\r\n"]
[7593.532328, "o", "    expect(p, TOK_LPAREN, \"'('\");\r\n    ASTNode *n = ast_alloc(); n->type = NODE_CLOSURE; n->line = line;\r\n    n->data.closure.param_count = 0;\r\n    if (!check(p, TOK_RPAREN)) {\r\n        do {\r\n            expect(p, TOK_IDENT, \"parameter name\");\r\n            strncpy(n->data.closure.params[n->data.closure.param_count],\r\n                   prev(p)->text, MAX_IDENT_LEN - 1);\r\n            n->data.closure.param_count++;\r\n        } while (match(p, TOK_COMMA));\r\n    }\r\n    expect(p, TOK_RPAREN, \"')'\");\r\n    n->data.closure.body = parse_block(p);\r\n    return n;\r\n"]
[7593.53239, "o", "}\r\n\r\nstatic ASTNode *parse_postfix(Parser *p, ASTNode *expr) {\r\n    for (;;) {\r\n        if (match(p, TOK_DOT)) {\r\n            int line = prev(p)->line;\r\n            expect(p, TOK_IDENT, \"field name\");\r\n            ASTNode *n = ast_alloc(); n->type = NODE_FIELD_ACCESS; n->line = line;\r\n            n->data.field_access.obj = expr;\r\n            strncpy(n->data.field_access.field, prev(p)->text, MAX_IDENT_LEN - 1);\r\n            n->data.field_access.field[MAX_IDENT_LEN - 1] = '\\0';\r\n            expr = n;\r\n        } else if (match(p, TOK_LBRACKET)) {\r\n"]
[7593.532468, "o", "            int line = prev(p)->line;\r\n            ASTNode *idx = parse_expr(p);\r\n            expect(p, TOK_RBRACKET, \"']'\");\r\n            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;\r\n            n->data.index_access.obj = expr;\r\n            n->data.index_access.index = idx;\r\n            expr = n;\r\n        } else {\r\n            break;\r\n        }\r\n    }\r\n    return expr;\r\n}\r\n\r\nstatic ASTNode *parse_unary(Parser *p) {\r\n    if (match(p, TOK_MINUS)) {\r\n"]
[7593.53253, "o", "        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;\r\n    }\r\n    if (match(p, TOK_NOT)) {\r\n        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;\r\n    }\r\n    return parse_primary(p);\r\n}\r\n\r\n"]
[7593.532593, "o", "static ASTNode *parse_factor(Parser *p) {\r\n    ASTNode *left = parse_unary(p);\r\n    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {\r\n        int line = prev(p)->line; BinOp op;\r\n        if (prev(p)->type == TOK_STAR) op = OP_MUL;\r\n        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;\r\n        else op = OP_MOD;\r\n        ASTNode *right = parse_unary(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n        left = n;\r\n    }\r\n"]
[7593.532654, "o", "    return left;\r\n}\r\n\r\nstatic ASTNode *parse_comparison(Parser *p) {\r\n    ASTNode *left = parse_term(p);\r\n    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||\r\n           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {\r\n        int line = prev(p)->line; BinOp op;\r\n        switch (prev(p)->type) {\r\n            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;\r\n            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;\r\n            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;\r\n"]
[7593.53272, "o", "            default: op = OP_EQ; break;\r\n        }\r\n        ASTNode *right = parse_term(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n        left = n;\r\n    }\r\n    return left;\r\n}\r\n\r\nstatic ASTNode *parse_term(Parser *p) {\r\n    ASTNode *left = parse_factor(p);\r\n"]
[7593.532783, "o", "    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {\r\n        int line = prev(p)->line;\r\n        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;\r\n        ASTNode *right = parse_factor(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n        left = n;\r\n    }\r\n    return left;\r\n}\r\n\r\nstatic ASTNode *parse_logic_and(Parser *p) {\r\n"]
[7593.532843, "o", "    ASTNode *left = parse_comparison(p);\r\n    while (match(p, TOK_AND)) {\r\n        int line = prev(p)->line; ASTNode *right = parse_comparison(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;\r\n        left = n;\r\n    }\r\n    return left;\r\n}\r\n\r\nstatic ASTNode *parse_expr(Parser *p) {\r\n    ASTNode *left = parse_logic_and(p);\r\n"]
[7593.532904, "o", "    while (match(p, TOK_OR)) {\r\n        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;\r\n        left = n;\r\n    }\r\n    return left;\r\n}\r\n\r\nstatic ASTNode *try_parse_assign(Parser *p) {\r\n    if (!check(p, TOK_IDENT)) return NULL;\r\n"]
[7593.532967, "o", "    int saved = p->pos;\r\n    int line = current(p)->line;\r\n    ASTNode *target = parse_expr(p);\r\n    if (target && (target->type == NODE_FIELD_ACCESS || target->type == NODE_INDEX)) {\r\n        if (check(p, TOK_ASSIGN)) {\r\n            match(p, TOK_ASSIGN);\r\n            ASTNode *val = parse_expr(p);\r\n            if (target->type == NODE_FIELD_ACCESS) {\r\n                ASTNode *n = ast_alloc(); n->type = NODE_FIELD_ASSIGN; n->line = line;\r\n                n->data.field_assign.obj = target->data.field_access.obj;\r\n                strncpy(n->data.field_assign.field, target->data.field_access.field, MAX_IDENT_LEN - 1);\r\n                n->data.field_assign.field[MAX_IDENT_LEN - 1] = '\\0';\r\n"]
[7593.533031, "o", "                n->data.field_assign.value = val;\r\n                return n;\r\n            } else {\r\n                ASTNode *n = ast_alloc(); n->type = NODE_INDEX_ASSIGN; n->line = line;\r\n                n->data.index_assign.name[0] = '\\0';\r\n                n->data.index_assign.obj = target->data.index_access.obj;\r\n                n->data.index_assign.index = target->data.index_access.index;\r\n                n->data.index_assign.value = val;\r\n                return n;\r\n            }\r\n        }\r\n    }"]
[7593.533096, "o", "\r\n    p->pos = saved;\r\n    if (check(p, TOK_IDENT)) {\r\n        p->pos++;\r\n        char name[MAX_IDENT_LEN];\r\n        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n        line = prev(p)->line;\r\n        if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||\r\n            check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {\r\n"]
[7593.53364, "o", "\u001b[?2004h"]
[7593.533709, "o", "root@n30009:/app# "]
[7593.827033, "i", "sed -n '260,620p' src/parser.c\n"]
[7593.827374, "o", "sed -n '260,620p' src/parser.c\r\n\u001b[?2004l\r"]
[7593.830403, "o", "            check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {\r\n            p->pos = saved; match(p, TOK_IDENT);\r\n            TokenType op_tok = current(p)->type;\r\n            BinOp op = OP_ADD;\r\n            const char *msg = \"'='\";\r\n            if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = \"'+='\"; expect(p, TOK_PLUS_ASSIGN, \"'+='\"); }\r\n            else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = \"'-='\"; expect(p, TOK_MINUS_ASSIGN, \"'-='\"); }\r\n            else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = \"'*='\"; expect(p, TOK_STAR_ASSIGN, \"'*='\"); }\r\n"]
[7593.830519, "o", "            else if (op_tok == TOK_SLASH_ASSIGN) { op = OP_DIV; msg = \"'/='\"; expect(p, TOK_SLASH_ASSIGN, \"'/='\"); }\r\n            else if (op_tok == TOK_PERCENT_ASSIGN) { op = OP_MOD; msg = \"'%='\"; expect(p, TOK_PERCENT_ASSIGN, \"'%='\"); }\r\n            else { expect(p, TOK_ASSIGN, \"'='\"); }\r\n            ASTNode *val = parse_expr(p);\r\n            if (op_tok == TOK_ASSIGN) {\r\n                ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;\r\n                strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);\r\n                n->data.assign.value = val; return n;\r\n            } else {\r\n                ASTNode *n = ast_alloc(); n->type = NODE_COMPOUND_ASSIGN; n->line = line;\r\n                strncpy(n->data.compound_assign.name, name, MAX_IDENT_LEN - 1);\r\n                n->data.compound_assign.op = op;\r\n                n->data.compound_assign.value = val; return n;\r\n            }\r\n        }\r\n    }\r\n    p->pos = saved; return NULL;\r\n}\r\n\r\nstatic ASTNode *parse_for(Parser *p) {\r\n    int line = prev"]
[7593.830595, "o", "(p)->line;\r\n    expect(p, TOK_LPAREN, \"'('\");\r\n\r\n    if (check(p, TOK_IDENT) && p->pos + 1 < p->count &&\r\n        (p->tokens[p->pos + 1].type == TOK_IN || p->tokens[p->pos + 1].type == TOK_OF)) {\r\n        char name[MAX_IDENT_LEN];\r\n        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n        match(p, TOK_IDENT);\r\n        int is_of = match(p, TOK_OF);\r\n        if (!is_of) match(p, TOK_IN);"]
[7593.830668, "o", "\r\n        ASTNode *arr = parse_expr(p);\r\n        expect(p, TOK_RPAREN, \"')'\");\r\n        ASTNode *body = parse_block(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;\r\n        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);\r\n        n->data.foreach_stmt.arr = arr;\r\n        n->data.foreach_stmt.body = body;\r\n        n->data.foreach_stmt.is_of = is_of;\r\n        return n;\r\n    }\r\n\r\n    ASTNode *init = NULL;\r\n    if (match(p, TOK_LET)) {\r\n        expect(p, TOK_IDENT, \"identifier\");\r\n        char name[MAX_IDENT_LEN];\r\n        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n        expect(p, TOK_ASSIGN, \"'='\");\r\n        ASTNode *init_expr = parse_expr(p);\r\n        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;\r\n        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);\r\n        init->data.let.init = init_expr;\r\n    } else if (check(p, TOK_IDENT)) {\r\n        init = try_parse_assign(p);\r\n        if (!init) init = parse"]
[7593.830736, "o", "_expr(p);\r\n    } else if (!check(p, TOK_SEMICOLON)) {\r\n        init = parse_expr(p);\r\n    }\r\n    expect(p, TOK_SEMICOLON, \"';'\");\r\n\r\n    ASTNode *cond = NULL;\r\n    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);\r\n    expect(p, TOK_SEMICOLON, \"';'\");\r\n\r\n    ASTNode *step = NULL;\r\n    if (!check(p, TOK_RPAREN)) {\r\n        if (check(p, TOK_IDENT)) {\r\n"]
[7593.830798, "o", "            step = try_parse_assign(p);\r\n        }\r\n        if (!step) step = parse_expr(p);\r\n    }\r\n    expect(p, TOK_RPAREN, \"')'\");\r\n\r\n    ASTNode *body = parse_block(p);\r\n    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;\r\n    n->data.for_stmt.init = init;\r\n    n->data.for_stmt.cond = cond;\r\n"]
[7593.830862, "o", "    n->data.for_stmt.step = step;\r\n    n->data.for_stmt.body = body;\r\n    return n;\r\n}\r\n\r\nstatic ASTNode *parse_block(Parser *p) {\r\n    expect(p, TOK_LBRACE, \"'{'\");\r\n    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;\r\n    nodelist_init(&block->data.block.stmts);\r\n    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {\r\n        ASTNode *stmt = parse_stmt(p);\r\n        if (stmt) nodelist_push(&block->data.block.stmts, stmt);\r\n        if (p->had_error) break;\r\n    }\r\n    expect(p, TOK_RBRACE, \"'}'\");\r\n"]
[7593.830931, "o", "    return block;\r\n}\r\n\r\nstatic ASTNode *parse_stmt(Parser *p) {\r\n    if (match(p, TOK_LET)) {\r\n        int line = prev(p)->line;\r\n        expect(p, TOK_IDENT, \"identifier\");\r\n        char name[MAX_IDENT_LEN];\r\n        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n        expect(p, TOK_ASSIGN, \"'='\");\r\n        ASTNode *init = parse_expr(p);\r\n        expect(p, TOK_SEMICOLON, \"';'\");\r\n        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;"]
[7593.830996, "o", "\r\n        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);\r\n        n->data.let.init = init; return n;\r\n    }\r\n    if (match(p, TOK_IF)) {\r\n        int line = prev(p)->line;\r\n        expect(p, TOK_LPAREN, \"'('\");\r\n        ASTNode *cond = parse_expr(p);\r\n        expect(p, TOK_RPAREN, \"')'\");\r\n        ASTNode *then_b = parse_block(p);\r\n        ASTNode *else_b = NULL;\r\n        if (match(p, TOK_ELSE)) {\r\n"]
[7593.831084, "o", "            if (check(p, TOK_IF)) {\r\n                ASTNode *elif = parse_stmt(p);\r\n                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;\r\n                nodelist_init(&else_b->data.block.stmts);\r\n                nodelist_push(&else_b->data.block.stmts, elif);\r\n            } else {\r\n                else_b = parse_block(p);\r\n            }\r\n        }\r\n        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;\r\n        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;\r\n        return n;\r\n    }\r\n    if (match(p, TOK_WHILE)) {\r\n        int line = prev(p)->line;\r\n        expect(p, TOK_LPAREN, \"'('\");\r\n"]
[7593.831165, "o", "        ASTNode *cond = parse_expr(p);\r\n        expect(p, TOK_RPAREN, \"')'\");\r\n        ASTNode *body = parse_block(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;\r\n        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;\r\n    }\r\n    if (match(p, TOK_RETURN)) {\r\n        int line = prev(p)->line;\r\n        ASTNode *value = NULL;\r\n        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);\r\n        expect(p, TOK_SEMICOLON, \"';'\");\r\n        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;\r\n        n->data.ret.value = value; return n;\r\n    }\r\n    if (match(p, TOK_FOR)) {\r\n        return parse_for(p);"]
[7593.831246, "o", "\r\n    }\r\n    if (match(p, TOK_BREAK)) {\r\n        int line = prev(p)->line;\r\n        expect(p, TOK_SEMICOLON, \"';'\");\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BREAK; n->line = line; return n;\r\n    }\r\n    if (match(p, TOK_CONTINUE)) {\r\n        int line = prev(p)->line;\r\n        expect(p, TOK_SEMICOLON, \"';'\");\r\n        ASTNode *n = ast_alloc(); n->type = NODE_CONTINUE; n->line = line; return n;\r\n    }\r\n    if (match(p, TOK_PRINT)) {\r\n        int line = prev(p)->line;\r\n        ASTNode *value = parse_expr(p);\r\n"]
[7593.831314, "o", "        expect(p, TOK_SEMICOLON, \"';'\");\r\n        ASTNode *n = ast_alloc(); n->type = NODE_PRINT; n->line = line;\r\n        n->data.print.value = value; return n;\r\n    }\r\n    if (match(p, TOK_FN)) {\r\n        int line = prev(p)->line;\r\n        expect(p, TOK_IDENT, \"function name\");\r\n        char name[MAX_IDENT_LEN];\r\n        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n        expect(p, TOK_LPAREN, \"'('\");\r\n        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;\r\n        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);\r\n"]
[7593.831376, "o", "        n->data.func.param_count = 0;\r\n        if (!check(p, TOK_RPAREN)) {\r\n            do {\r\n                expect(p, TOK_IDENT, \"parameter name\");\r\n                strncpy(n->data.func.params[n->data.func.param_count],\r\n                        prev(p)->text, MAX_IDENT_LEN - 1);\r\n                n->data.func.param_count++;\r\n            } while (match(p, TOK_COMMA));\r\n        }\r\n        expect(p, TOK_RPAREN, \"')'\");\r\n"]
[7593.831435, "o", "        n->data.func.body = parse_block(p); return n;\r\n    }\r\n    if (check(p, TOK_IDENT)) {\r\n        ASTNode *a = try_parse_assign(p);\r\n        if (a) { expect(p, TOK_SEMICOLON, \"';'\"); return a; }\r\n    }\r\n    ASTNode *expr = parse_expr(p);\r\n    expect(p, TOK_SEMICOLON, \"';'\");\r\n    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;\r\n    n->data.expr_stmt.expr = expr; return n;\r\n"]
[7593.831499, "o", "}\r\n\r\nvoid parser_init(Parser *p, Token *tokens, int count) {\r\n    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;\r\n}\r\n\r\nASTNode *parse_program(Parser *p) {\r\n    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;\r\n    nodelist_init(&program->data.block.stmts);\r\n    while (!check(p, TOK_EOF)) {\r\n        ASTNode *stmt = parse_stmt(p);\r\n        if (stmt) nodelist_push(&program->data.block.stmts, stmt);\r\n        if (p->had_error) break;\r\n    }\r\n    return program;\r\n}\r\n"]
