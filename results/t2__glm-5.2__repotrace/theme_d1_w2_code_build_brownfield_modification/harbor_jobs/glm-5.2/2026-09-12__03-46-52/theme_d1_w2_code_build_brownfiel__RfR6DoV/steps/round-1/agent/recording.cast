[3873.638728, "o", "     1\t#ifndef MINICC_COMMON_H\r\n     2\t#define MINICC_COMMON_H\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <stdlib.h>\r\n     6\t#include <string.h>\r\n     7\t#include <stdint.h>"]
[3873.638828, "o", "\r\n     8\t#include <ctype.h>\r\n     9\t\r\n    10\t#define MAX_IDENT_LEN 64\r\n    11\t#define MAX_STRING_LEN 1024\r\n    12\t#define MAX_TOKENS 4096\r\n    13\t#define MAX_LOCALS 256\r\n    14\t#define MAX_FUNCTIONS 128\r\n    15\t#define MAX_BYTECODE 16384\r\n    16\t#define MAX_STACK 1024\r\n    17\t#define MAX_CALL_FRAMES 64\r\n    18\t#define MAX_GLOBALS 256\r\n"]
[3873.638906, "o", "    19\t#define MAX_AST_NODES 8192\r\n    20\t#define MAX_PARAMS 16\r\n    21\t\r\n    22\ttypedef enum {\r\n    23\t    TOK_NUM, TOK_STRING, TOK_IDENT,\r\n    24\t    TOK_PLUS, TOK_MINUS, TOK_STAR, TOK_SLASH, TOK_PERCENT,\r\n    25\t    TOK_EQ, TOK_NEQ, TOK_LT, TOK_GT, TOK_LEQ, TOK_GEQ,\r\n    26\t    TOK_ASSIGN, TOK_AND, TOK_OR, TOK_NOT,\r\n    27\t    TOK_LPAREN, TOK_RPAREN, TOK_LBRACE, TOK_RBRACE,\r\n    28\t    TOK_LBRACKET, TOK_RBRACKET,\r\n    29\t    TOK_SEMICOLON, TOK_COMMA,\r\n    30\t    TOK_IF, TOK_ELSE, TOK_WHILE, TOK_FOR, TOK_RETURN,\r\n    31\t    TOK_BREAK, TOK_CONTINUE, TOK_IN,\r\n"]
[3873.638984, "o", "    32\t    TOK_FN, TOK_LET, TOK_PRINT, TOK_TRUE, TOK_FALSE,\r\n    33\t    TOK_PLUS_ASSIGN, TOK_MINUS_ASSIGN, TOK_STAR_ASSIGN, TOK_SLASH_ASSIGN, TOK_PERCENT_ASSIGN,\r\n    34\t    TOK_EOF, TOK_ERROR\r\n    35\t} TokenType;\r\n    36\t\r\n    37\ttypedef struct {\r\n    38\t    TokenType type;\r\n    39\t    char text[MAX_STRING_LEN];\r\n    40\t    int line;\r\n    41\t    int col;\r\n    42\t    union {\r\n"]
[3873.639054, "o", "    43\t        int64_t ival;\r\n    44\t        double fval;\r\n    45\t    } literal;\r\n    46\t} Token;\r\n    47\t\r\n    48\ttypedef enum {\r\n    49\t    NODE_NUM_LIT, NODE_STR_LIT, NODE_BOOL_LIT,\r\n    50\t    NODE_IDENT, NODE_BINOP, NODE_UNARY,\r\n    51\t    NODE_CALL, NODE_INDEX,\r\n    52\t    NODE_ASSIGN, NODE_LET,"]
[3873.639123, "o", "\r\n    53\t    NODE_IF, NODE_WHILE, NODE_FOR, NODE_FOREACH,\r\n    54\t    NODE_RETURN, NODE_BREAK, NODE_CONTINUE,\r\n    55\t    NODE_PRINT, NODE_BLOCK, NODE_FUNC,\r\n    56\t    NODE_ARRAY_LIT, NODE_EXPR_STMT,\r\n    57\t    NODE_COMPOUND_ASSIGN, NODE_INDEX_ASSIGN, NODE_CLOSURE\r\n    58\t} NodeType;\r\n"]
[3873.639188, "o", "    59\t\r\n    60\ttypedef enum {\r\n    61\t    OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_MOD,\r\n    62\t    OP_EQ, OP_NEQ, OP_LT, OP_GT, OP_LEQ, OP_GEQ,\r\n    63\t    OP_AND, OP_OR\r\n    64\t} BinOp;\r\n    65\t\r\n    66\ttypedef enum {\r\n    67\t    UNOP_NEG, UNOP_NOT\r\n    68\t} UnaryOp;\r\n    69\t\r\n    70\tstruct ASTNode;\r\n    71\t\r\n"]
[3873.639307, "o", "    72\ttypedef struct {\r\n    73\t    struct ASTNode **items;\r\n    74\t    int count;\r\n    75\t    int cap;\r\n"]
[3873.639379, "o", "    76\t} NodeList;\r\n    77\t\r\n    78\ttypedef struct ASTNode {\r\n    79\t    NodeType type;\r\n    80\t    int line;\r\n    81\t    union {\r\n    82\t        int64_t num_val;\r\n    83\t        char str_val[MAX_STRING_LEN];\r\n    84\t        int bool_val;\r\n    85\t        char ident[MAX_IDENT_LEN];\r\n    86\t        struct { BinOp op; struct ASTNode *left, *right; } binop;\r\n    87\t        struct { UnaryOp op; struct ASTNode *operand; } unary;"]
[3873.639453, "o", "\r\n    88\t        struct { char name[MAX_IDENT_LEN]; NodeList args; } call;\r\n    89\t        struct { struct ASTNode *obj; struct ASTNode *index; } index_access;\r\n    90\t        struct { char name[MAX_IDENT_LEN]; struct ASTNode *value; } assign;\r\n    91\t    struct { char name[MAX_IDENT_LEN]; BinOp op; struct ASTNode *value; } compound_assign;\r\n    92\t        struct { char name[MAX_IDENT_LEN]; struct ASTNode *index; struct ASTNode *value; } index_assign;\r\n    93\t        struct { char name[MAX_IDENT_LEN]; struct ASTNode *init; } let;\r\n    94\t        struct { struct ASTNode *cond, *then_b, *else_b; } if_stmt;\r\n    95\t        struct { struct ASTNode *cond, *body; } while_stmt;\r\n    96\t"]
[3873.639523, "o", "    struct { struct ASTNode *init, *cond, *step, *body; } for_stmt;\r\n    97\t    struct { char var[MAX_IDENT_LEN]; struct ASTNode *arr; struct ASTNode *body; } foreach_stmt;\r\n    98\t        struct { struct ASTNode *value; } ret;\r\n    99\t        struct { struct ASTNode *value; } print;\r\n   100\t        struct { NodeList stmts; } block;\r\n   101\t        struct { char name[MAX_IDENT_LEN]; char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } func;\r\n   102\t        struct { NodeList elems; } array_lit;\r\n   103\t        struct { struct ASTNode *expr; } expr_stmt;\r\n   104\t    } data;\r\n"]
