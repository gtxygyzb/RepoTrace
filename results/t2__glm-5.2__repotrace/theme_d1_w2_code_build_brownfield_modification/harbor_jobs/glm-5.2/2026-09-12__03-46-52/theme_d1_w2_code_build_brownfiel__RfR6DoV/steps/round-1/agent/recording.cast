[7684.787427, "o", "\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case BC_EQ: { Value b = pop(vm); Value a = pop(vm); push(vm, \u001b[01;31m\u001b[Kmake_bool\u001b[m\u001b[K(values_equal(a, b))); break; }\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case BC_NEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, \u001b[01;31m\u001b[Kmake_bool\u001b[m\u001b[K(!values_equal(a, b))); break; }\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case BC_LT: { Value b = pop(vm); Value a = pop(vm); push(vm, \u001b[01;31m\u001b[Kmake_bool\u001b[m\u001b[K(value_cmp(a, b) < 0)); break; }\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case BC_GT: { Value b = pop(vm); Value a = pop(vm); push(vm, \u001b[01;31m\u001b[Kmake_bool\u001b[m\u001b[K(value_cmp(a, b) > 0)); break; }\r\n"]
[7684.78747, "o", "\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case BC_LEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, \u001b[01;31m\u001b[Kmake_bool\u001b[m\u001b[K(value_cmp(a, b) <= 0)); break; }\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case BC_GEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, \u001b[01;31m\u001b[Kmake_bool\u001b[m\u001b[K(value_cmp(a, b) >= 0)); break; }\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case BC_AND: { Value b = pop(vm); Value a = pop(vm); push(vm, \u001b[01;31m\u001b[Kmake_bool\u001b[m\u001b[K(value_truthy(a) && value_truthy(b))); break; }\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case BC_OR: { Value b = pop(vm); Value a = pop(vm); push(vm, \u001b[01;31m\u001b[Kmake_bool\u001b[m\u001b[K(value_truthy(a) || value_truthy(b))); break; }\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case BC_NOT: { Value a = pop(vm); push(vm, \u001b[01;31m\u001b[Kmake_bool\u001b[m\u001b[K(!value_truthy(a))); break; }\r\n"]
[7684.78751, "o", "\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case BC_NEG: { Value a = pop(vm); push(vm, \u001b[01;31m\u001b[Kmake_int\u001b[m\u001b[K(-value_to_int(a))); break; }\r\n"]
[7684.787578, "o", "\u001b[32m\u001b[K381\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                if (arr.type == VAL_ARRAY) push(vm, \u001b[01;31m\u001b[Kmake_int\u001b[m\u001b[K(arr.data.array.len));\r\n\u001b[32m\u001b[K382\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                else if (arr.type == VAL_MAP) push(vm, \u001b[01;31m\u001b[Kmake_int\u001b[m\u001b[K(arr.data.map ? arr.data.map->len : 0));\r\n\u001b[32m\u001b[K383\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                else push(vm, \u001b[01;31m\u001b[Kmake_int\u001b[m\u001b[K(0));\r\n"]
[7684.787641, "o", "\u001b[32m\u001b[K442\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                for (int i = 0; i < obj.data.map->len; i++) arr.data.array.items[i] = \u001b[01;31m\u001b[Kmake_str\u001b[m\u001b[K(obj.data.map->keys[i]);\r\n\u001b[32m\u001b[K449\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                push(vm, \u001b[01;31m\u001b[Kmake_bool\u001b[m\u001b[K(map_find(obj.data.map, key) >= 0)); break;\r\n"]
[7684.787688, "o", "\u001b[32m\u001b[K455\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                push(vm, \u001b[01;31m\u001b[Kmake_bool\u001b[m\u001b[K(map_delete(obj.data.map, key))); break;\r\n\u001b[32m\u001b[K459\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                if (obj.type != VAL_MAP) push(vm, \u001b[01;31m\u001b[Kmake_int\u001b[m\u001b[K(0));\r\n\u001b[32m\u001b[K460\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                else push(vm, \u001b[01;31m\u001b[Kmake_int\u001b[m\u001b[K(obj.data.map ? obj.data.map->len : 0));\r\n\u001b[32m\u001b[K468\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                    push(vm, \u001b[01;31m\u001b[Kmake_str\u001b[m\u001b[K(arr.data.map->keys[i]));\r\n"]
