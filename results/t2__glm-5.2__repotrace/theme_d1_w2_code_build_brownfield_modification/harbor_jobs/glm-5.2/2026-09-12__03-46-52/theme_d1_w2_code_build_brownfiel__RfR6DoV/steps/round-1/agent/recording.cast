[9949.308958, "o", "#ifndef MINICC_CODEGEN_H\r\n#define MINICC_CODEGEN_H\r\n\r\n#include \"common.h\"\r\n#include \"ast.h\"\r\n\r\ntypedef struct {\r\n    char name[MAX_IDENT_LEN];\r\n    int scope_depth;\r\n    int is_boxed;\r\n} Local;\r\n"]
[9949.309111, "o", "\r\ntypedef struct {\r\n    char name[MAX_IDENT_LEN];\r\n    int addr;\r\n    int param_count;\r\n    int capture_count;\r\n    int capture_slots[MAX_LOCALS];\r\n} FuncInfo;\r\n\r\ntypedef struct {\r\n    char name[MAX_IDENT_LEN];\r\n} CaptureInfo;\r\n\r\ntypedef struct {\r\n    Instruction code[MAX_BYTECODE];\r\n    int code_count;\r\n    Local locals[MAX_LOCALS];\r\n    int local_count;\r\n    int scope_depth;\r\n    FuncInfo functions[MAX_FUNCTIONS];\r\n    int func_count;\r\n    int in_function;\r\n    CaptureInfo captures[MAX_LOCALS];\r\n    int capture_count;\r\n} Compiler;\r\n\r\nvoid compiler_init(Compiler *c);\r\nint compile(Compiler *c, ASTNode *program);\r\n\r\n"]
