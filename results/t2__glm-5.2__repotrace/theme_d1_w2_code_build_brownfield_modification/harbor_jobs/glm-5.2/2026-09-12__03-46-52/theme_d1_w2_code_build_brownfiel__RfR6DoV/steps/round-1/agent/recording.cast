[4328.790385, "o", "     1\t#include \"codegen.h\"\r\n     2\t\r\n     3\t"]
[4328.790497, "o", "static int emit(Compiler *c, Opcode op, int64_t operand, char *str_op) {\r\n     4\t    if (c->code_count >= MAX_BYTECODE) { fprintf(stderr, \"bytecode overflow\\n\"); return -1; }\r\n     5\t    Instruction *ins = &c->code[c->code_count];\r\n     6\t    ins->op = op; ins->operand = operand; ins->str_operand = str_op;\r\n     7\t    return c->code_count++;\r\n     8\t}\r\n     9\t\r\n    10\tstatic int resolve_local(Compiler *c, const char *name) {\r\n    11\t    for (int i = c->local_count - 1; i >= 0; i--) {\r\n"]
[4328.790518, "o", "    12\t        if (strcmp(c->locals[i].name, name) == 0) return i;\r\n    13\t    }\r\n"]
[4328.790528, "o", "    14\t    return -1;\r\n    15\t}\r\n    16"]
[4328.79055, "o", "\t\r\n    17\tstatic int add_local(Compiler *c, const char *name) {\r\n"]
[4328.790689, "o", "    18\t    if (c->local_count >= MAX_LOCALS) { fprintf(stderr, \"too many local variables\\n\"); return -1; }\r\n    19\t    Local *local = &c->locals[c->local_count];\r\n    20\t    strncpy(local->name, name, MAX_IDENT_LEN - 1); local->name[MAX_IDENT_LEN - 1] = '\\0';\r\n    21\t    local->scope_depth = c->scope_depth;\r\n    22\t    return c->local_count++;\r\n    23\t}\r\n    24\t\r\n    25\tstatic int find_function(Compiler *c, const char *name) {\r\n    26\t    for (int i = 0; i < c->func_count; i++) {\r\n    27\t        if (strcmp(c->functions[i].name, name) == 0) return i;\r\n    28\t    }\r\n    29\t    return -1;\r\n    30\t}\r\n    31\t\r\n    32\tstatic void compile_store(Compiler *c, const char *name) {\r\n    33\t    int slot = resolve_local(c, name);\r\n    34\t    if (slot >= 0) emit(c, BC_STORE_LOCAL, slot, NULL);\r\n    35\t    else emit(c, BC_STORE_GLOBAL, 0, strdup(name));\r\n    36\t}\r\n    37\t\r\n"]
[4328.790707, "o", "    38\tstatic void compile_load(Compiler *c, const char *name) {\r\n    39\t    int slot = resolve_local(c, name);\r\n    40\t    if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);\r\n"]
[4328.790787, "o", "    41\t    else emit(c, BC_LOAD_GLOBAL, 0, strdup(name));\r\n    42\t}\r\n    43\t\r\n    44\t#define MAX_LOOP_DEPTH 64\r\n    45\t#define MAX_LOOP_JUMPS 256\r\n    46\ttypedef struct {\r\n    47\t    int start;\r\n    48\t"]
[4328.790873, "o", "    int cont;\r\n    49\t    int end;\r\n    50\t    int breaks[MAX_LOOP_JUMPS];\r\n    51\t    int break_count;\r\n"]
[4328.790938, "o", "    52\t    int conts[MAX_LOOP_JUMPS];\r\n    53\t    int cont_count;\r\n    54\t} LoopCtx;\r\n    55\tstatic LoopCtx loop_stack[MAX_LOOP_DEPTH];\r\n    56\tstatic int loop_depth = 0;\r\n    57\t\r\n    58\tstatic int compile_node(Compiler *c, ASTNode *node);\r\n"]
[4328.790954, "o", "    59\t\r\n    60\tstatic int compile_expr(Compiler *c, ASTNode *node) {\r\n"]
[4328.791027, "o", "    61\t    switch (node->type) {\r\n    62\t        case NODE_NUM_LIT:\r\n    63\t            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;\r\n    64\t        case NODE_STR_LIT: {\r\n    65\t            char *s = strdup(node->data.str_val);"]
[4328.791051, "o", "\r\n    66\t            emit(c, BC_PUSH_STR, 0, s); break;\r\n    67\t        }\r\n    68\t        case NODE_BOOL_LIT:\r\n    69\t            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;\r\n    70\t        case NODE_IDENT: {\r\n    71\t            int slot = resolve_local(c, node->data.ident);\r\n"]
[4328.791126, "o", "    72\t            if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);\r\n    73\t            else emit(c, BC_LOAD_GLOBAL, 0, strdup(node->data.ident));\r\n"]
[4328.791141, "o", "    74\t            break;\r\n    75\t        }\r\n"]
[4328.791218, "o", "    76\t        case NODE_BINOP:\r\n    77\t            compile_expr(c, node->data.binop.left);\r\n    78\t            compile_expr(c, node->data.binop.right);\r\n    79\t            switch (node->data.binop.op) {\r\n    80\t                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;\r\n"]
