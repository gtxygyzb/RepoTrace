[9881.861534, "o", "\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_CLOSURE: break;\r\n\u001b[32m\u001b[K213\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        default: break;\r\n\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K216\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K217\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#define MAX_LOOP_DEPTH 64\r\n\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#define MAX_LOOP_JUMPS 256\r\n\u001b[32m\u001b[K219\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Ktypedef struct {\r\n\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int start;\r\n\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int cont;\r\n\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int end;\r\n\u001b[32m\u001b[K223\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int try_depth;\r\n\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int breaks[MAX_LOOP_JUMPS];\r\n"]
[9881.861605, "o", "\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int break_count;\r\n\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int conts[MAX_LOOP_JUMPS];\r\n\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int cont_count;\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K} LoopCtx;\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic LoopCtx loop_stack[MAX_LOOP_DEPTH];\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic int loop_depth = 0;\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic int try_depth = 0;\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic int compile_node(Compiler *c, ASTNode *node);\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic int compile_expr(Compiler *c, ASTNode *node) {\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    switch (node->type) {\r\n"]
[9881.861673, "o", "\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_NUM_LIT:\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_INDEX:\r\n\u001b[32m\u001b[K404\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            compile_expr(c, node->data.index_access.obj);\r\n\u001b[32m\u001b[K405\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            compile_expr(c, node->data.index_access.index);\r\n\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            emit(c, BC_INDEX, 0, NULL); break;\r\n\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kcase NODE_ARRAY_LIT:\u001b[m\u001b[K\r\n"]
[9881.861737, "o", "\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            for (int i = 0; i < node->data.array_lit.elems.count; i++)\r\n\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                compile_expr(c, node->data.array_lit.elems.items[i]);\r\n\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;\r\n\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_MAP_LIT: {\r\n\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            int count = node->data.map_lit.keys.count;\r\n\u001b[32m\u001b[K413\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            for (int i = 0; i < count; i++) {\r\n\u001b[32m\u001b[K414\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                compile_expr(c, node->data.map_lit.keys.items[i]);\r\n\u001b[32m\u001b[K415\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                compile_expr(c, node->data.map_lit.values.items[i]);\r\n\u001b[32m\u001b[K416\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n"]
[9881.861802, "o", "\u001b[32m\u001b[K417\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            emit(c, BC_PUSH_MAP, count, NULL); break;\r\n\u001b[32m\u001b[K418\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_FIELD_ACCESS:\r\n\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            compile_expr(c, node->data.field_access.obj);\r\n\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            emit(c, BC_PUSH_STR, 0, strdup(node->data.field_access.field));\r\n"]
[9881.861871, "o", "\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            emit(c, BC_MAP_GET, 0, NULL); break;\r\n\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_METHOD_CALL: {\r\n\u001b[32m\u001b[K424\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            compile_expr(c, node->data.method_call.obj);\r\n\u001b[32m\u001b[K425\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            for (int i = 0; i < node->data.method_call.args.count; i++)\r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                compile_expr(c, node->data.method_call.args.items[i]);\r\n\u001b[32m\u001b[K427\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            emit(c, BC_STR_METHOD_CALL, node->data.method_call.args.count, strdup(node->data.method_call.method));\r\n\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            break;\r\n\u001b[32m\u001b[K429\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K430\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        default:\r\n\u001b[32m\u001b[K431\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            error_at(node->line, \"cannot compile expression of type %d\", node->type); return -1;\r\n\u001b[32m\u001b[K432\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return 0;\r\n\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K435\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r"]
[9881.861938, "o", "\n\u001b[32m\u001b[K436\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic int compile_node(Compiler *c, ASTNode *node) {\r\n\u001b[32m\u001b[K437\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    switch (node->type) {\r\n\u001b[32m\u001b[K438\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_LET: {\r\n\u001b[32m\u001b[K439\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            int slot = add_local(c, node->data.let.name);\r\n\u001b[32m\u001b[K440\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (slot < 0) return -1;\r\n\u001b[32m\u001b[K441\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            compile_expr(c, node->data.let.init);\r\n\u001b[32m\u001b[K442\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            break;\r\n"]
