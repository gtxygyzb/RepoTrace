[1977.741759, "o", "     1\t#include \"codegen.h\"\r\n     2\t\r\n     3\tstatic int emit(Compiler *c, Opcode op, int64_t operand, char *str_op) {\r\n     4\t    if (c->code_count >= MAX_BYTECODE) { fprintf(stderr, \"bytecode overflow\\n\"); return -1; }\r\n     5\t    Instruction *ins = &c->code[c->code_count];\r\n     6\t    ins->op = op; ins->operand = operand; ins->str_operand = str_op;\r\n     7\t"]
[1977.741855, "o", "    return c->code_count++;\r\n     8\t}\r\n     9\t\r\n    10\tstatic int resolve_local(Compiler *c, const char *name) {\r\n    11\t    for (int i = c->local_count - 1; i >= 0; i--) {\r\n    12\t        if (strcmp(c->locals[i].name, name) == 0) return i;\r\n    13\t    }\r\n    14\t    return -1;\r\n    15\t}\r\n    16\t\r\n    17\tstatic int add_local(Compiler *c, const char *name) {\r\n    18\t    if (c->local_count >= MAX_LOCALS) { fprintf(stderr, \"too many local variables\\n\"); return -1; }\r\n    19\t    Local *local = &c->locals[c->local_count];\r\n    20\t    strncpy(local->name, name, MAX_IDENT_LEN - 1); local->name[MAX_IDENT_LEN - 1] = '\\0';\r\n    21\t    local->scope_depth = c->scope_depth;\r\n"]
[1977.741922, "o", "    22\t    return c->local_count++;\r\n    23\t}\r\n    24\t\r\n    25\tstatic int find_function(Compiler *c, const char *name) {\r\n    26\t    for (int i = 0; i < c->func_count; i++) {\r\n    27\t        if (strcmp(c->functions[i].name, name) == 0) return i;\r\n    28\t    }\r\n    29\t    return -1;\r\n    30\t}\r\n    31\t\r\n    32\tstatic void compile_store(Compiler *c, const char *name) {"]
[1977.741942, "o", "\r\n    33\t    int slot = resolve_local(c, name);\r\n"]
[1977.742017, "o", "    34\t    if (slot >= 0) emit(c, BC_STORE_LOCAL, slot, NULL);\r\n    35\t    else emit(c, BC_STORE_GLOBAL, 0, strdup(name));\r\n    36\t}\r\n    37\t\r\n    38\t"]
[1977.742043, "o", "static void compile_load(Compiler *c, const char *name) {\r\n    39\t    int slot = resolve_local(c, name);\r\n    40\t    if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);\r\n    41\t    else emit(c, BC_LOAD_GLOBAL, 0, strdup(name));\r\n    42\t}\r\n    43\t\r\n    44\t#define MAX_LOOP_DEPTH 64\r\n    45\t#define MAX_LOOP_JUMPS 256\r\n    46\ttypedef struct {\r\n    47\t    int start;\r\n    48\t    int cont;\r\n    49\t    int end;\r\n    50\t    int breaks[MAX_LOOP_JUMPS];\r\n"]
[1977.742118, "o", "    51\t    int break_count;\r\n    52\t    int conts[MAX_LOOP_JUMPS];\r\n    53\t    int cont_count;\r\n    54\t} LoopCtx;\r\n    55\tstatic LoopCtx loop_stack[MAX_LOOP_DEPTH];\r\n    56\tstatic int loop_depth = 0;\r\n    57\t\r\n    58\tstatic int compile_node(Compiler *c, ASTNode *node);\r\n    59\t\r\n"]
[1977.742171, "o", "    60\tstatic int compile_expr(Compiler *c, ASTNode *node) {\r\n    61\t    switch (node->type) {\r\n    62\t"]
[1977.742264, "o", "        case NODE_NUM_LIT:\r\n    63\t            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;\r\n    64\t        case NODE_STR_LIT: {\r\n    65\t            char *s = strdup(node->data.str_val);\r\n    66\t            emit(c, BC_PUSH_STR, 0, s); break;\r\n    67\t        }\r\n    68\t        case NODE_BOOL_LIT:\r\n    69\t            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;\r\n    70\t        case NODE_IDENT: {\r\n    71\t            int slot = resolve_local(c, node->data.ident);\r\n    72\t            if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);\r\n    73\t            else emit(c, BC_LOAD_GLOBAL, 0, strdup(node->data.ident));\r\n    74\t            break;\r\n    75\t        }\r\n    76\t        case NODE_BINOP:\r\n    77\t            compile_expr(c, node->data.binop.left);\r\n    78\t            compile_expr(c, node->data.binop.right);\r\n    79\t            switch (node->data.binop.op) {\r\n"]
[1977.742332, "o", "    80\t                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;\r\n    81\t                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;\r\n    82\t                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;\r\n"]
[1977.742353, "o", "    83\t                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;\r\n    84\t                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;\r\n    85\t                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;\r\n    86\t                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;\r\n    87\t                case OP_LT:  emit(c, BC_LT, 0, NULL); break;\r\n    88\t                case OP_GT:  emit(c, BC_GT, 0, NULL); break;\r\n    89\t                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;\r\n    90\t                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;\r\n    91\t                case OP_AND: emit(c, BC_AND, 0, NULL); break;\r\n"]
[1977.742475, "o", "    92\t                case OP_OR:  emit(c, BC_OR, 0, NULL); break;\r\n    93\t            }\r\n    94\t            break;\r\n    95\t        case NODE_UNARY:\r\n    96\t            compile_expr(c, node->data.unary.operand);\r\n    97\t            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);\r\n    98\t            else emit(c, BC_NOT, 0, NULL);\r\n    99\t            break;\r\n   100\t        case NODE_CALL: {\r\n   101\t            int fi = find_function(c, node->data.call.name);\r\n   102\t            if (fi < 0) { error_at(node->line, \"undefined function '%s'\", node->data.call.name); return -1; }\r\n   103\t            for (int i = 0; i < node->data.call.args.count; i++)\r\n   104\t                compile_expr(c, node->data.call.args.items[i]);\r\n   105\t            emit(c, BC_CALL, fi, NULL);\r\n   106\t            break;\r\n   107\t        }\r\n"]
[1977.74254, "o", "   108\t        case NODE_INDEX:\r\n   109\t            compile_expr(c, node->data.index_access.obj);\r\n   110\t            compile_expr(c, node->data.index_access.index);\r\n   111\t            emit(c, BC_INDEX, 0, NULL); break;\r\n   112\t        case NODE_ARRAY_LIT:\r\n   113\t            for (int i = 0; i < node->data.array_lit.elems.count; i++)\r\n   114\t                compile_expr(c, node->data.array_lit.elems.items[i]);\r\n   115\t            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;\r\n   116\t        default:\r\n   117\t            error_at(node->line, \"cannot compile expression of type %d\", node->type); return -1;\r\n"]
[1977.742594, "o", "   118\t    }\r\n   119\t    return 0;\r\n   120\t}\r\n   121\t\r\n"]
[1977.74265, "o", "   122\tstatic int compile_node(Compiler *c, ASTNode *node) {\r\n   123\t    switch (node->type) {\r\n   124\t        case NODE_LET: {\r\n   125\t            int slot = add_local(c, node->data.let.name);\r\n   126\t            if (slot < 0) return -1;\r\n   127\t            compile_expr(c, node->data.let.init);\r\n   128\t            break;\r\n   129\t        }\r\n"]
[1977.742705, "o", "   130\t        case NODE_ASSIGN: {\r\n   131\t            compile_expr(c, node->data.assign.value);\r\n   132\t            compile_store(c, node->data.assign.name);\r\n   133\t            break;\r\n   134\t        }\r\n   135\t        case NODE_IF: {\r\n   136\t            compile_expr(c, node->data.if_stmt.cond);\r\n   137\t            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n   138\t            compile_node(c, node->data.if_stmt.then_b);\r\n"]
[1977.742762, "o", "   139\t            if (node->data.if_stmt.else_b) {\r\n   140\t                int je = emit(c, BC_JUMP, 0, NULL);\r\n   141\t                c->code[jf].operand = c->code_count;\r\n   142\t                compile_node(c, node->data.if_stmt.else_b);\r\n   143\t                c->code[je].operand = c->code_count;\r\n   144\t            } else {\r\n"]
[1977.742813, "o", "   145\t                c->code[jf].operand = c->code_count;\r\n   146\t            }\r\n   147\t            break;\r\n   148\t        }\r\n   149\t        case NODE_WHILE: {\r\n   150\t            int loop_start = c->code_count;\r\n   151\t            compile_expr(c, node->data.while_stmt.cond);\r\n   152\t            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n   153\t            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n   154\t            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n   155\t"]
[1977.742871, "o", "            ctx->start = loop_start; ctx->cont = loop_start; ctx->end = -1;\r\n   156\t            ctx->break_count = 0; ctx->cont_count = 0;\r\n   157\t            compile_node(c, node->data.while_stmt.body);\r\n   158\t            emit(c, BC_JUMP, loop_start, NULL);\r\n   159\t            int end = c->code_count;\r\n   160\t            c->code[jf].operand = end;\r\n"]
