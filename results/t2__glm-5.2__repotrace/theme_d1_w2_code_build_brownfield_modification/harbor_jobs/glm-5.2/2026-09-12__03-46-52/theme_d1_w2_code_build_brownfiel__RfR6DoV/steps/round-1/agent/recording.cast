[9937.257478, "o", "\u001b[32m\u001b[K177\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            case BC_LOAD_LOCAL: {\r\n\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;\r\n\u001b[32m\u001b[K179\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                push(vm, vm->stack[base + (int)ins->operand]);\r\n"]
[9937.257587, "o", "\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n\u001b[32m\u001b[K181\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n"]
[9937.257657, "o", "\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kcase BC_STORE_LOCAL:\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;\r\n\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                vm->stack[base + (int)ins->operand] = pop(vm);\r\n\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n"]
[9937.257732, "o", "\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            case BC_LOAD_GLOBAL: {\r\n\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int idx = resolve_global(vm, ins->str_operand);\r\n\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (idx < 0) { fprintf(stderr, \"undefined variable '%s'\\n\", ins->str_operand); return -1; }\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                push(vm, vm->globals[idx]);\r\n\u001b[32m\u001b[K191\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            case BC_STORE_GLOBAL: {\r\n\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int idx = resolve_global(vm, ins->str_operand);\r\n\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (idx < 0) idx = add_global(vm, ins->str_operand);\r\n\u001b[32m\u001b[K196\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                vm->globals[idx] = pop(vm);\r\n\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n"]
