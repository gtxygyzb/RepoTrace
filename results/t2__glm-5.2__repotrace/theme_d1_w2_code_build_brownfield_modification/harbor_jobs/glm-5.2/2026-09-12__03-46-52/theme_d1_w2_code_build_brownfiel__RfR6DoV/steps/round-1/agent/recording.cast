[4437.048829, "o", "\u001b[?2004l\r"]
[4437.052775, "o", "   196\t        case NODE_FOREACH: {\r\n   197\t            int old_lc = c->local_count;\r\n   198\t            c->scope_depth++;\r\n"]
[4437.052793, "o", "   199\t            compile_expr(c, node->data.foreach_stmt.arr);\r\n   200\t"]
[4437.052861, "o", "            int arr_slot = add_local(c, \".forarr\");\r\n   201\t            emit(c, BC_PUSH_INT, 0, NULL);\r\n   202\t            int idx_slot = add_local(c, \".foridx\");\r\n"]
[4437.053013, "o", "   203\t            int loop_start = c->code_count;\r\n   204\t            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n   205\t            emit(c, BC_LOAD_LOCAL, arr_slot, NULL);\r\n   206\t            emit(c, BC_ARRAY_LEN, 0, NULL);\r\n   207\t            emit(c, BC_LT, 0, NULL);\r\n   208\t            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n   209\t            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n   210\t            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n   211\t            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\r\n   212\t            ctx->break_count = 0; ctx->cont_count = 0;\r\n   213\t            int body_old = c->local_count;\r\n   214\t"]
[4437.053192, "o", "            if (node->data.foreach_stmt.is_of) {\r\n   215\t                emit(c, BC_LOAD_LOCAL, arr_slot, NULL);\r\n   216\t                emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n   217\t                emit(c, BC_INDEX, 0, NULL);\r\n   218\t            } else {\r\n   219\t                emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n   220\t            }\r\n   221\t            int var_slot = add_local(c, node->data.foreach_stmt.var);\r\n   222\t            compile_node(c, node->data.foreach_stmt.body);\r\n   223\t            int n = c->local_count - body_old;\r\n   224\t            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n   225\t            c->local_count = body_old;\r\n   226\t            int inc_start = c->code_count;\r\n   227\t            ctx->cont = inc_start;\r\n   228\t            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n   229\t            emit(c, BC_PUSH_INT, 1, NULL);\r\n   230\t            emit(c, BC_ADD, 0, NULL);\r\n   231\t            emit(c, BC_JUMP, loop_start, NULL);\r\n   232\t            int end = c->code_count;\r\n   233"]
[4437.053386, "o", "\t            c->code[jf].operand = end;\r\n   234\t            ctx->end = end;\r\n   235\t            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;\r\n   236\t            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = inc_start;\r\n   237\t            loop_depth--;\r\n   238\t            int n2 = c->local_count - old_lc;\r\n   239\t            for (int i = 0; i < n2; i++) emit(c, BC_POP, 0, NULL);\r\n   240\t            c->local_count = old_lc;\r\n   241\t            c->scope_depth--;\r\n   242\t            break;\r\n   243\t        }\r\n   244\t        case NODE_BREAK: {\r\n   245\t            if (loop_depth <= 0) { error_at(node->line, \"break outside loop\"); return -1; }\r\n"]
