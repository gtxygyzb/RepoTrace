[10997.789725, "o", "\u001b[?2004h> "]
[10997.789934, "o", "    val.data.array.len = 0;\r\n\u001b[?2004l\r"]
[10997.789993, "o", "\u001b[?2004h> "]
[10997.790313, "o", "    val.data.array.cap = cap > 0 ? cap : 0;\r\n\u001b[?2004l\r"]
[10997.790381, "o", "\u001b[?2004h> "]
[10997.791066, "o", "    val.data.array.items = val.data.array.cap > 0 ? malloc(val.data.array.cap * sizeof(Value)) : NULL;\r\n\u001b[?2004l\r"]
[10997.791134, "o", "\u001b[?2004h"]
[10997.791193, "o", "> "]
[10997.791258, "o", "    return val;\r\n"]
[10997.791312, "o", "\u001b[?2004l\r"]
[10997.79137, "o", "\u001b[?2004h> "]
[10997.791425, "o", "}\r\n\u001b[?2004l\r"]
[10997.791484, "o", "\u001b[?2004h> "]
[10997.791764, "o", "static void array_push(Value *arr, Value v) {\r\n\u001b[?2004l\r"]
[10997.791825, "o", "\u001b[?2004h> "]
[10997.792194, "o", "    if (arr->data.array.len >= arr->data.array.cap) {\r\n\u001b[?2004l\r"]
[10997.792273, "o", "\u001b[?2004h> "]
[10997.792806, "o", "        int nc = arr->data.array.cap == 0 ? 8 : arr->data.array.cap * 2;\r\n\u001b[?2004l\r"]
[10997.792881, "o", "\u001b[?2004h> "]
[10997.793492, "o", "        arr->data.array.items = realloc(arr->data.array.items, nc * sizeof(Value));\r\n\u001b[?2004l\r"]
[10997.793556, "o", "\u001b[?2004h> "]
[10997.793787, "o", "        arr->data.array.cap = nc;\r\n\u001b[?2004l\r"]
[10997.793846, "o", "\u001b[?2004h"]
[10997.793901, "o", ">     }\r\n"]
[10997.793957, "o", "\u001b[?2004l\r"]
[10997.794015, "o", "\u001b[?2004h> "]
[10997.794356, "o", "    arr->data.array.items[arr->data.array.len++] = v;\r\n\u001b[?2004l\r"]
[10997.794428, "o", "\u001b[?2004h"]
[10997.794485, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[10997.794539, "o", "''')\r\n\u001b[?2004l\r"]
[10997.794596, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[10997.794652, "o", "\u001b[?2004h> "]
[10997.794883, "o", "# Replace BC_CALL_VALUE block\r\n\u001b[?2004l\r"]
[10997.794947, "o", "\u001b[?2004h> "]
[10997.795268, "o", "old = '''            case BC_CALL_VALUE: {\r\n\u001b[?2004l\r"]
[10997.795335, "o", "\u001b[?2004h> "]
[10997.795612, "o", "                Value callee = pop(vm);\r\n\u001b[?2004l\r"]
[10997.795672, "o", "\u001b[?2004h> "]
[10997.795848, "o", "                int fi = -1;\r\n\u001b[?2004l\r"]
[10997.795907, "o", "\u001b[?2004h> "]
