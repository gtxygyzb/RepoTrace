[321.289865, "o", "#ifndef MINICC_COMMON_H\r\n#define MINICC_COMMON_H\r\n\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <stdint.h>\r\n#include <ctype.h>\r\n\r\n#define MAX_IDENT_LEN 64\r\n#define MAX_STRING_LEN 1024\r\n#define MAX_TOKENS 4096\r\n#define MAX_LOCALS 256\r\n#define MAX_FUNCTIONS 128\r\n#define MAX_BYTECODE 16384\r\n#define MAX_STACK 1024\r\n#define MAX_CALL_FRAMES 64\r\n#define MAX_GLOBALS 256\r\n#define MAX_AST_NODES 8192\r\n#define MAX_PARAMS 16\r\n\r\ntypedef enum {\r\n    TOK_NUM, TOK_STRING, TOK_IDENT,\r\n"]
[321.289952, "o", "    TOK_PLUS, TOK_MINUS, TOK_STAR, TOK_SLASH, TOK_PERCENT,\r\n    TOK_EQ, TOK_NEQ, TOK_LT, TOK_GT, TOK_LEQ, TOK_GEQ,\r\n    TOK_ASSIGN, TOK_AND, TOK_OR, TOK_NOT,\r\n    TOK_LPAREN, TOK_RPAREN, TOK_LBRACE, TOK_RBRACE,\r\n    TOK_LBRACKET, TOK_RBRACKET,\r\n    TOK_SEMICOLON, TOK_COMMA,\r\n    TOK_IF, TOK_ELSE, TOK_WHILE, TOK_RETURN,\r\n    TOK_FN, TOK_LET, TOK_PRINT, TOK_TRUE, TOK_FALSE,\r\n    TOK_EOF, TOK_ERROR\r\n} TokenType;\r\n\r\ntypedef struct {\r\n    TokenType type;\r\n    char text[MAX_STRING_LEN];\r\n    int line;\r\n    int col;\r\n    union {\r\n        int64_t ival;\r\n        double fval;\r\n    } literal;\r\n} Token;\r\n\r\ntypedef enum {\r\n    NODE_NUM_LIT, NODE_STR_LIT, NODE_BOOL_LIT,\r\n    NODE_IDENT, NODE_BINOP, NODE_UNARY,\r\n    NODE_CALL, NODE_INDEX,\r\n    NODE_ASSIGN, NODE_LET,\r\n    NODE_IF, NODE_WHILE, NODE_RETURN,\r\n    NODE_PRINT, NODE_BLOCK, NODE_FUNC,\r\n    NODE_ARRAY_LIT, NODE_EXPR_STMT\r\n} NodeType;\r\n\r\ntypedef enum {\r\n    OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_MOD,\r\n    OP_EQ, OP_NEQ, OP_LT, OP_GT, OP_LEQ, OP_GEQ,\r\n    OP_AND, OP_OR\r\n}"]
[321.290014, "o", " BinOp;\r\n\r\ntypedef enum {\r\n    UNOP_NEG, UNOP_NOT\r\n} UnaryOp;\r\n\r\nstruct ASTNode;\r\n\r\ntypedef struct {\r\n    struct ASTNode **items;\r\n    int count;\r\n    int cap;\r\n} NodeList;\r\n\r\ntypedef struct ASTNode {\r\n    NodeType type;\r\n    int line;\r\n    union {\r\n        int64_t num_val;\r\n        char str_val[MAX_STRING_LEN];\r\n        int bool_val;\r\n        char ident[MAX_IDENT_LEN];\r\n        struct { BinOp op; struct ASTNode *left, *right; } binop;\r\n        struct { UnaryOp op; struct ASTNode *operand; } unary;\r\n        struct { char name[MAX_IDENT_LEN]; NodeList args; } call;\r\n        struct { struct ASTNode *obj; struct ASTNode *index; } index_access;\r\n        struct { char name[MAX_IDENT_LEN]; struct ASTNode *value; } assign;\r\n        struct { char name[MAX_IDENT_LEN]; struct ASTNode *init; } let;\r\n        struct { struct ASTNode *cond, *then_b, *else_b; } if_stmt;\r\n        struct { struct ASTNode *cond, *body; } while_stmt;\r\n        struct { struct ASTNode *value; } ret;\r\n        struct { struct ASTNode *value; } prin"]
[321.290073, "o", "t;\r\n        struct { NodeList stmts; } block;\r\n        struct { char name[MAX_IDENT_LEN]; char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } func;\r\n        struct { NodeList elems; } array_lit;\r\n        struct { struct ASTNode *expr; } expr_stmt;\r\n    } data;\r\n} ASTNode;\r\n\r\ntypedef enum {\r\n    BC_PUSH_INT, BC_PUSH_STR, BC_PUSH_BOOL,\r\n    BC_LOAD_LOCAL, BC_STORE_LOCAL,\r\n    BC_LOAD_GLOBAL, BC_STORE_GLOBAL,\r\n    BC_ADD, BC_SUB, BC_MUL, BC_DIV, BC_MOD,\r\n    BC_EQ, BC_NEQ, BC_LT, BC_GT, BC_LEQ, BC_GEQ,\r\n    BC_AND, BC_OR, BC_NOT, BC_NEG,\r\n    BC_JUMP, BC_JUMP_FALSE,\r\n    BC_CALL, BC_RET,\r\n    BC_PRINT, BC_POP,\r\n    BC_PUSH_ARRAY, BC_INDEX,\r\n    BC_HALT,\r\n    BC_ARRAY_LEN, BC_ARRAY_GET\r\n} Opcode;\r\n\r\ntypedef enum {\r\n    VAL_INT, VAL_STR, VAL_BOOL, VAL_ARRAY, VAL_NULL\r\n} ValueType;\r\n\r\ntypedef struct Value {\r\n    ValueType type;\r\n    union {\r\n        int64_t ival;\r\n        char *sval;"]
[321.290124, "o", "\r\n        int bval;\r\n        struct { struct Value *items; int len; } array;\r\n    } data;\r\n} Value;\r\n\r\ntypedef struct {\r\n    Opcode op;\r\n    int64_t operand;\r\n    char *str_operand;\r\n} Instruction;\r\n\r\ntypedef struct {\r\n    int ip;\r\n    int bp;\r\n    int local_start;\r\n} CallFrame;\r\n\r\nvoid error_at(int line, const char *fmt, ...);\r\n\r\n#endif\r\n"]
[321.290176, "o", "#ifndef MINICC_CODEGEN_H\r\n#define MINICC_CODEGEN_H\r\n\r\n#include \"common.h\"\r\n#include \"ast.h\"\r\n\r\ntypedef struct {\r\n    char name[MAX_IDENT_LEN];\r\n    int scope_depth;\r\n} Local;\r\n\r\ntypedef struct {\r\n    char name[MAX_IDENT_LEN];\r\n    int addr;\r\n    int param_count;\r\n} FuncInfo;\r\n\r\ntypedef struct {\r\n    Instruction code[MAX_BYTECODE];\r\n    int code_count;\r\n    Local locals[MAX_LOCALS];\r\n    int local_count;\r\n    int scope_depth;\r\n    FuncInfo functions[MAX_FUNCTIONS];\r\n    int func_count;\r\n    int in_function;\r\n} Compiler;\r\n\r\nvoid compiler_init(Compiler *c);\r\nint compile(Compiler *c, ASTNode *program);\r\n\r\n#endif\r\n"]
