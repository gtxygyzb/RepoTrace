[4149.586849, "o", "\r\n    80\tstatic void print_value(Value v) {\r\n    81\t    switch (v.type) {\r\n    82\t        case VAL_INT: printf(\"%lld\", (long long)v.data.ival); break;\r\n    83\t        case VAL_BOOL: printf(\"%s\", v.data.bval ? \"true\" : \"false\"); break;\r\n    84\t        case VAL_STR: printf(\"%s\", v.data.sval); break;\r\n    85\t        case VAL_ARRAY:\r\n    86\t            printf(\"[\");\r\n    87\t            for (int i = 0; i < v.data.array.len; i++) {\r\n    88\t                if (i > 0) printf(\", \");\r\n    89\t                print_value(v.data.array.items[i]);\r\n"]
