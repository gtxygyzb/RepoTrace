[10440.640026, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/common.h')\ns = p.read_text()\ns = s.replace('    TOK_DOT,\\n    TOK_COLON,\\n', '    TOK_DOT,\\n    TOK_DOTDOT,\\n    TOK_COLON,\\n')\ns = s.replace('    NODE_THROW, NODE_TRY\\n} NodeType;', '    NODE_THROW, NODE_TRY,\\n    NODE_LET_DESTRUCT\\n} NodeType;')\n# Add AST fields after let field\ns = s.replace('        struct { char name[MAX_IDENT_LEN]; struct ASTNode *init; } let;\\n', '        struct { char name[MAX_IDENT_LEN]; struct ASTNode *init; } let;\\n        struct { NodeList names; int *is_rest; char rest_name[MAX_IDENT_LEN]; int is_array; struct ASTNode *init; } let_destruct;\\n')\n# Add spread field to array_lit\ns = s.replace('        struct { NodeList elems; } array_lit;\\n', '        struct { NodeList elems; int *spread; } array_lit;\\n')\n# Add spread field to call args\ns = s.replace('        struct { char name[MAX_IDENT_LEN]; NodeList args; } call;\\n', '        struct { char name[MAX_IDENT_LEN]; NodeList args; int *spread; } call;\\n')\n# Add rest fields to closu"]
[10440.640338, "i", "re and func\ns = s.replace('        struct { char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } closure;\\n', '        struct { char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; int has_rest; struct ASTNode *body; } closure;\\n')\ns = s.replace('        struct { char name[MAX_IDENT_LEN]; char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } func;\\n', '        struct { char name[MAX_IDENT_LEN]; char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; int has_rest; struct ASTNode *body; } func;\\n')\n# Add opcodes for new features\ns = s.replace('    BC_HALT,\\n', '    BC_HALT,\\n    BC_PUSH_NULL,\\n    BC_ARRAY_GET_OR_NULL,\\n    BC_MAP_GET_OR_NULL,\\n    BC_PUSH_ARRAY_SPREAD,\\n    BC_CALL_SPREAD,\\n    BC_CALL_VALUE_SPREAD,\\n    BC_REST_PARAM,\\n')\np.write_text(s)\nPY\n"]
[10440.640368, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
