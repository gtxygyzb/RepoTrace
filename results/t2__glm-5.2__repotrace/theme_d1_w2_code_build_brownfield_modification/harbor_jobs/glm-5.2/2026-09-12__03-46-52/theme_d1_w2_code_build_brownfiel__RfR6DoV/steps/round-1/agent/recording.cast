[7519.937117, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/codegen.c')\ns = p.read_text()\nold = '''            } else {\n                compile_load(c, name);\n                for (int i = 0; i < node->data.call.args.count; i++)\n                    compile_expr(c, node->data.call.args.items[i]);\n                emit(c, BC_CALL_VALUE, node->data.call.args.count, NULL);\n            }'''\nnew = '''            } else {\n                for (int i = 0; i < node->data.call.args.count; i++)\n                    compile_expr(c, node->data.call.args.items[i]);\n                compile_load(c, name);\n                emit(c, BC_CALL_VALUE, node->data.call.args.count, NULL);\n            }'''\nif old not in s:\n    print('call-value block not found')\nelse:\n    s = s.replace(old, new)\n    p.write_text(s)\n    print('patched call-value order')\nPY\n"]
