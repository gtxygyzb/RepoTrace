[9806.147074, "o", "        case TOK_SLASH: return \"/\"; case TOK_PERCENT: return \"%\";\r\n   174\t        case TOK_EQ: return \"==\"; case TOK_NEQ: return \"!=\";\r\n   175\t        case TOK_LT: return \"<\"; case TOK_GT: return \">\"; case TOK_LEQ: return \"<=\"; case TOK_GEQ: return \">=\";\r\n   176\t        case TOK_ASSIGN: return \"=\"; case TOK_AND: return \"&&\"; case TOK_OR: return \"||\"; case TOK_NOT: return \"!\";\r\n   177\t        case TOK_LPAREN: return \"(\"; case TOK_RPAREN: return \")\";\r\n   178\t        case TOK_LBRACE: return \"{\"; case TOK_RBRACE: return \"}\";\r\n   179\t        case TOK_LBRACKET: return \"[\"; case TOK_RBRACKET: return \"]\";\r\n   180\t        case TOK_SEMICOLON: return \";\"; case TOK_COMMA: return \",\";\r\n"]
[9806.147125, "o", "   181\t        case TOK_IF: return \"if\"; case TOK_ELSE: return \"else\"; case TOK_WHILE: return \"while\";\r\n   182\t        case TOK_FOR: return \"for\"; case TOK_BREAK: return \"break\"; case TOK_CONTINUE: return \"continue\"; case TOK_IN: return \"in\"; case TOK_OF: return \"of\";\r\n   183\t        case TOK_RETURN: return \"return\"; case TOK_FN: return \"fn\"; case TOK_LET: return \"let\";\r\n   184\t        case TOK_PRINT: return \"print\"; case TOK_TRUE: return \"true\"; case TOK_FALSE: return \"false\";\r\n   185\t        case TOK_THROW: return \"throw\"; case TOK_TRY: return \"try\"; case TOK_CATCH: return \"catch\";\r\n   186\t        case TOK_PLUS_ASSIGN: return \"+=\"; case TOK_MINUS_ASSIGN: return \"-=\"; case TOK_STAR_ASSIGN: return \"*=\";\r\n   187\t"]
