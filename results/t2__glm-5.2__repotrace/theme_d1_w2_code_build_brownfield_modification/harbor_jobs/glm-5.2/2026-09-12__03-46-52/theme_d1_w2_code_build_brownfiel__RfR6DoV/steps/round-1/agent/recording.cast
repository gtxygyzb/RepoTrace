[8361.685936, "o", "\r\nstatic int lex_ident(Lexer *lex) {\r\n    char buf[MAX_IDENT_LEN]; int i = 0;\r\n    while (!is_at_end(lex) && (isalnum(peek(lex)) || peek(lex) == '_')) {\r\n        if (i < MAX_IDENT_LEN - 1) buf[i++] = advance(lex); else advance(lex);\r\n    }\r\n    buf[i] = '\\0';\r\n    TokenType type = TOK_IDENT;\r\n    if      (strcmp(buf, \"if\") == 0)       type = TOK_IF;\r\n"]
[8361.686084, "o", "    else if (strcmp(buf, \"else\") == 0)     type = TOK_ELSE;\r\n    else if (strcmp(buf, \"while\") == 0)    type = TOK_WHILE;\r\n    else if (strcmp(buf, \"for\") == 0)     type = TOK_FOR;\r\n    else if (strcmp(buf, \"break\") == 0)   type = TOK_BREAK;\r\n    else if (strcmp(buf, \"continue\") == 0) type = TOK_CONTINUE;\r\n    else if (strcmp(buf, \"in\") == 0)      type = TOK_IN;\r\n    else if (strcmp(buf, \"of\") == 0)      type = TOK_OF;\r\n    else if (strcmp(buf, \"return\") == 0)   type = TOK_RETURN;\r\n    else if (strcmp(buf, \"fn\") == 0)       type = TOK_FN;\r\n    else if (strcmp(buf, \"let\") == 0)      type = TOK_LET;\r\n    else if (strcmp(buf, \"print\") == 0)    type = TOK_PRINT;\r\n    else if (strcmp(buf, \"true\") == 0)     type = TOK_TRUE;\r\n    else if (strcmp(buf, \"false\") == 0)    type = TOK_FALSE;\r\n    Token t = make_token(lex, type, buf);\r\n    return add_token(lex, t);\r\n}\r\n\r\nvoid lexer_init(Lexer *lex, const char *source) {\r\n    lex->source = source; lex->pos = 0; lex->line = 1; lex->col = 1; lex->token_count = 0;\r\n}\r\n\r\nint le"]
[8361.686144, "o", "xer_tokenize(Lexer *lex) {\r\n    while (!is_at_end(lex)) {\r\n        skip_whitespace(lex);\r\n        if (is_at_end(lex)) break;\r\n        char c = peek(lex);\r\n        if (isdigit(c)) { if (lex_number(lex) < 0) return -1; }\r\n        else if (c == '\"') { if (lex_string(lex) < 0) return -1; }\r\n        else if (isalpha(c) || c == '_') { if (lex_ident(lex) < 0) return -1; }\r\n        else {\r\n            advance(lex);\r\n            char buf[4] = {c, '\\0', '\\0', '\\0'};\r\n            TokenType type = TOK_ERROR;\r\n            switch (c) {\r\n                case '+': if (peek(lex)=='='){advance(lex);type=TOK_PLUS_ASSIGN;strcpy(buf,\"+=\");}else{type=TOK_PLUS;} break;\r\n                case '-': if (peek(lex)=='='){advance(lex);type=TOK_MINUS_ASSIGN;strcpy(buf,\"-=\");}else{type=TOK_MINUS;} break;\r\n                case '*': if (peek(lex)=='='){advance(lex);type=TOK_STAR_ASSIGN;strcpy(buf,\"*=\");}else{type=TOK_STAR;} break;\r\n                case '/': if (peek(lex)=='='){advance(lex);type=TOK_SLASH_ASSIGN;strcpy(buf,\"/=\");}else{type=TOK"]
[8361.686192, "o", "_SLASH;} break;\r\n                case '%': if (peek(lex)=='='){advance(lex);type=TOK_PERCENT_ASSIGN;strcpy(buf,\"%=\");}else{type=TOK_PERCENT;} break;\r\n                case '(': type = TOK_LPAREN; break;\r\n                case ')': type = TOK_RPAREN; break;\r\n                case '{': type = TOK_LBRACE; break;\r\n                case '}': type = TOK_RBRACE; break;\r\n                case '[': type = TOK_LBRACKET; break;\r\n                case ']': type = TOK_RBRACKET; break;\r\n                case ';': type = TOK_SEMICOLON; break;\r\n                case ',': type = TOK_COMMA; break;\r\n            case '.': type = TOK_DOT; break;\r\n            case ':': type = TOK_COLON; break;\r\n"]
[8361.68626, "o", "                case '!': if (peek(lex)=='='){advance(lex);type=TOK_NEQ;strcpy(buf,\"!=\");}else{type=TOK_NOT;} break;\r\n                case '=': if (peek(lex)=='='){advance(lex);type=TOK_EQ;strcpy(buf,\"==\");}else{type=TOK_ASSIGN;} break;\r\n                case '<': if (peek(lex)=='='){advance(lex);type=TOK_LEQ;strcpy(buf,\"<=\");}else{type=TOK_LT;} break;\r\n                case '>': if (peek(lex)=='='){advance(lex);type=TOK_GEQ;strcpy(buf,\">=\");}else{type=TOK_GT;} break;\r\n                case '&': if (peek(lex)=='&'){advance(lex);type=TOK_AND;strcpy(buf,\"&&\");}\r\n                          else{error_at(lex->line,\"unexpected character '&'\");return -1;} break;\r\n                case '|': if (peek(lex)=='|'){advance(lex);type=TOK_OR;strcpy(buf,\"||\");}\r\n                          else{error_at(lex->line,\"unexpected character '|'\");return -1;} break;\r\n                default: error_at(lex->line, \"unexpected character '%c'\", c); return -1;"]
[8361.686316, "o", "\r\n            }\r\n            Token t = make_token(lex, type, buf);\r\n            if (add_token(lex, t) < 0) return -1;\r\n        }\r\n    }\r\n    Token eof = make_token(lex, TOK_EOF, \"\");\r\n    return add_token(lex, eof);\r\n}\r\n\r\nconst char *token_type_name(TokenType t) {\r\n    switch (t) {\r\n"]
[8361.68636, "o", "        case TOK_NUM: return \"NUM\"; case TOK_STRING: return \"STRING\"; case TOK_IDENT: return \"IDENT\";\r\n        case TOK_PLUS: return \"+\"; case TOK_MINUS: return \"-\"; case TOK_STAR: return \"*\";\r\n        case TOK_SLASH: return \"/\"; case TOK_PERCENT: return \"%\";\r\n        case TOK_EQ: return \"==\"; case TOK_NEQ: return \"!=\";\r\n        case TOK_LT: return \"<\"; case TOK_GT: return \">\"; case TOK_LEQ: return \"<=\"; case TOK_GEQ: return \">=\";\r\n        case TOK_ASSIGN: return \"=\"; case TOK_AND: return \"&&\"; case TOK_OR: return \"||\"; case TOK_NOT: return \"!\";\r\n        case TOK_LPAREN: return \"(\"; case TOK_RPAREN: return \")\";\r\n"]
[8361.686404, "o", "        case TOK_LBRACE: return \"{\"; case TOK_RBRACE: return \"}\";\r\n        case TOK_LBRACKET: return \"[\"; case TOK_RBRACKET: return \"]\";\r\n        case TOK_SEMICOLON: return \";\"; case TOK_COMMA: return \",\";\r\n        case TOK_IF: return \"if\"; case TOK_ELSE: return \"else\"; case TOK_WHILE: return \"while\";\r\n        case TOK_FOR: return \"for\"; case TOK_BREAK: return \"break\"; case TOK_CONTINUE: return \"continue\"; case TOK_IN: return \"in\"; case TOK_OF: return \"of\";\r\n        case TOK_RETURN: return \"return\"; case TOK_FN: return \"fn\"; case TOK_LET: return \"let\";\r\n"]
[8361.686465, "o", "        case TOK_PRINT: return \"print\"; case TOK_TRUE: return \"true\"; case TOK_FALSE: return \"false\";\r\n        case TOK_PLUS_ASSIGN: return \"+=\"; case TOK_MINUS_ASSIGN: return \"-=\"; case TOK_STAR_ASSIGN: return \"*=\";\r\n        case TOK_SLASH_ASSIGN: return \"/=\"; case TOK_PERCENT_ASSIGN: return \"%=\";\r\n        case TOK_EOF: return \"EOF\"; case TOK_ERROR: return \"ERROR\";\r\n        default: return \"UNKNOWN\";\r\n"]
