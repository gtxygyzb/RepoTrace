[3905.590104, "o", "\u001b[35m\u001b[Ksrc/lexer.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    else if (strcmp(buf, \"for\") == 0)     type = \u001b[01;31m\u001b[KTOK_FOR\u001b[m\u001b[K;\r\n\u001b[35m\u001b[Ksrc/lexer.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    else if (strcmp(buf, \"in\") == 0)      type = \u001b[01;31m\u001b[KTOK_IN\u001b[m\u001b[K;\r\n"]
