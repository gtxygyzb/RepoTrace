[3905.590609, "o", "\u001b[35m\u001b[Ksrc/parser.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (match(p, \u001b[01;31m\u001b[KTOK_FOR\u001b[m\u001b[K)) {\r\n\u001b[35m\u001b[Ksrc/parser.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        return \u001b[01;31m\u001b[Kparse_for\u001b[m\u001b[K(p);\r\n\u001b[35m\u001b[Ksrc/parser.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K361\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = \u001b[01;31m\u001b[KNODE_BREAK\u001b[m\u001b[K; n->line = line; return n;\r\n"]
