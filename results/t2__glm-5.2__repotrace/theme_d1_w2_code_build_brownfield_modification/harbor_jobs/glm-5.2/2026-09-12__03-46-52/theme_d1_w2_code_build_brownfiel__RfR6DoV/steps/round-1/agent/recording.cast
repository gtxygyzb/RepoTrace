[9875.851433, "o", "\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void collect_bound_names(ASTNode *node, char names[][MAX_IDENT_LEN], int *count) {\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!node) return;\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    switch (node->type) {\r\n"]
[9875.851623, "o", "\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kcase NODE_LET:\u001b[m\u001b[K add_name(names, count, node->data.let.name); break;\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_BLOCK:\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            for (int i = 0; i < node->data.block.stmts.count; i++)\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                collect_bound_names(node->data.block.stmts.items[i], names, count);\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            break;\r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_IF:\r\n\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            collect_bound_names(node->data.if_stmt.then_b, names, count);\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            collect_bound_names(node->data.if_stmt.else_b, names, count);\r\n\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            break;\r\n\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_WHILE: collect_bound_names(node->data.while_stmt.body, names, count); break;\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_FOR:\r\n"]
[9875.851732, "o", "\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (node->data.for_stmt.init) collect_bound_names(node->data.for_stmt.init, names, count);\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            collect_bound_names(node->data.for_stmt.body, names, count);\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            break;\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_FOREACH:\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            add_name(names, count, node->data.foreach_stmt.var);\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            collect_bound_names(node->data.foreach_stmt.body, names, count);\r\n\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            break;\r\n\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_FUNC: add_name(names, count, node->data.func.name); break;\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_TRY: add_name(names, count, node->data.try_stmt.catch_var); break;\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_CLOSURE: break;\r\n\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        default: break;\r\n"]
[9875.851827, "o", "\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void collect_free_names(ASTNode *node, char bound[][MAX_IDENT_LEN], int bound_count,\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                              char free_names[][MAX_IDENT_LEN], int *free_count) {\r\n\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!node) return;\r\n\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    switch (node->type) {\r\n\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_IDENT:\r\n\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (!name_in_list(bound, bound_count, node->data.ident)) add_name(free_names, free_count, node->data.ident);\r\n\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            break;\r\n\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_ASSIGN:\r\n"]
[9875.851918, "o", "\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            collect_free_names(node->data.assign.value, bound, bound_count, free_names, free_count);\r\n\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (!name_in_list(bound, bound_count, node->data.assign.name)) add_name(free_names, free_count, node->data.assign.name);\r\n\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            break;\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_COMPOUND_ASSIGN:\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            break;\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        case NODE_FIELD_ASSIGN:\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            collect_free_names(node->data.field_assign.obj, bound, bound_count, free_names, free_count);\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            collect_free_names(node->data.field_assign.value, bound, bound_count, free_names, free_count);\r\n"]
