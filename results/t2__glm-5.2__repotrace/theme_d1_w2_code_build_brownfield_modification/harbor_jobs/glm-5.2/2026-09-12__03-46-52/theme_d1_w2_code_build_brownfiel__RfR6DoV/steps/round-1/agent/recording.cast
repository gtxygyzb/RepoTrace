[5609.555063, "o", "#ifndef MINICC_COMMON_H\r\n#define MINICC_COMMON_H\r\n\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <stdint.h>\r\n#include <ctype.h>\r\n\r\n#define MAX_IDENT_LEN 64\r\n"]
