[10997.801133, "o", "\u001b[?2004h> "]
[10997.801266, "o", "                } else {\r\n\u001b[?2004l\r"]
[10997.801327, "o", "\u001b[?2004h> "]
[10997.801596, "o", "                    frame->captures = NULL;\r\n\u001b[?2004l\r"]
[10997.801659, "o", "\u001b[?2004h> "]
[10997.801952, "o", "                    frame->capture_count = 0;\r\n\u001b[?2004l\r"]
[10997.802013, "o", "\u001b[?2004h> "]
[10997.802091, "o", "                }\r\n"]
[10997.802143, "o", "\u001b[?2004l\r"]
[10997.802168, "o", "\u001b[?2004h> "]
[10997.802383, "o", "                vm->ip = func->addr;\r\n\u001b[?2004l\r"]
[10997.802444, "o", "\u001b[?2004h"]
[10997.802499, "o", "> "]
[10997.80258, "o", "                break;\r\n\u001b[?2004l\r"]
[10997.802636, "o", "\u001b[?2004h> "]
[10997.802711, "o", "            }\r\n"]
[10997.802729, "o", "\u001b[?2004l\r"]
[10997.802806, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[10997.802858, "o", "\u001b[?2004h> "]
[10997.803145, "o", "new = '''            case BC_CALL_VALUE: {\r\n\u001b[?2004l\r"]
