[9892.427297, "o", "static int compile_node(Compiler *c, ASTNode *node) {\r\n    switch (node->type) {\r\n        case NODE_LET: {\r\n            int slot = add_local(c, node->data.let.name);\r\n            if (slot < 0) return -1;\r\n            compile_expr(c, node->data.let.init);\r\n            break;\r\n        }\r\n        case NODE_ASSIGN: {\r\n            compile_expr(c, node->data.assign.value);\r\n"]
[9892.427408, "o", "            compile_store(c, node->data.assign.name);\r\n            break;\r\n        }\r\n        case NODE_INDEX_ASSIGN: {\r\n            if (node->data.index_assign.obj) {\r\n                compile_expr(c, node->data.index_assign.obj);\r\n                compile_expr(c, node->data.index_assign.index);\r\n                compile_expr(c, node->data.index_assign.value);\r\n                emit(c, BC_INDEX_STORE, 0, NULL);\r\n            } else {\r\n                compile_load(c, node->data.index_assign.name);\r\n                compile_expr(c, node->data.index_assign.index);\r\n                compile_expr(c, node->data.index_assign.value);\r\n                emit(c, BC_INDEX_STORE, 0, NULL);\r\n            }\r\n            break;\r\n        }\r\n        case NODE_FIELD_ASSIGN: {\r\n            compile_expr(c, node->data.field_assign.obj);\r\n            emit(c, BC_PUSH_STR, 0, strdup(node->data.field_assign.field));\r\n            compile_expr(c, node->data.field_assign.value);\r\n            emit(c, BC_MAP_SET, 0, NULL);\r\n            break;\r\n"]
[9892.42749, "o", "        }\r\n        case NODE_IF: {\r\n            compile_expr(c, node->data.if_stmt.cond);\r\n            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n            compile_node(c, node->data.if_stmt.then_b);\r\n            if (node->data.if_stmt.else_b) {\r\n                int je = emit(c, BC_JUMP, 0, NULL);\r\n                c->code[jf].operand = c->code_count;\r\n                compile_node(c, node->data.if_stmt.else_b);\r\n                c->code[je].operand = c->code_count;\r\n            } else {\r\n                c->code[jf].operand = c->code_count;\r\n"]
