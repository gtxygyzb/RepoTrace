[330.619393, "o", "_OR;strcpy(buf,\"||\");}\r\n   141\t                          else{error_at(lex->line,\"unexpected character '|'\");return -1;} break;\r\n   142\t                default: error_at(lex->line, \"unexpected character '%c'\", c); return -1;\r\n   143\t            }\r\n   144\t            Token t = make_token(lex, type, buf);\r\n   145\t            if (add_token(lex, t) < 0) return -1;\r\n   146\t        }\r\n   147\t    }\r\n   148\t    Token eof = make_token(lex, TOK_EOF, \"\");\r\n   149\t    return add_token(lex, eof);\r\n   150\t}\r\n   151\t\r\n   152\tconst char *token_type_name(TokenType t) {\r\n   153\t    switch (t) {\r\n   154\t        case TOK_NUM: return \"NUM\"; case TOK_STRING: return \"STRING\"; case TOK_IDENT: return \"IDENT\";\r\n   155\t        case TOK_PLUS: return \"+\"; case TOK_MINUS: return \"-\"; case TOK_STAR: return \"*\";\r\n   156\t        case TOK_SLASH: return \"/\"; case TOK_PERCENT: return \"%\";\r\n   157\t        case TOK_EQ: return \"==\"; case TOK_NEQ: return \"!=\";\r\n   158\t        case TOK_LT: return \"<\"; case TOK_GT: return \">\"; case TOK_LEQ: return \"<"]
