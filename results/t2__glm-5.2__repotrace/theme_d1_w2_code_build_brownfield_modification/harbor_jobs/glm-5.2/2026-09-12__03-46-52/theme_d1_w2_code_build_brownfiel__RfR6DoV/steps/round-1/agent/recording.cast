[5999.872814, "o", "#ifndef MINICC_COMMON_H\r\n#define MINICC_COMMON_H\r\n\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <stdint.h>\r\n#include <ctype.h>\r\n\r\n#define MAX_IDENT_LEN 64\r\n#define MAX_STRING_LEN 1024\r\n#define MAX_TOKENS 4096\r\n#define MAX_LOCALS 256\r\n#define MAX_FUNCTIONS 128\r\n#define MAX_BYTECODE 16384\r\n#define MAX_STACK 1024\r\n#define MAX_CALL_FRAMES 64\r\n#define MAX_GLOBALS 256\r\n#define MAX_AST_NODES 8192\r\n#define MAX_PARAMS 16\r\n\r\ntypedef enum {\r\n    TOK_NUM, TOK_STRING, TOK_IDENT,\r\n    TOK_PLUS, TOK_MINUS, TOK_STAR, TOK_SLASH, TOK_PERCENT,\r\n    TOK_EQ, TOK_NEQ, TOK_LT, TOK_GT, TOK_LEQ, TOK_GEQ,\r\n    TOK_ASSIGN, TOK_AND, TOK_OR, TOK_NOT,\r\n    TOK_LPAREN, TOK_RPAREN, TOK_LBRACE, TOK_RBRACE,\r\n    TOK_LBRACKET, TOK_RBRACKET,\r\n    TOK_SEMICOLON, TOK_COMMA,\r\n    TOK_IF, TOK_ELSE, TOK_WHILE, TOK_FOR, TOK_RETURN,\r\n    TOK_BREAK, TOK_CONTINUE, TOK_IN, TOK_OF,\r\n    TOK_FN, TOK_LET, TOK_PRINT, TOK_TRUE, TOK_FALSE,\r\n    TOK_DOT,\r\n    TOK_COLON,\r\n    TOK_PLUS_ASSIGN, TOK_MINUS_ASSIGN, TOK_STAR_ASSIGN, TOK_SLAS"]
