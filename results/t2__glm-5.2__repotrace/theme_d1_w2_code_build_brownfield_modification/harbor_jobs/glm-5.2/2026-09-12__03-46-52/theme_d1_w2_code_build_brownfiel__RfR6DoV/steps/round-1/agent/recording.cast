[8035.070444, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/parser.c')\ns = p.read_text()\nstart = s.index('static ASTNode *parse_postfix(Parser *p, ASTNode *expr) {')\nend = s.index('static ASTNode *parse_unary', start)\nnew_func = r'''static ASTNode *parse_postfix(Parser *p, ASTNode *expr) {\n    for (;;) {\n        if (match(p, TOK_DOT)) {\n            int line = prev(p)->line;\n            expect(p, TOK_IDENT, \"field or method name\");\n            char name[MAX_IDENT_LEN];\n            strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\\0';\n            if (check(p, TOK_LPAREN)) {\n                match(p, TOK_LPAREN);\n                ASTNode *n = ast_alloc(); n->type = NODE_METHOD_CALL; n->line = line;\n                n->data.method_call.obj = expr;\n                strncpy(n->data.method_call.method, name, MAX_IDENT_LEN - 1);\n                n->data.method_call.method[MAX_IDENT_LEN - 1] = '\\0';\n                nodelist_init(&n->data.method_call.args);\n                if (!check(p, TOK_RPAREN)) {"]
[8035.070485, "i", "\n                    do { nodelist_push(&n->data.method_call.args, parse_expr(p)); } while (match(p, TOK_COMMA));\n                }\n                expect(p, TOK_RPAREN, \"')'\");\n                expr = n;\n            } else {\n                ASTNode *n = ast_alloc(); n->type = NODE_FIELD_ACCESS; n->line = line;\n                n->data.field_access.obj = expr;\n                strncpy(n->data.field_access.field, name, MAX_IDENT_LEN - 1);\n                n->data.field_access.field[MAX_IDENT_LEN - 1] = '\\0';\n                expr = n;\n            }\n        } else if (match(p, TOK_LBRACKET)) {\n            int line = prev(p)->line;\n            ASTNode *idx = parse_expr(p);\n            expect(p, TOK_RBRACKET, \"']'\");\n            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;\n            n->data.index_access.obj = expr;\n            n->data.index_access.index = idx;\n            expr = n;\n        } else {\n            break;\n        }\n    }\n    return expr;\n}\n\n'''\ns = s[:start] + new_func + s[end:]\np.writ"]
