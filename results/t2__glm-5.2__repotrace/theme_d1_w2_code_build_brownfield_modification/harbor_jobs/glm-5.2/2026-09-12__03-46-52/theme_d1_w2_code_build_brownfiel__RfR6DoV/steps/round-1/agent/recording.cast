[10425.462769, "o", "\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic Value make_map(void) {\r\n\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Value val; val.type = VAL_MAP; val.data.map = malloc(sizeof(MapData));\r\n"]
