[10204.495416, "o", "\u001b[32m\u001b[K492\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (check(p, TOK_IDENT)) {\r\n\u001b[32m\u001b[K493\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *a = try_parse_assign(p);\r\n\u001b[32m\u001b[K494\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (a) { expect(p, TOK_SEMICOLON, \"';'\"); return a; }\r\n\u001b[32m\u001b[K495\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K496\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *expr = parse_expr(p);\r\n\u001b[32m\u001b[K497\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_SEMICOLON, \"';'\");\r\n"]
[10204.495483, "o", "\u001b[32m\u001b[K498\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;\r\n\u001b[32m\u001b[K499\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.expr_stmt.expr = expr; return n;\r\n\u001b[32m\u001b[K500\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K501\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K502\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid parser_init(Parser *p, Token *tokens, int count) {\r\n\u001b[32m\u001b[K503\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;\r\n\u001b[32m\u001b[K504\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K505\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K506\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KASTNode *parse_program(Parser *p) {\r\n\u001b[32m\u001b[K507\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;\r\n\u001b[32m\u001b[K508\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    nodelist_init(&program->data.block.stmts);\r\n\u001b[32m\u001b[K509\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (!check(p, TOK_EOF)) {\r\n\u001b[32m\u001b[K510\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *stmt = parse_stmt(p);\r\n\u001b[32m\u001b[K511\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (stmt) nodelist_push(&program->data.block.stmts, stmt);\r\n"]
[10204.495566, "o", "\u001b[32m\u001b[K512\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (p->had_error) break;\r\n\u001b[32m\u001b[K513\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K514\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return program;\r\n\u001b[32m\u001b[K515\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
