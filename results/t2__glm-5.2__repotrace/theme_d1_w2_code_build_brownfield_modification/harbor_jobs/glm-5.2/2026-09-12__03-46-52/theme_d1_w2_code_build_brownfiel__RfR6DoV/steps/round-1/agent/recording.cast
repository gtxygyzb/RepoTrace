[363.303614, "o", "   270\t        ASTNode *a = try_parse_assign(p);\r\n   271\t        if (a) { expect(p, TOK_SEMICOLON, \"';'\"); return a; }\r\n   272\t    }\r\n   273\t    ASTNode *expr = parse_expr(p);\r\n   274\t    expect(p, TOK_SEMICOLON, \"';'\");\r\n   275\t    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;\r\n   276\t    n->data.expr_stmt.expr = expr; return n;\r\n   277\t}\r\n   278\t\r\n   279\tvoid parser_init(Parser *p, Token *tokens, int count) {\r\n"]
