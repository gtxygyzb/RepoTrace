[9870.834292, "o", ".args.count, NULL);\r\n\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            break;\r\n\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kcase NODE_CLOSURE:\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            char bound_names[MAX_LOCALS][MAX_IDENT_LEN]; int bound_count = 0;\r\n\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            for (int i = 0; i < node->data.closure.param_count; i++)\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                add_name(bound_names, &bound_count, node->data.closure.params[i]);\r\n\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            collect_bound_names(node->data.closure.body, bound_names, &bound_count);\r\n\u001b[32m\u001b[K319\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            char free_names[MAX_LOCALS][MAX_IDENT_LEN]; int free_count = 0;\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            collect_free_names(node->data.closure.body, bound_names, bound_count, free_names, &free_count);\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[9870.834361, "o", "\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            char cap_names[MAX_LOCALS][MAX_IDENT_LEN]; int cap_count = 0;\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            int cap_slots[MAX_LOCALS];\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            for (int i = 0; i < free_count; i++) {\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                const char *nm = free_names[i];\r\n\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int slot = resolve_local(c, nm);\r\n\u001b[32m\u001b[K327\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (slot >= 0) {\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    add_name(cap_names, &cap_count, nm);\r\n\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    cap_slots[cap_count - 1] = slot;\r\n\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    c->locals[slot].is_boxed = 1;\r\n\u001b[32m\u001b[K331\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                } else {\r\n\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    int cap = resolve_capture(c, nm);\r\n\u001b[32m\u001b[K333\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    if (cap >= 0) {\r\n\u001b[32m\u001b[K334\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                        add"]
[9870.834427, "o", "_name(cap_names, &cap_count, nm);\r\n\u001b[32m\u001b[K335\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                        cap_slots[cap_count - 1] = -1 - cap;\r\n\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    }\r\n\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                }\r\n\u001b[32m\u001b[K338\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K339\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K340\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (c->func_count >= MAX_FUNCTIONS) { fprintf(stderr, \"too many functions\\n\"); return -1; }\r\n\u001b[32m\u001b[K341\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            FuncInfo *fi = &c->functions[c->func_count];\r\n\u001b[32m\u001b[K342\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            snprintf(fi->name, MAX_IDENT_LEN, \"__closure_%d\", c->func_count);\r\n\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            fi->param_count = node->data.closure.param_count;\r\n\u001b[32m\u001b[K344\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            fi->capture_count = cap_count;\r\n\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            for (int i = 0; i < cap_count; i++) fi->capture_slots[i] = cap_slots[i];\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            int func_idx = c->func_count++;\r\n\u001b[32"]
[9870.834497, "o", "m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            for (int i = 0; i < cap_count; i++) {\r\n\u001b[32m\u001b[K349\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (cap_slots[i] >= 0) {\r\n\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    emit(c, BC_BOX_LOCAL, cap_slots[i], NULL);\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    emit(c, BC_LOAD_LOCAL, cap_slots[i], NULL);\r\n\u001b[32m\u001b[K352\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                } else {\r\n\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    emit(c, BC_LOAD_CAPTURE_CELL, -1 - cap_slots[i], NULL);\r\n\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                }\r\n\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            emit(c, BC_MAKE_CLOSURE, func_idx, NULL);\r\n\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            int jump_over = emit(c, BC_JUMP, 0, NULL);\r\n\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            fi->addr = c->code_count;\r\n"]
