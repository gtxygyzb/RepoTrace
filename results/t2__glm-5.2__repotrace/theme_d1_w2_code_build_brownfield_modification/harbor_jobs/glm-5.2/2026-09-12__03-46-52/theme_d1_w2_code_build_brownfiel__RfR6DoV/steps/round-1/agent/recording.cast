[9882.770934, "o", "\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    v.data.closure.captures[i] = val.data.ref;\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                }\r\n\u001b[32m\u001b[K310\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                push(vm, v);\r\n\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n"]
