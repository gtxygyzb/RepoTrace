[7528.956477, "o", "CC = gcc\r\nCFLAGS = -Wall -Wextra -std=c11 -g -D_GNU_SOURCE\r\nSRCS = src/main.c src/lexer.c src/ast.c src/parser.c src/codegen.c src/vm.c\r\nOBJS = $(SRCS:.c=.o)\r\nTARGET = minicc\r\n\r\nall: $(TARGET)\r\n\r\n$(TARGET): $(OBJS)\r\n\t$(CC) $(CFLAGS) -o $@ $^\r\n\r\nsrc/%.o: src/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\nclean:\r\n\trm -f $(OBJS) $(TARGET)\r\n\r\n.PHONY: all clean\r\n"]
