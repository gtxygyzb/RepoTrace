[5394.63031, "o", "\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else if (!check(p, TOK_SEMICOLON)) {\r\n\u001b[32m\u001b[K268\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        init = parse_expr(p);\r\n\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *cond = NULL;\r\n\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);\r\n\u001b[32m\u001b[K274\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[32m\u001b[K275\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *step = NULL;\r\n\u001b[32m\u001b[K277\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!check(p, TOK_RPAREN)) {\r\n\u001b[32m\u001b[K278\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (check(p, TOK_IDENT)) {\r\n\u001b[32m\u001b[K279\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            step = \u001b[01;31m\u001b[Ktry_parse_assign\u001b[m\u001b[K(p);\r\n\u001b[32m\u001b[K280\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K281\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (!step) step = parse_expr(p);\r\n\u001b[32m\u001b[K282\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K283\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_R"]
[5394.630352, "o", "PAREN, \"')'\");\r\n\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K285\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *body = parse_block(p);\r\n\u001b[32m\u001b[K286\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;\r\n\u001b[32m\u001b[K287\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.for_stmt.init = init;\r\n\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.for_stmt.cond = cond;\r\n\u001b[32m\u001b[K289\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.for_stmt.step = step;\r\n\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.for_stmt.body = body;\r\n"]
[5394.630443, "o", "\u001b[32m\u001b[K291\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return n;\r\n\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K293\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K294\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic ASTNode *parse_block(Parser *p) {\r\n\u001b[32m\u001b[K295\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_LBRACE, \"'{'\");\r\n\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;\r\n\u001b[32m\u001b[K297\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    nodelist_init(&block->data.block.stmts);\r\n\u001b[32m\u001b[K298\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {\r\n\u001b[32m\u001b[K299\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *stmt = parse_stmt(p);\r\n\u001b[32m\u001b[K300\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (stmt) nodelist_push(&block->data.block.stmts, stmt);\r\n\u001b[32m\u001b[K301\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (p->had_error) break;\r\n\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K303\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_RBRACE, \"'}'\");\r\n"]
[5394.630512, "o", "\u001b[32m\u001b[K304\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return block;\r\n\u001b[32m\u001b[K305\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K306\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K307\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic ASTNode *parse_stmt(Parser *p) {\r\n"]
[5394.63058, "o", "\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_LET)) {\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int line = prev(p)->line;\r\n\u001b[32m\u001b[K310\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_IDENT, \"identifier\");\r\n\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        char name[MAX_IDENT_LEN];\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_ASSIGN, \"'='\");\r\n\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *init = parse_expr(p);\r\n\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);\r\n\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.let.init = init; return n;\r\n"]
[5394.630642, "o", "\u001b[32m\u001b[K319\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_IF)) {\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int line = prev(p)->line;\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_LPAREN, \"'('\");\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *cond = parse_expr(p);\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_RPAREN, \"')'\");\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *then_b = parse_block(p);\r\n"]
[5394.630709, "o", "\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *else_b = NULL;\r\n\u001b[32m\u001b[K327\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (match(p, TOK_ELSE)) {\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (check(p, TOK_IF)) {\r\n\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                ASTNode *elif = parse_stmt(p);\r\n"]
[5394.630772, "o", "\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;\r\n\u001b[32m\u001b[K331\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                nodelist_init(&else_b->data.block.stmts);\r\n\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                nodelist_push(&else_b->data.block.stmts, elif);\r\n\u001b[32m\u001b[K333\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            } else {\r\n\u001b[32m\u001b[K334\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                else_b = parse_block(p);\r\n\u001b[32m\u001b[K335\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;\r\n\u001b[32m\u001b[K338\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;\r\n\u001b[32m\u001b[K339\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        return n;\r\n"]
[5394.630835, "o", "\u001b[32m\u001b[K340\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K341\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_WHILE)) {\r\n\u001b[32m\u001b[K342\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int line = prev(p)->line;\r\n\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_LPAREN, \"'('\");\r\n\u001b[32m\u001b[K344\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *cond = parse_expr(p);\r\n\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_RPAREN, \"')'\");\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *body = parse_block(p);\r\n"]
[5394.630899, "o", "\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;\r\n\u001b[32m\u001b[K349\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_RETURN)) {\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int line = prev(p)->line;\r\n\u001b[32m\u001b[K352\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *value = NULL;\r\n\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);\r\n\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;\r\n\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.ret.value = value; return n;\r\n\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n"]
[5394.630964, "o", "\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_FOR)) {\r\n\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        return parse_for(p);\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        ASTNode *a = \u001b[01;31m\u001b[Ktry_parse_assign\u001b[m\u001b[K(p);\r\n\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (a) { expect(p, TOK_SEMICOLON, \"';'\"); return a; }\r\n\u001b[32m\u001b[K401\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *expr = parse_expr(p);\r\n\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_SEMICOLON, \"';'\");\r\n"]
[5394.631033, "o", "\u001b[32m\u001b[K404\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;\r\n\u001b[32m\u001b[K405\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.expr_stmt.expr = expr; return n;\r\n\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid parser_init(Parser *p, Token *tokens, int count) {\r\n\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;\r\n\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[5394.631106, "o", "\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KASTNode *parse_program(Parser *p) {\r\n\u001b[32m\u001b[K413\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;\r\n\u001b[32m\u001b[K414\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    nodelist_init(&program->data.block.stmts);\r\n\u001b[32m\u001b[K415\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (!check(p, TOK_EOF)) {\r\n\u001b[32m\u001b[K416\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *stmt = parse_stmt(p);\r\n\u001b[32m\u001b[K417\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (stmt) nodelist_push(&program->data.block.stmts, stmt);\r\n\u001b[32m\u001b[K418\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (p->had_error) break;\r\n"]
[5394.631168, "o", "\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return program;\r\n\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
[5394.631722, "o", "\u001b[?2004h"]
