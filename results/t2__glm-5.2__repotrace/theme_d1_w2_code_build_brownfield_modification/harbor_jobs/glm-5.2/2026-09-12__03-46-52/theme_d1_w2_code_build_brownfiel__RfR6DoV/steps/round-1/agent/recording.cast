[332.783062, "o", "     1\t#include <stdio.h>\r\n     2\t#include <stdlib.h>\r\n     3\t#include <string.h>\r\n     4\t#include \"lexer.h\"\r\n"]
[332.783179, "o", "     5\t#include \"parser.h\"\r\n     6\t#include \"codegen.h\"\r\n     7\t#include \"vm.h\"\r\n     8\t\r\n     9\tstatic char *read_file(const char *path) {\r\n    10\t    FILE *f = fopen(path, \"r\");\r\n    11\t    if (!f) { fprintf(stderr, \"cannot open file: %s\\n\", path); return NULL; }\r\n    12\t    fseek(f, 0, SEEK_END);\r\n    13\t    long size = ftell(f);\r\n    14\t    if (size > 0) {\r\n    15\t        fseek(f, 0, SEEK_SET);\r\n    16\t        char *buf = malloc(size + 1);\r\n    17\t        if (!buf) { fclose(f); return NULL; }\r\n    18\t        size_t rd = fread(buf, 1, size, f);\r\n"]
[332.783296, "o", "    19\t        buf[rd] = '\\0';\r\n    20\t        fclose(f);\r\n    21\t        return buf;\r\n    22\t    }\r\n    23\t    fseek(f, 0, SEEK_SET);\r\n    24\t    size_t cap = 4096, len = 0;\r\n    25\t    char *buf = malloc(cap);\r\n"]
[332.783363, "o", "    26\t    if (!buf) { fclose(f); return NULL; }\r\n    27\t    size_t rd;\r\n    28\t    while ((rd = fread(buf + len, 1, cap - len - 1, f)) > 0) {\r\n    29\t        len += rd;\r\n    30\t        if (len + 1 >= cap) { cap *= 2; buf = realloc(buf, cap); }\r\n    31\t    }\r\n    32\t    buf[len] = '\\0';\r\n    33\t    fclose(f);\r\n    34\t    return buf;\r\n    35\t}\r\n    36\t\r\n    37\tint main(int argc, char **argv) {\r\n    38\t    if (argc < 2) { fprintf(stderr, \"usage: minicc <file.mini>\\n\"); return 1; }\r\n    39\t    char *source = read_file(argv[1]);\r\n"]
[332.783426, "o", "    40\t    if (!source) return 1;\r\n    41\t\r\n    42\t    Lexer lex;\r\n    43\t    lexer_init(&lex, source);\r\n    44\t    if (lexer_tokenize(&lex) < 0) { free(source); return 1; }\r\n    45\t\r\n    46\t    Parser parser;\r\n"]
[332.783517, "o", "    47\t    parser_init(&parser, lex.tokens, lex.token_count);\r\n    48\t    ASTNode *program = parse_program(&parser);\r\n    49\t    if (parser.had_error) { free(source); ast_free_all(); return 1; }\r\n    50\t\r\n    51\t    Compiler compiler;\r\n    52\t    compiler_init(&compiler);\r\n    53\t    if (compile(&compiler, program) < 0) { free(source); ast_free_all(); return 1; }\r\n    54\t\r\n    55\t    VM vm;\r\n    56\t    vm_init(&vm, &compiler);\r\n    57\t    int result = vm_run(&vm);"]
[332.783579, "o", "\r\n    58\t\r\n    59\t    free(source);\r\n    60\t    ast_free_all();\r\n    61\t    return result;\r\n    62\t}\r\n"]
[332.783979, "o", "\u001b[?2004hroot@n30009:/app# "]
[333.069755, "i", "for f in tests/programs/todo_*.mini; do echo \"===== $f\"; cat \"$f\"; done\n"]
[333.070318, "o", "for f in tests/programs/todo_*.mini; do echo \"===== $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[333.070568, "o", "===== tests/programs/todo_complex.mini\r\n"]
[333.072797, "o", "// TODO: Complex interaction - precedence + nested calls + strings combined\r\nfn max(a, b) {\r\n    if (a > b) {\r\n        return a;\r\n    }\r\n    return b;\r\n}\r\n\r\nfn min(a, b) {\r\n    if (a < b) {\r\n        return a;\r\n    }\r\n    return b;\r\n}\r\n\r\nfn abs(x) {\r\n    if (x < 0) {\r\n        return 0 - x;\r\n    }\r\n    return x;\r\n}\r\n\r\nfn clamp(val, lo, hi) {\r\n    return min(max(val, lo), hi);\r\n}\r\n\r\n// Test precedence in function results\r\nlet x = max(3, 5) + min(10, 2);\r\nprint x;\r\n\r\n// Comparison with function call results\r\n// max(3,5) + min(10,2) == 7 should be (max(3,5) + min(10,2)) == 7\r\nif (max(3, 5) + min(10, 2) == 7) {\r\n    print 1;\r\n} else {\r\n    print 0;\r\n}\r\n\r\n// Nested calls with arithmetic in args\r\nprint clamp(15, 0, 10);\r\nprint clamp(max(3, 7) + 5, 0, 20);\r\nprint abs(min(5, 3) - max(8, 10));\r\n\r\n// String concatenation\r\nlet greeting = \"hello\" + \" \" + \"world\";\r\nprint greeting;\r\n\r\n// Mixed expressions\r\nlet result = max(abs(0 - 5), abs(0 - 3));\r\nprint result;\r\n"]
[333.073159, "o", "===== tests/programs/todo_nested_calls.mini\r\n"]
[333.075237, "o", "// TODO: Nested function calls as arguments\r\n// When function calls are used as arguments to other function calls,\r\n// the stack frame management must handle the intermediate return values\r\n\r\nfn double(x) {\r\n    return x * 2;\r\n}\r\n\r\nfn add(a, b) {\r\n    return a + b;\r\n}\r\n\r\nfn triple(x) {\r\n    return x * 3;\r\n}\r\n\r\nfn sub(a, b) {\r\n    return a - b;\r\n}\r\n\r\n// double(add(2, 3)) => double(5) => 10\r\nprint double(add(2, 3));\r\n\r\n// add(double(3), triple(2)) => add(6, 6) => 12\r\nprint add(double(3), triple(2));\r\n\r\n// add(add(1, 2), add(3, 4)) => add(3, 7) => 10\r\nprint add(add(1, 2), add(3, 4));\r\n\r\n// sub(double(add(1, 4)), triple(3)) => sub(double(5), 9) => sub(10, 9) => 1\r\nprint sub(double(add(1, 4)), triple(3));\r\n\r\n// Three levels: double(double(double(2))) => 16\r\nprint double(double(double(2)));\r\n"]
[333.075561, "o", "===== tests/programs/todo_precedence.mini\r\n"]
[333.077859, "o", "// TODO: Operator precedence for comparison with arithmetic\r\n// These test that comparison operators have LOWER precedence than +/-\r\n// Expected: (3 + 4) == 7 should be true, not 3 + (4 == 7) + ...\r\nlet a = 3;\r\nlet b = 4;\r\nlet c = 7;\r\n\r\n// a + b == c  should mean (a + b) == c => true\r\nif (a + b == c) {\r\n    print 1;\r\n} else {\r\n    print 0;\r\n}\r\n\r\n// a * 2 + 1 == b + 3  should mean (a*2 + 1) == (b + 3) => 7 == 7 => true\r\nif (a * 2 + 1 == b + 3) {\r\n    print 1;\r\n} else {\r\n    print 0;\r\n}\r\n\r\n// 10 - 3 > 5  should mean (10 - 3) > 5 => 7 > 5 => true\r\nif (10 - 3 > 5) {\r\n    print 1;\r\n} else {\r\n    print 0;\r\n}\r\n\r\n// 2 + 2 != 5  should mean (2 + 2) != 5 => true\r\nif (2 + 2 != 5) {\r\n    print 1;\r\n} else {\r\n    print 0;\r\n}\r\n\r\n// Chained: a + b >= c && c - a <= b  should mean ((a+b) >= c) && ((c-a) <= b)\r\nif (a + b >= c && c - a <= b) {\r\n    print 1;\r\n} else {\r\n    print 0;\r\n}\r\n"]
[333.078237, "o", "===== tests/programs/todo_strings.mini\r\n"]
[333.080268, "o", "// TODO: String escape sequences\r\n// The lexer should handle \\n \\t \\\\ \\\" in string literals\r\nprint \"hello\\nworld\";\r\nprint \"tab\\there\";\r\nprint \"back\\\\slash\";\r\nprint \"say \\\"hi\\\"\";\r\nprint \"multi\\n\\tindented\";\r\n"]
[333.080619, "o", "\u001b[?2004h"]
[333.080686, "o", "root@n30009:/app# "]
