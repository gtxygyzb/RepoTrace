[5999.58077, "o", "                    push(vm, idx);\r\n                }\r\n                break;\r\n            }\r\n            case BC_HALT: return 0;\r\n            default: fprintf(stderr, \"unknown opcode %d\\n\", ins->op); return -1;\r\n        }\r\n"]
