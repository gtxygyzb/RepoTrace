[10997.823806, "o", "                CallFrame *frame = &vm->frames[vm->frame_count++];\r\n\u001b[?2004l\r"]
[10997.823872, "o", "\u001b[?2004h> "]
[10997.824117, "o", "                frame->ip = vm->ip;\r\n\u001b[?2004l\r"]
[10997.824178, "o", "\u001b[?2004h> "]
[10997.824432, "o", "                frame->bp = vm->sp;\r\n\u001b[?2004l\r"]
[10997.824495, "o", "\u001b[?2004h"]
[10997.82452, "o", "> "]
[10997.824763, "o", "                frame->captures = NULL;\r\n\u001b[?2004l\r"]
[10997.824823, "o", "\u001b[?2004h> "]
[10997.825141, "o", "                frame->capture_count = 0;\r\n\u001b[?2004l\r"]
[10997.825201, "o", "\u001b[?2004h> "]
[10997.825733, "o", "                /* BUG: the callee's local base does not properly account for\r\n\u001b[?2004l\r"]
[10997.825797, "o", "\u001b[?2004h> "]
[10997.826416, "o", "                   intermediate return values that earlier nested-call arguments\r\n\u001b[?2004l\r"]
[10997.826482, "o", "\u001b[?2004h> "]
[10997.827043, "o", "                   left on the stack. For multi-argument calls that are preceded\r\n\u001b[?2004l\r"]
[10997.827106, "o", "\u001b[?2004h> "]
[10997.827533, "o", "                   by such temporaries the base is mis-computed (off by one),\r\n\u001b[?2004l\r"]
[10997.827599, "o", "\u001b[?2004h> "]
[10997.828017, "o", "                   so nested calls used as arguments (e.g. add(double(3), triple(2)))\r\n\u001b[?2004l\r"]
[10997.828081, "o", "\u001b[?2004h> "]
[10997.828481, "o", "                   read the wrong stack slots and produce wrong results. */\r\n\u001b[?2004l\r"]
[10997.828546, "o", "\u001b[?2004h> "]
[10997.828861, "o", "                frame->local_start = vm->sp - func->param_count;\r\n\u001b[?2004l\r"]
[10997.828932, "o", "\u001b[?2004h> "]
[10997.829095, "o", "                vm->ip = func->addr;\r\n\u001b[?2004l\r"]
[10997.829154, "o", "\u001b[?2004h> "]
[10997.829247, "o", "                break;\r\n\u001b[?2004l\r"]
[10997.829309, "o", "\u001b[?2004h> "]
[10997.829366, "o", "            }\r\n\u001b[?2004l\r"]
[10997.829422, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[10997.829473, "o", "\u001b[?2004h> "]
