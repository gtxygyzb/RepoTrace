[1991.884712, "o", "   166\t        }\r\n   167\t        case NODE_FOR: {\r\n   168\t            int old_lc = c->local_count;\r\n   169\t            c->scope_depth++;\r\n   170\t            if (node->data.for_stmt.init) compile_node(c, node->data.for_stmt.init);\r\n   171\t            int loop_start = c->code_count;\r\n"]
[1991.884824, "o", "   172\t            if (node->data.for_stmt.cond) compile_expr(c, node->data.for_stmt.cond);\r\n   173\t            else emit(c, BC_PUSH_BOOL, 1, NULL);\r\n   174\t            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n   175\t            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n   176\t            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n   177\t            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\r\n   178\t            ctx->break_count = 0; ctx->cont_count = 0;\r\n   179\t            compile_node(c, node->data.for_stmt.body);\r\n   180\t            int step_start = c->code_count;\r\n   181\t            ctx->cont = step_start;\r\n   182\t            if (node->data.for_stmt.step) compile_node(c, node->data.for_stmt.step);\r\n   183\t            emit(c, BC_JUMP, loop_start, NULL);\r\n   184\t            int end = c->code_count;\r\n   185\t            c->code[jf].operand = end;\r\n   186"]
[1991.884887, "o", "\t            ctx->end = end;\r\n   187\t            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;\r\n   188\t            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = step_start;\r\n"]
[1991.884946, "o", "   189\t            loop_depth--;\r\n   190\t            int n = c->local_count - old_lc;\r\n   191\t            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n   192\t            c->local_count = old_lc;\r\n   193\t            c->scope_depth--;\r\n   194\t            break;\r\n   195\t        }\r\n   196\t        case NODE_FOREACH: {\r\n"]
[1991.885006, "o", "   197\t            int old_lc = c->local_count;\r\n   198\t            c->scope_depth++;\r\n   199\t            compile_expr(c, node->data.foreach_stmt.arr);\r\n   200\t            int arr_slot = add_local(c, \".forarr\");\r\n   201\t            emit(c, BC_PUSH_INT, 0, NULL);\r\n   202\t            int idx_slot = add_local(c, \".foridx\");\r\n   203\t            int loop_start = c->code_count;\r\n   204\t            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n   205\t            emit(c, BC_LOAD_LOCAL, arr_slot, NULL);\r\n   206\t            emit(c, BC_ARRAY_LEN, 0, NULL);\r\n   207\t            emit(c, BC_LT, 0, NULL);\r\n"]
[1991.885065, "o", "   208\t            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n   209\t            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n   210\t            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n   211\t            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\r\n   212\t"]
[1991.88512, "o", "            ctx->break_count = 0; ctx->cont_count = 0;\r\n   213\t            int body_old = c->local_count;\r\n   214\t            emit(c, BC_LOAD_LOCAL, arr_slot, NULL);\r\n   215\t            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n   216\t            emit(c, BC_INDEX, 0, NULL);\r\n   217\t            int var_slot = add_local(c, node->data.foreach_stmt.var);\r\n   218\t            emit(c, BC_STORE_LOCAL, var_slot, NULL);\r\n   219\t            compile_node(c, node->data.foreach_stmt.body);"]
[1991.885177, "o", "\r\n   220\t            int n = c->local_count - body_old;\r\n   221\t            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n   222\t            c->local_count = body_old;\r\n   223\t            int inc_start = c->code_count;\r\n   224\t            ctx->cont = inc_start;\r\n   225\t            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n   226\t            emit(c, BC_PUSH_INT, 1, NULL);\r\n"]
[1991.885263, "o", "   227\t            emit(c, BC_ADD, 0, NULL);\r\n   228\t            emit(c, BC_STORE_LOCAL, idx_slot, NULL);\r\n   229\t            emit(c, BC_JUMP, loop_start, NULL);\r\n   230\t            int end = c->code_count;\r\n   231\t            c->code[jf].operand = end;\r\n   232\t            ctx->end = end;\r\n   233\t            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;\r\n   234\t            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = inc_start;\r\n   235\t            loop_depth--;\r\n"]
