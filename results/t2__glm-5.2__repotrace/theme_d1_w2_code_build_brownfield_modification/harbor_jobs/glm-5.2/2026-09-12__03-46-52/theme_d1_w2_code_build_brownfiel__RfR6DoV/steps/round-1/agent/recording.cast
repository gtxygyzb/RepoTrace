[7692.323018, "o", "            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);\r\n            else emit(c, BC_NOT, 0, NULL);\r\n            break;\r\n        case NODE_CALL: {\r\n            const char *name = node->data.call.name;\r\n            if (strcmp(name, \"len\") == 0) {\r\n                if (node->data.call.args.count != 1) { error_at(node->line, \"len() expects 1 argument\"); return -1; }\r\n                compile_expr(c, node->data.call.args.items[0]);\r\n                emit(c, BC_ARRAY_LEN, 0, NULL);\r\n"]
[7692.323148, "o", "                break;\r\n            }\r\n            if (strcmp(name, \"keys\") == 0) {\r\n                if (node->data.call.args.count != 1) { error_at(node->line, \"keys() expects 1 argument\"); return -1; }\r\n                compile_expr(c, node->data.call.args.items[0]);\r\n                emit(c, BC_MAP_KEYS, 0, NULL);\r\n                break;\r\n            }\r\n            if (strcmp(name, \"delete\") == 0) {\r\n                if (node->data.call.args.count != 2) { error_at(node->line, \"delete() expects 2 arguments\"); return -1; }\r\n                compile_expr(c, node->data.call.args.items[0]);\r\n                compile_expr(c, node->data.call.args.items[1]);\r\n                emit(c, BC_MAP_DELETE, 0, NULL);\r\n                break;\r\n            }\r\n            if (strcmp(name, \"has\") == 0) {\r\n                if (node->data.call.args.count != 2) { error_at(node->line, \"has() expects 2 arguments\"); return -1; }\r\n                compile_expr(c, node->data.call.args.items[0]);\r\n                compile_expr(c, node->data.call"]
[7692.323281, "o", ".args.items[1]);\r\n                emit(c, BC_MAP_HAS, 0, NULL);\r\n                break;\r\n            }\r\n            int fi = find_function(c, name);\r\n            if (fi >= 0) {\r\n                for (int i = 0; i < node->data.call.args.count; i++)\r\n                    compile_expr(c, node->data.call.args.items[i]);\r\n                emit(c, BC_CALL, fi, NULL);\r\n            } else {\r\n                for (int i = 0; i < node->data.call.args.count; i++)\r\n                    compile_expr(c, node->data.call.args.items[i]);\r\n                compile_load(c, name);\r\n                emit(c, BC_CALL_VALUE, node->data.call.args.count, NULL);\r\n            }\r\n            break;\r\n        }\r\n        case NODE_CLOSURE: {\r\n            char bound_names[MAX_LOCALS][MAX_IDENT_LEN]; int bound_count = 0;\r\n            for (int i = 0; i < node->data.closure.param_count; i++)\r\n                add_name(bound_names, &bound_count, node->data.closure.params[i]);\r\n            collect_bound_names(node->data.closure.body, bound_names, &bound_"]
[7692.323358, "o", "count);\r\n            char free_names[MAX_LOCALS][MAX_IDENT_LEN]; int free_count = 0;\r\n            collect_free_names(node->data.closure.body, bound_names, bound_count, free_names, &free_count);\r\n\r\n            char cap_names[MAX_LOCALS][MAX_IDENT_LEN]; int cap_count = 0;\r\n            int cap_slots[MAX_LOCALS];\r\n            for (int i = 0; i < free_count; i++) {\r\n                const char *nm = free_names[i];\r\n                int slot = resolve_local(c, nm);\r\n                if (slot >= 0) {\r\n                    add_name(cap_names, &cap_count, nm);\r\n                    cap_slots[cap_count - 1] = slot;\r\n                    c->locals[slot].is_boxed = 1;\r\n                } else {\r\n                    int cap = resolve_capture(c, nm);\r\n                    if (cap >= 0) {\r\n                        add_name(cap_names, &cap_count, nm);\r\n                        cap_slots[cap_count - 1] = -1 - cap;\r\n                    }\r\n                }\r\n            }\r\n\r\n"]
[7692.323429, "o", "            if (c->func_count >= MAX_FUNCTIONS) { fprintf(stderr, \"too many functions\\n\"); return -1; }\r\n            FuncInfo *fi = &c->functions[c->func_count];\r\n            snprintf(fi->name, MAX_IDENT_LEN, \"__closure_%d\", c->func_count);\r\n            fi->param_count = node->data.closure.param_count;\r\n            fi->capture_count = cap_count;\r\n            for (int i = 0; i < cap_count; i++) fi->capture_slots[i] = cap_slots[i];\r\n            int func_idx = c->func_count++;\r\n\r\n            for (int i = 0; i < cap_count; i++) {\r\n                if (cap_slots[i] >= 0) {\r\n                    emit(c, BC_BOX_LOCAL, cap_slots[i], NULL);\r\n                    emit(c, BC_LOAD_LOCAL, cap_slots[i], NULL);\r\n                } else {\r\n                    emit(c, BC_LOAD_CAPTURE_CELL, -1 - cap_slots[i], NULL);\r\n                }"]
[7692.323496, "o", "\r\n            }\r\n            emit(c, BC_MAKE_CLOSURE, func_idx, NULL);\r\n            int jump_over = emit(c, BC_JUMP, 0, NULL);\r\n\r\n            fi->addr = c->code_count;\r\n\r\n            int old_lc = c->local_count;\r\n            int old_scope = c->scope_depth;\r\n            int old_inf = c->in_function;\r\n            int old_loop_depth = loop_depth;\r\n            int old_cap_count = c->capture_count;\r\n"]
[7692.323563, "o", "            CaptureInfo old_captures[MAX_LOCALS];\r\n            memcpy(old_captures, c->captures, sizeof(old_captures));\r\n            Local old_locals[MAX_LOCALS];\r\n            memcpy(old_locals, c->locals, sizeof(old_locals));\r\n            loop_depth = 0;\r\n            c->local_count = 0;\r\n            c->scope_depth = 0;\r\n            c->in_function = 1;\r\n            c->scope_depth++;\r\n            c->capture_count = cap_count;\r\n            for (int i = 0; i < cap_count; i++) {\r\n                strncpy(c->captures[i].name, cap_names[i], MAX_IDENT_LEN - 1);\r\n                c->captures[i].name[MAX_IDENT_LEN - 1] = '\\0';\r\n"]
[7692.323622, "o", "            }\r\n\r\n            for (int i = 0; i < node->data.closure.param_count; i++)\r\n                add_local(c, node->data.closure.params[i]);\r\n\r\n            compile_node(c, node->data.closure.body);\r\n            emit(c, BC_PUSH_INT, 0, NULL);\r\n            emit(c, BC_RET, 0, NULL);\r\n\r\n            c->scope_depth = old_scope;\r\n            c->local_count = old_lc;\r\n"]
[7692.323707, "o", "            c->in_function = old_inf;\r\n            loop_depth = old_loop_depth;\r\n            c->capture_count = old_cap_count;\r\n            memcpy(c->captures, old_captures, sizeof(old_captures));\r\n            memcpy(c->locals, old_locals, sizeof(old_locals));\r\n            memcpy(c->captures, old_captures, sizeof(old_captures));\r\n            memcpy(c->locals, old_locals, sizeof(old_locals));\r\n\r\n            c->code[jump_over].operand = c->code_count;\r\n            break;\r\n        }\r\n        case NODE_INDEX:\r\n            compile_expr(c, node->data.index_access.obj);\r\n            compile_expr(c, node->data.index_access.index);\r\n            emit(c, BC_INDEX, 0, NULL); break;\r\n        case NODE_ARRAY_LIT:\r\n            for (int i = 0; i < node->data.array_lit.elems.count; i++)\r\n                compile_expr(c, node->data.array_lit.elems.items[i]);"]
[7692.323772, "o", "\r\n            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;\r\n        case NODE_MAP_LIT: {\r\n            int count = node->data.map_lit.keys.count;\r\n            for (int i = 0; i < count; i++) {\r\n                compile_expr(c, node->data.map_lit.keys.items[i]);\r\n                compile_expr(c, node->data.map_lit.values.items[i]);\r\n            }\r\n            emit(c, BC_PUSH_MAP, count, NULL); break;\r\n        }\r\n        case NODE_FIELD_ACCESS:\r\n"]
[7692.323838, "o", "            compile_expr(c, node->data.field_access.obj);\r\n            emit(c, BC_PUSH_STR, 0, strdup(node->data.field_access.field));\r\n            emit(c, BC_MAP_GET, 0, NULL); break;\r\n        default:\r\n            error_at(node->line, \"cannot compile expression of type %d\", node->type); return -1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int compile_node(Compiler *c, ASTNode *node) {\r\n    switch (node->type) {\r\n        case NODE_LET: {\r\n            int slot = add_local(c, node->data.let.name);\r\n            if (slot < 0) return -1;\r\n"]
