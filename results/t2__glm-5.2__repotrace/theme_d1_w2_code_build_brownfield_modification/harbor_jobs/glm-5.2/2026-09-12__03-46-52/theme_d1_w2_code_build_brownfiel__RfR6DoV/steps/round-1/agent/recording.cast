[5922.067267, "i", "cat > /tmp/test_maps.mini <<'EOF'\nlet obj = {\"name\": \"Alice\", \"age\": 30};\nprint obj.name;\nprint obj[\"age\"];\nobj.age = 31;\nobj[\"score\"] = 95;\nprint obj.age;\nprint obj.score;\nlet k = keys(obj);\nprint len(k);\nprint k[0];\nprint has(obj, \"age\");\nprint has(obj, \"x\");\nprint delete(obj, \"age\");\nprint delete(obj, \"x\");\nprint len(keys(obj));\nfor (key in obj) {\n    print key + \": \" + obj[key];\n}\nif ({}) { print \"empty truthy\"; } else { print \"empty falsy\"; }\nif ({\"x\":1}) { print \"nonempty truthy\"; } else { print \"nonempty falsy\"; }\nlet data = {\"items\": [1,2,3], \"count\": 3};\nprint data.items[1];\nprint data.count;\nEOF\n./minicc /tmp/test_maps.mini\n"]
