[9697.633937, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/codegen.c')\ns = p.read_text()\nold = '''        case NODE_TRY:\n            collect_free_names(node->data.try_stmt.try_body, bound, bound_count, free_names, free_count);\n            if (!name_in_list(bound, bound_count, node->data.try_stmt.catch_var)) add_name(free_names, free_count, node->data.try_stmt.catch_var);\n            collect_free_names(node->data.try_stmt.catch_body, bound, bound_count, free_names, free_count);\n            break;\n'''\nnew = '''        case NODE_TRY: {\n            collect_free_names(node->data.try_stmt.try_body, bound, bound_count, free_names, free_count);\n            char try_bound[MAX_LOCALS][MAX_IDENT_LEN];\n            int try_bound_count = bound_count;\n            for (int i = 0; i < bound_count; i++) strcpy(try_bound[i], bound[i]);\n            add_name(try_bound, &try_bound_count, node->data.try_stmt.catch_var);\n            collect_free_names(node->data.try_stmt.catch_body, try_bound, try_bound_count, free_names, free_count);\n"]
[9697.634326, "i", "            break;\n        }\n'''\nif old not in s:\n    raise SystemExit('NODE_TRY free names pattern not found')\ns = s.replace(old, new, 1)\np.write_text(s)\nprint('patched NODE_TRY capture analysis')\nPY\n"]
