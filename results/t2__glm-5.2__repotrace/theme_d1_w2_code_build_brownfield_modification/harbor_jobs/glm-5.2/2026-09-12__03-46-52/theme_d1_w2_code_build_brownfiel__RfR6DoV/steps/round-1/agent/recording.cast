[9826.338987, "o", ".field[MAX_IDENT_LEN - 1] = '\\0';\r\n   143\t                expr = n;\r\n   144\t            }\r\n   145\t        } else if (match(p, TOK_LBRACKET)) {\r\n   146\t            int line = prev(p)->line;\r\n   147\t            ASTNode *idx = parse_expr(p);\r\n   148\t            expect(p, TOK_RBRACKET, \"']'\");\r\n   149\t            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;\r\n   150\t            n->data.index_access.obj = expr;\r\n   151\t            n->data.index_access.index = idx;\r\n   152\t            expr = n;\r\n   153\t        } else {\r\n   154\t            break;\r\n   155\t        }\r\n   156\t    }\r\n   157\t    return expr;\r\n   158\t}\r\n   159\t\r\n   160\tstatic ASTNode *parse_unary(Parser *p) {\r\n   161\t    if (match(p, TOK_MINUS)) {\r\n   162\t        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n   163\t        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n"]
