[1930.839091, "o", "            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;\r\n   115\t            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;\r\n   116\t            default: op = OP_EQ; break;\r\n   117\t        }\r\n   118\t        ASTNode *right = parse_term(p);\r\n   119\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   120\t"]
