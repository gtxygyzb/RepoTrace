[3389.964849, "o", "   165\t                FuncInfo *func = &vm->functions[fi];\r\n   166\t                if (vm->frame_count >= MAX_CALL_FRAMES) { fprintf(stderr, \"call stack overflow\\n\"); return -1; }\r\n   167\t                CallFrame *frame = &vm->frames[vm->frame_count++];\r\n   168\t                frame->ip = vm->ip;\r\n   169\t                frame->bp = vm->sp;\r\n   170\t                /* BUG: the callee's local base does not properly account for\r\n   171\t                   intermediate return values that earlier nested-call arguments\r\n   172"]
[3389.964969, "o", "\t                   left on the stack. For multi-argument calls that are preceded\r\n   173\t                   by such temporaries the base is mis-computed (off by one),\r\n   174\t                   so nested calls used as arguments (e.g. add(double(3), triple(2)))\r\n   175\t                   read the wrong stack slots and produce wrong results. */\r\n   176\t                frame->local_start = vm->sp - func->param_count;\r\n   177\t                vm->ip = func->addr;\r\n   178\t                break;\r\n   179\t            }\r\n   180\t            case BC_RET: {\r\n   181\t                Value retval = pop(vm);\r\n   182\t                if (vm->frame_count <= 0) { fprintf(stderr, \"return outside function\\n\"); return -1; }\r\n   183\t                CallFrame *frame = &vm->frames[--vm->frame_count];\r\n   184\t                vm->sp = frame->local_start;\r\n   185\t                vm->ip = frame->ip;\r\n   186\t                push(vm, retval);\r\n   187\t                break;\r\n   188\t            }\r\n"]
[3389.965053, "o", "   189\t            case BC_PRINT: { Value v = pop(vm); print_value(v); printf(\"\\n\"); break; }\r\n   190\t            case BC_POP: pop(vm); break;\r\n   191\t            case BC_PUSH_ARRAY: {\r\n   192\t                int count = (int)ins->operand;\r\n   193\t                Value arr; arr.type = VAL_ARRAY;\r\n   194\t                arr.data.array.len = count;\r\n   195\t                arr.data.array.items = malloc(count * sizeof(Value));\r\n   196\t                for (int i = count - 1; i >= 0; i--) arr.data.array.items[i] = pop(vm);\r\n   197\t                push(vm, arr); break;\r\n   198\t            }\r\n   199\t            case BC_INDEX: {\r\n"]
[3389.965118, "o", "   200\t                Value idx = pop(vm); Value obj = pop(vm);\r\n   201\t                if (obj.type != VAL_ARRAY) { fprintf(stderr, \"cannot index non-array\\n\"); return -1; }\r\n   202\t                int i = (int)value_to_int(idx);\r\n   203\t                if (i < 0 || i >= obj.data.array.len) { fprintf(stderr, \"index out of bounds: %d\\n\", i); return -1; }\r\n   204\t                push(vm, obj.data.array.items[i]); break;\r\n   205\t            }\r\n   206\t            case BC_ARRAY_LEN: {\r\n"]
[3389.965191, "o", "   207\t                Value arr = pop(vm);\r\n   208\t                if (arr.type != VAL_ARRAY) { push(vm, make_int(0)); }\r\n   209\t                else { push(vm, make_int(arr.data.array.len)); }\r\n   210\t                break;\r\n   211\t            }\r\n   212"]
[3389.965301, "o", "\t            case BC_ARRAY_GET: {\r\n   213\t                Value idx = pop(vm); Value arr = pop(vm);\r\n   214\t                if (arr.type != VAL_ARRAY) { fprintf(stderr, \"cannot index non-array\\n\"); return -1; }\r\n   215\t                int i = (int)value_to_int(idx);\r\n   216\t                if (i < 0 || i >= arr.data.array.len) { fprintf(stderr, \"index out of bounds: %d\\n\", i); return -1; }\r\n   217\t                push(vm, arr.data.array.items[i]); break;\r\n   218\t            }\r\n   219\t            case BC_HALT: return 0;\r\n   220\t            default: fprintf(stderr, \"unknown opcode %d\\n\", ins->op); return -1;\r\n   221\t        }\r\n   222\t    }\r\n   223\t    return 0;\r\n   224\t}\r\n"]
