[7702.638191, "o", "            int old_loop_depth = loop_depth;\r\n            int old_cap_count = c->capture_count;\r\n            CaptureInfo old_captures[MAX_LOCALS];\r\n            memcpy(old_captures, c->captures, sizeof(old_captures));\r\n            Local old_locals[MAX_LOCALS];\r\n            memcpy(old_locals, c->locals, sizeof(old_locals));\r\n            loop_depth = 0;\r\n            c->local_count = 0;\r\n            c->scope_depth = 0;\r\n            c->in_function = 1;\r\n            c->scope_depth++;\r\n"]
[7702.638296, "o", "            c->capture_count = cap_count;\r\n            for (int i = 0; i < cap_count; i++) {\r\n                strncpy(c->captures[i].name, cap_names[i], MAX_IDENT_LEN - 1);\r\n                c->captures[i].name[MAX_IDENT_LEN - 1] = '\\0';\r\n            }\r\n\r\n            for (int i = 0; i < node->data.closure.param_count; i++)\r\n                add_local(c, node->data.closure.params[i]);\r\n\r\n            compile_node(c, node->data.closure.body);\r\n            emit(c, BC_PUSH_INT, 0, NULL);\r\n            emit(c, BC_RET, 0, NULL);\r\n\r\n            c->scope_depth = old_scope;\r\n            c->local_count = old_lc;\r\n            c->in_function = old_inf;\r\n            loop_depth = old_loop_depth;\r\n            c->capture_count = old_cap_count;\r\n            memcpy(c->captures, old_captures, sizeof(old_captures));\r\n"]
[7702.638356, "o", "            memcpy(c->locals, old_locals, sizeof(old_locals));\r\n            memcpy(c->captures, old_captures, sizeof(old_captures));\r\n            memcpy(c->locals, old_locals, sizeof(old_locals));\r\n\r\n            c->code[jump_over].operand = c->code_count;\r\n            break;\r\n        }\r\n        case NODE_INDEX:\r\n            compile_expr(c, node->data.index_access.obj);\r\n            compile_expr(c, node->data.index_access.index);\r\n            emit(c, BC_INDEX, 0, NULL); break;\r\n        case NODE_ARRAY_LIT:\r\n            for (int i = 0; i < node->data.array_lit.elems.count; i++)\r\n"]
