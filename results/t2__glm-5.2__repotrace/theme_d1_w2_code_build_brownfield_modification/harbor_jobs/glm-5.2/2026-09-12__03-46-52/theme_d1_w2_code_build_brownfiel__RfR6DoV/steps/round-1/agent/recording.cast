[1931.130462, "o", "\r\n   148\t}\r\n   149\t\r\n   150\tstatic ASTNode *parse_expr(Parser *p) {\r\n   151\t    ASTNode *left = parse_logic_and(p);\r\n   152\t    while (match(p, TOK_OR)) {\r\n   153\t        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);\r\n   154\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   155\t        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;\r\n   156\t        left = n;\r\n   157\t    }\r\n   158\t    return left;\r\n   159\t}\r\n   160\t\r\n   161\tstatic ASTNode *try_parse_assign(Parser *p) {\r\n   162\t    if (!check(p, TOK_IDENT)) return NULL;\r\n   163\t    int saved = p->pos;\r\n   164\t    p->pos++;\r\n   165\t    if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||\r\n   166\t        check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {\r\n   167\t        p->pos = saved; match(p, TOK_IDENT);\r\n   168\t        char name[MAX_IDENT_LEN];\r\n"]
