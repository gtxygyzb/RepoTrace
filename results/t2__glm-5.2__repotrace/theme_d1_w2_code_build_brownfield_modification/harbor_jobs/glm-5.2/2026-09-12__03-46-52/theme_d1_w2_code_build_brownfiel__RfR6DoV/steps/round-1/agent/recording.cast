[1182.849597, "o", "   107\t            compile_expr(c, node->data.let.init);\r\n   108\t            break;\r\n   109\t        }\r\n   110\t        case NODE_ASSIGN: {\r\n   111\t            compile_expr(c, node->data.assign.value);\r\n   112\t            compile_store(c, node->data.assign.name);\r\n   113\t            break;\r\n   114\t        }\r\n   115\t        case NODE_IF: {\r\n   116\t            compile_expr(c, node->data.if_stmt.cond);\r\n   117\t            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n   118\t            compile_node(c, node->data.if_stmt.then_b);\r\n   119\t            if (node->data.if_stmt.else_b) {\r\n   120\t                int je = emit(c, BC_JUMP, 0, NULL);\r\n   121\t                c->code[jf].operand = c->code_count;\r\n   122\t                compile_node(c, node->data.if_stmt.else_b);\r\n   123\t                c->code[je].operand = c->code_count;\r\n   124\t            } else {\r\n   125\t                c->code[jf].operand = c->code_count;\r\n   126\t            }\r\n   127\t            break;\r\n   128\t        }\r\n   129\t        case NODE_WHILE: {\r\n "]
[1182.849682, "o", "  130\t            int loop_start = c->code_count;\r\n   131\t            compile_expr(c, node->data.while_stmt.cond);\r\n   132\t            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n   133\t            compile_node(c, node->data.while_stmt.body);\r\n   134\t            emit(c, BC_JUMP, loop_start, NULL);\r\n   135\t            c->code[jf].operand = c->code_count;\r\n   136\t            break;\r\n   137\t        }\r\n   138\t        case NODE_RETURN: {\r\n   139\t            if (node->data.ret.value) compile_expr(c, node->data.ret.value);\r\n   140\t            else emit(c, BC_PUSH_INT, 0, NULL);\r\n   141\t            emit(c, BC_RET, 0, NULL);\r\n   142\t            break;\r\n   143\t        }\r\n   144\t        case NODE_PRINT: {\r\n   145\t            compile_expr(c, node->data.print.value);\r\n   146\t            emit(c, BC_PRINT, 0, NULL);\r\n"]
[1182.84975, "o", "   147\t            break;\r\n   148\t        }\r\n   149\t        case NODE_BLOCK: {\r\n   150\t            int old_lc = c->local_count;\r\n   151\t            c->scope_depth++;\r\n   152\t            for (int i = 0; i < node->data.block.stmts.count; i++)\r\n   153\t                compile_node(c, node->data.block.stmts.items[i]);\r\n   154\t            c->scope_depth--;\r\n   155\t            {\r\n   156\t                int n = c->local_count - old_lc;\r\n   157\t                for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n   158\t            }\r\n"]
