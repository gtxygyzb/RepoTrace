[7684.787104, "o", "\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        case \u001b[01;31m\u001b[KVAL_STR\u001b[m\u001b[K: return v.data.sval && v.data.sval[0] != '\\0';\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        case \u001b[01;31m\u001b[KVAL_STR\u001b[m\u001b[K: return \u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(a.data.sval, b.data.sval) == 0;\r\n"]
[7684.787159, "o", "\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        case \u001b[01;31m\u001b[KVAL_STR\u001b[m\u001b[K: return v.data.sval;\r\n\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (v.type == \u001b[01;31m\u001b[KVAL_STR\u001b[m\u001b[K) return v.data.sval;\r\n\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (a.type == \u001b[01;31m\u001b[KVAL_STR\u001b[m\u001b[K && b.type == \u001b[01;31m\u001b[KVAL_STR\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        return \u001b[01;31m\u001b[Kstrcmp\u001b[m\u001b[K(a.data.sval, b.data.sval);\r\n"]
