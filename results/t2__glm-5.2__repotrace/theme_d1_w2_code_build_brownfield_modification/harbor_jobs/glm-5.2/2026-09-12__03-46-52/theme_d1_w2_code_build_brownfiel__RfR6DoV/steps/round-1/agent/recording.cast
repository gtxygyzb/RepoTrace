[5394.629798, "o", "\u001b[32m\u001b[K205\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||\r\n\u001b[32m\u001b[K206\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {\r\n\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p->pos = saved; match(p, TOK_IDENT);\r\n\u001b[32m\u001b[K208\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        TokenType op_tok = current(p)->type;\r\n\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        BinOp op = OP_ADD;\r\n\u001b[32m\u001b[K210\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        const char *msg = \"'='\";\r\n\u001b[32m\u001b[K211\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = \"'+='\"; expect(p, TOK_PLUS_ASSIGN, \"'+='\"); }\r\n\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = \"'-='\"; expect(p, TOK_MINUS_ASSIGN, \"'-='\"); }\r\n\u001b[32m\u001b[K213\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = \"'*='\"; expect(p, TOK_STAR_ASSIGN, \"'*='\"); }\r\n\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        else if (op_tok ="]
[5394.629879, "o", "= TOK_SLASH_ASSIGN) { op = OP_DIV; msg = \"'/='\"; expect(p, TOK_SLASH_ASSIGN, \"'/='\"); }\r\n\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        else if (op_tok == TOK_PERCENT_ASSIGN) { op = OP_MOD; msg = \"'%='\"; expect(p, TOK_PERCENT_ASSIGN, \"'%='\"); }\r\n\u001b[32m\u001b[K216\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        else { expect(p, TOK_ASSIGN, \"'='\"); }\r\n\u001b[32m\u001b[K217\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *val = parse_expr(p);\r\n\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (op_tok == TOK_ASSIGN) {\r\n\u001b[32m\u001b[K219\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;\r\n\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);\r\n\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            n->data.assign.value = val; return n;\r\n\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        } else {\r\n\u001b[32m\u001b[K223\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            ASTNode *n = ast_alloc(); n->type = NODE_COMPOUND_ASSIGN; n->line = line;\r\n\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            strncpy(n->data.compound_assign.name, name, MAX_IDENT_LEN -"]
[5394.629949, "o", " 1);\r\n\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            n->data.compound_assign.op = op;\r\n\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            n->data.compound_assign.value = val; return n;\r\n\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p->pos = saved; return NULL;\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic ASTNode *parse_for(Parser *p) {\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int line = prev(p)->line;\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_LPAREN, \"'('\");\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (check(p, TOK_IDENT) && p->pos + 1 < p->count &&\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        (p->tokens[p->pos + 1].type == TOK_IN || p->tokens[p->pos + 1].type == TOK_OF)) {\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        char name[MAX_IDENT_LEN];\r\n\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = "]
[5394.630017, "o", "'\\0';\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        match(p, TOK_IDENT);\r\n\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int is_of = match(p, TOK_OF);\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (!is_of) match(p, TOK_IN);\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *arr = parse_expr(p);\r\n\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_RPAREN, \"')'\");\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *body = parse_block(p);\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;\r\n\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);\r\n\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.foreach_stmt.arr = arr;\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.foreach_stmt.body = body;\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.foreach_stmt.is_of = is_of;\r\n"]
