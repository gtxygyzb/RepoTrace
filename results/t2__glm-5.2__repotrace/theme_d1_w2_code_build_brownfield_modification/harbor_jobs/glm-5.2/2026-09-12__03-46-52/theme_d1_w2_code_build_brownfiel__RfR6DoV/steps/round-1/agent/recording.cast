[9925.522155, "o", "#include \"codegen.h\"\r\n\r\nstatic int emit(Compiler *c, Opcode op, int64_t operand, char *str_op) {\r\n    if (c->code_count >= MAX_BYTECODE) { fprintf(stderr, \"bytecode overflow\\n\"); return -1; }\r\n    Instruction *ins = &c->code[c->code_count];\r\n    ins->op = op; ins->operand = operand; ins->str_operand = str_op;\r\n    return c->code_count++;\r\n}\r\n"]
[9925.522277, "o", "\r\nstatic int resolve_local(Compiler *c, const char *name) {\r\n    for (int i = c->local_count - 1; i >= 0; i--) {\r\n        if (strcmp(c->locals[i].name, name) == 0) return i;\r\n    }\r\n    return -1;\r\n}\r\n\r\nstatic int resolve_capture(Compiler *c, const char *name) {\r\n    for (int i = 0; i < c->capture_count; i++)\r\n        if (strcmp(c->captures[i].name, name) == 0) return i;\r\n    return -1;\r\n}\r\n\r\nstatic int add_local(Compiler *c, const char *name) {\r\n    if (c->local_count >= MAX_LOCALS) { fprintf(stderr, \"too many local variables\\n\"); return -1; }\r\n    Local *local = &c->locals[c->local_count];\r\n    strncpy(local->name, name, MAX_IDENT_LEN - 1); local->name[MAX_IDENT_LEN - 1] = '\\0';\r\n"]
[9925.522463, "o", "    local->scope_depth = c->scope_depth;\r\n    local->is_boxed = 0;\r\n    return c->local_count++;\r\n}\r\n\r\nstatic int find_function(Compiler *c, const char *name) {\r\n    for (int i = 0; i < c->func_count; i++) {\r\n        if (strcmp(c->functions[i].name, name) == 0) return i;\r\n    }\r\n    return -1;\r\n}\r\n\r\nstatic int is_builtin(const char *name) {\r\n    return strcmp(name, \"len\") == 0 || strcmp(name, \"keys\") == 0 ||\r\n           strcmp(name, \"delete\") == 0 || strcmp(name, \"has\") == 0;\r\n}\r\n\r\nstatic void compile_store(Compiler *c, const char *name) {\r\n    int slot = resolve_local(c, name);\r\n"]
[9925.52263, "o", "    if (slot >= 0) {\r\n        if (c->locals[slot].is_boxed) emit(c, BC_STORE_BOX_LOCAL, slot, NULL);\r\n        else emit(c, BC_STORE_LOCAL, slot, NULL);\r\n        return;\r\n    }\r\n    int cap = resolve_capture(c, name);\r\n    if (cap >= 0) { emit(c, BC_STORE_CAPTURE, cap, NULL); return; }\r\n    emit(c, BC_STORE_GLOBAL, 0, strdup(name));\r\n}\r\n\r\nstatic void compile_load(Compiler *c, const char *name) {\r\n    int slot = resolve_local(c, name);\r\n    if (slot >= 0) {\r\n        if (c->locals[slot].is_boxed) emit(c, BC_LOAD_BOX_LOCAL, slot, NULL);\r\n        else emit(c, BC_LOAD_LOCAL, slot, NULL);\r\n        return;\r\n    }\r\n    int cap = resolve_capture(c, name);\r\n    if (cap >= 0) { emit(c, BC_LOAD_CAPTURE, cap, NULL); return; }\r\n    emit(c, BC_LOAD_GLOBAL, 0, strdup(name));\r\n}\r\n\r\nstatic int name_in_list(char list[][MAX_IDENT_LEN], int count, const char *name) {\r\n    for (int i = 0; i < count; i++) if (strcmp(list[i], name) == 0) return 1;\r\n    return 0;\r\n}\r\nstatic void add_name(char list[][MAX_IDENT_LEN], int *count, const c"]
[9925.522716, "o", "har *name) {\r\n    if (!name_in_list(list, *count, name)) {\r\n        strncpy(list[*count], name, MAX_IDENT_LEN - 1);\r\n        list[*count][MAX_IDENT_LEN - 1] = '\\0';\r\n        (*count)++;\r\n    }\r\n}\r\nstatic void collect_bound_names(ASTNode *node, char names[][MAX_IDENT_LEN], int *count) {\r\n    if (!node) return;\r\n"]
