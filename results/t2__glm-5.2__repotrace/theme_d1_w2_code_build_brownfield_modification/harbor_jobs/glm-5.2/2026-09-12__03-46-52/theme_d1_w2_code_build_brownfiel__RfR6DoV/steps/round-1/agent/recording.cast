[4251.814804, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/parser.c')\nlines = p.read_text().splitlines()\nfor i, l in enumerate(lines):\n    if l.strip() == 'match(p, TOK_IN);' and i > 0 and 'match(p, TOK_IDENT);' in lines[i-1]:\n        lines[i] = '        int is_of = match(p, TOK_OF);'\n        lines.insert(i+1, '        if (!is_of) match(p, TOK_IN);')\n        break\nfor i, l in enumerate(lines):\n    if l.strip() == 'return n;' and i > 0 and 'n->data.foreach_stmt.body = body;' in lines[i-1]:\n        lines.insert(i, '        n->data.foreach_stmt.is_of = is_of;')\n        break\np.write_text('\\n'.join(lines) + '\\n')\nPY\n"]
