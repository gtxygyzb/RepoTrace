[1923.935256, "o", "   119\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   120\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   121\t        left = n;\r\n   122\t    }\r\n   123\t    return left;\r\n   124\t}\r\n   125\t\r\n   126\tstatic ASTNode *parse_term(Parser *p) {\r\n   127\t    ASTNode *left = parse_factor(p);\r\n   128\t    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {\r\n   129\t        int line = prev(p)->line;\r\n   130\t        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;\r\n   131\t        ASTNode *right = parse_factor(p);\r\n"]
