[331.785037, "o", "     7\t    return c->code_count++;\r\n     8\t}\r\n     9\t\r\n    10\tstatic int resolve_local(Compiler *c, const char *name) {\r\n    11\t    for (int i = c->local_count - 1; i >= 0; i--) {\r\n    12\t        if (strcmp(c->locals[i].name, name) == 0) return i;\r\n    13\t    }\r\n    14\t    return -1;\r\n    15\t}\r\n    16\t\r\n    17\tstatic int add_local(Compiler *c, const char *name) {\r\n    18\t    if (c->local_count >= MAX_LOCALS) { fprintf(stderr, \"too many local variables\\n\"); return -1; }\r\n    19\t    Local *local = &c->locals[c->local_count];\r\n    20\t    strncpy(local->name, name, MAX_IDENT_LEN - 1); local->name[MAX_IDENT_LEN - 1] = '\\0';\r\n    21\t    local->scope_depth = c->scope_depth;\r\n    22\t    return c->local_count++;\r\n    23\t}\r\n    24\t\r\n    25\tstatic int find_function(Compiler *c, const char *name) {\r\n    26\t    for (int i = 0; i < c->func_count; i++) {\r\n"]
[331.785138, "o", "    27\t        if (strcmp(c->functions[i].name, name) == 0) return i;\r\n    28\t    }\r\n    29\t    return -1;\r\n    30\t}\r\n    31\t\r\n    32\tstatic void compile_store(Compiler *c, const char *name) {\r\n    33\t    int slot = resolve_local(c, name);\r\n    34\t    if (slot >= 0) emit(c, BC_STORE_LOCAL, slot, NULL);\r\n    35\t    else emit(c, BC_STORE_GLOBAL, 0, strdup(name));\r\n    36\t}\r\n    37\t\r\n    38\tstatic int compile_node(Compiler *c, ASTNode *node);\r\n    39\t\r\n    40\tstatic int compile_expr(Compiler *c, ASTNode *node) {\r\n    41\t    switch (node->type) {\r\n"]
[331.785287, "o", "    42\t        case NODE_NUM_LIT:\r\n    43\t            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;\r\n    44\t        case NODE_STR_LIT: {\r\n    45\t            char *s = strdup(node->data.str_val);\r\n    46\t            emit(c, BC_PUSH_STR, 0, s); break;\r\n    47\t        }\r\n    48\t        case NODE_BOOL_LIT:\r\n    49\t            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;\r\n    50\t        case NODE_IDENT: {\r\n    51\t            int slot = resolve_local(c, node->data.ident);\r\n    52\t            if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);\r\n    53\t            else emit(c, BC_LOAD_GLOBAL, 0, strdup(node->data.ident));\r\n    54\t            break;\r\n    55\t        }\r\n    56\t        case NODE_BINOP:\r\n    57\t            compile_expr(c, node->data.binop.left);\r\n    58\t            compile_expr(c, node->data.binop.right);\r\n    59\t            switch (node->data.binop.op) {\r\n    60\t                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;\r\n"]
[331.785374, "o", "    61\t                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;\r\n    62\t                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;\r\n    63\t                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;\r\n    64\t                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;\r\n    65\t                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;\r\n    66\t                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;\r\n    67"]
[331.785445, "o", "\t                case OP_LT:  emit(c, BC_LT, 0, NULL); break;\r\n    68\t                case OP_GT:  emit(c, BC_GT, 0, NULL); break;\r\n    69\t                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;\r\n    70\t                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;\r\n    71\t                case OP_AND: emit(c, BC_AND, 0, NULL); break;\r\n    72\t                case OP_OR:  emit(c, BC_OR, 0, NULL); break;\r\n    73\t            }\r\n    74\t            break;\r\n    75\t        case NODE_UNARY:\r\n    76\t            compile_expr(c, node->data.unary.operand);\r\n    77\t            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);\r\n    78\t            else emit(c, BC_NOT, 0, NULL);\r\n    79\t            break;\r\n    80\t        case NODE_CALL: {\r\n    81\t            int fi = find_function(c, node->data.call.name);\r\n"]
