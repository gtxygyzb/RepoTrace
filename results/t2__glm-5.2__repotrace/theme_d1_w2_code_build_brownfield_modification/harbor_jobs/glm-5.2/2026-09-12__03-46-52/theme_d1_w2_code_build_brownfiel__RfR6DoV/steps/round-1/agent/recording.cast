[8184.735245, "o", "#ifndef MINICC_AST_H\r\n#define MINICC_AST_H\r\n\r\n#include \"common.h\"\r\n\r\nASTNode *ast_alloc(void);\r\nvoid ast_free_all(void);\r\n"]
[8184.735281, "o", "void nodelist_init(NodeList *list);\r\nvoid nodelist_push(NodeList *list, ASTNode *node);\r\n\r\n#endif\r\n"]
[8184.735883, "o", "\u001b[?2004h"]
