[7692.638681, "o", "                break;\r\n            }\r\n            case BC_CALL_VALUE: {\r\n                Value callee = pop(vm);\r\n                int fi = -1;\r\n                if (callee.type == VAL_CLOSURE) fi = callee.data.closure.func_idx;\r\n                if (fi < 0) { fprintf(stderr, \"cannot call non-function value\\n\"); return -1; }\r\n                FuncInfo *func = &vm->functions[fi];\r\n                if (vm->frame_count >= MAX_CALL_FRAMES) { fprintf(stderr, \"call stack overflow\\n\"); return -1; }\r\n                CallFrame *frame = &vm->frames[vm->frame_count++];\r\n                frame->ip = vm->ip;\r\n                frame->bp = vm->sp;\r\n                frame->local_start = vm->sp - func->param_count;\r\n                if (callee.type == VAL_CLOSURE) {\r\n                    frame->captures = callee.data.closure.captures;\r\n                    frame->capture_count = callee.data.closure.capture_count;\r\n                } else {\r\n                    frame->captures = NULL;\r\n                    frame->capture_count = 0;\r\n     "]
[7692.638752, "o", "           }\r\n                vm->ip = func->addr;\r\n                break;\r\n            }\r\n            case BC_CALL: {\r\n                int fi = (int)ins->operand;\r\n                FuncInfo *func = &vm->functions[fi];\r\n                if (vm->frame_count >= MAX_CALL_FRAMES) { fprintf(stderr, \"call stack overflow\\n\"); return -1; }\r\n                CallFrame *frame = &vm->frames[vm->frame_count++];\r\n                frame->ip = vm->ip;\r\n                frame->bp = vm->sp;\r\n                frame->captures = NULL;\r\n                frame->capture_count = 0;\r\n                /* BUG: the callee's local base does not properly account for\r\n                   intermediate return values that earlier nested-call arguments\r\n                   left on the stack. For multi-argument calls that are preceded\r\n                   by such temporaries the base is mis-computed (off by one),\r\n"]
[7692.638807, "o", "                   so nested calls used as arguments (e.g. add(double(3), triple(2)))\r\n                   read the wrong stack slots and produce wrong results. */\r\n                frame->local_start = vm->sp - func->param_count;\r\n                vm->ip = func->addr;\r\n                break;\r\n            }\r\n            case BC_RET: {\r\n                Value retval = pop(vm);\r\n                if (vm->frame_count <= 0) { fprintf(stderr, \"return outside function\\n\"); return -1; }\r\n                CallFrame *frame = &vm->frames[--vm->frame_count];\r\n                vm->sp = frame->local_start;\r\n"]
[7692.638864, "o", "                vm->ip = frame->ip;\r\n                push(vm, retval);\r\n                break;\r\n            }\r\n            case BC_PRINT: { Value v = pop(vm); print_value(v); printf(\"\\n\"); break; }\r\n            case BC_POP: pop(vm); break;\r\n            case BC_PUSH_ARRAY: {\r\n                int count = (int)ins->operand;\r\n                Value arr; arr.type = VAL_ARRAY;\r\n                arr.data.array.len = count;\r\n                arr.data.array.items = malloc(count * sizeof(Value));\r\n"]
[7692.638916, "o", "                for (int i = count - 1; i >= 0; i--) arr.data.array.items[i] = pop(vm);\r\n                push(vm, arr); break;\r\n            }\r\n            case BC_INDEX: {\r\n                Value idx = pop(vm); Value obj = pop(vm);\r\n                if (obj.type == VAL_MAP) {\r\n                    char buf[64]; const char *key = value_to_key(idx, buf, sizeof(buf));\r\n                    int i = map_find(obj.data.map, key);\r\n                    if (i < 0) { fprintf(stderr, \"key not found: %s\\n\", key); return -1; }\r\n                    push(vm, obj.data.map->values[i]);\r\n                } else if (obj.type == VAL_ARRAY) {\r\n                    int i = (int)value_to_int(idx);\r\n"]
[7692.638971, "o", "                    if (i < 0 || i >= obj.data.array.len) { fprintf(stderr, \"index out of bounds: %d\\n\", i); return -1; }\r\n                    push(vm, obj.data.array.items[i]);\r\n                } else { fprintf(stderr, \"cannot index non-array/map\\n\"); return -1; }\r\n                break;\r\n            }\r\n            case BC_ARRAY_LEN: {\r\n                Value arr = pop(vm);\r\n                if (arr.type == VAL_ARRAY) push(vm, make_int(arr.data.array.len));\r\n                else if (arr.type == VAL_MAP) push(vm, make_int(arr.data.map ? arr.data.map->len : 0));\r\n                else push(vm, make_int(0));\r\n                break;\r\n"]
[7692.63902, "o", "            }\r\n            case BC_ARRAY_GET: {\r\n                Value idx = pop(vm); Value arr = pop(vm);\r\n                if (arr.type == VAL_MAP) {\r\n                    char buf[64]; const char *key = value_to_key(idx, buf, sizeof(buf));\r\n                    int i = map_find(arr.data.map, key);\r\n                    if (i < 0) { fprintf(stderr, \"key not found: %s\\n\", key); return -1; }\r\n                    push(vm, arr.data.map->values[i]);\r\n                } else if (arr.type == VAL_ARRAY) {\r\n                    int i = (int)value_to_int(idx);\r\n"]
[7692.639071, "o", "                    if (i < 0 || i >= arr.data.array.len) { fprintf(stderr, \"index out of bounds: %d\\n\", i); return -1; }\r\n                    push(vm, arr.data.array.items[i]);\r\n                } else { fprintf(stderr, \"cannot index non-array/map\\n\"); return -1; }\r\n                break;\r\n            }"]
[7692.639119, "o", "\r\n            case BC_INDEX_STORE: {\r\n                Value val = pop(vm); Value idx = pop(vm); Value obj = pop(vm);\r\n                if (obj.type == VAL_MAP) {\r\n                    char buf[64]; const char *key = value_to_key(idx, buf, sizeof(buf));\r\n                    map_set(obj.data.map, key, val);\r\n                } else if (obj.type == VAL_ARRAY) {\r\n                    int i = (int)value_to_int(idx);\r\n                    if (i < 0 || i >= obj.data.array.len) { fprintf(stderr, \"index out of bounds: %d\\n\", i); return -1; }\r\n                    obj.data.array.items[i] = val;\r\n                } else { fprintf(stderr, \"cannot index assign non-array/map\\n\"); return -1; }\r\n                break;\r\n            }\r\n            case BC_PUSH_MAP: {\r\n                int count = (int)ins->operand;\r\n                Value mv = make_map();\r\n                for (int i = 0; i < count; i++) {\r\n"]
[7692.639166, "o", "                    Value val = pop(vm);\r\n                    Value keyv = pop(vm);\r\n                    char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));\r\n                    map_set(mv.data.map, key, val);\r\n                }\r\n                push(vm, mv); break;\r\n            }\r\n            case BC_MAP_GET: {\r\n                Value keyv = pop(vm); Value obj = pop(vm);\r\n"]
[7692.639215, "o", "                if (obj.type != VAL_MAP) { fprintf(stderr, \"cannot get field of non-map\\n\"); return -1; }\r\n"]
