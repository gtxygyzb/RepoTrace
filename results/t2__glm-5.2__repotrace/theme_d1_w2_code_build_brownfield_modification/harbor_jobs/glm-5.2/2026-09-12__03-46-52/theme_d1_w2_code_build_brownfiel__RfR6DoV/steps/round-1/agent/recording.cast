[9756.10205, "o", "#include <stdint.h>\r\n#include <ctype.h>\r\n\r\n#define MAX_IDENT_LEN 64\r\n#define MAX_STRING_LEN 1024\r\n#define MAX_TOKENS 4096\r\n#define MAX_LOCALS 256\r\n#define MAX_FUNCTIONS 128\r\n#define MAX_BYTECODE 16384\r\n#define MAX_STACK 1024\r\n#define MAX_CALL_FRAMES 64\r\n#define MAX_GLOBALS 256\r\n#define MAX_AST_NODES 8192\r\n#define MAX_PARAMS 16\r\n#define MAX_TRY_HANDLERS 64\r\n\r\ntypedef enum {\r\n    TOK_NUM, TOK_STRING, TOK_IDENT,\r\n    TOK_PLUS, TOK_MINUS, TOK_STAR, TOK_SLASH, TOK_PERCENT,\r\n    TOK_EQ, TOK_NEQ, TOK_LT, TOK_GT, TOK_LEQ, TOK_GEQ,\r\n    TOK_ASSIGN, TOK_AND, TOK_OR, TOK_NOT,\r\n"]
[9756.102138, "o", "    TOK_LPAREN, TOK_RPAREN, TOK_LBRACE, TOK_RBRACE,\r\n    TOK_LBRACKET, TOK_RBRACKET,\r\n    TOK_SEMICOLON, TOK_COMMA,\r\n    TOK_IF, TOK_ELSE, TOK_WHILE, TOK_FOR, TOK_RETURN,\r\n    TOK_BREAK, TOK_CONTINUE, TOK_IN, TOK_OF,\r\n    TOK_FN, TOK_LET, TOK_PRINT, TOK_TRUE, TOK_FALSE, TOK_THROW, TOK_TRY, TOK_CATCH,\r\n    TOK_DOT,\r\n    TOK_COLON,\r\n    TOK_PLUS_ASSIGN, TOK_MINUS_ASSIGN, TOK_STAR_ASSIGN, TOK_SLASH_ASSIGN, TOK_PERCENT_ASSIGN,\r\n    TOK_EOF, TOK_ERROR\r\n} TokenType;\r\n\r\ntypedef struct {\r\n    TokenType type;\r\n    char text[MAX_STRING_LEN];\r\n    int line;\r\n    int col;\r\n    union {\r\n        int64_t ival;\r\n        double fval;\r\n"]
[9756.102248, "o", "    } literal;\r\n} Token;\r\n\r\ntypedef enum {\r\n    NODE_NUM_LIT, NODE_STR_LIT, NODE_BOOL_LIT,\r\n    NODE_IDENT, NODE_BINOP, NODE_UNARY,\r\n    NODE_CALL, NODE_INDEX,\r\n    NODE_ASSIGN, NODE_LET,\r\n    NODE_IF, NODE_WHILE, NODE_FOR, NODE_FOREACH,\r\n    NODE_RETURN, NODE_BREAK, NODE_CONTINUE,\r\n    NODE_PRINT, NODE_BLOCK, NODE_FUNC,\r\n    NODE_ARRAY_LIT, NODE_MAP_LIT, NODE_FIELD_ACCESS, NODE_FIELD_ASSIGN,\r\n    NODE_EXPR_STMT,\r\n    NODE_COMPOUND_ASSIGN, NODE_INDEX_ASSIGN, NODE_CLOSURE, NODE_METHOD_CALL,\r\n    NODE_THROW, NODE_TRY\r\n} NodeType;\r\n\r\ntypedef enum {\r\n"]
[9756.102321, "o", "    OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_MOD,\r\n    OP_EQ, OP_NEQ, OP_LT, OP_GT, OP_LEQ, OP_GEQ,\r\n    OP_AND, OP_OR\r\n} BinOp;\r\n\r\ntypedef enum {\r\n    UNOP_NEG, UNOP_NOT\r\n} UnaryOp;\r\n\r\nstruct ASTNode;\r\n\r\ntypedef struct {\r\n    struct ASTNode **items;\r\n    int count;\r\n    int cap;\r\n"]
[9756.102406, "o", "} NodeList;\r\n\r\ntypedef struct ASTNode {\r\n    NodeType type;\r\n    int line;\r\n    union {\r\n        int64_t num_val;\r\n        char str_val[MAX_STRING_LEN];\r\n        int bool_val;\r\n        char ident[MAX_IDENT_LEN];\r\n        struct { BinOp op; struct ASTNode *left, *right; } binop;\r\n        struct { UnaryOp op; struct ASTNode *operand; } unary;\r\n        struct { char name[MAX_IDENT_LEN]; NodeList args; } call;\r\n        struct { struct ASTNode *obj; struct ASTNode *index; } index_access;\r\n        struct { char name[MAX_IDENT_LEN]; struct ASTNode *value; } assign;\r\n"]
[9756.102475, "o", "    struct { char name[MAX_IDENT_LEN]; BinOp op; struct ASTNode *value; } compound_assign;\r\n        struct { char name[MAX_IDENT_LEN]; struct ASTNode *obj; struct ASTNode *index; struct ASTNode *value; } index_assign;\r\n        struct { char name[MAX_IDENT_LEN]; struct ASTNode *init; } let;\r\n        struct { struct ASTNode *cond, *then_b, *else_b; } if_stmt;\r\n        struct { struct ASTNode *cond, *body; } while_stmt;\r\n    struct { struct ASTNode *init, *cond, *step, *body; } for_stmt;\r\n    struct { char var[MAX_IDENT_LEN]; struct ASTNode *arr; struct ASTNode *body; int is_of; } foreach_stmt;\r\n        struct { struct ASTNode *value; } ret;\r\n        struct { struct ASTNode *value; } print;\r\n        struct { NodeList stmts; } block;\r\n"]
[9756.102569, "o", "        struct { char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } closure;\r\n        struct { char name[MAX_IDENT_LEN]; char params[MAX_PARAMS][MAX_IDENT_LEN]; int param_count; struct ASTNode *body; } func;\r\n        struct { NodeList elems; } array_lit;\r\n        struct { NodeList keys; NodeList values; } map_lit;\r\n        struct { struct ASTNode *obj; char field[MAX_IDENT_LEN]; } field_access;\r\n        struct { struct ASTNode *obj; char field[MAX_IDENT_LEN]; struct ASTNode *value; } field_assign;\r\n        struct { struct ASTNode *obj; char method[MAX_IDENT_LEN]; NodeList args; } method_call;\r\n        struct { struct ASTNode *expr; } expr_stmt;\r\n        struct { struct ASTNode *expr; } throw;\r\n"]
[9756.102641, "o", "        struct { struct ASTNode *try_body; char catch_var[MAX_IDENT_LEN]; struct ASTNode *catch_body; } try_stmt;\r\n    } data;\r\n} ASTNode;\r\n\r\ntypedef enum {\r\n    BC_PUSH_INT, BC_PUSH_STR, BC_PUSH_BOOL,\r\n    BC_LOAD_LOCAL, BC_STORE_LOCAL,\r\n    BC_LOAD_GLOBAL, BC_STORE_GLOBAL,\r\n    BC_ADD, BC_SUB, BC_MUL, BC_DIV, BC_MOD,\r\n    BC_EQ, BC_NEQ, BC_LT, BC_GT, BC_LEQ, BC_GEQ,\r\n    BC_AND, BC_OR, BC_NOT, BC_NEG,\r\n    BC_JUMP, BC_JUMP_FALSE,\r\n    BC_CALL, BC_RET,\r\n    BC_PRINT, BC_POP,\r\n    BC_PUSH_ARRAY, BC_INDEX, BC_INDEX_STORE, BC_ARRAY_PUSH,\r\n    BC_DUP, BC_JUMP_TRUE,\r\n    BC_BOX_LOCAL, BC_LOAD_BOX_LOCAL, BC_STORE_BOX_LOCAL,\r\n    BC_MAKE_CLOSURE, BC_CALL_VALUE,\r\n    BC_LOAD_CAPTURE_CELL,\r\n    BC_LOAD_CAPTURE, BC_STORE_CAPTURE,\r\n    BC_HALT,\r\n    BC_ARRAY_LEN, BC_ARRAY_GET,\r\n"]
[9756.102714, "o", "    BC_PUSH_MAP, BC_MAP_GET, BC_STR_METHOD_CALL, BC_MAP_SET, BC_MAP_KEYS, BC_MAP_HAS, BC_MAP_DELETE, BC_MAP_LEN,\r\n    BC_ITER_KEY,\r\n    BC_BREAK, BC_CONTINUE,\r\n    BC_FOREACH_PREP, BC_FOREACH_NEXT,\r\n    BC_THROW, BC_PUSH_HANDLER, BC_POP_HANDLER\r\n} Opcode;\r\n\r\ntypedef enum {\r\n    VAL_INT, VAL_STR, VAL_BOOL, VAL_ARRAY, VAL_CLOSURE, VAL_MAP, VAL_NULL, VAL_REF\r\n} ValueType;\r\n\r\ntypedef struct ArrayData {\r\n    struct Value *items;\r\n    int len;\r\n    int cap;\r\n} ArrayData;\r\n\r\n"]
[9756.102789, "o", "typedef struct MapData {\r\n    char **keys;\r\n    struct Value *values;\r\n    int len;\r\n    int cap;\r\n} MapData;\r\n\r\ntypedef struct Value {\r\n    ValueType type;\r\n    union {\r\n        int64_t ival;\r\n        char *sval;\r\n        int bval;\r\n        ArrayData array;\r\n        MapData *map;\r\n        struct { int func_idx; struct Value **captures; int capture_count; } closure;\r\n"]
[9756.102857, "o", "        struct Value *ref;\r\n    } data;\r\n} Value;\r\n\r\ntypedef struct {\r\n    Opcode op;\r\n    int64_t operand;\r\n    char *str_operand;\r\n} Instruction;\r\n\r\ntypedef struct {\r\n    int ip;\r\n"]
