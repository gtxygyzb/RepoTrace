[1972.644619, "o", "   187\t            strncpy(n->data.compound_assign.name, name, MAX_IDENT_LEN - 1);\r\n   188\t            n->data.compound_assign.op = op;\r\n   189\t            n->data.compound_assign.value = val; return n;\r\n   190\t        }\r\n   191\t    }\r\n   192\t    p->pos = saved; return NULL;\r\n   193\t}\r\n   194\t\r\n   195\tstatic ASTNode *parse_for(Parser *p) {\r\n   196\t    int line = prev(p)->line;\r\n   197\t    expect(p, TOK_LPAREN, \"'('\");\r\n   198\t\r\n   199\t    if (check(p, TOK_IDENT) && p->pos + 1 < p->count && p->tokens[p->pos + 1].type == TOK_IN) {\r\n   200\t        char name[MAX_IDENT_LEN];\r\n   201\t        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n   202\t        match(p, TOK_IDENT);\r\n"]
[1972.644674, "o", "   203\t        match(p, TOK_IN);\r\n   204\t        ASTNode *arr = parse_expr(p);\r\n   205\t        expect(p, TOK_RPAREN, \"')'\");\r\n   206\t        ASTNode *body = parse_block(p);\r\n   207\t        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;\r\n   208\t        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);\r\n   209"]
[1972.64472, "o", "\t        n->data.foreach_stmt.arr = arr;\r\n   210\t        n->data.foreach_stmt.body = body;\r\n   211\t        return n;\r\n   212\t    }\r\n   213\t\r\n   214\t    ASTNode *init = NULL;\r\n   215\t"]
[1972.644773, "o", "    if (match(p, TOK_LET)) {\r\n   216\t        expect(p, TOK_IDENT, \"identifier\");\r\n   217\t        char name[MAX_IDENT_LEN];\r\n   218\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n   219\t        expect(p, TOK_ASSIGN, \"'='\");\r\n   220\t        ASTNode *init_expr = parse_expr(p);\r\n   221\t        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;\r\n   222\t        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);\r\n   223\t        init->data.let.init = init_expr;\r\n"]
[1972.644817, "o", "   224\t    } else if (check(p, TOK_IDENT)) {\r\n   225\t        init = try_parse_assign(p);\r\n   226\t        if (!init) init = parse_expr(p);\r\n   227\t    } else if (!check(p, TOK_SEMICOLON)) {\r\n   228\t        init = parse_expr(p);\r\n   229\t    }\r\n"]
[1972.644864, "o", "   230\t    expect(p, TOK_SEMICOLON, \"';'\");\r\n   231\t\r\n   232\t    ASTNode *cond = NULL;\r\n   233\t    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);\r\n   234\t    expect(p, TOK_SEMICOLON, \"';'\");\r\n   235\t\r\n   236\t    ASTNode *step = NULL;\r\n   237\t    if (!check(p, TOK_RPAREN)) {\r\n   238\t        if (check(p, TOK_IDENT)) {\r\n"]
[1972.644912, "o", "   239\t            step = try_parse_assign(p);\r\n   240\t        }\r\n   241\t        if (!step) step = parse_expr(p);\r\n   242\t    }\r\n   243\t    expect(p, TOK_RPAREN, \"')'\");\r\n   244\t\r\n"]
[1972.644954, "o", "   245\t    ASTNode *body = parse_block(p);\r\n   246\t    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;\r\n   247\t    n->data.for_stmt.init = init;\r\n   248\t    n->data.for_stmt.cond = cond;\r\n   249\t    n->data.for_stmt.step = step;\r\n   250\t    n->data.for_stmt.body = body;\r\n   251\t    return n;\r\n"]
[1972.644997, "o", "   252\t}\r\n   253\t\r\n   254\tstatic ASTNode *parse_block(Parser *p) {\r\n   255\t    expect(p, TOK_LBRACE, \"'{'\");\r\n   256\t    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;\r\n   257\t    nodelist_init(&block->data.block.stmts);\r\n   258\t    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {\r\n"]
[1972.645037, "o", "   259\t        ASTNode *stmt = parse_stmt(p);\r\n   260\t        if (stmt) nodelist_push(&block->data.block.stmts, stmt);\r\n   261\t        if (p->had_error) break;\r\n   262\t    }\r\n"]
