[8690.198034, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\ndef repl(path, old, new, count=1):\n    p = Path(path)\n    s = p.read_text()\n    if old not in s:\n        raise SystemExit(f\"pattern not found in {path}: {old[:100]}\")\n    p.write_text(s.replace(old, new, count))\n\n# lexer.c\nrepl('src/lexer.c',\n'''else if (strcmp(buf, \"false\") == 0)    type = TOK_FALSE;\n''',\n'''else if (strcmp(buf, \"false\") == 0)    type = TOK_FALSE;\n    else if (strcmp(buf, \"throw\") == 0)   type = TOK_THROW;\n    else if (strcmp(buf, \"try\") == 0)     type = TOK_TRY;\n    else if (strcmp(buf, \"catch\") == 0)   type = TOK_CATCH;\n''')\nrepl('src/lexer.c',\n'''case TOK_PRINT: return \"print\"; case TOK_TRUE: return \"true\"; case TOK_FALSE: return \"false\";\n''',\n'''case TOK_PRINT: return \"print\"; case TOK_TRUE: return \"true\"; case TOK_FALSE: return \"false\";\n        case TOK_THROW: return \"throw\"; case TOK_TRY: return \"try\"; case TOK_CATCH: return \"catch\";\n''')\n\n# parser.c\nrepl('src/parser.c',\n'''    if (match(p, TOK_PRINT)) {\n        int line = prev(p)->line;\n     "]
