[6440.021347, "o", "\r\n   172\t\r\n   173\tstatic ASTNode *parse_comparison(Parser *p) {\r\n   174\t    ASTNode *left = parse_term(p);\r\n   175\t    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||\r\n   176\t           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {\r\n   177\t        int line = prev(p)->line; BinOp op;\r\n   178"]
[6440.02145, "o", "\t        switch (prev(p)->type) {\r\n   179\t            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;\r\n   180\t            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;\r\n   181\t            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;\r\n   182\t"]
[6440.021588, "o", "            default: op = OP_EQ; break;\r\n   183\t        }\r\n   184\t        ASTNode *right = parse_term(p);\r\n   185\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   186\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   187\t        left = n;\r\n   188\t    }\r\n   189\t    return left;\r\n   190\t}\r\n"]
