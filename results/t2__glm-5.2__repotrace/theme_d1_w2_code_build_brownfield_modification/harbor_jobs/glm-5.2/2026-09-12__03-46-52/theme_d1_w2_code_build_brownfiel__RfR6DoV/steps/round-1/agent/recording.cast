[8427.2703, "o", "cat src/main.c\r\n\u001b[?2004l\r"]
[8427.272697, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include \"lexer.h\"\r\n#include \"parser.h\"\r\n#include \"codegen.h\"\r\n#include \"vm.h\"\r\n\r\nstatic char *read_file(const char *path) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) { fprintf(stderr, \"cannot open file: %s\\n\", path); return NULL; }\r\n    fseek(f, 0, SEEK_END);\r\n    long size = ftell(f);\r\n    if (size > 0) {\r\n        fseek(f, 0, SEEK_SET);\r\n        char *buf = malloc(size + 1);\r\n        if (!buf) { fclose(f); return NULL; }\r\n        size_t rd = fread(buf, 1, size, f);\r\n        buf[rd] = '\\0';\r\n        fclose(f);\r\n        return buf;\r\n    }\r\n    fseek(f, 0, SEEK_SET);\r\n    size_t cap = 4096, len = 0;\r\n    char *buf = malloc(cap);\r\n    if (!buf) { fclose(f); return NULL; }\r\n    size_t rd;\r\n    while ((rd = fread(buf + len, 1, cap - len - 1, f)) > 0) {\r\n        len += rd;\r\n        if (len + 1 >= cap) { cap *= 2; buf = realloc(buf, cap); }\r\n    }\r\n    buf[len] = '\\0';\r\n    fclose(f);\r\n    return buf;\r\n}"]
[8427.272871, "o", "\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc < 2) { fprintf(stderr, \"usage: minicc <file.mini>\\n\"); return 1; }\r\n    char *source = read_file(argv[1]);\r\n    if (!source) return 1;\r\n\r\n    Lexer lex;\r\n    lexer_init(&lex, source);\r\n    if (lexer_tokenize(&lex) < 0) { free(source); return 1; }\r\n\r\n    Parser parser;\r\n    parser_init(&parser, lex.tokens, lex.token_count);\r\n    ASTNode *program = parse_program(&parser);\r\n    if (parser.had_error) { free(source); ast_free_all(); return 1; }\r\n\r\n    Compiler compiler;\r\n    compiler_init(&compiler);\r\n    if (compile(&compiler, program) < 0) { free(source); ast_free_all(); return 1; }\r\n\r\n    VM vm;\r\n    vm_init(&vm, &compiler);\r\n    int result = vm_run(&vm);\r\n\r\n    free(source);\r\n    ast_free_all();\r\n    return result;\r\n}\r\n"]
