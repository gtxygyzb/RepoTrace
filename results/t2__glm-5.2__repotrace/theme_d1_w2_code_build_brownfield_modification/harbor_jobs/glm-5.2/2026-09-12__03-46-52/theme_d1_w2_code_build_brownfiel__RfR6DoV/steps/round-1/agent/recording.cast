[1559.841915, "i", "for f in tests/programs/*.mini; do name=$(basename \"${f%.mini}\"); echo \"=== $name\"; ./minicc \"$f\" > /tmp/actual.txt 2>&1; diff -u \"tests/expected/$name.expected\" /tmp/actual.txt || true; done\n"]
