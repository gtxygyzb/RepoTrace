[1175.062666, "o", "static ASTNode *try_parse_assign(Parser *p) {\r\n   158\t"]
[1175.062725, "o", "    if (!check(p, TOK_IDENT)) return NULL;\r\n   159\t    int saved = p->pos;\r\n   160\t    p->pos++;\r\n   161\t    if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||\r\n   162\t        check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {\r\n   163\t        p->pos = saved; match(p, TOK_IDENT);\r\n   164\t        char name[MAX_IDENT_LEN];\r\n   165\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n   166"]
[1175.062737, "o", "\t        int line = prev(p)->line;\r\n   167\t        TokenType op_tok = current(p)->type;\r\n   168"]
[1175.06278, "o", "\t        BinOp op = OP_ADD;\r\n   169\t        const char *msg = \"'='\";\r\n   170\t        if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = \"'+='\"; expect(p, TOK_PLUS_ASSIGN, \"'+='\"); }\r\n   171\t        else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = \"'-='\"; expect(p, TOK_MINUS_ASSIGN, \"'-='\"); }\r\n"]
[1175.062878, "o", "   172\t        else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = \"'*='\"; expect(p, TOK_STAR_ASSIGN, \"'*='\"); }\r\n   173\t        else if (op_tok == TOK_SLASH_ASSIGN) { op = OP_DIV; msg = \"'/='\"; expect(p, TOK_SLASH_ASSIGN, \"'/='\"); }\r\n   174\t        else if (op_tok == TOK_PERCENT_ASSIGN) { op = OP_MOD; msg = \"'%='\"; expect(p, TOK_PERCENT_ASSIGN, \"'%='\"); }\r\n   175\t        else { expect(p, TOK_ASSIGN, \"'='\"); }\r\n   176\t        ASTNode *val = parse_expr(p);\r\n   177\t        if (op_tok == TOK_ASSIGN) {\r\n   178\t            ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;\r\n   179\t            strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);\r\n   180\t            n->data.assign.value = val; return n;\r\n"]
