[8227.465864, "o", "   378\tstatic ASTNode *parse_stmt(Parser *p) {\r\n   379\t    if (match(p, TOK_LET)) {\r\n   380\t        int line = prev(p)->line;\r\n   381\t        expect(p, TOK_IDENT, \"identifier\");\r\n   382\t        char name[MAX_IDENT_LEN];\r\n   383\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n   384\t"]
[8227.465965, "o", "        expect(p, TOK_ASSIGN, \"'='\");\r\n   385\t        ASTNode *init = parse_expr(p);\r\n   386\t        expect(p, TOK_SEMICOLON, \"';'\");\r\n   387\t        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;\r\n   388\t        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);\r\n   389\t        n->data.let.init = init; return n;\r\n   390\t    }\r\n   391\t    if (match(p, TOK_IF)) {\r\n   392\t        int line = prev(p)->line;\r\n   393\t        expect(p, TOK_LPAREN, \"'('\");\r\n   394\t        ASTNode *cond = parse_expr(p);\r\n   395\t        expect(p, TOK_RPAREN, \"')'\");\r\n   396\t        ASTNode *then_b = parse_block(p);\r\n   397\t        ASTNode *else_b = NULL;\r\n   398\t        if (match(p, TOK_ELSE)) {\r\n"]
[8227.466044, "o", "   399\t            if (check(p, TOK_IF)) {\r\n   400\t                ASTNode *elif = parse_stmt(p);\r\n   401\t                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;\r\n   402\t                nodelist_init(&else_b->data.block.stmts);\r\n   403\t                nodelist_push(&else_b->data.block.stmts, elif);\r\n   404\t            } else {\r\n   405\t                else_b = parse_block(p);\r\n"]
[8227.466114, "o", "   406\t            }\r\n   407\t        }\r\n   408\t        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;\r\n   409\t        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;\r\n   410\t        return n;\r\n   411\t    }\r\n   412\t    if (match(p, TOK_WHILE)) {\r\n   413\t        int line = prev(p)->line;\r\n   414\t        expect(p, TOK_LPAREN, \"'('\");\r\n   415\t        ASTNode *cond = parse_expr(p);\r\n   416\t        expect(p, TOK_RPAREN, \"')'\");\r\n   417\t        ASTNode *body = parse_block(p);\r\n   418\t        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;\r\n   419\t        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;\r\n"]
[8227.466202, "o", "   420\t    }\r\n   421\t    if (match(p, TOK_RETURN)) {\r\n   422\t        int line = prev(p)->line;\r\n   423\t        ASTNode *value = NULL;\r\n   424\t        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);\r\n   425\t        expect(p, TOK_SEMICOLON, \"';'\");\r\n   426\t        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;\r\n   427\t        n->data.ret.value = value; return n;\r\n   428\t    }\r\n   429\t    if (match(p, TOK_FOR)) {\r\n   430\t        return parse_for(p);\r\n   431\t    }\r\n   432\t    if (match(p, TOK_BREAK)) {\r\n   433\t        int line = prev(p)->line;\r\n"]
[8227.466301, "o", "   434\t        expect(p, TOK_SEMICOLON, \"';'\");\r\n   435\t        ASTNode *n = ast_alloc(); n->type = NODE_BREAK; n->line = line; return n;\r\n   436\t    }\r\n   437\t    if (match(p, TOK_CONTINUE)) {\r\n   438\t        int line = prev(p)->line;\r\n   439\t        expect(p, TOK_SEMICOLON, \"';'\");\r\n   440\t        ASTNode *n = ast_alloc(); n->type = NODE_CONTINUE; n->line = line; return n;\r\n   441\t    }\r\n   442\t    if (match(p, TOK_PRINT)) {\r\n   443\t        int line = prev(p)->line;\r\n   444\t        ASTNode *value = parse_expr(p);\r\n"]
[8227.466365, "o", "   445\t        expect(p, TOK_SEMICOLON, \"';'\");\r\n   446\t        ASTNode *n = ast_alloc(); n->type = NODE_PRINT; n->line = line;\r\n   447\t        n->data.print.value = value; return n;\r\n   448\t    }\r\n   449\t    if (match(p, TOK_FN)) {\r\n   450\t        int line = prev(p)->line;\r\n   451\t        expect(p, TOK_IDENT, \"function name\");\r\n   452\t        char name[MAX_IDENT_LEN];\r\n   453\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n"]
[8227.466427, "o", "   454\t        expect(p, TOK_LPAREN, \"'('\");\r\n   455\t        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;\r\n   456\t        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);\r\n   457\t        n->data.func.param_count = 0;\r\n   458\t        if (!check(p, TOK_RPAREN)) {\r\n   459\t            do {\r\n   460\t                expect(p, TOK_IDENT, \"parameter name\");\r\n   461\t                strncpy(n->data.func.params[n->data.func.param_count],\r\n   462\t                        prev(p)->text, MAX_IDENT_LEN - 1);\r\n"]
[8227.466486, "o", "   463\t                n->data.func.param_count++;\r\n   464\t            } while (match(p, TOK_COMMA));\r\n   465\t        }\r\n   466\t        expect(p, TOK_RPAREN, \"')'\");\r\n   467\t        n->data.func.body = parse_block(p); return n;\r\n   468\t    }\r\n   469\t    if (check(p, TOK_IDENT)) {\r\n   470\t        ASTNode *a = try_parse_assign(p);\r\n   471\t        if (a) { expect(p, TOK_SEMICOLON, \"';'\"); return a; }\r\n   472"]
[8227.46655, "o", "\t    }\r\n   473\t    ASTNode *expr = parse_expr(p);\r\n   474\t    expect(p, TOK_SEMICOLON, \"';'\");\r\n   475\t    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;\r\n   476\t    n->data.expr_stmt.expr = expr; return n;\r\n   477\t}\r\n   478\t\r\n   479\tvoid parser_init(Parser *p, Token *tokens, int count) {\r\n   480\t    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;\r\n"]
[8227.466612, "o", "   481\t}\r\n   482\t\r\n   483\tASTNode *parse_program(Parser *p) {\r\n   484\t    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;\r\n   485\t    nodelist_init(&program->data.block.stmts);\r\n   486\t    while (!check(p, TOK_EOF)) {\r\n   487\t        ASTNode *stmt = parse_stmt(p);\r\n   488\t        if (stmt) nodelist_push(&program->data.block.stmts, stmt);\r\n"]
[8227.466678, "o", "   489\t        if (p->had_error) break;\r\n   490\t    }\r\n   491\t    return program;\r\n   492\t}\r\n"]
