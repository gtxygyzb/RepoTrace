[8368.23546, "o", "#ifndef MINICC_VM_H\r\n#define MINICC_VM_H\r\n\r\n#include \"common.h\"\r\n#include \"codegen.h\"\r\n\r\ntypedef struct {\r\n    Value stack[MAX_STACK];\r\n    int sp;\r\n    CallFrame frames[MAX_CALL_FRAMES];\r\n    int frame_count;\r\n    Value globals[MAX_GLOBALS];\r\n    char global_names[MAX_GLOBALS][MAX_IDENT_LEN];\r\n    int global_count;\r\n    Instruction *code;\r\n    int code_count;\r\n    FuncInfo *functions;\r\n    int func_count;\r\n    int ip;\r\n} VM;\r\n\r\nvoid vm_init(VM *vm, Compiler *c);\r\nint vm_run(VM *vm);\r\n\r\n#endif\r\n"]
