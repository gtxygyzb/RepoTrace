[10997.82131, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[10997.821604, "o", "old = '''            case BC_CALL: {\r\n\u001b[?2004l\r"]
[10997.821665, "o", "\u001b[?2004h> "]
