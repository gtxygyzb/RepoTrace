[9925.864822, "o", "\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;\r\n\u001b[32m\u001b[K179\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                push(vm, vm->stack[base + (int)ins->operand]);\r\n\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n\u001b[32m\u001b[K181\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n"]
[9925.864892, "o", "\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kcase BC_STORE_LOCAL\u001b[m\u001b[K: {\r\n"]
[9925.864997, "o", "\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;\r\n\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                vm->stack[base + (int)ins->operand] = pop(vm);\r\n\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            case BC_LOAD_GLOBAL: {\r\n\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int idx = resolve_global(vm, ins->str_operand);\r\n"]
[9925.865071, "o", "\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (idx < 0) { fprintf(stderr, \"undefined variable '%s'\\n\", ins->str_operand); return -1; }\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                push(vm, vm->globals[idx]);\r\n\u001b[32m\u001b[K191\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            case BC_STORE_GLOBAL: {\r\n\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int idx = resolve_global(vm, ins->str_operand);\r\n"]
[9925.865139, "o", "\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (idx < 0) idx = add_global(vm, ins->str_operand);\r\n\u001b[32m\u001b[K196\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                vm->globals[idx] = pop(vm);\r\n\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K199\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            case BC_ADD: {\r\n\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                Value b = pop(vm); Value a = pop(vm);\r\n\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (a.type == VAL_STR || b.type == VAL_STR) {\r\n\u001b[32m\u001b[K202\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    char bufa[64], bufb[64];\r\n\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    const char *sa = value_to_cstr(a, bufa, sizeof(bufa));\r\n\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    const char *sb = value_to_cstr(b, bufb, sizeof(bufb));\r\n\u001b[32m\u001b[K205\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    char *r = malloc(strlen(sa) + strlen(sb) + 1);\r\n\u001b[32m\u001b[K206\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    strcpy(r, sa); strcat(r, sb);\r\n"]
[9925.865219, "o", "\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    Value v; v.type = VAL_STR; v.data.sval = r; push(vm, v);\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    v.data.closure.captures[i] = val.data.ref;\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                }\r\n\u001b[32m\u001b[K310\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                push(vm, v);\r\n\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kcase BC_CALL_VALUE\u001b[m\u001b[K: {\r\n"]
[9925.865362, "o", "\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                Value callee = pop(vm);\r\n\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int fi = -1;\r\n\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (callee.type == VAL_CLOSURE) fi = callee.data.closure.func_idx;\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (fi < 0) { fprintf(stderr, \"cannot call non-function value\\n\"); return -1; }\r\n\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                FuncInfo *func = &vm->functions[fi];\r\n\u001b[32m\u001b[K319\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (vm->frame_count >= MAX_CALL_FRAMES) { fprintf(stderr, \"call stack overflow\\n\"); return -1; }\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                CallFrame *frame = &vm->frames[vm->frame_count++];\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                frame->ip = vm->ip;\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                frame->bp = vm->sp;\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                frame->local_start = vm->sp - func->param_count;\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (callee.type == VAL_CLOSU"]
