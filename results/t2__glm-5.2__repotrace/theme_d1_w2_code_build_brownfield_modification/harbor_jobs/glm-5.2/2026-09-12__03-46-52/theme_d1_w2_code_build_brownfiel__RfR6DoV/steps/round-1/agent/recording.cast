[5406.780612, "o", "   183\tstatic ASTNode *try_parse_assign(Parser *p) {\r\n   184\t    if (!check(p, TOK_IDENT)) return NULL;\r\n   185\t    int saved = p->pos;\r\n   186\t    p->pos++;\r\n   187"]
[5406.780767, "o", "\t    char name[MAX_IDENT_LEN];\r\n   188\t    strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n   189\t    int line = prev(p)->line;\r\n   190\t    if (match(p, TOK_LBRACKET)) {\r\n   191\t        ASTNode *idx = parse_expr(p);\r\n   192\t        expect(p, TOK_RBRACKET, \"']'\");\r\n   193\t        if (check(p, TOK_ASSIGN)) {\r\n   194\t            match(p, TOK_ASSIGN);\r\n   195\t            ASTNode *val = parse_expr(p);\r\n   196\t            ASTNode *n = ast_alloc(); n->type = NODE_INDEX_ASSIGN; n->line = line;\r\n   197\t            strncpy(n->data.index_assign.name, name, MAX_IDENT_LEN - 1);\r\n   198\t            n->data.index_assign.index = idx;\r\n   199\t            n->data.index_assign.value = val;\r\n   200\t            return n;\r\n   201\t        }\r\n   202\t        p->pos = saved;\r\n   203\t        return NULL;\r\n"]
[5406.78087, "o", "   204\t    }\r\n   205\t    if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||\r\n   206\t        check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {\r\n   207\t        p->pos = saved; match(p, TOK_IDENT);\r\n   208\t        TokenType op_tok = current(p)->type;\r\n   209\t        BinOp op = OP_ADD;\r\n   210\t        const char *msg = \"'='\";\r\n   211\t        if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = \"'+='\"; expect(p, TOK_PLUS_ASSIGN, \"'+='\"); }\r\n   212\t        else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = \"'-='\"; expect(p, TOK_MINUS_ASSIGN, \"'-='\"); }\r\n   213\t        else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = \"'*='\"; expect(p, TOK_STAR_ASSIGN, \"'*='\"); }\r\n"]
[5406.78096, "o", "   214\t        else if (op_tok == TOK_SLASH_ASSIGN) { op = OP_DIV; msg = \"'/='\"; expect(p, TOK_SLASH_ASSIGN, \"'/='\"); }\r\n   215\t        else if (op_tok == TOK_PERCENT_ASSIGN) { op = OP_MOD; msg = \"'%='\"; expect(p, TOK_PERCENT_ASSIGN, \"'%='\"); }\r\n   216\t        else { expect(p, TOK_ASSIGN, \"'='\"); }\r\n   217\t        ASTNode *val = parse_expr(p);\r\n   218\t        if (op_tok == TOK_ASSIGN) {\r\n"]
[5406.78103, "o", "   219\t            ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;\r\n   220\t            strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);\r\n   221\t            n->data.assign.value = val; return n;\r\n   222\t        } else {\r\n   223\t            ASTNode *n = ast_alloc(); n->type = NODE_COMPOUND_ASSIGN; n->line = line;\r\n   224\t            strncpy(n->data.compound_assign.name, name, MAX_IDENT_LEN - 1);\r\n   225\t            n->data.compound_assign.op = op;\r\n   226\t            n->data.compound_assign.value = val; return n;\r\n   227\t        }\r\n   228\t    }\r\n   229\t    p->pos = saved; return NULL;\r\n   230\t}\r\n"]
