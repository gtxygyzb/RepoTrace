[5746.676116, "o", "s = s.replace('        struct { char name[MAX_IDENT_LEN]; struct ASTNode *index; struct ASTNode *value; } index_assign;', '        struct { char name[MAX_IDENT_LEN]; struct ASTNode *obj; struct ASTNode *index; struct ASTNode *value; } index_assign;')\r\n\u001b[?2004l\r"]
