[11509.024481, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/main.c')\ns = p.read_text()\nold = '''    if (compile(&compiler, program) < 0) { free(source); ast_free_all(); return 1; }\n\n    if (getenv(\"MINICC_DUMP\")) {\n        for (int i = 0; i < compiler.code_count; i++) {\n            Instruction *ins = &compiler.code[i];\n            fprintf(stderr, \"%04d %d %lld %s\\\\n\", i, (int)ins->op, (long long)ins->operand, ins->str_operand ? ins->str_operand : \"\");\n        }\n    }\n\n    VM vm;\n'''\nnew = '''    if (compile(&compiler, program) < 0) { free(source); ast_free_all(); return 1; }\n\n    VM vm;\n'''\ns = s.replace(old, new)\np.write_text(s)\nPY\n"]
