[5293.580851, "o", "   135\t            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;\r\n   136\t            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;\r\n   137\t            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;\r\n   138\t            default: op = OP_EQ; break;\r\n   139\t        }\r\n"]
