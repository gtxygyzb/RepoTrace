[332.490441, "o", "     1\t#include \"vm.h\"\r\n     2\t#include <string.h>\r\n     3\t\r\n     4\tstatic void push(VM *vm, Value v) {\r\n     5\t    if (vm->sp >= MAX_STACK) { fprintf(stderr, \"stack overflow\\n\"); exit(1); }\r\n     6\t    vm->stack[vm->sp++] = v;\r\n"]
[332.490568, "o", "     7\t}\r\n     8\t\r\n     9\tstatic Value pop(VM *vm) {\r\n    10\t    if (vm->sp <= 0) { fprintf(stderr, \"stack underflow\\n\"); exit(1); }\r\n    11\t    return vm->stack[--vm->sp];\r\n    12\t}\r\n    13\t\r\n    14\tstatic Value make_int(int64_t v) { Value val; val.type = VAL_INT; val.data.ival = v; return val; }\r\n    15\tstatic Value make_str(const char *s) { Value val; val.type = VAL_STR; val.data.sval = strdup(s); return val; }\r\n    16\tstatic Value make_bool(int b) { Value val; val.type = VAL_BOOL; val.data.bval = b; return val; }\r\n    17\t\r\n    18\tstatic int resolve_global(VM *vm, const char *name) {\r\n    19\t    for (int i = 0; i < vm->global_count; i++)\r\n    20\t        if (strcmp(vm->global_names[i], name) == 0) return i;\r\n    21\t    return -1;\r\n    22\t}\r\n    23\t\r\n    24\tstatic int add_global(VM *vm, const char *name) {\r\n    25\t    if (vm->global_count >= MAX_GLOBALS) { fprintf(stderr, \"too many globals\\n\"); return -1; }\r\n    26\t    int idx = vm->global_count;\r\n"]
[332.490662, "o", "    27\t    strncpy(vm->global_names[idx], name, MAX_IDENT_LEN - 1);\r\n    28\t    vm->globals[idx].type = VAL_NULL;\r\n    29\t    vm->global_count++;\r\n    30\t    return idx;\r\n    31\t}\r\n    32\t\r\n    33\tstatic int64_t value_to_int(Value v) {\r\n    34\t    switch (v.type) { case VAL_INT: return v.data.ival; case VAL_BOOL: return v.data.bval ? 1 : 0; default: return 0; }\r\n    35\t}\r\n    36\t\r\n    37\tstatic int value_is_integer_like(Value v) {\r\n    38\t    return v.type == VAL_INT || v.type == VAL_BOOL;\r\n    39\t}\r\n"]
[332.490733, "o", "    40\t\r\n    41\tstatic int value_truthy(Value v) {\r\n    42\t    switch (v.type) {\r\n    43\t        case VAL_INT: return v.data.ival != 0;\r\n    44\t        case VAL_BOOL: return v.data.bval;\r\n    45\t        case VAL_STR: return v.data.sval && v.data.sval[0] != '\\0';\r\n    46\t        case VAL_ARRAY: return v.data.array.len > 0;\r\n    47\t        case VAL_NULL: return 0;\r\n    48\t    }\r\n    49\t    return 0;\r\n"]
[332.490807, "o", "    50\t}\r\n    51\t\r\n    52\tstatic int values_equal(Value a, Value b) {\r\n    53\t    if (a.type != b.type) return 0;\r\n    54\t    switch (a.type) {\r\n    55\t        case VAL_INT: return a.data.ival == b.data.ival;\r\n    56\t        case VAL_BOOL: return a.data.bval == b.data.bval;\r\n    57\t        case VAL_STR: return strcmp(a.data.sval, b.data.sval) == 0;\r\n    58\t        case VAL_NULL: return 1;\r\n    59\t        default: return 0;\r\n    60\t    }\r\n"]
[332.490886, "o", "    61\t}\r\n    62\t\r\n    63\tstatic void print_value(Value v) {\r\n    64\t    switch (v.type) {\r\n    65\t        case VAL_INT: printf(\"%lld\", (long long)v.data.ival); break;\r\n    66\t        case VAL_BOOL: printf(\"%s\", v.data.bval ? \"true\" : \"false\"); break;\r\n    67\t        case VAL_STR: printf(\"%s\", v.data.sval); break;\r\n    68\t        case VAL_ARRAY:\r\n    69\t            printf(\"[\");\r\n    70\t            for (int i = 0; i < v.data.array.len; i++) {\r\n"]
[332.490957, "o", "    71\t                if (i > 0) printf(\", \");\r\n    72\t                print_value(v.data.array.items[i]);\r\n    73\t            }\r\n    74\t            printf(\"]\");\r\n    75\t            break;\r\n    76\t        case VAL_NULL: printf(\"null\"); break;\r\n    77\t    }\r\n    78\t}\r\n    79\t\r\n    80\tvoid vm_init(VM *vm, Compiler *c) {\r\n    81"]
[332.49107, "o", "\t    vm->sp = 0; vm->frame_count = 0; vm->global_count = 0;\r\n    82\t    vm->code = c->code; vm->code_count = c->code_count;\r\n    83\t    vm->functions = c->functions; vm->func_count = c->func_count;\r\n    84\t    vm->ip = 0;\r\n    85\t}\r\n    86\t\r\n    87\tint vm_run(VM *vm) {\r\n    88\t    while (vm->ip < vm->code_count) {\r\n    89\t        Instruction *ins = &vm->code[vm->ip++];\r\n    90\t        switch (ins->op) {\r\n    91\t            case BC_PUSH_INT: push(vm, make_int(ins->operand)); break;\r\n    92\t            case BC_PUSH_STR: push(vm, make_str(ins->str_operand)); break;\r\n    93\t            case BC_PUSH_BOOL: push(vm, make_bool((int)ins->operand)); break;\r\n    94\t            case BC_LOAD_LOCAL: {\r\n    95\t                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;\r\n    96\t                push(vm, vm->stack[base + (int)ins->operand]);\r\n"]
[332.491148, "o", "    97\t                break;\r\n    98\t            }\r\n    99\t            case BC_STORE_LOCAL: {\r\n   100\t                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;\r\n   101\t                vm->stack[base + (int)ins->operand] = pop(vm);\r\n   102\t                break;\r\n   103\t            }\r\n   104\t            case BC_LOAD_GLOBAL: {\r\n   105\t                int idx = resolve_global(vm, ins->str_operand);\r\n   106\t                if (idx < 0) { fprintf(stderr, \"undefined variable '%s'\\n\", ins->str_operand); return -1; }\r\n   107\t                push(vm, vm->globals[idx]);\r\n"]
[332.491267, "o", "   108\t                break;\r\n   109\t            }\r\n   110\t            case BC_STORE_GLOBAL: {\r\n   111\t                int idx = resolve_global(vm, ins->str_operand);\r\n   112\t                if (idx < 0) idx = add_global(vm, ins->str_operand);\r\n   113\t                vm->globals[idx] = pop(vm);\r\n   114\t                break;\r\n   115\t            }\r\n   116\t            case BC_ADD: {\r\n   117\t                Value b = pop(vm); Value a = pop(vm);\r\n   118\t                if (a.type == VAL_STR && b.type == VAL_STR) {\r\n   119\t                    char *r = malloc(strlen(a.data.sval) + strlen(b.data.sval) + 1);\r\n   120\t                    strcpy(r, a.data.sval); strcat(r, b.data.sval);\r\n   121\t                    Value v; v.type = VAL_STR; v.data.sval = r; push(vm, v);\r\n   122\t                } else { push(vm, make_int(value_to_int(a) + value_to_int(b))); }\r\n"]
[332.491357, "o", "   123\t                break;\r\n   124\t            }\r\n   125\t            case BC_SUB: { Value b = pop(vm); Value a = pop(vm);\r\n   126\t                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {\r\n   127\t                    fprintf(stderr, \"operator '-' expects integers\\n\");\r\n   128\t                    return -1;\r\n   129\t                }\r\n   130\t                push(vm, make_int(value_to_int(a) - value_to_int(b))); break; }\r\n   131\t            case BC_MUL: { Value b = pop(vm); Value a = pop(vm);\r\n   132\t                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {\r\n   133\t                    fprintf(stderr, \"operator '*' expects integers\\n\");\r\n   134\t                    return -1;\r\n   135\t                }\r\n   136\t                push(vm, make_int(value_to_int(a) * value_to_int(b))); break; }\r\n"]
[332.491435, "o", "   137\t            case BC_DIV: { Value b = pop(vm); Value a = pop(vm);\r\n   138\t                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {\r\n   139\t                    fprintf(stderr, \"operator '/' expects integers\\n\");\r\n   140\t                    return -1;\r\n   141\t                }\r\n   142\t                if (value_to_int(b) == 0) { fprintf(stderr, \"division by zero\\n\"); return -1; }\r\n   143\t                push(vm, make_int(value_to_int(a) / value_to_int(b))); break; }\r\n   144\t            case BC_MOD: { Value b = pop(vm); Value a = pop(vm);\r\n   145\t                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {\r\n   146\t                    fprintf(stderr, \"operator '%%' expects integers\\n\");\r\n   147\t                    return -1;\r\n   148\t                }"]
[332.49155, "o", "\r\n   149\t                if (value_to_int(b) == 0) { fprintf(stderr, \"modulo by zero\\n\"); return -1; }\r\n   150\t                push(vm, make_int(value_to_int(a) % value_to_int(b))); break; }\r\n   151\t            case BC_EQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(values_equal(a, b))); break; }\r\n   152\t            case BC_NEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(!values_equal(a, b))); break; }\r\n   153\t            case BC_LT: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_to_int(a) < value_to_int(b))); break; }\r\n   154\t            case BC_GT: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_to_int(a) > value_to_int(b))); break; }\r\n   155\t            case BC_LEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_to_int(a) <= value_to_int(b))); break; }\r\n   156\t            case BC_GEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_to_int(a) >= value_to_int(b))); break; }\r\n   157\t            case BC_AND: { "]
[332.491632, "o", "Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_truthy(a) && value_truthy(b))); break; }\r\n   158\t            case BC_OR: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_truthy(a) || value_truthy(b))); break; }\r\n   159\t            case BC_NOT: { Value a = pop(vm); push(vm, make_bool(!value_truthy(a))); break; }\r\n   160\t            case BC_NEG: { Value a = pop(vm); push(vm, make_int(-value_to_int(a))); break; }\r\n   161\t            case BC_JUMP: vm->ip = (int)ins->operand; break;\r\n   162\t            case BC_JUMP_FALSE: { Value cond = pop(vm); if (!value_truthy(cond)) vm->ip = (int)ins->operand; break; }\r\n   163\t            case BC_CALL: {\r\n   164\t                int fi = (int)ins->operand;\r\n   165\t                FuncInfo *func = &vm->functions[fi];\r\n   166\t                if (vm->frame_count >= MAX_CALL_FRAMES) { fprintf(stderr, \"call stack overflow\\n\"); return -1; }\r\n   167\t                CallFrame *frame = &vm->frames[vm->frame_count++];\r\n   168\t                frame->ip = vm-"]
[332.491701, "o", ">ip;\r\n   169\t                frame->bp = vm->sp;\r\n   170\t                /* BUG: the callee's local base does not properly account for\r\n   171\t                   intermediate return values that earlier nested-call arguments\r\n   172\t                   left on the stack. For multi-argument calls that are preceded\r\n   173\t                   by such temporaries the base is mis-computed (off by one),\r\n   174\t                   so nested calls used as arguments (e.g. add(double(3), triple(2)))\r\n   175\t                   read the wrong stack slots and produce wrong results. */\r\n   176\t                if (func->param_count >= 2 && vm->sp > func->param_count)\r\n   177\t                    frame->local_start = vm->sp - func->param_count + 1;\r\n   178\t                else\r\n   179\t                    frame->local_start = vm->sp - func->param_count;\r\n   180"]
[332.491774, "o", "\t                vm->ip = func->addr;\r\n   181\t                break;\r\n   182\t            }\r\n   183\t            case BC_RET: {\r\n   184\t                Value retval = pop(vm);\r\n   185\t                if (vm->frame_count <= 0) { fprintf(stderr, \"return outside function\\n\"); return -1; }\r\n   186\t                CallFrame *frame = &vm->frames[--vm->frame_count];\r\n   187\t                vm->sp = frame->local_start;\r\n   188\t                vm->ip = frame->ip;\r\n   189\t                push(vm, retval);\r\n   190\t                break;\r\n   191\t            }\r\n   192\t            case BC_PRINT: { Value v = pop(vm); print_value(v); printf(\"\\n\"); break; }\r\n   193\t            case BC_POP: pop(vm); break;\r\n"]
[332.491851, "o", "   194\t            case BC_PUSH_ARRAY: {\r\n   195\t                int count = (int)ins->operand;\r\n   196\t                Value arr; arr.type = VAL_ARRAY;\r\n   197\t                arr.data.array.len = count;\r\n   198\t                arr.data.array.items = malloc(count * sizeof(Value));\r\n   199\t                for (int i = count - 1; i >= 0; i--) arr.data.array.items[i] = pop(vm);\r\n   200\t                push(vm, arr); break;\r\n   201\t            }\r\n   202\t            case BC_INDEX: {\r\n   203\t                Value idx = pop(vm); Value obj = pop(vm);\r\n   204\t                if (obj.type != VAL_ARRAY) { fprintf(stderr, \"cannot index non-array\\n\"); return -1; }\r\n   205\t                int i = (int)value_to_int(idx);"]
[332.49192, "o", "\r\n   206\t                if (i < 0 || i >= obj.data.array.len) { fprintf(stderr, \"index out of bounds: %d\\n\", i); return -1; }\r\n   207\t                push(vm, obj.data.array.items[i]); break;\r\n   208\t            }\r\n   209\t            case BC_ARRAY_LEN: {\r\n   210\t                Value arr = pop(vm);\r\n   211\t                if (arr.type != VAL_ARRAY) { push(vm, make_int(0)); }\r\n   212\t                else { push(vm, make_int(arr.data.array.len)); }\r\n   213\t                break;\r\n   214\t"]
