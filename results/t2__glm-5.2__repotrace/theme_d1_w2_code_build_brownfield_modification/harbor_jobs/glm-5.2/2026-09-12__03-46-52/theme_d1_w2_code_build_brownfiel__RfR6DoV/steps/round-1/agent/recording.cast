[1947.828422, "o", "   267\tstatic ASTNode *parse_stmt(Parser *p) {\r\n   268\t    if (match(p, TOK_LET)) {\r\n   269\t        int line = prev(p)->line;\r\n   270\t        expect(p, TOK_IDENT, \"identifier\");\r\n   271\t        char name[MAX_IDENT_LEN];\r\n   272\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n   273\t        expect(p, TOK_ASSIGN, \"'='\");\r\n   274\t        ASTNode *init = parse_expr(p);\r\n   275\t        expect(p, TOK_SEMICOLON, \"';'\");\r\n   276\t        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;\r\n   277\t        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);\r\n   278\t        n->data.let.init = init; return n;\r\n   279\t    }\r\n   280\t    if (match(p, TOK_IF)) {\r\n   281\t        int line = prev(p)->line;\r\n   282\t        expect(p, TOK_LPAREN, \"'('\");\r\n   283\t        ASTNode *cond = parse_expr(p);\r\n   284\t        expect(p, TOK_RPAREN, \"')'\");\r\n   285\t        ASTNode *then_b = parse_block(p);\r\n   286\t        ASTNode *else_b = NULL;\r\n   287\t        if (match(p, TOK_ELSE)) {\r\n   288"]
[1947.828558, "o", "\t            if (check(p, TOK_IF)) {\r\n   289\t                ASTNode *elif = parse_stmt(p);\r\n   290\t                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;\r\n   291\t                nodelist_init(&else_b->data.block.stmts);\r\n   292\t                nodelist_push(&else_b->data.block.stmts, elif);\r\n   293\t            } else {\r\n   294\t                else_b = parse_block(p);\r\n   295\t            }\r\n   296\t        }\r\n   297\t        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;\r\n   298\t        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;\r\n   299\t        return n;\r\n   300\t    }\r\n   301\t    if (match(p, TOK_WHILE)) {\r\n   302\t        int line = prev(p)->line;\r\n   303\t        expect(p, TOK_LPAREN, \"'('\");\r\n   304\t        ASTNode *cond = parse_expr(p);\r\n   305\t        expect(p, TOK_RPAREN, \"')'\");\r\n   306\t        ASTNode *body = parse_block(p);\r\n   307\t        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;\r"]
[1947.828672, "o", "\n   308\t        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;\r\n   309\t    }\r\n   310\t    if (match(p, TOK_RETURN)) {\r\n   311\t        int line = prev(p)->line;\r\n   312\t        ASTNode *value = NULL;\r\n   313\t        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);\r\n   314\t        expect(p, TOK_SEMICOLON, \"';'\");\r\n   315\t        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;\r\n   316\t        n->data.ret.value = value; return n;\r\n   317\t    }"]
