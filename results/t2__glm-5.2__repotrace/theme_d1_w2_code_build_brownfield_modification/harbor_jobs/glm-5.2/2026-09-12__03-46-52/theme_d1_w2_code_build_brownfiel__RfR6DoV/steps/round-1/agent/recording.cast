[10946.537759, "o", "static const char *value_to_key(Value v, char *buf, size_t size) {\r\n    if (v.type == VAL_STR) return v.data.sval;\r\n    return value_to_cstr(v, buf, size);\r\n}\r\n"]
[10946.537863, "o", "\r\nstatic int value_cmp(Value a, Value b) {\r\n    if (a.type == VAL_STR && b.type == VAL_STR)\r\n        return strcmp(a.data.sval, b.data.sval);\r\n    int64_t ia = value_to_int(a), ib = value_to_int(b);\r\n    return ia < ib ? -1 : (ia > ib ? 1 : 0);\r\n}\r\n\r\nstatic void print_value_fp(FILE *fp, Value v) {\r\n    switch (v.type) {\r\n        case VAL_INT: fprintf(fp, \"%lld\", (long long)v.data.ival); break;\r\n        case VAL_BOOL: fprintf(fp, \"%s\", v.data.bval ? \"true\" : \"false\"); break;\r\n        case VAL_STR: fprintf(fp, \"%s\", v.data.sval); break;\r\n        case VAL_ARRAY:"]
[10946.537943, "o", "\r\n            fprintf(fp, \"[\");\r\n            for (int i = 0; i < v.data.array.len; i++) {\r\n                if (i > 0) fprintf(fp, \", \");\r\n                print_value_fp(fp, v.data.array.items[i]);\r\n            }\r\n            fprintf(fp, \"]\");\r\n            break;\r\n        case VAL_MAP:\r\n            fprintf(fp, \"{\");\r\n            for (int i = 0; i < v.data.map->len; i++) {\r\n                if (i > 0) fprintf(fp, \", \");\r\n                fprintf(fp, \"%s\", v.data.map->keys[i]);\r\n"]
[10946.53801, "o", "                fprintf(fp, \": \");\r\n                print_value_fp(fp, v.data.map->values[i]);\r\n            }\r\n            fprintf(fp, \"}\");\r\n            break;\r\n        case VAL_NULL: fprintf(fp, \"null\"); break;\r\n        case VAL_CLOSURE: fprintf(fp, \"<closure>\"); break;\r\n        case VAL_REF: print_value_fp(fp, *v.data.ref); break;\r\n    }\r\n}\r\nstatic void print_value(Value v) { print_value_fp(stdout, v); }\r\n\r\nvoid vm_init(VM *vm, Compiler *c) {\r\n"]
[10946.538076, "o", "    vm->sp = 0; vm->frame_count = 0; vm->global_count = 0;\r\n    vm->code = c->code; vm->code_count = c->code_count;\r\n    vm->functions = c->functions; vm->func_count = c->func_count;\r\n    vm->ip = 0;\r\n    vm->handler_count = 0;\r\n}\r\n\r\nint vm_run(VM *vm) {\r\n    while (vm->ip < vm->code_count) {\r\n        Instruction *ins = &vm->code[vm->ip++];\r\n        switch (ins->op) {\r\n            case BC_PUSH_INT: push(vm, make_int(ins->operand)); break;\r\n            case BC_PUSH_STR: push(vm, make_str(ins->str_operand)); break;\r\n"]
[10946.538142, "o", "            case BC_PUSH_BOOL: push(vm, make_bool((int)ins->operand)); break;\r\n            case BC_LOAD_LOCAL: {\r\n                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;\r\n                push(vm, vm->stack[base + (int)ins->operand]);\r\n                break;\r\n"]
