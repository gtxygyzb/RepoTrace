[9806.146894, "o", "                case ',': type = TOK_COMMA; break;\r\n   149\t            case '.': type = TOK_DOT; break;\r\n   150\t            case ':': type = TOK_COLON; break;\r\n   151\t                case '!': if (peek(lex)=='='){advance(lex);type=TOK_NEQ;strcpy(buf,\"!=\");}else{type=TOK_NOT;} break;\r\n   152\t                case '=': if (peek(lex)=='='){advance(lex);type=TOK_EQ;strcpy(buf,\"==\");}else{type=TOK_ASSIGN;} break;\r\n   153\t                case '<': if (peek(lex)=='='){advance(lex);type=TOK_LEQ;strcpy(buf,\"<=\");}else{type=TOK_LT;} break;\r\n"]
[9806.146938, "o", "   154\t                case '>': if (peek(lex)=='='){advance(lex);type=TOK_GEQ;strcpy(buf,\">=\");}else{type=TOK_GT;} break;\r\n   155\t                case '&': if (peek(lex)=='&'){advance(lex);type=TOK_AND;strcpy(buf,\"&&\");}\r\n   156\t                          else{error_at(lex->line,\"unexpected character '&'\");return -1;} break;\r\n   157\t                case '|': if (peek(lex)=='|'){advance(lex);type=TOK_OR;strcpy(buf,\"||\");}\r\n   158\t                          else{error_at(lex->line,\"unexpected character '|'\");return -1;} break;\r\n"]
