[7639.2331, "o", "     5\t    Instruction *ins = &c->code[c->code_count];\r\n     6\t    ins->op = op; ins->operand = operand; ins->str_operand = str_op;\r\n     7\t    return c->code_count++;\r\n     8\t}\r\n     9\t\r\n    10\tstatic int resolve_local(Compiler *c, const char *name) {\r\n    11\t    for (int i = c->local_count - 1; i >= 0; i--) {\r\n    12\t        if (strcmp(c->locals[i].name, name) == 0) return i;\r\n    13\t    }\r\n    14\t    return -1;\r\n    15\t}\r\n    16\t\r\n    17\tstatic int resolve_capture(Compiler *c, const char *name) {\r\n    18\t    for (int i = 0; i < c->capture_count; i++)\r\n    19\t        if (strcmp(c->captures[i].name, name) == 0) return i;\r\n    20\t    return -1;\r\n    21\t}\r\n"]
[7639.233173, "o", "    22\t\r\n    23\tstatic int add_local(Compiler *c, const char *name) {\r\n    24\t    if (c->local_count >= MAX_LOCALS) { fprintf(stderr, \"too many local variables\\n\"); return -1; }\r\n    25\t    Local *local = &c->locals[c->local_count];\r\n    26\t    strncpy(local->name, name, MAX_IDENT_LEN - 1); local->name[MAX_IDENT_LEN - 1] = '\\0';\r\n    27\t    local->scope_depth = c->scope_depth;\r\n    28\t    local->is_boxed = 0;\r\n    29\t    return c->local_count++;\r\n    30\t}\r\n    31\t\r\n    32\tstatic int find_function(Compiler *c, const char *name) {\r\n    33\t    for (int i = 0; i < c->func_count; i++) {\r\n"]
