[4423.218798, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/codegen.c')\nlines = p.read_text().splitlines()\n# Find NODE_FOREACH block and ensure idx_slot store exists after BC_ADD.\nfor i,l in enumerate(lines):\n    if 'case NODE_FOREACH:' in l:\n        start = i\n        break\nelse:\n    raise SystemExit('NODE_FOREACH not found')\nfor i in range(start, len(lines)):\n    if 'emit(c, BC_ADD, 0, NULL);' in lines[i] and 'idx_slot' in lines[i-1]:\n        if i+1 < len(lines) and 'BC_STORE_LOCAL, idx_slot' in lines[i+1]:\n            break\n        lines.insert(i+1, '            emit(c, BC_STORE_LOCAL, idx_slot, NULL);')\n        break\np.write_text('\\n'.join(lines) + '\\n')\nPY\n"]
