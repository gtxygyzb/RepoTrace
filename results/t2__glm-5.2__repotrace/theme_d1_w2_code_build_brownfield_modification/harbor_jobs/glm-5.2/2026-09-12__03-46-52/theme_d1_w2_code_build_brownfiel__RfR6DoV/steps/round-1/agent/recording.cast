[6431.237226, "o", "   119\tstatic ASTNode *parse_postfix(Parser *p, ASTNode *expr) {\r\n   120\t    for (;;) {\r\n   121\t        if (match(p, TOK_DOT)) {\r\n   122\t            int line = prev(p)->line;\r\n   123\t            expect(p, TOK_IDENT, \"field name\");\r\n   124\t            ASTNode *n = ast_alloc(); n->type = NODE_FIELD_ACCESS; n->line = line;\r\n   125\t            n->data.field_access.obj = expr;\r\n   126\t            strncpy(n->data.field_access.field, prev(p)->text, MAX_IDENT_LEN - 1);\r\n"]
[6431.237355, "o", "   127\t            n->data.field_access.field[MAX_IDENT_LEN - 1] = '\\0';\r\n   128\t            expr = n;\r\n   129\t        } else if (match(p, TOK_LBRACKET)) {\r\n   130\t            int line = prev(p)->line;\r\n   131\t            ASTNode *idx = parse_expr(p);\r\n   132\t            expect(p, TOK_RBRACKET, \"']'\");\r\n   133\t            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;\r\n   134\t            n->data.index_access.obj = expr;\r\n   135\t            n->data.index_access.index = idx;\r\n   136\t            expr = n;\r\n   137\t        } else {\r\n   138\t            break;\r\n   139\t        }\r\n   140"]
[6431.237437, "o", "\t    }\r\n   141\t    return expr;\r\n   142\t}\r\n   143\t\r\n   144\tstatic ASTNode *parse_unary(Parser *p) {\r\n   145\t    if (match(p, TOK_MINUS)) {\r\n"]
[6431.237509, "o", "   146\t        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n   147\t        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n   148\t        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;\r\n   149\t    }\r\n   150\t    if (match(p, TOK_NOT)) {\r\n   151\t        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n   152\t        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n   153\t        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;\r\n   154\t    }\r\n   155\t    return parse_primary(p);\r\n   156\t}\r\n   157\t\r\n   158\tstatic ASTNode *parse_factor(Parser *p) {\r\n   159\t    ASTNode *left = parse_unary(p);\r\n   160\t    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {\r\n   161\t"]
[6431.237579, "o", "        int line = prev(p)->line; BinOp op;\r\n   162\t        if (prev(p)->type == TOK_STAR) op = OP_MUL;\r\n   163\t        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;\r\n   164\t        else op = OP_MOD;\r\n   165\t        ASTNode *right = parse_unary(p);\r\n   166\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   167\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   168\t        left = n;\r\n   169\t    }\r\n   170\t    return left;\r\n"]
