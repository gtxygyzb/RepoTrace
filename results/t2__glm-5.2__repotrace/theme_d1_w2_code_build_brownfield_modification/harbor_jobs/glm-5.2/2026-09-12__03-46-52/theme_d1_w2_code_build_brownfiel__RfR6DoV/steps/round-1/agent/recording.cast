[5293.580749, "o", "   118\t        if (prev(p)->type == TOK_STAR) op = OP_MUL;\r\n   119\t        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;\r\n   120\t        else op = OP_MOD;\r\n   121\t        ASTNode *right = parse_unary(p);\r\n   122\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   123\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   124\t        left = n;\r\n   125\t    }\r\n"]
