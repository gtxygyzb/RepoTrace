[3874.183777, "o", "     6\t    va_start(args, fmt);\r\n     7\t    fprintf(stderr, \"error at line %d: \", line);\r\n     8\t    vfprintf(stderr, fmt, args);\r\n     9\t    fprintf(stderr, \"\\n\");\r\n    10\t    va_end(args);\r\n    11\t}\r\n    12\t\r\n    13\tstatic char peek(Lexer *lex) { return lex->source[lex->pos]; }\r\n    14\t\r\n    15\tstatic char advance(Lexer *lex) {\r\n    16\t    char c = lex->source[lex->pos++];\r\n    17\t    if (c == '\\n') { lex->line++; lex->col = 1; } else { lex->col++; }\r\n    18\t    return c;\r\n"]
[3874.183863, "o", "    19\t}\r\n    20\t\r\n    21\tstatic int is_at_end(Lexer *lex) { return lex->source[lex->pos] == '\\0'; }\r\n    22\t\r\n    23\tstatic void skip_whitespace(Lexer *lex) {\r\n    24\t    while (!is_at_end(lex)) {\r\n    25\t        char c = peek(lex);\r\n    26\t        if (c == ' ' || c == '\\t' || c == '\\r' || c == '\\n') {\r\n    27\t            advance(lex);\r\n    28\t        } else if (c == '/' && lex->source[lex->pos + 1] == '/') {\r\n    29\t            while (!is_at_end(lex) && peek(lex) != '\\n') advance(lex);\r\n    30\t        } else {\r\n    31\t            break;\r\n    32\t        }\r\n"]
[3874.183935, "o", "    33\t    }\r\n    34\t}\r\n    35\t\r\n    36\tstatic Token make_token(Lexer *lex, TokenType type, const char *text) {\r\n    37\t    Token t;\r\n    38\t    t.type = type;\r\n    39\t    strncpy(t.text, text, MAX_STRING_LEN - 1);\r\n    40\t    t.text[MAX_STRING_LEN - 1] = '\\0';\r\n    41\t    t.line = lex->line;\r\n    42\t    t.col = lex->col;\r\n    43"]
[3874.184, "o", "\t    t.literal.ival = 0;\r\n    44\t    return t;\r\n    45\t}\r\n    46\t\r\n    47\tstatic int add_token(Lexer *lex, Token t) {\r\n    48\t    if (lex->token_count >= MAX_TOKENS) { error_at(lex->line, \"too many tokens\"); return -1; }\r\n    49\t    lex->tokens[lex->token_count++] = t;\r\n    50\t    return 0;\r\n    51\t}\r\n    52\t\r\n    53\tstatic int lex_number(Lexer *lex) {\r\n    54\t    char buf[64]; int i = 0;\r\n"]
[3874.184061, "o", "    55\t    while (!is_at_end(lex) && isdigit(peek(lex))) {\r\n    56\t        if (i < 63) buf[i++] = advance(lex); else advance(lex);\r\n    57\t    }\r\n    58\t    buf[i] = '\\0';\r\n    59\t    Token t = make_token(lex, TOK_NUM, buf);\r\n    60\t    t.literal.ival = strtoll(buf, NULL, 10);\r\n    61\t    return add_token(lex, t);\r\n    62\t}\r\n"]
[3874.184127, "o", "    63\t\r\n    64\tstatic int lex_string(Lexer *lex) {\r\n    65\t    advance(lex);\r\n    66\t    char buf[MAX_STRING_LEN]; int i = 0;\r\n    67\t    while (!is_at_end(lex) && peek(lex) != '\"') {\r\n    68\t        char c = advance(lex);\r\n    69\t        if (c == '\\\\') {\r\n"]
[3874.184192, "o", "    70\t            if (is_at_end(lex)) { error_at(lex->line, \"unterminated string\"); return -1; }\r\n    71\t            char esc = advance(lex);\r\n    72\t            switch (esc) {\r\n    73\t                case 'n': c = '\\n'; break;\r\n    74\t                case 't': c = '\\t'; break;\r\n    75\t                case '\\\\': c = '\\\\'; break;\r\n    76\t                case '\"': c = '\"'; break;\r\n    77\t                case 'r': c = '\\r'; break;\r\n    78\t                case '0': c = '\\0'; break;\r\n    79\t                default: error_at(lex->line, \"unknown string escape \\\\%c\", esc); return -1;\r\n    80\t            }\r\n    81\t        }\r\n"]
[3874.184272, "o", "    82\t        if (i < MAX_STRING_LEN - 1) buf[i++] = c;\r\n    83\t    }\r\n    84\t    if (is_at_end(lex)) { error_at(lex->line, \"unterminated string\"); return -1; }\r\n    85\t    advance(lex);\r\n    86\t    buf[i] = '\\0';\r\n    87\t    Token t = make_token(lex, TOK_STRING, buf);\r\n    88\t    return add_token(lex, t);\r\n    89\t}\r\n    90\t\r\n    91\tstatic int lex_ident(Lexer *lex) {\r\n    92\t    char buf[MAX_IDENT_LEN]; int i = 0;\r\n"]
[3874.184338, "o", "    93\t    while (!is_at_end(lex) && (isalnum(peek(lex)) || peek(lex) == '_')) {\r\n    94\t        if (i < MAX_IDENT_LEN - 1) buf[i++] = advance(lex); else advance(lex);\r\n    95\t    }\r\n    96\t    buf[i] = '\\0';\r\n    97\t    TokenType type = TOK_IDENT;\r\n    98\t    if      (strcmp(buf, \"if\") == 0)       type = TOK_IF;\r\n    99\t    else if (strcmp(buf, \"else\") == 0)     type = TOK_ELSE;\r\n   100\t    else if (strcmp(buf, \"while\") == 0)    type = TOK_WHILE;\r\n   101\t    else if (strcmp(buf, \"for\") == 0)     type = TOK_FOR;\r\n   102\t    else if (strcmp(buf, \"break\") == 0)   type = TOK_BREAK;\r\n"]
[3874.184402, "o", "   103\t    else if (strcmp(buf, \"continue\") == 0) type = TOK_CONTINUE;\r\n   104\t    else if (strcmp(buf, \"in\") == 0)      type = TOK_IN;\r\n   105\t    else if (strcmp(buf, \"return\") == 0)   type = TOK_RETURN;\r\n   106\t    else if (strcmp(buf, \"fn\") == 0)       type = TOK_FN;\r\n   107\t"]
[3874.184469, "o", "    else if (strcmp(buf, \"let\") == 0)      type = TOK_LET;\r\n   108\t    else if (strcmp(buf, \"print\") == 0)    type = TOK_PRINT;\r\n   109\t    else if (strcmp(buf, \"true\") == 0)     type = TOK_TRUE;\r\n   110\t    else if (strcmp(buf, \"false\") == 0)    type = TOK_FALSE;\r\n   111\t    Token t = make_token(lex, type, buf);\r\n   112\t    return add_token(lex, t);\r\n   113\t}\r\n   114\t\r\n   115\tvoid lexer_init(Lexer *lex, const char *source) {\r\n   116\t    lex->source = source; lex->pos = 0; lex->line = 1; lex->col = 1; lex->token_count = 0;\r\n   117\t}\r\n   118\t\r\n   119\tint lexer_tokenize(Lexer *lex) {\r\n"]
[3874.184531, "o", "   120\t    while (!is_at_end(lex)) {\r\n   121\t        skip_whitespace(lex);\r\n   122\t        if (is_at_end(lex)) break;\r\n   123\t        char c = peek(lex);\r\n   124\t        if (isdigit(c)) { if (lex_number(lex) < 0) return -1; }\r\n"]
[3874.184597, "o", "   125\t        else if (c == '\"') { if (lex_string(lex) < 0) return -1; }\r\n   126\t        else if (isalpha(c) || c == '_') { if (lex_ident(lex) < 0) return -1; }\r\n   127\t        else {\r\n   128\t            advance(lex);\r\n   129\t            char buf[4] = {c, '\\0', '\\0', '\\0'};\r\n   130\t            TokenType type = TOK_ERROR;\r\n   131\t            switch (c) {\r\n   132\t                case '+': if (peek(lex)=='='){advance(lex);type=TOK_PLUS_ASSIGN;strcpy(buf,\"+=\");}else{type=TOK_PLUS;} break;\r\n   133\t                case '-': if (peek(lex)=='='){advance(lex);type=TOK_MINUS_ASSIGN;strcpy(buf,\"-=\");}else{type=TOK_MINUS;} break;"]
[3874.18466, "o", "\r\n   134\t                case '*': if (peek(lex)=='='){advance(lex);type=TOK_STAR_ASSIGN;strcpy(buf,\"*=\");}else{type=TOK_STAR;} break;\r\n   135\t                case '/': if (peek(lex)=='='){advance(lex);type=TOK_SLASH_ASSIGN;strcpy(buf,\"/=\");}else{type=TOK_SLASH;} break;\r\n   136\t                case '%': if (peek(lex)=='='){advance(lex);type=TOK_PERCENT_ASSIGN;strcpy(buf,\"%=\");}else{type=TOK_PERCENT;} break;\r\n   137\t                case '(': type = TOK_LPAREN; break;\r\n   138\t                case ')': type = TOK_RPAREN; break;\r\n   139\t                case '{': type = TOK_LBRACE; break;\r\n   140\t                case '}': type = TOK_RBRACE; break;\r\n"]
[3874.184727, "o", "   141\t                case '[': type = TOK_LBRACKET; break;\r\n   142\t                case ']': type = TOK_RBRACKET; break;\r\n   143\t                case ';': type = TOK_SEMICOLON; break;\r\n   144\t                case ',': type = TOK_COMMA; break;\r\n   145\t                case '!': if (peek(lex)=='='){advance(lex);type=TOK_NEQ;strcpy(buf,\"!=\");}else{type=TOK_NOT;} break;\r\n   146\t                case '=': if (peek(lex)=='='){advance(lex);type=TOK_EQ;strcpy(buf,\"==\");}else{type=TOK_ASSIGN;} break;\r\n   147\t                case '<': if (peek(lex)=='='){advance(lex);type=TOK_LEQ;strcpy(buf,\"<=\");}else{type=TOK_LT;} break;\r\n   148\t                case '>': if (peek(lex)=='='){advance(lex);type=TOK_GEQ;strcpy(buf,\">=\");}else{type=TOK_GT;} break;\r\n   149\t                case '&': if (peek(lex)=='&'){advance(lex);type=TOK_AND;strcpy(buf,\"&&\");}\r\n   150\t                          else{error_at(lex->line,\"unexpected character '&'\");return -1;} break;\r\n   151\t                case '|': if (peek(lex)=='|'){advance(lex);type=TOK"]
[3874.184799, "o", "_OR;strcpy(buf,\"||\");}\r\n   152\t                          else{error_at(lex->line,\"unexpected character '|'\");return -1;} break;\r\n   153\t                default: error_at(lex->line, \"unexpected character '%c'\", c); return -1;\r\n   154\t            }\r\n   155\t            Token t = make_token(lex, type, buf);\r\n   156\t            if (add_token(lex, t) < 0) return -1;\r\n   157\t        }\r\n   158\t    }\r\n"]
[3874.184866, "o", "   159\t    Token eof = make_token(lex, TOK_EOF, \"\");\r\n   160\t    return add_token(lex, eof);\r\n   161\t}\r\n   162\t\r\n   163\tconst char *token_type_name(TokenType t) {\r\n   164\t    switch (t) {\r\n   165\t        case TOK_NUM: return \"NUM\"; case TOK_STRING: return \"STRING\"; case TOK_IDENT: return \"IDENT\";\r\n   166\t        case TOK_PLUS: return \"+\"; case TOK_MINUS: return \"-\"; case TOK_STAR: return \"*\";\r\n   167\t        case TOK_SLASH: return \"/\"; case TOK_PERCENT: return \"%\";\r\n   168\t        case TOK_EQ: return \"==\"; case TOK_NEQ: return \"!=\";\r\n   169\t        case TOK_LT: return \"<\"; case TOK_GT: return \">\"; case TOK_LEQ: return \"<=\"; case TOK_GEQ: return \">=\";\r\n   170\t        case TOK_ASSIGN: return \"=\"; case TOK_AND: return \"&&\"; case TOK_OR: return \"||\"; case TOK_NOT: return \"!\";\r\n   171\t        case TOK_LPAREN: return \"(\"; case TOK_RPAREN: return \")\";\r\n"]
[3874.184934, "o", "   172\t        case TOK_LBRACE: return \"{\"; case TOK_RBRACE: return \"}\";\r\n   173\t        case TOK_LBRACKET: return \"[\"; case TOK_RBRACKET: return \"]\";\r\n   174\t        case TOK_SEMICOLON: return \";\"; case TOK_COMMA: return \",\";\r\n   175\t        case TOK_IF: return \"if\"; case TOK_ELSE: return \"else\"; case TOK_WHILE: return \"while\";\r\n   176\t        case TOK_FOR: return \"for\"; case TOK_BREAK: return \"break\"; case TOK_CONTINUE: return \"continue\"; case TOK_IN: return \"in\";\r\n   177\t        case TOK_RETURN: return \"return\"; case TOK_FN: return \"fn\"; case TOK_LET: return \"let\";\r\n   178\t        case TOK_PRINT: return \"print\"; case TOK_TRUE: return \"true\"; case TOK_FALSE: return \"false\";\r\n   179\t        case TOK_PLUS_ASSIGN: return \"+=\"; case TOK_MINUS_ASSIGN: return \"-=\"; case TOK_STAR_ASSIGN: return \"*=\";\r\n"]
[3874.185038, "o", "   180\t        case TOK_SLASH_ASSIGN: return \"/=\"; case TOK_PERCENT_ASSIGN: return \"%=\";\r\n   181\t        case TOK_EOF: return \"EOF\"; case TOK_ERROR: return \"ERROR\";\r\n   182\t        default: return \"UNKNOWN\";\r\n   183\t    }\r\n   184\t}\r\n"]
