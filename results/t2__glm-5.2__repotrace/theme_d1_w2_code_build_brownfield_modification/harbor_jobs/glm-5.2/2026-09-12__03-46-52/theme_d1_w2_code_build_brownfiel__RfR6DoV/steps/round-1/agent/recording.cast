[7276.638461, "i", "cat > /tmp/closure_test.mini <<'EOF'\nlet n = 10;\nlet get = fn() { return n; };\nn = 20;\nprint get();\n\nfn make_counter(start) {\n    let count = start;\n    let inc = fn() { count = count + 1; return count; };\n    let get = fn() { return count; };\n    return [inc, get];\n}\nlet fns = make_counter(0);\nlet inc = fns[0];\nlet get = fns[1];\nprint inc();\nprint inc();\nprint get();\n\nfn make_pair() {\n    let val = 0;\n    let setter = fn(x) { val = x; };\n    let getter = fn() { return val; };\n    return [setter, getter];\n}\nlet p = make_pair();\nlet set = p[0];\nlet get2 = p[1];\nset(42);\nprint get2();\nEOF\n"]
