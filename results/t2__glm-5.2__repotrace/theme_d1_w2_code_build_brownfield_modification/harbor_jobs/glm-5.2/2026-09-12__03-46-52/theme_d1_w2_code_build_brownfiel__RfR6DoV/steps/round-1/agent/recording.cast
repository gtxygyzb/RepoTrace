[4437.350187, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/codegen.c')\ns = p.read_text()\nif 'emit(c, BC_ADD, 0, NULL);\\n            emit(c, BC_STORE_LOCAL, idx_slot, NULL);\\n            emit(c, BC_JUMP, loop_start, NULL);' not in s:\n    s = s.replace('emit(c, BC_ADD, 0, NULL);\\n            emit(c, BC_JUMP, loop_start, NULL);',\n                  'emit(c, BC_ADD, 0, NULL);\\n            emit(c, BC_STORE_LOCAL, idx_slot, NULL);\\n            emit(c, BC_JUMP, loop_start, NULL);')\np.write_text(s)\nPY\n"]
