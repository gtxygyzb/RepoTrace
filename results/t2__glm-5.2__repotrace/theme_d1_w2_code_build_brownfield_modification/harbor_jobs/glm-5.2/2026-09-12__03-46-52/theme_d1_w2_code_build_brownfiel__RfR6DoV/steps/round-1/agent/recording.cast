[7744.119198, "o", "#include \"vm.h\"\r\n#include <string.h>\r\n\r\nstatic void push(VM *vm, Value v) {\r\n    if (vm->sp >= MAX_STACK) { fprintf(stderr, \"stack overflow\\n\"); exit(1); }\r\n"]
[7744.119218, "o", "    vm->stack[vm->sp++] = v;\r\n"]
[7744.119227, "o", "}"]
[7744.119365, "o", "\r\n\r\nstatic Value pop(VM *vm) {\r\n    if (vm->sp <= 0) { fprintf(stderr, \"stack underflow\\n\"); exit(1); }\r\n    return vm->stack[--vm->sp];\r\n}\r\n\r\nstatic Value make_int(int64_t v) { Value val; val.type = VAL_INT; val.data.ival = v; return val; }\r\nstatic Value make_str(const char *s) { Value val; val.type = VAL_STR; val.data.sval = strdup(s); return val; }\r\nstatic Value make_bool(int b) { Value val; val.type = VAL_BOOL; val.data.bval = b; return val; }\r\n\r\nstatic Value make_map(void) {\r\n"]
[7744.11938, "o", "    Value val; val.type = VAL_MAP; val.data.map = malloc(sizeof(MapData));\r\n    val.data.map->keys = NULL; val.data.map->values = NULL; val.data.map->len = 0; val.data.map->cap = 0;\r\n    return val;\r\n}\r\n\r\nstatic int map_find(MapData *m, const char *key) {\r\n    for (int i = 0; i < m->len; i++) if (strcmp(m->keys[i], key) == 0) return i;\r\n    return -1;\r\n}\r\n\r\nstatic void map_set(MapData *m, const char *key, Value v) {\r\n    int i = map_find(m, key);\r\n    if (i >= 0) { m->values[i] = v; return; }\r\n"]
[7744.119459, "o", "    if (m->len >= m->cap) {\r\n        int cap = m->cap == 0 ? 8 : m->cap * 2;\r\n        m->keys = realloc(m->keys, cap * sizeof(char*));\r\n        m->values = realloc(m->values, cap * sizeof(Value));\r\n        m->cap = cap;\r\n    }\r\n    m->keys[m->len] = strdup(key);\r\n    m->values[m->len] = v;\r\n    m->len++;\r\n}\r\n\r\nstatic int map_delete(MapData *m, const char *key) {\r\n    int i = map_find(m, key);\r\n    if (i < 0) return 0;\r\n    free(m->keys[i]);\r\n    for (int j = i; j < m->len - 1; j++) { m->keys[j] = m->keys[j+1]; m->values[j] = m->values[j+1]; }\r\n    m->len--;\r\n    return 1;\r\n"]
[7744.119471, "o", "}\r\n\r\n\r\n"]
[7744.119536, "o", "static int resolve_global(VM *vm, const char *name) {\r\n    for (int i = 0; i < vm->global_count; i++)\r\n        if (strcmp(vm->global_names[i], name) == 0) return i;\r\n    return -1;\r\n}\r\n\r\nstatic int add_global(VM *vm, const char *name) {\r\n    if (vm->global_count >= MAX_GLOBALS) { fprintf(stderr, \"too many globals\\n\"); return -1; }\r\n"]
[7744.120107, "o", "\u001b[?2004h"]
[7744.120183, "o", "root@n30009:/app# "]
[7744.417997, "i", "sed -n '420,470p' src/vm.c\n"]
[7744.418386, "o", "sed -n '420,470p' src/vm.c\r\n\u001b[?2004l\r"]
[7744.422255, "o", "                }\r\n                push(vm, mv); break;\r\n            }\r\n            case BC_MAP_GET: {\r\n"]
[7744.422421, "o", "                Value keyv = pop(vm); Value obj = pop(vm);\r\n                if (obj.type != VAL_MAP) { fprintf(stderr, \"cannot get field of non-map\\n\"); return -1; }\r\n                char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));\r\n                int i = map_find(obj.data.map, key);\r\n                if (i < 0) { fprintf(stderr, \"key not found: %s\\n\", key); return -1; }\r\n                push(vm, obj.data.map->values[i]); break;\r\n            }\r\n            case BC_MAP_SET: {\r\n                Value val = pop(vm); Value keyv = pop(vm); Value obj = pop(vm);\r\n                if (obj.type != VAL_MAP) { fprintf(stderr, \"cannot set field on non-map\\n\"); return -1; }\r\n                char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));\r\n                map_set(obj.data.map, key, val); break;\r\n            }\r\n            case BC_MAP_KEYS: {\r\n                Value obj = pop(vm);\r\n                if (obj.type != VAL_MAP) { fprintf(stderr, \"keys() expects a map\\n\"); return -1; }\r\n    "]
[7744.422523, "o", "            Value arr; arr.type = VAL_ARRAY; arr.data.array.len = obj.data.map->len;\r\n                arr.data.array.items = malloc(obj.data.map->len * sizeof(Value));\r\n                for (int i = 0; i < obj.data.map->len; i++) arr.data.array.items[i] = make_str(obj.data.map->keys[i]);\r\n                push(vm, arr); break;\r\n            }\r\n            case BC_MAP_HAS: {\r\n                Value keyv = pop(vm); Value obj = pop(vm);\r\n                if (obj.type != VAL_MAP) { fprintf(stderr, \"has() expects a map\\n\"); return -1; }\r\n                char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));\r\n                push(vm, make_bool(map_find(obj.data.map, key) >= 0)); break;\r\n            }\r\n            case BC_MAP_DELETE: {\r\n                Value keyv = pop(vm); Value obj = pop(vm);\r\n                if (obj.type != VAL_MAP) { fprintf(stderr, \"delete() expects a map\\n\"); return -1; }\r\n                char buf[64]; const char *key = value_to_key(keyv, buf, sizeof(buf));\r\n                push(vm, "]
[7744.422591, "o", "make_bool(map_delete(obj.data.map, key))); break;\r\n            }\r\n            case BC_MAP_LEN: {\r\n                Value obj = pop(vm);\r\n                if (obj.type != VAL_MAP) push(vm, make_int(0));\r\n                else push(vm, make_int(obj.data.map ? obj.data.map->len : 0));\r\n                break;\r\n            }\r\n            case BC_ITER_KEY: {\r\n                Value idx = pop(vm); Value arr = pop(vm);\r\n"]
[7744.422675, "o", "                if (arr.type == VAL_MAP) {\r\n                    int i = (int)value_to_int(idx);\r\n                    if (i < 0 || i >= arr.data.map->len) { fprintf(stderr, \"map index out of bounds: %d\\n\", i); return -1; }\r\n                    push(vm, make_str(arr.data.map->keys[i]));\r\n                } else {\r\n                    push(vm, idx);\r\n"]
