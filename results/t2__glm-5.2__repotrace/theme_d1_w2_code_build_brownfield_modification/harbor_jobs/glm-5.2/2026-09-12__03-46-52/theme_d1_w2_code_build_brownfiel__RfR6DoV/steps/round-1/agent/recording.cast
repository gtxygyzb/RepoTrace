[362.733684, "o", "lse\";\r\n   167\t        case TOK_EOF: return \"EOF\"; case TOK_ERROR: return \"ERROR\";\r\n   168\t        default: return \"UNKNOWN\";\r\n   169\t    }\r\n   170\t}\r\n"]
