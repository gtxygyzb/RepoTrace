[5299.477106, "o", "   135\t            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;\r\n   136\t            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;\r\n   137\t            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;\r\n   138\t            default: op = OP_EQ; break;\r\n   139\t        }\r\n   140\t        ASTNode *right = parse_term(p);\r\n   141\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   142\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   143\t        left = n;\r\n   144\t    }\r\n   145\t    return left;\r\n   146\t}\r\n"]
[5299.477183, "o", "   147\t\r\n   148\tstatic ASTNode *parse_term(Parser *p) {\r\n   149\t    ASTNode *left = parse_factor(p);\r\n   150\t    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {\r\n   151\t        int line = prev(p)->line;\r\n   152\t        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;\r\n   153\t        ASTNode *right = parse_factor(p);\r\n   154\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   155\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   156\t        left = n;\r\n   157\t    }\r\n"]
