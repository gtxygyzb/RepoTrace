[331.78636, "o", "   209\tvoid compiler_init(Compiler *c) {\r\n   210\t    c->code_count = 0; c->local_count = 0; c->scope_depth = 0;\r\n   211\t    c->func_count = 0; c->in_function = 0;\r\n   212\t}\r\n   213\t\r\n   214\tint compile(Compiler *c, ASTNode *program) {\r\n   215\t    if (compile_node(c, program) < 0) return -1;\r\n   216\t    emit(c, BC_HALT, 0, NULL);\r\n   217\t    return 0;\r\n   218\t}\r\n"]
