[10997.796507, "o", "\u001b[?2004h> "]
[10997.797095, "o", "                if (fi < 0) { fprintf(stderr, \"cannot call non-function value\\\\n\"); return -1; }\r\n\u001b[?2004l\r"]
[10997.797172, "o", "\u001b[?2004h> "]
[10997.797464, "o", "                FuncInfo *func = &vm->functions[fi];\r\n\u001b[?2004l\r"]
[10997.797494, "o", "\u001b[?2004h> "]
