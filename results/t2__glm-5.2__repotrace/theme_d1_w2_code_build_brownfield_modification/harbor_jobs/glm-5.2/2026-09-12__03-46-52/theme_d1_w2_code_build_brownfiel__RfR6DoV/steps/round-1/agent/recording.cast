[330.619178, "o", "   118\t            char buf[4] = {c, '\\0', '\\0', '\\0'};\r\n   119\t            TokenType type = TOK_ERROR;\r\n   120\t            switch (c) {\r\n   121\t                case '+': type = TOK_PLUS; break;\r\n   122\t                case '-': type = TOK_MINUS; break;\r\n   123\t                case '*': type = TOK_STAR; break;\r\n   124\t                case '/': type = TOK_SLASH; break;\r\n   125\t                case '%': type = TOK_PERCENT; break;\r\n   126\t                case '(': type = TOK_LPAREN; break;\r\n   127\t                case ')': type = TOK_RPAREN; break;\r\n   128\t                case '{': type = TOK_LBRACE; break;\r\n   129\t                case '}': type = TOK_RBRACE; break;\r\n"]
