[7684.787292, "o", "\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case BC_PUSH_STR: push(vm, \u001b[01;31m\u001b[Kmake_str\u001b[m\u001b[K(ins->str_operand)); break;\r\n\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            case BC_PUSH_BOOL: push(vm, \u001b[01;31m\u001b[Kmake_bool\u001b[m\u001b[K((int)ins->operand)); break;\r\n\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                if (a.type == \u001b[01;31m\u001b[KVAL_STR\u001b[m\u001b[K || b.type == \u001b[01;31m\u001b[KVAL_STR\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                    char *r = malloc(\u001b[01;31m\u001b[Kstrlen\u001b[m\u001b[K(sa) + \u001b[01;31m\u001b[Kstrlen\u001b[m\u001b[K(sb) + 1);\r\n"]
[7684.787338, "o", "\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                    Value v; v.type = \u001b[01;31m\u001b[KVAL_STR\u001b[m\u001b[K; v.data.sval = r; push(vm, v);\r\n\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                } else { push(vm, \u001b[01;31m\u001b[Kmake_int\u001b[m\u001b[K(value_to_int(a) + value_to_int(b))); }\r\n\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                push(vm, \u001b[01;31m\u001b[Kmake_int\u001b[m\u001b[K(value_to_int(a) - value_to_int(b))); break; }\r\n\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                push(vm, \u001b[01;31m\u001b[Kmake_int\u001b[m\u001b[K(value_to_int(a) * value_to_int(b))); break; }"]
