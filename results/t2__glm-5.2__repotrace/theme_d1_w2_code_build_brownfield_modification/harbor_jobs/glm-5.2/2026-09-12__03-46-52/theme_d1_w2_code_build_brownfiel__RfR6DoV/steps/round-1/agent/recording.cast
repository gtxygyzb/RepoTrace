[5780.295424, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/codegen.c')\ns = p.read_text()\n\n# Add builtin helper after find_function\ns = s.replace('''static int find_function(Compiler *c, const char *name) {\n    for (int i = 0; i < c->func_count; i++) {\n        if (strcmp(c->functions[i].name, name) == 0) return i;\n    }\n    return -1;\n}\n''', '''static int find_function(Compiler *c, const char *name) {\n    for (int i = 0; i < c->func_count; i++) {\n        if (strcmp(c->functions[i].name, name) == 0) return i;\n    }\n    return -1;\n}\n\nstatic int is_builtin(const char *name) {\n    return strcmp(name, \"len\") == 0 || strcmp(name, \"keys\") == 0 ||\n           strcmp(name, \"delete\") == 0 || strcmp(name, \"has\") == 0;\n}\n''')\n\n# Replace NODE_INDEX and NODE_ARRAY_LIT cases and add map/field cases in compile_expr\nold = '''        case NODE_INDEX:\n            compile_expr(c, node->data.index_access.obj);\n            compile_expr(c, node->data.index_access.index);\n            emit(c, BC_INDEX, 0, NULL); break;\n        case NODE_A"]
[5780.295738, "i", "RRAY_LIT:\n            for (int i = 0; i < node->data.array_lit.elems.count; i++)\n                compile_expr(c, node->data.array_lit.elems.items[i]);\n            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;\n        default:\n'''\nnew = '''        case NODE_INDEX:\n            compile_expr(c, node->data.index_access.obj);\n            compile_expr(c, node->data.index_access.index);\n            emit(c, BC_INDEX, 0, NULL); break;\n        case NODE_ARRAY_LIT:\n            for (int i = 0; i < node->data.array_lit.elems.count; i++)\n                compile_expr(c, node->data.array_lit.elems.items[i]);\n            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;\n        case NODE_MAP_LIT: {\n            int count = node->data.map_lit.keys.count;\n            for (int i = 0; i < count; i++) {\n                compile_expr(c, node->data.map_lit.keys.items[i]);\n                compile_expr(c, node->data.map_lit.values.items[i]);\n            }\n            emit(c, BC_PUSH_MAP, coun"]
[5780.295771, "o", "python3 - <<'PY'\r\n\u001b[?2004l\rRRAY_LIT:\r\n            for (int i = 0; i < node->data.array_lit.elems.count; i++)\r\n             "]
[5780.295908, "i", "t, NULL); break;\n        }\n        case NODE_FIELD_ACCESS:\n            compile_expr(c, node->data.field_access.obj);\n            emit(c, BC_PUSH_STR, 0, strdup(node->data.field_access.field));\n            emit(c, BC_MAP_GET, 0, NULL); break;\n        default:\n'''\ns = s.replace(old, new)\n\n# Add builtins in NODE_CALL before function lookup\nold_call = '''        case NODE_CALL: {\n            int fi = find_function(c, node->data.call.name);\n            if (fi < 0) { error_at(node->line, \"undefined function '%s'\", node->data.call.name); return -1; }\n            for (int i = 0; i < node->data.call.args.count; i++)\n                compile_expr(c, node->data.call.args.items[i]);\n            emit(c, BC_CALL, fi, NULL);\n            break;\n        }\n'''\nnew_call = '''        case NODE_CALL: {\n            const char *name = node->data.call.name;\n            if (strcmp(name, \"len\") == 0) {\n                if (node->data.call.args.count != 1) { error_at(node->line, \"len() expects 1 argument\"); return -1; }\n                c"]
