[363.008786, "o", "     1\t#include \"parser.h\"\r\n     2\t\r\n     3\tstatic Token *current(Parser *p) { return &p->tokens[p->pos]; }\r\n     4\tstatic Token *prev(Parser *p) { return &p->tokens[p->pos - 1]; }\r\n     5\tstatic int check(Parser *p, TokenType t) { return current(p)->type == t; }\r\n     6\t\r\n     7"]
[363.008945, "o", "\tstatic int match(Parser *p, TokenType t) {\r\n     8\t    if (check(p, t)) { p->pos++; return 1; }\r\n     9\t    return 0;\r\n    10\t}\r\n    11\t\r\n    12\tstatic void expect(Parser *p, TokenType t, const char *msg) {\r\n    13\t    if (!match(p, t)) {\r\n    14\t        error_at(current(p)->line, \"expected %s, got '%s'\", msg, current(p)->text);\r\n    15\t        p->had_error = 1;\r\n    16\t    }\r\n    17\t}\r\n    18\t\r\n    19\tstatic ASTNode *parse_expr(Parser *p);\r\n    20\tstatic ASTNode *parse_stmt(Parser *p);\r\n    21\tstatic ASTNode *parse_block(Parser *p);\r\n    22\t\r\n    23\tstatic ASTNode *parse_primary(Parser *p) {\r\n    24\t    if (match(p, TOK_NUM)) {\r\n    25\t        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;\r\n    26\t        n->data.num_val = prev(p)->literal.ival; return n;\r\n    27\t    }\r\n    28\t    if (match(p, TOK_STRING)) {\r\n    29\t        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;\r\n    30\t        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return"]
[363.00905, "o", " n;\r\n    31\t    }\r\n    32\t    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {\r\n    33\t        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;\r\n    34\t        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;\r\n    35\t    }\r\n    36\t    if (match(p, TOK_IDENT)) {\r\n    37\t        char name[MAX_IDENT_LEN];\r\n    38\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\\0';\r\n    39\t        int line = prev(p)->line;\r\n    40\t        if (match(p, TOK_LPAREN)) {\r\n    41\t            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;\r\n    42\t            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);\r\n    43\t            nodelist_init(&n->data.call.args);\r\n    44\t            if (!check(p, TOK_RPAREN)) {\r\n    45\t                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));\r\n    46\t            }\r\n    47"]
[363.009128, "o", "\t            expect(p, TOK_RPAREN, \"')'\"); return n;\r\n    48\t        }\r\n    49\t        if (match(p, TOK_LBRACKET)) {\r\n    50\t            ASTNode *idx = parse_expr(p); expect(p, TOK_RBRACKET, \"']'\");\r\n    51\t            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;\r\n    52\t            ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;\r\n    53\t            strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);\r\n    54\t            n->data.index_access.obj = obj; n->data.index_access.index = idx; return n;\r\n    55\t        }\r\n    56\t        ASTNode *n = ast_alloc(); n->type = NODE_IDENT; n->line = line;\r\n"]
[363.009271, "o", "    57\t        strncpy(n->data.ident, name, MAX_IDENT_LEN - 1); return n;\r\n    58\t    }\r\n    59\t    if (match(p, TOK_LBRACKET)) {\r\n    60\t        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;\r\n    61\t        nodelist_init(&n->data.array_lit.elems);\r\n    62\t        if (!check(p, TOK_RBRACKET)) {\r\n    63\t            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));\r\n    64\t        }\r\n    65\t        expect(p, TOK_RBRACKET, \"']'\"); return n;\r\n    66\t    }\r\n    67\t    if (match(p, TOK_LPAREN)) {\r\n    68\t        ASTNode *expr = parse_expr(p); expect(p, TOK_RPAREN, \"')'\"); return expr;\r\n    69\t    }\r\n    70\t    error_at(current(p)->line, \"unexpected token '%s'\", current(p)->text);\r\n"]
[363.009347, "o", "    71\t    p->had_error = 1; p->pos++; return ast_alloc();\r\n    72\t}\r\n    73\t\r\n    74\tstatic ASTNode *parse_unary(Parser *p) {\r\n    75\t    if (match(p, TOK_MINUS)) {\r\n    76\t        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n    77\t        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n    78\t        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;\r\n    79\t    }\r\n    80\t    if (match(p, TOK_NOT)) {\r\n    81\t        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n"]
[363.009454, "o", "    82\t        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n    83\t        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;\r\n    84\t    }\r\n    85\t    return parse_primary(p);\r\n    86\t}\r\n    87\t\r\n    88\tstatic ASTNode *parse_factor(Parser *p) {\r\n    89\t    ASTNode *left = parse_unary(p);\r\n    90\t    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {\r\n    91\t        int line = prev(p)->line; BinOp op;\r\n    92\t        if (prev(p)->type == TOK_STAR) op = OP_MUL;\r\n    93\t        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;\r\n    94\t        else op = OP_MOD;\r\n    95\t        ASTNode *right = parse_unary(p);\r\n    96\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n    97\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n    98\t        left = n;\r\n"]
[363.00954, "o", "    99\t    }\r\n   100\t    return left;\r\n   101\t}\r\n   102\t\r\n   103\t/* NOTE: comparison operators are parsed at a tighter binding than +/-,\r\n   104\t   which is buggy: `a + b == c` is parsed as `a + (b == c)` instead of\r\n   105\t   `(a + b) == c`. */\r\n   106\tstatic ASTNode *parse_comparison(Parser *p) {\r\n   107\t    ASTNode *left = parse_factor(p);\r\n   108\t    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||\r\n   109\t           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {\r\n"]
[363.00962, "o", "   110\t        int line = prev(p)->line; BinOp op;\r\n   111\t        switch (prev(p)->type) {\r\n   112\t            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;\r\n   113\t            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;\r\n   114\t            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;\r\n   115\t            default: op = OP_EQ; break;\r\n   116\t        }\r\n   117\t        ASTNode *right = parse_factor(p);\r\n   118\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   119\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   120\t        left = n;\r\n   121\t    }\r\n   122\t    return left;\r\n"]
[363.009706, "o", "   123\t}\r\n   124\t\r\n   125\tstatic ASTNode *parse_term(Parser *p) {\r\n   126\t    ASTNode *left = parse_comparison(p);\r\n   127\t    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {\r\n   128\t        int line = prev(p)->line;\r\n   129\t        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;\r\n   130\t        ASTNode *right = parse_comparison(p);\r\n   131\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   132\t        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n   133\t        left = n;\r\n   134\t    }\r\n   135"]
[363.009793, "o", "\t    return left;\r\n   136\t}\r\n   137\t\r\n   138\tstatic ASTNode *parse_logic_and(Parser *p) {\r\n   139\t    ASTNode *left = parse_term(p);\r\n   140\t    while (match(p, TOK_AND)) {\r\n   141\t"]
[363.009871, "o", "        int line = prev(p)->line; ASTNode *right = parse_term(p);\r\n   142\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   143\t        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;\r\n   144\t        left = n;\r\n   145\t    }\r\n   146\t    return left;\r\n   147\t}\r\n   148\t\r\n   149\tstatic ASTNode *parse_expr(Parser *p) {\r\n   150\t    ASTNode *left = parse_logic_and(p);\r\n   151\t    while (match(p, TOK_OR)) {\r\n   152\t        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);\r\n   153\t        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n   154\t        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;\r\n"]
[363.009944, "o", "   155\t        left = n;\r\n   156\t    }\r\n   157\t    return left;\r\n   158\t}\r\n   159\t\r\n   160\tstatic ASTNode *try_parse_assign(Parser *p) {\r\n   161\t    if (!check(p, TOK_IDENT)) return NULL;\r\n   162\t    int saved = p->pos;\r\n   163\t    p->pos++;\r\n   164\t    if (check(p, TOK_ASSIGN)) {\r\n   165\t        p->pos = saved; match(p, TOK_IDENT);\r\n   166\t        char name[MAX_IDENT_LEN];\r\n   167\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n   168\t        int line = prev(p)->line;\r\n   169\t        expect(p, TOK_ASSIGN, \"'='\");\r\n   170\t        ASTNode *val = parse_expr(p);\r\n   171\t        ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;\r\n   172\t        strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);\r\n"]
