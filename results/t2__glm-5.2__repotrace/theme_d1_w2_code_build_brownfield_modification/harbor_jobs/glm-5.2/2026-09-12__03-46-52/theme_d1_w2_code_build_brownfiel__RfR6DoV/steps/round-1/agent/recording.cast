[363.592966, "o", "\t                case OP_GT:  emit(c, BC_GT, 0, NULL); break;\r\n    69\t                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;\r\n    70\t                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;\r\n    71\t                case OP_AND: emit(c, BC_AND, 0, NULL); break;\r\n    72\t                case OP_OR:  emit(c, BC_OR, 0, NULL); break;\r\n    73\t            }\r\n    74\t            break;\r\n    75\t        case NODE_UNARY:\r\n    76\t            compile_expr(c, node->data.unary.operand);\r\n"]
[363.593039, "o", "    77\t            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);\r\n    78\t            else emit(c, BC_NOT, 0, NULL);\r\n    79\t            break;\r\n    80\t        case NODE_CALL: {\r\n    81\t            int fi = find_function(c, node->data.call.name);\r\n    82\t            if (fi < 0) { error_at(node->line, \"undefined function '%s'\", node->data.call.name); return -1; }\r\n    83\t            for (int i = 0; i < node->data.call.args.count; i++)\r\n    84\t                compile_expr(c, node->data.call.args.items[i]);\r\n    85\t            emit(c, BC_CALL, fi, NULL);\r\n    86\t            break;\r\n    87\t        }\r\n    88\t"]
