[1947.828887, "o", "   341\t        char name[MAX_IDENT_LEN];\r\n   342\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n   343\t        expect(p, TOK_LPAREN, \"'('\");\r\n   344\t        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;\r\n   345\t        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);\r\n   346\t        n->data.func.param_count = 0;\r\n   347\t        if (!check(p, TOK_RPAREN)) {\r\n   348\t            do {\r\n   349\t                expect(p, TOK_IDENT, \"parameter name\");\r\n   350\t                strncpy(n->data.func.params[n->data.func.param_count],\r\n   351\t                        prev(p)->text, MAX_IDENT_LEN - 1);\r\n   352\t                n->data.func.param_count++;\r\n   353\t            } while (match(p, TOK_COMMA));\r\n   354\t        }\r\n   355\t        expect(p, TOK_RPAREN, \"')'\");\r\n   356\t        n->data.func.body = parse_block(p); return n;\r\n   357\t    }\r\n   358\t    if (check(p, TOK_IDENT)) {\r\n   359\t        ASTNode *a = try_parse_assign(p);\r\n"]
