[330.618918, "o", "    80\t    Token t = make_token(lex, TOK_STRING, buf);\r\n    81\t    return add_token(lex, t);\r\n    82\t}\r\n    83\t\r\n    84\tstatic int lex_ident(Lexer *lex) {\r\n    85\t    char buf[MAX_IDENT_LEN]; int i = 0;\r\n    86\t    while (!is_at_end(lex) && (isalnum(peek(lex)) || peek(lex) == '_')) {\r\n    87\t        if (i < MAX_IDENT_LEN - 1) buf[i++] = advance(lex); else advance(lex);\r\n    88\t    }\r\n    89\t    buf[i] = '\\0';\r\n    90\t    TokenType type = TOK_IDENT;\r\n"]
