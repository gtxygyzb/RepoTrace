[7618.214888, "o", "    13\t\r\n    14\tstatic Value make_int(int64_t v) { Value val; val.type = VAL_INT; val.data.ival = v; return val; }\r\n    15\tstatic Value make_str(const char *s) { Value val; val.type = VAL_STR; val.data.sval = strdup(s); return val; }\r\n    16\tstatic Value make_bool(int b) { Value val; val.type = VAL_BOOL; val.data.bval = b; return val; }\r\n    17\t\r\n    18\tstatic Value make_map(void) {\r\n    19\t    Value val; val.type = VAL_MAP; val.data.map = malloc(sizeof(MapData));\r\n    20\t    val.data.map->keys = NULL; val.data.map->values = NULL; val.data.map->len = 0; val.data.map->cap = 0;\r\n    21\t    return val;\r\n    22\t}\r\n    23\t\r\n    24\tstatic int map_find(MapData *m, const char *key) {\r\n    25\t    for (int i = 0; i < m->len; i++) if (strcmp(m->keys[i], key) == 0) return i;\r\n    26\t    return -1;\r\n    27\t}\r\n    28\t\r\n    29\tstatic void map_set(MapData *m, const char *key, Value v) {\r\n    30\t    int i = map_find(m, key);\r\n    31\t    if (i >= 0) { m->values[i] = v; return; }\r\n    32\t    if (m->len >= m->cap) {\r\n    33\t    "]
[7618.214985, "o", "    int cap = m->cap == 0 ? 8 : m->cap * 2;\r\n    34\t        m->keys = realloc(m->keys, cap * sizeof(char*));\r\n    35\t        m->values = realloc(m->values, cap * sizeof(Value));\r\n    36\t        m->cap = cap;\r\n    37\t    }\r\n    38\t    m->keys[m->len] = strdup(key);\r\n    39\t    m->values[m->len] = v;\r\n    40\t    m->len++;\r\n    41\t}\r\n    42\t\r\n    43\tstatic int map_delete(MapData *m, const char *key) {\r\n    44\t    int i = map_find(m, key);\r\n    45\t    if (i < 0) return 0;\r\n    46\t    free(m->keys[i]);\r\n    47\t    for (int j = i; j < m->len - 1; j++) { m->keys[j] = m->keys[j+1]; m->values[j] = m->values[j+1]; }\r\n    48\t    m->len--;\r\n    49\t    return 1;\r\n    50\t}\r\n    51\t\r\n"]
