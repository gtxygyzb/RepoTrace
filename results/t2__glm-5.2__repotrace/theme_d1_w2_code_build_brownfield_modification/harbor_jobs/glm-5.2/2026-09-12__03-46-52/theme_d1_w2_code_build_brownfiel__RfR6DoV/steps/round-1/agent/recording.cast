[3914.621404, "o", "     if (add_token(lex, t) < 0) return -1;\r\n   157\t        }\r\n   158\t    }\r\n   159\t    Token eof = make_token(lex, TOK_EOF, \"\");\r\n   160\t    return add_token(lex, eof);\r\n   161\t}\r\n   162\t\r\n   163\tconst char *token_type_name(TokenType t) {\r\n   164\t    switch (t) {\r\n   165\t        case TOK_NUM: return \"NUM\"; case TOK_STRING: return \"STRING\"; case TOK_IDENT: return \"IDENT\";\r\n   166\t        case TOK_PLUS: return \"+\"; case TOK_MINUS: return \"-\"; case TOK_STAR: return \"*\";\r\n   167\t        case TOK_SLASH: return \"/\"; case TOK_PERCENT: return \"%\";\r\n   168\t        case TOK_EQ: return \"==\"; case TOK_NEQ: return \"!=\";\r\n   169\t        case TOK_LT: return \"<\"; case TOK_GT: return \">\"; case TOK_LEQ: return \"<=\"; case TOK_GEQ: return \">=\";\r\n"]
