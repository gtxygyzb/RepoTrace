[5273.34461, "o", "    BC_DUP, BC_JUMP_TRUE,\r\n    BC_MAKE_CLOSURE, BC_CALL_VALUE,\r\n    BC_LOAD_CAPTURE, BC_STORE_CAPTURE,\r\n    BC_HALT,\r\n    BC_ARRAY_LEN, BC_ARRAY_GET,\r\n    BC_BREAK, BC_CONTINUE,\r\n    BC_FOREACH_PREP, BC_FOREACH_NEXT\r\n} Opcode;\r\n\r\ntypedef enum {\r\n    VAL_INT, VAL_STR, VAL_BOOL, VAL_ARRAY, VAL_CLOSURE, VAL_NULL\r\n} ValueType;\r\n"]
[5273.344662, "o", "\r\ntypedef struct ArrayData {\r\n    struct Value *items;\r\n    int len;\r\n    int cap;\r\n} ArrayData;\r\n\r\ntypedef struct Value {\r\n    ValueType type;\r\n    union {\r\n        int64_t ival;\r\n        char *sval;"]
[5273.344677, "o", "\r\n        int bval;\r\n        ArrayData array;\r\n        struct { int func_idx; struct Value *captures; int capture_count; } closure;\r\n    } data;\r\n} Value;\r\n\r\ntypedef struct {\r\n"]
[5273.344748, "o", "    Opcode op;\r\n    int64_t operand;\r\n    char *str_operand;\r\n} Instruction;\r\n\r\ntypedef struct {\r\n    int ip;\r\n    int bp;\r\n    int local_start;\r\n    struct Value *captures;\r\n    int capture_count;\r\n} CallFrame;\r\n"]
[5273.344763, "o", "\r\nvoid error_at(int line, const char *fmt, ...);\r\n"]
[5273.344774, "o", "\r\n#endif\r\n"]
