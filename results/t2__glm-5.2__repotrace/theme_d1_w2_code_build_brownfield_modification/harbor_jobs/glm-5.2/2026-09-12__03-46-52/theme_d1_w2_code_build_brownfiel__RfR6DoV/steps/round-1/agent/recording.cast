[8901.124785, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/codegen.c')\ns = p.read_text()\n\n# Add try_depth global and field in LoopCtx\ns = s.replace(\n'''static LoopCtx loop_stack[MAX_LOOP_DEPTH];\nstatic int loop_depth = 0;\n''',\n'''static LoopCtx loop_stack[MAX_LOOP_DEPTH];\nstatic int loop_depth = 0;\nstatic int try_depth = 0;\n''')\n\ns = s.replace(\n'''typedef struct {\n    int start;\n    int cont;\n    int end;\n    int breaks[MAX_LOOP_JUMPS];\n    int break_count;\n    int conts[MAX_LOOP_JUMPS];\n    int cont_count;\n} LoopCtx;\n''',\n'''typedef struct {\n    int start;\n    int cont;\n    int end;\n    int try_depth;\n    int breaks[MAX_LOOP_JUMPS];\n    int break_count;\n    int conts[MAX_LOOP_JUMPS];\n    int cont_count;\n} LoopCtx;\n''')\n\n# Set try_depth in loop contexts (while)\ns = s.replace(\n'''            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\n            ctx->break_count = 0; ctx->cont_count = 0;\n''',\n'''            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\n            ctx->try_depth = try_depth"]
[8901.125104, "i", ";\n            ctx->break_count = 0; ctx->cont_count = 0;\n''')\n\n# Set try_depth in for and foreach contexts: after ctx creation lines\ns = s.replace(\n'''            LoopCtx *ctx = &loop_stack[loop_depth++];\n            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\n            ctx->break_count = 0; ctx->cont_count = 0;\n''',\n'''            LoopCtx *ctx = &loop_stack[loop_depth++];\n            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\n            ctx->try_depth = try_depth;\n            ctx->break_count = 0; ctx->cont_count = 0;\n''')\n\ns = s.replace(\n'''            LoopCtx *ctx = &loop_stack[loop_depth++];\n            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\n            ctx->break_count = 0; ctx->cont_count = 0;\n''',\n'''            LoopCtx *ctx = &loop_stack[loop_depth++];\n            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\n            ctx->try_depth = try_depth;\n            ctx->break_count = 0; ctx->cont_count = 0;\n''')\n\n# NODE_TRY: increment/decrement try_dep"]
