[5395.198963, "o", "\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic ASTNode *\u001b[01;31m\u001b[Kparse_for\u001b[m\u001b[K(Parser *p) {\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int line = prev(p)->line;\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_LPAREN, \"'('\");\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[5395.199078, "o", "\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (check(p, TOK_IDENT) && p->pos + 1 < p->count &&\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        (p->tokens[p->pos + 1].type == TOK_IN || p->tokens[p->pos + 1].type == TOK_OF)) {\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        char name[MAX_IDENT_LEN];\r\n\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        match(p, TOK_IDENT);\r\n\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int is_of = match(p, TOK_OF);\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (!is_of) match(p, TOK_IN);\r\n"]
[5395.199159, "o", "\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *arr = parse_expr(p);\r\n\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_RPAREN, \"')'\");\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *body = parse_block(p);\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;\r\n\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);\r\n\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.foreach_stmt.arr = arr;\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.foreach_stmt.body = body;\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.foreach_stmt.is_of = is_of;\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        return n;\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *init = NULL;\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_LET)) {\r\n\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_IDENT, \"identifier\");\r\n\u001b[32m\u001b[K257\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        char name[MAX_"]
[5395.19927, "o", "IDENT_LEN];\r\n\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_ASSIGN, \"'='\");\r\n\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *init_expr = parse_expr(p);\r\n\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);\r\n\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        init->data.let.init = init_expr;\r\n\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else if (check(p, TOK_IDENT)) {\r\n\u001b[32m\u001b[K265\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        init = try_parse_assign(p);\r\n\u001b[32m\u001b[K266\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (!init) init = parse_expr(p);\r\n\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else if (!check(p, TOK_SEMICOLON)) {\r\n\u001b[32m\u001b[K268\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        init = parse_expr(p);\r\n\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_SEMICOLON, \"';'\");\r"]
[5395.199341, "o", "\n\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *cond = NULL;\r\n\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);\r\n\u001b[32m\u001b[K274\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[32m\u001b[K275\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *step = NULL;\r\n\u001b[32m\u001b[K277\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!check(p, TOK_RPAREN)) {\r\n\u001b[32m\u001b[K278\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (check(p, TOK_IDENT)) {\r\n\u001b[32m\u001b[K279\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            step = try_parse_assign(p);\r\n\u001b[32m\u001b[K280\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K281\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (!step) step = parse_expr(p);\r\n\u001b[32m\u001b[K282\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K283\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_RPAREN, \"')'\");\r\n\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K285\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *body = parse_block(p);\r\n\u001b[32m\u001b[K286\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;\r\n\u001b[32m\u001b[K287\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.fo"]
[5395.199411, "o", "r_stmt.init = init;\r\n\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.for_stmt.cond = cond;\r\n\u001b[32m\u001b[K289\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.for_stmt.step = step;\r\n\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.for_stmt.body = body;\r\n\u001b[32m\u001b[K291\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return n;\r\n\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K293\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K294\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic ASTNode *parse_block(Parser *p) {\r\n\u001b[32m\u001b[K295\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_LBRACE, \"'{'\");\r\n\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;\r\n\u001b[32m\u001b[K297\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    nodelist_init(&block->data.block.stmts);\r\n\u001b[32m\u001b[K298\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {\r\n\u001b[32m\u001b[K299\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *stmt = parse_stmt(p);\r\n\u001b[32m\u001b[K300\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (stmt) nodelist_push(&block->data.block.stmts, stmt);\r\n\u001b[32m\u001b[K301\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (p->had_error) break;\r\n\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b"]
[5395.199478, "o", "[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K303\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_RBRACE, \"'}'\");\r\n\u001b[32m\u001b[K304\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return block;\r\n\u001b[32m\u001b[K305\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K306\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K307\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic ASTNode *parse_stmt(Parser *p) {\r\n\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_LET)) {\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int line = prev(p)->line;\r\n\u001b[32m\u001b[K310\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_IDENT, \"identifier\");\r\n\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        char name[MAX_IDENT_LEN];\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_ASSIGN, \"'='\");\r\n\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *init = parse_expr(p);\r\n\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_SEMICOLON, \"';'\");\r\n"]
[5395.199546, "o", "\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);\r\n\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.let.init = init; return n;\r\n\u001b[32m\u001b[K319\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_IF)) {\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int line = prev(p)->line;\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_LPAREN, \"'('\");\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        return \u001b[01;31m\u001b[Kparse_for\u001b[m\u001b[K(p);\r\n\u001b[32m\u001b[K360\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K361\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_BREAK)) {\r\n"]
[5395.199607, "o", "\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int line = prev(p)->line;\r\n\u001b[32m\u001b[K363\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[32m\u001b[K364\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = NODE_BREAK; n->line = line; return n;\r\n\u001b[32m\u001b[K365\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K366\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_CONTINUE)) {\r\n\u001b[32m\u001b[K367\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int line = prev(p)->line;\r\n\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[32m\u001b[K369\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = NODE_CONTINUE; n->line = line; return n;\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K371\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_PRINT)) {\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int line = prev(p)->line;\r\n"]
[5395.199674, "o", "\u001b[32m\u001b[K373\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *value = parse_expr(p);\r\n\u001b[32m\u001b[K374\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[32m\u001b[K375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = NODE_PRINT; n->line = line;\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.print.value = value; return n;\r\n\u001b[32m\u001b[K377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (match(p, TOK_FN)) {\r\n\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        int line = prev(p)->line;\r\n\u001b[32m\u001b[K380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_IDENT, \"function name\");\r\n\u001b[32m\u001b[K381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        char name[MAX_IDENT_LEN];\r\n"]
[5395.19974, "o", "\u001b[32m\u001b[K382\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n\u001b[32m\u001b[K383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_LPAREN, \"'('\");\r\n\u001b[32m\u001b[K384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;\r\n\u001b[32m\u001b[K385\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);\r\n\u001b[32m\u001b[K386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.func.param_count = 0;\r\n\u001b[32m\u001b[K387\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (!check(p, TOK_RPAREN)) {\r\n\u001b[32m\u001b[K388\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            do {\r\n\u001b[32m\u001b[K389\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                expect(p, TOK_IDENT, \"parameter name\");\r\n\u001b[32m\u001b[K390\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                strncpy(n->data.func.params[n->data.func.param_count],\r\n\u001b[32m\u001b[K391\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                        prev(p)->text, MAX_IDENT_LEN - 1);\r\n"]
[5395.199839, "o", "\u001b[32m\u001b[K392\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                n->data.func.param_count++;\r\n\u001b[32m\u001b[K393\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            } while (match(p, TOK_COMMA));\r\n\u001b[32m\u001b[K394\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        expect(p, TOK_RPAREN, \"')'\");\r\n\u001b[32m\u001b[K396\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        n->data.func.body = parse_block(p); return n;\r\n"]
[5395.19999, "o", "\u001b[32m\u001b[K397\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K398\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (check(p, TOK_IDENT)) {\r\n\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *a = try_parse_assign(p);\r\n\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (a) { expect(p, TOK_SEMICOLON, \"';'\"); return a; }\r\n\u001b[32m\u001b[K401\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *expr = parse_expr(p);\r\n\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[32m\u001b[K404\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;\r\n\u001b[32m\u001b[K405\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    n->data.expr_stmt.expr = expr; return n;\r\n\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid parser_init(Parser *p, Token *tokens, int count) {\r\n\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;\r\n\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KASTNode *parse_progra"]
[5395.200067, "o", "m(Parser *p) {\r\n\u001b[32m\u001b[K413\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;\r\n\u001b[32m\u001b[K414\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    nodelist_init(&program->data.block.stmts);\r\n\u001b[32m\u001b[K415\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (!check(p, TOK_EOF)) {\r\n\u001b[32m\u001b[K416\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        ASTNode *stmt = parse_stmt(p);\r\n\u001b[32m\u001b[K417\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (stmt) nodelist_push(&program->data.block.stmts, stmt);\r\n\u001b[32m\u001b[K418\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (p->had_error) break;\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return program;\r\n\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
