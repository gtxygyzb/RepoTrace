[9837.523302, "o", "     1\t#include \"parser.h\"\r\n     2\t\r\n     3\tstatic Token *current(Parser *p) { return &p->tokens[p->pos]; }\r\n     4\tstatic Token *prev(Parser *p) { return &p->tokens[p->pos - 1]; }\r\n     5\tstatic int check(Parser *p, TokenType t) { return current(p)->type == t; }\r\n     6\t\r\n"]
[9837.523413, "o", "     7\tstatic int match(Parser *p, TokenType t) {\r\n     8\t    if (check(p, t)) { p->pos++; return 1; }\r\n     9\t    return 0;\r\n    10\t}\r\n    11\t\r\n    12\tstatic void expect(Parser *p, TokenType t, const char *msg) {\r\n    13\t    if (!match(p, t)) {\r\n    14\t        error_at(current(p)->line, \"expected %s, got '%s'\", msg, current(p)->text);\r\n    15\t        p->had_error = 1;\r\n    16\t    }\r\n    17\t}\r\n    18\t\r\n    19\tstatic ASTNode *parse_expr(Parser *p);\r\n    20\tstatic ASTNode *parse_stmt(Parser *p);\r\n    21\tstatic ASTNode *parse_block(Parser *p);\r\n    22\tstatic ASTNode *parse_factor(Parser *p);\r\n    23\tstatic ASTNode *parse_term(Parser *p);\r\n"]
[9837.5235, "o", "    24\tstatic ASTNode *parse_comparison(Parser *p);\r\n    25\tstatic ASTNode *parse_logic_and(Parser *p);\r\n    26\tstatic ASTNode *parse_fn_expr(Parser *p);\r\n    27\tstatic ASTNode *parse_postfix(Parser *p, ASTNode *expr);\r\n    28\t\r\n    29\tstatic ASTNode *parse_primary(Parser *p) {\r\n    30\t    if (match(p, TOK_NUM)) {\r\n    31\t        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;\r\n    32\t        n->data.num_val = prev(p)->literal.ival; return n;\r\n    33\t    }\r\n    34\t    if (match(p, TOK_STRING)) {\r\n    35\t        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;\r\n"]
[9837.523572, "o", "    36\t        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return parse_postfix(p, n);\r\n    37\t    }\r\n    38\t    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {\r\n    39\t        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;\r\n    40\t        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;\r\n    41\t    }\r\n    42\t    if (match(p, TOK_IDENT)) {\r\n    43\t        char name[MAX_IDENT_LEN];\r\n    44\t        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\\0';\r\n    45\t        int line = prev(p)->line;\r\n    46"]
[9837.523642, "o", "\t        if (match(p, TOK_LPAREN)) {\r\n    47\t            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;\r\n    48\t            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);\r\n    49\t            nodelist_init(&n->data.call.args);\r\n    50\t            if (!check(p, TOK_RPAREN)) {\r\n    51\t                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));\r\n    52\t            }\r\n    53\t            expect(p, TOK_RPAREN, \"')'\"); return parse_postfix(p, n);\r\n    54\t        }\r\n"]
[9837.523708, "o", "    55\t        ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;\r\n    56\t        strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);\r\n    57\t        return parse_postfix(p, obj);\r\n    58\t    }\r\n    59\t    if (match(p, TOK_LBRACE)) {\r\n    60\t        int line = prev(p)->line;\r\n    61\t        ASTNode *n = ast_alloc(); n->type = NODE_MAP_LIT; n->line = line;\r\n    62\t        nodelist_init(&n->data.map_lit.keys);\r\n    63\t"]
[9837.523775, "o", "        nodelist_init(&n->data.map_lit.values);\r\n    64\t        if (!check(p, TOK_RBRACE)) {\r\n    65\t            do {\r\n    66\t                if (!check(p, TOK_STRING)) {\r\n    67\t                    error_at(current(p)->line, \"map keys must be string literals\");\r\n    68\t                    p->had_error = 1; p->pos++;\r\n    69\t                } else {\r\n    70\t                    match(p, TOK_STRING);\r\n    71\t                    ASTNode *key = ast_alloc(); key->type = NODE_STR_LIT; key->line = prev(p)->line;\r\n    72\t                    strncpy(key->data.str_val, prev(p)->text, MAX_STRING_LEN - 1);\r\n    73\t                    expect(p, TOK_COLON, \"':'\");\r\n"]
[9837.523844, "o", "    74\t                    ASTNode *val = parse_expr(p);\r\n    75\t                    nodelist_push(&n->data.map_lit.keys, key);\r\n    76\t                    nodelist_push(&n->data.map_lit.values, val);\r\n    77\t                }\r\n    78\t            } while (match(p, TOK_COMMA));\r\n"]
[9837.523906, "o", "    79\t        }\r\n    80\t        expect(p, TOK_RBRACE, \"'}'\");\r\n    81\t        return parse_postfix(p, n);\r\n    82\t    }\r\n    83\t    if (match(p, TOK_FN)) {\r\n    84\t        return parse_postfix(p, parse_fn_expr(p));\r\n    85\t    }\r\n    86\t    if (match(p, TOK_LBRACKET)) {\r\n    87\t        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;\r\n    88\t        nodelist_init(&n->data.array_lit.elems);\r\n    89\t        if (!check(p, TOK_RBRACKET)) {\r\n    90\t            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));\r\n    91\t        }\r\n    92\t        expect(p, TOK_RBRACKET, \"']'\"); return parse_postfix(p, n);\r\n    93\t"]
[9837.52397, "o", "    }\r\n    94\t    if (match(p, TOK_LPAREN)) {\r\n    95\t        ASTNode *expr = parse_expr(p); expect(p, TOK_RPAREN, \"')'\"); return parse_postfix(p, expr);\r\n    96\t    }\r\n    97\t    error_at(current(p)->line, \"unexpected token '%s'\", current(p)->text);\r\n"]
[9837.524035, "o", "    98\t    p->had_error = 1; p->pos++; return ast_alloc();\r\n    99\t}\r\n   100\t\r\n   101\tstatic ASTNode *parse_fn_expr(Parser *p) {\r\n   102\t    int line = prev(p)->line;\r\n   103\t    expect(p, TOK_LPAREN, \"'('\");\r\n   104\t    ASTNode *n = ast_alloc(); n->type = NODE_CLOSURE; n->line = line;\r\n   105\t    n->data.closure.param_count = 0;\r\n   106\t    if (!check(p, TOK_RPAREN)) {\r\n   107\t        do {\r\n   108\t            expect(p, TOK_IDENT, \"parameter name\");\r\n   109\t            strncpy(n->data.closure.params[n->data.closure.param_count],\r\n   110\t                   prev(p)->text, MAX_IDENT_LEN - 1);\r\n   111\t            n->data.closure.param_count++;\r\n   112\t        } while (match(p, TOK_COMMA));\r\n   113\t    }\r\n"]
[9837.524096, "o", "   114\t    expect(p, TOK_RPAREN, \"')'\");\r\n   115\t    n->data.closure.body = parse_block(p);\r\n   116\t    return n;\r\n   117\t}\r\n   118\t\r\n"]
