[9936.952401, "o", "\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n\u001b[32m\u001b[K181\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            case BC_STORE_LOCAL: {\r\n\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;\r\n\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                vm->stack[base + (int)ins->operand] = pop(vm);\r\n\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            case BC_LOAD_GLOBAL: {\r\n"]
[9936.952448, "o", "\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                int idx = resolve_global(vm, ins->str_operand);\r\n\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if (idx < 0) { fprintf(stderr, \"undefined variable '%s'\\n\", ins->str_operand); return -1; }\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                push(vm, vm->globals[idx]);\r\n\u001b[32m\u001b[K191\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                break;\r\n\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n"]
