[1174.931571, "o", "\u001b[?2004h> "]
[1174.931768, "o", "    ASTNode *left = parse_factor(p);\r\n\u001b[?2004l\r"]
[1174.931823, "o", "\u001b[?2004h> "]
[1174.932106, "o", "    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {\r\n\u001b[?2004l\r"]
[1174.932175, "o", "\u001b[?2004h> "]
[1174.932363, "o", "        int line = prev(p)->line;\r\n\u001b[?2004l\r"]
[1174.932425, "o", "\u001b[?2004h> "]
[1174.932803, "o", "        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;\r\n\u001b[?2004l\r"]
[1174.93286, "o", "\u001b[?2004h> "]
[1174.933069, "o", "        ASTNode *right = parse_factor(p);\r\n\u001b[?2004l\r"]
[1174.933136, "o", "\u001b[?2004h> "]
[1174.933695, "o", "        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1174.933788, "o", "> "]
[1174.934217, "o", "        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n\u001b[?2004l\r"]
[1174.934329, "o", "\u001b[?2004h> "]
[1174.934443, "o", "        left = n;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1174.93453, "o", "\u001b[?2004h> "]
[1174.934624, "o", "    return left;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1174.934716, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h"]
[1174.934819, "o", "> if old not in s:\r\n\u001b[?2004l\r"]
[1174.934892, "o", "\u001b[?2004h> "]
[1174.935075, "o", "    raise SystemExit('precedence block not found')\r\n\u001b[?2004l\r"]
[1174.935132, "o", "\u001b[?2004h> "]
[1174.935192, "o", "s=s.replace(old,new)\r\n\u001b[?2004l\r"]
[1174.93529, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[1174.935454, "o", "# Extend assignment parsing to compound assignments.\r\n\u001b[?2004l\r"]
[1174.935543, "o", "\u001b[?2004h> "]
[1174.935689, "o", "old='''static ASTNode *try_parse_assign(Parser *p) {\r\n\u001b[?2004l\r"]
[1174.935746, "o", "\u001b[?2004h> "]
[1174.935884, "o", "    if (!check(p, TOK_IDENT)) return NULL;\r\n\u001b[?2004l\r"]
[1174.935941, "o", "\u001b[?2004h> "]
[1174.93601, "o", "    int saved = p->pos;\r\n\u001b[?2004l\r"]
[1174.936066, "o", "\u001b[?2004h> "]
[1174.936122, "o", "    p->pos++;\r\n\u001b[?2004l\r \u001b[?2004h> "]
[1174.936252, "o", "    if (check(p, TOK_ASSIGN)) {\r\n\u001b[?2004l\r"]
[1174.936314, "o", "\u001b[?2004h> "]
[1174.936472, "o", "        p->pos = saved; match(p, TOK_IDENT);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1174.936527, "o", "> "]
[1174.936627, "o", "        char name[MAX_IDENT_LEN];\r\n\u001b[?2004l\r"]
[1174.936682, "o", "\u001b[?2004h> "]
[1174.937008, "o", "        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\\\0';\r\n\u001b[?2004l\r"]
[1174.937067, "o", "\u001b[?2004h> "]
[1174.937163, "o", "        int line = prev(p)->line;\r\n\u001b[?2004l\r"]
[1174.937252, "o", "\u001b[?2004h> "]
[1174.937348, "o", "        expect(p, TOK_ASSIGN, \"'='\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[1174.937404, "o", "> "]
[1174.937525, "o", "        ASTNode *val = parse_expr(p);\r\n\u001b[?2004l\r"]
[1174.93758, "o", "\u001b[?2004h> "]
[1174.937825, "o", "        ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;\r\n\u001b[?2004l\r"]
[1174.937885, "o", "\u001b[?2004h> "]
[1174.938089, "o", "        strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);\r\n\u001b[?2004l\r"]
[1174.938144, "o", "\u001b[?2004h> "]
[1174.938298, "o", "        n->data.assign.value = val; return n;\r\n\u001b[?2004l\r"]
[1174.938357, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1174.938412, "o", "> "]
[1174.93851, "o", "    p->pos = saved; return NULL;\r\n\u001b[?2004l\r"]
[1174.938566, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.938625, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.938822, "o", "new='''static ASTNode *try_parse_assign(Parser *p) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1174.938877, "o", "> "]
[1174.939006, "o", "    if (!check(p, TOK_IDENT)) return NULL;\r\n\u001b[?2004l\r"]
[1174.939062, "o", "\u001b[?2004h> "]
[1174.939133, "o", "    int saved = p->pos;\r\n\u001b[?2004l\r"]
[1174.939187, "o", "\u001b[?2004h> "]
[1174.939259, "o", "    p->pos++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.939622, "o", "    if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||\r\n\u001b[?2004l\r\u001b[?2004h"]
[1174.939694, "o", "> "]
[1174.940016, "o", "        check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {\r\n\u001b[?2004l\r"]
[1174.940072, "o", "\u001b[?2004h> "]
[1174.940244, "o", "        p->pos = saved; match(p, TOK_IDENT);\r\n\u001b[?2004l\r;\r\n\u001b[?2004h"]
[1174.940305, "o", "> "]
[1174.940406, "o", "        char name[MAX_IDENT_LEN];\r\n\u001b[?2004l\r\u001b[?2004h"]
[1174.940462, "o", "> "]
[1174.940778, "o", "        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\\\0';\r\n\u001b[?2004l\r"]
[1174.940833, "o", "\u001b[?2004h> "]
[1174.940943, "o", "        int line = prev(p)->line;\r\n\u001b[?2004l\r"]
[1174.940998, "o", "\u001b[?2004h> "]
[1174.941155, "o", "        TokenType op_tok = current(p)->type;\r\n\u001b[?2004l\r"]
[1174.941239, "o", "\u001b[?2004h> "]
[1174.941302, "o", "        BinOp op = OP_ADD;\r\n\u001b[?2004l\r"]
[1174.94136, "o", "\u001b[?2004h> "]
[1174.941446, "o", "        const char *msg = \"'='\";\r\n\u001b[?2004l\r\u001b[?2004h"]
[1174.941507, "o", "> "]
[1174.941769, "o", "        if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = \"'+='\"; expect(p, TOK_PLUS_ASSIGN, \"'+='\"); }\r\n\u001b[?2004l\r"]
[1174.941831, "o", "\u001b[?2004h> "]
[1174.942111, "o", "        else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = \"'-='\"; expect(p, TOK_MINUS_ASSIGN, \"'-='\"); }\r\n\u001b[?2004l\r"]
[1174.942168, "o", "\u001b[?2004h> "]
[1174.942454, "o", "        else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = \"'*='\"; expect(p, TOK_STAR_ASSIGN, \"'*='\"); }\r\n\u001b[?2004l\r"]
[1174.942515, "o", "\u001b[?2004h> "]
[1174.942794, "o", "        else if (op_tok == TOK_SLASH_ASSIGN) { op = OP_DIV; msg = \"'/='\"; expect(p, TOK_SLASH_ASSIGN, \"'/='\"); }\r\n\u001b[?2004l\r"]
[1174.942854, "o", "\u001b[?2004h> "]
[1174.943176, "o", "        else if (op_tok == TOK_PERCENT_ASSIGN) { op = OP_MOD; msg = \"'%='\"; expect(p, TOK_PERCENT_ASSIGN, \"'%='\"); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1174.94328, "o", "> "]
[1174.94336, "o", "        else { expect(p, TOK_ASSIGN, \"'='\"); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.94347, "o", "        ASTNode *val = parse_expr(p);\r\n\u001b[?2004l\r"]
[1174.943527, "o", "\u001b[?2004h> "]
[1174.943602, "o", "        if (op_tok == TOK_ASSIGN) {\r\n\u001b[?2004l\r"]
[1174.943657, "o", "\u001b[?2004h> "]
[1174.943856, "o", "            ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;\r\n\u001b[?2004l\r"]
[1174.943913, "o", "\u001b[?2004h> "]
[1174.94406, "o", "            strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.944179, "o", "            n->data.assign.value = val; return n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.944266, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.944428, "o", "            ASTNode *n = ast_alloc(); n->type = NODE_COMPOUND_ASSIGN; n->line = line;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.944596, "o", "            strncpy(n->data.compound_assign.name, name, MAX_IDENT_LEN - 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.944703, "o", "            n->data.compound_assign.op = op;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.944838, "o", "            n->data.compound_assign.value = val; return n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.944902, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1174.944957, "o", "\u001b[?2004h> "]
[1174.945015, "o", "    p->pos = saved; return NULL;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1174.945076, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.945147, "o", "static ASTNode *parse_for(Parser *p) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.945229, "o", "    int line = prev(p)->line;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.945319, "o", "    expect(p, TOK_LPAREN, \"'('\");\r\n\u001b[?2004l\r"]
[1174.945374, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.945545, "o", "    if (check(p, TOK_IDENT) && p->pos + 1 < p->count && p->tokens[p->pos + 1].type == TOK_IN) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.945632, "o", "        char name[MAX_IDENT_LEN];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.945827, "o", "        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\\\0';\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.945909, "o", "        match(p, TOK_IDENT);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.945977, "o", "        match(p, TOK_IN);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.946072, "o", "        ASTNode *arr = parse_expr(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.946167, "o", "        expect(p, TOK_RPAREN, \"')'\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.946275, "o", "        ASTNode *body = parse_block(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.94644, "o", "        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.946594, "o", "        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.946691, "o", "        n->data.foreach_stmt.arr = arr;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.946792, "o", "        n->data.foreach_stmt.body = body;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.94685, "o", "        return n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.946909, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.946982, "o", "    ASTNode *init = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.947057, "o", "    if (match(p, TOK_LET)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.947169, "o", "        expect(p, TOK_IDENT, \"identifier\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.947259, "o", "        char name[MAX_IDENT_LEN];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.947453, "o", "        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\\\0';\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.947551, "o", "        expect(p, TOK_ASSIGN, \"'='\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.947658, "o", "        ASTNode *init_expr = parse_expr(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.947833, "o", "        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.947974, "o", "        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.948075, "o", "        init->data.let.init = init_expr;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.94817, "o", "    } else if (check(p, TOK_IDENT)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.94827, "o", "        init = try_parse_assign(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.948368, "o", "        if (!init) init = parse_expr(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.948471, "o", "    } else if (!check(p, TOK_SEMICOLON)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.948552, "o", "        init = parse_expr(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.948613, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.94868, "o", "    expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.948735, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.948798, "o", "    ASTNode *cond = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.948905, "o", "    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.948999, "o", "    expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.949053, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.949108, "o", "    ASTNode *step = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.949179, "o", "    if (!check(p, TOK_RPAREN)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.949272, "o", "        if (check(p, TOK_IDENT)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.94937, "o", "            step = try_parse_assign(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.94943, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.949516, "o", "        if (!step) step = parse_expr(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.949577, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.949638, "o", "    expect(p, TOK_RPAREN, \"')'\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.949693, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.949749, "o", "    ASTNode *body = parse_block(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.9499, "o", "    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.949988, "o", "    n->data.for_stmt.init = init;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1174.950042, "o", "> "]
[1174.950103, "o", "    n->data.for_stmt.cond = cond;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.950163, "o", "    n->data.for_stmt.step = step;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.950256, "o", "    n->data.for_stmt.body = body;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.950325, "o", "    return n;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1174.950382, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.950437, "o", "if old not in s:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.950555, "o", "    raise SystemExit('try_parse_assign block not found')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.950617, "o", "s=s.replace(old,new)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.950671, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.950742, "o", "# Add break/continue/for statement cases.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.950839, "o", "old='''    if (match(p, TOK_PRINT)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.950893, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.950969, "o", "insert='''    if (match(p, TOK_FOR)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.951048, "o", "        return parse_for(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.951132, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.951194, "o", "    if (match(p, TOK_BREAK)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.951265, "o", "        int line = prev(p)->line;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.95136, "o", "        expect(p, TOK_SEMICOLON, \"';'\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.95154, "o", "        ASTNode *n = ast_alloc(); n->type = NODE_BREAK; n->line = line; return n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.951595, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.951675, "o", "    if (match(p, TOK_CONTINUE)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1174.951747, "o", "        int line = prev(p)->line;\r\n\u001b[?2004l\r"]
