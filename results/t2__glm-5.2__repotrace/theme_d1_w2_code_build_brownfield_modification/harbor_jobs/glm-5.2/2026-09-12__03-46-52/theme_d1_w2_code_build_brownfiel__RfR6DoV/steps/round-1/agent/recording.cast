[1868.084023, "o", "#include \"codegen.h\"\r\n\r\nstatic int emit(Compiler *c, Opcode op, int64_t operand, char *str_op) {\r\n    if (c->code_count >= MAX_BYTECODE) { fprintf(stderr, \"bytecode overflow\\n\"); return -1; }\r\n    Instruction *ins = &c->code[c->code_count];\r\n    ins->op = op; ins->operand = operand; ins->str_operand = str_op;\r\n    return c->code_count++;\r\n}\r\n\r\nstatic int resolve_local(Compiler *c, const char *name) {\r\n    for (int i = c->local_count - 1; i >= 0; i--) {"]
[1868.084251, "o", "\r\n        if (strcmp(c->locals[i].name, name) == 0) return i;\r\n    }\r\n    return -1;\r\n}\r\n\r\nstatic int add_local(Compiler *c, const char *name) {\r\n    if (c->local_count >= MAX_LOCALS) { fprintf(stderr, \"too many local variables\\n\"); return -1; }\r\n    Local *local = &c->locals[c->local_count];\r\n    strncpy(local->name, name, MAX_IDENT_LEN - 1); local->name[MAX_IDENT_LEN - 1] = '\\0';\r\n    local->scope_depth = c->scope_depth;\r\n    return c->local_count++;\r\n"]
[1868.084348, "o", "}\r\n\r\nstatic int find_function(Compiler *c, const char *name) {\r\n    for (int i = 0; i < c->func_count; i++) {\r\n        if (strcmp(c->functions[i].name, name) == 0) return i;\r\n    }\r\n    return -1;\r\n}\r\n\r\nstatic void compile_store(Compiler *c, const char *name) {\r\n    int slot = resolve_local(c, name);\r\n    if (slot >= 0) emit(c, BC_STORE_LOCAL, slot, NULL);\r\n    else emit(c, BC_STORE_GLOBAL, 0, strdup(name));\r\n}\r\n\r\nstatic void compile_load(Compiler *c, const char *name) {\r\n    int slot = resolve_local(c, name);\r\n    if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);\r\n    else emit(c, BC_LOAD_GLOBAL, 0, strdup(name));\r\n}\r\n\r\n#define MAX_LOOP_DEPTH 64\r\n#define MAX_LOOP_JUMPS 256\r\ntypedef struct {\r\n    int start;\r\n    int cont;\r\n    int end;\r\n    int breaks[MAX_LOOP_JUMPS];\r\n    int break_count;\r\n    int conts[MAX_LOOP_JUMPS];\r\n    int cont_count;\r\n} LoopCtx;\r\nstatic LoopCtx loop_stack[MAX_LOOP_DEPTH];\r\nstatic int loop_depth = 0;\r\n\r\nstatic int compile_node(Compiler *c, ASTNode *node);\r\n\r\nstatic int compile_expr(Co"]
[1868.084426, "o", "mpiler *c, ASTNode *node) {\r\n    switch (node->type) {\r\n        case NODE_NUM_LIT:\r\n            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;\r\n        case NODE_STR_LIT: {\r\n            char *s = strdup(node->data.str_val);\r\n            emit(c, BC_PUSH_STR, 0, s); break;\r\n        }\r\n        case NODE_BOOL_LIT:\r\n            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;\r\n        case NODE_IDENT: {\r\n            int slot = resolve_local(c, node->data.ident);\r\n            if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);\r\n            else emit(c, BC_LOAD_GLOBAL, 0, strdup(node->data.ident));\r\n            break;\r\n        }\r\n        case NODE_BINOP:\r\n            compile_expr(c, node->data.binop.left);\r\n            compile_expr(c, node->data.binop.right);\r\n"]
[1868.084493, "o", "            switch (node->data.binop.op) {\r\n                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;\r\n                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;\r\n                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;\r\n                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;\r\n                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;\r\n                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;\r\n                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;\r\n                case OP_LT:  emit(c, BC_LT, 0, NULL); break;\r\n                case OP_GT:  emit(c, BC_GT, 0, NULL); break;\r\n                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;\r\n                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;\r\n"]
[1868.084562, "o", "                case OP_AND: emit(c, BC_AND, 0, NULL); break;\r\n                case OP_OR:  emit(c, BC_OR, 0, NULL); break;\r\n            }\r\n            break;\r\n        case NODE_UNARY:\r\n            compile_expr(c, node->data.unary.operand);\r\n            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);\r\n            else emit(c, BC_NOT, 0, NULL);\r\n            break;\r\n        case NODE_CALL: {\r\n            int fi = find_function(c, node->data.call.name);\r\n            if (fi < 0) { error_at(node->line, \"undefined function '%s'\", node->data.call.name); return -1; }\r\n            for (int i = 0; i < node->data.call.args.count; i++)\r\n"]
[1868.084691, "o", "                compile_expr(c, node->data.call.args.items[i]);\r\n            emit(c, BC_CALL, fi, NULL);\r\n            break;\r\n        }\r\n        case NODE_INDEX:\r\n            compile_expr(c, node->data.index_access.obj);\r\n            compile_expr(c, node->data.index_access.index);\r\n            emit(c, BC_INDEX, 0, NULL); break;\r\n        case NODE_ARRAY_LIT:\r\n            for (int i = 0; i < node->data.array_lit.elems.count; i++)\r\n                compile_expr(c, node->data.array_lit.elems.items[i]);\r\n            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;\r\n        default:\r\n            error_at(node->line, \"cannot compile expression of type %d\", node->type); return -1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int compile_node(Compiler *c, ASTNode *node) {\r\n    switch (node->type) {\r\n        case NODE_LET: {\r\n            int slot = add_local(c, node->data.let.name);\r\n            if (slot < 0) return -1;\r\n            compile_expr(c, node->data.let.init);\r\n"]
[1868.084756, "o", "            break;\r\n        }\r\n        case NODE_ASSIGN: {\r\n            compile_expr(c, node->data.assign.value);\r\n            compile_store(c, node->data.assign.name);\r\n            break;\r\n        }\r\n        case NODE_IF: {\r\n            compile_expr(c, node->data.if_stmt.cond);\r\n            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n            compile_node(c, node->data.if_stmt.then_b);\r\n            if (node->data.if_stmt.else_b) {\r\n                int je = emit(c, BC_JUMP, 0, NULL);\r\n"]
[1868.084816, "o", "                c->code[jf].operand = c->code_count;\r\n                compile_node(c, node->data.if_stmt.else_b);\r\n                c->code[je].operand = c->code_count;\r\n            } else {\r\n                c->code[jf].operand = c->code_count;\r\n            }\r\n            break;\r\n        }\r\n        case NODE_WHILE: {\r\n            int loop_start = c->code_count;\r\n            compile_expr(c, node->data.while_stmt.cond);\r\n"]
[1868.084885, "o", "            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n            ctx->start = loop_start; ctx->cont = loop_start; ctx->end = -1;\r\n            ctx->break_count = 0; ctx->cont_count = 0;\r\n            compile_node(c, node->data.while_stmt.body);\r\n            emit(c, BC_JUMP, loop_start, NULL);\r\n            int end = c->code_count;\r\n            c->code[jf].operand = end;\r\n            ctx->end = end;\r\n            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;\r\n            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = ctx->cont;\r\n            loop_depth--;\r\n"]
[1868.084979, "o", "            break;\r\n        }\r\n        case NODE_FOR: {\r\n            int old_lc = c->local_count;\r\n            c->scope_depth++;\r\n            if (node->data.for_stmt.init) compile_node(c, node->data.for_stmt.init);\r\n            int loop_start = c->code_count;\r\n            if (node->data.for_stmt.cond) compile_expr(c, node->data.for_stmt.cond);\r\n            else emit(c, BC_PUSH_BOOL, 1, NULL);\r\n            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\r\n            ctx->break_count = 0; ctx->cont_count = 0;\r\n            compile_node(c, node->data.for_stmt.body);\r\n            int step_start = c->code_count;\r\n            ctx->cont = step_start;\r\n"]
[1868.085041, "o", "            if (node->data.for_stmt.step) compile_node(c, node->data.for_stmt.step);\r\n            emit(c, BC_JUMP, loop_start, NULL);\r\n            int end = c->code_count;\r\n            c->code[jf].operand = end;\r\n            ctx->end = end;\r\n            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;\r\n            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = step_start;\r\n            loop_depth--;\r\n            int n = c->local_count - old_lc;\r\n            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n            c->local_count = old_lc;\r\n            c->scope_depth--;\r\n            break;\r\n"]
[1868.08511, "o", "        }\r\n        case NODE_FOREACH: {\r\n            int old_lc = c->local_count;\r\n            c->scope_depth++;\r\n            compile_expr(c, node->data.foreach_stmt.arr);\r\n            int arr_slot = add_local(c, \".forarr\");\r\n            emit(c, BC_PUSH_INT, 0, NULL);\r\n            int idx_slot = add_local(c, \".foridx\");\r\n            int loop_start = c->code_count;\r\n            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n            emit(c, BC_LOAD_LOCAL, arr_slot, NULL);\r\n            emit(c, BC_ARRAY_LEN, 0, NULL);\r\n            emit(c, BC_LT, 0, NULL);\r\n            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n"]
[1868.085199, "o", "            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\r\n            ctx->break_count = 0; ctx->cont_count = 0;\r\n            int body_old = c->local_count;\r\n            emit(c, BC_LOAD_LOCAL, arr_slot, NULL);\r\n            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n            emit(c, BC_INDEX, 0, NULL);\r\n            int var_slot = add_local(c, node->data.foreach_stmt.var);\r\n            emit(c, BC_STORE_LOCAL, var_slot, NULL);\r\n            compile_node(c, node->data.foreach_stmt.body);\r\n            int n = c->local_count - body_old;\r\n            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n            c->local_count = body_old;\r\n            int inc_start = c->code_count;\r\n            ctx->cont = inc_start;"]
[1868.08531, "o", "\r\n            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n            emit(c, BC_PUSH_INT, 1, NULL);\r\n            emit(c, BC_ADD, 0, NULL);\r\n            emit(c, BC_STORE_LOCAL, idx_slot, NULL);\r\n            emit(c, BC_JUMP, loop_start, NULL);\r\n            int end = c->code_count;\r\n            c->code[jf].operand = end;\r\n            ctx->end = end;\r\n            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;\r\n            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = inc_start;\r\n            loop_depth--;\r\n            int n2 = c->local_count - old_lc;\r\n            for (int i = 0; i < n2; i++) emit(c, BC_POP, 0, NULL);\r\n            c->local_count = old_lc;\r\n            c->scope_depth--;\r\n            break;\r\n        }\r\n        case NODE_BREAK: {\r\n            if (loop_depth <= 0) { error_at(node->line, \"break outside loop\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth - 1];\r\n            if (ctx->break_count >= MAX_LOOP_JUMPS) { error_at"]
[1868.085381, "o", "(node->line, \"too many break statements\"); return -1; }\r\n            ctx->breaks[ctx->break_count++] = emit(c, BC_JUMP, 0, NULL);\r\n            break;\r\n        }\r\n        case NODE_CONTINUE: {\r\n            if (loop_depth <= 0) { error_at(node->line, \"continue outside loop\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth - 1];\r\n            if (ctx->cont_count >= MAX_LOOP_JUMPS) { error_at(node->line, \"too many continue statements\"); return -1; }\r\n            ctx->conts[ctx->cont_count++] = emit(c, BC_JUMP, 0, NULL);\r\n            break;\r\n        }\r\n        case NODE_COMPOUND_ASSIGN: {\r\n            compile_load(c, node->data.compound_assign.name);\r\n            compile_expr(c, node->data.compound_assign.value);\r\n            switch (node->data.compound_assign.op) {\r\n"]
