[5280.573661, "i", "sed -n '1,360p' src/ast.c\n"]
[5280.574053, "o", "sed -n '1,360p' src/ast.c\r\n\u001b[?2004l\r"]
[5280.577057, "o", "#include \"ast.h\"\r\n\r\nstatic ASTNode node_pool[MAX_AST_NODES];\r\nstatic int node_pool_count = 0;\r\n"]
[5280.577187, "o", "\r\nASTNode *ast_alloc(void) {\r\n    if (node_pool_count >= MAX_AST_NODES) { fprintf(stderr, \"AST node pool exhausted\\n\"); exit(1); }\r\n    ASTNode *n = &node_pool[node_pool_count++];\r\n    memset(n, 0, sizeof(ASTNode));\r\n    return n;\r\n}\r\n\r\n"]
[5280.577285, "o", "void ast_free_all(void) { node_pool_count = 0; }\r\n\r\nvoid nodelist_init(NodeList *list) { list->items = NULL; list->count = 0; list->cap = 0; }\r\n\r\nvoid nodelist_push(NodeList *list, ASTNode *node) {\r\n    if (list->count >= list->cap) {\r\n        int new_cap = list->cap == 0 ? 8 : list->cap * 2;\r\n        list->items = realloc(list->items, new_cap * sizeof(ASTNode *));\r\n        list->cap = new_cap;\r\n    }\r\n    list->items[list->count++] = node;\r\n}\r\n"]
[5280.577698, "o", "\u001b[?2004h"]
[5280.577772, "o", "root@n30009:/app# "]
[5280.861168, "i", "sed -n '1,420p' src/parser.c\n"]
[5280.861504, "o", "sed -n '1,420p' src/parser.c\r\n\u001b[?2004l\r"]
[5280.864344, "o", "#include \"parser.h\"\r\n\r\nstatic Token *current(Parser *p) { return &p->tokens[p->pos]; }\r\nstatic Token *prev(Parser *p) { return &p->tokens[p->pos - 1]; }\r\nstatic int check(Parser *p, TokenType t) { return current(p)->type == t; }\r\n\r\n"]
[5280.864464, "o", "static int match(Parser *p, TokenType t) {\r\n    if (check(p, t)) { p->pos++; return 1; }\r\n    return 0;\r\n}\r\n\r\nstatic void expect(Parser *p, TokenType t, const char *msg) {\r\n    if (!match(p, t)) {\r\n        error_at(current(p)->line, \"expected %s, got '%s'\", msg, current(p)->text);\r\n        p->had_error = 1;\r\n    }\r\n}\r\n\r\nstatic ASTNode *parse_expr(Parser *p);\r\nstatic ASTNode *parse_stmt(Parser *p);\r\nstatic ASTNode *parse_block(Parser *p);\r\nstatic ASTNode *parse_factor(Parser *p);\r\nstatic ASTNode *parse_term(Parser *p);\r\nstatic ASTNode *parse_comparison(Parser *p);\r\nstatic ASTNode *parse_logic_and(Parser *p);\r\nstatic ASTNode *parse_fn_expr(Parser *p);\r\n\r\nstatic ASTNode *parse_primary(Parser *p) {\r\n    if (match(p, TOK_NUM)) {\r\n        ASTNode *n = ast_alloc(); n->type = NODE_NUM_LIT; n->line = prev(p)->line;\r\n        n->data.num_val = prev(p)->literal.ival; return n;\r\n"]
[5280.864551, "o", "    }\r\n    if (match(p, TOK_STRING)) {\r\n        ASTNode *n = ast_alloc(); n->type = NODE_STR_LIT; n->line = prev(p)->line;\r\n        strncpy(n->data.str_val, prev(p)->text, MAX_STRING_LEN - 1); return n;\r\n    }\r\n    if (match(p, TOK_TRUE) || match(p, TOK_FALSE)) {\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BOOL_LIT; n->line = prev(p)->line;\r\n        n->data.bool_val = (prev(p)->type == TOK_TRUE) ? 1 : 0; return n;\r\n    }\r\n    if (match(p, TOK_IDENT)) {\r\n        char name[MAX_IDENT_LEN];\r\n        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN - 1] = '\\0';\r\n        int line = prev(p)->line;\r\n        if (match(p, TOK_LPAREN)) {\r\n            ASTNode *n = ast_alloc(); n->type = NODE_CALL; n->line = line;\r\n            strncpy(n->data.call.name, name, MAX_IDENT_LEN - 1);\r\n"]
[5280.864626, "o", "            nodelist_init(&n->data.call.args);\r\n            if (!check(p, TOK_RPAREN)) {\r\n                do { nodelist_push(&n->data.call.args, parse_expr(p)); } while (match(p, TOK_COMMA));\r\n            }\r\n            expect(p, TOK_RPAREN, \"')'\"); return n;\r\n        }\r\n        if (match(p, TOK_LBRACKET)) {\r\n            ASTNode *idx = parse_expr(p); expect(p, TOK_RBRACKET, \"']'\");\r\n            ASTNode *n = ast_alloc(); n->type = NODE_INDEX; n->line = line;\r\n            ASTNode *obj = ast_alloc(); obj->type = NODE_IDENT; obj->line = line;\r\n            strncpy(obj->data.ident, name, MAX_IDENT_LEN - 1);\r\n            n->data.index_access.obj = obj; n->data.index_access.index = idx; return n;\r\n        }\r\n        ASTNode *n = ast_alloc(); n->type = NODE_IDENT; n->line = line;\r\n        strncpy(n->data.ident, name, MAX_IDENT_LEN - 1); return n;"]
[5280.864692, "o", "\r\n    }\r\n    if (match(p, TOK_FN)) {\r\n        return parse_fn_expr(p);\r\n    }\r\n    if (match(p, TOK_LBRACKET)) {\r\n        ASTNode *n = ast_alloc(); n->type = NODE_ARRAY_LIT; n->line = prev(p)->line;\r\n        nodelist_init(&n->data.array_lit.elems);\r\n        if (!check(p, TOK_RBRACKET)) {\r\n            do { nodelist_push(&n->data.array_lit.elems, parse_expr(p)); } while (match(p, TOK_COMMA));\r\n        }\r\n        expect(p, TOK_RBRACKET, \"']'\"); return n;\r\n    }\r\n"]
[5280.864754, "o", "    if (match(p, TOK_LPAREN)) {\r\n        ASTNode *expr = parse_expr(p); expect(p, TOK_RPAREN, \"')'\"); return expr;\r\n    }\r\n    error_at(current(p)->line, \"unexpected token '%s'\", current(p)->text);\r\n    p->had_error = 1; p->pos++; return ast_alloc();\r\n}\r\n\r\nstatic ASTNode *parse_fn_expr(Parser *p) {\r\n    int line = prev(p)->line;\r\n    expect(p, TOK_LPAREN, \"'('\");\r\n    ASTNode *n = ast_alloc(); n->type = NODE_CLOSURE; n->line = line;\r\n    n->data.closure.param_count = 0;\r\n"]
[5280.864813, "o", "    if (!check(p, TOK_RPAREN)) {\r\n        do {\r\n            expect(p, TOK_IDENT, \"parameter name\");\r\n            strncpy(n->data.closure.params[n->data.closure.param_count],\r\n                   prev(p)->text, MAX_IDENT_LEN - 1);\r\n            n->data.closure.param_count++;\r\n        } while (match(p, TOK_COMMA));\r\n    }\r\n    expect(p, TOK_RPAREN, \"')'\");\r\n    n->data.closure.body = parse_block(p);\r\n    return n;\r\n}\r\n"]
[5280.86488, "o", "\r\nstatic ASTNode *parse_unary(Parser *p) {\r\n    if (match(p, TOK_MINUS)) {\r\n        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n        n->data.unary.op = UNOP_NEG; n->data.unary.operand = operand; return n;\r\n    }\r\n    if (match(p, TOK_NOT)) {\r\n        int line = prev(p)->line; ASTNode *operand = parse_unary(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_UNARY; n->line = line;\r\n        n->data.unary.op = UNOP_NOT; n->data.unary.operand = operand; return n;\r\n    }\r\n"]
[5280.864939, "o", "    return parse_primary(p);\r\n}\r\n\r\nstatic ASTNode *parse_factor(Parser *p) {\r\n    ASTNode *left = parse_unary(p);\r\n    while (match(p, TOK_STAR) || match(p, TOK_SLASH) || match(p, TOK_PERCENT)) {\r\n        int line = prev(p)->line; BinOp op;\r\n        if (prev(p)->type == TOK_STAR) op = OP_MUL;\r\n        else if (prev(p)->type == TOK_SLASH) op = OP_DIV;\r\n        else op = OP_MOD;\r\n"]
[5280.865005, "o", "        ASTNode *right = parse_unary(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n        left = n;\r\n    }\r\n    return left;\r\n}\r\n\r\nstatic ASTNode *parse_comparison(Parser *p) {\r\n    ASTNode *left = parse_term(p);\r\n    while (match(p, TOK_EQ) || match(p, TOK_NEQ) || match(p, TOK_LT) ||\r\n"]
[5280.865069, "o", "           match(p, TOK_GT) || match(p, TOK_LEQ) || match(p, TOK_GEQ)) {\r\n        int line = prev(p)->line; BinOp op;\r\n        switch (prev(p)->type) {\r\n            case TOK_EQ:  op = OP_EQ; break;  case TOK_NEQ: op = OP_NEQ; break;\r\n            case TOK_LT:  op = OP_LT; break;  case TOK_GT:  op = OP_GT; break;\r\n            case TOK_LEQ: op = OP_LEQ; break;  case TOK_GEQ: op = OP_GEQ; break;\r\n            default: op = OP_EQ; break;\r\n        }\r\n        ASTNode *right = parse_term(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n"]
[5280.865135, "o", "        left = n;\r\n    }\r\n    return left;\r\n}\r\n\r\nstatic ASTNode *parse_term(Parser *p) {\r\n    ASTNode *left = parse_factor(p);\r\n    while (match(p, TOK_PLUS) || match(p, TOK_MINUS)) {\r\n        int line = prev(p)->line;\r\n        BinOp op = (prev(p)->type == TOK_PLUS) ? OP_ADD : OP_SUB;\r\n        ASTNode *right = parse_factor(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n        n->data.binop.op = op; n->data.binop.left = left; n->data.binop.right = right;\r\n"]
[5280.865212, "o", "        left = n;\r\n    }\r\n    return left;\r\n}\r\n\r\nstatic ASTNode *parse_logic_and(Parser *p) {\r\n    ASTNode *left = parse_comparison(p);\r\n    while (match(p, TOK_AND)) {\r\n        int line = prev(p)->line; ASTNode *right = parse_comparison(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n        n->data.binop.op = OP_AND; n->data.binop.left = left; n->data.binop.right = right;\r\n        left = n;\r\n    }\r\n    return left;\r\n}\r\n"]
[5280.865275, "o", "\r\nstatic ASTNode *parse_expr(Parser *p) {\r\n    ASTNode *left = parse_logic_and(p);\r\n    while (match(p, TOK_OR)) {\r\n        int line = prev(p)->line; ASTNode *right = parse_logic_and(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BINOP; n->line = line;\r\n        n->data.binop.op = OP_OR; n->data.binop.left = left; n->data.binop.right = right;\r\n        left = n;\r\n    }\r\n    return left;\r\n"]
[5280.865339, "o", "}\r\n\r\nstatic ASTNode *try_parse_assign(Parser *p) {\r\n    if (!check(p, TOK_IDENT)) return NULL;\r\n    int saved = p->pos;\r\n    p->pos++;\r\n    char name[MAX_IDENT_LEN];\r\n    strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n    int line = prev(p)->line;\r\n    if (match(p, TOK_LBRACKET)) {\r\n        ASTNode *idx = parse_expr(p);\r\n        expect(p, TOK_RBRACKET, \"']'\");\r\n        if (check(p, TOK_ASSIGN)) {\r\n            match(p, TOK_ASSIGN);\r\n"]
[5280.865402, "o", "            ASTNode *val = parse_expr(p);\r\n            ASTNode *n = ast_alloc(); n->type = NODE_INDEX_ASSIGN; n->line = line;\r\n            strncpy(n->data.index_assign.name, name, MAX_IDENT_LEN - 1);\r\n            n->data.index_assign.index = idx;\r\n            n->data.index_assign.value = val;\r\n            return n;\r\n        }\r\n        p->pos = saved;\r\n        return NULL;\r\n    }\r\n    if (check(p, TOK_ASSIGN) || check(p, TOK_PLUS_ASSIGN) || check(p, TOK_MINUS_ASSIGN) ||\r\n        check(p, TOK_STAR_ASSIGN) || check(p, TOK_SLASH_ASSIGN) || check(p, TOK_PERCENT_ASSIGN)) {\r\n        p->pos = saved; match(p, TOK_IDENT);"]
[5280.865467, "o", "\r\n        TokenType op_tok = current(p)->type;\r\n        BinOp op = OP_ADD;\r\n        const char *msg = \"'='\";\r\n        if (op_tok == TOK_PLUS_ASSIGN) { op = OP_ADD; msg = \"'+='\"; expect(p, TOK_PLUS_ASSIGN, \"'+='\"); }\r\n        else if (op_tok == TOK_MINUS_ASSIGN) { op = OP_SUB; msg = \"'-='\"; expect(p, TOK_MINUS_ASSIGN, \"'-='\"); }\r\n        else if (op_tok == TOK_STAR_ASSIGN) { op = OP_MUL; msg = \"'*='\"; expect(p, TOK_STAR_ASSIGN, \"'*='\"); }\r\n        else if (op_tok == TOK_SLASH_ASSIGN) { op = OP_DIV; msg = \"'/='\"; expect(p, TOK_SLASH_ASSIGN, \"'/='\"); }\r\n        else if (op_tok == TOK_PERCENT_ASSIGN) { op = OP_MOD; msg = \"'%='\"; expect(p, TOK_PERCENT_ASSIGN, \"'%='\"); }\r\n        else { expect(p, TOK_ASSIGN, \"'='\"); }\r\n        ASTNode *val = parse_expr(p);\r\n"]
[5280.865527, "o", "        if (op_tok == TOK_ASSIGN) {\r\n            ASTNode *n = ast_alloc(); n->type = NODE_ASSIGN; n->line = line;\r\n            strncpy(n->data.assign.name, name, MAX_IDENT_LEN - 1);\r\n            n->data.assign.value = val; return n;\r\n        } else {\r\n            ASTNode *n = ast_alloc(); n->type = NODE_COMPOUND_ASSIGN; n->line = line;\r\n            strncpy(n->data.compound_assign.name, name, MAX_IDENT_LEN - 1);\r\n            n->data.compound_assign.op = op;\r\n            n->data.compound_assign.value = val; return n;\r\n        }\r\n    }\r\n"]
[5280.865597, "o", "    p->pos = saved; return NULL;\r\n}\r\n\r\nstatic ASTNode *parse_for(Parser *p) {\r\n    int line = prev(p)->line;\r\n    expect(p, TOK_LPAREN, \"'('\");\r\n\r\n    if (check(p, TOK_IDENT) && p->pos + 1 < p->count &&\r\n        (p->tokens[p->pos + 1].type == TOK_IN || p->tokens[p->pos + 1].type == TOK_OF)) {\r\n        char name[MAX_IDENT_LEN];\r\n        strncpy(name, current(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n"]
[5280.865674, "o", "        match(p, TOK_IDENT);\r\n        int is_of = match(p, TOK_OF);\r\n        if (!is_of) match(p, TOK_IN);\r\n        ASTNode *arr = parse_expr(p);\r\n        expect(p, TOK_RPAREN, \"')'\");\r\n        ASTNode *body = parse_block(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_FOREACH; n->line = line;\r\n        strncpy(n->data.foreach_stmt.var, name, MAX_IDENT_LEN - 1);\r\n        n->data.foreach_stmt.arr = arr;\r\n        n->data.foreach_stmt.body = body;\r\n        n->data.foreach_stmt.is_of = is_of;\r\n        return n;\r\n    }\r\n\r\n    ASTNode *init = NULL;\r\n    if (match(p, TOK_LET)) {\r\n        expect(p, TOK_IDENT, \"identifier\");\r\n        char name[MAX_IDENT_LEN];\r\n        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n        expect(p, TOK_ASSIGN, \"'='\");\r\n"]
[5280.865758, "o", "        ASTNode *init_expr = parse_expr(p);\r\n        init = ast_alloc(); init->type = NODE_LET; init->line = prev(p)->line;\r\n        strncpy(init->data.let.name, name, MAX_IDENT_LEN - 1);\r\n        init->data.let.init = init_expr;\r\n    } else if (check(p, TOK_IDENT)) {\r\n"]
[5280.865828, "o", "        init = try_parse_assign(p);\r\n        if (!init) init = parse_expr(p);\r\n    } else if (!check(p, TOK_SEMICOLON)) {\r\n        init = parse_expr(p);\r\n    }\r\n    expect(p, TOK_SEMICOLON, \"';'\");\r\n\r\n    ASTNode *cond = NULL;\r\n    if (!check(p, TOK_SEMICOLON)) cond = parse_expr(p);\r\n    expect(p, TOK_SEMICOLON, \"';'\");\r\n\r\n    ASTNode *step = NULL;\r\n    if (!check(p, TOK_RPAREN)) {\r\n"]
[5280.8659, "o", "        if (check(p, TOK_IDENT)) {\r\n            step = try_parse_assign(p);\r\n        }\r\n        if (!step) step = parse_expr(p);\r\n    }\r\n    expect(p, TOK_RPAREN, \"')'\");\r\n\r\n    ASTNode *body = parse_block(p);\r\n    ASTNode *n = ast_alloc(); n->type = NODE_FOR; n->line = line;\r\n    n->data.for_stmt.init = init;\r\n    n->data.for_stmt.cond = cond;\r\n    n->data.for_stmt.step = step;\r\n    n->data.for_stmt.body = body;\r\n    return n;\r\n}\r\n\r\nstatic ASTNode *parse_block(Parser *p) {\r\n    expect(p, TOK_LBRACE, \"'{'\");\r\n    ASTNode *block = ast_alloc(); block->type = NODE_BLOCK; block->line = prev(p)->line;\r\n    nodelist_init(&block->data.block.stmts);\r\n    while (!check(p, TOK_RBRACE) && !check(p, TOK_EOF)) {\r\n        ASTNode *stmt = parse_stmt(p);\r\n        if (stmt) nodelist_push(&block->data.block.stmts, stmt);\r\n        if (p->had_error) break;\r\n    }\r\n"]
[5280.865966, "o", "    expect(p, TOK_RBRACE, \"'}'\");\r\n    return block;\r\n}\r\n\r\nstatic ASTNode *parse_stmt(Parser *p) {\r\n    if (match(p, TOK_LET)) {\r\n        int line = prev(p)->line;\r\n        expect(p, TOK_IDENT, \"identifier\");\r\n        char name[MAX_IDENT_LEN];\r\n        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n        expect(p, TOK_ASSIGN, \"'='\");\r\n        ASTNode *init = parse_expr(p);\r\n"]
[5280.866026, "o", "        expect(p, TOK_SEMICOLON, \"';'\");\r\n        ASTNode *n = ast_alloc(); n->type = NODE_LET; n->line = line;\r\n        strncpy(n->data.let.name, name, MAX_IDENT_LEN - 1);\r\n        n->data.let.init = init; return n;\r\n    }\r\n    if (match(p, TOK_IF)) {\r\n        int line = prev(p)->line;\r\n        expect(p, TOK_LPAREN, \"'('\");\r\n        ASTNode *cond = parse_expr(p);\r\n        expect(p, TOK_RPAREN, \"')'\");\r\n        ASTNode *then_b = parse_block(p);\r\n"]
[5280.866112, "o", "        ASTNode *else_b = NULL;\r\n        if (match(p, TOK_ELSE)) {\r\n            if (check(p, TOK_IF)) {\r\n                ASTNode *elif = parse_stmt(p);\r\n                else_b = ast_alloc(); else_b->type = NODE_BLOCK; else_b->line = elif->line;\r\n                nodelist_init(&else_b->data.block.stmts);\r\n                nodelist_push(&else_b->data.block.stmts, elif);\r\n            } else {\r\n                else_b = parse_block(p);\r\n            }\r\n        }\r\n        ASTNode *n = ast_alloc(); n->type = NODE_IF; n->line = line;\r\n        n->data.if_stmt.cond = cond; n->data.if_stmt.then_b = then_b; n->data.if_stmt.else_b = else_b;\r\n        return n;\r\n    }\r\n    if (match(p, TOK_WHILE)) {\r\n        int line = prev(p)->line;\r\n"]
[5280.866197, "o", "        expect(p, TOK_LPAREN, \"'('\");\r\n        ASTNode *cond = parse_expr(p);\r\n        expect(p, TOK_RPAREN, \"')'\");\r\n        ASTNode *body = parse_block(p);\r\n        ASTNode *n = ast_alloc(); n->type = NODE_WHILE; n->line = line;\r\n        n->data.while_stmt.cond = cond; n->data.while_stmt.body = body; return n;\r\n    }\r\n    if (match(p, TOK_RETURN)) {\r\n        int line = prev(p)->line;\r\n        ASTNode *value = NULL;\r\n        if (!check(p, TOK_SEMICOLON)) value = parse_expr(p);\r\n        expect(p, TOK_SEMICOLON, \"';'\");\r\n        ASTNode *n = ast_alloc(); n->type = NODE_RETURN; n->line = line;\r\n        n->data.ret.value = value; return n;\r\n    }\r\n    if (match(p, TOK_FOR)) {\r\n        return parse_for(p);\r\n"]
[5280.86627, "o", "    }\r\n    if (match(p, TOK_BREAK)) {\r\n        int line = prev(p)->line;\r\n        expect(p, TOK_SEMICOLON, \"';'\");\r\n        ASTNode *n = ast_alloc(); n->type = NODE_BREAK; n->line = line; return n;\r\n    }\r\n    if (match(p, TOK_CONTINUE)) {\r\n        int line = prev(p)->line;\r\n        expect(p, TOK_SEMICOLON, \"';'\");\r\n        ASTNode *n = ast_alloc(); n->type = NODE_CONTINUE; n->line = line; return n;\r\n    }\r\n    if (match(p, TOK_PRINT)) {\r\n"]
[5280.866326, "o", "        int line = prev(p)->line;\r\n        ASTNode *value = parse_expr(p);\r\n        expect(p, TOK_SEMICOLON, \"';'\");\r\n        ASTNode *n = ast_alloc(); n->type = NODE_PRINT; n->line = line;\r\n        n->data.print.value = value; return n;\r\n    }\r\n    if (match(p, TOK_FN)) {\r\n        int line = prev(p)->line;\r\n        expect(p, TOK_IDENT, \"function name\");\r\n        char name[MAX_IDENT_LEN];\r\n        strncpy(name, prev(p)->text, MAX_IDENT_LEN - 1); name[MAX_IDENT_LEN-1] = '\\0';\r\n        expect(p, TOK_LPAREN, \"'('\");\r\n        ASTNode *n = ast_alloc(); n->type = NODE_FUNC; n->line = line;\r\n        strncpy(n->data.func.name, name, MAX_IDENT_LEN - 1);\r\n        n->data.func.param_count = 0;\r\n"]
[5280.866383, "o", "        if (!check(p, TOK_RPAREN)) {\r\n            do {\r\n                expect(p, TOK_IDENT, \"parameter name\");\r\n"]
[5280.866447, "o", "                strncpy(n->data.func.params[n->data.func.param_count],\r\n                        prev(p)->text, MAX_IDENT_LEN - 1);\r\n                n->data.func.param_count++;\r\n            } while (match(p, TOK_COMMA));\r\n        }\r\n        expect(p, TOK_RPAREN, \"')'\");\r\n        n->data.func.body = parse_block(p); return n;\r\n    }\r\n    if (check(p, TOK_IDENT)) {\r\n        ASTNode *a = try_parse_assign(p);\r\n        if (a) { expect(p, TOK_SEMICOLON, \"';'\"); return a; }\r\n    }\r\n    ASTNode *expr = parse_expr(p);\r\n    expect(p, TOK_SEMICOLON, \"';'\");\r\n    ASTNode *n = ast_alloc(); n->type = NODE_EXPR_STMT; n->line = expr->line;\r\n    n->data.expr_stmt.expr = expr; return n;\r\n}\r\n\r\nvoid parser_init(Parser *p, Token *tokens, int count) {\r\n    p->tokens = tokens; p->count = count; p->pos = 0; p->had_error = 0;\r\n"]
[5280.866508, "o", "}\r\n\r\nASTNode *parse_program(Parser *p) {\r\n    ASTNode *program = ast_alloc(); program->type = NODE_BLOCK; program->line = 1;\r\n    nodelist_init(&program->data.block.stmts);\r\n    while (!check(p, TOK_EOF)) {\r\n        ASTNode *stmt = parse_stmt(p);\r\n        if (stmt) nodelist_push(&program->data.block.stmts, stmt);\r\n        if (p->had_error) break;\r\n    }\r\n    return program;\r\n"]
[5280.867013, "o", "\u001b[?2004h"]
[5280.867089, "o", "root@n30009:/app# "]
[5281.169601, "i", "sed -n '1,460p' src/codegen.c\n"]
[5281.169887, "o", "sed -n '1,460p' src/codegen.c\r\n\u001b[?2004l\r"]
[5281.172959, "o", "#include \"codegen.h\"\r\n\r\nstatic int emit(Compiler *c, Opcode op, int64_t operand, char *str_op) {\r\n    if (c->code_count >= MAX_BYTECODE) { fprintf(stderr, \"bytecode overflow\\n\"); return -1; }\r\n    Instruction *ins = &c->code[c->code_count];\r\n"]
[5281.173017, "o", "    ins->op = op; ins->operand = operand; ins->str_operand = str_op;\r\n    return c->code_count++;\r\n}\r\n\r\nstatic int resolve_local(Compiler *c, const char *name) {\r\n    for (int i = c->local_count - 1; i >= 0; i--) {\r\n        if (strcmp(c->locals[i].name, name) == 0) return i;\r\n    }\r\n    return -1;\r\n}\r\n\r\nstatic int add_local(Compiler *c, const char *name) {\r\n"]
[5281.173122, "o", "    if (c->local_count >= MAX_LOCALS) { fprintf(stderr, \"too many local variables\\n\"); return -1; }\r\n    Local *local = &c->locals[c->local_count];\r\n    strncpy(local->name, name, MAX_IDENT_LEN - 1); local->name[MAX_IDENT_LEN - 1] = '\\0';\r\n    local->scope_depth = c->scope_depth;\r\n    return c->local_count++;\r\n}\r\n\r\nstatic int find_function(Compiler *c, const char *name) {\r\n    for (int i = 0; i < c->func_count; i++) {\r\n        if (strcmp(c->functions[i].name, name) == 0) return i;\r\n    }\r\n    return -1;\r\n}\r\n\r\nstatic void compile_store(Compiler *c, const char *name) {\r\n    int slot = resolve_local(c, name);\r\n    if (slot >= 0) emit(c, BC_STORE_LOCAL, slot, NULL);\r\n    else emit(c, BC_STORE_GLOBAL, 0, strdup(name));\r\n}\r\n\r\nstatic void compile_load(Compiler *c, const char *name) {\r\n    int slot = resolve_local(c, name);\r\n    if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);\r\n    else emit(c, BC_LOAD_GLOBAL, 0, strdup(name));\r\n}\r\n"]
[5281.173179, "o", "\r\n#define MAX_LOOP_DEPTH 64\r\n#define MAX_LOOP_JUMPS 256\r\ntypedef struct {\r\n"]
[5281.173287, "o", "    int start;\r\n    int cont;\r\n    int end;\r\n    int breaks[MAX_LOOP_JUMPS];\r\n    int break_count;\r\n    int conts[MAX_LOOP_JUMPS];\r\n    int cont_count;\r\n} LoopCtx;\r\nstatic LoopCtx loop_stack[MAX_LOOP_DEPTH];\r\nstatic int loop_depth = 0;\r\n\r\nstatic int compile_node(Compiler *c, ASTNode *node);\r\n\r\n"]
[5281.173307, "o", "static int compile_expr(Compiler *c, ASTNode *node) {\r\n    switch (node->type) {\r\n        case NODE_NUM_LIT:\r\n            emit(c, BC_PUSH_INT, node->data.num_val, NULL); break;\r\n        case NODE_STR_LIT: {\r\n            char *s = strdup(node->data.str_val);\r\n            emit(c, BC_PUSH_STR, 0, s); break;\r\n        }\r\n        case NODE_BOOL_LIT:\r\n            emit(c, BC_PUSH_BOOL, node->data.bool_val, NULL); break;\r\n        case NODE_IDENT: {\r\n            int slot = resolve_local(c, node->data.ident);\r\n            if (slot >= 0) emit(c, BC_LOAD_LOCAL, slot, NULL);\r\n            else emit(c, BC_LOAD_GLOBAL, 0, strdup(node->data.ident));\r\n            break;\r\n        }\r\n        case NODE_BINOP:\r\n            compile_expr(c, node->data.binop.left);"]
[5281.173378, "o", "\r\n            compile_expr(c, node->data.binop.right);\r\n            switch (node->data.binop.op) {\r\n                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;\r\n                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;\r\n                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;\r\n                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;\r\n                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;\r\n                case OP_EQ:  emit(c, BC_EQ, 0, NULL); break;\r\n                case OP_NEQ: emit(c, BC_NEQ, 0, NULL); break;\r\n                case OP_LT:  emit(c, BC_LT, 0, NULL); break;\r\n                case OP_GT:  emit(c, BC_GT, 0, NULL); break;\r\n                case OP_LEQ: emit(c, BC_LEQ, 0, NULL); break;\r\n"]
[5281.173431, "o", "                case OP_GEQ: emit(c, BC_GEQ, 0, NULL); break;\r\n                case OP_AND: emit(c, BC_AND, 0, NULL); break;\r\n"]
[5281.173485, "o", "                case OP_OR:  emit(c, BC_OR, 0, NULL); break;\r\n            }\r\n            break;\r\n        case NODE_UNARY:\r\n            compile_expr(c, node->data.unary.operand);\r\n            if (node->data.unary.op == UNOP_NEG) emit(c, BC_NEG, 0, NULL);\r\n            else emit(c, BC_NOT, 0, NULL);\r\n            break;\r\n        case NODE_CALL: {\r\n            int fi = find_function(c, node->data.call.name);\r\n"]
[5281.173538, "o", "            if (fi < 0) { error_at(node->line, \"undefined function '%s'\", node->data.call.name); return -1; }\r\n            for (int i = 0; i < node->data.call.args.count; i++)\r\n                compile_expr(c, node->data.call.args.items[i]);\r\n            emit(c, BC_CALL, fi, NULL);\r\n            break;\r\n        }\r\n        case NODE_INDEX:\r\n            compile_expr(c, node->data.index_access.obj);\r\n            compile_expr(c, node->data.index_access.index);\r\n            emit(c, BC_INDEX, 0, NULL); break;\r\n        case NODE_ARRAY_LIT:\r\n"]
[5281.173579, "o", "            for (int i = 0; i < node->data.array_lit.elems.count; i++)\r\n                compile_expr(c, node->data.array_lit.elems.items[i]);\r\n            emit(c, BC_PUSH_ARRAY, node->data.array_lit.elems.count, NULL); break;\r\n        default:\r\n            error_at(node->line, \"cannot compile expression of type %d\", node->type); return -1;\r\n    }\r\n    return 0;\r\n}\r\n\r\n"]
[5281.173631, "o", "static int compile_node(Compiler *c, ASTNode *node) {\r\n    switch (node->type) {\r\n        case NODE_LET: {\r\n            int slot = add_local(c, node->data.let.name);\r\n            if (slot < 0) return -1;\r\n            compile_expr(c, node->data.let.init);\r\n            break;\r\n        }\r\n        case NODE_ASSIGN: {\r\n            compile_expr(c, node->data.assign.value);\r\n            compile_store(c, node->data.assign.name);\r\n            break;\r\n        }\r\n        case NODE_IF: {\r\n            compile_expr(c, node->data.if_stmt.cond);\r\n            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n"]
[5281.173681, "o", "            compile_node(c, node->data.if_stmt.then_b);\r\n            if (node->data.if_stmt.else_b) {\r\n                int je = emit(c, BC_JUMP, 0, NULL);\r\n"]
[5281.173732, "o", "                c->code[jf].operand = c->code_count;\r\n                compile_node(c, node->data.if_stmt.else_b);\r\n                c->code[je].operand = c->code_count;\r\n            } else {\r\n                c->code[jf].operand = c->code_count;\r\n            }\r\n            break;\r\n        }\r\n        case NODE_WHILE: {\r\n"]
[5281.173783, "o", "            int loop_start = c->code_count;\r\n            compile_expr(c, node->data.while_stmt.cond);\r\n            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n            ctx->start = loop_start; ctx->cont = loop_start; ctx->end = -1;\r\n            ctx->break_count = 0; ctx->cont_count = 0;\r\n"]
[5281.173836, "o", "            compile_node(c, node->data.while_stmt.body);\r\n            emit(c, BC_JUMP, loop_start, NULL);\r\n            int end = c->code_count;\r\n            c->code[jf].operand = end;\r\n            ctx->end = end;\r\n            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;\r\n            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = ctx->cont;\r\n            loop_depth--;\r\n            break;\r\n        }\r\n        case NODE_FOR: {\r\n            int old_lc = c->local_count;\r\n"]
[5281.173888, "o", "            c->scope_depth++;\r\n            if (node->data.for_stmt.init) compile_node(c, node->data.for_stmt.init);\r\n            int loop_start = c->code_count;\r\n            if (node->data.for_stmt.cond) compile_expr(c, node->data.for_stmt.cond);\r\n            else emit(c, BC_PUSH_BOOL, 1, NULL);\r\n            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\r\n"]
[5281.173941, "o", "            ctx->break_count = 0; ctx->cont_count = 0;\r\n            compile_node(c, node->data.for_stmt.body);\r\n            int step_start = c->code_count;\r\n            ctx->cont = step_start;\r\n            if (node->data.for_stmt.step) compile_node(c, node->data.for_stmt.step);\r\n            emit(c, BC_JUMP, loop_start, NULL);\r\n            int end = c->code_count;\r\n            c->code[jf].operand = end;\r\n            ctx->end = end;\r\n            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = end;\r\n"]
[5281.173993, "o", "            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = step_start;\r\n            loop_depth--;\r\n            int n = c->local_count - old_lc;\r\n            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n            c->local_count = old_lc;\r\n            c->scope_depth--;\r\n            break;\r\n        }\r\n        case NODE_FOREACH: {\r\n"]
[5281.174045, "o", "            int old_lc = c->local_count;\r\n            c->scope_depth++;\r\n            compile_expr(c, node->data.foreach_stmt.arr);\r\n            int arr_slot = add_local(c, \".forarr\");\r\n            emit(c, BC_PUSH_INT, 0, NULL);\r\n            int idx_slot = add_local(c, \".foridx\");\r\n            int var_slot = add_local(c, node->data.foreach_stmt.var);\r\n            emit(c, BC_PUSH_INT, 0, NULL);\r\n            int loop_start = c->code_count;\r\n            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n            emit(c, BC_LOAD_LOCAL, arr_slot, NULL);\r\n"]
[5281.174096, "o", "            emit(c, BC_ARRAY_LEN, 0, NULL);\r\n            emit(c, BC_LT, 0, NULL);\r\n            int jf = emit(c, BC_JUMP_FALSE, 0, NULL);\r\n            if (loop_depth >= MAX_LOOP_DEPTH) { error_at(node->line, \"too many nested loops\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth++];\r\n            ctx->start = loop_start; ctx->cont = -1; ctx->end = -1;\r\n            ctx->break_count = 0; ctx->cont_count = 0;\r\n            int body_old = c->local_count;\r\n            if (node->data.foreach_stmt.is_of) {\r\n"]
[5281.174154, "o", "                emit(c, BC_LOAD_LOCAL, arr_slot, NULL);\r\n                emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n                emit(c, BC_INDEX, 0, NULL);\r\n            } else {\r\n                emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n            }\r\n            emit(c, BC_STORE_LOCAL, var_slot, NULL);\r\n            compile_node(c, node->data.foreach_stmt.body);\r\n            int n = c->local_count - body_old;\r\n            int cleanup_start = c->code_count;\r\n            ctx->cont = cleanup_start;\r\n            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n            c->local_count = body_old;\r\n            emit(c, BC_LOAD_LOCAL, idx_slot, NULL);\r\n            emit(c, BC_PUSH_INT, 1, NULL);\r\n            emit(c, BC_ADD, 0, NULL);\r\n            emit(c, BC_STORE_LOCAL, idx_slot, NULL);\r\n            emit(c, BC_JUMP, loop_start, NULL);\r\n            int break_cleanup = c->code_count;\r\n"]
[5281.174208, "o", "            for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n            int end = c->code_count;\r\n            c->code[jf].operand = end;\r\n"]
[5281.174265, "o", "            ctx->end = end;\r\n            for (int i = 0; i < ctx->break_count; i++) c->code[ctx->breaks[i]].operand = break_cleanup;\r\n            for (int i = 0; i < ctx->cont_count; i++) c->code[ctx->conts[i]].operand = ctx->cont;\r\n            loop_depth--;\r\n            int n2 = c->local_count - old_lc;\r\n            for (int i = 0; i < n2; i++) emit(c, BC_POP, 0, NULL);\r\n            c->local_count = old_lc;\r\n            c->scope_depth--;\r\n            break;\r\n        }\r\n        case NODE_BREAK: {\r\n            if (loop_depth <= 0) { error_at(node->line, \"break outside loop\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth - 1];\r\n            if (ctx->break_count >= MAX_LOOP_JUMPS) { error_at(node->line, \"too many break statements\"); return -1; }\r\n            ctx->breaks[ctx->break_count++] = emit(c, BC_JUMP, 0, NULL);\r\n            break;\r\n"]
[5281.174281, "o", "        }\r\n        case NODE_CONTINUE: {\r\n"]
[5281.174369, "o", "            if (loop_depth <= 0) { error_at(node->line, \"continue outside loop\"); return -1; }\r\n            LoopCtx *ctx = &loop_stack[loop_depth - 1];\r\n            if (ctx->cont_count >= MAX_LOOP_JUMPS) { error_at(node->line, \"too many continue statements\"); return -1; }\r\n            ctx->conts[ctx->cont_count++] = emit(c, BC_JUMP, 0, NULL);\r\n            break;\r\n        }\r\n        case NODE_COMPOUND_ASSIGN: {\r\n            compile_load(c, node->data.compound_assign.name);\r\n            compile_expr(c, node->data.compound_assign.value);\r\n            switch (node->data.compound_assign.op) {\r\n                case OP_ADD: emit(c, BC_ADD, 0, NULL); break;\r\n                case OP_SUB: emit(c, BC_SUB, 0, NULL); break;\r\n                case OP_MUL: emit(c, BC_MUL, 0, NULL); break;\r\n                case OP_DIV: emit(c, BC_DIV, 0, NULL); break;\r\n                case OP_MOD: emit(c, BC_MOD, 0, NULL); break;\r\n                default: error_at(node->line, \"invalid compound assignment\"); return -1;\r\n            }\r\n        "]
[5281.174424, "o", "    compile_store(c, node->data.compound_assign.name);\r\n            break;\r\n        }\r\n"]
[5281.174475, "o", "        case NODE_RETURN: {\r\n            if (node->data.ret.value) compile_expr(c, node->data.ret.value);\r\n            else emit(c, BC_PUSH_INT, 0, NULL);\r\n            emit(c, BC_RET, 0, NULL);\r\n            break;\r\n        }\r\n        case NODE_PRINT: {\r\n            compile_expr(c, node->data.print.value);\r\n            emit(c, BC_PRINT, 0, NULL);\r\n            break;\r\n        }\r\n        case NODE_BLOCK: {\r\n"]
[5281.17453, "o", "            int old_lc = c->local_count;\r\n            c->scope_depth++;\r\n            for (int i = 0; i < node->data.block.stmts.count; i++)\r\n                compile_node(c, node->data.block.stmts.items[i]);\r\n            c->scope_depth--;\r\n            {\r\n                int n = c->local_count - old_lc;\r\n                for (int i = 0; i < n; i++) emit(c, BC_POP, 0, NULL);\r\n            }\r\n            c->local_count = old_lc;\r\n"]
[5281.174579, "o", "            break;\r\n        }\r\n        case NODE_FUNC: {\r\n            int jump_over = emit(c, BC_JUMP, 0, NULL);\r\n\r\n            if (c->func_count >= MAX_FUNCTIONS) { fprintf(stderr, \"too many functions\\n\"); return -1; }\r\n            FuncInfo *fi = &c->functions[c->func_count];\r\n            strncpy(fi->name, node->data.func.name, MAX_IDENT_LEN - 1);\r\n            fi->addr = c->code_count;\r\n            fi->param_count = node->data.func.param_count;\r\n"]
[5281.174629, "o", "            c->func_count++;\r\n\r\n            int old_lc = c->local_count;\r\n            int old_scope = c->scope_depth;\r\n            int old_inf = c->in_function;\r\n            int old_loop_depth = loop_depth;\r\n            loop_depth = 0;\r\n\r\n            c->local_count = 0;\r\n            c->scope_depth = 0;\r\n            c->in_function = 1;\r\n            c->scope_depth++;\r\n"]
[5281.17468, "o", "\r\n            for (int i = 0; i < node->data.func.param_count; i++)\r\n                add_local(c, node->data.func.params[i]);\r\n\r\n            compile_node(c, node->data.func.body);\r\n\r\n            emit(c, BC_PUSH_INT, 0, NULL);\r\n            emit(c, BC_RET, 0, NULL);\r\n\r\n            c->scope_depth = old_scope;\r\n            c->local_count = old_lc;\r\n"]
[5281.17473, "o", "            c->in_function = old_inf;\r\n            loop_depth = old_loop_depth;\r\n\r\n            c->code[jump_over].operand = c->code_count;\r\n            break;\r\n        }\r\n        case NODE_EXPR_STMT: {\r\n            compile_expr(c, node->data.expr_stmt.expr);\r\n            emit(c, BC_POP, 0, NULL);\r\n            break;\r\n        }\r\n        default:\r\n"]
[5281.17478, "o", "            compile_expr(c, node);\r\n            emit(c, BC_POP, 0, NULL);\r\n            break;\r\n    }\r\n    return 0;\r\n}\r\n\r\nvoid compiler_init(Compiler *c) {\r\n    c->code_count = 0; c->local_count = 0; c->scope_depth = 0;\r\n"]
[5281.174834, "o", "    c->func_count = 0; c->in_function = 0;\r\n}\r\n\r\nint compile(Compiler *c, ASTNode *program) {\r\n    if (compile_node(c, program) < 0) return -1;\r\n    emit(c, BC_HALT, 0, NULL);\r\n    return 0;\r\n}\r\n"]
