[7661.28464, "o", "            collect_free_names(node->data.compound_assign.value, bound, bound_count, free_names, free_count);\r\n            if (!name_in_list(bound, bound_count, node->data.compound_assign.name)) add_name(free_names, free_count, node->data.compound_assign.name);\r\n            break;\r\n        case NODE_CALL:\r\n            if (!name_in_list(bound, bound_count, node->data.call.name)) add_name(free_names, free_count, node->data.call.name);\r\n            for (int i = 0; i < node->data.call.args.count; i++)\r\n                collect_free_names(node->data.call.args.items[i], bound, bound_count, free_names, free_count);\r\n            break;\r\n        case NODE_BINOP:\r\n            collect_free_names(node->data.binop.left, bound, bound_count, free_names, free_count);\r\n            collect_free_names(node->data.binop.right, bound, bound_count, free_names, free_count);\r\n            break;\r\n        case NODE_UNARY:\r\n            collect_free_names(node->data.unary.operand, bound, bound_count, free_names, free_count);\r\n            "]
[7661.284732, "o", "break;\r\n        case NODE_INDEX:\r\n            collect_free_names(node->data.index_access.obj, bound, bound_count, free_names, free_count);\r\n            collect_free_names(node->data.index_access.index, bound, bound_count, free_names, free_count);\r\n            break;\r\n        case NODE_INDEX_ASSIGN:\r\n            if (node->data.index_assign.obj) collect_free_names(node->data.index_assign.obj, bound, bound_count, free_names, free_count);\r\n            else if (node->data.index_assign.name[0]) { if (!name_in_list(bound, bound_count, node->data.index_assign.name)) add_name(free_names, free_count, node->data.index_assign.name); }\r\n            collect_free_names(node->data.index_assign.index, bound, bound_count, free_names, free_count);\r\n            collect_free_names(node->data.index_assign.value, bound, bound_count, free_names, free_count);\r\n            break;\r\n        case NODE_FIELD_ACCESS:\r\n            collect_free_names(node->data.field_access.obj, bound, bound_count, free_names, free_count);\r\n            break"]
[7661.284806, "o", ";\r\n        case NODE_FIELD_ASSIGN:\r\n            collect_free_names(node->data.field_assign.obj, bound, bound_count, free_names, free_count);\r\n            collect_free_names(node->data.field_assign.value, bound, bound_count, free_names, free_count);\r\n            break;\r\n        case NODE_LET:\r\n            collect_free_names(node->data.let.init, bound, bound_count, free_names, free_count);\r\n"]
