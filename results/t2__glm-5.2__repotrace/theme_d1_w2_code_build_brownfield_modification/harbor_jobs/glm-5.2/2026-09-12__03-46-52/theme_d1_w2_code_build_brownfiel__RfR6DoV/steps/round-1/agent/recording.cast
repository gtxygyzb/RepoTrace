[1867.394789, "o", "#ifndef MINICC_AST_H\r\n#define MINICC_AST_H\r\n\r\n#include \"common.h\"\r\n\r\nASTNode *ast_alloc(void);\r\nvoid ast_free_all(void);\r\nvoid nodelist_init(NodeList *list);\r\n"]
[1867.39494, "o", "void nodelist_push(NodeList *list, ASTNode *node);\r\n\r\n#endif\r\n"]
[1867.395374, "o", "\u001b[?2004h"]
