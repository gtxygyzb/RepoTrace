[5999.299931, "o", "#include \"vm.h\"\r\n#include <string.h>\r\n\r\nstatic void push(VM *vm, Value v) {\r\n    if (vm->sp >= MAX_STACK) { fprintf(stderr, \"stack overflow\\n\"); exit(1); }\r\n    vm->stack[vm->sp++] = v;\r\n}\r\n\r\n"]
[5999.300057, "o", "static Value pop(VM *vm) {\r\n    if (vm->sp <= 0) { fprintf(stderr, \"stack underflow\\n\"); exit(1); }\r\n    return vm->stack[--vm->sp];\r\n}\r\n\r\nstatic Value make_int(int64_t v) { Value val; val.type = VAL_INT; val.data.ival = v; return val; }\r\nstatic Value make_str(const char *s) { Value val; val.type = VAL_STR; val.data.sval = strdup(s); return val; }\r\nstatic Value make_bool(int b) { Value val; val.type = VAL_BOOL; val.data.bval = b; return val; }\r\n\r\nstatic Value make_map(void) {\r\n    Value val; val.type = VAL_MAP; val.data.map = malloc(sizeof(MapData));\r\n    val.data.map->keys = NULL; val.data.map->values = NULL; val.data.map->len = 0; val.data.map->cap = 0;\r\n    return val;\r\n}\r\n\r\nstatic int map_find(MapData *m, const char *key) {\r\n    for (int i = 0; i < m->len; i++) if (strcmp(m->keys[i], key) == 0) return i;\r\n    return -1;\r\n}\r\n\r\nstatic void map_set(MapData *m, const char *key, Value v) {\r\n    int i = map_find(m, key);\r\n    if (i >= 0) { m->values[i] = v; return; }\r\n    if (m->len >= m->cap) {\r\n        int ca"]
[5999.300138, "o", "p = m->cap == 0 ? 8 : m->cap * 2;\r\n        m->keys = realloc(m->keys, cap * sizeof(char*));\r\n        m->values = realloc(m->values, cap * sizeof(Value));\r\n        m->cap = cap;\r\n    }\r\n    m->keys[m->len] = strdup(key);\r\n    m->values[m->len] = v;\r\n    m->len++;\r\n}\r\n\r\nstatic int map_delete(MapData *m, const char *key) {\r\n    int i = map_find(m, key);\r\n    if (i < 0) return 0;\r\n    free(m->keys[i]);\r\n    for (int j = i; j < m->len - 1; j++) { m->keys[j] = m->keys[j+1]; m->values[j] = m->values[j+1]; }\r\n    m->len--;\r\n    return 1;\r\n}\r\n\r\n\r\nstatic int resolve_global(VM *vm, const char *name) {\r\n    for (int i = 0; i < vm->global_count; i++)\r\n        if (strcmp(vm->global_names[i], name) == 0) return i;\r\n    return -1;\r\n}\r\n"]
[5999.300244, "o", "\r\nstatic int add_global(VM *vm, const char *name) {\r\n    if (vm->global_count >= MAX_GLOBALS) { fprintf(stderr, \"too many globals\\n\"); return -1; }\r\n    int idx = vm->global_count;\r\n    strncpy(vm->global_names[idx], name, MAX_IDENT_LEN - 1);\r\n    vm->globals[idx].type = VAL_NULL;\r\n    vm->global_count++;\r\n    return idx;\r\n}\r\n\r\nstatic int64_t value_to_int(Value v) {\r\n    switch (v.type) { case VAL_INT: return v.data.ival; case VAL_BOOL: return v.data.bval ? 1 : 0; default: return 0; }\r\n}\r\n\r\nstatic int value_is_integer_like(Value v) {\r\n"]
[5999.300317, "o", "    return v.type == VAL_INT || v.type == VAL_BOOL;\r\n}\r\n\r\nstatic int value_truthy(Value v) {\r\n    switch (v.type) {\r\n        case VAL_INT: return v.data.ival != 0;\r\n        case VAL_BOOL: return v.data.bval;\r\n        case VAL_STR: return v.data.sval && v.data.sval[0] != '\\0';\r\n        case VAL_ARRAY: return v.data.array.len > 0;\r\n        case VAL_MAP: return v.data.map && v.data.map->len > 0;\r\n        case VAL_NULL: return 0;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int values_equal(Value a, Value b) {\r\n    if (a.type != b.type) return 0;\r\n    switch (a.type) {\r\n        case VAL_INT: return a.data.ival == b.data.ival;\r\n        case VAL_BOOL: return a.data.bval == b.data.bval;\r\n"]
[5999.300382, "o", "        case VAL_STR: return strcmp(a.data.sval, b.data.sval) == 0;\r\n        case VAL_NULL: return 1;\r\n        default: return 0;\r\n    }\r\n}\r\n\r\nstatic const char *value_to_cstr(Value v, char *buf, size_t size) {\r\n    switch (v.type) {\r\n        case VAL_STR: return v.data.sval;\r\n        case VAL_INT: snprintf(buf, size, \"%lld\", (long long)v.data.ival); return buf;\r\n        case VAL_BOOL: return v.data.bval ? \"true\" : \"false\";\r\n        case VAL_NULL: return \"null\";\r\n        default: return \"\";\r\n    }\r\n}\r\n\r\n"]
[5999.300446, "o", "static const char *value_to_key(Value v, char *buf, size_t size) {\r\n    if (v.type == VAL_STR) return v.data.sval;\r\n    return value_to_cstr(v, buf, size);\r\n}\r\n\r\nstatic int value_cmp(Value a, Value b) {\r\n    if (a.type == VAL_STR && b.type == VAL_STR)\r\n        return strcmp(a.data.sval, b.data.sval);\r\n    int64_t ia = value_to_int(a), ib = value_to_int(b);\r\n    return ia < ib ? -1 : (ia > ib ? 1 : 0);\r\n}\r\n\r\nstatic void print_value(Value v) {\r\n    switch (v.type) {\r\n        case VAL_INT: printf(\"%lld\", (long long)v.data.ival); break;\r\n"]
[5999.300501, "o", "        case VAL_BOOL: printf(\"%s\", v.data.bval ? \"true\" : \"false\"); break;\r\n        case VAL_STR: printf(\"%s\", v.data.sval); break;\r\n        case VAL_ARRAY:\r\n            printf(\"[\");\r\n            for (int i = 0; i < v.data.array.len; i++) {\r\n                if (i > 0) printf(\", \");\r\n                print_value(v.data.array.items[i]);\r\n            }\r\n            printf(\"]\");\r\n            break;\r\n        case VAL_MAP:\r\n            printf(\"{\");\r\n"]
[5999.300554, "o", "            for (int i = 0; i < v.data.map->len; i++) {\r\n                if (i > 0) printf(\", \");\r\n                printf(\"%s\", v.data.map->keys[i]);\r\n                printf(\": \");\r\n                print_value(v.data.map->values[i]);\r\n            }\r\n            printf(\"}\");\r\n            break;\r\n        case VAL_NULL: printf(\"null\"); break;\r\n    }\r\n"]
[5999.300608, "o", "}\r\n\r\nvoid vm_init(VM *vm, Compiler *c) {\r\n    vm->sp = 0; vm->frame_count = 0; vm->global_count = 0;\r\n    vm->code = c->code; vm->code_count = c->code_count;\r\n    vm->functions = c->functions; vm->func_count = c->func_count;\r\n    vm->ip = 0;\r\n}\r\n\r\nint vm_run(VM *vm) {\r\n    while (vm->ip < vm->code_count) {\r\n"]
[5999.300661, "o", "        Instruction *ins = &vm->code[vm->ip++];\r\n        switch (ins->op) {\r\n            case BC_PUSH_INT: push(vm, make_int(ins->operand)); break;\r\n            case BC_PUSH_STR: push(vm, make_str(ins->str_operand)); break;\r\n            case BC_PUSH_BOOL: push(vm, make_bool((int)ins->operand)); break;\r\n            case BC_LOAD_LOCAL: {\r\n                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;\r\n                push(vm, vm->stack[base + (int)ins->operand]);\r\n"]
[5999.300715, "o", "                break;\r\n            }\r\n            case BC_STORE_LOCAL: {\r\n                int base = (vm->frame_count > 0) ? vm->frames[vm->frame_count-1].local_start : 0;\r\n                vm->stack[base + (int)ins->operand] = pop(vm);\r\n                break;\r\n            }\r\n            case BC_LOAD_GLOBAL: {"]
[5999.3008, "o", "\r\n                int idx = resolve_global(vm, ins->str_operand);\r\n                if (idx < 0) { fprintf(stderr, \"undefined variable '%s'\\n\", ins->str_operand); return -1; }\r\n                push(vm, vm->globals[idx]);\r\n                break;\r\n            }\r\n            case BC_STORE_GLOBAL: {\r\n                int idx = resolve_global(vm, ins->str_operand);\r\n                if (idx < 0) idx = add_global(vm, ins->str_operand);\r\n                vm->globals[idx] = pop(vm);\r\n                break;\r\n            }\r\n"]
[5999.30088, "o", "            case BC_ADD: {\r\n                Value b = pop(vm); Value a = pop(vm);\r\n                if (a.type == VAL_STR || b.type == VAL_STR) {\r\n                    char bufa[64], bufb[64];\r\n                    const char *sa = value_to_cstr(a, bufa, sizeof(bufa));\r\n                    const char *sb = value_to_cstr(b, bufb, sizeof(bufb));\r\n                    char *r = malloc(strlen(sa) + strlen(sb) + 1);\r\n                    strcpy(r, sa); strcat(r, sb);\r\n                    Value v; v.type = VAL_STR; v.data.sval = r; push(vm, v);\r\n                } else { push(vm, make_int(value_to_int(a) + value_to_int(b))); }\r\n                break;\r\n            }\r\n            case BC_SUB: { Value b = pop(vm); Value a = pop(vm);\r\n                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {\r\n                    fprintf(stderr, \"operator '-' expects integers\\n\");\r\n                    return -1;\r\n"]
[5999.300939, "o", "                }\r\n                push(vm, make_int(value_to_int(a) - value_to_int(b))); break; }\r\n            case BC_MUL: { Value b = pop(vm); Value a = pop(vm);\r\n                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {\r\n                    fprintf(stderr, \"operator '*' expects integers\\n\");\r\n                    return -1;\r\n                }\r\n                push(vm, make_int(value_to_int(a) * value_to_int(b))); break; }\r\n            case BC_DIV: { Value b = pop(vm); Value a = pop(vm);\r\n"]
[5999.301, "o", "                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {\r\n                    fprintf(stderr, \"operator '/' expects integers\\n\");\r\n                    return -1;\r\n                }\r\n                if (value_to_int(b) == 0) { fprintf(stderr, \"division by zero\\n\"); return -1; }\r\n                push(vm, make_int(value_to_int(a) / value_to_int(b))); break; }\r\n            case BC_MOD: { Value b = pop(vm); Value a = pop(vm);\r\n                if (!value_is_integer_like(a) || !value_is_integer_like(b)) {\r\n                    fprintf(stderr, \"operator '%%' expects integers\\n\");\r\n                    return -1;\r\n                }\r\n"]
[5999.301056, "o", "                if (value_to_int(b) == 0) { fprintf(stderr, \"modulo by zero\\n\"); return -1; }\r\n                push(vm, make_int(value_to_int(a) % value_to_int(b))); break; }\r\n            case BC_EQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(values_equal(a, b))); break; }\r\n            case BC_NEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(!values_equal(a, b))); break; }\r\n            case BC_LT: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_cmp(a, b) < 0)); break; }\r\n            case BC_GT: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_cmp(a, b) > 0)); break; }\r\n            case BC_LEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_cmp(a, b) <= 0)); break; }\r\n            case BC_GEQ: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_cmp(a, b) >= 0)); break; }\r\n            case BC_AND: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_truthy(a) && value_truthy(b))); break; }\r\n            case"]
[5999.301121, "o", " BC_OR: { Value b = pop(vm); Value a = pop(vm); push(vm, make_bool(value_truthy(a) || value_truthy(b))); break; }\r\n            case BC_NOT: { Value a = pop(vm); push(vm, make_bool(!value_truthy(a))); break; }\r\n            case BC_NEG: { Value a = pop(vm); push(vm, make_int(-value_to_int(a))); break; }\r\n            case BC_JUMP: vm->ip = (int)ins->operand; break;\r\n            case BC_JUMP_FALSE: { Value cond = pop(vm); if (!value_truthy(cond)) vm->ip = (int)ins->operand; break; }\r\n            case BC_CALL: {\r\n                int fi = (int)ins->operand;\r\n                FuncInfo *func = &vm->functions[fi];\r\n                if (vm->frame_count >= MAX_CALL_FRAMES) { fprintf(stderr, \"call stack overflow\\n\"); return -1; }\r\n                CallFrame *frame = &vm->frames[vm->frame_count++];\r\n                frame->ip = vm->ip;\r\n                frame->bp = vm->sp;\r\n                /* BUG: the callee's local base does not properly account for\r\n"]
[5999.301183, "o", "                   intermediate return values that earlier nested-call arguments\r\n                   left on the stack. For multi-argument calls that are preceded\r\n                   by such temporaries the base is mis-computed (off by one),\r\n                   so nested calls used as arguments (e.g. add(double(3), triple(2)))\r\n                   read the wrong stack slots and produce wrong results. */\r\n                frame->local_start = vm->sp - func->param_count;\r\n                vm->ip = func->addr;\r\n                break;\r\n            }\r\n            case BC_RET: {\r\n                Value retval = pop(vm);\r\n                if (vm->frame_count <= 0) { fprintf(stderr, \"return outside function\\n\"); return -1; }\r\n"]
