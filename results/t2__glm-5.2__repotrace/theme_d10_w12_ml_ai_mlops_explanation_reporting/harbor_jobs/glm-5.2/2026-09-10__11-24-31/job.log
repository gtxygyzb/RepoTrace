Sending keys: ['cat >> main.go <<\'EOF\'\n\nfunc buildComparisonData(baseline, candidate NormManifest, cfg RegressionConfig) (ComparisonData, error) {\n    if baseline.Model.TaskType != candidate.Model.TaskType {\n        return ComparisonData{}, fmt.Errorf("task type mismatch: baseline %q candidate %q", baseline.Model.TaskType, candidate.Model.TaskType)\n    }\n    baseSplits := make(map[string]bool)\n    for _, ev := range baseline.Evaluations {\n        baseSplits[ev.Split] = true\n    }\n    for _, ev := range candidate.Evaluations {\n        if !baseSplits[ev.Split] {\n            return ComparisonData{}, fmt.Errorf("split %q present in candidate but not baseline", ev.Split)\n        }\n    }\n    for _, ev := range baseline.Evaluations {\n        found := false\n        for _, cev := range candidate.Evaluations {\n            if cev.Split == ev.Split {\n                found = true\n                break\n            }\n        }\n        if !found {\n            return ComparisonData{}, fmt.Errorf("split %q present in baseline but not candidate", ev.Split)\n        }\n    }\n    taskType := baseline.Model.TaskType\n    metricOrder := metricOrderForTask(taskType)\n    cd := ComparisonData{\n        Baseline:           ModelRef{Name: baseline.Model.Name, Version: baseline.Model.Version},\n        Candidate:          ModelRef{Name: candidate.Model.Name, Version: candidate.Model.Version},\n        TaskType:           taskType,\n        SplitOrder:         []string{},\n        MetricOrder:        metricOrder,\n        Deltas:             make(map[string]map[string]DeltaEntry),\n        RegressionMetrics:  []string{},\n        RegressionAnalysis: make(map[string]RegressionAnalysisEntry),\n        Overall: Overall{\n            Verdict:               "PASS",\n            MaxCriticalRegressions: cfg.Rules.MaxCriticalRegressions,\n            MaxWarningRegressions:  cfg.Rules.MaxWarningRegressions,\n        },\n    }\n    for _, ev := range baseline.Evaluations {\n        cd.SplitOrder = append(cd.SplitOrder, ev.Split)\n    }\n    for _, metric := range metricOrder {\n        if _, ok := cfg.Thresholds[metric]; ok {\n            cd.RegressionMetrics = append(cd.RegressionMetrics, metric)\n        }\n    }\n    baseResults := make(map[string]EvalResult)\n    candResults := make(map[string]EvalResult)\n    for _, ev := range baseline.Evaluations {\n        baseResults[ev.Split] = computeMetrics(taskType, ev.Predictions)\n    }\n    for _, ev := range candidate.Evaluations {\n        candResults[ev.Split] = computeMetrics(taskType, ev.Predictions)\n    }\n    for _, split := range cd.SplitOrder {\n        cd.Deltas[split] = make(map[string]DeltaEntry)\n        for _, metric := range metricOrder {\n            b := baseResults[split].Metrics[metric]\n            c := candResults[split].Metrics[metric]\n            abs := c - b\n            var rel *float64\n            if math.Abs(b) > 1e-10 {\n                r := (c - b) / math.Abs(b)\n                r = round6(r)\n                rel = &r\n            }\n            cd.Deltas[split][metric] = DeltaEntry{\n                Baseline:      round6(b),\n                Candidate:     round6(c),\n                AbsoluteDelta: round6(abs),\n                RelativeDelta: rel,\n            }\n        }\n    }\n    criticalCount := 0\n    warningCount := 0\n    for _, metric := range cd.RegressionMetrics {\n        t := cfg.Thresholds[metric]\n        regressedSplits := []string{}\n        for _, split := range cd.SplitOrder {\n            b := baseResults[split].Metrics[metric]\n            c := candResults[split].Metrics[metric]\n            abs := c - b\n            regressed := abs < t.MinAbsoluteDelta\n            if !regressed && math.Abs(b) > 1e-10 {\n                rel := (c - b) / math.Abs(b)\n                if rel < t.MinRelativeDelta {\n                    regressed = true\n                }\n            }\n            if regressed {\n                regressedSplits = append(regressedSplits, split)\n            }\n        }\n        verdict := "PASS"\n        if len(regressedSplits) > 0 {\n            verdict = "REGRESSED"\n            switch t.Severity {\n            case "critical":\n                criticalCount++\n            case "warning":\n                warningCount++\n            }\n        }\n        cd.RegressionAnalysis[metric] = RegressionAnalysisEntry{\n            Severity:        t.Severity,\n            RegressedSplits: regressedSplits,\n            Verdict:         verdict,\n        }\n    }\n    cd.Overall.CriticalRegressions = criticalCount\n    cd.Overall.WarningRegressions = warningCount\n    if criticalCount > cfg.Rules.MaxCriticalRegressions || warningCount > cfg.Rules.MaxWarningRegressions {\n        cd.Overall.Verdict = "FAIL"\n    }\n    return cd, nil\n}\n\nfunc buildComparisonMarkdown(cd ComparisonData) string {\n    var b strings.Builder\n    fmt.Fprintf(&b, "# Model Comparison Report\\n\\n")\n    fmt.Fprintf(&b, "Baseline: %s v%s\\n", cd.Baseline.Name, cd.Baseline.Version)\n    fmt.Fprintf(&b, "Candidate: %s v%s\\n", cd.Candidate.Name, cd.Candidate.Version)\n    fmt.Fprintf(&b, "Task type: %s\\n\\n", cd.TaskType)\n    fmt.Fprintf(&b, "## Performance Delta\\n\\n")\n    fmt.Fprintln(&b, "| Metric | Split | Baseline | Candidate | Delta | Relative Delta |")\n    fmt.Fprintln(&b, "|--------|-------|----------|-----------|-------|----------------|")\n    for _, metric := range cd.MetricOrder {\n        for _, split := range cd.SplitOrder {\n            d := cd.Deltas[split][metric]\n            rel := "N/A"\n            if d.RelativeDelta != nil {\n                rel = formatFloat2(*d.RelativeDelta*100) + "%"\n            }\n            fmt.Fprintf(&b, "| %s | %s | %s | %s | %s | %s |\\n", metric, split, formatFloat6(d.Baseline), formatFloat6(d.Candidate), formatFloat6(d.AbsoluteDelta), rel)\n        }\n    }\n    fmt.Fprintln(&b)\n    fmt.Fprintf(&b, "## Regression Analysis\\n\\n")\n    fmt.Fprintln(&b, "| Metric | Severity | Regressed Splits | Verdict |")\n    fmt.Fprintln(&b, "|--------|----------|-----------------|---------|")\n    for _, metric := range cd.RegressionMetrics {\n        ra := cd.RegressionAnalysis[metric]\n        splits := strings.Join(ra.RegressedSplits, ", ")\n        fmt.Fprintf(&b, "| %s | %s | %s | %s |\\n", metric, ra.Severity, splits, ra.Verdict)\n    }\n    fmt.Fprintln(&b)\n    fmt.Fprintf(&b, "## Overall Verdict\\n\\n")\n    fmt.Fprintf(&b, "Result: %s\\n", cd.Overall.Verdict)\n    fmt.Fprintf(&b, "Critical regressions: %d / %d\\n", cd.Overall.CriticalRegressions, cd.Overall.MaxCriticalRegressions)\n    fmt.Fprintf(&b, "Warning regressions: %d / %d\\n", cd.Overall.WarningRegressions, cd.Overall.MaxWarningRegressions)\n    return b.String()\n}\n\nfunc runCompare(args []string) int {\n    fs := flag.NewFlagSet("compare", flag.ContinueOnError)\n    baselinePath := fs.String("baseline", "", "path to baseline manifest")\n    candidatePath := fs.String("candidate", "", "path to candidate manifest")\n    configPath := fs.String("config", "", "path to regression config")\n    outputDir := fs.String("output-dir", "", "directory for output files")\n    format := fs.String("format", "both", "output format: md, json, or both")\n    if err := fs.Parse(args); err != nil {\n        fmt.Fprintln(os.Stderr, err)\n        return 2\n    }\n    if *baselinePath == "" || *candidatePath == "" || *configPath == "" || *outputDir == "" {\n        fmt.Fprintln(os.Stderr, "--baseline, --candidate, --config, and --output-dir are required")\n        return 2\n    }\n    switch *format {\n    case "md", "json", "both":\n    default:\n        fmt.Fprintf(os.Stderr, "invalid --format %q; must be md, json, or both\\n", *format)\n        return 2\n    }\n    baseline, err := loadManifest(*baselinePath)\n    if err != nil {\n        fmt.Fprintln(os.Stderr, err)\n        return 2\n    }\n    candidate, err := loadManifest(*candidatePath)\n    if err != nil {\n        fmt.Fprintln(os.Stderr, err)\n        return 2\n    }\n    cfg, err := loadRegressionConfig(*configPath)\n    if err != nil {\n        fmt.Fprintln(os.Stderr, err)\n        return 2\n    }\n    cd, err := buildComparisonData(baseline, candidate, cfg)\n    if err != nil {\n        fmt.Fprintln(os.Stderr, err)\n        return 2\n    }\n    if err := os.MkdirAll(*outputDir, 0755); err != nil {\n        fmt.Fprintln(os.Stderr, err)\n        return 2\n    }\n    if *format == "md" || *format == "both" {\n        md := buildComparisonMarkdown(cd)\n        if err := writeFile(filepath.Join(*outputDir, "comparison.md"), []byte(md)); err != nil {\n            fmt.Fprintln(os.Stderr, err)\n            return 2\n        }\n    }\n    if *format == "json" || *format == "both" {\n        data, err := json.MarshalIndent(cd, "", "  ")\n        if err != nil {\n            fmt.Fprintln(os.Stderr, err)\n            return 2\n        }\n        if err := writeFile(filepath.Join(*outputDir, "comparison.json"), append(data, \'\\n\')); err != nil {\n            fmt.Fprintln(os.Stderr, err)\n            return 2\n        }\n    }\n    if cd.Overall.Verdict == "FAIL" {\n        return 1\n    }\n    return 0\n}\n\nfunc main() {\n    if len(os.Args) < 2 {\n        fmt.Fprintln(os.Stderr, "usage: mlreport <evaluate|compare> ...")\n        os.Exit(2)\n    }\n    var code int\n    switch os.Args[1] {\n    case "evaluate":\n        code = runEvaluate(os.Args[2:])\n    case "compare":\n        code = runCompare(os.Args[2:])\n    default:\n        fmt.Fprintf(os.Stderr, "unknown command %q\\n", os.Args[1])\n        code = 2\n    }\n    os.Exit(code)\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
