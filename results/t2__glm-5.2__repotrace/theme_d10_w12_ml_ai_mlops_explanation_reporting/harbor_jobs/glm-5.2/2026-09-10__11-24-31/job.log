ake(map[string]PerClassMetric)\n    for i, c := range classes {\n        pc := perClass[c]\n        sumTP += pc.tp\n        sumFP += pc.fp\n        sumFN += pc.fn\n        supports[i] = pc.support\n        precisions[i] = safeDivInt(pc.tp, pc.tp+pc.fp)\n        recalls[i] = safeDivInt(pc.tp, pc.tp+pc.fn)\n        f1s[i] = safeDiv(2*precisions[i]*recalls[i], precisions[i]+recalls[i])\n        perClassMetrics[c] = PerClassMetric{Precision: precisions[i], Recall: recalls[i], F1: f1s[i], Support: pc.support}\n    }\n    accuracy := safeDivInt(correct, total)\n    precisionMicro := safeDivInt(sumTP, sumTP+sumFP)\n    recallMicro := safeDivInt(sumTP, sumTP+sumFN)\n    f1Micro := safeDiv(2*precisionMicro*recallMicro, precisionMicro+recallMicro)\n    precisionMacro := mean(precisions)\n    recallMacro := mean(recalls)\n    f1Macro := mean(f1s)\n    precisionWeighted := weighted(precisions, supports)\n    recallWeighted := weighted(recalls, supports)\n    f1Weighted := weighted(f1s, supports)\n    metrics := map[string]float64{\n        "accuracy": accuracy,\n        "precision_micro": precisionMicro,\n        "recall_micro": recallMicro,\n        "f1_micro": f1Micro,\n        "precision_macro": precisionMacro,\n        "recall_macro": recallMacro,\n        "f1_macro": f1Macro,\n        "precision_weighted": precisionWeighted,\n        "recall_weighted": recallWeighted,\n        "f1_weighted": f1Weighted,\n    }\n    return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask("multiclass_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes), PerClassMetrics: perClassMetrics}\n}\n\nfunc computeRegression(preds []NormPrediction) EvalResult {\n    n := len(preds)\n    actuals := make([]float64, n)\n    predicted := make([]float64, n)\n    for i, p := range preds {\n        actuals[i] = p.ActualNum\n        predicted[i] = p.PredictedNum\n    }\n    se := 0.0\n    ae := 0.0\n    smapeSum := 0.0\n    smapeCount := 0\n    for i := 0; i < n; i++ {\n        d