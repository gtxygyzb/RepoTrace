Sending keys: ['cat >> main.go <<\'EOF\'\n\nfunc readJSON(path string, v any) error {\n    data, err := os.ReadFile(path)\n    if err != nil {\n        return fmt.Errorf("read %s: %w", path, err)\n    }\n    if err := json.Unmarshal(data, v); err != nil {\n        return fmt.Errorf("parse %s: %w", path, err)\n    }\n    return nil\n}\n\nfunc loadManifest(path string) (NormManifest, error) {\n    var raw Manifest\n    if err := readJSON(path, &raw); err != nil {\n        return NormManifest{}, err\n    }\n    if !validModelName.MatchString(raw.Model.Name) {\n        return NormManifest{}, fmt.Errorf("%s: invalid model name %q", path, raw.Model.Name)\n    }\n    if !validVersion.MatchString(raw.Model.Version) {\n        return NormManifest{}, fmt.Errorf("%s: invalid model version %q", path, raw.Model.Version)\n    }\n    switch raw.Model.TaskType {\n    case "binary_classification", "multiclass_classification", "regression":\n    default:\n        return NormManifest{}, fmt.Errorf("%s: invalid task_type %q", path, raw.Model.TaskType)\n    }\n    if len(raw.Evaluations) == 0 {\n        return NormManifest{}, fmt.Errorf("%s: at least one evaluation is required", path)\n    }\n    nm := NormManifest{Model: raw.Model}\n    splits := make(map[string]bool)\n    for _, ev := range raw.Evaluations {\n        if ev.Split == "" {\n            return NormManifest{}, fmt.Errorf("%s: split name is required", path)\n        }\n        if splits[ev.Split] {\n            return NormManifest{}, fmt.Errorf("%s: duplicate split name %q", path, ev.Split)\n        }\n        splits[ev.Split] = true\n        if ev.Dataset == "" {\n            return NormManifest{}, fmt.Errorf("%s: dataset is required for split %q", path, ev.Split)\n        }\n        if len(ev.Predictions) == 0 {\n            return NormManifest{}, fmt.Errorf("%s: split %q must have at least one prediction", path, ev.Split)\n        }\n        ne := NormEvaluation{Split: ev.Split, Dataset: ev.Dataset}\n        ids := make(map[string]bool)\n        for _, rp := range ev.Predictions {\n            if rp.ID == "" {\n                return NormManifest{}, fmt.Errorf("%s: prediction id is required in split %q", path, ev.Split)\n            }\n            if ids[rp.ID] {\n                return NormManifest{}, fmt.Errorf("%s: duplicate prediction id %q in split %q", path, rp.ID, ev.Split)\n            }\n            ids[rp.ID] = true\n            np, err := normalizePrediction(path, ev.Split, rp, raw.Model.TaskType)\n            if err != nil {\n                return NormManifest{}, err\n            }\n            ne.Predictions = append(ne.Predictions, np)\n        }\n        nm.Evaluations = append(nm.Evaluations, ne)\n    }\n    return nm, nil\n}\n\nfunc normalizePrediction(path, split string, rp RawPrediction, taskType string) (NormPrediction, error) {\n    np := NormPrediction{ID: rp.ID}\n    if taskType == "regression" {\n        if len(rp.Actual) == 0 {\n            return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual is required", path, split, rp.ID)\n        }\n        if err := json.Unmarshal(rp.Actual, &np.ActualNum); err != nil {\n            return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual must be a number", path, split, rp.ID)\n        }\n        if err := json.Unmarshal(rp.Predicted, &np.PredictedNum); err != nil {\n            return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: predicted must be a number", path, split, rp.ID)\n        }\n        if len(rp.Probabilities) > 0 && string(rp.Probabilities) != "null" {\n            return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities must be absent for regression", path, split, rp.ID)\n        }\n    } else {\n        if len(rp.Actual) == 0 {\n            return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual is required", path, split, rp.ID)\n        }\n        if err := json.Unmarshal(rp.Actual, &np.ActualStr); err != nil {\n            return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual must be a string", path, split, rp.ID)\n        }\n        if err := json.Unmarshal(rp.Predicted, &np.PredictedStr); err != nil {\n            return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: predicted must be a string", path, split, rp.ID)\n        }\n        if len(rp.Probabilities) == 0 || string(rp.Probabilities) == "null" {\n            return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities are required for classification", path, split, rp.ID)\n        }\n        probs := make(map[string]float64)\n        if err := json.Unmarshal(rp.Probabilities, &probs); err != nil {\n            return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: invalid probabilities", path, split, rp.ID)\n        }\n        if len(probs) == 0 {\n            return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities must not be empty", path, split, rp.ID)\n        }\n        sum := 0.0\n        for k, v := range probs {\n            if k == "" {\n                return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probability class label is empty", path, split, rp.ID)\n            }\n            if math.IsNaN(v) || math.IsInf(v, 0) || v < 0 || v > 1 {\n                return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probability for %q out of range", path, split, k)\n            }\n            sum += v\n        }\n        if math.Abs(sum-1) > 1e-6 {\n            return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities must sum to 1", path, split, rp.ID)\n        }\n        np.Probabilities = probs\n        np.HasProbabilities = true\n    }\n    return np, nil\n}\n\nfunc loadRegressionConfig(path string) (RegressionConfig, error) {\n    var cfg RegressionConfig\n    if err := readJSON(path, &cfg); err != nil {\n        return RegressionConfig{}, err\n    }\n    for metric, t := range cfg.Thresholds {\n        switch t.Severity {\n        case "critical", "warning", "info":\n        default:\n            return RegressionConfig{}, fmt.Errorf("%s: invalid severity %q for metric %q", path, t.Severity, metric)\n        }\n    }\n    return cfg, nil\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
