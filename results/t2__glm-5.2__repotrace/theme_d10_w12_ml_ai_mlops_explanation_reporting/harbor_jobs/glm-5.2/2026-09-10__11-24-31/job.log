tring `json:"classes"`\n\tMatrix  [][]int  `json:"matrix"`\n}\n\ntype PerClassMetric struct {\n\tPrecision float64 `json:"precision"`\n\tRecall    float64 `json:"recall"`\n\tF1        float64 `json:"f1"`\n\tSupport   int     `json:"support"`\n}\n\ntype CI struct {\n\tLower float64 `json:"lower"`\n\tUpper float64 `json:"upper"`\n}\n\ntype SplitReportJSON struct {\n\tDataset            string                       `json:"dataset"`\n\tMetrics            map[string]float64           `json:"metrics"`\n\tConfusionMatrix    *ConfusionMatrixReport       `json:"confusion_matrix,omitempty"`\n\tPerClassMetrics    map[string]PerClassMetric    `json:"per_class_metrics,omitempty"`\n\tConfidenceIntervals map[string]CI               `json:"confidence_intervals,omitempty"`\n}\n\ntype ReportJSON struct {\n\tModel  Model                      `json:"model"`\n\tSplits map[string]SplitReportJSON `json:"splits"`\n}\n\ntype EvalResult struct {\n\tMetrics        map[string]float64\n\tMetricOrder    []string\n\tConfusionMatrix *ConfusionMatrixReport\n\tPerClassMetrics map[string]PerClassMetric\n}\n\ntype ModelRef struct {\n\tName    string `json:"name"`\n\tVersion string `json:"version"`\n}\n\ntype DeltaEntry struct {\n\tBaseline      float64  `json:"baseline"`\n\tCandidate     float64  `json:"candidate"`\n\tAbsoluteDelta float64  `json:"absolute_delta"`\n\tRelativeDelta *float64 `json:"relative_delta"`\n}\n\ntype RegressionAnalysisEntry struct {\n\tSeverity        string   `json:"severity"`\n\tRegressedSplits []string `json:"regressed_splits"`\n\tVerdict         string   `json:"verdict"`\n}\n\ntype Overall struct {\n\tVerdict                string `json:"verdict"`\n\tCriticalRegressions    int    `json:"critical_regressions"`\n\tMaxCriticalRegressions int    `json:"max_critical_regressions"`\n\tWarningRegressions     int    `json:"warning_regressions"`\n\tMaxWarningRegressions  int    `json:"max_warning_regressions"`\n}\n\ntype ComparisonData struct {\n\tBaseline           ModelRef                          `json:"baseline"`\n\tCandidate          ModelRef                          `json:"candidate"`\n\tTaskType           string                            `json:"task_type"`\n\tSplitOrder         []string                          `json:"-"`\n\tMetricOrder        []string                          `json:"-"`\n\tDeltas             map[string]map[string]DeltaEntry  `json:"deltas"`\n\tRegressionMetrics  []string                          `json:"-"`\n\tRegressionAnalysis map[string]RegressionAnalysisEntry `json:"regression_analysis"`\n\tOverall            Overall                           `json:"overall"`\n}\n\nfunc round6(x float64) float64 {\n\tif math.IsNaN(x) || math.IsInf(x, 0) {\n\t\treturn 0\n\t}\n\tr := math.Round(x*1e6) / 1e6\n\tif r == 0 {\n\t\tr = 0\n\t}\n\treturn r\n}\n\nfunc formatFloat6(x float64) string {\n\treturn strconv.FormatFloat(round6(x), \'f\', 6, 64)\n}\n\nfunc formatFloat2(x float64) string {\n\treturn strconv.FormatFloat(math.Round(x*100)/100, \'f\', 2, 64)\n}\n\nfunc safeDiv(num, den float64) float64 {\n\tif den == 0 {\n\t\treturn 0\n\t}\n\treturn num / den\n}\n\nfunc safeDivInt(num, den int) float64 {\n\tif den == 0 {\n\t\treturn 0\n\t}\n\treturn float64(num) / float64(den)\n}\n\nfunc mean(vals []float64) float64 {\n\tif len(vals) == 0 {\n\t\treturn 0\n\t}\n\tsum := 0.0\n\tfor _, v := range vals {\n\t\tsum += v\n\t}\n\treturn sum / float64(len(vals))\n}\n\nfunc weighted(vals []float64, supports []int) float64 {\n\tif len(vals) == 0 {\n\t\treturn 0\n\t}\n\tsumVal := 0.0\n\tsumSup := 0\n\tfor i, v := range vals {\n\t\tsumVal += v * float64(supports[i])\n\t\tsumSup += supports[i]\n\t}\n\tif sumSup == 0 {\n\t\treturn 0\n\t}\n\treturn sumVal / float64(sumSup)\n}\n\nfunc clampIndex(i, n int) int {\n\tif i < 0 {\n\t\treturn 0\n\t}\n\tif i >= n {\n\t\treturn n - 1\n\t}\n\treturn i\n}\n\nfunc metricOrderForTask(taskType string) []string {\n\tswitch taskType {\n\tcase "binary_classification":\n\t\treturn []string{"accuracy", "precision", "recall", "f1", "auc_roc", "log_loss"}\n\tcase "multiclass_classification":\n\t\treturn []string{"accuracy", "precision_micro", "recall_micro", "f1_micro", "precision_macro", "recall_macro", "f1_macro", "precision_weighted", "recall_weighted", "f1_weighted"}\n\tcase "regression":\n\t\treturn []string{"mse", "rmse", "mae", "r_squared", "smape"}\n\tdefault:\n\t\treturn nil\n\t}\n}\n\nfunc ciMetricsForTask(taskType string) []string {\n\tswitch taskType {\n\tcase "binary_classification":\n\t\treturn []string{"accuracy", "precision", "recall", "f1", "auc_roc"}\n\tcase "multiclass_classification":\n\t\treturn []string{"accuracy", "f1_macro", "f1_weighted"}\n\tcase "regression":\n\t\treturn []string{"mse", "rmse", "mae", "r_squared"}\n\tdefault:\n\t\treturn nil\n\t}\n}\n\nfunc sortClasses(classes []string) {\n\tsort.Slice(classes, func(i, j int) bool {\n\t\tai := strings.ToLower(classes[i])\n\t\taj := strings.ToLower(classes[j])\n\t\tif ai != aj {\n\t\t\treturn ai < aj\n\t\t}\n\t\treturn classes[i] < classes[j]\n\t})\n}\n\nfunc collectClasses(preds []NormPrediction, fromActualOnly bool) []string {\n\tset := make(map[string]bool)\n\tfor _, p := range preds {\n\t\tif p.ActualStr != "" {\n\t\t\tset[p.ActualStr] = true\n\t\t}\n\t\tif !fromActualOnly && p.PredictedStr != "" {\n\t\t\tset[p.PredictedStr] = true\n\t\t}\n\t}\n\tclasses := make([]string, 0, len(set))\n\tfor c := range set {\n\t\tclasses = append(classes, c)\n\t}\n\tsortClasses(classes)\n\treturn classes\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
