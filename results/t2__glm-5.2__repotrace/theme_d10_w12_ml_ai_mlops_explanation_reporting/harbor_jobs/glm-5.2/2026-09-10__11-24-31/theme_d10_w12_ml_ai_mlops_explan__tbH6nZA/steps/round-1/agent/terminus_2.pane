var validModelName = regexp.MustCompile(`^[A-Za-z0-9-]+$`)
var validVersion = regexp.MustCompile(`^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$`)

type Manifest struct {
	Model       Model           `json:"model"`
	Evaluations []RawEvaluation `json:"evaluations"`
}

type Model struct {
	Name     string `json:"name"`
	Version  string `json:"version"`
	TaskType string `json:"task_type"`
}

type RawEvaluation struct {
	Split       string          `json:"split"`
	Dataset     string          `json:"dataset"`
	Predictions []RawPrediction `json:"predictions"`
}

type RawPrediction struct {
	ID            string          `json:"id"`
	Actual        json.RawMessage `json:"actual"`
	Predicted     json.RawMessage `json:"predicted"`
	Probabilities json.RawMessage `json:"probabilities"`
}

type NormManifest struct {
	Model       Model
	Evaluations []NormEvaluation
}

type NormEvaluation struct {
	Split       string
	Dataset     string
	Predictions []NormPrediction
}

type NormPrediction struct {
	ID               string
	ActualStr        string
	PredictedStr     string
	ActualNum        float64
	PredictedNum     float64
	Probabilities    map[string]float64
	HasProbabilities bool
}

type RegressionConfig struct {
	Thresholds map[string]Threshold `json:"thresholds"`
	Rules      Rules                `json:"rules"`
}

type Threshold struct {
	MaxDelta         *float64 `json:"max_delta,omitempty"`
	MaxRelativeDelta *float64 `json:"max_relative_delta,omitempty"`
	MinAbsoluteDelta float64  `json:"min_absolute_delta"`
	MinRelativeDelta float64  `json:"min_relative_delta"`
	Severity         string   `json:"severity"`
}

type Rules struct {
	MaxCriticalRegressions int `json:"max_critical_regressions"`
	MaxWarningRegressions  int `json:"max_warning_regressions"`
}

type ConfusionMatrixReport struct {
	Classes []string `json:"classes"`
	Matrix  [][]int  `json:"matrix"`
}

type PerClassMetric struct {
	Precision float64 `json:"precision"`
	Recall    float64 `json:"recall"`
	F1        float64 `json:"f1"`
	Support   int     `json:"support"`
}

type CI struct {
	Lower float64 `json:"lower"`
	Upper float64 `json:"upper"`
}

type SplitReportJSON struct {
	Dataset             string                    `json:"dataset"`
	Metrics             map[string]float64        `json:"metrics"`
	ConfusionMatrix     *ConfusionMatrixReport    `json:"confusion_matrix,omitempty"`
	PerClassMetrics     map[string]PerClassMetric `json:"per_class_metrics,omitempty"`
	ConfidenceIntervals map[string]CI             `json:"confidence_intervals,omitempty"`
}

type ReportJSON struct {
	Model  Model                      `json:"model"`
	Splits map[string]SplitReportJSON `json:"splits"`
}

type EvalResult struct {
	Metrics         map[string]float64
	MetricOrder     []string
	ConfusionMatrix *ConfusionMatrixReport
	PerClassMetrics map[string]PerClassMetric
}

type ModelRef struct {
	Name    string `json:"name"`
	Version string `json:"version"`
}

type DeltaEntry struct {
	Baseline      float64  `json:"baseline"`
	Candidate     float64  `json:"candidate"`
	AbsoluteDelta float64  `json:"absolute_delta"`
	RelativeDelta *float64 `json:"relative_delta"`
}

type RegressionAnalysisEntry struct {
	Severity        string   `json:"severity"`
	Direction       string   `json:"direction"`
	RegressedSplits []string `json:"regressed_splits"`
	Verdict         string   `json:"verdict"`
}

type Overall struct {
	Verdict                string `json:"verdict"`
	CriticalRegressions    int    `json:"critical_regressions"`
	MaxCriticalRegressions int    `json:"max_critical_regressions"`
	WarningRegressions     int    `json:"warning_regressions"`
	MaxWarningRegressions  int    `json:"max_warning_regressions"`
}

type ComparisonData struct {
	Baseline           ModelRef                           `json:"baseline"`
	Candidate          ModelRef                           `json:"candidate"`
	TaskType           string                             `json:"task_type"`
	SplitOrder         []string                           `json:"-"`
	MetricOrder        []string                           `json:"-"`
	Deltas             map[string]map[string]DeltaEntry   `json:"deltas"`
	RegressionMetrics  []string                           `json:"-"`
	RegressionAnalysis map[string]RegressionAnalysisEntry `json:"regression_analysis"`
	Overall            Overall                            `json:"overall"`
}

func round6(x float64) float64 {
	if math.IsNaN(x) || math.IsInf(x, 0) {
		return 0
	}
	r := math.Round(x*1e6) / 1e6
	if r == 0 {
		r = 0
	}
	return r
}

func formatFloat6(x float64) string {
	return strconv.FormatFloat(round6(x), 'f', 6, 64)
}

func formatFloat2(x float64) string {
	return strconv.FormatFloat(math.Round(x*100)/100, 'f', 2, 64)
}

func safeDiv(num, den float64) float64 {
	if den == 0 {
		return 0
[?2004hroot@n30009:/app# sed -n '180,360p' main.go
[?2004l		return 0
	}
	return num / den
}

func safeDivInt(num, den int) float64 {
	if den == 0 {
		return 0
	}
	return float64(num) / float64(den)
}

func mean(vals []float64) float64 {
	if len(vals) == 0 {
		return 0
	}
	sum := 0.0
	for _, v := range vals {
		sum += v
	}
	return sum / float64(len(vals))
}

func weighted(vals []float64, supports []int) float64 {
	if len(vals) == 0 {
		return 0
	}
	sumVal := 0.0
	sumSup := 0
	for i, v := range vals {
		sumVal += v * float64(supports[i])
		sumSup += supports[i]
	}
	if sumSup == 0 {
		return 0
	}
	return sumVal / float64(sumSup)
}

func clampIndex(i, n int) int {
	if i < 0 {
		return 0
	}
	if i >= n {
		return n - 1
	}
	return i
}

func metricOrderForTask(taskType string) []string {
	switch taskType {
	case "binary_classification":
		return []string{"accuracy", "precision", "recall", "f1", "auc_roc", "log_loss"}
	case "multiclass_classification":
		return []string{"accuracy", "precision_micro", "recall_micro", "f1_micro", "precision_macro", "recall_macro", "f1_macro", "precision_weighted", "recall_weighted", "f1_weighted"}
	case "regression":
		return []string{"mse", "rmse", "mae", "r_squared", "smape"}
	default:
		return nil
	}
}

func ciMetricsForTask(taskType string) []string {
	switch taskType {
	case "binary_classification":
		return []string{"accuracy", "precision", "recall", "f1", "auc_roc"}
	case "multiclass_classification":
		return []string{"accuracy", "f1_macro", "f1_weighted"}
	case "regression":
		return []string{"mse", "rmse", "mae", "r_squared", "smape"}
	default:
		return nil
	}
}

func sortClasses(classes []string) {
	sort.Slice(classes, func(i, j int) bool {
		ai := strings.ToLower(classes[i])
		aj := strings.ToLower(classes[j])
		if ai != aj {
			return ai < aj
		}
		return classes[i] < classes[j]
	})
}

func collectClasses(preds []NormPrediction, fromActualOnly bool) []string {
	set := make(map[string]bool)
	for _, p := range preds {
		if p.ActualStr != "" {
			set[p.ActualStr] = true
		}
		if !fromActualOnly && p.PredictedStr != "" {
			set[p.PredictedStr] = true
		}
	}
	classes := make([]string, 0, len(set))
	for c := range set {
		classes = append(classes, c)
	}
	sortClasses(classes)
	return classes
}

func readJSON(path string, v any) error {
	data, err := os.ReadFile(path)
	if err != nil {
		return fmt.Errorf("read %s: %w", path, err)
	}
	if err := json.Unmarshal(data, v); err != nil {
		return fmt.Errorf("parse %s: %w", path, err)
	}
	return nil
}

func loadManifest(path string) (NormManifest, error) {
	var raw Manifest
	if err := readJSON(path, &raw); err != nil {
		return NormManifest{}, err
	}
	if !validModelName.MatchString(raw.Model.Name) {
		return NormManifest{}, fmt.Errorf("%s: invalid model name %q", path, raw.Model.Name)
	}
	if !validVersion.MatchString(raw.Model.Version) {
		return NormManifest{}, fmt.Errorf("%s: invalid model version %q", path, raw.Model.Version)
	}
	switch raw.Model.TaskType {
	case "binary_classification", "multiclass_classification", "regression":
	default:
		return NormManifest{}, fmt.Errorf("%s: invalid task_type %q", path, raw.Model.TaskType)
	}
	if len(raw.Evaluations) == 0 {
		return NormManifest{}, fmt.Errorf("%s: at least one evaluation is required", path)
	}
	nm := NormManifest{Model: raw.Model}
	splits := make(map[string]bool)
	for _, ev := range raw.Evaluations {
		if ev.Split == "" {
			return NormManifest{}, fmt.Errorf("%s: split name is required", path)
		}
		if splits[ev.Split] {
			return NormManifest{}, fmt.Errorf("%s: duplicate split name %q", path, ev.Split)
		}
		splits[ev.Split] = true
		if ev.Dataset == "" {
			return NormManifest{}, fmt.Errorf("%s: dataset is required for split %q", path, ev.Split)
		}
		if len(ev.Predictions) == 0 {
			return NormManifest{}, fmt.Errorf("%s: split %q must have at least one prediction", path, ev.Split)
		}
		ne := NormEvaluation{Split: ev.Split, Dataset: ev.Dataset}
		ids := make(map[string]bool)
		for _, rp := range ev.Predictions {
			if rp.ID == "" {
				return NormManifest{}, fmt.Errorf("%s: prediction id is required in split %q", path, ev.Split)
			}
			if ids[rp.ID] {
				return NormManifest{}, fmt.Errorf("%s: duplicate prediction id %q in split %q", path, rp.ID, ev.Split)
			}
			ids[rp.ID] = true
			np, err := normalizePrediction(path, ev.Split, rp, raw.Model.TaskType)
			if err != nil {
				return NormManifest{}, err
			}
			ne.Predictions = append(ne.Predictions, np)
		}
		nm.Evaluations = append(nm.Evaluations, ne)
	}
	return nm, nil
}

func normalizePrediction(path, split string, rp RawPrediction, taskType string) (NormPrediction, error) {
	np := NormPrediction{ID: rp.ID}
	if taskType == "regression" {
		if len(rp.Actual) == 0 {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual is required", path, split, rp.ID)
		}
		if err := json.Unmarshal(rp.Actual, &np.ActualNum); err != nil {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual must be a number", path, split, rp.ID)
		}
		if err := json.Unmarshal(rp.Predicted, &np.PredictedNum); err != nil {
[?2004hroot@n30009:/app# sed -n '360,620p' main.go
[?2004l		if err := json.Unmarshal(rp.Predicted, &np.PredictedNum); err != nil {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: predicted must be a number", path, split, rp.ID)
		}
		if len(rp.Probabilities) > 0 && string(rp.Probabilities) != "null" {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities must be absent for regression", path, split, rp.ID)
		}
	} else {
		if len(rp.Actual) == 0 {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual is required", path, split, rp.ID)
		}
		if err := json.Unmarshal(rp.Actual, &np.ActualStr); err != nil {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual must be a string", path, split, rp.ID)
		}
		if err := json.Unmarshal(rp.Predicted, &np.PredictedStr); err != nil {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: predicted must be a string", path, split, rp.ID)
		}
		if len(rp.Probabilities) == 0 || string(rp.Probabilities) == "null" {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities are required for classification", path, split, rp.ID)
		}
		probs := make(map[string]float64)
		if err := json.Unmarshal(rp.Probabilities, &probs); err != nil {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: invalid probabilities", path, split, rp.ID)
		}
		if len(probs) == 0 {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities must not be empty", path, split, rp.ID)
		}
		sum := 0.0
		for k, v := range probs {
			if k == "" {
				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probability class label is empty", path, split, rp.ID)
			}
			if math.IsNaN(v) || math.IsInf(v, 0) || v < 0 || v > 1 {
				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probability for %q out of range", path, split, rp.ID, k)
			}
			sum += v
		}
		if math.Abs(sum-1) > 1e-6 {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities must sum to 1", path, split, rp.ID)
		}
		np.Probabilities = probs
		np.HasProbabilities = true
	}
	return np, nil
}

func loadRegressionConfig(path string) (RegressionConfig, error) {
	var cfg RegressionConfig
	if err := readJSON(path, &cfg); err != nil {
		return RegressionConfig{}, err
	}
	for metric, t := range cfg.Thresholds {
		switch t.Severity {
		case "critical", "warning", "info":
		default:
			return RegressionConfig{}, fmt.Errorf("%s: invalid severity %q for metric %q", path, t.Severity, metric)
		}
		if t.MaxDelta != nil && *t.MaxDelta < 0 {
			return RegressionConfig{}, fmt.Errorf("%s: max_delta must be non-negative for metric %q", path, metric)
		}
		if t.MaxRelativeDelta != nil && *t.MaxRelativeDelta < 0 {
			return RegressionConfig{}, fmt.Errorf("%s: max_relative_delta must be non-negative for metric %q", path, metric)
		}
		if t.MaxDelta == nil && t.MinAbsoluteDelta > 0 {
			return RegressionConfig{}, fmt.Errorf("%s: invalid min_absolute_delta %f for metric %q; expected non-positive value", path, t.MinAbsoluteDelta, metric)
		}
		if t.MaxRelativeDelta == nil && t.MinRelativeDelta > 0 {
			return RegressionConfig{}, fmt.Errorf("%s: invalid min_relative_delta %f for metric %q; expected non-positive value", path, t.MinRelativeDelta, metric)
		}
	}
	return cfg, nil
}

func metricDirection(metric string) string {
	switch metric {
	case "mse", "rmse", "mae", "log_loss", "smape":
		return "lower-is-better"
	default:
		return "higher-is-better"
	}
}

func thresholdMaxDelta(t Threshold) float64 {
	if t.MaxDelta != nil {
		return *t.MaxDelta
	}
	return -t.MinAbsoluteDelta
}

func thresholdMaxRelativeDelta(t Threshold) float64 {
	if t.MaxRelativeDelta != nil {
		return *t.MaxRelativeDelta
	}
	return -t.MinRelativeDelta
}

func computeMetrics(taskType string, preds []NormPrediction) EvalResult {
	switch taskType {
	case "binary_classification":
		return computeBinary(preds)
	case "multiclass_classification":
		return computeMulticlass(preds)
	case "regression":
		return computeRegression(preds)
	default:
		return EvalResult{Metrics: map[string]float64{}, MetricOrder: metricOrderForTask(taskType)}
	}
}

func computeBinary(preds []NormPrediction) EvalResult {
	classes := collectClasses(preds, true)
	if len(classes) != 2 {
		return EvalResult{Metrics: zeroMetrics(metricOrderForTask("binary_classification")), MetricOrder: metricOrderForTask("binary_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}
	}
	pos := classes[1]
	tp, fp, fn, tn := 0, 0, 0, 0
	for _, p := range preds {
		ap := p.ActualStr == pos
		pp := p.PredictedStr == pos
		switch {
		case ap && pp:
			tp++
		case !ap && pp:
			fp++
		case ap && !pp:
			fn++
		default:
			tn++
		}
	}
	total := len(preds)
	accuracy := safeDivInt(tp+tn, total)
	precision := safeDivInt(tp, tp+fp)
	recall := safeDivInt(tp, tp+fn)
	f1 := safeDiv(2*precision*recall, precision+recall)
	auc := aucROC(preds, pos)
	ll := logLoss(preds, pos)
	metrics := map[string]float64{
		"accuracy":  accuracy,
		"precision": precision,
		"recall":    recall,
		"f1":        f1,
		"auc_roc":   auc,
		"log_loss":  ll,
	}
	return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask("binary_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}
}

func aucROC(preds []NormPrediction, pos string) float64 {
	totalPos := 0
	totalNeg := 0
	type sample struct {
		p float64
		y int
	}
	samples := make([]sample, 0, len(preds))
	for _, pr := range preds {
		y := 0
		if pr.ActualStr == pos {
			y = 1
			totalPos++
		} else {
			totalNeg++
		}
		p := 0.0
		if v, ok := pr.Probabilities[pos]; ok {
			p = v
		}
		samples = append(samples, sample{p: p, y: y})
	}
	if totalPos == 0 || totalNeg == 0 {
		return 0
	}
	sort.SliceStable(samples, func(i, j int) bool {
		if samples[i].p != samples[j].p {
			return samples[i].p > samples[j].p
		}
		return samples[i].y > samples[j].y
	})
	points := []struct{ fpr, tpr float64 }{{0, 0}}
	cumTP := 0
	cumFP := 0
	for _, s := range samples {
		if s.y == 1 {
			cumTP++
		} else {
			cumFP++
		}
		tpr := float64(cumTP) / float64(totalPos)
		fpr := float64(cumFP) / float64(totalNeg)
		points = append(points, struct{ fpr, tpr float64 }{fpr, tpr})
	}
	auc := 0.0
	for i := 1; i < len(points); i++ {
		auc += (points[i].fpr - points[i-1].fpr) * (points[i].tpr + points[i-1].tpr) / 2
	}
	return auc
}

func logLoss(preds []NormPrediction, pos string) float64 {
	if len(preds) == 0 {
		return 0
	}
	sum := 0.0
	for _, pr := range preds {
		y := 0.0
		if pr.ActualStr == pos {
			y = 1.0
		}
		p := 0.0
		if v, ok := pr.Probabilities[pos]; ok {
			p = v
		}
		p = math.Min(1-1e-15, math.Max(1e-15, p))
		sum += y*math.Log(p) + (1-y)*math.Log(1-p)
	}
	return -sum / float64(len(preds))
}

func makeConfusionMatrix(preds []NormPrediction, classes []string) *ConfusionMatrixReport {
	if len(classes) == 0 {
		return nil
	}
	idx := make(map[string]int)
	for i, c := range classes {
		idx[c] = i
	}
	matrix := make([][]int, len(classes))
	for i := range matrix {
		matrix[i] = make([]int, len(classes))
	}
	for _, p := range preds {
		ai, ok := idx[p.ActualStr]
		if !ok {
			continue
		}
		pi, ok2 := idx[p.PredictedStr]
		if !ok2 {
			continue
		}
		matrix[ai][pi]++
	}
	return &ConfusionMatrixReport{Classes: classes, Matrix: matrix}
}

func computeMulticlass(preds []NormPrediction) EvalResult {
	classes := collectClasses(preds, true)
	if len(classes) < 3 {
		return EvalResult{Metrics: zeroMetrics(metricOrderForTask("multiclass_classification")), MetricOrder: metricOrderForTask("multiclass_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}
	}
