   762					sr.PerClassMetrics[class] = PerClassMetric{
   763						Precision: round6(pm.Precision),
   764						Recall:    round6(pm.Recall),
   765						F1:        round6(pm.F1),
   766						Support:   pm.Support,
   767					}
   768				}
   769			}
   770			if bootstrap > 0 {
   771				sr.ConfidenceIntervals = computeBootstrapCIs(nm.Model.TaskType, ev.Predictions, bootstrap, confidence, rng)
   772			}
   773			report.Splits[ev.Split] = sr
   774		}
   775		return report
   776	}
