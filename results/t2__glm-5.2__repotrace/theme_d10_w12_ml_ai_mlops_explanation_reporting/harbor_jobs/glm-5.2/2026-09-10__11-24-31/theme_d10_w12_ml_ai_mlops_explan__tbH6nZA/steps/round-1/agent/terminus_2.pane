  1205	func runCompare(args []string) int {
  1206		fs := flag.NewFlagSet("compare", flag.ContinueOnError)
  1207		baselinePath := fs.String("baseline", "", "path to baseline manifest")
  1208		candidatePath := fs.String("candidate", "", "path to candidate manifest")
  1209		configPath := fs.String("config", "", "path to regression config")
  1210		outputDir := fs.String("output-dir", "", "directory for output files")
  1211		format := fs.String("format", "both", "output format: md, json, or both")
  1212		excludeMetric := fs.String("exclude-metric", "", "comma-separated list of metric names to exclude from regression analysis")
  1213		if err := fs.Parse(args); err != nil {
  1214			fmt.Fprintln(os.Stderr, err)
  1215			return 2
  1216		}
  1217		if *baselinePath == "" || *candidatePath == "" || *configPath == "" || *outputDir == "" {
  1218			fmt.Fprintln(os.Stderr, "--baseline, --candidate, --config, and --output-dir are required")
  1219			return 2
  1220		}
  1221		switch *format {
  1222		case "md", "json", "both":
  1223		default:
  1224			fmt.Fprintf(os.Stderr, "invalid --format %q; must be md, json, or both\n", *format)
  1225			return 2
  1226		}
  1227		excludedMetrics := make(map[string]bool)
  1228		if *excludeMetric != "" {
  1229			for _, name := range strings.Split(*excludeMetric, ",") {
  1230				name = strings.TrimSpace(name)
  1231				if name == "" {
  1232					continue
  1233				}
  1234				excludedMetrics[name] = true
  1235			}
  1236		}
  1237		baseline, err := loadManifest(*baselinePath)
  1238		if err != nil {
  1239			fmt.Fprintln(os.Stderr, err)
  1240			return 2
  1241		}
  1242		candidate, err := loadManifest(*candidatePath)
  1243		if err != nil {
  1244			fmt.Fprintln(os.Stderr, err)
  1245			return 2
  1246		}
  1247		cfg, err := loadRegressionConfig(*configPath)
  1248		if err != nil {
  1249			fmt.Fprintln(os.Stderr, err)
  1250			return 2
  1251		}
  1252		cd, err := buildComparisonData(baseline, candidate, cfg, excludedMetrics)
  1253		if err != nil {
  1254			fmt.Fprintln(os.Stderr, err)
  1255			return 2
  1256		}
  1257		if err := os.MkdirAll(*outputDir, 0755); err != nil {
  1258			fmt.Fprintln(os.Stderr, err)
  1259			return 2
  1260		}
  1261		if *format == "md" || *format == "both" {
  1262			md := buildComparisonMarkdown(cd)
  1263			if err := writeFile(filepath.Join(*outputDir, "comparison.md"), []byte(md)); err != nil {
  1264				fmt.Fprintln(os.Stderr, err)
  1265				return 2
  1266			}
  1267		}
  1268		if *format == "json" || *format == "both" {
  1269			data, err := json.MarshalIndent(cd, "", "  ")
  1270			if err != nil {
  1271				fmt.Fprintln(os.Stderr, err)
  1272				return 2
  1273			}
  1274			if err := writeFile(filepath.Join(*outputDir, "comparison.json"), append(data, '\n')); err != nil {
  1275				fmt.Fprintln(os.Stderr, err)
  1276				return 2
  1277			}
  1278		}
  1279		if cd.Overall.Verdict == "FAIL" {
  1280			return 1
  1281		}
  1282		return 0
  1283	}
  1284	
  1285	func primaryMetricsForTask(taskType string) []string {
  1286		switch taskType {
  1287		case "binary_classification":
  1288			return []string{"accuracy", "f1", "auc_roc"}
  1289		case "multiclass_classification":
  1290			return []string{"accuracy", "f1_macro"}
  1291		case "regression":
  1292			return []string{"rmse", "mae", "r_squared"}
  1293		default:
  1294			return nil
  1295		}
  1296	}
