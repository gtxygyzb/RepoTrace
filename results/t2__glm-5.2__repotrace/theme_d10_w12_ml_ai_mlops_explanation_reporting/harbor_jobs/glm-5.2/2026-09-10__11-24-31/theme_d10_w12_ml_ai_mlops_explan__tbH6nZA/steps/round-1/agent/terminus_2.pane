   226	func metricOrderForTask(taskType string) []string {
   227		switch taskType {
   228		case "binary_classification":
   229			return []string{"accuracy", "precision", "recall", "f1", "auc_roc", "log_loss"}
   230		case "multiclass_classification":
   231			return []string{"accuracy", "precision_micro", "recall_micro", "f1_micro", "precision_macro", "recall_macro", "f1_macro", "precision_weighted", "recall_weighted", "f1_weighted"}
   232		case "regression":
   233			return []string{"mse", "rmse", "mae", "r_squared", "smape"}
   234		default:
   235			return nil
   236		}
   237	}
   238	
   239	func ciMetricsForTask(taskType string) []string {
   240		switch taskType {
   241		case "binary_classification":
   242			return []string{"accuracy", "precision", "recall", "f1", "auc_roc"}
   243		case "multiclass_classification":
   244			return []string{"accuracy", "f1_macro", "f1_weighted"}
   245		case "regression":
   246			return []string{"mse", "rmse", "mae", "r_squared"}
   247		default:
   248			return nil
   249		}
   250	}
   251	
   252	func sortClasses(classes []string) {
   253		sort.Slice(classes, func(i, j int) bool {
   254			ai := strings.ToLower(classes[i])
   255			aj := strings.ToLower(classes[j])
   256			if ai != aj {
   257				return ai < aj
   258			}
   259			return classes[i] < classes[j]
   260		})
   261	}
   262	
   263	func collectClasses(preds []NormPrediction, fromActualOnly bool) []string {
   264		set := make(map[string]bool)
   265		for _, p := range preds {
   266			if p.ActualStr != "" {
   267				set[p.ActualStr] = true
   268			}
   269			if !fromActualOnly && p.PredictedStr != "" {
   270				set[p.PredictedStr] = true
   271			}
   272		}
   273		classes := make([]string, 0, len(set))
   274		for c := range set {
   275			classes = append(classes, c)
   276		}
   277		sortClasses(classes)
   278		return classes
   279	}
