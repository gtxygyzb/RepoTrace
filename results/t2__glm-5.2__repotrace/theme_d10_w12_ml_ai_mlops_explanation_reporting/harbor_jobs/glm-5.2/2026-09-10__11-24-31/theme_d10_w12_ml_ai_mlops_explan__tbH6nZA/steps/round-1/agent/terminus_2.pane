   543				cumTP++
   544			} else {
   545				cumFP++
   546			}
   547			tpr := float64(cumTP) / float64(totalPos)
   548			fpr := float64(cumFP) / float64(totalNeg)
   549			points = append(points, struct{ fpr, tpr float64 }{fpr, tpr})
   550		}
   551		auc := 0.0
   552		for i := 1; i < len(points); i++ {
   553			auc += (points[i].fpr - points[i-1].fpr) * (points[i].tpr + points[i-1].tpr) / 2
   554		}
   555		return auc
   556	}
