   405	func loadRegressionConfig(path string) (RegressionConfig, error) {
   406		var cfg RegressionConfig
   407		if err := readJSON(path, &cfg); err != nil {
   408			return RegressionConfig{}, err
   409		}
   410		for metric, t := range cfg.Thresholds {
   411			switch t.Severity {
   412			case "critical", "warning", "info":
   413			default:
   414				return RegressionConfig{}, fmt.Errorf("%s: invalid severity %q for metric %q", path, t.Severity, metric)
   415			}
   416			if t.MaxDelta != nil && *t.MaxDelta < 0 {
   417				return RegressionConfig{}, fmt.Errorf("%s: max_delta must be non-negative for metric %q", path, metric)
   418			}
   419			if t.MaxRelativeDelta != nil && *t.MaxRelativeDelta < 0 {
   420				return RegressionConfig{}, fmt.Errorf("%s: max_relative_delta must be non-negative for metric %q", path, metric)
   421			}
   422			if t.MaxDelta == nil && t.MinAbsoluteDelta > 0 {
   423				return RegressionConfig{}, fmt.Errorf("%s: invalid min_absolute_delta %q for metric %q; expected non-positive value", path, t.MinAbsoluteDelta, metric)
   424			}
   425			if t.MaxRelativeDelta == nil && t.MinRelativeDelta > 0 {
   426				return RegressionConfig{}, fmt.Errorf("%s: invalid min_relative_delta %q for metric %q; expected non-positive value", path, t.MinRelativeDelta, metric)
   427			}
   428		}
   429		return cfg, nil
   430	}
   431	
   432	func metricDirection(metric string) string {
   433		switch metric {
   434		case "mse", "rmse", "mae", "log_loss", "smape":
   435			return "lower-is-better"
   436		default:
   437			return "higher-is-better"
   438		}
   439	}
   440	
   441	func thresholdMaxDelta(t Threshold) float64 {
   442		if t.MaxDelta != nil {
   443			return *t.MaxDelta
   444		}
   445		return -t.MinAbsoluteDelta
   446	}
   447	
   448	func thresholdMaxRelativeDelta(t Threshold) float64 {
   449		if t.MaxRelativeDelta != nil {
   450			return *t.MaxRelativeDelta
   451		}
   452		return -t.MinRelativeDelta
   453	}
