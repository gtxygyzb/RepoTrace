		return NormManifest{}, fmt.Errorf("%s: invalid model name %q", path, raw.Model.Name)
	}
	if !validVersion.MatchString(raw.Model.Version) {
		return NormManifest{}, fmt.Errorf("%s: invalid model version %q", path, raw.Model.Version)
	}
	switch raw.Model.TaskType {
	case "binary_classification", "multiclass_classification", "regression":
	default:
		return NormManifest{}, fmt.Errorf("%s: invalid task_type %q", path, raw.Model.TaskType)
	}
	if len(raw.Evaluations) == 0 {
		return NormManifest{}, fmt.Errorf("%s: at least one evaluation is required", path)
	}
	nm := NormManifest{Model: raw.Model}
	splits := make(map[string]bool)
	for _, ev := range raw.Evaluations {
		if ev.Split == "" {
			return NormManifest{}, fmt.Errorf("%s: split name is required", path)
		}
		if splits[ev.Split] {
			return NormManifest{}, fmt.Errorf("%s: duplicate split name %q", path, ev.Split)
		}
		splits[ev.Split] = true
		if ev.Dataset == "" {
			return NormManifest{}, fmt.Errorf("%s: dataset is required for split %q", path, ev.Split)
		}
		if len(ev.Predictions) == 0 {
			return NormManifest{}, fmt.Errorf("%s: split %q must have at least one prediction", path, ev.Split)
		}
		ne := NormEvaluation{Split: ev.Split, Dataset: ev.Dataset}
		ids := make(map[string]bool)
		for _, rp := range ev.Predictions {
			if rp.ID == "" {
				return NormManifest{}, fmt.Errorf("%s: prediction id is required in split %q", path, ev.Split)
			}
			if ids[rp.ID] {
				return NormManifest{}, fmt.Errorf("%s: duplicate prediction id %q in split %q", path, rp.ID, ev.Split)
			}
			ids[rp.ID] = true
			np, err := normalizePrediction(path, ev.Split, rp, raw.Model.TaskType)
			if err != nil {
				return NormManifest{}, err
			}
			ne.Predictions = append(ne.Predictions, np)
		}
		nm.Evaluations = append(nm.Evaluations, ne)
	}
	return nm, nil
}

func normalizePrediction(path, split string, rp RawPrediction, taskType string) (NormPrediction, error) {
	np := NormPrediction{ID: rp.ID}
	if taskType == "regression" {
		if len(rp.Actual) == 0 {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual is required", path, split, rp.ID)
		}
		if err := json.Unmarshal(rp.Actual, &np.ActualNum); err != nil {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual must be a number", path, split, rp.ID)
		}
		if err := json.Unmarshal(rp.Predicted, &np.PredictedNum); err != nil {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: predicted must be a number", path, split, rp.ID)
		}
		if len(rp.Probabilities) > 0 && string(rp.Probabilities) != "null" {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities must be absent for regression", path, split, rp.ID)
		}
	} else {
		if len(rp.Actual) == 0 {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual is required", path, split, rp.ID)
		}
		if err := json.Unmarshal(rp.Actual, &np.ActualStr); err != nil {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual must be a string", path, split, rp.ID)
		}
		if err := json.Unmarshal(rp.Predicted, &np.PredictedStr); err != nil {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: predicted must be a string", path, split, rp.ID)
		}
		if len(rp.Probabilities) == 0 || string(rp.Probabilities) == "null" {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities are required for classification", path, split, rp.ID)
		}
		probs := make(map[string]float64)
		if err := json.Unmarshal(rp.Probabilities, &probs); err != nil {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: invalid probabilities", path, split, rp.ID)
		}
		if len(probs) == 0 {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities must not be empty", path, split, rp.ID)
		}
		sum := 0.0
		for k, v := range probs {
			if k == "" {
				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probability class label is empty", path, split, rp.ID)
			}
			if math.IsNaN(v) || math.IsInf(v, 0) || v < 0 || v > 1 {
				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probability for %q out of range", path, split, rp.ID, k)
			}
			sum += v
		}
		if math.Abs(sum-1) > 1e-6 {
			return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities must sum to 1", path, split, rp.ID)
		}
		np.Probabilities = probs
		np.HasProbabilities = true
	}
	return np, nil
}

func loadRegressionConfig(path string) (RegressionConfig, error) {
	var cfg RegressionConfig
	if err := readJSON(path, &cfg); err != nil {
		return RegressionConfig{}, err
	}
	for metric, t := range cfg.Thresholds {
		switch t.Severity {
		case "critical", "warning", "info":
		default:
			return RegressionConfig{}, fmt.Errorf("%s: invalid severity %q for metric %q", path, t.Severity, metric)
		}
		if t.MaxDelta != nil && *t.MaxDelta < 0 {
			return RegressionConfig{}, fmt.Errorf("%s: max_delta must be non-negative for metric %q", path, metric)
		}
		if t.MaxRelativeDelta != nil && *t.MaxRelativeDelta < 0 {
			return RegressionConfig{}, fmt.Errorf("%s: max_relative_delta must be non-negative for metric %q", path, metric)
		}
		if t.MaxDelta == nil && t.MinAbsoluteDelta > 0 {
			return RegressionConfig{}, fmt.Errorf("%s: invalid min_absolute_delta %f for metric %q; expected non-positive value", path, t.MinAbsoluteDelta, metric)
		}
		if t.MaxRelativeDelta == nil && t.MinRelativeDelta > 0 {
			return RegressionConfig{}, fmt.Errorf("%s: invalid min_relative_delta %f for metric %q; expected non-positive value", path, t.MinRelativeDelta, metric)
		}
	}
	return cfg, nil
}

func metricDirection(metric string) string {
	switch metric {
	case "mse", "rmse", "mae", "log_loss", "smape":
		return "lower-is-better"
	default:
		return "higher-is-better"
	}
}

func thresholdMaxDelta(t Threshold) float64 {
	if t.MaxDelta != nil {
		return *t.MaxDelta
	}
	return -t.MinAbsoluteDelta
}

func thresholdMaxRelativeDelta(t Threshold) float64 {
	if t.MaxRelativeDelta != nil {
		return *t.MaxRelativeDelta
	}
	return -t.MinRelativeDelta
}

func computeMetrics(taskType string, preds []NormPrediction) EvalResult {
	switch taskType {
	case "binary_classification":
		return computeBinary(preds)
	case "multiclass_classification":
		return computeMulticlass(preds)
	case "regression":
		return computeRegression(preds)
	default:
		return EvalResult{Metrics: map[string]float64{}, MetricOrder: metricOrderForTask(taskType)}
	}
}

func computeBinary(preds []NormPrediction) EvalResult {
	classes := collectClasses(preds, true)
	if len(classes) != 2 {
		return EvalResult{Metrics: zeroMetrics(metricOrderForTask("binary_classification")), MetricOrder: metricOrderForTask("binary_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}
	}
	pos := classes[1]
	tp, fp, fn, tn := 0, 0, 0, 0
	for _, p := range preds {
		ap := p.ActualStr == pos
		pp := p.PredictedStr == pos
		switch {
		case ap && pp:
			tp++
		case !ap && pp:
			fp++
		case ap && !pp:
			fn++
		default:
			tn++
		}
	}
	total := len(preds)
	accuracy := safeDivInt(tp+tn, total)
	precision := safeDivInt(tp, tp+fp)
	recall := safeDivInt(tp, tp+fn)
	f1 := safeDiv(2*precision*recall, precision+recall)
	auc := aucROC(preds, pos)
	ll := logLoss(preds, pos)
	metrics := map[string]float64{
		"accuracy":  accuracy,
		"precision": precision,
		"recall":    recall,
		"f1":        f1,
		"auc_roc":   auc,
		"log_loss":  ll,
	}
	return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask("binary_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}
}

func aucROC(preds []NormPrediction, pos string) float64 {
	totalPos := 0
	totalNeg := 0
	type sample struct {
		p float64
		y int
	}
	samples := make([]sample, 0, len(preds))
	for _, pr := range preds {
		y := 0
		if pr.ActualStr == pos {
			y = 1
			totalPos++
		} else {
			totalNeg++
		}
		p := 0.0
		if v, ok := pr.Probabilities[pos]; ok {
			p = v
		}
		samples = append(samples, sample{p: p, y: y})
	}
	if totalPos == 0 || totalNeg == 0 {
		return 0
	}
	sort.SliceStable(samples, func(i, j int) bool {
		if samples[i].p != samples[j].p {
			return samples[i].p > samples[j].p
		}
		return samples[i].y > samples[j].y
	})
	points := []struct{ fpr, tpr float64 }{{0, 0}}
	cumTP := 0
	cumFP := 0
	for _, s := range samples {
		if s.y == 1 {
			cumTP++
		} else {
			cumFP++
		}
		tpr := float64(cumTP) / float64(totalPos)
		fpr := float64(cumFP) / float64(totalNeg)
		points = append(points, struct{ fpr, tpr float64 }{fpr, tpr})
	}
	auc := 0.0
	for i := 1; i < len(points); i++ {
		auc += (points[i].fpr - points[i-1].fpr) * (points[i].tpr + points[i-1].tpr) / 2
	}
	return auc
}

func logLoss(preds []NormPrediction, pos string) float64 {
	if len(preds) == 0 {
		return 0
	}
	sum := 0.0
	for _, pr := range preds {
		y := 0.0
		if pr.ActualStr == pos {
			y = 1.0
		}
		p := 0.0
		if v, ok := pr.Probabilities[pos]; ok {
			p = v
		}
		p = math.Min(1-1e-15, math.Max(1e-15, p))
		sum += y*math.Log(p) + (1-y)*math.Log(1-p)
	}
	return -sum / float64(len(preds))
}

func makeConfusionMatrix(preds []NormPrediction, classes []string) *ConfusionMatrixReport {
	if len(classes) == 0 {
		return nil
	}
	idx := make(map[string]int)
	for i, c := range classes {
		idx[c] = i
	}
	matrix := make([][]int, len(classes))
	for i := range matrix {
		matrix[i] = make([]int, len(classes))
	}
	for _, p := range preds {
		ai, ok := idx[p.ActualStr]
		if !ok {
			continue
		}
		pi, ok2 := idx[p.PredictedStr]
		if !ok2 {
			continue
		}
		matrix[ai][pi]++
	}
	return &ConfusionMatrixReport{Classes: classes, Matrix: matrix}
}

func computeMulticlass(preds []NormPrediction) EvalResult {
	classes := collectClasses(preds, true)
	if len(classes) < 3 {
		return EvalResult{Metrics: zeroMetrics(metricOrderForTask("multiclass_classification")), MetricOrder: metricOrderForTask("multiclass_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}
	}
	total := len(preds)
	correct := 0
	type counts struct{ tp, fp, fn, tn, support int }
	perClass := make(map[string]counts)
	for _, c := range classes {
		perClass[c] = counts{}
	}
	for _, p := range preds {
		if p.ActualStr == p.PredictedStr {
			correct++
		}
		pc := perClass[p.ActualStr]
		pc.support++
		perClass[p.ActualStr] = pc
		for _, c := range classes {
			tp, fp, fn, tn := 0, 0, 0, 0
			actualC := p.ActualStr == c
			predC := p.PredictedStr == c
			if actualC && predC {
				tp = 1
			} else if !actualC && predC {
				fp = 1
			} else if actualC && !predC {
				fn = 1
			} else {
				tn = 1
			}
			pc := perClass[c]
			pc.tp += tp
			pc.fp += fp
			pc.fn += fn
			pc.tn += tn
			perClass[c] = pc
		}
	}
	sumTP, sumFP, sumFN := 0, 0, 0
	precisions := make([]float64, len(classes))
	recalls := make([]float64, len(classes))
	f1s := make([]float64, len(classes))
	supports := make([]int, len(classes))
	perClassMetrics := make(map[string]PerClassMetric)
	for i, c := range classes {
		pc := perClass[c]
		sumTP += pc.tp
		sumFP += pc.fp
		sumFN += pc.fn
		supports[i] = pc.support
		precisions[i] = safeDivInt(pc.tp, pc.tp+pc.fp)
		recalls[i] = safeDivInt(pc.tp, pc.tp+pc.fn)
		f1s[i] = safeDiv(2*precisions[i]*recalls[i], precisions[i]+recalls[i])
		perClassMetrics[c] = PerClassMetric{Precision: precisions[i], Recall: recalls[i], F1: f1s[i], Support: pc.support}
	}
	accuracy := safeDivInt(correct, total)
	precisionMicro := safeDivInt(sumTP, sumTP+sumFP)
	recallMicro := safeDivInt(sumTP, sumTP+sumFN)
	f1Micro := safeDiv(2*precisionMicro*recallMicro, precisionMicro+recallMicro)
	precisionMacro := mean(precisions)
	recallMacro := mean(recalls)
	f1Macro := mean(f1s)
	precisionWeighted := weighted(precisions, supports)
	recallWeighted := weighted(recalls, supports)
	f1Weighted := weighted(f1s, supports)
	metrics := map[string]float64{
		"accuracy":           accuracy,
		"precision_micro":    precisionMicro,
		"recall_micro":       recallMicro,
		"f1_micro":           f1Micro,
		"precision_macro":    precisionMacro,
		"recall_macro":       recallMacro,
		"f1_macro":           f1Macro,
		"precision_weighted": precisionWeighted,
		"recall_weighted":    recallWeighted,
		"f1_weighted":        f1Weighted,
	}
	return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask("multiclass_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes), PerClassMetrics: perClassMetrics}
}

func computeRegression(preds []NormPrediction) EvalResult {
	n := len(preds)
	actuals := make([]float64, n)
	predicted := make([]float64, n)
	for i, p := range preds {
		actuals[i] = p.ActualNum
		predicted[i] = p.PredictedNum
	}
	se := 0.0
	ae := 0.0
	smapeSum := 0.0
	smapeCount := 0
	for i := 0; i < n; i++ {
		diff := actuals[i] - predicted[i]
		se += diff * diff
		ae += math.Abs(diff)
		denom := math.Abs(actuals[i]) + math.Abs(predicted[i])
		if denom >= 1e-10 {
			smapeSum += 2 * math.Abs(diff) / denom
			smapeCount++
		}
	}
	mse := se / float64(n)
	rmse := math.Sqrt(mse)
	mae := ae / float64(n)
	meanActual := mean(actuals)
	ssRes := 0.0
	ssTot := 0.0
	for _, a := range actuals {
		ssTot += (a - meanActual) * (a - meanActual)
	}
	for i := range actuals {
		diff := actuals[i] - predicted[i]
		ssRes += diff * diff
	}
[?2004hroot@n30009:/app# sed -n '720,1120p' main.go
[?2004l	}
	rSquared := 0.0
	if ssTot != 0 {
		rSquared = 1 - ssRes/ssTot
	}
	smape := 0.0
	if smapeCount > 0 {
		smape = smapeSum / float64(smapeCount) * 100
	}
	metrics := map[string]float64{
		"mse":       mse,
		"rmse":      rmse,
		"mae":       mae,
		"r_squared": rSquared,
		"smape":     smape,
	}
	return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask("regression")}
}

func zeroMetrics(order []string) map[string]float64 {
	m := make(map[string]float64)
	for _, name := range order {
		m[name] = 0
	}
	return m
}

func computeBootstrapCIs(taskType string, preds []NormPrediction, B int, confidence float64, rng *rand.Rand) map[string]CI {
	if B <= 0 {
		return nil
	}
	ciMetrics := ciMetricsForTask(taskType)
	if len(ciMetrics) == 0 {
		return nil
	}
	n := len(preds)
	values := make(map[string][]float64)
	for _, m := range ciMetrics {
		values[m] = make([]float64, 0, B)
	}
	for b := 0; b < B; b++ {
		resample := make([]NormPrediction, n)
		for i := 0; i < n; i++ {
			resample[i] = preds[rng.Intn(n)]
		}
		res := computeMetrics(taskType, resample)
		for _, m := range ciMetrics {
			values[m] = append(values[m], res.Metrics[m])
		}
	}
	cis := make(map[string]CI)
	for _, m := range ciMetrics {
		vals := values[m]
		sort.Float64s(vals)
		lowerIndex := clampIndex(int(math.Floor((1-confidence)/2*float64(B))), B)
		upperIndex := clampIndex(int(math.Floor((1+confidence)/2*float64(B)))-1, B)
		cis[m] = CI{Lower: round6(vals[lowerIndex]), Upper: round6(vals[upperIndex])}
	}
	return cis
}

func buildReportJSON(nm NormManifest, splits []string, bootstrap int, confidence float64, seed int64) ReportJSON {
	report := ReportJSON{Model: nm.Model, Splits: make(map[string]SplitReportJSON)}
	var rng *rand.Rand
	if bootstrap > 0 {
		rng = rand.New(rand.NewSource(seed))
	}
	for _, ev := range nm.Evaluations {
		if len(splits) > 0 {
			found := false
			for _, split := range splits {
				if split == ev.Split {
					found = true
					break
				}
			}
			if !found {
				continue
			}
		}
		result := computeMetrics(nm.Model.TaskType, ev.Predictions)
		roundedMetrics := make(map[string]float64)
		for _, name := range result.MetricOrder {
			roundedMetrics[name] = round6(result.Metrics[name])
		}
		sr := SplitReportJSON{Dataset: ev.Dataset, Metrics: roundedMetrics}
		if nm.Model.TaskType != "regression" && result.ConfusionMatrix != nil {
			sr.ConfusionMatrix = result.ConfusionMatrix
		}
		if nm.Model.TaskType == "multiclass_classification" && len(result.PerClassMetrics) > 0 {
			sr.PerClassMetrics = make(map[string]PerClassMetric)
			for class, pm := range result.PerClassMetrics {
				sr.PerClassMetrics[class] = PerClassMetric{
					Precision: round6(pm.Precision),
					Recall:    round6(pm.Recall),
					F1:        round6(pm.F1),
					Support:   pm.Support,
				}
			}
		}
		if bootstrap > 0 {
			sr.ConfidenceIntervals = computeBootstrapCIs(nm.Model.TaskType, ev.Predictions, bootstrap, confidence, rng)
		}
		report.Splits[ev.Split] = sr
	}
	return report
}

func buildEvaluateMarkdown(report ReportJSON, nm NormManifest, splits []string, bootstrap int) string {
	var b strings.Builder
	fmt.Fprintf(&b, "# Evaluation Report: %s v%s\n\n", nm.Model.Name, nm.Model.Version)
	fmt.Fprintf(&b, "Task type: %s\n\n", nm.Model.TaskType)
	fmt.Fprintf(&b, "## Summary\n\n")
	visibleEvals := make([]NormEvaluation, 0, len(nm.Evaluations))
	for _, ev := range nm.Evaluations {
		if len(splits) > 0 {
			found := false
			for _, split := range splits {
				if split == ev.Split {
					found = true
					break
				}
			}
			if !found {
				continue
			}
		}
		visibleEvals = append(visibleEvals, ev)
	}
	headers := []string{"Metric"}
	for _, ev := range visibleEvals {
		headers = append(headers, ev.Split)
	}
	fmt.Fprintln(&b, "| "+strings.Join(headers, " | ")+" |")
	sep := []string{"--------"}
	for range visibleEvals {
		sep = append(sep, "-----------")
	}
	fmt.Fprintln(&b, "| "+strings.Join(sep, " | ")+" |")
	for _, metric := range metricOrderForTask(nm.Model.TaskType) {
		row := []string{metric}
		for _, ev := range visibleEvals {
			sr := report.Splits[ev.Split]
			val := formatFloat6(sr.Metrics[metric])
			if bootstrap > 0 {
				if ci, ok := sr.ConfidenceIntervals[metric]; ok {
					val = fmt.Sprintf("%s [%s, %s]", val, formatFloat6(ci.Lower), formatFloat6(ci.Upper))
				}
			}
			row = append(row, val)
		}
		fmt.Fprintln(&b, "| "+strings.Join(row, " | ")+" |")
	}
	fmt.Fprintln(&b)
	for _, ev := range visibleEvals {
		sr := report.Splits[ev.Split]
		fmt.Fprintf(&b, "## Split: %s\n\n", ev.Split)
		fmt.Fprintf(&b, "### Dataset\n%s\n\n", ev.Dataset)
		fmt.Fprintf(&b, "### Metrics\n\n")
		fmt.Fprintln(&b, "| Metric | Value |")
		fmt.Fprintln(&b, "|--------|-------|")
		for _, metric := range metricOrderForTask(nm.Model.TaskType) {
			fmt.Fprintf(&b, "| %s | %s |\n", metric, formatFloat6(sr.Metrics[metric]))
		}
		fmt.Fprintln(&b)
		if nm.Model.TaskType != "regression" && sr.ConfusionMatrix != nil {
			fmt.Fprintf(&b, "### Confusion Matrix\n\n")
			classes := sr.ConfusionMatrix.Classes
			header := []string{""}
			for _, c := range classes {
				header = append(header, "Predicted: "+c)
			}
			fmt.Fprintln(&b, "| "+strings.Join(header, " | ")+" |")
			sep := []string{"--"}
			for range classes {
				sep = append(sep, "---------------------")
			}
			fmt.Fprintln(&b, "| "+strings.Join(sep, " | ")+" |")
			for i, c := range classes {
				row := []string{"Actual: " + c}
				for _, count := range sr.ConfusionMatrix.Matrix[i] {
					row = append(row, strconv.Itoa(count))
				}
				fmt.Fprintln(&b, "| "+strings.Join(row, " | ")+" |")
			}
			fmt.Fprintln(&b)
		}
		if nm.Model.TaskType == "multiclass_classification" && len(sr.PerClassMetrics) > 0 {
			fmt.Fprintf(&b, "### Per-Class Metrics\n\n")
			fmt.Fprintln(&b, "| Class | Precision | Recall | F1 | Support |")
			fmt.Fprintln(&b, "|-------|-----------|--------|----|---------|")
			classes := make([]string, 0, len(sr.PerClassMetrics))
			for c := range sr.PerClassMetrics {
				classes = append(classes, c)
			}
			sortClasses(classes)
			for _, c := range classes {
				pm := sr.PerClassMetrics[c]
				fmt.Fprintf(&b, "| %s | %s | %s | %s | %d |\n", c, formatFloat6(pm.Precision), formatFloat6(pm.Recall), formatFloat6(pm.F1), pm.Support)
			}
			fmt.Fprintln(&b)
		}
		if bootstrap > 0 && len(sr.ConfidenceIntervals) > 0 {
			fmt.Fprintf(&b, "### Confidence Intervals\n\n")
			fmt.Fprintln(&b, "| Metric | Lower | Upper |")
			fmt.Fprintln(&b, "|--------|-------|-------|")
			for _, metric := range ciMetricsForTask(nm.Model.TaskType) {
				if ci, ok := sr.ConfidenceIntervals[metric]; ok {
					fmt.Fprintf(&b, "| %s | %s | %s |\n", metric, formatFloat6(ci.Lower), formatFloat6(ci.Upper))
				}
			}
			fmt.Fprintln(&b)
		}
	}
	return b.String()
}

func writeFile(path string, data []byte) error {
	return os.WriteFile(path, data, 0644)
}

func runEvaluate(args []string) int {
	fs := flag.NewFlagSet("evaluate", flag.ContinueOnError)
	manifest := fs.String("manifest", "", "path to evaluation manifest JSON file")
	outputDir := fs.String("output-dir", "", "directory for output files")
	format := fs.String("format", "both", "output format: md, json, or both")
	bootstrap := fs.Int("bootstrap", 0, "number of bootstrap iterations")
	confidence := fs.Float64("confidence", 0.95, "confidence level")
	seed := fs.Int64("seed", 42, "random seed")
	split := fs.String("split", "", "comma-separated list of split names to include")
	if err := fs.Parse(args); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 2
	}
	if *manifest == "" {
		fmt.Fprintln(os.Stderr, "--manifest is required")
		return 2
	}
	if *outputDir == "" {
		fmt.Fprintln(os.Stderr, "--output-dir is required")
		return 2
	}
	switch *format {
	case "md", "json", "both":
	default:
		fmt.Fprintf(os.Stderr, "invalid --format %q; must be md, json, or both\n", *format)
		return 2
	}
	if *bootstrap < 0 {
		fmt.Fprintln(os.Stderr, "--bootstrap must be non-negative")
		return 2
	}
	if *confidence <= 0 || *confidence >= 1 {
		fmt.Fprintln(os.Stderr, "--confidence must be in (0, 1)")
		return 2
	}
	nm, err := loadManifest(*manifest)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 2
	}
	var splits []string
	if *split != "" {
		for _, name := range strings.Split(*split, ",") {
			name = strings.TrimSpace(name)
			if name == "" {
				fmt.Fprintln(os.Stderr, "--split contains empty split names")
				return 2
			}
			splits = append(splits, name)
		}
		splitSet := make(map[string]bool)
		for _, name := range splits {
			splitSet[name] = true
		}
		for _, name := range splits {
			found := false
			for _, ev := range nm.Evaluations {
				if ev.Split == name {
					found = true
					break
				}
			}
			if !found {
				fmt.Fprintf(os.Stderr, "split %q not found in manifest\n", name)
				return 2
			}
		}
	}
	report := buildReportJSON(nm, splits, *bootstrap, *confidence, *seed)
	if err := os.MkdirAll(*outputDir, 0755); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 2
	}
	if *format == "md" || *format == "both" {
		md := buildEvaluateMarkdown(report, nm, splits, *bootstrap)
		if err := writeFile(filepath.Join(*outputDir, "report.md"), []byte(md)); err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 2
		}
	}
	if *format == "json" || *format == "both" {
		data, err := json.MarshalIndent(report, "", "  ")
		if err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 2
		}
		if err := writeFile(filepath.Join(*outputDir, "report.json"), append(data, '\n')); err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 2
		}
	}
	return 0
}

func buildComparisonData(baseline, candidate NormManifest, cfg RegressionConfig, excludedMetrics map[string]bool, selectedSplits []string) (ComparisonData, error) {
	if baseline.Model.TaskType != candidate.Model.TaskType {
		return ComparisonData{}, fmt.Errorf("task type mismatch: baseline %q candidate %q", baseline.Model.TaskType, candidate.Model.TaskType)
	}
	baseSplits := make(map[string]bool)
	for _, ev := range baseline.Evaluations {
		baseSplits[ev.Split] = true
	}
	candSplits := make(map[string]bool)
	for _, ev := range candidate.Evaluations {
		candSplits[ev.Split] = true
	}
	var splitOrder []string
	if len(selectedSplits) > 0 {
		for _, name := range selectedSplits {
			if !baseSplits[name] {
				return ComparisonData{}, fmt.Errorf("split %q not found in baseline", name)
			}
			if !candSplits[name] {
				return ComparisonData{}, fmt.Errorf("split %q not found in candidate", name)
			}
			splitOrder = append(splitOrder, name)
		}
	} else {
		for _, ev := range candidate.Evaluations {
			if !baseSplits[ev.Split] {
				return ComparisonData{}, fmt.Errorf("split %q present in candidate but not baseline", ev.Split)
			}
		}
		for _, ev := range baseline.Evaluations {
			found := false
			for _, cev := range candidate.Evaluations {
				if cev.Split == ev.Split {
					found = true
					break
				}
			}
			if !found {
				return ComparisonData{}, fmt.Errorf("split %q present in baseline but not candidate", ev.Split)
			}
			splitOrder = append(splitOrder, ev.Split)
		}
	}
	taskType := baseline.Model.TaskType
	metricOrder := metricOrderForTask(taskType)
	cd := ComparisonData{
		Baseline:           ModelRef{Name: baseline.Model.Name, Version: baseline.Model.Version},
		Candidate:          ModelRef{Name: candidate.Model.Name, Version: candidate.Model.Version},
		TaskType:           taskType,
		SplitOrder:         []string{},
		MetricOrder:        metricOrder,
		Deltas:             make(map[string]map[string]DeltaEntry),
		RegressionMetrics:  []string{},
		RegressionAnalysis: make(map[string]RegressionAnalysisEntry),
		Overall: Overall{
			Verdict:                "PASS",
			MaxCriticalRegressions: cfg.Rules.MaxCriticalRegressions,
			MaxWarningRegressions:  cfg.Rules.MaxWarningRegressions,
		},
	}
	cd.SplitOrder = splitOrder
	for _, metric := range metricOrder {
		if excludedMetrics[metric] {
			continue
		}
		if _, ok := cfg.Thresholds[metric]; ok {
			cd.RegressionMetrics = append(cd.RegressionMetrics, metric)
		}
	}
	baseResults := make(map[string]EvalResult)
	candResults := make(map[string]EvalResult)
	for _, ev := range baseline.Evaluations {
		baseResults[ev.Split] = computeMetrics(taskType, ev.Predictions)
	}
	for _, ev := range candidate.Evaluations {
		candResults[ev.Split] = computeMetrics(taskType, ev.Predictions)
	}
	for _, split := range cd.SplitOrder {
		cd.Deltas[split] = make(map[string]DeltaEntry)
		for _, metric := range metricOrder {
			b := baseResults[split].Metrics[metric]
			c := candResults[split].Metrics[metric]
			abs := c - b
			var rel *float64
			if math.Abs(b) > 1e-10 {
				r := (c - b) / math.Abs(b)
