\t\tswitch t.Severity {
\t\tcase "critical", "warning", "info":
\t\tdefault:
\t\t\treturn RegressionConfig{}, fmt.Errorf("%s: invalid severity %q for metric %q", path, t.Severity, metric)
\t\t}
\t}
\treturn cfg, nil
}''',
'''func loadRegressionConfig(path string) (RegressionConfig, error) {
\tvar cfg RegressionConfig
\tif err := readJSON(path, &cfg); err != nil {
\t\treturn RegressionConfig{}, err
\t}
\tfor metric, t := range cfg.Thresholds {
\t\tswitch t.Severity {
\t\tcase "critical", "warning", "info":
\t\tdefault:
\t\t\treturn RegressionConfig{}, fmt.Errorf("%s: invalid severity %q for metric %q", path, t.Severity, metric)
\t\t}
\t\tif t.MaxDelta != nil && *t.MaxDelta < 0 {
\t\t\treturn RegressionConfig{}, fmt.Errorf("%s: max_delta must be non-negative for metric %q", path, metric)
\t\t}
\t\tif t.MaxRelativeDelta != nil && *t.MaxRelativeDelta < 0 {
\t\t\treturn RegressionConfig{}, fmt.Errorf("%s: max_relative_delta must be non-negative for metric %q", path, metric)
\t\t}
\t\tif t.MaxDelta == nil && t.MinAbsoluteDelta > 0 {
\t\t\treturn RegressionConfig{}, fmt.Errorf("%s: invalid min_absolute_delta %q for metric %q; expected non-positive value", path, t.MinAbsoluteDelta, metric)
\t\t}
\t\tif t.MaxRelativeDelta == nil && t.MinRelativeDelta > 0 {
\t\t\treturn RegressionConfig{}, fmt.Errorf("%s: invalid min_relative_delta %q for metric %q; expected non-positive value", path, t.MinRelativeDelta, metric)
\t\t}
\t}
\treturn cfg, nil
}

func metricDirection(metric string) string {
\tswitch metric {
\tcase "mse", "rmse", "mae", "log_loss", "smape":
\t\treturn "lower-is-better"
\tdefault:
\t\treturn "higher-is-better"
\t}
}

func thresholdMaxDelta(t Threshold) float64 {
\tif t.MaxDelta != nil {
\t\treturn *t.MaxDelta
\t}
\treturn -t.MinAbsoluteDelta
}

func thresholdMaxRelativeDelta(t Threshold) float64 {
\tif t.MaxRelativeDelta != nil {
\t\treturn *t.MaxRelativeDelta
\t}
\treturn -t.MinRelativeDelta
}'''
)

