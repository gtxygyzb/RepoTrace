   156	func round6(x float64) float64 {
   157		if math.IsNaN(x) || math.IsInf(x, 0) {
   158			return 0
   159		}
   160		r := math.Round(x*1e6) / 1e6
   161		if r == 0 {
   162			r = 0
   163		}
   164		return r
   165	}
   166	
   167	func formatFloat6(x float64) string {
   168		return strconv.FormatFloat(round6(x), 'f', 6, 64)
   169	}
   170	
   171	func formatFloat2(x float64) string {
   172		return strconv.FormatFloat(math.Round(x*100)/100, 'f', 2, 64)
   173	}
   174	
   175	func safeDiv(num, den float64) float64 {
   176		if den == 0 {
   177			return 0
   178		}
   179		return num / den
   180	}
