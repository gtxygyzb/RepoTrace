[?2004l   430	func computeBinary(preds []NormPrediction) EvalResult {
   431		classes := collectClasses(preds, true)
   432		if len(classes) != 2 {
   433			return EvalResult{Metrics: zeroMetrics(metricOrderForTask("binary_classification")), MetricOrder: metricOrderForTask("binary_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}
   434		}
   435		pos := classes[1]
   436		tp, fp, fn, tn := 0, 0, 0, 0
   437		for _, p := range preds {
   438			ap := p.ActualStr == pos
   439			pp := p.PredictedStr == pos
   440			switch {
   441			case ap && pp:
   442				tp++
   443			case !ap && pp:
   444				fp++
   445			case ap && !pp:
   446				fn++
   447			default:
   448				tn++
   449			}
   450		}
   451		total := len(preds)
   452		accuracy := safeDivInt(tp+tn, total)
   453		precision := safeDivInt(tp, tp+fp)
   454		recall := safeDivInt(tp, tp+fn)
   455		f1 := safeDiv(2*precision*recall, precision+recall)
   456		auc := aucROC(preds, pos)
   457		ll := logLoss(preds, pos)
   458		metrics := map[string]float64{
   459			"accuracy":  accuracy,
   460			"precision": precision,
   461			"recall":    recall,
   462			"f1":        f1,
   463			"auc_roc":   auc,
   464			"log_loss":  ll,
   465		}
   466		return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask("binary_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}
   467	}
   468	
   469	func aucROC(preds []NormPrediction, pos string) float64 {
   470		totalPos := 0
   471		totalNeg := 0
   472		type sample struct {
   473			p float64
   474			y int
   475		}
   476		samples := make([]sample, 0, len(preds))
   477		for _, pr := range preds {
   478			y := 0
   479			if pr.ActualStr == pos {
   480				y = 1
   481				totalPos++
   482			} else {
   483				totalNeg++
   484			}
   485			p := 0.0
   486			if v, ok := pr.Probabilities[pos]; ok {
   487				p = v
   488			}
   489			samples = append(samples, sample{p: p, y: y})
   490		}
   491		if totalPos == 0 || totalNeg == 0 {
   492			return 0
   493		}
   494		sort.SliceStable(samples, func(i, j int) bool {
   495			if samples[i].p != samples[j].p {
   496				return samples[i].p > samples[j].p
   497			}
   498			return samples[i].y > samples[j].y
   499		})
   500		points := []struct{ fpr, tpr float64 }{{0, 0}}
   501		cumTP := 0
   502		cumFP := 0
   503		for _, s := range samples {
   504			if s.y == 1 {
   505				cumTP++
   506			} else {
   507				cumFP++
   508			}
   509			tpr := float64(cumTP) / float64(totalPos)
   510			fpr := float64(cumFP) / float64(totalNeg)
   511			points = append(points, struct{ fpr, tpr float64 }{fpr, tpr})
   512		}
   513		auc := 0.0
   514		for i := 1; i < len(points); i++ {
   515			auc += (points[i].fpr - points[i-1].fpr) * (points[i].tpr + points[i-1].tpr) / 2
   516		}
   517		return auc
   518	}
   519	
   520	func logLoss(preds []NormPrediction, pos string) float64 {
   521		if len(preds) == 0 {
   522			return 0
   523		}
   524		sum := 0.0
   525		for _, pr := range preds {
   526			y := 0.0
   527			if pr.ActualStr == pos {
   528				y = 1.0
   529			}
   530			p := 0.0
   531			if v, ok := pr.Probabilities[pos]; ok {
   532				p = v
   533			}
   534			p = math.Min(1-1e-15, math.Max(1e-15, p))
   535			sum += y*math.Log(p) + (1-y)*math.Log(1-p)
   536		}
   537		return -sum / float64(len(preds))
   538	}
