   558	func logLoss(preds []NormPrediction, pos string) float64 {
   559		if len(preds) == 0 {
   560			return 0
   561		}
   562		sum := 0.0
   563		for _, pr := range preds {
   564			y := 0.0
   565			if pr.ActualStr == pos {
   566				y = 1.0
   567			}
   568			p := 0.0
   569			if v, ok := pr.Probabilities[pos]; ok {
   570				p = v
   571			}
   572			p = math.Min(1-1e-15, math.Max(1e-15, p))
   573			sum += y*math.Log(p) + (1-y)*math.Log(1-p)
   574		}
   575		return -sum / float64(len(preds))
   576	}
   577	
   578	func makeConfusionMatrix(preds []NormPrediction, classes []string) *ConfusionMatrixReport {
   579		if len(classes) == 0 {
   580			return nil
   581		}
   582		idx := make(map[string]int)
   583		for i, c := range classes {
   584			idx[c] = i
   585		}
   586		matrix := make([][]int, len(classes))
   587		for i := range matrix {
   588			matrix[i] = make([]int, len(classes))
   589		}
   590		for _, p := range preds {
   591			ai, ok := idx[p.ActualStr]
   592			if !ok {
   593				continue
   594			}
   595			pi, ok2 := idx[p.PredictedStr]
   596			if !ok2 {
   597				continue
   598			}
   599			matrix[ai][pi]++
   600		}
   601		return &ConfusionMatrixReport{Classes: classes, Matrix: matrix}
   602	}
   603	
   604	func computeMulticlass(preds []NormPrediction) EvalResult {
   605		classes := collectClasses(preds, true)
   606		if len(classes) < 3 {
   607			return EvalResult{Metrics: zeroMetrics(metricOrderForTask("multiclass_classification")), MetricOrder: metricOrderForTask("multiclass_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}
   608		}
   609		total := len(preds)
   610		correct := 0
   611		type counts struct{ tp, fp, fn, tn, support int }
   612		perClass := make(map[string]counts)
   613		for _, c := range classes {
   614			perClass[c] = counts{}
   615		}
   616		for _, p := range preds {
   617			if p.ActualStr == p.PredictedStr {
   618				correct++
   619			}
   620			pc := perClass[p.ActualStr]
   621			pc.support++
   622			perClass[p.ActualStr] = pc
   623			for _, c := range classes {
   624				tp, fp, fn, tn := 0, 0, 0, 0
   625				actualC := p.ActualStr == c
   626				predC := p.PredictedStr == c
   627				if actualC && predC {
   628					tp = 1
   629				} else if !actualC && predC {
   630					fp = 1
   631				} else if actualC && !predC {
   632					fn = 1
   633				} else {
   634					tn = 1
   635				}
   636				pc := perClass[c]
   637				pc.tp += tp
   638				pc.fp += fp
   639				pc.fn += fn
   640				pc.tn += tn
   641				perClass[c] = pc
   642			}
   643		}
   644		sumTP, sumFP, sumFN := 0, 0, 0
   645		precisions := make([]float64, len(classes))
   646		recalls := make([]float64, len(classes))
   647		f1s := make([]float64, len(classes))
   648		supports := make([]int, len(classes))
   649		perClassMetrics := make(map[string]PerClassMetric)
   650		for i, c := range classes {
   651			pc := perClass[c]
   652			sumTP += pc.tp
   653			sumFP += pc.fp
   654			sumFN += pc.fn
   655			supports[i] = pc.support
   656			precisions[i] = safeDivInt(pc.tp, pc.tp+pc.fp)
   657			recalls[i] = safeDivInt(pc.tp, pc.tp+pc.fn)
   658			f1s[i] = safeDiv(2*precisions[i]*recalls[i], precisions[i]+recalls[i])
   659			perClassMetrics[c] = PerClassMetric{Precision: precisions[i], Recall: recalls[i], F1: f1s[i], Support: pc.support}
   660		}
   661		accuracy := safeDivInt(correct, total)
   662		precisionMicro := safeDivInt(sumTP, sumTP+sumFP)
   663		recallMicro := safeDivInt(sumTP, sumTP+sumFN)
   664		f1Micro := safeDiv(2*precisionMicro*recallMicro, precisionMicro+recallMicro)
   665		precisionMacro := mean(precisions)
   666		recallMacro := mean(recalls)
   667		f1Macro := mean(f1s)
   668		precisionWeighted := weighted(precisions, supports)
   669		recallWeighted := weighted(recalls, supports)
   670		f1Weighted := weighted(f1s, supports)
   671		metrics := map[string]float64{
   672			"accuracy":           accuracy,
   673			"precision_micro":    precisionMicro,
   674			"recall_micro":       recallMicro,
   675			"f1_micro":           f1Micro,
   676			"precision_macro":    precisionMacro,
   677			"recall_macro":       recallMacro,
   678			"f1_macro":           f1Macro,
   679			"precision_weighted": precisionWeighted,
   680			"recall_weighted":    recallWeighted,
   681			"f1_weighted":        f1Weighted,
   682		}
   683		return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask("multiclass_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes), PerClassMetrics: perClassMetrics}
   684	}
   685	
   686	func computeRegression(preds []NormPrediction) EvalResult {
   687		n := len(preds)
   688		actuals := make([]float64, n)
   689		predicted := make([]float64, n)
   690		for i, p := range preds {
   691			actuals[i] = p.ActualNum
   692			predicted[i] = p.PredictedNum
   693		}
   694		se := 0.0
   695		ae := 0.0
   696		smapeSum := 0.0
   697		smapeCount := 0
   698		for i := 0; i < n; i++ {
   699			diff := actuals[i] - predicted[i]
   700			se += diff * diff
   701			ae += math.Abs(diff)
   702			denom := math.Abs(actuals[i]) + math.Abs(predicted[i])
   703			if denom >= 1e-10 {
   704				smapeSum += 2 * math.Abs(diff) / denom
   705				smapeCount++
   706			}
   707		}
   708		mse := se / float64(n)
   709		rmse := math.Sqrt(mse)
   710		mae := ae / float64(n)
   711		meanActual := mean(actuals)
   712		ssRes := 0.0
   713		ssTot := 0.0
   714		for _, a := range actuals {
   715			ssTot += (a - meanActual) * (a - meanActual)
   716		}
   717		for i := range actuals {
   718			diff := actuals[i] - predicted[i]
   719			ssRes += diff * diff
   720		}
