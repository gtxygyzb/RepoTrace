  1035	func buildComparisonData(baseline, candidate NormManifest, cfg RegressionConfig, excludedMetrics map[string]bool) (ComparisonData, error) {
  1036		if baseline.Model.TaskType != candidate.Model.TaskType {
  1037			return ComparisonData{}, fmt.Errorf("task type mismatch: baseline %q candidate %q", baseline.Model.TaskType, candidate.Model.TaskType)
  1038		}
  1039		baseSplits := make(map[string]bool)
  1040		for _, ev := range baseline.Evaluations {
  1041			baseSplits[ev.Split] = true
  1042		}
  1043		for _, ev := range candidate.Evaluations {
  1044			if !baseSplits[ev.Split] {
  1045				return ComparisonData{}, fmt.Errorf("split %q present in candidate but not baseline", ev.Split)
  1046			}
  1047		}
  1048		for _, ev := range baseline.Evaluations {
  1049			found := false
  1050			for _, cev := range candidate.Evaluations {
  1051				if cev.Split == ev.Split {
  1052					found = true
  1053					break
  1054				}
  1055			}
  1056			if !found {
  1057				return ComparisonData{}, fmt.Errorf("split %q present in baseline but not candidate", ev.Split)
  1058			}
  1059		}
  1060		taskType := baseline.Model.TaskType
  1061		metricOrder := metricOrderForTask(taskType)
  1062		cd := ComparisonData{
  1063			Baseline:           ModelRef{Name: baseline.Model.Name, Version: baseline.Model.Version},
  1064			Candidate:          ModelRef{Name: candidate.Model.Name, Version: candidate.Model.Version},
  1065			TaskType:           taskType,
  1066			SplitOrder:         []string{},
  1067			MetricOrder:        metricOrder,
  1068			Deltas:             make(map[string]map[string]DeltaEntry),
  1069			RegressionMetrics:  []string{},
  1070			RegressionAnalysis: make(map[string]RegressionAnalysisEntry),
  1071			Overall: Overall{
  1072				Verdict:                "PASS",
  1073				MaxCriticalRegressions: cfg.Rules.MaxCriticalRegressions,
  1074				MaxWarningRegressions:  cfg.Rules.MaxWarningRegressions,
  1075			},
  1076		}
  1077		for _, ev := range baseline.Evaluations {
  1078			cd.SplitOrder = append(cd.SplitOrder, ev.Split)
  1079		}
  1080		for _, metric := range metricOrder {
  1081			if excludedMetrics[metric] {
  1082				continue
  1083			}
  1084			if _, ok := cfg.Thresholds[metric]; ok {
  1085				cd.RegressionMetrics = append(cd.RegressionMetrics, metric)
  1086			}
  1087		}
  1088		baseResults := make(map[string]EvalResult)
  1089		candResults := make(map[string]EvalResult)
  1090		for _, ev := range baseline.Evaluations {
  1091			baseResults[ev.Split] = computeMetrics(taskType, ev.Predictions)
  1092		}
  1093		for _, ev := range candidate.Evaluations {
  1094			candResults[ev.Split] = computeMetrics(taskType, ev.Predictions)
  1095		}
  1096		for _, split := range cd.SplitOrder {
  1097			cd.Deltas[split] = make(map[string]DeltaEntry)
  1098			for _, metric := range metricOrder {
  1099				b := baseResults[split].Metrics[metric]
  1100				c := candResults[split].Metrics[metric]
  1101				abs := c - b
  1102				var rel *float64
  1103				if math.Abs(b) > 1e-10 {
  1104					r := (c - b) / math.Abs(b)
  1105					r = round6(r)
  1106					rel = &r
  1107				}
  1108				cd.Deltas[split][metric] = DeltaEntry{
  1109					Baseline:      round6(b),
  1110					Candidate:     round6(c),
  1111					AbsoluteDelta: round6(abs),
  1112					RelativeDelta: rel,
  1113				}
  1114			}
  1115		}
  1116		criticalCount := 0
  1117		warningCount := 0
  1118		for _, metric := range cd.RegressionMetrics {
  1119			t := cfg.Thresholds[metric]
  1120			direction := metricDirection(metric)
  1121			regressedSplits := []string{}
  1122			for _, split := range cd.SplitOrder {
  1123				b := baseResults[split].Metrics[metric]
  1124				c := candResults[split].Metrics[metric]
  1125				var regressionDelta float64
  1126				if direction == "lower-is-better" {
  1127					regressionDelta = c - b
  1128				} else {
  1129					regressionDelta = b - c
  1130				}
  1131				maxDelta := thresholdMaxDelta(t)
  1132				maxRelativeDelta := thresholdMaxRelativeDelta(t)
  1133				regressed := regressionDelta > maxDelta
  1134				if !regressed && math.Abs(b) > 1e-10 {
  1135					rel := regressionDelta / math.Abs(b)
  1136					if rel > maxRelativeDelta {
  1137						regressed = true
  1138					}
  1139				}
  1140				if regressed {
  1141					regressedSplits = append(regressedSplits, split)
  1142				}
  1143			}
  1144			verdict := "PASS"
  1145			if len(regressedSplits) > 0 {
  1146				verdict = "REGRESSED"
  1147				switch t.Severity {
  1148				case "critical":
  1149					criticalCount++
  1150				case "warning":
  1151					warningCount++
  1152				}
  1153			}
  1154			cd.RegressionAnalysis[metric] = RegressionAnalysisEntry{
  1155				Severity:        t.Severity,
  1156				Direction:       direction,
  1157				RegressedSplits: regressedSplits,
  1158				Verdict:         verdict,
  1159			}
  1160		}
  1161		cd.Overall.CriticalRegressions = criticalCount
  1162		cd.Overall.WarningRegressions = warningCount
  1163		if criticalCount > cfg.Rules.MaxCriticalRegressions || warningCount > cfg.Rules.MaxWarningRegressions {
  1164			cd.Overall.Verdict = "FAIL"
  1165		}
  1166		return cd, nil
  1167	}
