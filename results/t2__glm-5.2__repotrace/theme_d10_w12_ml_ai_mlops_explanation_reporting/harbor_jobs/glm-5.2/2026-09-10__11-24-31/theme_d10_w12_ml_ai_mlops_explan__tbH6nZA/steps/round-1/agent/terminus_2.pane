   828	func buildEvaluateMarkdown(report ReportJSON, nm NormManifest, splits []string, bootstrap int) string {
   829		var b strings.Builder
   830		fmt.Fprintf(&b, "# Evaluation Report: %s v%s\n\n", nm.Model.Name, nm.Model.Version)
   831		fmt.Fprintf(&b, "Task type: %s\n\n", nm.Model.TaskType)
   832		fmt.Fprintf(&b, "## Summary\n\n")
   833		visibleEvals := make([]NormEvaluation, 0, len(nm.Evaluations))
   834		for _, ev := range nm.Evaluations {
   835			if len(splits) > 0 {
   836				found := false
   837				for _, split := range splits {
   838					if split == ev.Split {
   839						found = true
   840						break
   841					}
   842				}
   843				if !found {
   844					continue
   845				}
   846			}
   847			visibleEvals = append(visibleEvals, ev)
   848		}
   849		headers := []string{"Metric"}
   850		for _, ev := range visibleEvals {
   851			headers = append(headers, ev.Split)
   852		}
   853		fmt.Fprintln(&b, "| "+strings.Join(headers, " | ")+" |")
   854		sep := []string{"--------"}
   855		for range visibleEvals {
   856			sep = append(sep, "-----------")
   857		}
   858		fmt.Fprintln(&b, "| "+strings.Join(sep, " | ")+" |")
   859		for _, metric := range metricOrderForTask(nm.Model.TaskType) {
   860			row := []string{metric}
   861			for _, ev := range visibleEvals {
   862				sr := report.Splits[ev.Split]
   863				val := formatFloat6(sr.Metrics[metric])
   864				if bootstrap > 0 {
   865					if ci, ok := sr.ConfidenceIntervals[metric]; ok {
   866						val = fmt.Sprintf("%s [%s, %s]", val, formatFloat6(ci.Lower), formatFloat6(ci.Upper))
   867					}
   868				}
   869				row = append(row, val)
   870			}
   871			fmt.Fprintln(&b, "| "+strings.Join(row, " | ")+" |")
   872		}
   873		fmt.Fprintln(&b)
   874		for _, ev := range visibleEvals {
   875			sr := report.Splits[ev.Split]
   876			fmt.Fprintf(&b, "## Split: %s\n\n", ev.Split)
   877			fmt.Fprintf(&b, "### Dataset\n%s\n\n", ev.Dataset)
   878			fmt.Fprintf(&b, "### Metrics\n\n")
   879			fmt.Fprintln(&b, "| Metric | Value |")
   880			fmt.Fprintln(&b, "|--------|-------|")
   881			for _, metric := range metricOrderForTask(nm.Model.TaskType) {
   882				fmt.Fprintf(&b, "| %s | %s |\n", metric, formatFloat6(sr.Metrics[metric]))
   883			}
   884			fmt.Fprintln(&b)
   885			if nm.Model.TaskType != "regression" && sr.ConfusionMatrix != nil {
   886				fmt.Fprintf(&b, "### Confusion Matrix\n\n")
   887				classes := sr.ConfusionMatrix.Classes
   888				header := []string{""}
   889				for _, c := range classes {
   890					header = append(header, "Predicted: "+c)
   891				}
   892				fmt.Fprintln(&b, "| "+strings.Join(header, " | ")+" |")
   893				sep := []string{"--"}
   894				for range classes {
   895					sep = append(sep, "---------------------")
   896				}
   897				fmt.Fprintln(&b, "| "+strings.Join(sep, " | ")+" |")
   898				for i, c := range classes {
   899					row := []string{"Actual: " + c}
   900					for _, count := range sr.ConfusionMatrix.Matrix[i] {
   901						row = append(row, strconv.Itoa(count))
   902					}
   903					fmt.Fprintln(&b, "| "+strings.Join(row, " | ")+" |")
   904				}
   905				fmt.Fprintln(&b)
   906			}
   907			if nm.Model.TaskType == "multiclass_classification" && len(sr.PerClassMetrics) > 0 {
   908				fmt.Fprintf(&b, "### Per-Class Metrics\n\n")
   909				fmt.Fprintln(&b, "| Class | Precision | Recall | F1 | Support |")
   910				fmt.Fprintln(&b, "|-------|-----------|--------|----|---------|")
   911				classes := make([]string, 0, len(sr.PerClassMetrics))
   912				for c := range sr.PerClassMetrics {
   913					classes = append(classes, c)
   914				}
   915				sortClasses(classes)
   916				for _, c := range classes {
   917					pm := sr.PerClassMetrics[c]
   918					fmt.Fprintf(&b, "| %s | %s | %s | %s | %d |\n", c, formatFloat6(pm.Precision), formatFloat6(pm.Recall), formatFloat6(pm.F1), pm.Support)
   919				}
   920				fmt.Fprintln(&b)
   921			}
   922			if bootstrap > 0 && len(sr.ConfidenceIntervals) > 0 {
   923				fmt.Fprintf(&b, "### Confidence Intervals\n\n")
   924				fmt.Fprintln(&b, "| Metric | Lower | Upper |")
   925				fmt.Fprintln(&b, "|--------|-------|-------|")
   926				for _, metric := range ciMetricsForTask(nm.Model.TaskType) {
   927					if ci, ok := sr.ConfidenceIntervals[metric]; ok {
   928						fmt.Fprintf(&b, "| %s | %s | %s |\n", metric, formatFloat6(ci.Lower), formatFloat6(ci.Upper))
   929					}
   930				}
   931				fmt.Fprintln(&b)
   932			}
   933		}
   934		return b.String()
   935	}
   936	
   937	func writeFile(path string, data []byte) error {
   938		return os.WriteFile(path, data, 0644)
   939	}
   940	
   941	func runEvaluate(args []string) int {
   942		fs := flag.NewFlagSet("evaluate", flag.ContinueOnError)
   943		manifest := fs.String("manifest", "", "path to evaluation manifest JSON file")
   944		outputDir := fs.String("output-dir", "", "directory for output files")
   945		format := fs.String("format", "both", "output format: md, json, or both")
   946		bootstrap := fs.Int("bootstrap", 1000, "number of bootstrap iterations")
   947		confidence := fs.Float64("confidence", 0.95, "confidence level")
   948		seed := fs.Int64("seed", 42, "random seed")
   949		split := fs.String("split", "", "comma-separated list of split names to include")
   950		if err := fs.Parse(args); err != nil {
   951			fmt.Fprintln(os.Stderr, err)
   952			return 2
   953		}
   954		if *manifest == "" {
   955			fmt.Fprintln(os.Stderr, "--manifest is required")
