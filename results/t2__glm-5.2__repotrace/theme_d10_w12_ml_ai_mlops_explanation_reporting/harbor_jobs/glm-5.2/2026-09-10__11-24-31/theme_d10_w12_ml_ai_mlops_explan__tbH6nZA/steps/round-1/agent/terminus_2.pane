   281	func readJSON(path string, v any) error {
   282		data, err := os.ReadFile(path)
   283		if err != nil {
   284			return fmt.Errorf("read %s: %w", path, err)
   285		}
   286		if err := json.Unmarshal(data, v); err != nil {
   287			return fmt.Errorf("parse %s: %w", path, err)
   288		}
   289		return nil
   290	}
   291	
   292	func loadManifest(path string) (NormManifest, error) {
   293		var raw Manifest
   294		if err := readJSON(path, &raw); err != nil {
   295			return NormManifest{}, err
   296		}
   297		if !validModelName.MatchString(raw.Model.Name) {
   298			return NormManifest{}, fmt.Errorf("%s: invalid model name %q", path, raw.Model.Name)
   299		}
   300		if !validVersion.MatchString(raw.Model.Version) {
   301			return NormManifest{}, fmt.Errorf("%s: invalid model version %q", path, raw.Model.Version)
   302		}
   303		switch raw.Model.TaskType {
   304		case "binary_classification", "multiclass_classification", "regression":
   305		default:
   306			return NormManifest{}, fmt.Errorf("%s: invalid task_type %q", path, raw.Model.TaskType)
   307		}
   308		if len(raw.Evaluations) == 0 {
   309			return NormManifest{}, fmt.Errorf("%s: at least one evaluation is required", path)
   310		}
   311		nm := NormManifest{Model: raw.Model}
   312		splits := make(map[string]bool)
   313		for _, ev := range raw.Evaluations {
   314			if ev.Split == "" {
   315				return NormManifest{}, fmt.Errorf("%s: split name is required", path)
   316			}
   317			if splits[ev.Split] {
   318				return NormManifest{}, fmt.Errorf("%s: duplicate split name %q", path, ev.Split)
   319			}
   320			splits[ev.Split] = true
   321			if ev.Dataset == "" {
   322				return NormManifest{}, fmt.Errorf("%s: dataset is required for split %q", path, ev.Split)
   323			}
   324			if len(ev.Predictions) == 0 {
   325				return NormManifest{}, fmt.Errorf("%s: split %q must have at least one prediction", path, ev.Split)
   326			}
   327			ne := NormEvaluation{Split: ev.Split, Dataset: ev.Dataset}
   328			ids := make(map[string]bool)
   329			for _, rp := range ev.Predictions {
   330				if rp.ID == "" {
   331					return NormManifest{}, fmt.Errorf("%s: prediction id is required in split %q", path, ev.Split)
   332				}
   333				if ids[rp.ID] {
   334					return NormManifest{}, fmt.Errorf("%s: duplicate prediction id %q in split %q", path, rp.ID, ev.Split)
   335				}
   336				ids[rp.ID] = true
   337				np, err := normalizePrediction(path, ev.Split, rp, raw.Model.TaskType)
   338				if err != nil {
   339					return NormManifest{}, err
   340				}
   341				ne.Predictions = append(ne.Predictions, np)
   342			}
   343			nm.Evaluations = append(nm.Evaluations, ne)
   344		}
   345		return nm, nil
   346	}
   347	
   348	func normalizePrediction(path, split string, rp RawPrediction, taskType string) (NormPrediction, error) {
   349		np := NormPrediction{ID: rp.ID}
   350		if taskType == "regression" {
   351			if len(rp.Actual) == 0 {
   352				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual is required", path, split, rp.ID)
   353			}
   354			if err := json.Unmarshal(rp.Actual, &np.ActualNum); err != nil {
   355				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual must be a number", path, split, rp.ID)
   356			}
   357			if err := json.Unmarshal(rp.Predicted, &np.PredictedNum); err != nil {
   358				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: predicted must be a number", path, split, rp.ID)
   359			}
   360			if len(rp.Probabilities) > 0 && string(rp.Probabilities) != "null" {
   361				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities must be absent for regression", path, split, rp.ID)
   362			}
   363		} else {
   364			if len(rp.Actual) == 0 {
   365				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual is required", path, split, rp.ID)
   366			}
   367			if err := json.Unmarshal(rp.Actual, &np.ActualStr); err != nil {
   368				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: actual must be a string", path, split, rp.ID)
   369			}
   370			if err := json.Unmarshal(rp.Predicted, &np.PredictedStr); err != nil {
   371				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: predicted must be a string", path, split, rp.ID)
   372			}
   373			if len(rp.Probabilities) == 0 || string(rp.Probabilities) == "null" {
   374				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities are required for classification", path, split, rp.ID)
   375			}
   376			probs := make(map[string]float64)
   377			if err := json.Unmarshal(rp.Probabilities, &probs); err != nil {
   378				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: invalid probabilities", path, split, rp.ID)
   379			}
   380			if len(probs) == 0 {
   381				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities must not be empty", path, split, rp.ID)
   382			}
   383			sum := 0.0
   384			for k, v := range probs {
   385				if k == "" {
   386					return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probability class label is empty", path, split, rp.ID)
   387				}
   388				if math.IsNaN(v) || math.IsInf(v, 0) || v < 0 || v > 1 {
   389					return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probability for %q out of range", path, split, rp.ID, k)
   390				}
   391				sum += v
   392			}
   393			if math.Abs(sum-1) > 1e-6 {
   394				return NormPrediction{}, fmt.Errorf("%s: split %q prediction %q: probabilities must sum to 1", path, split, rp.ID)
   395			}
   396			np.Probabilities = probs
   397			np.HasProbabilities = true
   398		}
   399		return np, nil
   400	}
   401	
   402	func loadRegressionConfig(path string) (RegressionConfig, error) {
   403		var cfg RegressionConfig
   404		if err := readJSON(path, &cfg); err != nil {
   405			return RegressionConfig{}, err
   406		}
   407		for metric, t := range cfg.Thresholds {
   408			switch t.Severity {
   409			case "critical", "warning", "info":
   410			default:
   411				return RegressionConfig{}, fmt.Errorf("%s: invalid severity %q for metric %q", path, t.Severity, metric)
   412			}
   413		}
   414		return cfg, nil
   415	}
   416	
   417	func computeMetrics(taskType string, preds []NormPrediction) EvalResult {
   418		switch taskType {
   419		case "binary_classification":
   420			return computeBinary(preds)
   421		case "multiclass_classification":
   422			return computeMulticlass(preds)
   423		case "regression":
   424			return computeRegression(preds)
   425		default:
   426			return EvalResult{Metrics: map[string]float64{}, MetricOrder: metricOrderForTask(taskType)}
   427		}
   428	}
   429	
   430	func computeBinary(preds []NormPrediction) EvalResult {
   431		classes := collectClasses(preds, true)
   432		if len(classes) != 2 {
   433			return EvalResult{Metrics: zeroMetrics(metricOrderForTask("binary_classification")), MetricOrder: metricOrderForTask("binary_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}
   434		}
   435		pos := classes[1]
   436		tp, fp, fn, tn := 0, 0, 0, 0
   437		for _, p := range preds {
   438			ap := p.ActualStr == pos
   439			pp := p.PredictedStr == pos
   440			switch {
   441			case ap && pp:
   442				tp++
   443			case !ap && pp:
   444				fp++
   445			case ap && !pp:
   446				fn++
   447			default:
   448				tn++
   449			}
   450		}
   451		total := len(preds)
   452		accuracy := safeDivInt(tp+tn, total)
   453		precision := safeDivInt(tp, tp+fp)
   454		recall := safeDivInt(tp, tp+fn)
   455		f1 := safeDiv(2*precision*recall, precision+recall)
   456		auc := aucROC(preds, pos)
   457		ll := logLoss(preds, pos)
   458		metrics := map[string]float64{
   459			"accuracy":  accuracy,
   460			"precision": precision,
   461			"recall":    recall,
   462			"f1":        f1,
   463			"auc_roc":   auc,
   464			"log_loss":  ll,
   465		}
   466		return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask("binary_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}
   467	}
   468	
   469	func aucROC(preds []NormPrediction, pos string) float64 {
   470		totalPos := 0
   471		totalNeg := 0
   472		type sample struct {
   473			p float64
   474			y int
   475		}
   476		samples := make([]sample, 0, len(preds))
   477		for _, pr := range preds {
   478			y := 0
   479			if pr.ActualStr == pos {
   480				y = 1
   481				totalPos++
   482			} else {
   483				totalNeg++
   484			}
   485			p := 0.0
   486			if v, ok := pr.Probabilities[pos]; ok {
   487				p = v
   488			}
   489			samples = append(samples, sample{p: p, y: y})
   490		}
   491		if totalPos == 0 || totalNeg == 0 {
   492			return 0
   493		}
   494		sort.SliceStable(samples, func(i, j int) bool {
   495			if samples[i].p != samples[j].p {
   496				return samples[i].p > samples[j].p
   497			}
   498			return samples[i].y > samples[j].y
   499		})
   500		points := []struct{ fpr, tpr float64 }{{0, 0}}
   501		cumTP := 0
   502		cumFP := 0
   503		for _, s := range samples {
   504			if s.y == 1 {
   505				cumTP++
   506			} else {
   507				cumFP++
   508			}
   509			tpr := float64(cumTP) / float64(totalPos)
   510			fpr := float64(cumFP) / float64(totalNeg)
   511			points = append(points, struct{ fpr, tpr float64 }{fpr, tpr})
   512		}
   513		auc := 0.0
   514		for i := 1; i < len(points); i++ {
   515			auc += (points[i].fpr - points[i-1].fpr) * (points[i].tpr + points[i-1].tpr) / 2
   516		}
   517		return auc
   518	}
   519	
