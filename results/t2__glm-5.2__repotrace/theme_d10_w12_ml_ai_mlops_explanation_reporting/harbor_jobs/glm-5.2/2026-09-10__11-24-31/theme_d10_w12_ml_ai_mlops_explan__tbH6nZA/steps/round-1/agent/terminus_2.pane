  1405				Model: SummaryModelJSON{
  1406					Name:     report.Model.Name,
  1407					Version:  report.Model.Version,
  1408					TaskType: report.Model.TaskType,
  1409				},
  1410				SplitCount:     len(report.Splits),
  1411				PrimaryMetrics: primaryMetrics,
  1412			}
