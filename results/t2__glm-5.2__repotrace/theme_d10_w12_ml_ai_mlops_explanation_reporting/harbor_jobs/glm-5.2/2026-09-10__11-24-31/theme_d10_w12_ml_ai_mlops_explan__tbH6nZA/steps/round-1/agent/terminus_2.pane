   175	func safeDiv(num, den float64) float64 {
   176		if den == 0 {
   177			return 0
   178		}
   179		return num / den
   180	}
   181	
   182	func safeDivInt(num, den int) float64 {
   183		if den == 0 {
   184			return 0
   185		}
   186		return float64(num) / float64(den)
   187	}
   188	
   189	func mean(vals []float64) float64 {
   190		if len(vals) == 0 {
   191			return 0
   192		}
   193		sum := 0.0
   194		for _, v := range vals {
   195			sum += v
   196		}
   197		return sum / float64(len(vals))
   198	}
   199	
   200	func weighted(vals []float64, supports []int) float64 {
   201		if len(vals) == 0 {
   202			return 0
   203		}
   204		sumVal := 0.0
   205		sumSup := 0
   206		for i, v := range vals {
   207			sumVal += v * float64(supports[i])
   208			sumSup += supports[i]
   209		}
   210		if sumSup == 0 {
   211			return 0
   212		}
   213		return sumVal / float64(sumSup)
   214	}
   215	
