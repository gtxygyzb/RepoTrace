   874	
   875	func runEvaluate(args []string) int {
   876		fs := flag.NewFlagSet("evaluate", flag.ContinueOnError)
   877		manifest := fs.String("manifest", "", "path to evaluation manifest JSON file")
   878		outputDir := fs.String("output-dir", "", "directory for output files")
   879		format := fs.String("format", "both", "output format: md, json, or both")
   880		bootstrap := fs.Int("bootstrap", 1000, "number of bootstrap iterations")
   881		confidence := fs.Float64("confidence", 0.95, "confidence level")
   882		seed := fs.Int64("seed", 42, "random seed")
   883		if err := fs.Parse(args); err != nil {
   884			fmt.Fprintln(os.Stderr, err)
   885			return 2
   886		}
   887		if *manifest == "" {
   888			fmt.Fprintln(os.Stderr, "--manifest is required")
   889			return 2
   890		}
   891		if *outputDir == "" {
   892			fmt.Fprintln(os.Stderr, "--output-dir is required")
   893			return 2
   894		}
   895		switch *format {
   896		case "md", "json", "both":
   897		default:
   898			fmt.Fprintf(os.Stderr, "invalid --format %q; must be md, json, or both\n", *format)
   899			return 2
   900		}
   901		if *bootstrap < 0 {
   902			fmt.Fprintln(os.Stderr, "--bootstrap must be non-negative")
   903			return 2
   904		}
   905		if *confidence <= 0 || *confidence >= 1 {
   906			fmt.Fprintln(os.Stderr, "--confidence must be in (0, 1)")
   907			return 2
   908		}
   909		nm, err := loadManifest(*manifest)
   910		if err != nil {
   911			fmt.Fprintln(os.Stderr, err)
   912			return 2
   913		}
   914		report := buildReportJSON(nm, *bootstrap, *confidence, *seed)
   915		if err := os.MkdirAll(*outputDir, 0755); err != nil {
   916			fmt.Fprintln(os.Stderr, err)
   917			return 2
   918		}
   919		if *format == "md" || *format == "both" {
   920			md := buildEvaluateMarkdown(report, nm, *bootstrap)
   921			if err := writeFile(filepath.Join(*outputDir, "report.md"), []byte(md)); err != nil {
   922				fmt.Fprintln(os.Stderr, err)
   923				return 2
   924			}
   925		}
   926		if *format == "json" || *format == "both" {
   927			data, err := json.MarshalIndent(report, "", "  ")
   928			if err != nil {
   929				fmt.Fprintln(os.Stderr, err)
   930				return 2
   931			}
   932			if err := writeFile(filepath.Join(*outputDir, "report.json"), append(data, '\n')); err != nil {
   933				fmt.Fprintln(os.Stderr, err)
   934				return 2
   935			}
   936		}
   937		return 0
   938	}
   939	
   940	func buildComparisonData(baseline, candidate NormManifest, cfg RegressionConfig) (ComparisonData, error) {
   941		if baseline.Model.TaskType != candidate.Model.TaskType {
   942			return ComparisonData{}, fmt.Errorf("task type mismatch: baseline %q candidate %q", baseline.Model.TaskType, candidate.Model.TaskType)
   943		}
   944		baseSplits := make(map[string]bool)
   945		for _, ev := range baseline.Evaluations {
   946			baseSplits[ev.Split] = true
   947		}
   948		for _, ev := range candidate.Evaluations {
   949			if !baseSplits[ev.Split] {
   950				return ComparisonData{}, fmt.Errorf("split %q present in candidate but not baseline", ev.Split)
   951			}
   952		}
   953		for _, ev := range baseline.Evaluations {
   954			found := false
   955			for _, cev := range candidate.Evaluations {
   956				if cev.Split == ev.Split {
   957					found = true
   958					break
   959				}
   960			}
   961			if !found {
   962				return ComparisonData{}, fmt.Errorf("split %q present in baseline but not candidate", ev.Split)
   963			}
   964		}
   965		taskType := baseline.Model.TaskType
   966		metricOrder := metricOrderForTask(taskType)
   967		cd := ComparisonData{
   968			Baseline:           ModelRef{Name: baseline.Model.Name, Version: baseline.Model.Version},
   969			Candidate:          ModelRef{Name: candidate.Model.Name, Version: candidate.Model.Version},
   970			TaskType:           taskType,
   971			SplitOrder:         []string{},
   972			MetricOrder:        metricOrder,
   973			Deltas:             make(map[string]map[string]DeltaEntry),
   974			RegressionMetrics:  []string{},
   975			RegressionAnalysis: make(map[string]RegressionAnalysisEntry),
   976			Overall: Overall{
   977				Verdict:                "PASS",
   978				MaxCriticalRegressions: cfg.Rules.MaxCriticalRegressions,
   979				MaxWarningRegressions:  cfg.Rules.MaxWarningRegressions,
   980			},
   981		}
   982		for _, ev := range baseline.Evaluations {
   983			cd.SplitOrder = append(cd.SplitOrder, ev.Split)
   984		}
   985		for _, metric := range metricOrder {
   986			if _, ok := cfg.Thresholds[metric]; ok {
   987				cd.RegressionMetrics = append(cd.RegressionMetrics, metric)
   988			}
   989		}
   990		baseResults := make(map[string]EvalResult)
   991		candResults := make(map[string]EvalResult)
   992		for _, ev := range baseline.Evaluations {
   993			baseResults[ev.Split] = computeMetrics(taskType, ev.Predictions)
   994		}
   995		for _, ev := range candidate.Evaluations {
   996			candResults[ev.Split] = computeMetrics(taskType, ev.Predictions)
   997		}
   998		for _, split := range cd.SplitOrder {
   999			cd.Deltas[split] = make(map[string]DeltaEntry)
  1000			for _, metric := range metricOrder {
  1001				b := baseResults[split].Metrics[metric]
  1002				c := candResults[split].Metrics[metric]
  1003				abs := c - b
  1004				var rel *float64
  1005				if math.Abs(b) > 1e-10 {
  1006					r := (c - b) / math.Abs(b)
  1007					r = round6(r)
  1008					rel = &r
  1009				}
  1010				cd.Deltas[split][metric] = DeltaEntry{
  1011					Baseline:      round6(b),
  1012					Candidate:     round6(c),
  1013					AbsoluteDelta: round6(abs),
  1014					RelativeDelta: rel,
  1015				}
  1016			}
  1017		}
  1018		criticalCount := 0
  1019		warningCount := 0
  1020		for _, metric := range cd.RegressionMetrics {
  1021			t := cfg.Thresholds[metric]
  1022			regressedSplits := []string{}
  1023			for _, split := range cd.SplitOrder {
  1024				b := baseResults[split].Metrics[metric]
  1025				c := candResults[split].Metrics[metric]
  1026				abs := c - b
  1027				regressed := abs < t.MinAbsoluteDelta
  1028				if !regressed && math.Abs(b) > 1e-10 {
  1029					rel := (c - b) / math.Abs(b)
  1030					if rel < t.MinRelativeDelta {
  1031						regressed = true
  1032					}
  1033				}
  1034				if regressed {
  1035					regressedSplits = append(regressedSplits, split)
  1036				}
  1037			}
  1038			verdict := "PASS"
  1039			if len(regressedSplits) > 0 {
  1040				verdict = "REGRESSED"
  1041				switch t.Severity {
  1042				case "critical":
  1043					criticalCount++
  1044				case "warning":
  1045					warningCount++
  1046				}
  1047			}
  1048			cd.RegressionAnalysis[metric] = RegressionAnalysisEntry{
  1049				Severity:        t.Severity,
  1050				RegressedSplits: regressedSplits,
  1051				Verdict:         verdict,
  1052			}
  1053		}
  1054		cd.Overall.CriticalRegressions = criticalCount
  1055		cd.Overall.WarningRegressions = warningCount
  1056		if criticalCount > cfg.Rules.MaxCriticalRegressions || warningCount > cfg.Rules.MaxWarningRegressions {
  1057			cd.Overall.Verdict = "FAIL"
  1058		}
  1059		return cd, nil
  1060	}
  1061	
  1062	func buildComparisonMarkdown(cd ComparisonData) string {
  1063		var b strings.Builder
  1064		fmt.Fprintf(&b, "# Model Comparison Report\n\n")
  1065		fmt.Fprintf(&b, "Baseline: %s v%s\n", cd.Baseline.Name, cd.Baseline.Version)
  1066		fmt.Fprintf(&b, "Candidate: %s v%s\n", cd.Candidate.Name, cd.Candidate.Version)
  1067		fmt.Fprintf(&b, "Task type: %s\n\n", cd.TaskType)
  1068		fmt.Fprintf(&b, "## Performance Delta\n\n")
  1069		fmt.Fprintln(&b, "| Metric | Split | Baseline | Candidate | Delta | Relative Delta |")
  1070		fmt.Fprintln(&b, "|--------|-------|----------|-----------|-------|----------------|")
  1071		for _, metric := range cd.MetricOrder {
  1072			for _, split := range cd.SplitOrder {
  1073				d := cd.Deltas[split][metric]
  1074				rel := "N/A"
  1075				if d.RelativeDelta != nil {
  1076					rel = formatFloat2(*d.RelativeDelta*100) + "%"
  1077				}
  1078				fmt.Fprintf(&b, "| %s | %s | %s | %s | %s | %s |\n", metric, split, formatFloat6(d.Baseline), formatFloat6(d.Candidate), formatFloat6(d.AbsoluteDelta), rel)
  1079			}
  1080		}
  1081		fmt.Fprintln(&b)
  1082		fmt.Fprintf(&b, "## Regression Analysis\n\n")
  1083		fmt.Fprintln(&b, "| Metric | Severity | Regressed Splits | Verdict |")
  1084		fmt.Fprintln(&b, "|--------|----------|-----------------|---------|")
  1085		for _, metric := range cd.RegressionMetrics {
  1086			ra := cd.RegressionAnalysis[metric]
  1087			splits := strings.Join(ra.RegressedSplits, ", ")
  1088			fmt.Fprintf(&b, "| %s | %s | %s | %s |\n", metric, ra.Severity, splits, ra.Verdict)
  1089		}
  1090		fmt.Fprintln(&b)
  1091		fmt.Fprintf(&b, "## Overall Verdict\n\n")
  1092		fmt.Fprintf(&b, "Result: %s\n", cd.Overall.Verdict)
  1093		fmt.Fprintf(&b, "Critical regressions: %d / %d\n", cd.Overall.CriticalRegressions, cd.Overall.MaxCriticalRegressions)
  1094		fmt.Fprintf(&b, "Warning regressions: %d / %d\n", cd.Overall.WarningRegressions, cd.Overall.MaxWarningRegressions)
  1095		return b.String()
  1096	}
  1097	
  1098	func runCompare(args []string) int {
  1099		fs := flag.NewFlagSet("compare", flag.ContinueOnError)
  1100		baselinePath := fs.String("baseline", "", "path to baseline manifest")
  1101		candidatePath := fs.String("candidate", "", "path to candidate manifest")
  1102		configPath := fs.String("config", "", "path to regression config")
  1103		outputDir := fs.String("output-dir", "", "directory for output files")
  1104		format := fs.String("format", "both", "output format: md, json, or both")
  1105		if err := fs.Parse(args); err != nil {
  1106			fmt.Fprintln(os.Stderr, err)
  1107			return 2
  1108		}
  1109		if *baselinePath == "" || *candidatePath == "" || *configPath == "" || *outputDir == "" {
