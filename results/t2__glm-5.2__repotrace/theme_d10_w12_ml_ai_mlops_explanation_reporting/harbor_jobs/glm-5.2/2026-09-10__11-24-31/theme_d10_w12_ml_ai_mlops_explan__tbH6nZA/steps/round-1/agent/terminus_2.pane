   875	func runEvaluate(args []string) int {
   876		fs := flag.NewFlagSet("evaluate", flag.ContinueOnError)
   877		manifest := fs.String("manifest", "", "path to evaluation manifest JSON file")
   878		outputDir := fs.String("output-dir", "", "directory for output files")
   879		format := fs.String("format", "both", "output format: md, json, or both")
   880		bootstrap := fs.Int("bootstrap", 1000, "number of bootstrap iterations")
   881		confidence := fs.Float64("confidence", 0.95, "confidence level")
   882		seed := fs.Int64("seed", 42, "random seed")
   883		if err := fs.Parse(args); err != nil {
   884			fmt.Fprintln(os.Stderr, err)
   885			return 2
   886		}
   887		if *manifest == "" {
   888			fmt.Fprintln(os.Stderr, "--manifest is required")
   889			return 2
   890		}
   891		if *outputDir == "" {
   892			fmt.Fprintln(os.Stderr, "--output-dir is required")
   893			return 2
   894		}
   895		switch *format {
   896		case "md", "json", "both":
   897		default:
   898			fmt.Fprintf(os.Stderr, "invalid --format %q; must be md, json, or both\n", *format)
   899			return 2
   900		}
   901		if *bootstrap < 0 {
   902			fmt.Fprintln(os.Stderr, "--bootstrap must be non-negative")
   903			return 2
   904		}
   905		if *confidence <= 0 || *confidence >= 1 {
   906			fmt.Fprintln(os.Stderr, "--confidence must be in (0, 1)")
   907			return 2
   908		}
   909		nm, err := loadManifest(*manifest)
   910		if err != nil {
   911			fmt.Fprintln(os.Stderr, err)
   912			return 2
   913		}
   914		report := buildReportJSON(nm, *bootstrap, *confidence, *seed)
   915		if err := os.MkdirAll(*outputDir, 0755); err != nil {
   916			fmt.Fprintln(os.Stderr, err)
   917			return 2
   918		}
   919		if *format == "md" || *format == "both" {
   920			md := buildEvaluateMarkdown(report, nm, *bootstrap)
   921			if err := writeFile(filepath.Join(*outputDir, "report.md"), []byte(md)); err != nil {
   922				fmt.Fprintln(os.Stderr, err)
   923				return 2
   924			}
   925		}
   926		if *format == "json" || *format == "both" {
   927			data, err := json.MarshalIndent(report, "", "  ")
   928			if err != nil {
   929				fmt.Fprintln(os.Stderr, err)
   930				return 2
   931			}
   932			if err := writeFile(filepath.Join(*outputDir, "report.json"), append(data, '\n')); err != nil {
   933				fmt.Fprintln(os.Stderr, err)
   934				return 2
   935			}
   936		}
   937		return 0
   938	}
