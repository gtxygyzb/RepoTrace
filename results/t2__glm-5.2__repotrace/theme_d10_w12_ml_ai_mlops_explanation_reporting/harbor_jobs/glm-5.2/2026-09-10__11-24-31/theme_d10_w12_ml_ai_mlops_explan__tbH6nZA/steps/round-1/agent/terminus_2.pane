 540: func makeConfusionMatrix(preds []NormPrediction, classes []string) *ConfusionMatrixReport {
 541: 	if len(classes) == 0 {
 542: 		return nil
 543: 	}
 544: 	idx := make(map[string]int)
 545: 	for i, c := range classes {
 546: 		idx[c] = i
 547: 	}
 548: 	matrix := make([][]int, len(classes))
 549: 	for i := range matrix {
 550: 		matrix[i] = make([]int, len(classes))
 551: 	}
 552: 	for _, p := range preds {
 553: 		ai, ok := idx[p.ActualStr]
 554: 		if !ok {
 555: 			continue
 556: 		}
 557: 		pi, ok2 := idx[p.PredictedStr]
 558: 		if !ok2 {
 559: 			continue
 560: 		}
--- lines 560-760 ---
 560: 		}
 561: 		matrix[ai][pi]++
 562: 	}
 563: 	return &ConfusionMatrixReport{Classes: classes, Matrix: matrix}
 564: }
