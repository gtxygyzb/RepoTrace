 743: func buildReportJSON(nm NormManifest, bootstrap int, confidence float64, seed int64) ReportJSON {
 744: 	report := ReportJSON{Model: nm.Model, Splits: make(map[string]SplitReportJSON)}
 745: 	var rng *rand.Rand
 746: 	if bootstrap > 0 {
 747: 		rng = rand.New(rand.NewSource(seed))
 748: 	}
 749: 	for _, ev := range nm.Evaluations {
 750: 		result := computeMetrics(nm.Model.TaskType, ev.Predictions)
 751: 		roundedMetrics := make(map[string]float64)
 752: 		for _, name := range result.MetricOrder {
 753: 			roundedMetrics[name] = round6(result.Metrics[name])
 754: 		}
 755: 		sr := SplitReportJSON{Dataset: ev.Dataset, Metrics: roundedMetrics}
 756: 		if nm.Model.TaskType != "regression" && result.ConfusionMatrix != nil {
 757: 			sr.ConfusionMatrix = result.ConfusionMatrix
 758: 		}
 759: 		if nm.Model.TaskType == "multiclass_classification" && len(result.PerClassMetrics) > 0 {
 760: 			sr.PerClassMetrics = make(map[string]PerClassMetric)
--- lines 760-875 ---
 760: 			sr.PerClassMetrics = make(map[string]PerClassMetric)
 761: 			for class, pm := range result.PerClassMetrics {
 762: 				sr.PerClassMetrics[class] = PerClassMetric{
 763: 					Precision: round6(pm.Precision),
 764: 					Recall:    round6(pm.Recall),
 765: 					F1:        round6(pm.F1),
 766: 					Support:   pm.Support,
 767: 				}
 768: 			}
 769: 		}
 770: 		if bootstrap > 0 {
 771: 			sr.ConfidenceIntervals = computeBootstrapCIs(nm.Model.TaskType, ev.Predictions, bootstrap, confidence, rng)
 772: 		}
 773: 		report.Splits[ev.Split] = sr
 774: 	}
 775: 	return report
 776: }
