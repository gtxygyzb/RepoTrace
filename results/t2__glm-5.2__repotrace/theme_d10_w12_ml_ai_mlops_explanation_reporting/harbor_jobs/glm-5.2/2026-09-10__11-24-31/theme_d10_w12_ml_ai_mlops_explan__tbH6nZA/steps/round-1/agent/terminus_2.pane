 566: func computeMulticlass(preds []NormPrediction) EvalResult {
 567: 	classes := collectClasses(preds, true)
 568: 	if len(classes) < 3 {
 569: 		return EvalResult{Metrics: zeroMetrics(metricOrderForTask("multiclass_classification")), MetricOrder: metricOrderForTask("multiclass_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}
 570: 	}
 571: 	total := len(preds)
 572: 	correct := 0
 573: 	type counts struct{ tp, fp, fn, tn, support int }
 574: 	perClass := make(map[string]counts)
 575: 	for _, c := range classes {
 576: 		perClass[c] = counts{}
 577: 	}
 578: 	for _, p := range preds {
 579: 		if p.ActualStr == p.PredictedStr {
 580: 			correct++
 581: 		}
 582: 		pc := perClass[p.ActualStr]
 583: 		pc.support++
 584: 		perClass[p.ActualStr] = pc
 585: 		for _, c := range classes {
 586: 			tp, fp, fn, tn := 0, 0, 0, 0
 587: 			actualC := p.ActualStr == c
 588: 			predC := p.PredictedStr == c
 589: 			if actualC && predC {
 590: 				tp = 1
 591: 			} else if !actualC && predC {
 592: 				fp = 1
 593: 			} else if actualC && !predC {
 594: 				fn = 1
 595: 			} else {
 596: 				tn = 1
 597: 			}
 598: 			pc := perClass[c]
 599: 			pc.tp += tp
 600: 			pc.fp += fp
 601: 			pc.fn += fn
 602: 			pc.tn += tn
 603: 			perClass[c] = pc
 604: 		}
 605: 	}
 606: 	sumTP, sumFP, sumFN := 0, 0, 0
 607: 	precisions := make([]float64, len(classes))
 608: 	recalls := make([]float64, len(classes))
 609: 	f1s := make([]float64, len(classes))
 610: 	supports := make([]int, len(classes))
 611: 	perClassMetrics := make(map[string]PerClassMetric)
 612: 	for i, c := range classes {
 613: 		pc := perClass[c]
 614: 		sumTP += pc.tp
 615: 		sumFP += pc.fp
 616: 		sumFN += pc.fn
 617: 		supports[i] = pc.support
 618: 		precisions[i] = safeDivInt(pc.tp, pc.tp+pc.fp)
 619: 		recalls[i] = safeDivInt(pc.tp, pc.tp+pc.fn)
 620: 		f1s[i] = safeDiv(2*precisions[i]*recalls[i], precisions[i]+recalls[i])
 621: 		perClassMetrics[c] = PerClassMetric{Precision: precisions[i], Recall: recalls[i], F1: f1s[i], Support: pc.support}
 622: 	}
 623: 	accuracy := safeDivInt(correct, total)
 624: 	precisionMicro := safeDivInt(sumTP, sumTP+sumFP)
 625: 	recallMicro := safeDivInt(sumTP, sumTP+sumFN)
 626: 	f1Micro := safeDiv(2*precisionMicro*recallMicro, precisionMicro+recallMicro)
 627: 	precisionMacro := mean(precisions)
 628: 	recallMacro := mean(recalls)
 629: 	f1Macro := mean(f1s)
 630: 	precisionWeighted := weighted(precisions, supports)
 631: 	recallWeighted := weighted(recalls, supports)
 632: 	f1Weighted := weighted(f1s, supports)
 633: 	metrics := map[string]float64{
 634: 		"accuracy":           accuracy,
 635: 		"precision_micro":    precisionMicro,
 636: 		"recall_micro":       recallMicro,
 637: 		"f1_micro":           f1Micro,
 638: 		"precision_macro":    precisionMacro,
 639: 		"recall_macro":       recallMacro,
 640: 		"f1_macro":           f1Macro,
 641: 		"precision_weighted": precisionWeighted,
 642: 		"recall_weighted":    recallWeighted,
 643: 		"f1_weighted":        f1Weighted,
 644: 	}
 645: 	return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask("multiclass_classification"), ConfusionMatrix: makeConfusionMatrix(preds, classes), PerClassMetrics: perClassMetrics}
 646: }
 647: 
 648: func computeRegression(preds []NormPrediction) EvalResult {
 649: 	n := len(preds)
 650: 	actuals := make([]float64, n)
 651: 	predicted := make([]float64, n)
 652: 	for i, p := range preds {
 653: 		actuals[i] = p.ActualNum
 654: 		predicted[i] = p.PredictedNum
 655: 	}
 656: 	se := 0.0
 657: 	ae := 0.0
 658: 	smapeSum := 0.0
 659: 	smapeCount := 0
 660: 	for i := 0; i < n; i++ {
 661: 		diff := actuals[i] - predicted[i]
 662: 		se += diff * diff
 663: 		ae += math.Abs(diff)
 664: 		denom := math.Abs(actuals[i]) + math.Abs(predicted[i])
 665: 		if denom >= 1e-10 {
 666: 			smapeSum += 2 * math.Abs(diff) / denom
 667: 			smapeCount++
 668: 		}
 669: 	}
 670: 	mse := se / float64(n)
 671: 	rmse := math.Sqrt(mse)
 672: 	mae := ae / float64(n)
 673: 	meanActual := mean(actuals)
 674: 	ssRes := 0.0
 675: 	ssTot := 0.0
 676: 	for _, a := range actuals {
 677: 		ssTot += (a - meanActual) * (a - meanActual)
 678: 	}
 679: 	for i := range actuals {
 680: 		diff := actuals[i] - predicted[i]
 681: 		ssRes += diff * diff
 682: 	}
 683: 	rSquared := 0.0
 684: 	if ssTot != 0 {
 685: 		rSquared = 1 - ssRes/ssTot
 686: 	}
 687: 	smape := 0.0
 688: 	if smapeCount > 0 {
 689: 		smape = smapeSum / float64(smapeCount) * 100
 690: 	}
 691: 	metrics := map[string]float64{
 692: 		"mse":       mse,
 693: 		"rmse":      rmse,
 694: 		"mae":       mae,
 695: 		"r_squared": rSquared,
 696: 		"smape":     smape,
 697: 	}
 698: 	return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask("regression")}
 699: }
