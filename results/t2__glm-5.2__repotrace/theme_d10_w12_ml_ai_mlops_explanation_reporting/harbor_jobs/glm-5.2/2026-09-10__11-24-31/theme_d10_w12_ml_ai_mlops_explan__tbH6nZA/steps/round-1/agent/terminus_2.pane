  1321	func primaryMetricsForTask(taskType string) []string {
  1322		switch taskType {
  1323		case "binary_classification":
  1324			return []string{"accuracy", "f1", "auc_roc"}
  1325		case "multiclass_classification":
  1326			return []string{"accuracy", "f1_macro"}
  1327		case "regression":
  1328			return []string{"rmse", "mae", "r_squared"}
  1329		default:
  1330			return nil
  1331		}
  1332	}
