		fmt.Fprintf(&b, "| %s | %s | %s | %s | %s |\n", metric, ra.Severity, ra.Direction, splits, ra.Verdict)
	}
	fmt.Fprintln(&b)
	fmt.Fprintf(&b, "## Overall Verdict\n\n")
	fmt.Fprintf(&b, "Result: %s\n", cd.Overall.Verdict)
	fmt.Fprintf(&b, "Critical regressions: %d / %d\n", cd.Overall.CriticalRegressions, cd.Overall.MaxCriticalRegressions)
	fmt.Fprintf(&b, "Warning regressions: %d / %d\n", cd.Overall.WarningRegressions, cd.Overall.MaxWarningRegressions)
	return b.String()
}

func runCompare(args []string) int {
	fs := flag.NewFlagSet("compare", flag.ContinueOnError)
	baselinePath := fs.String("baseline", "", "path to baseline manifest")
	candidatePath := fs.String("candidate", "", "path to candidate manifest")
	configPath := fs.String("config", "", "path to regression config")
	outputDir := fs.String("output-dir", "", "directory for output files")
	format := fs.String("format", "both", "output format: md, json, or both")
	excludeMetric := fs.String("exclude-metric", "", "comma-separated list of metric names to exclude from regression analysis")
	split := fs.String("split", "", "comma-separated list of split names to compare")
	if err := fs.Parse(args); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 2
	}
	if *baselinePath == "" || *candidatePath == "" || *configPath == "" || *outputDir == "" {
		fmt.Fprintln(os.Stderr, "--baseline, --candidate, --config, and --output-dir are required")
		return 2
	}
	switch *format {
	case "md", "json", "both":
	default:
		fmt.Fprintf(os.Stderr, "invalid --format %q; must be md, json, or both\n", *format)
		return 2
	}
	excludedMetrics := make(map[string]bool)
	if *excludeMetric != "" {
		for _, name := range strings.Split(*excludeMetric, ",") {
			name = strings.TrimSpace(name)
			if name == "" {
				continue
			}
			excludedMetrics[name] = true
		}
	}
	var selectedSplits []string
	if *split != "" {
		for _, name := range strings.Split(*split, ",") {
			name = strings.TrimSpace(name)
			if name == "" {
				fmt.Fprintln(os.Stderr, "--split contains empty split names")
				return 2
[?2004hroot@n30009:/app# sed -n '1260,1330p' main.go
[?2004l				return 2
			}
			selectedSplits = append(selectedSplits, name)
		}
		seen := make(map[string]bool)
		for _, name := range selectedSplits {
			if seen[name] {
				fmt.Fprintf(os.Stderr, "--split contains duplicate split name %q\n", name)
				return 2
			}
			seen[name] = true
		}
	}
	baseline, err := loadManifest(*baselinePath)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 2
	}
	candidate, err := loadManifest(*candidatePath)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 2
	}
	cfg, err := loadRegressionConfig(*configPath)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 2
	}
	cd, err := buildComparisonData(baseline, candidate, cfg, excludedMetrics, selectedSplits)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 2
	}
	if err := os.MkdirAll(*outputDir, 0755); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 2
	}
	if *format == "md" || *format == "both" {
		md := buildComparisonMarkdown(cd)
		if err := writeFile(filepath.Join(*outputDir, "comparison.md"), []byte(md)); err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 2
		}
	}
	if *format == "json" || *format == "both" {
		data, err := json.MarshalIndent(cd, "", "  ")
		if err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 2
		}
		if err := writeFile(filepath.Join(*outputDir, "comparison.json"), append(data, '\n')); err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 2
		}
	}
	if cd.Overall.Verdict == "FAIL" {
		return 1
	}
	return 0
}

func primaryMetricsForTask(taskType string) []string {
	switch taskType {
	case "binary_classification":
		return []string{"accuracy", "f1", "auc_roc"}
	case "multiclass_classification":
		return []string{"accuracy", "f1_macro"}
	case "regression":
		return []string{"rmse", "mae", "r_squared"}
	default:
		return nil
[?2004hroot@n30009:/app# sed -n '1321,1420p' main.go
[?2004lfunc primaryMetricsForTask(taskType string) []string {
	switch taskType {
	case "binary_classification":
		return []string{"accuracy", "f1", "auc_roc"}
	case "multiclass_classification":
		return []string{"accuracy", "f1_macro"}
	case "regression":
		return []string{"rmse", "mae", "r_squared"}
	default:
		return nil
	}
}

func runSummary(args []string) int {
	fs := flag.NewFlagSet("summary", flag.ContinueOnError)
	reportPath := fs.String("report", "report.json", "path to evaluation report JSON")
	if err := fs.Parse(args); err != nil {
		return 2
	}

	data, err := os.ReadFile(*reportPath)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 2
	}

	var report ReportJSON
	if err := json.Unmarshal(data, &report); err != nil {
		fmt.Fprintf(os.Stderr, "failed to parse report: %v\n", err)
		return 2
	}

	primary := primaryMetricsForTask(report.Model.TaskType)
	if primary == nil {
		fmt.Fprintf(os.Stderr, "unknown task type %q\n", report.Model.TaskType)
		return 2
	}
	if len(report.Splits) == 0 {
		fmt.Fprintln(os.Stderr, "report contains no splits")
		return 2
	}

	metricValues := make([]string, 0, len(primary))
	for _, metric := range primary {
		vals := make([]float64, 0, len(report.Splits))
		for _, split := range report.Splits {
			if v, ok := split.Metrics[metric]; ok {
				vals = append(vals, v)
			}
		}
		if len(vals) == 0 {
			continue
		}
		avg := mean(vals)
		metricValues = append(metricValues, fmt.Sprintf("%s=%.4f", metric, avg))
	}

	fmt.Printf("%s v%s (%s) — %d split(s): %s\n",
		report.Model.Name,
		report.Model.Version,
		report.Model.TaskType,
		len(report.Splits),
		strings.Join(metricValues, ", "))
	return 0
}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: mlreport <evaluate|compare|summary> ...")
		os.Exit(2)
	}
	var code int
	switch os.Args[1] {
	case "evaluate":
		code = runEvaluate(os.Args[2:])
	case "compare":
		code = runCompare(os.Args[2:])
	case "summary":
		code = runSummary(os.Args[2:])
	default:
		fmt.Fprintf(os.Stderr, "unknown command %q\n", os.Args[1])
		code = 2
	}
	os.Exit(code)
}
