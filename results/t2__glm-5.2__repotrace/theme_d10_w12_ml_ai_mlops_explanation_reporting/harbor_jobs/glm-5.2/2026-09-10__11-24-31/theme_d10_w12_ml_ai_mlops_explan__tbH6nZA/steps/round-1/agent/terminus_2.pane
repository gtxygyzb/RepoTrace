   778	func buildEvaluateMarkdown(report ReportJSON, nm NormManifest, bootstrap int) string {
   779		var b strings.Builder
   780		fmt.Fprintf(&b, "# Evaluation Report: %s v%s\n\n", nm.Model.Name, nm.Model.Version)
   781		fmt.Fprintf(&b, "Task type: %s\n\n", nm.Model.TaskType)
   782		fmt.Fprintf(&b, "## Summary\n\n")
   783		headers := []string{"Metric"}
   784		for _, ev := range nm.Evaluations {
   785			headers = append(headers, ev.Split)
   786		}
   787		fmt.Fprintln(&b, "| "+strings.Join(headers, " | ")+" |")
   788		sep := []string{"--------"}
   789		for range nm.Evaluations {
   790			sep = append(sep, "-----------")
   791		}
   792		fmt.Fprintln(&b, "| "+strings.Join(sep, " | ")+" |")
   793		for _, metric := range metricOrderForTask(nm.Model.TaskType) {
   794			row := []string{metric}
   795			for _, ev := range nm.Evaluations {
   796				sr := report.Splits[ev.Split]
   797				val := formatFloat6(sr.Metrics[metric])
   798				if bootstrap > 0 {
   799					if ci, ok := sr.ConfidenceIntervals[metric]; ok {
   800						val = fmt.Sprintf("%s [%s, %s]", val, formatFloat6(ci.Lower), formatFloat6(ci.Upper))
   801					}
   802				}
   803				row = append(row, val)
   804			}
   805			fmt.Fprintln(&b, "| "+strings.Join(row, " | ")+" |")
   806		}
   807		fmt.Fprintln(&b)
   808		for _, ev := range nm.Evaluations {
   809			sr := report.Splits[ev.Split]
   810			fmt.Fprintf(&b, "## Split: %s\n\n", ev.Split)
   811			fmt.Fprintf(&b, "### Dataset\n%s\n\n", ev.Dataset)
   812			fmt.Fprintf(&b, "### Metrics\n\n")
   813			fmt.Fprintln(&b, "| Metric | Value |")
   814			fmt.Fprintln(&b, "|--------|-------|")
   815			for _, metric := range metricOrderForTask(nm.Model.TaskType) {
   816				fmt.Fprintf(&b, "| %s | %s |\n", metric, formatFloat6(sr.Metrics[metric]))
   817			}
   818			fmt.Fprintln(&b)
   819			if nm.Model.TaskType != "regression" && sr.ConfusionMatrix != nil {
   820				fmt.Fprintf(&b, "### Confusion Matrix\n\n")
   821				classes := sr.ConfusionMatrix.Classes
   822				header := []string{""}
   823				for _, c := range classes {
   824					header = append(header, "Predicted: "+c)
   825				}
   826				fmt.Fprintln(&b, "| "+strings.Join(header, " | ")+" |")
   827				sep := []string{"--"}
   828				for range classes {
   829					sep = append(sep, "---------------------")
   830				}
   831				fmt.Fprintln(&b, "| "+strings.Join(sep, " | ")+" |")
   832				for i, c := range classes {
   833					row := []string{"Actual: " + c}
   834					for _, count := range sr.ConfusionMatrix.Matrix[i] {
   835						row = append(row, strconv.Itoa(count))
   836					}
   837					fmt.Fprintln(&b, "| "+strings.Join(row, " | ")+" |")
   838				}
   839				fmt.Fprintln(&b)
   840			}
   841			if nm.Model.TaskType == "multiclass_classification" && len(sr.PerClassMetrics) > 0 {
   842				fmt.Fprintf(&b, "### Per-Class Metrics\n\n")
   843				fmt.Fprintln(&b, "| Class | Precision | Recall | F1 | Support |")
   844				fmt.Fprintln(&b, "|-------|-----------|--------|----|---------|")
   845				classes := make([]string, 0, len(sr.PerClassMetrics))
   846				for c := range sr.PerClassMetrics {
   847					classes = append(classes, c)
   848				}
   849				sortClasses(classes)
   850				for _, c := range classes {
   851					pm := sr.PerClassMetrics[c]
   852					fmt.Fprintf(&b, "| %s | %s | %s | %s | %d |\n", c, formatFloat6(pm.Precision), formatFloat6(pm.Recall), formatFloat6(pm.F1), pm.Support)
   853				}
   854				fmt.Fprintln(&b)
   855			}
   856			if bootstrap > 0 && len(sr.ConfidenceIntervals) > 0 {
   857				fmt.Fprintf(&b, "### Confidence Intervals\n\n")
   858				fmt.Fprintln(&b, "| Metric | Lower | Upper |")
   859				fmt.Fprintln(&b, "|--------|-------|-------|")
   860				for _, metric := range ciMetricsForTask(nm.Model.TaskType) {
   861					if ci, ok := sr.ConfidenceIntervals[metric]; ok {
   862						fmt.Fprintf(&b, "| %s | %s | %s |\n", metric, formatFloat6(ci.Lower), formatFloat6(ci.Upper))
   863					}
   864				}
   865				fmt.Fprintln(&b)
   866			}
   867		}
   868		return b.String()
   869	}
