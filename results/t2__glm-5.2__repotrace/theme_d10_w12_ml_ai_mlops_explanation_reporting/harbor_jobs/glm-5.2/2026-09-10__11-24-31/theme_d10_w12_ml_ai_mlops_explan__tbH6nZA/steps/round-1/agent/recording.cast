[4396.027277, "o", "\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn NormManifest{}, fmt.Errorf(\"%s: invalid task_type %q\", path, raw.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K == \"\" {\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif splits[ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K] {\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: duplicate split name %q\", path, ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tsplits[ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K] = true\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: dataset is required for split %q\", path, ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: split %q must have at least one prediction\", path, ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tne := NormEvaluation{\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K: ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K, Dataset: ev.Dataset}\r\n"]
