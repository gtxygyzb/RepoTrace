[4272.683432, "o", "\"task_type\": \"regression\",\r\n    \"deltas\": {\r\n        \"test\": {\r\n            \"mae\": {\r\n                \"baseline\": 1,\r\n                \"candidate\": 1.5,\r\n                \"absolute_delta\": 0.5,\r\n                \"relative_delta\": 0.5\r\n            },\r\n            \"mse\": {\r\n                \"baseline\": 2,\r\n                \"candidate\": 4.5,\r\n                \"absolute_delta\": 2.5,\r\n                \"relative_delta\": 1.25\r\n            },\r\n            \"r_squared\": {\r\n                "]
[4272.683521, "o", "\"baseline\": -7,\r\n                \"candidate\": -17,\r\n                \"absolute_delta\": -10,\r\n                \"relative_delta\": -1.428571\r\n            },\r\n            \"rmse\": {\r\n                \"baseline\": 1.414214,\r\n                \"candidate\": 2.12132,\r\n                \"absolute_delta\": 0.707107,\r\n                \"relative_delta\": 0.5\r\n            },\r\n            \"smape\": {\r\n                \"baseline\": 100,\r\n                \"candidate\": 120,\r\n                \"absolute_delta\": 20,\r\n                \"relative_delta\": 0.2\r\n            }\r\n        },\r\n        \"train\": {\r\n            \"mae\": {\r\n                \"baseline\": 0.5,\r\n                \"candidate\": 0,\r\n                "]
[4272.683694, "o", "\"absolute_delta\": -0.5,\r\n                \"relative_delta\": -1\r\n            },\r\n            \"mse\": {\r\n                \"baseline\": 0.5,\r\n                \"candidate\": 0,\r\n                \"absolute_delta\": -0.5,\r\n                \"relative_delta\": -1\r\n            },\r\n            \"r_squared\": {\r\n                \"baseline\": -1,\r\n                \"candidate\": 1,\r\n                \"absolute_delta\": 2,\r\n                \"relative_delta\": 2\r\n            },\r\n            \"rmse\": {\r\n                \"baseline\": 0.707107,\r\n                \"candidate\": 0,\r\n                \"absolute_delta\": -0.707107,\r\n                \"relative_delta\": -1\r\n            },\r\n            \"smape\": {\r\n                \"baseline\": 66.666667,\r\n                \"candidate\": 0,\r\n                \"absolute_delta\": -66.666667,\r\n                \"relative_delta\": -1\r\n            }\r\n        }\r\n    },\r\n    \"regression_analysis\": {\r\n        \"mse\": {\r\n            \"severity\": \"critical\",\r\n            \"direction\": \"lower-is-better\",\r\n            \"regressed_splits\": [\r\n"]
[4272.683805, "o", "                \"test\"\r\n            ],\r\n            \"verdict\": \"REGRESSED\"\r\n        },\r\n        \"r_squared\": {\r\n            \"severity\": \"warning\",\r\n            \"direction\": \"higher-is-better\",\r\n            \"regressed_splits\": [\r\n                \"test\"\r\n            ],\r\n            \"verdict\": \"REGRESSED\"\r\n        }\r\n    },\r\n    \"overall\": {\r\n        \"verdict\": \"FAIL\",\r\n        \"critical_regressions\": 1,\r\n        \"max_critical_regressions\": 0,\r\n        \"warning_regressions\": 1,\r\n        \"max_warning_regressions\": 0\r\n    }\r\n}\r\n"]
