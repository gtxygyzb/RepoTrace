[4683.94204, "o", "\t}\r\n\treturn i\r\n}\r\n\r\nfunc metricOrderForTask(taskType string) []string {\r\n\tswitch taskType {\r\n\tcase \"binary_classification\":\r\n\t\treturn []string{\"accuracy\", \"precision\", \"recall\", \"f1\", \"auc_roc\", \"log_loss\"}\r\n\tcase \"multiclass_classification\":\r\n\t\treturn []string{\"accuracy\", \"precision_micro\", \"recall_micro\", \"f1_micro\", \"precision_macro\", \"recall_macro\", \"f1_macro\", \"precision_weighted\", \"recall_weighted\", \"f1_weighted\"}\r\n\tcase \"regression\":\r\n\t\treturn []string{\"mse\", \"rmse\", \"mae\", \"r_squared\", \"smape\"}\r\n\tdefault:\r\n\t\treturn nil\r\n\t}\r\n}\r\n\r\nfunc ciMetricsForTask(taskType string) []string {\r\n\tswitch taskType {\r\n\tcase \"binary_classification\":\r\n\t\treturn []string{\"accuracy\", \"precision\", \"recall\", \"f1\", \"auc_roc\"}\r\n\tcase \"multiclass_classification\":\r\n\t\treturn []string{\"accuracy\", \"f1_macro\", \"f1_weighted\"}\r\n\tcase \"regression\":\r\n\t\treturn []string{\"mse\", \"rmse\", \"mae\", \"r_squared\"}\r\n\tdefault:\r\n\t\treturn nil\r\n"]
[4683.942145, "o", "\t}\r\n}\r\n\r\nfunc sortClasses(classes []string) {\r\n\tsort.Slice(classes, func(i, j int) bool {\r\n\t\tai := strings.ToLower(classes[i])\r\n\t\taj := strings.ToLower(classes[j])\r\n\t\tif ai != aj {\r\n\t\t\treturn ai < aj\r\n"]
