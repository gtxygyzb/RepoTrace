[3671.720694, "o", "    13\t\t\"strconv\"\r\n    14\t\t\"strings\"\r\n    15\t)\r\n    16\t\r\n    17\tvar validModelName = regexp.MustCompile(`^[A-Za-z0-9-]+$`)\r\n    18\tvar validVersion = regexp.MustCompile(`^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$`)\r\n    19\t\r\n    20\ttype Manifest struct {\r\n    21\t\tModel       Model           `json:\"model\"`\r\n    22\t\tEvaluations []RawEvaluation `json:\"evaluations\"`\r\n    23\t}\r\n    24\t\r\n    25\ttype Model struct {\r\n    26\t\tName     string `json:\"name\"`\r\n    27\t\tVersion  string `json:\"version\"`\r\n    28\t\tTaskType string `json:\"task_type\"`\r\n    29\t}\r\n    30\t\r\n"]
