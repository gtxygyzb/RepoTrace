[4388.633415, "o", "\t\t\treturn 2\r\n\t\t\t}\r\n\t\t\tsplits = append(splits, name)\r\n\t\t}\r\n\t\tsplitSet := make(map[string]bool)\r\n\t\tfor _, name := range splits {\r\n\t\t\tsplitSet[name] = true\r\n\t\t}\r\n\t\tfor _, name := range splits {\r\n\t\t\tfound := false\r\n"]
[4388.633471, "o", "\t\t\tfor _, ev := range nm.Evaluations {\r\n\t\t\t\tif ev.Split == name {\r\n\t\t\t\t\tfound = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !found {\r\n\t\t\t\t"]
[4388.633533, "o", "fmt.Fprintf(os.Stderr, \"split %q not found in manifest\\n\", name)\r\n\t\t\t\treturn 2\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treport := buildReportJSON(nm, splits, *bootstrap, *confidence, *seed)\r\n\tif err := os.MkdirAll(*outputDir, 0755); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 2\r\n\t}\r\n\t"]
[4388.63359, "o", "if *format == \"md\" || *format == \"both\" {\r\n\t\tmd := buildEvaluateMarkdown(report, nm, splits, *bootstrap)\r\n\t\tif err := writeFile(filepath.Join(*outputDir, \"report.md\"), []byte(md)); err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t}\r\n\tif *format == \"json\" || *format == \"both\" {\r\n\t\tdata, err := json.MarshalIndent(report, \"\", \"  \")\r\n"]
