[3651.182929, "o", "grep -R \"func .*Compare\\|func .*Evaluate\\|RegressionConfig\\|min_absolute_delta\\|min_relative_delta\\|max_delta\\|max_relative_delta\\|direction\\|--split\" -n --include='*.go' .\r\n\u001b[?2004l\r"]
