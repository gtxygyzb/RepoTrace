[4406.062576, "o", "\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: dataset is required for split %q\", path, ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: split %q must have at least one prediction\", path, ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tne := NormEvaluation{\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K: ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K, Dataset: ev.Dataset}\r\n\u001b[32m\u001b[K334\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: prediction id is required in split %q\", path, ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K)\r\n"]
[4406.062632, "o", "\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: duplicate prediction id %q in split %q\", path, rp.ID, ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K340\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tnp, err := normalizePrediction(path, ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K, rp, raw.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tnm.\u001b[01;31m\u001b[KEvaluations\u001b[m\u001b[K = append(nm.\u001b[01;31m\u001b[KEvaluations\u001b[m\u001b[K, ne)\r\n"]
[4406.062695, "o", "\u001b[32m\u001b[K455\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc compute\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K(taskType string, preds []NormPrediction) EvalResult {\r\n\u001b[32m\u001b[K464\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn EvalResult{\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K: map[string]float64{}, MetricOrder: metricOrderForTask(taskType)}\r\n"]
[4406.062752, "o", "\u001b[32m\u001b[K471\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn EvalResult{\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K: zero\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K(metricOrderForTask(\"binary_classification\")), MetricOrder: metricOrderForTask(\"binary_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}\r\n\u001b[32m\u001b[K504\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn EvalResult{\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K: metrics, MetricOrder: metricOrderForTask(\"binary_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}\r\n"]
[4406.06281, "o", "\u001b[32m\u001b[K607\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn EvalResult{\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K: zero\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K(metricOrderForTask(\"multiclass_classification\")), MetricOrder: metricOrderForTask(\"multiclass_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}\r\n\u001b[32m\u001b[K649\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tperClass\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K := make(map[string]PerClassMetric)\r\n\u001b[32m\u001b[K659\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tperClass\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[c] = PerClassMetric{Precision: precisions[i], Recall: recalls[i], F1: f1s[i], Support: pc.support}\r\n"]
