[3721.109624, "o", "   981\t\t}\r\n   982\t\tfor _, ev := range baseline.Evaluations {\r\n   983\t\t\tcd.SplitOrder = append(cd.SplitOrder, ev.Split)\r\n   984\t\t}\r\n   985\t\tfor _, metric := range metricOrder {\r\n   986\t\t\tif _, ok := cfg.Thresholds[metric]; ok {\r\n   987\t\t\t\tcd.RegressionMetrics = append(cd.RegressionMetrics, metric)\r\n   988\t\t\t}\r\n   989\t"]
[3721.109681, "o", "\t}\r\n   990\t\tbaseResults := make(map[string]EvalResult)\r\n   991\t\tcandResults := make(map[string]EvalResult)\r\n   992\t\tfor _, ev := range baseline.Evaluations {\r\n   993\t\t\tbaseResults[ev.Split] = computeMetrics(taskType, ev.Predictions)\r\n"]
