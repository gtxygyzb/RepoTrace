[1871.786742, "o", "./docs/spec_v1.md\r\n./docs/spec_v2.md\r\n./docs/spec_v3.md\r\n./docs/spec_v4.md\r\n./docs/spec_v5.md\r\n./docs/spec_v6.md\r\n./docs/spec_v7.md\r\n./go.mod\r\n./main.go\r\n"]
