[4743.785677, "o", "  1028\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n  1029\t\t\t\treturn 2\r\n  1030\t\t\t}\r\n  1031\t\t}\r\n  1032\t\treturn 0\r\n"]
