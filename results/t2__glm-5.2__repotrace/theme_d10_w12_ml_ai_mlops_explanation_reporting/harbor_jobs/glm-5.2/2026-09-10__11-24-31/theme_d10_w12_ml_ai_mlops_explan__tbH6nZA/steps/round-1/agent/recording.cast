[3941.053371, "o", "\\t\\treturn \"lower-is-better\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.053421, "o", "\\tdefault:\r\n\u001b[?2004l\r]No\u001b[?2004h"]
[3941.053476, "o", "> "]
[3941.053529, "o", "\\t\\treturn \"higher-is-better\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.053589, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[3941.053643, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r)\u001b[?2004h> "]
[3941.053782, "o", "func thresholdMaxDelta(t Threshold) float64 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.053852, "o", "\\tif t.MaxDelta != nil {\r\n\u001b[?2004l\r"]
[3941.053923, "o", "\u001b[?2004h> "]
[3941.053978, "o", "\\t\\treturn *t.MaxDelta\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.054083, "o", "\\treturn -t.MinAbsoluteDelta\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[3941.05414, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
