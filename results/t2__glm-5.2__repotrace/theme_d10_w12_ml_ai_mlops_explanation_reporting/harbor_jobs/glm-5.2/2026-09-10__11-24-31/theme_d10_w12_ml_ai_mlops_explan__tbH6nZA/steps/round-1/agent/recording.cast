[2822.630575, "o", "func buildEvaluateMarkdown(report ReportJSON, nm NormManifest, bootstrap int) string {\r\n\u001b[?2004l\r"]
[2822.63064, "o", "\u001b[?2004h> "]
[2822.630749, "o", "    var b strings.Builder\r\n\u001b[?2004l\r"]
[2822.630814, "o", "\u001b[?2004h> "]
[2822.631251, "o", "    fmt.Fprintf(&b, \"# Evaluation Report: %s v%s\\n\\n\", nm.Model.Name, nm.Model.Version)\r\n\u001b[?2004l\r"]
[2822.631315, "o", "\u001b[?2004h> "]
[2822.631613, "o", "    fmt.Fprintf(&b, \"Task type: %s\\n\\n\", nm.Model.TaskType)\r\n\u001b[?2004l\r"]
[2822.631677, "o", "\u001b[?2004h> "]
[2822.631844, "o", "    fmt.Fprintf(&b, \"## Summary\\n\\n\")\r\n\u001b[?2004l\r"]
[2822.631917, "o", "\u001b[?2004h> "]
[2822.63207, "o", "    headers := []string{\"Metric\"}\r\n\u001b[?2004l\r"]
[2822.632133, "o", "\u001b[?2004h> "]
[2822.632316, "o", "    for _, ev := range nm.Evaluations {\r\n\u001b[?2004l\r"]
[2822.632379, "o", "\u001b[?2004h> "]
[2822.632585, "o", "        headers = append(headers, ev.Split)\r\n\u001b[?2004l\r"]
[2822.632648, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[2822.632711, "o", "\u001b[?2004h> "]
[2822.63303, "o", "    fmt.Fprintln(&b, \"| \"+strings.Join(headers, \" | \")+\" |\")\r\n\u001b[?2004l\r"]
[2822.633097, "o", "\u001b[?2004h> "]
[2822.633235, "o", "    sep := []string{\"--------\"}\r\n\u001b[?2004l\r"]
[2822.6333, "o", "\u001b[?2004h> "]
[2822.633437, "o", "    for range nm.Evaluations {\r\n\u001b[?2004l\r"]
[2822.633472, "o", "\u001b[?2004h> "]
[2822.633718, "o", "        sep = append(sep, \"-----------\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.633798, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.634127, "o", "    fmt.Fprintln(&b, \"| \"+strings.Join(sep, \" | \")+\" |\")\r\n\u001b[?2004l\r"]
[2822.634187, "o", "\u001b[?2004h> "]
[2822.634517, "o", "    for _, metric := range metricOrderForTask(nm.Model.TaskType) {\r\n\u001b[?2004l\r"]
[2822.634574, "o", "\u001b[?2004h> "]
[2822.634732, "o", "        row := []string{metric}\r\n\u001b[?2004l\r"]
[2822.634787, "o", "\u001b[?2004h> "]
[2822.635015, "o", "        for _, ev := range nm.Evaluations {\r\n\u001b[?2004l\r"]
[2822.635071, "o", "\u001b[?2004h> "]
[2822.635287, "o", "            sr := report.Splits[ev.Split]\r\n\u001b[?2004l\r"]
[2822.635342, "o", "\u001b[?2004h> "]
[2822.635598, "o", "            val := formatFloat6(sr.Metrics[metric])\r\n\u001b[?2004l\r"]
[2822.635653, "o", "\u001b[?2004h> "]
[2822.63575, "o", "            if bootstrap > 0 {\r\n\u001b[?2004l\r"]
[2822.635805, "o", "\u001b[?2004h> "]
[2822.636023, "o", "                if ci, ok := sr.ConfidenceIntervals[metric]; ok {\r\n\u001b[?2004l\r"]
[2822.636081, "o", "\u001b[?2004h> "]
[2822.636442, "o", "                    val = fmt.Sprintf(\"%s [%s, %s]\", val, formatFloat6(ci.Lower), formatFloat6(ci.Upper))\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.636498, "o", "> "]
[2822.636551, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.636623, "o", "            }\r\n\u001b[?2004l\r"]
[2822.63669, "o", "\u001b[?2004h> "]
[2822.636782, "o", "            row = append(row, val)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.636835, "o", ">         }\r\n\u001b[?2004l\rs"]
[2822.63691, "o", "\u001b[?2004h> "]
[2822.637101, "o", "        fmt.Fprintln(&b, \"| \"+strings.Join(row, \" | \")+\" |\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.637155, "o", ">     }\r\n\u001b[?2004l\r"]
[2822.637209, "o", "\u001b[?2004h> "]
[2822.637264, "o", "    fmt.Fprintln(&b)\r\n\u001b[?2004l\r"]
[2822.637317, "o", "\u001b[?2004h> "]
[2822.63745, "o", "    for _, ev := range nm.Evaluations {\r\n\u001b[?2004l\r"]
[2822.637505, "o", "\u001b[?2004h> "]
[2822.637616, "o", "        sr := report.Splits[ev.Split]\r\n\u001b[?2004l\r"]
[2822.637671, "o", "\u001b[?2004h> "]
[2822.637856, "o", "        fmt.Fprintf(&b, \"## Split: %s\\n\\n\", ev.Split)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.637916, "o", "> "]
[2822.638099, "o", "        fmt.Fprintf(&b, \"### Dataset\\n%s\\n\\n\", ev.Dataset)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.638153, "o", "> "]
[2822.638282, "o", "        fmt.Fprintf(&b, \"### Metrics\\n\\n\")\r\n\u001b[?2004l\r"]
[2822.638337, "o", "\u001b[?2004h> "]
[2822.638488, "o", "        fmt.Fprintln(&b, \"| Metric | Value |\")\r\n\u001b[?2004l\r"]
[2822.638543, "o", "\u001b[?2004h> "]
[2822.638686, "o", "        fmt.Fprintln(&b, \"|--------|-------|\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.638739, "o", "> "]
[2822.638965, "o", "        for _, metric := range metricOrderForTask(nm.Model.TaskType) {\r\n\u001b[?2004l\r"]
[2822.639022, "o", "\u001b[?2004h> "]
[2822.639302, "o", "            fmt.Fprintf(&b, \"| %s | %s |\\n\", metric, formatFloat6(sr.Metrics[metric]))\r\n\u001b[?2004l\r"]
[2822.639358, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[2822.639413, "o", "\u001b[?2004h> "]
[2822.639496, "o", "        fmt.Fprintln(&b)\r\n\u001b[?2004l\r"]
[2822.639541, "o", "\u001b[?2004h> "]
[2822.639794, "o", "        if nm.Model.TaskType != \"regression\" && sr.ConfusionMatrix != nil {\r\n\u001b[?2004l\r"]
[2822.639848, "o", "\u001b[?2004h> "]
[2822.640033, "o", "            fmt.Fprintf(&b, \"### Confusion Matrix\\n\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.640088, "o", "> "]
[2822.640234, "o", "            classes := sr.ConfusionMatrix.Classes\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.640288, "o", "> "]
[2822.64039, "o", "            header := []string{\"\"}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.640445, "o", "> "]
[2822.640565, "o", "            for _, c := range classes {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.640618, "o", "> "]
[2822.640807, "o", "                header = append(header, \"Predicted: \"+c)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.64086, "o", "> "]
[2822.640924, "o", "            }\r\n\u001b[?2004l\rl\u001b[?2004h> "]
[2822.641176, "o", "            fmt.Fprintln(&b, \"| \"+strings.Join(header, \" | \")+\" |\")\r\n\u001b[?2004l\r"]
[2822.64123, "o", "\u001b[?2004h> "]
[2822.641324, "o", "            sep := []string{\"--\"}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.641378, "o", "> "]
[2822.641466, "o", "            for range classes {\r\n\u001b[?2004l\r"]
[2822.64152, "o", "\u001b[?2004h> "]
[2822.641701, "o", "                sep = append(sep, \"---------------------\")\r\n\u001b[?2004l\r"]
[2822.641756, "o", "\u001b[?2004h> "]
[2822.641811, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.642029, "o", "            fmt.Fprintln(&b, \"| \"+strings.Join(sep, \" | \")+\" |\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.642084, "o", "> "]
[2822.642165, "o", "            for i, c := range classes {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.64222, "o", "> "]
[2822.642321, "o", "                row := []string{\"Actual: \" + c}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.642376, "o", "> "]
[2822.642534, "o", "                for _, count := range sr.ConfusionMatrix.Matrix[i] {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.64259, "o", "> "]
[2822.642723, "o", "                    row = append(row, strconv.Itoa(count))\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.642776, "o", "> "]
[2822.642829, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.643014, "o", "                fmt.Fprintln(&b, \"| \"+strings.Join(row, \" | \")+\" |\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.643071, "o", ">             }\r\n\u001b[?2004l\r"]
[2822.643126, "o", "\u001b[?2004h> "]
[2822.643188, "o", "            fmt.Fprintln(&b)\r\n\u001b[?2004l\r"]
[2822.643243, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[2822.643298, "o", "\u001b[?2004h> "]
[2822.643528, "o", "        if nm.Model.TaskType == \"multiclass_classification\" && len(sr.PerClassMetrics) > 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.643583, "o", "> "]
[2822.643709, "o", "            fmt.Fprintf(&b, \"### Per-Class Metrics\\n\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.643763, "o", "> "]
[2822.64395, "o", "            fmt.Fprintln(&b, \"| Class | Precision | Recall | F1 | Support |\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.644181, "o", "            fmt.Fprintln(&b, \"|-------|-----------|--------|----|---------|\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.644235, "o", "> "]
[2822.644384, "o", "            classes := make([]string, 0, len(sr.PerClassMetrics))\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.64444, "o", "> "]
[2822.644541, "o", "            for c := range sr.PerClassMetrics {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.644597, "o", "> "]
[2822.644691, "o", "                classes = append(classes, c)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.644745, "o", ">             }\r\n\u001b[?2004l\r"]
[2822.6448, "o", "\u001b[?2004h> "]
[2822.644884, "o", "            sortClasses(classes)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.645016, "o", "            for _, c := range classes {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.645159, "o", "                pm := sr.PerClassMetrics[c]\r\n\u001b[?2004l\r\u001b[?2004h"]
[2822.645215, "o", "> "]
[2822.645556, "o", "                fmt.Fprintf(&b, \"| %s | %s | %s | %s | %d |\\n\", c, formatFloat6(pm.Precision), formatFloat6(pm.Recall), formatFloat6(pm.F1), pm.Support)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.64561, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.645677, "o", "            fmt.Fprintln(&b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.645737, "o", "        }\r\n\u001b[?2004l\r"]
[2822.645792, "o", "\u001b[?2004h> "]
[2822.645843, "o", "        if bootstrap > 0 && len(sr.ConfidenceIntervals) > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.64597, "o", "            fmt.Fprintf(&b, \"### Confidence Intervals\\n\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.64609, "o", "            fmt.Fprintln(&b, \"| Metric | Lower | Upper |\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.646213, "o", "            fmt.Fprintln(&b, \"|--------|-------|-------|\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.646358, "o", "            for _, metric := range ciMetricsForTask(nm.Model.TaskType) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.646492, "o", "                if ci, ok := sr.ConfidenceIntervals[metric]; ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.646704, "o", "                    fmt.Fprintf(&b, \"| %s | %s | %s |\\n\", metric, formatFloat6(ci.Lower), formatFloat6(ci.Upper))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.646757, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.646816, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.646873, "o", "            fmt.Fprintln(&b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.64694, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.647005, "o", "    return b.String()\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[2822.647061, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.647154, "o", "func writeFile(path string, data []byte) error {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.647248, "o", "    return os.WriteFile(path, data, 0644)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.647303, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.647377, "o", "func runEvaluate(args []string) int {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.647503, "o", "    fs := flag.NewFlagSet(\"evaluate\", flag.ContinueOnError)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.647666, "o", "    manifest := fs.String(\"manifest\", \"\", \"path to evaluation manifest JSON file\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.647815, "o", "    outputDir := fs.String(\"output-dir\", \"\", \"directory for output files\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.647974, "o", "    format := fs.String(\"format\", \"both\", \"output format: md, json, or both\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.648128, "o", "    bootstrap := fs.Int(\"bootstrap\", 1000, \"number of bootstrap iterations\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.648268, "o", "    confidence := fs.Float64(\"confidence\", 0.95, \"confidence level\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.648371, "o", "    seed := fs.Int64(\"seed\", 42, \"random seed\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.648465, "o", "    if err := fs.Parse(args); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.648551, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.648603, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.648658, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.648714, "o", "    if *manifest == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.648817, "o", "        fmt.Fprintln(os.Stderr, \"--manifest is required\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.648868, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.648936, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.648992, "o", "    if *outputDir == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.649095, "o", "        fmt.Fprintln(os.Stderr, \"--output-dir is required\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.649146, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.649199, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.649253, "o", "    switch *format {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.649305, "o", "    case \"md\", \"json\", \"both\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.64935, "o", "    default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.649526, "o", "        fmt.Fprintf(os.Stderr, \"invalid --format %q; must be md, json, or both\\n\", *format)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.649577, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.64963, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.649683, "o", "    if *bootstrap < 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.649807, "o", "        fmt.Fprintln(os.Stderr, \"--bootstrap must be non-negative\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.649856, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.649925, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.649988, "o", "    if *confidence <= 0 || *confidence >= 1 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.650123, "o", "        fmt.Fprintln(os.Stderr, \"--confidence must be in (0, 1)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.650171, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.650225, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.650288, "o", "    nm, err := loadManifest(*manifest)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.650344, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.650425, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.650475, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.650529, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.650639, "o", "    report := buildReportJSON(nm, *bootstrap, *confidence, *seed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.650758, "o", "    if err := os.MkdirAll(*outputDir, 0755); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.650844, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2822.650912, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
