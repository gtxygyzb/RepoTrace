[3663.672337, "o", "   155\t\r\n   156\tfunc round6(x float64) float64 {\r\n   157\t\tif math.IsNaN(x) || math.IsInf(x, 0) {\r\n   158\t\t\treturn 0\r\n   159\t\t}\r\n   160\t\tr := math.Round(x*1e6) / 1e6\r\n   161\t\tif r == 0 {\r\n   162\t\t\tr = 0\r\n   163\t\t}\r\n   164\t\treturn r\r\n   165\t}\r\n   166\t\r\n   167\tfunc formatFloat6(x float64) string {\r\n   168\t\treturn strconv.FormatFloat(round6(x), 'f', 6, 64)\r\n   169\t}\r\n   170\t\r\n   171\tfunc formatFloat2(x float64) string {\r\n   172\t\treturn strconv.FormatFloat(math.Round(x*100)/100, 'f', 2, 64)\r\n   173\t}\r\n   174\t\r\n   175\tfunc safeDiv(num, den float64) float64 {\r\n   176\t\tif den == 0 {\r\n   177\t\t\treturn 0\r\n   178\t\t}\r\n"]
[3663.672396, "o", "   179\t\treturn num / den\r\n   180\t}\r\n   181\t\r\n   182\tfunc safeDivInt(num, den int) float64 {\r\n   183\t\tif den == 0 {\r\n   184\t\t\treturn 0\r\n   185\t\t}\r\n   186\t\treturn float64(num) / float64(den)\r\n   187\t}\r\n   188\t\r\n   189\tfunc mean(vals []float64) float64 {\r\n"]
[3663.672462, "o", "   190\t\tif len(vals) == 0 {\r\n   191\t\t\treturn 0\r\n   192\t\t}\r\n   193\t\tsum := 0.0\r\n   194\t\tfor _, v := range vals {\r\n   195\t\t\tsum += v\r\n   196\t\t}\r\n   197\t\treturn sum / float64(len(vals))\r\n   198\t}\r\n   199\t\r\n   200\tfunc weighted(vals []float64, supports []int) float64 {\r\n   201\t\tif len(vals) == 0 {\r\n"]
[3663.672525, "o", "   202\t\t\treturn 0\r\n   203\t\t}\r\n   204\t\tsumVal := 0.0\r\n   205\t\tsumSup := 0\r\n   206\t\tfor i, v := range vals {\r\n   207\t\t\tsumVal += v * float64(supports[i])\r\n   208\t\t\tsumSup += supports[i]\r\n   209\t\t}\r\n   210\t\tif sumSup == 0 {\r\n"]
[3663.672585, "o", "   211\t\t\treturn 0\r\n   212\t\t}\r\n   213\t\treturn sumVal / float64(sumSup)\r\n   214\t}\r\n   215\t\r\n   216\tfunc clampIndex(i, n int) int {\r\n   217\t\tif i < 0 {\r\n   218\t\t\treturn 0\r\n   219\t\t}\r\n   220\t\tif i >= n {\r\n"]
