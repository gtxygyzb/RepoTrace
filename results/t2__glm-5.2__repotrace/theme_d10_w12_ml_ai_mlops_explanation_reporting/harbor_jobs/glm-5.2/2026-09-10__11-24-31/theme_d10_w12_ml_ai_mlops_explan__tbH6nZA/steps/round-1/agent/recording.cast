[3758.520019, "o", "   515\t\t\tauc += (points[i].fpr - points[i-1].fpr) * (points[i].tpr + points[i-1].tpr) / 2\r\n   516\t\t}\r\n   517\t\treturn auc\r\n   518\t}\r\n   519\t\r\n   520\tfunc logLoss(preds []NormPrediction, pos string) float64 {\r\n   521\t\tif len(preds) == 0 {\r\n   522\t\t\treturn 0\r\n   523\t\t}\r\n   524\t\tsum := 0.0\r\n   525"]
