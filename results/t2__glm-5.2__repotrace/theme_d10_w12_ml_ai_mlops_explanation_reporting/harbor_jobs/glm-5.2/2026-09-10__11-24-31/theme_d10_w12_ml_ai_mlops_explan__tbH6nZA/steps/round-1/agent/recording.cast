[5079.509037, "o", "  1035\tfunc buildComparisonData(baseline, candidate NormManifest, cfg RegressionConfig, excludedMetrics map[string]bool) (ComparisonData, error) {\r\n  1036\t\tif baseline.Model.TaskType != candidate.Model.TaskType {\r\n  1037\t\t\treturn ComparisonData{}, fmt.Errorf(\"task type mismatch: baseline %q candidate %q\", baseline.Model.TaskType, candidate.Model.TaskType)\r\n  1038\t\t}\r\n  1039\t\tbaseSplits := make(map[string]bool)\r\n"]
[5079.509138, "o", "  1040\t\tfor _, ev := range baseline.Evaluations {\r\n  1041\t\t\tbaseSplits[ev.Split] = true\r\n  1042\t\t}\r\n  1043\t\tfor _, ev := range candidate.Evaluations {\r\n  1044\t\t\tif !baseSplits[ev.Split] {\r\n  1045\t\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in candidate but not baseline\", ev.Split)\r\n  1046\t\t\t}\r\n  1047"]
[5079.509202, "o", "\t\t}\r\n  1048\t\tfor _, ev := range baseline.Evaluations {\r\n  1049\t\t\tfound := false\r\n  1050\t\t\tfor _, cev := range candidate.Evaluations {\r\n  1051\t\t\t\tif cev.Split == ev.Split {\r\n  1052\t\t\t\t\tfound = true\r\n  1053\t\t\t\t\tbreak\r\n  1054\t\t\t\t}\r\n  1055\t\t\t}\r\n  1056\t\t\tif !found {\r\n  1057\t\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in baseline but not candidate\", ev.Split)\r\n  1058\t\t\t}\r\n  1059\t\t}\r\n  1060\t\ttaskType := baseline.Model.TaskType\r\n  1061\t\tmetricOrder := metricOrderForTask(taskType)\r\n  1062\t\tcd := ComparisonData{\r\n"]
[5079.509269, "o", "  1063\t\t\tBaseline:           ModelRef{Name: baseline.Model.Name, Version: baseline.Model.Version},\r\n  1064\t\t\tCandidate:          ModelRef{Name: candidate.Model.Name, Version: candidate.Model.Version},\r\n  1065\t\t\tTaskType:           taskType,\r\n  1066\t\t\tSplitOrder:         []string{},\r\n  1067\t\t\tMetricOrder:        metricOrder,\r\n  1068\t\t\tDeltas:             make(map[string]map[string]DeltaEntry),\r\n  1069\t\t\tRegressionMetrics:  []string{},\r\n  1070\t\t\tRegressionAnalysis: make(map[string]RegressionAnalysisEntry),\r\n  1071\t\t\tOverall: Overall{\r\n  1072\t\t\t\tVerdict:                \"PASS\",\r\n  1073\t\t\t\t"]
[5079.509334, "o", "MaxCriticalRegressions: cfg.Rules.MaxCriticalRegressions,\r\n  1074\t\t\t\tMaxWarningRegressions:  cfg.Rules.MaxWarningRegressions,\r\n  1075\t\t\t},\r\n"]
