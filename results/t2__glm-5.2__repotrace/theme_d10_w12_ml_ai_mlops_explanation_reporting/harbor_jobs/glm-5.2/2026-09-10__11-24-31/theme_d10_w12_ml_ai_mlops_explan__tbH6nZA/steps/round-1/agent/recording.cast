[2645.555729, "o", "    if !validModelName.MatchString(raw.Model.Name) {\r\n\u001b[?2004l\r"]
[2645.555796, "o", "\u001b[?2004h> "]
[2645.556422, "o", "        return NormManifest{}, fmt.Errorf(\"%s: invalid model name %q\", path, raw.Model.Name)\r\n\u001b[?2004l\r"]
