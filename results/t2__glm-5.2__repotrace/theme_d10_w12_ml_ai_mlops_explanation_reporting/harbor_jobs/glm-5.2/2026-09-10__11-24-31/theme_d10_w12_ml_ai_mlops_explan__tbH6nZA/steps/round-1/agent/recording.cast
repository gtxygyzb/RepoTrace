[5034.278048, "o", "\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KsafeDivInt(num, den int) float64 {\r\n\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[Kmean(vals []float64) float64 {\r\n\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[Kweighted(vals []float64, supports []int) float64 {\r\n\u001b[32m\u001b[K219\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KclampIndex(i, n int) int {\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KmetricOrderForTask(taskType string) []string {\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KciMetricsForTask(taskType string) []string {\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KsortClasses(classes []string) {\r\n\u001b[32m\u001b[K266\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KcollectClasses(preds []NormPrediction, fromActualOnly bool) []string {\r\n\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KreadJSON(path string, v any) error {\r\n\u001b[32m\u001b[K295\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KloadManifest(path string) (NormManifest, error) {\r\n\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kspli"]
[5034.278273, "o", "t\u001b[m\u001b[Ks := make(map[string]bool)\r\n\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K name is required\", path)\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks[ev.Split] {\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: duplicate \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K name %q\", path, ev.Split)\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks[ev.Split] = true\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: dataset is required for \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q\", path, ev.Split)\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q must have at least one prediction\", path, ev.Split)\r\n\u001b[32m\u001b[K334\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: prediction id is required in \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q\", path, ev.Split)\r\n\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: duplicate prediction id %q in \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q\", path"]
[5034.278373, "o", ", rp.ID, ev.Split)\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KnormalizePrediction(path, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K string, rp RawPrediction, taskType string) (NormPrediction, error) {\r\n\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q prediction %q: actual is required\", path, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K, rp.ID)\r\n\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q prediction %q: actual must be a number\", path, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K, rp.ID)\r\n\u001b[32m\u001b[K361\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q prediction %q: predicted must be a number\", path, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K, rp.ID)\r\n\u001b[32m\u001b[K364\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q prediction %q: probabilities must be absent for regression\", path, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K, rp.ID)\r\n\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: \u001b[01;31m\u001b[Ksp"]
