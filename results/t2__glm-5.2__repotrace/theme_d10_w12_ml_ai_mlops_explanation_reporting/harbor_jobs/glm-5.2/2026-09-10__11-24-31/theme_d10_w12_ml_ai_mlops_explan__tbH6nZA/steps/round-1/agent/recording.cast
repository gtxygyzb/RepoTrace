[4705.992449, "o", "   745\t}\r\n   746\t\r\n   747\tfunc computeBootstrapCIs(taskType string, preds []NormPrediction, B int, confidence float64, rng *rand.Rand) map[string]CI {\r\n   748\t\tif B <= 0 {\r\n   749\t\t\treturn nil\r\n   750\t\t}"]
[4705.99249, "o", "\r\n   751\t\tciMetrics := ciMetricsForTask(taskType)\r\n   752\t\tif len(ciMetrics) == 0 {\r\n"]
[4705.992673, "o", "   753\t\t\treturn nil\r\n   754\t\t}\r\n   755\t\tn := len(preds)\r\n   756\t\tvalues := make(map[string][]float64)\r\n   757\t\tfor _, m := range ciMetrics {\r\n   758\t\t\tvalues[m] = make([]float64, 0, B)\r\n   759\t\t}\r\n   760\t\tfor b := 0; b < B; b++ {\r\n   761\t\t\tresample := make([]NormPrediction, n)\r\n   762\t\t\tfor i := 0; i < n; i++ {\r\n   763\t\t\t\tresample[i] = preds[rng.Intn(n)]\r\n   764\t\t\t}\r\n   765\t\t\tres := computeMetrics(taskType, resample)\r\n   766\t\t\tfor _, m := range ciMetrics {\r\n   767\t\t\t\tvalues[m] = append(values[m], res.Metrics[m])\r\n   768\t\t\t}\r\n   769\t\t}\r\n   770\t\tcis := make(map[string]CI)\r\n   771\t\tfor _, m := range ciMetrics {\r\n   772\t\t\tvals := values[m]\r\n   773\t\t\tsort.Float64s(vals)\r\n   774\t\t\tlowerIndex := clampIndex(int(math.Floor((1-confidence)/2*float64(B))), B)\r\n   775\t\t\tupperIndex := clampIndex(int(math.Floor((1+confidence)/2*float64(B)))-1, B)\r\n   776\t\t\tcis[m] = CI{Lower: round6(vals[lowerIndex]), Upper: round6(vals[upperIndex])}\r\n   777\t\t}\r\n   778\t\treturn cis\r\n   779\t}\r\n   780\t\r\n"]
