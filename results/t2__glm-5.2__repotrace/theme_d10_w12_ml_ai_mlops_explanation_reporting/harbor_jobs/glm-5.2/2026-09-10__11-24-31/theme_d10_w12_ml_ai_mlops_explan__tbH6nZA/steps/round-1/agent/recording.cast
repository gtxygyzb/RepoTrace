[4670.663541, "o", "\u001b[32m\u001b[K704\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Ksmape\u001b[m\u001b[KSum += 2 * math.Abs(diff) / denom\r\n\u001b[32m\u001b[K705\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Ksmape\u001b[m\u001b[KCount++\r\n\u001b[32m\u001b[K725\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Ksmape\u001b[m\u001b[K := 0.0\r\n\u001b[32m\u001b[K726\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif \u001b[01;31m\u001b[Ksmape\u001b[m\u001b[KCount > 0 {\r\n\u001b[32m\u001b[K727\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Ksmape\u001b[m\u001b[K = \u001b[01;31m\u001b[Ksmape\u001b[m\u001b[KSum / float64(\u001b[01;31m\u001b[Ksmape\u001b[m\u001b[KCount) * 100\r\n\u001b[32m\u001b[K734\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\"\u001b[01;31m\u001b[Ksmape\u001b[m\u001b[K\":     \u001b[01;31m\u001b[Ksmape\u001b[m\u001b[K,\r\n"]
[4670.663707, "o", "\u001b[32m\u001b[K747\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcomputeBootstrapCIs\u001b[m\u001b[K(taskType string, preds []NormPrediction, B int, confidence float64, rng *rand.Rand) map[string]CI {\r\n\u001b[32m\u001b[K751\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tciMetrics := \u001b[01;31m\u001b[KciMetricsForTask\u001b[m\u001b[K(taskType)\r\n"]
[4670.66379, "o", "\u001b[32m\u001b[K821\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tsr.ConfidenceIntervals = \u001b[01;31m\u001b[KcomputeBootstrapCIs\u001b[m\u001b[K(nm.Model.TaskType, ev.Predictions, bootstrap, confidence, rng)\r\n"]
[4670.663874, "o", "\u001b[32m\u001b[K926\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor _, metric := range \u001b[01;31m\u001b[KciMetricsForTask\u001b[m\u001b[K(nm.Model.TaskType) {\r\n"]
[4670.664079, "o", "\u001b[32m\u001b[K1035\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KbuildComparisonData\u001b[m\u001b[K(baseline, candidate NormManifest, cfg RegressionConfig) (ComparisonData, error) {\r\n"]
[4670.664226, "o", "\u001b[32m\u001b[K1166\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KbuildComparisonMarkdown\u001b[m\u001b[K(cd ComparisonData) string {\r\n"]
[4670.66432, "o", "\u001b[32m\u001b[K1202\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KrunCompare\u001b[m\u001b[K(args []string) int {\r\n"]
[4670.664403, "o", "\u001b[32m\u001b[K1203\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs := flag.NewFlagSet(\"\u001b[01;31m\u001b[Kcompare\u001b[m\u001b[K\", flag.ContinueOnError)\r\n\u001b[32m\u001b[K1238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcd, err := \u001b[01;31m\u001b[KbuildComparisonData\u001b[m\u001b[K(baseline, candidate, cfg)\r\n\u001b[32m\u001b[K1248\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tmd := \u001b[01;31m\u001b[KbuildComparisonMarkdown\u001b[m\u001b[K(cd)\r\n"]
[4670.664477, "o", "\u001b[32m\u001b[K1339\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"usage: mlreport <evaluate|\u001b[01;31m\u001b[Kcompare\u001b[m\u001b[K|summary> ...\")\r\n\u001b[32m\u001b[K1346\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kcompare\u001b[m\u001b[K\":\r\n\u001b[32m\u001b[K1347\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcode = \u001b[01;31m\u001b[KrunCompare\u001b[m\u001b[K(os.Args[2:])\r\n"]
