[5224.717088, "o", "  1035\tfunc buildComparisonData(baseline, candidate NormManifest, cfg RegressionConfig, excludedMetrics map[string]bool, selectedSplits []string) (ComparisonData, error) {\r\n  1036\t\tif baseline.Model.TaskType != candidate.Model.TaskType {\r\n  1037\t\t\treturn ComparisonData{}, fmt.Errorf(\"task type mismatch: baseline %q candidate %q\", baseline.Model.TaskType, candidate.Model.TaskType)\r\n  1038\t\t}\r\n  1039\t\tbaseSplits := make(map[string]bool)\r\n"]
[5224.717165, "o", "  1040\t\tfor _, ev := range baseline.Evaluations {\r\n  1041\t\t\tbaseSplits[ev.Split] = true\r\n  1042\t\t}\r\n  1043\t\tcandSplits := make(map[string]bool)\r\n  1044\t\tfor _, ev := range candidate.Evaluations {\r\n  1045\t\t\tcandSplits[ev.Split] = true\r\n  1046\t\t}\r\n  1047\t\tvar splitOrder []string\r\n  1048\t\tif len(selectedSplits) > 0 {\r\n  1049\t\t\t"]
[5224.71723, "o", "for _, name := range selectedSplits {\r\n  1050\t\t\t\tif !baseSplits[name] {\r\n  1051\t\t\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q not found in baseline\", name)\r\n  1052\t\t\t\t}\r\n  1053\t\t\t\tif !candSplits[name] {\r\n  1054\t\t\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q not found in candidate\", name)\r\n  1055\t\t\t\t}\r\n  1056\t\t\t\tsplitOrder = append(splitOrder, name)\r\n"]
[5224.717291, "o", "  1057\t\t\t}\r\n  1058\t\t} else {\r\n  1059\t\t\tfor _, ev := range candidate.Evaluations {\r\n  1060\t\t\t\tif !baseSplits[ev.Split] {\r\n  1061\t\t\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in candidate but not baseline\", ev.Split)\r\n  1062\t\t\t\t}\r\n  1063\t\t\t}\r\n  1064\t\t\tfor _, ev := range baseline.Evaluations {\r\n"]
[5224.717351, "o", "  1065\t\t\t\tfound := false\r\n  1066\t\t\t\tfor _, cev := range candidate.Evaluations {\r\n  1067\t\t\t\t\tif cev.Split == ev.Split {\r\n  1068\t\t\t\t\t\tfound = true\r\n  1069\t\t\t\t\t\tbreak\r\n  1070\t\t\t\t\t}\r\n  1071\t\t\t\t}\r\n"]
[5224.717411, "o", "  1072\t\t\t\tif !found {\r\n  1073\t\t\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in baseline but not candidate\", ev.Split)\r\n  1074\t\t\t\t}\r\n  1075\t\t\t\tsplitOrder = append(splitOrder, ev.Split)\r\n  1076\t\t\t}\r\n  1077\t\t}\r\n  1078\t\ttaskType := baseline.Model.TaskType\r\n  1079\t\tmetricOrder := metricOrderForTask(taskType)\r\n"]
[5224.717475, "o", "  1080\t\tcd := ComparisonData{\r\n  1081\t\t\tBaseline:           ModelRef{Name: baseline.Model.Name, Version: baseline.Model.Version},\r\n  1082\t\t\tCandidate:          ModelRef{Name: candidate.Model.Name, Version: candidate.Model.Version},\r\n  1083\t\t\tTaskType:           taskType,\r\n  1084\t\t\tSplitOrder:         []string{},\r\n  1085\t\t\tMetricOrder:        metricOrder,\r\n  1086\t\t\tDeltas:             make(map[string]map[string]DeltaEntry),\r\n  1087\t\t\tRegressionMetrics:  []string{},\r\n  1088\t\t\tRegressionAnalysis: make(map[string]RegressionAnalysisEntry),\r\n  1089\t\t\tOverall: Overall{\r\n  1090\t\t\t\tVerdict:                \"PASS\",\r\n"]
