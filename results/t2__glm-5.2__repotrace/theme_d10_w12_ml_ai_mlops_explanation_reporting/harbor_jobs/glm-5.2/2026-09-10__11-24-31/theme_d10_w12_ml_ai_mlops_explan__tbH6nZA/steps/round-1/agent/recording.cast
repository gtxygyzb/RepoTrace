[5011.647698, "o", "\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tSplit       string          `json:\"\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K\"`\r\n"]
[5011.64777, "o", "\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tSplits map[string]SplitReportJSON `json:\"\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks\"`\r\n\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tRegressedSplits []string `json:\"regressed_\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks\"`\r\n"]
[5011.647891, "o", "\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks := make(map[string]bool)\r\n\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K name is required\", path)\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks[ev.Split] {\r\n"]
[5011.647968, "o", "\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: duplicate \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K name %q\", path, ev.Split)\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks[ev.Split] = true\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: dataset is required for \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q\", path, ev.Split)\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q must have at least one prediction\", path, ev.Split)\r\n"]
[5011.648051, "o", "\u001b[32m\u001b[K334\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: prediction id is required in \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q\", path, ev.Split)\r\n\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: duplicate prediction id %q in \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q\", path, rp.ID, ev.Split)\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc normalizePrediction(path, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K string, rp RawPrediction, taskType string) (NormPrediction, error) {\r\n"]
