[1940.934387, "o", "# mlreport\r\n./main.go:4:1: \"bytes\" imported and not used\r\n./main.go:6:1: \"flag\" imported and not used\r\n./main.go:7:1: \"fmt\" imported and not used\r\n./main.go:8:1: \"math\" imported and not used\r\n./main.go:9:1: \"os\" imported and not used\r\n./main.go:10:1: \"path/filepath\" imported and not used\r\n./main.go:11:1: \"regexp\" imported and not used\r\n./main.go:12:1: \"sort\" imported and not used\r\n./main.go:13:1: \"strings\" imported and not used\r\n"]
