[5079.779217, "o", "\t\t\treturn 2\r\n  1251\t\t}\r\n  1252\t\tcd, err := buildComparisonData(baseline, candidate, cfg, excludedMetrics)\r\n  1253\t\tif err != nil {\r\n  1254\t\t\tfmt.Fprintln(os.Stderr, err)\r\n  1255\t\t\treturn 2\r\n  1256\t\t}\r\n  1257\t\tif err := os.MkdirAll(*outputDir, 0755); err != nil {\r\n"]
