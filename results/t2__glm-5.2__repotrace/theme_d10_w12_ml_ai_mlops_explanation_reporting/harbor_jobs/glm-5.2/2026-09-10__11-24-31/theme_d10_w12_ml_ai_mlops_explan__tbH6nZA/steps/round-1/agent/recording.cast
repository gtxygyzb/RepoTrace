[4415.489936, "o", "}\r\n\r\nfunc writeFile(path string, data []byte) error {\r\n\treturn os.WriteFile(path, data, 0644)\r\n}\r\n\r\nfunc runEvaluate(args []string) int {\r\n\tfs := flag.NewFlagSet(\"evaluate\", flag.ContinueOnError)\r\n\tmanifest := fs.String(\"manifest\", \"\", \"path to evaluation manifest JSON file\")\r\n\toutputDir := fs.String(\"output-dir\", \"\", \"directory for output files\")\r\n\t"]
[4415.490009, "o", "format := fs.String(\"format\", \"both\", \"output format: md, json, or both\")\r\n\tbootstrap := fs.Int(\"bootstrap\", 1000, \"number of bootstrap iterations\")\r\n\tconfidence := fs.Float64(\"confidence\", 0.95, \"confidence level\")\r\n\tseed := fs.Int64(\"seed\", 42, \"random seed\")\r\n\tsplit := fs.String(\"split\", \"\", \"comma-separated list of split names to include\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 2\r\n\t}\r\n\tif *manifest == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"--manifest is required\")\r\n\t\treturn 2"]
[4415.490057, "o", "\r\n\t}\r\n\tif *outputDir == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"--output-dir is required\")\r\n\t\treturn 2\r\n\t}\r\n\tswitch *format {\r\n\tcase \"md\", \"json\", \"both\":\r\n"]
[4415.490098, "o", "\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid --format %q; must be md, json, or both\\n\", *format)\r\n\t\treturn 2\r\n\t}\r\n\tif *bootstrap < 0 {\r\n"]
[4415.49014, "o", "\t\tfmt.Fprintln(os.Stderr, \"--bootstrap must be non-negative\")\r\n\t\treturn 2\r\n\t}\r\n\tif *confidence <= 0 || *confidence >= 1 {\r\n"]
[4415.490179, "o", "\t\tfmt.Fprintln(os.Stderr, \"--confidence must be in (0, 1)\")\r\n\t\treturn 2\r\n\t}\r\n\tnm, err := loadManifest(*manifest)\r\n"]
[4415.490217, "o", "\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 2\r\n\t}\r\n\tvar splits []string\r\n"]
[4415.490255, "o", "\tif *split != \"\" {\r\n\t\tfor _, name := range strings.Split(*split, \",\") {\r\n\t\t\tname = strings.TrimSpace(name)\r\n\t\t\tif name == \"\" {\r\n"]
[4415.490295, "o", "\t\t\t\tfmt.Fprintln(os.Stderr, \"--split contains empty split names\")\r\n\t\t\t\treturn 2\r\n\t\t\t}\r\n"]
[4415.490336, "o", "\t\t\tsplits = append(splits, name)\r\n\t\t}\r\n\t\tsplitSet := make(map[string]bool)\r\n\t\tfor _, name := range splits {\r\n\t\t\tsplitSet[name] = true\r\n"]
[4415.490368, "o", "\t\t}\r\n\t\tfor _, name := range splits {\r\n\t\t\tfound := false\r\n"]
[4415.490406, "o", "\t\t\tfor _, ev := range nm.Evaluations {\r\n\t\t\t\tif ev.Split == name {\r\n\t\t\t\t\tfound = true\r\n\t\t\t\t\tbreak\r\n"]
[4415.490444, "o", "\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !found {\r\n"]
[4415.490496, "o", "\t\t\t\tfmt.Fprintf(os.Stderr, \"split %q not found in manifest\\n\", name)\r\n\t\t\t\treturn 2\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treport := buildReportJSON(nm, splits, *bootstrap, *confidence, *seed)\r\n\tif err := os.MkdirAll(*outputDir, 0755); err != nil {\r\n"]
[4415.490536, "o", "\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 2\r\n\t}\r\n"]
[4415.490576, "o", "\tif *format == \"md\" || *format == \"both\" {\r\n\t\tmd := buildEvaluateMarkdown(report, nm, splits, *bootstrap)\r\n\t\tif err := writeFile(filepath.Join(*outputDir, \"report.md\"), []byte(md)); err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t}\r\n\tif *format == \"json\" || *format == \"both\" {\r\n"]
[4415.490615, "o", "\t\tdata, err := json.MarshalIndent(report, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\treturn 2\r\n\t"]
[4415.490654, "o", "\t}\r\n\t\tif err := writeFile(filepath.Join(*outputDir, \"report.json\"), append(data, '\\n')); err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t}"]
[4415.490691, "o", "\r\n\treturn 0\r\n}\r\n\r\nfunc buildComparisonData(baseline, candidate NormManifest, cfg RegressionConfig) (ComparisonData, error) {\r\n"]
