[4675.972161, "o", "\tif i < 0 {\r\n\t\treturn 0\r\n\t}\r\n\tif i >= n {\r\n\t\treturn n - 1\r\n"]
[4675.972255, "o", "\t}\r\n\treturn i\r\n}\r\n\r\nfunc metricOrderForTask(taskType string) []string {\r\n\tswitch taskType {\r\n\tcase \"binary_classification\":\r\n\t\treturn []string{\"accuracy\", \"precision\", \"recall\", \"f1\", \"auc_roc\", \"log_loss\"}\r\n\tcase \"multiclass_classification\":\r\n\t\treturn []string{\"accuracy\", \"precision_micro\", \"recall_micro\", \"f1_micro\", \"precision_macro\", \"recall_macro\", \"f1_macro\", \"precision_weighted\", \"recall_weighted\", \"f1_weighted\"}\r\n\tcase \"regression\":\r\n\t\treturn []string{\"mse\", \"rmse\", \"mae\", \"r_squared\", \"smape\"}\r\n\tdefault:\r\n\t\treturn nil\r\n\t}\r\n}\r\n\r\n"]
[4675.972343, "o", "func ciMetricsForTask(taskType string) []string {\r\n\tswitch taskType {\r\n\tcase \"binary_classification\":\r\n\t\treturn []string{\"accuracy\", \"precision\", \"recall\", \"f1\", \"auc_roc\"}\r\n\tcase \"multiclass_classification\":\r\n\t\treturn []string{\"accuracy\", \"f1_macro\", \"f1_weighted\"}\r\n\tcase \"regression\":\r\n\t\treturn []string{\"mse\", \"rmse\", \"mae\", \"r_squared\"}\r\n\tdefault:\r\n\t\treturn nil\r\n\t}\r\n}\r\n\r\n"]
[4675.972425, "o", "func sortClasses(classes []string) {\r\n\tsort.Slice(classes, func(i, j int) bool {\r\n\t\tai := strings.ToLower(classes[i])\r\n\t\taj := strings.ToLower(classes[j])\r\n\t\tif ai != aj {\r\n\t\t\treturn ai < aj\r\n"]
[4675.973091, "o", "\u001b[?2004h"]
[4675.97317, "o", "root@n30009:/app# "]
[4676.250803, "i", "sed -n '740,840p' main.go\n"]
[4676.251082, "o", "sed -n '740,840p' main.go\r\n\u001b[?2004l\r"]
[4676.254073, "o", "\tm := make(map[string]float64)\r\n\tfor _, name := range order {\r\n\t\tm[name] = 0\r\n\t}\r\n\treturn m\r\n"]
[4676.254157, "o", "}\r\n\r\nfunc computeBootstrapCIs(taskType string, preds []NormPrediction, B int, confidence float64, rng *rand.Rand) map[string]CI {\r\n\tif B <= 0 {\r\n\t\treturn nil\r\n\t}\r\n\tciMetrics := ciMetricsForTask(taskType)\r\n\tif len(ciMetrics) == 0 {\r\n\t\treturn nil\r\n\t}\r\n\tn := len(preds)\r\n\tvalues := make(map[string][]float64)\r\n\tfor _, m := range ciMetrics {\r\n\t\tvalues[m] = make([]float64, 0, B)\r\n\t"]
[4676.254233, "o", "}\r\n\tfor b := 0; b < B; b++ {\r\n\t\tresample := make([]NormPrediction, n)\r\n\t\tfor i := 0; i < n; i++ {\r\n\t\t\tresample[i] = preds[rng.Intn(n)]\r\n\t\t}\r\n\t\tres := computeMetrics(taskType, resample)\r\n\t\tfor _, m := range ciMetrics {\r\n\t\t\tvalues[m] = append(values[m], res.Metrics[m])\r\n"]
[4676.2543, "o", "\t\t}\r\n\t}\r\n\tcis := make(map[string]CI)\r\n\tfor _, m := range ciMetrics {\r\n\t\tvals := values[m]\r\n\t\tsort.Float64s(vals)\r\n\t\tlowerIndex := clampIndex(int(math.Floor((1-confidence)/2*float64(B))), B)\r\n\t\tupperIndex := clampIndex(int(math.Floor((1+confidence)/2*float64(B)))-1, B)\r\n\t\tcis[m] = CI{Lower: round6(vals[lowerIndex]), Upper: round6(vals[upperIndex])}\r\n\t}\r\n"]
[4676.254365, "o", "\treturn cis\r\n}\r\n\r\nfunc buildReportJSON(nm NormManifest, splits []string, bootstrap int, confidence float64, seed int64) ReportJSON {\r\n\treport := ReportJSON{Model: nm.Model, Splits: make(map[string]SplitReportJSON)}\r\n\tvar rng *rand.Rand\r\n\tif bootstrap > 0 {\r\n\t\trng = rand.New(rand.NewSource(seed))\r\n\t}\r\n\tfor _, ev := range nm.Evaluations {\r\n\t\tif len(splits) > 0 {\r\n"]
[4676.254427, "o", "\t\t\tfound := false\r\n\t\t\tfor _, split := range splits {\r\n\t\t\t\tif split == ev.Split {\r\n\t\t\t\t\tfound = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !found {\r\n\t\t\t\tcontinue\r\n"]
[4676.254488, "o", "\t\t\t}\r\n\t\t}\r\n\t\tresult := computeMetrics(nm.Model.TaskType, ev.Predictions)\r\n\t\troundedMetrics := make(map[string]float64)\r\n\t\tfor _, name := range result.MetricOrder {\r\n\t\t\troundedMetrics[name] = round6(result.Metrics[name])\r\n\t\t}\r\n\t\tsr := SplitReportJSON{Dataset: ev.Dataset, Metrics: roundedMetrics}\r\n"]
[4676.254553, "o", "\t\tif nm.Model.TaskType != \"regression\" && result.ConfusionMatrix != nil {\r\n\t\t\tsr.ConfusionMatrix = result.ConfusionMatrix\r\n\t\t}\r\n\t\tif nm.Model.TaskType == \"multiclass_classification\" && len(result.PerClassMetrics) > 0 {\r\n\t\t\tsr.PerClassMetrics = make(map[string]PerClassMetric)\r\n\t\t\tfor class, pm := range result.PerClassMetrics {\r\n\t\t\t\tsr.PerClassMetrics[class] = PerClassMetric{\r\n"]
[4676.254619, "o", "\t\t\t\t\tPrecision: round6(pm.Precision),\r\n\t\t\t\t\tRecall:    round6(pm.Recall),\r\n\t\t\t\t\tF1:        round6(pm.F1),\r\n\t\t\t\t\tSupport:   pm.Support,\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[4676.254683, "o", "\t\t}\r\n\t\tif bootstrap > 0 {\r\n\t\t\tsr.ConfidenceIntervals = computeBootstrapCIs(nm.Model.TaskType, ev.Predictions, bootstrap, confidence, rng)\r\n\t\t}\r\n\t\treport.Splits[ev.Split] = sr\r\n\t}\r\n\treturn report\r\n}\r\n\r\nfunc buildEvaluateMarkdown(report ReportJSON, nm NormManifest, splits []string, bootstrap int) string {\r\n"]
[4676.254746, "o", "\tvar b strings.Builder\r\n\tfmt.Fprintf(&b, \"# Evaluation Report: %s v%s\\n\\n\", nm.Model.Name, nm.Model.Version)\r\n\tfmt.Fprintf(&b, \"Task type: %s\\n\\n\", nm.Model.TaskType)\r\n\tfmt.Fprintf(&b, \"## Summary\\n\\n\")\r\n\tvisibleEvals := make([]NormEvaluation, 0, len(nm.Evaluations))\r\n\tfor _, ev := range nm.Evaluations {\r\n\t\tif len(splits) > 0 {\r\n\t\t\tfound := false\r\n\t\t\tfor _, split := range splits {\r\n\t\t\t\tif split == ev.Split {\r\n\t\t\t\t\tfound = true\r\n\t\t\t\t\tbreak\r\n"]
[4676.255346, "o", "\u001b[?2004h"]
[4676.255409, "o", "root@n30009:/app# "]
[4676.516922, "i", "sed -n '900,960p' main.go\n"]
[4676.517116, "o", "sed -n '900,960p' main.go\r\n\u001b[?2004l\r"]
[4676.519977, "o", "\t\t\t\tfor _, count := range sr.ConfusionMatrix.Matrix[i] {\r\n\t\t\t\t\trow = append(row, strconv.Itoa(count))\r\n\t\t\t\t}\r\n\t\t\t\tfmt.Fprintln(&b, \"| \"+strings.Join(row, \" | \")+\" |\")\r\n\t\t\t}\r\n"]
[4676.520079, "o", "\t\t\tfmt.Fprintln(&b)\r\n\t\t}\r\n\t\tif nm.Model.TaskType == \"multiclass_classification\" && len(sr.PerClassMetrics) > 0 {\r\n\t\t\tfmt.Fprintf(&b, \"### Per-Class Metrics\\n\\n\")\r\n\t\t\tfmt.Fprintln(&b, \"| Class | Precision | Recall | F1 | Support |\")\r\n\t\t\tfmt.Fprintln(&b, \"|-------|-----------|--------|----|---------|\")\r\n\t\t\tclasses := make([]string, 0, len(sr.PerClassMetrics))\r\n\t\t\tfor c := range sr.PerClassMetrics {\r\n\t\t\t\tclasses = append(classes, c)\r\n\t\t\t}\r\n\t\t\tsortClasses(classes)\r\n\t\t\tfor _, c := range classes {\r\n\t\t\t\tpm := sr.PerClassMetrics[c]\r\n"]
[4676.52019, "o", "\t\t\t\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %d |\\n\", c, formatFloat6(pm.Precision), formatFloat6(pm.Recall), formatFloat6(pm.F1), pm.Support)\r\n\t\t\t}\r\n\t\t\tfmt.Fprintln(&b)\r\n\t\t}\r\n\t\tif bootstrap > 0 && len(sr.ConfidenceIntervals) > 0 {\r\n\t\t\tfmt.Fprintf(&b, \"### Confidence Intervals\\n\\n\")\r\n\t\t\tfmt.Fprintln(&b, \"| Metric | Lower | Upper |\")\r\n\t\t\tfmt.Fprintln(&b, \"|--------|-------|-------|\")\r\n\t\t\tfor _, metric := range ciMetricsForTask(nm.Model.TaskType) {\r\n\t\t\t\tif ci, ok := sr.ConfidenceIntervals[metric]; ok {\r\n\t\t\t\t\tfmt.Fprintf(&b, \"| %s | %s | %s |\\n\", metric, formatFloat6(ci.Lower), formatFloat6(ci.Upper))\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tfmt.Fprintln(&b)\r\n\t\t}\r\n\t}\r\n"]
[4676.520274, "o", "\treturn b.String()\r\n}\r\n\r\nfunc writeFile(path string, data []byte) error {\r\n\treturn os.WriteFile(path, data, 0644)\r\n}\r\n\r\nfunc runEvaluate(args []string) int {\r\n\tfs := flag.NewFlagSet(\"evaluate\", flag.ContinueOnError)\r\n\tmanifest := fs.String(\"manifest\", \"\", \"path to evaluation manifest JSON file\")\r\n\toutputDir := fs.String(\"output-dir\", \"\", \"directory for output files\")\r\n\tformat := fs.String(\"format\", \"both\", \"output format: md, json, or both\")\r\n\tbootstrap := fs.Int(\"bootstrap\", 1000, \"number of bootstrap iterations\")\r\n\tconfidence := fs.Float64(\"confidence\", 0.95, \"confidence level\")\r\n"]
[4676.520342, "o", "\tseed := fs.Int64(\"seed\", 42, \"random seed\")\r\n\tsplit := fs.String(\"split\", \"\", \"comma-separated list of split names to include\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 2\r\n\t}\r\n"]
[4676.520401, "o", "\tif *manifest == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"--manifest is required\")\r\n\t\treturn 2\r\n\t}\r\n\tif *outputDir == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"--output-dir is required\")\r\n\t\treturn 2\r\n"]
