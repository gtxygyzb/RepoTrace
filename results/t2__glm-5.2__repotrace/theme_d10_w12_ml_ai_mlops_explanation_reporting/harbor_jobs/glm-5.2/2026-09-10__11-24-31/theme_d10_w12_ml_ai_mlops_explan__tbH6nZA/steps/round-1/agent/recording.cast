[4826.906814, "o", "\u001b[?2004h> "]
[4826.906921, "o", "\\t\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[4826.906977, "o", "\u001b[?2004h> "]
[4826.907032, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[4826.907089, "o", "\u001b[?2004h> "]
[4826.907281, "o", "\\t\\t\\texcludedMetrics[name] = true\r\n\u001b[?2004l\r"]
[4826.907337, "o", "\u001b[?2004h> "]
[4826.907393, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
