[5670.845649, "o", "  1185\tfunc buildComparisonMarkdown(cd ComparisonData) string {\r\n  1186\t\tvar b strings.Builder\r\n  1187\t\tfmt.Fprintf(&b, \"# Model Comparison Report\\n\\n\")\r\n  1188\t\tfmt.Fprintf(&b, \"Baseline: %s v%s\\n\", cd.Baseline.Name, cd.Baseline.Version)\r\n"]
[5670.845729, "o", "  1189\t\tfmt.Fprintf(&b, \"Candidate: %s v%s\\n\", cd.Candidate.Name, cd.Candidate.Version)\r\n  1190\t\tfmt.Fprintf(&b, \"Task type: %s\\n\\n\", cd.TaskType)\r\n  1191\t\tfmt.Fprintf(&b, \"## Performance Delta\\n\\n\")\r\n  1192\t\tfmt.Fprintln(&b, \"| Metric | Split | Baseline | Candidate | Delta | Relative Delta |\")\r\n  1193\t\tfmt.Fprintln(&b, \"|--------|-------|----------|-----------|-------|----------------|\")\r\n  1194\t\tfor _, metric := range cd.MetricOrder {\r\n  1195\t\t\tfor _, split := range cd.SplitOrder {\r\n  1196\t\t\t\td := cd.Deltas[split][metric]\r\n"]
[5670.845805, "o", "  1197\t\t\t\trel := \"N/A\"\r\n  1198\t\t\t\tif d.RelativeDelta != nil {\r\n  1199\t\t\t\t\trel = formatFloat2(*d.RelativeDelta*100) + \"%\"\r\n  1200\t\t\t\t}\r\n  1201\t\t\t\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %s | %s |\\n\", metric, split, formatFloat6(d.Baseline), formatFloat6(d.Candidate), formatFloat6(d.AbsoluteDelta), rel)\r\n  1202\t\t\t}\r\n  1203\t\t}\r\n  1204\t\tfmt.Fprintln(&b)\r\n"]
[5670.84587, "o", "  1205\t\tfmt.Fprintf(&b, \"## Regression Analysis\\n\\n\")\r\n  1206\t\tfmt.Fprintln(&b, \"| Metric | Severity | Direction | Regressed Splits | Verdict |\")\r\n  1207\t\tfmt.Fprintln(&b, \"|--------|----------|-----------|-----------------|---------|\")\r\n  1208\t\torderedRegressionMetrics := make([]string, 0, len(cd.RegressionAnalysis))\r\n  1209\t\tfor _, metric := range metricOrderForTask(cd.TaskType) {\r\n  1210\t\t\tif _, ok := cd.RegressionAnalysis[metric]; ok {\r\n"]
[5670.845962, "o", "  1211\t\t\t\torderedRegressionMetrics = append(orderedRegressionMetrics, metric)\r\n  1212\t\t\t}\r\n  1213\t\t}\r\n  1214\t\tfor _, metric := range orderedRegressionMetrics {\r\n  1215\t\t\tra := cd.RegressionAnalysis[metric]\r\n  1216\t\t\tsplits := strings.Join(ra.RegressedSplits, \", \")\r\n  1217\t\t\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %s |\\n\", metric, ra.Severity, ra.Direction, splits, ra.Verdict)\r\n  1218\t\t}\r\n  1219\t\tfmt.Fprintln(&b)\r\n  1220\t\tfmt.Fprintf(&b, \"## Overall Verdict\\n\\n\")\r\n  1221\t\tfmt.Fprintf(&b, \"Result: %s\\n\", cd.Overall.Verdict)\r\n  1222\t\tfmt.Fprintf(&b, \"Critical regressions: %d / %d\\n\", cd.Overall.CriticalRegressions, cd.Overall.MaxCriticalRegressions)\r\n"]
[5670.846021, "o", "  1223\t\tfmt.Fprintf(&b, \"Warning regressions: %d / %d\\n\", cd.Overall.WarningRegressions, cd.Overall.MaxWarningRegressions)\r\n  1224\t\treturn b.String()\r\n  1225\t}\r\n  1226\t\r\n  1227\tfunc runCompare(args []string) int {\r\n  1228\t\tfs := flag.NewFlagSet(\"compare\", flag.ContinueOnError)\r\n  1229\t\tbaselinePath := fs.String(\"baseline\", \"\", \"path to baseline manifest\")\r\n  1230\t\tcandidatePath := fs.String(\"candidate\", \"\", \"path to candidate manifest\")\r\n"]
[5670.846086, "o", "  1231\t\tconfigPath := fs.String(\"config\", \"\", \"path to regression config\")\r\n  1232\t\toutputDir := fs.String(\"output-dir\", \"\", \"directory for output files\")\r\n  1233\t\tformat := fs.String(\"format\", \"both\", \"output format: md, json, or both\")\r\n  1234\t\texcludeMetric := fs.String(\"exclude-metric\", \"\", \"comma-separated list of metric names to exclude from regression analysis\")\r\n  1235\t\tsplit := fs.String(\"split\", \"\", \"comma-separated list of split names to compare\")\r\n  1236\t\tif err := fs.Parse(args); err != nil {\r\n  1237\t\t\tfmt.Fprintln(os.Stderr, err)\r\n  1238\t\t\treturn 2\r\n  1239\t\t"]
[5670.846142, "o", "}\r\n  1240\t\tif *baselinePath == \"\" || *candidatePath == \"\" || *configPath == \"\" || *outputDir == \"\" {\r\n  1241\t\t\tfmt.Fprintln(os.Stderr, \"--baseline, --candidate, --config, and --output-dir are required\")\r\n  1242\t\t\treturn 2\r\n  1243\t\t}\r\n  1244\t\tswitch *format {\r\n  1245\t\tcase \"md\", \"json\", \"both\":\r\n"]
