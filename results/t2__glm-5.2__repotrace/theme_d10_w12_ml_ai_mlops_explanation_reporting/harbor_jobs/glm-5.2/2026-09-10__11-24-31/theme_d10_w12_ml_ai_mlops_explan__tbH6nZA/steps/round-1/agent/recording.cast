[2681.539957, "o", "> "]
[2681.540028, "o", "    for _, name := range order {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.540101, "o", "        m[name] = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.540164, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.540232, "o", "    return m\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
