[5012.198119, "o", "\tif i < 0 {\r\n\t\treturn 0\r\n\t}\r\n\tif i >= n {\r\n\t\treturn n - 1\r\n\t}\r\n"]
[5012.198222, "o", "\treturn i\r\n}\r\n\r\nfunc metricOrderForTask(taskType string) []string {\r\n\tswitch taskType {\r\n\tcase \"binary_classification\":\r\n\t\treturn []string{\"accuracy\", \"precision\", \"recall\", \"f1\", \"auc_roc\", \"log_loss\"}\r\n"]
[5012.198295, "o", "\tcase \"multiclass_classification\":\r\n\t\treturn []string{\"accuracy\", \"precision_micro\", \"recall_micro\", \"f1_micro\", \"precision_macro\", \"recall_macro\", \"f1_macro\", \"precision_weighted\", \"recall_weighted\", \"f1_weighted\"}\r\n\tcase \"regression\":\r\n\t\treturn []string{\"mse\", \"rmse\", \"mae\", \"r_squared\", \"smape\"}\r\n\tdefault:\r\n\t\treturn nil\r\n\t}\r\n}\r\n\r\nfunc ciMetricsForTask(taskType string) []string {\r\n\tswitch taskType {\r\n\tcase \"binary_classification\":\r\n\t\treturn []string{\"accuracy\", \"precision\", \"recall\", \"f1\", \"auc_roc\"}\r\n\tcase \"multiclass_classification\":\r\n\t\treturn []string{\"accuracy\", \"f1_macro\", \"f1_weighted\"}\r\n\tcase \"regression\":\r\n\t\treturn []string{\"mse\", \"rmse\", \"mae\", \"r_squared\", \"smape\"}\r\n\tdefault:\r\n\t\treturn nil\r\n\t}\r\n}\r\n\r\nfunc sortClasses(classes []string) {\r\n\tsort.Slice(classes, func(i, j int) bool {\r\n\t\tai := strings.ToLower(classes[i])\r\n"]
[5012.198381, "o", "\t\taj := strings.ToLower(classes[j])\r\n\t\tif ai != aj {\r\n\t\t\treturn ai < aj\r\n\t\t}\r\n\t\treturn classes[i] < classes[j]\r\n\t})\r\n}\r\n\r\n"]
[5012.198447, "o", "func collectClasses(preds []NormPrediction, fromActualOnly bool) []string {\r\n\tset := make(map[string]bool)\r\n\tfor _, p := range preds {\r\n\t\tif p.ActualStr != \"\" {\r\n\t\t\tset[p.ActualStr] = true\r\n\t\t}\r\n\t\tif !fromActualOnly && p.PredictedStr != \"\" {\r\n\t\t\tset[p.PredictedStr] = true\r\n\t\t}\r\n\t}\r\n\tclasses := make([]string, 0, len(set))\r\n\tfor c := range set {\r\n\t\tclasses = append(classes, c)\r\n\t}\r\n\tsortClasses(classes)\r\n\treturn classes\r\n"]
[5012.198507, "o", "}\r\n\r\nfunc readJSON(path string, v any) error {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn fmt.Errorf(\"read %s: %w\", path, err)\r\n\t}\r\n\tif err := json.Unmarshal(data, v); err != nil {\r\n\t\treturn fmt.Errorf(\"parse %s: %w\", path, err)\r\n\t}\r\n"]
[5012.198567, "o", "\treturn nil\r\n}\r\n\r\nfunc loadManifest(path string) (NormManifest, error) {\r\n\tvar raw Manifest\r\n\tif err := readJSON(path, &raw); err != nil {\r\n\t\treturn NormManifest{}, err\r\n\t}\r\n\tif !validModelName.MatchString(raw.Model.Name) {\r\n\t\treturn NormManifest{}, fmt.Errorf(\"%s: invalid model name %q\", path, raw.Model.Name)\r\n\t}\r\n"]
[5012.198625, "o", "\tif !validVersion.MatchString(raw.Model.Version) {\r\n\t\treturn NormManifest{}, fmt.Errorf(\"%s: invalid model version %q\", path, raw.Model.Version)\r\n\t}\r\n\tswitch raw.Model.TaskType {\r\n\tcase \"binary_classification\", \"multiclass_classification\", \"regression\":\r\n\tdefault:\r\n\t\treturn NormManifest{}, fmt.Errorf(\"%s: invalid task_type %q\", path, raw.Model.TaskType)\r\n\t}\r\n"]
[5012.198688, "o", "\tif len(raw.Evaluations) == 0 {\r\n\t\treturn NormManifest{}, fmt.Errorf(\"%s: at least one evaluation is required\", path)\r\n\t}\r\n\tnm := NormManifest{Model: raw.Model}\r\n\tsplits := make(map[string]bool)\r\n\tfor _, ev := range raw.Evaluations {\r\n\t\tif ev.Split == \"\" {\r\n\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: split name is required\", path)\r\n\t\t}\r\n\t"]
[5012.198745, "o", "\tif splits[ev.Split] {\r\n\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: duplicate split name %q\", path, ev.Split)\r\n\t\t}\r\n\t\tsplits[ev.Split] = true\r\n\t\tif ev.Dataset == \"\" {\r\n\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: dataset is required for split %q\", path, ev.Split)\r\n\t\t}\r\n\t\tif len(ev.Predictions) == 0 {\r\n\t\t"]
[5012.198803, "o", "\treturn NormManifest{}, fmt.Errorf(\"%s: split %q must have at least one prediction\", path, ev.Split)\r\n\t\t}\r\n\t\tne := NormEvaluation{Split: ev.Split, Dataset: ev.Dataset}\r\n\t\tids := make(map[string]bool)\r\n\t\tfor _, rp := range ev.Predictions {\r\n\t\t\tif rp.ID == \"\" {\r\n\t\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: prediction id is required in split %q\", path, ev.Split)\r\n\t\t\t}\r\n"]
[5012.198868, "o", "\t\t\tif ids[rp.ID] {\r\n\t\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: duplicate prediction id %q in split %q\", path, rp.ID, ev.Split)\r\n\t\t\t}\r\n\t\t\tids[rp.ID] = true\r\n\t\t\tnp, err := normalizePrediction(path, ev.Split, rp, raw.Model.TaskType)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn NormManifest{}, err\r\n\t\t\t}\r\n\t\t\tne.Predictions = append(ne.Predictions, np)\r\n\t"]
[5012.198945, "o", "\t}\r\n\t\tnm.Evaluations = append(nm.Evaluations, ne)\r\n\t}\r\n\treturn nm, nil\r\n}\r\n"]
[5012.199006, "o", "\r\nfunc normalizePrediction(path, split string, rp RawPrediction, taskType string) (NormPrediction, error) {\r\n\tnp := NormPrediction{ID: rp.ID}\r\n\tif taskType == \"regression\" {\r\n\t\tif len(rp.Actual) == 0 {\r\n\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: actual is required\", path, split, rp.ID)\r\n\t\t}\r\n\t\tif err := json.Unmarshal(rp.Actual, &np.ActualNum); err != nil {\r\n\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: actual must be a number\", path, split, rp.ID)\r\n\t\t}\r\n\t\tif err := json.Unmarshal(rp.Predicted, &np.PredictedNum); err != nil {\r\n\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: predicted must be a number\", path, split, rp.ID)\r\n\t\t}\r\n\t\tif len(rp.Probabilities) > 0 && string(rp.Probabilities) != \"null\" {\r\n\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: probabilities must be absent for regression\", path, split, rp.ID)\r\n"]
[5012.199069, "o", "\t\t}\r\n\t} else {\r\n\t\tif len(rp.Actual) == 0 {\r\n\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: actual is required\", path, split, rp.ID)\r\n\t\t}\r\n\t\tif err := json.Unmarshal(rp.Actual, &np.ActualStr); err != nil {\r\n\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: actual must be a string\", path, split, rp.ID)\r\n\t\t}\r\n\t\tif err := json.Unmarshal(rp.Predicted, &np.PredictedStr); err != nil {\r\n"]
[5012.199132, "o", "\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: predicted must be a string\", path, split, rp.ID)\r\n\t\t}\r\n\t\tif len(rp.Probabilities) == 0 || string(rp.Probabilities) == \"null\" {\r\n\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: probabilities are required for classification\", path, split, rp.ID)\r\n\t\t}\r\n\t\tprobs := make(map[string]float64)\r\n\t\tif err := json.Unmarshal(rp.Probabilities, &probs); err != nil {\r\n\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: invalid probabilities\", path, split, rp.ID)\r\n\t\t}\r\n\t\tif len(probs) == 0 {\r\n"]
[5012.19919, "o", "\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: probabilities must not be empty\", path, split, rp.ID)\r\n\t\t}\r\n\t\tsum := 0.0\r\n\t\tfor k, v := range probs {\r\n\t\t\tif k == \"\" {\r\n\t\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: probability class label is empty\", path, split, rp.ID)\r\n\t\t\t}\r\n\t"]
[5012.199248, "o", "\t\tif math.IsNaN(v) || math.IsInf(v, 0) || v < 0 || v > 1 {\r\n\t\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: probability for %q out of range\", path, split, rp.ID, k)\r\n\t\t\t}\r\n\t\t\tsum += v\r\n\t\t}\r\n\t\tif math.Abs(sum-1) > 1e-6 {\r\n\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: probabilities must sum to 1\", path, split, rp.ID)\r\n\t\t}\r\n"]
[5012.199305, "o", "\t\tnp.Probabilities = probs\r\n\t\tnp.HasProbabilities = true\r\n\t}\r\n\treturn np, nil\r\n}\r\n\r\nfunc loadRegressionConfig(path string) (RegressionConfig, error) {\r\n\tvar cfg RegressionConfig\r\n\tif err := readJSON(path, &cfg); err != nil {\r\n\t\treturn RegressionConfig{}, err"]
[5012.199364, "o", "\r\n\t}\r\n\tfor metric, t := range cfg.Thresholds {\r\n\t\tswitch t.Severity {\r\n\t\tcase \"critical\", \"warning\", \"info\":\r\n\t\tdefault:\r\n\t\t\treturn RegressionConfig{}, fmt.Errorf(\"%s: invalid severity %q for metric %q\", path, t.Severity, metric)\r\n\t\t}\r\n\t\tif t.MaxDelta != nil && *t.MaxDelta < 0 {\r\n\t\t\treturn RegressionConfig{}, fmt.Errorf(\"%s: max_delta must be non-negative for metric %q\", path, metric)\r\n\t\t}\r\n"]
[5012.199426, "o", "\t\tif t.MaxRelativeDelta != nil && *t.MaxRelativeDelta < 0 {\r\n\t\t\treturn RegressionConfig{}, fmt.Errorf(\"%s: max_relative_delta must be non-negative for metric %q\", path, metric)\r\n\t\t}\r\n\t\tif t.MaxDelta == nil && t.MinAbsoluteDelta > 0 {\r\n\t\t\treturn RegressionConfig{}, fmt.Errorf(\"%s: invalid min_absolute_delta %f for metric %q; expected non-positive value\", path, t.MinAbsoluteDelta, metric)\r\n\t\t}\r\n\t\tif t.MaxRelativeDelta == nil && t.MinRelativeDelta > 0 {\r\n\t\t\t"]
[5012.199486, "o", "return RegressionConfig{}, fmt.Errorf(\"%s: invalid min_relative_delta %f for metric %q; expected non-positive value\", path, t.MinRelativeDelta, metric)\r\n\t\t}\r\n\t}\r\n\treturn cfg, nil\r\n}\r\n\r\nfunc metricDirection(metric string) string {\r\n\tswitch metric {\r\n\tcase \"mse\", \"rmse\", \"mae\", \"log_loss\", \"smape\":\r\n\t\treturn \"lower-is-better\"\r\n\tdefault:\r\n"]
[5012.199561, "o", "\t\treturn \"higher-is-better\"\r\n\t}\r\n}\r\n\r\nfunc thresholdMaxDelta(t Threshold) float64 {\r\n\tif t.MaxDelta != nil {\r\n\t\treturn *t.MaxDelta\r\n\t}\r\n"]
[5012.199629, "o", "\treturn -t.MinAbsoluteDelta\r\n}\r\n\r\nfunc thresholdMaxRelativeDelta(t Threshold) float64 {\r\n\tif t.MaxRelativeDelta != nil {\r\n\t\treturn *t.MaxRelativeDelta\r\n\t}\r\n\treturn -t.MinRelativeDelta\r\n}\r\n\r\nfunc computeMetrics(taskType string, preds []NormPrediction) EvalResult {\r\n\tswitch taskType {\r\n\tcase \"binary_classification\":\r\n\t\treturn computeBinary(preds)\r\n\tcase \"multiclass_classification\":\r\n\t\treturn computeMulticlass(preds)\r\n\tcase \"regression\":\r\n\t\treturn computeRegression(preds)\r\n\t"]
[5012.199687, "o", "default:\r\n\t\treturn EvalResult{Metrics: map[string]float64{}, MetricOrder: metricOrderForTask(taskType)}\r\n\t}\r\n}\r\n\r\nfunc computeBinary(preds []NormPrediction) EvalResult {\r\n\tclasses := collectClasses(preds, true)\r\n\tif len(classes) != 2 {\r\n\t\treturn EvalResult{Metrics: zeroMetrics(metricOrderForTask(\"binary_classification\")), MetricOrder: metricOrderForTask(\"binary_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}\r\n"]
[5012.199751, "o", "\t}\r\n\tpos := classes[1]\r\n\ttp, fp, fn, tn := 0, 0, 0, 0\r\n\tfor _, p := range preds {\r\n\t\tap := p.ActualStr == pos\r\n\t\tpp := p.PredictedStr == pos\r\n\t\tswitch {\r\n\t\tcase ap && pp:\r\n\t\t\ttp++\r\n\t"]
[5012.199807, "o", "\tcase !ap && pp:\r\n\t\t\tfp++\r\n\t\tcase ap && !pp:\r\n\t\t\tfn++\r\n\t\tdefault:\r\n\t\t\ttn++\r\n\t\t}\r\n"]
[5012.199893, "o", "\t}\r\n\ttotal := len(preds)\r\n\taccuracy := safeDivInt(tp+tn, total)\r\n\tprecision := safeDivInt(tp, tp+fp)\r\n\trecall := safeDivInt(tp, tp+fn)\r\n\tf1 := safeDiv(2*precision*recall, precision+recall)\r\n\tauc := aucROC(preds, pos)\r\n\tll := logLoss(preds, pos)\r\n\tmetrics := map[string]float64{\r\n\t\t\"accuracy\":  accuracy,\r\n\t\t\"precision\": precision,\r\n"]
[5012.199985, "o", "\t\t\"recall\":    recall,\r\n\t\t\"f1\":        f1,\r\n\t\t\"auc_roc\":   auc,\r\n\t\t\"log_loss\":  ll,\r\n\t}\r\n\treturn EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask(\"binary_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}\r\n}\r\n\r\nfunc aucROC(preds []NormPrediction, pos string) float64 {\r\n\ttotalPos := 0\r\n\ttotalNeg := 0\r\n\ttype sample struct {\r\n\t\tp float64\r\n\t\ty int\r\n\t}\r\n\tsamples := make([]sample, 0, len(preds))\r\n\tfor _, pr := range preds {\r\n\t\ty := 0\r\n"]
[5012.200071, "o", "\t\tif pr.ActualStr == pos {\r\n\t\t\ty = 1\r\n\t\t\ttotalPos++\r\n\t\t} else {\r\n"]
