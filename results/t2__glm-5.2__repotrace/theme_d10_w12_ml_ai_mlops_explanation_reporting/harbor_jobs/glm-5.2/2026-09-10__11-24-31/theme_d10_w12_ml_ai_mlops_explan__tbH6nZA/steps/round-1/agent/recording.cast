[3774.953638, "o", "\t}\r\n   708\t\r\n   709\tfunc computeBootstrapCIs(taskType string, preds []NormPrediction, B int, confidence float64, rng *rand.Rand) map[string]CI {\r\n   710\t\tif B <= 0 {\r\n   711\t\t\treturn nil\r\n   712\t\t}\r\n   713\t\tciMetrics := ciMetricsForTask(taskType)\r\n   714\t\tif len(ciMetrics) == 0 {\r\n   715\t\t\treturn nil\r\n   716\t\t}\r\n   717\t\tn := len(preds)\r\n   718\t\tvalues := make(map[string][]float64)\r\n   719\t\tfor _, m := range ciMetrics {\r\n   720\t\t\tvalues[m] = make([]float64, 0, B)\r\n   721\t\t}\r\n   722\t\tfor b := 0; b < B; b++ {\r\n   723\t\t\tresample := make([]NormPrediction, n)\r\n   724\t\t\tfor i := 0; i < n; i++ {\r\n   725\t\t\t\tresample[i] = preds[rng.Intn(n)]\r\n   726\t\t\t}\r\n   727\t\t\tres := computeMetrics(taskType, resample)\r\n   728\t\t\tfor _, m := range ciMetrics {\r\n   729\t\t\t\tvalues[m] = append(values[m], res.Metrics[m])\r\n   730\t\t\t}\r\n   731\t\t}\r\n   732\t\tcis := make(map[string]CI)\r\n   733\t\tfor _, m := range ciMetrics {\r\n   734\t\t\tvals := values[m]\r\n"]
[3774.953742, "o", "   735\t\t\tsort.Float64s(vals)\r\n   736\t\t\tlowerIndex := clampIndex(int(math.Floor((1-confidence)/2*float64(B))), B)\r\n   737\t\t\tupperIndex := clampIndex(int(math.Floor((1+confidence)/2*float64(B)))-1, B)\r\n   738\t\t\tcis[m] = CI{Lower: round6(vals[lowerIndex]), Upper: round6(vals[upperIndex])}\r\n   739\t\t}\r\n   740\t\treturn cis\r\n   741\t}\r\n   742\t\r\n   743\tfunc buildReportJSON(nm NormManifest, bootstrap int, confidence float64, seed int64) ReportJSON {\r\n   744\t\treport := ReportJSON{Model: nm.Model, Splits: make(map[string]SplitReportJSON)}\r\n   745\t\tvar rng *rand.Rand\r\n   746\t\tif bootstrap > 0 {\r\n   747\t\t\trng = rand.New(rand.NewSource(seed))\r\n   748\t\t}\r\n   749\t\tfor _, ev := range nm.Evaluations {\r\n   750\t\t\t"]
[3774.953817, "o", "result := computeMetrics(nm.Model.TaskType, ev.Predictions)\r\n   751\t\t\troundedMetrics := make(map[string]float64)\r\n   752\t\t\tfor _, name := range result.MetricOrder {\r\n   753\t\t\t\troundedMetrics[name] = round6(result.Metrics[name])\r\n   754\t\t\t}\r\n   755\t\t\tsr := SplitReportJSON{Dataset: ev.Dataset, Metrics: roundedMetrics}\r\n   756\t\t\tif nm.Model.TaskType != \"regression\" && result.ConfusionMatrix != nil {\r\n   757\t\t\t\tsr.ConfusionMatrix = result.ConfusionMatrix\r\n   758\t\t\t}\r\n   759\t\t\tif nm.Model.TaskType == \"multiclass_classification\" && len(result.PerClassMetrics) > 0 {\r\n"]
[3774.953912, "o", "   760\t\t\t\tsr.PerClassMetrics = make(map[string]PerClassMetric)\r\n   761\t\t\t\tfor class, pm := range result.PerClassMetrics {\r\n   762\t\t\t\t\tsr.PerClassMetrics[class] = PerClassMetric{\r\n   763\t\t\t\t\t\tPrecision: round6(pm.Precision),\r\n   764\t\t\t\t\t\tRecall:    round6(pm.Recall),\r\n   765\t\t\t\t\t\tF1:        round6(pm.F1),\r\n   766\t\t\t\t\t\tSupport:   pm.Support,\r\n   767\t\t\t\t\t}\r\n   768\t\t\t\t}\r\n   769\t\t\t"]
[3774.954042, "o", "}\r\n   770\t\t\tif bootstrap > 0 {\r\n   771\t\t\t\tsr.ConfidenceIntervals = computeBootstrapCIs(nm.Model.TaskType, ev.Predictions, bootstrap, confidence, rng)\r\n   772\t\t\t}\r\n   773\t\t\treport.Splits[ev.Split] = sr\r\n   774\t\t}\r\n   775\t\treturn report\r\n   776\t}\r\n   777\t\r\n   778\tfunc buildEvaluateMarkdown(report ReportJSON, nm NormManifest, bootstrap int) string {\r\n   779\t\tvar b strings.Builder\r\n   780\t\tfmt.Fprintf(&b, \"# Evaluation Report: %s v%s\\n\\n\", nm.Model.Name, nm.Model.Version)\r\n"]
