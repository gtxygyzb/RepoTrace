[5236.034201, "o", "  1259\t\t\t\t\tfmt.Fprintln(os.Stderr, \"--split contains empty split names\")\r\n  1260\t\t\t\t\treturn 2\r\n  1261\t\t\t\t}\r\n  1262\t\t\t\tselectedSplits = append(selectedSplits, name)\r\n  1263\t\t\t}\r\n  1264\t\t\tseen := make(map[string]bool)\r\n  1265\t\t\tfor _, name := range selectedSplits {\r\n  1266\t\t\t\tif seen[name] {\r\n"]
