[3671.721511, "o", "Verdict         string   `json:\"verdict\"`\r\n   134\t}\r\n   135\t\r\n   136\ttype Overall struct {\r\n   137\t\tVerdict                string `json:\"verdict\"`\r\n   138\t\tCriticalRegressions    int    `json:\"critical_regressions\"`\r\n   139\t\tMaxCriticalRegressions int    `json:\"max_critical_regressions\"`\r\n   140\t\tWarningRegressions     int    `json:\"warning_regressions\"`\r\n   141\t\tMaxWarningRegressions  int    `json:\"max_warning_regressions\"`\r\n"]
[3671.721575, "o", "   142\t}\r\n   143\t\r\n   144\ttype ComparisonData struct {\r\n   145\t\tBaseline           ModelRef                           `json:\"baseline\"`\r\n   146\t\tCandidate          ModelRef                           `json:\"candidate\"`\r\n   147\t\tTaskType           string                             `json:\"task_type\"`\r\n   148\t\tSplitOrder         []string                           `json:\"-\"`\r\n   149\t\tMetricOrder        []string                           `json:\"-\"`\r\n   150\t\tDeltas             map[string]map[string]DeltaEntry   `json:\"deltas\"`\r\n   151\t\tRegressionMetrics  []string                           `json:\"-\"`\r\n   152"]
[3671.721635, "o", "\t\tRegressionAnalysis map[string]RegressionAnalysisEntry `json:\"regression_analysis\"`\r\n   153\t\tOverall            Overall                            `json:\"overall\"`\r\n   154\t}\r\n   155\t\r\n   156\tfunc round6(x float64) float64 {\r\n   157\t\tif math.IsNaN(x) || math.IsInf(x, 0) {\r\n   158\t\t\treturn 0\r\n   159\t"]
[3671.721693, "o", "\t}\r\n   160\t\tr := math.Round(x*1e6) / 1e6\r\n   161\t\tif r == 0 {\r\n   162\t\t\tr = 0\r\n   163\t\t}\r\n   164\t\treturn r\r\n   165\t}\r\n   166\t\r\n   167\tfunc formatFloat6(x float64) string {"]
[3671.721756, "o", "\r\n   168\t\treturn strconv.FormatFloat(round6(x), 'f', 6, 64)\r\n   169\t}\r\n   170\t\r\n   171\tfunc formatFloat2(x float64) string {\r\n   172\t\treturn strconv.FormatFloat(math.Round(x*100)/100, 'f', 2, 64)\r\n   173\t}\r\n   174\t\r\n   175\tfunc safeDiv(num, den float64) float64 {\r\n"]
[3671.721814, "o", "   176\t\tif den == 0 {\r\n   177\t\t\treturn 0\r\n   178\t\t}\r\n   179\t\treturn num / den\r\n   180\t}\r\n"]
