[4406.063501, "o", "\u001b[32m\u001b[K911\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tclasses := make([]string, 0, len(sr.PerClass\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K))\r\n\u001b[32m\u001b[K912\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor c := range sr.PerClass\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K917\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tpm := sr.PerClass\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[c]\r\n\u001b[32m\u001b[K926\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor _, metric := range ci\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[KForTask(nm.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K) {\r\n"]
[4406.063559, "o", "\u001b[32m\u001b[K983\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, name := range strings.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K(*split, \",\") {\r\n\u001b[32m\u001b[K997\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor _, ev := range nm.\u001b[01;31m\u001b[KEvaluations\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K998\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K == name {\r\n"]
[4406.063619, "o", "\u001b[32m\u001b[K1027\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif err := writeFile(filepath.Join(*outputDir, \"\u001b[01;31m\u001b[Kreport.json\u001b[m\u001b[K\"), append(data, '\\n')); err != nil {\r\n\u001b[32m\u001b[K1036\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif baseline.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K != candidate.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K {\r\n"]
[4406.063674, "o", "\u001b[32m\u001b[K1037\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn ComparisonData{}, fmt.Errorf(\"task type mismatch: baseline %q candidate %q\", baseline.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K, candidate.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K1039\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tbase\u001b[01;31m\u001b[KSplit\u001b[m\u001b[Ks := make(map[string]bool)\r\n\u001b[32m\u001b[K1040\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, ev := range baseline.\u001b[01;31m\u001b[KEvaluations\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1041\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tbase\u001b[01;31m\u001b[KSplit\u001b[m\u001b[Ks[ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K] = true\r\n"]
[4406.063739, "o", "\u001b[32m\u001b[K1043\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, ev := range candidate.\u001b[01;31m\u001b[KEvaluations\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1044\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif !base\u001b[01;31m\u001b[KSplit\u001b[m\u001b[Ks[ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K] {\r\n\u001b[32m\u001b[K1045\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in candidate but not baseline\", ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K1048\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, ev := range baseline.\u001b[01;31m\u001b[KEvaluations\u001b[m\u001b[K {\r\n"]
[4406.063795, "o", "\u001b[32m\u001b[K1050\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, cev := range candidate.\u001b[01;31m\u001b[KEvaluations\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1051\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif cev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K == ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1057\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in baseline but not candidate\", ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K1060\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\ttaskType := baseline.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1065\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K:           taskType,\r\n\u001b[32m\u001b[K1066\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KSplit\u001b[m\u001b[KOrder:         []string{},\r\n"]
[4406.063851, "o", "\u001b[32m\u001b[K1069\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tRegression\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K:  []string{},\r\n\u001b[32m\u001b[K1077\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, ev := range baseline.\u001b[01;31m\u001b[KEvaluations\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1078\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcd.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[KOrder = append(cd.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[KOrder, ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K1082\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcd.Regression\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K = append(cd.Regression\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K, metric)\r\n"]
[4406.063929, "o", "\u001b[32m\u001b[K1087\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, ev := range baseline.\u001b[01;31m\u001b[KEvaluations\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1088\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tbaseResults[ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K] = compute\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K(taskType, ev.Predictions)\r\n\u001b[32m\u001b[K1090\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, ev := range candidate.\u001b[01;31m\u001b[KEvaluations\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1091\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcandResults[ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K] = compute\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K(taskType, ev.Predictions)\r\n\u001b[32m\u001b[K1093\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, split := range cd.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[KOrder {\r\n\u001b[32m\u001b[K1096\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tb := baseResults[split].\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[metric]\r\n\u001b[32m\u001b[K1097\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t"]
[4406.064009, "o", "c := candResults[split].\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[metric]\r\n\u001b[32m\u001b[K1115\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, metric := range cd.Regression\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1118\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tregressed\u001b[01;31m\u001b[KSplit\u001b[m\u001b[Ks := []string{}\r\n\u001b[32m\u001b[K1119\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, split := range cd.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[KOrder {\r\n\u001b[32m\u001b[K1120\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tb := baseResults[split].\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[metric]\r\n\u001b[32m\u001b[K1121\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tc := candResults[split].\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[metric]\r\n"]
[4406.06407, "o", "\u001b[32m\u001b[K1138\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tregressed\u001b[01;31m\u001b[KSplit\u001b[m\u001b[Ks = append(regressed\u001b[01;31m\u001b[KSplit\u001b[m\u001b[Ks, split)\r\n\u001b[32m\u001b[K1142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif len(regressed\u001b[01;31m\u001b[KSplit\u001b[m\u001b[Ks) > 0 {\r\n\u001b[32m\u001b[K1154\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tRegressed\u001b[01;31m\u001b[KSplit\u001b[m\u001b[Ks: regressed\u001b[01;31m\u001b[KSplit\u001b[m\u001b[Ks,\r\n"]
[4406.064127, "o", "\u001b[32m\u001b[K1171\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Fprintf(&b, \"Task type: %s\\n\\n\", cd.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K1173\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Fprintln(&b, \"| Metric | \u001b[01;31m\u001b[KSplit\u001b[m\u001b[K | Baseline | Candidate | Delta | Relative Delta |\")\r\n\u001b[32m\u001b[K1176\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, split := range cd.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[KOrder {\r\n\u001b[32m\u001b[K1187\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Fprintln(&b, \"| Metric | Severity | Direction | Regressed \u001b[01;31m\u001b[KSplit\u001b[m\u001b[Ks | Verdict |\")\r\n\u001b[32m\u001b[K1189\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, metric := range cd.Regression\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n"]
[4406.064188, "o", "\u001b[32m\u001b[K1191\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tsplits := strings.Join(ra.Regressed\u001b[01;31m\u001b[KSplit\u001b[m\u001b[Ks, \", \")\r\n"]
