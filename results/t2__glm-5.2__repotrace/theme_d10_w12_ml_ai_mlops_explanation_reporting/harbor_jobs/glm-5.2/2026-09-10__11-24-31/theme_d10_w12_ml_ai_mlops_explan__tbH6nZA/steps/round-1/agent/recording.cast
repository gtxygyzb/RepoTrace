[4371.117656, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"math/rand\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nvar validModelName = regexp.MustCompile(`^[A-Za-z0-9-]+$`)\r\nvar validVersion = regexp.MustCompile(`^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$`)\r\n\r\ntype Manifest struct {\r\n\tModel       Model           `json:\"model\"`\r\n\tEvaluations []RawEvaluation `json:\"evaluations\"`\r\n"]
[4371.117784, "o", "}\r\n\r\ntype Model struct {\r\n\tName     string `json:\"name\"`\r\n\tVersion  string `json:\"version\"`\r\n\tTaskType string `json:\"task_type\"`\r\n}\r\n\r\ntype RawEvaluation struct {\r\n\tSplit       string          `json:\"split\"`\r\n\tDataset     string          `json:\"dataset\"`\r\n\tPredictions []RawPrediction `json:\"predictions\"`\r\n}\r\n\r\ntype RawPrediction struct {\r\n\tID            string          `json:\"id\"`\r\n\tActual        json.RawMessage `json:\"actual\"`\r\n\tPredicted     json.RawMessage `json:\"predicted\"`\r\n\tProbabilities json.RawMessage `json:\"probabilities\"`\r\n}\r\n\r\ntype NormManifest struct {\r\n\tModel       Model\r\n\tEvaluations []NormEvaluation\r\n}\r\n\r\ntype NormEvaluation struct {\r\n\tSplit       string\r\n\tDataset     string\r\n\tPredictions []NormPrediction\r\n}\r\n\r\ntype NormPrediction struct {\r\n\tID               string\r\n\tActualStr        string\r\n\tPredictedStr     string\r\n\tActualNum        float64\r\n\tPredictedNum     float64\r\n\tProbabilities    map[string]float64\r\n\tHasProbabilities bool\r\n}\r\n\r\ntype RegressionConfig struct {\r\n\tThresholds map[string]Thre"]
[4371.117919, "o", "shold `json:\"thresholds\"`\r\n\tRules      Rules                `json:\"rules\"`\r\n}\r\n\r\ntype Threshold struct {\r\n\tMaxDelta         *float64 `json:\"max_delta,omitempty\"`\r\n\tMaxRelativeDelta *float64 `json:\"max_relative_delta,omitempty\"`\r\n\tMinAbsoluteDelta float64  `json:\"min_absolute_delta\"`\r\n\tMinRelativeDelta float64  `json:\"min_relative_delta\"`\r\n\tSeverity         string   `json:\"severity\"`\r\n}\r\n\r\ntype Rules struct {\r\n\tMaxCriticalRegressions int `json:\"max_critical_regressions\"`\r\n\tMaxWarningRegressions  int `json:\"max_warning_regressions\"`\r\n}\r\n\r\ntype ConfusionMatrixReport struct {\r\n\tClasses []string `json:\"classes\"`\r\n\tMatrix  [][]int  `json:\"matrix\"`\r\n}\r\n\r\ntype PerClassMetric struct {\r\n\tPrecision float64 `json:\"precision\"`\r\n\tRecall    float64 `json:\"recall\"`\r\n\tF1        float64 `json:\"f1\"`\r\n\tSupport   int     `json:\"support\"`\r\n}\r\n\r\ntype CI struct {\r\n\tLower float64 `json:\"lower\"`\r\n\tUpper float64 `json:\"upper\"`\r\n}\r\n\r\ntype SplitReportJSON struct {\r\n\tDataset             string                    `json:\"dataset\"`\r\n\tMetrics"]
[4371.118143, "o", "             map[string]float64        `json:\"metrics\"`\r\n\tConfusionMatrix     *ConfusionMatrixReport    `json:\"confusion_matrix,omitempty\"`\r\n\tPerClassMetrics     map[string]PerClassMetric `json:\"per_class_metrics,omitempty\"`\r\n\tConfidenceIntervals map[string]CI             `json:\"confidence_intervals,omitempty\"`\r\n}\r\n\r\ntype ReportJSON struct {\r\n\tModel  Model                      `json:\"model\"`\r\n\tSplits map[string]SplitReportJSON `json:\"splits\"`\r\n}\r\n\r\ntype EvalResult struct {\r\n\tMetrics         map[string]float64\r\n\tMetricOrder     []string\r\n\tConfusionMatrix *ConfusionMatrixReport\r\n\tPerClassMetrics map[string]PerClassMetric\r\n}\r\n\r\ntype ModelRef struct {\r\n\tName    string `json:\"name\"`\r\n\tVersion string `json:\"version\"`\r\n}\r\n\r\ntype DeltaEntry struct {\r\n\tBaseline      float64  `json:\"baseline\"`\r\n\tCandidate     float64  `json:\"candidate\"`\r\n\tAbsoluteDelta float64  `json:\"absolute_delta\"`\r\n\tRelativeDelta *float64 `json:\"relative_delta\"`\r\n}\r\n\r\ntype RegressionAnalysisEntry struct {\r\n\tSeverity        string   `json:\"severity\""]
[4371.118246, "o", "`\r\n\tDirection       string   `json:\"direction\"`\r\n\tRegressedSplits []string `json:\"regressed_splits\"`\r\n\tVerdict         string   `json:\"verdict\"`\r\n}\r\n\r\ntype Overall struct {\r\n\tVerdict                string `json:\"verdict\"`\r\n\tCriticalRegressions    int    `json:\"critical_regressions\"`\r\n\tMaxCriticalRegressions int    `json:\"max_critical_regressions\"`\r\n\tWarningRegressions     int    `json:\"warning_regressions\"`\r\n\tMaxWarningRegressions  int    `json:\"max_warning_regressions\"`\r\n}\r\n\r\ntype ComparisonData struct {\r\n\tBaseline           ModelRef                           `json:\"baseline\"`\r\n\tCandidate          ModelRef                           `json:\"candidate\"`\r\n\tTaskType           string                             `json:\"task_type\"`\r\n\tSplitOrder         []string                           `json:\"-\"`\r\n\tMetricOrder        []string                           `json:\"-\"`\r\n\tDeltas             map[string]map[string]DeltaEntry   `json:\"deltas\"`\r\n\tRegressionMetrics  []string                           `json:\"-\"`\r\n\tRegressionAnal"]
[4371.11832, "o", "ysis map[string]RegressionAnalysisEntry `json:\"regression_analysis\"`\r\n\tOverall            Overall                            `json:\"overall\"`\r\n}\r\n\r\nfunc round6(x float64) float64 {\r\n\tif math.IsNaN(x) || math.IsInf(x, 0) {\r\n\t\treturn 0\r\n\t}\r\n\tr := math.Round(x*1e6) / 1e6\r\n\tif r == 0 {\r\n\t\tr = 0\r\n\t}\r\n\treturn r\r\n}\r\n\r\nfunc formatFloat6(x float64) string {\r\n\treturn strconv.FormatFloat(round6(x), 'f', 6, 64)\r\n}\r\n\r\nfunc formatFloat2(x float64) string {\r\n\treturn strconv.FormatFloat(math.Round(x*100)/100, 'f', 2, 64)\r\n}\r\n\r\nfunc safeDiv(num, den float64) float64 {\r\n\tif den == 0 {\r\n\t\treturn 0\r\n\t}\r\n\treturn num / den\r\n}\r\n\r\nfunc safeDivInt(num, den int) float64 {\r\n\tif den == 0 {\r\n\t\treturn 0\r\n\t}\r\n\treturn float64(num) / float64(den)\r\n}\r\n\r\nfunc mean(vals []float64) float64 {\r\n\tif len(vals) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tsum := 0.0\r\n\tfor _, v := range vals {\r\n\t\tsum += v\r\n\t}\r\n\treturn sum / float64(len(vals))\r\n}\r\n\r\nfunc weighted(vals []float64, supports []int) float64 {\r\n\tif len(vals) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tsumVal := 0.0\r\n\tsumSup := 0\r"]
[4371.118388, "o", "\n\tfor i, v := range vals {\r\n\t\tsumVal += v * float64(supports[i])\r\n\t\tsumSup += supports[i]\r\n\t}\r\n\tif sumSup == 0 {\r\n\t\treturn 0\r\n\t}\r\n\treturn sumVal / float64(sumSup)\r\n}\r\n\r\nfunc clampIndex(i, n int) int {\r\n\tif i < 0 {\r\n\t\treturn 0\r\n\t}\r\n\tif i >= n {\r\n\t\treturn n - 1\r\n\t}\r\n\treturn i\r\n}\r\n\r\nfunc metricOrderForTask(taskType string) []string {\r\n\tswitch taskType {\r\n\tcase \"binary_classification\":\r\n\t\treturn []string{\"accuracy\", \"precision\", \"recall\", \"f1\", \"auc_roc\", \"log_loss\"}\r\n\tcase \"multiclass_classification\":\r\n\t\treturn []string{\"accuracy\", \"precision_micro\", \"recall_micro\", \"f1_micro\", \"precision_macro\", \"recall_macro\", \"f1_macro\", \"precision_weighted\", \"recall_weighted\", \"f1_weighted\"}\r\n\tcase \"regression\":\r\n\t\treturn []string{\"mse\", \"rmse\", \"mae\", \"r_squared\", \"smape\"}\r\n\tdefault:\r\n\t\treturn nil\r\n\t}\r\n}\r\n\r\nfunc ciMetricsForTask(taskType string) []string {\r\n\tswitch taskType {\r\n\tcase \"binary_classification\":\r\n\t\treturn []string{\"accuracy\", \"precision\", \"recall\", \"f1\", \"auc_roc\"}\r\n\tcase \"multiclass_classification\":\r\n\t\treturn ["]
[4371.118449, "o", "]string{\"accuracy\", \"f1_macro\", \"f1_weighted\"}\r\n\tcase \"regression\":\r\n\t\treturn []string{\"mse\", \"rmse\", \"mae\", \"r_squared\"}\r\n\tdefault:\r\n\t\treturn nil\r\n\t}\r\n}\r\n\r\nfunc sortClasses(classes []string) {\r\n\tsort.Slice(classes, func(i, j int) bool {\r\n\t\tai := strings.ToLower(classes[i])\r\n\t\taj := strings.ToLower(classes[j])\r\n\t\tif ai != aj {\r\n\t\t\treturn ai < aj\r\n"]
