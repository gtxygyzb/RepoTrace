[5034.846315, "o", "   144\t\tMaxWarningRegressions  int    `json:\"max_warning_regressions\"`\r\n   145\t}\r\n   146\t\r\n   147\ttype ComparisonData struct {\r\n   148\t\tBaseline           ModelRef                           `json:\"baseline\"`\r\n   149\t\tCandidate          ModelRef                           `json:\"candidate\"`\r\n   150\t\tTaskType           string                             `json:\"task_type\"`\r\n   151\t\tSplitOrder         []string                           `json:\"-\"`\r\n   152\t\tMetricOrder        []string                           `json:\"-\"`\r\n   153\t\tDeltas             map[string]map[string]DeltaEntry   `json:\"deltas\"`\r\n   154\t\tRegressionMetrics  []string                           `json:\"-\"`\r\n"]
[5034.846375, "o", "   155\t\tRegressionAnalysis map[string]RegressionAnalysisEntry `json:\"regression_analysis\"`\r\n   156\t\tOverall            Overall                            `json:\"overall\"`\r\n   157\t}\r\n   158\t\r\n   159\tfunc round6(x float64) float64 {\r\n   160\t\tif math.IsNaN(x) || math.IsInf(x, 0) {\r\n   161\t\t\treturn 0\r\n   162\t\t}\r\n   163\t\tr := math.Round(x*1e6) / 1e6\r\n"]
[5034.846433, "o", "   164\t\tif r == 0 {\r\n   165\t\t\tr = 0\r\n   166\t\t}\r\n   167\t\treturn r\r\n   168\t}\r\n   169\t\r\n   170\tfunc formatFloat6(x float64) string {\r\n   171\t\treturn strconv.FormatFloat(round6(x), 'f', 6, 64)\r\n   172\t}\r\n   173\t\r\n"]
[5034.846492, "o", "   174\tfunc formatFloat2(x float64) string {\r\n   175\t\treturn strconv.FormatFloat(math.Round(x*100)/100, 'f', 2, 64)\r\n   176\t}\r\n   177\t\r\n   178\tfunc safeDiv(num, den float64) float64 {\r\n   179\t\tif den == 0 {\r\n   180\t\t\treturn 0\r\n   181\t\t}\r\n   182\t\treturn num / den\r\n   183\t}\r\n"]
[5034.846549, "o", "   184\t\r\n   185\tfunc safeDivInt(num, den int) float64 {\r\n   186\t\tif den == 0 {\r\n   187\t\t\treturn 0\r\n   188\t\t}\r\n   189\t\treturn float64(num) / float64(den)\r\n   190\t}\r\n"]
[5034.846611, "o", "   191\t\r\n   192\tfunc mean(vals []float64) float64 {\r\n   193\t\tif len(vals) == 0 {\r\n   194\t\t\treturn 0\r\n   195\t\t}\r\n   196\t\tsum := 0.0\r\n   197\t\tfor _, v := range vals {\r\n   198\t\t\tsum += v\r\n   199\t\t}\r\n   200"]
[5034.846668, "o", "\t\treturn sum / float64(len(vals))\r\n   201\t}\r\n   202\t\r\n   203\tfunc weighted(vals []float64, supports []int) float64 {\r\n   204\t\tif len(vals) == 0 {\r\n   205\t\t\treturn 0\r\n   206\t\t}\r\n   207\t\tsumVal := 0.0\r\n   208\t\tsumSup := 0\r\n"]
[5034.846728, "o", "   209\t\tfor i, v := range vals {\r\n   210\t\t\tsumVal += v * float64(supports[i])\r\n   211\t\t\tsumSup += supports[i]\r\n   212\t\t}\r\n   213\t\tif sumSup == 0 {\r\n   214\t\t\treturn 0\r\n   215\t\t}\r\n   216\t\treturn sumVal / float64(sumSup)\r\n   217\t}\r\n"]
[5034.846783, "o", "   218\t\r\n   219\tfunc clampIndex(i, n int) int {\r\n   220\t\tif i < 0 {\r\n   221\t\t\treturn 0\r\n   222\t\t}\r\n   223\t\tif i >= n {\r\n   224\t\t\treturn n - 1\r\n   225"]
[5034.846838, "o", "\t\t}\r\n   226\t\treturn i\r\n   227\t}\r\n   228\t\r\n   229\tfunc metricOrderForTask(taskType string) []string {\r\n   230\t\tswitch taskType {\r\n   231\t\tcase \"binary_classification\":\r\n"]
[5034.8469, "o", "   232\t\t\treturn []string{\"accuracy\", \"precision\", \"recall\", \"f1\", \"auc_roc\", \"log_loss\"}\r\n   233\t\tcase \"multiclass_classification\":\r\n   234\t\t\treturn []string{\"accuracy\", \"precision_micro\", \"recall_micro\", \"f1_micro\", \"precision_macro\", \"recall_macro\", \"f1_macro\", \"precision_weighted\", \"recall_weighted\", \"f1_weighted\"}\r\n   235\t\tcase \"regression\":\r\n   236\t\t\treturn []string{\"mse\", \"rmse\", \"mae\", \"r_squared\", \"smape\"}\r\n   237\t\tdefault:\r\n"]
[5034.846958, "o", "   238\t\t\treturn nil\r\n   239\t\t}\r\n   240\t}\r\n   241\t\r\n   242\tfunc ciMetricsForTask(taskType string) []string {\r\n   243\t\tswitch taskType {\r\n   244\t\tcase \"binary_classification\":\r\n   245\t\t\treturn []string{\"accuracy\", \"precision\", \"recall\", \"f1\", \"auc_roc\"}\r\n   246\t\tcase \"multiclass_classification\":\r\n"]
[5034.847016, "o", "   247\t\t\treturn []string{\"accuracy\", \"f1_macro\", \"f1_weighted\"}\r\n   248\t\tcase \"regression\":\r\n   249\t\t\treturn []string{\"mse\", \"rmse\", \"mae\", \"r_squared\", \"smape\"}\r\n   250\t\tdefault:\r\n   251\t\t\treturn nil\r\n   252\t\t}\r\n   253\t}\r\n   254\t\r\n"]
[5034.847072, "o", "   255\tfunc sortClasses(classes []string) {\r\n   256\t\tsort.Slice(classes, func(i, j int) bool {\r\n   257\t\t\tai := strings.ToLower(classes[i])\r\n   258\t\t\taj := strings.ToLower(classes[j])\r\n   259\t\t\tif ai != aj {\r\n   260\t\t\t\treturn ai < aj\r\n   261\t\t\t}\r\n   262"]
[5034.847128, "o", "\t\t\treturn classes[i] < classes[j]\r\n   263\t\t})\r\n   264\t}\r\n   265\t\r\n   266\tfunc collectClasses(preds []NormPrediction, fromActualOnly bool) []string {\r\n   267\t\tset := make(map[string]bool)\r\n   268\t\tfor _, p := range preds {\r\n   269\t\t\tif p.ActualStr != \"\" {\r\n   270\t\t\t\tset[p.ActualStr] = true\r\n"]
[5034.847188, "o", "   271\t\t\t}\r\n   272\t\t\tif !fromActualOnly && p.PredictedStr != \"\" {\r\n   273\t\t\t\tset[p.PredictedStr] = true\r\n   274\t\t\t}\r\n   275\t\t}\r\n   276\t\tclasses := make([]string, 0, len(set))\r\n   277\t\tfor c := range set {\r\n   278\t\t\tclasses = append(classes, c)"]
[5034.847242, "o", "\r\n   279\t\t}\r\n   280\t\tsortClasses(classes)\r\n"]
