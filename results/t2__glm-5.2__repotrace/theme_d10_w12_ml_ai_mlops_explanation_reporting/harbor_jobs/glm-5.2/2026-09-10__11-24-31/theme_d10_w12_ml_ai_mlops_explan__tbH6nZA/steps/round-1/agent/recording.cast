[3721.109493, "o", "   975\t\t\tRegressionAnalysis: make(map[string]RegressionAnalysisEntry),\r\n   976\t\t\tOverall: Overall{\r\n   977\t\t\t\tVerdict:                \"PASS\",\r\n   978\t\t\t\tMaxCriticalRegressions: cfg.Rules.MaxCriticalRegressions,\r\n   979\t\t\t"]
