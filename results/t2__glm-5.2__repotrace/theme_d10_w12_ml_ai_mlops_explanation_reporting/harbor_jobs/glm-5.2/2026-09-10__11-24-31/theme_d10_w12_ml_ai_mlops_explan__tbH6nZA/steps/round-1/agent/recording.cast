[2681.53412, "o", "func computeRegression(preds []NormPrediction) EvalResult {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.534185, "o", "> "]
[2681.534247, "o", "    n := len(preds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.534334, "o", "    actuals := make([]float64, n)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.534396, "o", "> "]
[2681.534467, "o", "    predicted := make([]float64, n)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.53453, "o", "> "]
[2681.534589, "o", "    for i, p := range preds {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.534706, "o", "        actuals[i] = p.ActualNum\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.53477, "o", "> "]
[2681.534844, "o", "        predicted[i] = p.PredictedNum\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.534914, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.534975, "o", "    se := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.53504, "o", "    ae := 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.535104, "o", "> "]
[2681.535169, "o", "    smapeSum := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.535235, "o", "    smapeCount := 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.535328, "o", "    for i := 0; i < n; i++ {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.535389, "o", "> "]
[2681.535476, "o", "        diff := actuals[i] - predicted[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.535541, "o", "> "]
[2681.535604, "o", "        se += diff * diff\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.535692, "o", "        ae += math.Abs(diff)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.535756, "o", "> "]
[2681.535904, "o", "        denom := math.Abs(actuals[i]) + math.Abs(predicted[i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.535969, "o", "> "]
[2681.536033, "o", "        if denom >= 1e-10 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.536189, "o", "            smapeSum += 2 * math.Abs(diff) / denom\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.536253, "o", "> "]
[2681.536321, "o", "            smapeCount++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.536385, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[2681.536449, "o", "\u001b[?2004h> "]
[2681.536511, "o", "    mse := se / float64(n)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.536577, "o", "> "]
[2681.536642, "o", "    rmse := math.Sqrt(mse)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.536727, "o", "    mae := ae / float64(n)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.53679, "o", "> "]
[2681.536849, "o", "    meanActual := mean(actuals)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.53692, "o", ">     ssRes := 0.0\r\n\u001b[?2004l\r"]
[2681.536985, "o", "\u001b[?2004h> "]
[2681.537049, "o", "    ssTot := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.537137, "o", "    for _, a := range actuals {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.537207, "o", "> "]
[2681.537316, "o", "        ssTot += (a - meanActual) * (a - meanActual)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.537383, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.537476, "o", "    for i := range actuals {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.537539, "o", "> "]
[2681.537624, "o", "        diff := actuals[i] - predicted[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.537688, "o", "> "]
[2681.537762, "o", "        ssRes += diff * diff\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.537826, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.537899, "o", "    rSquared := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.53797, "o", "    if ssTot != 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.538035, "o", "> "]
[2681.5381, "o", "        rSquared = 1 - ssRes/ssTot\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.538165, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.538228, "o", "    smape := 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.538293, "o", "> "]
[2681.538358, "o", "    if smapeCount > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.538506, "o", "        smape = smapeSum / float64(smapeCount) * 100\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.53857, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.538682, "o", "    metrics := map[string]float64{\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.538746, "o", "> "]
[2681.538845, "o", "        \"mse\": mse,\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.538906, "o", ">         \"rmse\": rmse,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.539033, "o", "        \"mae\": mae,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.539126, "o", "        \"r_squared\": rSquared,\r\n\u001b[?2004l\r"]
[2681.539221, "o", "\u001b[?2004h>         \"smape\": smape,\r\n\u001b[?2004l\r"]
[2681.539313, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.539494, "o", "    return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask(\"regression\")}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.539562, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.539624, "o", "> "]
[2681.539747, "o", "func zeroMetrics(order []string) map[string]float64 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.53981, "o", "> "]
