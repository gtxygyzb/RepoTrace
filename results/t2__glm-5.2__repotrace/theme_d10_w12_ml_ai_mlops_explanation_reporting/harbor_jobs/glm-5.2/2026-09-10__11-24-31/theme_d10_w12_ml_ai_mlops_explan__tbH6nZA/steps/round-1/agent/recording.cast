[2897.936856, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.936967, "o", "    if err := os.MkdirAll(*outputDir, 0755); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.937055, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.937107, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
