[2930.809765, "o", "   430\tfunc computeBinary(preds []NormPrediction) EvalResult {\r\n   431\t\tclasses := collectClasses(preds, true)\r\n   432\t\tif len(classes) != 2 {\r\n   433\t\t\treturn EvalResult{Metrics: zeroMetrics(metricOrderForTask(\"binary_classification\")), MetricOrder: metricOrderForTask(\"binary_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}\r\n   434\t\t}\r\n   435\t\tpos := classes[1]\r\n   436\t\tneg := classes[0]\r\n   437\t\ttp, fp, fn, tn := 0, 0, 0, 0\r\n   438\t\tfor _, p := range preds {\r\n   439\t\t\tap := p.ActualStr == pos\r\n   440\t\t\tpp := p.PredictedStr == pos\r\n"]
[2930.809845, "o", "   441\t\t\tswitch {\r\n   442\t\t\tcase ap && pp:\r\n   443\t\t\t\ttp++\r\n   444\t\t\tcase !ap && pp:\r\n   445\t\t\t\tfp++\r\n"]
[2930.810723, "o", "\u001b[?2004h"]
