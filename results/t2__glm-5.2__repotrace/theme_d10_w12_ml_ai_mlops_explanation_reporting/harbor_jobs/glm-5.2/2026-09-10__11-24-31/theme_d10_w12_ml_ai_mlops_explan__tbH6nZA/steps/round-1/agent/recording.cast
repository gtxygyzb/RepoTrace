[5670.850907, "o", "  1321\t\tif cd.Overall.Verdict == \"FAIL\" {\r\n  1322\t\t\treturn 1\r\n  1323\t\t}\r\n  1324\t\treturn 0\r\n"]
[5670.850974, "o", "  1325\t}\r\n  1326\t\r\n  1327\tfunc primaryMetricsForTask(taskType string) []string {\r\n  1328\t\tswitch taskType {\r\n  1329\t\tcase \"binary_classification\":\r\n  1330\t\t\treturn []string{\"accuracy\", \"f1\", \"auc_roc\"}\r\n  1331\t\tcase \"multiclass_classification\":\r\n  1332\t\t\treturn []string{\"accuracy\", \"f1_macro\"}\r\n  1333\t\tcase \"regression\":\r\n"]
[5670.851032, "o", "  1334\t\t\treturn []string{\"rmse\", \"mae\", \"r_squared\"}\r\n  1335\t\tdefault:\r\n  1336\t\t\treturn nil\r\n  1337\t\t}\r\n  1338\t}\r\n  1339\t\r\n  1340\ttype SummaryModelJSON struct {\r\n  1341\t\tName     string `json:\"name\"`\r\n  1342\t\tVersion  string `json:\"version\"`\r\n  1343"]
[5670.85109, "o", "\t\tTaskType string `json:\"task_type\"`\r\n  1344\t}\r\n  1345\t\r\n  1346\ttype SummaryJSON struct {\r\n  1347\t\tModel          SummaryModelJSON   `json:\"model\"`\r\n  1348\t\tSplitCount     int                `json:\"split_count\"`\r\n  1349\t\tPrimaryMetrics map[string]float64 `json:\"primary_metrics\"`\r\n"]
[5670.851148, "o", "  1350\t}\r\n  1351\t\r\n  1352\tfunc runSummary(args []string) int {\r\n  1353\t\tfs := flag.NewFlagSet(\"summary\", flag.ContinueOnError)\r\n  1354\t\treportPath := fs.String(\"report\", \"report.json\", \"path to evaluation report JSON\")\r\n  1355\t\tjsonOutput := fs.Bool(\"json\", false, \"output summary as JSON\")\r\n  1356\t\tif err := fs.Parse(args); err != nil {\r\n  1357\t\t\treturn 2\r\n  1358\t\t}\r\n  1359\t"]
[5670.851216, "o", "\r\n  1360\t\tdata, err := os.ReadFile(*reportPath)\r\n  1361\t\tif err != nil {\r\n  1362\t\t\tfmt.Fprintln(os.Stderr, err)\r\n  1363\t\t\treturn 2\r\n  1364\t\t}\r\n  1365\t\r\n  1366\t\tvar report ReportJSON\r\n  1367\t\tif err := json.Unmarshal(data, &report); err != nil {\r\n"]
[5670.85128, "o", "  1368\t\t\tfmt.Fprintf(os.Stderr, \"failed to parse report: %v\\n\", err)\r\n  1369\t\t\treturn 2\r\n  1370\t\t}\r\n  1371\t\r\n  1372\t\tprimary := primaryMetricsForTask(report.Model.TaskType)\r\n  1373\t\tif primary == nil {\r\n  1374\t\t\tfmt.Fprintf(os.Stderr, \"unknown task type %q\\n\", report.Model.TaskType)\r\n  1375\t\t\treturn 2\r\n"]
[5670.851337, "o", "  1376\t\t}\r\n  1377\t\tif len(report.Splits) == 0 {\r\n  1378\t\t\tfmt.Fprintln(os.Stderr, \"report contains no splits\")\r\n  1379\t\t\treturn 2\r\n  1380\t\t}\r\n  1381\t\r\n  1382\t\tprimaryMetrics := make(map[string]float64)\r\n"]
[5670.851393, "o", "  1383\t\tmetricValues := make([]string, 0, len(primary))\r\n  1384\t\tfor _, metric := range primary {\r\n  1385\t\t\tvals := make([]float64, 0, len(report.Splits))\r\n  1386\t\t\tfor _, split := range report.Splits {\r\n  1387\t\t\t\tif v, ok := split.Metrics[metric]; ok {\r\n  1388\t\t\t\t\tvals = append(vals, v)\r\n  1389\t\t\t\t}\r\n  1390\t\t\t}\r\n  1391\t\t\tif len(vals) == 0 {\r\n"]
[5670.851453, "o", "  1392\t\t\t\tcontinue\r\n  1393\t\t\t}\r\n  1394\t\t\tavg := mean(vals)\r\n  1395\t\t\trounded := math.Round(avg*1e4) / 1e4\r\n  1396\t\t\tif rounded == 0 {\r\n  1397\t\t\t\trounded = 0\r\n  1398\t\t\t}\r\n  1399\t\t\tprimaryMetrics[metric] = rounded\r\n  1400\t\t\tmetricValues = append(metricValues, fmt.Sprintf(\"%s=%.4f\", metric, avg))\r\n"]
[5670.851517, "o", "  1401\t\t}\r\n  1402\t\r\n  1403\t\tif *jsonOutput {\r\n  1404\t\t\tout := SummaryJSON{\r\n  1405\t\t\t\tModel: SummaryModelJSON{\r\n  1406\t\t\t"]
[5670.851579, "o", "\t\tName:     report.Model.Name,\r\n  1407\t\t\t\t\tVersion:  report.Model.Version,\r\n  1408\t\t\t\t\tTaskType: report.Model.TaskType,\r\n  1409\t\t\t\t},\r\n  1410\t\t\t\tSplitCount:     len(report.Splits),\r\n  1411\t\t\t\tPrimaryMetrics: primaryMetrics,\r\n  1412\t\t\t}\r\n  1413\t\t\tjsonData, err := json.MarshalIndent(out, \"\", \"  \")\r\n  1414\t\t\tif err != nil {\r\n  1415\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[5670.851634, "o", "  1416\t\t\t\treturn 2\r\n  1417\t\t\t}\r\n  1418\t\t\tfmt.Println(string(jsonData))\r\n  1419\t\t\treturn 0\r\n  1420\t\t}\r\n"]
