[2645.559675, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2645.559738, "o", "> "]
[2645.559956, "o", "    if len(raw.Evaluations) == 0 {\r\n\u001b[?2004l\r"]
[2645.560022, "o", "\u001b[?2004h> "]
