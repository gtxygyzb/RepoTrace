[5025.596538, "o", "\u001b[32m\u001b[K949\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K := fs.String(\"\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K\", \"\", \"comma-separated list of \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K names to include\")\r\n\u001b[32m\u001b[K968\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif *\u001b[01;31m\u001b[Kbootstrap\u001b[m\u001b[K < 0 {\r\n\u001b[32m\u001b[K969\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"--\u001b[01;31m\u001b[Kbootstrap\u001b[m\u001b[K must be non-negative\")\r\n\u001b[32m\u001b[K981\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks []string\r\n\u001b[32m\u001b[K982\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif *\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K != \"\" {\r\n\u001b[32m\u001b[K983\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, name := range strings.Split(*\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K, \",\") {\r\n\u001b[32m\u001b[K986\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tfmt.Fprintln(os.Stderr, \"--\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K contains empty \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K names\")\r\n"]
[5025.596678, "o", "\u001b[32m\u001b[K989\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks = append(\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks, name)\r\n\u001b[32m\u001b[K991\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[KSet := make(map[string]bool)\r\n\u001b[32m\u001b[K992\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, name := range \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks {\r\n\u001b[32m\u001b[K993\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[KSet[name] = true\r\n\u001b[32m\u001b[K995\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, name := range \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks {\r\n\u001b[32m\u001b[K1004\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tfmt.Fprintf(os.Stderr, \"\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q not found in manifest\\n\", name)\r\n\u001b[32m\u001b[K1009\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treport := buildReportJSON(nm, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks, *\u001b[01;31m\u001b[Kbootstrap\u001b[m\u001b[K, *confidence, *seed)\r\n\u001b[32m\u001b[K1015\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tmd := buildEvaluateMarkdown(report, nm, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks, *\u001b[01;31m\u001b[Kbootstrap\u001b[m\u001b[K)\r\n"]
[5025.596797, "o", "\u001b[32m\u001b[K1035\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K\u001b[01;31m\u001b[KbuildComparisonData\u001b[m\u001b[K(baseline, candidate NormManifest, cfg RegressionConfig, excludedMetrics map[string]bool) (ComparisonData, error) {\r\n\u001b[32m\u001b[K1045\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn ComparisonData{}, fmt.Errorf(\"\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q present in candidate but not baseline\", ev.Split)\r\n\u001b[32m\u001b[K1057\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn ComparisonData{}, fmt.Errorf(\"\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q present in baseline but not candidate\", ev.Split)\r\n\u001b[32m\u001b[K1096\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K := range cd.SplitOrder {\r\n\u001b[32m\u001b[K1097\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t"]
