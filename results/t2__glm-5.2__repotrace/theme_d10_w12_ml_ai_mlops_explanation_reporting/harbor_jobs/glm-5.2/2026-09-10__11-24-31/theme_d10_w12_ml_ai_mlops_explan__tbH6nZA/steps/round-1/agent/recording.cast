[2897.912095, "o", "            cd.RegressionMetrics = append(cd.RegressionMetrics, metric)\r\n\u001b[?2004l\r"]
[2897.912151, "o", "\u001b[?2004h> "]
[2897.912206, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.912261, "o", ">     }\r\n\u001b[?2004l\r"]
[2897.912317, "o", "\u001b[?2004h> "]
[2897.9126, "o", "    baseResults := make(map[string]EvalResult)\r\n\u001b[?2004l\r"]
[2897.912654, "o", "\u001b[?2004h> "]
[2897.912931, "o", "    candResults := make(map[string]EvalResult)\r\n\u001b[?2004l\r"]
[2897.912987, "o", "\u001b[?2004h> "]
[2897.913209, "o", "    for _, ev := range baseline.Evaluations {\r\n\u001b[?2004l\r"]
[2897.913263, "o", "\u001b[?2004h> "]
[2897.913692, "o", "        baseResults[ev.Split] = computeMetrics(taskType, ev.Predictions)\r\n\u001b[?2004l\r"]
[2897.913747, "o", "\u001b[?2004h>     }\r\n"]
[2897.9138, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[2897.914095, "o", "    for _, ev := range candidate.Evaluations {\r\n\u001b[?2004l\r"]
[2897.914151, "o", "\u001b[?2004h> "]
[2897.914583, "o", "        candResults[ev.Split] = computeMetrics(taskType, ev.Predictions)\r\n\u001b[?2004l\r"]
[2897.914639, "o", "\u001b[?2004h>     }\r\n"]
[2897.914694, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[2897.914958, "o", "    for _, split := range cd.SplitOrder {\r\n\u001b[?2004l\r"]
[2897.915015, "o", "\u001b[?2004h> "]
[2897.915333, "o", "        cd.Deltas[split] = make(map[string]DeltaEntry)\r\n\u001b[?2004l\r"]
[2897.915388, "o", "\u001b[?2004h> "]
[2897.915619, "o", "        for _, metric := range metricOrder {\r\n\u001b[?2004l\r"]
[2897.915673, "o", "\u001b[?2004h> "]
[2897.915979, "o", "            b := baseResults[split].Metrics[metric]\r\n\u001b[?2004l\r"]
[2897.916035, "o", "\u001b[?2004h> "]
[2897.916338, "o", "            c := candResults[split].Metrics[metric]\r\n\u001b[?2004l\r"]
[2897.916392, "o", "\u001b[?2004h> "]
[2897.91653, "o", "            abs := c - b\r\n\u001b[?2004l\r"]
[2897.916584, "o", "\u001b[?2004h> "]
[2897.91675, "o", "            var rel *float64\r\n\u001b[?2004l\r"]
[2897.916804, "o", "\u001b[?2004h> "]
[2897.917006, "o", "            if math.Abs(b) > 1e-10 {\r\n\u001b[?2004l\r"]
[2897.917063, "o", "\u001b[?2004h> "]
[2897.917292, "o", "                r := (c - b) / math.Abs(b)\r\n\u001b[?2004l\r"]
[2897.917347, "o", "\u001b[?2004h> "]
[2897.917492, "o", "                r = round6(r)\r\n\u001b[?2004l\r"]
[2897.917547, "o", "\u001b[?2004h> "]
[2897.917681, "o", "                rel = &r\r\n\u001b[?2004l\r"]
[2897.917736, "o", "\u001b[?2004h> "]
[2897.9178, "o", "            }\r\n\u001b[?2004l\r"]
[2897.91786, "o", "\u001b[?2004h> "]
[2897.918137, "o", "            cd.Deltas[split][metric] = DeltaEntry{\r\n\u001b[?2004l\r"]
[2897.918195, "o", "\u001b[?2004h> "]
[2897.918421, "o", "                Baseline:      round6(b),\r\n\u001b[?2004l\r"]
[2897.918475, "o", "\u001b[?2004h> "]
[2897.918694, "o", "                Candidate:     round6(c),\r\n\u001b[?2004l\r"]
[2897.918747, "o", "\u001b[?2004h> "]
[2897.919007, "o", "                AbsoluteDelta: round6(abs),\r\n\u001b[?2004l\r"]
[2897.919062, "o", "\u001b[?2004h> "]
[2897.919265, "o", "                RelativeDelta: rel,\r\n\u001b[?2004l\r"]
[2897.919321, "o", "\u001b[?2004h> "]
[2897.919392, "o", "            }\r\n\u001b[?2004l\r"]
[2897.919447, "o", "\u001b[?2004h> "]
[2897.919513, "o", "        }\r\n\u001b[?2004l\r"]
[2897.919569, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[2897.919624, "o", "\u001b[?2004h> "]
[2897.919734, "o", "    criticalCount := 0\r\n\u001b[?2004l\r"]
[2897.919788, "o", "\u001b[?2004h> "]
[2897.919911, "o", "    warningCount := 0\r\n\u001b[?2004l\r"]
[2897.919965, "o", "\u001b[?2004h> "]
[2897.920222, "o", "    for _, metric := range cd.RegressionMetrics {\r\n\u001b[?2004l\r"]
[2897.920275, "o", "\u001b[?2004h> "]
[2897.920463, "o", "        t := cfg.Thresholds[metric]\r\n\u001b[?2004l\r"]
[2897.920518, "o", "\u001b[?2004h> "]
[2897.920715, "o", "        regressedSplits := []string{}\r\n\u001b[?2004l\r"]
[2897.92077, "o", "\u001b[?2004h> "]
[2897.921009, "o", "        for _, split := range cd.SplitOrder {\r\n\u001b[?2004l\r"]
[2897.921066, "o", "\u001b[?2004h> "]
[2897.921335, "o", "            b := baseResults[split].Metrics[metric]\r\n\u001b[?2004l\r"]
[2897.92139, "o", "\u001b[?2004h> "]
[2897.921675, "o", "            c := candResults[split].Metrics[metric]\r\n\u001b[?2004l\r"]
[2897.92173, "o", "\u001b[?2004h> "]
[2897.921855, "o", "            abs := c - b\r\n\u001b[?2004l\r"]
[2897.92192, "o", "\u001b[?2004h> "]
[2897.922126, "o", "            regressed := abs < t.MinAbsoluteDelta\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.922184, "o", "> "]
[2897.922333, "o", "            if !regressed && math.Abs(b) > 1e-10 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.922386, "o", "> "]
[2897.92252, "o", "                rel := (c - b) / math.Abs(b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.92258, "o", "> "]
[2897.922706, "o", "                if rel < t.MinRelativeDelta {\r\n\u001b[?2004l\r"]
[2897.92276, "o", "\u001b[?2004h> "]
[2897.922893, "o", "                    regressed = true\r\n\u001b[?2004l\rr\u001b[?2004h"]
[2897.922949, "o", "> "]
[2897.923005, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.923068, "o", "            }\r\n\u001b[?2004l\r(o\u001b[?2004h"]
[2897.923122, "o", "> "]
[2897.923206, "o", "            if regressed {\r\n\u001b[?2004l\r"]
[2897.923265, "o", "\u001b[?2004h> "]
[2897.923489, "o", "                regressedSplits = append(regressedSplits, split)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.923568, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.923623, "o", ">         }\r\n\u001b[?2004l\r"]
[2897.923677, "o", "\u001b[?2004h> "]
[2897.923765, "o", "        verdict := \"PASS\"\r\n\u001b[?2004l\r"]
[2897.923818, "o", "\u001b[?2004h> "]
[2897.923948, "o", "        if len(regressedSplits) > 0 {\r\n\u001b[?2004l\r \u001b[?2004h"]
[2897.924001, "o", "> "]
[2897.924093, "o", "            verdict = \"REGRESSED\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.924148, "o", "> "]
[2897.92424, "o", "            switch t.Severity {\r\n\u001b[?2004l\r"]
[2897.924294, "o", "\u001b[?2004h> "]
[2897.924387, "o", "            case \"critical\":\r\n\u001b[?2004l\r \u001b[?2004h"]
[2897.92444, "o", "> "]
[2897.924521, "o", "                criticalCount++\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.924576, "o", "> "]
[2897.924649, "o", "            case \"warning\":\r\n\u001b[?2004l\r"]
[2897.924703, "o", "\u001b[?2004h> "]
[2897.924791, "o", "                warningCount++\r\n\u001b[?2004l\r"]
[2897.924846, "o", "\u001b[?2004h> "]
[2897.92492, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.924998, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.92522, "o", "        cd.RegressionAnalysis[metric] = RegressionAnalysisEntry{\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.925275, "o", "> "]
[2897.925403, "o", "            Severity:        t.Severity,\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.925457, "o", "> "]
[2897.925596, "o", "            RegressedSplits: regressedSplits,\r\n\u001b[?2004l\r"]
[2897.92565, "o", "\u001b[?2004h> "]
[2897.925773, "o", "            Verdict:         verdict,\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.925827, "o", ">         }\r\n\u001b[?2004l\r"]
[2897.925889, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[2897.925947, "o", "\u001b[?2004h> "]
[2897.926115, "o", "    cd.Overall.CriticalRegressions = criticalCount\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.92617, "o", "> "]
[2897.926321, "o", "    cd.Overall.WarningRegressions = warningCount\r\n\u001b[?2004l\r"]
[2897.926377, "o", "\u001b[?2004h> "]
[2897.926731, "o", "    if criticalCount > cfg.Rules.MaxCriticalRegressions || warningCount > cfg.Rules.MaxWarningRegressions {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.926787, "o", "> "]
[2897.926902, "o", "        cd.Overall.Verdict = \"FAIL\"\r\n\u001b[?2004l\r(\u001b[?2004h"]
[2897.926958, "o", ">     }\r\n\u001b[?2004l\r \u001b[?2004h> "]
[2897.92705, "o", "    return cd, nil\r\n\u001b[?2004l\r"]
[2897.927106, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.927161, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.927373, "o", "func buildComparisonMarkdown(cd ComparisonData) string {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.927427, "o", "> "]
[2897.927506, "o", "    var b strings.Builder\r\n\u001b[?2004l\rf\u001b[?2004h"]
[2897.927559, "o", "> "]
[2897.927722, "o", "    fmt.Fprintf(&b, \"# Model Comparison Report\\n\\n\")\r\n\u001b[?2004l\r"]
[2897.927775, "o", "\u001b[?2004h> "]
[2897.928052, "o", "    fmt.Fprintf(&b, \"Baseline: %s v%s\\n\", cd.Baseline.Name, cd.Baseline.Version)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.928109, "o", "> "]
[2897.928383, "o", "    fmt.Fprintf(&b, \"Candidate: %s v%s\\n\", cd.Candidate.Name, cd.Candidate.Version)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.928439, "o", "> "]
[2897.928617, "o", "    fmt.Fprintf(&b, \"Task type: %s\\n\\n\", cd.TaskType)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.928672, "o", "> "]
[2897.928823, "o", "    fmt.Fprintf(&b, \"## Performance Delta\\n\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.928885, "o", "> "]
[2897.929196, "o", "    fmt.Fprintln(&b, \"| Metric | Split | Baseline | Candidate | Delta | Relative Delta |\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.929534, "o", "    fmt.Fprintln(&b, \"|--------|-------|----------|-----------|-------|----------------|\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.929589, "o", "> "]
[2897.929682, "o", "    for _, metric := range cd.MetricOrder {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.929737, "o", "> "]
[2897.929834, "o", "        for _, split := range cd.SplitOrder {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.929905, "o", "> "]
[2897.929979, "o", "            d := cd.Deltas[split][metric]\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.930033, "o", "> "]
[2897.930082, "o", "            rel := \"N/A\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.93021, "o", "            if d.RelativeDelta != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.930264, "o", "> "]
[2897.930405, "o", "                rel = formatFloat2(*d.RelativeDelta*100) + \"%\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.930459, "o", ">             }\r\n\u001b[?2004l\r"]
[2897.930513, "o", "\u001b[?2004h> "]
[2897.930951, "o", "            fmt.Fprintf(&b, \"| %s | %s | %s | %s | %s | %s |\\n\", metric, split, formatFloat6(d.Baseline), formatFloat6(d.Candidate), formatFloat6(d.AbsoluteDelta), rel)\r\n\u001b[?2004l\r"]
[2897.931011, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.931065, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.931143, "o", "    fmt.Fprintln(&b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.931197, "o", "> "]
[2897.931303, "o", "    fmt.Fprintf(&b, \"## Regression Analysis\\n\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.931357, "o", "> "]
[2897.931529, "o", "    fmt.Fprintln(&b, \"| Metric | Severity | Regressed Splits | Verdict |\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.931584, "o", "> "]
[2897.931753, "o", "    fmt.Fprintln(&b, \"|--------|----------|-----------------|---------|\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.931807, "o", "> "]
[2897.931922, "o", "    for _, metric := range cd.RegressionMetrics {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.932066, "o", "        ra := cd.RegressionAnalysis[metric]\r\n\u001b[?2004l\r\u001b[?2004h"]
[2897.932121, "o", "> "]
[2897.932206, "o", "        splits := strings.Join(ra.RegressedSplits, \", \")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.93239, "o", "        fmt.Fprintf(&b, \"| %s | %s | %s | %s |\\n\", metric, ra.Severity, splits, ra.Verdict)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.932445, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.932498, "o", "    fmt.Fprintln(&b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.932589, "o", "    fmt.Fprintf(&b, \"## Overall Verdict\\n\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.932708, "o", "    fmt.Fprintf(&b, \"Result: %s\\n\", cd.Overall.Verdict)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.932952, "o", "    fmt.Fprintf(&b, \"Critical regressions: %d / %d\\n\", cd.Overall.CriticalRegressions, cd.Overall.MaxCriticalRegressions)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.933181, "o", "    fmt.Fprintf(&b, \"Warning regressions: %d / %d\\n\", cd.Overall.WarningRegressions, cd.Overall.MaxWarningRegressions)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.933244, "o", "    return b.String()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.933299, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.93338, "o", "func runCompare(args []string) int {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.933508, "o", "    fs := flag.NewFlagSet(\"compare\", flag.ContinueOnError)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.933662, "o", "    baselinePath := fs.String(\"baseline\", \"\", \"path to baseline manifest\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.93382, "o", "    candidatePath := fs.String(\"candidate\", \"\", \"path to candidate manifest\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.933979, "o", "    configPath := fs.String(\"config\", \"\", \"path to regression config\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.934132, "o", "    outputDir := fs.String(\"output-dir\", \"\", \"directory for output files\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.93429, "o", "    format := fs.String(\"format\", \"both\", \"output format: md, json, or both\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.934387, "o", "    if err := fs.Parse(args); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.934474, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.934525, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.93458, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.934745, "o", "    if *baselinePath == \"\" || *candidatePath == \"\" || *configPath == \"\" || *outputDir == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.934948, "o", "        fmt.Fprintln(os.Stderr, \"--baseline, --candidate, --config, and --output-dir are required\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935001, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935055, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935109, "o", "    switch *format {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935162, "o", "    case \"md\", \"json\", \"both\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.93522, "o", "    default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935391, "o", "        fmt.Fprintf(os.Stderr, \"invalid --format %q; must be md, json, or both\\n\", *format)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935443, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935498, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935582, "o", "    baseline, err := loadManifest(*baselinePath)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935638, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935724, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935775, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935828, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.93592, "o", "    candidate, err := loadManifest(*candidatePath)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.935977, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.936061, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.936112, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.936165, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.936256, "o", "    cfg, err := loadRegressionConfig(*configPath)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.936311, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.936396, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
