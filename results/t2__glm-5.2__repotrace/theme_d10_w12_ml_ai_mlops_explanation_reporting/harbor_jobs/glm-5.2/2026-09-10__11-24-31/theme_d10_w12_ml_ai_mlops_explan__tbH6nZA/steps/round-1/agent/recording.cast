[1756.21633, "o", " map[string]map[string]DeltaEntry `json:\"deltas\"`\r\n   142\tRegressionMetrics []string                       `json:\"-\"`\r\n   143\tRegressionAnalysis map[string]RegressionAnalysisEntry `json:\"regression_analysis\"`\r\n   144\tOverall           Overall                        `json:\"overall\"`\r\n   145\t}\r\n"]
