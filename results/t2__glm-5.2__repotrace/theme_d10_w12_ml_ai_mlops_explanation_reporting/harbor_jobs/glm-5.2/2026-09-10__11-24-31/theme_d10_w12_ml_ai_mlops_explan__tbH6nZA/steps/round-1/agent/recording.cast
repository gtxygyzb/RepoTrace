[3671.997653, "o", "   402\tfunc loadRegressionConfig(path string) (RegressionConfig, error) {\r\n   403\t\tvar cfg RegressionConfig\r\n   404\t\tif err := readJSON(path, &cfg); err != nil {\r\n   405\t\t\treturn RegressionConfig{}, err\r\n   406\t\t}\r\n   407\t\tfor metric, t := range cfg.Thresholds {\r\n   408\t\t\tswitch t.Severity {\r\n   409\t\t\tcase \"critical\", \"warning\", \"info\":\r\n   410\t\t\tdefault:\r\n   411\t\t\t\treturn RegressionConfig{}, fmt.Errorf(\"%s: invalid severity %q for metric %q\", path, t.Severity, metric)\r\n   412\t\t\t}\r\n   413\t\t}\r\n   414\t\treturn cfg, nil\r\n   415\t}\r\n"]
[3671.997715, "o", "   416\t\r\n   417\tfunc computeMetrics(taskType string, preds []NormPrediction) EvalResult {\r\n   418\t\tswitch taskType {\r\n   419\t\tcase \"binary_classification\":\r\n   420\t\t\treturn computeBinary(preds)\r\n   421\t\tcase \"multiclass_classification\":\r\n   422\t\t\treturn computeMulticlass(preds)\r\n   423\t\tcase \"regression\":\r\n   424\t\t\t"]
[3671.997839, "o", "return computeRegression(preds)\r\n   425\t\tdefault:\r\n   426\t\t\treturn EvalResult{Metrics: map[string]float64{}, MetricOrder: metricOrderForTask(taskType)}\r\n   427\t\t}\r\n   428\t}\r\n   429\t\r\n   430\tfunc computeBinary(preds []NormPrediction) EvalResult {\r\n   431\t\tclasses := collectClasses(preds, true)\r\n   432\t\tif len(classes) != 2 {\r\n   433\t\t\treturn EvalResult{Metrics: zeroMetrics(metricOrderForTask(\"binary_classification\")), MetricOrder: metricOrderForTask(\"binary_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}\r\n   434\t\t}\r\n   435\t\tpos := classes[1]\r\n   436\t\ttp, fp, fn, tn := 0, 0, 0, 0\r\n   437\t\tfor _, p := range preds {\r\n   438\t\t\tap := p.ActualStr == pos\r\n   439\t\t\tpp := p.PredictedStr == pos\r\n   440\t\t\tswitch {\r\n   441\t\t\tcase ap && pp:\r\n   442\t\t\t\ttp++\r\n"]
[3671.997977, "o", "   443\t\t\tcase !ap && pp:\r\n   444\t\t\t\tfp++\r\n   445\t\t\tcase ap && !pp:\r\n   446\t\t\t\tfn++\r\n   447\t\t\tdefault:\r\n   448\t\t\t\ttn++\r\n   449\t\t\t}\r\n   450\t\t}\r\n   451\t\ttotal := len(preds)\r\n   452\t\taccuracy := safeDivInt(tp+tn, total)\r\n   453\t\tprecision := safeDivInt(tp, tp+fp)\r\n   454\t\trecall := safeDivInt(tp, tp+fn)\r\n   455\t\tf1 := safeDiv(2*precision*recall, precision+recall)\r\n   456\t\tauc := aucROC(preds, pos)\r\n   457\t\tll := logLoss(preds, pos)\r\n   458\t\tmetrics := map[string]float64{\r\n   459\t\t\t\"accuracy\":  accuracy,\r\n   460\t\t\t"]
[3671.998067, "o", "\"precision\": precision,\r\n   461\t\t\t\"recall\":    recall,\r\n   462\t\t\t\"f1\":        f1,\r\n   463\t\t\t\"auc_roc\":   auc,\r\n   464"]
[3671.998129, "o", "\t\t\t\"log_loss\":  ll,\r\n   465\t\t}\r\n   466\t\treturn EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask(\"binary_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}\r\n   467\t}\r\n   468\t\r\n   469\tfunc aucROC(preds []NormPrediction, pos string) float64 {\r\n   470\t\ttotalPos := 0\r\n"]
