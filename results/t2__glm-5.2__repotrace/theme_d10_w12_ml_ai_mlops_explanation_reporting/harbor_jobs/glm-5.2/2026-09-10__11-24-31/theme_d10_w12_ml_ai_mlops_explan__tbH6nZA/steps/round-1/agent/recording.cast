[3721.10913, "o", "   944\t\tbaseSplits := make(map[string]bool)\r\n   945\t\tfor _, ev := range baseline.Evaluations {\r\n   946\t\t\tbaseSplits[ev.Split] = true\r\n   947\t\t}\r\n   948\t\tfor _, ev := range candidate.Evaluations {\r\n   949\t\t\tif !baseSplits[ev.Split] {\r\n   950\t\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in candidate but not baseline\", ev.Split)\r\n   951\t\t\t}\r\n   952\t\t}\r\n   953\t\tfor _, ev := range baseline.Evaluations {\r\n   954\t\t"]
[3721.109294, "o", "\tfound := false\r\n   955\t\t\tfor _, cev := range candidate.Evaluations {\r\n   956\t\t\t\tif cev.Split == ev.Split {\r\n   957\t\t\t\t\tfound = true\r\n   958\t\t\t\t\tbreak\r\n   959\t\t\t\t}\r\n   960\t\t\t}\r\n   961\t\t\tif !found {\r\n   962\t\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in baseline but not candidate\", ev.Split)\r\n   963\t\t\t}\r\n   964\t\t}\r\n   965\t"]
