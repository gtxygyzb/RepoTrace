[5469.606309, "o", "  1332\t}\r\n  1333\t\r\n  1334\tfunc runSummary(args []string) int {\r\n  1335\t\tfs := flag.NewFlagSet(\"summary\", flag.ContinueOnError)\r\n  1336\t\treportPath := fs.String(\"report\", \"report.json\", \"path to evaluation report JSON\")\r\n  1337\t\tif err := fs.Parse(args); err != nil {\r\n  1338\t\t\treturn 2\r\n  1339\t\t}\r\n  1340\t\r\n  1341\t\tdata, err := os.ReadFile(*reportPath)\r\n  1342\t\tif err != nil {\r\n  1343\t\t\tfmt.Fprintln(os.Stderr, err)\r\n  1344\t\t\treturn 2\r\n  1345\t\t}\r\n  1346\t\r\n  1347\t\tvar report ReportJSON\r\n"]
[5469.606379, "o", "  1348\t\tif err := json.Unmarshal(data, &report); err != nil {\r\n  1349\t\t\tfmt.Fprintf(os.Stderr, \"failed to parse report: %v\\n\", err)\r\n  1350\t\t\treturn 2\r\n  1351\t\t}\r\n  1352\t\r\n  1353\t\tprimary := primaryMetricsForTask(report.Model.TaskType)\r\n  1354\t\tif primary == nil {\r\n  1355\t\t\t"]
[5469.606444, "o", "fmt.Fprintf(os.Stderr, \"unknown task type %q\\n\", report.Model.TaskType)\r\n  1356\t\t\treturn 2\r\n  1357\t\t}\r\n  1358\t\tif len(report.Splits) == 0 {\r\n  1359\t\t\tfmt.Fprintln(os.Stderr, \"report contains no splits\")\r\n  1360\t\t\treturn 2\r\n  1361\t\t}\r\n  1362\t\r\n  1363\t\tmetricValues := make([]string, 0, len(primary))\r\n"]
[5469.606507, "o", "  1364\t\tfor _, metric := range primary {\r\n  1365\t\t\tvals := make([]float64, 0, len(report.Splits))\r\n  1366\t\t\tfor _, split := range report.Splits {\r\n  1367\t\t\t\tif v, ok := split.Metrics[metric]; ok {\r\n  1368\t\t\t\t\tvals = append(vals, v)\r\n  1369\t\t\t\t}\r\n  1370\t\t\t}\r\n  1371\t\t\tif len(vals) == 0 {\r\n  1372\t\t\t\tcontinue\r\n"]
[5469.606562, "o", "  1373\t\t\t}\r\n  1374\t\t\tavg := mean(vals)\r\n  1375\t\t\tmetricValues = append(metricValues, fmt.Sprintf(\"%s=%.4f\", metric, avg))\r\n  1376\t\t}\r\n  1377\t\r\n  1378\t\tfmt.Printf(\"%s v%s (%s) — %d split(s): %s\\n\",\r\n  1379\t\t\treport.Model.Name,\r\n  1380\t\t\treport.Model.Version,\r\n"]
