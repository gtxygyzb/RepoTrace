[3651.187585, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K405\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn \u001b[01;31m\u001b[KRegressionConfig\u001b[m\u001b[K{}, err\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn \u001b[01;31m\u001b[KRegressionConfig\u001b[m\u001b[K{}, fmt.Errorf(\"%s: invalid severity %q for metric %q\", path, t.Severity, metric)\r\n"]
[3651.18782, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K778\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc buildEvaluate\u001b[m\u001b[KMarkdown(report ReportJSON, nm NormManifest, bootstrap int) string {\r\n"]
