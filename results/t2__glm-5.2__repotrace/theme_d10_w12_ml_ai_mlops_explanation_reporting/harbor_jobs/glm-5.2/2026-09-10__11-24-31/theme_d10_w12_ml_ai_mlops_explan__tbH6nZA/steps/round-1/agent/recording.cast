[4512.21278, "o", "\tif cd.Overall.Verdict == \"FAIL\" {\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n\r\n\r\nfunc primaryMetricsForTask(taskType string) []string {\r\n"]
[4512.212958, "o", "\\tswitch taskType {\r\n\\tcase \"binary_classification\":\r\n\\t\\treturn []string{\"accuracy\", \"f1\", \"auc_roc\"}\r\n\\tcase \"multiclass_classification\":\r\n\\t\\treturn []string{\"accuracy\", \"f1_macro\"}\r\n\\tcase \"regression\":\r\n\\t\\treturn []string{\"rmse\", \"mae\", \"r_squared\"}\r\n\\tdefault:\r\n\\t\\treturn nil\r\n\\t}\r\n}\r\n\r\nfunc runSummary(args []string) int {\r\n\\tfs := flag.NewFlagSet(\"summary\", flag.ContinueOnError)\r\n\\treportPath := fs.String(\"report\", \"report.json\", \"path to evaluation report JSON\")\r\n\\tif err := fs.Parse(args); err != nil {\r\n\\t\\treturn 2\r\n\\t}\r\n\r\n\\tdata, err := os.ReadFile(*reportPath)\r\n\\tif err != nil {\r\n\\t\\tfmt.Fprintln(os.Stderr, err)\r\n\\t\\treturn 2\r\n\\t}\r\n\r\n\\tvar report ReportJSON\r\n\\tif err := json.Unmarshal(data, &report); err != nil {\r\n\\t\\tfmt.Fprintf(os.Stderr, \"failed to parse report: %v\\n\", err)\r\n\\t\\treturn 2\r\n\\t}\r\n\r\n\\tprimary := primaryMetricsForTask(report.Model.TaskType)\r\n\\tif primary == nil {\r\n\\t\\tfmt.Fprintf(os.Stderr, \"unknown task type %q\\n\", report.Model.TaskType)\r\n\\t\\treturn 2\r\n\\t}\r\n"]
[4512.213054, "o", "\\tif len(report.Splits) == 0 {\r\n\\t\\tfmt.Fprintln(os.Stderr, \"report contains no splits\")\r\n\\t\\treturn 2\r\n\\t}\r\n\r\n\\tmetricValues := make([]string, 0, len(primary))\r\n\\tfor _, metric := range primary {\r\n\\t\\tvals := make([]float64, 0, len(report.Splits))\r\n\\t\\tfor _, split := range report.Splits {\r\n\\t\\t\\tif v, ok := split.Metrics[metric]; ok {\r\n\\t\\t\\t\\tvals = append(vals, v)\r\n\\t\\t\\t}\r\n\\t\\t}\r\n\\t\\tif len(vals) == 0 {\r\n\\t\\t\\tcontinue\r\n\\t\\t}\r\n\\t\\tavg := mean(vals)\r\n\\t\\tmetricValues = append(metricValues, fmt.Sprintf(\"%s=%.4f\", metric, avg))\r\n\\t}\r\n\r\n\\tfmt.Printf(\"%s v%s (%s) — %d split(s): %s\\n\",\r\n\\t\\treport.Model.Name,"]
[4512.213123, "o", "\r\n\\t\\treport.Model.Version,\r\n\\t\\treport.Model.TaskType,\r\n\\t\\tlen(report.Splits),\r\n\\t\\tstrings.Join(metricValues, \", \"))\r\n\\treturn 0\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: mlreport <evaluate|compare|summary> ...\")\r\n\t\tos.Exit(2)\r\n"]
[4512.213182, "o", "\t}\r\n\tvar code int\r\n\tswitch os.Args[1] {\r\n\tcase \"evaluate\":\r\n"]
