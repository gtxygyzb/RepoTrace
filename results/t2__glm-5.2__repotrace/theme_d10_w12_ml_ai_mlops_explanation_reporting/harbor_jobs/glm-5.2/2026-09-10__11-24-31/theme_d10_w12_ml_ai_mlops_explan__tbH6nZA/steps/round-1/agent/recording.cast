[4396.027701, "o", "\u001b[32m\u001b[K752\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif len(ci\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K) == 0 {\r\n\u001b[32m\u001b[K757\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, m := range ci\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K765\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tres := compute\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K(taskType, resample)\r\n\u001b[32m\u001b[K766\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, m := range ci\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K767\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tvalues[m] = append(values[m], res.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[m])\r\n\u001b[32m\u001b[K771\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, m := range ci\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n"]
[4396.027769, "o", "\u001b[32m\u001b[K781\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc build\u001b[01;31m\u001b[KReport\u001b[m\u001b[KJSON(nm NormManifest, splits []string, bootstrap int, confidence float64, seed int64) \u001b[01;31m\u001b[KReport\u001b[m\u001b[KJSON {\r\n\u001b[32m\u001b[K782\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treport := \u001b[01;31m\u001b[KReport\u001b[m\u001b[KJSON{Model: nm.Model, \u001b[01;31m\u001b[KSplits\u001b[m\u001b[K: make(map[string]\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K\u001b[01;31m\u001b[KReport\u001b[m\u001b[KJSON)}\r\n\u001b[32m\u001b[K791\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif split == ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K800\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult := compute\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K(nm.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K, ev.Predictions)\r\n\u001b[32m\u001b[K801\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\trounded\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K := make(map[string]float64)\r\n"]
[4396.02785, "o", "\u001b[32m\u001b[K803\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\trounded\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[name] = round6(result.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[name])\r\n\u001b[32m\u001b[K805\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tsr := \u001b[01;31m\u001b[KSplit\u001b[m\u001b[K\u001b[01;31m\u001b[KReport\u001b[m\u001b[KJSON{Dataset: ev.Dataset, \u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K: rounded\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K806\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif nm.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K != \"regression\" && result.ConfusionMatrix != nil {\r\n\u001b[32m\u001b[K809\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif nm.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K == \"multiclass_classification\" && len(result.PerClass\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K) > 0 {\r\n\u001b[32m\u001b[K810\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tsr.PerClass\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K = make(map[string]PerClassMetric)\r\n\u001b[32m\u001b[K811\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor class, pm := range result.PerClass\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n"]
