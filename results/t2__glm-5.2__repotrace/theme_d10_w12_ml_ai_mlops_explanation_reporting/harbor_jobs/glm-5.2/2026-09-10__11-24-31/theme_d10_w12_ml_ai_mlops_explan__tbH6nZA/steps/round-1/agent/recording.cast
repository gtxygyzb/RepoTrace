[5236.033705, "o", "  1211\t\t\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %s |\\n\", metric, ra.Severity, ra.Direction, splits, ra.Verdict)\r\n  1212\t\t}\r\n  1213\t\tfmt.Fprintln(&b)\r\n  1214\t\tfmt.Fprintf(&b, \"## Overall Verdict\\n\\n\")\r\n  1215\t\tfmt.Fprintf(&b, \"Result: %s\\n\", cd.Overall.Verdict)\r\n  1216\t\tfmt.Fprintf(&b, \"Critical regressions: %d / %d\\n\", cd.Overall.CriticalRegressions, cd.Overall.MaxCriticalRegressions)\r\n  1217\t\tfmt.Fprintf(&b, \"Warning regressions: %d / %d\\n\", cd.Overall.WarningRegressions, cd.Overall.MaxWarningRegressions)\r\n  1218\t\treturn b.String()\r\n  1219\t}\r\n  1220\t\r\n  1221\tfunc runCompare(args []string) int {\r\n  1222\t\tfs := flag.NewFlagSet(\"compare\", flag.ContinueOnError)\r\n  1223\t\tbaselinePath := fs.String(\"baseline\", \"\", \"path to baseline manifest\")\r\n  1224\t\tcandidatePath := fs.String(\"candidate\", \"\", \"path to candidate manifest\")\r\n  1225\t\tconfigPath := fs.String(\"config\", \"\", \"path to regression config\")\r\n  1226\t\toutputDir := fs.String(\"output-dir\", \"\", \"directory for output files\")\r\n"]
[5236.033804, "o", "  1227\t\tformat := fs.String(\"format\", \"both\", \"output format: md, json, or both\")\r\n  1228\t\texcludeMetric := fs.String(\"exclude-metric\", \"\", \"comma-separated list of metric names to exclude from regression analysis\")\r\n  1229\t\tsplit := fs.String(\"split\", \"\", \"comma-separated list of split names to compare\")\r\n  1230\t\tif err := fs.Parse(args); err != nil {\r\n  1231\t\t\tfmt.Fprintln(os.Stderr, err)\r\n  1232\t\t\treturn 2\r\n"]
[5236.033937, "o", "  1233\t\t}\r\n  1234\t\tif *baselinePath == \"\" || *candidatePath == \"\" || *configPath == \"\" || *outputDir == \"\" {\r\n  1235\t\t\tfmt.Fprintln(os.Stderr, \"--baseline, --candidate, --config, and --output-dir are required\")\r\n  1236\t\t\treturn 2\r\n  1237\t\t}\r\n  1238\t\tswitch *format {\r\n"]
[5236.034006, "o", "  1239\t\tcase \"md\", \"json\", \"both\":\r\n  1240\t\tdefault:\r\n  1241\t\t\tfmt.Fprintf(os.Stderr, \"invalid --format %q; must be md, json, or both\\n\", *format)\r\n  1242\t\t\treturn 2\r\n  1243\t\t}\r\n  1244\t\texcludedMetrics := make(map[string]bool)\r\n"]
