[2897.936501, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.936609, "o", "    cd, err := buildComparisonData(baseline, candidate, cfg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.936666, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.936751, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
