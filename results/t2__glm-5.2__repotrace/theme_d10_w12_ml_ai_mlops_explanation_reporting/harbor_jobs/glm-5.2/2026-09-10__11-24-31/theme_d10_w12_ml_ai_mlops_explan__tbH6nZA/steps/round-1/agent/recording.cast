[3657.006018, "o", "func logLoss(preds []NormPrediction, pos string) float64 {\r\n\tif len(preds) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tsum := 0.0\r\n\tfor _, pr := range preds {\r\n"]
[3657.006054, "o", "\t\ty := 0.0\r\n\t\tif pr.ActualStr == pos {\r\n\t\t\ty = 1.0\r\n\t\t}\r\n\t\tp := 0.0\r\n\t\tif v, ok := pr.Probabilities[pos]; ok {\r\n"]
[3657.006318, "o", "\t\t\tp = v\r\n\t\t}\r\n\t\tp = math.Min(1-1e-15, math.Max(1e-15, p))\r\n\t\tsum += y*math.Log(p) + (1-y)*math.Log(1-p)\r\n\t}\r\n\treturn -sum / float64(len(preds))\r\n}\r\n\r\nfunc makeConfusionMatrix(preds []NormPrediction, classes []string) *ConfusionMatrixReport {\r\n\tif len(classes) == 0 {\r\n\t\treturn nil\r\n\t}\r\n\tidx := make(map[string]int)\r\n\tfor i, c := range classes {\r\n\t\tidx[c] = i\r\n\t}\r\n\tmatrix := make([][]int, len(classes))\r\n\tfor i := range matrix {\r\n\t\tmatrix[i] = make([]int, len(classes))\r\n\t}\r\n\tfor _, p := range preds {\r\n\t\tai, ok := idx[p.ActualStr]\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tpi, ok2 := idx[p.PredictedStr]\r\n\t\tif !ok2 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tmatrix[ai][pi]++\r\n\t}\r\n\treturn &ConfusionMatrixReport{Classes: classes, Matrix: matrix}\r\n}\r\n\r\nfunc computeMulticlass(preds []NormPrediction) EvalResult {\r\n\tclasses := collectClasses(preds, true)\r\n\tif len(classes) < 3 {\r\n\t\treturn EvalResult{Metrics: zeroMetrics(metricOrderForTask(\"multiclass_classification\")), MetricOrder: metricOrderForTask(\"multiclass_classification\"), ConfusionMatrix: make"]
[3657.006417, "o", "ConfusionMatrix(preds, classes)}\r\n\t}\r\n\ttotal := len(preds)\r\n\tcorrect := 0\r\n\ttype counts struct{ tp, fp, fn, tn, support int }\r\n\tperClass := make(map[string]counts)\r\n\tfor _, c := range classes {\r\n\t\tperClass[c] = counts{}\r\n\t}\r\n\tfor _, p := range preds {\r\n\t\tif p.ActualStr == p.PredictedStr {\r\n\t\t\tcorrect++\r\n\t\t}\r\n\t\tpc := perClass[p.ActualStr]\r\n\t\tpc.support++\r\n\t\tperClass[p.ActualStr] = pc\r\n\t\tfor _, c := range classes {\r\n\t\t\ttp, fp, fn, tn := 0, 0, 0, 0\r\n\t\t\tactualC := p.ActualStr == c\r\n\t\t\tpredC := p.PredictedStr == c\r\n\t\t\tif actualC && predC {\r\n\t\t\t\ttp = 1\r\n"]
[3657.006486, "o", "\t\t\t} else if !actualC && predC {\r\n\t\t\t\tfp = 1\r\n\t\t\t} else if actualC && !predC {\r\n\t\t\t\tfn = 1\r\n\t\t\t} else {\r\n\t\t\t\ttn = 1\r\n\t\t\t}\r\n\t\t\tpc := perClass[c]\r\n\t\t\tpc.tp += tp\r\n\t\t\tpc.fp += fp\r\n\t\t\tpc.fn += fn\r\n"]
[3657.00655, "o", "\t\t\tpc.tn += tn\r\n\t\t\tperClass[c] = pc\r\n\t\t}\r\n\t}\r\n\tsumTP, sumFP, sumFN := 0, 0, 0\r\n\tprecisions := make([]float64, len(classes))\r\n\trecalls := make([]float64, len(classes))\r\n\tf1s := make([]float64, len(classes))\r\n\tsupports := make([]int, len(classes))\r\n\tperClassMetrics := make(map[string]PerClassMetric)\r\n\tfor i, c := range classes {\r\n\t"]
[3657.006611, "o", "\tpc := perClass[c]\r\n\t\tsumTP += pc.tp\r\n\t\tsumFP += pc.fp\r\n\t\tsumFN += pc.fn\r\n\t\tsupports[i] = pc.support\r\n\t\tprecisions[i] = safeDivInt(pc.tp, pc.tp+pc.fp)\r\n\t\trecalls[i] = safeDivInt(pc.tp, pc.tp+pc.fn)\r\n\t\tf1s[i] = safeDiv(2*precisions[i]*recalls[i], precisions[i]+recalls[i])\r\n"]
[3657.006668, "o", "\t\tperClassMetrics[c] = PerClassMetric{Precision: precisions[i], Recall: recalls[i], F1: f1s[i], Support: pc.support}\r\n\t}\r\n\taccuracy := safeDivInt(correct, total)\r\n\tprecisionMicro := safeDivInt(sumTP, sumTP+sumFP)\r\n\trecallMicro := safeDivInt(sumTP, sumTP+sumFN)\r\n\tf1Micro := safeDiv(2*precisionMicro*recallMicro, precisionMicro+recallMicro)\r\n\tprecisionMacro := mean(precisions)\r\n\trecallMacro := mean(recalls)\r\n\tf1Macro := mean(f1s)\r\n"]
[3657.006737, "o", "\tprecisionWeighted := weighted(precisions, supports)\r\n\trecallWeighted := weighted(recalls, supports)\r\n\tf1Weighted := weighted(f1s, supports)\r\n\tmetrics := map[string]float64{\r\n\t\t\"accuracy\":           accuracy,\r\n\t\t\"precision_micro\":    precisionMicro,\r\n\t\t\"recall_micro\":       recallMicro,\r\n"]
[3657.006799, "o", "\t\t\"f1_micro\":           f1Micro,\r\n\t\t\"precision_macro\":    precisionMacro,\r\n\t\t\"recall_macro\":       recallMacro,\r\n\t\t\"f1_macro\":           f1Macro,\r\n\t\t\"precision_weighted\": precisionWeighted,\r\n\t\t\"recall_weighted\":    recallWeighted,\r\n\t\t\"f1_weighted\":        f1Weighted,\r\n\t}\r\n\treturn EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask(\"multiclass_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes), PerClassMetrics: perClassMetrics}\r\n}\r\n\r\nfunc computeRegression(preds []NormPrediction) EvalResult {\r\n\tn := len(preds)\r\n\tactuals := make([]float64, n)\r\n"]
[3657.006861, "o", "\tpredicted := make([]float64, n)\r\n\tfor i, p := range preds {\r\n\t\tactuals[i] = p.ActualNum\r\n\t\tpredicted[i] = p.PredictedNum\r\n\t}\r\n\tse := 0.0\r\n\tae := 0.0\r\n\tsmapeSum := 0.0\r\n\tsmapeCount := 0\r\n\tfor i := 0; i < n; i++ {\r\n\t\tdiff := actuals[i] - predicted[i]\r\n"]
[3657.006945, "o", "\t\tse += diff * diff\r\n\t\tae += math.Abs(diff)\r\n\t\tdenom := math.Abs(actuals[i]) + math.Abs(predicted[i])\r\n\t\tif denom >= 1e-10 {\r\n\t\t\tsmapeSum += 2 * math.Abs(diff) / denom\r\n\t\t\tsmapeCount++\r\n\t\t}\r\n\t}\r\n\tmse := se / float64(n)\r\n\trmse := math.Sqrt(mse)\r\n"]
[3657.007023, "o", "\tmae := ae / float64(n)\r\n\tmeanActual := mean(actuals)\r\n\tssRes := 0.0\r\n\tssTot := 0.0\r\n\tfor _, a := range actuals {\r\n"]
[3657.007113, "o", "\t\tssTot += (a - meanActual) * (a - meanActual)\r\n\t}\r\n\tfor i := range actuals {\r\n\t\tdiff := actuals[i] - predicted[i]\r\n\t\tssRes += diff * diff\r\n\t}\r\n\trSquared := 0.0\r\n\tif ssTot != 0 {\r\n\t\trSquared = 1 - ssRes/ssTot\r\n\t}\r\n\tsmape := 0.0\r\n\tif smapeCount > 0 {\r\n\t\tsmape = smapeSum / float64(smapeCount) * 100\r\n\t}\r\n\tmetrics := map[string]float64{\r\n\t\t\"mse\":       mse,\r\n\t\t\"rmse\":      rmse,\r\n\t\t\"mae\":       mae,\r\n\t\t\"r_squared\": rSquared,\r\n\t\t\"smape\":     smape,\r\n\t}\r\n\treturn EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask(\"regression\")}\r\n}\r\n"]
[3657.007174, "o", "\r\nfunc zeroMetrics(order []string) map[string]float64 {\r\n\tm := make(map[string]float64)\r\n\tfor _, name := range order {\r\n\t\tm[name] = 0\r\n\t}\r\n\treturn m\r\n}\r\n\r\nfunc computeBootstrapCIs(taskType string, preds []NormPrediction, B int, confidence float64, rng *rand.Rand) map[string]CI {\r\n\tif B <= 0 {\r\n\t\treturn nil\r\n"]
[3657.007236, "o", "\t}\r\n\tciMetrics := ciMetricsForTask(taskType)\r\n\tif len(ciMetrics) == 0 {\r\n\t\treturn nil\r\n\t}\r\n\tn := len(preds)\r\n\tvalues := make(map[string][]float64)\r\n\tfor _, m := range ciMetrics {\r\n\t\tvalues[m] = make([]float64, 0, B)\r\n\t}\r\n\t"]
[3657.007292, "o", "for b := 0; b < B; b++ {\r\n\t\tresample := make([]NormPrediction, n)\r\n\t\tfor i := 0; i < n; i++ {\r\n\t\t\tresample[i] = preds[rng.Intn(n)]\r\n\t\t}\r\n\t\tres := computeMetrics(taskType, resample)\r\n\t\tfor _, m := range ciMetrics {\r\n\t\t\tvalues[m] = append(values[m], res.Metrics[m])\r\n\t\t}\r\n"]
[3657.007349, "o", "\t}\r\n\tcis := make(map[string]CI)\r\n\tfor _, m := range ciMetrics {\r\n\t\tvals := values[m]\r\n\t\tsort.Float64s(vals)\r\n\t\tlowerIndex := clampIndex(int(math.Floor((1-confidence)/2*float64(B))), B)\r\n\t\tupperIndex := clampIndex(int(math.Floor((1+confidence)/2*float64(B)))-1, B)\r\n\t\tcis[m] = CI{Lower: round6(vals[lowerIndex]), Upper: round6(vals[upperIndex])}\r\n\t"]
[3657.007416, "o", "}\r\n\treturn cis\r\n}\r\n\r\nfunc buildReportJSON(nm NormManifest, bootstrap int, confidence float64, seed int64) ReportJSON {\r\n\treport := ReportJSON{Model: nm.Model, Splits: make(map[string]SplitReportJSON)}\r\n\tvar rng *rand.Rand\r\n"]
[3657.007479, "o", "\tif bootstrap > 0 {\r\n\t\trng = rand.New(rand.NewSource(seed))\r\n\t}\r\n\tfor _, ev := range nm.Evaluations {\r\n\t\tresult := computeMetrics(nm.Model.TaskType, ev.Predictions)\r\n\t\troundedMetrics := make(map[string]float64)\r\n\t\tfor _, name := range result.MetricOrder {\r\n\t\t\troundedMetrics[name] = round6(result.Metrics[name])\r\n"]
[3657.007553, "o", "\t\t}\r\n\t\tsr := SplitReportJSON{Dataset: ev.Dataset, Metrics: roundedMetrics}\r\n\t\tif nm.Model.TaskType != \"regression\" && result.ConfusionMatrix != nil {\r\n\t\t\tsr.ConfusionMatrix = result.ConfusionMatrix\r\n\t\t}\r\n\t\tif nm.Model.TaskType == \"multiclass_classification\" && len(result.PerClassMetrics) > 0 {\r\n\t\t\tsr.PerClassMetrics = make(map[string]PerClassMetric)\r\n\t\t\tfor class, pm := range result.PerClassMetrics {\r\n\t\t\t\tsr.PerClassMetrics[class] = PerClassMetric{\r\n\t\t\t\t\tPrecision: round6(pm.Precision),\r\n\t\t\t\t\tRecall:    round6(pm.Recall),\r\n\t\t\t\t\tF1:        round6(pm.F1),\r\n\t\t\t\t\tSupport:   pm.Support,\r\n\t\t\t\t}\r\n"]
[3657.007615, "o", "\t\t\t}\r\n\t\t}\r\n\t\tif bootstrap > 0 {\r\n\t\t\tsr.ConfidenceIntervals = computeBootstrapCIs(nm.Model.TaskType, ev.Predictions, bootstrap, confidence, rng)\r\n\t\t}\r\n"]
[3657.00768, "o", "\t\treport.Splits[ev.Split] = sr\r\n\t}\r\n\treturn report\r\n}\r\n\r\nfunc buildEvaluateMarkdown(report ReportJSON, nm NormManifest, bootstrap int) string {\r\n\tvar b strings.Builder\r\n\tfmt.Fprintf(&b, \"# Evaluation Report: %s v%s\\n\\n\", nm.Model.Name, nm.Model.Version)\r\n\tfmt.Fprintf(&b, \"Task type: %s\\n\\n\", nm.Model.TaskType)\r\n\tfmt.Fprintf(&b, \"## Summary\\n\\n\")\r\n"]
