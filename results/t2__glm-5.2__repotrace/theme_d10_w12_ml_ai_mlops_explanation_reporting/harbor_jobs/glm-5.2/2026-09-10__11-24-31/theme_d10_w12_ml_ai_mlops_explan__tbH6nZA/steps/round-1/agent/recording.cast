[3671.997509, "o", "   385\t\t\t\tif k == \"\" {\r\n   386\t\t\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: probability class label is empty\", path, split, rp.ID)\r\n   387\t\t\t\t}\r\n   388\t\t\t\tif math.IsNaN(v) || math.IsInf(v, 0) || v < 0 || v > 1 {\r\n   389\t\t\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: probability for %q out of range\", path, split, rp.ID, k)\r\n   390\t\t\t\t}\r\n   391\t\t\t\tsum += v\r\n   392\t\t\t}\r\n   393\t\t\tif math.Abs(sum-1) > 1e-6 {\r\n   394\t\t\t\treturn NormPrediction{}, fmt.Errorf(\"%s: split %q prediction %q: probabilities must sum to 1\", path, split, rp.ID)\r\n"]
