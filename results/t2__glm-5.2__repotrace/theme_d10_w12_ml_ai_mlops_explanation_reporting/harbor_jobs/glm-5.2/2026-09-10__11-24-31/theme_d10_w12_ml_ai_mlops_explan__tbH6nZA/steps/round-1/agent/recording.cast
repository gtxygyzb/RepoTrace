[1926.367847, "o", "    60\ttype RegressionConfig struct {\r\n    61\tThresholds map[string]Threshold `json:\"thresholds\"`\r\n    62\tRules      Rules                `json:\"rules\"`\r\n    63\t}\r\n    64\t\r\n    65\t"]
[1926.367979, "o", "type Threshold struct {\r\n    66\tMinAbsoluteDelta float64 `json:\"min_absolute_delta\"`\r\n    67\tMinRelativeDelta float64 `json:\"min_relative_delta\"`\r\n    68\tSeverity         string  `json:\"severity\"`\r\n    69\t}\r\n    70\t\r\n    71\ttype Rules struct {\r\n    72\tMaxCriticalRegressions int `json:\"max_critical_regressions\"`\r\n"]
[1926.368063, "o", "    73\tMaxWarningRegressions  int `json:\"max_warning_regressions\"`\r\n    74\t}\r\n    75\t\r\n    76\ttype EvalResult struct {\r\n    77\tSplit           string\r\n    78\tDataset         string\r\n    79\tMetrics         map[string]float64\r\n    80\tConfusionMatrix *ConfusionMatrixReport\r\n    81\tPerClassMetrics map[string]PerClassMetric\r\n    82\tClasses         []string\r\n    83\t}\r\n    84\t\r\n    85\ttype ConfusionMatrixReport struct {\r\n    86\tClasses []string `json:\"classes\"`\r\n    87\tMatrix  [][]int  `json:\"matrix\"`\r\n    88\t}\r\n    89\t\r\n    90\ttype PerClassMetric struct {\r\n    91\tPrecision float64 `json:\"precision\"`\r\n    92\tRecall    float64 `json:\"recall\"`\r\n    93\tF1        float64 `json:\"f1\"`\r\n    94\tSupport   int     `json:\"support\"`\r\n    95\t}\r\n    96\t"]
[1926.368133, "o", "\r\n    97\ttype SplitReport struct {\r\n    98\tDataset         string                  `json:\"dataset\"`\r\n    99\tMetrics         map[string]float64      `json:\"metrics\"`\r\n   100\tConfusionMatrix *ConfusionMatrixReport  `json:\"confusion_matrix,omitempty\"`\r\n   101\tPerClassMetrics map[string]PerClassMetric `json:\"per_class_metrics,omitempty\"`\r\n   102\t}\r\n   103\t\r\n   104\ttype ReportJSON struct {\r\n   105\tModel  Model                  `json:\"model\"`\r\n   106\tSplits map[string]SplitReport `json:\"splits\"`\r\n"]
[1926.368211, "o", "   107\t}\r\n   108\t\r\n   109\ttype ModelRef struct {\r\n   110\tName    string `json:\"name\"`\r\n   111\tVersion string `json:\"version\"`\r\n   112\t}\r\n   113\t\r\n   114\ttype DeltaEntry struct {\r\n   115\tBaseline      float64  `json:\"baseline\"`\r\n   116\tCandidate     float64  `json:\"candidate\"`\r\n   117\tAbsoluteDelta float64  `json:\"absolute_delta\"`\r\n   118\tRelativeDelta *float64 `json:\"relative_delta\"`\r\n"]
[1926.368293, "o", "   119\t}\r\n   120\t\r\n   121\ttype RegressionAnalysisEntry struct {\r\n   122\tSeverity       string   `json:\"severity\"`\r\n   123\tRegressedSplits []string `json:\"regressed_splits\"`\r\n   124\tVerdict        string   `json:\"verdict\"`\r\n   125\t}\r\n   126\t\r\n   127\ttype Overall struct {\r\n   128\tVerdict               string `json:\"verdict\"`\r\n   129\tCriticalRegressions   int    `json:\"critical_regressions\"`\r\n   130\tMaxCriticalRegressions int   `json:\"max_critical_regressions\"`\r\n   131\tWarningRegressions    int    `json:\"warning_regressions\"`\r\n"]
[1926.368355, "o", "   132\tMaxWarningRegressions int    `json:\"max_warning_regressions\"`\r\n   133\t}\r\n   134\t\r\n   135\ttype ComparisonData struct {\r\n   136\tBaseline          ModelRef                       `json:\"baseline\"`\r\n   137\tCandidate         ModelRef                       `json:\"candidate\"`\r\n   138\tTaskType          string                         `json:\"task_type\"`\r\n   139\tSplitOrder        []string                       `json:\"-\"`\r\n   140\tMetricOrder       []string                       `json:\"-\"`\r\n"]
[1926.368424, "o", "   141\tDeltas            map[string]map[string]DeltaEntry `json:\"deltas\"`\r\n   142\tRegressionMetrics []string                       `json:\"-\"`\r\n   143\tRegressionAnalysis map[string]RegressionAnalysisEntry `json:\"regression_analysis\"`\r\n   144\tOverall           Overall                        `json:\"overall\"`\r\n   145\t}\r\n"]
