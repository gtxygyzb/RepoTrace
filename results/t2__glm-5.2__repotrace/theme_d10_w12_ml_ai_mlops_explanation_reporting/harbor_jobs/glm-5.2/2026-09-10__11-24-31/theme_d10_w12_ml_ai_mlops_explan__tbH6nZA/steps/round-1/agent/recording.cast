[3721.109793, "o", "cd.Deltas[split] = make(map[string]DeltaEntry)\r\n  1000\t\t\tfor _, metric := range metricOrder {\r\n  1001\t\t\t\tb := baseResults[split].Metrics[metric]\r\n  1002\t\t\t\tc := candResults[split].Metrics[metric]\r\n  1003\t\t\t\tabs := c - b\r\n  1004\t\t\t\tvar rel *float64\r\n"]
[3721.109852, "o", "  1005\t\t\t\tif math.Abs(b) > 1e-10 {\r\n  1006\t\t\t\t\tr := (c - b) / math.Abs(b)\r\n  1007\t\t\t\t\tr = round6(r)\r\n  1008\t\t\t\t\trel = &r\r\n  1009\t\t\t\t}\r\n  1010\t\t\t\tcd.Deltas[split][metric] = DeltaEntry{\r\n"]
