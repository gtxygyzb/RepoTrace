[3671.721241, "o", "\r\n    97\t\r\n    98\ttype SplitReportJSON struct {\r\n    99\t\tDataset             string                    `json:\"dataset\"`\r\n   100\t\tMetrics             map[string]float64        `json:\"metrics\"`\r\n   101\t\tConfusionMatrix     *ConfusionMatrixReport    `json:\"confusion_matrix,omitempty\"`\r\n   102\t\tPerClassMetrics     map[string]PerClassMetric `json:\"per_class_metrics,omitempty\"`\r\n   103\t\tConfidenceIntervals map[string]CI             `json:\"confidence_intervals,omitempty\"`\r\n   104\t}\r\n"]
