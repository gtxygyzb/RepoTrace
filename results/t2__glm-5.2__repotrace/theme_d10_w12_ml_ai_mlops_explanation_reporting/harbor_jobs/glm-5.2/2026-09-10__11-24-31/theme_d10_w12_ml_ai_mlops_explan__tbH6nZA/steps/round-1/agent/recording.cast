[3721.110108, "o", "  1025\t\t\t\tc := candResults[split].Metrics[metric]\r\n  1026\t\t\t\tabs := c - b\r\n  1027\t\t\t\tregressed := abs < t.MinAbsoluteDelta\r\n  1028\t\t\t\tif !regressed && math.Abs(b) > 1e-10 {\r\n  1029\t\t\t\t\trel := (c - b) / math.Abs(b)\r\n  1030\t\t\t\t\tif rel < t.MinRelativeDelta {\r\n  1031\t\t\t\t\t\tregressed = true\r\n  1032\t\t\t\t\t}\r\n  1033\t\t\t\t}\r\n  1034\t\t\t\tif regressed {\r\n  1035\t\t\t\t\tregressedSplits = append(regressedSplits, split)\r\n  1036\t\t\t\t}\r\n  1037\t\t\t}\r\n  1038\t"]
[3721.110155, "o", "\t\tverdict := \"PASS\"\r\n  1039\t\t\tif len(regressedSplits) > 0 {\r\n  1040\t\t\t\tverdict = \"REGRESSED\"\r\n  1041\t\t\t\tswitch t.Severity {\r\n"]
[3721.110246, "o", "  1042\t\t\t\tcase \"critical\":\r\n  1043\t\t\t\t\tcriticalCount++\r\n  1044\t\t\t\tcase \"warning\":\r\n  1045\t\t\t\t\twarningCount++\r\n  1046\t\t\t\t}\r\n  1047\t\t\t}\r\n  1048\t\t\tcd.RegressionAnalysis[metric] = RegressionAnalysisEntry{\r\n  1049\t\t\t\tSeverity:        t.Severity,\r\n  1050\t\t\t\tRegressedSplits: regressedSplits,\r\n  1051\t\t\t\tVerdict:         verdict,\r\n  1052\t\t\t}\r\n  1053\t\t}\r\n  1054\t\tcd.Overall.CriticalRegressions = criticalCount\r\n  1055\t\tcd.Overall.WarningRegressions = warningCount\r\n  1056\t\tif criticalCount > cfg.Rules.MaxCriticalRegressions || warningCount > cfg.Rules.MaxWarningRegressions {\r\n"]
[3721.110313, "o", "  1057\t\t\tcd.Overall.Verdict = \"FAIL\"\r\n  1058\t\t}\r\n  1059\t\treturn cd, nil\r\n  1060\t}\r\n"]
