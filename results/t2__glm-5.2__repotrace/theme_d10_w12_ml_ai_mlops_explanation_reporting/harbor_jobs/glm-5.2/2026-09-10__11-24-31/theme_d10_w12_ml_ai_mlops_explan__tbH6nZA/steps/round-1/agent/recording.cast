[5497.274087, "o", "\t\t\tb := baseResults[split].Metrics[metric]\r\n\t\t\tc := candResults[split].Metrics[metric]\r\n\t\t\tabs := c - b\r\n\t\t\tvar rel *float64\r\n\t"]
[5497.274172, "o", "\t\tif math.Abs(b) > 1e-10 {\r\n\t\t\t\tr := (c - b) / math.Abs(b)\r\n\t\t\t\tr = round6(r)\r\n\t\t\t\trel = &r\r\n\t\t\t}\r\n\t\t\tcd.Deltas[split][metric] = DeltaEntry{\r\n\t\t\t\tBaseline:      round6(b),\r\n\t\t\t\tCandidate:     round6(c),\r\n\t\t\t\tAbsoluteDelta: round6(abs),\r\n\t\t\t\tRelativeDelta: rel,\r\n"]
[5497.274246, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\tcriticalCount := 0\r\n\twarningCount := 0\r\n\tfor _, metric := range cd.RegressionMetrics {\r\n\t\tt := cfg.Thresholds[metric]\r\n\t\tdirection := metricDirection(metric)\r\n\t\tregressedSplits := []string{}\r\n\t\tfor _, split := range cd.SplitOrder {\r\n\t\t\tb := baseResults[split].Metrics[metric]\r\n\t\t\tc := candResults[split].Metrics[metric]\r\n\t\t\tvar regressionDelta float64"]
[5497.274315, "o", "\r\n\t\t\tif direction == \"lower-is-better\" {\r\n\t\t\t\tregressionDelta = c - b\r\n\t\t\t} else {\r\n\t\t\t\tregressionDelta = b - c\r\n\t\t\t}\r\n\t\t\tmaxDelta := thresholdMaxDelta(t)\r\n\t\t\tmaxRelativeDelta := thresholdMaxRelativeDelta(t)\r\n\t\t\tregressed := regressionDelta > maxDelta\r\n\t\t\tif !regressed && math.Abs(b) > 1e-10 {\r\n"]
[5497.274382, "o", "\t\t\t\trel := regressionDelta / math.Abs(b)\r\n\t\t\t\tif rel > maxRelativeDelta {\r\n\t\t\t\t\tregressed = true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif regressed {\r\n\t\t\t\tregressedSplits = append(regressedSplits, split)\r\n\t\t\t}\r\n\t\t}\r\n"]
[5497.274448, "o", "\t\tverdict := \"PASS\"\r\n\t\tif len(regressedSplits) > 0 {\r\n\t\t\tverdict = \"REGRESSED\"\r\n\t\t\tswitch t.Severity {\r\n\t\t\tcase \"critical\":\r\n\t\t\t\tcriticalCount++\r\n\t\t\tcase \"warning\":\r\n\t\t\t\twarningCount++\r\n\t\t\t}\r\n"]
[5497.274514, "o", "\t\t}\r\n\t\tcd.RegressionAnalysis[metric] = RegressionAnalysisEntry{\r\n\t\t\tSeverity:        t.Severity,\r\n\t\t\tDirection:       direction,\r\n\t\t\tRegressedSplits: regressedSplits,\r\n\t\t\tVerdict:         verdict,\r\n\t\t}\r\n\t}\r\n\tcd.Overall.CriticalRegressions = criticalCount\r\n\tcd.Overall.WarningRegressions = warningCount\r\n"]
[5497.274579, "o", "\tif criticalCount > cfg.Rules.MaxCriticalRegressions || warningCount > cfg.Rules.MaxWarningRegressions {\r\n\t\tcd.Overall.Verdict = \"FAIL\"\r\n\t}\r\n\treturn cd, nil\r\n}\r\n\r\n"]
