[3644.063516, "o", "= report.Splits[ev.Split]\r\nmain.go:810:\t\tfmt.Fprintf(&b, \"## Split: %s\\n\\n\", ev.Split)\r\nmain.go:876:\tfs := flag.NewFlagSet(\"evaluate\", flag.ContinueOnError)\r\nmain.go:940:func buildComparisonData(baseline, candidate NormManifest, cfg RegressionConfig) (ComparisonData, error) {\r\nmain.go:944:\tbaseSplits := make(map[string]bool)\r\nmain.go:946:\t\tbaseSplits[ev.Split] = true\r\nmain.go:949:\t\tif !baseSplits[ev.Split] {\r\nmain.go:950:\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in candidate but not baseline\", ev.Split)\r\nmain.go:956:\t\t\tif cev.Split == ev.Split {\r\nmain.go:962:\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in baseline but not candidate\", ev.Split)\r\nmain.go:971:\t\tSplitOrder:         []string{},\r\nmain.go:974:\t\tRegressionMetrics:  []string{},\r\nmain.go:975:\t\tRegressionAnalysis: make(map[string]RegressionAnalysisEntry),\r\nmain.go:978:\t\t\tMaxCriticalRegressions: cfg.Rules.MaxCriticalRegressions,\r\nmain.go:979:\t\t\tMaxWarningRegressions:  cfg.Rules.MaxWarningRegressions,\r\nmain.go:983:\t\tcd.SplitOrde"]
[3644.06359, "o", "r = append(cd.SplitOrder, ev.Split)\r\nmain.go:987:\t\t\tcd.RegressionMetrics = append(cd.RegressionMetrics, metric)\r\nmain.go:993:\t\tbaseResults[ev.Split] = computeMetrics(taskType, ev.Predictions)\r\nmain.go:996:\t\tcandResults[ev.Split] = computeMetrics(taskType, ev.Predictions)\r\nmain.go:998:\tfor _, split := range cd.SplitOrder {\r\nmain.go:1020:\tfor _, metric := range cd.RegressionMetrics {\r\nmain.go:1022:\t\tregressedSplits := []string{}\r\nmain.go:1023:\t\tfor _, split := range cd.SplitOrder {\r\nmain.go:1035:\t\t\t\tregressedSplits = append(regressedSplits, split)\r\nmain.go:1039:\t\tif len(regressedSplits) > 0 {\r\nmain.go:1048:\t\tcd.RegressionAnalysis[metric] = RegressionAnalysisEntry{\r\nmain.go:1050:\t\t\tRegressedSplits: regressedSplits,\r\nmain.go:1054:\tcd.Overall.CriticalRegressions = criticalCount\r\nmain.go:1055:\tcd.Overall.WarningRegressions = warningCount\r\nmain.go:1056:\tif criticalCount > cfg.Rules.MaxCriticalRegressions || warningCount > cfg.Rules.MaxWarningRegressions {\r\nmain.go:1062:func buildComparisonMarkdown(cd ComparisonData)"]
[3644.063675, "o", " string {\r\nmain.go:1069:\tfmt.Fprintln(&b, \"| Metric | Split | Baseline | Candidate | Delta | Relative Delta |\")\r\nmain.go:1072:\t\tfor _, split := range cd.SplitOrder {\r\nmain.go:1082:\tfmt.Fprintf(&b, \"## Regression Analysis\\n\\n\")\r\nmain.go:1083:\tfmt.Fprintln(&b, \"| Metric | Severity | Regressed Splits | Verdict |\")\r\nmain.go:1085:\tfor _, metric := range cd.RegressionMetrics {\r\nmain.go:1086:\t\tra := cd.RegressionAnalysis[metric]\r\nmain.go:1087:\t\tsplits := strings.Join(ra.RegressedSplits, \", \")\r\nmain.go:1093:\tfmt.Fprintf(&b, \"Critical regressions: %d / %d\\n\", cd.Overall.CriticalRegressions, cd.Overall.MaxCriticalRegressions)\r\nmain.go:1094:\tfmt.Fprintf(&b, \"Warning regressions: %d / %d\\n\", cd.Overall.WarningRegressions, cd.Overall.MaxWarningRegressions)\r\nmain.go:1099:\tfs := flag.NewFlagSet(\"compare\", flag.ContinueOnError)\r\nmain.go:1129:\tcfg, err := loadRegressionConfig(*configPath)\r\nmain.go:1134:\tcd, err := buildComparisonData(baseline, candidate, cfg)\r\nmain.go:1144:\t\tmd := buildComparisonMarkdown(cd)\r\nmain.go:1169:\t\tf"]
[3644.063745, "o", "mt.Fprintln(os.Stderr, \"usage: mlreport <evaluate|compare> ...\")\r\nmain.go:1174:\tcase \"evaluate\":\r\nmain.go:1176:\tcase \"compare\":\r\ndocs/spec_v3.md:5:1. **Conflict -- Metric Direction-Aware Regression Detection:** The `compare` command's regression detection logic has been fundamentally changed to account for **metric direction**. Metrics are now classified as either **higher-is-better** or **lower-is-better**. For higher-is-better metrics, regression means the metric *decreased* (as before). For lower-is-better metrics, regression means the metric *increased*. This replaces the v2 behavior where all metrics used the same comparison direction (`delta < threshold`). See updated Section 2.3 for full details including the new threshold interpretation.\r\ndocs/spec_v3.md:7:2. **Extension -- Split Filtering:** The `evaluate` command now accepts a `--split` flag to evaluate only specified splits. Multiple splits can be specified as comma-separated values.\r\ndocs/spec_v3.md:59:- `evaluations[].split`: Split name (e.g., `\""]
[3644.063815, "o", "test\"`, `\"validation\"`).\r\ndocs/spec_v3.md:75:### 2.2 Regression Configuration\r\ndocs/spec_v3.md:77:Used with the `compare` command to define regression thresholds and rules:\r\ndocs/spec_v3.md:108:**Backward compatibility for config files:** If a threshold entry uses the old field names `min_absolute_delta` and `min_relative_delta` (from v2), they should be treated as follows: `max_delta = -min_absolute_delta` and `max_relative_delta = -min_relative_delta`. The tool must accept both old and new field names. If both old and new field names are present for the same threshold, the new names (`max_delta`, `max_relative_delta`) take precedence.\r\ndocs/spec_v3.md:119:### 2.4 Per-Metric Regression Evaluation\r\ndocs/spec_v3.md:202:### 3.3 Regression Metrics\r\ndocs/spec_v3.md:265:## Split: <split_name>\r\ndocs/spec_v3.md:301:(Repeat \"## Split: ...\" section for each split, in the order they appear in the manifest. When --split is used, only the selected splits appear.)\r\ndocs/spec_v3.md:359:| Metric | Split | Baseline | Candida"]
[3644.063922, "o", "te | Delta | Relative Delta |\r\ndocs/spec_v3.md:365:## Regression Analysis\r\ndocs/spec_v3.md:367:| Metric | Severity | Direction | Regressed Splits | Verdict |\r\ndocs/spec_v3.md:422:mlreport evaluate --manifest <path> --output-dir <path> [--format md|json|both] [--bootstrap <n>] [--confidence <level>] [--seed <int>] [--split <splits>]\r\ndocs/spec_v3.md:444:mlreport compare --baseline <path> --candidate <path> --config <path> --output-dir <path> [--format md|json|both]\r\ndocs/spec_v3.md:464:- `1`: Regression detected (overall FAIL).\r\n"]
