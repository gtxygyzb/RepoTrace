[2897.939425, "o", "    switch os.Args[1] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.939472, "o", "    case \"evaluate\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.93956, "o", "        code = runEvaluate(os.Args[2:])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.939618, "o", "    case \"compare\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.939711, "o", "        code = runCompare(os.Args[2:])\r\n\u001b[?2004l\r\u001b[?2004h> "]
