[2897.93779, "o", "\u001b[?2004h> "]
[2897.93786, "o", "    if *format == \"json\" || *format == \"both\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.93798, "o", "        data, err := json.MarshalIndent(cd, \"\", \"  \")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.938042, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
