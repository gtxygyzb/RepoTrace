[4826.906015, "o", "\\tif *excludeMetric != \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4826.906305, "o", "\\t\\tfor _, name := range strings.Split(*excludeMetric, \",\") {\r\n\u001b[?2004l\r"]
[4826.90636, "o", "\u001b[?2004h> "]
