[4213.943998, "o", "return NormManifest{}, fmt.Errorf(\"%s: invalid model version %q\", path, raw.Model.Version)\r\ndocs/spec_v3.md:15:performance regressions between model versions.\r\ndocs/spec_v3.md:33:    \"version\": \"<string>\",\r\ndocs/spec_v3.md:56:- `model.version`: Semantic version string.\r\ndocs/spec_v3.md:253:# Evaluation Report: <model_name> v<version>\r\ndocs/spec_v3.md:310:    \"version\": \"<string>\",\r\ndocs/spec_v3.md:353:Baseline: <name> v<version>\r\ndocs/spec_v3.md:354:Candidate: <name> v<version>\r\ndocs/spec_v3.md:384:  \"baseline\": { \"name\": \"<string>\", \"version\": \"<string>\" },\r\ndocs/spec_v3.md:385:  \"candidate\": { \"name\": \"<string>\", \"version\": \"<string>\" },\r\n"]
