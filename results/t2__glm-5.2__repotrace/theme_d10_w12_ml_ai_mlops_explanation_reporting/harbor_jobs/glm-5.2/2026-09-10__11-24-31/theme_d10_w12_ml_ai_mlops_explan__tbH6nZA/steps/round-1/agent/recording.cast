[5581.884239, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('main.go')\ns = p.read_text()\n\nold_md = r'''\\tfor _, metric := range cd.RegressionMetrics {\n\\t\\tra := cd.RegressionAnalysis[metric]\n\\t\\tsplits := strings.Join(ra.RegressedSplits, \", \")\n\\t\\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %s |\\\\n\", metric, ra.Severity, ra.Direction, splits, ra.Verdict)\n\\t}\n'''\nnew_md = r'''\\torderedRegressionMetrics := make([]string, 0, len(cd.RegressionAnalysis))\n\\tfor _, metric := range metricOrderForTask(cd.TaskType) {\n\\t\\tif _, ok := cd.RegressionAnalysis[metric]; ok {\n\\t\\t\\torderedRegressionMetrics = append(orderedRegressionMetrics, metric)\n\\t\\t}\n\\t}\n\\tfor _, metric := range orderedRegressionMetrics {\n\\t\\tra := cd.RegressionAnalysis[metric]\n\\t\\tsplits := strings.Join(ra.RegressedSplits, \", \")\n\\t\\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %s |\\\\n\", metric, ra.Severity, ra.Direction, splits, ra.Verdict)\n\\t}\n'''\nif old_md not in s:\n    raise SystemExit('markdown block not found')\ns = s.replace(old_md, new_md, 1)\n\nold_summary_start = r'''f"]
[5581.884322, "i", "unc runSummary(args []string) int {\n\\tfs := flag.NewFlagSet(\"summary\", flag.ContinueOnError)\n\\treportPath := fs.String(\"report\", \"report.json\", \"path to evaluation report JSON\")\n\\tif err := fs.Parse(args); err != nil {\n\\t\\treturn 2\n\\t}\n'''\nnew_summary_start = r'''type SummaryModelJSON struct {\n\\tName     string `json:\"name\"`\n\\tVersion  string `json:\"version\"`\n\\tTaskType string `json:\"task_type\"`\n}\n\ntype SummaryJSON struct {\n\\tModel          SummaryModelJSON   `json:\"model\"`\n\\tSplitCount     int                `json:\"split_count\"`\n\\tPrimaryMetrics map[string]float64 `json:\"primary_metrics\"`\n}\n\nfunc runSummary(args []string) int {\n\\tfs := flag.NewFlagSet(\"summary\", flag.ContinueOnError)\n\\treportPath := fs.String(\"report\", \"report.json\", \"path to evaluation report JSON\")\n\\tjsonOutput := fs.Bool(\"json\", false, \"output summary as JSON\")\n\\tif err := fs.Parse(args); err != nil {\n\\t\\treturn 2\n\\t}\n'''\nif old_summary_start not in s:\n    raise SystemExit('summary start block not found')\ns = s.replace(old_summary_start, "]
[5581.884508, "i", "new_summary_start, 1)\n\nold_metrics = r'''\\tmetricValues := make([]string, 0, len(primary))\n\\tfor _, metric := range primary {\n\\t\\tvals := make([]float64, 0, len(report.Splits))\n\\t\\tfor _, split := range report.Splits {\n\\t\\t\\tif v, ok := split.Metrics[metric]; ok {\n\\t\\t\\t\\tvals = append(vals, v)\n\\t\\t\\t}\n\\t\\t}\n\\t\\tif len(vals) == 0 {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tavg := mean(vals)\n\\t\\tmetricValues = append(metricValues, fmt.Sprintf(\"%s=%.4f\", metric, avg))\n\\t}\n\n\\tfmt.Printf(\"%s v%s (%s) \\u2014 %d split(s): %s\\\\n\",\n\\t\\treport.Model.Name,\n\\t\\treport.Model.Version,\n\\t\\treport.Model.TaskType,\n\\t\\tlen(report.Splits),\n\\t\\tstrings.Join(metricValues, \", \"))\n\\treturn 0\n}\n'''\nnew_metrics = r'''\\tprimaryMetrics := make(map[string]float64)\n\\tmetricValues := make([]string, 0, len(primary))\n\\tfor _, metric := range primary {\n\\t\\tvals := make([]float64, 0, len(report.Splits))\n\\t\\tfor _, split := range report.Splits {\n\\t\\t\\tif v, ok := split.Metrics[metric]; ok {\n\\t\\t\\t\\tvals = append(vals, v)\n\\t\\t\\t}\n\\t\\t}\n\\t\\tif len(vals) == 0 {\n"]
