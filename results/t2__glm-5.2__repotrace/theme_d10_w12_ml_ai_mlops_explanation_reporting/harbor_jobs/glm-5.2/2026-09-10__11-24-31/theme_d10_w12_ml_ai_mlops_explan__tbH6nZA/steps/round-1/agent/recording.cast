[4676.821053, "o", "func buildComparisonData(baseline, candidate NormManifest, cfg RegressionConfig) (ComparisonData, error) {\r\n\tif baseline.Model.TaskType != candidate.Model.TaskType {\r\n\t\treturn ComparisonData{}, fmt.Errorf(\"task type mismatch: baseline %q candidate %q\", baseline.Model.TaskType, candidate.Model.TaskType)\r\n\t}\r\n\tbaseSplits := make(map[string]bool)\r\n\tfor _, ev := range baseline.Evaluations {\r\n\t\tbaseSplits[ev.Split] = true\r\n"]
[4676.82112, "o", "\t}\r\n\tfor _, ev := range candidate.Evaluations {\r\n\t\tif !baseSplits[ev.Split] {\r\n\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in candidate but not baseline\", ev.Split)\r\n\t\t}\r\n\t}\r\n\tfor _, ev := range baseline.Evaluations {\r\n\t\tfound := false\r\n\t\tfor _, cev := range candidate.Evaluations {\r\n\t\t\tif cev.Split == ev.Split {\r\n\t\t\t\tfound = true\r\n\t\t\t\tbreak\r\n"]
[4676.821168, "o", "\t\t\t}\r\n\t\t}\r\n\t\tif !found {\r\n\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in baseline but not candidate\", ev.Split)\r\n\t\t}\r\n\t}\r\n\ttaskType := baseline.Model.TaskType\r\n\tmetricOrder := metricOrderForTask(taskType)\r\n"]
[4676.821219, "o", "\tcd := ComparisonData{\r\n\t\tBaseline:           ModelRef{Name: baseline.Model.Name, Version: baseline.Model.Version},\r\n\t\tCandidate:          ModelRef{Name: candidate.Model.Name, Version: candidate.Model.Version},\r\n\t\tTaskType:           taskType,\r\n\t\tSplitOrder:         []string{},\r\n\t\tMetricOrder:        metricOrder,\r\n\t\tDeltas:             make(map[string]map[string]DeltaEntry),\r\n\t\tRegressionMetrics:  []string{},\r\n\t\tRegressionAnalysis: make(map[string]RegressionAnalysisEntry),\r\n"]
[4676.821275, "o", "\t\tOverall: Overall{\r\n\t\t\tVerdict:                \"PASS\",\r\n\t\t\tMaxCriticalRegressions: cfg.Rules.MaxCriticalRegressions,\r\n\t\t\tMaxWarningRegressions:  cfg.Rules.MaxWarningRegressions,\r\n\t\t},\r\n\t}\r\n\tfor _, ev := range baseline.Evaluations {\r\n\t\tcd.SplitOrder = append(cd.SplitOrder, ev.Split)\r\n\t}\r\n"]
[4676.821331, "o", "\tfor _, metric := range metricOrder {\r\n\t\tif _, ok := cfg.Thresholds[metric]; ok {\r\n\t\t\tcd.RegressionMetrics = append(cd.RegressionMetrics, metric)\r\n\t\t}\r\n\t}\r\n\tbaseResults := make(map[string]EvalResult)\r\n\tcandResults := make(map[string]EvalResult)\r\n\tfor _, ev := range baseline.Evaluations {\r\n"]
[4676.821376, "o", "\t\tbaseResults[ev.Split] = computeMetrics(taskType, ev.Predictions)\r\n\t}\r\n\tfor _, ev := range candidate.Evaluations {\r\n\t\tcandResults[ev.Split] = computeMetrics(taskType, ev.Predictions)\r\n\t}\r\n\tfor _, split := range cd.SplitOrder {\r\n\t\tcd.Deltas[split] = make(map[string]DeltaEntry)\r\n"]
[4676.821427, "o", "\t\tfor _, metric := range metricOrder {\r\n\t\t\tb := baseResults[split].Metrics[metric]\r\n\t\t\tc := candResults[split].Metrics[metric]\r\n\t\t\tabs := c - b\r\n\t\t\tvar rel *float64\r\n\t\t\tif math.Abs(b) > 1e-10 {\r\n\t\t\t\tr := (c - b) / math.Abs(b)\r\n\t\t\t\tr = round6(r)\r\n"]
[4676.82147, "o", "\t\t\t\trel = &r\r\n\t\t\t}\r\n\t\t\tcd.Deltas[split][metric] = DeltaEntry{\r\n\t\t\t\tBaseline:      round6(b),\r\n\t\t\t\tCandidate:     round6(c),\r\n\t\t\t\tAbsoluteDelta: round6(abs),\r\n"]
[4676.82152, "o", "\t\t\t\tRelativeDelta: rel,\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tcriticalCount := 0\r\n\twarningCount := 0\r\n\tfor _, metric := range cd.RegressionMetrics {\r\n\t\tt := cfg.Thresholds[metric]\r\n"]
[4676.821567, "o", "\t\tdirection := metricDirection(metric)\r\n\t\tregressedSplits := []string{}\r\n\t\tfor _, split := range cd.SplitOrder {\r\n\t\t\tb := baseResults[split].Metrics[metric]\r\n\t\t\tc := candResults[split].Metrics[metric]\r\n\t\t\tvar regressionDelta float64\r\n"]
[4676.821614, "o", "\t\t\tif direction == \"lower-is-better\" {\r\n\t\t\t\tregressionDelta = c - b\r\n\t\t\t} else {\r\n\t\t\t\tregressionDelta = b - c\r\n\t\t\t}\r\n\t\t\tmaxDelta := thresholdMaxDelta(t)\r\n\t\t\tmaxRelativeDelta := thresholdMaxRelativeDelta(t)\r\n\t\t\tregressed := regressionDelta > maxDelta\r\n"]
[4676.821664, "o", "\t\t\tif !regressed && math.Abs(b) > 1e-10 {\r\n\t\t\t\trel := regressionDelta / math.Abs(b)\r\n\t\t\t\tif rel > maxRelativeDelta {\r\n\t\t\t\t\tregressed = true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif regressed {\r\n\t\t\t\tregressedSplits = append(regressedSplits, split)\r\n"]
[4676.821713, "o", "\t\t\t}\r\n\t\t}\r\n\t\tverdict := \"PASS\"\r\n\t\tif len(regressedSplits) > 0 {\r\n\t\t\tverdict = \"REGRESSED\"\r\n\t\t\tswitch t.Severity {\r\n\t\t\tcase \"critical\":\r\n"]
[4676.821761, "o", "\t\t\t\tcriticalCount++\r\n\t\t\tcase \"warning\":\r\n\t\t\t\twarningCount++\r\n\t\t\t}\r\n\t\t}\r\n\t\tcd.RegressionAnalysis[metric] = RegressionAnalysisEntry{\r\n\t\t\tSeverity:        t.Severity,\r\n"]
[4676.821811, "o", "\t\t\tDirection:       direction,\r\n\t\t\tRegressedSplits: regressedSplits,\r\n\t\t\tVerdict:         verdict,\r\n\t\t}\r\n\t}\r\n\tcd.Overall.CriticalRegressions = criticalCount\r\n\tcd.Overall.WarningRegressions = warningCount\r\n\tif criticalCount > cfg.Rules.MaxCriticalRegressions || warningCount > cfg.Rules.MaxWarningRegressions {\r\n"]
[4676.821865, "o", "\t\tcd.Overall.Verdict = \"FAIL\"\r\n\t}\r\n\treturn cd, nil\r\n}\r\n\r\nfunc buildComparisonMarkdown(cd ComparisonData) string {\r\n\tvar b strings.Builder\r\n\tfmt.Fprintf(&b, \"# Model Comparison Report\\n\\n\")\r\n\tfmt.Fprintf(&b, \"Baseline: %s v%s\\n\", cd.Baseline.Name, cd.Baseline.Version)\r\n\tfmt.Fprintf(&b, \"Candidate: %s v%s\\n\", cd.Candidate.Name, cd.Candidate.Version)\r\n"]
[4676.821939, "o", "\tfmt.Fprintf(&b, \"Task type: %s\\n\\n\", cd.TaskType)\r\n\tfmt.Fprintf(&b, \"## Performance Delta\\n\\n\")\r\n\tfmt.Fprintln(&b, \"| Metric | Split | Baseline | Candidate | Delta | Relative Delta |\")\r\n\tfmt.Fprintln(&b, \"|--------|-------|----------|-----------|-------|----------------|\")\r\n\tfor _, metric := range cd.MetricOrder {\r\n\t\tfor _, split := range cd.SplitOrder {\r\n\t\t\td := cd.Deltas[split][metric]\r\n\t\t\trel := \"N/A\"\r\n\t\t\tif d.RelativeDelta != nil {\r\n\t"]
[4676.821988, "o", "\t\t\trel = formatFloat2(*d.RelativeDelta*100) + \"%\"\r\n\t\t\t}\r\n\t\t\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %s | %s |\\n\", metric, split, formatFloat6(d.Baseline), formatFloat6(d.Candidate), formatFloat6(d.AbsoluteDelta), rel)\r\n\t\t}\r\n\t}\r\n\tfmt.Fprintln(&b)\r\n\tfmt.Fprintf(&b, \"## Regression Analysis\\n\\n\")\r\n\t"]
[4676.822036, "o", "fmt.Fprintln(&b, \"| Metric | Severity | Direction | Regressed Splits | Verdict |\")\r\n\tfmt.Fprintln(&b, \"|--------|----------|-----------|-----------------|---------|\")\r\n\tfor _, metric := range cd.RegressionMetrics {\r\n\t\tra := cd.RegressionAnalysis[metric]\r\n\t\tsplits := strings.Join(ra.RegressedSplits, \", \")\r\n\t\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %s |\\n\", metric, ra.Severity, ra.Direction, splits, ra.Verdict)\r\n\t}\r\n\tfmt.Fprintln(&b)\r\n\t"]
[4676.822086, "o", "fmt.Fprintf(&b, \"## Overall Verdict\\n\\n\")\r\n\tfmt.Fprintf(&b, \"Result: %s\\n\", cd.Overall.Verdict)\r\n\tfmt.Fprintf(&b, \"Critical regressions: %d / %d\\n\", cd.Overall.CriticalRegressions, cd.Overall.MaxCriticalRegressions)\r\n\tfmt.Fprintf(&b, \"Warning regressions: %d / %d\\n\", cd.Overall.WarningRegressions, cd.Overall.MaxWarningRegressions)\r\n\treturn b.String()\r\n}\r\n\r\nfunc runCompare(args []string) int {\r\n\tfs := flag.NewFlagSet(\"compare\", flag.ContinueOnError)\r\n"]
