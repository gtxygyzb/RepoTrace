[4272.750661, "o", "\"r_squared\": {\r\n                \"baseline\": -1,\r\n                \"candidate\": 1,\r\n                \"absolute_delta\": 2,\r\n                \"relative_delta\": 2\r\n            },\r\n            \"rmse\": {\r\n                \"baseline\": 0.707107,\r\n                \"candidate\": 0,\r\n                \"absolute_delta\": -0.707107,\r\n                \"relative_delta\": -1\r\n            },\r\n            \"smape\": {\r\n                \"baseline\": 66.666667,\r\n                \"candidate\": 0,\r\n                \"absolute_delta\": -66.666667,\r\n                \"relative_delta\": -1\r\n            }\r\n        }\r\n    },\r\n    \"regression_analysis\": {\r\n        \"mse\": {\r\n            \"severity\": \"critical\",\r\n            "]
