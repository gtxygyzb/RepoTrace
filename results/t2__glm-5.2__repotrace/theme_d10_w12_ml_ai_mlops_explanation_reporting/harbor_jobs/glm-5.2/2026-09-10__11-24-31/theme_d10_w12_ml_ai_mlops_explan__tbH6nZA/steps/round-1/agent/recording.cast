[4388.911681, "o", "\tif cd.Overall.Verdict == \"FAIL\" {\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: mlreport <evaluate|compare> ...\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\tvar code int\r\n\tswitch os.Args[1] {\r\n\tcase \"evaluate\":\r\n"]
