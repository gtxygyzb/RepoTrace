[3145.754396, "i", "cat > /tmp/reg_manifest_better.json <<'EOF'\n{\n  \"model\": {\"name\": \"reg-model\", \"version\": \"2.0.0\", \"task_type\": \"regression\"},\n  \"evaluations\": [\n    {\n      \"split\": \"test\",\n      \"dataset\": \"reg-test\",\n      \"predictions\": [\n        {\"id\": \"1\", \"actual\": 1.0, \"predicted\": 1.01},\n        {\"id\": \"2\", \"actual\": 2.0, \"predicted\": 2.01},\n        {\"id\": \"3\", \"actual\": 3.0, \"predicted\": 3.01},\n        {\"id\": \"4\", \"actual\": 4.0, \"predicted\": 4.01}\n      ]\n    }\n  ]\n}\nEOF\ngo run . compare --baseline /tmp/reg_manifest.json --candidate /tmp/reg_manifest_better.json --config /tmp/reg_config.json --output-dir /tmp/out_cmp_fail --format json\necho \"compare exit code: $?\"\ngrep -n '\"smape\"\\|\"verdict\"\\|\"regressed_splits\"' /tmp/out_cmp_fail/comparison.json || true\n"]
