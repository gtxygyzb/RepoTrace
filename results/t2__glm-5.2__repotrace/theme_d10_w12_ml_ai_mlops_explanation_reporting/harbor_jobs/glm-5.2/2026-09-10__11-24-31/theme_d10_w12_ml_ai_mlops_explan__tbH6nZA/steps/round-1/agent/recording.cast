[3941.048249, "o", "'''func loadRegressionConfig(path string) (RegressionConfig, error) {\r\n\u001b[?2004l\rd\u001b[?2004h"]
[3941.048304, "o", "> "]
[3941.048356, "o", "\\tvar cfg RegressionConfig\r\n\u001b[?2004l\r"]
[3941.048411, "o", "\u001b[?2004h> "]
[3941.048511, "o", "\\tif err := readJSON(path, &cfg); err != nil {\r\n\u001b[?2004l\r"]
[3941.048566, "o", "\u001b[?2004h> "]
[3941.04863, "o", "\\t\\treturn RegressionConfig{}, err\r\n\u001b[?2004l\r\u001b[?2004h"]
[3941.048684, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.048791, "o", "\\tfor metric, t := range cfg.Thresholds {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.048864, "o", "\\t\\tswitch t.Severity {\r\n\u001b[?2004l\r"]
[3941.048943, "o", "\u001b[?2004h> "]
[3941.049052, "o", "\\t\\tcase \"critical\", \"warning\", \"info\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.049101, "o", "\\t\\tdefault:\r\n\u001b[?2004l\r"]
[3941.049176, "o", "\u001b[?2004h> "]
[3941.049427, "o", "\\t\\t\\treturn RegressionConfig{}, fmt.Errorf(\"%s: invalid severity %q for metric %q\", path, t.Severity, metric)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.049488, "o", "\\t\\t}\r\n\u001b[?2004l\rt}\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.049552, "o", "\\treturn cfg, nil\r\n\u001b[?2004l\rT\u001b[?2004h> "]
[3941.049606, "o", "}''',\r\n\u001b[?2004l\r=\u001b[?2004h> "]
[3941.049801, "o", "'''func loadRegressionConfig(path string) (RegressionConfig, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.049913, "o", "\\tvar cfg RegressionConfig\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.05003, "o", "\\tif err := readJSON(path, &cfg); err != nil {\r\n\u001b[?2004l\r"]
[3941.050084, "o", "\u001b[?2004h> "]
[3941.050136, "o", "\\t\\treturn RegressionConfig{}, err\r\n\u001b[?2004l\r\u001b[?2004h"]
[3941.050191, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.050312, "o", "\\tfor metric, t := range cfg.Thresholds {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.050384, "o", "\\t\\tswitch t.Severity {\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[3941.050497, "o", "\\t\\tcase \"critical\", \"warning\", \"info\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.050543, "o", "\\t\\tdefault:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.050783, "o", "\\t\\t\\treturn RegressionConfig{}, fmt.Errorf(\"%s: invalid severity %q for metric %q\", path, t.Severity, metric)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.050839, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.050941, "o", "\\t\\tif t.MaxDelta != nil && *t.MaxDelta < 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.05125, "o", "\\t\\t\\treturn RegressionConfig{}, fmt.Errorf(\"%s: max_delta must be non-negative for metric %q\", path, metric)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.051305, "o", "\\t\\t}\r\n\u001b[?2004l\rs\u001b[?2004h> "]
[3941.051452, "o", "\\t\\tif t.MaxRelativeDelta != nil && *t.MaxRelativeDelta < 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.051736, "o", "\\t\\t\\treturn RegressionConfig{}, fmt.Errorf(\"%s: max_relative_delta must be non-negative for metric %q\", path, metric)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.051791, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.051916, "o", "\\t\\tif t.MaxDelta == nil && t.MinAbsoluteDelta > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.052267, "o", "\\t\\t\\treturn RegressionConfig{}, fmt.Errorf(\"%s: invalid min_absolute_delta %q for metric %q; expected non-positive value\", path, t.MinAbsoluteDelta, metric)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.052323, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.05249, "o", "\\t\\tif t.MaxRelativeDelta == nil && t.MinRelativeDelta > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.052826, "o", "\\t\\t\\treturn RegressionConfig{}, fmt.Errorf(\"%s: invalid min_relative_delta %q for metric %q; expected non-positive value\", path, t.MinRelativeDelta, metric)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.052888, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[3941.052955, "o", "\u001b[?2004h> \\treturn cfg, nil\r\n\u001b[?2004l\rm"]
[3941.053011, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[3941.053117, "o", "func metricDirection(metric string) string {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.053166, "o", "\\tswitch metric {\r\n\u001b[?2004l\r"]
[3941.053221, "o", "\u001b[?2004h> "]
