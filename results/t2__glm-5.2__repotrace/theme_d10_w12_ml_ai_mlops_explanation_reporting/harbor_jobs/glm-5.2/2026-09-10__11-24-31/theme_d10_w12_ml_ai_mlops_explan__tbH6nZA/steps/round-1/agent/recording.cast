[4705.992893, "o", "   785\t\t\trng = rand.New(rand.NewSource(seed))\r\n   786\t\t}\r\n   787\t\tfor _, ev := range nm.Evaluations {\r\n   788\t\t\tif len(splits) > 0 {\r\n   789\t\t\t\tfound := false\r\n   790\t\t\t\tfor _, split := range splits {\r\n   791\t\t\t\t\tif split == ev.Split {\r\n   792\t\t\t\t\t\tfound = true\r\n   793\t\t\t\t\t\tbreak\r\n   794\t\t\t\t\t}\r\n   795\t\t\t\t}\r\n"]
