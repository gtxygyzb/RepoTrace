[4229.621612, "o", "   290\t\t\treturn fmt.Errorf(\"parse %s: %w\", path, err)\r\n   291\t\t}\r\n   292\t\treturn nil\r\n   293\t}\r\n   294\t\r\n   295\tfunc loadManifest(path string) (NormManifest, error) {\r\n   296\t\tvar raw Manifest\r\n"]
[4229.621763, "o", "   297\t\tif err := readJSON(path, &raw); err != nil {\r\n   298\t\t\treturn NormManifest{}, err\r\n   299\t\t}\r\n   300\t\tif !validModelName.MatchString(raw.Model.Name) {\r\n   301\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: invalid model name %q\", path, raw.Model.Name)\r\n   302\t\t}\r\n   303\t\tif !validVersion.MatchString(raw.Model.Version) {\r\n   304\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: invalid model version %q\", path, raw.Model.Version)\r\n   305\t\t}\r\n   306\t\tswitch raw.Model.TaskType {\r\n   307\t\tcase \"binary_classification\", \"multiclass_classification\", \"regression\":\r\n   308\t\tdefault:\r\n   309\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: invalid task_type %q\", path, raw.Model.TaskType)\r\n   310\t\t}\r\n   311\t\tif len(raw.Evaluations) == 0 {\r\n   312\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: at least one evaluation is required\", path)\r\n   313\t\t}\r\n   314\t\tnm := NormManifest{Model: raw.Model}\r\n   315\t\tsplits := make(map[string]bool)\r\n   316\t\tfor _, ev := range raw.Evaluations {\r\n"]
[4229.621825, "o", "   317\t\t\tif ev.Split == \"\" {\r\n   318\t\t\t\treturn NormManifest{}, fmt.Errorf(\"%s: split name is required\", path)\r\n   319\t\t\t}\r\n   320\t\t\tif splits[ev.Split] {\r\n"]
[4229.622938, "o", "\u001b[?2004h"]
