[3671.721026, "o", "\r\n    65\ttype RegressionConfig struct {\r\n    66\t\tThresholds map[string]Threshold `json:\"thresholds\"`\r\n    67\t\tRules      Rules                `json:\"rules\"`\r\n    68\t}\r\n    69\t\r\n    70\ttype Threshold struct {\r\n    71\t\tMinAbsoluteDelta float64 `json:\"min_absolute_delta\"`\r\n    72\t\tMinRelativeDelta float64 `json:\"min_relative_delta\"`\r\n    73\t\tSeverity         string  `json:\"severity\"`\r\n    74\t}\r\n"]
