[2897.937241, "o", "    if *format == \"md\" || *format == \"both\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.937336, "o", "        md := buildComparisonMarkdown(cd)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2897.937531, "o", "        if err := writeFile(filepath.Join(*outputDir, \"comparison.md\"), []byte(md)); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
