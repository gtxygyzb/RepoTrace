[5422.649457, "o", "\u001b[32m\u001b[K1185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc buildComparisonMarkdown\u001b[m\u001b[K(cd ComparisonData) string {\r\n"]
[5422.649638, "o", "\u001b[32m\u001b[K1228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\texcludeMetric := fs.String(\"exclude-metric\", \"\", \"comma-separated list of metric names to exclude from \u001b[01;31m\u001b[Kregression analysis\u001b[m\u001b[K\")\r\n"]
[5422.649779, "o", "\u001b[32m\u001b[K1321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KprimaryMetrics\u001b[m\u001b[KForTask(taskType string) []string {\r\n"]
[5422.649867, "o", "\u001b[32m\u001b[K1334\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc runSummary\u001b[m\u001b[K(args []string) int {\r\n"]
[5422.649966, "o", "\u001b[32m\u001b[K1335\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs := flag.NewFlagSet(\"\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K\", flag.ContinueOnError)\r\n\u001b[32m\u001b[K1353\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tprimary := \u001b[01;31m\u001b[KprimaryMetrics\u001b[m\u001b[KForTask(report.Model.TaskType)\r\n"]
[5422.650027, "o", "\u001b[32m\u001b[K1389\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"usage: mlreport <evaluate|compare|\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K> ...\")\r\n\u001b[32m\u001b[K1398\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K\":\r\n"]
