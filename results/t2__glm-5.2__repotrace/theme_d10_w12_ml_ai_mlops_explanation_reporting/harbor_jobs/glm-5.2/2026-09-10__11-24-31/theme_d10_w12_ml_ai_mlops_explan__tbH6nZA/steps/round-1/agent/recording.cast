[5018.465542, "o", "\u001b[32m\u001b[K969\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"--\u001b[01;31m\u001b[Kbootstrap\u001b[m\u001b[K must be non-negative\")\r\n\u001b[32m\u001b[K981\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks []string\r\n\u001b[32m\u001b[K982\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif *\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K != \"\" {\r\n\u001b[32m\u001b[K983\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, name := range strings.Split(*\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K, \",\") {\r\n"]
[5018.465598, "o", "\u001b[32m\u001b[K986\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tfmt.Fprintln(os.Stderr, \"--\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K contains empty \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K names\")\r\n\u001b[32m\u001b[K989\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks = append(\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks, name)\r\n\u001b[32m\u001b[K991\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[KSet := make(map[string]bool)\r\n\u001b[32m\u001b[K992\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, name := range \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks {\r\n\u001b[32m\u001b[K993\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[KSet[name] = true\r\n"]
[5018.465657, "o", "\u001b[32m\u001b[K995\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, name := range \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks {\r\n\u001b[32m\u001b[K1004\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tfmt.Fprintf(os.Stderr, \"\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q not found in manifest\\n\", name)\r\n\u001b[32m\u001b[K1009\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treport := buildReportJSON(nm, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks, *\u001b[01;31m\u001b[Kbootstrap\u001b[m\u001b[K, *confidence, *seed)\r\n\u001b[32m\u001b[K1015\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tmd := buildEvaluateMarkdown(report, nm, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks, *\u001b[01;31m\u001b[Kbootstrap\u001b[m\u001b[K)\r\n"]
[5018.465806, "o", "\u001b[32m\u001b[K1035\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KbuildComparisonData\u001b[m\u001b[K(baseline, candidate NormManifest, cfg RegressionConfig, excludedMetrics map[string]bool) (ComparisonData, error) {\r\n\u001b[32m\u001b[K1045\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn ComparisonData{}, fmt.Errorf(\"\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q present in candidate but not baseline\", ev.Split)\r\n"]
[5018.465868, "o", "\u001b[32m\u001b[K1057\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn ComparisonData{}, fmt.Errorf(\"\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K %q present in baseline but not candidate\", ev.Split)\r\n\u001b[32m\u001b[K1096\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K := range cd.SplitOrder {\r\n\u001b[32m\u001b[K1097\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcd.Deltas[\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K] = make(map[string]DeltaEntry)\r\n"]
[5018.465968, "o", "\u001b[32m\u001b[K1099\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tb := baseResults[\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K].Metrics[metric]\r\n\u001b[32m\u001b[K1100\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tc := candResults[\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K].Metrics[metric]\r\n\u001b[32m\u001b[K1108\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcd.Deltas[\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K][metric] = DeltaEntry{\r\n\u001b[32m\u001b[K1122\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K := range cd.SplitOrder {\r\n\u001b[32m\u001b[K1123\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tb := baseResults[\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K].Metrics[metric]\r\n\u001b[32m\u001b[K1124\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tc := candResults[\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K].Metrics[metric]\r\n"]
[5018.466025, "o", "\u001b[32m\u001b[K1141\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tregressedSplits = append(regressedSplits, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K1179\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K := range cd.SplitOrder {\r\n\u001b[32m\u001b[K1180\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\td := cd.Deltas[\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K][metric]\r\n"]
[5018.466082, "o", "\u001b[32m\u001b[K1185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %s | %s |\\n\", metric, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K, formatFloat6(d.Baseline), formatFloat6(d.Candidate), formatFloat6(d.AbsoluteDelta), rel)\r\n\u001b[32m\u001b[K1194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks := strings.Join(ra.RegressedSplits, \", \")\r\n\u001b[32m\u001b[K1195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %s |\\n\", metric, ra.Severity, ra.Direction, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks, ra.Verdict)\r\n"]
[5018.466162, "o", "\u001b[32m\u001b[K1205\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KrunCompare\u001b[m\u001b[K(args []string) int {\r\n"]
[5018.466218, "o", "\u001b[32m\u001b[K1206\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs := \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.NewFlagSet(\"\u001b[01;31m\u001b[Kcompare\u001b[m\u001b[K\", \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.ContinueOnError)\r\n\u001b[32m\u001b[K1252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcd, err := \u001b[01;31m\u001b[KbuildComparisonData\u001b[m\u001b[K(baseline, candidate, cfg, excludedMetrics)\r\n"]
[5018.46628, "o", "\u001b[32m\u001b[K1299\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs := \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.NewFlagSet(\"summary\", \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K.ContinueOnError)\r\n\u001b[32m\u001b[K1323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"report contains no \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks\")\r\n\u001b[32m\u001b[K1330\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K := range report.Splits {\r\n"]
[5018.466334, "o", "\u001b[32m\u001b[K1331\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif v, ok := \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K.Metrics[metric]; ok {\r\n\u001b[32m\u001b[K1342\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Printf(\"%s v%s (%s) — %d \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K(s): %s\\n\",\r\n"]
[5018.46639, "o", "\u001b[32m\u001b[K1351\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc main\u001b[m\u001b[K() {\r\n\u001b[32m\u001b[K1353\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"usage: mlreport <evaluate|\u001b[01;31m\u001b[Kcompare\u001b[m\u001b[K|summary> ...\")\r\n\u001b[32m\u001b[K1359\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcode = \u001b[01;31m\u001b[KrunEvaluate\u001b[m\u001b[K(os.Args[2:])\r\n\u001b[32m\u001b[K1360\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kcompare\u001b[m\u001b[K\":\r\n\u001b[32m\u001b[K1361\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcode = \u001b[01;31m\u001b[KrunCompare\u001b[m\u001b[K(os.Args[2:])\r\n"]
