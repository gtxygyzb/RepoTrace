[5019.033729, "o", "\t\treturn 0\r\n\t}\r\n\treturn num / den\r\n"]
[5019.033742, "o", "}\r\n\r\nfunc safeDivInt(num, den int) float64 {\r\n"]
[5019.033818, "o", "\tif den == 0 {\r\n\t\treturn 0\r\n\t}\r\n\treturn float64(num) / float64(den)\r\n}\r\n\r\nfunc mean(vals []float64) float64 {\r\n\tif len(vals) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tsum := 0.0\r\n\tfor _, v := range vals {\r\n\t\tsum += v\r\n"]
[5019.033832, "o", "\t}\r\n\treturn sum / float64(len(vals))\r\n"]
