[1755.935678, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\"bytes\"\r\n     5\t\"encoding/json\"\r\n     6\t\"flag\"\r\n     7\t\"fmt\"\r\n     8\t\"math\"\r\n     9\t\"os\"\r\n"]
[1755.935777, "o", "    10\t\"path/filepath\"\r\n    11\t\"regexp\"\r\n    12\t\"sort\"\r\n    13\t\"strings\"\r\n    14\t)\r\n    15\t\r\n    16\ttype Manifest struct {\r\n    17\tModel      Model          `json:\"model\"`\r\n    18\tEvaluations []RawEvaluation `json:\"evaluations\"`\r\n    19\t}\r\n    20\t\r\n    21\ttype Model struct {\r\n    22\tName     string `json:\"name\"`\r\n"]
[1755.93592, "o", "    23\tVersion  string `json:\"version\"`\r\n    24\tTaskType string `json:\"task_type\"`\r\n    25\t}\r\n    26\t\r\n    27\ttype RawEvaluation struct {\r\n    28\tSplit       string          `json:\"split\"`\r\n    29\tDataset    string          `json:\"dataset\"`\r\n    30\tPredictions []RawPrediction `json:\"predictions\"`\r\n    31\t}\r\n    32\t\r\n    33\ttype RawPrediction struct {\r\n    34\tID            string          `json:\"id\"`\r\n    35\tActual        json.RawMessage `json:\"actual\"`\r\n    36\tPredicted     json.RawMessage `json:\"predicted\"`\r\n    37\tProbabilities json.RawMessage `json:\"probabilities\"`\r\n    38\t}\r\n"]
[1755.935999, "o", "    39\t\r\n    40\ttype NormManifest struct {\r\n    41\tModel      Model\r\n    42\tEvaluations []NormEvaluation\r\n    43\t}\r\n    44\t\r\n    45\ttype NormEvaluation struct {\r\n    46\tSplit       string\r\n    47\tDataset     string\r\n    48\tPredictions []NormPrediction\r\n    49\t}\r\n    50\t\r\n    51\ttype NormPrediction struct {\r\n    52\t"]
[1755.936062, "o", "ID            string\r\n    53\tActualStr     string\r\n    54\tPredictedStr  string\r\n    55\tActualNum     float64\r\n    56\tPredictedNum  float64\r\n    57\tProbabilities map[string]float64\r\n    58\t}\r\n    59\t\r\n    60\ttype RegressionConfig struct {\r\n"]
[1755.936145, "o", "    61\tThresholds map[string]Threshold `json:\"thresholds\"`\r\n    62\tRules      Rules                `json:\"rules\"`\r\n    63\t}\r\n    64\t\r\n    65\ttype Threshold struct {\r\n    66\tMinAbsoluteDelta float64 `json:\"min_absolute_delta\"`\r\n    67\tMinRelativeDelta float64 `json:\"min_relative_delta\"`\r\n    68\tSeverity         string  `json:\"severity\"`\r\n    69\t}\r\n    70\t\r\n    71\ttype Rules struct {\r\n    72\tMaxCriticalRegressions int `json:\"max_critical_regressions\"`\r\n    73\tMaxWarningRegressions  int `json:\"max_warning_regressions\"`\r\n"]
[1755.936212, "o", "    74\t}\r\n    75\t\r\n    76\ttype EvalResult struct {\r\n    77\tSplit           string\r\n    78\tDataset         string\r\n    79\tMetrics         map[string]float64\r\n    80\tConfusionMatrix *ConfusionMatrixReport\r\n    81\tPerClassMetrics map[string]PerClassMetric\r\n    82\tClasses         []string\r\n"]
[1755.936276, "o", "    83\t}\r\n    84\t\r\n    85\ttype ConfusionMatrixReport struct {\r\n    86\tClasses []string `json:\"classes\"`\r\n    87\tMatrix  [][]int  `json:\"matrix\"`\r\n    88\t}\r\n    89\t\r\n    90\ttype PerClassMetric struct {\r\n    91\tPrecision float64 `json:\"precision\"`\r\n    92\tRecall    float64 `json:\"recall\"`\r\n    93\t"]
[1755.936336, "o", "F1        float64 `json:\"f1\"`\r\n    94\tSupport   int     `json:\"support\"`\r\n    95\t}\r\n    96\t\r\n    97\ttype SplitReport struct {\r\n    98\tDataset         string                  `json:\"dataset\"`\r\n    99\tMetrics         map[string]float64      `json:\"metrics\"`\r\n   100\tConfusionMatrix *ConfusionMatrixReport  `json:\"confusion_matrix,omitempty\"`\r\n   101\tPerClassMetrics map[string]PerClassMetric `json:\"per_class_metrics,omitempty\"`\r\n"]
[1755.936394, "o", "   102\t}\r\n   103\t\r\n   104\ttype ReportJSON struct {\r\n   105\tModel  Model                  `json:\"model\"`\r\n   106\tSplits map[string]SplitReport `json:\"splits\"`\r\n   107\t}\r\n   108\t\r\n   109\ttype ModelRef struct {\r\n   110\tName    string `json:\"name\"`\r\n   111\tVersion string `json:\"version\"`\r\n"]
[1755.93646, "o", "   112\t}\r\n   113\t\r\n   114\ttype DeltaEntry struct {\r\n   115\tBaseline      float64  `json:\"baseline\"`\r\n   116\t"]
