[5469.326532, "o", "  1185\tfunc buildComparisonMarkdown(cd ComparisonData) string {\r\n  1186\t\tvar b strings.Builder\r\n  1187\t\tfmt.Fprintf(&b, \"# Model Comparison Report\\n\\n\")\r\n  1188\t\tfmt.Fprintf(&b, \"Baseline: %s v%s\\n\", cd.Baseline.Name, cd.Baseline.Version)\r\n  1189\t\tfmt.Fprintf(&b, \"Candidate: %s v%s\\n\", cd.Candidate.Name, cd.Candidate.Version)\r\n  1190\t\t"]
[5469.326633, "o", "fmt.Fprintf(&b, \"Task type: %s\\n\\n\", cd.TaskType)\r\n  1191\t\tfmt.Fprintf(&b, \"## Performance Delta\\n\\n\")\r\n  1192\t\tfmt.Fprintln(&b, \"| Metric | Split | Baseline | Candidate | Delta | Relative Delta |\")\r\n  1193\t\tfmt.Fprintln(&b, \"|--------|-------|----------|-----------|-------|----------------|\")\r\n  1194\t\tfor _, metric := range cd.MetricOrder {\r\n  1195\t\t\tfor _, split := range cd.SplitOrder {\r\n  1196\t\t\t\td := cd.Deltas[split][metric]\r\n  1197\t\t\t\trel := \"N/A\"\r\n  1198\t\t\t\tif d.RelativeDelta != nil {\r\n  1199\t\t\t\t\trel = formatFloat2(*d.RelativeDelta*100) + \"%\"\r\n  1200\t\t\t\t}\r\n  1201\t\t\t\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %s | %s |\\n\", metric, split, formatFloat6(d.Baseline), formatFloat6(d.Candidate), formatFloat6(d.AbsoluteDelta), rel)\r\n  1202\t\t\t}"]
[5469.326709, "o", "\r\n  1203\t\t}\r\n  1204\t\tfmt.Fprintln(&b)\r\n  1205\t\tfmt.Fprintf(&b, \"## Regression Analysis\\n\\n\")\r\n  1206\t\tfmt.Fprintln(&b, \"| Metric | Severity | Direction | Regressed Splits | Verdict |\")\r\n  1207\t\tfmt.Fprintln(&b, \"|--------|----------|-----------|-----------------|---------|\")\r\n"]
[5469.326775, "o", "  1208\t\tfor _, metric := range cd.RegressionMetrics {\r\n  1209\t\t\tra := cd.RegressionAnalysis[metric]\r\n  1210\t\t\tsplits := strings.Join(ra.RegressedSplits, \", \")\r\n  1211\t\t\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %s |\\n\", metric, ra.Severity, ra.Direction, splits, ra.Verdict)\r\n  1212\t\t}\r\n  1213\t\tfmt.Fprintln(&b)\r\n  1214\t\tfmt.Fprintf(&b, \"## Overall Verdict\\n\\n\")\r\n  1215\t\tfmt.Fprintf(&b, \"Result: %s\\n\", cd.Overall.Verdict)\r\n  1216\t\tfmt.Fprintf(&b, \"Critical regressions: %d / %d\\n\", cd.Overall.CriticalRegressions, cd.Overall.MaxCriticalRegressions)\r\n  1217\t\tfmt.Fprintf(&b, \"Warning regressions: %d / %d\\n\", cd.Overall.WarningRegressions, cd.Overall.MaxWarningRegressions)\r\n  1218\t\treturn b.String()\r\n  1219\t}\r\n  1220\t\r\n"]
