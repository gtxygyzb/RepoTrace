[3672.275497, "o", "func buildComparisonData(baseline, candidate NormManifest, cfg RegressionConfig) (ComparisonData, error) {\r\n   941\t\tif baseline.Model.TaskType != candidate.Model.TaskType {\r\n   942\t\t\treturn ComparisonData{}, fmt.Errorf(\"task type mismatch: baseline %q candidate %q\", baseline.Model.TaskType, candidate.Model.TaskType)\r\n   943\t\t}\r\n   944\t\tbaseSplits := make(map[string]bool)\r\n   945\t\tfor _, ev := range baseline.Evaluations {\r\n   946\t\t\tbaseSplits[ev.Split] = true\r\n   947\t\t}\r\n   948\t\tfor _, ev := range candidate.Evaluations {\r\n   949\t\t\tif !baseSplits[ev.Split] {\r\n   950\t\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in candidate but not baseline\", ev.Split)\r\n   951\t\t\t}\r\n"]
[3672.275589, "o", "   952\t\t}\r\n   953\t\tfor _, ev := range baseline.Evaluations {\r\n   954\t\t\tfound := false\r\n   955\t\t\tfor _, cev := range candidate.Evaluations {\r\n   956\t\t\t\tif cev.Split == ev.Split {\r\n   957\t\t\t\t\tfound = true\r\n   958\t\t\t\t\tbreak\r\n   959\t\t\t\t}\r\n   960\t\t\t}\r\n"]
