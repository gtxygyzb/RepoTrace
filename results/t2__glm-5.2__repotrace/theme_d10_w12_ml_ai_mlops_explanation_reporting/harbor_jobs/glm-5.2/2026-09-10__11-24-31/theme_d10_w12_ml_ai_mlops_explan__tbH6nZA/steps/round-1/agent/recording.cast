[3941.054501, "o", "\\t\\treturn *t.MaxRelativeDelta\r\n\u001b[?2004l\r\u001b[?2004h"]
[3941.054555, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.054655, "o", "\\treturn -t.MinRelativeDelta\r\n\u001b[?2004l\r"]
