[3941.059623, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.059692, "o", "\\tfor _, ev := range nm.Evaluations {\r\n\u001b[?2004l\r"]
[3941.059745, "o", "\u001b[?2004h> "]
[3941.059799, "o", "\\t\\tif len(splits) > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.05987, "o", "\\t\\t\\tfound := false\r\n\u001b[?2004l\r"]
[3941.059932, "o", "\u001b[?2004h> "]
[3941.060019, "o", "\\t\\t\\tfor _, split := range splits {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.060119, "o", "\\t\\t\\t\\tif split == ev.Split {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.060191, "o", "\\t\\t\\t\\t\\tfound = true\r\n\u001b[?2004l\r:\u001b[?2004h> "]
[3941.060248, "o", "\\t\\t\\t\\t\\tbreak\r\n\u001b[?2004l\r\u001b[?2004h"]
[3941.060303, "o", "> \\t\\t\\t\\t}\r\n\u001b[?2004l\r=\u001b[?2004h> "]
[3941.060346, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[3941.060401, "o", "\u001b[?2004h> \\t\\t\\tif !found {\r\n\u001b[?2004l\r"]
[3941.060457, "o", "\u001b[?2004h> \\t\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[3941.060511, "o", "\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.060571, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.060697, "o", "\\t\\tresult := computeMetrics(nm.Model.TaskType, ev.Predictions)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.060863, "o", "\\t\\troundedMetrics := make(map[string]float64)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.060999, "o", "\\t\\tfor _, name := range result.MetricOrder {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.061149, "o", "\\t\\t\\troundedMetrics[name] = round6(result.Metrics[name])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.061204, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.061353, "o", "\\t\\tsr := SplitReportJSON{Dataset: ev.Dataset, Metrics: roundedMetrics}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.061527, "o", "\\t\\tif nm.Model.TaskType != \"regression\" && result.ConfusionMatrix != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.061644, "o", "\\t\\t\\tsr.ConfusionMatrix = result.ConfusionMatrix\r\n\u001b[?2004l\r"]
[3941.061702, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.061939, "o", "\\t\\tif nm.Model.TaskType == \"multiclass_classification\" && len(result.PerClassMetrics) > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.062099, "o", "\\t\\t\\tsr.PerClassMetrics = make(map[string]PerClassMetric)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.062253, "o", "\\t\\t\\tfor class, pm := range result.PerClassMetrics {\r\n\u001b[?2004l\r\u001b[?2004h> "]
