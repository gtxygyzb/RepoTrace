[5034.279683, "o", "\u001b[32m\u001b[K1194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks := strings.Join(ra.RegressedSplits, \", \")\r\n\u001b[32m\u001b[K1195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(&b, \"| %s | %s | %s | %s | %s |\\n\", metric, ra.Severity, ra.Direction, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks, ra.Verdict)\r\n\u001b[32m\u001b[K1205\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K\u001b[01;31m\u001b[KrunCompare\u001b[m\u001b[K(args []string) int {\r\n"]
[5034.279736, "o", "\u001b[32m\u001b[K1206\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs := \u001b[01;31m\u001b[Kflag.\u001b[m\u001b[KNewFlagSet(\"\u001b[01;31m\u001b[Kcompare\u001b[m\u001b[K\", \u001b[01;31m\u001b[Kflag.\u001b[m\u001b[KContinueOnError)\r\n"]
[5034.279829, "o", "\u001b[32m\u001b[K1252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcd, err := \u001b[01;31m\u001b[KbuildComparisonData\u001b[m\u001b[K(baseline, candidate, cfg, excludedMetrics)\r\n"]
[5034.279887, "o", "\u001b[32m\u001b[K1285\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KprimaryMetricsForTask(taskType string) []string {\r\n\u001b[32m\u001b[K1298\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunSummary(args []string) int {\r\n\u001b[32m\u001b[K1299\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs := \u001b[01;31m\u001b[Kflag.\u001b[m\u001b[KNewFlagSet(\"summary\", \u001b[01;31m\u001b[Kflag.\u001b[m\u001b[KContinueOnError)\r\n"]
[5034.279949, "o", "\u001b[32m\u001b[K1323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"report contains no \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[Ks\")\r\n\u001b[32m\u001b[K1330\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K := range report.Splits {\r\n\u001b[32m\u001b[K1331\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif v, ok := \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K.Metrics[metric]; ok {\r\n\u001b[32m\u001b[K1342\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Printf(\"%s v%s (%s) — %d \u001b[01;31m\u001b[Ksplit\u001b[m\u001b[K(s): %s\\n\",\r\n"]
[5034.280008, "o", "\u001b[32m\u001b[K1351\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[Kmain() {\r\n\u001b[32m\u001b[K1353\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"usage: mlreport <evaluate|\u001b[01;31m\u001b[Kcompare\u001b[m\u001b[K|summary> ...\")\r\n"]
[5034.280074, "o", "\u001b[32m\u001b[K1359\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcode = \u001b[01;31m\u001b[KrunEvaluate\u001b[m\u001b[K(os.Args[2:])\r\n\u001b[32m\u001b[K1360\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kcompare\u001b[m\u001b[K\":\r\n"]
