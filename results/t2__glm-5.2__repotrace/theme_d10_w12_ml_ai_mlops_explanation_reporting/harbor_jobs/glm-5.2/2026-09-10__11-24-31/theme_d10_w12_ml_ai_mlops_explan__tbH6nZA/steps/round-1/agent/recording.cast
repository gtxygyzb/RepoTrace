[2681.525327, "o", "\u001b[?2004h> "]
[2681.525391, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.525527, "o", "            pc := perClass[c]\r\n\u001b[?2004l\r"]
[2681.525591, "o", "\u001b[?2004h> "]
[2681.525669, "o", "            pc.tp += tp\r\n\u001b[?2004l\r"]
[2681.525734, "o", "\u001b[?2004h> "]
[2681.52581, "o", "            pc.fp += fp\r\n\u001b[?2004l\r"]
[2681.525874, "o", "\u001b[?2004h> "]
