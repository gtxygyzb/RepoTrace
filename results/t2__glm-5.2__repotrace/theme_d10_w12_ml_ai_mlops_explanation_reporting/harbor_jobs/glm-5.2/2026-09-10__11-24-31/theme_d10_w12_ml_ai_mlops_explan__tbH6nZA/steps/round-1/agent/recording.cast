[4396.028273, "o", "\u001b[32m\u001b[K983\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, name := range strings.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K(*split, \",\") {\r\n\u001b[32m\u001b[K998\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K == name {\r\n\u001b[32m\u001b[K1009\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treport := build\u001b[01;31m\u001b[KReport\u001b[m\u001b[KJSON(nm, splits, *bootstrap, *confidence, *seed)\r\n\u001b[32m\u001b[K1036\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif baseline.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K != candidate.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1037\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn ComparisonData{}, fmt.Errorf(\"task type mismatch: baseline %q candidate %q\", baseline.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K, candidate.Model.\u001b[01;31m\u001b[KTaskType\u001b[m\u001b[K)\r\n"]
[4396.028337, "o", "\u001b[32m\u001b[K1039\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tbase\u001b[01;31m\u001b[KSplits\u001b[m\u001b[K := make(map[string]bool)\r\n\u001b[32m\u001b[K1041\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tbase\u001b[01;31m\u001b[KSplits\u001b[m\u001b[K[ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K] = true\r\n\u001b[32m\u001b[K1044\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif !base\u001b[01;31m\u001b[KSplits\u001b[m\u001b[K[ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K] {\r\n\u001b[32m\u001b[K1045\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn ComparisonData{}, fmt.Errorf(\"split %q present in candidate but not baseline\", ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K1051\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif cev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K == ev.\u001b[01;31m\u001b[KSplit\u001b[m\u001b[K {\r\n"]
