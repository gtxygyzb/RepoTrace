[3941.055094, "o", "'''func buildReportJSON(nm NormManifest, bootstrap int, confidence float64, seed int64) ReportJSON {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.055295, "o", "\\treport := ReportJSON{Model: nm.Model, Splits: make(map[string]SplitReportJSON)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.055353, "o", "\\tvar rng *rand.Rand\r\n\u001b[?2004l\r"]
[3941.055406, "o", "\u001b[?2004h> "]
[3941.055461, "o", "\\tif bootstrap > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.055588, "o", "\\t\\trng = rand.New(rand.NewSource(seed))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.055643, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.055727, "o", "\\tfor _, ev := range nm.Evaluations {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.055912, "o", "\\t\\tresult := computeMetrics(nm.Model.TaskType, ev.Predictions)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.056043, "o", "\\t\\troundedMetrics := make(map[string]float64)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.056167, "o", "\\t\\tfor _, name := range result.MetricOrder {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.0563, "o", "\\t\\t\\troundedMetrics[name] = round6(result.Metrics[name])\r\n\u001b[?2004l\r"]
[3941.056355, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.056526, "o", "\\t\\tsr := SplitReportJSON{Dataset: ev.Dataset, Metrics: roundedMetrics}\r\n\u001b[?2004l\r\u001b[?2004h"]
[3941.056581, "o", "> "]
[3941.056748, "o", "\\t\\tif nm.Model.TaskType != \"regression\" && result.ConfusionMatrix != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.056893, "o", "\\t\\t\\tsr.ConfusionMatrix = result.ConfusionMatrix\r\n\u001b[?2004l\r\u001b[?2004h"]
[3941.056949, "o", "> \\t\\t}\r\n\u001b[?2004l\r _, ev\u001b[?2004h> "]
[3941.057164, "o", "\\t\\tif nm.Model.TaskType == \"multiclass_classification\" && len(result.PerClassMetrics) > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.057314, "o", "\\t\\t\\tsr.PerClassMetrics = make(map[string]PerClassMetric)\r\n\u001b[?2004l\r"]
[3941.057367, "o", "\u001b[?2004h> "]
[3941.057474, "o", "\\t\\t\\tfor class, pm := range result.PerClassMetrics {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.057596, "o", "\\t\\t\\t\\tsr.PerClassMetrics[class] = PerClassMetric{\r\n\u001b[?2004l\r"]
[3941.05765, "o", "\u001b[?2004h> "]
[3941.05774, "o", "\\t\\t\\t\\t\\tPrecision: round6(pm.Precision),\r\n\u001b[?2004l\r"]
[3941.057795, "o", "\u001b[?2004h> "]
[3941.057887, "o", "\\t\\t\\t\\t\\tRecall:    round6(pm.Recall),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.057992, "o", "\\t\\t\\t\\t\\tF1:        round6(pm.F1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.058104, "o", "\\t\\t\\t\\t\\tSupport:   pm.Support,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.058158, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\t}"]
[3941.058213, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\rt\u001b[?2004h> "]
[3941.058272, "o", "\\t\\tif bootstrap > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.05852, "o", "\\t\\t\\tsr.ConfidenceIntervals = computeBootstrapCIs(nm.Model.TaskType, ev.Predictions, bootstrap, confidence, rng)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.058574, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.058669, "o", "\\t\\treport.Splits[ev.Split] = sr\r\n\u001b[?2004l\r"]
[3941.058726, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.058785, "o", "\\treturn report\r\n\u001b[?2004l\r"]
[3941.058839, "o", "\u001b[?2004h> }''',\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[3941.059112, "o", "'''func buildReportJSON(nm NormManifest, splits []string, bootstrap int, confidence float64, seed int64) ReportJSON {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.059328, "o", "\\treport := ReportJSON{Model: nm.Model, Splits: make(map[string]SplitReportJSON)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3941.059384, "o", "\\tvar rng *rand.Rand\r\n\u001b[?2004l\r"]
[3941.059436, "o", "\u001b[?2004h> "]
[3941.05949, "o", "\\tif bootstrap > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
