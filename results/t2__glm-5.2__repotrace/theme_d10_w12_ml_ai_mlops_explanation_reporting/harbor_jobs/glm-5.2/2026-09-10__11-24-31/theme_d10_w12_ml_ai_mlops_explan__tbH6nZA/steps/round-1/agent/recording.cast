[2681.52602, "o", "\u001b[?2004h> "]
[2681.526099, "o", "            pc.tn += tn\r\n\u001b[?2004l\r"]
[2681.526162, "o", "\u001b[?2004h> "]
[2681.526258, "o", "            perClass[c] = pc\r\n\u001b[?2004l\r"]
[2681.526321, "o", "\u001b[?2004h> "]
[2681.526386, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.526448, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.526595, "o", "    sumTP, sumFP, sumFN := 0, 0, 0\r\n\u001b[?2004l\r"]
[2681.526658, "o", "\u001b[?2004h> "]
[2681.526833, "o", "    precisions := make([]float64, len(classes))\r\n\u001b[?2004l\r"]
[2681.526924, "o", "\u001b[?2004h> "]
[2681.527061, "o", "    recalls := make([]float64, len(classes))\r\n\u001b[?2004l\r"]
[2681.527125, "o", "\u001b[?2004h> "]
[2681.527271, "o", "    f1s := make([]float64, len(classes))\r\n\u001b[?2004l\r"]
[2681.527333, "o", "\u001b[?2004h> "]
[2681.527483, "o", "    supports := make([]int, len(classes))\r\n\u001b[?2004l\r"]
[2681.527547, "o", "\u001b[?2004h> "]
[2681.52775, "o", "    perClassMetrics := make(map[string]PerClassMetric)\r\n\u001b[?2004l\r"]
[2681.527813, "o", "\u001b[?2004h> "]
[2681.527929, "o", "    for i, c := range classes {\r\n\u001b[?2004l\r"]
[2681.527995, "o", "\u001b[?2004h> "]
[2681.528078, "o", "        pc := perClass[c]\r\n\u001b[?2004l\r"]
[2681.528142, "o", "\u001b[?2004h> "]
[2681.528214, "o", "        sumTP += pc.tp\r\n\u001b[?2004l\r"]
[2681.528278, "o", "\u001b[?2004h> "]
[2681.528352, "o", "        sumFP += pc.fp\r\n\u001b[?2004l\r"]
[2681.528425, "o", "\u001b[?2004h> "]
[2681.528489, "o", "        sumFN += pc.fn\r\n\u001b[?2004l\r"]
[2681.528551, "o", "\u001b[?2004h> "]
[2681.528667, "o", "        supports[i] = pc.support\r\n\u001b[?2004l\r"]
[2681.52873, "o", "\u001b[?2004h> "]
[2681.528935, "o", "        precisions[i] = safeDivInt(pc.tp, pc.tp+pc.fp)\r\n\u001b[?2004l\r"]
[2681.528999, "o", "\u001b[?2004h> "]
[2681.529187, "o", "        recalls[i] = safeDivInt(pc.tp, pc.tp+pc.fn)\r\n\u001b[?2004l\r"]
[2681.52925, "o", "\u001b[?2004h> "]
[2681.529549, "o", "        f1s[i] = safeDiv(2*precisions[i]*recalls[i], precisions[i]+recalls[i])\r\n\u001b[?2004l\r"]
[2681.529615, "o", "\u001b[?2004h> "]
[2681.530042, "o", "        perClassMetrics[c] = PerClassMetric{Precision: precisions[i], Recall: recalls[i], F1: f1s[i], Support: pc.support}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.53011, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.530241, "o", "    accuracy := safeDivInt(correct, total)\r\n\u001b[?2004l\r"]
[2681.530339, "o", "\u001b[?2004h> "]
[2681.530428, "o", "    precisionMicro := safeDivInt(sumTP, sumTP+sumFP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.530516, "o", "> "]
[2681.530598, "o", "    recallMicro := safeDivInt(sumTP, sumTP+sumFN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.530683, "o", "> "]
[2681.530853, "o", "    f1Micro := safeDiv(2*precisionMicro*recallMicro, precisionMicro+recallMicro)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.530955, "o", "> "]
[2681.531049, "o", "    precisionMacro := mean(precisions)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.531128, "o", "    recallMacro := mean(recalls)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.531218, "o", "> "]
[2681.531252, "o", "    f1Macro := mean(f1s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.531416, "o", "    precisionWeighted := weighted(precisions, supports)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.531481, "o", "> "]
[2681.531589, "o", "    recallWeighted := weighted(recalls, supports)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.531656, "o", "> "]
[2681.531737, "o", "    f1Weighted := weighted(f1s, supports)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.531802, "o", "> "]
[2681.531866, "o", "    metrics := map[string]float64{\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.531905, "o", "> "]
[2681.531987, "o", "        \"accuracy\": accuracy,\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.53205, "o", "> "]
[2681.532139, "o", "        \"precision_micro\": precisionMicro,\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.532202, "o", "> "]
[2681.532274, "o", "        \"recall_micro\": recallMicro,\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.532336, "o", "> "]
[2681.532396, "o", "        \"f1_micro\": f1Micro,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.532541, "o", "        \"precision_macro\": precisionMacro,\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.53261, "o", "> "]
[2681.532675, "o", "        \"recall_macro\": recallMacro,\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.53274, "o", "> "]
[2681.532803, "o", "        \"f1_macro\": f1Macro,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.532961, "o", "        \"precision_weighted\": precisionWeighted,\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.533025, "o", "> "]
[2681.533111, "o", "        \"recall_weighted\": recallWeighted,\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.533175, "o", "> "]
[2681.533242, "o", "        \"f1_weighted\": f1Weighted,\r\n\u001b[?2004l\r"]
[2681.533305, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.533851, "o", "    return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask(\"multiclass_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes), PerClassMetrics: perClassMetrics}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.533923, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
