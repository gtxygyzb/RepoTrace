[5442.468743, "o", "\t\ty := 0.0\r\n\t\tif pr.ActualStr == pos {\r\n\t\t\ty = 1.0\r\n\t\t}\r\n\t\tp := 0.0\r\n\t\tif v, ok := pr.Probabilities[pos]; ok {\r\n\t\t\tp = v\r\n\t\t}\r\n\t\tp = math.Min(1-1e-15, math.Max(1e-15, p))\r\n\t\tsum += y*math.Log(p) + (1-y)*math.Log(1-p)\r\n\t}\r\n"]
[5442.468807, "o", "\treturn -sum / float64(len(preds))\r\n}\r\n\r\nfunc makeConfusionMatrix(preds []NormPrediction, classes []string) *ConfusionMatrixReport {\r\n\tif len(classes) == 0 {\r\n\t\treturn nil\r\n\t}\r\n\tidx := make(map[string]int)\r\n\tfor i, c := range classes {\r\n\t\tidx[c] = i\r\n\t}\r\n"]
[5442.468868, "o", "\tmatrix := make([][]int, len(classes))\r\n\tfor i := range matrix {\r\n\t\tmatrix[i] = make([]int, len(classes))\r\n\t}\r\n\tfor _, p := range preds {\r\n\t\tai, ok := idx[p.ActualStr]\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n"]
[5442.468966, "o", "\t\t}\r\n\t\tpi, ok2 := idx[p.PredictedStr]\r\n\t\tif !ok2 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tmatrix[ai][pi]++\r\n\t}\r\n\treturn &ConfusionMatrixReport{Classes: classes, Matrix: matrix}\r\n}\r\n\r\nfunc computeMulticlass(preds []NormPrediction) EvalResult {\r\n\tclasses := collectClasses(preds, true)\r\n\tif len(classes) < 3 {\r\n\t\treturn EvalResult{Metrics: zeroMetrics(metricOrderForTask(\"multiclass_classification\")), MetricOrder: metricOrderForTask(\"multiclass_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}\r\n\t}\r\n\t"]
[5442.469029, "o", "total := len(preds)\r\n\tcorrect := 0\r\n\ttype counts struct{ tp, fp, fn, tn, support int }\r\n\tperClass := make(map[string]counts)\r\n\tfor _, c := range classes {\r\n\t\tperClass[c] = counts{}\r\n\t}\r\n\tfor _, p := range preds {\r\n\t\tif p.ActualStr == p.PredictedStr {\r\n\t"]
[5442.46909, "o", "\t\tcorrect++\r\n\t\t}\r\n\t\tpc := perClass[p.ActualStr]\r\n\t\tpc.support++\r\n\t\tperClass[p.ActualStr] = pc\r\n\t\tfor _, c := range classes {\r\n\t\t\ttp, fp, fn, tn := 0, 0, 0, 0\r\n\t\t\tactualC := p.ActualStr == c\r\n\t\t\tpredC := p.PredictedStr == c\r\n"]
[5442.469145, "o", "\t\t\tif actualC && predC {\r\n\t\t\t\ttp = 1\r\n\t\t\t} else if !actualC && predC {\r\n\t\t\t\tfp = 1\r\n\t\t\t} else if actualC && !predC {\r\n\t\t\t\tfn = 1\r\n\t\t\t} else {\r\n\t\t\t\ttn = 1\r\n"]
[5442.469201, "o", "\t\t\t}\r\n\t\t\tpc := perClass[c]\r\n\t\t\tpc.tp += tp\r\n\t\t\tpc.fp += fp\r\n\t\t\tpc.fn += fn\r\n\t\t\tpc.tn += tn\r\n\t\t\tperClass[c] = pc\r\n\t\t}\r\n\t}\r\n\t"]
[5442.469256, "o", "sumTP, sumFP, sumFN := 0, 0, 0\r\n\tprecisions := make([]float64, len(classes))\r\n\trecalls := make([]float64, len(classes))\r\n\tf1s := make([]float64, len(classes))\r\n\tsupports := make([]int, len(classes))\r\n\tperClassMetrics := make(map[string]PerClassMetric)\r\n\tfor i, c := range classes {\r\n"]
[5442.469318, "o", "\t\tpc := perClass[c]\r\n\t\tsumTP += pc.tp\r\n\t\tsumFP += pc.fp\r\n\t\tsumFN += pc.fn\r\n\t\tsupports[i] = pc.support\r\n\t\tprecisions[i] = safeDivInt(pc.tp, pc.tp+pc.fp)\r\n\t\trecalls[i] = safeDivInt(pc.tp, pc.tp+pc.fn)\r\n\t\tf1s[i] = safeDiv(2*precisions[i]*recalls[i], precisions[i]+recalls[i])\r\n\t\tperClassMetrics[c] = PerClassMetric{Precision: precisions[i], Recall: recalls[i], F1: f1s[i], Support: pc.support}\r\n\t}\r\n\t"]
[5442.469376, "o", "accuracy := safeDivInt(correct, total)\r\n\tprecisionMicro := safeDivInt(sumTP, sumTP+sumFP)\r\n\trecallMicro := safeDivInt(sumTP, sumTP+sumFN)\r\n\tf1Micro := safeDiv(2*precisionMicro*recallMicro, precisionMicro+recallMicro)\r\n\tprecisionMacro := mean(precisions)\r\n\trecallMacro := mean(recalls)\r\n\tf1Macro := mean(f1s)\r\n\tprecisionWeighted := weighted(precisions, supports)\r\n\trecallWeighted := weighted(recalls, supports)\r\n"]
[5442.469436, "o", "\tf1Weighted := weighted(f1s, supports)\r\n\tmetrics := map[string]float64{\r\n\t\t\"accuracy\":           accuracy,\r\n\t\t\"precision_micro\":    precisionMicro,\r\n\t\t\"recall_micro\":       recallMicro,\r\n\t\t\"f1_micro\":           f1Micro,\r\n\t\t\"precision_macro\":    precisionMacro,\r\n\t\t\"recall_macro\":       recallMacro,\r\n"]
[5442.469493, "o", "\t\t\"f1_macro\":           f1Macro,\r\n\t\t\"precision_weighted\": precisionWeighted,\r\n\t\t\"recall_weighted\":    recallWeighted,\r\n\t\t\"f1_weighted\":        f1Weighted,\r\n\t}\r\n\treturn EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask(\"multiclass_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes), PerClassMetrics: perClassMetrics}\r\n}\r\n\r\nfunc computeRegression(preds []NormPrediction) EvalResult {\r\n"]
[5442.469534, "o", "\tn := len(preds)\r\n\tactuals := make([]float64, n)\r\n\tpredicted := make([]float64, n)\r\n\tfor i, p := range preds {\r\n\t\tactuals[i] = p.ActualNum\r\n\t\tpredicted[i] = p.PredictedNum\r\n"]
[5442.46962, "o", "\t}\r\n\tse := 0.0\r\n\tae := 0.0\r\n\tsmapeSum := 0.0\r\n\tsmapeCount := 0\r\n\tfor i := 0; i < n; i++ {\r\n\t\tdiff := actuals[i] - predicted[i]\r\n\t\tse += diff * diff\r\n\t\tae += math.Abs(diff)\r\n\t\tdenom := math.Abs(actuals[i]) + math.Abs(predicted[i])\r\n\t\tif denom >= 1e-10 {\r\n\t\t\tsmapeSum += 2 * math.Abs(diff) / denom\r\n\t\t\tsmapeCount++\r\n"]
[5442.469675, "o", "\t\t}\r\n\t}\r\n\tmse := se / float64(n)\r\n\trmse := math.Sqrt(mse)\r\n\tmae := ae / float64(n)\r\n\tmeanActual := mean(actuals)\r\n\tssRes := 0.0\r\n\tssTot := 0.0\r\n"]
[5442.469738, "o", "\tfor _, a := range actuals {\r\n\t\tssTot += (a - meanActual) * (a - meanActual)\r\n\t}\r\n\tfor i := range actuals {\r\n\t\tdiff := actuals[i] - predicted[i]\r\n\t\tssRes += diff * diff\r\n\t}\r\n\trSquared := 0.0\r\n\tif ssTot != 0 {\r\n\t\trSquared = 1 - ssRes/ssTot\r\n"]
[5442.469794, "o", "\t}\r\n\tsmape := 0.0\r\n\tif smapeCount > 0 {\r\n\t\tsmape = smapeSum / float64(smapeCount) * 100\r\n\t}\r\n\tmetrics := map[string]float64{\r\n\t\t\"mse\":       mse,\r\n\t\t\"rmse\":      rmse,\r\n\t"]
[5442.46985, "o", "\t\"mae\":       mae,\r\n\t\t\"r_squared\": rSquared,\r\n\t\t\"smape\":     smape,\r\n\t}\r\n\treturn EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask(\"regression\")}\r\n}\r\n\r\nfunc zeroMetrics(order []string) map[string]float64 {\r\n\tm := make(map[string]float64)\r\n\t"]
[5442.469935, "o", "for _, name := range order {\r\n\t\tm[name] = 0\r\n\t}\r\n\treturn m\r\n}\r\n\r\nfunc computeBootstrapCIs(taskType string, preds []NormPrediction, B int, confidence float64, rng *rand.Rand) map[string]CI {\r\n\tif B <= 0 {\r\n\t\treturn nil\r\n\t}\r\n\tciMetrics := ciMetricsForTask(taskType)\r\n\tif len(ciMetrics) == 0 {\r\n\t\treturn nil\r\n\t}\r\n\tn := len(preds)\r\n"]
