[2681.460525, "o", "\u001b[?2004h> "]
[2681.460629, "o", "            tp++\r\n\u001b[?2004l\r"]
[2681.460689, "o", "\u001b[?2004h> "]
[2681.460863, "o", "        case !ap && pp:\r\n\u001b[?2004l\r"]
[2681.460943, "o", "\u001b[?2004h> "]
[2681.461062, "o", "            fp++\r\n\u001b[?2004l\r"]
[2681.461127, "o", "\u001b[?2004h> "]
[2681.461349, "o", "        case ap && !pp:\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.461474, "o", "> "]
[2681.461552, "o", "            fn++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.461694, "o", "        default:\r\n\u001b[?2004l\r"]
[2681.461759, "o", "\u001b[?2004h> "]
[2681.461875, "o", "            tn++\r\n\u001b[?2004l\r"]
[2681.461962, "o", "\u001b[?2004h> "]
[2681.462019, "o", "        }\r\n\u001b[?2004l\r"]
[2681.462084, "o", "\u001b[?2004h> "]
[2681.462115, "o", "    }\r\n"]
[2681.462203, "o", "\u001b[?2004l\r"]
[2681.462268, "o", "\u001b[?2004h> "]
[2681.46236, "o", "    total := len(preds)\r\n\u001b[?2004l\r"]
[2681.462424, "o", "\u001b[?2004h> "]
[2681.462705, "o", "    accuracy := safeDivInt(tp+tn, total)\r\n\u001b[?2004l\r"]
[2681.462769, "o", "\u001b[?2004h> "]
[2681.463041, "o", "    precision := safeDivInt(tp, tp+fp)\r\n\u001b[?2004l\r"]
[2681.463106, "o", "\u001b[?2004h> "]
[2681.463348, "o", "    recall := safeDivInt(tp, tp+fn)\r\n\u001b[?2004l\r"]
[2681.463412, "o", "\u001b[?2004h> "]
[2681.463787, "o", "    f1 := safeDiv(2*precision*recall, precision+recall)\r\n\u001b[?2004l\r"]
[2681.463852, "o", "\u001b[?2004h> "]
[2681.464068, "o", "    auc := aucROC(preds, pos)\r\n\u001b[?2004l\r"]
[2681.464134, "o", "\u001b[?2004h> "]
[2681.464332, "o", "    ll := logLoss(preds, pos)\r\n\u001b[?2004l\r"]
[2681.464397, "o", "\u001b[?2004h> "]
[2681.464632, "o", "    metrics := map[string]float64{\r\n\u001b[?2004l\r"]
[2681.464696, "o", "\u001b[?2004h> "]
[2681.464903, "o", "        \"accuracy\": accuracy,\r\n\u001b[?2004l\r"]
[2681.464968, "o", "\u001b[?2004h> "]
[2681.46518, "o", "        \"precision\": precision,\r\n\u001b[?2004l\r"]
[2681.465245, "o", "\u001b[?2004h> "]
[2681.465408, "o", "        \"recall\": recall,\r\n\u001b[?2004l\r"]
[2681.465473, "o", "\u001b[?2004h> "]
[2681.465595, "o", "        \"f1\": f1,\r\n\u001b[?2004l\r"]
[2681.465659, "o", "\u001b[?2004h> "]
[2681.465813, "o", "        \"auc_roc\": auc,\r\n\u001b[?2004l\r"]
[2681.465899, "o", "\u001b[?2004h> "]
[2681.466058, "o", "        \"log_loss\": ll,\r\n\u001b[?2004l\r"]
[2681.466122, "o", "\u001b[?2004h> "]
[2681.466187, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.466251, "o", "> "]
[2681.467067, "o", "    return EvalResult{Metrics: metrics, MetricOrder: metricOrderForTask(\"binary_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}\r\n\u001b[?2004l\r"]
[2681.467137, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.467202, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.467567, "o", "func aucROC(preds []NormPrediction, pos string) float64 {\r\n\u001b[?2004l\r"]
[2681.467631, "o", "\u001b[?2004h> "]
[2681.467711, "o", "    totalPos := 0\r\n\u001b[?2004l\r"]
[2681.467775, "o", "\u001b[?2004h> "]
[2681.467854, "o", "    totalNeg := 0\r\n\u001b[?2004l\r"]
[2681.46793, "o", "\u001b[?2004h> "]
[2681.46804, "o", "    type sample struct {\r\n\u001b[?2004l\r"]
[2681.468104, "o", "\u001b[?2004h> "]
[2681.468197, "o", "        p float64\r\n\u001b[?2004l\r"]
[2681.468261, "o", "\u001b[?2004h> "]
[2681.468327, "o", "        y int\r\n\u001b[?2004l\r"]
[2681.46839, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[2681.468453, "o", "\u001b[?2004h> "]
[2681.468721, "o", "    samples := make([]sample, 0, len(preds))\r\n\u001b[?2004l\r"]
[2681.468787, "o", "\u001b[?2004h> "]
[2681.468936, "o", "    for _, pr := range preds {\r\n\u001b[?2004l\r"]
[2681.469002, "o", "\u001b[?2004h> "]
[2681.469072, "o", "        y := 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.469135, "o", "> "]
[2681.469279, "o", "        if pr.ActualStr == pos {\r\n\u001b[?2004l\r"]
[2681.469342, "o", "\u001b[?2004h> "]
[2681.469422, "o", "            y = 1\r\n\u001b[?2004l\r"]
[2681.469485, "o", "\u001b[?2004h> "]
[2681.469589, "o", "            totalPos++\r\n\u001b[?2004l\r"]
[2681.469653, "o", "\u001b[?2004h> "]
[2681.469731, "o", "        } else {\r\n\u001b[?2004l\r"]
[2681.469797, "o", "\u001b[?2004h> "]
[2681.469916, "o", "            totalNeg++\r\n\u001b[?2004l\r"]
[2681.46998, "o", "\u001b[?2004h> "]
[2681.470043, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.470157, "o", "        p := 0.0\r\n\u001b[?2004l\r"]
[2681.470221, "o", "\u001b[?2004h> "]
[2681.470474, "o", "        if v, ok := pr.Probabilities[pos]; ok {\r\n\u001b[?2004l\r"]
[2681.470536, "o", "\u001b[?2004h> "]
[2681.470617, "o", "            p = v\r\n\u001b[?2004l\r"]
[2681.470682, "o", "\u001b[?2004h> "]
[2681.470745, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.470809, "o", "> "]
[2681.471098, "o", "        samples = append(samples, sample{p: p, y: y})\r\n\u001b[?2004l\r"]
[2681.471163, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[2681.471227, "o", "\u001b[?2004h> "]
[2681.471439, "o", "    if totalPos == 0 || totalNeg == 0 {\r\n\u001b[?2004l\r"]
[2681.471502, "o", "\u001b[?2004h> "]
[2681.47158, "o", "        return 0\r\n\u001b[?2004l\r"]
[2681.471643, "o", "\u001b[?2004h>     }\r\n"]
[2681.471706, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[2681.472026, "o", "    sort.SliceStable(samples, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[2681.472091, "o", "\u001b[?2004h> "]
[2681.472328, "o", "        if samples[i].p != samples[j].p {\r\n\u001b[?2004l\r"]
[2681.472393, "o", "\u001b[?2004h> "]
[2681.472657, "o", "            return samples[i].p > samples[j].p\r\n\u001b[?2004l\r"]
[2681.47272, "o", "\u001b[?2004h> "]
[2681.472782, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.473046, "o", "        return samples[i].y > samples[j].y\r\n\u001b[?2004l\r"]
[2681.473112, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
[2681.473185, "o", "\u001b[?2004h> "]
[2681.473454, "o", "    points := []struct{ fpr, tpr float64 }{{0, 0}}\r\n\u001b[?2004l\r"]
[2681.47352, "o", "\u001b[?2004h> "]
[2681.473583, "o", "    cumTP := 0\r\n\u001b[?2004l\r"]
[2681.47365, "o", "\u001b[?2004h> "]
[2681.473716, "o", "    cumFP := 0\r\n\u001b[?2004l\r"]
[2681.473778, "o", "\u001b[?2004h> "]
[2681.473948, "o", "    for _, s := range samples {\r\n\u001b[?2004l\r"]
[2681.474014, "o", "\u001b[?2004h> "]
[2681.474118, "o", "        if s.y == 1 {\r\n\u001b[?2004l\r"]
[2681.474182, "o", "\u001b[?2004h> "]
[2681.474277, "o", "            cumTP++\r\n\u001b[?2004l\r"]
[2681.47434, "o", "\u001b[?2004h> "]
[2681.474414, "o", "        } else {\r\n\u001b[?2004l\r"]
[2681.474479, "o", "\u001b[?2004h> "]
[2681.474567, "o", "            cumFP++\r\n\u001b[?2004l\r"]
[2681.474633, "o", "\u001b[?2004h> "]
[2681.474696, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.474989, "o", "        tpr := float64(cumTP) / float64(totalPos)\r\n\u001b[?2004l\r"]
[2681.475059, "o", "\u001b[?2004h> "]
[2681.475331, "o", "        fpr := float64(cumFP) / float64(totalNeg)\r\n\u001b[?2004l\r"]
[2681.475394, "o", "\u001b[?2004h> "]
[2681.475804, "o", "        points = append(points, struct{ fpr, tpr float64 }{fpr, tpr})\r\n\u001b[?2004l\r"]
[2681.475867, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[2681.505814, "o", "\u001b[?2004h> "]
[2681.505958, "o", "    auc := 0.0\r\n\u001b[?2004l\r"]
[2681.506031, "o", "\u001b[?2004h> "]
[2681.506292, "o", "    for i := 1; i < len(points); i++ {\r\n\u001b[?2004l\r"]
[2681.506358, "o", "\u001b[?2004h> "]
[2681.506952, "o", "        auc += (points[i].fpr - points[i-1].fpr) * (points[i].tpr + points[i-1].tpr) / 2\r\n\u001b[?2004l\r"]
[2681.50702, "o", "\u001b[?2004h> "]
[2681.507085, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.50715, "o", "> "]
[2681.50723, "o", "    return auc\r\n\u001b[?2004l\r"]
[2681.507295, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2681.507359, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2681.507422, "o", "\u001b[?2004h> "]
[2681.507822, "o", "func logLoss(preds []NormPrediction, pos string) float64 {\r\n\u001b[?2004l\r"]
[2681.507893, "o", "\u001b[?2004h> "]
[2681.508061, "o", "    if len(preds) == 0 {\r\n\u001b[?2004l\r"]
[2681.508125, "o", "\u001b[?2004h> "]
[2681.508244, "o", "        return 0\r\n\u001b[?2004l\r"]
[2681.508307, "o", "\u001b[?2004h> "]
[2681.508373, "o", "    }\r\n\u001b[?2004l\r"]
[2681.508436, "o", "\u001b[?2004h> "]
[2681.508516, "o", "    sum := 0.0\r\n\u001b[?2004l\r"]
[2681.508577, "o", "\u001b[?2004h> "]
[2681.508796, "o", "    for _, pr := range preds {\r\n\u001b[?2004l\r"]
[2681.508859, "o", "\u001b[?2004h> "]
[2681.508981, "o", "        y := 0.0\r\n\u001b[?2004l\r"]
[2681.509046, "o", "\u001b[?2004h> "]
[2681.509269, "o", "        if pr.ActualStr == pos {\r\n\u001b[?2004l\r"]
[2681.509333, "o", "\u001b[?2004h> "]
[2681.509459, "o", "            y = 1.0\r\n\u001b[?2004l\r"]
[2681.509525, "o", "\u001b[?2004h> "]
[2681.509609, "o", "        }\r\n\u001b[?2004l\r"]
[2681.509674, "o", "\u001b[?2004h> "]
[2681.509781, "o", "        p := 0.0\r\n\u001b[?2004l\r"]
[2681.509844, "o", "\u001b[?2004h> "]
[2681.51018, "o", "        if v, ok := pr.Probabilities[pos]; ok {\r\n\u001b[?2004l\r"]
[2681.510244, "o", "\u001b[?2004h> "]
[2681.510364, "o", "            p = v\r\n\u001b[?2004l\r"]
[2681.51043, "o", "\u001b[?2004h> "]
[2681.510493, "o", "        }\r\n\u001b[?2004l\r"]
[2681.510559, "o", "\u001b[?2004h> "]
[2681.510895, "o", "        p = math.Min(1-1e-15, math.Max(1e-15, p))\r\n\u001b[?2004l\r"]
[2681.510962, "o", "\u001b[?2004h> "]
[2681.511305, "o", "        sum += y*math.Log(p) + (1-y)*math.Log(1-p)\r\n\u001b[?2004l\r"]
[2681.511368, "o", "\u001b[?2004h> "]
[2681.511433, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.511497, "o", "> "]
[2681.511728, "o", "    return -sum / float64(len(preds))\r\n\u001b[?2004l\r"]
[2681.511793, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2681.511858, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2681.511929, "o", "\u001b[?2004h> "]
[2681.512539, "o", "func makeConfusionMatrix(preds []NormPrediction, classes []string) *ConfusionMatrixReport {\r\n\u001b[?2004l\r"]
[2681.512604, "o", "\u001b[?2004h> "]
[2681.512787, "o", "    if len(classes) == 0 {\r\n\u001b[?2004l\r"]
[2681.512853, "o", "\u001b[?2004h> "]
[2681.512985, "o", "        return nil\r\n\u001b[?2004l\r"]
[2681.51305, "o", "\u001b[?2004h> "]
[2681.513114, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.513178, "o", "> "]
[2681.513361, "o", "    idx := make(map[string]int)\r\n\u001b[?2004l\r"]
[2681.513427, "o", "\u001b[?2004h> "]
[2681.513638, "o", "    for i, c := range classes {\r\n\u001b[?2004l\r"]
[2681.513704, "o", "\u001b[?2004h> "]
[2681.513825, "o", "        idx[c] = i\r\n\u001b[?2004l\r"]
[2681.513897, "o", "\u001b[?2004h> "]
[2681.513962, "o", "    }\r\n\u001b[?2004l\r"]
[2681.514027, "o", "\u001b[?2004h> "]
[2681.514287, "o", "    matrix := make([][]int, len(classes))\r\n\u001b[?2004l\r"]
[2681.514352, "o", "\u001b[?2004h> "]
[2681.514537, "o", "    for i := range matrix {\r\n\u001b[?2004l\r"]
[2681.514603, "o", "\u001b[?2004h> "]
[2681.514908, "o", "        matrix[i] = make([]int, len(classes))\r\n\u001b[?2004l\r"]
[2681.514975, "o", "\u001b[?2004h> "]
[2681.51504, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.515107, "o", "> "]
[2681.515276, "o", "    for _, p := range preds {\r\n\u001b[?2004l\r"]
[2681.51534, "o", "\u001b[?2004h> "]
[2681.515579, "o", "        ai, ok := idx[p.ActualStr]\r\n\u001b[?2004l\r"]
[2681.515642, "o", "\u001b[?2004h> "]
[2681.515756, "o", "        if !ok {\r\n\u001b[?2004l\r"]
[2681.515821, "o", "\u001b[?2004h> "]
[2681.51599, "o", "            continue\r\n\u001b[?2004l\r"]
[2681.516057, "o", "\u001b[?2004h> "]
[2681.516119, "o", "        }\r\n\u001b[?2004l\r"]
[2681.516184, "o", "\u001b[?2004h> "]
[2681.516445, "o", "        pi, ok2 := idx[p.PredictedStr]\r\n\u001b[?2004l\r"]
[2681.516508, "o", "\u001b[?2004h> "]
[2681.516631, "o", "        if !ok2 {\r\n\u001b[?2004l\r"]
[2681.516694, "o", "\u001b[?2004h> "]
[2681.516834, "o", "            continue\r\n\u001b[?2004l\r"]
[2681.516905, "o", "\u001b[?2004h> "]
[2681.516973, "o", "        }\r\n\u001b[?2004l\r"]
[2681.517038, "o", "\u001b[?2004h> "]
[2681.517201, "o", "        matrix[ai][pi]++\r\n\u001b[?2004l\r"]
[2681.517264, "o", "\u001b[?2004h> "]
[2681.517327, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2681.517392, "o", "> "]
[2681.517825, "o", "    return &ConfusionMatrixReport{Classes: classes, Matrix: matrix}\r\n\u001b[?2004l\r"]
[2681.517896, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2681.517953, "o", "\u001b[?2004h> \r\n"]
[2681.518021, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[2681.518435, "o", "func computeMulticlass(preds []NormPrediction) EvalResult {\r\n\u001b[?2004l\r"]
[2681.518504, "o", "\u001b[?2004h> "]
[2681.518787, "o", "    classes := collectClasses(preds, true)\r\n\u001b[?2004l\r"]
[2681.518852, "o", "\u001b[?2004h> "]
[2681.51903, "o", "    if len(classes) < 3 {\r\n\u001b[?2004l\r"]
[2681.519096, "o", "\u001b[?2004h> "]
[2681.520273, "o", "        return EvalResult{Metrics: zeroMetrics(metricOrderForTask(\"multiclass_classification\")), MetricOrder: metricOrderForTask(\"multiclass_classification\"), ConfusionMatrix: makeConfusionMatrix(preds, classes)}\r\n\u001b[?2004l\r"]
[2681.520343, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[2681.520434, "o", "\u001b[?2004h> "]
[2681.520535, "o", "    total := len(preds)\r\n\u001b[?2004l\r"]
[2681.520564, "o", "\u001b[?2004h"]
[2681.520707, "o", "> "]
[2681.5208, "o", "    correct := 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.521055, "o", "    type counts struct{ tp, fp, fn, tn, support int }\r\n\u001b[?2004l\r"]
[2681.521124, "o", "\u001b[?2004h> "]
[2681.52134, "o", "    perClass := make(map[string]counts)\r\n\u001b[?2004l\r"]
[2681.521403, "o", "\u001b[?2004h> "]
[2681.521575, "o", "    for _, c := range classes {\r\n\u001b[?2004l\r"]
[2681.52164, "o", "\u001b[?2004h> "]
[2681.521812, "o", "        perClass[c] = counts{}\r\n\u001b[?2004l\r"]
[2681.521884, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[2681.521951, "o", "\u001b[?2004h> "]
[2681.52212, "o", "    for _, p := range preds {\r\n\u001b[?2004l\r"]
[2681.522187, "o", "\u001b[?2004h> "]
[2681.52243, "o", "        if p.ActualStr == p.PredictedStr {\r\n\u001b[?2004l\r"]
[2681.522495, "o", "\u001b[?2004h> "]
[2681.522564, "o", "            correct++\r\n\u001b[?2004l\r"]
[2681.52263, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[2681.522694, "o", "\u001b[?2004h> "]
[2681.522835, "o", "        pc := perClass[p.ActualStr]\r\n\u001b[?2004l\r"]
[2681.522928, "o", "\u001b[?2004h> "]
[2681.522993, "o", "        pc.support++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2681.523152, "o", "        perClass[p.ActualStr] = pc\r\n\u001b[?2004l\r"]
[2681.523217, "o", "\u001b[?2004h> "]
[2681.523343, "o", "        for _, c := range classes {\r\n\u001b[?2004l\r"]
[2681.523406, "o", "\u001b[?2004h> "]
[2681.523553, "o", "            tp, fp, fn, tn := 0, 0, 0, 0\r\n\u001b[?2004l\r"]
[2681.523616, "o", "\u001b[?2004h> "]
[2681.523759, "o", "            actualC := p.ActualStr == c\r\n\u001b[?2004l\r"]
[2681.523823, "o", "\u001b[?2004h> "]
[2681.523973, "o", "            predC := p.PredictedStr == c\r\n\u001b[?2004l\r"]
[2681.524038, "o", "\u001b[?2004h> "]
[2681.524155, "o", "            if actualC && predC {\r\n\u001b[?2004l\r"]
[2681.524218, "o", "\u001b[?2004h> "]
[2681.524295, "o", "                tp = 1\r\n\u001b[?2004l\r"]
[2681.524358, "o", "\u001b[?2004h> "]
[2681.524507, "o", "            } else if !actualC && predC {\r\n\u001b[?2004l\r"]
[2681.524572, "o", "\u001b[?2004h> "]
[2681.524644, "o", "                fp = 1\r\n\u001b[?2004l\r"]
[2681.524709, "o", "\u001b[?2004h> "]
[2681.524857, "o", "            } else if actualC && !predC {\r\n\u001b[?2004l\r"]
[2681.524932, "o", "\u001b[?2004h> "]
[2681.524998, "o", "                fn = 1\r\n\u001b[?2004l\r"]
[2681.525061, "o", "\u001b[?2004h> "]
[2681.525127, "o", "            } else {\r\n\u001b[?2004l\r"]
[2681.52519, "o", "\u001b[?2004h> "]
