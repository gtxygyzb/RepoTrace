[2645.558167, "o", "\u001b[?2004h> "]
[2645.558669, "o", "    case \"binary_classification\", \"multiclass_classification\", \"regression\":\r\n\u001b[?2004l\r"]
[2645.558735, "o", "\u001b[?2004h> "]
[2645.558824, "o", "    default:\r\n\u001b[?2004l\r"]
[2645.558911, "o", "\u001b[?2004h> "]
