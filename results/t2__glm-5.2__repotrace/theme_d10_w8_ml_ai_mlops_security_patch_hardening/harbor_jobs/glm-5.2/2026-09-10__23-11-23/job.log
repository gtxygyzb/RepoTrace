Sending keys: ['cat > internal/server/handlers.go <<\'EOF\'\npackage server\n\nimport (\n    "encoding/json"\n    "errors"\n    "fmt"\n    "io"\n    "net/http"\n    "strconv"\n    "strings"\n    "time"\n\n    "mlgateway/internal/audit"\n    "mlgateway/internal/auth"\n    "mlgateway/internal/config"\n    "mlgateway/internal/inference"\n    "mlgateway/internal/metrics"\n    "mlgateway/internal/registry"\n    "mlgateway/internal/store"\n    "mlgateway/internal/webhooks"\n)\n\ntype Server struct {\n    cfg       *config.Config\n    store     *store.Store\n    auth      *auth.Service\n    registry  *registry.Service\n    inference *inference.Service\n    metrics   *metrics.Service\n    audit     *audit.Service\n    webhooks  *webhooks.Service\n    startTime time.Time\n}\n\nfunc New(cfg *config.Config, st *store.Store, as *auth.Service, rs *registry.Service, is *inference.Service, ms *metrics.Service, aus *audit.Service, ws *webhooks.Service, startTime time.Time) *Server {\n    return &Server{\n        cfg:       cfg,\n        store:     st,\n        auth:      as,\n        registry:  rs,\n        inference: is,\n        metrics:   ms,\n        audit:     aus,\n        webhooks:  ws,\n        startTime: startTime,\n    }\n}\n\nfunc writeJSON(w http.ResponseWriter, status int, v interface{}) {\n    w.Header().Set("Content-Type", "application/json")\n    w.WriteHeader(status)\n    _ = json.NewEncoder(w).Encode(v)\n}\n\nfunc writeError(w http.ResponseWriter, status int, msg string) {\n    writeJSON(w, status, map[string]string{"error": msg})\n}\n\nfunc (s *Server) auditReq(r *http.Request, user, action, resourceType, resourceID, details string) {\n    s.audit.Add(user, action, resourceType, resourceID, details, clientIP(r))\n}\n\nfunc clientIP(r *http.Request) string {\n    if ip := r.Header.Get("X-Forwarded-For"); ip != "" {\n        return strings.Split(ip, ",")[0]\n    }\n    return r.RemoteAddr\n}\n\nfunc (s *Server) Health(w http.ResponseWriter, r *http.Request) {\n    writeJSON(w, http.StatusOK, map[string]interface{}{\n        "status":          "healthy",\n        "uptime_seconds":  int64(time.Since(s.startTime).Seconds()),\n    })\n}\n\nfunc (s *Server) RegisterUser(w http.ResponseWriter, r *http.Request) {\n    var req struct {\n        Username string `json:"username"`\n        Password string `json:"password"`\n        Role     string `json:"role"`\n    }\n    if err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n        writeError(w, http.StatusBadRequest, "invalid request body")\n        return\n    }\n\n    callerRole := ""\n    if user, ok := s.authFromRequest(r); ok {\n        callerRole = user.Role\n    }\n\n    user, err := s.auth.Register(req.Username, req.Password, req.Role, callerRole)\n    if err != nil {\n        switch {\n        case errors.Is(err, auth.ErrForbidden):\n            writeError(w, http.StatusForbidden, err.Error())\n        case errors.Is(err, auth.ErrInvalidRole), strings.Contains(err.Error(), "required"):\n            writeError(w, http.StatusBadRequest, err.Error())\n        case errors.Is(err, auth.ErrUsernameExists):\n            writeError(w, http.StatusConflict, err.Error())\n        default:\n            writeError(w, http.StatusBadRequest, err.Error())\n        }\n        return\n    }\n\n    s.auditReq(r, user.Username, "user.register", "user", user.ID, "role="+user.Role)\n    writeJSON(w, http.StatusCreated, map[string]interface{}{\n        "id":       user.ID,\n        "username": user.Username,\n        "role":     user.Role,\n        "api_key":  user.APIKey,\n    })\n}\n\nfunc (s *Server) Login(w http.ResponseWriter, r *http.Request) {\n    var req struct {\n        Username string `json:"username"`\n        Password string `json:"password"`\n    }\n    if err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n        writeError(w, http.StatusBadRequest, "invalid request body")\n        return\n    }\n\n    apiKey, role, err := s.auth.Login(req.Username, req.Password)\n    if err != nil {\n        writeError(w, http.StatusUnauthorized, "invalid credentials")\n        return\n    }\n\n    s.auditReq(r, req.Username, "user.login", "user", req.Username, "")\n    writeJSON(w, http.StatusOK, map[string]string{"api_key": apiKey, "role": role})\n}\n\nfunc (s *Server) authFromRequest(r *http.Request) (*store.User, bool) {\n    authHeader := r.Header.Get("Authorization")\n    if !strings.HasPrefix(authHeader, "Bearer ") {\n        return nil, false\n    }\n    token := strings.TrimPrefix(authHeader, "Bearer ")\n    return s.auth.Authenticate(token)\n}\n\nfunc (s *Server) RegisterModel(w http.ResponseWriter, r *http.Request) {\n    user, ok := s.authFromRequest(r)\n    if !ok {\n        writeError(w, http.StatusUnauthorized, "unauthorized")\n        return\n    }\n    if !auth.CanAccess(user.Role, auth.RoleDeployer) {\n        writeError(w, http.StatusForbidden, "insufficient role")\n        return\n    }\n\n    var m store.Model\n    if err := json.NewDecoder(r.Body).Decode(&m); err != nil {\n        writeError(w, http.StatusBadRequest, "invalid request body")\n        return\n    }\n\n    created, err := s.registry.Register(&m)\n    if err != nil {\n        s.writeRegistryError(w, err)\n        return\n    }\n\n    s.auditReq(r, user.Username, "model.register", "model", created.ID, "name="+created.Name)\n    s.webhooks.Fire("model.created", created)\n    writeJSON(w, http.StatusCreated, created)\n}\n\nfunc (s *Server) writeRegistryError(w http.ResponseWriter, err error) {\n    switch {\n    case errors.Is(err, registry.ErrValidation):\n        writeError(w, http.StatusBadRequest, err.Error())\n    case errors.Is(err, registry.ErrConflict):\n        writeError(w, http.StatusConflict, err.Error())\n    case errors.Is(err, registry.ErrNotFound):\n        writeError(w, http.StatusNotFound, err.Error())\n    case errors.Is(err, registry.ErrTooLarge):\n        writeError(w, http.StatusRequestEntityTooLarge, err.Error())\n    default:\n        writeError(w, http.StatusInternalServerError, err.Error())\n    }\n}\n\nfunc (s *Server) ListModels(w http.ResponseWriter, r *http.Request) {\n    if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\n        return\n    }\n\n    q := r.URL.Query()\n    var deployedFilter *bool\n    if d := q.Get("deployed"); d != "" {\n        b, err := strconv.ParseBool(d)\n        if err == nil {\n            deployedFilter = &b\n        }\n    }\n\n    models := s.registry.List(q.Get("name"), q.Get("framework"), q.Get("label_key"), q.Get("label_value"), deployedFilter)\n    writeJSON(w, http.StatusOK, map[string]interface{}{"models": models})\n}\n\nfunc (s *Server) GetModel(w http.ResponseWriter, r *http.Request) {\n    if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\n        return\n    }\n    id := r.PathValue("id")\n    model, err := s.registry.Get(id)\n    if err != nil {\n        writeError(w, http.StatusNotFound, "model not found")\n        return\n    }\n    writeJSON(w, http.StatusOK, model)\n}\n\nfunc (s *Server) DeleteModel(w http.ResponseWriter, r *http.Request) {\n    user, ok := s.requireAuth(w, r, auth.RoleDeployer)\n    if !ok {\n        return\n    }\n    id := r.PathValue("id")\n    model, err := s.registry.Get(id)\n    if err != nil {\n        writeError(w, http.StatusNotFound, "model not found")\n        return\n    }\n    if err := s.registry.Delete(id); err != nil {\n        if errors.Is(err, registry.ErrConflict) {\n            writeError(w, http.StatusConflict, err.Error())\n        } else {\n            writeError(w, http.StatusInternalServerError, err.Error())\n        }\n        return\n    }\n    s.auditReq(r, user.Username, "model.delete", "model", id, "name="+model.Name)\n    s.webhooks.Fire("model.deleted", model)\n    writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})\n}\n\nfunc (s *Server) UploadVersion(w http.ResponseWriter, r *http.Request) {\n    user, ok := s.requireAuth(w, r, auth.RoleDeployer)\n    if !ok {\n        return\n    }\n    id := r.PathValue("id")\n\n    if err := r.ParseMultipartForm(int64(s.cfg.MaxModelSizeMB) * 1024 * 1024); err != nil {\n        writeError(w, http.StatusBadRequest, "invalid multipart form: "+err.Error())\n        return\n    }\n\n    version := r.FormValue("version")\n    releaseNotes := r.FormValue("release_notes")\n    file, _, err := r.FormFile("binary")\n    if err != nil {\n        writeError(w, http.StatusBadRequest, "binary file is required")\n        return\n    }\n    defer file.Close()\n\n    v, err := s.registry.UploadVersion(id, version, releaseNotes, file)\n    if err != nil {\n        s.writeRegistryError(w, err)\n        return\n    }\n\n    s.auditReq(r, user.Username, "version.upload", "model", id, "version="+v.Version)\n    s.webhooks.Fire("version.uploaded", map[string]interface{}{"model_id": id, "version": v})\n    writeJSON(w, http.StatusCreated, v)\n}\n\nfunc (s *Server) ListVersions(w http.ResponseWriter, r *http.Request) {\n    if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\n        return\n    }\n    id := r.PathValue("id")\n    versions, err := s.registry.ListVersions(id)\n    if err != nil {\n        writeError(w, http.StatusNotFound, "model not found")\n        return\n    }\n    writeJSON(w, http.StatusOK, map[string]interface{}{"versions": versions})\n}\n\nfunc (s *Server) DownloadVersion(w http.ResponseWriter, r *http.Request) {\n    if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\n        return\n    }\n    id := r.PathValue("id")\n    version := r.PathValue("version")\n    v, err := s.registry.GetVersion(id, version)\n    if err != nil {\n        writeError(w, http.StatusNotFound, "version not found")\n        return\n    }\n\n    w.Header().Set("Content-Disposition", fmt.Sprintf("attachment; filename=model-%s.bin", version))\n    w.Header().Set("Content-Type", "application/octet-stream")\n    http.ServeFile(w, r, v.BinaryPath)\n}\n\nfunc (s *Server) DeployVersion(w http.ResponseWriter, r *http.Request) {\n    user, ok := s.requireAuth(w, r, auth.RoleDeployer)\n    if !ok {\n        return\n    }\n    id := r.PathValue("id")\n    version := r.PathValue("version")\n    v, err := s.registry.DeployVersion(id, version)\n    if err != nil {\n        s.writeRegistryError(w, err)\n        return\n    }\n    s.auditReq(r, user.Username, "version.deploy", "model", id, "version="+version)\n    s.webhooks.Fire("version.deployed", map[string]interface{}{"model_id": id, "version": v})\n    writeJSON(w, http.StatusOK, v)\n}\n\nfunc (s *Server) UndeployVersion(w http.ResponseWriter, r *http.Request) {\n    user, ok := s.requireAuth(w, r, auth.RoleDeployer)\n    if !ok {\n        return\n    }\n    id := r.PathValue("id")\n    version := r.PathValue("version")\n    v, err := s.registry.UndeployVersion(id, version)\n    if err != nil {\n        s.writeRegistryError(w, err)\n        return\n    }\n    s.auditReq(r, user.Username, "version.undeploy", "model", id, "version="+version)\n    s.webhooks.Fire("version.undeployed", map[string]interface{}{"model_id": id, "version": v})\n    writeJSON(w, http.StatusOK, v)\n}\n\nfunc (s *Server) Infer(w http.ResponseWriter, r *http.Request) {\n    user, ok := s.requireAuth(w, r, auth.RoleDeployer)\n    if !ok {\n        return\n    }\n    modelName := r.PathValue("model_name")\n\n    body, err := io.ReadAll(r.Body)\n    if err != nil {\n        writeError(w, http.StatusBadRequest, "invalid request body")\n        return\n    }\n\n    result, model, version, latency, err := s.inference.Infer(modelName, body)\n    if err != nil {\n        s.metrics.RecordInference(modelName, latency, true)\n        s.auditReq(r, user.Username, "inference.error", "model", modelName, err.Error())\n        writeError(w, http.StatusInternalServerError, err.Error())\n        return\n    }\n\n    s.metrics.RecordInference(modelName, latency, false)\n    payload := map[string]interface{}{\n        "model":      model.Name,\n        "version":    version.Version,\n        "latency_ms": latency,\n        "timestamp":  time.Now().UTC().Format(time.RFC3339),\n        "result":     result,\n    }\n    s.webhooks.Fire("inference.completed", payload)\n    writeJSON(w, http.StatusOK, payload)\n}\n\nfunc (s *Server) InferBatch(w http.ResponseWriter, r *http.Request) {\n    user, ok := s.requireAuth(w, r, auth.RoleDeployer)\n    if !ok {\n        return\n    }\n    modelName := r.PathValue("model_name")\n\n    var req struct {\n        Inputs []json.RawMessage `json:"inputs"`\n    }\n    if err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n        writeError(w, http.StatusBadRequest, "invalid request body")\n        return\n    }\n    if len(req.Inputs) == 0 {\n        writeError(w, http.StatusBadRequest, "inputs are required")\n        return\n    }\n    if len(req.Inputs) > s.cfg.MaxBatchSize {\n        writeError(w, http.StatusBadRequest, fmt.Sprintf("batch size exceeds max %d", s.cfg.MaxBatchSize))\n        return\n    }\n\n    results := make([]interface{}, 0, len(req.Inputs))\n    errorsList := []string{}\n    var modelNameResolved, versionResolved string\n\n    for _, input := range req.Inputs {\n        result, model, version, latency, err := s.inference.Infer(modelName, input)\n        if err != nil {\n            s.metrics.RecordInference(modelName, latency, true)\n            errorsList = append(errorsList, err.Error())\n            results = append(results, nil)\n        } else {\n            s.metrics.RecordInference(modelName, latency, false)\n            modelNameResolved = model.Name\n            versionResolved = version.Version\n            results = append(results, result)\n        }\n    }\n\n    s.auditReq(r, user.Username, "inference.batch", "model", modelName, fmt.Sprintf("count=%d", len(req.Inputs)))\n    writeJSON(w, http.StatusOK, map[string]interface{}{\n        "model":   modelNameResolved,\n        "version": versionResolved,\n        "results": results,\n        "errors":  errorsList,\n    })\n}\n\nfunc (s *Server) Metrics(w http.ResponseWriter, r *http.Request) {\n    if _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\n        return\n    }\n    writeJSON(w, http.StatusOK, s.metrics.Get())\n}\n\nfunc (s *Server) Audit(w http.ResponseWriter, r *http.Request) {\n    if _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\n        return\n    }\n    writeJSON(w, http.StatusOK, map[string]interface{}{"audit": s.audit.List()})\n}\n\nfunc (s *Server) RegisterWebhook(w http.ResponseWriter, r *http.Request) {\n    user, ok := s.requireAuth(w, r, auth.RoleAdmin)\n    if !ok {\n        return\n    }\n    var req struct {\n        URL    string   `json:"url"`\n        Events []string `json:"events"`\n    }\n    if err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n        writeError(w, http.StatusBadRequest, "invalid request body")\n        return\n    }\n    wh, err := s.webhooks.Register(req.URL, req.Events)\n    if err != nil {\n        writeError(w, http.StatusBadRequest, err.Error())\n        return\n    }\n    s.auditReq(r, user.Username, "webhook.register", "webhook", wh.ID, "url="+wh.URL)\n    writeJSON(w, http.StatusCreated, wh)\n}\n\nfunc (s *Server) ListWebhooks(w http.ResponseWriter, r *http.Request) {\n    if _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\n        return\n    }\n    writeJSON(w, http.StatusOK, map[string]interface{}{"webhooks": s.webhooks.List()})\n}\n\nfunc (s *Server) DeleteWebhook(w http.ResponseWriter, r *http.Request) {\n    user, ok := s.requireAuth(w, r, auth.RoleAdmin)\n    if !ok {\n        return\n    }\n    id := r.PathValue("id")\n    if err := s.webhooks.Delete(id); err != nil {\n        writeError(w, http.StatusNotFound, "webhook not found")\n        return\n    }\n    s.auditReq(r, user.Username, "webhook.delete", "webhook", id, "")\n    writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})\n}\n\nfunc (s *Server) GetConfig(w http.ResponseWriter, r *http.Request) {\n    if _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\n        return\n    }\n    writeJSON(w, http.StatusOK, s.cfg)\n}\n\nfunc (s *Server) UpdateConfig(w http.ResponseWriter, r *http.Request) {\n    user, ok := s.requireAuth(w, r, auth.RoleAdmin)\n    if !ok {\n        return\n    }\n\n    var patch map[string]interface{}\n    if err := json.NewDecoder(r.Body).Decode(&patch); err != nil {\n        writeError(w, http.StatusBadRequest, "invalid request body")\n        return\n    }\n\n    cfg := *s.cfg\n    if v, ok := patch["port"]; ok {\n        if f, ok := v.(float64); ok {\n            cfg.Port = int(f)\n        }\n    }\n    if v, ok := patch["inference_timeout_sec"]; ok {\n        if f, ok := v.(float64); ok {\n            cfg.InferenceTimeoutSec = int(f)\n        }\n    }\n    if v, ok := patch["max_batch_size"]; ok {\n        if f, ok := v.(float64); ok {\n            cfg.MaxBatchSize = int(f)\n        }\n    }\n    if v, ok := patch["log_level"]; ok {\n        if s, ok := v.(string); ok {\n            cfg.LogLevel = s\n        }\n    }\n    if v, ok := patch["webhook_timeout_sec"]; ok {\n        if f, ok := v.(float64); ok {\n            cfg.WebhookTimeoutSec = int(f)\n        }\n    }\n    if v, ok := patch["metrics_retention_hours"]; ok {\n        if f, ok := v.(float64); ok {\n            cfg.MetricsRetentionHours = int(f)\n        }\n    }\n    if v, ok := patch["max_model_size_mb"]; ok {\n        if f, ok := v.(float64); ok {\n            cfg.MaxModelSizeMB = int(f)\n        }\n    }\n\n    if err := config.Save(s.cfg.DataDir+"/config.json", &cfg); err != nil {\n        writeError(w, http.StatusInternalServerError, err.Error())\n        return\n    }\n    *s.cfg = cfg\n    s.auditReq(r, user.Username, "config.update", "config", "config", "")\n    writeJSON(w, http.StatusOK, s.cfg)\n}\n\nfunc (s *Server) requireAuth(w http.ResponseWriter, r *http.Request, requiredRole string) (*store.User, bool) {\n    user, ok := s.authFromRequest(r)\n    if !ok {\n        writeError(w, ht