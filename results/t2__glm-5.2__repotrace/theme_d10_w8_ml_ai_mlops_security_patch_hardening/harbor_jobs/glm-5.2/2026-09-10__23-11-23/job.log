 string) error {\n    err := s.store.WithLock(func(d *store.Data) error {\n        for i, wh := range d.Webhooks {\n            if wh.ID == id {\n                d.Webhooks = append(d.Webhooks[:i], d.Webhooks[i+1:]...)\n                return nil\n            }\n        }\n        return ErrNotFound\n    })\n    return err\n}\n\nfunc (s *Service) Fire(event string, data interface{}) {\n    var targets []string\n    _ = s.store.WithRLock(func(d *store.Data) error {\n        for _, wh := range d.Webhooks {\n            for _, e := range wh.Events {\n                if e == event {\n                    targets = append(targets, wh.URL)\n                    break\n                }\n            }\n        }\n        return nil\n    })\n    if len(targets) == 0 {\n        return\n    }\n\n    payload := map[string]interface{}{\n        "event":     event,\n        "timestamp": time.Now().UTC().Format(time.RFC3339),\n        "data":      data,\n    }\n    body, err := json.Marshal(payload)\n    if err != nil {\n        return\n    }\n\n    var wg sync.WaitGroup\n    for _, target := range targets {\n        wg.Add(1)\n        go func(url string) {\n            defer wg.Done()\n            client := &http.Client{Timeout: s.timeout}\n            resp, err := client.Post(url, "application/json", bytes.NewReader(body))\n            if err == nil {\n                _ = resp.Body.Close()\n            }\n        }(target)\n    }\n    wg.Wait()\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > internal/inference/inference.go <<\'EOF\'\npackage inference\n\nimport (\n    "bytes"\n    "context"\n    "encoding/json"\n    "errors"\n    "fmt"\n    "os/exec"\n    "time"\n\n    "mlgateway/internal/registry"\n    "mlgateway/internal/store"\n)\n\nvar ErrNotDeployed = errors.New("model not deployed")\n\ntype Service struct {\n    registry *registry.Service\n    timeout  time.Duration\n}\n\nfunc New(r *registry.Service, timeoutSec int) *Service {\n    if timeoutSec <= 0 {\n        timeoutSec = 30\n    }\n    return &Service{registry: r, timeout: time.Duration(timeoutSec) * time.Second}\n}\n\nfunc (s *Service) Infer(modelName string, input json.RawMessage) (map[string]interface{}, *store.Model, *store.Version, float64, error) {\n    model, version, err := s.registry.FindDeployedByName(modelName)\n    if err != nil {\n        return nil, nil, nil, 0, ErrNotDeployed\n    }\n\n    start := time.Now()\n    out, err := s.runBinary(version.BinaryPath, input)\n    latency := float64(time.Since(start).Microseconds()) / 1000.0\n    if err != nil {\n        return nil, model, version, latency, err\n    }\n\n    var result map[string]interface{}\n    if err := json.Unmarshal(out, &result); err != nil {\n        return nil, model, version, latency, fmt.Errorf("invalid model output: %w", err)\n    }\n    return result, model, version, latency, nil\n}\n\nfunc (s *Service) runBinary(binaryPath string, input json.RawMessage) ([]byte, error) {\n    ctx, cancel := context.WithTimeout(context.Background(), s.timeout)\n    defer cancel()\n\n    cmd := exec.CommandContext(ctx, binaryPath)\n    cmd.Stdin = bytes.NewReader(input)\n    var stdout, stderr bytes.Buffer\n    cmd.Stdout = &stdout\n    cmd.Stderr = &stderr\n\n    err := cmd.Run()\n    if ctx.Err() == context.DeadlineExceeded {\n        return nil, fmt.Errorf("inference timed out")\n    }\n    if err != nil {\n        return nil, fmt.Errorf("inference failed: %v: %s", err, stderr.String())\n    }\n    return stdout.Bytes(), nil\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
