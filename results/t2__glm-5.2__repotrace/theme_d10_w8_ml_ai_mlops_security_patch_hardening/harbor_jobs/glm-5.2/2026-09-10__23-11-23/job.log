  OutputSchema: m.OutputSchema,\n            Labels:       m.Labels,\n            Lineage:      m.Lineage,\n            Versions:     []*store.Version{},\n        }\n        d.Models[model.ID] = model\n        created = model\n        return nil\n    })\n    if err != nil {\n        return nil, err\n    }\n    return created, nil\n}\n\nfunc (s *Service) List(name, framework, labelKey, labelValue string, deployedFilter *bool) []*store.Model {\n    var result []*store.Model\n    _ = s.store.WithRLock(func(d *store.Data) error {\n        for _, m := range d.Models {\n            if name != "" && !strings.Contains(strings.ToLower(m.Name), strings.ToLower(name)) {\n                continue\n            }\n            if framework != "" && m.Framework != framework {\n                continue\n            }\n            if labelKey != "" {\n                v, ok := m.Labels[labelKey]\n                if !ok || (labelValue != "" && v != labelValue) {\n                    continue\n                }\n            }\n            if deployedFilter != nil {\n                hasDeployed := false\n                for _, v := range m.Versions {\n                    if v.Status == "deployed" {\n                        hasDeployed = true\n                        break\n                    }\n                }\n                if *deployedFilter != hasDeployed {\n                    continue\n                }\n            }\n            result = append(result, m)\n        }\n        return nil\n    })\n    return result\n}\n\nfunc (s *Service) Get(id string) (*store.Model, error) {\n    var model *store.Model\n    err := s.store.WithRLock(func(d *store.Data) error {\n        m, ok := d.Models[id]\n        if !ok {\n            return ErrNotFound\n        }\n        model = m\n        return nil\n    })\n    if err != nil {\n        return nil, err\n    }\n    return model, nil\n}\n\nfunc (s *Service) GetByName(name string) (*store.Model, error) {\n    var model *store.Model\n    err 