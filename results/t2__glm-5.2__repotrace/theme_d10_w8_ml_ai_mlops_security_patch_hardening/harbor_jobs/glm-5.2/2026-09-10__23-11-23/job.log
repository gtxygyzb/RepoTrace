== username {\n                    return ErrUsernameExists\n                }\n            }\n        } else {\n            role = RoleAdmin\n        }\n\n        hash, err := hashPassword(password)\n        if err != nil {\n            return err\n        }\n\n        user := store.User{\n            ID:           store.NewID(),\n            Username:     username,\n            PasswordHash: hash,\n            Role:         role,\n            APIKey:       store.NewID(),\n            CreatedAt:    time.Now().UTC(),\n        }\n        d.Users = append(d.Users, user)\n        created = &d.Users[len(d.Users)-1]\n        return nil\n    })\n    if err != nil {\n        return nil, err\n    }\n    return created, nil\n}\n\nfunc (s *Service) Login(username, password string) (string, string, error) {\n    var apiKey, role string\n    err := s.store.WithRLock(func(d *store.Data) error {\n        for _, u := range d.Users {\n            if u.Username == username && verifyPassword(password, u.PasswordHash) {\n                apiKey = u.APIKey\n                role = u.Role\n                return nil\n            }\n        }\n        return ErrInvalidCredentials\n    })\n    if err != nil {\n        return "", "", err\n    }\n    return apiKey, role, nil\n}\n\nfunc (s *Service) Authenticate(token string) (*store.User, bool) {\n    if token == "" {\n        return nil, false\n    }\n    var found *store.User\n    _ = s.store.WithRLock(func(d *store.Data) error {\n        for i := range d.Users {\n            if d.Users[i].APIKey == token {\n                found = &d.Users[i]\n                return nil\n            }\n        }\n        return nil\n    })\n    return found, found != nil\n}\n\nfunc CanAccess(role string, required string) bool {\n    switch required {\n    case RoleAdmin:\n        return role == RoleAdmin\n    case RoleDeployer:\n        return role == RoleAdmin || role == RoleDeployer\n    case RoleViewer:\n        return role == RoleAdmin || role == RoleD