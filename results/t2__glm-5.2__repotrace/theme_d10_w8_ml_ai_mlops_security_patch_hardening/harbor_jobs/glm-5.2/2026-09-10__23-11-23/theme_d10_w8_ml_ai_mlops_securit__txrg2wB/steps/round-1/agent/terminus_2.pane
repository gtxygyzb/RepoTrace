    40	
    41	func (s *Server) bodyLimit(next http.Handler) http.Handler {
    42		const defaultMaxBodyBytes int64 = 10 * 1024 * 1024
    43	
    44		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
    45			if r.Body != nil {
    46				limit := defaultMaxBodyBytes
    47				if r.Method == http.MethodPost && strings.HasPrefix(r.URL.Path, "/api/v1/models/") && strings.HasSuffix(r.URL.Path, "/versions") {
    48					limit = int64(s.cfg.MaxModelSizeMB) * 1024 * 1024
    49				}
    50				r.Body = http.MaxBytesReader(w, r.Body, limit)
    51			}
    52			next.ServeHTTP(w, r)
    53		})
    54	}
    55	
    56	func (s *Server) logging(next http.Handler) http.Handler {
    57		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
    58			next.ServeHTTP(w, r)
    59		})
    60	}
    61	
    62	func (s *Server) securityHeaders(next http.Handler) http.Handler {
    63		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
    64			w.Header().Set("X-Content-Type-Options", "nosniff")
    65			w.Header().Set("X-Frame-Options", "DENY")
    66			w.Header().Set("Strict-Transport-Security", "max-age=63072000; includeSubDomains")
    67			if strings.HasPrefix(r.URL.Path, "/api/v1/auth/") || strings.HasPrefix(r.URL.Path, "/api/v1/admin/") {
    68				w.Header().Set("Cache-Control", "no-store")
    69			}
    70			next.ServeHTTP(w, r)
    71		})
    72	}
