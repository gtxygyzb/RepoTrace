   340	func (s *Server) Infer(w http.ResponseWriter, r *http.Request) {
   341		user, ok := s.requireAuth(w, r, auth.RoleDeployer)
   342		if !ok {
   343			return
   344		}
   345		modelName := r.PathValue("model_name")
   346	
   347		body, err := io.ReadAll(r.Body)
   348		if err != nil {
   349			writeError(w, http.StatusBadRequest, "invalid request body")
   350			return
   351		}
   352	
   353		result, model, version, latency, err := s.inference.Infer(modelName, body)
   354		if err != nil {
   355			s.metrics.RecordInference(modelName, latency, true)
   356			s.auditReq(r, user.Username, "inference.error", "model", modelName, err.Error())
   357			writeError(w, http.StatusInternalServerError, err.Error())
   358			return
   359		}
   360	
   361		s.metrics.RecordInference(modelName, latency, false)
   362		payload := map[string]interface{}{
   363			"model":      model.Name,
   364			"version":    version.Version,
   365			"latency_ms": latency,
   366			"timestamp":  time.Now().UTC().Format(time.RFC3339),
   367			"result":     result,
   368		}
   369		s.webhooks.Fire("inference.completed", payload)
   370		writeJSON(w, http.StatusOK, payload)
   371	}
   372	
   373	func (s *Server) InferBatch(w http.ResponseWriter, r *http.Request) {
   374		user, ok := s.requireAuth(w, r, auth.RoleDeployer)
   375		if !ok {
   376			return
   377		}
   378		modelName := r.PathValue("model_name")
   379	
   380		var req struct {
[?2004hroot@n30009:/app# nl -ba internal/server/handlers.go | sed -n '381,620p'
[?2004l   381			Inputs []json.RawMessage `json:"inputs"`
   382		}
   383		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   384			writeError(w, http.StatusBadRequest, "invalid request body")
   385			return
   386		}
   387		if len(req.Inputs) == 0 {
   388			writeError(w, http.StatusBadRequest, "inputs are required")
   389			return
   390		}
   391		if len(req.Inputs) > s.cfg.MaxBatchSize {
   392			writeError(w, http.StatusBadRequest, fmt.Sprintf("batch size exceeds max %d", s.cfg.MaxBatchSize))
   393			return
   394		}
   395	
   396		results := make([]interface{}, 0, len(req.Inputs))
   397		errorsList := []string{}
   398		var modelNameResolved, versionResolved string
   399	
   400		for _, input := range req.Inputs {
   401			result, model, version, latency, err := s.inference.Infer(modelName, input)
   402			if err != nil {
   403				s.metrics.RecordInference(modelName, latency, true)
   404				errorsList = append(errorsList, err.Error())
   405				results = append(results, nil)
   406			} else {
   407				s.metrics.RecordInference(modelName, latency, false)
   408				modelNameResolved = model.Name
   409				versionResolved = version.Version
   410				results = append(results, result)
   411			}
   412		}
   413	
   414		s.auditReq(r, user.Username, "inference.batch", "model", modelName, fmt.Sprintf("count=%d", len(req.Inputs)))
   415		writeJSON(w, http.StatusOK, map[string]interface{}{
   416			"model":   modelNameResolved,
   417			"version": versionResolved,
   418			"results": results,
   419			"errors":  errorsList,
   420		})
   421	}
