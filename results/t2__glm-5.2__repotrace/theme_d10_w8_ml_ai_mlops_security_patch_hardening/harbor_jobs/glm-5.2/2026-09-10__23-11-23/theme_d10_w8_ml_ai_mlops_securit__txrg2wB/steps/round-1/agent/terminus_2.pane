[?2004l   220	func (s *Server) DeleteModel(w http.ResponseWriter, r *http.Request) {
   221		user, ok := s.requireAuth(w, r, auth.RoleDeployer)
   222		if !ok {
   223			return
   224		}
   225		id := r.PathValue("id")
   226		model, err := s.registry.Get(id)
   227		if err != nil {
   228			writeError(w, http.StatusNotFound, "model not found")
   229			return
   230		}
   231		if err := s.registry.Delete(id); err != nil {
   232			if errors.Is(err, registry.ErrConflict) {
   233				writeError(w, http.StatusConflict, err.Error())
   234			} else {
   235				writeError(w, http.StatusInternalServerError, err.Error())
   236			}
   237			return
   238		}
   239		s.auditReq(r, user.Username, "model.delete", "model", id, "name="+model.Name)
   240		s.webhooks.Fire("model.deleted", model)
   241		writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
   242	}
   243	
   244	func (s *Server) UploadVersion(w http.ResponseWriter, r *http.Request) {
   245		user, ok := s.requireAuth(w, r, auth.RoleDeployer)
   246		if !ok {
   247			return
   248		}
   249		id := r.PathValue("id")
   250	
   251		if err := r.ParseMultipartForm(int64(s.cfg.MaxModelSizeMB) * 1024 * 1024); err != nil {
   252			writeError(w, http.StatusBadRequest, "invalid multipart form: "+err.Error())
   253			return
   254		}
   255	
   256		version := r.FormValue("version")
   257		releaseNotes := r.FormValue("release_notes")
   258		file, _, err := r.FormFile("binary")
   259		if err != nil {
   260			writeError(w, http.StatusBadRequest, "binary file is required")
   261			return
   262		}
   263		defer file.Close()
   264	
   265		v, err := s.registry.UploadVersion(id, version, releaseNotes, file)
   266		if err != nil {
   267			s.writeRegistryError(w, err)
   268			return
   269		}
   270	
   271		s.auditReq(r, user.Username, "version.upload", "model", id, "version="+v.Version)
   272		s.webhooks.Fire("version.uploaded", map[string]interface{}{"model_id": id, "version": v})
   273		writeJSON(w, http.StatusCreated, v)
   274	}
   275	
   276	func (s *Server) ListVersions(w http.ResponseWriter, r *http.Request) {
   277		if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
   278			return
   279		}
   280		id := r.PathValue("id")
   281		versions, err := s.registry.ListVersions(id)
   282		if err != nil {
   283			writeError(w, http.StatusNotFound, "model not found")
   284			return
   285		}
   286		writeJSON(w, http.StatusOK, map[string]interface{}{"versions": versions})
   287	}
   288	
   289	func (s *Server) DownloadVersion(w http.ResponseWriter, r *http.Request) {
   290		if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
   291			return
   292		}
   293		id := r.PathValue("id")
   294		version := r.PathValue("version")
   295		v, err := s.registry.GetVersion(id, version)
   296		if err != nil {
   297			writeError(w, http.StatusNotFound, "version not found")
   298			return
   299		}
   300	
   301		w.Header().Set("Content-Disposition", fmt.Sprintf("attachment; filename=model-%s.bin", version))
   302		w.Header().Set("Content-Type", "application/octet-stream")
   303		http.ServeFile(w, r, v.BinaryPath)
   304	}
   305	
   306	func (s *Server) DeployVersion(w http.ResponseWriter, r *http.Request) {
   307		user, ok := s.requireAuth(w, r, auth.RoleDeployer)
   308		if !ok {
   309			return
   310		}
   311		id := r.PathValue("id")
   312		version := r.PathValue("version")
   313		v, err := s.registry.DeployVersion(id, version)
   314		if err != nil {
   315			s.writeRegistryError(w, err)
   316			return
   317		}
   318		s.auditReq(r, user.Username, "version.deploy", "model", id, "version="+version)
   319		s.webhooks.Fire("version.deployed", map[string]interface{}{"model_id": id, "version": v})
   320		writeJSON(w, http.StatusOK, v)
   321	}
   322	
   323	func (s *Server) UndeployVersion(w http.ResponseWriter, r *http.Request) {
   324		user, ok := s.requireAuth(w, r, auth.RoleDeployer)
   325		if !ok {
   326			return
   327		}
   328		id := r.PathValue("id")
   329		version := r.PathValue("version")
   330		v, err := s.registry.UndeployVersion(id, version)
   331		if err != nil {
   332			s.writeRegistryError(w, err)
   333			return
   334		}
   335		s.auditReq(r, user.Username, "version.undeploy", "model", id, "version="+version)
   336		s.webhooks.Fire("version.undeployed", map[string]interface{}{"model_id": id, "version": v})
   337		writeJSON(w, http.StatusOK, v)
   338	}
   339	
   340	func (s *Server) Infer(w http.ResponseWriter, r *http.Request) {
   341		user, ok := s.requireAuth(w, r, auth.RoleDeployer)
   342		if !ok {
   343			return
   344		}
   345		modelName := r.PathValue("model_name")
   346	
   347		body, err := io.ReadAll(r.Body)
   348		if err != nil {
   349			writeError(w, http.StatusBadRequest, "invalid request body")
   350			return
   351		}
   352	
   353		result, model, version, latency, err := s.inference.Infer(modelName, body)
   354		if err != nil {
   355			s.metrics.RecordInference(modelName, latency, true)
   356			s.auditReq(r, user.Username, "inference.error", "model", modelName, err.Error())
   357			writeError(w, http.StatusInternalServerError, err.Error())
   358			return
   359		}
   360	
   361		s.metrics.RecordInference(modelName, latency, false)
   362		payload := map[string]interface{}{
   363			"model":      model.Name,
   364			"version":    version.Version,
   365			"latency_ms": latency,
   366			"timestamp":  time.Now().UTC().Format(time.RFC3339),
   367			"result":     result,
   368		}
   369		s.webhooks.Fire("inference.completed", payload)
   370		writeJSON(w, http.StatusOK, payload)
