[?2004lpackage metrics

import (
	"mlgateway/internal/store"
	"time"
)

type Service struct {
	store     *store.Store
	startTime time.Time
}

func New(s *store.Store, startTime time.Time) *Service {
	return &Service{store: s, startTime: startTime}
}

func (s *Service) RecordInference(modelName string, latencyMs float64, isError bool) {
	_ = s.store.WithLock(func(d *store.Data) error {
		d.Metrics.TotalInferences++
		if isError {
			d.Metrics.TotalErrors++
		} else {
			d.Metrics.LatencySumMs += latencyMs
		}
		d.Metrics.InferencesPerModel[modelName]++
		return nil
	})
}

func (s *Service) Get() map[string]interface{} {
	var totalModels, deployedModels int
	var totalInferences, totalErrors int64
	var latencySum float64
	var perModel map[string]int64

	_ = s.store.WithRLock(func(d *store.Data) error {
		totalModels = len(d.Models)
		for _, m := range d.Models {
			for _, v := range m.Versions {
				if v.Status == "deployed" {
[?2004hroot@n30009:/app# cat > internal/webhooks/webhooks.go <<'EOF'
[?2004l             d.Webhooks = append(d.Webhooks[:i], d.Webhooks[i+1:]...)
                return nil
            }
        }
        return ErrNotFound
    })
    return err
}

func (s *Service) Fire(event string, data interface{}) {
    var targets []string
    _ = s.store.WithRLock(func(d *store.Data) error {
        for _, wh := range d.Webhooks {
            for _, e := range wh.Events {
                if e == event {
                    targets = append(targets, wh.URL)
                    break
                }
            }
        }
        return nil
    })
    if len(targets) == 0 {
        return
    }

    payload := map[string]interface{}{
        "event":     event,
        "timestamp": time.Now().UTC().Format(time.RFC3339),
        "data":      data,
    }
    body, err := json.Marshal(payload)
    if err != nil {
        return
    }

    var wg sync.WaitGroup
    for _, target := range targets {
        wg.Add(1)
        go func(url string) {
            defer wg.Done()
            client := &http.Client{Timeout: s.timeout}
            resp, err := client.Post(url, "application/json", bytes.NewReader(body))
            if err == nil {
                _ = resp.Body.Close()
            }
        }(target)
    }
    wg.Wait()
}
