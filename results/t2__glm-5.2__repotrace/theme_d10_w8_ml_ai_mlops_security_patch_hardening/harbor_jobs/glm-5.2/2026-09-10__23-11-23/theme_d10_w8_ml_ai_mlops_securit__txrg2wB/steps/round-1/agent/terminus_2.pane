    29		mux.HandleFunc("GET /api/v1/admin/metrics", s.Metrics)
    30		mux.HandleFunc("GET /api/v1/admin/audit", s.Audit)
    31		mux.HandleFunc("GET /api/v1/admin/config", s.GetConfig)
    32		mux.HandleFunc("POST /api/v1/admin/config", s.UpdateConfig)
    33	
