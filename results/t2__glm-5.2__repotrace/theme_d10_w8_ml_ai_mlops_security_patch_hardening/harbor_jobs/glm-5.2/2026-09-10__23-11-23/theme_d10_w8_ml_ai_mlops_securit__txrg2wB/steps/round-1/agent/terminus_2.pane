   103	func (s *Service) Register(url string, events []string) (*store.Webhook, error) {
   104		if url == "" {
   105			return nil, errors.New("url is required")
   106		}
   107		if err := validateWebhookURL(url); err != nil {
   108			return nil, err
   109		}
   110		filtered := []string{}
   111		for _, e := range events {
   112			if validEvent(e) {
   113				filtered = append(filtered, e)
   114			}
   115		}
   116		if len(filtered) == 0 {
   117			return nil, errors.New("at least one valid event is required")
   118		}
   119	
   120		var created *store.Webhook
   121		err := s.store.WithLock(func(d *store.Data) error {
   122			wh := store.Webhook{
   123				ID:        store.NewID(),
   124				URL:       url,
   125				Events:    filtered,
   126				CreatedAt: time.Now().UTC(),
   127			}
   128			d.Webhooks = append(d.Webhooks, wh)
   129			created = &d.Webhooks[len(d.Webhooks)-1]
   130			return nil
   131		})
   132		if err != nil {
   133			return nil, err
   134		}
   135		return created, nil
   136	}
