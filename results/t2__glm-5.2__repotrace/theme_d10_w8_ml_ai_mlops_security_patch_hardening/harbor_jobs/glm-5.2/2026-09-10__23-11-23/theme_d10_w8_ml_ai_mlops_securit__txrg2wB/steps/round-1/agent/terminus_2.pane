func (s *Server) RegisterModel(w http.ResponseWriter, r *http.Request) {
	user, ok := s.authFromRequest(r)
	if !ok {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}
	if !auth.CanAccess(user.Role, auth.RoleDeployer) {
		writeError(w, http.StatusForbidden, "insufficient role")
		return
	}

	var m store.Model
	if err := json.NewDecoder(r.Body).Decode(&m); err != nil {
		writeBodyReadError(w, err)
		return
	}

	created, err := s.registry.Register(&m)
	if err != nil {
		s.writeRegistryError(w, err)
		return
	}

	s.auditReq(r, user.Username, "model.register", "model", created.ID, "name="+created.Name)
	s.webhooks.Fire("model.created", created)
	writeJSON(w, http.StatusCreated, created)
}

func (s *Server) writeRegistryError(w http.ResponseWriter, err error) {
	switch {
	case errors.Is(err, registry.ErrValidation):
		writeError(w, http.StatusBadRequest, err.Error())
	case errors.Is(err, registry.ErrConflict):
		writeError(w, http.StatusConflict, err.Error())
	case errors.Is(err, registry.ErrNotFound):
		writeError(w, http.StatusNotFound, err.Error())
	case errors.Is(err, registry.ErrTooLarge):
		writeError(w, http.StatusRequestEntityTooLarge, err.Error())
	default:
		writeError(w, http.StatusInternalServerError, err.Error())
	}
}

func (s *Server) ListModels(w http.ResponseWriter, r *http.Request) {
	if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
		return
	}

	q := r.URL.Query()
	var deployedFilter *bool
	if d := q.Get("deployed"); d != "" {
		b, err := strconv.ParseBool(d)
		if err == nil {
			deployedFilter = &b
		}
	}

	models := s.registry.List(q.Get("name"), q.Get("framework"), q.Get("label_key"), q.Get("label_value"), deployedFilter)
	writeJSON(w, http.StatusOK, map[string]interface{}{"models": models})
}

func (s *Server) GetModel(w http.ResponseWriter, r *http.Request) {
	if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
		return
	}
	id := r.PathValue("id")
