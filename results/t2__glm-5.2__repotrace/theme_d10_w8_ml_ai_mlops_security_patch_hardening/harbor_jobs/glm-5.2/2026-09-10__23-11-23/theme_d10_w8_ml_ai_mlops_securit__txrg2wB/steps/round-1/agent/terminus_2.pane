   172			return
   173		}
   174	
   175		var m store.Model
   176		if err := json.NewDecoder(r.Body).Decode(&m); err != nil {
   177			writeBodyReadError(w, err)
   178			return
   179		}
   180	
   181		created, err := s.registry.Register(&m)
   182		if err != nil {
   183			s.writeRegistryError(w, err)
   184			return
   185		}
   186	
   187		s.auditReq(r, user.Username, "model.register", "model", created.ID, "name="+created.Name)
   188		s.webhooks.Fire("model.created", created)
   189		writeJSON(w, http.StatusCreated, created)
   190	}
