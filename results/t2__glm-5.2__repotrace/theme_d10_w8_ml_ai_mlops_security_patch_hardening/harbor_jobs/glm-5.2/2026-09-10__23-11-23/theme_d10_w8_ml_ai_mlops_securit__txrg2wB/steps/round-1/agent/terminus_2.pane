[?2004lpackage registry

import (
	"fmt"
	"strings"
)

func ValidateModelName(name string) error {
	if name == "" {
		return fmt.Errorf("%w: name is required", ErrValidation)
	}
	if len(name) > 128 {
		return fmt.Errorf("%w: name must be 128 characters or fewer", ErrValidation)
	}
	if strings.ContainsAny(name, "/\\") {
		return fmt.Errorf("%w: name must not contain path separators", ErrValidation)
	}
	if strings.ContainsAny(name, ";|&$`") {
		return fmt.Errorf("%w: name must not contain shell metacharacters", ErrValidation)
	}
	if strings.Contains(name, "..") {
		return fmt.Errorf("%w: name must not contain '..' sequences", ErrValidation)
	}
	return nil
}
