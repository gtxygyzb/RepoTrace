    53	func validateWebhookURL(rawURL string) error {
    54		parsed, err := url.Parse(rawURL)
    55		if err != nil {
    56			return errors.New("invalid webhook url: " + err.Error())
    57		}
    58		if parsed.Scheme != "http" && parsed.Scheme != "https" {
    59			return errors.New("webhook url scheme must be http or https")
    60		}
    61		host := parsed.Hostname()
    62		if host == "" {
    63			return errors.New("webhook url host is required")
    64		}
    65		if strings.EqualFold(host, "localhost") {
    66			return errors.New("webhook url host must not be localhost")
    67		}
    68	
    69		if ip, err := netip.ParseAddr(host); err == nil {
