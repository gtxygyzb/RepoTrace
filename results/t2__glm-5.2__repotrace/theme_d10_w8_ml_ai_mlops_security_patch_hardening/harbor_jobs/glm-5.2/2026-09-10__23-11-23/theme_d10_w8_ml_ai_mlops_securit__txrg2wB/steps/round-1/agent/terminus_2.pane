   207	func (s *Server) GetModel(w http.ResponseWriter, r *http.Request) {
   208		if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
   209			return
   210		}
   211		id := r.PathValue("id")
   212		model, err := s.registry.Get(id)
   213		if err != nil {
   214			writeError(w, http.StatusNotFound, "model not found")
   215			return
   216		}
   217		writeJSON(w, http.StatusOK, model)
