[?2004lpackage webhooks

import (
	"bytes"
	"encoding/json"
	"errors"
	"net/http"
	"sync"
	"time"

	"mlgateway/internal/store"
)

var ErrNotFound = errors.New("not found")

type Service struct {
	store   *store.Store
	timeout time.Duration
}

func New(s *store.Store, timeoutSec int) *Service {
	if timeoutSec <= 0 {
		timeoutSec = 5
	}
	return &Service{store: s, timeout: time.Duration(timeoutSec) * time.Second}
}

func validEvent(event string) bool {
	switch event {
	case "model.created", "model.deleted", "version.uploaded", "version.deployed", "version.undeployed", "inference.completed":
		return true
	default:
		return false
	}
}

func (s *Service) Register(url string, events []string) (*store.Webhook, error) {
	if url == "" {
		return nil, errors.New("url is required")
	}
	filtered := []string{}
	for _, e := range events {
		if validEvent(e) {
			filtered = append(filtered, e)
		}
	}
	if len(filtered) == 0 {
		return nil, errors.New("at least one valid event is required")
	}

	var created *store.Webhook
	err := s.store.WithLock(func(d *store.Data) error {
		wh := store.Webhook{
			ID:        store.NewID(),
			URL:       url,
			Events:    filtered,
			CreatedAt: time.Now().UTC(),
		}
		d.Webhooks = append(d.Webhooks, wh)
		created = &d.Webhooks[len(d.Webhooks)-1]
		return nil
	})
	if err != nil {
		return nil, err
	}
	return created, nil
}

func (s *Service) List() []store.Webhook {
	var result []store.Webhook
	_ = s.store.WithRLock(func(d *store.Data) error {
		result = make([]store.Webhook, len(d.Webhooks))
		copy(result, d.Webhooks)
		return nil
	})
	return result
}

func (s *Service) Delete(id string) error {
	err := s.store.WithLock(func(d *store.Data) error {
		for i, wh := range d.Webhooks {
			if wh.ID == id {
				d.Webhooks = append(d.Webhooks[:i], d.Webhooks[i+1:]...)
				return nil
			}
		}
		return ErrNotFound
	})
	return err
}

func (s *Service) Fire(event string, data interface{}) {
	var targets []string
	_ = s.store.WithRLock(func(d *store.Data) error {
		for _, wh := range d.Webhooks {
			for _, e := range wh.Events {
				if e == event {
					targets = append(targets, wh.URL)
					break
				}
			}
		}
		return nil
	})
	if len(targets) == 0 {
		return
	}

	payload := map[string]interface{}{
		"event":     event,
		"timestamp": time.Now().UTC().Format(time.RFC3339),
		"data":      data,
	}
	body, err := json.Marshal(payload)
	if err != nil {
		return
	}

	var wg sync.WaitGroup
	for _, target := range targets {
		wg.Add(1)
		go func(url string) {
			defer wg.Done()
			client := &http.Client{Timeout: s.timeout}
			resp, err := client.Post(url, "application/json", bytes.NewReader(body))
			if err == nil {
				_ = resp.Body.Close()
			}
		}(target)
	}
	wg.Wait()
}
