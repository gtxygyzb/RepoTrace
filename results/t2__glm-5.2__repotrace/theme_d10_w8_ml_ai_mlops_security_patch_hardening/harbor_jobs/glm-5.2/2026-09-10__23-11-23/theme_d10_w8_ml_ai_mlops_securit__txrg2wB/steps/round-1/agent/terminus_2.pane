    77	func (s *Server) RegisterUser(w http.ResponseWriter, r *http.Request) {
    78		var req struct {
    79			Username string `json:"username"`
    80			Password string `json:"password"`
    81			Role     string `json:"role"`
    82		}
    83		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
    84			writeError(w, http.StatusBadRequest, "invalid request body")
    85			return
    86		}
    87	
    88		callerRole := ""
    89		if user, ok := s.authFromRequest(r); ok {
    90			callerRole = user.Role
    91		}
    92	
    93		user, err := s.auth.Register(req.Username, req.Password, req.Role, callerRole)
    94		if err != nil {
    95			switch {
    96			case errors.Is(err, auth.ErrForbidden):
    97				writeError(w, http.StatusForbidden, err.Error())
    98			case errors.Is(err, auth.ErrInvalidRole), strings.Contains(err.Error(), "required"):
    99				writeError(w, http.StatusBadRequest, err.Error())
   100			case errors.Is(err, auth.ErrUsernameExists):
   101				writeError(w, http.StatusConflict, err.Error())
   102			default:
   103				writeError(w, http.StatusBadRequest, err.Error())
   104			}
   105			return
   106		}
   107	
   108		s.auditReq(r, user.Username, "user.register", "user", user.ID, "role="+user.Role)
   109		writeJSON(w, http.StatusCreated, map[string]interface{}{
   110			"id":       user.ID,
   111			"username": user.Username,
   112			"role":     user.Role,
   113			"api_key":  user.APIKey,
   114		})
   115	}
