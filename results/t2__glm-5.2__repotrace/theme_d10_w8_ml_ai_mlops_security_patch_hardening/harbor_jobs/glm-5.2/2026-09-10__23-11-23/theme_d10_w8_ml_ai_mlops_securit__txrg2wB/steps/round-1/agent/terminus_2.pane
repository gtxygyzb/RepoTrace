	}
	return nil
}

func (s *Service) UploadVersion(id, version, releaseNotes string, reader io.Reader) (*store.Version, error) {
	if err := ValidateSemver(version); err != nil {
		return nil, err
	}

	dir := filepath.Join(s.modelStorageDir, id, version)
	if err := os.MkdirAll(dir, 0755); err != nil {
		return nil, err
	}
	binaryPath := filepath.Join(dir, "model.bin")
	tmpPath := binaryPath + ".tmp"
	f, err := os.Create(tmpPath)
	if err != nil {
		return nil, err
	}

	limited := io.LimitReader(reader, s.maxModelSize+1)
	n, err := io.Copy(f, limited)
	f.Close()
	if err != nil {
		_ = os.Remove(tmpPath)
		return nil, err
	}
	if n > s.maxModelSize {
		_ = os.Remove(tmpPath)
		return nil, ErrTooLarge
	}
	if err := os.Chmod(tmpPath, 0755); err != nil {
		_ = os.Remove(tmpPath)
		return nil, err
	}
	if err := os.Rename(tmpPath, binaryPath); err != nil {
		_ = os.Remove(tmpPath)
		return nil, err
	}

	var versionCreated *store.Version
	err = s.store.WithLock(func(d *store.Data) error {
		m, ok := d.Models[id]
		if !ok {
			return ErrNotFound
		}
		for _, v := range m.Versions {
			if v.Version == version {
				return fmt.Errorf("%w: version already exists", ErrConflict)
			}
		}
		v := &store.Version{
			Version:      version,
			ReleaseNotes: releaseNotes,
			BinaryPath:   binaryPath,
			Status:       "undeployed",
			CreatedAt:    time.Now().UTC(),
			Size:         n,
		}
		m.Versions = append(m.Versions, v)
		versionCreated = v
		return nil
	})
	if err != nil {
		_ = os.Remove(binaryPath)
		return nil, err
	}
	return versionCreated, nil
}

func (s *Service) ListVersions(id string) ([]*store.Version, error) {
	var versions []*store.Version
	err := s.store.WithRLock(func(d *store.Data) error {
		m, ok := d.Models[id]
		if !ok {
			return ErrNotFound
		}
		versions = m.Versions
		return nil
	})
	if err != nil {
		return nil, err
	}
	return versions, nil
}

