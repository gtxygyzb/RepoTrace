func (s *Server) authFromRequest(r *http.Request) (*store.User, bool) {
	authHeader := r.Header.Get("Authorization")
	if !strings.HasPrefix(authHeader, "Bearer ") {
		return nil, false
	}
	token := strings.TrimPrefix(authHeader, "Bearer ")
	return s.auth.Authenticate(token)
}

func (s *Server) RegisterModel(w http.ResponseWriter, r *http.Request) {
	user, ok := s.authFromRequest(r)
	if !ok {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}
	if !auth.CanAccess(user.Role, auth.RoleDeployer) {
		writeError(w, http.StatusForbidden, "insufficient role")
		return
	}

	var m store.Model
	if err := json.NewDecoder(r.Body).Decode(&m); err != nil {
		writeBodyReadError(w, err)
		return
	}

	created, err := s.registry.Register(&m)
	if err != nil {
		s.writeRegistryError(w, err)
		return
	}

	s.auditReq(r, user.Username, "model.register", "model", created.ID, "name="+created.Name)
	s.webhooks.Fire("model.created", created)
	writeJSON(w, http.StatusCreated, created)
}

func (s *Server) writeRegistryError(w http.ResponseWriter, err error) {
	switch {
	case errors.Is(err, registry.ErrValidation):
		writeError(w, http.StatusBadRequest, err.Error())
	case errors.Is(err, registry.ErrConflict):
		writeError(w, http.StatusConflict, err.Error())
	case errors.Is(err, registry.ErrNotFound):
		writeError(w, http.StatusNotFound, err.Error())
	case errors.Is(err, registry.ErrTooLarge):
		writeError(w, http.StatusRequestEntityTooLarge, err.Error())
	default:
		writeError(w, http.StatusInternalServerError, err.Error())
	}
}

func (s *Server) ListModels(w http.ResponseWriter, r *http.Request) {
	if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
		return
	}

	q := r.URL.Query()
	var deployedFilter *bool
	if d := q.Get("deployed"); d != "" {
		b, err := strconv.ParseBool(d)
		if err == nil {
			deployedFilter = &b
		}
	}

	models := s.registry.List(q.Get("name"), q.Get("framework"), q.Get("label_key"), q.Get("label_value"), deployedFilter)
	writeJSON(w, http.StatusOK, map[string]interface{}{"models": models})
}

func (s *Server) GetModel(w http.ResponseWriter, r *http.Request) {
	if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
		return
	}
	id := r.PathValue("id")
	model, err := s.registry.Get(id)
	if err != nil {
		writeError(w, http.StatusNotFound, "model not found")
		return
	}
	writeJSON(w, http.StatusOK, model)
}

func (s *Server) DeleteModel(w http.ResponseWriter, r *http.Request) {
	user, ok := s.requireAuth(w, r, auth.RoleDeployer)
	if !ok {
[?2004hroot@n30009:/app# sed -n '1,180p' internal/registry/registry.go
[?2004lpackage registry

import (
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"regexp"
	"strings"
	"time"

	"mlgateway/internal/store"
)

var (
	ErrNotFound   = errors.New("not found")
	ErrConflict   = errors.New("conflict")
	ErrValidation = errors.New("validation error")
	ErrTooLarge   = errors.New("model binary too large")
)

var semverRe = regexp.MustCompile(`^[0-9]+\.[0-9]+\.[0-9]+$`)

type Service struct {
	store           *store.Store
	modelStorageDir string
	maxModelSize    int64
}

func New(s *store.Store, modelStorageDir string, maxModelSizeMB int) *Service {
	return &Service{
		store:           s,
		modelStorageDir: modelStorageDir,
		maxModelSize:    int64(maxModelSizeMB) * 1024 * 1024,
	}
}

func ValidateFramework(framework string) error {
	switch framework {
	case "tensorflow", "pytorch", "onnx", "custom":
		return nil
	default:
		return fmt.Errorf("%w: invalid framework %q", ErrValidation, framework)
	}
}

func ValidateSemver(version string) error {
	if !semverRe.MatchString(version) {
		return fmt.Errorf("%w: invalid semantic version %q", ErrValidation, version)
	}
	return nil
}

func ValidateSchema(schema json.RawMessage) error {
	if len(schema) == 0 || string(schema) == "null" {
		return fmt.Errorf("%w: schema is required", ErrValidation)
	}
	var obj map[string]interface{}
	if err := json.Unmarshal(schema, &obj); err != nil {
		return fmt.Errorf("%w: schema must be a JSON object", ErrValidation)
	}
	if obj == nil {
		return fmt.Errorf("%w: schema must be a JSON object", ErrValidation)
	}
	if t, ok := obj["type"]; ok {
		if _, ok := t.(string); !ok {
			return fmt.Errorf("%w: schema type must be a string", ErrValidation)
		}
	}
	if p, ok := obj["properties"]; ok {
		if _, ok := p.(map[string]interface{}); !ok {
			return fmt.Errorf("%w: schema properties must be an object", ErrValidation)
		}
	}
	if r, ok := obj["required"]; ok {
		if _, ok := r.([]interface{}); !ok {
			return fmt.Errorf("%w: schema required must be an array", ErrValidation)
		}
	}
	if i, ok := obj["items"]; ok {
		if _, ok := i.(map[string]interface{}); !ok {
			return fmt.Errorf("%w: schema items must be an object", ErrValidation)
		}
	}
	return nil
}

func (s *Service) Register(m *store.Model) (*store.Model, error) {
	m.Name = strings.TrimSpace(m.Name)
	m.Framework = strings.TrimSpace(m.Framework)
	m.Description = strings.TrimSpace(m.Description)
	m.Author = strings.TrimSpace(m.Author)

	if m.Name == "" {
		return nil, fmt.Errorf("%w: name is required", ErrValidation)
	}
	if err := ValidateFramework(m.Framework); err != nil {
		return nil, err
	}
	if err := ValidateSchema(m.InputSchema); err != nil {
		return nil, fmt.Errorf("input_schema: %w", err)
	}
	if err := ValidateSchema(m.OutputSchema); err != nil {
		return nil, fmt.Errorf("output_schema: %w", err)
	}
	if m.Labels == nil {
		m.Labels = map[string]string{}
	}

	var created *store.Model
	err := s.store.WithLock(func(d *store.Data) error {
		for _, existing := range d.Models {
			if existing.Name == m.Name {
				return fmt.Errorf("%w: model name already exists", ErrConflict)
			}
		}

		model := &store.Model{
			ID:           store.NewID(),
			Name:         m.Name,
			Framework:    m.Framework,
			Description:  m.Description,
			Author:       m.Author,
			CreatedAt:    time.Now().UTC(),
			InputSchema:  m.InputSchema,
			OutputSchema: m.OutputSchema,
			Labels:       m.Labels,
			Lineage:      m.Lineage,
			Versions:     []*store.Version{},
		}
		d.Models[model.ID] = model
		created = model
		return nil
	})
	if err != nil {
		return nil, err
	}
	return created, nil
}

func (s *Service) List(name, framework, labelKey, labelValue string, deployedFilter *bool) []*store.Model {
	var result []*store.Model
	_ = s.store.WithRLock(func(d *store.Data) error {
		for _, m := range d.Models {
			if name != "" && !strings.Contains(strings.ToLower(m.Name), strings.ToLower(name)) {
				continue
			}
			if framework != "" && m.Framework != framework {
				continue
			}
			if labelKey != "" {
				v, ok := m.Labels[labelKey]
				if !ok || (labelValue != "" && v != labelValue) {
					continue
				}
			}
			if deployedFilter != nil {
				hasDeployed := false
				for _, v := range m.Versions {
					if v.Status == "deployed" {
						hasDeployed = true
						break
					}
				}
				if *deployedFilter != hasDeployed {
					continue
				}
			}
			result = append(result, m)
		}
		return nil
	})
	return result
}

