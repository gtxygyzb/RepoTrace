   164	func (s *Server) RegisterModel(w http.ResponseWriter, r *http.Request) {
   165		user, ok := s.authFromRequest(r)
   166		if !ok {
   167			writeError(w, http.StatusUnauthorized, "unauthorized")
   168			return
   169		}
   170		if !auth.CanAccess(user.Role, auth.RoleDeployer) {
