[?2004lpackage audit

import (
	"mlgateway/internal/store"
	"time"
	"unicode/utf8"
)

type Service struct {
	store *store.Store
}

func New(s *store.Store) *Service {
	return &Service{store: s}
}

func (s *Service) Add(user, action, resourceType, resourceID, details, sourceIP string) {
	_ = s.store.WithLock(func(d *store.Data) error {
		d.Audit = append(d.Audit, store.AuditEntry{
			Timestamp:    time.Now().UTC(),
			User:         user,
			Action:       action,
			ResourceType: resourceType,
			ResourceID:   resourceID,
			Details:      sanitizeDetail(details),
			SourceIP:     sourceIP,
		})
		if len(d.Audit) > 1000 {
			d.Audit = d.Audit[len(d.Audit)-1000:]
		}
		return nil
	})
}

func sanitizeDetail(details string) string {
	cleaned := make([]byte, 0, len(details))
	for i := 0; i < len(details); i++ {
		if details[i] < 0x20 {
			continue
		}
		cleaned = append(cleaned, details[i])
	}

	const maxRunes = 256
	var n int
	for i := 0; i < len(cleaned); {
		_, size := utf8.DecodeRune(cleaned[i:])
		if size == 0 {
			break
		}
		n++
		if n == maxRunes && i+size < len(cleaned) {
			return string(cleaned[:i+size]) + "...[truncated]"
		}
		i += size
	}
	return string(cleaned)
}

func (s *Service) List() []store.AuditEntry {
	var entries []store.AuditEntry
	_ = s.store.WithRLock(func(d *store.Data) error {
		entries = make([]store.AuditEntry, len(d.Audit))
		copy(entries, d.Audit)
		return nil
	})
	return entries
}
[?2004hroot@n30009:/app# sed -n '505,565p' internal/server/handlers.go
[?2004lfunc (s *Server) UpdateConfig(w http.ResponseWriter, r *http.Request) {
	user, ok := s.requireAuth(w, r, auth.RoleAdmin)
	if !ok {
		return
	}

	body, err := io.ReadAll(r.Body)
	if err != nil {
		writeBodyReadError(w, err)
		return
	}

	var patch map[string]interface{}
	if err := json.Unmarshal(body, &patch); err != nil {
		writeBodyReadError(w, err)
		return
	}

	cfg := *s.cfg
	if v, ok := patch["port"]; ok {
		if f, ok := v.(float64); ok {
			cfg.Port = int(f)
		}
	}
	if v, ok := patch["inference_timeout_sec"]; ok {
		if f, ok := v.(float64); ok {
			cfg.InferenceTimeoutSec = int(f)
		}
	}
	if v, ok := patch["max_batch_size"]; ok {
		if f, ok := v.(float64); ok {
			cfg.MaxBatchSize = int(f)
		}
	}
	if v, ok := patch["log_level"]; ok {
		if s, ok := v.(string); ok {
			cfg.LogLevel = s
		}
	}
	if v, ok := patch["webhook_timeout_sec"]; ok {
		if f, ok := v.(float64); ok {
			cfg.WebhookTimeoutSec = int(f)
		}
	}
	if v, ok := patch["metrics_retention_hours"]; ok {
		if f, ok := v.(float64); ok {
			cfg.MetricsRetentionHours = int(f)
		}
	}
	if v, ok := patch["max_model_size_mb"]; ok {
		if f, ok := v.(float64); ok {
			cfg.MaxModelSizeMB = int(f)
		}
	}

	if err := config.Save(s.cfg.DataDir+"/config.json", &cfg); err != nil {
		writeError(w, http.StatusInternalServerError, err.Error())
		return
	}
	*s.cfg = cfg
	s.auditReq(r, user.Username, "config.update", "config", "config", string(body))
