[?2004lpackage server

import (
	"net/http"
)

func (s *Server) Routes() http.Handler {
	mux := http.NewServeMux()

	mux.HandleFunc("GET /api/v1/health", s.Health)

	mux.HandleFunc("POST /api/v1/auth/register", s.RegisterUser)
	mux.HandleFunc("POST /api/v1/auth/login", s.Login)

	mux.HandleFunc("POST /api/v1/models", s.RegisterModel)
	mux.HandleFunc("GET /api/v1/models", s.ListModels)
	mux.HandleFunc("GET /api/v1/models/{id}", s.GetModel)
	mux.HandleFunc("DELETE /api/v1/models/{id}", s.DeleteModel)
	mux.HandleFunc("POST /api/v1/models/{id}/versions", s.UploadVersion)
	mux.HandleFunc("GET /api/v1/models/{id}/versions", s.ListVersions)
	mux.HandleFunc("GET /api/v1/models/{id}/versions/{version}/download", s.DownloadVersion)
	mux.HandleFunc("POST /api/v1/models/{id}/versions/{version}/deploy", s.DeployVersion)
	mux.HandleFunc("POST /api/v1/models/{id}/versions/{version}/undeploy", s.UndeployVersion)

	mux.HandleFunc("POST /api/v1/infer/{model_name}", s.Infer)
	mux.HandleFunc("POST /api/v1/infer/{model_name}/batch", s.InferBatch)

	mux.HandleFunc("GET /api/v1/admin/metrics", s.Metrics)
	mux.HandleFunc("GET /api/v1/admin/audit", s.Audit)
	mux.HandleFunc("GET /api/v1/admin/config", s.GetConfig)
	mux.HandleFunc("POST /api/v1/admin/config", s.UpdateConfig)

	mux.HandleFunc("POST /api/v1/webhooks", s.RegisterWebhook)
	mux.HandleFunc("GET /api/v1/webhooks", s.ListWebhooks)
	mux.HandleFunc("DELETE /api/v1/webhooks/{id}", s.DeleteWebhook)

	return s.logging(mux)
}

func (s *Server) logging(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		next.ServeHTTP(w, r)
	})
}
[?2004hroot@n30009:/app# sed -n '1,620p' internal/server/handlers.go
[?2004lpackage server

import (
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"net/http"
	"strconv"
	"strings"
	"time"

	"mlgateway/internal/audit"
	"mlgateway/internal/auth"
	"mlgateway/internal/config"
	"mlgateway/internal/inference"
	"mlgateway/internal/metrics"
	"mlgateway/internal/registry"
	"mlgateway/internal/store"
	"mlgateway/internal/webhooks"
)

type Server struct {
	cfg       *config.Config
	store     *store.Store
	auth      *auth.Service
	registry  *registry.Service
	inference *inference.Service
	metrics   *metrics.Service
	audit     *audit.Service
	webhooks  *webhooks.Service
	startTime time.Time
}

func New(cfg *config.Config, st *store.Store, as *auth.Service, rs *registry.Service, is *inference.Service, ms *metrics.Service, aus *audit.Service, ws *webhooks.Service, startTime time.Time) *Server {
	return &Server{
		cfg:       cfg,
		store:     st,
		auth:      as,
		registry:  rs,
		inference: is,
		metrics:   ms,
		audit:     aus,
		webhooks:  ws,
		startTime: startTime,
	}
}

func writeJSON(w http.ResponseWriter, status int, v interface{}) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(v)
}

func writeError(w http.ResponseWriter, status int, msg string) {
	writeJSON(w, status, map[string]string{"error": msg})
}

func (s *Server) auditReq(r *http.Request, user, action, resourceType, resourceID, details string) {
	s.audit.Add(user, action, resourceType, resourceID, details, clientIP(r))
}

func clientIP(r *http.Request) string {
	if ip := r.Header.Get("X-Forwarded-For"); ip != "" {
		return strings.Split(ip, ",")[0]
	}
	return r.RemoteAddr
}

func (s *Server) Health(w http.ResponseWriter, r *http.Request) {
	writeJSON(w, http.StatusOK, map[string]interface{}{
		"status":         "healthy",
		"uptime_seconds": int64(time.Since(s.startTime).Seconds()),
	})
}

func (s *Server) RegisterUser(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Username string `json:"username"`
		Password string `json:"password"`
		Role     string `json:"role"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body")
		return
	}

	callerRole := ""
	if user, ok := s.authFromRequest(r); ok {
		callerRole = user.Role
	}

	user, err := s.auth.Register(req.Username, req.Password, req.Role, callerRole)
	if err != nil {
		switch {
		case errors.Is(err, auth.ErrForbidden):
			writeError(w, http.StatusForbidden, err.Error())
		case errors.Is(err, auth.ErrInvalidRole), strings.Contains(err.Error(), "required"):
			writeError(w, http.StatusBadRequest, err.Error())
		case errors.Is(err, auth.ErrUsernameExists):
			writeError(w, http.StatusConflict, err.Error())
		default:
			writeError(w, http.StatusBadRequest, err.Error())
		}
		return
	}

	s.auditReq(r, user.Username, "user.register", "user", user.ID, "role="+user.Role)
	writeJSON(w, http.StatusCreated, map[string]interface{}{
		"id":       user.ID,
		"username": user.Username,
		"role":     user.Role,
		"api_key":  user.APIKey,
	})
}

func (s *Server) Login(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body")
		return
	}

	apiKey, role, err := s.auth.Login(req.Username, req.Password)
	if err != nil {
		writeError(w, http.StatusUnauthorized, "invalid credentials")
		return
	}

	s.auditReq(r, req.Username, "user.login", "user", req.Username, "")
	writeJSON(w, http.StatusOK, map[string]string{"api_key": apiKey, "role": role})
}

func (s *Server) authFromRequest(r *http.Request) (*store.User, bool) {
	authHeader := r.Header.Get("Authorization")
	if !strings.HasPrefix(authHeader, "Bearer ") {
		return nil, false
	}
	token := strings.TrimPrefix(authHeader, "Bearer ")
	return s.auth.Authenticate(token)
}

func (s *Server) RegisterModel(w http.ResponseWriter, r *http.Request) {
	user, ok := s.authFromRequest(r)
	if !ok {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}
	if !auth.CanAccess(user.Role, auth.RoleDeployer) {
		writeError(w, http.StatusForbidden, "insufficient role")
		return
	}

	var m store.Model
	if err := json.NewDecoder(r.Body).Decode(&m); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body")
		return
	}

	created, err := s.registry.Register(&m)
	if err != nil {
		s.writeRegistryError(w, err)
		return
	}

	s.auditReq(r, user.Username, "model.register", "model", created.ID, "name="+created.Name)
	s.webhooks.Fire("model.created", created)
	writeJSON(w, http.StatusCreated, created)
}

func (s *Server) writeRegistryError(w http.ResponseWriter, err error) {
	switch {
	case errors.Is(err, registry.ErrValidation):
		writeError(w, http.StatusBadRequest, err.Error())
	case errors.Is(err, registry.ErrConflict):
		writeError(w, http.StatusConflict, err.Error())
	case errors.Is(err, registry.ErrNotFound):
		writeError(w, http.StatusNotFound, err.Error())
	case errors.Is(err, registry.ErrTooLarge):
		writeError(w, http.StatusRequestEntityTooLarge, err.Error())
	default:
		writeError(w, http.StatusInternalServerError, err.Error())
	}
}

func (s *Server) ListModels(w http.ResponseWriter, r *http.Request) {
	if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
		return
	}

	q := r.URL.Query()
	var deployedFilter *bool
	if d := q.Get("deployed"); d != "" {
		b, err := strconv.ParseBool(d)
		if err == nil {
			deployedFilter = &b
		}
	}

	models := s.registry.List(q.Get("name"), q.Get("framework"), q.Get("label_key"), q.Get("label_value"), deployedFilter)
	writeJSON(w, http.StatusOK, map[string]interface{}{"models": models})
}

func (s *Server) GetModel(w http.ResponseWriter, r *http.Request) {
	if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
		return
	}
	id := r.PathValue("id")
	model, err := s.registry.Get(id)
	if err != nil {
		writeError(w, http.StatusNotFound, "model not found")
		return
	}
	writeJSON(w, http.StatusOK, model)
}

func (s *Server) DeleteModel(w http.ResponseWriter, r *http.Request) {
	user, ok := s.requireAuth(w, r, auth.RoleDeployer)
	if !ok {
		return
	}
	id := r.PathValue("id")
	model, err := s.registry.Get(id)
	if err != nil {
		writeError(w, http.StatusNotFound, "model not found")
		return
	}
	if err := s.registry.Delete(id); err != nil {
		if errors.Is(err, registry.ErrConflict) {
			writeError(w, http.StatusConflict, err.Error())
		} else {
			writeError(w, http.StatusInternalServerError, err.Error())
		}
		return
	}
	s.auditReq(r, user.Username, "model.delete", "model", id, "name="+model.Name)
	s.webhooks.Fire("model.deleted", model)
	writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
}

func (s *Server) UploadVersion(w http.ResponseWriter, r *http.Request) {
	user, ok := s.requireAuth(w, r, auth.RoleDeployer)
	if !ok {
		return
	}
	id := r.PathValue("id")

	if err := r.ParseMultipartForm(int64(s.cfg.MaxModelSizeMB) * 1024 * 1024); err != nil {
		writeError(w, http.StatusBadRequest, "invalid multipart form: "+err.Error())
		return
	}

	version := r.FormValue("version")
	releaseNotes := r.FormValue("release_notes")
	file, _, err := r.FormFile("binary")
	if err != nil {
		writeError(w, http.StatusBadRequest, "binary file is required")
		return
	}
	defer file.Close()

	v, err := s.registry.UploadVersion(id, version, releaseNotes, file)
	if err != nil {
		s.writeRegistryError(w, err)
		return
	}

	s.auditReq(r, user.Username, "version.upload", "model", id, "version="+v.Version)
	s.webhooks.Fire("version.uploaded", map[string]interface{}{"model_id": id, "version": v})
	writeJSON(w, http.StatusCreated, v)
}

func (s *Server) ListVersions(w http.ResponseWriter, r *http.Request) {
	if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
		return
	}
	id := r.PathValue("id")
	versions, err := s.registry.ListVersions(id)
	if err != nil {
		writeError(w, http.StatusNotFound, "model not found")
		return
	}
	writeJSON(w, http.StatusOK, map[string]interface{}{"versions": versions})
}

func (s *Server) DownloadVersion(w http.ResponseWriter, r *http.Request) {
	if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
		return
	}
	id := r.PathValue("id")
	version := r.PathValue("version")
	v, err := s.registry.GetVersion(id, version)
	if err != nil {
		writeError(w, http.StatusNotFound, "version not found")
		return
	}

	w.Header().Set("Content-Disposition", fmt.Sprintf("attachment; filename=model-%s.bin", version))
	w.Header().Set("Content-Type", "application/octet-stream")
	http.ServeFile(w, r, v.BinaryPath)
}

func (s *Server) DeployVersion(w http.ResponseWriter, r *http.Request) {
	user, ok := s.requireAuth(w, r, auth.RoleDeployer)
	if !ok {
		return
	}
	id := r.PathValue("id")
	version := r.PathValue("version")
	v, err := s.registry.DeployVersion(id, version)
	if err != nil {
		s.writeRegistryError(w, err)
		return
	}
	s.auditReq(r, user.Username, "version.deploy", "model", id, "version="+version)
	s.webhooks.Fire("version.deployed", map[string]interface{}{"model_id": id, "version": v})
	writeJSON(w, http.StatusOK, v)
}

func (s *Server) UndeployVersion(w http.ResponseWriter, r *http.Request) {
	user, ok := s.requireAuth(w, r, auth.RoleDeployer)
	if !ok {
		return
	}
	id := r.PathValue("id")
	version := r.PathValue("version")
	v, err := s.registry.UndeployVersion(id, version)
	if err != nil {
		s.writeRegistryError(w, err)
		return
	}
	s.auditReq(r, user.Username, "version.undeploy", "model", id, "version="+version)
	s.webhooks.Fire("version.undeployed", map[string]interface{}{"model_id": id, "version": v})
	writeJSON(w, http.StatusOK, v)
}

func (s *Server) Infer(w http.ResponseWriter, r *http.Request) {
	user, ok := s.requireAuth(w, r, auth.RoleDeployer)
	if !ok {
		return
	}
	modelName := r.PathValue("model_name")

	body, err := io.ReadAll(r.Body)
	if err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body")
		return
	}

	result, model, version, latency, err := s.inference.Infer(modelName, body)
	if err != nil {
		s.metrics.RecordInference(modelName, latency, true)
		s.auditReq(r, user.Username, "inference.error", "model", modelName, err.Error())
		writeError(w, http.StatusInternalServerError, err.Error())
		return
	}

	s.metrics.RecordInference(modelName, latency, false)
	payload := map[string]interface{}{
		"model":      model.Name,
		"version":    version.Version,
		"latency_ms": latency,
		"timestamp":  time.Now().UTC().Format(time.RFC3339),
		"result":     result,
	}
	s.webhooks.Fire("inference.completed", payload)
	writeJSON(w, http.StatusOK, payload)
}

func (s *Server) InferBatch(w http.ResponseWriter, r *http.Request) {
	user, ok := s.requireAuth(w, r, auth.RoleDeployer)
	if !ok {
		return
	}
	modelName := r.PathValue("model_name")

	var req struct {
		Inputs []json.RawMessage `json:"inputs"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body")
		return
	}
	if len(req.Inputs) == 0 {
		writeError(w, http.StatusBadRequest, "inputs are required")
		return
	}
	if len(req.Inputs) > s.cfg.MaxBatchSize {
		writeError(w, http.StatusBadRequest, fmt.Sprintf("batch size exceeds max %d", s.cfg.MaxBatchSize))
		return
	}

	results := make([]interface{}, 0, len(req.Inputs))
	errorsList := []string{}
	var modelNameResolved, versionResolved string

	for _, input := range req.Inputs {
		result, model, version, latency, err := s.inference.Infer(modelName, input)
		if err != nil {
			s.metrics.RecordInference(modelName, latency, true)
			errorsList = append(errorsList, err.Error())
			results = append(results, nil)
		} else {
			s.metrics.RecordInference(modelName, latency, false)
			modelNameResolved = model.Name
			versionResolved = version.Version
			results = append(results, result)
		}
	}

	s.auditReq(r, user.Username, "inference.batch", "model", modelName, fmt.Sprintf("count=%d", len(req.Inputs)))
	writeJSON(w, http.StatusOK, map[string]interface{}{
		"model":   modelNameResolved,
		"version": versionResolved,
		"results": results,
		"errors":  errorsList,
	})
}

func (s *Server) Metrics(w http.ResponseWriter, r *http.Request) {
	if _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {
		return
	}
	writeJSON(w, http.StatusOK, s.metrics.Get())
}

func (s *Server) Audit(w http.ResponseWriter, r *http.Request) {
	if _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {
		return
	}
	writeJSON(w, http.StatusOK, map[string]interface{}{"audit": s.audit.List()})
}

func (s *Server) RegisterWebhook(w http.ResponseWriter, r *http.Request) {
	user, ok := s.requireAuth(w, r, auth.RoleAdmin)
	if !ok {
		return
	}
	var req struct {
		URL    string   `json:"url"`
		Events []string `json:"events"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body")
		return
	}
	wh, err := s.webhooks.Register(req.URL, req.Events)
	if err != nil {
		writeError(w, http.StatusBadRequest, err.Error())
		return
	}
	s.auditReq(r, user.Username, "webhook.register", "webhook", wh.ID, "url="+wh.URL)
	writeJSON(w, http.StatusCreated, wh)
}

func (s *Server) ListWebhooks(w http.ResponseWriter, r *http.Request) {
	if _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {
		return
	}
	writeJSON(w, http.StatusOK, map[string]interface{}{"webhooks": s.webhooks.List()})
}

func (s *Server) DeleteWebhook(w http.ResponseWriter, r *http.Request) {
	user, ok := s.requireAuth(w, r, auth.RoleAdmin)
	if !ok {
		return
	}
	id := r.PathValue("id")
	if err := s.webhooks.Delete(id); err != nil {
		writeError(w, http.StatusNotFound, "webhook not found")
		return
	}
	s.auditReq(r, user.Username, "webhook.delete", "webhook", id, "")
	writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
}

func (s *Server) GetConfig(w http.ResponseWriter, r *http.Request) {
	if _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {
		return
	}
	writeJSON(w, http.StatusOK, s.cfg)
}

func (s *Server) UpdateConfig(w http.ResponseWriter, r *http.Request) {
	user, ok := s.requireAuth(w, r, auth.RoleAdmin)
	if !ok {
		return
	}

	var patch map[string]interface{}
	if err := json.NewDecoder(r.Body).Decode(&patch); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body")
		return
	}

	cfg := *s.cfg
	if v, ok := patch["port"]; ok {
		if f, ok := v.(float64); ok {
			cfg.Port = int(f)
		}
	}
	if v, ok := patch["inference_timeout_sec"]; ok {
		if f, ok := v.(float64); ok {
			cfg.InferenceTimeoutSec = int(f)
		}
	}
	if v, ok := patch["max_batch_size"]; ok {
		if f, ok := v.(float64); ok {
			cfg.MaxBatchSize = int(f)
		}
	}
	if v, ok := patch["log_level"]; ok {
		if s, ok := v.(string); ok {
			cfg.LogLevel = s
		}
	}
	if v, ok := patch["webhook_timeout_sec"]; ok {
		if f, ok := v.(float64); ok {
			cfg.WebhookTimeoutSec = int(f)
		}
	}
	if v, ok := patch["metrics_retention_hours"]; ok {
		if f, ok := v.(float64); ok {
			cfg.MetricsRetentionHours = int(f)
		}
	}
	if v, ok := patch["max_model_size_mb"]; ok {
		if f, ok := v.(float64); ok {
			cfg.MaxModelSizeMB = int(f)
		}
	}

	if err := config.Save(s.cfg.DataDir+"/config.json", &cfg); err != nil {
		writeError(w, http.StatusInternalServerError, err.Error())
		return
	}
	*s.cfg = cfg
	s.auditReq(r, user.Username, "config.update", "config", "config", "")
	writeJSON(w, http.StatusOK, s.cfg)
}

func (s *Server) requireAuth(w http.ResponseWriter, r *http.Request, requiredRole string) (*store.User, bool) {
	user, ok := s.authFromRequest(r)
	if !ok {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return nil, false
	}
	if !auth.CanAccess(user.Role, requiredRole) {
		writeError(w, http.StatusForbidden, "insufficient role")
		return nil, false
	}
	return user, true
}
