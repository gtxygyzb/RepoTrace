   276	func (s *Server) ListVersions(w http.ResponseWriter, r *http.Request) {
   277		if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
   278			return
   279		}
   280		id := r.PathValue("id")
   281		versions, err := s.registry.ListVersions(id)
   282		if err != nil {
   283			writeError(w, http.StatusNotFound, "model not found")
   284			return
   285		}
   286		writeJSON(w, http.StatusOK, map[string]interface{}{"versions": versions})
   287	}
   288	
   289	func (s *Server) DownloadVersion(w http.ResponseWriter, r *http.Request) {
   290		if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {
   291			return
   292		}
   293		id := r.PathValue("id")
   294		version := r.PathValue("version")
   295		v, err := s.registry.GetVersion(id, version)
   296		if err != nil {
   297			writeError(w, http.StatusNotFound, "version not found")
   298			return
   299		}
   300	
   301		w.Header().Set("Content-Disposition", fmt.Sprintf("attachment; filename=model-%s.bin", version))
   302		w.Header().Set("Content-Type", "application/octet-stream")
   303		http.ServeFile(w, r, v.BinaryPath)
   304	}
   305	
   306	func (s *Server) DeployVersion(w http.ResponseWriter, r *http.Request) {
   307		user, ok := s.requireAuth(w, r, auth.RoleDeployer)
   308		if !ok {
   309			return
   310		}
   311		id := r.PathValue("id")
   312		version := r.PathValue("version")
   313		v, err := s.registry.DeployVersion(id, version)
   314		if err != nil {
   315			s.writeRegistryError(w, err)
   316			return
   317		}
   318		s.auditReq(r, user.Username, "version.deploy", "model", id, "version="+version)
   319		s.webhooks.Fire("version.deployed", map[string]interface{}{"model_id": id, "version": v})
   320		writeJSON(w, http.StatusOK, v)
   321	}
