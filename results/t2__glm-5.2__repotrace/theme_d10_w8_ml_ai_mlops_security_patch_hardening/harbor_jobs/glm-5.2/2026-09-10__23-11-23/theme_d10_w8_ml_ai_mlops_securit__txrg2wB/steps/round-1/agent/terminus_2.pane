[?2004hroot@n30009:/app# sed -n '1,140p' internal/registry/registry.go
[?2004lpackage registry

import (
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"regexp"
	"strings"
	"time"

	"mlgateway/internal/store"
)

var (
	ErrNotFound   = errors.New("not found")
	ErrConflict   = errors.New("conflict")
	ErrValidation = errors.New("validation error")
	ErrTooLarge   = errors.New("model binary too large")
)

var semverRe = regexp.MustCompile(`^[0-9]+\.[0-9]+\.[0-9]+$`)

type Service struct {
	store           *store.Store
	modelStorageDir string
	maxModelSize    int64
}

func New(s *store.Store, modelStorageDir string, maxModelSizeMB int) *Service {
	return &Service{
		store:           s,
		modelStorageDir: modelStorageDir,
		maxModelSize:    int64(maxModelSizeMB) * 1024 * 1024,
	}
}

func ValidateFramework(framework string) error {
	switch framework {
	case "tensorflow", "pytorch", "onnx", "custom":
		return nil
	default:
		return fmt.Errorf("%w: invalid framework %q", ErrValidation, framework)
	}
}

func ValidateSemver(version string) error {
	if !semverRe.MatchString(version) {
		return fmt.Errorf("%w: invalid semantic version %q", ErrValidation, version)
	}
	return nil
}

func ValidateSchema(schema json.RawMessage) error {
	if len(schema) == 0 || string(schema) == "null" {
		return fmt.Errorf("%w: schema is required", ErrValidation)
	}
	var obj map[string]interface{}
	if err := json.Unmarshal(schema, &obj); err != nil {
		return fmt.Errorf("%w: schema must be a JSON object", ErrValidation)
	}
	if obj == nil {
		return fmt.Errorf("%w: schema must be a JSON object", ErrValidation)
	}
	if t, ok := obj["type"]; ok {
		if _, ok := t.(string); !ok {
			return fmt.Errorf("%w: schema type must be a string", ErrValidation)
		}
	}
	if p, ok := obj["properties"]; ok {
		if _, ok := p.(map[string]interface{}); !ok {
			return fmt.Errorf("%w: schema properties must be an object", ErrValidation)
		}
	}
	if r, ok := obj["required"]; ok {
		if _, ok := r.([]interface{}); !ok {
			return fmt.Errorf("%w: schema required must be an array", ErrValidation)
		}
	}
	if i, ok := obj["items"]; ok {
		if _, ok := i.(map[string]interface{}); !ok {
			return fmt.Errorf("%w: schema items must be an object", ErrValidation)
		}
	}
	return nil
}

func (s *Service) Register(m *store.Model) (*store.Model, error) {
	m.Name = strings.TrimSpace(m.Name)
	m.Framework = strings.TrimSpace(m.Framework)
	m.Description = strings.TrimSpace(m.Description)
	m.Author = strings.TrimSpace(m.Author)

	if m.Name == "" {
		return nil, fmt.Errorf("%w: name is required", ErrValidation)
	}
	if err := ValidateFramework(m.Framework); err != nil {
		return nil, err
	}
	if err := ValidateSchema(m.InputSchema); err != nil {
		return nil, fmt.Errorf("input_schema: %w", err)
	}
	if err := ValidateSchema(m.OutputSchema); err != nil {
		return nil, fmt.Errorf("output_schema: %w", err)
	}
	if m.Labels == nil {
		m.Labels = map[string]string{}
	}

	var created *store.Model
	err := s.store.WithLock(func(d *store.Data) error {
		for _, existing := range d.Models {
			if existing.Name == m.Name {
				return fmt.Errorf("%w: model name already exists", ErrConflict)
			}
		}

		model := &store.Model{
			ID:           store.NewID(),
			Name:         m.Name,
			Framework:    m.Framework,
			Description:  m.Description,
			Author:       m.Author,
			CreatedAt:    time.Now().UTC(),
			InputSchema:  m.InputSchema,
			OutputSchema: m.OutputSchema,
			Labels:       m.Labels,
			Lineage:      m.Lineage,
			Versions:     []*store.Version{},
		}
		d.Models[model.ID] = model
		created = model
		return nil
	})
	if err != nil {
		return nil, err
	}
	return created, nil
