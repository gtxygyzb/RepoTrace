[?2004lpackage audit

import (
	"mlgateway/internal/store"
	"time"
	"unicode/utf8"
)

type Service struct {
	store *store.Store
}

func New(s *store.Store) *Service {
	return &Service{store: s}
}

func (s *Service) Add(user, action, resourceType, resourceID, details, sourceIP string) {
	_ = s.store.WithLock(func(d *store.Data) error {
		d.Audit = append(d.Audit, store.AuditEntry{
			Timestamp:    time.Now().UTC(),
			User:         user,
			Action:       action,
			ResourceType: resourceType,
			ResourceID:   resourceID,
			Details:      sanitizeDetail(details),
			SourceIP:     sourceIP,
		})
		if len(d.Audit) > 1000 {
			d.Audit = d.Audit[len(d.Audit)-1000:]
		}
		return nil
	})
}

func sanitizeDetail(details string) string {
	cleaned := make([]byte, 0, len(details))
	for i := 0; i < len(details); i++ {
		b := details[i]
		if b < 0x20 && b != ' ' {
			continue
		}
		cleaned = append(cleaned, b)
	}

	const maxRunes = 256
	if utf8.RuneCountInString(string(cleaned)) <= maxRunes {
		return string(cleaned)
	}

	var n int
	for i := 0; i < len(cleaned) && n < maxRunes; {
		_, size := utf8.DecodeRuneInString(cleaned[i:])
		if size == 0 {
			break
		}
		i += size
		n++
	}
	return string(cleaned[:i]) + "...[truncated]"
}

func (s *Service) List() []store.AuditEntry {
	var entries []store.AuditEntry
	_ = s.store.WithRLock(func(d *store.Data) error {
		entries = make([]store.AuditEntry, len(d.Audit))
		copy(entries, d.Audit)
		return nil
	})
	return entries
}
func (s *Server) UpdateConfig(w http.ResponseWriter, r *http.Request) {
	user, ok := s.requireAuth(w, r, auth.RoleAdmin)
	if !ok {
		return
	}

	body, err := io.ReadAll(r.Body)
	if err != nil {
		writeBodyReadError(w, err)
		return
	}

	var patch map[string]interface{}
	if err := json.Unmarshal(body, &patch); err != nil {
		writeBodyReadError(w, err)
		return
	}

	cfg := *s.cfg
	if v, ok := patch["port"]; ok {
		if f, ok := v.(float64); ok {
			cfg.Port = int(f)
		}
	}
	if v, ok := patch["inference_timeout_sec"]; ok {
		if f, ok := v.(float64); ok {
			cfg.InferenceTimeoutSec = int(f)
		}
	}
	if v, ok := patch["max_batch_size"]; ok {
		if f, ok := v.(float64); ok {
			cfg.MaxBatchSize = int(f)
		}
