   487	func (s *Server) UpdateConfig(w http.ResponseWriter, r *http.Request) {
   488		user, ok := s.requireAuth(w, r, auth.RoleAdmin)
   489		if !ok {
   490			return
   491		}
   492	
   493		var patch map[string]interface{}
   494		if err := json.NewDecoder(r.Body).Decode(&patch); err != nil {
   495			writeError(w, http.StatusBadRequest, "invalid request body")
   496			return
   497		}
   498	
   499		cfg := *s.cfg
   500		if v, ok := patch["port"]; ok {
   501			if f, ok := v.(float64); ok {
   502				cfg.Port = int(f)
   503			}
   504		}
   505		if v, ok := patch["inference_timeout_sec"]; ok {
   506			if f, ok := v.(float64); ok {
   507				cfg.InferenceTimeoutSec = int(f)
   508			}
   509		}
   510		if v, ok := patch["max_batch_size"]; ok {
   511			if f, ok := v.(float64); ok {
   512				cfg.MaxBatchSize = int(f)
   513			}
   514		}
   515		if v, ok := patch["log_level"]; ok {
   516			if s, ok := v.(string); ok {
   517				cfg.LogLevel = s
   518			}
   519		}
   520		if v, ok := patch["webhook_timeout_sec"]; ok {
   521			if f, ok := v.(float64); ok {
   522				cfg.WebhookTimeoutSec = int(f)
   523			}
   524		}
   525		if v, ok := patch["metrics_retention_hours"]; ok {
   526			if f, ok := v.(float64); ok {
   527				cfg.MetricsRetentionHours = int(f)
   528			}
   529		}
   530		if v, ok := patch["max_model_size_mb"]; ok {
   531			if f, ok := v.(float64); ok {
   532				cfg.MaxModelSizeMB = int(f)
   533			}
   534		}
   535	
   536		if err := config.Save(s.cfg.DataDir+"/config.json", &cfg); err != nil {
   537			writeError(w, http.StatusInternalServerError, err.Error())
   538			return
   539		}
   540		*s.cfg = cfg
   541		s.auditReq(r, user.Username, "config.update", "config", "config", "")
   542		writeJSON(w, http.StatusOK, s.cfg)
   543	}
   544	
   545	func (s *Server) requireAuth(w http.ResponseWriter, r *http.Request, requiredRole string) (*store.User, bool) {
   546		user, ok := s.authFromRequest(r)
   547		if !ok {
   548			writeError(w, http.StatusUnauthorized, "unauthorized")
   549			return nil, false
   550		}
   551		if !auth.CanAccess(user.Role, requiredRole) {
   552			writeError(w, http.StatusForbidden, "insufficient role")
   553			return nil, false
   554		}
   555		return user, true
   556	}
[?2004hroot@n30009:/app# cat internal/server/router.go
[?2004lpackage server

import (
	"net/http"
)

func (s *Server) Routes() http.Handler {
	mux := http.NewServeMux()

	mux.HandleFunc("GET /api/v1/health", s.Health)

	mux.HandleFunc("POST /api/v1/auth/register", s.RegisterUser)
	mux.HandleFunc("POST /api/v1/auth/login", s.Login)

	mux.HandleFunc("POST /api/v1/models", s.RegisterModel)
	mux.HandleFunc("GET /api/v1/models", s.ListModels)
	mux.HandleFunc("GET /api/v1/models/{id}", s.GetModel)
	mux.HandleFunc("DELETE /api/v1/models/{id}", s.DeleteModel)
	mux.HandleFunc("POST /api/v1/models/{id}/versions", s.UploadVersion)
	mux.HandleFunc("GET /api/v1/models/{id}/versions", s.ListVersions)
	mux.HandleFunc("GET /api/v1/models/{id}/versions/{version}/download", s.DownloadVersion)
	mux.HandleFunc("POST /api/v1/models/{id}/versions/{version}/deploy", s.DeployVersion)
	mux.HandleFunc("POST /api/v1/models/{id}/versions/{version}/undeploy", s.UndeployVersion)

	mux.HandleFunc("POST /api/v1/infer/{model_name}", s.Infer)
	mux.HandleFunc("POST /api/v1/infer/{model_name}/batch", s.InferBatch)

	mux.HandleFunc("GET /api/v1/admin/metrics", s.Metrics)
	mux.HandleFunc("GET /api/v1/admin/audit", s.Audit)
	mux.HandleFunc("GET /api/v1/admin/config", s.GetConfig)
	mux.HandleFunc("POST /api/v1/admin/config", s.UpdateConfig)

	mux.HandleFunc("POST /api/v1/webhooks", s.RegisterWebhook)
	mux.HandleFunc("GET /api/v1/webhooks", s.ListWebhooks)
	mux.HandleFunc("DELETE /api/v1/webhooks/{id}", s.DeleteWebhook)

	return s.logging(mux)
}

func (s *Server) logging(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		next.ServeHTTP(w, r)
	})
}
