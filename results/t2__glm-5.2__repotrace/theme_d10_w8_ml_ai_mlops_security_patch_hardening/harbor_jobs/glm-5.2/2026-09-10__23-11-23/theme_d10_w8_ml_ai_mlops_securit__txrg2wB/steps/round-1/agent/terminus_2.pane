   192	func (s *Server) writeRegistryError(w http.ResponseWriter, err error) {
   193		switch {
   194		case errors.Is(err, registry.ErrValidation):
   195			writeError(w, http.StatusBadRequest, err.Error())
   196		case errors.Is(err, registry.ErrConflict):
   197			writeError(w, http.StatusConflict, err.Error())
   198		case errors.Is(err, registry.ErrNotFound):
   199			writeError(w, http.StatusNotFound, err.Error())
   200		case errors.Is(err, registry.ErrTooLarge):
   201			writeError(w, http.StatusRequestEntityTooLarge, err.Error())
   202		default:
   203			writeError(w, http.StatusInternalServerError, err.Error())
   204		}
   205	}
