    72			}
    73			return nil
    74		}
    75	
    76		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
    77		defer cancel()
    78		addrs, err := net.DefaultResolver.LookupIPAddr(ctx, host)
    79		if err != nil {
    80			return errors.New("failed to resolve webhook url host: " + err.Error())
