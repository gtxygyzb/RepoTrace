    40	func ValidateFramework(framework string) error {
    41		switch framework {
    42		case "tensorflow", "pytorch", "onnx", "custom":
    43			return nil
    44		default:
    45			return fmt.Errorf("%w: invalid framework %q", ErrValidation, framework)
    46		}
    47	}
    48	
    49	func ValidateSemver(version string) error {
    50		if !semverRe.MatchString(version) {
    51			return fmt.Errorf("%w: invalid semantic version %q", ErrValidation, version)
    52		}
    53		return nil
    54	}
    55	
    56	func ValidateSchema(schema json.RawMessage) error {
    57		if len(schema) == 0 || string(schema) == "null" {
    58			return fmt.Errorf("%w: schema is required", ErrValidation)
    59		}
    60		var obj map[string]interface{}
    61		if err := json.Unmarshal(schema, &obj); err != nil {
    62			return fmt.Errorf("%w: schema must be a JSON object", ErrValidation)
    63		}
    64		if obj == nil {
    65			return fmt.Errorf("%w: schema must be a JSON object", ErrValidation)
    66		}
    67		if t, ok := obj["type"]; ok {
    68			if _, ok := t.(string); !ok {
    69				return fmt.Errorf("%w: schema type must be a string", ErrValidation)
    70			}
    71		}
    72		if p, ok := obj["properties"]; ok {
    73			if _, ok := p.(map[string]interface{}); !ok {
    74				return fmt.Errorf("%w: schema properties must be an object", ErrValidation)
    75			}
    76		}
    77		if r, ok := obj["required"]; ok {
    78			if _, ok := r.([]interface{}); !ok {
    79				return fmt.Errorf("%w: schema required must be an array", ErrValidation)
    80			}
    81		}
    82		if i, ok := obj["items"]; ok {
    83			if _, ok := i.(map[string]interface{}); !ok {
    84				return fmt.Errorf("%w: schema items must be an object", ErrValidation)
    85			}
    86		}
    87		return nil
    88	}
