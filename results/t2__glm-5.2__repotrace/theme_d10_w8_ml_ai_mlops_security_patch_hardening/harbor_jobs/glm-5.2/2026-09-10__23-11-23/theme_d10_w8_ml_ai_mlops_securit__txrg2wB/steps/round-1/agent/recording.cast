[1951.147649, "o", "     1\tpackage auth\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/rand\"\r\n     5\t\t\"crypto/sha256\"\r\n     6\t\t\"encoding/hex\"\r\n     7\t"]
[1951.147755, "o", "\t\"errors\"\r\n     8\t\t\"strings\"\r\n     9\t\t\"time\"\r\n    10\t\r\n    11\t\t\"mlgateway/internal/store\"\r\n    12\t)\r\n    13\t\r\n    14\tconst (\r\n    15\t\tRoleAdmin    = \"admin\"\r\n    16\t\tRoleDeployer = \"deployer\"\r\n    17\t\tRoleViewer   = \"viewer\"\r\n    18\t)\r\n    19\t\r\n    20\tvar (\r\n"]
[1951.147844, "o", "    21\t\tErrInvalidRole        = errors.New(\"invalid role\")\r\n    22\t\tErrUsernameExists     = errors.New(\"username already exists\")\r\n    23\t\tErrForbidden          = errors.New(\"forbidden\")\r\n    24\t\tErrInvalidCredentials = errors.New(\"invalid credentials\")\r\n    25\t)\r\n    26\t\r\n"]
[1951.147912, "o", "    27\ttype Service struct {\r\n    28\t\tstore *store.Store\r\n    29\t}\r\n    30\t\r\n    31\tfunc New(s *store.Store) *Service {\r\n    32\t\treturn &Service{store: s}\r\n    33\t}\r\n    34\t\r\n    35\tfunc validRole(role string) bool {\r\n    36\t\treturn role == RoleAdmin || role == RoleDeployer || role == RoleViewer\r\n    37\t}\r\n    38\t\r\n    39\tfunc hashPassword(password string) (string, error) {\r\n    40\t\tsalt := make([]byte, 16)\r\n    41\t\tif _, err := rand.Read(salt); err != nil {\r\n    42\t\t\treturn \"\", err\r\n    43\t\t}\r\n    44\t\th := sha256.Sum256(append(salt, []byte(password)...))\r\n"]
[1951.147981, "o", "    45\t\treturn hex.EncodeToString(salt) + \":\" + hex.EncodeToString(h[:]), nil\r\n    46\t}\r\n    47\t\r\n    48\tfunc verifyPassword(password, hash string) bool {\r\n    49\t\tparts := strings.SplitN(hash, \":\", 2)\r\n    50\t\tif len(parts) != 2 {\r\n    51\t\t\treturn false\r\n    52\t\t}\r\n    53\t\th := sha256.Sum256(append([]byte(parts[0]), []byte(password)...))\r\n"]
[1951.148046, "o", "    54\t\treturn hex.EncodeToString(h[:]) == parts[1]\r\n    55\t}\r\n    56\t\r\n    57\tfunc (s *Service) Register(username, password, role, callerRole string) (*store.User, error) {\r\n    58\t\tusername = strings.TrimSpace(username)\r\n    59\t\tif username == \"\" || password == \"\" {\r\n    60\t\t\treturn nil, errors.New(\"username and password are required\")\r\n    61\t\t}\r\n    62\t\tif !validRole(role) {\r\n    63\t\t\treturn nil, ErrInvalidRole\r\n"]
[1951.148131, "o", "    64\t\t}\r\n    65\t\r\n    66\t\tvar created *store.User\r\n    67\t\terr := s.store.WithLock(func(d *store.Data) error {\r\n    68\t\t\tif len(d.Users) > 0 {\r\n    69\t\t\t\tif callerRole != RoleAdmin {\r\n    70\t\t\t\t\treturn ErrForbidden\r\n"]
