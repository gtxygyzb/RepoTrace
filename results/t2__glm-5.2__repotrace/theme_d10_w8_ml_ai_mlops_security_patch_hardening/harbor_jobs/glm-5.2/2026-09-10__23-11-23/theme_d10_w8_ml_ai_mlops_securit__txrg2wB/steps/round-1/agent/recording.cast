[1401.190979, "o", "\u001b[?2004h> "]
[1401.19104, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1401.191095, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1401.191176, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.19131, "o", "    var versionCreated *store.Version\r\n\u001b[?2004l\r"]
[1401.191367, "o", "\u001b[?2004h> "]
[1401.19154, "o", "    err = s.store.WithLock(func(d *store.Data) error {\r\n\u001b[?2004l\r"]
[1401.191596, "o", "\u001b[?2004h> "]
[1401.191677, "o", "        m, ok := d.Models[id]\r\n\u001b[?2004l\r"]
[1401.191733, "o", "\u001b[?2004h> "]
[1401.191798, "o", "        if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.191918, "o", "            return ErrNotFound\r\n\u001b[?2004l\r"]
[1401.191973, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1401.19203, "o", "\u001b[?2004h> "]
[1401.192165, "o", "        for _, v := range m.Versions {\r\n\u001b[?2004l\r"]
[1401.19222, "o", "\u001b[?2004h> "]
[1401.192333, "o", "            if v.Version == version {\r\n\u001b[?2004l\r"]
[1401.192388, "o", "\u001b[?2004h> "]
[1401.192634, "o", "                return fmt.Errorf(\"%w: version already exists\", ErrConflict)\r\n\u001b[?2004l\r"]
[1401.19269, "o", "\u001b[?2004h> "]
[1401.192746, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.1928, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1401.192855, "o", "> "]
[1401.192927, "o", "        v := &store.Version{\r\n\u001b[?2004l\r"]
[1401.192981, "o", "\u001b[?2004h> "]
[1401.193084, "o", "            Version:      version,\r\n\u001b[?2004l\r"]
[1401.193147, "o", "\u001b[?2004h> "]
[1401.193267, "o", "            ReleaseNotes: releaseNotes,\r\n\u001b[?2004l\r"]
[1401.193321, "o", "\u001b[?2004h> "]
[1401.193433, "o", "            BinaryPath:   binaryPath,\r\n\u001b[?2004l\r"]
[1401.193487, "o", "\u001b[?2004h> "]
[1401.193612, "o", "            Status:       \"undeployed\",\r\n\u001b[?2004l\r"]
[1401.193667, "o", "\u001b[?2004h> "]
[1401.193798, "o", "            CreatedAt:    time.Now().UTC(),\r\n\u001b[?2004l\r"]
[1401.193852, "o", "\u001b[?2004h> "]
[1401.193938, "o", "            Size:         n,\r\n\u001b[?2004l\r"]
[1401.193993, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1401.194048, "o", "\u001b[?2004h> "]
[1401.194201, "o", "        m.Versions = append(m.Versions, v)\r\n\u001b[?2004l\r"]
[1401.194258, "o", "\u001b[?2004h> "]
[1401.194326, "o", "        versionCreated = v\r\n\u001b[?2004l\r"]
[1401.194382, "o", "\u001b[?2004h> "]
[1401.194446, "o", "        return nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.194516, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.194596, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1401.194651, "o", "\u001b[?2004h> "]
[1401.194749, "o", "        _ = os.Remove(binaryPath)\r\n\u001b[?2004l\r"]
[1401.19481, "o", "\u001b[?2004h> "]
[1401.194872, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1401.194928, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1401.194987, "o", "\u001b[?2004h> "]
[1401.195064, "o", "    return versionCreated, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.19513, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1401.195187, "o", "\u001b[?2004h> "]
[1401.195322, "o", "func (s *Service) ListVersions(id string) ([]*store.Version, error) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1401.195382, "o", "> "]
[1401.195433, "o", "    var versions []*store.Version\r\n\u001b[?2004l\r\u001b[?2004h"]
