[2392.180737, "o", "func (s *Server) Infer(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\t"]
[2392.180809, "o", "modelName := r.PathValue(\"model_name\")\r\n\r\n\tbody, err := io.ReadAll(r.Body)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body\")\r\n\t\treturn\r\n\t}\r\n\r\n\tresult, model, version, latency, err := s.inference.Infer(modelName, body)\r\n\tif err != nil {\r\n\t\ts.metrics.RecordInference(modelName, latency, true)\r\n\t\t"]
[2392.180877, "o", "s.auditReq(r, user.Username, \"inference.error\", \"model\", modelName, err.Error())\r\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\r\n\t\treturn\r\n\t}\r\n\r\n\ts.metrics.RecordInference(modelName, latency, false)\r\n\tpayload := map[string]interface{}{\r\n\t\t\"model\":      model.Name,\r\n\t\t\"version\":    version.Version,\r\n\t\t\"latency_ms\": latency,\r\n\t\t\"timestamp\":  time.Now().UTC().Format(time.RFC3339),\r\n"]
[2392.180944, "o", "\t\t\"result\":     result,\r\n\t}\r\n\ts.webhooks.Fire(\"inference.completed\", payload)\r\n\twriteJSON(w, http.StatusOK, payload)\r\n}\r\n\r\nfunc (s *Server) InferBatch(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\tif !ok {\r\n\t\treturn\r\n"]
[2392.181005, "o", "\t}\r\n\tmodelName := r.PathValue(\"model_name\")\r\n\r\n\tvar req struct {\r\n\t\tInputs []json.RawMessage `json:\"inputs\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body\")\r\n\t\treturn\r\n\t}\r\n\tif len(req.Inputs) == 0 {\r\n"]
[2392.181064, "o", "\t\twriteError(w, http.StatusBadRequest, \"inputs are required\")\r\n\t\treturn\r\n\t}\r\n\tif len(req.Inputs) > s.cfg.MaxBatchSize {\r\n\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"batch size exceeds max %d\", s.cfg.MaxBatchSize))\r\n\t\treturn\r\n\t}\r\n\r\n\tresults := make([]interface{}, 0, len(req.Inputs))\r\n\terrorsList := []string{}\r\n\t"]
[2392.181156, "o", "var modelNameResolved, versionResolved string\r\n\r\n\tfor _, input := range req.Inputs {\r\n\t\tresult, model, version, latency, err := s.inference.Infer(modelName, input)\r\n\t\tif err != nil {\r\n\t\t\ts.metrics.RecordInference(modelName, latency, true)\r\n\t\t\terrorsList = append(errorsList, err.Error())\r\n\t\t\tresults = append(results, nil)\r\n\t\t} else {\r\n\t\t\ts.metrics.RecordInference(modelName, latency, false)\r\n\t"]
[2392.181218, "o", "\t\tmodelNameResolved = model.Name\r\n\t\t\tversionResolved = version.Version\r\n\t\t\tresults = append(results, result)\r\n\t\t}\r\n\t}\r\n\r\n\ts.auditReq(r, user.Username, \"inference.batch\", \"model\", modelName, fmt.Sprintf(\"count=%d\", len(req.Inputs)))\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\t\t\"model\":   modelNameResolved,\r\n\t\t\"version\": versionResolved,\r\n\t\t\"results\": results,\r\n\t\t"]
[2392.18128, "o", "\"errors\":  errorsList,\r\n\t})\r\n}\r\n\r\nfunc (s *Server) Metrics(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, s.metrics.Get())\r\n}\r\n\r\n"]
[2392.181335, "o", "func (s *Server) Audit(w http.ResponseWriter, r *http.Request) {\r\n"]
