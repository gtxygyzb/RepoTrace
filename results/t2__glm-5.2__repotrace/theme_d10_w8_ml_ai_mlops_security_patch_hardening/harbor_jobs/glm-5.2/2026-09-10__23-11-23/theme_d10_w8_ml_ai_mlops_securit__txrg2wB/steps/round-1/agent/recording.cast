[2829.956904, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/registry/registry.go')\ns = p.read_text()\nold = '''func (s *Service) Register(m *store.Model) (*store.Model, error) {\n        m.Name = strings.TrimSpace(m.Name)\n        m.Framework = strings.TrimSpace(m.Framework)\n        m.Description = strings.TrimSpace(m.Description)\n        m.Author = strings.TrimSpace(m.Author)\n\n        if m.Name == \"\" {\n                return nil, fmt.Errorf(\"%w: name is required\", ErrValidation)\n        }\n'''\nnew = '''func ValidateModelName(name string) error {\n        if name == \"\" {\n                return fmt.Errorf(\"%w: name is required\", ErrValidation)\n        }\n        if len(name) > 128 {\n                return fmt.Errorf(\"%w: name must be 128 characters or fewer\", ErrValidation)\n        }\n        if strings.ContainsAny(name, `/\\\\`) {\n                return fmt.Errorf(\"%w: name must not contain path separators\", ErrValidation)\n        }\n        if strings.ContainsAny(name, \";|&$`\") {\n                return fmt.Errorf(\"%w"]
[2829.957187, "i", ": name must not contain shell metacharacters\", ErrValidation)\n        }\n        if strings.Contains(name, \"..\") {\n                return fmt.Errorf(\"%w: name must not contain '..' sequences\", ErrValidation)\n        }\n        return nil\n}\n\nfunc (s *Service) Register(m *store.Model) (*store.Model, error) {\n        m.Name = strings.TrimSpace(m.Name)\n        m.Framework = strings.TrimSpace(m.Framework)\n        m.Description = strings.TrimSpace(m.Description)\n        m.Author = strings.TrimSpace(m.Author)\n\n        if err := ValidateModelName(m.Name); err != nil {\n                return nil, err\n        }\n'''\nif old not in s:\n    raise SystemExit('expected block not found')\np.write_text(s.replace(old, new))\nPY\n"]
