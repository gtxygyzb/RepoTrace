[3101.06186, "o", "package server\r\n\r\nimport (\r\n\t\"net/http\"\r\n\t\"strings\"\r\n)\r\n"]
[3101.061938, "o", "\r\nfunc (s *Server) Routes() http.Handler {\r\n\tmux := http.NewServeMux()\r\n\r\n\tmux.HandleFunc(\"GET /api/v1/health\", s.Health)\r\n\r\n\tmux.HandleFunc(\"POST /api/v1/auth/register\", s.RegisterUser)\r\n\tmux.HandleFunc(\"POST /api/v1/auth/login\", s.Login)\r\n\r\n\tmux.HandleFunc(\"POST /api/v1/models\", s.RegisterModel)\r\n\tmux.HandleFunc(\"GET /api/v1/models\", s.ListModels)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{id}\", s.GetModel)\r\n\tmux.HandleFunc(\"DELETE /api/v1/models/{id}\", s.DeleteModel)\r\n\t"]
[3101.062012, "o", "mux.HandleFunc(\"POST /api/v1/models/{id}/versions\", s.UploadVersion)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{id}/versions\", s.ListVersions)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{id}/versions/{version}/download\", s.DownloadVersion)\r\n\tmux.HandleFunc(\"POST /api/v1/models/{id}/versions/{version}/deploy\", s.DeployVersion)\r\n\tmux.HandleFunc(\"POST /api/v1/models/{id}/versions/{version}/undeploy\", s.UndeployVersion)\r\n\r\n\tmux.HandleFunc(\"POST /api/v1/infer/{model_name}\", s.Infer)\r\n\tmux.HandleFunc(\"POST /api/v1/infer/{model_name}/batch\", s.InferBatch)\r\n\r\n\tmux.HandleFunc(\"GET /api/v1/admin/metrics\", s.Metrics)\r\n\tmux.HandleFunc(\"GET /api/v1/admin/audit\", s.Audit)\r\n\tmux.HandleFunc(\"GET /api/v1/admin/config\", s.GetConfig)\r\n\t"]
[3101.062178, "o", "mux.HandleFunc(\"POST /api/v1/admin/config\", s.UpdateConfig)\r\n\r\n\tmux.HandleFunc(\"POST /api/v1/webhooks\", s.RegisterWebhook)\r\n\tmux.HandleFunc(\"GET /api/v1/webhooks\", s.ListWebhooks)\r\n\tmux.HandleFunc(\"DELETE /api/v1/webhooks/{id}\", s.DeleteWebhook)\r\n\r\n\treturn s.logging(s.bodyLimit(mux))\r\n}\r\n\r\nfunc (s *Server) bodyLimit(next http.Handler) http.Handler {\r\n\tconst defaultMaxBodyBytes int64 = 10 * 1024 * 1024\r\n\r\n\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\r\n\t\tif r.Body != nil {\r\n\t\t\tlimit := defaultMaxBodyBytes\r\n\t\t\tif r.Method == http.MethodPost && strings.HasPrefix(r.URL.Path, \"/api/v1/models/\") && strings.HasSuffix(r.URL.Path, \"/versions\") {\r\n\t\t\t\tlimit = int64(s.cfg.MaxModelSizeMB) * 1024 * 1024\r\n\t\t\t}\r\n\t\t\tr.Body = http.MaxBytesReader(w, r.Body, limit)\r\n\t\t}\r\n\t\tnext.ServeHTTP(w, r)\r\n\t})\r\n}\r\n\r\nfunc (s *Server) logging(next http.Handler) http.Handler {\r\n\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\r\n\t\tnext.ServeHTTP(w, r)\r\n\t})\r\n"]
[3101.062243, "o", "}\r\n"]
