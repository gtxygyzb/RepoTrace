[3270.506031, "o", "\u001b[35m\u001b[K./internal/server/router.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kmux\u001b[m\u001b[K.\u001b[01;31m\u001b[KHandleFunc\u001b[m\u001b[K(\"GET /api/v1/admin/audit\", s.Audit)\r\n\u001b[35m\u001b[K./internal/server/router.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kmux\u001b[m\u001b[K.\u001b[01;31m\u001b[KHandleFunc\u001b[m\u001b[K(\"GET /api/v1/admin/config\", s.GetConfig)\r\n\u001b[35m\u001b[K./internal/server/router.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kmux\u001b[m\u001b[K.\u001b[01;31m\u001b[KHandleFunc\u001b[m\u001b[K(\"POST /api/v1/admin/config\", s.UpdateConfig)\r\n\u001b[35m\u001b[K./internal/server/router.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kmux\u001b[m\u001b[K.\u001b[01;31m\u001b[KHandleFunc\u001b[m\u001b[K(\"POST /api/v1/webhooks\", s.RegisterWebhook)\r\n\u001b[35m\u001b[K./internal/server/router.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kmux\u001b[m\u001b[K.\u001b[01;31m\u001b[KHandleFunc\u001b[m\u001b[K(\"GET /api/v1/webhooks\", s.ListWebhooks)\r\n\u001b[35m\u001b[K./internal/server/router.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kmux\u001b[m\u001b[K.\u001b[01;31m\u001b[KHandleFu"]
[3270.506095, "o", "nc\u001b[m\u001b[K(\"DELETE /api/v1/webhooks/{id}\", s.DeleteWebhook)\r\n\u001b[35m\u001b[K./internal/server/router.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn s.securityHeaders(s.logging(s.bodyLimit(\u001b[01;31m\u001b[Kmux\u001b[m\u001b[K)))\r\n"]
