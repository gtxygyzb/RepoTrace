[3279.050783, "o", "package server\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"errors\"\r\n\t\"fmt\""]
[3279.050855, "o", "\r\n\t\"io\"\r\n\t\"net/http\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"mlgateway/internal/audit\"\r\n\t\"mlgateway/internal/auth\"\r\n\t\"mlgateway/internal/config\"\r\n\t\"mlgateway/internal/inference\"\r\n\t\"mlgateway/internal/metrics\"\r\n\t\"mlgateway/internal/registry\"\r\n\t\"mlgateway/internal/store\"\r\n"]
[3279.05095, "o", "\t\"mlgateway/internal/webhooks\"\r\n)\r\n\r\ntype Server struct {\r\n\tcfg       *config.Config\r\n\tstore     *store.Store\r\n\tauth      *auth.Service\r\n\tregistry  *registry.Service\r\n\tinference *inference.Service\r\n\tmetrics   *metrics.Service\r\n"]
[3279.051023, "o", "\taudit     *audit.Service\r\n\twebhooks  *webhooks.Service\r\n\tstartTime time.Time\r\n}\r\n\r\nfunc New(cfg *config.Config, st *store.Store, as *auth.Service, rs *registry.Service, is *inference.Service, ms *metrics.Service, aus *audit.Service, ws *webhooks.Service, startTime time.Time) *Server {\r\n\treturn &Server{\r\n\t\tcfg:       cfg,\r\n\t\tstore:     st,\r\n\t\tauth:      as,\r\n\t\tregistry:  rs,\r\n\t\tinference: is,\r\n"]
[3279.051095, "o", "\t\tmetrics:   ms,\r\n\t\taudit:     aus,\r\n\t\twebhooks:  ws,\r\n\t\tstartTime: startTime,\r\n\t}\r\n}\r\n\r\nfunc writeJSON(w http.ResponseWriter, status int, v interface{}) {\r\n\tw.Header().Set(\"Content-Type\", \"application/json\")\r\n\tw.WriteHeader(status)\r\n\t_ = json.NewEncoder(w).Encode(v)\r\n}\r\n\r\nfunc writeError(w http.ResponseWriter, status int, msg string) {\r\n\twriteJSON(w, status, map[string]string{\"error\": msg})\r\n}\r\n\r\nfunc writeBodyReadError(w http.ResponseWriter, err error) {\r\n\tvar maxBytesErr *http.MaxBytesError\r\n\tif errors.As(err, &maxBytesErr) {\r\n"]
[3279.051234, "o", "\t\twriteError(w, http.StatusRequestEntityTooLarge, \"request body too large\")\r\n\t\treturn\r\n\t}\r\n\twriteError(w, http.StatusBadRequest, \"invalid request body\")\r\n}\r\n\r\nfunc writeMultipartError(w http.ResponseWriter, err error) {\r\n\tvar maxBytesErr *http.MaxBytesError\r\n\tif errors.As(err, &maxBytesErr) {\r\n\t\twriteError(w, http.StatusRequestEntityTooLarge, \"request body too large\")\r\n\t\treturn\r\n\t}\r\n\twriteError(w, http.StatusBadRequest, \"invalid multipart form: \"+err.Error())\r\n}\r\n\r\nfunc (s *Server) auditReq(r *http.Request, user, action, resourceType, resourceID, details string) {\r\n\ts.audit.Add(user, action, resourceType, resourceID, details, clientIP(r))\r\n}\r\n\r\nfunc clientIP(r *http.Request) string {\r\n\tif ip := r.Header.Get(\"X-Forwarded-For\"); ip != \"\" {\r\n\t\treturn strings.Split(ip, \",\")[0]\r\n\t}\r\n"]
[3279.051301, "o", "\treturn r.RemoteAddr\r\n}\r\n\r\nfunc (s *Server) Health(w http.ResponseWriter, r *http.Request) {\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\t\t\"status\":         \"healthy\",\r\n\t\t\"uptime_seconds\": int64(time.Since(s.startTime).Seconds()),\r\n\t})\r\n}\r\n\r\nfunc (s *Server) RegisterUser(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tUsername string `json:\"username\"`\r\n"]
[3279.05135, "o", "\t\tPassword string `json:\"password\"`\r\n\t\tRole     string `json:\"role\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteBodyReadError(w, err)\r\n\t\treturn\r\n\t}\r\n\r\n"]
[3279.05139, "o", "\tcallerRole := \"\"\r\n\tif user, ok := s.authFromRequest(r); ok {\r\n\t\tcallerRole = user.Role\r\n\t}\r\n\r\n\tuser, err := s.auth.Register(req.Username, req.Password, req.Role, callerRole)\r\n\t"]
[3279.051443, "o", "if err != nil {\r\n\t\tswitch {\r\n\t\tcase errors.Is(err, auth.ErrForbidden):\r\n\t\t\twriteError(w, http.StatusForbidden, err.Error())\r\n\t\tcase errors.Is(err, auth.ErrInvalidRole), strings.Contains(err.Error(), \"required\"):\r\n\t\t\twriteError(w, http.StatusBadRequest, err.Error())\r\n\t\tcase errors.Is(err, auth.ErrUsernameExists):\r\n\t\t\twriteError(w, http.StatusConflict, err.Error())\r\n"]
[3279.051482, "o", "\t\tdefault:\r\n\t\t\twriteError(w, http.StatusBadRequest, err.Error())\r\n\t\t}\r\n\t\treturn\r\n\t}\r\n\r\n"]
[3279.051522, "o", "\ts.auditReq(r, user.Username, \"user.register\", \"user\", user.ID, \"role=\"+user.Role)\r\n\twriteJSON(w, http.StatusCreated, map[string]interface{}{\r\n\t\t\"id\":       user.ID,\r\n\t\t\"username\": user.Username,\r\n\t\t\"role\":     user.Role,\r\n"]
[3279.051564, "o", "\t\t\"api_key\":  user.APIKey,\r\n\t})\r\n}\r\n\r\nfunc (s *Server) Login(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tUsername string `json:\"username\"`\r\n\t\tPassword string `json:\"password\"`\r\n"]
[3279.051605, "o", "\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteBodyReadError(w, err)\r\n\t\treturn\r\n\t}\r\n\r\n\tapiKey, role, err := s.auth.Login(req.Username, req.Password)\r\n"]
[3279.051646, "o", "\tif err != nil {\r\n\t\twriteError(w, http.StatusUnauthorized, \"invalid credentials\")\r\n\t\treturn\r\n\t}\r\n\r\n\ts.auditReq(r, req.Username, \"user.login\", \"user\", req.Username, \"\")\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"api_key\": apiKey, \"role\": role})\r\n}\r\n"]
[3279.051684, "o", "\r\nfunc (s *Server) authFromRequest(r *http.Request) (*store.User, bool) {\r\n\tauthHeader := r.Header.Get(\"Authorization\")\r\n\tif !strings.HasPrefix(authHeader, \"Bearer \") {\r\n\t\treturn nil, false\r\n\t}\r\n\t"]
[3279.051725, "o", "token := strings.TrimPrefix(authHeader, \"Bearer \")\r\n\treturn s.auth.Authenticate(token)\r\n}\r\n\r\nfunc (s *Server) RegisterModel(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.authFromRequest(r)\r\n\tif !ok {\r\n"]
[3279.051766, "o", "\t\twriteError(w, http.StatusUnauthorized, \"unauthorized\")\r\n\t\treturn\r\n\t}\r\n\tif !auth.CanAccess(user.Role, auth.RoleDeployer) {\r\n\t\twriteError(w, http.StatusForbidden, \"insufficient role\")\r\n\t\treturn\r\n\t}\r\n\r\n"]
[3279.051806, "o", "\tvar m store.Model\r\n\tif err := json.NewDecoder(r.Body).Decode(&m); err != nil {\r\n\t\twriteBodyReadError(w, err)\r\n\t\treturn\r\n\t}\r\n\r\n"]
[3279.051847, "o", "\tcreated, err := s.registry.Register(&m)\r\n\tif err != nil {\r\n\t\ts.writeRegistryError(w, err)\r\n\t\treturn\r\n\t}\r\n\r\n\ts.auditReq(r, user.Username, \"model.register\", \"model\", created.ID, \"name=\"+created.Name)\r\n"]
[3279.051891, "o", "\ts.webhooks.Fire(\"model.created\", created)\r\n\twriteJSON(w, http.StatusCreated, created)\r\n}\r\n\r\nfunc (s *Server) writeRegistryError(w http.ResponseWriter, err error) {\r\n\tswitch {\r\n\tcase errors.Is(err, registry.ErrValidation):\r\n\t\twriteError(w, http.StatusBadRequest, err.Error())\r\n"]
[3279.051931, "o", "\tcase errors.Is(err, registry.ErrConflict):\r\n\t\twriteError(w, http.StatusConflict, err.Error())\r\n\tcase errors.Is(err, registry.ErrNotFound):\r\n\t\twriteError(w, http.StatusNotFound, err.Error())\r\n\tcase errors.Is(err, registry.ErrTooLarge):\r\n\t\twriteError(w, http.StatusRequestEntityTooLarge, err.Error())\r\n\t"]
[3279.051979, "o", "default:\r\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\r\n\t}\r\n}\r\n\r\nfunc (s *Server) ListModels(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\r\n\t\treturn\r\n\t}"]
