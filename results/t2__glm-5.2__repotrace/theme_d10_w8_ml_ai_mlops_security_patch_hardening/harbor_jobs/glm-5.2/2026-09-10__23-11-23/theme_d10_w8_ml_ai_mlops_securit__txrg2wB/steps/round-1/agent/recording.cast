[4247.448061, "o", "\u001b[?2004h> "]
[4247.448341, "o", "\\t\\t_, size := utf8.DecodeRuneInString(details[i:])\r\n\u001b[?2004l\r"]
[4247.448405, "o", "\u001b[?2004h> "]
[4247.448512, "o", "\\t\\tif size == 0 {\r\n\u001b[?2004l\r"]
[4247.448575, "o", "\u001b[?2004h> "]
