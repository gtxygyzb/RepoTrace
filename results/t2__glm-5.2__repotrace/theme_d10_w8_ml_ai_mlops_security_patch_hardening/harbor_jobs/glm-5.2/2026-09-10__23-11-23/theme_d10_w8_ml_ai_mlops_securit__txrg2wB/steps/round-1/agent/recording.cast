[4124.58565, "o", "package audit\r\n\r\nimport (\r\n\t\"mlgateway/internal/store\"\r\n\t\"time\"\r\n\t\"unicode/utf8\"\r\n)\r\n\r\n"]
[4124.585722, "o", "type Service struct {\r\n\tstore *store.Store\r\n}\r\n\r\nfunc New(s *store.Store) *Service {\r\n\treturn &Service{store: s}\r\n}\r\n\r\nfunc (s *Service) Add(user, action, resourceType, resourceID, details, sourceIP string) {\r\n\t_ = s.store.WithLock(func(d *store.Data) error {\r\n\t\td.Audit = append(d.Audit, store.AuditEntry{\r\n\t\t\tTimestamp:    time.Now().UTC(),\r\n\t\t\t"]
[4124.585787, "o", "User:         user,\r\n\t\t\tAction:       action,\r\n\t\t\tResourceType: resourceType,\r\n\t\t\tResourceID:   resourceID,\r\n\t\t\tDetails:      sanitizeDetail(details),\r\n\t\t\tSourceIP:     sourceIP,\r\n\t\t})\r\n\t\tif len(d.Audit) > 1000 {\r\n\t\t\td.Audit = d.Audit[len(d.Audit)-1000:]\r\n"]
[4124.585854, "o", "\t\t}\r\n\t\treturn nil\r\n\t})\r\n}\r\n\r\nfunc sanitizeDetail(details string) string {\r\n\tcleaned := make([]byte, 0, len(details))\r\n\tfor i := 0; i < len(details); i++ {\r\n\t\tif details[i] < 0x20 {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[4124.58592, "o", "\t\tcleaned = append(cleaned, details[i])\r\n\t}\r\n\r\n\tconst maxRunes = 256\r\n\tvar n int\r\n\tfor i := 0; i < len(cleaned); {\r\n\t\t_, size := utf8.DecodeRune(cleaned[i:])\r\n\t\tif size == 0 {\r\n\t\t\tbreak\r\n\t\t"]
[4124.58598, "o", "}\r\n\t\tn++\r\n\t\tif n == maxRunes && i+size < len(cleaned) {\r\n\t\t\treturn string(cleaned[:i+size]) + \"...[truncated]\"\r\n\t\t}\r\n\t\ti += size\r\n\t}\r\n\treturn string(cleaned)\r\n}\r\n"]
[4124.586038, "o", "\r\nfunc (s *Service) List() []store.AuditEntry {\r\n\tvar entries []store.AuditEntry\r\n\t_ = s.store.WithRLock(func(d *store.Data) error {\r\n\t\tentries = make([]store.AuditEntry, len(d.Audit))\r\n\t\tcopy(entries, d.Audit)\r\n\t\treturn nil\r\n\t})\r\n\t"]
[4124.586094, "o", "return entries\r\n}\r\n"]
