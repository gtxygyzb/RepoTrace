[1401.185856, "o", "func (s *Service) UploadVersion(id, version, releaseNotes string, reader io.Reader) (*store.Version, error) {\r\n\u001b[?2004l\r"]
[1401.185919, "o", "\u001b[?2004h> "]
[1401.186128, "o", "    if err := ValidateSemver(version); err != nil {\r\n\u001b[?2004l\r"]
[1401.186186, "o", "\u001b[?2004h> "]
[1401.186261, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1401.186318, "o", "\u001b[?2004h> "]
[1401.186374, "o", "    }\r\n\u001b[?2004l\ro\u001b[?2004h> \r\n\u001b[?2004l\ry"]
[1401.18643, "o", "\u001b[?2004h> "]
[1401.186664, "o", "    dir := filepath.Join(s.modelStorageDir, id, version)\r\n\u001b[?2004l\r"]
[1401.18672, "o", "\u001b[?2004h> "]
[1401.186931, "o", "    if err := os.MkdirAll(dir, 0755); err != nil {\r\n\u001b[?2004l\r"]
[1401.186987, "o", "\u001b[?2004h> "]
[1401.187069, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1401.187137, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1401.187192, "o", "\u001b[?2004h> "]
[1401.187399, "o", "    binaryPath := filepath.Join(dir, \"model.bin\")\r\n\u001b[?2004l\r"]
[1401.187454, "o", "\u001b[?2004h> "]
[1401.187599, "o", "    tmpPath := binaryPath + \".tmp\"\r\n\u001b[?2004l\r"]
[1401.187654, "o", "\u001b[?2004h> "]
[1401.187799, "o", "    f, err := os.Create(tmpPath)\r\n\u001b[?2004l\r"]
[1401.187859, "o", "\u001b[?2004h> "]
[1401.187942, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1401.187996, "o", "\u001b[?2004h> "]
[1401.188084, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1401.188152, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1401.188208, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1401.188263, "o", "> "]
[1401.188472, "o", "    limited := io.LimitReader(reader, s.maxModelSize+1)\r\n\u001b[?2004l\r"]
[1401.188529, "o", "\u001b[?2004h> "]
[1401.188668, "o", "    n, err := io.Copy(f, limited)\r\n\u001b[?2004l\r"]
[1401.188724, "o", "\u001b[?2004h> "]
[1401.188784, "o", "    f.Close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.188903, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1401.188957, "o", "\u001b[?2004h> "]
[1401.189076, "o", "        _ = os.Remove(tmpPath)\r\n\u001b[?2004l\r"]
[1401.18915, "o", "\u001b[?2004h> "]
[1401.189221, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1401.189276, "o", "\u001b[?2004h> "]
[1401.189331, "o", "    }\r\n\u001b[?2004l\r \u001b[?2004h> "]
[1401.189461, "o", "    if n > s.maxModelSize {\r\n\u001b[?2004l\r"]
[1401.189517, "o", "\u001b[?2004h> "]
[1401.189636, "o", "        _ = os.Remove(tmpPath)\r\n\u001b[?2004l\r"]
[1401.18969, "o", "\u001b[?2004h> "]
[1401.189823, "o", "        return nil, ErrTooLarge\r\n\u001b[?2004l\r"]
[1401.189878, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1401.189945, "o", "\u001b[?2004h> "]
[1401.190184, "o", "    if err := os.Chmod(tmpPath, 0755); err != nil {\r\n\u001b[?2004l\r"]
[1401.190242, "o", "\u001b[?2004h> "]
[1401.190355, "o", "        _ = os.Remove(tmpPath)\r\n\u001b[?2004l\r"]
[1401.190411, "o", "\u001b[?2004h> "]
[1401.190487, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1401.190543, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1401.190599, "o", "\u001b[?2004h> "]
[1401.190777, "o", "    if err := os.Rename(tmpPath, binaryPath); err != nil {\r\n\u001b[?2004l\r"]
[1401.190834, "o", "\u001b[?2004h> "]
