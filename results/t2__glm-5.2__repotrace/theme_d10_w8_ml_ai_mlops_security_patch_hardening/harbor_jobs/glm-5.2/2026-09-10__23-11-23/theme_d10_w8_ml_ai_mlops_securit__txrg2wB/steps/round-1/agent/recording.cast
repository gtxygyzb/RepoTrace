[3186.377069, "o", "     1\tpackage server\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"net/http\"\r\n     5\t\t\"strings\"\r\n     6\t)\r\n     7"]
[3186.377178, "o", "\t\r\n     8\tfunc (s *Server) Routes() http.Handler {\r\n     9\t\tmux := http.NewServeMux()\r\n    10\t\r\n    11\t\tmux.HandleFunc(\"GET /api/v1/health\", s.Health)\r\n    12\t\r\n    13\t\tmux.HandleFunc(\"POST /api/v1/auth/register\", s.RegisterUser)\r\n    14\t\tmux.HandleFunc(\"POST /api/v1/auth/login\", s.Login)\r\n    15\t\r\n    16\t\tmux.HandleFunc(\"POST /api/v1/models\", s.RegisterModel)\r\n    17\t\tmux.HandleFunc(\"GET /api/v1/models\", s.ListModels)\r\n    18\t\tmux.HandleFunc(\"GET /api/v1/models/{id}\", s.GetModel)\r\n    19\t\tmux.HandleFunc(\"DELETE /api/v1/models/{id}\", s.DeleteModel)\r\n    20\t\tmux.HandleFunc(\"POST /api/v1/models/{id}/versions\", s.UploadVersion)\r\n"]
[3186.377266, "o", "    21\t\tmux.HandleFunc(\"GET /api/v1/models/{id}/versions\", s.ListVersions)\r\n    22\t\tmux.HandleFunc(\"GET /api/v1/models/{id}/versions/{version}/download\", s.DownloadVersion)\r\n    23\t\tmux.HandleFunc(\"POST /api/v1/models/{id}/versions/{version}/deploy\", s.DeployVersion)\r\n    24\t\tmux.HandleFunc(\"POST /api/v1/models/{id}/versions/{version}/undeploy\", s.UndeployVersion)\r\n    25\t\r\n    26\t\tmux.HandleFunc(\"POST /api/v1/infer/{model_name}\", s.Infer)\r\n    27\t\tmux.HandleFunc(\"POST /api/v1/infer/{model_name}/batch\", s.InferBatch)\r\n    28\t\r\n    29\t\tmux.HandleFunc(\"GET /api/v1/admin/metrics\", s.Metrics)\r\n    30\t\tmux.HandleFunc(\"GET /api/v1/admin/audit\", s.Audit)\r\n    31\t\tmux.HandleFunc(\"GET /api/v1/admin/config\", s.GetConfig)\r\n"]
[3186.377344, "o", "    32\t\tmux.HandleFunc(\"POST /api/v1/admin/config\", s.UpdateConfig)\r\n    33\t\r\n    34\t\tmux.HandleFunc(\"POST /api/v1/webhooks\", s.RegisterWebhook)\r\n    35\t\tmux.HandleFunc(\"GET /api/v1/webhooks\", s.ListWebhooks)\r\n    36\t\tmux.HandleFunc(\"DELETE /api/v1/webhooks/{id}\", s.DeleteWebhook)\r\n    37\t\r\n    38\t\treturn s.securityHeaders(s.logging(s.bodyLimit(mux)))\r\n    39\t}\r\n    40\t\r\n    41\tfunc (s *Server) bodyLimit(next http.Handler) http.Handler {\r\n    42\t\t"]
[3186.377456, "o", "const defaultMaxBodyBytes int64 = 10 * 1024 * 1024\r\n    43\t\r\n    44\t\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\r\n    45\t\t\tif r.Body != nil {\r\n    46\t\t\t\tlimit := defaultMaxBodyBytes\r\n    47\t\t\t\tif r.Method == http.MethodPost && strings.HasPrefix(r.URL.Path, \"/api/v1/models/\") && strings.HasSuffix(r.URL.Path, \"/versions\") {\r\n    48\t\t\t\t\tlimit = int64(s.cfg.MaxModelSizeMB) * 1024 * 1024\r\n    49\t\t\t\t}\r\n    50\t\t\t\tr.Body = http.MaxBytesReader(w, r.Body, limit)\r\n    51\t\t\t}\r\n    52\t\t\tnext.ServeHTTP(w, r)\r\n    53\t\t})\r\n    54\t}\r\n    55\t\r\n"]
[3186.377524, "o", "    56\tfunc (s *Server) logging(next http.Handler) http.Handler {\r\n    57\t\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\r\n    58\t\t\tnext.ServeHTTP(w, r)\r\n    59\t\t})\r\n    60\t}\r\n    61\t\r\n    62\tfunc (s *Server) securityHeaders(next http.Handler) http.Handler {\r\n    63\t\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\r\n"]
[3186.377585, "o", "    64\t\t\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\r\n    65\t\t\tw.Header().Set(\"X-Frame-Options\", \"DENY\")\r\n    66\t\t\tw.Header().Set(\"Strict-Transport-Security\", \"max-age=63072000; includeSubDomains\")\r\n    67\t\t\tif strings.HasPrefix(r.URL.Path, \"/api/v1/auth/\") || strings.HasPrefix(r.URL.Path, \"/api/v1/admin/\") {\r\n    68\t\t\t\tw.Header().Set(\"Cache-Control\", \"no-store\")\r\n    69\t\t\t}\r\n    70\t\t\tnext.ServeHTTP(w, r)\r\n    71\t\t})\r\n    72\t"]
[3186.377648, "o", "}\r\n"]
