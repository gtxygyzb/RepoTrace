[1761.088247, "o", "func (s *Server) UpdateConfig(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[1761.088302, "o", "\u001b[?2004h> "]
[1761.088483, "o", "    user, ok := s.requireAuth(w, r, auth.RoleAdmin)\r\n\u001b[?2004l\r"]
[1761.088538, "o", "\u001b[?2004h> "]
[1761.088593, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.08867, "o", "        return\r\n\u001b[?2004l\r"]
[1761.088726, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1761.08878, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1761.088841, "o", "\u001b[?2004h> "]
[1761.088955, "o", "    var patch map[string]interface{}\r\n\u001b[?2004l\r"]
[1761.08901, "o", "\u001b[?2004h> "]
[1761.089249, "o", "    if err := json.NewDecoder(r.Body).Decode(&patch); err != nil {\r\n\u001b[?2004l\r"]
[1761.089309, "o", "\u001b[?2004h> "]
[1761.089545, "o", "        writeError(w, http.StatusBadRequest, \"invalid request body\")\r\n\u001b[?2004l\r"]
[1761.089601, "o", "\u001b[?2004h> "]
[1761.089663, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.089723, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.089779, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.089852, "o", "    cfg := *s.cfg\r\n\u001b[?2004l\r"]
[1761.089907, "o", "\u001b[?2004h> "]
[1761.090045, "o", "    if v, ok := patch[\"port\"]; ok {\r\n\u001b[?2004l\r"]
[1761.090137, "o", "\u001b[?2004h> "]
[1761.090291, "o", "        if f, ok := v.(float64); ok {\r\n\u001b[?2004l\r"]
[1761.090379, "o", "\u001b[?2004h> "]
[1761.090454, "o", "            cfg.Port = int(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.090525, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.09058, "o", ">     }\r\n\u001b[?2004l\r"]
[1761.090642, "o", "\u001b[?2004h> "]
[1761.090825, "o", "    if v, ok := patch[\"inference_timeout_sec\"]; ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.090904, "o", "> "]
[1761.091007, "o", "        if f, ok := v.(float64); ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.091088, "o", "> "]
[1761.091223, "o", "            cfg.InferenceTimeoutSec = int(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.091288, "o", ">         }\r\n\u001b[?2004l\r"]
[1761.091344, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1761.0914, "o", "\u001b[?2004h> "]
[1761.091559, "o", "    if v, ok := patch[\"max_batch_size\"]; ok {\r\n\u001b[?2004l\r"]
[1761.091614, "o", "\u001b[?2004h> "]
[1761.091743, "o", "        if f, ok := v.(float64); ok {\r\n\u001b[?2004l\r"]
[1761.091821, "o", "\u001b[?2004h> "]
[1761.091948, "o", "            cfg.MaxBatchSize = int(f)\r\n\u001b[?2004l\r"]
[1761.092004, "o", "\u001b[?2004h> "]
[1761.092061, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.092131, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.092294, "o", "    if v, ok := patch[\"log_level\"]; ok {\r\n\u001b[?2004l\r"]
[1761.092376, "o", "\u001b[?2004h> "]
[1761.092522, "o", "        if s, ok := v.(string); ok {\r\n\u001b[?2004l\r"]
[1761.092601, "o", "\u001b[?2004h> "]
[1761.092682, "o", "            cfg.LogLevel = s\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.092763, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.09284, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.093055, "o", "    if v, ok := patch[\"webhook_timeout_sec\"]; ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.093147, "o", "> "]
[1761.093247, "o", "        if f, ok := v.(float64); ok {\r\n\u001b[?2004l\r"]
[1761.093314, "o", "\u001b[?2004h> "]
[1761.093454, "o", "            cfg.WebhookTimeoutSec = int(f)\r\n\u001b[?2004l\r"]
[1761.093515, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1761.093578, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1761.093623, "o", "\u001b[?2004h> "]
[1761.093829, "o", "    if v, ok := patch[\"metrics_retention_hours\"]; ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.093884, "o", "> "]
[1761.093956, "o", "        if f, ok := v.(float64); ok {\r\n\u001b[?2004l\r"]
[1761.094011, "o", "\u001b[?2004h> "]
[1761.094126, "o", "            cfg.MetricsRetentionHours = int(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.094183, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.094245, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.09438, "o", "    if v, ok := patch[\"max_model_size_mb\"]; ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.094434, "o", "> "]
[1761.094511, "o", "        if f, ok := v.(float64); ok {\r\n\u001b[?2004l\r"]
[1761.094566, "o", "\u001b[?2004h> "]
[1761.094643, "o", "            cfg.MaxModelSizeMB = int(f)\r\n\u001b[?2004l\r"]
[1761.094698, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1761.094755, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.094809, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.095007, "o", "    if err := config.Save(s.cfg.DataDir+\"/config.json\", &cfg); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.095062, "o", "> "]
[1761.095222, "o", "        writeError(w, http.StatusInternalServerError, err.Error())\r\n\u001b[?2004l\r"]
[1761.095283, "o", "\u001b[?2004h>         return\r\n\u001b[?2004l\r"]
[1761.095338, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1761.095401, "o", "\u001b[?2004h>     *s.cfg = cfg\r\n\u001b[?2004l\r"]
[1761.095472, "o", "\u001b[?2004h> "]
[1761.095658, "o", "    s.auditReq(r, user.Username, \"config.update\", \"config\", \"config\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.095715, "o", "> "]
[1761.095789, "o", "    writeJSON(w, http.StatusOK, s.cfg)\r\n\u001b[?2004l\r"]
[1761.095844, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1761.0959, "o", "\u001b[?2004h> "]
[1761.096197, "o", "func (s *Server) requireAuth(w http.ResponseWriter, r *http.Request, requiredRole string) (*store.User, bool) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.096254, "o", "> "]
[1761.096327, "o", "    user, ok := s.authFromRequest(r)\r\n\u001b[?2004l\r"]
[1761.096382, "o", "\u001b[?2004h>     if !ok {\r\n\u001b[?2004l\r"]
[1761.096437, "o", "\u001b[?2004h> "]
[1761.09658, "o", "        writeError(w, http.StatusUnauthorized, \"unauthorized\")\r\n\u001b[?2004l\r"]
[1761.096635, "o", "\u001b[?2004h> "]
[1761.096686, "o", "        return nil, false\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.096742, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.096893, "o", "    if !auth.CanAccess(user.Role, requiredRole) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.096948, "o", "> "]
[1761.097095, "o", "        writeError(w, http.StatusForbidden, \"insufficient role\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.097167, "o", "> "]
[1761.097223, "o", "        return nil, false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.097277, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.097333, "o", "    return user, true\r\n\u001b[?2004l\r"]
[1761.097388, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.097442, "o", "EOF\r\n\u001b[?2004l\r"]
[1761.100194, "o", "\u001b[?2004hroot@n30009:/app# "]
[1761.470012, "i", "cat > internal/server/router.go <<'EOF'\npackage server\n\nimport (\n    \"net/http\"\n)\n\nfunc (s *Server) Routes() http.Handler {\n    mux := http.NewServeMux()\n\n    mux.HandleFunc(\"GET /api/v1/health\", s.Health)\n\n    mux.HandleFunc(\"POST /api/v1/auth/register\", s.RegisterUser)\n    mux.HandleFunc(\"POST /api/v1/auth/login\", s.Login)\n\n    mux.HandleFunc(\"POST /api/v1/models\", s.RegisterModel)\n    mux.HandleFunc(\"GET /api/v1/models\", s.ListModels)\n    mux.HandleFunc(\"GET /api/v1/models/{id}\", s.GetModel)\n    mux.HandleFunc(\"DELETE /api/v1/models/{id}\", s.DeleteModel)\n    mux.HandleFunc(\"POST /api/v1/models/{id}/versions\", s.UploadVersion)\n    mux.HandleFunc(\"GET /api/v1/models/{id}/versions\", s.ListVersions)\n    mux.HandleFunc(\"GET /api/v1/models/{id}/versions/{version}/download\", s.DownloadVersion)\n    mux.HandleFunc(\"POST /api/v1/models/{id}/versions/{version}/deploy\", s.DeployVersion)\n    mux.HandleFunc(\"POST /api/v1/models/{id}/versions/{version}/undeploy\", s.UndeployVersion)\n\n    mux.HandleFunc(\"POST /api/v1/infer"]
[1761.470287, "i", "/{model_name}\", s.Infer)\n    mux.HandleFunc(\"POST /api/v1/infer/{model_name}/batch\", s.InferBatch)\n\n    mux.HandleFunc(\"GET /api/v1/admin/metrics\", s.Metrics)\n    mux.HandleFunc(\"GET /api/v1/admin/audit\", s.Audit)\n    mux.HandleFunc(\"GET /api/v1/admin/config\", s.GetConfig)\n    mux.HandleFunc(\"POST /api/v1/admin/config\", s.UpdateConfig)\n\n    mux.HandleFunc(\"POST /api/v1/webhooks\", s.RegisterWebhook)\n    mux.HandleFunc(\"GET /api/v1/webhooks\", s.ListWebhooks)\n    mux.HandleFunc(\"DELETE /api/v1/webhooks/{id}\", s.DeleteWebhook)\n\n    return s.logging(mux)\n}\n\nfunc (s *Server) logging(next http.Handler) http.Handler {\n    return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n        next.ServeHTTP(w, r)\n    })\n}\nEOF\n"]
