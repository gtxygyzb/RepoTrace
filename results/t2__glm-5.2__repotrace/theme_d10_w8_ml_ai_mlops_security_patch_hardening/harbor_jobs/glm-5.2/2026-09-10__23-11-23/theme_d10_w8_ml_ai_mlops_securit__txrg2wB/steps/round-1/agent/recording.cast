[2759.224223, "o", "}\r\n}\r\n\r\nfunc (s *Server) ListModels(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\r\n\t\treturn\r\n\t}\r\n\r\n\tq := r.URL.Query()\r\n\tvar deployedFilter *bool\r\n\tif d := q.Get(\"deployed\"); d != \"\" {\r\n\t\tb, err := strconv.ParseBool(d)\r\n\t\tif err == nil {\r\n\t\t\tdeployedFilter = &b\r\n\t"]
[2759.224283, "o", "\t}\r\n\t}\r\n\r\n\tmodels := s.registry.List(q.Get(\"name\"), q.Get(\"framework\"), q.Get(\"label_key\"), q.Get(\"label_value\"), deployedFilter)\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\"models\": models})\r\n}\r\n\r\nfunc (s *Server) GetModel(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\r\n\t\treturn\r\n\t}\r\n"]
[2759.224341, "o", "\tid := r.PathValue(\"id\")\r\n\tmodel, err := s.registry.Get(id)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"model not found\")\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, model)\r\n}\r\n\r\n"]
