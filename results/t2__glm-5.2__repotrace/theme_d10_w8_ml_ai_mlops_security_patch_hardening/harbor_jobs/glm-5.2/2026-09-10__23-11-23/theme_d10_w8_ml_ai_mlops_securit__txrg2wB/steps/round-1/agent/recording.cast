[2297.677892, "i", "sed -n '1,620p' internal/server/handlers.go\n"]
[2297.678284, "o", "sed -n '1,620p' internal/server/handlers.go\r\n\u001b[?2004l\r"]
[2297.681138, "o", "package server\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"errors\"\r\n\t\"fmt\"\r\n\t\"io\""]
[2297.681262, "o", "\r\n\t\"net/http\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"mlgateway/internal/audit\"\r\n\t\"mlgateway/internal/auth\"\r\n\t\"mlgateway/internal/config\"\r\n\t\"mlgateway/internal/inference\"\r\n\t\"mlgateway/internal/metrics\"\r\n\t\"mlgateway/internal/registry\"\r\n\t\"mlgateway/internal/store\"\r\n\t\"mlgateway/internal/webhooks\"\r\n)\r\n\r\ntype Server struct {\r\n\tcfg       *config.Config\r\n\tstore     *store.Store\r\n\tauth      *auth.Service\r\n\tregistry  *registry.Service\r\n\tinference *inference.Service\r\n\t"]
[2297.681362, "o", "metrics   *metrics.Service\r\n\taudit     *audit.Service\r\n\twebhooks  *webhooks.Service\r\n\tstartTime time.Time\r\n}\r\n\r\nfunc New(cfg *config.Config, st *store.Store, as *auth.Service, rs *registry.Service, is *inference.Service, ms *metrics.Service, aus *audit.Service, ws *webhooks.Service, startTime time.Time) *Server {\r\n\treturn &Server{\r\n\t\tcfg:       cfg,\r\n\t\tstore:     st,\r\n\t\tauth:      as,\r\n\t\tregistry:  rs,\r\n\t\tinference: is,\r\n\t\tmetrics:   ms,\r\n\t\taudit:     aus,\r\n\t\twebhooks:  ws,\r\n\t\tstartTime: startTime,\r\n\t}\r\n"]
[2297.681463, "o", "}\r\n\r\nfunc writeJSON(w http.ResponseWriter, status int, v interface{}) {\r\n\tw.Header().Set(\"Content-Type\", \"application/json\")\r\n\tw.WriteHeader(status)\r\n\t_ = json.NewEncoder(w).Encode(v)\r\n}\r\n\r\nfunc writeError(w http.ResponseWriter, status int, msg string) {\r\n\twriteJSON(w, status, map[string]string{\"error\": msg})\r\n}\r\n\r\nfunc (s *Server) auditReq(r *http.Request, user, action, resourceType, resourceID, details string) {\r\n\ts.audit.Add(user, action, resourceType, resourceID, details, clientIP(r))\r\n}\r\n\r\nfunc clientIP(r *http.Request) string {\r\n\tif ip := r.Header.Get(\"X-Forwarded-For\"); ip != \"\" {\r\n\t\treturn strings.Split(ip, \",\")[0]\r\n\t}\r\n"]
[2297.681587, "o", "\treturn r.RemoteAddr\r\n}\r\n\r\nfunc (s *Server) Health(w http.ResponseWriter, r *http.Request) {\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\t\t\"status\":         \"healthy\",\r\n\t\t\"uptime_seconds\": int64(time.Since(s.startTime).Seconds()),\r\n\t})\r\n}\r\n\r\nfunc (s *Server) RegisterUser(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tUsername string `json:\"username\"`\r\n\t\tPassword string `json:\"password\"`\r\n\t\tRole     string `json:\"role\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body\")\r\n\t\treturn\r\n\t}\r\n"]
[2297.681687, "o", "\r\n\tcallerRole := \"\"\r\n\tif user, ok := s.authFromRequest(r); ok {\r\n\t\tcallerRole = user.Role\r\n\t}\r\n\r\n\tuser, err := s.auth.Register(req.Username, req.Password, req.Role, callerRole)\r\n\tif err != nil {\r\n\t\tswitch {\r\n\t\tcase errors.Is(err, auth.ErrForbidden):\r\n\t\t\twriteError(w, http.StatusForbidden, err.Error())\r\n\t\tcase errors.Is(err, auth.ErrInvalidRole), strings.Contains(err.Error(), \"required\"):\r\n\t\t\twriteError(w, http.StatusBadRequest, err.Error())\r\n\t\tcase errors.Is(err, auth.ErrUsernameExists):\r\n\t\t\twriteError(w, http.StatusConflict, err.Error())\r\n\t\tdefault:\r\n\t\t\twriteError(w, http.StatusBadRequest, err.Error())\r\n"]
[2297.681781, "o", "\t\t}\r\n\t\treturn\r\n\t}\r\n\r\n\ts.auditReq(r, user.Username, \"user.register\", \"user\", user.ID, \"role=\"+user.Role)\r\n\twriteJSON(w, http.StatusCreated, map[string]interface{}{\r\n\t\t\"id\":       user.ID,\r\n\t\t\"username\": user.Username,\r\n\t\t\"role\":     user.Role,\r\n\t\t\"api_key\":  user.APIKey,\r\n\t})\r\n}\r\n\r\nfunc (s *Server) Login(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tUsername string `json:\"username\"`\r\n"]
[2297.681874, "o", "\t\tPassword string `json:\"password\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body\")\r\n\t\treturn\r\n\t}\r\n\r\n\tapiKey, role, err := s.auth.Login(req.Username, req.Password)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusUnauthorized, \"invalid credentials\")\r\n\t\treturn\r\n\t}\r\n\r\n\ts.auditReq(r, req.Username, \"user.login\", \"user\", req.Username, \"\")\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"api_key\": apiKey, \"role\": role})\r\n}\r\n\r\n"]
[2297.681972, "o", "func (s *Server) authFromRequest(r *http.Request) (*store.User, bool) {\r\n\tauthHeader := r.Header.Get(\"Authorization\")\r\n\tif !strings.HasPrefix(authHeader, \"Bearer \") {\r\n\t\treturn nil, false\r\n\t}\r\n\ttoken := strings.TrimPrefix(authHeader, \"Bearer \")\r\n\treturn s.auth.Authenticate(token)\r\n}\r\n\r\nfunc (s *Server) RegisterModel(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.authFromRequest(r)\r\n"]
[2297.682075, "o", "\tif !ok {\r\n\t\twriteError(w, http.StatusUnauthorized, \"unauthorized\")\r\n\t\treturn\r\n\t}\r\n\tif !auth.CanAccess(user.Role, auth.RoleDeployer) {\r\n\t\twriteError(w, http.StatusForbidden, \"insufficient role\")\r\n\t\treturn\r\n\t}\r\n\r\n\tvar m store.Model\r\n\tif err := json.NewDecoder(r.Body).Decode(&m); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body\")\r\n\t\treturn\r\n\t}\r\n\r\n\tcreated, err := s.registry.Register(&m)\r\n\tif err != nil {\r\n\t\ts.writeRegistryError(w, err)\r\n\t\treturn\r\n\t}\r\n\r\n\ts.auditReq(r, user.Username, \"model.register\", \"model\", created.ID, \"name=\"+created.Name)\r\n\ts.webhooks.Fire(\"model.created\", created)\r\n\twriteJSON(w, http.StatusCreated, created)\r\n}\r\n\r\n"]
[2297.682193, "o", "func (s *Server) writeRegistryError(w http.ResponseWriter, err error) {\r\n\tswitch {\r\n\tcase errors.Is(err, registry.ErrValidation):\r\n\t\twriteError(w, http.StatusBadRequest, err.Error())\r\n\tcase errors.Is(err, registry.ErrConflict):\r\n\t\twriteError(w, http.StatusConflict, err.Error())\r\n\tcase errors.Is(err, registry.ErrNotFound):\r\n\t\twriteError(w, http.StatusNotFound, err.Error())\r\n\tcase errors.Is(err, registry.ErrTooLarge):\r\n\t\twriteError(w, http.StatusRequestEntityTooLarge, err.Error())\r\n\tdefault:\r\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\r\n\t}\r\n}\r\n\r\nfunc (s *Server) ListModels(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\r\n\t\treturn\r\n\t}\r\n\r\n\t"]
[2297.682296, "o", "q := r.URL.Query()\r\n\tvar deployedFilter *bool\r\n\tif d := q.Get(\"deployed\"); d != \"\" {\r\n\t\tb, err := strconv.ParseBool(d)\r\n\t\tif err == nil {\r\n\t\t\tdeployedFilter = &b\r\n\t\t}\r\n\t}\r\n\r\n\tmodels := s.registry.List(q.Get(\"name\"), q.Get(\"framework\"), q.Get(\"label_key\"), q.Get(\"label_value\"), deployedFilter)\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\"models\": models})\r\n}\r\n\r\nfunc (s *Server) GetModel(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\r\n\t\treturn\r\n\t}\r\n\tid := r.PathValue(\"id\")\r\n"]
[2297.68239, "o", "\tmodel, err := s.registry.Get(id)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"model not found\")\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, model)\r\n}\r\n\r\nfunc (s *Server) DeleteModel(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tid := r.PathValue(\"id\")\r\n\tmodel, err := s.registry.Get(id)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"model not found\")\r\n\t\treturn"]
[2297.682488, "o", "\r\n\t}\r\n\tif err := s.registry.Delete(id); err != nil {\r\n\t\tif errors.Is(err, registry.ErrConflict) {\r\n\t\t\twriteError(w, http.StatusConflict, err.Error())\r\n\t\t} else {\r\n\t\t\twriteError(w, http.StatusInternalServerError, err.Error())\r\n\t\t}\r\n\t\treturn\r\n\t}\r\n\ts.auditReq(r, user.Username, \"model.delete\", \"model\", id, \"name=\"+model.Name)\r\n\ts.webhooks.Fire(\"model.deleted\", model)\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n}\r\n\r\nfunc (s *Server) UploadVersion(w http.ResponseWriter, r *http.Request) {\r\n\t"]
[2297.682583, "o", "user, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tid := r.PathValue(\"id\")\r\n\r\n\tif err := r.ParseMultipartForm(int64(s.cfg.MaxModelSizeMB) * 1024 * 1024); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid multipart form: \"+err.Error())\r\n\t\treturn\r\n\t}\r\n\r\n"]
[2297.682686, "o", "\tversion := r.FormValue(\"version\")\r\n\treleaseNotes := r.FormValue(\"release_notes\")\r\n\tfile, _, err := r.FormFile(\"binary\")\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"binary file is required\")\r\n\t\treturn\r\n\t}\r\n\tdefer file.Close()\r\n\r\n\tv, err := s.registry.UploadVersion(id, version, releaseNotes, file)\r\n\tif err != nil {\r\n\t\ts.writeRegistryError(w, err)\r\n\t\treturn\r\n\t}\r\n\r\n\ts.auditReq(r, user.Username, \"version.upload\", \"model\", id, \"version=\"+v.Version)\r\n\ts.webhooks.Fire(\"version.uploaded\", map[string]interface{}{\"model_id\": id, \"version\": v})\r\n\twriteJSON(w, http.StatusCreated, v)\r\n}\r\n\r\nfunc (s *Server) ListVersions(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\r\n"]
[2297.682779, "o", "\t\treturn\r\n\t}\r\n\tid := r.PathValue(\"id\")\r\n\tversions, err := s.registry.ListVersions(id)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"model not found\")\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\"versions\": versions})\r\n}\r\n"]
[2297.682879, "o", "\r\nfunc (s *Server) DownloadVersion(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\r\n\t\treturn\r\n\t}\r\n\tid := r.PathValue(\"id\")\r\n\tversion := r.PathValue(\"version\")\r\n\tv, err := s.registry.GetVersion(id, version)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"version not found\")\r\n\t\treturn\r\n\t}\r\n\r\n\tw.Header().Set(\"Content-Disposition\", fmt.Sprintf(\"attachment; filename=model-%s.bin\", version))\r\n\tw.Header().Set(\"Content-Type\", \"application/octet-stream\")\r\n\thttp.ServeFile(w, r, v.BinaryPath)\r\n}\r\n\r\nfunc (s *Server) DeployVersion(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tid := r.PathValue(\"id\")\r\n\tversion := r.PathValue(\"version\")\r\n"]
[2297.682975, "o", "\tv, err := s.registry.DeployVersion(id, version)\r\n\tif err != nil {\r\n\t\ts.writeRegistryError(w, err)\r\n\t\treturn\r\n\t}\r\n\ts.auditReq(r, user.Username, \"version.deploy\", \"model\", id, \"version=\"+version)\r\n\ts.webhooks.Fire(\"version.deployed\", map[string]interface{}{\"model_id\": id, \"version\": v})\r\n\twriteJSON(w, http.StatusOK, v)\r\n}\r\n\r\nfunc (s *Server) UndeployVersion(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tid := r.PathValue(\"id\")\r\n\tversion := r.PathValue(\"version\")\r\n\tv, err := s.registry.UndeployVersion(id, version)\r\n\tif err != nil {\r\n"]
[2297.683073, "o", "\t\ts.writeRegistryError(w, err)\r\n\t\treturn\r\n\t}\r\n\ts.auditReq(r, user.Username, \"version.undeploy\", \"model\", id, \"version=\"+version)\r\n\ts.webhooks.Fire(\"version.undeployed\", map[string]interface{}{\"model_id\": id, \"version\": v})\r\n\twriteJSON(w, http.StatusOK, v)\r\n}\r\n\r\nfunc (s *Server) Infer(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tmodelName := r.PathValue(\"model_name\")\r\n\r\n\tbody, err := io.ReadAll(r.Body)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body\")\r\n\t\treturn\r\n"]
[2297.683182, "o", "\t}\r\n\r\n\tresult, model, version, latency, err := s.inference.Infer(modelName, body)\r\n\tif err != nil {\r\n\t\ts.metrics.RecordInference(modelName, latency, true)\r\n\t\ts.auditReq(r, user.Username, \"inference.error\", \"model\", modelName, err.Error())\r\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\r\n\t\treturn\r\n\t}\r\n\r\n\ts.metrics.RecordInference(modelName, latency, false)\r\n\tpayload := map[string]interface{}{\r\n\t\t\"model\":      model.Name,\r\n\t\t\"version\":    version.Version,\r\n\t\t\"latency_ms\": latency,\r\n\t\t\"timestamp\":  time.Now().UTC().Format(time.RFC3339),\r\n\t\t\"result\":     result,\r\n"]
[2297.683275, "o", "\t}\r\n\ts.webhooks.Fire(\"inference.completed\", payload)\r\n\twriteJSON(w, http.StatusOK, payload)\r\n}\r\n\r\nfunc (s *Server) InferBatch(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tmodelName := r.PathValue(\"model_name\")\r\n"]
[2297.683367, "o", "\r\n\tvar req struct {\r\n\t\tInputs []json.RawMessage `json:\"inputs\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body\")\r\n\t\treturn\r\n\t}\r\n\tif len(req.Inputs) == 0 {\r\n\t\twriteError(w, http.StatusBadRequest, \"inputs are required\")\r\n\t\treturn\r\n\t}\r\n\tif len(req.Inputs) > s.cfg.MaxBatchSize {\r\n\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"batch size exceeds max %d\", s.cfg.MaxBatchSize))\r\n\t\treturn\r\n\t}\r\n\r\n\tresults := make([]interface{}, 0, len(req.Inputs))\r\n\terrorsList := []string{}\r\n\tvar modelNameResolved, versionResolved string\r\n\r\n\tfor _, input := range req.Inputs {\r\n"]
