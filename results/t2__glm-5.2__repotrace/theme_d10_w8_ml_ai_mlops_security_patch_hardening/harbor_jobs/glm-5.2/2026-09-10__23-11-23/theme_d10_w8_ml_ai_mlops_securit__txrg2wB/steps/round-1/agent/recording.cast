[2622.71247, "i", "sed -i 's/return s.logging(mux)/return s.logging(s.bodyLimit(mux))/' internal/server/router.go\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/server/handlers.go')\nlines = p.read_text().splitlines()\nfor i, line in enumerate(lines):\n    if 'writeError(w, http.StatusBadRequest, \"invalid request body\")' in line:\n        lines[i] = line.replace('writeError(w, http.StatusBadRequest, \"invalid request body\")', 'writeBodyReadError(w, err)')\n    if 'writeError(w, http.StatusBadRequest, \"invalid multipart form: \"+err.Error())' in line:\n        lines[i] = line.replace('writeError(w, http.StatusBadRequest, \"invalid multipart form: \"+err.Error())', 'writeMultipartError(w, err)')\nout = []\ni = 0\nwhile i < len(lines):\n    out.append(lines[i])\n    if lines[i].startswith('func writeError(w http.ResponseWriter, status int, msg string) {'):\n        i += 1\n        while i < len(lines):\n            out.append(lines[i])\n            if lines[i] == '}':\n                break\n            i += 1\n        out.append('')\n    "]
[2622.712767, "i", "    out.append('func writeBodyReadError(w http.ResponseWriter, err error) {')\n        out.append('    var maxBytesErr *http.MaxBytesError')\n        out.append('    if errors.As(err, &maxBytesErr) {')\n        out.append('        writeError(w, http.StatusRequestEntityTooLarge, \"request body too large\")')\n        out.append('        return')\n        out.append('    }')\n        out.append('    writeError(w, http.StatusBadRequest, \"invalid request body\")')\n        out.append('}')\n        out.append('')\n        out.append('func writeMultipartError(w http.ResponseWriter, err error) {')\n        out.append('    var maxBytesErr *http.MaxBytesError')\n        out.append('    if errors.As(err, &maxBytesErr) {')\n        out.append('        writeError(w, http.StatusRequestEntityTooLarge, \"request body too large\")')\n        out.append('        return')\n        out.append('    }')\n        out.append('    writeError(w, http.StatusBadRequest, \"invalid multipart form: \"+err.Error())')\n        out.append('}')\n    i += 1\np.write_t"]
[2622.712809, "i", "ext(chr(10).join(out) + chr(10))\nPY\ngofmt -w internal/server/router.go internal/server/handlers.go\ngo build ./...\ngo test ./...\n"]
[2622.713141, "o", "sed -i 's/return s.logging(mux)/return s.logging(s.bodyLimit(mux))/' internal/server/router.go\r\n"]
