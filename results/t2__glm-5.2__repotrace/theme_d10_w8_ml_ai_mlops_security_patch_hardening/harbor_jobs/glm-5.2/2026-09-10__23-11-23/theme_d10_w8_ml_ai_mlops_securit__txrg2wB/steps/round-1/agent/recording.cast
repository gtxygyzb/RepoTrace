[1840.036592, "o", "\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc hash\u001b[01;31m\u001b[KPassword\u001b[m\u001b[K(\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K string) (string, error) {\r\n\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Ksalt\u001b[m\u001b[K := make([]byte, 16)\r\n\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif _, err := rand.Read(\u001b[01;31m\u001b[Ksalt\u001b[m\u001b[K); err != nil {\r\n"]
[1840.036724, "o", "\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\th := \u001b[01;31m\u001b[Ksha256\u001b[m\u001b[K.Sum256(append(\u001b[01;31m\u001b[Ksalt\u001b[m\u001b[K, []byte(\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K)...))\r\n\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn hex.EncodeToString(\u001b[01;31m\u001b[Ksalt\u001b[m\u001b[K) + \":\" + hex.EncodeToString(h[:]), nil\r\n\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc verify\u001b[01;31m\u001b[KPassword\u001b[m\u001b[K(\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K, hash string) bool {\r\n"]
[1840.03684, "o", "\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\th := \u001b[01;31m\u001b[Ksha256\u001b[m\u001b[K.Sum256(append([]byte(parts[0]), []byte(\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K)...))\r\n\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (s *Service) Register(username, \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K, role, callerRole string) (*store.User, error) {\r\n\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif username == \"\" || \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K == \"\" {\r\n\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn nil, errors.New(\"username and \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K are required\")\r\n\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\thash, err := hash\u001b[01;31m\u001b[KPassword\u001b[m\u001b[K(\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K)\r\n\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KPassword\u001b[m\u001b[KHash: hash,\r\n\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b["]
[1840.036983, "o", "K104\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (s *Service) Login(username, \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K string) (string, string, error) {\r\n\u001b[35m\u001b[K./internal/auth/auth.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif u.Username == username && verify\u001b[01;31m\u001b[KPassword\u001b[m\u001b[K(\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K, u.\u001b[01;31m\u001b[KPassword\u001b[m\u001b[KHash) {\r\n\u001b[35m\u001b[K./internal/server/handlers.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KPassword\u001b[m\u001b[K string `json:\"\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\"`\r\n\u001b[35m\u001b[K./internal/server/handlers.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tuser, err := s.auth.Register(req.Username, req.\u001b[01;31m\u001b[KPassword\u001b[m\u001b[K, req.Role, callerRole)\r\n"]
[1840.037097, "o", "\u001b[35m\u001b[K./internal/server/handlers.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KPassword\u001b[m\u001b[K string `json:\"\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\"`\r\n\u001b[35m\u001b[K./internal/server/handlers.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tapiKey, role, err := s.auth.Login(req.Username, req.\u001b[01;31m\u001b[KPassword\u001b[m\u001b[K)\r\n"]
[1840.037322, "o", "\u001b[35m\u001b[K./internal/store/store.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KPassword\u001b[m\u001b[KHash string    `json:\"\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K_hash\"`\r\n"]
