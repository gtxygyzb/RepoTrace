[1761.087242, "o", "func (s *Server) GetConfig(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[1761.0873, "o", "\u001b[?2004h> "]
[1761.087499, "o", "    if _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\r\n\u001b[?2004l\r"]
[1761.087553, "o", "\u001b[?2004h> "]
