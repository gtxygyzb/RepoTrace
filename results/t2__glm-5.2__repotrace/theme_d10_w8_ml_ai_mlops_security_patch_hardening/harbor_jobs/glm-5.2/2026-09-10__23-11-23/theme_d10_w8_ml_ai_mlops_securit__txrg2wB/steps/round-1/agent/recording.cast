[2306.989627, "o", "     6\t\r\n     7\tfunc (s *Server) Routes() http.Handler {\r\n     8\t\tmux := http.NewServeMux()\r\n     9\t\r\n    10\t\tmux.HandleFunc(\"GET /api/v1/health\", s.Health)\r\n    11\t\r\n    12\t\tmux.HandleFunc(\"POST /api/v1/auth/register\", s.RegisterUser)\r\n    13\t\tmux.HandleFunc(\"POST /api/v1/auth/login\", s.Login)\r\n    14\t\r\n    15\t\tmux.HandleFunc(\"POST /api/v1/models\", s.RegisterModel)\r\n    16\t\tmux.HandleFunc(\"GET /api/v1/models\", s.ListModels)\r\n    17\t\tmux.HandleFunc(\"GET /api/v1/models/{id}\", s.GetModel)\r\n    18\t\tmux.HandleFunc(\"DELETE /api/v1/models/{id}\", s.DeleteModel)\r\n"]
[2306.989711, "o", "    19\t\tmux.HandleFunc(\"POST /api/v1/models/{id}/versions\", s.UploadVersion)\r\n    20\t\tmux.HandleFunc(\"GET /api/v1/models/{id}/versions\", s.ListVersions)\r\n    21\t\tmux.HandleFunc(\"GET /api/v1/models/{id}/versions/{version}/download\", s.DownloadVersion)\r\n    22\t\tmux.HandleFunc(\"POST /api/v1/models/{id}/versions/{version}/deploy\", s.DeployVersion)\r\n    23\t\tmux.HandleFunc(\"POST /api/v1/models/{id}/versions/{version}/undeploy\", s.UndeployVersion)\r\n    24\t\r\n    25\t\tmux.HandleFunc(\"POST /api/v1/infer/{model_name}\", s.Infer)\r\n    26\t\tmux.HandleFunc(\"POST /api/v1/infer/{model_name}/batch\", s.InferBatch)\r\n    27\t\r\n    28\t\tmux.HandleFunc(\"GET /api/v1/admin/metrics\", s.Metrics)\r\n    29\t\tmux.HandleFunc(\"GET /api/v1/admin/audit\", s.Audit)\r\n    30\t\tmux.HandleFunc(\"GET /api/v1/admin/config\", s.GetConfig)\r\n    31\t\tmux.HandleFunc(\"POST /api/v1/admin/config\", s.UpdateConfig)\r\n"]
[2306.98979, "o", "    32\t\r\n    33\t\tmux.HandleFunc(\"POST /api/v1/webhooks\", s.RegisterWebhook)\r\n    34\t\tmux.HandleFunc(\"GET /api/v1/webhooks\", s.ListWebhooks)\r\n    35\t\tmux.HandleFunc(\"DELETE /api/v1/webhooks/{id}\", s.DeleteWebhook)\r\n    36\t\r\n    37\t\treturn s.logging(mux)\r\n    38\t}\r\n    39\t\r\n    40\tfunc (s *Server) logging(next http.Handler) http.Handler {\r\n    41\t\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\r\n    42"]
[2306.989861, "o", "\t\t\tnext.ServeHTTP(w, r)\r\n    43\t\t})\r\n    44\t}\r\n"]
