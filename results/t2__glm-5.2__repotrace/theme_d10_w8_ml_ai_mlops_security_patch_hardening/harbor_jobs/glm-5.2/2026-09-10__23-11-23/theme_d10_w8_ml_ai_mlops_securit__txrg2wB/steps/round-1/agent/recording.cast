[2796.808418, "o", "package registry\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"errors\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n"]
[2796.808526, "o", "\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"mlgateway/internal/store\"\r\n)\r\n\r\nvar (\r\n\tErrNotFound   = errors.New(\"not found\")\r\n\tErrConflict   = errors.New(\"conflict\")\r\n\tErrValidation = errors.New(\"validation error\")\r\n\tErrTooLarge   = errors.New(\"model binary too large\")\r\n)\r\n\r\nvar semverRe = regexp.MustCompile(`^[0-9]+\\.[0-9]+\\.[0-9]+$`)\r\n\r\ntype Service struct {\r\n\tstore           *store.Store\r\n\tmodelStorageDir string\r\n"]
[2796.808615, "o", "\tmaxModelSize    int64\r\n}\r\n\r\nfunc New(s *store.Store, modelStorageDir string, maxModelSizeMB int) *Service {\r\n\treturn &Service{\r\n\t\tstore:           s,\r\n\t\tmodelStorageDir: modelStorageDir,\r\n\t\tmaxModelSize:    int64(maxModelSizeMB) * 1024 * 1024,\r\n\t}\r\n}\r\n\r\nfunc ValidateFramework(framework string) error {\r\n\tswitch framework {\r\n\tcase \"tensorflow\", \"pytorch\", \"onnx\", \"custom\":\r\n\t\treturn nil\r\n\tdefault:\r\n\t\treturn fmt.Errorf(\"%w: invalid framework %q\", ErrValidation, framework)\r\n"]
[2796.808693, "o", "\t}\r\n}\r\n\r\nfunc ValidateSemver(version string) error {\r\n\tif !semverRe.MatchString(version) {\r\n\t\treturn fmt.Errorf(\"%w: invalid semantic version %q\", ErrValidation, version)\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc ValidateSchema(schema json.RawMessage) error {\r\n\tif len(schema) == 0 || string(schema) == \"null\" {\r\n\t\treturn fmt.Errorf(\"%w: schema is required\", ErrValidation)\r\n\t}\r\n\tvar obj map[string]interface{}\r\n\tif err := json.Unmarshal(schema, &obj); err != nil {\r\n"]
[2796.808746, "o", "\t\treturn fmt.Errorf(\"%w: schema must be a JSON object\", ErrValidation)\r\n\t}\r\n\tif obj == nil {\r\n\t\treturn fmt.Errorf(\"%w: schema must be a JSON object\", ErrValidation)\r\n\t}\r\n\tif t, ok := obj[\"type\"]; ok {\r\n\t\tif _, ok := t.(string); !ok {\r\n\t\t\treturn fmt.Errorf(\"%w: schema type must be a string\", ErrValidation)\r\n"]
[2796.808865, "o", "\t\t}\r\n\t}\r\n\tif p, ok := obj[\"properties\"]; ok {\r\n\t\tif _, ok := p.(map[string]interface{}); !ok {\r\n\t\t\treturn fmt.Errorf(\"%w: schema properties must be an object\", ErrValidation)\r\n\t\t}\r\n\t}\r\n\tif r, ok := obj[\"required\"]; ok {\r\n\t\tif _, ok := r.([]interface{}); !ok {\r\n\t\t\treturn fmt.Errorf(\"%w: schema required must be an array\", ErrValidation)\r\n\t\t}\r\n\t}\r\n\tif i, ok := obj[\"items\"]; ok {\r\n\t\tif _, ok := i.(map[string]interface{}); !ok {\r\n\t\t\treturn fmt.Errorf(\"%w: schema items must be an object\", ErrValidation)\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n"]
[2796.808954, "o", "func (s *Service) Register(m *store.Model) (*store.Model, error) {\r\n\tm.Name = strings.TrimSpace(m.Name)\r\n\tm.Framework = strings.TrimSpace(m.Framework)\r\n\tm.Description = strings.TrimSpace(m.Description)\r\n\tm.Author = strings.TrimSpace(m.Author)\r\n\r\n\tif m.Name == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"%w: name is required\", ErrValidation)\r\n\t}\r\n\tif err := ValidateFramework(m.Framework); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif err := ValidateSchema(m.InputSchema); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"input_schema: %w\", err)\r\n\t}\r\n"]
[2796.809081, "o", "\tif err := ValidateSchema(m.OutputSchema); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"output_schema: %w\", err)\r\n\t}\r\n\tif m.Labels == nil {\r\n\t\tm.Labels = map[string]string{}\r\n\t}\r\n\r\n\tvar created *store.Model\r\n\terr := s.store.WithLock(func(d *store.Data) error {\r\n\t\tfor _, existing := range d.Models {\r\n\t\t\tif existing.Name == m.Name {\r\n\t\t\t\treturn fmt.Errorf(\"%w: model name already exists\", ErrConflict)\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tmodel := &store.Model{\r\n\t\t\tID:           store.NewID(),\r\n\t\t\tName:         m.Name,\r\n\t\t\tFramework:    m.Framework,\r\n\t\t\tDescription:  m.Description,\r\n\t"]
[2796.809271, "o", "\t\tAuthor:       m.Author,\r\n\t\t\tCreatedAt:    time.Now().UTC(),\r\n\t\t\tInputSchema:  m.InputSchema,\r\n\t\t\tOutputSchema: m.OutputSchema,\r\n\t\t\tLabels:       m.Labels,\r\n\t\t\tLineage:      m.Lineage,\r\n\t\t\tVersions:     []*store.Version{},\r\n\t\t}\r\n\t\td.Models[model.ID] = model\r\n\t\tcreated = model\r\n\t\treturn nil\r\n\t})\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn created, nil\r\n"]
[2796.809805, "o", "\u001b[?2004h"]
