[1761.078628, "o", "func (s *Server) RegisterWebhook(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[1761.07869, "o", "\u001b[?2004h> "]
[1761.078981, "o", "    user, ok := s.requireAuth(w, r, auth.RoleAdmin)\r\n\u001b[?2004l\r"]
[1761.079036, "o", "\u001b[?2004h> "]
[1761.079123, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[1761.079181, "o", "\u001b[?2004h> "]
[1761.079262, "o", "        return\r\n\u001b[?2004l\r"]
[1761.079318, "o", "\u001b[?2004h> "]
[1761.079373, "o", "    }\r\n\u001b[?2004l\r"]
[1761.079427, "o", "\u001b[?2004h> "]
[1761.079531, "o", "    var req struct {\r\n\u001b[?2004l\r"]
[1761.079578, "o", "\u001b[?2004h> "]
[1761.079799, "o", "        URL    string   `json:\"url\"`\r\n\u001b[?2004l\r"]
[1761.079863, "o", "\u001b[?2004h> "]
[1761.080083, "o", "        Events []string `json:\"events\"`\r\n\u001b[?2004l\r"]
[1761.080158, "o", "\u001b[?2004h"]
[1761.080213, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.080268, "o", "> "]
[1761.080605, "o", "    if err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[?2004l\r"]
[1761.080665, "o", "\u001b[?2004h> "]
[1761.081052, "o", "        writeError(w, http.StatusBadRequest, \"invalid request body\")\r\n\u001b[?2004l\r"]
[1761.081119, "o", "\u001b[?2004h> "]
[1761.081203, "o", "        return\r\n\u001b[?2004l\r"]
[1761.081258, "o", "\u001b[?2004h> "]
[1761.081313, "o", "    }\r\n\u001b[?2004l\r"]
[1761.081367, "o", "\u001b[?2004h> "]
[1761.081663, "o", "    wh, err := s.webhooks.Register(req.URL, req.Events)\r\n\u001b[?2004l\r"]
[1761.081725, "o", "\u001b[?2004h> "]
[1761.081841, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1761.081896, "o", "\u001b[?2004h> "]
[1761.082227, "o", "        writeError(w, http.StatusBadRequest, err.Error())\r\n\u001b[?2004l\r"]
[1761.082285, "o", "\u001b[?2004h> "]
[1761.082369, "o", "        return\r\n\u001b[?2004l\r"]
[1761.082425, "o", "\u001b[?2004h> "]
[1761.08249, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.082546, "o", "> "]
[1761.083074, "o", "    s.auditReq(r, user.Username, \"webhook.register\", \"webhook\", wh.ID, \"url=\"+wh.URL)\r\n\u001b[?2004l\r"]
[1761.083131, "o", "\u001b[?2004h"]
[1761.083187, "o", "> "]
[1761.083339, "o", "    writeJSON(w, http.StatusCreated, wh)\r\n\u001b[?2004l\r"]
[1761.083395, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1761.08345, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.083504, "o", "> "]
[1761.083746, "o", "func (s *Server) ListWebhooks(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[1761.083802, "o", "\u001b[?2004h> "]
[1761.084008, "o", "    if _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\r\n\u001b[?2004l\r"]
[1761.084063, "o", "\u001b[?2004h> "]
[1761.084126, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.084183, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.084237, "o", "> "]
[1761.084534, "o", "    writeJSON(w, http.StatusOK, map[string]interface{}{\"webhooks\": s.webhooks.List()})\r\n\u001b[?2004l\r"]
