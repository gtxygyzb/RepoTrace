[2337.055609, "o", "\r\n    93\t\tuser, err := s.auth.Register(req.Username, req.Password, req.Role, callerRole)\r\n    94\t\tif err != nil {\r\n    95\t\t\tswitch {\r\n    96\t\t\tcase errors.Is(err, auth.ErrForbidden):\r\n    97\t\t\t\twriteError(w, http.StatusForbidden, err.Error())\r\n    98\t\t\tcase errors.Is(err, auth.ErrInvalidRole), strings.Contains(err.Error(), \"required\"):\r\n    99\t\t\t\twriteError(w, http.StatusBadRequest, err.Error())\r\n   100\t\t\tcase errors.Is(err, auth.ErrUsernameExists):\r\n   101"]
[2337.055666, "o", "\t\t\t\twriteError(w, http.StatusConflict, err.Error())\r\n   102\t\t\tdefault:\r\n   103\t\t\t\twriteError(w, http.StatusBadRequest, err.Error())\r\n   104\t\t\t}\r\n   105\t\t\treturn\r\n   106\t\t}\r\n   107\t\r\n   108\t\ts.auditReq(r, user.Username, \"user.register\", \"user\", user.ID, \"role=\"+user.Role)\r\n"]
