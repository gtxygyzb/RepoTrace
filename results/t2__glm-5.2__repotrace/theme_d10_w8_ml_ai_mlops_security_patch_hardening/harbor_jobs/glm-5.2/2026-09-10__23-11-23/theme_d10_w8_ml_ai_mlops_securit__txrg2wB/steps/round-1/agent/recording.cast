[1243.137579, "i", "cat > internal/store/store.go <<'EOF'\npackage store\n\nimport (\n    \"crypto/rand\"\n    \"encoding/hex\"\n    \"encoding/json\"\n    \"errors\"\n    \"os\"\n    \"path/filepath\"\n    \"sync\"\n    \"time\"\n)\n\ntype User struct {\n    ID           string    `json:\"id\"`\n    Username     string    `json:\"username\"`\n    PasswordHash string    `json:\"password_hash\"`\n    Role         string    `json:\"role\"`\n    APIKey       string    `json:\"api_key\"`\n    CreatedAt    time.Time `json:\"created_at\"`\n}\n\ntype Lineage struct {\n    TrainingDataset string             `json:\"training_dataset\"`\n    ParentModel     string             `json:\"parent_model\"`\n    TrainingMetrics map[string]float64 `json:\"training_metrics\"`\n}\n\ntype Version struct {\n    Version      string    `json:\"version\"`\n    ReleaseNotes string    `json:\"release_notes\"`\n    BinaryPath   string    `json:\"binary_path\"`\n    Status       string    `json:\"status\"`\n    CreatedAt    time.Time `json:\"created_at\"`\n    Size         int64     `json:\"size\"`\n}\n\ntype Model struct {\n    ID          "]
[1243.137873, "i", " string          `json:\"id\"`\n    Name         string          `json:\"name\"`\n    Framework    string          `json:\"framework\"`\n    Description  string          `json:\"description\"`\n    Author       string          `json:\"author\"`\n    CreatedAt    time.Time       `json:\"created_at\"`\n    InputSchema  json.RawMessage `json:\"input_schema\"`\n    OutputSchema json.RawMessage `json:\"output_schema\"`\n    Labels       map[string]string `json:\"labels\"`\n    Lineage      Lineage         `json:\"lineage\"`\n    Versions     []*Version      `json:\"versions\"`\n}\n\ntype Webhook struct {\n    ID        string    `json:\"id\"`\n    URL       string    `json:\"url\"`\n    Events    []string  `json:\"events\"`\n    CreatedAt time.Time `json:\"created_at\"`\n}\n\ntype AuditEntry struct {\n    Timestamp     time.Time `json:\"timestamp\"`\n    User          string    `json:\"user\"`\n    Action        string    `json:\"action\"`\n    ResourceType  string    `json:\"resource_type\"`\n    ResourceID    string    `json:\"resource_id\"`\n    Details       string    `json:"]
[1243.137972, "o", "cat > internal/store/store.go <<'EOF'\r\n\u001b[?2004l\r"]
[1243.138062, "i", "\"details\"`\n    SourceIP      string    `json:\"source_ip\"`\n}\n\ntype MetricsState struct {\n    TotalInferences     int64            `json:\"total_inferences\"`\n    TotalErrors         int64            `json:\"error_count\"`\n    LatencySumMs        float64          `json:\"latency_sum_ms\"`\n    InferencesPerModel  map[string]int64 `json:\"inferences_per_model\"`\n}\n\ntype Data struct {\n    Users    []User         `json:\"users\"`\n    Models   map[string]*Model `json:\"models\"`\n    Webhooks []Webhook      `json:\"webhooks\"`\n    Audit    []AuditEntry   `json:\"audit\"`\n    Metrics  MetricsState   `json:\"metrics\"`\n}\n\ntype Store struct {\n    mu      sync.RWMutex\n    data    *Data\n    dataDir string\n}\n\nfunc NewID() string {\n    b := make([]byte, 16)\n    _, err := rand.Read(b)\n    if err != nil {\n        return time.Now().UTC().Format(\"20060102150405.000000\")\n    }\n    return hex.EncodeToString(b)\n}\n\nfunc New(dataDir string) (*Store, error) {\n    if err := os.MkdirAll(dataDir, 0755); err != nil {\n        return nil, err\n    }\n    s :="]
[1243.138148, "o", "\u001b[?2004h> "]
[1243.138246, "i", " &Store{\n        dataDir: dataDir,\n        data: &Data{\n            Models: make(map[string]*Model),\n            Metrics: MetricsState{\n                InferencesPerModel: make(map[string]int64),\n            },\n        },\n    }\n    if err := s.load(); err != nil {\n        return nil, err\n    }\n    return s, nil\n}\n\nfunc (s *Store) WithLock(fn func(d *Data) error) error {\n    s.mu.Lock()\n    defer s.mu.Unlock()\n    err := fn(s.data)\n    if err != nil {\n        return err\n    }\n    return s.saveLocked()\n}\n\nfunc (s *Store) WithRLock(fn func(d *Data) error) error {\n    s.mu.RLock()\n    defer s.mu.RUnlock()\n    return fn(s.data)\n}\n\nfunc (s *Store) load() error {\n    s.mu.Lock()\n    defer s.mu.Unlock()\n\n    if err := readJSON(filepath.Join(s.dataDir, \"users.json\"), &s.data.Users); err != nil {\n        return err\n    }\n    if err := readJSON(filepath.Join(s.dataDir, \"models.json\"), &s.data.Models); err != nil {\n        return err\n    }\n    if err := readJSON(filepath.Join(s.dataDir, \"webhooks.json\"), &s.data.Webhooks"]
[1243.138301, "o", "package store\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1243.138368, "i", "); err != nil {\n        return err\n    }\n    if err := readJSON(filepath.Join(s.dataDir, \"audit.json\"), &s.data.Audit); err != nil {\n        return err\n    }\n    if err := readJSON(filepath.Join(s.dataDir, \"metrics.json\"), &s.data.Metrics); err != nil {\n        return err\n    }\n\n    if s.data.Models == nil {\n        s.data.Models = make(map[string]*Model)\n    }\n    if s.data.Metrics.InferencesPerModel == nil {\n        s.data.Metrics.InferencesPerModel = make(map[string]int64)\n    }\n    return nil\n}\n\nfunc (s *Store) saveLocked() error {\n    if err := writeJSON(filepath.Join(s.dataDir, \"users.json\"), s.data.Users); err != nil {\n        return err\n    }\n    if err := writeJSON(filepath.Join(s.dataDir, \"models.json\"), s.data.Models); err != nil {\n        return err\n    }\n    if err := writeJSON(filepath.Join(s.dataDir, \"webhooks.json\"), s.data.Webhooks); err != nil {\n        return err\n    }\n    if err := writeJSON(filepath.Join(s.dataDir, \"audit.json\"), s.data.Audit); err != nil {\n        return err\n    }\n    re"]
[1243.138422, "o", "import (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1243.138481, "i", "turn writeJSON(filepath.Join(s.dataDir, \"metrics.json\"), s.data.Metrics)\n}\n\nfunc readJSON(path string, v interface{}) error {\n    data, err := os.ReadFile(path)\n    if os.IsNotExist(err) {\n        return nil\n    }\n    if err != nil {\n        return err\n    }\n    if len(data) == 0 {\n        return nil\n    }\n    return json.Unmarshal(data, v)\n}\n\nfunc writeJSON(path string, v interface{}) error {\n    data, err := json.MarshalIndent(v, \"\", \"  \")\n    if err != nil {\n        return err\n    }\n    if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {\n        return err\n    }\n    tmp := path + \".tmp\"\n    if err := os.WriteFile(tmp, data, 0644); err != nil {\n        return err\n    }\n    return os.Rename(tmp, path)\n}\n\nfunc (s *Store) DataDir() string {\n    return s.dataDir\n}\n\nvar ErrNotFound = errors.New(\"not found\")\nEOF\n"]
