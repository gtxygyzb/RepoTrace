[1847.498185, "o", "sed -n '1,180p' internal/auth/auth.go\r\n\u001b[?2004l\r"]
[1847.500987, "o", "package auth\r\n\r\nimport (\r\n\t\"crypto/rand\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n\t\"errors\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n"]
[1847.501162, "o", "\t\"mlgateway/internal/store\"\r\n)\r\n\r\nconst (\r\n\tRoleAdmin    = \"admin\"\r\n\tRoleDeployer = \"deployer\"\r\n\tRoleViewer   = \"viewer\"\r\n)\r\n"]
[1847.50129, "o", "\r\nvar (\r\n\tErrInvalidRole        = errors.New(\"invalid role\")\r\n\tErrUsernameExists     = errors.New(\"username already exists\")\r\n\tErrForbidden          = errors.New(\"forbidden\")\r\n\tErrInvalidCredentials = errors.New(\"invalid credentials\")\r\n)\r\n\r\ntype Service struct {\r\n\tstore *store.Store\r\n}\r\n\r\nfunc New(s *store.Store) *Service {\r\n\treturn &Service{store: s}\r\n}\r\n\r\nfunc validRole(role string) bool {\r\n\treturn role == RoleAdmin || role == RoleDeployer || role == RoleViewer\r\n}\r\n\r\nfunc hashPassword(password string) (string, error) {\r\n\tsalt := make([]byte, 16)\r\n\tif _, err := rand.Read(salt); err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\th := sha256.Sum256(append(salt, []byte(password)...))\r\n\treturn hex.EncodeToString(salt) + \":\" + hex.EncodeToString(h[:]), nil\r\n}\r\n\r\n"]
[1847.501426, "o", "func verifyPassword(password, hash string) bool {\r\n\tparts := strings.SplitN(hash, \":\", 2)\r\n\tif len(parts) != 2 {\r\n\t\treturn false\r\n\t}\r\n\th := sha256.Sum256(append([]byte(parts[0]), []byte(password)...))\r\n\treturn hex.EncodeToString(h[:]) == parts[1]\r\n}\r\n\r\nfunc (s *Service) Register(username, password, role, callerRole string) (*store.User, error) {\r\n\tusername = strings.TrimSpace(username)\r\n\tif username == \"\" || password == \"\" {\r\n\t\treturn nil, errors.New(\"username and password are required\")\r\n\t}\r\n\tif !validRole(role) {\r\n\t\treturn nil, ErrInvalidRole\r\n\t}\r\n\r\n\tvar created *store.User\r\n\terr := s.store.WithLock(func(d *store.Data) error {\r\n\t\tif len(d.Users) > 0 {\r\n\t\t\tif callerRole != RoleAdmin {\r\n\t\t\t\treturn ErrForbidden\r\n\t\t\t}\r\n\t\t\tfor _, u := range d.Users {\r\n\t\t\t\tif u.Username == username {\r\n\t\t\t\t\treturn ErrUsernameExists\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t\trole = RoleAdmin\r\n\t\t}\r\n\r\n\t\thash, err := hashPassword(password)\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\r\n"]
[1847.501552, "o", "\t\tuser := store.User{\r\n\t\t\tID:           store.NewID(),\r\n\t\t\tUsername:     username,\r\n\t\t\tPasswordHash: hash,\r\n\t\t\tRole:         role,\r\n\t\t\tAPIKey:       store.NewID(),\r\n\t\t\tCreatedAt:    time.Now().UTC(),\r\n\t\t}\r\n\t\td.Users = append(d.Users, user)\r\n\t\tcreated = &d.Users[len(d.Users)-1]\r\n\t\treturn nil\r\n\t})\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn created, nil\r\n}\r\n\r\nfunc (s *Service) Login(username, password string) (string, string, error) {\r\n\tvar apiKey, role string\r\n"]
[1847.501683, "o", "\terr := s.store.WithRLock(func(d *store.Data) error {\r\n\t\tfor _, u := range d.Users {\r\n\t\t\tif u.Username == username && verifyPassword(password, u.PasswordHash) {\r\n\t\t\t\tapiKey = u.APIKey\r\n\t\t\t\trole = u.Role\r\n\t"]
[1847.501801, "o", "\t\t\treturn nil\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn ErrInvalidCredentials\r\n\t})\r\n\tif err != nil {\r\n\t\treturn \"\", \"\", err\r\n\t}\r\n\treturn apiKey, role, nil\r\n}\r\n\r\nfunc (s *Service) Authenticate(token string) (*store.User, bool) {\r\n\tif token == \"\" {\r\n\t\treturn nil, false\r\n\t}\r\n\tvar found *store.User\r\n\t_ = s.store.WithRLock(func(d *store.Data) error {\r\n\t\tfor i := range d.Users {\r\n\t\t\tif d.Users[i].APIKey == token {\r\n\t\t\t\tfound = &d.Users[i]\r\n\t\t\t\treturn nil\r\n"]
[1847.501918, "o", "\t\t\t}\r\n\t\t}\r\n\t\treturn nil\r\n\t})\r\n\treturn found, found != nil\r\n}\r\n\r\nfunc CanAccess(role string, required string) bool {\r\n\tswitch required {\r\n\tcase RoleAdmin:\r\n\t\treturn role == RoleAdmin\r\n\tcase RoleDeployer:\r\n\t\treturn role == RoleAdmin || role == RoleDeployer\r\n\tcase RoleViewer:\r\n\t\treturn role == RoleAdmin || role == RoleDeployer || role == RoleViewer\r\n\tdefault:\r\n\t\treturn false\r\n\t}\r\n}\r\n"]
