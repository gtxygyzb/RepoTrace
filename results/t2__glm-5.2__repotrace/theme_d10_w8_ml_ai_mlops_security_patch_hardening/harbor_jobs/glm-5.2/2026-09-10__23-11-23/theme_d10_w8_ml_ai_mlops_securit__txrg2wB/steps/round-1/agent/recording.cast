[1401.102248, "o", "func ValidateSchema(schema json.RawMessage) error {\r\n\u001b[?2004l\r"]
[1401.102305, "o", "\u001b[?2004h> "]
[1401.102609, "o", "    if len(schema) == 0 || string(schema) == \"null\" {\r\n\u001b[?2004l\r"]
[1401.102664, "o", "\u001b[?2004h> "]
[1401.103028, "o", "        return fmt.Errorf(\"%w: schema is required\", ErrValidation)\r\n\u001b[?2004l\r"]
[1401.103123, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1401.103184, "o", "\u001b[?2004h> "]
[1401.103334, "o", "    var obj map[string]interface{}\r\n\u001b[?2004l\r"]
[1401.103389, "o", "\u001b[?2004h> "]
[1401.103675, "o", "    if err := json.Unmarshal(schema, &obj); err != nil {\r\n\u001b[?2004l\r"]
[1401.103729, "o", "\u001b[?2004h> "]
[1401.104166, "o", "        return fmt.Errorf(\"%w: schema must be a JSON object\", ErrValidation)\r\n\u001b[?2004l\r"]
[1401.104225, "o", "\u001b[?2004h> "]
[1401.104241, "o", "    }\r\n\u001b[?2004l\r"]
[1401.104315, "o", "\u001b[?2004h> "]
[1401.104396, "o", "    if obj == nil {\r\n\u001b[?2004l\r"]
[1401.104451, "o", "\u001b[?2004h> "]
[1401.104888, "o", "        return fmt.Errorf(\"%w: schema must be a JSON object\", ErrValidation)\r\n\u001b[?2004l\r"]
[1401.104943, "o", "\u001b[?2004h> "]
[1401.104959, "o", "    }\r\n\u001b[?2004l\r"]
[1401.105025, "o", "\u001b[?2004h> "]
[1401.105199, "o", "    if t, ok := obj[\"type\"]; ok {\r\n\u001b[?2004l\r"]
[1401.105256, "o", "\u001b[?2004h> "]
[1401.105435, "o", "        if _, ok := t.(string); !ok {\r\n\u001b[?2004l\r"]
[1401.105491, "o", "\u001b[?2004h> "]
[1401.105894, "o", "            return fmt.Errorf(\"%w: schema type must be a string\", ErrValidation)\r\n\u001b[?2004l\r"]
[1401.10595, "o", "\u001b[?2004h> "]
[1401.105995, "o", "        }\r\n\u001b[?2004l\r"]
[1401.106051, "o", "\u001b[?2004h> "]
[1401.106118, "o", "    }\r\n\u001b[?2004l\r"]
[1401.106173, "o", "\u001b[?2004h> "]
[1401.106335, "o", "    if p, ok := obj[\"properties\"]; ok {\r\n\u001b[?2004l\r"]
[1401.10639, "o", "\u001b[?2004h> "]
[1401.10667, "o", "        if _, ok := p.(map[string]interface{}); !ok {\r\n\u001b[?2004l\r"]
[1401.106725, "o", "\u001b[?2004h> "]
[1401.107237, "o", "            return fmt.Errorf(\"%w: schema properties must be an object\", ErrValidation)\r\n\u001b[?2004l\r"]
[1401.107299, "o", "\u001b[?2004h> "]
[1401.107352, "o", "        }\r\n\u001b[?2004l\r"]
[1401.107405, "o", "\u001b[?2004h"]
[1401.107457, "o", ">     }\r\n\u001b[?2004l\r"]
[1401.107512, "o", "\u001b[?2004h> "]
[1401.107655, "o", "    if r, ok := obj[\"required\"]; ok {\r\n\u001b[?2004l\r"]
[1401.10771, "o", "\u001b[?2004h> "]
[1401.107962, "o", "        if _, ok := r.([]interface{}); !ok {\r\n\u001b[?2004l\r"]
[1401.108017, "o", "\u001b[?2004h> "]
[1401.108445, "o", "            return fmt.Errorf(\"%w: schema required must be an array\", ErrValidation)\r\n\u001b[?2004l\r"]
[1401.108502, "o", "\u001b[?2004h> "]
[1401.108558, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1401.108573, "o", "> "]
[1401.108653, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.108842, "o", "    if i, ok := obj[\"items\"]; ok {\r\n\u001b[?2004l\r"]
[1401.108897, "o", "\u001b[?2004h> "]
[1401.109218, "o", "        if _, ok := i.(map[string]interface{}); !ok {\r\n\u001b[?2004l\r"]
[1401.109234, "o", "\u001b[?2004h"]
[1401.109305, "o", "> "]
[1401.109744, "o", "            return fmt.Errorf(\"%w: schema items must be an object\", ErrValidation)\r\n\u001b[?2004l\r"]
[1401.1098, "o", "\u001b[?2004h> "]
[1401.109845, "o", "        }\r\n\u001b[?2004l\r"]
[1401.1099, "o", "\u001b[?2004h> "]
[1401.109915, "o", "    }\r\n\u001b[?2004l\r"]
[1401.109986, "o", "\u001b[?2004h> "]
[1401.110049, "o", "    return nil\r\n\u001b[?2004l\r"]
[1401.110108, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1401.110162, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1401.110177, "o", "\u001b[?2004h"]
[1401.110247, "o", "> "]
[1401.110548, "o", "func (s *Service) Register(m *store.Model) (*store.Model, error) {\r\n\u001b[?2004l\r"]
[1401.110602, "o", "\u001b[?2004h> "]
[1401.110827, "o", "    m.Name = strings.TrimSpace(m.Name)\r\n\u001b[?2004l\r"]
[1401.110882, "o", "\u001b[?2004h> "]
[1401.111127, "o", "    m.Framework = strings.TrimSpace(m.Framework)\r\n\u001b[?2004l\r"]
[1401.111184, "o", "\u001b[?2004h> "]
[1401.111461, "o", "    m.Description = strings.TrimSpace(m.Description)\r\n\u001b[?2004l\r"]
[1401.111515, "o", "\u001b[?2004h> "]
[1401.111646, "o", "    m.Author = strings.TrimSpace(m.Author)\r\n\u001b[?2004l\r"]
[1401.111702, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1401.111758, "o", "> "]
[1401.111814, "o", "    if m.Name == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1401.111874, "o", "> "]
[1401.112091, "o", "        return nil, fmt.Errorf(\"%w: name is required\", ErrValidation)\r\n\u001b[?2004l\r"]
[1401.112157, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1401.112214, "o", "\u001b[?2004h> "]
[1401.112405, "o", "    if err := ValidateFramework(m.Framework); err != nil {\r\n\u001b[?2004l\r"]
[1401.112462, "o", "\u001b[?2004h> "]
[1401.112537, "o", "        return nil, err\r\n\u001b[?2004l\r\u001b[?2004h"]
[1401.112596, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.112829, "o", "    if err := ValidateSchema(m.InputSchema); err != nil {\r\n\u001b[?2004l\r"]
[1401.112886, "o", "\u001b[?2004h> "]
[1401.113081, "o", "        return nil, fmt.Errorf(\"input_schema: %w\", err)\r\n\u001b[?2004l\r"]
[1401.113106, "o", "\u001b[?2004h> "]
[1401.113182, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.113387, "o", "    if err := ValidateSchema(m.OutputSchema); err != nil {\r\n\u001b[?2004l\r"]
[1401.113448, "o", "\u001b[?2004h> "]
[1401.113626, "o", "        return nil, fmt.Errorf(\"output_schema: %w\", err)\r\n\u001b[?2004l\r"]
[1401.113676, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1401.11373, "o", "\u001b[?2004h> "]
[1401.113827, "o", "    if m.Labels == nil {\r\n\u001b[?2004l\r"]
[1401.113877, "o", "\u001b[?2004h> "]
[1401.114025, "o", "        m.Labels = map[string]string{}\r\n\u001b[?2004l\r"]
[1401.114081, "o", "\u001b[?2004h> "]
[1401.114147, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.114261, "o", "    var created *store.Model\r\n\u001b[?2004l\r"]
[1401.114318, "o", "\u001b[?2004h> "]
[1401.114509, "o", "    err := s.store.WithLock(func(d *store.Data) error {\r\n\u001b[?2004l\r"]
[1401.114566, "o", "\u001b[?2004h> "]
[1401.114708, "o", "        for _, existing := range d.Models {\r\n\u001b[?2004l\r"]
[1401.114765, "o", "\u001b[?2004h> "]
[1401.114879, "o", "            if existing.Name == m.Name {\r\n\u001b[?2004l\r"]
[1401.114903, "o", "\u001b[?2004h> "]
[1401.115229, "o", "                return fmt.Errorf(\"%w: model name already exists\", ErrConflict)\r\n\u001b[?2004l\r"]
[1401.115289, "o", "\u001b[?2004h> "]
[1401.115347, "o", "            }\r\n\u001b[?2004l\r"]
[1401.115409, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1401.11547, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.115559, "o", "        model := &store.Model{\r\n\u001b[?2004l\r"]
[1401.115613, "o", "\u001b[?2004h> "]
[1401.115747, "o", "            ID:           store.NewID(),\r\n\u001b[?2004l\r"]
[1401.115803, "o", "\u001b[?2004h> "]
[1401.115909, "o", "            Name:         m.Name,\r\n\u001b[?2004l\r"]
[1401.115969, "o", "\u001b[?2004h> "]
[1401.116082, "o", "            Framework:    m.Framework,\r\n\u001b[?2004l\r"]
[1401.116106, "o", "\u001b[?2004h> "]
[1401.116277, "o", "            Description: m.Description,\r\n\u001b[?2004l\r"]
[1401.116331, "o", "\u001b[?2004h> "]
[1401.116447, "o", "            Author:       m.Author,\r\n\u001b[?2004l\r"]
[1401.116508, "o", "\u001b[?2004h> "]
[1401.116636, "o", "            CreatedAt:    time.Now().UTC(),\r\n\u001b[?2004l\r"]
[1401.116693, "o", "\u001b[?2004h"]
[1401.116754, "o", "> "]
[1401.116805, "o", "            InputSchema:  m.InputSchema,\r\n\u001b[?2004l\r"]
[1401.11686, "o", "\u001b[?2004h> "]
[1401.116997, "o", "            OutputSchema: m.OutputSchema,\r\n\u001b[?2004l\r"]
[1401.117053, "o", "\u001b[?2004h> "]
[1401.117175, "o", "            Labels:       m.Labels,\r\n\u001b[?2004l\r"]
[1401.117233, "o", "\u001b[?2004h> "]
[1401.117345, "o", "            Lineage:      m.Lineage,\r\n\u001b[?2004l\r"]
[1401.1174, "o", "\u001b[?2004h> "]
[1401.117543, "o", "            Versions:     []*store.Version{},\r\n\u001b[?2004l\r"]
[1401.117599, "o", "\u001b[?2004h> "]
[1401.117656, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.117776, "o", "        d.Models[model.ID] = model\r\n\u001b[?2004l\r"]
[1401.117833, "o", "\u001b[?2004h> "]
[1401.117896, "o", "        created = model\r\n\u001b[?2004l\r"]
[1401.117952, "o", "\u001b[?2004h> "]
[1401.118009, "o", "        return nil\r\n\u001b[?2004l\r"]
[1401.118064, "o", "\u001b[?2004h> "]
[1401.11812, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.118175, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1401.11823, "o", "\u001b[?2004h> "]
[1401.118312, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1401.118367, "o", "\u001b[?2004h> "]
[1401.118422, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.118489, "o", "    return created, nil\r\n\u001b[?2004l\r"]
[1401.118543, "o", "\u001b[?2004h"]
[1401.118567, "o", "> }\r\n\u001b[?2004l\r  \u001b[?2004h> \r\n\u001b[?2004l\rb"]
[1401.118639, "o", "\u001b[?2004h> "]
[1401.118996, "o", "func (s *Service) List(name, framework, labelKey, labelValue string, deployedFilter *bool) []*store.Model {\r\n\u001b[?2004l\r"]
[1401.119057, "o", "\u001b[?2004h> "]
[1401.119139, "o", "    var result []*store.Model\r\n\u001b[?2004l\r"]
[1401.1192, "o", "\u001b[?2004h"]
[1401.11925, "o", "> "]
[1401.119378, "o", "    _ = s.store.WithRLock(func(d *store.Data) error {\r\n\u001b[?2004l\r"]
[1401.119433, "o", "\u001b[?2004h> "]
[1401.119563, "o", "        for _, m := range d.Models {\r\n\u001b[?2004l\r"]
[1401.119619, "o", "\u001b[?2004h> "]
[1401.119942, "o", "            if name != \"\" && !strings.Contains(strings.ToLower(m.Name), strings.ToLower(name)) {\r\n\u001b[?2004l\r"]
[1401.119997, "o", "\u001b[?2004h> "]
[1401.120059, "o", "                continue\r\n\u001b[?2004l\r"]
[1401.120123, "o", "\u001b[?2004h> "]
[1401.165114, "o", "            }\r\n\u001b[?2004l\r"]
[1401.165195, "o", "\u001b[?2004h"]
[1401.165252, "o", "> "]
[1401.165602, "o", "            if framework != \"\" && m.Framework != framework {\r\n\u001b[?2004l\r"]
[1401.165658, "o", "\u001b[?2004h> "]
[1401.165828, "o", "                continue\r\n\u001b[?2004l\r"]
[1401.165895, "o", "\u001b[?2004h"]
[1401.165951, "o", "> "]
[1401.166012, "o", "            }\r\n\u001b[?2004l\r"]
[1401.166067, "o", "\u001b[?2004h> "]
[1401.166291, "o", "            if labelKey != \"\" {\r\n\u001b[?2004l\r"]
[1401.166358, "o", "\u001b[?2004h> "]
[1401.166652, "o", "                v, ok := m.Labels[labelKey]\r\n\u001b[?2004l\r"]
[1401.166707, "o", "\u001b[?2004h> "]
[1401.167154, "o", "                if !ok || (labelValue != \"\" && v != labelValue) {\r\n\u001b[?2004l\r"]
[1401.167212, "o", "\u001b[?2004h> "]
[1401.167408, "o", "                    continue\r\n\u001b[?2004l\r"]
[1401.167474, "o", "\u001b[?2004h> "]
[1401.167601, "o", "                }\r\n\u001b[?2004l\r"]
[1401.167656, "o", "\u001b[?2004h> "]
[1401.16777, "o", "            }\r\n\u001b[?2004l\r"]
[1401.167827, "o", "\u001b[?2004h> "]
[1401.168091, "o", "            if deployedFilter != nil {\r\n\u001b[?2004l\r"]
[1401.16816, "o", "\u001b[?2004h> "]
[1401.168408, "o", "                hasDeployed := false\r\n\u001b[?2004l\r"]
[1401.168465, "o", "\u001b[?2004h> "]
[1401.168783, "o", "                for _, v := range m.Versions {\r\n\u001b[?2004l\r"]
[1401.168839, "o", "\u001b[?2004h> "]
[1401.169169, "o", "                    if v.Status == \"deployed\" {\r\n\u001b[?2004l\r"]
[1401.169225, "o", "\u001b[?2004h> "]
[1401.169519, "o", "                        hasDeployed = true\r\n\u001b[?2004l\r"]
[1401.169578, "o", "\u001b[?2004h> "]
[1401.169783, "o", "                        break\r\n\u001b[?2004l\r"]
