[1401.09645, "o", "func New(s *store.Store, modelStorageDir string, maxModelSizeMB int) *Service {\r\n\u001b[?2004l\r"]
[1401.096508, "o", "\u001b[?2004h> "]
[1401.096653, "o", "    return &Service{\r\n"]
[1401.096666, "o", "\u001b[?2004l\r"]
[1401.09673, "o", "\u001b[?2004h> "]
[1401.096912, "o", "        store:           s,\r\n\u001b[?2004l\r"]
[1401.096963, "o", "\u001b[?2004h> "]
[1401.09726, "o", "        modelStorageDir: modelStorageDir,\r\n\u001b[?2004l\r"]
[1401.097313, "o", "\u001b[?2004h"]
[1401.097325, "o", "> "]
[1401.097734, "o", "        maxModelSize:    int64(maxModelSizeMB) * 1024 * 1024,\r\n\u001b[?2004l\r"]
[1401.097786, "o", "\u001b[?2004h"]
[1401.097799, "o", "> "]
[1401.097862, "o", "    }\r\n\u001b[?2004l\r"]
[1401.097875, "o", "\u001b[?2004h"]
[1401.097939, "o", "> }\r\n\u001b[?2004l\r"]
