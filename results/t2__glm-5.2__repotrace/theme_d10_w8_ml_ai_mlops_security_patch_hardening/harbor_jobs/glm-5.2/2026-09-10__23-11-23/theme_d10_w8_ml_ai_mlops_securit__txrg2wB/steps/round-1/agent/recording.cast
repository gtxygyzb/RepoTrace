[3279.613675, "o", "package main\r\n\r\nimport (\r\n\t\"context\"\r\n\t\"fmt\"\r\n\t\"log\"\r\n\t\"net/http\"\r\n\t\"os\"\r\n\t\"os/signal\"\r\n"]
[3279.613728, "o", "\t\"syscall\"\r\n\t\"time\"\r\n\r\n\t\"mlgateway/internal/audit\"\r\n\t\"mlgateway/internal/auth\"\r\n\t\"mlgateway/internal/config\"\r\n\t\"mlgateway/internal/inference\"\r\n\t\"mlgateway/internal/metrics\"\r\n\t"]
[3279.613776, "o", "\"mlgateway/internal/registry\"\r\n\t\"mlgateway/internal/server\"\r\n\t\"mlgateway/internal/store\"\r\n\t\"mlgateway/internal/webhooks\"\r\n)\r\n\r\nfunc main() {\r\n\tstartTime := time.Now()\r\n"]
[3279.61382, "o", "\r\n\tcfgPath := \"/app/data/config.json\"\r\n\tcfg, err := config.Load(cfgPath)\r\n\tif err != nil {\r\n\t\tlog.Fatalf(\"config: %v\", err)\r\n\t}\r\n\r\n\tif err := os.MkdirAll(cfg.DataDir, 0755); err != nil {\r\n"]
[3279.61387, "o", "\t\tlog.Fatalf(\"data dir: %v\", err)\r\n\t}\r\n\tif err := os.MkdirAll(cfg.ModelStorageDir, 0755); err != nil {\r\n\t\tlog.Fatalf(\"model storage dir: %v\", err)\r\n\t}\r\n\r\n\tst, err := store.New(cfg.DataDir)\r\n\tif err != nil {\r\n"]
[3279.613921, "o", "\t\tlog.Fatalf(\"store: %v\", err)\r\n\t}\r\n\r\n\tas := auth.New(st)\r\n\trs := registry.New(st, cfg.ModelStorageDir, cfg.MaxModelSizeMB)\r\n\tis := inference.New(rs, cfg.InferenceTimeoutSec)\r\n\tms := metrics.New(st, startTime)\r\n\taus := audit.New(st)\r\n"]
[3279.61397, "o", "\tws := webhooks.New(st, cfg.WebhookTimeoutSec)\r\n\r\n\tsrv := server.New(cfg, st, as, rs, is, ms, aus, ws, startTime)\r\n\r\n\thttpServer := &http.Server{\r\n\t\tAddr:    fmt.Sprintf(\":%d\", cfg.Port),\r\n\t\tHandler: srv.Routes(),\r\n\t}\r\n\r\n"]
[3279.614018, "o", "\tserverErrors := make(chan error, 1)\r\n\tgo func() {\r\n\t\tlog.Printf(\"listening on :%d\", cfg.Port)\r\n\t\tserverErrors <- httpServer.ListenAndServe()\r\n\t}()\r\n\r\n\tshutdown := make(chan os.Signal, 1)\r\n\tsignal.Notify(shutdown, syscall.SIGTERM, syscall.SIGINT)\r\n"]
[3279.614068, "o", "\r\n\tselect {\r\n\tcase err := <-serverErrors:\r\n\t\tif err != nil && err != http.ErrServerClosed {\r\n\t\t\tlog.Fatalf(\"server: %v\", err)\r\n\t\t}\r\n\tcase <-shutdown:\r\n\t\tlog.Printf(\"shutting down\")\r\n\t\t"]
[3279.61414, "o", "ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\r\n\t\tdefer cancel()\r\n\t\t_ = httpServer.Shutdown(ctx)\r\n\t}\r\n}\r\n"]
