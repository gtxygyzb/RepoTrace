[3498.332296, "o", ")\r\n\r\nvar ErrNotFound = errors.New(\"not found\")\r\n\r\ntype Service struct {\r\n\tstore   *store.Store\r\n\ttimeout time.Duration\r\n}\r\n\r\nfunc New(s *store.Store, timeoutSec int) *Service {\r\n\tif timeoutSec <= 0 {\r\n\t\ttimeoutSec = 5\r\n\t}\r\n\treturn &Service{store: s, timeout: time.Duration(timeoutSec) * time.Second}\r\n}\r\n\r\nfunc validEvent(event string) bool {\r\n\tswitch event {\r\n\tcase \"model.created\", \"model.deleted\", \"version.uploaded\", \"version.deployed\", \"version.undeployed\", \"inference.completed\":\r\n\t\treturn true\r\n\tdefault:\r\n\t\treturn false\r\n\t}\r\n}\r\n\r\nfunc (s *Service) Register(url string, events []string) (*store.Webhook, error) {\r\n\tif url == \"\" {\r\n\t\treturn nil, errors.New(\"url is required\")\r\n\t}\r\n\tfiltered := []string{}\r\n\tfor _, e := range events {\r\n\t\tif validEvent(e) {\r\n\t\t\tfiltered = append(filtered, e)\r\n\t\t}\r\n\t}\r\n\tif len(filtered) == 0 {\r\n\t\treturn nil, errors.New(\"at least one valid event is required\")\r\n\t}\r\n\r\n\tvar created *store.Webhook\r\n\terr := s.store.WithLock(func(d *store.Data) error {\r\n\t\twh := store.Webhook{\r\n\t\t\tID:      "]
