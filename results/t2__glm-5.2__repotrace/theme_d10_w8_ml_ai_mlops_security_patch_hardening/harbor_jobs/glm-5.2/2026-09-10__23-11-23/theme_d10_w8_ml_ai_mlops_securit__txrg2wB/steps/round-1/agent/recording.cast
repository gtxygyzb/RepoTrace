[1590.113788, "i", "cat > internal/webhooks/webhooks.go <<'EOF'\npackage webhooks\n\nimport (\n    \"bytes\"\n    \"encoding/json\"\n    \"errors\"\n    \"net/http\"\n    \"sync\"\n    \"time\"\n\n    \"mlgateway/internal/store\"\n)\n\nvar ErrNotFound = errors.New(\"not found\")\n\ntype Service struct {\n    store   *store.Store\n    timeout time.Duration\n}\n\nfunc New(s *store.Store, timeoutSec int) *Service {\n    if timeoutSec <= 0 {\n        timeoutSec = 5\n    }\n    return &Service{store: s, timeout: time.Duration(timeoutSec) * time.Second}\n}\n\nfunc validEvent(event string) bool {\n    switch event {\n    case \"model.created\", \"model.deleted\", \"version.uploaded\", \"version.deployed\", \"version.undeployed\", \"inference.completed\":\n        return true\n    default:\n        return false\n    }\n}\n\nfunc (s *Service) Register(url string, events []string) (*store.Webhook, error) {\n    if url == \"\" {\n        return nil, errors.New(\"url is required\")\n    }\n    filtered := []string{}\n    for _, e := range events {\n        if validEvent(e) {\n            filtered = append(filtered,"]
[1590.114059, "i", " e)\n        }\n    }\n    if len(filtered) == 0 {\n        return nil, errors.New(\"at least one valid event is required\")\n    }\n\n    var created *store.Webhook\n    err := s.store.WithLock(func(d *store.Data) error {\n        wh := store.Webhook{\n            ID:        store.NewID(),\n            URL:       url,\n            Events:    filtered,\n            CreatedAt: time.Now().UTC(),\n        }\n        d.Webhooks = append(d.Webhooks, wh)\n        created = &d.Webhooks[len(d.Webhooks)-1]\n        return nil\n    })\n    if err != nil {\n        return nil, err\n    }\n    return created, nil\n}\n\nfunc (s *Service) List() []store.Webhook {\n    var result []store.Webhook\n    _ = s.store.WithRLock(func(d *store.Data) error {\n        result = make([]store.Webhook, len(d.Webhooks))\n        copy(result, d.Webhooks)\n        return nil\n    })\n    return result\n}\n\nfunc (s *Service) Delete(id string) error {\n    err := s.store.WithLock(func(d *store.Data) error {\n        for i, wh := range d.Webhooks {\n            if wh.ID == id {\n   "]
[1590.114188, "i", "             d.Webhooks = append(d.Webhooks[:i], d.Webhooks[i+1:]...)\n                return nil\n            }\n        }\n        return ErrNotFound\n    })\n    return err\n}\n\nfunc (s *Service) Fire(event string, data interface{}) {\n    var targets []string\n    _ = s.store.WithRLock(func(d *store.Data) error {\n        for _, wh := range d.Webhooks {\n            for _, e := range wh.Events {\n                if e == event {\n                    targets = append(targets, wh.URL)\n                    break\n                }\n            }\n        }\n        return nil\n    })\n    if len(targets) == 0 {\n        return\n    }\n\n    payload := map[string]interface{}{\n        \"event\":     event,\n        \"timestamp\": time.Now().UTC().Format(time.RFC3339),\n        \"data\":      data,\n    }\n    body, err := json.Marshal(payload)\n    if err != nil {\n        return\n    }\n\n    var wg sync.WaitGroup\n    for _, target := range targets {\n        wg.Add(1)\n        go func(url string) {\n            defer wg.Done()\n            client := &h"]
