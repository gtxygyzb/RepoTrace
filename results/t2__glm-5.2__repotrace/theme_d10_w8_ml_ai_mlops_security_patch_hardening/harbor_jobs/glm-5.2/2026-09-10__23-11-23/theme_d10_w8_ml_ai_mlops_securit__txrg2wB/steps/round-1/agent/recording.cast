[2297.131752, "o", "sed -n '1,220p' internal/config/config.go\r\n\u001b[?2004l\r"]
[2297.134606, "o", "package config\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n)\r\n\r\ntype Config struct {"]
[2297.134781, "o", "\r\n\tPort                  int    `json:\"port\"`\r\n\tDataDir               string `json:\"data_dir\"`\r\n\tModelStorageDir       string `json:\"model_storage_dir\"`\r\n\tInferenceTimeoutSec   int    `json:\"inference_timeout_sec\"`\r\n\tMaxBatchSize          int    `json:\"max_batch_size\"`\r\n\tLogLevel              string `json:\"log_level\"`\r\n\tWebhookTimeoutSec     int    `json:\"webhook_timeout_sec\"`\r\n\tMetricsRetentionHours int    `json:\"metrics_retention_hours\"`\r\n\tMaxModelSizeMB        int    `json:\"max_model_size_mb\"`\r\n}\r\n\r\nfunc Default() *Config {\r\n\treturn &Config{\r\n\t\tPort:                  9090,\r\n\t\tDataDir:               \"/app/data\",\r\n\t\tModelStorageDir:       \"/app/data/models\",\r\n\t\tInferenceTimeoutSec:   30,\r\n\t\tMaxBatchSize:          100,\r\n\t\tLogLevel:              \"info\",\r\n\t\tWebhookTimeoutSec:     5,\r\n\t\tMetricsRetentionHours: 24,\r\n\t\tMaxModelSizeMB:        500,\r\n\t}\r\n}\r\n\r\nfunc Load(path string) (*Config, error) {\r\n\tcfg := Default()\r\n\r\n\tdata, err := os.ReadFile(path)\r\n"]
[2297.13489, "o", "\tif os.IsNotExist(err) {\r\n\t\tif err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tif err := Save(path, cfg); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn cfg, nil\r\n\t}\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif len(data) > 0 {\r\n\t\tif err := json.Unmarshal(data, cfg); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t}\r\n"]
[2297.135009, "o", "\r\n\tif cfg.Port <= 0 {\r\n\t\tcfg.Port = 9090\r\n\t}\r\n\tif cfg.DataDir == \"\" {\r\n\t\tcfg.DataDir = \"/app/data\"\r\n\t}\r\n\tif cfg.ModelStorageDir == \"\" {\r\n\t\tcfg.ModelStorageDir = \"/app/data/models\"\r\n\t}\r\n\tif cfg.InferenceTimeoutSec <= 0 {\r\n\t\tcfg.InferenceTimeoutSec = 30\r\n\t}\r\n\tif cfg.MaxBatchSize <= 0 {\r\n\t\tcfg.MaxBatchSize = 100\r\n\t}\r\n\tif cfg.LogLevel == \"\" {\r\n\t\tcfg.LogLevel = \"info\"\r\n\t}\r\n\tif cfg.WebhookTimeoutSec <= 0 {\r\n\t\tcfg.WebhookTimeoutSec = 5\r\n"]
[2297.135148, "o", "\t}\r\n\tif cfg.MetricsRetentionHours <= 0 {\r\n\t\tcfg.MetricsRetentionHours = 24\r\n\t}\r\n\tif cfg.MaxModelSizeMB <= 0 {\r\n\t\tcfg.MaxModelSizeMB = 500\r\n\t}\r\n\r\n\treturn cfg, nil\r\n}\r\n\r\nfunc Save(path string, cfg *Config) error {\r\n\tdata, err := json.MarshalIndent(cfg, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(path, data, 0644)\r\n}\r\n"]
[2297.135636, "o", "\u001b[?2004h"]
