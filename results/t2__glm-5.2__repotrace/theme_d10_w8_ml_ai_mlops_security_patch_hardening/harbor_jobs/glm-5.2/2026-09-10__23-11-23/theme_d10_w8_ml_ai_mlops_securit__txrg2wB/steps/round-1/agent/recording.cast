[1987.83988, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path(\"internal/auth/auth.go\")\ns = p.read_text()\n\ns = s.replace(\n    '\"crypto/rand\"\\n\\t\"crypto/sha256\"\\n\\t\"encoding/hex\"\\n\\t\"errors\"\\n\\t\"strings\"\\n\\t\"time\"',\n    '\"crypto/rand\"\\n\\t\"crypto/sha256\"\\n\\t\"crypto/subtle\"\\n\\t\"encoding/hex\"\\n\\t\"errors\"\\n\\t\"strings\"\\n\\t\"time\"',\n)\n\nold = \"\"\"func verifyPassword(password, hash string) bool {\\n\\tparts := strings.SplitN(hash, \\\":\\\", 2)\\n\\tif len(parts) != 2 {\\n\\t\\treturn false\\n\\t}\\n\\th := sha256.Sum256(append([]byte(parts[0]), []byte(password)...))\\n\\treturn hex.EncodeToString(h[:]) == parts[1]\\n}\"\"\"\n\nnew = \"\"\"func verifyPassword(password, hash string) bool {\\n\\tparts := strings.SplitN(hash, \\\":\\\", 2)\\n\\tif len(parts) != 2 {\\n\\t\\treturn false\\n\\t}\\n\\tsalt, err := hex.DecodeString(parts[0])\\n\\tif err != nil {\\n\\t\\treturn false\\n\\t}\\n\\texpected, err := hex.DecodeString(parts[1])\\n\\tif err != nil {\\n\\t\\treturn false\\n\\t}\\n\\th := sha256.Sum256(append(salt, []byte(password)...))\\n\\treturn subtle.ConstantTimeCompare(h[:], expected) "]
[1987.840229, "i", "== 1\\n}\"\"\"\n\nif old not in s:\n    raise SystemExit(\"target verifyPassword block not found\")\n\np.write_text(s.replace(old, new))\nPY\n"]
