[4090.592765, "i", "cat > internal/audit/audit_test.go <<'EOF'\npackage audit\n\nimport (\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc TestSanitizeDetail(t *testing.T) {\n\tcases := []struct {\n\t\tname string\n\t\tin   string\n\t\twant string\n\t}{\n\t\t{\n\t\t\tname: \"normal unchanged\",\n\t\t\tin:   \"role=admin\",\n\t\t\twant: \"role=admin\",\n\t\t},\n\t\t{\n\t\t\tname: \"space preserved\",\n\t\t\tin:   \"hello world\",\n\t\t\twant: \"hello world\",\n\t\t},\n\t\t{\n\t\t\tname: \"control chars removed\",\n\t\t\tin:   \"a\\x00b\\nc\\rd\\te\\x1bf\",\n\t\t\twant: \"abcdef\",\n\t\t},\n\t\t{\n\t\t\tname: \"ansi escape removed\",\n\t\t\tin:   \"\\x1b[31mred\\x1b[0m\",\n\t\t\twant: \"[31mred[0m\",\n\t\t},\n\t\t{\n\t\t\tname: \"truncate long ascii\",\n\t\t\tin:   strings.Repeat(\"x\", 300),\n\t\t\twant: strings.Repeat(\"x\", 256) + \"...[truncated]\",\n\t\t},\n\t\t{\n\t\t\tname: \"truncate multibyte\",\n\t\t\tin:   strings.Repeat(\"é\", 300),\n\t\t\twant: strings.Repeat(\"é\", 256) + \"...[truncated]\",\n\t\t},\n\t}\n\n\tfor _, tc := range cases {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tif got := sanitizeDetail(tc.in); got != tc.want {\n\t\t\t\tt.Errorf(\"sanitizeDetail(%q) = %q, want %q\", tc.in, got, tc.want)\n\t\t\t}\n\t\t})\n\t}"]
[4090.592975, "i", "\n}\nEOF\n"]
