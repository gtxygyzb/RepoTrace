[2782.522826, "o", "\t\tErrTooLarge   = errors.New(\"model binary too large\")\r\n    22\t)\r\n    23\t\r\n    24\tvar semverRe = regexp.MustCompile(`^[0-9]+\\.[0-9]+\\.[0-9]+$`)\r\n    25\t\r\n    26\ttype Service struct {\r\n    27\t\tstore           *store.Store\r\n    28\t\tmodelStorageDir string\r\n    29\t\tmaxModelSize    int64\r\n    30\t}\r\n    31\t\r\n    32\tfunc New(s *store.Store, modelStorageDir string, maxModelSizeMB int) *Service {\r\n    33\t\treturn &Service{\r\n    34\t\t\tstore:           s,\r\n"]
[2782.522925, "o", "    35\t\t\tmodelStorageDir: modelStorageDir,\r\n    36\t\t\tmaxModelSize:    int64(maxModelSizeMB) * 1024 * 1024,\r\n    37\t\t}\r\n    38\t}\r\n    39\t\r\n    40\tfunc ValidateFramework(framework string) error {\r\n    41\t\tswitch framework {\r\n    42\t\tcase \"tensorflow\", \"pytorch\", \"onnx\", \"custom\":\r\n    43\t\t\treturn nil"]
