[1761.753951, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1761.754005, "o", "\u001b[?2004h> "]
[1761.754233, "o", "        log.Fatalf(\"config: %v\", err)\r\n\u001b[?2004l\r"]
[1761.754297, "o", "\u001b[?2004h> "]
[1761.754351, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.754411, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.754465, "o", "> "]
[1761.754768, "o", "    if err := os.MkdirAll(cfg.DataDir, 0755); err != nil {\r\n\u001b[?2004l\r"]
[1761.754824, "o", "\u001b[?2004h> "]
[1761.755049, "o", "        log.Fatalf(\"data dir: %v\", err)\r\n\u001b[?2004l\r"]
[1761.755116, "o", "\u001b[?2004h> "]
[1761.755176, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.75523, "o", "> "]
[1761.755575, "o", "    if err := os.MkdirAll(cfg.ModelStorageDir, 0755); err != nil {\r\n\u001b[?2004l\r"]
[1761.755622, "o", "\u001b[?2004h> "]
[1761.755913, "o", "        log.Fatalf(\"model storage dir: %v\", err)\r\n\u001b[?2004l\r"]
[1761.755967, "o", "\u001b[?2004h> "]
[1761.756027, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.756081, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.756147, "o", "> "]
[1761.756343, "o", "    st, err := store.New(cfg.DataDir)\r\n\u001b[?2004l\r"]
[1761.756399, "o", "\u001b[?2004h> "]
[1761.756514, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1761.756568, "o", "\u001b[?2004h> "]
[1761.756777, "o", "        log.Fatalf(\"store: %v\", err)\r\n\u001b[?2004l\r"]
[1761.756833, "o", "\u001b[?2004h> "]
[1761.756886, "o", "    }\r\n\u001b[?2004l\r"]
[1761.756945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1761.757005, "o", "\u001b[?2004h> "]
[1761.757127, "o", "    as := auth.New(st)\r\n\u001b[?2004l\r"]
[1761.757183, "o", "\u001b[?2004h> "]
[1761.75756, "o", "    rs := registry.New(st, cfg.ModelStorageDir, cfg.MaxModelSizeMB)\r\n\u001b[?2004l\r"]
[1761.757628, "o", "\u001b[?2004h> "]
[1761.75791, "o", "    is := inference.New(rs, cfg.InferenceTimeoutSec)\r\n\u001b[?2004l\r"]
[1761.757957, "o", "\u001b[?2004h> "]
[1761.758186, "o", "    ms := metrics.New(st, startTime)\r\n\u001b[?2004l\r"]
[1761.758241, "o", "\u001b[?2004h> "]
[1761.758379, "o", "    aus := audit.New(st)\r\n\u001b[?2004l\r"]
[1761.758434, "o", "\u001b[?2004h> "]
[1761.75871, "o", "    ws := webhooks.New(st, cfg.WebhookTimeoutSec)\r\n\u001b[?2004l\r"]
[1761.758765, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1761.758819, "o", "\u001b[?2004h> "]
[1761.759204, "o", "    srv := server.New(cfg, st, as, rs, is, ms, aus, ws, startTime)\r\n\u001b[?2004l\r"]
[1761.759259, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1761.759316, "o", "\u001b[?2004h> "]
[1761.759488, "o", "    httpServer := &http.Server{\r\n\u001b[?2004l\r"]
[1761.759542, "o", "\u001b[?2004h> "]
[1761.759742, "o", "        Addr:    fmt.Sprintf(\":%d\", cfg.Port),\r\n\u001b[?2004l\r"]
[1761.759796, "o", "\u001b[?2004h> "]
[1761.759934, "o", "        Handler: srv.Routes(),\r\n\u001b[?2004l\r"]
[1761.75999, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1761.760047, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1761.760108, "o", "\u001b[?2004h> "]
[1761.760279, "o", "    serverErrors := make(chan error, 1)\r\n\u001b[?2004l\r"]
[1761.760335, "o", "\u001b[?2004h> "]
[1761.7604, "o", "    go func() {\r\n\u001b[?2004l\r"]
[1761.760454, "o", "\u001b[?2004h> "]
[1761.760662, "o", "        log.Printf(\"listening on :%d\", cfg.Port)\r\n\u001b[?2004l\r"]
[1761.760722, "o", "\u001b[?2004h> "]
[1761.760939, "o", "        serverErrors <- httpServer.ListenAndServe()\r\n\u001b[?2004l\r"]
[1761.760995, "o", "\u001b[?2004h> "]
[1761.761049, "o", "    }()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1761.761118, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1761.7613, "o", "    shutdown := make(chan os.Signal, 1)\r\n\u001b[?2004l\r"]
[1761.761355, "o", "\u001b[?2004h> "]
[1761.761616, "o", "    signal.Notify(shutdown, syscall.SIGTERM, syscall.SIGINT)\r\n\u001b[?2004l\r"]
[1761.76167, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1761.761724, "o", "\u001b[?2004h> "]
[1761.761787, "o", "    select {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.761841, "o", "> "]
[1761.761956, "o", "    case err := <-serverErrors:\r\n\u001b[?2004l\r"]
[1761.76201, "o", "\u001b[?2004h> "]
[1761.762255, "o", "        if err != nil && err != http.ErrServerClosed {\r\n\u001b[?2004l\r"]
[1761.762315, "o", "\u001b[?2004h> "]
[1761.762485, "o", "            log.Fatalf(\"server: %v\", err)\r\n\u001b[?2004l\r"]
[1761.76254, "o", "\u001b[?2004h> "]
[1761.762594, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.762649, "o", "> "]
[1761.762715, "o", "    case <-shutdown:\r\n\u001b[?2004l\r"]
[1761.762771, "o", "\u001b[?2004h> "]
[1761.762994, "o", "        log.Printf(\"shutting down\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.763334, "o", "        ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\r\n\u001b[?2004l\r"]
[1761.76339, "o", "\u001b[?2004h> "]
[1761.763485, "o", "        defer cancel()\r\n\u001b[?2004l\r"]
[1761.76354, "o", "\u001b[?2004h> "]
[1761.763696, "o", "        _ = httpServer.Shutdown(ctx)\r\n\u001b[?2004l\r"]
[1761.763753, "o", "\u001b[?2004h> "]
[1761.763807, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.763861, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.763915, "o", "EOF\r\n\u001b[?2004l\r"]
