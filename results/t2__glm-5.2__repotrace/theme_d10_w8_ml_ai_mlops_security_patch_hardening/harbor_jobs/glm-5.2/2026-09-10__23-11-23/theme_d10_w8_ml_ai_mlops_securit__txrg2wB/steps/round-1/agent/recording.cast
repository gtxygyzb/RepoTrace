[484.665023, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func Save(path string, cfg *Config) error {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007data, err := json.MarshalIndent(cfg, \"\", \"  \")\r\n\u001b[?2004l\r\u001b[?2004h> \u0007if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\r\ngo.mod    internal/ \r\n> return err\r\n\u001b[?2004l\r\u001b[?2004h> \u0007}\r\n\u001b[?2004l\r\u001b[?2004h> \u0007if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\r\ngo.mod    internal/ \r\n> return err\r\n\u001b[?2004l\r\u001b[?2004h> \u0007}\r\n\u001b[?2004l\r\u001b[?2004h> \u0007return os.WriteFile(path, data, 0644)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
