[2291.142688, "o", "\u001b[35m\u001b[K./internal/server/handlers.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif err := r.ParseMultipartForm(int64(s.cfg.\u001b[01;31m\u001b[KMaxModelSize\u001b[m\u001b[KMB) * 1024 * 1024); err != nil {\r\n"]
[2291.142767, "o", "\u001b[35m\u001b[K./internal/server/handlers.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tbody, err := \u001b[01;31m\u001b[Kio.ReadAll\u001b[m\u001b[K(r.Body)\r\n"]
[2291.142939, "o", "\u001b[35m\u001b[K./internal/server/handlers.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K530\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif v, ok := patch[\"\u001b[01;31m\u001b[Kmax_model_size_mb\u001b[m\u001b[K\"]; ok {\r\n\u001b[35m\u001b[K./internal/server/handlers.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K532\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.\u001b[01;31m\u001b[KMaxModelSize\u001b[m\u001b[KMB = int(f)\r\n"]
