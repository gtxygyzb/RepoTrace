[1848.059476, "o", "package store\r\n\r\nimport (\r\n\t\"crypto/rand\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t"]
[1848.059564, "o", "\"errors\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\ntype User struct {\r\n\tID           string    `json:\"id\"`\r\n\tUsername     string    `json:\"username\"`\r\n\tPasswordHash string    `json:\"password_hash\"`\r\n\tRole         string    `json:\"role\"`\r\n\tAPIKey       string    `json:\"api_key\"`\r\n\tCreatedAt    time.Time `json:\"created_at\"`\r\n}\r\n"]
[1848.059643, "o", "\r\ntype Lineage struct {\r\n\tTrainingDataset string             `json:\"training_dataset\"`\r\n\tParentModel     string             `json:\"parent_model\"`\r\n\tTrainingMetrics map[string]float64 `json:\"training_metrics\"`\r\n}\r\n\r\ntype Version struct {\r\n\tVersion      string    `json:\"version\"`\r\n\tReleaseNotes string    `json:\"release_notes\"`\r\n\tBinaryPath   string    `json:\"binary_path\"`\r\n\t"]
[1848.059724, "o", "Status       string    `json:\"status\"`\r\n\tCreatedAt    time.Time `json:\"created_at\"`\r\n\tSize         int64     `json:\"size\"`\r\n}\r\n\r\ntype Model struct {\r\n\tID           string            `json:\"id\"`\r\n\tName         string            `json:\"name\"`\r\n\tFramework    string            `json:\"framework\"`\r\n\tDescription  string            `json:\"description\"`\r\n\tAuthor       string            `json:\"author\"`\r\n\tCreatedAt    time.Time         `json:\"created_at\"`\r\n\tInputSchema  json.RawMessage   `json:\"input_schema\"`\r\n\tOutputSchema json.RawMessage   `json:\"output_schema\"`\r\n"]
[1848.059809, "o", "\tLabels       map[string]string `json:\"labels\"`\r\n\tLineage      Lineage           `json:\"lineage\"`\r\n\tVersions     []*Version        `json:\"versions\"`\r\n}\r\n\r\ntype Webhook struct {\r\n\tID        string    `json:\"id\"`\r\n\tURL       string    `json:\"url\"`\r\n\t"]
[1848.059862, "o", "Events    []string  `json:\"events\"`\r\n\tCreatedAt time.Time `json:\"created_at\"`\r\n}\r\n\r\ntype AuditEntry struct {\r\n\tTimestamp    time.Time `json:\"timestamp\"`\r\n\tUser         string    `json:\"user\"`\r\n\tAction       string    `json:\"action\"`\r\n\tResourceType string    `json:\"resource_type\"`\r\n\tResourceID   string    `json:\"resource_id\"`\r\n\tDetails      string    `json:\"details\"`\r\n\tSourceIP     string    `json:\"source_ip\"`\r\n}\r\n\r\ntype MetricsState struct {\r\n\tTotalInferences    int64            `json:\"total_inferences\"`\r\n\tTotalErrors        int64            `json:\"error_count\"`\r\n\t"]
[1848.059948, "o", "LatencySumMs       float64          `json:\"latency_sum_ms\"`\r\n\tInferencesPerModel map[string]int64 `json:\"inferences_per_model\"`\r\n}\r\n\r\ntype Data struct {\r\n\tUsers    []User            `json:\"users\"`\r\n\tModels   map[string]*Model `json:\"models\"`\r\n\tWebhooks []Webhook         `json:\"webhooks\"`\r\n\tAudit    []AuditEntry      `json:\"audit\"`\r\n\tMetrics  MetricsState      `json:\"metrics\"`\r\n}\r\n\r\ntype Store struct {\r\n\tmu      sync.RWMutex\r\n\tdata    *Data\r\n\tdataDir string\r\n}\r\n"]
[1848.060017, "o", "\r\nfunc NewID() string {\r\n\tb := make([]byte, 16)\r\n\t_, err := rand.Read(b)\r\n\tif err != nil {\r\n\t\treturn time.Now().UTC().Format(\"20060102150405.000000\")\r\n"]
[1848.060087, "o", "\t}\r\n\treturn hex.EncodeToString(b)\r\n}\r\n\r\nfunc New(dataDir string) (*Store, error) {\r\n\tif err := os.MkdirAll(dataDir, 0755); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\ts := &Store{\r\n\t\tdataDir: dataDir,\r\n\t\tdata: &Data{\r\n\t\t\tModels: make(map[string]*Model),\r\n\t\t\tMetrics: MetricsState{\r\n\t\t\t\tInferencesPerModel: make(map[string]int64),\r\n"]
[1848.060166, "o", "\t\t\t},\r\n\t\t},\r\n\t}\r\n\tif err := s.load(); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn s, nil\r\n}\r\n\r\nfunc (s *Store) WithLock(fn func(d *Data) error) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n"]
