[1760.930228, "i", "   registry:  rs,\r        inference: is,\r        metrics:   ms,\r        audit:     aus,\r        webhooks:  ws,\r        startTime: startTime,\r    }\r}\r\rfunc writeJSON(w http.ResponseWriter, status int, v interface{}) {\r    w.Header().Set(\"Content-Type\", \"application/json\")\r    w.WriteHeader(status)\r    _ = json.NewEncoder(w).Encode(v)\r}\r\rfunc writeError(w http.ResponseWriter, status int, msg string) {\r    writeJSON(w, status, map[string]string{\"error\": msg})\r}\r\rfunc (s *Server) auditReq(r *http.Request, user, action, resourceType, resourceID, details string) {\r    s.audit.Add(user, action, resourceType, resourceID, details, clientIP(r))\r}\r\rfunc clientIP(r *http.Request) string {\r    if ip := r.Header.Get(\"X-Forwarded-For\"); ip != \"\" {\r        return strings.Split(ip, \",\")[0]\r    }\r    return r.RemoteAddr\r}\r\rfunc (s *Server) Health(w http.ResponseWriter, r *http.Request) {\r    writeJSON(w, http.StatusOK, map[string]interface{}{\r        \"status\":          \"healthy\",\r        \"uptime_seconds\":  int64(time.Since(s.s"]
