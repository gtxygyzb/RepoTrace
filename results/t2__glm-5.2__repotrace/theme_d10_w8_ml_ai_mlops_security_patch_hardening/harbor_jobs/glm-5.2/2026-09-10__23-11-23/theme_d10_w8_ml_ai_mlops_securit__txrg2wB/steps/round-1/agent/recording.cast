[2759.737253, "o", "\u001b[35m\u001b[Kinternal/registry/registry.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif existing.\u001b[01;31m\u001b[KName \u001b[m\u001b[K== m.\u001b[01;31m\u001b[KName \u001b[m\u001b[K{\r\n\u001b[35m\u001b[Kinternal/registry/registry.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif m.\u001b[01;31m\u001b[KName \u001b[m\u001b[K== name {\r\n"]
