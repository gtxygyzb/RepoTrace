[1590.119068, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1590.119138, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1590.119196, "o", "\u001b[?2004h> "]
[1590.119403, "o", "func validEvent(event string) bool {\r\n\u001b[?2004l\r"]
[1590.119459, "o", "\u001b[?2004h> "]
[1590.119567, "o", "    switch event {\r\n\u001b[?2004l\r"]
[1590.119629, "o", "\u001b[?2004h> "]
[1590.120343, "o", "    case \"model.created\", \"model.deleted\", \"version.uploaded\", \"version.deployed\", \"version.undeployed\", \"inference.completed\":\r\n\u001b[?2004l\r"]
[1590.120403, "o", "\u001b[?2004h> "]
[1590.120513, "o", "        return true\r\n\u001b[?2004l\r"]
[1590.120568, "o", "\u001b[?2004h> "]
[1590.120647, "o", "    default:\r\n\u001b[?2004l\r"]
[1590.120705, "o", "\u001b[?2004h> "]
[1590.120821, "o", "        return false\r\n\u001b[?2004l\r"]
[1590.120877, "o", "\u001b[?2004h> "]
[1590.120943, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.121, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.121054, "o", "> \r\n\u001b[?2004l\r"]
[1590.121119, "o", "\u001b[?2004h> "]
[1590.121557, "o", "func (s *Service) Register(url string, events []string) (*store.Webhook, error) {\r\n\u001b[?2004l\r"]
[1590.121613, "o", "\u001b[?2004h> "]
[1590.121722, "o", "    if url == \"\" {\r\n\u001b[?2004l\r"]
[1590.121779, "o", "\u001b[?2004h> "]
[1590.12206, "o", "        return nil, errors.New(\"url is required\")\r\n\u001b[?2004l\r"]
[1590.122114, "o", "\u001b[?2004h> "]
[1590.122175, "o", "    }\r\n\u001b[?2004l\r"]
[1590.12223, "o", "\u001b[?2004h> "]
[1590.122367, "o", "    filtered := []string{}\r\n\u001b[?2004l\r"]
[1590.122423, "o", "\u001b[?2004h> "]
[1590.1226, "o", "    for _, e := range events {\r\n\u001b[?2004l\r"]
[1590.122656, "o", "\u001b[?2004h> "]
[1590.122807, "o", "        if validEvent(e) {\r\n\u001b[?2004l\r"]
[1590.122872, "o", "\u001b[?2004h> "]
[1590.12312, "o", "            filtered = append(filtered, e)\r\n\u001b[?2004l\r"]
[1590.123184, "o", "\u001b[?2004h> "]
[1590.12324, "o", "        }\r\n\u001b[?2004l\r"]
[1590.1233, "o", "\u001b[?2004h> "]
[1590.123355, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.123409, "o", "> "]
[1590.123547, "o", "    if len(filtered) == 0 {\r\n\u001b[?2004l\r"]
[1590.123601, "o", "\u001b[?2004h> "]
[1590.123997, "o", "        return nil, errors.New(\"at least one valid event is required\")\r\n\u001b[?2004l\r"]
[1590.124052, "o", "\u001b[?2004h> "]
[1590.124116, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.124189, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.124325, "o", "    var created *store.Webhook\r\n\u001b[?2004l\r"]
[1590.124381, "o", "\u001b[?2004h> "]
[1590.124619, "o", "    err := s.store.WithLock(func(d *store.Data) error {\r\n\u001b[?2004l\r"]
[1590.124673, "o", "\u001b[?2004h> "]
[1590.124798, "o", "        wh := store.Webhook{\r\n\u001b[?2004l\r"]
[1590.124852, "o", "\u001b[?2004h> "]
[1590.125012, "o", "            ID:        store.NewID(),\r\n\u001b[?2004l\r"]
[1590.125068, "o", "\u001b[?2004h> "]
[1590.125189, "o", "            URL:       url,\r\n\u001b[?2004l\r"]
[1590.125244, "o", "\u001b[?2004h> "]
[1590.125381, "o", "            Events:    filtered,\r\n\u001b[?2004l\r"]
[1590.125436, "o", "\u001b[?2004h> "]
[1590.125608, "o", "            CreatedAt: time.Now().UTC(),\r\n\u001b[?2004l\r"]
[1590.125663, "o", "\u001b[?2004h> "]
[1590.125718, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.125772, "o", "> "]
[1590.12594, "o", "        d.Webhooks = append(d.Webhooks, wh)\r\n\u001b[?2004l\r"]
[1590.125994, "o", "\u001b[?2004h> "]
[1590.126213, "o", "        created = &d.Webhooks[len(d.Webhooks)-1]\r\n\u001b[?2004l\r"]
[1590.126269, "o", "\u001b[?2004h> "]
[1590.126343, "o", "        return nil\r\n\u001b[?2004l\r"]
[1590.126399, "o", "\u001b[?2004h> "]
[1590.126454, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.126555, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1590.126611, "o", "\u001b[?2004h> "]
[1590.126709, "o", "        return nil, err\r\n\u001b[?2004l\r"]
[1590.126765, "o", "\u001b[?2004h> "]
[1590.126832, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.126935, "o", "    return created, nil\r\n\u001b[?2004l\r"]
[1590.126989, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1590.127043, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1590.127097, "o", "\u001b[?2004h> "]
[1590.12729, "o", "func (s *Service) List() []store.Webhook {\r\n\u001b[?2004l\r"]
[1590.127346, "o", "\u001b[?2004h> "]
[1590.127473, "o", "    var result []store.Webhook\r\n\u001b[?2004l\r"]
[1590.127528, "o", "\u001b[?2004h> "]
[1590.12776, "o", "    _ = s.store.WithRLock(func(d *store.Data) error {\r\n\u001b[?2004l\r"]
[1590.127815, "o", "\u001b[?2004h> "]
[1590.128053, "o", "        result = make([]store.Webhook, len(d.Webhooks))\r\n\u001b[?2004l\r"]
[1590.128117, "o", "\u001b[?2004h> "]
[1590.128253, "o", "        copy(result, d.Webhooks)\r\n\u001b[?2004l\r"]
[1590.128309, "o", "\u001b[?2004h> "]
[1590.128388, "o", "        return nil\r\n\u001b[?2004l\r"]
[1590.128444, "o", "\u001b[?2004h> "]
[1590.128499, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.128591, "o", "    return result\r\n\u001b[?2004l\r"]
[1590.128645, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1590.1287, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1590.128759, "o", "\u001b[?2004h> "]
[1590.128934, "o", "func (s *Service) Delete(id string) error {\r\n\u001b[?2004l\r"]
[1590.128989, "o", "\u001b[?2004h> "]
[1590.129237, "o", "    err := s.store.WithLock(func(d *store.Data) error {\r\n\u001b[?2004l\r"]
[1590.129292, "o", "\u001b[?2004h> "]
[1590.129461, "o", "        for i, wh := range d.Webhooks {\r\n\u001b[?2004l\r"]
[1590.129517, "o", "\u001b[?2004h> "]
[1590.129641, "o", "            if wh.ID == id {\r\n\u001b[?2004l\r"]
[1590.129696, "o", "\u001b[?2004h> "]
[1590.130013, "o", "                d.Webhooks = append(d.Webhooks[:i], d.Webhooks[i+1:]...)\r\n\u001b[?2004l\r"]
[1590.130069, "o", "\u001b[?2004h> "]
[1590.130186, "o", "                return nil\r\n\u001b[?2004l\r"]
[1590.130242, "o", "\u001b[?2004h> "]
[1590.130293, "o", "            }\r\n\u001b[?2004l\r"]
[1590.130348, "o", "\u001b[?2004h> "]
[1590.13041, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.130466, "o", "> "]
[1590.130556, "o", "        return ErrNotFound\r\n\u001b[?2004l\r"]
[1590.130611, "o", "\u001b[?2004h> "]
[1590.130666, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.130745, "o", "    return err\r\n\u001b[?2004l\r"]
[1590.130799, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1590.130853, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1590.130908, "o", "\u001b[?2004h> "]
[1590.131158, "o", "func (s *Service) Fire(event string, data interface{}) {\r\n\u001b[?2004l\r"]
[1590.131213, "o", "\u001b[?2004h> "]
[1590.131316, "o", "    var targets []string\r\n\u001b[?2004l\r"]
[1590.13137, "o", "\u001b[?2004h> "]
[1590.131601, "o", "    _ = s.store.WithRLock(func(d *store.Data) error {\r\n\u001b[?2004l\r"]
[1590.131655, "o", "\u001b[?2004h> "]
[1590.131826, "o", "        for _, wh := range d.Webhooks {\r\n\u001b[?2004l\r"]
[1590.131881, "o", "\u001b[?2004h> "]
[1590.132062, "o", "            for _, e := range wh.Events {\r\n\u001b[?2004l\r"]
[1590.132132, "o", "\u001b[?2004h> "]
[1590.132255, "o", "                if e == event {\r\n\u001b[?2004l\r"]
[1590.132313, "o", "\u001b[?2004h> "]
[1590.132541, "o", "                    targets = append(targets, wh.URL)\r\n\u001b[?2004l\r"]
[1590.132596, "o", "\u001b[?2004h> "]
[1590.132702, "o", "                    break\r\n\u001b[?2004l\r"]
[1590.132766, "o", "\u001b[?2004h> "]
[1590.132832, "o", "                }\r\n\u001b[?2004l\r"]
[1590.132887, "o", "\u001b[?2004h> "]
[1590.13294, "o", "            }\r\n\u001b[?2004l\r"]
[1590.132995, "o", "\u001b[?2004h> "]
[1590.133049, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.133112, "o", "> "]
[1590.133168, "o", "        return nil\r\n\u001b[?2004l\r"]
[1590.133224, "o", "\u001b[?2004h> "]
[1590.133278, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.133414, "o", "    if len(targets) == 0 {\r\n\u001b[?2004l\r"]
[1590.133469, "o", "\u001b[?2004h> "]
[1590.133528, "o", "        return\r\n\u001b[?2004l\r"]
[1590.133582, "o", "\u001b[?2004h> "]
[1590.133637, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1590.133703, "o", "\u001b[?2004h> "]
[1590.133869, "o", "    payload := map[string]interface{}{\r\n\u001b[?2004l\r"]
[1590.133894, "o", "\u001b[?2004h"]
[1590.133914, "o", "> "]
[1590.165097, "o", "        \"event\":     event,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.165349, "o", "        \"timestamp\": time.Now().UTC().Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[1590.165409, "o", "\u001b[?2004h> "]
[1590.165562, "o", "        \"data\":      data,\r\n\u001b[?2004l\r"]
[1590.165618, "o", "\u001b[?2004h> "]
[1590.165678, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.165734, "o", "> "]
[1590.165927, "o", "    body, err := json.Marshal(payload)\r\n\u001b[?2004l\r"]
[1590.165983, "o", "\u001b[?2004h> "]
[1590.166106, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1590.166164, "o", "\u001b[?2004h> "]
[1590.166251, "o", "        return\r\n\u001b[?2004l\r"]
[1590.166308, "o", "\u001b[?2004h> "]
[1590.166362, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.166417, "o", "> \r\n\u001b[?2004l\r"]
[1590.166484, "o", "\u001b[?2004h> "]
[1590.166605, "o", "    var wg sync.WaitGroup\r\n\u001b[?2004l\r"]
[1590.166661, "o", "\u001b[?2004h> "]
[1590.166869, "o", "    for _, target := range targets {\r\n\u001b[?2004l\r"]
[1590.166923, "o", "\u001b[?2004h> "]
[1590.167028, "o", "        wg.Add(1)\r\n\u001b[?2004l\r"]
[1590.167074, "o", "\u001b[?2004h> "]
[1590.167266, "o", "        go func(url string) {\r\n\u001b[?2004l\r"]
[1590.167297, "o", "\u001b[?2004h"]
[1590.167514, "o", ">             defer wg.Done()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.167841, "o", "            client := &http.Client{Timeout: s.timeout}\r\n\u001b[?2004l\r"]
[1590.167934, "o", "\u001b[?2004h"]
[1590.16803, "o", "> "]
[1590.168383, "o", "            resp, err := client.Post(url, \"application/json\", bytes.NewReader(body))\r\n\u001b[?2004l\r"]
[1590.168471, "o", "\u001b[?2004h"]
[1590.168566, "o", "> "]
[1590.168672, "o", "            if err == nil {\r\n\u001b[?2004l\r"]
[1590.168771, "o", "\u001b[?2004h> "]
[1590.168869, "o", "                _ = resp.Body.Close()\r\n\u001b[?2004l\r"]
[1590.168966, "o", "\u001b[?2004h"]
[1590.169068, "o", ">             }\r\n\u001b[?2004l\r"]
[1590.169182, "o", "\u001b[?2004h> "]
[1590.16928, "o", "        }(target)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.169378, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.169481, "o", "    wg.Wait()\r\n\u001b[?2004l\r"]
[1590.169579, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.169672, "o", "> EOF\r\n\u001b[?2004l\r"]
[1590.172461, "o", "\u001b[?2004h"]
[1590.172551, "o", "root@n30009:/app# "]
[1590.393183, "i", "cat > internal/inference/inference.go <<'EOF'\npackage inference\n\nimport (\n    \"bytes\"\n    \"context\"\n    \"encoding/json\"\n    \"errors\"\n    \"fmt\"\n    \"os/exec\"\n    \"time\"\n\n    \"mlgateway/internal/registry\"\n    \"mlgateway/internal/store\"\n)\n\nvar ErrNotDeployed = errors.New(\"model not deployed\")\n\ntype Service struct {\n    registry *registry.Service\n    timeout  time.Duration\n}\n\nfunc New(r *registry.Service, timeoutSec int) *Service {\n    if timeoutSec <= 0 {\n        timeoutSec = 30\n    }\n    return &Service{registry: r, timeout: time.Duration(timeoutSec) * time.Second}\n}\n\nfunc (s *Service) Infer(modelName string, input json.RawMessage) (map[string]interface{}, *store.Model, *store.Version, float64, error) {\n    model, version, err := s.registry.FindDeployedByName(modelName)\n    if err != nil {\n        return nil, nil, nil, 0, ErrNotDeployed\n    }\n\n    start := time.Now()\n    out, err := s.runBinary(version.BinaryPath, input)\n    latency := float64(time.Since(start).Microseconds()) / 1000.0\n    if err != nil {\n     "]
[1590.393436, "i", "   return nil, model, version, latency, err\n    }\n\n    var result map[string]interface{}\n    if err := json.Unmarshal(out, &result); err != nil {\n        return nil, model, version, latency, fmt.Errorf(\"invalid model output: %w\", err)\n    }\n    return result, model, version, latency, nil\n}\n\nfunc (s *Service) runBinary(binaryPath string, input json.RawMessage) ([]byte, error) {\n    ctx, cancel := context.WithTimeout(context.Background(), s.timeout)\n    defer cancel()\n\n    cmd := exec.CommandContext(ctx, binaryPath)\n    cmd.Stdin = bytes.NewReader(input)\n    var stdout, stderr bytes.Buffer\n    cmd.Stdout = &stdout\n    cmd.Stderr = &stderr\n\n    err := cmd.Run()\n    if ctx.Err() == context.DeadlineExceeded {\n        return nil, fmt.Errorf(\"inference timed out\")\n    }\n    if err != nil {\n        return nil, fmt.Errorf(\"inference failed: %v: %s\", err, stderr.String())\n    }\n    return stdout.Bytes(), nil\n}\nEOF\n"]
[1590.393551, "o", "cat > internal/inference/inference.go <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> package inference\r\n\u001b[?2004l\r"]
[1590.393723, "o", "   return nil, model, version, latency, err\r\n    }\r\n\r\n    var result map[string]interface{}\r\n    if err := json.Unmarshal(out, &result); err != nil {\r\n        return nil, model, version, latency, fmt.Errorf(\"invalid model output: %w\", err)\r\n    }\r\n "]
[1590.393843, "o", "   return result, model, version, latency, nil\r\n}\r\n\r\nfunc (s *Service) runBinary(binaryPath string, input json.RawMessage) ([]byte, error) {\r\n    ctx, cancel := context.WithTimeout(context.Background(), s.timeout)\r\n    defer cancel()\r\n\r\n    cmd := exec."]
[1590.393966, "o", "CommandContext(ctx, binaryPath)\r\n    cmd.Stdin = bytes.NewReader(input)\r\n    var stdout, stderr bytes.Buffer\r\n    cmd.Stdout = &stdout\r\n    cmd.Stderr = &stder"]
[1590.394036, "o", "r\r\n\r\n    err := cmd.Run()\r\n    if ctx.Err() == context.DeadlineExceeded {\r\n        return n"]
[1590.394115, "o", "il, fmt.Errorf(\"inference timed out\")\r\n    }\r\n    if err"]
[1590.394182, "o", " != nil {\r\n        return nil, fmt.Errorf(\"inference failed: %v: %s\", err, stderr.String())\r\n "]
[1590.394244, "o", "   }\r\n    return stdout.Bytes(), nil\r\n}\r\nEOF\r\n\u001b[?2004h> \r\n\u001b[?2004l\r"]
