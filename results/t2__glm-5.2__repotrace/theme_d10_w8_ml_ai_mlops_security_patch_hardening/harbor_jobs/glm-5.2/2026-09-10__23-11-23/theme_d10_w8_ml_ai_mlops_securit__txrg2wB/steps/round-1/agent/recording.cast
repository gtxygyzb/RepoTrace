[1401.100569, "o", "func ValidateSemver(version string) error {\r\n\u001b[?2004l\r"]
[1401.100621, "o", "\u001b[?2004h> "]
[1401.100896, "o", "    if !semverRe.MatchString(version) {\r\n\u001b[?2004l\r"]
[1401.100946, "o", "\u001b[?2004h> "]
[1401.101532, "o", "        return fmt.Errorf(\"%w: invalid semantic version %q\", ErrValidation, version)\r\n\u001b[?2004l\r"]
[1401.101586, "o", "\u001b[?2004h"]
[1401.101599, "o", "> "]
[1401.101707, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.10179, "o", "    return nil\r\n\u001b[?2004l\r"]
[1401.101846, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
