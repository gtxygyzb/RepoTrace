[2307.254184, "o", "\t\taudit:     aus,\r\n    44\t\t\twebhooks:  ws,\r\n    45\t\t\tstartTime: startTime,\r\n    46\t\t}\r\n    47\t}\r\n    48\t\r\n    49\tfunc writeJSON(w http.ResponseWriter, status int, v interface{}) {\r\n    50\t\tw.Header().Set(\"Content-Type\", \"application/json\")\r\n    51\t\t"]
[2307.254314, "o", "w.WriteHeader(status)\r\n    52\t\t_ = json.NewEncoder(w).Encode(v)\r\n    53\t}\r\n    54\t\r\n    55\tfunc writeError(w http.ResponseWriter, status int, msg string) {\r\n    56\t\twriteJSON(w, status, map[string]string{\"error\": msg})\r\n    57\t}\r\n    58\t\r\n    59\tfunc (s *Server) auditReq(r *http.Request, user, action, resourceType, resourceID, details string) {\r\n    60\t\ts.audit.Add(user, action, resourceType, resourceID, details, clientIP(r))\r\n    61\t}\r\n    62\t\r\n    63\tfunc clientIP(r *http.Request) string {\r\n    64\t\tif ip := r.Header.Get(\"X-Forwarded-For\"); ip != \"\" {\r\n    65\t\t\treturn strings.Split(ip, \",\")[0]\r\n    66\t\t}\r\n    67\t\treturn r.RemoteAddr\r\n    68\t}\r\n    69"]
[2307.254392, "o", "\t\r\n    70\tfunc (s *Server) Health(w http.ResponseWriter, r *http.Request) {\r\n    71\t\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n    72\t\t\t\"status\":         \"healthy\",\r\n    73\t\t\t\"uptime_seconds\": int64(time.Since(s.startTime).Seconds()),\r\n    74\t\t})\r\n"]
