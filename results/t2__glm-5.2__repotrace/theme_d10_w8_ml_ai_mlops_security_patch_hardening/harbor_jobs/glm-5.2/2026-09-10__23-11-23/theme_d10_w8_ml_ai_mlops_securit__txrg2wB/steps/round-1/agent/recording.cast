[1761.08499, "o", "\u001b[?2004h> "]
[1761.08519, "o", "    user, ok := s.requireAuth(w, r, auth.RoleAdmin)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.085248, "o", "> "]
[1761.085303, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.085366, "o", "        return\r\n\u001b[?2004l\r"]
[1761.085421, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1761.085477, "o", "\u001b[?2004h> "]
[1761.085572, "o", "    id := r.PathValue(\"id\")\r\n\u001b[?2004l\r"]
[1761.085627, "o", "\u001b[?2004h> "]
[1761.085798, "o", "    if err := s.webhooks.Delete(id); err != nil {\r\n\u001b[?2004l\r"]
[1761.085853, "o", "\u001b[?2004h> "]
[1761.086075, "o", "        writeError(w, http.StatusNotFound, \"webhook not found\")\r\n\u001b[?2004l\r"]
[1761.086139, "o", "\u001b[?2004h> "]
[1761.086194, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.086249, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.086304, "o", "> "]
[1761.086537, "o", "    s.auditReq(r, user.Username, \"webhook.delete\", \"webhook\", id, \"\")\r\n\u001b[?2004l\r"]
[1761.086592, "o", "\u001b[?2004h> "]
[1761.086847, "o", "    writeJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n\u001b[?2004l\r"]
[1761.086902, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
