[1502.942064, "i", "cat > internal/metrics/metrics.go <<'EOF'\npackage metrics\n\nimport (\n    \"mlgateway/internal/store\"\n    \"time\"\n)\n\ntype Service struct {\n    store     *store.Store\n    startTime time.Time\n}\n\nfunc New(s *store.Store, startTime time.Time) *Service {\n    return &Service{store: s, startTime: startTime}\n}\n\nfunc (s *Service) RecordInference(modelName string, latencyMs float64, isError bool) {\n    _ = s.store.WithLock(func(d *store.Data) error {\n        d.Metrics.TotalInferences++\n        if isError {\n            d.Metrics.TotalErrors++\n        } else {\n            d.Metrics.LatencySumMs += latencyMs\n        }\n        d.Metrics.InferencesPerModel[modelName]++\n        return nil\n    })\n}\n\nfunc (s *Service) Get() map[string]interface{} {\n    var totalModels, deployedModels int\n    var totalInferences, totalErrors int64\n    var latencySum float64\n    var perModel map[string]int64\n\n    _ = s.store.WithRLock(func(d *store.Data) error {\n        totalModels = len(d.Models)\n        for _, m := range d.Models {\n            for"]
[1502.942329, "i", " _, v := range m.Versions {\n                if v.Status == \"deployed\" {\n                    deployedModels++\n                    break\n                }\n            }\n        }\n        totalInferences = d.Metrics.TotalInferences\n        totalErrors = d.Metrics.TotalErrors\n        latencySum = d.Metrics.LatencySumMs\n        perModel = make(map[string]int64, len(d.Metrics.InferencesPerModel))\n        for k, v := range d.Metrics.InferencesPerModel {\n            perModel[k] = v\n        }\n        return nil\n    })\n\n    avg := 0.0\n    if totalInferences > 0 {\n        avg = latencySum / float64(totalInferences)\n    }\n\n    return map[string]interface{}{\n        \"total_models\":             totalModels,\n        \"deployed_models\":          deployedModels,\n        \"total_inferences\":         totalInferences,\n        \"avg_inference_latency_ms\": avg,\n        \"inferences_per_model\":     perModel,\n        \"error_count\":              totalErrors,\n        \"uptime_seconds\":           int64(time.Since(s.startTime).Seconds()),\n  "]
[1502.942446, "i", "  }\n}\nEOF\n"]
