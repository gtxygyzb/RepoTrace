[2452.01449, "o", "package server\r\n\r\nimport (\r\n\t\"net/http\"\r\n)\r\n\r\nfunc (s *Server) Routes() http.Handler {\r\n"]
[2452.014573, "o", "\tmux := http.NewServeMux()\r\n\r\n\tmux.HandleFunc(\"GET /api/v1/health\", s.Health)\r\n\r\n\tmux.HandleFunc(\"POST /api/v1/auth/register\", s.RegisterUser)\r\n\tmux.HandleFunc(\"POST /api/v1/auth/login\", s.Login)\r\n\r\n\tmux.HandleFunc(\"POST /api/v1/models\", s.RegisterModel)\r\n\tmux.HandleFunc(\"GET /api/v1/models\", s.ListModels)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{id}\", s.GetModel)\r\n\tmux.HandleFunc(\"DELETE /api/v1/models/{id}\", s.DeleteModel)\r\n\tmux.HandleFunc(\"POST /api/v1/models/{id}/versions\", s.UploadVersion)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{id}/versions\", s.ListVersions)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{id}/versions/{version}/download\", s.DownloadVersion)\r\n\t"]
[2452.014654, "o", "mux.HandleFunc(\"POST /api/v1/models/{id}/versions/{version}/deploy\", s.DeployVersion)\r\n\tmux.HandleFunc(\"POST /api/v1/models/{id}/versions/{version}/undeploy\", s.UndeployVersion)\r\n\r\n\tmux.HandleFunc(\"POST /api/v1/infer/{model_name}\", s.Infer)\r\n"]
[2452.015077, "o", "\u001b[?2004h"]
