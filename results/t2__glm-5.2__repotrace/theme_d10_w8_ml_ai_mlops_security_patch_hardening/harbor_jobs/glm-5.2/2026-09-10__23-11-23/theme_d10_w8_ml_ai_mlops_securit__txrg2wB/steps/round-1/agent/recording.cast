[1760.937037, "o", "\u001b[?2004h> "]
[1760.937155, "o", "        Username string `json:\"username\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.937302, "o", "        Password string `json:\"password\"`\r\n\u001b[?2004l\r"]
[1760.937358, "o", "\u001b[?2004h> "]
[1760.937456, "o", "        Role     string `json:\"role\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[1760.937511, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.93773, "o", "    if err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.937965, "o", "        writeError(w, http.StatusBadRequest, \"invalid request body\")\r\n\u001b[?2004l\r"]
[1760.938021, "o", "\u001b[?2004h> "]
[1760.938077, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1760.938147, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.93821, "o", "    callerRole := \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.938378, "o", "    if user, ok := s.authFromRequest(r); ok {\r\n\u001b[?2004l\r"]
[1760.938434, "o", "\u001b[?2004h> "]
[1760.93851, "o", "        callerRole = user.Role\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.938569, "o", "    }\r\n\u001b[?2004l\r  \u001b[?2004h> \r\n\u001b[?2004l\r"]
[1760.938623, "o", "\u001b[?2004h> "]
[1760.938843, "o", "    user, err := s.auth.Register(req.Username, req.Password, req.Role, callerRole)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.938921, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.939002, "o", "        switch {\r\n\u001b[?2004l\r"]
[1760.939056, "o", "\u001b[?2004h> "]
[1760.939186, "o", "        case errors.Is(err, auth.ErrForbidden):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.939376, "o", "            writeError(w, http.StatusForbidden, err.Error())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.939669, "o", "        case errors.Is(err, auth.ErrInvalidRole), strings.Contains(err.Error(), \"required\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.939881, "o", "            writeError(w, http.StatusBadRequest, err.Error())\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[1760.94007, "o", "        case errors.Is(err, auth.ErrUsernameExists):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.940282, "o", "            writeError(w, http.StatusConflict, err.Error())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.940352, "o", "        default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.940552, "o", "            writeError(w, http.StatusBadRequest, err.Error())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.940604, "o", "        }\r\n\u001b[?2004l\r"]
[1760.940658, "o", "\u001b[?2004h> "]
[1760.940712, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\rr("]
[1760.940768, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.941033, "o", "    s.auditReq(r, user.Username, \"user.register\", \"user\", user.ID, \"role=\"+user.Role)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.941252, "o", "    writeJSON(w, http.StatusCreated, map[string]interface{}{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.941371, "o", "        \"id\":       user.ID,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1760.941427, "o", "> "]
[1760.941497, "o", "        \"username\": user.Username,\r\n\u001b[?2004l\r"]
[1760.941552, "o", "\u001b[?2004h> "]
[1760.941621, "o", "        \"role\":     user.Role,\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[1760.941746, "o", "        \"api_key\":  user.APIKey,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.941808, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> }"]
[1760.941862, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.942092, "o", "func (s *Server) Login(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.942219, "o", "    var req struct {\r\n\u001b[?2004l\r"]
[1760.942276, "o", "\u001b[?2004h> "]
[1760.942377, "o", "        Username string `json:\"username\"`\r\n\u001b[?2004l\r"]
[1760.942465, "o", "\u001b[?2004h> "]
[1760.942591, "o", "        Password string `json:\"password\"`\r\n\u001b[?2004l\r"]
[1760.942652, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.942859, "o", "    if err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[?2004l\r"]
[1760.942925, "o", "\u001b[?2004h> "]
[1760.943117, "o", "        writeError(w, http.StatusBadRequest, \"invalid request body\")\r\n\u001b[?2004l\r"]
[1760.943177, "o", "\u001b[?2004h>         return\r\n\u001b[?2004l\r \u001b[?2004h"]
[1760.943245, "o", ">     }\r\n\u001b[?2004l\r"]
[1760.943303, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.943478, "o", "    apiKey, role, err := s.auth.Login(req.Username, req.Password)\r\n\u001b[?2004l\r"]
[1760.943538, "o", "\u001b[?2004h>     if err != nil {\r\n"]
[1760.943593, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1760.943785, "o", "        writeError(w, http.StatusUnauthorized, \"invalid credentials\")\r\n\u001b[?2004l\r"]
[1760.943839, "o", "\u001b[?2004h> "]
[1760.943892, "o", "        return\r\n\u001b[?2004l\ra\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1760.943946, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[1760.944189, "o", "    s.auditReq(r, req.Username, \"user.login\", \"user\", req.Username, \"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.944456, "o", "    writeJSON(w, http.StatusOK, map[string]string{\"api_key\": apiKey, \"role\": role})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.944511, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[1760.944741, "o", "func (s *Server) authFromRequest(r *http.Request) (*store.User, bool) {\r\n\u001b[?2004l\r"]
[1760.944796, "o", "\u001b[?2004h> "]
[1760.944899, "o", "    authHeader := r.Header.Get(\"Authorization\")\r\n\u001b[?2004l\r"]
[1760.944955, "o", "\u001b[?2004h> "]
[1760.945083, "o", "    if !strings.HasPrefix(authHeader, \"Bearer \") {\r\n\u001b[?2004l\r"]
[1760.945149, "o", "\u001b[?2004h> "]
[1760.945213, "o", "        return nil, false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.945268, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.94542, "o", "    token := strings.TrimPrefix(authHeader, \"Bearer \")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.945554, "o", "    return s.auth.Authenticate(token)\r\n\u001b[?2004l\r"]
[1760.94561, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r,\u001b[?2004h"]
[1760.945664, "o", "> "]
[1760.945856, "o", "func (s *Server) RegisterModel(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.945991, "o", "    user, ok := s.authFromRequest(r)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.946054, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.946284, "o", "        writeError(w, http.StatusUnauthorized, \"unauthorized\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.946354, "o", "        return\r\n\u001b[?2004l\r"]
[1760.946408, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\ra\u001b[?2004h> "]
[1760.94659, "o", "    if !auth.CanAccess(user.Role, auth.RoleDeployer) {\r\n\u001b[?2004l\r"]
[1760.946644, "o", "\u001b[?2004h> "]
[1760.94682, "o", "        writeError(w, http.StatusForbidden, \"insufficient role\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.946892, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.946947, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1760.947005, "o", "\u001b[?2004h> "]
[1760.947056, "o", "    var m store.Model\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.965019, "o", "    if err := json.NewDecoder(r.Body).Decode(&m); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>         writeError(w, http.StatusBadRequest, \"invalid request body\")\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\rSer\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     created, err := s.registry.Register(&m)\r\n\u001b[?2004l\r\u001b[?2004h>     if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>         s.writeRegistryError(w, err)\r\n\u001b[?2004l\r"]
[1760.965112, "o", "\u001b[?2004h> "]
[1760.965181, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.965239, "o", "    }\r\n\u001b[?2004l\r"]
[1760.965293, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1760.965347, "o", "\u001b[?2004h> "]
[1760.965811, "o", "    s.auditReq(r, user.Username, \"model.register\", \"model\", created.ID, \"name=\"+created.Name)\r\n\u001b[?2004l\r"]
[1760.965872, "o", "\u001b[?2004h> "]
[1760.966082, "o", "    s.webhooks.Fire(\"model.created\", created)\r\n\u001b[?2004l\r"]
[1760.966145, "o", "\u001b[?2004h> "]
[1760.966355, "o", "    writeJSON(w, http.StatusCreated, created)\r\n\u001b[?2004l\r"]
[1760.96641, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1760.966466, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rN\u001b[?2004h"]
[1760.966527, "o", "> "]
[1760.966846, "o", "func (s *Server) writeRegistryError(w http.ResponseWriter, err error) {\r\n\u001b[?2004l\r"]
[1760.966902, "o", "\u001b[?2004h> "]
[1760.966962, "o", "    switch {\r\n\u001b[?2004l\r"]
[1760.967018, "o", "\u001b[?2004h> "]
[1760.96725, "o", "    case errors.Is(err, registry.ErrValidation):\r\n\u001b[?2004l\r"]
[1760.967306, "o", "\u001b[?2004h> "]
[1760.967571, "o", "        writeError(w, http.StatusBadRequest, err.Error())\r\n\u001b[?2004l\r"]
[1760.967628, "o", "\u001b[?2004h> "]
[1760.967863, "o", "    case errors.Is(err, registry.ErrConflict):\r\n\u001b[?2004l\r"]
[1760.967917, "o", "\u001b[?2004h> "]
[1760.968298, "o", "        writeError(w, http.StatusConflict, err.Error())\r\n\u001b[?2004l\r"]
[1760.968355, "o", "\u001b[?2004h> "]
[1760.968647, "o", "    case errors.Is(err, registry.ErrNotFound):\r\n\u001b[?2004l\r"]
[1760.968704, "o", "\u001b[?2004h> "]
[1760.969069, "o", "        writeError(w, http.StatusNotFound, err.Error())\r\n\u001b[?2004l\r"]
[1760.969131, "o", "\u001b[?2004h> "]
[1760.969437, "o", "    case errors.Is(err, registry.ErrTooLarge):\r\n\u001b[?2004l\r"]
[1760.969465, "o", "\u001b[?2004h"]
[1760.969546, "o", "> "]
[1760.96994, "o", "        writeError(w, http.StatusRequestEntityTooLarge, err.Error())\r\n\u001b[?2004l\r"]
[1760.969995, "o", "\u001b[?2004h> "]
[1760.970081, "o", "    default:\r\n\u001b[?2004l\r"]
[1760.970143, "o", "\u001b[?2004h> "]
[1760.970561, "o", "        writeError(w, http.StatusInternalServerError, err.Error())\r\n\u001b[?2004l\r"]
[1760.970612, "o", "\u001b[?2004h> "]
[1760.970664, "o", "    }\r\n\u001b[?2004l\r"]
[1760.970714, "o", "\u001b[?2004h> "]
[1760.97077, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1760.970824, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h"]
[1760.970884, "o", "> "]
[1760.971284, "o", "func (s *Server) ListModels(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[1760.971341, "o", "\u001b[?2004h> "]
[1760.971707, "o", "    if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\r\n\u001b[?2004l\r"]
[1760.971764, "o", "\u001b[?2004h> "]
[1760.971865, "o", "        return\r\n\u001b[?2004l\r"]
[1760.971938, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1760.971997, "o", "\u001b[?2004h> \r\n"]
[1760.972052, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1760.972215, "o", "    q := r.URL.Query()\r\n\u001b[?2004l\r"]
[1760.972278, "o", "\u001b[?2004h> "]
[1760.972448, "o", "    var deployedFilter *bool\r\n\u001b[?2004l\r"]
[1760.972511, "o", "\u001b[?2004h> "]
[1760.972772, "o", "    if d := q.Get(\"deployed\"); d != \"\" {\r\n\u001b[?2004l\r"]
[1760.972827, "o", "\u001b[?2004h> "]
[1760.973062, "o", "        b, err := strconv.ParseBool(d)\r\n\u001b[?2004l\r"]
[1760.973132, "o", "\u001b[?2004h> "]
[1760.973276, "o", "        if err == nil {\r\n\u001b[?2004l\r"]
[1760.973331, "o", "\u001b[?2004h> "]
[1760.973536, "o", "            deployedFilter = &b\r\n\u001b[?2004l\r"]
[1760.973599, "o", "\u001b[?2004h> "]
[1760.973665, "o", "        }\r\n\u001b[?2004l\r"]
[1760.973694, "o", "\u001b[?2004h> "]
[1760.973845, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.974655, "o", "    models := s.registry.List(q.Get(\"name\"), q.Get(\"framework\"), q.Get(\"label_key\"), q.Get(\"label_value\"), deployedFilter)\r\n\u001b[?2004l\r"]
[1760.974685, "o", "\u001b[?2004h"]
[1760.974766, "o", "> "]
[1760.975166, "o", "    writeJSON(w, http.StatusOK, map[string]interface{}{\"models\": models})\r\n\u001b[?2004l\r"]
[1760.975234, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1760.975286, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1760.975335, "o", "\u001b[?2004h"]
[1760.975388, "o", "> "]
[1760.975762, "o", "func (s *Server) GetModel(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[1760.975819, "o", "\u001b[?2004h> "]
[1760.976217, "o", "    if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\r\n\u001b[?2004l\r"]
[1760.976274, "o", "\u001b[?2004h> "]
[1760.976367, "o", "        return\r\n\u001b[?2004l\r"]
[1760.976426, "o", "\u001b[?2004h> "]
[1760.976481, "o", "    }\r\n\u001b[?2004l\r"]
[1760.976537, "o", "\u001b[?2004h> "]
[1760.976693, "o", "    id := r.PathValue(\"id\")\r\n\u001b[?2004l\r"]
[1760.976748, "o", "\u001b[?2004h> "]
[1760.976977, "o", "    model, err := s.registry.Get(id)\r\n\u001b[?2004l\r"]
[1760.977031, "o", "\u001b[?2004h> "]
[1760.977173, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1760.977233, "o", "\u001b[?2004h> "]
[1760.977635, "o", "        writeError(w, http.StatusNotFound, \"model not found\")\r\n\u001b[?2004l\r"]
[1760.977691, "o", "\u001b[?2004h> "]
[1760.977784, "o", "        return\r\n\u001b[?2004l\r"]
[1760.977839, "o", "\u001b[?2004h> "]
[1760.977895, "o", "    }\r\n\u001b[?2004l\r \u001b[?2004h"]
[1760.977951, "o", "> "]
[1760.978167, "o", "    writeJSON(w, http.StatusOK, model)\r\n\u001b[?2004l\r"]
[1760.978223, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1760.978288, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1760.978346, "o", "\u001b[?2004h> "]
[1760.978762, "o", "func (s *Server) DeleteModel(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[1760.978817, "o", "\u001b[?2004h> "]
[1760.979096, "o", "    user, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\u001b[?2004l\r"]
[1760.979165, "o", "\u001b[?2004h> "]
[1760.979221, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[1760.979275, "o", "\u001b[?2004h> "]
[1760.979352, "o", "        return\r\n\u001b[?2004l\r"]
[1760.979407, "o", "\u001b[?2004h> "]
[1760.979461, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.979609, "o", "    id := r.PathValue(\"id\")\r\n\u001b[?2004l\r"]
[1760.979672, "o", "\u001b[?2004h> "]
[1760.979842, "o", "    model, err := s.registry.Get(id)\r\n\u001b[?2004l\r"]
[1760.979899, "o", "\u001b[?2004h> "]
[1760.980005, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1760.98006, "o", "\u001b[?2004h> "]
[1760.980396, "o", "        writeError(w, http.StatusNotFound, \"model not found\")\r\n\u001b[?2004l\r"]
[1760.98045, "o", "\u001b[?2004h> "]
[1760.980512, "o", "        return\r\n\u001b[?2004l\r"]
[1760.980567, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1760.980616, "o", "\u001b[?2004h> "]
[1760.9809, "o", "    if err := s.registry.Delete(id); err != nil {\r\n\u001b[?2004l\r"]
[1760.980956, "o", "\u001b[?2004h> "]
[1760.981213, "o", "        if errors.Is(err, registry.ErrConflict) {\r\n\u001b[?2004l\r"]
[1760.981271, "o", "\u001b[?2004h> "]
[1760.981572, "o", "            writeError(w, http.StatusConflict, err.Error())\r\n\u001b[?2004l\r"]
[1760.981628, "o", "\u001b[?2004h> "]
[1760.981716, "o", "        } else {\r\n\u001b[?2004l\r"]
[1760.981772, "o", "\u001b[?2004h> "]
[1760.982136, "o", "            writeError(w, http.StatusInternalServerError, err.Error())\r\n\u001b[?2004l\r"]
[1760.982192, "o", "\u001b[?2004h> "]
[1760.982243, "o", "        }\r\n\u001b[?2004l\r"]
[1760.982299, "o", "\u001b[?2004h> "]
[1760.982358, "o", "        return\r\n\u001b[?2004l\r"]
[1760.982412, "o", "\u001b[?2004h> "]
[1760.982474, "o", "    }\r\n\u001b[?2004l\r"]
[1760.98253, "o", "\u001b[?2004h> "]
[1760.982931, "o", "    s.auditReq(r, user.Username, \"model.delete\", \"model\", id, \"name=\"+model.Name)\r\n\u001b[?2004l\r"]
[1760.982986, "o", "\u001b[?2004h> "]
[1760.983209, "o", "    s.webhooks.Fire(\"model.deleted\", model)\r\n\u001b[?2004l\r"]
[1760.983263, "o", "\u001b[?2004h> "]
[1760.983639, "o", "    writeJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n\u001b[?2004l\r"]
[1760.983693, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1760.983747, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1760.983801, "o", "\u001b[?2004h> "]
[1760.984191, "o", "func (s *Server) UploadVersion(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[1760.98422, "o", "\u001b[?2004h> "]
[1760.984569, "o", "    user, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\u001b[?2004l\r"]
[1760.984625, "o", "\u001b[?2004h> "]
[1760.984679, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[1760.984734, "o", "\u001b[?2004h> "]
[1760.9848, "o", "        return\r\n\u001b[?2004l\r"]
[1760.984855, "o", "\u001b[?2004h> "]
[1760.98491, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.985074, "o", "    id := r.PathValue(\"id\")\r\n\u001b[?2004l\r"]
[1760.985138, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rw\u001b[?2004h"]
[1760.985198, "o", "> "]
[1760.985657, "o", "    if err := r.ParseMultipartForm(int64(s.cfg.MaxModelSizeMB) * 1024 * 1024); err != nil {\r\n\u001b[?2004l\r"]
[1760.985712, "o", "\u001b[?2004h> "]
[1760.986212, "o", "        writeError(w, http.StatusBadRequest, \"invalid multipart form: \"+err.Error())\r\n\u001b[?2004l\r"]
[1760.98627, "o", "\u001b[?2004h> "]
[1760.986328, "o", "        return\r\n\u001b[?2004l\r"]
[1760.986385, "o", "\u001b[?2004h> "]
[1760.986441, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1760.986497, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.986734, "o", "    version := r.FormValue(\"version\")\r\n\u001b[?2004l\r"]
[1760.986788, "o", "\u001b[?2004h> "]
[1760.987029, "o", "    releaseNotes := r.FormValue(\"release_notes\")\r\n\u001b[?2004l\r"]
[1760.987083, "o", "\u001b[?2004h> "]
[1760.987289, "o", "    file, _, err := r.FormFile(\"binary\")\r\n\u001b[?2004l\r"]
[1760.987344, "o", "\u001b[?2004h> "]
[1760.987451, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1760.987507, "o", "\u001b[?2004h> "]
[1760.98788, "o", "        writeError(w, http.StatusBadRequest, \"binary file is required\")\r\n\u001b[?2004l\r"]
[1760.987936, "o", "\u001b[?2004h> "]
[1760.987999, "o", "        return\r\n\u001b[?2004l\r"]
[1760.988054, "o", "\u001b[?2004h> "]
[1760.988132, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.98825, "o", "    defer file.Close()\r\n\u001b[?2004l\r"]
[1760.988304, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h"]
[1760.988364, "o", "> "]
[1760.988719, "o", "    v, err := s.registry.UploadVersion(id, version, releaseNotes, file)\r\n\u001b[?2004l\r"]
[1760.988774, "o", "\u001b[?2004h> "]
[1760.988868, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1760.988927, "o", "\u001b[?2004h> "]
[1760.98911, "o", "        s.writeRegistryError(w, err)\r\n\u001b[?2004l\r"]
[1760.989166, "o", "\u001b[?2004h> "]
[1760.989235, "o", "        return\r\n\u001b[?2004l\r"]
[1760.98929, "o", "\u001b[?2004h> "]
[1760.989349, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1760.989404, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1760.989844, "o", "    s.auditReq(r, user.Username, \"version.upload\", \"model\", id, \"version=\"+v.Version)\r\n\u001b[?2004l\r"]
[1760.989908, "o", "\u001b[?2004h> "]
[1760.990247, "o", "    s.webhooks.Fire(\"version.uploaded\", map[string]interface{}{\"model_id\": id, \"version\": v})\r\n\u001b[?2004l\r"]
[1760.990304, "o", "\u001b[?2004h> "]
[1760.990435, "o", "    writeJSON(w, http.StatusCreated, v)\r\n\u001b[?2004l\r"]
[1760.990491, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1760.990548, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[1760.990818, "o", "func (s *Server) ListVersions(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1760.990874, "o", "> "]
[1760.991073, "o", "    if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\r\n\u001b[?2004l\r"]
[1760.991137, "o", "\u001b[?2004h> "]
[1760.991191, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.991254, "o", "    }\r\n\u001b[?2004l\r"]
[1760.991309, "o", "\u001b[?2004h> "]
[1760.991374, "o", "    id := r.PathValue(\"id\")\r\n\u001b[?2004l\r"]
[1760.991428, "o", "\u001b[?2004h> "]
[1760.991589, "o", "    versions, err := s.registry.ListVersions(id)\r\n\u001b[?2004l\r"]
[1760.991642, "o", "\u001b[?2004h> "]
[1760.991694, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1760.991749, "o", "\u001b[?2004h> "]
[1760.991954, "o", "        writeError(w, http.StatusNotFound, \"model not found\")\r\n\u001b[?2004l\r"]
[1760.992008, "o", "\u001b[?2004h> "]
[1760.992057, "o", "        return\r\n\u001b[?2004l\r "]
[1760.992117, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1760.992176, "o", "\u001b[?2004h> "]
[1760.992429, "o", "    writeJSON(w, http.StatusOK, map[string]interface{}{\"versions\": versions})\r\n\u001b[?2004l\r"]
[1760.992485, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.992539, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.992836, "o", "func (s *Server) DownloadVersion(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[1760.992895, "o", "\u001b[?2004h> "]
[1760.993089, "o", "    if _, ok := s.requireAuth(w, r, auth.RoleViewer); !ok {\r\n\u001b[?2004l\r"]
[1760.993152, "o", "\u001b[?2004h> "]
[1760.993214, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.993278, "o", "    }\r\n\u001b[?2004l\r"]
[1760.993337, "o", "\u001b[?2004h> "]
[1760.993392, "o", "    id := r.PathValue(\"id\")\r\n\u001b[?2004l\r"]
[1760.993446, "o", "\u001b[?2004h> "]
[1760.993571, "o", "    version := r.PathValue(\"version\")\r\n\u001b[?2004l\r"]
[1760.993626, "o", "\u001b[?2004h> "]
[1760.993778, "o", "    v, err := s.registry.GetVersion(id, version)\r\n\u001b[?2004l\r"]
[1760.993832, "o", "\u001b[?2004h> "]
[1760.993895, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1760.993949, "o", "\u001b[?2004h> "]
[1760.994182, "o", "        writeError(w, http.StatusNotFound, \"version not found\")\r\n\u001b[?2004l\r"]
[1760.99424, "o", "\u001b[?2004h> "]
[1760.994295, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.994352, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.994408, "o", "\r\n\u001b[?2004l\r \u001b[?2004h> "]
[1760.994779, "o", "    w.Header().Set(\"Content-Disposition\", fmt.Sprintf(\"attachment; filename=model-%s.bin\", version))\r\n\u001b[?2004l\r"]
[1760.994834, "o", "\u001b[?2004h> "]
[1760.995047, "o", "    w.Header().Set(\"Content-Type\", \"application/octet-stream\")\r\n\u001b[?2004l\r"]
[1760.99511, "o", "\u001b[?2004h> "]
