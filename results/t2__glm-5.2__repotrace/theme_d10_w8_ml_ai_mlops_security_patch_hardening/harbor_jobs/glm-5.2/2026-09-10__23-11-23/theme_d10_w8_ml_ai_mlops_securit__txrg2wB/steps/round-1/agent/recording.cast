[1401.098389, "o", "func ValidateFramework(framework string) error {\r\n\u001b[?2004l\r"]
[1401.098442, "o", "\u001b[?2004h> "]
[1401.098604, "o", "    switch framework {\r\n"]
[1401.098617, "o", "\u001b[?2004l\r"]
[1401.098681, "o", "\u001b[?2004h> "]
[1401.099022, "o", "    case \"tensorflow\", \"pytorch\", \"onnx\", \"custom\":\r\n\u001b[?2004l\r"]
[1401.099072, "o", "\u001b[?2004h> "]
[1401.099223, "o", "        return nil\r\n\u001b[?2004l\r"]
[1401.099276, "o", "\u001b[?2004h"]
[1401.099288, "o", "> "]
[1401.09937, "o", "    default:\r\n\u001b[?2004l\r"]
[1401.099421, "o", "\u001b[?2004h> "]
[1401.099964, "o", "        return fmt.Errorf(\"%w: invalid framework %q\", ErrValidation, framework)\r\n\u001b[?2004l\r"]
[1401.100015, "o", "\u001b[?2004h> "]
[1401.100066, "o", "    }\r\n\u001b[?2004l\r"]
[1401.100115, "o", "\u001b[?2004h"]
[1401.100168, "o", "> }\r\n\u001b[?2004l\r"]
