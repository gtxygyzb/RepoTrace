[1760.996161, "o", "\u001b[?2004h> "]
[1760.996225, "o", "    id := r.PathValue(\"id\")\r\n\u001b[?2004l\r"]
[1760.996279, "o", "\u001b[?2004h> "]
[1760.996405, "o", "    version := r.PathValue(\"version\")\r\n\u001b[?2004l\ru"]
[1760.99646, "o", "\u001b[?2004h> "]
[1760.996628, "o", "    v, err := s.registry.DeployVersion(id, version)\r\n\u001b[?2004l\r"]
[1760.996686, "o", "\u001b[?2004h> "]
[1760.996745, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1760.996799, "o", "> "]
[1760.99692, "o", "        s.writeRegistryError(w, err)\r\n\u001b[?2004l\r"]
[1760.996974, "o", "\u001b[?2004h> "]
[1760.997028, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.997083, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.997408, "o", "    s.auditReq(r, user.Username, \"version.deploy\", \"model\", id, \"version=\"+version)\r\n\u001b[?2004l\r"]
[1760.997462, "o", "\u001b[?2004h> "]
[1760.997806, "o", "    s.webhooks.Fire(\"version.deployed\", map[string]interface{}{\"model_id\": id, \"version\": v})\r\n\u001b[?2004l\r"]
[1760.997862, "o", "\u001b[?2004h> "]
[1760.997969, "o", "    writeJSON(w, http.StatusOK, v)\r\n\u001b[?2004l\r"]
[1760.998023, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re"]
[1760.998083, "o", "\u001b[?2004h> "]
[1760.99836, "o", "func (s *Server) UndeployVersion(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[1760.998424, "o", "\u001b[?2004h> "]
[1760.998591, "o", "    user, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\u001b[?2004l\r"]
[1760.998646, "o", "\u001b[?2004h> "]
[1760.998703, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.998769, "o", "        return\r\n\u001b[?2004l\r"]
[1760.998824, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1760.998878, "o", "\u001b[?2004h> "]
[1760.998957, "o", "    id := r.PathValue(\"id\")\r\n\u001b[?2004l\r"]
[1760.99901, "o", "\u001b[?2004h> "]
[1760.999148, "o", "    version := r.PathValue(\"version\")\r\n\u001b[?2004l\r"]
[1760.999204, "o", "\u001b[?2004h> "]
[1760.999391, "o", "    v, err := s.registry.UndeployVersion(id, version)\r\n\u001b[?2004l\r"]
[1760.999453, "o", "\u001b[?2004h> "]
[1760.999506, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.99961, "o", "        s.writeRegistryError(w, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.999669, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.999724, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.999964, "o", "    s.auditReq(r, user.Username, \"version.undeploy\", \"model\", id, \"version=\"+version)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.000252, "o", "    s.webhooks.Fire(\"version.undeployed\", map[string]interface{}{\"model_id\": id, \"version\": v})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.000367, "o", "    writeJSON(w, http.StatusOK, v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.000423, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.000609, "o", "func (s *Server) Infer(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r.L\u001b[?2004h> "]
[1761.000783, "o", "    user, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.000834, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.000893, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.000959, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.001114, "o", "    modelName := r.PathValue(\"model_name\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.001169, "o", "\r\n\u001b[?2004l\ri\u001b[?2004h> "]
[1761.001258, "o", "    body, err := io.ReadAll(r.Body)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.001338, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.001552, "o", "        writeError(w, http.StatusBadRequest, \"invalid request body\")\r\n\u001b[?2004l\r"]
[1761.001606, "o", "\u001b[?2004h> "]
[1761.001661, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\rt"]
[1761.001716, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.001907, "o", "    result, model, version, latency, err := s.inference.Infer(modelName, body)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.001975, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1761.00203, "o", "\u001b[?2004h> "]
[1761.002167, "o", "        s.metrics.RecordInference(modelName, latency, true)\r\n\u001b[?2004l\r[\u001b[?2004h"]
[1761.002224, "o", "> "]
[1761.002441, "o", "        s.auditReq(r, user.Username, \"inference.error\", \"model\", modelName, err.Error())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.002671, "o", "        writeError(w, http.StatusInternalServerError, err.Error())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.002735, "o", "        return\r\n\u001b[?2004l\r \u001b[?2004h> "]
[1761.002792, "o", "    }\r\n\u001b[?2004l\re\u001b[?2004h> \r\n\u001b[?2004l\rt"]
[1761.002848, "o", "\u001b[?2004h> "]
[1761.002979, "o", "    s.metrics.RecordInference(modelName, latency, false)\r\n\u001b[?2004l\rc \u001b[?2004h> "]
[1761.065027, "o", "    payload := map[string]interface{}{\r\n\u001b[?2004l\r\u001b[?2004h>         \"model\":      model.Name,\r\n\u001b[?2004l\r\u001b[?2004h>         \"version\":    version.Version,\r\n\u001b[?2004l\r\u001b[?2004h>         \"latency_ms\": latency,\r\n\u001b[?2004l\r\u001b[?2004h>         \"timestamp\":  time.Now().UTC().Format(time.RFC3339),\r\n\u001b[?2004l\r\u001b[?2004h>         \"result\":     result,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\rt\u001b[?2004h>     s.webhooks.Fire(\"inference.completed\", payload)\r\n\u001b[?2004l\r\u001b[?2004h>     writeJSON(w, http.StatusOK, payload)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h> func (s *Server) InferBatch(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r\u001b[?2004h>     user, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\u001b[?2004l\r\u001b[?2004h>     if !ok {\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\rv\u001b[?2004h>     modelName := r.PathValue(\"model_name\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     var req struct {\r\n\u001b[?2004l\r\u001b[?2004h>         Inputs []json.RawMessage `json:\"inputs\"`\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?20"]
[1761.065156, "o", "04l\r\u001b[?2004h>     if err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>         writeError(w, http.StatusBadRequest, \"invalid request body\")\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if len(req.Inputs) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         writeError(w, http.StatusBadRequest, \"inputs are required\")\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.065263, "o", "    if len(req.Inputs) > s.cfg.MaxBatchSize {\r\n\u001b[?2004l\r"]
[1761.065327, "o", "\u001b[?2004h> "]
[1761.066035, "o", "        writeError(w, http.StatusBadRequest, fmt.Sprintf(\"batch size exceeds max %d\", s.cfg.MaxBatchSize))\r\n\u001b[?2004l\r"]
[1761.066084, "o", "\u001b[?2004h> "]
[1761.066213, "o", "        return\r\n\u001b[?2004l\r"]
[1761.066263, "o", "\u001b[?2004h> "]
[1761.066315, "o", "    }\r\n\u001b[?2004l\r"]
[1761.066373, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1761.066431, "o", " \u001b[?2004h> "]
[1761.066817, "o", "    results := make([]interface{}, 0, len(req.Inputs))\r\n\u001b[?2004l\r"]
[1761.066885, "o", "\u001b[?2004h"]
[1761.066942, "o", "> "]
[1761.067089, "o", "    errorsList := []string{}\r\n\u001b[?2004l\r"]
[1761.067168, "o", "\u001b[?2004h> "]
[1761.067492, "o", "    var modelNameResolved, versionResolved string\r\n\u001b[?2004l\r"]
[1761.067594, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.067659, "o", "> "]
[1761.067886, "o", "    for _, input := range req.Inputs {\r\n\u001b[?2004l\r"]
[1761.067945, "o", "\u001b[?2004h> "]
[1761.06852, "o", "        result, model, version, latency, err := s.inference.Infer(modelName, input)\r\n\u001b[?2004l\r"]
[1761.068581, "o", "\u001b[?2004h> "]
[1761.068743, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[1761.068804, "o", "\u001b[?2004h> "]
[1761.069256, "o", "            s.metrics.RecordInference(modelName, latency, true)\r\n\u001b[?2004l\r"]
[1761.069315, "o", "\u001b[?2004h> "]
[1761.069704, "o", "            errorsList = append(errorsList, err.Error())\r\n\u001b[?2004l\r"]
[1761.06976, "o", "\u001b[?2004h> "]
[1761.070075, "o", "            results = append(results, nil)\r\n\u001b[?2004l\r"]
[1761.070143, "o", "\u001b[?2004h> "]
[1761.070274, "o", "        } else {\r\n\u001b[?2004l\r"]
[1761.070342, "o", "\u001b[?2004h> "]
[1761.070766, "o", "            s.metrics.RecordInference(modelName, latency, false)\r\n\u001b[?2004l\r"]
[1761.070823, "o", "\u001b[?2004h> "]
[1761.071117, "o", "            modelNameResolved = model.Name\r\n\u001b[?2004l\r"]
[1761.071179, "o", "\u001b[?2004h> "]
[1761.07151, "o", "            versionResolved = version.Version\r\n\u001b[?2004l\r"]
[1761.0716, "o", "\u001b[?2004h> "]
[1761.071881, "o", "            results = append(results, result)\r\n\u001b[?2004l\r"]
[1761.071967, "o", "\u001b[?2004h> "]
[1761.072051, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.072148, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.072228, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.073011, "o", "    s.auditReq(r, user.Username, \"inference.batch\", \"model\", modelName, fmt.Sprintf(\"count=%d\", len(req.Inputs)))\r\n\u001b[?2004l\r"]
[1761.073082, "o", "\u001b[?2004h> "]
[1761.073447, "o", "    writeJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[?2004l\r"]
[1761.073514, "o", "\u001b[?2004h> "]
[1761.073763, "o", "        \"model\":   modelNameResolved,\r\n\u001b[?2004l\r"]
[1761.073818, "o", "\u001b[?2004h> "]
[1761.074079, "o", "        \"version\": versionResolved,\r\n\u001b[?2004l\r"]
[1761.074151, "o", "\u001b[?2004h> "]
[1761.074352, "o", "        \"results\": results,\r\n\u001b[?2004l\r"]
[1761.074407, "o", "\u001b[?2004h> "]
[1761.074617, "o", "        \"errors\":  errorsList,\r\n\u001b[?2004l\r"]
[1761.074679, "o", "\u001b[?2004h> "]
[1761.074731, "o", "    })\r\n\u001b[?2004l\r"]
[1761.074791, "o", "\u001b[?2004h> }"]
[1761.074846, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.074902, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.074957, "o", "> "]
[1761.075353, "o", "func (s *Server) Metrics(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[1761.075411, "o", "\u001b[?2004h> "]
[1761.075742, "o", "    if _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\r\n\u001b[?2004l\r"]
[1761.075811, "o", "\u001b[?2004h> "]
[1761.075889, "o", "        return\r\n\u001b[?2004l\r"]
[1761.075953, "o", "\u001b[?2004h> "]
[1761.076008, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.076064, "o", "> "]
[1761.076323, "o", "    writeJSON(w, http.StatusOK, s.metrics.Get())\r\n\u001b[?2004l\r"]
[1761.076379, "o", "\u001b[?2004h> "]
