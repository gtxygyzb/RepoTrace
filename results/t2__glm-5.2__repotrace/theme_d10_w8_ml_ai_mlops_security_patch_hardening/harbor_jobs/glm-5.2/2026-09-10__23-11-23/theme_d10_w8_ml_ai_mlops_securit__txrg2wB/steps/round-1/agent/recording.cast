[1760.995281, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1760.995337, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.995629, "o", "func (s *Server) DeployVersion(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[1760.995684, "o", "\u001b[?2004h> "]
[1760.995861, "o", "    user, ok := s.requireAuth(w, r, auth.RoleDeployer)\r\n\u001b[?2004l\r"]
[1760.995915, "o", "\u001b[?2004h> "]
[1760.995975, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.996037, "o", "        return\r\n\u001b[?2004l\r"]
