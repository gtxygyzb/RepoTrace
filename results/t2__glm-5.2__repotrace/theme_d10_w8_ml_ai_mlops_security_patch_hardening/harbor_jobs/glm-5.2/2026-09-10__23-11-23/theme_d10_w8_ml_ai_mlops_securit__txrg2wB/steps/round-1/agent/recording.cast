[3903.601202, "o", "func (s *Server) requireAuth(w http.ResponseWriter, r *http.Request, requiredRole string) (*store.User, bool) {\r\n\tuser, ok := s.authFromRequest(r)\r\n\tif !ok {\r\n\t\twriteError(w, http.StatusUnauthorized, \"unauthorized\")\r\n\t\treturn nil, false\r\n\t}\r\n\tif !auth.CanAccess(user.Role, requiredRole) {\r\n\t\twriteError(w, http.StatusForbidden, \"insufficient role\")\r\n\t\treturn nil, false\r\n\t}\r\n\treturn user, true\r\n}\r\n"]
