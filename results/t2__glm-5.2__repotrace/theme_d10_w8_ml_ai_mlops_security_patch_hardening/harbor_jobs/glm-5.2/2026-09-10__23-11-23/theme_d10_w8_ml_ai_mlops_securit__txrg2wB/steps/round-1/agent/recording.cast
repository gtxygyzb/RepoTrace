[3498.618687, "o", "\r\nfunc (s *Server) Metrics(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, s.metrics.Get())\r\n}\r\n\r\n"]
[3498.618819, "o", "func (s *Server) Audit(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\"audit\": s.audit.List()})\r\n}\r\n\r\nfunc (s *Server) RegisterWebhook(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.requireAuth(w, r, auth.RoleAdmin)\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tvar req struct {\r\n\t\tURL    string   `json:\"url\"`\r\n\t\tEvents []string `json:\"events\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteBodyReadError(w, err)\r\n\t\treturn\r\n\t}\r\n\twh, err := s.webhooks.Register(req.URL, req.Events)\r\n"]
[3498.618932, "o", "\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, err.Error())\r\n\t\treturn\r\n\t}\r\n\ts.auditReq(r, user.Username, \"webhook.register\", \"webhook\", wh.ID, \"url=\"+wh.URL)\r\n\twriteJSON(w, http.StatusCreated, wh)\r\n}\r\n\r\nfunc (s *Server) ListWebhooks(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\"webhooks\": s.webhooks.List()})\r\n}\r\n\r\nfunc (s *Server) DeleteWebhook(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.requireAuth(w, r, auth.RoleAdmin)\r\n\tif !ok {\r\n\t\treturn\r\n"]
[3498.619095, "o", "\t}\r\n\tid := r.PathValue(\"id\")\r\n\tif err := s.webhooks.Delete(id); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"webhook not found\")\r\n\t"]
[3498.61923, "o", "\treturn\r\n\t}\r\n\ts.auditReq(r, user.Username, \"webhook.delete\", \"webhook\", id, \"\")\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n}\r\n\r\nfunc (s *Server) GetConfig(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, s.cfg)\r\n}\r\n\r\nfunc (s *Server) UpdateConfig(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.requireAuth(w, r, auth.RoleAdmin)\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\r\n"]
