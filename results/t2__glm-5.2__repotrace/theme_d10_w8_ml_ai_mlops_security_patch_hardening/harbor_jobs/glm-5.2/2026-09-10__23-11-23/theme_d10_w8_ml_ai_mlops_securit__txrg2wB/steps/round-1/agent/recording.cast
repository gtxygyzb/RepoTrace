[1856.167541, "o", "\t})\r\n\treturn found, found != nil\r\n}\r\n\r\nfunc CanAccess(role string, required string) bool {\r\n\tswitch required {\r\n\tcase RoleAdmin:\r\n\t\treturn role == RoleAdmin\r\n\tcase RoleDeployer:\r\n\t\treturn role == RoleAdmin || role == RoleDeployer\r\n\tcase RoleViewer:\r\n\t"]
[1856.167596, "o", "\treturn role == RoleAdmin || role == RoleDeployer || role == RoleViewer\r\n\tdefault:\r\n\t\treturn false\r\n\t}\r\n}\r\n"]
