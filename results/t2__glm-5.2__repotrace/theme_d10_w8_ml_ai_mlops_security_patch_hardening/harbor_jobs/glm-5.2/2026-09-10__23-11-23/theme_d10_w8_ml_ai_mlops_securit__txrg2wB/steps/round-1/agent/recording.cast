[1923.51089, "o", "    93\t\t\t}\r\n    94\t\t\td.Users = append(d.Users, user)\r\n    95\t\t\tcreated = &d.Users[len(d.Users)-1]\r\n    96\t\t\treturn nil\r\n    97\t\t})\r\n    98\t\tif err != nil {\r\n    99\t\t\treturn nil, err\r\n   100\t\t}\r\n   101\t"]
[1923.510955, "o", "\treturn created, nil\r\n   102\t}\r\n   103\t\r\n   104\tfunc (s *Service) Login(username, password string) (string, string, error) {\r\n   105\t\tvar apiKey, role string\r\n   106\t\terr := s.store.WithRLock(func(d *store.Data) error {\r\n   107\t\t\tfor _, u := range d.Users {\r\n   108\t\t\t\tif u.Username == username && verifyPassword(password, u.PasswordHash) {\r\n   109\t\t\t\t\tapiKey = u.APIKey\r\n"]
[1923.51102, "o", "   110\t\t\t\t\trole = u.Role\r\n   111\t\t\t\t\treturn nil\r\n   112\t\t\t\t}\r\n   113\t\t\t}\r\n   114\t\t\treturn ErrInvalidCredentials\r\n   115\t\t})\r\n   116\t\tif err != nil {\r\n   117\t\t"]
[1923.511082, "o", "\treturn \"\", \"\", err\r\n   118\t\t}\r\n   119\t\treturn apiKey, role, nil\r\n   120\t}\r\n"]
