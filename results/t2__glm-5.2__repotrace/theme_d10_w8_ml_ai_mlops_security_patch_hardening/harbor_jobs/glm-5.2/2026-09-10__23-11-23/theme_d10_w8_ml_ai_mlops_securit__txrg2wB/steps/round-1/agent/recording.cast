[2987.103212, "i", "cat > internal/registry/validate.go <<'EOF'\npackage registry\n\nimport (\n    \"fmt\"\n    \"strings\"\n)\n\nfunc ValidateModelName(name string) error {\n    if name == \"\" {\n        return fmt.Errorf(\"%w: name is required\", ErrValidation)\n    }\n    if len(name) > 128 {\n        return fmt.Errorf(\"%w: name must be 128 characters or fewer\", ErrValidation)\n    }\n    if strings.ContainsAny(name, \"/\\\\\") {\n        return fmt.Errorf(\"%w: name must not contain path separators\", ErrValidation)\n    }\n    if strings.ContainsAny(name, \";|&$`\") {\n        return fmt.Errorf(\"%w: name must not contain shell metacharacters\", ErrValidation)\n    }\n    if strings.Contains(name, \"..\") {\n        return fmt.Errorf(\"%w: name must not contain '..' sequences\", ErrValidation)\n    }\n    return nil\n}\nEOF\n"]
