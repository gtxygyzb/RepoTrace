[1243.182149, "o", "func readJSON(path string, v interface{}) error {\r\n\u001b[?2004l\r"]
[1243.182239, "o", "\u001b[?2004h> "]
[1243.182314, "o", "    data, err := os.ReadFile(path)\r\n\u001b[?2004l\r"]
[1243.182408, "o", "\u001b[?2004h> "]
[1243.182503, "o", "    if os.IsNotExist(err) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1243.18259, "o", "        return nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[1243.182687, "o", ">     }"]
[1243.182784, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1243.182867, "o", "        return err\r\n\u001b[?2004l\r"]
[1243.182956, "o", "\u001b[?2004h> "]
[1243.183054, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1243.183161, "o", "    if len(data) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1243.183257, "o", "        return nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1243.183351, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1243.183446, "o", "    return json.Unmarshal(data, v)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1243.183538, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1243.183722, "o", "func writeJSON(path string, v interface{}) error {\r\n\u001b[?2004l\r"]
[1243.1838, "o", "\u001b[?2004h> "]
[1243.183947, "o", "    data, err := json.MarshalIndent(v, \"\", \"  \")\r\n\u001b[?2004l\r"]
[1243.184025, "o", "\u001b[?2004h> "]
[1243.184127, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1243.184222, "o", "\u001b[?2004h>         return err\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1243.184319, "o", "\u001b[?2004h> "]
[1243.18452, "o", "    if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {\r\n\u001b[?2004l\r"]
[1243.184602, "o", "\u001b[?2004h> "]
[1243.184693, "o", "        return err\r\n\u001b[?2004l\r"]
[1243.184785, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1243.184879, "o", "    tmp := path + \".tmp\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1243.185081, "o", "    if err := os.WriteFile(tmp, data, 0644); err != nil {\r\n\u001b[?2004l\r"]
[1243.185168, "o", "\u001b[?2004h> "]
[1243.185259, "o", "        return err\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1243.185351, "o", "\u001b[?2004h> "]
