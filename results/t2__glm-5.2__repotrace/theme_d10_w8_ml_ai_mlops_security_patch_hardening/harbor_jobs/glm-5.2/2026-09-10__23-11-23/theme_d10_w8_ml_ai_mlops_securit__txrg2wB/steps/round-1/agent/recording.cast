[4019.575137, "o", "package audit\r\n\r\nimport (\r\n\t\"mlgateway/internal/store\"\r\n\t\"time\"\r\n\t\"unicode/utf8\"\r\n)\r\n"]
[4019.575206, "o", "\r\ntype Service struct {\r\n\tstore *store.Store\r\n}\r\n\r\nfunc New(s *store.Store) *Service {\r\n\treturn &Service{store: s}\r\n}\r\n\r\nfunc (s *Service) Add(user, action, resourceType, resourceID, details, sourceIP string) {\r\n\t_ = s.store.WithLock(func(d *store.Data) error {\r\n\t\td.Audit = append(d.Audit, store.AuditEntry{\r\n"]
[4019.575281, "o", "\t\t\tTimestamp:    time.Now().UTC(),\r\n\t\t\tUser:         user,\r\n\t\t\tAction:       action,\r\n\t\t\tResourceType: resourceType,\r\n\t\t\tResourceID:   resourceID,\r\n\t\t\tDetails:      sanitizeDetail(details),\r\n\t\t\tSourceIP:     sourceIP,\r\n\t\t})\r\n\t\tif len(d.Audit) > 1000 {\r\n\t\t\td.Audit = d.Audit[len(d.Audit)-1000:]\r\n\t\t}\r\n"]
[4019.57535, "o", "\t\treturn nil\r\n\t})\r\n}\r\n\r\nfunc sanitizeDetail(details string) string {\r\n\tcleaned := make([]byte, 0, len(details))\r\n\tfor i := 0; i < len(details); i++ {\r\n\t\tb := details[i]\r\n\t\tif b < 0x20 && b != ' ' {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[4019.575411, "o", "\t\tcleaned = append(cleaned, b)\r\n\t}\r\n\r\n\tconst maxRunes = 256\r\n\tif utf8.RuneCountInString(string(cleaned)) <= maxRunes {\r\n\t\treturn string(cleaned)\r\n\t}\r\n\r\n"]
[4019.57547, "o", "\tvar n int\r\n\tfor i := 0; i < len(cleaned) && n < maxRunes; {\r\n\t\t_, size := utf8.DecodeRuneInString(cleaned[i:])\r\n\t\tif size == 0 {\r\n\t\t\tbreak\r\n\t\t}\r\n\t\ti += size\r\n\t\tn++\r\n"]
[4019.575529, "o", "\t}\r\n\treturn string(cleaned[:i]) + \"...[truncated]\"\r\n}\r\n\r\nfunc (s *Service) List() []store.AuditEntry {\r\n\tvar entries []store.AuditEntry\r\n\t_ = s.store.WithRLock(func(d *store.Data) error {\r\n\t\tentries = make([]store.AuditEntry, len(d.Audit))\r\n\t\tcopy(entries, d.Audit)\r\n\t\treturn nil\r\n"]
[4019.575586, "o", "\t})\r\n\treturn entries\r\n}\r\n"]
[4019.578725, "o", "func (s *Server) UpdateConfig(w http.ResponseWriter, r *http.Request) {\r\n\tuser, ok := s.requireAuth(w, r, auth.RoleAdmin)\r\n\tif !ok {\r\n\t\treturn\r\n"]
[4019.578797, "o", "\t}\r\n\r\n\tbody, err := io.ReadAll(r.Body)\r\n\tif err != nil {\r\n\t\twriteBodyReadError(w, err)\r\n\t\treturn\r\n\t}\r\n\r\n\tvar patch map[string]interface{}\r\n\tif err := json.Unmarshal(body, &patch); err != nil {\r\n\t\twriteBodyReadError(w, err)\r\n\t\treturn\r\n\t}\r\n\r\n\tcfg := *s.cfg\r\n\tif v, ok := patch[\"port\"]; ok {\r\n\t\tif f, ok := v.(float64); ok {\r\n"]
[4019.578891, "o", "\t\t\tcfg.Port = int(f)\r\n\t\t}\r\n\t}\r\n\tif v, ok := patch[\"inference_timeout_sec\"]; ok {\r\n\t\tif f, ok := v.(float64); ok {\r\n\t\t\tcfg.InferenceTimeoutSec = int(f)\r\n\t\t}\r\n\t}\r\n"]
[4019.578958, "o", "\tif v, ok := patch[\"max_batch_size\"]; ok {\r\n\t\tif f, ok := v.(float64); ok {\r\n\t\t\tcfg.MaxBatchSize = int(f)\r\n\t\t}\r\n\t}\r\n\tif v, ok := patch[\"log_level\"]; ok {\r\n\t\tif s, ok := v.(string); ok {\r\n\t\t\tcfg.LogLevel = s\r\n\t\t}\r\n\t}\r\n\tif v, ok := patch[\"webhook_timeout_sec\"]; ok {\r\n\t\tif f, ok := v.(float64); ok {\r\n\t\t\tcfg.WebhookTimeoutSec = int(f)\r\n"]
[4019.579023, "o", "\t\t}\r\n\t}\r\n\tif v, ok := patch[\"metrics_retention_hours\"]; ok {\r\n\t\tif f, ok := v.(float64); ok {\r\n\t\t\tcfg.MetricsRetentionHours = int(f)\r\n\t\t}\r\n\t}\r\n\tif v, ok := patch[\"max_model_size_mb\"]; ok {\r\n\t\tif f, ok := v.(float64); ok {\r\n\t\t\tcfg.MaxModelSizeMB = int(f)\r\n\t\t}\r\n\t}\r\n\r\n\t"]
[4019.579086, "o", "if err := config.Save(s.cfg.DataDir+\"/config.json\", &cfg); err != nil {\r\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\r\n\t\treturn\r\n\t}\r\n\t*s.cfg = cfg\r\n\ts.auditReq(r, user.Username, \"config.update\", \"config\", \"config\", string(body))\r\n"]
[4019.57955, "o", "\u001b[?2004h"]
