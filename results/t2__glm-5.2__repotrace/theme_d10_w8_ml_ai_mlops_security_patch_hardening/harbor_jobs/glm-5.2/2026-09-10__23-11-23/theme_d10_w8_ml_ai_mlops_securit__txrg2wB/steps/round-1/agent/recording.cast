[1590.394432, "o", "\u001b[?2004h>     \"encoding/json\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.394493, "o", "    \"errors\"\r\n\u001b[?2004l\r\u001b[?2004h>     \"fmt\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.394544, "o", ">     \"os/exec\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.394593, "o", "    \"time\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.394659, "o", "    \"mlgateway/internal/registry\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.39472, "o", "    \"mlgateway/internal/store\"\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[1590.394767, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.394831, "o", "var ErrNotDeployed = errors.New(\"model not deployed\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1590.394872, "o", "\u001b[?2004h> "]
[1590.39491, "o", "type Service struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.394949, "o", "    registry *registry.Service\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.39501, "o", "    timeout  time.Duration\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1590.395048, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.395168, "o", "func New(r *registry.Service, timeoutSec int) *Service {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.395207, "o", "    if timeoutSec <= 0 {\r\n\u001b[?2004l\r"]
[1590.395245, "o", "\u001b[?2004h> "]
[1590.395281, "o", "        timeoutSec = 30\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1590.395319, "o", "\u001b[?2004h> "]
[1590.395486, "o", "    return &Service{registry: r, timeout: time.Duration(timeoutSec) * time.Second}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.395531, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1590.39557, "o", "\u001b[?2004h> "]
[1590.395863, "o", "func (s *Service) Infer(modelName string, input json.RawMessage) (map[string]interface{}, *store.Model, *store.Version, float64, error) {\r\n\u001b[?2004l\r"]
[1590.395901, "o", "\u001b[?2004h> "]
[1590.396039, "o", "    model, version, err := s.registry.FindDeployedByName(modelName)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.396114, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.396243, "o", "        return nil, nil, nil, 0, ErrNotDeployed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.396281, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.396326, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.396371, "o", "    start := time.Now()\r\n\u001b[?2004l\r"]
[1590.396417, "o", "\u001b[?2004h> "]
[1590.396524, "o", "    out, err := s.runBinary(version.BinaryPath, input)\r\n\u001b[?2004l\r"]
[1590.396563, "o", "\u001b[?2004h> "]
[1590.3967, "o", "    latency := float64(time.Since(start).Microseconds()) / 1000.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.396768, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1590.396812, "o", "\u001b[?2004h> "]
[1590.396881, "o", "        return nil, model, version, latency, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.396925, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.396991, "o", "    var result map[string]interface{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.397084, "o", "    if err := json.Unmarshal(out, &result); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.397225, "o", "        return nil, model, version, latency, fmt.Errorf(\"invalid model output: %w\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.397265, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.397382, "o", "    return result, model, version, latency, nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.397427, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1590.397465, "o", "\u001b[?2004h> "]
[1590.397656, "o", "func (s *Service) runBinary(binaryPath string, input json.RawMessage) ([]byte, error) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.397695, "o", "> "]
[1590.397843, "o", "    ctx, cancel := context.WithTimeout(context.Background(), s.timeout)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.397882, "o", "> "]
[1590.397923, "o", "    defer cancel()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1590.397963, "o", "\u001b[?2004h> "]
[1590.398062, "o", "    cmd := exec.CommandContext(ctx, binaryPath)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.398177, "o", "    cmd.Stdin = bytes.NewReader(input)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.39828, "o", "    var stdout, stderr bytes.Buffer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.398352, "o", "    cmd.Stdout = &stdout\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.398396, "o", "    cmd.Stderr = &stderr\r\n\u001b[?2004l\r\u001b[?2004h"]
[1590.398441, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.398486, "o", "    err := cmd.Run()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.398543, "o", "    if ctx.Err() == context.DeadlineExceeded {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.398633, "o", "        return nil, fmt.Errorf(\"inference timed out\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.398678, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.398722, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.398828, "o", "        return nil, fmt.Errorf(\"inference failed: %v: %s\", err, stderr.String())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.398872, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1590.398917, "o", "    return stdout.Bytes(), nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1590.398962, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
