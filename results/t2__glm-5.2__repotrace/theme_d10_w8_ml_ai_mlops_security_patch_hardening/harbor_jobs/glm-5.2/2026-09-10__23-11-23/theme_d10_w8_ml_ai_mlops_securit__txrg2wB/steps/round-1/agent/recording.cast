[2297.683549, "o", "s.auditReq(r, user.Username, \"inference.batch\", \"model\", modelName, fmt.Sprintf(\"count=%d\", len(req.Inputs)))\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\t\t\"model\":   modelNameResolved,\r\n\t\t\"version\": versionResolved,\r\n\t\t\"results\": results,\r\n\t\t\"errors\":  errorsList,\r\n\t})\r\n}\r\n\r\nfunc (s *Server) Metrics(w http.ResponseWriter, r *http.Request) {\r\n\tif _, ok := s.requireAuth(w, r, auth.RoleAdmin); !ok {\r\n"]
