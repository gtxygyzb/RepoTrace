[4247.449934, "o", "\u001b[?2004h> "]
[4247.449988, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4247.450043, "o", "> "]
[4247.450148, "o", "\\treturn string(buf)\r\n\u001b[?2004l\r"]
[4247.450205, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4247.45026, "o", "\u001b[?2004h> "]
[4247.450323, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h"]
[4247.450383, "o", "> "]
