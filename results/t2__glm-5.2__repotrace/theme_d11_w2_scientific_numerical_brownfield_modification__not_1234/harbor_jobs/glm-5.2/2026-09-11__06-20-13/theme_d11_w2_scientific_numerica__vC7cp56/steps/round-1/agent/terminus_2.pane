[?2004hroot@n30009:/app# cp nlsolve.c nlsolve.c.bak
[?2004l = 0;
    int *queue = xmalloc((size_t)n * sizeof(int));
    int comp_index = 0;

    while (final_count < n) {
        int seed = -1;
        for (int i = 0; i < n; i++) {
            if (!visited[i]) {
                seed = i;
                break;
            }
        }
        if (seed == -1) break;

        int comp_count = 0;
        int qhead = 0, qtail = 0;
        comp_id[seed] = comp_index;
        comp_nodes[comp_count++] = seed;
        queue[qtail++] = seed;
        while (qhead < qtail) {
            int v = queue[qhead++];
            int base = adj_ptr[v];
            int deg = adj_ptr[v + 1] - base;
            for (int idx = 0; idx < deg; idx++) {
                int u = adj[base + idx];
                if (!visited[u] && comp_id[u] == -1) {
                    comp_id[u] = comp_index;
                    comp_nodes[comp_count++] = u;
                    queue[qtail++] = u;
                }
            }
        }

        int start = comp_nodes[0];
        for (int i = 1; i < comp_count; i++) {
            int c = comp_nodes[i];
            if (degree[c] < degree[start] ||
                (degree[c] == degree[start] && c < start)) {
                start = c;
            }
        }

        int comp_order_start = final_count;
        qhead = 0;
        qtail = 0;
        visited[start] = 1;
        queue[qtail++] = start;
        while (qhead < qtail) {
            int v = queue[qhead++];
            final_order[final_count++] = v;
            int base = adj_ptr[v];
            int deg = adj_ptr[v + 1] - base;
            int *nbrs = xmalloc((size_t)(deg ? deg : 1) * sizeof(int));
            int cnt = 0;
            for (int idx = 0; idx < deg; idx++) {
                int u = adj[base + idx];
                if (comp_id[u] == comp_index && !visited[u]) nbrs[cnt++] = u;
            }
            for (int a = 1; a < cnt; a++) {
                int key = nbrs[a];
                int b = a - 1;
                while (b >= 0) {
                    if (degree[nbrs[b]] < degree[key] ||
                        (degree[nbrs[b]] == degree[key] && nbrs[b] < key)) break;
                    nbrs[b + 1] = nbrs[b];
                    b--;
                }
                nbrs[b + 1] = key;
            }
            for (int idx = 0; idx < cnt; idx++) {
                int u = nbrs[idx];
                if (!visited[u]) {
                    visited[u] = 1;
                    queue[qtail++] = u;
                }
            }
            free(nbrs);
        }

        int left = comp_order_start;
        int right = final_count - 1;
        while (left < right) {
            int tmp = final_order[left];
            final_order[left] = final_order[right];
            final_order[right] = tmp;
            left++;
            right--;
        }

        comp_index++;
    }

    for (int i = 0; i < n; i++) perm[final_order[i]] = i;

    free(adj_ptr);
    free(adj_count);
    free(adj);
    free(degree);
    free(visited);
    free(comp_id);
    free(comp_nodes);
    free(final_order);
    free(queue);
}

