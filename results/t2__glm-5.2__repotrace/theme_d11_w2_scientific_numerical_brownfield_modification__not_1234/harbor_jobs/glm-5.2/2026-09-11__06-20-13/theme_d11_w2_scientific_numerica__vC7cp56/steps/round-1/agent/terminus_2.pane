    83	static double dot(int n, const double *a, const double *b) {
    84	    double s = 0.0;
    85	    for (int i = 0; i < n; i++) s += a[i] * b[i];
    86	    return s;
    87	}
    88	
    89	static void dcopy(int n, const double *src, double *dst) {
    90	    for (int i = 0; i < n; i++) dst[i] = src[i];
    91	}
    92	
    93	static int cmp_entry(const void *a, const void *b) {
    94	    const Entry *ea = (const Entry *)a;
    95	    const Entry *eb = (const Entry *)b;
    96	    if (ea->r != eb->r) return ea->r - eb->r;
    97	    return ea->c - eb->c;
    98	}
    99	
   100	static void add_entry(Entry **arr, int *count, int *cap, int r, int c, double v) {
   101	    if (*count == *cap) {
   102	        *cap = (*cap ? *cap * 2 : 16);
   103	        *arr = realloc(*arr, (size_t)*cap * sizeof(Entry));
   104	        if (!*arr) die("out of memory");
   105	    }
   106	    (*arr)[*count].r = r;
   107	    (*arr)[*count].c = c;
   108	    (*arr)[*count].v = v;
   109	    (*count)++;
   110	}
   111	
   112	static CSRMatrix *build_csr(int n, Entry *entries, int count, int symmetric) {
   113	    if (count > 0) qsort(entries, (size_t)count, sizeof(Entry), cmp_entry);
   114	
   115	    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
   116	    int *tmp_count = xcalloc((size_t)n, sizeof(int));
   117	
   118	    int unique = 0;
   119	    for (int i = 0; i < count; ) {
   120	        int r = entries[i].r;
   121	        int c = entries[i].c;
   122	        double sum = 0.0;
   123	        while (i < count && entries[i].r == r && entries[i].c == c) {
   124	            sum += entries[i].v;
   125	            i++;
   126	        }
   127	        entries[unique].r = r;
   128	        entries[unique].c = c;
   129	        entries[unique].v = sum;
   130	        unique++;
   131	        tmp_count[r]++;
   132	    }
   133	
   134	    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + tmp_count[i];
   135	    free(tmp_count);
   136	
   137	    int *col_idx = xmalloc((size_t)unique * sizeof(int));
   138	    double *vals = xmalloc((size_t)unique * sizeof(double));
   139	    int *next = xcalloc((size_t)n, sizeof(int));
   140	
   141	    for (int i = 0; i < unique; i++) {
   142	        int r = entries[i].r;
   143	        int pos = row_ptr[r] + next[r]++;
   144	        col_idx[pos] = entries[i].c;
   145	        vals[pos] = entries[i].v;
   146	    }
   147	    free(next);
   148	
   149	    CSRMatrix *m = xmalloc(sizeof(CSRMatrix));
   150	    m->n = n;
   151	    m->nnz = unique;
   152	    m->row_ptr = row_ptr;
   153	    m->col_idx = col_idx;
   154	    m->vals = vals;
   155	    m->symmetric = symmetric;
   156	    return m;
   157	}
   158	
   159	static double *compute_diag(CSRMatrix *m) {
   160	    double *diag = xcalloc((size_t)m->n, sizeof(double));
   161	    for (int i = 0; i < m->n; i++) {
   162	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   163	            if (m->col_idx[idx] == i) diag[i] += m->vals[idx];
   164	        }
   165	    }
   166	    return diag;
   167	}
