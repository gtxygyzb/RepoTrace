   311	static void write_matrix_market(const char *filename, int n, int nnz, Entry *entries) {
   312	    FILE *f = fopen(filename, "w");
   313	    if (!f) die("cannot open output matrix file");
   314	    fprintf(f, "%%%%MatrixMarket matrix coordinate real symmetric\n");
   315	    fprintf(f, "%d %d %d\n", n, n, nnz);
   316	    for (int k = 0; k < nnz; k++) {
   317	        fprintf(f, "%d %d %.15g\n", entries[k].r + 1, entries[k].c + 1, entries[k].v);
   318	    }
   319	    fclose(f);
   320	}
