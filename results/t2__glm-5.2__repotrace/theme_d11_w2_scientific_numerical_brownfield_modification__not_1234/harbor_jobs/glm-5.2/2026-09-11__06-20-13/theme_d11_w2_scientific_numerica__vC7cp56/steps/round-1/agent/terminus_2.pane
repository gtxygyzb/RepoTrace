    t->row_ptr = row_ptr;
    t->col_idx = col_idx;
    t->vals = vals;
    return t;
}

static void free_tri_matrix(TriMatrix *t) {
    if (!t) return;
    free(t->row_ptr);
    free(t->col_idx);
    free(t->vals);
    free(t);
}

