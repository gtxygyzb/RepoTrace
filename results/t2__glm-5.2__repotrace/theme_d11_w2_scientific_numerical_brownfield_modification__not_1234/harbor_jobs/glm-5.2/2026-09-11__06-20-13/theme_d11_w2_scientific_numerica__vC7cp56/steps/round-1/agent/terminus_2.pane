   292	        if (fscanf(f, "%lf", &x[i]) != 1) {
   293	            fclose(f);
   294	            free(x);
   295	            die("failed to read vector entry");
   296	        }
   297	    }
   298	
   299	    if (has_trailing_data(f)) {
   300	        fclose(f);
   301	        free(x);
   302	        die("extra trailing data in vector file");
   303	    }
   304	
   305	    fclose(f);
   306	    *n_out = n;
   307	    return x;
   308	}
