   954	static double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {
   955	    int n = A->n;
   956	    double *x = xcalloc((size_t)n, sizeof(double));
   957	    double *r = xmalloc((size_t)n * sizeof(double));
   958	    double *r0 = xmalloc((size_t)n * sizeof(double));
   959	    double *pvec = xmalloc((size_t)n * sizeof(double));
   960	    double *v = xmalloc((size_t)n * sizeof(double));
   961	    double *s = xmalloc((size_t)n * sizeof(double));
   962	    double *t = xmalloc((size_t)n * sizeof(double));
   963	    double *z = xmalloc((size_t)n * sizeof(double));
   964	
   965	    spmv(A, x, r);
   966	    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
   967	    double bnorm = vec_norm2(n, b);
   968	    int it_count = 0;
   969	
   970	    dcopy(n, r, r0);
   971	    double rho_old = dot(n, r0, r);
   972	    if (rho_old == 0.0) {
   973	        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
   974	        die("BiCGSTAB numerical breakdown");
   975	    }
   976	    dcopy(n, r, pvec);
   977	
   978	    for (int it = 0; it < max_it; it++) {
   979	        precond_apply(p, pvec, z);
   980	        spmv(A, z, v);
   981	        double r0v = dot(n, r0, v);
   982	        if (r0v == 0.0) {
   983	            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
   984	            die("BiCGSTAB numerical breakdown");
   985	        }
   986	        double alpha = rho_old / r0v;
   987	        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];
   988	
   989	        if (vec_norm2(n, s) <= tol * bnorm) {
   990	            for (int i = 0; i < n; i++) x[i] += alpha * z[i];
   991	            it_count = it + 1;
   992	            if (history) {
   993	                printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, s));
   994	            }
   995	            break;
   996	        }
   997	
   998	        precond_apply(p, s, z);
   999	        spmv(A, z, t);
  1000	        double ts = dot(n, t, s);
  1001	        double tt = dot(n, t, t);
  1002	        if (tt == 0.0) {
  1003	            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1004	            die("BiCGSTAB numerical breakdown");
  1005	        }
  1006	        double omega = ts / tt;
  1007	        for (int i = 0; i < n; i++) {
  1008	            x[i] += alpha * z[i] + omega * s[i];
  1009	            r[i] = s[i] - omega * t[i];
  1010	        }
  1011	        it_count = it + 1;
  1012	        if (history) {
  1013	            printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, r));
  1014	        }
  1015	        if (vec_norm2(n, r) <= tol * bnorm) break;
  1016	
  1017	        double rho_new = dot(n, r0, r);
  1018	        if (rho_new == 0.0) {
  1019	            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1020	            die("BiCGSTAB numerical breakdown");
  1021	        }
  1022	        double beta = (rho_new / rho_old) * (alpha / omega);
  1023	        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];
  1024	        rho_old = rho_new;
  1025	    }
  1026	
  1027	    if (iterations_out) *iterations_out = it_count;
  1028	    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1029	    return x;
  1030	}
