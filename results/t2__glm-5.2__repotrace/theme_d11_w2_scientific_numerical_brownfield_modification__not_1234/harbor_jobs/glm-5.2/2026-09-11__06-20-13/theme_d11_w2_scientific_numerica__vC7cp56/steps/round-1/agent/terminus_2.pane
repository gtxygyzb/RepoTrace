  1262	int main(int argc, char **argv) {
  1263	    const char *input = NULL;
  1264	    const char *rhs = NULL;
  1265	    const char *solver_name = NULL;
  1266	    const char *precond_name = NULL;
  1267	    const char *reorder_name = NULL;
