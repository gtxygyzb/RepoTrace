[?2004l[?2004h> 
[?2004l[?2004h>     const char *dominance;
[?2004l[?2004h>     if (strict_count == m->n) dominance = "strict";
[?2004l[?2004h>     else if (weak_all) dominance = "weak";
[?2004l[?2004h>     else dominance = "no";
[?2004l[?2004h> 
[?2004l[?2004h>     printf("dimension: %d\n", m->n);
