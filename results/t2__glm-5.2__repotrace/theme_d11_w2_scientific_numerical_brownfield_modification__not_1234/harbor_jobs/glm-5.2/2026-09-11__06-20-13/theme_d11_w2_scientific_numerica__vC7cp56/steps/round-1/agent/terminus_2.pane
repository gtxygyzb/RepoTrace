[?2004l   950	static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {
   951	    int n = A->n;
   952	    double *x = xcalloc((size_t)n, sizeof(double));
   953	    double *r = xmalloc((size_t)n * sizeof(double));
   954	    double *z = xmalloc((size_t)n * sizeof(double));
   955	    double *pvec = xmalloc((size_t)n * sizeof(double));
   956	    double *Ap = xmalloc((size_t)n * sizeof(double));
   957	
   958	    spmv(A, x, r);
   959	    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
   960	    double bnorm = vec_norm2(n, b);
   961	    int it_count = 0;
   962	
   963	    precond_apply(p, r, z);
   964	    dcopy(n, z, pvec);
   965	    double rz_old = dot(n, r, z);
   966	
   967	    for (int it = 0; it < max_it; it++) {
   968	        spmv(A, pvec, Ap);
   969	        double pAp = dot(n, pvec, Ap);
   970	        if (pAp <= 0.0) {
   971	            free(r); free(z); free(pvec); free(Ap);
   972	            die("matrix is not positive definite");
   973	        }
   974	        double alpha = rz_old / pAp;
   975	        for (int i = 0; i < n; i++) {
   976	            x[i] += alpha * pvec[i];
   977	            r[i] -= alpha * Ap[i];
   978	        }
   979	        it_count = it + 1;
   980	        if (history) {
   981	            printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, r));
   982	        }
   983	        if (vec_norm2(n, r) <= tol * bnorm) break;
   984	
   985	        precond_apply(p, r, z);
   986	        double rz_new = dot(n, r, z);
   987	        if (rz_old == 0.0) {
   988	            free(r); free(z); free(pvec); free(Ap);
   989	            die("CG numerical breakdown");
   990	        }
   991	        double beta = rz_new / rz_old;
   992	        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];
   993	        rz_old = rz_new;
   994	    }
   995	
   996	    if (iterations_out) *iterations_out = it_count;
   997	    free(r); free(z); free(pvec); free(Ap);
   998	    return x;
   999	}
  1000	
  1001	static double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {
  1002	    int n = A->n;
  1003	    double *x = xcalloc((size_t)n, sizeof(double));
  1004	    double *r = xmalloc((size_t)n * sizeof(double));
  1005	    double *r0 = xmalloc((size_t)n * sizeof(double));
  1006	    double *pvec = xmalloc((size_t)n * sizeof(double));
  1007	    double *v = xmalloc((size_t)n * sizeof(double));
  1008	    double *s = xmalloc((size_t)n * sizeof(double));
  1009	    double *t = xmalloc((size_t)n * sizeof(double));
  1010	    double *z = xmalloc((size_t)n * sizeof(double));
  1011	
  1012	    spmv(A, x, r);
  1013	    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
  1014	    double bnorm = vec_norm2(n, b);
  1015	    int it_count = 0;
  1016	
  1017	    dcopy(n, r, r0);
  1018	    double rho_old = dot(n, r0, r);
  1019	    if (rho_old == 0.0) {
  1020	        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1021	        die("BiCGSTAB numerical breakdown");
  1022	    }
  1023	    dcopy(n, r, pvec);
  1024	
  1025	    for (int it = 0; it < max_it; it++) {
  1026	        precond_apply(p, pvec, z);
  1027	        spmv(A, z, v);
  1028	        double r0v = dot(n, r0, v);
  1029	        if (r0v == 0.0) {
  1030	            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1031	            die("BiCGSTAB numerical breakdown");
  1032	        }
  1033	        double alpha = rho_old / r0v;
  1034	        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];
  1035	
  1036	        if (vec_norm2(n, s) <= tol * bnorm) {
  1037	            for (int i = 0; i < n; i++) x[i] += alpha * z[i];
  1038	            it_count = it + 1;
  1039	            if (history) {
  1040	                printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, s));
  1041	            }
  1042	            break;
  1043	        }
  1044	
  1045	        precond_apply(p, s, z);
  1046	        spmv(A, z, t);
  1047	        double ts = dot(n, t, s);
  1048	        double tt = dot(n, t, t);
  1049	        if (tt == 0.0) {
  1050	            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1051	            die("BiCGSTAB numerical breakdown");
  1052	        }
  1053	        double omega = ts / tt;
  1054	        for (int i = 0; i < n; i++) {
  1055	            x[i] += alpha * z[i] + omega * s[i];
  1056	            r[i] = s[i] - omega * t[i];
  1057	        }
  1058	        it_count = it + 1;
  1059	        if (history) {
  1060	            printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, r));
  1061	        }
  1062	        if (vec_norm2(n, r) <= tol * bnorm) break;
  1063	
  1064	        double rho_new = dot(n, r0, r);
  1065	        if (rho_new == 0.0) {
  1066	            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1067	            die("BiCGSTAB numerical breakdown");
  1068	        }
  1069	        double beta = (rho_new / rho_old) * (alpha / omega);
  1070	        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];
  1071	        rho_old = rho_new;
  1072	    }
  1073	
  1074	    if (iterations_out) *iterations_out = it_count;
  1075	    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1076	    return x;
  1077	}
