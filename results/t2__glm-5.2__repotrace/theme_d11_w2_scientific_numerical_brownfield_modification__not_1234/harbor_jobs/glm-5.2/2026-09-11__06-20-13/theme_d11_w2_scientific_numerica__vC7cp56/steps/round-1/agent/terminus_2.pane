   406	static void analyze_matrix(CSRMatrix *m) {
   407	    double *diag = compute_diag(m);
   408	    int bandwidth = 0;
   409	    long profile = 0;
   410	    int strict_count = 0;
   411	    int weak_all = 1;
   412	
   413	    for (int i = 0; i < m->n; i++) {
   414	        int min_col = i;
   415	        int has_off = 0;
   416	        double off_sum = 0.0;
   417	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   418	            int j = m->col_idx[idx];
   419	            int diff = i - j;
   420	            if (diff < 0) diff = -diff;
   421	            if (diff > bandwidth) bandwidth = diff;
   422	            if (j < i) {
   423	                if (!has_off || j < min_col) min_col = j;
   424	                has_off = 1;
   425	                off_sum += fabs(m->vals[idx]);
   426	            } else if (j > i) {
   427	                has_off = 1;
   428	                if (j < min_col) min_col = j;
   429	                off_sum += fabs(m->vals[idx]);
   430	            }
   431	        }
   432	        if (has_off) profile += (long)(i - min_col);
   433	
   434	        double d = fabs(diag[i]);
   435	        if (d > off_sum + 1e-300) {
   436	            strict_count++;
   437	        } else if (d >= off_sum - 1e-300) {
   438	            // weak candidate
   439	        } else {
   440	            weak_all = 0;
[?2004hroot@n30009:/app# nl -ba nlsolve.c | sed -n '441,604p'
[?2004l   441	        }
   442	    }
   443	
   444	    const char *dominance;
   445	    if (strict_count == m->n) dominance = "strict";
   446	    else if (weak_all) dominance = "weak";
   447	    else dominance = "no";
   448	
   449	    printf("dimension: %d\n", m->n);
   450	    printf("nonzeros: %d\n", m->nnz);
   451	    printf("symmetric: %s\n", m->symmetric ? "yes" : "no");
   452	    printf("bandwidth: %d\n", bandwidth);
   453	    printf("profile: %ld\n", profile);
   454	    printf("diag_dominant: %s\n", dominance);
   455	    free(diag);
   456	}
