   282	static double *read_vector(const char *filename, int *n_out) {
   283	    FILE *f = fopen(filename, "r");
   284	    if (!f) die("cannot open rhs file");
   285	    int n;
   286	    if (fscanf(f, "%d", &n) != 1) {
   287	        fclose(f);
   288	        die("failed to read vector dimension");
   289	    }
   290	    if (n <= 0) die("invalid vector dimension");
   291	    double *x = xmalloc((size_t)n * sizeof(double));
   292	    for (int i = 0; i < n; i++) {
   293	        if (fscanf(f, "%lf", &x[i]) != 1) {
   294	            fclose(f);
   295	            free(x);
   296	            die("failed to read vector entry");
   297	        }
   298	    }
   299	
   300	    if (has_trailing_data(f)) {
   301	        fclose(f);
   302	        free(x);
   303	        die("extra trailing data in vector file");
   304	    }
   305	
   306	    fclose(f);
   307	    *n_out = n;
   308	    return x;
   309	}
