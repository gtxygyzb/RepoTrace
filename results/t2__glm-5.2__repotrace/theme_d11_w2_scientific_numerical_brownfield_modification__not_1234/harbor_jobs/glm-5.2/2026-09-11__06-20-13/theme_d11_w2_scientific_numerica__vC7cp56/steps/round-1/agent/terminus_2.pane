static void free_tri_matrix(TriMatrix *t) {
    if (!t) return;
    free(t->row_ptr);
    free(t->col_idx);
    free(t->vals);
    free(t);
}

static ICFactor *ic0_factorize(const CSRMatrix *m) {
    int n = m->n;
    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
    for (int i = 0; i < n; i++) {
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            if (m->col_idx[idx] < i) row_ptr[i + 1]++;
        }
    }
    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];

    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));
    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));
    int *next = xcalloc((size_t)n, sizeof(int));
    for (int i = 0; i < n; i++) {
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            int j = m->col_idx[idx];
            if (j < i) col_idx[row_ptr[i] + next[i]++] = j;
        }
    }
    free(next);

    double *diag = xmalloc((size_t)n * sizeof(double));
    for (int i = 0; i < n; i++) {
        double aii = 0.0;
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            if (m->col_idx[idx] == i) aii += m->vals[idx];
        }

        double sum = aii;
        for (int k = row_ptr[i]; k < row_ptr[i + 1]; k++) {
            int j = col_idx[k];
            double aij = 0.0;
            for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
                if (m->col_idx[idx] == j) {
                    aij += m->vals[idx];
                    break;
                }
            }

            double s = aij;
            int pi = row_ptr[i];
            int pj = row_ptr[j];
            while (pi < k && pj < row_ptr[j + 1]) {
                int ci = col_idx[pi];
                int cj = col_idx[pj];
                if (ci == cj) {
                    s -= vals[pi] * vals[pj];
                    pi++;
                    pj++;
                } else if (ci < cj) {
                    pi++;
                } else {
                    pj++;
                }
            }

            if (diag[j] <= 0.0) die("zero or negative pivot in IC(0) factorization");
            double l = s / diag[j];
            vals[k] = l;
            sum -= l * l;
        }

        if (sum <= 0.0) die("zero or negative pivot in IC(0) factorization");
        diag[i] = sqrt(sum);
    }

    ICFactor *ic = xmalloc(sizeof(ICFactor));
    ic->n = n;
    ic->l_row_ptr = row_ptr;
    ic->l_col_idx = col_idx;
    ic->l_vals = vals;
    ic->diag = diag;
    ic->u_row_ptr = NULL;
    ic->u_col_idx = NULL;
    ic->u_vals = NULL;
    return ic;
}

static Precond *precond_setup(CSRMatrix *m, int type, double omega) {
    Precond *p = xmalloc(sizeof(Precond));
    p->type = type;
    p->A = m;
    p->diag = NULL;
    p->lower = NULL;
    p->upper = NULL;
    p->omega = omega;
    p->ic = NULL;

    if (type == PRECOND_JACOBI) {
        p->diag = compute_diag(m);
        for (int i = 0; i < m->n; i++) {
            if (p->diag[i] == 0.0) die("zero diagonal in Jacobi preconditioner");
        }
    } else if (type == PRECOND_SSOR) {
        if (omega <= 0.0 || omega >= 2.0) die("invalid SSOR parameter");
        p->diag = compute_diag(m);
        p->lower = build_lower_triangular(m);
        p->upper = build_upper_triangular(m);
    } else if (type == PRECOND_IC0) {
        if (!m->symmetric) die("IC(0) requires symmetric matrix");
        p->ic = ic0_factorize(m);
    }

    return p;
}

static void precond_apply(Precond *p, const double *r, double *z) {
    int n = p->A->n;

    if (p->type == PRECOND_NONE) {
        dcopy(n, r, z);
        return;
    }

    if (p->type == PRECOND_JACOBI) {
        for (int i = 0; i < n; i++) {
            if (p->diag[i] == 0.0) die("zero diagonal in Jacobi preconditioner");
            z[i] = r[i] / p->diag[i];
        }
        return;
    }

    if (p->type == PRECOND_SSOR) {
        dcopy(n, r, z);
        for (int i = 0; i < n; i++) {
            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {
                int j = p->lower->col_idx[idx];
                if (j < i) z[i] -= p->lower->vals[idx] * z[j];
            }
            if (p->diag[i] == 0.0) {
                z[i] = 0.0;
                continue;
            }
            z[i] /= p->diag[i];
        }
        for (int i = n - 1; i >= 0; i--) {
            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {
                int j = p->upper->col_idx[idx];
                if (j > i) z[i] -= p->upper->vals[idx] * z[j];
            }
            if (p->diag[i] == 0.0) {
                z[i] = 0.0;
                continue;
            }
            z[i] /= p->diag[i];
        }
        return;
    }

    if (p->type == PRECOND_IC0) {
        ICFactor *ic = p->ic;
        for (int i = 0; i < n; i++) {
            double s = r[i];
            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {
                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];
            }
            if (ic->diag[i] == 0.0) die("zero or negative pivot in IC(0) factorization");
            z[i] = s / ic->diag[i];
        }
        for (int i = n - 1; i >= 0; i--) {
            z[i] /= ic->diag[i];
            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {
                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];
            }
        }
        return;
    }

    die("unknown preconditioner");
}

static void free_precond(Precond *p) {
    if (!p) return;
    free(p->diag);
    free_tri_matrix(p->lower);
    free_tri_matrix(p->upper);
    if (p->ic) {
        free(p->ic->l_row_ptr);
        free(p->ic->l_col_idx);
        free(p->ic->l_vals);
[?2004hroot@n30009:/app# sed -n '940,1140p' nlsolve.c
[?2004l        free(p->ic->l_vals);
        free(p->ic->diag);
        free(p->ic->u_row_ptr);
        free(p->ic->u_col_idx);
        free(p->ic->u_vals);
        free(p->ic);
    }
    free(p);
}

static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {
    int n = A->n;
    double *x = xcalloc((size_t)n, sizeof(double));
    double *r = xmalloc((size_t)n * sizeof(double));
    double *z = xmalloc((size_t)n * sizeof(double));
    double *pvec = xmalloc((size_t)n * sizeof(double));
    double *Ap = xmalloc((size_t)n * sizeof(double));

    spmv(A, x, r);
    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
    double bnorm = vec_norm2(n, b);
    int it_count = 0;

    precond_apply(p, r, z);
    dcopy(n, z, pvec);
    double rz_old = dot(n, r, z);

    for (int it = 0; it < max_it; it++) {
        spmv(A, pvec, Ap);
        double pAp = dot(n, pvec, Ap);
        if (pAp <= 0.0) {
            free(r); free(z); free(pvec); free(Ap);
            die("matrix is not positive definite");
        }
        double alpha = rz_old / pAp;
        for (int i = 0; i < n; i++) {
            x[i] += alpha * pvec[i];
            r[i] -= alpha * Ap[i];
        }
        it_count = it + 1;
        if (history) {
            printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, r));
        }
        if (vec_norm2(n, r) <= tol * bnorm) break;

        precond_apply(p, r, z);
        double rz_new = dot(n, r, z);
        if (rz_old == 0.0) {
            free(r); free(z); free(pvec); free(Ap);
            die("CG numerical breakdown");
        }
        double beta = rz_new / rz_old;
        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];
        rz_old = rz_new;
    }

    if (iterations_out) *iterations_out = it_count;
    free(r); free(z); free(pvec); free(Ap);
    return x;
}

static double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {
    int n = A->n;
    double *x = xcalloc((size_t)n, sizeof(double));
    double *r = xmalloc((size_t)n * sizeof(double));
    double *r0 = xmalloc((size_t)n * sizeof(double));
    double *pvec = xmalloc((size_t)n * sizeof(double));
    double *v = xmalloc((size_t)n * sizeof(double));
    double *s = xmalloc((size_t)n * sizeof(double));
    double *t = xmalloc((size_t)n * sizeof(double));
    double *z = xmalloc((size_t)n * sizeof(double));

    spmv(A, x, r);
    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
    double bnorm = vec_norm2(n, b);
    int it_count = 0;

    dcopy(n, r, r0);
    double rho_old = dot(n, r0, r);
    if (rho_old == 0.0) {
        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
        die("BiCGSTAB numerical breakdown");
    }
    dcopy(n, r, pvec);

    for (int it = 0; it < max_it; it++) {
        precond_apply(p, pvec, z);
        spmv(A, z, v);
        double r0v = dot(n, r0, v);
        if (r0v == 0.0) {
            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
            die("BiCGSTAB numerical breakdown");
        }
        double alpha = rho_old / r0v;
        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];

        if (vec_norm2(n, s) <= tol * bnorm) {
            for (int i = 0; i < n; i++) x[i] += alpha * z[i];
            it_count = it + 1;
            if (history) {
                printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, s));
            }
            break;
        }

        precond_apply(p, s, z);
        spmv(A, z, t);
        double ts = dot(n, t, s);
        double tt = dot(n, t, t);
        if (tt == 0.0) {
            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
            die("BiCGSTAB numerical breakdown");
        }
        double omega = ts / tt;
        for (int i = 0; i < n; i++) {
            x[i] += alpha * z[i] + omega * s[i];
            r[i] = s[i] - omega * t[i];
        }
        it_count = it + 1;
        if (history) {
            printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, r));
        }
        if (vec_norm2(n, r) <= tol * bnorm) break;

        double rho_new = dot(n, r0, r);
        if (rho_new == 0.0) {
            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
            die("BiCGSTAB numerical breakdown");
        }
        double beta = (rho_new / rho_old) * (alpha / omega);
        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];
        rho_old = rho_new;
    }

    if (iterations_out) *iterations_out = it_count;
    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
    return x;
}

static double *solve_gmres(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int restart, int *iterations_out) {
    int n = A->n;
    double *x = xcalloc((size_t)n, sizeof(double));
    double *r = xmalloc((size_t)n * sizeof(double));
    double *w = xmalloc((size_t)n * sizeof(double));
    double *V = xmalloc((size_t)(restart + 1) * n * sizeof(double));
    double *Z = xmalloc((size_t)restart * n * sizeof(double));
    double *H = xmalloc((size_t)(restart + 1) * restart * sizeof(double));
    double *g = xmalloc((size_t)(restart + 1) * sizeof(double));
    double *cs = xmalloc((size_t)restart * sizeof(double));
    double *sn = xmalloc((size_t)restart * sizeof(double));
    double *y = xmalloc((size_t)restart * sizeof(double));
    double bnorm = vec_norm2(n, b);
    int it_count = 0;
    int converged = 0;

    for (int cycle = 0; it_count < max_it && !converged; cycle++) {
        spmv(A, x, r);
        for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
        double beta = vec_norm2(n, r);
        if (beta <= tol * bnorm) {
            converged = 1;
            break;
        }

        for (int i = 0; i <= restart; i++) g[i] = 0.0;
        g[0] = beta;
        double inv_beta = 1.0 / beta;
        for (int i = 0; i < n; i++) V[i] = r[i] * inv_beta;

        int steps = 0;
        for (int j = 0; j < restart && it_count < max_it; j++) {
            precond_apply(p, V + j * n, Z + j * n);
            spmv(A, Z + j * n, w);

            for (int i = 0; i <= j; i++) {
                double h = dot(n, w, V + i * n);
                H[i * restart + j] = h;
                for (int k = 0; k < n; k++) w[k] -= h * V[i * n + k];
            }
            double hnext = vec_norm2(n, w);
            H[(j + 1) * restart + j] = hnext;
            if (hnext > 0.0) {
                double inv_h = 1.0 / hnext;
                for (int k = 0; k < n; k++) V[(j + 1) * n + k] = w[k] * inv_h;
            } else {
                for (int k = 0; k < n; k++) V[(j + 1) * n + k] = 0.0;
            }

            for (int i = 0; i < j; i++) {
                double temp = cs[i] * H[i * restart + j] + sn[i] * H[(i + 1) * restart + j];
                H[(i + 1) * restart + j] = -sn[i] * H[i * restart + j] + cs[i] * H[(i + 1) * restart + j];
                H[i * restart + j] = temp;
            }

            double hjj = H[j * restart + j];
            double hj1j = H[(j + 1) * restart + j];
            double rot = sqrt(hjj * hjj + hj1j * hj1j);
            if (rot == 0.0) {
                cs[j] = 1.0;
                sn[j] = 0.0;
            } else {
[?2004hroot@n30009:/app# sed -n '1140,1520p' nlsolve.c
[?2004l            } else {
                cs[j] = hjj / rot;
                sn[j] = hj1j / rot;
            }
            H[j * restart + j] = rot;
            H[(j + 1) * restart + j] = 0.0;

            double gtemp = cs[j] * g[j] + sn[j] * g[j + 1];
            g[j + 1] = -sn[j] * g[j] + cs[j] * g[j + 1];
            g[j] = gtemp;

            it_count++;
            steps = j + 1;

            double res = 0.0;
            for (int k = j + 1; k <= restart; k++) res += g[k] * g[k];
            res = sqrt(res);
            if (history) {
                printf("iteration %d residual %.6e\n", it_count, res);
            }
            if (res <= tol * bnorm) {
                converged = 1;
                break;
            }
            if (hnext == 0.0) {
                break;
            }
        }

        if (steps > 0) {
            for (int i = steps - 1; i >= 0; i--) {
                double sum = g[i];
                for (int k = i + 1; k < steps; k++) {
                    sum -= H[i * restart + k] * y[k];
                }
                if (H[i * restart + i] == 0.0) {
                    free(r); free(w); free(V); free(Z); free(H); free(g); free(cs); free(sn); free(y);
                    die("GMRES numerical breakdown");
                }
                y[i] = sum / H[i * restart + i];
            }
            for (int i = 0; i < steps; i++) {
                double yi = y[i];
                for (int k = 0; k < n; k++) {
                    x[k] += Z[i * n + k] * yi;
                }
            }
        }
    }

    if (iterations_out) *iterations_out = it_count;
    free(r); free(w); free(V); free(Z); free(H); free(g); free(cs); free(sn); free(y);
    return x;
}

static void write_vector(const char *filename, int n, const double *x) {
    FILE *f = stdout;
    if (filename) {
        f = fopen(filename, "w");
        if (!f) die("cannot open output vector file");
    }

    if (fprintf(f, "%d\n", n) < 0) {
        if (filename) fclose(f);
        die("failed to write vector");
    }
    for (int i = 0; i < n; i++) {
        if (fprintf(f, "%.15g\n", x[i]) < 0) {
            if (filename) fclose(f);
            die("failed to write vector");
        }
    }

    if (filename) fclose(f);
}

static void write_zero_vector(const char *filename, int n) {
    FILE *f = stdout;
    if (filename) {
        f = fopen(filename, "w");
        if (!f) die("cannot open output vector file");
    }

    if (fprintf(f, "%d\n", n) < 0) {
        if (filename) fclose(f);
        die("failed to write vector");
    }
    for (int i = 0; i < n; i++) {
        if (fprintf(f, "0.000000e+00\n") < 0) {
            if (filename) fclose(f);
            die("failed to write vector");
        }
    }

    if (filename) fclose(f);
}

static int parse_int_arg(const char *s) {
    if (!s || !*s) die("missing argument");
    errno = 0;
    char *end;
    long val = strtol(s, &end, 10);
    if (errno != 0 || end == s || *end != '\0') die("invalid integer argument");
    if (val < INT_MIN || val > INT_MAX) die("integer argument out of range");
    return (int)val;
}

static double parse_double_arg(const char *s) {
    if (!s || !*s) die("missing argument");
    errno = 0;
    char *end;
    double val = strtod(s, &end);
    if (errno != 0 || end == s || *end != '\0') die("invalid numeric argument");
    return val;
}

static void die_unknown(const char *kind, const char *value) {
    char msg[256];
    snprintf(msg, sizeof(msg), "unknown %s: %s", kind, value);
    die(msg);
}

int main(int argc, char **argv) {
    const char *input = NULL;
    const char *rhs = NULL;
    const char *solver_name = NULL;
    const char *precond_name = NULL;
    const char *reorder_name = NULL;
    const char *output = NULL;
    const char *gen2d = NULL;
    const char *gen3d = NULL;
    const char *genrhs = NULL;
    int analyze = 0;
    int history = 0;
    int max_it = 1000;
    double tol = 1e-8;
    double omega = 1.0;
    int restart = 30;
    int restart_given = 0;

    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (strcmp(arg, "--input") == 0) {
            if (++i >= argc) die("missing argument for --input");
            input = argv[i];
        } else if (strcmp(arg, "--rhs") == 0) {
            if (++i >= argc) die("missing argument for --rhs");
            rhs = argv[i];
        } else if (strcmp(arg, "--solver") == 0) {
            if (++i >= argc) die("missing solver name");
            solver_name = argv[i];
        } else if (strcmp(arg, "--precond") == 0) {
            if (++i >= argc) die("missing preconditioner name");
            precond_name = argv[i];
        } else if (strcmp(arg, "--reorder") == 0) {
            if (++i >= argc) die("missing reordering name");
            reorder_name = argv[i];
        } else if (strcmp(arg, "--output") == 0) {
            if (++i >= argc) die("missing argument for --output");
            output = argv[i];
        } else if (strcmp(arg, "--analyze") == 0) {
            analyze = 1;
        } else if (strcmp(arg, "--history") == 0) {
            history = 1;
        } else if (strcmp(arg, "--generate-laplacian") == 0) {
            if (++i >= argc) die("missing argument for --generate-laplacian");
            gen2d = argv[i];
        } else if (strcmp(arg, "--generate-laplacian3d") == 0) {
            if (++i >= argc) die("missing argument for --generate-laplacian3d");
            gen3d = argv[i];
        } else if (strcmp(arg, "--generate-rhs") == 0) {
            if (++i >= argc) die("missing argument for --generate-rhs");
            genrhs = argv[i];
        } else if (strcmp(arg, "--max-it") == 0 || strcmp(arg, "--max-iter") == 0) {
            if (++i >= argc) die("missing argument for max iterations");
            max_it = parse_int_arg(argv[i]);
        } else if (strcmp(arg, "--tol") == 0) {
            if (++i >= argc) die("missing argument for tolerance");
            tol = parse_double_arg(argv[i]);
        } else if (strcmp(arg, "--omega") == 0) {
            if (++i >= argc) die("missing argument for omega");
            omega = parse_double_arg(argv[i]);
        } else if (strcmp(arg, "--restart") == 0) {
            if (++i >= argc) die("missing argument for --restart");
            restart = parse_int_arg(argv[i]);
            restart_given = 1;
        } else {
            char msg[256];
            snprintf(msg, sizeof(msg), "unknown option: %s", arg);
            die(msg);
        }
    }

    if (restart_given) {
        if (restart < 1) die("invalid restart value");
        if (!(solver_name && strcmp(solver_name, "gmres") == 0)) die("--restart requires --solver gmres");
    }

    int modes = 0;
    if (analyze) modes++;
    if (solver_name) modes++;
    if (gen2d) modes++;
    if (gen3d) modes++;
    if (genrhs) modes++;
    if (modes == 0) die("no operation specified");
    if (modes > 1) die("conflicting operation modes specified");

    if (gen2d || gen3d || genrhs) {
        if (input || rhs || solver_name || precond_name || reorder_name) {
            die("conflicting command-line arguments");
        }
        if (!output) die("missing output file for generator");

        if (gen2d) {
            int n = parse_int_arg(gen2d);
            if (n <= 0) die("invalid generator size");
            long N = (long)n * (long)n;
            if (N > INT_MAX / 3) die("generator size too large");
            generate_laplacian2d(n, output);
        } else if (gen3d) {
            int n = parse_int_arg(gen3d);
            if (n <= 0) die("invalid generator size");
            long N = (long)n * (long)n * (long)n;
            if (N > INT_MAX / 4) die("generator size too large");
            generate_laplacian3d(n, output);
        } else {
            int N = parse_int_arg(genrhs);
            if (N <= 0) die("invalid generator size");
            generate_rhs(N, output);
        }
        return 0;
    }

    if (analyze) {
        if (!input) die("missing input file for analyze");
        if (rhs || solver_name || precond_name || reorder_name || output) {
            die("conflicting command-line arguments");
        }
        CSRMatrix *m = read_matrix(input);
        analyze_matrix(m);
        free_csr(m);
        return 0;
    }

    if (!input) die("missing input file for solver");
    if (!rhs) die("missing rhs file for solver");
    if (!solver_name) die("missing solver name");

    int solver;
    if (strcmp(solver_name, "cg") == 0) solver = SOLVER_CG;
    else if (strcmp(solver_name, "bicgstab") == 0) solver = SOLVER_BICGSTAB;
    else if (strcmp(solver_name, "gmres") == 0) solver = SOLVER_GMRES;
    else die_unknown("solver", solver_name);

    int precond = PRECOND_NONE;
    if (precond_name) {
        if (strcmp(precond_name, "none") == 0) precond = PRECOND_NONE;
        else if (strcmp(precond_name, "jacobi") == 0) precond = PRECOND_JACOBI;
        else if (strcmp(precond_name, "ssor") == 0) precond = PRECOND_SSOR;
        else if (strcmp(precond_name, "ic0") == 0) precond = PRECOND_IC0;
        else die_unknown("preconditioner", precond_name);
    }

    int reorder = 0;
    if (reorder_name) {
        if (strcmp(reorder_name, "none") == 0) reorder = 0;
        else if (strcmp(reorder_name, "rcm") == 0) reorder = 1;
        else die_unknown("reordering", reorder_name);
    }

    if (max_it <= 0) die("invalid max iterations");
    if (tol < 0.0) die("invalid tolerance");

    CSRMatrix *m = read_matrix(input);
    int rhs_n;
    double *b = read_vector(rhs, &rhs_n);
    if (m->n != rhs_n) {
        free_csr(m);
        free(b);
        die("matrix and RHS dimensions do not match");
    }

    int n = m->n;

    if (vec_norm2(n, b) == 0.0) {
        write_zero_vector(output, n);
        printf("iterations: 0\n");
        printf("residual_norm: 0.000000e+00\n");
        printf("converged: yes\n");
        free_csr(m);
        free(b);
        return 0;
    }

    CSRMatrix *A = m;
    double *bwork = b;
    int *perm = NULL;

    if (reorder) {
        perm = xmalloc((size_t)n * sizeof(int));
        rcm_ordering(m, perm);
        A = permute_csr(m, perm);
        bwork = xmalloc((size_t)n * sizeof(double));
        for (int i = 0; i < n; i++) bwork[perm[i]] = b[i];
        free_csr(m);
        m = A;
    }

    Precond *p = precond_setup(A, precond, omega);
    int iterations = 0;
    double *x2;
    if (solver == SOLVER_CG) x2 = solve_cg(A, bwork, p, max_it, tol, history, &iterations);
    else if (solver == SOLVER_BICGSTAB) x2 = solve_bicgstab(A, bwork, p, max_it, tol, history, &iterations);
    else x2 = solve_gmres(A, bwork, p, max_it, tol, history, restart, &iterations);

    double true_res = compute_true_residual(A, bwork, x2);

    double *x;
    if (perm) {
        x = xmalloc((size_t)n * sizeof(double));
        for (int i = 0; i < n; i++) x[i] = x2[perm[i]];
        free(x2);
        free(bwork);
        free(perm);
    } else {
        x = x2;
    }

    write_vector(output, n, x);

    printf("iterations: %d\n", iterations);
    printf("residual_norm: %.6e\n", true_res);
    printf("converged: %s\n", (true_res <= tol) ? "yes" : "no");

    free(x);
    free_precond(p);
    free_csr(A);
    free(b);
    return 0;
}
