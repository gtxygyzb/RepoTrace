  1041	static double parse_double_arg(const char *s) {
  1042	    if (!s || !*s) die("missing argument");
  1043	    errno = 0;
  1044	    char *end;
  1045	    double val = strtod(s, &end);
  1046	    if (errno != 0 || end == s || *end != '\0') die("invalid numeric argument");
  1047	    return val;
  1048	}
