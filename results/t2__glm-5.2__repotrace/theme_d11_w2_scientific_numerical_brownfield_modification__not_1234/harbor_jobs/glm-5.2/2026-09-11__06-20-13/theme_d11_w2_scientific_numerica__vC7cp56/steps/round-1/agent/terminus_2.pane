   888	static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol) {
   889	    int n = A->n;
   890	    double *x = xcalloc((size_t)n, sizeof(double));
   891	    double *r = xmalloc((size_t)n * sizeof(double));
   892	    double *z = xmalloc((size_t)n * sizeof(double));
   893	    double *pvec = xmalloc((size_t)n * sizeof(double));
   894	    double *Ap = xmalloc((size_t)n * sizeof(double));
   895	
   896	    spmv(A, x, r);
   897	    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
   898	    double bnorm = vec_norm2(n, b);
   899	    if (bnorm == 0.0) {
   900	        free(r); free(z); free(pvec); free(Ap);
   901	        return x;
   902	    }
   903	
   904	    precond_apply(p, r, z);
   905	    dcopy(n, z, pvec);
   906	    double rz_old = dot(n, r, z);
   907	
   908	    for (int it = 0; it < max_it; it++) {
   909	        spmv(A, pvec, Ap);
   910	        double pAp = dot(n, pvec, Ap);
   911	        if (pAp <= 0.0) {
   912	            free(r); free(z); free(pvec); free(Ap);
   913	            die("matrix is not positive definite");
   914	        }
   915	        double alpha = rz_old / pAp;
   916	        for (int i = 0; i < n; i++) {
   917	            x[i] += alpha * pvec[i];
   918	            r[i] -= alpha * Ap[i];
   919	        }
   920	        if (vec_norm2(n, r) <= tol * bnorm) break;
   921	
   922	        precond_apply(p, r, z);
   923	        double rz_new = dot(n, r, z);
   924	        if (rz_old == 0.0) {
   925	            free(r); free(z); free(pvec); free(Ap);
   926	            die("CG numerical breakdown");
   927	        }
   928	        double beta = rz_new / rz_old;
   929	        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];
   930	        rz_old = rz_new;
   931	    }
   932	
   933	    free(r); free(z); free(pvec); free(Ap);
   934	    return x;
   935	}
