static int cmp_entry_rc(const void *a, const void *b) {
    const Entry *ea = (const Entry *)a;
    const Entry *eb = (const Entry *)b;
    if (ea->r != eb->r) return ea->r - eb->r;
    return ea->c - eb->c;
}

static void generate_laplacian2d(int n, const char *output) {
    int N = n * n;
    int cap = N * 3;
    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));
    int count = 0;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            int row = i * n + j;
            entries[count].r = row;
            entries[count].c = row;
            entries[count].v = 4.0;
            count++;
            if (j > 0) {
                int col = i * n + (j - 1);
                entries[count].r = row;
                entries[count].c = col;
                entries[count].v = -1.0;
                count++;
            }
            if (i > 0) {
                int col = (i - 1) * n + j;
                entries[count].r = row;
                entries[count].c = col;
                entries[count].v = -1.0;
                count++;
            }
        }
    }
    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);
    write_matrix_market(output, N, count, entries);
    free(entries);
}

static void generate_laplacian3d(int n, const char *output) {
    int N = n * n * n;
    int cap = N * 4;
    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));
    int count = 0;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            for (int k = 0; k < n; k++) {
                int row = (i * n + j) * n + k;
                entries[count].r = row;
                entries[count].c = row;
                entries[count].v = 6.0;
                count++;
                if (k > 0) {
                    int col = row - 1;
                    entries[count].r = row;
                    entries[count].c = col;
                    entries[count].v = -1.0;
                    count++;
                }
                if (j > 0) {
                    int col = row - n;
                    entries[count].r = row;
                    entries[count].c = col;
                    entries[count].v = -1.0;
                    count++;
                }
                if (i > 0) {
                    int col = row - n * n;
                    entries[count].r = row;
                    entries[count].c = col;
                    entries[count].v = -1.0;
                    count++;
                }
            }
        }
    }
    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);
    write_matrix_market(output, N, count, entries);
    free(entries);
}

static void generate_rhs(int N, const char *output) {
    FILE *f = fopen(output, "w");
    if (!f) die("cannot open output rhs file");
    fprintf(f, "%d\n", N);
    for (int i = 1; i <= N; i++) {
        fprintf(f, "%.15g\n", sin((double)i * M_PI / (double)(N + 1)));
    }
    fclose(f);
}

