   310	static void write_matrix_market(const char *filename, int n, int nnz, Entry *entries) {
   311	    FILE *f = fopen(filename, "w");
   312	    if (!f) die("cannot open output matrix file");
   313	    fprintf(f, "%%%%MatrixMarket matrix coordinate real symmetric\n");
   314	    fprintf(f, "%d %d %d\n", n, n, nnz);
   315	    for (int k = 0; k < nnz; k++) {
   316	        fprintf(f, "%d %d %.15g\n", entries[k].r + 1, entries[k].c + 1, entries[k].v);
   317	    }
   318	    fclose(f);
   319	}
