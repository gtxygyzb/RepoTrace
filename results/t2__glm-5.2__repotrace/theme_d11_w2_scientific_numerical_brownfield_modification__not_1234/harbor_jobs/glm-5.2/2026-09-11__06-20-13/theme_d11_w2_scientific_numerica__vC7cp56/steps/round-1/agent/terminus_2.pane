  1237	static int parse_int_arg(const char *s) {
  1238	    if (!s || !*s) die("missing argument");
  1239	    errno = 0;
  1240	    char *end;
  1241	    long val = strtol(s, &end, 10);
  1242	    if (errno != 0 || end == s || *end != '\0') die("invalid integer argument");
  1243	    if (val < INT_MIN || val > INT_MAX) die("integer argument out of range");
  1244	    return (int)val;
  1245	}
  1246	
  1247	static double parse_double_arg(const char *s) {
  1248	    if (!s || !*s) die("missing argument");
  1249	    errno = 0;
  1250	    char *end;
  1251	    double val = strtod(s, &end);
  1252	    if (errno != 0 || end == s || *end != '\0') die("invalid numeric argument");
  1253	    return val;
  1254	}
