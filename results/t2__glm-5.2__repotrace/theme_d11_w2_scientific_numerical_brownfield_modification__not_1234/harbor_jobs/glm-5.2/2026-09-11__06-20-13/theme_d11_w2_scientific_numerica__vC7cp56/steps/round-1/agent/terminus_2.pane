   403	static void generate_rhs(int N, const char *output) {
   404	    FILE *f = fopen(output, "w");
   405	    if (!f) die("cannot open output rhs file");
   406	    fprintf(f, "%d\n", N);
   407	    for (int i = 1; i <= N; i++) {
   408	        fprintf(f, "%.15g\n", sin((double)i * M_PI / (double)(N + 1)));
   409	    }
   410	    fclose(f);
   411	}
