   568	static void rcm_ordering(const CSRMatrix *m, int *perm) {
   569	    int n = m->n;
   570	    int *adj_ptr, *adj_count, *adj;
   571	    build_adjacency(m, &adj_ptr, &adj_count, &adj);
   572	
   573	    int *degree = xcalloc((size_t)n, sizeof(int));
   574	    for (int i = 0; i < n; i++) degree[i] = adj_ptr[i + 1] - adj_ptr[i];
   575	
   576	    int *visited = xcalloc((size_t)n, sizeof(int));
   577	    int *order = xmalloc((size_t)n * sizeof(int));
   578	    int order_count = 0;
   579	    int *queue = xmalloc((size_t)n * sizeof(int));
   580	    int qhead = 0, qtail = 0;
   581	
   582	    while (order_count < n) {
   583	        int start = -1;
   584	        for (int i = 0; i < n; i++) {
   585	            if (!visited[i]) {
   586	                if (start == -1 || degree[i] < degree[start] ||
   587	                    (degree[i] == degree[start] && i < start)) {
   588	                    start = i;
   589	                }
   590	            }
   591	        }
   592	        if (start == -1) break;
   593	        visited[start] = 1;
   594	        queue[qtail++] = start;
   595	        while (qhead < qtail) {
   596	            int v = queue[qhead++];
   597	            order[order_count++] = v;
   598	            int base = adj_ptr[v];
   599	            int deg = adj_ptr[v + 1] - base;
   600	            int *nbrs = xmalloc((size_t)(deg ? deg : 1) * sizeof(int));
   601	            int cnt = 0;
   602	            for (int idx = 0; idx < deg; idx++) {
   603	                int u = adj[base + idx];
   604	                if (!visited[u]) nbrs[cnt++] = u;
   605	            }
   606	            // deterministic sort by degree then original index
   607	            for (int a = 1; a < cnt; a++) {
   608	                int key = nbrs[a];
   609	                int b = a - 1;
   610	                while (b >= 0) {
   611	                    if (degree[nbrs[b]] < degree[key] ||
   612	                        (degree[nbrs[b]] == degree[key] && nbrs[b] < key)) break;
   613	                    nbrs[b + 1] = nbrs[b];
   614	                    b--;
   615	                }
   616	                nbrs[b + 1] = key;
   617	            }
   618	            for (int idx = 0; idx < cnt; idx++) {
   619	                int u = nbrs[idx];
   620	                if (!visited[u]) {
   621	                    visited[u] = 1;
   622	                    queue[qtail++] = u;
   623	                }
   624	            }
   625	            free(nbrs);
   626	        }
   627	    }
   628	
   629	    for (int i = 0; i < n; i++) perm[order[n - 1 - i]] = i;
   630	
   631	    free(adj_ptr);
   632	    free(adj_count);
   633	    free(adj);
   634	    free(degree);
   635	    free(visited);
   636	    free(order);
   637	    free(queue);
   638	}
