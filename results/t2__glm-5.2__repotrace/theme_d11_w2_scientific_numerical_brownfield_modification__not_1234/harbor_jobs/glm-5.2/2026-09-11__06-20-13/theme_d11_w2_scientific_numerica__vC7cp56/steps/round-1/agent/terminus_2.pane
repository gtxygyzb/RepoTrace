[?2004l[?2004h>             if (j < i) {
[?2004l[?2004h>                 if (!has_off || j < min_col) min_col = j;
[?2004l[?2004h>                 has_off = 1;
[?2004l[?2004h>                 off_sum += fabs(m->vals[idx]);
[?2004l[?2004h>             } else if (j > i) {
[?2004l[?2004h>                 has_off = 1;
