   458	static CSRMatrix *permute_csr(const CSRMatrix *m, const int *perm) {
   459	    int n = m->n;
   460	    int *inv = xmalloc((size_t)n * sizeof(int));
   461	    for (int i = 0; i < n; i++) inv[perm[i]] = i;
   462	
   463	    int *counts = xcalloc((size_t)n, sizeof(int));
   464	    for (int i = 0; i < n; i++) {
   465	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   466	            int ni = perm[i];
   467	            counts[ni]++;
   468	        }
   469	    }
   470	
   471	    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
   472	    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + counts[i];
   473	    free(counts);
   474	
   475	    int nnz = m->nnz;
   476	    int *col_idx = xmalloc((size_t)nnz * sizeof(int));
   477	    double *vals = xmalloc((size_t)nnz * sizeof(double));
   478	    int *next = xcalloc((size_t)n, sizeof(int));
   479	    for (int i = 0; i < n; i++) {
   480	        int ni = perm[i];
   481	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   482	            int nj = perm[m->col_idx[idx]];
   483	            int pos = row_ptr[ni] + next[ni]++;
   484	            col_idx[pos] = nj;
   485	            vals[pos] = m->vals[idx];
   486	        }
   487	    }
   488	    free(next);
   489	    free(inv);
   490	
   491	    CSRMatrix *p = xmalloc(sizeof(CSRMatrix));
   492	    p->n = n;
   493	    p->nnz = nnz;
   494	    p->row_ptr = row_ptr;
   495	    p->col_idx = col_idx;
   496	    p->vals = vals;
   497	    p->symmetric = m->symmetric;
   498	    return p;
   499	}
   500	
   501	static void build_adjacency(const CSRMatrix *m, int **adj_ptr, int **adj_count, int **adj_data) {
   502	    int n = m->n;
   503	    int *degree = xcalloc((size_t)n, sizeof(int));
   504	    for (int i = 0; i < n; i++) {
   505	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   506	            int j = m->col_idx[idx];
   507	            if (j != i) degree[i]++;
   508	        }
   509	    }
   510	    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
   511	    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + degree[i];
   512	    int *adj = xmalloc((size_t)row_ptr[n] * sizeof(int));
   513	    int *next = xcalloc((size_t)n, sizeof(int));
   514	    for (int i = 0; i < n; i++) {
   515	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   516	            int j = m->col_idx[idx];
   517	            if (j != i) adj[row_ptr[i] + next[i]++] = j;
   518	        }
   519	    }
   520	    free(next);
   521	    free(degree);
   522	    *adj_ptr = row_ptr;
   523	    *adj_count = xcalloc((size_t)n, sizeof(int));
   524	    *adj_data = adj;
   525	}
