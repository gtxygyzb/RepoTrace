    69	static void *xmalloc(size_t s) {
    70	    if (s == 0) s = 1;
    71	    void *p = malloc(s);
    72	    if (!p) die("out of memory");
    73	    return p;
    74	}
    75	
    76	static void *xcalloc(size_t n, size_t s) {
    77	    if (n == 0) n = 1;
    78	    void *p = calloc(n, s);
    79	    if (!p) die("out of memory");
    80	    return p;
    81	}
