   423	        double s = 0.0;
   424	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   425	            s += m->vals[idx] * x[m->col_idx[idx]];
   426	        }
   427	        y[i] = s;
   428	    }
   429	}
