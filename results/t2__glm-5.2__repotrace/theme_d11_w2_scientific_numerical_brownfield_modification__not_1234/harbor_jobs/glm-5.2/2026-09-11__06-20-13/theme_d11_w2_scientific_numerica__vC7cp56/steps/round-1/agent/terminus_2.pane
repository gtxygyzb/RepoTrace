   950	static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {
   951	    int n = A->n;
   952	    double *x = xcalloc((size_t)n, sizeof(double));
   953	    double *r = xmalloc((size_t)n * sizeof(double));
   954	    double *z = xmalloc((size_t)n * sizeof(double));
   955	    double *pvec = xmalloc((size_t)n * sizeof(double));
   956	    double *Ap = xmalloc((size_t)n * sizeof(double));
   957	
   958	    spmv(A, x, r);
   959	    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
   960	    double bnorm = vec_norm2(n, b);
   961	    int it_count = 0;
   962	
   963	    precond_apply(p, r, z);
   964	    dcopy(n, z, pvec);
   965	    double rz_old = dot(n, r, z);
   966	
   967	    for (int it = 0; it < max_it; it++) {
   968	        spmv(A, pvec, Ap);
   969	        double pAp = dot(n, pvec, Ap);
   970	        if (pAp <= 0.0) {
   971	            free(r); free(z); free(pvec); free(Ap);
   972	            die("matrix is not positive definite");
   973	        }
   974	        double alpha = rz_old / pAp;
   975	        for (int i = 0; i < n; i++) {
   976	            x[i] += alpha * pvec[i];
   977	            r[i] -= alpha * Ap[i];
   978	        }
   979	        it_count = it + 1;
   980	        if (history) {
   981	            printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, r));
   982	        }
   983	        if (vec_norm2(n, r) <= tol * bnorm) break;
   984	
   985	        precond_apply(p, r, z);
   986	        double rz_new = dot(n, r, z);
   987	        if (rz_old == 0.0) {
   988	            free(r); free(z); free(pvec); free(Ap);
   989	            die("CG numerical breakdown");
   990	        }
   991	        double beta = rz_new / rz_old;
   992	        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];
   993	        rz_old = rz_new;
   994	    }
   995	
   996	    if (iterations_out) *iterations_out = it_count;
   997	    free(r); free(z); free(pvec); free(Ap);
   998	    return x;
   999	}
