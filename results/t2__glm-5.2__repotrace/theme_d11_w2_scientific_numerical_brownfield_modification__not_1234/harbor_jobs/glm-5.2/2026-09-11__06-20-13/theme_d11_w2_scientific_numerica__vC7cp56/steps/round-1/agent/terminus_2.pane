   392	static void spmv(const CSRMatrix *m, const double *x, double *y) {
   393	    for (int i = 0; i < m->n; i++) {
   394	        double s = 0.0;
   395	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   396	            s += m->vals[idx] * x[m->col_idx[idx]];
   397	        }
   398	        y[i] = s;
   399	    }
   400	}
   401	
   402	static double vec_norm2(int n, const double *x) {
   403	    return sqrt(dot(n, x, x));
   404	}
