   867	static void precond_apply(Precond *p, const double *r, double *z) {
   868	    int n = p->A->n;
   869	
   870	    if (p->type == PRECOND_NONE) {
   871	        dcopy(n, r, z);
   872	        return;
   873	    }
   874	
   875	    if (p->type == PRECOND_JACOBI) {
   876	        for (int i = 0; i < n; i++) {
   877	            if (p->diag[i] == 0.0) die("zero diagonal in Jacobi preconditioner");
   878	            z[i] = r[i] / p->diag[i];
   879	        }
   880	        return;
   881	    }
   882	
   883	    if (p->type == PRECOND_SSOR) {
   884	        dcopy(n, r, z);
   885	        for (int i = 0; i < n; i++) {
   886	            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {
   887	                int j = p->lower->col_idx[idx];
   888	                if (j < i) z[i] -= p->lower->vals[idx] * z[j];
   889	            }
   890	            if (p->diag[i] == 0.0) {
   891	                z[i] = 0.0;
   892	                continue;
   893	            }
   894	            z[i] /= p->diag[i];
   895	        }
   896	        for (int i = n - 1; i >= 0; i--) {
   897	            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {
   898	                int j = p->upper->col_idx[idx];
   899	                if (j > i) z[i] -= p->upper->vals[idx] * z[j];
   900	            }
   901	            if (p->diag[i] == 0.0) {
   902	                z[i] = 0.0;
   903	                continue;
   904	            }
   905	            z[i] /= p->diag[i];
   906	        }
   907	        return;
   908	    }
   909	
   910	    if (p->type == PRECOND_IC0) {
   911	        ICFactor *ic = p->ic;
   912	        for (int i = 0; i < n; i++) {
   913	            double s = r[i];
   914	            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {
   915	                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];
   916	            }
   917	            if (ic->diag[i] == 0.0) die("zero or negative pivot in IC(0) factorization");
   918	            z[i] = s / ic->diag[i];
   919	        }
   920	        for (int i = n - 1; i >= 0; i--) {
   921	            z[i] /= ic->diag[i];
   922	            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {
   923	                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];
   924	            }
   925	        }
   926	        return;
   927	    }
   928	
   929	    die("unknown preconditioner");
   930	}
   931	
   932	static void free_precond(Precond *p) {
   933	    if (!p) return;
   934	    free(p->diag);
   935	    free_tri_matrix(p->lower);
   936	    free_tri_matrix(p->upper);
   937	    if (p->ic) {
   938	        free(p->ic->l_row_ptr);
   939	        free(p->ic->l_col_idx);
   940	        free(p->ic->l_vals);
   941	        free(p->ic->diag);
   942	        free(p->ic->u_row_ptr);
   943	        free(p->ic->u_col_idx);
   944	        free(p->ic->u_vals);
   945	        free(p->ic);
   946	    }
   947	    free(p);
   948	}
