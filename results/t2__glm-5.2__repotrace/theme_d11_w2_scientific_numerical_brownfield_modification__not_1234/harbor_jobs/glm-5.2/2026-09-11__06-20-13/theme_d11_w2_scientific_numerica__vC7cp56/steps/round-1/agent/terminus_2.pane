static CSRMatrix *permute_csr(const CSRMatrix *m, const int *perm) {
    int n = m->n;
    int *inv = xmalloc((size_t)n * sizeof(int));
    for (int i = 0; i < n; i++) inv[perm[i]] = i;

    int *counts = xcalloc((size_t)n, sizeof(int));
    for (int i = 0; i < n; i++) {
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            int ni = perm[i];
            counts[ni]++;
        }
    }

    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + counts[i];
    free(counts);

    int nnz = m->nnz;
    int *col_idx = xmalloc((size_t)nnz * sizeof(int));
    double *vals = xmalloc((size_t)nnz * sizeof(double));
    int *next = xcalloc((size_t)n, sizeof(int));
    for (int i = 0; i < n; i++) {
        int ni = perm[i];
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            int nj = perm[m->col_idx[idx]];
            int pos = row_ptr[ni] + next[ni]++;
            col_idx[pos] = nj;
            vals[pos] = m->vals[idx];
        }
    }
    free(next);
    free(inv);

    CSRMatrix *p = xmalloc(sizeof(CSRMatrix));
    p->n = n;
    p->nnz = nnz;
    p->row_ptr = row_ptr;
    p->col_idx = col_idx;
    p->vals = vals;
    p->symmetric = m->symmetric;
    return p;
}

static void build_adjacency(const CSRMatrix *m, int **adj_ptr, int **adj_count, int **adj_data) {
    int n = m->n;
    int *degree = xcalloc((size_t)n, sizeof(int));
    for (int i = 0; i < n; i++) {
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            int j = m->col_idx[idx];
            if (j != i) degree[i]++;
        }
    }
    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + degree[i];
    int *adj = xmalloc((size_t)row_ptr[n] * sizeof(int));
    int *next = xcalloc((size_t)n, sizeof(int));
    for (int i = 0; i < n; i++) {
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            int j = m->col_idx[idx];
            if (j != i) adj[row_ptr[i] + next[i]++] = j;
        }
    }
    free(next);
