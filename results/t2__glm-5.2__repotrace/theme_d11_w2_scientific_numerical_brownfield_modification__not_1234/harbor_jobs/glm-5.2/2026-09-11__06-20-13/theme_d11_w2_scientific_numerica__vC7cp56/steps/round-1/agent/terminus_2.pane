   969	    double bnorm = vec_norm2(n, b);
   970	    int it_count = 0;
   971	
   972	    precond_apply(p, r, z);
   973	    dcopy(n, z, pvec);
   974	    double rz_old = dot(n, r, z);
   975	
   976	    for (int it = 0; it < max_it; it++) {
   977	        spmv(A, pvec, Ap);
   978	        double pAp = dot(n, pvec, Ap);
   979	        if (pAp <= 0.0) {
   980	            break;
   981	        }
   982	        double alpha = rz_old / pAp;
   983	        for (int i = 0; i < n; i++) {
   984	            x[i] += alpha * pvec[i];
   985	            r[i] -= alpha * Ap[i];
   986	        }
   987	        it_count = it + 1;
