   241	        c--;
   242	        if (symmetric) {
   243	            if (r < c) {
   244	                int t = r; r = c; c = t;
   245	            }
   246	            add_entry(&entries, &count, &cap, r, c, v);
   247	            if (r != c) add_entry(&entries, &count, &cap, c, r, v);
   248	        } else {
   249	            add_entry(&entries, &count, &cap, r, c, v);
   250	        }
   251	    }
   252	    fclose(f);
   253	
   254	    CSRMatrix *m = build_csr(rows, entries, count, symmetric);
   255	    free(entries);
   256	    return m;
   257	}
   258	
   259	static double *read_vector(const char *filename, int *n_out) {
   260	    FILE *f = fopen(filename, "r");
   261	    if (!f) die("cannot open rhs file");
   262	    int n;
   263	    if (fscanf(f, "%d", &n) != 1) {
   264	        fclose(f);
   265	        die("failed to read vector dimension");
   266	    }
   267	    if (n <= 0) die("invalid vector dimension");
   268	    double *x = xmalloc((size_t)n * sizeof(double));
   269	    for (int i = 0; i < n; i++) {
   270	        if (fscanf(f, "%lf", &x[i]) != 1) {
   271	            fclose(f);
   272	            free(x);
   273	            die("failed to read vector entry");
   274	        }
   275	    }
   276	    fclose(f);
   277	    *n_out = n;
   278	    return x;
   279	}
   280	
   281	static void write_matrix_market(const char *filename, int n, int nnz, Entry *entries) {
   282	    FILE *f = fopen(filename, "w");
   283	    if (!f) die("cannot open output matrix file");
   284	    fprintf(f, "%%%%MatrixMarket matrix coordinate real symmetric\n");
   285	    fprintf(f, "%d %d %d\n", n, n, nnz);
   286	    for (int k = 0; k < nnz; k++) {
   287	        fprintf(f, "%d %d %.15g\n", entries[k].r + 1, entries[k].c + 1, entries[k].v);
   288	    }
   289	    fclose(f);
   290	}
   291	
   292	static int cmp_entry_rc(const void *a, const void *b) {
   293	    const Entry *ea = (const Entry *)a;
   294	    const Entry *eb = (const Entry *)b;
   295	    if (ea->r != eb->r) return ea->r - eb->r;
   296	    return ea->c - eb->c;
   297	}
   298	
   299	static void generate_laplacian2d(int n, const char *output) {
   300	    int N = n * n;
   301	    int cap = N * 3;
   302	    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));
   303	    int count = 0;
   304	    for (int i = 0; i < n; i++) {
   305	        for (int j = 0; j < n; j++) {
   306	            int row = i * n + j;
   307	            entries[count].r = row;
   308	            entries[count].c = row;
   309	            entries[count].v = 4.0;
   310	            count++;
   311	            if (j > 0) {
   312	                int col = i * n + (j - 1);
   313	                entries[count].r = row;
   314	                entries[count].c = col;
   315	                entries[count].v = -1.0;
   316	                count++;
   317	            }
   318	            if (i > 0) {
   319	                int col = (i - 1) * n + j;
   320	                entries[count].r = row;
   321	                entries[count].c = col;
   322	                entries[count].v = -1.0;
   323	                count++;
   324	            }
   325	        }
   326	    }
   327	    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);
   328	    write_matrix_market(output, N, count, entries);
   329	    free(entries);
   330	}
   331	
   332	static void generate_laplacian3d(int n, const char *output) {
   333	    int N = n * n * n;
   334	    int cap = N * 4;
   335	    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));
   336	    int count = 0;
   337	    for (int i = 0; i < n; i++) {
   338	        for (int j = 0; j < n; j++) {
   339	            for (int k = 0; k < n; k++) {
   340	                int row = (i * n + j) * n + k;
   341	                entries[count].r = row;
   342	                entries[count].c = row;
   343	                entries[count].v = 6.0;
   344	                count++;
   345	                if (k > 0) {
   346	                    int col = row - 1;
   347	                    entries[count].r = row;
   348	                    entries[count].c = col;
   349	                    entries[count].v = -1.0;
   350	                    count++;
   351	                }
   352	                if (j > 0) {
   353	                    int col = row - n;
   354	                    entries[count].r = row;
   355	                    entries[count].c = col;
   356	                    entries[count].v = -1.0;
   357	                    count++;
   358	                }
   359	                if (i > 0) {
   360	                    int col = row - n * n;
   361	                    entries[count].r = row;
   362	                    entries[count].c = col;
   363	                    entries[count].v = -1.0;
   364	                    count++;
   365	                }
   366	            }
   367	        }
   368	    }
   369	    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);
   370	    write_matrix_market(output, N, count, entries);
   371	    free(entries);
   372	}
