[?2004l   780	static Precond *precond_setup(CSRMatrix *m, int type, double omega) {
   781	    Precond *p = xmalloc(sizeof(Precond));
   782	    p->type = type;
   783	    p->A = m;
   784	    p->diag = NULL;
   785	    p->lower = NULL;
   786	    p->upper = NULL;
   787	    p->omega = omega;
   788	    p->ic = NULL;
   789	
   790	    if (type == PRECOND_JACOBI) {
   791	        p->diag = compute_diag(m);
   792	        for (int i = 0; i < m->n; i++) {
   793	            if (p->diag[i] == 0.0) die("zero diagonal in Jacobi preconditioner");
   794	        }
   795	    } else if (type == PRECOND_SSOR) {
   796	        if (omega <= 0.0 || omega >= 2.0) die("invalid SSOR parameter");
   797	        p->diag = compute_diag(m);
   798	        for (int i = 0; i < m->n; i++) {
   799	            if (p->diag[i] == 0.0) die("zero diagonal in SSOR preconditioner");
   800	        }
   801	        p->lower = build_lower_triangular(m);
   802	        p->upper = build_upper_triangular(m);
   803	    } else if (type == PRECOND_IC0) {
   804	        if (!m->symmetric) die("IC(0) requires symmetric matrix");
   805	        p->ic = ic0_factorize(m);
   806	    }
   807	
   808	    return p;
   809	}
   810	
   811	static void precond_apply(Precond *p, const double *r, double *z) {
   812	    int n = p->A->n;
   813	
   814	    if (p->type == PRECOND_NONE) {
   815	        dcopy(n, r, z);
   816	        return;
   817	    }
   818	
   819	    if (p->type == PRECOND_JACOBI) {
   820	        for (int i = 0; i < n; i++) {
   821	            if (p->diag[i] == 0.0) die("zero diagonal in Jacobi preconditioner");
   822	            z[i] = r[i] / p->diag[i];
   823	        }
   824	        return;
   825	    }
   826	
   827	    if (p->type == PRECOND_SSOR) {
   828	        dcopy(n, r, z);
   829	        for (int i = 0; i < n; i++) {
   830	            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {
   831	                int j = p->lower->col_idx[idx];
   832	                if (j < i) z[i] -= p->lower->vals[idx] * z[j];
   833	            }
   834	            if (p->diag[i] == 0.0) die("zero diagonal in SSOR preconditioner");
   835	            z[i] /= p->diag[i];
   836	        }
   837	        for (int i = n - 1; i >= 0; i--) {
   838	            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {
   839	                int j = p->upper->col_idx[idx];
   840	                if (j > i) z[i] -= p->upper->vals[idx] * z[j];
   841	            }
   842	            if (p->diag[i] == 0.0) die("zero diagonal in SSOR preconditioner");
   843	            z[i] /= p->diag[i];
   844	        }
   845	        return;
   846	    }
   847	
