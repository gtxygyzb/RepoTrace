  1004	            die("BiCGSTAB numerical breakdown");
  1005	        }
  1006	        double omega = ts / tt;
  1007	        for (int i = 0; i < n; i++) {
  1008	            x[i] += alpha * z[i] + omega * s[i];
  1009	            r[i] = s[i] - omega * t[i];
  1010	        }
  1011	        it_count = it + 1;
  1012	        if (history) {
  1013	            printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, r));
  1014	        }
  1015	        if (vec_norm2(n, r) <= tol * bnorm) break;
  1016	
  1017	        double rho_new = dot(n, r0, r);
