#define PRECOND_IC0 3

typedef struct {
    int n;
    int nnz;
    int *row_ptr;
    int *col_idx;
    double *vals;
    int symmetric;
} CSRMatrix;

typedef struct {
    int r;
    int c;
    double v;
} Entry;

typedef struct {
    int n;
    int *row_ptr;
    int *col_idx;
    double *vals;
} TriMatrix;

typedef struct {
    int n;
