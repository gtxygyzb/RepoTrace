   534	static void rcm_ordering(const CSRMatrix *m, int *perm) {
   535	    int n = m->n;
   536	    int *adj_ptr, *adj_count, *adj;
   537	    build_adjacency(m, &adj_ptr, &adj_count, &adj);
   538	
   539	    int *degree = xcalloc((size_t)n, sizeof(int));
   540	    for (int i = 0; i < n; i++) degree[i] = adj_ptr[i + 1] - adj_ptr[i];
   541	
   542	    int *visited = xcalloc((size_t)n, sizeof(int));
   543	    int *order = xmalloc((size_t)n * sizeof(int));
   544	    int order_count = 0;
   545	    int *queue = xmalloc((size_t)n * sizeof(int));
   546	    int qhead = 0, qtail = 0;
   547	
   548	    while (order_count < n) {
   549	        int start = -1;
   550	        for (int i = 0; i < n; i++) {
   551	            if (!visited[i]) {
   552	                if (start == -1 || degree[i] < degree[start] ||
   553	                    (degree[i] == degree[start] && i < start)) {
   554	                    start = i;
   555	                }
   556	            }
   557	        }
   558	        if (start == -1) break;
   559	        visited[start] = 1;
   560	        queue[qtail++] = start;
   561	        while (qhead < qtail) {
   562	            int v = queue[qhead++];
   563	            order[order_count++] = v;
   564	            int base = adj_ptr[v];
   565	            int deg = adj_ptr[v + 1] - base;
   566	            int *nbrs = xmalloc((size_t)(deg ? deg : 1) * sizeof(int));
   567	            int cnt = 0;
   568	            for (int idx = 0; idx < deg; idx++) {
   569	                int u = adj[base + idx];
   570	                if (!visited[u]) nbrs[cnt++] = u;
   571	            }
   572	            // deterministic sort by degree then original index
   573	            for (int a = 1; a < cnt; a++) {
   574	                int key = nbrs[a];
   575	                int b = a - 1;
   576	                while (b >= 0) {
   577	                    if (degree[nbrs[b]] < degree[key] ||
   578	                        (degree[nbrs[b]] == degree[key] && nbrs[b] < key)) break;
   579	                    nbrs[b + 1] = nbrs[b];
   580	                    b--;
   581	                }
   582	                nbrs[b + 1] = key;
   583	            }
   584	            for (int idx = 0; idx < cnt; idx++) {
   585	                int u = nbrs[idx];
   586	                if (!visited[u]) {
   587	                    visited[u] = 1;
   588	                    queue[qtail++] = u;
   589	                }
   590	            }
   591	            free(nbrs);
   592	        }
   593	    }
   594	
   595	    for (int i = 0; i < n; i++) perm[order[n - 1 - i]] = i;
   596	
   597	    free(adj_ptr);
   598	    free(adj_count);
   599	    free(adj);
   600	    free(degree);
   601	    free(visited);
   602	    free(order);
   603	    free(queue);
   604	}
