[?2004l    free(next);
    free(degree);
    *adj_ptr = row_ptr;
    *adj_count = xcalloc((size_t)n, sizeof(int));
    *adj_data = adj;
}

static int cmp_int_desc_degree(const void *a, const void *b, void *ctx) {
    (void)ctx;
    int ia = *(const int *)a;
    int ib = *(const int *)b;
    return ia - ib;
}

static void rcm_ordering(const CSRMatrix *m, int *perm) {
    int n = m->n;
    int *adj_ptr, *adj_count, *adj;
    build_adjacency(m, &adj_ptr, &adj_count, &adj);

    int *degree = xcalloc((size_t)n, sizeof(int));
    for (int i = 0; i < n; i++) degree[i] = adj_ptr[i + 1] - adj_ptr[i];

    int *visited = xcalloc((size_t)n, sizeof(int));
    int *order = xmalloc((size_t)n * sizeof(int));
    int order_count = 0;
    int *queue = xmalloc((size_t)n * sizeof(int));
    int qhead = 0, qtail = 0;

    while (order_count < n) {
        int start = -1;
        for (int i = 0; i < n; i++) {
            if (!visited[i]) {
                if (start == -1 || degree[i] < degree[start] ||
                    (degree[i] == degree[start] && i < start)) {
                    start = i;
                }
            }
        }
        if (start == -1) break;
        visited[start] = 1;
        queue[qtail++] = start;
        while (qhead < qtail) {
            int v = queue[qhead++];
            order[order_count++] = v;
            int base = adj_ptr[v];
            int deg = adj_ptr[v + 1] - base;
            int *nbrs = xmalloc((size_t)(deg ? deg : 1) * sizeof(int));
            int cnt = 0;
            for (int idx = 0; idx < deg; idx++) {
                int u = adj[base + idx];
                if (!visited[u]) nbrs[cnt++] = u;
            }
            // deterministic sort by degree then original index
            for (int a = 1; a < cnt; a++) {
                int key = nbrs[a];
                int b = a - 1;
                while (b >= 0) {
                    if (degree[nbrs[b]] < degree[key] ||
                        (degree[nbrs[b]] == degree[key] && nbrs[b] < key)) break;
                    nbrs[b + 1] = nbrs[b];
                    b--;
                }
                nbrs[b + 1] = key;
            }
            for (int idx = 0; idx < cnt; idx++) {
                int u = nbrs[idx];
                if (!visited[u]) {
                    visited[u] = 1;
                    queue[qtail++] = u;
                }
            }
            free(nbrs);
        }
    }

    for (int i = 0; i < n; i++) perm[order[n - 1 - i]] = i;

    free(adj_ptr);
    free(adj_count);
    free(adj);
    free(degree);
    free(visited);
    free(order);
    free(queue);
}
