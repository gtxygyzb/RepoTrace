   321	static int cmp_entry_rc(const void *a, const void *b) {
   322	    const Entry *ea = (const Entry *)a;
   323	    const Entry *eb = (const Entry *)b;
   324	    if (ea->r != eb->r) return ea->r - eb->r;
   325	    return ea->c - eb->c;
   326	}
   327	
   328	static void generate_laplacian2d(int n, const char *output) {
   329	    int N = n * n;
   330	    int cap = N * 3;
   331	    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));
   332	    int count = 0;
   333	    for (int i = 0; i < n; i++) {
   334	        for (int j = 0; j < n; j++) {
   335	            int row = i * n + j;
   336	            entries[count].r = row;
   337	            entries[count].c = row;
   338	            entries[count].v = 4.0;
   339	            count++;
   340	            if (j > 0) {
   341	                int col = i * n + (j - 1);
   342	                entries[count].r = row;
   343	                entries[count].c = col;
   344	                entries[count].v = -1.0;
   345	                count++;
   346	            }
   347	            if (i > 0) {
   348	                int col = (i - 1) * n + j;
   349	                entries[count].r = row;
   350	                entries[count].c = col;
   351	                entries[count].v = -1.0;
   352	                count++;
   353	            }
   354	        }
   355	    }
   356	    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);
   357	    write_matrix_market(output, N, count, entries);
   358	    free(entries);
   359	}
   360	
   361	static void generate_laplacian3d(int n, const char *output) {
   362	    int N = n * n * n;
   363	    int cap = N * 4;
   364	    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));
   365	    int count = 0;
   366	    for (int i = 0; i < n; i++) {
   367	        for (int j = 0; j < n; j++) {
   368	            for (int k = 0; k < n; k++) {
   369	                int row = (i * n + j) * n + k;
   370	                entries[count].r = row;
   371	                entries[count].c = row;
   372	                entries[count].v = 6.0;
   373	                count++;
   374	                if (k > 0) {
   375	                    int col = row - 1;
   376	                    entries[count].r = row;
   377	                    entries[count].c = col;
   378	                    entries[count].v = -1.0;
   379	                    count++;
   380	                }
   381	                if (j > 0) {
   382	                    int col = row - n;
   383	                    entries[count].r = row;
   384	                    entries[count].c = col;
   385	                    entries[count].v = -1.0;
   386	                    count++;
   387	                }
   388	                if (i > 0) {
   389	                    int col = row - n * n;
   390	                    entries[count].r = row;
   391	                    entries[count].c = col;
   392	                    entries[count].v = -1.0;
   393	                    count++;
   394	                }
   395	            }
   396	        }
   397	    }
   398	    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);
   399	    write_matrix_market(output, N, count, entries);
   400	    free(entries);
   401	}
