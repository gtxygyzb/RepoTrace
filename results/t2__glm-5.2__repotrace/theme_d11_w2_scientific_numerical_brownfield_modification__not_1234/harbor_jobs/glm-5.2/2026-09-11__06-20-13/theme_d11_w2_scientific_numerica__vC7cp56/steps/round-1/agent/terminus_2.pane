   958	
   959	static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {
   960	    int n = A->n;
   961	    double *x = xcalloc((size_t)n, sizeof(double));
   962	    double *r = xmalloc((size_t)n * sizeof(double));
   963	    double *z = xmalloc((size_t)n * sizeof(double));
   964	    double *pvec = xmalloc((size_t)n * sizeof(double));
   965	    double *Ap = xmalloc((size_t)n * sizeof(double));
   966	
   967	    spmv(A, x, r);
   968	    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
   969	    double bnorm = vec_norm2(n, b);
   970	    int it_count = 0;
   971	
   972	    precond_apply(p, r, z);
   973	    dcopy(n, z, pvec);
   974	    double rz_old = dot(n, r, z);
   975	
   976	    for (int it = 0; it < max_it; it++) {
   977	        spmv(A, pvec, Ap);
   978	        double pAp = dot(n, pvec, Ap);
   979	        if (pAp <= 0.0) {
   980	            break;
   981	        }
   982	        double alpha = rz_old / pAp;
   983	        for (int i = 0; i < n; i++) {
   984	            x[i] += alpha * pvec[i];
   985	            r[i] -= alpha * Ap[i];
   986	        }
   987	        it_count = it + 1;
   988	        if (history) {
   989	            printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, r));
   990	        }
   991	        if (vec_norm2(n, r) <= tol * bnorm) break;
   992	
   993	        precond_apply(p, r, z);
   994	        double rz_new = dot(n, r, z);
   995	        if (rz_old == 0.0) {
   996	            break;
   997	        }
   998	        double beta = rz_new / rz_old;
   999	        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];
  1000	        rz_old = rz_new;
  1001	    }
  1002	
  1003	    if (iterations_out) *iterations_out = it_count;
  1004	    free(r); free(z); free(pvec); free(Ap);
  1005	    return x;
  1006	}
  1007	
  1008	static double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {
  1009	    int n = A->n;
  1010	    double *x = xcalloc((size_t)n, sizeof(double));
  1011	    double *r = xmalloc((size_t)n * sizeof(double));
  1012	    double *r0 = xmalloc((size_t)n * sizeof(double));
  1013	    double *pvec = xmalloc((size_t)n * sizeof(double));
  1014	    double *v = xmalloc((size_t)n * sizeof(double));
  1015	    double *s = xmalloc((size_t)n * sizeof(double));
  1016	    double *t = xmalloc((size_t)n * sizeof(double));
  1017	    double *z = xmalloc((size_t)n * sizeof(double));
  1018	
  1019	    spmv(A, x, r);
  1020	    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
  1021	    double bnorm = vec_norm2(n, b);
  1022	    int it_count = 0;
  1023	
  1024	    dcopy(n, r, r0);
  1025	    double rho_old = dot(n, r0, r);
  1026	    if (fabs(rho_old) <= 1e-300) {
  1027	        goto bicgstab_cleanup;
  1028	    }
  1029	    dcopy(n, r, pvec);
  1030	
  1031	    for (int it = 0; it < max_it; it++) {
  1032	        precond_apply(p, pvec, z);
  1033	        spmv(A, z, v);
  1034	        double r0v = dot(n, r0, v);
  1035	        if (fabs(r0v) <= 1e-300) {
  1036	            break;
  1037	        }
  1038	        double alpha = rho_old / r0v;
  1039	        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];
  1040	
  1041	        if (vec_norm2(n, s) <= tol * bnorm) {
  1042	            for (int i = 0; i < n; i++) x[i] += alpha * z[i];
  1043	            it_count = it + 1;
  1044	            if (history) {
  1045	                printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, s));
  1046	            }
  1047	            break;
  1048	        }
  1049	
  1050	        precond_apply(p, s, z);
  1051	        spmv(A, z, t);
  1052	        double ts = dot(n, t, s);
  1053	        double tt = dot(n, t, t);
  1054	        if (fabs(tt) <= 1e-300) {
  1055	            break;
  1056	        }
  1057	        double omega = ts / tt;
  1058	        for (int i = 0; i < n; i++) {
  1059	            x[i] += alpha * z[i] + omega * s[i];
  1060	            r[i] = s[i] - omega * t[i];
  1061	        }
  1062	        it_count = it + 1;
  1063	        if (history) {
  1064	            printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, r));
  1065	        }
  1066	        if (vec_norm2(n, r) <= tol * bnorm) break;
  1067	
  1068	        double rho_new = dot(n, r0, r);
  1069	        if (fabs(rho_new) <= 1e-300) {
  1070	            break;
  1071	        }
  1072	        double beta = (rho_new / rho_old) * (alpha / omega);
  1073	        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];
  1074	        rho_old = rho_new;
  1075	    }
  1076	
