[?2004l[?2004h> static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol) {
[?2004l[?2004h>     int n = A->n;
[?2004l[?2004h>     double *x = xcalloc((size_t)n, sizeof(double));
[?2004l[?2004h>     double *r = xmalloc((size_t)n * sizeof(double));
[?2004l[?2004h>     double *z = xmalloc((size_t)n * sizeof(double));
[?2004l[?2004h>     double *pvec = xmalloc((size_t)n * sizeof(double));
[?2004l[?2004h>     double *Ap = xmalloc((size_t)n * sizeof(double));
[?2004l[?2004h> 
[?2004la[?2004h>     spmv(A, x, r);
[?2004l[?2004h>     for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
[?2004l[?2004h>     double bnorm = vec_norm2(n, b);
[?2004l[?2004h>     if (bnorm == 0.0) {
[?2004l[?2004h>         free(r); free(z); free(pvec); free(Ap);
[?2004l[?2004h>         return x;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     precond_apply(p, r, z);
[?2004l[?2004h>     dcopy(n, z, pvec);
[?2004l[?2004h>     double rz_old = dot(n, r, z);
[?2004l[?2004h> 
[?2004l [?2004h>     for (int it = 0; it < max_it; it++) {
[?2004l[?2004h>         spmv(A, pvec, Ap);
[?2004l[?2004h>         double pAp = dot(n, pvec, Ap);
[?2004l[?2004h>         if (pAp <= 0.0) {
[?2004l[?2004h>             free(r); free(z); free(pvec); free(Ap);
[?2004l[?2004h>             die("matrix is not positive definite");
[?2004l[?2004h>         }
[?2004l[?2004h>         double alpha = rz_old / pAp;
[?2004l[?2004h>         for (int i = 0; i < n; i++) {
[?2004l[?2004h>             x[i] += alpha * pvec[i];
[?2004l[?2004h>             r[i] -= alpha * Ap[i];
[?2004l[?2004h>         }
[?2004l[?2004h>         if (vec_norm2(n, r) <= tol * bnorm) break;
[?2004l[?2004h> 
[?2004lt[?2004h>         precond_apply(p, r, z);
[?2004l[?2004h>         double rz_new = dot(n, r, z);
[?2004l[?2004h>         if (rz_old == 0.0) {
[?2004l[?2004h>             free(r); free(z); free(pvec); free(Ap);
[?2004l[?2004h>             die("CG numerical breakdown");
[?2004l[?2004h>         }
[?2004l[?2004h>         double beta = rz_new / rz_old;
[?2004l[?2004h>         for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];
[?2004l[?2004h>         rz_old = rz_new;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     free(r); free(z); free(pvec); free(Ap);
[?2004l[?2004h>     return x;
[?2004l[?2004h> }
