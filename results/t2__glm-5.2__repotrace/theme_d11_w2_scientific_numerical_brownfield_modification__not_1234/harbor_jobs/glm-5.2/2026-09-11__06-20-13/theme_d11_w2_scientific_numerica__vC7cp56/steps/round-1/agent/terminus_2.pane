   836	    return ic;
   837	}
   838	
   839	static Precond *precond_setup(CSRMatrix *m, int type, double omega) {
   840	    Precond *p = xmalloc(sizeof(Precond));
   841	    p->type = type;
   842	    p->A = m;
   843	    p->diag = NULL;
   844	    p->lower = NULL;
   845	    p->upper = NULL;
   846	    p->omega = omega;
   847	    p->ic = NULL;
   848	
   849	    if (type == PRECOND_JACOBI) {
   850	        p->diag = compute_diag(m);
   851	        for (int i = 0; i < m->n; i++) {
   852	            if (p->diag[i] == 0.0) die("zero diagonal in Jacobi preconditioner");
   853	        }
   854	    } else if (type == PRECOND_SSOR) {
   855	        if (omega <= 0.0 || omega >= 2.0) die("invalid SSOR parameter");
   856	        p->diag = compute_diag(m);
   857	        p->lower = build_lower_triangular(m);
   858	        p->upper = build_upper_triangular(m);
   859	    } else if (type == PRECOND_IC0) {
   860	        if (!m->symmetric) die("IC(0) requires symmetric matrix");
   861	        p->ic = ic0_factorize(m);
   862	    }
   863	
   864	    return p;
   865	}
   866	
   867	static void precond_apply(Precond *p, const double *r, double *z) {
   868	    int n = p->A->n;
   869	
   870	    if (p->type == PRECOND_NONE) {
   871	        dcopy(n, r, z);
   872	        return;
   873	    }
   874	
   875	    if (p->type == PRECOND_JACOBI) {
   876	        for (int i = 0; i < n; i++) {
   877	            if (p->diag[i] == 0.0) die("zero diagonal in Jacobi preconditioner");
   878	            z[i] = r[i] / p->diag[i];
   879	        }
   880	        return;
   881	    }
   882	
   883	    if (p->type == PRECOND_SSOR) {
   884	        dcopy(n, r, z);
   885	        for (int i = 0; i < n; i++) {
   886	            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {
   887	                int j = p->lower->col_idx[idx];
   888	                if (j < i) z[i] -= p->lower->vals[idx] * z[j];
   889	            }
   890	            if (p->diag[i] == 0.0) {
   891	                z[i] = 0.0;
   892	                continue;
   893	            }
   894	            z[i] /= p->diag[i];
   895	        }
   896	        for (int i = n - 1; i >= 0; i--) {
   897	            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {
   898	                int j = p->upper->col_idx[idx];
   899	                if (j > i) z[i] -= p->upper->vals[idx] * z[j];
   900	            }
   901	            if (p->diag[i] == 0.0) {
   902	                z[i] = 0.0;
   903	                continue;
   904	            }
   905	            z[i] /= p->diag[i];
   906	        }
   907	        return;
   908	    }
   909	
   910	    if (p->type == PRECOND_IC0) {
   911	        ICFactor *ic = p->ic;
   912	        for (int i = 0; i < n; i++) {
   913	            double s = r[i];
   914	            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {
   915	                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];
   916	            }
   917	            if (ic->diag[i] == 0.0) die("zero or negative pivot in IC(0) factorization");
   918	            z[i] = s / ic->diag[i];
   919	        }
   920	        for (int i = n - 1; i >= 0; i--) {
   921	            z[i] /= ic->diag[i];
   922	            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {
   923	                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];
   924	            }
   925	        }
   926	        return;
   927	    }
   928	
   929	    die("unknown preconditioner");
   930	}
[?2004hroot@n30009:/app# nl -ba nlsolve.c | sed -n '930,1120p'
[?2004l   930	}
   931	
   932	static void free_precond(Precond *p) {
   933	    if (!p) return;
   934	    free(p->diag);
   935	    free_tri_matrix(p->lower);
   936	    free_tri_matrix(p->upper);
   937	    if (p->ic) {
   938	        free(p->ic->l_row_ptr);
   939	        free(p->ic->l_col_idx);
   940	        free(p->ic->l_vals);
   941	        free(p->ic->diag);
   942	        free(p->ic->u_row_ptr);
   943	        free(p->ic->u_col_idx);
   944	        free(p->ic->u_vals);
   945	        free(p->ic);
   946	    }
   947	    free(p);
   948	}
   949	
   950	static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {
   951	    int n = A->n;
   952	    double *x = xcalloc((size_t)n, sizeof(double));
   953	    double *r = xmalloc((size_t)n * sizeof(double));
   954	    double *z = xmalloc((size_t)n * sizeof(double));
   955	    double *pvec = xmalloc((size_t)n * sizeof(double));
   956	    double *Ap = xmalloc((size_t)n * sizeof(double));
   957	
   958	    spmv(A, x, r);
   959	    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
   960	    double bnorm = vec_norm2(n, b);
   961	    int it_count = 0;
   962	
   963	    precond_apply(p, r, z);
   964	    dcopy(n, z, pvec);
   965	    double rz_old = dot(n, r, z);
   966	
   967	    for (int it = 0; it < max_it; it++) {
   968	        spmv(A, pvec, Ap);
   969	        double pAp = dot(n, pvec, Ap);
   970	        if (pAp <= 0.0) {
   971	            free(r); free(z); free(pvec); free(Ap);
   972	            die("matrix is not positive definite");
   973	        }
   974	        double alpha = rz_old / pAp;
   975	        for (int i = 0; i < n; i++) {
   976	            x[i] += alpha * pvec[i];
   977	            r[i] -= alpha * Ap[i];
   978	        }
   979	        it_count = it + 1;
   980	        if (history) {
   981	            printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, r));
   982	        }
   983	        if (vec_norm2(n, r) <= tol * bnorm) break;
   984	
   985	        precond_apply(p, r, z);
   986	        double rz_new = dot(n, r, z);
   987	        if (rz_old == 0.0) {
   988	            free(r); free(z); free(pvec); free(Ap);
   989	            die("CG numerical breakdown");
   990	        }
   991	        double beta = rz_new / rz_old;
   992	        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];
   993	        rz_old = rz_new;
   994	    }
   995	
   996	    if (iterations_out) *iterations_out = it_count;
   997	    free(r); free(z); free(pvec); free(Ap);
   998	    return x;
   999	}
  1000	
  1001	static double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {
  1002	    int n = A->n;
  1003	    double *x = xcalloc((size_t)n, sizeof(double));
  1004	    double *r = xmalloc((size_t)n * sizeof(double));
  1005	    double *r0 = xmalloc((size_t)n * sizeof(double));
  1006	    double *pvec = xmalloc((size_t)n * sizeof(double));
  1007	    double *v = xmalloc((size_t)n * sizeof(double));
  1008	    double *s = xmalloc((size_t)n * sizeof(double));
  1009	    double *t = xmalloc((size_t)n * sizeof(double));
  1010	    double *z = xmalloc((size_t)n * sizeof(double));
  1011	
  1012	    spmv(A, x, r);
  1013	    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
  1014	    double bnorm = vec_norm2(n, b);
  1015	    int it_count = 0;
  1016	
  1017	    dcopy(n, r, r0);
  1018	    double rho_old = dot(n, r0, r);
  1019	    if (rho_old == 0.0) {
  1020	        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1021	        die("BiCGSTAB numerical breakdown");
  1022	    }
  1023	    dcopy(n, r, pvec);
  1024	
  1025	    for (int it = 0; it < max_it; it++) {
  1026	        precond_apply(p, pvec, z);
  1027	        spmv(A, z, v);
  1028	        double r0v = dot(n, r0, v);
  1029	        if (r0v == 0.0) {
  1030	            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1031	            die("BiCGSTAB numerical breakdown");
  1032	        }
  1033	        double alpha = rho_old / r0v;
  1034	        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];
  1035	
  1036	        if (vec_norm2(n, s) <= tol * bnorm) {
  1037	            for (int i = 0; i < n; i++) x[i] += alpha * z[i];
  1038	            it_count = it + 1;
  1039	            if (history) {
  1040	                printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, s));
  1041	            }
  1042	            break;
  1043	        }
  1044	
  1045	        precond_apply(p, s, z);
  1046	        spmv(A, z, t);
  1047	        double ts = dot(n, t, s);
  1048	        double tt = dot(n, t, t);
  1049	        if (tt == 0.0) {
  1050	            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1051	            die("BiCGSTAB numerical breakdown");
  1052	        }
  1053	        double omega = ts / tt;
  1054	        for (int i = 0; i < n; i++) {
  1055	            x[i] += alpha * z[i] + omega * s[i];
  1056	            r[i] = s[i] - omega * t[i];
  1057	        }
  1058	        it_count = it + 1;
  1059	        if (history) {
  1060	            printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, r));
  1061	        }
  1062	        if (vec_norm2(n, r) <= tol * bnorm) break;
  1063	
  1064	        double rho_new = dot(n, r0, r);
  1065	        if (rho_new == 0.0) {
  1066	            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1067	            die("BiCGSTAB numerical breakdown");
  1068	        }
  1069	        double beta = (rho_new / rho_old) * (alpha / omega);
  1070	        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];
  1071	        rho_old = rho_new;
  1072	    }
  1073	
  1074	    if (iterations_out) *iterations_out = it_count;
  1075	    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);
  1076	    return x;
  1077	}
