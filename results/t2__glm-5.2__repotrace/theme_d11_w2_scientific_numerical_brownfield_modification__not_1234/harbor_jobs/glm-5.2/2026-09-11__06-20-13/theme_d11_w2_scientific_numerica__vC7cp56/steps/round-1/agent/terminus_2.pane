  1290	            solver_name = argv[i];
  1291	        } else if (strcmp(arg, "--precond") == 0) {
  1292	            if (++i >= argc) die("missing preconditioner name");
  1293	            precond_name = argv[i];
  1294	        } else if (strcmp(arg, "--reorder") == 0) {
  1295	            if (++i >= argc) die("missing reordering name");
  1296	            reorder_name = argv[i];
  1297	        } else if (strcmp(arg, "--output") == 0) {
  1298	            if (++i >= argc) die("missing argument for --output");
  1299	            output = argv[i];
  1300	        } else if (strcmp(arg, "--analyze") == 0) {
  1301	            analyze = 1;
  1302	        } else if (strcmp(arg, "--history") == 0) {
  1303	            history = 1;
  1304	        } else if (strcmp(arg, "--generate-laplacian") == 0) {
  1305	            if (++i >= argc) die("missing argument for --generate-laplacian");
