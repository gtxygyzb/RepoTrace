   281	static double *read_vector(const char *filename, int *n_out) {
   282	    FILE *f = fopen(filename, "r");
   283	    if (!f) die("cannot open rhs file");
   284	    int n;
   285	    if (fscanf(f, "%d", &n) != 1) {
   286	        fclose(f);
