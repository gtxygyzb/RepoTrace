   644	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   645	            if (m->col_idx[idx] <= i) row_ptr[i + 1]++;
   646	        }
   647	    }
   648	    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];
