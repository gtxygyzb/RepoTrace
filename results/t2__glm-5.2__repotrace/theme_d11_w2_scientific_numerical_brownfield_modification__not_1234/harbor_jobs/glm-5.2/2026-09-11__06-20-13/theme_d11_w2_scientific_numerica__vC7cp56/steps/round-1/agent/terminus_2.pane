[?2004l#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <ctype.h>
#include <errno.h>
#include <limits.h>

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

#define SOLVER_CG 0
#define SOLVER_BICGSTAB 1

#define PRECOND_NONE 0
#define PRECOND_JACOBI 1
#define PRECOND_SSOR 2
#define PRECOND_IC0 3

typedef struct {
    int n;
    int nnz;
    int *row_ptr;
    int *col_idx;
    double *vals;
    int symmetric;
} CSRMatrix;

typedef struct {
    int r;
    int c;
    double v;
} Entry;

typedef struct {
    int n;
    int *row_ptr;
    int *col_idx;
    double *vals;
} TriMatrix;

typedef struct {
    int n;
    int *l_row_ptr;
    int *l_col_idx;
    double *l_vals;
    double *diag;
    int *u_row_ptr;
    int *u_col_idx;
    double *u_vals;
} ICFactor;

typedef struct {
    int type;
    CSRMatrix *A;
    double *diag;
    TriMatrix *lower;
    TriMatrix *upper;
    double omega;
    ICFactor *ic;
} Precond;

static void die(const char *msg) {
    fprintf(stderr, "error: %s\n", msg);
    exit(1);
}

static void *xmalloc(size_t s) {
    if (s == 0) s = 1;
    void *p = malloc(s);
    if (!p) die("out of memory");
    return p;
}

static void *xcalloc(size_t n, size_t s) {
    if (n == 0) n = 1;
    void *p = calloc(n, s);
    if (!p) die("out of memory");
    return p;
}

static double dot(int n, const double *a, const double *b) {
    double s = 0.0;
    for (int i = 0; i < n; i++) s += a[i] * b[i];
    return s;
}

static void dcopy(int n, const double *src, double *dst) {
    for (int i = 0; i < n; i++) dst[i] = src[i];
}

static int cmp_entry(const void *a, const void *b) {
    const Entry *ea = (const Entry *)a;
    const Entry *eb = (const Entry *)b;
    if (ea->r != eb->r) return ea->r - eb->r;
    return ea->c - eb->c;
}

static void add_entry(Entry **arr, int *count, int *cap, int r, int c, double v) {
    if (*count == *cap) {
        *cap = (*cap ? *cap * 2 : 16);
        *arr = realloc(*arr, (size_t)*cap * sizeof(Entry));
        if (!*arr) die("out of memory");
    }
    (*arr)[*count].r = r;
    (*arr)[*count].c = c;
    (*arr)[*count].v = v;
    (*count)++;
}

static CSRMatrix *build_csr(int n, Entry *entries, int count, int symmetric) {
    if (count > 0) qsort(entries, (size_t)count, sizeof(Entry), cmp_entry);

    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
    int *tmp_count = xcalloc((size_t)n, sizeof(int));

    int unique = 0;
    for (int i = 0; i < count; ) {
        int r = entries[i].r;
        int c = entries[i].c;
        double sum = 0.0;
        while (i < count && entries[i].r == r && entries[i].c == c) {
            sum += entries[i].v;
            i++;
        }
        entries[unique].r = r;
        entries[unique].c = c;
        entries[unique].v = sum;
        unique++;
        tmp_count[r]++;
    }

    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + tmp_count[i];
    free(tmp_count);

    int *col_idx = xmalloc((size_t)unique * sizeof(int));
    double *vals = xmalloc((size_t)unique * sizeof(double));
    int *next = xcalloc((size_t)n, sizeof(int));

    for (int i = 0; i < unique; i++) {
        int r = entries[i].r;
        int pos = row_ptr[r] + next[r]++;
        col_idx[pos] = entries[i].c;
        vals[pos] = entries[i].v;
    }
    free(next);

    CSRMatrix *m = xmalloc(sizeof(CSRMatrix));
    m->n = n;
    m->nnz = unique;
    m->row_ptr = row_ptr;
    m->col_idx = col_idx;
    m->vals = vals;
    m->symmetric = symmetric;
    return m;
}

static double *compute_diag(CSRMatrix *m) {
    double *diag = xcalloc((size_t)m->n, sizeof(double));
    for (int i = 0; i < m->n; i++) {
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            if (m->col_idx[idx] == i) diag[i] += m->vals[idx];
        }
    }
    return diag;
}

static int has_trailing_data(FILE *f) {
    int c;
    while ((c = fgetc(f)) != EOF) {
        if (isspace((unsigned char)c)) continue;
        if (c == '%') {
            while ((c = fgetc(f)) != EOF && c != '\n');
            continue;
        }
        return 1;
    }
    return 0;
}
