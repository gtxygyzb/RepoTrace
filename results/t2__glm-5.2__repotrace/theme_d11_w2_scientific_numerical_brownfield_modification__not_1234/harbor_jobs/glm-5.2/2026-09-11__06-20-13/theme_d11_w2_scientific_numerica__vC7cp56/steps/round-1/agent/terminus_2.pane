   183	static CSRMatrix *read_matrix(const char *filename) {
   184	    FILE *f = fopen(filename, "r");
   185	    if (!f) die("cannot open matrix file");
   186	
   187	    char line[1024];
   188	    if (!fgets(line, sizeof(line), f)) {
   189	        fclose(f);
   190	        die("empty matrix file");
   191	    }
   192	    if (strncmp(line, "%%MatrixMarket", 14) != 0) {
   193	        fclose(f);
   194	        die("matrix file is not Matrix Market format");
   195	    }
   196	
   197	    char obj[64], fmt[64], field[64], sym[64];
   198	    if (sscanf(line, "%*s %63s %63s %63s %63s", obj, fmt, field, sym) != 4) {
   199	        fclose(f);
   200	        die("invalid Matrix Market header");
   201	    }
   202	    if (strcmp(obj, "matrix") != 0 || strcmp(fmt, "coordinate") != 0 || strcmp(field, "real") != 0) {
   203	        fclose(f);
   204	        die("only real coordinate matrices are supported");
   205	    }
   206	
   207	    int symmetric;
   208	    if (strcmp(sym, "symmetric") == 0) symmetric = 1;
   209	    else if (strcmp(sym, "general") == 0) symmetric = 0;
   210	    else {
   211	        fclose(f);
   212	        die("only symmetric or general matrices are supported");
   213	    }
   214	
   215	    while (fgets(line, sizeof(line), f)) {
   216	        char *p = line;
   217	        while (isspace((unsigned char)*p)) p++;
   218	        if (*p == '%') continue;
   219	        if (*p == '\0') continue;
   220	        break;
   221	    }
   222	
   223	    int rows, cols, nnz;
   224	    if (sscanf(line, "%d %d %d", &rows, &cols, &nnz) != 3) {
   225	        fclose(f);
   226	        die("failed to read matrix dimensions");
   227	    }
   228	    if (rows <= 0 || cols <= 0) {
   229	        fclose(f);
   230	        die("invalid matrix dimensions");
   231	    }
   232	    if (rows != cols) {
   233	        fclose(f);
   234	        die("matrix must be square");
   235	    }
   236	    if (nnz < 0) {
   237	        fclose(f);
   238	        die("invalid nnz");
   239	    }
   240	
   241	    Entry *entries = NULL;
   242	    int count = 0, cap = 0;
   243	    for (int k = 0; k < nnz; k++) {
   244	        int r, c;
   245	        double v;
   246	        if (fscanf(f, "%d %d %lf", &r, &c, &v) != 3) {
   247	            fclose(f);
   248	            free(entries);
   249	            die("failed to read matrix entry");
   250	        }
   251	        if (r < 1 || r > rows || c < 1 || c > cols) {
   252	            fclose(f);
   253	            free(entries);
   254	            die("matrix entry index out of range");
   255	        }
   256	        r--;
   257	        c--;
   258	        if (symmetric) {
   259	            if (r < c) {
   260	                int t = r; r = c; c = t;
   261	            }
   262	            add_entry(&entries, &count, &cap, r, c, v);
   263	            if (r != c) add_entry(&entries, &count, &cap, c, r, v);
   264	        } else {
   265	            add_entry(&entries, &count, &cap, r, c, v);
   266	        }
   267	    }
   268	
   269	    if (has_trailing_data(f)) {
   270	        free(entries);
   271	        fclose(f);
   272	        die("extra trailing data in matrix file");
   273	    }
   274	
   275	    fclose(f);
   276	
   277	    CSRMatrix *m = build_csr(rows, entries, count, symmetric);
   278	    free(entries);
   279	    return m;
   280	}
