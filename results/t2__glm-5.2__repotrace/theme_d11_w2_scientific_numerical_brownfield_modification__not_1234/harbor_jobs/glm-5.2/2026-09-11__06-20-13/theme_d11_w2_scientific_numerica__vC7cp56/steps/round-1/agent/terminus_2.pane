   761	static ICFactor *ic0_factorize(const CSRMatrix *m) {
   762	    int n = m->n;
   763	    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
   764	    for (int i = 0; i < n; i++) {
   765	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   766	            if (m->col_idx[idx] < i) row_ptr[i + 1]++;
   767	        }
   768	    }
   769	    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];
   770	
   771	    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));
   772	    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));
   773	    int *next = xcalloc((size_t)n, sizeof(int));
   774	    for (int i = 0; i < n; i++) {
   775	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   776	            int j = m->col_idx[idx];
   777	            if (j < i) col_idx[row_ptr[i] + next[i]++] = j;
   778	        }
   779	    }
   780	    free(next);
   781	
   782	    double *diag = xmalloc((size_t)n * sizeof(double));
   783	    for (int i = 0; i < n; i++) {
   784	        double aii = 0.0;
   785	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   786	            if (m->col_idx[idx] == i) aii += m->vals[idx];
   787	        }
   788	
   789	        double sum = aii;
   790	        for (int k = row_ptr[i]; k < row_ptr[i + 1]; k++) {
   791	            int j = col_idx[k];
   792	            double aij = 0.0;
   793	            for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   794	                if (m->col_idx[idx] == j) {
   795	                    aij += m->vals[idx];
   796	                    break;
   797	                }
   798	            }
   799	
   800	            double s = aij;
   801	            int pi = row_ptr[i];
   802	            int pj = row_ptr[j];
   803	            while (pi < k && pj < row_ptr[j + 1]) {
   804	                int ci = col_idx[pi];
   805	                int cj = col_idx[pj];
   806	                if (ci == cj) {
   807	                    s -= vals[pi] * vals[pj];
   808	                    pi++;
   809	                    pj++;
   810	                } else if (ci < cj) {
   811	                    pi++;
   812	                } else {
   813	                    pj++;
   814	                }
   815	            }
   816	
   817	            if (diag[j] <= 0.0) die("zero or negative pivot in IC(0) factorization");
   818	            double l = s / diag[j];
   819	            vals[k] = l;
   820	            sum -= l * l;
   821	        }
   822	
   823	        if (sum <= 0.0) die("zero or negative pivot in IC(0) factorization");
   824	        diag[i] = sqrt(sum);
   825	    }
   826	
   827	    ICFactor *ic = xmalloc(sizeof(ICFactor));
   828	    ic->n = n;
   829	    ic->l_row_ptr = row_ptr;
   830	    ic->l_col_idx = col_idx;
   831	    ic->l_vals = vals;
   832	    ic->diag = diag;
   833	    ic->u_row_ptr = NULL;
   834	    ic->u_col_idx = NULL;
   835	    ic->u_vals = NULL;
   836	    return ic;
   837	}
   838	
   839	static Precond *precond_setup(CSRMatrix *m, int type, double omega) {
   840	    Precond *p = xmalloc(sizeof(Precond));
   841	    p->type = type;
   842	    p->A = m;
   843	    p->diag = NULL;
   844	    p->lower = NULL;
   845	    p->upper = NULL;
   846	    p->omega = omega;
   847	    p->ic = NULL;
   848	
   849	    if (type == PRECOND_JACOBI) {
   850	        p->diag = compute_diag(m);
   851	        for (int i = 0; i < m->n; i++) {
   852	            if (p->diag[i] == 0.0) die("zero diagonal in Jacobi preconditioner");
   853	        }
   854	    } else if (type == PRECOND_SSOR) {
   855	        if (omega <= 0.0 || omega >= 2.0) die("invalid SSOR parameter");
   856	        p->diag = compute_diag(m);
   857	        p->lower = build_lower_triangular(m);
   858	        p->upper = build_upper_triangular(m);
   859	    } else if (type == PRECOND_IC0) {
   860	        if (!m->symmetric) die("IC(0) requires symmetric matrix");
   861	        p->ic = ic0_factorize(m);
   862	    }
   863	
   864	    return p;
   865	}
