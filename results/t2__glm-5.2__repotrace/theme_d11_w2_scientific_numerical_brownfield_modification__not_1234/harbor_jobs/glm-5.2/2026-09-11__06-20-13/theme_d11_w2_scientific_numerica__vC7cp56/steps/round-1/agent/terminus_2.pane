   714	static ICFactor *ic0_factorize(const CSRMatrix *m) {
   715	    int n = m->n;
   716	    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
   717	    for (int i = 0; i < n; i++) {
   718	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   719	            if (m->col_idx[idx] < i) row_ptr[i + 1]++;
   720	        }
   721	    }
   722	    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];
   723	
   724	    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));
   725	    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));
   726	    int *next = xcalloc((size_t)n, sizeof(int));
   727	    for (int i = 0; i < n; i++) {
   728	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   729	            int j = m->col_idx[idx];
   730	            if (j < i) col_idx[row_ptr[i] + next[i]++] = j;
   731	        }
   732	    }
   733	    free(next);
   734	
   735	    double *diag = xmalloc((size_t)n * sizeof(double));
   736	    for (int i = 0; i < n; i++) {
   737	        double aii = 0.0;
   738	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   739	            if (m->col_idx[idx] == i) aii += m->vals[idx];
   740	        }
   741	
   742	        double sum = aii;
   743	        for (int k = row_ptr[i]; k < row_ptr[i + 1]; k++) {
   744	            int j = col_idx[k];
   745	            double aij = 0.0;
   746	            for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   747	                if (m->col_idx[idx] == j) {
   748	                    aij += m->vals[idx];
   749	                    break;
   750	                }
   751	            }
   752	
   753	            double s = aij;
   754	            int pi = row_ptr[i];
   755	            int pj = row_ptr[j];
   756	            while (pi < k && pj < row_ptr[j + 1]) {
   757	                int ci = col_idx[pi];
   758	                int cj = col_idx[pj];
   759	                if (ci == cj) {
   760	                    s -= vals[pi] * vals[pj];
   761	                    pi++;
   762	                    pj++;
   763	                } else if (ci < cj) {
   764	                    pi++;
   765	                } else {
   766	                    pj++;
   767	                }
   768	            }
   769	
   770	            if (diag[j] <= 0.0) die("zero or negative pivot in IC(0) factorization");
   771	            double l = s / diag[j];
   772	            vals[k] = l;
   773	            sum -= l * l;
   774	        }
   775	
   776	        if (sum <= 0.0) die("zero or negative pivot in IC(0) factorization");
   777	        diag[i] = sqrt(sum);
   778	    }
   779	
   780	    ICFactor *ic = xmalloc(sizeof(ICFactor));
   781	    ic->n = n;
   782	    ic->l_row_ptr = row_ptr;
   783	    ic->l_col_idx = col_idx;
   784	    ic->l_vals = vals;
   785	    ic->diag = diag;
   786	    ic->u_row_ptr = NULL;
   787	    ic->u_col_idx = NULL;
   788	    ic->u_vals = NULL;
   789	    return ic;
   790	}
   791	
   792	static Precond *precond_setup(CSRMatrix *m, int type, double omega) {
   793	    Precond *p = xmalloc(sizeof(Precond));
   794	    p->type = type;
   795	    p->A = m;
   796	    p->diag = NULL;
   797	    p->lower = NULL;
   798	    p->upper = NULL;
   799	    p->omega = omega;
   800	    p->ic = NULL;
   801	
   802	    if (type == PRECOND_JACOBI) {
   803	        p->diag = compute_diag(m);
   804	        for (int i = 0; i < m->n; i++) {
   805	            if (p->diag[i] == 0.0) die("zero diagonal in Jacobi preconditioner");
   806	        }
   807	    } else if (type == PRECOND_SSOR) {
   808	        if (omega <= 0.0 || omega >= 2.0) die("invalid SSOR parameter");
   809	        p->diag = compute_diag(m);
   810	        p->lower = build_lower_triangular(m);
   811	        p->upper = build_upper_triangular(m);
   812	    } else if (type == PRECOND_IC0) {
   813	        if (!m->symmetric) die("IC(0) requires symmetric matrix");
   814	        p->ic = ic0_factorize(m);
   815	    }
   816	
   817	    return p;
   818	}
   819	
   820	static void precond_apply(Precond *p, const double *r, double *z) {
   821	    int n = p->A->n;
   822	
   823	    if (p->type == PRECOND_NONE) {
   824	        dcopy(n, r, z);
   825	        return;
   826	    }
   827	
   828	    if (p->type == PRECOND_JACOBI) {
   829	        for (int i = 0; i < n; i++) {
   830	            if (p->diag[i] == 0.0) die("zero diagonal in Jacobi preconditioner");
   831	            z[i] = r[i] / p->diag[i];
   832	        }
   833	        return;
   834	    }
   835	
   836	    if (p->type == PRECOND_SSOR) {
   837	        dcopy(n, r, z);
   838	        for (int i = 0; i < n; i++) {
   839	            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {
   840	                int j = p->lower->col_idx[idx];
   841	                if (j < i) z[i] -= p->lower->vals[idx] * z[j];
   842	            }
   843	            if (p->diag[i] == 0.0) {
   844	                z[i] = 0.0;
   845	                continue;
   846	            }
   847	            z[i] /= p->diag[i];
   848	        }
   849	        for (int i = n - 1; i >= 0; i--) {
   850	            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {
   851	                int j = p->upper->col_idx[idx];
   852	                if (j > i) z[i] -= p->upper->vals[idx] * z[j];
   853	            }
   854	            if (p->diag[i] == 0.0) {
   855	                z[i] = 0.0;
   856	                continue;
   857	            }
   858	            z[i] /= p->diag[i];
   859	        }
   860	        return;
   861	    }
   862	
   863	    if (p->type == PRECOND_IC0) {
   864	        ICFactor *ic = p->ic;
   865	        for (int i = 0; i < n; i++) {
   866	            double s = r[i];
   867	            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {
   868	                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];
   869	            }
   870	            if (ic->diag[i] == 0.0) die("zero or negative pivot in IC(0) factorization");
   871	            z[i] = s / ic->diag[i];
   872	        }
   873	        for (int i = n - 1; i >= 0; i--) {
   874	            z[i] /= ic->diag[i];
   875	            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {
   876	                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];
   877	            }
   878	        }
   879	        return;
   880	    }
   881	
   882	    die("unknown preconditioner");
   883	}
   884	
   885	static void free_precond(Precond *p) {
   886	    if (!p) return;
   887	    free(p->diag);
   888	    free_tri_matrix(p->lower);
   889	    free_tri_matrix(p->upper);
   890	    if (p->ic) {
   891	        free(p->ic->l_row_ptr);
   892	        free(p->ic->l_col_idx);
   893	        free(p->ic->l_vals);
   894	        free(p->ic->diag);
   895	        free(p->ic->u_row_ptr);
   896	        free(p->ic->u_col_idx);
   897	        free(p->ic->u_vals);
   898	        free(p->ic);
   899	    }
   900	    free(p);
   901	}
