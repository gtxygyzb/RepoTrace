   374	static void generate_rhs(int N, const char *output) {
   375	    FILE *f = fopen(output, "w");
   376	    if (!f) die("cannot open output rhs file");
   377	    fprintf(f, "%d\n", N);
   378	    for (int i = 1; i <= N; i++) {
   379	        fprintf(f, "%.15g\n", sin((double)i * M_PI / (double)(N + 1)));
   380	    }
   381	    fclose(f);
   382	}
