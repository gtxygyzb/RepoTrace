   654	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   655	            int j = m->col_idx[idx];
   656	            if (j <= i) {
   657	                int pos = row_ptr[i] + next[i]++;
   658	                col_idx[pos] = j;
   659	                vals[pos] = m->vals[idx];
   660	            }
   661	        }
   662	    }
   663	    free(next);
