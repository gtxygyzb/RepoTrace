   993	        precond_apply(p, r, z);
   994	        double rz_new = dot(n, r, z);
   995	        if (rz_old == 0.0) {
   996	            break;
   997	        }
   998	        double beta = rz_new / rz_old;
   999	        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];
  1000	        rz_old = rz_new;
  1001	    }
  1002	
  1003	    if (iterations_out) *iterations_out = it_count;
