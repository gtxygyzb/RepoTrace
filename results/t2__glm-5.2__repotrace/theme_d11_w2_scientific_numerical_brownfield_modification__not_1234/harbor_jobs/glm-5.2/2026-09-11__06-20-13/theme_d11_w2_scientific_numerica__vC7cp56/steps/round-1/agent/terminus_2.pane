   904	    int n = A->n;
   905	    double *x = xcalloc((size_t)n, sizeof(double));
   906	    double *r = xmalloc((size_t)n * sizeof(double));
   907	    double *z = xmalloc((size_t)n * sizeof(double));
   908	    double *pvec = xmalloc((size_t)n * sizeof(double));
   909	    double *Ap = xmalloc((size_t)n * sizeof(double));
