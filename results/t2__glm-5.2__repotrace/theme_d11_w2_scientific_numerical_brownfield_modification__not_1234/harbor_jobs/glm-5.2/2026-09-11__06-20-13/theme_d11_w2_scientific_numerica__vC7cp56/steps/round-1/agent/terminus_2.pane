[?2004l   903	static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {
   904	    int n = A->n;
   905	    double *x = xcalloc((size_t)n, sizeof(double));
   906	    double *r = xmalloc((size_t)n * sizeof(double));
   907	    double *z = xmalloc((size_t)n * sizeof(double));
   908	    double *pvec = xmalloc((size_t)n * sizeof(double));
   909	    double *Ap = xmalloc((size_t)n * sizeof(double));
   910	
   911	    spmv(A, x, r);
   912	    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];
   913	    double bnorm = vec_norm2(n, b);
   914	    int it_count = 0;
   915	
   916	    precond_apply(p, r, z);
   917	    dcopy(n, z, pvec);
   918	    double rz_old = dot(n, r, z);
   919	
   920	    for (int it = 0; it < max_it; it++) {
   921	        spmv(A, pvec, Ap);
   922	        double pAp = dot(n, pvec, Ap);
   923	        if (pAp <= 0.0) {
   924	            free(r); free(z); free(pvec); free(Ap);
   925	            die("matrix is not positive definite");
   926	        }
   927	        double alpha = rz_old / pAp;
   928	        for (int i = 0; i < n; i++) {
   929	            x[i] += alpha * pvec[i];
   930	            r[i] -= alpha * Ap[i];
   931	        }
   932	        it_count = it + 1;
   933	        if (history) {
   934	            printf("iteration %d residual %.6e\n", it_count, vec_norm2(n, r));
   935	        }
   936	        if (vec_norm2(n, r) <= tol * bnorm) break;
   937	
   938	        precond_apply(p, r, z);
   939	        double rz_new = dot(n, r, z);
   940	        if (rz_old == 0.0) {
   941	            free(r); free(z); free(pvec); free(Ap);
   942	            die("CG numerical breakdown");
   943	        }
   944	        double beta = rz_new / rz_old;
   945	        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];
   946	        rz_old = rz_new;
   947	    }
   948	
   949	    if (iterations_out) *iterations_out = it_count;
   950	    free(r); free(z); free(pvec); free(Ap);
   951	    return x;
   952	}
