[?2004l   447	static void analyze_matrix(CSRMatrix *m) {
   448	    double *diag = compute_diag(m);
   449	    int bandwidth = 0;
   450	    long profile = 0;
   451	    int strict_count = 0;
   452	    int weak_all = 1;
   453	
   454	    for (int i = 0; i < m->n; i++) {
   455	        int min_col = i;
   456	        int has_off = 0;
   457	        double off_sum = 0.0;
   458	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   459	            int j = m->col_idx[idx];
   460	            int diff = i - j;
   461	            if (diff < 0) diff = -diff;
   462	            if (diff > bandwidth) bandwidth = diff;
   463	            if (j < i) {
   464	                if (!has_off || j < min_col) min_col = j;
   465	                has_off = 1;
   466	                off_sum += fabs(m->vals[idx]);
   467	            } else if (j > i) {
   468	                has_off = 1;
   469	                if (j < min_col) min_col = j;
   470	                off_sum += fabs(m->vals[idx]);
   471	            }
   472	        }
   473	        if (has_off) profile += (long)(i - min_col);
   474	
   475	        double d = fabs(diag[i]);
   476	        if (d > off_sum + 1e-300) {
   477	            strict_count++;
   478	        } else if (d >= off_sum - 1e-300) {
   479	            // weak candidate
   480	        } else {
   481	            weak_all = 0;
   482	        }
   483	    }
   484	
   485	    const char *dominance;
   486	    if (strict_count == m->n) dominance = "strict";
   487	    else if (weak_all) dominance = "weak";
   488	    else dominance = "no";
   489	
   490	    printf("dimension: %d\n", m->n);
   491	    printf("nonzeros: %d\n", m->nnz);
   492	    printf("symmetric: %s\n", m->symmetric ? "yes" : "no");
   493	    printf("bandwidth: %d\n", bandwidth);
   494	    printf("profile: %ld\n", profile);
   495	    printf("diag_dominant: %s\n", dominance);
   496	    free(diag);
   497	}
   498	
   499	static CSRMatrix *permute_csr(const CSRMatrix *m, const int *perm) {
   500	    int n = m->n;
   501	    int *inv = xmalloc((size_t)n * sizeof(int));
   502	    for (int i = 0; i < n; i++) inv[perm[i]] = i;
   503	
   504	    int *counts = xcalloc((size_t)n, sizeof(int));
   505	    for (int i = 0; i < n; i++) {
   506	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   507	            int ni = perm[i];
   508	            counts[ni]++;
   509	        }
   510	    }
   511	
   512	    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
   513	    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + counts[i];
   514	    free(counts);
   515	
   516	    int nnz = m->nnz;
   517	    int *col_idx = xmalloc((size_t)nnz * sizeof(int));
   518	    double *vals = xmalloc((size_t)nnz * sizeof(double));
   519	    int *next = xcalloc((size_t)n, sizeof(int));
   520	    for (int i = 0; i < n; i++) {
   521	        int ni = perm[i];
   522	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   523	            int nj = perm[m->col_idx[idx]];
   524	            int pos = row_ptr[ni] + next[ni]++;
   525	            col_idx[pos] = nj;
   526	            vals[pos] = m->vals[idx];
   527	        }
   528	    }
   529	    free(next);
   530	    free(inv);
   531	
   532	    CSRMatrix *p = xmalloc(sizeof(CSRMatrix));
   533	    p->n = n;
   534	    p->nnz = nnz;
   535	    p->row_ptr = row_ptr;
   536	    p->col_idx = col_idx;
   537	    p->vals = vals;
   538	    p->symmetric = m->symmetric;
   539	    return p;
   540	}
