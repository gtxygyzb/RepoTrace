   182	static CSRMatrix *read_matrix(const char *filename) {
   183	    FILE *f = fopen(filename, "r");
   184	    if (!f) die("cannot open matrix file");
   185	
   186	    char line[1024];
   187	    if (!fgets(line, sizeof(line), f)) {
   188	        fclose(f);
   189	        die("empty matrix file");
   190	    }
   191	    if (strncmp(line, "%%MatrixMarket", 14) != 0) {
   192	        fclose(f);
   193	        die("matrix file is not Matrix Market format");
   194	    }
   195	
   196	    char obj[64], fmt[64], field[64], sym[64];
   197	    if (sscanf(line, "%*s %63s %63s %63s %63s", obj, fmt, field, sym) != 4) {
   198	        fclose(f);
   199	        die("invalid Matrix Market header");
   200	    }
   201	    if (strcmp(obj, "matrix") != 0 || strcmp(fmt, "coordinate") != 0 || strcmp(field, "real") != 0) {
   202	        fclose(f);
   203	        die("only real coordinate matrices are supported");
   204	    }
   205	
   206	    int symmetric;
   207	    if (strcmp(sym, "symmetric") == 0) symmetric = 1;
   208	    else if (strcmp(sym, "general") == 0) symmetric = 0;
   209	    else {
   210	        fclose(f);
   211	        die("only symmetric or general matrices are supported");
   212	    }
   213	
   214	    while (fgets(line, sizeof(line), f)) {
   215	        char *p = line;
   216	        while (isspace((unsigned char)*p)) p++;
   217	        if (*p == '%') continue;
   218	        if (*p == '\0') continue;
   219	        break;
   220	    }
   221	
   222	    int rows, cols, nnz;
   223	    if (sscanf(line, "%d %d %d", &rows, &cols, &nnz) != 3) {
   224	        fclose(f);
   225	        die("failed to read matrix dimensions");
   226	    }
   227	    if (rows <= 0 || cols <= 0) {
   228	        fclose(f);
   229	        die("invalid matrix dimensions");
   230	    }
   231	    if (rows != cols) {
   232	        fclose(f);
   233	        die("matrix must be square");
   234	    }
   235	    if (nnz < 0) {
   236	        fclose(f);
   237	        die("invalid nnz");
   238	    }
   239	
   240	    Entry *entries = NULL;
   241	    int count = 0, cap = 0;
   242	    for (int k = 0; k < nnz; k++) {
   243	        int r, c;
   244	        double v;
   245	        if (fscanf(f, "%d %d %lf", &r, &c, &v) != 3) {
   246	            fclose(f);
   247	            free(entries);
   248	            die("failed to read matrix entry");
   249	        }
   250	        if (r < 1 || r > rows || c < 1 || c > cols) {
   251	            fclose(f);
   252	            free(entries);
   253	            die("matrix entry index out of range");
   254	        }
   255	        r--;
   256	        c--;
   257	        if (symmetric) {
   258	            if (r < c) {
   259	                int t = r; r = c; c = t;
   260	            }
   261	            add_entry(&entries, &count, &cap, r, c, v);
   262	            if (r != c) add_entry(&entries, &count, &cap, c, r, v);
   263	        } else {
   264	            add_entry(&entries, &count, &cap, r, c, v);
   265	        }
   266	    }
   267	
   268	    if (has_trailing_data(f)) {
   269	        free(entries);
   270	        fclose(f);
   271	        die("extra trailing data in matrix file");
   272	    }
   273	
   274	    fclose(f);
   275	
   276	    CSRMatrix *m = build_csr(rows, entries, count, symmetric);
   277	    free(entries);
   278	    return m;
   279	}
