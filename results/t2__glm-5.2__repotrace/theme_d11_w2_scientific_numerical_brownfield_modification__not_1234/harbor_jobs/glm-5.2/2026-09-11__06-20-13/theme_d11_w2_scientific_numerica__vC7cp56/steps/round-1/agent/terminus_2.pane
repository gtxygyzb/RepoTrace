static void die(const char *msg) {
    fprintf(stderr, "nlsolve: %s\n", msg);
    exit(1);
}

static void *xmalloc(size_t s) {
    if (s == 0) s = 1;
    void *p = malloc(s);
    if (!p) die("out of memory");
    return p;
}

static void *xcalloc(size_t n, size_t s) {
    if (n == 0) n = 1;
    void *p = calloc(n, s);
    if (!p) die("out of memory");
    return p;
}

static double dot(int n, const double *a, const double *b) {
    double s = 0.0;
    for (int i = 0; i < n; i++) s += a[i] * b[i];
    return s;
}

static void dcopy(int n, const double *src, double *dst) {
    for (int i = 0; i < n; i++) dst[i] = src[i];
}

static void dzero(int n, double *x) {
    for (int i = 0; i < n; i++) x[i] = 0.0;
}

static int cmp_entry(const void *a, const void *b) {
    const Entry *ea = (const Entry *)a;
    const Entry *eb = (const Entry *)b;
    if (ea->r != eb->r) return ea->r - eb->r;
    return ea->c - eb->c;
}

static void add_entry(Entry **arr, int *count, int *cap, int r, int c, double v) {
    if (*count == *cap) {
        *cap = (*cap ? *cap * 2 : 16);
        *arr = realloc(*arr, (size_t)*cap * sizeof(Entry));
        if (!*arr) die("out of memory");
    }
    (*arr)[*count].r = r;
    (*arr)[*count].c = c;
    (*arr)[*count].v = v;
    (*count)++;
}

static CSRMatrix *build_csr(int n, Entry *entries, int count, int symmetric) {
    if (count > 0) qsort(entries, (size_t)count, sizeof(Entry), cmp_entry);

    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
    int *tmp_count = xcalloc((size_t)n, sizeof(int));

    int unique = 0;
    for (int i = 0; i < count; ) {
        int r = entries[i].r;
        int c = entries[i].c;
        double sum = 0.0;
        while (i < count && entries[i].r == r && entries[i].c == c) {
            sum += entries[i].v;
            i++;
        }
        entries[unique].r = r;
        entries[unique].c = c;
        entries[unique].v = sum;
        unique++;
        tmp_count[r]++;
    }

    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + tmp_count[i];
    free(tmp_count);

    int *col_idx = xmalloc((size_t)unique * sizeof(int));
    double *vals = xmalloc((size_t)unique * sizeof(double));
    int *next = xcalloc((size_t)n, sizeof(int));

    for (int i = 0; i < unique; i++) {
        int r = entries[i].r;
        int pos = row_ptr[r] + next[r]++;
        col_idx[pos] = entries[i].c;
        vals[pos] = entries[i].v;
    }
    free(next);

    CSRMatrix *m = xmalloc(sizeof(CSRMatrix));
    m->n = n;
    m->nnz = unique;
    m->row_ptr = row_ptr;
    m->col_idx = col_idx;
    m->vals = vals;
    m->symmetric = symmetric;
    return m;
}

static double *compute_diag(CSRMatrix *m) {
    double *diag = xcalloc((size_t)m->n, sizeof(double));
    for (int i = 0; i < m->n; i++) {
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            if (m->col_idx[idx] == i) diag[i] += m->vals[idx];
        }
    }
    return diag;
}

static CSRMatrix *read_matrix(const char *filename) {
    FILE *f = fopen(filename, "r");
    if (!f) die("cannot open matrix file");

    char line[1024];
    if (!fgets(line, sizeof(line), f)) {
        fclose(f);
        die("empty matrix file");
    }
    if (strncmp(line, "%%MatrixMarket", 14) != 0) {
        fclose(f);
        die("matrix file is not Matrix Market format");
    }

    char obj[64], fmt[64], field[64], sym[64];
    if (sscanf(line, "%*s %63s %63s %63s %63s", obj, fmt, field, sym) != 4) {
        fclose(f);
        die("invalid Matrix Market header");
    }
    if (strcmp(obj, "matrix") != 0 || strcmp(fmt, "coordinate") != 0 || strcmp(field, "real") != 0) {
        fclose(f);
        die("only real coordinate matrices are supported");
    }

    int symmetric;
    if (strcmp(sym, "symmetric") == 0) symmetric = 1;
    else if (strcmp(sym, "general") == 0) symmetric = 0;
    else {
        fclose(f);
        die("only symmetric or general matrices are supported");
    }

    while (fgets(line, sizeof(line), f)) {
        char *p = line;
        while (isspace((unsigned char)*p)) p++;
        if (*p == '%') continue;
        if (*p == '\0') continue;
        break;
    }

    int rows, cols, nnz;
    if (sscanf(line, "%d %d %d", &rows, &cols, &nnz) != 3) {
        fclose(f);
        die("failed to read matrix dimensions");
    }
    if (rows != cols) {
        fclose(f);
        die("matrix must be square");
    }
    if (nnz < 0) {
        fclose(f);
        die("invalid nnz");
    }

    Entry *entries = NULL;
    int count = 0, cap = 0;
    for (int k = 0; k < nnz; k++) {
        int r, c;
        double v;
        if (fscanf(f, "%d %d %lf", &r, &c, &v) != 3) {
            fclose(f);
            free(entries);
            die("failed to read matrix entry");
        }
        if (r < 1 || r > rows || c < 1 || c > cols) {
            fclose(f);
            free(entries);
            die("matrix entry index out of range");
        }
        r--;
        c--;
        if (symmetric) {
            if (r < c) {
                int t = r; r = c; c = t;
            }
            add_entry(&entries, &count, &cap, r, c, v);
            if (r != c) add_entry(&entries, &count, &cap, c, r, v);
        } else {
            add_entry(&entries, &count, &cap, r, c, v);
        }
    }
    fclose(f);

    CSRMatrix *m = build_csr(rows, entries, count, symmetric);
    free(entries);
    return m;
}

static double *read_vector(const char *filename, int *n_out) {
    FILE *f = fopen(filename, "r");
[?2004hroot@n30009:/app# sed -n '260,560p' nlsolve.c
[?2004l    FILE *f = fopen(filename, "r");
    if (!f) die("cannot open rhs file");
    int n;
    if (fscanf(f, "%d", &n) != 1) {
        fclose(f);
        die("failed to read vector dimension");
    }
    if (n <= 0) die("invalid vector dimension");
    double *x = xmalloc((size_t)n * sizeof(double));
    for (int i = 0; i < n; i++) {
        if (fscanf(f, "%lf", &x[i]) != 1) {
            fclose(f);
            free(x);
            die("failed to read vector entry");
        }
    }
    fclose(f);
    *n_out = n;
    return x;
}

static void write_matrix_market(const char *filename, int n, int nnz, Entry *entries) {
    FILE *f = fopen(filename, "w");
    if (!f) die("cannot open output matrix file");
    fprintf(f, "%%%%MatrixMarket matrix coordinate real symmetric\n");
    fprintf(f, "%d %d %d\n", n, n, nnz);
    for (int k = 0; k < nnz; k++) {
        fprintf(f, "%d %d %.15g\n", entries[k].r + 1, entries[k].c + 1, entries[k].v);
    }
    fclose(f);
}

static int cmp_entry_rc(const void *a, const void *b) {
    const Entry *ea = (const Entry *)a;
    const Entry *eb = (const Entry *)b;
    if (ea->r != eb->r) return ea->r - eb->r;
    return ea->c - eb->c;
}

static void generate_laplacian2d(int n, const char *output) {
    int N = n * n;
    int cap = N * 3;
    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));
    int count = 0;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            int row = i * n + j;
            entries[count].r = row;
            entries[count].c = row;
            entries[count].v = 4.0;
            count++;
            if (j > 0) {
                int col = i * n + (j - 1);
                entries[count].r = row;
                entries[count].c = col;
                entries[count].v = -1.0;
                count++;
            }
            if (i > 0) {
                int col = (i - 1) * n + j;
                entries[count].r = row;
                entries[count].c = col;
                entries[count].v = -1.0;
                count++;
            }
        }
    }
    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);
    write_matrix_market(output, N, count, entries);
    free(entries);
}

static void generate_laplacian3d(int n, const char *output) {
    int N = n * n * n;
    int cap = N * 4;
    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));
    int count = 0;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            for (int k = 0; k < n; k++) {
                int row = (i * n + j) * n + k;
                entries[count].r = row;
                entries[count].c = row;
                entries[count].v = 6.0;
                count++;
                if (k > 0) {
                    int col = row - 1;
                    entries[count].r = row;
                    entries[count].c = col;
                    entries[count].v = -1.0;
                    count++;
                }
                if (j > 0) {
                    int col = row - n;
                    entries[count].r = row;
                    entries[count].c = col;
                    entries[count].v = -1.0;
                    count++;
                }
                if (i > 0) {
                    int col = row - n * n;
                    entries[count].r = row;
                    entries[count].c = col;
                    entries[count].v = -1.0;
                    count++;
                }
            }
        }
    }
    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);
    write_matrix_market(output, N, count, entries);
    free(entries);
}

static void generate_rhs(int N, const char *output) {
    FILE *f = fopen(output, "w");
    if (!f) die("cannot open output rhs file");
    fprintf(f, "%d\n", N);
    for (int i = 1; i <= N; i++) {
        fprintf(f, "%.15g\n", sin((double)i * M_PI / (double)(N + 1)));
    }
    fclose(f);
}

static void free_csr(CSRMatrix *m) {
    if (!m) return;
    free(m->row_ptr);
    free(m->col_idx);
    free(m->vals);
    free(m);
}

static void spmv(const CSRMatrix *m, const double *x, double *y) {
    for (int i = 0; i < m->n; i++) {
        double s = 0.0;
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            s += m->vals[idx] * x[m->col_idx[idx]];
        }
        y[i] = s;
    }
}

static double vec_norm2(int n, const double *x) {
    return sqrt(dot(n, x, x));
}

static void analyze_matrix(CSRMatrix *m) {
    double *diag = compute_diag(m);
    int bandwidth = 0;
    long profile = 0;
    int strict_count = 0;
    int weak_all = 1;

    for (int i = 0; i < m->n; i++) {
        int min_col = i;
        int has_off = 0;
        double off_sum = 0.0;
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            int j = m->col_idx[idx];
            int diff = i - j;
            if (diff < 0) diff = -diff;
            if (diff > bandwidth) bandwidth = diff;
            if (j < i) {
                if (!has_off || j < min_col) min_col = j;
                has_off = 1;
                off_sum += fabs(m->vals[idx]);
            } else if (j > i) {
                has_off = 1;
                if (j < min_col) min_col = j;
                off_sum += fabs(m->vals[idx]);
            }
        }
        if (has_off) profile += (long)(i - min_col);

        double d = fabs(diag[i]);
        if (d > off_sum + 1e-300) {
            strict_count++;
        } else if (d >= off_sum - 1e-300) {
            // weak candidate
        } else {
            weak_all = 0;
        }
    }

    const char *dominance;
    if (strict_count == m->n) dominance = "strict";
    else if (weak_all) dominance = "weak";
    else dominance = "no";

    printf("dimension: %d\n", m->n);
    printf("nonzeros: %d\n", m->nnz);
    printf("symmetric: %s\n", m->symmetric ? "yes" : "no");
    printf("bandwidth: %d\n", bandwidth);
    printf("profile: %ld\n", profile);
    printf("diag_dominant: %s\n", dominance);
    free(diag);
}

static CSRMatrix *permute_csr(const CSRMatrix *m, const int *perm) {
    int n = m->n;
    int *inv = xmalloc((size_t)n * sizeof(int));
    for (int i = 0; i < n; i++) inv[perm[i]] = i;

    int *counts = xcalloc((size_t)n, sizeof(int));
    for (int i = 0; i < n; i++) {
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            int ni = perm[i];
            counts[ni]++;
        }
    }

    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + counts[i];
    free(counts);

    int nnz = m->nnz;
    int *col_idx = xmalloc((size_t)nnz * sizeof(int));
    double *vals = xmalloc((size_t)nnz * sizeof(double));
    int *next = xcalloc((size_t)n, sizeof(int));
    for (int i = 0; i < n; i++) {
        int ni = perm[i];
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            int nj = perm[m->col_idx[idx]];
            int pos = row_ptr[ni] + next[ni]++;
            col_idx[pos] = nj;
            vals[pos] = m->vals[idx];
        }
    }
    free(next);
    free(inv);

    CSRMatrix *p = xmalloc(sizeof(CSRMatrix));
    p->n = n;
    p->nnz = nnz;
    p->row_ptr = row_ptr;
    p->col_idx = col_idx;
    p->vals = vals;
    p->symmetric = m->symmetric;
    return p;
}

static void build_adjacency(const CSRMatrix *m, int **adj_ptr, int **adj_count, int **adj_data) {
    int n = m->n;
    int *degree = xcalloc((size_t)n, sizeof(int));
    for (int i = 0; i < n; i++) {
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            int j = m->col_idx[idx];
            if (j != i) degree[i]++;
        }
    }
    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));
    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + degree[i];
    int *adj = xmalloc((size_t)row_ptr[n] * sizeof(int));
    int *next = xcalloc((size_t)n, sizeof(int));
    for (int i = 0; i < n; i++) {
        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
            int j = m->col_idx[idx];
            if (j != i) adj[row_ptr[i] + next[i]++] = j;
        }
    }
    free(next);
    free(degree);
    *adj_ptr = row_ptr;
    *adj_count = xcalloc((size_t)n, sizeof(int));
    *adj_data = adj;
}

static int cmp_int_desc_degree(const void *a, const void *b, void *ctx) {
    (void)ctx;
    int ia = *(const int *)a;
    int ib = *(const int *)b;
    return ia - ib;
}

static void rcm_ordering(const CSRMatrix *m, int *perm) {
    int n = m->n;
    int *adj_ptr, *adj_count, *adj;
    build_adjacency(m, &adj_ptr, &adj_count, &adj);

    int *degree = xcalloc((size_t)n, sizeof(int));
    for (int i = 0; i < n; i++) degree[i] = adj_ptr[i + 1] - adj_ptr[i];

    int *visited = xcalloc((size_t)n, sizeof(int));
    int *order = xmalloc((size_t)n * sizeof(int));
    int order_count = 0;
    int *queue = xmalloc((size_t)n * sizeof(int));
    int qhead = 0, qtail = 0;

    while (order_count < n) {
        int start = -1;
        for (int i = 0; i < n; i++) {
            if (!visited[i]) {
                if (start == -1 || degree[i] < degree[start] ||
                    (degree[i] == degree[start] && i < start)) {
                    start = i;
                }
            }
        }
        if (start == -1) break;
        visited[start] = 1;
        queue[qtail++] = start;
[?2004hroot@n30009:/app# sed -n '560,900p' nlsolve.c
[?2004l        queue[qtail++] = start;
        while (qhead < qtail) {
            int v = queue[qhead++];
            order[order_count++] = v;
            int base = adj_ptr[v];
            int deg = adj_ptr[v + 1] - base;
            int *nbrs = xmalloc((size_t)(deg ? deg : 1) * sizeof(int));
            int cnt = 0;
            for (int idx = 0; idx < deg; idx++) {
                int u = adj[base + idx];
                if (!visited[u]) nbrs[cnt++] = u;
            }
            // deterministic sort by degree then original index
            for (int a = 1; a < cnt; a++) {
                int key = nbrs[a];
                int b = a - 1;
                while (b >= 0) {
                    if (degree[nbrs[b]] < degree[key] ||
                        (degree[nbrs[b]] == degree[key] && nbrs[b] < key)) break;
                    nbrs[b + 1] = nbrs[b];
                    b--;
                }
                nbrs[b + 1] = key;
            }
            for (int idx = 0; idx < cnt; idx++) {
                int u = nbrs[idx];
                if (!visited[u]) {
                    visited[u] = 1;
                    queue[qtail++] = u;
                }
            }
            free(nbrs);
        }
    }

    for (int i = 0; i < n; i++) perm[order[n - 1 - i]] = i;

    free(adj_ptr);
    free(adj_count);
    free(adj);
    free(degree);
    free(visited);
    free(order);
    free(queue);
}
