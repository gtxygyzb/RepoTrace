   169	static int has_trailing_data(FILE *f) {
   170	    int c;
   171	    while ((c = fgetc(f)) != EOF) {
   172	        if (isspace((unsigned char)c)) continue;
   173	        if (c == '%') {
   174	            while ((c = fgetc(f)) != EOF && c != '\n');
   175	            continue;
   176	        }
   177	        return 1;
   178	    }
   179	    return 0;
   180	}
