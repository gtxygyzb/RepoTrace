   362	static void generate_laplacian3d(int n, const char *output) {
   363	    int N = n * n * n;
   364	    int cap = N * 4;
   365	    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));
   366	    int count = 0;
   367	    for (int i = 0; i < n; i++) {
   368	        for (int j = 0; j < n; j++) {
   369	            for (int k = 0; k < n; k++) {
   370	                int row = (i * n + j) * n + k;
   371	                entries[count].r = row;
   372	                entries[count].c = row;
   373	                entries[count].v = 6.0;
   374	                count++;
   375	                if (k > 0) {
   376	                    int col = row - 1;
   377	                    entries[count].r = row;
   378	                    entries[count].c = col;
   379	                    entries[count].v = -1.0;
   380	                    count++;
   381	                }
   382	                if (j > 0) {
   383	                    int col = row - n;
   384	                    entries[count].r = row;
   385	                    entries[count].c = col;
   386	                    entries[count].v = -1.0;
   387	                    count++;
   388	                }
   389	                if (i > 0) {
   390	                    int col = row - n * n;
   391	                    entries[count].r = row;
   392	                    entries[count].c = col;
   393	                    entries[count].v = -1.0;
   394	                    count++;
   395	                }
   396	            }
   397	        }
   398	    }
   399	    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);
   400	    write_matrix_market(output, N, count, entries);
   401	    free(entries);
   402	}
   403	
   404	static void generate_rhs(int N, const char *output) {
   405	    FILE *f = fopen(output, "w");
   406	    if (!f) die("cannot open output rhs file");
   407	    fprintf(f, "%d\n", N);
   408	    for (int i = 1; i <= N; i++) {
   409	        fprintf(f, "%.15g\n", sin((double)i * M_PI / (double)(N + 1)));
   410	    }
   411	    fclose(f);
   412	}
   413	
   414	static void free_csr(CSRMatrix *m) {
   415	    if (!m) return;
   416	    free(m->row_ptr);
   417	    free(m->col_idx);
   418	    free(m->vals);
   419	    free(m);
   420	}
   421	
   422	static void spmv(const CSRMatrix *m, const double *x, double *y) {
   423	    for (int i = 0; i < m->n; i++) {
   424	        double s = 0.0;
   425	        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {
   426	            s += m->vals[idx] * x[m->col_idx[idx]];
   427	        }
   428	        y[i] = s;
   429	    }
   430	}
