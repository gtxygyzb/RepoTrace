[6421.708142, "o", "\u001b[32m\u001b[K1069\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        double beta = (\u001b[01;31m\u001b[Krho\u001b[m\u001b[K_new / \u001b[01;31m\u001b[Krho\u001b[m\u001b[K_old) * (alpha / omega);\r\n\u001b[32m\u001b[K1071\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Krho\u001b[m\u001b[K_old = \u001b[01;31m\u001b[Krho\u001b[m\u001b[K_new;\r\n"]
[6421.708215, "o", "\u001b[32m\u001b[K1177\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"GMRES numerical \u001b[01;31m\u001b[Kbreakdown\u001b[m\u001b[K\");\r\n\u001b[32m\u001b[K1199\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output vector file\");\r\n\u001b[32m\u001b[K1204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n"]
