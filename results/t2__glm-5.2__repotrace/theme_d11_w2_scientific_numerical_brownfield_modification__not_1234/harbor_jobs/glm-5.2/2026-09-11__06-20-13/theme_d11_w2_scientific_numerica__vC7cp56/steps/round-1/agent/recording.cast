[6451.349506, "o", "\u001b[32m\u001b[K436\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic double \u001b[01;31m\u001b[Kcompute_true_residual\u001b[m\u001b[K(CSRMatrix *A, const double *b, const double *x) {\r\n"]
[6451.349628, "o", "\u001b[32m\u001b[K761\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic \u001b[01;31m\u001b[KICFactor\u001b[m\u001b[K *ic0_factorize(const CSRMatrix *m) {\r\n"]
[6451.349725, "o", "\u001b[32m\u001b[K817\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (diag[j] <= 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero or negative pivot in IC(0) factorization\");\r\n\u001b[32m\u001b[K823\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (sum <= 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero or negative pivot in IC(0) factorization\");\r\n\u001b[32m\u001b[K827\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[KICFactor\u001b[m\u001b[K *ic = xmalloc(sizeof(\u001b[01;31m\u001b[KICFactor\u001b[m\u001b[K));\r\n"]
[6451.349819, "o", "\u001b[32m\u001b[K839\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic Precond *\u001b[01;31m\u001b[Kprecond_setup\u001b[m\u001b[K(CSRMatrix *m, int type, double omega) {\r\n\u001b[32m\u001b[K852\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in Jacobi preconditioner\");\r\n"]
[6451.349887, "o", "\u001b[32m\u001b[K855\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (omega <= 0.0 || omega >= 2.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid SSOR parameter\");\r\n\u001b[32m\u001b[K860\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!m->symmetric) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"IC(0) requires symmetric matrix\");\r\n"]
[6451.349961, "o", "\u001b[32m\u001b[K867\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void \u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(Precond *p, const double *r, double *z) {\r\n\u001b[32m\u001b[K877\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in Jacobi preconditioner\");\r\n\u001b[32m\u001b[K911\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[KICFactor\u001b[m\u001b[K *ic = p->ic;\r\n\u001b[32m\u001b[K917\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (ic->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero or negative pivot in IC(0) factorization\");\r\n"]
[6451.350032, "o", "\u001b[32m\u001b[K929\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"unknown preconditioner\");\r\n\u001b[32m\u001b[K963\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(p, r, z);\r\n\u001b[32m\u001b[K972\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix is not positive definite\");\r\n\u001b[32m\u001b[K985\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(p, r, z);\r\n\u001b[32m\u001b[K989\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"CG numerical breakdown\");\r\n"]
[6451.350103, "o", "\u001b[32m\u001b[K1021\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K1026\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(p, pvec, z);\r\n\u001b[32m\u001b[K1031\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K1045\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(p, s, z);\r\n\u001b[32m\u001b[K1051\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K1067\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n"]
[6451.350175, "o", "\u001b[32m\u001b[K1111\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(p, V + j * n, Z + j * n);\r\n\u001b[32m\u001b[K1177\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"GMRES numerical breakdown\");\r\n"]
[6451.35025, "o", "\u001b[32m\u001b[K1195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void \u001b[01;31m\u001b[Kwrite_vector\u001b[m\u001b[K(const char *filename, int n, const double *x) {\r\n\u001b[32m\u001b[K1199\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output vector file\");\r\n"]
[6451.350321, "o", "\u001b[32m\u001b[K1204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1220\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output vector file\");\r\n\u001b[32m\u001b[K1225\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!s || !*s) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument\");\r\n\u001b[32m\u001b[K1242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (errno != 0 || end == s || *end != '\\0') \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid integer argument\");\r\n"]
[6451.350399, "o", "\u001b[32m\u001b[K1243\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (val < INT_MIN || val > INT_MAX) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"integer argument out of range\");\r\n\u001b[32m\u001b[K1248\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!s || !*s) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument\");\r\n\u001b[32m\u001b[K1252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (errno != 0 || end == s || *end != '\\0') \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid numeric argument\");\r\n\u001b[32m\u001b[K1256\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstatic void die\u001b[m\u001b[K_unknown(const char *kind, const char *value) {\r\n\u001b[32m\u001b[K1259\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[Kmsg);\r\n\u001b[32m\u001b[K1283\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --input\");\r\n"]
