[3344.999589, "o", "        }\r\n        double beta = (rho_new / rho_old) * (alpha / omega);\r\n        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n        rho_old = rho_new;\r\n    }\r\n\r\n    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n    return x;\r\n"]
[3344.999718, "o", "}\r\n\r\nstatic void write_vector(const char *filename, int n, const double *x) {\r\n    FILE *f = stdout;\r\n    if (filename) {\r\n        f = fopen(filename, \"w\");\r\n        if (!f) die(\"cannot open output vector file\");\r\n    }\r\n\r\n    if (fprintf(f, \"%d\r\n\", n) < 0) {\r\n        if (filename) fclose(f);\r\n        die(\"failed to write vector\");\r\n    }\r\n    for (int i = 0; i < n; i++) {\r\n        if (fprintf(f, \"%.15g\r\n\", x[i]) < 0) {\r\n            if (filename) fclose(f);\r\n            die(\"failed to write vector\");\r\n"]
