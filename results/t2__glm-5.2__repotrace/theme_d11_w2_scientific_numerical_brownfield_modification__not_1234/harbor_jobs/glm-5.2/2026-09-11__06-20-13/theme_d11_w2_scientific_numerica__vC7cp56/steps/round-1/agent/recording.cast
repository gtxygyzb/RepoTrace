[3652.538471, "o", "    CSRMatrix *p = xmalloc(sizeof(CSRMatrix));\r\n    p->n = n;\r\n    p->nnz = nnz;\r\n    p->row_ptr = row_ptr;\r\n    p->col_idx = col_idx;\r\n    p->vals = vals;\r\n    p->symmetric = m->symmetric;\r\n    return p;\r\n"]
[3652.538585, "o", "}\r\n\r\nstatic void build_adjacency(const CSRMatrix *m, int **adj_ptr, int **adj_count, int **adj_data) {\r\n    int n = m->n;\r\n    int *degree = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int j = m->col_idx[idx];\r\n            if (j != i) degree[i]++;\r\n        }\r\n"]
[3652.538717, "o", "    }\r\n    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + degree[i];\r\n    int *adj = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n    int *next = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int j = m->col_idx[idx];\r\n            if (j != i) adj[row_ptr[i] + next[i]++] = j;\r\n        }\r\n    }\r\n    free(next);\r\n    free(degree);\r\n    *adj_ptr = row_ptr;\r\n    *adj_count = xcalloc((size_t)n, sizeof(int));\r\n    *adj_data = adj;\r\n}\r\n\r\nstatic void rcm_ordering(const CSRMatrix *m, int *perm) {\r\n    int n = m->n;\r\n    int *adj_ptr, *adj_count, *adj;\r\n"]
[3652.538798, "o", "    build_adjacency(m, &adj_ptr, &adj_count, &adj);\r\n\r\n    int *degree = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) degree[i] = adj_ptr[i + 1] - adj_ptr[i];\r\n\r\n    int *visited = xcalloc((size_t)n, sizeof(int));\r\n    int *order = xmalloc((size_t)n * sizeof(int));\r\n    int order_count = 0;\r\n    int *queue = xmalloc((size_t)n * sizeof(int));\r\n    int qhead = 0, qtail = 0;\r\n\r\n    while (order_count < n) {\r\n        int start = -1;\r\n        for (int i = 0; i < n; i++) {\r\n            if (!visited[i]) {\r\n                if (start == -1 || degree[i] < degree[start] ||\r\n                    (degree[i] == degree[start] && i < start)) {\r\n                    start = i;\r\n                }\r\n            }\r\n        }\r\n        if (start == -1) break;\r\n        visited[start] = 1;\r\n        queue[qtail++] = start;\r\n        while (qhead < qtail) {\r\n            int v = queue[qhead++];\r\n            order[order_count++] = v;\r\n            int base = adj_ptr[v];\r\n            int deg = adj_ptr[v + 1] - base;\r\n    "]
[3652.538929, "o", "        int *nbrs = xmalloc((size_t)(deg ? deg : 1) * sizeof(int));\r\n            int cnt = 0;\r\n            for (int idx = 0; idx < deg; idx++) {\r\n                int u = adj[base + idx];\r\n                if (!visited[u]) nbrs[cnt++] = u;\r\n            }\r\n            // deterministic sort by degree then original index\r\n            for (int a = 1; a < cnt; a++) {\r\n                int key = nbrs[a];\r\n                int b = a - 1;\r\n                while (b >= 0) {\r\n                    if (degree[nbrs[b]] < degree[key] ||\r\n                        (degree[nbrs[b]] == degree[key] && nbrs[b] < key)) break;\r\n                    nbrs[b + 1] = nbrs[b];\r\n                    b--;\r\n                }\r\n                nbrs[b + 1] = key;\r\n            }\r\n            for (int idx = 0; idx < cnt; idx++) {\r\n                int u = nbrs[idx];\r\n                if (!visited[u]) {\r\n                    visited[u] = 1;\r\n                    queue[qtail++] = u;\r\n                }\r\n            }\r\n            free(nbrs);\r\n        }\r\n    }\r"]
[3652.539004, "o", "\n\r\n    for (int i = 0; i < n; i++) perm[order[n - 1 - i]] = i;\r\n\r\n    free(adj_ptr);\r\n    free(adj_count);\r\n    free(adj);\r\n    free(degree);\r\n    free(visited);\r\n    free(order);\r\n    free(queue);\r\n}\r\n\r\nstatic TriMatrix *build_lower_triangular(const CSRMatrix *m) {\r\n    int n = m->n;\r\n    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n"]
[3652.539082, "o", "            if (m->col_idx[idx] <= i) row_ptr[i + 1]++;\r\n        }\r\n    }\r\n    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];\r\n\r\n    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));\r\n    int *next = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int j = m->col_idx[idx];\r\n            if (j <= i) {\r\n                int pos = row_ptr[i] + next[i]++;\r\n                col_idx[pos] = j;\r\n                vals[pos] = m->vals[idx];\r\n            }\r\n"]
[3652.53915, "o", "        }\r\n    }\r\n    free(next);\r\n\r\n    TriMatrix *t = xmalloc(sizeof(TriMatrix));\r\n    t->n = n;\r\n    t->row_ptr = row_ptr;\r\n    t->col_idx = col_idx;\r\n    t->vals = vals;\r\n    return t;\r\n}\r\n\r\nstatic TriMatrix *build_upper_triangular(const CSRMatrix *m) {\r\n    int n = m->n;\r\n    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n"]
[3652.539227, "o", "    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            if (m->col_idx[idx] >= i) row_ptr[i + 1]++;\r\n        }\r\n    }\r\n    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];\r\n\r\n    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));\r\n    int *next = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int j = m->col_idx[idx];\r\n            if (j >= i) {\r\n                int pos = row_ptr[i] + next[i]++;\r\n                col_idx[pos] = j;\r\n"]
[3652.539295, "o", "                vals[pos] = m->vals[idx];\r\n            }\r\n        }\r\n    }\r\n    free(next);\r\n\r\n    TriMatrix *t = xmalloc(sizeof(TriMatrix));\r\n    t->n = n;\r\n    t->row_ptr = row_ptr;\r\n    t->col_idx = col_idx;\r\n    t->vals = vals;\r\n    return t;\r\n}\r\n\r\n"]
[3652.539373, "o", "static void free_tri_matrix(TriMatrix *t) {\r\n    if (!t) return;\r\n    free(t->row_ptr);\r\n    free(t->col_idx);\r\n    free(t->vals);\r\n    free(t);\r\n}\r\n\r\nstatic ICFactor *ic0_factorize(const CSRMatrix *m) {\r\n    int n = m->n;\r\n    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            if (m->col_idx[idx] < i) row_ptr[i + 1]++;\r\n        }\r\n    }\r\n    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];\r\n\r\n    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n"]
[3652.539447, "o", "    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));\r\n    int *next = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int j = m->col_idx[idx];\r\n            if (j < i) col_idx[row_ptr[i] + next[i]++] = j;\r\n        }\r\n    }\r\n    free(next);\r\n\r\n    double *diag = xmalloc((size_t)n * sizeof(double));\r\n    for (int i = 0; i < n; i++) {\r\n        double aii = 0.0;\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n"]
[3652.53952, "o", "            if (m->col_idx[idx] == i) aii += m->vals[idx];\r\n        }\r\n\r\n        double sum = aii;\r\n        for (int k = row_ptr[i]; k < row_ptr[i + 1]; k++) {\r\n            int j = col_idx[k];\r\n            double aij = 0.0;\r\n            for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n"]
[3652.539595, "o", "                if (m->col_idx[idx] == j) {\r\n                    aij += m->vals[idx];\r\n                    break;\r\n                }\r\n            }\r\n\r\n            double s = aij;\r\n            int pi = row_ptr[i];\r\n            int pj = row_ptr[j];\r\n            while (pi < k && pj < row_ptr[j + 1]) {\r\n                int ci = col_idx[pi];\r\n                int cj = col_idx[pj];\r\n                if (ci == cj) {\r\n                    s -= vals[pi] * vals[pj];\r\n                    pi++;\r\n                    pj++;\r\n                } else if (ci < cj) {\r\n                    pi++;\r\n                } else {\r\n                    pj++;\r\n                }\r\n            }\r\n"]
[3652.539692, "o", "\r\n            if (diag[j] <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n            double l = s / diag[j];\r\n            vals[k] = l;\r\n            sum -= l * l;\r\n        }\r\n\r\n        if (sum <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n        diag[i] = sqrt(sum);\r\n    }\r\n\r\n    ICFactor *ic = xmalloc(sizeof(ICFactor));\r\n    ic->n = n;\r\n    ic->l_row_ptr = row_ptr;\r\n    ic->l_col_idx = col_idx;\r\n    ic->l_vals = vals;\r\n    ic->diag = diag;\r\n    ic->u_row_ptr = NULL;\r\n    ic->u_col_idx = NULL;\r\n    ic->u_vals = NULL;\r\n    return ic;\r\n}\r\n\r\nstatic Precond *precond_setup(CSRMatrix *m, int type, double omega) {"]
[3652.539787, "o", "\r\n    Precond *p = xmalloc(sizeof(Precond));\r\n    p->type = type;\r\n    p->A = m;\r\n    p->diag = NULL;\r\n    p->lower = NULL;\r\n    p->upper = NULL;\r\n    p->omega = omega;\r\n    p->ic = NULL;\r\n\r\n    if (type == PRECOND_JACOBI) {\r\n        p->diag = compute_diag(m);\r\n        for (int i = 0; i < m->n; i++) {\r\n            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n        }\r\n    } else if (type == PRECOND_SSOR) {\r\n        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n        p->diag = compute_diag(m);\r\n        for (int i = 0; i < m->n; i++) {\r\n"]
[3652.539855, "o", "            if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\r\n        }\r\n        p->lower = build_lower_triangular(m);\r\n        p->upper = build_upper_triangular(m);\r\n    } else if (type == PRECOND_IC0) {\r\n        if (!m->symmetric) die(\"IC(0) requires symmetric matrix\");\r\n        p->ic = ic0_factorize(m);\r\n    }\r\n\r\n    return p;\r\n}\r\n\r\n"]
[3652.539926, "o", "static void precond_apply(Precond *p, const double *r, double *z) {\r\n    int n = p->A->n;\r\n\r\n    if (p->type == PRECOND_NONE) {\r\n        dcopy(n, r, z);\r\n        return;\r\n    }\r\n\r\n    if (p->type == PRECOND_JACOBI) {\r\n        for (int i = 0; i < n; i++) {\r\n            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n            z[i] = r[i] / p->diag[i];\r\n        }\r\n        return;\r\n    }\r\n"]
[3652.540002, "o", "\r\n    if (p->type == PRECOND_SSOR) {\r\n        dcopy(n, r, z);\r\n        for (int i = 0; i < n; i++) {\r\n            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\r\n                int j = p->lower->col_idx[idx];\r\n                if (j < i) z[i] -= p->lower->vals[idx] * z[j];\r\n            }\r\n            if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\r\n            z[i] /= p->diag[i];\r\n        }\r\n        for (int i = n - 1; i >= 0; i--) {\r\n            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\r\n                int j = p->upper->col_idx[idx];\r\n                if (j > i) z[i] -= p->upper->vals[idx] * z[j];\r\n            }\r\n            if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\r\n"]
[3652.540078, "o", "            z[i] /= p->diag[i];\r\n        }\r\n        return;\r\n    }\r\n\r\n    if (p->type == PRECOND_IC0) {\r\n        ICFactor *ic = p->ic;\r\n        for (int i = 0; i < n; i++) {\r\n            double s = r[i];\r\n            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];\r\n            }\r\n            if (ic->diag[i] == 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n            z[i] = s / ic->diag[i];\r\n        }\r\n        for (int i = n - 1; i >= 0; i--) {\r\n"]
[3652.540147, "o", "            z[i] /= ic->diag[i];\r\n            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];\r\n            }\r\n        }\r\n        return;\r\n    }\r\n\r\n    die(\"unknown preconditioner\");\r\n}\r\n\r\nstatic void free_precond(Precond *p) {\r\n    if (!p) return;\r\n    free(p->diag);\r\n    free_tri_matrix(p->lower);\r\n    free_tri_matrix(p->upper);\r\n    if (p->ic) {\r\n"]
[3652.540215, "o", "        free(p->ic->l_row_ptr);\r\n        free(p->ic->l_col_idx);\r\n        free(p->ic->l_vals);\r\n        free(p->ic->diag);\r\n        free(p->ic->u_row_ptr);\r\n        free(p->ic->u_col_idx);\r\n        free(p->ic->u_vals);\r\n        free(p->ic);\r\n    }\r\n    free(p);\r\n}\r\n\r\nstatic double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol) {\r\n    int n = A->n;\r\n    double *x = xcalloc((size_t)n, sizeof(double));\r\n"]
[3652.540287, "o", "    double *r = xmalloc((size_t)n * sizeof(double));\r\n    double *z = xmalloc((size_t)n * sizeof(double));\r\n    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n\r\n    spmv(A, x, r);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n    double bnorm = vec_norm2(n, b);\r\n    if (bnorm == 0.0) {\r\n        free(r); free(z); free(pvec); free(Ap);\r\n"]
[3652.540861, "o", "\u001b[?2004h"]
[3652.540936, "o", "root@n30009:/app# "]
[3652.812721, "i", "sed -n '900,1260p' nlsolve.c\n"]
[3652.813001, "o", "sed -n '900,1260p' nlsolve.c\r\n\u001b[?2004l\r"]
[3652.81614, "o", "        free(r); free(z); free(pvec); free(Ap);\r\n        return x;\r\n    }\r\n\r\n    precond_apply(p, r, z);\r\n    dcopy(n, z, pvec);\r\n    double rz_old = dot(n, r, z);\r\n"]
[3652.816282, "o", "\r\n    for (int it = 0; it < max_it; it++) {\r\n        spmv(A, pvec, Ap);\r\n        double pAp = dot(n, pvec, Ap);\r\n        if (pAp <= 0.0) {\r\n            free(r); free(z); free(pvec); free(Ap);\r\n            die(\"matrix is not positive definite\");\r\n        }\r\n        double alpha = rz_old / pAp;\r\n        for (int i = 0; i < n; i++) {\r\n            x[i] += alpha * pvec[i];\r\n            r[i] -= alpha * Ap[i];\r\n        }\r\n        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n\r\n        precond_apply(p, r, z);\r\n        double rz_new = dot(n, r, z);\r\n        if (rz_old == 0.0) {\r\n            free(r); free(z); free(pvec); free(Ap);\r\n            die(\"CG numerical breakdown\");\r\n        }\r\n        double beta = rz_new / rz_old;\r\n        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n        rz_old = rz_new;\r\n    }\r\n\r\n    free(r); free(z); free(pvec); free(Ap);\r\n    return x;\r\n}\r\n\r\n"]
[3652.816369, "o", "static double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol) {\r\n    int n = A->n;\r\n    double *x = xcalloc((size_t)n, sizeof(double));\r\n    double *r = xmalloc((size_t)n * sizeof(double));\r\n    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n    double *v = xmalloc((size_t)n * sizeof(double));\r\n    double *s = xmalloc((size_t)n * sizeof(double));\r\n    double *t = xmalloc((size_t)n * sizeof(double));\r\n    double *z = xmalloc((size_t)n * sizeof(double));\r\n\r\n    spmv(A, x, r);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n    double bnorm = vec_norm2(n, b);\r\n    if (bnorm == 0.0) {\r\n        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n        return x;\r\n"]
[3652.81649, "o", "    }\r\n\r\n    dcopy(n, r, r0);\r\n    double rho_old = dot(n, r0, r);\r\n    if (rho_old == 0.0) {\r\n        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n        die(\"BiCGSTAB numerical breakdown\");\r\n    }\r\n    dcopy(n, r, pvec);\r\n\r\n    for (int it = 0; it < max_it; it++) {\r\n        precond_apply(p, pvec, z);\r\n        spmv(A, z, v);\r\n        double r0v = dot(n, r0, v);\r\n        if (r0v == 0.0) {\r\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n            die(\"BiCGSTAB numerical breakdown\");\r\n        }\r\n        double alpha = rho_old / r0v;\r\n        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n\r\n        if (vec_norm2(n, s) <= tol * bnorm) {\r\n            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n            break;\r\n        }\r\n\r\n        precond_apply(p, s, z);\r\n"]
[3652.816582, "o", "        spmv(A, z, t);\r\n        double ts = dot(n, t, s);\r\n        double tt = dot(n, t, t);\r\n        if (tt == 0.0) {\r\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n            die(\"BiCGSTAB numerical breakdown\");\r\n        }\r\n        double omega = ts / tt;\r\n        for (int i = 0; i < n; i++) {\r\n            x[i] += alpha * z[i] + omega * s[i];\r\n"]
[3652.816665, "o", "            r[i] = s[i] - omega * t[i];\r\n        }\r\n\r\n        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n\r\n        double rho_new = dot(n, r0, r);\r\n        if (rho_new == 0.0) {\r\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n            die(\"BiCGSTAB numerical breakdown\");\r\n        }\r\n        double beta = (rho_new / rho_old) * (alpha / omega);\r\n        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n        rho_old = rho_new;\r\n    }\r\n\r\n    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n    return x;\r\n}\r\n\r\nstatic void write_vector(const char *filename, int n, const double *x) {\r\n    FILE *f = stdout;\r\n    if (filename) {\r\n"]
[3652.81674, "o", "        f = fopen(filename, \"w\");\r\n        if (!f) die(\"cannot open output vector file\");\r\n    }\r\n\r\n    if (fprintf(f, \"%d\\n\", n) < 0) {\r\n        if (filename) fclose(f);\r\n        die(\"failed to write vector\");\r\n    }\r\n    for (int i = 0; i < n; i++) {\r\n        if (fprintf(f, \"%.15g\\n\", x[i]) < 0) {\r\n            if (filename) fclose(f);\r\n            die(\"failed to write vector\");\r\n        }\r\n    }\r\n\r\n"]
[3652.816819, "o", "    if (filename) fclose(f);\r\n}\r\n\r\nstatic int parse_int_arg(const char *s) {\r\n    if (!s || !*s) die(\"missing argument\");\r\n    errno = 0;\r\n    char *end;\r\n    long val = strtol(s, &end, 10);\r\n    if (errno != 0 || end == s || *end != '\\0') die(\"invalid integer argument\");\r\n    if (val < INT_MIN || val > INT_MAX) die(\"integer argument out of range\");\r\n    return (int)val;\r\n}\r\n\r\nstatic double parse_double_arg(const char *s) {\r\n    if (!s || !*s) die(\"missing argument\");\r\n    errno = 0;\r\n    char *end;\r\n"]
[3652.816887, "o", "    double val = strtod(s, &end);\r\n    if (errno != 0 || end == s || *end != '\\0') die(\"invalid numeric argument\");\r\n    return val;\r\n}\r\n\r\nstatic void die_unknown(const char *kind, const char *value) {\r\n    char msg[256];\r\n    snprintf(msg, sizeof(msg), \"unknown %s: %s\", kind, value);\r\n    die(msg);\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n    const char *input = NULL;\r\n"]
[3652.81696, "o", "    const char *rhs = NULL;\r\n    const char *solver_name = NULL;\r\n    const char *precond_name = NULL;\r\n    const char *reorder_name = NULL;\r\n    const char *output = NULL;\r\n    const char *gen2d = NULL;\r\n    const char *gen3d = NULL;\r\n    const char *genrhs = NULL;\r\n    int analyze = 0;\r\n    int max_it = 1000;\r\n    double tol = 1e-8;\r\n    double omega = 1.0;\r\n\r\n    for (int i = 1; i < argc; i++) {\r\n"]
[3652.817039, "o", "        const char *arg = argv[i];\r\n        if (strcmp(arg, \"--input\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --input\");\r\n            input = argv[i];\r\n        } else if (strcmp(arg, \"--rhs\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --rhs\");\r\n            rhs = argv[i];\r\n        } else if (strcmp(arg, \"--solver\") == 0) {\r\n            if (++i >= argc) die(\"missing solver name\");\r\n            solver_name = argv[i];\r\n        } else if (strcmp(arg, \"--precond\") == 0) {\r\n            if (++i >= argc) die(\"missing preconditioner name\");\r\n            precond_name = argv[i];\r\n        } else if (strcmp(arg, \"--reorder\") == 0) {\r\n"]
[3652.817116, "o", "            if (++i >= argc) die(\"missing reordering name\");\r\n            reorder_name = argv[i];\r\n        } else if (strcmp(arg, \"--output\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --output\");\r\n            output = argv[i];\r\n        } else if (strcmp(arg, \"--analyze\") == 0) {\r\n            analyze = 1;\r\n        } else if (strcmp(arg, \"--generate-laplacian\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --generate-laplacian\");\r\n            gen2d = argv[i];\r\n        } else if (strcmp(arg, \"--generate-laplacian3d\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --generate-laplacian3d\");\r\n            gen3d = argv[i];\r\n"]
[3652.817244, "o", "        } else if (strcmp(arg, \"--generate-rhs\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --generate-rhs\");\r\n            genrhs = argv[i];\r\n        } else if (strcmp(arg, \"--max-it\") == 0 || strcmp(arg, \"--max-iter\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for max iterations\");\r\n            max_it = parse_int_arg(argv[i]);\r\n        } else if (strcmp(arg, \"--tol\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for tolerance\");\r\n            tol = parse_double_arg(argv[i]);\r\n        } else if (strcmp(arg, \"--omega\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for omega\");\r\n            omega = parse_double_arg(argv[i]);\r\n        } else {\r\n            char msg[256];\r\n            snprintf(msg, sizeof(msg), \"unknown option: %s\", arg);\r\n            die(msg);\r\n        }\r\n    }\r\n\r\n    int modes = 0;\r\n    if (analyze) modes++;\r\n    if (solver_name) modes++;\r\n    if (gen2d) modes++;\r\n    if (gen3d) modes++;\r\n    if (genrhs) modes++;\r\n"]
[3652.817319, "o", "    if (modes == 0) die(\"no operation specified\");\r\n    if (modes > 1) die(\"conflicting operation modes specified\");\r\n\r\n    if (gen2d || gen3d || genrhs) {\r\n        if (input || rhs || solver_name || precond_name || reorder_name) {\r\n            die(\"conflicting command-line arguments\");\r\n        }\r\n        if (!output) die(\"missing output file for generator\");\r\n\r\n        if (gen2d) {\r\n            int n = parse_int_arg(gen2d);\r\n            if (n <= 0) die(\"invalid generator size\");\r\n            long N = (long)n * (long)n;\r\n"]
[3652.817388, "o", "            if (N > INT_MAX / 3) die(\"generator size too large\");\r\n            generate_laplacian2d(n, output);\r\n        } else if (gen3d) {\r\n            int n = parse_int_arg(gen3d);\r\n            if (n <= 0) die(\"invalid generator size\");\r\n            long N = (long)n * (long)n * (long)n;\r\n            if (N > INT_MAX / 4) die(\"generator size too large\");\r\n            generate_laplacian3d(n, output);\r\n        } else {\r\n            int N = parse_int_arg(genrhs);\r\n            if (N <= 0) die(\"invalid generator size\");\r\n            generate_rhs(N, output);\r\n        }\r\n"]
[3652.81746, "o", "        return 0;\r\n    }\r\n\r\n    if (analyze) {\r\n        if (!input) die(\"missing input file for analyze\");\r\n        if (rhs || solver_name || precond_name || reorder_name || output) {\r\n            die(\"conflicting command-line arguments\");\r\n        }\r\n"]
[3652.817537, "o", "        CSRMatrix *m = read_matrix(input);\r\n        analyze_matrix(m);\r\n        free_csr(m);\r\n        return 0;\r\n    }\r\n\r\n    if (!input) die(\"missing input file for solver\");\r\n    if (!rhs) die(\"missing rhs file for solver\");\r\n    if (!solver_name) die(\"missing solver name\");\r\n\r\n    int solver;\r\n    if (strcmp(solver_name, \"cg\") == 0) solver = SOLVER_CG;\r\n    else if (strcmp(solver_name, \"bicgstab\") == 0) solver = SOLVER_BICGSTAB;\r\n    else die_unknown(\"solver\", solver_name);\r\n\r\n    int precond = PRECOND_NONE;\r\n    if (precond_name) {\r\n        if (strcmp(precond_name, \"none\") == 0) precond = PRECOND_NONE;\r\n        else if (strcmp(precond_name, \"jacobi\") == 0) precond = PRECOND_JACOBI;\r\n        else if (strcmp(precond_name, \"ssor\") == 0) precond = PRECOND_SSOR;\r\n        else if (strcmp(precond_name, \"ic0\") == 0) precond = PRECOND_IC0;\r\n"]
[3652.817611, "o", "        else die_unknown(\"preconditioner\", precond_name);\r\n    }\r\n\r\n    int reorder = 0;\r\n    if (reorder_name) {\r\n        if (strcmp(reorder_name, \"none\") == 0) reorder = 0;\r\n        else if (strcmp(reorder_name, \"rcm\") == 0) reorder = 1;\r\n        else die_unknown(\"reordering\", reorder_name);\r\n    }\r\n\r\n    if (max_it <= 0) die(\"invalid max iterations\");\r\n    if (tol < 0.0) die(\"invalid tolerance\");\r\n\r\n"]
[3652.817694, "o", "    CSRMatrix *m = read_matrix(input);\r\n    int rhs_n;\r\n    double *b = read_vector(rhs, &rhs_n);\r\n    if (m->n != rhs_n) {\r\n        free_csr(m);\r\n        free(b);\r\n        die(\"matrix and RHS dimensions do not match\");\r\n    }\r\n\r\n"]
[3652.817763, "o", "    int n = m->n;\r\n    CSRMatrix *A = m;\r\n    double *bwork = b;\r\n    int *perm = NULL;\r\n\r\n    if (reorder) {\r\n        perm = xmalloc((size_t)n * sizeof(int));\r\n        rcm_ordering(m, perm);\r\n        A = permute_csr(m, perm);\r\n        bwork = xmalloc((size_t)n * sizeof(double));\r\n        for (int i = 0; i < n; i++) bwork[perm[i]] = b[i];\r\n        free_csr(m);\r\n        m = A;\r\n    }\r\n\r\n    Precond *p = precond_setup(A, precond, omega);\r\n    double *x2;\r\n    if (solver == SOLVER_CG) x2 = solve_cg(A, bwork, p, max_it, tol);\r\n    else x2 = solve_bicgstab(A, bwork, p, max_it, tol);\r\n\r\n"]
[3652.817838, "o", "    double *x;\r\n    if (perm) {\r\n        x = xmalloc((size_t)n * sizeof(double));\r\n        for (int i = 0; i < n; i++) x[i] = x2[perm[i]];\r\n        free(x2);\r\n        free(bwork);\r\n        free(perm);\r\n    } else {\r\n        x = x2;\r\n    }\r\n\r\n    write_vector(output, n, x);\r\n\r\n    free(x);\r\n    free_precond(p);\r\n    free_csr(A);\r\n    free(b);\r\n"]
[3652.81791, "o", "    return 0;\r\n}\r\n"]
