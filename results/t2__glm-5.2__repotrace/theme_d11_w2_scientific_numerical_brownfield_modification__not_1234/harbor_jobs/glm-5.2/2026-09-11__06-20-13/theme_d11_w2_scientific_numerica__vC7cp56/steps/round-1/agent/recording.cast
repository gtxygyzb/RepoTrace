[5550.46652, "o", "nl -ba nlsolve.c | sed -n '954,1031p'\r\n"]
[5550.466663, "o", "\u001b[?2004l\r"]
[5550.471042, "o", "   954\tstatic double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n   955\t    int n = A->n;\r\n   956\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n   957\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n   958\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n   959\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n   960\t    double *v = xmalloc((size_t)n * sizeof(double));\r\n"]
[5550.471139, "o", "   961\t    double *s = xmalloc((size_t)n * sizeof(double));\r\n   962\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n   963\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   964\t\r\n   965\t    spmv(A, x, r);\r\n   966\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   967\t    double bnorm = vec_norm2(n, b);\r\n   968\t    int it_count = 0;\r\n   969\t\r\n   970\t    dcopy(n, r, r0);\r\n   971\t    double rho_old = dot(n, r0, r);\r\n   972\t    if (rho_old == 0.0) {\r\n   973\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   974\t        die(\"BiCGSTAB numerical breakdown\");\r\n   975\t    }\r\n   976\t    dcopy(n, r, pvec);\r\n"]
[5550.471201, "o", "   977\t\r\n   978\t    for (int it = 0; it < max_it; it++) {\r\n   979\t        precond_apply(p, pvec, z);\r\n   980\t        spmv(A, z, v);\r\n   981\t        double r0v = dot(n, r0, v);\r\n   982\t        if (r0v == 0.0) {\r\n   983\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   984\t            die(\"BiCGSTAB numerical breakdown\");\r\n   985\t        }\r\n   986\t        double alpha = rho_old / r0v;\r\n"]
[5550.471259, "o", "   987\t        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n   988\t\r\n   989\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n   990\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n   991\t            it_count = it + 1;\r\n   992\t            if (history) {\r\n   993\t                printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, s));\r\n   994\t            }\r\n   995\t            break;\r\n   996\t        }\r\n"]
[5550.471314, "o", "   997\t\r\n   998\t        precond_apply(p, s, z);\r\n   999\t        spmv(A, z, t);\r\n  1000\t        double ts = dot(n, t, s);\r\n  1001\t        double tt = dot(n, t, t);\r\n  1002\t        if (tt == 0.0) {\r\n  1003\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n"]
[5550.47137, "o", "  1004\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1005\t        }\r\n  1006\t        double omega = ts / tt;\r\n  1007\t        for (int i = 0; i < n; i++) {\r\n  1008\t            x[i] += alpha * z[i] + omega * s[i];\r\n  1009\t            r[i] = s[i] - omega * t[i];\r\n  1010\t        }\r\n  1011\t        it_count = it + 1;\r\n  1012\t        if (history) {\r\n  1013\t"]
[5550.471421, "o", "            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n  1014\t        }\r\n  1015\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n  1016\t\r\n  1017\t        double rho_new = dot(n, r0, r);\r\n  1018\t        if (rho_new == 0.0) {\r\n  1019\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n"]
[5550.471474, "o", "  1020\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1021\t        }\r\n  1022\t        double beta = (rho_new / rho_old) * (alpha / omega);\r\n  1023\t        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n  1024\t        rho_old = rho_new;\r\n  1025\t    }\r\n  1026\t\r\n  1027\t    if (iterations_out) *iterations_out = it_count;\r\n  1028\t    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n"]
