[5464.866923, "o", "        die(\"only real coordinate matrices are supported\");\r\n   204\t    }\r\n   205\t\r\n   206\t    int symmetric;\r\n   207\t    if (strcmp(sym, \"symmetric\") == 0) symmetric = 1;\r\n   208\t    else if (strcmp(sym, \"general\") == 0) symmetric = 0;\r\n   209\t    else {\r\n   210\t        fclose(f);\r\n   211\t        die(\"only symmetric or general matrices are supported\");\r\n   212\t    }"]
