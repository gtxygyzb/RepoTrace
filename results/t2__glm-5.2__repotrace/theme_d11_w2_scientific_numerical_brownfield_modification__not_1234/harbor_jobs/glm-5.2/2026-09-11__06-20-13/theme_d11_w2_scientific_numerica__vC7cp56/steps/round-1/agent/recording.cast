[1845.726326, "o", "sed -n '260,560p' nlsolve.c\r\n\u001b[?2004l\r"]
[1845.729412, "o", "    FILE *f = fopen(filename, \"r\");\r\n    if (!f) die(\"cannot open rhs file\");\r\n    int n;\r\n    if (fscanf(f, \"%d\", &n) != 1) {\r\n        fclose(f);\r\n        die(\"failed to read vector dimension\");\r\n    }\r\n    if (n <= 0) die(\"invalid vector dimension\");\r\n    double *x = xmalloc((size_t)n * sizeof(double));\r\n    for (int i = 0; i < n; i++) {\r\n        if (fscanf(f, \"%lf\", &x[i]) != 1) {\r\n            fclose(f);\r\n            free(x);\r\n"]
[1845.729544, "o", "            die(\"failed to read vector entry\");\r\n        }\r\n    }\r\n    fclose(f);\r\n    *n_out = n;\r\n    return x;\r\n}\r\n\r\nstatic void write_matrix_market(const char *filename, int n, int nnz, Entry *entries) {\r\n    FILE *f = fopen(filename, \"w\");\r\n    if (!f) die(\"cannot open output matrix file\");\r\n    fprintf(f, \"%%%%MatrixMarket matrix coordinate real symmetric\\n\");\r\n    fprintf(f, \"%d %d %d\\n\", n, n, nnz);\r\n    for (int k = 0; k < nnz; k++) {\r\n        fprintf(f, \"%d %d %.15g\\n\", entries[k].r + 1, entries[k].c + 1, entries[k].v);\r\n    }\r\n    fclose(f);\r\n}\r\n\r\nstatic int cmp_entry_rc(const void *a, const void *b) {\r\n    const Entry *ea = (const Entry *)a;\r\n    const Entry *eb = (const Entry *)b;\r\n    if (ea->r != eb->r) return ea->r - eb->r;\r\n    return ea->c - eb->c;\r\n}\r\n\r\n"]
[1845.729715, "o", "static void generate_laplacian2d(int n, const char *output) {\r\n    int N = n * n;\r\n    int cap = N * 3;\r\n    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));\r\n    int count = 0;\r\n    for (int i = 0; i < n; i++) {\r\n        for (int j = 0; j < n; j++) {\r\n            int row = i * n + j;\r\n            entries[count].r = row;\r\n            entries[count].c = row;\r\n            entries[count].v = 4.0;\r\n            count++;\r\n            if (j > 0) {\r\n                int col = i * n + (j - 1);\r\n                entries[count].r = row;\r\n                entries[count].c = col;\r\n                entries[count].v = -1.0;\r\n                count++;\r\n            }\r\n            if (i > 0) {\r\n                int col = (i - 1) * n + j;\r\n                entries[count].r = row;\r\n"]
[1845.729829, "o", "                entries[count].c = col;\r\n                entries[count].v = -1.0;\r\n                count++;\r\n            }\r\n        }\r\n    }\r\n    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);\r\n    write_matrix_market(output, N, count, entries);\r\n    free(entries);\r\n}\r\n\r\nstatic void generate_laplacian3d(int n, const char *output) {\r\n    int N = n * n * n;\r\n    int cap = N * 4;\r\n    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));\r\n    int count = 0;\r\n    for (int i = 0; i < n; i++) {\r\n        for (int j = 0; j < n; j++) {\r\n            for (int k = 0; k < n; k++) {\r\n                int row = (i * n + j) * n + k;\r\n                entries[count].r = row;\r\n                entries[count].c = row;\r\n                entries[count].v = 6.0;\r\n                count++;\r\n                if (k > 0) {\r\n                    int col = row - 1;\r\n                    entries[count].r = row;\r\n                    entries[count].c = col;\r\n                    entries[count].v = -1.0;\r\n                    count++;\r\n"]
[1845.729939, "o", "                }\r\n                if (j > 0) {\r\n                    int col = row - n;\r\n                    entries[count].r = row;\r\n                    entries[count].c = col;\r\n                    entries[count].v = -1.0;\r\n                    count++;\r\n                }\r\n                if (i > 0) {\r\n                    int col = row - n * n;\r\n                    entries[count].r = row;\r\n                    entries[count].c = col;\r\n                    entries[count].v = -1.0;\r\n                    count++;\r\n                }\r\n            }\r\n        }\r\n    }\r\n    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);\r\n    write_matrix_market(output, N, count, entries);\r\n    free(entries);\r\n}\r\n\r\nstatic void generate_rhs(int N, const char *output) {\r\n    FILE *f = fopen(output, \"w\");\r\n    if (!f) die(\"cannot open output rhs file\");\r\n    fprintf(f, \"%d\\n\", N);\r\n    for (int i = 1; i <= N; i++) {\r\n"]
[1845.730026, "o", "        fprintf(f, \"%.15g\\n\", sin((double)i * M_PI / (double)(N + 1)));\r\n    }\r\n    fclose(f);\r\n}\r\n\r\nstatic void free_csr(CSRMatrix *m) {\r\n    if (!m) return;\r\n    free(m->row_ptr);\r\n    free(m->col_idx);\r\n    free(m->vals);\r\n    free(m);\r\n}\r\n\r\nstatic void spmv(const CSRMatrix *m, const double *x, double *y) {\r\n    for (int i = 0; i < m->n; i++) {\r\n        double s = 0.0;\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            s += m->vals[idx] * x[m->col_idx[idx]];\r\n        }\r\n"]
[1845.730109, "o", "        y[i] = s;\r\n    }\r\n}\r\n\r\nstatic double vec_norm2(int n, const double *x) {\r\n    return sqrt(dot(n, x, x));\r\n}\r\n\r\nstatic void analyze_matrix(CSRMatrix *m) {\r\n    double *diag = compute_diag(m);\r\n    int bandwidth = 0;\r\n    long profile = 0;\r\n    int strict_count = 0;\r\n    int weak_all = 1;\r\n\r\n    for (int i = 0; i < m->n; i++) {\r\n        int min_col = i;\r\n        int has_off = 0;\r\n"]
[1845.730198, "o", "        double off_sum = 0.0;\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int j = m->col_idx[idx];\r\n            int diff = i - j;\r\n            if (diff < 0) diff = -diff;\r\n            if (diff > bandwidth) bandwidth = diff;\r\n            if (j < i) {\r\n                if (!has_off || j < min_col) min_col = j;\r\n                has_off = 1;\r\n                off_sum += fabs(m->vals[idx]);\r\n            } else if (j > i) {\r\n                has_off = 1;\r\n                if (j < min_col) min_col = j;\r\n                off_sum += fabs(m->vals[idx]);\r\n            }\r\n        }\r\n        if (has_off) profile += (long)(i - min_col);\r\n\r\n"]
[1845.730281, "o", "        double d = fabs(diag[i]);\r\n        if (d > off_sum + 1e-300) {\r\n            strict_count++;\r\n        } else if (d >= off_sum - 1e-300) {\r\n            // weak candidate\r\n        } else {\r\n            weak_all = 0;\r\n        }\r\n    }\r\n\r\n    const char *dominance;\r\n    if (strict_count == m->n) dominance = \"strict\";\r\n    else if (weak_all) dominance = \"weak\";\r\n    else dominance = \"no\";\r\n\r\n    printf(\"dimension: %d\\n\", m->n);\r\n    printf(\"nonzeros: %d\\n\", m->nnz);\r\n"]
[1845.730371, "o", "    printf(\"symmetric: %s\\n\", m->symmetric ? \"yes\" : \"no\");\r\n    printf(\"bandwidth: %d\\n\", bandwidth);\r\n    printf(\"profile: %ld\\n\", profile);\r\n    printf(\"diag_dominant: %s\\n\", dominance);\r\n    free(diag);\r\n}\r\n\r\nstatic CSRMatrix *permute_csr(const CSRMatrix *m, const int *perm) {\r\n    int n = m->n;\r\n    int *inv = xmalloc((size_t)n * sizeof(int));\r\n    for (int i = 0; i < n; i++) inv[perm[i]] = i;\r\n\r\n    int *counts = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int ni = perm[i];\r\n            counts[ni]++;\r\n        }\r\n    }\r\n\r\n"]
[1845.730461, "o", "    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + counts[i];\r\n    free(counts);\r\n\r\n    int nnz = m->nnz;\r\n    int *col_idx = xmalloc((size_t)nnz * sizeof(int));\r\n    double *vals = xmalloc((size_t)nnz * sizeof(double));\r\n    int *next = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        int ni = perm[i];\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int nj = perm[m->col_idx[idx]];\r\n            int pos = row_ptr[ni] + next[ni]++;\r\n            col_idx[pos] = nj;\r\n            vals[pos] = m->vals[idx];\r\n        }\r\n    }\r\n    free(next);\r\n    free(inv);\r\n\r\n    CSRMatrix *p = xmalloc(sizeof(CSRMatrix));\r\n    p->n = n;\r\n"]
[1845.730548, "o", "    p->nnz = nnz;\r\n    p->row_ptr = row_ptr;\r\n    p->col_idx = col_idx;\r\n    p->vals = vals;\r\n    p->symmetric = m->symmetric;\r\n    return p;\r\n}\r\n\r\nstatic void build_adjacency(const CSRMatrix *m, int **adj_ptr, int **adj_count, int **adj_data) {\r\n    int n = m->n;\r\n    int *degree = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int j = m->col_idx[idx];\r\n            if (j != i) degree[i]++;\r\n        }\r\n    }\r\n    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + degree[i];\r\n    int *adj = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n"]
[1845.73063, "o", "    int *next = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int j = m->col_idx[idx];\r\n            if (j != i) adj[row_ptr[i] + next[i]++] = j;\r\n        }\r\n    }\r\n    free(next);\r\n    free(degree);\r\n    *adj_ptr = row_ptr;\r\n    *adj_count = xcalloc((size_t)n, sizeof(int));\r\n    *adj_data = adj;\r\n}\r\n\r\nstatic int cmp_int_desc_degree(const void *a, const void *b, void *ctx) {\r\n    (void)ctx;\r\n"]
[1845.730732, "o", "    int ia = *(const int *)a;\r\n    int ib = *(const int *)b;\r\n    return ia - ib;\r\n}\r\n\r\nstatic void rcm_ordering(const CSRMatrix *m, int *perm) {\r\n    int n = m->n;\r\n    int *adj_ptr, *adj_count, *adj;\r\n    build_adjacency(m, &adj_ptr, &adj_count, &adj);\r\n\r\n    int *degree = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) degree[i] = adj_ptr[i + 1] - adj_ptr[i];\r\n\r\n    int *visited = xcalloc((size_t)n, sizeof(int));\r\n    int *order = xmalloc((size_t)n * sizeof(int));\r\n    int order_count = 0;\r\n    int *queue = xmalloc((size_t)n * sizeof(int));\r\n"]
[1845.73082, "o", "    int qhead = 0, qtail = 0;\r\n\r\n    while (order_count < n) {\r\n        int start = -1;\r\n        for (int i = 0; i < n; i++) {\r\n            if (!visited[i]) {\r\n                if (start == -1 || degree[i] < degree[start] ||\r\n                    (degree[i] == degree[start] && i < start)) {\r\n                    start = i;\r\n                }\r\n            }\r\n        }\r\n        if (start == -1) break;\r\n        visited[start] = 1;\r\n        queue[qtail++] = start;\r\n"]
[1845.731362, "o", "\u001b[?2004h"]
[1845.731447, "o", "root@n30009:/app# "]
[1846.021537, "i", "sed -n '560,900p' nlsolve.c\n"]
[1846.021827, "o", "sed -n '560,900p' nlsolve.c\r\n\u001b[?2004l\r"]
[1846.025111, "o", "        queue[qtail++] = start;\r\n        while (qhead < qtail) {\r\n            int v = queue[qhead++];\r\n            order[order_count++] = v;\r\n            int base = adj_ptr[v];\r\n            int deg = adj_ptr[v + 1] - base;\r\n            int *nbrs = xmalloc((size_t)(deg ? deg : 1) * sizeof(int));\r\n            int cnt = 0;\r\n"]
[1846.025192, "o", "            for (int idx = 0; idx < deg; idx++) {\r\n                int u = adj[base + idx];\r\n                if (!visited[u]) nbrs[cnt++] = u;\r\n            }\r\n            // deterministic sort by degree then original index\r\n            for (int a = 1; a < cnt; a++) {\r\n                int key = nbrs[a];\r\n                int b = a - 1;\r\n                while (b >= 0) {\r\n                    if (degree[nbrs[b]] < degree[key] ||\r\n                        (degree[nbrs[b]] == degree[key] && nbrs[b] < key)) break;\r\n                    nbrs[b + 1] = nbrs[b];\r\n                    b--;\r\n                }\r\n                nbrs[b + 1] = key;\r\n"]
[1846.025271, "o", "            }\r\n            for (int idx = 0; idx < cnt; idx++) {\r\n                int u = nbrs[idx];\r\n                if (!visited[u]) {\r\n                    visited[u] = 1;\r\n                    queue[qtail++] = u;\r\n                }\r\n            }\r\n            free(nbrs);\r\n        }\r\n"]
[1846.025365, "o", "    }\r\n\r\n    for (int i = 0; i < n; i++) perm[order[n - 1 - i]] = i;\r\n\r\n    free(adj_ptr);\r\n    free(adj_count);\r\n    free(adj);\r\n    free(degree);\r\n    free(visited);\r\n    free(order);\r\n    free(queue);\r\n}\r\n"]
