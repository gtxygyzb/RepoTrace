[3684.512467, "o", "\t        die(\"matrix must be square\");\r\n   234\t    }\r\n   235\t    if (nnz < 0) {\r\n   236\t        fclose(f);\r\n   237\t        die(\"invalid nnz\");\r\n   238\t    }\r\n   239\t\r\n   240\t    Entry *entries = NULL;\r\n   241\t    int count = 0, cap = 0;\r\n   242\t    for (int k = 0; k < nnz; k++) {\r\n   243\t        int r, c;\r\n   244\t        double v;\r\n   245\t        if (fscanf(f, \"%d %d %lf\", &r, &c, &v) != 3) {\r\n   246\t            fclose(f);\r\n   247\t            free(entries);\r\n   248\t            die(\"failed to read matrix entry\");\r\n   249\t        }\r\n   250\t        if (r < 1 || r > rows || c < 1 || c > cols) {\r\n   251\t            fclose(f);\r\n   252\t            free(entries);\r\n   253\t            die(\"matrix entry index out of range\");\r\n   254\t        }\r\n   255\t        r--;\r\n   256\t        c--;\r\n   257\t        if (symmetric) {\r\n   258\t            if (r < c) {\r\n   259\t                int t = r; r = c; c = t;\r\n   260\t"]
[3684.512553, "o", "            }\r\n   261\t            add_entry(&entries, &count, &cap, r, c, v);\r\n   262\t            if (r != c) add_entry(&entries, &count, &cap, c, r, v);\r\n   263\t        } else {\r\n   264\t            add_entry(&entries, &count, &cap, r, c, v);\r\n   265\t        }\r\n   266\t    }\r\n   267\t\r\n   268\t    if (has_trailing_data(f)) {\r\n   269\t        free(entries);\r\n   270\t        fclose(f);\r\n   271\t        die(\"extra trailing data in matrix file\");\r\n   272\t    }\r\n"]
