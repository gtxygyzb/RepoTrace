[6421.707704, "o", "\u001b[32m\u001b[K852\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in Jacobi preconditioner\");\r\n\u001b[32m\u001b[K855\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (omega <= 0.0 || omega >= 2.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid SSOR parameter\");\r\n\u001b[32m\u001b[K859\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else if (type == PRECOND_\u001b[01;31m\u001b[KIC\u001b[m\u001b[K0) {\r\n\u001b[32m\u001b[K860\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!m->symmetric) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"\u001b[01;31m\u001b[KIC\u001b[m\u001b[K(0) requires symmetric matrix\");\r\n\u001b[32m\u001b[K877\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in Jacobi preconditioner\");\r\n"]
[6421.707773, "o", "\u001b[32m\u001b[K910\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (p->type == PRECOND_\u001b[01;31m\u001b[KIC\u001b[m\u001b[K0) {\r\n\u001b[32m\u001b[K911\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[KIC\u001b[m\u001b[KFactor *ic = p->ic;\r\n\u001b[32m\u001b[K917\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (ic->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero or negative pivot in \u001b[01;31m\u001b[KIC\u001b[m\u001b[K(0) factorization\");\r\n\u001b[32m\u001b[K929\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"unknown preconditioner\");\r\n"]
