[5386.574584, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path(\"nlsolve.c\")\ns = path.read_text()\n\nold = '''    if (vec_norm2(n, b) == 0.0) {\n        double *x = xcalloc((size_t)n, sizeof(double));\n        write_zero_vector(output, n, x);\n        printf(\"iterations: 0\\\\n\");\n        printf(\"residual_norm: 0.000000e+00\\\\n\");\n        printf(\"converged: yes\\\\n\");\n        free(x);\n        free_csr(m);\n        free(b);\n        return 0;\n    }'''\nnew = '''    if (vec_norm2(n, b) == 0.0) {\n        write_zero_vector(output, n);\n        printf(\"iterations: 0\\\\n\");\n        printf(\"residual_norm: 0.000000e+00\\\\n\");\n        printf(\"converged: yes\\\\n\");\n        free_csr(m);\n        free(b);\n        return 0;\n    }'''\nif old not in s:\n    raise SystemExit(\"zero RHS block not found\")\ns = s.replace(old, new, 1)\npath.write_text(s)\nprint(\"Fixed zero-RHS write_zero_vector call\")\nPY\n"]
