[6575.103007, "o", "\u001b[32m\u001b[K1267\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const char *\u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K_name = NULL;\r\n\u001b[32m\u001b[K1292\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) die(\"missing \u001b[01;31m\u001b[Kpreconditioner\u001b[m\u001b[K name\");\r\n"]
[6575.103066, "o", "\u001b[32m\u001b[K1294\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        } else if (strcmp(arg, \"--\u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K\") == 0) {\r\n\u001b[32m\u001b[K1295\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) die(\"missing \u001b[01;31m\u001b[Kreordering\u001b[m\u001b[K name\");\r\n\u001b[32m\u001b[K1296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K_name = argv[i];\r\n"]
[6575.103128, "o", "\u001b[32m\u001b[K1348\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (input || rhs || solver_name || precond_name || \u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K_name) {\r\n\u001b[32m\u001b[K1375\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (rhs || solver_name || precond_name || \u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K_name || output) {\r\n\u001b[32m\u001b[K1389\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (strcmp(solver_name, \"cg\") == 0) solver = \u001b[01;31m\u001b[KSOLVER_CG\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K1390\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    else if (strcmp(solver_name, \"bicgstab\") == 0) solver = \u001b[01;31m\u001b[KSOLVER_BICGSTAB\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K1391\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    else if (strcmp(solver_name, \"gmres\") == 0) solver = \u001b[01;31m\u001b[KSOLVER_GMRES\u001b[m\u001b[K;\r\n"]
[6575.10319, "o", "\u001b[32m\u001b[K1394\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int precond = \u001b[01;31m\u001b[KPRECOND_NONE\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K1396\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (strcmp(precond_name, \"none\") == 0) precond = \u001b[01;31m\u001b[KPRECOND_NONE\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K1397\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        else if (strcmp(precond_name, \"jacobi\") == 0) precond = \u001b[01;31m\u001b[KPRECOND_JACOBI\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K1398\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        else if (strcmp(precond_name, \"ssor\") == 0) precond = \u001b[01;31m\u001b[KPRECOND_SSOR\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K1399\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        else if (strcmp(precond_name, \"ic0\") == 0) precond = \u001b[01;31m\u001b[KPRECOND_IC0\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K1400\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        else die_unknown(\"\u001b[01;31m\u001b[Kpreconditioner\u001b[m\u001b[K\", precond_name);\r\n"]
[6575.103251, "o", "\u001b[32m\u001b[K1403\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int \u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K = 0;\r\n\u001b[32m\u001b[K1404\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K_name) {\r\n\u001b[32m\u001b[K1405\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (strcmp(\u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K_name, \"none\") == 0) \u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K = 0;\r\n\u001b[32m\u001b[K1406\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        else if (strcmp(\u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K_name, \"rcm\") == 0) \u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K = 1;\r\n\u001b[32m\u001b[K1407\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        else die_unknown(\"\u001b[01;31m\u001b[Kreordering\u001b[m\u001b[K\", \u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K_name);\r\n"]
[6575.103308, "o", "\u001b[32m\u001b[K1438\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kreorder\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K1451\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (solver == \u001b[01;31m\u001b[KSOLVER_CG\u001b[m\u001b[K) x2 = solve_cg(A, bwork, p, max_it, tol, history, &iterations);\r\n\u001b[32m\u001b[K1452\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    else if (solver == \u001b[01;31m\u001b[KSOLVER_BICGSTAB\u001b[m\u001b[K) x2 = solve_bicgstab(A, bwork, p, max_it, tol, history, &iterations);\r\n"]
