[5911.527261, "o", "   574\t    int *degree = xcalloc((size_t)n, sizeof(int));\r\n   575\t    for (int i = 0; i < n; i++) degree[i] = adj_ptr[i + 1] - adj_ptr[i];\r\n   576\t\r\n   577\t    int *visited = xcalloc((size_t)n, sizeof(int));\r\n"]
[5911.527453, "o", "   578\t    int *comp_id = xmalloc((size_t)n * sizeof(int));\r\n   579\t    for (int i = 0; i < n; i++) comp_id[i] = -1;\r\n   580\t    int *comp_nodes = xmalloc((size_t)n * sizeof(int));\r\n   581\t    int *final_order = xmalloc((size_t)n * sizeof(int));\r\n   582\t    int final_count = 0;\r\n   583\t    int *queue = xmalloc((size_t)n * sizeof(int));\r\n   584\t    int comp_index = 0;\r\n   585\t\r\n   586\t    while (final_count < n) {\r\n   587\t        int seed = -1;\r\n   588\t        for (int i = 0; i < n; i++) {\r\n   589\t            if (!visited[i]) {\r\n   590\t                seed = i;\r\n   591\t                break;\r\n   592\t            }\r\n   593\t        }\r\n   594\t        if (seed == -1) break;\r\n   595\t\r\n   596\t        int comp_count = 0;\r\n   597\t        int qhead = 0, qtail = 0;\r\n   598\t        comp_id[seed] = comp_index;\r\n   599\t        comp_nodes[comp_count++] = seed;\r\n   600\t        queue[qtail++] = seed;\r\n   601\t        while (qhead < qtail) {\r\n   602\t            int v = queue[qhead++];\r\n   603\t            int base = adj_ptr[v];\r\n"]
[5911.527562, "o", "   604\t            int deg = adj_ptr[v + 1] - base;\r\n   605\t            for (int idx = 0; idx < deg; idx++) {\r\n   606\t                int u = adj[base + idx];\r\n   607\t                if (!visited[u] && comp_id[u] == -1) {\r\n   608\t                    comp_id[u] = comp_index;\r\n   609\t                    comp_nodes[comp_count++] = u;\r\n   610\t                    queue[qtail++] = u;\r\n   611\t                }\r\n   612\t            }\r\n   613\t        }\r\n   614\t\r\n   615\t        int start = comp_nodes[0];\r\n   616\t        for (int i = 1; i < comp_count; i++) {\r\n   617\t            int c = comp_nodes[i];\r\n   618\t            if (degree[c] < degree[start] ||\r\n   619\t                (degree[c] == degree[start] && c < start)) {\r\n   620\t                start = c;\r\n   621\t            }\r\n   622\t        }\r\n   623\t"]
[5911.527599, "o", "\r\n   624\t        int comp_order_start = final_count;\r\n   625\t        qhead = 0;\r\n   626\t        qtail = 0;\r\n   627\t        visited[start] = 1;\r\n"]
[5911.527771, "o", "   628\t        queue[qtail++] = start;\r\n   629\t        while (qhead < qtail) {\r\n   630\t            int v = queue[qhead++];\r\n   631\t            final_order[final_count++] = v;\r\n   632\t            int base = adj_ptr[v];\r\n   633\t            int deg = adj_ptr[v + 1] - base;\r\n   634\t            int *nbrs = xmalloc((size_t)(deg ? deg : 1) * sizeof(int));\r\n   635\t            int cnt = 0;\r\n   636\t            for (int idx = 0; idx < deg; idx++) {\r\n   637\t                int u = adj[base + idx];\r\n   638\t                if (comp_id[u] == comp_index && !visited[u]) nbrs[cnt++] = u;\r\n   639\t            }\r\n   640\t            for (int a = 1; a < cnt; a++) {\r\n   641\t                int key = nbrs[a];\r\n   642\t                int b = a - 1;\r\n   643\t                while (b >= 0) {\r\n   644\t                    if (degree[nbrs[b]] < degree[key] ||\r\n   645\t                        (degree[nbrs[b]] == degree[key] && nbrs[b] < key)) break;\r\n   646\t                    nbrs[b + 1] = nbrs[b];\r\n   647\t                    b--;\r\n   648\t   "]
[5911.527856, "o", "             }\r\n   649\t                nbrs[b + 1] = key;\r\n   650\t            }\r\n   651\t            for (int idx = 0; idx < cnt; idx++) {\r\n   652\t                int u = nbrs[idx];\r\n   653\t                if (!visited[u]) {"]
[5911.527942, "o", "\r\n   654\t                    visited[u] = 1;\r\n   655\t                    queue[qtail++] = u;\r\n   656\t                }\r\n   657\t            }\r\n   658\t            free(nbrs);\r\n   659\t        }\r\n   660\t\r\n"]
