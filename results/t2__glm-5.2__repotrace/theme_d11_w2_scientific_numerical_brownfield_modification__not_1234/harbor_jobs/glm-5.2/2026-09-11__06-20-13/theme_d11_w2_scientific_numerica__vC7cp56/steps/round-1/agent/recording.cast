[2640.749646, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.749812, "o", "        if (!output) die(\"missing output file for generator\");\r\n\u001b[?2004l\r"]
[2640.749901, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.74999, "o", "        if (gen2d) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.750023, "o", "> "]
[2640.750147, "o", "            int n = parse_int_arg(gen2d);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.750244, "o", "            if (n <= 0) die(\"invalid generator size\");\r\n\u001b[?2004l\r"]
[2640.75033, "o", "\u001b[?2004h> "]
[2640.75042, "o", "            long N = (long)n * (long)n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.750584, "o", "            if (N > INT_MAX / 3) die(\"generator size too large\");\r\n\u001b[?2004l\r"]
[2640.750681, "o", "\u001b[?2004h> "]
