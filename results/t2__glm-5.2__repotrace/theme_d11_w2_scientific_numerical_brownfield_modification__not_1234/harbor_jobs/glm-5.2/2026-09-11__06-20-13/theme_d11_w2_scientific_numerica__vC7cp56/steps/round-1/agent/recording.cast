[6690.397326, "o", "        }\r\n  1053\t\r\n  1054\t        precond_apply(p, s, z);\r\n  1055\t        spmv(A, z, t);\r\n  1056\t        double ts = dot(n, t, s);\r\n  1057\t        double tt = dot(n, t, t);\r\n  1058\t        if (fabs(tt) <= 1e-300) {\r\n  1059\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1060\t            break;\r\n  1061\t        }\r\n  1062\t        double omega = ts / tt;\r\n  1063\t        for (int i = 0; i < n; i++) {\r\n  1064\t            x[i] += alpha * z[i] + omega * s[i];\r\n  1065\t            r[i] = s[i] - omega * t[i];\r\n  1066\t        }\r\n  1067\t        it_count = it + 1;\r\n  1068\t        if (history) {\r\n  1069\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n  1070\t        }\r\n"]
