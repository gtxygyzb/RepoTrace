[2898.571684, "o", "\u001b[32m\u001b[K747\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (diag[j] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero or negative pivot in IC(0) factorization\");\r\n\u001b[32m\u001b[K753\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (sum <= 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero or negative pivot in IC(0) factorization\");\r\n\u001b[32m\u001b[K782\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in Jacobi preconditioner\");\r\n\u001b[32m\u001b[K785\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (omega <= 0.0 || omega >= 2.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid SSOR parameter\");\r\n\u001b[32m\u001b[K788\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in SSOR preconditioner\");\r\n"]
[2898.571747, "o", "\u001b[32m\u001b[K793\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!m->symmetric) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"IC(0) requires symmetric matrix\");\r\n\u001b[32m\u001b[K794\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        p->ic = \u001b[01;31m\u001b[Kic0_factorize\u001b[m\u001b[K(m);\r\n\u001b[32m\u001b[K810\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in Jacobi preconditioner\");\r\n"]
[2898.571821, "o", "\u001b[32m\u001b[K823\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in SSOR preconditioner\");\r\n\u001b[32m\u001b[K831\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in SSOR preconditioner\");\r\n\u001b[32m\u001b[K844\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (ic->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero or negative pivot in IC(0) factorization\");\r\n\u001b[32m\u001b[K856\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"unknown preconditioner\");\r\n"]
