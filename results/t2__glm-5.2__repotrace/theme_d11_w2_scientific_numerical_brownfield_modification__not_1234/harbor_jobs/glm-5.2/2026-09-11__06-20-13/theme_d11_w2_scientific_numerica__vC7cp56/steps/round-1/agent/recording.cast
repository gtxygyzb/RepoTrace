[6859.957358, "o", "   955\t    }\r\n   956\t    free(p);\r\n   957\t}\r\n   958\t\r\n   959\tstatic double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n   960\t    int n = A->n;"]
[6859.957437, "o", "\r\n   961\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n   962\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n   963\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   964\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n   965\t    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n   966\t\r\n   967\t    spmv(A, x, r);\r\n   968\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   969\t    double bnorm = vec_norm2(n, b);\r\n   970\t    int it_count = 0;\r\n   971\t\r\n   972\t    precond_apply(p, r, z);\r\n   973\t    dcopy(n, z, pvec);\r\n   974\t    double rz_old = dot(n, r, z);\r\n   975\t\r\n   976\t    for (int it = 0; it < max_it; it++) {\r\n   977\t        spmv(A, pvec, Ap);\r\n   978\t        double pAp = dot(n, pvec, Ap);\r\n   979\t        if (pAp <= 0.0) {\r\n   980\t            break;\r\n   981\t        }\r\n   982\t        double alpha = rz_old / pAp;\r\n   983\t        for (int i = 0; i < n; i++) {\r\n   984\t            x[i] += alpha * pvec[i];\r\n   985\t            r[i] -= alpha * Ap[i];\r\n   986\t        }\r\n   987\t  "]
[6859.957525, "o", "      it_count = it + 1;\r\n   988\t        if (history) {\r\n   989\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n   990\t        }\r\n   991\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n   992\t\r\n   993\t        precond_apply(p, r, z);\r\n   994\t        double rz_new = dot(n, r, z);\r\n   995\t        if (rz_old == 0.0) {\r\n   996\t            break;\r\n   997\t        }\r\n   998\t        double beta = rz_new / rz_old;\r\n"]
[6859.957594, "o", "   999\t        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n  1000\t        rz_old = rz_new;\r\n  1001\t    }\r\n  1002\t\r\n  1003\t    if (iterations_out) *iterations_out = it_count;\r\n  1004\t    free(r); free(z); free(pvec); free(Ap);\r\n  1005\t    return x;\r\n  1006\t}\r\n  1007\t\r\n  1008\tstatic double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n  1009\t"]
[6859.957693, "o", "    int n = A->n;\r\n  1010\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n  1011\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n  1012\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n  1013\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n  1014\t    double *v = xmalloc((size_t)n * sizeof(double));\r\n  1015\t    double *s = xmalloc((size_t)n * sizeof(double));\r\n  1016\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n  1017\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n  1018\t\r\n  1019\t    spmv(A, x, r);\r\n  1020\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n"]
[6859.957758, "o", "  1021\t    double bnorm = vec_norm2(n, b);\r\n  1022\t    int it_count = 0;\r\n  1023\t\r\n  1024\t    dcopy(n, r, r0);\r\n  1025\t    double rho_old = dot(n, r0, r);\r\n  1026\t    if (rho_old == 0.0) {\r\n  1027\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1028\t        die(\"BiCGSTAB numerical breakdown\");\r\n  1029\t    }\r\n  1030\t    dcopy(n, r, pvec);\r\n"]
[6859.957819, "o", "  1031\t\r\n  1032\t    for (int it = 0; it < max_it; it++) {\r\n  1033\t        precond_apply(p, pvec, z);\r\n  1034\t        spmv(A, z, v);\r\n  1035\t        double r0v = dot(n, r0, v);\r\n  1036\t        if (r0v == 0.0) {\r\n  1037\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1038\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1039\t"]
[6859.957876, "o", "        }\r\n  1040\t        double alpha = rho_old / r0v;\r\n  1041\t        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n  1042\t\r\n  1043\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n  1044\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n  1045\t            it_count = it + 1;\r\n  1046\t            if (history) {\r\n"]
[6859.957941, "o", "  1047\t                printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, s));\r\n  1048\t            }\r\n  1049\t            break;\r\n  1050\t        }\r\n  1051\t\r\n  1052\t        precond_apply(p, s, z);\r\n  1053\t        spmv(A, z, t);\r\n  1054\t        double ts = dot(n, t, s);\r\n  1055\t        double tt = dot(n, t, t);\r\n  1056\t        if (fabs(tt) <= 1e-300) {\r\n  1057\t            break;\r\n"]
[6859.958, "o", "  1058\t        }\r\n  1059\t        double omega = ts / tt;\r\n  1060\t        for (int i = 0; i < n; i++) {\r\n  1061\t            x[i] += alpha * z[i] + omega * s[i];\r\n  1062\t            r[i] = s[i] - omega * t[i];\r\n  1063\t        }\r\n  1064\t        it_count = it + 1;\r\n  1065\t        if (history) {\r\n  1066\t"]
[6859.958065, "o", "            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n  1067\t        }\r\n  1068\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n  1069\t\r\n  1070\t        double rho_new = dot(n, r0, r);\r\n  1071\t        if (fabs(rho_new) <= 1e-300) {\r\n  1072\t            break;\r\n  1073\t        }\r\n  1074\t        double beta = (rho_new / rho_old) * (alpha / omega);\r\n  1075\t        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n"]
