[6527.100011, "o", "\t            input = argv[i];\r\n  1285\t        } else if (strcmp(arg, \"--rhs\") == 0) {\r\n  1286\t            if (++i >= argc) die(\"missing argument for --rhs\");\r\n  1287\t            rhs = argv[i];\r\n  1288\t        } else if (strcmp(arg, \"--solver\") == 0) {\r\n  1289\t            if (++i >= argc) die(\"missing solver name\");\r\n  1290\t            solver_name = argv[i];\r\n  1291\t        } else if (strcmp(arg, \"--precond\") == 0) {\r\n  1292\t            if (++i >= argc) die(\"missing preconditioner name\");\r\n  1293\t            precond_name = argv[i];\r\n  1294\t        } else if (strcmp(arg, \"--reorder\") == 0) {\r\n  1295\t            if (++i >= argc) die(\"missing reordering name\");\r\n  1296\t            reorder_name = argv[i];\r\n  1297\t        } else if (strcmp(arg, \"--output\") == 0) {\r\n"]
[6527.100087, "o", "  1298\t            if (++i >= argc) die(\"missing argument for --output\");\r\n  1299\t            output = argv[i];\r\n  1300\t        } else if (strcmp(arg, \"--analyze\") == 0) {\r\n  1301\t            analyze = 1;\r\n  1302\t        } else if (strcmp(arg, \"--history\") == 0) {\r\n  1303\t            history = 1;\r\n  1304\t        } else if (strcmp(arg, \"--generate-laplacian\") == 0) {\r\n  1305\t            if (++i >= argc) die(\"missing argument for --generate-laplacian\");\r\n  1306\t            gen2d = argv[i];\r\n  1307\t        } else if (strcmp(arg, \"--generate-laplacian3d\") == 0) {\r\n"]
[6527.100165, "o", "  1308\t            if (++i >= argc) die(\"missing argument for --generate-laplacian3d\");\r\n  1309\t            gen3d = argv[i];\r\n  1310\t        } else if (strcmp(arg, \"--generate-rhs\") == 0) {\r\n  1311\t            if (++i >= argc) die(\"missing argument for --generate-rhs\");\r\n  1312\t            genrhs = argv[i];\r\n"]
[6527.100245, "o", "  1313\t        } else if (strcmp(arg, \"--max-it\") == 0 || strcmp(arg, \"--max-iter\") == 0) {\r\n  1314\t            if (++i >= argc) die(\"missing argument for max iterations\");\r\n  1315\t            max_it = parse_int_arg(argv[i]);\r\n  1316\t        } else if (strcmp(arg, \"--tol\") == 0) {\r\n  1317\t            if (++i >= argc) die(\"missing argument for tolerance\");\r\n  1318\t            tol = parse_double_arg(argv[i]);\r\n  1319\t        } else if (strcmp(arg, \"--omega\") == 0) {\r\n  1320\t            if (++i >= argc) die(\"missing argument for omega\");\r\n  1321\t            omega = parse_double_arg(argv[i]);\r\n  1322\t        } else if (strcmp(arg, \"--restart\") == 0) {\r\n  1323\t            if (++i >= argc) die(\"missing argument for --restart\");\r\n  1324\t            restart = parse_int_arg(argv[i]);\r\n  1325\t            restart_given = 1;\r\n  1326\t        } else {\r\n  1327\t            char msg[256];\r\n  1328\t            snprintf(msg, sizeof(msg), \"unknown option: %s\", arg);\r\n"]
[6527.100321, "o", "  1329\t            die(msg);\r\n  1330\t        }\r\n  1331\t    }\r\n  1332\t\r\n  1333\t    if (restart_given) {\r\n  1334\t        if (restart < 1) die(\"invalid restart value\");\r\n"]
[6527.100395, "o", "  1335\t        if (!(solver_name && strcmp(solver_name, \"gmres\") == 0)) die(\"--restart requires --solver gmres\");\r\n  1336\t    }\r\n  1337\t\r\n  1338\t    int modes = 0;\r\n  1339\t    if (analyze) modes++;\r\n  1340\t    if (solver_name) modes++;\r\n  1341\t    if (gen2d) modes++;\r\n  1342\t    if (gen3d) modes++;\r\n  1343\t    if (genrhs) modes++;\r\n  1344\t    if (modes == 0) die(\"no operation specified\");\r\n  1345\t    if (modes > 1) die(\"conflicting operation modes specified\");\r\n  1346\t\r\n  1347\t    if (gen2d || gen3d || genrhs) {\r\n  1348\t        if (input || rhs || solver_name || precond_name || reorder_name) {\r\n  1349\t            die(\"conflicting command-line arguments\");\r\n"]
[6527.10047, "o", "  1350\t        }\r\n  1351\t        if (!output) die(\"missing output file for generator\");\r\n  1352\t\r\n  1353\t        if (gen2d) {\r\n  1354\t            int n = parse_int_arg(gen2d);\r\n  1355\t            if (n <= 0) die(\"invalid generator size\");\r\n  1356\t            long N = (long)n * (long)n;\r\n  1357\t            if (N > INT_MAX / 3) die(\"generator size too large\");\r\n  1358\t            generate_laplacian2d(n, output);\r\n  1359\t        } else if (gen3d) {\r\n  1360"]
[6527.100602, "o", "\t            int n = parse_int_arg(gen3d);\r\n  1361\t            if (n <= 0) die(\"invalid generator size\");\r\n  1362\t            long N = (long)n * (long)n * (long)n;\r\n  1363\t            if (N > INT_MAX / 4) die(\"generator size too large\");\r\n  1364\t            generate_laplacian3d(n, output);\r\n  1365\t        } else {\r\n  1366\t            int N = parse_int_arg(genrhs);\r\n  1367\t            if (N <= 0) die(\"invalid generator size\");\r\n  1368\t            generate_rhs(N, output);\r\n  1369\t        }\r\n  1370\t        return 0;\r\n  1371\t    }\r\n  1372\t\r\n  1373\t    if (analyze) {\r\n  1374\t        if (!input) die(\"missing input file for analyze\");\r\n  1375\t        if (rhs || solver_name || precond_name || reorder_name || output) {\r\n  1376\t            die(\"conflicting command-line arguments\");\r\n  1377\t        }\r\n  1378\t        CSRMatrix *m = read_matrix(input);\r\n"]
[6527.100696, "o", "  1379\t        analyze_matrix(m);\r\n  1380\t        free_csr(m);\r\n  1381\t        return 0;\r\n  1382\t    }\r\n  1383\t\r\n  1384\t    if (!input) die(\"missing input file for solver\");\r\n  1385\t    if (!rhs) die(\"missing rhs file for solver\");\r\n  1386\t    if (!solver_name) die(\"missing solver name\");\r\n  1387\t\r\n  1388\t    int solver;\r\n  1389\t    if (strcmp(solver_name, \"cg\") == 0) solver = SOLVER_CG;\r\n  1390\t    else if (strcmp(solver_name, \"bicgstab\") == 0) solver = SOLVER_BICGSTAB;\r\n  1391\t    else if (strcmp(solver_name, \"gmres\") == 0) solver = SOLVER_GMRES;\r\n"]
[6527.100769, "o", "  1392\t    else die_unknown(\"solver\", solver_name);\r\n  1393\t\r\n  1394\t    int precond = PRECOND_NONE;\r\n  1395\t    if (precond_name) {\r\n  1396\t        if (strcmp(precond_name, \"none\") == 0) precond = PRECOND_NONE;\r\n  1397\t        else if (strcmp(precond_name, \"jacobi\") == 0) precond = PRECOND_JACOBI;\r\n  1398\t        else if (strcmp(precond_name, \"ssor\") == 0) precond = PRECOND_SSOR;\r\n  1399\t        else if (strcmp(precond_name, \"ic0\") == 0) precond = PRECOND_IC0;\r\n  1400\t        else die_unknown(\"preconditioner\", precond_name);\r\n  1401\t    }\r\n  1402"]
[6527.100851, "o", "\t\r\n  1403\t    int reorder = 0;\r\n  1404\t    if (reorder_name) {\r\n  1405\t        if (strcmp(reorder_name, \"none\") == 0) reorder = 0;\r\n  1406\t        else if (strcmp(reorder_name, \"rcm\") == 0) reorder = 1;\r\n  1407\t        else die_unknown(\"reordering\", reorder_name);\r\n  1408\t    }\r\n  1409\t\r\n  1410\t    if (max_it <= 0) die(\"invalid max iterations\");\r\n  1411\t    if (tol < 0.0) die(\"invalid tolerance\");\r\n  1412\t\r\n  1413\t    CSRMatrix *m = read_matrix(input);\r\n  1414\t    int rhs_n;"]
[6527.100923, "o", "\r\n  1415\t    double *b = read_vector(rhs, &rhs_n);\r\n  1416\t    if (m->n != rhs_n) {\r\n  1417\t        free_csr(m);\r\n"]
[6527.100991, "o", "  1418\t        free(b);\r\n  1419\t        die(\"matrix and RHS dimensions do not match\");\r\n  1420\t    }\r\n  1421\t\r\n  1422\t    int n = m->n;\r\n  1423\t\r\n  1424\t    if (vec_norm2(n, b) == 0.0) {\r\n  1425\t        write_zero_vector(output, n);\r\n  1426\t        printf(\"iterations: 0\\n\");\r\n  1427\t        printf(\"residual_norm: 0.000000e+00\\n\");\r\n  1428\t        printf(\"converged: yes\\n\");\r\n  1429\t        free_csr(m);\r\n  1430\t        free(b);\r\n  1431\t        return 0;\r\n  1432\t    }\r\n  1433\t\r\n  1434\t    CSRMatrix *A = m;\r\n"]
[6527.101064, "o", "  1435\t    double *bwork = b;\r\n  1436\t    int *perm = NULL;\r\n  1437\t\r\n  1438\t    if (reorder) {\r\n  1439\t        perm = xmalloc((size_t)n * sizeof(int));\r\n  1440\t        rcm_ordering(m, perm);\r\n  1441\t"]
[6527.101141, "o", "        A = permute_csr(m, perm);\r\n  1442\t        bwork = xmalloc((size_t)n * sizeof(double));\r\n  1443\t        for (int i = 0; i < n; i++) bwork[perm[i]] = b[i];\r\n  1444\t        free_csr(m);\r\n  1445\t        m = A;\r\n  1446\t    }\r\n  1447\t\r\n  1448\t    Precond *p = precond_setup(A, precond, omega);\r\n  1449\t    int iterations = 0;\r\n  1450\t    double *x2;\r\n  1451\t    if (solver == SOLVER_CG) x2 = solve_cg(A, bwork, p, max_it, tol, history, &iterations);\r\n  1452\t    else if (solver == SOLVER_BICGSTAB) x2 = solve_bicgstab(A, bwork, p, max_it, tol, history, &iterations);\r\n  1453\t    else x2 = solve_gmres(A, bwork, p, max_it, tol, history, restart, &iterations);\r\n  1454\t\r\n  1455\t    double true_res = compute_true_residual(A, bwork, x2);\r\n  1456\t\r\n  1457\t"]
[6527.101213, "o", "    double *x;\r\n  1458\t    if (perm) {\r\n  1459\t        x = xmalloc((size_t)n * sizeof(double));\r\n  1460\t        for (int i = 0; i < n; i++) x[i] = x2[perm[i]];\r\n  1461\t        free(x2);\r\n"]
[6527.101309, "o", "  1462\t        free(bwork);\r\n  1463\t        free(perm);\r\n  1464\t    } else {\r\n  1465\t        x = x2;\r\n  1466\t    }\r\n  1467\t\r\n  1468\t    write_vector(output, n, x);\r\n  1469\t\r\n  1470\t    printf(\"iterations: %d\\n\", iterations);\r\n  1471\t    printf(\"residual_norm: %.6e\\n\", true_res);\r\n  1472\t    printf(\"converged: %s\\n\", (true_res <= tol) ? \"yes\" : \"no\");\r\n  1473\t\r\n  1474\t    free(x);\r\n  1475\t    free_precond(p);\r\n  1476\t    free_csr(A);\r\n  1477\t    free(b);\r\n  1478\t    return 0;\r\n  1479\t}\r\n"]
