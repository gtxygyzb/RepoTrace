[3658.40844, "o", "\u001b[32m\u001b[K1216\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    Precond *p = \u001b[01;31m\u001b[Kprecond_setup\u001b[m\u001b[K(A, precond, omega);\r\n\u001b[32m\u001b[K1218\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (solver == SOLVER_CG) x2 = \u001b[01;31m\u001b[Ksolve_cg\u001b[m\u001b[K(A, bwork, p, max_it, tol);\r\n\u001b[32m\u001b[K1219\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    else x2 = \u001b[01;31m\u001b[Ksolve_bicgstab\u001b[m\u001b[K(A, bwork, p, max_it, tol);\r\n\u001b[32m\u001b[K1232\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kwrite_vector\u001b[m\u001b[K(output, n, x);\r\n"]
