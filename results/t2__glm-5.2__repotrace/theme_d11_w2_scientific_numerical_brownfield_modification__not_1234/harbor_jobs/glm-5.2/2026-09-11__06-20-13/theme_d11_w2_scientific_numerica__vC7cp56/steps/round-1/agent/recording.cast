[6690.111943, "o", "\t                    pi++;\r\n   809\t                    pj++;\r\n   810\t                } else if (ci < cj) {\r\n   811\t                    pi++;\r\n   812\t                } else {\r\n   813\t                    pj++;\r\n   814\t                }\r\n   815\t            }\r\n   816\t\r\n   817\t            if (diag[j] <= 0.0) {\r\n   818\t                free(row_ptr); free(col_idx); free(vals); free(diag);\r\n   819\t                return NULL;\r\n   820\t            }\r\n   821\t"]
[6690.112013, "o", "            double l = s / diag[j];\r\n   822\t            vals[k] = l;\r\n   823\t            sum -= l * l;\r\n   824\t        }\r\n   825\t\r\n   826\t        if (sum <= 0.0) {\r\n   827\t            free(row_ptr); free(col_idx); free(vals); free(diag);\r\n   828\t            return NULL;\r\n   829\t        }\r\n   830\t        diag[i] = sqrt(sum);\r\n   831\t    }\r\n"]
