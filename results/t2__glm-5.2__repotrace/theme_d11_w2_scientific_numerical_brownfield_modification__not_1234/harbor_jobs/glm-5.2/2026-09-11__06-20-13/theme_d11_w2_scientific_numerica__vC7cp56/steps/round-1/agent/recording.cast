[3684.232009, "o", "        fclose(f);\r\n   189\t        die(\"empty matrix file\");\r\n   190\t    }\r\n   191\t    if (strncmp(line, \"%%MatrixMarket\", 14) != 0) {\r\n   192\t        fclose(f);\r\n   193\t        die(\"matrix file is not Matrix Market format\");\r\n   194\t    }\r\n   195\t\r\n   196\t    char obj[64], fmt[64], field[64], sym[64];\r\n   197\t    if (sscanf(line, \"%*s %63s %63s %63s %63s\", obj, fmt, field, sym) != 4) {\r\n   198\t        fclose(f);\r\n   199\t        die(\"invalid Matrix Market header\");\r\n   200\t    }\r\n   201\t    if (strcmp(obj, \"matrix\") != 0 || strcmp(fmt, \"coordinate\") != 0 || strcmp(field, \"real\") != 0) {\r\n   202\t        fclose(f);\r\n   203\t        die(\"only real coordinate matrices are supported\");\r\n   204\t    }\r\n   205\t\r\n   206\t    int symmetric;\r\n"]
[3684.232094, "o", "   207\t    if (strcmp(sym, \"symmetric\") == 0) symmetric = 1;\r\n   208\t    else if (strcmp(sym, \"general\") == 0) symmetric = 0;\r\n   209\t    else {\r\n   210\t        fclose(f);\r\n   211\t        die(\"only symmetric or general matrices are supported\");\r\n   212\t    }\r\n   213\t\r\n   214\t    while (fgets(line, sizeof(line), f)) {\r\n   215\t        char *p = line;\r\n   216\t        while (isspace((unsigned char)*p)) p++;\r\n   217\t        if (*p == '%') continue;\r\n   218\t        if (*p == '\\0') continue;\r\n   219\t        break;\r\n"]
[3684.232217, "o", "   220\t    }\r\n"]
