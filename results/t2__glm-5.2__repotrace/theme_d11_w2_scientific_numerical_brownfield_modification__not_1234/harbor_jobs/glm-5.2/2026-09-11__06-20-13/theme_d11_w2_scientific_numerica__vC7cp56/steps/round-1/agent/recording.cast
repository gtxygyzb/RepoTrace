[1839.351594, "o", "CC = gcc\r\nCFLAGS = -O2 -Wall -Wextra -std=c11\r\nLDFLAGS = -lm\r\n\r\nnlsolve: nlsolve.c\r\n\t$(CC) $(CFLAGS) -o nlsolve nlsolve.c $(LDFLAGS)\r\n"]
[1839.351674, "o", "\r\nclean:\r\n\trm -f nlsolve\r\n\r\n.PHONY: clean\r\n"]
[1839.352139, "o", "\u001b[?2004h"]
