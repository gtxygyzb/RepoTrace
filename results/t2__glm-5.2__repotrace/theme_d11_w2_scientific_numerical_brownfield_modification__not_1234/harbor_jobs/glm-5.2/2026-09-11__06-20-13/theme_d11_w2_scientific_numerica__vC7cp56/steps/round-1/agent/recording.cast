[6421.706735, "o", "\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define SOLVER_B\u001b[01;31m\u001b[KIC\u001b[m\u001b[KGSTAB 1\r\n\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define PRECOND_\u001b[01;31m\u001b[KIC\u001b[m\u001b[K0 3\r\n"]
[6421.706867, "o", "\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K} \u001b[01;31m\u001b[KIC\u001b[m\u001b[KFactor;\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[KIC\u001b[m\u001b[KFactor *ic;\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[Kconst char *msg) {\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fprintf(stderr, \"\u001b[01;31m\u001b[Kerror:\u001b[m\u001b[K %s\\n\", msg);\r\n"]
[6421.706947, "o", "\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!p) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"out of memory\");\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!p) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"out of memory\");\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!*arr) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"out of memory\");\r\n"]
[6421.707006, "o", "\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open matrix file\");\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"empty matrix file\");\r\n"]
[6421.707097, "o", "\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix file is not Matrix Market format\");\r\n\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid Matrix Market header\");\r\n\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"only real coordinate matrices are supported\");\r\n\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"only symmetric or general matrices are supported\");\r\n"]
[6421.70719, "o", "\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read matrix dimensions\");\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid matrix dimensions\");\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix must be square\");\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid nnz\");\r\n"]
[6421.707265, "o", "\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read matrix entry\");\r\n\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix entry index out of range\");\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"extra trailing data in matrix file\");\r\n\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open rhs file\");\r\n\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read vector dimension\");\r\n\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid vector dimension\");\r\n"]
[6421.707336, "o", "\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read vector entry\");\r\n\u001b[32m\u001b[K303\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"extra trailing data in vector file\");\r\n\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output matrix file\");\r\n"]
