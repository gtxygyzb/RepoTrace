[6467.485788, "o", "  1001\tstatic double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n  1002\t    int n = A->n;\r\n  1003\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n  1004\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n  1005\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n"]
[6467.48588, "o", "  1006\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n  1007\t    double *v = xmalloc((size_t)n * sizeof(double));\r\n  1008\t    double *s = xmalloc((size_t)n * sizeof(double));\r\n  1009\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n  1010\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n  1011\t\r\n  1012\t    spmv(A, x, r);\r\n  1013\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n  1014\t    double bnorm = vec_norm2(n, b);\r\n  1015\t    int it_count = 0;\r\n  1016\t\r\n  1017\t    dcopy(n, r, r0);\r\n  1018\t    double rho_old = dot(n, r0, r);\r\n  1019\t    if (rho_old == 0.0) {\r\n"]
[6467.485981, "o", "  1020\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1021\t        die(\"BiCGSTAB numerical breakdown\");\r\n  1022\t    }\r\n  1023\t    dcopy(n, r, pvec);\r\n  1024\t\r\n  1025\t    for (int it = 0; it < max_it; it++) {\r\n  1026\t        precond_apply(p, pvec, z);\r\n"]
[6467.48606, "o", "  1027\t        spmv(A, z, v);\r\n  1028\t        double r0v = dot(n, r0, v);\r\n  1029\t        if (r0v == 0.0) {\r\n  1030\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1031\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1032\t        }\r\n  1033\t        double alpha = rho_old / r0v;\r\n  1034\t        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n  1035\t\r\n  1036\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n  1037\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n  1038\t            it_count = it + 1;\r\n  1039\t            if (history) {\r\n  1040\t                printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, s));\r\n  1041\t            }\r\n  1042\t            break;\r\n  1043\t        }\r\n  1044\t\r\n  1045\t        precond_apply(p, s, z);"]
[6467.486138, "o", "\r\n  1046\t        spmv(A, z, t);\r\n  1047\t        double ts = dot(n, t, s);\r\n  1048\t        double tt = dot(n, t, t);\r\n  1049\t        if (tt == 0.0) {\r\n  1050\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1051\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1052\t        }\r\n  1053\t        double omega = ts / tt;\r\n  1054\t        for (int i = 0; i < n; i++) {\r\n  1055\t"]
[6467.486209, "o", "            x[i] += alpha * z[i] + omega * s[i];\r\n  1056\t            r[i] = s[i] - omega * t[i];\r\n  1057\t        }\r\n  1058\t        it_count = it + 1;\r\n  1059\t        if (history) {\r\n  1060\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n  1061\t        }\r\n  1062\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n  1063\t\r\n  1064\t        double rho_new = dot(n, r0, r);\r\n  1065\t        if (rho_new == 0.0) {\r\n"]
[6467.486281, "o", "  1066\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1067\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1068\t        }\r\n  1069\t        double beta = (rho_new / rho_old) * (alpha / omega);\r\n  1070\t        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n  1071\t        rho_old = rho_new;\r\n  1072\t    }\r\n  1073\t\r\n  1074\t    if (iterations_out) *iterations_out = it_count;\r\n"]
[6467.486349, "o", "  1075\t    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1076\t    return x;\r\n  1077\t}\r\n"]
