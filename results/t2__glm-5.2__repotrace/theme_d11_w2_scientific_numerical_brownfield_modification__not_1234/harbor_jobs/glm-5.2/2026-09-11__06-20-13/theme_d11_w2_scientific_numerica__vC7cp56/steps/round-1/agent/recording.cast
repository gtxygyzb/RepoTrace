[6106.237747, "i", "cat > disc.mtx <<'EOF'\n%%MatrixMarket matrix coordinate real symmetric\n4 4 6\n1 1 2.0\n1 2 1.0\n2 2 2.0\n3 3 2.0\n3 4 1.0\n4 4 2.0\nEOF\ncat > test_rcm.c <<'EOF'\n#define main nlsolve_main\n#include \"nlsolve.c\"\n#undef main\nint main(void) {\n    CSRMatrix *m = read_matrix(\"disc.mtx\");\n    int *perm = xmalloc((size_t)m->n * sizeof(int));\n    rcm_ordering(m, perm);\n    for (int i = 0; i < m->n; i++) printf(\"%d\\n\", perm[i]);\n    free(perm);\n    free_csr(m);\n    return 0;\n}\nEOF\ngcc -O2 -Wall -Wextra -std=c11 -o test_rcm test_rcm.c -lm\n./test_rcm\n"]
[6106.237985, "o", "cat > disc.mtx <<'EOF'\r\n"]
