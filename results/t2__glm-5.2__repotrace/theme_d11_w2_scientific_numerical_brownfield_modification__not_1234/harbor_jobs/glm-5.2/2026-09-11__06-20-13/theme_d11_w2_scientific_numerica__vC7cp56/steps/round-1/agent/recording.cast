[4242.474278, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\npath = Path(\"nlsolve.c\")\ns = path.read_text()\n\nreplacements = []\n\ndef replace(old, new, desc):\n    global s\n    if old not in s:\n        raise SystemExit(f\"pattern not found: {desc}\")\n    s = s.replace(old, new, 1)\n    replacements.append(desc)\n\n# 1. Add compute_true_residual helper after vec_norm2\nold = '''static double vec_norm2(int n, const double *x) {\n    return sqrt(dot(n, x, x));\n}\n\nstatic void analyze_matrix(CSRMatrix *m) {'''\nnew = '''static double vec_norm2(int n, const double *x) {\n    return sqrt(dot(n, x, x));\n}\n\nstatic double compute_true_residual(CSRMatrix *A, const double *b, const double *x) {\n    int n = A->n;\n    double *Ax = xmalloc((size_t)n * sizeof(double));\n    spmv(A, x, Ax);\n    for (int i = 0; i < n; i++) Ax[i] = b[i] - Ax[i];\n    double res = vec_norm2(n, Ax);\n    double bnorm = vec_norm2(n, b);\n    free(Ax);\n    if (bnorm == 0.0) return 0.0;\n    return res / bnorm;\n}\n\nstatic void analyze_matrix(CSRMatrix *m) {'''\nreplace(old, new, \"add co"]
[4242.474539, "i", "mpute_true_residual helper\")\n\n# 2. Remove SSOR zero diagonal fatal check in setup\nold = '''    } else if (type == PRECOND_SSOR) {\n        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\n        p->diag = compute_diag(m);\n        for (int i = 0; i < m->n; i++) {\n            if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\n        }\n        p->lower = build_lower_triangular(m);\n        p->upper = build_upper_triangular(m);\n    } else if (type == PRECOND_IC0) {'''\nnew = '''    } else if (type == PRECOND_SSOR) {\n        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\n        p->diag = compute_diag(m);\n        p->lower = build_lower_triangular(m);\n        p->upper = build_upper_triangular(m);\n    } else if (type == PRECOND_IC0) {'''\nreplace(old, new, \"remove SSOR setup zero diagonal die\")\n\n# 3. Make SSOR apply safe for zero diagonals\nold = '''    if (p->type == PRECOND_SSOR) {\n        dcopy(n, r, z);\n        for (int i = 0; i < n; i++) {\n            for (int idx"]
[4242.474608, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
