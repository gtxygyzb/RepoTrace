[6409.668035, "o", "   750\t    return t;\r\n   751\t}\r\n   752\t\r\n   753\tstatic void free_tri_matrix(TriMatrix *t) {\r\n   754\t    if (!t) return;\r\n"]
[6409.668119, "o", "   755\t    free(t->row_ptr);\r\n   756\t    free(t->col_idx);\r\n   757\t    free(t->vals);\r\n   758\t    free(t);\r\n   759\t}\r\n   760\t\r\n   761\tstatic ICFactor *ic0_factorize(const CSRMatrix *m) {\r\n   762\t    int n = m->n;\r\n   763\t    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n   764\t    for (int i = 0; i < n; i++) {\r\n   765\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   766\t            if (m->col_idx[idx] < i) row_ptr[i + 1]++;\r\n   767\t        }"]
[6409.668204, "o", "\r\n   768\t    }\r\n   769\t    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];\r\n   770\t\r\n   771\t    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n   772\t    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));\r\n   773\t    int *next = xcalloc((size_t)n, sizeof(int));\r\n   774\t    for (int i = 0; i < n; i++) {\r\n   775\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   776\t            int j = m->col_idx[idx];\r\n   777\t            if (j < i) col_idx[row_ptr[i] + next[i]++] = j;\r\n   778\t        }\r\n   779\t    }\r\n   780\t    free(next);\r\n   781\t\r\n"]
[6409.668272, "o", "   782\t    double *diag = xmalloc((size_t)n * sizeof(double));\r\n   783\t    for (int i = 0; i < n; i++) {\r\n   784\t        double aii = 0.0;\r\n   785\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   786\t            if (m->col_idx[idx] == i) aii += m->vals[idx];\r\n   787\t        }\r\n   788\t\r\n   789\t        double sum = aii;\r\n   790"]
[6409.668341, "o", "\t        for (int k = row_ptr[i]; k < row_ptr[i + 1]; k++) {\r\n   791\t            int j = col_idx[k];\r\n   792\t            double aij = 0.0;\r\n   793\t            for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   794\t                if (m->col_idx[idx] == j) {\r\n   795\t                    aij += m->vals[idx];\r\n   796\t                    break;\r\n   797\t                }\r\n   798\t            }\r\n   799\t"]
[6409.668404, "o", "\r\n   800\t            double s = aij;\r\n   801\t            int pi = row_ptr[i];\r\n   802\t            int pj = row_ptr[j];\r\n   803\t            while (pi < k && pj < row_ptr[j + 1]) {\r\n   804\t                int ci = col_idx[pi];\r\n   805\t                int cj = col_idx[pj];\r\n   806\t                if (ci == cj) {\r\n   807\t                    s -= vals[pi] * vals[pj];\r\n   808\t"]
[6409.668467, "o", "                    pi++;\r\n   809\t                    pj++;\r\n   810\t                } else if (ci < cj) {\r\n   811\t                    pi++;\r\n   812\t                } else {\r\n   813\t                    pj++;\r\n   814\t                }\r\n   815\t            }\r\n   816\t"]
[6409.66853, "o", "\r\n   817\t            if (diag[j] <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   818\t            double l = s / diag[j];\r\n   819\t            vals[k] = l;\r\n   820\t            sum -= l * l;\r\n   821\t        }\r\n   822\t\r\n   823\t        if (sum <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   824\t        diag[i] = sqrt(sum);\r\n"]
[6409.668595, "o", "   825\t    }\r\n   826\t\r\n   827\t    ICFactor *ic = xmalloc(sizeof(ICFactor));\r\n   828\t    ic->n = n;\r\n   829\t    ic->l_row_ptr = row_ptr;\r\n   830\t    ic->l_col_idx = col_idx;\r\n   831\t    ic->l_vals = vals;\r\n   832\t    ic->diag = diag;\r\n   833\t"]
[6409.668669, "o", "    ic->u_row_ptr = NULL;\r\n   834\t    ic->u_col_idx = NULL;\r\n   835\t    ic->u_vals = NULL;\r\n   836\t    return ic;\r\n   837\t}\r\n   838\t\r\n   839\tstatic Precond *precond_setup(CSRMatrix *m, int type, double omega) {\r\n   840\t    Precond *p = xmalloc(sizeof(Precond));\r\n   841\t    p->type = type;\r\n   842\t    p->A = m;\r\n   843\t    p->diag = NULL;\r\n"]
