[6421.707997, "o", "\u001b[32m\u001b[K1018\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    double \u001b[01;31m\u001b[Krho\u001b[m\u001b[K_old = dot(n, r0, r);\r\n\u001b[32m\u001b[K1019\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Krho\u001b[m\u001b[K_old == 0.0) {\r\n\u001b[32m\u001b[K1021\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical \u001b[01;31m\u001b[Kbreakdown\u001b[m\u001b[K\");\r\n\u001b[32m\u001b[K1031\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical \u001b[01;31m\u001b[Kbreakdown\u001b[m\u001b[K\");\r\n\u001b[32m\u001b[K1033\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        double alpha = \u001b[01;31m\u001b[Krho\u001b[m\u001b[K_old / r0v;\r\n"]
