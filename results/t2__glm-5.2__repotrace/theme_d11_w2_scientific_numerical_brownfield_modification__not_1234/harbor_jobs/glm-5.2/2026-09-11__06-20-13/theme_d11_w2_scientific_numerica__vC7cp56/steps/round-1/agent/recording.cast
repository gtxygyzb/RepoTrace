[6938.1232, "o", "\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open matrix file\");\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"empty matrix file\");\r\n\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix file is not Matrix Market format\");\r\n\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid Matrix Market header\");\r\n"]
[6938.123278, "o", "\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"only real coordinate matrices are supported\");\r\n\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"only symmetric or general matrices are supported\");\r\n\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read matrix dimensions\");\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid matrix dimensions\");\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix must be square\");\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid nnz\");\r\n"]
[6938.123341, "o", "\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read matrix entry\");\r\n\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix entry index out of range\");\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"extra trailing data in matrix file\");\r\n\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open rhs file\");\r\n\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read vector dimension\");\r\n"]
[6938.123406, "o", "\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid vector dimension\");\r\n\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read vector entry\");\r\n\u001b[32m\u001b[K303\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"extra trailing data in vector file\");\r\n\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output matrix file\");\r\n"]
[6938.123465, "o", "\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output rhs file\");\r\n"]
[6938.123611, "o", "\u001b[32m\u001b[K858\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in Jacobi preconditioner\");\r\n\u001b[32m\u001b[K861\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (omega <= 0.0 || omega >= 2.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid SSOR parameter\");\r\n"]
[6938.123707, "o", "\u001b[32m\u001b[K866\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!m->symmetric) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"IC(0) requires symmetric matrix\");\r\n\u001b[32m\u001b[K886\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in Jacobi preconditioner\");\r\n"]
[6938.123778, "o", "\u001b[32m\u001b[K926\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (ic->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero or \u001b[01;31m\u001b[Knegative pivot\u001b[m\u001b[K in IC(0) factorization\");\r\n\u001b[32m\u001b[K938\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"unknown preconditioner\");\r\n"]
[6938.123842, "o", "\u001b[32m\u001b[K1181\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"GMRES numerical breakdown\");\r\n\u001b[32m\u001b[K1203\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output vector file\");\r\n\u001b[32m\u001b[K1208\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1213\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n"]
[6938.123907, "o", "\u001b[32m\u001b[K1224\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output vector file\");\r\n\u001b[32m\u001b[K1229\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!s || !*s) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument\");\r\n\u001b[32m\u001b[K1246\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (errno != 0 || end == s || *end != '\\0') \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid integer argument\");\r\n\u001b[32m\u001b[K1247\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (val < INT_MIN || val > INT_MAX) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"integer argument out of range\");\r\n"]
[6938.123971, "o", "\u001b[32m\u001b[K1252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!s || !*s) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument\");\r\n\u001b[32m\u001b[K1256\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (errno != 0 || end == s || *end != '\\0') \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid numeric argument\");\r\n\u001b[32m\u001b[K1263\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[Kmsg);\r\n\u001b[32m\u001b[K1287\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --input\");\r\n"]
[6938.124037, "o", "\u001b[32m\u001b[K1290\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --rhs\");\r\n\u001b[32m\u001b[K1293\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing solver name\");\r\n\u001b[32m\u001b[K1296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing preconditioner name\");\r\n\u001b[32m\u001b[K1299\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing reordering name\");\r\n\u001b[32m\u001b[K1302\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --output\");\r\n\u001b[32m\u001b[K1309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --generate-laplacian\");\r\n"]
[6938.1241, "o", "\u001b[32m\u001b[K1312\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --generate-laplacian3d\");\r\n\u001b[32m\u001b[K1315\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --generate-rhs\");\r\n\u001b[32m\u001b[K1318\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for max iterations\");\r\n\u001b[32m\u001b[K1321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for tolerance\");\r\n\u001b[32m\u001b[K1324\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for omega\");\r\n\u001b[32m\u001b[K1327\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --restart\");\r\n"]
[6938.124163, "o", "\u001b[32m\u001b[K1333\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[Kmsg);\r\n\u001b[32m\u001b[K1338\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (restart < 1) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid restart value\");\r\n\u001b[32m\u001b[K1339\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!(solver_name && strcmp(solver_name, \"gmres\") == 0)) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"--restart requires --solver gmres\");\r\n\u001b[32m\u001b[K1348\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (modes == 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"no operation specified\");\r\n\u001b[32m\u001b[K1349\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (modes > 1) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting operation modes specified\");\r\n"]
[6938.124226, "o", "\u001b[32m\u001b[K1353\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting command-line arguments\");\r\n\u001b[32m\u001b[K1355\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!output) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing output file for generator\");\r\n\u001b[32m\u001b[K1359\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1361\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N > INT_MAX / 3) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"generator size too large\");\r\n\u001b[32m\u001b[K1365\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1367\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N > INT_MAX / 4) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"generator size too large\");\r\n"]
[6938.124288, "o", "\u001b[32m\u001b[K1371\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1378\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!input) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing input file for analyze\");\r\n\u001b[32m\u001b[K1380\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting command-line arguments\");\r\n\u001b[32m\u001b[K1388\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!input) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing input file for solver\");\r\n\u001b[32m\u001b[K1389\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!rhs) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing rhs file for solver\");\r\n\u001b[32m\u001b[K1390\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!solver_name) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing solver name\");\r\n"]
[6938.124349, "o", "\u001b[32m\u001b[K1414\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (max_it <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid max iterations\");\r\n\u001b[32m\u001b[K1415\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (tol < 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid tolerance\");\r\n\u001b[32m\u001b[K1423\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix and RHS dimensions do not match\");\r\n"]
[6938.124766, "o", "\u001b[?2004hroot@n30009:/app# "]
