[2898.571063, "o", "\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!p) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"out of memory\");\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!p) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"out of memory\");\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!*arr) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"out of memory\");\r\n\u001b[32m\u001b[K171\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open matrix file\");\r\n"]
[2898.571162, "o", "\u001b[32m\u001b[K176\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"empty matrix file\");\r\n\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix file is not Matrix Market format\");\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid Matrix Market header\");\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"only real coordinate matrices are supported\");\r\n\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"only symmetric or general matrices are supported\");\r\n\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read matrix dimensions\");\r\n\u001b[32m\u001b[K216\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid matrix dimensions\");\r\n\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix must be square\");\r\n\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid nnz\");\r\n"]
[2898.57123, "o", "\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read matrix entry\");\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix entry index out of range\");\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    char \u001b[01;31m\u001b[Kextra\u001b[m\u001b[K_matrix;\r\n\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (fscanf(f, \" %c\", &\u001b[01;31m\u001b[Kextra\u001b[m\u001b[K_matrix) == 1) {\r\n"]
[2898.571295, "o", "\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"\u001b[01;31m\u001b[Kextra\u001b[m\u001b[K trailing data in matrix file\");\r\n\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open rhs file\");\r\n\u001b[32m\u001b[K275\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read vector dimension\");\r\n"]
[2898.571361, "o", "\u001b[32m\u001b[K277\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid vector dimension\");\r\n\u001b[32m\u001b[K283\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read vector entry\");\r\n\u001b[32m\u001b[K287\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    char \u001b[01;31m\u001b[Kextra\u001b[m\u001b[K_vector;\r\n\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (fscanf(f, \" %c\", &\u001b[01;31m\u001b[Kextra\u001b[m\u001b[K_vector) == 1) {\r\n\u001b[32m\u001b[K291\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"\u001b[01;31m\u001b[Kextra\u001b[m\u001b[K trailing data in vector file\");\r\n\u001b[32m\u001b[K301\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output matrix file\");\r\n"]
