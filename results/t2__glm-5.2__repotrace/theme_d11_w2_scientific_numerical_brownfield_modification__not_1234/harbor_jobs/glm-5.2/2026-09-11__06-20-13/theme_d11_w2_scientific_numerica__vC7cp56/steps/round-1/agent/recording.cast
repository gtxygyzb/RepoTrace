[1607.622271, "o", "static int cmp_entry(const void *a, const void *b) {\r\n\u001b[?2004l\r"]
[1607.622327, "o", "\u001b[?2004h> "]
[1607.622597, "o", "    const Entry *ea = (const Entry *)a;\r\n\u001b[?2004l\r"]
[1607.622679, "o", "\u001b[?2004h> "]
[1607.622923, "o", "    const Entry *eb = (const Entry *)b;\r\n\u001b[?2004l\r"]
[1607.622979, "o", "\u001b[?2004h> "]
[1607.623189, "o", "    if (ea->r != eb->r) return ea->r - eb->r;\r\n\u001b[?2004l\r"]
[1607.623247, "o", "\u001b[?2004h> "]
[1607.62335, "o", "    return ea->c - eb->c;\r\n\u001b[?2004l\r"]
[1607.623416, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.623472, "o", "> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[1607.623906, "o", "static void add_entry(Entry **arr, int *count, int *cap, int r, int c, double v) {\r\n\u001b[?2004l\r"]
[1607.623973, "o", "\u001b[?2004h> "]
[1607.62407, "o", "    if (*count == *cap) {\r\n\u001b[?2004l\r"]
[1607.624125, "o", "\u001b[?2004h> "]
[1607.624315, "o", "        *cap = (*cap ? *cap * 2 : 16);\r\n\u001b[?2004l\r"]
[1607.624377, "o", "\u001b[?2004h> "]
[1607.624652, "o", "        *arr = realloc(*arr, (size_t)*cap * sizeof(Entry));\r\n\u001b[?2004l\r"]
[1607.624681, "o", "\u001b[?2004h> "]
[1607.624916, "o", "        if (!*arr) die(\"out of memory\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.62499, "o", "> "]
[1607.625047, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.625135, "o", "    (*arr)[*count].r = r;\r\n\u001b[?2004l\r"]
[1607.625199, "o", "\u001b[?2004h> "]
[1607.625332, "o", "    (*arr)[*count].c = c;\r\n\u001b[?2004l\r"]
[1607.625399, "o", "\u001b[?2004h> "]
[1607.625534, "o", "    (*arr)[*count].v = v;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.62579, "o", ">     (*count)++;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.626136, "o", "static CSRMatrix *build_csr(int n, Entry *entries, int count, int symmetric) {\r\n\u001b[?2004l\r"]
[1607.626204, "o", "\u001b[?2004h> "]
[1607.626456, "o", "    if (count > 0) qsort(entries, (size_t)count, sizeof(Entry), cmp_entry);\r\n\u001b[?2004l\r"]
[1607.626517, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.626754, "o", "    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n\u001b[?2004l\r"]
[1607.626816, "o", "\u001b[?2004h> "]
[1607.627, "o", "    int *tmp_count = xcalloc((size_t)n, sizeof(int));\r\n\u001b[?2004l\r"]
[1607.62706, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.627152, "o", "    int unique = 0;\r\n\u001b[?2004l\r"]
[1607.627214, "o", "\u001b[?2004h> "]
[1607.62732, "o", "    for (int i = 0; i < count; ) {\r\n\u001b[?2004l\r"]
[1607.627378, "o", "\u001b[?2004h> "]
[1607.627473, "o", "        int r = entries[i].r;\r\n\u001b[?2004l\r"]
[1607.627531, "o", "\u001b[?2004h> "]
[1607.627624, "o", "        int c = entries[i].c;\r\n\u001b[?2004l\r"]
[1607.627698, "o", "\u001b[?2004h> "]
[1607.627771, "o", "        double sum = 0.0;\r\n\u001b[?2004l\r"]
[1607.627826, "o", "\u001b[?2004h> "]
[1607.628071, "o", "        while (i < count && entries[i].r == r && entries[i].c == c) {\r\n\u001b[?2004l\r"]
[1607.628127, "o", "\u001b[?2004h> "]
[1607.628232, "o", "            sum += entries[i].v;\r\n\u001b[?2004l\r"]
[1607.628287, "o", "\u001b[?2004h> "]
[1607.628347, "o", "            i++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.628403, "o", ">         }\r\n\u001b[?2004l\r"]
[1607.628464, "o", "\u001b[?2004h> "]
[1607.628565, "o", "        entries[unique].r = r;\r\n\u001b[?2004l\r"]
[1607.628622, "o", "\u001b[?2004h> "]
[1607.628732, "o", "        entries[unique].c = c;\r\n\u001b[?2004l\r"]
[1607.628787, "o", "\u001b[?2004h> "]
[1607.628895, "o", "        entries[unique].v = sum;\r\n\u001b[?2004l\r"]
[1607.628949, "o", "\u001b[?2004h> "]
[1607.629014, "o", "        unique++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.62907, "o", "> "]
[1607.629132, "o", "        tmp_count[r]++;\r\n\u001b[?2004l\r"]
[1607.629188, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1607.629245, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.6293, "o", "> "]
[1607.629554, "o", "    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + tmp_count[i];\r\n\u001b[?2004l\r"]
[1607.629609, "o", "\u001b[?2004h> "]
[1607.629682, "o", "    free(tmp_count);\r\n\u001b[?2004l\r"]
[1607.629738, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.629793, "o", "> "]
[1607.629974, "o", "    int *col_idx = xmalloc((size_t)unique * sizeof(int));\r\n\u001b[?2004l\r"]
[1607.630029, "o", "\u001b[?2004h> "]
[1607.630239, "o", "    double *vals = xmalloc((size_t)unique * sizeof(double));\r\n\u001b[?2004l\r"]
[1607.630296, "o", "\u001b[?2004h> "]
[1607.630459, "o", "    int *next = xcalloc((size_t)n, sizeof(int));\r\n\u001b[?2004l\r"]
[1607.630515, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.630574, "o", "> "]
[1607.630696, "o", "    for (int i = 0; i < unique; i++) {\r\n\u001b[?2004l\r"]
[1607.630757, "o", "\u001b[?2004h> "]
[1607.63085, "o", "        int r = entries[i].r;\r\n\u001b[?2004l\r"]
[1607.630906, "o", "\u001b[?2004h> "]
[1607.631041, "o", "        int pos = row_ptr[r] + next[r]++;\r\n\u001b[?2004l\r"]
[1607.631096, "o", "\u001b[?2004h> "]
[1607.631219, "o", "        col_idx[pos] = entries[i].c;\r\n\u001b[?2004l\r"]
[1607.631275, "o", "\u001b[?2004h> "]
[1607.631382, "o", "        vals[pos] = entries[i].v;\r\n\u001b[?2004l\r"]
[1607.631438, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1607.631494, "o", "\u001b[?2004h> "]
[1607.631562, "o", "    free(next);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.631619, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.631816, "o", "    CSRMatrix *m = xmalloc(sizeof(CSRMatrix));\r\n\u001b[?2004l\r"]
[1607.631872, "o", "\u001b[?2004h> "]
[1607.631929, "o", "    m->n = n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.632025, "o", "    m->nnz = unique;\r\n\u001b[?2004l\r"]
[1607.632079, "o", "\u001b[?2004h> "]
[1607.632162, "o", "    m->row_ptr = row_ptr;\r\n\u001b[?2004l\r"]
[1607.632217, "o", "\u001b[?2004h> "]
[1607.6323, "o", "    m->col_idx = col_idx;\r\n\u001b[?2004l\r"]
[1607.632359, "o", "\u001b[?2004h> "]
[1607.632423, "o", "    m->vals = vals;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.632481, "o", "> "]
[1607.632564, "o", "    m->symmetric = symmetric;\r\n\u001b[?2004l\r"]
[1607.632618, "o", "\u001b[?2004h> "]
[1607.632686, "o", "    return m;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.632742, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1607.632797, "o", "\u001b[?2004h> "]
[1607.632958, "o", "static double *compute_diag(CSRMatrix *m) {\r\n\u001b[?2004l\r"]
[1607.633013, "o", "\u001b[?2004h> "]
[1607.633196, "o", "    double *diag = xcalloc((size_t)m->n, sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.633251, "o", "> "]
[1607.633315, "o", "    for (int i = 0; i < m->n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.633371, "o", "> "]
[1607.633522, "o", "        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.633577, "o", "> "]
[1607.633718, "o", "            if (m->col_idx[idx] == i) diag[i] += m->vals[idx];\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.633779, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.633845, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.633907, "o", "    return diag;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.633963, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.63411, "o", "static CSRMatrix *read_matrix(const char *filename) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.634165, "o", "> "]
[1607.634227, "o", "    FILE *f = fopen(filename, \"r\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.634282, "o", "> "]
[1607.634365, "o", "    if (!f) die(\"cannot open matrix file\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.634421, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.634476, "o", "    char line[1024];\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.634531, "o", "> "]
[1607.634606, "o", "    if (!fgets(line, sizeof(line), f)) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.634689, "o", ">         fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.634746, "o", "> "]
[1607.634809, "o", "        die(\"empty matrix file\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.634866, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.635001, "o", "    if (strncmp(line, \"%%MatrixMarket\", 14) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.635056, "o", "> "]
[1607.63511, "o", "        fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1607.635242, "o", "        die(\"matrix file is not Matrix Market format\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.635297, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1607.635351, "o", "\u001b[?2004h> "]
