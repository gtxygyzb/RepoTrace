[3651.968779, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n#include <ctype.h>\r\n#include <errno.h>\r\n#include <limits.h>\r\n\r\n#ifndef M_PI\r\n"]
[3651.968876, "o", "#define M_PI 3.14159265358979323846\r\n#endif\r\n\r\n#define SOLVER_CG 0\r\n#define SOLVER_BICGSTAB 1\r\n\r\n#define PRECOND_NONE 0\r\n#define PRECOND_JACOBI 1\r\n#define PRECOND_SSOR 2\r\n#define PRECOND_IC0 3\r\n\r\ntypedef struct {\r\n    int n;\r\n    int nnz;\r\n    int *row_ptr;\r\n    int *col_idx;\r\n    double *vals;\r\n    int symmetric;\r\n} CSRMatrix;\r\n\r\ntypedef struct {\r\n    int r;\r\n"]
[3651.968973, "o", "    int c;\r\n    double v;\r\n} Entry;\r\n\r\ntypedef struct {\r\n    int n;\r\n    int *row_ptr;\r\n    int *col_idx;\r\n    double *vals;\r\n} TriMatrix;\r\n\r\ntypedef struct {\r\n    int n;\r\n    int *l_row_ptr;\r\n    int *l_col_idx;\r\n    double *l_vals;\r\n    double *diag;\r\n    int *u_row_ptr;\r\n    int *u_col_idx;\r\n    double *u_vals;\r\n} ICFactor;"]
[3651.969045, "o", "\r\n\r\ntypedef struct {\r\n    int type;\r\n    CSRMatrix *A;\r\n    double *diag;\r\n    TriMatrix *lower;\r\n    TriMatrix *upper;\r\n    double omega;\r\n    ICFactor *ic;\r\n} Precond;\r\n\r\nstatic void die(const char *msg) {\r\n    fprintf(stderr, \"error: %s\\n\", msg);\r\n"]
[3651.969116, "o", "    exit(1);\r\n}\r\n\r\nstatic void *xmalloc(size_t s) {\r\n    if (s == 0) s = 1;\r\n    void *p = malloc(s);\r\n    if (!p) die(\"out of memory\");\r\n    return p;\r\n}\r\n\r\nstatic void *xcalloc(size_t n, size_t s) {\r\n    if (n == 0) n = 1;\r\n    void *p = calloc(n, s);\r\n"]
[3651.969187, "o", "    if (!p) die(\"out of memory\");\r\n    return p;\r\n}\r\n\r\nstatic double dot(int n, const double *a, const double *b) {\r\n    double s = 0.0;\r\n    for (int i = 0; i < n; i++) s += a[i] * b[i];\r\n    return s;\r\n}\r\n\r\nstatic void dcopy(int n, const double *src, double *dst) {\r\n    for (int i = 0; i < n; i++) dst[i] = src[i];\r\n}\r\n\r\nstatic int cmp_entry(const void *a, const void *b) {\r\n    const Entry *ea = (const Entry *)a;\r\n"]
[3651.969258, "o", "    const Entry *eb = (const Entry *)b;\r\n    if (ea->r != eb->r) return ea->r - eb->r;\r\n    return ea->c - eb->c;\r\n}\r\n\r\nstatic void add_entry(Entry **arr, int *count, int *cap, int r, int c, double v) {\r\n    if (*count == *cap) {\r\n        *cap = (*cap ? *cap * 2 : 16);\r\n        *arr = realloc(*arr, (size_t)*cap * sizeof(Entry));\r\n        if (!*arr) die(\"out of memory\");\r\n    }\r\n    (*arr)[*count].r = r;\r\n    (*arr)[*count].c = c;\r\n    (*arr)[*count].v = v;\r\n"]
[3651.969329, "o", "    (*count)++;\r\n}\r\n\r\nstatic CSRMatrix *build_csr(int n, Entry *entries, int count, int symmetric) {\r\n    if (count > 0) qsort(entries, (size_t)count, sizeof(Entry), cmp_entry);\r\n\r\n    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n    int *tmp_count = xcalloc((size_t)n, sizeof(int));\r\n\r\n    int unique = 0;\r\n    for (int i = 0; i < count; ) {\r\n        int r = entries[i].r;\r\n        int c = entries[i].c;\r\n        double sum = 0.0;\r\n        while (i < count && entries[i].r == r && entries[i].c == c) {\r\n"]
[3651.969404, "o", "            sum += entries[i].v;\r\n            i++;\r\n        }\r\n        entries[unique].r = r;\r\n        entries[unique].c = c;\r\n        entries[unique].v = sum;\r\n        unique++;\r\n        tmp_count[r]++;\r\n    }\r\n\r\n    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + tmp_count[i];\r\n    free(tmp_count);\r\n\r\n    int *col_idx = xmalloc((size_t)unique * sizeof(int));\r\n    double *vals = xmalloc((size_t)unique * sizeof(double));\r\n"]
[3651.969528, "o", "    int *next = xcalloc((size_t)n, sizeof(int));\r\n\r\n    for (int i = 0; i < unique; i++) {\r\n        int r = entries[i].r;\r\n        int pos = row_ptr[r] + next[r]++;\r\n        col_idx[pos] = entries[i].c;\r\n        vals[pos] = entries[i].v;\r\n    }\r\n    free(next);\r\n\r\n    CSRMatrix *m = xmalloc(sizeof(CSRMatrix));\r\n    m->n = n;\r\n    m->nnz = unique;\r\n    m->row_ptr = row_ptr;\r\n    m->col_idx = col_idx;\r\n    m->vals = vals;\r\n    m->symmetric = symmetric;\r\n    return m;\r\n}\r\n\r\nstatic double *compute_diag(CSRMatrix *m) {\r\n    double *diag = xcalloc((size_t)m->n, sizeof(double));\r\n    for (int i = 0; i < m->n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            if (m->col_idx[idx] == i) diag[i] += m->vals[idx];\r\n        }\r\n    }\r\n    return diag;\r\n"]
[3651.969608, "o", "}\r\n\r\nstatic int has_trailing_data(FILE *f) {\r\n    int c;\r\n    while ((c = fgetc(f)) != EOF) {\r\n        if (isspace((unsigned char)c)) continue;\r\n        if (c == '%') {\r\n            while ((c = fgetc(f)) != EOF && c != '\\n');\r\n            continue;\r\n        }\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic CSRMatrix *read_matrix(const char *filename) {\r\n    FILE *f = fopen(filename, \"r\");\r\n"]
[3651.969693, "o", "    if (!f) die(\"cannot open matrix file\");\r\n\r\n    char line[1024];\r\n    if (!fgets(line, sizeof(line), f)) {\r\n        fclose(f);\r\n        die(\"empty matrix file\");\r\n    }\r\n    if (strncmp(line, \"%%MatrixMarket\", 14) != 0) {\r\n        fclose(f);\r\n        die(\"matrix file is not Matrix Market format\");\r\n    }\r\n\r\n    char obj[64], fmt[64], field[64], sym[64];\r\n    if (sscanf(line, \"%*s %63s %63s %63s %63s\", obj, fmt, field, sym) != 4) {\r\n"]
[3651.969762, "o", "        fclose(f);\r\n        die(\"invalid Matrix Market header\");\r\n    }\r\n    if (strcmp(obj, \"matrix\") != 0 || strcmp(fmt, \"coordinate\") != 0 || strcmp(field, \"real\") != 0) {\r\n        fclose(f);\r\n        die(\"only real coordinate matrices are supported\");\r\n    }\r\n\r\n    int symmetric;\r\n    if (strcmp(sym, \"symmetric\") == 0) symmetric = 1;\r\n    else if (strcmp(sym, \"general\") == 0) symmetric = 0;\r\n    else {\r\n        fclose(f);"]
[3651.969828, "o", "\r\n        die(\"only symmetric or general matrices are supported\");\r\n    }\r\n\r\n    while (fgets(line, sizeof(line), f)) {\r\n        char *p = line;\r\n        while (isspace((unsigned char)*p)) p++;\r\n        if (*p == '%') continue;\r\n        if (*p == '\\0') continue;\r\n        break;\r\n    }\r\n"]
[3651.970505, "o", "\u001b[?2004h"]
[3651.970572, "o", "root@n30009:/app# "]
[3652.244177, "i", "sed -n '220,520p' nlsolve.c\n"]
[3652.244442, "o", "sed -n '220,520p' nlsolve.c\r\n\u001b[?2004l\r"]
[3652.247378, "o", "    }\r\n\r\n    int rows, cols, nnz;\r\n    if (sscanf(line, \"%d %d %d\", &rows, &cols, &nnz) != 3) {\r\n        fclose(f);\r\n        die(\"failed to read matrix dimensions\");\r\n    }\r\n"]
[3652.247519, "o", "    if (rows <= 0 || cols <= 0) {\r\n        fclose(f);\r\n        die(\"invalid matrix dimensions\");\r\n    }\r\n    if (rows != cols) {\r\n        fclose(f);\r\n        die(\"matrix must be square\");\r\n    }\r\n"]
[3652.247608, "o", "    if (nnz < 0) {\r\n        fclose(f);\r\n        die(\"invalid nnz\");\r\n    }\r\n\r\n    Entry *entries = NULL;\r\n    int count = 0, cap = 0;\r\n    for (int k = 0; k < nnz; k++) {\r\n        int r, c;\r\n        double v;\r\n        if (fscanf(f, \"%d %d %lf\", &r, &c, &v) != 3) {\r\n            fclose(f);\r\n            free(entries);\r\n            die(\"failed to read matrix entry\");\r\n        }\r\n        if (r < 1 || r > rows || c < 1 || c > cols) {\r\n            fclose(f);\r\n            free(entries);\r\n            die(\"matrix entry index out of range\");\r\n        }\r\n        r--;\r\n        c--;\r\n        if (symmetric) {\r\n            if (r < c) {\r\n                int t = r; r = c; c = t;\r\n            }\r\n            add_entry(&entries, &count, &cap, r, c, v);\r\n            if (r != c) add_entry(&entries, &count, &cap, c, r, v);\r\n        } else {\r\n            add_entry(&entries, &count, &cap, r, c, v);\r\n        }\r\n    }\r\n\r\n    if (has_trailing_data(f)) {\r\n        free(entries);\r\n        fclose(f);\r\n"]
[3652.247734, "o", "        die(\"extra trailing data in matrix file\");\r\n    }\r\n\r\n    fclose(f);\r\n\r\n    CSRMatrix *m = build_csr(rows, entries, count, symmetric);\r\n    free(entries);\r\n    return m;\r\n}\r\n\r\nstatic double *read_vector(const char *filename, int *n_out) {\r\n"]
[3652.247809, "o", "    FILE *f = fopen(filename, \"r\");\r\n    if (!f) die(\"cannot open rhs file\");\r\n    int n;\r\n    if (fscanf(f, \"%d\", &n) != 1) {\r\n        fclose(f);\r\n        die(\"failed to read vector dimension\");\r\n    }\r\n    if (n <= 0) die(\"invalid vector dimension\");\r\n    double *x = xmalloc((size_t)n * sizeof(double));\r\n    for (int i = 0; i < n; i++) {\r\n        if (fscanf(f, \"%lf\", &x[i]) != 1) {\r\n            fclose(f);\r\n            free(x);\r\n            die(\"failed to read vector entry\");\r\n        }\r\n    }\r\n\r\n    if (has_trailing_data(f)) {\r\n        fclose(f);\r\n        free(x);\r\n        die(\"extra trailing data in vector file\");\r\n    }\r\n\r\n    fclose(f);\r\n    *n_out = n;\r\n    return x;\r\n}\r\n"]
[3652.24788, "o", "\r\nstatic void write_matrix_market(const char *filename, int n, int nnz, Entry *entries) {\r\n    FILE *f = fopen(filename, \"w\");\r\n    if (!f) die(\"cannot open output matrix file\");\r\n    fprintf(f, \"%%%%MatrixMarket matrix coordinate real symmetric\\n\");\r\n    fprintf(f, \"%d %d %d\\n\", n, n, nnz);\r\n    for (int k = 0; k < nnz; k++) {\r\n        fprintf(f, \"%d %d %.15g\\n\", entries[k].r + 1, entries[k].c + 1, entries[k].v);\r\n    }\r\n    fclose(f);\r\n}\r\n\r\nstatic int cmp_entry_rc(const void *a, const void *b) {\r\n    const Entry *ea = (const Entry *)a;\r\n    const Entry *eb = (const Entry *)b;\r\n"]
[3652.247978, "o", "    if (ea->r != eb->r) return ea->r - eb->r;\r\n    return ea->c - eb->c;\r\n}\r\n\r\nstatic void generate_laplacian2d(int n, const char *output) {\r\n    int N = n * n;\r\n    int cap = N * 3;\r\n    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));\r\n    int count = 0;\r\n    for (int i = 0; i < n; i++) {\r\n        for (int j = 0; j < n; j++) {\r\n            int row = i * n + j;\r\n            entries[count].r = row;\r\n            entries[count].c = row;\r\n            entries[count].v = 4.0;\r\n            count++;\r\n            if (j > 0) {\r\n                int col = i * n + (j - 1);\r\n                entries[count].r = row;\r\n                entries[count].c = col;\r\n"]
[3652.248049, "o", "                entries[count].v = -1.0;\r\n                count++;\r\n            }\r\n            if (i > 0) {\r\n                int col = (i - 1) * n + j;\r\n                entries[count].r = row;\r\n                entries[count].c = col;\r\n                entries[count].v = -1.0;\r\n                count++;\r\n            }\r\n        }\r\n    }\r\n    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);\r\n    write_matrix_market(output, N, count, entries);\r\n"]
[3652.248117, "o", "    free(entries);\r\n}\r\n\r\nstatic void generate_laplacian3d(int n, const char *output) {\r\n    int N = n * n * n;\r\n    int cap = N * 4;\r\n    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));\r\n    int count = 0;\r\n    for (int i = 0; i < n; i++) {\r\n        for (int j = 0; j < n; j++) {\r\n            for (int k = 0; k < n; k++) {\r\n                int row = (i * n + j) * n + k;\r\n"]
[3652.248235, "o", "                entries[count].r = row;\r\n                entries[count].c = row;\r\n                entries[count].v = 6.0;\r\n                count++;\r\n                if (k > 0) {\r\n                    int col = row - 1;\r\n                    entries[count].r = row;\r\n                    entries[count].c = col;\r\n                    entries[count].v = -1.0;\r\n                    count++;\r\n                }\r\n                if (j > 0) {\r\n                    int col = row - n;\r\n                    entries[count].r = row;\r\n                    entries[count].c = col;\r\n                    entries[count].v = -1.0;\r\n                    count++;\r\n                }\r\n                if (i > 0) {\r\n                    int col = row - n * n;\r\n                    entries[count].r = row;\r\n                    entries[count].c = col;\r\n                    entries[count].v = -1.0;\r\n"]
[3652.248306, "o", "                    count++;\r\n                }\r\n            }\r\n        }\r\n    }\r\n    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);\r\n    write_matrix_market(output, N, count, entries);\r\n    free(entries);\r\n}\r\n\r\nstatic void generate_rhs(int N, const char *output) {\r\n    FILE *f = fopen(output, \"w\");\r\n    if (!f) die(\"cannot open output rhs file\");\r\n    fprintf(f, \"%d\\n\", N);\r\n    for (int i = 1; i <= N; i++) {\r\n"]
[3652.248375, "o", "        fprintf(f, \"%.15g\\n\", sin((double)i * M_PI / (double)(N + 1)));\r\n    }\r\n    fclose(f);\r\n}\r\n\r\nstatic void free_csr(CSRMatrix *m) {\r\n    if (!m) return;\r\n    free(m->row_ptr);\r\n    free(m->col_idx);\r\n    free(m->vals);\r\n    free(m);\r\n}\r\n\r\nstatic void spmv(const CSRMatrix *m, const double *x, double *y) {\r\n    for (int i = 0; i < m->n; i++) {\r\n        double s = 0.0;\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            s += m->vals[idx] * x[m->col_idx[idx]];\r\n        }\r\n"]
[3652.248445, "o", "        y[i] = s;\r\n    }\r\n}\r\n\r\nstatic double vec_norm2(int n, const double *x) {\r\n    return sqrt(dot(n, x, x));\r\n}\r\n\r\nstatic void analyze_matrix(CSRMatrix *m) {\r\n    double *diag = compute_diag(m);\r\n    int bandwidth = 0;\r\n    long profile = 0;\r\n    int strict_count = 0;\r\n    int weak_all = 1;\r\n\r\n    for (int i = 0; i < m->n; i++) {\r\n        int min_col = i;\r\n        int has_off = 0;\r\n"]
[3652.248516, "o", "        double off_sum = 0.0;\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int j = m->col_idx[idx];\r\n            int diff = i - j;\r\n            if (diff < 0) diff = -diff;\r\n            if (diff > bandwidth) bandwidth = diff;\r\n            if (j < i) {\r\n                if (!has_off || j < min_col) min_col = j;\r\n                has_off = 1;\r\n                off_sum += fabs(m->vals[idx]);\r\n            } else if (j > i) {\r\n                has_off = 1;\r\n                if (j < min_col) min_col = j;\r\n                off_sum += fabs(m->vals[idx]);\r\n"]
[3652.248584, "o", "            }\r\n        }\r\n        if (has_off) profile += (long)(i - min_col);\r\n\r\n        double d = fabs(diag[i]);\r\n        if (d > off_sum + 1e-300) {\r\n            strict_count++;\r\n        } else if (d >= off_sum - 1e-300) {\r\n            // weak candidate\r\n        } else {\r\n            weak_all = 0;\r\n        }\r\n    }\r\n\r\n    const char *dominance;\r\n"]
[3652.248682, "o", "    if (strict_count == m->n) dominance = \"strict\";\r\n    else if (weak_all) dominance = \"weak\";\r\n    else dominance = \"no\";\r\n\r\n    printf(\"dimension: %d\\n\", m->n);\r\n    printf(\"nonzeros: %d\\n\", m->nnz);\r\n    printf(\"symmetric: %s\\n\", m->symmetric ? \"yes\" : \"no\");\r\n    printf(\"bandwidth: %d\\n\", bandwidth);\r\n    printf(\"profile: %ld\\n\", profile);\r\n    printf(\"diag_dominant: %s\\n\", dominance);\r\n    free(diag);\r\n}\r\n\r\nstatic CSRMatrix *permute_csr(const CSRMatrix *m, const int *perm) {\r\n    int n = m->n;\r\n    int *inv = xmalloc((size_t)n * sizeof(int));\r\n    for (int i = 0; i < n; i++) inv[perm[i]] = i;\r\n\r\n"]
[3652.248755, "o", "    int *counts = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int ni = perm[i];\r\n            counts[ni]++;\r\n        }\r\n    }\r\n\r\n    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + counts[i];\r\n    free(counts);\r\n\r\n    int nnz = m->nnz;\r\n    int *col_idx = xmalloc((size_t)nnz * sizeof(int));\r\n    double *vals = xmalloc((size_t)nnz * sizeof(double));\r\n    int *next = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n"]
[3652.248827, "o", "        int ni = perm[i];\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int nj = perm[m->col_idx[idx]];\r\n            int pos = row_ptr[ni] + next[ni]++;\r\n            col_idx[pos] = nj;\r\n            vals[pos] = m->vals[idx];\r\n        }\r\n    }\r\n    free(next);\r\n    free(inv);\r\n\r\n    CSRMatrix *p = xmalloc(sizeof(CSRMatrix));\r\n"]
[3652.249466, "o", "\u001b[?2004h"]
