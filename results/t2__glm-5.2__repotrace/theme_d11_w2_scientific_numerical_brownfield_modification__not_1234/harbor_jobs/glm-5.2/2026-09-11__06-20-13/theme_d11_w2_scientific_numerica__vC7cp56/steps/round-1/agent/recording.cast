[6387.575174, "o", "\u001b[32m\u001b[K1001\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic double *\u001b[01;31m\u001b[Ksolve_bicgstab\u001b[m\u001b[K(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n"]
[6387.575282, "o", "\u001b[32m\u001b[K1262\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kint main\u001b[m\u001b[K(int argc, char **argv) {\r\n"]
[6387.575368, "o", "\u001b[32m\u001b[K1448\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    Precond *p = \u001b[01;31m\u001b[Kprecond_setup\u001b[m\u001b[K(A, precond, omega);\r\n\u001b[32m\u001b[K1451\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (solver == SOLVER_CG) x2 = \u001b[01;31m\u001b[Ksolve_cg\u001b[m\u001b[K(A, bwork, p, max_it, tol, history, &iterations);\r\n"]
[6387.575437, "o", "\u001b[32m\u001b[K1452\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    else if (solver == SOLVER_BICGSTAB) x2 = \u001b[01;31m\u001b[Ksolve_bicgstab\u001b[m\u001b[K(A, bwork, p, max_it, tol, history, &iterations);\r\n"]
