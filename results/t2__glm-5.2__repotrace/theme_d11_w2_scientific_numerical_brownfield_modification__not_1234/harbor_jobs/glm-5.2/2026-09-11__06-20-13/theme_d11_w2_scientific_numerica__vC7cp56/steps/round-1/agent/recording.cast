[6859.673834, "o", "   798\t            }\r\n   799\t\r\n   800\t            double s = aij;\r\n   801\t            int pi = row_ptr[i];\r\n   802\t            int pj = row_ptr[j];\r\n   803\t            while (pi < k && pj < row_ptr[j + 1]) {\r\n   804\t                int ci = col_idx[pi];\r\n   805\t                int cj = col_idx[pj];\r\n   806\t                if (ci == cj) {\r\n   807\t                    s -= vals[pi] * vals[pj];\r\n   808\t                    pi++;\r\n   809"]
[6859.673904, "o", "\t                    pj++;\r\n   810\t                } else if (ci < cj) {\r\n   811\t                    pi++;\r\n   812\t                } else {\r\n   813\t                    pj++;\r\n   814\t                }\r\n   815\t            }\r\n   816\t\r\n   817\t            if (diag[j] <= 0.0) {\r\n   818\t                free(row_ptr); free(col_idx); free(vals); free(diag);\r\n   819"]
[6859.673967, "o", "\t                return NULL;\r\n   820\t            }\r\n   821\t            double l = s / diag[j];\r\n   822\t            vals[k] = l;\r\n   823\t            sum -= l * l;\r\n   824\t        }\r\n   825\t\r\n   826\t        if (sum <= 0.0) {\r\n   827\t            free(row_ptr); free(col_idx); free(vals); free(diag);\r\n   828\t            return NULL;\r\n   829"]
[6859.67403, "o", "\t        }\r\n   830\t        diag[i] = sqrt(sum);\r\n   831\t    }\r\n   832\t\r\n   833\t    ICFactor *ic = xmalloc(sizeof(ICFactor));\r\n   834\t    ic->n = n;\r\n   835\t    ic->l_row_ptr = row_ptr;\r\n   836\t    ic->l_col_idx = col_idx;\r\n"]
