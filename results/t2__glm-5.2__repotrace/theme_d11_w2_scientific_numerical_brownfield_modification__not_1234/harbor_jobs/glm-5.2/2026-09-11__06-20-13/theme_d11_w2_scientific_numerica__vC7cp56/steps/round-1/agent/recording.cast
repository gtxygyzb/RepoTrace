[5478.424577, "o", "   876\t                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];\r\n   877\t            }\r\n   878\t        }\r\n   879\t        return;\r\n   880\t    }\r\n   881\t\r\n   882\t    die(\"unknown preconditioner\");\r\n   883\t}\r\n   884\t\r\n   885\tstatic void free_precond(Precond *p) {\r\n   886\t    if (!p) return;\r\n   887\t    free(p->diag);\r\n   888\t    free_tri_matrix(p->lower);\r\n   889\t    free_tri_matrix(p->upper);\r\n   890\t    if (p->ic) {\r\n   891\t        free(p->ic->l_row_ptr);\r\n   892\t        free(p->ic->l_col_idx);\r\n   893\t        free(p->ic->l_vals);\r\n   894\t        free(p->ic->diag);\r\n   895\t        free(p->ic->u_row_ptr);\r\n   896\t        free(p->ic->u_col_idx);\r\n   897\t        free(p->ic->u_vals);\r\n   898\t        free(p->ic);\r\n   899\t    }\r\n   900\t    free(p);\r\n   901\t}\r\n   902"]
[5478.424652, "o", "\t\r\n   903\tstatic double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n   904\t    int n = A->n;\r\n   905\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n   906\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n   907\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   908\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n   909\t    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n   910\t\r\n   911\t    spmv(A, x, r);\r\n   912\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   913\t    double bnorm = vec_norm2(n, b);\r\n   914\t    int it_count = 0;\r\n   915\t\r\n   916\t    precond_apply(p, r, z);\r\n   917\t    dcopy(n, z, pvec);\r\n   918\t    double rz_old = dot(n, r, z);\r\n   919\t\r\n   920\t    for (int it = 0; it < max_it; it++) {\r\n"]
[5478.424724, "o", "   921\t        spmv(A, pvec, Ap);\r\n   922\t        double pAp = dot(n, pvec, Ap);\r\n   923\t        if (pAp <= 0.0) {\r\n   924\t            free(r); free(z); free(pvec); free(Ap);\r\n   925\t            die(\"matrix is not positive definite\");\r\n   926\t        }\r\n   927\t        double alpha = rz_old / pAp;\r\n   928\t        for (int i = 0; i < n; i++) {\r\n   929\t            x[i] += alpha * pvec[i];\r\n   930\t            r[i] -= alpha * Ap[i];\r\n   931\t        }\r\n   932\t        it_count = it + 1;\r\n   933\t        if (history) {\r\n   934\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n   935\t        }\r\n   936\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n   937\t\r\n   938\t        precond_apply(p, r, z);\r\n   939\t        double rz_new = dot(n, r, z);\r\n   940\t        if (rz_old == 0.0) {\r\n   941\t            free(r); free(z); free(pvec); free(Ap);\r\n   942\t            die(\"CG numerical breakdown\");\r\n   943\t        }\r\n   944\t"]
[5478.424787, "o", "        double beta = rz_new / rz_old;\r\n   945\t        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n   946\t        rz_old = rz_new;\r\n   947\t    }\r\n   948\t\r\n   949\t    if (iterations_out) *iterations_out = it_count;\r\n   950\t    free(r); free(z); free(pvec); free(Ap);\r\n   951\t    return x;\r\n   952\t}\r\n   953\t\r\n   954\tstatic double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n   955\t    int n = A->n;\r\n   956\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n   957\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n   958\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n"]
[5478.424855, "o", "   959\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n   960\t    double *v = xmalloc((size_t)n * sizeof(double));\r\n   961\t    double *s = xmalloc((size_t)n * sizeof(double));\r\n   962\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n   963\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   964\t\r\n   965\t    spmv(A, x, r);\r\n   966\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   967\t    double bnorm = vec_norm2(n, b);\r\n   968\t    int it_count = 0;\r\n   969\t\r\n   970\t    dcopy(n, r, r0);\r\n   971\t    double rho_old = dot(n, r0, r);\r\n"]
[5478.424952, "o", "   972\t    if (rho_old == 0.0) {\r\n   973\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   974\t        die(\"BiCGSTAB numerical breakdown\");\r\n   975\t    }\r\n   976\t    dcopy(n, r, pvec);\r\n   977\t\r\n   978\t    for (int it = 0; it < max_it; it++) {\r\n   979\t        precond_apply(p, pvec, z);\r\n   980\t        spmv(A, z, v);\r\n   981\t        double r0v = dot(n, r0, v);\r\n   982\t        if (r0v == 0.0) {\r\n   983\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   984\t            die(\"BiCGSTAB numerical breakdown\");\r\n   985\t        }\r\n   986\t        double alpha = rho_old / r0v;\r\n   987\t        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n   988\t\r\n   989\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n   990\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n   991\t            it_count = it + 1;\r\n   992\t            if (history) {\r\n   993\t                printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, s));\r\n   994\t            }"]
[5478.425022, "o", "\r\n   995\t            break;\r\n   996\t        }\r\n   997\t\r\n   998\t        precond_apply(p, s, z);\r\n   999\t        spmv(A, z, t);\r\n  1000\t        double ts = dot(n, t, s);\r\n  1001\t        double tt = dot(n, t, t);\r\n  1002\t        if (tt == 0.0) {\r\n  1003\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1004\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1005\t        }\r\n  1006\t        double omega = ts / tt;\r\n  1007\t        for (int i = 0; i < n; i++) {\r\n  1008\t            x[i] += alpha * z[i] + omega * s[i];\r\n  1009\t            r[i] = s[i] - omega * t[i];\r\n  1010\t        }\r\n  1011\t        it_count = it + 1;\r\n  1012\t        if (history) {\r\n  1013\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n  1014\t        }\r\n  1015\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n  1016\t\r\n  1017\t        double rho_new = dot(n, r0, r);\r\n  1018\t        if (rho_new == 0.0) {\r\n  1019\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z)"]
[5478.425079, "o", ";\r\n  1020\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1021\t        }\r\n  1022\t        double beta = (rho_new / rho_old) * (alpha / omega);\r\n  1023\t        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n  1024\t        rho_old = rho_new;\r\n  1025\t    }\r\n  1026\t\r\n  1027\t    if (iterations_out) *iterations_out = it_count;\r\n  1028\t    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1029\t    return x;\r\n  1030\t}\r\n  1031\t\r\n"]
