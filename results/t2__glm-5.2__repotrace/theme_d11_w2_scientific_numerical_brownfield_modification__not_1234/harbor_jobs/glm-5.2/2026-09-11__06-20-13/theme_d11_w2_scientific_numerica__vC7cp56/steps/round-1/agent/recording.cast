[6947.677664, "o", "ied\");\r\n\u001b[32m\u001b[K1353\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting command-line arguments\");\r\n\u001b[32m\u001b[K1355\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!output) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing output file for generator\");\r\n\u001b[32m\u001b[K1359\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1361\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N > INT_MAX / 3) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"generator size too large\");\r\n"]
[6947.677727, "o", "\u001b[32m\u001b[K1365\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1367\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N > INT_MAX / 4) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"generator size too large\");\r\n\u001b[32m\u001b[K1371\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1378\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!input) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing input file for analyze\");\r\n\u001b[32m\u001b[K1380\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting command-line arguments\");\r\n\u001b[32m\u001b[K1388\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!input) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing input file for solver\");\r\n\u001b[32m\u001b[K1389\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!rhs) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing rhs file for solver\");\r\n\u001b[32m\u001b[K1390\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!solver_name) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing solver name\");\r\n\u001b[32m\u001b[K1414\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (max_it <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid max iterations\");\r\n\u001b[32m\u001b[K1415\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (tol < 0.0) \u001b[01;31m\u001b[Kdie(\u001b["]
