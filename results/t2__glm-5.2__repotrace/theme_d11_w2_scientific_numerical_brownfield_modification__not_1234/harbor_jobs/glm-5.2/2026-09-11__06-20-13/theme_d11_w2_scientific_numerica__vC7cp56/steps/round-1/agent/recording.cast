[3188.898383, "i", "cat > /tmp/run_invalid_tests.sh <<'SH'\n#!/bin/sh\nset -u\n\nrun_test() {\n  desc=\"$1\"\n  shift\n  out=$(./nlsolve \"$@\" 2>/tmp/err)\n  rc=$?\n  printf '%s -> exit=%d stdout=[%s] stderr=[%s]\\n' \"$desc\" \"$rc\" \"$out\" \"$(cat /tmp/err)\"\n}\n\ncat > /tmp/bad_header.mtx <<'EOF'\nnot MatrixMarket\n2 2 1\n1 1 1.0\nEOF\n\ncat > /tmp/malformed_header.mtx <<'EOF'\n%%MatrixMarket matrix coordinate real\n2 2 1\n1 1 1.0\nEOF\n\ncat > /tmp/nonnum.mtx <<'EOF'\n%%MatrixMarket matrix coordinate real symmetric\n2 2 2\n1 1 abc\n2 2 1.0\nEOF\n\ncat > /tmp/extra.mtx <<'EOF'\n%%MatrixMarket matrix coordinate real symmetric\n2 2 2\n1 1 1.0\n2 2 1.0\n1 2 1.0\nEOF\n\ncat > /tmp/toofew.mtx <<'EOF'\n%%MatrixMarket matrix coordinate real symmetric\n2 2 3\n1 1 1.0\n2 2 1.0\nEOF\n\ncat > /tmp/nonsquare.mtx <<'EOF'\n%%MatrixMarket matrix coordinate real general\n2 3 2\n1 1 1.0\n2 2 1.0\nEOF\n\ncat > /tmp/ic0_zero.mtx <<'EOF'\n%%MatrixMarket matrix coordinate real symmetric\n2 2 3\n1 1 0.0\n1 2 1.0\n2 2 0.0\nEOF\n\ncat > /tmp/neg.mtx <<'EOF'\n%%MatrixMarket matrix coordinate real symmetric\n2 2 2\n1 1 -1."]
[3188.898673, "i", "0\n2 2 -1.0\nEOF\n\ncat > /tmp/zero.mtx <<'EOF'\n%%MatrixMarket matrix coordinate real symmetric\n2 2 2\n1 1 0.0\n2 2 0.0\nEOF\n\ncat > /tmp/extra_vec.vec <<'EOF'\n2\n1.0\n2.0\n3.0\nEOF\n\ncat > /tmp/b2.vec <<'EOF'\n2\n1.0\n1.0\nEOF\n\nrun_test \"missing file\" --analyze --input /tmp/nope.mtx\nrun_test \"bad header\" --analyze --input /tmp/bad_header.mtx\nrun_test \"malformed header\" --analyze --input /tmp/malformed_header.mtx\nrun_test \"non-numeric matrix\" --analyze --input /tmp/nonnum.mtx\nrun_test \"matrix extra data\" --analyze --input /tmp/extra.mtx\nrun_test \"matrix too few entries\" --analyze --input /tmp/toofew.mtx\nrun_test \"vector extra data\" --input /tmp/lap2d.mtx --rhs /tmp/extra_vec.vec --solver cg\nrun_test \"dimension mismatch\" --input /tmp/lap2d.mtx --rhs /tmp/b3.vec --solver cg\nrun_test \"non-square solver\" --input /tmp/nonsquare.mtx --rhs /tmp/b3.vec --solver cg\nrun_test \"unknown solver\" --input /tmp/lap2d.mtx --rhs /tmp/b9.vec --solver foo\nrun_test \"unknown preconditioner\" --input /tmp/lap2d.mtx --rhs /tmp/b9.vec --solver cg --pre"]
[3188.8988, "i", "cond foo\nrun_test \"unknown reordering\" --input /tmp/lap2d.mtx --rhs /tmp/b9.vec --solver cg --reorder foo\nrun_test \"conflicting analyze solver\" --analyze --solver cg --input /tmp/lap2d.mtx\nrun_test \"generator conflict\" --generate-laplacian 3 --generate-rhs 3 --output /tmp/x\nrun_test \"invalid generator size\" --generate-laplacian 0 --output /tmp/x\nrun_test \"solver without input\" --solver cg --rhs /tmp/b9.vec\nrun_test \"solver without rhs\" --solver cg --input /tmp/lap2d.mtx\nrun_test \"no operation\"\nrun_test \"unknown option\" --bad-option\nrun_test \"analyze with output\" --analyze --input /tmp/lap2d.mtx --output /tmp/out\nrun_test \"generator with input\" --generate-laplacian 3 --input /tmp/lap2d.mtx --output /tmp/out\nrun_test \"IC0 zero pivot\" --input /tmp/ic0_zero.mtx --rhs /tmp/b2.vec --solver cg --precond ic0\nrun_test \"CG non-positive-definite\" --input /tmp/neg.mtx --rhs /tmp/b2.vec --solver cg\nrun_test \"BiCGSTAB breakdown\" --input /tmp/zero.mtx --rhs /tmp/b2.vec --solver bicgstab\nSH\nbash /tmp/run_invalid_tests.sh\n"]
