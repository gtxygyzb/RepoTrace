[3695.240499, "o", "   945\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n   946\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   947\t\r\n   948\t    spmv(A, x, r);\r\n   949\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   950\t    double bnorm = vec_norm2(n, b);\r\n   951\t    if (bnorm == 0.0) {\r\n   952\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   953\t        return x;\r\n   954\t    }\r\n"]
[3695.240562, "o", "   955\t\r\n   956\t    dcopy(n, r, r0);\r\n   957\t    double rho_old = dot(n, r0, r);\r\n   958\t    if (rho_old == 0.0) {\r\n   959\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   960\t        die(\"BiCGSTAB numerical breakdown\");\r\n   961\t    }\r\n   962\t    dcopy(n, r, pvec);\r\n   963\t\r\n   964\t    for (int it = 0; it < max_it; it++) {\r\n"]
[3695.240623, "o", "   965\t        precond_apply(p, pvec, z);\r\n   966\t        spmv(A, z, v);\r\n   967\t        double r0v = dot(n, r0, v);\r\n   968\t        if (r0v == 0.0) {\r\n   969\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   970\t            die(\"BiCGSTAB numerical breakdown\");\r\n   971\t        }\r\n   972\t        double alpha = rho_old / r0v;\r\n   973"]
[3695.240695, "o", "\t        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n   974\t\r\n   975\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n   976\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n   977\t            break;\r\n   978\t        }\r\n   979\t\r\n   980\t        precond_apply(p, s, z);\r\n   981\t        spmv(A, z, t);\r\n   982\t        double ts = dot(n, t, s);\r\n   983"]
[3695.240761, "o", "\t        double tt = dot(n, t, t);\r\n   984\t        if (tt == 0.0) {\r\n   985\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   986\t            die(\"BiCGSTAB numerical breakdown\");\r\n   987\t        }\r\n   988\t        double omega = ts / tt;\r\n   989\t        for (int i = 0; i < n; i++) {\r\n   990\t            x[i] += alpha * z[i] + omega * s[i];\r\n   991\t            r[i] = s[i] - omega * t[i];\r\n"]
[3695.240843, "o", "   992\t        }\r\n   993\t\r\n   994\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n   995\t\r\n   996\t        double rho_new = dot(n, r0, r);\r\n   997\t        if (rho_new == 0.0) {\r\n   998\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   999\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1000\t        }\r\n  1001\t        double beta = (rho_new / rho_old) * (alpha / omega);\r\n  1002\t        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n  1003\t        rho_old = rho_new;\r\n"]
