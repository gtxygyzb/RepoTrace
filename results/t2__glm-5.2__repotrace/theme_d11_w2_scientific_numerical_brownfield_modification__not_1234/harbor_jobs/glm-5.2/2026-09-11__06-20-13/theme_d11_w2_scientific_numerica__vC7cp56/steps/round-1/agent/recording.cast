[3714.648506, "o", "    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n   942\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n   943\t    double *v = xmalloc((size_t)n * sizeof(double));\r\n   944\t    double *s = xmalloc((size_t)n * sizeof(double));\r\n   945\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n   946\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   947\t\r\n   948\t    spmv(A, x, r);\r\n   949\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   950\t    double bnorm = vec_norm2(n, b);\r\n   951\t    if (bnorm == 0.0) {\r\n   952\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   953\t        return x;\r\n   954\t    }\r\n   955\t"]
[3714.648585, "o", "\r\n   956\t    dcopy(n, r, r0);\r\n   957\t    double rho_old = dot(n, r0, r);\r\n   958\t    if (rho_old == 0.0) {\r\n   959\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   960\t        die(\"BiCGSTAB numerical breakdown\");\r\n   961\t    }\r\n   962\t    dcopy(n, r, pvec);\r\n   963\t\r\n   964\t    for (int it = 0; it < max_it; it++) {\r\n   965\t        precond_apply(p, pvec, z);\r\n   966\t        spmv(A, z, v);\r\n"]
