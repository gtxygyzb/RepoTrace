[5535.450169, "o", "\r\n   763\t                } else if (ci < cj) {\r\n   764\t                    pi++;\r\n   765\t                } else {\r\n   766\t                    pj++;\r\n   767\t                }\r\n   768\t            }\r\n   769\t\r\n   770\t            if (diag[j] <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   771\t            double l = s / diag[j];\r\n   772\t            vals[k] = l;\r\n   773\t            sum -= l * l;\r\n   774\t        }\r\n   775\t\r\n   776\t        if (sum <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   777\t        diag[i] = sqrt(sum);\r\n   778\t    }\r\n   779\t\r\n   780\t    ICFactor *ic = xmalloc(sizeof(ICFactor));\r\n   781\t    ic->n = n;\r\n"]
[5535.450237, "o", "   782\t    ic->l_row_ptr = row_ptr;\r\n   783\t    ic->l_col_idx = col_idx;\r\n   784\t    ic->l_vals = vals;\r\n   785\t    ic->diag = diag;\r\n   786\t    ic->u_row_ptr = NULL;\r\n   787\t    ic->u_col_idx = NULL;\r\n   788\t    ic->u_vals = NULL;\r\n   789\t    return ic;\r\n   790\t}\r\n   791\t\r\n   792\tstatic Precond *precond_setup(CSRMatrix *m, int type, double omega) {\r\n"]
[5535.4503, "o", "   793\t    Precond *p = xmalloc(sizeof(Precond));\r\n   794\t    p->type = type;\r\n   795\t    p->A = m;\r\n   796\t    p->diag = NULL;\r\n   797\t    p->lower = NULL;\r\n   798\t    p->upper = NULL;\r\n   799\t    p->omega = omega;\r\n   800\t    p->ic = NULL;\r\n   801\t\r\n   802\t    if (type == PRECOND_JACOBI) {\r\n"]
[5535.450365, "o", "   803\t        p->diag = compute_diag(m);\r\n   804\t        for (int i = 0; i < m->n; i++) {\r\n   805\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   806\t        }\r\n   807\t    } else if (type == PRECOND_SSOR) {\r\n   808\t        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n   809\t        p->diag = compute_diag(m);\r\n   810\t        p->lower = build_lower_triangular(m);\r\n   811\t        p->upper = build_upper_triangular(m);\r\n   812\t    } else if (type == PRECOND_IC0) {\r\n   813\t        if (!m->symmetric) die(\"IC(0) requires symmetric matrix\");\r\n"]
[5535.450422, "o", "   814\t        p->ic = ic0_factorize(m);\r\n   815\t    }\r\n   816\t\r\n   817\t    return p;\r\n   818\t}\r\n   819\t\r\n   820\tstatic void precond_apply(Precond *p, const double *r, double *z) {\r\n"]
