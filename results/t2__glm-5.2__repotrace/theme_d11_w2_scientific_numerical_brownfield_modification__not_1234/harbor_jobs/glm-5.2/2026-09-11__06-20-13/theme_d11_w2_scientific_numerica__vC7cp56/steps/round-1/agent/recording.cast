[3674.629748, "o", "   184\t    if (!f) die(\"cannot open matrix file\");\r\n   185\t\r\n   186\t    char line[1024];\r\n   187\t    if (!fgets(line, sizeof(line), f)) {\r\n   188\t        fclose(f);\r\n   189\t        die(\"empty matrix file\");\r\n   190\t    }\r\n   191\t    if (strncmp(line, \"%%MatrixMarket\", 14) != 0) {\r\n   192\t        fclose(f);\r\n   193\t        die(\"matrix file is not Matrix Market format\");\r\n   194\t    }\r\n   195\t\r\n   196\t    char obj[64], fmt[64], field[64], sym[64];\r\n   197\t    if (sscanf(line, \"%*s %63s %63s %63s %63s\", obj, fmt, field, sym) != 4) {\r\n"]
[3674.629832, "o", "   198\t        fclose(f);\r\n   199\t        die(\"invalid Matrix Market header\");\r\n   200\t    }\r\n   201\t    if (strcmp(obj, \"matrix\") != 0 || strcmp(fmt, \"coordinate\") != 0 || strcmp(field, \"real\") != 0) {\r\n   202\t        fclose(f);\r\n   203\t        die(\"only real coordinate matrices are supported\");\r\n   204\t    }\r\n   205\t\r\n   206\t    int symmetric;\r\n   207\t    if (strcmp(sym, \"symmetric\") == 0) symmetric = 1;\r\n   208\t    else if (strcmp(sym, \"general\") == 0) symmetric = 0;\r\n"]
[3674.629952, "o", "   209\t    else {\r\n   210\t        fclose(f);\r\n   211\t        die(\"only symmetric or general matrices are supported\");\r\n   212\t    }\r\n   213\t\r\n   214\t    while (fgets(line, sizeof(line), f)) {\r\n   215\t        char *p = line;\r\n   216\t        while (isspace((unsigned char)*p)) p++;\r\n   217\t        if (*p == '%') continue;\r\n   218\t        if (*p == '\\0') continue;\r\n   219\t        break;\r\n   220\t    }\r\n   221\t\r\n   222\t    int rows, cols, nnz;\r\n   223\t    if (sscanf(line, \"%d %d %d\", &rows, &cols, &nnz) != 3) {\r\n   224\t        fclose(f);\r\n   225\t        die(\"failed to read matrix dimensions\");\r\n   226\t    }\r\n   227\t    if (rows <= 0 || cols <= 0) {\r\n"]
[3674.630029, "o", "   228\t        fclose(f);\r\n   229\t        die(\"invalid matrix dimensions\");\r\n   230\t    }\r\n   231\t    if (rows != cols) {\r\n   232\t        fclose(f);\r\n   233\t        die(\"matrix must be square\");\r\n   234\t    }\r\n   235\t    if (nnz < 0) {\r\n   236\t        fclose(f);\r\n   237\t        die(\"invalid nnz\");\r\n   238\t    }\r\n"]
[3674.6301, "o", "   239\t\r\n   240\t    Entry *entries = NULL;\r\n   241\t    int count = 0, cap = 0;\r\n   242\t    for (int k = 0; k < nnz; k++) {\r\n   243\t        int r, c;\r\n   244\t        double v;\r\n   245\t        if (fscanf(f, \"%d %d %lf\", &r, &c, &v) != 3) {\r\n   246\t            fclose(f);\r\n   247\t            free(entries);\r\n   248\t            die(\"failed to read matrix entry\");\r\n   249\t        }\r\n"]
