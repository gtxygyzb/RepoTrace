[4242.652871, "o", "print(\"Patched nlsolve.c:\")\r\n\u001b[?2004l\r"]
[4242.652926, "o", "\u001b[?2004h> "]
[4242.65299, "o", "for r in replacements:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.653056, "o", "    print(\" -\", r)\r\n\u001b[?2004l\r"]
[4242.65311, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[4242.759822, "o", "Patched nlsolve.c:\r\n - add compute_true_residual helper\r\n - remove SSOR setup zero diagonal die\r\n - SSOR apply zero diagonal safe\r\n - replace CG solver\r\n - replace BiCGSTAB solver\r\n - add history variable\r\n - add --history option\r\n - add zero RHS handling\r\n - update solver calls and reporting\r\n"]
