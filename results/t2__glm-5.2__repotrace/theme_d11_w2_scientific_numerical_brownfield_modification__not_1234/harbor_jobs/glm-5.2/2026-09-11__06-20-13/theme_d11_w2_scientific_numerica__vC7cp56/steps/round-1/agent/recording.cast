[3658.408129, "o", "\u001b[32m\u001b[K965\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(p, pvec, z);\r\n\u001b[32m\u001b[K975\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (vec_norm2(n, s) <= tol * \u001b[01;31m\u001b[Kbnorm\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K980\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(p, s, z);\r\n\u001b[32m\u001b[K994\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (vec_norm2(n, r) <= tol * \u001b[01;31m\u001b[Kbnorm\u001b[m\u001b[K) break;\r\n"]
