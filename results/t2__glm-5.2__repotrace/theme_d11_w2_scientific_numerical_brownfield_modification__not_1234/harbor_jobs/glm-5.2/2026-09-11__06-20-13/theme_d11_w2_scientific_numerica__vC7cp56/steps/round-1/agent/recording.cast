[6553.730844, "o", "   866\t\r\n   867\tstatic void precond_apply(Precond *p, const double *r, double *z) {\r\n   868\t    int n = p->A->n;\r\n   869\t\r\n   870\t    if (p->type == PRECOND_NONE) {\r\n"]
[6553.730958, "o", "   871\t        dcopy(n, r, z);\r\n   872\t        return;\r\n   873\t    }\r\n   874\t\r\n   875\t    if (p->type == PRECOND_JACOBI) {\r\n   876\t        for (int i = 0; i < n; i++) {\r\n   877\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   878\t            z[i] = r[i] / p->diag[i];\r\n   879\t        }\r\n   880\t        return;\r\n   881\t    }\r\n   882\t\r\n   883\t    if (p->type == PRECOND_SSOR) {\r\n   884\t        dcopy(n, r, z);\r\n   885\t        for (int i = 0; i < n; i++) {\r\n   886\t            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\r\n   887\t                int j = p->lower->col_idx[idx];\r\n   888\t                if (j < i) z[i] -= p->lower->vals[idx] * z[j];\r\n   889\t            }\r\n"]
[6553.731044, "o", "   890\t            if (p->diag[i] == 0.0) {\r\n   891\t                z[i] = 0.0;\r\n   892\t                continue;\r\n   893\t            }\r\n   894\t            z[i] /= p->diag[i];\r\n   895\t        }\r\n   896\t        for (int i = n - 1; i >= 0; i--) {\r\n   897\t            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\r\n   898\t                int j = p->upper->col_idx[idx];\r\n   899\t                if (j > i) z[i] -= p->upper->vals[idx] * z[j];\r\n   900\t            }\r\n   901\t            if (p->diag[i] == 0.0) {\r\n   902\t                z[i] = 0.0;\r\n   903\t                continue;\r\n   904\t            }\r\n"]
[6553.731184, "o", "   905\t            z[i] /= p->diag[i];\r\n   906\t        }\r\n   907\t        return;\r\n   908\t    }\r\n   909\t\r\n   910\t    if (p->type == PRECOND_IC0) {\r\n   911\t        ICFactor *ic = p->ic;\r\n   912\t        for (int i = 0; i < n; i++) {\r\n   913\t            double s = r[i];\r\n   914\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   915\t                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];\r\n   916\t            }\r\n   917\t            if (ic->diag[i] == 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   918\t            z[i] = s / ic->diag[i];\r\n   919\t        }\r\n   920\t        for (int i = n - 1; i >= 0; i--) {\r\n   921\t            z[i] /= ic->diag[i];\r\n   922\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   923\t                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];\r\n   924\t            }\r\n   925\t        }\r\n   926\t        return;\r\n"]
[6553.731272, "o", "   927\t    }\r\n   928\t\r\n   929\t    die(\"unknown preconditioner\");\r\n   930\t}\r\n   931\t\r\n   932\tstatic void free_precond(Precond *p) {\r\n   933\t    if (!p) return;\r\n   934\t    free(p->diag);\r\n   935\t    free_tri_matrix(p->lower);\r\n   936\t    free_tri_matrix(p->upper);\r\n   937\t    if (p->ic) {\r\n   938\t        free(p->ic->l_row_ptr);\r\n   939\t        free(p->ic->l_col_idx);\r\n   940\t        free(p->ic->l_vals);\r\n   941"]
[6553.731341, "o", "\t        free(p->ic->diag);\r\n   942\t        free(p->ic->u_row_ptr);\r\n   943\t        free(p->ic->u_col_idx);\r\n   944\t        free(p->ic->u_vals);\r\n   945\t        free(p->ic);\r\n"]
