[4295.422787, "i", "python3 - <<'PY'\nimport math\n# Read matrix\nrows={}\nwith open('/tmp/mat3.mtx') as f:\n    f.readline()\n    n,n,nnz=map(int,f.readline().split())\n    for line in f:\n        if line.strip():\n            r,c,v=line.split()\n            r=int(r)-1;c=int(c)-1;v=float(v)\n            rows[(r,c)]=rows.get((r,c),0)+v\n            if r!=c:\n                rows[(c,r)]=rows.get((c,r),0)+v\nb=[float(x) for x in open('/tmp/rhs3.vec').read().split()[1:]]\nx=[float(x) for x in open('/tmp/x3b.vec').read().split()[1:]]\nAx=[sum(rows.get((i,j),0)*x[j] for j in range(n)) for i in range(n)]\nres=math.sqrt(sum((b[i]-Ax[i])**2 for i in range(n)))\nbn=math.sqrt(sum(v*v for v in b))\nprint('manual residual', res/bn, 'bn', bn, 'x', x)\nPY\n"]
[4295.42301, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
