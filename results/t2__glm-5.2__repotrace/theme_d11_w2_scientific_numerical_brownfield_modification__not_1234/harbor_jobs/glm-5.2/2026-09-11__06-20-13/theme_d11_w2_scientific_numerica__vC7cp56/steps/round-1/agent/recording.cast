[6526.262496, "o", "nl -ba nlsolve.c | sed -n '1195,1240p'\r\n\u001b[?2004l\r"]
[6526.266464, "o", "  1195\tstatic void write_vector(const char *filename, int n, const double *x) {\r\n  1196\t    FILE *f = stdout;\r\n  1197\t    if (filename) {\r\n  1198\t        f = fopen(filename, \"w\");\r\n  1199\t        if (!f) die(\"cannot open output vector file\");\r\n  1200\t"]
[6526.266559, "o", "    }\r\n  1201\t\r\n  1202\t    if (fprintf(f, \"%d\\n\", n) < 0) {\r\n  1203\t        if (filename) fclose(f);\r\n  1204\t        die(\"failed to write vector\");\r\n  1205\t    }\r\n  1206\t    for (int i = 0; i < n; i++) {\r\n  1207\t        if (fprintf(f, \"%.15g\\n\", x[i]) < 0) {\r\n  1208\t            if (filename) fclose(f);\r\n  1209\t            die(\"failed to write vector\");\r\n  1210\t        }\r\n  1211\t    }\r\n  1212\t\r\n  1213\t    if (filename) fclose(f);\r\n  1214\t}\r\n"]
[6526.266679, "o", "  1215\t\r\n  1216\tstatic void write_zero_vector(const char *filename, int n) {\r\n  1217\t    FILE *f = stdout;\r\n  1218\t    if (filename) {\r\n  1219\t        f = fopen(filename, \"w\");\r\n  1220\t        if (!f) die(\"cannot open output vector file\");\r\n  1221\t    }\r\n  1222\t\r\n  1223\t    if (fprintf(f, \"%d\\n\", n) < 0) {\r\n  1224\t        if (filename) fclose(f);\r\n  1225\t"]
[6526.266756, "o", "        die(\"failed to write vector\");\r\n  1226\t    }\r\n  1227\t    for (int i = 0; i < n; i++) {\r\n  1228\t        if (fprintf(f, \"0.000000e+00\\n\") < 0) {\r\n  1229\t            if (filename) fclose(f);\r\n  1230\t            die(\"failed to write vector\");\r\n  1231\t        }\r\n  1232\t    }\r\n"]
[6526.266827, "o", "  1233\t\r\n  1234\t    if (filename) fclose(f);\r\n  1235\t}\r\n  1236\t\r\n  1237\tstatic int parse_int_arg(const char *s) {\r\n  1238\t    if (!s || !*s) die(\"missing argument\");\r\n  1239\t    errno = 0;\r\n  1240\t    char *end;\r\n"]
[6526.267405, "o", "\u001b[?2004h"]
[6526.267473, "o", "root@n30009:/app# "]
[6526.537147, "i", "nl -ba nlsolve.c | sed -n '755,865p'\n"]
[6526.537476, "o", "nl -ba nlsolve.c | sed -n '755,865p'\r\n\u001b[?2004l\r"]
[6526.541193, "o", "   755\t    free(t->row_ptr);\r\n   756\t    free(t->col_idx);\r\n   757\t    free(t->vals);\r\n   758\t    free(t);\r\n   759\t}\r\n   760\t\r\n   761\tstatic ICFactor *ic0_factorize(const CSRMatrix *m) {"]
[6526.541281, "o", "\r\n   762\t    int n = m->n;\r\n   763\t    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n   764\t    for (int i = 0; i < n; i++) {\r\n   765\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   766\t            if (m->col_idx[idx] < i) row_ptr[i + 1]++;\r\n   767\t        }\r\n   768\t    }\r\n   769\t    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];\r\n   770\t\r\n   771\t    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n   772\t    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));\r\n   773\t    int *next = xcalloc((size_t)n, sizeof(int));\r\n"]
[6526.541367, "o", "   774\t    for (int i = 0; i < n; i++) {\r\n   775\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   776\t            int j = m->col_idx[idx];\r\n   777\t            if (j < i) col_idx[row_ptr[i] + next[i]++] = j;\r\n   778\t        }\r\n   779\t    }\r\n   780\t    free(next);\r\n   781\t\r\n   782\t    double *diag = xmalloc((size_t)n * sizeof(double));\r\n   783\t    for (int i = 0; i < n; i++) {\r\n   784\t        double aii = 0.0;\r\n"]
[6526.541442, "o", "   785\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   786\t            if (m->col_idx[idx] == i) aii += m->vals[idx];\r\n   787\t        }\r\n   788\t\r\n   789\t        double sum = aii;\r\n   790\t        for (int k = row_ptr[i]; k < row_ptr[i + 1]; k++) {\r\n   791\t            int j = col_idx[k];\r\n   792\t            double aij = 0.0;\r\n   793\t            for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   794\t                if (m->col_idx[idx] == j) {\r\n"]
[6526.541508, "o", "   795\t                    aij += m->vals[idx];\r\n   796\t                    break;\r\n   797\t                }\r\n   798\t            }\r\n   799\t\r\n   800\t            double s = aij;\r\n   801\t            int pi = row_ptr[i];\r\n   802\t            int pj = row_ptr[j];\r\n   803\t            while (pi < k && pj < row_ptr[j + 1]) {\r\n"]
[6526.541625, "o", "   804\t                int ci = col_idx[pi];\r\n   805\t                int cj = col_idx[pj];\r\n   806\t                if (ci == cj) {\r\n   807\t                    s -= vals[pi] * vals[pj];\r\n   808\t                    pi++;\r\n   809\t                    pj++;\r\n   810\t                } else if (ci < cj) {\r\n   811\t                    pi++;\r\n   812\t                } else {\r\n   813\t                    pj++;\r\n   814\t                }\r\n   815\t            }\r\n   816\t\r\n   817\t            if (diag[j] <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   818\t            double l = s / diag[j];\r\n   819\t            vals[k] = l;\r\n   820\t            sum -= l * l;"]
[6526.541732, "o", "\r\n   821\t        }\r\n   822\t\r\n   823\t        if (sum <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   824\t        diag[i] = sqrt(sum);\r\n   825\t    }\r\n   826\t\r\n   827\t    ICFactor *ic = xmalloc(sizeof(ICFactor));\r\n   828\t    ic->n = n;\r\n   829\t    ic->l_row_ptr = row_ptr;\r\n   830\t    ic->l_col_idx = col_idx;\r\n   831\t    ic->l_vals = vals;\r\n   832\t    ic->diag = diag;\r\n   833\t    ic->u_row_ptr = NULL;\r\n   834\t    ic->u_col_idx = NULL;\r\n   835\t    ic->u_vals = NULL;\r\n   836\t"]
[6526.541803, "o", "    return ic;\r\n   837\t}\r\n   838\t\r\n   839\tstatic Precond *precond_setup(CSRMatrix *m, int type, double omega) {\r\n   840\t    Precond *p = xmalloc(sizeof(Precond));\r\n   841\t    p->type = type;\r\n   842\t    p->A = m;\r\n   843\t    p->diag = NULL;\r\n   844\t    p->lower = NULL;\r\n   845\t    p->upper = NULL;\r\n   846"]
[6526.541873, "o", "\t    p->omega = omega;\r\n   847\t    p->ic = NULL;\r\n   848\t\r\n   849\t    if (type == PRECOND_JACOBI) {\r\n   850\t        p->diag = compute_diag(m);\r\n   851\t        for (int i = 0; i < m->n; i++) {\r\n   852\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   853\t        }\r\n   854\t    } else if (type == PRECOND_SSOR) {\r\n"]
[6526.541944, "o", "   855\t        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n   856\t        p->diag = compute_diag(m);\r\n   857\t        p->lower = build_lower_triangular(m);\r\n   858\t        p->upper = build_upper_triangular(m);\r\n   859\t    } else if (type == PRECOND_IC0) {\r\n   860\t        if (!m->symmetric) die(\"IC(0) requires symmetric matrix\");\r\n   861\t        p->ic = ic0_factorize(m);\r\n   862\t    }\r\n   863\t\r\n   864\t    return p;\r\n   865\t}\r\n"]
