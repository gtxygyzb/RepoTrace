[3705.470859, "i", "nl -ba nlsolve.c | sed -n '880,940p'\n"]
[3705.471182, "o", "nl -ba nlsolve.c | sed -n '880,940p'\r\n\u001b[?2004l\r"]
[3705.474967, "o", "   880\t        free(p->ic->u_row_ptr);\r\n   881\t        free(p->ic->u_col_idx);\r\n   882\t        free(p->ic->u_vals);\r\n   883\t        free(p->ic);\r\n   884\t    }\r\n   885\t    free(p);"]
[3705.475061, "o", "\r\n   886\t}\r\n   887\t\r\n   888\tstatic double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol) {\r\n   889\t    int n = A->n;\r\n   890\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n   891\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n   892\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   893\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n   894\t    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n   895\t\r\n   896\t    spmv(A, x, r);\r\n   897\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   898\t    double bnorm = vec_norm2(n, b);\r\n"]
[3705.475145, "o", "   899\t    if (bnorm == 0.0) {\r\n   900\t        free(r); free(z); free(pvec); free(Ap);\r\n   901\t        return x;\r\n   902\t    }\r\n   903\t\r\n   904\t    precond_apply(p, r, z);\r\n   905\t    dcopy(n, z, pvec);\r\n   906\t    double rz_old = dot(n, r, z);\r\n   907\t\r\n   908\t    for (int it = 0; it < max_it; it++) {\r\n   909\t        spmv(A, pvec, Ap);\r\n   910\t        double pAp = dot(n, pvec, Ap);\r\n   911\t        if (pAp <= 0.0) {\r\n"]
[3705.475211, "o", "   912\t            free(r); free(z); free(pvec); free(Ap);\r\n   913\t            die(\"matrix is not positive definite\");\r\n   914\t        }\r\n   915\t        double alpha = rz_old / pAp;\r\n   916\t        for (int i = 0; i < n; i++) {\r\n   917\t            x[i] += alpha * pvec[i];\r\n   918\t            r[i] -= alpha * Ap[i];\r\n   919\t        }\r\n"]
[3705.475273, "o", "   920\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n   921\t\r\n   922\t        precond_apply(p, r, z);\r\n   923\t        double rz_new = dot(n, r, z);\r\n   924\t        if (rz_old == 0.0) {\r\n   925\t            free(r); free(z); free(pvec); free(Ap);\r\n   926\t            die(\"CG numerical breakdown\");\r\n   927\t        }\r\n"]
[3705.475334, "o", "   928\t        double beta = rz_new / rz_old;\r\n   929\t        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n   930\t        rz_old = rz_new;\r\n   931\t    }\r\n   932\t\r\n   933\t    free(r); free(z); free(pvec); free(Ap);\r\n   934\t    return x;\r\n   935\t}\r\n   936\t\r\n   937\tstatic double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol) {\r\n"]
[3705.475392, "o", "   938\t    int n = A->n;\r\n   939\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n   940\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n"]
[3705.47599, "o", "\u001b[?2004h"]
[3705.47605, "o", "root@n30009:/app# "]
[3705.745355, "i", "nl -ba nlsolve.c | sed -n '940,1010p'\n"]
[3705.745719, "o", "nl -ba nlsolve.c | sed -n '940,1010p'\r\n\u001b[?2004l\r"]
[3705.74949, "o", "   940\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n   941\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n   942\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n   943\t    double *v = xmalloc((size_t)n * sizeof(double));\r\n   944\t    double *s = xmalloc((size_t)n * sizeof(double));\r\n   945\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n"]
[3705.749572, "o", "   946\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   947\t\r\n   948\t    spmv(A, x, r);\r\n   949\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   950\t    double bnorm = vec_norm2(n, b);\r\n   951\t    if (bnorm == 0.0) {\r\n   952\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   953\t        return x;\r\n   954\t    }\r\n   955\t\r\n   956\t    dcopy(n, r, r0);\r\n   957\t    double rho_old = dot(n, r0, r);\r\n   958\t    if (rho_old == 0.0) {\r\n   959\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   960\t        die(\"BiCGSTAB numerical breakdown\");\r\n"]
[3705.749667, "o", "   961\t    }\r\n   962\t    dcopy(n, r, pvec);\r\n   963\t\r\n   964\t    for (int it = 0; it < max_it; it++) {\r\n   965\t        precond_apply(p, pvec, z);\r\n   966\t        spmv(A, z, v);\r\n   967\t        double r0v = dot(n, r0, v);\r\n   968\t        if (r0v == 0.0) {\r\n   969\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   970\t            die(\"BiCGSTAB numerical breakdown\");\r\n"]
[3705.749777, "o", "   971\t        }\r\n   972\t        double alpha = rho_old / r0v;\r\n   973\t        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n   974\t\r\n   975\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n   976\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n   977\t            break;\r\n   978\t        }\r\n   979\t\r\n   980\t        precond_apply(p, s, z);\r\n   981\t        spmv(A, z, t);\r\n   982\t        double ts = dot(n, t, s);\r\n   983\t        double tt = dot(n, t, t);\r\n   984\t        if (tt == 0.0) {\r\n   985\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   986\t            die(\"BiCGSTAB numerical breakdown\");\r\n   987\t        }\r\n   988\t        double omega = ts / tt;\r\n   989\t        for (int i = 0; i < n; i++) {\r\n   990\t            x[i] += alpha * z[i] + omega * s[i];\r\n   991\t            r[i] = s[i] - omega * t[i];\r\n"]
[3705.749847, "o", "   992\t        }\r\n   993\t\r\n   994\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n   995\t\r\n   996\t        double rho_new = dot(n, r0, r);\r\n   997\t        if (rho_new == 0.0) {\r\n   998\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n   999\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1000\t        }\r\n  1001\t        double beta = (rho_new / rho_old) * (alpha / omega);\r\n  1002"]
[3705.749904, "o", "\t        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n  1003\t        rho_old = rho_new;\r\n  1004\t    }\r\n  1005\t\r\n  1006\t    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1007\t    return x;\r\n  1008\t}\r\n  1009\t\r\n  1010\tstatic void write_vector(const char *filename, int n, const double *x) {\r\n"]
