[3669.857963, "o", "static void dcopy(int n, const double *src, double *dst) {\r\n    90\t    for (int i = 0; i < n; i++) dst[i] = src[i];\r\n    91\t}\r\n    92\t\r\n    93\tstatic int cmp_entry(const void *a, const void *b) {\r\n    94\t    const Entry *ea = (const Entry *)a;\r\n    95\t    const Entry *eb = (const Entry *)b;\r\n    96\t    if (ea->r != eb->r) return ea->r - eb->r;\r\n    97\t    return ea->c - eb->c;\r\n    98\t}\r\n"]
[3669.858047, "o", "    99\t\r\n   100\tstatic void add_entry(Entry **arr, int *count, int *cap, int r, int c, double v) {\r\n   101\t    if (*count == *cap) {\r\n   102\t        *cap = (*cap ? *cap * 2 : 16);\r\n   103\t        *arr = realloc(*arr, (size_t)*cap * sizeof(Entry));\r\n   104\t        if (!*arr) die(\"out of memory\");\r\n   105\t    }\r\n   106\t    (*arr)[*count].r = r;\r\n   107\t    (*arr)[*count].c = c;\r\n   108\t    (*arr)[*count].v = v;\r\n   109\t    (*count)++;\r\n   110\t"]
[3669.858128, "o", "}\r\n   111\t\r\n   112\tstatic CSRMatrix *build_csr(int n, Entry *entries, int count, int symmetric) {\r\n   113\t    if (count > 0) qsort(entries, (size_t)count, sizeof(Entry), cmp_entry);\r\n   114\t\r\n   115\t    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n   116\t    int *tmp_count = xcalloc((size_t)n, sizeof(int));\r\n   117\t\r\n   118\t    int unique = 0;\r\n   119\t    for (int i = 0; i < count; ) {\r\n   120\t        int r = entries[i].r;\r\n"]
