[5509.482595, "o", "\u001b[?2004l\r"]
[5509.486242, "o", "   791\t\r\n   792\tstatic Precond *precond_setup(CSRMatrix *m, int type, double omega) {\r\n   793\t    Precond *p = xmalloc(sizeof(Precond));\r\n   794\t    p->type = type;\r\n   795\t    p->A = m;\r\n   796\t"]
[5509.486325, "o", "    p->diag = NULL;\r\n   797\t    p->lower = NULL;\r\n   798\t    p->upper = NULL;\r\n   799\t    p->omega = omega;\r\n   800\t    p->ic = NULL;\r\n   801\t\r\n   802\t    if (type == PRECOND_JACOBI) {\r\n   803\t        p->diag = compute_diag(m);\r\n   804\t        for (int i = 0; i < m->n; i++) {\r\n   805\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   806\t        }\r\n   807\t    } else if (type == PRECOND_SSOR) {\r\n   808\t        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n"]
[5509.486396, "o", "   809\t        p->diag = compute_diag(m);\r\n   810\t        p->lower = build_lower_triangular(m);\r\n   811\t        p->upper = build_upper_triangular(m);\r\n   812\t    } else if (type == PRECOND_IC0) {\r\n   813\t        if (!m->symmetric) die(\"IC(0) requires symmetric matrix\");\r\n   814\t        p->ic = ic0_factorize(m);\r\n   815\t    }\r\n   816\t\r\n   817\t    return p;\r\n   818\t}\r\n   819\t\r\n   820\tstatic void precond_apply(Precond *p, const double *r, double *z) {\r\n"]
[5509.486455, "o", "   821\t    int n = p->A->n;\r\n   822\t\r\n   823\t    if (p->type == PRECOND_NONE) {\r\n   824\t        dcopy(n, r, z);\r\n   825\t        return;\r\n   826\t    }\r\n   827\t\r\n   828\t    if (p->type == PRECOND_JACOBI) {\r\n   829\t        for (int i = 0; i < n; i++) {\r\n"]
[5509.486517, "o", "   830\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   831\t            z[i] = r[i] / p->diag[i];\r\n   832\t        }\r\n   833\t        return;\r\n   834\t    }\r\n   835\t\r\n   836\t    if (p->type == PRECOND_SSOR) {\r\n   837\t        dcopy(n, r, z);\r\n   838\t        for (int i = 0; i < n; i++) {\r\n   839\t            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\r\n   840"]
[5509.486577, "o", "\t                int j = p->lower->col_idx[idx];\r\n   841\t                if (j < i) z[i] -= p->lower->vals[idx] * z[j];\r\n   842\t            }\r\n   843\t            if (p->diag[i] == 0.0) {\r\n   844\t                z[i] = 0.0;\r\n   845\t                continue;\r\n   846\t            }\r\n   847\t            z[i] /= p->diag[i];\r\n   848\t        }\r\n"]
[5509.486643, "o", "   849\t        for (int i = n - 1; i >= 0; i--) {\r\n   850\t            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\r\n   851\t                int j = p->upper->col_idx[idx];\r\n   852\t                if (j > i) z[i] -= p->upper->vals[idx] * z[j];\r\n   853\t            }\r\n   854\t            if (p->diag[i] == 0.0) {\r\n   855\t                z[i] = 0.0;\r\n   856\t                continue;\r\n   857\t            }\r\n   858"]
[5509.48671, "o", "\t            z[i] /= p->diag[i];\r\n   859\t        }\r\n   860\t        return;\r\n   861\t    }\r\n   862\t\r\n   863\t    if (p->type == PRECOND_IC0) {\r\n   864\t        ICFactor *ic = p->ic;\r\n   865\t        for (int i = 0; i < n; i++) {\r\n   866\t            double s = r[i];\r\n   867\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   868\t                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];\r\n"]
[5509.486768, "o", "   869\t            }\r\n   870\t            if (ic->diag[i] == 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   871\t            z[i] = s / ic->diag[i];\r\n   872\t        }\r\n   873\t        for (int i = n - 1; i >= 0; i--) {\r\n   874\t            z[i] /= ic->diag[i];\r\n   875\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   876\t                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];\r\n   877"]
[5509.48683, "o", "\t            }\r\n   878\t        }\r\n   879\t        return;\r\n   880\t    }\r\n   881\t\r\n   882\t    die(\"unknown preconditioner\");\r\n   883\t}\r\n   884\t\r\n   885\t"]
[5509.486887, "o", "static void free_precond(Precond *p) {\r\n   886\t    if (!p) return;\r\n   887\t    free(p->diag);\r\n   888\t    free_tri_matrix(p->lower);\r\n   889\t    free_tri_matrix(p->upper);\r\n   890\t    if (p->ic) {\r\n   891\t        free(p->ic->l_row_ptr);\r\n   892\t        free(p->ic->l_col_idx);\r\n   893\t        free(p->ic->l_vals);\r\n"]
[5509.486964, "o", "   894\t        free(p->ic->diag);\r\n   895\t        free(p->ic->u_row_ptr);\r\n   896\t        free(p->ic->u_col_idx);\r\n   897\t        free(p->ic->u_vals);\r\n   898\t        free(p->ic);\r\n   899\t    }\r\n   900\t    free(p);\r\n   901\t}\r\n   902\t\r\n"]
[5509.487576, "o", "\u001b[?2004h"]
