[2640.751152, "o", "            if (n <= 0) die(\"invalid generator size\");\r\n\u001b[?2004l\r"]
[2640.751239, "o", "\u001b[?2004h> "]
[2640.751313, "o", "            long N = (long)n * (long)n * (long)n;\r\n\u001b[?2004l\r"]
[2640.751398, "o", "\u001b[?2004h> "]
[2640.751514, "o", "            if (N > INT_MAX / 4) die(\"generator size too large\");\r\n\u001b[?2004l\r"]
[2640.751601, "o", "\u001b[?2004h> "]
[2640.751698, "o", "            generate_laplacian3d(n, output);\r\n\u001b[?2004l\r\u001b[?2004h> "]
