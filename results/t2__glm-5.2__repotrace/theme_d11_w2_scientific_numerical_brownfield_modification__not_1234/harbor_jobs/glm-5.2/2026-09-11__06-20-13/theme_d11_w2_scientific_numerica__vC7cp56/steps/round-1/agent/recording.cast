[6690.396556, "o", "\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n   965\t    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n   966\t\r\n   967\t    spmv(A, x, r);\r\n   968\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   969\t    double bnorm = vec_norm2(n, b);\r\n   970\t    int it_count = 0;\r\n   971\t\r\n   972\t    precond_apply(p, r, z);\r\n   973\t    dcopy(n, z, pvec);\r\n   974\t    double rz_old = dot(n, r, z);\r\n   975\t\r\n   976\t    for (int it = 0; it < max_it; it++) {\r\n   977\t        spmv(A, pvec, Ap);\r\n"]
