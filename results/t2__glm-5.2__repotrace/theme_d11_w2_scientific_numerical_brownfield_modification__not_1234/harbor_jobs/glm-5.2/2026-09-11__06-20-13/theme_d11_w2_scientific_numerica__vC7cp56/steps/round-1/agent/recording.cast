[5911.800251, "o", "   903\t                continue;\r\n   904\t            }\r\n   905\t            z[i] /= p->diag[i];\r\n   906\t        }\r\n"]
[5911.800335, "o", "   907\t        return;\r\n   908\t    }\r\n   909\t\r\n   910\t    if (p->type == PRECOND_IC0) {\r\n   911\t        ICFactor *ic = p->ic;\r\n   912\t        for (int i = 0; i < n; i++) {\r\n   913\t            double s = r[i];\r\n   914\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   915\t                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];\r\n   916\t            }\r\n   917\t            if (ic->diag[i] == 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   918\t            z[i] = s / ic->diag[i];\r\n"]
[5911.800412, "o", "   919\t        }\r\n   920\t        for (int i = n - 1; i >= 0; i--) {\r\n   921\t            z[i] /= ic->diag[i];\r\n   922\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   923\t                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];\r\n   924\t            }\r\n   925\t        }\r\n   926\t        return;\r\n"]
[5911.800479, "o", "   927\t    }\r\n   928\t\r\n   929\t    die(\"unknown preconditioner\");\r\n   930\t}\r\n   931\t\r\n   932\tstatic void free_precond(Precond *p) {\r\n   933\t    if (!p) return;\r\n   934\t    free(p->diag);\r\n   935\t    free_tri_matrix(p->lower);\r\n   936\t    free_tri_matrix(p->upper);\r\n   937\t    if (p->ic) {\r\n   938\t        free(p->ic->l_row_ptr);\r\n   939\t        free(p->ic->l_col_idx);\r\n   940\t        free(p->ic->l_vals);\r\n   941"]
[5911.800538, "o", "\t        free(p->ic->diag);\r\n   942\t        free(p->ic->u_row_ptr);\r\n   943\t        free(p->ic->u_col_idx);\r\n   944\t        free(p->ic->u_vals);\r\n   945\t        free(p->ic);\r\n   946\t    }\r\n   947\t    free(p);\r\n   948\t}\r\n   949\t\r\n   950\t"]
[5911.800598, "o", "static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n   951\t    int n = A->n;\r\n   952\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n   953\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n   954\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   955\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n   956\t    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n   957\t\r\n   958\t    spmv(A, x, r);\r\n   959\t"]
[5911.800716, "o", "    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   960\t    double bnorm = vec_norm2(n, b);\r\n   961\t    int it_count = 0;\r\n   962\t\r\n   963\t    precond_apply(p, r, z);\r\n   964\t    dcopy(n, z, pvec);\r\n   965\t    double rz_old = dot(n, r, z);\r\n   966\t\r\n   967\t    for (int it = 0; it < max_it; it++) {\r\n   968\t        spmv(A, pvec, Ap);\r\n   969\t        double pAp = dot(n, pvec, Ap);\r\n   970\t        if (pAp <= 0.0) {\r\n   971\t            free(r); free(z); free(pvec); free(Ap);\r\n   972\t            die(\"matrix is not positive definite\");\r\n   973\t        }\r\n"]
[5911.800886, "o", "   974\t        double alpha = rz_old / pAp;\r\n   975\t        for (int i = 0; i < n; i++) {\r\n   976\t            x[i] += alpha * pvec[i];\r\n   977\t            r[i] -= alpha * Ap[i];\r\n   978\t        }\r\n   979\t        it_count = it + 1;\r\n   980\t        if (history) {\r\n   981\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n   982\t        }\r\n   983\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n   984\t\r\n   985\t        precond_apply(p, r, z);\r\n   986\t        double rz_new = dot(n, r, z);\r\n   987\t        if (rz_old == 0.0) {\r\n   988\t            free(r); free(z); free(pvec); free(Ap);\r\n   989\t            die(\"CG numerical breakdown\");\r\n   990\t        }\r\n   991\t        double beta = rz_new / rz_old;\r\n   992\t        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n   993\t        rz_old = rz_new;\r\n   994\t    }\r\n   995\t\r\n   996\t    if (iterations_out) *iterations_out = it_count;\r\n   997\t    free(r); free(z); free(pvec); free(Ap);\r\n   998\t    return x;\r\n   999\t}\r\n  1000\t\r\n  1"]
[5911.800932, "o", "001\tstatic double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n  1002\t    int n = A->n;\r\n  1003\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n  1004\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n  1005\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n  1006\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n  1007\t"]
[5911.801022, "o", "    double *v = xmalloc((size_t)n * sizeof(double));\r\n  1008\t    double *s = xmalloc((size_t)n * sizeof(double));\r\n  1009\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n  1010\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n  1011\t\r\n  1012\t    spmv(A, x, r);\r\n  1013\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n  1014\t    double bnorm = vec_norm2(n, b);\r\n  1015\t    int it_count = 0;\r\n"]
