[6938.412894, "o", "   955\t    }\r\n   956\t    free(p);\r\n   957\t}\r\n   958\t\r\n   959\t"]
[6938.412998, "o", "static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n   960\t    int n = A->n;\r\n   961\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n   962\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n   963\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   964\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n"]
[6938.413088, "o", "   965\t    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n   966\t\r\n   967\t    spmv(A, x, r);\r\n   968\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   969\t    double bnorm = vec_norm2(n, b);\r\n   970\t    int it_count = 0;\r\n   971\t\r\n   972\t    precond_apply(p, r, z);\r\n   973\t    dcopy(n, z, pvec);\r\n   974\t    double rz_old = dot(n, r, z);\r\n   975\t\r\n   976\t    for (int it = 0; it < max_it; it++) {\r\n   977\t        spmv(A, pvec, Ap);\r\n   978\t        double pAp = dot(n, pvec, Ap);\r\n   979\t        if (pAp <= 0.0) {\r\n   980\t            break;\r\n   981\t        }\r\n   982\t        double alpha = rz_old / pAp;\r\n   983\t        for (int i = 0; i < n; i++) {\r\n   984\t            x[i] += alpha * pvec[i];\r\n   985\t            r[i] -= alpha * Ap[i];\r\n   986\t        }\r\n   987\t        it_count = it + 1;\r\n   988\t        if (history) {\r\n   989\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n   990\t        }\r\n   991\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n"]
[6938.413181, "o", "   992\t\r\n   993\t        precond_apply(p, r, z);\r\n   994\t        double rz_new = dot(n, r, z);\r\n   995\t        if (rz_old == 0.0) {\r\n   996\t            break;\r\n   997\t        }\r\n   998\t"]
[6938.413248, "o", "        double beta = rz_new / rz_old;\r\n   999\t        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n  1000\t        rz_old = rz_new;\r\n  1001\t    }\r\n  1002\t\r\n  1003\t    if (iterations_out) *iterations_out = it_count;\r\n  1004\t    free(r); free(z); free(pvec); free(Ap);\r\n  1005\t    return x;\r\n  1006\t}\r\n  1007\t\r\n  1008\tstatic double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n  1009\t    int n = A->n;\r\n  1010\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n  1011\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n  1012\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n  1013\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n  1014\t    double *v = xmalloc((size_t)n * sizeof(double));\r\n  1015\t    double *s = xmalloc((size_t)n * sizeof(double));\r\n"]
[6938.41331, "o", "  1016\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n  1017\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n  1018\t\r\n  1019\t    spmv(A, x, r);\r\n  1020\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n  1021\t    double bnorm = vec_norm2(n, b);\r\n  1022\t    int it_count = 0;\r\n  1023\t\r\n  1024\t    dcopy(n, r, r0);\r\n  1025\t    double rho_old = dot(n, r0, r);\r\n"]
[6938.413375, "o", "  1026\t    if (fabs(rho_old) <= 1e-300) {\r\n  1027\t        goto bicgstab_cleanup;\r\n  1028\t    }\r\n  1029\t    dcopy(n, r, pvec);\r\n  1030\t\r\n  1031\t    for (int it = 0; it < max_it; it++) {\r\n  1032\t        precond_apply(p, pvec, z);\r\n  1033\t        spmv(A, z, v);\r\n  1034\t        double r0v = dot(n, r0, v);\r\n  1035\t        if (fabs(r0v) <= 1e-300) {\r\n"]
[6938.413438, "o", "  1036\t            break;\r\n  1037\t        }\r\n  1038\t        double alpha = rho_old / r0v;\r\n  1039\t        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n  1040\t\r\n  1041\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n  1042\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n  1043\t            it_count = it + 1;\r\n  1044\t            if (history) {\r\n  1045\t                printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, s));\r\n"]
[6938.4135, "o", "  1046\t            }\r\n  1047\t            break;\r\n  1048\t        }\r\n  1049\t\r\n  1050\t        precond_apply(p, s, z);\r\n  1051\t        spmv(A, z, t);\r\n  1052\t        double ts = dot(n, t, s);\r\n  1053\t        double tt = dot(n, t, t);\r\n  1054\t        if (fabs(tt) <= 1e-300) {\r\n"]
[6938.413562, "o", "  1055\t            break;\r\n  1056\t        }\r\n  1057\t        double omega = ts / tt;\r\n  1058\t        for (int i = 0; i < n; i++) {\r\n  1059\t            x[i] += alpha * z[i] + omega * s[i];\r\n  1060\t            r[i] = s[i] - omega * t[i];\r\n  1061\t        }\r\n  1062\t        it_count = it + 1;\r\n  1063\t        if (history) {"]
[6938.413624, "o", "\r\n  1064\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n  1065\t        }\r\n  1066\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n  1067\t\r\n  1068\t        double rho_new = dot(n, r0, r);\r\n  1069\t        if (fabs(rho_new) <= 1e-300) {\r\n  1070\t            break;\r\n  1071\t        }\r\n  1072"]
[6938.413706, "o", "\t        double beta = (rho_new / rho_old) * (alpha / omega);\r\n  1073\t        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n  1074\t        rho_old = rho_new;\r\n  1075\t    }\r\n  1076\t\r\n  1077\tbicgstab_cleanup:\r\n  1078\t    if (iterations_out) *iterations_out = it_count;\r\n  1079\t    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1080\t    return x;\r\n  1081\t}\r\n  1082\t\r\n  1083\tstatic double *solve_gmres(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int restart, int *iterations_out) {\r\n  1084\t    int n = A->n;\r\n"]
[6938.413768, "o", "  1085\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n"]
