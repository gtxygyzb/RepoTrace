[1701.621484, "o", "                    int col = row - n;\r\n\u001b[?2004l\r"]
[1701.621554, "o", "\u001b[?2004h> "]
[1701.621845, "o", "                    entries[count].r = row;\r\n\u001b[?2004l\r"]
[1701.621919, "o", "\u001b[?2004h> "]
[1701.622193, "o", "                    entries[count].c = col;\r\n\u001b[?2004l\r"]
[1701.622265, "o", "\u001b[?2004h"]
[1701.622349, "o", "> "]
[1701.622566, "o", "                    entries[count].v = -1.0;\r\n\u001b[?2004l\r"]
[1701.622647, "o", "\u001b[?2004h> "]
[1701.622824, "o", "                    count++;\r\n\u001b[?2004l\r"]
[1701.622899, "o", "\u001b[?2004h> "]
[1701.623003, "o", "                }\r\n\u001b[?2004l\r"]
[1701.623087, "o", "\u001b[?2004h> "]
[1701.623256, "o", "                if (i > 0) {\r\n\u001b[?2004l\r"]
[1701.62333, "o", "\u001b[?2004h> "]
[1701.623615, "o", "                    int col = row - n * n;\r\n\u001b[?2004l\r"]
[1701.623698, "o", "\u001b[?2004h> "]
[1701.623981, "o", "                    entries[count].r = row;\r\n\u001b[?2004l\r"]
[1701.624049, "o", "\u001b[?2004h> "]
[1701.624339, "o", "                    entries[count].c = col;\r\n\u001b[?2004l\r"]
[1701.624413, "o", "\u001b[?2004h> "]
[1701.624724, "o", "                    entries[count].v = -1.0;\r\n\u001b[?2004l\r"]
[1701.624795, "o", "\u001b[?2004h> "]
[1701.624977, "o", "                    count++;\r\n\u001b[?2004l\r"]
[1701.625051, "o", "\u001b[?2004h> "]
[1701.625184, "o", "                }\r\n\u001b[?2004l\r"]
[1701.625267, "o", "\u001b[?2004h> "]
[1701.625348, "o", "            }\r\n\u001b[?2004l\r"]
[1701.625431, "o", "\u001b[?2004h> "]
[1701.625517, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.625599, "o", ">     }\r\n\u001b[?2004l\r"]
[1701.625696, "o", "\u001b[?2004h> "]
[1701.62607, "o", "    qsort(entries, (size_t)count, sizeof(Entry), cmp_entry_rc);\r\n\u001b[?2004l\r"]
[1701.626142, "o", "\u001b[?2004h> "]
[1701.626484, "o", "    write_matrix_market(output, N, count, entries);\r\n\u001b[?2004l\r"]
[1701.626558, "o", "\u001b[?2004h"]
[1701.626654, "o", "> "]
[1701.626741, "o", "    free(entries);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.626825, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1701.626911, "o", "\u001b[?2004h> "]
[1701.627264, "o", "static void generate_rhs(int N, const char *output) {\r\n\u001b[?2004l\r"]
[1701.627336, "o", "\u001b[?2004h"]
[1701.627424, "o", "> "]
[1701.627573, "o", "    FILE *f = fopen(output, \"w\");\r\n\u001b[?2004l\r"]
[1701.627655, "o", "\u001b[?2004h> "]
[1701.62797, "o", "    if (!f) die(\"cannot open output rhs file\");\r\n\u001b[?2004l\r"]
[1701.628043, "o", "\u001b[?2004h> "]
[1701.628218, "o", "    fprintf(f, \"%d\\n\", N);\r\n\u001b[?2004l\r"]
[1701.628294, "o", "\u001b[?2004h> "]
[1701.628513, "o", "    for (int i = 1; i <= N; i++) {\r\n\u001b[?2004l\r"]
[1701.628583, "o", "\u001b[?2004h> "]
[1701.629074, "o", "        fprintf(f, \"%.15g\\n\", sin((double)i * M_PI / (double)(N + 1)));\r\n\u001b[?2004l\r"]
[1701.629147, "o", "\u001b[?2004h> "]
[1701.629233, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.629355, "o", "    fclose(f);\r\n\u001b[?2004l\r"]
[1701.62944, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.629523, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.629796, "o", "static void free_csr(CSRMatrix *m) {\r\n\u001b[?2004l\r"]
[1701.629868, "o", "\u001b[?2004h> "]
[1701.630007, "o", "    if (!m) return;\r\n\u001b[?2004l\r"]
[1701.630083, "o", "\u001b[?2004h> "]
[1701.630214, "o", "    free(m->row_ptr);\r\n\u001b[?2004l\r"]
[1701.630301, "o", "\u001b[?2004h> "]
[1701.630444, "o", "    free(m->col_idx);\r\n\u001b[?2004l\r"]
[1701.630513, "o", "\u001b[?2004h> "]
[1701.630645, "o", "    free(m->vals);\r\n\u001b[?2004l\r"]
[1701.630732, "o", "\u001b[?2004h> "]
[1701.630818, "o", "    free(m);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.630901, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1701.630985, "o", "\u001b[?2004h> "]
[1701.631428, "o", "static void spmv(const CSRMatrix *m, const double *x, double *y) {\r\n\u001b[?2004l\r"]
[1701.6315, "o", "\u001b[?2004h> "]
[1701.631744, "o", "    for (int i = 0; i < m->n; i++) {\r\n\u001b[?2004l\r"]
[1701.631815, "o", "\u001b[?2004h> "]
[1701.631974, "o", "        double s = 0.0;\r\n\u001b[?2004l\r"]
[1701.632044, "o", "\u001b[?2004h> "]
[1701.632525, "o", "        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r"]
[1701.6326, "o", "\u001b[?2004h> "]
[1701.632941, "o", "            s += m->vals[idx] * x[m->col_idx[idx]];\r\n\u001b[?2004l\r"]
[1701.633014, "o", "\u001b[?2004h> "]
[1701.633101, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.633185, "o", "> "]
[1701.633266, "o", "        y[i] = s;\r\n\u001b[?2004l\r"]
[1701.633351, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1701.633435, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1701.633516, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1701.633599, "o", "\u001b[?2004h> "]
[1701.63391, "o", "static double vec_norm2(int n, const double *x) {\r\n\u001b[?2004l\r"]
[1701.633983, "o", "\u001b[?2004h> "]
[1701.634185, "o", "    return sqrt(dot(n, x, x));\r\n\u001b[?2004l\r"]
[1701.634259, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1701.63434, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.634421, "o", "> "]
[1701.634678, "o", "static void analyze_matrix(CSRMatrix *m) {\r\n\u001b[?2004l\r"]
[1701.634752, "o", "\u001b[?2004h> "]
[1701.634969, "o", "    double *diag = compute_diag(m);\r\n\u001b[?2004l\r"]
[1701.635042, "o", "\u001b[?2004h> "]
[1701.635195, "o", "    int bandwidth = 0;\r\n\u001b[?2004l\r"]
[1701.63527, "o", "\u001b[?2004h> "]
[1701.635388, "o", "    long profile = 0;\r\n\u001b[?2004l\r"]
[1701.635472, "o", "\u001b[?2004h> "]
[1701.635553, "o", "    int strict_count = 0;\r\n\u001b[?2004l\r"]
[1701.635649, "o", "\u001b[?2004h> "]
[1701.635736, "o", "    int weak_all = 1;\r\n\u001b[?2004l\r"]
[1701.635823, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.636032, "o", "    for (int i = 0; i < m->n; i++) {\r\n\u001b[?2004l\r"]
[1701.636105, "o", "\u001b[?2004h> "]
[1701.636222, "o", "        int min_col = i;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.636305, "o", "> "]
[1701.636387, "o", "        int has_off = 0;\r\n\u001b[?2004l\r"]
[1701.636468, "o", "\u001b[?2004h> "]
[1701.636605, "o", "        double off_sum = 0.0;\r\n\u001b[?2004l\r"]
[1701.636685, "o", "\u001b[?2004h> "]
[1701.637022, "o", "        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r"]
[1701.637093, "o", "\u001b[?2004h> "]
[1701.637272, "o", "            int j = m->col_idx[idx];\r\n\u001b[?2004l\r"]
[1701.637341, "o", "\u001b[?2004h> "]
[1701.637491, "o", "            int diff = i - j;\r\n\u001b[?2004l\r"]
[1701.637565, "o", "\u001b[?2004h> "]
[1701.637749, "o", "            if (diff < 0) diff = -diff;\r\n\u001b[?2004l\r"]
[1701.63782, "o", "\u001b[?2004h> "]
[1701.638065, "o", "            if (diff > bandwidth) bandwidth = diff;\r\n\u001b[?2004l\r"]
[1701.638139, "o", "\u001b[?2004h> "]
[1701.638244, "o", "            if (j < i) {\r\n\u001b[?2004l\r"]
[1701.638329, "o", "\u001b[?2004h> "]
[1701.638609, "o", "                if (!has_off || j < min_col) min_col = j;\r\n\u001b[?2004l\r"]
[1701.638687, "o", "\u001b[?2004h> "]
[1701.638932, "o", "                has_off = 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.639148, "o", "                off_sum += fabs(m->vals[idx]);\r\n\u001b[?2004l\r"]
[1701.639225, "o", "\u001b[?2004h> "]
[1701.639371, "o", "            } else if (j > i) {\r\n\u001b[?2004l\r"]
[1701.639446, "o", "\u001b[?2004h> "]
[1701.639579, "o", "                has_off = 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.639669, "o", "> "]
[1701.639864, "o", "                if (j < min_col) min_col = j;\r\n\u001b[?2004l\r"]
[1701.639935, "o", "\u001b[?2004h> "]
[1701.640161, "o", "                off_sum += fabs(m->vals[idx]);\r\n\u001b[?2004l\r"]
[1701.640236, "o", "\u001b[?2004h> "]
[1701.640328, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.640413, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.640761, "o", "        if (has_off) profile += (long)(i - min_col);\r\n\u001b[?2004l\r"]
[1701.640831, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.641034, "o", "        double d = fabs(diag[i]);\r\n\u001b[?2004l\r"]
[1701.641104, "o", "\u001b[?2004h> "]
[1701.641281, "o", "        if (d > off_sum + 1e-300) {\r\n\u001b[?2004l\r"]
[1701.641354, "o", "\u001b[?2004h> "]
[1701.64149, "o", "            strict_count++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.641575, "o", "> "]
[1701.641777, "o", "        } else if (d >= off_sum - 1e-300) {\r\n\u001b[?2004l\r"]
[1701.641849, "o", "\u001b[?2004h> "]
[1701.641985, "o", "            // weak candidate\r\n\u001b[?2004l\r"]
[1701.64207, "o", "\u001b[?2004h> "]
[1701.642152, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.642303, "o", "            weak_all = 0;\r\n\u001b[?2004l\r"]
[1701.642375, "o", "\u001b[?2004h> "]
[1701.642458, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.64254, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1701.642621, "o", "\u001b[?2004h> "]
[1701.642738, "o", "    const char *dominance;\r\n\u001b[?2004l\r"]
[1701.642821, "o", "\u001b[?2004h> "]
[1701.643064, "o", "    if (strict_count == m->n) dominance = \"strict\";\r\n\u001b[?2004l\r"]
[1701.643137, "o", "\u001b[?2004h> "]
[1701.643351, "o", "    else if (weak_all) dominance = \"weak\";\r\n\u001b[?2004l\r"]
[1701.643423, "o", "\u001b[?2004h> "]
[1701.643552, "o", "    else dominance = \"no\";\r\n\u001b[?2004l\r"]
[1701.643651, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.643853, "o", "    printf(\"dimension: %d\\n\", m->n);\r\n\u001b[?2004l\r"]
[1701.643923, "o", "\u001b[?2004h> "]
[1701.644098, "o", "    printf(\"nonzeros: %d\\n\", m->nnz);\r\n\u001b[?2004l\r"]
[1701.64417, "o", "\u001b[?2004h> "]
[1701.644473, "o", "    printf(\"symmetric: %s\\n\", m->symmetric ? \"yes\" : \"no\");\r\n\u001b[?2004l\r"]
[1701.644545, "o", "\u001b[?2004h> "]
[1701.64475, "o", "    printf(\"bandwidth: %d\\n\", bandwidth);\r\n\u001b[?2004l\r"]
[1701.644821, "o", "\u001b[?2004h> "]
[1701.645007, "o", "    printf(\"profile: %ld\\n\", profile);\r\n\u001b[?2004l\r"]
[1701.645076, "o", "\u001b[?2004h> "]
[1701.645307, "o", "    printf(\"diag_dominant: %s\\n\", dominance);\r\n\u001b[?2004l\r"]
[1701.645378, "o", "\u001b[?2004h> "]
[1701.645464, "o", "    free(diag);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.645547, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1701.645641, "o", "\u001b[?2004h> "]
[1701.645891, "o", "static CSRMatrix *permute_csr(const CSRMatrix *m, const int *perm) {\r\n\u001b[?2004l\r"]
[1701.645963, "o", "\u001b[?2004h> "]
[1701.64601, "o", "    int n = m->n;\r\n\u001b[?2004l\r"]
[1701.646112, "o", "\u001b[?2004h> "]
[1701.646229, "o", "    int *inv = xmalloc((size_t)n * sizeof(int));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.646437, "o", "    for (int i = 0; i < n; i++) inv[perm[i]] = i;\r\n\u001b[?2004l\r"]
[1701.646507, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.646693, "o", "    int *counts = xcalloc((size_t)n, sizeof(int));\r\n\u001b[?2004l\r"]
[1701.64676, "o", "\u001b[?2004h> "]
[1701.646855, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[1701.646937, "o", "\u001b[?2004h> "]
[1701.647175, "o", "        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.647241, "o", "> "]
[1701.647317, "o", "            int ni = perm[i];\r\n\u001b[?2004l\r"]
[1701.647396, "o", "\u001b[?2004h> "]
[1701.647476, "o", "            counts[ni]++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.647554, "o", "        }\r\n\u001b[?2004l\r \u001b[?2004h> "]
[1701.64764, "o", "    }\r\n\u001b[?2004l\r \u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.647853, "o", "    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.647922, "o", "> "]
[1701.648133, "o", "    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + counts[i];\r\n\u001b[?2004l\r"]
[1701.648196, "o", "\u001b[?2004h> "]
[1701.648271, "o", "    free(counts);\r\n\u001b[?2004l\rv\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1701.648347, "o", "\u001b[?2004h> "]
[1701.648426, "o", "    int nnz = m->nnz;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.648576, "o", "    int *col_idx = xmalloc((size_t)nnz * sizeof(int));\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.648649, "o", "> "]
[1701.648769, "o", "    double *vals = xmalloc((size_t)nnz * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.64885, "o", "> "]
[1701.648929, "o", "    int *next = xcalloc((size_t)n, sizeof(int));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.649046, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.649139, "o", "        int ni = perm[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.649346, "o", "        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.649411, "o", "> "]
[1701.649489, "o", "            int nj = perm[m->col_idx[idx]];\r\n\u001b[?2004l\r"]
[1701.649565, "o", "\u001b[?2004h> "]
[1701.649657, "o", "            int pos = row_ptr[ni] + next[ni]++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.649767, "o", "            col_idx[pos] = nj;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.64989, "o", "            vals[pos] = m->vals[idx];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.649955, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.650034, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.650112, "o", "    free(next);\r\n\u001b[?2004l\r\u001b[?2004h>     free(inv);\r\n\u001b[?2004l\r"]
[1701.650191, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.650314, "o", "    CSRMatrix *p = xmalloc(sizeof(CSRMatrix));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.650379, "o", "    p->n = n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.650455, "o", "    p->nnz = nnz;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.650547, "o", "    p->row_ptr = row_ptr;\r\n\u001b[?2004l\r"]
[1701.650627, "o", "\u001b[?2004h>     p->col_idx = col_idx;\r\n\u001b[?2004l\r"]
[1701.650718, "o", "\u001b[?2004h>     p->vals = vals;\r\n\u001b[?2004l\r"]
[1701.650797, "o", "\u001b[?2004h> "]
[1701.650877, "o", "    p->symmetric = m->symmetric;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.650954, "o", "    return p;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.651031, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.651259, "o", "static void build_adjacency(const CSRMatrix *m, int **adj_ptr, int **adj_count, int **adj_data) {\r\n\u001b[?2004l\r"]
[1701.651324, "o", "\u001b[?2004h>     int n = m->n;\r\n\u001b[?2004l\r"]
[1701.651399, "o", "\u001b[?2004h> "]
[1701.65151, "o", "    int *degree = xcalloc((size_t)n, sizeof(int));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.651627, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.651844, "o", "        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.651911, "o", "> "]
[1701.65199, "o", "            int j = m->col_idx[idx];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.652107, "o", "            if (j != i) degree[i]++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.652176, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.652255, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.652377, "o", "    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.652446, "o", "> "]
[1701.652589, "o", "    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + degree[i];\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.652663, "o", "> "]
[1701.652784, "o", "    int *adj = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.652934, "o", "    int *next = xcalloc((size_t)n, sizeof(int));\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.653, "o", "> "]
[1701.653078, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.653266, "o", "        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r"]
[1701.653335, "o", "\u001b[?2004h> "]
[1701.653414, "o", "            int j = m->col_idx[idx];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.653573, "o", "            if (j != i) adj[row_ptr[i] + next[i]++] = j;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.653652, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.653726, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.653803, "o", "    free(next);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.653883, "o", "    free(degree);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.653961, "o", "    *adj_ptr = row_ptr;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.654089, "o", "    *adj_count = xcalloc((size_t)n, sizeof(int));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.654172, "o", "    *adj_data = adj;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.654251, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.720784, "o", "static int cmp_int_desc_degree(const void *a, const void *b, void *ctx) {\r\n\u001b[?2004l\r\u001b[?2004h>     (void)ctx;\r\n\u001b[?2004l\r\u001b[?2004h>     int ia = *(const int *)a;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.720921, "o", "> "]
[1701.721007, "o", "    int ib = *(const int *)b;\r\n\u001b[?2004l\r"]
[1701.721107, "o", "\u001b[?2004h> "]
[1701.721191, "o", "    return ia - ib;\r\n\u001b[?2004l\r"]
[1701.721277, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.721362, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.721714, "o", "static void rcm_ordering(const CSRMatrix *m, int *perm) {\r\n\u001b[?2004l\r"]
[1701.72179, "o", "\u001b[?2004h> "]
[1701.721873, "o", "    int n = m->n;\r\n\u001b[?2004l\r"]
[1701.721957, "o", "\u001b[?2004h> "]
[1701.72213, "o", "    int *adj_ptr, *adj_count, *adj;\r\n\u001b[?2004l\r"]
[1701.722204, "o", "\u001b[?2004h> "]
[1701.722477, "o", "    build_adjacency(m, &adj_ptr, &adj_count, &adj);\r\n\u001b[?2004l\r"]
[1701.722552, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1701.722672, "o", "\u001b[?2004h> "]
[1701.722886, "o", "    int *degree = xcalloc((size_t)n, sizeof(int));\r\n\u001b[?2004l\r"]
[1701.722964, "o", "\u001b[?2004h> "]
[1701.72335, "o", "    for (int i = 0; i < n; i++) degree[i] = adj_ptr[i + 1] - adj_ptr[i];\r\n\u001b[?2004l\r"]
[1701.723423, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1701.723507, "o", "\u001b[?2004h> "]
[1701.723772, "o", "    int *visited = xcalloc((size_t)n, sizeof(int));\r\n\u001b[?2004l\r"]
[1701.723843, "o", "\u001b[?2004h> "]
[1701.724109, "o", "    int *order = xmalloc((size_t)n * sizeof(int));\r\n\u001b[?2004l\r"]
[1701.724182, "o", "\u001b[?2004h> "]
[1701.724317, "o", "    int order_count = 0;\r\n\u001b[?2004l\r"]
[1701.7244, "o", "\u001b[?2004h> "]
[1701.724651, "o", "    int *queue = xmalloc((size_t)n * sizeof(int));\r\n\u001b[?2004l\r"]
[1701.724726, "o", "\u001b[?2004h> "]
[1701.724885, "o", "    int qhead = 0, qtail = 0;\r\n\u001b[?2004l\r"]
[1701.724959, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.725042, "o", "> "]
[1701.725171, "o", "    while (order_count < n) {\r\n\u001b[?2004l\r"]
[1701.725253, "o", "\u001b[?2004h> "]
[1701.725364, "o", "        int start = -1;\r\n\u001b[?2004l\r"]
[1701.725447, "o", "\u001b[?2004h> "]
[1701.725622, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[1701.725708, "o", "\u001b[?2004h> "]
[1701.725865, "o", "            if (!visited[i]) {\r\n\u001b[?2004l\r"]
[1701.72594, "o", "\u001b[?2004h> "]
[1701.726274, "o", "                if (start == -1 || degree[i] < degree[start] ||\r\n\u001b[?2004l\r"]
[1701.726345, "o", "\u001b[?2004h"]
[1701.726428, "o", "> "]
[1701.726698, "o", "                    (degree[i] == degree[start] && i < start)) {\r\n\u001b[?2004l\r"]
[1701.726773, "o", "\u001b[?2004h> "]
[1701.726932, "o", "                    start = i;\r\n\u001b[?2004l\r"]
[1701.727004, "o", "\u001b[?2004h> "]
[1701.727084, "o", "                }\r\n\u001b[?2004l\r"]
[1701.727166, "o", "\u001b[?2004h> "]
[1701.727249, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.72733, "o", ">         }\r\n\u001b[?2004l\r"]
[1701.72741, "o", "\u001b[?2004h> "]
[1701.72757, "o", "        if (start == -1) break;\r\n\u001b[?2004l\r"]
[1701.727653, "o", "\u001b[?2004h> "]
[1701.727803, "o", "        visited[start] = 1;\r\n\u001b[?2004l\r"]
[1701.727879, "o", "\u001b[?2004h> "]
[1701.728035, "o", "        queue[qtail++] = start;\r\n\u001b[?2004l\r"]
[1701.728077, "o", "\u001b[?2004h> "]
[1701.728267, "o", "        while (qhead < qtail) {\r\n\u001b[?2004l\r"]
[1701.728338, "o", "\u001b[?2004h> "]
[1701.728523, "o", "            int v = queue[qhead++];\r\n\u001b[?2004l\r"]
[1701.728559, "o", "\u001b[?2004h"]
[1701.728776, "o", "> "]
[1701.728868, "o", "            order[order_count++] = v;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.729049, "o", "            int base = adj_ptr[v];\r\n\u001b[?2004l\r"]
[1701.729122, "o", "\u001b[?2004h> "]
[1701.729357, "o", "            int deg = adj_ptr[v + 1] - base;\r\n\u001b[?2004l\r"]
[1701.729434, "o", "\u001b[?2004h> "]
[1701.729824, "o", "            int *nbrs = xmalloc((size_t)(deg ? deg : 1) * sizeof(int));\r\n\u001b[?2004l\r"]
[1701.729897, "o", "\u001b[?2004h> "]
[1701.730031, "o", "            int cnt = 0;\r\n\u001b[?2004l\r"]
[1701.730111, "o", "\u001b[?2004h> "]
[1701.730355, "o", "            for (int idx = 0; idx < deg; idx++) {\r\n\u001b[?2004l\r"]
[1701.730431, "o", "\u001b[?2004h> "]
[1701.730649, "o", "                int u = adj[base + idx];\r\n\u001b[?2004l\r"]
[1701.730738, "o", "\u001b[?2004h> "]
[1701.730994, "o", "                if (!visited[u]) nbrs[cnt++] = u;\r\n\u001b[?2004l\r"]
[1701.73107, "o", "\u001b[?2004h> "]
[1701.731167, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.731541, "o", "            // deterministic sort by degree then original index\r\n\u001b[?2004l\r"]
[1701.73162, "o", "\u001b[?2004h> "]
[1701.731852, "o", "            for (int a = 1; a < cnt; a++) {\r\n\u001b[?2004l\r"]
[1701.731928, "o", "\u001b[?2004h> "]
[1701.732101, "o", "                int key = nbrs[a];\r\n\u001b[?2004l\r"]
[1701.732172, "o", "\u001b[?2004h> "]
[1701.732333, "o", "                int b = a - 1;\r\n\u001b[?2004l\r"]
[1701.732409, "o", "\u001b[?2004h> "]
[1701.732572, "o", "                while (b >= 0) {\r\n\u001b[?2004l\r"]
[1701.732653, "o", "\u001b[?2004h> "]
[1701.732956, "o", "                    if (degree[nbrs[b]] < degree[key] ||\r\n\u001b[?2004l\r"]
[1701.733031, "o", "\u001b[?2004h> "]
[1701.733466, "o", "                        (degree[nbrs[b]] == degree[key] && nbrs[b] < key)) break;\r\n\u001b[?2004l\r"]
[1701.733572, "o", "\u001b[?2004h> "]
[1701.733773, "o", "                    nbrs[b + 1] = nbrs[b];\r\n\u001b[?2004l\r"]
[1701.73385, "o", "\u001b[?2004h> "]
[1701.733977, "o", "                    b--;\r\n\u001b[?2004l\r"]
[1701.734057, "o", "\u001b[?2004h> "]
[1701.734137, "o", "                }\r\n\u001b[?2004l\r"]
[1701.734216, "o", "\u001b[?2004h> "]
[1701.734377, "o", "                nbrs[b + 1] = key;\r\n\u001b[?2004l\r"]
[1701.734482, "o", "\u001b[?2004h> "]
[1701.734593, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.734859, "o", "            for (int idx = 0; idx < cnt; idx++) {\r\n\u001b[?2004l\r"]
[1701.734933, "o", "\u001b[?2004h> "]
[1701.73511, "o", "                int u = nbrs[idx];\r\n\u001b[?2004l\r"]
[1701.735201, "o", "\u001b[?2004h> "]
[1701.735359, "o", "                if (!visited[u]) {\r\n\u001b[?2004l\r"]
[1701.73543, "o", "\u001b[?2004h> "]
[1701.735618, "o", "                    visited[u] = 1;\r\n\u001b[?2004l\r"]
[1701.735713, "o", "\u001b[?2004h> "]
[1701.735906, "o", "                    queue[qtail++] = u;\r\n\u001b[?2004l\r"]
[1701.735979, "o", "\u001b[?2004h> "]
[1701.736058, "o", "                }\r\n\u001b[?2004l\r"]
[1701.736139, "o", "\u001b[?2004h> "]
[1701.736223, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1701.736325, "o", "> "]
[1701.736411, "o", "            free(nbrs);\r\n\u001b[?2004l\r"]
[1701.736492, "o", "\u001b[?2004h> "]
[1701.736573, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.736672, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1701.736755, "o", "\u001b[?2004h> "]
[1701.737062, "o", "    for (int i = 0; i < n; i++) perm[order[n - 1 - i]] = i;\r\n\u001b[?2004l\r"]
[1701.737135, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1701.737216, "o", "\u001b[?2004h> "]
[1701.737295, "o", "    free(adj_ptr);\r\n\u001b[?2004l\r"]
[1701.737375, "o", "\u001b[?2004h> "]
[1701.737481, "o", "    free(adj_count);\r\n\u001b[?2004l\r"]
[1701.737562, "o", "\u001b[?2004h> "]
[1701.737658, "o", "    free(adj);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1701.737791, "o", "    free(degree);\r\n\u001b[?2004l\r"]
[1701.737867, "o", "\u001b[?2004h> "]
[1701.737951, "o", "    free(visited);\r\n\u001b[?2004l\r"]
[1701.738029, "o", "\u001b[?2004h> "]
[1701.73811, "o", "    free(order);\r\n\u001b[?2004l\r"]
[1701.738193, "o", "\u001b[?2004h> "]
[1701.738274, "o", "    free(queue);\r\n\u001b[?2004l\r"]
[1701.738353, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1701.738432, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1701.741228, "o", "\u001b[?2004hroot@n30009:/app# "]
[1708.764008, "i", "cat -A Makefile && tail -n 30 nlsolve.c && grep -n \"rcm_ordering\" nlsolve.c\n"]
[1708.76457, "o", "cat -A Makefile && tail -n 30 nlsolve.c && grep -n \"rcm_ordering\" nlsolve.c\r\n\u001b[?2004l\r"]
[1708.766957, "o", "CC = gcc$\r\nCFLAGS = -O2 -Wall -Wextra -std=c11$\r\nLDFLAGS = -lm$\r\n$\r\nnlsolve: nlsolve.c$\r\n^I$(CC) $(CFLAGS) -o nlsolve nlsolve.c $(LDFLAGS)$\r\n$\r\nclean:$\r\n^Irm -f nlsolve$\r\n$\r\n.PHONY: clean$\r\n"]
[1708.769511, "o", "                int b = a - 1;\r\n                while (b >= 0) {\r\n                    if (degree[nbrs[b]] < degree[key] ||\r\n                        (degree[nbrs[b]] == degree[key] && nbrs[b] < key)) break;\r\n                    nbrs[b + 1] = nbrs[b];\r\n                    b--;\r\n                }\r\n                nbrs[b + 1] = key;\r\n            }\r\n            for (int idx = 0; idx < cnt; idx++) {\r\n                int u = nbrs[idx];\r\n                if (!visited[u]) {\r\n                    visited[u] = 1;\r\n                    queue[qtail++] = u;\r\n                }\r\n            }\r\n            free(nbrs);\r\n        }\r\n    }\r\n\r\n    for (int i = 0; i < n; i++) perm[order[n - 1 - i]] = i;\r\n"]
[1708.769627, "o", "\r\n    free(adj_ptr);\r\n    free(adj_count);\r\n    free(adj);\r\n    free(degree);\r\n    free(visited);\r\n    free(order);\r\n    free(queue);\r\n}\r\n"]
[1708.772629, "o", "\u001b[32m\u001b[K534\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void \u001b[01;31m\u001b[Krcm_ordering\u001b[m\u001b[K(const CSRMatrix *m, int *perm) {\r\n"]
[1708.773075, "o", "\u001b[?2004h"]
