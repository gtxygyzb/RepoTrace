[5501.564806, "o", "   714\tstatic ICFactor *ic0_factorize(const CSRMatrix *m) {\r\n   715\t    int n = m->n;\r\n   716\t    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n   717\t    for (int i = 0; i < n; i++) {\r\n"]
[5501.564887, "o", "   718\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   719\t            if (m->col_idx[idx] < i) row_ptr[i + 1]++;\r\n   720\t        }\r\n   721\t    }\r\n   722\t    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];\r\n   723\t\r\n   724\t    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n   725\t    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));\r\n   726\t    int *next = xcalloc((size_t)n, sizeof(int));\r\n   727\t    for (int i = 0; i < n; i++) {\r\n   728\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   729\t            int j = m->col_idx[idx];\r\n"]
[5501.564998, "o", "   730\t            if (j < i) col_idx[row_ptr[i] + next[i]++] = j;\r\n   731\t        }\r\n   732\t    }\r\n   733\t    free(next);\r\n   734\t\r\n   735\t    double *diag = xmalloc((size_t)n * sizeof(double));\r\n   736\t    for (int i = 0; i < n; i++) {\r\n   737\t        double aii = 0.0;\r\n   738\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   739\t            if (m->col_idx[idx] == i) aii += m->vals[idx];\r\n   740\t        }\r\n   741\t\r\n   742\t        double sum = aii;\r\n"]
[5501.565066, "o", "   743\t        for (int k = row_ptr[i]; k < row_ptr[i + 1]; k++) {\r\n   744\t            int j = col_idx[k];\r\n   745\t            double aij = 0.0;\r\n   746\t            for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   747\t                if (m->col_idx[idx] == j) {\r\n   748\t                    aij += m->vals[idx];\r\n   749\t                    break;\r\n   750\t                }\r\n   751\t            }\r\n   752\t\r\n   753\t            double s = aij;\r\n   754\t            int pi = row_ptr[i];\r\n   755\t            int pj = row_ptr[j];\r\n   756\t            while (pi < k && pj < row_ptr[j + 1]) {\r\n   757\t                int ci = col_idx[pi];\r\n   758\t                int cj = col_idx[pj];\r\n   759\t                if (ci == cj) {\r\n   760\t"]
[5501.565129, "o", "                    s -= vals[pi] * vals[pj];\r\n   761\t                    pi++;\r\n   762\t                    pj++;\r\n   763\t                } else if (ci < cj) {\r\n   764\t                    pi++;\r\n   765\t                } else {\r\n   766\t                    pj++;\r\n   767\t                }\r\n   768\t            }\r\n   769\t\r\n"]
[5501.565235, "o", "   770\t            if (diag[j] <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   771\t            double l = s / diag[j];\r\n   772\t            vals[k] = l;\r\n   773\t            sum -= l * l;\r\n   774\t        }\r\n   775\t\r\n   776\t        if (sum <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   777\t        diag[i] = sqrt(sum);\r\n   778\t    }\r\n   779\t\r\n   780\t    ICFactor *ic = xmalloc(sizeof(ICFactor));\r\n   781\t    ic->n = n;\r\n   782\t    ic->l_row_ptr = row_ptr;\r\n   783\t    ic->l_col_idx = col_idx;\r\n   784\t    ic->l_vals = vals;"]
[5501.565296, "o", "\r\n   785\t    ic->diag = diag;\r\n   786\t    ic->u_row_ptr = NULL;\r\n   787\t    ic->u_col_idx = NULL;\r\n   788\t    ic->u_vals = NULL;\r\n   789\t    return ic;\r\n   790\t}\r\n   791\t\r\n   792\tstatic Precond *precond_setup(CSRMatrix *m, int type, double omega) {\r\n   793\t    Precond *p = xmalloc(sizeof(Precond));\r\n   794\t    p->type = type;\r\n"]
[5501.565354, "o", "   795\t    p->A = m;\r\n   796\t    p->diag = NULL;\r\n   797\t    p->lower = NULL;\r\n   798\t    p->upper = NULL;\r\n   799\t    p->omega = omega;\r\n   800\t    p->ic = NULL;\r\n   801\t\r\n   802\t    if (type == PRECOND_JACOBI) {\r\n   803"]
[5501.565413, "o", "\t        p->diag = compute_diag(m);\r\n   804\t        for (int i = 0; i < m->n; i++) {\r\n   805\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   806\t        }\r\n   807\t    } else if (type == PRECOND_SSOR) {\r\n   808\t        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n   809\t        p->diag = compute_diag(m);\r\n   810\t        p->lower = build_lower_triangular(m);\r\n   811"]
[5501.565471, "o", "\t        p->upper = build_upper_triangular(m);\r\n   812\t    } else if (type == PRECOND_IC0) {\r\n   813\t        if (!m->symmetric) die(\"IC(0) requires symmetric matrix\");\r\n   814\t        p->ic = ic0_factorize(m);\r\n   815\t    }\r\n   816\t\r\n   817\t    return p;\r\n   818\t}\r\n   819\t\r\n"]
[5501.565548, "o", "   820\tstatic void precond_apply(Precond *p, const double *r, double *z) {\r\n   821\t    int n = p->A->n;\r\n   822\t\r\n   823\t    if (p->type == PRECOND_NONE) {\r\n   824\t        dcopy(n, r, z);\r\n   825\t        return;\r\n   826\t    }\r\n   827\t\r\n   828\t    if (p->type == PRECOND_JACOBI) {\r\n   829\t        for (int i = 0; i < n; i++) {\r\n   830\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   831\t            z[i] = r[i] / p->diag[i];\r\n"]
[5501.565614, "o", "   832\t        }\r\n   833\t        return;\r\n   834\t    }\r\n   835\t\r\n   836\t    if (p->type == PRECOND_SSOR) {\r\n   837"]
[5501.565682, "o", "\t        dcopy(n, r, z);\r\n   838\t        for (int i = 0; i < n; i++) {\r\n   839\t            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\r\n   840\t                int j = p->lower->col_idx[idx];\r\n   841\t                if (j < i) z[i] -= p->lower->vals[idx] * z[j];\r\n   842\t            }\r\n   843\t            if (p->diag[i] == 0.0) {\r\n   844\t                z[i] = 0.0;\r\n   845\t                continue;\r\n   846\t            }\r\n   847\t            z[i] /= p->diag[i];\r\n   848\t        }\r\n   849\t        for (int i = n - 1; i >= 0; i--) {\r\n   850\t            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\r\n"]
[5501.5658, "o", "   851\t                int j = p->upper->col_idx[idx];\r\n   852\t                if (j > i) z[i] -= p->upper->vals[idx] * z[j];\r\n   853\t            }\r\n   854\t            if (p->diag[i] == 0.0) {\r\n   855\t                z[i] = 0.0;\r\n   856\t                continue;\r\n   857\t            }\r\n   858\t            z[i] /= p->diag[i];\r\n   859\t        }\r\n   860\t        return;\r\n   861\t    }\r\n   862\t\r\n   863\t    if (p->type == PRECOND_IC0) {\r\n   864\t        ICFactor *ic = p->ic;\r\n   865\t        for (int i = 0; i < n; i++) {\r\n   866\t            double s = r[i];\r\n   867\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   868\t                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];\r\n   869\t            }\r\n"]
[5501.565858, "o", "   870\t            if (ic->diag[i] == 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   871\t            z[i] = s / ic->diag[i];\r\n   872\t        }\r\n   873\t        for (int i = n - 1; i >= 0; i--) {\r\n   874\t            z[i] /= ic->diag[i];\r\n   875\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   876\t                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];\r\n   877\t            }\r\n   878\t        }\r\n"]
[5501.565912, "o", "   879\t        return;\r\n   880\t    }\r\n   881\t\r\n   882\t    die(\"unknown preconditioner\");\r\n   883\t}\r\n   884\t\r\n   885\tstatic void free_precond(Precond *p) {\r\n   886\t    if (!p) return;\r\n   887\t"]
[5501.565966, "o", "    free(p->diag);\r\n   888\t    free_tri_matrix(p->lower);\r\n   889\t    free_tri_matrix(p->upper);\r\n   890\t    if (p->ic) {\r\n   891\t        free(p->ic->l_row_ptr);\r\n   892\t        free(p->ic->l_col_idx);\r\n   893\t        free(p->ic->l_vals);\r\n   894\t        free(p->ic->diag);\r\n   895\t        free(p->ic->u_row_ptr);\r\n"]
[5501.566017, "o", "   896\t        free(p->ic->u_col_idx);\r\n   897\t        free(p->ic->u_vals);\r\n   898\t        free(p->ic);\r\n   899\t    }\r\n   900\t    free(p);\r\n   901\t}\r\n   902\t\r\n"]
