[5483.58089, "o", "   546\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   547\t            int j = m->col_idx[idx];\r\n   548\t            if (j != i) degree[i]++;\r\n   549\t        }\r\n   550\t    }\r\n   551\t    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n   552\t    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + degree[i];\r\n   553\t    int *adj = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n"]
[5483.580959, "o", "   554\t    int *next = xcalloc((size_t)n, sizeof(int));\r\n   555\t    for (int i = 0; i < n; i++) {\r\n   556\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   557\t            int j = m->col_idx[idx];\r\n   558\t            if (j != i) adj[row_ptr[i] + next[i]++] = j;\r\n   559\t        }\r\n   560\t    }\r\n   561\t    free(next);\r\n"]
[5483.58102, "o", "   562\t    free(degree);\r\n   563\t    *adj_ptr = row_ptr;\r\n   564\t    *adj_count = xcalloc((size_t)n, sizeof(int));\r\n   565\t    *adj_data = adj;\r\n   566\t}\r\n   567\t\r\n   568\tstatic void rcm_ordering(const CSRMatrix *m, int *perm) {\r\n"]
[5483.581081, "o", "   569\t    int n = m->n;\r\n   570\t    int *adj_ptr, *adj_count, *adj;\r\n   571\t    build_adjacency(m, &adj_ptr, &adj_count, &adj);\r\n   572\t\r\n   573\t    int *degree = xcalloc((size_t)n, sizeof(int));\r\n   574\t    for (int i = 0; i < n; i++) degree[i] = adj_ptr[i + 1] - adj_ptr[i];\r\n   575"]
[5483.581147, "o", "\t\r\n   576\t    int *visited = xcalloc((size_t)n, sizeof(int));\r\n   577\t    int *order = xmalloc((size_t)n * sizeof(int));\r\n   578\t    int order_count = 0;\r\n   579\t    int *queue = xmalloc((size_t)n * sizeof(int));\r\n   580\t    int qhead = 0, qtail = 0;\r\n   581\t\r\n"]
[5483.581208, "o", "   582\t    while (order_count < n) {\r\n   583\t        int start = -1;\r\n   584\t        for (int i = 0; i < n; i++) {\r\n   585\t            if (!visited[i]) {\r\n   586\t                if (start == -1 || degree[i] < degree[start] ||\r\n   587\t                    (degree[i] == degree[start] && i < start)) {\r\n"]
[5483.581267, "o", "   588\t                    start = i;\r\n   589\t                }\r\n   590\t            }\r\n   591\t        }\r\n   592\t        if (start == -1) break;\r\n   593\t        visited[start] = 1;\r\n"]
[5483.581324, "o", "   594\t        queue[qtail++] = start;\r\n   595\t        while (qhead < qtail) {\r\n   596\t            int v = queue[qhead++];\r\n   597\t            order[order_count++] = v;\r\n   598\t            int base = adj_ptr[v];\r\n"]
[5483.581382, "o", "   599\t            int deg = adj_ptr[v + 1] - base;\r\n   600\t            int *nbrs = xmalloc((size_t)(deg ? deg : 1) * sizeof(int));\r\n   601\t            int cnt = 0;\r\n   602\t            for (int idx = 0; idx < deg; idx++) {\r\n   603\t                int u = adj[base + idx];\r\n   604\t                if (!visited[u]) nbrs[cnt++] = u;\r\n"]
[5483.581439, "o", "   605\t            }\r\n   606\t            // deterministic sort by degree then original index\r\n   607\t            for (int a = 1; a < cnt; a++) {\r\n   608\t                int key = nbrs[a];\r\n   609\t                int b = a - 1;\r\n   610\t                while (b >= 0) {\r\n"]
[5483.581497, "o", "   611\t                    if (degree[nbrs[b]] < degree[key] ||\r\n   612\t                        (degree[nbrs[b]] == degree[key] && nbrs[b] < key)) break;\r\n   613\t                    nbrs[b + 1] = nbrs[b];\r\n   614\t                    b--;\r\n   615\t                }\r\n"]
[5483.581553, "o", "   616\t                nbrs[b + 1] = key;\r\n   617\t            }\r\n   618\t            for (int idx = 0; idx < cnt; idx++) {\r\n   619\t                int u = nbrs[idx];\r\n   620\t                if (!visited[u]) {\r\n   621\t                    visited[u] = 1;\r\n"]
[5483.581613, "o", "   622\t                    queue[qtail++] = u;\r\n   623\t                }\r\n   624\t            }\r\n   625\t            free(nbrs);\r\n   626\t        }\r\n   627\t    }\r\n"]
[5483.581658, "o", "   628\t\r\n   629\t    for (int i = 0; i < n; i++) perm[order[n - 1 - i]] = i;\r\n   630\t\r\n"]
