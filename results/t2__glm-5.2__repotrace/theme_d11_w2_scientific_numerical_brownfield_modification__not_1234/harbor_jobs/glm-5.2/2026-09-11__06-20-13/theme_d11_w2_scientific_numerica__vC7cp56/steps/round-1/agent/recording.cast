[6668.418661, "o", "'''    } else if (type == PRECOND_IC0) {\r\n\u001b[?2004l\r"]
[6668.41872, "o", "\u001b[?2004h> "]
[6668.419114, "o", "        if (!m->symmetric) die(\"IC(0) requires symmetric matrix\");\r\n\u001b[?2004l\r"]
[6668.419171, "o", "\u001b[?2004h> "]
[6668.419371, "o", "        p->ic = ic0_factorize(m);\r\n\u001b[?2004l\r"]
