[3695.520536, "o", "  1107\t            tol = parse_double_arg(argv[i]);\r\n  1108\t        } else if (strcmp(arg, \"--omega\") == 0) {\r\n  1109\t            if (++i >= argc) die(\"missing argument for omega\");\r\n  1110\t            omega = parse_double_arg(argv[i]);\r\n  1111\t        } else {\r\n  1112\t            char msg[256];\r\n  1113\t            snprintf(msg, sizeof(msg), \"unknown option: %s\", arg);\r\n  1114\t            die(msg);\r\n  1115\t        }\r\n  1116\t    }\r\n  1117\t\r\n  1118\t    int modes = 0;\r\n  1119\t    if (analyze) modes++;\r\n  1120\t    if (solver_name) modes++;\r\n  1121\t    if (gen2d) modes++;\r\n"]
