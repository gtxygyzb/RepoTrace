[6395.626284, "o", "            }\r\n        }\r\n    }\r\n    free(next);\r\n\r\n"]
[6395.626362, "o", "    TriMatrix *t = xmalloc(sizeof(TriMatrix));\r\n    t->n = n;\r\n    t->row_ptr = row_ptr;\r\n    t->col_idx = col_idx;\r\n    t->vals = vals;\r\n    return t;\r\n}\r\n\r\nstatic void free_tri_matrix(TriMatrix *t) {\r\n    if (!t) return;\r\n    free(t->row_ptr);\r\n    free(t->col_idx);\r\n"]
[6395.626436, "o", "    free(t->vals);\r\n    free(t);\r\n}\r\n\r\nstatic ICFactor *ic0_factorize(const CSRMatrix *m) {\r\n    int n = m->n;\r\n    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n"]
[6395.626499, "o", "            if (m->col_idx[idx] < i) row_ptr[i + 1]++;\r\n        }\r\n    }\r\n    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];\r\n\r\n    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));\r\n    int *next = xcalloc((size_t)n, sizeof(int));\r\n    for (int i = 0; i < n; i++) {\r\n"]
[6395.626561, "o", "        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            int j = m->col_idx[idx];\r\n            if (j < i) col_idx[row_ptr[i] + next[i]++] = j;\r\n        }\r\n    }\r\n    free(next);\r\n\r\n    double *diag = xmalloc((size_t)n * sizeof(double));\r\n"]
[6395.626628, "o", "    for (int i = 0; i < n; i++) {\r\n        double aii = 0.0;\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            if (m->col_idx[idx] == i) aii += m->vals[idx];\r\n        }\r\n\r\n        double sum = aii;\r\n        for (int k = row_ptr[i]; k < row_ptr[i + 1]; k++) {\r\n            int j = col_idx[k];\r\n            double aij = 0.0;\r\n            for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n                if (m->col_idx[idx] == j) {\r\n                    aij += m->vals[idx];"]
[6395.626725, "o", "\r\n                    break;\r\n                }\r\n            }\r\n\r\n            double s = aij;\r\n            int pi = row_ptr[i];\r\n            int pj = row_ptr[j];\r\n            while (pi < k && pj < row_ptr[j + 1]) {\r\n                int ci = col_idx[pi];\r\n                int cj = col_idx[pj];\r\n"]
[6395.626845, "o", "                if (ci == cj) {\r\n                    s -= vals[pi] * vals[pj];\r\n                    pi++;\r\n                    pj++;\r\n                } else if (ci < cj) {\r\n                    pi++;\r\n                } else {\r\n                    pj++;\r\n                }\r\n            }\r\n\r\n            if (diag[j] <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n            double l = s / diag[j];\r\n            vals[k] = l;\r\n            sum -= l * l;\r\n        }\r\n\r\n"]
[6395.626912, "o", "        if (sum <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n        diag[i] = sqrt(sum);\r\n    }\r\n\r\n    ICFactor *ic = xmalloc(sizeof(ICFactor));\r\n    ic->n = n;\r\n    ic->l_row_ptr = row_ptr;\r\n    ic->l_col_idx = col_idx;\r\n    ic->l_vals = vals;\r\n    ic->diag = diag;\r\n"]
[6395.626981, "o", "    ic->u_row_ptr = NULL;\r\n    ic->u_col_idx = NULL;\r\n    ic->u_vals = NULL;\r\n    return ic;\r\n}\r\n"]
[6395.627052, "o", "\r\nstatic Precond *precond_setup(CSRMatrix *m, int type, double omega) {\r\n    Precond *p = xmalloc(sizeof(Precond));\r\n    p->type = type;\r\n    p->A = m;\r\n    p->diag = NULL;\r\n    p->lower = NULL;\r\n    p->upper = NULL;\r\n    p->omega = omega;\r\n    p->ic = NULL;\r\n\r\n    if (type == PRECOND_JACOBI) {\r\n"]
[6395.627118, "o", "        p->diag = compute_diag(m);\r\n        for (int i = 0; i < m->n; i++) {\r\n            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n        }\r\n    } else if (type == PRECOND_SSOR) {\r\n        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n        p->diag = compute_diag(m);\r\n        p->lower = build_lower_triangular(m);\r\n        p->upper = build_upper_triangular(m);\r\n    } else if (type == PRECOND_IC0) {\r\n        if (!m->symmetric) die(\"IC(0) requires symmetric matrix\");\r\n        p->ic = ic0_factorize(m);\r\n    }\r\n"]
[6395.627182, "o", "\r\n    return p;\r\n}\r\n\r\nstatic void precond_apply(Precond *p, const double *r, double *z) {\r\n    int n = p->A->n;\r\n\r\n    if (p->type == PRECOND_NONE) {\r\n        dcopy(n, r, z);\r\n        return;\r\n"]
[6395.627241, "o", "    }\r\n\r\n    if (p->type == PRECOND_JACOBI) {\r\n        for (int i = 0; i < n; i++) {\r\n            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n            z[i] = r[i] / p->diag[i];\r\n        }\r\n        return;\r\n    }\r\n"]
[6395.627305, "o", "\r\n    if (p->type == PRECOND_SSOR) {\r\n        dcopy(n, r, z);\r\n        for (int i = 0; i < n; i++) {\r\n            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\r\n                int j = p->lower->col_idx[idx];\r\n                if (j < i) z[i] -= p->lower->vals[idx] * z[j];\r\n            }\r\n            if (p->diag[i] == 0.0) {\r\n                z[i] = 0.0;\r\n                continue;\r\n"]
[6395.627364, "o", "            }\r\n            z[i] /= p->diag[i];\r\n        }\r\n        for (int i = n - 1; i >= 0; i--) {\r\n            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\r\n                int j = p->upper->col_idx[idx];\r\n                if (j > i) z[i] -= p->upper->vals[idx] * z[j];\r\n            }\r\n            if (p->diag[i] == 0.0) {\r\n                z[i] = 0.0;\r\n                continue;\r\n            }\r\n"]
[6395.627427, "o", "            z[i] /= p->diag[i];\r\n        }\r\n        return;\r\n    }\r\n\r\n    if (p->type == PRECOND_IC0) {\r\n        ICFactor *ic = p->ic;\r\n        for (int i = 0; i < n; i++) {\r\n            double s = r[i];\r\n            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n"]
[6395.627485, "o", "                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];\r\n            }\r\n            if (ic->diag[i] == 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n            z[i] = s / ic->diag[i];\r\n        }\r\n        for (int i = n - 1; i >= 0; i--) {\r\n            z[i] /= ic->diag[i];\r\n"]
[6395.627547, "o", "            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];\r\n            }\r\n        }\r\n        return;\r\n    }\r\n\r\n    die(\"unknown preconditioner\");\r\n}\r\n"]
[6395.627606, "o", "\r\nstatic void free_precond(Precond *p) {\r\n    if (!p) return;\r\n    free(p->diag);\r\n    free_tri_matrix(p->lower);\r\n    free_tri_matrix(p->upper);\r\n    if (p->ic) {\r\n        free(p->ic->l_row_ptr);\r\n        free(p->ic->l_col_idx);\r\n"]
[6395.627697, "o", "        free(p->ic->l_vals);\r\n"]
[6395.62825, "o", "\u001b[?2004h"]
[6395.628312, "o", "root@n30009:/app# "]
[6395.898739, "i", "sed -n '940,1140p' nlsolve.c\n"]
[6395.899012, "o", "sed -n '940,1140p' nlsolve.c\r\n\u001b[?2004l\r"]
[6395.902154, "o", "        free(p->ic->l_vals);\r\n        free(p->ic->diag);\r\n        free(p->ic->u_row_ptr);\r\n        free(p->ic->u_col_idx);\r\n        free(p->ic->u_vals);\r\n        free(p->ic);\r\n    }\r\n"]
[6395.902242, "o", "    free(p);\r\n}\r\n\r\nstatic double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n    int n = A->n;\r\n    double *x = xcalloc((size_t)n, sizeof(double));\r\n    double *r = xmalloc((size_t)n * sizeof(double));\r\n    double *z = xmalloc((size_t)n * sizeof(double));\r\n    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n\r\n    spmv(A, x, r);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n    double bnorm = vec_norm2(n, b);\r\n    int it_count = 0;\r\n\r\n    precond_apply(p, r, z);\r\n    dcopy(n, z, pvec);\r\n    double rz_old = dot(n, r, z);\r\n\r\n    for (int it = 0; it < max_it; it++) {\r\n        spmv(A, pvec, Ap);\r\n"]
[6395.902317, "o", "        double pAp = dot(n, pvec, Ap);\r\n        if (pAp <= 0.0) {\r\n            free(r); free(z); free(pvec); free(Ap);\r\n            die(\"matrix is not positive definite\");\r\n        }\r\n        double alpha = rz_old / pAp;\r\n        for (int i = 0; i < n; i++) {\r\n            x[i] += alpha * pvec[i];\r\n            r[i] -= alpha * Ap[i];\r\n        }\r\n        it_count = it + 1;\r\n        if (history) {\r\n            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n        }\r\n        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n\r\n        precond_apply(p, r, z);\r\n        double rz_new = dot(n, r, z);\r\n"]
[6395.902384, "o", "        if (rz_old == 0.0) {\r\n            free(r); free(z); free(pvec); free(Ap);\r\n            die(\"CG numerical breakdown\");\r\n        }\r\n        double beta = rz_new / rz_old;\r\n"]
[6395.90245, "o", "        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n        rz_old = rz_new;\r\n    }\r\n\r\n    if (iterations_out) *iterations_out = it_count;\r\n    free(r); free(z); free(pvec); free(Ap);\r\n    return x;\r\n}\r\n\r\nstatic double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n    int n = A->n;\r\n    double *x = xcalloc((size_t)n, sizeof(double));\r\n    double *r = xmalloc((size_t)n * sizeof(double));\r\n    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n    double *v = xmalloc((size_t)n * sizeof(double));\r\n    double *s = xmalloc((size_t)n * sizeof(double));\r\n    double *t = xmalloc((size_t)n * sizeof(double));\r\n    double *z = xmalloc((size_t)n * sizeof(double));\r\n\r\n    spmv(A, x, r);\r\n    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n    double bnorm = vec_norm2(n, b);\r\n    int it_count = 0;\r\n\r\n    dcopy(n, r, r0);\r\n    double rho_old = dot(n, r0, r);\r\n"]
[6395.902517, "o", "    if (rho_old == 0.0) {\r\n        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n        die(\"BiCGSTAB numerical breakdown\");\r\n    }\r\n    dcopy(n, r, pvec);\r\n\r\n    for (int it = 0; it < max_it; it++) {\r\n        precond_apply(p, pvec, z);\r\n        spmv(A, z, v);\r\n        double r0v = dot(n, r0, v);\r\n        if (r0v == 0.0) {\r\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n            die(\"BiCGSTAB numerical breakdown\");\r\n        }\r\n        double alpha = rho_old / r0v;\r\n        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n"]
[6395.902582, "o", "\r\n        if (vec_norm2(n, s) <= tol * bnorm) {\r\n            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n            it_count = it + 1;\r\n            if (history) {\r\n                printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, s));\r\n            }\r\n            break;\r\n        }\r\n\r\n        precond_apply(p, s, z);\r\n        spmv(A, z, t);\r\n"]
[6395.902677, "o", "        double ts = dot(n, t, s);\r\n        double tt = dot(n, t, t);\r\n        if (tt == 0.0) {\r\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n            die(\"BiCGSTAB numerical breakdown\");\r\n        }\r\n        double omega = ts / tt;\r\n        for (int i = 0; i < n; i++) {\r\n            x[i] += alpha * z[i] + omega * s[i];\r\n            r[i] = s[i] - omega * t[i];\r\n        }\r\n        it_count = it + 1;\r\n        if (history) {\r\n            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n        }\r\n        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n\r\n"]
[6395.902747, "o", "        double rho_new = dot(n, r0, r);\r\n        if (rho_new == 0.0) {\r\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n            die(\"BiCGSTAB numerical breakdown\");\r\n        }\r\n        double beta = (rho_new / rho_old) * (alpha / omega);\r\n        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n        rho_old = rho_new;\r\n    }\r\n\r\n    if (iterations_out) *iterations_out = it_count;\r\n    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n    return x;\r\n}\r\n\r\nstatic double *solve_gmres(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int restart, int *iterations_out) {\r\n    int n = A->n;\r\n"]
[6395.902817, "o", "    double *x = xcalloc((size_t)n, sizeof(double));\r\n    double *r = xmalloc((size_t)n * sizeof(double));\r\n    double *w = xmalloc((size_t)n * sizeof(double));\r\n    double *V = xmalloc((size_t)(restart + 1) * n * sizeof(double));\r\n    double *Z = xmalloc((size_t)restart * n * sizeof(double));\r\n    double *H = xmalloc((size_t)(restart + 1) * restart * sizeof(double));\r\n    double *g = xmalloc((size_t)(restart + 1) * sizeof(double));\r\n    double *cs = xmalloc((size_t)restart * sizeof(double));\r\n    double *sn = xmalloc((size_t)restart * sizeof(double));\r\n    double *y = xmalloc((size_t)restart * sizeof(double));\r\n    double bnorm = vec_norm2(n, b);\r\n    int it_count = 0;\r\n    int converged = 0;\r\n\r\n    for (int cycle = 0; it_count < max_it && !converged; cycle++) {\r\n        spmv(A, x, r);\r\n        for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n"]
[6395.902881, "o", "        double beta = vec_norm2(n, r);\r\n        if (beta <= tol * bnorm) {\r\n            converged = 1;\r\n            break;\r\n        }\r\n\r\n        for (int i = 0; i <= restart; i++) g[i] = 0.0;\r\n        g[0] = beta;\r\n        double inv_beta = 1.0 / beta;\r\n        for (int i = 0; i < n; i++) V[i] = r[i] * inv_beta;\r\n\r\n        int steps = 0;\r\n        for (int j = 0; j < restart && it_count < max_it; j++) {\r\n"]
[6395.903, "o", "            precond_apply(p, V + j * n, Z + j * n);\r\n            spmv(A, Z + j * n, w);\r\n\r\n            for (int i = 0; i <= j; i++) {\r\n                double h = dot(n, w, V + i * n);\r\n                H[i * restart + j] = h;\r\n                for (int k = 0; k < n; k++) w[k] -= h * V[i * n + k];\r\n            }\r\n            double hnext = vec_norm2(n, w);\r\n            H[(j + 1) * restart + j] = hnext;\r\n            if (hnext > 0.0) {\r\n                double inv_h = 1.0 / hnext;\r\n                for (int k = 0; k < n; k++) V[(j + 1) * n + k] = w[k] * inv_h;\r\n            } else {\r\n                for (int k = 0; k < n; k++) V[(j + 1) * n + k] = 0.0;\r\n            }\r\n\r\n            for (int i = 0; i < j; i++) {\r\n                double temp = cs[i] * H[i * restart + j] + sn[i] * H[(i + 1) * restart + j];\r\n                H[(i + 1) * restart + j] = -sn[i] * H[i * restart + j] + cs[i] * H[(i + 1) * restart + j];\r\n                H[i * restart + j] = temp;\r\n            }\r\n\r\n"]
[6395.903067, "o", "            double hjj = H[j * restart + j];\r\n            double hj1j = H[(j + 1) * restart + j];\r\n            double rot = sqrt(hjj * hjj + hj1j * hj1j);\r\n            if (rot == 0.0) {\r\n                cs[j] = 1.0;\r\n                sn[j] = 0.0;\r\n            } else {\r\n"]
[6395.903613, "o", "\u001b[?2004h"]
[6395.903687, "o", "root@n30009:/app# "]
[6396.179406, "i", "sed -n '1140,1520p' nlsolve.c\n"]
[6396.179662, "o", "sed -n '1140,1520p' nlsolve.c"]
[6396.179748, "o", "\r\n\u001b[?2004l\r"]
[6396.182923, "o", "            } else {\r\n                cs[j] = hjj / rot;\r\n                sn[j] = hj1j / rot;\r\n            }\r\n            H[j * restart + j] = rot;\r\n            H[(j + 1) * restart + j] = 0.0;\r\n\r\n"]
[6396.183016, "o", "            double gtemp = cs[j] * g[j] + sn[j] * g[j + 1];\r\n            g[j + 1] = -sn[j] * g[j] + cs[j] * g[j + 1];\r\n            g[j] = gtemp;\r\n\r\n            it_count++;\r\n            steps = j + 1;\r\n\r\n"]
[6396.183083, "o", "            double res = 0.0;\r\n            for (int k = j + 1; k <= restart; k++) res += g[k] * g[k];\r\n            res = sqrt(res);\r\n            if (history) {\r\n                printf(\"iteration %d residual %.6e\\n\", it_count, res);\r\n            }\r\n            if (res <= tol * bnorm) {\r\n                converged = 1;\r\n                break;\r\n            }\r\n            if (hnext == 0.0) {\r\n                break;\r\n            }\r\n        }\r\n\r\n        if (steps > 0) {\r\n            for (int i = steps - 1; i >= 0; i--) {\r\n                double sum = g[i];\r\n                for (int k = i + 1; k < steps; k++) {\r\n                    sum -= H[i * restart + k] * y[k];\r\n                }\r\n                if (H[i * restart + i] == 0.0) {\r\n                    free(r); free(w); free(V); free(Z); free(H); free(g); free(cs); free(sn); free(y);\r\n                    die(\"GMRES numerical breakdown\");\r\n                }\r\n                y[i] = sum / H[i * restart + i];\r\n            }\r\n            for (int i = 0; i < steps; i++) {"]
[6396.183169, "o", "\r\n                double yi = y[i];\r\n                for (int k = 0; k < n; k++) {\r\n                    x[k] += Z[i * n + k] * yi;\r\n                }\r\n            }\r\n        }\r\n    }\r\n\r\n    if (iterations_out) *iterations_out = it_count;\r\n    free(r); free(w); free(V); free(Z); free(H); free(g); free(cs); free(sn); free(y);\r\n    return x;\r\n}\r\n\r\nstatic void write_vector(const char *filename, int n, const double *x) {\r\n    FILE *f = stdout;\r\n    if (filename) {\r\n        f = fopen(filename, \"w\");\r\n        if (!f) die(\"cannot open output vector file\");\r\n    }\r\n\r\n"]
[6396.183233, "o", "    if (fprintf(f, \"%d\\n\", n) < 0) {\r\n        if (filename) fclose(f);\r\n        die(\"failed to write vector\");\r\n    }\r\n    for (int i = 0; i < n; i++) {\r\n        if (fprintf(f, \"%.15g\\n\", x[i]) < 0) {\r\n            if (filename) fclose(f);\r\n            die(\"failed to write vector\");\r\n        }\r\n    }\r\n\r\n    if (filename) fclose(f);\r\n}\r\n\r\nstatic void write_zero_vector(const char *filename, int n) {\r\n"]
[6396.183295, "o", "    FILE *f = stdout;\r\n    if (filename) {\r\n        f = fopen(filename, \"w\");\r\n        if (!f) die(\"cannot open output vector file\");\r\n    }\r\n\r\n    if (fprintf(f, \"%d\\n\", n) < 0) {\r\n        if (filename) fclose(f);\r\n        die(\"failed to write vector\");\r\n    }\r\n    for (int i = 0; i < n; i++) {\r\n        if (fprintf(f, \"0.000000e+00\\n\") < 0) {\r\n"]
[6396.183356, "o", "            if (filename) fclose(f);\r\n            die(\"failed to write vector\");\r\n        }\r\n    }\r\n\r\n    if (filename) fclose(f);\r\n}\r\n\r\nstatic int parse_int_arg(const char *s) {\r\n    if (!s || !*s) die(\"missing argument\");\r\n    errno = 0;\r\n    char *end;\r\n    long val = strtol(s, &end, 10);\r\n    if (errno != 0 || end == s || *end != '\\0') die(\"invalid integer argument\");\r\n"]
[6396.183415, "o", "    if (val < INT_MIN || val > INT_MAX) die(\"integer argument out of range\");\r\n    return (int)val;\r\n}\r\n\r\nstatic double parse_double_arg(const char *s) {\r\n    if (!s || !*s) die(\"missing argument\");\r\n    errno = 0;\r\n    char *end;\r\n    double val = strtod(s, &end);\r\n    if (errno != 0 || end == s || *end != '\\0') die(\"invalid numeric argument\");\r\n    return val;\r\n}\r\n"]
[6396.183477, "o", "\r\nstatic void die_unknown(const char *kind, const char *value) {\r\n    char msg[256];\r\n    snprintf(msg, sizeof(msg), \"unknown %s: %s\", kind, value);\r\n    die(msg);\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n    const char *input = NULL;\r\n    const char *rhs = NULL;\r\n    const char *solver_name = NULL;\r\n    const char *precond_name = NULL;\r\n    const char *reorder_name = NULL;\r\n"]
[6396.183537, "o", "    const char *output = NULL;\r\n    const char *gen2d = NULL;\r\n    const char *gen3d = NULL;\r\n    const char *genrhs = NULL;\r\n    int analyze = 0;\r\n    int history = 0;\r\n    int max_it = 1000;\r\n    double tol = 1e-8;\r\n    double omega = 1.0;\r\n    int restart = 30;\r\n    int restart_given = 0;\r\n\r\n    for (int i = 1; i < argc; i++) {\r\n"]
[6396.183601, "o", "        const char *arg = argv[i];\r\n        if (strcmp(arg, \"--input\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --input\");\r\n            input = argv[i];\r\n        } else if (strcmp(arg, \"--rhs\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --rhs\");\r\n            rhs = argv[i];\r\n        } else if (strcmp(arg, \"--solver\") == 0) {\r\n            if (++i >= argc) die(\"missing solver name\");\r\n            solver_name = argv[i];\r\n        } else if (strcmp(arg, \"--precond\") == 0) {\r\n            if (++i >= argc) die(\"missing preconditioner name\");\r\n            precond_name = argv[i];\r\n"]
[6396.183695, "o", "        } else if (strcmp(arg, \"--reorder\") == 0) {\r\n            if (++i >= argc) die(\"missing reordering name\");\r\n            reorder_name = argv[i];\r\n        } else if (strcmp(arg, \"--output\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --output\");\r\n            output = argv[i];\r\n        } else if (strcmp(arg, \"--analyze\") == 0) {\r\n            analyze = 1;\r\n        } else if (strcmp(arg, \"--history\") == 0) {\r\n            history = 1;\r\n        } else if (strcmp(arg, \"--generate-laplacian\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --generate-laplacian\");\r\n            gen2d = argv[i];\r\n        } else if (strcmp(arg, \"--generate-laplacian3d\") == 0) {\r\n"]
[6396.183757, "o", "            if (++i >= argc) die(\"missing argument for --generate-laplacian3d\");\r\n            gen3d = argv[i];\r\n        } else if (strcmp(arg, \"--generate-rhs\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --generate-rhs\");\r\n            genrhs = argv[i];\r\n        } else if (strcmp(arg, \"--max-it\") == 0 || strcmp(arg, \"--max-iter\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for max iterations\");\r\n            max_it = parse_int_arg(argv[i]);\r\n        } else if (strcmp(arg, \"--tol\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for tolerance\");\r\n            tol = parse_double_arg(argv[i]);\r\n        } else if (strcmp(arg, \"--omega\") == 0) {\r\n"]
[6396.183816, "o", "            if (++i >= argc) die(\"missing argument for omega\");\r\n            omega = parse_double_arg(argv[i]);\r\n        } else if (strcmp(arg, \"--restart\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --restart\");\r\n            restart = parse_int_arg(argv[i]);\r\n            restart_given = 1;\r\n        } else {\r\n            char msg[256];\r\n            snprintf(msg, sizeof(msg), \"unknown option: %s\", arg);\r\n            die(msg);\r\n        }\r\n    }"]
[6396.183872, "o", "\r\n\r\n    if (restart_given) {\r\n        if (restart < 1) die(\"invalid restart value\");\r\n        if (!(solver_name && strcmp(solver_name, \"gmres\") == 0)) die(\"--restart requires --solver gmres\");\r\n    }\r\n\r\n    int modes = 0;\r\n    if (analyze) modes++;\r\n    if (solver_name) modes++;\r\n    if (gen2d) modes++;\r\n    if (gen3d) modes++;\r\n"]
[6396.183932, "o", "    if (genrhs) modes++;\r\n    if (modes == 0) die(\"no operation specified\");\r\n    if (modes > 1) die(\"conflicting operation modes specified\");\r\n\r\n    if (gen2d || gen3d || genrhs) {\r\n        if (input || rhs || solver_name || precond_name || reorder_name) {\r\n            die(\"conflicting command-line arguments\");\r\n        }\r\n        if (!output) die(\"missing output file for generator\");\r\n\r\n        if (gen2d) {\r\n            int n = parse_int_arg(gen2d);\r\n            if (n <= 0) die(\"invalid generator size\");\r\n"]
[6396.183992, "o", "            long N = (long)n * (long)n;\r\n            if (N > INT_MAX / 3) die(\"generator size too large\");\r\n            generate_laplacian2d(n, output);\r\n        } else if (gen3d) {\r\n            int n = parse_int_arg(gen3d);\r\n            if (n <= 0) die(\"invalid generator size\");\r\n            long N = (long)n * (long)n * (long)n;\r\n            if (N > INT_MAX / 4) die(\"generator size too large\");\r\n            generate_laplacian3d(n, output);\r\n        } else {\r\n            int N = parse_int_arg(genrhs);\r\n            if (N <= 0) die(\"invalid generator size\");\r\n            generate_rhs(N, output);\r\n"]
[6396.184052, "o", "        }\r\n        return 0;\r\n    }\r\n\r\n    if (analyze) {\r\n        if (!input) die(\"missing input file for analyze\");\r\n        if (rhs || solver_name || precond_name || reorder_name || output) {\r\n            die(\"conflicting command-line arguments\");\r\n        }\r\n        CSRMatrix *m = read_matrix(input);\r\n        analyze_matrix(m);\r\n        free_csr(m);\r\n        return 0;\r\n"]
[6396.18411, "o", "    }\r\n\r\n    if (!input) die(\"missing input file for solver\");\r\n    if (!rhs) die(\"missing rhs file for solver\");\r\n    if (!solver_name) die(\"missing solver name\");\r\n\r\n    int solver;\r\n    if (strcmp(solver_name, \"cg\") == 0) solver = SOLVER_CG;\r\n    else if (strcmp(solver_name, \"bicgstab\") == 0) solver = SOLVER_BICGSTAB;\r\n    else if (strcmp(solver_name, \"gmres\") == 0) solver = SOLVER_GMRES;\r\n    else die_unknown(\"solver\", solver_name);\r\n\r\n    int precond = PRECOND_NONE;\r\n"]
[6396.18417, "o", "    if (precond_name) {\r\n        if (strcmp(precond_name, \"none\") == 0) precond = PRECOND_NONE;\r\n        else if (strcmp(precond_name, \"jacobi\") == 0) precond = PRECOND_JACOBI;\r\n        else if (strcmp(precond_name, \"ssor\") == 0) precond = PRECOND_SSOR;\r\n        else if (strcmp(precond_name, \"ic0\") == 0) precond = PRECOND_IC0;\r\n        else die_unknown(\"preconditioner\", precond_name);\r\n    }\r\n\r\n    int reorder = 0;\r\n    if (reorder_name) {\r\n        if (strcmp(reorder_name, \"none\") == 0) reorder = 0;\r\n        else if (strcmp(reorder_name, \"rcm\") == 0) reorder = 1;\r\n"]
[6396.184282, "o", "        else die_unknown(\"reordering\", reorder_name);\r\n    }\r\n\r\n    if (max_it <= 0) die(\"invalid max iterations\");\r\n    if (tol < 0.0) die(\"invalid tolerance\");\r\n\r\n    CSRMatrix *m = read_matrix(input);\r\n    int rhs_n;\r\n    double *b = read_vector(rhs, &rhs_n);\r\n    if (m->n != rhs_n) {\r\n        free_csr(m);\r\n        free(b);\r\n        die(\"matrix and RHS dimensions do not match\");\r\n    }\r\n\r\n    int n = m->n;\r\n\r\n    if (vec_norm2(n, b) == 0.0) {\r\n        write_zero_vector(output, n);\r\n        printf(\"iterations: 0\\n\");\r\n        printf(\"residual_norm: 0.000000e+00\\n\");\r\n        printf(\"converged: yes\\n\");\r\n        free_csr(m);\r\n        free(b);\r\n"]
[6396.184342, "o", "        return 0;\r\n    }\r\n\r\n    CSRMatrix *A = m;\r\n    double *bwork = b;\r\n    int *perm = NULL;\r\n\r\n    if (reorder) {\r\n        perm = xmalloc((size_t)n * sizeof(int));\r\n        rcm_ordering(m, perm);\r\n        A = permute_csr(m, perm);\r\n        bwork = xmalloc((size_t)n * sizeof(double));\r\n        for (int i = 0; i < n; i++) bwork[perm[i]] = b[i];\r\n"]
[6396.184401, "o", "        free_csr(m);\r\n        m = A;\r\n    }\r\n\r\n    Precond *p = precond_setup(A, precond, omega);\r\n    int iterations = 0;\r\n    double *x2;\r\n    if (solver == SOLVER_CG) x2 = solve_cg(A, bwork, p, max_it, tol, history, &iterations);\r\n    else if (solver == SOLVER_BICGSTAB) x2 = solve_bicgstab(A, bwork, p, max_it, tol, history, &iterations);\r\n    else x2 = solve_gmres(A, bwork, p, max_it, tol, history, restart, &iterations);\r\n\r\n    double true_res = compute_true_residual(A, bwork, x2);\r\n"]
[6396.184458, "o", "\r\n    double *x;\r\n    if (perm) {\r\n        x = xmalloc((size_t)n * sizeof(double));\r\n        for (int i = 0; i < n; i++) x[i] = x2[perm[i]];\r\n        free(x2);\r\n        free(bwork);\r\n        free(perm);\r\n    } else {\r\n        x = x2;\r\n    }\r\n\r\n    write_vector(output, n, x);\r\n\r\n"]
[6396.184516, "o", "    printf(\"iterations: %d\\n\", iterations);\r\n    printf(\"residual_norm: %.6e\\n\", true_res);\r\n    printf(\"converged: %s\\n\", (true_res <= tol) ? \"yes\" : \"no\");\r\n\r\n    free(x);\r\n    free_precond(p);\r\n    free_csr(A);\r\n    free(b);\r\n    return 0;\r\n}\r\n"]
