[3683.68563, "o", "   112\tstatic CSRMatrix *build_csr(int n, Entry *entries, int count, int symmetric) {\r\n   113\t    if (count > 0) qsort(entries, (size_t)count, sizeof(Entry), cmp_entry);\r\n   114\t\r\n   115\t    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n   116\t    int *tmp_count = xcalloc((size_t)n, sizeof(int));\r\n   117\t\r\n   118\t    int unique = 0;\r\n"]
[3683.685751, "o", "   119\t    for (int i = 0; i < count; ) {\r\n   120\t        int r = entries[i].r;\r\n   121\t        int c = entries[i].c;\r\n   122\t        double sum = 0.0;\r\n   123\t        while (i < count && entries[i].r == r && entries[i].c == c) {\r\n   124\t            sum += entries[i].v;\r\n   125\t            i++;\r\n   126\t        }\r\n   127\t        entries[unique].r = r;\r\n   128\t        entries[unique].c = c;\r\n   129\t        entries[unique].v = sum;\r\n   130\t        unique++;\r\n   131\t        tmp_count[r]++;\r\n   132\t    }\r\n   133\t\r\n   134\t    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + tmp_count[i];\r\n   135\t    free(tmp_count);\r\n   136\t\r\n"]
[3683.685832, "o", "   137\t    int *col_idx = xmalloc((size_t)unique * sizeof(int));\r\n   138\t    double *vals = xmalloc((size_t)unique * sizeof(double));\r\n   139\t    int *next = xcalloc((size_t)n, sizeof(int));\r\n   140\t\r\n"]
