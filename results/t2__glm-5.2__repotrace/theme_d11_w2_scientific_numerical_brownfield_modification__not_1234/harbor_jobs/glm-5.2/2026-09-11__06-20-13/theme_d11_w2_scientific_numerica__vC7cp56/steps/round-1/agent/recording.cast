[3683.955553, "o", "nl -ba nlsolve.c | sed -n '141,180p'\r\n\u001b[?2004l\r"]
[3683.959308, "o", "   141\t    for (int i = 0; i < unique; i++) {\r\n   142\t        int r = entries[i].r;\r\n   143\t        int pos = row_ptr[r] + next[r]++;\r\n   144\t        col_idx[pos] = entries[i].c;\r\n   145\t        vals[pos] = entries[i].v;\r\n   146\t    }\r\n   147\t    free(next);\r\n"]
[3683.959418, "o", "   148\t\r\n   149\t    CSRMatrix *m = xmalloc(sizeof(CSRMatrix));\r\n   150\t    m->n = n;\r\n   151\t    m->nnz = unique;\r\n   152\t    m->row_ptr = row_ptr;\r\n   153\t    m->col_idx = col_idx;\r\n   154\t    m->vals = vals;\r\n   155\t    m->symmetric = symmetric;\r\n   156\t    return m;\r\n   157\t}\r\n   158\t\r\n   159\tstatic double *compute_diag(CSRMatrix *m) {\r\n   160\t    double *diag = xcalloc((size_t)m->n, sizeof(double));\r\n   161\t    for (int i = 0; i < m->n; i++) {\r\n   162\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   163\t            if (m->col_idx[idx] == i) diag[i] += m->vals[idx];\r\n   164\t        }\r\n"]
[3683.959505, "o", "   165\t    }\r\n   166\t    return diag;\r\n   167\t}\r\n   168\t\r\n   169\tstatic int has_trailing_data(FILE *f) {\r\n   170\t    int c;\r\n   171\t    while ((c = fgetc(f)) != EOF) {\r\n   172\t        if (isspace((unsigned char)c)) continue;\r\n   173\t        if (c == '%') {\r\n   174\t            while ((c = fgetc(f)) != EOF && c != '\\n');\r\n   175\t            continue;\r\n   176\t        }\r\n"]
[3683.959574, "o", "   177\t        return 1;\r\n   178\t    }\r\n   179\t    return 0;\r\n   180\t}\r\n"]
