[3695.520953, "o", "\t    int solver;\r\n  1169\t    if (strcmp(solver_name, \"cg\") == 0) solver = SOLVER_CG;\r\n  1170\t    else if (strcmp(solver_name, \"bicgstab\") == 0) solver = SOLVER_BICGSTAB;\r\n  1171\t    else die_unknown(\"solver\", solver_name);\r\n  1172\t\r\n  1173\t    int precond = PRECOND_NONE;\r\n  1174\t    if (precond_name) {\r\n  1175\t        if (strcmp(precond_name, \"none\") == 0) precond = PRECOND_NONE;\r\n  1176\t        else if (strcmp(precond_name, \"jacobi\") == 0) precond = PRECOND_JACOBI;\r\n"]
[3695.521018, "o", "  1177\t        else if (strcmp(precond_name, \"ssor\") == 0) precond = PRECOND_SSOR;\r\n  1178\t        else if (strcmp(precond_name, \"ic0\") == 0) precond = PRECOND_IC0;\r\n  1179\t        else die_unknown(\"preconditioner\", precond_name);\r\n  1180\t    }\r\n  1181\t\r\n  1182\t    int reorder = 0;\r\n  1183\t    if (reorder_name) {\r\n  1184\t        if (strcmp(reorder_name, \"none\") == 0) reorder = 0;\r\n  1185\t"]
[3695.521082, "o", "        else if (strcmp(reorder_name, \"rcm\") == 0) reorder = 1;\r\n  1186\t        else die_unknown(\"reordering\", reorder_name);\r\n  1187\t    }\r\n  1188\t\r\n  1189\t    if (max_it <= 0) die(\"invalid max iterations\");\r\n  1190\t    if (tol < 0.0) die(\"invalid tolerance\");\r\n  1191\t\r\n  1192\t    CSRMatrix *m = read_matrix(input);\r\n  1193\t    int rhs_n;\r\n  1194\t    double *b = read_vector(rhs, &rhs_n);\r\n"]
[3695.521139, "o", "  1195\t    if (m->n != rhs_n) {\r\n  1196\t        free_csr(m);\r\n  1197\t        free(b);\r\n  1198\t        die(\"matrix and RHS dimensions do not match\");\r\n  1199\t    }\r\n  1200\t\r\n  1201\t    int n = m->n;\r\n  1202\t    CSRMatrix *A = m;\r\n  1203\t"]
[3695.521204, "o", "    double *bwork = b;\r\n  1204\t    int *perm = NULL;\r\n  1205\t\r\n  1206\t    if (reorder) {\r\n  1207\t        perm = xmalloc((size_t)n * sizeof(int));\r\n  1208\t        rcm_ordering(m, perm);\r\n  1209\t        A = permute_csr(m, perm);\r\n  1210\t        bwork = xmalloc((size_t)n * sizeof(double));\r\n"]
[3695.521278, "o", "  1211\t        for (int i = 0; i < n; i++) bwork[perm[i]] = b[i];\r\n  1212\t        free_csr(m);\r\n  1213\t        m = A;\r\n  1214\t    }\r\n  1215\t\r\n  1216\t    Precond *p = precond_setup(A, precond, omega);\r\n  1217\t    double *x2;\r\n  1218\t    if (solver == SOLVER_CG) x2 = solve_cg(A, bwork, p, max_it, tol);\r\n  1219\t    else x2 = solve_bicgstab(A, bwork, p, max_it, tol);\r\n  1220\t\r\n  1221\t    double *x;\r\n  1222\t    if (perm) {\r\n  1223\t        x = xmalloc((size_t)n * sizeof(double));\r\n"]
[3695.521339, "o", "  1224\t        for (int i = 0; i < n; i++) x[i] = x2[perm[i]];\r\n  1225\t        free(x2);\r\n  1226\t        free(bwork);\r\n  1227\t        free(perm);\r\n  1228\t    } else {\r\n  1229\t        x = x2;\r\n  1230\t    }\r\n  1231\t\r\n  1232\t    write_vector(output, n, x);\r\n  1233\t\r\n"]
