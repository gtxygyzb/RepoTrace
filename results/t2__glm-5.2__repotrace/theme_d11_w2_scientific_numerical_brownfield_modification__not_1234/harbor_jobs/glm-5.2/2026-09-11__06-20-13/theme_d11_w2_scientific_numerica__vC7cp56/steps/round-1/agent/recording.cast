[6690.397014, "o", "  1035\t        precond_apply(p, pvec, z);\r\n  1036\t        spmv(A, z, v);\r\n  1037\t        double r0v = dot(n, r0, v);\r\n  1038\t        if (r0v == 0.0) {\r\n  1039\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1040\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1041\t"]
[6690.397078, "o", "        }\r\n  1042\t        double alpha = rho_old / r0v;\r\n  1043\t        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n  1044\t\r\n  1045\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n  1046\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n  1047\t            it_count = it + 1;\r\n"]
