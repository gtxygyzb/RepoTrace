[3695.520024, "o", "  1038\t    return (int)val;\r\n  1039\t}\r\n  1040\t\r\n  1041\tstatic double parse_double_arg(const char *s) {\r\n  1042\t    if (!s || !*s) die(\"missing argument\");\r\n  1043\t    errno = 0;\r\n  1044\t    char *end;\r\n  1045\t    double val = strtod(s, &end);\r\n  1046\t    if (errno != 0 || end == s || *end != '\\0') die(\"invalid numeric argument\");\r\n  1047"]
[3695.520083, "o", "\t    return val;\r\n  1048\t}\r\n  1049\t\r\n  1050\tstatic void die_unknown(const char *kind, const char *value) {\r\n  1051\t    char msg[256];\r\n  1052\t    snprintf(msg, sizeof(msg), \"unknown %s: %s\", kind, value);\r\n  1053\t    die(msg);\r\n  1054\t}\r\n  1055\t\r\n  1056\tint main(int argc, char **argv) {\r\n  1057\t"]
