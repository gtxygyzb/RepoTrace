[2898.572114, "o", "\u001b[32m\u001b[K959\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K975\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K988\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K1003\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output vector file\");\r\n\u001b[32m\u001b[K1008\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1013\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1021\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!s || !*s) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument\");\r\n\u001b[32m\u001b[K1025\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (errno != 0 || end == s || *end != '\\0') \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid integer argument\");\r\n\u001b[32m\u001b[K1026\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (val < INT_MIN || val > INT_MAX) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"integer argument out of range\");\r\n"]
[2898.572201, "o", "\u001b[32m\u001b[K1031\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!s || !*s) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument\");\r\n\u001b[32m\u001b[K1035\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (errno != 0 || end == s || *end != '\\0') \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid numeric argument\");\r\n"]
[2898.572264, "o", "\u001b[32m\u001b[K1042\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[Kmsg);\r\n\u001b[32m\u001b[K1045\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint \u001b[01;31m\u001b[Kmain\u001b[m\u001b[K(int argc, char **argv) {\r\n\u001b[32m\u001b[K1063\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --input\");\r\n\u001b[32m\u001b[K1066\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --rhs\");\r\n\u001b[32m\u001b[K1069\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing solver name\");\r\n"]
[2898.572299, "o", "\u001b[32m\u001b[K1072\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing preconditioner name\");\r\n\u001b[32m\u001b[K1075\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing reordering name\");\r\n\u001b[32m\u001b[K1078\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --output\");\r\n\u001b[32m\u001b[K1083\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --generate-laplacian\");\r\n\u001b[32m\u001b[K1086\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --generate-laplacian3d\");\r\n\u001b[32m\u001b[K1089\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --generate-rhs\");\r\n\u001b[32m\u001b[K1092\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for max iterations\");\r\n"]
[2898.572372, "o", "\u001b[32m\u001b[K1095\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for tolerance\");\r\n\u001b[32m\u001b[K1098\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for omega\");\r\n"]
[2898.572439, "o", "\u001b[32m\u001b[K1103\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[Kmsg);\r\n\u001b[32m\u001b[K1113\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (modes == 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"no operation specified\");\r\n\u001b[32m\u001b[K1114\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (modes > 1) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting operation modes specified\");\r\n\u001b[32m\u001b[K1118\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting command-line arguments\");\r\n\u001b[32m\u001b[K1120\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!output) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing output file for generator\");\r\n\u001b[32m\u001b[K1124\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1126\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N > INT_MAX / 3) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"generator size too large\");\r\n\u001b[32m\u001b[K1130\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1132\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N > INT_MAX / 4) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"generator size too large\");\r\n\u001b[32m\u001b[K1136\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N <= 0) \u001b[01;31m\u001b["]
[2898.572503, "o", "Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1143\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!input) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing input file for analyze\");\r\n\u001b[32m\u001b[K1145\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting command-line arguments\");\r\n\u001b[32m\u001b[K1153\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!input) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing input file for solver\");\r\n\u001b[32m\u001b[K1154\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!rhs) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing rhs file for solver\");\r\n\u001b[32m\u001b[K1155\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!solver_name) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing solver name\");\r\n"]
[2898.572563, "o", "\u001b[32m\u001b[K1178\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (max_it <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid max iterations\");\r\n\u001b[32m\u001b[K1179\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (tol < 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid tolerance\");\r\n\u001b[32m\u001b[K1187\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix and RHS dimensions do not match\");\r\n\u001b[32m\u001b[K1207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (solver == SOLVER_CG) x2 = \u001b[01;31m\u001b[Ksolve_cg\u001b[m\u001b[K(A, bwork, p, max_it, tol);\r\n"]
[2898.572629, "o", "\u001b[32m\u001b[K1208\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    else x2 = \u001b[01;31m\u001b[Ksolve_bicgstab\u001b[m\u001b[K(A, bwork, p, max_it, tol);\r\n"]
