[5478.711003, "o", "  1088\t    double val = strtod(s, &end);\r\n  1089\t    if (errno != 0 || end == s || *end != '\\0') die(\"invalid numeric argument\");\r\n  1090\t    return val;\r\n  1091\t}\r\n  1092\t\r\n  1093\tstatic void die_unknown(const char *kind, const char *value) {\r\n  1094\t    char msg[256];\r\n  1095\t    snprintf(msg, sizeof(msg), \"unknown %s: %s\", kind, value);\r\n  1096\t    die(msg);\r\n  1097\t}\r\n  1098\t\r\n  1099\tint main(int argc, char **argv) {\r\n  1100\t    const char *input = NULL;\r\n  1101\t    const char *rhs = NULL;\r\n  1102\t    const char *solver_name = NULL;\r\n  1103\t    const char *precond_name = NULL;\r\n  1104\t    const char *reorder_name = NULL;\r\n  1105\t    const char *output = NULL;\r\n  1106\t    const char *gen2d = NULL;\r\n  1107\t    const char *gen3d = NULL;\r\n  1108\t    const char *genrhs = NULL;\r\n  1109\t    int analyze = 0;\r\n  1110\t    int history = 0;\r\n  1111\t    int max_it = 1000;\r\n  1112\t    double tol = 1e-8;\r\n  1113\t    double omega = 1.0;\r\n  1114\t\r\n  1115\t    for (int i = 1; i < argc; i++) {\r\n"]
[5478.711109, "o", "  1116\t        const char *arg = argv[i];\r\n  1117\t        if (strcmp(arg, \"--input\") == 0) {\r\n  1118\t            if (++i >= argc) die(\"missing argument for --input\");\r\n  1119\t            input = argv[i];\r\n  1120\t        } else if (strcmp(arg, \"--rhs\") == 0) {\r\n  1121\t            if (++i >= argc) die(\"missing argument for --rhs\");\r\n  1122\t            rhs = argv[i];\r\n  1123\t        } else if (strcmp(arg, \"--solver\") == 0) {\r\n  1124\t            if (++i >= argc) die(\"missing solver name\");\r\n  1125\t            solver_name = argv[i];\r\n  1126\t        } else if (strcmp(arg, \"--precond\") == 0) {\r\n  1127\t            if (++i >= argc) die(\"missing preconditioner name\");\r\n  1128\t            precond_name = argv[i];"]
[5478.711176, "o", "\r\n  1129\t        } else if (strcmp(arg, \"--reorder\") == 0) {\r\n  1130\t            if (++i >= argc) die(\"missing reordering name\");\r\n  1131\t            reorder_name = argv[i];\r\n  1132\t        } else if (strcmp(arg, \"--output\") == 0) {\r\n  1133\t            if (++i >= argc) die(\"missing argument for --output\");\r\n  1134\t            output = argv[i];\r\n  1135\t        } else if (strcmp(arg, \"--analyze\") == 0) {\r\n  1136\t            analyze = 1;\r\n"]
