[6432.997218, "o", "\u001b[32m\u001b[K969\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        double \u001b[01;31m\u001b[KpAp\u001b[m\u001b[K = dot(n, pvec, Ap);\r\n\u001b[32m\u001b[K970\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[KpAp\u001b[m\u001b[K <= 0.0) {\r\n\u001b[32m\u001b[K972\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix is not positive definite\");\r\n"]
[6432.997297, "o", "\u001b[32m\u001b[K974\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        double alpha = rz_old / \u001b[01;31m\u001b[KpAp\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K989\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"CG numerical breakdown\");\r\n\u001b[32m\u001b[K1001\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic double *\u001b[01;31m\u001b[Ksolve_bicgstab\u001b[m\u001b[K(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n"]
[6432.997364, "o", "\u001b[32m\u001b[K1018\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    double \u001b[01;31m\u001b[Krho\u001b[m\u001b[K_old = dot(n, r0, r);\r\n\u001b[32m\u001b[K1019\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Krho\u001b[m\u001b[K_old == 0.0) {\r\n\u001b[32m\u001b[K1021\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K1031\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K1033\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        double alpha = \u001b[01;31m\u001b[Krho\u001b[m\u001b[K_old / r0v;\r\n"]
[6432.997433, "o", "\u001b[32m\u001b[K1051\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K1064\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        double \u001b[01;31m\u001b[Krho\u001b[m\u001b[K_new = dot(n, r0, r);\r\n\u001b[32m\u001b[K1065\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[Krho\u001b[m\u001b[K_new == 0.0) {\r\n\u001b[32m\u001b[K1067\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K1069\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        double beta = (\u001b[01;31m\u001b[Krho\u001b[m\u001b[K_new / \u001b[01;31m\u001b[Krho\u001b[m\u001b[K_old) * (alpha / omega);\r\n\u001b[32m\u001b[K1071\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Krho\u001b[m\u001b[K_old = \u001b[01;31m\u001b[Krho\u001b[m\u001b[K_new;\r\n"]
[6432.997501, "o", "\u001b[32m\u001b[K1177\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"GMRES numerical breakdown\");\r\n\u001b[32m\u001b[K1199\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output vector file\");\r\n"]
[6432.997571, "o", "\u001b[32m\u001b[K1204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1220\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output vector file\");\r\n\u001b[32m\u001b[K1225\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!s || !*s) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument\");\r\n"]
[6432.997653, "o", "\u001b[32m\u001b[K1242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (errno != 0 || end == s || *end != '\\0') \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid integer argument\");\r\n\u001b[32m\u001b[K1243\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (val < INT_MIN || val > INT_MAX) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"integer argument out of range\");\r\n\u001b[32m\u001b[K1248\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!s || !*s) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument\");\r\n\u001b[32m\u001b[K1252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (errno != 0 || end == s || *end != '\\0') \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid numeric argument\");\r\n\u001b[32m\u001b[K1259\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[Kmsg);\r\n"]
[6432.997731, "o", "\u001b[32m\u001b[K1283\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --input\");\r\n\u001b[32m\u001b[K1286\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --rhs\");\r\n\u001b[32m\u001b[K1289\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing solver name\");\r\n\u001b[32m\u001b[K1292\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing preconditioner name\");\r\n"]
