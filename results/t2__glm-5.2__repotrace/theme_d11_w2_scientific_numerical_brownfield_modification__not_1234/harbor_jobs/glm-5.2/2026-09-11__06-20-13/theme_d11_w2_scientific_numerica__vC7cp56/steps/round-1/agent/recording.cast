[3700.711133, "o", "   780\tstatic Precond *precond_setup(CSRMatrix *m, int type, double omega) {\r\n   781\t    Precond *p = xmalloc(sizeof(Precond));\r\n   782\t    p->type = type;\r\n   783\t    p->A = m;\r\n   784\t    p->diag = NULL;\r\n   785\t    p->lower = NULL;\r\n"]
[3700.711268, "o", "   786\t    p->upper = NULL;\r\n   787\t    p->omega = omega;\r\n   788\t    p->ic = NULL;\r\n   789\t\r\n   790\t    if (type == PRECOND_JACOBI) {\r\n   791\t        p->diag = compute_diag(m);\r\n   792\t        for (int i = 0; i < m->n; i++) {\r\n   793\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   794\t        }\r\n   795\t    } else if (type == PRECOND_SSOR) {\r\n   796\t        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n   797\t        p->diag = compute_diag(m);\r\n   798\t        for (int i = 0; i < m->n; i++) {\r\n   799\t            if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\r\n   800\t        }\r\n   801\t        p->lower = build_lower_triangular(m);\r\n   802\t        p->upper = build_upper_triangular(m);\r\n   803\t    } else if (type == PRECOND_IC0) {\r\n   804\t        if (!m->symmetric) die(\"IC(0) requires symmetric matrix\");\r\n   805\t        p->ic = ic0_factorize(m);\r\n   806\t    }\r\n   807\t"]
[3700.711347, "o", "\r\n   808\t    return p;\r\n   809\t}\r\n   810\t\r\n   811\tstatic void precond_apply(Precond *p, const double *r, double *z) {\r\n   812\t    int n = p->A->n;\r\n   813\t\r\n   814\t    if (p->type == PRECOND_NONE) {\r\n   815\t        dcopy(n, r, z);\r\n   816\t        return;\r\n   817\t    }\r\n   818\t\r\n   819\t    if (p->type == PRECOND_JACOBI) {\r\n   820\t        for (int i = 0; i < n; i++) {"]
[3700.711457, "o", "\r\n   821\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   822\t            z[i] = r[i] / p->diag[i];\r\n   823\t        }\r\n   824\t        return;\r\n   825\t    }\r\n   826\t\r\n   827\t    if (p->type == PRECOND_SSOR) {\r\n   828\t        dcopy(n, r, z);\r\n   829\t        for (int i = 0; i < n; i++) {\r\n   830\t            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\r\n   831\t                int j = p->lower->col_idx[idx];\r\n   832\t                if (j < i) z[i] -= p->lower->vals[idx] * z[j];\r\n   833\t            }\r\n   834\t            if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\r\n   835\t            z[i] /= p->diag[i];\r\n   836\t        }\r\n"]
[3700.711519, "o", "   837\t        for (int i = n - 1; i >= 0; i--) {\r\n   838\t            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\r\n   839\t                int j = p->upper->col_idx[idx];\r\n   840\t                if (j > i) z[i] -= p->upper->vals[idx] * z[j];\r\n   841\t            }\r\n   842\t            if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\r\n   843\t            z[i] /= p->diag[i];\r\n   844\t        }\r\n   845\t"]
[3700.711586, "o", "        return;\r\n   846\t    }\r\n   847\t\r\n   848\t    if (p->type == PRECOND_IC0) {\r\n   849\t        ICFactor *ic = p->ic;\r\n   850\t        for (int i = 0; i < n; i++) {\r\n   851\t            double s = r[i];\r\n   852\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   853\t                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];\r\n   854\t            }\r\n   855\t            if (ic->diag[i] == 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n"]
[3700.711684, "o", "   856\t            z[i] = s / ic->diag[i];\r\n   857\t        }\r\n   858\t        for (int i = n - 1; i >= 0; i--) {\r\n   859\t            z[i] /= ic->diag[i];\r\n   860\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   861\t                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];\r\n   862\t            }\r\n   863\t        }\r\n   864\t        return;\r\n   865\t    }\r\n   866\t\r\n   867\t    die(\"unknown preconditioner\");\r\n   868\t}\r\n   869\t\r\n   870\t"]
[3700.711749, "o", "static void free_precond(Precond *p) {\r\n   871\t    if (!p) return;\r\n   872\t    free(p->diag);\r\n   873\t    free_tri_matrix(p->lower);\r\n   874\t    free_tri_matrix(p->upper);\r\n   875\t    if (p->ic) {\r\n   876\t        free(p->ic->l_row_ptr);\r\n   877\t        free(p->ic->l_col_idx);\r\n   878\t        free(p->ic->l_vals);\r\n   879\t        free(p->ic->diag);\r\n   880"]
[3700.711809, "o", "\t        free(p->ic->u_row_ptr);\r\n"]
[3700.712391, "o", "\u001b[?2004h"]
