[1607.635514, "o", "\u001b[?2004h> "]
[1607.635681, "o", "    if (sscanf(line, \"%*s %63s %63s %63s %63s\", obj, fmt, field, sym) != 4) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.63574, "o", ">         fclose(f);\r\n\u001b[?2004l\r"]
[1607.635797, "o", "\u001b[?2004h> "]
[1607.635898, "o", "        die(\"invalid Matrix Market header\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[1607.635953, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
